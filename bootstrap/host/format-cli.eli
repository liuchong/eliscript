(module bootstrap.host.format-cli
  (import "node:crypto" randomUUID)
  (import "node:fs/promises" readFile rename stat unlink writeFile)
  (import "node:path" basename dirname resolve)
  (import "node:url" fileURLToPath)
  (import "./bun.mjs"
    diagnosticFromError loadCompiler requestedDiagnosticFormat)

  (defun host-typeof (value) (js* "typeof value"))

  (defconst usage
    (str "Usage: eliscript-format [OPTIONS] INPUT\n\n"
         "Options:\n"
         "  --write              Atomically replace INPUT when formatting changes\n"
         "  --check              Fail without writing when INPUT is not canonical\n"
         "  --diagnostic-format human|json\n"
         "                       Select human-readable or JSON failures\n"
         "  -h, --help           Show this help\n"))

  (defun parseArguments (arguments_)
    (let ((argumentsList (Array/from arguments_))
          (input undefined)
          (write false)
          (check false)
          (diagnosticFormat "human")
          (helpResult nil))
      (when (= (aref argumentsList 0) "--")
        (js-call argumentsList :shift))
      (while (and (nil? helpResult) (> (js-length argumentsList) 0))
        (let ((argument (js-call argumentsList :shift)))
          (cond
            ((or (= argument "-h") (= argument "--help"))
              (setq helpResult (js-object :help t)))
            ((= argument "--write")
              (setq write t))
            ((= argument "--check")
              (setq check t))
            ((= argument "--diagnostic-format")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires human or json"))))
              (setq diagnosticFormat (js-call argumentsList :shift))
              (unless (or (= diagnosticFormat "human") (= diagnosticFormat "json"))
                (throw (new globalThis.Error (str "unsupported diagnostic format: " diagnosticFormat)))))
            ((js-call argument :startsWith "-")
              (throw (new globalThis.Error (str "unknown option: " argument))))
            ((not (undefined? input))
              (throw (new globalThis.Error "multiple input files are not supported")))
            (t
              (setq input argument)))))
      (if helpResult
        helpResult
        (progn
          (when (undefined? input)
            (throw (new globalThis.Error "missing input file")))
          (when (and write check)
            (throw (new globalThis.Error "--write and --check are mutually exclusive")))
          (js-object :input input :write write :check check :diagnosticFormat diagnosticFormat)))))

  (defun unformattedError (filename)
    (let ((error (new globalThis.Error (str filename " is not formatted"))))
      (put error :eliscriptDiagnostic
        (js-object :format "eliscript-diagnostic"
          :version 1
          :code "ELI-F0002"
          :severity "error"
          :phase "formatter"
          :message "file is not formatted"
          :location (js-object :file filename)))
      error))

  (defasync atomicWrite (filename source mode)
    (let ((temporary (resolve (dirname filename)
                       (str "." (basename filename) ".eliscript-format-"
                            (get globalThis.process :pid) "-" (randomUUID)))))
      (try
        (progn
          (await (writeFile temporary source (js-object :encoding "utf8" :mode mode)))
          (await (rename temporary filename)))
        (catch error
          (await (js-call (unlink temporary) :catch (lambda () nil)))
          (throw error)))))

  (defasync formatFile (options)
    (when (or (nullish? options) (not (= (host-typeof options) "object")))
      (throw (new globalThis.Error "formatter options must be an object")))
    (let* ((filename (resolve (get options :input)))
           (compiler (if (nullish? (get options :compiler))
                       (await (loadCompiler (get options :moduleDirectory)))
                       (get options :compiler)))
           (pair (await (Promise/all (js-array (readFile filename "utf8") (stat filename)))))
           (source (aref pair 0))
           (attributes (aref pair 1))
           (formatted (js-call compiler :format_source source filename))
           (changed (not (= formatted source))))
      (when (and (get options :check) changed)
        (throw (unformattedError filename)))
      (when (and (get options :write) changed)
        (await (atomicWrite filename formatted (get attributes :mode))))
      (Object/freeze (js-object :filename filename :formatted formatted :changed changed))))

  (defasync main (&rest __opt)
    (let* ((arguments_ (aref __opt 0))
           (actual-args (if (undefined? arguments_)
                          (js-call (get globalThis.process :argv) :slice 2)
                          arguments_))
           (options (parseArguments actual-args)))
      (if (get options :help)
        (js-call (get globalThis.process :stdout) :write usage)
        (let ((result (await (formatFile options))))
          (when (and (not (get options :write)) (not (get options :check)))
            (js-call (get globalThis.process :stdout) :write (get result :formatted)))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (not (undefined? entry))
               (= (resolve entry) (fileURLToPath (js* "import.meta.url"))))
      (let ((outputFormat (requestedDiagnosticFormat (js-call (get globalThis.process :argv) :slice 2))))
        (js-call (main) :catch
          (lambda (error)
            (if (= outputFormat "json")
              (console/error (JSON/stringify (diagnosticFromError error)))
              (console/error (str "eliscript-format: " (get error :message))))
            (put globalThis.process :exitCode 1))))))

  (export formatFile main parseArguments))
