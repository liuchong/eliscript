(module bootstrap.host.evaluation
  (import "node:buffer" Buffer)
  (import "node:crypto" createHash)
  (import "node:fs" existsSync mkdirSync mkdtempSync readFileSync realpathSync rmSync symlinkSync writeFileSync)
  (import "node:os" tmpdir)
  (import "node:module" SourceMap)
  (import "node:util" format)
  (import "node:path" dirname isAbsolute join relative resolve sep)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../../runtime/core/data-text.mjs" printValue)
  (import "./bun.mjs" loadCompiler)
  (import "./project.mjs" buildProject)

  (defconst evaluationResultFormat "eliscript-evaluation-result")

  (defconst projectDirectory
    (resolve (dirname (fileURLToPath (js* "import.meta.url"))) "../.."))

  (defconst evaluationCompilerDigest
    (js-call (js-call (createHash "sha256") :update "eliscript-evaluation-session") :digest "hex"))

  (defconst tapHostSymbol (js-call globalThis.Symbol :for "eliscript.tap.host"))
  (defconst replOnceSymbol (js-call globalThis.Symbol :for "eliscript.repl.once"))
  (defvar evaluationSessionCounter 0)
  (defvar cachedApiIndex nil)

  (defun host-typeof (value)
    (js* "typeof value"))

  (defun host-error-instance? (value)
    (js* "value instanceof globalThis.Error"))

  (defun host-dynamic-import (url)
    (js* "import(url)"))

  (defun frozen (value)
    (Object/freeze value))

  (defun diagnosticError (message &optional filename)
    (let ((error (new globalThis.Error message))
          (diag (js-object
                  :format "eliscript-diagnostic"
                  :code "ELI-E0001"
                  :severity "error"
                  :phase "evaluation-request"
                  :message message)))
      (when (and filename (not (undefined? filename)))
        (put diag :location (js-object :file filename)))
      (put error :eliscriptDiagnostic diag)
      error))

  (defun containedPath (path root)
    (let ((pathFromRoot (relative root path)))
      (or (= pathFromRoot "")
          (and (not (js-call pathFromRoot :startsWith (str ".." sep)))
               (not (= pathFromRoot ".."))
               (not (isAbsolute pathFromRoot))))))

  (defun nearestProjectRoot (filename)
    (let ((directory (dirname filename))
          (found nil))
      (while (nil? found)
        (if (existsSync (join directory "eliscript.json"))
          (setq found directory)
          (let ((parent (dirname directory)))
            (if (= parent directory)
              (setq found (dirname filename))
              (setq directory parent)))))
      found))

  (defun requestFilename (filename)
    (if (isAbsolute filename)
      (resolve filename)
      (resolve (js-call globalThis.process :cwd) filename)))

  (defun runtimeCategory (value)
    (cond
      ((nil? value) "nil")
      ((undefined? value) "undefined")
      (t (host-typeof value))))

  (defconst eli-stack-pattern (new globalThis.RegExp "(?:at\\s+)?(?:file:\\/\\/)?([^\\s()]+\\.eli):(\\d+):(\\d+)" "u"))
  (defconst mjs-stack-pattern (new globalThis.RegExp "(?:at\\s+)?(?:file:\\/\\/)?([^\\s()?]+\\.mjs)(?:[?#][^\\s():]*)?:(\\d+):(\\d+)" "u"))

  (defun stackLocation (stack)
    (if (not (= (host-typeof stack) "string"))
      nil
      (let ((match (js-call stack :match eli-stack-pattern)))
        (if (not match)
          nil
          (js-object
            :file (js-call (aref match 1) :trim)
            :line (globalThis.Number (aref match 2))
            :column (globalThis.Number (aref match 3)))))))

  (defun generatedStackLocation (stack)
    (if (not (= (host-typeof stack) "string"))
      nil
      (let ((match (js-call stack :match mjs-stack-pattern)))
        (if (not match)
          nil
          (let* ((generatedFile (globalThis.decodeURIComponent (js-call (aref match 1) :trim)))
                 (mapFile (str generatedFile ".map")))
            (if (not (existsSync mapFile))
              nil
              (try
                (let* ((sourceMap (new SourceMap (JSON/parse (readFileSync mapFile "utf8"))))
                       (entry (js-call sourceMap :findEntry
                                (- (globalThis.Number (aref match 2)) 1)
                                (- (globalThis.Number (aref match 3)) 1))))
                  (if (not (and entry (get entry :originalSource)))
                    nil
                    (let* ((orig (get entry :originalSource))
                           (originalSource (if (js-call orig :startsWith "file://")
                                             (fileURLToPath orig)
                                             orig)))
                      (js-object
                        :file (if (isAbsolute originalSource)
                                originalSource
                                (resolve (dirname mapFile) originalSource))
                        :line (+ (get entry :originalLine) 1)
                        :column (+ (get entry :originalColumn) 1)))))
                (catch _err
                  nil))))))))

  (defun remapPoint (point adjustment)
    (let ((relativeLine (+ (- (get point :line) (get adjustment :expressionLine)) 1)))
      (if (< relativeLine 1)
        point
        (let ((out (Object/assign (js-object) point)))
          (put out :line (- (+ (get adjustment :line) relativeLine) 1))
          (put out :column
            (if (= relativeLine 1)
              (+ (get adjustment :column)
                 (Math/max 0 (- (get point :column) (get adjustment :expressionColumn))))
              (get point :column)))
          out))))

  (defun remapLocation (location adjustment)
    (if (or (not location)
            (not adjustment)
            (not (= (get location :file) (get adjustment :syntheticFilename))))
      location
      (if (and (get location :start) (= (host-typeof (get location :start)) "object"))
        (let ((out (Object/assign (js-object) location)))
          (put out :file (get adjustment :filename))
          (put out :start (remapPoint (get location :start) adjustment))
          (when (get location :end)
            (put out :end (remapPoint (get location :end) adjustment)))
          out)
        (let ((out (remapPoint location adjustment)))
          (put out :file (get adjustment :filename))
          out))))

  (defconst mjs-frame-global-pattern (new globalThis.RegExp "(?:file:\\/\\/)?([^\\s()?]+\\.mjs)(?:[?#][^\\s():]*)?:(\\d+):(\\d+)" "gu"))
  (defconst eli-frame-global-pattern (new globalThis.RegExp "(?:file:\\/\\/)?([^\\s()]+\\.eli):(\\d+):(\\d+)" "gu"))

  (defun resolveMjsFrameLocation (generatedFile rawLine rawColumn)
    (let ((mapFile (str (globalThis.decodeURIComponent (js-call generatedFile :trim)) ".map")))
      (if (not (existsSync mapFile))
        nil
        (try
          (let* ((sourceMap (new SourceMap (JSON/parse (readFileSync mapFile "utf8"))))
                 (entry (js-call sourceMap :findEntry (- rawLine 1) (- rawColumn 1))))
            (if (not (and entry (get entry :originalSource)))
              nil
              (let* ((orig (get entry :originalSource))
                     (originalSource (if (js-call orig :startsWith "file://")
                                       (fileURLToPath orig)
                                       orig)))
                (js-object
                  :file (if (isAbsolute originalSource)
                          originalSource
                          (resolve (dirname mapFile) originalSource))
                  :line (+ (get entry :originalLine) 1)
                  :column (+ (get entry :originalColumn) 1)))))
          (catch _err nil)))))

  (defun formatStackTrace (error &optional adjustment)
    (if (not error)
      "No recent exception."
      (let* ((stack (if (= (host-typeof (get error :stack)) "string")
                      (get error :stack)
                      (str (if (host-error-instance? error) (get error :message) (globalThis.String error)))))
             (lines (js-call stack :split "\n"))
             (out (js-array))
             (idx 0))
        (while (< idx (js-length lines))
          (let ((line (aref lines idx)))
            (setq line
              (js-call line :replace mjs-frame-global-pattern
                (lambda (full file lineStr colStr)
                  (let ((mapped (resolveMjsFrameLocation file (globalThis.Number lineStr) (globalThis.Number colStr))))
                    (if (not mapped)
                      full
                      (let ((remapped (remapLocation mapped adjustment)))
                        (str (get remapped :file) ":" (get remapped :line) ":" (get remapped :column))))))))
            (setq line
              (js-call line :replace eli-frame-global-pattern
                (lambda (full file lineStr colStr)
                  (let ((remapped
                          (remapLocation
                            (js-object :file file :line (globalThis.Number lineStr) :column (globalThis.Number colStr))
                            adjustment)))
                    (str (get remapped :file) ":" (get remapped :line) ":" (get remapped :column))))))
            (js-call out :push line))
          (setq idx (+ idx 1)))
        (js-call out :join "\n"))))

  (defun loadApiMetadata ()
    (when (nil? cachedApiIndex)
      (let ((indexPath (join projectDirectory "docs" "pages" "api-index.json"))
            (fallbackPath (join projectDirectory "contracts" "library-api.json")))
        (setq cachedApiIndex
          (try
            (cond
              ((existsSync indexPath) (JSON/parse (readFileSync indexPath "utf8")))
              ((existsSync fallbackPath) (JSON/parse (readFileSync fallbackPath "utf8")))
              (t (js-object :modules (js-array))))
            (catch _err (js-object :modules (js-array)))))))
    cachedApiIndex)

  (defun scanWhitespaceOrComment (source start)
    (let ((pos start)
          (len (js-length source))
          (done false))
      (while (and (not done) (< pos len))
        (let ((ch (aref source pos)))
          (cond
            ((or (= ch " ") (= ch "\t") (= ch "\n") (= ch "\r") (= ch ","))
             (setq pos (+ pos 1)))
            ((= ch ";")
             (while (and (< pos len) (not (= (aref source pos) "\n")))
               (setq pos (+ pos 1))))
            (t (setq done t)))))
      pos))

  (defun scanBalancedForm (source start)
    (let ((len (js-length source)))
      (if (>= start len)
        start
        (let ((ch (aref source start)))
          (cond
            ((or (= ch "(") (= ch "[") (= ch "{"))
             (let ((depth 0)
                   (pos start)
                   (inString false)
                   (done false))
               (while (and (not done) (< pos len))
                 (let ((c (aref source pos)))
                   (cond
                     (inString
                      (cond
                        ((= c "\\") (setq pos (+ pos 2)))
                        ((= c "\"") (setq inString false) (setq pos (+ pos 1)))
                        (t (setq pos (+ pos 1)))))
                     ((= c "\"")
                      (setq inString t)
                      (setq pos (+ pos 1)))
                     ((= c ";")
                      (while (and (< pos len) (not (= (aref source pos) "\n")))
                        (setq pos (+ pos 1))))
                     ((or (= c "(") (= c "[") (= c "{"))
                      (setq depth (+ depth 1))
                      (setq pos (+ pos 1)))
                     ((or (= c ")") (= c "]") (= c "}"))
                      (setq depth (- depth 1))
                      (setq pos (+ pos 1))
                      (when (= depth 0)
                        (setq done t)))
                     (t (setq pos (+ pos 1))))))
               pos))
            ((= ch "\"")
             (let ((pos (+ start 1))
                   (done false))
               (while (and (not done) (< pos len))
                 (let ((c (aref source pos)))
                   (cond
                     ((= c "\\") (setq pos (+ pos 2)))
                     ((= c "\"") (setq pos (+ pos 1)) (setq done t))
                     (t (setq pos (+ pos 1))))))
               pos))
            (t
             (let ((pos start))
               (while (and (< pos len)
                           (not (js-call (new globalThis.RegExp "[\\s()\\[\\]{}\";]" "u") :test (aref source pos))))
                 (setq pos (+ pos 1)))
               pos)))))))

  (defun countLinesUpTo (source offset)
    (let ((lines 1)
          (pos 0)
          (limit (Math/min offset (js-length source))))
      (while (< pos limit)
        (when (= (aref source pos) "\n")
          (setq lines (+ lines 1)))
        (setq pos (+ pos 1)))
      lines))

  (defun parseFormChildren (source openOffset closeOffset)
    (let ((children (js-array))
          (pos (scanWhitespaceOrComment source (+ openOffset 1)))
          (limit (- closeOffset 1)))
      (while (< pos limit)
        (let ((end (scanBalancedForm source pos)))
          (when (> end pos)
            (js-call children :push
              (js-object
                :start pos
                :end end
                :text (js-call source :slice pos end))))
          (setq pos (scanWhitespaceOrComment source end))))
      children))

  (defun extractDefinitionDoc (head items)
    (if (and (or (= head "defun") (= head "defn") (= head "defportable")
                 (= head "defasync") (= head "defmacro"))
             (>= (js-length items) 5))
      (let ((raw (get (aref items 3) :text)))
        (if (and (js-call raw :startsWith "\"") (js-call raw :endsWith "\""))
          (try (JSON/parse raw) (catch _err nil))
          nil))
      nil))

  (defun collectDefinitionFormsFromSource (source &optional filename)
    (let ((forms (js-array))
          (pos (scanWhitespaceOrComment source 0))
          (len (js-length source)))
      (while (< pos len)
        (let ((end (scanBalancedForm source pos)))
          (when (> end pos)
            (let ((formText (js-call source :slice pos end)))
              (when (js-call formText :startsWith "(")
                (let* ((items (parseFormChildren source pos end))
                       (head (if (> (js-length items) 0) (get (aref items 0) :text) "")))
                  (cond
                    ((= head "module")
                     (let ((idx 2))
                       (while (< idx (js-length items))
                         (let* ((child (aref items idx))
                                (ctext (get child :text)))
                           (when (js-call ctext :startsWith "(")
                             (let* ((citems (parseFormChildren source (get child :start) (get child :end)))
                                    (chead (if (> (js-length citems) 0) (get (aref citems 0) :text) ""))
                                    (cname (if (> (js-length citems) 1) (get (aref citems 1) :text) "")))
                               (js-call forms :push
                                 (js-object
                                   :head chead
                                   :name cname
                                   :params (if (> (js-length citems) 2) (get (aref citems 2) :text) nil)
                                   :doc (extractDefinitionDoc chead citems)
                                   :items citems
                                   :start (get child :start)
                                   :end (get child :end)
                                   :line (countLinesUpTo source (get child :start))
                                   :file filename
                                   :text ctext)))))
                         (setq idx (+ idx 1)))))
                    (t
                     (js-call forms :push
                       (js-object
                         :head head
                         :name (if (> (js-length items) 1) (get (aref items 1) :text) "")
                         :params (if (> (js-length items) 2) (get (aref items 2) :text) nil)
                         :doc (extractDefinitionDoc head items)
                         :items items
                         :start pos
                         :end end
                         :line (countLinesUpTo source pos)
                         :file filename
                         :text formText))))))))
          (setq pos (scanWhitespaceOrComment source end))))
      forms))

  (defun findDefinitionInSource (source targetName &optional filename)
    (let ((forms (collectDefinitionFormsFromSource source filename))
          (defHeads (new globalThis.Set
                      (js-array "defun" "defn" "defportable" "defasync" "defmacro"
                        "defvar" "defconst" "defvar-once" "defmulti" "defprotocol"
                        "defrecord" "deftype")))
          (idx 0)
          (found nil))
      (while (and (not found) (< idx (js-length forms)))
        (let ((form (aref forms idx)))
          (when (and (js-call defHeads :has (get form :head))
                     (= (get form :name) targetName))
            (setq found form)))
        (setq idx (+ idx 1)))
      found))

  (defun rewriteDefvarOnce (source sessionId)
    (let ((forms (collectDefinitionFormsFromSource source))
          (replacements (js-array))
          (idx 0))
      (while (< idx (js-length forms))
        (let ((form (aref forms idx)))
          (when (and (= (get form :head) "defvar-once")
                     (>= (js-length (get form :items)) 3))
            (let* ((nameNode (aref (get form :items) 1))
                   (initNode (aref (get form :items) 2))
                   (name (get nameNode :text))
                   (initText (get initNode :text))
                   (keyLiteral (JSON/stringify (str sessionId ":" name)))
                   (rebuilt
                     (str "(defvar " name
                          " (let ((__eli_once_root (js* \"globalThis\"))"
                          " (__eli_once_sym (js-call globalThis.Symbol :for \"eliscript.repl.once\")))"
                          " (let ((__eli_once_store (or (aref __eli_once_root __eli_once_sym)"
                          " (let ((__m (js-object))) (put __eli_once_root __eli_once_sym __m) __m))))"
                          " (if (js-call globalThis.Object :hasOwn __eli_once_store " keyLiteral ")"
                          " (aref __eli_once_store " keyLiteral ")"
                          " (let ((__eli_once_val " initText "))"
                          " (put __eli_once_store " keyLiteral " __eli_once_val) __eli_once_val)))))")))
              (js-call replacements :push
                (js-object :start (get form :start) :end (get form :end) :name name :replacement rebuilt)))))
        (setq idx (+ idx 1)))
      (if (= (js-length replacements) 0)
        (js-object :source source :names (js-array))
        (let ((out source)
              (names (js-array))
              (r-idx (- (js-length replacements) 1)))
          (while (>= r-idx 0)
            (let ((rep (aref replacements r-idx)))
              (js-call names :unshift (get rep :name))
              (setq out
                (str (js-call out :slice 0 (get rep :start))
                     (get rep :replacement)
                     (js-call out :slice (get rep :end)))))
            (setq r-idx (- r-idx 1)))
          (js-object :source out :names names)))))

  (defun clearSessionReplOnce (sessionId)
    (let* ((root (js* "globalThis"))
           (store (aref root replOnceSymbol))
           (prefix (str sessionId ":")))
      (when (and store (= (host-typeof store) "object"))
        (let ((keys (Object/keys store))
              (idx 0))
          (while (< idx (js-length keys))
            (let ((k (aref keys idx)))
              (when (js-call k :startsWith prefix)
                (Reflect/deleteProperty store k)))
            (setq idx (+ idx 1)))))))

  (defun normalizeTargetSymbolName (raw)
    (let ((text (js-call (globalThis.String raw) :trim)))
      (cond
        ((js-call text :startsWith "'") (js-call text :slice 1))
        ((js-call text :startsWith ":") (js-call text :slice 1))
        ((and (js-call text :startsWith "\"") (js-call text :endsWith "\"") (>= (js-length text) 2))
         (try (JSON/parse text) (catch _err text)))
        (t text))))

  (defun findApiModulesForSymbol (targetName)
    (let* ((index (loadApiMetadata))
           (modules (or (get index :modules) (js-array)))
           (matches (js-array))
           (idx 0))
      (while (< idx (js-length modules))
        (let* ((mod (aref modules idx))
               (exportsList (or (get mod :exports) (js-array))))
          (when (js-call exportsList :includes targetName)
            (js-call matches :push mod)))
        (setq idx (+ idx 1)))
      matches))

  (defun findApiModuleByName (modQuery)
    (let* ((index (loadApiMetadata))
           (modules (or (get index :modules) (js-array)))
           (needle (normalizeTargetSymbolName modQuery))
           (stripped (if (js-call needle :startsWith "eliscript/")
                       (js-call needle :slice 10)
                       needle))
           (idx 0)
           (found nil))
      (while (and (not found) (< idx (js-length modules)))
        (let* ((mod (aref modules idx))
               (modName (get mod :module))
               (source (get mod :source)))
          (when (or (= modName needle)
                    (= modName stripped)
                    (= modName (str "stdlib/" stripped))
                    (= source needle)
                    (= source (str "stdlib/" stripped ".eli"))
                    (js-call modName :endsWith (str "/" stripped)))
            (setq found mod)))
        (setq idx (+ idx 1)))
      found))

  (defun inspectDoc (session rawName)
    (let ((name (normalizeTargetSymbolName rawName))
          (ns (get session :namespace))
          (lines (js-array)))
      (when (and ns (get ns :source))
        (let ((localDef (findDefinitionInSource (get ns :source) name (get ns :filename))))
          (when localDef
            (js-call lines :push "-------------------------")
            (js-call lines :push (str (or (get ns :filename) "<repl>") ":" (get localDef :line) " :: " name))
            (if (or (= (get localDef :head) "defun") (= (get localDef :head) "defn")
                    (= (get localDef :head) "defportable") (= (get localDef :head) "defasync")
                    (= (get localDef :head) "defmacro"))
              (js-call lines :push (str "(" (get localDef :head) " " name " " (or (get localDef :params) "()") ")"))
              (js-call lines :push (str "(" (get localDef :head) " " name ")")))
            (when (get localDef :doc)
              (js-call lines :push (get localDef :doc)))
            (js-call lines :push "Session namespace binding."))))
      (when (= (js-length lines) 0)
        (let ((mods (findApiModulesForSymbol name)))
          (if (> (js-length mods) 0)
            (let* ((mod (aref mods 0))
                   (sourcePath (resolve projectDirectory (get mod :source)))
                   (def (when (existsSync sourcePath)
                          (findDefinitionInSource (readFileSync sourcePath "utf8") name (get mod :source)))))
              (js-call lines :push "-------------------------")
              (js-call lines :push (str (get mod :module) " (" (get mod :source) ") :: " name))
              (js-call lines :push (str "Role: " (or (get mod :role) "library") " | Spec: " (or (get mod :spec) "-")))
              (when def
                (if (or (= (get def :head) "defun") (= (get def :head) "defn")
                        (= (get def :head) "defportable") (= (get def :head) "defasync")
                        (= (get def :head) "defmacro"))
                  (js-call lines :push (str "(" (get def :head) " " name " " (or (get def :params) "()") ")"))
                  (js-call lines :push (str "(" (get def :head) " " name ")")))
                (when (get def :doc)
                  (js-call lines :push (get def :doc))))
              (when (get mod :summary)
                (js-call lines :push (get mod :summary))))
            (let ((mod (findApiModuleByName name)))
              (when mod
                (js-call lines :push "-------------------------")
                (js-call lines :push (str (get mod :module) " (" (get mod :source) ")"))
                (js-call lines :push (str "Role: " (or (get mod :role) "library") " | Spec: " (or (get mod :spec) "-")))
                (when (get mod :summary)
                  (js-call lines :push (get mod :summary)))
                (js-call lines :push (str "Exports: " (js-length (or (get mod :exports) (js-array))))))))))
      (if (= (js-length lines) 0)
        (str "No documentation found for " name ".")
        (js-call lines :join "\n"))))

  (defun inspectSource (session rawName)
    (let ((name (normalizeTargetSymbolName rawName))
          (ns (get session :namespace)))
      (let ((found nil))
        (when (and ns (get ns :source))
          (let ((localDef (findDefinitionInSource (get ns :source) name (get ns :filename))))
            (when localDef
              (setq found (str ";; " (or (get ns :filename) "<repl>") ":" (get localDef :line) "\n" (get localDef :text))))))
        (unless found
          (let ((mods (findApiModulesForSymbol name))
                (idx 0))
            (while (and (not found) (< idx (js-length mods)))
              (let* ((mod (aref mods idx))
                     (sourcePath (resolve projectDirectory (get mod :source))))
                (when (existsSync sourcePath)
                  (let ((def (findDefinitionInSource (readFileSync sourcePath "utf8") name (get mod :source))))
                    (when def
                      (setq found (str ";; " (get mod :source) ":" (get def :line) "\n" (get def :text)))))))
              (setq idx (+ idx 1)))))
        (if found found (str "No source found for " name ".")))))

  (defun inspectApropos (session rawQuery)
    (let* ((query (js-call (normalizeTargetSymbolName rawQuery) :toLowerCase))
           (index (loadApiMetadata))
           (modules (or (get index :modules) (js-array)))
           (results (new globalThis.Set))
           (ns (get session :namespace)))
      (when (and ns (get ns :bindings))
        (js-call (get ns :bindings) :forEach
          (lambda (name)
            (when (js-call (js-call name :toLowerCase) :includes query)
              (js-call results :add name)))))
      (let ((m-idx 0))
        (while (< m-idx (js-length modules))
          (let* ((mod (aref modules m-idx))
                 (modName (get mod :module))
                 (exportsList (or (get mod :exports) (js-array)))
                 (e-idx 0))
            (while (< e-idx (js-length exportsList))
              (let ((sym (aref exportsList e-idx)))
                (when (or (js-call (js-call sym :toLowerCase) :includes query)
                          (js-call (js-call modName :toLowerCase) :includes query))
                  (js-call results :add (str modName "/" sym))))
              (setq e-idx (+ e-idx 1))))
          (setq m-idx (+ m-idx 1))))
      (js-call (Array/from results) :sort)))

  (defun inspectDir (session &optional rawModuleName)
    (if (or (nil? rawModuleName) (undefined? rawModuleName) (= (js-call (globalThis.String rawModuleName) :trim) ""))
      (let ((ns (get session :namespace)))
        (if (and ns (get ns :bindings))
          (js-call (Array/from (get ns :bindings)) :sort)
          (js-array)))
      (let ((mod (findApiModuleByName rawModuleName)))
        (if (and mod (Array/isArray (get mod :exports)))
          (js-call (Array/from (get mod :exports)) :sort)
          (js-array)))))

  (defun inspectPst (session)
    (formatStackTrace (get session :lastError) (get session :lastAdjustment)))

  (defun normalizeDiagnostic (error &optional adjustment)
    (let ((existing (if error (get error :eliscriptDiagnostic) nil)))
      (if (and existing (= (host-typeof existing) "object"))
        (let ((location (remapLocation (get existing :location) adjustment))
              (out (Object/assign (js-object) existing)))
          (when location
            (put out :location (frozen (Object/assign (js-object) location))))
          (frozen out))
        (let* ((stack (if error (get error :stack) nil))
               (raw-loc (let ((sl (stackLocation stack)))
                          (if sl sl (generatedStackLocation stack))))
               (location (remapLocation raw-loc adjustment))
               (out (js-object
                      :format "eliscript-diagnostic"
                      :code "ELI-E0002"
                      :severity "error"
                      :phase "evaluation-runtime"
                      :message (if (host-error-instance? error)
                                 (get error :message)
                                 (globalThis.String error)))))
          (when location
            (put out :location (frozen location)))
          (frozen out)))))

  (defun resultBase (request revision)
    (js-object
      :format evaluationResultFormat
      :id (if (and request (not (nil? (get request :id))) (not (undefined? (get request :id))))
            (get request :id)
            nil)
      :operation (if (and request (not (nil? (get request :operation))) (not (undefined? (get request :operation))))
                   (get request :operation)
                   "unknown")
      :revision revision))

  (defun success (request revision details)
    (frozen (Object/assign (resultBase request revision) (js-object :status "ok") details)))

  (defun appendCapturedOutput (result stdout)
    (if (= stdout "")
      result
      (frozen (Object/assign (js-object) result (js-object :stdout stdout)))))

  (defasync captureStandardOutput (action)
    (let ((write (get (get globalThis.process :stdout) :write))
          (consoleMethods (new globalThis.Map))
          (stdout ""))
      (put (get globalThis.process :stdout) :write
        (lambda (chunk encoding callback)
          (setq stdout
            (str stdout
                 (if (js-call Buffer :isBuffer chunk)
                   (js-call chunk :toString (if (= (host-typeof encoding) "string") encoding "utf8"))
                   (globalThis.String chunk))))
          (let ((done (if (= (host-typeof encoding) "function") encoding callback)))
            (when (= (host-typeof done) "function")
              (globalThis.queueMicrotask done)))
          t))
      (let ((names (js-array "debug" "info" "log"))
            (idx 0))
        (while (< idx (js-length names))
          (let ((name (aref names idx)))
            (js-call consoleMethods :set name (aref globalThis.console name))
            (put globalThis.console name
              (lambda (&rest values)
                (setq stdout (str stdout (js-call format :apply nil values) "\n")))))
          (setq idx (+ idx 1))))
      (try
        (js-object :value (await (funcall action)) :stdout stdout)
        (catch error
          (put error :eliscriptCapturedStdout stdout)
          (throw error))
        (finally
          (put (get globalThis.process :stdout) :write write)
          (js-call consoleMethods :forEach
            (lambda (method name)
              (put globalThis.console name method)))))))

  (defun failure (rawRequest request revision error &optional adjustment)
    (let* ((rawId (if (and rawRequest (= (host-typeof rawRequest) "object"))
                    (get rawRequest :id)
                    nil))
           (id (if (and request (not (nil? (get request :id))) (not (undefined? (get request :id))))
                 (get request :id)
                 (if (or (and (= (host-typeof rawId) "string") (> (js-length rawId) 0))
                         (and (Number/isSafeInteger rawId) (>= rawId 0)))
                   rawId
                   nil)))
           (operation (if (and request (not (nil? (get request :operation))) (not (undefined? (get request :operation))))
                        (get request :operation)
                        (if (and rawRequest (= (host-typeof (get rawRequest :operation)) "string"))
                          (get rawRequest :operation)
                          "unknown"))))
      (frozen
        (Object/assign
          (resultBase (js-object :id id :operation operation) revision)
          (js-object
            :status "error"
            :diagnostic (normalizeDiagnostic error adjustment))))))

  (defun namespaceSource (source description)
    (let* ((exported (new globalThis.Set (get description :exports)))
           (missing (js-call (get description :bindings) :filter
                      (lambda (name) (not (js-call exported :has name))))))
      (if (= (js-length missing) 0)
        source
        (str source "\n(export " (js-call missing :join " ") ")\n"))))

  (defun expressionSource (request namespace)
    (let ((prelude (if (and namespace (get namespace :macroSources))
                     (Array/from (get namespace :macroSources))
                     (js-array))))
      (when (and namespace (> (js-length (get namespace :bindings)) 0))
        (js-call prelude :push
          (str "(import " (JSON/stringify (get namespace :url)) " "
               (js-call (get namespace :bindings) :join " ") ")")))
      (let* ((prefix "(export-default ")
             (expressionLine
               (js-call prelude :reduce
                 (lambda (lines src)
                   (+ lines (js-length (js-call src :split "\n"))))
                 1))
             (syntheticFilename (str (requestFilename (get request :filename)) ".eval.eli")))
        (js-object
          :source (str (if (> (js-length prelude) 0)
                         (str (js-call prelude :join "\n") "\n")
                         "")
                       prefix
                       (get request :source)
                       "\n)")
          :adjustment (js-object
                        :syntheticFilename syntheticFilename
                        :filename (get request :filename)
                        :line (get request :line)
                        :column (get request :column)
                        :expressionLine expressionLine
                        :expressionColumn (+ (js-length prefix) 1))))))

  (defasync sessionCreate (SessionClass &rest __opt)
    (let* ((options (aref __opt 0))
           (opts (if (undefined? options) (js-object) options))
           (compiler (if (and (get opts :compiler) (not (undefined? (get opts :compiler))))
                       (get opts :compiler)
                       (await (loadCompiler (get opts :moduleDirectory)))))
           (directory (mkdtempSync (join (tmpdir) "eliscript-evaluation-"))))
      (try
        (mkdirSync (join directory "node_modules") (js-object :recursive t))
        (symlinkSync projectDirectory (join directory "node_modules" "eliscript") "dir")
        (new SessionClass (js-object :compiler compiler :directory directory))
        (catch error
          (rmSync directory (js-object :recursive t :force t))
          (throw error)))))

  (defun sessionEnsureOpen (session)
    (when (get session :closed)
      (throw (diagnosticError "evaluation session is closed"))))

  (defun sessionNextArtifactDirectory (session label)
    (put session :artifact (+ (get session :artifact) 1))
    (let ((directory (join (get session :directory)
                           (str (js-call (globalThis.String (get session :artifact)) :padStart 6 "0") "-" label))))
      (mkdirSync directory (js-object :recursive t))
      directory))

  (defasync sessionCompileSingle (session source filename label)
    (let* ((directory (js-call session :nextArtifactDirectory label))
           (generatedName (str label ".mjs"))
           (modulePath (join directory generatedName))
           (emission (js-call (get session :compiler)
                       :compile_string_with_source_map source filename generatedName filename))
           (_w1 (writeFileSync modulePath (str (get emission :javascript) "\n") "utf8"))
           (_w2 (writeFileSync (str modulePath ".map") (get emission :sourceMap) "utf8"))
           (url (str (get (pathToFileURL modulePath) :href) "?artifact=" (get session :artifact))))
      (js-object
        :module (await (host-dynamic-import url))
        :modulePath modulePath
        :url url)))

  (defasync sessionCompileProject (session source filename root label)
    (let* ((directory (js-call session :nextArtifactDirectory label))
           (overrides (new globalThis.Map (js-array (js-array filename source))))
           (result (await
                     (buildProject
                       (js-object
                         :entries (js-array filename)
                         :outDir directory
                         :root root
                         :portableEntries (js-array)
                         :useCache false
                         :sourceOverrides overrides
                         :compiler (get session :compiler)
                         :compilerDigest evaluationCompilerDigest
                         :sourceMapReference false))))
           (modulePath (aref (get result :entryOutputs) 0))
           (url (str (get (pathToFileURL modulePath) :href) "?artifact=" (get session :artifact))))
      (js-object
        :module (await (host-dynamic-import url))
        :modulePath modulePath
        :url url)))

  (defasync sessionBuildNamespace (session source filename root label &optional displaySource)
    (let* ((description (js-call (get session :compiler) :evaluation_module_description source filename))
           (compiledSource (namespaceSource source description))
           (absoluteFilename (requestFilename filename))
           (artifact
             (if (and (existsSync absoluteFilename) (js-call absoluteFilename :endsWith ".eli"))
               (let* ((canonicalFilename (realpathSync absoluteFilename))
                      (requestedRoot (if (nil? root)
                                       (nearestProjectRoot canonicalFilename)
                                       (resolve root)))
                      (canonicalRoot (realpathSync requestedRoot)))
                 (unless (containedPath canonicalFilename canonicalRoot)
                   (throw (diagnosticError "evaluation file escapes project root" filename)))
                 (await (js-call session :compileProject compiledSource canonicalFilename canonicalRoot label)))
               (await (js-call session :compileSingle compiledSource filename label)))))
      (frozen
        (Object/assign
          (js-object)
          artifact
          (js-object
            :filename filename
            :source (if (nullish? displaySource) source displaySource)
            :bindings (get description :bindings)
            :exports (get description :exports)
            :macroSources (get description :macroSources))))))

  (defun sessionCommitNamespace (session namespace mode)
    (put session :namespace namespace)
    (put session :mode mode)
    (put session :revision (+ (get session :revision) 1)))

  (defasync sessionDescribe (session request)
    (success request (get session :revision)
      (js-object
        :kind "capabilities"
        :capabilities
          (frozen
            (js-object
              :operations (frozen (js-array "describe" "evaluate" "load" "reset"))
              :persistentSession t
              :sourceMaps t
              :valuePrinter "eliscript-data-text")))))

  (defasync sessionLoad (session request)
    (let* ((rawSource (get request :source))
           (rewritten (rewriteDefvarOnce rawSource (get session :sessionId)))
           (namespace
             (await
               (js-call session :buildNamespace
                 (get rewritten :source)
                 (get request :filename)
                 (get request :root)
                 (str "namespace-" (+ (get session :revision) 1))
                 rawSource))))
      (put session :definitions (new globalThis.Map))
      (put session :definitionFilename nil)
      (js-call session :commitNamespace namespace "loaded")
      (success request (get session :revision)
        (js-object
          :kind "module"
          :bindings (get namespace :bindings)
          :value nil
          :valueCategory "module"))))

  (defasync sessionEvaluateDefinition (session request description &optional compiledUnitSource rawUnitSource)
    (when (= (get session :mode) "loaded")
      (throw (diagnosticError
               "evaluate a complete updated source to replace definitions from a loaded module"
               (get request :filename))))
    (when (and (not (nil? (get session :definitionFilename)))
               (not (= (get session :definitionFilename) (get request :filename))))
      (throw (diagnosticError
               "one definition journal cannot mix logical filenames"
               (get request :filename))))
    (let ((definitions (new globalThis.Map (get session :definitions)))
          (rawDefinitions (new globalThis.Map (get session :rawDefinitions))))
      (js-call definitions :set (get description :name)
        (if (nullish? compiledUnitSource) (get request :source) compiledUnitSource))
      (js-call rawDefinitions :set (get description :name)
        (if (nullish? rawUnitSource) (get request :source) rawUnitSource))
      (let* ((source (js-call (Array/from (js-call definitions :values)) :join "\n"))
             (rawSource (js-call (Array/from (js-call rawDefinitions :values)) :join "\n"))
             (namespace
               (await
                 (js-call session :buildNamespace
                   source
                   (get request :filename)
                   (get request :root)
                   (str "namespace-" (+ (get session :revision) 1))
                   rawSource))))
        (put session :definitions definitions)
        (put session :rawDefinitions rawDefinitions)
        (put session :definitionFilename (get request :filename))
        (js-call session :commitNamespace namespace "journal")
        (let* ((hasValue
                 (globalThis.Boolean
                   (and (get description :runtimeBinding)
                        (Object/hasOwn (get namespace :module) (get description :name)))))
               (value (if hasValue
                        (aref (get namespace :module) (get description :name))
                        undefined)))
          (success request (get session :revision)
            (js-object
              :kind "definition"
              :binding (get description :name)
              :hasValue hasValue
              :value (if hasValue (printValue value) nil)
              :valueCategory (if hasValue (runtimeCategory value) "macro")))))))

  (defasync evaluateRawExpressionValue (session request)
    (let ((prepared (expressionSource request (get session :namespace)))
          (artifact nil))
      (try
        (setq artifact
          (await
            (js-call session :compileSingle
              (get prepared :source)
              (get (get prepared :adjustment) :syntheticFilename)
              (str "expression-" (+ (get session :artifact) 1)))))
        (let ((val (await (get (get artifact :module) :default))))
          val)
        (catch error
          (when (and error (= (host-typeof error) "object"))
            (put error :eliscriptEvaluationAdjustment (get prepared :adjustment)))
          (throw error)))))

  (defasync sessionEvaluateExpression (session request)
    (let ((value (await (evaluateRawExpressionValue session request))))
      (success request (get session :revision)
        (js-object
          :kind "expression"
          :hasValue t
          :value (printValue value)
          :valueCategory (runtimeCategory value)))))

  (defun userShadowedSpecial? (session name)
    (let ((ns (get session :namespace)))
      (and ns
           (Array/isArray (get ns :bindings))
           (js-call (get ns :bindings) :includes name))))

  (defun parseSingleSpecialCall (source)
    (let ((start (scanWhitespaceOrComment source 0))
          (len (js-length source)))
      (if (or (>= start len) (not (= (aref source start) "(")))
        nil
        (let ((end (scanBalancedForm source start)))
          (if (< (scanWhitespaceOrComment source end) len)
            nil
            (let* ((items (parseFormChildren source start end))
                   (head (if (> (js-length items) 0) (get (aref items 0) :text) nil)))
              (if head
                (js-object :head head :items items)
                nil)))))))

  (defasync sessionEvaluate (session request)
    (let* ((rawSource (get request :source))
           (special (parseSingleSpecialCall rawSource))
           (specialHead (and special (get special :head))))
      (cond
        ((and (= specialHead "defvar-once")
              (>= (js-length (get special :items)) 3))
         (let* ((nameNode (aref (get special :items) 1))
                (name (get nameNode :text))
                (rewritten (rewriteDefvarOnce rawSource (get session :sessionId))))
           (await
             (js-call session :evaluateDefinition
               request
               (js-object :kind "definition" :head "defvar" :name name :runtimeBinding t)
               (get rewritten :source)
               rawSource))))
        ((and specialHead (not (userShadowedSpecial? session specialHead))
              (= specialHead "doc")
              (= (js-length (get special :items)) 2))
         (let ((text (inspectDoc session (get (aref (get special :items) 1) :text))))
           (js-call (get globalThis.process :stdout) :write (str text "\n"))
           (success request (get session :revision)
             (js-object :kind "expression" :hasValue t :value (printValue nil) :valueCategory "nil"))))
        ((and specialHead (not (userShadowedSpecial? session specialHead))
              (= specialHead "source")
              (= (js-length (get special :items)) 2))
         (let ((text (inspectSource session (get (aref (get special :items) 1) :text))))
           (js-call (get globalThis.process :stdout) :write (str text "\n"))
           (success request (get session :revision)
             (js-object :kind "expression" :hasValue t :value (printValue nil) :valueCategory "nil"))))
        ((and specialHead (not (userShadowedSpecial? session specialHead))
              (= specialHead "apropos")
              (= (js-length (get special :items)) 2))
         (let* ((matches (inspectApropos session (get (aref (get special :items) 1) :text))))
           (when (> (js-length matches) 0)
             (js-call (get globalThis.process :stdout) :write (str (js-call matches :join "\n") "\n")))
           (success request (get session :revision)
             (js-object :kind "expression" :hasValue t :value (JSON/stringify matches) :valueCategory "object"))))
        ((and specialHead (not (userShadowedSpecial? session specialHead))
              (= specialHead "dir")
              (<= (js-length (get special :items)) 2))
         (let* ((arg (if (= (js-length (get special :items)) 2)
                       (get (aref (get special :items) 1) :text)
                       nil))
                (entries (inspectDir session arg)))
           (when (> (js-length entries) 0)
             (js-call (get globalThis.process :stdout) :write (str (js-call entries :join "\n") "\n")))
           (success request (get session :revision)
             (js-object :kind "expression" :hasValue t :value (JSON/stringify entries) :valueCategory "object"))))
        ((and specialHead (not (userShadowedSpecial? session specialHead))
              (= specialHead "pst")
              (= (js-length (get special :items)) 1))
         (let ((text (inspectPst session)))
           (js-call (get globalThis.process :stdout) :write (str text "\n"))
           (success request (get session :revision)
             (js-object :kind "expression" :hasValue t :value (printValue nil) :valueCategory "nil"))))
        ((and specialHead (not (userShadowedSpecial? session specialHead))
              (= specialHead "load-file")
              (= (js-length (get special :items)) 2))
         (let* ((rawPath (normalizeTargetSymbolName (get (aref (get special :items) 1) :text)))
                (baseDir (if (and (get request :root) (not (nil? (get request :root))))
                           (resolve (get request :root))
                           (js-call globalThis.process :cwd)))
                (targetPath (if (isAbsolute rawPath) rawPath (resolve baseDir rawPath)))
                (loaded (readEvaluationFile targetPath)))
           (await
             (js-call session :load
               (Object/assign (js-object) request
                 (js-object :operation "load"
                   :source (get loaded :source)
                   :filename (get loaded :filename)))))))
        ((and specialHead (not (userShadowedSpecial? session specialHead))
              (= specialHead "tap>")
              (= (js-length (get special :items)) 2))
         (let* ((exprSource (get (aref (get special :items) 1) :text))
                (exprRequest (Object/assign (js-object) request (js-object :source exprSource)))
                (val (await (evaluateRawExpressionValue session exprRequest))))
           (if (nil? val)
             (success request (get session :revision)
               (js-object :kind "expression" :hasValue t :value "false" :valueCategory "boolean"))
             (progn
               (js-call (get globalThis.process :stdout) :write (str "[tap>] " (printValue val) "\n"))
               (success request (get session :revision)
                 (js-object :kind "expression" :hasValue t :value "true" :valueCategory "boolean"))))))
        (t
         (let ((description
                 (js-call (get session :compiler)
                   :evaluation_form_description rawSource (get request :filename))))
           (when (= (get description :kind) "module")
             (throw (diagnosticError
                      "module forms require a complete-source load operation"
                      (get request :filename))))
           (if (= (get description :kind) "definition")
             (await (js-call session :evaluateDefinition request description))
             (await (js-call session :evaluateExpression request))))))))

  (defasync sessionReset (session request)
    (put session :namespace nil)
    (put session :mode "empty")
    (put session :definitions (new globalThis.Map))
    (put session :rawDefinitions (new globalThis.Map))
    (put session :definitionFilename nil)
    (put session :lastError nil)
    (put session :lastAdjustment nil)
    (clearSessionReplOnce (get session :sessionId))
    (put session :revision (+ (get session :revision) 1))
    (success request (get session :revision)
      (js-object
        :kind "reset"
        :hasValue false
        :value nil
        :valueCategory "none")))

  (defun installSessionTapObserver ()
    (let* ((root (js* "globalThis"))
           (bridge (or (aref root tapHostSymbol)
                       (let ((created (js-object :observers (new globalThis.Set) :flushFns (new globalThis.Set))))
                         (put root tapHostSymbol created)
                         created)))
           (observer (lambda (value)
                       (js-call (get globalThis.process :stdout) :write
                         (str "[tap>] " (printValue value) "\n")))))
      (js-call (get bridge :observers) :add observer)
      (lambda ()
        (try
          (when (get bridge :flushFns)
            (js-call (get bridge :flushFns) :forEach
              (lambda (fn) (funcall fn))))
          (finally
            (js-call (get bridge :observers) :delete observer))))))

  (defasync sessionExecute (session rawRequest)
    (js-call session :ensureOpen)
    (let ((request nil))
      (try
        (setq request (js-call (get session :compiler) :evaluation_operation_request rawRequest))
        (let ((executed
                (await
                  (captureStandardOutput
                    (async ()
                      (let ((teardownTap (installSessionTapObserver)))
                        (try
                          (let ((op (get request :operation)))
                            (cond
                              ((= op "describe") (await (js-call session :describe request)))
                              ((= op "evaluate") (await (js-call session :evaluate request)))
                              ((= op "load") (await (js-call session :load request)))
                              ((= op "reset") (await (js-call session :reset request)))
                              (t (throw (diagnosticError "unsupported evaluation operation")))))
                          (finally
                            (funcall teardownTap)))))))))
          (appendCapturedOutput (get executed :value) (get executed :stdout)))
        (catch error
          (put session :lastError error)
          (put session :lastAdjustment
            (if error (get error :eliscriptEvaluationAdjustment) undefined))
          (appendCapturedOutput
            (failure rawRequest request (get session :revision) error
              (if error (get error :eliscriptEvaluationAdjustment) undefined))
            (if (and error (get error :eliscriptCapturedStdout))
              (get error :eliscriptCapturedStdout)
              ""))))))

  (defun sessionClose (session)
    (unless (get session :closed)
      (put session :closed t)
      (clearSessionReplOnce (get session :sessionId))
      (rmSync (get session :directory) (js-object :recursive t :force t))))

  (defun sessionInitialize (self options)
    (setq evaluationSessionCounter (+ evaluationSessionCounter 1))
    (put self :sessionId (str "session-" evaluationSessionCounter))
    (put self :compiler (get options :compiler))
    (put self :directory (get options :directory))
    (put self :revision 0)
    (put self :artifact 0)
    (put self :namespace nil)
    (put self :mode "empty")
    (put self :definitions (new globalThis.Map))
    (put self :rawDefinitions (new globalThis.Map))
    (put self :definitionFilename nil)
    (put self :lastError nil)
    (put self :lastAdjustment nil)
    (put self :closed false))

  (defconst EvaluationSession
    (js* "class EvaluationSession {
      constructor(options) { sessionInitialize(this, options); }
      static create(options = {}) { return sessionCreate(EvaluationSession, options); }
      ensureOpen() { return sessionEnsureOpen(this); }
      nextArtifactDirectory(label) { return sessionNextArtifactDirectory(this, label); }
      compileSingle(source, filename, label) { return sessionCompileSingle(this, source, filename, label); }
      compileProject(source, filename, root, label) { return sessionCompileProject(this, source, filename, root, label); }
      buildNamespace(source, filename, root, label, displaySource) { return sessionBuildNamespace(this, source, filename, root, label, displaySource); }
      commitNamespace(namespace, mode) { return sessionCommitNamespace(this, namespace, mode); }
      describe(request) { return sessionDescribe(this, request); }
      load(request) { return sessionLoad(this, request); }
      evaluateDefinition(request, description, compiledUnitSource, rawUnitSource) { return sessionEvaluateDefinition(this, request, description, compiledUnitSource, rawUnitSource); }
      evaluateExpression(request) { return sessionEvaluateExpression(this, request); }
      evaluate(request) { return sessionEvaluate(this, request); }
      reset(request) { return sessionReset(this, request); }
      execute(rawRequest) { return sessionExecute(this, rawRequest); }
      doc(name) { return inspectDoc(this, name); }
      source(name) { return inspectSource(this, name); }
      apropos(query) { return inspectApropos(this, query); }
      dir(moduleName) { return inspectDir(this, moduleName); }
      pst() { return inspectPst(this); }
      close() { return sessionClose(this); }
    }"))

  (defasync evaluateOnce (request &rest __opt)
    (let* ((options (aref __opt 0))
           (session (await (js-call EvaluationSession :create (if (undefined? options) (js-object) options)))))
      (try
        (await (js-call session :execute request))
        (finally
          (js-call session :close)))))

  (defun readEvaluationFile (filename)
    (let ((absolute (requestFilename filename)))
      (js-object
        :filename absolute
        :source (readFileSync absolute "utf8"))))

  (export
    evaluationResultFormat
    EvaluationSession
    evaluateOnce
    readEvaluationFile))
