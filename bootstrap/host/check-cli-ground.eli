(module bootstrap.host.check-cli-ground
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./bun.mjs"
    diagnosticFromError loadCompiler renderDiagnostic requestedDiagnosticFormat)
  (import "./project.mjs" checkProject)
  (import "./project-cli.mjs" readProjectConfiguration)

  (defconst usage
    (str "Usage: eliscript-check [OPTIONS] [ENTRY ...]\n\n"
         "Options:\n"
         "  --config FILE     Read entries and root from a project request\n"
         "  --root DIR        Contain local source imports below DIR\n"
         "  --portable NAME   Check NAME and its transitive portable closure\n"
         "  --stdin-file FILE Use standard input as the current contents of FILE\n"
         "  --lint            Run static lint rules ELI-L0001..ELI-L0009\n"
         "  --strict          Fail with non-zero exit status on lint diagnostics\n"
         "  --json            Print the project check report\n"
         "  --diagnostic-format human|json\n"
         "                     Select human-readable or JSON failures\n"
         "  -h, --help         Show this help\n"))

  (defun parseArguments (arguments_)
    (let ((argumentsList (Array/from arguments_))
          (entries (js-array))
          (portableEntries (js-array))
          (configuration undefined)
          (root undefined)
          (stdinFile undefined)
          (lint false)
          (strict false)
          (jsonReport false)
          (diagnosticFormat "human")
          (helpResult nil))
      (when (= (aref argumentsList 0) "--")
        (js-call argumentsList :shift))
      (while (and (nil? helpResult) (> (js-length argumentsList) 0))
        (let ((argument (js-call argumentsList :shift)))
          (cond
            ((or (= argument "-h") (= argument "--help"))
              (setq helpResult (js-object :help t)))
            ((= argument "--config")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires a file"))))
              (unless (undefined? configuration)
                (throw (new globalThis.Error "multiple --config files are not supported")))
              (setq configuration (js-call argumentsList :shift)))
            ((= argument "--root")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires a directory"))))
              (setq root (js-call argumentsList :shift)))
            ((= argument "--portable")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires an entry name"))))
              (js-call portableEntries :push (js-call argumentsList :shift)))
            ((= argument "--stdin-file")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires a file"))))
              (unless (undefined? stdinFile)
                (throw (new globalThis.Error "multiple --stdin-file values are not supported")))
              (setq stdinFile (js-call argumentsList :shift)))
            ((= argument "--lint")
              (setq lint t))
            ((= argument "--strict")
              (setq strict t)
              (setq lint t))
            ((= argument "--json")
              (setq jsonReport t))
            ((= argument "--diagnostic-format")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires human or json"))))
              (setq diagnosticFormat (js-call argumentsList :shift))
              (unless (or (= diagnosticFormat "human") (= diagnosticFormat "json"))
                (throw (new globalThis.Error (str "unsupported diagnostic format: " diagnosticFormat)))))
            ((js-call argument :startsWith "-")
              (throw (new globalThis.Error (str "unknown option: " argument))))
            (t
              (js-call entries :push argument)))))
      (if helpResult
        helpResult
        (progn
          (when (and (undefined? configuration) (= (js-length entries) 0))
            (throw (new globalThis.Error "missing entry file")))
          (js-object
            :entries (if (> (js-length entries) 0) entries undefined)
            :root root
            :portableEntries portableEntries
            :configuration configuration
            :stdinFile stdinFile
            :lint lint
            :strict strict
            :jsonReport jsonReport
            :diagnosticFormat diagnosticFormat)))))

  (defasync execute (arguments_ &rest __opt)
    (let* ((options (aref __opt 0))
           (actual-options (if (undefined? options) (js-object) options))
           (parsed (parseArguments arguments_)))
      (if (get parsed :help)
        (js-object :help t)
        (let* ((compiler (if (nullish? (get actual-options :compiler))
                           (await (loadCompiler (get actual-options :moduleDirectory)))
                           (get actual-options :compiler)))
               (request nil))
          (if (not (undefined? (get parsed :configuration)))
            (let ((configured (await (readProjectConfiguration (get parsed :configuration) compiler))))
              (setq request
                (js-object :entries (get configured :entries)
                  :root (get configured :root)
                  :portableEntries (get configured :portableEntries)))
              (unless (undefined? (get parsed :entries))
                (put request :entries (get parsed :entries)))
              (unless (undefined? (get parsed :root))
                (put request :root (get parsed :root)))
              (when (> (js-length (get parsed :portableEntries)) 0)
                (put request :portableEntries (get parsed :portableEntries))))
            (setq request
              (js-object :entries (get parsed :entries)
                :root (get parsed :root)
                :portableEntries (get parsed :portableEntries))))
          (let ((sourceOverrides undefined))
            (unless (undefined? (get parsed :stdinFile))
              (let ((sourceText (if (nullish? (get actual-options :stdinSource))
                                  (await (readFile 0 "utf8"))
                                  (get actual-options :stdinSource))))
                (setq sourceOverrides (js-object))
                (put sourceOverrides (resolve (get parsed :stdinFile)) sourceText)))
            (let ((result (await (checkProject
                                   (Object/assign (js-object) request
                                     (js-object :sourceOverrides sourceOverrides
                                       :lint (get parsed :lint)
                                       :compiler compiler
                                       :moduleDirectory (get actual-options :moduleDirectory)))))))
              (js-object :result result
                :jsonReport (get parsed :jsonReport)
                :lint (get parsed :lint)
                :strict (get parsed :strict)
                :diagnosticFormat (get parsed :diagnosticFormat))))))))

  (defun formatLintHuman (diagnostics moduleCount)
    (let ((lines (js-array))
          (index 0))
      (while (< index (js-length diagnostics))
        (let ((diag (aref diagnostics index)))
          (js-call lines :push
            (str (renderDiagnostic diag) " [" (get diag :severity) " " (get diag :code) "]")))
        (setq index (+ index 1)))
      (js-call lines :push
        (str "Checked " moduleCount " modules (" (js-length diagnostics) " lint diagnostics)."))
      (str (js-call lines :join "\n") "\n")))

  (defasync main (&rest __opt)
    (let* ((arguments_ (aref __opt 0))
           (actual-args (if (undefined? arguments_)
                          (js-call (get globalThis.process :argv) :slice 2)
                          arguments_))
           (execution (await (execute actual-args))))
      (if (get execution :help)
        (js-call (get globalThis.process :stdout) :write usage)
        (let* ((result (get execution :result))
               (report (get result :report))
               (diagnostics (if (Array/isArray (get result :diagnostics))
                              (get result :diagnostics)
                              (js-array)))
               (hasError (js-call diagnostics :some (lambda (d) (= (get d :severity) "error")))))
          (when (or hasError (and (get execution :strict) (> (js-length diagnostics) 0)))
            (put globalThis.process :exitCode 1))
          (js-call (get globalThis.process :stdout) :write
            (cond
              ((get execution :jsonReport)
               (str (JSON/stringify report) "\n"))
              ((and (get execution :lint) (= (get execution :diagnosticFormat) "json"))
               (str (JSON/stringify diagnostics) "\n"))
              ((get execution :lint)
               (formatLintHuman diagnostics (get (get report :counts) :modules)))
              (t
               (str "Checked " (get (get report :counts) :modules) " modules.\n"))))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (not (undefined? entry))
               (= (resolve entry) (fileURLToPath (js* "import.meta.url"))))
      (let ((outputFormat (requestedDiagnosticFormat (js-call (get globalThis.process :argv) :slice 2))))
        (js-call (main) :catch
          (lambda (error)
            (let ((diagnostic (diagnosticFromError error)))
              (if (= outputFormat "json")
                (console/error (JSON/stringify diagnostic))
                (console/error (str "eliscript-check: " (renderDiagnostic diagnostic))))
              (put globalThis.process :exitCode 1)))))))

  (export execute main parseArguments))
