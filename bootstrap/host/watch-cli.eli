(module bootstrap.host.watch-cli
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./bun.mjs" diagnosticFromError loadCompiler renderDiagnostic)
  (import "./project-cli.mjs" readProjectConfiguration)
  (import "./watch.mjs"
    ProjectWatcher defaultWatchInterval maximumWatchInterval minimumWatchInterval)

  (defconst usage
    (str "Usage: eliscript-watch (--root DIRECTORY | --config FILE) [OPTIONS]\n\n"
         "Options:\n"
         "  --root DIRECTORY  Observe regular .eli files below DIRECTORY\n"
         "  --config FILE     Resolve and observe a versioned project configuration\n"
         "  --interval MS     Poll every " defaultWatchInterval " ms by default (" minimumWatchInterval "-" maximumWatchInterval ")\n"
         "  --json            Emit one versioned JSON event per line\n"
         "  -h, --help        Show this help\n"))

  (defconst digits-pattern (new globalThis.RegExp "^[0-9]+$" "u"))

  (defun parseArguments (arguments_)
    (let ((argumentsList (Array/from arguments_))
          (root undefined)
          (configuration undefined)
          (interval defaultWatchInterval)
          (json false)
          (helpResult nil))
      (while (and (nil? helpResult) (> (js-length argumentsList) 0))
        (let ((argument (js-call argumentsList :shift)))
          (cond
            ((or (= argument "-h") (= argument "--help"))
              (setq helpResult (js-object :help t)))
            ((= argument "--root")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error "--root requires a directory")))
              (setq root (js-call argumentsList :shift)))
            ((= argument "--config")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error "--config requires a file")))
              (setq configuration (js-call argumentsList :shift)))
            ((= argument "--interval")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error "--interval requires milliseconds")))
              (let ((text (js-call argumentsList :shift)))
                (unless (js-call digits-pattern :test text)
                  (throw (new globalThis.Error "--interval requires an integer")))
                (setq interval (globalThis.Number text))))
            ((= argument "--json")
              (setq json t))
            (t
              (throw (new globalThis.Error (str "unknown option: " argument)))))))
      (if helpResult
        helpResult
        (progn
          (when (= (undefined? root) (undefined? configuration))
            (throw (new globalThis.Error "choose exactly one of --root or --config")))
          (js-object :root root :configuration configuration :interval interval :json json)))))

  (defun writeEvent (event json)
    (if json
      (js-call (get globalThis.process :stdout) :write (str (JSON/stringify event) "\n"))
      (cond
        ((= (get event :event) "ready")
          (js-call (get globalThis.process :stdout) :write (str "watching " (get event :root) "\n")))
        ((= (get event :event) "error")
          (js-call (get globalThis.process :stdout) :write
            (str "watch error: " (renderDiagnostic (get event :diagnostic)) "\n")))
        (t
          (let ((changes (get event :changes))
                (index 0))
            (while (< index (js-length changes))
              (let* ((change (aref changes index))
                     (path (if (nullish? (get change :path)) (get change :file) (get change :path))))
                (js-call (get globalThis.process :stdout) :write
                  (str (get change :kind) " " path "\n")))
              (setq index (1+ index))))))))

  (defasync watchOptions (parsed options)
    (if (undefined? (get parsed :configuration))
      (js-object :root (get parsed :root)
        :configuration nil
        :interval (get parsed :interval))
      (let* ((compiler (await (loadCompiler (get options :moduleDirectory))))
             (request (await (readProjectConfiguration (get parsed :configuration) compiler))))
        (js-object :root (get request :root)
          :configuration (get request :configuration)
          :interval (get parsed :interval)))))

  (defasync execute (arguments_ &rest __opt)
    (let* ((options (aref __opt 0))
           (actual-options (if (undefined? options) (js-object) options))
           (parsed (parseArguments arguments_)))
      (if (get parsed :help)
        (js-object :help t)
        (let ((watcher (await (js-call ProjectWatcher :create (await (watchOptions parsed actual-options))))))
          (js-object :watcher watcher :json (get parsed :json))))))

  (defasync main (&rest __opt)
    (let* ((arguments_ (aref __opt 0))
           (actual-args (if (undefined? arguments_)
                          (js-call (get globalThis.process :argv) :slice 2)
                          arguments_))
           (execution (await (execute actual-args))))
      (if (get execution :help)
        (js-call (get globalThis.process :stdout) :write usage)
        (let* ((watcher (get execution :watcher))
               (json (get execution :json))
               (stop nil)
               (stopped (new globalThis.Promise (lambda (resolveStopped) (setq stop resolveStopped))))
               (handleSignal (lambda () (funcall stop))))
          (js-call globalThis.process :once "SIGINT" handleSignal)
          (js-call globalThis.process :once "SIGTERM" handleSignal)
          (try
            (progn
              (js-call watcher :start (lambda (event) (writeEvent event json)))
              (await stopped))
            (finally
              (js-call globalThis.process :removeListener "SIGINT" handleSignal)
              (js-call globalThis.process :removeListener "SIGTERM" handleSignal)
              (await (js-call watcher :close))))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (not (undefined? entry))
               (= (resolve entry) (fileURLToPath (js* "import.meta.url"))))
      (js-call (main) :catch
        (lambda (error)
          (let ((diagnostic (diagnosticFromError error)))
            (console/error (str "eliscript-watch: " (renderDiagnostic diagnostic)))
            (put globalThis.process :exitCode 1))))))

  (export execute main parseArguments))
