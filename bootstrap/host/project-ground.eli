(module bootstrap.host.project-ground
  (import "node:crypto" createHash)
  (import "node:fs" lstatSync mkdirSync readFileSync readdirSync realpathSync statSync writeFileSync)
  (import "node:path" basename dirname isAbsolute relative resolve sep)
  (import "node:perf_hooks" performance)
  (import "node:url" fileURLToPath)
  (import "./bun.mjs" loadCompiler)

  (defconst manifestFilename "eliscript-project.json")
  (defconst cacheFormat "eliscript-project-cache")
  (defconst cacheVersion 2)
  (defconst hostDirectory (dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst sha256-pattern (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))

  (defun host-typeof (value)
    (js* "typeof value"))

  (defun host-map-instance? (value)
    (js* "value instanceof globalThis.Map"))

  (defun projectError (message &optional filename)
    (let ((error (new globalThis.Error message))
          (diag (js-object
                  :format "eliscript-diagnostic"
                  :version 1
                  :code "ELI-B0001"
                  :severity "error"
                  :phase "project-build"
                  :message message)))
      (when (and filename (not (undefined? filename)))
        (put diag :location (js-object :file filename)))
      (put error :eliscriptDiagnostic diag)
      (throw error)))

  (defun canonicalDirectory (path label)
    (let ((expanded (resolve path))
          (attributes nil))
      (try
        (setq attributes (statSync expanded))
        (catch _err
          (projectError (str label " is not a directory") expanded)))
      (unless (js-call attributes :isDirectory)
        (projectError (str label " is not a directory") expanded))
      (realpathSync expanded)))

  (defun pathOption (value label)
    (when (or (not (= (host-typeof value) "string")) (= (js-length value) 0))
      (projectError (str label " must be a non-empty path")))
    value)

  (defun insideRoot (root candidate)
    (let ((path (relative root candidate)))
      (or (= path "")
          (and (not (isAbsolute path))
               (not (= path ".."))
               (not (js-call path :startsWith (str ".." sep)))))))

  (defun canonicalSource (path root importer)
    (let ((expanded (resolve path))
          (attributes nil))
      (try
        (setq attributes (statSync expanded))
        (catch _err
          (projectError (str "local Eliscript module does not exist: " path) importer)))
      (unless (js-call attributes :isFile)
        (projectError (str "local Eliscript module does not exist: " path) importer))
      (let ((canonical (realpathSync expanded)))
        (unless (insideRoot root canonical)
          (projectError (str "local Eliscript module escapes project root: " path) importer))
        canonical)))

  (defun macroDependency (specifier root importer)
    (let ((expanded (resolve root specifier))
          (attributes nil))
      (try
        (setq attributes (statSync expanded))
        (catch _err
          (projectError (str "macro file dependency does not exist: " specifier) importer)))
      (unless (js-call attributes :isFile)
        (projectError (str "macro file dependency does not exist: " specifier) importer))
      (let ((source (realpathSync expanded)))
        (unless (insideRoot root source)
          (projectError (str "macro file dependency escapes project root: " specifier) importer))
        (let ((bytes (readFileSync source))
              (content nil))
          (try
            (setq content
              (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode bytes))
            (catch _err
              (projectError (str "macro file dependency is not valid UTF-8: " specifier) importer)))
          (js-object
            :specifier specifier
            :source source
            :digest (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")
            :content content)))))

  (defun macroInputs (request root importer)
    (let* ((dependencies
             (js-call (Array/from (get request :macroFileDependencies)) :map
               (lambda (specifier) (macroDependency specifier root importer))))
           (canonical
             (new globalThis.Set
               (js-call dependencies :map (lambda (dep) (get dep :source))))))
      (unless (= (get canonical :size) (js-length dependencies))
        (projectError "macro file dependencies resolve to duplicates" importer))
      (js-object
        :dependencies dependencies
        :context
          (js-object
            :capabilities (new globalThis.Set (get request :macroCapabilities))
            :files
              (new globalThis.Map
                (js-call dependencies :map
                  (lambda (dep) (js-array (get dep :specifier) (get dep :content)))))))))

  (defun macroDependencyRecords (dependencies root)
    (js-call dependencies :map
      (lambda (dep)
        (js-object
          :path (relative root (get dep :source))
          :digest (get dep :digest)))))

  (defun outputFor (source root outDir)
    (let ((sourcePath (relative root source)))
      (resolve outDir (str (js-call sourcePath :slice 0 -4) ".mjs"))))

  (defun physicalWritePath (path)
    (let ((expanded (resolve path))
          (suffix (js-array))
          (cursor (resolve path))
          (resolved nil))
      (while (nil? resolved)
        (try
          (lstatSync cursor)
          (let ((canonical nil))
            (try
              (setq canonical (realpathSync cursor))
              (catch _err
                (projectError (str "generated artifact contains an unresolved symlink: " expanded))))
            (setq resolved
              (js-call resolve :apply nil
                (js-call (js-array canonical) :concat
                  (js-call (Array/from suffix) :reverse)))))
          (catch error
            (when (and error (get error :eliscriptDiagnostic))
              (throw error))
            (unless (= (if error (get error :code) nil) "ENOENT")
              (projectError (str "generated artifact path cannot be resolved: " expanded)))
            (let ((parent (dirname cursor)))
              (when (= parent cursor)
                (projectError (str "generated artifact path cannot be resolved: " expanded)))
              (js-call suffix :push (basename cursor))
              (setq cursor parent)))))
      resolved))

  (defun existingFileIdentity (path)
    (try
      (let ((attributes (statSync path)))
        (if (js-call attributes :isFile)
          (str (get attributes :dev) ":" (get attributes :ino))
          nil))
      (catch _err
        nil)))

  (defun validateOutputIsolation (options)
    (let* ((sources (get options :sources))
           (macroDependencies (get options :macroDependencies))
           (root (get options :root))
           (outDir (get options :outDir))
           (protectedPaths
             (js-call (Array/from sources) :concat
               (js-call macroDependencies :map (lambda (dep) (get dep :source)))))
           (protectedCanonical
             (new globalThis.Set
               (js-call protectedPaths :map (lambda (p) (realpathSync p)))))
           (protectedIdentities
             (new globalThis.Set
               (js-call (js-call protectedPaths :map existingFileIdentity) :filter
                 (lambda (id) (not (nil? id))))))
           (artifacts
             (js-call
               (js-call sources :flatMap
                 (lambda (source)
                   (let ((output (outputFor source root outDir)))
                     (js-array output (str output ".map")))))
               :concat
               (js-array (resolve outDir manifestFilename))))
           (artifactCanonical (new globalThis.Set))
           (artifactIdentities (new globalThis.Set))
           (idx 0))
      (while (< idx (js-length artifacts))
        (let* ((artifact (aref artifacts idx))
               (physical (physicalWritePath artifact))
               (identity (existingFileIdentity artifact)))
          (unless (insideRoot outDir physical)
            (projectError (str "generated artifact escapes output directory: " artifact)))
          (when (or (js-call protectedCanonical :has physical)
                    (and (not (nil? identity)) (js-call protectedIdentities :has identity)))
            (projectError (str "generated artifact would overwrite an input: " artifact)))
          (when (or (js-call artifactCanonical :has physical)
                    (and (not (nil? identity)) (js-call artifactIdentities :has identity)))
            (projectError (str "generated artifacts resolve to the same file: " artifact)))
          (js-call artifactCanonical :add physical)
          (unless (nil? identity)
            (js-call artifactIdentities :add identity)))
        (setq idx (+ idx 1)))))

  (defun localSourceImport (specifier)
    (and (js-call specifier :endsWith ".eli")
         (or (js-call specifier :startsWith "./")
             (js-call specifier :startsWith "../"))))

  (defun relativeImport (target importer)
    (let ((path (relative (dirname importer) target)))
      (if (or (js-call path :startsWith "./") (js-call path :startsWith "../"))
        path
        (str "./" path))))

  (defun walkProgram (program visit)
    (let ((pending (Array/from (get program :body))))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :pop))
               (index (- (js-length (get node :children)) 1)))
          (funcall visit node)
          (while (>= index 0)
            (js-call pending :push (aref (get node :children) index))
            (setq index (- index 1)))))))

  (defun projectImports (program source root portable)
    (let ((imports (js-array)))
      (walkProgram
        program
        (lambda (node)
          (when (= (get node :kind) "import-declaration")
            (let ((specifier (get node :value))
                  (props (get node :properties)))
              (when (and portable (not (= (if props (get props :portable) nil) t)))
                (projectError "portable project contains a non-portable import" source))
              (if (not (localSourceImport specifier))
                (when (or portable (js-call specifier :endsWith ".eli"))
                  (let ((kind (if portable "portable import" "Eliscript source import")))
                    (projectError (str kind " must be a relative .eli module: " specifier) source)))
                (let ((dependency (canonicalSource (resolve (dirname source) specifier) root source)))
                  (js-call imports :push
                    (js-object
                      :dependency dependency
                      :entries
                        (js-call
                          (js-call (get node :children) :filter
                            (lambda (child) (= (get child :kind) "import-named")))
                          :map
                          (lambda (child) (get child :value)))
                      :node node))))))))
      imports))

  (defun rewriteLocalImports (program source root outDir)
    (let ((outputPath (outputFor source root outDir)))
      (walkProgram
        program
        (lambda (node)
          (when (and (= (get node :kind) "import-declaration")
                     (localSourceImport (get node :value)))
            (let ((dependency (canonicalSource (resolve (dirname source) (get node :value)) root source)))
              (put node :value
                (relativeImport (outputFor dependency root outDir) outputPath))))))))

  (defun digestBytes (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))

  (defun digestFile (filename)
    (digestBytes (readFileSync filename)))

  (defun regularFile (filename)
    (try
      (js-call (statSync filename) :isFile)
      (catch error
        (if (= (if error (get error :code) nil) "ENOENT")
          false
          (throw error)))))

  (defun compilerModuleDirectory (moduleDirectory)
    (resolve
      (if (and (not (nil? moduleDirectory)) (not (undefined? moduleDirectory)))
        moduleDirectory
        (let ((env-dir (get (get globalThis.process :env) :ELISCRIPT_BOOTSTRAP_MODULE_DIR)))
          (if (and env-dir (not (undefined? env-dir)))
            env-dir
            (resolve hostDirectory "../../dist/bootstrap"))))))

  (defun compilerDirectoryDigest (directory)
    (let ((filenames
            (js-call
              (js-call
                (js-call (readdirSync directory (js-object :withFileTypes t)) :filter
                  (lambda (entry)
                    (and (js-call entry :isFile)
                         (or (js-call (get entry :name) :endsWith ".mjs")
                             (js-call (get entry :name) :endsWith ".mjs.map")))))
                :map
                (lambda (entry) (get entry :name)))
              :sort)))
      (unless (js-call filenames :includes "compiler.mjs")
        (projectError "generated compiler directory is incomplete" directory))
      (let ((hash (createHash "sha256"))
            (idx 0))
        (while (< idx (js-length filenames))
          (let ((filename (aref filenames idx)))
            (js-call hash :update filename)
            (js-call hash :update "\0")
            (js-call hash :update (readFileSync (resolve directory filename)))
            (js-call hash :update "\0"))
          (setq idx (+ idx 1)))
        (js-call hash :digest "hex"))))

  (defun compilerDigestOption (value)
    (when (or (not (= (host-typeof value) "string"))
              (not (js-call sha256-pattern :test value)))
      (projectError "injected compiler requires a lowercase SHA-256 compilerDigest"))
    value)

  (defun writeModule (options)
    (let* ((compiler (get options :compiler))
           (program (get options :program))
           (source (get options :source))
           (sourceText (get options :sourceText))
           (root (get options :root))
           (outDir (get options :outDir))
           (dependencies (get options :dependencies))
           (macroDependencies (get options :macroDependencies))
           (portableEntries (get options :portableEntries))
           (reason (get options :reason))
           (sourceMapReference (get options :sourceMapReference))
           (output (outputFor source root outDir))
           (sourceMap (str output ".map")))
      (rewriteLocalImports program source root outDir)
      (let* ((emission
               (js-call compiler :emit_ir_string_with_source_map
                 program
                 sourceText
                 (basename output)
                 (relative (dirname sourceMap) source)))
             (javascript
               (if sourceMapReference
                 (str (get emission :javascript) "//# sourceMappingURL=" (basename sourceMap) "\n")
                 (get emission :javascript))))
        (mkdirSync (dirname output) (js-object :recursive t))
        (writeFileSync sourceMap (get emission :sourceMap))
        (writeFileSync output javascript)
        (js-object
          :source source
          :output output
          :sourceMap sourceMap
          :sourceDigest (digestBytes sourceText)
          :outputDigest (digestFile output)
          :sourceMapDigest (digestFile sourceMap)
          :dependencies dependencies
          :macroDependencies macroDependencies
          :portableEntries portableEntries
          :reused false
          :reason reason))))

  (defun reportModule (moduleRecord root outDir)
    (let ((out
            (js-object
              :source (relative root (get moduleRecord :source))
              :output (relative outDir (get moduleRecord :output))
              :sourceMap (relative outDir (get moduleRecord :sourceMap))
              :status (if (get moduleRecord :reused) "reused" "compiled")
              :reason (get moduleRecord :reason)
              :dependencies
                (js-call (get moduleRecord :dependencies) :map
                  (lambda (dependency) (relative root dependency))))))
      (when (> (js-length (get moduleRecord :macroDependencies)) 0)
        (put out :macroDependencies
          (macroDependencyRecords (get moduleRecord :macroDependencies) root)))
      (put out :portableEntries (Array/from (get moduleRecord :portableEntries)))
      out))

  (defun manifestRecord (moduleRecord root outDir)
    (let ((out
            (js-object
              :source (relative root (get moduleRecord :source))
              :output (relative outDir (get moduleRecord :output))
              :sourceMap (relative outDir (get moduleRecord :sourceMap))
              :sourceDigest (get moduleRecord :sourceDigest)
              :outputDigest (get moduleRecord :outputDigest)
              :sourceMapDigest (get moduleRecord :sourceMapDigest))))
      (when (> (js-length (get moduleRecord :macroDependencies)) 0)
        (put out :macroDependencies
          (macroDependencyRecords (get moduleRecord :macroDependencies) root)))
      out))

  (defun cacheMetadataRecord (moduleRecord root)
    (let ((out
            (js-object
              :source (relative root (get moduleRecord :source))
              :dependencies
                (js-call (get moduleRecord :dependencies) :map
                  (lambda (dependency) (relative root dependency))))))
      (when (> (js-length (get moduleRecord :macroDependencies)) 0)
        (put out :macroDependencies
          (macroDependencyRecords (get moduleRecord :macroDependencies) root)))
      (put out :portableEntries (Array/from (get moduleRecord :portableEntries)))
      out))

  (defun cacheIdentityModule (record)
    (let ((out
            (js-object
              :source (get record :source)
              :dependencies (get record :dependencies))))
      (unless (undefined? (get record :macroDependencies))
        (put out :macroDependencies (get record :macroDependencies)))
      (put out :portableEntries (get record :portableEntries))
      out))

  (defun cacheIdentity (value)
    (if (or (not value) (not (Array/isArray (get value :modules))))
      undefined
      (let ((modules (js-call (get value :modules) :map cacheIdentityModule)))
        (if (and (undefined? (get value :format)) (= (get value :version) 1))
          (js-object
            :version 1
            :compilerDigest (get value :compilerDigest)
            :mode (get value :mode)
            :portableEntries (get value :portableEntries)
            :modules modules)
          (js-object
            :format (get value :format)
            :version (get value :version)
            :compilerDigest (get value :compilerDigest)
            :mode (get value :mode)
            :portableEntries (get value :portableEntries)
            :modules modules)))))

  (defun writeManifest (entryOutputs modules root outDir mode portableEntries compilerDigest)
    (let* ((outputEntries
             (js-call entryOutputs :map (lambda (entryOutput) (relative outDir entryOutput))))
           (manifestModules
             (js-call modules :map (lambda (mod) (manifestRecord mod root outDir))))
           (identity
             (if (= (js-length outputEntries) 1)
               (js-object
                 :format "eliscript-project"
                 :version 1
                 :entry (aref outputEntries 0)
                 :modules manifestModules)
               (js-object
                 :format "eliscript-project"
                 :version 2
                 :entries outputEntries
                 :modules manifestModules)))
           (digest (digestBytes (JSON/stringify identity)))
           (cache
             (js-object
               :format cacheFormat
               :version cacheVersion
               :compilerDigest compilerDigest
               :mode mode
               :portableEntries portableEntries
               :modules (js-call modules :map (lambda (mod) (cacheMetadataRecord mod root)))))
           (cacheDigest (digestBytes (JSON/stringify cache)))
           (manifest (resolve outDir manifestFilename))
           (fullManifest
             (Object/assign
               (js-object)
               identity
               (js-object
                 :digest digest
                 :cache (Object/assign (js-object) cache (js-object :digest cacheDigest))))))
      (mkdirSync outDir (js-object :recursive t))
      (writeFileSync manifest (str (JSON/stringify fullManifest) "\n"))
      (js-object
        :manifest (realpathSync manifest)
        :digest digest)))

  (defun readCache (options)
    (let* ((compiler (get options :compiler))
           (enabled (get options :enabled))
           (outDir (get options :outDir))
           (entryOutputs (get options :entryOutputs))
           (mode (get options :mode))
           (portableEntries (get options :portableEntries))
           (compilerDigest (get options :compilerDigest))
           (manifestPath (resolve outDir manifestFilename)))
      (cond
        ((not enabled)
         (js-call compiler :project_cache_lookup (js-object :enabled false :manifestStatus "missing")))
        ((not (regularFile manifestPath))
         (js-call compiler :project_cache_lookup (js-object :enabled t :manifestStatus "missing")))
        (t
         (try
           (let* ((manifest (JSON/parse (readFileSync manifestPath "utf8")))
                  (graphIdentity
                    (if (= (if manifest (get manifest :version) nil) 2)
                      (js-object
                        :format (if manifest (get manifest :format) undefined)
                        :version (if manifest (get manifest :version) undefined)
                        :entries (if manifest (get manifest :entries) undefined)
                        :modules (if manifest (get manifest :modules) undefined))
                      (js-object
                        :format (if manifest (get manifest :format) undefined)
                        :version (if manifest (get manifest :version) undefined)
                        :entry (if manifest (get manifest :entry) undefined)
                        :modules (if manifest (get manifest :modules) undefined))))
                  (privateIdentity (cacheIdentity (if manifest (get manifest :cache) undefined))))
             (js-call compiler :project_cache_lookup
               (js-object
                 :enabled t
                 :manifestStatus "readable"
                 :manifest manifest
                 :expectedEntry
                   (if (= (js-length entryOutputs) 1)
                     (relative outDir (aref entryOutputs 0))
                     undefined)
                 :expectedEntries
                   (js-call entryOutputs :map (lambda (entryOutput) (relative outDir entryOutput)))
                 :graphDigestValid
                   (= (if manifest (get manifest :digest) undefined)
                      (digestBytes (JSON/stringify graphIdentity)))
                 :cacheDigestValid
                   (and (not (undefined? privateIdentity))
                        (= (if (and manifest (get manifest :cache))
                             (get (get manifest :cache) :digest)
                             undefined)
                           (digestBytes (JSON/stringify privateIdentity))))
                 :compilerDigest compilerDigest
                 :mode mode
                 :portableEntries portableEntries)))
           (catch _err
             (js-call compiler :project_cache_lookup (js-object :enabled t :manifestStatus "unreadable"))))))))

  (defun cachedRecords (lookup)
    (let ((records (if (and (get lookup :cache) (get (get lookup :cache) :records))
                     (get (get lookup :cache) :records)
                     (js-array))))
      (new globalThis.Map
        (js-call records :map (lambda (record) (js-array (get record :source) record))))))

  (defun cachedModule (options)
    (let* ((compiler (get options :compiler))
           (source (get options :source))
           (root (get options :root))
           (outDir (get options :outDir))
           (record (get options :record))
           (expectedPortableEntries (get options :expectedPortableEntries))
           (expectedMacroDependencies
             (if (or (nil? (get options :expectedMacroDependencies))
                     (undefined? (get options :expectedMacroDependencies)))
               (js-array)
               (get options :expectedMacroDependencies)))
           (output (outputFor source root outDir))
           (sourceMap (str output ".map"))
           (sourceDigest undefined)
           (outputDigest undefined)
           (sourceMapDigest undefined)
           (outputExists false)
           (sourceMapExists false)
           (artifactFailure undefined))
      (try
        (setq sourceDigest (digestFile source))
        (setq outputExists (regularFile output))
        (setq sourceMapExists (regularFile sourceMap))
        (when outputExists
          (setq outputDigest (digestFile output)))
        (when sourceMapExists
          (setq sourceMapDigest (digestFile sourceMap)))
        (catch _err
          (setq artifactFailure "artifact-unreadable")))
      (let ((dependencies (js-array))
            (dependenciesValid t)
            (expectedMacroRecords (macroDependencyRecords expectedMacroDependencies root))
            (macroDependenciesMatch false))
        (try
          (let ((metadata (if record (get record :metadata) nil)))
            (when (or (not metadata)
                      (not (Array/isArray (get metadata :dependencies)))
                      (not (Array/isArray (get metadata :portableEntries))))
              (throw (new globalThis.TypeError "cache module metadata is invalid")))
            (setq dependencies
              (js-call (get metadata :dependencies) :map
                (lambda (dependency)
                  (canonicalSource (resolve root dependency) root source))))
            (let ((recordedMacroDependencies
                    (if (or (nil? (get metadata :macroDependencies))
                            (undefined? (get metadata :macroDependencies)))
                      (js-array)
                      (get metadata :macroDependencies))))
              (setq macroDependenciesMatch
                (= (JSON/stringify recordedMacroDependencies)
                   (JSON/stringify expectedMacroRecords)))))
          (catch _err
            (setq dependenciesValid false)))
        (let ((decision
                (js-call compiler :project_cache_decision
                  (js-object
                    :record record
                    :output (relative outDir output)
                    :sourceMap (relative outDir sourceMap)
                    :expectedPortableEntries expectedPortableEntries
                    :macroDependenciesMatch macroDependenciesMatch
                    :sourceDigest sourceDigest
                    :outputExists outputExists
                    :sourceMapExists sourceMapExists
                    :outputDigest outputDigest
                    :sourceMapDigest sourceMapDigest
                    :dependenciesValid dependenciesValid
                    :artifactFailure artifactFailure))))
          (js-object
            :decision decision
            :module
              (if (get decision :reused)
                (js-object
                  :source source
                  :output output
                  :sourceMap sourceMap
                  :sourceDigest sourceDigest
                  :outputDigest outputDigest
                  :sourceMapDigest sourceMapDigest
                  :dependencies dependencies
                  :macroDependencies expectedMacroDependencies
                  :portableEntries (Array/from (get (get record :metadata) :portableEntries))
                  :reused t
                  :reason "verified")
                undefined))))))

  (defun standardPlan (compiler entries root outDir sourceCache programCache records decisions sourceOverrides macroContext macroDependencies)
    (js-call compiler :project_plan
      entries
      (lambda (source)
        (let ((cached
                (cachedModule
                  (js-object
                    :compiler compiler
                    :source source
                    :root root
                    :outDir outDir
                    :record (js-call records :get (relative root source))
                    :expectedPortableEntries (js-array)
                    :expectedMacroDependencies macroDependencies))))
          (js-call decisions :set source cached)
          (if (not (undefined? (get cached :module)))
            (get (get cached :module) :dependencies)
            (let* ((overrideText (js-call sourceOverrides :get source))
                   (sourceText (if (not (undefined? overrideText))
                                 overrideText
                                 (readFileSync source "utf8")))
                   (program (js-call compiler :compile_ir_string sourceText source macroContext)))
              (js-call sourceCache :set source sourceText)
              (js-call programCache :set source program)
              (js-call (projectImports program source root false) :map
                (lambda (imp) (get imp :dependency)))))))))

  (defun portablePlan (compiler entry entries root sourceCache programCache sourceOverrides macroContext)
    (js-call compiler :portable_project_plan
      (js-array (js-object :id entry :entries entries))
      (lambda (source requestedEntries)
        (let* ((overrideText (js-call sourceOverrides :get source))
               (sourceText (if (not (undefined? overrideText))
                             overrideText
                             (readFileSync source "utf8")))
               (program
                 (js-call compiler :compile_project_portable_ir_string
                   sourceText
                   requestedEntries
                   source
                   macroContext)))
          (js-call sourceCache :set source sourceText)
          (js-call programCache :set source program)
          (js-call (projectImports program source root t) :map
            (lambda (dependency)
              (js-object
                :id (get dependency :dependency)
                :entries (get dependency :entries))))))))

  (defun sourceOverridesOption (values root)
    (if (undefined? values)
      (new globalThis.Map)
      (let ((entries (if (host-map-instance? values)
                       (Array/from (js-call values :entries))
                       (Object/entries values)))
            (overrides (new globalThis.Map))
            (idx 0))
        (while (< idx (js-length entries))
          (let* ((pair (aref entries idx))
                 (filename (aref pair 0))
                 (sourceText (aref pair 1)))
            (unless (= (host-typeof sourceText) "string")
              (projectError "project source override must be a string" filename))
            (let ((source (canonicalSource (pathOption filename "project source override") root filename)))
              (when (js-call overrides :has source)
                (projectError "project source overrides resolve to duplicates" source))
              (js-call overrides :set source sourceText)))
          (setq idx (+ idx 1)))
        overrides)))

  (defun validateSourceOverrides (sourceOverrides plan)
    (let ((plannedSources
            (new globalThis.Set
              (js-call (get plan :modules) :map (lambda (record) (get record :id))))))
      (js-call sourceOverrides :forEach
        (lambda (_text source)
          (unless (js-call plannedSources :has source)
            (projectError "project source override is outside the project graph" source))))))

  (defun checkStandardPlan (compiler entries root sourceOverrides macroContext)
    (js-call compiler :project_plan
      entries
      (lambda (source)
        (let* ((overrideText (js-call sourceOverrides :get source))
               (sourceText (if (not (undefined? overrideText))
                             overrideText
                             (readFileSync source "utf8")))
               (program (js-call compiler :compile_ir_string sourceText source macroContext)))
          (js-call (projectImports program source root false) :map
            (lambda (imp) (get imp :dependency)))))))

  (defun checkPortablePlan (compiler entry entries root sourceOverrides macroContext)
    (js-call compiler :portable_project_plan
      (js-array (js-object :id entry :entries entries))
      (lambda (source requestedEntries)
        (let* ((overrideText (js-call sourceOverrides :get source))
               (sourceText (if (not (undefined? overrideText))
                             overrideText
                             (readFileSync source "utf8")))
               (program
                 (js-call compiler :compile_project_portable_ir_string
                   sourceText
                   requestedEntries
                   source
                   macroContext)))
          (js-call (projectImports program source root t) :map
            (lambda (dependency)
              (js-object
                :id (get dependency :dependency)
                :entries (get dependency :entries))))))))

  (defasync checkProject (options)
    (when (or (not options) (not (= (host-typeof options) "object")))
      (projectError "project check options must be an object"))
    (when (and (undefined? (get options :entry))
               (undefined? (get options :entries)))
      (projectError "project check requires entry or entries"))
    (let* ((moduleDirectory (compilerModuleDirectory (get options :moduleDirectory)))
           (compiler (if (not (undefined? (get options :compiler)))
                       (get options :compiler)
                       (await (loadCompiler moduleDirectory))))
           (request
             (js-call compiler :check_operation_request
               (js-object
                 :entry (get options :entry)
                 :entries (get options :entries)
                 :root (if (or (nil? (get options :root)) (undefined? (get options :root)))
                         nil
                         (get options :root))
                 :portableEntries
                   (if (or (nil? (get options :portableEntries)) (undefined? (get options :portableEntries)))
                     (js-array)
                     (get options :portableEntries))
                 :macroCapabilities
                   (if (or (nil? (get options :macroCapabilities)) (undefined? (get options :macroCapabilities)))
                     (js-array)
                     (get options :macroCapabilities))
                 :macroFileDependencies
                   (if (or (nil? (get options :macroFileDependencies)) (undefined? (get options :macroFileDependencies)))
                     (js-array)
                     (get options :macroFileDependencies)))))
           (entryPaths
             (js-call (get request :entries) :map
               (lambda (entry) (resolve (pathOption entry "entry"))))))
      (when (and (> (js-length entryPaths) 1) (nil? (get request :root)))
        (projectError "multi-entry project checks require an explicit project root"))
      (let* ((root
               (canonicalDirectory
                 (if (nil? (get request :root))
                   (dirname (aref entryPaths 0))
                   (pathOption (get request :root) "project root"))
                 "project root"))
             (entries
               (js-call
                 (js-call entryPaths :map
                   (lambda (entryPath)
                     (let ((entry (canonicalSource entryPath root entryPath)))
                       (unless (js-call entry :endsWith ".eli")
                         (projectError "entry file must use the .eli extension" entry))
                       entry)))
                 :sort)))
        (unless (= (get (new globalThis.Set entries) :size) (js-length entries))
          (projectError "project entries resolve to duplicate sources"))
        (let* ((macro (macroInputs request root (aref entries 0)))
               (sourceOverrides (sourceOverridesOption (get options :sourceOverrides) root))
               (portableEntries (Array/from (get request :portableEntries)))
               (plan (if (> (js-length portableEntries) 0)
                       (checkPortablePlan compiler (aref entries 0) portableEntries root sourceOverrides (get macro :context))
                       (checkStandardPlan compiler entries root sourceOverrides (get macro :context)))))
          (validateSourceOverrides sourceOverrides plan)
          (let* ((mode (get plan :mode))
                 (modules
                   (js-call (get plan :modules) :map
                     (lambda (record)
                       (js-object
                         :source (relative root (get record :id))
                         :dependencies
                           (js-call (get record :dependencies) :map
                             (lambda (dependency)
                               (relative root
                                 (if (= (host-typeof dependency) "string")
                                   dependency
                                   (get dependency :id)))))
                         :portableEntries
                           (if (undefined? (get record :entries))
                             (js-array)
                             (Array/from (get record :entries)))))))
                 (report
                   (js-call compiler :project_check_report
                     (js-object
                       :mode mode
                       :root root
                       :entries (js-call entries :map (lambda (entry) (relative root entry)))
                       :portableEntries portableEntries
                       :modules modules))))
            (Object/freeze
              (js-object
                :format "eliscript-project-check"
                :version 1
                :root root
                :entries (Object/freeze entries)
                :mode mode
                :portableEntries (Object/freeze portableEntries)
                :macroCapabilities (get request :macroCapabilities)
                :macroFileDependencies (Object/freeze (get macro :dependencies))
                :report report
                :plan plan)))))))

  (defasync buildProject (options)
    (let ((startedAt (js-call performance :now)))
      (when (or (not options) (not (= (host-typeof options) "object")))
        (projectError "project build options must be an object"))
      (when (or (and (undefined? (get options :entry))
                     (undefined? (get options :entries)))
                (undefined? (get options :outDir)))
        (projectError "project build requires entry or entries and outDir"))
      (let* ((moduleDirectory (compilerModuleDirectory (get options :moduleDirectory)))
             (compiler (if (not (undefined? (get options :compiler)))
                         (get options :compiler)
                         (await (loadCompiler moduleDirectory))))
             (request
               (js-call compiler :build_operation_request
                 (js-object
                   :mode "project"
                   :entry (get options :entry)
                   :entries (get options :entries)
                   :outDir (get options :outDir)
                   :root (if (or (nil? (get options :root)) (undefined? (get options :root)))
                           nil
                           (get options :root))
                   :portableEntries
                     (if (or (nil? (get options :portableEntries)) (undefined? (get options :portableEntries)))
                       (js-array)
                       (get options :portableEntries))
                   :macroCapabilities
                     (if (or (nil? (get options :macroCapabilities)) (undefined? (get options :macroCapabilities)))
                       (js-array)
                       (get options :macroCapabilities))
                   :macroFileDependencies
                     (if (or (nil? (get options :macroFileDependencies)) (undefined? (get options :macroFileDependencies)))
                       (js-array)
                       (get options :macroFileDependencies))
                   :useCache
                     (if (undefined? (get options :useCache))
                       t
                       (get options :useCache)))))
             (requestedEntries
               (if (= (get request :version) 2)
                 (Array/from (get request :entries))
                 (js-array (get request :entry)))))
        (when (and (> (js-length requestedEntries) 1) (nil? (get request :root)))
          (projectError "multi-entry project builds require an explicit project root"))
        (let* ((entryPaths
                 (js-call requestedEntries :map
                   (lambda (entry) (resolve (pathOption entry "entry")))))
               (root
                 (canonicalDirectory
                   (if (nil? (get request :root))
                     (dirname (aref entryPaths 0))
                     (pathOption (get request :root) "project root"))
                   "project root"))
               (entries
                 (js-call
                   (js-call entryPaths :map
                     (lambda (entryPath)
                       (let ((entry (canonicalSource entryPath root entryPath)))
                         (unless (js-call entry :endsWith ".eli")
                           (projectError "entry file must use the .eli extension" entry))
                         entry)))
                   :sort)))
          (unless (= (get (new globalThis.Set entries) :size) (js-length entries))
            (projectError "project entries resolve to duplicate sources"))
          (let* ((macro (macroInputs request root (aref entries 0)))
                 (sourceOverrides (sourceOverridesOption (get options :sourceOverrides) root))
                 (requestedOutDir (resolve (pathOption (get request :outDir) "output"))))
            (try
              (let ((attributes (statSync requestedOutDir)))
                (unless (js-call attributes :isDirectory)
                  (projectError "output path is not a directory" requestedOutDir)))
              (catch error
                (when (and error (get error :eliscriptDiagnostic))
                  (throw error))
                (mkdirSync requestedOutDir (js-object :recursive t))))
            (let* ((outDir (realpathSync requestedOutDir))
                   (sourceMapReference (not (= (get options :sourceMapReference) false)))
                   (useCache
                     (globalThis.Boolean
                       (and (get request :useCache)
                            (= (get sourceOverrides :size) 0)
                            sourceMapReference)))
                   (compilerDigest
                     (if (undefined? (get options :compiler))
                       (compilerDirectoryDigest moduleDirectory)
                       (compilerDigestOption (get options :compilerDigest))))
                   (requestedPortableEntries (Array/from (get request :portableEntries)))
                   (mode (if (> (js-length requestedPortableEntries) 0) "portable" "standard"))
                   (entryOutputs
                     (js-call entries :map (lambda (entry) (outputFor entry root outDir))))
                   (cacheStartedAt (js-call performance :now))
                   (cacheLookup
                     (readCache
                       (js-object
                         :compiler compiler
                         :enabled useCache
                         :outDir outDir
                         :entryOutputs entryOutputs
                         :mode mode
                         :portableEntries requestedPortableEntries
                         :compilerDigest compilerDigest)))
                   (cacheReadMs (- (js-call performance :now) cacheStartedAt))
                   (records (cachedRecords cacheLookup))
                   (sourceCache (new globalThis.Map))
                   (programCache (new globalThis.Map))
                   (decisions (new globalThis.Map))
                   (plan
                     (if (= mode "portable")
                       (portablePlan compiler (aref entries 0) requestedPortableEntries root sourceCache programCache sourceOverrides (get macro :context))
                       (standardPlan compiler entries root outDir sourceCache programCache records decisions sourceOverrides (get macro :context) (get macro :dependencies)))))
              (validateSourceOverrides sourceOverrides plan)
              (validateOutputIsolation
                (js-object
                  :sources (js-call (get plan :modules) :map (lambda (rec) (get rec :id)))
                  :macroDependencies (get macro :dependencies)
                  :root root
                  :outDir outDir))
              (let* ((normalizedPortableEntries
                       (if (= (get plan :mode) "portable")
                         (Array/from (get (aref (get plan :entries) 0) :entries))
                         (js-array)))
                     (modules
                       (js-call (get plan :modules) :map
                         (lambda (record)
                           (let* ((dependencies
                                    (js-call (get record :dependencies) :map
                                      (lambda (dependency)
                                        (if (= (host-typeof dependency) "string")
                                          dependency
                                          (get dependency :id)))))
                                  (modulePortableEntries
                                    (if (undefined? (get record :entries))
                                      (js-array)
                                      (Array/from (get record :entries))))
                                  (cached
                                    (if (= (get plan :mode) "standard")
                                      (js-call decisions :get (get record :id))
                                      (cachedModule
                                        (js-object
                                          :compiler compiler
                                          :source (get record :id)
                                          :root root
                                          :outDir outDir
                                          :record (js-call records :get (relative root (get record :id)))
                                          :expectedPortableEntries modulePortableEntries
                                          :expectedMacroDependencies (get macro :dependencies))))))
                             (if (and cached (not (undefined? (get cached :module))))
                               (get cached :module)
                               (writeModule
                                 (js-object
                                   :compiler compiler
                                   :program (js-call programCache :get (get record :id))
                                   :source (get record :id)
                                   :sourceText (js-call sourceCache :get (get record :id))
                                   :root root
                                   :outDir outDir
                                   :dependencies dependencies
                                   :macroDependencies (get macro :dependencies)
                                   :portableEntries modulePortableEntries
                                   :reason (if (nil? (get cacheLookup :cache))
                                             (get cacheLookup :reason)
                                             (get (get cached :decision) :reason))
                                   :sourceMapReference sourceMapReference)))))))
                     (workFinishedAt (js-call performance :now))
                     (manifestData
                       (writeManifest entryOutputs modules root outDir (get plan :mode) normalizedPortableEntries compilerDigest))
                     (manifestFinishedAt (js-call performance :now))
                     (reportInput
                       (js-object
                         :mode (get plan :mode)
                         :root root
                         :outDir outDir
                         :manifest (relative outDir (get manifestData :manifest))
                         :digest (get manifestData :digest)
                         :portableEntries normalizedPortableEntries
                         :cache (js-object :enabled useCache :reason (get cacheLookup :reason))
                         :timings
                           (js-object
                             :cacheReadMs cacheReadMs
                             :workMs (Math/max 0 (- (- workFinishedAt startedAt) cacheReadMs))
                             :manifestWriteMs (- manifestFinishedAt workFinishedAt)
                             :totalMs (- manifestFinishedAt startedAt))
                         :modules
                           (js-call modules :map (lambda (mod) (reportModule mod root outDir))))))
                (if (= (js-length entries) 1)
                  (progn
                    (put reportInput :entry (relative root (aref entries 0)))
                    (put reportInput :entryOutput (relative outDir (aref entryOutputs 0))))
                  (progn
                    (put reportInput :entries
                      (js-call entries :map (lambda (entry) (relative root entry))))
                    (put reportInput :entryOutputs
                      (js-call entryOutputs :map (lambda (entryOutput) (relative outDir entryOutput))))))
                (let ((report (js-call compiler :project_build_report reportInput)))
                  (Object/freeze
                    (js-object
                      :format "eliscript-project-build"
                      :version (if (= (js-length entries) 1) 1 2)
                      :root root
                      :outDir outDir
                      :entry (if (= (js-length entries) 1) (aref entries 0) undefined)
                      :entryOutput (if (= (js-length entries) 1) (aref entryOutputs 0) undefined)
                      :entries (Object/freeze entries)
                      :entryOutputs (Object/freeze entryOutputs)
                      :mode (get plan :mode)
                      :portableEntries (Object/freeze normalizedPortableEntries)
                      :macroCapabilities (get request :macroCapabilities)
                      :macroFileDependencies (Object/freeze (get macro :dependencies))
                      :modules
                        (Object/freeze
                          (js-call modules :map (lambda (mod) (Object/freeze mod))))
                      :manifest (get manifestData :manifest)
                      :digest (get manifestData :digest)
                      :report report
                      :plan plan))))))))))

  (export checkProject buildProject))
