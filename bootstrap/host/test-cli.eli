(module bootstrap.host.test-cli
  (import "node:fs" existsSync mkdtempSync readdirSync readFileSync realpathSync rmSync statSync symlinkSync)
  (import "node:os" tmpdir)
  (import "node:path" dirname join relative resolve sep)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./bun.mjs"
    diagnosticFromError renderDiagnostic requestedDiagnosticFormat)
  (import "./project.mjs" buildProject)

  (defconst here (dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst packageRoot (resolve here "../.."))
  (defconst digitsPattern (new globalThis.RegExp "^[0-9]+$" "u"))
  (defconst importPattern (new globalThis.RegExp "\\(import(?:-portable)?\\s+\"([^\"]+)\"" "gu"))
  (defconst dynamicImport (js* "(url) => import(url)"))

  (defconst usage
    (str "Usage: eliscript-test [OPTIONS] [TARGET ...]\n\n"
         "Options:\n"
         "  --filter PATTERN   Run only tests whose names contain PATTERN\n"
         "  --tag TAG          Run only tests matching TAG\n"
         "  --seed NUMBER      Use deterministic seed metadata for test runs\n"
         "  --fail-fast        Stop running tests after the first failure or error\n"
         "  --watch            Re-run tests when matching .eli files change\n"
         "  --root DIR         Set explicit project root for compiling test files\n"
         "  --json             Emit structured JSON test report\n"
         "  -h, --help         Show this help\n"))

  (defun parseArguments (arguments_)
    (let ((argumentsList (Array/from arguments_))
          (targets (js-array))
          (filter undefined)
          (tag undefined)
          (seed undefined)
          (failFast false)
          (watch false)
          (root undefined)
          (json false)
          (helpResult nil))
      (when (= (aref argumentsList 0) "--")
        (js-call argumentsList :shift))
      (while (and (nil? helpResult) (> (js-length argumentsList) 0))
        (let ((argument (js-call argumentsList :shift)))
          (cond
            ((or (= argument "-h") (= argument "--help"))
              (setq helpResult (js-object :help t)))
            ((= argument "--filter")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error "--filter requires a pattern")))
              (setq filter (js-call argumentsList :shift)))
            ((= argument "--tag")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error "--tag requires a tag name")))
              (setq tag (js-call argumentsList :shift)))
            ((= argument "--seed")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error "--seed requires an integer")))
              (let ((text (js-call argumentsList :shift)))
                (unless (js-call digitsPattern :test text)
                  (throw (new globalThis.Error "--seed requires a non-negative integer")))
                (setq seed (globalThis.Number text))))
            ((= argument "--fail-fast")
              (setq failFast t))
            ((= argument "--watch")
              (setq watch t))
            ((= argument "--root")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error "--root requires a directory")))
              (setq root (js-call argumentsList :shift)))
            ((= argument "--json")
              (setq json t))
            ((js-call argument :startsWith "-")
              (throw (new globalThis.Error (str "unknown option: " argument))))
            (t
              (js-call targets :push argument)))))
      (if helpResult
        helpResult
        (js-object
          :targets targets
          :filter filter
          :tag tag
          :seed seed
          :failFast failFast
          :watch watch
          :root root
          :json json))))

  (defun walkTestDirectory (directory files seen)
    (let ((entries (js-call (readdirSync directory (js-object :withFileTypes t))
                     :sort (lambda (a b)
                             (if (< (get a :name) (get b :name))
                               -1
                               (if (> (get a :name) (get b :name)) 1 0)))))
          (i 0))
      (while (< i (js-length entries))
        (let* ((entry (aref entries i))
               (name (get entry :name))
               (full (join directory name)))
          (cond
            ((js-call entry :isDirectory)
              (unless (or (= name "node_modules")
                          (= name "dist")
                          (= name ".git")
                          (js-call name :startsWith ".eliscript-"))
                (walkTestDirectory full files seen)))
            ((and (js-call entry :isFile) (js-call name :endsWith ".test.eli"))
              (let ((canonical (realpathSync full)))
                (unless (js-call seen :has canonical)
                  (js-call seen :add canonical)
                  (js-call files :push canonical))))))
        (setq i (1+ i)))))

  (defun discoverTestFiles (targets &optional root)
    (let ((effective-targets (if (or (nullish? targets) (= (js-length targets) 0))
                               (js-array (if (nullish? root) "tests" root))
                               targets))
          (files (js-array))
          (seen (new globalThis.Set))
          (i 0))
      (while (< i (js-length effective-targets))
        (let* ((raw (aref effective-targets i))
               (resolved (resolve raw))
               (st (statSync resolved)))
          (cond
            ((js-call st :isFile)
              (unless (js-call resolved :endsWith ".eli")
                (throw (new globalThis.Error (str "test target must use .eli extension: " raw))))
              (let ((canonical (realpathSync resolved)))
                (unless (js-call seen :has canonical)
                  (js-call seen :add canonical)
                  (js-call files :push canonical))))
            ((js-call st :isDirectory)
              (walkTestDirectory resolved files seen))
            (t
              (throw (new globalThis.Error (str "unsupported test target: " raw))))))
        (setq i (1+ i)))
      (js-call files :sort)))

  (defun insideDirectory (parent child)
    (let ((rel (relative parent child)))
      (or (= rel "")
          (and (not (= rel ".."))
               (not (js-call rel :startsWith (str ".." sep)))))))

  (defun commonRoot (paths)
    (let ((current (dirname (aref paths 0)))
          (i 1))
      (while (< i (js-length paths))
        (let ((candidate (aref paths i)))
          (while (not (insideDirectory current candidate))
            (let ((parent (dirname current)))
              (when (= parent current)
                (throw (new globalThis.Error "cannot determine common root directory")))
              (setq current parent))))
        (setq i (1+ i)))
      current))

  (defun collectStdlibClosure (sourceFiles)
    (let* ((stdlibDir (realpathSync (resolve packageRoot "stdlib")))
           (visited (new globalThis.Set))
           (queue (js-array
                    (realpathSync (resolve stdlibDir "bit.eli"))
                    (realpathSync (resolve stdlibDir "test.eli"))))
           (result (js-array)))
      (let ((si 0))
        (while (< si (js-length sourceFiles))
          (let* ((sf (aref sourceFiles si))
                 (text (readFileSync sf "utf8"))
                 (dir (dirname sf))
                 (matches (Array/from (js-call text :matchAll (new globalThis.RegExp (get importPattern :source) "gu"))))
                 (mi 0))
            (while (< mi (js-length matches))
              (let ((spec (aref (aref matches mi) 1)))
                (cond
                  ((or (= spec "eliscript/core") (= spec "eliscript/dist/stdlib/core.mjs"))
                    (js-call queue :push (resolve stdlibDir "core.eli")))
                  ((js-call spec :includes "stdlib/")
                    (let* ((idx (js-call spec :indexOf "stdlib/"))
                           (sub (js-call spec :slice (+ idx 7)))
                           (eli-sub (cond
                                      ((js-call sub :endsWith ".mjs") (str (js-call sub :slice 0 -4) ".eli"))
                                      ((js-call sub :endsWith ".eli") sub)
                                      (t (str sub ".eli"))))
                           (candidate (resolve stdlibDir eli-sub)))
                      (when (existsSync candidate)
                        (js-call queue :push (realpathSync candidate)))))
                  ((or (js-call spec :startsWith "./") (js-call spec :startsWith "../"))
                    (let* ((resolved (resolve dir spec))
                           (eli-candidate (cond
                                            ((js-call resolved :endsWith ".mjs") (str (js-call resolved :slice 0 -4) ".eli"))
                                            ((js-call resolved :endsWith ".eli") resolved)
                                            (t nil))))
                      (when (and (not (nil? eli-candidate))
                                 (insideDirectory stdlibDir eli-candidate)
                                 (existsSync eli-candidate))
                        (js-call queue :push (realpathSync eli-candidate)))))))
              (setq mi (1+ mi))))
          (setq si (1+ si))))
      (while (> (js-length queue) 0)
        (let ((next-file (realpathSync (js-call queue :shift))))
          (unless (or (js-call visited :has next-file) (not (insideDirectory stdlibDir next-file)))
            (js-call visited :add next-file)
            (js-call result :push next-file)
            (let* ((text (readFileSync next-file "utf8"))
                   (dir (dirname next-file))
                   (matches (Array/from (js-call text :matchAll (new globalThis.RegExp (get importPattern :source) "gu"))))
                   (mi 0))
              (while (< mi (js-length matches))
                (let ((spec (aref (aref matches mi) 1)))
                  (when (or (js-call spec :startsWith "./") (js-call spec :startsWith "../"))
                    (let* ((resolved (resolve dir spec))
                           (eli-candidate (cond
                                            ((js-call resolved :endsWith ".mjs") (str (js-call resolved :slice 0 -4) ".eli"))
                                            ((js-call resolved :endsWith ".eli") resolved)
                                            (t nil))))
                      (when (and (not (nil? eli-candidate))
                                 (insideDirectory stdlibDir eli-candidate)
                                 (existsSync eli-candidate))
                        (js-call queue :push (realpathSync eli-candidate))))))
                (setq mi (1+ mi)))))))
      (js-call result :sort)))

  (defasync runTestFiles (files &optional options)
    (when (= (js-length files) 0)
      (throw (new globalThis.Error "no matching .test.eli files found")))
    (let* ((opts (if (undefined? options) (js-object) options))
           (hasCustomCompiler (not (nullish? (get opts :compiler))))
           (canonPackageRoot (realpathSync packageRoot))
           (stdlibDir (resolve canonPackageRoot "stdlib"))
           (allUnderPackage (js-call files :every (lambda (f) (insideDirectory canonPackageRoot f))))
           (projectRoot (cond
                          ((not (undefined? (get opts :root))) (realpathSync (resolve (get opts :root))))
                          (allUnderPackage canonPackageRoot)
                          (t (commonRoot files))))
           (tempDir (realpathSync
                      (mkdtempSync
                        (if allUnderPackage
                          (resolve canonPackageRoot ".eliscript-test.")
                          (join (tmpdir) "eliscript-test-runner-")))))
           (stdlibOutDir (resolve tempDir "stdlib"))
           (stdlibEntries (collectStdlibClosure files))
           (baseBuildOpts (if hasCustomCompiler
                            (js-object :compiler (get opts :compiler) :compilerDigest (get opts :compilerDigest) :useCache false)
                            (js-object :moduleDirectory (get opts :moduleDirectory) :useCache false))))
      (try
        (progn
          (await (buildProject
                   (Object/assign (js-object
                                    :entries stdlibEntries
                                    :root stdlibDir
                                    :outDir stdlibOutDir)
                     baseBuildOpts)))
          (await (buildProject
                   (Object/assign (js-object
                                    :entries files
                                    :root projectRoot
                                    :outDir tempDir)
                     baseBuildOpts)))
          (let ((runtimeLink (resolve tempDir "runtime")))
            (unless (existsSync runtimeLink)
              (symlinkSync (resolve canonPackageRoot "runtime") runtimeLink "dir")))
          (let* ((testLibUrl (get (pathToFileURL (resolve stdlibOutDir "test.mjs")) :href))
                 (testLib (await (funcall dynamicImport testLibUrl))))
            (js-call testLib :clear_tests_BANG_)
            (let ((i 0))
              (while (< i (js-length files))
                (let* ((srcFile (aref files i))
                       (rel (relative projectRoot srcFile))
                       (compiledPath (resolve tempDir (str (js-call rel :slice 0 -4) ".mjs"))))
                  (await (funcall dynamicImport (get (pathToFileURL compiledPath) :href))))
                (setq i (1+ i))))
            (let* ((runOpts (js-object
                              :filter (get opts :filter)
                              :tag (get opts :tag)
                              :seed (get opts :seed)
                              :failFast (get opts :failFast)
                              :file (if (= (js-length files) 1) (relative projectRoot (aref files 0)) nil)))
                   (report (await (js-call testLib :run_all_tests runOpts))))
              (js-object :report report :summary (js-call testLib :test_summary report)
                :textReport (js-call testLib :test_report report)))))
        (finally
          (rmSync tempDir (js-object :recursive t :force t))))))

  (defasync runWatchLoop (files parsed actual-options)
    (let ((mtimes (new globalThis.Map))
          (stopped false)
          (stop nil))
      (let ((i 0))
        (while (< i (js-length files))
          (let ((f (aref files i)))
            (js-call mtimes :set f (get (statSync f) :mtimeMs)))
          (setq i (1+ i))))
      (let ((handleSignal (lambda ()
                            (setq stopped t)
                            (when stop (funcall stop)))))
        (js-call globalThis.process :once "SIGINT" handleSignal)
        (js-call globalThis.process :once "SIGTERM" handleSignal)
        (try
          (while (not stopped)
            (let ((out (await (runTestFiles files
                                (js-object
                                  :root (get parsed :root)
                                  :filter (get parsed :filter)
                                  :tag (get parsed :tag)
                                  :seed (get parsed :seed)
                                  :failFast (get parsed :failFast)
                                  :moduleDirectory (get actual-options :moduleDirectory))))))
              (js-call (get globalThis.process :stdout) :write
                (if (get parsed :json)
                  (str (JSON/stringify (get out :report)) "\n")
                  (get out :textReport)))
              (unless (get (get out :report) :passed)
                (put globalThis.process :exitCode 1)))
            (let ((changed false))
              (while (and (not stopped) (not changed))
                (await (new globalThis.Promise (lambda (r) (setq stop r) (globalThis/setTimeout r 300))))
                (let ((j 0))
                  (while (< j (js-length files))
                    (let* ((f (aref files j))
                           (cur (if (existsSync f) (get (statSync f) :mtimeMs) 0)))
                      (when (not (= cur (js-call mtimes :get f)))
                        (js-call mtimes :set f cur)
                        (setq changed t)))
                    (setq j (1+ j)))))))
          (finally
            (js-call globalThis.process :removeListener "SIGINT" handleSignal)
            (js-call globalThis.process :removeListener "SIGTERM" handleSignal))))))

  (defasync execute (arguments_ &rest __opt)
    (let* ((options (aref __opt 0))
           (actual-options (if (undefined? options) (js-object) options))
           (parsed (parseArguments arguments_)))
      (if (get parsed :help)
        (js-object :help t)
        (let ((files (discoverTestFiles (get parsed :targets) (get parsed :root))))
          (if (get parsed :watch)
            (progn
              (await (runWatchLoop files parsed actual-options))
              (js-object :help false :watched t))
            (let ((out (await (runTestFiles files
                                (js-object
                                  :root (get parsed :root)
                                  :filter (get parsed :filter)
                                  :tag (get parsed :tag)
                                  :seed (get parsed :seed)
                                  :failFast (get parsed :failFast)
                                  :compiler (get actual-options :compiler)
                                  :moduleDirectory (get actual-options :moduleDirectory))))))
              (js-object :help false :json (get parsed :json)
                :report (get out :report) :textReport (get out :textReport))))))))

  (defasync main (&rest __opt)
    (let* ((arguments_ (aref __opt 0))
           (actual-args (if (undefined? arguments_)
                          (js-call (get globalThis.process :argv) :slice 2)
                          arguments_))
           (result (await (execute actual-args))))
      (if (get result :help)
        (js-call (get globalThis.process :stdout) :write usage)
        (unless (get result :watched)
          (js-call (get globalThis.process :stdout) :write
            (if (get result :json)
              (str (JSON/stringify (get result :report)) "\n")
              (get result :textReport)))
          (unless (get (get result :report) :passed)
            (put globalThis.process :exitCode 1))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (not (undefined? entry))
               (= (resolve entry) (fileURLToPath (js* "import.meta.url"))))
      (let ((outputFormat (requestedDiagnosticFormat (js-call (get globalThis.process :argv) :slice 2))))
        (js-call (main) :catch
          (lambda (error)
            (let ((diagnostic (diagnosticFromError error)))
              (if (= outputFormat "json")
                (console/error (JSON/stringify diagnostic))
                (console/error (str "eliscript-test: " (renderDiagnostic diagnostic))))
              (put globalThis.process :exitCode 1)))))))

  (export discoverTestFiles execute main parseArguments runTestFiles))
