(module bootstrap.host.project-cli-ground
  (import "node:fs/promises" readFile realpath stat)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath)
  (import "./bun.mjs" diagnosticFromError loadCompiler renderDiagnostic requestedDiagnosticFormat)
  (import "./build.mjs" executeBuild)

  (defconst usage
    "Usage: eliscript-build [OPTIONS] [ENTRY ...]\n\nOptions:\n  --out-dir DIR     Write the generated module tree to DIR\n  --config FILE     Read a versioned project request from FILE\n  --root DIR        Contain local source imports below DIR\n  --portable NAME   Emit NAME and its transitive portable closure\n  --stdin-file FILE Use standard input as the current contents of FILE\n  --no-cache        Disable cache reads for this build\n  --json            Print the versioned build decision report\n  --diagnostic-format human|json\n                     Select human-readable or JSON failures\n  -h, --help         Show this help\n")

  (defconst whitespace-pattern (new globalThis.RegExp "[\\t\\n\\r ]" "u"))
  (defconst delimiter-pattern (new globalThis.RegExp "[\\s,\\]}]" "u"))

  (defun configurationError (message &optional filename)
    (let ((error (new globalThis.Error message))
          (diag (js-object
                  :format "eliscript-diagnostic"
                  :version 1
                  :code "ELI-B0002"
                  :severity "error"
                  :phase "project-config"
                  :message message)))
      (when (and filename (not (undefined? filename)))
        (put diag :location (js-object :file filename)))
      (put error :eliscriptDiagnostic diag)
      (throw error)))

  (defun skipWhitespace (source start)
    (let ((index start))
      (while (and (< index (js-length source))
                  (js-call whitespace-pattern :test (aref source index)))
        (setq index (+ index 1)))
      index))

  (defun scanString (source start)
    (let ((index (+ start 1))
          (done nil))
      (while (and (nil? done) (< index (js-length source)))
        (let ((ch (aref source index)))
          (cond
            ((= ch "\\")
             (setq index (+ index 2)))
            ((= ch "\"")
             (setq done (+ index 1)))
            (t
             (setq index (+ index 1))))))
      (if (nil? done) (js-length source) done)))

  (defun scanValue (source start)
    (let* ((index (skipWhitespace source start))
           (ch (aref source index)))
      (cond
        ((= ch "{")
         (let ((keys (new globalThis.Set))
               (cursor (skipWhitespace source (+ index 1)))
               (done nil))
           (if (= (aref source cursor) "}")
             (+ cursor 1)
             (progn
               (while (and (nil? done) (< cursor (js-length source)))
                 (let* ((keyEnd (scanString source cursor))
                        (key (JSON/parse (js-call source :slice cursor keyEnd))))
                   (when (js-call keys :has key)
                     (configurationError (str "duplicate configuration key: " key)))
                   (js-call keys :add key)
                   (setq cursor (skipWhitespace source keyEnd))
                   (setq cursor (scanValue source (skipWhitespace source (+ cursor 1))))
                   (setq cursor (skipWhitespace source cursor))
                   (if (= (aref source cursor) "}")
                     (setq done (+ cursor 1))
                     (setq cursor (skipWhitespace source (+ cursor 1))))))
               (if (nil? done) cursor done)))))
        ((= ch "[")
         (let ((cursor (skipWhitespace source (+ index 1)))
               (done nil))
           (if (= (aref source cursor) "]")
             (+ cursor 1)
             (progn
               (while (and (nil? done) (< cursor (js-length source)))
                 (setq cursor (scanValue source cursor))
                 (setq cursor (skipWhitespace source cursor))
                 (if (= (aref source cursor) "]")
                   (setq done (+ cursor 1))
                   (setq cursor (skipWhitespace source (+ cursor 1)))))
               (if (nil? done) cursor done)))))
        ((= ch "\"") (scanString source index))
        (t
         (let ((end index))
           (while (and (< end (js-length source))
                       (not (js-call delimiter-pattern :test (aref source end))))
             (setq end (+ end 1)))
           end)))))

  (defun parseConfigurationJson (source &optional filename)
    (let ((value nil))
      (try
        (setq value (JSON/parse source))
        (catch error
          (configurationError (str "invalid JSON: " (get error :message)) filename)))
      (try
        (scanValue source 0)
        (catch error
          (when (and error (get error :eliscriptDiagnostic) filename)
            (put (get error :eliscriptDiagnostic) :location (js-object :file filename)))
          (throw error)))
      value))

  (defun parseArguments (arguments_)
    (let ((argumentsList (Array/from arguments_))
          (portableEntries (js-array))
          (entries (js-array))
          (outDir undefined)
          (root undefined)
          (configuration undefined)
          (stdinFile undefined)
          (useCache t)
          (jsonReport false)
          (diagnosticFormat "human")
          (helpResult nil))
      (when (= (aref argumentsList 0) "--")
        (js-call argumentsList :shift))
      (while (and (nil? helpResult) (> (js-length argumentsList) 0))
        (let ((argument (js-call argumentsList :shift)))
          (cond
            ((or (= argument "-h") (= argument "--help"))
             (setq helpResult (js-object :help t)))
            ((= argument "--out-dir")
             (when (= (js-length argumentsList) 0)
               (throw (new globalThis.Error (str argument " requires a directory"))))
             (setq outDir (js-call argumentsList :shift)))
            ((= argument "--config")
             (when (= (js-length argumentsList) 0)
               (throw (new globalThis.Error (str argument " requires a file"))))
             (unless (undefined? configuration)
               (throw (new globalThis.Error "multiple --config files are not supported")))
             (setq configuration (js-call argumentsList :shift)))
            ((= argument "--root")
             (when (= (js-length argumentsList) 0)
               (throw (new globalThis.Error (str argument " requires a directory"))))
             (setq root (js-call argumentsList :shift)))
            ((= argument "--portable")
             (when (= (js-length argumentsList) 0)
               (throw (new globalThis.Error (str argument " requires an entry name"))))
             (js-call portableEntries :push (js-call argumentsList :shift)))
            ((= argument "--stdin-file")
             (when (= (js-length argumentsList) 0)
               (throw (new globalThis.Error (str argument " requires a file"))))
             (unless (undefined? stdinFile)
               (throw (new globalThis.Error "multiple --stdin-file values are not supported")))
             (setq stdinFile (js-call argumentsList :shift)))
            ((= argument "--no-cache")
             (setq useCache false))
            ((= argument "--json")
             (setq jsonReport t))
            ((= argument "--diagnostic-format")
             (when (= (js-length argumentsList) 0)
               (throw (new globalThis.Error (str argument " requires human or json"))))
             (setq diagnosticFormat (js-call argumentsList :shift))
             (when (and (not (= diagnosticFormat "human"))
                        (not (= diagnosticFormat "json")))
               (throw (new globalThis.Error (str "unsupported diagnostic format: " diagnosticFormat)))))
            ((js-call argument :startsWith "-")
             (throw (new globalThis.Error (str "unknown option: " argument))))
            (t
             (js-call entries :push argument)))))
      (if (not (nil? helpResult))
        helpResult
        (progn
          (when (undefined? configuration)
            (when (= (js-length entries) 0)
              (throw (new globalThis.Error "missing entry file")))
            (when (undefined? outDir)
              (throw (new globalThis.Error "missing --out-dir"))))
          (js-object
            :entry (if (= (js-length entries) 1) (aref entries 0) undefined)
            :entries (if (> (js-length entries) 1) entries undefined)
            :outDir outDir
            :root root
            :portableEntries portableEntries
            :useCache useCache
            :jsonReport jsonReport
            :diagnosticFormat diagnosticFormat
            :configuration configuration
            :stdinFile stdinFile)))))

  (defasync readProjectConfiguration (filename compiler)
    (let ((expanded (resolve filename))
          (canonical nil))
      (try
        (unless (js-call (await (stat expanded)) :isFile)
          (throw (new globalThis.Error "not a file")))
        (setq canonical (await (realpath expanded)))
        (catch _err
          (configurationError "configuration file does not exist" expanded)))
      (let* ((source (await (readFile canonical "utf8")))
             (parsed (parseConfigurationJson source canonical))
             (configuration (js-call compiler :project_configuration parsed canonical))
             (directory (dirname canonical))
             (root (resolve directory (get configuration :sourceRoot)))
             (result
               (js-object
                 :outDir (resolve directory (get configuration :outDir))
                 :root root
                 :portableEntries (Array/from (get configuration :portableEntries))
                 :macroCapabilities (Array/from (get configuration :macroCapabilities))
                 :macroFileDependencies (Array/from (get configuration :macroFileDependencies))
                 :useCache (get configuration :cache)
                 :configuration canonical)))
        (if (= (get configuration :version) 2)
          (put result :entries
            (js-call (get configuration :entries) :map (lambda (entry) (resolve root entry))))
          (put result :entry
            (resolve root (get configuration :entry))))
        result)))

  (defasync execute (arguments_ &rest __opt)
    (let* ((options (aref __opt 0))
           (opts (if (undefined? options) (js-object) options))
           (parsed (parseArguments arguments_)))
      (if (get parsed :help)
        (js-object :help t)
        (let ((request nil)
              (sourceOverrides undefined))
          (if (not (undefined? (get parsed :configuration)))
            (let ((compiler (await (loadCompiler (get opts :moduleDirectory)))))
              (setq request (await (readProjectConfiguration (get parsed :configuration) compiler)))
              (cond
                ((not (undefined? (get parsed :entries)))
                 (put request :entries (get parsed :entries))
                 (Reflect/deleteProperty request "entry"))
                ((not (undefined? (get parsed :entry)))
                 (put request :entry (get parsed :entry))
                 (Reflect/deleteProperty request "entries")))
              (unless (undefined? (get parsed :outDir))
                (put request :outDir (get parsed :outDir)))
              (unless (undefined? (get parsed :root))
                (put request :root (get parsed :root)))
              (when (> (js-length (get parsed :portableEntries)) 0)
                (put request :portableEntries (get parsed :portableEntries)))
              (unless (get parsed :useCache)
                (put request :useCache false)))
            (setq request
              (js-object
                :entry (get parsed :entry)
                :entries (get parsed :entries)
                :outDir (get parsed :outDir)
                :root (get parsed :root)
                :portableEntries (get parsed :portableEntries)
                :macroCapabilities (js-array)
                :macroFileDependencies (js-array)
                :useCache (get parsed :useCache))))
          (unless (undefined? (get parsed :stdinFile))
            (let ((sourceText (if (and (not (nil? (get opts :stdinSource)))
                                       (not (undefined? (get opts :stdinSource))))
                                (get opts :stdinSource)
                                (await (readFile 0 "utf8"))))
                  (overrides (js-object)))
              (put overrides (resolve (get parsed :stdinFile)) sourceText)
              (setq sourceOverrides overrides)))
          (let ((result
                  (await
                    (executeBuild
                      (Object/assign
                        (js-object :mode "project")
                        request
                        (js-object
                          :sourceOverrides sourceOverrides
                          :moduleDirectory (get opts :moduleDirectory)))))))
            (js-object
              :result result
              :jsonReport (get parsed :jsonReport)))))))

  (defasync main (&rest __opt)
    (let* ((arguments_ (aref __opt 0))
           (argv (if (undefined? arguments_)
                   (js-call (get globalThis.process :argv) :slice 2)
                   arguments_))
           (execution (await (execute argv))))
      (if (get execution :help)
        (js-call (get globalThis.process :stdout) :write usage)
        (js-call (get globalThis.process :stdout) :write
          (if (get execution :jsonReport)
            (str (JSON/stringify (get (get execution :result) :report)) "\n")
            (str (js-call (get (get execution :result) :entryOutputs) :join "\n") "\n"))))))

  (defconst isMain
    (and (not (undefined? (aref (get globalThis.process :argv) 1)))
         (= (resolve (aref (get globalThis.process :argv) 1))
            (fileURLToPath (js* "import.meta.url")))))

  (when isMain
    (let ((outputFormat (requestedDiagnosticFormat (js-call (get globalThis.process :argv) :slice 2))))
      (js-call (main) :catch
        (lambda (error)
          (let ((diagnostic (diagnosticFromError error)))
            (if (= outputFormat "json")
              (js-call globalThis.console :error (JSON/stringify diagnostic))
              (js-call globalThis.console :error (str "eliscript-build: " (renderDiagnostic diagnostic))))
            (put globalThis.process :exitCode 1))))))

  (export
    parseConfigurationJson
    parseArguments
    readProjectConfiguration
    execute
    main))
