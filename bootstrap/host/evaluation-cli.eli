(module bootstrap.host.evaluation-cli
  (import "node:readline" createInterface)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./evaluation.mjs" EvaluationSession evaluationResultFormat evaluationResultVersion readEvaluationFile)

  (defconst usage
    "Usage: eliscript-eval [OPTIONS]\n\nOptions:\n  --repl            Run the persistent terminal REPL (default mode)\n  --stdio           Read and write one JSON record per line\n  --eval SOURCE     Evaluate one form\n  --file FILE       Load one complete Eliscript source file\n  --root DIRECTORY  Set the project root for REPL, --eval, or --file\n  --json            Print the one-shot result as JSON\n  --prompt          Always print the REPL banner and prompts\n  --no-prompt       Never print the REPL banner or prompts\n  --help            Show this help\n")

  (defconst replHelp
    "Commands:\n  :help             Show this command summary\n  :load FILE        Load one complete source file\n  :reload           Reload the last successfully loaded file\n  :reset            Discard the current namespace\n  :quit             Close the session\n")

  (defconst replFilename "<repl>.eli")

  (defun host-error-instance? (value)
    (js* "value instanceof globalThis.Error"))

  (defun host-consume-lines (input onLine)
    (js* "(async () => { for await (const line of input) { if (await onLine(line)) break; } })()"))

  (defun cliError (message)
    (let ((error (new globalThis.Error message)))
      (put error :code "ELI-C0001")
      error))

  (defun parseArguments (argv)
    (let* ((options (js-object
                      :json false
                      :mode nil
                      :root nil
                      :source nil
                      :file nil
                      :prompt "auto"))
           (chooseMode (lambda (mode)
                         (unless (nil? (get options :mode))
                           (throw (cliError "choose exactly one evaluation mode")))
                         (put options :mode mode)))
           (choosePrompt (lambda (prompt)
                           (unless (= (get options :prompt) "auto")
                             (throw (cliError "choose at most one prompt mode")))
                           (put options :prompt prompt)))
           (index 0))
      (while (< index (js-length argv))
        (let ((argument (aref argv index)))
          (cond
            ((= argument "--repl")
             (funcall chooseMode "repl"))
            ((= argument "--stdio")
             (funcall chooseMode "stdio"))
            ((= argument "--eval")
             (funcall chooseMode "evaluate")
             (setq index (+ index 1))
             (put options :source (aref argv index))
             (when (undefined? (get options :source))
               (throw (cliError "--eval requires SOURCE"))))
            ((= argument "--file")
             (funcall chooseMode "load")
             (setq index (+ index 1))
             (put options :file (aref argv index))
             (when (undefined? (get options :file))
               (throw (cliError "--file requires FILE"))))
            ((= argument "--root")
             (setq index (+ index 1))
             (put options :root (aref argv index))
             (when (undefined? (get options :root))
               (throw (cliError "--root requires DIRECTORY"))))
            ((= argument "--json")
             (put options :json t))
            ((= argument "--prompt")
             (funcall choosePrompt "always"))
            ((= argument "--no-prompt")
             (funcall choosePrompt "never"))
            ((= argument "--help")
             (funcall chooseMode "help"))
            (t
             (throw (cliError (str "unknown option: " argument)))))
          (setq index (+ index 1))))
      (when (nil? (get options :mode))
        (put options :mode "repl"))
      (when (and (= (get options :mode) "stdio")
                 (or (get options :json)
                     (not (nil? (get options :root)))
                     (not (= (get options :prompt) "auto"))))
        (throw (cliError "--stdio accepts complete request records and no presentation options")))
      (when (and (= (get options :mode) "repl") (get options :json))
        (throw (cliError "--json is available only for one-shot evaluation")))
      (when (and (not (= (get options :mode) "repl"))
                 (not (= (get options :prompt) "auto")))
        (throw (cliError "prompt options are available only in REPL mode")))
      (when (and (= (get options :mode) "help")
                 (or (get options :json)
                     (not (nil? (get options :root)))
                     (not (= (get options :prompt) "auto"))))
        (throw (cliError "--help does not accept evaluation or presentation options")))
      options))

  (defun protocolFailure (message revision)
    (js-object
      :format evaluationResultFormat
      :version evaluationResultVersion
      :id nil
      :operation "unknown"
      :revision revision
      :status "error"
      :diagnostic (js-object
                    :format "eliscript-diagnostic"
                    :version 1
                    :code "ELI-E0001"
                    :severity "error"
                    :phase "evaluation-request"
                    :message message)))

  (defasync runStdio ()
    (let* ((session (await (js-call EvaluationSession :create)))
           (close (lambda () (js-call session :close))))
      (js-call globalThis.process :once "exit" close)
      (js-call globalThis.process :once "SIGINT"
        (lambda ()
          (funcall close)
          (js-call globalThis.process :exit 130)))
      (js-call globalThis.process :once "SIGTERM"
        (lambda ()
          (funcall close)
          (js-call globalThis.process :exit 143)))
      (try
        (let ((input (createInterface
                       (js-object
                         :input (get globalThis.process :stdin)
                         :crlfDelay globalThis.Number.POSITIVE_INFINITY))))
          (await
            (host-consume-lines
              input
              (async (line)
                (unless (= (js-call line :trim) "")
                  (let ((result nil))
                    (try
                      (setq result (await (js-call session :execute (JSON/parse line))))
                      (catch error
                        (setq result
                          (protocolFailure
                            (if (host-error-instance? error)
                              (get error :message)
                              (globalThis.String error))
                            (get session :revision)))))
                    (js-call (get globalThis.process :stdout) :write (str (JSON/stringify result) "\n"))))
                false))))
        (finally
          (js-call globalThis.process :removeListener "exit" close)
          (funcall close)))))

  (defun diagnosticText (diagnostic)
    (let* ((location (if diagnostic (get diagnostic :location) nil))
           (start (if location (get location :start) nil))
           (file (if location (get location :file) nil))
           (line (if (and start (not (nil? (get start :line))) (not (undefined? (get start :line))))
                   (get start :line)
                   (if (and location (not (nil? (get location :line))) (not (undefined? (get location :line))))
                     (get location :line)
                     1)))
           (column (if (and start (not (nil? (get start :column))) (not (undefined? (get start :column))))
                     (get start :column)
                     (if (and location (not (nil? (get location :column))) (not (undefined? (get location :column))))
                       (get location :column)
                       1)))
           (prefix (if file
                     (str file ":" line ":" column ": ")
                     ""))
           (message (if (and diagnostic (get diagnostic :message))
                      (get diagnostic :message)
                      "evaluation failed")))
      (str prefix message)))

  (defun renderHuman (result)
    (when (= (get result :status) "error")
      (throw (cliError (diagnosticText (get result :diagnostic)))))
    (cond
      ((or (= (get result :kind) "expression")
           (= (get result :kind) "definition"))
       (if (get result :hasValue)
         (get result :value)
         (get result :binding)))
      ((= (get result :kind) "module")
       (str "loaded " (js-length (get result :bindings)) " bindings"))
      ((= (get result :kind) "reset")
       "session reset")
      ((= (get result :kind) "capabilities")
       "session ready")
      (t
       (throw (cliError (str "unsupported evaluation result kind: " (get result :kind)))))))

  (defun writeHumanResult (result &rest __opt)
    (let* ((recoverable (aref __opt 0))
           (is-recoverable (if (undefined? recoverable) false recoverable)))
      (when (get result :stdout)
        (js-call (get globalThis.process :stdout) :write (get result :stdout)))
      (try
        (js-call (get globalThis.process :stdout) :write (str (renderHuman result) "\n"))
        t
        (catch error
          (unless is-recoverable
            (throw error))
          (js-call (get globalThis.process :stdout) :write (str "eliscript-eval: " (get error :message) "\n"))
          false))))

  (defun writeRecoverableError (error)
    (let ((message (if (and error (get error :eliscriptDiagnostic))
                     (diagnosticText (get error :eliscriptDiagnostic))
                     (if (host-error-instance? error)
                       (get error :message)
                       (globalThis.String error)))))
      (js-call (get globalThis.process :stdout) :write (str "eliscript-eval: " message "\n"))))

  (defconst repl-command-pattern (new globalThis.RegExp "^:([^\\s]+)(?:\\s+(.*))?$" "u"))

  (defun replCommand (line)
    (let ((match (js-call (js-call line :trim) :match repl-command-pattern)))
      (if match
        (js-object
          :name (aref match 1)
          :argument (let ((arg (aref match 2)))
                      (if arg (js-call arg :trim) "")))
        nil)))

  (defun showPrompt (_input visible continuation)
    (when visible
      (js-call (get globalThis.process :stdout) :write (if continuation "      ... " "eliscript=> "))))

  (defasync runTerminalCommand (command context)
    (let ((session (get context :session))
          (options (get context :options))
          (name (get command :name))
          (argument (get command :argument)))
      (cond
        ((= name "help")
         (unless (= argument "")
           (throw (cliError ":help does not accept arguments")))
         (js-call (get globalThis.process :stdout) :write replHelp)
         false)
        ((= name "load")
         (when (= argument "")
           (throw (cliError ":load requires FILE")))
         (let* ((file (readEvaluationFile argument))
                (next-id (+ (get context :nextId) 1)))
           (put context :nextId next-id)
           (let ((result
                   (await
                     (js-call session :execute
                       (js-object
                         :id next-id
                         :operation "load"
                         :source (get file :source)
                         :filename (get file :filename)
                         :root (get options :root))))))
             (when (writeHumanResult result t)
               (put context :lastFile (get file :filename)))
             false)))
        ((= name "reload")
         (unless (= argument "")
           (throw (cliError ":reload does not accept arguments")))
         (when (nil? (get context :lastFile))
           (throw (cliError ":reload requires a prior successful :load")))
         (let* ((file (readEvaluationFile (get context :lastFile)))
                (next-id (+ (get context :nextId) 1)))
           (put context :nextId next-id)
           (let ((result
                   (await
                     (js-call session :execute
                       (js-object
                         :id next-id
                         :operation "load"
                         :source (get file :source)
                         :filename (get file :filename)
                         :root (get options :root))))))
             (when (writeHumanResult result t)
               (put context :lastFile (get file :filename)))
             false)))
        ((= name "reset")
         (unless (= argument "")
           (throw (cliError ":reset does not accept arguments")))
         (let ((next-id (+ (get context :nextId) 1)))
           (put context :nextId next-id)
           (writeHumanResult
             (await (js-call session :execute (js-object :id next-id :operation "reset")))
             t)
           (put context :lastFile nil)
           false))
        ((= name "quit")
         (unless (= argument "")
           (throw (cliError ":quit does not accept arguments")))
         t)
        (t
         (throw (cliError (str "unknown REPL command: :" name)))))))

  (defasync runRepl (options)
    (let* ((session (await (js-call EvaluationSession :create)))
           (promptVisible
             (globalThis.Boolean
               (or (= (get options :prompt) "always")
                   (and (= (get options :prompt) "auto")
                        (get (get globalThis.process :stdin) :isTTY)
                        (get (get globalThis.process :stdout) :isTTY)))))
           (interface-options
             (js-object
               :input (get globalThis.process :stdin)
               :terminal (and promptVisible (globalThis.Boolean (get (get globalThis.process :stdin) :isTTY)))
               :crlfDelay globalThis.Number.POSITIVE_INFINITY)))
      (when promptVisible
        (put interface-options :output (get globalThis.process :stdout)))
      (let* ((input (createInterface interface-options))
             (context (js-object :session session :options options :nextId 0 :lastFile nil))
             (source "")
             (interrupted false)
             (close (lambda () (js-call session :close)))
             (terminate (lambda ()
                          (funcall close)
                          (js-call globalThis.process :exit 143))))
        (js-call globalThis.process :once "exit" close)
        (js-call globalThis.process :once "SIGTERM" terminate)
        (js-call input :on "SIGINT"
          (lambda ()
            (if (not (= source ""))
              (progn
                (setq source "")
                (js-call (get globalThis.process :stdout) :write "^C\n")
                (showPrompt input promptVisible false))
              (progn
                (setq interrupted t)
                (js-call input :close)))))
        (try
          (when promptVisible
            (js-call (get globalThis.process :stdout) :write "Eliscript REPL. Type :help for commands.\n")
            (showPrompt input t false))
          (await
            (host-consume-lines
              input
              (async (line)
                (let ((should-break false)
                      (handled false))
                  (when (= source "")
                    (let ((command (replCommand line)))
                      (when command
                        (setq handled t)
                        (try
                          (when (await (runTerminalCommand command context))
                            (setq should-break t))
                          (catch error
                            (writeRecoverableError error)))
                        (unless should-break
                          (showPrompt input promptVisible false)))))
                  (when (and (not handled) (not should-break))
                    (setq source (if (= source "") line (str source "\n" line)))
                    (let ((description nil)
                          (desc-error false))
                      (try
                        (setq description
                          (js-call (get session :compiler) :evaluation_input_description source replFilename))
                        (catch error
                          (setq desc-error t)
                          (writeRecoverableError error)
                          (setq source "")
                          (showPrompt input promptVisible false)))
                      (unless desc-error
                        (if (= (get description :status) "incomplete")
                          (showPrompt input promptVisible t)
                          (progn
                            (when (= (get description :status) "complete")
                              (let ((next-id (+ (get context :nextId) 1)))
                                (put context :nextId next-id)
                                (writeHumanResult
                                  (await
                                    (js-call session :execute
                                      (js-object
                                        :id next-id
                                        :operation "evaluate"
                                        :source source
                                        :filename replFilename
                                        :root (get options :root))))
                                  t)))
                            (setq source "")
                            (showPrompt input promptVisible false))))))
                  should-break))))
          (when (and (not interrupted) (not (= source "")))
            (let ((next-id (+ (get context :nextId) 1)))
              (put context :nextId next-id)
              (writeHumanResult
                (await
                  (js-call session :execute
                    (js-object
                      :id next-id
                      :operation "evaluate"
                      :source source
                      :filename replFilename
                      :root (get options :root))))
                t)))
          (finally
            (js-call globalThis.process :removeListener "exit" close)
            (js-call globalThis.process :removeListener "SIGTERM" terminate)
            (js-call input :close)
            (funcall close))))))

  (defasync runOneShot (options)
    (let ((session (await (js-call EvaluationSession :create))))
      (try
        (let* ((request
                 (if (= (get options :mode) "load")
                   (let ((file (readEvaluationFile (get options :file))))
                     (js-object
                       :id 0
                       :operation "load"
                       :source (get file :source)
                       :filename (get file :filename)
                       :root (get options :root)))
                   (js-object
                     :id 0
                     :operation "evaluate"
                     :source (get options :source)
                     :filename "<command-line>.eli"
                     :root (get options :root))))
               (result (await (js-call session :execute request))))
          (if (get options :json)
            (js-call (get globalThis.process :stdout) :write (str (JSON/stringify result) "\n"))
            (writeHumanResult result)))
        (finally
          (js-call session :close)))))

  (defasync main (&rest __opt)
    (let* ((arguments_ (aref __opt 0))
           (argv (if (undefined? arguments_)
                   (js-call (get globalThis.process :argv) :slice 2)
                   arguments_)))
      (try
        (let ((options (parseArguments argv)))
          (cond
            ((= (get options :mode) "help")
             (js-call (get globalThis.process :stdout) :write usage))
            ((= (get options :mode) "stdio")
             (await (runStdio)))
            ((= (get options :mode) "repl")
             (await (runRepl options)))
            (t
             (await (runOneShot options)))))
        (catch error
          (js-call (get globalThis.process :stderr) :write (str "eliscript-eval: " (get error :message) "\n"))
          (put globalThis.process :exitCode 1)))))

  (defconst isMain
    (and (not (undefined? (aref (get globalThis.process :argv) 1)))
         (= (resolve (aref (get globalThis.process :argv) 1))
            (fileURLToPath (js* "import.meta.url")))))

  (when isMain
    (main))

  (export main))
