(module bootstrap.host.bun
  (import "node:fs/promises" lstat mkdir readFile realpath stat writeFile)
  (import "node:fs" existsSync readFileSync)
  (import "node:path" basename dirname relative resolve)
  (import "node:url" fileURLToPath pathToFileURL)

  (defconst host-import (js* "(url) => import(url)"))
  (defun host-typeof (value) (js* "typeof value"))
  (defun error-instance? (value) (js* "value instanceof Error"))

  (defconst commandName
    (let ((env-name (get (get globalThis.process :env) :ELISCRIPT_COMMAND_NAME)))
      (if (nullish? env-name) "eliscript-portable" env-name)))

  (defconst usage
    (str "Usage: " commandName " [OPTIONS] INPUT [ARGS...]\n\n"
         "Options:\n"
         "  -o, --output FILE  Write the generated ECMAScript module to FILE\n"
         "  --source-map       Write FILE.map and add a sourceMappingURL comment\n"
         "  --portable NAME    Emit a worker entry and its transitive dependencies\n"
         "  --diagnostic-format human|json\n"
         "                     Select human-readable or JSON failures\n"
         "  -e, --eval EXPR    Evaluate EXPR in the Eliscript runtime\n"
         "  -l, --load FILE    Load FILE in the Eliscript runtime\n"
         "  -h, --help         Show this help\n"))

  (defconst diagnosticFormat "eliscript-diagnostic")
  (defconst diagnosticVersion 1)

  (defun requestedDiagnosticFormat (arguments_)
    (let ((index 0)
          (limit (1- (js-length arguments_)))
          (result "human"))
      (while (and (= result "human") (< index limit))
        (when (and (= (aref arguments_ index) "--diagnostic-format")
                   (= (aref arguments_ (1+ index)) "json"))
          (setq result "json"))
        (setq index (1+ index)))
      result))

  (defun parseArguments (arguments_)
    (let ((argumentsList (Array/from arguments_))
          (input undefined)
          (output undefined)
          (sourceMap false)
          (diagnosticOutput "human")
          (portableEntries (js-array))
          (helpResult nil))
      (when (= (aref argumentsList 0) "--")
        (js-call argumentsList :shift))
      (while (and (nil? helpResult) (> (js-length argumentsList) 0))
        (let ((argument (js-call argumentsList :shift)))
          (cond
            ((or (= argument "-h") (= argument "--help"))
              (setq helpResult (js-object :help t)))
            ((or (= argument "-o") (= argument "--output"))
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires a file"))))
              (setq output (js-call argumentsList :shift)))
            ((= argument "--source-map")
              (setq sourceMap t))
            ((= argument "--portable")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires a function name"))))
              (js-call portableEntries :push (js-call argumentsList :shift)))
            ((= argument "--diagnostic-format")
              (when (= (js-length argumentsList) 0)
                (throw (new globalThis.Error (str argument " requires human or json"))))
              (setq diagnosticOutput (js-call argumentsList :shift))
              (unless (or (= diagnosticOutput "human") (= diagnosticOutput "json"))
                (throw (new globalThis.Error (str "unsupported diagnostic format: " diagnosticOutput)))))
            ((js-call argument :startsWith "-")
              (throw (new globalThis.Error (str "unknown option: " argument))))
            (input
              (throw (new globalThis.Error "multiple input files are not supported yet")))
            (t
              (setq input argument)))))
      (if helpResult
        helpResult
        (progn
          (unless input
            (throw (new globalThis.Error "missing input file")))
          (when (and sourceMap (not output))
            (throw (new globalThis.Error "--source-map requires --output")))
          (js-object :input input
            :output output
            :sourceMap sourceMap
            :portableEntries portableEntries
            :diagnosticFormat diagnosticOutput)))))

  (defun diagnosticFromError (error)
    (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
      (if (and (not (nullish? diag))
               (= (get diag :format) diagnosticFormat)
               (= (get diag :version) diagnosticVersion))
        diag
        (js-object :format diagnosticFormat
          :version diagnosticVersion
          :code "ELI-C0001"
          :severity "error"
          :phase "cli"
          :message (if (error-instance? error)
                     (get error :message)
                     (funcall globalThis.String error))))))

  (defun renderDiagnostic (diagnostic)
    (let* ((location (if (nullish? diagnostic) undefined (get diagnostic :location)))
           (start (if (nullish? location) undefined (get location :start))))
      (if (and (not (nullish? location))
               (= (host-typeof (get location :file)) "string")
               (not (nullish? start))
               (Number/isSafeInteger (get start :line))
               (Number/isSafeInteger (get start :column)))
        (str (get location :file) ":" (get start :line) ":" (get start :column) ": " (get diagnostic :message))
        (get diagnostic :message))))

  (defasync loadCompiler (&optional moduleDirectory)
    (let* ((hostDirectory (dirname (fileURLToPath (js* "import.meta.url"))))
           (envDir (get (get globalThis.process :env) :ELISCRIPT_BOOTSTRAP_MODULE_DIR))
           (directory (resolve
                        (cond
                          ((not (nullish? moduleDirectory)) moduleDirectory)
                          ((not (nullish? envDir)) envDir)
                          (t (resolve hostDirectory "../../dist/bootstrap"))))))
      (await (funcall host-import (get (pathToFileURL (resolve directory "compiler.mjs")) :href)))))

  (defasync loadLispRuntime ()
    (let* ((hostDirectory (dirname (fileURLToPath (js* "import.meta.url"))))
           (lispPath (resolve hostDirectory "../../dist/runtime/lisp.mjs")))
      (await (funcall host-import (get (pathToFileURL lispPath) :href)))))

  (defconst leading-comments-pattern (new globalThis.RegExp "^(?:\\s|;[^\\n]*\\n)+"))
  (defconst module-head-pattern (new globalThis.RegExp "^\\(\\s*module\\b"))
  (defconst require-eliscript-pattern (new globalThis.RegExp "\\(\\s*require\\s+'eliscript-"))
  (defconst export-or-portable-pattern (new globalThis.RegExp "^\\(\\s*(?:export|defportable)\\b" "m"))

  (defun isCoreIrModule (rawSource inputPath &rest __opt)
    (let* ((request (aref __opt 0))
           (actual-request (if (undefined? request) (js-object) request))
           (portable (get actual-request :portableEntries)))
      (if (and (not (nullish? portable)) (> (js-length portable) 0))
        t
        (if (not (get actual-request :output))
          t
          (let* ((rawText (funcall globalThis.String rawSource))
                 (stripped (js-call rawText :replace leading-comments-pattern "")))
            (cond
              ((js-call module-head-pattern :test stripped) t)
              ((js-call rawText :startsWith "#!") false)
              ((and inputPath (not (js-call (funcall globalThis.String inputPath) :endsWith ".eli"))) false)
              ((and (not (js-call require-eliscript-pattern :test stripped))
                    (js-call export-or-portable-pattern :test stripped))
                t)
              (t false)))))))

  (defconst runtime-flag-pattern
    (new globalThis.RegExp "^-(?:-(?:batch|quick|no-init-file|no-site-file|no-site-lisp|directory|load|script|funcall|eval|execute|version|che-session-worker)(?:=|$)|batch$|scriptload$|[QqlLfeV]$)"))
  (defconst compile-flag-with-value-pattern
    (new globalThis.RegExp "^(?:-o|--output|--portable|--diagnostic-format)$"))
  (defconst compile-flag-bool-pattern
    (new globalThis.RegExp "^--source-map$"))

  (defun isCompileInvocation (arguments_)
    (if (= (get (get globalThis.process :env) :ELISCRIPT_COMMAND_NAME) "eliscript-portable")
      t
      (let ((list (Array/from arguments_)))
        (cond
          ((= (js-length list) 0) t)
          ((and (= (js-length list) 1) (= (aref list 0) "--")) t)
          ((and (= (js-length list) 1) (or (= (aref list 0) "-h") (= (aref list 0) "--help"))) t)
          (t
            (let ((index 0)
                  (earlyResult nil)
                  (hasEarly false))
              (when (= (aref list 0) "--")
                (if (and (> (js-length list) 1)
                         (or (js-call compile-flag-with-value-pattern :test (aref list 1))
                             (js-call compile-flag-bool-pattern :test (aref list 1))
                             (= (aref list 1) "-h")
                             (= (aref list 1) "--help")))
                  (setq index 1)
                  (setq earlyResult false hasEarly t)))
              (if hasEarly
                earlyResult
                (let ((sawCompileFlag false)
                      (firstInput undefined)
                      (stopped false))
                  (while (and (not hasEarly) (not stopped) (< index (js-length list)))
                    (let ((arg (aref list index)))
                      (cond
                        ((= arg "--")
                          (setq stopped t))
                        ((js-call compile-flag-with-value-pattern :test arg)
                          (if (and (not (undefined? firstInput))
                                   (= arg "-o")
                                   (not (js-call (funcall globalThis.String firstInput) :endsWith ".eli")))
                            (setq index (1+ index))
                            (setq sawCompileFlag t index (+ index 2))))
                        ((js-call compile-flag-bool-pattern :test arg)
                          (setq sawCompileFlag t index (1+ index)))
                        ((not (undefined? firstInput))
                          (setq index (1+ index)))
                        ((js-call runtime-flag-pattern :test arg)
                          (setq earlyResult false hasEarly t))
                        ((js-call arg :startsWith "-")
                          (setq earlyResult t hasEarly t))
                        (t
                          (setq firstInput arg index (1+ index))))))
                  (cond
                    (hasEarly earlyResult)
                    (sawCompileFlag t)
                    ((not (undefined? firstInput))
                      (let ((candidate (resolve firstInput)))
                        (if (existsSync candidate)
                          (try
                            (let ((raw (readFileSync candidate "utf8")))
                              (isCoreIrModule raw candidate (js-object :output "check")))
                            (catch err t))
                          false)))
                    (t t))))))))))

  (defasync physicalWritePath (path)
    (let ((existing (resolve path))
          (missing (js-array))
          (resolved nil))
      (while (nil? resolved)
        (try
          (let ((metadata (await (lstat existing))))
            (if (js-call metadata :isSymbolicLink)
              (try
                (let ((target (await (realpath existing))))
                  (setq resolved
                    (Reflect/apply resolve undefined
                      (js-call (js-array target) :concat (js-call (Array/from missing) :reverse)))))
                (catch error
                  (let ((code (if (nullish? error) undefined (get error :code))))
                    (when (or (= code "ENOENT") (= code "ENOTDIR"))
                      (throw (new globalThis.Error
                               (str "generated artifact path contains an unresolved symbolic link: " path))))
                    (throw error))))
              (let ((target (await (realpath existing))))
                (setq resolved
                  (Reflect/apply resolve undefined
                    (js-call (js-array target) :concat (js-call (Array/from missing) :reverse)))))))
          (catch error
            (let ((code (if (nullish? error) undefined (get error :code))))
              (when (and (not (= code "ENOENT")) (not (= code "ENOTDIR")))
                (throw error))
              (let ((parent (dirname existing)))
                (when (= parent existing) (throw error))
                (js-call missing :push (basename existing))
                (setq existing parent))))))
      resolved))

  (defasync existingFileIdentity (path)
    (try
      (let ((metadata (await (stat path))))
        (str (get metadata :dev) ":" (get metadata :ino)))
      (catch error
        (let ((code (if (nullish? error) undefined (get error :code))))
          (if (or (= code "ENOENT") (= code "ENOTDIR"))
            undefined
            (throw error))))))

  (defasync validateFileOutputPaths (inputPath outputPaths)
    (let ((inputPhysical (await (realpath inputPath)))
          (inputIdentity (await (existingFileIdentity inputPath)))
          (artifacts (js-array))
          (index 0))
      (while (< index (js-length outputPaths))
        (let* ((outputPath (aref outputPaths index))
               (physical (await (physicalWritePath outputPath)))
               (identity (await (existingFileIdentity outputPath))))
          (when (or (= physical inputPhysical)
                    (and (not (undefined? identity)) (= identity inputIdentity)))
            (throw (new globalThis.Error (str "generated artifact must not overwrite input file: " outputPath))))
          (let ((artIndex 0))
            (while (< artIndex (js-length artifacts))
              (let ((artifact (aref artifacts artIndex)))
                (when (or (= physical (get artifact :physical))
                          (and (not (undefined? identity)) (= identity (get artifact :identity))))
                  (throw (new globalThis.Error
                           (str "generated artifacts must be physically distinct: "
                                (get artifact :path) " and " outputPath)))))
              (setq artIndex (1+ artIndex))))
          (js-call artifacts :push
            (js-object :path outputPath :physical physical :identity identity)))
        (setq index (1+ index)))))

  (defconst extension-strip-pattern (new globalThis.RegExp "\\.[^.]+$"))
  (defconst sanitize-ident-pattern (new globalThis.RegExp "[^A-Za-z0-9-]" "g"))
  (defconst backslash-pattern (new globalThis.RegExp "\\\\" "g"))
  (defconst runtime-import-pattern (new globalThis.RegExp "\"eliscript\\/runtime\\/([^\"\\n]+\\.mjs)\"" "g"))

  (defasync compileFile (options)
    (let* ((compiler (if (nullish? (get options :compiler))
                       (await (loadCompiler (get options :moduleDirectory)))
                       (get options :compiler)))
           (request (js-call compiler :build_operation_request
                      (js-object :mode "single"
                        :input (get options :input)
                        :output (if (nullish? (get options :output)) nil (get options :output))
                        :sourceMap (if (undefined? (get options :sourceMap)) false (get options :sourceMap))
                        :portableEntries (if (nullish? (get options :portableEntries))
                                           (js-array)
                                           (get options :portableEntries)))))
           (inputPath (resolve (get request :input)))
           (outputPath (if (get request :output) (resolve (get request :output)) undefined)))
      (when outputPath
        (await (validateFileOutputPaths inputPath
                 (if (get request :sourceMap)
                   (js-array outputPath (str outputPath ".map"))
                   (js-array outputPath)))))
      (let ((rawSource (await (readFile inputPath "utf8")))
            (source nil)
            (rewriteRuntimeSpec undefined))
        (setq source rawSource)
        (unless (isCoreIrModule rawSource inputPath request)
          (let* ((hostDirectory (dirname (fileURLToPath (js* "import.meta.url"))))
                 (lispPath (resolve hostDirectory "../../dist/runtime/lisp.mjs"))
                 (distRuntimeDir (resolve hostDirectory "../../dist/runtime"))
                 (srcRuntimeDir (resolve hostDirectory "../../runtime"))
                 (outputDirPhysical (if outputPath (await (physicalWritePath (dirname outputPath))) undefined))
                 (lispMod (await (loadLispRuntime)))
                 (strippedBase (js-call (js-call (basename inputPath) :replace extension-strip-pattern "")
                                 :replace sanitize-ident-pattern "-"))
                 (baseName (if (= strippedBase "") "program" strippedBase))
                 (modName (str "eliscript.generated." baseName))
                 (runtimeSpec (if outputDirPhysical
                                (let ((rel (js-call (relative outputDirPhysical lispPath) :replace backslash-pattern "/")))
                                  (if (js-call rel :startsWith ".") rel (str "./" rel)))
                                "eliscript/runtime/lisp")))
            (when outputDirPhysical
              (setq rewriteRuntimeSpec
                (lambda (subpath)
                  (let* ((distTarget (resolve distRuntimeDir subpath))
                         (target (if (existsSync distTarget) distTarget (resolve srcRuntimeDir subpath)))
                         (rel (js-call (relative outputDirPhysical target) :replace backslash-pattern "/")))
                    (if (js-call rel :startsWith ".") rel (str "./" rel))))))
            (setq source
              (js-call lispMod :compileModule rawSource
                (js-object :moduleName modName
                  :runtime runtimeSpec
                  :sourceFile inputPath
                  :autorun t)))))
        (let ((rewriteRuntimeImports
                (lambda (js)
                  (if rewriteRuntimeSpec
                    (js-call js :replace runtime-import-pattern
                      (lambda (_match subpath)
                        (JSON/stringify (funcall rewriteRuntimeSpec subpath))))
                    js))))
          (if (not (get request :sourceMap))
            (let* ((rawJavascript (if (> (js-length (get request :portableEntries)) 0)
                                    (js-call compiler :compile_portable_string
                                      source (get request :portableEntries) inputPath)
                                    (js-call compiler :compile_string source inputPath)))
                   (javascript (funcall rewriteRuntimeImports rawJavascript)))
              (when outputPath
                (await (mkdir (dirname outputPath) (js-object :recursive t)))
                (await (writeFile outputPath javascript)))
              (js-object :javascript javascript))
            (progn
              (unless outputPath
                (throw (new globalThis.Error "--source-map requires --output")))
              (let* ((mapPath (str outputPath ".map"))
                     (mapDirectory (dirname mapPath))
                     (generatedName (relative mapDirectory outputPath))
                     (sourceName (relative mapDirectory inputPath))
                     (emission (if (> (js-length (get request :portableEntries)) 0)
                                 (js-call compiler :compile_portable_string_with_source_map
                                   source (get request :portableEntries) inputPath generatedName sourceName)
                                 (js-call compiler :compile_string_with_source_map
                                   source inputPath generatedName sourceName)))
                     (mapUrl (relative (dirname outputPath) mapPath))
                     (javascript (funcall rewriteRuntimeImports
                                   (str (get emission :javascript) "//# sourceMappingURL=" mapUrl "\n"))))
                (await (mkdir mapDirectory (js-object :recursive t)))
                (await (writeFile mapPath (get emission :sourceMap)))
                (await (mkdir (dirname outputPath) (js-object :recursive t)))
                (await (writeFile outputPath javascript))
                (js-object :javascript javascript :sourceMap (get emission :sourceMap)))))))))

  (defasync main (&rest __opt)
    (let* ((arguments_ (aref __opt 0))
           (actual-args (if (undefined? arguments_)
                          (js-call (get globalThis.process :argv) :slice 2)
                          arguments_)))
      (if (not (isCompileInvocation actual-args))
        (let ((lispMod (await (loadLispRuntime))))
          (js-call lispMod :runBatchCli actual-args))
        (let ((options (parseArguments actual-args)))
          (if (get options :help)
            (js-call (get globalThis.process :stdout) :write usage)
            (let* ((buildMod (await (funcall host-import "./build.mjs")))
                   (result (await (js-call buildMod :executeBuild
                                    (Object/assign (js-object :mode "single") options)))))
              (unless (get options :output)
                (js-call (get globalThis.process :stdout) :write (get result :javascript)))))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (not (undefined? entry))
               (= (resolve entry) (fileURLToPath (js* "import.meta.url"))))
      (let ((outputFormat (requestedDiagnosticFormat (js-call (get globalThis.process :argv) :slice 2))))
        (js-call (main) :catch
          (lambda (error)
            (if (= outputFormat "json")
              (console/error (JSON/stringify (diagnosticFromError error)))
              (console/error (str "eliscript: " (get error :message))))
            (put globalThis.process :exitCode 1))))))

  (export compileFile diagnosticFromError loadCompiler main parseArguments
    renderDiagnostic requestedDiagnosticFormat))
