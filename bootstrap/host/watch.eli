(module bootstrap.host.watch
  (import "node:crypto" createHash)
  (import "node:fs/promises" readdir readFile realpath stat)
  (import "node:path" isAbsolute join relative resolve sep)

  (defconst watchEventFormat "eliscript-watch-event")
  (defconst watchEventVersion 1)
  (defconst defaultWatchInterval 250)
  (defconst minimumWatchInterval 25)
  (defconst maximumWatchInterval 60000)

  (defun host-typeof (value)
    (js* "typeof value"))

  (defun host-error-instance? (value)
    (js* "value instanceof globalThis.Error"))

  (defun freeze (value)
    (Object/freeze value))

  (defun watchError (message &optional filename)
    (let ((error (new globalThis.Error message))
          (diag (js-object
                  :format "eliscript-diagnostic"
                  :version 1
                  :code "ELI-W0001"
                  :severity "error"
                  :phase "project-watch"
                  :message message)))
      (when (and filename (not (undefined? filename)))
        (put diag :location (js-object :file filename)))
      (put error :eliscriptDiagnostic diag)
      error))

  (defun containedPath (file root)
    (let ((fromRoot (relative root file)))
      (or (= fromRoot "")
          (and (not (= fromRoot ".."))
               (not (js-call fromRoot :startsWith (str ".." sep)))
               (not (isAbsolute fromRoot))))))

  (defun digestBytes (value)
    (js-call (js-call (createHash "sha256") :update value) :digest "hex"))

  (defun snapshotDigest (files)
    (let ((hash (createHash "sha256"))
          (sorted (js-call (Array/from files) :sort
                    (lambda (left right)
                      (js-call (aref left 0) :localeCompare (aref right 0)))))
          (idx 0))
      (while (< idx (js-length sorted))
        (let ((pair (aref sorted idx)))
          (js-call hash :update (aref pair 0))
          (js-call hash :update "\0")
          (js-call hash :update (aref pair 1))
          (js-call hash :update "\0"))
        (setq idx (+ idx 1)))
      (js-call hash :digest "hex")))

  (defasync canonicalDirectory (directory)
    (let ((expanded (resolve directory)))
      (try
        (unless (js-call (await (stat expanded)) :isDirectory)
          (throw (watchError "watch root is not a directory" expanded)))
        (await (realpath expanded))
        (catch error
          (when (and error (get error :eliscriptDiagnostic))
            (throw error))
          (throw (watchError "watch root does not exist" expanded))))))

  (defasync canonicalConfiguration (filename)
    (if (or (nil? filename) (undefined? filename))
      nil
      (let ((expanded (resolve filename)))
        (try
          (unless (js-call (await (stat expanded)) :isFile)
            (throw (watchError "watch configuration is not a file" expanded)))
          (await (realpath expanded))
          (catch error
            (when (and error (get error :eliscriptDiagnostic))
              (throw error))
            (throw (watchError "watch configuration does not exist" expanded)))))))

  (defun watchInterval (value)
    (let ((interval (if (or (nil? value) (undefined? value))
                      defaultWatchInterval
                      value)))
      (when (or (not (Number/isSafeInteger interval))
                (< interval minimumWatchInterval)
                (> interval maximumWatchInterval))
        (throw (watchError
                 (str "watch interval must be an integer between "
                      minimumWatchInterval
                      " and "
                      maximumWatchInterval
                      " milliseconds"))))
      interval))

  (defasync readDigest (filename)
    (try
      (digestBytes (await (readFile filename)))
      (catch error
        (let ((code (if error (get error :code) nil)))
          (if (or (= code "ENOENT") (= code "ENOTDIR"))
            nil
            (throw error))))))

  (defasync collectSources (directory files)
    (let ((entries nil))
      (try
        (setq entries (await (readdir directory (js-object :withFileTypes t))))
        (catch error
          (let ((code (if error (get error :code) nil)))
            (unless (or (= code "ENOENT") (= code "ENOTDIR"))
              (throw error)))))
      (when entries
        (js-call entries :sort
          (lambda (left right)
            (js-call (get left :name) :localeCompare (get right :name))))
        (let ((idx 0))
          (while (< idx (js-length entries))
            (let ((entry (aref entries idx)))
              (unless (js-call entry :isSymbolicLink)
                (let ((filename (join directory (get entry :name))))
                  (cond
                    ((js-call entry :isDirectory)
                     (await (collectSources filename files)))
                    ((and (js-call entry :isFile)
                          (js-call (get entry :name) :endsWith ".eli"))
                     (let ((digest (await (readDigest filename))))
                       (unless (nil? digest)
                         (js-call files :set filename digest))))))))
            (setq idx (+ idx 1)))))))

  (defasync projectSnapshot (root configuration)
    (let ((files (new globalThis.Map)))
      (await (collectSources root files))
      (when (and (not (nil? configuration))
                 (not (js-call files :has configuration)))
        (let ((digest (await (readDigest configuration))))
          (unless (nil? digest)
            (js-call files :set configuration digest))))
      (freeze (js-object :files files :digest (snapshotDigest files)))))

  (defun changesBetween (previous current root)
    (let* ((prev-keys (Array/from (js-call (get previous :files) :keys)))
           (curr-keys (Array/from (js-call (get current :files) :keys)))
           (all-files (js-call (Array/from (new globalThis.Set (js-call prev-keys :concat curr-keys))) :sort)))
      (js-call all-files :flatMap
        (lambda (file)
          (let ((before (js-call (get previous :files) :get file))
                (after (js-call (get current :files) :get file)))
            (if (= before after)
              (js-array)
              (let* ((kind (cond
                             ((undefined? before) "create")
                             ((undefined? after) "delete")
                             (t "modify")))
                     (record (js-object :file file :kind kind)))
                (when (containedPath file root)
                  (put record :path (relative root file)))
                (js-array (freeze record)))))))))

  (defun eventRecord (sequence event root &rest __opt)
    (let* ((fields (aref __opt 0))
           (extra (if (undefined? fields) (js-object) fields)))
      (freeze
        (Object/assign
          (js-object
            :format watchEventFormat
            :version watchEventVersion
            :sequence sequence
            :event event
            :root root)
          extra))))

  (defasync watcherCreate (WatcherClass &rest __opt)
    (let* ((options (aref __opt 0))
           (opts (if (undefined? options) (js-object) options)))
      (when (or (not opts) (not (= (host-typeof opts) "object")))
        (throw (watchError "watch options must be an object")))
      (when (or (not (= (host-typeof (get opts :root)) "string"))
                (= (js-length (get opts :root)) 0))
        (throw (watchError "watch root must be a non-empty string")))
      (let* ((root (await (canonicalDirectory (get opts :root))))
             (configuration (await (canonicalConfiguration (get opts :configuration))))
             (interval (watchInterval (get opts :interval)))
             (snapshot (await (projectSnapshot root configuration))))
        (new WatcherClass root configuration interval snapshot))))

  (defun watcherReady (watcher)
    (eventRecord 0 "ready" (get watcher :root)
      (js-object
        :changes (freeze (js-array))
        :digest (get (get watcher :snapshot) :digest))))

  (defasync watcherScan (watcher)
    (when (get watcher :closed)
      (throw (watchError "watch session is closed" (get watcher :root))))
    (let* ((next (await (projectSnapshot (get watcher :root) (get watcher :configuration))))
           (changes (changesBetween (get watcher :snapshot) next (get watcher :root))))
      (put watcher :snapshot next)
      (if (= (js-length changes) 0)
        nil
        (progn
          (put watcher :sequence (+ (get watcher :sequence) 1))
          (eventRecord (get watcher :sequence) "change" (get watcher :root)
            (js-object
              :changes (freeze changes)
              :digest (get next :digest)))))))

  (defun watcherError (watcher error)
    (put watcher :sequence (+ (get watcher :sequence) 1))
    (let ((diagnostic
            (if (and error (get error :eliscriptDiagnostic))
              (get error :eliscriptDiagnostic)
              (js-object
                :format "eliscript-diagnostic"
                :version 1
                :code "ELI-W0002"
                :severity "error"
                :phase "project-watch"
                :message (if (host-error-instance? error)
                           (get error :message)
                           (globalThis.String error))
                :location (js-object :file (get watcher :root))))))
      (eventRecord (get watcher :sequence) "error" (get watcher :root)
        (js-object :diagnostic (freeze diagnostic)))))

  (defun watcherStart (watcher onEvent)
    (unless (= (host-typeof onEvent) "function")
      (throw (watchError "watch event handler must be a function")))
    (when (get watcher :closed)
      (throw (watchError "watch session is closed" (get watcher :root))))
    (if (not (nil? (get watcher :timer)))
      watcher
      (progn
        (put watcher :timer
          (globalThis.setInterval
            (async ()
              (unless (or (get watcher :scanning) (get watcher :closed))
                (put watcher :scanning t)
                (put watcher :scanPromise (js-call watcher :scan))
                (try
                  (let ((event (await (get watcher :scanPromise))))
                    (when (and (not (get watcher :closed)) (not (nil? event)))
                      (funcall onEvent event)))
                  (catch error
                    (unless (get watcher :closed)
                      (funcall onEvent (js-call watcher :error error))))
                  (finally
                    (put watcher :scanning false)
                    (put watcher :scanPromise nil)))))
            (get watcher :interval)))
        (funcall onEvent (js-call watcher :ready))
        watcher)))

  (defasync watcherClose (watcher)
    (unless (nil? (get watcher :timer))
      (globalThis.clearInterval (get watcher :timer)))
    (put watcher :timer nil)
    (put watcher :closed t)
    (unless (nil? (get watcher :scanPromise))
      (try
        (await (get watcher :scanPromise))
        (catch _err
          nil))))

  (defun watcherInitialize (self root configuration interval snapshot)
    (put self :root root)
    (put self :configuration configuration)
    (put self :interval interval)
    (put self :snapshot snapshot)
    (put self :sequence 0)
    (put self :timer nil)
    (put self :scanning false)
    (put self :scanPromise nil)
    (put self :closed false))

  (defconst ProjectWatcher
    (js* "class ProjectWatcher {
      static create(options = {}) { return watcherCreate(ProjectWatcher, options); }
      constructor(root, configuration, interval, snapshot) { watcherInitialize(this, root, configuration, interval, snapshot); }
      ready() { return watcherReady(this); }
      scan() { return watcherScan(this); }
      error(error) { return watcherError(this, error); }
      start(onEvent) { return watcherStart(this, onEvent); }
      close() { return watcherClose(this); }
    }"))

  (defasync snapshotProject (options)
    (let ((watcher (await (js-call ProjectWatcher :create options))))
      (try
        (js-call watcher :ready)
        (finally
          (await (js-call watcher :close))))))

  (export
    watchEventFormat
    watchEventVersion
    defaultWatchInterval
    minimumWatchInterval
    maximumWatchInterval
    ProjectWatcher
    snapshotProject))
