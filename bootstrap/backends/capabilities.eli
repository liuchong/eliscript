(module eliscript.backend.capabilities
  (import "./numeric.mjs" backend-fail)

  ;; A capability is declared only when a typed operation actually needs it.
  ;; Scalar and pure managed programs keep the original import-free ABI.
  (defun host-capability-definition (name node)
    (cond
      ((or (= name "console-log") (= name "console-log-capture") (= name "source-operation"))
       (js-object :name name :module "eliscript.host" :arity 2 :abi "managed-host-call-v1"))
      (t (backend-fail node (str "unknown host capability: " name)))))

  (defun collect-host-capabilities (node names &optional completed)
    (unless (and completed (js-call completed :has node))
    (when (= (get node :kind) "host-call")
      (let ((name (get node :value)) (children (get node :children)))
        (host-capability-definition name node)
        (unless (and (= (get node :type) "u32") (Array/isArray children) (= (js-length children) 2))
          (backend-fail node "host calls require exactly heap and argument-list word operands"))
        (let ((index 0))
          (while (< index 2)
            (unless (or (= (get (js-nth index children) :type) "u32")
                        (= (get (js-nth index children) :type) "i32"))
              (backend-fail node "host call operands must be memory32 words"))
            (setq index (1+ index))))
        (unless (js-call names :includes name) (js-call names :push name))))
    (let ((children (get node :children)) (index 0))
      (unless (Array/isArray children) (backend-fail node "typed capability scan requires a children array"))
      (while (< index (js-length children))
        (collect-host-capabilities (js-nth index children) names completed)
        (setq index (1+ index))))
      ;; Only the source-lowering handoff supplies a memo. A completed subtree
      ;; has already declared its capabilities in their first DFS order.
      (when completed (js-call completed :set node t))))

  (defun prepare-host-capabilities-core (program fresh)
    (let ((names (js-array)) (functions (get program :functions)) (index 0) (result (js-array)))
      (unless (Array/isArray functions) (backend-fail program "typed capability scan requires declared functions"))
      (while (< index (js-length functions))
        (collect-host-capabilities (get (js-nth index functions) :body) names
          (when fresh (new globalThis.WeakMap)))
        (setq index (1+ index)))
      (when (and (> (js-length names) 0) (/= (get program :abi) "memory-u32"))
        (backend-fail program "host capabilities require memory-u32 input"))
      (setq index 0)
      (while (< index (js-length names))
        (js-call result :push (host-capability-definition (js-nth index names) program))
        (setq index (1+ index)))
      (let ((declared (get program :hostCapabilities nil)))
        (unless (nil? declared)
          (unless (and (Array/isArray declared) (= (js-length declared) (js-length result)))
            (backend-fail program "host capability declarations differ from actual typed calls"))
          (setq index 0)
          (while (< index (js-length result))
            (let ((expected (js-nth index result)) (actual (js-nth index declared)))
              (unless (and (= (get actual :name) (get expected :name))
                           (= (get actual :module) (get expected :module))
                           (= (get actual :arity) 2) (= (get actual :abi) "managed-host-call-v1"))
                (backend-fail program "invalid host capability declaration")))
            (setq index (1+ index)))))
      result))

  (defun prepare-host-capabilities (program)
    (prepare-host-capabilities-core program nil))
  (defun prepare-fresh-host-capabilities (program)
    (prepare-host-capabilities-core program t))

  (defun host-capability-index (capabilities node)
    (let ((index 0) (name (get node :value)))
      (while (and (< index (js-length capabilities)) (/= name (get (js-nth index capabilities) :name)))
        (setq index (1+ index)))
      (when (= index (js-length capabilities)) (backend-fail node "host capability was not declared"))
      index))

  (export prepare-host-capabilities host-capability-index prepare-fresh-host-capabilities))
