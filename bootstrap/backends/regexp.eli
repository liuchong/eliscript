(module eliscript.backend.regexp
  (import "./numeric.mjs" backend-fail)
  ;; Compile RegExp syntax into private word instructions; never call host RegExp.
  (defun regexp-fail (state message)
    (try (backend-fail (get state :node) message)
      (catch error (put (get error :eliscriptDiagnostic) :phase "regexp-backend") (throw error))))
  (defun regexp-peek (state)
    (if (< (get state :at) (js-length (get state :source)))
      (string-code-unit-at (get state :source) (get state :at)) -1))
  (defun regexp-take (state)
    (let ((code (regexp-peek state))) (when (>= code 0) (put state :at (1+ (get state :at)))) code))
  (defun regexp-hex (code)
    (cond ((and (>= code 48) (<= code 57)) (- code 48))
      ((and (>= code 65) (<= code 70)) (- code 55))
      ((and (>= code 97) (<= code 102)) (- code 87)) (t -1)))
  (defun regexp-hex-value (state count)
    (let ((start (get state :at)) (value 0) (index 0) (valid t))
      (while (and (< index count) valid)
        (let ((digit (regexp-hex (regexp-peek state))))
          (if (< digit 0) (setq valid false)
            (progn (regexp-take state) (setq value (+ (* value 16) digit))))) (setq index (1+ index)))
      (if valid value (progn (put state :at start) -1))))
  (defun regexp-ranges (state code)
    (let* ((lower (if (and (>= code 65) (<= code 90)) (+ code 32) code))
           (ranges (cond ((= lower 100) (js-array (js-array 48 57)))
             ((= lower 119) (js-array (js-array 48 57) (js-array 65 90) (js-array 95 95) (js-array 97 122)))
             (t (js-array (js-array 9 13) (js-array 32 32) (js-array 160 160) (js-array 5760 5760)
                  (js-array 8192 8202) (js-array 8232 8233) (js-array 8239 8239) (js-array 8287 8287)
                  (js-array 12288 12288) (js-array 65279 65279)))))
           (output (js-array)) (cursor 0) (index 0) (end (if (get state :unicode) 1114111 65535)))
      (if (= lower code) ranges
        (progn
          (while (< index (js-length ranges))
            (let* ((range (js-nth index ranges)) (low (js-nth 0 range)) (high (js-nth 1 range)))
              (when (< cursor low) (js-call output :push (js-array cursor (1- low))))
              (setq cursor (1+ high))) (setq index (1+ index)))
          (when (<= cursor end) (js-call output :push (js-array cursor end))) output))))
  (defun regexp-escape (state in-class)
    (let ((code (regexp-take state)))
      (when (< code 0) (regexp-fail state "unterminated RegExp escape"))
      (cond
        ((or (= code 100) (= code 68) (= code 119) (= code 87) (= code 115) (= code 83))
         (js-object :kind "class" :ranges (regexp-ranges state code) :negative false))
        ((and (not in-class) (or (= code 98) (= code 66))) (js-object :kind "boundary" :value (= code 98)))
        ((and (>= code 49) (<= code 57)) (regexp-fail state "RegExp backreferences are not implemented"))
        ((= code 48)
         (when (and (>= (regexp-peek state) 48) (<= (regexp-peek state) 57)) (regexp-fail state "legacy octal RegExp escapes are not implemented"))
         (js-object :kind "char" :value 0))
        ((or (= code 120) (= code 117))
         (let ((value -1))
           (if (and (= code 117) (get state :unicode) (= (regexp-peek state) 123))
             (let ((digits 0))
               (regexp-take state) (setq value 0)
               (while (>= (regexp-hex (regexp-peek state)) 0)
                 (setq value (+ (* value 16) (regexp-hex (regexp-take state)))) (setq digits (1+ digits))
                 (when (> value 1114111) (regexp-fail state "RegExp code point exceeds Unicode range")))
               (unless (and (> digits 0) (= (regexp-take state) 125)) (regexp-fail state "invalid RegExp code-point escape")))
             (setq value (regexp-hex-value state (if (= code 120) 2 4))))
           (when (< value 0)
             (if (get state :unicode) (regexp-fail state "invalid Unicode RegExp escape") (setq value code)))
           (js-object :kind "char" :value value)))
        ((= code 99)
         (let ((letter (regexp-take state)))
           (unless (or (and (>= letter 65) (<= letter 90)) (and (>= letter 97) (<= letter 122)))
             (regexp-fail state "unsupported RegExp control escape"))
           (js-object :kind "char" :value (bit-and letter 31))))
        (t
         (let ((value (cond ((= code 110) 10) ((= code 114) 13) ((= code 116) 9)
                           ((= code 118) 11) ((= code 102) 12) ((and in-class (= code 98)) 8) (t code))))
           (when (and (get state :unicode) (= value code)
                      (not (js-call "^$\\.*+?()[]{}|/" :includes (string-from-code-unit code)))
                      (not (and in-class (= code 45))))
             (regexp-fail state "unsupported Unicode RegExp escape"))
           (js-object :kind "char" :value value))))))
  (defun regexp-character (state in-class)
    (let* ((code (regexp-take state))
           (node (if (= code 92) (regexp-escape state in-class) (js-object :kind "char" :value code))))
      ;; In Unicode mode a literal or escaped surrogate pair forms one atom.
      (when (and (get state :unicode) (= (get node :kind) "char")
                 (>= (get node :value) 55296) (<= (get node :value) 56319))
        (let ((start (get state :at)) (next (regexp-peek state)) (low -1))
          (when (and (>= next 56320) (<= next 57343)) (setq low (regexp-take state)))
          (when (and (= next 92) (= (string-code-unit-at (get state :source) (1+ start)) 117))
            (put state :at (+ start 2)) (setq low (regexp-hex-value state 4)))
          (if (and (>= low 56320) (<= low 57343))
            (put node :value (+ 65536 (* (- (get node :value) 55296) 1024) (- low 56320)))
            (put state :at start)))) node))
  (defun regexp-class (state)
    (let ((negative (= (regexp-peek state) 94)) (ranges (js-array)))
      (when negative (regexp-take state))
      (while (and (>= (regexp-peek state) 0) (/= (regexp-peek state) 93))
        (let ((first (regexp-character state t)))
          (when (and (get state :unicode) (= (get first :kind) "class") (= (regexp-peek state) 45)
                     (/= (string-code-unit-at (get state :source) (1+ (get state :at))) 93))
            (regexp-fail state "class escapes cannot be Unicode RegExp range endpoints"))
          (when (and (= (get first :kind) "char") (= (regexp-peek state) 45)
                     (/= (string-code-unit-at (get state :source) (1+ (get state :at))) 93))
            (regexp-take state)
            (let ((last (regexp-character state t)))
              (unless (and (= (get last :kind) "char") (>= (get last :value) (get first :value)))
                (regexp-fail state "unsupported or reversed RegExp class range"))
              (setq first (js-object :kind "class" :ranges (js-array (js-array (get first :value) (get last :value)))))))
          (if (= (get first :kind) "class")
            (js-call (get first :ranges) :forEach (lambda (range) (js-call ranges :push range)))
            (js-call ranges :push (js-array (get first :value) (get first :value))))))
      (unless (= (regexp-take state) 93) (regexp-fail state "unterminated RegExp character class"))
      (js-object :kind "class" :ranges ranges :negative negative)))
  (defun regexp-atom (state depth)
    (when (> depth 256) (regexp-fail state "RegExp pattern exceeds parser nesting capacity"))
    (let* ((code (regexp-peek state)) (node nil))
      (cond
        ((= code 40)
         (regexp-take state)
         (let ((group 0))
           (if (= (regexp-peek state) 63)
             (progn (regexp-take state) (unless (= (regexp-take state) 58) (regexp-fail state "RegExp lookaround and named captures are not implemented")))
             (progn (put state :groups (1+ (get state :groups))) (setq group (get state :groups))))
           (setq node (regexp-alternation state (1+ depth)))
           (unless (= (regexp-take state) 41) (regexp-fail state "unterminated RegExp group"))
           (when (> group 0) (setq node (js-object :kind "group" :value group :child node)))))
        ((= code 91) (regexp-take state) (setq node (regexp-class state)))
        ((or (= code 94) (= code 36) (= code 46))
         (regexp-take state) (setq node (js-object :kind (if (= code 94) "start" (if (= code 36) "end" "any")))))
        ((and (= code 93) (get state :unicode)) (regexp-fail state "unmatched Unicode RegExp class closing bracket"))
        ((or (= code 42) (= code 43) (= code 63) (= code 123) (= code 125))
         (regexp-fail state "unsupported or misplaced RegExp quantifier"))
        (t (setq node (regexp-character state nil))))
      (let ((repeat (regexp-peek state)))
        (when (= repeat 123)
          (when (or (= (get node :kind) "start") (= (get node :kind) "end") (= (get node :kind) "boundary"))
            (regexp-fail state "RegExp assertions cannot be repeated"))
          (regexp-take state)
          (let ((count 0) (digits 0))
            (while (and (>= (regexp-peek state) 48) (<= (regexp-peek state) 57))
              (setq count (+ (* count 10) (- (regexp-take state) 48)))
              (setq digits (1+ digits))
              ;; Bound expansion by the same capacity as emitted instructions.
              (when (> count 1048576) (regexp-fail state "RegExp exact repetition exceeds instruction capacity")))
            (unless (and (> digits 0) (= (regexp-take state) 125))
              (regexp-fail state "unsupported or invalid RegExp exact quantifier"))
            ;; With a fixed count, greedy and lazy execute identical paths.
            (when (= (regexp-peek state) 63) (regexp-take state))
            (setq node (js-object :kind "exact" :value count :child node))))
        (when (or (= repeat 42) (= repeat 43) (= repeat 63))
          (when (or (= (get node :kind) "start") (= (get node :kind) "end") (= (get node :kind) "boundary"))
            (regexp-fail state "RegExp assertions cannot be repeated"))
          (regexp-take state)
          (let ((lazy (= (regexp-peek state) 63)))
            (when lazy (regexp-take state))
            (setq node (js-object :kind "repeat" :value repeat :lazy lazy :child node))))) node))
  (defun regexp-alternation (state depth)
    (let ((branches (js-array)) (sequence (js-array)))
      (while (and (>= (regexp-peek state) 0) (/= (regexp-peek state) 41))
        (if (= (regexp-peek state) 124)
          (progn (regexp-take state) (js-call branches :push (js-object :kind "sequence" :children sequence)) (setq sequence (js-array)))
          (js-call sequence :push (regexp-atom state depth))))
      (js-call branches :push (js-object :kind "sequence" :children sequence))
      (js-object :kind "alternation" :children branches)))
  (defun regexp-instruction (state op a b c)
    (let ((code (get state :code)) (index (js-length (get state :code))))
      (when (> index 1048575) (regexp-fail state "RegExp program exceeds instruction capacity"))
      (js-call code :push (js-array op a b c)) index))
  (defun regexp-clear-groups (node state)
    (let ((kind (get node :kind)))
      (when (= kind "group") (regexp-instruction state 12 (* (get node :value) 2) 2 0))
      (when (get node :child nil) (regexp-clear-groups (get node :child) state))
      (when (get node :children nil) (js-call (get node :children) :forEach (lambda (child) (regexp-clear-groups child state))))))
  (defun regexp-emit-repeat (child lazy optional state)
    (let* ((split (regexp-instruction state 5 0 0 0)) (body (js-length (get state :code))) (guard (get state :guards)))
      (regexp-clear-groups child state)
      (put state :guards (1+ guard)) (regexp-instruction state 10 guard 0 0)
      (regexp-emit-node child state)
      (regexp-instruction state 11 guard 0 0)
      (unless optional (regexp-instruction state 6 split 0 0))
      (let ((end (js-length (get state :code))) (instruction (js-nth split (get state :code))))
        (put instruction 1 (if lazy end body)) (put instruction 2 (if lazy body end)))))
  (defun regexp-emit-node (node state)
    (let ((kind (get node :kind)))
      (cond
        ((= kind "char") (regexp-instruction state 1 (get node :value) 0 0))
        ((= kind "any") (regexp-instruction state 2 0 0 0))
        ((= kind "start") (regexp-instruction state 8 0 0 0))
        ((= kind "end") (regexp-instruction state 9 0 0 0))
        ((= kind "boundary") (regexp-instruction state 13 (if (get node :value) 1 0) 0 0))
        ((= kind "class")
         (let* ((ranges (get node :ranges)) (index 0)
                (header (regexp-instruction state 3 (if (get node :negative nil) 1 0) (js-length ranges) 0)))
           (while (< index (js-length ranges))
             (let ((range (js-nth index ranges))) (regexp-instruction state 4 (js-nth 0 range) (js-nth 1 range) 0)) (setq index (1+ index)))
           (put (js-nth header (get state :code)) 3 (js-length (get state :code)))))
        ((= kind "group")
         (regexp-instruction state 7 (* (get node :value) 2) 0 0)
         (regexp-emit-node (get node :child) state)
         (regexp-instruction state 7 (1+ (* (get node :value) 2)) 0 0))
        ((= kind "sequence") (js-call (get node :children) :forEach (lambda (child) (regexp-emit-node child state))))
        ((= kind "alternation")
         (let ((branches (get node :children)) (index 0) (ends (js-array)))
           (while (< index (js-length branches))
             (let ((split (if (< index (1- (js-length branches))) (regexp-instruction state 5 0 0 0) -1)))
               (when (>= split 0) (put (js-nth split (get state :code)) 1 (js-length (get state :code))))
               (regexp-emit-node (js-nth index branches) state)
               (when (>= split 0)
                 (js-call ends :push (regexp-instruction state 6 0 0 0))
                 (put (js-nth split (get state :code)) 2 (js-length (get state :code))))) (setq index (1+ index)))
           (js-call ends :forEach (lambda (jump) (put (js-nth jump (get state :code)) 1 (js-length (get state :code)))))))
        ((= kind "exact")
         (let ((index 0))
           (while (< index (get node :value))
             (regexp-clear-groups (get node :child) state)
             (regexp-emit-node (get node :child) state)
             (setq index (1+ index)))))
        ((= kind "repeat")
         (when (= (get node :value) 43) (regexp-clear-groups (get node :child) state) (regexp-emit-node (get node :child) state))
         (regexp-emit-repeat (get node :child) (get node :lazy) (= (get node :value) 63) state))
        (t (regexp-fail state "unsupported RegExp node")))))
  (defun compile-regexp-literal (node)
    (when (and (= (get node :kind) "raw-javascript") (= (get node :value) "js*")
               (Array/isArray (get node :children)) (= (js-length (get node :children)) 1))
      (let ((literal (js-nth 0 (get node :children))))
        (when (and literal (= (get literal :kind) "literal") (= (value-type (get literal :value)) "string")
                   (Array/isArray (get literal :children)) (= (js-length (get literal :children)) 0)
                   (nil? (get (get literal :properties (js-object)) :literalKind nil)))
          (let* ((source (get literal :value)) (length (js-length source))
                 (state (js-object :node node :source "" :at 0 :groups 0 :guards 0 :code (js-array) :unicode false)))
            (when (and (> length 1) (= (string-code-unit-at source 0) 47)
                       (/= (string-code-unit-at source 1) 47) (/= (string-code-unit-at source 1) 42))
              (let ((end 1) (escaped false) (in-class false) (done false) (flags 0) (seen ""))
                (while (and (< end length) (not done))
                  (let ((code (string-code-unit-at source end)))
                    (when (or (= code 10) (= code 13) (= code 8232) (= code 8233))
                      (regexp-fail state "line terminators are not allowed in RegExp literals"))
                    (if escaped (setq escaped false)
                      (cond ((= code 92) (setq escaped t)) ((= code 91) (setq in-class t)) ((= code 93) (setq in-class false))
                            ((and (= code 47) (not in-class)) (setq done t)))))
                  (unless done (setq end (1+ end))))
                (unless done (regexp-fail state "unterminated RegExp literal"))
                (let ((index (1+ end)))
                  (while (< index length)
                    (let ((flag (string-from-code-unit (string-code-unit-at source index))))
                      (when (or (not (js-call "msu" :includes flag)) (js-call seen :includes flag))
                        (regexp-fail state "unsupported or duplicate RegExp flag"))
                      (setq seen (str seen flag))
                      (setq flags (+ flags (if (= flag "m") 1 (if (= flag "s") 2 4))))) (setq index (1+ index))))
                (put state :source (js-call source :slice 1 end)) (put state :unicode (/= (bit-and flags 4) 0))
                (let ((tree (regexp-alternation state 0)))
                  (unless (= (get state :at) (js-length (get state :source))) (regexp-fail state "unmatched RegExp closing group"))
                  (regexp-instruction state 7 0 0 0) (regexp-emit-node tree state) (regexp-instruction state 7 1 0 0)
                  (regexp-instruction state 0 0 0 0)
                  (when (or (> (get state :groups) 65535) (> (get state :guards) 65535))
                    (regexp-fail state "RegExp state exceeds runtime register capacity"))
                  (js-object :code (get state :code) :groups (get state :groups) :guards (get state :guards)
                    :flags flags :source (get state :source))))))))))
  (export compile-regexp-literal))
