  (defun regexp-property-escape (state negative)
    (unless (= (regexp-take state) 123) (regexp-fail state "invalid Unicode RegExp property escape"))
    (let ((start (get state :at)))
      (while (and (>= (regexp-peek state) 0) (/= (regexp-peek state) 125))
        (let ((unit (regexp-take state)))
          (unless (or (and (>= unit 65) (<= unit 90)) (and (>= unit 97) (<= unit 122))
                      (and (>= unit 48) (<= unit 57)) (= unit 95) (= unit 61))
            (regexp-fail state "invalid Unicode RegExp property name"))))
      (let* ((name (js-call (get state :source) :slice start (get state :at)))
             (strings (if (get state :unicodeSets false)
               (cond ((= name "Basic_Emoji") 1) ((= name "Emoji_Keycap_Sequence") 2)
                 ((= name "RGI_Emoji_Modifier_Sequence") 3) ((= name "RGI_Emoji_Flag_Sequence") 4)
                 ((= name "RGI_Emoji_Tag_Sequence") 5) ((= name "RGI_Emoji_ZWJ_Sequence") 6)
                 ((= name "RGI_Emoji") 7) (t 0)) 0))
             (property (if (> strings 0) 0 (regexp-property-id (get state :source) start (- (get state :at) start)))))
        (unless (and (or (> property 0) (> strings 0)) (= (regexp-take state) 125))
          (regexp-fail state "unknown Unicode RegExp property"))
        (when (and (> strings 0) negative) (regexp-fail state "string properties cannot be complemented"))
        (if (> strings 0) (js-object :kind "v-string-property" :value strings :maximum 32 :strings t)
          (js-object :kind "property" :value property :negative negative)))))
  (defun regexp-escape (state in-class)
    (let ((code (regexp-take state)))
      (when (< code 0) (regexp-fail state "unterminated RegExp escape"))
      (cond
        ((and (get state :unicode) (or (= code 112) (= code 80)))
         (regexp-property-escape state (= code 80)))
