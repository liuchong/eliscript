(module eliscript.backend.memory
  (import "./numeric.mjs" lower-scalar-program backend-fail)
  ;; Internal memory32 + Val64/bits64 ABI for runtime kernels.
  ;; Linear memory addresses stay u32; managed language values use v64 and raw
  ;; untagged 64-bit payloads use bits64 (never implicitly convertible).
  (defun memory-capabilities ()
    (js-array
      (js-object :name "load-u8" :arity 1 :parameterTypes (js-array "u32") :resultType "u32")
      (js-object :name "load-u16" :arity 1 :parameterTypes (js-array "u32") :resultType "u32")
      (js-object :name "load-u32" :arity 1 :parameterTypes (js-array "u32") :resultType "u32")
      (js-object :name "store-u8" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "store-u16" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "store-u32" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "copy-static-u16" :arity 2 :staticData t :resultType "u32")
      (js-object :name "memory-copy" :arity 3 :parameterTypes (js-array "u32" "u32" "u32") :resultType "u32")
      (js-object :name "memory-fill" :arity 3 :parameterTypes (js-array "u32" "u32" "u32") :resultType "u32")
      (js-object :name "load-f64" :arity 1 :parameterTypes (js-array "u32") :resultType "f64")
      (js-object :name "store-f64" :arity 2 :parameterTypes (js-array "u32" "f64") :resultType "u32")
      (js-object :name "f64-literal" :arity 1 :staticLiteral t :resultType "f64")
      (js-object :name "f64-abs" :arity 1 :parameterTypes (js-array "f64") :resultType "f64")
      (js-object :name "f64-neg" :arity 1 :parameterTypes (js-array "f64") :resultType "f64")
      (js-object :name "f64-ceil" :arity 1 :parameterTypes (js-array "f64") :resultType "f64")
      (js-object :name "f64-floor" :arity 1 :parameterTypes (js-array "f64") :resultType "f64")
      (js-object :name "f64-trunc" :arity 1 :parameterTypes (js-array "f64") :resultType "f64")
      (js-object :name "f64-nearest" :arity 1 :parameterTypes (js-array "f64") :resultType "f64")
      (js-object :name "f64-sqrt" :arity 1 :parameterTypes (js-array "f64") :resultType "f64")
      (js-object :name "v64-literal" :arity 2 :staticWords64 t :resultType "v64")
      (js-object :name "bits64-literal" :arity 2 :staticWords64 t :resultType "bits64")
      (js-object :name "load-v64" :arity 1 :parameterTypes (js-array "u32") :resultType "v64")
      (js-object :name "store-v64" :arity 2 :parameterTypes (js-array "u32" "v64") :resultType "u32")
      (js-object :name "load-bits64" :arity 1 :parameterTypes (js-array "u32") :resultType "bits64")
      (js-object :name "store-bits64" :arity 2 :parameterTypes (js-array "u32" "bits64") :resultType "u32")
      (js-object :name "f64-from-bits64" :arity 1 :parameterTypes (js-array "bits64") :resultType "f64")
      (js-object :name "bits64-from-f64" :arity 1 :parameterTypes (js-array "f64") :resultType "bits64")
      (js-object :name "bits64-pack" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "bits64")
      (js-object :name "bits64-low" :arity 1 :parameterTypes (js-array "bits64") :resultType "u32")
      (js-object :name "bits64-high" :arity 1 :parameterTypes (js-array "bits64") :resultType "u32")
      (js-object :name "v64-from-u32" :arity 1 :parameterTypes (js-array "u32") :resultType "v64")
      (js-object :name "v64-pack" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "v64")
      (js-object :name "v64-low" :arity 1 :parameterTypes (js-array "v64") :resultType "u32")
      (js-object :name "v64-high" :arity 1 :parameterTypes (js-array "v64") :resultType "u32")
      (js-object :name "v64-encode-bits64" :arity 1 :parameterTypes (js-array "bits64") :resultType "v64")
      (js-object :name "v64-decode-bits64" :arity 1 :parameterTypes (js-array "v64") :resultType "bits64")
      (js-object :name "v64-add" :arity 2 :parameterTypes (js-array "v64" "v64") :resultType "v64")
      (js-object :name "v64-sub" :arity 2 :parameterTypes (js-array "v64" "v64") :resultType "v64")
      (js-object :name "v64-and" :arity 2 :parameterTypes (js-array "v64" "v64") :resultType "v64")
      (js-object :name "v64-or" :arity 2 :parameterTypes (js-array "v64" "v64") :resultType "v64")
      (js-object :name "v64-xor" :arity 2 :parameterTypes (js-array "v64" "v64") :resultType "v64")
      (js-object :name "v64-shl" :arity 2 :parameterTypes (js-array "v64" "v64") :resultType "v64")
      (js-object :name "v64-shr" :arity 2 :parameterTypes (js-array "v64" "v64") :resultType "v64")
      (js-object :name "bits64-add" :arity 2 :parameterTypes (js-array "bits64" "bits64") :resultType "bits64")
      (js-object :name "bits64-sub" :arity 2 :parameterTypes (js-array "bits64" "bits64") :resultType "bits64")
      (js-object :name "bits64-and" :arity 2 :parameterTypes (js-array "bits64" "bits64") :resultType "bits64")
      (js-object :name "bits64-or" :arity 2 :parameterTypes (js-array "bits64" "bits64") :resultType "bits64")
      (js-object :name "bits64-xor" :arity 2 :parameterTypes (js-array "bits64" "bits64") :resultType "bits64")
      (js-object :name "bits64-shl" :arity 2 :parameterTypes (js-array "bits64" "bits64") :resultType "bits64")
      (js-object :name "bits64-shr" :arity 2 :parameterTypes (js-array "bits64" "bits64") :resultType "bits64")
      (js-object :name "memory-size" :arity 0 :parameterTypes (js-array) :resultType "u32")
      (js-object :name "memory-grow" :arity 1 :parameterTypes (js-array "u32") :resultType "u32")
      (js-object :name "word-div" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "word-shr" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "word-shl" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "word-and" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "word-or" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "word-xor" :arity 2 :parameterTypes (js-array "u32" "u32") :resultType "u32")
      (js-object :name "call-source" :arity 5
        :parameterTypes (js-array "u32" "v64" "v64" "u32" "u32") :resultType "v64")))

  (defconst source-call-parameter-types (Object/freeze (js-array "u32" "v64" "v64" "u32")))

  (defun memory-sig-declaration-p (node)
    (and node (= (get node :kind nil) "call")
         (> (js-length (get node :children (js-array))) 0)
         (= (get (js-nth 0 (get node :children)) :kind nil) "reference")
         (= (get (js-nth 0 (get node :children)) :value nil) "memory-sig")))

  (defun prepare-memory-source-calls (expression)
    (let ((found false) (children (get expression :children)) (index 0))
      (when (and (= (get expression :kind) "memory-op") (= (get expression :value) "call-source"))
        (put expression :kind "call-indirect")
        (put expression :value 4)
        (put expression :parameterTypes source-call-parameter-types)
        (put expression :resultType "v64")
        (setq found t))
      (while (< index (js-length children))
        (when (prepare-memory-source-calls (js-nth index children)) (setq found t))
        (setq index (1+ index)))
      found))

  (defun validate-memory-sequence (children consumed start)
    (let ((index start))
      (while (< index (js-length children))
        (validate-memory-expression (js-nth index children)
          (and consumed (= index (1- (js-length children)))))
        (setq index (1+ index)))))

  (defun validate-memory-expression (node consumed)
    (let ((kind (get node :kind)) (children (get node :children)))
      (cond
        ((= kind "conditional-sugar")
         ;; The internal word ABI cannot represent the Number-or-nil result.
         ;; Statement lowering is safe only when that result is unobservable.
         (when consumed (backend-fail node "memory-u32 when/unless require statement position"))
         (validate-memory-expression (js-nth 0 children) t)
         (validate-memory-sequence children nil 1))
        ((= kind "sequence") (validate-memory-sequence children consumed 0))
        ((= kind "lexical-bindings")
         (let ((count (get (get node :properties) :bindingCount)) (index 0))
           (while (< index count)
             (validate-memory-expression (js-nth 0 (get (js-nth index children) :children)) t)
             (setq index (1+ index)))
           (validate-memory-sequence children consumed count)))
        ((= kind "loop")
         (validate-memory-expression (js-nth 0 children) t)
         (validate-memory-sequence children nil 1))
        ((= kind "conditional")
         (unless (= (js-length children) 3)
           (backend-fail node "memory-u32 if requires an explicit else branch"))
         (validate-memory-expression (js-nth 0 children) t)
         (validate-memory-expression (js-nth 1 children) consumed)
         (validate-memory-expression (js-nth 2 children) consumed))
        ((= kind "conditional-chain")
         (let ((index 0))
           (while (< index (js-length children))
             (let* ((clause (js-nth index children)) (parts (get clause :children)))
               (unless (and (= (get clause :kind) "conditional-clause") (> (js-length parts) 0))
                 (backend-fail clause "memory-u32 cond requires nonempty clauses"))
               (validate-memory-expression (js-nth 0 parts) t)
               (validate-memory-sequence parts consumed 1))
             (setq index (1+ index)))))
        (t
         (let ((index 0))
           (while (< index (js-length children))
             (validate-memory-expression (js-nth index children) t)
             (setq index (1+ index))))))))

  (defun validate-memory-declarations (nodes)
    (let ((index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (if (= (get node :kind) "module-declaration")
              (validate-memory-declarations (get node :children))
            (when (= (get node :kind) "function-declaration")
              (let* ((children (get node :children))
                     (arity (get (get node :properties) :parameterCount))
                     (start (if (and (> (js-length children) arity)
                                     (memory-sig-declaration-p (js-nth arity children)))
                              (1+ arity) arity)))
                (when (>= start (js-length children))
                  (backend-fail node "memory-u32 function with memory-sig requires a body"))
                (validate-memory-sequence children t start)))))
        (setq index (1+ index)))))

  (defun lower-memory-program (program)
    (try
      (validate-memory-declarations (get program :body))
      (let* ((lowered (lower-scalar-program program "memory-u32" (memory-capabilities)))
             (functions (get lowered :functions)) (index 0) (calls false))
        (while (< index (js-length functions))
          (when (prepare-memory-source-calls (get (js-nth index functions) :body)) (setq calls t))
          (setq index (1+ index)))
        (when calls
          (put lowered :table (js-array))
          (put lowered :indirectSignatures
            (js-array (js-object :parameterTypes source-call-parameter-types :resultType "v64"))))
        lowered)
      (catch error
        (let ((diagnostic (get error :eliscriptDiagnostic nil)))
          (when diagnostic (put diagnostic :phase "memory-backend")))
        (throw error))))

  (export lower-memory-program))
