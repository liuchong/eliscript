(module eliscript.backend.wasm
  (import "./optimize.mjs" optimize-program)
  (import "./numeric.mjs" lower-numeric-program backend-fail find-function)

  ;; Byte encoding and instruction selection are Eliscript algorithms. The
  ;; returned ordinary byte array needs no assembler, linker, or optimizer.
  (defun append-bytes (output bytes)
    (let ((index 0))
      (while (< index (js-length bytes))
        (js-call output :push (js-nth index bytes))
        (setq index (1+ index))))
    output)

  (defun unsigned-leb (output value)
    (unless (and (= (value-type value) "number") (>= value 0)
                 (<= value 4294967295) (= value (uint32 value)))
      (backend-fail nil "WASM index or section length is outside u32"))
    (while (>= value 128)
      (js-call output :push (bit-or (bit-and value 127) 128))
      (setq value (unsigned-bit-shift-right value 7)))
    (js-call output :push value)
    output)

  (defun float64-bytes (output value)
    (let* ((words (number-float64-words value))
           (low (js-nth 0 words)) (high (js-nth 1 words))
           (index 0))
      ;; The hashing intrinsic canonicalizes zero; instruction literals must
      ;; restore the sign so this is IEEE encoding, not hash encoding.
      (when (and (= value 0) (< (/ 1 value) 0)) (setq high 2147483648))
      (while (< index 4)
        (js-call output :push (bit-and low 255))
        (setq low (unsigned-bit-shift-right low 8))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index 4)
        (js-call output :push (bit-and high 255))
        (setq high (unsigned-bit-shift-right high 8))
        (setq index (1+ index))))
    output)

  (defun utf8-name (output name)
    (let ((bytes (js-array)) (index 0))
      (while (< index (js-length name))
        (let ((code (string-code-unit-at name index)))
          (when (and (>= code 55296) (<= code 56319))
            (when (>= (1+ index) (js-length name))
              (backend-fail nil "WASM export name contains an unpaired surrogate"))
            (let ((next (string-code-unit-at name (1+ index))))
              (unless (and (>= next 56320) (<= next 57343))
                (backend-fail nil "WASM export name contains an unpaired surrogate"))
              (setq code (+ 65536 (* (- code 55296) 1024) (- next 56320)))
              (setq index (1+ index))))
          (when (and (>= code 56320) (<= code 57343))
            (backend-fail nil "WASM export name contains an unpaired surrogate"))
          (cond
            ((< code 128) (js-call bytes :push code))
            ((< code 2048)
             (js-call bytes :push (bit-or 192 (unsigned-bit-shift-right code 6)))
             (js-call bytes :push (bit-or 128 (bit-and code 63))))
            ((< code 65536)
             (js-call bytes :push (bit-or 224 (unsigned-bit-shift-right code 12)))
             (js-call bytes :push (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63)))
             (js-call bytes :push (bit-or 128 (bit-and code 63))))
            (t
             (js-call bytes :push (bit-or 240 (unsigned-bit-shift-right code 18)))
             (js-call bytes :push (bit-or 128 (bit-and (unsigned-bit-shift-right code 12) 63)))
             (js-call bytes :push (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63)))
             (js-call bytes :push (bit-or 128 (bit-and code 63))))))
        (setq index (1+ index)))
      (unsigned-leb output (js-length bytes))
      (append-bytes output bytes)))

  (defun section (output id payload)
    (js-call output :push id)
    (unsigned-leb output (js-length payload))
    (append-bytes output payload))

  (defun result-byte (type)
    (if (= type "f64") 124 127))

  (defun emit-condition (output expression)
    ;; Every Number is true in Eliscript, including zero and NaN. Retain
    ;; evaluation effects; do not use C/JS numeric truth or f64 comparisons.
    (if (= (get expression :type) "f64")
        (progn (emit-discarded output expression) (js-call output :push 65 1))
      (emit-expression output expression)))

  (defun emit-while (output children)
    (js-call output :push 2 64 3 64)
    (emit-condition output (js-nth 0 children))
    (js-call output :push 69 13 1)
    (emit-discarded output (js-nth 1 children))
    (js-call output :push 12 0 11 11))

  (defun emit-discarded-short-circuit (output expression index)
    (let* ((children (get expression :children))
           (operand (js-nth index children))
           (operator (get expression :kind)))
      (cond
        ((= index (1- (js-length children))) (emit-discarded output operand))
        ((= (get expression :type) "f64")
         (emit-discarded output operand)
         (when (= operator "and")
           (emit-discarded-short-circuit output expression (1+ index))))
        (t
         (emit-condition output operand)
         (when (= operator "or") (js-call output :push 69))
         (js-call output :push 4 64)
         (emit-discarded-short-circuit output expression (1+ index))
         (js-call output :push 11)))))

  (defun emit-discarded (output expression)
    ;; Only numeric-f64 operations are eliminated here: local reads and IEEE
    ;; arithmetic do not trap. Retain assignments, short-circuit evaluation,
    ;; loop termination and all calls (even a discarded call may diverge).
    (let ((kind (get expression :kind))
          (children (get expression :children)))
      (cond
        ((or (= kind "literal") (= kind "local")) nil)
        ((= kind "set")
         (emit-expression output (js-nth 0 children))
         (js-call output :push 33)
         (unsigned-leb output (get expression :value)))
        ((or (= kind "sequence") (= kind "arithmetic")
             (= kind "compare") (= kind "not"))
         (let ((index 0))
           (while (< index (js-length children))
             (emit-discarded output (js-nth index children))
             (setq index (1+ index)))))
        ((= kind "if")
         (emit-condition output (js-nth 0 children))
         (js-call output :push 4 64)
         (emit-discarded output (js-nth 1 children))
         (js-call output :push 5)
         (emit-discarded output (js-nth 2 children))
         (js-call output :push 11))
        ((= kind "while") (emit-while output children))
        ((or (= kind "and") (= kind "or"))
         (emit-discarded-short-circuit output expression 0))
        (t (emit-expression output expression) (js-call output :push 26)))))

  (defun emit-sequence (output children)
    (if (= (js-length children) 0)
        (js-call output :push 65 0)
      (let ((index 0))
        (while (< index (js-length children))
          (if (< index (1- (js-length children)))
              (emit-discarded output (js-nth index children))
            (emit-expression output (js-nth index children)))
          (setq index (1+ index))))))

  (defun emit-short-circuit (output expression index)
    (let* ((children (get expression :children))
           (operand (js-nth index children))
           (operator (get expression :kind)))
      (cond
        ((= index (1- (js-length children))) (emit-expression output operand))
        ((= (get expression :type) "f64")
         (emit-expression output operand)
         (when (= operator "and")
           (js-call output :push 26)
           (emit-short-circuit output expression (1+ index))))
        (t
         (emit-condition output operand)
         (js-call output :push 4 127)
         (if (= operator "and")
             (emit-short-circuit output expression (1+ index))
           (js-call output :push 65 1))
         (js-call output :push 5)
         (if (= operator "and")
             (js-call output :push 65 0)
           (emit-short-circuit output expression (1+ index)))
         (js-call output :push 11)))))

  (defun arithmetic-opcode (operator)
    (cond ((or (= operator "+") (= operator "1+")) 160)
          ((or (= operator "-") (= operator "1-")) 161)
          ((= operator "*") 162)
          (t 163)))

  (defun emit-arithmetic (output expression)
    (let* ((operator (get expression :value))
           (children (get expression :children))
           (count (js-length children)))
      (cond
        ((= count 0)
         (js-call output :push 68)
         (float64-bytes output (if (= operator "*") 1 0)))
        ((and (= count 1) (= operator "-"))
         (emit-expression output (js-nth 0 children))
         (js-call output :push 154))
        ((and (= count 1) (= operator "/"))
         (js-call output :push 68)
         (float64-bytes output 1)
         (emit-expression output (js-nth 0 children))
         (js-call output :push 163))
        (t
         (emit-expression output (js-nth 0 children))
         (cond
           ((= count 2)
            (emit-expression output (js-nth 1 children))
            (js-call output :push (arithmetic-opcode operator)))
           ((or (= operator "1+") (= operator "1-"))
            (js-call output :push 68)
            (float64-bytes output 1)
            (js-call output :push (arithmetic-opcode operator))))))))

  (defun emit-expression (output expression)
    (let ((kind (get expression :kind))
          (children (get expression :children))
          (value (get expression :value)))
      (cond
        ((= kind "literal")
         (if (= (get expression :type) "f64")
             (progn (js-call output :push 68) (float64-bytes output value))
           (js-call output :push 65 value)))
        ((= kind "local") (js-call output :push 32) (unsigned-leb output value))
        ((= kind "set")
         (emit-expression output (js-nth 0 children))
         (js-call output :push 34)
         (unsigned-leb output value))
        ((= kind "sequence") (emit-sequence output children))
        ((= kind "arithmetic") (emit-arithmetic output expression))
        ((= kind "compare")
         (emit-expression output (js-nth 0 children))
         (emit-expression output (js-nth 1 children))
         (js-call output :push
           (cond ((= value "=") 97) ((= value "<") 99)
                 ((= value ">") 100) ((= value "<=") 101) (t 102))))
        ((= kind "not") (emit-condition output (js-nth 0 children))
         (js-call output :push 69))
        ((= kind "if")
         (emit-condition output (js-nth 0 children))
         (js-call output :push 4 (result-byte (get expression :type)))
         (emit-expression output (js-nth 1 children))
         (js-call output :push 5)
         (emit-expression output (js-nth 2 children))
         (js-call output :push 11))
        ((= kind "while")
         (emit-while output children)
         (js-call output :push 65 0))
        ((or (= kind "and") (= kind "or")) (emit-short-circuit output expression 0))
        ((= kind "call")
         (let ((index 0))
           (while (< index (js-length children))
             (emit-expression output (js-nth index children))
             (setq index (1+ index))))
         (js-call output :push 16)
         (unsigned-leb output value))
        (t (backend-fail expression (str "unknown typed WASM expression: " kind))))))

  (defun emit-typed-numeric-wasm (program)
    (unless (= (get program :abi) "numeric-f64")
      (backend-fail program "WASM emitter requires numeric-f64 typed input"))
    (let* ((functions (get program :functions))
           (arities (js-array)) (type-indices (js-array))
           (types (js-array)) (declarations (js-array))
           (exports (js-array)) (bodies (js-array))
           (output (js-array 0 97 115 109 1 0 0 0)) (index 0))
      (while (< index (js-length functions))
        (let* ((arity (get (js-nth index functions) :arity))
               (position 0))
          (while (and (< position (js-length arities))
                      (/= (js-nth position arities) arity))
            (setq position (1+ position)))
          (when (= position (js-length arities)) (js-call arities :push arity))
          (js-call type-indices :push position))
        (setq index (1+ index)))
      (unsigned-leb types (js-length arities))
      (setq index 0)
      (while (< index (js-length arities))
        (js-call types :push 96)
        (unsigned-leb types (js-nth index arities))
        (let ((parameter 0))
          (while (< parameter (js-nth index arities))
            (js-call types :push 124)
            (setq parameter (1+ parameter))))
        (js-call types :push 1 124)
        (setq index (1+ index)))
      (unsigned-leb declarations (js-length functions))
      (setq index 0)
      (while (< index (js-length functions))
        (unsigned-leb declarations (js-nth index type-indices))
        (setq index (1+ index)))
      (unsigned-leb exports (js-length (get program :exports)))
      (setq index 0)
      (while (< index (js-length (get program :exports)))
        (let ((name (js-nth index (get program :exports))))
          (utf8-name exports name)
          (js-call exports :push 0)
          (unsigned-leb exports (get (find-function functions name) :index)))
        (setq index (1+ index)))
      (unsigned-leb bodies (js-length functions))
      (setq index 0)
      (while (< index (js-length functions))
        (let* ((function (js-nth index functions))
               (body (js-array)) (locals (get function :locals))
               (count (- (js-length locals) (get function :arity)))
               (position (get function :arity)))
          ;; Each local is one declaration group. Indexing remains stable
          ;; across scopes; later grouping may reduce bytes without semantics.
          (unsigned-leb body count)
          (while (< position (js-length locals))
            (js-call body :push 1 (result-byte (get (js-nth position locals) :type)))
            (setq position (1+ position)))
          (emit-expression body (get function :body))
          (js-call body :push 11)
          (unsigned-leb bodies (js-length body))
          (append-bytes bodies body))
        (setq index (1+ index)))
      (section output 1 types)
      (section output 3 declarations)
      (section output 7 exports)
      (section output 10 bodies)
      output))

  (defun emit-numeric-wasm (program)
    ;; Validate the complete input, including unselected branches, first.
    (lower-numeric-program program)
    (emit-typed-numeric-wasm (lower-numeric-program (optimize-program program))))

  (export emit-numeric-wasm emit-typed-numeric-wasm))
