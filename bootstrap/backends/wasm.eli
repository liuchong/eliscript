(module eliscript.backend.wasm
  (import "./optimize.mjs" optimize-program)
  (import "./numeric.mjs" lower-numeric-program optimize-numeric-program numeric-pure tree-size backend-fail find-function)

  (import "./memory.mjs" lower-memory-program)
  (import "./capabilities.mjs" prepare-host-capabilities host-capability-index)
  (import "./managed.mjs" lower-managed-program lower-managed-project)
  (import "./binary.mjs" binary-output binary-byte binary-push binary-child binary-length binary-resume
    binary-append binary-append-owned binary-finish)

  ;; Byte encoding and instruction selection are Eliscript algorithms. The
  ;; returned ordinary byte array needs no assembler, linker, or optimizer.
  (defun append-bytes (output bytes)
    (binary-append output bytes))

  (defun unsigned-leb (output value)
    (unless (and (= (value-type value) "number") (>= value 0)
                 (<= value 4294967295) (= value (uint32 value)))
      (backend-fail nil "WASM index or section length is outside u32"))
    (while (>= value 128)
      (binary-push output (bit-or (bit-and value 127) 128))
      (setq value (unsigned-bit-shift-right value 7)))
    (binary-push output value)
    output)

  (defun float64-bytes (output value)
    (let* ((words (number-float64-words value))
           (low (js-nth 0 words)) (high (js-nth 1 words))
           (index 0))
      ;; The hashing intrinsic canonicalizes zero; instruction literals must
      ;; restore the sign so this is IEEE encoding, not hash encoding.
      (when (and (= value 0) (< (/ 1 value) 0)) (setq high 2147483648))
      (while (< index 4)
        (binary-push output (bit-and low 255))
        (setq low (unsigned-bit-shift-right low 8))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index 4)
        (binary-push output (bit-and high 255))
        (setq high (unsigned-bit-shift-right high 8))
        (setq index (1+ index))))
    output)

  (defun positive-signed-leb (output value)
    (while (>= value 128)
      (binary-push output (bit-or (bit-and value 127) 128))
      (setq value (unsigned-bit-shift-right value 7)))
    (if (>= value 64) (binary-push output (bit-or value 128) 0)
      (binary-push output value)))

  (defun signed-word-leb (output value)
    (setq value (bit-or value 0))
    (let ((done nil))
      (while (not done)
        (let ((byte (bit-and value 127)))
          (setq value (bit-shift-right value 7))
          (setq done (or (and (= value 0) (< byte 64))
                         (and (= value -1) (>= byte 64))))
          (binary-push output (if done byte (bit-or byte 128))))))
    output)

  (defun number-type (expression)
    (or (= (get expression :type) "f64") (= (get expression :type) "u32")))

  (defun utf8-name (output name)
    (let ((bytes (binary-child output)) (index 0))
      (while (< index (js-length name))
        (let ((code (string-code-unit-at name index)))
          (when (and (>= code 55296) (<= code 56319))
            (when (>= (1+ index) (js-length name))
              (backend-fail nil "WASM export name contains an unpaired surrogate"))
            (let ((next (string-code-unit-at name (1+ index))))
              (unless (and (>= next 56320) (<= next 57343))
                (backend-fail nil "WASM export name contains an unpaired surrogate"))
              (setq code (+ 65536 (* (- code 55296) 1024) (- next 56320)))
              (setq index (1+ index))))
          (when (and (>= code 56320) (<= code 57343))
            (backend-fail nil "WASM export name contains an unpaired surrogate"))
          (cond
            ((< code 128) (binary-push bytes code))
            ((< code 2048)
             (binary-push bytes (bit-or 192 (unsigned-bit-shift-right code 6)))
             (binary-push bytes (bit-or 128 (bit-and code 63))))
            ((< code 65536)
             (binary-push bytes (bit-or 224 (unsigned-bit-shift-right code 12)))
             (binary-push bytes (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63)))
             (binary-push bytes (bit-or 128 (bit-and code 63))))
            (t
             (binary-push bytes (bit-or 240 (unsigned-bit-shift-right code 18)))
             (binary-push bytes (bit-or 128 (bit-and (unsigned-bit-shift-right code 12) 63)))
             (binary-push bytes (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63)))
             (binary-push bytes (bit-or 128 (bit-and code 63))))))
        (setq index (1+ index)))
      (unsigned-leb output (js-length bytes))
      (append-bytes output bytes)))

  (defun section (output id payload)
    (binary-push output id)
    (unsigned-leb output (js-length payload))
    (append-bytes output payload))

  (defun result-byte (type)
    (if (= type "f64") 124 127))

  (defun debug-range-start (output expression emission)
    (let ((state (get output :wasmDebug nil)))
      (when state
        (let* ((depth (get state :depth 0))
               (range (js-object :kind (get expression :kind) :emission emission
                        :function (get state :function) :functionIndex (get state :functionIndex)
                        :depth depth :start (js-length output) :end 0 :span (get expression :span nil))))
          (js-call (get state :ranges) :push range)
          (put state :depth (1+ depth)) range))))

  (defun debug-range-end (output range)
    (when range
      (put range :end (js-length output))
      (put (get output :wasmDebug) :depth (get range :depth))))

  (defun emit-trapping-bytes (output expression bytes &optional terminal)
    (let ((state (get output :wasmDebug nil)) (range nil))
      (when state
        (let ((sites (get state :trapSites)))
          (binary-push output 65) (positive-signed-leb output (1+ (js-length sites)))
          (binary-push output 36 0)
          (setq range (js-object :kind "trap-site" :function (get state :function) :functionIndex (get state :functionIndex)
            :depth (get state :depth) :start (js-length output) :end 0 :span (get expression :span nil)
            :site (1+ (js-length sites))))
          (js-call sites :push range) (js-call (get state :ranges) :push range)))
      (append-bytes output bytes)
      (when range
        (put range :end (js-length output))
        (unless terminal (binary-push output 65 0 36 0)))))

  (defun emit-condition (output expression)
    (let ((range (debug-range-start output expression "condition")))
      (let ((result (emit-condition-body output expression)))
        (debug-range-end output range) result)))

  (defun emit-condition-body (output expression)
    ;; Every Number is true in Eliscript, including zero and NaN. Retain
    ;; evaluation effects; do not use C/JS numeric truth or f64 comparisons.
    (if (number-type expression)
        (progn (emit-discarded output expression) (binary-push output 65 1))
      (emit-expression output expression)))

  (defun emit-while (output children)
    (binary-push output 2 64)
    (emit-branch-false output (js-nth 0 children) 0)
    (binary-push output 3 64)
    (emit-discarded output (js-nth 1 children))
    (emit-branch-true output (js-nth 0 children) 0)
    (binary-push output 11 11))

  (defun emit-guarded-while (output children)
    (binary-push output 2 64)
    (emit-branch-false output (js-nth 0 children) 0)
    (binary-push output 3 64)
    (let ((index 0))
      (while (< index 4)
        (emit-discarded output (js-nth 1 children))
        ;; Every failing guard exits the outer block directly. The last
        ;; successful guard falls through to the backedge, without building
        ;; another nested block for a true conjunction.
        (emit-branch-false output (js-nth 0 children) 1)
        (when (= index 3) (binary-push output 12 0))
        (setq index (1+ index))))
    (binary-push output 11 11))

  (defun emit-counter-guarded-while (output children)
    ;; Exit on each floating guard at its original evaluation point. The
    ;; proven counter admits complete chunks; the original loop handles the
    ;; final zero to three iterations with the original short circuit order.
    (binary-push output 2 64 2 64 3 64)
    (emit-branch-false output (js-nth 2 children) 1)
    (let ((index 0))
      (while (< index 4)
        (emit-branch-false output (js-nth 3 children) 2)
        (emit-discarded output (js-nth 1 children))
        (setq index (1+ index))))
    (binary-push output 12 0 11 11)
    (emit-while output children)
    (binary-push output 11))

  (defun emit-branch-true (output expression depth)
    (let ((range (debug-range-start output expression "branch-true")))
      (let ((result (emit-branch-true-body output expression depth)))
        (debug-range-end output range) result)))

  (defun emit-branch-true-body (output expression depth)
    (let ((kind (get expression :kind)) (children (get expression :children)))
      (cond
        ((number-type expression)
         (emit-discarded output expression)
         (binary-push output 12) (unsigned-leb output depth))
        ((= kind "not") (emit-branch-false output (js-nth 0 children) depth))
        ((= kind "or")
         (let ((index 0))
           (while (< index (js-length children))
             (emit-branch-true output (js-nth index children) depth)
             (setq index (1+ index)))))
        ((= kind "and")
         (binary-push output 2 64)
         (let ((index 0))
           (while (< index (1- (js-length children)))
             (emit-branch-false output (js-nth index children) 0)
             (setq index (1+ index)))
           (emit-branch-true output (js-nth index children) (1+ depth)))
         (binary-push output 11))
        (t
         (emit-condition output expression)
         (binary-push output 13) (unsigned-leb output depth)))))

  (defun emit-branch-false (output expression depth)
    (let ((range (debug-range-start output expression "branch-false")))
      (let ((result (emit-branch-false-body output expression depth)))
        (debug-range-end output range) result)))

  (defun emit-branch-false-body (output expression depth)
    (let ((kind (get expression :kind)) (children (get expression :children)))
      (cond
        ((number-type expression) (emit-discarded output expression))
        ((= kind "not") (emit-branch-true output (js-nth 0 children) depth))
        ((or (= kind "int-compare") (= kind "word-compare"))
         ;; Integer comparisons have no unordered/NaN case. Float comparisons
         ;; deliberately retain eqz, since !(a < b) is not a >= b for NaN.
         (emit-expression output (js-nth 0 children))
         (emit-expression output (js-nth 1 children))
         (binary-push output
           (if (= kind "int-compare") 78
             (let ((operator (get expression :value)))
               (cond ((= operator "=") 71) ((= operator "/=") 70)
                     ((= operator "<") 79) ((= operator ">") 77)
                     ((= operator "<=") 75) (t 73))))
           13)
         (unsigned-leb output depth))
        ((= kind "and")
         (let ((index 0))
           (while (< index (js-length children))
             (emit-branch-false output (js-nth index children) depth)
             (setq index (1+ index)))))
        ((= kind "or")
         (binary-push output 2 64)
         (let ((index 0))
           (while (< index (1- (js-length children)))
             (emit-condition output (js-nth index children))
             (binary-push output 13 0)
             (setq index (1+ index)))
           (emit-branch-false output (js-nth index children) (1+ depth)))
         (binary-push output 11))
        (t
         (emit-condition output expression) (binary-push output 69)
         (binary-push output 13) (unsigned-leb output depth)))))

  (defun emit-discarded-short-circuit (output expression index)
    (let* ((children (get expression :children))
           (operand (js-nth index children))
           (operator (get expression :kind)))
      (cond
        ((= index (1- (js-length children))) (emit-discarded output operand))
        ((number-type expression)
         (emit-discarded output operand)
         (when (= operator "and")
           (emit-discarded-short-circuit output expression (1+ index))))
        (t
         (emit-condition output operand)
         (when (= operator "or") (binary-push output 69))
         (binary-push output 4 64)
         (emit-discarded-short-circuit output expression (1+ index))
         (binary-push output 11)))))

  (defun emit-discarded (output expression)
    (let ((range (debug-range-start output expression "discarded")))
      (let ((result (emit-discarded-body output expression)))
        (debug-range-end output range) result)))

  (defun emit-discarded-body (output expression)
    ;; Only numeric-f64 operations are eliminated here: local reads and IEEE
    ;; arithmetic do not trap. Retain assignments, short-circuit evaluation,
    ;; loop termination and all calls (even a discarded call may diverge).
    (let ((kind (get expression :kind))
          (children (get expression :children)))
      (cond
        ((or (= kind "literal") (= kind "local")) nil)
        ((= kind "int-number") (emit-discarded output (js-nth 0 children)))
        ((or (= kind "set") (= kind "initialize"))
         (emit-expression output (js-nth 0 children))
         (binary-push output 33)
         (unsigned-leb output (get expression :value)))
        ((or (= kind "sequence") (= kind "arithmetic")
             (= kind "compare") (= kind "not"))
         (let ((index 0))
           (while (< index (js-length children))
             (emit-discarded output (js-nth index children))
             (setq index (1+ index)))))
        ((= kind "if")
         (emit-condition output (js-nth 0 children))
         (binary-push output 4 64)
         (emit-discarded output (js-nth 1 children))
         (binary-push output 5)
         (emit-discarded output (js-nth 2 children))
         (binary-push output 11))
        ((or (= kind "while") (= kind "remainder-while")) (emit-while output children))
        ((= kind "guarded-while") (emit-guarded-while output children))
        ((= kind "guarded-counter-while") (emit-counter-guarded-while output children))
        ((or (= kind "and") (= kind "or"))
         (emit-discarded-short-circuit output expression 0))
        (t (emit-expression output expression) (binary-push output 26)))))

  (defun emit-sequence (output children)
    (if (= (js-length children) 0)
        (binary-push output 65 0)
      (let ((index 0))
        (while (< index (js-length children))
          (if (< index (1- (js-length children)))
              (emit-discarded output (js-nth index children))
            (emit-expression output (js-nth index children)))
          (setq index (1+ index))))))

  (defun emit-short-circuit (output expression index)
    (let* ((children (get expression :children))
           (operand (js-nth index children))
           (operator (get expression :kind)))
      (cond
        ((= index (1- (js-length children))) (emit-expression output operand))
        ((number-type expression)
         (emit-expression output operand)
         (when (= operator "and")
           (binary-push output 26)
           (emit-short-circuit output expression (1+ index))))
        (t
         (emit-condition output operand)
         (binary-push output 4 127)
         (if (= operator "and")
             (emit-short-circuit output expression (1+ index))
           (binary-push output 65 1))
         (binary-push output 5)
         (if (= operator "and")
             (binary-push output 65 0)
           (emit-short-circuit output expression (1+ index)))
         (binary-push output 11)))))

  (defun arithmetic-opcode (operator)
    (cond ((or (= operator "+") (= operator "1+")) 160)
          ((or (= operator "-") (= operator "1-")) 161)
          ((= operator "*") 162)
          (t 163)))

  (defun emit-arithmetic (output expression)
    (let* ((operator (get expression :value))
           (children (get expression :children))
           (count (js-length children)))
      (cond
        ((= count 0)
         (binary-push output 68)
         (float64-bytes output (if (= operator "*") 1 0)))
        ((and (= count 1) (= operator "-"))
         (emit-expression output (js-nth 0 children))
         (binary-push output 154))
        ((and (= count 1) (= operator "/"))
         (binary-push output 68)
         (float64-bytes output 1)
         (emit-expression output (js-nth 0 children))
         (binary-push output 163))
        (t
         (emit-expression output (js-nth 0 children))
         (cond
           ((= count 2)
            (emit-expression output (js-nth 1 children))
            (binary-push output (arithmetic-opcode operator)))
           ((or (= operator "1+") (= operator "1-"))
            (binary-push output 68)
            (float64-bytes output 1)
            (binary-push output (arithmetic-opcode operator))))))))

  (defun emit-word-arithmetic (output expression)
    (let* ((children (get expression :children)) (count (js-length children))
           (operator (get expression :value)))
      (cond
        ((= count 0) (binary-push output 65 (if (= operator "*") 1 0)))
        ((and (= count 1) (= operator "-"))
         (binary-push output 65 0) (emit-expression output (js-nth 0 children))
         (binary-push output 107))
        (t
         (emit-expression output (js-nth 0 children))
         (when (or (= count 2) (= operator "1+") (= operator "1-"))
           (if (= count 2) (emit-expression output (js-nth 1 children))
             (binary-push output 65 1))
           (binary-push output (cond ((or (= operator "+") (= operator "1+")) 106)
             ((or (= operator "-") (= operator "1-")) 107) (t 108))))))))

  (defun memory-access-width (name)
    (cond ((or (= name "load-u8") (= name "store-u8")) 1)
      ((or (= name "load-u16") (= name "store-u16")) 2)
      ((or (= name "load-u32") (= name "store-u32")) 4)
      ((or (= name "load-f64") (= name "store-f64")) 8) (t 0)))

  (defun memory-f64-unary-opcode (name)
    (cond ((= name "f64-abs") 153) ((= name "f64-neg") 154)
      ((= name "f64-ceil") 155) ((= name "f64-floor") 156)
      ((= name "f64-trunc") 157) ((= name "f64-nearest") 158)
      ((= name "f64-sqrt") 159) (t nil)))

  (defun require-memory-f64-unary (expression memory)
    (let ((children (get expression :children)))
      (unless (and memory (= (get expression :type) "f64")
                   (Array/isArray children) (= (js-length children) 1)
                   (not (nil? (js-nth 0 children)))
                   (= (value-type (js-nth 0 children)) "object")
                   (not (Array/isArray (js-nth 0 children)))
                   (Array/isArray (get (js-nth 0 children) :children))
                   (= (get (js-nth 0 children) :type) "f64"))
        (backend-fail expression "f64 unary memory opcode requires one f64 operand and result"))) expression)

  (defun require-memory-data-copy (expression memory)
    (let ((text (get expression :value)) (children (get expression :children)))
      (unless (and memory (= (get expression :type) "u32")
                   (= (value-type text) "string") (<= (js-length text) 2147483647)
                   (Array/isArray children) (= (js-length children) 1)
                   (not (nil? (js-nth 0 children)))
                   (= (value-type (js-nth 0 children)) "object")
                   (not (Array/isArray (js-nth 0 children)))
                   (Array/isArray (get (js-nth 0 children) :children))
                   (= (get (js-nth 0 children) :type) "u32"))
        (backend-fail expression "static UTF16 copy requires memory-u32, one word address and string data"))) expression)

  (defun require-wasm-expression-node (expression parent memory)
    (unless (and (not (nil? expression)) (= (value-type expression) "object")
                 (not (Array/isArray expression)))
      (backend-fail parent "typed WASM expression requires a node object"))
    ;; Check the parent contract before capability and scratch scans can read a
    ;; malformed destination. Its original span remains the refusal location.
    (when (= (get expression :kind) "memory-data-copy")
      (require-memory-data-copy expression memory))
    (when (and (= (get expression :kind) "memory-op")
               (memory-f64-unary-opcode (get expression :value)))
      (require-memory-f64-unary expression memory))
    (unless (Array/isArray (get expression :children))
      (backend-fail expression "typed WASM expression requires a children array"))
    expression)

  (defun copy-wasm-expression-node (expression parent memory)
    (require-wasm-expression-node expression parent memory)
    (let ((copy (Object/assign (js-object) expression)))
      (put copy :children (js-array)) copy))

  (defun same-wasm-expression-snapshot (left right)
    ;; Both operands are private Object.assign snapshots. Reading them cannot
    ;; repeat a source getter. Preserve every copied key, including symbols
    ;; and IEEE values, before sharing their completed child snapshots.
    (if (not (Object/is (Object/getPrototypeOf left) (Object/getPrototypeOf right))) false
      (let ((keys (js-call (Object/getOwnPropertyNames left) :concat (Object/getOwnPropertySymbols left)))
            (other (js-call (Object/getOwnPropertyNames right) :concat (Object/getOwnPropertySymbols right)))
            (index 0) (same t))
        (unless (= (js-length keys) (js-length other)) (setq same false))
        (while (and same (< index (js-length keys)))
          (let ((key (js-nth index keys)))
            (unless (Object/is key (js-nth index other)) (setq same false))
            (when same
              (if (Object/is key "children")
                (let ((children (get left :children)) (others (get right :children)) (position 0))
                  (unless (= (js-length children) (js-length others)) (setq same false))
                  (while (and same (< position (js-length children)))
                    (unless (Object/is (js-nth position children) (js-nth position others)) (setq same false))
                    (setq position (1+ position))))
                (unless (Object/is (get left key) (get right key)) (setq same false)))))
          (setq index (1+ index))) same)))

  (defun intern-wasm-expression (source copy first-copies alternatives)
    (if (not (js-call first-copies :has source))
      (progn (js-call first-copies :set source copy) copy)
      (let ((first (js-call first-copies :get source)))
        (if (same-wasm-expression-snapshot copy first) first
          (let ((others (js-call alternatives :get source)) (index 0) (found nil))
            (when others
              (while (and (not found) (< index (js-length others)))
                (let ((candidate (js-nth index others)))
                  (when (same-wasm-expression-snapshot copy candidate) (setq found candidate)))
                (setq index (1+ index))))
            (if found found
              (progn
                (unless others (setq others (js-array)) (js-call alternatives :set source others))
                (js-call others :push copy) copy)))))))

  (defun copy-wasm-expression (expression parent memory)
    (let* ((copy (copy-wasm-expression-node expression parent memory))
           (first-copies (new globalThis.Map)) (alternatives (new globalThis.Map))
           (pending (js-array (js-object :source expression :copy copy :position 0))))
      ;; A frame retains only the path being copied. Source strings and spans
      ;; remain shared read-only values; no JSON round trip loses IEEE values.
      ;; Visit every original occurrence in its original order, even in a DAG:
      ;; getters may return different snapshots or fail on a later occurrence.
      ;; Intern only completed, identical private snapshots within this one
      ;; function. Scratch indices are function-local; never share across them.
      (while (> (js-length pending) 0)
        (let* ((frame (js-nth (1- (js-length pending)) pending))
               (source (get frame :source)) (children (get source :children))
               (position (get frame :position)))
          (if (= position (js-length children))
              (let ((completed (intern-wasm-expression source (get frame :copy) first-copies alternatives)))
                (js-call pending :pop)
                (if (= (js-length pending) 0) (setq copy completed)
                  (let* ((previous (js-nth (1- (js-length pending)) pending))
                         (output (get (get previous :copy) :children)))
                    (put output (1- (get previous :position)) completed))))
            (let* ((child (js-nth position children))
                   (child-copy (copy-wasm-expression-node child source memory)))
              (put frame :position (1+ position))
              (js-call (get (get frame :copy) :children) :push child-copy)
              (js-call pending :push (js-object :source child :copy child-copy :position 0)))))) copy))

  (defun copy-typed-wasm-program (program)
    (unless (and (not (nil? program)) (= (value-type program) "object")
                 (not (Array/isArray program)))
      (backend-fail nil "typed WASM emitter requires a program object"))
    (let* ((functions (get program :functions)) (copies (js-array))
           (memory (= (get program :abi) "memory-u32"))
           (copy (Object/assign (js-object) program)) (index 0))
      (unless (Array/isArray functions)
        (backend-fail program "typed WASM emitter requires declared functions"))
      (while (< index (js-length functions))
        (let ((function (js-nth index functions)))
          (unless (and (not (nil? function)) (= (value-type function) "object")
                       (not (Array/isArray function)) (Array/isArray (get function :locals)))
            (backend-fail program "typed WASM function requires a locals array"))
          (let ((function-copy (Object/assign (js-object) function)))
            (put function-copy :locals (js-call (get function :locals) :slice))
            (put function-copy :body (copy-wasm-expression (get function :body) function memory))
            (js-call copies :push function-copy)))
        (setq index (1+ index)))
      (put copy :functions copies) copy))

  (defun has-memory-access-p (expression)
    ;; Private lowered nodes or completed public snapshots have plain fields;
    ;; source getters have already run for every occurrence before this scan.
    (or (and (= (get expression :kind) "memory-op") (> (memory-access-width (get expression :value)) 0))
      (js-call (get expression :children) :some has-memory-access-p)))
  (defun prepare-memory-scratch (function)
    ;; Keep indices local to the function even when fresh lowered functions
    ;; share an expression. Public typed entries still snapshot their input.
    ;; Every access uses the same three local slots. Retain the two possible
    ;; slot records once, rather than an occurrence list and a node-keyed map.
    (when (has-memory-access-p (get function :body))
      (let* ((locals (get function :locals)) (base (js-length locals)))
        (js-call locals :push (js-object :name "memory-address" :index base :type "u32")
          (js-object :name "memory-word" :index (1+ base) :type "u32")
          (js-object :name "memory-float" :index (+ base 2) :type "f64"))
        (js-object :word (js-object :addressLocal base :valueLocal (1+ base))
          :floating (js-object :addressLocal base :valueLocal (+ base 2))))))
  (defun memory-scratch-entry (output expression)
    (let ((scratch (get output :wasmMemoryScratch nil)))
      (if scratch (get scratch (if (= (get expression :value) "store-f64") "floating" "word")) expression)))
  (defun emit-memory-guard (output expression width)
    ;; Keep the evaluated address on the operand stack; scratch is only read
    ;; during this guard. u64 addition cannot wrap at the memory32 boundary.
    (let ((scratch (memory-scratch-entry output expression)))
      (binary-push output 34) (unsigned-leb output (get scratch :addressLocal))
      (binary-push output 32) (unsigned-leb output (get scratch :addressLocal)))
    (binary-push output 173 66 width 124 63 0 173 66 16 134 86 4 64)
    (emit-trapping-bytes output expression (js-array 0) t)
    (binary-push output 11))
  (defun emit-memory-op (output expression)
    (let ((children (get expression :children)) (name (get expression :value)) (i 0))
      (while (< i (js-length children))
        (emit-expression output (js-nth i children)) (setq i (1+ i)))
      (let ((width (memory-access-width name)) (store (= (js-length children) 2)))
        (when (> width 0)
          ;; Store RHS effects (including growth) finish before bounds testing.
          ;; Nested accesses finish before these shared temporaries are assigned.
          (when store (binary-push output 33)
            (unsigned-leb output (get (memory-scratch-entry output expression) :valueLocal)))
          (emit-memory-guard output expression width)
          (when store (binary-push output 32)
            (unsigned-leb output (get (memory-scratch-entry output expression) :valueLocal)))))
      (cond
        ((= name "load-u8") (binary-push output 45 0 0))
        ((= name "load-u16") (binary-push output 47 1 0))
        ((= name "load-u32") (binary-push output 40 2 0))
        ((= name "load-f64") (binary-push output 43 3 0))
        ((memory-f64-unary-opcode name) (binary-push output (memory-f64-unary-opcode name)))
        ((= name "store-f64") (binary-push output 57 3 0 65 0))
        ((= name "store-u8") (binary-push output 58 0 0 65 0))
        ((= name "store-u16") (binary-push output 59 1 0 65 0))
        ((= name "store-u32") (binary-push output 54 2 0 65 0))
        ((= name "memory-size") (binary-push output 63 0))
        ((= name "memory-grow") (binary-push output 64 0))
        ((= name "word-div") (emit-trapping-bytes output expression (js-array 110)))
        ((= name "word-shr") (binary-push output 118))
        ((= name "word-shl") (binary-push output 116))
        ((= name "word-and") (binary-push output 113))
        ((= name "word-or") (binary-push output 114))
        ((= name "word-xor") (binary-push output 115))
        (t (backend-fail expression "unknown memory32 opcode")))))

  (defun emit-memory-data-copy (output expression)
    (let ((text (get expression :value)) (children (get expression :children)))
      (require-memory-data-copy expression (get output :wasmMemory false))
      (let* ((texts (get output :wasmDataTexts)) (indices (get output :wasmDataIndices))
             (index (js-call indices :get text)) (instruction (js-array 252 8)))
        (unless (js-call indices :has text)
          (setq index (js-length texts))
          (js-call texts :push text) (js-call indices :set text index))
        ;; Passive segments remain immutable and reusable after earlier copies
        ;; are mutated. No character callbacks, imports or initializer IR exist.
        (emit-expression output (js-nth 0 children))
        (binary-push output 65 0 65)
        (signed-word-leb output (* 2 (js-length text)))
        (unsigned-leb instruction index) (js-call instruction :push 0)
        (emit-trapping-bytes output expression instruction)
        (binary-push output 65 0))))

  (defun data-uleb-size (value)
    (let ((size 1))
      (while (>= value 128)
        (setq value (unsigned-bit-shift-right value 7) size (1+ size))) size))

  (defun append-passive-data (output texts)
    ;; Write directly into the module buffer. A second byte-vector for a large
    ;; source literal would otherwise double the constant-data working set.
    (when (> (js-length texts) 0)
      (let ((size (data-uleb-size (js-length texts))) (index 0))
        (while (< index (js-length texts))
          (let ((length (* 2 (js-length (js-nth index texts)))))
            (setq size (+ size 1 (data-uleb-size length) length)))
          (setq index (1+ index)))
        (binary-push output 11) (unsigned-leb output size)
        (unsigned-leb output (js-length texts))
        (setq index 0)
        (while (< index (js-length texts))
          (let ((text (js-nth index texts)) (position 0))
            (binary-push output 1) (unsigned-leb output (* 2 (js-length text)))
            (while (< position (js-length text))
              (let ((unit (string-code-unit-at text position)))
                (binary-push output (bit-and unit 255) (unsigned-bit-shift-right unit 8)))
              (setq position (1+ position))))
          (setq index (1+ index))))) output)

  (defun append-trap-site-section (output sites)
    ;; These private records have fixed ASCII keys/string values and only
    ;; numeric/boolean scalars. Count and write bounded record JSON twice;
    ;; never construct the complete array string or a second payload buffer.
    ;; Public metadata strings still use their original UTF8 encoder below.
    (let ((name "eliscript-trap-sites") (length 2) (index 0))
      (while (< index (js-length sites))
        (setq length (+ length (js-length (JSON/stringify (js-nth index sites))) (if (> index 0) 1 0)))
        (setq index (1+ index)))
      (binary-byte output 0)
      (unsigned-leb output (+ (data-uleb-size (js-length name)) (js-length name)
        (data-uleb-size length) length))
      (utf8-name output name) (unsigned-leb output length)
      (binary-byte output 91)
      (setq index 0)
      (while (< index (js-length sites))
        (when (> index 0) (binary-byte output 44))
        (let ((text (JSON/stringify (js-nth index sites))) (position 0))
          (while (< position (js-length text))
            (binary-byte output (string-code-unit-at text position))
            (setq position (1+ position))))
        (setq index (1+ index)))
      (binary-byte output 93)) output)

  (defun emit-expression (output expression)
    (let ((range (debug-range-start output expression "expression")))
      (let ((result (emit-expression-body output expression)))
        (debug-range-end output range) result)))

  (defun emit-expression-body (output expression)
    (let ((kind (get expression :kind))
          (children (get expression :children))
          (value (get expression :value)))
      (cond
        ((= kind "memory-op") (emit-memory-op output expression))
        ((= kind "memory-data-copy") (emit-memory-data-copy output expression))
        ((= kind "word-arithmetic") (emit-word-arithmetic output expression))
        ((= kind "word-compare")
         (emit-expression output (js-nth 0 children))
         (emit-expression output (js-nth 1 children))
         (binary-push output (cond ((= value "=") 70) ((= value "/=") 71) ((= value "<") 73)
           ((= value ">") 75) ((= value "<=") 77) (t 79))))
        ((= kind "int-number")
         (emit-expression output (js-nth 0 children))
         (binary-push output 183))
        ((= kind "int-literal")
         (binary-push output 65) (signed-word-leb output value))
        ((or (= kind "int-add") (= kind "int-sub") (= kind "int-and"))
         (emit-expression output (js-nth 0 children))
         (emit-expression output (js-nth 1 children))
         (binary-push output (cond ((= kind "int-add") 106) ((= kind "int-sub") 107) (t 113))))
        ((= kind "int-compare")
         (emit-expression output (js-nth 0 children))
         (emit-expression output (js-nth 1 children))
         (binary-push output 72))
        ((= kind "ceil-int")
         (emit-expression output (js-nth 0 children))
         (binary-push output 155)
         (emit-trapping-bytes output expression (js-array 170)))
        ((= kind "literal")
         (cond
           ((= (get expression :type) "f64")
            (binary-push output 68) (float64-bytes output value))
           ((or (= (get expression :type) "u32") (= (get expression :type) "i32"))
            (binary-push output 65) (signed-word-leb output value))
           (t (binary-push output 65 value))))
        ((= kind "local") (binary-push output 32) (unsigned-leb output value))
        ((or (= kind "set") (= kind "initialize"))
         (emit-expression output (js-nth 0 children))
         (binary-push output 34)
         (unsigned-leb output value))
        ((= kind "sequence") (emit-sequence output children))
        ((= kind "arithmetic") (emit-arithmetic output expression))
        ((= kind "compare")
         (emit-expression output (js-nth 0 children))
         (emit-expression output (js-nth 1 children))
         (binary-push output
           (cond ((= value "=") 97) ((= value "/=") 98) ((= value "<") 99)
                 ((= value ">") 100) ((= value "<=") 101) (t 102))))
        ((= kind "not") (emit-condition output (js-nth 0 children))
         (binary-push output 69))
        ((= kind "if")
         (if (and (numeric-pure (js-nth 0 children))
                  (numeric-pure (js-nth 1 children)) (numeric-pure (js-nth 2 children))
                  (<= (+ (tree-size (js-nth 1 children)) (tree-size (js-nth 2 children))) 8))
             (progn
               (emit-expression output (js-nth 1 children))
               (emit-expression output (js-nth 2 children))
               (emit-condition output (js-nth 0 children))
               (binary-push output 27))
           (progn
             (emit-condition output (js-nth 0 children))
             (binary-push output 4 (result-byte (get expression :type)))
             (emit-expression output (js-nth 1 children))
             (binary-push output 5)
             (emit-expression output (js-nth 2 children))
             (binary-push output 11))))
        ((or (= kind "while") (= kind "remainder-while"))
         (emit-while output children)
         (binary-push output 65 0))
        ((= kind "guarded-while")
         (emit-guarded-while output children)
         (binary-push output 65 0))
        ((= kind "guarded-counter-while")
         (emit-counter-guarded-while output children)
         (binary-push output 65 0))
        ((or (= kind "and") (= kind "or")) (emit-short-circuit output expression 0))
        ((= kind "call")
         (let ((index 0))
           (while (< index (js-length children))
             (emit-expression output (js-nth index children))
             (setq index (1+ index))))
         (let ((instruction (js-array 16)))
           (unsigned-leb instruction (+ value (get output :wasmFunctionBase 0)))
           (emit-trapping-bytes output expression instruction)))
        ((= kind "host-call")
         (let ((index 0))
           (while (< index (js-length children))
             (emit-expression output (js-nth index children)) (setq index (1+ index))))
         (let ((instruction (js-array 16)))
           (unsigned-leb instruction (host-capability-index (get output :wasmHostCapabilities) expression))
           (emit-trapping-bytes output expression instruction)))
        ((= kind "call-indirect")
         (let ((index 0))
           (while (< index (js-length children))
             (emit-expression output (js-nth index children)) (setq index (1+ index))))
         (let ((instruction (js-array 17)))
           (unsigned-leb instruction (get expression :signatureIndex)) (js-call instruction :push 0)
           (emit-trapping-bytes output expression instruction)))
        (t (backend-fail expression (str "unknown typed WASM expression: " kind))))))

  (defun prepare-indirect-calls (expression arities enabled)
    (let ((children (get expression :children)) (index 0))
      (when (= (get expression :kind) "call-indirect")
        (let ((arity (get expression :value)) (signature 0))
          (unless (and enabled (= (value-type arity) "number") (= arity (uint32 arity))
                       (= (js-length children) (1+ arity)))
            (backend-fail expression "indirect calls require a memory-u32 table and an exact signature"))
          (while (and (< signature (js-length arities)) (/= (js-nth signature arities) arity))
            (setq signature (1+ signature)))
          (when (= signature (js-length arities)) (backend-fail expression "unknown indirect call signature"))
          (put expression :signatureIndex signature)))
      (while (< index (js-length children))
        (prepare-indirect-calls (js-nth index children) arities enabled) (setq index (1+ index)))) expression)

  (defun emit-typed-scalar-wasm (program options &optional debug consume-owned-bodies)
    (let* ((memory (= (get program :abi) "memory-u32"))
           (scalar-byte (if memory 127 124))
           (initial (get options :initialPages 1)) (maximum (get options :maximumPages 256))
           (functions (get program :functions)) (table (get program :table nil))
           (capabilities (prepare-host-capabilities program)) (host-count (js-length capabilities))
           (arities (js-array)) (type-indices (js-array))
           (types nil) (declarations nil) (imports nil)
           (exports nil) (bodies nil)
           (memory-scratch (js-array))
           (data-texts (js-array)) (data-indices (new globalThis.Map))
           (output nil) (index 0))
      (when memory
        (unless (and (= initial (uint32 initial)) (= maximum (uint32 maximum))
                     (>= initial 1) (<= initial maximum) (<= maximum 65535))
          (backend-fail program "memory32 requires 1 <= initialPages <= maximumPages <= 65535"))
        (when (find-function functions "memory")
          (backend-fail program "memory32 reserves the memory export name"))
        (let ((position 0))
          (while (< position (js-length functions))
            (js-call memory-scratch :push (prepare-memory-scratch (js-nth position functions)))
            (setq position (1+ position)))))
      (when debug
        (when (or (js-call (get program :exports) :includes "__eliscript_trap_site")
          (js-call (get program :aliases (js-array)) :some (lambda (item) (= (get item :name) "__eliscript_trap_site"))))
          (backend-fail program "debug WASM reserves the trap site export name"))
        (put debug :trapSites (js-array)))
      (while (< index (js-length functions))
        (let* ((arity (get (js-nth index functions) :arity))
               (position 0))
          (while (and (< position (js-length arities))
                      (/= (js-nth position arities) arity))
            (setq position (1+ position)))
          (when (= position (js-length arities)) (js-call arities :push arity))
          (js-call type-indices :push position))
        (setq index (1+ index)))
      (when table
        (unless (and memory (Array/isArray table)) (backend-fail program "WASM function tables require memory-u32 input"))
        (let ((position 0))
          (while (< position (js-length table))
            (let ((target (js-nth position table)))
              (unless (and (= (value-type target) "number") (= target (uint32 target)) (< target (js-length functions)))
                (backend-fail program "WASM table entry is not a declared function index")))
            (setq position (1+ position)))))
      ;; A declared capability may call through an empty table. Its signature
      ;; still belongs in the type section even without a matching local body.
      (let ((declared (if (object-has? program :indirectArities)
                          (get program :indirectArities nil) (js-array))) (position 0))
        (unless (and (Array/isArray declared) (or (= (js-length declared) 0) (and memory table)))
          (backend-fail program "indirect signature declarations require a memory-u32 table"))
        (while (< position (js-length declared))
          (let ((arity (js-nth position declared)) (signature 0))
            (unless (and (= (value-type arity) "number") (= arity (uint32 arity)) (<= arity 65535))
              (backend-fail program "invalid indirect signature arity"))
            (while (and (< signature (js-length arities)) (/= (js-nth signature arities) arity))
              (setq signature (1+ signature)))
            (when (= signature (js-length arities)) (js-call arities :push arity)))
          (setq position (1+ position))))
      (setq output (binary-output options))
      (setq types (binary-child output) declarations (binary-child output) imports (binary-child output)
        exports (binary-child output) bodies (binary-child output))
      (append-bytes output (js-array 0 97 115 109 1 0 0 0))
      (when (> host-count 0)
        (let ((signature 0))
          (while (and (< signature (js-length arities)) (/= (js-nth signature arities) 2))
            (setq signature (1+ signature)))
          (when (= signature (js-length arities)) (js-call arities :push 2))
          (unsigned-leb imports host-count)
          (let ((position 0))
            (while (< position host-count)
              (let ((capability (js-nth position capabilities)))
                (utf8-name imports (get capability :module))
                (utf8-name imports (get capability :name))
                (binary-push imports 0) (unsigned-leb imports signature))
              (setq position (1+ position))))))
      (setq index 0)
      (while (< index (js-length functions))
        (prepare-indirect-calls (get (js-nth index functions) :body) arities (and memory table))
        (setq index (1+ index)))
      (unsigned-leb types (js-length arities))
      (setq index 0)
      (while (< index (js-length arities))
        (binary-push types 96)
        (unsigned-leb types (js-nth index arities))
        (let ((parameter 0))
          (while (< parameter (js-nth index arities))
            (binary-push types scalar-byte)
            (setq parameter (1+ parameter))))
        (binary-push types 1 scalar-byte)
        (setq index (1+ index)))
      (unsigned-leb declarations (js-length functions))
      (setq index 0)
      (while (< index (js-length functions))
        (unsigned-leb declarations (js-nth index type-indices))
        (setq index (1+ index)))
      (unsigned-leb exports (+ (js-length (get program :exports)) (js-length (get program :aliases (js-array))) (if memory 1 0) (if debug 1 0)))
      (when memory (utf8-name exports "memory") (binary-push exports 2 0))
      (when debug (utf8-name exports "__eliscript_trap_site") (binary-push exports 3 0))
      (setq index 0)
      (while (< index (js-length (get program :exports)))
        (let ((name (js-nth index (get program :exports))))
          (utf8-name exports name)
          (binary-push exports 0)
          (unsigned-leb exports (+ host-count (get (find-function functions name) :index))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length (get program :aliases (js-array))))
        (let* ((alias (js-nth index (get program :aliases)))
               (function (find-function functions (get alias :function))))
          (unless function (backend-fail program "unknown WASM export alias target"))
          (utf8-name exports (get alias :name)) (binary-push exports 0) (unsigned-leb exports (+ host-count (get function :index))))
        (setq index (1+ index)))
      (unsigned-leb bodies (js-length functions))
      (setq index 0)
      (while (< index (js-length functions))
        (let* ((function (js-nth index functions))
               (body (binary-child output)) (locals (get function :locals))
               (count (- (js-length locals) (get function :arity)))
               (position (get function :arity))
               (range-start (if debug (js-length (get debug :ranges)) 0))
               (local-entries-start 0) (instructions-start 0))
          (put body :wasmFunctionBase host-count) (put body :wasmHostCapabilities capabilities)
          (put body :wasmMemory memory) (put body :wasmDataTexts data-texts)
          (when memory (put body :wasmMemoryScratch (js-nth index memory-scratch)))
          (put body :wasmDataIndices data-indices)
          (when debug
            (put body :wasmDebug (js-object :ranges (get debug :ranges) :depth 0
                                  :trapSites (get debug :trapSites)
                                  :function (get function :name) :functionIndex (+ host-count index))))
          ;; Each local is one declaration group. Indexing remains stable
          ;; across scopes; later grouping may reduce bytes without semantics.
          (unsigned-leb body count)
          (setq local-entries-start (js-length body))
          (while (< position (js-length locals))
            (binary-push body 1 (result-byte (get (js-nth position locals) :type)))
            (setq position (1+ position)))
          (setq instructions-start (js-length body))
          (emit-expression body (get function :body))
          (binary-push body 11)
          (let ((size-start (js-length bodies)))
            (unsigned-leb bodies (js-length body))
            (when debug
              (let* ((body-start (js-length bodies)) (body-end (+ body-start (js-length body)))
                     (source (get function :source nil)) (ranges (get debug :ranges)) (i range-start))
                (while (< i (js-length ranges))
                  (let ((range (js-nth i ranges)))
                    (put range :start (+ body-start (get range :start)))
                    (put range :end (+ body-start (get range :end))))
                  (setq i (1+ i)))
                (js-call (get debug :functions) :push
                  (js-object :name (get function :name) :index (+ host-count index)
                    :span (get function :span (if source (get source :span nil) nil))
                    :sizeField (js-object :start size-start :end body-start)
                    :body (js-object :start body-start :end body-end)
                    :locals (js-object :start body-start :entriesStart (+ body-start local-entries-start)
                              :end (+ body-start instructions-start) :count count)
                    :instructions (js-object :start (+ body-start instructions-start) :end body-end)))))
            (binary-append-owned bodies body))
          ;; Only the private managed product owns this fresh intermediate.
          ;; Every graph prepass and this function's complete debug record are
          ;; finished. Later sections use indices, locals, data strings and
          ;; recorded ranges, never the executable body again. Shared nodes
          ;; remain reachable through any later function that still uses them.
          (when consume-owned-bodies (put function :body nil)))
        (setq index (1+ index)))
      (section output 1 types)
      (when (> host-count 0) (section output 2 imports))
      (section output 3 declarations)
      (when table
        (let ((declaration (js-array 1 112 0)))
          (unsigned-leb declaration (js-length table)) (section output 4 declaration)))
      (when memory
        (let ((limits (js-array 1 1)))
          (unsigned-leb limits initial) (unsigned-leb limits maximum)
          (section output 5 limits)))
      (when debug (section output 6 (js-array 1 127 1 65 0 11)))
      (section output 7 exports)
      (when table
        (let ((elements (binary-child output)) (position 0))
          (append-bytes elements (js-array 1 0 65 0 11))
          (unsigned-leb elements (js-length table))
          (while (< position (js-length table))
            (unsigned-leb elements (+ host-count (js-nth position table))) (setq position (1+ position)))
          (section output 9 elements)))
      (when (> (js-length data-texts) 0)
        (let ((count (js-array)))
          (unsigned-leb count (js-length data-texts)) (section output 12 count)))
      (if debug
          (let ((section-start (js-length output)))
            (binary-push output 10)
            (unsigned-leb output (js-length bodies))
            (let ((payload-start (js-length output)) (ranges (get debug :ranges))
                  (mapped-functions (get debug :functions)) (i 0))
              (put debug :codeSection
                (js-object :id 10 :start section-start :payloadStart payload-start
                  :payloadSize (js-length bodies) :end (+ payload-start (js-length bodies))))
              (while (< i (js-length ranges))
                (let ((range (js-nth i ranges)))
                  (put range :start (+ payload-start (get range :start)))
                  (put range :end (+ payload-start (get range :end))))
                (setq i (1+ i)))
              (setq i 0)
              (while (< i (js-length mapped-functions))
                (let* ((function (js-nth i mapped-functions))
                       (fields (js-array "sizeField" "body" "locals" "instructions")) (j 0))
                  (while (< j (js-length fields))
                    (let ((range (get function (js-nth j fields))))
                      (put range :start (+ payload-start (get range :start)))
                      (put range :end (+ payload-start (get range :end)))
                      (when (= (js-nth j fields) "locals")
                        (put range :entriesStart (+ payload-start (get range :entriesStart)))))
                    (setq j (1+ j))))
                (setq i (1+ i))))
            (binary-append-owned output bodies))
        (progn
          (binary-push output 10) (unsigned-leb output (js-length bodies))
          (binary-append-owned output bodies)))
      ;; The complete code section has its final owner now. In the ordinary
      ;; array representation append is non-consuming too, so drop this private
      ;; local before constant data and optional trap metadata are assembled.
      (setq bodies nil)
      (append-passive-data output data-texts)
      (when debug
        (let ((sites (get debug :trapSites)) (index 0))
          (while (< index (js-length sites))
            (let ((site (js-nth index sites)))
              (put sites index (js-object :site (get site :site) :address (get site :start) :offsetBase "module"
                :functionIndex (get site :functionIndex) :returnAddress false)))
            (setq index (1+ index)))
          (append-trap-site-section output sites)))
      output))

  (defun make-wasm-validation-workspace ()
    (js-object :nodes (js-array) :positions (js-array)
      :seen (new globalThis.Set) :active (new globalThis.Set)))

  (defun validate-fresh-wasm-expression (expression parent memory &optional workspace)
    ;; This tree was just constructed by our lowerers, not supplied by a typed
    ;; API caller. Validate its entire graph without constructing a snapshot.
    (require-wasm-expression-node expression parent memory)
    (let* ((work (or workspace (make-wasm-validation-workspace)))
           (nodes (get work :nodes)) (positions (get work :positions))
           (seen (get work :seen)) (active (get work :active))
           (depth 1) (seen-count 0) (active-changes 0) (clear-index 0))
      ;; Reuse two depth arrays and both sets across functions. Clear any path
      ;; left by an earlier failed private validation before reusing the work.
      (while (< clear-index (js-length nodes))
        (put nodes clear-index nil) (setq clear-index (1+ clear-index)))
      (js-call seen :clear) (js-call active :clear)
      (put nodes 0 expression) (put positions 0 0)
      (js-call active :add expression)
      (while (> depth 0)
        (let* ((frame (1- depth))
               (node (js-nth frame nodes)) (children (get node :children))
               (position (js-nth frame positions)))
          (if (= position (js-length children))
            (progn
              (js-call active :delete node) (setq active-changes (1+ active-changes))
              ;; This is only a memo, not a validation limit. Forgetting old
              ;; completed nodes makes later DAG edges validate them again.
              (when (>= seen-count 65536) (js-call seen :clear) (setq seen-count 0))
              (js-call seen :add node) (setq seen-count (1+ seen-count))
              (put nodes frame nil) (setq depth frame))
            (let ((child (js-nth position children)))
              (require-wasm-expression-node child node memory)
              (put positions frame (1+ position))
              (when (js-call active :has child)
                (backend-fail child "typed WASM expression contains a cyclic child graph"))
              (unless (js-call seen :has child)
                (js-call active :add child)
                (setq active-changes (1+ active-changes))
                (put nodes depth child) (put positions depth 0) (setq depth (1+ depth)))))
          ;; The active set always contains the complete current path. Rebuild
          ;; it periodically so deleted entries cannot accumulate tombstones
          ;; over a wide graph; its required live size remains the path depth.
          (when (>= active-changes 4096)
            (js-call active :clear)
            (let ((index 0))
              (while (< index depth)
                (js-call active :add (js-nth index nodes)) (setq index (1+ index))))
            (setq active-changes 0))))) expression)

  (defun validate-fresh-typed-wasm-program (program)
    (unless (and (not (nil? program)) (= (value-type program) "object")
                 (not (Array/isArray program)))
      (backend-fail nil "typed WASM emitter requires a program object"))
    (let ((functions (get program :functions)) (memory (= (get program :abi) "memory-u32"))
          (workspace (make-wasm-validation-workspace)) (index 0))
      (unless (Array/isArray functions)
        (backend-fail program "typed WASM emitter requires declared functions"))
      (while (< index (js-length functions))
        (let ((function (js-nth index functions)))
          (unless (and (not (nil? function)) (= (value-type function) "object")
                       (not (Array/isArray function)) (Array/isArray (get function :locals)))
            (backend-fail program "typed WASM function requires a locals array"))
          (validate-fresh-wasm-expression (get function :body) function memory workspace))
        (setq index (1+ index)))) program)

  (defun emit-fresh-managed-wasm-product (lowered configure)
    ;; Only the source-IR entries below can call this with their actual fresh
    ;; lowering result. The callback receives no typed data and cannot supply
    ;; a replacement or mark caller-owned typed input as trusted.
    (unless (= (value-type configure) "function")
      (backend-fail nil "managed WASM product requires an output configuration callback"))
    (let* ((configuration (funcall configure))
           (typed (validate-fresh-typed-wasm-program (get lowered :typed)))
           (memory (or (get configuration :memory nil) (js-object)))
           (debug (when (= (get configuration :debug false) t)
             (js-object :format "eliscript-wasm-source-map" :version 1
               :target "wasm32" :abi "memory-u32" :offsetUnit "byte" :offsetBase "module"
               :functions (js-array) :ranges (js-array))))
           (descriptor (get lowered :descriptor))
           (output (append-metadata-section (emit-typed-scalar-wasm typed memory debug t)
                     "eliscript-managed-control" (JSON/stringify descriptor)))
           (bytes (binary-finish output))
           (product (js-object :bytes bytes :descriptor descriptor)))
      (when debug (put debug :moduleByteLength (binary-length bytes)) (put product :debug debug)) product))

  (defun managed-wasm-product-fail (node message &optional phase)
    (try (backend-fail node message)
      (catch error (put (get error :eliscriptDiagnostic) :phase (or phase "managed-backend")) (throw error))))

  (defun emit-managed-ir-wasm-product (program runtime-program lower-options configure)
    (let* ((options (or lower-options (js-object)))
           (requested (get options :abi nil))
           (lowered (lower-managed-program program runtime-program
             (= requested "managed-module-v1") nil nil nil nil nil nil
             (get options :literalModules nil))))
      (when (and (not (nil? requested))
                 (not (or (= requested "managed-control-v1") (= requested "managed-module-v1"))))
        (managed-wasm-product-fail program "unknown managed ABI"))
      (when (and (not (nil? requested)) (not (= requested (get (get lowered :descriptor) :abi))))
        (managed-wasm-product-fail program "top-level bindings require managed-module-v1"))
      (emit-fresh-managed-wasm-product lowered configure)))

  (defun emit-managed-project-wasm-product (modules entry runtime-program lower-options configure)
    (let* ((requested (get (or lower-options (js-object)) :abi nil))
           (lowered (lower-managed-project modules entry runtime-program lower-options)))
      (when (and (not (nil? requested)) (not (= requested "managed-module-v1")))
        (managed-wasm-product-fail nil "managed projects require managed-module-v1" "managed-link"))
      (emit-fresh-managed-wasm-product lowered configure)))

  (defun emit-typed-numeric-wasm (program &optional options)
    (unless (= (get program :abi) "numeric-f64")
      (backend-fail program "WASM emitter requires numeric-f64 typed input"))
    (binary-finish (emit-typed-scalar-wasm (copy-typed-wasm-program program) (or options (js-object)))))

  (defun emit-memory-wasm (program &optional options)
    ;; Memory effects and traps are retained; numeric-only optimizations do not
    ;; apply to this explicit internal word ABI.
    (binary-finish (emit-typed-scalar-wasm (lower-memory-program program) (or options (js-object)))))

  (defun emit-typed-memory-wasm (program &optional options)
    (unless (= (get program :abi) "memory-u32") (backend-fail program "typed memory emitter requires memory-u32"))
    (binary-finish (emit-typed-scalar-wasm (copy-typed-wasm-program program) (or options (js-object)))))
  (defun emit-typed-memory-wasm-artifact (program &optional options)
    (unless (= (get program :abi) "memory-u32")
      (backend-fail program "typed memory emitter requires memory-u32"))
    (let* ((debug (js-object :format "eliscript-wasm-source-map" :version 1
                    :target "wasm32" :abi "memory-u32" :offsetUnit "byte" :offsetBase "module"
                    :functions (js-array) :ranges (js-array)))
           (bytes (emit-typed-scalar-wasm (copy-typed-wasm-program program) (or options (js-object)) debug)))
      (put debug :moduleByteLength (js-length bytes))
      (js-object :bytes (binary-finish bytes) :debug debug)))

  (defun append-metadata-section (bytes name value)
    (let* ((finished (= (get bytes :encoding nil) "u16le-chunks"))
           (output (binary-resume bytes)) (payload (binary-child output)))
      (utf8-name payload name) (utf8-name payload value) (section output 0 payload)
      (if finished (binary-finish output) output)))

  (defun emit-numeric-wasm (program &optional options)
    ;; Validate the complete input, including unselected branches, first.
    (lower-numeric-program program)
    (emit-typed-numeric-wasm (optimize-numeric-program
      (lower-numeric-program (optimize-program program)) (js-object :constantFlow t :unswitch t :countedGuards t)) options))

  (export emit-numeric-wasm emit-typed-numeric-wasm emit-memory-wasm emit-typed-memory-wasm emit-typed-memory-wasm-artifact
    emit-managed-ir-wasm-product emit-managed-project-wasm-product append-metadata-section))
