                      (typed "literal" "f64" (js-array) 0)) ">="))
                    (js-call guards :push (typed "compare" "i32" (js-array bound
                      (typed "literal" "f64" (js-array) 2147483647)) "<=")))
                  (js-call prelude :push (typed "initialize" "i32"
                    (js-array (typed "ceil-int" "i32" (js-array bound) nil)) (get entry :limit)))
                  (put entry :depth (counter-depth body index 0))
