(module eliscript.backend.numeric
  ;; Explicit numeric-f64 ABI: required Number arguments and Number results.
  ;; This is a typed vertical slice, not a replacement for the dynamic runtime.
  (defun backend-fail (node message)
    (let* ((record (or node (js-object)))
           (span (or (get record :span nil) (js-object))))
      (throw
        (js-object
          :message message
          :eliscriptDiagnostic
          (js-object :format "eliscript-diagnostic" :version 1
            :code "ELI-B0001" :severity "error" :phase "numeric-backend"
            :message message
            :location (js-object :file (get span :filename (get record :filename "<ir>"))
              :start (js-object :line (get span :line 1)
                :column (get span :column 1))))))))

  (defun find-local (scope name)
    (let ((index (1- (js-length scope))) (found nil))
      (while (and (>= index 0) (not found))
        (let ((entry (js-nth index scope)))
          (when (= (get entry :name) name) (setq found entry)))
        (setq index (1- index)))
      found))

  (defun find-function (functions name)
    (let ((index 0) (found nil))
      (while (and (< index (js-length functions)) (not found))
        (when (= (get (js-nth index functions) :name) name)
          (setq found (js-nth index functions)))
        (setq index (1+ index)))
      found))

  (defun typed (kind type children value)
    (js-object :kind kind :type type :children children :value value))

  (defun require-type (original expression type)
    (unless (= (get expression :type) type)
      (backend-fail original (str "numeric-f64 ABI requires " type " operands")))
    expression)

  (defun typed-sequence (nodes scope state functions)
    (let ((result (js-array)) (index 0) (type "i32"))
      (while (< index (js-length nodes))
        (let ((expression (lower-expression (js-nth index nodes) scope state functions)))
          (setq type (get expression :type))
          (js-call result :push expression))
        (setq index (1+ index)))
      (typed "sequence" type result nil)))

  (defun new-local (state name type)
    (let* ((locals (get state :locals))
           (entry (js-object :name name :type type :index (js-length locals))))
      (js-call locals :push entry)
      entry))

  (defun lower-bindings (node scope state functions)
    (let* ((properties (get node :properties))
           (count (get properties :bindingCount))
           (children (get node :children))
           (inner (js-call scope :slice))
           (initializers (js-array))
           (pending (js-array))
           (index 0))
      (while (< index count)
        (let ((binding (js-nth index children)))
          (unless (and (= (get binding :kind) "lexical-binding")
                       (= (js-length (get binding :children)) 1))
            (backend-fail binding "numeric-f64 ABI requires simple initialized bindings"))
          (when (find-local pending (get binding :value))
            (backend-fail binding "duplicate lexical binding"))
          (let* ((init (lower-expression (js-nth 0 (get binding :children))
                         (if (get properties :sequential) inner scope) state functions))
                 (local (new-local state (get binding :value) (get init :type))))
            (js-call initializers :push (typed "initialize" (get init :type) (js-array init)
                                         (get local :index)))
            (js-call pending :push local)
            (when (get properties :sequential) (js-call inner :push local))))
        (setq index (1+ index)))
      (unless (get properties :sequential)
        (let ((index 0))
          (while (< index (js-length pending))
            (js-call inner :push (js-nth index pending))
            (setq index (1+ index)))))
      (let ((body (typed-sequence (js-call children :slice count) inner state functions)))
        (js-call initializers :push body)
        (typed "sequence" (get body :type) initializers nil))))

  (defun lower-expression (node scope state functions)
    (let ((kind (get node :kind)) (value (get node :value))
          (children (get node :children)))
      (cond
        ((and (= kind "literal") (not (get node :properties nil)))
         (cond ((= (value-type value) "number") (typed "literal" "f64" (js-array) value))
               ((or (= (value-type value) "boolean") (nil? value))
                (typed "literal" "i32" (js-array) (if value 1 0)))
               (t (backend-fail node "numeric-f64 ABI does not support this literal"))))
        ((= kind "reference")
         (let ((local (find-local scope value)))
           (unless local (backend-fail node (str "unknown numeric local: " value)))
           (typed "local" (get local :type) (js-array) (get local :index))))
        ((= kind "lexical-bindings") (lower-bindings node scope state functions))
        ((= kind "sequence") (typed-sequence children scope state functions))
        ((= kind "assignment")
         (let ((assignments (js-array)) (index 0) (type "i32"))
           (while (< index (js-length children))
             (let* ((pair (js-nth index children))
                    (local (find-local scope (get pair :value))))
               (unless (and (= (get pair :kind) "assignment-pair") local)
                 (backend-fail pair "assignment must address an existing numeric local"))
               (let ((rhs (lower-expression (js-nth 0 (get pair :children)) scope state functions)))
                 (require-type pair rhs (get local :type))
                 (setq type (get rhs :type))
                 (js-call assignments :push
                   (typed "set" type (js-array rhs) (get local :index)))))
             (setq index (1+ index)))
           (typed "sequence" type assignments nil)))
        ((and (= kind "loop") (= value "while"))
         (typed "while" "i32"
           (js-array (lower-expression (js-nth 0 children) scope state functions)
             (typed-sequence (js-call children :slice 1) scope state functions)) nil))
        ((and (= kind "conditional") (= (js-length children) 3))
         (let* ((condition (lower-expression (js-nth 0 children) scope state functions))
                (yes (lower-expression (js-nth 1 children) scope state functions))
                (no (lower-expression (js-nth 2 children) scope state functions)))
           (require-type node no (get yes :type))
           (typed "if" (get yes :type) (js-array condition yes no) nil)))
        ((and (= kind "short-circuit")
              (or (= value "and") (= value "or"))
              (> (js-length children) 0))
         (let ((operands (js-array)) (index 0) (type nil))
           (while (< index (js-length children))
             (let ((operand (lower-expression (js-nth index children) scope state functions)))
               (if type (require-type node operand type) (setq type (get operand :type)))
               (js-call operands :push operand))
             (setq index (1+ index)))
           (typed value type operands nil)))
        ((= kind "intrinsic")
         (let ((operands (js-array)) (index 0))
           (while (< index (js-length children))
             (js-call operands :push (lower-expression (js-nth index children) scope state functions))
             (setq index (1+ index)))
           (cond
             ((and (= value "not") (= (js-length operands) 1))
              (typed "not" "i32" operands nil))
             ((and (or (= value "+") (= value "-") (= value "*") (= value "/"))
                   (<= (js-length operands) 2)
                   (or (> (js-length operands) 0) (= value "+") (= value "*")))
              (let ((index 0))
                (while (< index (js-length operands))
                  (require-type node (js-nth index operands) "f64")
                  (setq index (1+ index))))
              (typed "arithmetic" "f64" operands value))
             ((and (or (= value "1+") (= value "1-")) (= (js-length operands) 1))
              (require-type node (js-nth 0 operands) "f64")
              (typed "arithmetic" "f64" operands value))
             ((and (or (= value "=") (= value "<") (= value "<=")
                       (= value ">") (= value ">=")) (= (js-length operands) 2))
              (require-type node (js-nth 0 operands) "f64")
              (require-type node (js-nth 1 operands) "f64")
              (typed "compare" "i32" operands value))
             (t (backend-fail node (str "unsupported numeric intrinsic: " value))))))
        ((and (= kind "call") (> (js-length children) 0)
              (= (get (js-nth 0 children) :kind) "reference"))
         (let* ((name (get (js-nth 0 children) :value))
                (function (find-function functions name))
                (arguments (js-array)) (index 1))
           (when (find-local scope name)
             (backend-fail node "numeric calls cannot resolve a shadowed function"))
           (unless function (backend-fail node (str "unknown numeric function: " name)))
           (unless (= (1- (js-length children)) (get function :arity))
             (backend-fail node "numeric call arity mismatch"))
           (while (< index (js-length children))
             (js-call arguments :push
               (require-type node (lower-expression (js-nth index children) scope state functions) "f64"))
             (setq index (1+ index)))
           (typed "call" "f64" arguments (get function :index))))
        (t (backend-fail node (str "unsupported numeric IR: " kind ":" value))))))

  (defun collect-declarations (nodes declarations)
    (let ((index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (if (= (get node :kind) "module-declaration")
              (collect-declarations (get node :children) declarations)
            (js-call declarations :push node)))
        (setq index (1+ index))))
    declarations)

  (defun lower-numeric-program (program)
    (let ((functions (js-array)) (exports (js-array))
          (nodes (collect-declarations (get program :body) (js-array)))
          (index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (cond
            ((= (get node :kind) "export-declaration")
             (let ((position 0))
               (while (< position (js-length (get node :children)))
                 (let ((child (js-nth position (get node :children))))
                   (unless (= (get child :kind) "reference")
                     (backend-fail child "numeric exports require named functions"))
                   (js-call exports :push (get child :value)))
                 (setq position (1+ position)))))
            ((and (= (get node :kind) "function-declaration")
                  (not (get (get node :properties) :async)))
             (when (find-function functions (get node :value))
               (backend-fail node "duplicate numeric function"))
             (js-call functions :push
               (js-object :name (get node :value) :index (js-length functions)
                 :arity (get (get node :properties) :parameterCount) :source node)))
            (t (backend-fail node "numeric-f64 ABI requires synchronous functions and exports"))))
        (setq index (1+ index)))
      (when (= (js-length functions) 0)
        (backend-fail program "numeric-f64 ABI requires at least one function"))
      (setq index 0)
      (while (< index (js-length functions))
        (let* ((function (js-nth index functions))
               (node (get function :source))
               (children (get node :children))
               (arity (get function :arity))
               (state (js-object :locals (js-array)))
               (scope (js-array)) (position 0))
          (while (< position arity)
            (let ((parameter (js-nth position children)))
              (unless (and (= (get parameter :kind) "parameter-binding")
                           (= (get (get parameter :properties) :parameterKind) "required")
                           (not (find-local scope (get parameter :value))))
                (backend-fail parameter "numeric-f64 ABI requires distinct required parameters"))
              (js-call scope :push (new-local state (get parameter :value) "f64")))
            (setq position (1+ position)))
          (let ((body (typed-sequence (js-call children :slice arity) scope state functions)))
            (require-type node body "f64")
            (put function :body body)
            (put function :locals (get state :locals))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length exports))
        (unless (find-function functions (js-nth index exports))
          (backend-fail program (str "unknown numeric export: " (js-nth index exports))))
        (let ((prior 0))
          (while (< prior index)
            (when (= (js-nth prior exports) (js-nth index exports))
              (backend-fail program "duplicate numeric export"))
            (setq prior (1+ prior))))
        (setq index (1+ index)))
      (js-object :abi "numeric-f64" :filename (get program :filename)
        :functions functions :exports exports)))

  (defun tree-size (node)
    (let ((size 1) (children (get node :children)) (index 0))
      (while (< index (js-length children))
        (setq size (+ size (tree-size (js-nth index children))))
        (setq index (1+ index)))
      size))

  (defun contains-kind (node kind)
    (let ((found (or (= (get node :kind) kind)
                    (and (= kind "while") (or (= (get node :kind) "remainder-while")
                                              (= (get node :kind) "guarded-while"))))) (index 0))
      (while (and (not found) (< index (js-length (get node :children))))
        (setq found (contains-kind (js-nth index (get node :children)) kind))
        (setq index (1+ index)))
      found))

  (defun writes-local (node local)
    (let ((count (if (and (or (= (get node :kind) "set") (= (get node :kind) "initialize"))
                           (= (get node :value) local)) 1 0))
          (index 0))
      (while (< index (js-length (get node :children)))
        (setq count (+ count (writes-local (js-nth index (get node :children)) local)))
        (setq index (1+ index)))
      count))

  (defun numeric-pure (node)
    (let ((kind (get node :kind)) (index 0) (pure t))
      (unless (or (= kind "literal") (= kind "local") (= kind "arithmetic")
                  (= kind "compare") (= kind "not") (= kind "int-number")
                  (= kind "int-literal") (= kind "int-add") (= kind "int-sub") (= kind "int-and")
                  (= kind "int-compare"))
        (setq pure nil))
      (while (and pure (< index (js-length (get node :children))))
        (setq pure (numeric-pure (js-nth index (get node :children))))
        (setq index (1+ index)))
      pure))

  (defun copy-offset (node offset aliases)
    (let* ((kind (get node :kind)) (value (get node :value))
           (children (js-array)) (index 0))
      (while (< index (js-length (get node :children)))
        (js-call children :push (copy-offset (js-nth index (get node :children)) offset aliases))
        (setq index (1+ index)))
      (if (and (= kind "local") (< value (js-length aliases)) (js-nth value aliases))
          (js-nth value aliases)
        (typed kind (get node :type) children
          (if (or (= kind "local") (= kind "set") (= kind "initialize")) (+ offset value) value)))))

  (defun inline-numeric-node (node functions locals)
    (let ((children (js-array)) (index 0))
      (while (< index (js-length (get node :children)))
        (js-call children :push (inline-numeric-node (js-nth index (get node :children)) functions locals))
        (setq index (1+ index)))
      (if (= (get node :kind) "call")
          (let* ((callee (js-nth (get node :value) functions))
                 (body (get callee :body)))
            ;; Leaf-only expansion excludes both direct and mutual recursion.
            (if (and (not (contains-kind body "call"))
                     (<= (tree-size body) (get callee :inlineLimit 128)))
                (let ((offset (js-length locals)) (aliases (js-array))
                      (sequence (js-array)) (pure t) (index 0))
                  (while (< index (js-length children))
                    (unless (numeric-pure (js-nth index children)) (setq pure nil))
                    (setq index (1+ index)))
                  (setq index 0)
                  (while (< index (js-length (get callee :locals)))
                    (let ((entry (js-nth index (get callee :locals))))
                      (js-call locals :push (js-object :name (get entry :name)
                        :index (js-length locals) :type (get entry :type))))
                    (setq index (1+ index)))
                  (setq index 0)
                  (while (< index (get callee :arity))
                    (let* ((argument (js-nth index children))
                           (alias (and pure (= (writes-local body index) 0)
                             (or (= (get argument :kind) "local") (= (get argument :kind) "literal")))))
                      (js-call aliases :push (if alias argument nil))
                      (unless alias (js-call sequence :push
                        (typed "initialize" "f64" (js-array argument) (+ offset index)))))
                    (setq index (1+ index)))
                  (js-call sequence :push (copy-offset body offset aliases))
                  (typed "sequence" "f64" sequence nil))
              (typed "call" "f64" children (get node :value))))
        (typed (get node :kind) (get node :type) children (get node :value)))))

  (defun loop-invariant (node loop)
    (let ((kind (get node :kind)) (index 0) (invariant (numeric-pure node)))
      (when (and (= kind "local") (> (writes-local loop (get node :value)) 0))
        (setq invariant nil))
      (while (and invariant (< index (js-length (get node :children))))
        (setq invariant (loop-invariant (js-nth index (get node :children)) loop))
        (setq index (1+ index)))
      invariant))

  (defun lift-invariants (node loop prelude)
    (if (and (= (get node :kind) "initialize")
             (= (writes-local loop (get node :value)) 1)
             (loop-invariant (js-nth 0 (get node :children)) loop))
        (progn
          ;; Lexical locals are initialized before reads. Only pure RHSs
          ;; assigned at one site may move; calls and nontermination stay put.
          (js-call prelude :push node)
          (typed "local" (get node :type) (js-array) (get node :value)))
      (let ((children (js-array)) (index 0))
        (while (< index (js-length (get node :children)))
          (js-call children :push (lift-invariants (js-nth index (get node :children)) loop prelude))
          (setq index (1+ index)))
        (typed (get node :kind) (get node :type) children (get node :value)))))

  (defun optimize-numeric-loops (node)
    (let ((children (js-array)) (index 0))
      (while (< index (js-length (get node :children)))
        (js-call children :push (optimize-numeric-loops (js-nth index (get node :children))))
        (setq index (1+ index)))
      (let ((copy (typed (get node :kind) (get node :type) children (get node :value))))
        (if (= (get copy :kind) "while")
            (let* ((prelude (js-array)) (lifted (lift-invariants copy copy prelude)))
              (js-call prelude :push lifted)
              (typed "sequence" (get copy :type) prelude nil))
          copy))))

  (defun square-local (node)
    (if (and (= (get node :kind) "arithmetic") (= (get node :value) "*")
             (= (js-length (get node :children)) 2)
             (= (get (js-nth 0 (get node :children)) :kind) "local")
             (= (get (js-nth 1 (get node :children)) :kind) "local")
             (= (get (js-nth 0 (get node :children)) :value)
                (get (js-nth 1 (get node :children)) :value)))
        (get (js-nth 0 (get node :children)) :value) -1))

  (defun square-uses (node local)
    (let ((count (if (= (square-local node) local) 1 0)) (index 0))
      (while (< index (js-length (get node :children)))
        (setq count (+ count (square-uses (js-nth index (get node :children)) local)))
        (setq index (1+ index)))
      count))

  (defun pure-conjunction (node)
    (if (= (get node :kind) "and")
        (let ((pure t) (index 0))
          (while (and pure (< index (js-length (get node :children))))
            (setq pure (pure-conjunction (js-nth index (get node :children))))
            (setq index (1+ index)))
          pure)
      (numeric-pure node)))

  (defun collect-squares (node body caches locals)
    (let ((local (square-local node)) (index 0))
      (when (and (>= local 0) (> (square-uses body local) 0)
                 (not (find-local caches (str local))))
        (js-call caches :push (js-object :name (str local) :operand local
          :storage (js-length locals) :ready nil))
        (js-call locals :push (js-object :name "cached-square" :index (js-length locals) :type "f64"
          :pureGuardCache t)))
      (while (< index (js-length (get node :children)))
        (collect-squares (js-nth index (get node :children)) body caches locals)
        (setq index (1+ index)))))

  (defun clear-square-caches (caches local)
    (let ((index 0))
      (while (< index (js-length caches))
        (when (or (< local 0) (= (get (js-nth index caches) :operand) local))
          (put (js-nth index caches) :ready nil))
        (setq index (1+ index)))))

  (defun reuse-squares (node caches condition)
    (let* ((kind (get node :kind)) (value (get node :value))
           (local (square-local node))
           (cache (if (>= local 0) (find-local caches (str local)) nil)))
      (if (and cache (get cache :ready))
          (typed "local" "f64" (js-array) (get cache :storage))
        (let ((children (js-array)) (index 0))
          ;; Only a pure conjunction's successful path dominates the body.
          ;; Branches, nested loops and calls conservatively end availability.
          (when (or (= kind "if") (= kind "while") (= kind "remainder-while") (= kind "or"))
            (clear-square-caches caches -1))
          (while (< index (js-length (get node :children)))
            (js-call children :push (reuse-squares (js-nth index (get node :children)) caches condition))
            (setq index (1+ index)))
          (let ((copy (typed kind (get node :type) children value)))
            (when (or (= kind "set") (= kind "initialize")) (clear-square-caches caches value))
            (when (or (= kind "if") (= kind "while") (= kind "remainder-while") (= kind "or") (= kind "call"))
              (clear-square-caches caches -1))
            (if (and cache condition)
                (progn (put cache :ready t)
                  (typed "set" "f64" (js-array copy) (get cache :storage)))
              copy))))))

  (defun optimize-loop-squares (node locals)
    (let ((children (js-array)) (index 0))
      (while (< index (js-length (get node :children)))
        (js-call children :push (optimize-loop-squares (js-nth index (get node :children)) locals))
        (setq index (1+ index)))
      (if (and (or (= (get node :kind) "while") (= (get node :kind) "remainder-while"))
               (pure-conjunction (js-nth 0 children)))
          (let ((caches (js-array)))
            (collect-squares (js-nth 0 children) (js-nth 1 children) caches locals)
            (let ((condition (reuse-squares (js-nth 0 children) caches t)))
              (typed (get node :kind) "i32" (js-array condition
                (reuse-squares (js-nth 1 children) caches nil)) nil)))
        (typed (get node :kind) (get node :type) children (get node :value)))))

  (defun optimize-numeric-program (program &optional options)
    (unless (= (get program :abi nil) "numeric-f64")
      (backend-fail program "numeric optimization requires validated numeric-f64 input"))
    (let* ((functions (get program :functions))
           (inline-functions (prepare-nested-callees functions options))
           (output (js-array)) (index 0))
      (while (< index (js-length functions))
        (let* ((function (js-nth index functions))
               (locals (js-call (get function :locals) :slice))
               (body (get function :body)))
          (when (get (or options (js-object)) :inlining t)
            (setq body (inline-numeric-node body inline-functions locals)))
          (when (get (or options (js-object)) :loops t)
            (setq body (optimize-loop-squares (optimize-numeric-loops body) locals)))
          (when (get (or options (js-object)) :integers t)
            (setq body (specialize-integer-locals body locals (get function :arity))))
          (when (and (get (or options (js-object)) :inlining t)
                     (get (or options (js-object)) :parallel t))
            (setq body (parallelize-call-loop (get function :body) functions locals
                         (get function :arity) body (get (or options (js-object)) :parallelSingle nil))))
          (when (get (or options (js-object)) :cyclicMultiple nil)
            (setq body (specialize-cyclic-locals body locals)))
          (when (get (or options (js-object)) :guardedUnroll t)
            (setq body (expand-compound-loops body locals)))
          (when (get (or options (js-object)) :constantFlow nil)
            (let ((reads (js-array)))
              (setq body (fold-constant-flow body (js-array)))
              (collect-flow-reads body reads)
              (setq body (remove-unread-stores body reads))))
          (when (get (or options (js-object)) :unswitch nil)
            (setq body (unswitch-numeric-loops body)))
          (js-call output :push (js-object :name (get function :name)
            :index (get function :index) :arity (get function :arity)
            :source (get function :source) :locals locals :body body)))
        (setq index (1+ index)))
      (js-object :abi "numeric-f64" :filename (get program :filename)
        :exports (get program :exports) :functions output)))

  (defun loop-depth (node depth)
    (let ((best depth) (index 0)
          (next (if (or (= (get node :kind) "while") (= (get node :kind) "remainder-while")
                        (= (get node :kind) "guarded-while")) (1+ depth) depth)))
      (while (< index (js-length (get node :children)))
        (let ((candidate (loop-depth (js-nth index (get node :children)) next)))
          (when (> candidate best) (setq best candidate)))
        (setq index (1+ index)))
      best))

  (defun prepare-nested-callees (functions options)
    (let ((prepared (js-array)) (index 0))
      (while (< index (js-length functions))
        (let* ((function (js-nth index functions)) (body (get function :body)))
          (if (and (get (or options (js-object)) :inlining t)
                   (not (contains-kind body "call")) (>= (loop-depth body 0) 2)
                   (<= (tree-size body) 128))
              (let ((locals (js-call (get function :locals) :slice)))
                ;; Narrow invariant callee parameters before caller expansion;
                ;; a caller may supply a computed bound that changes between
                ;; calls but is invariant throughout each nested callee loop.
                (when (get (or options (js-object)) :loops t)
                  (setq body (optimize-loop-squares (optimize-numeric-loops body) locals)))
                (when (get (or options (js-object)) :integers t)
                  (setq body (specialize-integer-locals body locals (get function :arity))))
                (js-call prepared :push (js-object :name (get function :name)
                  :arity (get function :arity) :index (get function :index)
                  :locals locals :body body :inlineLimit 512)))
            (js-call prepared :push function)))
        (setq index (1+ index)))
      prepared))

  (defun flatten-statements (node output)
    (if (= (get node :kind) "sequence")
        (let ((index 0))
          (while (< index (js-length (get node :children)))
            (flatten-statements (js-nth index (get node :children)) output)
            (setq index (1+ index))))
      (js-call output :push node))
    output)

  (defun scalar-pure-value (node)
    (if (or (= (get node :kind) "if") (= (get node :kind) "and")
            (= (get node :kind) "or") (= (get node :kind) "sequence"))
        (let ((pure t) (index 0))
          (while (and pure (< index (js-length (get node :children))))
            (setq pure (scalar-pure-value (js-nth index (get node :children))))
            (setq index (1+ index)))
          pure)
