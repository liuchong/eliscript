         (typed "int-literal" "i32" (js-array) 1)) nil))
      ((= (get node :kind) "if")
       (let* ((condition (js-nth 0 (get node :children)))
              (yes (integer-value (js-nth 1 (get node :children))))
              (no (integer-value (js-nth 2 (get node :children)))))
         (if (and (= (get condition :kind) "int-compare")
                  (= (get condition :value) "<") (= (get yes :kind) "int-add")
                  (= (get no :kind) "int-literal") (= (get no :value) 0)
                  (= (get (js-nth 1 (get condition :children)) :kind) "int-literal")
                  (= (get (js-nth 0 (get condition :children)) :kind) "local")
                  (local-node-is (js-nth 0 (get yes :children))
                    (get (js-nth 0 (get condition :children)) :value))
                  (= (bit-and (1+ (get (js-nth 1 (get condition :children)) :value))
                              (get (js-nth 1 (get condition :children)) :value)) 0))
