  (defun counter-depth (node index depth)
    (let* ((kind (get node :kind)) (children (get node :children))
           (best -1) (position 0))
      (when (= kind "while")
        (let* ((condition (js-nth 0 children))
               (first (if (= (get condition :kind) "and") (js-nth 0 (get condition :children)) condition)))
          (when (and (= (get first :kind) "compare")
                     (local-node-is (js-nth 0 (get first :children)) index))
            (setq best depth))))
      (while (< position (js-length children))
        (let ((candidate (counter-depth (js-nth position children) index
                           (if (= kind "while") (1+ depth) depth))))
          (when (> candidate best) (setq best candidate)))
        (setq position (1+ position)))
