          (while (and (not found) (< position (js-length (get node :children))))
            (setq found (find-write (js-nth position (get node :children)) index kind))
            (setq position (1+ position)))
          found))))

  (defun last-statement (node)
    (if (and (= (get node :kind) "sequence") (> (js-length (get node :children)) 0))
        (last-statement (js-nth (1- (js-length (get node :children))) (get node :children)))
      node))

  (defun counter-bound (node index root arity)
    (let ((found nil) (position 0))
      (when (= (get node :kind) "while")
        (let* ((condition (js-nth 0 (get node :children)))
               (first (if (= (get condition :kind) "and")
                          (js-nth 0 (get condition :children)) condition))
               (tail (last-statement (js-nth 1 (get node :children)))))
          (when (and (= (get first :kind) "compare") (= (get first :value) "<")
                     (local-node-is (js-nth 0 (get first :children)) index)
                     (= (get tail :kind) "set") (= (get tail :value) index)
                     (increment-is (js-nth 0 (get tail :children)) index))
            (let ((bound (js-nth 1 (get first :children))))
              (when (or (positive-integer-literal bound)
                        (and (= (get bound :kind) "local") (< (get bound :value) arity)
                             (= (writes-local root (get bound :value)) 0)))
                (setq found bound))))))
      (while (and (not found) (< position (js-length (get node :children))))
        (setq found (counter-bound (js-nth position (get node :children)) index root arity))
        (setq position (1+ position)))
      found))

  (defun cyclic-integer (node index)
    (when (= (get node :kind) "if")
      (let* ((children (get node :children)) (condition (js-nth 0 children))
             (yes (js-nth 1 children)) (no (js-nth 2 children)))
        (and (= (get condition :kind) "compare") (= (get condition :value) "<")
             (local-node-is (js-nth 0 (get condition :children)) index)
             (positive-integer-literal (js-nth 1 (get condition :children)))
             (<= (get (js-nth 1 (get condition :children)) :value) 2147483646)
             (increment-is yes index) (positive-integer-literal no) (= (get no :value) 0)))))

  (defun cycle-writes-proven (node index)
    (let ((kind (get node :kind)) (valid t) (i 0))
      (when (= (get node :value) index)
        (cond
          ((= kind "initialize")
           (setq valid (and (positive-integer-literal (js-nth 0 (get node :children)))
                           (= (get (js-nth 0 (get node :children)) :value) 0))))
          ((= kind "set") (setq valid (cyclic-integer (js-nth 0 (get node :children)) index)))))
      (while (and valid (< i (js-length (get node :children))))
        (setq valid (cycle-writes-proven (js-nth i (get node :children)) index)) (setq i (1+ i)))
      valid))

  (defun specialize-cyclic-locals (body locals)
    ;; Every initialization and update must satisfy the range proof. Lane
    ;; expansion may introduce several updates, resets and branch copies;
    ;; accepting only the first update would freeze an unproven later write.
    (let ((descriptors (js-array)) (count (js-length locals)) (i 0) (selected nil))
      (while (< i count)
        (let ((entry nil))
          (when (and (= (get (js-nth i locals) :type) "f64")
                     (find-write body i "initialize") (find-write body i "set")
                     (cycle-writes-proven body i))
