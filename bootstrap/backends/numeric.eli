            (if (= (js-length guards) 0) fast
              ;; Conversion executes only behind finite nonnegative bounds.
              ;; Fractional bounds use ceil, preserving the original i < n.
              (typed "if" "f64" (js-array (typed "and" "i32" guards nil) fast body) nil)))))))

  (defun unroll-integer-loops (node)
