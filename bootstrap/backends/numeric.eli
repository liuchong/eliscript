      (while (< index (js-length (get node :children)))
        (js-call children :push (unroll-integer-loops (js-nth index (get node :children))))
        (setq index (1+ index)))
      (let ((copy (typed (get node :kind) (get node :type) children (get node :value))))
        (if (= (get copy :kind) "while")
            (let* ((condition (js-nth 0 children)) (body (js-nth 1 children))
                   (operands (get condition :children)) (tail (last-statement body)))
              (when (= (get tail :kind) "int-number") (setq tail (js-nth 0 (get tail :children))))
              (if (and (= (get condition :kind) "int-compare")
                       (local-node-is (js-nth 0 operands) (get tail :value))
                       (= (get (js-nth 1 operands) :kind) "local")
                       (= (get tail :kind) "set")
                       (= (get (js-nth 0 (get tail :children)) :kind) "int-add")
                       (= (writes-local body (get (js-nth 0 operands) :value)) 1)
                       (= (writes-local body (get (js-nth 1 operands) :value)) 0)
                       (not (contains-kind body "while")) (<= (tree-size body) 128))
                  (typed "sequence" "i32" (js-array
                    (typed "while" "i32" (js-array
                      (typed "int-compare" "i32" (js-array
                        (typed "int-literal" "i32" (js-array) 3)
                        (typed "int-sub" "i32" (js-array (js-nth 1 operands) (js-nth 0 operands)) nil)) "<")
                      ;; Four complete iterations, with every f64 operation
                      ;; and effect in its original order; no reassociation.
                      (typed "sequence" (get body :type) (js-array body body body body) nil)) nil)
                    (typed "remainder-while" "i32" children nil)) nil)
                copy))
          copy))))

  (defun single-iteration-loops (node entry)
    (let ((children (js-array)) (index 0))
      (while (< index (js-length (get node :children)))
        (js-call children :push (single-iteration-loops (js-nth index (get node :children)) entry))
        (setq index (1+ index)))
      (if (= (get node :kind) "while")
          (let* ((condition (js-nth 0 children))
                 (first (if (= (get condition :kind) "and") (js-nth 0 (get condition :children)) condition)))
            (if (and (= (get first :kind) "int-compare")
                     (local-node-is (js-nth 0 (get first :children)) (get entry :storage))
                     (local-node-is (js-nth 1 (get first :children)) (get entry :limit)))
                (typed "if" "i32" (js-array condition
                  (typed "sequence" "i32" (js-array (js-nth 1 children)
                    (typed "literal" "i32" (js-array) 0)) nil)
                  (typed "literal" "i32" (js-array) 0)) nil)
              (typed "while" "i32" children nil)))
        (typed (get node :kind) (get node :type) children (get node :value)))))

  (defun expandable-guard (node locals)
    (let ((kind (get node :kind)))
      (cond
        ((= kind "and")
         (let ((index 0) (pure t))
           (while (and pure (< index (js-length (get node :children))))
             (setq pure (expandable-guard (js-nth index (get node :children)) locals))
             (setq index (1+ index)))
           pure))
        ((= kind "set")
         (and (get (js-nth (get node :value) locals) :pureGuardCache nil)
              (numeric-pure (js-nth 0 (get node :children)))))
        ((or (= kind "arithmetic") (= kind "compare") (= kind "not"))
         (let ((index 0) (pure t))
           (while (and pure (< index (js-length (get node :children))))
             (setq pure (expandable-guard (js-nth index (get node :children)) locals))
             (setq index (1+ index)))
           pure))
        (t (numeric-pure node)))))

  (defun expand-compound-loops (node locals)
    (let ((children (js-array)) (index 0))
      (while (< index (js-length (get node :children)))
        (js-call children :push (expand-compound-loops (js-nth index (get node :children)) locals))
        (setq index (1+ index)))
      ;; The emitter repeats a pure compound guard after every complete body.
      ;; It never moves floating operations or executes a failing iteration.
      ;; Keep effectful guards and nested/large bodies on their normal path.
      (typed
        (if (and (= (get node :kind) "while")
                 (= (get (js-nth 0 children) :kind) "and")
                 (expandable-guard (js-nth 0 children) locals)
                 (not (contains-kind (js-nth 1 children) "while"))
                 (<= (tree-size (js-nth 1 children)) 128))
            "guarded-while" (get node :kind))
        (get node :type) children (get node :value))))

  (defun flow-literal (node)
    (or (= (get node :kind) "literal") (= (get node :kind) "int-literal")))

  (defun invalidate-flow-writes (node known)
    (when (and (or (= (get node :kind) "set") (= (get node :kind) "initialize"))
               (< (get node :value) (js-length known)))
      (js-call known :splice (get node :value) 1 nil))
    (let ((i 0)) (while (< i (js-length (get node :children)))
      (invalidate-flow-writes (js-nth i (get node :children)) known) (setq i (1+ i)))))

  (defun same-flow-literal (left right)
    ;; Join constants by bits: +0 and -0 are distinct IEEE values.
    (and left right (= (get left :type) (get right :type))
      (or (/= (get left :value) 0) (= (/ 1 (get left :value)) (/ 1 (get right :value))))
      (let ((a (number-float64-words (get left :value)))
            (b (number-float64-words (get right :value))))
        (and (= (js-nth 0 a) (js-nth 0 b)) (= (js-nth 1 a) (js-nth 1 b))))))

  (defun fold-literal-operation (node)
    (let* ((kind (get node :kind)) (children (get node :children))
           (op (get node :value)) (i 0) (all t))
      (while (< i (js-length children))
        (unless (flow-literal (js-nth i children)) (setq all nil)) (setq i (1+ i)))
      (if (not all) node
        (let ((a (if (> (js-length children) 0) (get (js-nth 0 children) :value) 0))
              (b (if (> (js-length children) 1) (get (js-nth 1 children) :value) 1))
              (value nil) (valid t))
          (cond
            ((= kind "arithmetic")
             (setq value (cond
               ((= (js-length children) 0) (if (= op "*") 1 0))
               ((= op "1+") (+ a 1)) ((= op "1-") (- a 1))
               ((= (js-length children) 1)
                (cond ((= op "-") (- a)) ((= op "/") (/ 1 a)) (t a)))
               ((= op "+") (+ a b)) ((= op "-") (- a b))
               ((= op "*") (* a b)) (t (/ a b)))))
            ((or (= kind "compare") (= kind "int-compare"))
             (setq value (if (cond ((= op "=") (= a b)) ((= op "<") (< a b))
               ((= op "<=") (<= a b)) ((= op ">") (> a b)) (t (>= a b))) 1 0)))
            ((= kind "int-number") (setq value a))
            ((= kind "int-add") (setq value (bit-or (+ a b) 0)))
            ((= kind "int-sub") (setq value (bit-or (- a b) 0)))
            ((= kind "int-and") (setq value (bit-and a b)))
            ((= kind "not") (setq value (if (and (= (get (js-nth 0 children) :type) "i32") (= a 0)) 1 0)))
            (t (setq valid nil)))
          (if valid (typed "literal" (get node :type) (js-array) value) node)))))

  (defun fold-constant-flow (node known)
    (let ((kind (get node :kind)) (value (get node :value)) (children (get node :children)))
      (cond
        ((= kind "local") (or (js-nth value known) node))
        ((= kind "if")
         (let ((guard (fold-constant-flow (js-nth 0 children) known)))
           (if (flow-literal guard)
               (fold-constant-flow (js-nth (if (or (= (get guard :type) "f64")
                 (/= (get guard :value) 0)) 1 2) children) known)
             (let* ((yes-known (js-call known :slice)) (no-known (js-call known :slice))
                    (yes (fold-constant-flow (js-nth 1 children) yes-known))
                    (no (fold-constant-flow (js-nth 2 children) no-known)) (i 0))
               (while (< i (js-length known))
                 (js-call known :splice i 1
                   (if (same-flow-literal (js-nth i yes-known) (js-nth i no-known))
                       (js-nth i yes-known) nil))
                 (setq i (1+ i)))
               (typed kind (get node :type) (js-array guard yes no) value)))))
        ((or (= kind "while") (= kind "remainder-while") (= kind "guarded-while"))
         ;; Invalidate before folding the first guard, including guard writes.
         ;; Initial values cannot stand in for values of later iterations.
         (invalidate-flow-writes node known)
         (let* ((inner (js-call known :slice))
                (guard (fold-constant-flow (js-nth 0 children) inner))
                (body (fold-constant-flow (js-nth 1 children) inner)))
           (typed kind (get node :type) (js-array guard body) value)))
        ((or (= kind "and") (= kind "or"))
         (invalidate-flow-writes node known)
         (let ((output (js-array)) (i 0))
           (while (< i (js-length children))
             (js-call output :push (fold-constant-flow (js-nth i children) (js-call known :slice)))
             (setq i (1+ i)))
           (typed kind (get node :type) output value)))
        (t
         (let ((output (js-array)) (i 0))
           (while (< i (js-length children))
             (js-call output :push (fold-constant-flow (js-nth i children) known)) (setq i (1+ i)))
           (let ((copy (fold-literal-operation (typed kind (get node :type) output value))))
             (when (or (= kind "set") (= kind "initialize"))
               (while (<= (js-length known) value) (js-call known :push nil))
               (js-call known :splice value 1 (if (flow-literal (js-nth 0 output)) (js-nth 0 output) nil)))
             copy))))))

  (defun collect-flow-reads (node reads)
    (when (= (get node :kind) "local") (js-call reads :push (get node :value)))
    (let ((i 0)) (while (< i (js-length (get node :children)))
      (collect-flow-reads (js-nth i (get node :children)) reads) (setq i (1+ i)))))

  (defun remove-unread-stores (node reads)
    (let ((children (js-array)) (i 0) (kind (get node :kind)))
      (while (< i (js-length (get node :children)))
        (js-call children :push (remove-unread-stores (js-nth i (get node :children)) reads))
        (setq i (1+ i)))
      ;; Keep the RHS as an expression: its effects and assignment result
      ;; remain observable even when the storage itself is never read.
      (if (and (or (= kind "set") (= kind "initialize"))
               (not (js-call reads :includes (get node :value))))
          (js-nth 0 children)
        (typed kind (get node :type) children (get node :value)))))

  (defun invariant-guard (node body)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0) (valid t))
      (cond
        ((= kind "local") (setq valid (= (writes-local body (get node :value)) 0)))
        ((or (= kind "literal") (= kind "int-literal")))
        ((or (= kind "arithmetic") (= kind "compare") (= kind "and") (= kind "or") (= kind "not")
             (= kind "int-add") (= kind "int-sub") (= kind "int-and") (= kind "int-compare")
             (= kind "int-number") (= kind "ceil-int")))
        (t (setq valid nil)))
      (while (and valid (< i (js-length children)))
        (setq valid (invariant-guard (js-nth i children) body)) (setq i (1+ i)))
      valid))

  (defun invariant-if-path (node body path)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0) (found nil))
      (if (and (= kind "if") (invariant-guard (js-nth 0 children) body))
          (js-object :path path :condition (js-nth 0 children))
        (progn
          (unless (or (= kind "while") (= kind "remainder-while") (= kind "guarded-while"))
            (while (and (not found) (< i (js-length children)))
              (let ((next (js-call path :slice)))
                (js-call next :push i) (setq found (invariant-if-path (js-nth i children) body next)))
              (setq i (1+ i))))
          found))))

  (defun same-numeric-tree (left right)
    (let ((a (get left :children)) (b (get right :children)) (i 0)
          (same (and (= (get left :kind) (get right :kind)) (= (get left :type) (get right :type))
                     (= (js-length (get left :children)) (js-length (get right :children))))))
      (when same
        (setq same (if (flow-literal left) (same-flow-literal left right)
                    (= (get left :value) (get right :value)))))
      (while (and same (< i (js-length a)))
        (setq same (same-numeric-tree (js-nth i a) (js-nth i b))) (setq i (1+ i)))
      same))

  (defun select-invariant-copies (node guard arm)
    (if (and (= (get node :kind) "if") (same-numeric-tree (js-nth 0 (get node :children)) guard))
        (select-invariant-copies (js-nth arm (get node :children)) guard arm)
      (let ((children (js-array)) (i 0))
        (while (< i (js-length (get node :children)))
          (js-call children :push (select-invariant-copies (js-nth i (get node :children)) guard arm))
          (setq i (1+ i)))
        (typed (get node :kind) (get node :type) children (get node :value)))))

  (defun unswitch-numeric-loops (node)
    (let ((children (js-array)) (kind (get node :kind)) (i 0))
      (while (< i (js-length (get node :children)))
        (js-call children :push (unswitch-numeric-loops (js-nth i (get node :children)))) (setq i (1+ i)))
      (let ((copy (typed kind (get node :type) children (get node :value))))
        (if (and (or (= kind "while") (= kind "remainder-while") (= kind "guarded-while"))
                 (<= (tree-size (js-nth 1 children)) 512))
            (let* ((body (js-nth 1 children)) (choice (invariant-if-path body copy (js-array))))
              (if choice
                  (typed "if" (get copy :type) (js-array (get choice :condition)
                    (typed kind (get copy :type) (js-array (js-nth 0 children)
                      (select-invariant-copies body (get choice :condition) 1)) (get copy :value))
                    (typed kind (get copy :type) (js-array (js-nth 0 children)
                      (select-invariant-copies body (get choice :condition) 2)) (get copy :value))) nil)
                copy))
          copy))))

  (export lower-numeric-program optimize-numeric-program numeric-pure tree-size backend-fail find-function))
