(module eliscript.backend.numeric
  ;; Explicit numeric-f64 ABI: required Number arguments and Number results.
  ;; This is a typed vertical slice, not a replacement for the dynamic runtime.
  (defun backend-fail (node message)
    (let* ((record (or node (js-object)))
           (span (or (get record :span nil) (js-object))))
      (throw
        (js-object
          :message message
          :eliscriptDiagnostic
          (js-object :format "eliscript-diagnostic" :version 1
            :code "ELI-B0001" :severity "error" :phase "numeric-backend"
            :message message
            :location (js-object :file (get span :filename (get record :filename "<ir>"))
              :start (js-object :line (get span :line 1)
                :column (get span :column 1))))))))

  (defun find-local (scope name)
    (let ((index (1- (js-length scope))) (found nil))
      (while (and (>= index 0) (not found))
        (let ((entry (js-nth index scope)))
          (when (= (get entry :name) name) (setq found entry)))
        (setq index (1- index)))
      found))

  (defun find-function (functions name)
    (let ((index 0) (found nil))
      (while (and (< index (js-length functions)) (not found))
        (when (= (get (js-nth index functions) :name) name)
          (setq found (js-nth index functions)))
        (setq index (1+ index)))
      found))

  (defun typed (kind type children value)
    (js-object :kind kind :type type :children children :value value))

  (defun require-type (original expression type)
    (unless (= (get expression :type) type)
      (backend-fail original (str "numeric-f64 ABI requires " type " operands")))
    expression)

  (defun typed-sequence (nodes scope state functions)
    (let ((result (js-array)) (index 0) (type "i32"))
      (while (< index (js-length nodes))
        (let ((expression (lower-expression (js-nth index nodes) scope state functions)))
          (setq type (get expression :type))
          (js-call result :push expression))
        (setq index (1+ index)))
      (typed "sequence" type result nil)))

  (defun new-local (state name type)
    (let* ((locals (get state :locals))
           (entry (js-object :name name :type type :index (js-length locals))))
      (js-call locals :push entry)
      entry))

  (defun lower-bindings (node scope state functions)
    (let* ((properties (get node :properties))
           (count (get properties :bindingCount))
           (children (get node :children))
           (inner (js-call scope :slice))
           (initializers (js-array))
           (pending (js-array))
           (index 0))
      (while (< index count)
        (let ((binding (js-nth index children)))
          (unless (and (= (get binding :kind) "lexical-binding")
                       (= (js-length (get binding :children)) 1))
            (backend-fail binding "numeric-f64 ABI requires simple initialized bindings"))
          (when (find-local pending (get binding :value))
            (backend-fail binding "duplicate lexical binding"))
          (let* ((init (lower-expression (js-nth 0 (get binding :children))
                         (if (get properties :sequential) inner scope) state functions))
                 (local (new-local state (get binding :value) (get init :type))))
            (js-call initializers :push (typed "set" (get init :type) (js-array init)
                                         (get local :index)))
            (js-call pending :push local)
            (when (get properties :sequential) (js-call inner :push local))))
        (setq index (1+ index)))
      (unless (get properties :sequential)
        (let ((index 0))
          (while (< index (js-length pending))
            (js-call inner :push (js-nth index pending))
            (setq index (1+ index)))))
      (let ((body (typed-sequence (js-call children :slice count) inner state functions)))
        (js-call initializers :push body)
        (typed "sequence" (get body :type) initializers nil))))

  (defun lower-expression (node scope state functions)
    (let ((kind (get node :kind)) (value (get node :value))
          (children (get node :children)))
      (cond
        ((and (= kind "literal") (not (get node :properties nil)))
         (cond ((= (value-type value) "number") (typed "literal" "f64" (js-array) value))
               ((or (= (value-type value) "boolean") (nil? value))
                (typed "literal" "i32" (js-array) (if value 1 0)))
               (t (backend-fail node "numeric-f64 ABI does not support this literal"))))
        ((= kind "reference")
         (let ((local (find-local scope value)))
           (unless local (backend-fail node (str "unknown numeric local: " value)))
           (typed "local" (get local :type) (js-array) (get local :index))))
        ((= kind "lexical-bindings") (lower-bindings node scope state functions))
        ((= kind "sequence") (typed-sequence children scope state functions))
        ((= kind "assignment")
         (let ((assignments (js-array)) (index 0) (type "i32"))
           (while (< index (js-length children))
             (let* ((pair (js-nth index children))
                    (local (find-local scope (get pair :value))))
               (unless (and (= (get pair :kind) "assignment-pair") local)
                 (backend-fail pair "assignment must address an existing numeric local"))
               (let ((rhs (lower-expression (js-nth 0 (get pair :children)) scope state functions)))
                 (require-type pair rhs (get local :type))
                 (setq type (get rhs :type))
                 (js-call assignments :push
                   (typed "set" type (js-array rhs) (get local :index)))))
             (setq index (1+ index)))
           (typed "sequence" type assignments nil)))
        ((and (= kind "loop") (= value "while"))
         (typed "while" "i32"
           (js-array (lower-expression (js-nth 0 children) scope state functions)
             (typed-sequence (js-call children :slice 1) scope state functions)) nil))
        ((and (= kind "conditional") (= (js-length children) 3))
         (let* ((condition (lower-expression (js-nth 0 children) scope state functions))
                (yes (lower-expression (js-nth 1 children) scope state functions))
                (no (lower-expression (js-nth 2 children) scope state functions)))
           (require-type node no (get yes :type))
           (typed "if" (get yes :type) (js-array condition yes no) nil)))
        ((and (= kind "short-circuit")
              (or (= value "and") (= value "or"))
              (> (js-length children) 0))
         (let ((operands (js-array)) (index 0) (type nil))
           (while (< index (js-length children))
             (let ((operand (lower-expression (js-nth index children) scope state functions)))
               (if type (require-type node operand type) (setq type (get operand :type)))
               (js-call operands :push operand))
             (setq index (1+ index)))
           (typed value type operands nil)))
        ((= kind "intrinsic")
         (let ((operands (js-array)) (index 0))
           (while (< index (js-length children))
             (js-call operands :push (lower-expression (js-nth index children) scope state functions))
             (setq index (1+ index)))
           (cond
             ((and (= value "not") (= (js-length operands) 1))
              (typed "not" "i32" operands nil))
             ((and (or (= value "+") (= value "-") (= value "*") (= value "/"))
                   (<= (js-length operands) 2)
                   (or (> (js-length operands) 0) (= value "+") (= value "*")))
              (let ((index 0))
                (while (< index (js-length operands))
                  (require-type node (js-nth index operands) "f64")
                  (setq index (1+ index))))
              (typed "arithmetic" "f64" operands value))
             ((and (or (= value "1+") (= value "1-")) (= (js-length operands) 1))
              (require-type node (js-nth 0 operands) "f64")
              (typed "arithmetic" "f64" operands value))
             ((and (or (= value "=") (= value "<") (= value "<=")
                       (= value ">") (= value ">=")) (= (js-length operands) 2))
              (require-type node (js-nth 0 operands) "f64")
              (require-type node (js-nth 1 operands) "f64")
              (typed "compare" "i32" operands value))
             (t (backend-fail node (str "unsupported numeric intrinsic: " value))))))
        ((and (= kind "call") (> (js-length children) 0)
              (= (get (js-nth 0 children) :kind) "reference"))
         (let* ((name (get (js-nth 0 children) :value))
                (function (find-function functions name))
                (arguments (js-array)) (index 1))
           (when (find-local scope name)
             (backend-fail node "numeric calls cannot resolve a shadowed function"))
           (unless function (backend-fail node (str "unknown numeric function: " name)))
           (unless (= (1- (js-length children)) (get function :arity))
             (backend-fail node "numeric call arity mismatch"))
           (while (< index (js-length children))
             (js-call arguments :push
               (require-type node (lower-expression (js-nth index children) scope state functions) "f64"))
             (setq index (1+ index)))
           (typed "call" "f64" arguments (get function :index))))
        (t (backend-fail node (str "unsupported numeric IR: " kind ":" value))))))

  (defun collect-declarations (nodes declarations)
    (let ((index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (if (= (get node :kind) "module-declaration")
              (collect-declarations (get node :children) declarations)
            (js-call declarations :push node)))
        (setq index (1+ index))))
    declarations)

  (defun lower-numeric-program (program)
    (let ((functions (js-array)) (exports (js-array))
          (nodes (collect-declarations (get program :body) (js-array)))
          (index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (cond
            ((= (get node :kind) "export-declaration")
             (let ((position 0))
               (while (< position (js-length (get node :children)))
                 (let ((child (js-nth position (get node :children))))
                   (unless (= (get child :kind) "reference")
                     (backend-fail child "numeric exports require named functions"))
                   (js-call exports :push (get child :value)))
                 (setq position (1+ position)))))
            ((and (= (get node :kind) "function-declaration")
                  (not (get (get node :properties) :async)))
             (when (find-function functions (get node :value))
               (backend-fail node "duplicate numeric function"))
             (js-call functions :push
               (js-object :name (get node :value) :index (js-length functions)
                 :arity (get (get node :properties) :parameterCount) :source node)))
            (t (backend-fail node "numeric-f64 ABI requires synchronous functions and exports"))))
        (setq index (1+ index)))
      (when (= (js-length functions) 0)
        (backend-fail program "numeric-f64 ABI requires at least one function"))
      (setq index 0)
      (while (< index (js-length functions))
        (let* ((function (js-nth index functions))
               (node (get function :source))
               (children (get node :children))
               (arity (get function :arity))
               (state (js-object :locals (js-array)))
               (scope (js-array)) (position 0))
          (while (< position arity)
            (let ((parameter (js-nth position children)))
              (unless (and (= (get parameter :kind) "parameter-binding")
                           (= (get (get parameter :properties) :parameterKind) "required")
                           (not (find-local scope (get parameter :value))))
                (backend-fail parameter "numeric-f64 ABI requires distinct required parameters"))
              (js-call scope :push (new-local state (get parameter :value) "f64")))
            (setq position (1+ position)))
          (let ((body (typed-sequence (js-call children :slice arity) scope state functions)))
            (require-type node body "f64")
            (put function :body body)
            (put function :locals (get state :locals))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length exports))
        (unless (find-function functions (js-nth index exports))
          (backend-fail program (str "unknown numeric export: " (js-nth index exports))))
        (let ((prior 0))
          (while (< prior index)
            (when (= (js-nth prior exports) (js-nth index exports))
              (backend-fail program "duplicate numeric export"))
            (setq prior (1+ prior))))
        (setq index (1+ index)))
      (js-object :abi "numeric-f64" :filename (get program :filename)
        :functions functions :exports exports)))

  (export lower-numeric-program backend-fail find-function))
