  (defun positive-integer-literal (node)
    (and (= (get node :kind) "literal") (= (get node :type) "f64")
         (>= (get node :value) 0) (<= (get node :value) 2147483647)
         (= (get node :value) (uint32 (get node :value)))
         (not (and (= (get node :value) 0) (< (/ 1 (get node :value)) 0)))))

  (defun local-node-is (node index)
    (and (= (get node :kind) "local") (= (get node :value) index)))

  (defun increment-is (node index)
    (and (= (get node :kind) "arithmetic") (= (get node :value) "1+")
         (local-node-is (js-nth 0 (get node :children)) index)))

  (defun find-write (node index kind)
    (let ((found nil) (position 0))
      (if (and (= (get node :kind) kind) (= (get node :value) index))
          node
