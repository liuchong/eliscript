  (defun reads-local (node local)
    (let ((found (local-node-is node local)) (index 0))
      (while (and (not found) (< index (js-length (get node :children))))
        (setq found (reads-local (js-nth index (get node :children)) local))
        (setq index (1+ index)))
      found))

  (defun single-loop-shape (body)
    (let ((statements (flatten-statements body (js-array)))
          (position 0) (loop nil) (valid t))
      (while (< position (js-length statements))
        (let ((statement (js-nth position statements)))
          (cond
            ((= (get statement :kind) "while")
             (if loop (setq valid nil) (setq loop (js-object :node statement :position position))))
            ((not loop)
             (unless (and (= (get statement :kind) "initialize")
                          (scalar-pure-value (js-nth 0 (get statement :children)))) (setq valid nil)))
            ((not (scalar-pure-value statement)) (setq valid nil))))
        (setq position (1+ position)))
