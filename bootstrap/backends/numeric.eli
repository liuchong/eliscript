                  ;; Version a proven counter for zero/one iterations. The
                  ;; bound test stays outside surrounding batch loops.
                  (typed "if" "f64" (js-array
                    (typed "int-compare" "i32" (js-array
                      (typed "local" "i32" (js-array) (get small :limit))
                      (typed "int-literal" "i32" (js-array) 2)) "<")
                    (unroll-integer-loops (single-iteration-loops rewritten small))
                    (unroll-integer-loops rewritten)) nil)
                (unroll-integer-loops rewritten))))
