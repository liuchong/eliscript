              (= (get (js-nth 0 (get node :children)) :kind) "local"))
         (let* ((entry (js-nth (get (js-nth 0 (get node :children)) :value) descriptors))
                (right (js-nth 1 (get node :children)))
                (bound (if entry (get entry :bound nil) nil)))
