             ((and (integer-operand (js-nth 0 children)) (integer-operand (js-nth 1 children)))
              (typed "int-compare" "i32" (js-array (integer-value (js-nth 0 children))
                (integer-value (js-nth 1 children))) value))
             (t (typed kind (get node :type) children value)))))
        (t (typed kind (get node :type) children value)))))

  (defun specialize-integer-locals (body locals arity)
    (let ((descriptors (js-array)) (guards (js-array)) (prelude (js-array))
          (count (js-length locals)) (index 0) (selected 0) (small nil))
      (while (< index count)
        (let ((initializer (find-write body index "initialize"))
              (update (find-write body index "set")) (entry nil))
          (when (and initializer update (= (writes-local body index) 2)
                     (positive-integer-literal (js-nth 0 (get initializer :children)))
                     (= (get (js-nth 0 (get initializer :children)) :value) 0))
