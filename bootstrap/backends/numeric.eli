        (let* ((condition (js-nth 0 (get (get loop :node) :children)))
               (tail (last-statement (js-nth 1 (get (get loop :node) :children)))))
          (when (and (= (get condition :kind) "compare") (= (get condition :value) "<")
                     (= (get (js-nth 0 (get condition :children)) :kind) "local")
                     (= (get tail :kind) "set")
                     (local-node-is (js-nth 0 (get condition :children)) (get tail :value))
                     (increment-is (js-nth 0 (get tail :children)) (get tail :value)))
            (let* ((counter (get tail :value)) (initializer (find-write body counter "initialize")))
              (when (and initializer (= (writes-local body counter) 2)
                         (positive-integer-literal (js-nth 0 (get initializer :children)))
                         (= (get (js-nth 0 (get initializer :children)) :value) 0))
                (put loop :counter counter)
                (put loop :bound (js-nth 1 (get condition :children)))
                (put loop :statements statements)
                (setq valid t)
                loop)))))))

  (defun append-numeric-frame (locals callee)
    (let ((offset (js-length locals)) (index 0))
      (while (< index (js-length (get callee :locals)))
        (let ((entry (js-nth index (get callee :locals))))
          (js-call locals :push (js-object :name (get entry :name)
            :index (js-length locals) :type (get entry :type))))
        (setq index (1+ index)))
      offset))

  (defun parallelize-call-loop (original functions locals arity fallback single)
    (let ((outer (single-loop-shape original)))
      (if (not outer) fallback
        (let* ((loop (get outer :node)) (bound (get outer :bound))
               (statements (flatten-statements (js-nth 1 (get loop :children)) (js-array)))
               (first (js-nth 0 statements))
               (addition (if (= (get first :kind) "set") (js-nth 0 (get first :children)) nil))
               (call (if (and addition (= (get addition :kind) "arithmetic")
                              (= (get addition :value) "+")) (js-nth 1 (get addition :children)) nil))
               (accumulator (get first :value))
               (valid (and call (= (get call :kind) "call")
                 (local-node-is (js-nth 0 (get addition :children)) accumulator)
                 (= (get bound :kind) "local") (< (get bound :value) arity)
                 (= (writes-local original (get bound :value)) 0))))
          (if (not valid) fallback
            (let* ((callee (js-nth (get call :value) functions))
                   (inner (single-loop-shape (get callee :body)))
                   (index 1))
              (while (< index (js-length statements))
                (let ((statement (js-nth index statements)))
                  (unless (and (= (get statement :kind) "set")
                               (/= (get statement :value) accumulator)
                               (scalar-pure-value (js-nth 0 (get statement :children)))
                               (not (reads-local (js-nth 0 (get statement :children)) accumulator)))
                    (setq valid nil)))
                (setq index (1+ index)))
              (setq index 0)
              (while (< index (js-length (get call :children)))
                (let ((argument (js-nth index (get call :children))))
                  (unless (and (scalar-pure-value argument) (not (reads-local argument accumulator)))
                    (setq valid nil)))
                (setq index (1+ index)))
              (when inner
                (let* ((limit (get inner :bound))
                       (kernel-body (flatten-statements (js-nth 1 (get (get inner :node) :children)) (js-array)))
                       (index 0))
                  (unless (and (= (get limit :kind) "local") (< (get limit :value) (get callee :arity))
                               (= (writes-local (get callee :body) (get limit :value)) 0))
                    (setq valid nil))
                  (while (< index (js-length kernel-body))
                    (let ((statement (js-nth index kernel-body)))
                      (unless (and (or (= (get statement :kind) "set") (= (get statement :kind) "initialize"))
                                   (scalar-pure-value (js-nth 0 (get statement :children))))
                        (setq valid nil)))
                    (setq index (1+ index)))))
              (if (or (not valid) (not inner)) fallback
                (let ((input (js-nth (get (get inner :bound) :value) (get call :children))))
                  (if (not (or (= (get input :kind) "literal")
                               (and (= (get input :kind) "local") (< (get input :value) arity)
                                    (= (writes-local original (get input :value)) 0)))) fallback
                    (emit-parallel-call-loop outer inner callee call statements input bound
                      accumulator locals fallback single))))))))))

  (defun emit-parallel-call-loop (outer inner callee call statements input bound accumulator locals fallback single)
    (let* ((offset0 (append-numeric-frame locals callee))
           (offset1 (append-numeric-frame locals callee))
           (aliases0 (js-array)) (aliases1 (js-array))
           (pair (js-array)) (work (js-array)) (index 0) (lane-loop nil)
           (kernel-statements (get inner :statements))
           (kernel-body (flatten-statements (js-nth 1 (get (get inner :node) :children)) (js-array)))
           (counter (get inner :counter)) (limit-parameter (get (get inner :bound) :value)))
      (while (< index (js-length (get callee :locals)))
        (js-call aliases0 :push (if (= index limit-parameter) input nil))
        (js-call aliases1 :push (cond ((= index limit-parameter) input)
          ((= index counter) (typed "local" "f64" (js-array) (+ offset0 counter))) (t nil)))
        (setq index (1+ index)))
      (let ((lane 0))
        (while (< lane 2)
          (let ((offset (if (= lane 0) offset0 offset1))
                (aliases (if (= lane 0) aliases0 aliases1)) (index 0))
            (while (< index (get callee :arity))
              (js-call pair :push (typed "initialize" "f64"
                (js-array (js-nth index (get call :children))) (+ offset index)))
              (setq index (1+ index)))
            (setq index 0)
            (while (< index (get inner :position))
              (js-call pair :push (copy-offset (js-nth index kernel-statements) offset aliases))
              (setq index (1+ index)))
            (setq index 1)
            (while (< index (js-length statements))
              (js-call pair :push (js-nth index statements))
              (setq index (1+ index)))
            (setq index 0)
            (while (< index (1- (js-length kernel-body)))
              (js-call work :push (copy-offset (js-nth index kernel-body) offset aliases))
              (setq index (1+ index))))
          (setq lane (1+ lane))))
      (js-call work :push (copy-offset (js-nth (1- (js-length kernel-body)) kernel-body) offset0 aliases0))
      (setq lane-loop (typed "while" "i32" (js-array
        (copy-offset (js-nth 0 (get (get inner :node) :children)) offset0 aliases0)
        (typed "sequence" "f64" work nil)) nil))
      (js-call pair :push lane-loop)
      (let ((lane 0))
        (while (< lane 2)
          (let* ((offset (if (= lane 0) offset0 offset1))
                 (aliases (if (= lane 0) aliases0 aliases1))
                 (suffix (js-array)) (index (1+ (get inner :position))))
            (while (< index (js-length kernel-statements))
              (js-call suffix :push (copy-offset (js-nth index kernel-statements) offset aliases))
              (setq index (1+ index)))
            (js-call pair :push (typed "set" "f64" (js-array
              (typed "arithmetic" "f64" (js-array
                (typed "local" "f64" (js-array) accumulator)
                (typed "sequence" "f64" suffix nil)) "+")) accumulator)))
          (setq lane (1+ lane))))
      (let ((body (js-array)) (index 0) (outer-statements (get outer :statements)))
        (while (< index (get outer :position))
          (js-call body :push (js-nth index outer-statements))
          (setq index (1+ index)))
        (js-call body :push (typed "while" "i32" (js-array
          (typed "compare" "i32" (js-array
            (typed "arithmetic" "f64" (js-array (typed "local" "f64" (js-array) (get outer :counter))) "1+")
            bound) "<") (typed "sequence" "f64" pair nil)) nil))
        (js-call body :push (get outer :node))
        (setq index (1+ (get outer :position)))
        (while (< index (js-length outer-statements))
          (js-call body :push (js-nth index outer-statements))
          (setq index (1+ index)))
        ;; Lane state is private and arithmetic order is unchanged per call.
        ;; The final reductions execute in original call order. Bounds exclude
        ;; nontermination and counter rounding; all other inputs use fallback.
        (typed "if" "f64" (js-array (typed "and" "i32" (js-array
          (typed "compare" "i32" (js-array input (typed "literal" "f64" (js-array) (if single 1 2))) ">=")
          (typed "compare" "i32" (js-array input (typed "literal" "f64" (js-array) 2147483647)) "<=")
          (typed "compare" "i32" (js-array bound (typed "literal" "f64" (js-array) 2)) ">=")
          (typed "compare" "i32" (js-array bound (typed "literal" "f64" (js-array) 2147483647)) "<=")) nil)
          (if single
              ;; The enclosing finite input >= 1 guard and this <= 1 test
              ;; prove exactly one iteration. Dispatch once before the batch;
              ;; preserve both lane bodies and their ordered reductions.
              (typed "if" "f64" (js-array
                (typed "compare" "i32" (js-array input (typed "literal" "f64" (js-array) 1)) "<=")
                (replace-numeric-node (typed "sequence" "f64" body nil) lane-loop
                  (typed "sequence" "i32" (js-array (typed "sequence" "f64" work nil)
                    (typed "literal" "i32" (js-array) 0)) nil))
                (typed "sequence" "f64" body nil)) nil)
            (typed "sequence" "f64" body nil)) fallback) nil))))

  (defun replace-numeric-node (node selected replacement)
    (if (= node selected) replacement
      (let ((children (js-array)) (i 0))
        (while (< i (js-length (get node :children)))
          (js-call children :push (replace-numeric-node (js-nth i (get node :children)) selected replacement))
          (setq i (1+ i)))
