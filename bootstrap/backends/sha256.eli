(module eliscript.backend.sha256
  ;; Deterministic byte hashing for native image metadata and ad-hoc page
  ;; signatures. No host crypto API or external signing process is involved.
  (defconst constants (new globalThis.Uint32Array (js-array
    1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221
    3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580
    3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986
    2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895
    666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037
    2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344
    430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779
    1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298)))

  (defun big-word (output value)
    (js-call output :push (unsigned-bit-shift-right value 24)
      (bit-and (unsigned-bit-shift-right value 16) 255)
      (bit-and (unsigned-bit-shift-right value 8) 255) (bit-and value 255)))

  (defun compress-block (hash words)
    (let ((k constants) (i 16))
      (while (< i 64)
        (let* ((x (aref words (- i 15))) (y (aref words (- i 2)))
               (s0 (bit-xor (bit-or (unsigned-bit-shift-right x 7) (bit-shift-left x 25))
                            (bit-xor (bit-or (unsigned-bit-shift-right x 18) (bit-shift-left x 14))
                                     (unsigned-bit-shift-right x 3))))
               (s1 (bit-xor (bit-or (unsigned-bit-shift-right y 17) (bit-shift-left y 15))
                            (bit-xor (bit-or (unsigned-bit-shift-right y 19) (bit-shift-left y 13))
                                     (unsigned-bit-shift-right y 10)))))
          (put words i (uint32 (+ (aref words (- i 16)) s0 (aref words (- i 7)) s1))))
        (setq i (1+ i)))
      (let ((a (aref hash 0)) (b (aref hash 1)) (c (aref hash 2)) (d (aref hash 3))
            (e (aref hash 4)) (f (aref hash 5)) (g (aref hash 6)) (h (aref hash 7)))
        (setq i 0)
        (while (< i 64)
          (let* ((s1 (bit-xor (bit-or (unsigned-bit-shift-right e 6) (bit-shift-left e 26))
                              (bit-xor (bit-or (unsigned-bit-shift-right e 11) (bit-shift-left e 21))
                                       (bit-or (unsigned-bit-shift-right e 25) (bit-shift-left e 7)))))
                 (ch (bit-xor (bit-and e f) (bit-and (bit-xor e 4294967295) g)))
                 (s0 (bit-xor (bit-or (unsigned-bit-shift-right a 2) (bit-shift-left a 30))
                              (bit-xor (bit-or (unsigned-bit-shift-right a 13) (bit-shift-left a 19))
                                       (bit-or (unsigned-bit-shift-right a 22) (bit-shift-left a 10)))))
                 (maj (bit-xor (bit-and a b) (bit-xor (bit-and a c) (bit-and b c))))
                 (t1 (uint32 (+ h s1 ch (aref k i) (aref words i))))
                 (t2 (uint32 (+ s0 maj))))
            (setq h g) (setq g f) (setq f e) (setq e (uint32 (+ d t1)))
            (setq d c) (setq c b) (setq b a) (setq a (uint32 (+ t1 t2))))
          (setq i (1+ i)))
        (put hash 0 (uint32 (+ (aref hash 0) a)))
        (put hash 1 (uint32 (+ (aref hash 1) b)))
        (put hash 2 (uint32 (+ (aref hash 2) c)))
        (put hash 3 (uint32 (+ (aref hash 3) d)))
        (put hash 4 (uint32 (+ (aref hash 4) e)))
        (put hash 5 (uint32 (+ (aref hash 5) f)))
        (put hash 6 (uint32 (+ (aref hash 6) g)))
        (put hash 7 (uint32 (+ (aref hash 7) h))))))

  (defun hash-output (hash)
    (let ((output (js-array)) (i 0))
      (while (< i 8) (big-word output (aref hash i)) (setq i (1+ i)))
      output))

  (defun sha256-bytes (input)
    (let* ((length (js-length input))
           (hash (new globalThis.Uint32Array (js-array 1779033703 3144134277 1013904242 2773480762
             1359893119 2600822924 528734635 1541459225)))
           (words (new globalThis.Uint32Array 64))
           (offset 0))
      (while (<= (+ offset 64) length)
        (let ((i 0))
          (while (< i 16)
            (let ((at (+ offset (* i 4))))
              (put words i (uint32 (bit-or (bit-shift-left (aref input at) 24)
                (bit-or (bit-shift-left (aref input (+ at 1)) 16)
                  (bit-or (bit-shift-left (aref input (+ at 2)) 8)
                    (aref input (+ at 3))))))))
            (setq i (1+ i)))
          (compress-block hash words))
        (setq offset (+ offset 64)))
      (let* ((rem (- length offset))
             (blocks (if (< rem 56) 1 2))
             (tail (new globalThis.Uint8Array (* blocks 64)))
             (j 0)
             (b 0))
        (while (< j rem)
          (put tail j (aref input (+ offset j)))
          (setq j (1+ j)))
        (put tail rem 128)
        (while (< b blocks)
          (let ((base (* b 64)) (i 0))
            (while (< i 16)
              (let ((at (+ base (* i 4))))
                (put words i (uint32 (bit-or (bit-shift-left (aref tail at) 24)
                  (bit-or (bit-shift-left (aref tail (+ at 1)) 16)
                    (bit-or (bit-shift-left (aref tail (+ at 2)) 8)
                      (aref tail (+ at 3))))))))
              (setq i (1+ i)))
            (when (= b (1- blocks))
              (put words 14 (uint32 (/ length 536870912)))
              (put words 15 (uint32 (* length 8))))
            (compress-block hash words))
          (setq b (1+ b))))
      (hash-output hash)))

  (defun sha256-words-le (input &optional reader)
    ;; Native words already own the complete image. Only one 64-word schedule
    ;; is materialized; message bytes and padding never duplicate that image.
    (let* ((length (js-length input))
           (total (* 16 (js-call globalThis.Math :ceil (/ (+ length 3) 16))))
           (high (uint32 (/ length 134217728))) (low (uint32 (* length 32)))
           (hash (new globalThis.Uint32Array (js-array 1779033703 3144134277 1013904242 2773480762
             1359893119 2600822924 528734635 1541459225)))
           (words (new globalThis.Uint32Array 64))
           (chunks (if (and (nil? reader) (not (Array/isArray input))
                            (Array/isArray (get input :chunks nil))
                            (not (get input :dirty nil))
                            (not (get input :hasHole nil)))
                     (get input :chunks) nil))
           (offset 0))
      (if chunks
        (let ((full-chunks (js-call globalThis.Math :floor (/ length 1024)))
              (chunk-idx 0)
              (chunk-ok t))
          (while (and chunk-ok (< chunk-idx full-chunks))
            (let ((chunk (aref chunks chunk-idx)))
              (if (not (and (= (value-type chunk) "string") (= (js-length chunk) 2048)))
                (setq chunk-ok false)
                (let ((b 0) (unit-at 0))
                  (while (< b 64)
                    (let ((i 0))
                      (while (< i 16)
                        (let ((u0 (string-code-unit-at chunk unit-at))
                              (u1 (string-code-unit-at chunk (1+ unit-at))))
                          (put words i (uint32 (bit-or (bit-shift-left (bit-and u0 255) 24)
                            (bit-or (bit-shift-left (unsigned-bit-shift-right u0 8) 16)
                              (bit-or (bit-shift-left (bit-and u1 255) 8)
                                (unsigned-bit-shift-right u1 8)))))))
                        (setq unit-at (+ unit-at 2) i (1+ i))))
                    (compress-block hash words)
                    (setq b (1+ b)))
                  (setq offset (+ offset 1024) chunk-idx (1+ chunk-idx))))))
          (while (< offset total)
            (let ((i 0))
              (while (< i 16)
                (let* ((at (+ offset i))
                       (value (cond
                         ((< at length)
                          (let* ((ch (aref chunks (unsigned-bit-shift-right at 10)))
                                 (u-at (* (bit-and at 1023) 2))
                                 (u0 (string-code-unit-at ch u-at))
                                 (u1 (string-code-unit-at ch (1+ u-at))))
                            (uint32 (bit-or (bit-shift-left (bit-and u0 255) 24)
                              (bit-or (bit-shift-left (unsigned-bit-shift-right u0 8) 16)
                                (bit-or (bit-shift-left (bit-and u1 255) 8)
                                  (unsigned-bit-shift-right u1 8)))))))
                         ((= at length) 2147483648)
                         ((= at (- total 2)) high)
                         ((= at (1- total)) low)
                         (t 0))))
                  (put words i value))
                (setq i (1+ i)))
              (compress-block hash words))
            (setq offset (+ offset 16))))
        (while (< offset total)
          (let ((i 0))
            (while (< i 16)
              (let* ((at (+ offset i))
                     (value (cond
                       ((< at length)
                        (let ((word (if reader (funcall reader input at) (aref input at))))
                          (uint32 (bit-or (bit-shift-left (bit-and word 255) 24)
                            (bit-or (bit-shift-left (bit-and word 65280) 8)
                              (bit-or (bit-and (unsigned-bit-shift-right word 8) 65280)
                                (unsigned-bit-shift-right word 24)))))))
                       ((= at length) 2147483648)
                       ((= at (- total 2)) high)
                       ((= at (1- total)) low)
                       (t 0))))
                (put words i value))
              (setq i (1+ i)))
            (compress-block hash words))
          (setq offset (+ offset 16))))
      (hash-output hash)))

  (defun sha256-string-utf16le (input)
    ;; Read the original code units in place. No UTF-8 replacement, whole
    ;; source byte array or padded copy can change lone surrogate identity.
    (let* ((length (* 2 (js-length input)))
           (total (* 64 (js-call globalThis.Math :ceil (/ (+ length 9) 64))))
           (high (uint32 (/ length 536870912))) (low (uint32 (* length 8)))
           (hash (new globalThis.Uint32Array (js-array 1779033703 3144134277 1013904242 2773480762
             1359893119 2600822924 528734635 1541459225)))
           (words (new globalThis.Uint32Array 64))
           (offset 0))
      (while (<= (+ offset 64) length)
        (let ((i 0) (unit-at (unsigned-bit-shift-right offset 1)))
          (while (< i 16)
            (let ((u0 (string-code-unit-at input unit-at))
                  (u1 (string-code-unit-at input (1+ unit-at))))
              (put words i (uint32 (bit-or (bit-shift-left (bit-and u0 255) 24)
                (bit-or (bit-shift-left (unsigned-bit-shift-right u0 8) 16)
                  (bit-or (bit-shift-left (bit-and u1 255) 8)
                    (unsigned-bit-shift-right u1 8)))))))
            (setq unit-at (+ unit-at 2))
            (setq i (1+ i)))
          (compress-block hash words))
        (setq offset (+ offset 64)))
      (while (< offset total)
        (let ((i 0))
          (while (< i 16)
            (let* ((at (+ offset (* i 4)))
                   (value (cond
                     ((= at (- total 8)) high)
                     ((= at (- total 4)) low)
                     (t
                      (let ((word 0) (j 0))
                        (while (< j 4)
                          (let* ((byte-at (+ at j))
                                 (byte (cond
                                   ((< byte-at length)
                                    (let ((unit (string-code-unit-at input
                                                  (unsigned-bit-shift-right byte-at 1))))
                                      (if (= (bit-and byte-at 1) 0) (bit-and unit 255)
                                        (unsigned-bit-shift-right unit 8))))
                                   ((= byte-at length) 128)
                                   (t 0))))
                            (setq word (uint32 (+ (* word 256) byte))))
                          (setq j (1+ j)))
                        word)))))
              (put words i value))
            (setq i (1+ i)))
          (compress-block hash words))
        (setq offset (+ offset 64)))
      (hash-output hash)))

  (export sha256-bytes sha256-words-le sha256-string-utf16le))
