(module eliscript.backend.sha256
  ;; Deterministic byte hashing for native image metadata and ad-hoc page
  ;; signatures. No host crypto API or external signing process is involved.
  (defconst constants (js-array
    1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221
    3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580
    3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986
    2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895
    666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037
    2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344
    430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779
    1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298))

  (defun rotate (x n)
    (uint32 (bit-or (unsigned-bit-shift-right x n) (bit-shift-left x (- 32 n)))))

  (defun big-word (output value)
    (js-call output :push (unsigned-bit-shift-right value 24)
      (bit-and (unsigned-bit-shift-right value 16) 255)
      (bit-and (unsigned-bit-shift-right value 8) 255) (bit-and value 255)))

  (defun compress-block (hash words)
    (let ((i 16))
          (while (< i 64)
            (let* ((x (js-nth (- i 15) words)) (y (js-nth (- i 2) words))
                   (s0 (bit-xor (rotate x 7) (bit-xor (rotate x 18) (unsigned-bit-shift-right x 3))))
                   (s1 (bit-xor (rotate y 17) (bit-xor (rotate y 19) (unsigned-bit-shift-right y 10)))))
              (js-call words :push (uint32 (+ (js-nth (- i 16) words) s0 (js-nth (- i 7) words) s1))))
            (setq i (1+ i)))
          (let ((a (js-nth 0 hash)) (b (js-nth 1 hash)) (c (js-nth 2 hash)) (d (js-nth 3 hash))
                (e (js-nth 4 hash)) (f (js-nth 5 hash)) (g (js-nth 6 hash)) (h (js-nth 7 hash)))
            (setq i 0)
            (while (< i 64)
              (let* ((s1 (bit-xor (rotate e 6) (bit-xor (rotate e 11) (rotate e 25))))
                     (ch (bit-xor (bit-and e f) (bit-and (bit-xor e 4294967295) g)))
                     (s0 (bit-xor (rotate a 2) (bit-xor (rotate a 13) (rotate a 22))))
                     (maj (bit-xor (bit-and a b) (bit-xor (bit-and a c) (bit-and b c))))
                     (t1 (uint32 (+ h s1 ch (js-nth i constants) (js-nth i words))))
                     (t2 (uint32 (+ s0 maj))))
                (setq h g) (setq g f) (setq f e) (setq e (uint32 (+ d t1)))
                (setq d c) (setq c b) (setq b a) (setq a (uint32 (+ t1 t2))))
              (setq i (1+ i)))
            (let ((values (js-array a b c d e f g h)))
              (setq i 0)
              (while (< i 8)
                (js-call hash :splice i 1 (uint32 (+ (js-nth i hash) (js-nth i values))))
                (setq i (1+ i)))))))

  (defun hash-output (hash)
    (let ((output (js-array)) (i 0))
      (while (< i 8) (big-word output (js-nth i hash)) (setq i (1+ i)))
      output))

  (defun sha256-bytes (input)
    (let* ((bytes (js-call input :slice)) (length (js-length bytes))
           (hash (js-array 1779033703 3144134277 1013904242 2773480762
             1359893119 2600822924 528734635 1541459225)) (offset 0))
      (js-call bytes :push 128)
      (while (/= (bit-and (js-length bytes) 63) 56) (js-call bytes :push 0))
      (big-word bytes (uint32 (/ length 536870912)))
      (big-word bytes (uint32 (* length 8)))
      (while (< offset (js-length bytes))
        (let ((words (js-array)) (i 0))
          (while (< i 16)
            (let ((at (+ offset (* i 4))))
              (js-call words :push (+ (* (js-nth at bytes) 16777216) (* (js-nth (+ at 1) bytes) 65536)
                (* (js-nth (+ at 2) bytes) 256) (js-nth (+ at 3) bytes))))
            (setq i (1+ i)))
          (compress-block hash words))
        (setq offset (+ offset 64)))
      (hash-output hash)))

  (defun sha256-words-le (input &optional reader)
    ;; Native words already own the complete image. Only one 64-word schedule
    ;; is materialized; message bytes and padding never duplicate that image.
    (let* ((length (js-length input))
           (total (* 16 (js-call globalThis.Math :ceil (/ (+ length 3) 16))))
           (high (uint32 (/ length 134217728))) (low (uint32 (* length 32)))
           (hash (js-array 1779033703 3144134277 1013904242 2773480762
             1359893119 2600822924 528734635 1541459225)) (offset 0))
      (while (< offset total)
        (let ((words (js-array)) (i 0))
          (while (< i 16)
            (let* ((at (+ offset i))
                   (value (cond
                     ((< at length)
                      (let ((word (if reader (funcall reader input at) (js-nth at input))))
                        (uint32 (bit-or (bit-shift-left (bit-and word 255) 24)
                          (bit-or (bit-shift-left (bit-and word 65280) 8)
                            (bit-or (bit-and (unsigned-bit-shift-right word 8) 65280)
                              (unsigned-bit-shift-right word 24)))))))
                     ((= at length) 2147483648)
                     ((= at (- total 2)) high)
                     ((= at (1- total)) low)
                     (t 0))))
              (js-call words :push value))
            (setq i (1+ i)))
          (compress-block hash words))
        (setq offset (+ offset 16)))
      (hash-output hash)))

  (defun sha256-string-utf16le (input)
    ;; Read the original code units in place. No UTF-8 replacement, whole
    ;; source byte array or padded copy can change lone surrogate identity.
    (let* ((length (* 2 (js-length input)))
           (total (* 64 (js-call globalThis.Math :ceil (/ (+ length 9) 64))))
           (high (uint32 (/ length 536870912))) (low (uint32 (* length 8)))
           (hash (js-array 1779033703 3144134277 1013904242 2773480762
             1359893119 2600822924 528734635 1541459225)) (offset 0))
      (while (< offset total)
        (let ((words (js-array)) (i 0))
          (while (< i 16)
            (let* ((at (+ offset (* i 4)))
                   (value (cond
                     ((= at (- total 8)) high)
                     ((= at (- total 4)) low)
                     (t
                      (let ((word 0) (j 0))
                        (while (< j 4)
                          (let* ((byte-at (+ at j))
                                 (byte (cond
                                   ((< byte-at length)
                                    (let ((unit (string-code-unit-at input
                                                  (js-call globalThis.Math :floor (/ byte-at 2)))))
                                      (if (= (bit-and byte-at 1) 0) (bit-and unit 255)
                                        (unsigned-bit-shift-right unit 8))))
                                   ((= byte-at length) 128)
                                   (t 0))))
                            (setq word (uint32 (+ (* word 256) byte))))
                          (setq j (1+ j)))
                        word)))))
              (js-call words :push value))
            (setq i (1+ i)))
          (compress-block hash words))
        (setq offset (+ offset 64)))
      (hash-output hash)))

  (export sha256-bytes sha256-words-le sha256-string-utf16le))
