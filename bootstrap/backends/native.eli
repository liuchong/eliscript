         (expression state (js-nth 1 children)) (pop-value state "u32")
         (when (= name "word-div") (memory-conditional-error state 889192448 2))
         (word state (cond ((= name "word-div") 448792608) ((= name "word-shr") 448799776)
           ((= name "word-shl") 448798752) ((= name "word-and") 167772192)
           ((= name "word-or") 704643104) ((= name "word-xor") 1241514016)
           (t (backend-fail node "unsupported native memory32 opcode"))))))))

