          (unless (or (= kind "literal") (= kind "local") (= kind "arithmetic")) (setq valid nil))
          (while (and valid (< i (js-length children)))
            (setq valid (cache-value state (js-nth i children))) (setq i (1+ i)))
          valid))))

  (defun retarget-last (state register)
    (let* ((words (get state :words)) (at (1- (js-length words))))
      (js-call words :splice at 1 (bit-or (bit-and (js-nth at words) 4294967264) register))))

  (defun writes-physical (state node register)
