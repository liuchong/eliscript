          (word state 2852127731) ;; mov x19,x0
          (while (< j arity)
            (if (< j 7) (word state (+ 704644064 (* (1+ j) 65536)))
              (progn (integer-register state 9 (+ 16 (* (- j 7) slot-size)) 0)
