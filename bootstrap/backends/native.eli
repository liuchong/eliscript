         ;; adding the host pointer, including near-4GiB wrapping addresses.
         (word state (+ 2432696330 (* width 1024))) ;; add x10,x0,#width
         (word state 4181722731) (word state 3943367007)
         (memory-conditional-error state 1409286153 1) ;; b.ls safe
         (word state 4181721705) (word state 2332033321)
         (word state (cond ((= name "load-u8") 960495904) ((= name "load-u16") 2034237728)
           ((= name "load-u32") 3107979552) ((= name "load-f64") 4248830240)
           ((= name "store-u8") 956301602) ((= name "store-u16") 2030043426)
           ((= name "store-u32") 3103785250) (t 4244635938)))
