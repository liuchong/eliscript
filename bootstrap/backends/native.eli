        (word state 3019898893) ;; cbz x13, done
        (word state 4181721707) ;; ldr x11,[x19] (base)
        (word state 2332033385) ;; add x9,x11,x0 (dst_ptr)
        (word state 2332950890) ;; add x10,x11,x14 (src_ptr)
        (word state 3943301439) ;; cmp x9,x10
        (let ((backward (js-length (get state :words))))
          (word state 1409286152) ;; b.hi backward (dst_ptr > src_ptr)
          ;; Forward 32B + 8B + 1B loop (memmove-exact when dst_ptr <= src_ptr)
          (let ((fwd32 (js-length (get state :words))))
            (word state 4043342271) ;; cmp x13,#32
            (let ((fwd8-skip (js-length (get state :words))))
              (word state 1409286147) ;; b.lo fwd8
              (word state 2831236428) ;; ldp x12,x15,[x10],#16
              (word state 2827042092) ;; stp x12,x15,[x9],#16
              (word state 2831236428) ;; ldp x12,x15,[x10],#16
              (word state 2827042092) ;; stp x12,x15,[x9],#16
              (word state 3506471341) ;; sub x13,x13,#32
              (let ((back32 (jump state "jump"))) (patch-jump state back32 fwd32))
