  (defun native-phase (observer phase count words branches calls)
    (when (= (value-type observer) "function")
      (try
        (funcall observer phase (js-object :count count :words words :branches branches :calls calls))
        (catch ignored nil))) nil)

  (defun native-memory-prepare (program observer &optional fresh)
    (native-phase observer "native-prepare-start" 0 0 0 0)
    (let ((prepared (if fresh (memory-prepare-fresh-program program) (memory-prepare-program program))))
      (native-phase observer "native-prepare-complete" (js-length (get prepared :functions)) 0 0 0)
      prepared))

  (defun native-memory-container (program code target format options observer)
    (let ((word-count (js-length (get code :words))))
      (native-phase observer "native-container-start" (js-length (get program :functions)) word-count 0 0)
      (let ((bytes (if (= target "arm64-linux")
                   (if (= format "object") (emit-elf-object program code options) (emit-elf-library program code options))
                 (if (= format "object") (macho-object program code options) (macho-library program code nil options)))))
        (native-phase observer "native-container-complete" (js-length (get program :functions)) word-count 0 0)
        ;; All consumers of this private code image have finished. Public typed
        ;; input, completed bytes and exact source-map ranges retain their own
        ;; data; building the final debug document no longer needs this root.
        (put code :words nil) bytes)))

  (defun memory-code (program &optional target options observer)
