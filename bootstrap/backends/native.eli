      ((= (bit-and opcode 2113929216) 872415232) 2) ;; CBZ / CBNZ: imm19
      ((= (bit-and opcode 2113929216) 905969664) 3) ;; TBZ / TBNZ: imm14
      (t (backend-fail nil "unsupported native branch instruction"))))

  (defun branch-limit (kind)
