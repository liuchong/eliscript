            (word state 3019898893) ;; cbz x13, done
            (word state 4181721705) ;; ldr x9,[x19]
            (word state 2332033321) ;; add x9,x9,x0
            (let ((fill32 (js-length (get state :words))))
              (word state 4043342271) ;; cmp x13,#32
              (let ((fill8 (js-length (get state :words))))
                (word state 1409286147) ;; b.lo fill8
                (word state 2827058495) ;; stp xzr,xzr,[x9],#16
                (word state 2827058495) ;; stp xzr,xzr,[x9],#16
                (word state 3506471341) ;; sub x13,x13,#32
                (let ((back32 (jump state "jump"))) (patch-jump state back32 fill32))
                (patch-jump state fill8 (js-length (get state :words)))))
            (let ((fill8 (js-length (get state :words))))
              (word state 4043317695) ;; cmp x13,#8
              (let ((fill1 (js-length (get state :words))))
                (word state 1409286147) ;; b.lo fill1
                (word state 4160783679) ;; str xzr,[x9],#8
                (word state 3506446765) ;; sub x13,x13,#8
                (let ((back8 (jump state "jump"))) (patch-jump state back8 fill8))
                (patch-jump state fill1 (js-length (get state :words)))))
            (let ((fill-done (js-length (get state :words))))
              (word state 3019898893) ;; cbz x13, fill-done
              (let ((fill1-loop (js-length (get state :words))))
                (word state 939529535) ;; strb wzr,[x9],#1
                (word state 4043310509) ;; subs x13,x13,#1
                (let ((back1 (js-length (get state :words))))
                  (word state 1409286145) (patch-jump state back1 fill1-loop)))
              (patch-jump state fill-done (js-length (get state :words))))
            (patch-jump state done (js-length (get state :words)))))
        (progn
          (expression state (js-nth 0 children)) (push-value state "u32")
          (expression state (js-nth 1 children)) (push-value state "u32")
          (expression state (js-nth 2 children))
          (word state 704644077) ;; mov w13,w0 (len, zero-extended in x13)
          (pop-value state "u32")
          (word state 704709612) ;; mov w12,w1 (byte val)
          (pop-value state "u32")
          (word state 704709600) ;; mov w0,w1  (dst, zero-extended in x0)
          (word state 2332885002) ;; add x10,x0,x13
          (word state 4181722731) ;; ldr x11,[x19,#8]
          (word state 3943367007) ;; cmp x10,x11
          (memory-conditional-error state 1409286153 1) ;; b.ls
          (let ((done (js-length (get state :words))))
            (word state 3019898893) ;; cbz x13, done
            (word state 4181721705) ;; ldr x9,[x19]
            (word state 2332033321) ;; add x9,x9,x0
            (word state 3544194444) ;; and x12,x12,#0xff
            (integer-register state 10 16843009 16843009) ;; x10 = 0x0101010101010101
            (word state 2601155980) ;; mul x12,x12,x10
            (let ((fill32 (js-length (get state :words))))
              (word state 4043342271) ;; cmp x13,#32
              (let ((fill8 (js-length (get state :words))))
                (word state 1409286147) ;; b.lo fill8
                (word state 2827039020) ;; stp x12,x12,[x9],#16
                (word state 2827039020) ;; stp x12,x12,[x9],#16
                (word state 3506471341) ;; sub x13,x13,#32
                (let ((back32 (jump state "jump"))) (patch-jump state back32 fill32))
                (patch-jump state fill8 (js-length (get state :words)))))
            (let ((fill8 (js-length (get state :words))))
              (word state 4043317695) ;; cmp x13,#8
              (let ((fill1 (js-length (get state :words))))
                (word state 1409286147) ;; b.lo fill1
                (word state 4160783660) ;; str x12,[x9],#8
                (word state 3506446765) ;; sub x13,x13,#8
                (let ((back8 (jump state "jump"))) (patch-jump state back8 fill8))
