          (word state 2483027968) (js-call (get state :calls) :push (js-object :at at :target (get node :value)))))
      (when (or indirect (get layout :hasStack) (get layout :hasFpr))
        (stack-adjust state (+ extra (* count 16)) nil)
        (put state :depth (- (get state :depth) count)))
      (word state 3107986025)
      (let ((at (js-length (get state :words))))
        (word state 889192457) (js-call (get state :memoryErrors) :push at))
      (when (and (get state :pinMemory nil)
