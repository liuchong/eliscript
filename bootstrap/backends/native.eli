(module eliscript.backend.native
  (import "./optimize.mjs" optimize-program)
  (import "./numeric.mjs" lower-numeric-program optimize-numeric-program numeric-pure backend-fail find-function runtime-body-cache-get)
  (import "./sha256.mjs" sha256-bytes sha256-words-le sha256-string-utf16le)
  (import "./memory.mjs" lower-memory-program)
  (import "./elf.mjs" emit-elf-object emit-elf-library)
  (import "./capabilities.mjs" prepare-host-capabilities prepare-fresh-host-capabilities host-capability-index)
  (import "./binary.mjs" binary-output binary-byte binary-u32 binary-append binary-append-owned binary-slice binary-to-array binary-finish)

  ;; ARM64 numeric-f64 instruction and Mach-O image emission. Selection,
  ;; encoding, linking metadata and ad-hoc page signatures are independent.
  ;; A memory image owns immutable 1024-word UTF16 blocks and one mutable
  ;; block. Relocations may revisit any block, but never unpack the image.
  ;; Numeric assembly helpers keep their existing ordinary-array contract.
  (defun native-word-buffer ()
    (js-object :length 0 :chunks (js-array) :cache (js-array) :units (js-array) :cacheIndex -1 :dirty false :hasHole false))

  (defun native-word-flush (words)
    (when (get words :dirty)
      (let ((cache (get words :cache)) (units (get words :units nil)) (index 0))
        (unless units (setq units (js-array)) (put words :units units))
        (put units :length 0)
        (while (< index (js-length cache))
          (unless (Object/hasOwn cache index) (backend-fail nil "native word buffer contains an unwritten word"))
          (let ((value (js-nth index cache)))
            (js-call units :push (bit-and value 65535) (unsigned-bit-shift-right value 16)))
          (setq index (1+ index)))
        (put (get words :chunks) (get words :cacheIndex)
          (Reflect/apply (get globalThis.String :fromCharCode) nil units))
        (put words :dirty false))) words)

  (defun native-word-cache (words block)
    (unless (= block (get words :cacheIndex))
      (native-word-flush words)
      (let ((text (js-nth block (get words :chunks))) (cache (get words :cache)) (index 0))
        ;; The preceding flush published an immutable string. Both numeric
        ;; scratch arrays are private to this buffer and bounded by one block.
        (put cache :length 0)
        (when (= (value-type text) "string")
          (while (< index (js-length text))
            (js-call cache :push (+ (string-code-unit-at text index)
              (* (string-code-unit-at text (1+ index)) 65536)))
            (setq index (+ index 2))))
        (put words :cacheIndex block)))
    (get words :cache))

  (defun native-word-at (words index)
    (if (Array/isArray words) (js-nth index words)
      (progn
        (unless (and (Number/isSafeInteger index) (>= index 0) (< index (js-length words)))
          (backend-fail nil "native word buffer index is out of range"))
        (let ((block (js-call globalThis.Math :floor (/ index 1024))) (offset (% index 1024)))
          (if (= block (get words :cacheIndex))
            (let ((cache (get words :cache)))
              (unless (Object/hasOwn cache offset) (backend-fail nil "native word buffer contains an unwritten word"))
              (js-nth offset cache))
            (let ((text (js-nth block (get words :chunks))))
              (unless (and (= (value-type text) "string") (< (1+ (* offset 2)) (js-length text)))
                (backend-fail nil "native word buffer contains an unwritten word"))
              (+ (string-code-unit-at text (* offset 2))
                (* (string-code-unit-at text (1+ (* offset 2))) 65536))))))))

  (defun native-word-set (words index value)
    (if (Array/isArray words) (put words index value)
      (progn
        (unless (and (Number/isSafeInteger index) (>= index 0) (< index (js-length words)))
          (backend-fail nil "native word buffer index is out of range"))
        (put (native-word-cache words (js-call globalThis.Math :floor (/ index 1024))) (% index 1024) (uint32 value))
        (put words :dirty t))) value)

  (defun native-word-resize (words length)
    (if (Array/isArray words) (put words :length length)
      (progn
        (unless (and (Number/isSafeInteger length) (>= length 0))
          (backend-fail nil "native word buffer length is invalid"))
        (when (> length (js-length words))
          (put words :hasHole t))
        (when (< length (js-length words))
          (let ((block (js-call globalThis.Math :floor (/ length 1024))) (tail (% length 1024))
                (cached (get words :cacheIndex)) (chunks (get words :chunks)))
            (when (< (* cached 1024) length)
              (when (= cached block)
                (let ((cache (get words :cache)))
                  (when (> (js-length cache) tail) (put cache :length tail))))
              (native-word-flush words))
            (put (get words :cache) :length 0) (put words :cacheIndex -1) (put words :dirty false)
            (put chunks :length (+ block (if (> tail 0) 1 0)))
            (when (and (> tail 0) (= (value-type (js-nth block chunks)) "string"))
              (put chunks block (js-call (js-nth block chunks) :slice 0 (* tail 2))))))
        (put words :length length))) length)

  (defun native-word-push (words value)
    (if (Array/isArray words) (js-call words :push (uint32 value))
      (let ((index (js-length words)))
        (put words :length (1+ index))
        (native-word-set words index value)
        (js-length words))))

  (defun native-word-append-u32 (words u32arr)
    (let ((len (js-length u32arr)) (src 0))
      (if (Array/isArray words)
        (while (< src len)
          (js-call words :push (uint32 (aref u32arr src)))
          (setq src (1+ src)))
        (let ((pos (js-length words)))
          (while (< src len)
            (let* ((block (js-call globalThis.Math :floor (/ pos 1024)))
                   (offset (% pos 1024))
                   (room (- 1024 offset))
                   (take (if (< (- len src) room) (- len src) room))
                   (cache (native-word-cache words block))
                   (end (+ offset take))
                   (dst offset))
              (while (< dst end)
                (put cache dst (aref u32arr src))
                (setq dst (1+ dst) src (1+ src)))
              (put words :dirty t)
              (setq pos (+ pos take))))
          (put words :length pos)))
      (js-length words)))

  (defun word (state value)
    (native-word-push (get state :words) value))

  (defun native-append-words (output words)
    (if (or (Array/isArray output) (Array/isArray words))
      (let ((index 0))
        (while (< index (js-length words))
          (binary-u32 output (native-word-at words index)) (setq index (1+ index))))
      (progn
        ;; Both are emitter-owned writers. Publish the final mutable word block
        ;; before sharing its immutable UTF16 strings. The temporary byte view
        ;; owns only its fields: consuming it never clears words.chunks/cache.
        ;; Aligned Mach-O text transfers whole strings; the object prefix uses
        ;; binary's bounded carry without constructing a complete byte copy.
        (native-word-flush words)
        (binary-append-owned output (js-object :length (* (js-length words) 4)
          :chunks (get words :chunks) :pending (js-array) :low -1)))) output)

  (defun u32 (bytes value)
    (binary-u32 bytes value))

  (defun u64 (bytes value)
    (u32 bytes (uint32 value))
    (u32 bytes (uint32 (/ value 4294967296))))

  (defun zeros (bytes count)
    (let ((i 0)) (while (< i count) (binary-byte bytes 0) (setq i (1+ i)))))

  (defun ascii-field (bytes name width)
    (let ((i 0))
      (while (< i width)
        (binary-byte bytes (if (< i (js-length name)) (string-code-unit-at name i) 0))
        (setq i (1+ i)))))

  (defun string-bytes (bytes name)
    (let ((i 0))
      (while (< i (js-length name))
        (let ((code (string-code-unit-at name i)))
          (when (= code 0) (backend-fail nil "native symbol contains NUL"))
          (when (and (>= code 55296) (<= code 56319))
            (let ((next (if (< (1+ i) (js-length name)) (string-code-unit-at name (1+ i)) 0)))
              (unless (and (>= next 56320) (<= next 57343))
                (backend-fail nil "native symbol contains an unpaired surrogate"))
              (setq code (+ 65536 (* (- code 55296) 1024) (- next 56320)))
              (setq i (1+ i))))
          (when (and (>= code 56320) (<= code 57343))
            (backend-fail nil "native symbol contains an unpaired surrogate"))
          (cond
            ((< code 128) (js-call bytes :push code))
            ((< code 2048) (js-call bytes :push
              (bit-or 192 (unsigned-bit-shift-right code 6)) (bit-or 128 (bit-and code 63))))
            ((< code 65536) (js-call bytes :push
              (bit-or 224 (unsigned-bit-shift-right code 12))
              (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63))
              (bit-or 128 (bit-and code 63))))
            (t (js-call bytes :push
              (bit-or 240 (unsigned-bit-shift-right code 18))
              (bit-or 128 (bit-and (unsigned-bit-shift-right code 12) 63))
              (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63))
              (bit-or 128 (bit-and code 63))))))
        (setq i (1+ i)))
      (js-call bytes :push 0)))

  (defun integer-register (state register low high)
    (word state (+ 3531603968 (* (bit-and low 65535) 32) register))
    (when (or (not (get state :compact nil)) (/= (unsigned-bit-shift-right low 16) 0))
      (word state (+ 4070572032 (* (unsigned-bit-shift-right low 16) 32) register)))
    (when (or (not (get state :compact nil)) (/= (bit-and high 65535) 0))
      (word state (+ 4072669184 (* (bit-and high 65535) 32) register)))
    (when (or (not (get state :compact nil)) (/= (unsigned-bit-shift-right high 16) 0))
      (word state (+ 4074766336 (* (unsigned-bit-shift-right high 16) 32) register))))

  (defun memory-integer-register (state register value)
    ;; Word values need only W-register writes, which also zero the upper half.
    ;; Keep integer-register's fixed-width sequences for relocatable placeholders.
    (let ((low (bit-and value 65535)) (high (unsigned-bit-shift-right value 16)))
      (if (and (= low 0) (/= high 0))
          (word state (+ 1386217472 (* high 32) register)) ;; movz Wd,#high,lsl #16
        (progn
          (word state (+ 1384120320 (* low 32) register)) ;; movz Wd,#low
          (when (/= high 0)
            (word state (+ 1923088384 (* high 32) register))))))) ;; movk Wd,#high,lsl #16

  (defun memory-wide-register (state register low high)
    ;; Exact 64-bit Val64 / bits64 constant materialization from two u32 halves.
    ;; Emits 1..4 instructions (movz on first nonzero 16-bit lane, movk on rest).
    (let ((h0 (bit-and low 65535))
          (h1 (unsigned-bit-shift-right low 16))
          (h2 (bit-and high 65535))
          (h3 (unsigned-bit-shift-right high 16))
          (started nil))
      (when (/= h0 0)
        (word state (+ 3531603968 (* h0 32) register))
        (setq started t))
      (when (/= h1 0)
        (word state (+ (if started 4070572032 3533701120) (* h1 32) register))
        (setq started t))
      (when (/= h2 0)
        (word state (+ (if started 4072669184 3535798272) (* h2 32) register))
        (setq started t))
      (when (/= h3 0)
        (word state (+ (if started 4074766336 3537895424) (* h3 32) register))
        (setq started t))
      (unless started
        (word state (+ 3531603968 register)))))

  (defun float-literal (state value)
    (let* ((bits (number-float64-words value)) (low (js-nth 0 bits)) (high (js-nth 1 bits)))
      (when (and (= value 0) (< (/ 1 value) 0)) (setq high 2147483648))
      (if (and (get state :compact nil) (= low 0) (= high 0))
          (word state 2657551328)
      (if (and (get state :compact nil) (= low 0) (= (bit-and high 65535) 0)
               (>= (bit-and (unsigned-bit-shift-right high 20) 2047) 1020)
               (<= (bit-and (unsigned-bit-shift-right high 20) 2047) 1027))
          (let* ((exponent (- (bit-and (unsigned-bit-shift-right high 20) 2047) 1023))
                 (immediate (+ (* (unsigned-bit-shift-right high 31) 128)
                   (if (< exponent 1) (+ 64 (* (+ exponent 3) 16)) (* (- exponent 1) 16))
                   (bit-and (unsigned-bit-shift-right high 16) 15))))
            (word state (+ 509612032 (* immediate 8192))))
      (if (get state :compact nil)
          (let ((constants (get state :constants)) (index 0) (found nil))
            (while (and (< index (js-length constants)) (not found))
              (let ((entry (js-nth index constants)))
                (when (and (= low (get entry :low)) (= high (get entry :high))) (setq found entry)))
              (setq index (1+ index)))
            (unless found
              (setq found (js-object :low low :high high :uses (js-array)))
              (js-call constants :push found))
            (js-call (get found :uses) :push (js-length (get state :words)))
            (word state 1543503872))
        (progn (integer-register state 9 low high) (word state 2657550624)))))))

  (defun literal-register (state value)
    (let* ((bits (number-float64-words value)) (entries (get state :literalRegisters (js-array)))
           (i 0) (register -1))
      (while (< i (js-length entries))
        (let ((entry (js-nth i entries)))
          (when (and (= (js-nth 0 bits) (get entry :low)) (= (js-nth 1 bits) (get entry :high)))
            (setq register (get entry :register))))
        (setq i (1+ i)))
      register))

  (defun collect-loop-literals (node depth entries)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0))
      (when (and (> depth 0) (= kind "literal") (= (get node :type) "f64") (/= (get node :value) 0))
        (let* ((bits (number-float64-words (get node :value))) (found nil) (j 0))
          (while (< j (js-length entries))
            (let ((entry (js-nth j entries)))
              (when (and (= (js-nth 0 bits) (get entry :low)) (= (js-nth 1 bits) (get entry :high)))
                (setq found entry)))
            (setq j (1+ j)))
          (if found (put found :weight (1+ (get found :weight)))
            (js-call entries :push (js-object :low (js-nth 0 bits) :high (js-nth 1 bits)
              :value (get node :value) :weight 1)))))
      (while (< i (js-length children))
        (collect-loop-literals (js-nth i children)
          (if (or (= kind "while") (= kind "remainder-while") (= kind "guarded-while")) (1+ depth) depth) entries)
        (setq i (1+ i)))))

  (defun allocate-literal-registers (state body)
    ;; Only unused allocated-class registers are available. Loop constants are
    ;; immutable, bit-exact and initialized after all incoming arguments.
    (let ((entries (js-array)) (selected (js-array)) (registers (get state :registers))
          (r 31))
      (collect-loop-literals body 0 entries)
      (while (and (>= r 2) (> (js-length entries) 0))
        (when (and (or (< r 16) (>= r 24)) (not (js-call registers :includes r)))
          (let ((best 0) (j 1))
            (while (< j (js-length entries))
              (when (> (get (js-nth j entries) :weight) (get (js-nth best entries) :weight)) (setq best j))
              (setq j (1+ j)))
            (let ((entry (js-nth best entries)))
              (put entry :register r) (js-call selected :push entry) (js-call registers :push r)
              (js-call entries :splice best 1))))
        (setq r (1- r)))
      selected))

  (defun finish-literals (state)
    (let ((constants (get state :constants)) (words (get state :words)) (i 0))
      (when (and (> (js-length constants) 0) (/= (bit-and (js-length words) 1) 0))
        (word state 3573751839))
      (while (< i (js-length constants))
        (let* ((entry (js-nth i constants)) (target (js-length words)) (uses (get entry :uses)) (j 0))
          (while (< j (js-length uses))
            (let* ((at (js-nth j uses)) (distance (- target at)))
              (unless (and (>= distance -262144) (< distance 262144))
                (backend-fail nil "native literal exceeds ARM64 displacement range"))
              (native-word-set words at (bit-or (+ 1543503872 (bit-and (native-word-at words at) 31))
                (* (bit-and distance 524287) 32))))
            (setq j (1+ j)))
          (word state (get entry :low)) (word state (get entry :high)))
        (setq i (1+ i)))))

  (defun stack-adjust (state amount subtract)
    (while (> amount 0)
      (let ((part (if (< amount 4080) amount 4080)))
        (word state (+ (if subtract 3506439167 2432697343) (* part 1024)))
        (setq amount (- amount part)))))

  (defun push-value (state type)
    (let ((depth (get state :depth 0))
          (wide (or (= type "v64") (= type "bits64"))))
      (if (and (get state :leaf nil) (< depth 8))
          (word state (+ (if (= type "f64") 509624320 (if wide 2657550336 505872384)) (+ 16 depth)))
        (progn (stack-adjust state 16 t)
          (word state (if (= type "f64") 4244636640 (if wide 4177527776 3103785952)))))
      (put state :depth (1+ depth))))

  (defun pop-value (state type)
    (let ((depth (1- (get state :depth 1)))
          (wide (or (= type "v64") (= type "bits64"))))
      (put state :depth depth)
      (if (and (get state :leaf nil) (< depth 8))
          (word state (+ (if (= type "f64") 509624321 (if wide 2657484801 505806849)) (* (+ 16 depth) 32)))
        (progn (word state (if (= type "f64") 4248830945 (if wide 4181722081 3107980257)))
          (stack-adjust state 16 nil)))))

  (defun local-access (state index type store &optional operand)
    (let* ((registers (get state :registers (js-array)))
           (register (if (< index (js-length registers)) (js-nth index registers) -1))
           (wide (or (= type "v64") (= type "bits64")))
           (data (if (nullish? operand) 0 operand)))
      (if (<= register -2)
          (let ((physical (- (- register) 2)))
            (word state (+ (if wide 2852127712 704644064)
                           (if store physical data)
                           (* (if store data physical) 65536))))
      (if (>= register 0)
          (word state (if (= type "f64")
            (+ 509624320 (if store register (* register 32)))
            (if wide
              (if store (+ 2657550336 register) (+ 2657484800 (* register 32)))
              (if store (+ 505872384 register) (+ 505806848 (* register 32))))))
        (let* ((local-offsets (get state :localOffsets nil))
               (offset (if (and (get state :memory nil) local-offsets (< index (js-length local-offsets))
                                (> (js-nth index local-offsets) 0))
                           (js-nth index local-offsets)
                         (* (1+ index) 8))))
          (if (and (get state :memory nil) (<= offset 256))
              ;; LDUR/STUR use a signed nine-bit byte offset from FP (x29).
              ;; Rt is the low 5 bits; 31 is WZR/XZR.
              (word state (+ (if (= type "f64") (if store 4227858432 4232052736)
                                (if wide (if store 4160749568 4164943872)
                                  (if store 3087007744 3091202048)))
                             (* (bit-and (- offset) 511) 4096) 928 data))
            (progn
              (if (and (get state :memory nil) (<= offset 4095))
                  (word state (+ 3506439081 (* offset 1024))) ;; sub x9,x29,#offset
                (progn
                  (integer-register state 9 offset 0)
                  (word state 3406365609))) ;; sub x9,x29,x9
              (word state (+ (if (= type "f64") (if store 4244635936 4248830240)
                            (if wide (if store 4177527072 4181721376)
                              (if store 3103785248 3107979552))) data)))))))))

  (defun register-weights (node counts)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0) (call (= (get node :kind) "call")))
      (when (or (= kind "local") (= kind "set") (= kind "initialize"))
        (let ((index (get node :value)))
          (js-call counts :splice index 1 (1+ (js-nth index counts)))))
      (while (< i (js-length children))
        (when (register-weights (js-nth i children) counts) (setq call t))
        (setq i (1+ i)))
      call))

  (defun memory-register-weights (node counts weight)
    (let* ((kind (get node :kind)) (children (get node :children)) (i 0)
           (loop (or (= kind "while") (= kind "remainder-while") (= kind "guarded-while")))
           (child-weight (if loop (Math/min 1024 (* weight 8)) weight)))
      (when (or (= kind "local") (= kind "set") (= kind "initialize"))
        (let ((index (get node :value)))
          (js-call counts :splice index 1 (+ (js-nth index counts) weight))))
      (while (< i (js-length children))
        (memory-register-weights (js-nth i children) counts child-weight)
        (setq i (1+ i)))))

  (defun live-union (left right)
    (let ((result (js-call left :slice)) (i 0))
      (while (< i (js-length right))
        (unless (js-call result :includes (js-nth i right)) (js-call result :push (js-nth i right)))
        (setq i (1+ i)))
      result))

  (defun interference (graph index live)
    (let ((i 0)) (while (< i (js-length live))
      (let ((other (js-nth i live)))
        (unless (= index other)
          (unless (js-call (js-nth index graph) :includes other) (js-call (js-nth index graph) :push other))
          (unless (js-call (js-nth other graph) :includes index) (js-call (js-nth other graph) :push index))))
      (setq i (1+ i)))))

  (defun live-before (node after graph)
    (let ((kind (get node :kind)) (children (get node :children)) (value (get node :value))
          (live (js-call after :slice)))
      (when (= kind "call")
        (put node :callLive (live-union (get node :callLive (js-array)) after)))
      (cond
        ((= kind "local") (interference graph value live)
          (unless (js-call live :includes value) (js-call live :push value)))
        ((or (= kind "set") (= kind "initialize"))
          (put node :storeLive (or (get node :storeLive nil) (js-call live :includes value)))
          (interference graph value live)
          (let ((at (js-call live :indexOf value))) (when (>= at 0) (js-call live :splice at 1)))
          (setq live (live-before (js-nth 0 children) live graph)))
        ((= kind "if")
          (setq live (live-before (js-nth 0 children)
            (live-union (live-before (js-nth 1 children) live graph)
                        (live-before (js-nth 2 children) live graph)) graph)))
        ((or (= kind "while") (= kind "remainder-while") (= kind "guarded-while"))
          (let ((changed t))
            (while changed
              (let* ((next (live-before (js-nth 0 children)
                            (live-union after (live-before (js-nth 1 children) live graph)) graph))
                     (joined (live-union live next)))
                (setq changed (/= (js-length joined) (js-length live)))
                (setq live joined)))))
        (t
          (let ((i (1- (js-length children))))
            (while (>= i 0)
              (setq live (live-before (js-nth i children)
                (if (or (= kind "and") (= kind "or")) (live-union after live) live) graph))
              (setq i (1- i))))))
      live))

  (defun allocate-registers (body locals arity)
    (let ((count (js-length locals)) (counts (js-array)) (registers (js-array))
          (available (js-array)) (integers (js-array)) (graph (js-array)) (i 0))
      (while (< i count) (js-call counts :push 0) (js-call registers :push -1)
        (js-call graph :push (js-array)) (setq i (1+ i)))
      (register-weights body counts)
      (live-before body (js-array) graph)
      ;; Entry argument capture materializes all live incoming parameters.
      (setq i 0)
      (while (< i arity) (let ((j 0)) (while (< j arity)
        (when (and (/= i j) (> (js-nth i counts) 0) (> (js-nth j counts) 0))
          (interference graph i (js-array j))) (setq j (1+ j)))) (setq i (1+ i)))
        (setq i 2)
        (while (< i 32)
          ;; d0/d1 and d16-d23 are expression temporaries. Actual calls
          ;; explicitly preserve allocated caller registers.
          (when (or (< i 16) (>= i 24))
            (js-call available :push i))
          (setq i (1+ i)))
      (setq i 10)
      (while (< i 29)
        (when (or (< i 16) (>= i 19)) (js-call integers :push i))
        (setq i (1+ i)))
      (assign-register-class counts locals registers available "f64" graph)
      (assign-register-class counts locals registers integers "i32" graph)
      (js-object :registers registers :leaf t)))

  (defun memory-bitset-copy (bits)
    (js-call bits :slice))

  (defun memory-bitset-union (left right words)
    (let ((out (js-call left :slice)) (w 0))
      (while (< w words)
        (put out w (bit-or (aref left w) (aref right w)))
        (setq w (1+ w)))
      out))

  (defun memory-bitset-disjoint-p (left right words)
    (let ((w 0) (disjoint t))
      (while (and disjoint (< w words))
        (when (/= (bit-and (aref left w) (aref right w)) 0)
          (setq disjoint nil))
        (setq w (1+ w)))
      disjoint))

  (defun memory-bitset-interfere (graph index live words)
    (let ((idx-word (unsigned-bit-shift-right index 5))
          (idx-bit (bit-shift-left 1 (bit-and index 31)))
          (row (js-nth index graph))
          (w 0))
      (while (< w words)
        (let* ((lw (aref live w))
               (masked (if (= w idx-word) (bit-and lw (bit-not idx-bit)) lw)))
          (when (/= masked 0)
            (put row w (bit-or (aref row w) masked))
            (let ((rem (bit-or masked 0)) (base-idx (* w 32)))
              (while (/= rem 0)
                (let* ((lsb (bit-and rem (- rem)))
                       (bit (- 31 (Math/clz32 lsb)))
                       (other (+ base-idx bit))
                       (orow (js-nth other graph)))
                  (put orow idx-word (bit-or (aref orow idx-word) idx-bit))
                  (setq rem (bit-xor rem lsb)))))))
        (setq w (1+ w)))))

  (defun memory-addr-base-local (node)
    (let ((kind (get node :kind)) (val (get node :value)) (children (get node :children)))
      (cond
        ((and (= kind "local") (memory-word-type (get node :type))) val)
        ((and (= kind "word-arithmetic") (= val "1+") (= (js-length children) 1)
              (memory-word-type (get node :type))
              (= (get (js-nth 0 children) :kind) "local")
              (memory-word-type (get (js-nth 0 children) :type)))
         (get (js-nth 0 children) :value))
        ((and (= kind "word-arithmetic") (= val "+") (= (js-length children) 2)
              (memory-word-type (get node :type)))
         (let ((left (js-nth 0 children)) (right (js-nth 1 children)))
           (cond
             ((and (= (get left :kind) "local") (memory-word-type (get left :type)) (>= (memory-word-imm12 right) 0))
              (get left :value))
             ((and (= (get right :kind) "local") (memory-word-type (get right :type)) (>= (memory-word-imm12 left) 0))
              (get right :value))
             (t -1))))
        (t -1))))

  (defun memory-live-before (node after graph words)
    (let ((kind (get node :kind)) (children (get node :children)) (value (get node :value))
          (live (memory-bitset-copy after)))
      (cond
        ((= kind "local")
          (memory-bitset-interfere graph value live words)
          (let ((w (unsigned-bit-shift-right value 5)) (b (bit-shift-left 1 (bit-and value 31))))
            (put live w (bit-or (aref live w) b))))
        ((or (= kind "set") (= kind "initialize"))
          (memory-bitset-interfere graph value live words)
          (let ((w (unsigned-bit-shift-right value 5)) (b (bit-shift-left 1 (bit-and value 31))))
            (put live w (bit-and (aref live w) (bit-not b))))
          (setq live (memory-live-before (js-nth 0 children) live graph words)))
        ((= kind "if")
          (let ((t-live (memory-live-before (js-nth 1 children) live graph words))
                (e-live (memory-live-before (js-nth 2 children) live graph words)))
            (setq live (memory-live-before (js-nth 0 children) (memory-bitset-union t-live e-live words) graph words))))
        ((or (= kind "while") (= kind "remainder-while") (= kind "guarded-while"))
          (let ((changed t))
            (while changed
              (setq changed nil)
              (let* ((body-in (memory-live-before (js-nth 1 children) live graph words))
                     (cond-after (memory-bitset-union after body-in words))
                     (next (memory-live-before (js-nth 0 children) cond-after graph words))
                     (w 0))
                (while (< w words)
                  (let* ((lw (aref live w)) (nw (bit-or lw (aref next w))))
                    (when (/= (bit-and nw (bit-not lw)) 0)
                      (put live w nw)
                      (setq changed t)))
                  (setq w (1+ w)))))))
        ((and (= kind "memory-op") (= (js-length children) 2) (> (memory-width value) 0))
          (let* ((c0 (js-nth 0 children))
                 (addr-idx (memory-addr-base-local c0)))
            (when (>= addr-idx 0)
              (let ((aw (unsigned-bit-shift-right addr-idx 5))
                    (ab (bit-shift-left 1 (bit-and addr-idx 31))))
                (put live aw (bit-or (aref live aw) ab))
                (memory-bitset-interfere graph addr-idx live words)))
            (setq live (memory-live-before (js-nth 1 children) live graph words))
            (setq live (memory-live-before c0 live graph words))))
        ((and (= (js-length children) 2)
              (or (= kind "word-compare") (= kind "v64-compare") (= kind "word-arithmetic") (= kind "memory-op"))
              (= (get (js-nth 0 children) :kind) "local")
              (not (memory-expr-writes-local-p (js-nth 1 children) (get (js-nth 0 children) :value))))
          (let* ((c0 (js-nth 0 children))
                 (lidx (get c0 :value))
                 (lw (unsigned-bit-shift-right lidx 5))
                 (lb (bit-shift-left 1 (bit-and lidx 31))))
            (put live lw (bit-or (aref live lw) lb))
            (memory-bitset-interfere graph lidx live words)
            (setq live (memory-live-before (js-nth 1 children) live graph words))
            (setq live (memory-live-before c0 live graph words))))
        (t
          (let ((i (1- (js-length children)))
                (short (or (= kind "and") (= kind "or"))))
            (while (>= i 0)
              (setq live (memory-live-before (js-nth i children)
                (if short (memory-bitset-union after live words) live) graph words))
              (setq i (1- i))))))
      live))

  (defun allocate-memory-registers (body locals &optional pin-memory arity)
    ;; Liveness-based graph coloring + weight ordering: hot loop locals win
    ;; callee-saved registers x20-x28, non-interfering lifetimes share
    ;; registers and stack spill slots, and definitely-initialized locals skip
    ;; redundant entry zero-initialization.
    (let ((count (js-length locals)))
      (if (= count 0)
        (js-object :registers (js-array) :saved 0 :offsets (js-array) :spilled 0 :noInit (js-array))
        (let* ((counts (js-call (new globalThis.Array count) :fill 0))
               (registers (js-call (new globalThis.Array count) :fill -1))
               (offsets (js-call (new globalThis.Array count) :fill 0))
               (no-init (js-call (new globalThis.Array count) :fill false))
               (words (Math/max 1 (Math/ceil (/ count 32))))
               (graph (new globalThis.Array count))
               (param-count (if (nullish? arity) 0 arity))
               (candidates (js-array))
               (index 0))
          (while (< index count)
            (put graph index (new globalThis.Uint32Array words))
            (setq index (1+ index)))
          (memory-register-weights body counts 1)
          (let* ((empty (new globalThis.Uint32Array words))
                 (entry-live (memory-live-before body empty graph words))
                 (entry-mask (memory-bitset-copy entry-live)))
            (setq index 0)
            (while (< index param-count)
              (let ((w (unsigned-bit-shift-right index 5))
                    (b (bit-shift-left 1 (bit-and index 31))))
                (put entry-mask w (bit-or (aref entry-mask w) b)))
              (setq index (1+ index)))
            (setq index 0)
            (while (< index count)
              (when (/= (bit-and (aref entry-mask (unsigned-bit-shift-right index 5))
                                 (bit-shift-left 1 (bit-and index 31))) 0)
                (memory-bitset-interfere graph index entry-mask words))
              (when (and (>= index param-count)
                         (= (bit-and (aref entry-live (unsigned-bit-shift-right index 5))
                                     (bit-shift-left 1 (bit-and index 31))) 0))
                (put no-init index t))
              (let ((type (get (js-nth index locals) :type)))
                (when (and (> (js-nth index counts) 1)
                           (or (memory-word-type type) (memory-wide-type type)))
                  (js-call candidates :push index)))
              (setq index (1+ index)))
            (js-call candidates :sort (lambda (left right)
              (- (js-nth right counts) (js-nth left counts))))
            (let* ((max-regs (if pin-memory 7 9))
                   (reg-masks (new globalThis.Array max-regs))
                   (max-reg -1)
                   (c-len (js-length candidates))
                   (ci 0))
              (setq index 0)
              (while (< index max-regs)
                (put reg-masks index (new globalThis.Uint32Array words))
                (setq index (1+ index)))
              (while (< ci c-len)
                (let ((cand (js-nth ci candidates)) (r 0) (placed nil))
                  (while (and (not placed) (< r max-regs))
                    (let ((rm (js-nth r reg-masks)))
                      (when (memory-bitset-disjoint-p (js-nth cand graph) rm words)
                        (put registers cand (- -22 r))
                        (let ((w (unsigned-bit-shift-right cand 5))
                              (b (bit-shift-left 1 (bit-and cand 31))))
                          (put rm w (bit-or (aref rm w) b)))
                        (when (> r max-reg) (setq max-reg r))
                        (setq placed t)))
                    (setq r (1+ r))))
                (setq ci (1+ ci)))
              (let ((slot-masks (js-array)))
                (setq index 0)
                (while (< index count)
                  (when (and (= (js-nth index registers) -1)
                             (or (< index param-count) (> (js-nth index counts) 0)))
                    (let ((s 0) (s-len (js-length slot-masks)) (placed nil)
                          (irow (js-nth index graph)))
                      (while (and (not placed) (< s s-len))
                        (let ((sm (js-nth s slot-masks)))
                          (when (memory-bitset-disjoint-p irow sm words)
                            (let ((w (unsigned-bit-shift-right index 5))
                                  (b (bit-shift-left 1 (bit-and index 31))))
                              (put sm w (bit-or (aref sm w) b)))
                            (put offsets index (* (1+ s) 8))
                            (setq placed t)))
                        (setq s (1+ s)))
                      (unless placed
                        (let ((sm (new globalThis.Uint32Array words)))
                          (put sm (unsigned-bit-shift-right index 5)
                               (bit-shift-left 1 (bit-and index 31)))
                          (js-call slot-masks :push sm)
                          (put offsets index (* (js-length slot-masks) 8))))))
                  (setq index (1+ index)))
                (js-object :registers registers :saved (if (>= max-reg 0) (1+ max-reg) 0)
                           :offsets offsets :spilled (js-length slot-masks) :noInit no-init))))))))

  (defun assign-register-class (counts locals registers available type graph)
    (let ((i 0) (count (js-length locals)) (processed (js-array)))
      (while (< i count)
        (let ((best -1) (weight 0) (j 0))
          (while (< j count)
            (when (and (= (get (js-nth j locals) :type) type) (not (js-call processed :includes j))
                       (> (js-nth j counts) weight))
              (setq best j) (setq weight (js-nth j counts)))
            (setq j (1+ j)))
          (when (>= best 0)
            (js-call processed :push best)
            (setq j 0)
            (while (and (< j (js-length available)) (= (js-nth best registers) -1))
              (let ((r (if (= type "f64") (js-nth j available) (- -2 (js-nth j available))))
                    (neighbors (js-nth best graph)) (k 0) (conflict nil))
                (while (< k (js-length neighbors))
                  (when (= (js-nth (js-nth k neighbors) registers) r) (setq conflict t))
                  (setq k (1+ k)))
                (unless conflict (js-call registers :splice best 1 r)))
              (setq j (1+ j)))))
        (setq i (1+ i)))
      registers))

  (defun preserve-registers (state count restore)
