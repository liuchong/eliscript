  (defun memory-word-type (type) (or (= type "u32") (= type "i32")))
  (defun memory-wide-type (type) (or (= type "v64") (= type "bits64")))
  (defun memory-scalar-type (type)
    (or (memory-word-type type) (memory-wide-type type) (= type "f64")))
  (defun memory-canonical-type (type)
    (if (memory-word-type type) "u32" type))
  (defun memory-same-abi-type (left right)
    (= (memory-canonical-type left) (memory-canonical-type right)))
  (defun function-param-types (function)
    (let* ((arity (get function :arity)) (locals (get function :locals))
           (types (js-array)) (i 0))
      (while (< i arity)
        (js-call types :push (memory-canonical-type (get (js-nth i locals) :type)))
        (setq i (1+ i)))
      types))
  (defun function-return-type (function)
    (memory-canonical-type (get (get function :body) :type)))
  (defun native-signature-key (param-types result-type)
    (let ((parts (js-array)) (i 0))
      (while (< i (js-length param-types))
        (js-call parts :push (memory-canonical-type (js-nth i param-types)))
        (setq i (1+ i)))
      (str (js-call parts :join ",") "->" (memory-canonical-type result-type))))
  (defun intern-native-signature (signature-map param-types result-type)
    (let* ((key (native-signature-key param-types result-type))
           (existing (js-call signature-map :get key)))
      (if (undefined? existing)
          (let ((id (get signature-map :size)))
            (js-call signature-map :set key id) id)
        existing)))

  (defun compute-native-param-layout (param-types linux)
    ;; ARM64 mixed-type ABI (ARM64-ABI-04):
    ;; x0 = native context pointer (x19).
    ;; Integer/word/wide arguments ("u32"/"i32"/"v64"/"bits64") allocate NGRN w1..w7 / x1..x7.
    ;; Floating-point arguments ("f64") allocate NSRN d0..d7 independently.
    ;; Overflow arguments spill to stack:
    ;;   - arm64-linux (AAPCS64): 8-byte aligned 8-byte stack slots for all spilled scalars.
    ;;   - arm64-macos (Apple ARM64 PCS): natural size & natural alignment (4B/align4 for u32/i32, 8B/align8 for v64/bits64/f64).
    (let ((slots (js-array)) (ngrn 1) (nsrn 0) (nsaa 0) (has-fpr nil) (i 0))
      (while (< i (js-length param-types))
        (let ((type (js-nth i param-types)))
          (if (= type "f64")
              (progn
                (setq has-fpr t)
                (if (< nsrn 8)
                    (progn
                      (js-call slots :push (js-object :kind "fpr" :reg nsrn :type "f64"))
                      (setq nsrn (1+ nsrn)))
                  (progn
                    (setq nsaa (* (js-call globalThis.Math :ceil (/ nsaa 8)) 8))
                    (js-call slots :push (js-object :kind "stack" :offset nsaa :type "f64"))
                    (setq nsaa (+ nsaa 8)))))
            (if (< ngrn 8)
                (progn
                  (js-call slots :push (js-object :kind "gpr" :reg ngrn :type type))
                  (setq ngrn (1+ ngrn)))
              (let ((align-bytes (if (or linux (memory-wide-type type)) 8 4))
                    (size-bytes (if (or linux (memory-wide-type type)) 8 4)))
                (setq nsaa (* (js-call globalThis.Math :ceil (/ nsaa align-bytes)) align-bytes))
                (js-call slots :push (js-object :kind "stack" :offset nsaa :type type))
                (setq nsaa (+ nsaa size-bytes))))))
        (setq i (1+ i)))
      (js-object :slots slots
        :stackBytes (* (js-call globalThis.Math :ceil (/ nsaa 16)) 16)
        :hasStack (> nsaa 0)
        :hasFpr has-fpr)))

  (defun emit-sp-address-x9 (state offset)
    (word state 2432697321) ;; mov x9, sp
    (let ((rem offset))
      (while (> rem 0)
        (let ((part (if (< rem 4095) rem 4095)))
          (word state (+ 2432696617 (* part 1024)))
          (setq rem (- rem part))))))

  (defun emit-sp-load (state type reg offset)
