                                    :constantFlow (get (or options (js-object)) :registerAllocation t)
                                    :parallelSingle (get (or options (js-object)) :registerAllocation t)
                                    :cyclicMultiple (get (or options (js-object)) :registerAllocation t)))))
      (if (= target "arm64-linux")
          (emit-elf-library typed-program (typed-code typed-program options) options)
        (macho-library typed-program (typed-code typed-program options) nil options))))

  (defun emit-native-numeric-executable (program target entry &optional options)
    (unless (= target "arm64-macos") (backend-fail program "native target must be explicit arm64-macos"))
    (lower-numeric-program program)
    (let* ((typed-program (optimize-numeric-program (lower-numeric-program (optimize-program program))
                         (js-object :unswitch (get (or options (js-object)) :registerAllocation t)
                                    :constantFlow (get (or options (js-object)) :registerAllocation t)
                                    :parallelSingle (get (or options (js-object)) :registerAllocation t)
                                    :cyclicMultiple (get (or options (js-object)) :registerAllocation t))))
           (function (find-function (get typed-program :functions) entry)))
      (unless (and function (= (get function :arity) 0)
                   (js-call (get typed-program :exports) :includes entry))
        (backend-fail program "native executable entry must be an exported zero-argument f64 function"))
      (let* ((code (typed-code typed-program options)) (words (get code :words))
             (start (* (js-length words) 4)) (state (js-object :words words)))
        (let ((call (js-length words)))
          (word state 2483027968)
          (patch-jump state call (/ (js-nth (get function :index) (get code :offsets)) 4)))
        (stack-adjust state 16 t) (word state 4244636640)
        (integer-register state 0 1 0) (word state 2432697313)
        (integer-register state 2 8 0) (integer-register state 16 4 0)
        (word state 3556773889)
        ;; A short or failed write is observable as a nonzero process status.
        (word state 4043317279)
        (let ((failed (js-length words)))
          (word state 1409286145)
          (integer-register state 0 0 0) (integer-register state 16 1 0)
          (word state 3556773889)
          (patch-jump state failed (js-length words))
          (integer-register state 0 1 0) (integer-register state 16 1 0)
          (word state 3556773889))
        (finish-branches state (js-array))
        (put code :words (get state :words))
        (macho-library typed-program code start options))))


  ;; memory-u32 native ABI: x0 is a caller-owned, nonmoving context:
  ;; [0] byte pointer, [8] current byte length, [16] capacity, [24] error u32.
  ;; Explicit u32 arguments use w1..w7, then Darwin's packed 4-byte slots or
  ;; AAPCS64's 8-byte stack slots selected explicitly by the Linux target.
  ;; Programs with explicit host capabilities additionally read callback@32.
  ;; Debug artifacts use the reserved padding word@28 for trap site ID + 1.
  ;; A zero padding word means that no precise native site was recorded.
  ;; Pure programs retain the original 32-byte context and no host dependency.
  ;; Every nested call receives the same context; growth zeroes exposed bytes.
  (defun memory-error (state code)
    (memory-integer-register state 9 code)
    (word state 3103791721) ;; str w9, [x19, #24]
    (let ((sites (get state :trapSites nil)))
      (when sites
        (memory-integer-register state 9 (1+ (js-length sites)))
        (let ((range (js-object :kind "trap-site" :function (get state :debugFunction)
                       :functionIndex (get state :debugFunctionIndex) :depth (get state :debugDepth 0)
                       :start (* 4 (js-length (get state :words))) :end (+ 4 (* 4 (js-length (get state :words))))
                       :span nil :code code :site (1+ (js-length sites)))))
          (js-call sites :push range) (js-call (get state :debugRanges) :push range))
        (word state 3103792745))) ;; str w9, [x19, #28]
    (js-call (get state :memoryErrors) :push (jump state "jump")))

  (defun memory-conditional-error (state opcode code)
    (let ((safe (js-length (get state :words))))
      (word state opcode)
      (memory-error state code)
      (patch-jump state safe (js-length (get state :words)))))

  (defun memory-width (name)
    (cond ((or (= name "load-u8") (= name "store-u8")) 1)
      ((or (= name "load-u16") (= name "store-u16")) 2)
      ((or (= name "load-u32") (= name "store-u32")) 4)
      ((or (= name "load-f64") (= name "store-f64")) 8) (t 0)))

  (defun memory-data-copy (state node)
    (let* ((text (get node :value)) (length (js-length text)) (index 0))
      ;; The destination may call, trap or grow memory. Evaluate it once before
      ;; loading the current base/length, and check the complete byte range in
      ;; x registers before the first store. Even an empty copy checks its end.
      (expression state (js-nth 0 (get node :children)))
      (memory-integer-register state 10 (* length 2))
      (word state 2332688394) ;; add x10,x0,x10; no u32 end-address wrap
      (word state 4181722731) ;; ldr x11,[x19,#8]
      (word state 3943367007) ;; cmp x10,x11
      (memory-conditional-error state 1409286153 1) ;; b.ls
      (when (> length 0)
        (word state 4181721705) ;; ldr x9,[x19]
        (word state 2332033321) ;; add x9,x9,x0
        (while (< index length)
          (let* ((count (js-call globalThis.Math :min 16384 (- length index)))
                 (end (+ index count)) (cursor index) (skip nil)
                 (data-start 0))
            ;; Each immutable UTF16LE block is at most 32 KiB. Its adjacent ADR
            ;; and unconditional branch stay short regardless of total source
            ;; size or relaxation elsewhere. No pointer relocation or writable
            ;; linear-memory constant pool can corrupt the next invocation.
            (word state 268435530) ;; adr x10,.+8
            (setq skip (jump state "jump"))
            (setq data-start (* 4 (js-length (get state :words))))
            (while (< cursor end)
              (word state (bit-or (string-code-unit-at text cursor)
                (if (< (1+ cursor) end) (* (string-code-unit-at text (1+ cursor)) 65536) 0)))
              (setq cursor (+ cursor 2)))
            (when (get state :debugRanges nil)
              (js-call (get state :debugRanges) :push
                (js-object :kind "static-data" :dataKind "utf16le"
                  :function (get state :debugFunction) :functionIndex (get state :debugFunctionIndex)
                  :depth (get state :debugDepth 0) :start data-start
                  :end (* 4 (js-length (get state :words))) :span nil)))
            (patch-jump state skip (js-length (get state :words)))
            (memory-integer-register state 11 count)
            (let ((loop (js-length (get state :words))) (again nil))
              ;; Unaligned halfword accesses have the same normal-memory
              ;; contract as load/store-u16, including lone surrogate units.
              (word state 2034237772) ;; ldrh w12,[x10]
              (word state 2030043436) ;; strh w12,[x9]
              (word state 2432698698) ;; add x10,x10,#2
              (word state 2432698665) ;; add x9,x9,#2
              (word state 4043310443) ;; subs x11,x11,#1
              (setq again (js-length (get state :words)))
              (word state 1409286145) ;; b.ne loop
              (patch-jump state again loop))
            (setq index end))))
      (memory-integer-register state 0 0)))

  (defun memory-word (state node)
    (let* ((children (get node :children)) (count (js-length children)) (name (get node :value)))
      (if (= count 0)
          (if (get state :memory nil) (memory-integer-register state 0 (if (= name "*") 1 0))
            (integer-register state 0 (if (= name "*") 1 0) 0))
        (progn
          (expression state (js-nth 0 children))
          (cond
            ((= count 2)
             (let ((right (js-nth 1 children)))
               (if (and (get state :memory nil) (not (get state :compact nil))
                        (not (get state :leaf nil)) (= (js-length (get state :registers)) 0)
                        (memory-word-type (get right :type))
                        (or (= (get right :kind) "literal") (= (get right :kind) "local")))
                   ;; These RHS forms touch only x0/x9 in the memory backend.
                   ;; Capture the evaluated LHS without changing evaluation order.
                   (progn (word state 704644065) (expression state right)) ;; mov w1,w0
                 (progn
                   (push-value state "u32") (expression state right) (pop-value state "u32"))))
             (if (= (get node :kind) "word-compare")
                 (let ((code (cond ((= name "=") 0) ((= name "/=") 1) ((= name "<") 3)
                             ((= name "<=") 9) ((= name ">") 8) (t 2))))
                   (word state 1795162175)
                   (word state (+ 446629856 (* (bit-xor code 1) 4096))))
               (word state (cond ((= name "+") 184549408) ((= name "-") 1258291232) (t 453016608)))))
            ((= name "-") (word state 1258292192))
            ((= name "1+") (word state 285213696))
            ((= name "1-") (word state 1358955520)))))))

  (defun memory-grow (state node)
    (expression state (js-nth 0 (get node :children)))
    (word state 4181722731) ;; ldr x11, [x19, #8]
    (word state 4181723756) ;; ldr x12, [x19, #16]
    (word state 2332049770) ;; add x10, x11, x0, lsl #16
    (word state 3943432543) ;; cmp x10, x12
    (let ((failed (js-length (get state :words))))
      (word state 1409286152) ;; b.hi failure
      (word state 3545300320) ;; lsr x0, x11, #16 (old page count)
      (word state 4181721705) ;; ldr x9, [x19]
      (word state 2332754217) ;; add x9, x9, x11
      (word state 3406496076) ;; sub x12, x10, x11
      (let ((done (js-length (get state :words))))
        (word state 3019898892) ;; cbz x12, done
        (let ((loop (js-length (get state :words))))
          (word state 939529535) ;; strb wzr, [x9], #1
          (word state 4043310476) ;; subs x12, x12, #1
          (let ((back (js-length (get state :words))))
            (word state 1409286145) (patch-jump state back loop)))
        (patch-jump state done (js-length (get state :words))))
      (word state 4177528426) ;; str x10, [x19, #8]
      (let ((end (jump state "jump")))
        (patch-jump state failed (js-length (get state :words)))
        (memory-integer-register state 0 4294967295)
        (patch-jump state end (js-length (get state :words))))))

  (defun memory-f64-unary-instruction (name)
    ;; Arm A64 scalar FP one-source encoding, ftype=01, Rn=Rd=0.
    (cond ((= name "f64-abs") 509657088) ;; fabs d0,d0
      ((= name "f64-neg") 509689856) ;; fneg d0,d0
      ((= name "f64-ceil") 509919232) ;; frintp d0,d0
      ((= name "f64-floor") 509952000) ;; frintm d0,d0
      ((= name "f64-trunc") 509984768) ;; frintz d0,d0
      ((= name "f64-nearest") 509886464) ;; frintn d0,d0: ties to even
      ((= name "f64-sqrt") 509722624) ;; fsqrt d0,d0
      (t nil)))

  (defun memory-f64-unary (state node)
    (expression state (js-nth 0 (get node :children)))
    ;; The child completes before this instruction-local environment begins.
    ;; x9 is the existing scratch register; no calls, loads or branches can
    ;; leave this window without restoring the caller's exact FPCR. Zero
    ;; selects nearest-even sqrt, gradual underflow, ordinary NaN propagation
    ;; and disabled FP exception traps, independently of the embedding host.
    (word state 3577431049) ;; mrs x9,FPCR (0xd53b4409)
    (word state 3575333919) ;; msr FPCR,xzr (0xd51b441f)
    (word state (memory-f64-unary-instruction (get node :value)))
    (word state 3575333897)) ;; msr FPCR,x9 (0xd51b4409)

  (defun memory-operation (state node)
    (let* ((name (get node :value)) (children (get node :children)) (width (memory-width name))
           (store (= (js-length children) 2)))
      (cond
        ((memory-f64-unary-instruction name) (memory-f64-unary state node))
