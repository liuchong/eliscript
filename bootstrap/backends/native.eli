  (defun memory-host-call (state node)
    (let* ((children (get node :children))
           (index (host-capability-index (get state :hostCapabilities) node))
           (arg1-type (get (js-nth 1 children) :type)))
      (expression state (js-nth 0 children)) (push-value state "u32")
      (expression state (js-nth 1 children))
      ;; Pass complete 64-bit Val64 argument list in x3 (or zero-extended u32 if legacy test).
      (word state (if (memory-wide-type arg1-type) 2852127715 704644067))
      (pop-value state "u32")
      (word state 704709602) ;; mov w2,w1: heap
      (memory-integer-register state 1 index)
      (word state 2853372896) ;; mov x0,x19: native context
      (word state 4181725808) ;; ldr x16,[x19,#32]
      (memory-conditional-error state 3036676112 6) ;; cbnz x16, ready
      (word state 3594453504) ;; blr x16
      ;; FFI callbacks return normally; the loader retains the original thrown
      ;; host value and sets the trap latch before this epilogue boundary.
      (word state 3107986025)
      (let ((at (js-length (get state :words))))
        (word state 889192457) (js-call (get state :memoryErrors) :push at))
      (when (get state :pinMemory nil)
        (word state 4181722748))))

  (defun native-phase (observer phase count words branches calls)
    (when (= (value-type observer) "function")
      (try
        (funcall observer phase (js-object :count count :words words :branches branches :calls calls))
        (catch ignored nil))) nil)

  (defun native-memory-prepare (program observer &optional fresh)
    (native-phase observer "native-prepare-start" 0 0 0 0)
    (let ((prepared (if fresh (memory-prepare-fresh-program program) (memory-prepare-program program))))
      (native-phase observer "native-prepare-complete" (js-length (get prepared :functions)) 0 0 0)
      prepared))

  (defun native-memory-container (program code target format options observer)
    (let ((word-count (js-length (get code :words)))
          (ro-bytes (native-program-ro-bytes program options)))
      (native-phase observer "native-container-start" (js-length (get program :functions)) word-count 0 0)
      (let ((bytes (if (= target "arm64-linux")
                   (if (= format "object")
                       (emit-elf-object program code options ro-bytes)
                     (emit-elf-library program code options ro-bytes))
                 (if (= format "object") (macho-object program code options) (macho-library program code nil options)))))
        (native-phase observer "native-container-complete" (js-length (get program :functions)) word-count 0 0)
        ;; All consumers of this private code image have finished. Public typed
        ;; input, completed bytes and exact source-map ranges retain their own
        ;; data; building the final debug document no longer needs this root.
        (put code :words nil) bytes)))

  (defconst native-hot-leaf-names (new globalThis.Set (js-array
    "heap-block" "rt-root-scope-set-abs" "rt-root-scope-get-abs"
    "heap-ro-block" "heap-value-valid" "value-number-bits"
    "heap-number-from-word" "heap-number-word" "heap-number-uint" "heap-check"
    "heap-object-init-cell" "heap-string-cached-hash" "heap-object-builtin" "heap-key-equal"
    "heap-slot-index" "heap-handle" "heap-note-allocation"
    "val64-dynamic-p" "val64-inline-number-p" "val64-singleton-p"
    "heap-free-tree-maximum" "heap-free-tree-height"
    "heap-value-check" "heap-kind-check" "heap-base")))

  (defun memory-leaf-candidate (function self-index)
    (let* ((body (get function :body))
           (locals (get function :locals))
           (fname (get function :name nil))
           (hot-leaf (and (= (value-type fname) "string") (js-call native-hot-leaf-names :has fname)))
           (max-nodes (if hot-leaf 120 52))
           (max-calls (if hot-leaf 4 3))
           (pending (js-array body))
           (count 0)
           (calls 0)
           (valid (<= (js-length locals) 12)))
      (while (and valid (> (js-length pending) 0))
        (let* ((node (js-call pending :pop))
               (kind (get node :kind))
               (children (get node :children))
               (i 0))
          (setq count (1+ count))
          (when (= kind "call")
            (setq calls (1+ calls))
            (when (or (= (get node :value) self-index) (> calls max-calls))
              (setq valid nil)))
          (if (or (> count max-nodes)
                  (not valid)
                  (= kind "call-indirect") (= kind "host-call")
                  (= kind "while") (= kind "remainder-while") (= kind "guarded-while")
                  (= kind "memory-data-copy"))
              (setq valid nil)
            (while (< i (js-length children))
              (js-call pending :push (js-nth i children))
              (setq i (1+ i))))))
      (when valid (js-object :function function :size count))))

  (defun memory-uses-linear-p (node)
    (let ((pending (js-array node)) (found nil))
      (while (and (not found) (> (js-length pending) 0))
        (let* ((item (js-call pending :pop))
               (kind (get item :kind)))
          (if (and (= kind "memory-op")
                   (let ((op (get item :value)))
                     (or (> (memory-width op) 0) (= op "memory-grow"))))
              (setq found t)
            (let ((children (get item :children)) (i 0))
              (when (Array/isArray children)
                (while (< i (js-length children))
                  (js-call pending :push (js-nth i children))
                  (setq i (1+ i))))))))
      found))

  (defun memory-has-inline-site (node candidates self-index)
    (let ((pending (js-array node)) (found nil))
      (while (and (not found) (> (js-length pending) 0))
        (let* ((item (js-call pending :pop))
               (kind (get item :kind))
               (children (get item :children))
               (i 0))
          (if (and (= kind "call")
                   (/= (get item :value) self-index)
                   (not (nil? (js-nth (get item :value) candidates))))
              (setq found t)
            (while (< i (js-length children))
              (js-call pending :push (js-nth i children))
              (setq i (1+ i))))))
      found))

  (defun memory-shift-clone (node slot-map)
    (let* ((kind (get node :kind))
           (children (get node :children))
           (clen (js-length children))
           (is-local (or (= kind "local") (= kind "set") (= kind "initialize"))))
      (if (and (= clen 0) (not is-local))
        node
        (let ((new-children nil) (changed false) (i 0))
          (while (< i clen)
            (let* ((orig (js-nth i children))
                   (cloned (memory-shift-clone orig slot-map)))
              (when (not (eq cloned orig))
                (unless new-children (setq new-children (js-call children :slice)))
                (put new-children i cloned)
                (setq changed t)))
            (setq i (1+ i)))
          (if (and (not changed) (not is-local))
            node
            (let ((copy (Object/assign (js-object) node)))
              (put copy :children (or new-children children))
              (when is-local
                (put copy :value (js-nth (get node :value) slot-map)))
              copy))))))

  (defun memory-rewrite-inline (node candidates self-index locals budget pools cursors)
    (let* ((kind (get node :kind))
           (children (get node :children))
           (clen (js-length children))
           (control-flow (or (= kind "sequence") (= kind "if") (= kind "while")
                             (= kind "remainder-while") (= kind "guarded-while")))
           (new-children nil)
           (changed false)
           (i 0))
      (if control-flow
        (let ((peak (Object/assign (js-object) cursors)))
          (while (< i clen)
            (let* ((orig (js-nth i children))
                   (child-cursors (Object/assign (js-object) cursors))
                   (rewritten (memory-rewrite-inline orig candidates self-index locals budget pools child-cursors))
                   (pkeys (Object/keys child-cursors))
                   (pi 0))
              (while (< pi (js-length pkeys))
                (let* ((pk (js-nth pi pkeys))
                       (pv (get child-cursors pk 0)))
                  (when (> pv (get peak pk 0)) (put peak pk pv)))
                (setq pi (1+ pi)))
              (when (not (eq rewritten orig))
                (unless new-children (setq new-children (js-call children :slice)))
                (put new-children i rewritten)
                (setq changed t)))
            (setq i (1+ i)))
          (let ((pkeys (Object/keys peak)) (pi 0))
            (while (< pi (js-length pkeys))
              (let ((pk (js-nth pi pkeys)))
                (put cursors pk (get peak pk)))
              (setq pi (1+ pi)))))
        (while (< i clen)
          (let* ((orig (js-nth i children))
                 (rewritten (memory-rewrite-inline orig candidates self-index locals budget pools cursors)))
            (when (not (eq rewritten orig))
              (unless new-children (setq new-children (js-call children :slice)))
              (put new-children i rewritten)
              (setq changed t)))
          (setq i (1+ i))))
      (let* ((target-index (if (= kind "call") (get node :value) -1))
             (cand (when (and (= kind "call") (/= target-index self-index))
                     (js-nth target-index candidates)))
             (callee (when cand (get cand :function)))
             (callee-locals (when callee (get callee :locals))))
        (if (and cand
                 (<= (+ (get budget :added) (get cand :size)) (get budget :maxAdded)))
            (let ((tmp-cursors (Object/assign (js-object) cursors))
                  (new-needed 0)
                  (k 0))
              (while (< k (js-length callee-locals))
                (let* ((ltype (get (js-nth k callee-locals) :type))
                       (pool (get pools ltype))
                       (pos (get tmp-cursors ltype 0)))
                  (put tmp-cursors ltype (1+ pos))
                  (when (or (nil? pool) (>= pos (js-length pool)))
                    (setq new-needed (1+ new-needed))))
                (setq k (1+ k)))
              (if (> (+ (js-length locals) new-needed) (get budget :maxLocals))
                (if changed
                  (let ((copy (Object/assign (js-object) node)))
                    (put copy :children new-children)
                    copy)
                  node)
                (let ((callee-arity (get callee :arity))
                      (args (or new-children children))
                      (slot-map (js-array))
                      (seq-children (js-array)))
                  (setq k 0)
                  (while (< k (js-length callee-locals))
                    (let* ((ltype (get (js-nth k callee-locals) :type))
                           (pool (get pools ltype))
                           (pos (get cursors ltype 0))
                           (slot nil))
                      (unless pool
                        (setq pool (js-array))
                        (put pools ltype pool))
                      (if (< pos (js-length pool))
                        (setq slot (js-nth pos pool))
                        (progn
                          (setq slot (js-length locals))
                          (js-call locals :push (js-object :name (str "inline-" slot) :type ltype :index slot :noEntryInit t))
                          (js-call pool :push slot)))
                      (put cursors ltype (1+ pos))
                      (js-call slot-map :push slot)
                      (if (< k callee-arity)
                          (js-call seq-children :push
                            (js-object :kind "set" :type ltype :value slot
                                       :children (js-array (js-nth k args))))
                        (let ((zero-node (js-object :kind "literal" :type ltype
                                           :value (if (memory-wide-type ltype) (js-object :low 0 :high 0) 0)
                                           :children (js-array))))
                          (js-call seq-children :push
                            (js-object :kind "set" :type ltype :value slot
                                       :children (js-array zero-node))))))
                    (setq k (1+ k)))
                  (js-call seq-children :push (memory-shift-clone (get callee :body) slot-map))
                  (put budget :added (+ (get budget :added) (get cand :size)))
                  (js-object :kind "sequence" :type (get node :type) :children seq-children))))
          (if changed
            (let ((copy (Object/assign (js-object) node)))
              (put copy :children new-children)
              copy)
            node)))))

  (defun inline-memory-function (self-index raw-locals raw-body candidates)
    (when (memory-has-inline-site raw-body candidates self-index)
      (let* ((locals (js-call raw-locals :slice))
             (budget (js-object :added 0 :maxAdded 320 :maxLocals 80))
             (pools (js-object))
             (cursors (js-object))
             (body (memory-rewrite-inline raw-body candidates self-index locals budget pools cursors)))
        (js-object :locals locals :body body))))

  (defun emit-memory-function-into (state function i raw-locals raw-body inline-candidates linux debug offsets)
    (let* ((inlined (when inline-candidates
                      (inline-memory-function i raw-locals raw-body inline-candidates)))
           (locals (if inlined (get inlined :locals) raw-locals))
           (body (if inlined (get inlined :body) raw-body))
           (arity (get function :arity))
           (param-types (function-param-types function))
           (layout (compute-native-param-layout param-types linux))
           (slots (get layout :slots))
           (return-type (function-return-type function))
           (pin-memory (memory-uses-linear-p body))
           (allocation (allocate-memory-registers body locals pin-memory arity))
           (saved (get allocation :saved))
           (spilled (get allocation :spilled))
           (no-init (get allocation :noInit))
           (frame (* (js-call globalThis.Math :ceil (/ (+ (if pin-memory 3 1) saved spilled) 2)) 16)) (j 0)
           (save-regs (let ((regs (js-array 19)) (si 0))
                        (while (< si saved) (js-call regs :push (+ 20 si)) (setq si (1+ si)))
                        (when pin-memory (js-call regs :push 27) (js-call regs :push 28))
                        regs)))
      (when offsets (js-call offsets :push (* (js-length (get state :words)) 4)))
      (put state :registers (get allocation :registers))
      (put state :localOffsets (get allocation :offsets))
      (put state :depth 0) (put state :memoryErrors (js-array))
      (put state :pinMemory pin-memory) (put state :boundsErrors (js-array))
      (when debug
        (put state :debugFunction (get function :name)) (put state :debugFunctionIndex i)
        (put state :debugDepth 0)
        (let* ((source (get function :source nil))
               (range (js-object :kind "function" :function (get function :name) :functionIndex i :depth -1
                        :start (* 4 (js-length (get state :words))) :end 0
                        :span (get function :span (if source (get source :span nil) nil)))))
          (put state :debugFunctionRange range) (js-call (get state :debugRanges) :push range)))
      (word state 2847898621) (word state 2432697341)
      (stack-adjust state frame t)
      (let ((si 0) (slen (js-length save-regs)))
        (while (< si slen)
          (if (< (1+ si) slen)
            (progn
              (word state (+ 2835350496 (* si 32768) (* (js-nth (1+ si) save-regs) 1024) (js-nth si save-regs)))
              (setq si (+ si 2)))
            (progn
              (word state (+ 4177527776 (* si 1024) (js-nth si save-regs)))
              (setq si (1+ si))))))
      (word state 2852127731) ;; mov x19,x0
      (when pin-memory
        (word state 4181721723) ;; ldr x27,[x19,#0]
        (word state 4181722748)) ;; ldr x28,[x19,#8]
      (while (< j arity)
        (let* ((slot (js-nth j slots))
               (kind (get slot :kind))
               (local-type (get (js-nth j locals) :type)))
          (cond
            ((= kind "gpr")
             ;; The incoming GPR is killed only by the spill. Store it
             ;; directly instead of COPY into w0/x0 first.
             nil)
            ((= kind "fpr")
             (unless (= (get slot :reg) 0)
               (word state (+ 509624320 (* (get slot :reg) 32)))))
            (t
             (integer-register state 9 (+ 16 (get slot :offset)) 0)
             (word state 2332623785) ;; add x9, x29, x9
             (word state (if (= local-type "f64") 4248830240
                           (if (memory-wide-type local-type) 4181721376 3107979552)))))
          (local-access state j local-type t (if (= kind "gpr") (get slot :reg) 0))
          (setq j (1+ j))))
      ;; Typed memory IR follows WASM's zero-initialized local contract.
      ;; Managed error/frame slots can be read before any explicit store.
      (while (< j (js-length locals))
        (let* ((local (js-nth j locals))
               (type (get local :type)))
          (unless (or (get local :noEntryInit nil) (and no-init (js-nth j no-init)))
            (if (= type "f64")
                (progn (word state 2657551328) ;; fmov d0,xzr: positive zero
                  (local-access state j type t))
              ;; Initialize the register or frame slot directly from WZR/XZR.
              (local-access state j type t 31))))
        (setq j (1+ j)))
      (expression state body)
      (let ((normal (jump state "jump")))
        (when (> (js-length (get state :boundsErrors)) 0)
          (patch-conditions state (get state :boundsErrors) (js-length (get state :words)))
          (memory-integer-register state 9 1)
          (word state 3103791721))
        (patch-conditions state (get state :memoryErrors) (js-length (get state :words)))
        (if (= return-type "f64")
            (word state 2657551328)
          (memory-integer-register state 0 0))
        (patch-jump state normal (js-length (get state :words))))
      (if (<= frame 4095)
          (word state (+ 3506439081 (* frame 1024))) ;; sub x9,fp,#frame
        (progn (integer-register state 9 frame 0) (word state 3406365609))) ;; sub x9,fp,x9
      (let ((si 0) (slen (js-length save-regs)))
        (while (< si slen)
          (if (< (1+ si) slen)
            (progn
              (word state (+ 2839544096 (* si 32768) (* (js-nth (1+ si) save-regs) 1024) (js-nth si save-regs)))
              (setq si (+ si 2)))
            (progn
              (word state (+ 4181721376 (* si 1024) (js-nth si save-regs)))
              (setq si (1+ si))))))
      (word state 2432697279) (word state 2831252477) (word state 3596551104)
      (when debug
        (put (get state :debugFunctionRange) :end (* 4 (js-length (get state :words)))))))

  (defun pack-native-function-cache (fn-state &optional fn-name fn-arity fn-locals-len)
    (when (and (= (js-length (get fn-state :constants)) 0)
               (= (js-length (get fn-state :tableUses)) 0))
      (let* ((fn-branches (get fn-state :branches (js-array)))
             (bcount (js-length fn-branches))
             (all-fit t) (bi 0))
        (while (and all-fit (< bi bcount))
          (let ((b (js-nth bi fn-branches)))
            (unless (branch-fits (- (get b :target) (get b :at)) (branch-limit (get b :kind)))
              (setq all-fit false)))
          (setq bi (1+ bi)))
        (when all-fit
          (let* ((fn-calls (get fn-state :calls))
                 (ccount (js-length fn-calls))
                 (packed-calls (new globalThis.Uint32Array (* ccount 2)))
                 (packed-branches (new globalThis.Uint32Array (* bcount 4)))
                 (ci 0)
                 (fn-ranges (get fn-state :debugRanges nil)))
            (while (< ci ccount)
              (let ((c (js-nth ci fn-calls))
                    (off (* ci 2)))
                (put packed-calls off (get c :at))
                (put packed-calls (1+ off) (get c :target)))
              (setq ci (1+ ci)))
            (setq bi 0)
            (while (< bi bcount)
              (let ((b (js-nth bi fn-branches))
                    (off (* bi 4)))
                (put packed-branches off (get b :at))
                (put packed-branches (1+ off) (get b :target))
                (put packed-branches (+ off 2) (get b :opcode))
                (put packed-branches (+ off 3) (get b :kind)))
              (setq bi (1+ bi)))
            (let ((entry (js-object
                           :words (new globalThis.Uint32Array (get fn-state :words))
                           :calls packed-calls
                           :branches packed-branches)))
              (when fn-ranges
                (put entry :debugRanges fn-ranges)
                (put entry :functionName fn-name)
                (put entry :arity fn-arity)
                (put entry :localsLength fn-locals-len))
              entry))))))

  (defun replay-native-function-cache (state entry offsets &optional function)
    (let* ((base (js-length (get state :words)))
           (packed-calls (get entry :calls))
           (call-len (js-length packed-calls))
           (calls (get state :calls))
           (ci 0)
           (packed-branches (get entry :branches))
           (cached-ranges (get entry :debugRanges nil))
           (dst-ranges (get state :debugRanges nil)))
      (js-call offsets :push (* base 4))
      (native-word-append-u32 (get state :words) (get entry :words))
      (while (< ci call-len)
        (js-call calls :push (js-object :at (+ base (aref packed-calls ci)) :target (aref packed-calls (1+ ci))))
        (setq ci (+ ci 2)))
      (when (> (js-length packed-branches) 0)
        (js-call (get state :cachedBranches) :push (js-object :base base :branches packed-branches)))
      (when (and cached-ranges dst-ranges)
        (let* ((base-bytes (* base 4))
               (dst-sites (get state :trapSites nil))
               (source (when function (get function :source nil)))
               (fn-span (when function (get function :span (if source (get source :span nil) nil))))
               (ri 0)
               (rlen (js-length cached-ranges)))
          (while (< ri rlen)
            (let* ((r (js-nth ri cached-ranges))
                   (cloned (if (and (= ri 0) (= (get r :kind) "function") function)
                             (Object/assign (js-object) r
                               (js-object :start (+ base-bytes (get r :start))
                                          :end (+ base-bytes (get r :end))
                                          :span fn-span))
                             (Object/assign (js-object) r
                               (js-object :start (+ base-bytes (get r :start))
                                          :end (+ base-bytes (get r :end)))))))
              (js-call dst-ranges :push cloned)
              (when (and dst-sites (= (get cloned :kind) "trap-site"))
                (js-call dst-sites :push cloned)))
            (setq ri (1+ ri)))))))

  (defun compute-memory-may-grow (functions)
    (let* ((count (js-length functions))
           (grow (js-call (new globalThis.Array count) :fill false))
           (edges (new globalThis.Array count))
           (i 0))
      (while (< i count)
        (let ((deps (js-array)) (seen (new globalThis.Set))
              (pending (js-array (get (js-nth i functions) :body))))
          (while (> (js-length pending) 0)
            (let* ((item (js-call pending :pop))
                   (kind (get item :kind))
                   (children (get item :children))
                   (j 0))
              (cond
                ((or (= kind "host-call") (= kind "call-indirect")
                     (and (= kind "memory-op") (= (get item :value) "memory-grow")))
                 (put grow i t))
                ((= kind "call")
                 (let ((callee (get item :value)))
                   (unless (or (= callee i) (js-call seen :has callee))
                     (js-call seen :add callee)
                     (js-call deps :push callee)))))
              (when (Array/isArray children)
                (while (< j (js-length children))
                  (js-call pending :push (js-nth j children))
                  (setq j (1+ j))))))
          (put edges i deps))
        (setq i (1+ i)))
      (let ((changed t))
        (while changed
          (setq changed false i 0)
          (while (< i count)
            (unless (js-nth i grow)
              (let ((deps (js-nth i edges)) (k 0))
                (while (< k (js-length deps))
                  (when (js-nth (js-nth k deps) grow)
                    (put grow i t)
                    (setq changed t k (js-length deps)))
                  (setq k (1+ k)))))
            (setq i (1+ i)))))
      grow))

  (defun memory-code (program &optional target options observer)
    (let* ((linux (= target "arm64-linux"))
           (opts (or options (js-object)))
           (debug (get opts :debug nil))
           (functions (get program :functions))
           (rt-prefix-count (get program :rtPrefixCount 0))
           (optimize-memory (and (not debug) (>= (js-length functions) 16)))
           (may-grow (when optimize-memory (compute-memory-may-grow functions)))
           (mode-key (str (if linux "L" "M") ":" (if optimize-memory "O" "N")))
           (packed-words (or (get opts :packedWords nil) (= (get opts :binaryEncoding nil) "u16le-chunks")))
           (inline-candidates (when optimize-memory
             (let ((arr (new globalThis.Array (js-length functions))) (k 0))
               (while (< k (js-length functions))
                 (let ((fn (js-nth k functions)))
                   (if (< k rt-prefix-count)
                     (let* ((rc (runtime-body-cache-get (get fn :body)))
                            (leaf (if (and rc (get rc :frozen)) (get rc :leafCandidate) -1)))
                       (put arr k (if (>= leaf 0) (js-object :function fn :size leaf) nil)))
                     (put arr k (memory-leaf-candidate fn k))))
                 (setq k (1+ k)))
               arr)))
           (state (js-object :words (if packed-words (native-word-buffer) (js-array)) :calls (js-array) :constants (js-array)
                    :branches (js-array) :cachedBranches (js-array)
                    :compact nil :leaf nil :memory t :optimizeMemory optimize-memory :mayGrow may-grow :linux linux :registers (js-array) :localOffsets nil
                    :functions functions
                    :signatureMap (get program :signatureMap nil)
                    :debugRanges (if debug (js-array) nil)
                    :trapSites (if debug (js-array) nil)
                    :hostCapabilities (get program :hostCapabilities (js-array))
                    :table (get program :table nil) :tableUses (js-array)))
           (offsets (js-array)) (i 0))
      (native-phase observer "native-code-start" 0 0 0 0)
      (while (< i (js-length functions))
        (let* ((function (js-nth i functions))
               (raw-locals (get function :locals))
               (raw-body (get function :body))
               (cache-rec (when (< i rt-prefix-count)
                            (runtime-body-cache-get raw-body)))
               (can-cache (and cache-rec (get cache-rec :frozen)
                               (not (get cache-rec :hasIndirect))
                               (not (get cache-rec :hasHostCall))
                               (< (get cache-rec :maxCallTarget) rt-prefix-count))))
          (if can-cache
            (let* ((native-bodies (get cache-rec :nativeBodies))
                   (fn-key (if debug
                             (str (if linux "L" "M") ":N:D:" i ":" (js-length (get state :trapSites)))
                             mode-key))
                   (cached-entry (js-call native-bodies :get fn-key)))
              (if (and cached-entry
                       (or (not debug)
                           (and (= (get cached-entry :functionName) (get function :name))
                                (= (get cached-entry :arity) (get function :arity))
                                (= (get cached-entry :localsLength) (js-length raw-locals)))))
                (replay-native-function-cache state cached-entry offsets function)
                (let ((fn-state (js-object :words (js-array) :calls (js-array) :branches (js-array) :constants (js-array)
                                  :compact nil :leaf nil :memory t :optimizeMemory optimize-memory :mayGrow may-grow :linux linux
                                  :registers (js-array) :localOffsets nil
                                  :functions functions
                                  :signatureMap (get program :signatureMap nil)
                                  :debugRanges (if debug (js-array) nil)
                                  :trapSites (if debug (js-array) nil)
                                  :trapSiteBase (if debug (js-length (get state :trapSites)) 0)
                                  :hostCapabilities (get program :hostCapabilities (js-array))
                                  :table (get program :table nil) :tableUses (js-array))))
                  (emit-memory-function-into fn-state function i raw-locals raw-body inline-candidates linux debug nil)
                  (let ((packed (if debug
                                  (pack-native-function-cache fn-state (get function :name) (get function :arity) (js-length raw-locals))
                                  (pack-native-function-cache fn-state))))
                    (if packed
                      (progn
                        (unless cached-entry
                          (js-call native-bodies :set fn-key packed))
                        (replay-native-function-cache state packed offsets function))
                      (emit-memory-function-into state function i raw-locals raw-body inline-candidates linux debug offsets))))))
            (emit-memory-function-into state function i raw-locals raw-body inline-candidates linux debug offsets)))
        (setq i (1+ i))
        (when (and (= (value-type observer) "function") (= (% i 128) 0))
          (native-phase observer "native-code-progress" i (js-length (get state :words))
            (js-length (get state :branches (js-array))) (js-length (get state :calls)))))
      ;; Finish constants too in case any f64 literals were emitted into memory functions!
      (when (> (js-length (get state :constants)) 0)
        (finish-literals state))
      (let ((call-count (finish-calls state offsets)))
        (finish-branches state offsets)
        (memory-finish-table state program offsets)
        (native-phase observer "native-code-complete" (js-length functions) (js-length (get state :words))
          (js-length (get state :branches (js-array))) call-count)
        (let ((code (js-object :words (get state :words) :offsets offsets :debugRanges (get state :debugRanges nil)
                      :trapSites (get state :trapSites nil))))
          (unless (Array/isArray (get code :words)) (put code :wordReader native-word-at)) code))))

  (defun emit-native-memory-object (program target &optional options)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let ((typed-program (lower-memory-program program)))
      (emit-typed-native-memory-object typed-program target options)))

  (defun emit-native-memory-library (program target &optional options)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let ((typed-program (lower-memory-program program)))
      (emit-typed-native-memory-library typed-program target options)))

  (defun memory-valid-index (value limit)
    (and (= (value-type value) "number") (= value (uint32 value)) (< value limit)))

  (defun valid-native-words64-p (words)
    (and (not (nil? words)) (= (value-type words) "object") (not (Array/isArray words))
         (= (value-type (get words :low nil)) "number") (= (get words :low) (uint32 (get words :low)))
         (= (value-type (get words :high nil)) "number") (= (get words :high) (uint32 (get words :high)))))

  (defun memory-validate-node (node function program allowed-indirect capabilities &optional completed)
    (unless (and completed (js-call completed :has node))
    (let ((kind (get node :kind)) (children (get node :children)) (value (get node :value)) (i 0))
      (unless (Array/isArray children) (backend-fail node "native typed node requires children"))
      (when (and (= kind "literal") (memory-wide-type (get node :type)))
        (unless (valid-native-words64-p value)
          (backend-fail node "native 64-bit literal requires exact {low, high} u32 words")))
      (when (or (= kind "local") (= kind "set") (= kind "initialize"))
        (unless (and (memory-valid-index value (js-length (get function :locals)))
                     (= (get node :type) (get (js-nth value (get function :locals)) :type)))
          (backend-fail node "native typed local index or type is invalid")))
      (when (= kind "call")
        (unless (and (memory-valid-index value (js-length (get program :functions)))
                     (= (js-length children) (get (js-nth value (get program :functions)) :arity)))
          (backend-fail node "native direct call requires an exact declared signature"))
        (let* ((target-fn (js-nth value (get program :functions)))
               (target-params (function-param-types target-fn))
               (target-ret (function-return-type target-fn))
               (k 0))
          (unless (memory-same-abi-type (get node :type) target-ret)
            (backend-fail node "native direct call return type mismatch"))
          (while (< k (js-length children))
            (unless (memory-same-abi-type (get (js-nth k children) :type) (js-nth k target-params))
              (backend-fail node "native direct call argument type mismatch"))
            (setq k (1+ k)))))
      (when (= kind "call-indirect")
        (unless (and (Array/isArray (get program :table nil)) (memory-valid-index value 65536)
                     (= (js-length children) (1+ value))
                     (Array/isArray (get node :parameterTypes nil))
                     (memory-scalar-type (get node :type))
                     (memory-word-type (get (js-nth value children) :type)))
          (backend-fail node "indirect calls require a memory-u32 table and an exact signature"))
        (let* ((param-types (get node :parameterTypes))
               (ret-type (or (get node :resultType nil) (get node :type)))
               (k 0))
          (unless (and (= (js-length param-types) value)
                       (memory-scalar-type ret-type)
                       (memory-same-abi-type (get node :type) ret-type))
            (backend-fail node "indirect calls require a declared signature"))
          (while (< k value)
            (unless (and (memory-scalar-type (js-nth k param-types))
                         (memory-same-abi-type (get (js-nth k children) :type) (js-nth k param-types)))
              (backend-fail node "indirect call argument type mismatch"))
            (setq k (1+ k)))
          (unless (js-call allowed-indirect :has (native-signature-key param-types ret-type))
            (backend-fail node "indirect calls require a declared signature"))))
      (when (= kind "host-call")
        (let* ((cap-idx (host-capability-index capabilities node))
               (cap (js-nth cap-idx capabilities))
               (cap-params (get cap :parameterTypes))
               (cap-ret (get cap :resultType))
               (k 0))
          (unless (and (= (js-length children) (js-length cap-params))
                       (memory-same-abi-type (get node :type) cap-ret))
            (backend-fail node "native host-call signature mismatch"))
          (while (< k (js-length children))
            (unless (memory-same-abi-type (get (js-nth k children) :type) (js-nth k cap-params))
              (backend-fail node "native host-call argument type mismatch"))
            (setq k (1+ k)))))
      (when (and (= kind "memory-op") (memory-f64-unary-instruction value))
        (unless (and (= (get node :type) "f64") (= (js-length children) 1)
                     (not (nil? (js-nth 0 children)))
                     (= (value-type (js-nth 0 children)) "object")
                     (not (Array/isArray (js-nth 0 children)))
                     (Array/isArray (get (js-nth 0 children) :children))
                     (= (get (js-nth 0 children) :type) "f64"))
          (backend-fail node "f64 unary memory opcode requires one f64 operand and result")))
      (when (= kind "memory-data-copy")
        (unless (and (= (get node :type) "u32") (= (value-type value) "string")
                     (<= (js-length value) 2147483647) (= (js-length children) 1)
                     (= (get (js-nth 0 children) :type) "u32"))
          (backend-fail node "static UTF16 copy requires memory-u32, one word address and string data")))
      (while (< i (js-length children))
        (unless (memory-scalar-type (get (js-nth i children) :type))
          (backend-fail node "native memory expression requires a valid scalar type"))
        (memory-validate-node (js-nth i children) function program allowed-indirect capabilities completed) (setq i (1+ i))))
      ;; Each memo belongs to one function and one preparation only. Do not
      ;; remember a node until every check and every descendant has succeeded.
      (when completed (js-call completed :set node t))))

  (defun native-locals-sig (locals)
    (let ((parts (js-array)) (len (js-length locals)) (i 0))
      (while (< i len)
        (js-call parts :push (get (js-nth i locals) :type))
        (setq i (1+ i)))
      (js-call parts :join ",")))

  (defun memory-prepare-program-core (program fresh)
    (unless (= (get program :abi) "memory-u32") (backend-fail program "native memory emitter requires memory-u32 typed input"))
    (let* ((functions (get program :functions)) (exports (get program :exports))
           (capabilities (if fresh (prepare-fresh-host-capabilities program) (prepare-host-capabilities program)))
           (table (get program :table nil))
           (declared-sigs (get program :indirectSignatures nil))
           (signature-map (new globalThis.Map))
           (allowed-indirect (new globalThis.Set))
           (i 0))
      (when (object-has? program :indirectArities)
        (backend-fail program "legacy indirectArities is unsupported; use indirectSignatures"))
      (unless (and (Array/isArray functions) (Array/isArray exports)
                   (or (not (object-has? program :indirectSignatures)) (Array/isArray declared-sigs))
                   (or (nil? table) (Array/isArray table))
                   (or (nil? declared-sigs) (= (js-length declared-sigs) 0) (Array/isArray table)))
        (backend-fail program "invalid native memory declarations"))
      (while (< i (js-length functions))
        (let* ((function (js-nth i functions)) (arity (get function :arity)) (locals (get function :locals))
               (declared-params (get function :parameterTypes nil))
               (declared-ret (get function :resultType nil))
               (j 0))
          (unless (and (= (get function :index) i) (memory-valid-index arity 65536)
                       (Array/isArray locals) (<= arity (js-length locals))
                       (get function :body nil)
                       (memory-scalar-type (get (get function :body) :type)))
            (backend-fail function "native memory function requires a valid scalar signature"))
          (while (< j (js-length locals))
            (let* ((local (js-nth j locals)) (type (get local :type)))
              (unless (and (= (get local :index) j) (memory-scalar-type type))
                (backend-fail function "invalid native local layout or parameter type"))) (setq j (1+ j)))
          (when (not (nil? declared-params))
            (unless (and (Array/isArray declared-params) (= (js-length declared-params) arity))
              (backend-fail function "native memory function parameterTypes mismatch"))
            (setq j 0)
            (while (< j arity)
              (let ((declared-type (js-nth j declared-params)))
                (unless (and (memory-scalar-type declared-type)
                             (memory-same-abi-type declared-type (get (js-nth j locals) :type)))
                  (backend-fail function "native memory function parameterTypes mismatch")))
              (setq j (1+ j))))
          (when (not (nil? declared-ret))
            (unless (and (memory-scalar-type declared-ret)
                         (memory-same-abi-type declared-ret (get (get function :body) :type)))
              (backend-fail function "native memory function resultType mismatch")))
          (let ((params (function-param-types function))
                (ret (function-return-type function)))
            (intern-native-signature signature-map params ret)
            (when (and (Array/isArray table) (nil? declared-sigs))
              (js-call allowed-indirect :add (native-signature-key params ret)))))
        (setq i (1+ i)))
      (when (Array/isArray declared-sigs)
        (setq i 0)
        (while (< i (js-length declared-sigs))
          (let* ((sig (js-nth i declared-sigs))
                 (params (when (and sig (= (value-type sig) "object")) (get sig :parameterTypes nil)))
                 (ret (when (and sig (= (value-type sig) "object")) (get sig :resultType nil)))
                 (j 0))
            (unless (and (Array/isArray params) (<= (js-length params) 65535) (memory-scalar-type ret))
              (backend-fail program "invalid indirect signature declaration"))
            (while (< j (js-length params))
              (unless (memory-scalar-type (js-nth j params))
                (backend-fail program "invalid indirect signature parameter type"))
              (setq j (1+ j)))
            (intern-native-signature signature-map params ret)
            (js-call allowed-indirect :add (native-signature-key params ret)))
          (setq i (1+ i))))
      (when table
        (setq i 0)
        (while (< i (js-length table))
          (unless (memory-valid-index (js-nth i table) (js-length functions))
            (backend-fail program "native table entry is not a declared function index")) (setq i (1+ i))))
      (let* ((first-cached (when (> (js-length functions) 0)
                             (runtime-body-cache-get (get (js-nth 0 functions) :body nil))))
             (rt-id (if first-cached (get first-cached :runtimeId 0) 0))
             (rt-count (if first-cached (get first-cached :runtimeFnCount 0) 0))
             (rt-prefix-ok (and (> rt-id 0) (> rt-count 0) (<= rt-count (js-length functions)))))
        (when rt-prefix-ok
          (let ((ri 0))
            (while (and rt-prefix-ok (< ri rt-count))
              (let* ((rfn (js-nth ri functions))
                     (rc (runtime-body-cache-get (get rfn :body nil))))
                (unless (and rc
                             (= (get rc :runtimeId) rt-id)
                             (= (get rc :runtimeFnCount) rt-count)
                             (= (get rc :fnIndex) ri)
                             (= (get rc :arity) (get rfn :arity))
                             (= (get rc :localsSig) (native-locals-sig (get rfn :locals))))
                  (setq rt-prefix-ok false)))
              (setq ri (1+ ri)))))
        (setq i 0)
        (while (< i (js-length functions))
          (let* ((function (js-nth i functions))
                 (fn-body (get function :body))
                 (c (when (and rt-prefix-ok (< i rt-count)) (runtime-body-cache-get fn-body)))
                 (can-cache (and c (get c :frozen) (not (get c :hasIndirect))
                                 (not (get c :hasHostCall)) (< (get c :maxCallTarget) rt-count))))
            (if can-cache
              (unless (get c :nativeValidated)
                (memory-validate-node fn-body function program allowed-indirect capabilities
                  (when fresh (new globalThis.WeakMap)))
                (put c :nativeValidated t))
              (memory-validate-node fn-body function program allowed-indirect capabilities
                (when fresh (new globalThis.WeakMap)))))
          (setq i (1+ i)))
        ;; Existing managed aliases become direct typed wrappers; source and table
        ;; indices remain unchanged, and no public canonical/typed IR is mutated.
        (let ((combined (js-call functions :slice)) (public (js-call exports :slice))
              (aliases (get program :aliases (js-array))) (seen (new globalThis.Set))
              (fn-by-name (new globalThis.Map)))
          (setq i 0)
          (while (< i (js-length functions))
            (let ((fn (js-nth i functions)))
              (unless (js-call fn-by-name :has (get fn :name))
                (js-call fn-by-name :set (get fn :name) fn)))
            (setq i (1+ i)))
          (unless (Array/isArray aliases) (backend-fail program "invalid native aliases"))
          (setq i 0)
          (while (< i (js-length public))
            (let ((pub-name (js-nth i public)))
              (unless (and (js-call fn-by-name :get pub-name) (not (js-call seen :has pub-name)))
                (backend-fail program "invalid or duplicate native export"))
              (js-call seen :add pub-name))
            (setq i (1+ i)))
          (setq i 0)
          (while (< i (js-length aliases))
            (let* ((alias (js-nth i aliases)) (name (get alias :name))
                   (target (js-call fn-by-name :get (get alias :function))))
              (unless (and target (= (value-type name) "string") (not (js-call seen :has name)))
                (backend-fail program "invalid or duplicate native alias"))
              (js-call seen :add name) (js-call public :push name)
              (if (= name (get target :name)) nil
                (progn
                  (when (js-call fn-by-name :get name) (backend-fail program "native alias shadows a function"))
                  (let ((locals (js-array)) (arguments (js-array))
                        (target-locals (get target :locals))
                        (target-ret (get (get target :body) :type))
                        (j 0))
                    (while (< j (get target :arity))
                      (let ((param-type (get (js-nth j target-locals) :type)))
                        (js-call locals :push (js-object :name (str "argument-" j) :type param-type :index j))
                        (js-call arguments :push (js-object :kind "local" :type param-type :value j :children (js-array))))
                      (setq j (1+ j)))
                    (js-call combined :push (js-object :name name :index (js-length combined) :arity (get target :arity) :locals locals
                      :parameterTypes (function-param-types target) :resultType (function-return-type target)
                      :body (js-object :kind "call" :type target-ret :value (get target :index) :children arguments)))))))
            (setq i (1+ i)))
          (let ((prepared (js-object :abi "memory-u32" :filename (get program :filename) :functions combined :exports public :table table
                            :signatureMap signature-map)))
            (when rt-prefix-ok (put prepared :rtPrefixCount rt-count))
            (when (> (js-length capabilities) 0) (put prepared :hostCapabilities capabilities))
            (when (get program :roData nil) (put prepared :roData (get program :roData)))
            prepared)))))

  (defun memory-prepare-program (program)
    (memory-prepare-program-core program nil))
  (defun memory-prepare-fresh-program (program)
    (memory-prepare-program-core program t))

  (defun memory-indirect-target (state node)
    (let* ((param-types (get node :parameterTypes))
           (ret-type (or (get node :resultType nil) (get node :type)))
           (sig-id (js-call (get state :signatureMap) :get (native-signature-key param-types ret-type))))
      (word state 704709612) ;; mov w12,w1: evaluated table slot
      (memory-integer-register state 0 (js-length (get state :table)))
      (word state 1795162527) ;; cmp w12,w0
      (memory-conditional-error state 1409286147 3) ;; b.lo
      (let ((at (js-length (get state :words))))
        (word state 268435465) ;; adr x9, .
        (js-call (get state :tableUses) :push at)
        (integer-register state 10 0 0)) ;; patched positive byte distance to table
      (word state 2332688681)
      (word state 2332822825) ;; add x9,x9,x12,lsl #3
      (word state 3107980586) ;; ldr w10,[x9,#4]: table entry signature ID
      (memory-integer-register state 11 sig-id)
      (word state 1795883359) ;; cmp w10,w11
      (memory-conditional-error state 1409286144 4) ;; b.eq
      (word state 3112173866) ;; ldrsw x10,[x9]: signed target relative to entry
      (word state 2332688688))) ;; add x16,x9,x10

  (defun memory-finish-table (state program offsets)
    (let ((table (get state :table)) (uses (get state :tableUses)) (sig-map (get state :signatureMap)) (i 0))
      (when table
        (when (/= (bit-and (js-length (get state :words)) 1) 0) (word state 3573751839))
        (let ((start (js-length (get state :words))))
          (while (< i (js-length table))
            (let* ((target (js-nth i table))
                   (target-fn (js-nth target (get program :functions)))
                   (sig-id (js-call sig-map :get (native-signature-key (function-param-types target-fn) (function-return-type target-fn))))
                   (distance (- (js-nth target offsets) (* (js-length (get state :words)) 4))))
              (unless (and (>= distance -2147483648) (< distance 2147483648))
                (backend-fail program "native table target exceeds relative range"))
              (word state distance) (word state sig-id))
            (setq i (1+ i)))
          (setq i 0)
          (while (< i (js-length uses))
            (let* ((at (js-nth i uses)) (distance (* (- start at) 4)))
              (unless (memory-valid-index distance 4294967296) (backend-fail program "native table exceeds relative range"))
              (native-word-set (get state :words) (1+ at) (+ 3531603978 (* (bit-and distance 65535) 32)))
              (native-word-set (get state :words) (+ at 2) (+ 4070572042 (* (unsigned-bit-shift-right distance 16) 32))))
            (setq i (1+ i)))))))

  (defun emit-observed-typed-native-memory-object (program target options observer &optional fresh)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let* ((prepared (native-memory-prepare program observer fresh))
           (code (memory-code prepared target (js-object :packedWords t) observer)))
      (native-memory-container prepared code target "object" options observer)))

  (defun emit-observed-typed-native-memory-library (program target options observer &optional fresh)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let* ((prepared (native-memory-prepare program observer fresh))
           (code (memory-code prepared target (js-object :packedWords t) observer)))
      (native-memory-container prepared code target "library" options observer)))

  (defun emit-observed-typed-native-memory-artifact (program target options observer &optional fresh)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let* ((format (get (or options (js-object)) :format "library"))
           (prepared (native-memory-prepare program observer fresh))
           (code (memory-code prepared target (js-object :debug t :packedWords t) observer))
           (bytes nil) (functions (js-array)) (ranges (get code :debugRanges)) (i 0))
      (unless (or (= format "object") (= format "library"))
        (backend-fail program "native memory artifact format must be object or library"))
      (setq bytes (native-memory-container prepared code target format options observer))
      (while (< i (js-length ranges))
        (let ((range (js-nth i ranges)))
          (when (= (get range :kind) "function")
            (js-call functions :push (js-object :name (get range :function) :index (get range :functionIndex)
              :start (get range :start) :end (get range :end) :span (get range :span)))))
        (setq i (1+ i)))
      (let ((debug-doc (js-object :format "eliscript-native-source-map" :target target :abi "memory-u32"
                         :imageFormat (if (= target "arm64-linux") "elf64" "mach-o64") :artifactFormat format
                         :offsetUnit "byte" :offsetBase "code-section" :relocatable t
                         :trapSites (js-call (get code :trapSites (js-array)) :map (lambda (site)
                           (js-object :site (get site :site) :address (get site :start) :offsetBase "code-section"
                             :functionIndex (get site :functionIndex) :returnAddress false :code (get site :code))))
                         :codeSection (get code :section) :functions functions :ranges ranges)))
        (when (get code :roDataSection nil)
          (put debug-doc :roDataSection (get code :roDataSection)))
        (js-object :bytes bytes :debug debug-doc))))

  ;; Preserve the existing public argument list and options observations. Only
  ;; the in-process session imports the explicit-observer variants above.
  (defun emit-typed-native-memory-object (program target &optional options)
    (emit-observed-typed-native-memory-object program target options nil))
  (defun emit-typed-native-memory-library (program target &optional options)
    (emit-observed-typed-native-memory-library program target options nil))
  (defun emit-typed-native-memory-artifact (program target &optional options)
    (emit-observed-typed-native-memory-artifact program target options nil))

  ;; These entries are the session's already lowered, privately created data
  ;; handoff. No program marker or public options property enables its memos.
  (defun emit-fresh-observed-typed-native-memory-object (program target options observer)
    (emit-observed-typed-native-memory-object program target options observer t))
  (defun emit-fresh-observed-typed-native-memory-library (program target options observer)
    (emit-observed-typed-native-memory-library program target options observer t))
  (defun emit-fresh-observed-typed-native-memory-artifact (program target options observer)
    (emit-observed-typed-native-memory-artifact program target options observer t))

  (export emit-typed-native-memory-artifact emit-typed-native-memory-object emit-typed-native-memory-library emit-native-memory-object emit-native-memory-library emit-native-numeric-object emit-native-numeric-library emit-native-numeric-executable
    emit-observed-typed-native-memory-object emit-observed-typed-native-memory-library emit-observed-typed-native-memory-artifact
    emit-fresh-observed-typed-native-memory-object emit-fresh-observed-typed-native-memory-library emit-fresh-observed-typed-native-memory-artifact))
