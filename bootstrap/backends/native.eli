(module eliscript.backend.native
  (import "./optimize.mjs" optimize-program)
  (import "./numeric.mjs" lower-numeric-program optimize-numeric-program numeric-pure backend-fail find-function)
  (import "./sha256.mjs" sha256-bytes)

  ;; ARM64 numeric-f64 instruction and Mach-O image emission. Selection,
  ;; encoding, linking metadata and ad-hoc page signatures are independent.
  (defun word (state value)
    (js-call (get state :words) :push (uint32 value)))

  (defun u32 (bytes value)
    (let ((i 0))
      (while (< i 4)
        (js-call bytes :push (bit-and value 255))
        (setq value (unsigned-bit-shift-right value 8))
        (setq i (1+ i))))
    bytes)

  (defun u64 (bytes value)
    (u32 bytes (uint32 value))
    (u32 bytes (uint32 (/ value 4294967296))))

  (defun zeros (bytes count)
    (let ((i 0)) (while (< i count) (js-call bytes :push 0) (setq i (1+ i)))))

  (defun ascii-field (bytes name width)
    (let ((i 0))
      (while (< i width)
        (js-call bytes :push (if (< i (js-length name)) (string-code-unit-at name i) 0))
        (setq i (1+ i)))))

  (defun string-bytes (bytes name)
    (let ((i 0))
      (while (< i (js-length name))
        (let ((code (string-code-unit-at name i)))
          (when (= code 0) (backend-fail nil "native symbol contains NUL"))
          (when (and (>= code 55296) (<= code 56319))
            (let ((next (if (< (1+ i) (js-length name)) (string-code-unit-at name (1+ i)) 0)))
              (unless (and (>= next 56320) (<= next 57343))
                (backend-fail nil "native symbol contains an unpaired surrogate"))
              (setq code (+ 65536 (* (- code 55296) 1024) (- next 56320)))
              (setq i (1+ i))))
          (when (and (>= code 56320) (<= code 57343))
            (backend-fail nil "native symbol contains an unpaired surrogate"))
          (cond
            ((< code 128) (js-call bytes :push code))
            ((< code 2048) (js-call bytes :push
              (bit-or 192 (unsigned-bit-shift-right code 6)) (bit-or 128 (bit-and code 63))))
            ((< code 65536) (js-call bytes :push
              (bit-or 224 (unsigned-bit-shift-right code 12))
              (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63))
              (bit-or 128 (bit-and code 63))))
            (t (js-call bytes :push
              (bit-or 240 (unsigned-bit-shift-right code 18))
              (bit-or 128 (bit-and (unsigned-bit-shift-right code 12) 63))
              (bit-or 128 (bit-and (unsigned-bit-shift-right code 6) 63))
              (bit-or 128 (bit-and code 63))))))
        (setq i (1+ i)))
      (js-call bytes :push 0)))

  (defun integer-register (state register low high)
    (word state (+ 3531603968 (* (bit-and low 65535) 32) register))
    (when (or (not (get state :compact nil)) (/= (unsigned-bit-shift-right low 16) 0))
      (word state (+ 4070572032 (* (unsigned-bit-shift-right low 16) 32) register)))
    (when (or (not (get state :compact nil)) (/= (bit-and high 65535) 0))
      (word state (+ 4072669184 (* (bit-and high 65535) 32) register)))
    (when (or (not (get state :compact nil)) (/= (unsigned-bit-shift-right high 16) 0))
      (word state (+ 4074766336 (* (unsigned-bit-shift-right high 16) 32) register))))

  (defun float-literal (state value)
    (let* ((bits (number-float64-words value)) (low (js-nth 0 bits)) (high (js-nth 1 bits)))
      (when (and (= value 0) (< (/ 1 value) 0)) (setq high 2147483648))
      (if (and (get state :compact nil) (= low 0) (= high 0))
          (word state 2657551328)
      (if (and (get state :compact nil) (= low 0) (= (bit-and high 65535) 0)
               (>= (bit-and (unsigned-bit-shift-right high 20) 2047) 1020)
               (<= (bit-and (unsigned-bit-shift-right high 20) 2047) 1027))
          (let* ((exponent (- (bit-and (unsigned-bit-shift-right high 20) 2047) 1023))
                 (immediate (+ (* (unsigned-bit-shift-right high 31) 128)
                   (if (< exponent 1) (+ 64 (* (+ exponent 3) 16)) (* (- exponent 1) 16))
                   (bit-and (unsigned-bit-shift-right high 16) 15))))
            (word state (+ 509612032 (* immediate 8192))))
      (if (get state :compact nil)
          (let ((constants (get state :constants)) (index 0) (found nil))
            (while (and (< index (js-length constants)) (not found))
              (let ((entry (js-nth index constants)))
                (when (and (= low (get entry :low)) (= high (get entry :high))) (setq found entry)))
              (setq index (1+ index)))
            (unless found
              (setq found (js-object :low low :high high :uses (js-array)))
              (js-call constants :push found))
            (js-call (get found :uses) :push (js-length (get state :words)))
            (word state 1543503872))
        (progn (integer-register state 9 low high) (word state 2657550624)))))))

  (defun finish-literals (state)
    (let ((constants (get state :constants)) (words (get state :words)) (i 0))
      (when (and (> (js-length constants) 0) (/= (bit-and (js-length words) 1) 0))
        (word state 3573751839))
      (while (< i (js-length constants))
        (let* ((entry (js-nth i constants)) (target (js-length words)) (uses (get entry :uses)) (j 0))
          (while (< j (js-length uses))
            (let* ((at (js-nth j uses)) (distance (- target at)))
              (unless (and (>= distance -262144) (< distance 262144))
                (backend-fail nil "native literal exceeds ARM64 displacement range"))
              (js-call words :splice at 1 (bit-or (+ 1543503872 (bit-and (js-nth at words) 31))
                (* (bit-and distance 524287) 32))))
            (setq j (1+ j)))
          (word state (get entry :low)) (word state (get entry :high)))
        (setq i (1+ i)))))

  (defun stack-adjust (state amount subtract)
    (while (> amount 0)
      (let ((part (if (< amount 4080) amount 4080)))
        (word state (+ (if subtract 3506439167 2432697343) (* part 1024)))
        (setq amount (- amount part)))))

  (defun push-value (state type)
    (let ((depth (get state :depth 0)))
      (if (and (get state :leaf nil) (< depth 8))
          (word state (+ (if (= type "f64") 509624320 505872384) (+ 16 depth)))
        (progn (stack-adjust state 16 t)
          (word state (if (= type "f64") 4244636640 3103785952))))
      (put state :depth (1+ depth))))

  (defun pop-value (state type)
    (let ((depth (1- (get state :depth 1))))
      (put state :depth depth)
      (if (and (get state :leaf nil) (< depth 8))
          (word state (+ (if (= type "f64") 509624321 505806849) (* (+ 16 depth) 32)))
        (progn (word state (if (= type "f64") 4248830945 3107980257))
          (stack-adjust state 16 nil)))))

  (defun local-access (state index type store)
    (let* ((registers (get state :registers (js-array)))
           (register (if (< index (js-length registers)) (js-nth index registers) -1)))
      (if (<= register -2)
          (let ((physical (- (- register) 2)))
            (word state (+ 704644064 (if store physical (* physical 65536)))))
      (if (>= register 0)
          (word state (if (= type "f64")
            (+ 509624320 (if store register (* register 32)))
            (if store (+ 505872384 register) (+ 505806848 (* register 32)))))
        (progn
          (integer-register state 9 (* (1+ index) 8) 0)
          (word state 3406365609) ;; sub x9, x29, x9
          (word state (if (= type "f64") (if store 4244635936 4248830240)
                        (if store 3103785248 3107979552))))))))

  (defun register-weights (node counts)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0) (call (= (get node :kind) "call")))
      (when (or (= kind "local") (= kind "set") (= kind "initialize"))
        (let ((index (get node :value)))
          (js-call counts :splice index 1 (1+ (js-nth index counts)))))
      (while (< i (js-length children))
        (when (register-weights (js-nth i children) counts) (setq call t))
        (setq i (1+ i)))
      call))

  (defun live-union (left right)
    (let ((result (js-call left :slice)) (i 0))
      (while (< i (js-length right))
        (unless (js-call result :includes (js-nth i right)) (js-call result :push (js-nth i right)))
        (setq i (1+ i)))
      result))

  (defun interference (graph index live)
    (let ((i 0)) (while (< i (js-length live))
      (let ((other (js-nth i live)))
        (unless (= index other)
          (unless (js-call (js-nth index graph) :includes other) (js-call (js-nth index graph) :push other))
          (unless (js-call (js-nth other graph) :includes index) (js-call (js-nth other graph) :push index))))
      (setq i (1+ i)))))

  (defun live-before (node after graph)
    (let ((kind (get node :kind)) (children (get node :children)) (value (get node :value))
          (live (js-call after :slice)))
      (when (= kind "call")
        (put node :callLive (live-union (get node :callLive (js-array)) after)))
      (cond
        ((= kind "local") (interference graph value live)
          (unless (js-call live :includes value) (js-call live :push value)))
        ((or (= kind "set") (= kind "initialize"))
          (interference graph value live)
          (let ((at (js-call live :indexOf value))) (when (>= at 0) (js-call live :splice at 1)))
          (setq live (live-before (js-nth 0 children) live graph)))
        ((= kind "if")
          (setq live (live-before (js-nth 0 children)
            (live-union (live-before (js-nth 1 children) live graph)
                        (live-before (js-nth 2 children) live graph)) graph)))
        ((or (= kind "while") (= kind "remainder-while") (= kind "guarded-while"))
          (let ((changed t))
            (while changed
              (let* ((next (live-before (js-nth 0 children)
                            (live-union after (live-before (js-nth 1 children) live graph)) graph))
                     (joined (live-union live next)))
                (setq changed (/= (js-length joined) (js-length live)))
                (setq live joined)))))
        (t
          (let ((i (1- (js-length children))))
            (while (>= i 0)
              (setq live (live-before (js-nth i children)
                (if (or (= kind "and") (= kind "or")) (live-union after live) live) graph))
              (setq i (1- i))))))
      live))

  (defun allocate-registers (body locals arity)
    (let ((count (js-length locals)) (counts (js-array)) (registers (js-array))
          (available (js-array)) (integers (js-array)) (graph (js-array)) (i 0))
      (while (< i count) (js-call counts :push 0) (js-call registers :push -1)
        (js-call graph :push (js-array)) (setq i (1+ i)))
      (register-weights body counts)
      (live-before body (js-array) graph)
      ;; Entry argument capture materializes all live incoming parameters.
      (setq i 0)
      (while (< i arity) (let ((j 0)) (while (< j arity)
        (when (and (/= i j) (> (js-nth i counts) 0) (> (js-nth j counts) 0))
          (interference graph i (js-array j))) (setq j (1+ j)))) (setq i (1+ i)))
        (setq i 2)
        (while (< i 32)
          ;; d0/d1 and d16-d23 are expression temporaries. Actual calls
          ;; explicitly preserve allocated caller registers.
          (when (or (< i 16) (>= i 24))
            (js-call available :push i))
          (setq i (1+ i)))
      (setq i 10)
      (while (< i 29)
        (when (or (< i 16) (>= i 19)) (js-call integers :push i))
        (setq i (1+ i)))
      (assign-register-class counts locals registers available "f64" graph)
      (assign-register-class counts locals registers integers "i32" graph)
      (js-object :registers registers :leaf t)))

  (defun assign-register-class (counts locals registers available type graph)
    (let ((i 0) (count (js-length locals)) (processed (js-array)))
      (while (< i count)
        (let ((best -1) (weight 0) (j 0))
          (while (< j count)
            (when (and (= (get (js-nth j locals) :type) type) (not (js-call processed :includes j))
                       (> (js-nth j counts) weight))
              (setq best j) (setq weight (js-nth j counts)))
            (setq j (1+ j)))
          (when (>= best 0)
            (js-call processed :push best)
            (setq j 0)
            (while (and (< j (js-length available)) (= (js-nth best registers) -1))
              (let ((r (if (= type "f64") (js-nth j available) (- -2 (js-nth j available))))
                    (neighbors (js-nth best graph)) (k 0) (conflict nil))
                (while (< k (js-length neighbors))
                  (when (= (js-nth (js-nth k neighbors) registers) r) (setq conflict t))
                  (setq k (1+ k)))
                (unless conflict (js-call registers :splice best 1 r)))
              (setq j (1+ j)))))
        (setq i (1+ i)))
      registers))

  (defun preserve-registers (state count restore)
    (let ((register 8) (registers (get state :registers)))
      (while (< register 16)
        (when (js-call registers :includes register)
        (integer-register state 9 (* (+ count (- register 8) 1) 8) 0)
        (word state 3406365609)
        (word state (+ (if restore 4248830240 4244635936) register)))
        (setq register (1+ register)))
      (setq register 19)
      (while (< register 29)
        (when (js-call registers :includes (- -2 register))
        (integer-register state 9 (* (+ count 8 (- register 19) 1) 8) 0)
        (word state 3406365609)
        (word state (+ (if restore 4181721376 4177527072) register)))
        (setq register (1+ register)))))

  (defun local-register (state node type)
    (if (= (get node :kind) "local")
        (let* ((registers (get state :registers)) (index (get node :value))
               (register (if (< index (js-length registers)) (js-nth index registers) -1)))
          (if (= type "f64") register (if (<= register -2) (- (- register) 2) -1)))
      -1))

  (defun operands (state left right type)
    (if (and (= type "f64") (direct-pure state left) (direct-pure state right)
             (<= (+ (pure-depth left) (pure-depth right)) (- 7 (get state :depth 0))))
        (let* ((depth (get state :depth 0)) (l (capture-before state (pure-value state left) right))
               (r (pure-value state right)))
          (put state :depth depth) (js-array l r))
    (if (and (get state :compact nil)
             (or (= (get right :kind) "literal") (= (get right :kind) "local") (= (get right :kind) "int-literal")))
        (let ((l (local-register state left type)) (r (local-register state right type)))
          (when (< l 0)
            (expression state left)
            (if (< r 0)
                (progn (word state (if (= type "f64") 509624321 704644065)) (setq l 1))
              (setq l 0)))
          (when (< r 0) (expression state right) (setq r 0))
          (js-array l r))
      (progn (expression state left) (push-value state type) (expression state right) (pop-value state type)
        (js-array 1 0)))))

  (defun binary-word (state opcode registers)
    (word state (+ (- opcode 32) (* (js-nth 0 registers) 32) (* (js-nth 1 registers) 65536))))

  (defun pure-depth (node)
    (let ((depth 0) (i 0) (children (get node :children)))
      (while (< i (js-length children))
        (let ((child (pure-depth (js-nth i children)))) (when (> child depth) (setq depth child)))
        (setq i (1+ i)))
      (1+ depth)))

  (defun direct-pure (state node)
    (and (get state :compact nil) (= (get node :type) "f64")
         (or (numeric-pure node) (cache-value state node))
         (<= (pure-depth node) (- 7 (get state :depth 0)))))

  (defun cache-value (state node)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0) (valid t))
      (if (= kind "set")
          (and (get (js-nth (get node :value) (get state :locals)) :pureGuardCache nil)
               (numeric-pure (js-nth 0 children)))
