           (word state (+ 4181722080 (* offset 128) reg))
         (progn (emit-sp-address-x9 state offset) (word state (+ 4181721376 reg)))))
      (t
       (if (and (= (% offset 4) 0) (<= offset 16380))
           (word state (+ 3107980256 (* offset 256) reg))
         (progn (emit-sp-address-x9 state offset) (word state (+ 3107979552 reg)))))))

  (defun emit-sp-store (state type reg offset)
