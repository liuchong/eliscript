            (patch-conditions state (get state :memoryErrors) (js-length (get state :words)))
            (memory-integer-register state 0 0)
            (patch-jump state normal (js-length (get state :words))))
          (integer-register state 9 frame 0) (word state 3406365609) ;; sub x9,fp,x9
          (word state 4181721395) ;; restore x19 independently of temporary stack depth
