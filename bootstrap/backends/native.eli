  (defun emit-native-memory-object (program target &optional options)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let ((typed-program (lower-memory-program program)))
      (emit-typed-native-memory-object typed-program target options)))

  (defun emit-native-memory-library (program target &optional options)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let ((typed-program (lower-memory-program program)))
      (emit-typed-native-memory-library typed-program target options)))


  (defun memory-word-type (type) (or (= type "u32") (= type "i32")))
  (defun memory-valid-index (value limit)
    (and (= (value-type value) "number") (= value (uint32 value)) (< value limit)))

  (defun memory-validate-node (node function program arities capabilities &optional completed)
    (unless (and completed (js-call completed :has node))
    (let ((kind (get node :kind)) (children (get node :children)) (value (get node :value)) (i 0))
      (unless (Array/isArray children) (backend-fail node "native typed node requires children"))
      (when (or (= kind "local") (= kind "set") (= kind "initialize"))
        (unless (and (memory-valid-index value (js-length (get function :locals)))
                     (= (get node :type) (get (js-nth value (get function :locals)) :type)))
          (backend-fail node "native typed local index or type is invalid")))
      (when (= kind "call")
        (unless (and (memory-valid-index value (js-length (get program :functions)))
                     (= (js-length children) (get (js-nth value (get program :functions)) :arity)))
          (backend-fail node "native direct call requires an exact declared signature")))
      (when (= kind "call-indirect")
        (unless (and (Array/isArray (get program :table nil)) (memory-valid-index value 65536)
                     (= (js-length children) (1+ value)) (js-call arities :includes value)
                     (memory-word-type (get node :type)))
          (backend-fail node "indirect calls require a memory-u32 table and an exact signature")))
      (when (= kind "host-call")
        (host-capability-index capabilities node))
      (when (and (= kind "memory-op") (memory-f64-unary-instruction value))
        (unless (and (= (get node :type) "f64") (= (js-length children) 1)
                     (not (nil? (js-nth 0 children)))
                     (= (value-type (js-nth 0 children)) "object")
                     (not (Array/isArray (js-nth 0 children)))
                     (Array/isArray (get (js-nth 0 children) :children))
                     (= (get (js-nth 0 children) :type) "f64"))
          (backend-fail node "f64 unary memory opcode requires one f64 operand and result")))
      (when (= kind "memory-data-copy")
        (unless (and (= (get node :type) "u32") (= (value-type value) "string")
                     (<= (js-length value) 2147483647) (= (js-length children) 1)
                     (= (get (js-nth 0 children) :type) "u32"))
          (backend-fail node "static UTF16 copy requires memory-u32, one word address and string data")))
      (while (< i (js-length children))
        (when (and (or (= kind "call") (= kind "call-indirect") (= kind "host-call"))
                   (not (memory-word-type (get (js-nth i children) :type))))
          (backend-fail node "native memory calls require word arguments"))
        (memory-validate-node (js-nth i children) function program arities capabilities completed) (setq i (1+ i))))
      ;; Each memo belongs to one function and one preparation only. Do not
      ;; remember a node until every check and every descendant has succeeded.
      (when completed (js-call completed :set node t))))

  (defun memory-prepare-program-core (program fresh)
    (unless (= (get program :abi) "memory-u32") (backend-fail program "native memory emitter requires memory-u32 typed input"))
    (let* ((functions (get program :functions)) (exports (get program :exports))
           (capabilities (if fresh (prepare-fresh-host-capabilities program) (prepare-host-capabilities program)))
           (table (get program :table nil)) (declared (get program :indirectArities (js-array)))
           (arities (js-array)) (i 0))
      (unless (and (Array/isArray functions) (Array/isArray exports) (Array/isArray declared)
                   (or (nil? table) (Array/isArray table))
                   (or (= (js-length declared) 0) (Array/isArray table)))
        (backend-fail program "invalid native memory declarations"))
      (while (< i (js-length functions))
        (let* ((function (js-nth i functions)) (arity (get function :arity)) (locals (get function :locals)) (j 0))
          (unless (and (= (get function :index) i) (memory-valid-index arity 65536)
                       (Array/isArray locals) (<= arity (js-length locals))
                       (memory-word-type (get (get function :body) :type)))
            (backend-fail function "native memory function requires a word signature"))
          (while (< j (js-length locals))
            (let* ((local (js-nth j locals)) (type (get local :type)))
              (unless (and (= (get local :index) j) (or (memory-word-type type) (= type "f64"))
                           (or (>= j arity) (memory-word-type type)))
                (backend-fail function "invalid native local layout or parameter type"))) (setq j (1+ j)))
          (unless (js-call arities :includes arity) (js-call arities :push arity))) (setq i (1+ i)))
      (setq i 0)
      (while (< i (js-length declared))
        (let ((arity (js-nth i declared)))
          (unless (memory-valid-index arity 65536) (backend-fail program "invalid indirect signature arity"))
          (unless (js-call arities :includes arity) (js-call arities :push arity))) (setq i (1+ i)))
      (when table
        (setq i 0)
        (while (< i (js-length table))
          (unless (memory-valid-index (js-nth i table) (js-length functions))
            (backend-fail program "native table entry is not a declared function index")) (setq i (1+ i))))
      (setq i 0)
      (while (< i (js-length functions))
        (let ((function (js-nth i functions)))
          (memory-validate-node (get function :body) function program arities capabilities
            (when fresh (new globalThis.WeakMap)))) (setq i (1+ i)))
      ;; Existing managed aliases become direct word wrappers; source and table
      ;; indices remain unchanged, and no public canonical/typed IR is mutated.
      (let ((combined (js-call functions :slice)) (public (js-call exports :slice))
            (aliases (get program :aliases (js-array))) (seen (js-array)))
        (unless (Array/isArray aliases) (backend-fail program "invalid native aliases"))
        (setq i 0)
        (while (< i (js-length public))
          (unless (and (find-function functions (js-nth i public)) (not (js-call seen :includes (js-nth i public))))
            (backend-fail program "invalid or duplicate native export"))
          (js-call seen :push (js-nth i public)) (setq i (1+ i)))
        (setq i 0)
        (while (< i (js-length aliases))
          (let* ((alias (js-nth i aliases)) (name (get alias :name))
                 (target (find-function functions (get alias :function))))
            (unless (and target (= (value-type name) "string") (not (js-call seen :includes name)))
              (backend-fail program "invalid or duplicate native alias"))
            (js-call seen :push name) (js-call public :push name)
            (if (= name (get target :name)) nil
              (progn
                (when (find-function functions name) (backend-fail program "native alias shadows a function"))
                (let ((locals (js-array)) (arguments (js-array)) (j 0))
                  (while (< j (get target :arity))
                    (js-call locals :push (js-object :name (str "argument-" j) :type "u32" :index j))
                    (js-call arguments :push (js-object :kind "local" :type "u32" :value j :children (js-array))) (setq j (1+ j)))
                  (js-call combined :push (js-object :name name :index (js-length combined) :arity (get target :arity) :locals locals
                    :body (js-object :kind "call" :type "u32" :value (get target :index) :children arguments)))))))
          (setq i (1+ i)))
        (let ((prepared (js-object :abi "memory-u32" :filename (get program :filename) :functions combined :exports public :table table)))
          (when (> (js-length capabilities) 0) (put prepared :hostCapabilities capabilities))
          prepared))))

  (defun memory-prepare-program (program)
    (memory-prepare-program-core program nil))
  (defun memory-prepare-fresh-program (program)
    (memory-prepare-program-core program t))

  (defun memory-indirect-target (state node)
    (word state 704709612) ;; mov w12,w1: evaluated table slot
    (memory-integer-register state 0 (js-length (get state :table)))
    (word state 1795162527) ;; cmp w12,w0
    (memory-conditional-error state 1409286147 3) ;; b.lo
    (let ((at (js-length (get state :words))))
      (word state 268435465) ;; adr x9, .
      (js-call (get state :tableUses) :push at)
      (integer-register state 10 0 0)) ;; patched positive byte distance to table
    (word state 2332688681)
    (word state 2332822825) ;; add x9,x9,x12,lsl #3
    (word state 3107980586) ;; table entry arity
    (memory-integer-register state 11 (get node :value))
    (word state 1795883359)
    (memory-conditional-error state 1409286144 4) ;; b.eq
    (word state 3112173866) ;; ldrsw x10,[x9]: signed target relative to entry
    (word state 2332688688)) ;; add x16,x9,x10

  (defun memory-finish-table (state program offsets)
    (let ((table (get state :table)) (uses (get state :tableUses)) (i 0))
      (when table
        (when (/= (bit-and (js-length (get state :words)) 1) 0) (word state 3573751839))
        (let ((start (js-length (get state :words))))
          (while (< i (js-length table))
            (let* ((target (js-nth i table)) (distance (- (js-nth target offsets) (* (js-length (get state :words)) 4))))
              (unless (and (>= distance -2147483648) (< distance 2147483648))
                (backend-fail program "native table target exceeds relative range"))
              (word state distance) (word state (get (js-nth target (get program :functions)) :arity)))
            (setq i (1+ i)))
          (setq i 0)
          (while (< i (js-length uses))
            (let* ((at (js-nth i uses)) (distance (* (- start at) 4)))
              (unless (memory-valid-index distance 4294967296) (backend-fail program "native table exceeds relative range"))
              (native-word-set (get state :words) (1+ at) (+ 3531603978 (* (bit-and distance 65535) 32)))
              (native-word-set (get state :words) (+ at 2) (+ 4070572042 (* (unsigned-bit-shift-right distance 16) 32))))
            (setq i (1+ i)))))))

  (defun emit-observed-typed-native-memory-object (program target options observer &optional fresh)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let* ((prepared (native-memory-prepare program observer fresh))
           (code (memory-code prepared target (js-object :packedWords t) observer)))
      (native-memory-container prepared code target "object" options observer)))

  (defun emit-observed-typed-native-memory-library (program target options observer &optional fresh)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let* ((prepared (native-memory-prepare program observer fresh))
           (code (memory-code prepared target (js-object :packedWords t) observer)))
      (native-memory-container prepared code target "library" options observer)))

  (defun emit-observed-typed-native-memory-artifact (program target options observer &optional fresh)
    (unless (or (= target "arm64-macos") (= target "arm64-linux"))
      (backend-fail program "native memory target must be explicit arm64-macos or arm64-linux"))
    (let* ((format (get (or options (js-object)) :format "library"))
           (prepared (native-memory-prepare program observer fresh))
           (code (memory-code prepared target (js-object :debug t :packedWords t) observer))
           (bytes nil) (functions (js-array)) (ranges (get code :debugRanges)) (i 0))
      (unless (or (= format "object") (= format "library"))
        (backend-fail program "native memory artifact format must be object or library"))
      (setq bytes (native-memory-container prepared code target format options observer))
      (while (< i (js-length ranges))
        (let ((range (js-nth i ranges)))
          (when (= (get range :kind) "function")
            (js-call functions :push (js-object :name (get range :function) :index (get range :functionIndex)
              :start (get range :start) :end (get range :end) :span (get range :span)))))
        (setq i (1+ i)))
      (js-object :bytes bytes
        :debug (js-object :format "eliscript-native-source-map" :version 1 :target target :abi "memory-u32"
          :imageFormat (if (= target "arm64-linux") "elf64" "mach-o64") :artifactFormat format
          :offsetUnit "byte" :offsetBase "code-section" :relocatable t
          :trapSites (js-call (get code :trapSites (js-array)) :map (lambda (site)
            (js-object :site (get site :site) :address (get site :start) :offsetBase "code-section"
              :functionIndex (get site :functionIndex) :returnAddress false :code (get site :code))))
          :codeSection (get code :section) :functions functions :ranges ranges))))

  ;; Preserve the existing public argument list and options observations. Only
  ;; the in-process session imports the explicit-observer variants above.
  (defun emit-typed-native-memory-object (program target &optional options)
    (emit-observed-typed-native-memory-object program target options nil))
  (defun emit-typed-native-memory-library (program target &optional options)
    (emit-observed-typed-native-memory-library program target options nil))
  (defun emit-typed-native-memory-artifact (program target &optional options)
    (emit-observed-typed-native-memory-artifact program target options nil))

  ;; These entries are the session's already lowered, privately created data
  ;; handoff. No program marker or public options property enables its memos.
  (defun emit-fresh-observed-typed-native-memory-object (program target options observer)
    (emit-observed-typed-native-memory-object program target options observer t))
  (defun emit-fresh-observed-typed-native-memory-library (program target options observer)
    (emit-observed-typed-native-memory-library program target options observer t))
  (defun emit-fresh-observed-typed-native-memory-artifact (program target options observer)
    (emit-observed-typed-native-memory-artifact program target options observer t))

  (export emit-typed-native-memory-artifact emit-typed-native-memory-object emit-typed-native-memory-library emit-native-memory-object emit-native-memory-library emit-native-numeric-object emit-native-numeric-library emit-native-numeric-executable
    emit-observed-typed-native-memory-object emit-observed-typed-native-memory-library emit-observed-typed-native-memory-artifact
    emit-fresh-observed-typed-native-memory-object emit-fresh-observed-typed-native-memory-library emit-fresh-observed-typed-native-memory-artifact))
