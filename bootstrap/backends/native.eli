  (defun memory-wide-operands (state left right)
    (expression state left)
    (if (and (memory-wide-type (get right :type))
             (or (= (get right :kind) "literal") (= (get right :kind) "local")))
        (progn (word state 2852127713) (expression state right)) ;; mov x1,x0
      (progn (push-value state "v64") (expression state right) (pop-value state "v64"))))

  (defun memory-v64-compare (state node)
    (let* ((children (get node :children)) (name (get node :value))
           (left (js-nth 0 children))
           (right (js-nth 1 children))
           (opt (and (get state :memory nil) (get state :optimizeMemory nil)))
           (no-debug (not (get state :debugRanges nil)))
           (wimm (when opt (memory-wide-imm12 right)))
           (rL (if (and opt no-debug (memory-wide-type (get left :type))) (local-register state left "v64") -1))
           (rR (if (and opt no-debug (memory-wide-type (get right :type))) (local-register state right "v64") -1))
           (code (cond ((= name "=") 0) ((= name "/=") 1) ((= name "<") 3)
                       ((= name "<=") 9) ((= name ">") 8) (t 2))))
      (if (not (nil? wimm))
        (progn
          (when (< rL 0) (expression state left))
          (word state (+ 4043309087 (* wimm 1024) (if (>= rL 0) (* rL 32) 0)))) ;; cmp xRL, #imm
        (if (>= rR 0)
          (progn
            (when (< rL 0) (expression state left))
            (word state (+ 3942645791 (* rR 65536) (if (>= rL 0) (* rL 32) 0)))) ;; cmp xRL, xRR
          (if (and (>= rL 0) (not (memory-expr-writes-reg-p state right rL)))
            (progn
              (expression state right)
              (word state (+ 3942645791 (* rL 32)))) ;; cmp xRL, x0
            (progn (memory-wide-operands state left right)
                   (word state 3942645823))))) ;; cmp x1, x0
      (word state (+ 446629856 (* (bit-xor code 1) 4096)))))

  (defun memory-f64-unary-instruction (name)
    ;; Arm A64 scalar FP one-source encoding, ftype=01, Rn=Rd=0.
    (cond ((= name "f64-abs") 509657088) ;; fabs d0,d0
      ((= name "f64-neg") 509689856) ;; fneg d0,d0
      ((= name "f64-ceil") 509919232) ;; frintp d0,d0
      ((= name "f64-floor") 509952000) ;; frintm d0,d0
      ((= name "f64-trunc") 509984768) ;; frintz d0,d0
      ((= name "f64-nearest") 509886464) ;; frintn d0,d0: ties to even
      ((= name "f64-sqrt") 509722624) ;; fsqrt d0,d0
      (t nil)))

  (defun memory-f64-unary (state node)
    (expression state (js-nth 0 (get node :children)))
    ;; The child completes before this instruction-local environment begins.
    ;; x9 is the existing scratch register; no calls, loads or branches can
    ;; leave this window without restoring the caller's exact FPCR. Zero
    ;; selects nearest-even sqrt, gradual underflow, ordinary NaN propagation
    ;; and disabled FP exception traps, independently of the embedding host.
    (word state 3577431049) ;; mrs x9,FPCR (0xd53b4409)
    (word state 3575333919) ;; msr FPCR,xzr (0xd51b441f)
    (word state (memory-f64-unary-instruction (get node :value)))
    (word state 3575333897)) ;; msr FPCR,x9 (0xd51b4409)

  (defun memory-expr-writes-local-p (node target)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0) (found nil))
      (if (and (or (= kind "set") (= kind "initialize")) (= (get node :value) target))
          t
        (progn
          (when children
            (while (and (not found) (< i (js-length children)))
              (when (memory-expr-writes-local-p (js-nth i children) target)
                (setq found t))
              (setq i (1+ i))))
          found))))

  (defun memory-expr-writes-reg-p (state node target-reg)
    (let ((kind (get node :kind)) (children (get node :children)) (i 0) (found nil))
      (if (and (or (= kind "set") (= kind "initialize"))
               (let* ((regs (get state :registers)) (idx (get node :value))
                      (raw (if (< idx (js-length regs)) (js-nth idx regs) -1)))
                 (and (<= raw -2) (= (- (- raw) 2) target-reg))))
          t
        (progn
          (when children
            (while (and (not found) (< i (js-length children)))
              (when (memory-expr-writes-reg-p state (js-nth i children) target-reg)
                (setq found t))
              (setq i (1+ i))))
          found))))

  (defun memory-addr-base-imm (state addr)
    (let ((kind (get addr :kind)) (val (get addr :value)) (children (get addr :children)))
      (when (and (= kind "word-arithmetic") (memory-word-type (get addr :type)))
        (cond
          ((and (= val "+") (= (js-length children) 2))
           (let* ((left (js-nth 0 children))
                  (right (js-nth 1 children))
                  (rL (if (memory-word-type (get left :type)) (local-register state left "u32") -1))
                  (immR (memory-word-imm12 right)))
             (if (and (>= rL 0) (>= immR 0))
                 (js-object :reg rL :imm immR :local (get left :value))
               (let ((rR (if (memory-word-type (get right :type)) (local-register state right "u32") -1))
                     (immL (memory-word-imm12 left)))
                 (when (and (>= rR 0) (>= immL 0))
                   (js-object :reg rR :imm immL :local (get right :value)))))))
          ((and (= val "1+") (= (js-length children) 1))
           (let* ((arg (js-nth 0 children))
                  (rA (if (memory-word-type (get arg :type)) (local-register state arg "u32") -1)))
             (when (>= rA 0)
               (js-object :reg rA :imm 1 :local (get arg :value)))))))))

  (defun memory-emit-pinned-bounds (state width idx-reg)
    (word state (+ 2432696330 (* width 1024) (* idx-reg 32))) ;; add x10, xIdx, #width
    (word state 3944481119) ;; cmp x10, x28
    (if (get state :trapSites nil)
      (memory-conditional-error state 1409286153 1) ;; b.ls safe
      (progn
        (js-call (get state :boundsErrors) :push (js-length (get state :words)))
        (word state 1409286152)))) ;; b.hi bounds_trap

  (defun memory-emit-pinned-store (state name width idx-reg rV &optional discard)
    (memory-emit-pinned-bounds state width idx-reg)
    (word state (+ (cond ((= name "store-u8") 941648736) ((= name "store-u16") 2015390560)
                     ((= name "store-u32") 3089132384) (t 4162874208))
                   (* idx-reg 65536) rV))
    (unless discard (memory-integer-register state 0 0)))

  (defun memory-operation (state node &optional discard)
    (let* ((name (get node :value)) (children (get node :children)) (width (memory-width name))
           (store (and (> width 0) (= (js-length children) 2))))
      (cond
        ((memory-f64-unary-instruction name) (memory-f64-unary state node))
        ((= name "memory-copy") (memory-copy-op state node))
        ((= name "memory-fill") (memory-fill-op state node))
        ((> width 0)
         (let* ((addr (js-nth 0 children))
                (no-debug (not (get state :debugRanges nil)))
                (pin (get state :pinMemory nil))
                (right (when store (js-nth 1 children)))
                (rV (if (and pin store no-debug (/= name "store-f64"))
                      (let* ((rtype (get right :type))
                             (rk (get right :kind))
                             (rv (get right :value))
                             (reg (if (or (memory-word-type rtype) (memory-wide-type rtype))
                                    (local-register state right rtype) -1)))
                        (if (>= reg 0) reg
                          (if (and (or (= rk "literal") (= rk "int-literal"))
                                   (if (memory-wide-type rtype)
                                     (if (and (not (nil? rv)) (= (value-type rv) "object"))
                                       (and (= (get rv :low) 0) (= (get rv :high) 0))
                                       (= rv 0))
                                     (= rv 0)))
                            31 -1)))
                      -1))
                (constAddr (if (and pin no-debug (memory-word-type (get addr :type)))
                             (memory-word-imm12 addr) -1))
                (rA (if (and pin no-debug (< constAddr 0) (memory-word-type (get addr :type)))
                      (local-register state addr "u32") -1))
                (baseImmRaw (if (and pin no-debug (< constAddr 0) (< rA 0)) (memory-addr-base-imm state addr) nil))
                (baseImm (when baseImmRaw
                           (if (= (get baseImmRaw :imm) 0)
                             (progn (setq rA (get baseImmRaw :reg)) nil)
                             baseImmRaw)))
                (addrReg (if (>= rA 0) rA (if baseImm (get baseImm :reg) -1))))
           (cond
             ((and (>= constAddr 0) (<= (+ constAddr width) 4095) (= (% constAddr width) 0) (/= name "store-f64"))
              (when (and store (< rV 0)) (expression state right))
              (word state (+ 4043309983 (* (+ constAddr width) 1024))) ;; cmp x28, #(constAddr+width)
              (if (get state :trapSites nil)
                (memory-conditional-error state 1409286146 1) ;; b.hs safe
                (progn
                  (js-call (get state :boundsErrors) :push (js-length (get state :words)))
                  (word state 1409286147))) ;; b.lo bounds_trap
              (let ((scaled (/ constAddr width)))
                (if store
                  (progn
                    (word state (+ (cond ((= name "store-u8") 956302176)
                                         ((= name "store-u16") 2030044000)
                                         ((= name "store-u32") 3103785824)
                                         (t 4177527648))
                                   (* scaled 1024)
                                   (if (>= rV 0) rV 0)))
                    (unless discard (memory-integer-register state 0 0)))
                  (word state (+ (cond ((= name "load-u8") 960496480)
                                       ((= name "load-u16") 2034238304)
                                       ((= name "load-u32") 3107980128)
                                       ((= name "load-f64") 4248830816)
                                       (t 4181721952))
                                 (* scaled 1024))))))
             ((and pin (not store) (or (>= rA 0) baseImm))
              (let ((idx-reg (if (>= rA 0) rA
                               (progn
                                 (word state (+ 285212681 (* (get baseImm :imm) 1024) (* (get baseImm :reg) 32))) ;; add w9, wBase, #imm
                                 9))))
                (memory-emit-pinned-bounds state width idx-reg)
                (word state (+ (cond ((= name "load-u8") 945843040) ((= name "load-u16") 2019584864)
                                 ((= name "load-u32") 3093326688) ((= name "load-f64") 4234177376)
                                 (t 4167068512)) (* idx-reg 65536)))))
             ((and pin store (>= rV 0))
              (let ((idx-reg (cond
                               ((>= rA 0) rA)
                               (baseImm
                                (word state (+ 285212681 (* (get baseImm :imm) 1024) (* (get baseImm :reg) 32))) ;; add w9, wBase, #imm
                                9)
                               (t (expression state addr) 0))))
                (memory-emit-pinned-store state name width idx-reg rV discard)))
             ((and pin store no-debug (/= name "store-f64") (< rV 0)
                   (or (>= rA 0) baseImm)
                   (and (>= addrReg 0) (not (memory-expr-writes-reg-p state right addrReg))))
              (expression state right)
              (let ((idx-reg (if (>= rA 0) rA
                               (progn
                                 (word state (+ 285212681 (* (get baseImm :imm) 1024) (* (get baseImm :reg) 32))) ;; add w9, wBase, #imm
                                 9))))
                (memory-emit-pinned-store state name width idx-reg 0 discard)))
             (t
              (expression state addr)
              (when store
                (let ((move-temp (if (= name "store-f64") 509624322
                                   (if (or (= name "store-v64") (= name "store-bits64")) 2852127714 704644066))))
                  (if (or (= (get right :kind) "literal") (= (get right :kind) "int-literal") (= (get right :kind) "local"))
                      (progn
                        (word state 704644065) ;; mov w1,w0
                        (expression state right)
                        (word state move-temp) ;; fmov d2,d0 / mov x2,x0 / mov w2,w0
                        (word state 704709600)) ;; mov w0,w1
                    (progn
                      (push-value state "u32")
                      (expression state right)
                      (word state move-temp)
                      (pop-value state "u32") (word state 704709600)))))
              ;; w0 zero-extends address; compare address+width in 64 bits before
              ;; adding the host pointer, including near-4GiB wrapping addresses.
              (word state (+ 2432696330 (* width 1024))) ;; add x10,x0,#width
              (if pin
                  (progn
                    (word state 3944481119) ;; cmp x10, x28
                    (if (get state :trapSites nil)
                        (memory-conditional-error state 1409286153 1) ;; b.ls safe
                      (progn
                        (js-call (get state :boundsErrors) :push (js-length (get state :words)))
                        (word state 1409286152))) ;; b.hi bounds_trap
                    (word state (cond ((= name "load-u8") 945843040) ((= name "load-u16") 2019584864)
                      ((= name "load-u32") 3093326688) ((= name "load-f64") 4234177376)
