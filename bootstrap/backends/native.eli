           (state (js-object :words (if (get (or options (js-object)) :packedWords nil) (native-word-buffer) (js-array)) :calls (js-array) :constants (js-array)
                    :compact nil :leaf nil :memory t :linux linux :registers (js-array)
                    :debugRanges (if debug (js-array) nil)
                    :trapSites (if debug (js-array) nil)
                    :hostCapabilities (get program :hostCapabilities (js-array))
                    :table (get program :table nil) :tableUses (js-array)))
