                                 (js-object :kind "literal" :type "f64" :value 1) (js-nth 0 children)))
                         (right (if (= length 2) (js-nth 1 children)
                                  (if (= value "/") (js-nth 0 children)
                                    (js-object :kind "literal" :type "f64" :value 1))))
                         (l (capture-before state (pure-value state left) right)) (r (pure-value state right)))
                    (binary-word state (cond ((or (= value "+") (= value "1+")) 509618208)
                      ((or (= value "-") (= value "1-")) 509622304)
