           (word state (+ 4244636640 (* offset 128) reg))
         (progn (emit-sp-address-x9 state offset) (word state (+ 4244635936 reg)))))
      ((memory-wide-type type)
       (if (and (= (% offset 8) 0) (<= offset 32760))
           (word state (+ 4177527776 (* offset 128) reg))
         (progn (emit-sp-address-x9 state offset) (word state (+ 4177527072 reg)))))
      (t
       (if (and (= (% offset 4) 0) (<= offset 16380))
           (word state (+ 3103785952 (* offset 256) reg))
         (progn (emit-sp-address-x9 state offset) (word state (+ 3103785248 reg)))))))

  (defun memory-move-to-reg (state node reg wide)
    ;; Move locals and small constants directly into the call's GPR.
    (let ((kind (get node :kind)) (type (get node :type)))
      (cond
        ((and (= kind "local") (or (memory-word-type type) (memory-wide-type type)))
         (expression state node nil reg))
        ((and (not (get state :debugRanges nil)) (or (= kind "literal") (= kind "int-literal")) (memory-wide-type type))
         (let ((val (get node :value)))
           (if (and (not (nil? val)) (= (value-type val) "object"))
             (memory-wide-register state reg (uint32 (get val :low)) (uint32 (get val :high)))
             (memory-wide-register state reg (uint32 val) 0))))
        ((and (not (get state :debugRanges nil)) (or (= kind "literal") (= kind "int-literal")) (memory-word-type type))
         (memory-integer-register state reg (get node :value)))
        (t
         (expression state node)
         (word state (+ (if wide 2852127712 704644064) reg))))))
  (defun memory-call (state node)
    (let* ((args (get node :children)) (indirect (= (get node :kind) "call-indirect"))
           (count (- (js-length args) (if indirect 1 0)))
           (param-types (if indirect
                            (get node :parameterTypes)
                          (function-param-types (js-nth (get node :value) (get state :functions)))))
           (layout (compute-native-param-layout param-types (get state :linux nil)))
           (slots (get layout :slots))
           (extra (get layout :stackBytes))
           (i 0))
      (if (and (not indirect) (not (get layout :hasStack)) (not (get layout :hasFpr)))
          (let ((last-complex -1))
            (while (< i count)
              (let ((arg (js-nth i args)))
                (unless (and (or (memory-word-type (get arg :type)) (memory-wide-type (get arg :type)))
                             (or (= (get arg :kind) "literal") (= (get arg :kind) "int-literal") (= (get arg :kind) "local")))
                  (setq last-complex i)))
              (setq i (1+ i)))
            (setq i 0)
            (while (< i last-complex)
              (let ((arg (js-nth i args)))
                (expression state arg) (push-value state (get arg :type)) (setq i (1+ i))))
            (when (>= last-complex 0)
              (let ((slot (js-nth last-complex slots)))
                (memory-move-to-reg state (js-nth last-complex args) (get slot :reg)
                  (memory-wide-type (get slot :type)))
                (setq i (1+ last-complex))))
            (while (< i count)
              (let ((slot (js-nth i slots)))
                (memory-move-to-reg state (js-nth i args) (get slot :reg)
                  (memory-wide-type (get slot :type)))
                (setq i (1+ i))))
            (setq i 0)
            (while (< i last-complex)
              (let ((offset (* (- last-complex i 1) 16))
                    (slot (js-nth i slots)))
                (emit-sp-load state (get slot :type) (get slot :reg) offset))
              (setq i (1+ i)))
            (when (> last-complex 0)
              (stack-adjust state (* last-complex 16) nil)
              (put state :depth (- (get state :depth) last-complex))))
        (progn
          (while (< i (js-length args))
            (let ((arg (js-nth i args)))
              (expression state arg) (push-value state (get arg :type)) (setq i (1+ i))))
          (when indirect (pop-value state "u32") (memory-indirect-target state node))
          (stack-adjust state extra t)
          (setq i 0)
          (while (< i count)
            (let* ((src-off (+ extra (* (- count i 1) 16)))
                   (slot (js-nth i slots))
                   (kind (get slot :kind))
                   (type (get slot :type)))
              (cond
                ((= kind "gpr") (emit-sp-load state type (get slot :reg) src-off))
                ((= kind "fpr") (emit-sp-load state "f64" (get slot :reg) src-off))
                (t
                 (let ((scratch (if (= type "f64") 16 10)))
