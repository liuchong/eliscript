            (let ((fwd1-loop (js-length (get state :words))))
              (word state 943723852) ;; ldrb w12,[x10],#1
              (word state 939529516) ;; strb w12,[x9],#1
              (word state 4043310509) ;; subs x13,x13,#1
              (let ((back1 (js-length (get state :words))))
                (word state 1409286145) (patch-jump state back1 fwd1-loop)))
            (patch-jump state fwd-done (js-length (get state :words))))
          (let ((finish (jump state "jump")))
            (patch-jump state backward (js-length (get state :words)))
            ;; Backward 8B + 1B loop (memmove-exact when dst_ptr > src_ptr)
            (word state 2332885289) ;; add x9,x9,x13
            (word state 2332885322) ;; add x10,x10,x13
            (let ((bwd8 (js-length (get state :words))))
              (word state 4043317695) ;; cmp x13,#8
              (let ((bwd1 (js-length (get state :words))))
                (word state 1409286147) ;; b.lo bwd1
                (word state 4167011660) ;; ldr x12,[x10,#-8]!
                (word state 4162817324) ;; str x12,[x9,#-8]!
                (word state 3506446765) ;; sub x13,x13,#8
                (let ((back8 (jump state "jump"))) (patch-jump state back8 bwd8))
                (patch-jump state bwd1 (js-length (get state :words)))))
            (let ((bwd-done (js-length (get state :words))))
              (word state 3019898893) ;; cbz x13, bwd-done
              (let ((bwd1-loop (js-length (get state :words))))
                (word state 945814860) ;; ldrb w12,[x10,#-1]!
                (word state 941620524) ;; strb w12,[x9,#-1]!
                (word state 4043310509) ;; subs x13,x13,#1
                (let ((back1 (js-length (get state :words))))
                  (word state 1409286145) (patch-jump state back1 bwd1-loop)))
              (patch-jump state bwd-done (js-length (get state :words))))
            (patch-jump state finish (js-length (get state :words)))))
        (patch-jump state done (js-length (get state :words))))
      (memory-integer-register state 0 0)))

  (defun memory-fill-op (state node)
    (let* ((children (get node :children))
           (val-node (js-nth 1 children))
           (val0 (and (or (= (get val-node :kind) "literal") (= (get val-node :kind) "int-literal"))
                      (= (value-type (get val-node :value)) "number")
