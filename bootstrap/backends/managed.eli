(module eliscript.backend.managed
  (import "./numeric.mjs" backend-fail find-function)
  (import "./memory.mjs" lower-memory-program)
  (import "./wasm.mjs" emit-typed-memory-wasm append-metadata-section)

  ;; Ordinary control-flow values use the managed heap. This explicit
  ;; experimental profile does not admit unimplemented language operations.
  (defun managed-fail (node message)
    (try (backend-fail node message)
      (catch error (put (get error :eliscriptDiagnostic) :phase "managed-backend") (throw error))))
  (defun word-node (kind children value)
    (js-object :kind kind :type "u32" :children children :value value))
  (defun word-constant (value) (word-node "literal" (js-array) value))
  (defun word-local (entry) (word-node "local" (js-array) (get entry :index)))
  (defun word-set (entry value) (word-node "set" (js-array value) (get entry :index)))
  (defun word-sequence (children)
    (let ((result (js-call children :slice)))
      (js-call result :push (word-constant 0)) (word-node "sequence" result nil)))
  (defun word-compare (left right operator)
    (js-object :kind "word-compare" :type "i32" :children (js-array left right) :value operator))
  (defun word-if (condition yes no) (word-node "if" (js-array condition yes no) nil))
  (defun append-managed (output values)
    (let ((index 0))
      (while (< index (js-length values)) (js-call output :push (js-nth index values)) (setq index (1+ index)))) output)
  (defun collect-managed-declarations (nodes output)
    (let ((index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (if (= (get node :kind) "module-declaration") (collect-managed-declarations (get node :children) output)
            (js-call output :push node))) (setq index (1+ index)))) output)
  (defun find-local (scope name)
    (let ((index (1- (js-length scope))) (found nil))
      (while (and (>= index 0) (not found))
        (when (= (get (js-nth index scope) :name) name) (setq found (js-nth index scope)))
        (setq index (1- index))) found))
  (defun new-managed-local (state name rooted)
    (let* ((locals (get state :locals))
           (entry (js-object :name name :type "u32" :index (js-length locals))))
      (when rooted (put entry :rootIndex (get state :roots)) (put state :roots (1+ (get state :roots))))
      (js-call locals :push entry) entry))
  (defun runtime-call (state name arguments)
    (let ((function (find-function (get state :runtime) name)))
      (unless function (managed-fail nil (str "managed runtime lacks " name)))
      (word-node "call" arguments (get function :index))))
  (defun runtime-arguments (state values)
    (let ((arguments (js-array (word-local (get state :heap)))))
      (append-managed arguments values)))
  (defun capture-error (state)
    (word-set (get state :error) (runtime-call state "last-error" (js-array))))
  (defun managed-guard (state expression)
    (word-if (word-compare (word-local (get state :error)) (word-constant 0) "=") expression (word-constant 0)))
  (defun checked-control (state name arguments)
    (managed-guard state (word-sequence (js-array
      (runtime-call state name arguments) (capture-error state)))))
  (defun root-local (state local)
    (checked-control state "frame-set" (runtime-arguments state
      (js-array (word-local (get state :frame)) (word-constant (get local :rootIndex)) (word-local local)))))
  (defun managed-result (state expression allocating)
    (let* ((local (new-managed-local state "temporary" t))
           (steps (js-array (managed-guard state (word-set local expression)))))
      (when allocating (js-call steps :push (managed-guard state (capture-error state))))
      (js-call steps :push (root-local state local))
      (js-object :steps (word-sequence steps) :result (word-local local))))
  (defun value-truth-call (state expression)
    ;; A raw u32 is a Number in scalar IR and therefore truthy. Mark the
    ;; runtime's 0/1 truth result as an i32 predicate before branching.
    (word-compare (runtime-call state "value-truth" (runtime-arguments state (js-array expression))) (word-constant 0) "/="))
  (defun lower-managed-sequence (nodes scope state functions)
    (let ((steps (js-array)) (result (word-constant 0)) (index 0))
      (while (< index (js-length nodes))
        (let ((lowered (lower-managed-expression (js-nth index nodes) scope state functions)))
          (js-call steps :push (get lowered :steps)) (setq result (get lowered :result)))
        (setq index (1+ index)))
      (js-object :steps (word-sequence steps) :result result)))
  (defun lower-managed-literal (node state)
    (let* ((value (get node :value)) (properties (get node :properties nil)) (type (value-type value)))
      (if properties
        (if (= (get properties :literalKind nil) "undefined") (managed-result state (word-constant 3) nil)
          (managed-fail node "managed control does not implement tagged persistent literals"))
        (cond
          ((nil? value) (managed-result state (word-constant 0) nil))
          ((= type "boolean") (managed-result state (word-constant (if value 2 1)) nil))
          ((= type "number")
           (let ((words (number-float64-words value)))
             (when (and (= value 0) (< (/ 1 value) 0)) (put words 1 2147483648))
             (managed-result state (runtime-call state "value-number" (runtime-arguments state
               (js-array (word-constant (js-nth 0 words)) (word-constant (js-nth 1 words))))) t)))
          ((= type "string")
           (let* ((result (managed-result state (runtime-call state "value-string" (runtime-arguments state
                            (js-array (word-constant (js-length value))))) t))
                  (steps (js-array (get result :steps))) (index 0))
             (while (< index (js-length value))
               (js-call steps :push (checked-control state "value-unit-set" (runtime-arguments state
                 (js-array (get result :result) (word-constant index) (word-constant (string-code-unit-at value index))))))
               (setq index (1+ index)))
             (js-call steps :push (checked-control state "value-seal" (runtime-arguments state (js-array (get result :result)))))
             (put result :steps (word-sequence steps)) result))
          (t (managed-fail node "managed control literal is unsupported"))))))
  (defun lower-managed-bindings (node scope state functions)
    (let* ((children (get node :children)) (properties (get node :properties))
           (count (get properties :bindingCount)) (inner (js-call scope :slice))
           (pending (js-array)) (steps (js-array)) (index 0))
      (while (< index count)
        (let* ((binding (js-nth index children))
               (value (lower-managed-expression (js-nth 0 (get binding :children))
                        (if (get properties :sequential) inner scope) state functions))
               (local (new-managed-local state (get binding :value) t)))
          (unless (and (= (get binding :kind) "lexical-binding") (= (js-length (get binding :children)) 1))
            (managed-fail binding "managed control requires initialized bindings"))
          (js-call steps :push (get value :steps) (managed-guard state (word-set local (get value :result))) (root-local state local))
          (js-call pending :push local) (when (get properties :sequential) (js-call inner :push local)))
        (setq index (1+ index)))
      (unless (get properties :sequential) (append-managed inner pending))
      (let ((body (lower-managed-sequence (js-call children :slice count) inner state functions)))
        (js-call steps :push (get body :steps)) (js-object :steps (word-sequence steps) :result (get body :result)))))
  (defun lower-managed-conditional (condition yes no scope state functions)
    (let* ((test (lower-managed-expression condition scope state functions))
           (left (lower-managed-expression yes scope state functions))
           (right (lower-managed-expression no scope state functions))
           (local (new-managed-local state "conditional" t)))
      (js-object :steps (word-sequence (js-array (get test :steps)
        (managed-guard state (word-if (value-truth-call state (get test :result))
          (word-sequence (js-array (get left :steps) (managed-guard state (word-set local (get left :result)))))
          (word-sequence (js-array (get right :steps) (managed-guard state (word-set local (get right :result)))))))
        (root-local state local))) :result (word-local local))))
  (defun lower-managed-chain (clauses index scope state functions)
    (if (= index (js-length clauses)) (js-object :steps (word-constant 0) :result (word-constant 0))
      (let* ((clause (js-nth index clauses)) (children (get clause :children)))
        (when (= (js-length children) 0) (managed-fail clause "managed cond clause requires a test"))
        (let* ((test (lower-managed-expression (js-nth 0 children) scope state functions))
               (yes (if (= (js-length children) 1) (js-object :steps (word-constant 0) :result (get test :result))
                      (lower-managed-sequence (js-call children :slice 1) scope state functions)))
               (no (lower-managed-chain clauses (1+ index) scope state functions))
               (local (new-managed-local state "cond" t)))
          (js-object :steps (word-sequence (js-array (get test :steps)
            (managed-guard state (word-if (value-truth-call state (get test :result))
              (word-sequence (js-array (get yes :steps) (managed-guard state (word-set local (get yes :result)))))
              (word-sequence (js-array (get no :steps) (managed-guard state (word-set local (get no :result)))))))
            (root-local state local))) :result (word-local local))))))
  (defun lower-managed-short (node scope state functions)
    (let* ((children (get node :children)) (operator (get node :value))
           (local (new-managed-local state "short-circuit" t)) (index 0) (steps (js-array)))
      (js-call steps :push (managed-guard state (word-set local (word-constant (if (= operator "and") 2 0)))))
      (while (< index (js-length children))
        (let* ((operand (lower-managed-expression (js-nth index children) scope state functions))
               (evaluate (word-sequence (js-array (get operand :steps)
                           (managed-guard state (word-set local (get operand :result))) (root-local state local)))))
          (js-call steps :push
            (if (= index 0) evaluate
              (managed-guard state (word-if (value-truth-call state (word-local local))
                (if (= operator "and") evaluate (word-constant 0))
                (if (= operator "or") evaluate (word-constant 0)))))))
        (setq index (1+ index)))
      (js-object :steps (word-sequence steps) :result (word-local local))))
  (defun lower-managed-expression (node scope state functions)
    (let ((kind (get node :kind)) (value (get node :value)) (children (get node :children)))
      (cond
        ((= kind "literal") (lower-managed-literal node state))
        ((= kind "reference")
         (let ((local (find-local scope value)))
           (unless local (managed-fail node (str "unknown managed local: " value)))
           (js-object :steps (word-constant 0) :result (word-local local))))
        ((= kind "lexical-bindings") (lower-managed-bindings node scope state functions))
        ((= kind "sequence") (lower-managed-sequence children scope state functions))
        ((= kind "assignment")
         (let ((steps (js-array)) (result (word-constant 0)) (index 0))
           (while (< index (js-length children))
             (let* ((pair (js-nth index children)) (local (find-local scope (get pair :value))))
               (unless local (managed-fail pair "assignment requires an existing managed local"))
               (let ((rhs (lower-managed-expression (js-nth 0 (get pair :children)) scope state functions)))
                 (js-call steps :push (get rhs :steps) (managed-guard state (word-set local (get rhs :result))) (root-local state local))
                 (setq result (word-local local)))) (setq index (1+ index)))
           (js-object :steps (word-sequence steps) :result result)))
        ((= kind "conditional") (lower-managed-conditional (js-nth 0 children) (js-nth 1 children) (js-nth 2 children) scope state functions))
        ((= kind "conditional-chain") (lower-managed-chain children 0 scope state functions))
        ((= kind "conditional-sugar")
         (let* ((test (lower-managed-expression (js-nth 0 children) scope state functions))
                (body (lower-managed-sequence (js-call children :slice 1) scope state functions))
                (local (new-managed-local state "sugar" t)))
           (unless (or (= value "when") (= value "unless")) (managed-fail node "unsupported managed conditional"))
           (let ((evaluate (word-sequence (js-array (get body :steps) (managed-guard state (word-set local (get body :result)))))))
             (js-object :steps (word-sequence (js-array (get test :steps)
               (managed-guard state (word-if (value-truth-call state (get test :result))
                 (if (= value "when") evaluate (managed-guard state (word-set local (word-constant 0))))
                 (if (= value "unless") evaluate (managed-guard state (word-set local (word-constant 0))))))
               (root-local state local))) :result (word-local local)))))
        ((and (= kind "loop") (= value "while"))
         (let* ((test (lower-managed-expression (js-nth 0 children) scope state functions))
                (body (lower-managed-sequence (js-call children :slice 1) scope state functions))
                (condition (js-object :kind "sequence" :type "i32" :children (js-array (get test :steps)
                  (word-if (word-compare (word-local (get state :error)) (word-constant 0) "=")
                    (value-truth-call state (get test :result)) (word-constant 0))) :value nil)))
           (js-object :steps (managed-guard state (js-object :kind "while" :type "i32" :children (js-array condition (get body :steps)) :value nil))
             :result (word-constant 0))))
        ((= kind "short-circuit") (lower-managed-short node scope state functions))
        ((and (= kind "intrinsic") (= value "not") (= (js-length children) 1))
         (let* ((operand (lower-managed-expression (js-nth 0 children) scope state functions))
                (result (managed-result state (word-if (value-truth-call state (get operand :result)) (word-constant 1) (word-constant 2)) nil)))
           (put result :steps (word-sequence (js-array (get operand :steps) (get result :steps)))) result))
        ((and (= kind "call") (> (js-length children) 0) (= (get (js-nth 0 children) :kind) "reference"))
         (let* ((name (get (js-nth 0 children) :value)) (function (find-function functions name))
                (steps (js-array)) (arguments (js-array (word-local (get state :heap)))) (index 1))
           (unless (and function (not (find-local scope name))) (managed-fail node "managed control requires an unshadowed named function"))
           (unless (= (1- (js-length children)) (get function :publicArity)) (managed-fail node "managed call arity mismatch"))
           (while (< index (js-length children))
             (let ((argument (lower-managed-expression (js-nth index children) scope state functions)))
               ;; A reference or assignment result may name a mutable local.
               ;; Snapshot it before later argument effects can overwrite it.
               (let ((snapshot (managed-result state (get argument :result) nil)))
                 (js-call steps :push (get argument :steps) (get snapshot :steps))
                 (js-call arguments :push (get snapshot :result)))) (setq index (1+ index)))
           (let ((result (managed-result state (word-node "call" arguments (get function :index)) t)))
             (js-call steps :push (get result :steps)) (put result :steps (word-sequence steps)) result)))
        (t (managed-fail node (str "unsupported managed control IR: " kind ":" value))))))

  (defun lower-managed-function (function functions runtime)
    (let* ((node (get function :source)) (children (get node :children))
           (arity (get function :publicArity)) (state (js-object :locals (js-array) :roots 0 :runtime runtime))
           (heap (new-managed-local state "heap" nil)) (scope (js-array)) (index 0))
      (put state :heap heap)
      (while (< index arity)
        (let ((parameter (js-nth index children)))
          (unless (and (= (get parameter :kind) "parameter-binding")
                       (= (get (get parameter :properties) :parameterKind) "required"))
            (managed-fail parameter "managed control requires required parameters"))
          (js-call scope :push (new-managed-local state (get parameter :value) t))) (setq index (1+ index)))
      (put state :error (new-managed-local state "error" nil)) (put state :frame (new-managed-local state "frame" nil))
      (let* ((body (lower-managed-sequence (js-call children :slice arity) scope state functions))
             (result (new-managed-local state "result" nil)) (steps (js-array)))
        (js-call steps :push (runtime-call state "begin-operation" (js-array))
          (runtime-call state "heap-check" (runtime-arguments state (js-array))) (capture-error state))
        (setq index 0)
        (while (< index arity)
          (js-call steps :push (checked-control state "heap-reference-check" (runtime-arguments state (js-array (word-local (js-nth index scope))))))
          (setq index (1+ index)))
        (js-call steps :push (managed-guard state (word-set (get state :frame)
          (runtime-call state "frame-new" (runtime-arguments state (js-array (word-constant (get state :roots)))))))
          (managed-guard state (capture-error state)))
        (setq index 0)
        (while (< index arity) (js-call steps :push (root-local state (js-nth index scope))) (setq index (1+ index)))
        (js-call steps :push (get body :steps) (managed-guard state (word-set result (get body :result))))
        ;; Internal calls return borrowed values. Neither pop nor the parent's
        ;; immediately following root installation allocates or collects.
        (js-call steps :push (word-if (word-compare (word-local (get state :frame)) (word-constant 0) "/=")
          (runtime-call state "frame-pop" (runtime-arguments state (js-array (word-local (get state :frame))))) (word-constant 0)))
        (js-call steps :push (word-if (word-compare (word-local (get state :error)) (word-constant 0) "=")
          (word-local result) (runtime-call state "fail" (js-array (word-local (get state :error))))))
        (put function :locals (get state :locals)) (put function :body (word-node "sequence" steps nil))))
    function)
  (defun lower-managed-program (program runtime-program)
    (let* ((runtime (lower-memory-program runtime-program)) (runtime-functions (get runtime :functions))
           (declarations (collect-managed-declarations (get program :body) (js-array)))
           (functions (js-array)) (exports (js-array)) (index 0))
      (while (< index (js-length declarations))
        (let ((node (js-nth index declarations)))
          (cond
            ((and (= (get node :kind) "function-declaration") (not (get (get node :properties) :async)))
             (when (find-function functions (get node :value)) (managed-fail node "duplicate managed function"))
             (js-call functions :push (js-object :name (get node :value) :internalName (str "__eliscript_managed_" (js-length functions))
               :index (+ (js-length runtime-functions) (js-length functions)) :arity (1+ (get (get node :properties) :parameterCount))
               :publicArity (get (get node :properties) :parameterCount) :source node)))
            ((= (get node :kind) "export-declaration")
             (append-managed exports (get node :children)))
            (t (managed-fail node "managed control requires synchronous functions and exports")))) (setq index (1+ index)))
      (when (= (js-length functions) 0) (managed-fail program "managed control requires functions"))
      (setq index 0)
      (while (< index (js-length functions)) (lower-managed-function (js-nth index functions) functions runtime-functions) (setq index (1+ index)))
      (let ((aliases (js-array)) (descriptors (js-array)) (seen (new globalThis.Set)) (combined (js-call runtime-functions :slice)))
        (setq index 0)
        (while (< index (js-length exports))
          (let* ((node (js-nth index exports)) (name (get node :value)) (function (find-function functions name)))
            (unless (and (= (get node :kind) "reference") function (not (= name "memory"))
                         (not (js-call (get runtime :exports) :includes name)) (not (js-call seen :has name)))
              (managed-fail node "invalid, duplicate or reserved managed export"))
            (js-call seen :add name)
            (js-call aliases :push (js-object :name name :function (get function :internalName)))
            (js-call descriptors :push (js-object :name name :arity (get function :publicArity))))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length functions))
          (let* ((original (js-nth index functions)) (function (js-object :name (get original :internalName) :index (get original :index)
                   :arity (get original :arity) :locals (get original :locals) :body (get original :body))))
            (js-call combined :push function)) (setq index (1+ index)))
        (js-object :typed (js-object :abi "memory-u32" :filename (get program :filename) :functions combined
                           :exports (get runtime :exports) :aliases aliases)
          :descriptor (js-object :format "eliscript-managed-control" :version 1 :abi "managed-control-v1" :functions descriptors)))))
  (defun emit-managed-wasm (program runtime-program &optional options)
    (let* ((lowered (lower-managed-program program runtime-program))
           (bytes (emit-typed-memory-wasm (get lowered :typed) (or options (js-object)))))
      (append-metadata-section bytes "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
  (export lower-managed-program emit-managed-wasm))
