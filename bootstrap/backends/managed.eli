      ;; The JS intrinsic still looks up the lexical String binding. Check it
      ;; before module globals receive private names and lose that spelling.
      (when (and (= kind "intrinsic") (= (get node :value) "string-from-code-unit")
                 (or (managed-link-local-name scope "String") (js-call (get record :bindings) :has "String")))
        (managed-link-fail node "managed String constructor binding is shadowed"))
      (cond
        ((and (= kind "raw-javascript")
              (or (= (managed-static-reference node) "String") (= (managed-static-reference node) "globalThis.String")))
         (let* ((name (managed-static-reference node))
                (reference (js-call globalThis.Object :assign (js-object) node
                  (js-object :kind "reference" :value name :children (js-array) :properties nil))))
           (setq copy (managed-link-copy-node reference record scope records (1+ depth)))))
        ((and (= kind "reference") (managed-link-qualified node record scope records))
         (setq copy (managed-link-qualified node record scope records)))
        ((and (= kind "method-call") (> (js-length children) 1)
              (= (get (js-nth 0 children) :kind) "reference")
              (not (managed-link-local-name scope (get (js-nth 0 children) :value)))
              (js-call (get record :bindings) :has (get (js-nth 0 children) :value))
              (get (managed-link-binding record (get (js-nth 0 children) :value) records node) :namespaceValue nil))
         (put copy :kind "call") (put copy :value nil)
         (js-call output :push (managed-link-property node
           (managed-link-copy-node (js-nth 0 children) record scope records (1+ depth)) (get (js-nth 1 children) :value)))
         (setq index 2)
         (while (< index (js-length children))
           (js-call output :push (managed-link-copy-node (js-nth index children) record scope records (1+ depth))) (setq index (1+ index))))
        ((or (= kind "function-declaration") (= kind "function-expression"))
         (let ((inner (new globalThis.Set scope)) (count (get properties :parameterCount)))
           (unless (and (= (value-type count) "number") (= count (uint32 count)) (<= count (js-length children)))
             (managed-link-fail node "invalid managed project function parameters"))
           (when (= kind "function-declaration")
             (put copy :value (get (managed-link-binding record (get node :value) records node) :canonical)))
           (while (< index count)
             (let ((parameter (js-nth index children)))
               (unless (= (get parameter :kind) "parameter-binding") (managed-link-fail parameter "managed project parameter patterns are not implemented"))
               (js-call output :push (managed-link-copy-node parameter record inner records (1+ depth)))
               (managed-link-scope-add inner (get parameter :value))) (setq index (1+ index)))
           (while (< index (js-length children))
             (js-call output :push (managed-link-copy-node (js-nth index children) record inner records (1+ depth))) (setq index (1+ index)))))
        ((or (= kind "lexical-bindings") (= kind "binding-loop"))
         (let ((inner (new globalThis.Set scope)) (count (get properties :bindingCount)) (sequential (get properties :sequential nil)))
           (unless (and (= (value-type count) "number") (= count (uint32 count)) (<= count (js-length children)))
             (managed-link-fail node "invalid managed project lexical bindings"))
           (while (< index count)
             (let ((binding (js-nth index children)))
               (unless (and (= (get binding :kind) "lexical-binding") (= (value-type (get binding :value)) "string"))
                 (managed-link-fail binding "managed project binding patterns are not implemented"))
               (js-call output :push (managed-link-copy-node binding record (if sequential inner scope) records (1+ depth)))
               (managed-link-scope-add inner (get binding :value))) (setq index (1+ index)))
           (while (< index (js-length children))
             (js-call output :push (managed-link-copy-node (js-nth index children) record inner records (1+ depth))) (setq index (1+ index)))))
        (t
          (when (= kind "constructor-call")
            (let* ((ctor (js-nth 0 children)) (name (if (= (get ctor :kind) "raw-javascript")
                     (get (js-nth 0 (get ctor :children)) :value) (get ctor :value)))
                   (base (if (or (= name "globalThis.Map") (= name "globalThis.Set")) "globalThis" name)))
              (when (and (or (= name "Map") (= name "Set") (= name "globalThis.Map") (= name "globalThis.Set"))
                         (or (js-call scope :has base) (js-call (get record :bindings) :has base)))
                (managed-link-fail ctor "managed collection constructor binding is shadowed"))))
          (when (= kind "assignment-pair")
            (let ((binding (js-call (get record :bindings) :get (get node :value))))
              (when (and binding (get binding :imported nil) (not (managed-link-local-name scope (get node :value))))
                (managed-link-fail node "cannot assign to a managed project import"))))
          (when (or (= kind "reference") (= kind "assignment-pair"))
            (put copy :value (managed-link-reference record (get node :value) scope records node)))
          (when (= kind "variable-declaration")
            (put copy :value (get (managed-link-binding record (get node :value) records node) :canonical)))
          (while (< index (js-length children))
            (js-call output :push (managed-link-copy-node (js-nth index children) record scope records (1+ depth))) (setq index (1+ index))))) copy))
  (defun link-managed-project (modules entry)
    (unless (and (Array/isArray modules) (> (js-length modules) 0) (managed-link-id-p entry))
      (managed-link-fail nil "managed project requires module records and an entry identity"))
    (let* ((records (new globalThis.Map)) (ids (js-array)) (index 0) (counter 0) (salt 0)
           (identity nil) (prefix "$eliscript_link_0_"))
      (while (< index (js-length modules))
        (let* ((input (js-nth index modules))
               (_record (unless (and (not (nil? input)) (= (value-type input) "object") (not (Array/isArray input))
                                    (= (js-length (js-call globalThis.Object :getOwnPropertyNames input)) 2)
                                    (= (js-length (js-call globalThis.Object :getOwnPropertySymbols input)) 0)
                                    (js-call globalThis.Object :hasOwn input "id") (js-call globalThis.Object :hasOwn input "program")
                                    (js-call globalThis.Object :hasOwn (js-call globalThis.Object :getOwnPropertyDescriptor input "id") "value")
                                    (js-call globalThis.Object :hasOwn (js-call globalThis.Object :getOwnPropertyDescriptor input "program") "value"))
                          (managed-link-fail nil "managed project module records require id and program data fields")))
               (id (get input :id nil)) (program (get input :program nil)))
          (unless (and (managed-link-id-p id) program (not (js-call records :has id)))
            (managed-link-fail program "invalid or duplicate managed project module identity"))
          (serialize-program program)
          (js-call ids :push id)
          (js-call records :set id (js-object :id id :program program
            :declarations (collect-managed-declarations (get program :body) (js-array))
            :bindings (new globalThis.Map) :exports (new globalThis.Map) :dependencies (js-array)))) (setq index (1+ index)))
      (unless (js-call records :has entry) (managed-link-fail nil "managed project entry module is missing"))
      (setq identity (JSON/stringify modules))
      (let ((pending (js-array)) (i 0))
        (while (< i (js-length ids))
          (append-managed pending (get (get (js-call records :get (js-nth i ids)) :program) :body)) (setq i (1+ i)))
        (while (> (js-length pending) 0)
          (let* ((node (js-call pending :pop)) (kind (get node :kind)))
            (when (js-call (js-array "function-declaration" "variable-declaration" "parameter-binding" "lexical-binding"
                         "binding-name" "catch-binding" "import-named" "import-default" "import-namespace") :includes kind)
              (setq identity (str identity " " (managed-binding-key (get node :value)))))
            (append-managed pending (get node :children)))))
      (while (js-call identity :includes prefix) (setq salt (1+ salt)) (setq prefix (str "$eliscript_link_" salt "_")))
      (js-call ids :sort) (setq index 0)
      (while (< index (js-length ids))
        (let* ((record (js-call records :get (js-nth index ids))) (nodes (get record :declarations)) (position 0))
          (while (< position (js-length nodes))
            (let* ((node (js-nth position nodes)) (kind (get node :kind)) (name (get node :value)))
              (cond
                ((or (= kind "function-declaration") (= kind "variable-declaration"))
                 (managed-link-add-binding record name (js-object :canonical (str prefix counter) :source node) node)
                 (setq counter (1+ counter)))
                ((= kind "import-declaration")
                 (let ((target (managed-link-target (get record :id) name node)) (children (get node :children)) (i 0))
                   (unless (js-call records :has target) (managed-link-fail node (str "missing managed project module: " target)))
                   (js-call (get record :dependencies) :push target)
                   (while (< i (js-length children))
                     (let* ((specifier (js-nth i children)) (local (get specifier :value)) (mode (get specifier :kind)))
                       (unless (or (= mode "import-named") (= mode "import-default") (= mode "import-namespace"))
                         (managed-link-fail specifier "invalid managed project import specifier"))
                       (when (and (= mode "import-namespace") (not (get (js-call records :get target) :namespaceBinding nil)))
                         (put (js-call records :get target) :namespaceBinding (js-object :canonical (str prefix counter) :namespaceValue t :source specifier))
                         (setq counter (1+ counter)))
                       (managed-link-add-binding record local
                         (js-object :imported t :namespace (= mode "import-namespace") :target target
                           :exportName local :defaultImport (= mode "import-default") :source specifier) specifier))
                     (setq i (1+ i)))))
                ((= kind "export-declaration")
                 (let ((children (get node :children)) (i 0))
                   (while (< i (js-length children))
                     (let ((reference (js-nth i children)))
                       (unless (= (get reference :kind) "reference") (managed-link-fail reference "invalid managed project export"))
                       (managed-link-add-export record (get reference :value) (get reference :value) reference)) (setq i (1+ i)))))
                ((= kind "export-default")
                 (unless (= (js-length (get node :children)) 1) (managed-link-fail node "invalid managed project default export"))
                 (let* ((local (str prefix counter))
                        (declaration (js-call globalThis.Object :assign (js-object) node
                          (js-object :kind "variable-declaration" :value local :properties (js-object :sourceOperator "defconst" :mutable false)))))
                   (managed-link-add-binding record local (js-object :canonical local :source declaration) node)
                   (let ((key (str prefix "default")))
                     (managed-link-add-export record key local node)
                     (let ((exported (js-call (get record :exports) :get key)))
                       (put exported :publicName "default") (put record :defaultExport exported)))
                   (put nodes position declaration) (setq counter (1+ counter))))
                ((= kind "expression-statement") nil)
                (t (managed-link-fail node "unsupported managed project declaration")))) (setq position (1+ position)))) (setq index (1+ index)))
      (let* ((plan (project-plan (js-array entry) (lambda (id) (get (js-call records :get id) :dependencies))))
             (reachable (get plan :modules)) (colors (new globalThis.Map)) (order (js-array))
             (stack (js-array (js-object :id entry :next 0))) (body (js-array)) (public (js-array)) (namespaces (js-array)) (index 0))
        (while (< index (js-length reachable))
          (let ((record (js-call records :get (get (js-nth index reachable) :id))))
            (js-call (get record :bindings) :forEach (lambda (binding name)
              (managed-link-binding record name records (get binding :source))))
            (js-call (get record :exports) :forEach (lambda (exported name)
              (managed-link-binding record (get exported :local) records (get exported :source))))) (setq index (1+ index)))
        (js-call colors :set entry 1)
        (while (> (js-length stack) 0)
          (let* ((frame (js-nth (1- (js-length stack)) stack)) (record (js-call records :get (get frame :id)))
                 (dependencies (get record :dependencies)) (next (get frame :next)))
            (if (< next (js-length dependencies))
              (let ((target (js-nth next dependencies)))
                (put frame :next (1+ next))
                (unless (js-call colors :has target)
                  (js-call colors :set target 1) (js-call stack :push (js-object :id target :next 0))))
              (progn (js-call stack :pop) (js-call colors :set (get record :id) 2) (js-call order :push (get record :id))))))
        (setq index 0)
        (while (< index (js-length ids))
          (let* ((id (js-nth index ids)) (record (js-call records :get id)) (namespace (get record :namespaceBinding nil)))
            (when (and namespace (js-call colors :has id))
              (let ((entries (js-array)) (used (new globalThis.Set)))
                (js-call (get record :exports) :forEach (lambda (exported name)
                  (let ((key (get exported :publicName)))
                    (when (js-call used :has key) (managed-link-fail (get exported :source) "duplicate managed namespace property"))
                    (js-call used :add key)
                    (js-call entries :push (js-object :name key
                      :bindingName (get (managed-link-binding record (get exported :local) records (get exported :source)) :canonical))))))
                (js-call entries :sort (lambda (a b) (if (< (get a :name) (get b :name)) -1 (if (> (get a :name) (get b :name)) 1 0))))
                (let* ((source (get namespace :source))
                       (node (js-object :kind "managed-module-namespace" :span (get source :span) :value nil :children (js-array) :properties nil :entries entries))
                       (declaration (js-object :kind "variable-declaration" :span (get source :span) :value (get namespace :canonical)
                         :children (js-array node) :properties (js-object :sourceOperator "defconst" :mutable false))))
                  (js-call namespaces :push node) (js-call body :push declaration))))) (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length order))
          (let* ((record (js-call records :get (js-nth index order))) (nodes (get record :declarations)) (i 0))
            (while (< i (js-length nodes))
              (let ((node (js-nth i nodes)))
                (unless (or (= (get node :kind) "import-declaration") (= (get node :kind) "export-declaration"))
                  (js-call body :push (managed-link-copy-node node record (new globalThis.Set) records 0)))) (setq i (1+ i)))) (setq index (1+ index)))
        (let* ((record (js-call records :get entry)) (exports (js-array))
               (program (js-call globalThis.Object :assign (js-object) (get record :program) (js-object :body body))))
          (js-call (get record :exports) :forEach (lambda (exported source-name)
            (let ((name (get exported :publicName)))
              (when (or (= name "memory") (js-call name :startsWith "__eliscript_"))
                (managed-link-fail (get exported :source) "reserved managed project export"))
              (let* ((binding (managed-link-binding record (get exported :local) records (get exported :source)))
                     (reference (js-call globalThis.Object :assign (js-object) (get exported :source)
                       (js-object :kind "reference" :value (get binding :canonical) :children (js-array) :properties nil))))
                (js-call public :push (js-object :name name :internalName (get binding :canonical)))
                (js-call exports :push reference)))))
          (js-call body :push (js-object :kind "export-declaration" :span nil :value nil :children exports :properties nil))
          (js-object :program program :exports public :modules order :namespaces namespaces)))))
  (defun lower-managed-project (modules entry runtime-program)
    (let* ((linked (link-managed-project modules entry))
           (names (js-call (get linked :exports) :map (lambda (item) (get item :name))))
           (lowered (lower-managed-program (get linked :program) runtime-program t names (get linked :namespaces))))
      (put lowered :modules (get linked :modules)) lowered))
  (defun emit-managed-project-wasm (modules entry runtime-program &optional options)
    (let* ((requested (get (or options (js-object)) :abi nil))
           (lowered (lower-managed-project modules entry runtime-program)))
      (when (and (not (nil? requested)) (not (= requested "managed-module-v1")))
        (managed-link-fail nil "managed projects require managed-module-v1"))
      (append-metadata-section (emit-typed-memory-wasm (get lowered :typed) (or options (js-object)))
        "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))

  (export lower-managed-program emit-managed-wasm link-managed-project lower-managed-project emit-managed-project-wasm))
