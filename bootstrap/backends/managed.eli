  (defun managed-merge-host-modules (inputs)
    (let ((result (js-array)) (by-id (new globalThis.Map)) (index 0))
      (while (< index (js-length inputs))
        (let* ((input (js-nth index inputs)) (id (get input :id)) (existing (js-call by-id :get id))
               (edge (js-object :specifier (get input :specifier) :referrer (get input :referrer)
                 :allowedExports (js-call (get input :allowedExports) :slice) :namespace (get input :namespace))))
          (unless existing
            (setq existing (js-object :id id :specifier (get input :specifier) :referrer (get input :referrer)
              :allowedExports (js-array) :namespace false :edges (js-array)))
            (js-call by-id :set id existing) (js-call result :push existing))
          (js-call (get existing :edges) :push edge)
          (when (get input :namespace) (put existing :namespace t))
          (js-call (get input :allowedExports) :forEach (lambda (name)
            (unless (js-call (get existing :allowedExports) :includes name) (js-call (get existing :allowedExports) :push name)))))
        (setq index (1+ index))) result))
  (defun lower-managed-project (modules entry runtime-program &optional options)
    (let* ((linked (link-managed-project modules entry options))
           (foreign-entry (managed-foreign-entry-option options (get linked :program)))
           (names (js-call (get linked :exports) :map (lambda (item) (get item :name))))
           (lowered (lower-managed-program (get linked :program) runtime-program t names (get linked :namespaces) (get linked :hostIdentities) (get linked :hostModules) (get linked :sourceModules) (get (or options (js-object)) :phased false) nil foreign-entry)))
      (put lowered :modules (get linked :modules))
      (when (> (js-length (get linked :privateModules)) 0) (put lowered :privateModules (get linked :privateModules))) lowered))
  (defun emit-managed-project-wasm (modules entry runtime-program &optional options)
    (let* ((requested (get (or options (js-object)) :abi nil))
           (lowered (lower-managed-project modules entry runtime-program options)))
      (when (and (not (nil? requested)) (not (= requested "managed-module-v1")))
        (managed-link-fail nil "managed projects require managed-module-v1"))
      (append-metadata-section (emit-typed-memory-wasm (get lowered :typed) (or options (js-object)))
        "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))

  (defun managed-well-known-symbol (name)
    (when (and (= (value-type name) "string") (js-call name :startsWith "globalThis."))
      (setq name (js-call name :slice 11)))
    (js-call (js-array "Symbol.iterator" "Symbol.toPrimitive" "Symbol.match" "Symbol.replace" "Symbol.search" "Symbol.split" "Symbol.species" "Symbol.isConcatSpreadable" "Symbol.toStringTag" "Symbol.hasInstance" "Symbol.asyncIterator" "Symbol.unscopables" "Symbol.matchAll" "Symbol.dispose" "Symbol.asyncDispose") :indexOf name))
  (defun lower-managed-raw-key (node scope state functions)
    ;; Property contexts interpret literal keywords as strings, as the JS emitter
    ;; does. This does not enable ordinary persistent keyword literals.
    (if (and (= (get node :kind) "literal") (= (get (get node :properties (js-object)) :literalKind nil) "keyword"))
