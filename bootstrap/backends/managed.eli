(module eliscript.backend.managed
  (import "./numeric.mjs" backend-fail find-function)
  (import "./async.mjs" lower-async-program)
  (import "./capabilities.mjs" prepare-host-capabilities)
  (import "../bootstrap/ir.mjs" validate-serializable-program)
  (import "../bootstrap/emitter.mjs" emit-module-function-sources)
  (import "../bootstrap/project.mjs" project-plan)
  (import "../bootstrap/symbol.mjs" binding-name munge-segment)
  (import "./regexp.mjs" compile-regexp-literal)
  (import "./memory.mjs" lower-memory-program)
  (import "./wasm.mjs" emit-typed-memory-wasm append-metadata-section)

  ;; Linker-owned admission facts never become input IR fields or source
  ;; markers. Their keys are real linked programs and cannot retain a build.
  (defconst literal-brand-registries (new globalThis.WeakMap))
  (defconst literal-role-registry (new globalThis.WeakMap))

  ;; Ordinary control-flow values use the managed heap. This explicit
  ;; experimental profile does not admit unimplemented language operations.
  (defun managed-fail (node message)
    (try (backend-fail node message)
      (catch error (put (get error :eliscriptDiagnostic) :phase "managed-backend") (throw error))))
  (defun word-node (kind children value)
    (js-object :kind kind :type "u32" :children children :value value))
  (defun managed-source-root (expression span)
    ;; Guards and their pure operands may be shared. Attach provenance only
    ;; to a private root copy; no child or source IR record is mutated here.
    (if (or (nil? span) (Object/is (get expression :span nil) span)) expression
      (Object/assign (js-object) expression (js-object :span span))))
  (defun word-constant (value) (word-node "literal" (js-array) value))
  (defun word-local (entry) (word-node "local" (js-array) (get entry :index)))
  (defun word-set (entry value) (word-node "set" (js-array value) (get entry :index)))
  (defun word-sequence (children)
    (let ((result (js-call children :slice)))
      (js-call result :push (word-constant 0)) (word-node "sequence" result nil)))
  (defun word-compare (left right operator)
    (js-object :kind "word-compare" :type "i32" :children (js-array left right) :value operator))
  (defun word-if (condition yes no) (word-node "if" (js-array condition yes no) nil))
  (defun append-managed (output values)
    (let ((index 0))
      (while (< index (js-length values)) (js-call output :push (js-nth index values)) (setq index (1+ index)))) output)
  (defun collect-managed-declarations (nodes output)
    (let ((index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (if (= (get node :kind) "module-declaration") (collect-managed-declarations (get node :children) output)
            (js-call output :push node))) (setq index (1+ index)))) output)
  (defun managed-binding-key (name)
    (if (not (= (value-type name) "string")) name
      (try (binding-name name) (catch error name))))
  (defun find-local (scope name)
    (let ((index (1- (js-length scope))) (found nil) (key (managed-binding-key name)))
      (while (and (>= index 0) (not found))
        (when (= (managed-binding-key (get (js-nth index scope) :name)) key) (setq found (js-nth index scope)))
        (setq index (1- index))) found))
  (defun new-managed-local (state name rooted)
    (let* ((locals (get state :locals))
           (entry (js-object :name name :type "u32" :index (js-length locals))))
      (when rooted (put entry :rootIndex (get state :roots)) (put state :roots (1+ (get state :roots))))
      (js-call locals :push entry) entry))
  (defun new-managed-temporary-local (state name)
    ;; Control-flow joins and method dispatch own private result slots just as
    ;; managed-result does. Register their roots without giving them snapshot
    ;; provenance: a later operand must still snapshot a mutable join result.
    ;; The existing RHS boundary first roots its receiving binding/result and
    ;; then clears this registry interval; source bindings/captures stay out.
    (let ((local (new-managed-local state name t)))
      (unless (get state :temporaryRoots nil) (put state :temporaryRoots (js-array)))
      (js-call (get state :temporaryRoots) :push (get local :rootIndex)) local))
  (defun runtime-call (state name arguments)
    (if (and (get state :preparedMethod nil)
             (js-call (js-array "value-array-method-check" "value-array-callback-builtin" "value-text-method-kind"
               "value-array-text-builtin" "value-sequence-concat-kind" "value-sequence-search-kind"
               "value-regexp-check" "value-regexp-method-builtin" "value-promise-method-check"
               "value-source-method-check" "value-text-replacement-check") :includes name))
      (get state :preparedMethod)
      (let ((function (find-function (get state :runtime) name)))
        (unless function (managed-fail nil (str "managed runtime lacks " name)))
        (word-node "call" arguments (get function :index)))))
  (defun runtime-arguments (state values)
    (let ((arguments (js-array (word-local (get state :heap)))))
      (append-managed arguments values)))
  (defun capture-error (state)
    (managed-guard state (word-set (get state :error) (runtime-call state "last-error" (js-array)))))
  (defun managed-guard (state expression)
    (let* ((error (get state :error)) (index (get error :index)) (cached (get state :guardPredicate nil)))
      ;; Only pure IR is shared inside this function's private lowering state.
      ;; Every emitted if still loads the error local and compares it at runtime.
      ;; finish-managed-bindings only rewrites these pure children to themselves.
      (unless (and cached (Object/is (get cached :owner) state) (Object/is (get cached :index) index))
        (let ((zero (word-constant 0)))
          (setq cached (js-object :owner state :index index :zero zero :condition (word-compare (word-local error) zero "=")))
          (put state :guardPredicate cached)))
      (word-if (get cached :condition) expression (get cached :zero))))
  (defun checked-control (state name arguments)
    (managed-guard state (word-sequence (js-array
      (runtime-call state name arguments) (capture-error state)))))
  (defun root-local (state local)
    (checked-control state "frame-set" (runtime-arguments state
      (js-array (word-local (get state :frame)) (word-constant (get local :rootIndex)) (word-local local)))))
  (defun managed-result (state expression allocating)
    (let* ((local (new-managed-local state "temporary" t))
           (steps (js-array (managed-guard state (word-set local expression)))))
      ;; Root ownership belongs to this lowering state, never to a local's
      ;; display name. Source bindings and captures allocate their own roots.
      (unless (get state :temporaryRoots nil) (put state :temporaryRoots (js-array)))
      (js-call (get state :temporaryRoots) :push (get local :rootIndex))
      (when allocating (js-call steps :push (capture-error state)))
      (js-call steps :push (root-local state local))
      (let ((result (word-local local)) (owner (get state :snapshotOwnerToken nil)))
        ;; The token has no reference back to state. Only this private lowered
        ;; record carries provenance; typed nodes and local schemas stay plain.
        (unless owner (setq owner (js-object)) (put state :snapshotOwnerToken owner))
        (js-object :steps (word-sequence steps) :result result
          :snapshotRoot (js-object :stable t :owner owner :epoch (get state :snapshotRootEpoch 0)
            :local local :index (get local :index) :rootIndex (get local :rootIndex) :result result)))))
  (defun managed-temporary-root-count (state)
    (let ((roots (get state :temporaryRoots nil))) (if roots (js-length roots) 0)))
  (defun managed-temporary-root-barrier-p (state node)
    ;; A caught throw or a loop exit can bypass an inner cleanup yet let an
    ;; enclosing RHS finish normally. Keep the original cleanup coverage for
    ;; the entire such RHS, including all nested RHS boundaries. The source IR
    ;; spells while as kind loop; it has no break/continue/return node family.
    ;; Source lambda
    ;; bodies have their own state/frame and do not jump out of this RHS.
    ;; Memoize private booleans so nested ordinary RHS trees are not rescanned.
    (let ((memo (get state :temporaryRootBarriers nil)) (pending (js-array node false)))
      (unless memo (setq memo (new globalThis.WeakMap)) (put state :temporaryRootBarriers memo))
      (while (> (js-length pending) 0)
        (let ((ready (js-call pending :pop)) (current (js-call pending :pop)))
          (when (and current (= (value-type current) "object") (not (js-call memo :has current)))
            (let ((kind (get current :kind)) (children (get current :children nil)))
              (cond
                ((or (not (Array/isArray children))
                     (= kind "try-expression") (= kind "throw-expression") (= kind "loop")
                     (= kind "binding-loop") (= kind "recur") (= kind "await-expression"))
                  (js-call memo :set current t))
                ((or (= kind "function-expression") (= kind "function-declaration"))
                  (js-call memo :set current false))
                (ready
                  (let ((index 0) (barrier false))
                    (while (and (< index (js-length children)) (not barrier))
                      (let ((child (js-nth index children)))
                        (unless (and child (= (value-type child) "object")
                                     (js-call memo :has child) (not (js-call memo :get child)))
                          (setq barrier t)))
                      (setq index (1+ index)))
                    (js-call memo :set current barrier)))
                (t
                  (js-call pending :push current t)
                  (let ((index (1- (js-length children))))
                    (while (>= index 0)
                      (js-call pending :push (js-nth index children) false) (setq index (1- index))))))))))
      ;; Malformed nodes stay conservative; the original expression lowerer
      ;; remains responsible for their structured diagnostic and first error.
      (or (not node) (not (= (value-type node) "object"))
          (not (js-call memo :has node)) (js-call memo :get node))))
  (defun enter-managed-temporary-root-rhs (state node)
    (let ((previous (get state :temporaryRootCleanupBarrier false)))
      (when (or previous (and node (managed-temporary-root-barrier-p state node)))
        (put state :temporaryRootCleanupBarrier t)) previous))
  (defun clear-managed-temporary-roots (state first end)
    (let ((roots (get state :temporaryRoots nil)) (steps (js-array)) (index first))
      ;; The receiving binding or assignment result is rooted before this
      ;; boundary. Clear only private results created while lowering its RHS;
      ;; interleaved named bindings, capture cells and earlier operands survive.
      (while (< index end)
        (let* ((first-root (js-nth index roots)) (end-root (1+ first-root)) (next (1+ index)))
          (while (and (< next end) (= (js-nth next roots) end-root))
            (setq end-root (1+ end-root)) (setq next (1+ next)))
          (js-call steps :push (checked-control state "frame-set" (runtime-arguments state
            (js-array (word-local (get state :frame)) (word-constant first-root) (word-constant 0)))))
          (if (>= (- next index) 3)
            ;; The existing range ABI retains one slot inside its interval.
            ;; Retain the first slot only after it has been cleared to nil.
            (js-call steps :push (checked-control state "frame-clear-range" (runtime-arguments state
              (js-array (word-local (get state :frame)) (word-constant first-root)
                (word-constant end-root) (word-constant first-root)))))
            (when (= (- next index) 2)
              (js-call steps :push (checked-control state "frame-set" (runtime-arguments state
                (js-array (word-local (get state :frame)) (word-constant (1+ first-root)) (word-constant 0)))))))
          (setq index next)))
      (when (> end first)
        ;; The epoch has no other writer. Only roots in this emitted cleanup
        ;; can have lost their value; an earlier operand outside the interval
        ;; remains rooted and must not acquire another snapshot of its steps.
        ;; Record possible clears even behind an abrupt-control barrier: such
        ;; roots stay conservatively invalid although the registry is retained.
        (let ((epoch (1+ (get state :snapshotRootEpoch 0)))
              (cleared (get state :snapshotRootClearedAt nil)) (cursor first))
          (unless cleared
            (setq cleared (new globalThis.Map)) (put state :snapshotRootClearedAt cleared))
          (while (< cursor end)
            (js-call cleared :set (js-nth cursor roots) epoch) (setq cursor (1+ cursor)))
          (put state :snapshotRootEpoch epoch))
        (unless (get state :temporaryRootCleanupBarrier false)
          ;; The receiving value is already rooted and this non-abrupt RHS
          ;; executes every inner cleanup before it can complete normally.
          ;; Retire only its consumed registry interval: ancestor markers lie
          ;; in the unchanged prefix, while a global assignment's newly rooted
          ;; result after END stays in the suffix. Physical frame slots and
          ;; state.roots remain unchanged, including named/captured roots.
          (js-call roots :splice first (- end first))))
      (word-sequence steps)))
  (defun value-truth-call (state expression)
    ;; A raw u32 is a Number in scalar IR and therefore truthy. Mark the
    ;; runtime's 0/1 truth result as an i32 predicate before branching.
    (word-compare (runtime-call state "value-truth" (runtime-arguments state (js-array expression))) (word-constant 0) "/="))
  (defun lower-managed-sequence (nodes scope state functions)
    (let ((steps (js-array)) (result (word-constant 0)) (index 0))
      (while (< index (js-length nodes))
        (let ((lowered (lower-managed-expression (js-nth index nodes) scope state functions)))
          (js-call steps :push (get lowered :steps)) (setq result (get lowered :result)))
        (setq index (1+ index)))
      (js-object :steps (word-sequence steps) :result result)))
  (defun binding-node (kind entry children)
    (let ((node (word-node kind children nil))) (put node :binding entry) node))
  (defun binding-read (entry) (binding-node "binding-get" entry (js-array)))
  (defun resolve-managed-local (scope state name)
    (or (find-local scope name) (find-local (get state :captures) name)
      (when (get state :outerState nil)
        (let ((source (resolve-managed-local (get state :outerScope) (get state :outerState) name)))
          (when source
            (put source :captured t)
            (let* ((captures (get state :captures)) (entry (new-managed-local state name t)))
              (put entry :captured t) (put entry :patternCell (get source :patternCell nil)) (put entry :source source) (put entry :captureIndex (js-length captures))
              (js-call captures :push entry) entry))))))
  (defun finish-managed-bindings (node state)
    (managed-source-root (finish-managed-bindings-core node state) (get node :span nil)))
  (defun finish-managed-bindings-core (node state)
    (let* ((children (get node :children)) (kind (get node :kind)) (index 0))
      (while (< index (js-length children))
        (put children index (finish-managed-bindings (js-nth index children) state)) (setq index (1+ index)))
      (if (or (= kind "binding-get") (= kind "binding-set") (= kind "binding-init"))
        (let ((entry (get node :binding)))
          (if (not (get entry :captured nil))
            (if (= kind "binding-get") (word-local entry) (word-set entry (js-nth 0 children)))
            (if (= kind "binding-get")
              (let ((scratch (new-managed-local state "capture-read" nil)))
                (word-node "sequence" (js-array
                  (managed-guard state (word-set scratch (runtime-call state (if (get entry :patternCell nil) "value-binding-get" "value-cell-get")
                    (runtime-arguments state (js-array (word-local entry))))))
                  (capture-error state) (word-local scratch)) nil))
              (let* ((scratch (new-managed-local state "capture-write" nil))
                     (operation (if (= kind "binding-init")
                       (if (get entry :patternCell nil)
                         (runtime-call state "value-binding-init" (runtime-arguments state (js-array (word-local entry) (word-local scratch))))
                         (word-set entry (runtime-call state "value-cell-new" (runtime-arguments state (js-array (word-local scratch))))))
                       (runtime-call state (if (get entry :patternCell nil) "value-binding-set" "value-cell-set") (runtime-arguments state (js-array (word-local entry) (word-local scratch)))))))
                (word-node "sequence" (js-array (word-set scratch (js-nth 0 children))
                  (managed-guard state operation) (capture-error state) (word-local entry)) nil))))) node)))
  (defun managed-local-backedge-p (kind)
    (or (= kind "while") (= kind "loop") (= kind "remainder-while")
      (= kind "guarded-while") (= kind "guarded-counter-while")))
  (defun managed-local-bank-compatible-p (entry)
    ;; Captures and other annotated storage retain their own declarations. A
    ;; rootIndex is a frame slot, not a local index; emitted frame operands stay
    ;; unchanged when the corresponding temporary word storage is reused.
    (let ((keys (Object/keys entry)) (index 0) (compatible t))
      (while (and compatible (< index (js-length keys)))
        (let ((key (js-nth index keys)))
          (unless (or (= key "name") (= key "type") (= key "index") (= key "rootIndex")) (setq compatible nil)))
        (setq index (1+ index))) compatible))
  (defun compact-managed-function-locals (function &optional preferred)
    ;; One candidate and a fixed number of explicit-stack walks per function.
    ;; Only fresh private managed functions reach this pass, after every binding
    ;; and wrapper has been lowered. Public typed inputs keep their old contract.
    (let* ((locals (get function :locals)) (arity (get function :arity)) (count (js-length locals))
           (body (get function :body)) (candidate nil) (width 1) (safe t) (preferred-count 0) (preferred-loop nil)
           (pending (js-array body nil)))
      (while (> (js-length pending) 0)
        (let* ((in-loop (js-call pending :pop)) (node (js-call pending :pop))
               (kind (get node :kind)) (children (get node :children)) (index 0)
               (nested (or in-loop (managed-local-backedge-p kind))))
          (when (and (not nested) (= kind "sequence") (> (js-length children) width))
            (setq candidate node width (js-length children)))
          (when (and preferred (Object/is node preferred))
            (setq preferred-count (1+ preferred-count)) (when nested (setq preferred-loop t)))
          (when (or (Object/hasOwn node "binding") (Object/hasOwn node "bindings") (Object/hasOwn node "sources")) (setq safe nil))
          (while (< index (js-length children))
            (js-call pending :push (js-nth index children) nested) (setq index (1+ index)))))
      ;; Source-level statement steps are a better storage lifetime boundary
      ;; than a wider nested literal expansion. The pointer is private and must
      ;; identify one actual sequence outside every backedge in this function.
      (when preferred
        (if (and (= preferred-count 1) (not preferred-loop) (= (get preferred :kind) "sequence")
                 (> (js-length (get preferred :children)) 1))
          (setq candidate preferred width (js-length (get preferred :children)))
          (setq safe nil)))
      (if (or (not safe) (not candidate) (< count arity)) function
        (let ((owners (js-call (new globalThis.Array count) :fill -2))
              (mapping (js-call (new globalThis.Array count) :fill -1))
              (groups (js-call (new globalThis.Array width) :fill nil))
              (occurrences 0) (index 0))
          ;; Visit every edge, including shared DAG edges. A local seen in more
          ;; than one direct child, or anywhere outside the candidate, is shared.
          (js-call pending :push body -1)
          (while (> (js-length pending) 0)
            (let* ((owner (js-call pending :pop)) (node (js-call pending :pop))
                   (kind (get node :kind)) (children (get node :children)) (position 0))
              (when (or (= kind "local") (= kind "set") (= kind "initialize"))
                (let ((slot (get node :value)))
                  (if (or (not (Number/isInteger slot)) (< slot 0) (>= slot count)) (setq safe nil)
                    (let ((previous (js-nth slot owners)))
                      (put owners slot (if (= previous -2) owner (if (= previous owner) owner -1)))))))
              (when (Object/is node candidate) (setq occurrences (1+ occurrences)))
              (while (< position (js-length children))
                (js-call pending :push (js-nth position children) (if (Object/is node candidate) position owner))
                (setq position (1+ position)))))
          (while (< index count)
            (let* ((entry (js-nth index locals)) (type (get entry :type)))
              (unless (and (= (get entry :index) index) (or (= type "u32") (= type "i32") (= type "f64"))) (setq safe nil))
              (when (or (< index arity) (not (managed-local-bank-compatible-p entry))) (put owners index -1)))
            (setq index (1+ index)))
          ;; A repeated sequence object can execute at multiple sites. It is
          ;; deliberately excluded rather than assigning ambiguous reset points.
          (if (or (not safe) (/= occurrences 1)) function
            (let ((compacted (js-array)) (banks (new globalThis.Map)) (position 0))
              (setq index 0)
              (while (< index count)
                (let ((owner (js-nth index owners)) (entry (js-nth index locals)))
                  (if (= owner -1)
                    (let ((copy (Object/assign (js-object) entry)))
                      (put copy :index (js-length compacted)) (put mapping index (js-length compacted)) (js-call compacted :push copy))
                    (when (>= owner 0)
                      (unless (js-nth owner groups) (put groups owner (js-array)))
                      (js-call (js-nth owner groups) :push index))))
                (setq index (1+ index)))
              (while (< position width)
                (let ((group (js-nth position groups)) (used (new globalThis.Map)) (offset 0))
                  (when group
                    (while (< offset (js-length group))
                      (let* ((old (js-nth offset group)) (entry (js-nth old locals)) (type (get entry :type))
                             (bank (js-call banks :get type)) (ordinal (or (js-call used :get type) 0)))
                        (unless bank (setq bank (js-array)) (js-call banks :set type bank))
                        (when (= ordinal (js-length bank))
                          (let ((copy (Object/assign (js-object) entry)))
                            (put copy :index (js-length compacted)) (js-call bank :push (js-length compacted)) (js-call compacted :push copy)))
                        (put mapping old (js-nth ordinal bank)) (js-call used :set type (1+ ordinal)))
                      (setq offset (1+ offset)))))
                (setq position (1+ position)))
              (when (< (js-length compacted) count)
                ;; Rewrite each object exactly once: shared pure guard leaves
                ;; must not follow an old->new index chain a second time.
                (let ((seen (new globalThis.Set)))
                  (js-call pending :push body)
                  (while (> (js-length pending) 0)
                    (let ((node (js-call pending :pop)))
                      (unless (js-call seen :has node)
                        (js-call seen :add node)
                        (when (or (= (get node :kind) "local") (= (get node :kind) "set") (= (get node :kind) "initialize"))
                          (put node :value (js-nth (get node :value) mapping)))
                        (let ((children (get node :children)) (child 0))
                          (while (< child (js-length children)) (js-call pending :push (js-nth child children)) (setq child (1+ child))))))))
                (setq position 0)
                (while (< position width)
                  (let ((group (js-nth position groups)))
                    (when group
                      (let* ((children (get candidate :children)) (child (js-nth position children))
                             (steps (js-array)) (offset 0))
                        (while (< offset (js-length group))
                          (let* ((old (js-nth offset group)) (type (get (js-nth old locals) :type))
                                 (zero (js-object :kind "literal" :type type :children (js-array) :value 0)))
                            (js-call steps :push (js-object :kind "set" :type type :children (js-array zero) :value (js-nth old mapping))))
                          (setq offset (1+ offset)))
                        (js-call steps :push child)
                        (let ((wrapper (js-object :kind "sequence" :type (get child :type) :children steps :value nil)))
                          (when (Object/hasOwn child "span") (put wrapper :span (get child :span)))
                          (put children position wrapper)))))
                  (setq position (1+ position)))
                (put function :locals compacted)) function))))))
  (defun managed-pattern-names (node output)
    (unless (and node (= (value-type node) "object") (Array/isArray (get node :children nil)))
      (managed-fail node "invalid managed binding pattern"))
    (let ((kind (get node :kind)) (children (get node :children)) (properties (get node :properties (js-object))))
      (cond
        ((= kind "binding-name")
          (unless (and (= (value-type (get node :value)) "string") (> (js-length (get node :value)) 0)
                       (= (js-length children) 0)) (managed-fail node "invalid managed binding name"))
          (js-call output :push node))
        ((= kind "binding-hole")
          (unless (= (js-length children) 0) (managed-fail node "invalid managed binding hole")))
        ((= kind "array-binding-pattern")
          (when (and (get properties :rest nil) (= (js-length children) 0))
            (managed-fail node "invalid managed rest binding"))
          (js-call children :forEach (lambda (child) (managed-pattern-names child output))))
        ((= kind "map-binding-pattern")
          (let ((count (get properties :entryCount)) (as (get properties :as nil)) (index 0))
            (unless (and (= (value-type count) "number") (= count (uint32 count))
                         (= (js-length children) (+ count (if as 1 0))))
              (managed-fail node "invalid managed map binding entries"))
            (while (< index count)
              (let* ((entry (js-nth index children)) (parts (and entry (get entry :children nil))))
                (unless (and entry (= (get entry :kind) "map-binding-entry") (Array/isArray parts)
                  (= (js-length parts) (if (get (get entry :properties (js-object)) :default nil) 3 2))
                  (js-nth 1 parts) (= (value-type (get (js-nth 1 parts) :kind)) "string")
                  (or (= (js-length parts) 2) (and (js-nth 2 parts) (= (value-type (get (js-nth 2 parts) :kind)) "string"))))
                  (managed-fail (or entry node) "invalid managed map binding entry"))
                (managed-pattern-names (js-nth 0 parts) output))
              (setq index (1+ index)))
            (when as
              (unless (= (get (js-nth count children) :kind) "binding-name")
                (managed-fail node "invalid managed map alias"))
              (managed-pattern-names (js-nth count children) output))))
        (t (managed-fail node "invalid managed binding pattern")))) output)
  (defun managed-binding-target (binding)
    (if (get (get binding :properties (js-object)) :pattern nil) (js-nth 0 (get binding :children))
      (js-object :kind "binding-name" :value (get binding :value) :children (js-array)
        :properties nil :span (get binding :span nil))))
  (defun managed-function-patterns-p (node)
