(module eliscript.backend.managed
  (import "./numeric.mjs" backend-fail find-function)
  (import "./memory.mjs" lower-memory-program)
  (import "./wasm.mjs" emit-typed-memory-wasm append-metadata-section)

  ;; Ordinary control-flow values use the managed heap. This explicit
  ;; experimental profile does not admit unimplemented language operations.
  (defun managed-fail (node message)
    (try (backend-fail node message)
      (catch error (put (get error :eliscriptDiagnostic) :phase "managed-backend") (throw error))))
  (defun word-node (kind children value)
    (js-object :kind kind :type "u32" :children children :value value))
  (defun word-constant (value) (word-node "literal" (js-array) value))
  (defun word-local (entry) (word-node "local" (js-array) (get entry :index)))
  (defun word-set (entry value) (word-node "set" (js-array value) (get entry :index)))
  (defun word-sequence (children)
    (let ((result (js-call children :slice)))
      (js-call result :push (word-constant 0)) (word-node "sequence" result nil)))
  (defun word-compare (left right operator)
    (js-object :kind "word-compare" :type "i32" :children (js-array left right) :value operator))
  (defun word-if (condition yes no) (word-node "if" (js-array condition yes no) nil))
  (defun append-managed (output values)
    (let ((index 0))
      (while (< index (js-length values)) (js-call output :push (js-nth index values)) (setq index (1+ index)))) output)
  (defun collect-managed-declarations (nodes output)
    (let ((index 0))
      (while (< index (js-length nodes))
        (let ((node (js-nth index nodes)))
          (if (= (get node :kind) "module-declaration") (collect-managed-declarations (get node :children) output)
            (js-call output :push node))) (setq index (1+ index)))) output)
  (defun find-local (scope name)
    (let ((index (1- (js-length scope))) (found nil))
      (while (and (>= index 0) (not found))
        (when (= (get (js-nth index scope) :name) name) (setq found (js-nth index scope)))
        (setq index (1- index))) found))
  (defun new-managed-local (state name rooted)
    (let* ((locals (get state :locals))
           (entry (js-object :name name :type "u32" :index (js-length locals))))
      (when rooted (put entry :rootIndex (get state :roots)) (put state :roots (1+ (get state :roots))))
      (js-call locals :push entry) entry))
  (defun runtime-call (state name arguments)
    (let ((function (find-function (get state :runtime) name)))
      (unless function (managed-fail nil (str "managed runtime lacks " name)))
      (word-node "call" arguments (get function :index))))
  (defun runtime-arguments (state values)
    (let ((arguments (js-array (word-local (get state :heap)))))
      (append-managed arguments values)))
  (defun capture-error (state)
    (word-set (get state :error) (runtime-call state "last-error" (js-array))))
  (defun managed-guard (state expression)
    (word-if (word-compare (word-local (get state :error)) (word-constant 0) "=") expression (word-constant 0)))
  (defun checked-control (state name arguments)
    (managed-guard state (word-sequence (js-array
      (runtime-call state name arguments) (capture-error state)))))
  (defun root-local (state local)
    (checked-control state "frame-set" (runtime-arguments state
      (js-array (word-local (get state :frame)) (word-constant (get local :rootIndex)) (word-local local)))))
  (defun managed-result (state expression allocating)
    (let* ((local (new-managed-local state "temporary" t))
           (steps (js-array (managed-guard state (word-set local expression)))))
      (when allocating (js-call steps :push (managed-guard state (capture-error state))))
      (js-call steps :push (root-local state local))
      (js-object :steps (word-sequence steps) :result (word-local local))))
  (defun value-truth-call (state expression)
    ;; A raw u32 is a Number in scalar IR and therefore truthy. Mark the
    ;; runtime's 0/1 truth result as an i32 predicate before branching.
    (word-compare (runtime-call state "value-truth" (runtime-arguments state (js-array expression))) (word-constant 0) "/="))
  (defun lower-managed-sequence (nodes scope state functions)
    (let ((steps (js-array)) (result (word-constant 0)) (index 0))
      (while (< index (js-length nodes))
        (let ((lowered (lower-managed-expression (js-nth index nodes) scope state functions)))
          (js-call steps :push (get lowered :steps)) (setq result (get lowered :result)))
        (setq index (1+ index)))
      (js-object :steps (word-sequence steps) :result result)))
  (defun lower-managed-literal (node state)
    (let* ((value (get node :value)) (properties (get node :properties nil)) (type (value-type value)))
      (if properties
        (if (= (get properties :literalKind nil) "undefined") (managed-result state (word-constant 3) nil)
          (managed-fail node "managed control does not implement tagged persistent literals"))
        (cond
          ((nil? value) (managed-result state (word-constant 0) nil))
          ((= type "boolean") (managed-result state (word-constant (if value 2 1)) nil))
          ((= type "number")
           (let ((words (number-float64-words value)))
             (when (and (= value 0) (< (/ 1 value) 0)) (put words 1 2147483648))
             (managed-result state (runtime-call state "value-number" (runtime-arguments state
               (js-array (word-constant (js-nth 0 words)) (word-constant (js-nth 1 words))))) t)))
          ((= type "string")
           (let* ((result (managed-result state (runtime-call state "value-string" (runtime-arguments state
                            (js-array (word-constant (js-length value))))) t))
                  (steps (js-array (get result :steps))) (index 0))
             (while (< index (js-length value))
               (js-call steps :push (checked-control state "value-unit-set" (runtime-arguments state
                 (js-array (get result :result) (word-constant index) (word-constant (string-code-unit-at value index))))))
               (setq index (1+ index)))
             (js-call steps :push (checked-control state "value-seal" (runtime-arguments state (js-array (get result :result)))))
             (put result :steps (word-sequence steps)) result))
          (t (managed-fail node "managed control literal is unsupported"))))))
  (defun lower-managed-bindings (node scope state functions)
    (let* ((children (get node :children)) (properties (get node :properties))
           (count (get properties :bindingCount)) (inner (js-call scope :slice))
           (pending (js-array)) (steps (js-array)) (index 0))
      (while (< index count)
        (let* ((binding (js-nth index children))
               (value (lower-managed-expression (js-nth 0 (get binding :children))
                        (if (get properties :sequential) inner scope) state functions))
               (local (new-managed-local state (get binding :value) t)))
          (unless (and (= (get binding :kind) "lexical-binding") (= (js-length (get binding :children)) 1))
            (managed-fail binding "managed control requires initialized bindings"))
          (js-call steps :push (get value :steps) (managed-guard state (word-set local (get value :result))) (root-local state local))
          (js-call pending :push local) (when (get properties :sequential) (js-call inner :push local)))
        (setq index (1+ index)))
      (unless (get properties :sequential) (append-managed inner pending))
      (let ((body (lower-managed-sequence (js-call children :slice count) inner state functions)))
        (js-call steps :push (get body :steps)) (js-object :steps (word-sequence steps) :result (get body :result)))))
  (defun lower-managed-conditional (condition yes no scope state functions)
    (let* ((test (lower-managed-expression condition scope state functions))
           (left (lower-managed-expression yes scope state functions))
           (right (lower-managed-expression no scope state functions))
           (local (new-managed-local state "conditional" t)))
      (js-object :steps (word-sequence (js-array (get test :steps)
        (managed-guard state (word-if (value-truth-call state (get test :result))
          (word-sequence (js-array (get left :steps) (managed-guard state (word-set local (get left :result)))))
          (word-sequence (js-array (get right :steps) (managed-guard state (word-set local (get right :result)))))))
        (root-local state local))) :result (word-local local))))
  (defun lower-managed-chain (clauses index scope state functions)
    (if (= index (js-length clauses)) (js-object :steps (word-constant 0) :result (word-constant 0))
      (let* ((clause (js-nth index clauses)) (children (get clause :children)))
        (when (= (js-length children) 0) (managed-fail clause "managed cond clause requires a test"))
        (let* ((test (lower-managed-expression (js-nth 0 children) scope state functions))
               (yes (if (= (js-length children) 1) (js-object :steps (word-constant 0) :result (get test :result))
                      (lower-managed-sequence (js-call children :slice 1) scope state functions)))
               (no (lower-managed-chain clauses (1+ index) scope state functions))
               (local (new-managed-local state "cond" t)))
          (js-object :steps (word-sequence (js-array (get test :steps)
            (managed-guard state (word-if (value-truth-call state (get test :result))
              (word-sequence (js-array (get yes :steps) (managed-guard state (word-set local (get yes :result)))))
              (word-sequence (js-array (get no :steps) (managed-guard state (word-set local (get no :result)))))))
            (root-local state local))) :result (word-local local))))))
  (defun lower-managed-short (node scope state functions)
    (let* ((children (get node :children)) (operator (get node :value))
           (local (new-managed-local state "short-circuit" t)) (index 0) (steps (js-array)))
      (js-call steps :push (managed-guard state (word-set local (word-constant (if (= operator "and") 2 0)))))
      (while (< index (js-length children))
        (let* ((operand (lower-managed-expression (js-nth index children) scope state functions))
               (evaluate (word-sequence (js-array (get operand :steps)
                           (managed-guard state (word-set local (get operand :result))) (root-local state local)))))
          (js-call steps :push
            (if (= index 0) evaluate
              (managed-guard state (word-if (value-truth-call state (word-local local))
                (if (= operator "and") evaluate (word-constant 0))
                (if (= operator "or") evaluate (word-constant 0)))))))
        (setq index (1+ index)))
      (js-object :steps (word-sequence steps) :result (word-local local))))
  (defun snapshot-managed (lowered state)
    (let ((snapshot (managed-result state (get lowered :result) nil)))
      (put snapshot :steps (word-sequence (js-array (get lowered :steps) (get snapshot :steps)))) snapshot))
  (defun managed-number-constant (value state)
    (lower-managed-literal (js-object :kind "literal" :value value :children (js-array)) state))
  (defun managed-number-binary (left right operation state)
    (managed-result state (runtime-call state "value-primitive-binary"
      (runtime-arguments state (js-array left right (word-constant operation)))) t))
  (defun lower-managed-arithmetic (node scope state functions)
    (let* ((children (get node :children)) (operator (get node :value)) (count (js-length children))
           (steps (js-array)) (result nil) (index 1)
           (operation (cond ((or (= operator "+") (= operator "1+")) 0)
                            ((or (= operator "-") (= operator "1-")) 1)
                            ((= operator "*") 2) ((or (= operator "%") (= operator "mod")) 4) (t 3))))
      (when (or (and (= count 0) (not (or (= operator "+") (= operator "*"))))
                (and (or (= operator "1+") (= operator "1-")) (/= count 1)))
        (managed-fail node "invalid managed arithmetic arity"))
      (when (and (= operation 4) (< count 2)) (managed-fail node "managed remainder requires at least two operands"))
      (if (= count 0) (managed-number-constant (if (= operator "*") 1 0) state)
        (progn
          (setq result (snapshot-managed (lower-managed-expression (js-nth 0 children) scope state functions) state))
          (js-call steps :push (get result :steps))
          ;; Compute each left-associated result before evaluating the next operand.
          ;; A runtime failure therefore suppresses every later operand effect.
          (while (< index count)
            (let* ((right (snapshot-managed (lower-managed-expression (js-nth index children) scope state functions) state))
                   (combined (managed-number-binary (get result :result) (get right :result) operation state)))
              (js-call steps :push (get right :steps) (get combined :steps)) (setq result combined))
            (setq index (1+ index)))
          (when (and (= count 1) (or (= operator "-") (= operator "/") (= operator "1+") (= operator "1-")))
            (if (= operator "-")
              (setq result (managed-result state (runtime-call state "value-primitive-negate" (runtime-arguments state
                (js-array (get result :result)))) t))
              (let ((one (managed-number-constant 1 state)))
                (js-call steps :push (get one :steps))
                (setq result (managed-number-binary
                  (if (= operator "/") (get one :result) (get result :result))
                  (if (= operator "/") (get result :result) (get one :result)) operation state))))
            (js-call steps :push (get result :steps)))
          (js-object :steps (word-sequence steps) :result (get result :result))))))
  (defun lower-managed-word (node scope state functions)
    (let* ((children (get node :children)) (operator (get node :value))
           (unary (or (= operator "int32") (= operator "uint32") (= operator "bit-not")))
           (steps (js-array)) (operands (js-array)) (index 0)
           (operation (if unary (cond ((= operator "int32") 0) ((= operator "uint32") 1) (t 2))
             (cond ((= operator "bit-and") 0) ((= operator "bit-or") 1) ((= operator "bit-xor") 2)
                   ((= operator "bit-shift-left") 3) ((= operator "bit-shift-right") 4)
                   ((= operator "unsigned-bit-shift-right") 5) (t 6)))))
      (unless (= (js-length children) (if unary 1 2)) (managed-fail node "invalid managed word operator arity"))
      (while (< index (js-length children))
        (let ((operand (snapshot-managed (lower-managed-expression (js-nth index children) scope state functions) state)))
          (js-call steps :push (get operand :steps)) (js-call operands :push (get operand :result)))
        (setq index (1+ index)))
      (js-call operands :push (word-constant operation))
      (let ((result (managed-result state (runtime-call state (if unary "value-primitive-word" "value-primitive-bitwise")
                      (runtime-arguments state operands)) t)))
        (js-call steps :push (get result :steps)) (put result :steps (word-sequence steps)) result)))
  (defun lower-managed-comparison (node scope state functions)
    (let* ((children (get node :children)) (operator (get node :value)) (count (js-length children))
           (operands (js-array)) (steps (js-array)) (index 0) (left 0)
           (distinct (or (= operator "/=") (= operator "not=")))
           (operation (cond ((or (= operator "=") (= operator "eq")) 0) (distinct 1) ((= operator "<") 2)
                           ((= operator "<=") 3) ((= operator ">") 4) (t 5)))
           (local (new-managed-local state "comparison" t)))
      (when (< count 2) (managed-fail node "managed comparisons require at least two operands"))
      (when (and (= operator "eq") (/= count 2)) (managed-fail node "managed eq requires two operands"))
      ;; The JS comparison IIFE captures all arguments once before pair tests.
      (while (< index count)
        (let ((operand (snapshot-managed (lower-managed-expression (js-nth index children) scope state functions) state)))
          (js-call operands :push (get operand :result)) (js-call steps :push (get operand :steps)))
        (setq index (1+ index)))
      (js-call steps :push (managed-guard state (word-set local (word-constant 2))))
      (while (< left (1- count))
        (let ((right (1+ left)))
          (while (< right count)
            (let* ((compared (new-managed-local state "comparison-word" nil))
                   (evaluate (word-sequence (js-array
                     (managed-guard state (word-set compared (runtime-call state "value-primitive-compare" (runtime-arguments state
                       (js-array (js-nth left operands) (js-nth right operands) (word-constant operation))))))
                     (managed-guard state (capture-error state))
                     (managed-guard state (word-set local (word-if
                       (word-compare (word-local compared) (word-constant 0) "/=") (word-constant 2) (word-constant 1))))))))
              (js-call steps :push (managed-guard state (word-if
                (word-compare (word-local local) (word-constant 2) "=") evaluate (word-constant 0)))))
            (setq right (if distinct (1+ right) count))))
        (setq left (1+ left)))
      (js-call steps :push (root-local state local))
      (js-object :steps (word-sequence steps) :result (word-local local))))
  (defun lower-managed-key (node scope state functions)
    ;; Property contexts interpret literal keywords as strings, as the JS emitter
    ;; does. This does not enable ordinary persistent keyword literals.
    (if (and (= (get node :kind) "literal") (get node :properties nil) (= (get (get node :properties) :literalKind nil) "keyword"))
      (lower-managed-literal (js-object :kind "literal" :value (get node :value) :children (js-array)) state)
      (lower-managed-expression node scope state functions)))
  (defun lower-managed-array (node scope state functions)
    (let ((children (get node :children)) (steps (js-array)) (values (js-array)) (i 0))
      (while (< i (js-length children))
        (let ((value (snapshot-managed (lower-managed-expression (js-nth i children) scope state functions) state)))
          (js-call steps :push (get value :steps)) (js-call values :push (get value :result))) (setq i (1+ i)))
      (let ((result (managed-result state (runtime-call state "value-array-new" (runtime-arguments state
                      (js-array (word-constant (js-length children))))) t)))
        (js-call steps :push (get result :steps)) (setq i 0)
        (while (< i (js-length values))
          (js-call steps :push (checked-control state "value-set" (runtime-arguments state
            (js-array (get result :result) (word-constant i) (js-nth i values))))) (setq i (1+ i)))
        (put result :steps (word-sequence steps)) result)))
  (defun lower-managed-object (node scope state functions)
    (let* ((properties (get node :children))
           (result (managed-result state (runtime-call state "value-object-new" (runtime-arguments state (js-array (word-constant 3)))) t))
           (steps (js-array (get result :steps))) (i 0) (prototype-seen nil))
      ;; Validate property shapes before lowering any child or reading its IR.
      (while (< i (js-length properties))
        (let ((property (js-nth i properties)))
          (unless (and (= (get property :kind) "object-property") (get property :children)
                       (= (js-length (get property :children)) (if (get (get property :properties) :computed) 2 1)))
            (managed-fail property "invalid managed object property"))) (setq i (1+ i)))
      (setq i 0)
      (while (< i (js-length properties))
        (let* ((property (js-nth i properties)) (children (get property :children))
               (computed (get (get property :properties) :computed))
               (prototype (and (not computed) (= (get property :value) "__proto__")))
               (key (snapshot-managed (if computed
                      (lower-managed-expression (js-nth 0 children) scope state functions)
                      (lower-managed-literal (js-object :kind "literal" :value (get property :value) :children (js-array)) state)) state))
               (value (snapshot-managed (lower-managed-expression (js-nth (if computed 1 0) children) scope state functions) state)))
          (when prototype
            (when prototype-seen (managed-fail property "duplicate object prototype setter")) (setq prototype-seen t))
          (js-call steps :push (get key :steps)
            (checked-control state "value-property-key-check" (runtime-arguments state (js-array (get result :result) (get key :result))))
            (get value :steps) (checked-control state "value-object-put" (runtime-arguments state
              (js-array (get result :result) (get key :result) (get value :result) (word-constant (if prototype 1 2)))))))
        (setq i (1+ i))) (put result :steps (word-sequence steps)) result))
  (defun lower-managed-object-operation (node scope state functions)
    (let* ((children (get node :children)) (operation (get node :value)) (count (js-length children))
           (assoc (= operation "object-assoc")) (keys (= operation "object-keys")))
      (unless (= count (if assoc 3 (if keys 1 2))) (managed-fail node "invalid managed object operator arity"))
      (let* ((receiver (snapshot-managed (lower-managed-expression (js-nth 0 children) scope state functions) state))
             (steps (js-array (get receiver :steps))))
        (if keys
          (let ((result (managed-result state (runtime-call state "value-object-keys" (runtime-arguments state (js-array (get receiver :result)))) t)))
            (js-call steps :push (get result :steps)) (put result :steps (word-sequence steps)) result)
          (let* ((copy (and assoc (managed-result state (runtime-call state "value-object-copy" (runtime-arguments state (js-array (get receiver :result)))) t)))
                 (key (snapshot-managed (lower-managed-key (js-nth 1 children) scope state functions) state)))
            ;; Object spread is evaluated before the computed key and RHS.
            (when assoc (js-call steps :push (get copy :steps))) (js-call steps :push (get key :steps))
            (if assoc
              (let ((value (snapshot-managed (lower-managed-expression (js-nth 2 children) scope state functions) state)))
                (js-call steps :push (checked-control state "value-property-key-check" (runtime-arguments state
                  (js-array (get copy :result) (get key :result)))) (get value :steps)
                  (checked-control state "value-object-put" (runtime-arguments state
                    (js-array (get copy :result) (get key :result) (get value :result) (word-constant 2)))))
                (put copy :steps (word-sequence steps)) copy)
              (let ((result (managed-result state (word-if
                              (word-compare (runtime-call state "value-object-has" (runtime-arguments state
                                (js-array (get receiver :result) (get key :result)))) (word-constant 0) "/=")
                              (word-constant 2) (word-constant 1)) t)))
                (js-call steps :push (get result :steps)) (put result :steps (word-sequence steps)) result)))))))
  (defun lower-managed-access (node scope state functions)
    (let* ((children (get node :children)) (kind (get node :kind))
           (nth (and (= kind "intrinsic") (= (get node :value) "js-nth")))
           (write (= kind "property-write")) (count (js-length children)))
      (unless (if write (= count 3) (if (= kind "property-read") (or (= count 2) (= count 3)) (= count 2)))
        (managed-fail node "invalid managed array access arity"))
      (let* ((receiver (snapshot-managed (lower-managed-expression (js-nth (if nth 1 0) children) scope state functions) state))
             (key (snapshot-managed (if nth (lower-managed-expression (js-nth 0 children) scope state functions)
                                     (lower-managed-key (js-nth 1 children) scope state functions)) state))
             (steps (js-array (get receiver :steps) (get key :steps))))
        (if write
          (let ((value (snapshot-managed (lower-managed-expression (js-nth 2 children) scope state functions) state)))
            ;; Capture the assignment reference before evaluating the RHS.
            (js-call steps :push (checked-control state "value-property-key-check" (runtime-arguments state
              (js-array (get receiver :result) (get key :result)))) (get value :steps)
              (checked-control state "value-property-put" (runtime-arguments state
                (js-array (get receiver :result) (get key :result) (get value :result)))))
            (js-object :steps (word-sequence steps) :result (get value :result)))
          (let ((result (managed-result state (runtime-call state "value-property-get" (runtime-arguments state
                         (js-array (get receiver :result) (get key :result) (word-constant (if nth 1 0))))) t)))
            (js-call steps :push (get result :steps))
            (when (= count 3)
              (let* ((fallback (lower-managed-expression (js-nth 2 children) scope state functions))
                     (local (new-managed-local state "default" t)))
                (js-call steps :push (managed-guard state (word-if
                  (js-object :kind "or" :type "i32" :value "or" :children
                    (js-array (word-compare (get result :result) (word-constant 0) "=")
                              (word-compare (get result :result) (word-constant 3) "=")))
                  (word-sequence (js-array (get fallback :steps) (managed-guard state (word-set local (get fallback :result)))))
                  (managed-guard state (word-set local (get result :result))))) (root-local state local))
                (put result :result (word-local local))))
            (put result :steps (word-sequence steps)) result)))))
  (defun lower-managed-array-method (node scope state functions)
    (let* ((children (get node :children)) (count (js-length children)) (key (js-nth 1 children))
           (method (and key (= (get key :kind) "literal") (get key :value))))
      (unless (and (>= count 2) (or (= method "push") (= method "pop") (= method "slice")))
        (managed-fail node "managed arrays require a supported static method"))
      (let* ((receiver (snapshot-managed (lower-managed-expression (js-nth 0 children) scope state functions) state))
             (available (new-managed-local state "array-method" nil))
             (steps (js-array (get receiver :steps) (managed-guard state (word-set available
               (runtime-call state "value-array-method-check" (runtime-arguments state
                 (js-array (get receiver :result) (word-constant (if (= method "push") 0 (if (= method "pop") 1 2))))))))
               (managed-guard state (capture-error state)))) (arguments (js-array)) (i 2))
        (while (< i count)
          (let ((argument (snapshot-managed (lower-managed-expression (js-nth i children) scope state functions) state)))
            (js-call steps :push (get argument :steps)) (js-call arguments :push (get argument :result))) (setq i (1+ i)))
        ;; Lookup precedes argument evaluation; noncallable data fails afterward.
        ;; Keep the captured result when an argument replaces the method itself.
        (js-call steps :push (managed-guard state (word-if
          (word-compare (word-local available) (word-constant 0) "=")
          (word-sequence (js-array (runtime-call state "fail" (js-array (word-constant 3))) (capture-error state))) (word-constant 0))))
        (if (= method "slice")
          (let ((result (managed-result state (runtime-call state "value-source-slice" (runtime-arguments state
                          (js-array (get receiver :result) (if (> count 2) (js-nth 0 arguments) (word-constant 3))
                            (if (> count 3) (js-nth 1 arguments) (word-constant 3))))) t)))
            (js-call steps :push (get result :steps)) (put result :steps (word-sequence steps)) result)
          (let ((length (new-managed-local state "array-length" nil)) (next (new-managed-local state "array-next-length" nil)))
            (js-call steps :push (managed-guard state (word-set length (runtime-call state "value-length" (runtime-arguments state
              (js-array (get receiver :result)))))) (managed-guard state (capture-error state)))
            (if (= method "push")
              (let ((result (managed-result state (runtime-call state "heap-number-from-word" (runtime-arguments state
                             (js-array (word-local next) (word-constant 0)))) t)))
                (js-call steps :push (managed-guard state (word-set next (word-node "word-arithmetic"
                  (js-array (word-local length) (word-constant (js-length arguments))) "+")))
                  (managed-guard state (word-if (word-compare (word-local next) (word-local length) "<")
                    (word-sequence (js-array (runtime-call state "fail" (js-array (word-constant 2))) (capture-error state))) (word-constant 0)))
                  ;; Allocate and root the return value before any visible mutation.
                  (get result :steps) (checked-control state "value-array-resize" (runtime-arguments state
                    (js-array (get receiver :result) (word-local next))))) (setq i 0)
                (while (< i (js-length arguments))
                  (js-call steps :push (checked-control state "value-set" (runtime-arguments state
                    (js-array (get receiver :result) (word-node "word-arithmetic" (js-array (word-local length) (word-constant i)) "+")
                      (js-nth i arguments))))) (setq i (1+ i)))
                (put result :steps (word-sequence steps)) result)
              (let ((result (managed-result state (word-if (word-compare (word-local length) (word-constant 0) "=")
                              (word-constant 3) (runtime-call state "value-get" (runtime-arguments state
                                (js-array (get receiver :result) (word-node "word-arithmetic" (js-array (word-local length) (word-constant 1)) "-"))))) t)))
                (js-call steps :push (get result :steps)
                  (checked-control state "value-array-resize" (runtime-arguments state
                    (js-array (get receiver :result) (word-if (word-compare (word-local length) (word-constant 0) "=")
                      (word-constant 0) (word-node "word-arithmetic" (js-array (word-local length) (word-constant 1)) "-"))))))
