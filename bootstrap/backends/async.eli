(module eliscript.backend.async
  (import "../bootstrap/symbol.mjs" binding-name)
  ;; This pass produces ordinary closures. Suspension is represented solely by
  ;; runtime reactions; tail records trampoline synchronous continuation calls.
  (defun async-node (kind value children &optional properties)
    (js-object :kind kind :value value :children children :properties properties :span nil))
  (defun async-intrinsic (name children) (async-node "intrinsic" name children))
  (defun async-reference (name) (async-node "reference" name (js-array)))
  (defun async-literal (value) (async-node "literal" value (js-array)))
  (defun async-fresh (state)
    (let ((name (str (get state :prefix) (get state :next))))
      (put state :next (1+ (get state :next))) name))
  (defun async-lambda (name body)
    (async-node "function-expression" nil
      (js-array (async-node "parameter-binding" name (js-array) (js-object :parameterKind "required")) body)
      (js-object :parameterCount 1 :async false)))
  (defun async-call (function value)
    (async-intrinsic "managed-async-tail" (js-array function value)))
  (defun async-bind (name value body)
    (async-node "lexical-bindings" nil
      (js-array (async-node "lexical-binding" name (js-array value)) body)
      (js-object :bindingCount 1 :sequential t)))
  (defun async-await-p (node)
    (let ((found false))
      (when node
        (if (= (get node :kind) "await-expression") (setq found t)
          (unless (or (= (get node :kind) "function-expression") (= (get node :kind) "function-declaration"))
            (js-call (get node :children) :forEach (lambda (child) (when (async-await-p child) (setq found t))))))) found))
  (defun async-guard (expression reject state)
    (let ((error (async-fresh state)))
      (async-node "try-expression" nil
        (js-array expression (async-node "catch-clause" nil
          (js-array (async-node "catch-binding" error (js-array)) (async-call reject (async-reference error)))))
        (js-object :bodyCount 1))))
  (defun async-copy (node children)
    (js-call globalThis.Object :assign (js-object) node (js-object :children children :managedAsyncOriginal (or (get node :managedAsyncOriginal nil) node))))
  (defun async-children (nodes index values done reject state)
    (if (= index (js-length nodes)) (done values)
      (let ((node (js-nth index nodes)))
        (if (or (= (get node :kind) "object-property") (= (get node :kind) "assignment-pair"))
          (async-children (get node :children) 0 (js-array)
            (lambda (parts)
              (let ((next (js-call values :slice)))
                (js-call next :push (async-copy node parts))
                (async-children nodes (1+ index) next done reject state))) reject state)
          (let ((name (async-fresh state)))
            (async-cps node
              (async-lambda name
                (let ((next (js-call values :slice)))
                  (js-call next :push (async-reference name))
                  (async-children nodes (1+ index) next done reject state))) reject state))))))
  (defun async-sequence (nodes index next reject state)
    (if (= index (js-length nodes)) (async-call next (async-literal nil))
      (if (= (1+ index) (js-length nodes)) (async-cps (js-nth index nodes) next reject state)
        (async-cps (js-nth index nodes)
          (async-lambda (async-fresh state) (async-sequence nodes (1+ index) next reject state)) reject state))))
  (defun async-short (node index next reject state)
    (let ((nodes (get node :children)) (operator (get node :value)))
      (if (= index (js-length nodes)) (async-call next (async-literal (= operator "and")))
        (if (= (1+ index) (js-length nodes)) (async-cps (js-nth index nodes) next reject state)
          (let ((name (async-fresh state)))
            (async-cps (js-nth index nodes)
              (async-lambda name
                (let ((tail (async-short node (1+ index) next reject state))
                      (stop (async-call next (async-reference name))))
                  (async-node "conditional" nil
                    (if (= operator "and") (js-array (async-reference name) tail stop)
                      (js-array (async-reference name) stop tail))))) reject state))))))
  (defun async-chain (clauses index next reject state)
    (if (= index (js-length clauses)) (async-call next (async-literal nil))
      (let* ((nodes (get (js-nth index clauses) :children)) (name (async-fresh state)))
        (async-cps (js-nth 0 nodes)
          (async-lambda name (async-node "conditional" nil
            (js-array (async-reference name)
              (if (= (js-length nodes) 1) (async-call next (async-reference name))
                (async-sequence (js-call nodes :slice 1) 0 next reject state))
              (async-chain clauses (1+ index) next reject state)))) reject state))))
  (defun async-bindings (node next reject state)
    (let* ((nodes (get node :children)) (count (get (get node :properties) :bindingCount))
           (sequential (get (get node :properties) :sequential)) (bindings (js-call nodes :slice 0 count))
           (body (js-call nodes :slice count)))
      (if sequential
        (async-bind-sequential bindings 0 body next reject state)
        (let ((initializers (js-call bindings :map (lambda (binding)
                  (if (= (js-length (get binding :children)) 0) (async-literal nil) (js-nth 0 (get binding :children)))))))
          (async-children initializers 0 (js-array)
            (lambda (values)
              (let ((output (js-call bindings :map (lambda (binding index) (async-copy binding (js-array (js-nth index values)))))))
                (js-call output :push (async-sequence body 0 next reject state))
                (async-copy node output))) reject state)))))
  (defun async-bind-sequential (bindings index body next reject state)
    (if (= index (js-length bindings)) (async-sequence body 0 next reject state)
      (let* ((binding (js-nth index bindings)) (temporary (async-fresh state))
             (initializer (if (= (js-length (get binding :children)) 0) (async-literal nil) (js-nth 0 (get binding :children)))))
        (async-cps initializer
          (async-lambda temporary
            (async-node "lexical-bindings" nil
              (js-array (async-copy binding (js-array (async-reference temporary)))
                (async-bind-sequential bindings (1+ index) body next reject state))
              (js-object :bindingCount 1 :sequential t))) reject state))))
  (defun async-try (node next reject state)
    (let* ((nodes (get node :children)) (count (get (get node :properties) :bodyCount))
           (handler nil) (finalizer nil) (normal next) (abrupt reject))
      (js-call (js-call nodes :slice count) :forEach (lambda (clause)
        (if (= (get clause :kind) "catch-clause") (setq handler clause) (setq finalizer clause))))
      (when finalizer
        (let ((value (async-fresh state)) (error (async-fresh state)))
          (setq normal (async-lambda value
            (async-sequence (get finalizer :children) 0
              (async-lambda (async-fresh state) (async-call next (async-reference value))) reject state)))
          (setq abrupt (async-lambda error
            (async-sequence (get finalizer :children) 0
              (async-lambda (async-fresh state) (async-call reject (async-reference error))) reject state)))))
      (let ((catcher abrupt))
        (when handler
          (let ((error (async-fresh state)) (parts (get handler :children)))
            ;; Use the existing catch-binding lowering for TDZ, defaults,
            ;; destructuring and iterator closing rather than rebinding by hand.
            (setq catcher (async-lambda error
              (async-guard
                (async-node "try-expression" nil
                  (js-array (async-node "throw-expression" nil (js-array (async-reference error)))
                    (async-node "catch-clause" nil
                      (js-array (js-nth 0 parts)
                        (async-sequence (js-call parts :slice 1) 0 normal abrupt state))))
                  (js-object :bodyCount 1)) abrupt state)))))
        (async-sequence (js-call nodes :slice 0 count) 0 normal catcher state))))
  (defun async-while (node next reject state)
    (let* ((loop-name (async-fresh state)) (test-name (async-fresh state)) (ignored (async-fresh state))
           (nodes (get node :children))
           (again (async-lambda ignored (async-call (async-reference loop-name) (async-literal nil))))
           (step (async-lambda ignored
             (async-cps (js-nth 0 nodes)
               (async-lambda test-name (async-node "conditional" nil
                 (js-array (async-reference test-name)
                   (async-sequence (js-call nodes :slice 1) 0 again reject state)
                   (async-call next (async-literal nil))))) reject state))))
      (async-bind loop-name (async-literal nil)
        (async-node "sequence" nil
          (js-array (async-node "assignment" "setq"
            (js-array (async-node "assignment-pair" loop-name (js-array step))))
            (async-call (async-reference loop-name) (async-literal nil)))))))
  (defun async-assignment (node index next reject state)
    (let ((pairs (get node :children)))
      (if (= index (js-length pairs)) (async-call next (async-literal nil))
        (let* ((pair (js-nth index pairs)) (name (async-fresh state))
               (assignment (async-copy node (js-array (async-copy pair (js-array (async-reference name)))))))
          (async-cps (js-nth 0 (get pair :children))
            (async-lambda name
              (if (= (1+ index) (js-length pairs)) (async-guard (async-call next assignment) reject state)
                (async-guard (async-node "sequence" nil (js-array assignment (async-assignment node (1+ index) next reject state))) reject state))) reject state)))))
  (defun async-cps (node next reject state)
    (let ((kind (get node :kind)) (nodes (get node :children)))
      (cond
        ((not (async-await-p node)) (async-guard (async-call next (async-transform-node node state)) reject state))
        ((and (= kind "intrinsic") (= (get node :value) "host-identity-token"))
         (let ((capture (async-intrinsic "managed-host-identity-capture" (js-array))))
           (put capture :managedAsyncOriginal (or (get node :managedAsyncOriginal nil) node))
           (async-cps (async-intrinsic "managed-host-identity-apply" (js-array capture (js-nth 0 nodes))) next reject state)))
        ((= kind "await-expression")
         (let ((name (async-fresh state)))
           (async-cps (js-nth 0 nodes)
             (async-lambda name (async-guard (async-intrinsic "managed-promise-await"
               (js-array (async-reference name) next reject)) reject state)) reject state)))
        ((= kind "sequence") (async-sequence nodes 0 next reject state))
        ((= kind "lexical-bindings") (async-bindings node next reject state))
        ((= kind "try-expression") (async-try node next reject state))
        ((= kind "throw-expression") (async-cps (js-nth 0 nodes) reject reject state))
        ((= kind "short-circuit") (async-short node 0 next reject state))
        ((= kind "conditional-chain") (async-chain nodes 0 next reject state))
        ((= kind "conditional-sugar")
         (async-cps (async-node "conditional" nil
           (if (= (get node :value) "unless")
             (js-array (js-nth 0 nodes) (async-literal nil) (async-node "sequence" nil (js-call nodes :slice 1)))
             (js-array (js-nth 0 nodes) (async-node "sequence" nil (js-call nodes :slice 1)) (async-literal nil)))) next reject state))
        ((= kind "conditional")
         (let ((name (async-fresh state)))
           (async-cps (js-nth 0 nodes)
             (async-lambda name (async-node "conditional" nil
               (js-array (async-reference name) (async-cps (js-nth 1 nodes) next reject state)
                 (async-cps (js-nth 2 nodes) next reject state)))) reject state)))
        ((and (= kind "loop") (= (get node :value) "while")) (async-while node next reject state))
        ((= kind "assignment") (async-assignment node 0 next reject state))
        ((= kind "constructor-call")
         (async-children (js-call nodes :slice 1) 0 (js-array)
           (lambda (arguments)
             (async-guard (async-call next (async-copy node
               (js-call (js-array (js-nth 0 nodes)) :concat arguments))) reject state)) reject state))
        ((= kind "method-call")
         (async-cps (async-node "call" nil
           (js-call (js-array (async-intrinsic "managed-async-method-capture" (js-call nodes :slice 0 2)))
             :concat (js-call nodes :slice 2))) next reject state))
        (t
         (async-children nodes 0 (js-array)
           (lambda (values) (async-guard (async-call next (async-copy node values)) reject state)) reject state)))))
  (defun async-function (node state)
    (let* ((properties (get node :properties)) (count (get properties :parameterCount))
           (nodes (get node :children)) (promise (async-fresh state)) (result (async-fresh state)) (error (async-fresh state))
           (accept (async-lambda result (async-intrinsic "managed-promise-resolve" (js-array (async-reference promise) (async-reference result)))))
           (reject (async-lambda error (async-intrinsic "managed-promise-reject" (js-array (async-reference promise) (async-reference error)))))
           (start (async-lambda (async-fresh state) (async-guard (async-sequence (js-call nodes :slice count) 0 accept reject state) reject state)))
           (body (async-bind promise (async-intrinsic "managed-promise-new" (js-array))
             (async-node "sequence" nil
               (js-array (async-guard (async-intrinsic "managed-async-run" (js-array start (async-literal nil))) reject state)
                 (async-reference promise)))))
           (output (js-call nodes :slice 0 count)))
      (js-call output :push body)
      (js-call globalThis.Object :assign (js-object) node
        (js-object :children output :managedAsyncOriginal (or (get node :managedAsyncOriginal nil) node) :properties (js-call globalThis.Object :assign (js-object) properties (js-object :async false :managedAsync t))))))
  (defun async-transform-node (node state)
    (if (and (or (= (get node :kind) "function-expression") (= (get node :kind) "function-declaration"))
             (get (get node :properties) :async)) (async-function node state)
      (let* ((changed false)
             (children (js-call (get node :children) :map (lambda (child)
              (let ((copy (async-transform-node child state)))
                (unless (eq copy child) (setq changed t)) copy)))))
        (if changed (async-copy node children) node))))
  (defun lower-async-program (program)
    (let ((names (new globalThis.Set)) (pending (js-call (get program :body) :slice)) (prefix "eliscript_async_"))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :pop)))
          (when (= (value-type (get node :value)) "string")
            (let ((name (get node :value)))
              (js-call names :add (try (binding-name name) (catch error name)))))
          (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))
      (while (js-call (Array/from names) :some (lambda (name) (js-call name :startsWith prefix))) (setq prefix (str "_" prefix)))
      (let ((state (js-object :prefix prefix :next 0)))
        (js-call globalThis.Object :assign (js-object) program
          (js-object :body (js-call (get program :body) :map (lambda (node) (async-transform-node node state))))))))
  (export lower-async-program))
