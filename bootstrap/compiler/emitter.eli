(module bootstrap.compiler.emitter
  (import "./symbol.mjs" :as raw-symbol)
  (import "./ir.mjs"
    node-p
    program-filename
    program-body
    ir-kind
    ir-span
    ir-value
    ir-children
    ir-property)
  (import "./source-map.mjs" create-source-map)

  (defconst literal-runtime-import
    "import { hashMap as __eliscript_hash_map, hashSet as __eliscript_hash_set, keyword as __eliscript_keyword, list as __eliscript_list, queue as __eliscript_queue, symbol as __eliscript_symbol, vector as __eliscript_vector } from \"eliscript/runtime/literals.mjs\";\n")
  (defconst collection-runtime-import
    "import { count as __eliscript_count, nth as __eliscript_nth } from \"eliscript/runtime/core/collection.mjs\";\n")
  (defconst list-runtime-import
    "import { cons as __eliscript_cons, first as __eliscript_first, rest as __eliscript_rest } from \"eliscript/runtime/core/list.mjs\";\n")
  (defconst value-runtime-import
    "import { equalValues as __eliscript_equal } from \"eliscript/runtime/core/value.mjs\";\n")
  (defconst binding-runtime
    "import { bindingGet as __eliscript_binding_get } from \"eliscript/runtime/binding.mjs\";\nconst __eliscript_binding_missing = Symbol(\"eliscript.binding.missing\");\n")

  ;; Runtime algorithms are maintained Eli modules, imported by generated code.
  (defconst prelude-array-text-names (js-array "__eliscript_at" "__eliscript_at_direct"))
  (defconst prelude-number-conversion-names (js-array "__eliscript_to_number"))
  (defconst prelude-numeric-coercion-names
    (js-array "__eliscript_numeric_decrement" "__eliscript_numeric_relation"
      "__eliscript_numeric_sub" "__eliscript_numeric_mul" "__eliscript_numeric_div"
      "__eliscript_numeric_rem" "__eliscript_numeric_and" "__eliscript_numeric_or"
      "__eliscript_numeric_xor" "__eliscript_numeric_shl" "__eliscript_numeric_shr"
      "__eliscript_numeric_ushr" "__eliscript_numeric_neg" "__eliscript_numeric_int32"
      "__eliscript_numeric_uint32" "__eliscript_numeric_not"))
  (defconst prelude-imul-names (js-array "__eliscript_numeric_imul"))

  (defun prelude-import (array-text number-conversion numeric-coercion imul)
    (let ((names (js-call (js-array) :concat
                   (if array-text prelude-array-text-names (js-array))
                   (if number-conversion prelude-number-conversion-names (js-array))
                   (if numeric-coercion prelude-numeric-coercion-names (js-array))
                   (if imul prelude-imul-names (js-array)))))
      (if (= (js-length names) 0) ""
        (str "import { " (js-call names :join ", ") " } from \"eliscript/runtime/prelude.mjs\";\n"))))
  (defvar numeric-emission-profile false)
  (defconst primitive-runtime-import
    "import { stringToBigint as __eliscript_string_to_bigint, float64Words as __eliscript_number_float64_words, buildArray as __eliscript_array_build, arrayCopyAssoc as __eliscript_array_copy_assoc, unsupportedArity as __eliscript_arity_error } from \"eliscript/runtime/primitives.mjs\";\n")
  (defconst value-type-import
    "import { valueType as __eliscript_value_type } from \"eliscript/runtime/primitives.mjs\";\n")
  (defconst host-identity-token-helper
    "import { createHostIdentityToken as __eliscript_create_host_identity_token } from \"eliscript/runtime/primitives.mjs\";\nconst __eliscript_host_identity_token = __eliscript_create_host_identity_token();\n")
  (defconst fail
    (lambda (message)
      (throw (new globalThis.Error message))))
  (defvar function-source-profile false)
  (defconst emit-shared-bname-cache (new globalThis.Map))
  (defconst emit-shared-rname-cache (new globalThis.Map))
  (defvar emit-bname-cache nil)
  (defvar emit-rname-cache nil)
  (defconst binding-name
    (lambda (name)
      (let ((cache emit-bname-cache))
        (if (nil? cache)
            (js-call raw-symbol :binding_name name)
          (let ((cached (js-call cache :get name)))
            (if (not (eq cached undefined))
                cached
              (let ((computed (js-call raw-symbol :binding_name name)))
                (js-call cache :set name computed)
                computed)))))))
  (defconst reference-name
    (lambda (name)
      (let ((cache emit-rname-cache))
        (if (nil? cache)
            (js-call raw-symbol :reference_name name)
          (let ((cached (js-call cache :get name)))
            (if (not (eq cached undefined))
                cached
              (let ((computed (js-call raw-symbol :reference_name name)))
                (js-call cache :set name computed)
                computed)))))))
  (defconst emit-iterator-key globalThis.Symbol.iterator)
  (defconst emit-array-is-array Array/isArray)
  (defconst emit-get-prototype-of Object/getPrototypeOf)
  (defconst emit-array-prototype (get globalThis.Array :prototype))
  (defconst emit-default-array-iterator (aref emit-array-prototype emit-iterator-key))
  (defconst emit-array-iterator-prototype
    (funcall emit-get-prototype-of (Reflect/apply emit-default-array-iterator (js-array) (js-array))))
  (defconst emit-default-array-iterator-next (aref emit-array-iterator-prototype "next"))
  (defconst emit-is-concat-spreadable globalThis.Symbol.isConcatSpreadable)
  (defconst emit-default-array-slice (aref emit-array-prototype "slice"))
  (defconst emit-default-array-concat (aref emit-array-prototype "concat"))
  (defconst emit-string-prototype (get globalThis.String :prototype))
  (defconst emit-default-string-substring (aref emit-string-prototype "substring"))
  (defconst emit-default-string-index-of (aref emit-string-prototype "indexOf"))
  (defconst emit-default-string-char-code-at (aref emit-string-prototype "charCodeAt"))
  (defconst emit-array-from Array/from)
  (defconst emit-default-array-for-each (aref emit-array-prototype "forEach"))
  (defconst emit-species-key globalThis.Symbol.species)
  (defconst fast-locate-kernel
    (js* "/* @eliscript-js-host-fastpath */ (span, output) => { if (typeof output === 'string') { return (span == null || span === false || output.length === 0) ? { text: output, marks: [] } : { text: output, marks: [{ offset: 0, span }] }; } const marks = output.marks; const text1 = output.text; if (text1.length === 0 || span == null || span === false) return output; const mlen = marks.length; if (mlen > 0 && marks[0].offset === 0) return output; return { text: output.text, marks: [{ offset: 0, span }, ...marks] }; }"))
  (defconst empty-children (Object/freeze (js-array)))
  (defconst empty-fragment (Object/freeze (js-object :text "" :marks empty-children)))
  (defvar emit-mark-mode 0)
  (defconst emit-unpatched-string-p
    (let ((factory
            (js* "/* @eliscript-js-host-fastpath */ (strProto, defSlice, defSplit, defSub, defIndexOf) => () => strProto.slice === defSlice && strProto.split === defSplit && strProto.substring === defSub && strProto.indexOf === defIndexOf")))
      (if (nil? factory)
          (lambda () false)
        (funcall factory
          emit-string-prototype (aref emit-string-prototype "slice") (aref emit-string-prototype "split") emit-default-string-substring emit-default-string-index-of))))
  (defconst lazy-locate-kernel
    (js* "/* @eliscript-js-host-fastpath */ (mode, span, output) => { if (mode === 2) return typeof output === 'string' ? { text: output, m: null } : output; if (typeof output === 'string') return (span == null || span === false || output.length === 0) ? { text: output, m: null } : { text: output, m: { k: 1, span, child: null, h0: true } }; if (output.text.length === 0 || span == null || span === false) return output; const m = output.m; if (m !== null && m.h0) return output; return { text: output.text, m: { k: 1, span, child: m, h0: true } }; }"))
  (defconst materialize-lazy-marks
    (js* "/* @eliscript-js-host-fastpath */ (rootM) => { if (rootM === null) return []; const out = []; const walk = (node, baseOff) => { const k = node.k; if (k === 1) { out.push({ offset: baseOff, span: node.span }); if (node.child !== null) walk(node.child, baseOff); } else if (k === 2) { walk(node.child, (baseOff + node.off) | 0); } else if (k === 3) { const offs = node.offs, kids = node.kids, n = kids.length | 0; for (let i = 0; i < n; i = (i + 1) | 0) walk(kids[i], (baseOff + offs[i]) | 0); } else if (k === 5) { const ms = node.marks, n = ms.length | 0; if (baseOff === 0) { for (let i = 0; i < n; i = (i + 1) | 0) out.push(ms[i]); } else { for (let i = 0; i < n; i = (i + 1) | 0) { const mk = ms[i]; out.push({ offset: (mk.offset + baseOff) | 0, span: mk.span }); } } } else { const startIdx = out.length | 0; walk(node.child, 0); const endIdx = out.length | 0; if (startIdx === endIdx) return; const ls_b = node.ls, ns = node.ns | 0, slen = node.slen | 0; let mi = startIdx; let mk = out[mi]; let mo = mk.offset | 0; const firstStart = ls_b[0]; while (mo < firstStart) { if (baseOff !== 0) mk.offset = (mo + baseOff) | 0; mi = (mi + 1) | 0; if (mi >= endIdx) return; mk = out[mi]; mo = mk.offset | 0; } for (let li = 1; li <= ns; li = (li + 1) | 0) { const limit = ls_b[li]; if (mo >= limit) continue; const add = (baseOff + (li << 1)) | 0; for (;;) { mk.offset = (mo + add) | 0; mi = (mi + 1) | 0; if (mi >= endIdx) return; mk = out[mi]; mo = mk.offset | 0; if (mo >= limit) { if (mo >= slen) { out.length = mi; return; } break; } } } if (mi < endIdx) out.length = mi; } }; walk(rootM, 0); return out; }"))
  (defconst native-locate
    (lambda (span output)
      (if (not (eq emit-mark-mode 0))
          (funcall lazy-locate-kernel emit-mark-mode span output)
        (if function-source-profile
            (if (eq (js* "typeof output") "string")
                (make-fragment output (js-array))
              output)
          (if (nil? fast-locate-kernel)
              (let* ((fragment (as-fragment output))
                     (marks (get fragment :marks)))
                (if (or (= (get (get fragment :text) :length) 0)
                        (not span)
                        (js-call marks :some (lambda (mark) (= (get mark :offset) 0))))
                    fragment
                  (make-fragment (get fragment :text)
                    (js-call (js-array (js-object :offset 0 :span span)) :concat marks))))
            (funcall fast-locate-kernel span output))))))
  (defvar temporary-counter 0)
  (defvar binding-temporaries (new globalThis.Map))
  (defconst tdz-import
    "import { tdz as __eliscript_tdz_error, immutable as __eliscript_const_error } from \"eliscript/runtime/errors.mjs\";\n")
  ;; Resolve module bindings once, without rewriting source names or raw JS.
  (defvar tdz-state nil)
  (defun tdz-ready-name (record) (str "__eliscript_tdz_ready_" (get record :index)))
  (defun tdz-root-name (name)
    (let ((dot (js-call name :indexOf ".")) (slash (js-call name :indexOf "/")))
      (let ((end (if (< dot 0) slash (if (< slash 0) dot (if (< dot slash) dot slash)))))
        (if (< end 0) name (js-call name :slice 0 end)))))
  (defun tdz-key (state name)
    (let ((cache (get state :keyCache)))
      (let ((cached (js-call cache :get name)))
        (if (not (eq cached undefined))
            cached
          (let ((computed (binding-name name)))
            (js-call cache :set name computed)
            computed)))))
  (defun tdz-scope (parent) (js-object :parent parent :names nil))
  (defun tdz-scope-set (scope key value)
    (let ((names (get scope :names)))
      (when (nil? names)
        (setq names (new globalThis.Map))
        (put scope :names names))
      (js-call names :set key value)))
  (defun tdz-resolve-key (raw-name state)
    (let* ((cache (get state :rawLookup))
           (cached (js-call cache :get raw-name)))
      (if (not (eq cached undefined))
          cached
        (let* ((root (tdz-root-name raw-name))
               (key (tdz-key state root))
               (tracked (if (js-call (get state :rootNames) :has key) key false)))
          (js-call cache :set raw-name tracked)
          tracked))))
  (defun tdz-find-key (scope key)
    (let ((current scope) (found false) (record nil))
      (while (and current (not found))
        (let ((names (get current :names)))
          (if (and names (js-call names :has key))
              (progn (setq record (js-call names :get key)) (setq found t))
            (setq current (get current :parent)))))
      record))
  (defun tdz-find (scope name state)
    (let ((root-names (get state :rootNames))
          (key (tdz-key state name)))
      (if (not (js-call root-names :has key))
          nil
        (tdz-find-key scope key))))
  (defun tdz-pattern-names (node scope state)
    (let ((kind (ir-kind node)) (nodes (children node)))
      (cond
        ((= kind "binding-name")
         (let ((key (tdz-key state (ir-value node))))
           (when (js-call (get state :rootNames) :has key)
             (tdz-scope-set scope key nil))))
        ((= kind "map-binding-entry") (tdz-pattern-names (js-nth 0 nodes) scope state))
        ((or (= kind "array-binding-pattern") (= kind "map-binding-pattern"))
         (let ((idx 0) (len (js-length nodes)))
           (while (< idx len)
             (tdz-pattern-names (js-nth idx nodes) scope state)
             (setq idx (1+ idx))))))))
  (defun tdz-bind (node scope state)
    (if (ir-property node "pattern")
        (tdz-pattern-names (js-nth 0 (children node)) scope state)
      (let ((key (tdz-key state (ir-value node))))
        (when (js-call (get state :rootNames) :has key)
          (tdz-scope-set scope key nil)))))
  (defun tdz-pattern-defaults (node scope state)
    (let ((kind (ir-kind node)) (nodes (children node)))
      (cond
        ((= kind "map-binding-entry")
         (when (> (js-length nodes) 2) (tdz-walk (js-nth 2 nodes) scope state))
         (tdz-pattern-defaults (js-nth 0 nodes) scope state))
        ((or (= kind "array-binding-pattern") (= kind "map-binding-pattern"))
         (let ((idx 0) (len (js-length nodes)))
           (while (< idx len)
             (tdz-pattern-defaults (js-nth idx nodes) scope state)
             (setq idx (1+ idx))))))))
  (defun tdz-defaults (node scope state)
    (when (ir-property node "pattern")
      (tdz-pattern-defaults (js-nth 0 (children node)) scope state)))
  (defun tdz-statements (nodes statements)
    (let ((idx 0) (len (js-length nodes)))
      (while (< idx len)
        (let ((node (js-nth idx nodes)))
          (if (= (ir-kind node) "module-declaration")
              (tdz-statements (children node) statements)
            (js-call statements :push node)))
        (setq idx (1+ idx))))
    statements)
  (defun tdz-predeclare (statements scope state)
    (let ((root-names (get scope :names))
          (sidx 0)
          (slen (js-length statements)))
      (while (< sidx slen)
        (let* ((node (js-nth sidx statements))
               (kind (ir-kind node))
               (name (ir-value node)))
          (cond
            ((= kind "variable-declaration")
             (let ((key (tdz-key state name))
                   (record (js-object :name name :index (js-length (get state :variables))
                             :mutable (ir-property node "mutable") :statement (get state :position)
                             :read false :write false)))
               (js-call (get state :variables) :push record)
               (js-call (get state :declarations) :set node record)
               (js-call root-names :set key record)))
            ((= kind "function-declaration")
             (let ((key (tdz-key state name)))
               (js-call (get state :functions) :add key)
               (js-call root-names :set key (js-object :function key))
               (when (ir-property node "portable") (js-call (get state :exported) :push key))))
            ((= kind "export-declaration")
             (let ((enodes (children node)) (eidx 0))
               (while (< eidx (js-length enodes))
                 (js-call (get state :exported) :push (tdz-key state (ir-value (js-nth eidx enodes))))
                 (setq eidx (1+ eidx)))))
            ((= kind "import-declaration")
             (put state :imports t)
             (let ((inodes (children node)) (iidx 0))
               (while (< iidx (js-length inodes))
                 (js-call root-names :set (tdz-key state (ir-value (js-nth iidx inodes))) nil)
                 (setq iidx (1+ iidx)))))))
        (put state :position (1+ (get state :position)))
        (setq sidx (1+ sidx)))))
  (defun tdz-variable-p (record)
    (and record (= (value-type (get record :index)) "number")))
  (defun tdz-guarded-p (record)
    (and record (or (get record :read) (get record :write))))
  (defun tdz-reference (state record)
    (let ((owner (get state :owner)) (references (get state :references)))
      ;; Repeated references have the same reachability edge. Keep source-node
      ;; visits intact and store each edge once in this private analysis graph.
      (unless (js-call references :has owner) (js-call references :set owner (new globalThis.Set)))
      (js-call (js-call references :get owner) :add (get record :function))))
  (defun tdz-site (state kind record node)
    (js-call (get state :sites) :push
      (js-object :kind kind :record record :owner (get state :owner) :node node)))
  ;; A top-level statement runs at its own position. A function can first run
  ;; when a statement or earlier function references it; with imports an
  ;; exported function can run through a cycle before this module, and raw
  ;; JavaScript can call any function. Only accesses that can run before their
  ;; declaration completes are guarded.
  (defun tdz-finalize (state)
    (let ((functions (get state :functions)) (references (get state :references))
          (raw (get state :raw)) (early (new globalThis.Map)) (pending (js-array))
          (queued (new globalThis.Set))
          (never (get state :position)) (all (get state :position)))
      (let ((lower
              (lambda (key index)
                (when (and (js-call functions :has key)
                           (< index (if (js-call early :has key) (js-call early :get key) never)))
                  (js-call early :set key index)
                  ;; A queued function reads its newest lower bound when it
                  ;; runs; another copy cannot add a distinct propagation.
                  (unless (js-call queued :has key)
                    (js-call queued :add key)
                    (js-call pending :push key))))))
        (when (get state :imports)
          (js-call (get state :exported) :forEach (lambda (key) (funcall lower key -1))))
        (js-call references :forEach
          (lambda (keys owner)
            (when (= (value-type owner) "number")
              (js-call keys :forEach (lambda (key) (funcall lower key owner))))))
        (js-call raw :forEach
          (lambda (owner) (when (and (= (value-type owner) "number") (< owner all)) (setq all owner))))
        (while (> (js-length pending) 0)
          (let* ((key (js-call pending :pop)) (index (js-call early :get key)))
            ;; Permit a later strict decrease to schedule this function again.
            (js-call queued :delete key)
            (when (and (js-call raw :has key) (< index all)) (setq all index))
            (when (js-call references :has key)
              (js-call (js-call references :get key) :forEach (lambda (callee) (funcall lower callee index)))))))
      (js-call (get state :sites) :forEach
        (lambda (site)
          (let* ((record (get site :record)) (owner (get site :owner)) (read (= (get site :kind) "read"))
                 (start (if (js-call early :has owner) (js-call early :get owner) never))
                 (time (if (= (value-type owner) "number") owner (if (< all start) all start))))
            (when (or (and (not read) (not (get record :mutable))) (<= time (get record :statement)))
              (if read
                  (progn (put record :read t) (js-call (get state :reads) :set (get site :node) record))
                (progn (put record :write t) (js-call (get state :writes) :set (get site :node) record)))))))))
  (defun tdz-walk (node scope state)
    (let ((kind (ir-kind node)) (nodes (children node)))
      (cond
        ((or (eq kind "reference") (eq kind "assignment-pair"))
         (let ((key (tdz-resolve-key (ir-value node) state))
               (idx 0) (len (aref nodes "length")))
           (when key
             (let ((record (tdz-find-key scope key)))
               (cond ((tdz-variable-p record)
                      (tdz-site state (if (eq kind "reference") "read" "write") record node))
                     ((and record (eq kind "reference")) (tdz-reference state record)))))
           (while (< idx len)
             (tdz-walk (aref nodes idx) scope state)
             (setq idx (+ idx 1)))))
        ((eq kind "raw-javascript") (js-call (get state :raw) :add (get state :owner)))
        ((or (eq kind "function-declaration") (eq kind "function-expression"))
         (let ((child (tdz-scope scope)) (count (ir-property node "parameterCount")) (index 0) (len (aref nodes "length")))
           (while (< index count) (tdz-defaults (aref nodes index) scope state) (setq index (+ index 1)))
           (setq index 0)
           (while (< index count) (tdz-bind (aref nodes index) child state) (setq index (+ index 1)))
           (let ((body-scope (if (nil? (get child :names)) scope child)))
             (while (< index len) (tdz-walk (aref nodes index) body-scope state) (setq index (+ index 1))))))
        ((or (eq kind "lexical-bindings") (eq kind "binding-loop"))
         (let ((child (tdz-scope scope)) (count (ir-property node "bindingCount"))
               (sequential (ir-property node "sequential")) (index 0) (len (aref nodes "length")))
           (while (< index count)
             (let* ((binding (aref nodes index)) (values (children binding))
                    (outer (if (and sequential (not (nil? (get child :names)))) child scope))
                    (start (if (ir-property binding "pattern") 1 0))
                    (vlen (aref values "length")))
               (while (< start vlen) (tdz-walk (aref values start) outer state) (setq start (+ start 1)))
               (tdz-defaults binding outer state)
               (when sequential (tdz-bind binding child state)))
             (setq index (+ index 1)))
           (unless sequential
             (setq index 0)
             (while (< index count) (tdz-bind (aref nodes index) child state) (setq index (+ index 1))))
           (let ((body-scope (if (nil? (get child :names)) scope child)))
             (while (< index len) (tdz-walk (aref nodes index) body-scope state) (setq index (+ index 1))))))
        ((eq kind "catch-clause")
         (let ((child (tdz-scope scope)) (binding (aref nodes 0)) (index 1) (len (aref nodes "length")))
           (tdz-defaults binding scope state) (tdz-bind binding child state)
           (let ((body-scope (if (nil? (get child :names)) scope child)))
             (while (< index len) (tdz-walk (aref nodes index) body-scope state) (setq index (+ index 1))))))
        ((or (eq kind "quoted-literal") (eq kind "import-declaration") (eq kind "export-declaration")) nil)
        (t
         (let ((idx 0) (len (aref nodes "length")))
           (while (< idx len)
             (tdz-walk (aref nodes idx) scope state)
             (setq idx (+ idx 1))))))))
  (defun tdz-prepare (program)
    (let* ((root-names (new globalThis.Map))
           (scope (js-object :parent nil :names root-names))
           (state (js-object :variables (js-array) :declarations (new globalThis.Map)
                    :reads (new globalThis.Map) :writes (new globalThis.Map)
                    :functions (new globalThis.Set) :references (new globalThis.Map) :raw (new globalThis.Set)
                    :exported (js-array) :imports false :sites (js-array) :position 0 :owner nil
                    :rootNames root-names :keyCache (new globalThis.Map) :rawLookup (new globalThis.Map)))
           (statements (tdz-statements (program-body program) (js-array))))
      (tdz-predeclare statements scope state)
      ;; With no tracked module variable, every possible lookup is absent.
      ;; Function-only modules therefore need no TDZ traversal of their bodies.
      (when (> (js-length (get state :variables)) 0)
        (let ((sidx 0) (slen (js-length statements)))
          (while (< sidx slen)
            (let ((node (js-nth sidx statements)))
              (put state :owner
                (if (= (ir-kind node) "function-declaration") (tdz-key state (ir-value node)) sidx))
              (tdz-walk node scope state))
            (setq sidx (1+ sidx))))
        (tdz-finalize state))
      state))
  (defun tdz-writer-name (record) (str "__eliscript_tdz_write_" (get record :index)))
  (defun tdz-prologue ()
    (let ((records (if (nil? tdz-state) (js-array) (js-call (get tdz-state :variables) :filter tdz-guarded-p))))
      (if (= (js-length records) 0) ""
        (str tdz-import
          (js-call (js-call records :map
            (lambda (record)
              (let ((ready (tdz-ready-name record)) (name (binding-name (get record :name)))
