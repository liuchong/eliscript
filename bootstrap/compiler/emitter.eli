    (let ((names (new globalThis.Map)) (index 0) (safe t))
      (while (and safe (< index (js-length bindings)))
        (let ((name (binding-name (ir-value (js-nth index bindings)))))
          (if (js-call names :has name) (setq safe false) (js-call names :set name index)))
        (setq index (1+ index)))
      (setq index 0)
      (while (and safe (< index (js-length bindings)))
        (let* ((initializer (binding-initializer (js-nth index bindings)))
               (pending (if initializer (js-array initializer) (js-array))))
          (while (and safe (> (js-length pending) 0))
            (let* ((node (js-call pending :pop)) (kind (ir-kind node)))
              (if (= kind "raw-javascript") (setq safe false)
                (progn
                  ;; Include reads inside closures and assignment targets. A
                  ;; conservative extra scope is preferable to a new TDZ or
                  ;; capturing a binding declared later in the same block.
                  (when (or (= kind "reference") (= kind "assignment-pair"))
                    (let* ((name (reference-name (ir-value node)))
                           (root (js-nth 0 (js-call name :split "."))))
                      (when (and (js-call names :has root) (or parallel (>= (js-call names :get root) index)))
                        (setq safe false))))
                  (let ((members (children node)))
                    (when (and (= kind "invoke") (primitive-invocation-operator members t))
                      (setq members (js-call members :slice 1)))
                    (js-call members :forEach (lambda (child) (js-call pending :push child)))))))))
        (setq index (1+ index))) safe)))

  (defun emit-context-let (bindings body sequential returning)
    (if (= (get bindings :length) 0)
        (if returning (emit-returning-body body) (emit-statement-body body))
      (if (context-sequential-safe-p bindings (not sequential))
          (let ((declarations (js-array)))
            (js-call bindings :forEach (lambda (binding)
              (let ((initializer (binding-initializer binding)))
                (js-call declarations :push (fast-combine (js-array "let " (emit-binding-target binding) " = "
                  (if initializer (emit-expression initializer) "null") ";"))))))
            (js-call declarations :push (if returning (emit-returning-body body) (emit-statement-body body)))
            (fast-combine (js-array "{\n" (emit-indent (join-fragments declarations "\n")) "\n}")))
      (let* ((group (if sequential (js-array (js-nth 0 bindings)) bindings))
             (temporaries (temporary-names group))
             (initializers (js-array))
             (declarations (js-array))
             (index 0))
        (while (< index (get group :length))
          (let* ((binding (js-nth index group))
                 (initializer (binding-initializer binding)))
            (js-call initializers :push
              (fast-combine
                (js-array "const " (js-nth index temporaries) " = "
                  (if initializer (emit-expression initializer) "null") ";"))))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (get group :length))
          (js-call declarations :push
            (fast-combine
              (js-array "let " (emit-binding-target (js-nth index group)) " = "
                (js-nth index temporaries) ";")))
          (setq index (1+ index)))
        (js-call declarations :push
          (emit-context-let
            (if sequential (js-call bindings :slice 1) (js-array))
            body sequential returning))
        (js-call initializers :push
          (fast-combine (js-array "{\n" (emit-indent (join-fragments declarations "\n")) "\n}")))
        (fast-combine (js-array "{\n" (emit-indent (join-fragments initializers "\n")) "\n}"))))))

  (defun emit-context-cond (clauses returning)
    (if (= (get clauses :length) 0)
        (emit-text (if returning "return null;" ""))
      (let* ((clause (js-nth 0 clauses))
             (nodes (children clause))
             (test (js-nth 0 nodes))
             (body (js-call nodes :slice 1)))
        (native-locate (ir-span clause)
          (if (and (= (ir-kind test) "literal") (= (ir-value test) t))
              (if returning (emit-returning-body body) (emit-statement-body body))
            (fast-combine
              (js-array "if (" (emit-test test) ") {\n"
                (emit-indent (if returning (emit-returning-body body) (emit-statement-body body)))
                "\n} else {\n"
                (emit-indent (emit-context-cond (js-call clauses :slice 1) returning)) "\n}")))))))

  (defun emit-context (node returning)
    (let ((kind (ir-kind node)) (nodes (children node)))
      (native-locate (ir-span node)
        (cond
          ;; Preserve async expression boundaries and their promise scheduling.
          ((contains-await-p node)
           (fast-combine (js-array (if returning "return " "") (emit-expression node) ";")))
          ((= kind "sequence")
           (if returning (emit-returning-body nodes) (emit-statement-body nodes)))
          ((= kind "conditional")
           (fast-combine
             (js-array "if (" (emit-test (js-nth 0 nodes)) ") {\n"
               (emit-indent (emit-context (js-nth 1 nodes) returning)) "\n}"
               (if (or returning (> (get nodes :length) 2))
                   (fast-combine (js-array " else {\n"
                     (emit-indent (if (> (get nodes :length) 2)
                                      (emit-context (js-nth 2 nodes) returning)
                                    (emit-text "return null;"))) "\n}")) ""))))
          ((= kind "conditional-sugar")
           (fast-combine
             (js-array "if ("
               (if (= (ir-value node) "when") (emit-test (js-nth 0 nodes))
                 (fast-combine (js-array "(!" (emit-test (js-nth 0 nodes)) ")")))
               ") {\n"
               (emit-indent (if returning (emit-returning-body (js-call nodes :slice 1))
                              (emit-statement-body (js-call nodes :slice 1)))) "\n}"
               (if returning " else {\n  return null;\n}" ""))))
          ((= kind "conditional-chain") (emit-context-cond nodes returning))
          ((= kind "loop")
           (fast-combine
             (js-array "while (" (emit-test (js-nth 0 nodes)) ") {\n"
               (emit-indent (emit-statement-body (js-call nodes :slice 1))) "\n}"
               (if returning "\nreturn null;" ""))))
          ((and (= kind "lexical-bindings")
                (js-call (js-call nodes :slice 0 (ir-property node "bindingCount"))
                  :every (lambda (binding) (not (ir-property binding "pattern")))))
           (let ((parts (split-counted-children node "bindingCount")))
             (emit-context-let (js-nth 0 parts) (js-nth 1 parts)
               (ir-property node "sequential") returning)))
          (t
           (fast-combine (js-array (if returning "return " "") (emit-expression node) ";")))))))

  (defun emit-returning-body (nodes)
    (if (= (get nodes :length) 0)
        (emit-text "return null;")
      (let ((parts (js-array)) (index 0) (last-index (1- (get nodes :length))))
        (while (< index last-index)
          (js-call parts :push (emit-context (js-nth index nodes) false))
          (setq index (1+ index)))
        (js-call parts :push (emit-context (js-nth last-index nodes) t))
        (join-fragments parts "\n"))))

  (defun emit-statement-body (nodes)
    (join-fragments
      (js-call nodes :map (lambda (node) (emit-context node false))) "\n"))

  (defvar await-node-cache nil)
  (defvar module-has-await t)
  (defvar module-has-recur t)
  (defconst scan-program-flags
    (js* "/* @eliscript-js-host-fastpath */ (body) => { const stack = body.slice(0); let flags = 0; while (stack.length > 0 && flags !== 3) { const node = stack.pop(); if (node !== null && typeof node === 'object') { const k = node.kind; if (k === 'await-expression') flags |= 1; else if (k === 'recur') flags |= 2; const ch = node.children; if (ch !== undefined) { for (let i = 0, n = ch.length | 0; i < n; i = (i + 1) | 0) stack.push(ch[i]); } } } return flags; }"))

  (defun scan-program-flags-portable (body)
    (let ((stack (js-call body :slice 0))
          (flags 0))
      (while (and (> (bit-or (aref stack "length") 0) 0)
                  (not (eq flags 3)))
        (let ((node (js-call stack :pop)))
          (when (and (not (nil? node)) (eq (js* "typeof node") "object"))
            (let ((k (aref node "kind")))
              (if (eq k "await-expression")
                  (setq flags (bit-or flags 1))
                (when (eq k "recur")
                  (setq flags (bit-or flags 2))))
              (let ((ch (aref node "children")))
                (unless (eq ch undefined)
                  (let ((i 0) (n (bit-or (aref ch "length") 0)))
                    (while (< i n)
                      (js-call stack :push (aref ch i))
                      (setq i (+ i 1))))))))))
      flags))

  (defun program-contains-await-p (program)
    (let ((pending (js-call (program-body program) :slice))
          (found false))
      (while (and (eq found false) (> (bit-or (aref pending "length") 0) 0))
        (let ((node (js-call pending :pop)))
          (when (node-p node)
            (if (eq (ir-kind node) "await-expression")
                (setq found t)
              (let ((nodes (children node)))
                (let ((len (bit-or (aref nodes "length") 0))
                      (idx 0))
                  (while (< idx len)
                    (js-call pending :push (aref nodes idx))
                    (setq idx (+ idx 1)))))))))
      found))

  (defun node-contains-await-cached-p (node cache)
    (let ((cached (js-call cache :get node)))
      (if (not (eq cached undefined))
          cached
        (let ((kind (ir-kind node))
              (found false))
          (if (eq kind "await-expression")
              (setq found t)
            (when (not (eq kind "function-expression"))
              (let ((nodes (children node)))
                (let ((len (bit-or (aref nodes "length") 0))
                      (index 0))
                  (while (and (eq found false) (< index len))
                    (let ((child (aref nodes index)))
                      (when (and (node-p child) (node-contains-await-cached-p child cache))
                        (setq found t)))
                    (setq index (+ index 1)))))))
          (js-call cache :set node found)
          found))))

  (defun contains-await-p (value)
    (if (not module-has-await)
        false
      (let ((cache await-node-cache))
        (if (not (nil? cache))
            (cond
              ((node-p value) (node-contains-await-cached-p value cache))
              ((funcall emit-array-is-array value)
               (let ((len (bit-or (aref value "length") 0))
                     (index 0)
                     (found false))
                 (while (and (eq found false) (< index len))
                   (let ((item (aref value index)))
                     (when (contains-await-p item)
                       (setq found t)))
                   (setq index (+ index 1)))
                 found))
              (t false))
          (let ((pending (js-array value))
                (current nil)
                (kind nil)
                (nodes nil)
                (index 0)
                (found false))
            (while (and (not found) (> (get pending :length) 0))
              (setq current (js-call pending :pop))
              (cond
                ((node-p current)
                 (setq kind (ir-kind current))
                 (cond
                   ((= kind "await-expression") (setq found t))
                   ((not (= kind "function-expression"))
                    (setq nodes (children current))
                    (setq index (1- (get nodes :length)))
                    (while (>= index 0)
                      (js-call pending :push (js-nth index nodes))
                      (setq index (1- index))))))
                ((Array/isArray current)
                 (setq index (1- (get current :length)))
                 (while (>= index 0)
                   (js-call pending :push (js-nth index current))
                   (setq index (1- index))))))
            found)))))

  (defun emit-iife (parameters body invocation asynchronous)
    (if asynchronous
        (fast-combine
          (js-array "(await (async (" parameters ") => {\n" body "\n})("
           invocation "))"))
      (fast-combine
        (js-array "((" parameters ") => {\n" body "\n})(" invocation ")"))))

  (defun emit-do (nodes)
    (cond
      ((= (get nodes :length) 0) (emit-text "null"))
      ((= (get nodes :length) 1) (emit-expression (js-nth 0 nodes)))
      (t
       (emit-iife
         "" (emit-indent (emit-returning-body nodes)) ""
         (contains-await-p nodes)))))

  (defun split-counted-children (node property)
    (let ((all (children node))
          (count (ir-property node property)))
      (js-array (js-call all :slice 0 count) (js-call all :slice count))))

  (defun emit-function (node)
    (let* ((parts (split-counted-children node "parameterCount"))
           (parameters (js-nth 0 parts))
           (body (js-nth 1 parts)))
      (let ((fragment (fast-combine
        (js-array "(" (if (ir-property node "async") "async " "") "("
         (join-fragments
           (js-call parameters :map
             (lambda (parameter) (emit-parameter parameter)))
           ", ")
         ") => {\n"
         (emit-indent (emit-function-body parameters body))
         "\n})"))))
        (function-source-fragment node fragment 1 (1- (js-length (get fragment :text)))))))

  (defun contains-recur-target-p (value target-kind)
    (if (not module-has-recur)
        false
      (let ((pending (js-array value))
            (current nil)
            (kind nil)
            (nodes nil)
            (index 0)
            (found false))
        (while (and (not found) (> (get pending :length) 0))
          (setq current (js-call pending :pop))
          (cond
            ((node-p current)
             (setq kind (ir-kind current))
             (cond
               ((= kind "recur")
                (when (= (ir-property current "targetKind") target-kind)
                  (setq found t)))
               ((not (= kind "function-expression"))
                (setq nodes (children current))
                (setq index (1- (get nodes :length)))
                (while (>= index 0)
                  (js-call pending :push (js-nth index nodes))
                  (setq index (1- index))))))
            ((Array/isArray current)
             (setq index (1- (get current :length)))
             (while (>= index 0)
               (js-call pending :push (js-nth index current))
               (setq index (1- index))))))
        found)))

  (defun emit-rebinding-target (binding temporary)
    (let ((target (emit-binding-target binding)))
      (if (ir-property binding "pattern")
          (fast-combine (js-array "(" target " = " temporary ");"))
        (fast-combine (js-array target " = " temporary ";")))))

  (defun emit-recur-tail (node target)
    (unless (= (ir-property node "targetKind") (get target :kind))
      (fail "recur target does not match its enclosing loop"))
    (let ((args (children node))
          (bindings (get target :bindings))
          (temporaries (js-array))
          (parts (js-array))
          (index 0))
      (while (< index (get args :length))
        (let ((temporary (fresh-name)))
          (js-call temporaries :push temporary)
          (js-call parts :push
            (fast-combine
              (js-array "const " temporary " = "
               (emit-expression (js-nth index args)) ";"))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (get bindings :length))
        (js-call parts :push
          (emit-rebinding-target
            (js-nth index bindings) (js-nth index temporaries)))
        (setq index (1+ index)))
      (js-call parts :push
        (fast-combine (js-array "continue " (get target :label) ";")))
      (native-locate (ir-span node) (join-fragments parts "\n"))))

  (defun emit-tail-body (nodes target)
    (if (= (get nodes :length) 0)
        (emit-text "return null;")
      (let ((parts (js-array))
            (index 0)
            (last-index (1- (get nodes :length))))
        (while (< index last-index)
          (js-call parts :push
            (fast-combine (js-array (emit-expression (js-nth index nodes)) ";")))
          (setq index (1+ index)))
        (js-call parts :push
          (emit-tail-node (js-nth last-index nodes) target))
        (join-fragments parts "\n"))))

  (defun emit-tail-cond (clauses target)
    (if (= (get clauses :length) 0)
        (emit-text "return null;")
      (let* ((clause (js-nth 0 clauses))
             (nodes (children clause))
             (test (js-nth 0 nodes))
             (body (js-call nodes :slice 1)))
        (native-locate
          (ir-span clause)
          (if (and (= (ir-kind test) "literal")
                   (eq (ir-value test) t))
              (emit-tail-body body target)
            (fast-combine
              (js-array "if (__eliscript_truthy(" (emit-expression test)
               ")) {\n" (emit-indent (emit-tail-body body target))
               "\n} else {\n"
               (emit-indent
                 (emit-tail-cond (js-call clauses :slice 1) target))
               "\n}")))))))

  (defun emit-tail-let (node target)
    (let* ((parts (split-counted-children node "bindingCount"))
           (bindings (js-nth 0 parts))
           (body (js-nth 1 parts))
           (sequential (ir-property node "sequential"))
           (statements (js-array))
           (temporaries (js-array))
           (index 0))
      (if sequential
          (while (< index (get bindings :length))
            (let* ((binding (js-nth index bindings))
                   (initializer (binding-initializer binding)))
              (js-call statements :push
                (fast-combine
                  (js-array "let " (emit-binding-target binding) " = "
                   (if initializer
                       (emit-expression initializer)
                     (binding-default-value binding))
                   ";")))
              (when (map-binding-pattern-p binding)
                (js-call statements :push (emit-binding-setup binding))))
            (setq index (1+ index)))
        (progn
          (while (< index (get bindings :length))
            (let* ((binding (js-nth index bindings))
                   (initializer (binding-initializer binding))
                   (temporary (fresh-name)))
              (js-call temporaries :push temporary)
              (js-call statements :push
                (fast-combine
                  (js-array "const " temporary " = "
                   (if initializer
                       (emit-expression initializer)
                     (binding-default-value binding))
                   ";"))))
            (setq index (1+ index)))
          (setq index 0)
          (while (< index (get bindings :length))
            (js-call statements :push
              (fast-combine
                (js-array "let " (emit-binding-target (js-nth index bindings)) " = "
                 (js-nth index temporaries) ";")))
            (when (map-binding-pattern-p (js-nth index bindings))
              (js-call statements :push
                (emit-binding-setup (js-nth index bindings))))
            (setq index (1+ index)))))
      (js-call statements :push (emit-tail-body body target))
      (native-locate
        (ir-span node)
        (fast-combine
          (js-array "{\n" (emit-indent (join-fragments statements "\n")) "\n}")))))

  (defun emit-tail-short-circuit (nodes kind target)
    (cond
      ((= (get nodes :length) 0)
       (emit-text (if (= kind "and") "return true;" "return null;")))
      ((= (get nodes :length) 1)
       (emit-tail-node (js-nth 0 nodes) target))
      (t
       (let* ((temporary (fresh-name))
              (first (emit-expression (js-nth 0 nodes)))
              (rest (js-call nodes :slice 1))
              (truthy
               (if (= kind "and")
                   (emit-tail-short-circuit rest kind target)
                 (fast-combine (js-array "return " temporary ";"))))
              (falsey
               (if (= kind "and")
                   (fast-combine (js-array "return " temporary ";"))
                 (emit-tail-short-circuit rest kind target))))
         (fast-combine
           (js-array "const " temporary " = " first ";\n"
            "if (__eliscript_truthy(" temporary ")) {\n"
            (emit-indent truthy) "\n} else {\n" (emit-indent falsey) "\n}"))))))

  (defun emit-tail-node (node target)
    (let ((kind (ir-kind node))
          (nodes (children node)))
      (cond
        ((= kind "recur") (emit-recur-tail node target))
        ((= kind "conditional")
         (fast-combine
           (js-array "if (__eliscript_truthy(" (emit-expression (js-nth 0 nodes))
            ")) {\n" (emit-indent (emit-tail-node (js-nth 1 nodes) target))
            "\n} else {\n"
            (emit-indent
              (if (> (get nodes :length) 2)
                  (emit-tail-node (js-nth 2 nodes) target)
                (emit-text "return null;")))
            "\n}")))
        ((= kind "conditional-sugar")
         (fast-combine
           (js-array "if (" (if (= (ir-value node) "when") "" "!")
            "__eliscript_truthy(" (emit-expression (js-nth 0 nodes))
            ")) {\n"
            (emit-indent (emit-tail-body (js-call nodes :slice 1) target))
            "\n} else {\n  return null;\n}")))
        ((= kind "conditional-chain") (emit-tail-cond nodes target))
        ((= kind "sequence") (emit-tail-body nodes target))
        ((= kind "lexical-bindings") (emit-tail-let node target))
        ((= kind "short-circuit")
         (emit-tail-short-circuit nodes (ir-value node) target))
        (t (fast-combine (js-array "return " (emit-expression node) ";"))))))

  (defconst closed-scalar-operators
    (js-array "+" "-" "*" "/" "%" "mod" "1+" "1-" "=" "eq" "<" "<=" ">" ">=" "/=" "not=" "not"))

  (defun closed-scalar-node-p (node scope state)
    (if (nullish? node) t
      (let ((kind (ir-kind node)) (nodes (children node)))
      (cond
        ((= kind "literal")
         (or (= (ir-value node) nil) (= (value-type (aref node "value")) "number")
             (= (value-type (aref node "value")) "boolean") (= (value-type (aref node "value")) "undefined")))
        ((= kind "reference") (>= (js-call scope :indexOf (ir-value node)) 0))
        ((= kind "lexical-bindings")
         (let* ((parts (split-counted-children node "bindingCount"))
                (bindings (js-nth 0 parts)) (inner (js-call scope :slice)) (valid t))
           (js-call bindings :forEach
             (lambda (binding)
               (when (or (not (= (ir-kind binding) "lexical-binding"))
                         (ir-property binding "pattern")
                         (not (closed-scalar-node-p (binding-initializer binding)
                                (if (ir-property node "sequential") inner scope) state)))
                 (setq valid false))
               (js-call inner :push (ir-value binding))))
           (and valid (js-call (js-nth 1 parts) :every
                        (lambda (child) (closed-scalar-node-p child inner state))))))
        ((= kind "assignment")
         (js-call nodes :every
           (lambda (pair)
             (and (= (ir-kind pair) "assignment-pair")
                  (>= (js-call scope :indexOf (ir-value pair)) 0)
                  (closed-scalar-node-p (js-nth 0 (children pair)) scope state)))))
        ((or (and (= kind "intrinsic") (>= (js-call closed-scalar-operators :indexOf (ir-value node)) 0))
             (= kind "conditional") (= kind "conditional-sugar") (= kind "short-circuit")
             (= kind "sequence") (= kind "loop"))
         (when (= kind "loop") (put state :loop t))
         (and (or (not (= kind "intrinsic")) (not (relational-operator-p (ir-value node)))
                  (= (js-length nodes) 2))
              (js-call nodes :every (lambda (child) (closed-scalar-node-p child scope state)))))
        (t false)))))

  (defun closed-scalar-loop-p (parameters body)
    (and (> (aref parameters "length") 0)
         (js-call parameters :every
           (lambda (parameter)
             (and (eq (ir-property parameter "parameterKind") "required")
                  (not (ir-property parameter "pattern")))))
         (let ((state (js-object :loop false))
               (scope (js-call parameters :map (lambda (parameter) (ir-value parameter)))))
           (and (js-call body :every (lambda (node) (closed-scalar-node-p node scope state)))
                (get state :loop)))))

  (defun emit-function-body (parameters body)
    (let ((proven (proven-number-locals-for parameters body)))
      (if (and (eq proven false) (eq proven-number-locals undefined))
          (emit-function-body-guarded parameters body)
        (with-proven-number-locals (if proven proven undefined)
          (lambda () (emit-function-body-guarded parameters body))))))

  (defun emit-function-body-guarded (parameters body)
    (if (and (not numeric-emission-profile) (closed-scalar-loop-p parameters body))
        (let ((fast nil) (slow nil))
          (setq fast (with-numeric-emission-profile
                       (lambda () (emit-function-body-unversioned parameters body))))
          (setq slow (emit-function-body-unversioned parameters body))
          (fast-combine
            (js-array "if ("
             (js-call (js-call parameters :map
                        (lambda (parameter) (str "typeof " (binding-name (ir-value parameter)) " === \"number\""))) :join " && ")
             ") {\n" (emit-indent fast) "\n} else {\n" (emit-indent slow) "\n}")))
      (emit-function-body-unversioned parameters body)))

  (defun emit-function-body-unversioned (parameters body)
    (let ((setups (emit-binding-setups parameters)))
      (if (not (contains-recur-target-p body "function"))
          (if (= (get (get setups :text) :length) 0)
              (emit-returning-body body)
            (fast-combine (js-array setups "\n" (emit-returning-body body))))
        (let* ((label (fresh-name))
             (target
              (js-object
                :kind "function" :bindings parameters :label label)))
          (fast-combine
            (js-array label ": while (true) {\n"
             (emit-indent
               (if (= (get (get setups :text) :length) 0)
                   (emit-tail-body body target)
                 (fast-combine
                   (js-array setups "\n" (emit-tail-body body target)))))
             "\n}"))))))

  (defun emit-if (nodes)
    (fast-combine
      (js-array "("
       (emit-test (js-nth 0 nodes))
       " ? "
       (emit-expression (js-nth 1 nodes))
       " : "
       (if (> (get nodes :length) 2)
           (emit-expression (js-nth 2 nodes))
         "null")
       ")")))

  (defun emit-conditional-sugar (node)
    (let* ((nodes (children node))
           (test (emit-test (js-nth 0 nodes)))
           (body (emit-do (js-call nodes :slice 1))))
      (fast-combine
        (js-array "("
          (if (= (ir-value node) "when") test
            (fast-combine (js-array "(!" test ")"))) " ? " body " : null)"))))

  (defun emit-cond (clauses)
    (if (= (get clauses :length) 0)
        (emit-text "null")
      (let* ((clause (js-nth 0 clauses))
             (nodes (children clause))
             (test (js-nth 0 nodes))
             (body (js-call nodes :slice 1)))
        (native-locate
          (ir-span clause)
          (if (and (= (ir-kind test) "literal") (= (ir-value test) t))
              (emit-do body)
            (fast-combine
              (js-array "("
               (emit-test test)
               " ? "
               (emit-do body)
               " : "
               (emit-cond (js-call clauses :slice 1))
               ")")))))))

  (defun emit-throw (node)
    (let ((temporary (fresh-name)))
      (fast-combine
        (js-array "((" temporary ") => { throw " temporary "; })("
         (emit-expression (js-nth 0 (children node))) ")"))))

  (defun emit-catch (node)
    (let* ((nodes (children node))
           (binding (js-nth 0 nodes))
           (body (js-call nodes :slice 1)))
      (native-locate
        (ir-span node)
        (fast-combine
          (js-array " catch (" (emit-binding-target binding) ") {\n"
           (emit-indent
             (if (map-binding-pattern-p binding)
                 (fast-combine
                   (js-array (emit-binding-setup binding) "\n"
                    (emit-returning-body body)))
               (emit-returning-body body)))
           "\n}")))))

  (defun emit-finally (node)
    (native-locate
      (ir-span node)
      (fast-combine
        (js-array " finally {\n"
         (emit-indent (emit-statement-body (children node)))
         "\n}"))))

  (defun emit-try (node)
    (let* ((parts (split-counted-children node "bodyCount"))
           (body (js-nth 0 parts))
           (clauses (js-nth 1 parts))
           (catch-clause
            (js-call clauses :find
              (lambda (clause) (= (ir-kind clause) "catch-clause"))))
           (finally-clause
            (js-call clauses :find
              (lambda (clause) (= (ir-kind clause) "finally-clause"))))
           (try-block
            (fast-combine
              (js-array "try {\n"
               (emit-indent (emit-returning-body body))
               "\n}"
               (if catch-clause (emit-catch catch-clause) "")
               (if finally-clause (emit-finally finally-clause) "")))))
      (emit-iife
        "" (emit-indent try-block) "" (contains-await-p node))))

  (defun emit-binding-values (bindings)
    (let ((result (js-array)))
      (js-call bindings :forEach
        (lambda (binding)
          (let ((initializer (binding-initializer binding)))
            (js-call result :push
                (if initializer
                  (emit-expression initializer)
                (binding-default-value binding))))))
      result))

  (defun emit-parallel-let (bindings body)
    (let* ((names
            (join-fragments
              (js-call bindings :map
                (lambda (binding) (emit-binding-target binding)))
              ", "))
           (values (join-fragments (emit-binding-values bindings) ", "))
           (setups (emit-binding-setups bindings))
           (body-output
            (emit-indent
              (if (= (get (get setups :text) :length) 0)
                  (emit-returning-body body)
                (fast-combine
                  (js-array setups "\n" (emit-returning-body body)))))))
      (emit-iife names body-output values (contains-await-p body))))

  (defun emit-sequential-let (bindings body)
    (if (= (get bindings :length) 0)
        (emit-do body)
      (let ((binding (js-nth 0 bindings)))
        (let* ((name (emit-binding-target binding))
               (initializer (js-nth 0 (emit-binding-values (js-array binding))))
               (tail (emit-sequential-let (js-call bindings :slice 1) body)))
          (emit-iife
            name
            (emit-indent
              (fast-combine
                (js-array
                  (if (map-binding-pattern-p binding)
                      (fast-combine (js-array (emit-binding-setup binding) "\n"))
                    "")
                  "return " tail ";")))
            initializer
            (or
              (contains-await-p (js-call bindings :slice 1))
              (contains-await-p body)))))))

  (defun emit-let (node)
    (let* ((parts (split-counted-children node "bindingCount"))
           (bindings (js-nth 0 parts))
           (body (js-nth 1 parts)))
      (if (ir-property node "sequential")
          (emit-sequential-let bindings body)
        (emit-parallel-let bindings body))))

  (defun emit-assignment (node)
    (let ((assignments (js-array)))
      (js-call (children node) :forEach
        (lambda (pair) (js-call assignments :push (native-locate (ir-span pair) (tdz-assignment pair)))))
      (if (= (ir-value node) "set!") (js-nth 0 assignments)
        (fast-combine (js-array "(" (join-fragments assignments ", ") ")")))))

  (defun emit-loop (node)
    (let* ((nodes (children node))
           (test-output (emit-test (js-nth 0 nodes)))
           (body (js-call nodes :slice 1)))
      (emit-iife ""
        (emit-indent
          (fast-combine
            (js-array "while (" test-output ") {\n"
              (emit-indent (emit-statement-body body)) "\n}\nreturn null;")))
        "" (contains-await-p nodes))))

  (defun emit-binding-loop (node)
    (let* ((parts (split-counted-children node "bindingCount"))
           (bindings (js-nth 0 parts))
           (body (js-nth 1 parts))
           (label (fresh-name))
           (target
            (js-object :kind "loop" :bindings bindings :label label))
           (parameters
            (join-fragments
              (js-call bindings :map
                (lambda (binding) (emit-binding-target binding)))
              ", "))
           (initializers
            (join-fragments
              (js-call bindings :map
                (lambda (binding)
                  (emit-expression (binding-initializer binding))))
              ", "))
           (setups (emit-binding-setups bindings)))
      (emit-iife
        parameters
        (emit-indent
          (fast-combine
            (js-array label ": while (true) {\n"
             (emit-indent
               (if (= (get (get setups :text) :length) 0)
                   (emit-tail-body body target)
                 (fast-combine
                   (js-array setups "\n" (emit-tail-body body target)))))
             "\n}")))
        initializers
        (contains-await-p body))))

  (defun emit-short-circuit (nodes kind)
    (cond
      ((= (get nodes :length) 0)
       (emit-text (if (= kind "and") "true" "null")))
      ((= (get nodes :length) 1) (emit-expression (js-nth 0 nodes)))
      ((and (js-call nodes :every boolean-p) (not (contains-await-p nodes)))
       (fast-combine
         (js-array "("
           (join-fragments
             (js-call nodes :map (lambda (node) (emit-expression node)))
             (if (= kind "and") " && " " || ")) ")")))
      (t
       (let ((temporary (fresh-name))
             (first (emit-expression (js-nth 0 nodes)))
             (rest (emit-short-circuit (js-call nodes :slice 1) kind)))
         (let ((body
                (fast-combine
                  (js-array "(__eliscript_truthy(" temporary ") ? "
                   (if (= kind "and") rest temporary)
                   " : "
                   (if (= kind "and") temporary rest)
                   ")"))))
           (if (contains-await-p (js-call nodes :slice 1))
               (fast-combine
                 (js-array "(await (async (" temporary ") => " body ")(" first "))"))
             (fast-combine (js-array "((" temporary ") => " body ")(" first ")"))))))))

  (defun numeric-operator-tag (operator)
    (cond ((= operator "-") "sub") ((= operator "*") "mul") ((= operator "/") "div")
      ((= operator "%") "rem") ((= operator "&") "and") ((= operator "|") "or")
      ((= operator "^") "xor") ((= operator "<<") "shl") ((= operator ">>") "shr")
      ((= operator ">>>") "ushr") ((= operator "imul") "imul") (t nil)))
  (defun relational-operator-p (operator)
    (or (= operator "<") (= operator "<=") (= operator ">") (= operator ">=")))
  (defvar proven-number-locals undefined)
  (defun with-proven-number-locals (locals function)
    (let ((previous proven-number-locals))
      (setq proven-number-locals locals)
      (try (funcall function)
        (finally (setq proven-number-locals previous)))))
  (defun with-numeric-emission-profile (function)
    (let ((previous numeric-emission-profile))
      (setq numeric-emission-profile t)
      (try (funcall function)
        (finally (setq numeric-emission-profile previous)))))
  (defun proven-number-literal-p (node)
    (and (= (ir-kind node) "literal")
         (= (value-type (aref node "value")) "number")))
  (defun proven-number-expr-p (node &optional proven)
    (let ((set (if (nullish? proven) proven-number-locals proven)))
      (if (nullish? node) false
        (let ((kind (ir-kind node)) (name (ir-value node)) (nodes (children node)))
          (cond
            ((= kind "literal") (= (value-type (aref node "value")) "number"))
            ((= kind "reference") (and (not (undefined? set)) (js-call set :has name)))
            ((= kind "intrinsic")
             (cond
               ((= name "1+") (and (= (js-length nodes) 1)
                                   (proven-number-expr-p (js-nth 0 nodes) set)))
               ((= name "1-") (= (js-length nodes) 1))
               ((= name "+") (and (> (js-length nodes) 0)
                                  (js-call nodes :every
                                    (lambda (child) (proven-number-expr-p child set)))))
               ((js-call (js-array "-" "*" "/" "%" "mod"
                            "bit-and" "bit-or" "bit-xor" "bit-shift-left"
                            "bit-shift-right" "unsigned-bit-shift-right"
                            "&" "|" "^" "<<" ">>" ">>>") :includes name)
                (js-call nodes :some
                  (lambda (child) (proven-number-expr-p child set))))
               (t false)))
            (t false))))))
  (defun contains-assignment-node-p (node)
    (if (nullish? node) false
      (if (= (ir-kind node) "assignment") t
        (js-call (children node) :some
          (lambda (child) (contains-assignment-node-p child))))))
  (defun node-object-p (node)
    (and (not (nullish? node)) (eq (js* "typeof node") "object") (ir-kind node)))
  (defconst fast-proven-number-eligible
    (js* "/* @eliscript-js-host-fastpath */ (body) => { let hasLoop = false; const check = (nodes) => { for (let i = 0, n = nodes.length | 0; i < n; i = (i + 1) | 0) { const node = nodes[i]; if (node !== null && typeof node === 'object') { const k = node.kind; if (!k) continue; if (k === 'function-expression' || k === 'function-declaration' || k === 'variable-declaration' || k === 'await-expression' || k === 'raw-javascript') return false; if (k === 'loop' || k === 'binding-loop') hasLoop = true; const ch = node.children; if (ch !== undefined && ch.length > 0 && !check(ch)) return false; } } return true; }; return check(body) && hasLoop; }"))
  (defun proven-number-nodes-eligible-p (nodes state)
    (let ((i 0) (n (bit-or (aref nodes "length") 0)) (ok t))
      (while (and ok (< i n))
        (let ((node (aref nodes i)))
          (when (and (not (nil? node)) (eq (js* "typeof node") "object"))
            (let ((k (aref node "kind")))
              (when k
                (if (or (eq k "function-expression")
                        (eq k "function-declaration")
                        (eq k "variable-declaration")
                        (eq k "await-expression")
                        (eq k "raw-javascript"))
                    (setq ok false)
                  (progn
                    (when (or (eq k "loop") (eq k "binding-loop"))
                      (put state :hasLoop t))
                    (let ((ch (aref node "children")))
                      (when (and (not (eq ch undefined))
                                 (> (aref ch "length") 0)
                                 (not (proven-number-nodes-eligible-p ch state)))
                        (setq ok false)))))))))
        (setq i (+ i 1)))
      ok))
  (defun proven-number-body-eligible-p (body)
    (if (nil? fast-proven-number-eligible)
        (let ((state (js-object :hasLoop false)))
          (and (proven-number-nodes-eligible-p body state)
               (get state :hasLoop)))
      (funcall fast-proven-number-eligible body)))
  ;; `catch` and `loop` introduce bindings outside `let`/`let*`. Only a plain
  ;; identifier can be tracked here; anything else, or a name already bound by
  ;; a parameter or candidate, disqualifies the whole proof.
  (defun proven-number-shadow-target (binding)
    (if (or (nullish? binding)
            (ir-property binding "pattern")
            (let ((bval (aref binding "value")))
              (not (eq (js* "typeof bval") "string"))))
        nil
      (ir-value binding)))
  (defun proven-number-shadow-name (binding parameters candidates state)
    (let ((name (proven-number-shadow-target binding)))
      (if (or (nullish? name)
              (js-call parameters :has name)
              (js-call candidates :has name))
          (put state :invalid t)
        (js-call parameters :add name))))
  (defun proven-number-collect (nodes parameters candidates state)
    (let ((nidx 0) (nlen (js-length nodes)))
      (while (< nidx nlen)
        (let ((node (js-nth nidx nodes)))
          (when (node-object-p node)
            (let ((kind (ir-kind node)))
              (cond
                ((= kind "function-expression") nil)
                ((= kind "lexical-bindings")
                 (let* ((parts (split-counted-children node "bindingCount"))
                        (bindings (js-nth 0 parts))
                        (bidx 0) (blen (js-length bindings)))
                   (while (< bidx blen)
                     (let* ((binding (js-nth bidx bindings))
                            (name (ir-value binding)))
                       (if (or (not (= (ir-kind binding) "lexical-binding"))
                               (ir-property binding "pattern")
                               (js-call parameters :has name)
                               (js-call candidates :has name))
                           (put state :invalid t)
                         (js-call candidates :set name binding))
                       (let ((initializer (binding-initializer binding)))
                         (when initializer
                           (proven-number-collect
                             (js-array initializer) parameters candidates state))))
                     (setq bidx (1+ bidx)))
                   (proven-number-collect (js-nth 1 parts) parameters candidates state)))
                ((= kind "catch-clause")
                 (proven-number-shadow-name
                   (js-nth 0 (children node)) parameters candidates state)
                 (proven-number-collect
                   (js-call (children node) :slice 1) parameters candidates state))
                ((= kind "binding-loop")
                 (let* ((parts (split-counted-children node "bindingCount"))
                        (bindings (js-nth 0 parts))
                        (bidx 0) (blen (js-length bindings)))
                   (while (< bidx blen)
                     (let ((binding (js-nth bidx bindings)))
                       (proven-number-shadow-name binding parameters candidates state)
                       (let ((initializer (binding-initializer binding)))
                         (when initializer
                           (proven-number-collect
                             (js-array initializer) parameters candidates state))))
                     (setq bidx (1+ bidx)))
                   (proven-number-collect (js-nth 1 parts) parameters candidates state)))
                (t (proven-number-collect (children node) parameters candidates state))))))
        (setq nidx (1+ nidx)))))
  (defun proven-number-scope-valid (nodes scope candidates state)
    (let ((nidx 0) (nlen (js-length nodes)))
      (while (< nidx nlen)
        (let ((node (js-nth nidx nodes)))
          (when (node-object-p node)
            (let ((kind (ir-kind node)) (ch (children node)))
              (cond
                ((= kind "reference")
                 (when (and (js-call candidates :has (ir-value node))
                            (< (js-call scope :indexOf (ir-value node)) 0))
                   (put state :invalid t)))
                ((= kind "lexical-bindings")
                 (let* ((parts (split-counted-children node "bindingCount"))
                        (bindings (js-nth 0 parts))
                        (inner (js-call scope :slice))
                        (bidx 0) (blen (js-length bindings)))
                   (while (< bidx blen)
                     (let ((binding (js-nth bidx bindings)))
                       (js-call inner :push (ir-value binding))
                       (let ((initializer (binding-initializer binding)))
                         (when initializer
                           (proven-number-scope-valid
                             (js-array initializer) scope candidates state))))
                     (setq bidx (1+ bidx)))
                   (proven-number-scope-valid (js-nth 1 parts) inner candidates state)))
                ((= kind "function-expression") nil)
                (t (proven-number-scope-valid ch scope candidates state))))))
        (setq nidx (1+ nidx)))))
  (defun proven-number-assignments-valid-p (nodes candidates proven)
    (let ((valid t)
          (pending (js-call nodes :slice)))
      (while (and valid (> (js-length pending) 0))
        (let ((node (js-call pending :pop)))
          (when (node-object-p node)
            (if (= (ir-kind node) "assignment-pair")
                (progn
                  (let ((name (ir-value node)))
                    (when (js-call candidates :has name)
                      (unless (proven-number-expr-p (js-nth 0 (children node)) proven)
                        (setq valid false))))
                  (when valid
                    (let ((ch (children node)) (ci 0) (clen 0))
                      (setq clen (js-length ch))
                      (while (< ci clen)
                        (js-call pending :push (js-nth ci ch))
                        (setq ci (1+ ci))))))
              (let ((ch (children node)) (ci 0) (clen 0))
                (setq clen (js-length ch))
                (while (< ci clen)
                  (js-call pending :push (js-nth ci ch))
                  (setq ci (1+ ci))))))))
      valid))
  ;; A successful empty Set is different from failed admission (false).
  ;; Constant-derived numeric operands remain provable without local bindings.
  (defun proven-number-locals-for (parameters body)
    (if (not (proven-number-body-eligible-p body)) false
      (let* ((parameter-names (new globalThis.Set
                               (js-call parameters :map (lambda (parameter) (ir-value parameter)))))
             (candidates (new globalThis.Map))
             (state (js-object :invalid false))
             (proven (new globalThis.Set)))
        (proven-number-collect body parameter-names candidates state)
        (when (not (get state :invalid))
          (proven-number-scope-valid body (js-array) candidates state))
        (when (not (get state :invalid))
          (let ((changed t))
            (while changed
              (setq changed false)
              (js-call candidates :forEach
                (lambda (binding name)
                  (unless (js-call proven :has name)
                    (when (proven-number-expr-p (binding-initializer binding) proven)
                      (js-call proven :add name) (setq changed t))))))))
        (if (and (not (get state :invalid))
                 (= (get proven :size) (get candidates :size))
                 (proven-number-assignments-valid-p body candidates proven))
            proven false))))
  (defun emit-numeric-binary (operator left right)
    (if numeric-emission-profile
      (fast-combine (js-array "(" left " " operator " " right ")"))
      ;; A Number literal one has no evaluation effects and subtraction cannot
      ;; return BigInt. A unary helper saves recursive-call argument registers.
      (if (and (= operator "-") (= (get (as-fragment right) :text) "1"))
        (fast-combine (js-array "__eliscript_numeric_decrement(" left ")"))
        (if (relational-operator-p operator)
        (fast-combine (js-array "__eliscript_numeric_relation(" (json-string operator) ", " left ", " right ")"))
        (let ((tag (numeric-operator-tag operator)))
          (if tag (fast-combine (js-array "__eliscript_numeric_" tag "(" left ", " right ")"))
            (fast-combine (js-array "(" left " " operator " " right ")"))))))))
  (defun emit-numeric-unary (tag operand)
    (fast-combine (js-array "__eliscript_numeric_" tag "(" (emit-expression operand) ")")))
  (defun numeric-coercion-intrinsic-p (name)
    (or (numeric-operator-tag name) (relational-operator-p name)
      (= name "mod") (= name "1-") (= name "int32") (= name "uint32") (= name "imul32")
      (= name "bit-not") (= name "bit-and") (= name "bit-or") (= name "bit-xor")
      (= name "bit-shift-left") (= name "bit-shift-right") (= name "unsigned-bit-shift-right")))
  (defun emit-infix (name nodes operator minimum)
    (require-arity name nodes minimum nil)
    ;; Emit every operand under the ambient profile first: only this level may
    ;; drop its own conversions, never an operand that is not itself proved.
    (let ((expressions (js-call nodes :map (lambda (node) (emit-expression node)))))
      (if (and (not numeric-emission-profile) (numeric-operator-tag operator) (> (js-length nodes) 1)
               (not (undefined? proven-number-locals))
               (js-call nodes :every (lambda (node) (proven-number-expr-p node))))
          (fast-combine
            (js-array "("
             (join-fragments expressions (str " " operator " "))
             ")"))
        (if (and (not numeric-emission-profile) (numeric-operator-tag operator) (> (js-length nodes) 1))
          (let ((result (js-nth 0 expressions)) (index 1))
            (while (< index (js-length expressions))
              (setq result (emit-numeric-binary operator result (js-nth index expressions)))
              (setq index (1+ index))) result)
          (fast-combine
            (js-array "("
             (join-fragments expressions (str " " operator " "))
             ")"))))))

  (defun emit-binary-infix (node operator)
    (require-node-arity node 2 2)
    (let* ((nodes (children node))
           (left (emit-expression (js-nth 0 nodes)))
           (right (emit-expression (js-nth 1 nodes))))
      (if (and (not numeric-emission-profile)
               (not (undefined? proven-number-locals))
               (proven-number-expr-p (js-nth 0 nodes))
               (proven-number-expr-p (js-nth 1 nodes)))
          (fast-combine (js-array "(" left " " operator " " right ")"))
        (emit-numeric-binary operator left right))))

  (defun temporary-names (nodes)
    (let ((result (js-array)))
      (js-call nodes :forEach
        (lambda (_node) (js-call result :push (fresh-name))))
      result))

  (defun emit-comparison (name nodes operator)
    (require-arity name nodes 2 nil)
    (if (= (get nodes :length) 2)
        (let ((left (emit-expression (js-nth 0 nodes)))
              (right (emit-expression (js-nth 1 nodes))))
          (if (and (not numeric-emission-profile) (relational-operator-p operator)
                   (not (undefined? proven-number-locals))
                   (proven-number-expr-p (js-nth 0 nodes))
                   (proven-number-expr-p (js-nth 1 nodes))
                   (not (contains-assignment-node-p (js-nth 1 nodes))))
              (fast-combine (js-array "(" left " " operator " " right ")"))
            (emit-numeric-binary operator left right)))
      (let ((parameters (temporary-names nodes))
            (comparisons (js-array))
            (index 0))
        (while (< index (1- (get parameters :length)))
          (js-call comparisons :push
            (if (and (not numeric-emission-profile) (relational-operator-p operator))
              (str "__eliscript_numeric_relation(" (json-string operator) ", " (js-nth index parameters) ", " (js-nth (1+ index) parameters) ")")
              (str (js-nth index parameters) " " operator " " (js-nth (1+ index) parameters))))
          (setq index (1+ index)))
        (fast-combine
          (js-array "(("
           (js-call parameters :join ", ")
           ") => ("
           (js-call comparisons :join " && ")
           "))("
           (emit-arguments nodes)
           ")")))))

  (defun emit-distinct (name nodes)
    (require-arity name nodes 2 nil)
    (let ((parameters (temporary-names nodes))
          (comparisons (js-array))
          (left 0))
      (while (< left (get parameters :length))
        (let ((right (1+ left)))
          (while (< right (get parameters :length))
            (js-call comparisons :push
              (str (js-nth left parameters) " !== " (js-nth right parameters)))
            (setq right (1+ right))))
        (setq left (1+ left)))
      (fast-combine
        (js-array "(("
         (js-call parameters :join ", ")
         ") => ("
         (js-call comparisons :join " && ")
         "))("
         (emit-arguments nodes)
         ")"))))

  (defun emit-intrinsic (node)
    (let ((name (ir-value node))
          (nodes (children node)))
      (cond
        ((= name "not")
         (require-node-arity node 1 1)
         (fast-combine (js-array "(!" (emit-test (js-nth 0 nodes)) ")")))
        ((= name "+")
         (if (= (get nodes :length) 0)
             (emit-text "0")
           (fast-combine
             (js-array "("
              (join-fragments
                (js-call nodes :map (lambda (node) (emit-expression node)))
                " + ")
              ")"))))
        ((= name "*")
         (if (= (get nodes :length) 0)
             (emit-text "1")
           (emit-infix name nodes "*" 1)))
        ((= name "-")
         (require-node-arity node 1 nil)
         (if (= (get nodes :length) 1)
             (if numeric-emission-profile
               (fast-combine (js-array "(-" (emit-expression (js-nth 0 nodes)) ")"))
               (emit-numeric-unary "neg" (js-nth 0 nodes)))
           (emit-infix "-" nodes "-" 2)))
        ((= name "/")
         (require-node-arity node 1 nil)
         (if (= (get nodes :length) 1)
             (emit-numeric-binary "/" (emit-text "1") (emit-expression (js-nth 0 nodes)))
           (emit-infix "/" nodes "/" 2)))
        ((or (= name "%") (= name "mod")) (emit-infix name nodes "%" 2))
        ((= name "int32")
         (require-node-arity node 1 1)
         (if numeric-emission-profile (fast-combine (js-array "(" (emit-expression (js-nth 0 nodes)) " | 0)"))
           (emit-numeric-unary "int32" (js-nth 0 nodes))))
        ((= name "uint32")
         (require-node-arity node 1 1)
         (if numeric-emission-profile (fast-combine (js-array "(" (emit-expression (js-nth 0 nodes)) " >>> 0)"))
           (emit-numeric-unary "uint32" (js-nth 0 nodes))))
        ((= name "imul32")
         (require-node-arity node 2 2)
         (if numeric-emission-profile
           (fast-combine (js-array "Math.imul(" (emit-expression (js-nth 0 nodes)) ", " (emit-expression (js-nth 1 nodes)) ")"))
           (emit-numeric-binary "imul" (emit-expression (js-nth 0 nodes)) (emit-expression (js-nth 1 nodes)))))
        ((= name "bit-and") (emit-binary-infix node "&"))
        ((= name "bit-or") (emit-binary-infix node "|"))
        ((= name "bit-xor") (emit-binary-infix node "^"))
        ((= name "bit-not")
         (require-node-arity node 1 1)
         (if numeric-emission-profile (fast-combine (js-array "(~" (emit-expression (js-nth 0 nodes)) ")"))
           (emit-numeric-unary "not" (js-nth 0 nodes))))
        ((= name "bit-shift-left") (emit-binary-infix node "<<"))
        ((= name "bit-shift-right") (emit-binary-infix node ">>"))
        ((= name "unsigned-bit-shift-right")
         (emit-binary-infix node ">>>"))
        ((= name "value-type")
         (require-node-arity node 1 1)
         (fast-combine (js-array "__eliscript_value_type("
                    (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "host-identity-token")
         (require-node-arity node 1 1)
         (fast-combine
           (js-array "__eliscript_host_identity_token("
            (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "string-code-unit-at")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "(" (emit-expression (js-nth 0 nodes)) ").charCodeAt("
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "string-from-code-unit")
         (require-node-arity node 1 1)
         (fast-combine
           (js-array "String.fromCharCode(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "string-to-number")
         (require-node-arity node 1 1)
         (fast-combine (js-array "__eliscript_to_number(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "string-to-bigint")
         (require-node-arity node 1 1)
         (fast-combine
           (js-array "__eliscript_string_to_bigint("
            (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "number-float64-words")
         (require-node-arity node 1 1)
         (fast-combine
           (js-array "__eliscript_number_float64_words("
            (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "=") (emit-comparison name nodes "==="))
        ((or (= name "/=") (= name "not=")) (emit-distinct name nodes))
        ((= name "<") (emit-comparison name nodes "<"))
        ((= name "<=") (emit-comparison name nodes "<="))
        ((= name ">") (emit-comparison name nodes ">"))
        ((= name ">=") (emit-comparison name nodes ">="))
        ((= name "1+")
         (require-node-arity node 1 1)
         (fast-combine (js-array "(" (emit-expression (js-nth 0 nodes)) " + 1)")))
        ((= name "1-")
         (require-node-arity node 1 1)
         (emit-numeric-binary "-" (emit-expression (js-nth 0 nodes)) (emit-text "1")))
        ((= name "eq")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "(" (emit-expression (js-nth 0 nodes)) " === "
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "equal")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "__eliscript_equal(" (emit-expression (js-nth 0 nodes)) ", "
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "nil?")
         (require-node-arity node 1 1)
         (fast-combine (js-array "(" (emit-expression (js-nth 0 nodes)) " === null)")))
        ((= name "undefined?")
         (require-node-arity node 1 1)
         (fast-combine (js-array "(" (emit-expression (js-nth 0 nodes)) " === undefined)")))
        ((or (= name "null") (= name "nullish?"))
         (require-node-arity node 1 1)
         (fast-combine (js-array "(" (emit-expression (js-nth 0 nodes)) " == null)")))
        ((= name "js-array")
         (fast-combine (js-array "[" (emit-arguments nodes) "]")))
        ((= name "car")
         (require-node-arity node 1 1)
         (fast-combine (js-array "__eliscript_first(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "cdr")
         (require-node-arity node 1 1)
         (fast-combine (js-array "__eliscript_rest(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "cons")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "__eliscript_cons(" (emit-expression (js-nth 0 nodes)) ", "
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "__eliscript_array_build")
         (require-node-arity node 2 2)
         (fast-combine (js-array
           "__eliscript_array_build("
           (emit-expression (js-nth 0 nodes)) ", " (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "__eliscript_array_copy_assoc")
         (require-node-arity node 4 4)
         (fast-combine (js-array
           "__eliscript_array_copy_assoc("
           (emit-expression (js-nth 0 nodes)) ", " (emit-expression (js-nth 1 nodes)) ", "
           (emit-expression (js-nth 2 nodes)) ", " (emit-expression (js-nth 3 nodes)) ")")))
        ((= name "js-cons")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "[" (emit-expression (js-nth 0 nodes)) ", ...(("
            (emit-expression (js-nth 1 nodes)) ") ?? [])]")))
        ((= name "nth")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "__eliscript_nth(" (emit-expression (js-nth 1 nodes)) ", "
            (emit-expression (js-nth 0 nodes)) ", null)")))
        ((= name "js-nth")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "((((" (emit-expression (js-nth 1 nodes)) ") ?? [])["
            (emit-expression (js-nth 0 nodes)) "]) ?? null)")))
        ((= name "aref")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "(" (emit-expression (js-nth 0 nodes)) ")["
            (emit-property-key (js-nth 1 nodes)) "]")))
        ((= name "length")
         (require-node-arity node 1 1)
         (fast-combine (js-array "__eliscript_count(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "js-length")
         (require-node-arity node 1 1)
         (fast-combine (js-array "((" (emit-expression (js-nth 0 nodes)) ") ?? []).length")))
        ((= name "__eliscript_arity_error")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array
             "__eliscript_arity_error("
             (emit-expression (js-nth 0 nodes)) ", "
             (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "object-keys")
         (require-node-arity node 1 1)
         (fast-combine (js-array "Object.keys((" (emit-expression (js-nth 0 nodes)) ") ?? {})")))
        ((= name "object-has?")
         (require-node-arity node 2 2)
         (fast-combine
           (js-array "Object.prototype.hasOwnProperty.call(("
            (emit-expression (js-nth 0 nodes)) ") ?? {}, "
            (emit-property-key (js-nth 1 nodes)) ")")))
        ((= name "object-assoc")
         (require-node-arity node 3 3)
         (fast-combine
           (js-array "({...((" (emit-expression (js-nth 0 nodes)) ") ?? {}), ["
            (emit-property-key (js-nth 1 nodes)) "]: "
            (emit-expression (js-nth 2 nodes)) "})")))
        (t (fail (str "unknown IR intrinsic: " name))))))

  (defun emit-object-properties (properties)
    (let ((result (js-array)))
      (js-call properties :forEach
        (lambda (property)
          (let ((nodes (children property)))
            (js-call result :push
              (native-locate
                (ir-span property)
                (if (ir-property property "computed")
                    (fast-combine
                      (js-array "[" (emit-expression (js-nth 0 nodes)) "]: "
                       (emit-expression (js-nth 1 nodes))))
                  (fast-combine
                    (js-array (json-string (ir-value property)) ": "
                     (emit-expression (js-nth 0 nodes))))))))))
      (join-fragments result ", ")))

  (defun emit-object (node)
    (fast-combine (js-array "({" (emit-object-properties (children node)) "})")))

  (defun literal-kind (node)
    (ir-property node "literalKind"))

  (defun emit-literal (node)
    (let ((value (ir-value node))
          (kind (literal-kind node)))
      (cond
        ((= kind "undefined") (emit-text "undefined"))
        ((= kind "keyword")
         (fast-combine
           (js-array "__eliscript_keyword(" (json-string value) ")")))
        ((null value) (emit-text "null"))
        ((eq value t) (emit-text "true"))
        ((eq value false) (emit-text "false"))
        ((= (value-type value) "number")
         (unless (Number/isFinite value)
           (fail (str "non-finite numbers are not supported: " value)))
         (emit-text (if (and (= value 0) (< (/ 1 value) 0)) "-0.0" (str value))))
        ((= (value-type value) "string")
         (emit-text (json-string value)))
        (t (fail (str "unsupported IR literal: " value))))))

  (defun datum-kind (value)
    (and value
         (= (value-type value) "object")
         (get value :kind)))

  (defun emit-quoted (value)
    (let ((kind (datum-kind value)))
      (cond
        ((null value) (emit-text "__eliscript_list()"))
        ((eq value t) (emit-text "true"))
        ((eq value false)
         (emit-text "__eliscript_symbol(\"false\")"))
        ((= (value-type value) "number")
         (emit-text (if (and (= value 0) (< (/ 1 value) 0)) "-0.0" (str value))))
        ((= (value-type value) "string")
         (emit-text (json-string value)))
        ((= kind "undefined") (emit-text "undefined"))
        ((= kind "symbol")
         (fast-combine
           (js-array "__eliscript_symbol("
            (emit-text (json-string (get value :name))) ")")))
        ((= kind "keyword")
         (fast-combine
           (js-array "__eliscript_keyword("
            (emit-text (json-string (get value :name))) ")")))
        ((= kind "list")
         (fast-combine
           (js-array "__eliscript_list("
            (join-fragments
              (js-call (get value :items) :map
                (lambda (item) (emit-quoted item)))
              ", ")
            ")")))
        ((= kind "vector")
         (fast-combine
           (js-array "__eliscript_vector("
            (join-fragments
              (js-call (get value :items) :map
                (lambda (item) (emit-quoted item)))
              ", ")
            ")")))
        (t (fail "cannot emit quoted IR datum")))))

  (defun quoted-uses-literal-runtime-p (value)
    (let ((kind (datum-kind value)))
      (or (null value)
          (= value false)
          (= kind "symbol")
          (= kind "keyword")
          (= kind "list")
          (= kind "vector"))))

  (defun emit-property-key (node)
    (native-locate
      (ir-span node)
      (if (and (= (ir-kind node) "literal")
               (or (= (literal-kind node) "keyword")
                   (= (value-type (aref node "value")) "string")))
          (emit-text (json-string (ir-value node)))
        (emit-expression node))))

  (defun array-text-key-p (node)
    (or (not (= (ir-kind node) "literal"))
        (= (ir-value node) "join") (= (ir-value node) "toString")
        (= (ir-value node) "call") (= (ir-value node) "apply") (= (ir-value node) "bind")))

  (defun primitive-literal-arguments-p (nodes)
    (js-call nodes :every
      (lambda (node)
        (and (= (ir-kind node) "literal")
             (not (= (literal-kind node) "keyword"))))))

  (defconst primitive-arrow-pattern
    (new globalThis.RegExp "^[ \\t]*\\([ \\t]*a[ \\t]*,[ \\t]*b[ \\t]*\\)[ \\t]*=>[ \\t]*a[ \\t]*([+*/%<>=!&|^-]+)[ \\t]*b[ \\t]*$"))
  (defconst primitive-instanceof-pattern
    (new globalThis.RegExp "^[ \\t]*\\([ \\t]*a[ \\t]*,[ \\t]*b[ \\t]*\\)[ \\t]*=>[ \\t]*a[ \\t]+instanceof[ \\t]+b[ \\t]*$"))
  (defconst primitive-binary-operators
    (js-array "+" "-" "*" "/" "%" "<" ">" "<=" ">="
              "==" "!=" "===" "!==" "&" "|" "^" "<<" ">>" ">>>"))
  (defun raw-binary-operator (source)
    (when (and (= (value-type source) "string")
               (not (js-call source :includes "\n")) (not (js-call source :includes "\r")))
      (let ((matched (js-call primitive-arrow-pattern :exec source)))
        (if matched
          (when (js-call primitive-binary-operators :includes (aref matched 1)) (aref matched 1))
          (when (js-call primitive-instanceof-pattern :test source) "instanceof")))))
  (defun primitive-operand-p (node)
    (let ((pending (js-array node)) (safe t))
      (while (and safe (> (js-length pending) 0))
        (let* ((item (js-call pending :pop)) (kind (ir-kind item)))
          (cond
            ((or (= kind "literal") (= kind "reference")) nil)
            ((or (= kind "property-read")
                 (and (= kind "intrinsic")
                      (js-call (js-array "aref" "js-length") :includes (ir-value item))))
             (js-call (children item) :forEach (lambda (child) (js-call pending :push child))))
            (t (setq safe false))))) safe))
  (defun primitive-invocation-operator (nodes &optional unguarded)
    (let* ((callee (aref nodes 0)) (members (when callee (children callee)))
           (operator (when (and (= (js-length nodes) 3) (= (ir-kind callee) "raw-javascript")
                                (= (js-length members) 1) (= (ir-kind (aref members 0)) "literal"))
                       (raw-binary-operator (ir-value (aref members 0))))))
      (when (and operator (js-call (js-call nodes :slice 1) :every primitive-operand-p))
        (let ((safe t) (pending (if (and unguarded tdz-state) (js-call nodes :slice 1) (js-array))))
          ;; A guarded operand stays opaque to scope merging. Emission still
          ;; reduces the primitive while retaining its original read guard.
          (while (and safe (> (js-length pending) 0))
            (let ((node (js-call pending :pop)))
              (if (js-call (get tdz-state :reads) :has node) (setq safe false)
                (js-call (children node) :forEach (lambda (child) (js-call pending :push child))))))
          (when safe operator)))))
  (defconst primitive-comparisons (js-array "<" ">" "<=" ">=" "==" "!=" "===" "!==" "instanceof"))
  (defun primitive-boolean-expression-p (node)
    (let ((pending (js-array node)) (safe t) (seen false))
      (while (and safe (> (js-length pending) 0))
        (let* ((item (js-call pending :pop)) (kind (ir-kind item)) (nodes (children item)))
          (cond
            ((= kind "invoke")
             (if (js-call primitive-comparisons :includes (primitive-invocation-operator nodes))
               (setq seen t) (setq safe false)))
            ((= kind "conditional")
             (if (= (js-length nodes) 3)
               (js-call pending :push (aref nodes 1) (aref nodes 2)) (setq safe false)))
            ((= kind "short-circuit")
             (if (> (js-length nodes) 0)
               (js-call nodes :forEach (lambda (child) (js-call pending :push child))) (setq safe false)))
            ((not (boolean-p item)) (setq safe false)))))
      (and safe seen)))
  (defconst method-wrapper-pattern
    (new globalThis.RegExp "^\\(fn\\) => \\(\\{ ([A-Za-z_$][A-Za-z0-9_$]*)\\(([^()]*)\\) \\{ return fn\\(([^()]*)\\); \\} \\}\\)\\.([A-Za-z_$][A-Za-z0-9_$]*)$"))
  (defconst getter-wrapper-pattern
    (new globalThis.RegExp "^\\(fn\\) => Object\\.getOwnPropertyDescriptor\\(\\{ get ([A-Za-z_$][A-Za-z0-9_$]*)\\(\\) \\{ return fn\\(this\\); \\} \\}, '([A-Za-z_$][A-Za-z0-9_$]*)'\\)\\.get$"))
  (defconst method-formal-pattern
    (new globalThis.RegExp "^([A-Za-z_$][A-Za-z0-9_$]*)( = undefined)?$"))
  (defun method-formal-name-p (name)
    (and (not (js-call (js-array "fn" "undefined" "nil" "t" "false") :includes name))
         (not (js-call name :startsWith "__eliscript_")) (= name (binding-name name))))
  (defun raw-method-wrapper (source)
    (when (and (= (value-type source) "string")
               (not (js-call source :includes "\n")) (not (js-call source :includes "\r")))
      (let ((matched (js-call method-wrapper-pattern :exec source)))
        (if matched
          (let* ((name (aref matched 1)) (formal-text (aref matched 2))
                 (call (aref matched 3)) (result (aref matched 4))
                 (formals (if (= formal-text "") (js-array) (js-call formal-text :split ", ")))
                 (names (js-array)) (defaults (js-array)) (safe (= name result)) (index 0))
            (while (< index (js-length formals))
              (let ((formal (js-call method-formal-pattern :exec (aref formals index))))
                (if formal
                  (progn (js-call names :push (aref formal 1))
                    (js-call defaults :push (not (undefined? (aref formal 2)))))
                  (setq safe false)))
              (setq index (1+ index)))
            (when (and safe (js-call names :every method-formal-name-p)
                       (= (js-length names) (get (new globalThis.Set names) :size)))
              (cond
                ((= call (js-call (js-call (js-array "this") :concat names) :join ", "))
                 (js-object :name name :receiver t :defaults defaults))
                ((= call (js-call names :join ", "))
                 (js-object :name name :receiver false :defaults defaults)))))
          (let ((getter (js-call getter-wrapper-pattern :exec source)))
            (when (and getter (= (aref getter 1) (aref getter 2)))
              (js-object :name (aref getter 1) :getter t :receiver t :defaults (js-array))))))))
  (defun method-callback-safe-p (body)
    (let ((pending (js-call body :slice)) (safe t))
      (while (and safe (> (js-length pending) 0))
        (let* ((node (js-call pending :pop)) (kind (ir-kind node)) (nodes (children node)))
          (cond
            ((and (js-call (js-array "reference" "assignment-pair") :includes kind)
                  (= (aref (js-call (reference-name (ir-value node)) :split ".") 0) "arguments"))
             (setq safe false))
            ((js-call (js-array "function-declaration" "variable-declaration" "import-declaration" "export-declaration") :includes kind)
             (setq safe false))
            ((= kind "raw-javascript")
             (unless (and (= (js-length nodes) 1) (= (ir-kind (aref nodes 0)) "literal")
                          (raw-binary-operator (ir-value (aref nodes 0))))
               (setq safe false))))
          (js-call nodes :forEach (lambda (child) (js-call pending :push child))))) safe))
  (defun emit-method-wrapper (nodes)
    (when (= (js-length nodes) 2)
      (let* ((callee (aref nodes 0)) (callback (aref nodes 1)) (members (children callee))
             (spec (when (and (= (ir-kind callee) "raw-javascript") (= (js-length members) 1)
                              (= (ir-kind (aref members 0)) "literal"))
                     (raw-method-wrapper (ir-value (aref members 0))))))
        (when (and spec (= (ir-kind callback) "function-expression") (not (ir-property callback "async")))
          (let* ((parts (split-counted-children callback "parameterCount"))
                 (parameters (aref parts 0)) (body (aref parts 1))
                 (receiver (get spec :receiver)) (defaults (get spec :defaults)))
            (when (and (= (js-length parameters) (+ (js-length defaults) (if receiver 1 0)))
                       (js-call parameters :every (lambda (parameter)
                         (and (= (ir-property parameter "parameterKind") "required")
                              (not (ir-property parameter "pattern")))))
                       (method-callback-safe-p body))
              (let ((names (js-call parameters :map (lambda (parameter) (binding-name (ir-value parameter))))))
                (when (= (js-length names) (get (new globalThis.Set names) :size))
                  (let* ((formals (if receiver (js-call names :slice 1) names))
                         (signature (js-call formals :map (lambda (name index)
                                      (str name (if (aref defaults index) " = undefined" "")))))
                         (method (native-locate (ir-span callback)
                           (fast-combine (js-array (if (get spec :getter) "get " "") (get spec :name) "("
                             (js-call signature :join ", ") ") {\n"
                             (emit-indent (fast-combine (js-array
                               (if receiver (str "let " (aref names 0) " = this;\n") "")
                               (emit-function-body parameters body)))) "\n}"))))
                         (profiled (function-source-fragment callback method 0 (js-length (get method :text)))))
                    (if (get spec :getter)
                      (fast-combine (js-array "(0, Object.getOwnPropertyDescriptor({" profiled "}, '" (get spec :name) "').get)"))
                      (fast-combine (js-array "(0, ({" profiled "})." (get spec :name) ")"))))))))))))

  (defun emit-primitive-invocation (nodes)
    (let ((operator (primitive-invocation-operator nodes)))
      (when operator
        (fast-combine (js-array "((" (emit-expression (aref nodes 1)) ") " operator " ("
                           (emit-expression (aref nodes 2)) "))")))))

  (defun emit-expression (node)
    (unless (node-p node)
      (fail "expected an IR expression node"))
    (let ((kind (ir-kind node))
          (nodes (children node)))
      (native-locate
        (ir-span node)
        (cond
          ((eq kind "reference") (tdz-read node))
          ((eq kind "literal") (emit-literal node))
          ((eq kind "invoke")
           (or (emit-method-wrapper nodes)
             (emit-primitive-invocation nodes)
             (fast-combine
               (js-array (emit-callee (js-nth 0 nodes)) "("
                (emit-arguments (js-call nodes :slice 1)) ")"))))
          ((eq kind "intrinsic") (emit-intrinsic node))
          ((eq kind "method-call")
           (let* ((arguments (js-call nodes :slice 2))
                  (array-text (array-text-key-p (js-nth 1 nodes)))
                  (direct (and array-text (primitive-literal-arguments-p arguments))))
             (fast-combine
               (js-array (if direct "__eliscript_at_direct(" (if array-text "__eliscript_at(" "("))
                 (emit-expression (js-nth 0 nodes)) (if array-text ", " ")[")
                 (emit-property-key (js-nth 1 nodes))
                 (if direct (if (> (get arguments :length) 0) ", " "") (if array-text ")(" "]("))
                 (emit-arguments arguments) ")"))))
          ((eq kind "property-read")
           (let ((access
                  (fast-combine
                    (js-array "(" (emit-expression (js-nth 0 nodes)) ")["
                     (emit-property-key (js-nth 1 nodes)) "]"))))
             (if (= (get nodes :length) 3)
                 (fast-combine (js-array "(" access " ?? " (emit-expression (js-nth 2 nodes)) ")"))
               access)))
          ((eq kind "lexical-bindings") (emit-let node))
          ((eq kind "conditional") (emit-if nodes))
          ((eq kind "call")
           (fast-combine
             (js-array (emit-callee (js-nth 0 nodes)) "("
              (emit-arguments (js-call nodes :slice 1)) ")")))
          ((eq kind "sequence") (emit-do nodes))
          ((eq kind "assignment") (emit-assignment node))
          ((eq kind "short-circuit") (emit-short-circuit nodes (ir-value node)))
          ((eq kind "conditional-sugar") (emit-conditional-sugar node))
          ((eq kind "conditional-chain") (emit-cond nodes))
          ((eq kind "function-expression") (emit-function node))
          ((eq kind "object-literal") (emit-object node))
          ((eq kind "property-write")
           (fast-combine
             (js-array "((" (emit-expression (js-nth 0 nodes)) ")["
              (emit-property-key (js-nth 1 nodes)) "] = "
              (emit-expression (js-nth 2 nodes)) ")")))
          ((eq kind "array-literal") (fast-combine (js-array "[" (emit-arguments nodes) "]")))
          ((eq kind "constructor-call")
           (fast-combine
             (js-array "new (" (emit-expression (js-nth 0 nodes))
              ")(" (emit-arguments (js-call nodes :slice 1)) ")")))
          ((eq kind "loop") (emit-loop node))
          ((eq kind "binding-loop") (emit-binding-loop node))
          ((eq kind "quoted-literal") (emit-quoted (ir-value node)))
          ((eq kind "await-expression")
           (fast-combine (js-array "await (" (emit-expression (js-nth 0 nodes)) ")")))
          ((eq kind "throw-expression") (emit-throw node))
          ((eq kind "try-expression") (emit-try node))
          ((eq kind "raw-javascript")
           ;; The raw form is exactly one string. Accepting several arguments
           ;; emitted only the first, so the module's braces did not close and
           ;; the JavaScript was not what the source said. The reference
           ;; implementation reports this at emission, so this one does too.
           (require-arity "js*" nodes 1 1)
           (unless (= (ir-kind (js-nth 0 nodes)) "literal")
             (fail "js* expects a string literal"))
           (emit-text (ir-value (js-nth 0 nodes))))
          ((eq kind "string-concat")
           (if (= (get nodes :length) 0)
               (emit-text "\"\"")
             (let ((parts (js-array)))
               (js-call nodes :forEach
                 (lambda (child)
                   (js-call parts :push
                     (fast-combine (js-array "String(" (emit-expression child) ")")))))
               (fast-combine (js-array "(" (join-fragments parts " + ") ")")))))
          ((eq kind "apply-call")
           (require-arity "apply" nodes 2 nil)
           (let ((fixed (js-call nodes :slice 1 -1))
                 (tail (aref nodes (1- (js-length nodes)))))
             (fast-combine
               (js-array (emit-callee (js-nth 0 nodes)) "("
                 (if (> (js-length fixed) 0)
                     (fast-combine (js-array (emit-arguments fixed) ", ")) "")
                 "...(" (emit-expression tail) " ?? []))"))))
          ((eq kind "persistent-list-literal")
           (fast-combine (js-array "__eliscript_list(" (emit-arguments nodes) ")")))
          ((eq kind "persistent-vector-literal")
           (fast-combine (js-array "__eliscript_vector(" (emit-arguments nodes) ")")))
          ((eq kind "persistent-map-literal")
           (fast-combine (js-array "__eliscript_hash_map(" (emit-arguments nodes) ")")))
          ((eq kind "persistent-set-literal")
           (fast-combine (js-array "__eliscript_hash_set(" (emit-arguments nodes) ")")))
          ((eq kind "persistent-queue-literal")
           (fast-combine (js-array "__eliscript_queue(" (emit-arguments nodes) ")")))
          ((eq kind "print") (fast-combine (js-array "console.log(" (emit-arguments nodes) ")")))
          ((eq kind "recur")
           (fail "recur is only valid in an analyzed tail position"))
          (t (fail (str "IR node is not valid in expression position: " kind)))))))

  (defun emit-import (node)
    (let ((default-binding nil)
          (namespace-binding nil)
          (named-bindings (js-array)))
      (js-call (children node) :forEach
        (lambda (specifier)
          (let ((name (emit-binding-name specifier))
                (kind (ir-kind specifier)))
            (cond
              ((= kind "import-default") (setq default-binding name))
              ((= kind "import-namespace") (setq namespace-binding name))
              ((= kind "import-named") (js-call named-bindings :push name))
              (t (fail (str "invalid IR import specifier: " kind)))))))
      (when (and namespace-binding (> (get named-bindings :length) 0))
        (fail "namespace and named imports cannot be combined"))
      (let ((clauses (js-array)))
        (when default-binding (js-call clauses :push default-binding))
        (when namespace-binding
          (js-call clauses :push (fast-combine (js-array "* as " namespace-binding))))
        (when (> (get named-bindings :length) 0)
          (js-call clauses :push
            (fast-combine (js-array "{" (join-fragments named-bindings ", ") "}"))))
        (if (= (get clauses :length) 0)
            (emit-text (str "import " (json-string (ir-value node)) ";"))
          (fast-combine
            (js-array "import " (join-fragments clauses ", ") " from "
             (json-string (ir-value node)) ";"))))))

  (defun emit-top-level (node)
    (unless (node-p node)
      (fail "expected a top-level IR node"))
    (let ((kind (ir-kind node))
          (nodes (children node)))
      (native-locate
        (ir-span node)
        (cond
          ((= kind "module-declaration")
           (join-fragments
             (js-call nodes :map (lambda (child) (emit-top-level child)))
             "\n"))
          ((= kind "import-declaration") (emit-import node))
          ((= kind "variable-declaration")
           (fast-combine
             (js-array (if (ir-property node "mutable") "let " "const ")
              (binding-name (ir-value node))
              " = "
              (if (> (get nodes :length) 0)
                  (emit-expression (js-nth 0 nodes))
                "null")
              ";"
              (let ((record (and tdz-state (js-call (get tdz-state :declarations) :get node))))
                (if (tdz-guarded-p record) (str "\n" (tdz-ready-name record) " = true;") "")))))
          ((= kind "function-declaration")
           (let* ((parts (split-counted-children node "parameterCount"))
                  (parameters (js-nth 0 parts))
                  (body (js-nth 1 parts)))
             (let ((fragment (fast-combine
               (js-array (if (ir-property node "async") "async " "")
                "function " (binding-name (ir-value node)) "("
                (join-fragments
                  (js-call parameters :map
                    (lambda (parameter) (emit-parameter parameter)))
                  ", ")
                ") {\n"
                  (emit-indent (emit-function-body parameters body))
                "\n}"))))
               (function-source-fragment node fragment 0 (js-length (get fragment :text))))))
          ((= kind "export-declaration")
           (fast-combine
             (js-array "export {"
              (join-fragments
                (js-call nodes :map
                  (lambda (reference) (emit-binding-name reference)))
                ", ")
              "};")))
          ((= kind "export-default")
           (fast-combine (js-array "export default " (emit-expression (js-nth 0 nodes)) ";")))
          ((= kind "expression-statement")
           (fast-combine (js-array (emit-expression (js-nth 0 nodes)) ";")))
          (t (fail (str "IR node is not valid at module top level: " kind)))))))

  (defun node-uses-number-conversion-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (= (ir-value node) "string-to-number"))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-number-conversion-p child)
              (setq found t))))
        found)))

  (defun node-uses-host-identity-token-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (= (ir-value node) "host-identity-token"))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-host-identity-token-p child)
              (setq found t))))
        found)))

  (defun node-directly-uses-literal-runtime-p (node)
    (let ((kind (ir-kind node)))
      (or (= kind "persistent-list-literal")
          (= kind "persistent-vector-literal")
          (= kind "persistent-map-literal")
          (= kind "persistent-set-literal")
          (= kind "persistent-queue-literal")
          (and (= kind "quoted-literal")
               (quoted-uses-literal-runtime-p (ir-value node)))
          (and (= kind "literal")
               (= (literal-kind node) "keyword")))))

  (defun literal-runtime-static-key-index (node)
    (let ((kind (ir-kind node)))
      (cond
        ((or (= kind "property-read")
             (= kind "property-write")
             (= kind "method-call")) 1)
        ((and (= kind "intrinsic")
              (or (= (ir-value node) "aref")
                  (= (ir-value node) "object-has?")
                  (= (ir-value node) "object-assoc"))) 1)
        (t nil))))

  (defun node-uses-literal-runtime-p (node)
    (let ((nodes (children node)))
      (cond
        ((node-directly-uses-literal-runtime-p node) t)
        (t
         (children-use-literal-runtime-p
           nodes (literal-runtime-static-key-index node))))))

  (defun children-use-literal-runtime-p (nodes static-key-index)
    (let ((found false)
          (index 0))
      (while (< index (get nodes :length))
        (let ((child (js-nth index nodes)))
          (unless (and static-key-index
                       (= index static-key-index)
                       (= (ir-kind child) "literal")
                       (= (literal-kind child) "keyword"))
            (when (node-uses-literal-runtime-p child)
              (setq found t))))
        (setq index (1+ index)))
      found))

  (defun node-uses-collection-runtime-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (or (= (ir-value node) "nth") (= (ir-value node) "length")))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-collection-runtime-p child)
              (setq found t))))
        found)))

  (defun node-uses-binding-runtime-p (node)
    (if (= (ir-kind node) "map-binding-pattern")
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-binding-runtime-p child)
              (setq found t))))
        found)))

  (defun node-uses-list-runtime-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (or (= (ir-value node) "car")
                 (= (ir-value node) "cdr")
                 (= (ir-value node) "cons")))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-list-runtime-p child)
              (setq found t))))
        found)))

  (defun node-uses-value-runtime-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (= (ir-value node) "equal"))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-value-runtime-p child)
              (setq found t))))
        found)))

  (defun program-uses-number-conversion-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-number-conversion-p node)
            (setq found t))))
      found))

  (defun program-uses-host-identity-token-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-host-identity-token-p node)
            (setq found t))))
      found))

  (defun program-uses-literal-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-literal-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-collection-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-collection-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-binding-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-binding-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-list-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-list-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-value-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-value-runtime-p node)
            (setq found t))))
      found))

  (defun node-uses-array-text-p (node)
    (let ((found (or (and (= (ir-kind node) "method-call")
                         (array-text-key-p (js-nth 1 (children node))))
                    (and (js-call (js-array "call" "invoke" "apply-call") :includes (ir-kind node))
                         (qualified-apply-reference-p (js-nth 0 (children node)))))))
      (js-call (children node) :forEach
        (lambda (child) (when (node-uses-array-text-p child) (setq found t)))) found))

  (defun node-uses-value-type-p (node)
    (or (and (= (ir-kind node) "intrinsic") (= (ir-value node) "value-type"))
        (js-call (children node) :some node-uses-value-type-p)))

  (defun node-uses-primitive-runtime-p (node)
    (or (and (= (ir-kind node) "intrinsic")
             (js-call (js-array "string-to-bigint" "number-float64-words" "__eliscript_array_build" "__eliscript_array_copy_assoc" "__eliscript_arity_error") :includes (ir-value node)))
        (js-call (children node) :some node-uses-primitive-runtime-p)))

  (defun reference-runtime-requirements (program)
    (js-object
      :math (js-call (program-body program) :some node-uses-math-runtime-p)
      :numericCoercion (program-uses-numeric-coercion-p program)
      :imul (js-call (program-body program) :some node-uses-imul-p)
      :arrayText (js-call (program-body program) :some node-uses-array-text-p)
      :numberConversion (program-uses-number-conversion-p program)
      :hostIdentityToken (program-uses-host-identity-token-p program)
      :valueType (js-call (program-body program) :some node-uses-value-type-p)
      :primitiveRuntime (js-call (program-body program) :some node-uses-primitive-runtime-p)
      :literal (program-uses-literal-runtime-p program)
      :collection (program-uses-collection-runtime-p program)
      :binding (program-uses-binding-runtime-p program)
      :list (program-uses-list-runtime-p program)
      :value (program-uses-value-runtime-p program)))

  (defun math-runtime-reference-p (value)
    (and (eq (js* "typeof value") "string")
      (> (aref value "length") 0)
      (let ((c0 (js-call value :charCodeAt 0)))
        (if (eq c0 77)
            (or (= value "Math")
                (js-call value :startsWith "Math/")
                (js-call value :startsWith "Math."))
          (if (eq c0 103)
              (or (= value "globalThis/Math")
                  (= value "globalThis.Math")
                  (js-call value :startsWith "globalThis/Math/")
                  (js-call value :startsWith "globalThis/Math.")
                  (js-call value :startsWith "globalThis.Math/")
                  (js-call value :startsWith "globalThis.Math."))
            false)))))
  (defun node-uses-math-runtime-p (node)
    (let ((k (ir-kind node)))
      (or (and (or (= k "reference") (= k "raw-javascript"))
               (math-runtime-reference-p (ir-value node)))
          (js-call (children node) :some node-uses-math-runtime-p))))

  (defun node-uses-imul-p (node)
    (or (and (= (ir-kind node) "intrinsic") (= (ir-value node) "imul32"))
        (js-call (children node) :some node-uses-imul-p)))

  (defun node-uses-numeric-coercion-p (node)
    (or (and (= (ir-kind node) "intrinsic") (numeric-coercion-intrinsic-p (ir-value node))
             (or (not (= (ir-value node) "*")) (> (js-length (children node)) 1)))
      (let ((found false))
        (js-call (children node) :forEach (lambda (child) (when (node-uses-numeric-coercion-p child) (setq found t)))) found)))
  (defun program-uses-numeric-coercion-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach (lambda (node) (when (node-uses-numeric-coercion-p node) (setq found t)))) found))

  (defun static-literal-key-p (node index static-key-index)
    (and static-key-index
         (eq index static-key-index)
         (eq (ir-kind node) "literal")
         (eq (literal-kind node) "keyword")))

  (defun collect-runtime-requirements
      (node requirements suppress-literal)
    (let ((kind (ir-kind node))
          (value (ir-value node))
          (nodes (children node))
          (static-key-index nil)
          (raw-nlen 0)
          (index 0)
          (nlen 0)
          (child nil))
      (setq raw-nlen (aref nodes "length"))
      (setq nlen (p| raw-nlen 0))
      (when (or (eq kind "property-read") (eq kind "property-write") (eq kind "method-call"))
        (setq static-key-index 1))
      (cond
        ((or (eq kind "reference") (eq kind "raw-javascript"))
         (when (math-runtime-reference-p value)
           (put requirements :math t)))
        ((eq kind "method-call")
         (when (array-text-key-p (aref nodes 1))
           (put requirements :arrayText t)))
        ((or (eq kind "call") (eq kind "invoke") (eq kind "apply-call"))
         (when (qualified-apply-reference-p (aref nodes 0))
           (put requirements :arrayText t)))
        ((eq kind "map-binding-pattern")
         (put requirements :binding t))
        ((and (not suppress-literal) (eq kind "literal"))
         (when (eq (literal-kind node) "keyword")
           (put requirements :literal t)))
        ((and (not suppress-literal) (eq kind "quoted-literal"))
         (when (quoted-uses-literal-runtime-p value)
           (put requirements :literal t)))
        ((and (not suppress-literal)
              (or (eq kind "persistent-list-literal")
                  (eq kind "persistent-vector-literal")
                  (eq kind "persistent-map-literal")
                  (eq kind "persistent-set-literal")
                  (eq kind "persistent-queue-literal")))
         (put requirements :literal t))
        ((eq kind "intrinsic")
         (when (or (eq value "aref") (eq value "object-has?") (eq value "object-assoc"))
           (setq static-key-index 1))
         (when (eq value "imul32") (put requirements :imul t))
         (when (and (numeric-coercion-intrinsic-p value)
                    (or (not (eq value "*")) (p> nlen 1)))
           (put requirements :numericCoercion t))
         (cond
           ((eq value "string-to-number") (put requirements :numberConversion t))
           ((eq value "value-type") (put requirements :valueType t))
           ((or (eq value "string-to-bigint")
                (eq value "number-float64-words")
                (eq value "__eliscript_array_build")
                (eq value "__eliscript_array_copy_assoc")
                (eq value "__eliscript_arity_error"))
            (put requirements :primitiveRuntime t))
           ((eq value "host-identity-token")
            (put requirements :hostIdentityToken t))
           ((or (eq value "nth") (eq value "length"))
            (put requirements :collection t))
           ((or (eq value "car") (eq value "cdr") (eq value "cons"))
            (put requirements :list t))
           ((eq value "equal")
            (put requirements :value t)))))
      (while (p< index nlen)
        (setq child (aref nodes index))
        (collect-runtime-requirements
          child
          requirements
          (or suppress-literal
              (and (eq static-key-index 1)
                   (eq index 1)
                   (eq (ir-kind child) "literal")
                   (eq (literal-kind child) "keyword"))))
        (setq index (p| (+ index 1) 0))))
    requirements)

  (defun runtime-requirements (program)
    (let ((requirements
           (js-object
             :math false
             :numericCoercion false
             :imul false
             :arrayText false
             :numberConversion false
             :hostIdentityToken false
             :valueType false
             :primitiveRuntime false
             :literal false
             :collection false
             :binding false
             :list false
             :value false)))
      (js-call (program-body program) :forEach
        (lambda (node)
          (collect-runtime-requirements node requirements false)))
      requirements))

  (defun collect-portable-metadata (node portable exported)
    (let ((kind (ir-kind node)))
      (cond
        ((eq kind "function-declaration")
         (when (ir-property node "portable")
           (js-call portable :push node)))
        ((eq kind "export-declaration")
         (let ((ch (children node)) (idx 0) (len 0))
           (setq len (aref ch "length"))
           (while (< idx len)
             (js-call exported :push (ir-value (aref ch idx)))
             (setq idx (+ idx 1)))))
        ((eq kind "module-declaration")
         (let ((ch (children node)) (idx 0) (len 0))
           (setq len (aref ch "length"))
           (while (< idx len)
             (collect-portable-metadata (aref ch idx) portable exported)
             (setq idx (+ idx 1))))))))

  (defun emit-portable-manifest (program)
    (let ((portable (js-array))
          (exported (js-array)))
      (js-call (program-body program) :forEach
        (lambda (node)
          (collect-portable-metadata node portable exported)))
      (if (= (get portable :length) 0)
          (emit-text "")
        (let ((implicit
               (js-call portable :filter
                 (lambda (node)
                   (not (js-call exported :includes (ir-value node)))))))
          (fast-combine
            (js-array (if (> (get implicit :length) 0)
                 (fast-combine
                   (js-array "\n\nexport {"
                    (join-fragments
                      (js-call implicit :map
                        (lambda (node) (binding-name (ir-value node))))
                      ", ")
                    "};"))
               "")
             "\nexport const __eliscript_portable__ = Object.freeze(Object.fromEntries(["
             (join-fragments
               (js-call portable :map
                 (lambda (node)
                   (fast-combine
                     (js-array "[" (json-string (ir-value node)) ", "
                      (binding-name (ir-value node)) "]"))))
               ", ")
             "]));"))))))

  (defun emit-module-artifact-in-profile (program)
    (let* ((previous tdz-state)
           (previous-await await-node-cache)
           (previous-has-await module-has-await)
           (previous-has-recur module-has-recur)
           (previous-bcache emit-bname-cache)
           (previous-rcache emit-rname-cache)
           (flags (if (nil? scan-program-flags)
                      (scan-program-flags-portable (program-body program))
                    (funcall scan-program-flags (program-body program))))
           (has-await (not (eq (bit-and flags 1) 0))))
      (when (> (aref emit-shared-bname-cache "size") 8192) (js-call emit-shared-bname-cache :clear))
      (when (> (aref emit-shared-rname-cache "size") 8192) (js-call emit-shared-rname-cache :clear))
      (setq emit-bname-cache emit-shared-bname-cache)
      (setq emit-rname-cache emit-shared-rname-cache)
      (setq tdz-state (tdz-prepare program))
      (setq module-has-await has-await)
      (setq module-has-recur (not (eq (bit-and flags 2) 0)))
      (setq await-node-cache (if has-await (new globalThis.WeakMap) nil))
      (try (emit-module-artifact-in-profile-ready program)
        (finally
          (setq tdz-state previous)
          (setq await-node-cache previous-await)
          (setq module-has-await previous-has-await)
          (setq module-has-recur previous-has-recur)
          (setq emit-bname-cache previous-bcache)
          (setq emit-rname-cache previous-rcache)))))

  (defun runtime-capsule-p (program entries)
    (let* ((filename (program-filename program)) (body (program-body program))
           (module (if (= (js-length body) 1) (aref body 0) nil)))
      (and module (= (ir-kind module) "module-declaration")
        (= (value-type filename) "string")
        (js-call entries
          :some (lambda (entry)
            (and (= (ir-value module) (aref entry 1))
              (or (= filename (aref entry 0))
                (and (js-call filename :startsWith "/")
                     (js-call filename :endsWith (+ "/" (aref entry 0)))))))))))

  (defun unicode-bootstrap-capsule-p (program)
    (runtime-capsule-p program
      (js-array
        (js-array "runtime/prelude.eli" "eliscript.runtime.prelude")
        (js-array "runtime/primitives.eli" "eliscript.runtime.primitives")
        (js-array "runtime/errors.eli" "eliscript.runtime.errors")
        (js-array "runtime/binding.eli" "eliscript.runtime.binding")
        (js-array "runtime/unicode-case.eli" "eliscript.runtime.unicode-case")
        (js-array "runtime/unicode-case-data.eli" "eliscript.runtime.unicode-case-data")
        (js-array "runtime/number-radix.eli" "eliscript.runtime.number-radix")
        (js-array "runtime/array-text.eli" "eliscript.runtime.array-text"))))

  (defun array-text-bootstrap-capsule-p (program)
    (runtime-capsule-p program
      (js-array
        (js-array "runtime/number-radix.eli" "eliscript.runtime.number-radix")
        (js-array "runtime/array-text.eli" "eliscript.runtime.array-text"))))

  (defun emit-module-artifact-in-profile-ready (program)
    (setq temporary-counter 0)
    (setq binding-temporaries (new globalThis.Map))
    (let ((previous-numeric numeric-emission-profile)
          (array-text-capsule (array-text-bootstrap-capsule-p program)))
      (when array-text-capsule
        (setq numeric-emission-profile t))
      (try
        (let ((requirements (runtime-requirements program))
              (body
                (join-fragments
                  (js-call (program-body program) :map
                    (lambda (node) (emit-top-level node)))
                  "\n\n")))
          (fast-combine
            (js-array "// Generated by Eliscript. Do not edit.\n"
             (tdz-prologue)
             (if (unicode-bootstrap-capsule-p program) "" "import \"eliscript/runtime/unicode-case.mjs\";\n")
             (if (get requirements :math) "import \"eliscript/runtime/math.mjs\";\n" "")
             (let ((numeric-coercion (and (not numeric-emission-profile) (get requirements :numericCoercion))))
               (prelude-import (and (not array-text-capsule) (get requirements :arrayText))
                 (and (not numeric-emission-profile)
                      (or (get requirements :numberConversion) numeric-coercion))
                 numeric-coercion
                 (and (not numeric-emission-profile) (get requirements :imul))))
             (if (get requirements :literal)
                 literal-runtime-import
               "")
             (if (get requirements :collection)
                 collection-runtime-import
               "")
             (if (get requirements :binding)
                 binding-runtime
               "")
             (if (get requirements :list)
                 list-runtime-import
               "")
             (if (get requirements :value)
                 value-runtime-import
               "")
             (if (get requirements :primitiveRuntime) primitive-runtime-import "")
             (if (get requirements :valueType) value-type-import "")
             "const __eliscript_truthy = (value) => value !== false && value != null;\n"
             (if (get requirements :hostIdentityToken)
                 host-identity-token-helper
               "")
             "\n"
             body
             (emit-portable-manifest program)
             "\n")))
        (finally (setq numeric-emission-profile previous-numeric)))))

  (defun emit-module-artifact (program)
    (let ((previous numeric-emission-profile)
          (previous-mode emit-mark-mode)
          (use-lazy (and (not function-source-profile) (eq emit-mark-mode 0) (funcall emit-unpatched-string-p))))
      (setq numeric-emission-profile false)
      (when use-lazy (setq emit-mark-mode 1))
      (try
        (let ((raw (emit-module-artifact-in-profile program)))
          (if use-lazy
              (js-object :text (aref raw "text") :marks (funcall materialize-lazy-marks (aref raw "m")))
            raw))
        (finally
          (setq numeric-emission-profile previous)
          (setq emit-mark-mode previous-mode)))))
  (defun emit-module-function-sources (program)
    (let ((previous function-source-profile)
          (previous-mode emit-mark-mode))
      (setq function-source-profile t)
      (put fsp-flag 0 1)
      (setq emit-mark-mode 0)
      (try
        (let* ((artifact (emit-module-artifact program)) (javascript (get artifact :text)))
          (js-object :javascript javascript
            :functions (js-call (get artifact :functions (js-array)) :map
              (lambda (record)
                (js-object :node (get record :node) :start (get record :start) :end (get record :end)
                  :sourceText (js-call javascript :slice (get record :start) (get record :end)))))))
        (finally
          (setq function-source-profile previous)
          (put fsp-flag 0 (if previous 1 0))
          (setq emit-mark-mode previous-mode)))))
  ;; Internal code generation entry. The numeric backend must validate the
  ;; complete original program before optimization and before calling this.
  (defun emit-module-numeric (program)
    (let ((previous numeric-emission-profile)
          (previous-mode emit-mark-mode))
      (setq numeric-emission-profile t)
      (when (and (not function-source-profile) (funcall emit-unpatched-string-p))
        (setq emit-mark-mode 2))
      (try (get (emit-module-artifact-in-profile program) :text)
        (finally
          (setq numeric-emission-profile previous)
          (setq emit-mark-mode previous-mode)))))

  (defun emit-module (program)
    (let ((previous-mode emit-mark-mode))
      (when (and (not function-source-profile) (funcall emit-unpatched-string-p))
        (setq emit-mark-mode 2))
      (try (get (emit-module-artifact program) :text)
        (finally (setq emit-mark-mode previous-mode)))))

  (defun emit-module-with-source-map
      (program source generated-name source-name)
    (let* ((artifact (emit-module-artifact program))
           (javascript (get artifact :text))
           (resolved-source-name
            (or source-name (program-filename program) "<string>")))
      (js-object
        :javascript javascript
        :sourceMap
        (create-source-map
          javascript
          (get artifact :marks)
          source
          resolved-source-name
          generated-name))))

  (export
    indent
    reference-indent
    locate
    reference-locate
    emit-expression
    emit-top-level
    emit-module-artifact
    emit-module-function-sources
    emit-module
    emit-module-numeric
    emit-module-with-source-map
    runtime-requirements
    reference-runtime-requirements))
