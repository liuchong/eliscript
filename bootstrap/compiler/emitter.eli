  (defun tdz-assignment (pair)
    (let* ((record (and tdz-state (js-call (get tdz-state :writes) :get pair)))
           (value (emit-expression (js-nth 0 (children pair)))))
      (if (not record) (combine (js-array "(" (emit-binding-name pair) " = " value ")"))
        (combine (js-array (tdz-writer-name record) "(" value ")")))))



  (defun make-fragment (text marks &optional functions)
    (let ((fragment (js-object :text text :marks marks)))
      (when function-source-profile (put fragment :functions (or functions (js-array)))) fragment))

  (defun function-source-fragment (node output start end)
    (let ((fragment (as-fragment output)))
      (when function-source-profile
        (let ((functions (js-call (get fragment :functions (js-array)) :slice)))
          (js-call functions :push (js-object :node node :start start :end end))
          (put fragment :functions functions))) fragment))

  (defun function-indented-offset (starts offset)
    (let ((low 0) (high (js-length starts)))
      (while (< low high)
        (let ((middle (+ low (Math/floor (/ (- high low) 2)))))
          (if (<= (js-nth middle starts) offset) (setq low (1+ middle)) (setq high middle))))
      (+ offset (* low 2))))

  (defun indent-function-sources (source functions)
    (let ((starts (js-array)) (parts (js-call source :split "\n")) (offset 0) (index 0))
      (while (< index (js-length parts))
        (let ((line (js-nth index parts)))
          (when (> (js-length line) 0) (js-call starts :push offset))
          (setq offset (+ offset (js-length line) 1)))
        (setq index (1+ index)))
      (js-call functions :map (lambda (record)
        (js-object :node (get record :node)
          :start (function-indented-offset starts (get record :start))
          :end (function-indented-offset starts (get record :end)))))))

  (defun text-fragment (text)
    (make-fragment text (js-array)))

  (defun as-fragment (part)
    (if (= (value-type part) "string")
        (text-fragment part)
      part))

  (defun combine (parts)
    (let ((text "")
          (marks (js-array))
          (functions (js-array))
          (part-index 0)
          (fragment nil)
          (offset 0)
          (fragment-marks nil)
          (mark-index 0)
          (mark nil))
      (while (< part-index (get parts :length))
        (setq fragment (as-fragment (js-nth part-index parts)))
        (setq offset (get text :length))
        (setq fragment-marks (get fragment :marks))
        (setq mark-index 0)
        (while (< mark-index (get fragment-marks :length))
          (setq mark (js-nth mark-index fragment-marks))
          (js-call marks :push
            (js-object
              :offset (+ offset (get mark :offset))
              :span (get mark :span)))
          (setq mark-index (1+ mark-index)))
        (setq text (str text (get fragment :text)))
        (when function-source-profile
          (js-call (get fragment :functions (js-array)) :forEach
            (lambda (record) (js-call functions :push
              (js-object :node (get record :node) :start (+ offset (get record :start)) :end (+ offset (get record :end)))))))
        (setq part-index (1+ part-index)))
      (make-fragment text marks functions)))

  (defun join-fragments (parts separator)
    (let ((joined (js-array))
          (index 0))
      (while (< index (get parts :length))
        (when (> index 0)
          (js-call joined :push separator))
        (js-call joined :push (js-nth index parts))
        (setq index (1+ index)))
      (combine joined)))

  (defun reference-indent (fragment)
    (let* ((input (as-fragment fragment))
           (source (get input :text))
           (source-marks (get input :marks))
           (text "")
           (marks (js-array))
           (index 0)
           (mark-index 0)
           (line-start t))
      (while (< index (get source :length))
        (let ((code (js-call source :charCodeAt index)))
          (when (and line-start (not (= code 10)))
            (setq text (str text "  ")))
          (while (and (< mark-index (get source-marks :length))
                      (= (get (js-nth mark-index source-marks) :offset) index))
            (js-call marks :push
              (js-object
                :offset (get text :length)
                :span (get (js-nth mark-index source-marks) :span)))
            (setq mark-index (1+ mark-index)))
          (setq text (str text (js-call source :charAt index)))
          (setq line-start (= code 10))
          (setq index (1+ index))))
      (make-fragment text marks (when function-source-profile
        (indent-function-sources source (get input :functions (js-array)))))))

  (defconst native-indent
    (lambda (input)
      (let* ((source (aref input "text"))
             (source-marks (aref input "marks"))
             (parts (js-call source :split "\n"))
             (marks (js-array))
             (start 0)
             (added 0)
             (mark-index 0)
             (mark (aref source-marks 0))
             (index 0))
        (while (< index (aref parts "length"))
          (let* ((line (aref parts index))
                 (end (+ (+ start (aref line "length"))
                         (if (< (+ index 1) (aref parts "length")) 1 0))))
            (when (> (aref line "length") 0)
              (put parts index (+ "  " line))
              (setq added (+ added 2)))
            (while (and (not (eq mark undefined))
                        (>= (aref mark "offset") start)
                        (< (aref mark "offset") end))
              (js-call marks :push
                (js-object :offset (+ (aref mark "offset") added)
                           :span (aref mark "span")))
              (setq mark-index (+ mark-index 1))
              (setq mark (aref source-marks mark-index)))
            (setq start end))
          (setq index (+ index 1)))
        (js-object :text (js-call parts :join "\n") :marks marks))))

  (defun indent (fragment)
    (let* ((input (as-fragment fragment)) (output (funcall native-indent input)))
      (when function-source-profile
        (put output :functions (indent-function-sources (get input :text) (get input :functions (js-array)))))
      output))

  (defun reference-locate (node output)
    (let* ((fragment (as-fragment output))
           (marks (get fragment :marks))
           (has-start
            (js-call marks :some
              (lambda (mark) (= (get mark :offset) 0)))))
      (if (or (= (get (get fragment :text) :length) 0)
              (not (ir-span node))
              has-start)
          fragment
        (let ((located
               (js-array (js-object :offset 0 :span (ir-span node)))))
          (js-call marks :forEach
            (lambda (mark) (js-call located :push mark)))
          (make-fragment (get fragment :text) located (get fragment :functions (js-array)))))))

  (defun locate (node output)
    (native-locate (ir-span node) output))

  (defun fresh-name ()
    (setq temporary-counter (1+ temporary-counter))
    (str "__eliscript_value_" temporary-counter))

  (defun json-string (value)
    (JSON/stringify value))

  (defun children (node)
    (or (ir-children node) (js-array)))

  (defun require-arity (name nodes minimum maximum)
    (let ((count (get nodes :length)))
      (when (or (< count minimum)
                (and maximum (> count maximum)))
        (let ((expected
               (if (and maximum (= minimum maximum))
                   (str minimum)
                 (str minimum (if maximum (str ".." maximum) "+"))))
              (plural
               (if (and maximum (= minimum maximum) (= minimum 1))
                   ""
                 "s")))
          (fail
            (str name " expects " expected " argument" plural
                 ", got " count))))))

  (defun require-node-arity (node minimum maximum)
    (try
      (require-arity
        (or (ir-value node) (ir-kind node))
        (children node)
        minimum
        maximum)
      (catch error
        ;; The node that owns this arity boundary is authoritative. Preserve
        ;; the original exception even when it cannot accept extra metadata.
        (try
          (unless (Object/hasOwn error "eliscriptIRSpan")
            (put error :eliscriptIRSpan (ir-span node)))
          (finally (throw error))))))

  (defun emit-binding-name (node)
    (native-locate (ir-span node) (binding-name (ir-value node))))

  (defun emit-array-binding-pattern (node)
    (let* ((nodes (children node))
           (rest (ir-property node "rest"))
           (last-index (1- (get nodes :length)))
           (parts (js-array))
           (index 0)
           (last-hole false))
      (js-call nodes :forEach
        (lambda (child)
          (setq last-hole (= (ir-kind child) "binding-hole"))
          (js-call parts :push
            (cond
              ((and rest (= index last-index))
               (combine (js-array "..." (emit-binding-pattern-node child))))
              (last-hole "")
              (t (emit-binding-pattern-node child))))
          (setq index (1+ index))))
      (native-locate
        (ir-span node)
        (combine
          (js-array "[" (join-fragments parts ", ")
           (if (and last-hole (not rest)) "," "") "]")))))

  (defun map-binding-pattern-p (node)
    (and (ir-property node "pattern")
         (= (ir-kind (js-nth 0 (children node))) "map-binding-pattern")))

  (defun binding-temporary (node)
    (if (js-call binding-temporaries :has node)
        (js-call binding-temporaries :get node)
      (let ((name (fresh-name)))
        (js-call binding-temporaries :set node name)
        name)))

  (defun emit-map-binding-pattern (node source)
    (let* ((nodes (children node))
           (entry-count (ir-property node "entryCount"))
           (entries (js-call nodes :slice 0 entry-count))
           (as (and (ir-property node "as") (js-nth entry-count nodes)))
           (parts (js-array)))
      (when as
        (js-call parts :push
          (combine (js-array "let " (emit-binding-name as) " = " source ";"))))
      (js-call entries :forEach
        (lambda (entry)
          (let* ((entry-nodes (children entry))
                 (target (js-nth 0 entry-nodes))
                 (key (js-nth 1 entry-nodes))
                 (default (and (ir-property entry "default")
                               (js-nth 2 entry-nodes)))
                 (temporary (fresh-name))
                 (resolved
                  (combine
                    (js-array "(" temporary
                     " === __eliscript_binding_missing ? "
                     (if default (emit-expression default) "null")
                     " : " temporary ")"))))
            (js-call parts :push
              (combine
                (js-array "const " temporary
                 " = __eliscript_binding_get(" source ", "
                 (emit-expression key)
                 ", __eliscript_binding_missing);")))
            (js-call parts :push (emit-pattern-setup target resolved)))))
      (join-fragments parts "\n")))

  (defun emit-pattern-setup (pattern source)
    (let ((kind (ir-kind pattern)))
      (cond
        ((= kind "binding-name")
         (combine (js-array "let " (emit-binding-name pattern) " = " source ";")))
        ((= kind "array-binding-pattern")
         (combine
           (js-array "let " (emit-array-binding-pattern pattern) " = " source ";")))
        ((= kind "map-binding-pattern")
         (emit-map-binding-pattern pattern source))
        (t (fail (str "invalid IR binding setup node: " kind))))))

  (defun emit-binding-setup (binding)
    (if (map-binding-pattern-p binding)
        (emit-map-binding-pattern
          (js-nth 0 (children binding)) (binding-temporary binding))
      (text-fragment "")))

  (defun emit-binding-setups (bindings)
    (let ((parts (js-array)))
      (js-call bindings :forEach
        (lambda (binding)
          (when (map-binding-pattern-p binding)
            (js-call parts :push (emit-binding-setup binding)))))
      (join-fragments parts "\n")))

  (defun binding-default-value (binding)
    (if (and (ir-property binding "pattern")
             (not (map-binding-pattern-p binding)))
        "[]"
      "null"))

  (defun emit-binding-pattern-node (node)
    (let ((kind (ir-kind node)))
      (cond
        ((= kind "binding-name") (emit-binding-name node))
        ((= kind "binding-hole") "")
        ((= kind "array-binding-pattern")
         (emit-array-binding-pattern node))
        ((= kind "map-binding-pattern")
         (fail "map binding patterns require a generated source binding"))
        (t (fail (str "invalid IR binding pattern node: " kind))))))

  (defun emit-binding-target (node)
    (if (map-binding-pattern-p node)
        (binding-temporary node)
      (if (ir-property node "pattern")
          (emit-binding-pattern-node (js-nth 0 (children node)))
        (emit-binding-name node))))

  (defun binding-initializer (node)
    (let ((nodes (children node)))
      (js-nth 0
        (if (ir-property node "pattern")
            (js-call nodes :slice 1)
          nodes))))

  (defun emit-parameter (node)
    (let ((name (emit-binding-target node))
          (kind (ir-property node "parameterKind"))
          (pattern (ir-property node "pattern")))
      (cond
        ((= kind "optional")
         (combine
           (js-array name " = "
            (if pattern (binding-default-value node) "null"))))
        ((= kind "rest") (combine (js-array "..." name)))
        (t name))))

  (defun emit-arguments (nodes)
    (join-fragments
      (js-call nodes :map (lambda (node) (emit-expression node)))
      ", "))

  (defun qualified-apply-reference-p (node)
    (and (node-p node) (= (ir-kind node) "reference")
      (= (value-type (ir-value node)) "string")
      (let ((name (js-call (ir-value node) :replaceAll "/" ".")))
        (while (js-call name :endsWith ".") (setq name (js-call name :slice 0 -1)))
        (js-call name :endsWith ".apply"))))

  (defun emit-callee (node)
    (let ((output (emit-expression node)))
      (cond
        ((qualified-apply-reference-p node)
          (combine (js-array "__eliscript_at("
            (native-locate (ir-span node)
              (text-fragment (js-call (get output :text) :slice 0 -6)))
            ", \"apply\")")))
        ((= (ir-kind node) "reference") output)
        (t (combine (js-array "(" output ")"))))))

  (defun boolean-reference-text-p (text)
    (let ((length (js-length text)) (index 2) (valid t))
      (when (or (< length 3) (/= (js-call text :charCodeAt 0) 33)
                (/= (js-call text :charCodeAt 1) 33)) (setq valid false))
      (while (and valid (< index length))
        (let ((code (js-call text :charCodeAt index)))
          (unless (or (and (>= code 65) (<= code 90))
                      (and (>= code 97) (<= code 122))
                      (= code 95) (= code 36)
                      (and (> index 2) (>= code 48) (<= code 57)))
            (setq valid false)))
        (setq index (1+ index))) valid))

  (defun boolean-p (node)
    (let ((kind (ir-kind node)) (value (ir-value node)))
      (cond
        ((= kind "literal") (or (eq value t) (eq value false)))
        ((= kind "raw-javascript")
         (let ((nodes (children node)))
           (and (= (js-length nodes) 1) (= (ir-kind (js-nth 0 nodes)) "literal")
                (= (value-type (ir-value (js-nth 0 nodes))) "string")
                (boolean-reference-text-p (js-call (ir-value (js-nth 0 nodes)) :trim)))))
        ((= kind "intrinsic")
         (not (= (js-call
                   (js-array "not" "=" "/=" "not=" "<" "<=" ">" ">="
                     "eq" "equal" "nil?" "undefined?" "null" "nullish?")
                   :indexOf value) -1)))
        ((= kind "short-circuit")
         (let ((nodes (children node)))
           (and (> (get nodes :length) 0)
                (js-call nodes :every boolean-p))))
        (t false))))

  (defun emit-test (node)
    (let ((output (emit-expression node)))
      (if (boolean-p node) output
        (combine (js-array "__eliscript_truthy(" output ")")))))

  ;; Share a sequential scope only when no initializer can observe its TDZ.
  ;; Other initializers retain their original individual binding scopes.
  (defun context-sequential-safe-p (bindings)
    (if (<= (js-length bindings) 1) false
    (let ((names (new globalThis.Map)) (index 0) (safe t))
      (while (and safe (< index (js-length bindings)))
        (let ((name (binding-name (ir-value (js-nth index bindings)))))
          (if (js-call names :has name) (setq safe false) (js-call names :set name index)))
        (setq index (1+ index)))
      (setq index 0)
      (while (and safe (< index (js-length bindings)))
        (let* ((initializer (binding-initializer (js-nth index bindings)))
               (pending (if initializer (js-array initializer) (js-array))))
          (while (and safe (> (js-length pending) 0))
            (let* ((node (js-call pending :pop)) (kind (ir-kind node)))
              (if (= kind "raw-javascript") (setq safe false)
                (progn
                  ;; Include reads inside closures and assignment targets. A
                  ;; conservative extra scope is preferable to a new TDZ or
                  ;; capturing a binding declared later in the same block.
                  (when (or (= kind "reference") (= kind "assignment-pair"))
                    (let* ((name (reference-name (ir-value node)))
                           (root (js-nth 0 (js-call name :split "."))))
                      (when (and (js-call names :has root) (>= (js-call names :get root) index))
                        (setq safe false))))
                  (js-call (children node) :forEach (lambda (child) (js-call pending :push child))))))))
        (setq index (1+ index))) safe)))

  (defun emit-context-let (bindings body sequential returning)
    (if (= (get bindings :length) 0)
        (if returning (emit-returning-body body) (emit-statement-body body))
      (if (and sequential (context-sequential-safe-p bindings))
          (let ((declarations (js-array)))
            (js-call bindings :forEach (lambda (binding)
              (let ((initializer (binding-initializer binding)))
                (js-call declarations :push (combine (js-array "let " (emit-binding-target binding) " = "
                  (if initializer (emit-expression initializer) "null") ";"))))))
            (js-call declarations :push (if returning (emit-returning-body body) (emit-statement-body body)))
            (combine (js-array "{\n" (indent (join-fragments declarations "\n")) "\n}")))
      (let* ((group (if sequential (js-array (js-nth 0 bindings)) bindings))
             (temporaries (temporary-names group))
             (initializers (js-array))
             (declarations (js-array))
             (index 0))
        (while (< index (get group :length))
          (let* ((binding (js-nth index group))
                 (initializer (binding-initializer binding)))
            (js-call initializers :push
              (combine
                (js-array "const " (js-nth index temporaries) " = "
                  (if initializer (emit-expression initializer) "null") ";"))))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (get group :length))
          (js-call declarations :push
            (combine
              (js-array "let " (emit-binding-target (js-nth index group)) " = "
                (js-nth index temporaries) ";")))
          (setq index (1+ index)))
        (js-call declarations :push
          (emit-context-let
            (if sequential (js-call bindings :slice 1) (js-array))
            body sequential returning))
        (js-call initializers :push
          (combine (js-array "{\n" (indent (join-fragments declarations "\n")) "\n}")))
        (combine (js-array "{\n" (indent (join-fragments initializers "\n")) "\n}"))))))

  (defun emit-context-cond (clauses returning)
    (if (= (get clauses :length) 0)
        (text-fragment (if returning "return null;" ""))
      (let* ((clause (js-nth 0 clauses))
             (nodes (children clause))
             (test (js-nth 0 nodes))
             (body (js-call nodes :slice 1)))
        (native-locate (ir-span clause)
          (if (and (= (ir-kind test) "literal") (= (ir-value test) t))
              (if returning (emit-returning-body body) (emit-statement-body body))
            (combine
              (js-array "if (" (emit-test test) ") {\n"
                (indent (if returning (emit-returning-body body) (emit-statement-body body)))
                "\n} else {\n"
                (indent (emit-context-cond (js-call clauses :slice 1) returning)) "\n}")))))))

  (defun emit-context (node returning)
    (let ((kind (ir-kind node)) (nodes (children node)))
      (locate node
        (cond
          ;; Preserve async expression boundaries and their promise scheduling.
          ((contains-await-p node)
           (combine (js-array (if returning "return " "") (emit-expression node) ";")))
          ((= kind "sequence")
           (if returning (emit-returning-body nodes) (emit-statement-body nodes)))
          ((= kind "conditional")
           (combine
             (js-array "if (" (emit-test (js-nth 0 nodes)) ") {\n"
               (indent (emit-context (js-nth 1 nodes) returning)) "\n}"
               (if (or returning (> (get nodes :length) 2))
                   (combine (js-array " else {\n"
                     (indent (if (> (get nodes :length) 2)
                                 (emit-context (js-nth 2 nodes) returning)
                               (text-fragment "return null;"))) "\n}")) ""))))
          ((= kind "conditional-sugar")
           (combine
             (js-array "if ("
               (if (= (ir-value node) "when") (emit-test (js-nth 0 nodes))
                 (combine (js-array "(!" (emit-test (js-nth 0 nodes)) ")")))
               ") {\n"
               (indent (if returning (emit-returning-body (js-call nodes :slice 1))
                         (emit-statement-body (js-call nodes :slice 1)))) "\n}"
               (if returning " else {\n  return null;\n}" ""))))
          ((= kind "conditional-chain") (emit-context-cond nodes returning))
          ((= kind "loop")
           (combine
             (js-array "while (" (emit-test (js-nth 0 nodes)) ") {\n"
               (indent (emit-statement-body (js-call nodes :slice 1))) "\n}"
               (if returning "\nreturn null;" ""))))
          ((and (= kind "lexical-bindings")
                (js-call (js-call nodes :slice 0 (ir-property node "bindingCount"))
                  :every (lambda (binding) (not (ir-property binding "pattern")))))
           (let ((parts (split-counted-children node "bindingCount")))
             (emit-context-let (js-nth 0 parts) (js-nth 1 parts)
               (ir-property node "sequential") returning)))
          (t
           (combine (js-array (if returning "return " "") (emit-expression node) ";")))))))

  (defun emit-returning-body (nodes)
    (if (= (get nodes :length) 0)
        (text-fragment "return null;")
      (let ((parts (js-array)) (index 0) (last-index (1- (get nodes :length))))
        (while (< index last-index)
          (js-call parts :push (emit-context (js-nth index nodes) false))
          (setq index (1+ index)))
        (js-call parts :push (emit-context (js-nth last-index nodes) t))
        (join-fragments parts "\n"))))

  (defun emit-statement-body (nodes)
    (join-fragments
      (js-call nodes :map (lambda (node) (emit-context node false))) "\n"))

  (defun contains-await-p (value)
    (let ((pending (js-array value))
          (current nil)
          (kind nil)
          (nodes nil)
          (index 0)
          (found false))
      (while (and (not found) (> (get pending :length) 0))
        (setq current (js-call pending :pop))
        (cond
          ((node-p current)
           (setq kind (ir-kind current))
           (cond
             ((= kind "await-expression") (setq found t))
             ((not (= kind "function-expression"))
              (setq nodes (children current))
              (setq index (1- (get nodes :length)))
              (while (>= index 0)
                (js-call pending :push (js-nth index nodes))
                (setq index (1- index))))))
          ((Array/isArray current)
           (setq index (1- (get current :length)))
           (while (>= index 0)
             (js-call pending :push (js-nth index current))
             (setq index (1- index))))))
      found))

  (defun emit-iife (parameters body invocation asynchronous)
    (if asynchronous
        (combine
          (js-array "(await (async (" parameters ") => {\n" body "\n})("
           invocation "))"))
      (combine
        (js-array "((" parameters ") => {\n" body "\n})(" invocation ")"))))

  (defun emit-do (nodes)
    (cond
      ((= (get nodes :length) 0) (text-fragment "null"))
      ((= (get nodes :length) 1) (emit-expression (js-nth 0 nodes)))
      (t
       (emit-iife
         "" (indent (emit-returning-body nodes)) ""
         (contains-await-p nodes)))))

  (defun split-counted-children (node property)
    (let ((all (children node))
          (count (ir-property node property)))
      (js-array (js-call all :slice 0 count) (js-call all :slice count))))

  (defun emit-function (node)
    (let* ((parts (split-counted-children node "parameterCount"))
           (parameters (js-nth 0 parts))
           (body (js-nth 1 parts)))
      (let ((fragment (combine
        (js-array "(" (if (ir-property node "async") "async " "") "("
         (join-fragments
           (js-call parameters :map
             (lambda (parameter) (emit-parameter parameter)))
           ", ")
         ") => {\n"
         (indent (emit-function-body parameters body))
         "\n})"))))
        (function-source-fragment node fragment 1 (1- (js-length (get fragment :text)))))))

  (defun contains-recur-target-p (value target-kind)
    (let ((pending (js-array value))
          (current nil)
          (kind nil)
          (nodes nil)
          (index 0)
          (found false))
      (while (and (not found) (> (get pending :length) 0))
        (setq current (js-call pending :pop))
        (cond
          ((node-p current)
           (setq kind (ir-kind current))
           (cond
             ((= kind "recur")
              (when (= (ir-property current "targetKind") target-kind)
                (setq found t)))
             ((not (= kind "function-expression"))
              (setq nodes (children current))
              (setq index (1- (get nodes :length)))
              (while (>= index 0)
                (js-call pending :push (js-nth index nodes))
                (setq index (1- index))))))
          ((Array/isArray current)
           (setq index (1- (get current :length)))
           (while (>= index 0)
             (js-call pending :push (js-nth index current))
             (setq index (1- index))))))
      found))

  (defun emit-rebinding-target (binding temporary)
    (let ((target (emit-binding-target binding)))
      (if (ir-property binding "pattern")
          (combine (js-array "(" target " = " temporary ");"))
        (combine (js-array target " = " temporary ";")))))

  (defun emit-recur-tail (node target)
    (unless (= (ir-property node "targetKind") (get target :kind))
      (fail "recur target does not match its enclosing loop"))
    (let ((args (children node))
          (bindings (get target :bindings))
          (temporaries (js-array))
          (parts (js-array))
          (index 0))
      (while (< index (get args :length))
        (let ((temporary (fresh-name)))
          (js-call temporaries :push temporary)
          (js-call parts :push
            (combine
              (js-array "const " temporary " = "
               (emit-expression (js-nth index args)) ";"))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (get bindings :length))
        (js-call parts :push
          (emit-rebinding-target
            (js-nth index bindings) (js-nth index temporaries)))
        (setq index (1+ index)))
      (js-call parts :push
        (combine (js-array "continue " (get target :label) ";")))
      (native-locate (ir-span node) (join-fragments parts "\n"))))

  (defun emit-tail-body (nodes target)
    (if (= (get nodes :length) 0)
        (text-fragment "return null;")
      (let ((parts (js-array))
            (index 0)
            (last-index (1- (get nodes :length))))
        (while (< index last-index)
          (js-call parts :push
            (combine (js-array (emit-expression (js-nth index nodes)) ";")))
          (setq index (1+ index)))
        (js-call parts :push
          (emit-tail-node (js-nth last-index nodes) target))
        (join-fragments parts "\n"))))

  (defun emit-tail-cond (clauses target)
    (if (= (get clauses :length) 0)
        (text-fragment "return null;")
      (let* ((clause (js-nth 0 clauses))
             (nodes (children clause))
             (test (js-nth 0 nodes))
             (body (js-call nodes :slice 1)))
        (native-locate
          (ir-span clause)
          (if (and (= (ir-kind test) "literal")
                   (eq (ir-value test) t))
              (emit-tail-body body target)
            (combine
              (js-array "if (__eliscript_truthy(" (emit-expression test)
               ")) {\n" (indent (emit-tail-body body target))
               "\n} else {\n"
               (indent
                 (emit-tail-cond (js-call clauses :slice 1) target))
               "\n}")))))))

  (defun emit-tail-let (node target)
    (let* ((parts (split-counted-children node "bindingCount"))
           (bindings (js-nth 0 parts))
           (body (js-nth 1 parts))
           (sequential (ir-property node "sequential"))
           (statements (js-array))
           (temporaries (js-array))
           (index 0))
      (if sequential
          (while (< index (get bindings :length))
            (let* ((binding (js-nth index bindings))
                   (initializer (binding-initializer binding)))
              (js-call statements :push
                (combine
                  (js-array "let " (emit-binding-target binding) " = "
                   (if initializer
                       (emit-expression initializer)
                     (binding-default-value binding))
                   ";")))
              (when (map-binding-pattern-p binding)
                (js-call statements :push (emit-binding-setup binding))))
            (setq index (1+ index)))
        (progn
          (while (< index (get bindings :length))
            (let* ((binding (js-nth index bindings))
                   (initializer (binding-initializer binding))
                   (temporary (fresh-name)))
              (js-call temporaries :push temporary)
              (js-call statements :push
                (combine
                  (js-array "const " temporary " = "
                   (if initializer
                       (emit-expression initializer)
                     (binding-default-value binding))
                   ";"))))
            (setq index (1+ index)))
          (setq index 0)
          (while (< index (get bindings :length))
            (js-call statements :push
              (combine
                (js-array "let " (emit-binding-target (js-nth index bindings)) " = "
                 (js-nth index temporaries) ";")))
            (when (map-binding-pattern-p (js-nth index bindings))
              (js-call statements :push
                (emit-binding-setup (js-nth index bindings))))
            (setq index (1+ index)))))
      (js-call statements :push (emit-tail-body body target))
      (native-locate
        (ir-span node)
        (combine
          (js-array "{\n" (indent (join-fragments statements "\n")) "\n}")))))

  (defun emit-tail-short-circuit (nodes kind target)
    (cond
      ((= (get nodes :length) 0)
       (text-fragment (if (= kind "and") "return true;" "return null;")))
      ((= (get nodes :length) 1)
       (emit-tail-node (js-nth 0 nodes) target))
      (t
       (let* ((temporary (fresh-name))
              (first (emit-expression (js-nth 0 nodes)))
              (rest (js-call nodes :slice 1))
              (truthy
               (if (= kind "and")
                   (emit-tail-short-circuit rest kind target)
                 (combine (js-array "return " temporary ";"))))
              (falsey
               (if (= kind "and")
                   (combine (js-array "return " temporary ";"))
                 (emit-tail-short-circuit rest kind target))))
         (combine
           (js-array "const " temporary " = " first ";\n"
            "if (__eliscript_truthy(" temporary ")) {\n"
            (indent truthy) "\n} else {\n" (indent falsey) "\n}"))))))

  (defun emit-tail-node (node target)
    (let ((kind (ir-kind node))
          (nodes (children node)))
      (cond
        ((= kind "recur") (emit-recur-tail node target))
        ((= kind "conditional")
         (combine
           (js-array "if (__eliscript_truthy(" (emit-expression (js-nth 0 nodes))
            ")) {\n" (indent (emit-tail-node (js-nth 1 nodes) target))
            "\n} else {\n"
            (indent
              (if (> (get nodes :length) 2)
                  (emit-tail-node (js-nth 2 nodes) target)
                (text-fragment "return null;")))
            "\n}")))
        ((= kind "conditional-sugar")
         (combine
           (js-array "if (" (if (= (ir-value node) "when") "" "!")
            "__eliscript_truthy(" (emit-expression (js-nth 0 nodes))
            ")) {\n"
            (indent (emit-tail-body (js-call nodes :slice 1) target))
            "\n} else {\n  return null;\n}")))
        ((= kind "conditional-chain") (emit-tail-cond nodes target))
        ((= kind "sequence") (emit-tail-body nodes target))
        ((= kind "lexical-bindings") (emit-tail-let node target))
        ((= kind "short-circuit")
         (emit-tail-short-circuit nodes (ir-value node) target))
        (t (combine (js-array "return " (emit-expression node) ";"))))))

  (defconst closed-scalar-operators
    (js-array "+" "-" "*" "/" "%" "mod" "1+" "1-" "=" "eq" "<" "<=" ">" ">=" "/=" "not=" "not"))

  (defun closed-scalar-node-p (node scope state)
    (if (nullish? node) t
      (let ((kind (ir-kind node)) (nodes (children node)))
      (cond
        ((= kind "literal")
         (or (= (ir-value node) nil) (= (value-type (aref node "value")) "number")
             (= (value-type (aref node "value")) "boolean") (= (value-type (aref node "value")) "undefined")))
        ((= kind "reference") (>= (js-call scope :indexOf (ir-value node)) 0))
        ((= kind "lexical-bindings")
         (let* ((parts (split-counted-children node "bindingCount"))
                (bindings (js-nth 0 parts)) (inner (js-call scope :slice)) (valid t))
           (js-call bindings :forEach
             (lambda (binding)
               (when (or (not (= (ir-kind binding) "lexical-binding"))
                         (ir-property binding "pattern")
                         (not (closed-scalar-node-p (binding-initializer binding)
                                (if (ir-property node "sequential") inner scope) state)))
                 (setq valid false))
               (js-call inner :push (ir-value binding))))
           (and valid (js-call (js-nth 1 parts) :every
                        (lambda (child) (closed-scalar-node-p child inner state))))))
        ((= kind "assignment")
         (js-call nodes :every
           (lambda (pair)
             (and (= (ir-kind pair) "assignment-pair")
                  (>= (js-call scope :indexOf (ir-value pair)) 0)
                  (closed-scalar-node-p (js-nth 0 (children pair)) scope state)))))
        ((or (and (= kind "intrinsic") (>= (js-call closed-scalar-operators :indexOf (ir-value node)) 0))
             (= kind "conditional") (= kind "conditional-sugar") (= kind "short-circuit")
             (= kind "sequence") (= kind "loop"))
         (when (= kind "loop") (put state :loop t))
         (and (or (not (= kind "intrinsic")) (not (relational-operator-p (ir-value node)))
                  (= (js-length nodes) 2))
              (js-call nodes :every (lambda (child) (closed-scalar-node-p child scope state)))))
        (t false)))))

  (defun closed-scalar-loop-p (parameters body)
    (let ((state (js-object :loop false))
          (scope (js-call parameters :map (lambda (parameter) (ir-value parameter)))))
      (and (> (js-length parameters) 0)
           (js-call parameters :every
             (lambda (parameter)
               (and (= (ir-property parameter "parameterKind") "required")
                    (not (ir-property parameter "pattern")))))
           (js-call body :every (lambda (node) (closed-scalar-node-p node scope state)))
           (get state :loop))))

  (defun emit-function-body (parameters body)
    (if (and (not numeric-emission-profile) (closed-scalar-loop-p parameters body))
        (let ((fast nil) (slow nil) (previous numeric-emission-profile))
          (setq numeric-emission-profile t)
          (try (setq fast (emit-function-body-unversioned parameters body))
            (finally (setq numeric-emission-profile previous)))
          (setq slow (emit-function-body-unversioned parameters body))
          (combine
            (js-array "if ("
             (js-call (js-call parameters :map
                        (lambda (parameter) (str "typeof " (binding-name (ir-value parameter)) " === \"number\""))) :join " && ")
             ") {\n" (indent fast) "\n} else {\n" (indent slow) "\n}")))
      (emit-function-body-unversioned parameters body)))

  (defun emit-function-body-unversioned (parameters body)
    (let ((setups (emit-binding-setups parameters)))
      (if (not (contains-recur-target-p body "function"))
          (if (= (get (get setups :text) :length) 0)
              (emit-returning-body body)
            (combine (js-array setups "\n" (emit-returning-body body))))
        (let* ((label (fresh-name))
             (target
              (js-object
                :kind "function" :bindings parameters :label label)))
          (combine
            (js-array label ": while (true) {\n"
             (indent
               (if (= (get (get setups :text) :length) 0)
                   (emit-tail-body body target)
                 (combine
                   (js-array setups "\n" (emit-tail-body body target)))))
             "\n}"))))))

  (defun emit-if (nodes)
    (combine
      (js-array "("
       (emit-test (js-nth 0 nodes))
       " ? "
       (emit-expression (js-nth 1 nodes))
       " : "
       (if (> (get nodes :length) 2)
           (emit-expression (js-nth 2 nodes))
         "null")
       ")")))

  (defun emit-conditional-sugar (node)
    (let* ((nodes (children node))
           (test (emit-test (js-nth 0 nodes)))
           (body (emit-do (js-call nodes :slice 1))))
      (combine
        (js-array "("
          (if (= (ir-value node) "when") test
            (combine (js-array "(!" test ")"))) " ? " body " : null)"))))

  (defun emit-cond (clauses)
    (if (= (get clauses :length) 0)
        (text-fragment "null")
      (let* ((clause (js-nth 0 clauses))
             (nodes (children clause))
             (test (js-nth 0 nodes))
             (body (js-call nodes :slice 1)))
        (native-locate
          (ir-span clause)
          (if (and (= (ir-kind test) "literal") (= (ir-value test) t))
              (emit-do body)
            (combine
              (js-array "("
               (emit-test test)
               " ? "
               (emit-do body)
               " : "
               (emit-cond (js-call clauses :slice 1))
               ")")))))))

  (defun emit-throw (node)
    (let ((temporary (fresh-name)))
      (combine
        (js-array "((" temporary ") => { throw " temporary "; })("
         (emit-expression (js-nth 0 (children node))) ")"))))

  (defun emit-catch (node)
    (let* ((nodes (children node))
           (binding (js-nth 0 nodes))
           (body (js-call nodes :slice 1)))
      (native-locate
        (ir-span node)
        (combine
          (js-array " catch (" (emit-binding-target binding) ") {\n"
           (indent
             (if (map-binding-pattern-p binding)
                 (combine
                   (js-array (emit-binding-setup binding) "\n"
                    (emit-returning-body body)))
               (emit-returning-body body)))
           "\n}")))))

  (defun emit-finally (node)
    (native-locate
      (ir-span node)
      (combine
        (js-array " finally {\n"
         (indent (emit-statement-body (children node)))
         "\n}"))))

  (defun emit-try (node)
    (let* ((parts (split-counted-children node "bodyCount"))
           (body (js-nth 0 parts))
           (clauses (js-nth 1 parts))
           (catch-clause
            (js-call clauses :find
              (lambda (clause) (= (ir-kind clause) "catch-clause"))))
           (finally-clause
            (js-call clauses :find
              (lambda (clause) (= (ir-kind clause) "finally-clause"))))
           (try-block
            (combine
              (js-array "try {\n"
               (indent (emit-returning-body body))
               "\n}"
               (if catch-clause (emit-catch catch-clause) "")
               (if finally-clause (emit-finally finally-clause) "")))))
      (emit-iife
        "" (indent try-block) "" (contains-await-p node))))

  (defun emit-binding-values (bindings)
    (let ((result (js-array)))
      (js-call bindings :forEach
        (lambda (binding)
          (let ((initializer (binding-initializer binding)))
            (js-call result :push
                (if initializer
                  (emit-expression initializer)
                (binding-default-value binding))))))
      result))

  (defun emit-parallel-let (bindings body)
    (let* ((names
            (join-fragments
              (js-call bindings :map
                (lambda (binding) (emit-binding-target binding)))
              ", "))
           (values (join-fragments (emit-binding-values bindings) ", "))
           (setups (emit-binding-setups bindings))
           (body-output
            (indent
              (if (= (get (get setups :text) :length) 0)
                  (emit-returning-body body)
                (combine
                  (js-array setups "\n" (emit-returning-body body)))))))
      (emit-iife names body-output values (contains-await-p body))))

  (defun emit-sequential-let (bindings body)
    (if (= (get bindings :length) 0)
        (emit-do body)
      (let ((binding (js-nth 0 bindings)))
        (let* ((name (emit-binding-target binding))
               (initializer (js-nth 0 (emit-binding-values (js-array binding))))
               (tail (emit-sequential-let (js-call bindings :slice 1) body)))
          (emit-iife
            name
            (indent
              (combine
                (js-array
                  (if (map-binding-pattern-p binding)
                      (combine (js-array (emit-binding-setup binding) "\n"))
                    "")
                  "return " tail ";")))
            initializer
            (or
              (contains-await-p (js-call bindings :slice 1))
              (contains-await-p body)))))))

  (defun emit-let (node)
    (let* ((parts (split-counted-children node "bindingCount"))
           (bindings (js-nth 0 parts))
           (body (js-nth 1 parts)))
      (if (ir-property node "sequential")
          (emit-sequential-let bindings body)
        (emit-parallel-let bindings body))))

  (defun emit-assignment (node)
    (let ((assignments (js-array)))
      (js-call (children node) :forEach
        (lambda (pair) (js-call assignments :push (native-locate (ir-span pair) (tdz-assignment pair)))))
      (if (= (ir-value node) "set!") (js-nth 0 assignments)
        (combine (js-array "(" (join-fragments assignments ", ") ")")))))

  (defun emit-loop (node)
    (let* ((nodes (children node))
           (test-output (emit-test (js-nth 0 nodes)))
           (body (js-call nodes :slice 1)))
      (emit-iife ""
        (indent
          (combine
            (js-array "while (" test-output ") {\n"
              (indent (emit-statement-body body)) "\n}\nreturn null;")))
        "" (contains-await-p nodes))))

  (defun emit-binding-loop (node)
    (let* ((parts (split-counted-children node "bindingCount"))
           (bindings (js-nth 0 parts))
           (body (js-nth 1 parts))
           (label (fresh-name))
           (target
            (js-object :kind "loop" :bindings bindings :label label))
           (parameters
            (join-fragments
              (js-call bindings :map
                (lambda (binding) (emit-binding-target binding)))
              ", "))
           (initializers
            (join-fragments
              (js-call bindings :map
                (lambda (binding)
                  (emit-expression (binding-initializer binding))))
              ", "))
           (setups (emit-binding-setups bindings)))
      (emit-iife
        parameters
        (indent
          (combine
            (js-array label ": while (true) {\n"
             (indent
               (if (= (get (get setups :text) :length) 0)
                   (emit-tail-body body target)
                 (combine
                   (js-array setups "\n" (emit-tail-body body target)))))
             "\n}")))
        initializers
        (contains-await-p body))))

  (defun emit-short-circuit (nodes kind)
    (cond
      ((= (get nodes :length) 0)
       (text-fragment (if (= kind "and") "true" "null")))
      ((= (get nodes :length) 1) (emit-expression (js-nth 0 nodes)))
      ((and (js-call nodes :every boolean-p) (not (contains-await-p nodes)))
       (combine
         (js-array "("
           (join-fragments
             (js-call nodes :map (lambda (node) (emit-expression node)))
             (if (= kind "and") " && " " || ")) ")")))
      (t
       (let ((temporary (fresh-name))
             (first (emit-expression (js-nth 0 nodes)))
             (rest (emit-short-circuit (js-call nodes :slice 1) kind)))
         (let ((body
                (combine
                  (js-array "(__eliscript_truthy(" temporary ") ? "
                   (if (= kind "and") rest temporary)
                   " : "
                   (if (= kind "and") temporary rest)
                   ")"))))
           (if (contains-await-p (js-call nodes :slice 1))
               (combine
                 (js-array "(await (async (" temporary ") => " body ")(" first "))"))
             (combine (js-array "((" temporary ") => " body ")(" first ")"))))))))

  (defun numeric-operator-tag (operator)
    (cond ((= operator "-") "sub") ((= operator "*") "mul") ((= operator "/") "div")
      ((= operator "%") "rem") ((= operator "&") "and") ((= operator "|") "or")
      ((= operator "^") "xor") ((= operator "<<") "shl") ((= operator ">>") "shr")
      ((= operator ">>>") "ushr") ((= operator "imul") "imul") (t nil)))
  (defun relational-operator-p (operator)
    (or (= operator "<") (= operator "<=") (= operator ">") (= operator ">=")))
  (defun emit-numeric-binary (operator left right)
    (if numeric-emission-profile
      (combine (js-array "(" left " " operator " " right ")"))
      ;; A Number literal one has no evaluation effects and subtraction cannot
      ;; return BigInt. A unary helper saves recursive-call argument registers.
      (if (and (= operator "-") (= (get (as-fragment right) :text) "1"))
        (combine (js-array "__eliscript_numeric_decrement(" left ")"))
        (if (relational-operator-p operator)
        (combine (js-array "__eliscript_numeric_relation(" (json-string operator) ", " left ", " right ")"))
        (let ((tag (numeric-operator-tag operator)))
          (if tag (combine (js-array "__eliscript_numeric_" tag "(" left ", " right ")"))
            (combine (js-array "(" left " " operator " " right ")"))))))))
  (defun emit-numeric-unary (tag operand)
    (combine (js-array "__eliscript_numeric_" tag "(" (emit-expression operand) ")")))
  (defun numeric-coercion-intrinsic-p (name)
    (or (numeric-operator-tag name) (relational-operator-p name)
      (= name "mod") (= name "1-") (= name "int32") (= name "uint32") (= name "imul32")
      (= name "bit-not") (= name "bit-and") (= name "bit-or") (= name "bit-xor")
      (= name "bit-shift-left") (= name "bit-shift-right") (= name "unsigned-bit-shift-right")))
  (defun emit-infix (name nodes operator minimum)
    (require-arity name nodes minimum nil)
    (if (and (not numeric-emission-profile) (numeric-operator-tag operator) (> (js-length nodes) 1))
      (let ((result (emit-expression (js-nth 0 nodes))) (index 1))
        (while (< index (js-length nodes))
          (setq result (emit-numeric-binary operator result (emit-expression (js-nth index nodes))))
          (setq index (1+ index))) result)
      (combine
        (js-array "("
         (join-fragments
           (js-call nodes :map (lambda (node) (emit-expression node)))
           (str " " operator " "))
         ")"))))

  (defun emit-binary-infix (node operator)
    (require-node-arity node 2 2)
    (let ((nodes (children node)))
      (emit-numeric-binary operator (emit-expression (js-nth 0 nodes)) (emit-expression (js-nth 1 nodes)))))

  (defun temporary-names (nodes)
    (let ((result (js-array)))
      (js-call nodes :forEach
        (lambda (_node) (js-call result :push (fresh-name))))
      result))

  (defun emit-comparison (name nodes operator)
    (require-arity name nodes 2 nil)
    (if (= (get nodes :length) 2)
        (emit-numeric-binary operator (emit-expression (js-nth 0 nodes)) (emit-expression (js-nth 1 nodes)))
      (let ((parameters (temporary-names nodes))
            (comparisons (js-array))
            (index 0))
        (while (< index (1- (get parameters :length)))
          (js-call comparisons :push
            (if (and (not numeric-emission-profile) (relational-operator-p operator))
              (str "__eliscript_numeric_relation(" (json-string operator) ", " (js-nth index parameters) ", " (js-nth (1+ index) parameters) ")")
              (str (js-nth index parameters) " " operator " " (js-nth (1+ index) parameters))))
          (setq index (1+ index)))
        (combine
          (js-array "(("
           (js-call parameters :join ", ")
           ") => ("
           (js-call comparisons :join " && ")
           "))("
           (emit-arguments nodes)
           ")")))))

  (defun emit-distinct (name nodes)
    (require-arity name nodes 2 nil)
    (let ((parameters (temporary-names nodes))
          (comparisons (js-array))
          (left 0))
      (while (< left (get parameters :length))
        (let ((right (1+ left)))
          (while (< right (get parameters :length))
            (js-call comparisons :push
              (str (js-nth left parameters) " !== " (js-nth right parameters)))
            (setq right (1+ right))))
        (setq left (1+ left)))
      (combine
        (js-array "(("
         (js-call parameters :join ", ")
         ") => ("
         (js-call comparisons :join " && ")
         "))("
         (emit-arguments nodes)
         ")"))))

  (defun emit-intrinsic (node)
    (let ((name (ir-value node))
          (nodes (children node)))
      (cond
        ((= name "not")
         (require-node-arity node 1 1)
         (combine (js-array "(!" (emit-test (js-nth 0 nodes)) ")")))
        ((= name "+")
         (if (= (get nodes :length) 0)
             (text-fragment "0")
           (combine
             (js-array "("
              (join-fragments
                (js-call nodes :map (lambda (node) (emit-expression node)))
                " + ")
              ")"))))
        ((= name "*")
         (if (= (get nodes :length) 0)
             (text-fragment "1")
           (emit-infix name nodes "*" 1)))
        ((= name "-")
         (require-node-arity node 1 nil)
         (if (= (get nodes :length) 1)
             (if numeric-emission-profile
               (combine (js-array "(-" (emit-expression (js-nth 0 nodes)) ")"))
               (emit-numeric-unary "neg" (js-nth 0 nodes)))
           (emit-infix "-" nodes "-" 2)))
        ((= name "/")
         (require-node-arity node 1 nil)
         (if (= (get nodes :length) 1)
             (emit-numeric-binary "/" (text-fragment "1") (emit-expression (js-nth 0 nodes)))
           (emit-infix "/" nodes "/" 2)))
        ((or (= name "%") (= name "mod")) (emit-infix name nodes "%" 2))
        ((= name "int32")
         (require-node-arity node 1 1)
         (if numeric-emission-profile (combine (js-array "(" (emit-expression (js-nth 0 nodes)) " | 0)"))
           (emit-numeric-unary "int32" (js-nth 0 nodes))))
        ((= name "uint32")
         (require-node-arity node 1 1)
         (if numeric-emission-profile (combine (js-array "(" (emit-expression (js-nth 0 nodes)) " >>> 0)"))
           (emit-numeric-unary "uint32" (js-nth 0 nodes))))
        ((= name "imul32")
         (require-node-arity node 2 2)
         (if numeric-emission-profile
           (combine (js-array "Math.imul(" (emit-expression (js-nth 0 nodes)) ", " (emit-expression (js-nth 1 nodes)) ")"))
           (emit-numeric-binary "imul" (emit-expression (js-nth 0 nodes)) (emit-expression (js-nth 1 nodes)))))
        ((= name "bit-and") (emit-binary-infix node "&"))
        ((= name "bit-or") (emit-binary-infix node "|"))
        ((= name "bit-xor") (emit-binary-infix node "^"))
        ((= name "bit-not")
         (require-node-arity node 1 1)
         (if numeric-emission-profile (combine (js-array "(~" (emit-expression (js-nth 0 nodes)) ")"))
           (emit-numeric-unary "not" (js-nth 0 nodes))))
        ((= name "bit-shift-left") (emit-binary-infix node "<<"))
        ((= name "bit-shift-right") (emit-binary-infix node ">>"))
        ((= name "unsigned-bit-shift-right")
         (emit-binary-infix node ">>>"))
        ((= name "value-type")
         (require-node-arity node 1 1)
         (combine
           (js-array "((__eliscript_value) => { if (__eliscript_value === null) return \"null\"; const __eliscript_host_type = typeof __eliscript_value; if (__eliscript_host_type !== \"object\" && __eliscript_host_type !== \"function\") return __eliscript_host_type; try { const __eliscript_type = Object.getOwnPropertyDescriptor(__eliscript_value, Symbol.for(\"eliscript.value.type\")); if (__eliscript_type && Object.prototype.hasOwnProperty.call(__eliscript_type, \"value\") && (__eliscript_type.value === \"keyword\" || __eliscript_type.value === \"symbol\")) return __eliscript_type.value; const __eliscript_kind = Object.getOwnPropertyDescriptor(__eliscript_value, \"kind\"); if (__eliscript_kind && Object.prototype.hasOwnProperty.call(__eliscript_kind, \"value\")) { if (__eliscript_kind.value === \"eliscript/keyword\") return \"keyword\"; if (__eliscript_kind.value === \"eliscript/symbol\") return \"symbol\"; } return __eliscript_host_type; } catch { return __eliscript_host_type; } })("
            (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "host-identity-token")
         (require-node-arity node 1 1)
         (combine
           (js-array "__eliscript_host_identity_token("
            (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "string-code-unit-at")
         (require-node-arity node 2 2)
         (combine
           (js-array "(" (emit-expression (js-nth 0 nodes)) ").charCodeAt("
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "string-from-code-unit")
         (require-node-arity node 1 1)
         (combine
           (js-array "String.fromCharCode(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "string-to-number")
         (require-node-arity node 1 1)
         (combine (js-array "__eliscript_to_number(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "string-to-bigint")
         (require-node-arity node 1 1)
         (combine
           (js-array "((__eliscript_text) => { try { return BigInt(__eliscript_text); } catch { return null; } })("
            (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "number-float64-words")
         (require-node-arity node 1 1)
         (combine
           (js-array "((__eliscript_number) => { const __eliscript_bytes = new DataView(new ArrayBuffer(8)); __eliscript_bytes.setFloat64(0, __eliscript_number === 0 ? 0 : __eliscript_number, true); return [__eliscript_bytes.getUint32(0, true), __eliscript_bytes.getUint32(4, true)]; })("
            (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "=") (emit-comparison name nodes "==="))
        ((or (= name "/=") (= name "not=")) (emit-distinct name nodes))
        ((= name "<") (emit-comparison name nodes "<"))
        ((= name "<=") (emit-comparison name nodes "<="))
        ((= name ">") (emit-comparison name nodes ">"))
        ((= name ">=") (emit-comparison name nodes ">="))
        ((= name "1+")
         (require-node-arity node 1 1)
         (combine (js-array "(" (emit-expression (js-nth 0 nodes)) " + 1)")))
        ((= name "1-")
         (require-node-arity node 1 1)
         (emit-numeric-binary "-" (emit-expression (js-nth 0 nodes)) (text-fragment "1")))
        ((= name "eq")
         (require-node-arity node 2 2)
         (combine
           (js-array "(" (emit-expression (js-nth 0 nodes)) " === "
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "equal")
         (require-node-arity node 2 2)
         (combine
           (js-array "__eliscript_equal(" (emit-expression (js-nth 0 nodes)) ", "
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "nil?")
         (require-node-arity node 1 1)
         (combine (js-array "(" (emit-expression (js-nth 0 nodes)) " === null)")))
        ((= name "undefined?")
         (require-node-arity node 1 1)
         (combine (js-array "(" (emit-expression (js-nth 0 nodes)) " === undefined)")))
        ((or (= name "null") (= name "nullish?"))
         (require-node-arity node 1 1)
         (combine (js-array "(" (emit-expression (js-nth 0 nodes)) " == null)")))
        ((= name "js-array")
         (combine (js-array "[" (emit-arguments nodes) "]")))
        ((= name "car")
         (require-node-arity node 1 1)
         (combine (js-array "__eliscript_first(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "cdr")
         (require-node-arity node 1 1)
         (combine (js-array "__eliscript_rest(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "cons")
         (require-node-arity node 2 2)
         (combine
           (js-array "__eliscript_cons(" (emit-expression (js-nth 0 nodes)) ", "
            (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "js-cons")
         (require-node-arity node 2 2)
         (combine
           (js-array "[" (emit-expression (js-nth 0 nodes)) ", ...(("
            (emit-expression (js-nth 1 nodes)) ") ?? [])]")))
        ((= name "nth")
         (require-node-arity node 2 2)
         (combine
           (js-array "__eliscript_nth(" (emit-expression (js-nth 1 nodes)) ", "
            (emit-expression (js-nth 0 nodes)) ", null)")))
        ((= name "js-nth")
         (require-node-arity node 2 2)
         (combine
           (js-array "((((" (emit-expression (js-nth 1 nodes)) ") ?? [])["
            (emit-expression (js-nth 0 nodes)) "]) ?? null)")))
        ((= name "aref")
         (require-node-arity node 2 2)
         (combine
           (js-array "(" (emit-expression (js-nth 0 nodes)) ")["
            (emit-property-key (js-nth 1 nodes)) "]")))
        ((= name "length")
         (require-node-arity node 1 1)
         (combine (js-array "__eliscript_count(" (emit-expression (js-nth 0 nodes)) ")")))
        ((= name "js-length")
         (require-node-arity node 1 1)
         (combine (js-array "((" (emit-expression (js-nth 0 nodes)) ") ?? []).length")))
        ((= name "__eliscript_arity_error")
         (require-node-arity node 2 2)
         (combine
           (js-array
             "((label, arity) => { throw new TypeError(label + \" received unsupported arity: \" + arity); })("
             (emit-expression (js-nth 0 nodes)) ", "
             (emit-expression (js-nth 1 nodes)) ")")))
        ((= name "object-keys")
         (require-node-arity node 1 1)
         (combine (js-array "Object.keys((" (emit-expression (js-nth 0 nodes)) ") ?? {})")))
        ((= name "object-has?")
         (require-node-arity node 2 2)
         (combine
           (js-array "Object.prototype.hasOwnProperty.call(("
            (emit-expression (js-nth 0 nodes)) ") ?? {}, "
            (emit-property-key (js-nth 1 nodes)) ")")))
        ((= name "object-assoc")
         (require-node-arity node 3 3)
         (combine
           (js-array "({...((" (emit-expression (js-nth 0 nodes)) ") ?? {}), ["
            (emit-property-key (js-nth 1 nodes)) "]: "
            (emit-expression (js-nth 2 nodes)) "})")))
        (t (fail (str "unknown IR intrinsic: " name))))))

  (defun emit-object-properties (properties)
    (let ((result (js-array)))
      (js-call properties :forEach
        (lambda (property)
          (let ((nodes (children property)))
            (js-call result :push
              (native-locate
                (ir-span property)
                (if (ir-property property "computed")
                    (combine
                      (js-array "[" (emit-expression (js-nth 0 nodes)) "]: "
                       (emit-expression (js-nth 1 nodes))))
                  (combine
                    (js-array (json-string (ir-value property)) ": "
                     (emit-expression (js-nth 0 nodes))))))))))
      (join-fragments result ", ")))

  (defun emit-object (node)
    (combine (js-array "({" (emit-object-properties (children node)) "})")))

  (defun literal-kind (node)
    (ir-property node "literalKind"))

  (defun emit-literal (node)
    (let ((value (ir-value node))
          (kind (literal-kind node)))
      (cond
        ((= kind "undefined") (text-fragment "undefined"))
        ((= kind "keyword")
         (combine
           (js-array "__eliscript_keyword(" (json-string value) ")")))
        ((null value) (text-fragment "null"))
        ((eq value t) (text-fragment "true"))
        ((eq value false) (text-fragment "false"))
        ((= (value-type value) "number")
         (unless (Number/isFinite value)
           (fail (str "non-finite numbers are not supported: " value)))
         (text-fragment (if (and (= value 0) (< (/ 1 value) 0)) "-0.0" (str value))))
        ((= (value-type value) "string")
         (text-fragment (json-string value)))
        (t (fail (str "unsupported IR literal: " value))))))

  (defun datum-kind (value)
    (and value
         (= (value-type value) "object")
         (get value :kind)))

  (defun emit-quoted (value)
    (let ((kind (datum-kind value)))
      (cond
        ((null value) (text-fragment "__eliscript_list()"))
        ((eq value t) (text-fragment "true"))
        ((eq value false)
         (text-fragment "__eliscript_symbol(\"false\")"))
        ((= (value-type value) "number")
         (text-fragment (if (and (= value 0) (< (/ 1 value) 0)) "-0.0" (str value))))
        ((= (value-type value) "string")
         (text-fragment (json-string value)))
        ((= kind "undefined") (text-fragment "undefined"))
        ((= kind "symbol")
         (combine
           (js-array "__eliscript_symbol("
            (text-fragment (json-string (get value :name))) ")")))
        ((= kind "keyword")
         (combine
           (js-array "__eliscript_keyword("
            (text-fragment (json-string (get value :name))) ")")))
        ((= kind "list")
         (combine
           (js-array "__eliscript_list("
            (join-fragments
              (js-call (get value :items) :map
                (lambda (item) (emit-quoted item)))
              ", ")
            ")")))
        ((= kind "vector")
         (combine
           (js-array "__eliscript_vector("
            (join-fragments
              (js-call (get value :items) :map
                (lambda (item) (emit-quoted item)))
              ", ")
            ")")))
        (t (fail "cannot emit quoted IR datum")))))

  (defun quoted-uses-literal-runtime-p (value)
    (let ((kind (datum-kind value)))
      (or (null value)
          (= value false)
          (= kind "symbol")
          (= kind "keyword")
          (= kind "list")
          (= kind "vector"))))

  (defun emit-property-key (node)
    (native-locate
      (ir-span node)
      (if (and (= (ir-kind node) "literal")
               (or (= (literal-kind node) "keyword")
                   (= (value-type (aref node "value")) "string")))
          (text-fragment (json-string (ir-value node)))
        (emit-expression node))))

  (defun array-text-key-p (node)
    (or (not (= (ir-kind node) "literal"))
        (= (ir-value node) "join") (= (ir-value node) "toString")
        (= (ir-value node) "call") (= (ir-value node) "apply") (= (ir-value node) "bind")))

  (defun primitive-literal-arguments-p (nodes)
    (js-call nodes :every
      (lambda (node)
        (and (= (ir-kind node) "literal")
             (not (= (literal-kind node) "keyword"))))))

  (defun emit-expression (node)
    (unless (node-p node)
      (fail "expected an IR expression node"))
    (let ((kind (ir-kind node))
          (nodes (children node)))
      (native-locate
        (ir-span node)
        (cond
          ((= kind "literal") (emit-literal node))
          ((= kind "reference") (tdz-read node))
          ((= kind "array-literal") (combine (js-array "[" (emit-arguments nodes) "]")))
          ((= kind "persistent-list-literal")
           (combine (js-array "__eliscript_list(" (emit-arguments nodes) ")")))
          ((= kind "persistent-vector-literal")
           (combine (js-array "__eliscript_vector(" (emit-arguments nodes) ")")))
          ((= kind "persistent-map-literal")
           (combine (js-array "__eliscript_hash_map(" (emit-arguments nodes) ")")))
          ((= kind "persistent-set-literal")
           (combine (js-array "__eliscript_hash_set(" (emit-arguments nodes) ")")))
          ((= kind "persistent-queue-literal")
           (combine (js-array "__eliscript_queue(" (emit-arguments nodes) ")")))
          ((= kind "quoted-literal") (emit-quoted (ir-value node)))
          ((= kind "function-expression") (emit-function node))
          ((= kind "await-expression")
           (combine (js-array "await (" (emit-expression (js-nth 0 nodes)) ")")))
          ((= kind "throw-expression") (emit-throw node))
          ((= kind "try-expression") (emit-try node))
          ((= kind "conditional") (emit-if nodes))
          ((= kind "conditional-sugar") (emit-conditional-sugar node))
          ((= kind "conditional-chain") (emit-cond nodes))
          ((= kind "sequence") (emit-do nodes))
          ((= kind "lexical-bindings") (emit-let node))
          ((= kind "assignment") (emit-assignment node))
          ((= kind "loop") (emit-loop node))
          ((= kind "binding-loop") (emit-binding-loop node))
          ((= kind "recur")
           (fail "recur is only valid in an analyzed tail position"))
          ((= kind "short-circuit") (emit-short-circuit nodes (ir-value node)))
          ((= kind "intrinsic") (emit-intrinsic node))
          ((= kind "object-literal") (emit-object node))
          ((= kind "property-read")
           (let ((access
                  (combine
                    (js-array "(" (emit-expression (js-nth 0 nodes)) ")["
                     (emit-property-key (js-nth 1 nodes)) "]"))))
             (if (= (get nodes :length) 3)
                 (combine (js-array "(" access " ?? " (emit-expression (js-nth 2 nodes)) ")"))
               access)))
          ((= kind "property-write")
           (combine
             (js-array "((" (emit-expression (js-nth 0 nodes)) ")["
              (emit-property-key (js-nth 1 nodes)) "] = "
              (emit-expression (js-nth 2 nodes)) ")")))
          ((= kind "method-call")
           (let* ((arguments (js-call nodes :slice 2))
                  (array-text (array-text-key-p (js-nth 1 nodes)))
                  (direct (and array-text (primitive-literal-arguments-p arguments))))
             (combine
               (js-array (if direct "__eliscript_at_direct(" (if array-text "__eliscript_at(" "("))
                 (emit-expression (js-nth 0 nodes)) (if array-text ", " ")[")
                 (emit-property-key (js-nth 1 nodes))
                 (if direct (if (> (get arguments :length) 0) ", " "") (if array-text ")(" "]("))
                 (emit-arguments arguments) ")"))))
          ((= kind "constructor-call")
           (combine
             (js-array "new (" (emit-expression (js-nth 0 nodes))
              ")(" (emit-arguments (js-call nodes :slice 1)) ")")))
          ((= kind "raw-javascript")
           ;; The raw form is exactly one string. Accepting several arguments
           ;; emitted only the first, so the module's braces did not close and
           ;; the JavaScript was not what the source said. The reference
           ;; implementation reports this at emission, so this one does too.
           (require-arity "js*" nodes 1 1)
           (unless (= (ir-kind (js-nth 0 nodes)) "literal")
             (fail "js* expects a string literal"))
           (text-fragment (ir-value (js-nth 0 nodes))))
          ((= kind "print") (combine (js-array "console.log(" (emit-arguments nodes) ")")))
          ((= kind "string-concat")
           (if (= (get nodes :length) 0)
               (text-fragment "\"\"")
             (let ((parts (js-array)))
               (js-call nodes :forEach
                 (lambda (child)
                   (js-call parts :push
                     (combine (js-array "String(" (emit-expression child) ")")))))
               (combine (js-array "(" (join-fragments parts " + ") ")")))))
          ((= kind "invoke")
           (combine
             (js-array (emit-callee (js-nth 0 nodes)) "("
              (emit-arguments (js-call nodes :slice 1)) ")")))
          ((= kind "apply-call")
           (combine
             (js-array (emit-callee (js-nth 0 nodes)) "(..."
              (emit-expression (js-nth 1 nodes)) ")")))
          ((= kind "call")
           (combine
             (js-array (emit-callee (js-nth 0 nodes)) "("
              (emit-arguments (js-call nodes :slice 1)) ")")))
          (t (fail (str "IR node is not valid in expression position: " kind)))))))

  (defun emit-import (node)
    (let ((default-binding nil)
          (namespace-binding nil)
          (named-bindings (js-array)))
      (js-call (children node) :forEach
        (lambda (specifier)
          (let ((name (emit-binding-name specifier))
                (kind (ir-kind specifier)))
            (cond
              ((= kind "import-default") (setq default-binding name))
              ((= kind "import-namespace") (setq namespace-binding name))
              ((= kind "import-named") (js-call named-bindings :push name))
              (t (fail (str "invalid IR import specifier: " kind)))))))
      (when (and namespace-binding (> (get named-bindings :length) 0))
        (fail "namespace and named imports cannot be combined"))
      (let ((clauses (js-array)))
        (when default-binding (js-call clauses :push default-binding))
        (when namespace-binding
          (js-call clauses :push (combine (js-array "* as " namespace-binding))))
        (when (> (get named-bindings :length) 0)
          (js-call clauses :push
            (combine (js-array "{" (join-fragments named-bindings ", ") "}"))))
        (if (= (get clauses :length) 0)
            (text-fragment (str "import " (json-string (ir-value node)) ";"))
          (combine
            (js-array "import " (join-fragments clauses ", ") " from "
             (json-string (ir-value node)) ";"))))))

  (defun emit-top-level (node)
    (unless (node-p node)
      (fail "expected a top-level IR node"))
    (let ((kind (ir-kind node))
          (nodes (children node)))
      (native-locate
        (ir-span node)
        (cond
          ((= kind "module-declaration")
           (join-fragments
             (js-call nodes :map (lambda (child) (emit-top-level child)))
             "\n"))
          ((= kind "import-declaration") (emit-import node))
          ((= kind "variable-declaration")
           (combine
             (js-array (if (ir-property node "mutable") "let " "const ")
              (binding-name (ir-value node))
              " = "
              (if (> (get nodes :length) 0)
                  (emit-expression (js-nth 0 nodes))
                "null")
              ";"
              (let ((record (and tdz-state (js-call (get tdz-state :declarations) :get node))))
                (if (tdz-guarded-p record) (str "\n" (tdz-ready-name record) " = true;") "")))))
          ((= kind "function-declaration")
           (let* ((parts (split-counted-children node "parameterCount"))
                  (parameters (js-nth 0 parts))
                  (body (js-nth 1 parts)))
             (let ((fragment (combine
               (js-array (if (ir-property node "async") "async " "")
                "function " (binding-name (ir-value node)) "("
                (join-fragments
                  (js-call parameters :map
                    (lambda (parameter) (emit-parameter parameter)))
                  ", ")
                ") {\n"
                  (indent (emit-function-body parameters body))
                "\n}"))))
               (function-source-fragment node fragment 0 (js-length (get fragment :text))))))
          ((= kind "export-declaration")
           (combine
             (js-array "export {"
              (join-fragments
                (js-call nodes :map
                  (lambda (reference) (emit-binding-name reference)))
                ", ")
              "};")))
          ((= kind "export-default")
           (combine (js-array "export default " (emit-expression (js-nth 0 nodes)) ";")))
          ((= kind "expression-statement")
           (combine (js-array (emit-expression (js-nth 0 nodes)) ";")))
          (t (fail (str "IR node is not valid at module top level: " kind)))))))

  (defun node-uses-number-conversion-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (= (ir-value node) "string-to-number"))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-number-conversion-p child)
              (setq found t))))
        found)))

  (defun node-uses-host-identity-token-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (= (ir-value node) "host-identity-token"))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-host-identity-token-p child)
              (setq found t))))
        found)))

  (defun node-directly-uses-literal-runtime-p (node)
    (let ((kind (ir-kind node)))
      (or (= kind "persistent-list-literal")
          (= kind "persistent-vector-literal")
          (= kind "persistent-map-literal")
          (= kind "persistent-set-literal")
          (= kind "persistent-queue-literal")
          (and (= kind "quoted-literal")
               (quoted-uses-literal-runtime-p (ir-value node)))
          (and (= kind "literal")
               (= (literal-kind node) "keyword")))))

  (defun literal-runtime-static-key-index (node)
    (let ((kind (ir-kind node)))
      (cond
        ((or (= kind "property-read")
             (= kind "property-write")
             (= kind "method-call")) 1)
        ((and (= kind "intrinsic")
              (or (= (ir-value node) "aref")
                  (= (ir-value node) "object-has?")
                  (= (ir-value node) "object-assoc"))) 1)
        (t nil))))

  (defun node-uses-literal-runtime-p (node)
    (let ((nodes (children node)))
      (cond
        ((node-directly-uses-literal-runtime-p node) t)
        (t
         (children-use-literal-runtime-p
           nodes (literal-runtime-static-key-index node))))))

  (defun children-use-literal-runtime-p (nodes static-key-index)
    (let ((found false)
          (index 0))
      (while (< index (get nodes :length))
        (let ((child (js-nth index nodes)))
          (unless (and static-key-index
                       (= index static-key-index)
                       (= (ir-kind child) "literal")
                       (= (literal-kind child) "keyword"))
            (when (node-uses-literal-runtime-p child)
              (setq found t))))
        (setq index (1+ index)))
      found))

  (defun node-uses-collection-runtime-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (or (= (ir-value node) "nth") (= (ir-value node) "length")))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-collection-runtime-p child)
              (setq found t))))
        found)))

  (defun node-uses-binding-runtime-p (node)
    (if (= (ir-kind node) "map-binding-pattern")
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-binding-runtime-p child)
              (setq found t))))
        found)))

  (defun node-uses-list-runtime-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (or (= (ir-value node) "car")
                 (= (ir-value node) "cdr")
                 (= (ir-value node) "cons")))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-list-runtime-p child)
              (setq found t))))
        found)))

  (defun node-uses-value-runtime-p (node)
    (if (and (= (ir-kind node) "intrinsic")
             (= (ir-value node) "equal"))
        t
      (let ((found false))
        (js-call (children node) :forEach
          (lambda (child)
            (when (node-uses-value-runtime-p child)
              (setq found t))))
        found)))

  (defun program-uses-number-conversion-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-number-conversion-p node)
            (setq found t))))
      found))

  (defun program-uses-host-identity-token-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-host-identity-token-p node)
            (setq found t))))
      found))

  (defun program-uses-literal-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-literal-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-collection-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-collection-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-binding-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-binding-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-list-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-list-runtime-p node)
            (setq found t))))
      found))

  (defun program-uses-value-runtime-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach
        (lambda (node)
          (when (node-uses-value-runtime-p node)
            (setq found t))))
      found))

  (defun node-uses-array-text-p (node)
    (let ((found (or (and (= (ir-kind node) "method-call")
                         (array-text-key-p (js-nth 1 (children node))))
                    (and (js-call (js-array "call" "invoke" "apply-call") :includes (ir-kind node))
                         (qualified-apply-reference-p (js-nth 0 (children node)))))))
      (js-call (children node) :forEach
        (lambda (child) (when (node-uses-array-text-p child) (setq found t)))) found))

  (defun reference-runtime-requirements (program)
    (js-object
      :math (js-call (program-body program) :some node-uses-math-runtime-p)
      :numericCoercion (program-uses-numeric-coercion-p program)
      :imul (js-call (program-body program) :some node-uses-imul-p)
      :arrayText (js-call (program-body program) :some node-uses-array-text-p)
      :numberConversion (program-uses-number-conversion-p program)
      :hostIdentityToken (program-uses-host-identity-token-p program)
      :literal (program-uses-literal-runtime-p program)
      :collection (program-uses-collection-runtime-p program)
      :binding (program-uses-binding-runtime-p program)
      :list (program-uses-list-runtime-p program)
      :value (program-uses-value-runtime-p program)))

  (defun math-runtime-reference-p (value)
    (and (= (value-type value) "string")
      (or (js-call (js-array "Math" "globalThis/Math" "globalThis.Math") :includes value)
        (js-call (js-array "Math/" "Math." "globalThis/Math/" "globalThis/Math."
                           "globalThis.Math/" "globalThis.Math.") :some
          (lambda (prefix) (js-call value :startsWith prefix))))))
  (defun node-uses-math-runtime-p (node)
    (or (and (js-call (js-array "reference" "raw-javascript") :includes (ir-kind node))
             (math-runtime-reference-p (ir-value node)))
        (js-call (children node) :some node-uses-math-runtime-p)))

  (defun node-uses-imul-p (node)
    (or (and (= (ir-kind node) "intrinsic") (= (ir-value node) "imul32"))
        (js-call (children node) :some node-uses-imul-p)))

  (defun node-uses-numeric-coercion-p (node)
    (or (and (= (ir-kind node) "intrinsic") (numeric-coercion-intrinsic-p (ir-value node))
             (or (/= (ir-value node) "*") (> (js-length (children node)) 1)))
      (let ((found false))
        (js-call (children node) :forEach (lambda (child) (when (node-uses-numeric-coercion-p child) (setq found t)))) found)))
  (defun program-uses-numeric-coercion-p (program)
    (let ((found false))
      (js-call (program-body program) :forEach (lambda (node) (when (node-uses-numeric-coercion-p node) (setq found t)))) found))

  (defun static-literal-key-p (node index static-key-index)
    (and static-key-index
         (= index static-key-index)
         (= (ir-kind node) "literal")
         (= (literal-kind node) "keyword")))

  (defun collect-runtime-requirements
      (node requirements suppress-literal)
    (let ((kind (ir-kind node))
           (value (ir-value node))
           (nodes (children node))
           (static-key-index (literal-runtime-static-key-index node))
          (index 0)
          (child nil))
      (when (or (and (= kind "method-call") (array-text-key-p (js-nth 1 nodes)))
                (and (js-call (js-array "call" "invoke" "apply-call") :includes kind)
                     (qualified-apply-reference-p (js-nth 0 nodes))))
        (put requirements :arrayText t))
      (when (and (js-call (js-array "reference" "raw-javascript") :includes kind)
                 (math-runtime-reference-p value))
        (put requirements :math t))
      (cond
        ((= kind "map-binding-pattern")
         (put requirements :binding t))
        ((and (not suppress-literal)
              (or (= kind "persistent-list-literal")
                  (= kind "persistent-vector-literal")
                  (= kind "persistent-map-literal")
                  (= kind "persistent-set-literal")
                  (= kind "persistent-queue-literal")))
         (put requirements :literal t))
        ((and (not suppress-literal)
              (= kind "quoted-literal")
              (quoted-uses-literal-runtime-p value))
         (put requirements :literal t))
        ((and (not suppress-literal)
              (= kind "literal")
              (= (literal-kind node) "keyword"))
         (put requirements :literal t))
        ((= kind "intrinsic")
         (when (= value "imul32") (put requirements :imul t))
         (when (and (numeric-coercion-intrinsic-p value)
                    (or (/= value "*") (> (js-length nodes) 1)))
           (put requirements :numericCoercion t))
         (cond
           ((= value "string-to-number") (put requirements :numberConversion t))
           ((= value "host-identity-token")
            (put requirements :hostIdentityToken t))
           ((or (= value "nth") (= value "length"))
            (put requirements :collection t))
           ((or (= value "car") (= value "cdr") (= value "cons"))
            (put requirements :list t))
           ((= value "equal")
            (put requirements :value t)))))
      (while (< index (get nodes :length))
        (setq child (js-nth index nodes))
        (collect-runtime-requirements
          child
          requirements
          (or suppress-literal
              (static-literal-key-p child index static-key-index)))
        (setq index (1+ index))))
    requirements)

  (defun runtime-requirements (program)
    (let ((requirements
           (js-object
             :math false
             :numericCoercion false
             :imul false
             :arrayText false
             :numberConversion false
             :hostIdentityToken false
             :literal false
             :collection false
             :binding false
             :list false
             :value false)))
      (js-call (program-body program) :forEach
        (lambda (node)
          (collect-runtime-requirements node requirements false)))
      requirements))

  (defun collect-portable-metadata (node portable exported)
    (when (and (= (ir-kind node) "function-declaration")
               (ir-property node "portable"))
      (js-call portable :push node))
    (when (= (ir-kind node) "export-declaration")
      (js-call (children node) :forEach
        (lambda (reference)
          (js-call exported :push (ir-value reference)))))
    (js-call (children node) :forEach
      (lambda (child)
        (collect-portable-metadata child portable exported))))

  (defun emit-portable-manifest (program)
    (let ((portable (js-array))
          (exported (js-array)))
      (js-call (program-body program) :forEach
        (lambda (node)
          (collect-portable-metadata node portable exported)))
      (if (= (get portable :length) 0)
          (text-fragment "")
        (let ((implicit
               (js-call portable :filter
                 (lambda (node)
                   (not (js-call exported :includes (ir-value node)))))))
          (combine
            (js-array (if (> (get implicit :length) 0)
                 (combine
                   (js-array "\n\nexport {"
                    (join-fragments
                      (js-call implicit :map
                        (lambda (node) (binding-name (ir-value node))))
                      ", ")
                    "};"))
               "")
             "\nexport const __eliscript_portable__ = Object.freeze(Object.fromEntries(["
             (join-fragments
               (js-call portable :map
                 (lambda (node)
                   (combine
                     (js-array "[" (json-string (ir-value node)) ", "
                      (binding-name (ir-value node)) "]"))))
               ", ")
             "]));"))))))

  (defun emit-module-artifact-in-profile (program)
    (if (prelude-capsule-p program)
        (text-fragment prelude-module)
      (let ((previous tdz-state))
        (setq tdz-state (tdz-prepare program))
        (try (emit-module-artifact-in-profile-ready program)
          (finally (setq tdz-state previous))))))

  (defun runtime-capsule-p (program entries)
    (let* ((filename (program-filename program)) (body (program-body program))
           (module (if (= (js-length body) 1) (aref body 0) nil)))
      (and module (= (ir-kind module) "module-declaration")
        (= (value-type filename) "string")
        (js-call entries
          :some (lambda (entry)
            (and (= (ir-value module) (aref entry 1))
              (or (= filename (aref entry 0))
                (and (js-call filename :startsWith "/")
                     (js-call filename :endsWith (+ "/" (aref entry 0)))))))))))

  (defun unicode-bootstrap-capsule-p (program)
    (runtime-capsule-p program
      (js-array
        (js-array "runtime/unicode-case.eli" "eliscript.runtime.unicode-case")
        (js-array "runtime/unicode-case-data.eli" "eliscript.runtime.unicode-case-data"))))

  (defun prelude-capsule-p (program)
    (and (runtime-capsule-p program (js-array (js-array "runtime/prelude.eli" "eliscript.runtime.prelude")))
         (= (js-length (children (aref (program-body program) 0))) 0)))

  (defun emit-module-artifact-in-profile-ready (program)
    (setq temporary-counter 0)
    (setq binding-temporaries (new globalThis.Map))
    (let ((requirements (runtime-requirements program))
          (body
            (join-fragments
              (js-call (program-body program) :map
                (lambda (node) (emit-top-level node)))
              "\n\n")))
      (combine
        (js-array "// Generated by Eliscript. Do not edit.\n"
         (tdz-prologue)
         (if (unicode-bootstrap-capsule-p program) "" "import \"eliscript/runtime/unicode-case.mjs\";\n")
         (if (get requirements :math) "import \"eliscript/runtime/math.mjs\";\n" "")
         (let ((numeric-coercion (and (not numeric-emission-profile) (get requirements :numericCoercion))))
           (prelude-import (get requirements :arrayText)
             (or (get requirements :numberConversion) numeric-coercion)
             numeric-coercion
             (and (not numeric-emission-profile) (get requirements :imul))))
         (if (get requirements :literal)
             literal-runtime-import
           "")
         (if (get requirements :collection)
             collection-runtime-import
           "")
         (if (get requirements :binding)
             binding-runtime
           "")
         (if (get requirements :list)
             list-runtime-import
           "")
         (if (get requirements :value)
             value-runtime-import
           "")
         "const __eliscript_truthy = (value) => value !== false && value != null;\n"
         (if (get requirements :hostIdentityToken)
             host-identity-token-helper
           "")
         "\n"
         body
         (emit-portable-manifest program)
         "\n"))))

  (defun emit-module-artifact (program)
    (let ((previous numeric-emission-profile))
      (setq numeric-emission-profile false)
      (try (emit-module-artifact-in-profile program)
        (finally (setq numeric-emission-profile previous)))))
  (defun emit-module-function-sources (program)
    (let ((previous function-source-profile))
      (setq function-source-profile t)
      (try
        (let* ((artifact (emit-module-artifact program)) (javascript (get artifact :text)))
          (js-object :javascript javascript
            :functions (js-call (get artifact :functions (js-array)) :map
              (lambda (record)
                (js-object :node (get record :node) :start (get record :start) :end (get record :end)
                  :sourceText (js-call javascript :slice (get record :start) (get record :end)))))))
        (finally (setq function-source-profile previous)))))
  ;; Internal code generation entry. The numeric backend must validate the
  ;; complete original program before optimization and before calling this.
  (defun emit-module-numeric (program)
    (let ((previous numeric-emission-profile))
      (setq numeric-emission-profile t)
      (try (get (emit-module-artifact-in-profile program) :text)
        (finally (setq numeric-emission-profile previous)))))

  (defun emit-module (program)
    (get (emit-module-artifact program) :text))

  (defun emit-module-with-source-map
      (program source generated-name source-name)
    (let* ((artifact (emit-module-artifact program))
           (javascript (get artifact :text))
           (resolved-source-name
            (or source-name (program-filename program) "<string>")))
      (js-object
        :javascript javascript
        :sourceMap
        (create-source-map
          javascript
          (get artifact :marks)
          source
          resolved-source-name
          generated-name))))

  (export
    indent
    reference-indent
    locate
    reference-locate
    emit-expression
    emit-top-level
    emit-module-artifact
    emit-module-function-sources
    emit-module
    emit-module-numeric
    emit-module-with-source-map
    runtime-requirements
    reference-runtime-requirements))
