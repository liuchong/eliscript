(module bootstrap.compiler.ir
  (defconst ir-format "eliscript-ir")
  (defconst ir-version 1)
  (defconst ir-max-depth 512)

  (defconst node-kinds
    (js-call globalThis.Object :freeze
      (js-array "module-declaration" "import-declaration" "import-default"
       "import-namespace" "import-named" "variable-declaration"
       "function-declaration" "export-declaration" "export-default"
       "expression-statement" "parameter-binding" "array-binding-pattern"
       "map-binding-pattern" "map-binding-entry"
       "binding-name" "binding-hole" "reference" "literal"
       "array-literal" "persistent-list-literal" "persistent-vector-literal"
       "persistent-map-literal" "persistent-set-literal" "persistent-queue-literal"
       "quoted-literal" "function-expression"
       "await-expression" "throw-expression" "try-expression"
       "catch-clause" "catch-binding" "finally-clause" "conditional"
       "conditional-sugar" "conditional-chain" "conditional-clause"
       "sequence" "lexical-bindings" "lexical-binding" "assignment"
       "assignment-pair" "loop" "binding-loop" "recur"
       "short-circuit" "intrinsic"
       "object-literal" "object-property" "property-read" "property-write"
       "method-call" "constructor-call" "raw-javascript" "print"
       "string-concat" "invoke" "apply-call" "call")))

  (defconst ir-filename-key "filename")
  (defconst ir-body-key "body")
  (defconst ir-kind-key "kind")
  (defconst ir-span-key "span")
  (defconst ir-value-key "value")
  (defconst ir-children-key "children")
  (defconst ir-properties-key "properties")
  (defconst canonical-node-kinds
    (let ((kinds (new globalThis.Map)))
      (js-call node-kinds :forEach (lambda (kind) (js-call kinds :set kind kind)))
      kinds))

  (defconst fail
    (lambda (message)
      (throw (new (js* "Error") message))))

  (defconst make-schema-error
    (lambda (message options)
      (let ((error (if (eq options undefined)
                       (new (js* "Error") message)
                     (new (js* "Error") message options))))
        (put error :eliscriptDiagnostic
          (js-object :format "eliscript-diagnostic" :version 1
            :code "ELI-I0001" :severity "error" :phase "ir-schema" :message message))
        error)))

  (defconst schema-fail
    (lambda (message)
      (throw (make-schema-error message undefined))))

  (defconst array-p (js* "Array.isArray"))
  (defconst dense-json-array-p
    (lambda (value)
      (if (or (not (Array/isArray value))
              (not (Object/is (Object/getPrototypeOf value) globalThis.Array.prototype))
              (/= (js-length (Object/getOwnPropertySymbols value)) 0)) false
        (let ((names (Object/getOwnPropertyNames value)))
          (if (or (/= (js-length names) (+ (aref value "length") 1))
                  (/= (aref names (1- (js-length names))) "length")) false
            (let ((index 0) (valid t))
              (while (and valid (< index (aref value "length")))
                (let ((name (funcall (js* "String") index)))
                  (if (/= (aref names index) name) (setq valid false)
                    (let ((descriptor (Object/getOwnPropertyDescriptor value name)))
                      (unless (and (funcall (js* "Boolean") descriptor)
                                   (funcall (js* "Boolean") (aref descriptor "enumerable"))
                                   (Object/hasOwn descriptor "value"))
                        (setq valid false)))))
                (setq index (1+ index))) valid))))))
  (defconst plain-record-keys
    (lambda (value)
      (if (or (nil? value) (/= (js* "typeof value") "object") (Array/isArray value)) nil
        (let ((prototype (Object/getPrototypeOf value)))
          (if (and (not (Object/is prototype globalThis.Object.prototype)) (not (nil? prototype))) nil
            (if (/= (js-length (Object/getOwnPropertySymbols value)) 0) nil
              (let ((names (Object/getOwnPropertyNames value)) (index 0) (valid t))
                (while (and valid (< index (js-length names)))
                  (let ((descriptor (Object/getOwnPropertyDescriptor value (aref names index))))
                    (unless (and (funcall (js* "Boolean") descriptor)
                                 (funcall (js* "Boolean") (aref descriptor "enumerable"))
                                 (Object/hasOwn descriptor "value"))
                      (setq valid false)))
                  (setq index (1+ index)))
                (if valid (js-call names :sort) nil))))))))
  (defconst has-own (js* "Object.hasOwn"))
  (defconst finite-number-p (js* "Number.isFinite"))
  (defconst non-negative-integer-p
    (lambda (value)
      (and (Number/isSafeInteger value) (>= value 0))))
  (defconst positive-integer-p
    (lambda (value)
      (and (Number/isSafeInteger value) (>= value 1))))
  (defconst parse-json
    (lambda (source reject)
      (try (JSON/parse source)
        (catch error
          (let ((message "invalid canonical IR JSON"))
            (if (Object/is reject schema-fail)
                (throw (make-schema-error message (js-object :cause error)))
              (funcall reject message)))))))

  (defconst node-kind-set
    (new globalThis.Set node-kinds))

  (defun require-closed-record (value expected label)
    (let ((keys (funcall plain-record-keys value)))
      (when (nil? keys)
        (schema-fail (str label " must be a plain data object")))
      (unless (= (get keys :length) (get expected :length))
        (schema-fail (str label " has unknown or missing fields")))
      (js-call expected :forEach
        (lambda (key)
          (unless (js-call keys :includes key)
            (schema-fail (str label " has unknown or missing fields")))))
      keys))

  ;; These private arrays contain only complete string tokens. Invoke the
  ;; captured native join directly instead of the language's general array
  ;; text-conversion path, which also handles arbitrary and cyclic values.
  (defconst canonical-json-array-join (get (js* "Array.prototype") :join))

  (defun make-canonical-json-sink ()
    (js-object :chunks (js-array) :parts (js-array) :length 0))

  (defun canonical-json-flush (sink)
    (when (> (js-length (get sink :parts)) 0)
      (js-call (get sink :chunks) :push
        (Reflect/apply canonical-json-array-join (get sink :parts) (js-array "")))
      (put sink :parts (js-array)) (put sink :length 0)))

  (defun canonical-json-token (sink token)
    ;; Bound pending small tokens rather than retaining a string for every
    ;; completed subtree. JSON.stringify must still produce each primitive
    ;; string token atomically; keep an oversized token as its own chunk.
    (let ((length (js-length token)))
      (when (> (+ (get sink :length) length) 65536) (canonical-json-flush sink))
      (if (>= length 65536)
        (js-call (get sink :chunks) :push token)
        (progn
          (js-call (get sink :parts) :push token)
          (put sink :length (+ (get sink :length) length))))))

  (defun canonical-json-finish (sink)
    (canonical-json-flush sink)
    (Reflect/apply canonical-json-array-join (get sink :chunks) (js-array "")))

  (defun canonical-json-array (value path active depth &optional collect-output sink)
    (unless (funcall dense-json-array-p value)
      (schema-fail (str path " must be a dense plain array")))
    (when (js-call active :has value)
      (schema-fail (str path " contains a cyclic JSON value")))
    (js-call active :add value)
    (let ((collect (not (eq collect-output false)))
          (index 0))
      (when collect (canonical-json-token sink "["))
      (while (< index (get value :length))
        (when (and collect (> index 0)) (canonical-json-token sink ","))
        (canonical-json-value
          (js-nth index value)
          (str path "[" index "]")
          active
          (1+ depth) collect sink)
        (setq index (1+ index)))
      (js-call active :delete value)
      (when collect (canonical-json-token sink "]"))))

  (defun canonical-json-record (value path active depth &optional collect-output sink)
    (let ((keys (funcall plain-record-keys value)))
      (when (nil? keys)
        (schema-fail (str path " must be a plain data object")))
      (when (js-call active :has value)
        (schema-fail (str path " contains a cyclic JSON value")))
      (js-call active :add value)
      (let ((collect (not (eq collect-output false))) (index 0))
        (when collect (canonical-json-token sink "{"))
        (js-call keys :forEach
          (lambda (key)
            (when collect
              (when (> index 0) (canonical-json-token sink ","))
              (canonical-json-token sink (JSON/stringify key))
              (canonical-json-token sink ":"))
            (canonical-json-value (get value key) (str path "." key)
              active (1+ depth) collect sink)
            (setq index (1+ index))))
        (js-call active :delete value)
        (when collect (canonical-json-token sink "}")))))

  (defun canonical-json-value (value path active depth &optional collect-output sink)
    (when (> depth ir-max-depth)
      (schema-fail (str path " exceeds IR nesting depth " ir-max-depth)))
    (let* ((type (js* "typeof value")) (collect (not (eq collect-output false)))
           (output (when collect (or sink (make-canonical-json-sink)))))
      (cond
       ((nil? value) (when collect (canonical-json-token output "null")))
       ((= type "boolean") (when collect (canonical-json-token output (if value "true" "false"))))
       ((= type "number")
        (unless (funcall finite-number-p value)
          (schema-fail (str path " must contain only finite numbers")))
        (when collect (canonical-json-token output (if (Object/is value (- 0)) "-0" (JSON/stringify value)))))
       ((= type "string") (when collect (canonical-json-token output (JSON/stringify value))))
       ((funcall array-p value)
        (canonical-json-array value path active depth collect output))
       ((= type "object")
        (canonical-json-record value path active depth collect output))
       (t
        (schema-fail (str path " contains unsupported JSON type " type))))
      (when (and collect (not sink)) (canonical-json-finish output))))

  (defun canonical-json (value)
    (canonical-json-value value "$" (new globalThis.Set) 0))

  (defun validate-span (span)
    (require-closed-record
      span
      (js-array "column" "end" "endColumn" "endLine" "filename" "line" "start")
      "IR span")
    (unless (= (js* "typeof span.filename") "string")
      (schema-fail "IR span filename must be a string"))
    (js-call (js-array "start" "end") :forEach
      (lambda (key)
        (unless (funcall non-negative-integer-p (get span key))
          (schema-fail (str "IR span " key " must be a non-negative integer")))))
    (js-call (js-array "line" "column" "endLine" "endColumn") :forEach
      (lambda (key)
        (unless (funcall positive-integer-p (get span key))
          (schema-fail (str "IR span " key " must be a positive integer")))))
    (when (> (get span :start) (get span :end))
      (schema-fail "IR span start must not exceed end"))
    span)

  (defun validate-node (node active depth)
    (when (> depth ir-max-depth)
      (schema-fail (str "IR node exceeds nesting depth " ir-max-depth)))
    (when (js-call active :has node)
      (schema-fail "IR node children must not contain a cycle"))
    (let ((keys (funcall plain-record-keys node)))
      (when (nil? keys)
        (schema-fail "IR node must be a plain data object"))
      (let ((expected
             (if (js-call keys :includes "properties")
                 (js-array "children" "kind" "properties" "span" "value")
               (js-array "children" "kind" "span" "value"))))
        (require-closed-record node expected "IR node")))
    (unless (and (= (js* "typeof node.kind") "string")
                 (node-kind-p (get node :kind)))
      (schema-fail (str "unknown Eliscript IR node kind: " (get node :kind))))
    (validate-span (get node :span))
    (unless (funcall dense-json-array-p (get node :children))
      (schema-fail "IR node children must be a dense plain array"))
    (when (funcall has-own node "properties")
      (when (nil? (funcall plain-record-keys (get node :properties)))
        (schema-fail "IR node properties must be a plain data object")))
    (js-call active :add node)
    (js-call (get node :children) :forEach
      (lambda (child) (validate-node child active (1+ depth))))
    (js-call active :delete node)
    node)

  (defun validate-program (program)
    (require-closed-record
      program (js-array "body" "filename") "IR program")
    (unless (= (js* "typeof program.filename") "string")
      (schema-fail "IR program filename must be a string"))
    (unless (funcall dense-json-array-p (get program :body))
      (schema-fail "IR program body must be a dense plain array"))
    (let ((active (new globalThis.Set)))
      (js-call (get program :body) :forEach
        (lambda (node) (validate-node node active 0))))
    program)

  (defun validate-document (document)
    (require-closed-record
      document (js-array "format" "program" "version") "IR document")
    (unless (= (get document :format) ir-format)
      (schema-fail (str "unsupported IR format: " (get document :format))))
    (unless (= (get document :version) ir-version)
      (schema-fail (str "unsupported IR version: " (get document :version))))
    (validate-program (get document :program))
    document)

  (defun serialize-program (program)
    (let ((document
           (js-object
             :format ir-format
             :version ir-version
             :program program)))
      (validate-document document)
      (canonical-json document)))

  (defun validate-serializable-program (program)
    ;; Schema validation alone does not inspect arbitrary value/properties
    ;; payloads. Retain both original passes and the document wrapper's JSON
    ;; paths/depth, while avoiding an unused full canonical output string.
    (let ((document (js-object :format ir-format :version ir-version :program program)))
      (validate-document document)
      (canonical-json-value document "$" (new globalThis.Set) 0 false)
      program))

  (defun deserialize-program (source)
    (unless (= (js* "typeof source") "string")
      (schema-fail "canonical IR source must be a string"))
    (let* ((document (funcall parse-json source schema-fail))
           (_validated (validate-document document))
           (canonical (canonical-json document)))
      (unless (= source canonical)
        (schema-fail "IR source is valid JSON but not canonical IR JSON"))
      (get document :program)))

  (defun node-kind-p (kind)
    (js-call node-kind-set :has kind))

  (defun reference-node-kind-p (kind)
    (js-call node-kinds :includes kind))

  (defun make-program (filename body)
    (unless (Array/isArray body)
      (fail "IR program body must be an array"))
    (unless (js-call body :every node-p)
      (fail "IR program body must contain only IR nodes"))
    (js-object (progn ir-filename-key) filename (progn ir-body-key) body))

  (defun node-p (value)
    (and value
         (= (js* "typeof value") "object")
         (node-kind-p (get value :kind))))

  (defun reference-node-p (value)
    (and value
         (= (js* "typeof value") "object")
         (reference-node-kind-p (get value :kind))))

  (defun make-node (kind span value children properties)
    (unless (node-kind-p kind)
      (fail (str "unknown Eliscript IR node kind: " kind)))
    (unless (Array/isArray children)
      (fail "IR node children must be an array"))
    (unless (js-call children :every node-p)
      (fail "IR node children must all be IR nodes"))
    (let ((node
           (js-object
             (progn ir-kind-key) (js-call canonical-node-kinds :get kind)
             (progn ir-span-key) span
             (progn ir-value-key) value
             (progn ir-children-key) children)))
      (when properties
        (put node ir-properties-key properties))
      node))

  (defun program-filename (program)
    (get program :filename))

  (defun program-body (program)
    (get program :body))

  (defun ir-kind (node)
    (get node :kind))

  (defun ir-span (node)
    (get node :span))

  (defun ir-value (node)
    (get node :value))

  (defun ir-children (node)
    (get node :children))

  (defun ir-properties (node)
    (get node :properties))

  (defun ir-property (node name)
    (let ((properties (ir-properties node)))
      (and properties (get properties name))))

  (export
    ir-format
    ir-version
    node-kinds
    node-kind-p
    reference-node-kind-p
    node-p
    reference-node-p
    make-program
    make-node
    program-filename
    program-body
    ir-kind
    ir-span
    ir-value
    ir-children
    ir-properties
    ir-property
    validate-serializable-program
    serialize-program
    deserialize-program))
