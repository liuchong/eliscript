(module bootstrap.compiler.reader
  (import "./syntax.mjs"
    make-span
    literal-node
    undefined-node
    symbol-node
    keyword-node
    collection-node)
  (defconst fail
    (lambda (diagnostic)
      (let* ((p (aref (aref diagnostic "location") "start"))
             (Constructor globalThis.Error)
             (error (new Constructor
               (let* ((file-value (aref (aref diagnostic "location") "file"))
                      (file (js-call "" :concat file-value))
                      (line-value (aref p "line"))
                      (line (js-call "" :concat line-value))
                      (column-value (aref p "column"))
                      (column (js-call "" :concat column-value))
                      (message-value (aref diagnostic "message"))
                      (message (js-call "" :concat message-value)))
                 (+ file ":" line ":" column ": " message)))))
        (put error :eliscriptDiagnostic diagnostic)
        (throw error))))
  (defconst number-pattern
    (new globalThis.RegExp "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"))
  (defconst native-whitespace-code-p
    (lambda (code)
      (or (eq code 32) (eq code 9) (eq code 10) (eq code 13) (eq code 12))))
  (defconst native-delimiter-code-p
    (lambda (code)
      (or (eq code undefined) (eq code 32) (eq code 9) (eq code 10) (eq code 13) (eq code 12)
        (eq code 40) (eq code 41) (eq code 91) (eq code 93) (eq code 123) (eq code 125)
          (eq code 34) (eq code 39) (eq code 44) (eq code 59) (eq code 96))))
  (defun make-state
    (source filename)
    (js-object :source source :filename filename :index 0 :offset 0 :line 1 :column 1
      :atomNames (new globalThis.Map)))

  (defun reader-atom-name (state name)
    ;; This table belongs only to the private read-string state. Syntax nodes
    ;; keep immutable names directly, never the state or the table itself.
    (let ((names (get state :atomNames nil)))
      (if (nil? names) name
        (let ((existing (js-call names :get name)))
          (if (undefined? existing)
              (progn (js-call names :set name name) name)
            existing)))))
  (defun mark
    (state)
    (js-object
      :index
      (get state :index)
      :offset
      (get state :offset)
      :line
      (get state :line)
      :column
      (get state :column)))
  (defun span-from
    (state start)
    (make-span
      (get state :filename)
      (get start :offset)
      (get state :offset)
      (get start :line)
      (get start :column)
      (get state :line)
      (get state :column)))
  (defun fail-at
    (state position message &optional width)
    (let ((span-width (or width 1)))
      (fail
        (js-object
          :format
          "eliscript-diagnostic"
          :version
          1
          :code
          "ELI-R0001"
          :severity
          "error"
          :phase
          "reader"
          :message
          message
          :location
          (js-object
            :file
            (or (get state :filename) "<input>")
            :start
            (js-object
              :offset
              (get position :offset)
              :line
              (get position :line)
              :column
              (get position :column))
            :end
            (js-object
              :offset
              (+ (get position :offset) span-width)
              :line
              (get position :line)
              :column
              (+ (get position :column) span-width)))))))
  (defun peek-code
    (state)
    (js-call (get state :source) :codePointAt (get state :index)))
  (defun peek-code-ahead
    (state code-units)
    (js-call (get state :source) :codePointAt (+ (get state :index) code-units)))
  (defun advance
    (state)
    (let ((code (peek-code state)))
      (unless (eq code undefined)
        (put state :index (+ (get state :index) (if (> code 65535) 2 1)))
        (put state :offset (1+ (get state :offset)))
        (if (= code 10)
          (progn (put state :line (1+ (get state :line))) (put state :column 1))
          (put state :column (1+ (get state :column)))))
      code))
  (defun reference-whitespace-code-p
    (code)
    (or (= code 32) (= code 9) (= code 10) (= code 13) (= code 12)))
  (defun whitespace-code-p (code) (funcall native-whitespace-code-p code))
  (defun reference-delimiter-code-p
    (code)
    (or
      (eq code undefined)
      (reference-whitespace-code-p code)
      (= code 40)
      (= code 41)
      (= code 91)
      (= code 93)
      (= code 123)
      (= code 125)
      (= code 34)
      (= code 39)
      (= code 44)
      (= code 59)
      (= code 96)))
  (defun delimiter-code-p (code) (funcall native-delimiter-code-p code))
  (defun closing-code-p (code) (or (= code 41) (= code 93) (= code 125)))
  (defun code-character (code) (js-call globalThis.String :fromCodePoint code))
  (defun invalid-closing
    (state position code)
    (fail-at
      state
      position
      (str "Invalid read syntax: \"" (code-character code) "\"")
      1))
  (defun reference-skip-space-and-comments (state)
    (let ((done false))
      (while (not done)
        (let ((code (peek-code state)))
          (cond
            ((eq code undefined)
             (setq done t))
            ((whitespace-code-p code)
             (advance state))
            ((= code 59)
             (while (and (not (eq (peek-code state) undefined))
                         (not (= (peek-code state) 10)))
               (advance state)))
            (t (setq done t)))))))

  (defconst native-skip-space-and-comments
    (lambda (state whitespace)
    (let* ((source (aref state "source")) (index (aref state "index"))
           (offset (aref state "offset")) (line (aref state "line"))
           (column (aref state "column")) (done false))
      (while (and (eq done false) (< index (aref source "length")))
        (let* ((code (js-call source :codePointAt index))
               (answer (funcall whitespace code)))
          (if (js* "!!answer")
            (progn
              (setq index (+ index 1)) (setq offset (+ offset 1))
              (if (eq code 10) (progn (setq line (+ line 1)) (setq column 1))
                (setq column (+ column 1))))
            (if (eq code 59)
              (while (and (< index (aref source "length"))
                          (not (eq (js-call source :charCodeAt index) 10)))
                (setq index (+ index (if (> (js-call source :codePointAt index) 65535) 2 1)))
                (setq offset (+ offset 1)) (setq column (+ column 1)))
              (setq done t)))))
      (put state :index index) (put state :offset offset)
      (put state :line line) (put state :column column) nil)))
  (defun skip-space-and-comments
    (state)
    (funcall native-skip-space-and-comments state native-whitespace-code-p))
  (defun reference-read-token (state start)
    (while (not (delimiter-code-p (peek-code state)))
      (advance state))
    (js-call
      (get state :source)
      :slice
      (get start :index)
      (get state :index)))

  (defconst native-read-token
    (lambda (state start delimiter)
    (let* ((source (aref state "source")) (index (aref state "index"))
           (consumed 0) (done false))
      (while (eq done false)
        (let* ((code (js-call source :codePointAt index))
               (answer (funcall delimiter code)))
          (if (js* "!!answer") (setq done t)
            (progn (setq index (+ index (if (> code 65535) 2 1)))
                   (setq consumed (1+ consumed))))))
      (put state :index index)
      (put state :offset (+ (aref state "offset") consumed))
      (put state :column (+ (aref state "column") consumed))
      (js-call source :slice (aref start "index") index))))
  (defun read-token
    (state start)
    (funcall native-read-token state start native-delimiter-code-p))
  (defun queue-opening-index
    (state)
    (let*
      ((source (get state :source)) (start (get state :index)) (tag-end (+ start 6)))
      (if (not (= (js-call source :slice start tag-end) "#queue"))
        -1
        (let ((cursor tag-end) (done false))
          (while (and (< cursor (get source :length)) (not done))
            (let ((code (js-call source :codePointAt cursor)))
              (cond
                ((reference-whitespace-code-p code)
                  (setq cursor (+ cursor (if (> code 65535) 2 1))))
                ((= code 59)
                  (while
                    (and
                      (< cursor (get source :length))
                      (not (= (js-call source :codePointAt cursor) 10)))
                    (setq cursor (1+ cursor))))
                (t (setq done t)))))
          (if
            (and
              (< cursor (get source :length))
              (= (js-call source :codePointAt cursor) 91))
            cursor
            -1)))))
  (defun number-token-p (token) (js-call number-pattern :test token))
  (defun valid-keyword-name-p
    (name)
    (let ((separator (js-call name :indexOf "/")))
      (and
        (> (get name :length) 0)
        (or
          (= separator -1)
          (and
            (> separator 0)
            (< separator (1- (get name :length)))
            (= (js-call name :indexOf "/" (1+ separator)) -1))))))
  (defun read-atom
    (state start)
    (let* ((token (read-token state start)) (span (span-from state start)))
      (cond ((= token "nil") (literal-node nil span))
        ((= token "t") (literal-node t span))
        ((= token "false") (literal-node false span))
        ((= token "undefined") (undefined-node span))
        ((js-call token :startsWith ":")
          (let ((name (js-call token :slice 1)))
            (unless (valid-keyword-name-p name)
              (fail-at
                state
                start
                (str "invalid keyword literal: " token)
                (- (get state :offset) (get start :offset))))
            (keyword-node (reader-atom-name state name) span)))
        ((number-token-p token) (literal-node (funcall globalThis.Number token) span))
        (t (symbol-node (reader-atom-name state token) span)))))

  (defun string-escape-digit (code radix)
    (let ((digit
            (cond
              ((and (>= code 48) (<= code 57)) (- code 48))
              ((and (>= code 65) (<= code 70)) (+ 10 (- code 65)))
              ((and (>= code 97) (<= code 102)) (+ 10 (- code 97)))
              (t -1))))
      (if (and (>= digit 0) (< digit radix)) digit -1)))

  (defun read-string-radix (state position radix required)
    (let ((value 0) (count 0) (done false))
      (while (and (not done) (or (= required 0) (< count required)))
        (let* ((code (peek-code state))
               (digit (if (eq code undefined) -1 (string-escape-digit code radix))))
          (if (< digit 0)
              (setq done t)
            (progn
              (advance state)
              (setq value (+ (* value radix) digit))
              (setq count (1+ count))
              (when (> value 4194303)
                (fail-at state position "character escape out of range"))))))
      (when (or (= count 0) (and (> required 0) (/= count required)))
        (fail-at state position "invalid character escape digits"))
      value))

  (defun read-string-character (state position)
    (let ((code (advance state)))
      (when (eq code undefined)
        (fail-at state position "unexpected end of input"))
      (if (= code 92) (read-string-escape state position) code)))

  (defun string-control-character (state position code)
    (let* ((meta (bit-and code 128)) (base (bit-and code 127)))
      (when (> code 255)
        (fail-at state position "invalid modifier in string"))
      (cond
        ((= base 63) (bit-or meta 127))
        ((< base 32) code)
        ((and (>= base 64) (<= base 95)) (bit-or meta (- base 64)))
        ((and (>= base 97) (<= base 122)) (bit-or meta (- base 96)))
        (t (fail-at state position "invalid modifier in string")))))

  (defun read-string-escape (state position)
    (let ((code (advance state)))
      (when (eq code undefined)
        (fail-at state position "unexpected end of input"))
      (cond
        ((= code 97) 7)
        ((= code 98) 8)
        ((= code 116) 9)
        ((= code 110) 10)
        ((= code 118) 11)
        ((= code 102) 12)
        ((= code 114) 13)
        ((= code 101) 27)
        ((= code 100) 127)
        ((= code 115) 32)
        ((or (= code 10) (= code 32)) -1)
        ((and (>= code 48) (<= code 55))
         (let ((value (- code 48)) (count 1) (done false))
           (while (and (< count 3) (not done))
             (let* ((next (peek-code state))
                    (digit (if (eq next undefined) -1 (string-escape-digit next 8))))
               (if (< digit 0)
                   (setq done t)
                 (progn
                   (advance state)
                   (setq value (+ (* value 8) digit))
                   (setq count (1+ count))))))
           value))
        ((= code 120) (read-string-radix state position 16 0))
        ((= code 117) (read-string-radix state position 16 4))
        ((= code 85) (read-string-radix state position 16 8))
        ((= code 94)
         (string-control-character state position (read-string-character state position)))
        ((or (= code 67) (= code 77) (= code 83) (= code 65) (= code 72))
         (unless (= (peek-code state) 45)
           (fail-at state position "character modifier must be followed by -"))
         (advance state)
         (let ((value (read-string-character state position)))
           (cond
             ((= code 67) (string-control-character state position value))
             ((= code 77)
              (unless (and (>= value 0) (<= value 255))
                (fail-at state position "invalid modifier in string"))
              (bit-or value 128))
             ((= code 83)
              (unless (and (>= value 0) (<= value 255))
                (fail-at state position "invalid modifier in string"))
              (let ((meta (bit-and value 128)) (base (bit-and value 127)))
                (cond
                  ((and (>= base 97) (<= base 122)) (bit-or meta (- base 32)))
                  ((and (>= base 65) (<= base 90)) value)
                  (t (fail-at state position "invalid modifier in string")))))
             (t (fail-at state position "invalid modifier in string")))))
        ((= code 78)
         (unless (= (advance state) 123)
           (fail-at state position "invalid Unicode character name escape"))
         (unless (and (= (advance state) 85) (= (advance state) 43))
           (fail-at state position "Unicode character name requires U+ code point"))
         (let ((value (read-string-radix state position 16 0)))
           (unless (and (= (advance state) 125) (<= value 1114111))
             (fail-at state position "invalid Unicode character name escape"))
           value))
        (t code))))

  (defun decode-emacs-string-literal (raw owner start)
    ;; JSON is the fast common subset. Decode other string forms directly as
    ;; Lisp, including raw newlines, octal/hex escapes, and line continuations.
    ;; Keep source positions in Unicode scalar offsets and preserve UTF-16 units.
    (let* ((state (make-state raw (get owner :filename)))
           (parts (js-array)) (chunk 1) (done false))
      (put state :offset (get start :offset))
      (put state :line (get start :line))
      (put state :column (get start :column))
      (advance state)
      (while (not done)
        (let* ((position (mark state)) (index (get state :index))
               (code (advance state)))
          (when (eq code undefined)
            (fail-at state start "unexpected end of input"))
          (cond
            ((= code 34)
             (js-call parts :push (js-call raw :slice chunk index))
             (setq done t))
            ((= code 92)
             (js-call parts :push (js-call raw :slice chunk index))
             (let ((value (read-string-escape state position)))
               (when (>= value 0)
                 (when (> value 1114111)
                   (fail-at state position "character escape is outside the Unicode string range"))
                 (js-call parts :push (code-character value))))
             (setq chunk (get state :index))))))
      (js-call parts :join "")))

  (defun read-string-literal
    (state start)
    (let* ((source (get state :source))
           (index (get state :index))
           (offset (get state :offset))
           (line (get state :line))
           (column (get state :column))
           (opening t)
           (escaped false)
           (json-compatible t)
           (done false)
           (ended false))
      (while (not done)
        (let ((code (js-call source :codePointAt index)))
          (if (eq code undefined)
            (progn (setq ended t) (setq done t))
            (progn
              (setq index (+ index (if (> code 65535) 2 1)))
              (setq offset (1+ offset))
              (if (= code 10)
                (progn (setq line (1+ line)) (setq column 1))
                (setq column (1+ column)))
              (when (< code 32) (setq json-compatible false))
              (cond (opening (setq opening false))
                (escaped
                 (unless (or (= code 34) (= code 92) (= code 47)
                             (= code 98) (= code 102) (= code 110)
                             (= code 114) (= code 116) (= code 117))
                   (setq json-compatible false))
                 (setq escaped false))
                ((= code 92) (setq escaped t))
                ((= code 34) (setq done t)))))))
      (put state :index index)
      (put state :offset offset)
      (put state :line line)
      (put state :column column)
      (when ended (fail-at state start "unexpected end of input"))
      (let*
        (
          (raw
            (js-call source :slice (get start :index) index))
          (value (if json-compatible
                     (JSON/parse raw)
                   (decode-emacs-string-literal raw state start))))
        (literal-node value (span-from state start)))))
  (defun read-prefix
    (state start name width)
    (let ((remaining width))
      (while (> remaining 0) (advance state) (setq remaining (1- remaining))))
    (let ((prefix-span (span-from state start)))
      (skip-space-and-comments state)
      (when (eq (peek-code state) undefined)
        (fail-at state start "unexpected end of input"))
      (let ((child (read-node state)))
        (collection-node
          "list"
          (js-array (symbol-node (reader-atom-name state name) prefix-span) child)
          (span-from state start)))))
  (defun read-collection
    (state start closing kind &optional tagged-opening-span)
    (advance state)
    (let ((opening-span (span-from state start)) (items (js-array)) (done false))
      (while (not done)
        (skip-space-and-comments state)
        (let ((code (peek-code state)))
          (cond ((eq code undefined) (fail-at state start "unexpected end of input"))
            ((= code closing) (advance state) (setq done t))
            ((closing-code-p code) (invalid-closing state start code))
            (t (js-call items :push (read-node state))))))
      (let ((span (span-from state start)))
        (cond
          ((= kind "map")
            (when (= (% (get items :length) 2) 1)
              (fail-at
                state
                start
                "map literal must contain an even number of forms"
                (- (get state :offset) (get start :offset))))
            (let ((form-items (js-array (symbol-node (reader-atom-name state "hash-map") opening-span))))
              (js-call items :forEach (lambda (item) (js-call form-items :push item)))
              (collection-node "list" form-items span)))
          ((= kind "set")
            (let ((form-items (js-array (symbol-node (reader-atom-name state "hash-set") opening-span))))
              (js-call items :forEach (lambda (item) (js-call form-items :push item)))
              (collection-node "list" form-items span)))
          ((= kind "queue")
            (let
              (
                (form-items
                  (js-array (symbol-node (reader-atom-name state "queue") (or tagged-opening-span opening-span)))))
              (js-call items :forEach (lambda (item) (js-call form-items :push item)))
              (collection-node "list" form-items span)))
          ((and (= kind "list") (= (get items :length) 0)) (literal-node nil span))
          (t (collection-node kind items span))))))
  (defun read-queue
    (state start opening)
    (let ((tag-end (+ (get start :index) 6)))
      (while (< (get state :index) tag-end) (advance state))
      (let ((tag-span (span-from state start)))
        (while (< (get state :index) opening) (advance state))
        (read-collection state start 93 "queue" tag-span))))
  (defun read-dispatch
    (state start)
    (let ((next (peek-code-ahead state 1)) (queue-opening (queue-opening-index state)))
      (cond ((= next 39) (read-prefix state start "function" 2))
        ((= next 123) (advance state) (read-collection state start 125 "set"))
        ((>= queue-opening 0) (read-queue state start queue-opening))
        (t
          (fail-at
            state
            start
            (str
              "Invalid read syntax: \"#"
              (if (eq next undefined) "" (code-character next))
              "\""))))))
  (defun read-node
    (state)
    (skip-space-and-comments state)
    (let ((start (mark state)) (code (peek-code state)))
      (cond ((eq code undefined) (fail-at state start "unexpected end of input"))
        ((= code 40) (read-collection state start 41 "list"))
        ((= code 91) (read-collection state start 93 "vector"))
        ((= code 123) (read-collection state start 125 "map"))
        ((closing-code-p code) (invalid-closing state start code))
        ((= code 34) (read-string-literal state start))
        ((= code 39) (read-prefix state start "quote" 1))
        ((= code 96) (read-prefix state start "`" 1))
        ((= code 44)
          (if (= (peek-code-ahead state 1) 64)
            (read-prefix state start ",@" 2)
            (read-prefix state start "," 1)))
        ((= code 35) (read-dispatch state start))
        (t (read-atom state start)))))
  (defun read-string
    (source filename)
    (let ((state (make-state source filename)) (forms (js-array)))
      (skip-space-and-comments state)
      (while (not (eq (peek-code state) undefined))
        (js-call forms :push (read-node state))
        (skip-space-and-comments state))
      forms))
  (export
    read-string
    read-token
    reference-read-token
    skip-space-and-comments
    reference-skip-space-and-comments
    whitespace-code-p
    reference-whitespace-code-p
    delimiter-code-p
    reference-delimiter-code-p))
