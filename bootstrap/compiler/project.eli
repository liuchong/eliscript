(module bootstrap.compiler.project
  (defconst project-plan-format "eliscript-project-plan")
  (defconst project-plan-version 1)
  (defconst project-plan-max-iterations 100000)
  (defconst project-build-report-format "eliscript-build-report")
  (defconst project-build-report-version 1)
  (defconst project-build-report-multi-version 2)
  (defconst project-request-format "eliscript-project-request")
  (defconst project-request-version 1)
  (defconst project-request-multi-version 2)
  (defconst project-configuration-version 1)
  (defconst project-configuration-multi-version 2)
  (defconst build-operation-format "eliscript-build-operation")
  (defconst build-operation-version 1)
  (defconst build-operation-multi-version 2)
  (defconst project-cache-format "eliscript-project-cache")
  (defconst project-cache-version 2)
  (defconst project-cache-legacy-version 1)

  (defconst fail
    (js* "(message) => { const error = new Error(message); error.eliscriptDiagnostic = { format: 'eliscript-diagnostic', version: 1, code: 'ELI-B0003', severity: 'error', phase: 'project-plan', message }; throw error; }"))
  (defconst array-p (js* "Array.isArray"))
  (defconst object-p
    (js* "(value) => value !== null && typeof value === 'object' && !Array.isArray(value)"))
  (defconst sorted-set-values
    (js* "(values) => Array.from(values).sort()"))
  (defconst nonnegative-number-p
    (js* "(value) => typeof value === 'number' && Number.isFinite(value) && value >= 0"))
  (defconst boolean-p
    (js* "(value) => typeof value === 'boolean'"))
  (defconst safe-relative-path-p
    (js* "(value) => typeof value === 'string' && value.length > 0 && !/^(?:[\\\\/]|[A-Za-z]:[\\\\/])/.test(value) && !value.split(/[\\\\/]+/u).includes('..')"))
  (defconst project-request-fail
    (js* "(message) => { const error = new Error(message); error.eliscriptDiagnostic = { format: 'eliscript-diagnostic', version: 1, code: 'ELI-B0001', severity: 'error', phase: 'project-build', message }; throw error; }"))
  (defconst project-configuration-fail
    (js* "(message, filename) => { const error = new Error(message); error.eliscriptDiagnostic = { format: 'eliscript-diagnostic', version: 1, code: 'ELI-B0002', severity: 'error', phase: 'project-config', message, ...(filename ? { location: { file: filename } } : {}) }; throw error; }"))
  (defconst project-configuration-keys-v1
    (js-array "schemaVersion" "sourceRoot" "entry" "outDir"
              "portableEntries" "cache"))
  (defconst project-configuration-keys-v2
    (js-array "schemaVersion" "sourceRoot" "entries" "outDir"
              "portableEntries" "cache"))

  (defun require-string (value label)
    (unless (and (= (js* "typeof value") "string")
                 (> (get value :length) 0))
      (fail (str label " must be a non-empty string")))
    value)

  (defun report-milliseconds (value label)
    (unless (funcall nonnegative-number-p value)
      (fail (str label " must be a non-negative finite number")))
    (/ (js-call globalThis.Math :round (* value 1000)) 1000))

  (defun same-string-arrays (left right)
    (and (funcall array-p left)
         (funcall array-p right)
         (= (get left :length) (get right :length))
         (let ((index 0)
               (same t))
           (while (and same (< index (get left :length)))
             (unless (= (js-nth index left) (js-nth index right))
               (setq same false))
             (setq index (1+ index)))
           same)))

  (defun normalize-strings (values label require-entry)
    (unless (funcall array-p values)
      (fail (str label " must be an array")))
    (let ((seen (new globalThis.Set))
          (result (js-array)))
      (js-call values :forEach
        (lambda (value)
          (unless (and (= (js* "typeof value") "string")
                       (> (get value :length) 0))
            (fail (str label " must contain only non-empty strings")))
          (unless (js-call seen :has value)
            (js-call seen :add value)
            (js-call result :push value))))
      (when (and require-entry (= (get result :length) 0))
        (fail (str label " must not be empty")))
      (js-call result :sort)
      result))

  (defun object-field (object key fallback)
    (if (js-call globalThis.Object :hasOwn object key)
        (get object key)
      fallback))

  (defun project-request (input)
    (unless (funcall object-p input)
      (project-request-fail "project request must be an object"))
    (let* ((entry (get input :entry))
           (entries-input (get input :entries))
           (multi (not (undefined? entries-input)))
           (out-dir (get input :outDir))
           (root (get input :root))
           (portable-input (get input :portableEntries))
           (portable-entries
            (progn
              (unless (and (funcall array-p portable-input)
                           (js-call portable-input :every
                             (lambda (name)
                               (and (= (js* "typeof name") "string")
                                    (> (get name :length) 0)))))
                (project-request-fail
                  "project request portable entries are invalid"))
              (normalize-strings
                portable-input "project request portable entries" false)))
           (use-cache (get input :useCache)))
      (when (and multi (not (undefined? entry)))
        (project-request-fail "project request cannot contain entry and entries"))
      (when multi
        (unless (and (funcall array-p entries-input)
                     (> (get entries-input :length) 0)
                     (js-call entries-input :every
                       (lambda (source)
                         (and (= (js* "typeof source") "string")
                              (> (get source :length) 0)))))
          (project-request-fail
            "project request entries must be a non-empty string array")))
      (let ((entries
             (if multi
                 (normalize-strings
                   entries-input "project request entries" t)
               (progn
                 (unless (and (= (js* "typeof entry") "string")
                              (> (get entry :length) 0))
                   (project-request-fail "project request entry is invalid"))
                 (js-array entry)))))
        (when (and multi
                   (not (= (get entries :length) (get entries-input :length))))
          (project-request-fail
            "project request entries must not contain duplicates"))
        (unless (and (= (js* "typeof out_dir") "string")
                     (> (get out-dir :length) 0))
          (project-request-fail "project request output is invalid"))
        (unless (or (nil? root)
                    (and (= (js* "typeof root") "string")
                         (> (get root :length) 0)))
          (project-request-fail "project request root is invalid"))
        (unless (funcall boolean-p use-cache)
          (project-request-fail "project request cache is invalid"))
        (when (and multi (> (get entries :length) 1)
                   (> (get portable-entries :length) 0))
          (project-request-fail
            "multi-entry portable project requests are not supported"))
        (js-call globalThis.Object :freeze portable-entries)
        (js-call globalThis.Object :freeze entries)
        (if multi
            (js-call globalThis.Object :freeze
              (js-object
                :format project-request-format
                :version project-request-multi-version
                :entries entries
                :outDir out-dir
                :root root
                :portableEntries portable-entries
                :useCache use-cache))
          (js-call globalThis.Object :freeze
            (js-object
              :format project-request-format
              :version project-request-version
              :entry entry
              :outDir out-dir
              :root root
              :portableEntries portable-entries
              :useCache use-cache))))))

  (defun build-operation-request (input)
    (unless (funcall object-p input)
      (project-request-fail "build operation request must be an object"))
    (let ((mode (get input :mode)))
      (cond
        ((= mode "single")
         (let* ((source-input
                 (object-field input "input" (js* "undefined")))
                (raw-output
                 (object-field input "output" (js* "undefined")))
                (output
                 (if (js* "raw_output === undefined")
                     (js* "null")
                   raw-output))
                (source-map (object-field input "sourceMap" false))
                (portable-input
                 (object-field input "portableEntries" (js-array))))
           (unless (and (= (js* "typeof source_input") "string")
                        (> (get source-input :length) 0))
             (project-request-fail "single-file input is invalid"))
           (unless (or (nil? output)
                       (and (= (js* "typeof output") "string")
                            (> (get output :length) 0)))
             (project-request-fail "single-file output is invalid"))
           (unless (funcall boolean-p source-map)
             (project-request-fail "single-file source-map option is invalid"))
           (unless (and (funcall array-p portable-input)
                        (js-call portable-input :every
                          (lambda (name)
                            (and (= (js* "typeof name") "string")
                                 (> (get name :length) 0)))))
             (project-request-fail
               "single-file portable entries are invalid"))
           (when (and source-map (nil? output))
             (project-request-fail
               "single-file source maps require an output"))
           (let ((portable-entries
                  (normalize-strings
                    portable-input "single-file portable entries" false)))
             (js-call globalThis.Object :freeze portable-entries)
             (js-call globalThis.Object :freeze
               (js-object
                 :format build-operation-format
                 :version build-operation-version
                 :mode "single"
                 :input source-input
                 :output output
                 :sourceMap source-map
                 :portableEntries portable-entries)))))
        ((= mode "project")
         (let ((request (project-request input)))
           (if (= (get request :version) project-request-multi-version)
               (js-call globalThis.Object :freeze
                 (js-object
                   :format build-operation-format
                   :version build-operation-multi-version
                   :mode "project"
                   :entries (get request :entries)
                   :outDir (get request :outDir)
                   :root (get request :root)
                   :portableEntries (get request :portableEntries)
                   :useCache (get request :useCache)))
             (js-call globalThis.Object :freeze
               (js-object
                 :format build-operation-format
                 :version build-operation-version
                 :mode "project"
                 :entry (get request :entry)
                 :outDir (get request :outDir)
                 :root (get request :root)
                 :portableEntries (get request :portableEntries)
                 :useCache (get request :useCache))))))
        (t
         (project-request-fail "unsupported build operation mode")))))

  (defun project-configuration (input filename)
    (unless (funcall object-p input)
      (project-configuration-fail
        "configuration root must be an object" filename))
    (let* ((schema-version
            (object-field input "schemaVersion" (js* "undefined")))
           (configuration-keys
            (cond
              ((= schema-version project-configuration-version)
               project-configuration-keys-v1)
              ((= schema-version project-configuration-multi-version)
               project-configuration-keys-v2)
              (t
               (project-configuration-fail
                 (str "unsupported schemaVersion: " schema-version) filename)))))
      (let ((unknown (js-array)))
        (js-call (js-call globalThis.Object :keys input) :forEach
          (lambda (key)
            (unless (js-call configuration-keys :includes key)
              (js-call unknown :push key))))
        (js-call unknown :sort)
        (when (> (get unknown :length) 0)
          (project-configuration-fail
            (str "unknown configuration key: " (js-nth 0 unknown))
            filename))))
    (let* ((schema-version
            (object-field input "schemaVersion" (js* "undefined")))
           (source-root (object-field input "sourceRoot" "."))
           (entry (object-field input "entry" (js* "undefined")))
           (entries-input (object-field input "entries" (js* "undefined")))
           (out-dir (object-field input "outDir" (js* "undefined")))
           (portable-input
            (object-field input "portableEntries" (js-array)))
           (cache (object-field input "cache" t)))
      (unless (and (funcall array-p portable-input)
                   (js-call portable-input :every
                     (lambda (name)
                       (and (= (js* "typeof name") "string")
                            (> (get name :length) 0)))))
        (project-configuration-fail
          "portableEntries must be an array of non-empty strings" filename))
      (let* ((portable-entries
              (normalize-strings
                portable-input "configuration portable entries" false))
             (entries
              (if (= schema-version project-configuration-multi-version)
                  (progn
                    (unless (and (funcall array-p entries-input)
                                 (> (get entries-input :length) 0)
                                 (js-call entries-input :every
                                   (lambda (source)
                                     (and (= (js* "typeof source") "string")
                                          (> (get source :length) 0)))))
                      (project-configuration-fail
                        "entries must be a non-empty string array"
                        filename))
                    (normalize-strings
                      entries-input "configuration entries" t))
                (js-array entry))))
        (unless (= (get portable-entries :length)
                   (get portable-input :length))
          (project-configuration-fail
            "portableEntries must not contain duplicates" filename))
        (unless (funcall boolean-p cache)
          (project-configuration-fail "cache must be a boolean" filename))
        (unless (funcall safe-relative-path-p source-root)
          (project-configuration-fail
            "sourceRoot must be a contained relative path" filename))
        (if (= schema-version project-configuration-multi-version)
            (progn
              (unless (= (get entries :length) (get entries-input :length))
                (project-configuration-fail
                  "entries must not contain duplicates" filename))
              (js-call entries :forEach
                (lambda (source)
                  (unless (funcall safe-relative-path-p source)
                    (project-configuration-fail
                      "entries must contain only contained relative paths"
                      filename))))
              (when (and (> (get entries :length) 1)
                         (> (get portable-entries :length) 0))
                (project-configuration-fail
                  "multi-entry portable project configurations are not supported"
                  filename)))
          (unless (funcall safe-relative-path-p entry)
            (project-configuration-fail
              "entry must be a contained relative path" filename)))
        (unless (funcall safe-relative-path-p out-dir)
          (project-configuration-fail
            "outDir must be a contained relative path" filename))
        (js-call globalThis.Object :freeze portable-entries)
        (js-call globalThis.Object :freeze entries)
        (if (= schema-version project-configuration-multi-version)
            (js-call globalThis.Object :freeze
              (js-object
                :format project-request-format
                :version project-request-multi-version
                :sourceRoot source-root
                :entries entries
                :outDir out-dir
                :portableEntries portable-entries
                :cache cache))
          (js-call globalThis.Object :freeze
            (js-object
              :format project-request-format
              :version project-request-version
              :sourceRoot source-root
              :entry entry
              :outDir out-dir
              :portableEntries portable-entries
              :cache cache))))))

  (defun freeze-request (request)
    (js-call globalThis.Object :freeze (get request :entries))
    (js-call globalThis.Object :freeze request))

  (defun normalize-portable-requests (values label require-entry)
    (unless (funcall array-p values)
      (fail (str label " must be an array")))
    (let ((entries-by-module (new globalThis.Map)))
      (js-call values :forEach
        (lambda (request)
          (unless (funcall object-p request)
            (fail (str label " must contain only request objects")))
          (let* ((module-id (get request :id))
                 (entries
                  (normalize-strings
                    (get request :entries)
                    (str label " entries")
                    t)))
            (unless (and (= (js* "typeof module_id") "string")
                         (> (get module-id :length) 0))
              (fail (str label " id must be a non-empty string")))
            (let ((requested
                   (or (js-call entries-by-module :get module-id)
                       (let ((created (new globalThis.Set)))
                         (js-call entries-by-module :set module-id created)
                         created))))
              (js-call entries :forEach
                (lambda (entry) (js-call requested :add entry)))))))
      (when (and require-entry (= (get entries-by-module :size) 0))
        (fail (str label " must not be empty")))
      (let ((result (js-array)))
        (js-call (funcall sorted-set-values (js-call entries-by-module :keys))
          :forEach
          (lambda (module-id)
            (js-call result :push
              (freeze-request
                (js-object
                  :id module-id
                  :entries
                  (funcall sorted-set-values
                    (js-call entries-by-module :get module-id)))))))
        (js-call globalThis.Object :freeze result))))

  (defun project-plan (entries dependencies-for)
    (unless (= (js* "typeof dependencies_for") "function")
      (fail "project dependency resolver must be a function"))
    (let* ((entry-list (normalize-strings entries "project entries" t))
           (pending (new globalThis.Set entry-list))
           (visited (new globalThis.Set))
           (records (new globalThis.Map))
           (iterations 0))
      (while (> (get pending :size) 0)
        (setq iterations (1+ iterations))
        (when (> iterations project-plan-max-iterations)
          (fail "project graph exceeded the planning iteration limit"))
        (let ((module-id (js-nth 0 (funcall sorted-set-values pending))))
          (js-call pending :delete module-id)
          (unless (js-call visited :has module-id)
            (js-call visited :add module-id)
            (let ((dependencies
                   (normalize-strings
                     (funcall dependencies-for module-id)
                     (str "dependencies for " module-id)
                     false)))
              (js-call records :set module-id
                (js-call globalThis.Object :freeze
                  (js-object
                    :id module-id
                    :dependencies
                    (js-call globalThis.Object :freeze dependencies))))
              (js-call dependencies :forEach
                (lambda (dependency)
                  (unless (js-call visited :has dependency)
                    (js-call pending :add dependency))))))))
      (let ((modules (js-array)))
        (js-call (funcall sorted-set-values (js-call records :keys)) :forEach
          (lambda (module-id)
            (js-call modules :push (js-call records :get module-id))))
        (js-call globalThis.Object :freeze modules)
        (js-call globalThis.Object :freeze
          (js-object
            :format project-plan-format
            :version project-plan-version
            :mode "standard"
            :entries (js-call globalThis.Object :freeze entry-list)
            :modules modules)))))

  (defun add-portable-request (requests pending request)
    (let* ((module-id (get request :id))
           (requested
            (or (js-call requests :get module-id)
                (let ((created (new globalThis.Set)))
                  (js-call requests :set module-id created)
                  created)))
           (changed false))
      (js-call (get request :entries) :forEach
        (lambda (entry)
          (unless (js-call requested :has entry)
            (js-call requested :add entry)
            (setq changed t))))
      (when changed (js-call pending :add module-id))
      changed))

  (defun portable-project-plan (initial-requests dependencies-for)
    (unless (= (js* "typeof dependencies_for") "function")
      (fail "portable dependency resolver must be a function"))
    (let* ((initial
            (normalize-portable-requests
              initial-requests "portable project entries" t))
           (requests (new globalThis.Map))
           (pending (new globalThis.Set))
           (processed (new globalThis.Map))
           (records (new globalThis.Map))
           (iterations 0))
      (js-call initial :forEach
        (lambda (request)
          (add-portable-request requests pending request)))
      (while (> (get pending :size) 0)
        (setq iterations (1+ iterations))
        (when (> iterations project-plan-max-iterations)
          (fail "portable project graph exceeded the planning iteration limit"))
        (let* ((module-id
                (js-nth 0 (funcall sorted-set-values pending)))
               (entries
                (funcall sorted-set-values
                  (js-call requests :get module-id)))
               (signature (js-call entries :join "\u0000")))
          (js-call pending :delete module-id)
          (unless (= signature (js-call processed :get module-id))
            (js-call processed :set module-id signature)
            (let* ((discovered
                    (normalize-portable-requests
                      (funcall dependencies-for module-id entries)
                      (str "portable dependencies for " module-id)
                      false))
                   (previous (js-call records :get module-id))
                   (dependencies
                    (if previous
                        (normalize-portable-requests
                          (js-call (get previous :dependencies)
                            :concat discovered)
                          (str "portable dependencies for " module-id)
                          false)
                      discovered)))
              (js-call records :set module-id
                (js-call globalThis.Object :freeze
                  (js-object
                    :id module-id
                    :entries (js-call globalThis.Object :freeze entries)
                    :dependencies dependencies)))
              (js-call dependencies :forEach
                (lambda (request)
                  (add-portable-request requests pending request)))))))
      (let ((modules (js-array)))
        (js-call (funcall sorted-set-values (js-call records :keys)) :forEach
          (lambda (module-id)
            (js-call modules :push (js-call records :get module-id))))
        (js-call globalThis.Object :freeze modules)
        (js-call globalThis.Object :freeze
          (js-object
            :format project-plan-format
            :version project-plan-version
            :mode "portable"
            :entries initial
            :modules modules)))))

  (defun project-cache-miss (reason)
    (js-call globalThis.Object :freeze
      (js-object :cache nil :reason reason)))

  (defun project-cache-version-kind (cache)
    (cond
      ((and (= (get cache :format) project-cache-format)
            (= (get cache :version) project-cache-version))
       "current")
      ((and (undefined? (get cache :format))
            (= (get cache :version) project-cache-legacy-version))
       "legacy")
      (t false)))

  (defun project-cache-records (identity-modules cache-modules)
    (if (not (and (funcall array-p identity-modules)
                  (funcall array-p cache-modules)))
        false
      (let ((identities (new globalThis.Map))
            (metadata-by-source (new globalThis.Map))
            (records (js-array))
            (valid t))
        (js-call identity-modules :forEach
          (lambda (identity)
            (if (not (funcall object-p identity))
                (setq valid false)
              (let ((source (get identity :source)))
                (if (or (not (= (js* "typeof source") "string"))
                        (= (get source :length) 0)
                        (js-call identities :has source))
                    (setq valid false)
                  (js-call identities :set source identity))))))
        (js-call cache-modules :forEach
          (lambda (metadata)
            (if (not (funcall object-p metadata))
                (setq valid false)
              (let ((source (get metadata :source)))
                (if (or (not (= (js* "typeof source") "string"))
                        (= (get source :length) 0)
                        (js-call metadata-by-source :has source))
                    (setq valid false)
                  (js-call metadata-by-source :set source metadata))))))
        (when (or (not (= (get identities :size)
                          (get identity-modules :length)))
                  (not (= (get metadata-by-source :size)
                          (get cache-modules :length)))
                  (not (= (get identities :size)
                          (get metadata-by-source :size))))
          (setq valid false))
        (when valid
          (js-call (funcall sorted-set-values (js-call identities :keys))
            :forEach
            (lambda (source)
              (let ((metadata (js-call metadata-by-source :get source)))
                (if (undefined? metadata)
                    (setq valid false)
                  (js-call records :push
                    (js-call globalThis.Object :freeze
                      (js-object
                        :source source
                        :identity (js-call identities :get source)
                        :metadata metadata))))))))
        (if valid
            (js-call globalThis.Object :freeze records)
          false))))

  (defun project-cache-lookup (input)
    (unless (funcall object-p input)
      (fail "project cache lookup input must be an object"))
    (let ((enabled (get input :enabled))
          (manifest-status (get input :manifestStatus)))
      (unless (funcall boolean-p enabled)
        (fail "project cache enabled must be a boolean"))
      (cond
        ((not enabled) (project-cache-miss "cache-disabled"))
        ((= manifest-status "missing")
         (project-cache-miss "manifest-missing"))
        ((= manifest-status "unreadable")
         (project-cache-miss "manifest-unreadable"))
        ((not (= manifest-status "readable"))
         (fail "project cache manifest status is invalid"))
        (t
         (let* ((manifest (get input :manifest))
                (cache (and (funcall object-p manifest)
                            (get manifest :cache)))
                (identity-modules
                 (and (funcall object-p manifest)
                      (get manifest :modules)))
                (cache-modules
                 (and (funcall object-p cache) (get cache :modules)))
                (version-kind
                 (and (funcall object-p cache)
                      (project-cache-version-kind cache))))
           (cond
             ((or (not (funcall object-p manifest))
                  (not (= (get manifest :format) "eliscript-project"))
                  (not (or (= (get manifest :version) 1)
                           (= (get manifest :version) 2)))
                  (not (funcall array-p identity-modules)))
              (project-cache-miss "manifest-version-changed"))
             ((and (= (get manifest :version) 1)
                   (not (= (get manifest :entry) (get input :expectedEntry))))
              (project-cache-miss "entry-changed"))
             ((and (= (get manifest :version) 2)
                   (not (same-string-arrays
                          (get manifest :entries)
                          (get input :expectedEntries))))
              (project-cache-miss "entries-changed"))
             ((not (= (get input :graphDigestValid) t))
              (project-cache-miss "graph-digest-invalid"))
             ((not (funcall object-p cache))
              (project-cache-miss "cache-missing"))
             ((not version-kind)
              (project-cache-miss "cache-version-changed"))
             ((not (funcall array-p cache-modules))
              (project-cache-miss "cache-records-invalid"))
             ((not (= (get input :cacheDigestValid) t))
              (project-cache-miss "cache-digest-invalid"))
             ((not (= (get cache :compilerDigest)
                      (get input :compilerDigest)))
              (project-cache-miss "compiler-changed"))
             ((not (= (get cache :mode) (get input :mode)))
              (project-cache-miss "mode-changed"))
             ((not (same-string-arrays
                     (get cache :portableEntries)
                     (get input :portableEntries)))
              (project-cache-miss "portable-roots-changed"))
             (t
              (let ((records
                     (project-cache-records identity-modules cache-modules)))
                (if (not records)
                    (project-cache-miss "cache-records-invalid")
                  (js-call globalThis.Object :freeze
                    (js-object
                      :cache
                      (js-call globalThis.Object :freeze
                        (js-object
                          :sourceVersion (get cache :version)
                          :manifestDigest (get manifest :digest)
                          :records records))
                      :reason "verified")))))))))))

  (defun project-cache-decision (input)
    (unless (funcall object-p input)
      (fail "project cache decision input must be an object"))
    (let* ((record (get input :record))
           (identity (and (funcall object-p record) (get record :identity)))
           (metadata (and (funcall object-p record) (get record :metadata)))
           (expected-portable-entries (get input :expectedPortableEntries))
           (recorded-portable-entries
            (and (funcall object-p metadata) (get metadata :portableEntries)))
           (reason
            (cond
              ((not (and (funcall object-p identity)
                         (funcall object-p metadata)))
               "not-cached")
              ((not (= (get identity :output) (get input :output)))
               "output-path-changed")
              ((not (= (get identity :sourceMap) (get input :sourceMap)))
               "source-map-path-changed")
              ((and (not (nil? expected-portable-entries))
                    (not (same-string-arrays
                           recorded-portable-entries
                           expected-portable-entries)))
               "portable-entries-changed")
              ((and (not (undefined? (get input :artifactFailure)))
                    (not (nil? (get input :artifactFailure))))
               (get input :artifactFailure))
              ((not (= (get identity :sourceDigest)
                       (get input :sourceDigest)))
               "source-changed")
              ((not (= (get input :outputExists) t)) "output-missing")
              ((not (= (get input :sourceMapExists) t)) "source-map-missing")
              ((not (= (get identity :outputDigest)
                       (get input :outputDigest)))
               "output-digest-changed")
              ((not (= (get identity :sourceMapDigest)
                       (get input :sourceMapDigest)))
               "source-map-digest-changed")
              ((not (= (get input :dependenciesValid) t))
               "dependencies-invalid")
              (t "verified"))))
      (js-call globalThis.Object :freeze
        (js-object :reused (= reason "verified") :reason reason))))

  (defun normalize-report-modules (values)
    (unless (funcall array-p values)
      (fail "build report modules must be an array"))
    (let ((result (js-array))
          (compiled 0)
          (reused 0))
      (js-call values :forEach
        (lambda (module)
          (unless (funcall object-p module)
            (fail "build report modules must contain only objects"))
          (let ((status (require-string
                          (get module :status)
                          "build report module status")))
            (unless (or (= status "compiled") (= status "reused"))
              (fail "build report module status must be compiled or reused"))
            (if (= status "compiled")
                (setq compiled (1+ compiled))
              (setq reused (1+ reused)))
            (js-call result :push
              (js-call globalThis.Object :freeze
                (js-object
                  :source
                  (require-string
                    (get module :source) "build report module source")
                  :output
                  (require-string
                    (get module :output) "build report module output")
                  :sourceMap
                  (require-string
                    (get module :sourceMap) "build report module source map")
                  :status status
                  :reason
                  (require-string
                    (get module :reason) "build report module reason")
                  :dependencies
                  (js-call globalThis.Object :freeze
                    (normalize-strings
                      (get module :dependencies)
                      "build report module dependencies"
                      false))
                  :portableEntries
                  (js-call globalThis.Object :freeze
                    (normalize-strings
                      (get module :portableEntries)
                      "build report module portable entries"
                      false))))))))
      (js-call result :sort
        (lambda (left right)
          (js-call (get left :source) :localeCompare (get right :source))))
      (js-call globalThis.Object :freeze result)
      (js-call globalThis.Object :freeze
        (js-object :modules result :compiled compiled :reused reused))))

  (defun project-build-report (build)
    (unless (funcall object-p build)
      (fail "project build report input must be an object"))
    (let* ((mode (require-string (get build :mode) "build report mode"))
           (multi (not (undefined? (get build :entries))))
           (entries
            (if multi
                (normalize-strings
                  (get build :entries) "build report entries" t)
              (js-array)))
           (entry-outputs
            (if multi
                (normalize-strings
                  (get build :entryOutputs) "build report entry outputs" t)
              (js-array)))
           (cache (get build :cache))
           (timings (get build :timings))
           (normalized (normalize-report-modules (get build :modules)))
           (modules (get normalized :modules))
           (compiled (get normalized :compiled))
           (reused (get normalized :reused))
           (lookup-reason
            (if (funcall object-p cache)
                (require-string (get cache :reason) "build report cache reason")
              (fail "build report cache must be an object")))
           (cache-enabled (get cache :enabled))
           (cache-status
            (cond
              ((not cache-enabled) "disabled")
              ((= reused 0) "miss")
              ((= compiled 0) "hit")
              (t "partial")))
           (cache-reason
            (cond
              ((not cache-enabled) "cache-disabled")
              ((= cache-status "hit") "verified")
              ((= cache-status "partial") "dirty-modules")
              ((= lookup-reason "verified") "all-modules-dirty")
              (t lookup-reason))))
      (unless (or (= mode "standard") (= mode "portable"))
        (fail "build report mode must be standard or portable"))
      (unless (funcall boolean-p cache-enabled)
        (fail "build report cache enabled must be a boolean"))
      (unless (funcall object-p timings)
        (fail "build report timings must be an object"))
      (when (and multi
                 (not (= (get entries :length) (get entry-outputs :length))))
        (fail "build report entries and outputs must have the same length"))
      (js-call globalThis.Object :freeze entries)
      (js-call globalThis.Object :freeze entry-outputs)
      (let ((common
             (js-object
          :format project-build-report-format
          :version
          (if multi project-build-report-multi-version
            project-build-report-version)
          :mode mode
          :root (require-string (get build :root) "build report root")
          :outDir (require-string (get build :outDir) "build report output directory")
          :manifest (require-string (get build :manifest) "build report manifest")
          :digest (require-string (get build :digest) "build report digest")
          :portableEntries
          (js-call globalThis.Object :freeze
            (normalize-strings
              (get build :portableEntries)
              "build report portable entries"
              false))
          :cache
          (js-call globalThis.Object :freeze
            (js-object
              :enabled (if cache-enabled t false)
              :status cache-status
              :reason cache-reason))
          :counts
          (js-call globalThis.Object :freeze
            (js-object
              :modules (get modules :length)
              :compiled compiled
              :reused reused))
          :timings
          (js-call globalThis.Object :freeze
            (js-object
              :cacheReadMs
              (report-milliseconds
                (get timings :cacheReadMs) "build report cache read time")
              :workMs
              (report-milliseconds
                (get timings :workMs) "build report work time")
              :manifestWriteMs
              (report-milliseconds
                (get timings :manifestWriteMs) "build report manifest write time")
              :totalMs
              (report-milliseconds
                (get timings :totalMs) "build report total time")))
          :modules modules)))
        (if multi
            (js-call globalThis.Object :assign common
              (js-object :entries entries :entryOutputs entry-outputs))
          (js-call globalThis.Object :assign common
            (js-object
              :entry
              (require-string (get build :entry) "build report entry")
              :entryOutput
              (require-string
                (get build :entryOutput) "build report entry output"))))
        (js-call globalThis.Object :freeze common))))

  (export
    project-plan-format
    project-plan-version
    project-plan
    portable-project-plan
    project-build-report-format
    project-build-report-version
    project-build-report-multi-version
    project-build-report
    project-request-format
    project-request-version
    project-request-multi-version
    project-request
    project-configuration
    build-operation-format
    build-operation-version
    build-operation-multi-version
    build-operation-request
    project-cache-format
    project-cache-version
    project-cache-lookup
    project-cache-decision))
