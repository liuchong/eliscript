(module bootstrap.compiler.analyzer
  (import "./symbol.mjs" binding-name reference-name)
  (import "./syntax.mjs"
    node-kind node-span node-value node-name node-items)
  (import "./transient-analysis.mjs" analyze-transients)
  (defconst typeof-value (lambda (value) (js* "typeof value")))

  (defconst builtin-operators
    (js-array "if" "when" "unless" "progn" "do" "while" "loop" "recur"
     "and" "or" "not"
     "+" "*" "-" "/" "%" "mod" "=" "/=" "not=" "<" "<=" ">" ">="
     "1+" "1-" "eq" "equal" "null" "nil?" "undefined?" "nullish?"
     "int32" "uint32" "imul32" "bit-and" "bit-or" "bit-xor" "bit-not"
     "bit-shift-left" "bit-shift-right" "unsigned-bit-shift-right"
     "value-type" "host-identity-token" "string-code-unit-at" "string-from-code-unit"
     "string-to-number" "string-to-bigint" "number-float64-words"
     "list" "vector" "hash-map" "hash-set" "queue" "js-array" "car"
     "cdr" "cons" "js-cons" "nth" "js-nth" "aref" "length" "js-length" "__eliscript_array_build" "__eliscript_array_copy_assoc"
     "new" "print" "str"
     "object-keys" "object-has?" "object-assoc" "__eliscript_arity_error"
     "funcall" "apply"))

  (defconst portable-forbidden-operators
    (js-array "js*" "print" "put" "js-call" "new" "async" "await" "throw" "try"))

  (defconst top-level-operators
    (js-array "defun" "defn" "defportable" "defasync" "defvar" "defconst"
      "export" "export-default" "import" "import-portable" "module"))

  (defconst builtin-operator-set (new globalThis.Set builtin-operators))
  (defconst portable-forbidden-operator-set (new globalThis.Set portable-forbidden-operators))
  (defconst top-level-operator-set (new globalThis.Set top-level-operators))
  (defconst transient-import-pattern
    (new globalThis.RegExp "(^|/)(stdlib|runtime/core)/transient\\.(mjs|eli)$"))

  (defconst fail
    (lambda (diagnostic)
      (let* ((p (aref (aref diagnostic "location") "start"))
             (Constructor globalThis.Error)
             (error (new Constructor
               (let* ((file-value (aref (aref diagnostic "location") "file"))
                      (file (js-call "" :concat file-value))
                      (line-value (aref p "line"))
                      (line (js-call "" :concat line-value))
                      (column-value (aref p "column"))
                      (column (js-call "" :concat column-value))
                      (message-value (aref diagnostic "message"))
                      (message (js-call "" :concat message-value)))
                 (+ file ":" line ":" column ": " message)))))
        (put error :eliscriptDiagnostic diagnostic)
        (throw error))))
  (defun compiler-fail (context span code phase message)
    (let ((file (or (get context :filename)
                    (and span (get span :filename))
                    "<input>")))
      (fail
        (js-object
          :format "eliscript-diagnostic"
          :code code
          :severity "error"
          :phase phase
          :message message
          :location
          (js-object
            :file file
            :start
            (js-object
              :offset (if span (get span :start) 0)
              :line (if span (get span :line) 1)
              :column (if span (get span :column) 1))
            :end
            (js-object
              :offset (if span (get span :end) 0)
              :line (if span (get span :endLine) 1)
              :column (if span (get span :endColumn) 1)))))))

  (defun analyzer-fail (context span message)
    (compiler-fail context span "ELI-A0001" "analysis" message))

  (defun portable-fail (context span message)
    (compiler-fail
      context span "ELI-P0001" "portable-analysis" message))

  (defun symbol-node-p (node)
    (and node (= (node-kind node) "symbol")))

  (defun keyword-node-p (node)
    (and node (= (node-kind node) "keyword")))

  (defun vector-node-p (node)
    (and node (= (node-kind node) "vector")))

  (defun map-node-p (node)
    (and node
         (= (node-kind node) "list")
         (> (get (node-items node) :length) 0)
         (symbol-node-p (js-nth 0 (node-items node)))
         (= (node-name (js-nth 0 (node-items node))) "hash-map")))

  (defun string-node-p (node)
    (and node
         (= (node-kind node) "literal")
         (= (funcall typeof-value (get node :value)) "string")))

  (defun null-node-p (node)
    (and node
         (= (node-kind node) "literal")
         (null (node-value node))))

  (defun list-items (node)
    (cond
      ((and node (= (node-kind node) "list")) (node-items node))
      ((null-node-p node) (js-array))
      (t undefined)))

  (defun binding-marker-p (name)
    (or (= name "&optional") (= name "&rest") (= name "&body")))

  (defun split-binding-name (name)
    (let ((slash (js-call name :lastIndexOf "/")))
      (if (< slash 0)
          (js-object :namespace undefined :local name)
        (js-object
          :namespace (js-call name :slice 0 slash)
          :local (js-call name :slice (1+ slash))))))

  (defun map-binding-shortcut (node)
    (when (keyword-node-p node)
      (let* ((parts (split-binding-name (node-name node)))
             (kind (get parts :local)))
        (when (or (= kind "keys") (= kind "strs") (= kind "syms"))
          (js-object :kind kind :namespace (get parts :namespace))))))

  (defun shortcut-entry (shortcut name-node)
    (let* ((name (node-name name-node))
           (parts (split-binding-name name))
           (local (get parts :local))
           (namespace (or (get shortcut :namespace)
                          (get parts :namespace)))
           (kind (get shortcut :kind))
           (qualified (if namespace (str namespace "/" local) local)))
      (js-object
        :target (js-object
                  :kind "symbol" :name local :span (node-span name-node))
        :keyKind kind
        :keyName (if (= kind "strs") name qualified))))

  (defun map-binding-key-p (node)
    (or (keyword-node-p node)
        (and node
             (= (node-kind node) "literal")
             (or (= (funcall typeof-value (get node :value)) "string")
                 (= (funcall typeof-value (get node :value)) "number")))))

  (defun map-binding-spec (pattern context)
    (let ((items (js-call (node-items pattern) :slice 1))
          (entries (js-array))
          (defaults (new globalThis.Map))
          (as undefined)
          (shortcuts-seen (new globalThis.Set))
          (or-seen false)
          (as-seen false)
          (index 0))
      (while (< index (get items :length))
        (let* ((left (js-nth index items))
               (right (js-nth (1+ index) items))
               (directive (and (keyword-node-p left) (node-name left)))
               (shortcut (map-binding-shortcut left)))
          (cond
            (shortcut
             (let ((kind (get shortcut :kind)))
               (when (js-call shortcuts-seen :has directive)
                 (analyzer-fail context (node-span left)
                   (str "map binding pattern accepts :" directive " once")))
               (js-call shortcuts-seen :add directive)
               (unless (vector-node-p right)
                 (analyzer-fail context (node-span right)
                   (str "map binding :" kind " value must be a vector")))
               (js-call (node-items right) :forEach
                 (lambda (name-node)
                   (let ((name (and (symbol-node-p name-node)
                                    (node-name name-node))))
                     (unless (and name
                                  (not (binding-marker-p name))
                                  (> (get
                                       (get (split-binding-name name) :local)
                                       :length)
                                     0))
                       (analyzer-fail context (node-span name-node)
                         (str "map binding :" kind
                              " entries must be symbols")))
                     (js-call entries :push
                       (shortcut-entry shortcut name-node)))))))
            ((= directive "or")
             (when or-seen
               (analyzer-fail context (node-span left)
                 "map binding pattern accepts :or once"))
             (setq or-seen t)
             (unless (map-node-p right)
               (analyzer-fail context (node-span right)
                 "map binding :or value must be a map"))
             (let ((pairs (js-call (node-items right) :slice 1))
                   (default-index 0))
               (while (< default-index (get pairs :length))
                 (let* ((name-node (js-nth default-index pairs))
                        (default (js-nth (1+ default-index) pairs))
                        (name (and (symbol-node-p name-node)
                                   (node-name name-node))))
                   (unless (and name (not (binding-marker-p name)))
                     (analyzer-fail context (node-span name-node)
                       "map binding :or keys must be binding symbols"))
                   (when (js-call defaults :has name)
                     (analyzer-fail context (node-span name-node)
                       "duplicate map binding :or default"))
                   (js-call defaults :set name default))
                 (setq default-index (+ default-index 2)))))
            ((= directive "as")
             (when as-seen
               (analyzer-fail context (node-span left)
                 "map binding pattern accepts :as once"))
             (setq as-seen t)
             (unless (and (symbol-node-p right)
                          (not (binding-marker-p (node-name right))))
               (analyzer-fail context (node-span right)
                 "map binding :as value must be a symbol"))
             (setq as right))
            (directive
             (analyzer-fail context (node-span left)
               (str "unknown map binding directive: :" directive)))
            (t
             (unless (binding-pattern-p left)
               (analyzer-fail context (node-span left)
                 "map binding entry target must be a binding pattern"))
             (unless (map-binding-key-p right)
               (analyzer-fail context (node-span right)
                 "map binding entry key must be a keyword, string, or number"))
             (js-call entries :push (js-object :target left :key right)))))
        (setq index (+ index 2)))
      (js-call defaults :forEach
        (lambda (default name)
          (let ((entry
                 (js-call entries :find
                   (lambda (candidate)
                     (and (symbol-node-p (get candidate :target))
                          (= (node-name (get candidate :target)) name))))))
            (unless entry
              (analyzer-fail context (node-span default)
                (str "map binding :or has no scalar target: " name)))
            (put entry :default default)
            (put entry :hasDefault t))))
      (js-object :entries entries :as as)))

  (defun binding-nodes (pattern context)
    (cond
      ((symbol-node-p pattern)
       (if (binding-marker-p (node-name pattern))
           (analyzer-fail
             context (node-span pattern) "invalid binding pattern marker")
         (js-array pattern)))
      ((vector-node-p pattern)
       (let ((result (js-array))
             (rest-seen false)
             (rest-done false))
         (js-call (node-items pattern) :forEach
           (lambda (element)
             (let ((name (and (symbol-node-p element) (node-name element))))
               (cond
                 ((= name "&rest")
                  (when (or rest-seen rest-done)
                    (analyzer-fail
                      context (node-span element)
                      "invalid vector binding pattern"))
                  (setq rest-seen t))
                 (rest-seen
                  (unless (and name (not (binding-marker-p name)))
                    (analyzer-fail
                      context (node-span element)
                      "vector &rest binding must be a symbol"))
                  (js-call result :push element)
                  (setq rest-seen false)
                  (setq rest-done t))
                 (rest-done
                  (analyzer-fail
                    context (node-span element)
                    "vector &rest binding must be final"))
                 ((null-node-p element) nil)
                 (t
                  (js-call (binding-nodes element context) :forEach
                    (lambda (binding)
                      (js-call result :push binding))))))))
         (when rest-seen
           (analyzer-fail
             context (node-span pattern)
             "vector &rest requires a binding"))
         result))
      ((map-node-p pattern)
       (let* ((spec (map-binding-spec pattern context))
              (result (js-array)))
         (js-call (get spec :entries) :forEach
           (lambda (entry)
             (js-call (binding-nodes (get entry :target) context) :forEach
               (lambda (binding) (js-call result :push binding)))))
         (when (get spec :as) (js-call result :push (get spec :as)))
         result))
      (t
       (analyzer-fail
         context (and pattern (node-span pattern))
         (str "binding pattern must be a symbol, vector, or map: "
              (node-display pattern))))))

  (defun binding-pattern-p (node)
    (or (and (symbol-node-p node)
             (not (binding-marker-p (node-name node))))
        (vector-node-p node)
        (map-node-p node)))

  (defun function-parameters (parameters context)
    (let ((items (list-items parameters))
          (parsed (js-array))
          (mode "required")
          (index 0))
      (when (eq items undefined)
        (analyzer-fail
          context (node-span parameters) "function arguments must be a list"))
      (while (< index (get items :length))
        (let* ((parameter (js-nth index items))
               (name (and (symbol-node-p parameter) (node-name parameter))))
          (cond
            ((= name "&optional")
             (unless (= mode "required")
               (analyzer-fail
                 context (node-span parameter)
                 "invalid function parameter list"))
             (setq mode "optional"))
            ((= name "&rest")
             (unless (or (= mode "required") (= mode "optional"))
               (analyzer-fail
                 context (node-span parameter)
                 "invalid function parameter list"))
             (setq mode "rest"))
            ((= name "&body")
             (analyzer-fail
               context (node-span parameter)
               "invalid function parameter list"))
            ((= mode "rest")
             (unless (and name (not (binding-marker-p name)))
               (analyzer-fail
                 context (node-span parameter)
                 "function &rest parameter must be a symbol"))
             (js-call parsed :push
               (js-object :kind "rest" :node parameter :bindings (js-array parameter)))
             (setq mode "done"))
            ((= mode "done")
             (analyzer-fail
               context (node-span parameter)
               "invalid function parameter list"))
            ((binding-pattern-p parameter)
             (js-call parsed :push
               (js-object
                 :kind mode
                 :node parameter
                 :bindings (binding-nodes parameter context))))
            (t
             (analyzer-fail
               context (node-span parameter)
               (str "function arguments must be symbols, vectors, or maps: "
                    (node-display parameters))))))
        (setq index (1+ index)))
      (when (= mode "rest")
        (analyzer-fail
          context (node-span parameters) "invalid function parameter list"))
      parsed))

  (defun node-display (node)
    (cond
      ((not node) "nil")
      ((= (node-kind node) "undefined") "undefined")
      ((= (node-kind node) "symbol") (node-name node))
      ((= (node-kind node) "keyword") (str ":" (node-name node)))
      ((= (node-kind node) "literal")
       (let ((value (node-value node)))
         (cond
           ((null value) "nil")
           ((eq value t) "t")
           ((eq value false) "false")
           ((= (funcall typeof-value value) "string")
            (JSON/stringify value))
           (t (str value)))))
      ((or (= (node-kind node) "list") (= (node-kind node) "vector"))
       (let* ((items (node-items node))
              (contents
               (js-call
                 (js-call items :map node-display)
                 :join " ")))
         (cond
           ((and (= (node-kind node) "list")
                 (= (get items :length) 2)
                 (symbol-node-p (js-nth 0 items))
                 (= (node-name (js-nth 0 items)) "quote"))
            (str "'" (node-display (js-nth 1 items))))
           ((= (node-kind node) "list") (str "(" contents ")"))
           (t (str "[" contents "]")))))
      (t "<unsupported>")))

  (defun make-scope (parent &optional function-context)
    (js-object
      :parent parent
      :names nil
      :outputs nil
      :bindingEpoch (if parent (get parent :bindingEpoch) (js-object :value 0))
      :lookupCache undefined
      :lookupEpoch -1
      :functionContext (or function-context (and parent (get parent :functionContext)))))

  (defun async-function-p (scope)
    (= (get scope :functionContext) "async"))

  (defun guarded-binding-name (name context span)
    (let* ((cache (get context :bindingNames))
           (cached (and cache (js-call cache :get name))))
      (if cached cached
        (let ((result (try (binding-name name)
                        (catch error
                          (analyzer-fail context span (get error :message))))))
          (when (= (js* "typeof name") "string")
            (unless cache
              (setq cache (new globalThis.Map))
              (put context :bindingNames cache))
            (js-call cache :set name result))
          result))))

  (defun guarded-reference-name (name context span)
    (let* ((cache (get context :referenceNames))
           (cached (and cache (js-call cache :get name))))
      (if cached cached
        (let ((result (try (reference-name name)
                        (catch error
                          (analyzer-fail context span (get error :message))))))
          (when (= (js* "typeof name") "string")
            (unless cache
              (setq cache (new globalThis.Map))
              (put context :referenceNames cache))
            (js-call cache :set name result))
          result))))

  (defun declare-binding (scope name-node kind mutable context)
    (unless (symbol-node-p name-node)
      (analyzer-fail
        context (and name-node (node-span name-node))
        (str "expected binding name, got " (node-display name-node))))
    (let* ((name (node-name name-node))
           (span (node-span name-node))
           (names (get scope :names))
           (outputs (get scope :outputs))
           (output-name (guarded-binding-name name context span))
           (existing-name (and names (js-call names :get name)))
           (existing-output (and outputs (js-call outputs :get output-name))))
      (when existing-name
        (analyzer-fail
          context span (str "duplicate " kind " binding: " name)))
      (when existing-output
        (analyzer-fail
          context span
          (str "binding " name " emits " output-name
               ", which collides with " (get existing-output :name))))
      (let ((binding
             (js-object
               :name name
               :outputName output-name
               :kind kind
               :mutable mutable)))
        (unless names
          (setq names (new globalThis.Map))
          (put scope :names names)
          (setq outputs (new globalThis.Map))
          (put scope :outputs outputs))
        (js-call names :set name binding)
        (js-call outputs :set output-name binding)
        ;; A later let* binding may shadow a previously resolved ancestor.
        ;; One private epoch invalidates inherited resolutions throughout
        ;; this module without retaining syntax nodes or completed contexts.
        (let ((epoch (get scope :bindingEpoch)))
          (put epoch :value (1+ (get epoch :value))))
        binding)))

  (defun declare-pattern (scope pattern kind mutable context)
    (if (and (symbol-node-p pattern)
             (not (binding-marker-p (node-name pattern))))
        (declare-binding scope pattern kind mutable context)
      (let ((bindings (binding-nodes pattern context))
            (index 0))
        (while (< index (get bindings :length))
          (declare-binding scope (js-nth index bindings) kind mutable context)
          (setq index (1+ index))))))

  (defun lookup-binding (scope name)
    (let* ((names (get scope :names))
           (binding (and names (js-call names :get name)))
          (current (get scope :parent)))
      (if (or binding (not current)) binding
        (let* ((epoch (get (get scope :bindingEpoch) :value))
               (cache (get scope :lookupCache)))
          (when (and cache (not (= epoch (get scope :lookupEpoch))))
            (js-call cache :clear)
            (put scope :lookupEpoch epoch))
          (setq binding (and cache (js-call cache :get name)))
          (unless binding
            (while (and current (not binding))
              (let ((parent-names (get current :names)))
                (when parent-names (setq binding (js-call parent-names :get name))))
              (setq current (get current :parent)))
            (when binding
              (unless cache
                (setq cache (new globalThis.Map))
                (put scope :lookupCache cache)
                (put scope :lookupEpoch epoch))
              (js-call cache :set name binding)))
          binding))))

  (defun require-binding (scope node context)
    (let* ((name (node-name node))
           (binding (lookup-binding scope name)))
      (or binding
          (analyzer-fail
            context (node-span node) (str "unbound symbol: " name)))))

  (defun qualified-name-p (name)
    (or (js-call name :includes ".")
        (js-call name :includes "/")))

  (defun analyze-sequence (forms scope context)
    (let ((tail-position (get context :tailPosition))
          (index 0))
      ;; Non-tail sequences dominate ordinary calls.  Their context already
      ;; has the required value; repeatedly writing it builds needless
      ;; managed property-update state for every operand.
      (when (and tail-position (> (get forms :length) 1))
        (put context :tailPosition false))
      (while (< index (get forms :length))
        (when (and tail-position (= index (1- (get forms :length))))
          (put context :tailPosition tail-position))
        (analyze-expression (js-nth index forms) scope context)
        (setq index (1+ index)))))

  (defun analyze-non-tail (form scope context)
    (let ((tail-position (get context :tailPosition)))
      (if tail-position
          (progn
            (put context :tailPosition false)
            (analyze-expression form scope context)
            (put context :tailPosition tail-position))
        (analyze-expression form scope context))))

  (defun analyze-pattern-defaults (pattern scope context)
    (cond
      ((vector-node-p pattern)
       (js-call (node-items pattern) :forEach
         (lambda (element)
           (unless (or (null-node-p element)
                       (and (symbol-node-p element)
                            (= (node-name element) "&rest")))
             (analyze-pattern-defaults element scope context)))))
      ((map-node-p pattern)
       (let ((spec (map-binding-spec pattern context)))
         (js-call (get spec :entries) :forEach
           (lambda (entry)
             (when (get entry :hasDefault)
               (analyze-non-tail (get entry :default) scope context))
             (analyze-pattern-defaults
               (get entry :target) scope context)))))))

  (defun analyze-non-tail-sequence (forms scope context)
    (let ((tail-position (get context :tailPosition)))
      (if tail-position
          (progn
            (put context :tailPosition false)
            (analyze-sequence forms scope context)
            (put context :tailPosition tail-position))
        (analyze-sequence forms scope context))))

  (defun binding-pair (binding context)
    (cond
      ((binding-pattern-p binding)
       (unless (symbol-node-p binding) (binding-nodes binding context))
       (js-array binding undefined))
      (t
       (let ((items (list-items binding)))
         (if (and (not (eq items undefined))
                  (>= (get items :length) 1)
                  (<= (get items :length) 2)
                  (binding-pattern-p (js-nth 0 items)))
             (progn
               (unless (symbol-node-p (js-nth 0 items))
                 (binding-nodes (js-nth 0 items) context))
               (js-array (js-nth 0 items) (js-nth 1 items)))
           (analyzer-fail
             context (node-span binding)
             (str "invalid let binding: " (node-display binding))))))))

  (defun analyze-let (args scope sequential context form-span)
    (when (= (get args :length) 0)
      (analyzer-fail
        context form-span
        (str (if sequential "let*" "let") " requires a binding list")))
    (let* ((bindings-form (js-nth 0 args))
           (bindings (list-items bindings-form))
           (body (js-call args :slice 1))
           (child (make-scope scope))
           (index 0))
      (when (eq bindings undefined)
        (analyzer-fail
          context (node-span bindings-form) "let bindings must be a list"))
      (if sequential
          (while (< index (get bindings :length))
              (let ((pair (binding-pair (js-nth index bindings) context)))
                (analyze-non-tail (js-nth 1 pair) child context)
                (analyze-pattern-defaults (js-nth 0 pair) child context)
                (declare-pattern
                  child (js-nth 0 pair) "local" t context))
              (setq index (1+ index)))
        (let ((parsed (js-array)))
          ;; Validate every parallel binding before analyzing any initializer.
          (while (< index (get bindings :length))
            (js-call parsed :push (binding-pair (js-nth index bindings) context))
            (setq index (1+ index)))
          (setq index 0)
          (while (< index (get parsed :length))
            (let ((pair (js-nth index parsed)))
              (analyze-non-tail (js-nth 1 pair) scope context)
              (analyze-pattern-defaults (js-nth 0 pair) scope context))
            (setq index (1+ index)))
          (setq index 0)
          (while (< index (get parsed :length))
            (let ((pair (js-nth index parsed)))
              (declare-pattern
                child (js-nth 0 pair) "local" t context))
            (setq index (1+ index)))))
      (analyze-sequence body child context)))

  (defun function-body (body parameter-count asynchronous context)
    ;; Validate the declaration without changing the AST consumed by lowering.
    (let* ((first (js-nth 0 body))
           (items (and first (= (node-kind first) "list") (node-items first))))
      (if (not (and items (> (js-length items) 0)
                    (symbol-node-p (js-nth 0 items))
                    (= (node-name (js-nth 0 items)) "memory-sig")))
          body
        (progn
          (when asynchronous
            (analyzer-fail context (node-span first)
              "memory-sig is only permitted as the leading form of a synchronous function"))
          (unless (= (js-length items) (+ parameter-count 2))
            (analyzer-fail context (node-span first)
              (str "memory-sig requires 1 result type and " parameter-count " parameter types")))
          (when (<= (js-length body) 1)
            (analyzer-fail context (node-span first) "memory-sig requires a function body"))
          (let ((index 1))
            (while (< index (js-length items))
              (let* ((token (js-nth index items))
                     (name (if (symbol-node-p token) (node-name token)
                             (if (string-node-p token) (node-value token) nil))))
                (unless (or (= name "u32") (= name "f64")
                            (= name "v64") (= name "bits64"))
                  (analyzer-fail context (node-span token)
                    "memory-sig requires explicit u32, f64, v64, or bits64 types")))
              (setq index (1+ index))))
          (js-call body :slice 1)))))

  (defun analyze-function
      (parameters body scope context &optional asynchronous)
    (let ((parameter-items (function-parameters parameters context))
          (index 0))
      (setq body (function-body body (js-length parameter-items) asynchronous context))
      (while (< index (get parameter-items :length))
        (analyze-pattern-defaults (get (js-nth index parameter-items) :node) scope context)
        (setq index (1+ index)))
      (let ((child (make-scope
                    scope (if asynchronous "async" "sync"))))
        (setq index 0)
        (while (< index (get parameter-items :length))
          (let ((bindings (get (js-nth index parameter-items) :bindings))
                (binding-index 0))
            (while (< binding-index (get bindings :length))
                (declare-binding
                  child (js-nth binding-index bindings) "parameter" t context)
                (setq binding-index (1+ binding-index))))
          (setq index (1+ index)))
        (let ((recur-targets (get context :recurTargets))
              (tail-position (get context :tailPosition))
              (recur-barrier (get context :recurBarrier)))
          (put context :recurTargets
            (js-array (js-object :kind "function"
                     :arity (get parameter-items :length))))
          (put context :tailPosition t)
          (put context :recurBarrier false)
          (analyze-sequence body child context)
          (put context :recurTargets recur-targets)
          (put context :tailPosition tail-position)
          (put context :recurBarrier recur-barrier)))))

  (defun analyze-loop (args scope context form-span)
    (when (= (get args :length) 0)
      (analyzer-fail context form-span "loop requires a binding list"))
    (let* ((bindings-form (js-nth 0 args))
           (bindings (list-items bindings-form))
           (body (js-call args :slice 1))
           (child (make-scope scope))
           (parsed (js-array)))
      (when (eq bindings undefined)
        (analyzer-fail
          context (node-span bindings-form) "loop bindings must be a list"))
      (js-call bindings :forEach
        (lambda (binding)
          (let ((items (list-items binding)))
            (unless (and (not (eq items undefined))
                         (= (get items :length) 2))
              (analyzer-fail
                context (node-span binding)
                (str "loop bindings require exactly one initializer: "
                     (node-display binding))))
            (js-call parsed :push (binding-pair binding context)))))
      (js-call parsed :forEach
        (lambda (pair)
          (analyze-non-tail (js-nth 1 pair) scope context)
          (analyze-pattern-defaults (js-nth 0 pair) scope context)))
      (js-call parsed :forEach
        (lambda (pair)
          (declare-pattern child (js-nth 0 pair) "loop" t context)))
      (let ((recur-targets (get context :recurTargets))
            (tail-position (get context :tailPosition))
            (recur-barrier (get context :recurBarrier))
            (targets (js-array)))
        (js-call targets :push
          (js-object :kind "loop" :arity (get parsed :length)))
        (js-call recur-targets :forEach
          (lambda (target) (js-call targets :push target)))
        (put context :recurTargets targets)
        (put context :tailPosition t)
        (put context :recurBarrier false)
        (analyze-sequence body child context)
        (put context :recurTargets recur-targets)
        (put context :tailPosition tail-position)
        (put context :recurBarrier recur-barrier))))

  (defun analyze-recur (args scope context form-span)
    (let* ((targets (get context :recurTargets))
           (target (and (> (get targets :length) 0) (js-nth 0 targets))))
      (unless target
        (analyzer-fail
          context form-span
          "recur is only valid inside a function or loop"))
      (when (get context :recurBarrier)
        (analyzer-fail
          context form-span "recur cannot cross a try boundary"))
      (unless (get context :tailPosition)
        (analyzer-fail
          context form-span "recur is only valid in tail position"))
      (unless (= (get args :length) (get target :arity))
        (analyzer-fail
          context form-span
          (str "recur expects " (get target :arity)
               " arguments for the current " (get target :kind)
               ", got " (get args :length))))
      (analyze-non-tail-sequence args scope context)))

  (defun analyze-assignment
      (args scope form-name context form-span)
    (when (or (= (get args :length) 0)
              (= (% (get args :length) 2) 1))
      (analyzer-fail
        context form-span
        (str form-name " expects one or more name/value pairs")))
    (let ((index 0))
      (while (< index (get args :length))
        (let* ((name-node (js-nth index args))
               (value (js-nth (1+ index) args)))
          (unless (symbol-node-p name-node)
            (analyzer-fail
              context form-span
              (str "assignment target must be a symbol: "
                   (node-display name-node))))
          (let ((binding (require-binding scope name-node context)))
            (unless (get binding :mutable)
              (analyzer-fail
                context (node-span name-node)
                (str "cannot assign to immutable binding: "
                     (node-name name-node)))))
          (analyze-non-tail value scope context))
        (setq index (+ index 2)))))

  (defun analyze-object (args scope context form-span form-name)
    (when (= (% (get args :length) 2) 1)
      (analyzer-fail
        context form-span (str form-name " expects key/value pairs")))
    (let ((index 0))
      (while (< index (get args :length))
        (let ((key (js-nth index args))
              (value (js-nth (1+ index) args)))
          (unless (or (keyword-node-p key)
                      (string-node-p key)
                      (symbol-node-p key))
            (analyze-non-tail key scope context))
          (analyze-non-tail value scope context))
        (setq index (+ index 2)))))

  (defun analyze-property-call
      (operator args scope context form-span)
    (cond
      ((= operator "get")
       (when (or (< (get args :length) 2)
                 (> (get args :length) 3))
         (analyzer-fail context form-span "get expects 2..3 arguments")))
      ((= operator "put")
       (unless (= (get args :length) 3)
         (analyzer-fail context form-span "put expects 3 arguments")))
      ((= operator "js-call")
       (when (< (get args :length) 2)
         (analyzer-fail context form-span "js-call expects 2+ arguments"))))
    (analyze-non-tail (js-nth 0 args) scope context)
    (let ((key (js-nth 1 args)))
      (unless (or (keyword-node-p key) (string-node-p key))
        (analyze-non-tail key scope context)))
    (analyze-non-tail-sequence (js-call args :slice 2) scope context))

  (defun analyze-cond (clauses scope context)
    (js-call clauses :forEach
      (lambda (clause)
        (let ((items (list-items clause)))
          (when (or (eq items undefined) (= (get items :length) 0))
            (analyzer-fail
              context (node-span clause)
              (str "invalid cond clause: " (node-display clause))))
          (analyze-non-tail (js-nth 0 items) scope context)
          (analyze-sequence (js-call items :slice 1) scope context)))))

  (defun clause-operator (form)
    (let ((items (list-items form)))
      (and (not (eq items undefined))
           (> (get items :length) 0)
           (symbol-node-p (js-nth 0 items))
           (node-name (js-nth 0 items)))))

  (defun analyze-try (args scope context form-span)
    (let ((recur-barrier (get context :recurBarrier))
          (clauses-started false)
          (catch-seen false)
          (finally-seen false))
      (put context :recurBarrier t)
      (js-call args :forEach
        (lambda (argument)
          (let ((operator (clause-operator argument)))
            (cond
              ((= operator "catch")
               (when catch-seen
                 (analyzer-fail
                   context form-span
                   "try accepts at most one catch clause"))
               (when finally-seen
                 (analyzer-fail context form-span "catch must precede finally"))
               (setq clauses-started t)
               (setq catch-seen t)
               (let* ((items (list-items argument))
                      (binding (js-nth 1 items)))
                 (unless (binding-pattern-p binding)
                   (analyzer-fail
                     context (node-span argument)
                     "catch requires a binding symbol, vector, or map"))
                 (analyze-pattern-defaults binding scope context)
                 (let ((child (make-scope scope)))
                   (declare-pattern child binding "catch" t context)
                   (analyze-sequence
                     (js-call items :slice 2) child context))))
              ((= operator "finally")
               (when finally-seen
                 (analyzer-fail
                   context form-span
                   "try accepts at most one finally clause"))
               (setq clauses-started t)
               (setq finally-seen t)
               (analyze-sequence
                 (js-call (list-items argument) :slice 1) scope context))
              (clauses-started
               (analyzer-fail
                 context (node-span argument)
                 "try body forms must precede catch and finally clauses"))
              (t (analyze-expression argument scope context))))))
      (unless (or catch-seen finally-seen)
        (analyzer-fail
          context form-span "try requires a catch or finally clause"))
      (put context :recurBarrier recur-barrier)))

  (defconst special-operator-set
    (new globalThis.Set
      (js-array
        "memory-sig" "lambda" "fn" "async" "await" "throw" "try"
        "catch" "finally" "let" "let*" "loop" "recur" "setq" "set!"
        "cond" "if" "when" "unless" "progn" "do" "and" "or" "while"
        "quote" "js-object" "hash-map" "get" "put" "js-call" "js*")))

  (defun analyze-call (form scope context)
    (let* ((items (node-items form))
           (operator-node (js-nth 0 items))
           (operator (and (symbol-node-p operator-node)
                          (node-name operator-node))))
      (if (or (eq operator "quote") (eq operator "js*"))
          nil
        (let ((args (js-call items :slice 1))
              (form-span (node-span form)))
          (cond
            ((not (and operator (js-call special-operator-set :has operator)))
             (cond
               ((and operator (js-call builtin-operator-set :has operator))
                (analyze-non-tail-sequence args scope context))
               ((and operator (js-call top-level-operator-set :has operator))
                (analyzer-fail
                  context form-span
                  (str operator " is only valid at module top level")))
               (t
                (analyze-non-tail operator-node scope context)
                (analyze-non-tail-sequence args scope context))))
            ((or (eq operator "get") (eq operator "put") (eq operator "js-call"))
             (analyze-property-call operator args scope context form-span))
            ((eq operator "let")
             (analyze-let args scope false context form-span))
            ((eq operator "let*")
             (analyze-let args scope t context form-span))
            ((eq operator "setq")
             (analyze-assignment args scope "setq" context form-span))
            ((eq operator "if")
             (unless (and (>= (get args :length) 2)
                          (<= (get args :length) 3))
               (analyzer-fail context form-span "if expects 2..3 arguments"))
             (analyze-non-tail (js-nth 0 args) scope context)
             ;; These are alternatives, not successive body forms.  Each branch
             ;; inherits the conditional's tail position, including the first.
             (let ((index 1))
               (while (< index (get args :length))
                 (analyze-expression (js-nth index args) scope context)
                 (setq index (1+ index)))))
            ((or (eq operator "when") (eq operator "unless"))
             (when (= (get args :length) 0)
               (analyzer-fail
                 context form-span (str operator " expects 1+ arguments")))
             (analyze-non-tail (js-nth 0 args) scope context)
             (analyze-sequence (js-call args :slice 1) scope context))
            ((or (eq operator "progn") (eq operator "do")
                 (eq operator "and") (eq operator "or"))
             (analyze-sequence args scope context))
            ((eq operator "cond") (analyze-cond args scope context))
            ((eq operator "while")
             (when (= (get args :length) 0)
               (analyzer-fail context form-span "while expects 1+ arguments"))
             (analyze-non-tail-sequence args scope context))
            ((or (eq operator "lambda") (eq operator "fn"))
             (when (= (get args :length) 0)
               (analyzer-fail
                 context form-span
                 (str operator " requires an argument list")))
             (analyze-function
               (js-nth 0 args) (js-call args :slice 1) scope context))
            ((eq operator "async")
             (when (= (get args :length) 0)
               (analyzer-fail
                 context form-span "async requires an argument list"))
             (analyze-function
               (js-nth 0 args) (js-call args :slice 1) scope context t))
            ((eq operator "await")
             (unless (= (get args :length) 1)
               (analyzer-fail context form-span "await expects 1 argument"))
             (unless (async-function-p scope)
               (analyzer-fail
                 context form-span
                 "await is only valid inside an async function"))
             (analyze-non-tail (js-nth 0 args) scope context))
            ((eq operator "throw")
             (unless (= (get args :length) 1)
               (analyzer-fail context form-span "throw expects 1 argument"))
             (analyze-non-tail (js-nth 0 args) scope context))
            ((eq operator "try")
             (analyze-try args scope context form-span))
            ((or (eq operator "catch") (eq operator "finally"))
             (analyzer-fail
               context form-span
               (str operator " is only valid as a try clause")))
            ((eq operator "loop")
             (analyze-loop args scope context form-span))
            ((eq operator "recur")
             (analyze-recur args scope context form-span))
            ((eq operator "set!")
             (unless (= (get args :length) 2)
               (analyzer-fail context form-span "set! expects 2 arguments"))
             (analyze-assignment args scope "set!" context form-span))
            ((eq operator "js-object")
             (analyze-object args scope context form-span operator))
            ((eq operator "hash-map")
             (when (= (% (get args :length) 2) 1)
               (analyzer-fail
                 context form-span
                 "hash-map expects complete key/value pairs"))
             (analyze-non-tail-sequence args scope context))
            (t
             (analyzer-fail context form-span
               "memory-sig is only permitted as the leading form of a synchronous function")))))))

  (defun analyze-expression (form scope context)
    (when form
      (let ((kind (node-kind form)))
        (cond
          ((eq kind "list")
           (analyze-call form scope context))
          ((eq kind "symbol")
           (let ((name (node-name form)))
             (if (qualified-name-p name)
                 (guarded-reference-name name context (node-span form))
               (require-binding scope form context))))
          ((or (eq kind "literal")
               (eq kind "undefined")
               (eq kind "keyword")) nil)
          ((eq kind "vector")
           (analyze-non-tail-sequence (node-items form) scope context))
          (t
           (analyzer-fail
             context (node-span form)
             (str "unsupported form: " (node-display form))))))))

  (defun import-bindings (args context form-span portable)
    (unless (and (> (get args :length) 0)
                 (string-node-p (js-nth 0 args)))
      (analyzer-fail context form-span "import module must be a string"))
    (let ((bindings (js-array))
          (index 1)
          (default-seen false)
          (namespace-seen false)
          (named-seen false))
      (while (< index (get args :length))
        (let ((specifier (js-nth index args)))
          (cond
            ((and (keyword-node-p specifier)
                  (= (node-name specifier) "default"))
             (when portable
               (analyzer-fail
                 context form-span
                 "import-portable only supports named imports"))
             (when default-seen
               (analyzer-fail
                 context form-span "duplicate :default import"))
             (when (>= (1+ index) (get args :length))
               (analyzer-fail
                 context form-span ":default requires a binding"))
             (setq default-seen t)
             (setq index (1+ index))
             (js-call bindings :push (js-nth index args)))
            ((and (keyword-node-p specifier)
                  (= (node-name specifier) "as"))
             (when portable
               (analyzer-fail
                 context form-span
                 "import-portable only supports named imports"))
             (when namespace-seen
               (analyzer-fail
                 context form-span "duplicate :as import"))
             (when (>= (1+ index) (get args :length))
               (analyzer-fail
                 context form-span ":as requires a namespace binding"))
             (setq namespace-seen t)
             (setq index (1+ index))
             (js-call bindings :push (js-nth index args)))
            ((symbol-node-p specifier)
             (setq named-seen t)
             (js-call bindings :push specifier))
            (t
             (analyzer-fail
               context form-span
               (str "invalid import specifier: "
                    (node-display specifier)))))
          (setq index (1+ index))))
      (when (and namespace-seen named-seen)
        (analyzer-fail
          context form-span
          "namespace and named imports cannot be combined"))
      (when (and portable (= (get bindings :length) 0))
        (analyzer-fail
          context form-span
          "import-portable expects one or more bindings"))
      bindings))

  (defun append-flattened-modules (forms result context)
    (js-call forms :forEach
      (lambda (form)
        (if (and (= (node-kind form) "list")
                 (symbol-node-p (js-nth 0 (node-items form)))
                 (= (node-name (js-nth 0 (node-items form))) "module"))
            (let ((items (node-items form)))
              (unless (and (> (get items :length) 1)
                           (symbol-node-p (js-nth 1 items)))
                (analyzer-fail
                  context (node-span form) "module name must be a symbol"))
              (append-flattened-modules
                (js-call items :slice 2) result context))
          (js-call result :push form)))))

  (defun flatten-modules (forms context)
    (let ((result (js-array)))
      (append-flattened-modules forms result context)
      result))

  (defun predeclare-top-level (forms scope context)
    (js-call forms :forEach
      (lambda (form)
        (when (= (node-kind form) "list")
          (let* ((items (node-items form))
                 (operator-node (js-nth 0 items))
                 (operator (and (symbol-node-p operator-node)
                                (node-name operator-node)))
                 (args (js-call items :slice 1))
                 (count (get args :length)))
            (cond
              ((or (= operator "import") (= operator "import-portable"))
               (when (= count 0)
                 (analyzer-fail
                   context (node-span form)
                   (str operator " expects a module name")))
               (js-call
                 (import-bindings
                   args context (node-span form)
                   (= operator "import-portable"))
                 :forEach
                 (lambda (name)
                   (declare-binding scope name "import" false context)))
               (if (js-call transient-import-pattern :test (node-value (js-nth 0 args)))
                   (put context :hasTransient t)
                 nil))
              ((= operator "defvar")
               (unless (and (>= count 1) (<= count 2))
                 (analyzer-fail
                   context (node-span form) "defvar expects 1..2 arguments"))
               (declare-binding
                 scope (js-nth 0 args) "variable" t context))
              ((= operator "defconst")
               (unless (and (>= count 1) (<= count 2))
                 (analyzer-fail
                   context (node-span form) "defconst expects 1..2 arguments"))
               (declare-binding
                 scope (js-nth 0 args) "constant" false context))
              ((or (= operator "defun") (= operator "defn")
                   (= operator "defportable") (= operator "defasync"))
               (unless (>= count 2)
                 (analyzer-fail
                   context (node-span form)
                   (str operator " expects 2+ arguments")))
               (declare-binding
                 scope (js-nth 0 args) "function" false context)
               (when (= operator "defportable")
                 (put context :hasPortable t)))))))))

  (defun analyze-top-level (form scope context)
    (if (not (= (node-kind form) "list"))
        (analyze-expression form scope context)
      (let* ((items (node-items form))
             (operator-node (js-nth 0 items))
             (operator (and (symbol-node-p operator-node)
                            (node-name operator-node)))
             (args (js-call items :slice 1))
             (count (get args :length)))
        (cond
          ((or (= operator "import") (= operator "import-portable")) nil)
          ((or (= operator "defvar") (= operator "defconst"))
           (when (> count 2)
             (analyzer-fail
               context (node-span form)
               (str operator " expects 1..2 arguments")))
           (analyze-expression (js-nth 1 args) scope context))
          ((or (= operator "defun") (= operator "defn")
               (= operator "defportable") (= operator "defasync"))
           (unless (>= count 2)
             (analyzer-fail
               context (node-span form)
               (str operator " expects 2+ arguments")))
           (analyze-function
             (js-nth 1 args)
             (js-call args :slice 2)
             scope context (= operator "defasync")))
          ((= operator "export")
           (when (= count 0)
             (analyzer-fail
               context (node-span form)
               "export expects one or more bindings"))
           (js-call args :forEach
             (lambda (name)
               (unless (symbol-node-p name)
                 (analyzer-fail
                   context (node-span name)
                   (str "export name must be a symbol: "
                        (node-display name))))
               (require-binding scope name context))))
          ((= operator "export-default")
           (unless (= count 1)
             (analyzer-fail
               context (node-span form)
               "export-default expects 1 argument"))
           (analyze-expression (js-nth 0 args) scope context))
          (t (analyze-expression form scope context))))))

  (defun portable-declarations (forms context)
    (let ((declarations (new globalThis.Map)))
      (js-call forms :forEach
        (lambda (form)
          (when (= (node-kind form) "list")
            (let* ((items (node-items form))
                   (operator-node (js-nth 0 items))
                   (operator (and (symbol-node-p operator-node)
                                  (node-name operator-node)))
                   (args (js-call items :slice 1)))
              (cond
                ((= operator "defconst")
                 (js-call declarations :set (node-name (js-nth 0 args))
                   (js-object :kind "constant" :form form
                           :initializer (js-nth 1 args))))
                ((= operator "defvar")
                 (js-call declarations :set (node-name (js-nth 0 args))
                   (js-object :kind "variable" :form form)))
                ((or (= operator "defun") (= operator "defn")
                     (= operator "defportable") (= operator "defasync"))
                 (js-call declarations :set (node-name (js-nth 0 args))
                   (js-object
                     :kind (if (= operator "defportable")
                               "portable" "function")
                     :form form
                     :parameters (js-nth 1 args)
                     :body (js-call args :slice 2))))
                ((or (= operator "import") (= operator "import-portable"))
                 (js-call
                   (import-bindings
                     args context (node-span form)
                     (= operator "import-portable"))
                   :forEach
                   (lambda (name)
                     (js-call declarations :set (node-name name)
                       (js-object
                         :kind (if (= operator "import-portable")
                                   "portable-import" "import")
                         :form form))))))))))
      declarations))

  (defun portable-scope (parameters context)
    (let ((scope (new globalThis.Set)))
      (when parameters
        (js-call (function-parameters parameters context) :forEach
          (lambda (parameter)
            (js-call (get parameter :bindings) :forEach
              (lambda (binding)
                (js-call scope :add (node-name binding)))))))
      scope))

  (defun copy-portable-scope (scope)
    (new globalThis.Set scope))

  (defun add-portable-pattern (pattern scope context)
    (js-call (binding-nodes pattern context) :forEach
      (lambda (binding)
        (js-call scope :add (node-name binding)))))

  (defun portable-reference
      (node scope declarations dependencies entry context)
    (let ((name (node-name node)))
      (unless (js-call scope :has name)
        (when (qualified-name-p name)
          (portable-fail
            context (node-span node)
            (str "portable function " entry
                 " uses qualified host reference: " name)))
        (let ((declaration (js-call declarations :get name)))
          (when declaration
            (let ((kind (get declaration :kind)))
              (if (or (= kind "portable") (= kind "constant")
                      (= kind "portable-import"))
                  (js-call dependencies :add name)
                (portable-fail
                  context (node-span node)
                  (str "portable function " entry
                       " depends on non-portable " kind ": " name)))))))))

  (defun portable-sequence
      (forms scope declarations dependencies entry context)
    (js-call forms :forEach
      (lambda (form)
        (portable-expression
          form scope declarations dependencies entry context))))

  (defun portable-function-expression
      (args scope declarations dependencies entry context)
    (let ((child (copy-portable-scope scope)))
      (js-call (function-parameters (js-nth 0 args) context) :forEach
        (lambda (parameter)
          (js-call (get parameter :bindings) :forEach
            (lambda (binding)
              (js-call child :add (node-name binding))))))
      (portable-sequence
        (js-call args :slice 1)
        child declarations dependencies entry context)))

  (defun portable-let-expression
      (args scope sequential declarations dependencies entry context)
    (let ((bindings (list-items (js-nth 0 args)))
          (child (copy-portable-scope scope)))
      (if sequential
          (js-call bindings :forEach
            (lambda (binding)
              (let* ((items (list-items binding))
                     (name (if items (js-nth 0 items) binding))
                     (initializer (and items (js-nth 1 items))))
                (portable-expression
                  initializer child declarations dependencies entry context)
                (add-portable-pattern name child context))))
        (progn
          (js-call bindings :forEach
            (lambda (binding)
              (let ((items (list-items binding)))
                (when items
                  (portable-expression
                    (js-nth 1 items) scope declarations dependencies entry context)))))
          (js-call bindings :forEach
            (lambda (binding)
              (let ((items (list-items binding)))
                (add-portable-pattern
                  (if items (js-nth 0 items) binding) child context))))))
      (portable-sequence
        (js-call args :slice 1)
        child declarations dependencies entry context)))

  (defun portable-loop-expression
      (args scope declarations dependencies entry context)
    (let ((bindings (list-items (js-nth 0 args)))
          (child (copy-portable-scope scope)))
      (js-call bindings :forEach
        (lambda (binding)
          (let ((items (list-items binding)))
            (portable-expression
              (js-nth 1 items) scope declarations dependencies entry context))))
      (js-call bindings :forEach
        (lambda (binding)
          (add-portable-pattern
            (js-nth 0 (list-items binding)) child context)))
      (portable-sequence
        (js-call args :slice 1)
        child declarations dependencies entry context)))

  (defun portable-assignment
      (args scope declarations dependencies entry context)
    (let ((index 0))
      (while (< index (get args :length))
        (let ((name (js-nth index args))
              (value (js-nth (1+ index) args)))
          (unless (js-call scope :has (node-name name))
            (portable-fail
              context (node-span name)
              (str "portable function " entry
                   " may only assign local bindings: " (node-name name))))
          (portable-expression
            value scope declarations dependencies entry context))
        (setq index (+ index 2)))))

  (defun portable-object
      (args scope declarations dependencies entry context)
    (let ((index 0))
      (while (< index (get args :length))
        (let ((key (js-nth index args))
              (value (js-nth (1+ index) args)))
          (unless (or (keyword-node-p key)
                      (string-node-p key)
                      (symbol-node-p key))
            (portable-expression
              key scope declarations dependencies entry context))
          (portable-expression
            value scope declarations dependencies entry context))
        (setq index (+ index 2)))))

  (defun portable-host-key-call
      (args scope declarations dependencies entry context)
    (let ((index 0))
      (while (< index (get args :length))
        (let ((argument (js-nth index args)))
          (unless (and (= index 1) (keyword-node-p argument))
            (portable-expression
              argument scope declarations dependencies entry context)))
        (setq index (1+ index)))))

  (defun portable-call
      (form scope declarations dependencies entry context)
    (let* ((items (node-items form))
           (operator-node (js-nth 0 items))
           (operator (and (symbol-node-p operator-node)
                          (node-name operator-node)))
           (args (js-call items :slice 1)))
      (when (js-call portable-forbidden-operator-set :has operator)
        (portable-fail
          context (node-span form)
          (str "portable function " entry " cannot use " operator " ("
               (cond
                 ((= operator "js*") "raw JavaScript")
                 ((= operator "print") "console output")
                 ((= operator "put") "object mutation")
                 ((= operator "js-call") "host method calls")
                 ((= operator "new") "host constructors")
                 ((= operator "async") "asynchronous functions")
                 ((= operator "await") "asynchronous suspension")
                 ((or (= operator "throw") (= operator "try"))
                  "exception control flow")
                (t "unsupported host capability"))
               ")")))
      (cond
        ((= operator "quote") nil)
        ((or (= operator "lambda") (= operator "fn"))
         (portable-function-expression
           args scope declarations dependencies entry context))
        ((= operator "let")
         (portable-let-expression
           args scope false declarations dependencies entry context))
        ((= operator "let*")
         (portable-let-expression
           args scope t declarations dependencies entry context))
        ((= operator "loop")
         (portable-loop-expression
           args scope declarations dependencies entry context))
        ((or (= operator "setq") (= operator "set!"))
         (portable-assignment
           args scope declarations dependencies entry context))
        ((= operator "js-object")
         (portable-object
           args scope declarations dependencies entry context))
        ((or (= operator "get")
             (= operator "aref")
             (= operator "object-has?")
             (= operator "object-assoc"))
         (portable-host-key-call
           args scope declarations dependencies entry context))
        (t
         (unless (js-call builtin-operator-set :has operator)
           (portable-expression
             operator-node scope declarations dependencies entry context))
         (portable-sequence
           args scope declarations dependencies entry context)))))

  (defun portable-expression
      (form scope declarations dependencies entry context)
    (when form
      (cond
        ((or (= (node-kind form) "literal")
             (= (node-kind form) "undefined")) nil)
        ((= (node-kind form) "keyword") nil)
        ((= (node-kind form) "symbol")
         (portable-reference
           form scope declarations dependencies entry context))
        ((= (node-kind form) "vector")
         (portable-sequence
           (node-items form) scope declarations dependencies entry context))
        ((= (node-kind form) "list")
         (portable-call
           form scope declarations dependencies entry context)))))

  (defun portable-dependencies (declaration declarations entry context)
    (let ((dependencies (new globalThis.Set))
          (scope (portable-scope (get declaration :parameters) context)))
      (if (= (get declaration :kind) "portable")
          (portable-sequence
            (get declaration :body)
            scope declarations dependencies entry context)
        (portable-expression
          (get declaration :initializer)
          scope declarations dependencies entry context))
      dependencies))

  (defun validate-portable-module (forms context)
    (let ((declarations (portable-declarations forms context))
          (pending (js-array))
          (visited (new globalThis.Set)))
      (js-call declarations :forEach
        (lambda (declaration name)
          (when (= (get declaration :kind) "portable")
            (js-call pending :push name))))
      (while (> (get pending :length) 0)
        (let ((name (js-call pending :pop)))
          (unless (js-call visited :has name)
            (js-call visited :add name)
            (let ((declaration (js-call declarations :get name)))
              (js-call
                (portable-dependencies
                  declaration declarations name context)
                :forEach
                (lambda (dependency)
                  (js-call pending :push dependency)))))))
      forms))

  (defun select-portable-module
      (forms entries filename &optional allow-project-imports)
    (let* ((context (js-object :filename filename))
           (flattened (flatten-modules forms context))
           (declarations (portable-declarations flattened context))
           (pending (js-array))
           (selected (new globalThis.Set)))
      (js-call entries :forEach
        (lambda (entry)
          (let ((declaration (js-call declarations :get entry)))
            (unless (and declaration (= (get declaration :kind) "portable"))
              (portable-fail
                context nil
                (str "portable entry " entry
                     " is not declared with defportable")))
            (js-call pending :push entry))))
      (while (> (get pending :length) 0)
        (let ((name (js-call pending :pop)))
          (unless (js-call selected :has name)
            (js-call selected :add name)
            (let ((declaration (js-call declarations :get name)))
              (when (and (= (get declaration :kind) "portable-import")
                         (not allow-project-imports))
                (portable-fail
                  context (node-span (get declaration :form))
                  (str "portable import " name
                       " requires a project build")))
              (js-call
                (portable-dependencies
                  declaration declarations name context)
                :forEach
                (lambda (dependency)
                  (js-call pending :push dependency)))))))
      (js-call flattened :filter
        (lambda (form)
          (when (= (node-kind form) "list")
            (let* ((items (node-items form))
                   (operator (and (symbol-node-p (js-nth 0 items))
                                  (node-name (js-nth 0 items))))
                   (name (and (> (get items :length) 1)
                              (symbol-node-p (js-nth 1 items))
                              (node-name (js-nth 1 items)))))
              (or
                (and (or (= operator "defconst")
                         (= operator "defportable"))
                     (js-call selected :has name))
                (and (= operator "import-portable")
                     (js-call
                       (js-call items :slice 2)
                       :some
                       (lambda (imported)
                         (js-call selected :has (node-name imported))))))))))))

  (defun analyze-module (forms filename)
    (let* ((context
            (js-object
              :filename filename
              :tailPosition false
              :recurTargets (js-array)
              :recurBarrier false))
           (flattened (flatten-modules forms context))
           (scope (make-scope nil)))
      (predeclare-top-level flattened scope context)
      (js-call flattened :forEach
        (lambda (form) (analyze-top-level form scope context)))
      (when (get context :hasTransient false)
        (analyze-transients forms filename))
      ;; With no portable entry the dependency worklist is empty.  All normal
      ;; declarations/imports were already checked above; do not construct a
      ;; second Map and copy every function body just to visit no entry.
      (when (get context :hasPortable false)
        (validate-portable-module flattened context))
      forms))

  (defconst lint-transient-constructors
    (new globalThis.Set
      (js-array "transient" "as-transient" "asTransient"
        "transient-vector" "transientVector"
        "transient-map" "transientMap"
        "transient-set" "transientSet")))

  (defconst lint-transient-updaters
    (new globalThis.Set
      (js-array "conj!" "conjBang" "assoc!" "assocBang"
        "dissoc!" "dissocBang" "disj!" "disjBang")))

  (defconst lint-transient-finalizers
    (new globalThis.Set (js-array "persistent!" "persistentBang")))

  (defun lint-ignored-name-p (name)
    (and (= (funcall typeof-value name) "string")
         (js-call name :startsWith "_")))

  (defun lint-rule-level (options code)
    (let* ((rules (and options (= (funcall typeof-value options) "object")
                       (get options :rules nil)))
           (raw (and rules (= (funcall typeof-value rules) "object")
                     (aref rules code))))
      (cond
        ((= raw "off") "off")
        ((= raw "error") "error")
        (t "warning"))))

  (defun lint-emit (state code span message)
    (let ((severity (lint-rule-level (get state :options) code)))
      (unless (= severity "off")
        (let* ((effective-span (or span (get state :currentSpan)))
               (file (or (get state :filename)
                         (and effective-span (get effective-span :filename))
                         "<input>"))
               (loc (if effective-span
                      (js-object
                        :file file
                        :start
                        (js-object
                          :offset (get effective-span :start)
                          :line (get effective-span :line)
                          :column (get effective-span :column))
                        :end
                        (js-object
                          :offset (get effective-span :end)
                          :line (get effective-span :endLine)
                          :column (get effective-span :endColumn)))
                      (js-object :file file)))
               (diag (js-object
                       :format "eliscript-diagnostic"
                       :code code
                       :severity severity
                       :phase "lint"
                       :message message
                       :location loc)))
          (js-call (get state :diagnostics) :push diag)))))

  (defun lint-make-scope (parent fn-depth)
    (js-object
      :parent parent
      :fnDepth fn-depth
      :bindings (new globalThis.Map)
      :order (js-array)))

  (defun lint-lookup (scope name)
    (let ((current scope)
          (found nil))
      (while (and current (not found))
        (setq found (js-call (get current :bindings) :get name))
        (unless found
          (setq current (get current :parent))))
      found))

  (defun lint-declare (scope name-node kind fn-depth mutable state &optional check-shadow is-transient)
    (when (symbol-node-p name-node)
      (let* ((name (node-name name-node))
             (span (or (node-span name-node) (get state :currentSpan))))
        (when (and check-shadow
                   (not (lint-ignored-name-p name))
                   (get scope :parent)
                   (lint-lookup (get scope :parent) name))
          (lint-emit state "ELI-L0003" span
            (str "binding shadows outer binding: " name)))
        (let ((binding (js-object
                         :name name
                         :kind kind
                         :fnDepth fn-depth
                         :span span
                         :mutable mutable
                         :used false
                         :isTransient (if is-transient t false)
                         :transientFinalized false
                         :transientEscaped false
                         :transientEscapeSpan nil)))
          (unless (js-call (get scope :bindings) :has name)
            (js-call (get scope :order) :push binding))
          (js-call (get scope :bindings) :set name binding)
          binding))))

  (defun lint-finalize-scope (scope state)
    (let ((order (get scope :order))
          (index 0))
      (while (< index (get order :length))
        (let* ((binding (js-nth index order))
               (name (get binding :name))
               (kind (get binding :kind)))
          (when (and (or (= kind "local") (= kind "parameter")
                         (= kind "loop") (= kind "catch"))
                     (not (get binding :used))
                     (not (lint-ignored-name-p name)))
            (lint-emit state "ELI-L0001" (get binding :span)
              (str "unused local binding: " name)))
          (when (and (get binding :isTransient)
                     (or (get binding :transientEscaped)
                         (not (get binding :transientFinalized))))
            (lint-emit state "ELI-L0009"
              (or (get binding :transientEscapeSpan) (get binding :span))
              (str "transient binding escapes or is not finalized with persistent!: " name))))
        (setq index (1+ index)))))

  (defun lint-transient-init-p (node)
    (let ((items (and node (= (node-kind node) "list") (node-items node))))
      (and items
           (> (get items :length) 0)
           (symbol-node-p (js-nth 0 items))
           (js-call lint-transient-constructors :has (node-name (js-nth 0 items))))))

  (defun lint-mark-finalized-transient (arg scope)
    (when arg
      (cond
        ((symbol-node-p arg)
         (let ((binding (lint-lookup scope (node-name arg))))
           (when (and binding
                      (get binding :isTransient)
                      (= (get binding :fnDepth) (get scope :fnDepth)))
             (put binding :transientFinalized t))))
        ((= (node-kind arg) "list")
         (let* ((items (node-items arg))
                (head (and (> (get items :length) 0) (js-nth 0 items))))
           (when (and head
                      (symbol-node-p head)
                      (js-call lint-transient-updaters :has (node-name head))
                      (> (get items :length) 1))
             (lint-mark-finalized-transient (js-nth 1 items) scope)))))))

  (defun lint-constant-condition-p (node)
    (if (not node)
        nil
      (let ((kind (node-kind node)))
        (or (= kind "literal")
            (= kind "undefined")
            (= kind "keyword")
            (and (= kind "list")
                 (> (get (node-items node) :length) 0)
                 (symbol-node-p (js-nth 0 (node-items node)))
                 (= (node-name (js-nth 0 (node-items node))) "quote"))))))

  (defun lint-useless-expr-p (node)
    (if (not node)
        nil
      (let ((kind (node-kind node)))
        (or (= kind "literal")
            (= kind "undefined")
            (= kind "keyword")
            (and (= kind "symbol") (not (lint-ignored-name-p (node-name node))))
            (and (= kind "list")
                 (> (get (node-items node) :length) 0)
                 (symbol-node-p (js-nth 0 (node-items node)))
                 (= (node-name (js-nth 0 (node-items node))) "quote"))))))

  (defun lint-literal-key (node)
    (if (not node)
        nil
      (let ((kind (node-kind node)))
        (cond
          ((= kind "undefined") "undef:undefined")
          ((= kind "keyword") (str "kw:" (node-name node)))
          ((= kind "literal")
           (let ((val (node-value node)))
             (cond
               ((null val) "nil:nil")
               ((eq val t) "bool:t")
               ((eq val false) "bool:false")
               ((= (funcall typeof-value val) "string") (str "str:" val))
               ((= (funcall typeof-value val) "number")
                (str "num:" (if (= val 0) 0 val)))
               (t nil))))
          (t nil)))))

  (defun lint-key-display (node)
    (if (not node)
        "nil"
      (let ((kind (node-kind node)))
        (cond
          ((= kind "undefined") "undefined")
          ((= kind "keyword") (str ":" (node-name node)))
          ((= kind "literal")
           (let ((val (node-value node)))
             (cond
               ((null val) "nil")
               ((eq val t) "t")
               ((eq val false) "false")
               ((= (funcall typeof-value val) "string") (JSON/stringify val))
               (t (str val)))))
          (t (node-display node))))))

  (defun lint-collect-arities (forms)
    (let ((arities (new globalThis.Map))
          (context (js-object :filename "<lint>"))
          (index 0))
      (while (< index (get forms :length))
        (let ((form (js-nth index forms)))
          (when (= (node-kind form) "list")
            (let* ((items (node-items form))
                   (op (and (> (get items :length) 0)
                            (symbol-node-p (js-nth 0 items))
                            (node-name (js-nth 0 items)))))
              (when (and (>= (get items :length) 3)
                         (or (= op "defun") (= op "defn")
                             (= op "defportable") (= op "defasync"))
                         (symbol-node-p (js-nth 1 items)))
                (let ((name (node-name (js-nth 1 items)))
                      (params-node (js-nth 2 items)))
                  (try
                    (let ((parsed (function-parameters params-node context))
                          (min-arity 0)
                          (max-arity 0)
                          (variadic false)
                          (p-idx 0))
                      (while (< p-idx (get parsed :length))
                        (let ((kind (get (js-nth p-idx parsed) :kind)))
                          (cond
                            ((= kind "required")
                             (setq min-arity (1+ min-arity))
                             (setq max-arity (1+ max-arity)))
                            ((= kind "optional")
                             (setq max-arity (1+ max-arity)))
                            ((= kind "rest")
                             (setq variadic t))))
                        (setq p-idx (1+ p-idx)))
                      (js-call arities :set name
                        (js-object :min min-arity :max (if variadic nil max-arity))))
                    (catch _err nil)))))))
        (setq index (1+ index)))
      arities))

  (defun lint-sequence (forms scope tail state)
    (let ((index 0)
          (len (get forms :length)))
      (while (< index len)
        (let ((item (js-nth index forms))
              (is-last (= index (1- len))))
          (when (and (not is-last) (lint-useless-expr-p item))
            (lint-emit state "ELI-L0008"
              (or (node-span item) (get state :currentSpan))
              "useless literal expression in sequence"))
          (lint-expression item scope (and tail is-last) state))
        (setq index (1+ index)))))

  (defun lint-pattern-defaults (pattern scope state)
    (let ((context (js-object :filename (or (get state :filename) "<input>"))))
      (try
        (cond
          ((vector-node-p pattern)
           (js-call (node-items pattern) :forEach
             (lambda (element)
               (unless (or (null-node-p element)
                           (and (symbol-node-p element) (= (node-name element) "&rest")))
                 (lint-pattern-defaults element scope state)))))
          ((map-node-p pattern)
           (let ((spec (map-binding-spec pattern context)))
             (js-call (get spec :entries) :forEach
               (lambda (entry)
                 (when (get entry :hasDefault)
                   (lint-expression (get entry :default) scope nil state))
                 (lint-pattern-defaults (get entry :target) scope state))))))
        (catch _err nil))))

  (defun lint-declare-pattern (scope pattern kind fn-depth mutable state &optional check-shadow is-transient)
    (let ((context (js-object :filename (or (get state :filename) "<input>"))))
      (try
        (let* ((single (and (symbol-node-p pattern)
                            (not (binding-marker-p (node-name pattern)))))
               (nodes (if single (js-array pattern) (binding-nodes pattern context)))
               (index 0))
          (while (< index (get nodes :length))
            (lint-declare scope (js-nth index nodes) kind fn-depth mutable state
              check-shadow (and single is-transient))
            (setq index (1+ index))))
        (catch _err nil))))

  (defun lint-let-binding-pair (binding)
    (cond
      ((binding-pattern-p binding) (js-array binding nil))
      (t
       (let ((items (list-items binding)))
         (if (and (not (eq items undefined))
                  (>= (get items :length) 1)
                  (<= (get items :length) 2)
                  (binding-pattern-p (js-nth 0 items)))
             (js-array (js-nth 0 items) (if (> (get items :length) 1) (js-nth 1 items) nil))
           nil)))))

  (defun lint-let (args scope sequential tail state)
    (when (> (get args :length) 0)
      (let* ((bindings (list-items (js-nth 0 args)))
             (body (js-call args :slice 1))
             (child (lint-make-scope scope (get scope :fnDepth))))
        (when (not (eq bindings undefined))
          (if sequential
              (let ((index 0))
                (while (< index (get bindings :length))
                  (let ((pair (lint-let-binding-pair (js-nth index bindings))))
                    (when pair
                      (let ((pat (js-nth 0 pair))
                            (init (js-nth 1 pair)))
                        (when init
                          (lint-expression init child nil state))
                        (lint-pattern-defaults pat child state)
                        (lint-declare-pattern child pat "local" (get child :fnDepth)
                          t state t (lint-transient-init-p init)))))
                  (setq index (1+ index))))
            (let ((parsed (js-array))
                  (index 0))
              (while (< index (get bindings :length))
                (let ((pair (lint-let-binding-pair (js-nth index bindings))))
                  (when pair (js-call parsed :push pair)))
                (setq index (1+ index)))
              (setq index 0)
              (while (< index (get parsed :length))
                (let ((pair (js-nth index parsed)))
                  (when (js-nth 1 pair)
                    (lint-expression (js-nth 1 pair) scope nil state))
                  (lint-pattern-defaults (js-nth 0 pair) scope state))
                (setq index (1+ index)))
              (setq index 0)
              (while (< index (get parsed :length))
                (let ((pair (js-nth index parsed)))
                  (lint-declare-pattern child (js-nth 0 pair) "local" (get child :fnDepth)
                    t state t (lint-transient-init-p (js-nth 1 pair))))
                (setq index (1+ index))))))
        (lint-sequence body child tail state)
        (lint-finalize-scope child state))))

  (defun lint-loop (args scope tail state)
    (when (> (get args :length) 0)
      (let* ((bindings (list-items (js-nth 0 args)))
             (body (js-call args :slice 1))
             (child (lint-make-scope scope (get scope :fnDepth)))
             (pairs (js-array)))
        (when (not (eq bindings undefined))
          (let ((index 0))
            (while (< index (get bindings :length))
              (let ((items (list-items (js-nth index bindings))))
                (when (and (not (eq items undefined)) (= (get items :length) 2))
                  (let ((pair (lint-let-binding-pair (js-nth index bindings))))
                    (when pair (js-call pairs :push pair)))))
              (setq index (1+ index))))
          (let ((index 0))
            (while (< index (get pairs :length))
              (let ((pair (js-nth index pairs)))
                (when (js-nth 1 pair)
                  (lint-expression (js-nth 1 pair) scope nil state))
                (lint-pattern-defaults (js-nth 0 pair) scope state))
              (setq index (1+ index)))
            (setq index 0)
            (while (< index (get pairs :length))
              (let ((pair (js-nth index pairs)))
                (lint-declare-pattern child (js-nth 0 pair) "loop" (get child :fnDepth)
                  t state t (lint-transient-init-p (js-nth 1 pair))))
              (setq index (1+ index)))))
        (lint-sequence body child tail state)
        (lint-finalize-scope child state))))

  (defun lint-function (parameters body scope state)
    (let* ((context (js-object :filename (or (get state :filename) "<input>")))
           (parsed (try (function-parameters parameters context) (catch _err (js-array))))
           (first-body (and (> (get body :length) 0) (js-nth 0 body)))
           (first-items (and first-body (= (node-kind first-body) "list") (node-items first-body)))
           (clean-body
            (if (and first-items (> (get first-items :length) 0)
                     (symbol-node-p (js-nth 0 first-items))
                     (= (node-name (js-nth 0 first-items)) "memory-sig"))
                (js-call body :slice 1)
              body))
           (child (lint-make-scope scope (1+ (get scope :fnDepth))))
           (index 0))
      (while (< index (get parsed :length))
        (lint-pattern-defaults (get (js-nth index parsed) :node) scope state)
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (get parsed :length))
        (lint-declare-pattern child (get (js-nth index parsed) :node) "parameter"
          (get child :fnDepth) t state t false)
        (setq index (1+ index)))
      (lint-sequence clean-body child t state)
      (lint-finalize-scope child state)))

  (defun lint-assignment (form-span args scope state)
    (let ((index 0))
      (while (< index (get args :length))
        (let ((target-node (js-nth index args))
              (value-node (and (< (1+ index) (get args :length)) (js-nth (1+ index) args))))
          (when value-node
            (lint-expression value-node scope nil state))
          (when (symbol-node-p target-node)
            (let* ((target (node-name target-node))
                   (binding (lint-lookup scope target)))
              (when binding
                (when (and (not (lint-ignored-name-p target))
                           (or (= (get binding :kind) "parameter")
                               (and (> (get binding :fnDepth) 0)
                                    (< (get binding :fnDepth) (get scope :fnDepth)))))
                  (lint-emit state "ELI-L0006" form-span
                    (str "mutating parameter or captured binding with setq: " target)))
                (when (and value-node (lint-transient-init-p value-node))
                  (put binding :isTransient t))))))
        (setq index (+ index 2)))))

  (defun lint-call (form scope tail state)
    (let* ((items (node-items form))
           (op-node (js-nth 0 items))
           (op (and (symbol-node-p op-node) (node-name op-node)))
           (args (js-call items :slice 1))
           (form-span (or (node-span form) (get state :currentSpan))))
      (cond
        ((or (= op "lambda") (= op "fn") (= op "async"))
         (when (> (get args :length) 0)
           (lint-function (js-nth 0 args) (js-call args :slice 1) scope state)))
        ((= op "let") (lint-let args scope false tail state))
        ((= op "let*") (lint-let args scope t tail state))
        ((= op "loop") (lint-loop args scope tail state))
        ((or (= op "setq") (= op "set!"))
         (lint-assignment form-span args scope state))
        ((= op "if")
         (when (and (> (get args :length) 0)
                    (lint-constant-condition-p (js-nth 0 args)))
           (lint-emit state "ELI-L0005" form-span "constant condition in if expression"))
         (when (> (get args :length) 0)
           (lint-expression (js-nth 0 args) scope nil state)
           (let ((index 1))
             (while (< index (get args :length))
               (lint-expression (js-nth index args) scope tail state)
               (setq index (1+ index))))))
        ((or (= op "when") (= op "unless"))
         (when (> (get args :length) 0)
           (lint-expression (js-nth 0 args) scope nil state)
           (lint-sequence (js-call args :slice 1) scope tail state)))
        ((or (= op "progn") (= op "do"))
         (if (= (get args :length) 0)
             (lint-emit state "ELI-L0008" form-span "empty progn/do expression")
           (lint-sequence args scope tail state)))
        ((or (= op "and") (= op "or"))
         (lint-sequence args scope tail state))
        ((= op "cond")
         (js-call args :forEach
           (lambda (clause)
             (let ((c-items (list-items clause)))
               (when (and (not (eq c-items undefined)) (> (get c-items :length) 0))
                 (lint-expression (js-nth 0 c-items) scope nil state)
                 (lint-sequence (js-call c-items :slice 1) scope tail state))))))
        ((= op "try")
         (js-call args :forEach
           (lambda (arg)
             (let ((aop (clause-operator arg)))
               (cond
                 ((= aop "catch")
                  (let* ((c-items (list-items arg))
                         (pat (js-nth 1 c-items))
                         (child (lint-make-scope scope (get scope :fnDepth))))
                    (lint-pattern-defaults pat scope state)
                    (lint-declare-pattern child pat "catch" (get child :fnDepth) t state t false)
                    (lint-sequence (js-call c-items :slice 2) child tail state)
                    (lint-finalize-scope child state)))
                 ((= aop "finally")
                  (lint-sequence (js-call (list-items arg) :slice 1) scope nil state))
                 (t
                  (lint-expression arg scope tail state)))))))
        ((= op "hash-map")
         (let ((seen (new globalThis.Set))
               (index 0))
           (while (< index (get args :length))
             (let ((k (js-nth index args))
                   (v (and (< (1+ index) (get args :length)) (js-nth (1+ index) args))))
               (when k
                 (let ((canon (lint-literal-key k)))
                   (when canon
                     (if (js-call seen :has canon)
                         (lint-emit state "ELI-L0007"
                           (or (node-span k) form-span)
                           (str "duplicate map literal key: " (lint-key-display k)))
                       (js-call seen :add canon))))
                 (lint-expression k scope nil state))
               (when v
                 (lint-expression v scope nil state)))
             (setq index (+ index 2)))))
        ((= op "hash-set")
         (let ((seen (new globalThis.Set))
               (index 0))
           (while (< index (get args :length))
             (let* ((elem (js-nth index args))
                    (canon (lint-literal-key elem)))
               (when canon
                 (if (js-call seen :has canon)
                     (lint-emit state "ELI-L0007"
                       (or (node-span elem) form-span)
                       (str "duplicate set literal element: " (lint-key-display elem)))
                   (js-call seen :add canon)))
               (lint-expression elem scope nil state))
             (setq index (1+ index)))))
        ((= op "js-object")
         (let ((index 0))
           (while (< index (get args :length))
             (let ((k (js-nth index args))
                   (v (and (< (1+ index) (get args :length)) (js-nth (1+ index) args))))
               (when k
                 (unless (or (keyword-node-p k) (string-node-p k) (symbol-node-p k))
                   (lint-expression k scope nil state)))
               (when v
                 (lint-expression v scope nil state)))
             (setq index (+ index 2)))))
        ((or (= op "get") (= op "put") (= op "js-call"))
         (when (> (get args :length) 0)
           (lint-expression (js-nth 0 args) scope nil state)
           (when (> (get args :length) 1)
             (let ((k (js-nth 1 args)))
               (unless (or (keyword-node-p k) (string-node-p k))
                 (lint-expression k scope nil state))))
           (let ((index 2))
             (while (< index (get args :length))
               (lint-expression (js-nth index args) scope nil state)
               (setq index (1+ index))))))
        ((or (= op "quote") (= op "js*")) nil)
        (t
         (let ((is-builtin (and op (js-call builtin-operator-set :has op))))
           (unless is-builtin
             (lint-expression op-node scope nil state))
           (when (and op (not is-builtin))
             (let* ((binding (lint-lookup scope op))
                    (sig (and binding
                              (= (get binding :kind) "function")
                              (= (get binding :fnDepth) 0)
                              (js-call (get state :arities) :get op))))
               (when sig
                 (let ((min-a (get sig :min))
                       (max-a (get sig :max))
                       (argc (get args :length)))
                   (when (or (< argc min-a) (and (not (nil? max-a)) (> argc max-a)))
                     (lint-emit state "ELI-L0004" form-span
                       (str "function " op " expects "
                            (cond
                              ((nil? max-a) (str "at least " min-a))
                              ((= min-a max-a) (str min-a))
                              (t (str min-a ".." max-a)))
                            " arguments, got " argc)))))))
           (when (and op
                      (js-call lint-transient-finalizers :has op)
                      (> (get args :length) 0))
             (lint-mark-finalized-transient (js-nth 0 args) scope))
           (let ((index 0))
             (while (< index (get args :length))
               (lint-expression (js-nth index args) scope nil state)
               (setq index (1+ index)))))))))

  (defun lint-expression (form scope tail state)
    (when form
      (let* ((prev-span (get state :currentSpan))
             (span (or (node-span form) prev-span))
             (kind (node-kind form)))
        (put state :currentSpan span)
        (cond
          ((or (= kind "literal") (= kind "undefined") (= kind "keyword")) nil)
          ((= kind "symbol")
           (let ((name (node-name form)))
             (unless (qualified-name-p name)
               (let ((binding (lint-lookup scope name)))
                 (when binding
                   (put binding :used t)
                   (when (get binding :isTransient)
                     (cond
                       ((> (get scope :fnDepth) (get binding :fnDepth))
                        (put binding :transientEscaped t)
                        (unless (get binding :transientEscapeSpan)
                          (put binding :transientEscapeSpan span)))
                       (tail
                        (put binding :transientEscaped t)
                        (unless (get binding :transientEscapeSpan)
                          (put binding :transientEscapeSpan span))))))))))
          ((= kind "vector")
           (let ((items (node-items form))
                 (index 0))
             (while (< index (get items :length))
               (lint-expression (js-nth index items) scope nil state)
               (setq index (1+ index)))))
          ((= kind "list")
           (lint-call form scope tail state)))
        (put state :currentSpan prev-span))))

  (defun lint-module (forms filename &optional options)
    (let* ((diag-context (js-object :filename filename))
           (flattened (flatten-modules forms diag-context))
           (scope (lint-make-scope nil 0))
           (arities (lint-collect-arities flattened))
           (state (js-object
                    :filename filename
                    :options options
                    :arities arities
                    :currentSpan nil
                    :diagnostics (js-array))))
      (js-call flattened :forEach
        (lambda (form)
          (when (= (node-kind form) "list")
            (let* ((items (node-items form))
                   (op (and (> (get items :length) 0)
                            (symbol-node-p (js-nth 0 items))
                            (node-name (js-nth 0 items))))
                   (args (js-call items :slice 1)))
              (cond
                ((or (= op "import") (= op "import-portable"))
                 (js-call
                   (import-bindings args diag-context (node-span form)
                     (= op "import-portable"))
                   :forEach
                   (lambda (name)
                     (lint-declare scope name "import" 0 false state))))
                ((= op "defvar")
                 (lint-declare scope (js-nth 0 args) "variable" 0 t state))
                ((= op "defconst")
                 (lint-declare scope (js-nth 0 args) "constant" 0 false state))
                ((or (= op "defun") (= op "defn")
                     (= op "defportable") (= op "defasync"))
                 (lint-declare scope (js-nth 0 args) "function" 0 false state)))))))
      (js-call flattened :forEach
        (lambda (form)
          (let ((prev-span (get state :currentSpan)))
            (put state :currentSpan (or (node-span form) prev-span))
            (if (not (= (node-kind form) "list"))
                (lint-expression form scope nil state)
              (let* ((items (node-items form))
                     (op (and (> (get items :length) 0)
                              (symbol-node-p (js-nth 0 items))
                              (node-name (js-nth 0 items))))
                     (args (js-call items :slice 1)))
                (cond
                  ((or (= op "import") (= op "import-portable")) nil)
                  ((or (= op "defvar") (= op "defconst"))
                   (when (> (get args :length) 1)
                     (lint-expression (js-nth 1 args) scope nil state)))
                  ((or (= op "defun") (= op "defn")
                       (= op "defportable") (= op "defasync"))
                   (when (>= (get args :length) 2)
                     (lint-function (js-nth 1 args) (js-call args :slice 2) scope state)))
                  ((= op "export")
                   (js-call args :forEach
                     (lambda (name)
                       (when (symbol-node-p name)
                         (let ((binding (lint-lookup scope (node-name name))))
                           (when binding (put binding :used t)))))))
                  ((= op "export-default")
                   (when (> (get args :length) 0)
                     (lint-expression (js-nth 0 args) scope nil state)))
                  (t
                   (lint-expression form scope nil state)))))
            (put state :currentSpan prev-span))))
      (let ((order (get scope :order))
            (index 0))
        (while (< index (get order :length))
          (let ((binding (js-nth index order)))
            (when (and (= (get binding :kind) "import")
                       (not (get binding :used))
                       (not (lint-ignored-name-p (get binding :name))))
              (lint-emit state "ELI-L0002" (get binding :span)
                (str "unused import binding: " (get binding :name)))))
          (setq index (1+ index))))
      (js-call (get state :diagnostics) :sort
        (lambda (left right)
          (let* ((sl (get (get left :location) :start))
                 (sr (get (get right :location) :start))
                 (ol (if sl (get sl :offset) 0))
                 (or_ (if sr (get sr :offset) 0)))
            (cond
              ((/= ol or_) (- ol or_))
              ((/= (get left :code) (get right :code))
               (if (< (get left :code) (get right :code)) -1 1))
              ((/= (get left :message) (get right :message))
               (if (< (get left :message) (get right :message)) -1 1))
              (t 0)))))))

  (export analyze-module select-portable-module lint-module))
