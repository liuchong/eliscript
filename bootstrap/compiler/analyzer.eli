(module bootstrap.compiler.analyzer
  (import "./symbol.mjs" binding-name reference-name)
  (import "./syntax.mjs"
    node-kind node-span node-value node-name node-items)
  (import "./transient-analysis.mjs" analyze-transients)

  (defconst builtin-operators
    (js-array "if" "when" "unless" "progn" "do" "while" "loop" "recur"
     "and" "or" "not"
     "+" "*" "-" "/" "%" "mod" "=" "/=" "not=" "<" "<=" ">" ">="
     "1+" "1-" "eq" "equal" "null" "nil?" "undefined?" "nullish?"
     "int32" "uint32" "imul32" "bit-and" "bit-or" "bit-xor" "bit-not"
     "bit-shift-left" "bit-shift-right" "unsigned-bit-shift-right"
     "value-type" "host-identity-token" "string-code-unit-at" "string-from-code-unit"
     "string-to-number" "string-to-bigint" "number-float64-words"
     "list" "vector" "hash-map" "hash-set" "array" "js-array" "car"
     "cdr" "cons" "nth" "js-nth" "aref" "length" "js-length"
     "new" "print" "str"
     "object-keys" "object-has?" "object-assoc" "funcall" "apply"))

  (defconst portable-forbidden-operators
    (js-array "js*" "print" "put" "js-call" "new" "async" "await" "throw" "try"
     "jsx" "fragment"))

  (defconst fail
    (js* "(diagnostic) => { const p = diagnostic.location.start; const error = new Error(`${diagnostic.location.file}:${p.line}:${p.column}: ${diagnostic.message}`); error.eliscriptDiagnostic = diagnostic; throw error; }"))
  (defconst guard
    (js* "(operation, onError) => { try { return operation(); } catch (error) { return onError(error.message); } }"))

  (defun analyzer-fail (context span message)
    (let ((file (or (get context :filename)
                    (and span (get span :filename))
                    "<input>")))
      (fail
        (object
          :format "eliscript-diagnostic"
          :version 1
          :code "ELI-A0001"
          :severity "error"
          :phase "analysis"
          :message message
          :location
          (object
            :file file
            :start
            (object
              :offset (if span (get span :start) 0)
              :line (if span (get span :line) 1)
              :column (if span (get span :column) 1))
            :end
            (object
              :offset (if span (get span :end) 0)
              :line (if span (get span :endLine) 1)
              :column (if span (get span :endColumn) 1)))))))

  (defun symbol-node-p (node)
    (and node (= (node-kind node) "symbol")))

  (defun keyword-node-p (node)
    (and node (= (node-kind node) "keyword")))

  (defun vector-node-p (node)
    (and node (= (node-kind node) "vector")))

  (defun string-node-p (node)
    (and node
         (= (node-kind node) "literal")
         (= (js* "typeof node.value") "string")))

  (defun null-node-p (node)
    (and node
         (= (node-kind node) "literal")
         (null (node-value node))))

  (defun list-items (node)
    (cond
      ((and node (= (node-kind node) "list")) (node-items node))
      ((null-node-p node) (js-array))
      (t undefined)))

  (defun binding-marker-p (name)
    (js-call (js-array "&optional" "&rest" "&body") :includes name))

  (defun binding-nodes (pattern context)
    (cond
      ((symbol-node-p pattern)
       (if (binding-marker-p (node-name pattern))
           (analyzer-fail
             context (node-span pattern) "invalid binding pattern marker")
         (js-array pattern)))
      ((vector-node-p pattern)
       (let ((result (js-array))
             (rest-seen false)
             (rest-done false))
         (js-call (node-items pattern) :forEach
           (lambda (element)
             (let ((name (and (symbol-node-p element) (node-name element))))
               (cond
                 ((= name "&rest")
                  (when (or rest-seen rest-done)
                    (analyzer-fail
                      context (node-span element)
                      "invalid vector binding pattern"))
                  (setq rest-seen t))
                 (rest-seen
                  (unless (and name (not (binding-marker-p name)))
                    (analyzer-fail
                      context (node-span element)
                      "vector &rest binding must be a symbol"))
                  (js-call result :push element)
                  (setq rest-seen false)
                  (setq rest-done t))
                 (rest-done
                  (analyzer-fail
                    context (node-span element)
                    "vector &rest binding must be final"))
                 ((null-node-p element) nil)
                 (t
                  (js-call (binding-nodes element context) :forEach
                    (lambda (binding)
                      (js-call result :push binding))))))))
         (when rest-seen
           (analyzer-fail
             context (node-span pattern)
             "vector &rest requires a binding"))
         result))
      (t
       (analyzer-fail
         context (and pattern (node-span pattern))
         (str "binding pattern must be a symbol or vector: "
              (node-display pattern))))))

  (defun binding-pattern-p (node)
    (or (and (symbol-node-p node)
             (not (binding-marker-p (node-name node))))
        (vector-node-p node)))

  (defun function-parameters (parameters context)
    (let ((items (list-items parameters))
          (parsed (js-array))
          (mode "required")
          (index 0))
      (when (eq items undefined)
        (analyzer-fail
          context (node-span parameters) "function arguments must be a list"))
      (while (< index (get items :length))
        (let* ((parameter (js-nth index items))
               (name (and (symbol-node-p parameter) (node-name parameter))))
          (cond
            ((= name "&optional")
             (unless (= mode "required")
               (analyzer-fail
                 context (node-span parameter)
                 "invalid function parameter list"))
             (setq mode "optional"))
            ((= name "&rest")
             (unless (or (= mode "required") (= mode "optional"))
               (analyzer-fail
                 context (node-span parameter)
                 "invalid function parameter list"))
             (setq mode "rest"))
            ((= name "&body")
             (analyzer-fail
               context (node-span parameter)
               "invalid function parameter list"))
            ((= mode "rest")
             (unless (and name (not (binding-marker-p name)))
               (analyzer-fail
                 context (node-span parameter)
                 "function &rest parameter must be a symbol"))
             (js-call parsed :push
               (object :kind "rest" :node parameter :bindings (js-array parameter)))
             (setq mode "done"))
            ((= mode "done")
             (analyzer-fail
               context (node-span parameter)
               "invalid function parameter list"))
            ((binding-pattern-p parameter)
             (js-call parsed :push
               (object
                 :kind mode
                 :node parameter
                 :bindings (binding-nodes parameter context))))
            (t
             (analyzer-fail
               context (node-span parameter)
               (str "function arguments must be symbols or vectors: "
                    (node-display parameters))))))
        (setq index (1+ index)))
      (when (= mode "rest")
        (analyzer-fail
          context (node-span parameters) "invalid function parameter list"))
      parsed))

  (defun node-display (node)
    (cond
      ((not node) "nil")
      ((= (node-kind node) "undefined") "undefined")
      ((= (node-kind node) "symbol") (node-name node))
      ((= (node-kind node) "keyword") (str ":" (node-name node)))
      ((= (node-kind node) "literal")
       (let ((value (node-value node)))
         (cond
           ((null value) "nil")
           ((eq value t) "t")
           ((eq value false) "false")
           ((= (js* "typeof value") "string")
            (js-call (js* "JSON") :stringify value))
           (t (str value)))))
      ((or (= (node-kind node) "list") (= (node-kind node) "vector"))
       (let* ((items (node-items node))
              (contents
               (js-call
                 (js-call items :map node-display)
                 :join " ")))
         (cond
           ((and (= (node-kind node) "list")
                 (= (get items :length) 2)
                 (symbol-node-p (js-nth 0 items))
                 (= (node-name (js-nth 0 items)) "quote"))
            (str "'" (node-display (js-nth 1 items))))
           ((= (node-kind node) "list") (str "(" contents ")"))
           (t (str "[" contents "]")))))
      (t "<unsupported>")))

  (defun make-scope (parent &optional function-context)
    (object
      :parent parent
      :names (new (js* "Map"))
      :outputs (new (js* "Map"))
      :functionContext function-context))

  (defun async-function-p (scope)
    (let ((current scope)
          (function-context nil))
      (while (and current (not function-context))
        (setq function-context (get current :functionContext))
        (setq current (get current :parent)))
      (= function-context "async")))

  (defun guarded-binding-name (name context span)
    (funcall
      guard
      (lambda () (binding-name name))
      (lambda (message) (analyzer-fail context span message))))

  (defun guarded-reference-name (name context span)
    (funcall
      guard
      (lambda () (reference-name name))
      (lambda (message) (analyzer-fail context span message))))

  (defun declare-binding (scope name-node kind mutable context)
    (unless (symbol-node-p name-node)
      (analyzer-fail
        context (and name-node (node-span name-node))
        (str "expected binding name, got " (node-display name-node))))
    (let* ((name (node-name name-node))
           (span (node-span name-node))
           (names (get scope :names))
           (outputs (get scope :outputs))
           (output-name (guarded-binding-name name context span))
           (existing-name (js-call names :get name))
           (existing-output (js-call outputs :get output-name)))
      (when existing-name
        (analyzer-fail
          context span (str "duplicate " kind " binding: " name)))
      (when existing-output
        (analyzer-fail
          context span
          (str "binding " name " emits " output-name
               ", which collides with " (get existing-output :name))))
      (let ((binding
             (object
               :name name
               :outputName output-name
               :kind kind
               :mutable mutable)))
        (js-call names :set name binding)
        (js-call outputs :set output-name binding)
        binding)))

  (defun declare-pattern (scope pattern kind mutable context)
    (js-call (binding-nodes pattern context) :forEach
      (lambda (binding)
        (declare-binding scope binding kind mutable context))))

  (defun lookup-binding (scope name)
    (let ((current scope)
          (binding undefined))
      (while (and current (not binding))
        (setq binding (js-call (get current :names) :get name))
        (setq current (get current :parent)))
      binding))

  (defun require-binding (scope node context)
    (let* ((name (node-name node))
           (binding (lookup-binding scope name)))
      (or binding
          (analyzer-fail
            context (node-span node) (str "unbound symbol: " name)))))

  (defun qualified-name-p (name)
    (or (js-call name :includes ".")
        (js-call name :includes "/")))

  (defun analyze-sequence (forms scope context)
    (let ((tail-position (get context :tailPosition))
          (index 0))
      (while (< index (get forms :length))
        (put context :tailPosition
          (and tail-position (= index (1- (get forms :length)))))
        (analyze-expression (js-nth index forms) scope context)
        (setq index (1+ index)))
      (put context :tailPosition tail-position)))

  (defun analyze-non-tail (form scope context)
    (let ((tail-position (get context :tailPosition)))
      (put context :tailPosition false)
      (analyze-expression form scope context)
      (put context :tailPosition tail-position)))

  (defun analyze-non-tail-sequence (forms scope context)
    (let ((tail-position (get context :tailPosition)))
      (put context :tailPosition false)
      (analyze-sequence forms scope context)
      (put context :tailPosition tail-position)))

  (defun binding-pair (binding context)
    (cond
      ((binding-pattern-p binding)
       (binding-nodes binding context)
       (js-array binding undefined))
      (t
       (let ((items (list-items binding)))
         (if (and (not (eq items undefined))
                  (>= (get items :length) 1)
                  (<= (get items :length) 2)
                  (binding-pattern-p (js-nth 0 items)))
             (progn
               (binding-nodes (js-nth 0 items) context)
               (js-array (js-nth 0 items) (js-nth 1 items)))
           (analyzer-fail
             context (node-span binding)
             (str "invalid let binding: " (node-display binding))))))))

  (defun analyze-let (args scope sequential context form-span)
    (when (= (get args :length) 0)
      (analyzer-fail
        context form-span
        (str (if sequential "let*" "let") " requires a binding list")))
    (let* ((bindings-form (js-nth 0 args))
           (bindings (list-items bindings-form))
           (body (js-call args :slice 1))
           (child (make-scope scope)))
      (when (eq bindings undefined)
        (analyzer-fail
          context (node-span bindings-form) "let bindings must be a list"))
      (if sequential
          (js-call bindings :forEach
            (lambda (binding)
              (let ((pair (binding-pair binding context)))
                (analyze-non-tail (js-nth 1 pair) child context)
                (declare-pattern
                  child (js-nth 0 pair) "local" t context))))
        (let ((parsed
               (js-call bindings :map
                 (lambda (binding) (binding-pair binding context)))))
          (js-call parsed :forEach
            (lambda (pair)
              (analyze-non-tail (js-nth 1 pair) scope context)))
          (js-call parsed :forEach
            (lambda (pair)
              (declare-pattern
                child (js-nth 0 pair) "local" t context)))))
      (analyze-sequence body child context)))

  (defun analyze-function
      (parameters body scope context &optional asynchronous)
    (let ((parameter-items (function-parameters parameters context)))
      (let ((child (make-scope
                    scope (if asynchronous "async" "sync"))))
        (js-call parameter-items :forEach
          (lambda (parameter)
            (js-call (get parameter :bindings) :forEach
              (lambda (binding)
                (declare-binding
                  child binding "parameter" t context)))))
        (let ((recur-targets (get context :recurTargets))
              (tail-position (get context :tailPosition))
              (recur-barrier (get context :recurBarrier)))
          (put context :recurTargets
            (js-array (object :kind "function"
                     :arity (get parameter-items :length))))
          (put context :tailPosition t)
          (put context :recurBarrier false)
          (analyze-sequence body child context)
          (put context :recurTargets recur-targets)
          (put context :tailPosition tail-position)
          (put context :recurBarrier recur-barrier)))))

  (defun analyze-loop (args scope context form-span)
    (when (= (get args :length) 0)
      (analyzer-fail context form-span "loop requires a binding list"))
    (let* ((bindings-form (js-nth 0 args))
           (bindings (list-items bindings-form))
           (body (js-call args :slice 1))
           (child (make-scope scope))
           (parsed (js-array)))
      (when (eq bindings undefined)
        (analyzer-fail
          context (node-span bindings-form) "loop bindings must be a list"))
      (js-call bindings :forEach
        (lambda (binding)
          (let ((items (list-items binding)))
            (unless (and (not (eq items undefined))
                         (= (get items :length) 2))
              (analyzer-fail
                context (node-span binding)
                (str "loop bindings require exactly one initializer: "
                     (node-display binding))))
            (js-call parsed :push (binding-pair binding context)))))
      (js-call parsed :forEach
        (lambda (pair)
          (analyze-non-tail (js-nth 1 pair) scope context)))
      (js-call parsed :forEach
        (lambda (pair)
          (declare-pattern child (js-nth 0 pair) "loop" t context)))
      (let ((recur-targets (get context :recurTargets))
            (tail-position (get context :tailPosition))
            (recur-barrier (get context :recurBarrier))
            (targets (js-array)))
        (js-call targets :push
          (object :kind "loop" :arity (get parsed :length)))
        (js-call recur-targets :forEach
          (lambda (target) (js-call targets :push target)))
        (put context :recurTargets targets)
        (put context :tailPosition t)
        (put context :recurBarrier false)
        (analyze-sequence body child context)
        (put context :recurTargets recur-targets)
        (put context :tailPosition tail-position)
        (put context :recurBarrier recur-barrier))))

  (defun analyze-recur (args scope context form-span)
    (let* ((targets (get context :recurTargets))
           (target (and (> (get targets :length) 0) (js-nth 0 targets))))
      (unless target
        (analyzer-fail
          context form-span
          "recur is only valid inside a function or loop"))
      (when (get context :recurBarrier)
        (analyzer-fail
          context form-span "recur cannot cross a try boundary"))
      (unless (get context :tailPosition)
        (analyzer-fail
          context form-span "recur is only valid in tail position"))
      (unless (= (get args :length) (get target :arity))
        (analyzer-fail
          context form-span
          (str "recur expects " (get target :arity)
               " arguments for the current " (get target :kind)
               ", got " (get args :length))))
      (analyze-non-tail-sequence args scope context)))

  (defun analyze-assignment
      (args scope form-name context form-span)
    (when (or (= (get args :length) 0)
              (= (% (get args :length) 2) 1))
      (analyzer-fail
        context form-span
        (str form-name " expects one or more name/value pairs")))
    (let ((index 0))
      (while (< index (get args :length))
        (let* ((name-node (js-nth index args))
               (value (js-nth (1+ index) args)))
          (unless (symbol-node-p name-node)
            (analyzer-fail
              context form-span
              (str "assignment target must be a symbol: "
                   (node-display name-node))))
          (let ((binding (require-binding scope name-node context)))
            (unless (get binding :mutable)
              (analyzer-fail
                context (node-span name-node)
                (str "cannot assign to immutable binding: "
                     (node-name name-node)))))
          (analyze-non-tail value scope context))
        (setq index (+ index 2)))))

  (defun analyze-object (args scope context form-span form-name)
    (when (= (% (get args :length) 2) 1)
      (analyzer-fail
        context form-span (str form-name " expects key/value pairs")))
    (let ((index 0))
      (while (< index (get args :length))
        (let ((key (js-nth index args))
              (value (js-nth (1+ index) args)))
          (unless (or (keyword-node-p key)
                      (string-node-p key)
                      (symbol-node-p key))
            (analyze-non-tail key scope context))
          (analyze-non-tail value scope context))
        (setq index (+ index 2)))))

  (defun analyze-property-call
      (operator args scope context form-span)
    (cond
      ((= operator "get")
       (when (or (< (get args :length) 2)
                 (> (get args :length) 3))
         (analyzer-fail context form-span "get expects 2..3 arguments")))
      ((= operator "put")
       (unless (= (get args :length) 3)
         (analyzer-fail context form-span "put expects 3 arguments")))
      ((= operator "js-call")
       (when (< (get args :length) 2)
         (analyzer-fail context form-span "js-call expects 2+ arguments"))))
    (analyze-non-tail (js-nth 0 args) scope context)
    (let ((key (js-nth 1 args)))
      (unless (or (keyword-node-p key) (string-node-p key))
        (analyze-non-tail key scope context)))
    (analyze-non-tail-sequence (js-call args :slice 2) scope context))

  (defun analyze-cond (clauses scope context)
    (js-call clauses :forEach
      (lambda (clause)
        (let ((items (list-items clause)))
          (when (or (eq items undefined) (= (get items :length) 0))
            (analyzer-fail
              context (node-span clause)
              (str "invalid cond clause: " (node-display clause))))
          (analyze-non-tail (js-nth 0 items) scope context)
          (analyze-sequence (js-call items :slice 1) scope context)))))

  (defun clause-operator (form)
    (let ((items (list-items form)))
      (and (not (eq items undefined))
           (> (get items :length) 0)
           (symbol-node-p (js-nth 0 items))
           (node-name (js-nth 0 items)))))

  (defun analyze-try (args scope context form-span)
    (let ((recur-barrier (get context :recurBarrier))
          (clauses-started false)
          (catch-seen false)
          (finally-seen false))
      (put context :recurBarrier t)
      (js-call args :forEach
        (lambda (argument)
          (let ((operator (clause-operator argument)))
            (cond
              ((= operator "catch")
               (when catch-seen
                 (analyzer-fail
                   context form-span
                   "try accepts at most one catch clause"))
               (when finally-seen
                 (analyzer-fail context form-span "catch must precede finally"))
               (setq clauses-started t)
               (setq catch-seen t)
               (let* ((items (list-items argument))
                      (binding (js-nth 1 items)))
                 (unless (binding-pattern-p binding)
                   (analyzer-fail
                     context (node-span argument)
                     "catch requires a binding symbol or vector"))
                 (let ((child (make-scope scope)))
                   (declare-pattern child binding "catch" t context)
                   (analyze-sequence
                     (js-call items :slice 2) child context))))
              ((= operator "finally")
               (when finally-seen
                 (analyzer-fail
                   context form-span
                   "try accepts at most one finally clause"))
               (setq clauses-started t)
               (setq finally-seen t)
               (analyze-sequence
                 (js-call (list-items argument) :slice 1) scope context))
              (clauses-started
               (analyzer-fail
                 context (node-span argument)
                 "try body forms must precede catch and finally clauses"))
              (t (analyze-expression argument scope context))))))
      (unless (or catch-seen finally-seen)
        (analyzer-fail
          context form-span "try requires a catch or finally clause"))
      (put context :recurBarrier recur-barrier)))

  (defun analyze-jsx (args scope context form-span)
    (when (< (get args :length) 2)
      (analyzer-fail
        context form-span
        "jsx expects a type, props, and optional children"))
    (let ((type (js-nth 0 args)))
      (unless (or (keyword-node-p type) (string-node-p type))
        (analyze-non-tail type scope context)))
    (analyze-non-tail-sequence (js-call args :slice 1) scope context))

  (defun analyze-call (form scope context)
    (let* ((items (node-items form))
           (operator-node (js-nth 0 items))
           (operator (and (symbol-node-p operator-node)
                          (node-name operator-node)))
           (args (js-call items :slice 1))
           (form-span (node-span form)))
      (cond
        ((or (= operator "lambda") (= operator "fn"))
         (when (= (get args :length) 0)
           (analyzer-fail
             context form-span
             (str operator " requires an argument list")))
         (analyze-function
           (js-nth 0 args) (js-call args :slice 1) scope context))
        ((= operator "async")
         (when (= (get args :length) 0)
           (analyzer-fail
             context form-span "async requires an argument list"))
         (analyze-function
           (js-nth 0 args) (js-call args :slice 1) scope context t))
        ((= operator "await")
         (unless (= (get args :length) 1)
           (analyzer-fail context form-span "await expects 1 argument"))
         (unless (async-function-p scope)
           (analyzer-fail
             context form-span
             "await is only valid inside an async function"))
         (analyze-non-tail (js-nth 0 args) scope context))
        ((= operator "throw")
         (unless (= (get args :length) 1)
           (analyzer-fail context form-span "throw expects 1 argument"))
         (analyze-non-tail (js-nth 0 args) scope context))
        ((= operator "try")
         (analyze-try args scope context form-span))
        ((or (= operator "catch") (= operator "finally"))
         (analyzer-fail
           context form-span
           (str operator " is only valid as a try clause")))
        ((= operator "let")
         (analyze-let args scope false context form-span))
        ((= operator "let*")
         (analyze-let args scope t context form-span))
        ((= operator "loop")
         (analyze-loop args scope context form-span))
        ((= operator "recur")
         (analyze-recur args scope context form-span))
        ((= operator "setq")
         (analyze-assignment args scope "setq" context form-span))
        ((= operator "set!")
         (unless (= (get args :length) 2)
           (analyzer-fail context form-span "set! expects 2 arguments"))
         (analyze-assignment args scope "set!" context form-span))
        ((= operator "cond") (analyze-cond args scope context))
        ((= operator "if")
         (unless (and (>= (get args :length) 2)
                      (<= (get args :length) 3))
           (analyzer-fail context form-span "if expects 2..3 arguments"))
         (analyze-non-tail (js-nth 0 args) scope context)
         (analyze-sequence (js-call args :slice 1) scope context))
        ((or (= operator "when") (= operator "unless"))
         (when (= (get args :length) 0)
           (analyzer-fail
             context form-span (str operator " expects 1+ arguments")))
         (analyze-non-tail (js-nth 0 args) scope context)
         (analyze-sequence (js-call args :slice 1) scope context))
        ((or (= operator "progn") (= operator "do")
             (= operator "and") (= operator "or"))
         (analyze-sequence args scope context))
        ((= operator "while")
         (when (= (get args :length) 0)
           (analyzer-fail context form-span "while expects 1+ arguments"))
         (analyze-non-tail-sequence args scope context))
        ((= operator "jsx")
         (analyze-jsx args scope context form-span))
        ((= operator "fragment")
         (analyze-non-tail-sequence args scope context))
        ((= operator "quote") nil)
        ((or (= operator "object") (= operator "js-object"))
         (analyze-object args scope context form-span operator))
        ((= operator "hash-map")
         (when (= (% (get args :length) 2) 1)
           (analyzer-fail
             context form-span
             "hash-map expects complete key/value pairs"))
         (analyze-non-tail-sequence args scope context))
        ((or (= operator "get") (= operator "put") (= operator "js-call"))
         (analyze-property-call
           operator args scope context form-span))
        ((= operator "js*") nil)
        ((js-call builtin-operators :includes operator)
         (analyze-non-tail-sequence args scope context))
        ((js-call
          (js-array "defun" "defn" "defportable" "defasync" "defcomponent"
            "defvar" "defconst"
            "export" "export-default" "import" "import-portable" "module")
           :includes operator)
         (analyzer-fail
           context form-span
           (str operator " is only valid at module top level")))
        (t
         (analyze-non-tail operator-node scope context)
         (analyze-non-tail-sequence args scope context)))))

  (defun analyze-expression (form scope context)
    (when form
      (cond
        ((or (= (node-kind form) "literal")
             (= (node-kind form) "undefined")
             (= (node-kind form) "keyword")) nil)
        ((= (node-kind form) "symbol")
         (let ((name (node-name form)))
           (if (qualified-name-p name)
               (guarded-reference-name name context (node-span form))
             (require-binding scope form context))))
        ((= (node-kind form) "vector")
         (analyze-non-tail-sequence (node-items form) scope context))
        ((= (node-kind form) "list")
         (analyze-call form scope context))
        (t
         (analyzer-fail
           context (node-span form)
           (str "unsupported form: " (node-display form)))))))

  (defun import-bindings (args context form-span portable)
    (unless (and (> (get args :length) 0)
                 (string-node-p (js-nth 0 args)))
      (analyzer-fail context form-span "import module must be a string"))
    (let ((bindings (js-array))
          (index 1)
          (default-seen false)
          (namespace-seen false))
      (while (< index (get args :length))
        (let ((specifier (js-nth index args)))
          (cond
            ((and (keyword-node-p specifier)
                  (= (node-name specifier) "default"))
             (when portable
               (analyzer-fail
                 context form-span
                 "import-portable only supports named imports"))
             (when default-seen
               (analyzer-fail
                 context form-span "duplicate :default import"))
             (when (>= (1+ index) (get args :length))
               (analyzer-fail
                 context form-span ":default requires a binding"))
             (setq default-seen t)
             (setq index (1+ index))
             (js-call bindings :push (js-nth index args)))
            ((and (keyword-node-p specifier)
                  (= (node-name specifier) "as"))
             (when portable
               (analyzer-fail
                 context form-span
                 "import-portable only supports named imports"))
             (when namespace-seen
               (analyzer-fail
                 context form-span "duplicate :as import"))
             (when (>= (1+ index) (get args :length))
               (analyzer-fail
                 context form-span ":as requires a namespace binding"))
             (setq namespace-seen t)
             (setq index (1+ index))
             (js-call bindings :push (js-nth index args)))
            ((symbol-node-p specifier)
             (js-call bindings :push specifier))
            (t
             (analyzer-fail
               context form-span
               (str "invalid import specifier: "
                    (node-display specifier)))))
          (setq index (1+ index))))
      (when (and portable (= (get bindings :length) 0))
        (analyzer-fail
          context form-span
          "import-portable expects one or more bindings"))
      bindings))

  (defun append-flattened-modules (forms result context)
    (js-call forms :forEach
      (lambda (form)
        (if (and (= (node-kind form) "list")
                 (symbol-node-p (js-nth 0 (node-items form)))
                 (= (node-name (js-nth 0 (node-items form))) "module"))
            (let ((items (node-items form)))
              (unless (and (> (get items :length) 1)
                           (symbol-node-p (js-nth 1 items)))
                (analyzer-fail
                  context (node-span form) "module name must be a symbol"))
              (append-flattened-modules
                (js-call items :slice 2) result context))
          (js-call result :push form)))))

  (defun flatten-modules (forms context)
    (let ((result (js-array)))
      (append-flattened-modules forms result context)
      result))

  (defun predeclare-top-level (forms scope context)
    (js-call forms :forEach
      (lambda (form)
        (when (= (node-kind form) "list")
          (let* ((items (node-items form))
                 (operator-node (js-nth 0 items))
                 (operator (and (symbol-node-p operator-node)
                                (node-name operator-node)))
                 (args (js-call items :slice 1))
                 (count (get args :length)))
            (cond
              ((or (= operator "import") (= operator "import-portable"))
               (when (= count 0)
                 (analyzer-fail
                   context (node-span form)
                   (str operator " expects a module name")))
               (js-call
                 (import-bindings
                   args context (node-span form)
                   (= operator "import-portable"))
                 :forEach
                 (lambda (name)
                   (declare-binding scope name "import" false context))))
              ((= operator "defvar")
               (unless (and (>= count 1) (<= count 2))
                 (analyzer-fail
                   context (node-span form) "defvar expects 1..2 arguments"))
               (declare-binding
                 scope (js-nth 0 args) "variable" t context))
              ((= operator "defconst")
               (unless (and (>= count 1) (<= count 2))
                 (analyzer-fail
                   context (node-span form) "defconst expects 1..2 arguments"))
               (declare-binding
                 scope (js-nth 0 args) "constant" false context))
              ((or (= operator "defun") (= operator "defn")
                   (= operator "defportable") (= operator "defasync"))
               (unless (>= count 2)
                 (analyzer-fail
                   context (node-span form)
                   (str operator " expects 2+ arguments")))
               (declare-binding
                 scope (js-nth 0 args) "function" false context))))))))

  (defun analyze-top-level (form scope context)
    (if (not (= (node-kind form) "list"))
        (analyze-expression form scope context)
      (let* ((items (node-items form))
             (operator-node (js-nth 0 items))
             (operator (and (symbol-node-p operator-node)
                            (node-name operator-node)))
             (args (js-call items :slice 1))
             (count (get args :length)))
        (cond
          ((or (= operator "import") (= operator "import-portable")) nil)
          ((or (= operator "defvar") (= operator "defconst"))
           (when (> count 2)
             (analyzer-fail
               context (node-span form)
               (str operator " expects 1..2 arguments")))
           (analyze-expression (js-nth 1 args) scope context))
          ((or (= operator "defun") (= operator "defn")
               (= operator "defportable") (= operator "defasync"))
           (unless (>= count 2)
             (analyzer-fail
               context (node-span form)
               (str operator " expects 2+ arguments")))
           (analyze-function
             (js-nth 1 args)
             (js-call args :slice 2)
             scope context (= operator "defasync")))
          ((= operator "export")
           (when (= count 0)
             (analyzer-fail
               context (node-span form)
               "export expects one or more bindings"))
           (js-call args :forEach
             (lambda (name)
               (unless (symbol-node-p name)
                 (analyzer-fail
                   context (node-span name)
                   (str "export name must be a symbol: "
                        (node-display name))))
               (require-binding scope name context))))
          ((= operator "export-default")
           (unless (= count 1)
             (analyzer-fail
               context (node-span form)
               "export-default expects 1 argument"))
           (analyze-expression (js-nth 0 args) scope context))
          (t (analyze-expression form scope context))))))

  (defun portable-declarations (forms context)
    (let ((declarations (new (js* "Map"))))
      (js-call forms :forEach
        (lambda (form)
          (when (= (node-kind form) "list")
            (let* ((items (node-items form))
                   (operator-node (js-nth 0 items))
                   (operator (and (symbol-node-p operator-node)
                                  (node-name operator-node)))
                   (args (js-call items :slice 1)))
              (cond
                ((= operator "defconst")
                 (js-call declarations :set (node-name (js-nth 0 args))
                   (object :kind "constant" :form form
                           :initializer (js-nth 1 args))))
                ((= operator "defvar")
                 (js-call declarations :set (node-name (js-nth 0 args))
                   (object :kind "variable" :form form)))
                ((or (= operator "defun") (= operator "defn")
                     (= operator "defportable") (= operator "defasync"))
                 (js-call declarations :set (node-name (js-nth 0 args))
                   (object
                     :kind (if (= operator "defportable")
                               "portable" "function")
                     :form form
                     :parameters (js-nth 1 args)
                     :body (js-call args :slice 2))))
                ((or (= operator "import") (= operator "import-portable"))
                 (js-call
                   (import-bindings
                     args context (node-span form)
                     (= operator "import-portable"))
                   :forEach
                   (lambda (name)
                     (js-call declarations :set (node-name name)
                       (object
                         :kind (if (= operator "import-portable")
                                   "portable-import" "import")
                         :form form))))))))))
      declarations))

  (defun portable-scope (parameters context)
    (let ((scope (new (js* "Set"))))
      (when parameters
        (js-call (function-parameters parameters context) :forEach
          (lambda (parameter)
            (js-call (get parameter :bindings) :forEach
              (lambda (binding)
                (js-call scope :add (node-name binding)))))))
      scope))

  (defun copy-portable-scope (scope)
    (new (js* "Set") scope))

  (defun add-portable-pattern (pattern scope context)
    (js-call (binding-nodes pattern context) :forEach
      (lambda (binding)
        (js-call scope :add (node-name binding)))))

  (defun portable-reference
      (node scope declarations dependencies entry context)
    (let ((name (node-name node)))
      (unless (js-call scope :has name)
        (when (qualified-name-p name)
          (analyzer-fail
            context (node-span node)
            (str "portable function " entry
                 " uses qualified host reference: " name)))
        (let ((declaration (js-call declarations :get name)))
          (when declaration
            (let ((kind (get declaration :kind)))
              (if (or (= kind "portable") (= kind "constant")
                      (= kind "portable-import"))
                  (js-call dependencies :add name)
                (analyzer-fail
                  context (node-span node)
                  (str "portable function " entry
                       " depends on non-portable " kind ": " name)))))))))

  (defun portable-sequence
      (forms scope declarations dependencies entry context)
    (js-call forms :forEach
      (lambda (form)
        (portable-expression
          form scope declarations dependencies entry context))))

  (defun portable-function-expression
      (args scope declarations dependencies entry context)
    (let ((child (copy-portable-scope scope)))
      (js-call (function-parameters (js-nth 0 args) context) :forEach
        (lambda (parameter)
          (js-call (get parameter :bindings) :forEach
            (lambda (binding)
              (js-call child :add (node-name binding))))))
      (portable-sequence
        (js-call args :slice 1)
        child declarations dependencies entry context)))

  (defun portable-let-expression
      (args scope sequential declarations dependencies entry context)
    (let ((bindings (list-items (js-nth 0 args)))
          (child (copy-portable-scope scope)))
      (if sequential
          (js-call bindings :forEach
            (lambda (binding)
              (let* ((items (list-items binding))
                     (name (if items (js-nth 0 items) binding))
                     (initializer (and items (js-nth 1 items))))
                (portable-expression
                  initializer child declarations dependencies entry context)
                (add-portable-pattern name child context))))
        (progn
          (js-call bindings :forEach
            (lambda (binding)
              (let ((items (list-items binding)))
                (when items
                  (portable-expression
                    (js-nth 1 items) scope declarations dependencies entry context)))))
          (js-call bindings :forEach
            (lambda (binding)
              (let ((items (list-items binding)))
                (add-portable-pattern
                  (if items (js-nth 0 items) binding) child context))))))
      (portable-sequence
        (js-call args :slice 1)
        child declarations dependencies entry context)))

  (defun portable-loop-expression
      (args scope declarations dependencies entry context)
    (let ((bindings (list-items (js-nth 0 args)))
          (child (copy-portable-scope scope)))
      (js-call bindings :forEach
        (lambda (binding)
          (let ((items (list-items binding)))
            (portable-expression
              (js-nth 1 items) scope declarations dependencies entry context))))
      (js-call bindings :forEach
        (lambda (binding)
          (add-portable-pattern
            (js-nth 0 (list-items binding)) child context)))
      (portable-sequence
        (js-call args :slice 1)
        child declarations dependencies entry context)))

  (defun portable-assignment
      (args scope declarations dependencies entry context)
    (let ((index 0))
      (while (< index (get args :length))
        (let ((name (js-nth index args))
              (value (js-nth (1+ index) args)))
          (unless (js-call scope :has (node-name name))
            (analyzer-fail
              context (node-span name)
              (str "portable function " entry
                   " may only assign local bindings: " (node-name name))))
          (portable-expression
            value scope declarations dependencies entry context))
        (setq index (+ index 2)))))

  (defun portable-object
      (args scope declarations dependencies entry context)
    (let ((index 0))
      (while (< index (get args :length))
        (let ((key (js-nth index args))
              (value (js-nth (1+ index) args)))
          (unless (or (keyword-node-p key)
                      (string-node-p key)
                      (symbol-node-p key))
            (portable-expression
              key scope declarations dependencies entry context))
          (portable-expression
            value scope declarations dependencies entry context))
        (setq index (+ index 2)))))

  (defun portable-host-key-call
      (args scope declarations dependencies entry context)
    (let ((index 0))
      (while (< index (get args :length))
        (let ((argument (js-nth index args)))
          (unless (and (= index 1) (keyword-node-p argument))
            (portable-expression
              argument scope declarations dependencies entry context)))
        (setq index (1+ index)))))

  (defun portable-call
      (form scope declarations dependencies entry context)
    (let* ((items (node-items form))
           (operator-node (js-nth 0 items))
           (operator (and (symbol-node-p operator-node)
                          (node-name operator-node)))
           (args (js-call items :slice 1)))
      (when (js-call portable-forbidden-operators :includes operator)
        (analyzer-fail
          context (node-span form)
          (str "portable function " entry " cannot use " operator " ("
               (cond
                 ((= operator "js*") "raw JavaScript")
                 ((= operator "print") "console output")
                 ((= operator "put") "object mutation")
                 ((= operator "js-call") "host method calls")
                 ((= operator "new") "host constructors")
                 ((= operator "async") "asynchronous functions")
                 ((= operator "await") "asynchronous suspension")
                 ((or (= operator "throw") (= operator "try"))
                  "exception control flow")
                (t "React runtime access"))
               ")")))
      (cond
        ((= operator "quote") nil)
        ((or (= operator "lambda") (= operator "fn"))
         (portable-function-expression
           args scope declarations dependencies entry context))
        ((= operator "let")
         (portable-let-expression
           args scope false declarations dependencies entry context))
        ((= operator "let*")
         (portable-let-expression
           args scope t declarations dependencies entry context))
        ((= operator "loop")
         (portable-loop-expression
           args scope declarations dependencies entry context))
        ((or (= operator "setq") (= operator "set!"))
         (portable-assignment
           args scope declarations dependencies entry context))
        ((or (= operator "object") (= operator "js-object"))
         (portable-object
           args scope declarations dependencies entry context))
        ((or (= operator "get")
             (= operator "aref")
             (= operator "object-has?")
             (= operator "object-assoc"))
         (portable-host-key-call
           args scope declarations dependencies entry context))
        (t
         (unless (js-call builtin-operators :includes operator)
           (portable-expression
             operator-node scope declarations dependencies entry context))
         (portable-sequence
           args scope declarations dependencies entry context)))))

  (defun portable-expression
      (form scope declarations dependencies entry context)
    (when form
      (cond
        ((or (= (node-kind form) "literal")
             (= (node-kind form) "undefined")) nil)
        ((= (node-kind form) "keyword") nil)
        ((= (node-kind form) "symbol")
         (portable-reference
           form scope declarations dependencies entry context))
        ((= (node-kind form) "vector")
         (portable-sequence
           (node-items form) scope declarations dependencies entry context))
        ((= (node-kind form) "list")
         (portable-call
           form scope declarations dependencies entry context)))))

  (defun portable-dependencies (declaration declarations entry context)
    (let ((dependencies (new (js* "Set")))
          (scope (portable-scope (get declaration :parameters) context)))
      (if (= (get declaration :kind) "portable")
          (portable-sequence
            (get declaration :body)
            scope declarations dependencies entry context)
        (portable-expression
          (get declaration :initializer)
          scope declarations dependencies entry context))
      dependencies))

  (defun validate-portable-module (forms context)
    (let ((declarations (portable-declarations forms context))
          (pending (js-array))
          (visited (new (js* "Set"))))
      (js-call declarations :forEach
        (lambda (declaration name)
          (when (= (get declaration :kind) "portable")
            (js-call pending :push name))))
      (while (> (get pending :length) 0)
        (let ((name (js-call pending :pop)))
          (unless (js-call visited :has name)
            (js-call visited :add name)
            (let ((declaration (js-call declarations :get name)))
              (js-call
                (portable-dependencies
                  declaration declarations name context)
                :forEach
                (lambda (dependency)
                  (js-call pending :push dependency)))))))
      forms))

  (defun select-portable-module (forms entries filename)
    (let* ((context (object :filename filename))
           (flattened (flatten-modules forms context))
           (declarations (portable-declarations flattened context))
           (pending (js-array))
           (selected (new (js* "Set"))))
      (js-call entries :forEach
        (lambda (entry)
          (let ((declaration (js-call declarations :get entry)))
            (unless (and declaration (= (get declaration :kind) "portable"))
              (analyzer-fail
                context nil
                (str "portable entry " entry
                     " is not declared with defportable")))
            (js-call pending :push entry))))
      (while (> (get pending :length) 0)
        (let ((name (js-call pending :pop)))
          (unless (js-call selected :has name)
            (js-call selected :add name)
            (let ((declaration (js-call declarations :get name)))
              (when (= (get declaration :kind) "portable-import")
                (analyzer-fail
                  context (node-span (get declaration :form))
                  (str "portable import " name
                       " requires a project build")))
              (js-call
                (portable-dependencies
                  declaration declarations name context)
                :forEach
                (lambda (dependency)
                  (js-call pending :push dependency)))))))
      (js-call flattened :filter
        (lambda (form)
          (when (= (node-kind form) "list")
            (let* ((items (node-items form))
                   (operator (and (symbol-node-p (js-nth 0 items))
                                  (node-name (js-nth 0 items))))
                   (name (and (> (get items :length) 1)
                              (symbol-node-p (js-nth 1 items))
                              (node-name (js-nth 1 items)))))
              (or
                (and (or (= operator "defconst")
                         (= operator "defportable"))
                     (js-call selected :has name))
                (and (= operator "import-portable")
                     (js-call
                       (js-call items :slice 2)
                       :some
                       (lambda (imported)
                         (js-call selected :has (node-name imported))))))))))))

  (defun analyze-module (forms filename)
    (let* ((context
            (object
              :filename filename
              :tailPosition false
              :recurTargets (js-array)
              :recurBarrier false))
           (flattened (flatten-modules forms context))
           (scope (make-scope nil)))
      (predeclare-top-level flattened scope context)
      (js-call flattened :forEach
        (lambda (form) (analyze-top-level form scope context)))
      (analyze-transients forms filename)
      (validate-portable-module flattened context)
      forms))

  (export analyze-module select-portable-module))
