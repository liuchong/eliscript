(module bootstrap.compiler.lower
  (import "./syntax.mjs"
    node-kind node-span node-value node-name node-items)
  (import "./ir.mjs" make-program make-node)

  (defconst intrinsics
    (js-array "not" "+" "*" "-" "/" "%" "mod" "=" "/=" "not=" "<" "<="
     ">" ">=" "1+" "1-" "eq" "equal" "null" "nil?" "undefined?"
     "int32" "uint32" "imul32" "bit-and" "bit-or" "bit-xor" "bit-not"
     "bit-shift-left" "bit-shift-right" "unsigned-bit-shift-right"
     "value-type" "host-identity-token" "string-code-unit-at" "string-from-code-unit"
     "string-to-number" "string-to-bigint" "number-float64-words"
     "nullish?" "list" "car" "cdr" "cons" "nth" "js-nth"
     "aref" "length" "js-length"
     "object-keys" "object-has?" "object-assoc"))

  (defconst fail
    (js* "(message) => { throw new Error(message); }"))
  (defvar recur-targets (js-array))

  (defun symbol-node-p (node)
    (and node (= (node-kind node) "symbol")))

  (defun keyword-node-p (node)
    (and node (= (node-kind node) "keyword")))

  (defun vector-node-p (node)
    (and node (= (node-kind node) "vector")))

  (defun string-node-p (node)
    (and node
         (= (node-kind node) "literal")
         (= (js* "typeof node.value") "string")))

  (defun null-node-p (node)
    (and node
         (= (node-kind node) "literal")
         (null (node-value node))))

  (defun list-items (node)
    (cond
      ((null-node-p node) (js-array))
      ((and node (= (node-kind node) "list")) (node-items node))
      (t undefined)))

  (defun syntax-datum (node)
    (cond
      ((= (node-kind node) "literal")
       (if (= (node-value node) false)
           (object :kind "symbol" :name "false")
         (node-value node)))
      ((= (node-kind node) "undefined") (object :kind "undefined"))
      ((= (node-kind node) "symbol")
       (object :kind "symbol" :name (node-name node)))
      ((= (node-kind node) "keyword")
       (object :kind "keyword" :name (node-name node)))
      ((or (= (node-kind node) "list") (= (node-kind node) "vector"))
       (let ((items (js-array)))
         (js-call (node-items node) :forEach
           (lambda (item) (js-call items :push (syntax-datum item))))
         (object :kind (node-kind node) :items items)))
      (t
       (fail (str "cannot encode quoted syntax kind: " (node-kind node))))))

  (defun lower-sequence (forms)
    (let ((nodes (js-array)))
      (js-call forms :forEach
        (lambda (form) (js-call nodes :push (lower-expression form))))
      nodes))

  (defun append-nodes (target nodes)
    (js-call nodes :forEach
      (lambda (node) (js-call target :push node)))
    target)

  (defun lower-literal (form)
    (cond
      ((= (node-kind form) "undefined")
       (make-node
         "literal" (node-span form) nil (js-array)
         (object :literalKind "undefined")))
      ((= (node-kind form) "keyword")
       (make-node
         "literal" (node-span form) (node-name form) (js-array)
         (object :literalKind "keyword")))
      (t
       (make-node
         "literal" (node-span form) (node-value form) (js-array) nil))))

  (defun lower-binding-target (pattern)
    (cond
      ((symbol-node-p pattern)
       (make-node
         "binding-name" (node-span pattern) (node-name pattern) (js-array) nil))
      ((vector-node-p pattern)
       (let ((children (js-array))
             (rest false))
         (js-call (node-items pattern) :forEach
           (lambda (element)
             (cond
               ((and (symbol-node-p element)
                     (= (node-name element) "&rest"))
                (setq rest t))
               ((null-node-p element)
                (js-call children :push
                  (make-node
                    "binding-hole" (node-span element) nil (js-array) nil)))
               (t
                (js-call children :push
                  (lower-binding-target element))))))
         (make-node
           "array-binding-pattern" (node-span pattern) nil children
           (if rest (object :rest t) nil))))
      (t (fail "cannot lower invalid binding pattern"))))

  (defun lower-parameter-nodes (parameters)
    (let ((result (js-array))
          (items (list-items parameters))
          (mode "required"))
      (js-call items :forEach
        (lambda (parameter)
          (let ((name (node-name parameter)))
            (cond
              ((= name "&optional") (setq mode "optional"))
              ((= name "&rest") (setq mode "rest"))
              (t
               (if (vector-node-p parameter)
                   (js-call result :push
                     (make-node
                       "parameter-binding"
                       (node-span parameter)
                       nil
                       (js-array (lower-binding-target parameter))
                       (object :parameterKind mode :pattern t)))
                 (js-call result :push
                   (make-node
                     "parameter-binding"
                     (node-span parameter)
                     name
                     (js-array) (object :parameterKind mode))))
               (when (= mode "rest") (setq mode "done")))))))
      result))

  (defun lower-binding (binding)
    (if (symbol-node-p binding)
        (make-node
          "lexical-binding" (node-span binding) (node-name binding) (js-array)
          (object :style "symbol"))
      (if (vector-node-p binding)
          (make-node
            "lexical-binding" (node-span binding) nil
            (js-array (lower-binding-target binding))
            (object :style "symbol" :pattern t))
        (let* ((items (list-items binding))
               (target (js-nth 0 items))
               (children (js-array)))
          (if (vector-node-p target)
              (progn
                (js-call children :push (lower-binding-target target))
                (when (> (get items :length) 1)
                  (js-call children :push
                    (lower-expression (js-nth 1 items))))
                (make-node
                  "lexical-binding" (node-span binding) nil children
                  (object :style "list" :pattern t)))
            (progn
              (when (> (get items :length) 1)
                (js-call children :push
                  (lower-expression (js-nth 1 items))))
              (make-node
                "lexical-binding" (node-span binding)
                (node-name target) children
                (object :style "list"))))))))

  (defun lower-call-node (kind form operator args)
    (make-node
      kind (node-span form) operator (lower-sequence args) nil))

  (defun lower-assignments (form operator args)
    (let ((pairs (js-array))
          (index 0))
      (while (< index (get args :length))
        (let ((name (js-nth index args))
              (value (js-nth (1+ index) args)))
          (js-call pairs :push
            (make-node
              "assignment-pair"
              (node-span name)
              (node-name name)
              (js-array (lower-expression value))
              nil)))
        (setq index (+ index 2)))
      (make-node "assignment" (node-span form) operator pairs nil)))

  (defun literal-object-key-p (node)
    (or (keyword-node-p node) (string-node-p node) (symbol-node-p node)))

  (defun literal-object-key (node)
    (if (or (keyword-node-p node) (symbol-node-p node))
        (node-name node)
      (node-value node)))

  (defun lower-object (form args)
    (let ((properties (js-array))
          (index 0))
      (while (< index (get args :length))
        (let ((key (js-nth index args))
              (value (js-nth (1+ index) args)))
          (if (literal-object-key-p key)
              (js-call properties :push
                (make-node
                  "object-property"
                  (node-span key)
                  (literal-object-key key)
                  (js-array (lower-expression value))
                  (object :computed false)))
            (js-call properties :push
              (make-node
                "object-property"
                (node-span key)
                nil
                (js-array (lower-expression key) (lower-expression value))
                (object :computed t)))))
        (setq index (+ index 2)))
      (make-node "object-literal" (node-span form) nil properties nil)))

  (defun clause-operator (form)
    (let ((items (list-items form)))
      (and (not (eq items undefined))
           (> (get items :length) 0)
           (symbol-node-p (js-nth 0 items))
           (node-name (js-nth 0 items)))))

  (defun lower-try (form args)
    (let ((body (js-array))
          (clauses (js-array)))
      (js-call args :forEach
        (lambda (argument)
          (let ((items (list-items argument))
                (operator (clause-operator argument)))
            (cond
              ((= operator "catch")
               (let ((binding (js-nth 1 items))
                     (children (js-array)))
                 (if (vector-node-p binding)
                     (js-call children :push
                       (make-node
                         "catch-binding" (node-span binding) nil
                         (js-array (lower-binding-target binding))
                         (object :pattern t)))
                   (js-call children :push
                     (make-node
                       "catch-binding" (node-span binding)
                       (node-name binding) (js-array) nil)))
                 (append-nodes children
                   (lower-sequence (js-call items :slice 2)))
                 (js-call clauses :push
                   (make-node
                     "catch-clause" (node-span argument) nil children nil))))
              ((= operator "finally")
               (js-call clauses :push
                 (make-node
                   "finally-clause" (node-span argument) nil
                   (lower-sequence (js-call items :slice 1)) nil)))
              (t (js-call body :push (lower-expression argument)))))))
      (let ((children (js-array)))
        (append-nodes children body)
        (append-nodes children clauses)
        (make-node
          "try-expression" (node-span form) nil children
          (object :bodyCount (get body :length))))))

  (defun lower-cond (form args)
    (let ((clauses (js-array)))
      (js-call args :forEach
        (lambda (clause)
          (js-call clauses :push
            (make-node
              "conditional-clause"
              (node-span clause)
              nil
              (lower-sequence (list-items clause))
              nil))))
      (make-node "conditional-chain" (node-span form) nil clauses nil)))

  (defun lower-let (form operator args)
    (let ((bindings (js-array))
          (children (js-array)))
      (js-call (list-items (js-nth 0 args)) :forEach
        (lambda (binding)
          (js-call bindings :push (lower-binding binding))))
      (append-nodes children bindings)
      (append-nodes children (lower-sequence (js-call args :slice 1)))
      (make-node
        "lexical-bindings" (node-span form) nil children
        (object
          :sequential (= operator "let*")
          :bindingCount (get bindings :length)))))

  (defun lower-function
      (kind form value parameters body &optional asynchronous)
    (let ((parameter-nodes (lower-parameter-nodes parameters))
          (children (js-array))
          (previous-targets recur-targets))
      (setq recur-targets (js-array "function"))
      (append-nodes children parameter-nodes)
      (append-nodes children (lower-sequence body))
      (setq recur-targets previous-targets)
      (make-node
        kind (node-span form) value children
        (object
          :parameterCount (get parameter-nodes :length)
          :async (if asynchronous t false)))))

  (defun lower-expression (form)
    (cond
      ((or (= (node-kind form) "literal")
           (= (node-kind form) "undefined")
           (= (node-kind form) "keyword"))
       (lower-literal form))
      ((= (node-kind form) "symbol")
       (make-node "reference" (node-span form) (node-name form) (js-array) nil))
      ((= (node-kind form) "vector")
       (make-node
         "persistent-vector-literal" (node-span form) nil
         (lower-sequence (node-items form)) nil))
      ((= (node-kind form) "list")
       (let* ((items (node-items form))
              (operator-node (js-nth 0 items))
              (operator (and (symbol-node-p operator-node)
                             (node-name operator-node)))
              (args (js-call items :slice 1)))
         (cond
           ((= operator "quote")
            (make-node
              "quoted-literal" (node-span form)
              (syntax-datum (js-nth 0 args)) (js-array) nil))
           ((or (= operator "lambda") (= operator "fn")
                (= operator "async"))
            (lower-function
              "function-expression" form nil
              (js-nth 0 args) (js-call args :slice 1)
              (= operator "async")))
           ((= operator "await")
            (make-node
              "await-expression" (node-span form) nil
              (js-array (lower-expression (js-nth 0 args))) nil))
           ((= operator "throw")
            (make-node
              "throw-expression" (node-span form) nil
              (js-array (lower-expression (js-nth 0 args))) nil))
           ((= operator "try") (lower-try form args))
           ((= operator "if")
            (lower-call-node "conditional" form "if" args))
           ((or (= operator "when") (= operator "unless"))
            (lower-call-node "conditional-sugar" form operator args))
           ((= operator "cond") (lower-cond form args))
           ((or (= operator "progn") (= operator "do"))
            (lower-call-node "sequence" form operator args))
           ((or (= operator "let") (= operator "let*"))
            (lower-let form operator args))
           ((= operator "loop")
            (let ((bindings (js-array))
                  (children (js-array))
                  (previous-targets recur-targets)
                  (targets (js-array "loop")))
              (js-call (list-items (js-nth 0 args)) :forEach
                (lambda (binding)
                  (js-call bindings :push (lower-binding binding))))
              (js-call previous-targets :forEach
                (lambda (target) (js-call targets :push target)))
              (setq recur-targets targets)
              (append-nodes children bindings)
              (append-nodes children
                (lower-sequence (js-call args :slice 1)))
              (setq recur-targets previous-targets)
              (make-node
                "binding-loop" (node-span form) nil children
                (object :bindingCount (get bindings :length)))))
           ((= operator "recur")
            (make-node
              "recur" (node-span form) nil (lower-sequence args)
              (object :targetKind (js-nth 0 recur-targets))))
           ((or (= operator "setq") (= operator "set!"))
            (lower-assignments form operator args))
           ((= operator "while")
            (lower-call-node "loop" form "while" args))
           ((or (= operator "and") (= operator "or"))
            (lower-call-node "short-circuit" form operator args))
           ((= operator "vector")
            (make-node
              "persistent-vector-literal" (node-span form) nil
              (lower-sequence args) nil))
           ((= operator "hash-map")
            (make-node
              "persistent-map-literal" (node-span form) nil
              (lower-sequence args) nil))
           ((= operator "hash-set")
            (make-node
              "persistent-set-literal" (node-span form) nil
              (lower-sequence args) nil))
           ((or (= operator "array") (= operator "js-array"))
            (make-node
              "array-literal" (node-span form) nil
              (lower-sequence args) nil))
           ((= operator "jsx")
            (make-node
              "react-element" (node-span form) nil (lower-sequence args)
              (object :childCount (- (get args :length) 2))))
           ((= operator "fragment")
            (make-node
              "react-fragment" (node-span form) nil (lower-sequence args)
              (object :childCount (get args :length))))
           ((js-call intrinsics :includes operator)
            (lower-call-node "intrinsic" form operator args))
           ((or (= operator "object") (= operator "js-object"))
            (lower-object form args))
           ((= operator "get")
            (lower-call-node "property-read" form "get" args))
           ((= operator "put")
            (lower-call-node "property-write" form "put" args))
           ((= operator "js-call")
            (lower-call-node "method-call" form "js-call" args))
           ((= operator "new")
            (lower-call-node "constructor-call" form "new" args))
           ((= operator "js*")
            (lower-call-node "raw-javascript" form "js*" args))
           ((= operator "print")
            (lower-call-node "print" form "print" args))
           ((= operator "str")
            (lower-call-node "string-concat" form "str" args))
           ((= operator "funcall")
            (lower-call-node "invoke" form "funcall" args))
           ((= operator "apply")
            (lower-call-node "apply-call" form "apply" args))
           (t
            (make-node
              "call" (node-span form) nil (lower-sequence items) nil)))))
      (t
       (fail (str "cannot lower syntax kind: " (node-kind form))))))

  (defun lower-import (form args portable)
    (let ((source (node-value (js-nth 0 args)))
          (children (js-array))
          (index 1))
      (while (< index (get args :length))
        (let ((specifier (js-nth index args)))
          (cond
            ((and (keyword-node-p specifier)
                  (= (node-name specifier) "default"))
             (setq index (1+ index))
             (let ((name (js-nth index args)))
               (js-call children :push
                 (make-node
                   "import-default" (node-span name) (node-name name) (js-array) nil))))
            ((and (keyword-node-p specifier)
                  (= (node-name specifier) "as"))
             (setq index (1+ index))
             (let ((name (js-nth index args)))
               (js-call children :push
                 (make-node
                   "import-namespace" (node-span name) (node-name name) (js-array) nil))))
            (t
             (js-call children :push
               (make-node
                 "import-named"
                 (node-span specifier)
                 (node-name specifier)
                 (js-array) nil))))
          (setq index (1+ index))))
      (make-node
        "import-declaration" (node-span form) source children
        (if portable (object :portable t) nil))))

  (defun lower-top-level (form)
    (if (not (= (node-kind form) "list"))
        (make-node
          "expression-statement" (node-span form) nil
          (js-array (lower-expression form)) nil)
      (let* ((items (node-items form))
             (operator-node (js-nth 0 items))
             (operator (and (symbol-node-p operator-node)
                            (node-name operator-node)))
             (args (js-call items :slice 1)))
        (cond
          ((= operator "module")
           (let ((children (js-array)))
             (js-call (js-call args :slice 1) :forEach
               (lambda (child)
                 (js-call children :push (lower-top-level child))))
             (make-node
               "module-declaration" (node-span form)
               (node-name (js-nth 0 args)) children nil)))
          ((= operator "import") (lower-import form args false))
          ((= operator "import-portable") (lower-import form args t))
          ((or (= operator "defvar") (= operator "defconst"))
           (let ((children (js-array)))
             (when (> (get args :length) 1)
               (js-call children :push (lower-expression (js-nth 1 args))))
             (make-node
               "variable-declaration" (node-span form)
               (node-name (js-nth 0 args)) children
               (object
                 :sourceOperator operator
                 :mutable (= operator "defvar")))))
          ((or (= operator "defun") (= operator "defn")
               (= operator "defportable") (= operator "defasync"))
           (let ((node
                  (lower-function
                    "function-declaration" form (node-name (js-nth 0 args))
                    (js-nth 1 args) (js-call args :slice 2)
                    (= operator "defasync"))))
             (put node :properties
               (object
                 :parameterCount
                   (get (get node :properties) :parameterCount)
                 :sourceOperator operator
                 :portable (= operator "defportable")
                 :async (= operator "defasync")))
             node))
          ((= operator "export")
           (let ((children (js-array)))
             (js-call args :forEach
               (lambda (name)
                 (js-call children :push
                   (make-node
                     "reference" (node-span name) (node-name name) (js-array) nil))))
             (make-node
               "export-declaration" (node-span form) nil children nil)))
          ((= operator "export-default")
           (make-node
             "export-default" (node-span form) nil
             (js-array (lower-expression (js-nth 0 args))) nil))
          (t
           (make-node
             "expression-statement" (node-span form) nil
             (js-array (lower-expression form)) nil))))))

  (defun lower-module (forms filename)
    (let ((body (js-array)))
      (setq recur-targets (js-array))
      (js-call forms :forEach
        (lambda (form) (js-call body :push (lower-top-level form))))
      (make-program filename body)))

  (export lower-expression lower-top-level lower-module))
