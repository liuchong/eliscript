    (funcall native-source-locations source marks))

  (defun original-location (span locations)
    (let ((start (aref span "start")))
      (if (eq start undefined)
          (js-array (- (aref span "line") 1) (- (aref span "column") 1))
        (let ((found (js-call locations :get start)))
          (if (eq found undefined)
              (js-array (- (aref span "line") 1) (- (aref span "column") 1))
            found)))))

  (defun group-marks (marks locations)
    (let ((current-line 0)
          (current-segments (js-array))
          (lines (js-array))
          (mark-count (bit-or (aref marks "length") 0))
          (mark-index 0))
      (while (< mark-index mark-count)
        (let* ((mark (aref marks mark-index))
               (generated-line (- (aref mark 0) 0)))
          (while (< current-line generated-line)
            (js-call lines :push current-segments)
            (setq current-segments (js-array))
            (setq current-line (+ current-line 1)))
          (let ((original (original-location (aref mark 2) locations)))
            (js-call current-segments :push
              (js-array (aref mark 1) 0 (aref original 0) (aref original 1)))))
        (setq mark-index (+ mark-index 1)))
      (js-call lines :push current-segments)
      lines))

  (defun encode-segment (segment state)
    (let ((generated-column (aref segment 0))
          (source (aref segment 1))
          (original-line (aref segment 2))
          (original-column (aref segment 3)))
      (let ((encoded
             (str (encode-vlq (- generated-column (aref state "generatedColumn")))
                  (encode-vlq (- source (aref state "source")))
                  (encode-vlq (- original-line (aref state "originalLine")))
                  (encode-vlq (- original-column (aref state "originalColumn"))))))
        (put state :generatedColumn generated-column)
        (put state :source source)
        (put state :originalLine original-line)
        (put state :originalColumn original-column)
        encoded)))

  (defun encode-mappings (lines)
    (let ((state (js-object :generatedColumn 0 :source 0 :originalLine 0 :originalColumn 0))
          (encoded-lines (js-array))
          (line-count (bit-or (aref lines "length") 0))
          (line-index 0))
      (while (< line-index line-count)
        (let ((segments (aref lines line-index))
              (encoded (js-array))
              (segment-index 0))
          (put state :generatedColumn 0)
          (while (< segment-index (aref segments "length"))
            (js-call encoded :push (encode-segment (aref segments segment-index) state))
            (setq segment-index (+ segment-index 1)))
          (js-call encoded-lines :push (js-call encoded :join ",")))
        (setq line-index (+ line-index 1)))
      (js-call encoded-lines :join ";")))

  (defun create-source-map
      (generated marks source source-name generated-name)
    (unless (funcall array-is-array marks)
      (fail "source map marks must be an array"))
    (let* ((generated-marks (collect-generated-marks generated marks))
           (locations (source-locations source generated-marks))
           (mappings
             (if (and (not (nil? smap-host-kernels))
                      (unpatched-method-p string-prototype "charAt" default-string-char-at)
                      (unpatched-method-p array-prototype "join" default-array-join))
                 (js-call smap-host-kernels :encodeGeneratedMarks generated-marks locations)
               (encode-mappings (group-marks generated-marks locations))))
           (document (js-object :version 3)))
      (when generated-name
        (put document :file generated-name))
      (put document :sources (js-array source-name))
      (put document :sourcesContent (js-array source))
      (put document :names (js-array))
      (put document :mappings mappings)
      (str (JSON/stringify document) "\n")))

  (export
    encode-vlq
    collect-generated-marks
    reference-collect-generated-marks
    source-locations
    reference-source-locations
    create-source-map))
