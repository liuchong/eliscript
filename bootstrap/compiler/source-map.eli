(module bootstrap.compiler.source-map
  (defconst base64
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
  (defconst fail
    (lambda (message)
      (throw (new (js* "Error") message))))
  (defconst visit-iterable
    (js* "(iterable, visit) => { for (const item of iterable) visit(item); }"))
  (defconst spread-iterable (js* "(iterable) => [...iterable]"))
  (defconst native-source-locations
    (lambda (source marks)
      (let ((wanted (new (js* "Set"))) (locations (new (js* "Map"))))
        (funcall visit-iterable marks
          (lambda (mark)
            (let* ((entry (if (nullish? mark) (js-array) mark))
                   (raw-span (aref entry 2))
                   (span (if (nullish? raw-span) nil raw-span))
                   (start (aref span "start")))
              (unless (eq start undefined) (js-call wanted :add start)))))
        (let* ((starts (js-call (funcall spread-iterable wanted) :filter
                        (lambda (start)
                          (let ((answer (Number/isSafeInteger start)))
                            (and (js* "!!answer") (>= start 0))))))
               (ordered (js-call starts :sort (lambda (left right) (- left right))))
               (index 0) (offset 0) (line 0) (column 0))
          (funcall visit-iterable ordered
            (lambda (start)
              (while (and (< offset start) (< index (aref source "length")))
                (let* ((code (js-call source :codePointAt index))
                       (width (if (> code 65535) 2 1)))
                  (if (eq code 10) (progn (setq line (+ line 1)) (setq column 0))
                    (setq column (+ column width)))
                  (setq index (+ index width)) (setq offset (+ offset 1))))
              (when (and (eq offset start)
                         (or (< index (aref source "length")) (eq (aref source "length") 0)))
                (js-call locations :set offset (js-array line column)))))
          locations))))
  (defconst native-collect-generated-marks
    (lambda (generated marks)
      (let ((result (js-array)) (index 0) (line 0) (column 0))
        (funcall visit-iterable marks
          (lambda (mark)
            (let ((target (aref mark "offset")))
              (while (and (< index target) (< index (aref generated "length")))
                (if (eq (js-call generated :charCodeAt index) 10)
                    (progn (setq line (+ line 1)) (setq column 0))
                  (setq column (+ column 1)))
                (setq index (+ index 1)))
              (when (and (eq index target) (< index (aref generated "length")))
                (js-call result :push (js-array line column (aref mark "span")))))))
        result)))

  (defun signed-vlq (value)
    (if (< value 0)
        (1+ (* (- value) 2))
      (* value 2)))

  (defun encode-vlq (value)
    (let ((remaining (signed-vlq value))
          (characters (js-array)))
      (while (>= remaining 32)
        (js-call characters :push
          (js-call base64 :charAt (+ (% remaining 32) 32)))
        (setq remaining (Math/floor (/ remaining 32))))
      (js-call characters :push (js-call base64 :charAt remaining))
      (js-call characters :join "")))

  (defun reference-collect-generated-marks (generated marks)
    (let ((index 0)
          (mark-index 0)
          (line 0)
          (column 0)
          (result (js-array)))
      (while (< index (get generated :length))
        (while (and (< mark-index (get marks :length))
                    (= (get (js-nth mark-index marks) :offset) index))
          (js-call result :push
            (js-array line column (get (js-nth mark-index marks) :span)))
          (setq mark-index (1+ mark-index)))
        (if (= (js-call generated :charCodeAt index) 10)
            (progn
              (setq line (1+ line))
              (setq column 0))
          (setq column (1+ column)))
        (setq index (1+ index)))
      result))

  (defun collect-generated-marks (generated marks)
    (funcall native-collect-generated-marks generated marks))

  (defun reference-source-locations (source marks)
    (let ((wanted (new (js* "Map")))
          (locations (new (js* "Map"))))
      (js-call marks :forEach
        (lambda (mark)
          (let ((start (get (js-nth 2 mark) :start)))
            (unless (eq start undefined)
              (js-call wanted :set start t)))))
      (let ((index 0)
            (offset 0)
            (line 0)
            (column 0))
        (while (<= index (get source :length))
          (when (js-call wanted :has offset)
            (js-call locations :set offset (js-array line column)))
          (when (< index (get source :length))
            (let* ((code (js-call source :codePointAt index))
                   (width (if (> code 65535) 2 1)))
              (if (= code 10)
                  (progn
                    (setq line (1+ line))
                    (setq column 0))
                (setq column (+ column width)))
              (setq index (+ index width))
              (setq offset (1+ offset))))
          (when (= index (get source :length))
            (setq index (1+ index)))))
      locations))

  (defun source-locations (source marks)
    (funcall native-source-locations source marks))

  (defun original-location (span locations)
    (let ((start (get span :start)))
      (if (and (not (eq start undefined))
               (js-call locations :has start))
          (js-call locations :get start)
        (js-array (1- (get span :line)) (1- (get span :column))))))

  (defun group-marks (marks locations)
    (let ((current-line 0)
          (current-segments (js-array))
          (lines (js-array)))
      (js-call marks :forEach
        (lambda (mark)
          (let ((generated-line (js-nth 0 mark)))
            (while (< current-line generated-line)
              (js-call lines :push current-segments)
              (setq current-segments (js-array))
              (setq current-line (1+ current-line)))
            (let ((original (original-location (js-nth 2 mark) locations)))
              (js-call current-segments :push
                (js-array (js-nth 1 mark) 0 (js-nth 0 original) (js-nth 1 original)))))))
      (js-call lines :push current-segments)
      lines))

  (defun encode-segment (segment state)
    (let ((generated-column (js-nth 0 segment))
          (source (js-nth 1 segment))
          (original-line (js-nth 2 segment))
          (original-column (js-nth 3 segment)))
      (let ((encoded
             (str
               (encode-vlq
                 (- generated-column (get state :generatedColumn)))
               (encode-vlq (- source (get state :source)))
               (encode-vlq
                 (- original-line (get state :originalLine)))
               (encode-vlq
                 (- original-column (get state :originalColumn))))))
        (put state :generatedColumn generated-column)
        (put state :source source)
        (put state :originalLine original-line)
        (put state :originalColumn original-column)
        encoded)))

  (defun encode-mappings (lines)
    (let ((state
           (js-object
             :generatedColumn 0
             :source 0
             :originalLine 0
             :originalColumn 0))
          (encoded-lines (js-array)))
      (js-call lines :forEach
        (lambda (segments)
          (put state :generatedColumn 0)
          (let ((encoded (js-array)))
            (js-call segments :forEach
              (lambda (segment)
                (js-call encoded :push (encode-segment segment state))))
            (js-call encoded-lines :push (js-call encoded :join ",")))))
      (js-call encoded-lines :join ";")))

  (defun create-source-map
      (generated marks source source-name generated-name)
    (unless (Array/isArray marks)
      (fail "source map marks must be an array"))
    (let* ((generated-marks (collect-generated-marks generated marks))
           (locations (source-locations source generated-marks))
           (mappings (encode-mappings (group-marks generated-marks locations)))
           (document (js-object :version 3)))
      (when generated-name
        (put document :file generated-name))
      (put document :sources (js-array source-name))
      (put document :sourcesContent (js-array source))
      (put document :names (js-array))
      (put document :mappings mappings)
      (str (JSON/stringify document) "\n")))

  (export
    encode-vlq
    collect-generated-marks
    reference-collect-generated-marks
    source-locations
    reference-source-locations
    create-source-map))
