                (store-u32 (+ handle 8) (if (= kind 1) 0 count))
                (store-u32 (+ handle 12) count) (store-u32 (+ handle 16) data)
                (store-u32 (+ handle 20) 0)
                (store-u32 (+ handle 24) (load-u32 12)) (store-u32 12 handle)
                (setq result handle)))) 0))
      (when (= result 0) (store-u32 0 cursor))
      result))
  (defun valid (handle kind)
    ;; Membership comes from allocated headers, never a tag found in byte data.
    (let ((current (load-u32 12)))
      (while (and (/= current 0) (/= current handle))
        (setq current (load-u32 (+ current 24))))
      (if (and (/= current 0) (= (load-u32 current) kind)
               (= (load-u32 (+ current 4)) (load-u32 4))) 1 0)))
  (defun checked (handle kind)
