            (progn (store-u32 (+ output 8) written) (store-u32 (+ output 20) 1) output))))))

  ;; Managed value heap. Public values: 0 nil, 1 false, 2 true, 3 undefined.
  ;; Others are generation/slot IDs scoped to one heap. heap-new preserves
  ;; 12/20; heap-new-extended explicitly selects 12/20, 11/21 or 10/22.
  ;; Control record: magic,pool,maxSlots,slots,freeSlots,cursor,freeBlocks,live,maxBytes,work,exceptionValue,exceptionPending, four weak Error prototypes, runtimeErrorKind, moduleExceptionValue, weak ReferenceError prototype, weak ProtocolDispatchError prototype, strong Object/Array prototypes (3 after close means weak rediscovery).
  ;; Pool entries: generation,flags,blockOffset,blockSize,roots,next (24 bytes).
  ;; Blocks: kind,length,capacity,sealed, four reserved words, then payload.
  ;; Collection defaults to explicit; opt-in allocation safepoints require root frames.
  ;; Control caches 30/31/32 own the selected emoji table, PRNG state and scalar
  ;; Math workspace. They are strong GC roots and are cleared on module close.
  (defun heap-control (heap index)
    (load-u32 (+ (load-u32 (+ heap 16)) (* index 4))))
  (defun heap-control-set (heap index value)
    (store-u32 (+ (load-u32 (+ heap 16)) (* index 4)) value))
  ;; These address-only paths do not allocate, write or invoke source code.
  ;; Keep the original heap.data -> control.pool -> pool.data read order.
  (defun heap-base (heap)
    (load-u32 (+ (load-u32 (+ (load-u32 (+ heap 16)) 4)) 16)))
  (defun heap-entry (heap slot)
    (+ (load-u32 (+ (load-u32 (+ (load-u32 (+ heap 16)) 4)) 16)) (* slot 24)))
  (defun heap-next-allocated-slot (heap after)
    ;; Preserve ascending slot order while skipping words of historical holes.
    ;; The bitmap is raw metadata outside the moving managed pool.
    (let* ((control (load-u32 (+ heap 16))) (limit (load-u32 (+ control 12)))
           (next (1+ after)) (group (word-shr next 5)) (last (word-shr limit 5))
           (bits 0) (offset 0) (result 0))
      (when (< after limit)
        (setq bits (word-and (load-u32 (+ (+ control 2208) (* group 4)))
                            (word-shl 4294967295 (word-and next 31))))
        (while (and (= bits 0) (< group last))
          (setq group (1+ group) bits (load-u32 (+ (+ control 2208) (* group 4)))))
        (when (/= bits 0)
          (when (= (word-and bits 65535) 0) (setq bits (word-shr bits 16) offset 16))
          (when (= (word-and bits 255) 0) (setq bits (word-shr bits 8) offset (+ offset 8)))
          (when (= (word-and bits 15) 0) (setq bits (word-shr bits 4) offset (+ offset 4)))
          (when (= (word-and bits 3) 0) (setq bits (word-shr bits 2) offset (+ offset 2)))
          (when (= (word-and bits 1) 0) (setq offset (1+ offset)))
          (setq next (+ (word-shl group 5) offset))
          (when (<= next limit) (setq result next)))) result))
