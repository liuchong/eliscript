              (if (< byte 128) (setq code byte)
                (if (and (>= byte 194) (<= byte 223))
                  (progn (setq code (word-and byte 31)) (setq needed 1) 0)
                  (if (and (>= byte 224) (<= byte 239))
                    (progn (setq code (word-and byte 15)) (setq needed 2)
                      (when (= byte 224) (setq lower 160))
                      (when (= byte 237) (setq upper 159)) 0)
                    (if (and (>= byte 240) (<= byte 244))
                      (progn (setq code (word-and byte 7)) (setq needed 3)
                        (when (= byte 240) (setq lower 144))
                        (when (= byte 244) (setq upper 143)) 0)
                      (progn (setq invalid 1) 0)))))
              (while (and (< seen needed) (< i length) (= invalid 0))
