              (store-u32 (+ handle 12) capacity) (store-u32 (+ handle 16) data) 1))))))
  (defun buffer-reserve (handle capacity)
    (begin-operation) (if (= (checked handle 1) 1) (reserve handle capacity) 0))
  (defun buffer-push (handle byte)
