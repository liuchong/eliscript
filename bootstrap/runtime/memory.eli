            (> initial maximum) (< initial (+ (* (1+ slots) 24) 32))) (fail 3)
      (let ((cursor (load-u32 0)) (head (load-u32 12)) (result 0))
        (let ((pool (object-new 1 initial 1)))
          (when (/= pool 0)
            (let ((heap (object-new 3 10 4)))
              (when (/= heap 0)
                ;; The private pool's entire capacity must be copied on growth.
                (store-u32 (+ pool 8) initial)
                (heap-control-set heap 0 1212498256) (heap-control-set heap 1 pool)
                (heap-control-set heap 2 slots) (heap-control-set heap 3 0)
                (heap-control-set heap 4 0) (heap-control-set heap 5 (* (1+ slots) 24))
                (heap-control-set heap 6 0) (heap-control-set heap 7 0)
                (heap-control-set heap 8 maximum) (heap-control-set heap 9 0)
                (setq result heap))) 0))
        (when (= result 0) (store-u32 0 cursor) (store-u32 12 head)) result)))
  (defun heap-capacity (heap)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (load-u32 (+ (heap-control heap 1) 12))))
  (defun heap-used (heap)
    (begin-operation) (if (= (heap-check heap) 0) 0 (heap-control heap 5)))
  (defun heap-live (heap)
