(module eliscript.runtime.memory
  (import "eliscript:memory32" load-u8 load-u16 load-u32 store-u8 store-u16 store-u32
    memory-size memory-grow word-div word-shr word-shl word-and word-or)

  ;; Internal memory-u32 ABI; no dynamic Number semantics are changed.
  ;; Control words: bump cursor, lifetime epoch, error, live-object head. Objects: 32-byte
  ;; aligned header [kind, epoch, length, capacity, data, sealed, next, 0].
  ;; Error 1 handle, 2 capacity, 3 bounds, 4 UTF8, 5 UTF16, 6 sealed,
  ;; 7 epoch exhaustion. Public operations clear error before evaluating.
  (defun initialize ()
    (when (= (load-u32 0) 0) (store-u32 0 256) (store-u32 4 1)) 0)
  (defun last-error () (load-u32 8))
  (defun fail (code) (store-u32 8 code) 0)
  (defun begin-operation () (initialize) (store-u32 8 0) 0)
  (defun allocate (size)
    (let* ((cursor (load-u32 0)) (rounded (word-and (+ size 7) 4294967288))
           (end (+ cursor rounded)) (ok 1))
      (if (or (> size 4294967288) (< end cursor)) (fail 2)
        (progn
          (when (> end (* (memory-size) 65536))
            (let ((needed (- (1+ (word-div (1- end) 65536)) (memory-size))))
              (when (= (memory-grow needed) 4294967295) (setq ok 0))))
          (if (= ok 0) (fail 2) (progn (store-u32 0 end) cursor))))))
  (defun object-new (kind count width)
    (let ((result 0) (cursor (load-u32 0)))
      (if (> count (word-div 4294967288 width)) (fail 2)
        (let ((data (allocate (* count width))))
          (when (/= data 0)
            (let ((handle (allocate 32)))
              (when (/= handle 0)
                (store-u32 handle kind) (store-u32 (+ handle 4) (load-u32 4))
                (store-u32 (+ handle 8) (if (= kind 1) 0 count))
                (store-u32 (+ handle 12) count) (store-u32 (+ handle 16) data)
                (store-u32 (+ handle 20) 0)
                (store-u32 (+ handle 24) (load-u32 12)) (store-u32 12 handle)
                (setq result handle)))) 0))
      (when (= result 0) (store-u32 0 cursor))
      result))
  (defun valid (handle kind)
    ;; Membership comes from allocated headers, never a tag found in byte data.
    (let ((current (load-u32 12)))
      (while (and (/= current 0) (/= current handle))
        (setq current (load-u32 (+ current 24))))
      (if (and (/= current 0) (= (load-u32 current) kind)
               (= (load-u32 (+ current 4)) (load-u32 4))) 1 0)))
  (defun checked (handle kind)
    (if (= (valid handle kind) 1) 1 (fail 1)))
  (defun retire ()
    (begin-operation)
    (if (= (load-u32 4) 4294967295) (fail 7)
      (progn (store-u32 4 (1+ (load-u32 4))) (store-u32 12 0) 1)))

  (defun buffer-new (capacity) (begin-operation) (object-new 1 capacity 1))
  (defun buffer-length (handle)
    (begin-operation) (if (= (checked handle 1) 1) (load-u32 (+ handle 8)) 0))
  (defun reserve (handle capacity)
    (let ((old (load-u32 (+ handle 12))) (length (load-u32 (+ handle 8))))
      (if (<= capacity old) 1
        (let ((data (allocate capacity)))
          (if (= data 0) 0
            (let ((i 0) (source (load-u32 (+ handle 16))))
              (while (< i length) (store-u8 (+ data i) (load-u8 (+ source i))) (setq i (1+ i)))
              (store-u32 (+ handle 12) capacity) (store-u32 (+ handle 16) data) 1))))))
  (defun buffer-reserve (handle capacity)
    (begin-operation) (if (= (checked handle 1) 1) (reserve handle capacity) 0))
  (defun buffer-push (handle byte)
    (begin-operation)
    (if (= (checked handle 1) 0) 0
      (if (> byte 255) (fail 3)
        (let ((length (load-u32 (+ handle 8))) (capacity (load-u32 (+ handle 12))) (ok 1))
          (when (= length capacity)
            (setq ok (if (>= capacity 2147483648) (fail 2)
                       (reserve handle (if (= capacity 0) 8 (* capacity 2))))))
          (if (= ok 0) 0
            (progn (store-u8 (+ (load-u32 (+ handle 16)) length) byte)
              (store-u32 (+ handle 8) (1+ length)) 1))))))
  (defun buffer-get (handle index)
    (begin-operation)
    (if (= (checked handle 1) 0) 0
      (if (>= index (load-u32 (+ handle 8))) (fail 3)
        (load-u8 (+ (load-u32 (+ handle 16)) index)))))

  (defun record-new (count) (begin-operation) (object-new 3 count 4))
  (defun record-length (handle)
    (begin-operation) (if (= (checked handle 3) 1) (load-u32 (+ handle 8)) 0))
  (defun record-get (handle index)
    (begin-operation)
    (if (= (checked handle 3) 0) 0
      (if (>= index (load-u32 (+ handle 8))) (fail 3)
        (load-u32 (+ (load-u32 (+ handle 16)) (* index 4))))))
  (defun record-set (handle index value)
    (begin-operation)
    (if (= (checked handle 3) 0) 0
      (if (>= index (load-u32 (+ handle 8))) (fail 3)
        (progn (store-u32 (+ (load-u32 (+ handle 16)) (* index 4)) value) 1))))

  (defun string-new (count) (begin-operation) (object-new 2 count 2))
  (defun string-length (handle)
    (begin-operation) (if (= (checked handle 2) 1) (load-u32 (+ handle 8)) 0))
  (defun string-get (handle index)
    (begin-operation)
    (if (= (checked handle 2) 0) 0
      (if (>= index (load-u32 (+ handle 8))) (fail 3)
        (load-u16 (+ (load-u32 (+ handle 16)) (* index 2))))))
  (defun string-set (handle index value)
    (begin-operation)
    (if (= (checked handle 2) 0) 0
      (if (/= (load-u32 (+ handle 20)) 0) (fail 6)
        (if (or (>= index (load-u32 (+ handle 8))) (> value 65535)) (fail 3)
          (progn (store-u16 (+ (load-u32 (+ handle 16)) (* index 2)) value) 1)))))
  (defun string-seal (handle)
    (begin-operation)
    (if (= (checked handle 2) 0) 0 (progn (store-u32 (+ handle 20) 1) handle)))

  ;; UTF8 routines run entirely inside owned memory. strict=0 replaces errors;
  ;; strict=1 rejects them. Decode strips a leading BOM unless preserve-bom=1.
  (defun push-scalar (output code)
    (let ((ok 1))
      (if (< code 128) (setq ok (buffer-push output code))
        (if (< code 2048)
          (progn (setq ok (buffer-push output (+ 192 (word-shr code 6))))
            (when (= ok 1) (setq ok (buffer-push output (+ 128 (word-and code 63))))) ok)
          (if (< code 65536)
            (progn (setq ok (buffer-push output (+ 224 (word-shr code 12))))
              (when (= ok 1) (setq ok (buffer-push output (+ 128 (word-and (word-shr code 6) 63)))))
              (when (= ok 1) (setq ok (buffer-push output (+ 128 (word-and code 63))))) ok)
            (progn (setq ok (buffer-push output (+ 240 (word-shr code 18))))
              (when (= ok 1) (setq ok (buffer-push output (+ 128 (word-and (word-shr code 12) 63)))))
              (when (= ok 1) (setq ok (buffer-push output (+ 128 (word-and (word-shr code 6) 63)))))
              (when (= ok 1) (setq ok (buffer-push output (+ 128 (word-and code 63))))) ok))))
      ok))
  (defun utf8-encode (input strict)
    (begin-operation)
    (if (= (checked input 2) 0) 0
      (if (> strict 1) (fail 3)
        (if (= (load-u32 (+ input 20)) 0) (fail 6)
          (let ((output (object-new 1 0 1)) (i 0) (ok 1)
                (length (load-u32 (+ input 8))) (data (load-u32 (+ input 16))))
            (when (= output 0) (setq ok 0))
            (while (and (< i length) (= ok 1))
              (let ((code (load-u16 (+ data (* i 2)))) (invalid 0))
                (if (and (>= code 55296) (<= code 56319))
                  (if (< (1+ i) length)
                    (let ((next (load-u16 (+ data (* (1+ i) 2)))))
                      (if (and (>= next 56320) (<= next 57343))
                        (progn (setq code (+ 65536 (+ (* (- code 55296) 1024) (- next 56320))))
                          (setq i (1+ i)) 0)
                        (progn (setq invalid 1) 0)))
                    (progn (setq invalid 1) 0))
                  (progn (when (and (>= code 56320) (<= code 57343)) (setq invalid 1)) 0))
                (when (= invalid 1)
                  (if (= strict 1) (progn (fail 5) (setq ok 0)) (setq code 65533)))
                (when (= ok 1) (setq ok (push-scalar output code))))
              (setq i (1+ i)))
            (if (= ok 1) output 0))))))

  (defun utf8-decode (input strict preserve-bom)
    (begin-operation)
    (if (= (checked input 1) 0) 0
      (if (or (> strict 1) (> preserve-bom 1)) (fail 3)
        (let* ((length (load-u32 (+ input 8))) (data (load-u32 (+ input 16)))
               (output (object-new 2 length 2))
               (target (if (= output 0) 0 (load-u32 (+ output 16))))
               (i 0) (written 0) (first 1) (ok (if (= output 0) 0 1)))
          (while (and (< i length) (= ok 1))
            (let ((byte (load-u8 (+ data i))) (code 0) (needed 0) (seen 0)
                  (lower 128) (upper 191) (invalid 0))
              (setq i (1+ i))
              (if (< byte 128) (setq code byte)
                (if (and (>= byte 194) (<= byte 223))
                  (progn (setq code (word-and byte 31)) (setq needed 1) 0)
                  (if (and (>= byte 224) (<= byte 239))
                    (progn (setq code (word-and byte 15)) (setq needed 2)
                      (when (= byte 224) (setq lower 160))
                      (when (= byte 237) (setq upper 159)) 0)
                    (if (and (>= byte 240) (<= byte 244))
                      (progn (setq code (word-and byte 7)) (setq needed 3)
                        (when (= byte 240) (setq lower 144))
                        (when (= byte 244) (setq upper 143)) 0)
                      (progn (setq invalid 1) 0)))))
              (while (and (< seen needed) (< i length) (= invalid 0))
                (let ((next (load-u8 (+ data i))))
                  (if (or (< next lower) (> next upper)) (setq invalid 1)
                    (progn (setq code (+ (word-shl code 6) (word-and next 63)))
                      (setq i (1+ i)) (setq seen (1+ seen)) (setq lower 128) (setq upper 191)))))
              (when (< seen needed) (setq invalid 1))
              (when (= invalid 1)
                (if (= strict 1) (progn (fail 4) (setq ok 0)) (setq code 65533)))
              (when (and (= ok 1) (not (and (= first 1) (= preserve-bom 0) (= code 65279))))
                (if (< code 65536)
                  (progn (store-u16 (+ target (* written 2)) code) (setq written (1+ written)))
                  (progn (setq code (- code 65536))
                    (store-u16 (+ target (* written 2)) (+ 55296 (word-shr code 10)))
                    (store-u16 (+ target (* (1+ written) 2)) (+ 56320 (word-and code 1023)))
                    (setq written (+ written 2)))))
              (setq first 0)))
          (if (= ok 0) 0
            (progn (store-u32 (+ output 8) written) (store-u32 (+ output 20) 1) output))))))

  (export last-error retire buffer-new buffer-length buffer-reserve buffer-push buffer-get
    record-new record-length record-get record-set string-new string-length string-get string-set string-seal utf8-encode utf8-decode))
