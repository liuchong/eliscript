  ;; Managed value heap. Public values: 0 nil, 1 false, 2 true, 3 undefined.
  ;; Others are 12-bit generation / 20-bit slot IDs scoped to one heap.
  ;; Control record: magic,pool,maxSlots,slots,freeSlots,cursor,freeBlocks,live,maxBytes,work.
  ;; Pool entries: generation,flags,blockOffset,blockSize,roots,next (24 bytes).
  ;; Blocks: kind,length,capacity,sealed, four reserved words, then payload.
  ;; Collection defaults to explicit; opt-in allocation safepoints require root frames.
  (defun heap-control (heap index)
    (load-u32 (+ (load-u32 (+ heap 16)) (* index 4))))
  (defun heap-control-set (heap index value)
    (store-u32 (+ (load-u32 (+ heap 16)) (* index 4)) value))
  (defun heap-base (heap) (load-u32 (+ (heap-control heap 1) 16)))
  (defun heap-entry (heap slot) (+ (heap-base heap) (* slot 24)))
  (defun heap-check (heap)
    (if (and (= (valid heap 3) 1) (= (load-u32 (+ heap 8)) 10)
