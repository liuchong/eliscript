          (let ((next capacity))
            (while (< next end) (setq next (if (> (* next 2) maximum) maximum (* next 2))))
            (if (= (reserve pool next) 0) 0 (progn (store-u32 (+ pool 8) next) 1)))))))
  (defun heap-allocate-block (heap size)
    (let ((current (heap-control heap 6)) (previous 0) (found 0))
      (while (and (/= current 0) (= found 0))
        (let* ((p (+ (heap-base heap) current)) (available (load-u32 p))
               (next (load-u32 (+ p 4))))
