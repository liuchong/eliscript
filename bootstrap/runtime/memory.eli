        (if (> count (word-div 268435416 width)) (fail 2)
          (let* ((entry (heap-entry heap (word-and value 1048575)))
                 (old-offset (load-u32 (+ entry 8))) (old-size (load-u32 (+ entry 12)))
                 (old-p (+ (heap-base heap) old-offset)) (old-count (load-u32 (+ old-p 4))))
            (if (<= count (load-u32 (+ old-p 8)))
              (let ((i (* (if (< count old-count) count old-count) width)))
                (while (< i (* (if (< count old-count) old-count count) width))
                  (store-u8 (+ (+ old-p 32) i) 0) (setq i (1+ i)))
                (store-u32 (+ old-p 4) count) 1)
              (let ((offset (heap-allocate-block heap (word-and (+ 39 (* count width)) 4294967288))))
                (if (= offset 0) 0
                  (let* ((p (+ (heap-base heap) offset)) (actual (load-u32 p)) (i 0))
                    (setq old-p (+ (heap-base heap) old-offset))
                    (while (< i actual) (store-u32 (+ p i) 0) (setq i (+ i 4)))
                    (store-u32 p kind) (store-u32 (+ p 4) count) (store-u32 (+ p 8) count)
                    (setq i 0)
                    (while (< i (* old-count width))
                      (store-u8 (+ (+ p 32) i) (load-u8 (+ (+ old-p 32) i))) (setq i (1+ i)))
                    (setq entry (heap-entry heap (word-and value 1048575)))
                    (store-u32 (+ entry 8) offset) (store-u32 (+ entry 12) actual)
                    (heap-free-block heap old-offset old-size) 1))))))))
  (defun value-refs-resize (heap value count)
    (begin-operation) (if (= (heap-check heap) 0) 0 (heap-value-resize heap value count 7 4)))
  (defun value-bytes-resize (heap value count)
    (begin-operation) (if (= (heap-check heap) 0) 0 (heap-value-resize heap value count 6 1)))
  (defun value-number-negate (heap input)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (if (= (heap-kind-check heap input 4) 0) 0
        (let* ((number (load-f64 (+ (heap-block heap input) 32))) (output (heap-object heap 4 1 8)))
          (when (/= output 0) (store-f64 (+ (heap-block heap output) 32) (- number))) output))))
  (defun value-number-compare (heap left right operation)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (if (or (= (heap-kind-check heap left 4) 0) (= (heap-kind-check heap right 4) 0)) 0
        (if (> operation 5) (fail 3)
          (let ((a (load-f64 (+ (heap-block heap left) 32))) (b (load-f64 (+ (heap-block heap right) 32))))
            (if (if (= operation 0) (= a b) (if (= operation 1) (/= a b)
                  (if (= operation 2) (< a b) (if (= operation 3) (<= a b)
                    (if (= operation 4) (> a b) (>= a b)))))) 1 0))))))
  (defun value-string (heap count)
    (begin-operation) (if (= (heap-check heap) 0) 0 (heap-object heap 5 count 2)))
  (defun value-bytes (heap count)
    (begin-operation) (if (= (heap-check heap) 0) 0 (heap-object heap 6 count 1)))
  (defun value-seal (heap value)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (if (= (heap-kind-check heap value 5) 0) 0
        (progn (store-u32 (+ (heap-block heap value) 12) 1) value))))
  (defun value-unit-get (heap value index)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (if (= (heap-kind-check heap value 5) 0) 0
        (let ((p (heap-block heap value)))
          (if (>= index (load-u32 (+ p 4))) (fail 3) (load-u16 (+ (+ p 32) (* index 2))))))))
  (defun value-unit-set (heap value index unit)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (if (= (heap-kind-check heap value 5) 0) 0
        (let ((p (heap-block heap value)))
          (if (/= (load-u32 (+ p 12)) 0) (fail 6)
            (if (or (>= index (load-u32 (+ p 4))) (> unit 65535)) (fail 3)
              (progn (store-u16 (+ (+ p 32) (* index 2)) unit) 1)))))))
  (defun value-byte-get (heap value index)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (if (= (heap-kind-check heap value 6) 0) 0
        (let ((p (heap-block heap value)))
          (if (>= index (load-u32 (+ p 4))) (fail 3) (load-u8 (+ (+ p 32) index)))))))
  (defun value-byte-set (heap value index byte)
    (begin-operation) (if (= (heap-check heap) 0) 0
      (if (= (heap-kind-check heap value 6) 0) 0
        (let ((p (heap-block heap value)))
          (if (or (>= index (load-u32 (+ p 4))) (> byte 255)) (fail 3)
            (progn (store-u8 (+ (+ p 32) index) byte) 1))))))
  (export last-error retire buffer-new buffer-length buffer-reserve buffer-push buffer-get
    record-new record-length record-get record-set string-new string-length string-get string-set string-seal utf8-encode utf8-decode heap-new heap-capacity heap-used heap-live heap-pin heap-release heap-collect
    value-kind value-truth value-data value-length value-number value-number-binary
    value-refs value-get value-set value-refs-resize value-string value-bytes value-seal
    value-unit-get value-unit-set value-byte-get value-byte-set value-bytes-resize
    value-number-negate value-number-compare))
