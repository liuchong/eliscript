        (progn
          (when (> end (* (memory-size) 65536))
            (let ((needed (- (1+ (word-div (1- end) 65536)) (memory-size))))
              (when (= (memory-grow needed) 4294967295) (setq ok 0))))
          (if (= ok 0) (fail 2) (progn (store-u32 0 end) cursor))))))
