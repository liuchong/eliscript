                  (progn (setq code (- code 65536))
                    (store-u16 (+ target (* written 2)) (+ 55296 (word-shr code 10)))
                    (store-u16 (+ target (* (1+ written) 2)) (+ 56320 (word-and code 1023)))
                    (setq written (+ written 2)))))
