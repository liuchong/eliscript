0073\u0065\u005f\u0049\u0067\u006e\u006f\u0072\u0061\u0062\u006c\u0065\u0005\u0043\u0061\u0073\u0065\u0064\u000c\u0043\u0061\u0073\u0065\u0064\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0002\u0043\u0063\u0002\u0043\u0066\u0017\u0043\u0068\u0061\u006e\u0067\u0065\u0073\u005f\u0057\u0068\u0065\u006e\u005f\u0043\u0061\u0073\u0065\u0066\u006f\u006c\u0064\u0065\u0064\u0017\u0043\u0068\u0061\u006e\u0067\u0065\u0073\u005f\u0057\u0068\u0065\u006e\u005f\u0043\u0061\u0073\u0065\u006d\u0061\u0070\u0070\u0065\u0064\u0017\u0043\u0068\u0061\u006e\u0067\u0065\u0073\u005f\u0057\u0068\u0065\u006e\u005f\u004c\u006f\u0077\u0065\u0072\u0063\u0061\u0073\u0065\u0064\u001c\u0043\u0068\u0061\u006e\u0067\u0065\u0073\u005f\u0057\u0068\u0065\u006e\u005f\u004e\u0046\u004b\u0043\u005f\u0043\u0061\u0073\u0065\u0066\u006f\u006c\u0064\u0065\u0064\u0017\u0043\u0068\u0061\u006e\u0067\u0065\u0073\u005f\u0057\u0068\u0065\u006e\u005f\u0054\u0069\u0074\u006c\u0065\u0063\u0061\u0073\u0065\u0064\u0017\u0043\u0068\u0061\u006e\u0067\u0065\u0073\u005f\u0057\u0068\u0065\u006e\u005f\u0055\u0070\u0070\u0065\u0072\u0063\u0061\u0073\u0065\u0064\u0011\u0043\u006c\u006f\u0073\u0065\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0002\u0043\u006e\u0002\u0043\u006f\u000e\u0043\u006f\u006d\u0062\u0069\u006e\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0015\u0043\u006f\u006e\u006e\u0065\u0063\u0074\u006f\u0072\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0007\u0043\u006f\u006e\u0074\u0072\u006f\u006c\u0002\u0043\u0073\u000f\u0043\u0075\u0072\u0072\u0065\u006e\u0063\u0079\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0002\u0044\u0049\u0004\u0044\u0061\u0073\u0068\u0010\u0044\u0061\u0073\u0068\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u000e\u0044\u0065\u0063\u0069\u006d\u0061\u006c\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u001c\u0044\u0065\u0066\u0061\u0075\u006c\u0074\u005f\u0049\u0067\u006e\u006f\u0072\u0061\u0062\u006c\u0065\u005f\u0043\u006f\u0064\u0065\u005f\u0050\u006f\u0069\u006e\u0074\u0003\u0044\u0065\u0070\u000a\u0044\u0065\u0070\u0072\u0065\u0063\u0061\u0074\u0065\u0064\u0003\u0044\u0069\u0061\u0009\u0044\u0069\u0061\u0063\u0072\u0069\u0074\u0069\u0063\u0005\u0045\u0042\u0061\u0073\u0065\u0005\u0045\u0043\u006f\u006d\u0070\u0004\u0045\u004d\u006f\u0064\u0005\u0045\u0050\u0072\u0065\u0073\u0005\u0045\u006d\u006f\u006a\u0069\u000f\u0045\u006d\u006f\u006a\u0069\u005f\u0043\u006f\u006d\u0070\u006f\u006e\u0065\u006e\u0074\u000e\u0045\u006d\u006f\u006a\u0069\u005f\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u0013\u0045\u006d\u006f\u006a\u0069\u005f\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u005f\u0042\u0061\u0073\u0065\u0012\u0045\u006d\u006f\u006a\u0069\u005f\u0050\u0072\u0065\u0073\u0065\u006e\u0074\u0061\u0074\u0069\u006f\u006e\u000e\u0045\u006e\u0063\u006c\u006f\u0073\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0003\u0045\u0078\u0074\u0007\u0045\u0078\u0074\u0050\u0069\u0063\u0074\u0015\u0045\u0078\u0074\u0065\u006e\u0064\u0065\u0064\u005f\u0050\u0069\u0063\u0074\u006f\u0067\u0072\u0061\u0070\u0068\u0069\u0063\u0008\u0045\u0078\u0074\u0065\u006e\u0064\u0065\u0072\u0011\u0046\u0069\u006e\u0061\u006c\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0006\u0046\u006f\u0072\u006d\u0061\u0074\u0012\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u001d\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u0061\u0073\u0065\u0064\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u0063\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u0066\u0022\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u006c\u006f\u0073\u0065\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u006e\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u006f\u001f\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u006f\u006d\u0062\u0069\u006e\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0026\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u006f\u006e\u006e\u0065\u0063\u0074\u006f\u0072\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0018\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u006f\u006e\u0074\u0072\u006f\u006c\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u0073\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0043\u0075\u0072\u0072\u0065\u006e\u0063\u0079\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0021\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0044\u0061\u0073\u0068\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u001f\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0044\u0065\u0063\u0069\u006d\u0061\u006c\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u001f\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0045\u006e\u0063\u006c\u006f\u0073\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0022\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0046\u0069\u006e\u0061\u006c\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0017\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0046\u006f\u0072\u006d\u0061\u0074\u0024\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0049\u006e\u0069\u0074\u0069\u0061\u006c\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0012\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u0043\u0017\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u0065\u0074\u0074\u0065\u0072\u001e\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u0065\u0074\u0074\u0065\u0072\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u001f\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u0069\u006e\u0065\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u006c\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u006d\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u006f\u0021\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u006f\u0077\u0065\u0072\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u0074\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004c\u0075\u0012\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u0015\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u0061\u0072\u006b\u001c\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u0061\u0074\u0068\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u0063\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u0065\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u006e\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0012\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004e\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004e\u0064\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004e\u006c\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004e\u006f\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004e\u006f\u006e\u0073\u0070\u0061\u0063\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0017\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004e\u0075\u006d\u0062\u0065\u0072\u0021\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004f\u0070\u0065\u006e\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0016\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004f\u0074\u0068\u0065\u0072\u001d\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u001d\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u0022\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u001d\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0012\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0024\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0061\u0072\u0061\u0067\u0072\u0061\u0070\u0068\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0063\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0064\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0065\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0066\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0069\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u006f\u001c\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0072\u0069\u0076\u0061\u0074\u0065\u005f\u0055\u0073\u0065\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0073\u001c\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0012\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u0063\u001a\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u006b\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u006d\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u006f\u0020\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u0070\u0061\u0063\u0065\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u001d\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u0070\u0061\u0063\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u001a\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u0075\u0072\u0072\u006f\u0067\u0061\u0074\u0065\u0017\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0053\u0079\u006d\u0062\u006f\u006c\u0021\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0054\u0069\u0074\u006c\u0065\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u001b\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0055\u006e\u0061\u0073\u0073\u0069\u0067\u006e\u0065\u0064\u0021\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0055\u0070\u0070\u0065\u0072\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0012\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u005a\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u005a\u006c\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u005a\u0070\u0013\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u005a\u0073\u0016\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0063\u006e\u0074\u0072\u006c\u0016\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0064\u0069\u0067\u0069\u0074\u0016\u0047\u0065\u006e\u0065\u0072\u0061\u006c\u005f\u0043\u0061\u0074\u0065\u0067\u006f\u0072\u0079\u003d\u0070\u0075\u006e\u0063\u0074\u0007\u0047\u0072\u005f\u0042\u0061\u0073\u0065\u0006\u0047\u0072\u005f\u0045\u0078\u0074\u000d\u0047\u0072\u0061\u0070\u0068\u0065\u006d\u0065\u005f\u0042\u0061\u0073\u0065\u000f\u0047\u0072\u0061\u0070\u0068\u0065\u006d\u0065\u005f\u0045\u0078\u0074\u0065\u006e\u0064\u0003\u0048\u0065\u0078\u0009\u0048\u0065\u0078\u005f\u0044\u0069\u0067\u0069\u0074\u0003\u0049\u0044\u0043\u0003\u0049\u0044\u0053\u0004\u0049\u0044\u0053\u0042\u0004\u0049\u0044\u0053\u0054\u0013\u0049\u0044\u0053\u005f\u0042\u0069\u006e\u0061\u0072\u0079\u005f\u004f\u0070\u0065\u0072\u0061\u0074\u006f\u0072\u0014\u0049\u0044\u0053\u005f\u0054\u0072\u0069\u006e\u0061\u0072\u0079\u005f\u004f\u0070\u0065\u0072\u0061\u0074\u006f\u0072\u000b\u0049\u0044\u005f\u0043\u006f\u006e\u0074\u0069\u006e\u0075\u0065\u0008\u0049\u0044\u005f\u0053\u0074\u0061\u0072\u0074\u0004\u0049\u0064\u0065\u006f\u000b\u0049\u0064\u0065\u006f\u0067\u0072\u0061\u0070\u0068\u0069\u0063\u0013\u0049\u006e\u0069\u0074\u0069\u0061\u006c\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0006\u004a\u006f\u0069\u006e\u005f\u0043\u000c\u004a\u006f\u0069\u006e\u005f\u0043\u006f\u006e\u0074\u0072\u006f\u006c\u0001\u004c\u0002\u004c\u0043\u0003\u004c\u004f\u0045\u0006\u004c\u0065\u0074\u0074\u0065\u0072\u000d\u004c\u0065\u0074\u0074\u0065\u0072\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u000e\u004c\u0069\u006e\u0065\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0002\u004c\u006c\u0002\u004c\u006d\u0002\u004c\u006f\u0017\u004c\u006f\u0067\u0069\u0063\u0061\u006c\u005f\u004f\u0072\u0064\u0065\u0072\u005f\u0045\u0078\u0063\u0065\u0070\u0074\u0069\u006f\u006e\u0005\u004c\u006f\u0077\u0065\u0072\u0009\u004c\u006f\u0077\u0065\u0072\u0063\u0061\u0073\u0065\u0010\u004c\u006f\u0077\u0065\u0072\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0002\u004c\u0074\u0002\u004c\u0075\u0001\u004d\u0004\u004d\u0061\u0072\u006b\u0004\u004d\u0061\u0074\u0068\u000b\u004d\u0061\u0074\u0068\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0002\u004d\u0063\u0002\u004d\u0065\u0002\u004d\u006e\u000f\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u000f\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0001\u004e\u0005\u004e\u0043\u0068\u0061\u0072\u0002\u004e\u0064\u0002\u004e\u006c\u0002\u004e\u006f\u0017\u004e\u006f\u006e\u0063\u0068\u0061\u0072\u0061\u0063\u0074\u0065\u0072\u005f\u0043\u006f\u0064\u0065\u005f\u0050\u006f\u0069\u006e\u0074\u000f\u004e\u006f\u006e\u0073\u0070\u0061\u0063\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0006\u004e\u0075\u006d\u0062\u0065\u0072\u0010\u004f\u0070\u0065\u006e\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0005\u004f\u0074\u0068\u0065\u0072\u000c\u004f\u0074\u0068\u0065\u0072\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u000c\u004f\u0074\u0068\u0065\u0072\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u0011\u004f\u0074\u0068\u0065\u0072\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u000c\u004f\u0074\u0068\u0065\u0072\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0001\u0050\u0013\u0050\u0061\u0072\u0061\u0067\u0072\u0061\u0070\u0068\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0007\u0050\u0061\u0074\u005f\u0053\u0079\u006e\u0006\u0050\u0061\u0074\u005f\u0057\u0053\u000e\u0050\u0061\u0074\u0074\u0065\u0072\u006e\u005f\u0053\u0079\u006e\u0074\u0061\u0078\u0013\u0050\u0061\u0074\u0074\u0065\u0072\u006e\u005f\u0057\u0068\u0069\u0074\u0065\u005f\u0053\u0070\u0061\u0063\u0065\u0002\u0050\u0063\u0002\u0050\u0064\u0002\u0050\u0065\u0002\u0050\u0066\u0002\u0050\u0069\u0002\u0050\u006f\u000b\u0050\u0072\u0069\u0076\u0061\u0074\u0065\u005f\u0055\u0073\u0065\u0002\u0050\u0073\u000b\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0005\u0051\u004d\u0061\u0072\u006b\u000e\u0051\u0075\u006f\u0074\u0061\u0074\u0069\u006f\u006e\u005f\u004d\u0061\u0072\u006b\u0002\u0052\u0049\u0007\u0052\u0061\u0064\u0069\u0063\u0061\u006c\u0012\u0052\u0065\u0067\u0069\u006f\u006e\u0061\u006c\u005f\u0049\u006e\u0064\u0069\u0063\u0061\u0074\u006f\u0072\u0001\u0053\u0002\u0053\u0044\u0005\u0053\u0054\u0065\u0072\u006d\u0002\u0053\u0063\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0064\u006c\u0061\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0064\u006c\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0067\u0068\u0062\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0068\u006f\u006d\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u006e\u0061\u0074\u006f\u006c\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0072\u0061\u0062\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0072\u0061\u0062\u0069\u0063\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0072\u006d\u0065\u006e\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0072\u006d\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0072\u006d\u006e\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0076\u0065\u0073\u0074\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0041\u0076\u0073\u0074\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u006c\u0069\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u006c\u0069\u006e\u0065\u0073\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u006d\u0075\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u006d\u0075\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u0073\u0073\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u0073\u0073\u0061\u005f\u0056\u0061\u0068\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u0074\u0061\u006b\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0061\u0074\u006b\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0065\u006e\u0067\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0065\u006e\u0067\u0061\u006c\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0065\u0072\u0066\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0065\u0072\u0069\u0061\u005f\u0045\u0072\u0066\u0065\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0068\u0061\u0069\u006b\u0073\u0075\u006b\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0068\u006b\u0073\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u006f\u0070\u006f\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u006f\u0070\u006f\u006d\u006f\u0066\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0072\u0061\u0068\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0072\u0061\u0068\u006d\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0072\u0061\u0069\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0072\u0061\u0069\u006c\u006c\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0075\u0067\u0069\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0075\u0067\u0069\u006e\u0065\u0073\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0075\u0068\u0064\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0042\u0075\u0068\u0069\u0064\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0061\u006b\u006d\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0061\u006e\u0061\u0064\u0069\u0061\u006e\u005f\u0041\u0062\u006f\u0072\u0069\u0067\u0069\u006e\u0061\u006c\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0061\u006e\u0073\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0061\u0072\u0069\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0061\u0072\u0069\u0061\u006e\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0061\u0075\u0063\u0061\u0073\u0069\u0061\u006e\u005f\u0041\u006c\u0062\u0061\u006e\u0069\u0061\u006e\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0068\u0061\u006b\u006d\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0068\u0061\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0068\u0065\u0072\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0068\u0065\u0072\u006f\u006b\u0065\u0065\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0068\u006f\u0072\u0061\u0073\u006d\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0068\u0072\u0073\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u006f\u006d\u006d\u006f\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u006f\u0070\u0074\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u006f\u0070\u0074\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0070\u006d\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0070\u0072\u0074\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0075\u006e\u0065\u0069\u0066\u006f\u0072\u006d\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0079\u0070\u0072\u0069\u006f\u0074\u0013\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0079\u0070\u0072\u006f\u005f\u004d\u0069\u006e\u006f\u0061\u006e\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0079\u0072\u0069\u006c\u006c\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0043\u0079\u0072\u006c\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0065\u0073\u0065\u0072\u0065\u0074\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0065\u0076\u0061\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0065\u0076\u0061\u006e\u0061\u0067\u0061\u0072\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0069\u0061\u006b\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0069\u0076\u0065\u0073\u005f\u0041\u006b\u0075\u0072\u0075\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u006f\u0067\u0072\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u006f\u0067\u0072\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0073\u0072\u0074\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0075\u0070\u006c\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0044\u0075\u0070\u006c\u006f\u0079\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u0067\u0079\u0070\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u0067\u0079\u0070\u0074\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u006c\u0062\u0061\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u006c\u0062\u0061\u0073\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u006c\u0079\u006d\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u006c\u0079\u006d\u0061\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u0074\u0068\u0069\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0045\u0074\u0068\u0069\u006f\u0070\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0061\u0072\u0061\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0061\u0072\u0061\u0079\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0065\u006f\u0072\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0065\u006f\u0072\u0067\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u006c\u0061\u0067\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u006c\u0061\u0067\u006f\u006c\u0069\u0074\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u006f\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u006f\u006e\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u006f\u0074\u0068\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u006f\u0074\u0068\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0072\u0061\u006e\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0072\u0061\u006e\u0074\u0068\u0061\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0072\u0065\u0065\u006b\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0072\u0065\u006b\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0075\u006a\u0061\u0072\u0061\u0074\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0075\u006a\u0072\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0075\u006b\u0068\u0014\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0075\u006e\u006a\u0061\u006c\u0061\u005f\u0047\u006f\u006e\u0064\u0069\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0075\u0072\u006d\u0075\u006b\u0068\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0075\u0072\u0075\u0013\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0047\u0075\u0072\u0075\u006e\u0067\u005f\u004b\u0068\u0065\u006d\u0061\u000a\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u006e\u0067\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u006e\u0067\u0075\u006c\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u006e\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u006e\u0069\u0066\u0069\u005f\u0052\u006f\u0068\u0069\u006e\u0067\u0079\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u006e\u006f\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u006e\u0075\u006e\u006f\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u0074\u0072\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0061\u0074\u0072\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0065\u0062\u0072\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0065\u0062\u0072\u0065\u0077\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0069\u0072\u0061\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0069\u0072\u0061\u0067\u0061\u006e\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u006c\u0075\u0077\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u006d\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u006d\u006e\u0070\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0048\u0075\u006e\u0067\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0049\u006d\u0070\u0065\u0072\u0069\u0061\u006c\u005f\u0041\u0072\u0061\u006d\u0061\u0069\u0063\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0049\u006e\u0068\u0065\u0072\u0069\u0074\u0065\u0064\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0072\u0074\u0068\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0049\u0074\u0061\u006c\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004a\u0061\u0076\u0061\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004a\u0061\u0076\u0061\u006e\u0065\u0073\u0065\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0061\u0069\u0074\u0068\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0061\u006c\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0061\u006e\u0061\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0061\u006e\u006e\u0061\u0064\u0061\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0061\u0074\u0061\u006b\u0061\u006e\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0061\u0077\u0069\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0061\u0079\u0061\u0068\u005f\u004c\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u0061\u0072\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u0061\u0072\u006f\u0073\u0068\u0074\u0068\u0069\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u0069\u0074\u0061\u006e\u005f\u0053\u006d\u0061\u006c\u006c\u005f\u0053\u0063\u0072\u0069\u0070\u0074\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u006d\u0065\u0072\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u006d\u0072\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u006f\u006a\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u006f\u006a\u006b\u0069\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0068\u0075\u0064\u0061\u0077\u0061\u0064\u0069\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0069\u0072\u0061\u0074\u005f\u0052\u0061\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0069\u0074\u0073\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u006e\u0064\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0072\u0061\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004b\u0074\u0068\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0061\u006e\u0061\u000a\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0061\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0061\u006f\u006f\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0061\u0074\u0069\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0061\u0074\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0065\u0070\u0063\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0065\u0070\u0063\u0068\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0069\u006d\u0062\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0069\u006d\u0062\u0075\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0069\u006e\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0069\u006e\u0062\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0041\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0042\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0069\u0073\u0075\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0079\u0063\u0069\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0079\u0063\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0079\u0064\u0069\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004c\u0079\u0064\u0069\u0061\u006e\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u0068\u0061\u006a\u0061\u006e\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u0068\u006a\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u006b\u0061\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u006b\u0061\u0073\u0061\u0072\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u006c\u0061\u0079\u0061\u006c\u0061\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u006e\u0064\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u006e\u0064\u0061\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u006e\u0069\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u006e\u0069\u0063\u0068\u0061\u0065\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u0072\u0063\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u0072\u0063\u0068\u0065\u006e\u0014\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0061\u0073\u0061\u0072\u0061\u006d\u005f\u0047\u006f\u006e\u0064\u0069\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u0064\u0065\u0066\u0061\u0069\u0064\u0072\u0069\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u0064\u0066\u0013\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u0065\u0074\u0065\u0069\u005f\u004d\u0061\u0079\u0065\u006b\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u006e\u0064\u0014\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u006e\u0064\u0065\u005f\u004b\u0069\u006b\u0061\u006b\u0075\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u0072\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u0072\u006f\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0043\u0075\u0072\u0073\u0069\u0076\u0065\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0069\u0061\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u006c\u0079\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u006f\u0064\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u006f\u006e\u0067\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u006f\u006e\u0067\u006f\u006c\u0069\u0061\u006e\u000a\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0072\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0072\u006f\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0074\u0065\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0075\u006c\u0074\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0075\u006c\u0074\u0061\u006e\u0069\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0079\u0061\u006e\u006d\u0061\u0072\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004d\u0079\u006d\u0072\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0061\u0062\u0061\u0074\u0061\u0065\u0061\u006e\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0061\u0067\u005f\u004d\u0075\u006e\u0064\u0061\u0072\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0061\u0067\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0061\u006e\u0064\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0061\u006e\u0064\u0069\u006e\u0061\u0067\u0061\u0072\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0061\u0072\u0062\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0062\u0061\u0074\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0065\u0077\u005f\u0054\u0061\u0069\u005f\u004c\u0075\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0065\u0077\u0061\u000a\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u006b\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u006b\u006f\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0073\u0068\u0075\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0075\u0073\u0068\u0075\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004e\u0079\u0069\u0061\u006b\u0065\u006e\u0067\u005f\u0050\u0075\u0061\u0063\u0068\u0075\u0065\u005f\u0048\u006d\u006f\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0067\u0061\u006d\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0067\u0068\u0061\u006d\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u005f\u0043\u0068\u0069\u006b\u0069\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u005f\u004f\u006e\u0061\u006c\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0063\u006b\u0014\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0048\u0075\u006e\u0067\u0061\u0072\u0069\u0061\u006e\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0049\u0074\u0061\u006c\u0069\u0063\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u004e\u006f\u0072\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u006d\u0069\u0063\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u0073\u0069\u0061\u006e\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0067\u0064\u0069\u0061\u006e\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0075\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0054\u0075\u0072\u006b\u0069\u0063\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006c\u0064\u005f\u0055\u0079\u0067\u0068\u0075\u0072\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u006e\u0061\u006f\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0072\u0069\u0079\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0072\u006b\u0068\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0072\u0079\u0061\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0073\u0061\u0067\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0073\u0067\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0073\u006d\u0061\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0073\u006d\u0061\u006e\u0079\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u004f\u0075\u0067\u0072\u0013\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0061\u0068\u0061\u0077\u0068\u005f\u0048\u006d\u006f\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0061\u006c\u006d\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0061\u006c\u006d\u0079\u0072\u0065\u006e\u0065\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0061\u0075\u005f\u0043\u0069\u006e\u005f\u0048\u0061\u0075\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0061\u0075\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0065\u0072\u006d\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0068\u0061\u0067\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0068\u0061\u0067\u0073\u005f\u0050\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0068\u006c\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0068\u006c\u0070\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0068\u006e\u0078\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0068\u006f\u0065\u006e\u0069\u0063\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u006c\u0072\u0064\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0072\u0074\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0050\u0073\u0061\u006c\u0074\u0065\u0072\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0051\u0061\u0061\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0051\u0061\u0061\u0069\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0052\u0065\u006a\u0061\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0052\u006a\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0052\u006f\u0068\u0067\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0052\u0075\u006e\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0052\u0075\u006e\u0072\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0061\u006d\u0061\u0072\u0069\u0074\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0061\u006d\u0072\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0061\u0072\u0062\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0061\u0075\u0072\u0011\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0061\u0075\u0072\u0061\u0073\u0068\u0074\u0072\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0067\u006e\u0077\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0068\u0061\u0072\u0061\u0064\u0061\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0068\u0061\u0076\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0068\u0061\u0077\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0068\u0072\u0064\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u0064\u0064\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u0064\u0064\u0068\u0061\u006d\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u0064\u0065\u0074\u0069\u0063\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u0064\u0074\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u0067\u006e\u0057\u0072\u0069\u0074\u0069\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u006e\u0064\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u006e\u0068\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0069\u006e\u0068\u0061\u006c\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u006f\u0067\u0064\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u006f\u0067\u0064\u0069\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u006f\u0067\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u006f\u0072\u0061\u0013\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u006f\u0072\u0061\u005f\u0053\u006f\u006d\u0070\u0065\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u006f\u0079\u006f\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u006f\u0079\u006f\u006d\u0062\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0075\u006e\u0064\u0010\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0075\u006e\u0064\u0061\u006e\u0065\u0073\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0075\u006e\u0075\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0075\u006e\u0075\u0077\u0061\u0072\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0079\u006c\u006f\u0013\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0079\u006c\u006f\u0074\u0069\u005f\u004e\u0061\u0067\u0072\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0079\u0072\u0063\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0053\u0079\u0072\u0069\u0061\u0063\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0067\u0061\u006c\u006f\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0067\u0062\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0067\u0062\u0061\u006e\u0077\u0061\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0069\u005f\u004c\u0065\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0069\u005f\u0054\u0068\u0061\u006d\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0069\u005f\u0056\u0069\u0065\u0074\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0069\u005f\u0059\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006b\u0072\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006b\u0072\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006c\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006c\u0075\u000c\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006d\u0069\u006c\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006d\u006c\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006e\u0067\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006e\u0067\u0073\u0061\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u006e\u0067\u0075\u0074\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0076\u0074\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0061\u0079\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0065\u006c\u0075\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0065\u006c\u0075\u0067\u0075\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0066\u006e\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0067\u006c\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0068\u0061\u0061\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0068\u0061\u0061\u006e\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0068\u0061\u0069\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0069\u0062\u0065\u0074\u0061\u006e\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0069\u0062\u0074\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0069\u0066\u0069\u006e\u0061\u0067\u0068\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0069\u0072\u0068\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0069\u0072\u0068\u0075\u0074\u0061\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u006e\u0073\u0061\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u006f\u0064\u0068\u0072\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u006f\u0064\u0072\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u006f\u006c\u006f\u006e\u0067\u005f\u0053\u0069\u006b\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u006f\u006c\u0073\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u006f\u0074\u006f\u0014\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0075\u006c\u0075\u005f\u0054\u0069\u0067\u0061\u006c\u0061\u0072\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0054\u0075\u0074\u0067\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0055\u0067\u0061\u0072\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0055\u0067\u0061\u0072\u0069\u0074\u0069\u0063\u000e\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0055\u006e\u006b\u006e\u006f\u0077\u006e\u000a\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0056\u0061\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0056\u0061\u0069\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0056\u0069\u0074\u0068\u000f\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0056\u0069\u0074\u0068\u006b\u0075\u0071\u0069\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0057\u0061\u006e\u0063\u0068\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0057\u0061\u0072\u0061\u0012\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0057\u0061\u0072\u0061\u006e\u0067\u005f\u0043\u0069\u0074\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0057\u0063\u0068\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0058\u0070\u0065\u006f\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0058\u0073\u0075\u0078\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0059\u0065\u007a\u0069\u000d\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0059\u0065\u007a\u0069\u0064\u0069\u0009\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0059\u0069\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u0059\u0069\u0069\u0069\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u005a\u0061\u006e\u0061\u0062\u0061\u007a\u0061\u0072\u005f\u0053\u0071\u0075\u0061\u0072\u0065\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u005a\u0061\u006e\u0062\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u005a\u0069\u006e\u0068\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u005a\u0079\u0079\u0079\u000b\u0053\u0063\u0072\u0069\u0070\u0074\u003d\u005a\u007a\u007a\u007a\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0064\u006c\u0061\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0064\u006c\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0067\u0068\u0062\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0068\u006f\u006d\u0027\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u006e\u0061\u0074\u006f\u006c\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0072\u0061\u0062\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0072\u0061\u0062\u0069\u0063\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0072\u006d\u0065\u006e\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0072\u006d\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0072\u006d\u006e\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0076\u0065\u0073\u0074\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0041\u0076\u0073\u0074\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u006c\u0069\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u006c\u0069\u006e\u0065\u0073\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u006d\u0075\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u006d\u0075\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u0073\u0073\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u0073\u0073\u0061\u005f\u0056\u0061\u0068\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u0074\u0061\u006b\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0061\u0074\u006b\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0065\u006e\u0067\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0065\u006e\u0067\u0061\u006c\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0065\u0072\u0066\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0065\u0072\u0069\u0061\u005f\u0045\u0072\u0066\u0065\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0068\u0061\u0069\u006b\u0073\u0075\u006b\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0068\u006b\u0073\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u006f\u0070\u006f\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u006f\u0070\u006f\u006d\u006f\u0066\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0072\u0061\u0068\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0072\u0061\u0068\u006d\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0072\u0061\u0069\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0072\u0061\u0069\u006c\u006c\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0075\u0067\u0069\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0075\u0067\u0069\u006e\u0065\u0073\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0075\u0068\u0064\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0042\u0075\u0068\u0069\u0064\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0061\u006b\u006d\u0025\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0061\u006e\u0061\u0064\u0069\u0061\u006e\u005f\u0041\u0062\u006f\u0072\u0069\u0067\u0069\u006e\u0061\u006c\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0061\u006e\u0073\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0061\u0072\u0069\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0061\u0072\u0069\u0061\u006e\u0024\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0061\u0075\u0063\u0061\u0073\u0069\u0061\u006e\u005f\u0041\u006c\u0062\u0061\u006e\u0069\u0061\u006e\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0068\u0061\u006b\u006d\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0068\u0061\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0068\u0065\u0072\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0068\u0065\u0072\u006f\u006b\u0065\u0065\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0068\u006f\u0072\u0061\u0073\u006d\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0068\u0072\u0073\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u006f\u006d\u006d\u006f\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u006f\u0070\u0074\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u006f\u0070\u0074\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0070\u006d\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0070\u0072\u0074\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0075\u006e\u0065\u0069\u0066\u006f\u0072\u006d\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0079\u0070\u0072\u0069\u006f\u0074\u001e\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0079\u0070\u0072\u006f\u005f\u004d\u0069\u006e\u006f\u0061\u006e\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0079\u0072\u0069\u006c\u006c\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0043\u0079\u0072\u006c\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0065\u0073\u0065\u0072\u0065\u0074\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0065\u0076\u0061\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0065\u0076\u0061\u006e\u0061\u0067\u0061\u0072\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0069\u0061\u006b\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0069\u0076\u0065\u0073\u005f\u0041\u006b\u0075\u0072\u0075\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u006f\u0067\u0072\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u006f\u0067\u0072\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0073\u0072\u0074\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0075\u0070\u006c\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0044\u0075\u0070\u006c\u006f\u0079\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u0067\u0079\u0070\u0026\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u0067\u0079\u0070\u0074\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u006c\u0062\u0061\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u006c\u0062\u0061\u0073\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u006c\u0079\u006d\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u006c\u0079\u006d\u0061\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u0074\u0068\u0069\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0045\u0074\u0068\u0069\u006f\u0070\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0061\u0072\u0061\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0061\u0072\u0061\u0079\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0065\u006f\u0072\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0065\u006f\u0072\u0067\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u006c\u0061\u0067\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u006c\u0061\u0067\u006f\u006c\u0069\u0074\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u006f\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u006f\u006e\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u006f\u0074\u0068\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u006f\u0074\u0068\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0072\u0061\u006e\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0072\u0061\u006e\u0074\u0068\u0061\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0072\u0065\u0065\u006b\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0072\u0065\u006b\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0075\u006a\u0061\u0072\u0061\u0074\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0075\u006a\u0072\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0075\u006b\u0068\u001f\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0075\u006e\u006a\u0061\u006c\u0061\u005f\u0047\u006f\u006e\u0064\u0069\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0075\u0072\u006d\u0075\u006b\u0068\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0075\u0072\u0075\u001e\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0047\u0075\u0072\u0075\u006e\u0067\u005f\u004b\u0068\u0065\u006d\u0061\u0015\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u006e\u0067\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u006e\u0067\u0075\u006c\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u006e\u0069\u0021\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u006e\u0069\u0066\u0069\u005f\u0052\u006f\u0068\u0069\u006e\u0067\u0079\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u006e\u006f\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u006e\u0075\u006e\u006f\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u0074\u0072\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0061\u0074\u0072\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0065\u0062\u0072\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0065\u0062\u0072\u0065\u0077\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0069\u0072\u0061\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0069\u0072\u0061\u0067\u0061\u006e\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u006c\u0075\u0077\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u006d\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u006d\u006e\u0070\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0048\u0075\u006e\u0067\u0022\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0049\u006d\u0070\u0065\u0072\u0069\u0061\u006c\u005f\u0041\u0072\u0061\u006d\u0061\u0069\u0063\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0049\u006e\u0068\u0065\u0072\u0069\u0074\u0065\u0064\u0027\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u0028\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0072\u0074\u0068\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0049\u0074\u0061\u006c\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004a\u0061\u0076\u0061\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004a\u0061\u0076\u0061\u006e\u0065\u0073\u0065\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0061\u0069\u0074\u0068\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0061\u006c\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0061\u006e\u0061\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0061\u006e\u006e\u0061\u0064\u0061\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0061\u0074\u0061\u006b\u0061\u006e\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0061\u0077\u0069\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0061\u0079\u0061\u0068\u005f\u004c\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u0061\u0072\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u0061\u0072\u006f\u0073\u0068\u0074\u0068\u0069\u0025\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u0069\u0074\u0061\u006e\u005f\u0053\u006d\u0061\u006c\u006c\u005f\u0053\u0063\u0072\u0069\u0070\u0074\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u006d\u0065\u0072\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u006d\u0072\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u006f\u006a\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u006f\u006a\u006b\u0069\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0068\u0075\u0064\u0061\u0077\u0061\u0064\u0069\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0069\u0072\u0061\u0074\u005f\u0052\u0061\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0069\u0074\u0073\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u006e\u0064\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0072\u0061\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004b\u0074\u0068\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0061\u006e\u0061\u0015\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0061\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0061\u006f\u006f\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0061\u0074\u0069\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0061\u0074\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0065\u0070\u0063\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0065\u0070\u0063\u0068\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0069\u006d\u0062\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0069\u006d\u0062\u0075\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0069\u006e\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0069\u006e\u0062\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0041\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0042\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0069\u0073\u0075\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0079\u0063\u0069\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0079\u0063\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0079\u0064\u0069\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004c\u0079\u0064\u0069\u0061\u006e\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u0068\u0061\u006a\u0061\u006e\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u0068\u006a\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u006b\u0061\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u006b\u0061\u0073\u0061\u0072\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u006c\u0061\u0079\u0061\u006c\u0061\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u006e\u0064\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u006e\u0064\u0061\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u006e\u0069\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u006e\u0069\u0063\u0068\u0061\u0065\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u0072\u0063\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u0072\u0063\u0068\u0065\u006e\u001f\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0061\u0073\u0061\u0072\u0061\u006d\u005f\u0047\u006f\u006e\u0064\u0069\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u0064\u0065\u0066\u0061\u0069\u0064\u0072\u0069\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u0064\u0066\u001e\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u0065\u0074\u0065\u0069\u005f\u004d\u0061\u0079\u0065\u006b\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u006e\u0064\u001f\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u006e\u0064\u0065\u005f\u004b\u0069\u006b\u0061\u006b\u0075\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u0072\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u0072\u006f\u0022\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0043\u0075\u0072\u0073\u0069\u0076\u0065\u0026\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0069\u0061\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u006c\u0079\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u006f\u0064\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u006f\u006e\u0067\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u006f\u006e\u0067\u006f\u006c\u0069\u0061\u006e\u0015\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0072\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0072\u006f\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0074\u0065\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0075\u006c\u0074\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0075\u006c\u0074\u0061\u006e\u0069\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0079\u0061\u006e\u006d\u0061\u0072\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004d\u0079\u006d\u0072\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0061\u0062\u0061\u0074\u0061\u0065\u0061\u006e\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0061\u0067\u005f\u004d\u0075\u006e\u0064\u0061\u0072\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0061\u0067\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0061\u006e\u0064\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0061\u006e\u0064\u0069\u006e\u0061\u0067\u0061\u0072\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0061\u0072\u0062\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0062\u0061\u0074\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0065\u0077\u005f\u0054\u0061\u0069\u005f\u004c\u0075\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0065\u0077\u0061\u0015\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u006b\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u006b\u006f\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0073\u0068\u0075\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0075\u0073\u0068\u0075\u0028\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004e\u0079\u0069\u0061\u006b\u0065\u006e\u0067\u005f\u0050\u0075\u0061\u0063\u0068\u0075\u0065\u005f\u0048\u006d\u006f\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0067\u0061\u006d\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0067\u0068\u0061\u006d\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u005f\u0043\u0068\u0069\u006b\u0069\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u005f\u004f\u006e\u0061\u006c\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0063\u006b\u001f\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0048\u0075\u006e\u0067\u0061\u0072\u0069\u0061\u006e\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0049\u0074\u0061\u006c\u0069\u0063\u0023\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u004e\u006f\u0072\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u006d\u0069\u0063\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u0073\u0069\u0061\u006e\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0067\u0064\u0069\u0061\u006e\u0023\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0075\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0054\u0075\u0072\u006b\u0069\u0063\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006c\u0064\u005f\u0055\u0079\u0067\u0068\u0075\u0072\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u006e\u0061\u006f\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0072\u0069\u0079\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0072\u006b\u0068\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0072\u0079\u0061\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0073\u0061\u0067\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0073\u0067\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0073\u006d\u0061\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0073\u006d\u0061\u006e\u0079\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u004f\u0075\u0067\u0072\u001e\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0061\u0068\u0061\u0077\u0068\u005f\u0048\u006d\u006f\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0061\u006c\u006d\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0061\u006c\u006d\u0079\u0072\u0065\u006e\u0065\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0061\u0075\u005f\u0043\u0069\u006e\u005f\u0048\u0061\u0075\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0061\u0075\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0065\u0072\u006d\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0068\u0061\u0067\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0068\u0061\u0067\u0073\u005f\u0050\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0068\u006c\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0068\u006c\u0070\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0068\u006e\u0078\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0068\u006f\u0065\u006e\u0069\u0063\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u006c\u0072\u0064\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0072\u0074\u0069\u0021\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0050\u0073\u0061\u006c\u0074\u0065\u0072\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0051\u0061\u0061\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0051\u0061\u0061\u0069\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0052\u0065\u006a\u0061\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0052\u006a\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0052\u006f\u0068\u0067\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0052\u0075\u006e\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0052\u0075\u006e\u0072\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0061\u006d\u0061\u0072\u0069\u0074\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0061\u006d\u0072\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0061\u0072\u0062\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0061\u0075\u0072\u001c\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0061\u0075\u0072\u0061\u0073\u0068\u0074\u0072\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0067\u006e\u0077\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0068\u0061\u0072\u0061\u0064\u0061\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0068\u0061\u0076\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0068\u0061\u0077\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0068\u0072\u0064\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u0064\u0064\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u0064\u0064\u0068\u0061\u006d\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u0064\u0065\u0074\u0069\u0063\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u0064\u0074\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u0067\u006e\u0057\u0072\u0069\u0074\u0069\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u006e\u0064\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u006e\u0068\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0069\u006e\u0068\u0061\u006c\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u006f\u0067\u0064\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u006f\u0067\u0064\u0069\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u006f\u0067\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u006f\u0072\u0061\u001e\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u006f\u0072\u0061\u005f\u0053\u006f\u006d\u0070\u0065\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u006f\u0079\u006f\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u006f\u0079\u006f\u006d\u0062\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0075\u006e\u0064\u001b\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0075\u006e\u0064\u0061\u006e\u0065\u0073\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0075\u006e\u0075\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0075\u006e\u0075\u0077\u0061\u0072\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0079\u006c\u006f\u001e\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0079\u006c\u006f\u0074\u0069\u005f\u004e\u0061\u0067\u0072\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0079\u0072\u0063\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0053\u0079\u0072\u0069\u0061\u0063\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0067\u0061\u006c\u006f\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0067\u0062\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0067\u0062\u0061\u006e\u0077\u0061\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0069\u005f\u004c\u0065\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0069\u005f\u0054\u0068\u0061\u006d\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0069\u005f\u0056\u0069\u0065\u0074\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0069\u005f\u0059\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006b\u0072\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006b\u0072\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006c\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006c\u0075\u0017\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006d\u0069\u006c\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006d\u006c\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006e\u0067\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006e\u0067\u0073\u0061\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u006e\u0067\u0075\u0074\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0076\u0074\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0061\u0079\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0065\u006c\u0075\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0065\u006c\u0075\u0067\u0075\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0066\u006e\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0067\u006c\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0068\u0061\u0061\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0068\u0061\u0061\u006e\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0068\u0061\u0069\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0069\u0062\u0065\u0074\u0061\u006e\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0069\u0062\u0074\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0069\u0066\u0069\u006e\u0061\u0067\u0068\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0069\u0072\u0068\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0069\u0072\u0068\u0075\u0074\u0061\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u006e\u0073\u0061\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u006f\u0064\u0068\u0072\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u006f\u0064\u0072\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u006f\u006c\u006f\u006e\u0067\u005f\u0053\u0069\u006b\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u006f\u006c\u0073\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u006f\u0074\u006f\u001f\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0075\u006c\u0075\u005f\u0054\u0069\u0067\u0061\u006c\u0061\u0072\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0054\u0075\u0074\u0067\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0055\u0067\u0061\u0072\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0055\u0067\u0061\u0072\u0069\u0074\u0069\u0063\u0019\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0055\u006e\u006b\u006e\u006f\u0077\u006e\u0015\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0056\u0061\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0056\u0061\u0069\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0056\u0069\u0074\u0068\u001a\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0056\u0069\u0074\u0068\u006b\u0075\u0071\u0069\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0057\u0061\u006e\u0063\u0068\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0057\u0061\u0072\u0061\u001d\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0057\u0061\u0072\u0061\u006e\u0067\u005f\u0043\u0069\u0074\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0057\u0063\u0068\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0058\u0070\u0065\u006f\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0058\u0073\u0075\u0078\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0059\u0065\u007a\u0069\u0018\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0059\u0065\u007a\u0069\u0064\u0069\u0014\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0059\u0069\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u0059\u0069\u0069\u0069\u0022\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u005a\u0061\u006e\u0061\u0062\u0061\u007a\u0061\u0072\u005f\u0053\u0071\u0075\u0061\u0072\u0065\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u005a\u0061\u006e\u0062\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u005a\u0069\u006e\u0068\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u005a\u0079\u0079\u0079\u0016\u0053\u0063\u0072\u0069\u0070\u0074\u005f\u0045\u0078\u0074\u0065\u006e\u0073\u0069\u006f\u006e\u0073\u003d\u005a\u007a\u007a\u007a\u0011\u0053\u0065\u006e\u0074\u0065\u006e\u0063\u0065\u005f\u0054\u0065\u0072\u006d\u0069\u006e\u0061\u006c\u0009\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0002\u0053\u006b\u0002\u0053\u006d\u0002\u0053\u006f\u000b\u0053\u006f\u0066\u0074\u005f\u0044\u006f\u0074\u0074\u0065\u0064\u000f\u0053\u0070\u0061\u0063\u0065\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u000c\u0053\u0070\u0061\u0063\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0009\u0053\u0075\u0072\u0072\u006f\u0067\u0061\u0074\u0065\u0006\u0053\u0079\u006d\u0062\u006f\u006c\u0004\u0054\u0065\u0072\u006d\u0014\u0054\u0065\u0072\u006d\u0069\u006e\u0061\u006c\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0010\u0054\u0069\u0074\u006c\u0065\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0005\u0055\u0049\u0064\u0065\u006f\u000a\u0055\u006e\u0061\u0073\u0073\u0069\u0067\u006e\u0065\u0064\u0011\u0055\u006e\u0069\u0066\u0069\u0065\u0064\u005f\u0049\u0064\u0065\u006f\u0067\u0072\u0061\u0070\u0068\u0005\u0055\u0070\u0070\u0065\u0072\u0009\u0055\u0070\u0070\u0065\u0072\u0063\u0061\u0073\u0065\u0010\u0055\u0070\u0070\u0065\u0072\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0002\u0056\u0053\u0012\u0056\u0061\u0072\u0069\u0061\u0074\u0069\u006f\u006e\u005f\u0053\u0065\u006c\u0065\u0063\u0074\u006f\u0072\u0006\u0057\u0053\u0070\u0061\u0063\u0065\u000b\u0057\u0068\u0069\u0074\u0065\u005f\u0053\u0070\u0061\u0063\u0065\u0004\u0058\u0049\u0044\u0043\u0004\u0058\u0049\u0044\u0053\u000c\u0058\u0049\u0044\u005f\u0043\u006f\u006e\u0074\u0069\u006e\u0075\u0065\u0009\u0058\u0049\u0044\u005f\u0053\u0074\u0061\u0072\u0074\u0001\u005a\u0002\u005a\u006c\u0002\u005a\u0070\u0002\u005a\u0073\u0005\u0063\u006e\u0074\u0072\u006c\u0005\u0064\u0069\u0067\u0069\u0074\u0004\u0067\u0063\u003d\u0043\u000f\u0067\u0063\u003d\u0043\u0061\u0073\u0065\u0064\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0005\u0067\u0063\u003d\u0043\u0063\u0005\u0067\u0063\u003d\u0043\u0066\u0014\u0067\u0063\u003d\u0043\u006c\u006f\u0073\u0065\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0005\u0067\u0063\u003d\u0043\u006e\u0005\u0067\u0063\u003d\u0043\u006f\u0011\u0067\u0063\u003d\u0043\u006f\u006d\u0062\u0069\u006e\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0018\u0067\u0063\u003d\u0043\u006f\u006e\u006e\u0065\u0063\u0074\u006f\u0072\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u000a\u0067\u0063\u003d\u0043\u006f\u006e\u0074\u0072\u006f\u006c\u0005\u0067\u0063\u003d\u0043\u0073\u0012\u0067\u0063\u003d\u0043\u0075\u0072\u0072\u0065\u006e\u0063\u0079\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0013\u0067\u0063\u003d\u0044\u0061\u0073\u0068\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0011\u0067\u0063\u003d\u0044\u0065\u0063\u0069\u006d\u0061\u006c\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u0011\u0067\u0063\u003d\u0045\u006e\u0063\u006c\u006f\u0073\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0014\u0067\u0063\u003d\u0046\u0069\u006e\u0061\u006c\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0009\u0067\u0063\u003d\u0046\u006f\u0072\u006d\u0061\u0074\u0016\u0067\u0063\u003d\u0049\u006e\u0069\u0074\u0069\u0061\u006c\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0004\u0067\u0063\u003d\u004c\u0005\u0067\u0063\u003d\u004c\u0043\u0009\u0067\u0063\u003d\u004c\u0065\u0074\u0074\u0065\u0072\u0010\u0067\u0063\u003d\u004c\u0065\u0074\u0074\u0065\u0072\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u0011\u0067\u0063\u003d\u004c\u0069\u006e\u0065\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0005\u0067\u0063\u003d\u004c\u006c\u0005\u0067\u0063\u003d\u004c\u006d\u0005\u0067\u0063\u003d\u004c\u006f\u0013\u0067\u0063\u003d\u004c\u006f\u0077\u0065\u0072\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0005\u0067\u0063\u003d\u004c\u0074\u0005\u0067\u0063\u003d\u004c\u0075\u0004\u0067\u0063\u003d\u004d\u0007\u0067\u0063\u003d\u004d\u0061\u0072\u006b\u000e\u0067\u0063\u003d\u004d\u0061\u0074\u0068\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0005\u0067\u0063\u003d\u004d\u0063\u0005\u0067\u0063\u003d\u004d\u0065\u0005\u0067\u0063\u003d\u004d\u006e\u0012\u0067\u0063\u003d\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0012\u0067\u0063\u003d\u004d\u006f\u0064\u0069\u0066\u0069\u0065\u0072\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0004\u0067\u0063\u003d\u004e\u0005\u0067\u0063\u003d\u004e\u0064\u0005\u0067\u0063\u003d\u004e\u006c\u0005\u0067\u0063\u003d\u004e\u006f\u0012\u0067\u0063\u003d\u004e\u006f\u006e\u0073\u0070\u0061\u0063\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u0009\u0067\u0063\u003d\u004e\u0075\u006d\u0062\u0065\u0072\u0013\u0067\u0063\u003d\u004f\u0070\u0065\u006e\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0008\u0067\u0063\u003d\u004f\u0074\u0068\u0065\u0072\u000f\u0067\u0063\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u000f\u0067\u0063\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u004e\u0075\u006d\u0062\u0065\u0072\u0014\u0067\u0063\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u000f\u0067\u0063\u003d\u004f\u0074\u0068\u0065\u0072\u005f\u0053\u0079\u006d\u0062\u006f\u006c\u0004\u0067\u0063\u003d\u0050\u0016\u0067\u0063\u003d\u0050\u0061\u0072\u0061\u0067\u0072\u0061\u0070\u0068\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0005\u0067\u0063\u003d\u0050\u0063\u0005\u0067\u0063\u003d\u0050\u0064\u0005\u0067\u0063\u003d\u0050\u0065\u0005\u0067\u0063\u003d\u0050\u0066\u0005\u0067\u0063\u003d\u0050\u0069\u0005\u0067\u0063\u003d\u0050\u006f\u000e\u0067\u0063\u003d\u0050\u0072\u0069\u0076\u0061\u0074\u0065\u005f\u0055\u0073\u0065\u0005\u0067\u0063\u003d\u0050\u0073\u000e\u0067\u0063\u003d\u0050\u0075\u006e\u0063\u0074\u0075\u0061\u0074\u0069\u006f\u006e\u0004\u0067\u0063\u003d\u0053\u0005\u0067\u0063\u003d\u0053\u0063\u000c\u0067\u0063\u003d\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u0005\u0067\u0063\u003d\u0053\u006b\u0005\u0067\u0063\u003d\u0053\u006d\u0005\u0067\u0063\u003d\u0053\u006f\u0012\u0067\u0063\u003d\u0053\u0070\u0061\u0063\u0065\u005f\u0053\u0065\u0070\u0061\u0072\u0061\u0074\u006f\u0072\u000f\u0067\u0063\u003d\u0053\u0070\u0061\u0063\u0069\u006e\u0067\u005f\u004d\u0061\u0072\u006b\u000c\u0067\u0063\u003d\u0053\u0075\u0072\u0072\u006f\u0067\u0061\u0074\u0065\u0009\u0067\u0063\u003d\u0053\u0079\u006d\u0062\u006f\u006c\u0013\u0067\u0063\u003d\u0054\u0069\u0074\u006c\u0065\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u000d\u0067\u0063\u003d\u0055\u006e\u0061\u0073\u0073\u0069\u0067\u006e\u0065\u0064\u0013\u0067\u0063\u003d\u0055\u0070\u0070\u0065\u0072\u0063\u0061\u0073\u0065\u005f\u004c\u0065\u0074\u0074\u0065\u0072\u0004\u0067\u0063\u003d\u005a\u0005\u0067\u0063\u003d\u005a\u006c\u0005\u0067\u0063\u003d\u005a\u0070\u0005\u0067\u0063\u003d\u005a\u0073\u0008\u0067\u0063\u003d\u0063\u006e\u0074\u0072\u006c\u0008\u0067\u0063\u003d\u0064\u0069\u0067\u0069\u0074\u0008\u0067\u0063\u003d\u0070\u0075\u006e\u0063\u0074\u0005\u0070\u0075\u006e\u0063\u0074\u0008\u0073\u0063\u003d\u0041\u0064\u006c\u0061\u006d\u0007\u0073\u0063\u003d\u0041\u0064\u006c\u006d\u0007\u0073\u0063\u003d\u0041\u0067\u0068\u0062\u0007\u0073\u0063\u003d\u0041\u0068\u006f\u006d\u0018\u0073\u0063\u003d\u0041\u006e\u0061\u0074\u006f\u006c\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0007\u0073\u0063\u003d\u0041\u0072\u0061\u0062\u0009\u0073\u0063\u003d\u0041\u0072\u0061\u0062\u0069\u0063\u000b\u0073\u0063\u003d\u0041\u0072\u006d\u0065\u006e\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u0041\u0072\u006d\u0069\u0007\u0073\u0063\u003d\u0041\u0072\u006d\u006e\u000a\u0073\u0063\u003d\u0041\u0076\u0065\u0073\u0074\u0061\u006e\u0007\u0073\u0063\u003d\u0041\u0076\u0073\u0074\u0007\u0073\u0063\u003d\u0042\u0061\u006c\u0069\u000b\u0073\u0063\u003d\u0042\u0061\u006c\u0069\u006e\u0065\u0073\u0065\u0007\u0073\u0063\u003d\u0042\u0061\u006d\u0075\u0008\u0073\u0063\u003d\u0042\u0061\u006d\u0075\u006d\u0007\u0073\u0063\u003d\u0042\u0061\u0073\u0073\u000c\u0073\u0063\u003d\u0042\u0061\u0073\u0073\u0061\u005f\u0056\u0061\u0068\u0008\u0073\u0063\u003d\u0042\u0061\u0074\u0061\u006b\u0007\u0073\u0063\u003d\u0042\u0061\u0074\u006b\u0007\u0073\u0063\u003d\u0042\u0065\u006e\u0067\u000a\u0073\u0063\u003d\u0042\u0065\u006e\u0067\u0061\u006c\u0069\u0007\u0073\u0063\u003d\u0042\u0065\u0072\u0066\u000d\u0073\u0063\u003d\u0042\u0065\u0072\u0069\u0061\u005f\u0045\u0072\u0066\u0065\u000c\u0073\u0063\u003d\u0042\u0068\u0061\u0069\u006b\u0073\u0075\u006b\u0069\u0007\u0073\u0063\u003d\u0042\u0068\u006b\u0073\u0007\u0073\u0063\u003d\u0042\u006f\u0070\u006f\u000b\u0073\u0063\u003d\u0042\u006f\u0070\u006f\u006d\u006f\u0066\u006f\u0007\u0073\u0063\u003d\u0042\u0072\u0061\u0068\u0009\u0073\u0063\u003d\u0042\u0072\u0061\u0068\u006d\u0069\u0007\u0073\u0063\u003d\u0042\u0072\u0061\u0069\u000a\u0073\u0063\u003d\u0042\u0072\u0061\u0069\u006c\u006c\u0065\u0007\u0073\u0063\u003d\u0042\u0075\u0067\u0069\u000b\u0073\u0063\u003d\u0042\u0075\u0067\u0069\u006e\u0065\u0073\u0065\u0007\u0073\u0063\u003d\u0042\u0075\u0068\u0064\u0008\u0073\u0063\u003d\u0042\u0075\u0068\u0069\u0064\u0007\u0073\u0063\u003d\u0043\u0061\u006b\u006d\u0016\u0073\u0063\u003d\u0043\u0061\u006e\u0061\u0064\u0069\u0061\u006e\u005f\u0041\u0062\u006f\u0072\u0069\u0067\u0069\u006e\u0061\u006c\u0007\u0073\u0063\u003d\u0043\u0061\u006e\u0073\u0007\u0073\u0063\u003d\u0043\u0061\u0072\u0069\u0009\u0073\u0063\u003d\u0043\u0061\u0072\u0069\u0061\u006e\u0015\u0073\u0063\u003d\u0043\u0061\u0075\u0063\u0061\u0073\u0069\u0061\u006e\u005f\u0041\u006c\u0062\u0061\u006e\u0069\u0061\u006e\u0009\u0073\u0063\u003d\u0043\u0068\u0061\u006b\u006d\u0061\u0007\u0073\u0063\u003d\u0043\u0068\u0061\u006d\u0007\u0073\u0063\u003d\u0043\u0068\u0065\u0072\u000b\u0073\u0063\u003d\u0043\u0068\u0065\u0072\u006f\u006b\u0065\u0065\u000d\u0073\u0063\u003d\u0043\u0068\u006f\u0072\u0061\u0073\u006d\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u0043\u0068\u0072\u0073\u0009\u0073\u0063\u003d\u0043\u006f\u006d\u006d\u006f\u006e\u0007\u0073\u0063\u003d\u0043\u006f\u0070\u0074\u0009\u0073\u0063\u003d\u0043\u006f\u0070\u0074\u0069\u0063\u0007\u0073\u0063\u003d\u0043\u0070\u006d\u006e\u0007\u0073\u0063\u003d\u0043\u0070\u0072\u0074\u000c\u0073\u0063\u003d\u0043\u0075\u006e\u0065\u0069\u0066\u006f\u0072\u006d\u000a\u0073\u0063\u003d\u0043\u0079\u0070\u0072\u0069\u006f\u0074\u000f\u0073\u0063\u003d\u0043\u0079\u0070\u0072\u006f\u005f\u004d\u0069\u006e\u006f\u0061\u006e\u000b\u0073\u0063\u003d\u0043\u0079\u0072\u0069\u006c\u006c\u0069\u0063\u0007\u0073\u0063\u003d\u0043\u0079\u0072\u006c\u000a\u0073\u0063\u003d\u0044\u0065\u0073\u0065\u0072\u0065\u0074\u0007\u0073\u0063\u003d\u0044\u0065\u0076\u0061\u000d\u0073\u0063\u003d\u0044\u0065\u0076\u0061\u006e\u0061\u0067\u0061\u0072\u0069\u0007\u0073\u0063\u003d\u0044\u0069\u0061\u006b\u000e\u0073\u0063\u003d\u0044\u0069\u0076\u0065\u0073\u005f\u0041\u006b\u0075\u0072\u0075\u0007\u0073\u0063\u003d\u0044\u006f\u0067\u0072\u0008\u0073\u0063\u003d\u0044\u006f\u0067\u0072\u0061\u0007\u0073\u0063\u003d\u0044\u0073\u0072\u0074\u0007\u0073\u0063\u003d\u0044\u0075\u0070\u006c\u000b\u0073\u0063\u003d\u0044\u0075\u0070\u006c\u006f\u0079\u0061\u006e\u0007\u0073\u0063\u003d\u0045\u0067\u0079\u0070\u0017\u0073\u0063\u003d\u0045\u0067\u0079\u0070\u0074\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0007\u0073\u0063\u003d\u0045\u006c\u0062\u0061\u000a\u0073\u0063\u003d\u0045\u006c\u0062\u0061\u0073\u0061\u006e\u0007\u0073\u0063\u003d\u0045\u006c\u0079\u006d\u000a\u0073\u0063\u003d\u0045\u006c\u0079\u006d\u0061\u0069\u0063\u0007\u0073\u0063\u003d\u0045\u0074\u0068\u0069\u000b\u0073\u0063\u003d\u0045\u0074\u0068\u0069\u006f\u0070\u0069\u0063\u0007\u0073\u0063\u003d\u0047\u0061\u0072\u0061\u0008\u0073\u0063\u003d\u0047\u0061\u0072\u0061\u0079\u0007\u0073\u0063\u003d\u0047\u0065\u006f\u0072\u000b\u0073\u0063\u003d\u0047\u0065\u006f\u0072\u0067\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u0047\u006c\u0061\u0067\u000d\u0073\u0063\u003d\u0047\u006c\u0061\u0067\u006f\u006c\u0069\u0074\u0069\u0063\u0007\u0073\u0063\u003d\u0047\u006f\u006e\u0067\u0007\u0073\u0063\u003d\u0047\u006f\u006e\u006d\u0007\u0073\u0063\u003d\u0047\u006f\u0074\u0068\u0009\u0073\u0063\u003d\u0047\u006f\u0074\u0068\u0069\u0063\u0007\u0073\u0063\u003d\u0047\u0072\u0061\u006e\u000a\u0073\u0063\u003d\u0047\u0072\u0061\u006e\u0074\u0068\u0061\u0008\u0073\u0063\u003d\u0047\u0072\u0065\u0065\u006b\u0007\u0073\u0063\u003d\u0047\u0072\u0065\u006b\u000b\u0073\u0063\u003d\u0047\u0075\u006a\u0061\u0072\u0061\u0074\u0069\u0007\u0073\u0063\u003d\u0047\u0075\u006a\u0072\u0007\u0073\u0063\u003d\u0047\u0075\u006b\u0068\u0010\u0073\u0063\u003d\u0047\u0075\u006e\u006a\u0061\u006c\u0061\u005f\u0047\u006f\u006e\u0064\u0069\u000b\u0073\u0063\u003d\u0047\u0075\u0072\u006d\u0075\u006b\u0068\u0069\u0007\u0073\u0063\u003d\u0047\u0075\u0072\u0075\u000f\u0073\u0063\u003d\u0047\u0075\u0072\u0075\u006e\u0067\u005f\u004b\u0068\u0065\u006d\u0061\u0006\u0073\u0063\u003d\u0048\u0061\u006e\u0007\u0073\u0063\u003d\u0048\u0061\u006e\u0067\u0009\u0073\u0063\u003d\u0048\u0061\u006e\u0067\u0075\u006c\u0007\u0073\u0063\u003d\u0048\u0061\u006e\u0069\u0012\u0073\u0063\u003d\u0048\u0061\u006e\u0069\u0066\u0069\u005f\u0052\u006f\u0068\u0069\u006e\u0067\u0079\u0061\u0007\u0073\u0063\u003d\u0048\u0061\u006e\u006f\u000a\u0073\u0063\u003d\u0048\u0061\u006e\u0075\u006e\u006f\u006f\u0007\u0073\u0063\u003d\u0048\u0061\u0074\u0072\u0009\u0073\u0063\u003d\u0048\u0061\u0074\u0072\u0061\u006e\u0007\u0073\u0063\u003d\u0048\u0065\u0062\u0072\u0009\u0073\u0063\u003d\u0048\u0065\u0062\u0072\u0065\u0077\u0007\u0073\u0063\u003d\u0048\u0069\u0072\u0061\u000b\u0073\u0063\u003d\u0048\u0069\u0072\u0061\u0067\u0061\u006e\u0061\u0007\u0073\u0063\u003d\u0048\u006c\u0075\u0077\u0007\u0073\u0063\u003d\u0048\u006d\u006e\u0067\u0007\u0073\u0063\u003d\u0048\u006d\u006e\u0070\u0007\u0073\u0063\u003d\u0048\u0075\u006e\u0067\u0013\u0073\u0063\u003d\u0049\u006d\u0070\u0065\u0072\u0069\u0061\u006c\u005f\u0041\u0072\u0061\u006d\u0061\u0069\u0063\u000c\u0073\u0063\u003d\u0049\u006e\u0068\u0065\u0072\u0069\u0074\u0065\u0064\u0018\u0073\u0063\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u0019\u0073\u0063\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0072\u0074\u0068\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u0049\u0074\u0061\u006c\u0007\u0073\u0063\u003d\u004a\u0061\u0076\u0061\u000b\u0073\u0063\u003d\u004a\u0061\u0076\u0061\u006e\u0065\u0073\u0065\u0009\u0073\u0063\u003d\u004b\u0061\u0069\u0074\u0068\u0069\u0007\u0073\u0063\u003d\u004b\u0061\u006c\u0069\u0007\u0073\u0063\u003d\u004b\u0061\u006e\u0061\u000a\u0073\u0063\u003d\u004b\u0061\u006e\u006e\u0061\u0064\u0061\u000b\u0073\u0063\u003d\u004b\u0061\u0074\u0061\u006b\u0061\u006e\u0061\u0007\u0073\u0063\u003d\u004b\u0061\u0077\u0069\u000b\u0073\u0063\u003d\u004b\u0061\u0079\u0061\u0068\u005f\u004c\u0069\u0007\u0073\u0063\u003d\u004b\u0068\u0061\u0072\u000d\u0073\u0063\u003d\u004b\u0068\u0061\u0072\u006f\u0073\u0068\u0074\u0068\u0069\u0016\u0073\u0063\u003d\u004b\u0068\u0069\u0074\u0061\u006e\u005f\u0053\u006d\u0061\u006c\u006c\u005f\u0053\u0063\u0072\u0069\u0070\u0074\u0008\u0073\u0063\u003d\u004b\u0068\u006d\u0065\u0072\u0007\u0073\u0063\u003d\u004b\u0068\u006d\u0072\u0007\u0073\u0063\u003d\u004b\u0068\u006f\u006a\u0009\u0073\u0063\u003d\u004b\u0068\u006f\u006a\u006b\u0069\u000c\u0073\u0063\u003d\u004b\u0068\u0075\u0064\u0061\u0077\u0061\u0064\u0069\u000c\u0073\u0063\u003d\u004b\u0069\u0072\u0061\u0074\u005f\u0052\u0061\u0069\u0007\u0073\u0063\u003d\u004b\u0069\u0074\u0073\u0007\u0073\u0063\u003d\u004b\u006e\u0064\u0061\u0007\u0073\u0063\u003d\u004b\u0072\u0061\u0069\u0007\u0073\u0063\u003d\u004b\u0074\u0068\u0069\u0007\u0073\u0063\u003d\u004c\u0061\u006e\u0061\u0006\u0073\u0063\u003d\u004c\u0061\u006f\u0007\u0073\u0063\u003d\u004c\u0061\u006f\u006f\u0008\u0073\u0063\u003d\u004c\u0061\u0074\u0069\u006e\u0007\u0073\u0063\u003d\u004c\u0061\u0074\u006e\u0007\u0073\u0063\u003d\u004c\u0065\u0070\u0063\u0009\u0073\u0063\u003d\u004c\u0065\u0070\u0063\u0068\u0061\u0007\u0073\u0063\u003d\u004c\u0069\u006d\u0062\u0008\u0073\u0063\u003d\u004c\u0069\u006d\u0062\u0075\u0007\u0073\u0063\u003d\u004c\u0069\u006e\u0061\u0007\u0073\u0063\u003d\u004c\u0069\u006e\u0062\u000b\u0073\u0063\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0041\u000b\u0073\u0063\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0042\u0007\u0073\u0063\u003d\u004c\u0069\u0073\u0075\u0007\u0073\u0063\u003d\u004c\u0079\u0063\u0069\u0009\u0073\u0063\u003d\u004c\u0079\u0063\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u004c\u0079\u0064\u0069\u0009\u0073\u0063\u003d\u004c\u0079\u0064\u0069\u0061\u006e\u000b\u0073\u0063\u003d\u004d\u0061\u0068\u0061\u006a\u0061\u006e\u0069\u0007\u0073\u0063\u003d\u004d\u0061\u0068\u006a\u0007\u0073\u0063\u003d\u004d\u0061\u006b\u0061\u000a\u0073\u0063\u003d\u004d\u0061\u006b\u0061\u0073\u0061\u0072\u000c\u0073\u0063\u003d\u004d\u0061\u006c\u0061\u0079\u0061\u006c\u0061\u006d\u0007\u0073\u0063\u003d\u004d\u0061\u006e\u0064\u000a\u0073\u0063\u003d\u004d\u0061\u006e\u0064\u0061\u0069\u0063\u0007\u0073\u0063\u003d\u004d\u0061\u006e\u0069\u000d\u0073\u0063\u003d\u004d\u0061\u006e\u0069\u0063\u0068\u0061\u0065\u0061\u006e\u0007\u0073\u0063\u003d\u004d\u0061\u0072\u0063\u000a\u0073\u0063\u003d\u004d\u0061\u0072\u0063\u0068\u0065\u006e\u0010\u0073\u0063\u003d\u004d\u0061\u0073\u0061\u0072\u0061\u006d\u005f\u0047\u006f\u006e\u0064\u0069\u000e\u0073\u0063\u003d\u004d\u0065\u0064\u0065\u0066\u0061\u0069\u0064\u0072\u0069\u006e\u0007\u0073\u0063\u003d\u004d\u0065\u0064\u0066\u000f\u0073\u0063\u003d\u004d\u0065\u0065\u0074\u0065\u0069\u005f\u004d\u0061\u0079\u0065\u006b\u0007\u0073\u0063\u003d\u004d\u0065\u006e\u0064\u0010\u0073\u0063\u003d\u004d\u0065\u006e\u0064\u0065\u005f\u004b\u0069\u006b\u0061\u006b\u0075\u0069\u0007\u0073\u0063\u003d\u004d\u0065\u0072\u0063\u0007\u0073\u0063\u003d\u004d\u0065\u0072\u006f\u0013\u0073\u0063\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0043\u0075\u0072\u0073\u0069\u0076\u0065\u0017\u0073\u0063\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0007\u0073\u0063\u003d\u004d\u0069\u0061\u006f\u0007\u0073\u0063\u003d\u004d\u006c\u0079\u006d\u0007\u0073\u0063\u003d\u004d\u006f\u0064\u0069\u0007\u0073\u0063\u003d\u004d\u006f\u006e\u0067\u000c\u0073\u0063\u003d\u004d\u006f\u006e\u0067\u006f\u006c\u0069\u0061\u006e\u0006\u0073\u0063\u003d\u004d\u0072\u006f\u0007\u0073\u0063\u003d\u004d\u0072\u006f\u006f\u0007\u0073\u0063\u003d\u004d\u0074\u0065\u0069\u0007\u0073\u0063\u003d\u004d\u0075\u006c\u0074\u000a\u0073\u0063\u003d\u004d\u0075\u006c\u0074\u0061\u006e\u0069\u000a\u0073\u0063\u003d\u004d\u0079\u0061\u006e\u006d\u0061\u0072\u0007\u0073\u0063\u003d\u004d\u0079\u006d\u0072\u000c\u0073\u0063\u003d\u004e\u0061\u0062\u0061\u0074\u0061\u0065\u0061\u006e\u000e\u0073\u0063\u003d\u004e\u0061\u0067\u005f\u004d\u0075\u006e\u0064\u0061\u0072\u0069\u0007\u0073\u0063\u003d\u004e\u0061\u0067\u006d\u0007\u0073\u0063\u003d\u004e\u0061\u006e\u0064\u000e\u0073\u0063\u003d\u004e\u0061\u006e\u0064\u0069\u006e\u0061\u0067\u0061\u0072\u0069\u0007\u0073\u0063\u003d\u004e\u0061\u0072\u0062\u0007\u0073\u0063\u003d\u004e\u0062\u0061\u0074\u000e\u0073\u0063\u003d\u004e\u0065\u0077\u005f\u0054\u0061\u0069\u005f\u004c\u0075\u0065\u0007\u0073\u0063\u003d\u004e\u0065\u0077\u0061\u0006\u0073\u0063\u003d\u004e\u006b\u006f\u0007\u0073\u0063\u003d\u004e\u006b\u006f\u006f\u0007\u0073\u0063\u003d\u004e\u0073\u0068\u0075\u0008\u0073\u0063\u003d\u004e\u0075\u0073\u0068\u0075\u0019\u0073\u0063\u003d\u004e\u0079\u0069\u0061\u006b\u0065\u006e\u0067\u005f\u0050\u0075\u0061\u0063\u0068\u0075\u0065\u005f\u0048\u006d\u006f\u006e\u0067\u0007\u0073\u0063\u003d\u004f\u0067\u0061\u006d\u0008\u0073\u0063\u003d\u004f\u0067\u0068\u0061\u006d\u000b\u0073\u0063\u003d\u004f\u006c\u005f\u0043\u0068\u0069\u006b\u0069\u000a\u0073\u0063\u003d\u004f\u006c\u005f\u004f\u006e\u0061\u006c\u0007\u0073\u0063\u003d\u004f\u006c\u0063\u006b\u0010\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0048\u0075\u006e\u0067\u0061\u0072\u0069\u0061\u006e\u000d\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0049\u0074\u0061\u006c\u0069\u0063\u0014\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u004e\u006f\u0072\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u000d\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u006d\u0069\u0063\u000e\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u0073\u0069\u0061\u006e\u000e\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0067\u0064\u0069\u0061\u006e\u0014\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0075\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u000d\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0054\u0075\u0072\u006b\u0069\u0063\u000d\u0073\u0063\u003d\u004f\u006c\u0064\u005f\u0055\u0079\u0067\u0068\u0075\u0072\u0007\u0073\u0063\u003d\u004f\u006e\u0061\u006f\u0008\u0073\u0063\u003d\u004f\u0072\u0069\u0079\u0061\u0007\u0073\u0063\u003d\u004f\u0072\u006b\u0068\u0007\u0073\u0063\u003d\u004f\u0072\u0079\u0061\u0008\u0073\u0063\u003d\u004f\u0073\u0061\u0067\u0065\u0007\u0073\u0063\u003d\u004f\u0073\u0067\u0065\u0007\u0073\u0063\u003d\u004f\u0073\u006d\u0061\u000a\u0073\u0063\u003d\u004f\u0073\u006d\u0061\u006e\u0079\u0061\u0007\u0073\u0063\u003d\u004f\u0075\u0067\u0072\u000f\u0073\u0063\u003d\u0050\u0061\u0068\u0061\u0077\u0068\u005f\u0048\u006d\u006f\u006e\u0067\u0007\u0073\u0063\u003d\u0050\u0061\u006c\u006d\u000c\u0073\u0063\u003d\u0050\u0061\u006c\u006d\u0079\u0072\u0065\u006e\u0065\u000e\u0073\u0063\u003d\u0050\u0061\u0075\u005f\u0043\u0069\u006e\u005f\u0048\u0061\u0075\u0007\u0073\u0063\u003d\u0050\u0061\u0075\u0063\u0007\u0073\u0063\u003d\u0050\u0065\u0072\u006d\u0007\u0073\u0063\u003d\u0050\u0068\u0061\u0067\u000b\u0073\u0063\u003d\u0050\u0068\u0061\u0067\u0073\u005f\u0050\u0061\u0007\u0073\u0063\u003d\u0050\u0068\u006c\u0069\u0007\u0073\u0063\u003d\u0050\u0068\u006c\u0070\u0007\u0073\u0063\u003d\u0050\u0068\u006e\u0078\u000d\u0073\u0063\u003d\u0050\u0068\u006f\u0065\u006e\u0069\u0063\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u0050\u006c\u0072\u0064\u0007\u0073\u0063\u003d\u0050\u0072\u0074\u0069\u0012\u0073\u0063\u003d\u0050\u0073\u0061\u006c\u0074\u0065\u0072\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u0007\u0073\u0063\u003d\u0051\u0061\u0061\u0063\u0007\u0073\u0063\u003d\u0051\u0061\u0061\u0069\u0009\u0073\u0063\u003d\u0052\u0065\u006a\u0061\u006e\u0067\u0007\u0073\u0063\u003d\u0052\u006a\u006e\u0067\u0007\u0073\u0063\u003d\u0052\u006f\u0068\u0067\u0008\u0073\u0063\u003d\u0052\u0075\u006e\u0069\u0063\u0007\u0073\u0063\u003d\u0052\u0075\u006e\u0072\u000c\u0073\u0063\u003d\u0053\u0061\u006d\u0061\u0072\u0069\u0074\u0061\u006e\u0007\u0073\u0063\u003d\u0053\u0061\u006d\u0072\u0007\u0073\u0063\u003d\u0053\u0061\u0072\u0062\u0007\u0073\u0063\u003d\u0053\u0061\u0075\u0072\u000d\u0073\u0063\u003d\u0053\u0061\u0075\u0072\u0061\u0073\u0068\u0074\u0072\u0061\u0007\u0073\u0063\u003d\u0053\u0067\u006e\u0077\u000a\u0073\u0063\u003d\u0053\u0068\u0061\u0072\u0061\u0064\u0061\u000a\u0073\u0063\u003d\u0053\u0068\u0061\u0076\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u0053\u0068\u0061\u0077\u0007\u0073\u0063\u003d\u0053\u0068\u0072\u0064\u0007\u0073\u0063\u003d\u0053\u0069\u0064\u0064\u000a\u0073\u0063\u003d\u0053\u0069\u0064\u0064\u0068\u0061\u006d\u000a\u0073\u0063\u003d\u0053\u0069\u0064\u0065\u0074\u0069\u0063\u0007\u0073\u0063\u003d\u0053\u0069\u0064\u0074\u000e\u0073\u0063\u003d\u0053\u0069\u0067\u006e\u0057\u0072\u0069\u0074\u0069\u006e\u0067\u0007\u0073\u0063\u003d\u0053\u0069\u006e\u0064\u0007\u0073\u0063\u003d\u0053\u0069\u006e\u0068\u000a\u0073\u0063\u003d\u0053\u0069\u006e\u0068\u0061\u006c\u0061\u0007\u0073\u0063\u003d\u0053\u006f\u0067\u0064\u000a\u0073\u0063\u003d\u0053\u006f\u0067\u0064\u0069\u0061\u006e\u0007\u0073\u0063\u003d\u0053\u006f\u0067\u006f\u0007\u0073\u0063\u003d\u0053\u006f\u0072\u0061\u000f\u0073\u0063\u003d\u0053\u006f\u0072\u0061\u005f\u0053\u006f\u006d\u0070\u0065\u006e\u0067\u0007\u0073\u0063\u003d\u0053\u006f\u0079\u006f\u000a\u0073\u0063\u003d\u0053\u006f\u0079\u006f\u006d\u0062\u006f\u0007\u0073\u0063\u003d\u0053\u0075\u006e\u0064\u000c\u0073\u0063\u003d\u0053\u0075\u006e\u0064\u0061\u006e\u0065\u0073\u0065\u0007\u0073\u0063\u003d\u0053\u0075\u006e\u0075\u000a\u0073\u0063\u003d\u0053\u0075\u006e\u0075\u0077\u0061\u0072\u0007\u0073\u0063\u003d\u0053\u0079\u006c\u006f\u000f\u0073\u0063\u003d\u0053\u0079\u006c\u006f\u0074\u0069\u005f\u004e\u0061\u0067\u0072\u0069\u0007\u0073\u0063\u003d\u0053\u0079\u0072\u0063\u0009\u0073\u0063\u003d\u0053\u0079\u0072\u0069\u0061\u0063\u000a\u0073\u0063\u003d\u0054\u0061\u0067\u0061\u006c\u006f\u0067\u0007\u0073\u0063\u003d\u0054\u0061\u0067\u0062\u000b\u0073\u0063\u003d\u0054\u0061\u0067\u0062\u0061\u006e\u0077\u0061\u0009\u0073\u0063\u003d\u0054\u0061\u0069\u005f\u004c\u0065\u000b\u0073\u0063\u003d\u0054\u0061\u0069\u005f\u0054\u0068\u0061\u006d\u000b\u0073\u0063\u003d\u0054\u0061\u0069\u005f\u0056\u0069\u0065\u0074\u0009\u0073\u0063\u003d\u0054\u0061\u0069\u005f\u0059\u006f\u0007\u0073\u0063\u003d\u0054\u0061\u006b\u0072\u0008\u0073\u0063\u003d\u0054\u0061\u006b\u0072\u0069\u0007\u0073\u0063\u003d\u0054\u0061\u006c\u0065\u0007\u0073\u0063\u003d\u0054\u0061\u006c\u0075\u0008\u0073\u0063\u003d\u0054\u0061\u006d\u0069\u006c\u0007\u0073\u0063\u003d\u0054\u0061\u006d\u006c\u0007\u0073\u0063\u003d\u0054\u0061\u006e\u0067\u0009\u0073\u0063\u003d\u0054\u0061\u006e\u0067\u0073\u0061\u0009\u0073\u0063\u003d\u0054\u0061\u006e\u0067\u0075\u0074\u0007\u0073\u0063\u003d\u0054\u0061\u0076\u0074\u0007\u0073\u0063\u003d\u0054\u0061\u0079\u006f\u0007\u0073\u0063\u003d\u0054\u0065\u006c\u0075\u0009\u0073\u0063\u003d\u0054\u0065\u006c\u0075\u0067\u0075\u0007\u0073\u0063\u003d\u0054\u0066\u006e\u0067\u0007\u0073\u0063\u003d\u0054\u0067\u006c\u0067\u0007\u0073\u0063\u003d\u0054\u0068\u0061\u0061\u0009\u0073\u0063\u003d\u0054\u0068\u0061\u0061\u006e\u0061\u0007\u0073\u0063\u003d\u0054\u0068\u0061\u0069\u000a\u0073\u0063\u003d\u0054\u0069\u0062\u0065\u0074\u0061\u006e\u0007\u0073\u0063\u003d\u0054\u0069\u0062\u0074\u000b\u0073\u0063\u003d\u0054\u0069\u0066\u0069\u006e\u0061\u0067\u0068\u0007\u0073\u0063\u003d\u0054\u0069\u0072\u0068\u000a\u0073\u0063\u003d\u0054\u0069\u0072\u0068\u0075\u0074\u0061\u0007\u0073\u0063\u003d\u0054\u006e\u0073\u0061\u0009\u0073\u0063\u003d\u0054\u006f\u0064\u0068\u0072\u0069\u0007\u0073\u0063\u003d\u0054\u006f\u0064\u0072\u000e\u0073\u0063\u003d\u0054\u006f\u006c\u006f\u006e\u0067\u005f\u0053\u0069\u006b\u0069\u0007\u0073\u0063\u003d\u0054\u006f\u006c\u0073\u0007\u0073\u0063\u003d\u0054\u006f\u0074\u006f\u0010\u0073\u0063\u003d\u0054\u0075\u006c\u0075\u005f\u0054\u0069\u0067\u0061\u006c\u0061\u0072\u0069\u0007\u0073\u0063\u003d\u0054\u0075\u0074\u0067\u0007\u0073\u0063\u003d\u0055\u0067\u0061\u0072\u000b\u0073\u0063\u003d\u0055\u0067\u0061\u0072\u0069\u0074\u0069\u0063\u000a\u0073\u0063\u003d\u0055\u006e\u006b\u006e\u006f\u0077\u006e\u0006\u0073\u0063\u003d\u0056\u0061\u0069\u0007\u0073\u0063\u003d\u0056\u0061\u0069\u0069\u0007\u0073\u0063\u003d\u0056\u0069\u0074\u0068\u000b\u0073\u0063\u003d\u0056\u0069\u0074\u0068\u006b\u0075\u0071\u0069\u0009\u0073\u0063\u003d\u0057\u0061\u006e\u0063\u0068\u006f\u0007\u0073\u0063\u003d\u0057\u0061\u0072\u0061\u000e\u0073\u0063\u003d\u0057\u0061\u0072\u0061\u006e\u0067\u005f\u0043\u0069\u0074\u0069\u0007\u0073\u0063\u003d\u0057\u0063\u0068\u006f\u0007\u0073\u0063\u003d\u0058\u0070\u0065\u006f\u0007\u0073\u0063\u003d\u0058\u0073\u0075\u0078\u0007\u0073\u0063\u003d\u0059\u0065\u007a\u0069\u0009\u0073\u0063\u003d\u0059\u0065\u007a\u0069\u0064\u0069\u0005\u0073\u0063\u003d\u0059\u0069\u0007\u0073\u0063\u003d\u0059\u0069\u0069\u0069\u0013\u0073\u0063\u003d\u005a\u0061\u006e\u0061\u0062\u0061\u007a\u0061\u0072\u005f\u0053\u0071\u0075\u0061\u0072\u0065\u0007\u0073\u0063\u003d\u005a\u0061\u006e\u0062\u0007\u0073\u0063\u003d\u005a\u0069\u006e\u0068\u0007\u0073\u0063\u003d\u005a\u0079\u0079\u0079\u0007\u0073\u0063\u003d\u005a\u007a\u007a\u007a\u0009\u0073\u0063\u0078\u003d\u0041\u0064\u006c\u0061\u006d\u0008\u0073\u0063\u0078\u003d\u0041\u0064\u006c\u006d\u0008\u0073\u0063\u0078\u003d\u0041\u0067\u0068\u0062\u0008\u0073\u0063\u0078\u003d\u0041\u0068\u006f\u006d\u0019\u0073\u0063\u0078\u003d\u0041\u006e\u0061\u0074\u006f\u006c\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0008\u0073\u0063\u0078\u003d\u0041\u0072\u0061\u0062\u000a\u0073\u0063\u0078\u003d\u0041\u0072\u0061\u0062\u0069\u0063\u000c\u0073\u0063\u0078\u003d\u0041\u0072\u006d\u0065\u006e\u0069\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0041\u0072\u006d\u0069\u0008\u0073\u0063\u0078\u003d\u0041\u0072\u006d\u006e\u000b\u0073\u0063\u0078\u003d\u0041\u0076\u0065\u0073\u0074\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0041\u0076\u0073\u0074\u0008\u0073\u0063\u0078\u003d\u0042\u0061\u006c\u0069\u000c\u0073\u0063\u0078\u003d\u0042\u0061\u006c\u0069\u006e\u0065\u0073\u0065\u0008\u0073\u0063\u0078\u003d\u0042\u0061\u006d\u0075\u0009\u0073\u0063\u0078\u003d\u0042\u0061\u006d\u0075\u006d\u0008\u0073\u0063\u0078\u003d\u0042\u0061\u0073\u0073\u000d\u0073\u0063\u0078\u003d\u0042\u0061\u0073\u0073\u0061\u005f\u0056\u0061\u0068\u0009\u0073\u0063\u0078\u003d\u0042\u0061\u0074\u0061\u006b\u0008\u0073\u0063\u0078\u003d\u0042\u0061\u0074\u006b\u0008\u0073\u0063\u0078\u003d\u0042\u0065\u006e\u0067\u000b\u0073\u0063\u0078\u003d\u0042\u0065\u006e\u0067\u0061\u006c\u0069\u0008\u0073\u0063\u0078\u003d\u0042\u0065\u0072\u0066\u000e\u0073\u0063\u0078\u003d\u0042\u0065\u0072\u0069\u0061\u005f\u0045\u0072\u0066\u0065\u000d\u0073\u0063\u0078\u003d\u0042\u0068\u0061\u0069\u006b\u0073\u0075\u006b\u0069\u0008\u0073\u0063\u0078\u003d\u0042\u0068\u006b\u0073\u0008\u0073\u0063\u0078\u003d\u0042\u006f\u0070\u006f\u000c\u0073\u0063\u0078\u003d\u0042\u006f\u0070\u006f\u006d\u006f\u0066\u006f\u0008\u0073\u0063\u0078\u003d\u0042\u0072\u0061\u0068\u000a\u0073\u0063\u0078\u003d\u0042\u0072\u0061\u0068\u006d\u0069\u0008\u0073\u0063\u0078\u003d\u0042\u0072\u0061\u0069\u000b\u0073\u0063\u0078\u003d\u0042\u0072\u0061\u0069\u006c\u006c\u0065\u0008\u0073\u0063\u0078\u003d\u0042\u0075\u0067\u0069\u000c\u0073\u0063\u0078\u003d\u0042\u0075\u0067\u0069\u006e\u0065\u0073\u0065\u0008\u0073\u0063\u0078\u003d\u0042\u0075\u0068\u0064\u0009\u0073\u0063\u0078\u003d\u0042\u0075\u0068\u0069\u0064\u0008\u0073\u0063\u0078\u003d\u0043\u0061\u006b\u006d\u0017\u0073\u0063\u0078\u003d\u0043\u0061\u006e\u0061\u0064\u0069\u0061\u006e\u005f\u0041\u0062\u006f\u0072\u0069\u0067\u0069\u006e\u0061\u006c\u0008\u0073\u0063\u0078\u003d\u0043\u0061\u006e\u0073\u0008\u0073\u0063\u0078\u003d\u0043\u0061\u0072\u0069\u000a\u0073\u0063\u0078\u003d\u0043\u0061\u0072\u0069\u0061\u006e\u0016\u0073\u0063\u0078\u003d\u0043\u0061\u0075\u0063\u0061\u0073\u0069\u0061\u006e\u005f\u0041\u006c\u0062\u0061\u006e\u0069\u0061\u006e\u000a\u0073\u0063\u0078\u003d\u0043\u0068\u0061\u006b\u006d\u0061\u0008\u0073\u0063\u0078\u003d\u0043\u0068\u0061\u006d\u0008\u0073\u0063\u0078\u003d\u0043\u0068\u0065\u0072\u000c\u0073\u0063\u0078\u003d\u0043\u0068\u0065\u0072\u006f\u006b\u0065\u0065\u000e\u0073\u0063\u0078\u003d\u0043\u0068\u006f\u0072\u0061\u0073\u006d\u0069\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0043\u0068\u0072\u0073\u000a\u0073\u0063\u0078\u003d\u0043\u006f\u006d\u006d\u006f\u006e\u0008\u0073\u0063\u0078\u003d\u0043\u006f\u0070\u0074\u000a\u0073\u0063\u0078\u003d\u0043\u006f\u0070\u0074\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u0043\u0070\u006d\u006e\u0008\u0073\u0063\u0078\u003d\u0043\u0070\u0072\u0074\u000d\u0073\u0063\u0078\u003d\u0043\u0075\u006e\u0065\u0069\u0066\u006f\u0072\u006d\u000b\u0073\u0063\u0078\u003d\u0043\u0079\u0070\u0072\u0069\u006f\u0074\u0010\u0073\u0063\u0078\u003d\u0043\u0079\u0070\u0072\u006f\u005f\u004d\u0069\u006e\u006f\u0061\u006e\u000c\u0073\u0063\u0078\u003d\u0043\u0079\u0072\u0069\u006c\u006c\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u0043\u0079\u0072\u006c\u000b\u0073\u0063\u0078\u003d\u0044\u0065\u0073\u0065\u0072\u0065\u0074\u0008\u0073\u0063\u0078\u003d\u0044\u0065\u0076\u0061\u000e\u0073\u0063\u0078\u003d\u0044\u0065\u0076\u0061\u006e\u0061\u0067\u0061\u0072\u0069\u0008\u0073\u0063\u0078\u003d\u0044\u0069\u0061\u006b\u000f\u0073\u0063\u0078\u003d\u0044\u0069\u0076\u0065\u0073\u005f\u0041\u006b\u0075\u0072\u0075\u0008\u0073\u0063\u0078\u003d\u0044\u006f\u0067\u0072\u0009\u0073\u0063\u0078\u003d\u0044\u006f\u0067\u0072\u0061\u0008\u0073\u0063\u0078\u003d\u0044\u0073\u0072\u0074\u0008\u0073\u0063\u0078\u003d\u0044\u0075\u0070\u006c\u000c\u0073\u0063\u0078\u003d\u0044\u0075\u0070\u006c\u006f\u0079\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0045\u0067\u0079\u0070\u0018\u0073\u0063\u0078\u003d\u0045\u0067\u0079\u0070\u0074\u0069\u0061\u006e\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0008\u0073\u0063\u0078\u003d\u0045\u006c\u0062\u0061\u000b\u0073\u0063\u0078\u003d\u0045\u006c\u0062\u0061\u0073\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0045\u006c\u0079\u006d\u000b\u0073\u0063\u0078\u003d\u0045\u006c\u0079\u006d\u0061\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u0045\u0074\u0068\u0069\u000c\u0073\u0063\u0078\u003d\u0045\u0074\u0068\u0069\u006f\u0070\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u0047\u0061\u0072\u0061\u0009\u0073\u0063\u0078\u003d\u0047\u0061\u0072\u0061\u0079\u0008\u0073\u0063\u0078\u003d\u0047\u0065\u006f\u0072\u000c\u0073\u0063\u0078\u003d\u0047\u0065\u006f\u0072\u0067\u0069\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0047\u006c\u0061\u0067\u000e\u0073\u0063\u0078\u003d\u0047\u006c\u0061\u0067\u006f\u006c\u0069\u0074\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u0047\u006f\u006e\u0067\u0008\u0073\u0063\u0078\u003d\u0047\u006f\u006e\u006d\u0008\u0073\u0063\u0078\u003d\u0047\u006f\u0074\u0068\u000a\u0073\u0063\u0078\u003d\u0047\u006f\u0074\u0068\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u0047\u0072\u0061\u006e\u000b\u0073\u0063\u0078\u003d\u0047\u0072\u0061\u006e\u0074\u0068\u0061\u0009\u0073\u0063\u0078\u003d\u0047\u0072\u0065\u0065\u006b\u0008\u0073\u0063\u0078\u003d\u0047\u0072\u0065\u006b\u000c\u0073\u0063\u0078\u003d\u0047\u0075\u006a\u0061\u0072\u0061\u0074\u0069\u0008\u0073\u0063\u0078\u003d\u0047\u0075\u006a\u0072\u0008\u0073\u0063\u0078\u003d\u0047\u0075\u006b\u0068\u0011\u0073\u0063\u0078\u003d\u0047\u0075\u006e\u006a\u0061\u006c\u0061\u005f\u0047\u006f\u006e\u0064\u0069\u000c\u0073\u0063\u0078\u003d\u0047\u0075\u0072\u006d\u0075\u006b\u0068\u0069\u0008\u0073\u0063\u0078\u003d\u0047\u0075\u0072\u0075\u0010\u0073\u0063\u0078\u003d\u0047\u0075\u0072\u0075\u006e\u0067\u005f\u004b\u0068\u0065\u006d\u0061\u0007\u0073\u0063\u0078\u003d\u0048\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0048\u0061\u006e\u0067\u000a\u0073\u0063\u0078\u003d\u0048\u0061\u006e\u0067\u0075\u006c\u0008\u0073\u0063\u0078\u003d\u0048\u0061\u006e\u0069\u0013\u0073\u0063\u0078\u003d\u0048\u0061\u006e\u0069\u0066\u0069\u005f\u0052\u006f\u0068\u0069\u006e\u0067\u0079\u0061\u0008\u0073\u0063\u0078\u003d\u0048\u0061\u006e\u006f\u000b\u0073\u0063\u0078\u003d\u0048\u0061\u006e\u0075\u006e\u006f\u006f\u0008\u0073\u0063\u0078\u003d\u0048\u0061\u0074\u0072\u000a\u0073\u0063\u0078\u003d\u0048\u0061\u0074\u0072\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0048\u0065\u0062\u0072\u000a\u0073\u0063\u0078\u003d\u0048\u0065\u0062\u0072\u0065\u0077\u0008\u0073\u0063\u0078\u003d\u0048\u0069\u0072\u0061\u000c\u0073\u0063\u0078\u003d\u0048\u0069\u0072\u0061\u0067\u0061\u006e\u0061\u0008\u0073\u0063\u0078\u003d\u0048\u006c\u0075\u0077\u0008\u0073\u0063\u0078\u003d\u0048\u006d\u006e\u0067\u0008\u0073\u0063\u0078\u003d\u0048\u006d\u006e\u0070\u0008\u0073\u0063\u0078\u003d\u0048\u0075\u006e\u0067\u0014\u0073\u0063\u0078\u003d\u0049\u006d\u0070\u0065\u0072\u0069\u0061\u006c\u005f\u0041\u0072\u0061\u006d\u0061\u0069\u0063\u000d\u0073\u0063\u0078\u003d\u0049\u006e\u0068\u0065\u0072\u0069\u0074\u0065\u0064\u0019\u0073\u0063\u0078\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u001a\u0073\u0063\u0078\u003d\u0049\u006e\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0050\u0061\u0072\u0074\u0068\u0069\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0049\u0074\u0061\u006c\u0008\u0073\u0063\u0078\u003d\u004a\u0061\u0076\u0061\u000c\u0073\u0063\u0078\u003d\u004a\u0061\u0076\u0061\u006e\u0065\u0073\u0065\u000a\u0073\u0063\u0078\u003d\u004b\u0061\u0069\u0074\u0068\u0069\u0008\u0073\u0063\u0078\u003d\u004b\u0061\u006c\u0069\u0008\u0073\u0063\u0078\u003d\u004b\u0061\u006e\u0061\u000b\u0073\u0063\u0078\u003d\u004b\u0061\u006e\u006e\u0061\u0064\u0061\u000c\u0073\u0063\u0078\u003d\u004b\u0061\u0074\u0061\u006b\u0061\u006e\u0061\u0008\u0073\u0063\u0078\u003d\u004b\u0061\u0077\u0069\u000c\u0073\u0063\u0078\u003d\u004b\u0061\u0079\u0061\u0068\u005f\u004c\u0069\u0008\u0073\u0063\u0078\u003d\u004b\u0068\u0061\u0072\u000e\u0073\u0063\u0078\u003d\u004b\u0068\u0061\u0072\u006f\u0073\u0068\u0074\u0068\u0069\u0017\u0073\u0063\u0078\u003d\u004b\u0068\u0069\u0074\u0061\u006e\u005f\u0053\u006d\u0061\u006c\u006c\u005f\u0053\u0063\u0072\u0069\u0070\u0074\u0009\u0073\u0063\u0078\u003d\u004b\u0068\u006d\u0065\u0072\u0008\u0073\u0063\u0078\u003d\u004b\u0068\u006d\u0072\u0008\u0073\u0063\u0078\u003d\u004b\u0068\u006f\u006a\u000a\u0073\u0063\u0078\u003d\u004b\u0068\u006f\u006a\u006b\u0069\u000d\u0073\u0063\u0078\u003d\u004b\u0068\u0075\u0064\u0061\u0077\u0061\u0064\u0069\u000d\u0073\u0063\u0078\u003d\u004b\u0069\u0072\u0061\u0074\u005f\u0052\u0061\u0069\u0008\u0073\u0063\u0078\u003d\u004b\u0069\u0074\u0073\u0008\u0073\u0063\u0078\u003d\u004b\u006e\u0064\u0061\u0008\u0073\u0063\u0078\u003d\u004b\u0072\u0061\u0069\u0008\u0073\u0063\u0078\u003d\u004b\u0074\u0068\u0069\u0008\u0073\u0063\u0078\u003d\u004c\u0061\u006e\u0061\u0007\u0073\u0063\u0078\u003d\u004c\u0061\u006f\u0008\u0073\u0063\u0078\u003d\u004c\u0061\u006f\u006f\u0009\u0073\u0063\u0078\u003d\u004c\u0061\u0074\u0069\u006e\u0008\u0073\u0063\u0078\u003d\u004c\u0061\u0074\u006e\u0008\u0073\u0063\u0078\u003d\u004c\u0065\u0070\u0063\u000a\u0073\u0063\u0078\u003d\u004c\u0065\u0070\u0063\u0068\u0061\u0008\u0073\u0063\u0078\u003d\u004c\u0069\u006d\u0062\u0009\u0073\u0063\u0078\u003d\u004c\u0069\u006d\u0062\u0075\u0008\u0073\u0063\u0078\u003d\u004c\u0069\u006e\u0061\u0008\u0073\u0063\u0078\u003d\u004c\u0069\u006e\u0062\u000c\u0073\u0063\u0078\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0041\u000c\u0073\u0063\u0078\u003d\u004c\u0069\u006e\u0065\u0061\u0072\u005f\u0042\u0008\u0073\u0063\u0078\u003d\u004c\u0069\u0073\u0075\u0008\u0073\u0063\u0078\u003d\u004c\u0079\u0063\u0069\u000a\u0073\u0063\u0078\u003d\u004c\u0079\u0063\u0069\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u004c\u0079\u0064\u0069\u000a\u0073\u0063\u0078\u003d\u004c\u0079\u0064\u0069\u0061\u006e\u000c\u0073\u0063\u0078\u003d\u004d\u0061\u0068\u0061\u006a\u0061\u006e\u0069\u0008\u0073\u0063\u0078\u003d\u004d\u0061\u0068\u006a\u0008\u0073\u0063\u0078\u003d\u004d\u0061\u006b\u0061\u000b\u0073\u0063\u0078\u003d\u004d\u0061\u006b\u0061\u0073\u0061\u0072\u000d\u0073\u0063\u0078\u003d\u004d\u0061\u006c\u0061\u0079\u0061\u006c\u0061\u006d\u0008\u0073\u0063\u0078\u003d\u004d\u0061\u006e\u0064\u000b\u0073\u0063\u0078\u003d\u004d\u0061\u006e\u0064\u0061\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u004d\u0061\u006e\u0069\u000e\u0073\u0063\u0078\u003d\u004d\u0061\u006e\u0069\u0063\u0068\u0061\u0065\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u004d\u0061\u0072\u0063\u000b\u0073\u0063\u0078\u003d\u004d\u0061\u0072\u0063\u0068\u0065\u006e\u0011\u0073\u0063\u0078\u003d\u004d\u0061\u0073\u0061\u0072\u0061\u006d\u005f\u0047\u006f\u006e\u0064\u0069\u000f\u0073\u0063\u0078\u003d\u004d\u0065\u0064\u0065\u0066\u0061\u0069\u0064\u0072\u0069\u006e\u0008\u0073\u0063\u0078\u003d\u004d\u0065\u0064\u0066\u0010\u0073\u0063\u0078\u003d\u004d\u0065\u0065\u0074\u0065\u0069\u005f\u004d\u0061\u0079\u0065\u006b\u0008\u0073\u0063\u0078\u003d\u004d\u0065\u006e\u0064\u0011\u0073\u0063\u0078\u003d\u004d\u0065\u006e\u0064\u0065\u005f\u004b\u0069\u006b\u0061\u006b\u0075\u0069\u0008\u0073\u0063\u0078\u003d\u004d\u0065\u0072\u0063\u0008\u0073\u0063\u0078\u003d\u004d\u0065\u0072\u006f\u0014\u0073\u0063\u0078\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0043\u0075\u0072\u0073\u0069\u0076\u0065\u0018\u0073\u0063\u0078\u003d\u004d\u0065\u0072\u006f\u0069\u0074\u0069\u0063\u005f\u0048\u0069\u0065\u0072\u006f\u0067\u006c\u0079\u0070\u0068\u0073\u0008\u0073\u0063\u0078\u003d\u004d\u0069\u0061\u006f\u0008\u0073\u0063\u0078\u003d\u004d\u006c\u0079\u006d\u0008\u0073\u0063\u0078\u003d\u004d\u006f\u0064\u0069\u0008\u0073\u0063\u0078\u003d\u004d\u006f\u006e\u0067\u000d\u0073\u0063\u0078\u003d\u004d\u006f\u006e\u0067\u006f\u006c\u0069\u0061\u006e\u0007\u0073\u0063\u0078\u003d\u004d\u0072\u006f\u0008\u0073\u0063\u0078\u003d\u004d\u0072\u006f\u006f\u0008\u0073\u0063\u0078\u003d\u004d\u0074\u0065\u0069\u0008\u0073\u0063\u0078\u003d\u004d\u0075\u006c\u0074\u000b\u0073\u0063\u0078\u003d\u004d\u0075\u006c\u0074\u0061\u006e\u0069\u000b\u0073\u0063\u0078\u003d\u004d\u0079\u0061\u006e\u006d\u0061\u0072\u0008\u0073\u0063\u0078\u003d\u004d\u0079\u006d\u0072\u000d\u0073\u0063\u0078\u003d\u004e\u0061\u0062\u0061\u0074\u0061\u0065\u0061\u006e\u000f\u0073\u0063\u0078\u003d\u004e\u0061\u0067\u005f\u004d\u0075\u006e\u0064\u0061\u0072\u0069\u0008\u0073\u0063\u0078\u003d\u004e\u0061\u0067\u006d\u0008\u0073\u0063\u0078\u003d\u004e\u0061\u006e\u0064\u000f\u0073\u0063\u0078\u003d\u004e\u0061\u006e\u0064\u0069\u006e\u0061\u0067\u0061\u0072\u0069\u0008\u0073\u0063\u0078\u003d\u004e\u0061\u0072\u0062\u0008\u0073\u0063\u0078\u003d\u004e\u0062\u0061\u0074\u000f\u0073\u0063\u0078\u003d\u004e\u0065\u0077\u005f\u0054\u0061\u0069\u005f\u004c\u0075\u0065\u0008\u0073\u0063\u0078\u003d\u004e\u0065\u0077\u0061\u0007\u0073\u0063\u0078\u003d\u004e\u006b\u006f\u0008\u0073\u0063\u0078\u003d\u004e\u006b\u006f\u006f\u0008\u0073\u0063\u0078\u003d\u004e\u0073\u0068\u0075\u0009\u0073\u0063\u0078\u003d\u004e\u0075\u0073\u0068\u0075\u001a\u0073\u0063\u0078\u003d\u004e\u0079\u0069\u0061\u006b\u0065\u006e\u0067\u005f\u0050\u0075\u0061\u0063\u0068\u0075\u0065\u005f\u0048\u006d\u006f\u006e\u0067\u0008\u0073\u0063\u0078\u003d\u004f\u0067\u0061\u006d\u0009\u0073\u0063\u0078\u003d\u004f\u0067\u0068\u0061\u006d\u000c\u0073\u0063\u0078\u003d\u004f\u006c\u005f\u0043\u0068\u0069\u006b\u0069\u000b\u0073\u0063\u0078\u003d\u004f\u006c\u005f\u004f\u006e\u0061\u006c\u0008\u0073\u0063\u0078\u003d\u004f\u006c\u0063\u006b\u0011\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0048\u0075\u006e\u0067\u0061\u0072\u0069\u0061\u006e\u000e\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0049\u0074\u0061\u006c\u0069\u0063\u0015\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u004e\u006f\u0072\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u000e\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u006d\u0069\u0063\u000f\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0050\u0065\u0072\u0073\u0069\u0061\u006e\u000f\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0067\u0064\u0069\u0061\u006e\u0015\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0053\u006f\u0075\u0074\u0068\u005f\u0041\u0072\u0061\u0062\u0069\u0061\u006e\u000e\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0054\u0075\u0072\u006b\u0069\u0063\u000e\u0073\u0063\u0078\u003d\u004f\u006c\u0064\u005f\u0055\u0079\u0067\u0068\u0075\u0072\u0008\u0073\u0063\u0078\u003d\u004f\u006e\u0061\u006f\u0009\u0073\u0063\u0078\u003d\u004f\u0072\u0069\u0079\u0061\u0008\u0073\u0063\u0078\u003d\u004f\u0072\u006b\u0068\u0008\u0073\u0063\u0078\u003d\u004f\u0072\u0079\u0061\u0009\u0073\u0063\u0078\u003d\u004f\u0073\u0061\u0067\u0065\u0008\u0073\u0063\u0078\u003d\u004f\u0073\u0067\u0065\u0008\u0073\u0063\u0078\u003d\u004f\u0073\u006d\u0061\u000b\u0073\u0063\u0078\u003d\u004f\u0073\u006d\u0061\u006e\u0079\u0061\u0008\u0073\u0063\u0078\u003d\u004f\u0075\u0067\u0072\u0010\u0073\u0063\u0078\u003d\u0050\u0061\u0068\u0061\u0077\u0068\u005f\u0048\u006d\u006f\u006e\u0067\u0008\u0073\u0063\u0078\u003d\u0050\u0061\u006c\u006d\u000d\u0073\u0063\u0078\u003d\u0050\u0061\u006c\u006d\u0079\u0072\u0065\u006e\u0065\u000f\u0073\u0063\u0078\u003d\u0050\u0061\u0075\u005f\u0043\u0069\u006e\u005f\u0048\u0061\u0075\u0008\u0073\u0063\u0078\u003d\u0050\u0061\u0075\u0063\u0008\u0073\u0063\u0078\u003d\u0050\u0065\u0072\u006d\u0008\u0073\u0063\u0078\u003d\u0050\u0068\u0061\u0067\u000c\u0073\u0063\u0078\u003d\u0050\u0068\u0061\u0067\u0073\u005f\u0050\u0061\u0008\u0073\u0063\u0078\u003d\u0050\u0068\u006c\u0069\u0008\u0073\u0063\u0078\u003d\u0050\u0068\u006c\u0070\u0008\u0073\u0063\u0078\u003d\u0050\u0068\u006e\u0078\u000e\u0073\u0063\u0078\u003d\u0050\u0068\u006f\u0065\u006e\u0069\u0063\u0069\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0050\u006c\u0072\u0064\u0008\u0073\u0063\u0078\u003d\u0050\u0072\u0074\u0069\u0013\u0073\u0063\u0078\u003d\u0050\u0073\u0061\u006c\u0074\u0065\u0072\u005f\u0050\u0061\u0068\u006c\u0061\u0076\u0069\u0008\u0073\u0063\u0078\u003d\u0051\u0061\u0061\u0063\u0008\u0073\u0063\u0078\u003d\u0051\u0061\u0061\u0069\u000a\u0073\u0063\u0078\u003d\u0052\u0065\u006a\u0061\u006e\u0067\u0008\u0073\u0063\u0078\u003d\u0052\u006a\u006e\u0067\u0008\u0073\u0063\u0078\u003d\u0052\u006f\u0068\u0067\u0009\u0073\u0063\u0078\u003d\u0052\u0075\u006e\u0069\u0063\u0008\u0073\u0063\u0078\u003d\u0052\u0075\u006e\u0072\u000d\u0073\u0063\u0078\u003d\u0053\u0061\u006d\u0061\u0072\u0069\u0074\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0053\u0061\u006d\u0072\u0008\u0073\u0063\u0078\u003d\u0053\u0061\u0072\u0062\u0008\u0073\u0063\u0078\u003d\u0053\u0061\u0075\u0072\u000e\u0073\u0063\u0078\u003d\u0053\u0061\u0075\u0072\u0061\u0073\u0068\u0074\u0072\u0061\u0008\u0073\u0063\u0078\u003d\u0053\u0067\u006e\u0077\u000b\u0073\u0063\u0078\u003d\u0053\u0068\u0061\u0072\u0061\u0064\u0061\u000b\u0073\u0063\u0078\u003d\u0053\u0068\u0061\u0076\u0069\u0061\u006e\u0008\u0073\u0063\u0078\u003d\u0053\u0068\u0061\u0077\u0008\u0073\u0063\u0078\u003d\u0053\u0068\u0072\u0064\u0008\u0073\u0063\u0078\u003d\u0053\u0069\u0064\u0064\u000b\u0073\u0063\u0078\u003d\u0053\u0069\u0064\u0064\u0068\u0061\u006d\u000b\u0073\u0063\u0078\u003d\u0053\u0069\u0064\u0065\u0074\u0069\u0063\u0008\u0073\u0063\u0078