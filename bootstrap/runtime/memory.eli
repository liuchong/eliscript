                (if (and (>= code 55296) (<= code 56319))
                  (if (< (1+ i) length)
                    (let ((next (load-u16 (+ data (* (1+ i) 2)))))
                      (if (and (>= next 56320) (<= next 57343))
                        (progn (setq code (+ 65536 (+ (* (- code 55296) 1024) (- next 56320))))
                          (setq i (1+ i)) 0)
                        (progn (setq invalid 1) 0)))
                    (progn (setq invalid 1) 0))
                  (progn (when (and (>= code 56320) (<= code 57343)) (setq invalid 1)) 0))
                (when (= invalid 1)
                  (if (= strict 1) (progn (fail 5) (setq ok 0)) (setq code 65533)))
                (when (= ok 1) (setq ok (push-scalar output code))))
              (setq i (1+ i)))
            (if (= ok 1) output 0))))))

  (defun utf8-decode (input strict preserve-bom)
