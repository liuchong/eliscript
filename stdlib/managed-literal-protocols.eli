(module eliscript.managed-literal-protocols
  (import "./core/protocol.eli"
    define-protocol protocol? protocol-slot protocol-method extend-protocol-type implements-protocol-operation?)
  (import-portable "./bit.eli" rotate-left)
  (import "./managed-value-state.eli" mixHash finishHash cachedProtocolHash recordHashValueCall hashPrimitiveValue)

  ;; Definitions and their private Symbols are shared by every adapter in this
  ;; target realm. Equal descriptions never stand in for actual slot identity.
  (defconst I_COUNTED (define-protocol "ICounted" (js-array "count")))
  (defconst I_EMPTYABLE (define-protocol "IEmptyable" (js-array "empty")))
  (defconst I_CONJ (define-protocol "IConj" (js-array "conj")))
  (defconst I_LOOKUP (define-protocol "ILookup" (js-array "get")))
  (defconst I_ASSOCIATIVE (define-protocol "IAssociative" (js-array "assoc" "contains")))
  (defconst I_INDEXED (define-protocol "IIndexed" (js-array "nth")))
  (defconst I_SEQABLE (define-protocol "ISeqable" (js-array "seq")))
  (defconst I_REDUCE (define-protocol "IReduce" (js-array "reduce")))
  (defconst I_KV_REDUCE (define-protocol "IKVReduce" (js-array "reduceKV")))
  (defconst I_MAP (define-protocol "IMap" (js-array "dissoc")))
  (defconst I_SET (define-protocol "ISet" (js-array "disj")))
  (defconst I_STACK (define-protocol "IStack" (js-array "peek" "pop")))
  (defconst I_REVERSIBLE (define-protocol "IReversible" (js-array "rseq")))
  (defconst I_EQUIV (define-protocol "IEquiv" (js-array "equal")))
  (defconst I_HASH (define-protocol "IHash" (js-array "hash")))
  (defconst I_META (define-protocol "IMeta" (js-array "meta")))
  (defconst I_WITH_META (define-protocol "IWithMeta" (js-array "withMeta")))
  (defconst I_EDITABLE (define-protocol "IEditable" (js-array "transient")))
  (defconst I_TRANSIENT_COLLECTION
    (define-protocol "ITransientCollection" (js-array "conj!" "assoc!" "dissoc!" "persistent!")))

  (defconst protocol-roles (new globalThis/WeakMap))
  (defconst role-protocols (new globalThis/Map))
  (defun managed-literal-register-protocol-role (role protocol)
    (unless (and (js-call (js-array "collection.ICounted" "collection.IEmptyable" "collection.IConj"
        "collection.ILookup" "collection.IAssociative" "collection.IIndexed" "collection.ISeqable"
        "collection.IReduce" "collection.IKVReduce" "collection.IMap" "collection.ISet"
        "collection.IStack" "collection.IReversible" "value.IEquiv" "value.IHash"
        "metadata.IMeta" "metadata.IWithMeta" "transient.IEditable" "transient.ITransientCollection"
        "order.IComparable" "data-text.IPrint") :includes role) (protocol? protocol))
      (throw (new globalThis/TypeError "invalid canonical protocol role")))
    (when (and (js-call role-protocols :has role) (not (eq (js-call role-protocols :get role) protocol)))
      (throw (new globalThis/TypeError "canonical protocol role is already registered")))
    (when (and (js-call protocol-roles :has protocol) (not (= (js-call protocol-roles :get protocol) role)))
      (throw (new globalThis/TypeError "protocol already has a canonical role")))
    (js-call protocol-roles :set protocol role) (js-call role-protocols :set role protocol) protocol)
  (defun managed-literal-protocol-role (protocol) (js-call protocol-roles :get protocol))
  (defun managed-literal-protocol-for-role (role) (js-call role-protocols :get role))
  (managed-literal-register-protocol-role "collection.ICounted" I_COUNTED)
  (managed-literal-register-protocol-role "collection.IEmptyable" I_EMPTYABLE)
  (managed-literal-register-protocol-role "collection.IConj" I_CONJ)
  (managed-literal-register-protocol-role "collection.ILookup" I_LOOKUP)
  (managed-literal-register-protocol-role "collection.IAssociative" I_ASSOCIATIVE)
  (managed-literal-register-protocol-role "collection.IIndexed" I_INDEXED)
  (managed-literal-register-protocol-role "collection.ISeqable" I_SEQABLE)
  (managed-literal-register-protocol-role "collection.IReduce" I_REDUCE)
  (managed-literal-register-protocol-role "collection.IKVReduce" I_KV_REDUCE)
  (managed-literal-register-protocol-role "collection.IMap" I_MAP)
  (managed-literal-register-protocol-role "collection.ISet" I_SET)
  (managed-literal-register-protocol-role "collection.IStack" I_STACK)
  (managed-literal-register-protocol-role "collection.IReversible" I_REVERSIBLE)
  (managed-literal-register-protocol-role "value.IEquiv" I_EQUIV)
  (managed-literal-register-protocol-role "value.IHash" I_HASH)
  (managed-literal-register-protocol-role "metadata.IMeta" I_META)
  (managed-literal-register-protocol-role "metadata.IWithMeta" I_WITH_META)
  (managed-literal-register-protocol-role "transient.IEditable" I_EDITABLE)
  (managed-literal-register-protocol-role "transient.ITransientCollection" I_TRANSIENT_COLLECTION)

  (defconst COLLECTION_COUNT (protocol-slot I_COUNTED "count"))
  (defconst COLLECTION_EMPTY (protocol-slot I_EMPTYABLE "empty"))
  (defconst COLLECTION_CONJ (protocol-slot I_CONJ "conj"))
  (defconst COLLECTION_GET (protocol-slot I_LOOKUP "get"))
  (defconst COLLECTION_ASSOC (protocol-slot I_ASSOCIATIVE "assoc"))
  (defconst COLLECTION_CONTAINS (protocol-slot I_ASSOCIATIVE "contains"))
  (defconst COLLECTION_NTH (protocol-slot I_INDEXED "nth"))
  (defconst COLLECTION_SEQ (protocol-slot I_SEQABLE "seq"))
  (defconst COLLECTION_REDUCE (protocol-slot I_REDUCE "reduce"))
  (defconst COLLECTION_REDUCE_KV (protocol-slot I_KV_REDUCE "reduceKV"))
  (defconst COLLECTION_DISSOC (protocol-slot I_MAP "dissoc"))
  (defconst COLLECTION_DISJ (protocol-slot I_SET "disj"))
  (defconst COLLECTION_PEEK (protocol-slot I_STACK "peek"))
  (defconst COLLECTION_POP (protocol-slot I_STACK "pop"))
  (defconst COLLECTION_RSEQ (protocol-slot I_REVERSIBLE "rseq"))
  (defconst VALUE_EQUAL (protocol-slot I_EQUIV "equal"))
  (defconst VALUE_HASH (protocol-slot I_HASH "hash"))
  (defconst METADATA_READ (protocol-slot I_META "meta"))
  (defconst METADATA_WITH (protocol-slot I_WITH_META "withMeta"))
  (defconst EDITABLE_TRANSIENT (protocol-slot I_EDITABLE "transient"))
  (defconst TRANSIENT_CONJ (protocol-slot I_TRANSIENT_COLLECTION "conj!"))
  (defconst TRANSIENT_ASSOC (protocol-slot I_TRANSIENT_COLLECTION "assoc!"))
  (defconst TRANSIENT_DISSOC (protocol-slot I_TRANSIENT_COLLECTION "dissoc!"))
  (defconst TRANSIENT_PERSISTENT (protocol-slot I_TRANSIENT_COLLECTION "persistent!"))
  (defconst PERSISTENT_MAP_KIND (funcall globalThis/Symbol "eliscript.persistent-map.kind"))
  (defconst PERSISTENT_MAP_HAS_VALUE_KEY (funcall globalThis/Symbol "eliscript.persistent-map.has-value-key"))
  (defconst PERSISTENT_SET_KIND (funcall globalThis/Symbol "eliscript.persistent-set.kind"))
  (defconst PERSISTENT_SET_HAS_VALUE (funcall globalThis/Symbol "eliscript.persistent-set.has-value"))
  (defconst reduced-state (funcall globalThis/Symbol "eliscript.collection.reduced-state"))
  (defconst sequence-state (funcall globalThis/Symbol "eliscript.collection.sequence-state"))
  (defconst sequence-token (funcall globalThis/Symbol "eliscript.collection.sequence-token"))
  (defconst unbounded-sequence (funcall globalThis/Symbol "eliscript.collection.unbounded-sequence"))
  (defconst no-initial (funcall globalThis/Symbol "eliscript.collection.no-initial"))
  (defconst registered-constructors (new globalThis/WeakSet))

  (defun managed-literal-protocol-fail (message) (throw (new globalThis/TypeError message)))
  (defun managed-literal-callable? (value) (= (js* "typeof value") "function"))
  (defun managed-literal-vector-type? (type) (or (= type 2) (= type 8)))
  (defun managed-literal-equal-values (left right)
    (cond ((eq left right) t)
      ((and (= (js* "typeof left") "number") (= (js* "typeof right") "number"))
        (or (= left right) (and (not (= left left)) (not (= right right)))))
      ((or (nil? left) (nil? right)
           (and (/= (js* "typeof left") "object") (/= (js* "typeof left") "function"))
           (and (/= (js* "typeof right") "object") (/= (js* "typeof right") "function"))) false)
      (t
        (let ((left-slot (aref left VALUE_EQUAL))
              (right-slot (aref right VALUE_EQUAL)))
          (if (and (= (js* "typeof left-slot") "function")
                   (or (= (js* "typeof right-slot") "function")
                       (implements-protocol-operation? I_EQUIV "equal" right)))
            (eq (js-call left-slot :call left right managed-literal-equal-values) t)
            (if (and (implements-protocol-operation? I_EQUIV "equal" left)
                     (implements-protocol-operation? I_EQUIV "equal" right))
              (eq (funcall (protocol-method I_EQUIV "equal") left right managed-literal-equal-values) t)
              false))))))
  (defun managed-literal-hash-value (value)
    (recordHashValueCall)
    (if (and (not (nil? value))
             (or (= (js* "typeof value") "object") (= (js* "typeof value") "function")))
      (let ((slot (aref value VALUE_HASH)))
        (if (= (js* "typeof slot") "function")
          (cachedProtocolHash value (lambda () (js-call slot :call value managed-literal-hash-value)))
          (if (implements-protocol-operation? I_HASH "hash" value)
            (cachedProtocolHash value (lambda () (funcall (protocol-method I_HASH "hash") value managed-literal-hash-value)))
            (hashPrimitiveValue value))))
      (hashPrimitiveValue value)))
  (defun managed-literal-is-reduced (value)
    (and (not (nullish? value))
         (or (= (js* "typeof value") "object") (= (js* "typeof value") "function"))
         (Object/hasOwn value reduced-state)))
  (defun managed-literal-reduced (value)
    (if (managed-literal-is-reduced value) value
      (let ((result (Object/create nil)))
        (Object/defineProperty result reduced-state (js-object :value value))
        (Object/freeze result))))
  (defun managed-literal-unreduced (value)
    (if (managed-literal-is-reduced value) (aref value reduced-state) value))

  (defun managed-literal-iterator (factory)
    (let ((iterator (funcall factory)))
      (unless (and (not (nil? iterator)) (= (js* "typeof iterator") "object")
                   (managed-literal-callable? (get iterator :next)))
        (managed-literal-protocol-fail "sequence view factory must return an iterator")) iterator))
  (defun managed-literal-checked-count (value)
    (unless (and (Number/isSafeInteger value) (>= value 0))
      (managed-literal-protocol-fail "collection count must be a non-negative safe integer")) value)
  (defun ManagedLiteralSequenceView (token factory count)
    (unless (and (eq token sequence-token) (= (js* "typeof factory") "function"))
      (managed-literal-protocol-fail "SequenceView values must be created by seq"))
    (Object/defineProperty (js* "this") sequence-state
      (js-object :value (Object/freeze (js-object :factory factory :count count)) :enumerable t :writable t :configurable t))
    (Object/freeze (js* "this")))
  (defun managed-literal-sequence-view (factory &optional count)
    (when (undefined? count) (setq count nil))
    (unless (= (js* "typeof factory") "function")
      (managed-literal-protocol-fail "sequence view factory must be a function"))
    (when (and (not (nil? count)) (/= (js* "typeof count") "function"))
      (managed-literal-checked-count count))
    (if (= count 0) nil (new ManagedLiteralSequenceView sequence-token factory count)))
  (defun managed-literal-state-count (state)
    (let ((count (get state :count)))
      (cond ((eq count unbounded-sequence) (throw (new globalThis/RangeError "unbounded sequence does not have a finite count")))
        ((= (js* "typeof count") "function") (managed-literal-checked-count (funcall count)))
        ((not (nil? count)) count)
        (t (let ((iterator (managed-literal-iterator (get state :factory))) (size 0) (done false))
             (while (not done)
               (setq done (funcall globalThis/Boolean (get (js-call iterator :next) :done)))
               (unless done (setq size (managed-literal-checked-count (1+ size))))) size)))))
  (defun managed-literal-sequence-count (receiver)
    (managed-literal-state-count (aref receiver sequence-state)))
  (defun managed-literal-read-sequence-state (receiver) (aref receiver sequence-state))
  (defun managed-literal-shift-sequence-count (state offset prepend)
    (let ((count (get state :count)))
      (cond ((eq count unbounded-sequence) unbounded-sequence)
        ((= (js* "typeof count") "function")
          (if prepend (lambda () (managed-literal-checked-count (1+ (managed-literal-state-count state))))
            (lambda () (Math/max 0 (- (managed-literal-state-count state) offset)))))
        ((nil? count) nil)
        (prepend (managed-literal-checked-count (1+ count)))
        (t (Math/max 0 (- count offset))))))
  (defun managed-literal-sequence-from-count (factory count)
    (if (eq count unbounded-sequence) (managed-literal-unbounded-sequence-view factory)
      (managed-literal-sequence-view factory count)))
  (defun managed-literal-sequence-iterator (receiver)
    (managed-literal-iterator (get (aref receiver sequence-state) :factory)))
  (defun managed-literal-sequence-self (receiver)
    (let ((state (aref receiver sequence-state)))
      (if (eq (get state :count) unbounded-sequence) receiver
      (if (nil? (get state :count))
        (let* ((iterator (managed-literal-iterator (get state :factory))) (next nil))
          (try (setq next (js-call iterator :next)) (if (funcall globalThis/Boolean (get next :done)) nil receiver)
            (finally (when (managed-literal-callable? (get iterator :return)) (js-call iterator :return)))))
        (if (= (managed-literal-sequence-count receiver) 0) nil receiver)))))
  (defun managed-literal-unbounded-sequence-view (factory)
    (unless (= (js* "typeof factory") "function") (managed-literal-protocol-fail "unbounded sequence view factory must be a function"))
    (new ManagedLiteralSequenceView sequence-token factory unbounded-sequence))
  (defun managed-literal-close-iterator (iterator)
    (let ((method (get iterator :return undefined)))
      (unless (nullish? method)
        (unless (= (js* "typeof method") "function") (managed-literal-protocol-fail "iterator return must be callable"))
        (let ((result (js-call method :call iterator)))
          (unless (and (not (nil? result))
                       (or (= (js* "typeof result") "object") (= (js* "typeof result") "function")))
            (managed-literal-protocol-fail "iterator return must return an object"))))))
  (defun managed-literal-reduce-iterable (iterable reducer initial)
    (unless (= (js* "typeof reducer") "function") (managed-literal-protocol-fail "collection reducer must be a function"))
    (let* ((iterator (js-call (aref iterable (get globalThis/Symbol :iterator)) :call iterable))
           (next (get iterator :next)) (accumulator (if (= (js-length initial) 0) no-initial (get initial 0)))
           (complete false) (active false) (stopped false))
      (try
        (while (and (not complete) (not stopped))
          (setq active false)
          (let ((step (js-call next :call iterator)))
            (unless (and (not (nil? step)) (or (= (js* "typeof step") "object") (= (js* "typeof step") "function")))
              (managed-literal-protocol-fail "iterator result must be an object"))
            (if (funcall globalThis/Boolean (get step :done)) (setq complete t)
              (let ((value (get step :value)))
                (setq active t)
                (if (eq accumulator no-initial) (setq accumulator value)
                  (progn (setq accumulator (funcall reducer accumulator value))
                    (when (managed-literal-is-reduced accumulator)
                      (setq accumulator (managed-literal-unreduced accumulator) stopped t))))))))
        (when (eq accumulator no-initial)
          (managed-literal-protocol-fail "cannot reduce an empty collection without an initial value"))
        (when stopped (setq active false) (managed-literal-close-iterator iterator))
        accumulator
        (catch error
          (when (and active (not complete))
            (try (managed-literal-close-iterator iterator) (catch close-error nil)))
          (throw error)))))

  (defun managed-literal-install-slot (prototype slot implementation)
    (let* ((name (str "[" (get slot :description) "]"))
           (method (funcall
             (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
             implementation name)))
      (Object/defineProperty method "length" (js-object :value (Math/max 0 (1- (get implementation :length))) :configurable t))
      (Object/defineProperty prototype slot (js-object :value method :writable t :configurable t))))
  (defun managed-literal-bind (protocol constructor implementations)
    (extend-protocol-type protocol constructor implementations)
    (let ((keys (Object/keys implementations)) (index 0) (prototype (get constructor :prototype)))
      (while (< index (js-length keys))
        (let* ((name (get keys index)) (implementation (get implementations name)))
          (let ((slot (protocol-slot protocol name)))
            (unless (and (or (eq protocol I_EQUIV) (eq protocol I_HASH))
                         (not (Object/hasOwn prototype slot)) (js-call globalThis/Reflect :has prototype slot))
              (managed-literal-install-slot prototype slot implementation))))
        (setq index (1+ index))))
    constructor)
  (managed-literal-install-slot (get ManagedLiteralSequenceView :prototype) (get globalThis/Symbol :iterator) managed-literal-sequence-iterator)
  (Object/defineProperty ManagedLiteralSequenceView "name" (js-object :value "SequenceView" :configurable t))
  (managed-literal-bind I_COUNTED ManagedLiteralSequenceView (js-object :count managed-literal-sequence-count))
  (managed-literal-bind I_SEQABLE ManagedLiteralSequenceView (js-object :seq managed-literal-sequence-self))
  (managed-literal-bind I_REDUCE ManagedLiteralSequenceView
    (js-object :reduce (lambda (receiver reducer &rest initial) (managed-literal-reduce-iterable receiver reducer initial))))
  (Object/defineProperty (get ManagedLiteralSequenceView :prototype) (get globalThis/Symbol :toStringTag)
    (js-object :get (lambda () "EliscriptSequenceView") :configurable t))

  (defun managed-literal-callback (callbacks name)
    (let ((fn (get callbacks name undefined)))
      (unless (managed-literal-callable? fn) (managed-literal-protocol-fail (str "missing persistent callback " name))) fn))
  (defun managed-literal-protocol-type (callbacks value type)
    (unless (= (funcall (managed-literal-callback callbacks "type") value) type)
      (managed-literal-protocol-fail "incompatible persistent collection receiver")) value)
  (defun managed-literal-protocol-array (callbacks value)
    (funcall (managed-literal-callback callbacks "toArray") value))
  (defun managed-literal-ordered-hash (values hash tag)
    (let ((result tag) (index 0))
      (while (< index (js-length values))
        (setq result (mixHash result (funcall hash (get values index))) index (1+ index)))
      (finishHash result index)))
  (defun managed-literal-unordered-hash (values hash map-mode)
    (let ((sum 0) (xor 0) (product 1) (index 0))
      (while (< index (js-length values))
        (let* ((entry (get values index))
               (item (if map-mode (finishHash (mixHash (mixHash 982610667
                            (funcall hash (get entry 0))) (funcall hash (get entry 1))) 2) (funcall hash entry))))
          (setq sum (uint32 (+ sum item)) xor (uint32 (bit-xor xor (rotate-left item (bit-and item 31))))
            product (uint32 (imul32 product (bit-or item 1))) index (1+ index))))
      (finishHash (mixHash (mixHash (mixHash (if map-mode 1821285621 1374139181) sum) xor) product) index)))
  (defun managed-literal-transient (collection)
    (funcall (protocol-method I_EDITABLE "transient") collection))
  (defun managed-literal-conj-bang (collection &rest values)
    (let ((result collection) (index 0))
      (while (< index (js-length values))
        (setq result (funcall (protocol-method I_TRANSIENT_COLLECTION "conj!") result (get values index))
          index (1+ index))) result))
  (defun managed-literal-assoc-bang (&rest arguments)
    (unless (and (>= (js-length arguments) 3) (= (% (- (js-length arguments) 1) 2) 0))
      (managed-literal-protocol-fail "assocBang requires a transient collection followed by one or more key/value pairs"))
    (let ((result (get arguments 0)) (index 1))
      (while (< index (js-length arguments))
        (setq result (funcall (protocol-method I_TRANSIENT_COLLECTION "assoc!") result
          (get arguments index) (get arguments (1+ index))) index (+ index 2))) result))
  (defun managed-literal-dissoc-bang (collection &rest keys)
    (let ((result collection) (index 0))
      (while (< index (js-length keys))
        (setq result (funcall (protocol-method I_TRANSIENT_COLLECTION "dissoc!") result (get keys index))
          index (1+ index))) result))
  (defun managed-literal-persistent-bang (collection)
    (funcall (protocol-method I_TRANSIENT_COLLECTION "persistent!") collection))
  (Object/defineProperty managed-literal-assoc-bang "length" (js-object :value 3 :configurable t))
  (defun managed-literal-register-transients (constructors callbacks)
    (let ((names (js-array "transientVector" "transientMap" "transientSet")) (index 0))
      (while (< index (js-length names))
        (let* ((type (+ index 2)) (constructor (get constructors (get names index) undefined)))
          (unless (or (undefined? constructor) (js-call registered-constructors :has constructor))
            (unless (managed-literal-callable? constructor)
              (managed-literal-protocol-fail "transient protocol registration requires actual constructors"))
            (let* ((checked (lambda (receiver)
                     (unless (= (funcall (managed-literal-callback callbacks "transientType") receiver) type)
                       (managed-literal-protocol-fail "incompatible transient collection receiver")) receiver))
                   (implementations (js-object
                     :conj! (lambda (receiver value) (funcall checked receiver)
                       (funcall (managed-literal-callback callbacks "transientConj") receiver value))
                     :persistent! (lambda (receiver) (funcall checked receiver)
                       (funcall (managed-literal-callback callbacks "transientPersistent") receiver)))))
              (when (or (= type 2) (= type 3))
                (put implementations "assoc!" (lambda (receiver key value) (funcall checked receiver)
                  (funcall (managed-literal-callback callbacks "transientAssoc") receiver key value))))
              (when (or (= type 3) (= type 4))
                (put implementations "dissoc!" (lambda (receiver key) (funcall checked receiver)
                  (funcall (managed-literal-callback callbacks "transientDissoc") receiver key))))
              (managed-literal-bind I_TRANSIENT_COLLECTION constructor implementations))
            (js-call registered-constructors :add constructor)))
        (setq index (1+ index)))))
  (defun managed-literal-register-protocols (constructors callbacks)
    (let ((required (js-array "type" "count" "equal" "hash" "meta" "withMeta" "conj" "assoc" "dissoc" "disj" "peek" "pop" "nth" "get" "toArray")) (index 0))
      (while (< index (js-length required)) (managed-literal-callback callbacks (get required index)) (setq index (1+ index))))
    (let ((types (js-array "list" "vector" "map" "set" "queue" "keyword" "symbol" "subvector")) (index 0))
      (while (< index (js-length types))
        (let* ((type (1+ index)) (constructor (get constructors (get types index) undefined))
               (checked (lambda (value) (managed-literal-protocol-type callbacks value type))))
          (unless (or (undefined? constructor) (js-call registered-constructors :has constructor))
          (unless (= (js* "typeof constructor") "function") (managed-literal-protocol-fail "persistent protocol registration requires actual constructors"))
          (managed-literal-bind I_EQUIV constructor (js-object :equal
            (lambda (receiver other equal)
              (if (managed-literal-vector-type? type)
                (unless (managed-literal-vector-type? (funcall (get callbacks :type) receiver))
                  (managed-literal-protocol-fail "incompatible persistent collection receiver"))
                (funcall checked receiver))
              (cond
                ((or (= type 6) (= type 7)) (funcall (get callbacks :equal) receiver other equal))
                ((= type 3)
                  (and (not (nullish? other)) (eq (aref other PERSISTENT_MAP_KIND) t)
                    (managed-literal-callable? (aref other PERSISTENT_MAP_HAS_VALUE_KEY))
                    (= (get receiver :count) (get other :count))
                    (let ((values (managed-literal-protocol-array callbacks receiver)) (cursor 0) (same t))
                      (while (and same (< cursor (js-length values)))
                        (let* ((entry (get values cursor)) (key (get entry 0)))
                          (setq same (and (funcall globalThis/Boolean (js-call (aref other PERSISTENT_MAP_HAS_VALUE_KEY) :call other key))
                            (funcall globalThis/Boolean (funcall equal (get entry 1) (js-call other :get key))))))
                        (setq cursor (1+ cursor))) same)))
                ((= type 4)
                  (and (not (nullish? other)) (eq (aref other PERSISTENT_SET_KIND) t)
                    (managed-literal-callable? (aref other PERSISTENT_SET_HAS_VALUE))
                    (= (get receiver :count) (get other :count))
                    (let ((values (managed-literal-protocol-array callbacks receiver)) (cursor 0) (same t))
                      (while (and same (< cursor (js-length values)))
                        (setq same (funcall globalThis/Boolean (js-call (aref other PERSISTENT_SET_HAS_VALUE) :call other (get values cursor) equal))
                          cursor (1+ cursor))) same)))
                ((if (managed-literal-vector-type? type)
                   (not (managed-literal-vector-type? (funcall (get callbacks :type) other)))
                   (/= (funcall (get callbacks :type) other) type)) false)
                (t (let ((left (managed-literal-protocol-array callbacks receiver)) (right (managed-literal-protocol-array callbacks other))
                         (cursor 0) (same t))
