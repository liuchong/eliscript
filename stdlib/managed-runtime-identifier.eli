(module eliscript.managed-runtime-identifier
  (import "../../stdlib/managed-literals.eli"
    Keyword EliscriptSymbol literal-keyword literal-symbol literal-ensure-type)

  (literal-ensure-type 6)
  (literal-ensure-type 7)
  (defconst identifier-type (js-call globalThis/Symbol :for "eliscript.value.type"))
  (defun keyword (&rest values) (apply literal-keyword values))
  (defun eliscriptSymbol (&rest values) (apply literal-symbol values))
  (defun logical-identifier-type (value)
    (let ((type (js* "typeof value")))
      (if (or (and (= type "object") (not (nil? value))) (= type "function"))
          (try
            (let ((descriptor (Object/getOwnPropertyDescriptor value identifier-type)))
              (if (and (not (undefined? descriptor)) (Object/hasOwn descriptor "value"))
                  (get descriptor :value) nil))
            (catch error nil))
        nil)))
  (defun isKeyword (value) (= (logical-identifier-type value) "keyword"))
  (defun isEliscriptSymbol (value) (= (logical-identifier-type value) "symbol"))
  (defun isIdentifier (value) (or (isKeyword value) (isEliscriptSymbol value)))
  (defun identifier-fail ()
    (throw (new globalThis/TypeError "expected an Eliscript keyword or symbol")))
  (defun identifierName (value)
    (unless (isIdentifier value) (identifier-fail))
    (let ((name (get value :name)))
      (when (or (not (= (js* "typeof name") "string")) (= (js-length name) 0)
                (js-call name :includes "/"))
        (identifier-fail))
      name))
  (defun identifierNamespace (value)
    (unless (isIdentifier value) (identifier-fail))
    (let ((namespace (get value :namespace)))
      (when (and (not (nil? namespace))
                 (or (not (= (js* "typeof namespace") "string")) (= (js-length namespace) 0)
                     (js-call namespace :includes "/")))
        (identifier-fail))
      namespace))
  (defun qualifiedIdentifierName (value)
    (let ((namespace (identifierNamespace value)) (name (identifierName value)))
      (if (nil? namespace) name (str namespace "/" name))))

  (export Keyword EliscriptSymbol keyword eliscriptSymbol isKeyword isEliscriptSymbol isIdentifier
    identifierName identifierNamespace qualifiedIdentifierName))
