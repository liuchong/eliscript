(module eliscript.diff
  (import "../runtime/core/collection.mjs" :as Collection)
  (import "../runtime/core/map.mjs" EMPTY_MAP)
  (import "../runtime/core/set.mjs" EMPTY_SET)
  (import "../runtime/core/set-algebra.mjs" difference intersection)
  (import "../runtime/core/transient.mjs" assocBang persistentBang transient)
  (import "../runtime/core/value.mjs" equalValues)
  (import "../runtime/core/vector.mjs" PersistentVector persistentVector)

  (defconst diff-missing (js-object))

  (defun sequential-container? (value)
    (and (not (nullish? value))
         (or (Collection/isVector value)
             (Collection/isList value)
             (Array/isArray value))))

  (defun sequential-array (value)
    (if (Array/isArray value)
      value
      (let ((items (js-array)))
        (Collection/reduce value
          (lambda (_acc item) (js-call items :push item) nil)
          nil)
        items)))

  (defun trim-trailing-nils (items)
    (let ((end (js-length items)))
      (while (and (> end 0) (nil? (aref items (1- end))))
        (setq end (1- end)))
      (if (= end 0)
        nil
        (js-call PersistentVector :from
          (if (= end (js-length items)) items (js-call items :slice 0 end))))))

  (defun diff-maps (left right)
    (let ((left-entries (js-array))
          (right-keys (js-array))
          (only-a (transient EMPTY_MAP))
          (only-b (transient EMPTY_MAP))
          (both (transient EMPTY_MAP)))
      (Collection/reduceKV left
        (lambda (_acc key val-a)
          (js-call left-entries :push (js-array key val-a))
          nil)
        nil)
      (Collection/reduceKV right
        (lambda (_acc key val-b)
          (js-call right-keys :push (js-array key val-b))
          nil)
        nil)
      (let ((li 0))
        (while (< li (js-length left-entries))
          (let* ((pair (aref left-entries li))
                 (key (aref pair 0))
                 (val-a (aref pair 1))
                 (val-b (Collection/get right key diff-missing)))
            (if (eq val-b diff-missing)
              (assocBang only-a key val-a)
              (let ((sub (diff val-a val-b)))
                (unless (nil? (js-call sub :nth 0)) (assocBang only-a key (js-call sub :nth 0)))
                (unless (nil? (js-call sub :nth 1)) (assocBang only-b key (js-call sub :nth 1)))
                (unless (nil? (js-call sub :nth 2)) (assocBang both key (js-call sub :nth 2))))))
          (setq li (1+ li))))
      (let ((ri 0))
        (while (< ri (js-length right-keys))
          (let* ((pair (aref right-keys ri))
                 (key (aref pair 0))
                 (val-b (aref pair 1)))
            (unless (Collection/contains left key)
              (assocBang only-b key val-b)))
          (setq ri (1+ ri))))
      (let ((res-a (persistentBang only-a))
            (res-b (persistentBang only-b))
            (res-c (persistentBang both)))
        (persistentVector
          (if (= (Collection/count res-a) 0) nil res-a)
          (if (= (Collection/count res-b) 0) nil res-b)
          (if (= (Collection/count res-c) 0) nil res-c)))))

  (defun diff-sets (left right)
    (let ((only-a (difference left right))
          (only-b (difference right left))
          (both (intersection left right)))
      (persistentVector
        (if (= (Collection/count only-a) 0) nil only-a)
        (if (= (Collection/count only-b) 0) nil only-b)
        (if (= (Collection/count both) 0) nil both))))

  (defun diff-sequentials (left right)
    (let* ((arr-a (sequential-array left))
           (arr-b (sequential-array right))
           (len-a (js-length arr-a))
           (len-b (js-length arr-b))
           (limit (Math/max len-a len-b))
           (out-a (js-array))
           (out-b (js-array))
           (out-c (js-array))
           (index 0))
      (while (< index limit)
        (cond
          ((>= index len-a)
            (js-call out-a :push nil)
            (js-call out-b :push (aref arr-b index))
            (js-call out-c :push nil))
          ((>= index len-b)
            (js-call out-a :push (aref arr-a index))
            (js-call out-b :push nil)
            (js-call out-c :push nil))
          (t
            (let ((sub (diff (aref arr-a index) (aref arr-b index))))
              (js-call out-a :push (js-call sub :nth 0))
              (js-call out-b :push (js-call sub :nth 1))
              (js-call out-c :push (js-call sub :nth 2)))))
        (setq index (1+ index)))
      (persistentVector
        (trim-trailing-nils out-a)
        (trim-trailing-nils out-b)
        (trim-trailing-nils out-c))))

  (defun diff (left right)
    (cond
      ((equalValues left right) (persistentVector nil nil left))
      ((or (nullish? left) (nullish? right))
        (persistentVector
          (if (nullish? left) nil left)
          (if (nullish? right) nil right)
          nil))
      ((and (Collection/isMap left) (Collection/isMap right)) (diff-maps left right))
      ((and (Collection/isSet left) (Collection/isSet right)) (diff-sets left right))
      ((and (sequential-container? left) (sequential-container? right)) (diff-sequentials left right))
      (t (persistentVector left right nil))))

  (export diff))
