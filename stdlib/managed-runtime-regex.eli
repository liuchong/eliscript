(module eliscript.managed-runtime-regex
  (import "./collection.eli" memoizedSequenceView)
  (import "./vector.eli" persistentVector)
  (import "../../stdlib/managed-literals.eli" literal-register-transport)

  (defconst pattern-states (new globalThis/WeakMap))
  (defconst allowed-flags "imsu")

  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun require-arity (actual expected name)
    (unless (= actual expected)
      (fail (str name " requires exactly " expected " "
                 (if (= expected 1) "argument" "arguments")))))
  (defun require-string (value label)
    (unless (= (js* "typeof value") "string") (fail (str label " must be a string"))) value)
  (defun normalize-flags (value)
    (let ((flags (require-string value "regex flags"))
          (seen (new globalThis/Set)) (index 0) (result ""))
      (while (< index (js-length flags))
        (let* ((code (js-call flags :charCodeAt index))
               (width (if (and (>= code 55296) (<= code 56319) (< (1+ index) (js-length flags))
                              (>= (js-call flags :charCodeAt (1+ index)) 56320)
                              (<= (js-call flags :charCodeAt (1+ index)) 57343)) 2 1))
               (flag (js-call flags :slice index (+ index width))))
          (unless (js-call allowed-flags :includes flag)
            (fail (str "regex flags contain unsupported flag: " flag)))
          (when (js-call seen :has flag) (fail (str "regex flags contain duplicate flag: " flag)))
          (js-call seen :add flag)
          (setq index (+ index width))))
      (setq index 0)
      (while (< index (js-length allowed-flags))
        (let ((flag (aref allowed-flags index)))
          (when (js-call seen :has flag) (setq result (str result flag))))
        (setq index (1+ index))) result))
  (defun state-of (pattern)
    (let ((state (js-call pattern-states :get pattern)))
      (when (undefined? state) (fail "operation requires an Eliscript regex pattern")) state))
  (defun native-pattern (pattern &optional global)
    (let ((state (state-of pattern)))
      (new globalThis/RegExp (aref state "source")
           (if global (str (aref state "flags") "g") (aref state "flags")))))
  (defun match-value (match)
    (if (= (js-length match) 1) (aref match 0)
      (let ((values (js-array)) (index 0))
        (while (< index (js-length match))
          (js-call values :push (if (undefined? (aref match index)) nil (aref match index)))
          (setq index (1+ index)))
        (apply persistentVector values))))
  (defun require-start (value)
    (unless (and (Number/isSafeInteger value) (>= value 0))
      (fail "regex start must be a non-negative safe integer")) value)
  (defun advance-string-index (text index unicode)
    (if (or (not unicode) (>= (1+ index) (js-length text))) (1+ index)
      (let ((first (js-call text :charCodeAt index)))
        (if (or (< first 55296) (> first 56319)) (1+ index)
          (let ((second (js-call text :charCodeAt (1+ index))))
            (if (and (>= second 56320) (<= second 57343)) (+ index 2) (1+ index)))))))
  (defun advance-empty-match (matcher text match)
    (when (= (aref match 0) "")
      (put matcher :lastIndex
           (advance-string-index text (aref matcher "lastIndex") (aref matcher "unicode")))))
  (defun scan-iterator (pattern text start)
    ;; A generator acquires its matcher before its first next(), but does not
    ;; execute a match until next() is called. A closed scan stays closed.
    (let ((matcher (native-pattern pattern t)) (closed false) (iterator nil))
      (put matcher :lastIndex start)
      (setq iterator (js-object
        :next (lambda ()
          (if closed (js-object :value undefined :done t)
            (try
              (let ((match (js-call matcher :exec text)))
                (if (nil? match)
                    (progn (setq closed t) (js-object :value undefined :done t))
                  (progn (advance-empty-match matcher text match)
                    (js-object :value (match-value match) :done false))))
              (catch error (setq closed t) (throw error)))))
        :return (lambda (&optional value)
          (setq closed t) (js-object :value value :done t))
        :throw (lambda (&optional error) (setq closed t) (throw error))))
      (Object/defineProperty iterator (aref globalThis/Symbol "iterator")
        (js-object :value (lambda () iterator) :writable t :configurable t))
      iterator))

  (defun compileRegex (&rest arguments)
    (unless (and (>= (js-length arguments) 1) (<= (js-length arguments) 2))
      (fail "compileRegex expects a source and optional flags"))
    (let* ((source (require-string (aref arguments 0) "regex source"))
           (flags (normalize-flags (if (= (js-length arguments) 2) (aref arguments 1) ""))))
      (try (new globalThis/RegExp source flags)
        (catch error (throw (new globalThis/SyntaxError "regex source is invalid"))))
      (let ((pattern (Object/freeze (js-object))))
        (js-call pattern-states :set pattern (Object/freeze (js-object :source source :flags flags)))
        pattern)))
  (defun isRegexPattern (&rest arguments)
    (require-arity (js-length arguments) 1 "isRegexPattern")
    (js-call pattern-states :has (aref arguments 0)))
  (defun regexSource (&rest arguments)
    (require-arity (js-length arguments) 1 "regexSource")
    (aref (state-of (aref arguments 0)) "source"))
  (defun regexFlags (&rest arguments)
    (require-arity (js-length arguments) 1 "regexFlags")
    (aref (state-of (aref arguments 0)) "flags"))
  (defun regexMatches (&rest arguments)
    (require-arity (js-length arguments) 2 "regexMatches")
    (let* ((input (require-string (aref arguments 1) "regex input"))
           (match (js-call (native-pattern (aref arguments 0)) :exec input)))
      (if (and (not (nil? match)) (= (aref match "index") 0) (= (js-length (aref match 0)) (js-length input)))
          (match-value match) nil)))
  (defun regexFind (&rest arguments)
    (unless (and (>= (js-length arguments) 2) (<= (js-length arguments) 3))
      (fail "regexFind expects a pattern, input, and optional start"))
    (let* ((input (require-string (aref arguments 1) "regex input"))
           (start (require-start (if (= (js-length arguments) 3) (aref arguments 2) 0)))
           (matcher (native-pattern (aref arguments 0) t)))
      (put matcher :lastIndex start)
      (let ((match (js-call matcher :exec input))) (if (nil? match) nil (match-value match)))))
  (defun regexSequence (&rest arguments)
    (unless (and (>= (js-length arguments) 2) (<= (js-length arguments) 3))
      (fail "regexSequence expects a pattern, input, and optional start"))
    (let ((pattern (aref arguments 0)))
      (state-of pattern)
      (let ((input (require-string (aref arguments 1) "regex input"))
            (start (require-start (if (= (js-length arguments) 3) (aref arguments 2) 0))))
        (memoizedSequenceView (lambda () (scan-iterator pattern input start))))))
  (defun regexReplace (&rest arguments)
    (require-arity (js-length arguments) 3 "regexReplace")
    (let ((pattern (aref arguments 0)) (replacement (aref arguments 1)))
      (state-of pattern)
      (let ((input (require-string (aref arguments 2) "regex input")))
        (unless (or (= (js* "typeof replacement") "string") (= (js* "typeof replacement") "function"))
          (fail "regex replacement must be a string or function"))
        (let ((matcher (native-pattern pattern t)) (cursor 0) (output "") (done false))
          (while (not done)
            (let ((match (js-call matcher :exec input)))
              (if (nil? match) (setq done t)
                (progn
                  (setq output (str output (js-call input :slice cursor (aref match "index"))))
                  (let ((value (if (= (js* "typeof replacement") "function")
                                   (funcall replacement (match-value match) (aref match "index") input) replacement)))
                    (unless (= (js* "typeof value") "string")
                      (fail "regex replacement function must return a string"))
                    (setq output (str output value)))
                  (setq cursor (+ (aref match "index") (js-length (aref match 0))))
                  (advance-empty-match matcher input match)))))
          (str output (js-call input :slice cursor))))))

  (defun readRegexState (value) (js-call pattern-states :get value))
  (literal-register-transport "regex-pattern" (lambda (value) (js-call pattern-states :has value))
    (lambda (value)
      (let ((state (state-of value)))
        (js-object :kind "regex-pattern" :source (aref state "source") :flags (aref state "flags"))))
    (lambda (description) (compileRegex (aref description "source") (aref description "flags"))))
  (Object/defineProperty isRegexPattern "length" (js-object :value 1 :configurable t))
  (Object/defineProperty regexSource "length" (js-object :value 1 :configurable t))
  (Object/defineProperty regexFlags "length" (js-object :value 1 :configurable t))
  (Object/defineProperty regexMatches "length" (js-object :value 2 :configurable t))
  (Object/defineProperty regexReplace "length" (js-object :value 3 :configurable t))
  (export compileRegex isRegexPattern regexSource regexFlags regexMatches regexFind regexSequence regexReplace readRegexState))
