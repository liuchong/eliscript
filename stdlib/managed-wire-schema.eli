(module eliscript.managed-wire-schema
  (import "./markdown.eli" parse)
  (import "../../stdlib/managed-literal-protocols.eli" managed-literal-reduce-iterable managed-literal-reduced)

  (defconst types (new globalThis/Set (js-array "any" "string" "int" "float" "number" "bool" "null" "date" "datetime")))
  (defconst reserved (new globalThis/Set (js-array "Preamble" "Sections")))
  (defconst date-pattern (js* "/^\\d{4}-\\d{2}-\\d{2}$/u"))
  (defconst datetime-pattern (js* "/^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(?:\\.\\d+)?(?:[Zz]|[+-]\\d{2}:\\d{2})$/u"))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun object? (value) (and (not (nil? value)) (= (js* "typeof value") "object") (not (Array/isArray value))))
  (defun truth (value) (funcall globalThis/Boolean value))
  (defun each (values visit)
    (managed-literal-reduce-iterable values (lambda (ignored value) (funcall visit value) nil) (js-array nil)))
  (defun at (document path)
    (managed-literal-reduce-iterable (js-call path :split ".")
      (lambda (value part)
        (if (and (object? value) (Object/hasOwn value part)) (aref value part)
          (managed-literal-reduced undefined))) (js-array document)))
  (defun copy-row (row)
    (let ((result (js-object)))
      (each (Reflect/ownKeys row) (lambda (key)
        (let ((descriptor (Object/getOwnPropertyDescriptor row key)))
          (when (and (not (undefined? descriptor)) (truth (aref descriptor "enumerable")))
            (Object/defineProperty result key (js-object :value (aref row key) :enumerable t :writable t :configurable t))))))
      result))
  (defun decimal-part (text start end) (funcall globalThis/Number (js-call text :slice start end)))
  (defun valid-date? (value)
    (and (= (js* "typeof value") "string") (= (js-length value) 10) (js-call date-pattern :test value)
      (let* ((year (decimal-part value 0 4)) (month (decimal-part value 5 7)) (day (decimal-part value 8 10))
             (leap (and (= (% year 4) 0) (or (/= (% year 100) 0) (= (% year 400) 0))))
             (days (if (= month 2) (if leap 29 28)
                     (if (js-call (js-array 4 6 9 11) :includes month) 30 31))))
        (and (>= month 1) (<= month 12) (>= day 1) (<= day days)))))
  (defun valid-datetime? (value)
    (and (= (js* "typeof value") "string") (js-call datetime-pattern :test value)
      (valid-date? (js-call value :slice 0 10))
      (let* ((hour (decimal-part value 11 13)) (minute (decimal-part value 14 16)) (second (decimal-part value 17 19))
             (zone-end (1- (js-length value))) (last (aref value zone-end))
             (zulu (or (= last "Z") (= last "z")))
             (zone-start (if zulu zone-end (- (js-length value) 6)))
             (millisecond 0))
        ;; The ISO Date parser keeps the first three fractional second digits;
        ;; subsequent digits do not turn a midnight millisecond into nonzero.
        (when (= (aref value 19) ".")
          (let ((fraction (js-call value :slice 20 zone-start)))
            (setq millisecond (funcall globalThis/Number (js-call (str fraction "000") :slice 0 3)))))
        (and (<= hour 24) (<= minute 59) (<= second 59)
             (or (< hour 24) (and (= minute 0) (= second 0) (= millisecond 0)))
             (or zulu (and (<= (decimal-part value (1+ zone-start) (+ zone-start 3)) 23)
                            (<= (decimal-part value (+ zone-start 4) (+ zone-start 6)) 59)))))))
  (defun typed? (value type)
    (cond ((= type "any") t)
      ((= type "string") (= (js* "typeof value") "string"))
      ((= type "int") (and (Number/isFinite value) (Number/isInteger value)))
      ((or (= type "float") (= type "number")) (and (= (js* "typeof value") "number") (Number/isFinite value)))
      ((= type "bool") (= (js* "typeof value") "boolean"))
      ((= type "null") (nil? value))
      ((= type "date") (valid-date? value))
      ((= type "datetime") (valid-datetime? value))
      (t undefined)))
  (defun validate (data schema)
    (when (= (js* "typeof data") "string") (setq data (parse data)))
    (when (= (js* "typeof schema") "string") (setq schema (parse schema)))
    (unless (and (object? data) (object? schema) (= (aref schema "mds") "0.1"))
      (fail "Expected object data and an MDS/0.1 schema"))
    (each (Object/entries schema) (lambda (entry)
      (let ((name (aref entry 0)) (value (aref entry 1)))
        (when (and (not (js-call reserved :has name)) (object? value))
          (fail "Schema field definition must be a table")))))
    (let* ((definitions (js-call (Object/keys schema) :filter
             (lambda (key &rest ignored) (and (not (js-call reserved :has key)) (Array/isArray (aref schema key))))))
           (fields (new globalThis/Map)) (names (js-call definitions :slice)))
      (when (Object/hasOwn schema "Preamble") (js-call names :push "Preamble"))
      (each names (lambda (name)
        (let ((rows (aref schema name)) (seen (new globalThis/Set)))
          (unless (Array/isArray rows) (fail "Schema field definition must be a table"))
          (js-call fields :set name (js-call rows :map (lambda (row &rest ignored)
            (unless (and (object? row)
                         (let ((name (aref row "name"))) (= (js* "typeof name") "string"))
                         (truth (aref row "name"))
                         (js-call types :has (aref row "type")) (not (js-call seen :has (aref row "name"))))
              (fail "Invalid schema field declaration"))
            (js-call seen :add (aref row "name"))
            (when (and (Object/hasOwn row "required")
                       (let ((required (aref row "required"))) (/= (js* "typeof required") "boolean")))
              (fail "required must be boolean"))
            (each (js-array "min" "max" "min_len" "max_len") (lambda (key)
              (when (and (Object/hasOwn row key)
                (or (let ((value (aref row key))) (/= (js* "typeof value") "number"))
                    (not (Number/isFinite (aref row key)))
                    (and (js-call key :endsWith "_len")
                         (or (not (Number/isInteger (aref row key))) (< (aref row key) 0)))))
                (fail (str "Invalid " key " constraint")))))
            (when (or (and (not (undefined? (aref row "min"))) (not (undefined? (aref row "max")))
                           (> (aref row "min") (aref row "max")))
                      (and (not (undefined? (aref row "min_len"))) (not (undefined? (aref row "max_len")))
                           (> (aref row "min_len") (aref row "max_len")))) (fail "Inverted field bounds"))
            (when (and (Object/hasOwn row "enum")
                       (let ((value (aref row "enum"))) (/= (js* "typeof value") "string"))) (fail "enum must be text"))
            (let ((pattern undefined))
              (when (Object/hasOwn row "pattern")
                (unless (let ((value (aref row "pattern"))) (= (js* "typeof value") "string")) (fail "pattern must be text"))
                (setq pattern (new globalThis/RegExp (aref row "pattern") "u")))
              (let ((result (copy-row row)))
                (Object/defineProperty result "pattern" (js-object :value pattern :enumerable t :writable t :configurable t)) result))))))))
      (let ((declarations undefined) (declared (new globalThis/Map)))
        (if (Object/hasOwn schema "Sections")
            (progn (unless (Array/isArray (aref schema "Sections")) (fail "Sections must be a table"))
              (setq declarations (aref schema "Sections")))
          (setq declarations (js-call definitions :map (lambda (name &rest ignored) (js-object :name name :required t)))))
        (each declarations (lambda (row)
          (unless (and (object? row)
                       (let ((name (aref row "name"))) (= (js* "typeof name") "string"))
                       (truth (aref row "name"))
                       (not (js-call (js-call (aref row "name") :split ".") :some
                              (lambda (part &rest ignored) (not (truth part)))))
                       (not (js-call declared :has (aref row "name")))
                       (let ((kind (aref row "kind")))
                         (js-call (js-array "object" "list" "any") :includes
                           (if (nullish? kind) "any" kind))))
            (fail "Invalid section declaration"))
          (each (js-array "required" "additional") (lambda (key)
            (when (and (Object/hasOwn row key)
                       (let ((value (aref row key))) (/= (js* "typeof value") "boolean"))) (fail (str key " must be boolean")))))
          (each (js-array "min_rows" "max_rows") (lambda (key)
            (when (and (Object/hasOwn row key) (or (not (Number/isSafeInteger (aref row key))) (< (aref row key) 0)))
              (fail (str "Invalid " key " constraint")))))
          (when (and (not (undefined? (aref row "min_rows"))) (not (undefined? (aref row "max_rows")))
                     (> (aref row "min_rows") (aref row "max_rows"))) (fail "Inverted row bounds"))
          (js-call declared :set (aref row "name") row)))
        (let ((errors (js-array)) (error nil) (check-row nil))
          (setq error (lambda (path rule expected actual)
            (js-call errors :push (js-object :path path :rule rule :expected expected :actual actual))))
          (setq check-row (lambda (value rows path &rest optional-arguments)
    (let ((additional (aref optional-arguments 0)))
            (when (undefined? additional) (setq additional t))
            (if (not (object? value)) (funcall error path "kind" "object" value)
              (progn
                (each rows (lambda (row)
                  (let ((field-path (str path "." (aref row "name"))))
                    (if (not (Object/hasOwn value (aref row "name")))
                        (when (truth (aref row "required")) (funcall error field-path "required" t "missing"))
                      (let ((actual (aref value (aref row "name"))))
                        (if (not (truth (typed? actual (aref row "type"))))
                            (funcall error field-path "type" (aref row "type") actual)
                          (progn
                            (when (and (not (undefined? (aref row "enum"))))
                              (unless (js-call (js-call (js-call (aref row "enum") :split ",") :map
                                        (lambda (text &rest ignored) (js-call text :trim))) :includes (funcall globalThis/String actual))
                                (funcall error field-path "enum" (aref row "enum") actual)))
                            (each (js-array "min" "max") (lambda (key)
                              (when (and (= (js* "typeof actual") "number") (not (undefined? (aref row key)))
                                         (if (= key "min") (< actual (aref row key)) (> actual (aref row key))))
                                (funcall error field-path key (aref row key) actual))))
                            (when (= (js* "typeof actual") "string")
                              (let ((length (managed-literal-reduce-iterable actual
                                              (lambda (size ignored) (1+ size)) (js-array 0))))
                                (each (js-array "min_len" "max_len") (lambda (key)
                                  (when (and (not (undefined? (aref row key)))
                                             (if (= key "min_len") (< length (aref row key)) (> length (aref row key))))
                                    (funcall error field-path key (aref row key) length)))))
                              (when (and (truth (aref row "pattern")) (not (js-call (aref row "pattern") :test actual)))
                                (funcall error field-path "pattern" (aref (aref row "pattern") "source") actual))))))))))
                (unless (truth additional)
                  (let ((allowed (new globalThis/Set (js-call rows :map (lambda (row &rest ignored) (aref row "name"))))))
                    (each (Object/keys value) (lambda (key)
                      (when (and (not (js-call allowed :has key))
                                 (or (nil? (aref value key)) (let ((item (aref value key))) (/= (js* "typeof item") "object"))))
                        (funcall error (str path "." key) "additional" false (aref value key))))))))))))
          (when (js-call fields :has "Preamble") (funcall check-row data (js-call fields :get "Preamble") "preamble"))
          (let ((names (new globalThis/Set definitions)))
            (each (js-call declared :keys) (lambda (name) (js-call names :add name)))
            (each names (lambda (name)
              (let* ((raw-policy (js-call declared :get name)) (policy (if (nullish? raw-policy) (js-object) raw-policy))
                     (value (at data name)))
                (if (undefined? value)
                    (when (truth (aref policy "required")) (funcall error name "required" t "missing"))
                  (let ((kind (if (Array/isArray value) "list" (if (object? value) "object" "scalar"))))
                    (if (and (truth (aref policy "kind")) (/= (aref policy "kind") "any") (/= (aref policy "kind") kind))
                        (funcall error name "kind" (aref policy "kind") kind)
                      (if (Array/isArray value)
                          (progn
                            (each (js-array "min_rows" "max_rows") (lambda (key)
                              (when (and (not (undefined? (aref policy key)))
                                         (if (= key "min_rows") (< (js-length value) (aref policy key)) (> (js-length value) (aref policy key))))
                                (funcall error name key (aref policy key) (js-length value)))))
                            (when (js-call fields :has name)
                              (js-call value :forEach (lambda (row index &rest ignored)
                                (funcall check-row row (js-call fields :get name) (str name "[" index "]") (aref policy "additional"))))))
                        (when (js-call fields :has name)
                          (funcall check-row value (js-call fields :get name) name (aref policy "additional")))))))))))
          (js-object :valid (= (js-length errors) 0) :errors errors)))))
  (export validate))
