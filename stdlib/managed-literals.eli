(module eliscript.managed-literals
  (import-portable "./bit.eli" rotate-left)
  (import-portable "./persistent-list.eli"
    empty-persistent-list persistent-list-count persistent-list-empty? persistent-list-cons
    persistent-list-first persistent-list-rest persistent-list-pop persistent-list-nth
    persistent-list-meta persistent-list-with-meta persistent-list-to-array persistent-list-from-array)
  (import-portable "./persistent-vector.eli"
    empty-persistent-vector persistent-vector-count persistent-vector-nth persistent-vector-assoc
    persistent-vector-conj persistent-vector-pop persistent-vector-meta persistent-vector-with-meta
    persistent-vector-reduce persistent-vector-to-array persistent-vector-from-array)
  (import-portable "./persistent-map.eli"
    empty-persistent-map persistent-map-count persistent-map-has? persistent-map-get
    persistent-map-assoc persistent-map-dissoc persistent-map-reduce persistent-map-to-entries
    persistent-map-meta persistent-map-with-meta persistent-map-from-entries)
  (import-portable "./persistent-set.eli"
    empty-persistent-set persistent-set-count persistent-set-has? persistent-set-conj
    persistent-set-disj persistent-set-reduce persistent-set-meta persistent-set-with-meta
    persistent-set-to-array persistent-set-from-array)
  (import-portable "./value.eli" value-hash)
  (import "./managed-literal-protocols.eli" managed-literal-register-protocols managed-literal-hash-value
    managed-literal-protocol-role managed-literal-protocol-for-role)
  (import "./managed-value-state.eli" hashPrimitiveValue)
  (import "./core/protocol.eli" protocol? protocol-definition materialize-protocol-from-definition
    read-protocol-operations-owner read-protocol-method-owner protocol-method)
  (import "./managed-transient-state.eli"
    managed-transient-vector-new managed-transient-vector-conj managed-transient-vector-assoc managed-transient-vector-persistent
    managed-transient-map-new managed-transient-map-assoc managed-transient-map-dissoc managed-transient-map-persistent
    managed-transient-set-new managed-transient-set-conj managed-transient-set-disj managed-transient-set-persistent)
  (import-portable "./managed-vector-view-state.eli"
    managed-vector-view-state? managed-vector-view-state-make managed-vector-view-state-vector
    managed-vector-view-state-start managed-vector-view-state-end managed-vector-view-state-count
    managed-vector-view-state-meta managed-vector-view-state-subvec managed-vector-view-state-with-meta
    managed-vector-view-state-nth managed-vector-view-state-assoc managed-vector-view-state-conj
    managed-vector-view-state-peek managed-vector-view-state-empty managed-vector-view-state-pop
    managed-vector-view-state-to-array)
  (import-portable "./managed-queue-state.eli"
    managed-queue-state-empty managed-queue-state-count managed-queue-state-meta
    managed-queue-state-with-meta managed-queue-state-conj managed-queue-state-peek
    managed-queue-state-pop managed-queue-state-to-array managed-queue-state-from-array)

  ;; The portable tries remain private. Public values are frozen class-shaped
  ;; objects with Symbol state, rather than the portable records' public kind.
  (defconst literal-records (new globalThis/WeakMap))
  (defconst literal-wrappers (new globalThis/WeakMap))
  (defconst literal-node-views (new globalThis/WeakMap))
  (defconst literal-map-root-views (new globalThis/WeakMap))
  (defconst literal-queue-views (new globalThis/WeakMap))
  (defconst literal-subvector-sources (new globalThis/WeakMap))
  (defconst literal-view-states (new globalThis/WeakMap))
  (defconst literal-hashes (new globalThis/WeakMap))
  (defconst literal-iterators (new globalThis/WeakMap))
  (defconst literal-transient-records (new globalThis/WeakMap))
  (defconst literal-editable-results (new globalThis/WeakSet))
  (defconst literal-transient-vector-state (funcall globalThis/Symbol "eliscript.transient-vector.state"))
  (defconst literal-transient-map-state (funcall globalThis/Symbol "eliscript.transient-map.state"))
  (defconst literal-transient-set-state (funcall globalThis/Symbol "eliscript.transient-set.state"))
  (defconst literal-prototypes-ready (js-object))
  (defconst literal-keywords (new globalThis/Map))
  (defconst literal-transports (new globalThis/Map))
  (defconst literal-object-freeze Object/freeze)
  (defconst literal-object-is-frozen Object/isFrozen)
  (defconst literal-object-has-own Object/hasOwn)
  (defconst literal-object-create Object/create)
  (defconst literal-object-get-prototype-of Object/getPrototypeOf)
  (defconst literal-object-get-own-property-descriptor Object/getOwnPropertyDescriptor)
  (defconst literal-object-prototype (get globalThis/Object :prototype))
  (defconst literal-array-is-array Array/isArray)
  (defconst literal-symbol-iterator (get globalThis/Symbol :iterator))
  (defconst literal-symbol-has-instance (get globalThis/Symbol :hasInstance))
  (defconst literal-symbol-to-string-tag (get globalThis/Symbol :toStringTag))
  (defconst literal-data-descriptor
    (let ((descriptor (funcall literal-object-create nil)))
      (put descriptor :value undefined)
      (put descriptor :writable t)
      (put descriptor :enumerable t)
      (put descriptor :configurable t)
      descriptor))
  (defvar literal-has-transients false)
  (defun literal-node-owner (node)
    (if literal-has-transients (get node :owner nil) nil))
  (defconst literal-token (funcall literal-object-freeze (js-object)))
  (defconst literal-missing (funcall globalThis/Symbol "eliscript.collection.missing"))
  (defconst literal-value-type (js-call globalThis/Symbol :for "eliscript.value.type"))
  (defconst literal-list-state (funcall globalThis/Symbol "eliscript.list.state"))
  (defconst literal-vector-state (funcall globalThis/Symbol "eliscript.vector.state"))
  (defconst literal-map-state (funcall globalThis/Symbol "eliscript.map.state"))
  (defconst literal-set-state (funcall globalThis/Symbol "eliscript.set.state"))
  (defconst literal-queue-state (funcall globalThis/Symbol "eliscript.queue.state"))
  (defun literal-make-method (function name)
    (funcall (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, this, args); } })[name]; }") function name))

  (defun literal-fail (message) (throw (new globalThis/TypeError message)))
  (defun literal-range (message) (throw (new globalThis/RangeError message)))
  (defun literal-own-data (target key value)
    (put literal-data-descriptor :value value)
    (Reflect/defineProperty target key literal-data-descriptor)
    (put literal-data-descriptor :value undefined)
    target)
  (defun literal-install-method (prototype key name arity implementation)
    (let ((method (literal-make-method implementation name)))
      (Object/defineProperty method "length" (js-object :value arity :configurable t))
      (Object/defineProperty prototype key (js-object :value method :writable t :configurable t)) method))
  (defun literal-install-getter (prototype key name implementation)
    (let ((method (literal-make-method implementation name)))
      (Object/defineProperty prototype key (js-object :get method :configurable t)) method))
  (defun literal-state-key (type)
    (cond ((= type 1) literal-list-state) ((= type 2) literal-vector-state)
      ((= type 3) literal-map-state) ((= type 4) literal-set-state) (t literal-queue-state)))
  (defun literal-data (receiver type)
    (let* ((view (aref receiver (literal-state-key type)))
           (data (js-call literal-view-states :get view)))
      (if (undefined? data) (literal-fail "incompatible persistent collection receiver") data)))
  (defun literal-record (value) (js-call literal-records :get value))
  (defun literal-type (value)
    (let ((record (literal-record value))) (if (undefined? record) 0 (get record :type))))
  (defun literal-storage-type (value)
    (let ((record (literal-record value))) (if (undefined? record) 0 (get record :type))))
  (defun literal-prototype (type)
    (get (cond ((= type 1) PersistentList) ((= type 2) PersistentVector)
      ((= type 3) PersistentHashMap) ((= type 4) PersistentHashSet) ((= type 5) PersistentQueue)
      ((= type 6) Keyword) (t EliscriptSymbol)) :prototype))
  (defun literal-register (object type data)
    (js-call literal-records :set object (js-object :type type :data data))
    (when (or (<= type 5) (= type 8))
      (js-call literal-wrappers :set data object)
      (js-call literal-view-states :set (aref object (literal-state-key (if (= type 8) 2 type)))
        (if (= type 8) (persistent-vector-with-meta (managed-vector-view-state-vector data)
          (managed-vector-view-state-meta data)) data))) object)

  (defun PersistentList (token count empty value rest &optional metadata)
    (when (not (eq token literal-token))
      (literal-fail "PersistentList values must be created with persistentList or PersistentList.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver literal-list-state
        (funcall literal-object-freeze (js-object :count count :empty empty :value value :rest rest :metadata metadata)))
      (funcall literal-object-freeze receiver)))
  (defun PersistentVector (token count shift root tail &optional metadata)
    (when (not (eq token literal-token))
      (literal-fail "PersistentVector values must be created with persistentVector or PersistentVector.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver literal-vector-state
        (funcall literal-object-freeze (js-object :count count :shift shift :root root :tail tail :metadata metadata)))
      (funcall literal-object-freeze receiver)))
  (defun PersistentHashMap (token count root &optional metadata)
    (when (not (eq token literal-token))
      (literal-fail "PersistentHashMap values must be created with persistentHashMap or PersistentHashMap.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver literal-map-state (funcall literal-object-freeze (js-object :count count :root root :metadata metadata)))
      (funcall literal-object-freeze receiver)))
  (defun PersistentHashSet (token map &optional metadata)
    (when (or (not (eq token literal-token)) (not (= (literal-type map) 3)))
      (literal-fail "PersistentHashSet values must be created with persistentHashSet or PersistentHashSet.from"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver literal-set-state (funcall literal-object-freeze (js-object :map map :metadata metadata)))
      (funcall literal-object-freeze receiver)))
  (defun PersistentQueue (token count front rear &optional metadata)
    (when (not (eq token literal-token))
      (literal-fail "PersistentQueue values must be created with persistentQueue or PersistentQueue.from"))
    (when (or (not (Number/isSafeInteger count)) (< count 0) (> count 2147483647)
              (not (or (= (literal-type front) 2) (= (literal-type front) 8)))
              (not (or (= (literal-type rear) 2) (= (literal-type rear) 8)))
              (not (= (+ (get front :count) (get rear :count)) count))
              (and (> count 0) (= (get front :count) 0)))
      (literal-fail "invalid persistent queue state"))
    (let ((receiver (js* "this")))
      (literal-own-data receiver literal-queue-state
        (funcall literal-object-freeze (js-object :count count :front front :rear rear :metadata metadata)))
      (funcall literal-object-freeze receiver)))
  (defun VectorNode (&optional slots owner)
    (let ((receiver (js* "this")))
      (put receiver :owner owner) (put receiver :slots (if (nil? slots) (js-array) slots))
      (when (nil? owner) (funcall literal-object-freeze (get receiver :slots)) (funcall literal-object-freeze receiver)) receiver))
  (defun MapEntry (key value hash)
    (let ((receiver (js* "this")))
      (put receiver :key key) (put receiver :value value) (put receiver :hash (uint32 hash)) (funcall literal-object-freeze receiver)))
  (defun BitmapIndexedNode (&optional bitmap items owner)
    (let ((receiver (js* "this")))
      (put receiver :bitmap (uint32 (if (nil? bitmap) 0 bitmap))) (put receiver :owner owner)
      (put receiver :items (if (nil? items) (js-array) items))
      (when (nil? owner) (funcall literal-object-freeze (get receiver :items)) (funcall literal-object-freeze receiver)) receiver))
  (defun ArrayNode (count children &optional owner)
    (let ((receiver (js* "this")))
      (put receiver :count count) (put receiver :owner owner) (put receiver :children children)
      (when (nil? owner) (funcall literal-object-freeze children) (funcall literal-object-freeze receiver)) receiver))
  (defun HashCollisionNode (hash entries &optional owner)
    (let ((receiver (js* "this")))
      (put receiver :hash (uint32 hash)) (put receiver :owner owner) (put receiver :entries entries)
      (when (nil? owner) (funcall literal-object-freeze entries) (funcall literal-object-freeze receiver)) receiver))
  (defun literal-vector-node-view (node level)
    (let ((cached (js-call literal-node-views :get node)))
      (if (not (undefined? cached))
        (progn
          (unless (nil? (literal-node-owner node))
            (let ((source (get node :slots)) (slots (get cached :slots)) (index 0))
              (put slots :length (js-length source))
              (while (< index (js-length source))
                (let ((item (get source index)))
                  (if (funcall literal-object-has-own source index)
                    (put slots index (if (and (> level 0) (not (nullish? item)))
                      (literal-vector-node-view item (- level 5)) item))
                    (Reflect/deleteProperty slots index)))
                (setq index (1+ index))))) cached)
        (let* ((slots (get node :slots)) (values (new globalThis/Array (js-length slots))) (index 0))
          (while (< index (js-length slots))
            (let ((value (get slots index)))
              (unless (undefined? value)
                (put values index (if (and (> level 0) (not (nil? value)))
                  (literal-vector-node-view value (- level 5)) value))))
            (setq index (1+ index)))
          (let ((view (new VectorNode values (literal-node-owner node))))
            (js-call literal-node-views :set node view) view)))))
  (defun literal-map-node-view (node)
    (if (nil? node) literal-empty-bitmap
      (let ((cached (js-call literal-node-views :get node)))
        (if (not (undefined? cached))
          (progn
            (unless (or (= (get node :kind) "entry") (nil? (literal-node-owner node)))
              (let* ((kind (get node :kind)) (field (if (= kind "bitmap") "items" (if (= kind "array") "children" "entries")))
                     (source (get node field)) (items (get cached field)) (index 0))
                (put items :length (js-length source))
                (while (< index (js-length source))
                  (let ((child (get source index)))
                    (put items index (if (nullish? child) undefined (literal-map-node-view child))))
                  (setq index (1+ index)))
                (put cached (if (= kind "bitmap") "bitmap" (if (= kind "array") "count" "hash"))
                  (get node (if (= kind "bitmap") "bitmap" (if (= kind "array") "count" "hash")))))) cached)
          (let* ((kind (get node :kind))
                 (view (if (= kind "entry") (new MapEntry (get node :key) (get node :value) (get node :hash))
                   (let* ((source (get node (if (= kind "bitmap") "items" (if (= kind "array") "children" "entries"))))
                          (items (new globalThis/Array (js-length source))) (index 0))
                     (while (< index (js-length source))
                       (let ((child (get source index)))
                         (put items index (if (nil? child) undefined (literal-map-node-view child))))
                       (setq index (1+ index)))
                     (cond ((= kind "bitmap") (new BitmapIndexedNode (get node :bitmap) items (literal-node-owner node)))
                       ((= kind "array") (new ArrayNode (get node :count) items (literal-node-owner node)))
                       (t (new HashCollisionNode (get node :hash) items (literal-node-owner node))))))))
            (js-call literal-node-views :set node view) view)))))
  (defun literal-map-root-view (root)
    (if (nil? root) literal-empty-bitmap
      (if (or (= (get root :kind) "entry") (= (get root :kind) "collision"))
        (let ((child (literal-map-node-view root)) (cached (js-call literal-map-root-views :get root)))
          (if (not (undefined? cached)) cached
            (let ((view (new BitmapIndexedNode (uint32 (bit-shift-left 1 (bit-and (get root :hash) 31)))
              (js-array child) (literal-node-owner root))))
              (js-call literal-map-root-views :set root view) view)))
        (literal-map-node-view root))))

  (defconst literal-empty-bitmap (new BitmapIndexedNode))
  (defconst literal-empty-list-data (empty-persistent-list))
  (defconst literal-empty-vector-data (empty-persistent-vector))
  (defconst literal-empty-map-data (empty-persistent-map literal-hash literal-equal literal-equal))
  (defconst literal-empty-set-data (empty-persistent-set literal-hash literal-equal))
  (defconst literal-empty-queue-data (managed-queue-state-empty))
  (defun literal-data-count (type data)
    (if (= type 4) (persistent-set-count data) (get data :count)))
  (defun literal-canonical-data (type data)
    (if (and (= (literal-data-count type data) 0) (nil? (get data :metadata)))
      (cond ((= type 1) literal-empty-list-data) ((= type 2) literal-empty-vector-data)
        ((= type 3) literal-empty-map-data) ((= type 4) literal-empty-set-data) (t literal-empty-queue-data)) data))
  (defun literal-wrap-list (data)
    (let ((pending (js-array)) (current data) (result undefined))
      (while (undefined? result)
        (setq current (literal-canonical-data 1 current) result (js-call literal-wrappers :get current))
        (when (undefined? result)
          (if (persistent-list-empty? current)
            (setq result (literal-register (new PersistentList literal-token 0 t undefined nil
              (persistent-list-meta current)) 1 current))
            (progn (js-call pending :push current) (setq current (persistent-list-rest current nil))))))
      (while (> (js-length pending) 0)
        (setq current (js-call pending :pop)
          result (literal-register (new PersistentList literal-token (persistent-list-count current) false
            (persistent-list-first current nil) result (persistent-list-meta current)) 1 current))) result))
  (defun literal-wrap (type raw-data)
    (literal-initialize-prototype type)
    (let* ((data (literal-canonical-data type raw-data)) (cached (js-call literal-wrappers :get data)))
      (if (not (undefined? cached)) cached
        (if (= type 1) (literal-wrap-list data)
          (literal-register
            (cond
              ((= type 2) (new PersistentVector literal-token (persistent-vector-count data) (get data :shift)
                (literal-vector-node-view (get data :root) (get data :shift))
                (let ((tail (get data :tail)))
                  (if (js-call literal-editable-results :has data)
                    tail
                    (funcall literal-object-freeze tail))) (persistent-vector-meta data)))
              ((= type 3) (new PersistentHashMap literal-token (persistent-map-count data)
                (literal-map-root-view (get data :root)) (persistent-map-meta data)))
              ((= type 4) (new PersistentHashSet literal-token (literal-wrap 3 (get data :map)) (persistent-set-meta data)))
              (t (let ((view (literal-queue-view data)))
                (new PersistentQueue literal-token (managed-queue-state-count data)
                  (get view :front) (get view :rear) (managed-queue-state-meta data)))))
            type data)))))
  (defun literal-list-to-array-data (data)
    (let ((out (js-array)) (index 0) (current data))
      (while (not (persistent-list-empty? current))
        (put out index (persistent-list-first current nil))
        (setq index (1+ index) current (persistent-list-rest current nil)))
      out))
  (defun literal-queue-view (data)
    (let ((cached (js-call literal-queue-views :get data)))
      (if (not (undefined? cached)) cached
        (let ((view (js-object
          :front (literal-vector-from-array-values (literal-list-to-array-data (get data :front)))
          :rear (literal-vector-from-array-values (js-call (literal-list-to-array-data (get data :rear)) :reverse)))))
          (js-call literal-queue-views :set data view) view))))
  (defun literal-list (&rest values)
    (literal-initialize-prototype 1) (js-call PersistentList :from values))
  (defun literal-vector (&rest values)
    (literal-initialize-prototype 2)
    (when (<= (js-length values) 32) (funcall literal-object-freeze values))
    (literal-vector-from-array-values values))
  (defun literal-map (&rest values)
    (when (/= (% (js-length values) 2) 0) (literal-fail "hash-map expects complete key/value pairs"))
    (let ((entries (js-array)) (index 0) (pair 0))
      (while (< index (js-length values))
        (put entries pair (js-array (get values index) (get values (1+ index))))
        (setq index (+ index 2) pair (1+ pair)))
      (literal-initialize-prototype 3) (js-call PersistentHashMap :from entries)))
  (defun literal-set (&rest values)
    (literal-initialize-prototype 4) (js-call PersistentHashSet :from values))
  (defun literal-queue (&rest values)
    (literal-initialize-prototype 5) (js-call PersistentQueue :from values))

  (defun literal-count (collection)
    (let ((type (literal-type collection)))
      (cond ((or (and (>= type 1) (<= type 5)) (= type 8)) (get collection :count))
        ((nullish? collection) 0)
        ((or (funcall literal-array-is-array collection) (= (js* "typeof collection") "string")) (js-length collection))
        ((or (literal-instance? collection globalThis/Map) (literal-instance? collection globalThis/Set)) (get collection :size))
        ((= (funcall literal-object-get-prototype-of collection) literal-object-prototype) (js-length (Object/keys collection)))
        (t (literal-fail "value does not implement ICounted/count")))))
  (defun literal-instance? (value constructor)
    (cond
      ((or (eq constructor PersistentVector) (eq constructor PersistentList)
           (eq constructor PersistentHashMap) (eq constructor PersistentHashSet)
           (eq constructor PersistentQueue))
        (if (or (nullish? value) (and (/= (js* "typeof value") "object") (/= (js* "typeof value") "function")))
          false
          (let ((type (literal-type value)))
            (if (> type 0)
              (if (eq constructor PersistentVector)
                (or (= type 2) (= type 8))
                (= type (cond ((eq constructor PersistentList) 1) ((eq constructor PersistentHashMap) 3)
                              ((eq constructor PersistentHashSet) 4) (t 5))))
              (if (funcall literal-array-is-array value)
                false
                (js-call (get constructor literal-symbol-has-instance) :call constructor value))))))
      (t (js-call (get constructor literal-symbol-has-instance) :call constructor value))))
  (defun literal-nth (collection index &rest not-found)
    (let ((type (literal-type collection)) (fallback (if (and (> (js-length not-found) 0) (not (undefined? (get not-found 0))))
      (get not-found 0) literal-missing)))
      (if (or (= type 1) (= type 2) (= type 8))
        (if (eq fallback literal-missing) (js-call collection :nth index) (js-call collection :nth index fallback))
        (if (or (Array/isArray collection) (= (js* "typeof collection") "string"))
          (if (and (Number/isInteger index) (>= index 0) (< index (js-length collection))) (get collection index)
            (if (eq fallback literal-missing) (literal-range "nth index is outside collection bounds") fallback))
          (literal-fail "value does not implement IIndexed/nth")))))
  (defun literal-get (collection key &optional not-found)
    (let ((type (literal-type collection)))
      (cond ((= type 3) (js-call collection :get key not-found))
        ((= type 4) (if (js-call collection :has key) key not-found))
        ((or (= type 2) (= type 8)) (js-call collection :nth key not-found))
        ((nullish? collection) not-found)
        ((Array/isArray collection) (if (and (Number/isInteger key) (>= key 0) (< key (js-length collection)))
          (get collection key) not-found))
        (t (let ((result (aref collection key))) (if (undefined? result) not-found result))))))
  ;; A binding's raw key tag is not a property-key coercion. Only values in
  ;; this actual adapter's private registry enter its canonical ILookup; other
  ;; source/foreign values retain the memory runtime's existing lookup path.
  (defun literal-binding-lookup (source key tagged)
    (if (= (literal-type source) 0) nil
      (let* ((actual-key (cond ((= tagged 1) (literal-keyword key))
                              ((= tagged 2) (literal-symbol key)) (t key)))
             (lookup (protocol-method (managed-literal-protocol-for-role "collection.ILookup") "get"))
             (value (funcall lookup source actual-key literal-missing)))
        (js-array value (not (eq value literal-missing))))))
  (defun literal-first (collection &optional not-found)
    (if (nullish? collection) not-found
      (if (= (literal-type collection) 1) (js-call collection :first not-found)
        (literal-fail "first expects a persistent List or nil"))))
  (defun literal-rest (collection)
    (if (nullish? collection) (literal-list-empty)
      (if (= (literal-type collection) 1)
        (js-call collection :rest)
        (literal-fail "rest expects a persistent List or nil"))))
  (defun literal-cons (head tail)
    (let ((list (if (nullish? tail) (literal-list-empty)
      (if (= (literal-type tail) 1) tail (literal-fail "cons expects a persistent List or nil")))))
      (js-call list :cons head)))
  (defun literal-to-array (collection)
    (if (= (literal-storage-type collection) 8)
      (let* ((data (get (literal-record collection) :data)) (source (literal-subvector-source data))
             (index (managed-vector-view-state-start data)) (end (managed-vector-view-state-end data))
             (values (js-array)) (out-index 0))
        (while (< index end)
          (put values out-index (js-call source :nth index))
          (setq index (1+ index) out-index (1+ out-index))) values)
      (let* ((type (literal-type collection)) (data (literal-data collection type)))
        (literal-to-array-data type data))))
  (defun literal-to-array-data (type data)
