(module eliscript.managed-wire-markdown
  (import "../../stdlib/managed-literals.eli" literal-each)
  (defconst number-pattern (js* "/^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/u"))
  (defun object? (value) (and (not (nil? value)) (= (js* "typeof value") "object") (not (Array/isArray value))))
  (defun truth (value) (js* "!!value"))
  (defun own (value key) (Object/hasOwn value key))
  (defun put-data (target key value)
    (Object/defineProperty target key (js-object :value value :writable t :enumerable t :configurable t)))
  (defconst MarkdownError (funcall
    (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
    (lambda (self code line message)
      (let ((error (new globalThis/Error (str code " at line " line ": " message))))
        (Object/setPrototypeOf error (Object/getPrototypeOf self))
        (put error :name "MarkdownError") (put error :code code) (put error :line line) error)) "MarkdownError"))
  (Object/setPrototypeOf MarkdownError globalThis/Error)
  (Object/setPrototypeOf (get MarkdownError :prototype) (get globalThis/Error :prototype))
  (Object/defineProperty MarkdownError "length" (js-object :value 3 :configurable t))
  (defun fail (code line message) (throw (new MarkdownError code line message)))
  (defun scalar (text)
    (cond
      ((and (js-call text :startsWith "\"") (js-call text :endsWith "\"") (>= (js-length text) 2))
        (js-call (js-call text :slice 1 -1) :replace (js* "/\\\\([\"\\\\ntr])/gu")
          (lambda (matched character)
            (let ((value (get (js-object :n "\n" :t "\t" :r "\r") character)))
              (if (nullish? value) character value)))))
      ((js-call number-pattern :test text)
        (let ((value (funcall globalThis/Number text)))
          (unless (Number/isFinite value) (throw (new globalThis/RangeError "Number exceeds finite IEEE 754 range"))) value))
      ((= text "true") t) ((= text "false") false) ((or (= text "null") (= text "")) nil)
      ((= text "{}") (js-object)) ((= text "[]") (js-array)) (t text)))
  (defun cells (text)
    (let ((result (js-array)) (cell "") (index 1))
      (while (< index (1- (js-length text)))
        (let ((character (aref text index)))
          (cond ((and (= character "\\") (= (aref text (1+ index)) "|")) (setq cell (str cell "|") index (1+ index)))
            ((= character "|") (js-call result :push (js-call cell :trim)) (setq cell ""))
            (t (setq cell (str cell character)))))
        (setq index (1+ index))) (js-call result :push (js-call cell :trim)) result))
  (defun leading (raw) (get (js-call raw :match (js* "/^\\s*/u")) 0))
  (defun table-token (lines index text level line)
    (if (or (>= (1+ index) (js-length lines))
      (not (js-call (js-call (aref lines (1+ index)) :trim) :startsWith "|"))
      (not (js-call (js-call (aref lines (1+ index)) :trim) :endsWith "|"))) nil
      (let ((separator (cells (js-call (aref lines (1+ index)) :trim))))
        (if (not (js-call separator :every (lambda (cell) (js-call (js* "/^:?-+:?$/u") :test cell)))) nil
          (progn
            (when (js-call (leading (aref lines (1+ index))) :includes "\t") (fail "MDP-E009" (1+ line) "Tab indentation"))
            (let ((headers (cells text)) (rows (js-array)))
              (when (or (js-call headers :some (lambda (header) (not (truth header))))
                (/= (get (new globalThis/Set headers) :size) (js-length headers))) (fail "MDP-E005" line "Invalid table header"))
              (unless (= (js-length separator) (js-length headers)) (fail "MDP-E004" (1+ line) "Separator width"))
              (setq index (1+ index))
              (while (and (< (1+ index) (js-length lines))
                (js-call (js* "/^\\s*\\|.*\\|\\s*$/u") :test (aref lines (1+ index))))
                (when (js-call (leading (aref lines (1+ index))) :includes "\t") (fail "MDP-E009" (+ index 2) "Tab indentation"))
                (setq index (1+ index))
                (let ((row (cells (js-call (aref lines index) :trim))))
                  (unless (= (js-length row) (js-length headers)) (fail "MDP-E004" (1+ index) "Row width"))
                  (if (= (js-length headers) 1) (js-call rows :push (scalar (aref row 0)))
                    (let ((value (js-object)))
                      (js-call row :forEach (lambda (cell at)
                        (unless (= cell "") (put-data value (aref headers at) (scalar cell)))))
                      (js-call rows :push value)))))
              (js-object :index index :token (js-object :kind "table" :value rows :level level :line line))))))))
  (defun tokenize (source)
    (let ((lines (js-call (js-call source :replace (js* "/^\\uFEFF/u") "") :split (js* "/\\r\\n?|\\n/u")))
          (tokens (js-array)) (fence nil) (html nil) (index 0))
      (while (< index (js-length lines))
        (let* ((raw (aref lines index)) (text (js-call raw :trim)) (line (1+ index)) (handled false))
          (unless (nil? fence)
            (when (js-call (new globalThis/RegExp (str "^ {0,3}" (get fence :char) "{" (get fence :size) ",}\\s*$") "u") :test raw)
              (setq fence nil))
            (setq handled t))
          (when (and (not handled) (not (nil? html)))
            (when (if (= html "blank") (= text "") (js-call html :test raw)) (setq html nil))
            (setq handled t))
          (unless handled
            (let ((fenced (js-call raw :match (js* "/^ {0,3}(`{3,}|~{3,})/u"))))
              (when (truth fenced)
                (setq fence (js-object :char (aref (aref fenced 1) 0) :size (js-length (aref fenced 1))) handled t))))
          (unless handled
            (when (js-call (js* "/^ {0,3}<!--/u") :test raw)
              (unless (js-call raw :includes "-->") (setq html (js* "/-->/u"))) (setq handled t)))
          (unless handled
            (let ((special (js-call raw :match (js* "/^ {0,3}<(script|pre|style|textarea)(?:\\s|>)/iu"))))
              (when (truth special)
                (let ((end (new globalThis/RegExp (str "</" (aref special 1) ">") "iu")))
                  (unless (js-call end :test raw) (setq html end))) (setq handled t))))
          (unless handled
            (when (js-call (js* "/^ {0,3}<\\?/u") :test raw)
              (unless (js-call raw :includes "?>") (setq html (js* "/\\?>/u"))) (setq handled t)))
          (unless handled
            (when (js-call (js* "/^ {0,3}<!\\[CDATA\\[/u") :test raw)
              (unless (js-call raw :includes "]]>") (setq html (js* "/\\]\\]>/u"))) (setq handled t)))
          (unless handled
            (when (js-call (js* "/^ {0,3}<![A-Z]/u") :test raw)
              (unless (js-call raw :includes ">") (setq html (js* "/>/u"))) (setq handled t)))
          (unless handled
            (let ((block-tag (js* "/^ {0,3}<\\/?(?:address|article|aside|base|blockquote|body|caption|center|col|colgroup|dd|details|dialog|dir|div|dl|dt|fieldset|figcaption|figure|footer|form|frame|frameset|h[1-6]|head|header|hr|html|iframe|legend|li|link|main|menu|menuitem|nav|noframes|ol|optgroup|option|p|param|section|source|summary|table|tbody|td|tfoot|th|thead|title|tr|track|ul)(?:\\s|\\/?>)/iu")))
              (when (or (js-call block-tag :test raw)
                (js-call (js* "/^ {0,3}<\\/?[A-Za-z][\\w-]*(?:\\s[^>]*|\\/?)>\\s*$/u") :test raw))
                (setq html "blank" handled t))))
          (unless handled
            (let ((heading (js-call raw :match (js* "/^ {0,3}(#{1,2})(?:[ \\t]+(.*)|$)/u"))))
              (when (truth heading)
                (let ((title (js-call (js-call (if (nullish? (aref heading 2)) "" (aref heading 2)) :replace
                  (js* "/(?:^|\\s+)#+\\s*$/u") "") :trim)))
                  (unless (truth title) (fail "MDP-E007" line "Empty heading"))
                  (js-call tokens :push (js-object :kind "heading" :level (js-length (aref heading 1)) :title title :line line)))
                (setq handled t))))
          (unless handled
            (let* ((field (js-call text :match (js* "/^-\\s+([^]*?):(?: (.*)|\\s*)$/u")))
                   (pipe (and (js-call text :startsWith "|") (js-call text :endsWith "|") (> (js-length text) 1))))
              (when (or (truth field) pipe)
                (let ((indent (leading raw)))
                  (when (js-call indent :includes "\t") (fail "MDP-E009" line "Tab indentation"))
                  (let ((level (Math/floor (/ (js-length indent) 2))))
                    (if (truth field)
                      (js-call tokens :push (js-object :kind "field" :key (js-call (aref field 1) :trim)
                        :text (js-call (if (nullish? (aref field 2)) "" (aref field 2)) :trim) :level level :line line))
                      (let ((table (table-token lines index text level line)))
                        (unless (nil? table)
                          (setq index (get table :index)) (js-call tokens :push (get table :token)))))))))))
        (setq index (1+ index))) tokens))
  (defun option (options key fallback)
    (let ((value (aref options key))) (if (undefined? value) fallback value)))
  (defun parse (source &rest optional-options)
    (let* ((options (if (or (= (js-length optional-options) 0) (undefined? (aref optional-options 0))) (js-object) (aref optional-options 0)))
           (max-length (option options "maxLength" 16777216)) (max-depth (option options "maxDepth" 256)))
      (unless (= (js* "typeof source") "string") (throw (new globalThis/TypeError "Markdown source must be a string")))
      (unless (and (Number/isSafeInteger max-length) (>= max-length 1) (Number/isSafeInteger max-depth) (>= max-depth 0) (<= max-depth 512))
        (throw (new globalThis/RangeError "Invalid parser limits")))
      (when (> (js-length source) max-length) (throw (new globalThis/RangeError "Markdown length limit")))
      (let ((tokens (tokenize source)) (cursor 0) (block nil))
        (setq block (lambda (level root)
          (when (> level max-depth) (throw (new globalThis/RangeError "Markdown depth limit")))
          (let ((value (js-object)) (mode "object") (populated false) (done false))
            (while (and (not done) (< cursor (js-length tokens)))
              (let ((token (aref tokens cursor)))
                (if (or (= (get token :kind) "heading") (< (get token :level) level)) (setq done t)
                  (progn
                    (when (and (> (get token :level) level) (not (and (= (get token :kind) "table") (= level 0) (<= (get token :level) 1))))
                      (fail (if (or (= (get token :kind) "table") (= (get token :key) "")) "MDP-E006" "MDP-E009") (get token :line) "Unattached indentation"))
                    (setq cursor (1+ cursor))
                    (if (= (get token :kind) "table")
                      (progn
                        (when root (fail "MDP-E006" (get token :line) "Root table"))
                        (when populated (fail "MDP-E002" (get token :line) "Mixed contents"))
                        (setq value (get token :value) mode "table" populated t))
                      (let ((element (= (get token :key) "")))
                        (when (and element root) (fail "MDP-E006" (get token :line) "Root element"))
                        (when (or (= mode "table") (and populated (not (eq element (= mode "elements")))))
                          (fail "MDP-E002" (get token :line) "Mixed contents"))
                        (when (and element (not populated)) (setq value (js-array) mode "elements"))
                        (when (and (not element) (own value (get token :key))) (fail "MDP-E003" (get token :line) "Duplicate key"))
                        (let* ((child (scalar (get token :text))) (next (aref tokens cursor)))
                          (when (and (truth next) (not (= (get next :kind) "heading")) (> (get next :level) level))
                            (when (or (/= (get next :level) (1+ level)) (not (= (get token :text) "")))
                              (fail (if (= (get next :kind) "table") "MDP-E006" "MDP-E009") (get next :line) "Child requires a container"))
                            (setq child (funcall block (1+ level) false)))
                          (if element (js-call value :push child) (put-data value (get token :key) child)))
                        (setq populated t))))))) value)))
        (let ((result (funcall block 0 t)) (current nil))
          (while (< cursor (js-length tokens))
            (let ((token (aref tokens cursor)))
              (setq cursor (1+ cursor))
              (if (= (get token :level) 1)
                (progn
                  (when (own result (get token :title)) (fail "MDP-E003" (get token :line) "Duplicate section"))
                  (setq current (funcall block 0 false)) (put-data result (get token :title) current))
                (progn
                  (when (nil? current) (fail "MDP-E001" (get token :line) "Orphan heading"))
                  (when (Array/isArray current) (fail "MDP-E002" (get token :line) "Table with subsection"))
                  (when (own current (get token :title)) (fail "MDP-E003" (get token :line) "Duplicate subsection"))
                  (put-data current (get token :title) (funcall block 0 false))))) ) result))))

  (defun atom (value)
    (cond ((nil? value) "null")
      ((= (js* "typeof value") "string")
        (if (or (= value "") (not (= (js-call value :trim) value)) (js-call (js* "/[\\n\\r\\t]/u") :test value)
          (js-call number-pattern :test value) (js-call (js-array "true" "false" "null" "{}" "[]") :includes value)
          (and (js-call value :startsWith "\"") (js-call value :endsWith "\"")))
          (str "\"" (js-call value :replace (js* "/[\"\\\\\\n\\r\\t]/gu")
            (lambda (character) (get (js-object "\"" "\\\"" "\\" "\\\\" "\n" "\\n" "\r" "\\r" "\t" "\\t") character))) "\"") value))
      ((or (= (js* "typeof value") "boolean") (and (= (js* "typeof value") "number") (Number/isFinite value))) (funcall globalThis/String value))
      ((and (Array/isArray value) (= (js-length value) 0)) "[]")
      ((and (object? value) (js-call (js-array (get globalThis/Object :prototype) nil) :includes (Object/getPrototypeOf value))
        (= (js-length (Object/keys value)) 0)) "{}")
      (t (throw (new globalThis/TypeError "Expected a finite JSON scalar")))))
  (defun leaf (value)
    (or (nil? value) (not (= (js* "typeof value") "object"))
      (if (Array/isArray value) (= (js-length value) 0) (= (js-length (Object/keys value)) 0))))
  (defun key-text (key &optional heading)
    (when (or (not (truth key)) (not (= (js-call key :trim) key)) (js-call (js* "/[\\r\\n\\t]/u") :test key)
      (if heading (js-call (js* "/\\s#+$/u") :test key) (js-call (js* "/: /u") :test key)))
      (throw (new globalThis/TypeError "Unrepresentable Markdown key"))) key)
  (defun append-child (lines prefix child depth body)
    (let* ((push (get lines :push)) (first (funcall prefix)) (tail (funcall body child depth)) (arguments (js-array first)))
      (literal-each tail (lambda (line) (put arguments (js-length arguments) line)))
      (Reflect/apply push lines arguments)))
  (defun encode (value &rest optional-options)
    (let* ((options (if (or (= (js-length optional-options) 0) (undefined? (aref optional-options 0))) (js-object) (aref optional-options 0)))
           (max-depth (option options "maxDepth" 256)) (max-length (option options "maxLength" 16777216)))
      (unless (and (object? value) (js-call (js-array (get globalThis/Object :prototype) nil) :includes (Object/getPrototypeOf value)))
        (throw (new globalThis/TypeError "Markdown document must be a plain object")))
      (unless (and (Number/isSafeInteger max-depth) (>= max-depth 0) (<= max-depth 512) (Number/isSafeInteger max-length) (>= max-length 1))
        (throw (new globalThis/RangeError "Invalid encoder limits")))
      (let ((active (new globalThis/Set)) (body nil))
        (setq body (lambda (data depth)
          (when (> depth max-depth) (throw (new globalThis/RangeError "Markdown depth limit")))
          (when (js-call active :has data) (throw (new globalThis/TypeError "Cyclic Markdown value")))
          (js-call active :add data)
          (let ((pad (js-call "  " :repeat depth)) (lines (js-array)))
            (cond
              ((Array/isArray data)
                (let ((index 0))
                  (while (< index (js-length data))
                    (unless (own data index) (throw (new globalThis/TypeError "Sparse arrays are not JSON values")))
                    (setq index (1+ index))))
                (if (js-call data :every leaf)
                  (progn
                    (setq lines (js-array (str pad "| value |") (str pad "| --- |")))
                    (literal-each (js-call data :map (lambda (item) (str pad "| " (js-call (atom item) :replaceAll "|" "\\|") " |")))
                      (lambda (line) (put lines (js-length lines) line))))
                  (let ((keys (js-array)))
                    (literal-each (new globalThis/Set (js-call data :flatMap (lambda (item) (if (object? item) (Object/keys item) (js-array)))))
                      (lambda (key) (put keys (js-length keys) key)))
                    (if (and (> (js-length keys) 1) (js-call data :every (lambda (item) (and (object? item) (js-call (Object/values item) :every leaf)))))
                      (let ((row (lambda (values) (str pad "| " (js-call values :join " | ") " |")))
                            (cell (lambda (item) (js-call (atom item) :replaceAll "|" "\\|"))))
                        (setq lines (js-array
                          (funcall row (js-call keys :map (lambda (key) (js-call (key-text key) :replaceAll "|" "\\|"))))
                          (funcall row (js-call keys :map (lambda () "---")))))
                        (literal-each (js-call data :map (lambda (item)
                          (funcall row (js-call keys :map (lambda (key) (if (own item key) (funcall cell (aref item key)) ""))))))
                          (lambda (line) (put lines (js-length lines) line))))
                      (literal-each data (lambda (child)
                        (if (leaf child) (js-call lines :push (str pad "- : " (atom child)))
                          (append-child lines (lambda () (str pad "- :")) child (1+ depth) body))))))))
              ((object? data)
                (unless (and (eq (Object/getPrototypeOf data) (get globalThis/Object :prototype))
                  (not (nil? data)))
                  (unless (nil? (Object/getPrototypeOf data)) (throw (new globalThis/TypeError "Expected plain JSON object"))))
                (literal-each (Object/entries data) (lambda (entry)
                  (let ((key (aref entry 0)) (child (aref entry 1)))
                    (if (leaf child) (js-call lines :push (str pad "- " (key-text key) ": " (atom child)))
                      (append-child lines (lambda () (str pad "- " (key-text key) ":")) child (1+ depth) body))))))
              (t (throw (new globalThis/TypeError "Expected JSON container"))))
            (js-call active :delete data) lines)))
        (js-call active :add value)
        (let ((preamble (js-array)) (sections (js-array)))
          (literal-each (Object/entries value) (lambda (entry)
            (let ((key (aref entry 0)) (child (aref entry 1)))
              (if (leaf child) (js-call preamble :push (str "- " (key-text key) ": " (atom child)))
                (js-call sections :push (str "# " (key-text key t) "\n\n" (js-call (funcall body child 0) :join "\n")))))))
          (let ((parts (if (> (js-length preamble) 0) (js-array (js-call preamble :join "\n")) (js-array))))
            (literal-each sections (lambda (section) (put parts (js-length parts) section)))
            (let ((output (str (js-call parts :join "\n\n") "\n")))
              (when (> (js-length output) max-length) (throw (new globalThis/RangeError "Markdown length limit"))) output))))))
  (export MarkdownError parse encode))
