(module eliscript.managed-runtime-data
  (import "../../stdlib/core/data.eli" :as Data)
  (defun indexBy (keyFunction collection) (Data/index-by keyFunction collection))
  (defun groupBy (keyFunction collection) (Data/group-by keyFunction collection))
  (defun countBy (keyFunction collection) (Data/count-by keyFunction collection))
  (defun frequencies (collection) (Data/frequencies collection))
  (defun getIn (collection path &optional notFound) (Data/get-in collection path notFound))
  (defun assocIn (collection path value) (Data/assoc-in collection path value))
  (defun update (collection key transform &rest arguments)
    (apply Data/update (js-call (js-array collection key transform) :concat arguments)))
  (defun updateIn (collection path transform &rest arguments)
    (apply Data/update-in (js-call (js-array collection path transform) :concat arguments)))
  (defun keys (collection) (Data/keys collection))
  (defun vals (collection) (Data/vals collection))
  (defun updateKeys (collection transform) (Data/update-keys collection transform))
  (defun updateVals (collection transform) (Data/update-vals collection transform))
  (defun selectKeys (collection keys) (Data/select-keys collection keys))
  (defun merge (&rest collections) (apply Data/merge collections))
  (defun mergeWith (combine &rest collections)
    (apply Data/merge-with (js-call (js-array combine) :concat collections)))
  (defun zipmap (keys values) (Data/zipmap keys values))
  (export indexBy groupBy countBy frequencies getIn assocIn update updateIn keys vals updateKeys updateVals selectKeys merge mergeWith zipmap))
