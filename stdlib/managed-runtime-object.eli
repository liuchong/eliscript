(module eliscript.managed-runtime-object
  (import "../../stdlib/core/object.eli"
    assoc dissoc filter-values has? key-in? keys map-values merge omit pick update)
  (defun filterValues (predicate object) (filter-values predicate object))
  (defun has (object key) (has? object key))
  (defun keyIn (key key-list) (key-in? key key-list))
  (defun mapValues (function object) (map-values function object))
  (export assoc dissoc filterValues has keyIn keys mapValues merge omit pick update))
