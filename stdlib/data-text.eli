(module eliscript.data-text
  (import-portable "./identifier.eli"
                   identifier-name
                   identifier-namespace
                   keyword
                   qualified-name
                   symbol)
  (import-portable "./metadata.eli" meta with-meta)
  (import-portable "./persistent-list.eli"
                   persistent-list?
                   persistent-list-empty?
                   persistent-list-first
                   persistent-list-from-array
                   persistent-list-rest)
  (import-portable "./persistent-map.eli"
                   persistent-map?
                   persistent-map-assoc
                   persistent-map-has?
                   persistent-map-reduce)
  (import-portable "./persistent-set.eli"
                   persistent-set?
                   persistent-set-conj
                   persistent-set-has?
                   persistent-set-reduce)
  (import-portable "./persistent-vector.eli"
                   persistent-vector?
                   persistent-vector-count
                   persistent-vector-from-array
                   persistent-vector-nth)
  (import-portable "./value.eli"
                   empty-value-map
                   empty-value-set)

  (defconst data-text-default-max-depth 256)
  (defconst data-text-default-max-length 16777216)
  (defconst data-text-default-max-values 1000000)
  (defconst data-text-max-option 2147483647)
  (defconst data-text-hex-digits "0123456789abcdef")

  (defportable data-text-array-reverse (values)
    (let ((result (js-array))
          (index 0))
      (while (< index (js-length values))
        (setq result (cons (get values index) result)
              index (1+ index)))
      result))

  (defportable data-text-slice (start end text)
    (let ((result "")
          (index start))
      (while (< index end)
        (setq result (str result (js-nth index text))
              index (1+ index)))
      result))

  (defportable data-text-option? (value)
    (and (= (value-type value) "number")
         (= value (int32 value))
         (> value 0)
         (<= value data-text-max-option)))

  (defportable data-text-options (options)
    (if (nil? options)
        (object :maxDepth data-text-default-max-depth
                :maxLength data-text-default-max-length
                :maxValues data-text-default-max-values)
      (if (not (= (value-type options) "object"))
          nil
        (let ((max-depth
               (get options "maxDepth" data-text-default-max-depth))
              (max-length
               (get options "maxLength" data-text-default-max-length))
              (max-values
               (get options "maxValues" data-text-default-max-values)))
          (if (and (data-text-option? max-depth)
                   (data-text-option? max-length)
                   (data-text-option? max-values))
              (object :maxDepth max-depth
                      :maxLength max-length
                      :maxValues max-values)
            nil)))))

  (defportable data-text-success (value count index)
    (object :ok t :payload (js-array value) :count count :index index))

  (defportable data-text-result-value (result)
    (aref (get result "payload" (js-array nil)) 0))

  (defportable data-text-position (source offset)
    (let ((index 0)
          (line 1)
          (column 1))
      (while (< index offset)
        (let ((code (string-code-unit-at source index)))
          (if (= code 10)
              (setq line (1+ line) column 1 index (1+ index))
            (if (and (>= code 55296)
                     (<= code 56319)
                     (< (1+ index) offset)
                     (>= (string-code-unit-at source (1+ index)) 56320)
                     (<= (string-code-unit-at source (1+ index)) 57343))
                (setq index (+ index 2) column (1+ column))
              (setq index (1+ index) column (1+ column))))))
      (object :line line :column column)))

  (defportable data-text-failure (source offset message count)
    (let ((position (data-text-position source offset)))
      (object
       :ok false
       :count count
       :index offset
       :error
       (object :code "ELI-DATA-TEXT"
               :message
               (str message " at "
                    (get position "line" 1) ":"
                    (get position "column" 1))
               :offset offset
               :line (get position "line" 1)
               :column (get position "column" 1)
               :sourceLength (js-length source)))))

  (defportable data-text-print-failure (message count)
    (object :ok false
            :count count
            :index 0
            :error (object :code "ELI-DATA-TEXT" :message message)))

  (defportable data-text-digit? (character)
    (and (>= character "0") (<= character "9")))

  (defportable data-text-nonzero-digit? (character)
    (and (>= character "1") (<= character "9")))

  (defportable data-text-number-token? (token)
    (let ((index 0)
          (size (js-length token))
          (valid t))
      (when (and (< index size) (= (js-nth index token) "-"))
        (setq index (1+ index)))
      (if (>= index size)
          (setq valid false)
        (if (= (js-nth index token) "0")
            (setq index (1+ index))
          (if (data-text-nonzero-digit? (js-nth index token))
              (progn
                (setq index (1+ index))
                (while (and (< index size)
                            (data-text-digit? (js-nth index token)))
                  (setq index (1+ index))))
            (setq valid false))))
      (when (and valid (< index size) (= (js-nth index token) "."))
        (setq index (1+ index))
        (if (or (>= index size)
                (not (data-text-digit? (js-nth index token))))
            (setq valid false)
          (while (and (< index size)
                      (data-text-digit? (js-nth index token)))
            (setq index (1+ index)))))
      (when (and valid
                 (< index size)
                 (or (= (js-nth index token) "e")
                     (= (js-nth index token) "E")))
        (setq index (1+ index))
        (when (and (< index size)
                   (or (= (js-nth index token) "+")
                       (= (js-nth index token) "-")))
          (setq index (1+ index)))
        (if (or (>= index size)
                (not (data-text-digit? (js-nth index token))))
            (setq valid false)
          (while (and (< index size)
                      (data-text-digit? (js-nth index token)))
            (setq index (1+ index)))))
      (and valid (= index size))))

  (defportable data-text-bigint-token? (token)
    (let ((size (js-length token)))
      (and (> size 1)
           (= (js-nth (1- size) token) "N")
           (data-text-number-token?
            (data-text-slice 0 (1- size) token))
           (let ((body (data-text-slice 0 (1- size) token)))
             (and (not (data-text-contains? "." body))
                  (not (data-text-contains? "e" body))
                  (not (data-text-contains? "E" body)))))))

  (defportable data-text-contains? (needle text)
    (let ((found false)
          (index 0))
      (while (and (not found) (< index (js-length text)))
        (when (= (js-nth index text) needle)
          (setq found t))
        (setq index (1+ index)))
      found))

  (defportable data-text-reserved-symbol? (text)
    (or (= text "nil")
        (= text "true")
        (= text "false")
        (= text "undefined")
        (= text "##NaN")
        (= text "##Inf")
        (= text "##-Inf")))

  (defportable data-text-whitespace-code? (code)
    (or (and (>= code 9) (<= code 13))
        (= code 32)
        (= code 160)
        (= code 5760)
        (and (>= code 8192) (<= code 8202))
        (= code 8232)
        (= code 8233)
        (= code 8239)
        (= code 8287)
        (= code 12288)
        (= code 65279)))

  (defportable data-text-whitespace? (character)
    (and (not (nil? character))
         (data-text-whitespace-code?
          (string-code-unit-at character 0))))

  (defportable data-text-unsafe-identifier-character? (character)
    (or (data-text-whitespace? character)
        (= character "/")
        (= character "(")
        (= character ")")
        (= character "[")
        (= character "]")
        (= character "{")
        (= character "}")
        (= character "\"")
        (= character "'")
        (= character ";")
        (= character ",")
        (= character "@")
        (= character "^")
        (= character "`")
        (= character "~")
        (= character "\\")))

  (defportable data-text-safe-identifier-part? (text)
    (let ((valid (> (js-length text) 0))
          (index 0))
      (while (and valid (< index (js-length text)))
        (when (data-text-unsafe-identifier-character? (js-nth index text))
          (setq valid false))
        (setq index (1+ index)))
      valid))

  (defportable data-text-safe-identifier? (value symbol-value)
    (let ((namespace (identifier-namespace value))
          (name (identifier-name value))
          (qualified (qualified-name value)))
      (and (data-text-safe-identifier-part? name)
           (or (nil? namespace)
               (data-text-safe-identifier-part? namespace))
           (or (not symbol-value)
               (and (not (data-text-reserved-symbol? qualified))
                    (not (data-text-number-token? qualified))
                    (not (data-text-bigint-token? qualified))
                    (not (= (js-nth 0 qualified) ":"))
                    (not (= (js-nth 0 qualified) "#")))))))

  (defportable data-text-json-string (value)
    (let ((result "\"")
          (index 0))
      (while (< index (js-length value))
        (let ((character (js-nth index value))
              (code (string-code-unit-at value index)))
          (setq result
                (str
                 result
                 (cond
                  ((= character "\"") "\\\"")
                  ((= character "\\") "\\\\")
                  ((= code 8) "\\b")
                  ((= code 9) "\\t")
                  ((= code 10) "\\n")
                  ((= code 12) "\\f")
                  ((= code 13) "\\r")
                  ((< code 32)
                   (str "\\u00"
                        (js-nth (int32 (/ code 16)) data-text-hex-digits)
                        (js-nth (mod code 16) data-text-hex-digits)))
                  (t character)))))
        (setq index (1+ index)))
      (str result "\"")))

  (defportable data-text-tagged-identifier (tag value)
    (let ((namespace (identifier-namespace value)))
      (str "#eliscript/" tag " ["
           (if (nil? namespace)
               "nil"
             (data-text-json-string namespace))
           " " (data-text-json-string (identifier-name value)) "]")))

  (defportable data-text-print-identifier (value symbol-value)
    (if (data-text-safe-identifier? value symbol-value)
        (str (if symbol-value "" ":") (qualified-name value))
      (data-text-tagged-identifier
       (if symbol-value "symbol" "keyword")
       value)))

  (defportable data-text-array-take (values count)
    (let ((result (js-array))
          (index 0))
      (while (< index count)
        (setq result (cons (get values index) result)
              index (1+ index)))
      (data-text-array-reverse result)))

  (defportable data-text-array-drop (values count)
    (let ((result (js-array))
          (index count))
      (while (< index (js-length values))
        (setq result (cons (get values index) result)
              index (1+ index)))
      (data-text-array-reverse result)))

  (defportable data-text-item<=? (left right)
    (let ((left-key (get left "sortKey" ""))
          (right-key (get right "sortKey" ""))
          (left-value (get left "sortValue" ""))
          (right-value (get right "sortValue" "")))
      (or (< left-key right-key)
          (and (= left-key right-key)
               (or (< left-value right-value)
                   (= left-value right-value))))))

  (defportable data-text-merge-items (left right)
    (let ((result (js-array))
          (left-index 0)
          (right-index 0))
      (while (and (< left-index (js-length left))
                  (< right-index (js-length right)))
        (if (data-text-item<=?
             (get left left-index)
             (get right right-index))
            (setq result (cons (get left left-index) result)
                  left-index (1+ left-index))
          (setq result (cons (get right right-index) result)
                right-index (1+ right-index))))
      (while (< left-index (js-length left))
        (setq result (cons (get left left-index) result)
              left-index (1+ left-index)))
      (while (< right-index (js-length right))
        (setq result (cons (get right right-index) result)
              right-index (1+ right-index)))
      (data-text-array-reverse result)))

  (defportable data-text-sort-items (items)
    (if (<= (js-length items) 1)
        items
      (let ((middle (int32 (/ (js-length items) 2))))
        (data-text-merge-items
         (data-text-sort-items (data-text-array-take items middle))
         (data-text-sort-items (data-text-array-drop items middle))))))

  (defportable data-text-join-items (items)
    (let ((result "")
          (index 0))
      (while (< index (js-length items))
        (when (> index 0) (setq result (str result " ")))
        (setq result
              (str result (get (get items index) "text" ""))
              index (1+ index)))
      result))

  (defportable data-text-print-sequential
      (open close value options depth count list-value)
    (let ((items (js-array))
          (state (data-text-success "" count 0)))
      (if list-value
          (let ((node value))
            (while (and (get state "ok" false)
                        (not (persistent-list-empty? node)))
              (let ((printed
                     (data-text-print-node
                      (persistent-list-first node nil)
                      options
                      (1+ depth)
                      (get state "count" count))))
                (setq state printed)
                (when (get printed "ok" false)
                  (setq items
                        (cons
                         (object :text (data-text-result-value printed))
                         items))))
              (setq node (persistent-list-rest node nil))))
        (let ((index 0)
              (size (persistent-vector-count value)))
          (while (and (get state "ok" false) (< index size))
            (let ((printed
                   (data-text-print-node
                    (persistent-vector-nth value index nil)
                    options
                    (1+ depth)
                    (get state "count" count))))
              (setq state printed)
              (when (get printed "ok" false)
                (setq items
                      (cons
                       (object :text (data-text-result-value printed))
                       items))))
            (setq index (1+ index)))))
      (if (not (get state "ok" false))
          state
        (data-text-success
         (str open
              (data-text-join-items (data-text-array-reverse items))
              close)
         (get state "count" count)
         0))))

  (defportable data-text-print-map (value options depth count)
    (let ((state
           (persistent-map-reduce
            (lambda (current key item-value)
              (if (not (get current "ok" false))
                  current
                (let ((key-result
                       (data-text-print-node
                        key options (1+ depth)
                        (get current "count" count))))
                  (if (not (get key-result "ok" false))
                      key-result
                    (let ((value-result
                           (data-text-print-node
                            item-value options (1+ depth)
                            (get key-result "count" count))))
                      (if (not (get value-result "ok" false))
                          value-result
                        (let ((key-text
                               (data-text-result-value key-result))
                              (value-text
                               (data-text-result-value value-result)))
                          (object
                           :ok t
                           :payload (js-array "")
                           :count (get value-result "count" count)
                           :index 0
                           :items
                           (cons
                            (object :sortKey key-text
                                    :sortValue value-text
                                    :text (str key-text " " value-text))
                            (get current "items" (js-array)))))))))))
            (object :ok t :payload (js-array "") :count count :index 0 :items (js-array))
            value)))
      (if (not (get state "ok" false))
          state
        (data-text-success
         (str "{"
              (data-text-join-items
               (data-text-sort-items (get state "items" (js-array))))
              "}")
         (get state "count" count)
         0))))

  (defportable data-text-print-set (value options depth count)
    (let ((state
           (persistent-set-reduce
            (lambda (current item-value)
              (if (not (get current "ok" false))
                  current
                (let ((printed
                       (data-text-print-node
                        item-value options (1+ depth)
                        (get current "count" count))))
                  (if (not (get printed "ok" false))
                      printed
                    (let ((text (data-text-result-value printed)))
                      (object
                       :ok t
                       :payload (js-array "")
                       :count (get printed "count" count)
                       :index 0
                       :items
                       (cons (object :sortKey text
                                     :sortValue ""
                                     :text text)
                             (get current "items" (js-array)))))))))
            (object :ok t :payload (js-array "") :count count :index 0 :items (js-array))
            value)))
      (if (not (get state "ok" false))
          state
        (data-text-success
         (str "#{"
              (data-text-join-items
               (data-text-sort-items (get state "items" (js-array))))
              "}")
         (get state "count" count)
         0))))

  (defportable data-text-print-body (value options depth count)
    (let ((type (value-type value)))
      (cond
       ((= type "null") (data-text-success "nil" count 0))
       ((= type "undefined") (data-text-success "undefined" count 0))
       ((= type "boolean")
        (data-text-success (if value "true" "false") count 0))
       ((= type "number")
        (data-text-success
         (cond
          ((not (= value value)) "##NaN")
          ((= value (/ 1 0)) "##Inf")
          ((= value (- (/ 1 0))) "##-Inf")
          (t (str value)))
         count 0))
       ((= type "bigint") (data-text-success (str value "N") count 0))
       ((= type "string")
        (data-text-success (data-text-json-string value) count 0))
       ((= type "keyword")
        (data-text-success (data-text-print-identifier value false) count 0))
       ((= type "symbol")
        (data-text-success (data-text-print-identifier value t) count 0))
       ((persistent-list? value)
        (data-text-print-sequential "(" ")" value options depth count t))
       ((persistent-vector? value)
        (data-text-print-sequential "[" "]" value options depth count false))
       ((persistent-map? value)
        (data-text-print-map value options depth count))
       ((persistent-set? value)
        (data-text-print-set value options depth count))
       (t
        (data-text-print-failure
         (str "unsupported data text value " type)
         count)))))

  (defportable data-text-print-node (value options depth count)
    (if (> depth (get options "maxDepth" data-text-default-max-depth))
        (data-text-print-failure
         (str "data text exceeds maxDepth "
              (get options "maxDepth" data-text-default-max-depth))
         count)
      (let ((next-count (1+ count)))
        (if (> next-count
               (get options "maxValues" data-text-default-max-values))
            (data-text-print-failure
             (str "data text exceeds maxValues "
                  (get options "maxValues" data-text-default-max-values))
             next-count)
          (let* ((metadata (meta value))
                 (metadata-result
                  (if (nil? metadata)
                      (data-text-success "" next-count 0)
                    (data-text-print-node
                     metadata options (1+ depth) next-count))))
            (if (not (get metadata-result "ok" false))
                metadata-result
              (let ((body-result
                     (data-text-print-body
                      value options depth
                      (get metadata-result "count" next-count))))
                (if (not (get body-result "ok" false))
                    body-result
                  (let ((text
                         (if (nil? metadata)
                             (data-text-result-value body-result)
                           (str "^"
                                (data-text-result-value metadata-result)
                                " "
                                (data-text-result-value body-result)))))
                    (if (> (js-length text)
                           (get options "maxLength"
                                data-text-default-max-length))
                        (data-text-print-failure
                         (str "data text exceeds maxLength "
                              (get options "maxLength"
                                   data-text-default-max-length))
                         (get body-result "count" next-count))
                      (data-text-success
                       text (get body-result "count" next-count) 0)))))))))))

  (defportable print-value (value &optional options)
    (let ((normalized (data-text-options options)))
      (if (nil? normalized)
          (data-text-print-failure "invalid data text options" 0)
        (data-text-print-node value normalized 0 0))))

  (defportable data-text-skip-ignored (source start)
    (let ((index start)
          (again t))
      (while again
        (setq again false)
        (while (and (< index (js-length source))
                    (or (= (js-nth index source) ",")
                        (data-text-whitespace? (js-nth index source))))
          (setq index (1+ index)))
        (when (and (< index (js-length source))
                   (= (js-nth index source) ";"))
          (setq again t index (1+ index))
          (while (and (< index (js-length source))
                      (not (= (js-nth index source) "\n")))
            (setq index (1+ index)))))
      index))

  (defportable data-text-delimiter? (character)
    (or (nil? character)
        (data-text-whitespace? character)
        (= character ",")
        (= character "(")
        (= character ")")
        (= character "[")
        (= character "]")
        (= character "{")
        (= character "}")
        (= character "\"")
        (= character ";")
        (= character "^")))

  (defportable data-text-token (source start count)
    (let ((index start))
      (while (and (< index (js-length source))
                  (not (data-text-delimiter? (js-nth index source))))
        (setq index (1+ index)))
      (if (= index start)
          (data-text-failure source start "expected token" count)
        (data-text-success
         (data-text-slice start index source)
         count
         index))))

  (defportable data-text-hex-value (character)
    (cond
     ((and (>= character "0") (<= character "9"))
      (- (string-code-unit-at character 0) 48))
     ((and (>= character "a") (<= character "f"))
      (- (string-code-unit-at character 0) 87))
     ((and (>= character "A") (<= character "F"))
      (- (string-code-unit-at character 0) 55))
     (t -1)))

  (defportable data-text-read-string (source start count)
    (let ((index (1+ start))
          (result "")
          (done false)
          (failure nil))
      (while (and (not done) (nil? failure) (< index (js-length source)))
        (let ((character (js-nth index source))
              (code (string-code-unit-at source index)))
          (cond
           ((= character "\"")
            (setq done t index (1+ index)))
           ((< code 32)
            (setq failure
                  (data-text-failure
                   source index "unescaped control character in string" count)))
           ((= character "\\")
            (if (>= (1+ index) (js-length source))
                (setq failure
                      (data-text-failure
                       source start "unexpected end of string" count))
              (let ((escape (js-nth (1+ index) source)))
                (cond
                 ((= escape "\"")
                  (setq result (str result "\"") index (+ index 2)))
                 ((= escape "\\")
                  (setq result (str result "\\") index (+ index 2)))
                 ((= escape "/")
                  (setq result (str result "/") index (+ index 2)))
                 ((= escape "b")
                  (setq result (str result (string-from-code-unit 8))
                        index (+ index 2)))
                 ((= escape "f")
                  (setq result (str result (string-from-code-unit 12))
                        index (+ index 2)))
                 ((= escape "n")
                  (setq result (str result "\n") index (+ index 2)))
                 ((= escape "r")
                  (setq result (str result "\r") index (+ index 2)))
                 ((= escape "t")
                  (setq result (str result "\t") index (+ index 2)))
                 ((= escape "u")
                  (if (> (+ index 6) (js-length source))
                      (setq failure
                            (data-text-failure
                             source index "incomplete Unicode escape" count))
                    (let ((digit-index (+ index 2))
                          (limit (+ index 6))
                          (value 0)
                          (valid t))
                      (while (and valid (< digit-index limit))
                        (let ((digit
                               (data-text-hex-value
                                (js-nth digit-index source))))
                          (if (< digit 0)
                              (setq valid false)
                            (setq value (+ (* value 16) digit)
                                  digit-index (1+ digit-index)))))
                      (if (not valid)
                          (setq failure
                                (data-text-failure
                                 source index "invalid Unicode escape" count))
                        (setq result
                              (str result (string-from-code-unit value))
                              index limit)))))
                 (t
                  (setq failure
                        (data-text-failure
                         source index "invalid string escape" count)))))))
           (t
            (setq result (str result character) index (1+ index))))))
      (cond
       ((not (nil? failure)) failure)
       ((not done)
        (data-text-failure source start "unexpected end of string" count))
       (t (data-text-success result count index)))))

  (defportable data-text-read-sequential
      (source options depth count start close list-value)
    (let ((index (1+ start))
          (items (js-array))
          (current-count count)
          (failure nil)
          (done false))
      (while (and (nil? failure) (not done))
        (setq index (data-text-skip-ignored source index))
        (cond
         ((>= index (js-length source))
          (setq failure
                (data-text-failure
                 source start
                 (if list-value
                     "unexpected end of list"
                   "unexpected end of vector")
                 current-count)))
         ((= (js-nth index source) close)
          (setq done t index (1+ index)))
         (t
          (let ((item
                 (data-text-read-node
                  source options (1+ depth) current-count index)))
            (if (not (get item "ok" false))
                (setq failure item)
              (setq items (cons (data-text-result-value item) items)
                    current-count (get item "count" current-count)
                    index (get item "index" index)))))))
      (if (not (nil? failure))
          failure
        (let ((values (data-text-array-reverse items)))
          (data-text-success
           (if list-value
               (persistent-list-from-array values)
             (persistent-vector-from-array values))
           current-count
           index)))))

  (defportable data-text-read-map
      (source options depth count start)
    (let ((index (1+ start))
          (result (empty-value-map))
          (current-count count)
          (failure nil)
          (done false))
      (while (and (nil? failure) (not done))
        (setq index (data-text-skip-ignored source index))
        (cond
         ((>= index (js-length source))
          (setq failure
                (data-text-failure
                 source start "unexpected end of map" current-count)))
         ((= (js-nth index source) "}")
          (setq done t index (1+ index)))
         (t
          (let* ((key-start index)
                 (key-result
                  (data-text-read-node
                   source options (1+ depth) current-count index)))
            (if (not (get key-result "ok" false))
                (setq failure key-result)
              (let* ((key (data-text-result-value key-result))
                     (value-index
                      (data-text-skip-ignored
                       source (get key-result "index" index))))
                (if (or (>= value-index (js-length source))
                        (= (js-nth value-index source) "}"))
                    (setq failure
                          (data-text-failure
                           source key-start
                           "map requires a value for every key"
                           (get key-result "count" current-count)))
                  (let ((value-result
                         (data-text-read-node
                          source options (1+ depth)
                          (get key-result "count" current-count)
                          value-index)))
                    (if (not (get value-result "ok" false))
                        (setq failure value-result)
                      (if (persistent-map-has? result key)
                          (setq failure
                                (data-text-failure
                                 source key-start "duplicate map key"
                                 (get value-result "count" current-count)))
                        (setq result
                              (persistent-map-assoc
                               result key (data-text-result-value value-result))
                              current-count
                              (get value-result "count" current-count)
                              index (get value-result "index" value-index))))))))))))
      (if (not (nil? failure))
          failure
        (data-text-success result current-count index))))

  (defportable data-text-read-set
      (source options depth count start)
    (let ((index (+ start 2))
          (result (empty-value-set))
          (current-count count)
          (failure nil)
          (done false))
      (while (and (nil? failure) (not done))
        (setq index (data-text-skip-ignored source index))
        (cond
         ((>= index (js-length source))
          (setq failure
                (data-text-failure
                 source start "unexpected end of set" current-count)))
         ((= (js-nth index source) "}")
          (setq done t index (1+ index)))
         (t
          (let* ((item-start index)
                 (item-result
                  (data-text-read-node
                   source options (1+ depth) current-count index)))
            (if (not (get item-result "ok" false))
                (setq failure item-result)
              (let ((value (data-text-result-value item-result)))
                (if (persistent-set-has? result value)
                    (setq failure
                          (data-text-failure
                           source item-start "duplicate set value"
                           (get item-result "count" current-count)))
                  (setq result (persistent-set-conj result value)
                        current-count (get item-result "count" current-count)
                        index (get item-result "index" index)))))))))
      (if (not (nil? failure))
          failure
        (data-text-success result current-count index))))

  (defportable data-text-read-tagged-identifier
      (source options depth count start index tag)
    (let ((payload
           (data-text-read-node source options (1+ depth) count index)))
      (if (not (get payload "ok" false))
          payload
        (let ((value (data-text-result-value payload)))
          (if (not (and (persistent-vector? value)
                        (= (persistent-vector-count value) 2)))
              (data-text-failure
               source start
               (str tag " tag requires [namespace name]")
               (get payload "count" count))
            (let ((namespace (persistent-vector-nth value 0 nil))
                  (name (persistent-vector-nth value 1 nil)))
              (if (not (and (or (nil? namespace)
                                (= (value-type namespace) "string"))
                            (= (value-type name) "string")))
                  (data-text-failure
                   source start
                   (str tag
                        " tag requires a nil/string namespace and string name")
                   (get payload "count" count))
                (let ((identifier
                       (if (= tag "keyword")
                           (keyword namespace name)
                         (symbol namespace name))))
                  (if (nil? identifier)
                      (data-text-failure
                       source start "invalid tagged identifier"
                       (get payload "count" count))
                    (data-text-success
                     identifier
                     (get payload "count" count)
                     (get payload "index" index)))))))))))

  (defportable data-text-read-dispatch
      (source options depth count start)
    (if (and (< (1+ start) (js-length source))
             (= (js-nth (1+ start) source) "{"))
        (data-text-read-set source options depth count start)
      (let ((token-result (data-text-token source start count)))
        (if (not (get token-result "ok" false))
            token-result
          (let ((token (data-text-result-value token-result))
                (index
                 (data-text-skip-ignored
                  source (get token-result "index" start))))
            (cond
             ((= token "##NaN")
              (data-text-success (/ 0 0) count
                                 (get token-result "index" start)))
             ((= token "##Inf")
              (data-text-success (/ 1 0) count
                                 (get token-result "index" start)))
             ((= token "##-Inf")
              (data-text-success (- (/ 1 0)) count
                                 (get token-result "index" start)))
             ((= token "#eliscript/keyword")
              (data-text-read-tagged-identifier
               source options depth count start index "keyword"))
             ((= token "#eliscript/symbol")
              (data-text-read-tagged-identifier
               source options depth count start index "symbol"))
             (t
              (data-text-failure
               source start (str "unknown dispatch " token) count))))))))

  (defportable data-text-read-atom (source start count)
    (let ((token-result (data-text-token source start count)))
      (if (not (get token-result "ok" false))
          token-result
        (let ((token (data-text-result-value token-result))
              (index (get token-result "index" start)))
          (cond
           ((= token "nil") (data-text-success nil count index))
           ((= token "true") (data-text-success t count index))
           ((= token "false") (data-text-success false count index))
           ((= token "undefined")
            (data-text-success (aref (js-array undefined) 0) count index))
           ((data-text-bigint-token? token)
            (let ((value
                   (string-to-bigint
                    (data-text-slice 0 (1- (js-length token)) token))))
              (if (nil? value)
                  (data-text-failure source start "invalid BigInt" count)
                (data-text-success value count index))))
           ((data-text-number-token? token)
            (data-text-success (string-to-number token) count index))
           ((= (js-nth 0 token) ":")
            (let ((value
                   (keyword (data-text-slice 1 (js-length token) token))))
              (if (nil? value)
                  (data-text-failure source start "invalid keyword" count)
                (data-text-success value count index))))
           (t
            (let ((value (symbol token)))
              (if (nil? value)
                  (data-text-failure source start "invalid symbol" count)
                (data-text-success value count index)))))))))

  (defportable data-text-read-metadata
      (source options depth count start)
    (let ((metadata-result
           (data-text-read-node
            source options (1+ depth) count (1+ start))))
      (if (not (get metadata-result "ok" false))
          metadata-result
        (let ((metadata (data-text-result-value metadata-result)))
          (if (not (persistent-map? metadata))
              (data-text-failure
               source start "metadata prefix requires a persistent map"
               (get metadata-result "count" count))
            (let ((value-result
                   (data-text-read-node
                    source options (1+ depth)
                    (get metadata-result "count" count)
                    (get metadata-result "index" (1+ start)))))
              (if (not (get value-result "ok" false))
                  value-result
                (let ((annotated
                       (with-meta
                        (data-text-result-value value-result)
                        metadata)))
                  (if (nil? annotated)
                      (data-text-failure
                       source start "value does not support metadata"
                       (get value-result "count" count))
                    (data-text-success
                     annotated
                     (get value-result "count" count)
                     (get value-result "index" start)))))))))))

  (defportable data-text-read-node
      (source options depth count start)
    (let ((index (data-text-skip-ignored source start)))
      (cond
       ((> depth (get options "maxDepth" data-text-default-max-depth))
        (data-text-failure
         source index
         (str "data text exceeds maxDepth "
              (get options "maxDepth" data-text-default-max-depth))
         count))
       ((>= (1+ count)
            (1+ (get options "maxValues" data-text-default-max-values)))
        (data-text-failure
         source index
         (str "data text exceeds maxValues "
              (get options "maxValues" data-text-default-max-values))
         (1+ count)))
       ((>= index (js-length source))
        (data-text-failure source index "unexpected end of input" count))
       (t
        (let ((next-count (1+ count))
              (character (js-nth index source)))
          (cond
           ((= character "\"")
            (data-text-read-string source index next-count))
           ((= character "(")
            (data-text-read-sequential
             source options depth next-count index ")" t))
           ((= character "[")
            (data-text-read-sequential
             source options depth next-count index "]" false))
           ((= character "{")
            (data-text-read-map source options depth next-count index))
           ((= character "#")
            (data-text-read-dispatch
             source options depth next-count index))
           ((= character "^")
            (data-text-read-metadata
             source options depth next-count index))
           ((or (= character ")")
                (= character "]")
                (= character "}"))
            (data-text-failure
             source index
             (str "unexpected closing delimiter " character)
             next-count))
           (t (data-text-read-atom source index next-count))))))))

  (defportable read-value (source &optional options)
    (let ((normalized (data-text-options options)))
      (cond
       ((not (= (value-type source) "string"))
        (data-text-failure "" 0 "data text source must be a string" 0))
       ((nil? normalized)
        (data-text-failure source 0 "invalid data text options" 0))
       ((> (js-length source)
           (get normalized "maxLength" data-text-default-max-length))
        (data-text-failure
         source 0
         (str "data text exceeds maxLength "
              (get normalized "maxLength" data-text-default-max-length))
         0))
       (t
        (let ((result (data-text-read-node source normalized 0 0 0)))
          (if (not (get result "ok" false))
              result
            (let ((index
                   (data-text-skip-ignored
                    source (get result "index" 0))))
              (if (= index (js-length source))
                  (data-text-success
                   (data-text-result-value result)
                   (get result "count" 0)
                   index)
                (data-text-failure
                 source index "trailing data after value"
                 (get result "count" 0))))))))))

  (defportable read-values (source &optional options)
    (let ((normalized (data-text-options options)))
      (cond
       ((not (= (value-type source) "string"))
        (data-text-failure "" 0 "data text source must be a string" 0))
       ((nil? normalized)
        (data-text-failure source 0 "invalid data text options" 0))
       ((> (js-length source)
           (get normalized "maxLength" data-text-default-max-length))
        (data-text-failure
         source 0
         (str "data text exceeds maxLength "
              (get normalized "maxLength" data-text-default-max-length))
         0))
       (t
        (let ((index (data-text-skip-ignored source 0))
              (count 0)
              (values (js-array))
              (failure nil))
          (while (and (nil? failure) (< index (js-length source)))
            (let ((result
                   (data-text-read-node source normalized 0 count index)))
              (if (not (get result "ok" false))
                  (setq failure result)
                (setq values
                      (cons (data-text-result-value result) values)
                      count (get result "count" count)
                      index
                      (data-text-skip-ignored
                       source (get result "index" index))))))
          (if (not (nil? failure))
              failure
            (data-text-success
             (persistent-vector-from-array
              (data-text-array-reverse values))
             count
             index)))))))

  (export data-text-result-value print-value read-value read-values))
