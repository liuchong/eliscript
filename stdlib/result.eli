(module eliscript.result
  (import-portable "./persistent-map.eli"
                   persistent-map-assoc
                   persistent-map-count
                   persistent-map-get
                   persistent-map?)
  (import-portable "./persistent-vector.eli"
                   empty-persistent-vector
                   persistent-vector-conj
                   persistent-vector-count
                   persistent-vector-nth
                   persistent-vector?)
  (import-portable "./value.eli" value-map-from-entries)

  (defconst result-kind-key "kind")
  (defconst result-status-key "status")
  (defconst result-payload-key "payload")
  (defconst result-kind "eliscript/result")
  (defconst result-ok-status "ok")
  (defconst result-error-status "error")
  (defconst result-missing (js-object))
  (defconst result-ok-base
    (value-map-from-entries
     (js-array (js-array result-kind-key result-kind)
      (js-array result-status-key result-ok-status))))
  (defconst result-err-base
    (value-map-from-entries
     (js-array (js-array result-kind-key result-kind)
      (js-array result-status-key result-error-status))))

  (defportable ok (value)
    (persistent-map-assoc result-ok-base result-payload-key value))

  (defportable err (error)
    (persistent-map-assoc result-err-base result-payload-key error))

  (defportable result-status-fast (value)
    (if (and (persistent-map? value)
             (= (persistent-map-count value) 3)
             (= (persistent-map-get value result-kind-key result-missing) result-kind))
        (let ((status (persistent-map-get value result-status-key result-missing)))
          (if (and (or (= status result-ok-status)
                       (= status result-error-status))
                   (/= (persistent-map-get value result-payload-key result-missing)
                       result-missing))
              status
            nil))
      nil))

  (defportable result? (value)
    (not (nil? (result-status-fast value))))

  (defportable ok? (result)
    (= (result-status-fast result) result-ok-status))

  (defportable err? (result)
    (= (result-status-fast result) result-error-status))

  (defportable result-payload (result)
    (if (result? result)
        (persistent-map-get result result-payload-key nil)
      nil))

  (defportable map-ok (function result)
    (if (ok? result)
        (ok (funcall function (persistent-map-get result result-payload-key nil)))
      result))

  (defportable map-err (function result)
    (if (err? result)
        (err (funcall function (persistent-map-get result result-payload-key nil)))
      result))

  (defportable and-then (function result)
    (if (ok? result)
        (funcall function (persistent-map-get result result-payload-key nil))
      result))

  (defportable or-else (function result)
    (if (err? result)
        (funcall function (persistent-map-get result result-payload-key nil))
      result))

  (defportable fold (ok-function error-function result)
    (let ((status (result-status-fast result)))
      (if (= status result-ok-status)
          (funcall ok-function (persistent-map-get result result-payload-key nil))
        (if (= status result-error-status)
            (funcall error-function (persistent-map-get result result-payload-key nil))
          nil))))

  (defportable unwrap-or (fallback result)
    (if (ok? result)
        (persistent-map-get result result-payload-key nil)
      fallback))

  (defportable unwrap-or-else (function result)
    (let ((status (result-status-fast result)))
      (if (= status result-ok-status)
          (persistent-map-get result result-payload-key nil)
        (if (= status result-error-status)
            (funcall function (persistent-map-get result result-payload-key nil))
          (funcall function nil)))))

  (defportable collect-results (results)
    (if (not (persistent-vector? results))
      nil
      (let ((values (empty-persistent-vector))
            (failure nil)
            (failed false)
            (index 0)
            (total (persistent-vector-count results)))
        (while (and (not failed)
                    (< index total))
          (let ((result (persistent-vector-nth results index nil)))
            (if (ok? result)
                (setq values
                      (persistent-vector-conj
                       values (persistent-map-get result result-payload-key nil)))
              (setq failure result
                    failed t)))
          (setq index (1+ index)))
        (if failed failure (ok values)))))

  (defportable traverse-results (function values)
    (if (not (persistent-vector? values))
      nil
      (let ((results (empty-persistent-vector))
            (failure nil)
            (failed false)
            (index 0)
            (total (persistent-vector-count values)))
        (while (and (not failed)
                    (< index total))
          (let ((result
                 (funcall
                  function
                  (persistent-vector-nth values index nil))))
            (if (ok? result)
                (setq results
                      (persistent-vector-conj
                       results (persistent-map-get result result-payload-key nil)))
              (setq failure result
                    failed t)))
          (setq index (1+ index)))
        (if failed failure (ok results)))))

  (export and-then collect-results err err? fold map-err map-ok ok ok?
          or-else result-payload result? traverse-results unwrap-or
          unwrap-or-else))
