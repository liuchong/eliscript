(module eliscript.core.protocol
  (import "../../runtime/core/protocol-error.mjs" ProtocolDispatchError)

  (defconst protocol-states (new globalThis/WeakMap))
  (defconst protocol-operation-owners (new globalThis/WeakMap))
  (defconst protocol-method-owners (new globalThis/WeakMap))
  (defconst protocol-missing
    (funcall globalThis/Symbol "eliscript.protocol.missing"))
  (defconst protocol-host-categories
    (js-array "null" "undefined" "boolean" "number" "bigint" "string"
     "symbol" "function" "object"))
  (defconst protocol-definition-format "eliscript-protocol-definition")
  (defconst protocol-definition-version 1)
  (defconst protocol-max-operations 1024)

  ;; These capabilities isolate host reflection from dispatch policy. They are
  ;; deliberately private and contain no protocol-specific decisions.
  (defconst protocol-symbol
    (lambda (description) (funcall globalThis/Symbol description)))
  (defconst protocol-array? (js* "Array.isArray"))
  (defconst protocol-map (lambda () (new globalThis/Map)))
  (defconst protocol-null-object
    (lambda () (js-call globalThis/Object :create nil)))
  (defconst protocol-own-descriptors
    (js* "Object.getOwnPropertyDescriptors"))
  (defconst protocol-own-keys (js* "Reflect.ownKeys"))
  (defconst protocol-has-own
    (lambda (value key)
      (js-call (aref (aref globalThis/Object "prototype") "hasOwnProperty")
               :call value key)))
  (defconst protocol-property-present
    (lambda (value key)
      (if (or (nil? value) (undefined? value))
          false
        (js-call globalThis/Reflect :has (funcall globalThis/Object value) key))))
  (defconst protocol-property-value
    (lambda (value key) (aref (funcall globalThis/Object value) key)))
  (defconst protocol-host-type (lambda (value) (js* "typeof value")))
  (defconst protocol-exact-prototype
    (lambda (value missing)
      (if (or (and (= (js* "typeof value") "object") (not (nil? value)))
              (= (js* "typeof value") "function"))
          (js-call globalThis/Object :getPrototypeOf value)
        missing)))
  (defconst protocol-object-prototype (js* "Object.prototype"))
  (defconst protocol-get-prototype (js* "Object.getPrototypeOf"))
  (defconst protocol-freeze (js* "Object.freeze"))
  (defconst protocol-define-enumerable
    (lambda (target key value)
      (js-call globalThis/Object :defineProperty target key
               (js-object :value value :enumerable t))
      target))
  (defconst protocol-define-metadata
    (lambda (target protocol operation slot)
      (js-call globalThis/Object :defineProperties target
               (js-object :protocol (js-object :value protocol)
                          :operation (js-object :value operation)
                          :slot (js-object :value slot)))
      target))

  (defun protocol-fail (message)
    (throw (new globalThis/TypeError message)))

  (defun protocol-state (protocol)
    (let ((state (js-call protocol-states :get protocol)))
      (if (undefined? state)
          (protocol-fail "expected an Eliscript protocol")
        state)))

  (defun normalize-name (value label)
    (if (or (not (= (value-type value) "string"))
            (= (js-length value) 0))
        (protocol-fail (str label " must be a non-empty string"))
      value))

  (defun normalize-protocol-operations (operations)
    (when (not (funcall protocol-array? operations))
      (protocol-fail "protocol operations must be a non-empty dense array"))
    (let ((length (js-length operations)))
      (when (= length 0)
        (protocol-fail "protocol operations must be a non-empty dense array"))
      (when (> length protocol-max-operations)
        (protocol-fail
         (str "protocol operations exceed " protocol-max-operations)))
      (let* ((descriptors (funcall protocol-own-descriptors operations))
             (keys (funcall protocol-own-keys descriptors))
             (normalized (js-array))
             (index 0))
        ;; A dense Array has one own descriptor per item plus "length". This
        ;; also rejects Symbol keys and named side-channel properties.
        (when (/= (js-length keys) (1+ length))
          (protocol-fail
           "protocol operations must be a dense array with no extra properties"))
        (while (< index length)
          (let ((descriptor (get descriptors (str index) undefined)))
            (when (or (undefined? descriptor)
                      (not (funcall protocol-has-own descriptor "value"))
                      (not (get descriptor :enumerable false)))
              (protocol-fail
               "protocol operations must contain enumerable data values"))
            (js-call normalized :push
                     (normalize-name (get descriptor :value)
                                     "protocol operation")))
          (setq index (1+ index)))
        normalized)))

  (defun protocol-definition-field (descriptors name)
    (let ((descriptor (get descriptors name undefined)))
      (when (or (undefined? descriptor)
                (not (funcall protocol-has-own descriptor "value"))
                (not (get descriptor :enumerable false)))
        (protocol-fail
         (str "protocol definition field " name
              " must be an enumerable data property")))
      (get descriptor :value)))

  (defun normalize-protocol-definition (definition)
    (when (or (nil? definition)
              (not (= (value-type definition) "object"))
              (funcall protocol-array? definition))
      (protocol-fail "protocol definition must be a plain object"))
    (let ((prototype (funcall protocol-get-prototype definition)))
      (when (and (/= prototype protocol-object-prototype)
                 (not (nil? prototype)))
        (protocol-fail "protocol definition must be a plain object")))
    (let* ((descriptors (funcall protocol-own-descriptors definition))
           (keys (funcall protocol-own-keys descriptors)))
      (when (/= (js-length keys) 4)
        (protocol-fail
         "protocol definition must contain exactly format, version, name, and operations"))
      (let ((format (protocol-definition-field descriptors "format"))
            (version (protocol-definition-field descriptors "version"))
            (name (protocol-definition-field descriptors "name"))
            (operations (protocol-definition-field descriptors "operations")))
        (when (/= format protocol-definition-format)
          (protocol-fail (str "unsupported protocol definition format " format)))
        (when (/= version protocol-definition-version)
          (protocol-fail (str "unsupported protocol definition version " version)))
        (js-object :name (normalize-name name "protocol name")
                :operations (normalize-protocol-operations operations)))))

  (defun operation-record (protocol operation)
    (let* ((state (protocol-state protocol))
           (record (js-call (get state :operations) :get operation)))
      (if (undefined? record)
          (protocol-fail
           (str "protocol " (get protocol :name) " has no operation " operation))
        record)))

  (defun protocol-host-category (value)
    (if (nil? value) "null" (funcall protocol-host-type value)))

  (defun known-host-category? (category)
    (let ((index 0)
          (found false))
      (while (and (< index (js-length protocol-host-categories)) (not found))
        (when (= category (js-nth index protocol-host-categories))
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun normalize-implementations (protocol implementations)
    (when (or (nil? implementations)
              (not (= (value-type implementations) "object")))
      (protocol-fail
       (str "protocol " (get protocol :name)
            " implementations must be an object")))
    (let* ((descriptors (funcall protocol-own-descriptors implementations))
           (keys (funcall protocol-own-keys descriptors))
           (normalized (funcall protocol-null-object))
           (index 0))
      (when (= (js-length keys) 0)
        (protocol-fail
         (str "protocol " (get protocol :name)
              " extension must implement at least one operation")))
      (while (< index (js-length keys))
        (let* ((key (js-nth index keys))
               (descriptor (get descriptors key)))
          (when (not (= (value-type key) "string"))
            (protocol-fail
             (str "protocol " (get protocol :name)
                  " implementation names must be strings")))
          (operation-record protocol key)
          (when (or (not (funcall protocol-has-own descriptor "value"))
                    (not (= (value-type (get descriptor :value)) "function")))
            (protocol-fail
             (str "protocol " (get protocol :name) "/" key
                  " implementation must be a function")))
          (funcall protocol-define-enumerable
                   normalized key (get descriptor :value)))
        (setq index (1+ index)))
      (funcall protocol-freeze normalized)))

  (defun merge-implementations (current incoming)
    (let ((merged (funcall protocol-null-object))
          (copy nil))
      (setq copy
            (lambda (source)
              (unless (nullish? source)
                (let ((keys (object-keys source))
                      (index 0))
                  (while (< index (js-length keys))
                    (let ((key (js-nth index keys)))
                      (funcall protocol-define-enumerable
                               merged key (get source key)))
                    (setq index (1+ index)))))))
      (funcall copy current)
      (funcall copy incoming)
      (funcall protocol-freeze merged)))

  (defun direct-method (record receiver)
    (if (or (nil? receiver) (undefined? receiver))
        protocol-missing
      (let ((slot (get record :slot)))
        (if (not (funcall protocol-property-present receiver slot))
            protocol-missing
          (let ((method (funcall protocol-property-value receiver slot)))
            (if (= (value-type method) "function") method nil))))))

  (defun external-method (state record receiver)
    (let* ((prototype
            (funcall protocol-exact-prototype receiver protocol-missing))
           (exact-implementations
            (if (= prototype protocol-missing)
                undefined
              (js-call (get state :types) :get prototype)))
           (exact
            (if (undefined? exact-implementations)
                undefined
              (get exact-implementations (get record :name) undefined))))
      (if (not (undefined? exact))
          exact
        (let* ((category-implementations
                (js-call (get state :categories) :get
                         (protocol-host-category receiver)))
               (category
                (if (undefined? category-implementations)
                    undefined
                  (get category-implementations
                       (get record :name) undefined))))
          (if (not (undefined? category))
              category
            (get (get state :defaults)
                 (get record :name) protocol-missing))))))

  (defun dispatch (protocol record receiver arguments)
    (let ((direct (direct-method record receiver)))
      (when (nil? direct)
        (throw
         (new ProtocolDispatchError
              protocol (get record :name) receiver "invalid-direct-slot")))
      (if (/= direct protocol-missing)
          (js-call direct :apply receiver arguments)
        (let ((external
               (external-method (protocol-state protocol) record receiver)))
          (if (= external protocol-missing)
              (throw
               (new ProtocolDispatchError protocol (get record :name) receiver))
            (apply external (js-cons receiver arguments)))))))

  (defun make-protocol-with-slots (name operations slots)
    (let ((protocol-name (normalize-name name "protocol name"))
          (protocol-operations (normalize-protocol-operations operations)))
      (let ((records (funcall protocol-map))
            (operation-table (funcall protocol-null-object))
            (protocol nil)
            (index 0))
        (while (< index (js-length protocol-operations))
          (let ((operation
                 (js-nth index protocol-operations)))
            (when (js-call records :has operation)
              (protocol-fail
               (str "protocol " protocol-name
                    " declares duplicate operation " operation)))
            (let* ((slot
                    (if (nil? slots)
                        (funcall protocol-symbol
                                 (str "eliscript.protocol." protocol-name "/" operation))
                      (get slots index)))
                   (method
                    (lambda (&rest invocation)
                      (when (= (js-length invocation) 0)
                        (protocol-fail
                         (str "protocol " protocol-name "/" operation
                              " requires a dispatch value")))
                      (dispatch protocol
                                (js-call records :get operation)
                                (aref invocation 0)
                                (js-call invocation :slice 1))))
                   (record
                    (js-object :name operation :slot slot :method method)))
              (js-call records :set operation record)
              (funcall protocol-define-enumerable
                       operation-table operation method)))
          (setq index (1+ index)))

        (setq protocol
              (funcall protocol-freeze
                       (js-object :name protocol-name
                               :operations
                               (funcall protocol-freeze operation-table))))
        (js-call protocol-operation-owners :set operation-table protocol)
        (setq index 0)
        (while (< index (js-length protocol-operations))
          (let* ((operation (js-nth index protocol-operations))
                 (record (js-call records :get operation))
                 (method (get record :method)))
            (funcall protocol-define-metadata
                     method protocol operation (get record :slot))
            (js-call protocol-method-owners :set method
                     (funcall protocol-freeze
                              (js-object :protocol protocol :operation operation)))
            (funcall protocol-freeze method)
            (funcall protocol-freeze record))
          (setq index (1+ index)))

        (js-call protocol-states :set protocol
                 (js-object :operations records
                         :types (funcall protocol-map)
                         :categories (funcall protocol-map)
                         :defaults
                         (funcall protocol-freeze
                                  (funcall protocol-null-object))))
        protocol)))

  (defun define-protocol (name operations)
    (make-protocol-with-slots name operations nil))

  (defun protocol-definition (protocol)
    (protocol-state protocol)
    (let ((operations
           (js-call (object-keys (get protocol :operations)) :slice)))
      (funcall protocol-freeze operations)
      (funcall protocol-freeze
               (js-object :format protocol-definition-format
                       :version protocol-definition-version
                       :name (get protocol :name)
                       :operations operations))))

  (defun define-protocol-from-definition (definition)
    (let ((normalized (normalize-protocol-definition definition)))
      (define-protocol (get normalized :name)
                       (get normalized :operations))))

  ;; Bulk materialization reuses already transported Symbols, so observing a
  ;; slot before its protocol does not create two identities for one slot.
  (defun materialize-protocol-from-definition (definition slots)
    (let* ((normalized (normalize-protocol-definition definition))
           (operations (get normalized :operations)))
      (unless (and (funcall protocol-array? slots) (= (js-length slots) (js-length operations)))
        (protocol-fail "protocol slots must be a dense array matching its operations"))
      (let* ((descriptors (funcall protocol-own-descriptors slots))
             (keys (funcall protocol-own-keys descriptors))
             (seen (new globalThis/Set)) (symbols (js-array)) (index 0))
        (unless (= (js-length keys) (1+ (js-length slots)))
          (protocol-fail "protocol slots must be a dense array with no extra properties"))
        (while (< index (js-length slots))
          (let* ((descriptor (get descriptors (str index) undefined))
                 (value (if (undefined? descriptor) undefined (get descriptor :value))))
            (unless (and (not (undefined? descriptor))
                         (funcall protocol-has-own descriptor "value")
                         (get descriptor :enumerable false)
                         (= (funcall protocol-host-type value) "symbol"))
              (protocol-fail "protocol slots must contain enumerable Symbol data values"))
            (when (js-call seen :has value) (protocol-fail "protocol slots must be distinct Symbols"))
            (js-call seen :add value) (js-call symbols :push value))
          (setq index (1+ index)))
        (make-protocol-with-slots (get normalized :name) operations symbols))))

  (defun protocol-method (protocol operation)
    (get (operation-record protocol operation) :method))

  (defun protocol-slot (protocol operation)
    (get (operation-record protocol operation) :slot))

  (defun extend-protocol-type (protocol constructor implementations)
    (let ((state (protocol-state protocol)))
      (when (not (= (value-type constructor) "function"))
        (protocol-fail
         (str "protocol " (get protocol :name)
              " exact type must be a constructor with a prototype")))
      (let ((prototype (get constructor :prototype nil)))
        (when (or (nil? prototype)
                  (not (= (value-type prototype) "object")))
          (protocol-fail
           (str "protocol " (get protocol :name)
                " exact type must be a constructor with a prototype")))
        (let* ((normalized
                (normalize-implementations protocol implementations))
               (current (js-call (get state :types) :get prototype)))
          (js-call (get state :types) :set prototype
                   (merge-implementations current normalized)))
        protocol)))

  (defun extend-protocol-category (protocol category implementations)
    (let ((state (protocol-state protocol)))
      (when (not (known-host-category? category))
        (protocol-fail (str "unknown protocol host category " category)))
      (let* ((normalized
              (normalize-implementations protocol implementations))
             (current (js-call (get state :categories) :get category)))
        (js-call (get state :categories) :set category
                 (merge-implementations current normalized)))
      protocol))

  (defun extend-protocol-default (protocol implementations)
    (let* ((state (protocol-state protocol))
           (normalized (normalize-implementations protocol implementations)))
      (put state :defaults
           (merge-implementations (get state :defaults) normalized))
      protocol))

  (defun implements-protocol-operation? (protocol operation value)
    (let* ((record (operation-record protocol operation))
           (direct (direct-method record value)))
      (and (not (nil? direct))
           (or (/= direct protocol-missing)
               (/= (external-method (protocol-state protocol) record value)
                   protocol-missing)))))

  (defun implements-protocol? (protocol value)
    (let* ((state (protocol-state protocol))
           (operations (object-keys (get protocol :operations)))
           (index 0)
           (implemented t))
      (while (and (< index (js-length operations)) implemented)
        (let* ((record
                (js-call (get state :operations) :get (js-nth index operations)))
               (direct (direct-method record value)))
          (when (or (nil? direct)
                    (and (= direct protocol-missing)
                         (= (external-method state record value)
                            protocol-missing)))
            (setq implemented false)))
        (setq index (1+ index)))
      implemented))

  (defun protocol? (value) (js-call protocol-states :has value))

  (defun read-protocol-operations-owner (value)
    (js-call protocol-operation-owners :get value))

  (defun read-protocol-method-owner (value)
    (js-call protocol-method-owners :get value))

  (export protocol? define-protocol define-protocol-from-definition materialize-protocol-from-definition
          read-protocol-operations-owner read-protocol-method-owner
          extend-protocol-category extend-protocol-default
          extend-protocol-type implements-protocol-operation?
          implements-protocol? protocol-definition protocol-host-category
          protocol-method protocol-slot))
