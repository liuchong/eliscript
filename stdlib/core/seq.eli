(module eliscript.core.seq
  (import "../../runtime/core/collection.mjs"
    count
    isReduced
    IReversible
    nth
    reduce
    reduced
    rseq
    sequenceView
    unboundedSequenceView
    unreduced)
  (import "../../runtime/core/protocol.mjs" implementsProtocolOperation)
  (import "../../runtime/core/list.mjs" isPersistentList)
  (import "../../runtime/core/transducer.mjs"
    deduping
    distincting
    dropping
    droppingWhile
    filtering
    into
    interposing
    keeping
    keepingIndexed
    mapcatting
    mapping
    mappingIndexed
    partitioningAll
    partitioningBy
    removing
    taking
    takingNth
    takingWhile)
  (import "../../runtime/core/transient.mjs" conjBang persistentBang transient)
  (import "../../runtime/core/truth.mjs" isTruthy)
  (import "../../runtime/core/vector.mjs"
    EMPTY_VECTOR
    isPersistentVector
    persistentVector)
  (defconst not-found (js-object))
  (defconst sequence-no-partition-pad (js-object))
  (defconst sequence-ring (js* "() => new Map()"))
  (defconst sequence-array? (js* "Array.isArray"))
  (defconst sequence-safe-integer? (js* "Number.isSafeInteger"))
  (defconst sequence-finite? (js* "Number.isFinite"))
  (defconst sequence-ceil (js* "Math.ceil"))
  (defun require-function
    (value label)
    (if (= (value-type value) "function")
      value
      (throw (new globalThis/TypeError (str label " must be a function")))))
  (defun require-non-negative-safe-integer
    (value label)
    (if (and (funcall sequence-safe-integer? value) (>= value 0))
      value
      (throw
        (new globalThis/TypeError (str label " must be a non-negative safe integer")))))
  (defun require-positive-safe-integer
    (value label)
    (if (and (funcall sequence-safe-integer? value) (> value 0))
      value
      (throw (new globalThis/TypeError (str label " must be a positive safe integer")))))
  (defun sequence-materialize-sources
    (collections)
    (let ((sources (js-array)) (index 0))
      (while (< index (js-length collections))
        (js-call sources :push (into EMPTY_VECTOR (js-nth index collections)))
        (setq index (1+ index)))
      sources))
  (defun sequence-partition-windows
    (size step pad include-partial collection)
    (require-positive-safe-integer size "partition size")
    (require-positive-safe-integer step "partition step")
    (let*
      ((values (into EMPTY_VECTOR collection))
        (value-count (count values))
        (result (transient EMPTY_VECTOR))
        (start 0))
      (while (< start value-count)
        (let*
          ((remaining (- value-count start))
            (group-count (if (< remaining size) remaining size))
            (partial (< group-count size))
            (group (transient EMPTY_VECTOR))
            (offset 0))
          (while (< offset group-count)
            (conjBang group (nth (+ start offset) values))
            (setq offset (1+ offset)))
          (when (and partial (not (eq pad sequence-no-partition-pad)))
            (reduce
              pad
              (lambda
                (builder value)
                (conjBang builder value)
                (setq group-count (1+ group-count))
                (if (>= group-count size) (reduced builder) builder))
              group))
          (let ((completed (persistentBang group)))
            (when
              (or
                (not partial)
                include-partial
                (not (eq pad sequence-no-partition-pad)))
              (conjBang result completed)))
          (setq start (+ start step))
          (when (and partial (not include-partial)) (setq start value-count))))
      (persistentBang result)))
  (defun sequence-sequential-branch?
    (value)
    (or
      (funcall sequence-array? value)
      (isPersistentList value)
      (isPersistentVector value)))
  (defun require-finite-number
    (value label)
    (if (funcall sequence-finite? value)
      value
      (throw (new globalThis/TypeError (str label " must be a finite number")))))
  (defun sequence-iterator-result (value done) (js-object :value value :done done))
  (defun sequence-iterator (next) (js-object :next next))
  (defun sequence-range-count
    (start end step)
    (let ((distance (/ (- end start) step)))
      (if (> distance 0)
        (require-non-negative-safe-integer
          (funcall sequence-ceil distance)
          "range count")
        0)))
  (defun sequence-range-factory
    (start step limit)
    (lambda
      ()
      (let ((index 0))
        (sequence-iterator
          (lambda
            ()
            (if (and (not (nil? limit)) (>= index limit))
              (sequence-iterator-result undefined t)
              (let ((value (+ start (* index step))))
                (setq index (1+ index))
                (sequence-iterator-result value false))))))))
  (defun range
    (&rest bounds)
    (let ((arity (js-length bounds)))
      (if (= arity 0)
        (unboundedSequenceView (sequence-range-factory 0 1 nil))
        (progn
          (when (> arity 3)
            (throw (new globalThis/TypeError "range expects zero to three arguments")))
          (let*
            (
              (start
                (require-finite-number
                  (if (= arity 1) 0 (js-nth 0 bounds))
                  "range start"))
              (end
                (require-finite-number
                  (if (= arity 1) (js-nth 0 bounds) (js-nth 1 bounds))
                  "range end"))
              (step
                (require-finite-number
                  (if (= arity 3) (js-nth 2 bounds) 1)
                  "range step")))
            (when (= step 0)
              (throw (new globalThis/TypeError "range step must be non-zero")))
            (let ((limit (sequence-range-count start end step)))
              (sequenceView (sequence-range-factory start step limit) limit)))))))
  (defun sequence-repeat-factory
    (value limit)
    (lambda
      ()
      (let ((index 0))
        (sequence-iterator
          (lambda
            ()
            (if (and (not (nil? limit)) (>= index limit))
              (sequence-iterator-result undefined t)
              (progn (setq index (1+ index)) (sequence-iterator-result value false))))))))
  (defun repeat
    (&rest arguments)
    (let ((arity (js-length arguments)))
      (cond
        ((= arity 1)
          (unboundedSequenceView (sequence-repeat-factory (js-nth 0 arguments) nil)))
        ((= arity 2)
          (let
            (
              (limit
                (require-non-negative-safe-integer (js-nth 0 arguments) "repeat count")))
            (sequenceView (sequence-repeat-factory (js-nth 1 arguments) limit) limit)))
        (t
          (throw
            (new globalThis/TypeError "repeat expects a value or a count and value"))))))
  (defun sequence-repeatedly-factory
    (producer limit)
    (lambda
      ()
      (let ((index 0))
        (sequence-iterator
          (lambda
            ()
            (if (and (not (nil? limit)) (>= index limit))
              (sequence-iterator-result undefined t)
              (progn
                (setq index (1+ index))
                (sequence-iterator-result (funcall producer) false))))))))
  (defun repeatedly
    (&rest arguments)
    (let ((arity (js-length arguments)))
      (cond
        ((= arity 1)
          (let
            ((producer (require-function (js-nth 0 arguments) "repeatedly producer")))
            (unboundedSequenceView (sequence-repeatedly-factory producer nil))))
        ((= arity 2)
          (let
            (
              (limit
                (require-non-negative-safe-integer
                  (js-nth 0 arguments)
                  "repeatedly count"))
              (producer (require-function (js-nth 1 arguments) "repeatedly producer")))
            (sequenceView (sequence-repeatedly-factory producer limit) limit)))
        (t
          (throw
            (new
              globalThis/TypeError
              "repeatedly expects a producer or a count and producer"))))))
  (defun iterate
    (transform seed)
    (require-function transform "iterate transform")
    (unboundedSequenceView
      (lambda
        ()
        (let ((value seed) (started false))
          (sequence-iterator
            (lambda
              ()
              (if started (setq value (funcall transform value)) (setq started t))
              (sequence-iterator-result value false)))))))
  (defun cycle
    (collection)
    (let* ((values (into EMPTY_VECTOR collection)) (limit (count values)))
      (if (= limit 0)
        nil
        (unboundedSequenceView
          (lambda
            ()
            (let ((index 0))
              (sequence-iterator
                (lambda
                  ()
                  (let ((value (nth index values)))
                    (setq index (% (1+ index) limit))
                    (sequence-iterator-result value false))))))))))
  (defun generate
    (limit producer)
    (require-non-negative-safe-integer limit "generate count")
    (require-function producer "generate producer")
    (sequenceView
      (lambda
        ()
        (let ((index 0))
          (sequence-iterator
            (lambda
              ()
              (if (>= index limit)
                (sequence-iterator-result undefined t)
                (let ((value (funcall producer index)))
                  (setq index (1+ index))
                  (sequence-iterator-result value false)))))))
      limit))
  (defun first
    (collection &optional not-found-value)
    (let
      (
        (result
          (reduce
            collection
            (lambda (missing value) (reduced (js-object :value value)))
            not-found)))
      (if (eq result not-found) not-found-value (get result :value))))
  (defun sequence-nth
    (index collection &optional not-found-value)
    (require-non-negative-safe-integer index "sequence-nth index")
    (let*
      ((position 0)
        (result
          (reduce
            collection
            (lambda
              (missing value)
              (if (= position index)
                (reduced (js-object :value value))
                (progn (setq position (1+ position)) missing)))
            not-found)))
      (if (eq result not-found) not-found-value (get result :value))))
  (defun last
    (collection &optional not-found-value)
    (if (implementsProtocolOperation IReversible "rseq" collection)
      (first (rseq collection) not-found-value)
      (let
        (
          (result
            (reduce
              collection
              (lambda (missing value) (js-object :value value))
              not-found)))
        (if (eq result not-found) not-found-value (get result :value)))))
  (defun take-last
    (limit collection)
    (require-non-negative-safe-integer limit "take-last limit")
    (if (= limit 0)
      EMPTY_VECTOR
      (let ((ring (funcall sequence-ring)) (count 0) (start 0))
        (reduce
          collection
          (lambda
            (state value)
            (if (< count limit)
              (progn (js-call ring :set count value) (setq count (1+ count)))
              (progn (js-call ring :set start value) (setq start (% (1+ start) limit))))
            state)
          nil)
        (let ((builder (transient EMPTY_VECTOR)) (index 0))
          (while (< index count)
            (conjBang builder (js-call ring :get (% (+ start index) limit)))
            (setq index (1+ index)))
          (persistentBang builder)))))
  (defun drop-last
    (limit collection)
    (require-non-negative-safe-integer limit "drop-last limit")
    (if (= limit 0)
      (into EMPTY_VECTOR collection)
      (let
        ((ring (funcall sequence-ring))
          (builder (transient EMPTY_VECTOR))
          (count 0)
          (start 0))
        (reduce
          collection
          (lambda
            (state value)
            (if (< count limit)
              (progn (js-call ring :set count value) (setq count (1+ count)))
              (progn
                (conjBang builder (js-call ring :get start))
                (js-call ring :set start value)
                (setq start (% (1+ start) limit))))
            state)
          nil)
        (persistentBang builder))))
  (defun butlast (collection) (drop-last 1 collection))
  (defun split-at
    (limit collection)
    (require-non-negative-safe-integer limit "split-at limit")
    (let ((left (transient EMPTY_VECTOR)) (right (transient EMPTY_VECTOR)) (index 0))
      (reduce
        collection
        (lambda
          (state value)
          (conjBang (if (< index limit) left right) value)
          (setq index (1+ index))
          state)
        nil)
      (persistentVector (persistentBang left) (persistentBang right))))
  (defun split-with
    (predicate collection)
    (require-function predicate "split-with predicate")
    (let ((left (transient EMPTY_VECTOR)) (right (transient EMPTY_VECTOR)) (prefix t))
      (reduce
        collection
        (lambda
          (state value)
          (if (and prefix (isTruthy (funcall predicate value)))
            (conjBang left value)
            (progn (setq prefix false) (conjBang right value)))
          state)
        nil)
      (persistentVector (persistentBang left) (persistentBang right))))
  (defun reverse
    (collection)
    (if (implementsProtocolOperation IReversible "rseq" collection)
      (into EMPTY_VECTOR (rseq collection))
      (let
        (
          (values
            (reduce
              collection
              (lambda (result value) (js-call result :push value) result)
              (js-array))))
        (js-call values :reverse)
        (into EMPTY_VECTOR values))))
  (defun map (transform collection) (into EMPTY_VECTOR (mapping transform) collection))
  (defun map-indexed
    (transform collection)
    (into EMPTY_VECTOR (mappingIndexed transform) collection))
  (defun keep (transform collection) (into EMPTY_VECTOR (keeping transform) collection))
  (defun keep-indexed
    (transform collection)
    (into EMPTY_VECTOR (keepingIndexed transform) collection))
  (defun filter
    (predicate collection)
    (into EMPTY_VECTOR (filtering predicate) collection))
  (defun remove
    (predicate collection)
    (into EMPTY_VECTOR (removing predicate) collection))
  (defun take (limit collection) (into EMPTY_VECTOR (taking limit) collection))
  (defun drop (limit collection) (into EMPTY_VECTOR (dropping limit) collection))
  (defun take-while
    (predicate collection)
    (into EMPTY_VECTOR (takingWhile predicate) collection))
  (defun drop-while
    (predicate collection)
    (into EMPTY_VECTOR (droppingWhile predicate) collection))
  (defun take-nth
    (interval collection)
    (into EMPTY_VECTOR (takingNth interval) collection))
  (defun interpose
    (separator collection)
    (into EMPTY_VECTOR (interposing separator) collection))
  (defun dedupe (collection) (into EMPTY_VECTOR (deduping) collection))
  (defun distinct (collection) (into EMPTY_VECTOR (distincting) collection))
  (defun mapcat
    (transform collection)
    (into EMPTY_VECTOR (mapcatting transform) collection))
  (defun partition
    (size &rest arguments)
    (let ((arity (js-length arguments)))
      (cond
        ((= arity 1)
          (sequence-partition-windows
            size
            size
            sequence-no-partition-pad
            false
            (js-nth 0 arguments)))
        ((= arity 2)
          (sequence-partition-windows
            size
            (js-nth 0 arguments)
            sequence-no-partition-pad
            false
            (js-nth 1 arguments)))
        ((= arity 3)
          (sequence-partition-windows
            size
            (js-nth 0 arguments)
            (js-nth 1 arguments)
            false
            (js-nth 2 arguments)))
        (t
          (throw
            (new
              globalThis/TypeError
              "partition expects size and collection, optional step, or step and pad"))))))
  (defun partition-all
    (size &rest arguments)
    (let ((arity (js-length arguments)))
      (cond
        ((= arity 1)
          (require-positive-safe-integer size "partition size")
          (into EMPTY_VECTOR (partitioningAll size) (js-nth 0 arguments)))
        ((= arity 2)
          (sequence-partition-windows
            size
            (js-nth 0 arguments)
            sequence-no-partition-pad
            t
            (js-nth 1 arguments)))
        (t
          (throw
            (new
              globalThis/TypeError
              "partition-all expects size and collection or size, step, and collection"))))))
  (defun partition-by
    (classifier collection)
    (into EMPTY_VECTOR (partitioningBy classifier) collection))
  (defun concat
    (&rest collections)
    (let ((result (transient EMPTY_VECTOR)) (index 0))
      (while (< index (js-length collections))
        (reduce
          (js-nth index collections)
          (lambda (builder value) (conjBang builder value))
          result)
        (setq index (1+ index)))
      (persistentBang result)))
  (defun interleave
    (&rest collections)
    (if (= (js-length collections) 0)
      EMPTY_VECTOR
      (let*
        ((sources (sequence-materialize-sources collections))
          (source-count (js-length sources))
          (limit (count (js-nth 0 sources)))
          (source-index 1)
          (value-index 0)
          (result (transient EMPTY_VECTOR)))
        (while (< source-index source-count)
          (let ((source-size (count (js-nth source-index sources))))
            (when (< source-size limit) (setq limit source-size)))
          (setq source-index (1+ source-index)))
        (while (< value-index limit)
          (setq source-index 0)
          (while (< source-index source-count)
            (conjBang result (nth value-index (js-nth source-index sources)))
            (setq source-index (1+ source-index)))
          (setq value-index (1+ value-index)))
        (persistentBang result))))
  (defun interleave-all
    (&rest collections)
    (if (= (js-length collections) 0)
      EMPTY_VECTOR
      (let*
        ((sources (sequence-materialize-sources collections))
          (source-count (js-length sources))
          (limit 0)
          (source-index 0)
          (value-index 0)
          (result (transient EMPTY_VECTOR)))
        (while (< source-index source-count)
          (let ((source-size (count (js-nth source-index sources))))
            (when (> source-size limit) (setq limit source-size)))
          (setq source-index (1+ source-index)))
        (while (< value-index limit)
          (setq source-index 0)
          (while (< source-index source-count)
            (let ((source (js-nth source-index sources)))
              (when (< value-index (count source))
                (conjBang result (nth value-index source))))
            (setq source-index (1+ source-index)))
          (setq value-index (1+ value-index)))
        (persistentBang result))))
  (defun some
    (predicate collection &optional not-found-value)
    (require-function predicate "some predicate")
    (let
      (
        (result
          (reduce
            collection
            (lambda
              (missing value)
              (let ((matched (funcall predicate value)))
                (if (isTruthy matched) (reduced matched) missing)))
            not-found)))
      (if (eq result not-found) not-found-value result)))
  (defun every?
    (predicate collection)
    (require-function predicate "every predicate")
    (reduce
      collection
      (lambda
        (result value)
        (if (isTruthy (funcall predicate value)) result (reduced false)))
      t))
  (defun not-any? (predicate collection) (not (isTruthy (some predicate collection))))
  (defun not-every? (predicate collection) (not (every? predicate collection)))
  (defun find
    (predicate collection &optional not-found-value)
    (require-function predicate "find predicate")
    (let
      (
        (result
          (reduce
            collection
            (lambda
              (missing value)
              (if (isTruthy (funcall predicate value))
                (reduced (js-object :value value))
                missing))
            not-found)))
      (if (eq result not-found) not-found-value (get result :value))))
  (defun reductions
    (step initial collection)
    (require-function step "reductions step")
    (let ((builder (transient EMPTY_VECTOR)) (seed (unreduced initial)))
      (conjBang builder seed)
      (unless (isReduced initial)
        (reduce
          collection
          (lambda
            (current input)
            (let ((next (funcall step current input)))
              (conjBang builder (unreduced next))
              (if (isReduced next) (reduced (unreduced next)) next)))
          seed))
      (persistentBang builder)))
  (defun tree-seq
    (branch-predicate children-function root)
    (require-function branch-predicate "tree-seq branch predicate")
    (require-function children-function "tree-seq children function")
    (let ((result (transient EMPTY_VECTOR)) (stack (js-array root)))
      (while (> (js-length stack) 0)
        (let ((value (js-call stack :pop)))
          (conjBang result value)
          (when (isTruthy (funcall branch-predicate value))
            (let*
              ((children (into EMPTY_VECTOR (funcall children-function value)))
                (index (1- (count children))))
              (while (>= index 0)
                (js-call stack :push (nth index children))
                (setq index (1- index)))))))
      (persistentBang result)))
  (defun flatten
    (root)
    (let ((result (transient EMPTY_VECTOR)) (stack (js-array root)))
      (while (> (js-length stack) 0)
        (let ((value (js-call stack :pop)))
          (if (sequence-sequential-branch? value)
            (let* ((children (into EMPTY_VECTOR value)) (index (1- (count children))))
              (while (>= index 0)
                (js-call stack :push (nth index children))
                (setq index (1- index))))
            (conjBang result value))))
      (persistentBang result)))
  (export
    butlast
    concat
    cycle
    dedupe
    distinct
    drop
    drop-last
    drop-while
    every?
    filter
    find
    flatten
    first
    generate
    interpose
    interleave
    interleave-all
    keep
    keep-indexed
    last
    iterate
    map
    map-indexed
    mapcat
    not-any?
    not-every?
    partition
    partition-all
    partition-by
    reductions
    remove
    repeat
    repeatedly
    reverse
    range
    sequence-nth
    some
    split-at
    split-with
    take
    take-last
    take-nth
    take-while
    tree-seq))
