(module eliscript.core.seq
  (import "../../runtime/core/collection.mjs"
          isReduced reduce reduced unreduced)
  (import "../../runtime/core/transducer.mjs"
          deduping distincting dropping droppingWhile filtering into
          interposing keeping keepingIndexed mapcatting mapping mappingIndexed
          partitioningAll partitioningBy removing taking takingNth takingWhile)
  (import "../../runtime/core/transient.mjs"
          conjBang persistentBang transient)
  (import "../../runtime/core/truth.mjs" isTruthy)
  (import "../../runtime/core/vector.mjs" EMPTY_VECTOR)

  (defconst not-found (js-object))

  (defun require-function (value label)
    (if (= (value-type value) "function")
        value
      (throw (new globalThis/TypeError (str label " must be a function")))))

  (defun reverse (collection)
    (let ((values
           (reduce
             collection
             (lambda (result value)
               (js-call result :push value)
               result)
             (js-array))))
      (js-call values :reverse)
      (into EMPTY_VECTOR values)))

  (defun map (transform collection)
    (into EMPTY_VECTOR (mapping transform) collection))

  (defun map-indexed (transform collection)
    (into EMPTY_VECTOR (mappingIndexed transform) collection))

  (defun keep (transform collection)
    (into EMPTY_VECTOR (keeping transform) collection))

  (defun keep-indexed (transform collection)
    (into EMPTY_VECTOR (keepingIndexed transform) collection))

  (defun filter (predicate collection)
    (into EMPTY_VECTOR (filtering predicate) collection))

  (defun remove (predicate collection)
    (into EMPTY_VECTOR (removing predicate) collection))

  (defun take (limit collection)
    (into EMPTY_VECTOR (taking limit) collection))

  (defun drop (limit collection)
    (into EMPTY_VECTOR (dropping limit) collection))

  (defun take-while (predicate collection)
    (into EMPTY_VECTOR (takingWhile predicate) collection))

  (defun drop-while (predicate collection)
    (into EMPTY_VECTOR (droppingWhile predicate) collection))

  (defun take-nth (interval collection)
    (into EMPTY_VECTOR (takingNth interval) collection))

  (defun interpose (separator collection)
    (into EMPTY_VECTOR (interposing separator) collection))

  (defun dedupe (collection)
    (into EMPTY_VECTOR (deduping) collection))

  (defun distinct (collection)
    (into EMPTY_VECTOR (distincting) collection))

  (defun mapcat (transform collection)
    (into EMPTY_VECTOR (mapcatting transform) collection))

  (defun partition-all (size collection)
    (into EMPTY_VECTOR (partitioningAll size) collection))

  (defun partition-by (classifier collection)
    (into EMPTY_VECTOR (partitioningBy classifier) collection))

  (defun concat (&rest collections)
    (let ((result (transient EMPTY_VECTOR))
          (index 0))
      (while (< index (js-length collections))
        (reduce
          (js-nth index collections)
          (lambda (builder value)
            (conjBang builder value))
          result)
        (setq index (1+ index)))
      (persistentBang result)))

  (defun some (predicate collection &optional not-found-value)
    (require-function predicate "some predicate")
    (let ((result
           (reduce
             collection
             (lambda (missing value)
               (let ((matched (funcall predicate value)))
                 (if (isTruthy matched) (reduced matched) missing)))
             not-found)))
      (if (eq result not-found) not-found-value result)))

  (defun every? (predicate collection)
    (require-function predicate "every predicate")
    (reduce
      collection
      (lambda (result value)
        (if (isTruthy (funcall predicate value)) result (reduced false)))
      t))

  (defun find (predicate collection &optional not-found-value)
    (require-function predicate "find predicate")
    (let ((result
           (reduce
             collection
             (lambda (missing value)
               (if (isTruthy (funcall predicate value))
                   (reduced (js-object :value value))
                 missing))
             not-found)))
      (if (eq result not-found) not-found-value (get result :value))))

  (defun reductions (step initial collection)
    (require-function step "reductions step")
    (let ((builder (transient EMPTY_VECTOR))
          (seed (unreduced initial)))
      (conjBang builder seed)
      (unless (isReduced initial)
        (reduce
          collection
          (lambda (current input)
            (let ((next (funcall step current input)))
              (conjBang builder (unreduced next))
              (if (isReduced next) (reduced (unreduced next)) next)))
          seed))
      (persistentBang builder)))

  (export concat dedupe distinct drop drop-while every? filter find interpose
          keep keep-indexed map map-indexed mapcat partition-all partition-by
          reductions remove reverse some take take-nth take-while))
