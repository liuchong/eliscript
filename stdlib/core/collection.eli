(module eliscript.core.collection
  (import "../../runtime/core/collection.mjs" :as Runtime)
  (defconst ICounted Runtime/ICounted)
  (defconst IEmptyable Runtime/IEmptyable)
  (defconst IConj Runtime/IConj)
  (defconst ILookup Runtime/ILookup)
  (defconst IAssociative Runtime/IAssociative)
  (defconst IIndexed Runtime/IIndexed)
  (defconst ISeqable Runtime/ISeqable)
  (defconst IReduce Runtime/IReduce)
  (defconst IKVReduce Runtime/IKVReduce)
  (defconst ReductionView Runtime/ReductionView)
  (defconst SequenceView Runtime/SequenceView)
  (defun collection-count (collection) (Runtime/count collection))
  (defun empty (collection) (Runtime/empty collection))
  (defun conj
    (collection &rest values)
    (apply Runtime/conj (js-cons collection values)))
  (defun assoc
    (collection key value &rest key-values)
    (apply Runtime/assoc (js-cons collection (js-cons key (js-cons value key-values)))))
  (defun lookup
    (collection key &rest not-found)
    (apply Runtime/get (js-cons collection (js-cons key not-found))))
  (defun contains? (collection key) (Runtime/contains collection key))
  (defun collection-nth
    (collection index &rest not-found)
    (apply Runtime/nth (js-cons collection (js-cons index not-found))))
  (defun reduce
    (collection reducer &rest initial)
    (apply Runtime/reduce (js-cons collection (js-cons reducer initial))))
  (defun reduce-kv
    (collection reducer initial)
    (Runtime/reduceKV collection reducer initial))
  (defun collection-seq (collection) (Runtime/seq collection))
  (defun reduced (value) (Runtime/reduced value))
  (defun reduced? (value) (Runtime/isReduced value))
  (defun unreduced (value) (Runtime/unreduced value))
  (defun sequence-view
    (factory &rest count)
    (apply Runtime/sequenceView (js-cons factory count)))
  (defun unbounded-sequence-view (factory) (Runtime/unboundedSequenceView factory))
  (defun reduction-view (reduce-function) (Runtime/reductionView reduce-function))
  (defun reduction-view? (value) (Runtime/isReductionView value))
  (export
    IAssociative
    IConj
    ICounted
    IEmptyable
    IIndexed
    ILookup
    IReduce
    IKVReduce
    ISeqable
    ReductionView
    SequenceView
    assoc
    collection-count
    collection-nth
    collection-seq
    conj
    contains?
    empty
    lookup
    reduce
    reduce-kv
    reduced
    reduced?
    reduction-view
    reduction-view?
    sequence-view
    unbounded-sequence-view
    unreduced))
