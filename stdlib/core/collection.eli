(module eliscript.core.collection
  (import "../../runtime/core/collection.mjs" :as Runtime)
  (import "../../runtime/core/vector.mjs" :as Vector)
  (defconst ICounted Runtime/ICounted)
  (defconst IEmptyable Runtime/IEmptyable)
  (defconst IConj Runtime/IConj)
  (defconst ILookup Runtime/ILookup)
  (defconst IAssociative Runtime/IAssociative)
  (defconst IIndexed Runtime/IIndexed)
  (defconst ISeqable Runtime/ISeqable)
  (defconst IReduce Runtime/IReduce)
  (defconst IKVReduce Runtime/IKVReduce)
  (defconst IMap Runtime/IMap)
  (defconst ISet Runtime/ISet)
  (defconst IStack Runtime/IStack)
  (defconst IReversible Runtime/IReversible)
  (defconst ReductionView Runtime/ReductionView)
  (defconst SequenceView Runtime/SequenceView)
  (defun collection-count (collection) (Runtime/count collection))
  (defun counted? (collection) (Runtime/isCounted collection))
  (defun indexed? (collection) (Runtime/isIndexed collection))
  (defun seqable? (collection) (Runtime/isSeqable collection))
  (defun reducible? (collection) (Runtime/isReducible collection))
  (defun reversible? (collection) (Runtime/isReversible collection))
  (defun associative? (collection) (Runtime/isAssociative collection))
  (defun collection? (value) (Runtime/isCollection value))
  (defun list? (value) (Runtime/isList value))
  (defun vector? (value) (Runtime/isVector value))
  (defun map? (value) (Runtime/isMap value))
  (defun queue? (value) (Runtime/isQueue value))
  (defun set? (value) (Runtime/isSet value))
  (defun sequential? (value) (Runtime/isSequential value))
  (defun sequence? (value) (Runtime/isSequence value))
  (defun bounded-count (limit collection) (Runtime/boundedCount limit collection))
  (defun distinct? (&rest values) (apply Runtime/areDistinct values))
  (defun subvec (vector start &optional end) (Vector/subvec vector start end))
  (defun empty (collection) (Runtime/empty collection))
  (defun conj
    (collection &rest values)
    (apply Runtime/conj (js-cons collection values)))
  (defun assoc
    (collection key value &rest key-values)
    (apply Runtime/assoc (js-cons collection (js-cons key (js-cons value key-values)))))
  (defun lookup
    (collection key &rest not-found)
    (apply Runtime/get (js-cons collection (js-cons key not-found))))
  (defun contains? (collection key) (Runtime/contains collection key))
  (defun collection-nth
    (collection index &rest not-found)
    (apply Runtime/nth (js-cons collection (js-cons index not-found))))
  (defun reduce
    (collection reducer &rest initial)
    (apply Runtime/reduce (js-cons collection (js-cons reducer initial))))
  (defun reduce-kv
    (collection reducer initial)
    (Runtime/reduceKV collection reducer initial))
  (defun dissoc
    (collection &rest keys)
    (apply Runtime/dissoc (js-cons collection keys)))
  (defun disj
    (collection &rest values)
    (apply Runtime/disj (js-cons collection values)))
  (defun peek (collection) (Runtime/peek collection))
  (defun pop (collection) (Runtime/pop collection))
  (defun rseq (collection) (Runtime/rseq collection))
  (defun collection-seq (collection) (Runtime/seq collection))
  (defun empty? (collection) (Runtime/isEmpty collection))
  (defun not-empty (collection) (Runtime/notEmpty collection))
  (defun reduced (value) (Runtime/reduced value))
  (defun reduced? (value) (Runtime/isReduced value))
  (defun unreduced (value) (Runtime/unreduced value))
  (defun sequence-view
    (factory &rest count)
    (apply Runtime/sequenceView (js-cons factory count)))
  (defun unbounded-sequence-view (factory) (Runtime/unboundedSequenceView factory))
  (defun reduction-view (reduce-function) (Runtime/reductionView reduce-function))
  (defun reduction-view? (value) (Runtime/isReductionView value))
  (export
    IAssociative
    IConj
    ICounted
    IEmptyable
    IIndexed
    ILookup
    IReduce
    IKVReduce
    IMap
    ISet
    IStack
    IReversible
    ISeqable
    ReductionView
    SequenceView
    assoc
    associative?
    bounded-count
    collection-count
    collection-nth
    collection-seq
    collection?
    conj
    contains?
    counted?
    empty
    empty?
    indexed?
    list?
    lookup
    map?
    not-empty
    queue?
    reduce
    reduce-kv
    reducible?
    dissoc
    disj
    distinct?
    peek
    pop
    rseq
    reversible?
    sequence?
    sequential?
    seqable?
    set?
    subvec
    reduced
    reduced?
    reduction-view
    reduction-view?
    sequence-view
    unbounded-sequence-view
    unreduced
    vector?))
