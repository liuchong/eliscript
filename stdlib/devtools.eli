(module eliscript.devtools
  (import "../runtime/core/array-map.mjs" isPersistentArrayMap)
  (import "../runtime/core/collection.mjs" :as Collection)
  (import "../runtime/core/data-text.mjs" isTaggedLiteral taggedLiteralForm taggedLiteralTag)
  (import "../runtime/core/identifier.mjs" isEliscriptSymbol isKeyword keyword qualifiedIdentifierName)
  (import "../runtime/core/list.mjs" isPersistentList)
  (import "../runtime/core/map.mjs" isPersistentHashMap)
  (import "../runtime/core/metadata.mjs" meta supportsMetadata)
  (import "../runtime/core/queue.mjs" isPersistentQueue)
  (import "../runtime/core/record.mjs" isRecord recordFieldNames recordTypeName)
  (import "../runtime/core/set.mjs" isPersistentHashSet)
  (import "../runtime/core/sorted.mjs" isPersistentSortedMap isPersistentSortedSet)
  (import "../runtime/core/vector.mjs" PersistentVector readPersistentVectorView)
  (import "./state.mjs" atom? deref vderef volatile?)
  (import "./time.mjs" duration-ms duration-seconds duration? instant-iso instant-ms instant?)
  (import "./uuid.mjs" uuid-string uuid-version uuid?)

  (defconst STYLE_TAG "color:#7c3aed;font-weight:600")
  (defconst STYLE_KEY "color:#0369a1;font-weight:500")
  (defconst STYLE_SYM "color:#0f766e")
  (defconst STYLE_PUNCT "color:#64748b")
  (defconst STYLE_MUTABLE "color:#b45309;font-weight:600")
  (defconst STYLE_META "color:#6b7280;font-style:italic")
  (defconst STYLE_LIST "list-style-type:none;padding-left:14px;margin:2px 0")
  (defconst STYLE_ROW "margin:1px 0")

  (defconst MAX_HEADER_ITEMS 5)
  (defconst MAX_BODY_DEPTH 16)

  (defun safe-depth (config)
    (if (and (not (nullish? config)) (Number/isSafeInteger (get config :depth)))
      (get config :depth)
      0))

  (defun safe-ancestors (config)
    (if (and (not (nullish? config)) (Array/isArray (get config :ancestors)))
      (get config :ancestors)
      (js-array)))

  (defun in-ancestors? (ancestors obj)
    (let ((i 0)
          (found false))
      (while (and (not found) (< i (js-length ancestors)))
        (when (eq (aref ancestors i) obj)
          (setq found t))
        (setq i (1+ i)))
      found))

  (defun next-config (config obj)
    (let ((anc (js-call (safe-ancestors config) :concat (js-array obj))))
      (js-object :depth (1+ (safe-depth config)) :ancestors anc)))

  (defun jsonml-span (style text)
    (js-array "span" (js-object :style style) text))

  (defun jsonml-ref (val child-cfg)
    (cond
      ((nil? val) (jsonml-span STYLE_PUNCT "nil"))
      ((undefined? val) (jsonml-span STYLE_PUNCT "undefined"))
      ((= (value-type val) "boolean") (jsonml-span STYLE_TAG (if val "t" "false")))
      ((or (= (value-type val) "number") (= (value-type val) "string") (= (value-type val) "bigint"))
        (js-array "object" (js-object :object val :config child-cfg)))
      ((in-ancestors? (safe-ancestors child-cfg) val)
        (jsonml-span STYLE_META "#circular"))
      (t
        (js-array "object" (js-object :object val :config child-cfg)))))

  (defun map-entries-array (m)
    (let ((entries (js-array)))
      (Collection/reduceKV m
        (lambda (_a k v) (js-call entries :push (js-array k v)) nil)
        nil)
      entries))

  (defun seq-items-array (coll)
    (let ((items (js-array)))
      (Collection/reduce coll
        (lambda (_a v) (js-call items :push v) nil)
        nil)
      items))

  (defun record-entries-array (rec)
    (let* ((fields (recordFieldNames rec))
           (seen (new globalThis.Set))
           (rows (js-array))
           (i 0))
      (while (< i (js-length fields))
        (let* ((fn-name (aref fields i))
               (fn-kw (keyword fn-name))
               (val (Collection/get rec fn-kw nil)))
          (js-call seen :add fn-kw)
          (js-call rows :push (js-array fn-kw val)))
        (setq i (1+ i)))
      (Collection/reduceKV rec
        (lambda (_a k v)
          (unless (js-call seen :has k)
            (js-call rows :push (js-array k v)))
          nil)
        nil)
      rows))

  (defun value-metadata (obj)
    (if (supportsMetadata obj) (meta obj) nil))

  (defun eliscript-value-kind (obj)
    (cond
      ((nullish? obj) nil)
      ((isKeyword obj) "keyword")
      ((isEliscriptSymbol obj) "symbol")
      ((Collection/isMapEntry obj) "map-entry")
      ((isTaggedLiteral obj) "tagged-literal")
      ((uuid? obj) "uuid")
      ((instant? obj) "instant")
      ((duration? obj) "duration")
      ((atom? obj) "atom")
      ((volatile? obj) "volatile")
      ((isRecord obj) "record")
      ((isPersistentSortedMap obj) "sorted-map")
      ((isPersistentArrayMap obj) "array-map")
      ((isPersistentHashMap obj) "hash-map")
      ((Collection/isMap obj) "map")
      ((isPersistentSortedSet obj) "sorted-set")
      ((isPersistentHashSet obj) "hash-set")
      ((Collection/isSet obj) "set")
      ((not (undefined? (readPersistentVectorView obj))) "subvec")
      ((or (Collection/isVector obj) (js* "obj instanceof PersistentVector")) "vector")
      ((isPersistentList obj) "list")
      ((isPersistentQueue obj) "queue")
      (t nil)))

  (defun append-inline-items (span items child-cfg open-delim close-delim)
    (js-call span :push (jsonml-span STYLE_PUNCT open-delim))
    (let ((limit (Math/min MAX_HEADER_ITEMS (js-length items)))
          (i 0))
      (while (< i limit)
        (when (> i 0)
          (js-call span :push (jsonml-span STYLE_PUNCT " ")))
        (js-call span :push (jsonml-ref (aref items i) child-cfg))
        (setq i (1+ i)))
      (when (> (js-length items) MAX_HEADER_ITEMS)
        (js-call span :push (jsonml-span STYLE_META " ..."))))
    (js-call span :push (jsonml-span STYLE_PUNCT close-delim))
    span)

  (defun append-inline-entries (span entries child-cfg)
    (js-call span :push (jsonml-span STYLE_PUNCT "{"))
    (let ((limit (Math/min MAX_HEADER_ITEMS (js-length entries)))
          (i 0))
      (while (< i limit)
        (let ((pair (aref entries i)))
          (when (> i 0)
            (js-call span :push (jsonml-span STYLE_PUNCT ", ")))
          (js-call span :push (jsonml-ref (aref pair 0) child-cfg))
          (js-call span :push (jsonml-span STYLE_PUNCT " "))
          (js-call span :push (jsonml-ref (aref pair 1) child-cfg)))
        (setq i (1+ i)))
      (when (> (js-length entries) MAX_HEADER_ITEMS)
        (js-call span :push (jsonml-span STYLE_META " ..."))))
    (js-call span :push (jsonml-span STYLE_PUNCT "}"))
    span)

  (defun format-header (obj &optional config)
    (let ((kind (eliscript-value-kind obj)))
      (if (nil? kind)
        nil
        (let ((child-cfg (next-config config obj))
              (depth (safe-depth config)))
          (cond
            ((= kind "keyword")
              (jsonml-span STYLE_KEY (str ":" (qualifiedIdentifierName obj))))
            ((= kind "symbol")
              (jsonml-span STYLE_SYM (qualifiedIdentifierName obj)))
            ((= kind "map-entry")
              (let ((el (js-array "span" (js-object) (jsonml-span STYLE_TAG "MapEntry") " ")))
                (append-inline-items el (js-array (Collection/entryKey obj) (Collection/entryVal obj))
                  child-cfg "[" "]")))
            ((= kind "tagged-literal")
              (js-array "span" (js-object)
                (jsonml-span STYLE_TAG (str "#" (qualifiedIdentifierName (taggedLiteralTag obj))))
                " "
                (jsonml-ref (taggedLiteralForm obj) child-cfg)))
            ((= kind "uuid")
              (js-array "span" (js-object)
                (jsonml-span STYLE_TAG "#uuid")
                " "
                (jsonml-span STYLE_KEY (str "\"" (uuid-string obj) "\""))))
            ((= kind "instant")
              (js-array "span" (js-object)
                (jsonml-span STYLE_TAG "#inst")
                " "
                (jsonml-span STYLE_KEY (str "\"" (instant-iso obj) "\""))))
            ((= kind "duration")
              (js-array "span" (js-object)
                (jsonml-span STYLE_TAG "#eliscript/duration")
                " "
                (jsonml-span STYLE_SYM (str (duration-ms obj) "ms"))))
            ((= kind "atom")
              (js-array "span" (js-object)
                (jsonml-span STYLE_MUTABLE "Atom")
                (jsonml-span STYLE_PUNCT "(")
                (if (in-ancestors? (safe-ancestors config) obj)
                  (jsonml-span STYLE_META "#circular")
                  (jsonml-ref (deref obj) child-cfg))
                (jsonml-span STYLE_PUNCT ")")))
            ((= kind "volatile")
              (js-array "span" (js-object)
                (jsonml-span STYLE_MUTABLE "Volatile")
                (jsonml-span STYLE_PUNCT "(")
                (if (in-ancestors? (safe-ancestors config) obj)
                  (jsonml-span STYLE_META "#circular")
                  (jsonml-ref (vderef obj) child-cfg))
                (jsonml-span STYLE_PUNCT ")")))
            ((= kind "record")
              (let* ((rname (recordTypeName obj))
                     (el (js-array "span" (js-object) (jsonml-span STYLE_TAG (str "#" rname)) " ")))
                (if (>= depth MAX_BODY_DEPTH)
                  (js-call el :push (jsonml-span STYLE_META "{...}"))
                  (append-inline-entries el (record-entries-array obj) child-cfg))
                el))
            ((or (= kind "array-map") (= kind "hash-map") (= kind "sorted-map") (= kind "map"))
              (let* ((label (cond
                              ((= kind "array-map") "PersistentArrayMap")
                              ((= kind "sorted-map") "PersistentSortedMap")
                              (t "PersistentHashMap")))
                     (cnt (Collection/count obj))
                     (el (js-array "span" (js-object) (jsonml-span STYLE_TAG (str label "(" cnt ")")) " ")))
                (if (>= depth MAX_BODY_DEPTH)
                  (js-call el :push (jsonml-span STYLE_META "{...}"))
                  (append-inline-entries el (map-entries-array obj) child-cfg))
                el))
            ((or (= kind "hash-set") (= kind "sorted-set") (= kind "set"))
              (let* ((label (if (= kind "sorted-set") "PersistentSortedSet" "PersistentHashSet"))
                     (cnt (Collection/count obj))
                     (el (js-array "span" (js-object) (jsonml-span STYLE_TAG (str label "(" cnt ")")) " ")))
                (append-inline-items el (seq-items-array obj) child-cfg "#{" "}")))
            ((or (= kind "vector") (= kind "subvec"))
              (let* ((label (if (= kind "subvec") "SubVector" "PersistentVector"))
                     (cnt (Collection/count obj))
                     (el (js-array "span" (js-object) (jsonml-span STYLE_TAG (str label "(" cnt ")")) " ")))
                (append-inline-items el (seq-items-array obj) child-cfg "[" "]")))
            ((= kind "list")
              (let* ((cnt (Collection/count obj))
                     (el (js-array "span" (js-object) (jsonml-span STYLE_TAG (str "PersistentList(" cnt ")")) " ")))
                (append-inline-items el (seq-items-array obj) child-cfg "(" ")")))
            ((= kind "queue")
              (let* ((cnt (Collection/count obj))
                     (el (js-array "span" (js-object) (jsonml-span STYLE_TAG (str "PersistentQueue(" cnt ")")) " ")))
                (append-inline-items el (seq-items-array obj) child-cfg "#queue [" "]")))
            (t nil))))))

  (defun has-body (obj &optional config)
    (let ((kind (eliscript-value-kind obj)))
      (cond
        ((nil? kind) false)
        ((>= (safe-depth config) MAX_BODY_DEPTH) false)
        ((or (= kind "keyword") (= kind "symbol")) (not (nil? (value-metadata obj))))
        ((or (= kind "uuid") (= kind "instant") (= kind "duration")
             (= kind "tagged-literal") (= kind "map-entry")
             (= kind "atom") (= kind "volatile")) t)
        (t
          (or (> (Collection/count obj) 0)
              (not (nil? (value-metadata obj))))))))

  (defun format-body (obj &optional config)
    (let ((kind (eliscript-value-kind obj)))
      (if (nil? kind)
        nil
        (let ((ol (js-array "ol" (js-object :style STYLE_LIST)))
              (child-cfg (next-config config obj))
              (metadata (value-metadata obj)))
          (cond
            ((= kind "map-entry")
              (js-call ol :push
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":key ")
                  (jsonml-ref (Collection/entryKey obj) child-cfg))
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":val ")
                  (jsonml-ref (Collection/entryVal obj) child-cfg))))
            ((= kind "tagged-literal")
              (js-call ol :push
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":tag ")
                  (jsonml-ref (taggedLiteralTag obj) child-cfg))
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":form ")
                  (jsonml-ref (taggedLiteralForm obj) child-cfg))))
            ((= kind "uuid")
              (js-call ol :push
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":uuid ")
                  (jsonml-span STYLE_SYM (uuid-string obj)))
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":version ")
                  (jsonml-ref (uuid-version obj) child-cfg))))
            ((= kind "instant")
              (js-call ol :push
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":iso ")
                  (jsonml-span STYLE_SYM (instant-iso obj)))
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":epochMs ")
                  (jsonml-ref (instant-ms obj) child-cfg))))
            ((= kind "duration")
              (js-call ol :push
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":ms ")
                  (jsonml-ref (duration-ms obj) child-cfg))
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_KEY ":seconds ")
                  (jsonml-ref (duration-seconds obj) child-cfg))))
            ((= kind "atom")
              (js-call ol :push
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_MUTABLE "@deref ")
                  (jsonml-ref (deref obj) child-cfg))))
            ((= kind "volatile")
              (js-call ol :push
                (js-array "li" (js-object :style STYLE_ROW)
                  (jsonml-span STYLE_MUTABLE "@vderef ")
                  (jsonml-ref (vderef obj) child-cfg))))
            ((or (= kind "record") (= kind "array-map") (= kind "hash-map") (= kind "sorted-map") (= kind "map"))
              (let ((entries (if (= kind "record") (record-entries-array obj) (map-entries-array obj)))
                    (i 0))
                (while (< i (js-length entries))
                  (let ((pair (aref entries i)))
                    (js-call ol :push
                      (js-array "li" (js-object :style STYLE_ROW)
                        (jsonml-ref (aref pair 0) child-cfg)
                        (jsonml-span STYLE_PUNCT " => ")
                        (jsonml-ref (aref pair 1) child-cfg))))
                  (setq i (1+ i)))))
            (t
              (let ((items (seq-items-array obj))
                    (i 0))
                (while (< i (js-length items))
                  (js-call ol :push
                    (js-array "li" (js-object :style STYLE_ROW)
                      (jsonml-span STYLE_PUNCT (str i ": "))
                      (jsonml-ref (aref items i) child-cfg)))
                  (setq i (1+ i))))))
          (unless (nil? metadata)
            (js-call ol :push
              (js-array "li" (js-object :style STYLE_ROW)
                (jsonml-span STYLE_META ":meta ")
                (jsonml-ref metadata child-cfg))))
          ol))))

  (defconst devtools-formatter
    (let ((marker (js-object
                    :header format-header
                    :hasBody has-body
                    :body format-body)))
      (put marker :__eliscriptDevtoolsFormatter t)
      (Object/freeze marker)))

  (defun devtools-formatters ()
    (Object/freeze (js-array devtools-formatter)))

  (defun resolve-devtools-target (&optional target)
    (if (not (nullish? target))
      target
      (let ((win (js* "typeof window !== 'undefined' ? window : null")))
        (if (nil? win) (js* "globalThis") win))))

  (defun devtools-installed? (&optional target)
    (let* ((host (resolve-devtools-target target))
           (existing (get host :devtoolsFormatters)))
      (and (Array/isArray existing)
           (js-call existing :some (lambda (item) (and item (or (eq item devtools-formatter) (get item :__eliscriptDevtoolsFormatter))))))))

  (defun install-devtools-formatters! (&optional target)
    (let* ((host (resolve-devtools-target target))
           (existing (get host :devtoolsFormatters)))
      (unless (Array/isArray existing)
        (setq existing (js-array))
        (put host :devtoolsFormatters existing))
      (unless (devtools-installed? host)
        (js-call existing :push devtools-formatter))
      existing))

  (defun uninstall-devtools-formatters! (&optional target)
    (let* ((host (resolve-devtools-target target))
           (existing (get host :devtoolsFormatters)))
      (when (Array/isArray existing)
        (put host :devtoolsFormatters
          (js-call existing :filter
            (lambda (item) (not (and item (or (eq item devtools-formatter) (get item :__eliscriptDevtoolsFormatter))))))))
      nil))

  (export
    devtools-formatter
    devtools-formatters
    devtools-installed?
    format-body
    format-header
    has-body
    install-devtools-formatters!
    uninstall-devtools-formatters!))
