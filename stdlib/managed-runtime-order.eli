(module eliscript.managed-runtime-order
  (import "./collection.mjs" reduce)
  (import "./identifier.mjs" Keyword EliscriptSymbol qualifiedIdentifierName)
  (import "./list.mjs" PersistentList)
  (import "./protocol.mjs" defineProtocol extendProtocolCategory extendProtocolType protocolMethod)
  (import "./transducer.mjs" into)
  (import "./vector.mjs" EMPTY_VECTOR PersistentVector)
  (import "../../stdlib/managed-literals.eli" literal-instance?)
  (import "../../stdlib/managed-literal-protocols.eli" managed-literal-register-protocol-role)

  (defconst IComparable (defineProtocol "IComparable" (js-array "compare")))
  (managed-literal-register-protocol-role "order.IComparable" IComparable)
  (defconst dispatch-compare (protocolMethod IComparable "compare"))
  (defun require-function (value label)
    (unless (= (js* "typeof value") "function")
      (throw (new globalThis/TypeError (str label " must be a function")))) value)
  (defun comparison-result (value label)
    (unless (and (= (js* "typeof value") "number") (Number/isFinite value))
      (throw (new globalThis/TypeError (str label " must return a finite number"))))
    (if (< value 0) -1 (if (> value 0) 1 0)))
  (defun type-name (value)
    (cond ((nil? value) "null") ((undefined? value) "undefined")
      ((literal-instance? value Keyword) "keyword")
      ((literal-instance? value EliscriptSymbol) "symbol")
      ((literal-instance? value PersistentVector) "vector")
      ((literal-instance? value PersistentList) "list") (t (js* "typeof value"))))
  (defun require-comparable-type (right predicate name)
    (unless (funcall predicate right)
      (throw (new globalThis/TypeError (str "cannot compare " name " to " (type-name right))))) right)
  (defun compare-primitive (left right predicate name)
    (require-comparable-type right predicate name)
    (if (< left right) -1 (if (> left right) 1 0)))
  (defun compare-number (left right)
    (require-comparable-type right (lambda (value) (= (js* "typeof value") "number")) "number")
    (cond ((Number/isNaN left) (if (Number/isNaN right) 0 1))
      ((Number/isNaN right) -1) ((< left right) -1) ((> left right) 1) (t 0)))
  (defun compare-identifier (left right constructor name)
    (require-comparable-type right (lambda (value) (literal-instance? value constructor)) name)
    (compare-primitive (qualifiedIdentifierName left) (qualifiedIdentifierName right)
      (lambda (value) (= (js* "typeof value") "string")) "string"))
  (defun compare-sequential (left right constructor name)
    (require-comparable-type right (lambda (value) (literal-instance? value constructor)) name)
    (let ((left-iterator (js-call (get left (get globalThis/Symbol :iterator)) :call left))
          (right-iterator (js-call (get right (get globalThis/Symbol :iterator)) :call right))
          (done false) (result 0))
      (while (not done)
        (let ((left-item (js-call left-iterator :next)) (right-item (js-call right-iterator :next)))
          (if (or (get left-item :done) (get right-item :done))
            (setq result (if (= (get left-item :done) (get right-item :done)) 0
                            (if (get left-item :done) -1 1)) done t)
            (let ((order (compareValues (get left-item :value) (get right-item :value))))
              (unless (= order 0) (setq result order done t)))))) result))

  (extendProtocolCategory IComparable "boolean" (js-object :compare
    (lambda (left right) (compare-primitive left right (lambda (value) (= (js* "typeof value") "boolean")) "boolean"))))
  (extendProtocolCategory IComparable "number" (js-object :compare compare-number))
  (extendProtocolCategory IComparable "bigint" (js-object :compare
    (lambda (left right) (compare-primitive left right (lambda (value) (= (js* "typeof value") "bigint")) "bigint"))))
  (extendProtocolCategory IComparable "string" (js-object :compare
    (lambda (left right) (compare-primitive left right (lambda (value) (= (js* "typeof value") "string")) "string"))))
  (extendProtocolType IComparable Keyword (js-object :compare
    (lambda (left right) (compare-identifier left right Keyword "keyword"))))
  (extendProtocolType IComparable EliscriptSymbol (js-object :compare
    (lambda (left right) (compare-identifier left right EliscriptSymbol "symbol"))))
  (extendProtocolType IComparable PersistentVector (js-object :compare
    (lambda (left right) (compare-sequential left right PersistentVector "vector"))))
  (extendProtocolType IComparable PersistentList (js-object :compare
    (lambda (left right) (compare-sequential left right PersistentList "list"))))

  (defun compareValues (left right)
    (cond ((or (eq left right) (and (Number/isNaN left) (Number/isNaN right))) 0)
      ((nil? left) -1) ((nil? right) 1) ((undefined? left) -1) ((undefined? right) 1)
      (t (comparison-result (funcall dispatch-compare left right) "IComparable/compare"))))
  (defun comparator (comparison)
    (require-function comparison "comparator comparison")
    (lambda (left right)
      (let ((result (funcall comparison left right)))
        (if (= (js* "typeof result") "number") (comparison-result result "comparator comparison")
          (if (and (not (eq result false)) (not (nullish? result))) -1
            (let ((reverse (funcall comparison right left)))
              (if (and (not (eq reverse false)) (not (nullish? reverse))) 1 0)))))))
  (defun reverseComparator (&rest arguments)
    (when (> (js-length arguments) 1)
      (throw (new globalThis/TypeError "reverseComparator expects zero or one comparator")))
    (let ((normalized (comparator (if (= (js-length arguments) 0) compareValues (get arguments 0)))))
      (lambda (left right) (funcall normalized right left))))
  (defun sort-decorated (values comparison)
    (js-call values :sort (lambda (left right)
      (let ((result (funcall comparison (get left :key) (get right :key))))
        (if (= result 0) (- (get left :index) (get right :index)) result))))
    (into EMPTY_VECTOR (js-call values :map (lambda (entry) (get entry :value)))))
  (defun collect-decorated (collection key-function)
    (let ((values (js-array)))
      (reduce collection (lambda (result value)
        (js-call result :push (js-object :index (js-length result) :key (funcall key-function value) :value value)) result) values)
      values))
  (defun sort (&rest arguments)
    (unless (or (= (js-length arguments) 1) (= (js-length arguments) 2))
      (throw (new globalThis/TypeError "sort expects a collection or comparator and collection")))
    (let ((comparison (if (= (js-length arguments) 1) compareValues (get arguments 0)))
          (collection (get arguments (1- (js-length arguments)))))
      ;; Decoration and all key callbacks precede comparator validation.
      (sort-decorated (collect-decorated collection (lambda (value) value)) (comparator comparison))))
  (defun sortBy (key-function &rest arguments)
    (require-function key-function "sortBy key function")
    (unless (or (= (js-length arguments) 1) (= (js-length arguments) 2))
      (throw (new globalThis/TypeError "sortBy expects a key function, optional comparator, and collection")))
    (let ((comparison (if (= (js-length arguments) 1) compareValues (get arguments 0)))
          (collection (get arguments (1- (js-length arguments)))))
      (sort-decorated (collect-decorated collection key-function) (comparator comparison))))
  (defun extreme-key (label direction key-function values)
    (require-function key-function (str label " key function"))
    (when (= (js-length values) 0)
      (throw (new globalThis/TypeError (str label " expects a key function and at least one value"))))
    (let* ((selected (get values 0)) (selected-key (funcall key-function selected)) (index 1))
      (while (< index (js-length values))
        (let* ((candidate (get values index)) (candidate-key (funcall key-function candidate)))
          (when (>= (* (compareValues candidate-key selected-key) direction) 0)
            (setq selected candidate selected-key candidate-key)))
        (setq index (1+ index))) selected))
  (defun minKey (key-function &rest values) (extreme-key "minKey" -1 key-function values))
  (defun maxKey (key-function &rest values) (extreme-key "maxKey" 1 key-function values))
  (export IComparable compareValues comparator reverseComparator sort sortBy minKey maxKey))
