(module eliscript.string
  (import "../runtime/core/collection.mjs" :as Collection)
  (import "../runtime/core/regex.mjs" isRegexPattern regexFlags regexReplace regexSource)
  (import "../runtime/core/text-impl.mjs" :as Impl)
  (import "../runtime/core/transient.mjs" conjBang persistentBang transient)
  (import "../runtime/core/vector.mjs" EMPTY_VECTOR)

  (defconst string-missing (js-object))
  (defvar trim-left-pattern nil)
  (defvar trim-right-pattern nil)
  (defvar line-break-pattern nil)
  (defun get-trim-left-pattern ()
    (when (nil? trim-left-pattern)
      (setq trim-left-pattern (new globalThis/RegExp "^\\s+" "u")))
    trim-left-pattern)
  (defun get-trim-right-pattern ()
    (when (nil? trim-right-pattern)
      (setq trim-right-pattern (new globalThis/RegExp "\\s+$" "u")))
    trim-right-pattern)
  (defun get-line-break-pattern ()
    (when (nil? line-break-pattern)
      (setq line-break-pattern (new globalThis/RegExp "\\r?\\n" "g")))
    line-break-pattern)

  (defun require-string (value label)
    (unless (= (value-type value) "string")
      (throw (new globalThis/TypeError (str label " must be a string"))))
    value)

  (defun require-safe-int (value label)
    (unless (Number/isSafeInteger value)
      (throw (new globalThis/TypeError (str label " must be a safe integer"))))
    value)

  (defun empty? (text)
    (Impl/empty_QMARK_ text))

  (defun slice (start end text)
    (Impl/slice start end text))

  (defun starts-at? (prefix offset text)
    (Impl/starts_at_QMARK_ prefix offset text))

  (defun starts-with? (prefix text)
    (Impl/starts_with_QMARK_ prefix text))

  (defun ends-with? (suffix text)
    (Impl/ends_with_QMARK_ suffix text))

  (defun contains? (needle text)
    (Impl/contains_QMARK_ needle text))

  (defun includes? (text substr)
    (require-string text "string/includes? text")
    (require-string substr "string/includes? substring")
    (js-call text :includes substr))

  (defun index-of (text value &optional from-index)
    (require-string text "string/index-of text")
    (require-string value "string/index-of search value")
    (let* ((start (if (nullish? from-index) 0 (require-safe-int from-index "string/index-of from-index")))
           (idx (js-call text :indexOf value start)))
      (if (< idx 0) nil idx)))

  (defun last-index-of (text value &optional from-index)
    (require-string text "string/last-index-of text")
    (require-string value "string/last-index-of search value")
    (let ((idx (if (nullish? from-index)
                 (js-call text :lastIndexOf value)
                 (js-call text :lastIndexOf value (require-safe-int from-index "string/last-index-of from-index")))))
      (if (< idx 0) nil idx)))

  (defun strip-prefix (prefix text)
    (Impl/strip_prefix prefix text))

  (defun strip-suffix (suffix text)
    (Impl/strip_suffix suffix text))

  (defun whitespace? (character)
    (Impl/whitespace_QMARK_ character))

  (defun trim (text)
    (Impl/trim text))

  (defun triml (text)
    (require-string text "string/triml text")
    (js-call text :replace (get-trim-left-pattern) ""))

  (defun trimr (text)
    (require-string text "string/trimr text")
    (js-call text :replace (get-trim-right-pattern) ""))

  (defun trim-newline (text)
    (require-string text "string/trim-newline text")
    (let ((end (js-length text)))
      (while (and (> end 0)
                  (let ((code (js-call text :charCodeAt (1- end))))
                    (or (= code 10) (= code 13))))
        (setq end (1- end)))
      (if (= end (js-length text))
        text
        (js-call text :slice 0 end))))

  (defun upper-case (text)
    (require-string text "string/upper-case text")
    (js-call text :toUpperCase))

  (defun lower-case (text)
    (require-string text "string/lower-case text")
    (js-call text :toLowerCase))

  (defun capitalize (text)
    (require-string text "string/capitalize text")
    (if (= (js-length text) 0)
      ""
      (let* ((first-code (js-call text :codePointAt 0))
             (width (if (> first-code 65535) 2 1))
             (head (js-call text :slice 0 width))
             (tail (js-call text :slice width)))
        (str (js-call head :toUpperCase) (js-call tail :toLowerCase)))))

  (defun reverse (text)
    (require-string text "string/reverse text")
    (js-call (js-call (Array/from text) :reverse) :join ""))

  (defun blank? (text)
    (Impl/blank_QMARK_ text))

  (defun join (separator values)
    (Impl/join separator values))

  (defun repeat (count text)
    (Impl/repeat count text))

  (defun re-quote-replacement (replacement)
    (require-string replacement "string/re-quote-replacement value")
    (js-call (js-call replacement :split "$") :join "$$"))

  (defun expand-regex-replacement (template match)
    (let* ((group-count (if (= (value-type match) "string") 1 (Collection/count match)))
           (full (if (= (value-type match) "string") match (Collection/nth match 0)))
           (len (js-length template))
           (out "")
           (index 0))
      (while (< index len)
        (let ((ch (aref template index)))
          (if (and (= ch "$") (< (1+ index) len))
            (let ((next (aref template (1+ index))))
              (cond
                ((= next "$")
                  (setq out (str out "$") index (+ index 2)))
                ((= next "&")
                  (setq out (str out full) index (+ index 2)))
                ((and (>= (js-call next :charCodeAt 0) 48) (<= (js-call next :charCodeAt 0) 57))
                  (let* ((d1 (- (js-call next :charCodeAt 0) 48))
                         (has-d2 (and (< (+ index 2) len)
                                      (>= (js-call (aref template (+ index 2)) :charCodeAt 0) 48)
                                      (<= (js-call (aref template (+ index 2)) :charCodeAt 0) 57)))
                         (d2 (if has-d2 (- (js-call (aref template (+ index 2)) :charCodeAt 0) 48) -1))
                         (two (if has-d2 (+ (* d1 10) d2) -1)))
                    (cond
                      ((and has-d2 (> two 0) (< two group-count))
                        (let ((cap (Collection/nth match two)))
                          (setq out (str out (if (nullish? cap) "" cap))
                                index (+ index 3))))
                      ((and (> d1 0) (< d1 group-count))
                        (let ((cap (Collection/nth match d1)))
                          (setq out (str out (if (nullish? cap) "" cap))
                                index (+ index 2))))
                      ((= d1 0)
                        (setq out (str out full) index (+ index 2)))
                      (t
                        (setq out (str out "$" next) index (+ index 2))))))
                (t
                  (setq out (str out "$" next) index (+ index 2)))))
            (progn
              (setq out (str out ch) index (1+ index))))))
      out))

  (defun match-vector-from-exec (exec-result)
    (if (= (js-length exec-result) 1)
      (aref exec-result 0)
      (let ((builder (transient EMPTY_VECTOR))
            (index 0))
        (while (< index (js-length exec-result))
          (let ((item (aref exec-result index)))
            (conjBang builder (if (undefined? item) nil item)))
          (setq index (1+ index)))
        (persistentBang builder))))

  (defun advance-code-unit-index (text index unicode)
    (if (or (not unicode) (>= (1+ index) (js-length text)))
      (1+ index)
      (let ((first-code (js-call text :charCodeAt index)))
        (if (and (>= first-code 55296) (<= first-code 56319))
          (let ((second-code (js-call text :charCodeAt (1+ index))))
            (if (and (>= second-code 56320) (<= second-code 57343))
              (+ index 2)
              (1+ index)))
          (1+ index)))))

  (defun build-vector-from-parts (parts trim-trailing)
    (let ((limit (js-length parts)))
      (when trim-trailing
        (while (and (> limit 1) (= (aref parts (1- limit)) ""))
          (setq limit (1- limit)))
        (when (and (= limit 1) (= (aref parts 0) ""))
          (setq limit (js-length parts))))
      (let ((builder (transient EMPTY_VECTOR))
            (index 0))
        (while (< index limit)
          (conjBang builder (aref parts index))
          (setq index (1+ index)))
        (persistentBang builder))))

  (defun split-by-string (text sep limit)
    (if (= limit 1)
      (let ((builder (transient EMPTY_VECTOR)))
        (conjBang builder text)
        (persistentBang builder))
      (let ((parts (if (= sep "")
                     (Array/from text)
                     (js-call text :split sep))))
        (if (> limit 0)
          (let ((limited (js-array))
                (idx 0))
            (while (and (< idx (js-length parts)) (< idx (1- limit)))
              (js-call limited :push (aref parts idx))
              (setq idx (1+ idx)))
            (when (< idx (js-length parts))
              (if (= sep "")
                (let ((rest-chars (js-call (js-call parts :slice idx) :join "")))
                  (js-call limited :push rest-chars))
                (js-call limited :push (js-call (js-call parts :slice idx) :join sep))))
            (build-vector-from-parts limited false))
          (build-vector-from-parts parts (= limit 0))))))

  (defun split-by-regexp (text re limit)
    (if (= limit 1)
      (let ((builder (transient EMPTY_VECTOR)))
        (conjBang builder text)
        (persistentBang builder))
      (let* ((matcher (new globalThis/RegExp (get re :source)
                        (if (get re :global) (get re :flags) (str (get re :flags) "g"))))
             (unicode (get matcher :unicode))
             (parts (js-array))
             (cursor 0)
             (done false))
        (while (not done)
          (if (and (> limit 0) (>= (js-length parts) (1- limit)))
            (setq done t)
            (let ((match (js-call matcher :exec text)))
              (if (nil? match)
                (setq done t)
                (let ((match-start (get match :index))
                      (match-len (js-length (aref match 0))))
                  (if (and (= match-len 0) (= match-start cursor) (= (js-length parts) 0))
                    (put matcher :lastIndex (advance-code-unit-index text match-start unicode))
                    (progn
                      (js-call parts :push (js-call text :slice cursor match-start))
                      (setq cursor (+ match-start match-len))
                      (when (= match-len 0)
                        (put matcher :lastIndex (advance-code-unit-index text match-start unicode)))
                      (when (> cursor (js-length text))
                        (setq done t)))))))))
        (js-call parts :push (js-call text :slice cursor))
        (build-vector-from-parts parts (= limit 0)))))

  (defun split (text separator &optional limit)
    (require-string text "string/split text")
    (let ((effective-limit (if (nullish? limit) 0 (require-safe-int limit "string/split limit"))))
      (cond
        ((= (value-type separator) "string")
          (split-by-string text separator effective-limit))
        ((isRegexPattern separator)
          (let* ((flags (regexFlags separator))
                 (gflags (if (js-call flags :includes "g") flags (str flags "g")))
                 (re (new globalThis/RegExp (regexSource separator) gflags)))
            (split-by-regexp text re effective-limit)))
        (t
          (throw (new globalThis/TypeError "string/split separator must be a string or regex pattern"))))))

  (defun split-lines (text)
    (require-string text "string/split-lines text")
    (split-by-regexp text (get-line-break-pattern) 0))

  (defun replace (text match replacement)
    (require-string text "string/replace text")
    (cond
      ((= (value-type match) "string")
        (require-string replacement "string/replace replacement")
        (if (= match "")
          (js-call text :replaceAll "" replacement)
          (js-call (js-call text :split match) :join replacement)))
      ((isRegexPattern match)
        (cond
          ((= (value-type replacement) "function")
            (regexReplace match replacement text))
          ((= (value-type replacement) "string")
            (regexReplace match
              (lambda (matched _idx _full)
                (expand-regex-replacement replacement matched))
              text))
          (t
            (throw (new globalThis/TypeError "string/replace replacement must be a string or function")))))
      (t
        (throw (new globalThis/TypeError "string/replace match must be a string or regex pattern")))))

  (defun replace-first (text match replacement)
    (require-string text "string/replace-first text")
    (cond
      ((= (value-type match) "string")
        (require-string replacement "string/replace-first replacement")
        (let ((idx (js-call text :indexOf match)))
          (if (< idx 0)
            text
            (str (js-call text :slice 0 idx)
                 replacement
                 (js-call text :slice (+ idx (js-length match)))))))
      ((isRegexPattern match)
        (let* ((flags (js-call (regexFlags match) :replace "g" ""))
               (re (new globalThis/RegExp (regexSource match) flags))
               (found (js-call re :exec text)))
          (if (nil? found)
            text
            (let* ((start (get found :index))
                   (end (+ start (js-length (aref found 0))))
                   (matched (match-vector-from-exec found))
                   (sub (cond
                          ((= (value-type replacement) "string")
                            (expand-regex-replacement replacement matched))
                          ((= (value-type replacement) "function")
                            (let ((res (funcall replacement matched start text)))
                              (unless (= (value-type res) "string")
                                (throw (new globalThis/TypeError "string/replace-first callback must return a string")))
                              res))
                          (t
                            (throw (new globalThis/TypeError "string/replace-first replacement must be a string or function"))))))
              (str (js-call text :slice 0 start) sub (js-call text :slice end))))))
      (t
        (throw (new globalThis/TypeError "string/replace-first match must be a string or regex pattern")))))

  (defun escape (text cmap)
    (require-string text "string/escape text")
    (let ((is-map (Collection/isMap cmap))
          (chars (Array/from text))
          (out "")
          (index 0))
      (while (< index (js-length chars))
        (let* ((ch (aref chars index))
               (mapped (cond
                         (is-map (Collection/get cmap ch string-missing))
                         ((and (not (nullish? cmap)) (= (value-type cmap) "object") (Object/hasOwn cmap ch))
                           (aref cmap ch))
                         (t string-missing))))
          (setq out (str out (if (eq mapped string-missing) ch (funcall globalThis/String mapped)))
                index (1+ index))))
      out))

  (export blank? capitalize contains? empty? ends-with? escape includes? index-of join last-index-of lower-case
          re-quote-replacement repeat replace replace-first reverse slice split split-lines starts-at?
          starts-with? strip-prefix strip-suffix trim trim-newline triml trimr upper-case whitespace?))
