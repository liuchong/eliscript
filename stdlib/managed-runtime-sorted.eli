(module eliscript.managed-runtime-sorted
  (import "./order.mjs" comparator compareValues)
  (import "./value.mjs" equalValues)
  (import "./identifier.mjs" isKeyword identifierNamespace identifierName)
  (import "../../stdlib/bit.eli" rotate-left)
  (import "../../stdlib/managed-sorted-state.eli"
    managed-sorted-size managed-sorted-find managed-sorted-assoc managed-sorted-dissoc
    managed-sorted-iterator managed-sorted-transform-iterator managed-sorted-build)
  (import "../../stdlib/managed-literals.eli"
    literal-instance? literal-register-transport literal-entry literal-each literal-mix literal-finish)
  (import "../../stdlib/managed-literal-protocols.eli"
    managed-literal-reduce-iterable managed-literal-sequence-view managed-literal-reduced
    COLLECTION_COUNT COLLECTION_EMPTY COLLECTION_CONJ COLLECTION_GET COLLECTION_ASSOC COLLECTION_CONTAINS
    COLLECTION_DISSOC COLLECTION_DISJ COLLECTION_SEQ COLLECTION_RSEQ COLLECTION_REDUCE COLLECTION_REDUCE_KV
    VALUE_EQUAL VALUE_HASH METADATA_READ METADATA_WITH
    PERSISTENT_MAP_KIND PERSISTENT_MAP_HAS_VALUE_KEY PERSISTENT_SET_KIND PERSISTENT_SET_HAS_VALUE)

  (defconst sorted-map-token (funcall globalThis/Symbol "eliscript.sorted-map.constructor-token"))
  (defconst sorted-set-token (funcall globalThis/Symbol "eliscript.sorted-set.constructor-token"))
  (defconst sorted-map-state (funcall globalThis/Symbol "eliscript.sorted-map.state"))
  (defconst sorted-set-state (funcall globalThis/Symbol "eliscript.sorted-set.state"))
  (defconst not-found (funcall globalThis/Symbol "eliscript.sorted.not-found"))
  (defconst present (Object/freeze (js-object)))
  (defconst bound-tests (new globalThis/Set (js-array "<" "<=" ">" ">=")))
  (defconst DEFAULT_COMPARATOR (comparator compareValues))

  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun object? (value)
    (or (and (not (nil? value)) (= (js* "typeof value") "object")) (callable? value)))
  (defun method (implementation name arity)
    (let ((result (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (Object/defineProperty result "length" (js-object :value arity :configurable t)) result))
  (defun install-method (target key name arity implementation)
    (Object/defineProperty target key (js-object :value (method implementation name arity) :writable t :configurable t)))
  (defun install-getter (target key name implementation)
    (Object/defineProperty target key (js-object :get (method implementation name 0) :configurable t)))
  (defun normalize-comparator (comparison)
    (if (or (eq comparison compareValues) (eq comparison DEFAULT_COMPARATOR)) DEFAULT_COMPARATOR (comparator comparison)))

  (defconst PersistentSortedMap (funcall
    (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
    (lambda (self token root comparison &optional metadata)
      (unless (and (eq token sorted-map-token) (callable? comparison))
        (fail "PersistentSortedMap values must be created with persistentSortedMap or persistentSortedMapBy"))
      (when (undefined? metadata) (setq metadata nil))
      (put self sorted-map-state (Object/freeze (js-object :root root :comparison comparison :metadata metadata)))
      (Object/freeze self)) "PersistentSortedMap"))
  (defconst PersistentSortedSet (funcall
    (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
    (lambda (self token map &optional metadata)
      (unless (and (eq token sorted-set-token) (literal-instance? map PersistentSortedMap))
        (fail "PersistentSortedSet values must be created with persistentSortedSet or persistentSortedSetBy"))
      (when (undefined? metadata) (setq metadata nil))
      (put self sorted-set-state (Object/freeze (js-object :map map :metadata metadata)))
      (Object/freeze self)) "PersistentSortedSet"))
  (Object/defineProperty PersistentSortedMap "length" (js-object :value 3 :configurable t))
  (Object/defineProperty PersistentSortedSet "length" (js-object :value 2 :configurable t))
  (defun make-map (root comparison &optional metadata) (new PersistentSortedMap sorted-map-token root comparison metadata))
  (defun make-set (map &optional metadata) (new PersistentSortedSet sorted-set-token map metadata))
  (defun map-data (self) (aref self sorted-map-state))
  (defun set-data (self) (aref self sorted-set-state))
  (defun set-map-data (self) (map-data (get (set-data self) :map)))

  (defun map-count (self) (managed-sorted-size (get (map-data self) :root)))
  (defun size-getter (self) (get self :count))
  (defun map-comparison (self) (get (map-data self) :comparison))
  (defun map-get (self key &optional notFound)
    (when (undefined? notFound) (setq notFound nil))
    (let* ((state (map-data self)) (found (managed-sorted-find (get state :root) key (get state :comparison))))
      (if (nil? found) notFound (get found :value))))
  (defun map-has (self key)
    (let ((state (map-data self)))
      (not (nil? (managed-sorted-find (get state :root) key (get state :comparison))))))
  (defun map-assoc (self key value)
    (let* ((state (map-data self)) (result (managed-sorted-assoc (get state :root) key value (get state :comparison))))
      (if (get result :changed) (make-map (get result :root) (get state :comparison) (get state :metadata)) self)))
  (defun map-dissoc (self key)
    (let* ((state (map-data self)) (result (managed-sorted-dissoc (get state :root) key (get state :comparison))))
      (if (get result :removed) (make-map (get result :root) (get state :comparison) (get state :metadata)) self)))
  (defun map-entries (self &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (state (map-data self)))
      (managed-sorted-iterator (get state :root) (get state :comparison) ascending nil nil 1)))
  (defun map-keys (self &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (entries (js-call self :entries ascending)))
      (managed-sorted-transform-iterator (lambda () entries) 0)))
  (defun map-values (self &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (entries (js-call self :entries ascending)))
      (managed-sorted-transform-iterator (lambda () entries) 1)))
  (defun map-empty (self)
    (let ((state (map-data self))) (make-map nil (get state :comparison) (get state :metadata))))
  (defun map-conj (self entry)
    (let ((pair (literal-entry entry))) (js-call self :assoc (get pair 0) (get pair 1))))
  (defun map-sequence (self)
    (if (= (get self :count) 0) nil
      (managed-literal-sequence-view (lambda () (js-call self :entries)) (get self :count))))
  (defun map-reverse-sequence (self)
    (if (= (get self :count) 0) nil
      (managed-literal-sequence-view (lambda () (js-call self :entries false)) (get self :count))))
  (defun collection-reduce (self reducer &rest initial) (managed-literal-reduce-iterable self reducer initial))

  ;; Destructuring in the original map protocols consumes at most two values,
  ;; unlike the strict two-value entry check used by public conj/from.
  (defun protocol-pair (entry)
    (let* ((iterator (js-call (aref entry (get globalThis/Symbol :iterator)) :call entry))
           (next nil) (done false) (key undefined) (value undefined))
      (unless (object? iterator) (fail "iterator must be an object"))
      (setq next (get iterator :next))
      (let ((step (js-call next :call iterator)))
        (unless (object? step) (fail "iterator result must be an object"))
        (setq done (funcall globalThis/Boolean (get step :done)))
        (unless done
          (setq key (get step :value))
          (let ((second (js-call next :call iterator)))
            (unless (object? second) (fail "iterator result must be an object"))
            (setq done (funcall globalThis/Boolean (get second :done)))
            (unless done (setq value (get second :value))))))
      (unless done
        (let ((close (get iterator :return)))
          (unless (nullish? close)
            (let ((closed (js-call close :call iterator)))
              (unless (object? closed) (fail "iterator return must return an object"))))))
      (js-array key value)))
  (defun map-reduce-kv (self reducer initial)
    (managed-literal-reduce-iterable self (lambda (result entry)
      (let ((pair (protocol-pair entry))) (funcall reducer result (get pair 0) (get pair 1)))) (js-array initial)))
  (defun map-has-value-key (self key)
    (let* ((state (map-data self)) (found (managed-sorted-find (get state :root) key (get state :comparison))))
      (and (not (nil? found)) (equalValues (get found :key) key))))
  (defun map-equal (self other equal)
    (if (not (and (not (nullish? other)) (eq (aref other PERSISTENT_MAP_KIND) t)
                  (callable? (aref other PERSISTENT_MAP_HAS_VALUE_KEY)) (= (get other :count) (get self :count)))) false
      (managed-literal-reduce-iterable self (lambda (previous entry)
        (let ((pair (protocol-pair entry)))
          (if (and (funcall globalThis/Boolean (js-call (aref other PERSISTENT_MAP_HAS_VALUE_KEY) :call other (get pair 0)))
                   (funcall globalThis/Boolean (funcall equal (get pair 1) (js-call other :get (get pair 0)))))
            t (managed-literal-reduced false)))) (js-array t))))
  (defun unordered-hash (self hash map-mode)
    (let ((sum 0) (xor 0) (product 1) (count 0))
      (literal-each self (lambda (entry)
        (let ((item (uint32 (if map-mode
                      (literal-finish (literal-mix (literal-mix 982610667 (funcall hash (get entry 0))) (funcall hash (get entry 1))) 2)
                      (funcall hash entry)))))
          (setq sum (uint32 (+ sum item)) xor (uint32 (bit-xor xor (rotate-left item (bit-and item 31))))
            product (uint32 (imul32 product (bit-or item 1))) count (1+ count)))))
      (literal-finish (literal-mix (literal-mix (literal-mix (if map-mode 1821285621 1374139181) sum) xor) product) count)))
  (defun map-hash (self hash) (unordered-hash self hash t))
  (defun map-meta (self) (get (map-data self) :metadata))
  (defun map-with-meta (self metadata)
    (let ((state (map-data self)))
      (if (eq metadata (get state :metadata)) self (make-map (get state :root) (get state :comparison) metadata))))
  (defun map-iterate (self) (js-call self :entries))
  (defun map-tag (self) "EliscriptPersistentSortedMap")
  (defun brand-true (self) t)

  (defun set-count (self) (get (get (set-data self) :map) :count))
  (defun set-comparison (self) (get (get (set-data self) :map) :comparator))
  (defun set-has (self value) (js-call (get (set-data self) :map) :has value))
  (defun set-conj (self value)
    (let* ((state (set-data self)) (previous (get state :map)) (map (js-call previous :assoc value present)))
      (if (eq map previous) self (make-set map (get state :metadata)))))
  (defun set-disj (self value)
    (let* ((state (set-data self)) (previous (get state :map)) (map (js-call previous :dissoc value)))
      (if (eq map previous) self (make-set map (get state :metadata)))))
  (defun set-values (self &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (state (set-map-data self)))
      (managed-sorted-iterator (get state :root) (get state :comparison) ascending nil nil 2)))
  (defun set-keys (self &rest directions)
    (js-call self :values (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0))))
  (defun set-entries (self &rest directions)
    ;; This is the body of a generator in the original API: values() lookup
    ;; remains deferred until the first next, including user replacements.
    (let ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0))))
      (managed-sorted-transform-iterator (lambda () (js-call self :values ascending)) 2)))
  (defun set-empty (self)
    (let ((state (set-data self)))
      (make-set (js-call (aref (get state :map) COLLECTION_EMPTY) :call (get state :map)) (get state :metadata))))
  (defun set-get (self value &optional notFound)
    (when (undefined? notFound) (setq notFound nil))
    (let* ((state (set-map-data self)) (found (managed-sorted-find (get state :root) value (get state :comparison))))
      (if (nil? found) notFound (get found :key))))
  (defun set-sequence (self)
    (if (= (get self :count) 0) nil
      (managed-literal-sequence-view (lambda () (js-call self :values)) (get self :count))))
  (defun set-reverse-sequence (self)
    (if (= (get self :count) 0) nil
      (managed-literal-sequence-view (lambda () (js-call self :values false)) (get self :count))))
  (defun set-has-value (self value equal)
    (let* ((state (set-map-data self)) (found (managed-sorted-find (get state :root) value (get state :comparison))))
      (and (not (nil? found)) (funcall equal (get found :key) value))))
  (defun set-equal (self other equal)
    (if (not (and (not (nullish? other)) (eq (aref other PERSISTENT_SET_KIND) t)
                  (callable? (aref other PERSISTENT_SET_HAS_VALUE)) (= (get other :count) (get self :count)))) false
      (managed-literal-reduce-iterable self (lambda (previous value)
        (if (funcall globalThis/Boolean (js-call (aref other PERSISTENT_SET_HAS_VALUE) :call other value equal))
          t (managed-literal-reduced false))) (js-array t))))
  (defun set-hash (self hash) (unordered-hash self hash false))
  (defun set-meta (self) (get (set-data self) :metadata))
  (defun set-with-meta (self metadata)
    (let ((state (set-data self)))
      (if (eq metadata (get state :metadata)) self (make-set (get state :map) metadata))))
  (defun set-iterate (self) (js-call self :values))
  (defun set-tag (self) "EliscriptPersistentSortedSet")

  (defun map-static-empty (self &rest comparisons)
    (emptySortedMapBy (if (or (= (js-length comparisons) 0) (undefined? (aref comparisons 0))) compareValues (aref comparisons 0))))
  (defun map-static-from (self entries &rest options)
    (if (and (literal-instance? entries PersistentSortedMap) (= (js-length options) 0)) entries
      (let ((result (emptySortedMapBy (if (or (= (js-length options) 0) (undefined? (get options 0))) compareValues (get options 0)))))
        (literal-each entries (lambda (entry)
          (let ((pair (literal-entry entry))) (setq result (js-call result :assoc (get pair 0) (get pair 1)))))) result)))
  (defun set-static-empty (self &rest comparisons)
    (emptySortedSetBy (if (or (= (js-length comparisons) 0) (undefined? (aref comparisons 0))) compareValues (aref comparisons 0))))
  (defun set-static-from (self values &rest options)
    (if (and (literal-instance? values PersistentSortedSet) (= (js-length options) 0)) values
      (let ((result (emptySortedSetBy (if (or (= (js-length options) 0) (undefined? (get options 0))) compareValues (get options 0)))))
        (literal-each values (lambda (value) (setq result (js-call result :conj value)))) result)))

  (install-method PersistentSortedMap "empty" "empty" 0 map-static-empty)
  (install-method PersistentSortedMap "from" "from" 1 map-static-from)
  (install-method PersistentSortedSet "empty" "empty" 0 set-static-empty)
  (install-method PersistentSortedSet "from" "from" 1 set-static-from)
  (let ((prototype (get PersistentSortedMap :prototype)))
    (install-getter prototype "count" "get count" map-count)
    (install-getter prototype "size" "get size" size-getter)
    (install-getter prototype "comparator" "get comparator" map-comparison)
    (install-method prototype "get" "get" 1 map-get)
    (install-method prototype "has" "has" 1 map-has)
    (install-method prototype "assoc" "assoc" 2 map-assoc)
    (install-method prototype "dissoc" "dissoc" 1 map-dissoc)
    (install-method prototype "entries" "entries" 0 map-entries)
    (install-method prototype "keys" "keys" 0 map-keys)
    (install-method prototype "values" "values" 0 map-values)
    (install-method prototype COLLECTION_COUNT "[ICounted.count]" 0 (lambda (self) (get self :count)))
    (install-method prototype COLLECTION_EMPTY "[IEmptyable.empty]" 0 map-empty)
    (install-method prototype COLLECTION_CONJ "[IConj.conj]" 1 map-conj)
    (install-method prototype COLLECTION_GET "[ILookup.get]" 1 (lambda (self key &optional notFound) (js-call self :get key notFound)))
    (install-method prototype COLLECTION_ASSOC "[IAssociative.assoc]" 2 (lambda (self key value) (js-call self :assoc key value)))
    (install-method prototype COLLECTION_CONTAINS "[IAssociative.contains]" 1 (lambda (self key) (js-call self :has key)))
    (install-method prototype COLLECTION_DISSOC "[IMap.dissoc]" 1 (lambda (self key) (js-call self :dissoc key)))
    (install-method prototype COLLECTION_SEQ "[ISeqable.seq]" 0 map-sequence)
    (install-method prototype COLLECTION_RSEQ "[IReversible.rseq]" 0 map-reverse-sequence)
    (install-method prototype COLLECTION_REDUCE "[IReduce.reduce]" 1 collection-reduce)
    (install-method prototype COLLECTION_REDUCE_KV "[IKVReduce.reduceKV]" 2 map-reduce-kv)
    (install-method prototype PERSISTENT_MAP_HAS_VALUE_KEY "[eliscript.persistent-map.has-value-key]" 1 map-has-value-key)
    (install-getter prototype PERSISTENT_MAP_KIND "get [eliscript.persistent-map.kind]" brand-true)
    (install-method prototype VALUE_EQUAL "[IEquiv.equal]" 2 map-equal)
    (install-method prototype VALUE_HASH "[IHash.hash]" 1 map-hash)
    (install-method prototype METADATA_READ "[IMeta.meta]" 0 map-meta)
    (install-method prototype METADATA_WITH "[IWithMeta.withMeta]" 1 map-with-meta)
    (install-method prototype (get globalThis/Symbol :iterator) "[Symbol.iterator]" 0 map-iterate)
    (install-getter prototype (get globalThis/Symbol :toStringTag) "get [Symbol.toStringTag]" map-tag))
  (let ((prototype (get PersistentSortedSet :prototype)))
    (install-getter prototype "count" "get count" set-count)
    (install-getter prototype "size" "get size" size-getter)
    (install-getter prototype "comparator" "get comparator" set-comparison)
    (install-method prototype "has" "has" 1 set-has)
    (install-method prototype "conj" "conj" 1 set-conj)
    (install-method prototype "disj" "disj" 1 set-disj)
    (install-method prototype "values" "values" 0 set-values)
    (install-method prototype "keys" "keys" 0 set-keys)
    (install-method prototype "entries" "entries" 0 set-entries)
    (install-method prototype COLLECTION_COUNT "[ICounted.count]" 0 (lambda (self) (get self :count)))
    (install-method prototype COLLECTION_EMPTY "[IEmptyable.empty]" 0 set-empty)
    (install-method prototype COLLECTION_CONJ "[IConj.conj]" 1 (lambda (self value) (js-call self :conj value)))
    (install-method prototype COLLECTION_DISJ "[ISet.disj]" 1 (lambda (self value) (js-call self :disj value)))
    (install-method prototype COLLECTION_GET "[ILookup.get]" 1 set-get)
    (install-method prototype COLLECTION_CONTAINS "[IAssociative.contains]" 1 (lambda (self value) (js-call self :has value)))
    (install-method prototype COLLECTION_SEQ "[ISeqable.seq]" 0 set-sequence)
    (install-method prototype COLLECTION_RSEQ "[IReversible.rseq]" 0 set-reverse-sequence)
    (install-method prototype COLLECTION_REDUCE "[IReduce.reduce]" 1 collection-reduce)
    (install-method prototype PERSISTENT_SET_HAS_VALUE "[eliscript.persistent-set.has-value]" 2 set-has-value)
    (install-getter prototype PERSISTENT_SET_KIND "get [eliscript.persistent-set.kind]" brand-true)
    (install-method prototype VALUE_EQUAL "[IEquiv.equal]" 2 set-equal)
    (install-method prototype VALUE_HASH "[IHash.hash]" 1 set-hash)
    (install-method prototype METADATA_READ "[IMeta.meta]" 0 set-meta)
    (install-method prototype METADATA_WITH "[IWithMeta.withMeta]" 1 set-with-meta)
    (install-method prototype (get globalThis/Symbol :iterator) "[Symbol.iterator]" 0 set-iterate)
    (install-getter prototype (get globalThis/Symbol :toStringTag) "get [Symbol.toStringTag]" set-tag))

  (defconst EMPTY_SORTED_MAP (make-map nil DEFAULT_COMPARATOR))
  (defconst EMPTY_SORTED_SET (make-set EMPTY_SORTED_MAP))
  (defun emptySortedMapBy (comparison)
    (let ((normalized (normalize-comparator comparison)))
      (if (eq normalized DEFAULT_COMPARATOR) EMPTY_SORTED_MAP (make-map nil normalized))))
  (defun emptySortedSetBy (comparison)
    (let ((map (emptySortedMapBy comparison))) (if (eq map EMPTY_SORTED_MAP) EMPTY_SORTED_SET (make-set map))))
  (defun require-even (values label)
    (unless (= (% (js-length values) 2) 0)
      (fail (str label " expects an even number of key/value forms"))))
  (defun populate-map (map values)
    (let ((result map) (index 0))
      (while (< index (js-length values))
        (setq result (js-call result :assoc (get values index) (get values (1+ index))) index (+ index 2))) result))
  (defun persistentSortedMap (&rest key-values)
    (require-even key-values "persistentSortedMap") (populate-map EMPTY_SORTED_MAP key-values))
  (defun persistentSortedMapBy (comparison &rest key-values)
    (require-even key-values "persistentSortedMapBy") (populate-map (emptySortedMapBy comparison) key-values))
  (defun persistentSortedSet (&rest values)
    (let ((result EMPTY_SORTED_SET))
      (literal-each values (lambda (value) (setq result (js-call result :conj value)))) result))
  (defun persistentSortedSetBy (comparison &rest values)
    (let ((result (emptySortedSetBy comparison)))
      (literal-each values (lambda (value) (setq result (js-call result :conj value)))) result))
  (defun isPersistentSortedMap (value) (literal-instance? value PersistentSortedMap))
  (defun isPersistentSortedSet (value) (literal-instance? value PersistentSortedSet))
  (defun isPersistentSortedCollection (value) (or (isPersistentSortedMap value) (isPersistentSortedSet value)))

  (defun sorted-state (collection)
    (cond
      ((isPersistentSortedMap collection)
        (let ((state (map-data collection)))
          (js-object :root (get state :root) :comparison (get state :comparison)
            :factory (lambda (ascending start end)
              (managed-sorted-iterator (get state :root) (get state :comparison) ascending start end 1)))))
      ((isPersistentSortedSet collection)
        (let ((state (set-map-data collection)))
          (js-object :root (get state :root) :comparison (get state :comparison)
            :factory (lambda (ascending start end)
              (managed-sorted-iterator (get state :root) (get state :comparison) ascending start end 2)))))
      (t (fail "operation requires a persistent sorted collection"))))
  (defun require-boolean (value label)
    (unless (= (js* "typeof value") "boolean") (fail (str label " must be a boolean"))) value)
  (defun sortedComparator (collection) (get (sorted-state collection) :comparison))
  (defun sortedSequence (collection &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (_checked (require-boolean ascending "sortedSequence ascending"))
           (state (sorted-state collection)))
      (if (nil? (get state :root)) nil
        (managed-literal-sequence-view (lambda () (funcall (get state :factory) ascending nil nil))
          (get (get state :root) :size)))))
  (defun sequence-or-null (factory)
    (let ((probe (funcall factory)) (done false))
      (try (setq done (funcall globalThis/Boolean (get (js-call probe :next) :done)))
        (finally (when (callable? (get probe :return)) (js-call probe :return))))
      (if done nil (managed-literal-sequence-view factory))))
  (defun sortedSequenceFrom (collection key &rest directions)
    (let* ((ascending (if (or (= (js-length directions) 0) (undefined? (aref directions 0))) t (aref directions 0)))
           (inclusive (if (or (< (js-length directions) 2) (undefined? (aref directions 1))) t (aref directions 1)))
           (_ascending (require-boolean ascending "sortedSequenceFrom ascending"))
           (_inclusive (require-boolean inclusive "sortedSequenceFrom inclusive"))
           (state (sorted-state collection)) (start (js-object :key key :inclusive inclusive)))
      (sequence-or-null (lambda () (funcall (get state :factory) ascending start nil)))))
  (defun bound-test-name (test)
    (let ((name (if (and (isKeyword test) (nil? (identifierNamespace test))) (identifierName test) test)))
      (unless (and (= (js* "typeof name") "string") (js-call bound-tests :has name))
        (fail "sorted bound test must be one of :<, :<=, :>, or :>=")) name))
  (defun range-bounds (bounds)
    (unless (or (= (js-length bounds) 2) (= (js-length bounds) 4))
      (fail "subsequence expects one or two test/key bounds"))
    (let* ((first-test (bound-test-name (get bounds 0)))
           (first (js-object :key (get bounds 1) :inclusive (js-call first-test :includes "="))))
      (if (= (js-length bounds) 2)
        (if (js-call first-test :startsWith ">") (js-object :lower first :upper nil) (js-object :lower nil :upper first))
        (let ((second-test (bound-test-name (get bounds 2))))
          (unless (and (js-call first-test :startsWith ">") (js-call second-test :startsWith "<"))
            (fail "two-bound subsequence requires a lower :>/:>= bound then an upper :</:<= bound"))
          (js-object :lower first :upper (js-object :key (get bounds 3) :inclusive (js-call second-test :includes "=")))))))
  (defun range-sequence (collection ascending bounds)
    (let* ((state (sorted-state collection)) (normalized (range-bounds bounds))
           (start (get normalized (if ascending "lower" "upper")))
           (end (get normalized (if ascending "upper" "lower"))))
      (sequence-or-null (lambda () (funcall (get state :factory) ascending start end)))))
  (defun subsequence (collection &rest bounds) (range-sequence collection t bounds))
  (defun reverseSubsequence (collection &rest bounds) (range-sequence collection false bounds))

  (defun readSortedMapState (value)
    (if (and (object? value) (isPersistentSortedMap value))
      (let ((descriptor (Object/getOwnPropertyDescriptor value sorted-map-state)))
        (if (and (not (undefined? descriptor)) (Object/hasOwn descriptor "value")) (get descriptor :value) undefined)) undefined))
  (defun readSortedSetState (value)
    (if (and (object? value) (isPersistentSortedSet value))
      (let ((descriptor (Object/getOwnPropertyDescriptor value sorted-set-state)))
        (if (and (not (undefined? descriptor)) (Object/hasOwn descriptor "value")) (get descriptor :value) undefined)) undefined))
  (defun materializeSortedMap (entries comparison &optional metadata)
    (unless (callable? comparison) (fail "sorted map comparison must be a function"))
    (make-map (managed-sorted-build entries 0 (js-length entries) t present) comparison metadata))
  (defun materializeSortedSet (values comparison &optional metadata)
    (unless (callable? comparison) (fail "sorted set comparison must be a function"))
    (make-set (make-map (managed-sorted-build values 0 (js-length values) false present) comparison) metadata))
  (defun isDefaultSortedComparator (value) (eq value DEFAULT_COMPARATOR))
  (defun defaultSortedComparator () DEFAULT_COMPARATOR)
  (literal-register-transport "sorted-default-comparator" isDefaultSortedComparator
    (lambda (value) (js-object :kind "sorted-default-comparator"))
    (lambda (record) DEFAULT_COMPARATOR))
  (literal-register-transport "sorted-map"
    (lambda (value) (and (isPersistentSortedMap value) (not (undefined? (readSortedMapState value))) (Object/isFrozen value)))
    (lambda (value)
      (let ((state (readSortedMapState value)))
        (js-object :kind "sorted-map" :entries (Array/from value) :comparison (get state :comparison) :metadata (get state :metadata))))
    (lambda (record) (materializeSortedMap (get record :entries) (get record :comparison) (get record :metadata nil))))
  (literal-register-transport "sorted-set"
    (lambda (value) (and (isPersistentSortedSet value) (not (undefined? (readSortedSetState value))) (Object/isFrozen value)))
    (lambda (value)
      (let ((state (readSortedSetState value)))
        (js-object :kind "sorted-set" :values (Array/from value) :comparison (get (get state :map) :comparator) :metadata (get state :metadata))))
    (lambda (record) (materializeSortedSet (get record :values) (get record :comparison) (get record :metadata nil))))
  (export PersistentSortedMap PersistentSortedSet EMPTY_SORTED_MAP EMPTY_SORTED_SET
    emptySortedMapBy emptySortedSetBy persistentSortedMap persistentSortedMapBy persistentSortedSet persistentSortedSetBy
    isPersistentSortedMap isPersistentSortedSet isPersistentSortedCollection sortedComparator sortedSequence sortedSequenceFrom
    subsequence reverseSubsequence readSortedMapState readSortedSetState materializeSortedMap materializeSortedSet
    isDefaultSortedComparator defaultSortedComparator))
