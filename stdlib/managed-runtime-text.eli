(module eliscript.managed-runtime-text
  (import "../../stdlib/core/text.eli"
    blank? contains? empty? ends-with? join repeat slice starts-at? starts-with?
    strip-prefix strip-suffix trim whitespace?)
  (defun blank (text) (blank? text))
  (defun contains (needle text) (contains? needle text))
  (defun empty (text) (empty? text))
  (defun endsWith (suffix text) (ends-with? suffix text))
  (defun startsAt (prefix offset text) (starts-at? prefix offset text))
  (defun startsWith (prefix text) (starts-with? prefix text))
  (defun stripPrefix (prefix text) (strip-prefix prefix text))
  (defun stripSuffix (suffix text) (strip-suffix suffix text))
  (defun whitespace (character) (whitespace? character))
  (export blank contains empty endsWith join repeat slice startsAt startsWith stripPrefix stripSuffix trim whitespace))
