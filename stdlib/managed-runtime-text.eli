(module eliscript.managed-runtime-text
  (import "../../stdlib/core/text.eli"
    blank? contains? empty? ends-with? join repeat slice starts-at? starts-with?
    strip-prefix strip-suffix trim whitespace?)
  (defconst blank blank?)
  (defconst contains contains?)
  (defconst empty empty?)
  (defconst endsWith ends-with?)
  (defconst startsAt starts-at?)
  (defconst startsWith starts-with?)
  (defconst stripPrefix strip-prefix)
  (defconst stripSuffix strip-suffix)
  (defconst whitespace whitespace?)
  (export blank contains empty endsWith join repeat slice startsAt startsWith stripPrefix stripSuffix trim whitespace))
