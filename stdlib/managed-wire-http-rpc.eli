(module eliscript.managed-wire-http-rpc
  (import "../../platform/http.mjs" :as Host)
  (import "../../stdlib/managed-literals.eli" literal-each)

  (defconst media-type "text/markdown; charset=utf-8")
  (defun truth (value) (funcall globalThis/Boolean value))
  (defun coalesce (value fallback) (if (or (nil? value) (undefined? value)) fallback value))
  (defun option (object key fallback)
    (let ((value (get object key))) (if (undefined? value) (funcall fallback) value)))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun instance? (value constructor)
    (unless (or (= (js* "typeof constructor") "function")
                (and (not (nil? constructor)) (= (js* "typeof constructor") "object")))
      (fail "Right-hand side of instanceof is not an object"))
    (let ((method (get constructor (get globalThis/Symbol :hasInstance))))
      (when (nullish? method)
        (unless (= (js* "typeof constructor") "function")
          (fail "Right-hand side of instanceof is not callable"))
        (setq method (get (get globalThis/Function :prototype) (get globalThis/Symbol :hasInstance))))
      (funcall globalThis/Boolean (Reflect/apply method constructor (js-array value)))))
  (defun line (value)
    (js-call (funcall globalThis/String value) :replace (new globalThis/RegExp "[\\r\\n]" "gu") " "))
  (defun public-path (value)
    (when (or (not (= (js* "typeof value") "string"))
              (not (js-call value :startsWith "/"))
              (js-call (new globalThis/RegExp "[\\s?#`\\\\]" "u") :test value)
              (js-call value :includes "//")
              (and (not (= value "/")) (js-call value :endsWith "/"))
              (js-call (js-call value :split "/") :some (lambda (part) (or (= part ".") (= part ".."))))
              (js-call (js-array "/.well-known/gepo" "/.gepo") :some
                (lambda (prefix) (or (= value prefix) (js-call value :startsWith (str prefix "/")))))
              (not (= (get (new (get Host/globals :URL) value "https://local.invalid") :pathname) value)))
      (fail "Expected a canonical public operation path"))
    value)
  (defun abort-reason (signal)
    (let ((reason (get signal :reason)))
      (if (or (nil? reason) (undefined? reason)) (new globalThis/Error "HTTP request aborted") reason)))
  (defun target (value)
    (let ((url (new (get Host/globals :URL) value)))
      (when (or (not (js-call (js-array "http:" "https:") :includes (get url :protocol)))
                (truth (get url :username)) (truth (get url :password)))
        (fail "Expected an HTTP URL without credentials"))
      (put url :hash "") url))
  (defun parent (value)
    (if (= value "/") nil
      (let ((part (js-call value :slice 0 (js-call value :lastIndexOf "/"))))
        (if (= part "") "/" part))))

  ;; Object spread creates own data fields, including a literal __proto__ key.
  (defun spread-into (result source)
    (unless (or (nil? source) (undefined? source))
      (let ((boxed (funcall globalThis/Object source)))
        (literal-each (Reflect/ownKeys boxed)
          (lambda (key)
            (let ((descriptor (Object/getOwnPropertyDescriptor boxed key)))
              (when (and (not (undefined? descriptor)) (truth (get descriptor :enumerable)))
                (Object/defineProperty result key
                  (js-object :value (get boxed key) :writable t :enumerable t :configurable t))))))))
    result)
  (defun defineOperation (options)
    (public-path (get options :path))
    (let ((execute (get options :execute)))
      (unless (= (js* "typeof execute") "function")
        (fail "Operation requires an execute function")))
    (Object/freeze (spread-into
      (js-object :title (get options :path) :summary "Invoke this operation."
        :contentType "application/json" :request "Body is service-defined."
        :success "Use HTTP status and response representation." :failures (js-array)
        :effect "Service-defined." :retry "No automatic POST retry.") options)))
  (defun usageMarkdown (operation)
    (public-path (get operation :path))
    (str "# " (line (let ((title (get operation :title)))
      (if (or (nil? title) (undefined? title)) (get operation :path) title)))
      "\n\nPOST `" (get operation :path) "` with Content-Type: "
      (line (coalesce (get operation :contentType) "application/json")) ".\n\nPurpose: "
      (line (coalesce (get operation :summary) "")) "\nRequest: "
      (line (coalesce (get operation :request) "Body is service-defined.")) "\nSuccess: "
      (line (coalesce (get operation :success) "Use HTTP status and response representation.")) "\nFailures: "
      (let ((failures (js-call (let ((value (get operation :failures)))
                          (if (or (nil? value) (undefined? value)) (js-array) value)) :join "; ")))
        (line (if (truth failures) failures "Use applicable HTTP error statuses.")))
      "\nEffect: " (line (coalesce (get operation :effect) "Service-defined."))
      "\nRetry: " (line (coalesce (get operation :retry) "No automatic POST retry.")) "\n"))
  (defun directory-node () (js-object :operation nil :children (new globalThis/Set)))
  (defun tree (operations)
    (let ((nodes (new globalThis/Map (js-array (js-array "/" (directory-node))))))
      (literal-each operations
        (lambda (operation)
          (public-path (get operation :path))
          (let ((existing (js-call nodes :get (get operation :path))))
            (when (and (not (undefined? existing)) (truth (get existing :operation)))
              (fail "Duplicate operation path")))
          (unless (js-call nodes :has (get operation :path))
            (js-call nodes :set (get operation :path) (directory-node)))
          (put (js-call nodes :get (get operation :path)) :operation operation)
          (let ((child (get operation :path)))
            (while (not (nil? (parent child)))
              (let ((directory (parent child)))
                (unless (js-call nodes :has directory) (js-call nodes :set directory (directory-node)))
                (js-call (get (js-call nodes :get directory) :children) :add child)
                (setq child directory))))))
      nodes))
  (defun pathIndexMarkdown (title operations &optional location)
    (when (undefined? location) (setq location "/"))
    (public-path location)
    (let* ((nodes (tree operations)) (node (js-call nodes :get location)))
      (if (undefined? node) nil
        (let* ((children (js-call (Array/from (get node :children)) :sort))
               (kind (if (truth (get node :operation))
                         (if (> (js-length children) 0) "operation and directory" "operation") "directory"))
               (result (str "# " (line (coalesce title "Service")) "\n\nGEPO 0.2\nPath: `" location
                 "`\nParent: " (if (nil? (parent location)) "none" (str "`" (parent location) "`"))
                 "\nKind: " kind "\n")))
          (when (truth (get node :operation))
            (setq result (str result "\n## Usage\n\n" (usageMarkdown (get node :operation)))))
          (setq result (str result "\n## Children\n\n"))
          (if (= (js-length children) 0)
              (setq result (str result (if (truth (get node :operation))
                "No immediate child paths.\n" "The visible capability set is empty.\n")))
            (literal-each children
              (lambda (child)
                (let ((operation (get (js-call nodes :get child) :operation)))
                  (setq result (str result "- `" child "` — "
                    (line (if (or (nil? operation) (undefined? operation)) "Directory"
                            (coalesce (get operation :summary) "Directory"))) "\n"))))))
          result))))
  (defun discoveryCandidates (value)
    (let ((url (target value)))
      (put url :search "")
      (let* ((root (get url :origin)) (candidates (js-array)))
        (unless (= (get url :pathname) "/") (js-call candidates :push (str (get url :href) "?.gepo")))
        (js-call candidates :push (str root "/?.gepo") (str root "/.gepo") (str root "/.well-known/gepo"))
        (Array/from (new globalThis/Set candidates)))))
  (defun classifyDiscovery (response)
    (if (or (< (get response :status) 200) (>= (get response :status) 300)
            (not (truth (get response :contentType))))
        (js-object :accepted false :paths (js-array) :empty false)
      (let ((type (js-call (js-call (get (js-call (get response :contentType) :split ";") 0) :trim) :toLowerCase)))
        (if (or (not (js-call (js-array "text/markdown" "text/plain") :includes type))
                (not (js-call (new globalThis/RegExp "\\bGEPO\\b" "u") :test (get response :body))))
            (js-object :accepted false :paths (js-array) :empty false)
          (let* ((children (js-call (js-call (get response :body) :split
                              (new globalThis/RegExp "^## Children\\s*$" "mu")) :at -1))
                 (matches (Array/from (js-call children :matchAll
                              (new globalThis/RegExp "^\\s*-\\s+`(/[^`\\s]*)`" "gmu"))))
                 (paths (Array/from (new globalThis/Set (js-call matches :map (lambda (match) (get match 1)))))))
            (when (and (= (js-length paths) 0)
                       (js-call (new globalThis/RegExp "^Path: `/`$" "mu") :test (get response :body))
                       (js-call (new globalThis/RegExp "^Kind: operation$" "mu") :test (get response :body)))
              (js-call paths :push "/"))
            (let ((empty (js-call (new globalThis/RegExp "visible capability set is empty|no visible (?:operations|capabilities)" "iu")
                                 :test children)))
              (js-object :accepted (or (> (js-length paths) 0) empty) :paths paths :empty empty)))))))

  (defun object? (value)
    (or (and (not (nil? value)) (= (js* "typeof value") "object"))
        (= (js* "typeof value") "function")))
  (defun iterator-close (iterator)
    (let ((close (get iterator :return)))
      (unless (or (nil? close) (undefined? close))
        (let ((result (Reflect/apply close iterator (js-array))))
          (unless (object? result) (fail "Iterator result is not an object"))))))
  (defun iteration (iterable)
    (let* ((method (get iterable (get globalThis/Symbol :iterator)))
           (iterator (Reflect/apply method iterable (js-array))))
      (unless (object? iterator) (fail "Iterator result is not an object"))
      (js-object :iterator iterator :next (get iterator :next))))
  (defun iteration-step (cursor)
    (let ((step (Reflect/apply (get cursor :next) (get cursor :iterator) (js-array))))
      (unless (object? step) (fail "Iterator result is not an object")) step))
  (defun close-abrupt (cursor error)
    (try (iterator-close (get cursor :iterator)) (catch ignored nil))
    (throw error))

  (defun markdown-response (body &optional status headers)
    (when (undefined? status) (setq status 200))
    (when (undefined? headers) (setq headers (js-object)))
    (new (get Host/globals :Response) body
      (js-object :status status :headers (spread-into
        (js-object "Content-Type" media-type "Cache-Control" "private, no-store") headers))))
  (defun createService (&optional options)
    (when (undefined? options) (setq options (js-object)))
    (let* ((title (option options "title" (lambda () "Service")))
           (operations (option options "operations" (lambda () (js-array))))
           (authorize (option options "authorize" (lambda () (lambda () t))))
           (visible (option options "visible" (lambda () (lambda () t))))
           (entries (js-call operations :map defineOperation)))
      (tree entries)
      (async (request)
        (let* ((url (new (get Host/globals :URL) (get request :url)))
               (fixed-entry (js-call (js-array "/.gepo" "/.well-known/gepo") :includes (get url :pathname)))
               (discovery (and (js-call (js-array "GET" "HEAD") :includes (get request :method))
                              (or (js-call (get url :searchParams) :has ".gepo") fixed-entry)))
               (location (if fixed-entry "/" (get url :pathname)))
               (available (js-array)))
          (let ((cursor (iteration entries)) (done false))
            (while (not done)
              (let ((step (iteration-step cursor)))
                (if (truth (get step :done)) (setq done t)
                  (let ((operation (get step :value)))
                    (try
                      (when (truth (await (funcall visible request operation)))
                        (js-call available :push operation))
                      (catch error (close-abrupt cursor error))))))))
          (let* ((nodes (tree available)) (node (js-call nodes :get location)))
            (if (undefined? node) (markdown-response "Unknown path" 404)
              (let ((permission (await (funcall authorize request (get node :operation)
                      (if discovery "index" (if (= (get request :method) "POST") "invoke" "usage"))))))
                (cond
                  ((instance? permission (get Host/globals :Response)) permission)
                  ((not (eq permission t)) (markdown-response "Forbidden" 403))
                  (t
                    (let ((allow (if (and (truth (get node :operation)) (not fixed-entry))
                                   "GET, HEAD, OPTIONS, POST" "GET, HEAD, OPTIONS")))
                      (cond
                        ((= (get request :method) "OPTIONS")
                          (new (get Host/globals :Response) nil (js-object :status 204 :headers (js-object :Allow allow))))
                        ((or (= (get request :method) "GET") (= (get request :method) "HEAD"))
                          (let ((body (if (or discovery (not (truth (get node :operation))))
                                          (pathIndexMarkdown title available location) (usageMarkdown (get node :operation)))))
                            (markdown-response (if (= (get request :method) "HEAD") nil body))))
                        ((or (not (= (get request :method) "POST")) (not (truth (get node :operation)))
                             (js-call (js-array "/.gepo" "/.well-known/gepo") :includes (get url :pathname)))
                          (markdown-response "Method not allowed" 405 (js-object :Allow allow)))
                        (t (let ((result (await (js-call (get node :operation) :execute request))))
                             (unless (instance? result (get Host/globals :Response)) (fail "Operation must return a Response"))
                             result)))))))))))))

  (defun createClient (&optional configuration)
    (when (undefined? configuration) (setq configuration (js-object)))
    (let* ((transport (option configuration "fetch" (lambda () (get Host/globals :fetch))))
           (defaults (option configuration "headers" (lambda () (js-object))))
           (maxBytes (option configuration "maxBytes" (lambda () 2097152)))
           (timeoutMs (option configuration "timeoutMs" (lambda () 30000)))
           (classify (option configuration "classify" (lambda () classifyDiscovery))))
      (unless (and (= (js* "typeof transport") "function") (= (js* "typeof classify") "function")
                   (Number/isSafeInteger maxBytes) (>= maxBytes 1)
                   (Number/isSafeInteger timeoutMs) (>= timeoutMs 1))
        (fail "Invalid client options"))
      (let ((default-headers (new (get Host/globals :Headers) defaults))
            (send nil) (usage nil) (index nil))
        (setq send (async (url method body &optional options)
          (when (undefined? options) (setq options (js-object)))
          (let ((headers (new (get Host/globals :Headers) default-headers)))
            (js-call (new (get Host/globals :Headers) (get options :headers)) :forEach
              (lambda (value key) (js-call headers :set key value)))
            (unless (js-call headers :has "Accept")
              (js-call headers :set "Accept" "text/markdown, text/plain;q=0.8, */*;q=0.1"))
            (when (truth (get options :contentType)) (js-call headers :set "Content-Type" (get options :contentType)))
            (let* ((controller (new (get Host/globals :AbortController)))
                   (signal (if (truth (get options :signal))
                               (js-call (get Host/globals :AbortSignal) :any (js-array (get controller :signal) (get options :signal)))
                             (get controller :signal))))
              (when (truth (get signal :aborted))
                (throw (abort-reason signal)))
              (let* ((timer (funcall (get Host/globals :setTimeout)
                              (lambda () (js-call controller :abort (new globalThis/Error "HTTP timeout"))) timeoutMs))
                     (on-abort undefined)
                     (aborted (new globalThis/Promise
                       (lambda (resolve reject)
                         (setq on-abort (lambda ()
                           (funcall reject (abort-reason signal))))
                         (js-call signal :addEventListener "abort" on-abort (js-object :once t))))))
                (try
                  (let ((reply (await (Promise/race (js-array aborted
                          (funcall transport (get url :href)
                            (js-object :method method :body body :headers headers :redirect "manual" :signal signal)))))))
                    (when (and (>= (get reply :status) 300) (< (get reply :status) 400))
                      (let ((stream (get reply :body)))
                        (await (if (or (nil? stream) (undefined? stream)) undefined (js-call stream :cancel))))
                      (throw (new globalThis/Error "Redirect requires explicit caller handling")))
                    (let ((chunks (js-array)) (size 0))
                      (when (truth (get reply :body))
                        (let ((reader (js-call (get reply :body) :getReader)))
                          (try
                            (let ((done false))
                              (while (not done)
                                (let* ((item (await (Promise/race (js-array aborted (js-call reader :read)))))
                                       (finished (get item :done)) (value (get item :value)))
                                  (if (truth finished) (setq done t)
                                    (progn
                                      (setq size (+ size (get value :byteLength)))
                                      (when (> size maxBytes)
                                        (await (js-call reader :cancel))
                                        (throw (new globalThis/RangeError "HTTP response byte limit")))
                                      (js-call chunks :push value))))))
                            (catch error
                              (await (js-call (js-call reader :cancel) :catch (lambda () undefined)))
                              (throw error))
                            (finally (js-call reader :releaseLock)))))
                      (let ((bytes (new (get Host/globals :Uint8Array) size)) (offset 0))
                        (literal-each chunks (lambda (chunk)
                          (js-call bytes :set chunk offset)
                          (setq offset (+ offset (get chunk :byteLength)))))
                        (js-object :url (get url :href) :status (get reply :status)
                          :contentType (js-call (get reply :headers) :get "Content-Type")
                          :headers (get reply :headers)
                          :body (js-call (new (get Host/globals :TextDecoder)) :decode bytes)))))
                  (finally
                    (funcall (get Host/globals :clearTimeout) timer)
                    (js-call signal :removeEventListener "abort" on-abort))))))))
        (setq usage (async (value &optional options)
          (when (undefined? options) (setq options (js-object)))
          (let ((url (target value)))
            (js-call (get url :searchParams) :delete ".gepo")
            (funcall send url "GET" undefined options))))
        (setq index (async (value &optional options)
          (when (undefined? options) (setq options (js-object)))
          (let ((url (target value))) (put url :search ".gepo") (funcall send url "GET" undefined options))))
        (Object/freeze (js-object :usage usage :index index
          :discover (async (value &optional options)
            (when (undefined? options) (setq options (js-object)))
            (let ((attempts (js-array)) (candidates (discoveryCandidates value)) (found nil))
              (let ((cursor (iteration candidates)) (done false))
                (while (not done)
                  (let ((step (iteration-step cursor)))
                    (if (truth (get step :done)) (setq done t)
                      (let ((candidate (get step :value)))
                        (try
                          (let* ((reply (await (funcall send (target candidate) "GET" undefined options)))
                                 (result (await (funcall classify reply))))
                            (js-call attempts :push (js-object :url (get reply :url) :status (get reply :status) :accepted (get result :accepted)))
                            (when (truth (get result :accepted))
                              (setq found (spread-into (spread-into (js-object) reply)
                                (js-object :paths (get result :paths) :state (if (truth (get result :empty)) "empty" "found") :attempts attempts)))
                              (setq done t)))
                          (catch error (close-abrupt cursor error)))
                        (when done (iterator-close (get cursor :iterator))))))))
              (if (nil? found) (js-object :state "not-found" :attempts attempts) found)))
          :invoke (async (value body &optional options)
            (when (undefined? options) (setq options (js-object)))
            (unless (eq (get options :allowPost) t) (fail "Invocation requires allowPost: true"))
            (when (undefined? body) (fail "Invocation requires an explicit body"))
            (let ((url (target value)))
              (when (js-call (get url :searchParams) :has ".gepo") (fail "Discovery parameter is reserved"))
              (let ((description (await (funcall usage url options))))
                (when (or (< (get description :status) 200) (>= (get description :status) 300))
                  (throw (new globalThis/Error (str "Usage request failed: " (get description :status)))))
                (funcall send url "POST" body options)))))))))

  (export defineOperation usageMarkdown pathIndexMarkdown discoveryCandidates classifyDiscovery createService createClient))
