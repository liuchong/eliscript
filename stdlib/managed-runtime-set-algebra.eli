(module eliscript.managed-runtime-set-algebra
  (import "../../stdlib/core/set.eli" :as Implementation)
  (defun set (&rest arguments) (apply Implementation/set arguments))
  (defun union (&rest collections) (apply Implementation/union collections))
  (defun intersection (&rest collections) (apply Implementation/intersection collections))
  (defun difference (&rest collections) (apply Implementation/difference collections))
  (defun subset (&rest arguments) (apply Implementation/subset? arguments))
  (defun superset (&rest arguments) (apply Implementation/superset? arguments))
  (defun disjoint (&rest arguments) (apply Implementation/disjoint? arguments))
  (defun select (&rest arguments) (apply Implementation/select arguments))
  (defun project (&rest arguments) (apply Implementation/project arguments))
  (defun renameKeys (&rest arguments) (apply Implementation/rename-keys arguments))
  (defun rename (&rest arguments) (apply Implementation/rename arguments))
  (defun index (&rest arguments) (apply Implementation/index arguments))
  (defun mapInvert (&rest arguments) (apply Implementation/map-invert arguments))
  (defun join (&rest arguments) (apply Implementation/join arguments))
  (Object/defineProperty set "length" (js-object :value 1 :configurable t))
  (Object/defineProperty subset "length" (js-object :value 2 :configurable t))
  (Object/defineProperty superset "length" (js-object :value 2 :configurable t))
  (Object/defineProperty disjoint "length" (js-object :value 2 :configurable t))
  (Object/defineProperty select "length" (js-object :value 2 :configurable t))
  (Object/defineProperty project "length" (js-object :value 2 :configurable t))
  (Object/defineProperty renameKeys "length" (js-object :value 2 :configurable t))
  (Object/defineProperty rename "length" (js-object :value 2 :configurable t))
  (Object/defineProperty index "length" (js-object :value 2 :configurable t))
  (Object/defineProperty mapInvert "length" (js-object :value 1 :configurable t))
  (Object/defineProperty join "length" (js-object :value 3 :configurable t))
  (export set union intersection difference subset superset disjoint select project renameKeys rename index mapInvert join))
