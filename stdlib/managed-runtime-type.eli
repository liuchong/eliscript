(module eliscript.managed-runtime-type
  (import "../../stdlib/managed-literals.eli" literal-register-transport literal-each)

  (defconst type-constructor-token (funcall globalThis/Symbol "eliscript.type.constructor-token"))
  (defconst type-value-states (new globalThis/WeakMap))
  (defconst type-states (new globalThis/WeakMap))
  (defconst reified-states (new globalThis/WeakMap))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun truth (value) (js* "!!value"))
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun method (implementation name arity)
    (let ((result (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (Object/defineProperty result "length" (js-object :value arity :configurable t)) result))
  (defun dense-array (value label maximum)
    (unless (and (Array/isArray value) (<= (js-length value) maximum))
      (fail (str label " must be a dense array of at most " maximum " values")))
    (let ((descriptors (Object/getOwnPropertyDescriptors value)) (index 0))
      (unless (= (js-length (Reflect/ownKeys descriptors)) (1+ (js-length value)))
        (fail (str label " must be a dense array with no extra properties")))
      (while (< index (js-length value))
        (let ((descriptor (get descriptors (funcall globalThis/String index))))
          (unless (and (not (nullish? descriptor)) (truth (get descriptor :enumerable))
            (Reflect/has descriptor "value"))
            (fail (str label " must contain enumerable data values"))))
        (setq index (1+ index)))) value)
  (defun normalize-name (name)
    (unless (and (= (js* "typeof name") "string") (> (js-length name) 0))
      (fail "type name must be a non-empty string")) name)
  (defun normalize-fields (fields)
    (dense-array fields "type fields" 1024)
    (let ((seen (new globalThis/Set)))
      (Object/freeze (js-call fields :map (lambda (field)
        (unless (and (= (js* "typeof field") "string") (> (js-length field) 0)
          (not (js-call field :includes "/")))
          (fail "type field names must be non-empty unqualified strings"))
        (when (js-call seen :has field) (fail (str "type declares duplicate field " field)))
        (js-call seen :add field) field)))))
  (defun protocol-shape (protocol)
    (unless (and (not (nil? protocol)) (= (js* "typeof protocol") "object"))
      (fail "expected an Eliscript protocol"))
    (let* ((descriptors (Object/getOwnPropertyDescriptors protocol)) (keys (Reflect/ownKeys descriptors))
           (name-descriptor (get descriptors :name)) (operations-descriptor (get descriptors :operations)))
      (unless (and (= (js-length keys) 2) (not (nullish? name-descriptor))
        (truth (get name-descriptor :enumerable)) (Reflect/has name-descriptor "value")
        (= (value-type (get name-descriptor :value)) "string") (> (js-length (get name-descriptor :value)) 0)
        (not (nullish? operations-descriptor)) (truth (get operations-descriptor :enumerable))
        (Reflect/has operations-descriptor "value") (Object/isFrozen protocol))
        (fail "expected an Eliscript protocol"))
      (let ((operations (get operations-descriptor :value)))
        (unless (and (not (nil? operations)) (= (js* "typeof operations") "object")
          (not (Array/isArray operations)) (Object/isFrozen operations))
          (fail "expected an Eliscript protocol"))
        (let* ((operation-descriptors (Object/getOwnPropertyDescriptors operations))
               (operation-names (Reflect/ownKeys operation-descriptors)))
          (when (or (= (js-length operation-names) 0) (> (js-length operation-names) 1024)
            (js-call operation-names :some (lambda (operation) (not (= (js* "typeof operation") "string")))))
            (fail "expected an Eliscript protocol"))
          (let ((methods (js-call operation-names :map (lambda (operation)
            (let* ((descriptor (get operation-descriptors operation))
                   (operation-method (if (nullish? descriptor) undefined (get descriptor :value)))
                   (method-descriptors (if (callable? operation-method)
                     (Object/getOwnPropertyDescriptors operation-method) (js-object)))
                   (protocol-descriptor (get method-descriptors :protocol))
                   (operation-descriptor (get method-descriptors :operation))
                   (slot-descriptor (get method-descriptors :slot))
                   (slot (if (nullish? slot-descriptor) undefined (get slot-descriptor :value))))
              (unless (and (not (nullish? descriptor)) (truth (get descriptor :enumerable))
                (Reflect/has descriptor "value")
                (not (nullish? protocol-descriptor)) (eq (get protocol-descriptor :value) protocol)
                (not (nullish? operation-descriptor)) (eq (get operation-descriptor :value) operation)
                (not (nullish? slot-descriptor)) (= (js* "typeof slot") "symbol")
                (Object/isFrozen operation-method))
                (fail "expected an Eliscript protocol"))
              (Object/freeze (js-object :operation operation :slot slot)))))))
            (Object/freeze (js-object :name (get name-descriptor :value) :operations (Object/freeze methods))))))))
  (defun normalize-methods (protocol implementations)
    (let ((definition (protocol-shape protocol)))
      (unless (and (not (nil? implementations)) (= (js* "typeof implementations") "object")
        (not (Array/isArray implementations)))
        (fail (str "protocol " (get definition :name) " implementations must be a plain object")))
      (let ((prototype (Object/getPrototypeOf implementations)))
        (unless (or (eq prototype (get globalThis/Object :prototype)) (nil? prototype))
          (fail (str "protocol " (get definition :name) " implementations must be a plain object"))))
      (let* ((descriptors (Object/getOwnPropertyDescriptors implementations)) (keys (Reflect/ownKeys descriptors))
             (operations (get definition :operations)))
        (unless (= (js-length keys) (js-length operations))
          (fail (str "protocol " (get definition :name) " implementation must define every operation")))
        (let ((names (js-call operations :map (lambda (operation) (get operation :operation)))))
          (when (js-call keys :some (lambda (key)
            (or (not (= (js* "typeof key") "string")) (not (js-call names :includes key)))))
            (fail (str "protocol " (get definition :name) " implementation contains an unknown operation"))))
        (let ((normalized (js-array)))
          (literal-each operations (lambda (entry)
            (let* ((operation (get entry :operation)) (slot (get entry :slot))
                   (descriptor (get descriptors operation)))
              (unless (and (not (nullish? descriptor)) (truth (get descriptor :enumerable))
                (Reflect/has descriptor "value") (callable? (get descriptor :value)))
                (fail (str "protocol " (get definition :name) "/" operation " implementation must be a function")))
              (js-call normalized :push (Object/freeze (js-object :operation operation :slot slot :implementation (get descriptor :value)))))))
          (Object/freeze (js-object :protocol protocol :name (get definition :name) :methods normalized))))))
  (defun normalize-plans (plans allow-empty)
    (dense-array plans "protocol implementations" 1024)
    (when (and (not allow-empty) (= (js-length plans) 0))
      (fail "reify requires at least one protocol implementation"))
    (let ((seen (new globalThis/Set)))
      (Object/freeze (js-call plans :map (lambda (plan index)
        (dense-array plan (str "protocol implementation " index) 2)
        (unless (= (js-length plan) 2)
          (fail (str "protocol implementation " index " must contain a protocol and methods")))
        (let ((protocol (get plan 0)) (methods (get plan 1)))
          (when (js-call seen :has protocol) (fail "protocol may be implemented only once"))
          (js-call seen :add protocol) (normalize-methods protocol methods)))))))
  (defun plans-snapshot (plans)
    (let ((result (js-array)) (plan-index 0))
      (while (< plan-index (js-length plans))
        (let* ((plan (get plans plan-index)) (implementations (Object/create nil))
               (methods (get plan :methods)) (index 0))
          (while (< index (js-length methods))
            (let ((entry (get methods index)))
              (Object/defineProperty implementations (get entry :operation)
                (js-object :enumerable t :value (get entry :implementation))))
            (setq index (1+ index)))
          (Object/defineProperty result (funcall globalThis/String plan-index)
            (js-object :enumerable t :writable t :configurable t
              :value (Object/freeze (js-array (get plan :protocol) (Object/freeze implementations))))))
        (setq plan-index (1+ plan-index)))
      (Object/freeze result)))
  (defun install-protocol-methods (target plans)
    (literal-each plans (lambda (plan)
      (literal-each (get plan :methods) (lambda (entry)
            (let* ((slot (get entry :slot)) (implementation (get entry :implementation)))
              (when (Reflect/has target slot)
                (fail (str "protocol slot conflict while implementing " (get plan :name))))
              (let ((wrapper (funcall
                (js* "(fn) => function (...args) { return Reflect.apply(fn, undefined, [this, ...args]); }") implementation)))
                (Object/defineProperty wrapper "name" (js-object :value "value" :configurable t))
                (Object/defineProperty target slot (js-object :value wrapper
                  :configurable false :enumerable false :writable false)))))))) target)
  (defun define-fields (type field-names)
    (let ((index 0))
      (while (< index (js-length field-names))
        (let ((field (get field-names index)) (position index) (prototype (get type :prototype)))
          (when (Reflect/has prototype field) (fail (str "type field " field " conflicts with a type member")))
          (Object/defineProperty prototype field (js-object :configurable false :enumerable t
            :get (method (lambda (self) (get (get (js-call type-value-states :get self) :values) position)) "get" 0))))
        (setq index (1+ index)))))
  (defun defineType (name fields &rest optional-plans)
    (make-type-definition name fields
      (if (or (= (js-length optional-plans) 0) (undefined? (get optional-plans 0)))
        (js-array) (get optional-plans 0)) false))
  (defun materializeTypeDefinition (name fields &rest optional-plans)
    (make-type-definition name fields
      (if (or (= (js-length optional-plans) 0) (undefined? (get optional-plans 0)))
        (js-array) (get optional-plans 0)) t))
  (defun make-type-definition (name fields protocol-plans retain-fields)
    (let* ((type-name (normalize-name name)) (normalized (normalize-fields fields))
           (field-names (progn
             (when (and retain-fields (not (Object/isFrozen fields))) (fail "transported type fields must be frozen"))
             (if retain-fields fields normalized)))
           (plans (normalize-plans protocol-plans t)) (type nil))
      (setq type (funcall
        (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
        (lambda (self token values)
          (unless (eq token type-constructor-token)
            (fail (str type-name " values must be created with its positional constructor")))
          (js-call type-value-states :set self
            (Object/freeze (js-object :type type :values (Object/freeze values))))
          (Object/freeze self)) "TypeValue"))
      (Object/defineProperty type "length" (js-object :value 2 :configurable t))
      (Object/defineProperty type "create" (js-object :writable t :configurable t
        :value (method (lambda (self &rest values)
          (unless (= (js-length values) (js-length field-names))
            (fail (str "->" type-name " expects " (js-length field-names) " values, received " (js-length values))))
          (new type type-constructor-token values)) "create" 0)))
      (Object/defineProperty type "isInstance" (js-object :writable t :configurable t
        :value (method (lambda (self value)
          (let ((state (js-call type-value-states :get value)))
            (and (not (undefined? state)) (eq (get state :type) type)))) "isInstance" 1)))
      (Object/defineProperty (get type :prototype) (get globalThis/Symbol :toStringTag)
        (js-object :configurable t :get (method (lambda (self) (str "EliscriptType:" type-name)) "get [Symbol.toStringTag]" 0)))
      (Object/defineProperty type "name" (js-object :value type-name))
      (Object/defineProperties type (js-object
        :typeName (js-object :enumerable t :value type-name) :typeFields (js-object :enumerable t :value field-names)))
      (define-fields type field-names)
      (install-protocol-methods (get type :prototype) plans)
      (Object/freeze (get type :prototype)) (Object/freeze type)
      (js-call type-states :set type (Object/freeze (js-object :name type-name :fields field-names :protocolPlans (plans-snapshot plans))))
      type))
  (defun reifyProtocols (protocol-plans)
    (let* ((plans (normalize-plans protocol-plans false))
           (value (Object/freeze (install-protocol-methods (Object/create nil) plans))))
      (js-call reified-states :set value (Object/freeze (js-object :protocolPlans (plans-snapshot plans)))) value))
  (defun isType (value)
    (and (= (js* "typeof value") "function") (js-call type-states :has value)))
  (defun isTypeValue (value)
    (and (not (nil? value)) (= (js* "typeof value") "object") (js-call type-value-states :has value)))
  (defun typeOf (value)
    (let ((state (js-call type-value-states :get value)))
      (when (undefined? state) (fail "expected an Eliscript type value")) (get state :type)))
  (defun typeName (value)
    (let ((type (if (isType value) value (typeOf value)))) (get (js-call type-states :get type) :name)))
  (defun typeFieldNames (value)
    (let ((type (if (isType value) value (typeOf value)))) (get (js-call type-states :get type) :fields)))
  (defun readTypeState (value) (js-call type-states :get value))
  (defun readTypeValueState (value) (js-call type-value-states :get value))
  (defun readReifiedState (value) (js-call reified-states :get value))
  (defun materializeTypeValue (type values)
    (let ((state (readTypeState type)))
      (when (undefined? state) (fail "expected an Eliscript type"))
      (dense-array values "type values" 1024)
      (unless (= (js-length values) (js-length (get state :fields)))
        (fail (str "->" (get state :name) " expects " (js-length (get state :fields))
          " values, received " (js-length values))))
      (unless (Object/isFrozen values) (fail "transported type values must be frozen"))
      (new type type-constructor-token values)))
  (literal-register-transport "type-definition" isType
    (lambda (type) (let ((state (readTypeState type)))
      (js-object :kind "type-definition" :name (get state :name) :fields (get state :fields)
        :protocolPlans (get state :protocolPlans))))
    (lambda (record) (materializeTypeDefinition (get record :name) (get record :fields) (get record :protocolPlans))))
  (literal-register-transport "type-value" isTypeValue
    (lambda (value) (let ((state (readTypeValueState value)))
      (js-object :kind "type-value" :type (get state :type) :values (get state :values))))
    (lambda (record) (materializeTypeValue (get record :type) (get record :values))))
  (literal-register-transport "reified"
    (lambda (value) (js-call reified-states :has value))
    (lambda (value) (js-object :kind "reified" :protocolPlans (get (readReifiedState value) :protocolPlans)))
    (lambda (record) (reifyProtocols (get record :protocolPlans))))
  (export defineType reifyProtocols isType isTypeValue typeOf typeName typeFieldNames
    readTypeState readTypeValueState readReifiedState materializeTypeDefinition materializeTypeValue))
