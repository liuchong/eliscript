(module eliscript.managed-runtime-transducer
  (import "./collection.mjs" conj contains empty isReduced memoizedSequenceView reduce reduced reductionView seq unreduced)
  (import "./protocol.mjs" implementsProtocolOperation)
  (import "./set.mjs" EMPTY_SET)
  (import "./transient.mjs" IEditable conjBang persistentBang transient)
  (import "./truth.mjs" isTruthy)
  (import "./value.mjs" equalValues)
  (import "./vector.mjs" EMPTY_VECTOR)
  (import "../../stdlib/managed-literals.eli" literal-each)

  (defconst reducing-function-key (funcall globalThis/Symbol "eliscript.transducer.reducing-function"))
  (defconst zero-input-key (funcall globalThis/Symbol "eliscript.transducer.zero-input"))
  (defconst no-previous (funcall globalThis/Symbol "eliscript.transducer.no-previous-value"))
  (defconst no-partition (funcall globalThis/Symbol "eliscript.transducer.no-partition-key"))
  (defconst no-initial (funcall globalThis/Symbol "eliscript.transducer.no-reduction-initial"))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun identity (value) value)
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun truth (value) (js* "!!value"))
  (defun require-function (value label)
    (unless (callable? value) (fail (str label " must be a function"))) value)
  (defun require-positive (value label)
    (unless (and (Number/isSafeInteger value) (> value 0)) (fail (str label " must be a positive safe integer"))) value)
  (defun as-reducer (value label)
    (require-function value label)
    (if (eq (aref value reducing-function-key) t) value (completing value)))
  (defun make-transducer (transform &optional zero-input)
    (Object/defineProperty transform zero-input-key (js-object :value (if (undefined? zero-input) false zero-input)))
    (Object/freeze transform))
  (defun apply-transducer (transducer reducer)
    (require-function transducer "transducer")
    (as-reducer (funcall transducer reducer) "transducer result"))
  (defun method (implementation name arity)
    (let ((function (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (Object/defineProperty function "length" (js-object :value arity :configurable t)) function))
  (defun partition-buffer ()
    (let ((builder (transient EMPTY_VECTOR)) (length 0))
      (Object/freeze (js-object
        :append (method (lambda (self value) (setq builder (conjBang builder value) length (1+ length)) length) "append" 1)
        :flush (method (lambda (self result downstream)
          (if (= length 0) result
            (let ((partition (persistentBang builder)))
              (setq builder (transient EMPTY_VECTOR) length 0) (funcall downstream result partition)))) "flush" 2)))))
  (defconst identity-transducer (make-transducer (lambda (reducer) reducer) false))
  (defun completing (step &rest optional-complete)
    (let ((complete (if (or (= (js-length optional-complete) 0) (undefined? (get optional-complete 0))) identity (get optional-complete 0))))
      (require-function step "reducing step") (require-function complete "reducing completion")
      (let ((function (lambda (&rest arguments)
        (cond ((= (js-length arguments) 1) (funcall complete (get arguments 0)))
          ((= (js-length arguments) 2) (funcall step (get arguments 0) (get arguments 1)))
          (t (fail "reducing functions accept one completion argument or two step arguments"))))))
        (Object/defineProperty function "name" (js-object :value "reducingFunction" :configurable t))
        (Object/defineProperty function reducing-function-key (js-object :value t)) (Object/freeze function))))
  (defun mapping (transform)
    (require-function transform "mapping transform")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "mapping reducing function")))
        (completing (lambda (result input) (funcall downstream result (funcall transform input)))
          (lambda (result) (funcall downstream result))))) false))
  (defun mappingIndexed (transform)
    (require-function transform "mapping-indexed transform")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "mapping-indexed reducing function")) (index 0))
        (completing (lambda (result input) (let ((current index))
          (setq index (1+ index)) (funcall downstream result (funcall transform current input))))
          (lambda (result) (funcall downstream result))))) false))
  (defun keeping (transform)
    (require-function transform "keeping transform")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "keeping reducing function")))
        (completing (lambda (result input) (let ((value (funcall transform input)))
          (if (nil? value) result (funcall downstream result value))))
          (lambda (result) (funcall downstream result))))) false))
  (defun keepingIndexed (transform)
    (require-function transform "keeping-indexed transform")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "keeping-indexed reducing function")) (index 0))
        (completing (lambda (result input) (let ((current index))
          (setq index (1+ index)) (let ((value (funcall transform current input)))
            (if (nil? value) result (funcall downstream result value)))))
          (lambda (result) (funcall downstream result))))) false))
  (defun catting ()
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "catting reducing function")))
        (completing (lambda (result input)
          (let* ((stopped false) (flattened (reduce input (lambda (nested value)
            (let ((stepped (funcall downstream nested value))) (when (isReduced stepped) (setq stopped t)) stepped)) result)))
            (if stopped (reduced flattened) flattened)))
          (lambda (result) (funcall downstream result))))) false))
  (defun mapcatting (transform)
    (require-function transform "mapcatting transform") (composeTransducers (mapping transform) (catting)))
  (defun filtering (predicate)
    (require-function predicate "filtering predicate")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "filtering reducing function")))
        (completing (lambda (result input) (if (isTruthy (funcall predicate input)) (funcall downstream result input) result))
          (lambda (result) (funcall downstream result))))) false))
  (defun removing (predicate)
    (require-function predicate "removing predicate")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "removing reducing function")))
        (completing (lambda (result input) (if (isTruthy (funcall predicate input)) result (funcall downstream result input)))
          (lambda (result) (funcall downstream result))))) false))
  (defun taking (limit)
    (unless (and (Number/isSafeInteger limit) (>= limit 0)) (fail "taking limit must be a non-negative safe integer"))
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "taking reducing function")) (remaining limit))
        (completing (lambda (result input)
          (if (= remaining 0) (reduced result)
            (progn (setq remaining (1- remaining)) (let ((stepped (funcall downstream result input)))
              (if (and (= remaining 0) (not (isReduced stepped))) (reduced stepped) stepped)))))
          (lambda (result) (funcall downstream result))))) (= limit 0)))
  (defun dropping (limit)
    (unless (and (Number/isSafeInteger limit) (>= limit 0)) (fail "dropping limit must be a non-negative safe integer"))
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "dropping reducing function")) (remaining limit))
        (completing (lambda (result input) (if (> remaining 0)
          (progn (setq remaining (1- remaining)) result) (funcall downstream result input)))
          (lambda (result) (funcall downstream result))))) false))
  (defun takingWhile (predicate)
    (require-function predicate "taking-while predicate")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "taking-while reducing function")))
        (completing (lambda (result input) (if (isTruthy (funcall predicate input)) (funcall downstream result input) (reduced result)))
          (lambda (result) (funcall downstream result))))) false))
  (defun droppingWhile (predicate)
    (require-function predicate "dropping-while predicate")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "dropping-while reducing function")) (dropping t))
        (completing (lambda (result input)
          (if (and dropping (isTruthy (funcall predicate input))) result
            (progn (setq dropping false) (funcall downstream result input))))
          (lambda (result) (funcall downstream result))))) false))
  (defun takingNth (interval)
    (require-positive interval "taking-nth interval")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "taking-nth reducing function")) (remaining 0))
        (completing (lambda (result input) (if (> remaining 0)
          (progn (setq remaining (1- remaining)) result)
          (progn (setq remaining (1- interval)) (funcall downstream result input))))
          (lambda (result) (funcall downstream result))))) false))
  (defun interposing (separator)
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "interposing reducing function")) (started false))
        (completing (lambda (result input)
          (if (not started) (progn (setq started t) (funcall downstream result input))
            (let ((separated (funcall downstream result separator)))
              (if (isReduced separated) separated (funcall downstream separated input)))))
          (lambda (result) (funcall downstream result))))) false))
  (defun partitioningAll (size)
    (require-positive size "partitioning-all size")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "partitioning-all reducing function")) (buffer (partition-buffer)))
        (completing (lambda (result input)
          (if (= (js-call buffer :append input) size) (js-call buffer :flush result downstream) result))
          (lambda (result) (funcall downstream (unreduced (js-call buffer :flush result downstream))))))) false))
  (defun partitioningBy (classifier)
    (require-function classifier "partitioning-by classifier")
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "partitioning-by reducing function")) (buffer (partition-buffer)) (previous no-partition))
        (completing (lambda (result input)
          (let ((key (funcall classifier input)))
            (if (or (eq previous no-partition) (equalValues previous key))
              (progn (setq previous key) (js-call buffer :append input) result)
              (let ((stepped (js-call buffer :flush result downstream)))
                (if (isReduced stepped) stepped (progn (setq previous key) (js-call buffer :append input) stepped))))))
          (lambda (result) (funcall downstream (unreduced (js-call buffer :flush result downstream))))))) false))
  (defun deduping ()
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "deduping reducing function")) (previous no-previous))
        (completing (lambda (result input)
          (if (and (not (eq previous no-previous)) (equalValues previous input)) result
            (progn (setq previous input) (funcall downstream result input))))
          (lambda (result) (funcall downstream result))))) false))
  (defun distincting ()
    (make-transducer (lambda (reducer)
      (let ((downstream (as-reducer reducer "distincting reducing function")) (seen EMPTY_SET))
        (completing (lambda (result input) (if (contains seen input) result
          (progn (setq seen (conj seen input)) (funcall downstream result input))))
          (lambda (result) (funcall downstream result))))) false))
  (defun composeTransducers (&rest transducers)
    (literal-each transducers (lambda (transducer) (require-function transducer "composed transducer")))
    (make-transducer (lambda (reducer)
      (js-call transducers :reduceRight (lambda (downstream transducer) (apply-transducer transducer downstream))
        (as-reducer reducer "composed reducing function")))
      (js-call transducers :some (lambda (transducer) (eq (aref transducer zero-input-key) t)))))
  (defun transduce (&rest arguments)
    (unless (= (js-length arguments) 4) (fail "transduce requires a transducer, reducer, initial value, and collection"))
    (let* ((transducer (get arguments 0))
           (transformed (apply-transducer transducer (as-reducer (get arguments 1) "transduce reducer")))
           (seed (unreduced (get arguments 2)))
           (result (if (eq (aref transducer zero-input-key) t) seed (reduce (get arguments 3) transformed seed))))
      (unreduced (funcall transformed (unreduced result)))))
  (defun eduction (&rest arguments)
    (when (< (js-length arguments) 2) (fail "eduction requires one or more transducers and a collection"))
    (let* ((collection (get arguments (1- (js-length arguments))))
           (transducer (apply composeTransducers (js-call arguments :slice 0 -1))))
      (reductionView (lambda (reducer &rest initial)
        (require-function reducer "eduction reducer")
        (if (> (js-length initial) 0) (transduce transducer (completing reducer) (get initial 0) collection)
          (transduce transducer (completing
            (lambda (result value) (if (eq result no-initial) value (funcall reducer result value)))
            (lambda (result) (when (eq result no-initial) (fail "cannot reduce an empty eduction without an initial value")) result))
            no-initial collection))))))
  (defun transformed-iterator (transducer collection)
    (let ((output (js-array)) (output-index 0) (input nil) (transformed nil)
          (accumulator nil) (initialized false) (complete false))
      (let* ((close-input (lambda ()
               (when (and (not (nil? input)) (callable? (get input :return))) (js-call input :return))
               (setq input nil)))
             (finish (lambda () (unless complete
               (setq complete t) (funcall close-input)
               (setq accumulator (unreduced (funcall transformed (unreduced accumulator)))))))
             (initialize (lambda () (unless initialized
               (setq initialized t transformed (apply-transducer transducer
                 (completing (lambda (result value) (js-call output :push value) result))))
               (if (eq (aref transducer zero-input-key) t) (funcall finish)
                 (let ((source (seq collection)))
                   (if (nil? source) (funcall finish)
                     (setq input (js-call source (get globalThis/Symbol :iterator)))))))))
             (pump (lambda ()
               (funcall initialize)
               (while (and (= output-index (js-length output)) (not complete))
                 (put output :length 0) (setq output-index 0)
                 (let ((next (try (js-call input :next)
                   (catch error (funcall close-input) (setq complete t) (throw error)))))
                   (if (truth (get next :done)) (funcall finish)
                     (let ((stepped (try (funcall transformed accumulator (get next :value))
                       (catch error (funcall close-input) (setq complete t) (throw error)))))
                       (if (isReduced stepped)
                         (progn (setq accumulator (unreduced stepped)) (funcall finish))
                         (setq accumulator stepped)))))))))
        (let ((iterator (js-object
          :next (method (lambda (self) (funcall pump)
            (if (= output-index (js-length output)) (js-object :value undefined :done t)
              (let ((value (get output output-index))) (setq output-index (1+ output-index))
                (js-object :value value :done false)))) "next" 0)
          :return (method (lambda (self value)
            (put output :length 0) (setq output-index 0 complete t) (funcall close-input)
            (js-object :value value :done t)) "return" 1))))
          (put iterator (get globalThis/Symbol :iterator) (method (lambda (self) self) "[Symbol.iterator]" 0)) iterator))))
  (defun sequence (&rest arguments)
    (unless (= (js-length arguments) 2) (fail "sequence requires a transducer and collection"))
    (let ((transducer (get arguments 0)) (collection (get arguments 1)))
      (require-function transducer "sequence transducer")
      (memoizedSequenceView (lambda () (transformed-iterator transducer collection)))))
  (defun runBang (&rest arguments)
    (unless (= (js-length arguments) 2) (fail "run! requires a procedure and collection"))
    (let ((procedure (get arguments 0)))
      (require-function procedure "run! procedure")
      (reduce (get arguments 1) (lambda (result value) (funcall procedure value) nil) nil)) nil)
  (defun into (target &rest arguments)
    (unless (or (= (js-length arguments) 1) (= (js-length arguments) 2))
      (fail "into requires a target and source, or a target, transducer, and source"))
    (let* ((transducer (if (= (js-length arguments) 1) identity-transducer (get arguments 0)))
           (source (get arguments (1- (js-length arguments)))) (seed (empty target)))
      (if (implementsProtocolOperation IEditable "transient" seed)
        (transduce transducer (completing (lambda (result value) (conjBang result value))
          (lambda (result) (persistentBang result))) (transient seed) source)
        (transduce transducer (lambda (result value) (conj result value)) seed source))))
  (Object/defineProperty transduce "length" (js-object :value 4 :configurable t))
  (Object/defineProperty sequence "length" (js-object :value 2 :configurable t))
  (Object/defineProperty runBang "length" (js-object :value 2 :configurable t))
  (export completing mapping mappingIndexed keeping keepingIndexed catting mapcatting filtering removing taking dropping
    takingWhile droppingWhile takingNth interposing partitioningAll partitioningBy deduping distincting composeTransducers
    transduce eduction sequence runBang into))
