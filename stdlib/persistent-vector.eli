(module eliscript.persistent-vector
  (defconst persistent-vector-kind "eliscript/persistent-vector")
  (defconst persistent-vector-branch-bits 5)
  (defconst persistent-vector-branch-width 32)
  (defconst persistent-vector-branch-mask 31)
  (defconst persistent-vector-max-count 2147483647)

  (defportable array-reverse (values)
    (let ((result (js-array))
          (index 0))
      (while (< index (js-length values))
        (setq result (js-cons (get values index) result)
              index (1+ index)))
      result))

  (defportable array-copy-assoc (values wanted-index wanted-value)
    (let ((result (js-array))
          (index 0)
          (result-length
           (if (< wanted-index (js-length values))
               (js-length values)
             (1+ wanted-index))))
      (while (< index result-length)
        (setq result
              (js-cons
               (if (= index wanted-index)
                   wanted-value
                 (get values index))
               result)
              index (1+ index)))
      (array-reverse result)))

  (defportable array-drop-last (values)
    (let ((result (js-array))
          (index 0)
          (result-length (1- (js-length values))))
      (while (< index result-length)
        (setq result (js-cons (get values index) result)
              index (1+ index)))
      (array-reverse result)))

  (defportable make-vector-node (slots)
    (object :slots slots))

  (defportable empty-vector-node ()
    (make-vector-node (js-array)))

  (defportable vector-node-slots (node)
    (get node "slots" (js-array)))

  (defportable make-persistent-vector (count shift root tail metadata)
    (object :kind persistent-vector-kind
            :count count
            :shift shift
            :root root
            :tail tail
            :metadata metadata))

  (defportable persistent-vector? (value)
    (and (not (nullish? value))
         (object-has? value "kind")
         (= (get value "kind" nil) persistent-vector-kind)))

  (defportable empty-persistent-vector ()
    (make-persistent-vector 0
                            persistent-vector-branch-bits
                            (empty-vector-node)
                            (js-array)
                            nil))

  (defportable persistent-vector-count (vector)
    (get vector "count" 0))

  (defportable persistent-vector-meta (vector)
    (get vector "metadata" nil))

  (defportable persistent-vector-with-meta (vector metadata)
    (if (= metadata (persistent-vector-meta vector))
        vector
      (make-persistent-vector
       (persistent-vector-count vector)
       (get vector "shift" persistent-vector-branch-bits)
       (get vector "root" nil)
       (get vector "tail" (js-array))
       metadata)))

  (defportable persistent-vector-tail-offset (vector)
    (let ((count (persistent-vector-count vector)))
      (if (< count persistent-vector-branch-width)
          0
        (bit-shift-left
         (unsigned-bit-shift-right (1- count)
                                   persistent-vector-branch-bits)
         persistent-vector-branch-bits))))

  (defportable persistent-vector-valid-index? (index upper-bound inclusive)
    (and (= index (int32 index))
         (>= index 0)
         (if inclusive
             (<= index upper-bound)
           (< index upper-bound))))

  (defportable vector-new-path (level node)
    (if (= level 0)
        node
      (make-vector-node
       (js-array (vector-new-path (- level persistent-vector-branch-bits) node)))))

  (defportable vector-push-tail (level parent tail-node count)
    (let* ((subindex
            (bit-and
             (unsigned-bit-shift-right (1- count) level)
             persistent-vector-branch-mask))
           (slots (vector-node-slots parent))
           (child
            (if (= level persistent-vector-branch-bits)
                tail-node
              (let ((existing (js-nth subindex slots)))
                (if existing
                    (vector-push-tail
                     (- level persistent-vector-branch-bits)
                     existing
                     tail-node
                     count)
                  (vector-new-path
                   (- level persistent-vector-branch-bits)
                   tail-node))))))
      (make-vector-node (array-copy-assoc slots subindex child))))

  (defportable vector-assoc-node (level node index value)
    (let* ((subindex
            (bit-and
             (unsigned-bit-shift-right index level)
             persistent-vector-branch-mask))
           (slots (vector-node-slots node))
           (replacement
            (if (= level 0)
                value
              (vector-assoc-node
               (- level persistent-vector-branch-bits)
               (js-nth subindex slots)
               index
               value))))
      (make-vector-node (array-copy-assoc slots subindex replacement))))

  (defportable vector-pop-tail (level node count)
    (let* ((subindex
            (bit-and
             (unsigned-bit-shift-right (- count 2) level)
             persistent-vector-branch-mask))
           (slots (vector-node-slots node)))
      (if (> level persistent-vector-branch-bits)
          (let ((child
                 (vector-pop-tail
                  (- level persistent-vector-branch-bits)
                  (js-nth subindex slots)
                  count)))
            (if (and (nil? child) (= subindex 0))
                nil
              (make-vector-node
               (array-copy-assoc slots subindex child))))
        (if (= subindex 0)
            nil
          (make-vector-node (array-copy-assoc slots subindex nil))))))

  (defportable persistent-vector-array-for (vector index)
    (if (>= index (persistent-vector-tail-offset vector))
        (get vector "tail" (js-array))
      (let ((node (get vector "root" nil))
            (level (get vector "shift" persistent-vector-branch-bits)))
        (while (> level 0)
          (setq node
                (js-nth
                 (bit-and
                  (unsigned-bit-shift-right index level)
                  persistent-vector-branch-mask)
                 (vector-node-slots node))
                level (- level persistent-vector-branch-bits)))
        (vector-node-slots node))))

  (defportable persistent-vector-nth (vector index not-found)
    (let ((count (persistent-vector-count vector)))
      (if (persistent-vector-valid-index? index count false)
          (get (persistent-vector-array-for vector index)
               (bit-and index persistent-vector-branch-mask))
        not-found)))

  (defportable persistent-vector-conj (vector value)
    (let* ((count (persistent-vector-count vector))
           (tail (get vector "tail" (js-array)))
           (shift (get vector "shift" persistent-vector-branch-bits))
           (root (get vector "root" nil)))
      (if (>= count persistent-vector-max-count)
          nil
        (if (< (js-length tail) persistent-vector-branch-width)
            (make-persistent-vector
             (1+ count)
             shift
             root
             (array-copy-assoc tail (js-length tail) value)
             (persistent-vector-meta vector))
          (let* ((tail-node (make-vector-node tail))
                 (root-overflow
                  (> (unsigned-bit-shift-right
                      count
                      persistent-vector-branch-bits)
                     (bit-shift-left 1 shift)))
                 (next-shift
                  (if root-overflow
                      (+ shift persistent-vector-branch-bits)
                    shift))
                 (next-root
                  (if root-overflow
                      (make-vector-node
                       (js-array root (vector-new-path shift tail-node)))
                    (vector-push-tail shift root tail-node count))))
            (make-persistent-vector
             (1+ count)
             next-shift
             next-root
             (js-array value)
             (persistent-vector-meta vector)))))))

  (defportable persistent-vector-assoc (vector index value)
    (let* ((count (persistent-vector-count vector))
           (shift (get vector "shift" persistent-vector-branch-bits))
           (root (get vector "root" nil))
           (tail (get vector "tail" (js-array))))
      (if (not (persistent-vector-valid-index? index count t))
          nil
        (if (= index count)
            (persistent-vector-conj vector value)
          (if (>= index (persistent-vector-tail-offset vector))
              (make-persistent-vector
               count
               shift
               root
               (array-copy-assoc
                tail
                (bit-and index persistent-vector-branch-mask)
                value)
               (persistent-vector-meta vector))
            (make-persistent-vector
             count
             shift
             (vector-assoc-node shift root index value)
             tail
             (persistent-vector-meta vector)))))))

  (defportable persistent-vector-pop (vector)
    (let* ((count (persistent-vector-count vector))
           (shift (get vector "shift" persistent-vector-branch-bits))
           (root (get vector "root" nil))
           (tail (get vector "tail" (js-array))))
      (if (= count 0)
          nil
        (if (= count 1)
            (make-persistent-vector
             0
             persistent-vector-branch-bits
             (empty-vector-node)
             (js-array)
             (persistent-vector-meta vector))
          (if (> (js-length tail) 1)
              (make-persistent-vector
               (1- count)
               shift
               root
               (array-drop-last tail)
               (persistent-vector-meta vector))
            (let* ((next-tail
                    (persistent-vector-array-for vector (- count 2)))
                   (popped-root (vector-pop-tail shift root count))
                   (next-root
                    (if popped-root popped-root (empty-vector-node)))
                   (collapse-root
                    (and (> shift persistent-vector-branch-bits)
                         (nil? (js-nth 1 (vector-node-slots next-root)))))
                   (collapsed-root
                    (if collapse-root
                        (let ((first
                               (js-nth 0 (vector-node-slots next-root))))
                          (if first first (empty-vector-node)))
                      next-root))
                   (next-shift
                    (if collapse-root
                        (- shift persistent-vector-branch-bits)
                      shift)))
              (make-persistent-vector
               (1- count)
               next-shift
               collapsed-root
               next-tail
               (persistent-vector-meta vector))))))))

  (defportable persistent-vector-peek (vector not-found)
    (let ((count (persistent-vector-count vector)))
      (if (= count 0)
          not-found
        (persistent-vector-nth vector (1- count) not-found))))

  (defportable persistent-vector-reduce (function initial vector)
    (let ((result initial)
          (index 0)
          (count (persistent-vector-count vector)))
      (while (< index count)
        (let* ((leaf (persistent-vector-array-for vector index))
               (leaf-index (bit-and index persistent-vector-branch-mask)))
          (while (and (< index count) (< leaf-index (js-length leaf)))
            (setq result (funcall function result (get leaf leaf-index))
                  index (1+ index)
                  leaf-index (1+ leaf-index)))))
      result))

  (defportable persistent-vector-to-array (vector)
    (array-reverse
     (persistent-vector-reduce
      (lambda (result value) (js-cons value result))
      (js-array)
      vector)))

  (defportable persistent-vector-from-array (values)
    (let ((result (empty-persistent-vector))
          (index 0))
      (while (< index (js-length values))
        (setq result (persistent-vector-conj result (get values index))
              index (1+ index)))
      result))

  (export empty-persistent-vector
          persistent-vector?
          persistent-vector-count
          persistent-vector-meta
          persistent-vector-with-meta
          persistent-vector-nth
          persistent-vector-conj
          persistent-vector-assoc
          persistent-vector-pop
          persistent-vector-peek
          persistent-vector-reduce
          persistent-vector-to-array
          persistent-vector-from-array))
