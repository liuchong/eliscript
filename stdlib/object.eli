(module eliscript.object
  (defportable keys (object)
    (object-keys object))

  (defportable has? (object key)
    (object-has? object key))

  (defportable assoc (object key value)
    (object-assoc object key value))

  (defportable key-in? (key key-list)
    (let ((matched false)
          (index 0))
      (while (and (< index (length key-list)) (not matched))
        (when (= key (nth index key-list))
          (setq matched t))
        (setq index (1+ index)))
      matched))

  (defportable dissoc (object key)
    (let ((result (object))
          (source-keys (keys object))
          (index 0))
      (while (< index (length source-keys))
        (let ((current-key (nth index source-keys)))
          (unless (= current-key key)
            (setq result
                  (assoc result current-key (get object current-key nil)))))
        (setq index (1+ index)))
      result))

  (defportable merge (left right)
    (let ((result (object))
          (left-keys (keys left))
          (right-keys (keys right))
          (index 0))
      (while (< index (length left-keys))
        (let ((key (nth index left-keys)))
          (setq result (assoc result key (get left key nil))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (length right-keys))
        (let ((key (nth index right-keys)))
          (setq result (assoc result key (get right key nil))))
        (setq index (1+ index)))
      result))

  (defportable map-values (function object)
    (let ((result (object))
          (source-keys (keys object))
          (index 0))
      (while (< index (length source-keys))
        (let ((key (nth index source-keys)))
          (setq result
                (assoc result key (funcall function (get object key nil)))))
        (setq index (1+ index)))
      result))

  (defportable filter-values (predicate object)
    (let ((result (object))
          (source-keys (keys object))
          (index 0))
      (while (< index (length source-keys))
        (let* ((key (nth index source-keys))
               (value (get object key nil)))
          (when (funcall predicate value)
            (setq result (assoc result key value))))
        (setq index (1+ index)))
      result))

  (defportable pick (object wanted-keys)
    (let ((result (object))
          (index 0))
      (while (< index (length wanted-keys))
        (let ((key (nth index wanted-keys)))
          (when (has? object key)
            (setq result (assoc result key (get object key nil)))))
        (setq index (1+ index)))
      result))

  (defportable omit (object omitted-keys)
    (let ((result (object))
          (source-keys (keys object))
          (index 0))
      (while (< index (length source-keys))
        (let ((key (nth index source-keys)))
          (unless (key-in? key omitted-keys)
            (setq result (assoc result key (get object key nil)))))
        (setq index (1+ index)))
      result))

  (defportable update (object key function)
    (assoc object key (funcall function (get object key nil))))

  (defportable index-by (key-function values)
    (let ((result (object))
          (index 0))
      (while (< index (length values))
        (let* ((value (nth index values))
               (key (funcall key-function value)))
          (setq result (assoc result key value)))
        (setq index (1+ index)))
      result))

  (defportable group-by (key-function values)
    (let ((result (object))
          (index 0))
      (while (< index (length values))
        (let* ((value (nth index values))
               (key (funcall key-function value))
               (group (if (has? result key) (get result key) []))
               (next-group (list value))
               (group-index (1- (length group))))
          (while (>= group-index 0)
            (setq next-group (cons (nth group-index group) next-group)
                  group-index (1- group-index)))
          (setq result (assoc result key next-group)))
        (setq index (1+ index)))
      result))

  (defportable count-by (key-function values)
    (let ((result (object))
          (index 0))
      (while (< index (length values))
        (let* ((value (nth index values))
               (key (funcall key-function value))
               (count (if (has? result key) (get result key) 0)))
          (setq result (assoc result key (1+ count))))
        (setq index (1+ index)))
      result))

  (export keys has? assoc key-in? dissoc merge map-values filter-values
          pick omit update index-by group-by count-by))
