(module eliscript.managed-runtime-metadata
  (import "./map.mjs" isPersistentHashMap)
  (import "../../stdlib/core/protocol.eli" implements-protocol-operation? protocol-method)
  (import "../../stdlib/managed-literal-protocols.eli" I_META I_WITH_META METADATA_READ METADATA_WITH)
  (defconst IMeta I_META)
  (defconst IWithMeta I_WITH_META)
  (defconst meta-method (protocol-method IMeta "meta"))
  (defconst with-meta-method (protocol-method IWithMeta "withMeta"))
  (defun directMetaSlot (value slot)
    (when (and (not (nullish? value))
               (or (= (js* "typeof value") "object") (= (js* "typeof value") "function")))
      (let ((method (aref value slot)))
        (when (= (js* "typeof method") "function") method))))
  (defun supportsMetadata (value)
    (if (and (not (nullish? (directMetaSlot value METADATA_READ)))
             (not (nullish? (directMetaSlot value METADATA_WITH))))
      t
      (and (implements-protocol-operation? IMeta "meta" value)
           (implements-protocol-operation? IWithMeta "withMeta" value))))
  (defun meta (value)
    (let ((slot (directMetaSlot value METADATA_READ)))
      (if (not (nullish? slot))
        (js-call slot :call value)
        (if (implements-protocol-operation? IMeta "meta" value)
          (funcall meta-method value) nil))))
  (defun withMeta (value metadata)
    (unless (or (nil? metadata) (isPersistentHashMap metadata))
      (throw (new globalThis/TypeError "metadata must be null or a persistent hash map")))
    (let ((slot (directMetaSlot value METADATA_WITH)))
      (if (not (nullish? slot))
        (js-call slot :call value metadata)
        (progn
          (unless (implements-protocol-operation? IWithMeta "withMeta" value)
            (throw (new globalThis/TypeError "value does not support metadata")))
          (funcall with-meta-method value metadata)))))
  (defun varyMeta (value transform &rest arguments)
    (unless (= (js* "typeof transform") "function")
      (throw (new globalThis/TypeError "metadata transform must be a function")))
    (withMeta value (apply transform (js-cons (meta value) arguments))))
  (export IMeta IWithMeta supportsMetadata meta withMeta varyMeta))
