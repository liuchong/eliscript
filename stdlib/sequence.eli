(module eliscript.sequence
  (defportable reverse (values)
    (let ((result (js-array))
          (index 0))
      (while (< index (js-length values))
        (setq result (js-cons (js-nth index values) result)
              index (1+ index)))
      result))

  (defportable map (function values)
    (let ((result (js-array))
          (index 0))
      (while (< index (js-length values))
        (setq result (js-cons (funcall function (js-nth index values)) result)
              index (1+ index)))
      (reverse result)))

  (defportable filter (predicate values)
    (let ((result (js-array))
          (index 0))
      (while (< index (js-length values))
        (when (funcall predicate (js-nth index values))
          (setq result (js-cons (js-nth index values) result)))
        (setq index (1+ index)))
      (reverse result)))

  (defportable reduce (function initial values)
    (let ((result initial)
          (index 0))
      (while (< index (js-length values))
        (setq result (funcall function result (js-nth index values))
              index (1+ index)))
      result))

  (defportable concat (left right)
    (let ((result (js-array))
          (index 0))
      (while (< index (js-length left))
        (setq result (js-cons (js-nth index left) result)
              index (1+ index)))
      (setq index 0)
      (while (< index (js-length right))
        (setq result (js-cons (js-nth index right) result)
              index (1+ index)))
      (reverse result)))

  (defportable range-by (start end step)
    (if (= step 0)
        (js-array)
      (let ((result (js-array))
            (current start))
        (while (if (> step 0) (< current end) (> current end))
          (setq result (js-cons current result)
                current (+ current step)))
        (reverse result))))

  (defportable range (start end)
    (range-by start end 1))

  (defportable take (count values)
    (let ((result (js-array))
          (index 0))
      (while (and (< index count) (< index (js-length values)))
        (setq result (js-cons (js-nth index values) result)
              index (1+ index)))
      (reverse result)))

  (defportable drop (count values)
    (let ((result (js-array))
          (index (if (> count 0) count 0)))
      (while (< index (js-length values))
        (setq result (js-cons (js-nth index values) result)
              index (1+ index)))
      (reverse result)))

  (defportable some? (predicate values)
    (let ((matched false)
          (index 0))
      (while (and (< index (js-length values)) (not matched))
        (when (funcall predicate (js-nth index values))
          (setq matched t))
        (setq index (1+ index)))
      matched))

  (defportable every? (predicate values)
    (let ((matched t)
          (index 0))
      (while (and (< index (js-length values)) matched)
        (unless (funcall predicate (js-nth index values))
          (setq matched false))
        (setq index (1+ index)))
      matched))

  (defportable find (predicate values)
    (let ((found false)
          (result nil)
          (index 0))
      (while (and (< index (js-length values)) (not found))
        (when (funcall predicate (js-nth index values))
          (setq result (js-nth index values)
                found t))
        (setq index (1+ index)))
      result))

  (export reverse map filter reduce concat range-by range take drop
          some? every? find))
