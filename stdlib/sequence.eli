(module eliscript.sequence
  (defportable reverse (values)
    (let ((result [])
          (index 0))
      (while (< index (length values))
        (setq result (cons (nth index values) result)
              index (1+ index)))
      result))

  (defportable map (function values)
    (let ((result [])
          (index 0))
      (while (< index (length values))
        (setq result (cons (funcall function (nth index values)) result)
              index (1+ index)))
      (reverse result)))

  (defportable filter (predicate values)
    (let ((result [])
          (index 0))
      (while (< index (length values))
        (when (funcall predicate (nth index values))
          (setq result (cons (nth index values) result)))
        (setq index (1+ index)))
      (reverse result)))

  (defportable reduce (function initial values)
    (let ((result initial)
          (index 0))
      (while (< index (length values))
        (setq result (funcall function result (nth index values))
              index (1+ index)))
      result))

  (defportable concat (left right)
    (let ((result [])
          (index 0))
      (while (< index (length left))
        (setq result (cons (nth index left) result)
              index (1+ index)))
      (setq index 0)
      (while (< index (length right))
        (setq result (cons (nth index right) result)
              index (1+ index)))
      (reverse result)))

  (defportable range-by (start end step)
    (if (= step 0)
        []
      (let ((result [])
            (current start))
        (while (if (> step 0) (< current end) (> current end))
          (setq result (cons current result)
                current (+ current step)))
        (reverse result))))

  (defportable range (start end)
    (range-by start end 1))

  (defportable take (count values)
    (let ((result [])
          (index 0))
      (while (and (< index count) (< index (length values)))
        (setq result (cons (nth index values) result)
              index (1+ index)))
      (reverse result)))

  (defportable drop (count values)
    (let ((result [])
          (index (if (> count 0) count 0)))
      (while (< index (length values))
        (setq result (cons (nth index values) result)
              index (1+ index)))
      (reverse result)))

  (defportable some? (predicate values)
    (let ((matched false)
          (index 0))
      (while (and (< index (length values)) (not matched))
        (when (funcall predicate (nth index values))
          (setq matched t))
        (setq index (1+ index)))
      matched))

  (defportable every? (predicate values)
    (let ((matched t)
          (index 0))
      (while (and (< index (length values)) matched)
        (unless (funcall predicate (nth index values))
          (setq matched false))
        (setq index (1+ index)))
      matched))

  (defportable find (predicate values)
    (let ((found false)
          (result nil)
          (index 0))
      (while (and (< index (length values)) (not found))
        (when (funcall predicate (nth index values))
          (setq result (nth index values)
                found t))
        (setq index (1+ index)))
      result))

  (export reverse map filter reduce concat range-by range take drop
          some? every? find))
