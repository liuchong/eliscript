(module eliscript.managed-runtime-record
  (import "../../stdlib/managed-literals.eli"
    literal-instance? literal-register-transport literal-protocol-runtime-get
    literal-mix literal-finish literal-string-hash literal-entry)
  (import "../../stdlib/managed-literal-protocols.eli"
    COLLECTION_COUNT COLLECTION_EMPTY COLLECTION_CONJ COLLECTION_GET COLLECTION_ASSOC
    COLLECTION_CONTAINS COLLECTION_DISSOC COLLECTION_SEQ COLLECTION_REDUCE COLLECTION_REDUCE_KV
    VALUE_EQUAL VALUE_HASH METADATA_READ METADATA_WITH managed-literal-reduce-iterable)
  (import "./identifier.eli" isKeyword identifierNamespace identifierName keyword)
  (import "./map.eli" EMPTY_MAP PersistentHashMap isPersistentHashMap)

  (defconst record-token (funcall globalThis/Symbol "eliscript.record.constructor-token"))
  (defconst record-state (funcall globalThis/Symbol "eliscript.record.state"))
  (defconst record-types (new globalThis/WeakSet))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun method (implementation name arity)
    (let ((result (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (Object/defineProperty result "length" (js-object :value arity :configurable t)) result))
  (defun install-method (target key name arity implementation)
    (Object/defineProperty target key (js-object :value (method implementation name arity)
      :writable t :configurable t)))
  (defun install-getter (target key name implementation &optional enumerable)
    (Object/defineProperty target key (js-object :get (method implementation name 0)
      :configurable (not enumerable) :enumerable enumerable)))
  (defun map-with-metadata (map metadata)
    (if (nil? metadata) map (js-call (aref map METADATA_WITH) :call map metadata)))
  (defun normalize-name (name)
    (when (or (not (= (js* "typeof name") "string")) (= (js-length name) 0))
      (fail "record type name must be a non-empty string")) name)
  (defun normalize-fields (fields)
    (unless (and (Array/isArray fields) (<= (js-length fields) 1024))
      (fail "record fields must be a dense array of at most 1024 names"))
    (let ((descriptors (Object/getOwnPropertyDescriptors fields))
          (seen (new globalThis/Set)) (result (js-array)) (index 0))
      (unless (= (js-length (Reflect/ownKeys descriptors)) (1+ (js-length fields)))
        (fail "record fields must be a dense array with no extra properties"))
      (while (< index (js-length fields))
        (let* ((descriptor (get descriptors (funcall globalThis/String index)))
               (field (if (nullish? descriptor) undefined (get descriptor :value))))
          (when (or (nullish? descriptor) (not (get descriptor :enumerable))
                    (not (= (js* "typeof field") "string")) (= (js-length field) 0)
                    (js-call field :includes "/"))
            (fail "record field names must be non-empty unqualified strings"))
          (when (js-call seen :has field) (fail (str "record declares duplicate field " field)))
          (js-call seen :add field) (js-call result :push field))
        (setq index (1+ index)))
      (Object/freeze result)))
  (defun declared-field-index (typeState key)
    (if (and (isKeyword key) (nil? (identifierNamespace key)))
        (let ((index (js-call (get typeState :fieldIndexes) :get (identifierName key))))
          (if (nullish? index) -1 index)) -1))
  (defun normalize-map (typeState source)
    (let ((map (try (js-call PersistentHashMap :from source)
                 (catch error
                   (throw (new globalThis/TypeError
                     (str "map->" (get typeState :name) " expects an iterable collection of entries")
                     (js-object :cause error))))))
          (index 0) (keys (get typeState :fieldKeys)))
      (while (< index (js-length keys))
        (let ((key (get keys index)))
          (unless (js-call map :has key) (setq map (js-call map :assoc key nil))))
        (setq index (1+ index))) map))

  (defun make-record-type (name fields reuseFields)
    (let* ((typeName (normalize-name name)) (normalizedFields (normalize-fields fields))
           (fieldNames (if reuseFields fields normalizedFields))
           (fieldKeys (js-array)) (indexes (new globalThis/Map)) (index 0)
           (RecordValue nil) (typeState nil))
      (when (and reuseFields (not (Object/isFrozen fields)))
        (fail "materialized record fields must be a frozen array"))
      (while (< index (js-length fieldNames))
        (let ((field (get fieldNames index)))
          (js-call fieldKeys :push (keyword field)) (js-call indexes :set field index))
        (setq index (1+ index)))
      (Object/freeze fieldKeys)
      (setq typeState (Object/freeze (js-object :name typeName :fieldNames fieldNames
        :fieldKeys fieldKeys :fieldIndexes indexes :signature (str typeName "[" (js-call fieldNames :join ",") "]"))))
      (setq RecordValue (funcall
        (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
        (lambda (self token map &optional metadata)
          (unless (and (eq token record-token) (isPersistentHashMap map))
            (fail (str typeName " values must be created with its record constructors")))
          (Object/defineProperty self record-state (js-object :value (Object/freeze (js-object :map map :metadata metadata))
            :writable t :enumerable t :configurable t))
          (Object/freeze self)) typeName))
      (Object/defineProperty RecordValue "length" (js-object :value 2 :configurable t))
      (install-method RecordValue "create" "create" 0 (lambda (self &rest values)
        (unless (= (js-length values) (js-length fieldNames))
          (fail (str "->" typeName " expects " (js-length fieldNames) " values, received " (js-length values))))
        (let ((map EMPTY_MAP) (at 0))
          (while (< at (js-length values))
            (setq map (js-call map :assoc (get fieldKeys at) (get values at)) at (1+ at)))
          (new RecordValue record-token map))))
      (install-method RecordValue "fromMap" "fromMap" 1 (lambda (self source)
        (new RecordValue record-token (normalize-map typeState source))))
      (install-method RecordValue "isInstance" "isInstance" 1 (lambda (self value)
        (literal-instance? value RecordValue)))
      (let ((prototype (get RecordValue :prototype)))
        (install-getter prototype "count" "get count" (lambda (self) (get (get (aref self record-state) :map) :count)))
        (install-getter prototype "size" "get size" (lambda (self) (get self :count)))
        (install-method prototype "get" "get" 1 (lambda (self key &optional notFound)
          (js-call (get (aref self record-state) :map) :get key notFound)))
        (install-method prototype "has" "has" 1 (lambda (self key)
          (js-call (get (aref self record-state) :map) :has key)))
        (install-method prototype "assoc" "assoc" 2 (lambda (self key value)
          (let* ((state (aref self record-state)) (previous (get state :map)) (map (js-call previous :assoc key value)))
            (if (eq map previous) self (new RecordValue record-token map (get state :metadata))))))
        (install-method prototype "dissoc" "dissoc" 1 (lambda (self key)
          (let* ((state (aref self record-state)) (previous (get state :map)))
            (if (>= (declared-field-index typeState key) 0)
                (map-with-metadata (js-call previous :dissoc key) (get state :metadata))
              (let ((map (js-call previous :dissoc key)))
                (if (eq map previous) self (new RecordValue record-token map (get state :metadata))))))))
        (install-method prototype "entries" "entries" 0 (lambda (self) (js-call (get (aref self record-state) :map) :entries)))
        (install-method prototype "keys" "keys" 0 (lambda (self) (js-call (get (aref self record-state) :map) :keys)))
        (install-method prototype "values" "values" 0 (lambda (self) (js-call (get (aref self record-state) :map) :values)))
        (install-method prototype "toPersistentMap" "toPersistentMap" 0 (lambda (self)
          (let ((state (aref self record-state))) (map-with-metadata (get state :map) (get state :metadata)))))
        (install-method prototype COLLECTION_COUNT "[ICounted.count]" 0 (lambda (self) (get self :count)))
        (install-method prototype COLLECTION_EMPTY "[IEmptyable.empty]" 0 (lambda (self)
          (map-with-metadata EMPTY_MAP (get (aref self record-state) :metadata))))
        (install-method prototype COLLECTION_CONJ "[IConj.conj]" 1 (lambda (self entry)
          (let ((pair (literal-entry entry))) (js-call self :assoc (get pair 0) (get pair 1)))))
        (install-method prototype COLLECTION_GET "[ILookup.get]" 1 (lambda (self key &optional notFound)
          (js-call self :get key notFound)))
        (install-method prototype COLLECTION_ASSOC "[IAssociative.assoc]" 2 (lambda (self key value) (js-call self :assoc key value)))
        (install-method prototype COLLECTION_CONTAINS "[IAssociative.contains]" 1 (lambda (self key) (js-call self :has key)))
        (install-method prototype COLLECTION_DISSOC "[IMap.dissoc]" 1 (lambda (self key) (js-call self :dissoc key)))
        (install-method prototype COLLECTION_SEQ "[ISeqable.seq]" 0 (lambda (self)
          (if (= (get self :count) 0) nil
            (funcall (get (literal-protocol-runtime-get) :sequenceView) (lambda () (js-call self :entries)) (get self :count)))))
        (install-method prototype COLLECTION_REDUCE "[IReduce.reduce]" 1 (lambda (self reducer &rest initial)
          (managed-literal-reduce-iterable self reducer initial)))
        (install-method prototype COLLECTION_REDUCE_KV "[IKVReduce.reduceKV]" 2 (lambda (self reducer initial)
          (managed-literal-reduce-iterable (js-call self :entries)
            (lambda (result entry) (funcall reducer result (get entry 0) (get entry 1))) (js-array initial))))
        (install-method prototype VALUE_EQUAL "[IEquiv.equal]" 2 (lambda (self other equal)
          (and (literal-instance? other RecordValue)
            (funcall equal (get (aref self record-state) :map) (get (aref other record-state) :map)))))
        (install-method prototype VALUE_HASH "[IHash.hash]" 1 (lambda (self hash)
          (literal-finish (literal-mix (literal-mix 1300474159
            (literal-string-hash (get typeState :signature) 1831565813))
            (funcall hash (get (aref self record-state) :map))) (get self :count))))
        (install-method prototype METADATA_READ "[IMeta.meta]" 0 (lambda (self) (get (aref self record-state) :metadata)))
        (install-method prototype METADATA_WITH "[IWithMeta.withMeta]" 1 (lambda (self metadata)
          (let ((state (aref self record-state)))
            (if (eq metadata (get state :metadata)) self
              (new RecordValue record-token (get state :map) metadata)))))
        (install-method prototype (get globalThis/Symbol :iterator) "[Symbol.iterator]" 0 (lambda (self) (js-call self :entries)))
        (install-getter prototype (get globalThis/Symbol :toStringTag) "get [Symbol.toStringTag]"
          (lambda (self) (str "EliscriptRecord:" typeName)))
        (Object/defineProperties RecordValue (js-object
          :recordName (js-object :enumerable t :value typeName)
          :recordFields (js-object :enumerable t :value fieldNames)))
        (setq index 0)
        (while (< index (js-length fieldNames))
          (let ((fieldName (get fieldNames index)) (fieldKey (get fieldKeys index)))
            (when (Reflect/has prototype fieldName) (fail (str "record field " fieldName " conflicts with a record member")))
            (install-getter prototype fieldName "get" (lambda (self)
              (js-call (get (aref self record-state) :map) :get fieldKey)) t))
          (setq index (1+ index)))
        (Object/freeze prototype))
      (Object/freeze RecordValue) (js-call record-types :add RecordValue) RecordValue))

  (defun defineRecordType (name fields) (make-record-type name fields false))
  (defun materializeRecordType (name fields) (make-record-type name fields t))
  (defun isRecordType (value)
    (and (= (js* "typeof value") "function") (js-call record-types :has value)))
  (defun isRecord (value)
    (and (not (nil? value)) (= (js* "typeof value") "object") (isRecordType (get value :constructor))))
  (defun recordType (value)
    (unless (isRecord value) (fail "expected an Eliscript record")) (get value :constructor))
  (defun recordTypeName (value) (get (if (isRecordType value) value (recordType value)) :recordName))
  (defun recordFieldNames (value) (get (if (isRecordType value) value (recordType value)) :recordFields))
  (defun readRecordState (value)
    (if (or (nil? value) (not (= (js* "typeof value") "object"))) undefined
      (let ((descriptor (Object/getOwnPropertyDescriptor value record-state)))
        (if (and (not (undefined? descriptor)) (Object/hasOwn descriptor "value")) (get descriptor :value) undefined))))
  (literal-register-transport "record-type" isRecordType
    (lambda (type) (js-object :kind "record-type" :name (get type :recordName) :fields (get type :recordFields)))
    (lambda (record) (materializeRecordType (get record :name) (get record :fields))))
  (literal-register-transport "record"
    (lambda (value) (and (isRecord value) (not (undefined? (readRecordState value))) (Object/isFrozen value)))
    (lambda (value) (let ((state (readRecordState value)))
      (js-object :kind "record" :type (recordType value) :map (get state :map) :metadata (get state :metadata))))
    (lambda (record)
      (new (get record :type) record-token (get record :map) (get record :metadata nil))))

  (export defineRecordType materializeRecordType isRecordType isRecord recordType recordTypeName recordFieldNames readRecordState))
