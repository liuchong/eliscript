(module eliscript.data
  (import-portable "./object.eli" assoc)
  (import-portable "./object.eli" has?)

  (defportable index-by (key-function values)
    (let ((result (js-object))
          (index 0))
      (while (< index (js-length values))
        (let* ((value (js-nth index values))
               (key (funcall key-function value)))
          (setq result (assoc result key value)))
        (setq index (1+ index)))
      result))

  (defportable group-by (key-function values)
    (let ((result (js-object))
          (index 0))
      (while (< index (js-length values))
        (let* ((value (js-nth index values))
               (key (funcall key-function value))
               (group (if (has? result key) (get result key) (js-array)))
               (next-group (js-array value))
               (group-index (1- (js-length group))))
          (while (>= group-index 0)
            (setq next-group (js-cons (js-nth group-index group) next-group)
                  group-index (1- group-index)))
          (setq result (assoc result key next-group)))
        (setq index (1+ index)))
      result))

  (defportable count-by (key-function values)
    (let ((result (js-object))
          (index 0))
      (while (< index (js-length values))
        (let* ((value (js-nth index values))
               (key (funcall key-function value))
               (count (if (has? result key) (get result key) 0)))
          (setq result (assoc result key (1+ count))))
        (setq index (1+ index)))
      result))

  (export index-by group-by count-by))
