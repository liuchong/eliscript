(module eliscript.data
  (import "../runtime/core/collection.mjs" :as Collection)
  (import "../runtime/core/identifier.mjs"
    isEliscriptSymbol
    isKeyword
    keyword
    qualifiedIdentifierName)
  (import "../runtime/core/list.mjs" EMPTY_LIST persistentList)
  (import "../runtime/core/map.mjs" EMPTY_MAP)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/protocol.mjs" :as Protocol)
  (import "../runtime/core/record.mjs" isRecord)
  (import "../runtime/core/set.mjs" EMPTY_SET)
  (import "../runtime/core/transducer.mjs" into)
  (import "../runtime/core/transient.mjs"
    assocBang
    conjBang
    persistentBang
    transient)
  (import "../runtime/core/vector.mjs" EMPTY_VECTOR)
  (defconst missing-value (js-object))
  (defun ascii-digit? (code)
    (and (>= code 48) (<= code 57)))
  (defun valid-long-string? (text)
    (let ((len (js-length text))
          (idx 0))
      (when (and (< idx len)
                 (let ((ch (js-call text :charCodeAt idx)))
                   (or (= ch 43) (= ch 45))))
        (setq idx (1+ idx)))
      (if (>= idx len)
        false
        (let ((ok t))
          (while (and ok (< idx len))
            (if (ascii-digit? (js-call text :charCodeAt idx))
              (setq idx (1+ idx))
              (setq ok false)))
          ok))))
  (defun valid-double-string? (text)
    (let ((len (js-length text))
          (idx 0)
          (digits-before 0)
          (digits-after 0)
          (has-dot false))
      (when (and (< idx len)
                 (let ((ch (js-call text :charCodeAt idx)))
                   (or (= ch 43) (= ch 45))))
        (setq idx (1+ idx)))
      (while (and (< idx len) (ascii-digit? (js-call text :charCodeAt idx)))
        (setq digits-before (1+ digits-before)
              idx (1+ idx)))
      (when (and (< idx len) (= (js-call text :charCodeAt idx) 46))
        (setq has-dot t
              idx (1+ idx))
        (while (and (< idx len) (ascii-digit? (js-call text :charCodeAt idx)))
          (setq digits-after (1+ digits-after)
                idx (1+ idx))))
      (if (and (= digits-before 0) (or (not has-dot) (= digits-after 0)))
        false
        (if (= idx len)
          t
          (let ((exp-code (js-call text :charCodeAt idx)))
            (if (or (= exp-code 101) (= exp-code 69))
              (progn
                (setq idx (1+ idx))
                (when (and (< idx len)
                           (let ((sc (js-call text :charCodeAt idx)))
                             (or (= sc 43) (= sc 45))))
                  (setq idx (1+ idx)))
                (let ((exp-digits 0)
                      (ok t))
                  (while (and ok (< idx len))
                    (if (ascii-digit? (js-call text :charCodeAt idx))
                      (setq exp-digits (1+ exp-digits)
                            idx (1+ idx))
                      (setq ok false)))
                  (and ok (> exp-digits 0))))
              false))))))
  (defun require-function
    (value label)
    (if (= (value-type value) "function")
      value
      (throw (new globalThis/TypeError (str label " must be a function")))))
  (defun nullish? (value) (or (eq value nil) (eq value globalThis/undefined)))
  (defun path-vector (path) (into EMPTY_VECTOR path))
  (defun read-entry
    (entry)
    (if (= (Collection/count entry) 2)
      (js-object :key (Collection/nth entry 0) :value (Collection/nth entry 1))
      (throw
        (new
          globalThis/TypeError
          "data entries must contain exactly one key/value pair"))))
  (defun reduce-entries
    (collection reducer initial)
    (if
      (and
        (Protocol/implementsProtocolOperation
          Collection/IKVReduce
          "reduceKV"
          collection)
        (not
          (Protocol/implementsProtocolOperation Collection/IIndexed "nth" collection)))
      (Collection/reduceKV collection reducer initial)
      (Collection/reduce
        collection
        (lambda
          (result entry)
          (let ((pair (read-entry entry)))
            (funcall reducer result (get pair :key) (get pair :value))))
        initial)))
  (defun collect-buckets
    (key-function collection create-bucket update-bucket)
    (require-function key-function "data key function")
    (let ((bucket-index (transient EMPTY_MAP)) (keys (js-array)) (buckets (js-array)))
      (Collection/reduce
        collection
        (lambda
          (result value)
          (let*
            ((key (funcall key-function value))
              (index (js-call bucket-index :get key missing-value)))
            (if (eq index missing-value)
              (progn
                (setq index (js-length keys))
                (assocBang bucket-index key index)
                (js-call keys :push key)
                (js-call buckets :push (funcall create-bucket value)))
              (funcall update-bucket buckets index value))
            result))
        nil)
      (js-object :keys keys :buckets buckets)))
  (defun persistent-map-from-buckets
    (keys buckets finish-bucket)
    (let ((result (transient EMPTY_MAP)) (index 0))
      (while (< index (js-length keys))
        (assocBang
          result
          (js-nth index keys)
          (funcall finish-bucket (js-nth index buckets)))
        (setq index (1+ index)))
      (persistentBang result)))
  (defun index-by
    (key-function collection)
    (require-function key-function "indexBy key function")
    (let ((result (transient EMPTY_MAP)))
      (if (and (Array/isArray collection)
               (let ((iter-sym (get globalThis/Symbol :iterator))
                     (reduce-slot (Protocol/protocolSlot Collection/IReduce "reduce"))
                     (proto (Object/getPrototypeOf collection)))
                 (and (not (Object/hasOwn collection iter-sym))
                      (not (Object/hasOwn collection reduce-slot))
                      (not (nil? proto))
                      (or (eq proto (get globalThis/Array :prototype))
                          (not (Object/hasOwn proto reduce-slot)))
                      (let ((iter-fn (aref collection iter-sym)))
                        (or (eq iter-fn (aref globalThis/Array.prototype iter-sym))
                            (eq iter-fn (aref proto :values)))))))
        (let ((index 0) (len (js-length collection)))
          (while (< index len)
            (let ((value (aref collection index)))
              (setq result (assocBang result (funcall key-function value) value)
                    index (1+ index)))))
        (Collection/reduce
          collection
          (lambda
            (builder value)
            (assocBang builder (funcall key-function value) value)
            builder)
          result))
      (persistentBang result)))
  (defun group-by
    (key-function collection)
    (let*
      (
        (grouped
          (collect-buckets
            key-function
            collection
            (lambda (value) (js-array value))
            (lambda (buckets index value) (js-call (js-nth index buckets) :push value))))
        (keys (get grouped :keys))
        (buckets (get grouped :buckets)))
      (persistent-map-from-buckets
        keys
        buckets
        (lambda (values) (into EMPTY_VECTOR values)))))
  (defun count-by
    (key-function collection)
    (let*
      (
        (counted
          (collect-buckets
            key-function
            collection
            (lambda (_value) 1)
            (lambda (counts index _value) (put counts index (1+ (js-nth index counts))))))
        (keys (get counted :keys))
        (buckets (get counted :buckets)))
      (persistent-map-from-buckets keys buckets (lambda (count) count))))
  (defun frequencies (collection) (count-by (lambda (value) value) collection))
  (defun get-in
    (collection path &optional not-found)
    (let*
      ((keys (path-vector path))
        (size (Collection/count keys))
        (index 0)
        (current collection))
      (while (and (< index size) (not (nullish? current)))
        (setq
          current
          (Collection/get current (Collection/nth keys index) missing-value))
        (if (eq current missing-value) (setq index size) (setq index (1+ index))))
      (if (or (eq current missing-value) (and (< index size) (nullish? current)))
        not-found
        current)))
  (defun assoc-in
    (collection path value)
    (let* ((keys (path-vector path)) (size (Collection/count keys)))
      (if (= size 0)
        value
        (let ((parents (js-array)) (current collection) (index 0))
          (while (< index (1- size))
            (js-call parents :push current)
            (if (nullish? current)
              (setq current EMPTY_MAP)
              (let
                (
                  (child
                    (Collection/get current (Collection/nth keys index) missing-value)))
                (setq
                  current
                  (if (or (eq child missing-value) (nullish? child)) EMPTY_MAP child))))
            (setq index (1+ index)))
          (let
            (
              (result
                (Collection/assoc
                  (if (nullish? current) EMPTY_MAP current)
                  (Collection/nth keys (1- size))
                  value)))
            (setq index (- size 2))
            (while (>= index 0)
              (setq
                current
                (js-nth index parents)
                result
                (Collection/assoc
                  (if (nullish? current) EMPTY_MAP current)
                  (Collection/nth keys index)
                  result)
                index
                (1- index)))
            result)))))
  (defun update
    (collection key transform &rest arguments)
    (require-function transform "update transform")
    (let ((target (if (nullish? collection) EMPTY_MAP collection)))
      (Collection/assoc
        target
        key
        (apply transform (js-cons (Collection/get target key) arguments)))))
  (defun update-in
    (collection path transform &rest arguments)
    (require-function transform "updateIn transform")
    (assoc-in
      collection
      path
      (apply transform (js-cons (get-in collection path) arguments))))
  (defun keys
    (collection)
    (let ((result (transient EMPTY_VECTOR)))
      (Collection/reduceKV
        collection
        (lambda (builder key _value) (conjBang builder key) builder)
        result)
      (persistentBang result)))
  (defun vals
    (collection)
    (let ((result (transient EMPTY_VECTOR)))
      (Collection/reduceKV
        collection
        (lambda (builder _key value) (conjBang builder value) builder)
        result)
      (persistentBang result)))
  (defun update-keys
    (collection transform)
    (require-function transform "updateKeys transform")
    (let ((result (transient EMPTY_MAP)))
      (Collection/reduceKV
        collection
        (lambda
          (builder key value)
          (assocBang builder (funcall transform key) value)
          builder)
        result)
      (persistentBang result)))
  (defun update-vals
    (collection transform)
    (require-function transform "updateVals transform")
    (let ((result (transient EMPTY_MAP)))
      (Collection/reduceKV
        collection
        (lambda
          (builder key value)
          (assocBang builder key (funcall transform value))
          builder)
        result)
      (persistentBang result)))
  (defun select-keys
    (collection keys)
    (let ((result (transient EMPTY_MAP)))
      (Collection/reduce
        keys
        (lambda
          (builder key)
          (when (and (not (nullish? collection)) (Collection/contains collection key))
            (assocBang builder key (Collection/get collection key)))
          builder)
        result)
      (persistentBang result)))
  (defun merge
    (&rest collections)
    (let ((result (transient EMPTY_MAP)) (index 0))
      (while (< index (js-length collections))
        (reduce-entries
          (js-nth index collections)
          (lambda (builder key value) (assocBang builder key value) builder)
          result)
        (setq index (1+ index)))
      (persistentBang result)))
  (defun merge-with
    (combine &rest collections)
    (require-function combine "mergeWith combine function")
    (let ((result (transient EMPTY_MAP)) (index 0))
      (while (< index (js-length collections))
        (reduce-entries
          (js-nth index collections)
          (lambda
            (builder key value)
            (let ((existing (js-call builder :get key missing-value)))
              (assocBang
                builder
                key
                (if (eq existing missing-value)
                  value
                  (funcall combine existing value))))
            builder)
          result)
        (setq index (1+ index)))
      (persistentBang result)))
  (defun zipmap
    (keys values)
    (let*
      ((key-vector (path-vector keys))
        (value-vector (path-vector values))
        (key-count (Collection/count key-vector))
        (value-count (Collection/count value-vector))
        (size (if (< key-count value-count) key-count value-count))
        (result (transient EMPTY_MAP))
        (index 0))
      (while (< index size)
        (assocBang
          result
          (Collection/nth key-vector index)
          (Collection/nth value-vector index))
        (setq index (1+ index)))
      (persistentBang result)))
  (defun preserve-metadata (source target)
    (let ((value-meta (meta source)))
      (if (nil? value-meta) target (withMeta target value-meta))))
  (defun editable-map? (value)
    (and (Collection/isMap value) (not (isRecord value))))
  (defun transform-map-keys (form key-transform)
    (let ((map-entry-pred (get Collection :isMapEntry))
          (map-entry-ctor (get Collection :mapEntry)))
      (cond
        ((and (= (value-type map-entry-pred) "function")
              (= (value-type map-entry-ctor) "function")
              (funcall map-entry-pred form))
          (preserve-metadata form
            (funcall map-entry-ctor
              (transform-map-keys (Collection/nth form 0) key-transform)
              (transform-map-keys (Collection/nth form 1) key-transform))))
        ((editable-map? form)
          (let ((result (transient EMPTY_MAP)))
            (Collection/reduceKV
              form
              (lambda (builder key value)
                (assocBang
                  builder
                  (funcall key-transform key)
                  (transform-map-keys value key-transform))
                builder)
              result)
            (preserve-metadata form (persistentBang result))))
        ((Collection/isVector form)
          (let ((result (transient EMPTY_VECTOR)))
            (Collection/reduce
              form
              (lambda (builder value)
                (conjBang builder (transform-map-keys value key-transform))
                builder)
              result)
            (preserve-metadata form (persistentBang result))))
        ((Collection/isSet form)
          (let ((result (transient EMPTY_SET)))
            (Collection/reduce
              form
              (lambda (builder value)
                (conjBang builder (transform-map-keys value key-transform))
                builder)
              result)
            (preserve-metadata form (persistentBang result))))
        ((Collection/isList form)
          (let ((items (js-array)))
            (Collection/reduce
              form
              (lambda (_acc value)
                (js-call items :push (transform-map-keys value key-transform))
                nil)
              nil)
            (preserve-metadata form (if (= (js-length items) 0) EMPTY_LIST (apply persistentList items)))))
        (t form))))
  (defun keywordize-keys (form)
    (transform-map-keys
      form
      (lambda (key)
        (if (= (value-type key) "string") (keyword key) key))))
  (defun stringify-keys (form)
    (transform-map-keys
      form
      (lambda (key)
        (if (or (isKeyword key) (isEliscriptSymbol key))
          (qualifiedIdentifierName key)
          key))))
  (defun parse-long (text)
    (unless (= (value-type text) "string")
      (throw (new globalThis/TypeError "parse-long expects a string")))
    (if (valid-long-string? text)
      (let ((parsed (funcall globalThis/Number text)))
        (if (Number/isSafeInteger parsed)
          (if (Object/is parsed -0.0) 0 parsed)
          nil))
      nil))
  (defun parse-double (text)
    (unless (= (value-type text) "string")
      (throw (new globalThis/TypeError "parse-double expects a string")))
    (let ((trimmed (js-call text :trim)))
      (cond
        ((= trimmed "NaN") (get globalThis/Number :NaN))
        ((or (= trimmed "Infinity") (= trimmed "+Infinity")) (get globalThis/Number :POSITIVE_INFINITY))
        ((= trimmed "-Infinity") (get globalThis/Number :NEGATIVE_INFINITY))
        ((valid-double-string? trimmed) (funcall globalThis/Number trimmed))
        (t nil))))
  (defun parse-boolean (text)
    (unless (= (value-type text) "string")
      (throw (new globalThis/TypeError "parse-boolean expects a string")))
    (cond
      ((= text "true") t)
      ((= text "false") false)
      (t nil)))
  (defun deep-merge-value (combine existing incoming)
    (if (and (editable-map? existing) (editable-map? incoming))
      (let ((builder (transient existing)))
        (Collection/reduceKV
          incoming
          (lambda (acc key value)
            (let ((prev (js-call acc :get key missing-value)))
              (assocBang acc key
                (if (eq prev missing-value)
                  value
                  (deep-merge-value combine prev value))))
            acc)
          builder)
        (persistentBang builder))
      (funcall combine existing incoming)))
  (defun deep-merge-with (combine &rest collections)
    (require-function combine "deep-merge-with combine function")
    (let ((result (transient EMPTY_MAP))
          (index 0))
      (while (< index (js-length collections))
        (let ((coll (js-nth index collections)))
          (unless (nullish? coll)
            (reduce-entries
              coll
              (lambda (builder key value)
                (let ((existing (js-call builder :get key missing-value)))
                  (assocBang builder key
                    (if (eq existing missing-value)
                      value
                      (deep-merge-value combine existing value))))
                builder)
              result)))
        (setq index (1+ index)))
      (persistentBang result)))
  (defun deep-merge (&rest collections)
    (apply deep-merge-with (js-cons (lambda (_old incoming) incoming) collections)))
  (export
    assoc-in
    count-by
    deep-merge
    deep-merge-with
    frequencies
    get-in
    group-by
    index-by
    keys
    keywordize-keys
    merge
    merge-with
    parse-boolean
    parse-double
    parse-long
    select-keys
    stringify-keys
    update
    update-in
    update-keys
    update-vals
    vals
    zipmap))
