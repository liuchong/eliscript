(module eliscript.managed-transient-state
  (import-portable "./persistent-vector.eli" persistent-vector?)
  (import-portable "./persistent-map.eli" persistent-map?)
  (import-portable "./persistent-set.eli" persistent-set?)

  ;; Private editable views of the portable tries. An owner is unique to one
  ;; edit session; persistent inputs are never given that owner or mutated.
  ;; Editing, freezing a session and host array copying are ordinary functions;
  ;; only the pure record and trie arithmetic helpers claim portable analysis.
  (defun managed-transient-active (state label)
    (unless (get state :active)
      (throw (new globalThis/TypeError (str "transient " label " is no longer editable"))))
    state)

  (defportable managed-transient-vector-node (slots owner)
    (js-object :slots slots :owner owner))
  (defun managed-transient-vector-editable (node owner)
    (if (eq (get node :owner nil) owner) node
      (managed-transient-vector-node (js-call (get node :slots) :slice) owner)))
  (defportable managed-transient-vector-new-path (level node owner)
    (if (= level 0) node
      (managed-transient-vector-node
        (js-array (managed-transient-vector-new-path (- level 5) node owner)) owner)))
  (defun managed-transient-vector-push-tail (level parent tail-node count owner)
    (let* ((editable (managed-transient-vector-editable parent owner))
           (slots (get editable :slots))
           (index (bit-and (unsigned-bit-shift-right (1- count) level) 31)))
      (if (= level 5) (put slots index tail-node)
        (let ((child (get slots index)))
          (put slots index
            (if (nullish? child)
              (managed-transient-vector-new-path (- level 5) tail-node owner)
              (managed-transient-vector-push-tail (- level 5) child tail-node count owner)))))
      editable))
  (defun managed-transient-vector-assoc-node (level node index value owner)
    (let* ((editable (managed-transient-vector-editable node owner))
           (slots (get editable :slots))
           (slot (bit-and (unsigned-bit-shift-right index level) 31)))
      (put slots slot
        (if (= level 0) value
          (managed-transient-vector-assoc-node (- level 5) (get slots slot) index value owner)))
      editable))
  (defun managed-transient-vector-tail (state)
    (unless (get state :tailOwned)
      (put state :tail (js-call (get state :tail) :slice))
      (put state :tailOwned t))
    (get state :tail))

  (defun managed-transient-vector-new (vector)
    (unless (persistent-vector? vector)
      (throw (new globalThis/TypeError "transient vectors must be created from a persistent vector")))
    (js-object :active t :changed false :owner (Object/freeze (js-object)) :source vector
      :count (get vector :count) :shift (get vector :shift) :root (get vector :root)
      :tail (get vector :tail) :tailOwned false :metadata (get vector :metadata)))
  (defun managed-transient-vector-conj (state value)
    (managed-transient-active state "vector")
    (let ((count (get state :count)))
      (when (= count 2147483647)
        (throw (new globalThis/RangeError "persistent vector cannot exceed 2147483647 values")))
      (if (< (js-length (get state :tail)) 32)
        (js-call (managed-transient-vector-tail state) :push value)
        (let* ((tail (managed-transient-vector-tail state))
               (owner (get state :owner))
               (node (managed-transient-vector-node tail owner))
               (shift (get state :shift)) (root (get state :root)))
          (if (> (unsigned-bit-shift-right count 5) (bit-shift-left 1 shift))
            (progn
              (put state :root (managed-transient-vector-node
                (js-array root (managed-transient-vector-new-path shift node owner)) owner))
              (put state :shift (+ shift 5)))
            (put state :root (managed-transient-vector-push-tail shift root node count owner)))
          (put state :tail (js-array value)) (put state :tailOwned t)))
      (put state :count (1+ count)) (put state :changed t))
    state)
  (defun managed-transient-vector-assoc (state index value)
    (managed-transient-active state "vector")
    (let ((count (get state :count)))
      (if (= index count) (managed-transient-vector-conj state value)
        (progn
          (unless (and (Number/isInteger index) (>= index 0) (< index count))
            (throw (new globalThis/RangeError
              (str "assocBang index " (funcall globalThis/String index) " is outside [0, " count ")"))))
          (let ((offset (if (< count 32) 0
                          (bit-shift-left (unsigned-bit-shift-right (1- count) 5) 5))))
            (if (>= index offset)
              (put (managed-transient-vector-tail state) (bit-and index 31) value)
              (put state :root (managed-transient-vector-assoc-node
                (get state :shift) (get state :root) index value (get state :owner)))))
          (put state :changed t))))
    state)
  (defun managed-transient-vector-persistent (state)
    (managed-transient-active state "vector")
    (let ((result
            (if (get state :changed)
              (js-object :kind "eliscript/persistent-vector" :count (get state :count)
                :shift (get state :shift) :root (get state :root) :tail (get state :tail)
                :metadata (get state :metadata))
              (get state :source))))
      (put state :active false) (put state :owner nil) result))

  (defportable managed-transient-map-entry (hash key value)
    (js-object :kind "entry" :hash hash :key key :value value))
  (defportable managed-transient-map-bitmap (bitmap items owner)
    (js-object :kind "bitmap" :bitmap (uint32 bitmap) :items items :owner owner))
  (defportable managed-transient-map-array (count children owner)
    (js-object :kind "array" :count count :children children :owner owner))
  (defportable managed-transient-map-collision (hash entries owner)
    (js-object :kind "collision" :hash hash :entries entries :owner owner))
  (defun managed-transient-map-editable (node owner)
    (if (eq (get node :owner nil) owner) node
      (cond
        ((= (get node :kind) "bitmap")
          (managed-transient-map-bitmap (get node :bitmap) (js-call (get node :items) :slice) owner))
        ((= (get node :kind) "array")
          (managed-transient-map-array (get node :count) (js-call (get node :children) :slice) owner))
        (t (managed-transient-map-collision (get node :hash) (js-call (get node :entries) :slice) owner)))))
  (defportable managed-transient-map-bit-count (value)
    (let* ((bits (uint32 value))
           (pairs (- bits (bit-and (unsigned-bit-shift-right bits 1) 1431655765)))
           (quads (+ (bit-and pairs 858993459) (bit-and (unsigned-bit-shift-right pairs 2) 858993459)))
           (octets (bit-and (+ quads (unsigned-bit-shift-right quads 4)) 252645135)))
      (unsigned-bit-shift-right (imul32 octets 16843009) 24)))
  (defportable managed-transient-map-index (hash shift)
    (bit-and (unsigned-bit-shift-right hash shift) 31))
  (defportable managed-transient-map-bit (hash shift)
    (uint32 (bit-shift-left 1 (managed-transient-map-index hash shift))))
  (defportable managed-transient-map-packed (bitmap bit)
    (managed-transient-map-bit-count (bit-and bitmap (1- bit))))
  (defportable managed-transient-map-result (item added changed)
    (js-object :item item :added added :changed changed))
  (defportable managed-transient-map-removal (item removed)
    (js-object :item item :removed removed))
  (defportable managed-transient-map-same-entry (entry hash key equal-key)
    (and (= (get entry :hash) hash) (funcall equal-key (get entry :key) key)))

  (defportable managed-transient-map-merge (shift left left-hash right owner)
    (let ((right-hash (get right :hash)))
      (if (= left-hash right-hash)
        (managed-transient-map-collision left-hash (js-array left right) owner)
        (let ((a (managed-transient-map-index left-hash shift))
              (b (managed-transient-map-index right-hash shift)))
          (if (= a b)
            (managed-transient-map-bitmap (managed-transient-map-bit left-hash shift)
              (js-array (managed-transient-map-merge (+ shift 5) left left-hash right owner)) owner)
            (managed-transient-map-bitmap
              (bit-or (managed-transient-map-bit left-hash shift) (managed-transient-map-bit right-hash shift))
              (if (< a b) (js-array left right) (js-array right left)) owner))))))
  (defun managed-transient-map-promote (node shift entry owner)
    (let ((children (js-array)) (index 0) (packed 0) (bitmap (get node :bitmap))
          (items (get node :items)) (entry-index (managed-transient-map-index (get entry :hash) shift)))
      (while (< index 32)
        (let ((bit (uint32 (bit-shift-left 1 index))))
          (if (/= (bit-and bitmap bit) 0)
            (progn (js-call children :push (get items packed)) (setq packed (1+ packed)))
            (js-call children :push (if (= index entry-index) entry nil))))
        (setq index (1+ index)))
      (managed-transient-map-array (1+ (js-length items)) children owner)))
  (defun managed-transient-map-pack (node removed-index owner)
    (let ((bitmap 0) (items (js-array)) (children (get node :children)) (index 0))
      (while (< index 32)
        (unless (= index removed-index)
          (let ((child (get children index)))
            (unless (nullish? child)
              (setq bitmap (uint32 (bit-or bitmap (bit-shift-left 1 index))))
              (js-call items :push child))))
        (setq index (1+ index)))
      (managed-transient-map-bitmap bitmap items owner)))
  (defportable managed-transient-map-find-collision (entries key equal-key)
    (let ((index 0) (found -1))
      (while (and (< index (js-length entries)) (< found 0))
        (when (funcall equal-key (get (get entries index) :key) key) (setq found index))
        (setq index (1+ index)))
      found))

  (defun managed-transient-map-assoc-item (node shift hash key value owner equal-key equal-value)
    (cond
      ((nullish? node)
        (managed-transient-map-result (managed-transient-map-entry hash key value) t t))
      ((= (get node :kind) "entry")
        (if (managed-transient-map-same-entry node hash key equal-key)
          (if (funcall equal-value (get node :value) value)
            (managed-transient-map-result node false false)
            (managed-transient-map-result (managed-transient-map-entry hash (get node :key) value) false t))
          (managed-transient-map-result
            (managed-transient-map-merge shift node (get node :hash) (managed-transient-map-entry hash key value) owner) t t)))
      ((= (get node :kind) "bitmap")
        (let* ((bit (managed-transient-map-bit hash shift)) (bitmap (get node :bitmap))
               (items (get node :items)) (index (managed-transient-map-packed bitmap bit)))
          (if (= (bit-and bitmap bit) 0)
            (if (>= (1+ (js-length items)) 32)
              (managed-transient-map-result
                (managed-transient-map-promote node shift (managed-transient-map-entry hash key value) owner) t t)
              (let ((editable (managed-transient-map-editable node owner))
                    (entry (managed-transient-map-entry hash key value)))
                (put editable :bitmap (uint32 (bit-or bitmap bit)))
                (js-call (get editable :items) :splice index 0 entry)
                (managed-transient-map-result editable t t)))
            (let ((result (managed-transient-map-assoc-item
                    (get items index) (+ shift 5) hash key value owner equal-key equal-value)))
              (if (not (get result :changed)) (managed-transient-map-result node false false)
                (let ((editable (managed-transient-map-editable node owner)))
                  (put (get editable :items) index (get result :item))
                  (managed-transient-map-result editable (get result :added) t)))))))
      ((= (get node :kind) "array")
        (let* ((index (managed-transient-map-index hash shift)) (children (get node :children))
               (existing (get children index)))
          (if (nullish? existing)
            (let ((editable (managed-transient-map-editable node owner))
                  (entry (managed-transient-map-entry hash key value)))
              (put (get editable :children) index entry)
              (put editable :count (1+ (get editable :count)))
              (managed-transient-map-result editable t t))
            (let ((result (managed-transient-map-assoc-item
                    existing (+ shift 5) hash key value owner equal-key equal-value)))
              (if (not (get result :changed)) (managed-transient-map-result node false false)
                (let ((editable (managed-transient-map-editable node owner)))
                  (put (get editable :children) index (get result :item))
                  (managed-transient-map-result editable (get result :added) t)))))))
      (t
        (if (/= (get node :hash) hash)
          (managed-transient-map-result
            (managed-transient-map-merge shift node (get node :hash) (managed-transient-map-entry hash key value) owner) t t)
          (let* ((entries (get node :entries))
                 (index (managed-transient-map-find-collision entries key equal-key)))
            (if (>= index 0)
              (let ((existing (get entries index)))
                (if (funcall equal-value (get existing :value) value)
                  (managed-transient-map-result node false false)
                  (let ((editable (managed-transient-map-editable node owner))
                        (entry (managed-transient-map-entry hash (get existing :key) value)))
                    (put (get editable :entries) index entry)
                    (managed-transient-map-result editable false t))))
              (let ((editable (managed-transient-map-editable node owner))
                    (entry (managed-transient-map-entry hash key value)))
                (js-call (get editable :entries) :push entry)
                (managed-transient-map-result editable t t))))))))

  (defun managed-transient-map-remove-packed (node bit index owner)
    (if (= (js-length (get node :items)) 1) nil
      (let ((editable (managed-transient-map-editable node owner)))
        (put editable :bitmap (uint32 (bit-xor (get editable :bitmap) bit)))
        (js-call (get editable :items) :splice index 1) editable)))
  (defun managed-transient-map-dissoc-item (node shift hash key owner equal-key)
    (cond
      ((nullish? node) (managed-transient-map-removal node false))
      ((= (get node :kind) "entry")
        (if (managed-transient-map-same-entry node hash key equal-key)
          (managed-transient-map-removal nil t) (managed-transient-map-removal node false)))
      ((= (get node :kind) "bitmap")
        (let* ((bit (managed-transient-map-bit hash shift)) (bitmap (get node :bitmap)))
          (if (= (bit-and bitmap bit) 0) (managed-transient-map-removal node false)
            (let* ((index (managed-transient-map-packed bitmap bit))
                   (result (managed-transient-map-dissoc-item
                     (get (get node :items) index) (+ shift 5) hash key owner equal-key)))
              (if (not (get result :removed)) (managed-transient-map-removal node false)
                (if (nullish? (get result :item))
                  (managed-transient-map-removal (managed-transient-map-remove-packed node bit index owner) t)
                  (let ((editable (managed-transient-map-editable node owner)))
                    (put (get editable :items) index (get result :item))
                    (managed-transient-map-removal editable t))))))))
      ((= (get node :kind) "array")
        (let* ((index (managed-transient-map-index hash shift))
               (existing (get (get node :children) index)))
          (if (nullish? existing) (managed-transient-map-removal node false)
            (let ((result (managed-transient-map-dissoc-item existing (+ shift 5) hash key owner equal-key)))
              (if (not (get result :removed)) (managed-transient-map-removal node false)
                (let* ((child (get result :item))
                       (count (if (nullish? child) (1- (get node :count)) (get node :count))))
                  (if (and (nullish? child) (<= count 24))
                    (managed-transient-map-removal (managed-transient-map-pack node index owner) t)
                    (let ((editable (managed-transient-map-editable node owner)))
                      (put (get editable :children) index child) (put editable :count count)
                      (managed-transient-map-removal editable t)))))))))
      (t
        (if (/= (get node :hash) hash) (managed-transient-map-removal node false)
          (let* ((entries (get node :entries)) (index (managed-transient-map-find-collision entries key equal-key)))
            (if (< index 0) (managed-transient-map-removal node false)
              (if (= (js-length entries) 2)
                (managed-transient-map-removal (get entries (if (= index 0) 1 0)) t)
                (let ((editable (managed-transient-map-editable node owner)))
                  (js-call (get editable :entries) :splice index 1)
                  (managed-transient-map-removal editable t)))))))))

  (defun managed-transient-map-new (map)
    (unless (persistent-map? map)
      (throw (new globalThis/TypeError "transient hash maps must be created from a persistent hash map")))
    (js-object :active t :changed false :owner (Object/freeze (js-object)) :source map
      :count (get map :count) :root (get map :root) :metadata (get map :metadata)
      :hash-function (get map :hash-function) :key-equal-function (get map :key-equal-function)
      :value-equal-function (get map :value-equal-function)))
  (defun managed-transient-map-assoc (state key value)
    (managed-transient-active state "hash map")
    (let* ((root (get state :root)) (owner (get state :owner))
           (hash (uint32 (funcall (get state :hash-function) key)))
           (result (managed-transient-map-assoc-item root 0 hash key value owner
             (get state :key-equal-function) (get state :value-equal-function))))
      (when (get result :changed)
        (put state :root (get result :item))
        (when (get result :added) (put state :count (1+ (get state :count))))
        (put state :changed t)))
    state)
  (defun managed-transient-map-dissoc (state key)
    (managed-transient-active state "hash map")
    (let* ((root (get state :root)) (owner (get state :owner))
           (hash (uint32 (funcall (get state :hash-function) key)))
           (result (managed-transient-map-dissoc-item root 0 hash key owner (get state :key-equal-function))))
      (when (get result :removed)
        (put state :count (1- (get state :count)))
        (put state :root (if (= (get state :count) 0) nil (get result :item)))
        (put state :changed t)))
    state)
  (defun managed-transient-map-persistent (state)
    (managed-transient-active state "hash map")
    (let ((result
            (if (get state :changed)
              (js-object :kind "eliscript/persistent-map" :count (get state :count) :root (get state :root)
                :hash-function (get state :hash-function) :key-equal-function (get state :key-equal-function)
                :value-equal-function (get state :value-equal-function) :metadata (get state :metadata))
              (get state :source))))
      (put state :active false) (put state :owner nil) result))

  (defun managed-transient-set-new (set)
    (unless (persistent-set? set)
      (throw (new globalThis/TypeError "transient hash sets must be created from a persistent hash set")))
    (let ((map (get set :map)))
      (js-object :active t :source set :sourceMap map :map (managed-transient-map-new map)
        :metadata (get set :metadata) :hash-function (get set :hash-function)
        :key-equal-function (get set :key-equal-function))))
  (defun managed-transient-set-conj (state value)
    (managed-transient-active state "hash set")
    (managed-transient-map-assoc (get state :map) value t) state)
  (defun managed-transient-set-disj (state value)
    (managed-transient-active state "hash set")
    (managed-transient-map-dissoc (get state :map) value) state)
  (defun managed-transient-set-persistent (state)
    (managed-transient-active state "hash set")
    (let* ((map (managed-transient-map-persistent (get state :map)))
           (result
             (if (eq map (get state :sourceMap)) (get state :source)
               (js-object :kind "eliscript/persistent-set" :map map
                 :hash-function (get state :hash-function) :key-equal-function (get state :key-equal-function)
                 :metadata (get state :metadata)))))
      (put state :active false) result))

  (export managed-transient-vector-new managed-transient-vector-conj managed-transient-vector-assoc
    managed-transient-vector-persistent managed-transient-map-new managed-transient-map-assoc
    managed-transient-map-dissoc managed-transient-map-persistent managed-transient-set-new
    managed-transient-set-conj managed-transient-set-disj managed-transient-set-persistent))
