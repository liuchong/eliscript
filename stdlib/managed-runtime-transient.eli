(module eliscript.managed-runtime-transient
  (import "../../stdlib/managed-literal-protocols.eli"
    I_EDITABLE I_TRANSIENT_COLLECTION managed-literal-transient managed-literal-conj-bang
    managed-literal-assoc-bang managed-literal-dissoc-bang managed-literal-persistent-bang)

  (defconst IEditable I_EDITABLE)
  (defconst ITransientCollection I_TRANSIENT_COLLECTION)
  (defun transient (collection) (managed-literal-transient collection))
  (defun conjBang (collection &rest values)
    (apply managed-literal-conj-bang (js-call (js-array collection) :concat values)))
  (defun assocBang (&rest arguments) (apply managed-literal-assoc-bang arguments))
  (Object/defineProperty assocBang "length" (js-object :value 3 :configurable t))
  (defun dissocBang (collection &rest keys)
    (apply managed-literal-dissoc-bang (js-call (js-array collection) :concat keys)))
  (defun persistentBang (collection) (managed-literal-persistent-bang collection))

  (export IEditable ITransientCollection transient conjBang assocBang dissocBang persistentBang))
