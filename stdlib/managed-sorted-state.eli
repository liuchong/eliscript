(module eliscript.managed-sorted-state
  (import "../runtime/core/value.mjs" equalValues)

  ;; Captured at load: replacing globalThis.WeakMap later cannot break the
  ;; iterator state tables.
  (defconst intrinsic-weak-map globalThis/WeakMap)

  ;; Nodes and paths are immutable. Rotations rebuild only the affected spine.
  (defvar SortedNode nil)
  (defvar SortedNode-prototype nil)
  (defvar default-comparator nil)
  (defun managed-sorted-set-default-comparator (comparison)
    (setq default-comparator comparison))
  (defun ensure-sorted-node-prototype ()
    (when (nil? SortedNode-prototype)
      (setq SortedNode (funcall
        (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
        (lambda (self key value &optional left right)
          (when (undefined? left) (setq left nil)) (when (undefined? right) (setq right nil))
          (put self :key key) (put self :value value) (put self :left left) (put self :right right)
          (put self :height (let ((lh (if (nil? left) 0 (get left :height)))
                                 (rh (if (nil? right) 0 (get right :height))))
                              (1+ (if (> lh rh) lh rh))))
          (put self :size (+ (if (nil? left) 0 (get left :size)) (if (nil? right) 0 (get right :size)) 1))
          (Object/freeze self)) "SortedNode"))
      (Object/defineProperty SortedNode "length" (js-object :value 2 :configurable t))
      (setq SortedNode-prototype (get SortedNode :prototype)))
    SortedNode-prototype)
  (defun managed-sorted-height (node) (if (nil? node) 0 (get node :height)))
  (defun managed-sorted-size (node) (if (nil? node) 0 (get node :size)))
  (defun managed-sorted-node (key value left right)
    ;; Use Set for every field, in constructor order. The VM accelerates only
    ;; ordinary absent-property writes; inherited setters and readonly fields
    ;; retain the same behavior even when an earlier setter changes the chain.
    (let ((self (js-object :__proto__ (or SortedNode-prototype (ensure-sorted-node-prototype)))))
      (put self :key key) (put self :value value) (put self :left left) (put self :right right)
      (put self :height (let ((lh (if (nil? left) 0 (get left :height)))
                             (rh (if (nil? right) 0 (get right :height))))
                          (1+ (if (> lh rh) lh rh))))
      (put self :size (+ (if (nil? left) 0 (get left :size)) (if (nil? right) 0 (get right :size)) 1))
      (Object/freeze self)))
  (defun managed-sorted-rotate-left (root)
    (let* ((promoted (get root :right))
           (retained (managed-sorted-node (get root :key) (get root :value) (get root :left) (get promoted :left))))
      (managed-sorted-node (get promoted :key) (get promoted :value) retained (get promoted :right))))
  (defun managed-sorted-rotate-right (root)
    (let* ((promoted (get root :left))
           (retained (managed-sorted-node (get root :key) (get root :value) (get promoted :right) (get root :right))))
      (managed-sorted-node (get promoted :key) (get promoted :value) (get promoted :left) retained)))
  (defun managed-sorted-balance (root)
    (let* ((left (get root :left))
           (right (get root :right))
           (lh (if (nil? left) 0 (get left :height)))
           (rh (if (nil? right) 0 (get right :height)))
           (delta (- lh rh)))
      (cond
        ((> delta 1)
          (let* ((ll (get left :left))
                 (lr (get left :right))
                 (prepared (if (< (if (nil? ll) 0 (get ll :height))
                                  (if (nil? lr) 0 (get lr :height)))
                   (managed-sorted-node (get root :key) (get root :value) (managed-sorted-rotate-left left) right)
                   root)))
            (managed-sorted-rotate-right prepared)))
        ((< delta -1)
          (let* ((rl (get right :left))
                 (rr (get right :right))
                 (prepared (if (< (if (nil? rr) 0 (get rr :height))
                                  (if (nil? rl) 0 (get rl :height)))
                   (managed-sorted-node (get root :key) (get root :value) left (managed-sorted-rotate-right right))
                   root)))
            (managed-sorted-rotate-left prepared)))
        (t root))))
  (defun managed-sorted-find (root key comparison)
    (let ((current root) (found nil) (done false)
          (is-default (and (not (nil? default-comparator)) (eq comparison default-comparator))))
      (while (and (not (nil? current)) (not done))
        (let* ((ckey (get current :key))
               (order (if is-default
                        (cond
                          ((eq key ckey) 0)
                          ((and (= (js* "typeof key") "number") (= (js* "typeof ckey") "number"))
                            (if (Number/isNaN key) (if (Number/isNaN ckey) 0 1)
                              (if (Number/isNaN ckey) -1 (if (< key ckey) -1 1))))
                          ((and (= (js* "typeof key") "string") (= (js* "typeof ckey") "string"))
                            (if (< key ckey) -1 1))
                          (t (funcall comparison key ckey)))
                        (funcall comparison key ckey))))
          (if (= order 0) (setq found current done t)
            (setq current (if (< order 0) (get current :left) (get current :right))))))
      found))
  (defun managed-sorted-assoc-loop (root key value comparison is-default)
    (if (nil? root)
      (managed-sorted-node key value nil nil)
      (let* ((rkey (get root :key))
             (order (if is-default
                      (cond
                        ((eq key rkey) 0)
                        ((and (= (js* "typeof key") "number") (= (js* "typeof rkey") "number"))
                          (if (Number/isNaN key) (if (Number/isNaN rkey) 0 1)
                            (if (Number/isNaN rkey) -1 (if (< key rkey) -1 1))))
                        ((and (= (js* "typeof key") "string") (= (js* "typeof rkey") "string"))
                          (if (< key rkey) -1 1))
                        (t (funcall comparison key rkey)))
                      (funcall comparison key rkey))))
        (if (= order 0)
          (let ((old-val (get root :value)))
            (if (or (Object/is old-val value) (equalValues old-val value)) root
              (managed-sorted-node rkey value (get root :left) (get root :right))))
          (if (< order 0)
            (let* ((left (get root :left))
                   (next-left (managed-sorted-assoc-loop left key value comparison is-default)))
              (if (eq next-left left) root
                (managed-sorted-balance (managed-sorted-node rkey (get root :value) next-left (get root :right)))))
            (let* ((right (get root :right))
                   (next-right (managed-sorted-assoc-loop right key value comparison is-default)))
              (if (eq next-right right) root
                (managed-sorted-balance (managed-sorted-node rkey (get root :value) (get root :left) next-right)))))))))
  (defun managed-sorted-assoc (root key value comparison)
    (managed-sorted-assoc-loop root key value comparison
      (and (not (nil? default-comparator)) (eq comparison default-comparator))))
  (defun managed-sorted-minimum (root)
    (let ((current root))
      (while (not (nil? (get current :left))) (setq current (get current :left))) current))
  (defun managed-sorted-remove-minimum (root)
    (if (nil? (get root :left)) (get root :right)
      (managed-sorted-balance (managed-sorted-node (get root :key) (get root :value)
        (managed-sorted-remove-minimum (get root :left)) (get root :right)))))
  (defun managed-sorted-dissoc-loop (root key comparison is-default)
    (if (nil? root) nil
      (let* ((rkey (get root :key))
             (order (if is-default
                      (cond
                        ((eq key rkey) 0)
                        ((and (= (js* "typeof key") "number") (= (js* "typeof rkey") "number"))
                          (if (Number/isNaN key) (if (Number/isNaN rkey) 0 1)
                            (if (Number/isNaN rkey) -1 (if (< key rkey) -1 1))))
                        ((and (= (js* "typeof key") "string") (= (js* "typeof rkey") "string"))
                          (if (< key rkey) -1 1))
                        (t (funcall comparison key rkey)))
                      (funcall comparison key rkey))))
        (if (= order 0)
          (cond ((nil? (get root :left)) (get root :right))
            ((nil? (get root :right)) (get root :left))
            (t (let ((successor (managed-sorted-minimum (get root :right))))
              (managed-sorted-balance (managed-sorted-node
                (get successor :key) (get successor :value) (get root :left)
                (managed-sorted-remove-minimum (get root :right)))))))
          (if (< order 0)
            (let* ((left (get root :left))
                   (next-left (managed-sorted-dissoc-loop left key comparison is-default)))
              (if (eq next-left left) root
                (managed-sorted-balance (managed-sorted-node rkey (get root :value) next-left (get root :right)))))
            (let* ((right (get root :right))
                   (next-right (managed-sorted-dissoc-loop right key comparison is-default)))
              (if (eq next-right right) root
                (managed-sorted-balance (managed-sorted-node rkey (get root :value) (get root :left) next-right)))))))))
  (defun managed-sorted-dissoc (root key comparison)
    (managed-sorted-dissoc-loop root key comparison
      (and (not (nil? default-comparator)) (eq comparison default-comparator))))

  ;; The bridge supplies an already ordered bulk payload. Rebuilding its shape
  ;; must not normalize or invoke the user's comparator a second time.
  (defun managed-sorted-build (values start end map-mode present)
    (if (>= start end) nil
      (let* ((middle (unsigned-bit-shift-right (+ start end) 1)) (entry (get values middle))
             (key (if map-mode (get entry 0) entry)) (value (if map-mode (get entry 1) present)))
        (managed-sorted-node key value
          (managed-sorted-build values start middle map-mode present)
          (managed-sorted-build values (1+ middle) end map-mode present)))))

  ;; Compact iterator state array indices:
  ;; 0=transform, 1=mode, 2=started, 3=done, 4=busy,
  ;; 5=root/factory, 6=comparison/source, 7=ascending/next, 8=start, 9=end, 10=stack, 11=resume
  (defvar iterator-states nil)
  (defun iterator-state (receiver)
    (let ((state (if (nil? iterator-states) undefined (js-call iterator-states :get receiver))))
      (when (undefined? state) (throw (new globalThis/TypeError "incompatible sorted iterator receiver"))) state))
  (defun iterator-not-running (state)
    (when (aref state 4) (throw (new globalThis/TypeError "Generator is already running"))))
  (defun iterator-clear (state)
    (put state 3 t) (put state 5 nil) (put state 6 nil)
    (put state 7 nil) (put state 8 nil) (put state 9 nil)
    (put state 10 nil) (put state 11 nil))
  (defun push-start (state root start)
    (let ((current root) (stack (aref state 10)) (ascending (aref state 7))
          (comparison (aref state 6)))
      (while (not (nil? current))
        (if (nil? start)
          (progn (js-call stack :push current) (setq current (if ascending (get current :left) (get current :right))))
          (let* ((order (funcall comparison (get current :key) (get start :key)))
                 (eligible (if ascending (or (> order 0) (and (get start :inclusive) (= order 0)))
                             (or (< order 0) (and (get start :inclusive) (= order 0))))))
            (if eligible
              (progn (js-call stack :push current) (setq current (if ascending (get current :left) (get current :right))))
              (setq current (if ascending (get current :right) (get current :left)))))))))
  (defun iterator-next-avl (state)
    (iterator-not-running state)
    (if (aref state 3) (js-object :value undefined :done t)
      (progn
        (put state 4 t)
        (try
          (unless (aref state 2)
            (put state 2 t) (push-start state (aref state 5) (aref state 8))
            (put state 5 nil) (put state 8 nil))
          ;; The right/left subtree is visited only on resume, after the
          ;; previous yield, preserving comparator effects between nexts.
          (unless (nil? (aref state 11))
            (let ((resume (aref state 11))) (put state 11 nil) (push-start state resume nil)))
          (let ((stack (aref state 10)))
            (if (= (js-length stack) 0)
              (progn (iterator-clear state) (js-object :value undefined :done t))
              (let* ((current (js-call stack :pop)) (end (aref state 9)) (beyond false))
                (unless (nil? end)
                  (let ((order (funcall (aref state 6) (get current :key) (get end :key))))
                    (setq beyond (if (aref state 7)
                      (or (> order 0) (and (not (get end :inclusive)) (= order 0)))
                      (or (< order 0) (and (not (get end :inclusive)) (= order 0)))))))
                (if beyond (progn (iterator-clear state) (js-object :value undefined :done t))
                  (let* ((mode (aref state 1))
                         (value (cond ((= mode 0) current)
                           ((= mode 1) (Object/freeze (js-array (get current :key) (get current :value))))
                           ((= mode 3) (get current :value))
                           ((= mode 4) (Object/freeze (js-array (get current :key) (get current :key))))
                           (t (get current :key)))))
                    (put state 11 (if (aref state 7) (get current :right) (get current :left)))
                    (js-object :value value :done false))))))
          (catch error (iterator-clear state) (throw error))
          (finally (put state 4 false))))))
  (defun source-object? (value)
    (or (and (not (nil? value)) (= (js* "typeof value") "object")) (= (js* "typeof value") "function")))
  (defun transform-start (state)
    (let* ((iterable (funcall (aref state 5)))
           (method (get iterable (get globalThis/Symbol :iterator)))
           (source (js-call method :call iterable)))
      (unless (source-object? source) (throw (new globalThis/TypeError "iterator must be an object")))
      (put state 6 source) (put state 7 (get source :next))
      (put state 5 nil) (put state 2 t)))
  (defun transform-close (state)
    (let ((source (aref state 6)))
      (unless (nil? source)
        (let ((close (get source :return)))
          (unless (nullish? close)
            (let ((result (js-call close :call source)))
              (unless (source-object? result) (throw (new globalThis/TypeError "iterator return must return an object")))))))))
  (defun iterator-next-transform (state)
    (let ((body-active false))
      (iterator-not-running state)
      (if (aref state 3) (js-object :value undefined :done t)
        (progn
          (put state 4 t)
          (try
            (unless (aref state 2) (transform-start state))
            (let ((step (js-call (aref state 7) :call (aref state 6))))
              (unless (source-object? step) (throw (new globalThis/TypeError "iterator result must be an object")))
              (if (sorted-state-truth (get step :done))
                (progn (iterator-clear state) (js-object :value undefined :done t))
                (let ((item (get step :value)))
                  ;; IteratorStepValue abrupt completion does not close. Only
                  ;; an abrupt mapping/yield-body completion closes its input.
                  (setq body-active t)
                  (let ((mode (aref state 1)))
                    (js-object :value (if (= mode 2) (Object/freeze (js-array item item))
                                        (get item (if (= mode 0) 0 1))) :done false)))))
            (catch error
              (when body-active (try (transform-close state) (catch ignored nil)))
              (iterator-clear state) (throw error))
            (finally (put state 4 false)))))))
  (defun sorted-state-truth (value) (js* "!!value"))
  (defun iterator-method (implementation name arity)
    (let ((method (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, this, args); } })[name]; }")
      implementation name)))
      (unless (= arity 0)
        (Object/defineProperty method "length" (js-object :value arity :configurable t)))
      method))
  (defvar iterator-prototype nil)
  ;; Named implementations receive the wrapper receiver dynamically.
  ;; Arrow bodies would capture the initializer receiver instead.
  (defun sorted-iterator-next-method (&optional ignored)
    (let ((state (iterator-state (js* "this"))))
      (if (aref state 0)
        (iterator-next-transform state) (iterator-next-avl state))))
  (defun sorted-iterator-return-method (&optional value)
    (let ((state (iterator-state (js* "this"))))
      (iterator-not-running state) (put state 4 t)
      (try
        (when (and (aref state 0) (aref state 2) (not (aref state 3)))
          (transform-close state))
        (js-object :value value :done t)
        (finally (iterator-clear state) (put state 4 false)))))
  (defun sorted-iterator-throw-method (&optional value)
    (let ((state (iterator-state (js* "this"))))
      (iterator-not-running state) (put state 4 t)
      (try
        (when (and (aref state 0) (aref state 2) (not (aref state 3)))
          (try (transform-close state) (catch ignored nil)))
        (throw value)
        (finally (iterator-clear state) (put state 4 false)))))
  (defun sorted-iterator-self-method () (js* "this"))
  (defun ensure-iterator-prototype ()
    (when (nil? iterator-prototype)
      (setq iterator-prototype (js-object))
      (Object/defineProperties iterator-prototype (js-object
        :next (js-object :value (iterator-method sorted-iterator-next-method "next" 1) :writable t :configurable t)
        :return (js-object :value (iterator-method sorted-iterator-return-method "return" 1) :writable t :configurable t)
        :throw (js-object :value (iterator-method sorted-iterator-throw-method "throw" 1) :writable t :configurable t)))
      (Object/defineProperty iterator-prototype (get globalThis/Symbol :iterator)
        (js-object :value (iterator-method sorted-iterator-self-method "[Symbol.iterator]" 0) :writable t :configurable t))
      (Object/defineProperty iterator-prototype (get globalThis/Symbol :toStringTag)
        (js-object :value "Generator" :configurable t)))
    iterator-prototype)
  (defun managed-sorted-iterator (root comparison ascending start end mode)
    (let ((iterator (Object/create (Object/create (ensure-iterator-prototype))))
          (table (or iterator-states (setq iterator-states (new intrinsic-weak-map)))))
      (js-call table :set iterator (js-array false mode false false false
        root comparison (sorted-state-truth ascending) start end (js-array) nil)) iterator))
  (defun managed-sorted-transform-iterator (factory mode)
    (let ((iterator (Object/create (Object/create (ensure-iterator-prototype))))
          (table (or iterator-states (setq iterator-states (new intrinsic-weak-map)))))
      (js-call table :set iterator (js-array t mode false false false
        factory nil nil nil nil nil nil)) iterator))
  (export managed-sorted-set-default-comparator managed-sorted-height managed-sorted-size managed-sorted-find managed-sorted-assoc
    managed-sorted-dissoc managed-sorted-iterator managed-sorted-transform-iterator managed-sorted-build))
