(module eliscript.managed-sorted-state
  (import "../runtime/core/value.mjs" equalValues)

  ;; Nodes and paths are immutable. Rotations rebuild only the affected spine.
  (defconst SortedNode (funcall
    (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
    (lambda (self key value &optional left right)
      (when (undefined? left) (setq left nil)) (when (undefined? right) (setq right nil))
      (put self :key key) (put self :value value) (put self :left left) (put self :right right)
      (put self :height (1+ (Math/max (managed-sorted-height left) (managed-sorted-height right))))
      (put self :size (+ (managed-sorted-size left) (managed-sorted-size right) 1))
      (Object/freeze self)) "SortedNode"))
  (Object/defineProperty SortedNode "length" (js-object :value 2 :configurable t))
  (defun managed-sorted-height (node) (if (nil? node) 0 (get node :height)))
  (defun managed-sorted-size (node) (if (nil? node) 0 (get node :size)))
  (defun managed-sorted-node (key value left right) (new SortedNode key value left right))
  (defun managed-sorted-rotate-left (root)
    (let* ((promoted (get root :right))
           (retained (managed-sorted-node (get root :key) (get root :value) (get root :left) (get promoted :left))))
      (managed-sorted-node (get promoted :key) (get promoted :value) retained (get promoted :right))))
  (defun managed-sorted-rotate-right (root)
    (let* ((promoted (get root :left))
           (retained (managed-sorted-node (get root :key) (get root :value) (get promoted :right) (get root :right))))
      (managed-sorted-node (get promoted :key) (get promoted :value) (get promoted :left) retained)))
  (defun managed-sorted-balance (root)
    (let ((delta (- (managed-sorted-height (get root :left)) (managed-sorted-height (get root :right)))))
      (cond
        ((> delta 1)
          (let* ((left (get root :left))
                 (prepared (if (< (managed-sorted-height (get left :left)) (managed-sorted-height (get left :right)))
                   (managed-sorted-node (get root :key) (get root :value) (managed-sorted-rotate-left left) (get root :right)) root)))
            (managed-sorted-rotate-right prepared)))
        ((< delta -1)
          (let* ((right (get root :right))
                 (prepared (if (< (managed-sorted-height (get right :right)) (managed-sorted-height (get right :left)))
                   (managed-sorted-node (get root :key) (get root :value) (get root :left) (managed-sorted-rotate-right right)) root)))
            (managed-sorted-rotate-left prepared)))
        (t root))))
  (defun managed-sorted-find (root key comparison)
    (let ((current root) (found nil) (done false))
      (while (and (not (nil? current)) (not done))
        (let ((order (funcall comparison key (get current :key))))
          (if (= order 0) (setq found current done t)
            (setq current (get current (if (< order 0) "left" "right")))))) found))
  (defun managed-sorted-assoc (root key value comparison)
    (if (nil? root)
      (js-object :root (managed-sorted-node key value nil nil) :added t :changed t)
      (let ((order (funcall comparison key (get root :key))))
        (if (= order 0)
          (if (equalValues (get root :value) value) (js-object :root root :added false :changed false)
            (js-object :root (managed-sorted-node (get root :key) value (get root :left) (get root :right)) :added false :changed t))
          (let* ((side (if (< order 0) "left" "right"))
                 (result (managed-sorted-assoc (get root side) key value comparison)))
            (if (not (get result :changed)) (js-object :root root :added (get result :added) :changed false)
              (let ((updated (if (= side "left")
                              (managed-sorted-node (get root :key) (get root :value) (get result :root) (get root :right))
                              (managed-sorted-node (get root :key) (get root :value) (get root :left) (get result :root)))))
                (js-object :root (managed-sorted-balance updated) :added (get result :added) :changed t))))))))
  (defun managed-sorted-minimum (root)
    (let ((current root))
      (while (not (nil? (get current :left))) (setq current (get current :left))) current))
  (defun managed-sorted-remove-minimum (root)
    (if (nil? (get root :left)) (get root :right)
      (managed-sorted-balance (managed-sorted-node (get root :key) (get root :value)
        (managed-sorted-remove-minimum (get root :left)) (get root :right)))))
  (defun managed-sorted-dissoc (root key comparison)
    (if (nil? root) (js-object :root root :removed false)
      (let ((order (funcall comparison key (get root :key))))
        (if (= order 0)
          (cond ((nil? (get root :left)) (js-object :root (get root :right) :removed t))
            ((nil? (get root :right)) (js-object :root (get root :left) :removed t))
            (t (let ((successor (managed-sorted-minimum (get root :right))))
              (js-object :root (managed-sorted-balance (managed-sorted-node
                (get successor :key) (get successor :value) (get root :left)
                (managed-sorted-remove-minimum (get root :right)))) :removed t))))
          (let* ((side (if (< order 0) "left" "right"))
                 (result (managed-sorted-dissoc (get root side) key comparison)))
            (if (not (get result :removed)) (js-object :root root :removed false)
              (let ((updated (if (= side "left")
                              (managed-sorted-node (get root :key) (get root :value) (get result :root) (get root :right))
                              (managed-sorted-node (get root :key) (get root :value) (get root :left) (get result :root)))))
                (js-object :root (managed-sorted-balance updated) :removed t))))))))

  ;; The bridge supplies an already ordered bulk payload. Rebuilding its shape
  ;; must not normalize or invoke the user's comparator a second time.
  (defun managed-sorted-build (values start end map-mode present)
    (if (>= start end) nil
      (let* ((middle (Math/floor (/ (+ start end) 2))) (entry (get values middle))
             (key (if map-mode (get entry 0) entry)) (value (if map-mode (get entry 1) present)))
        (managed-sorted-node key value
          (managed-sorted-build values start middle map-mode present)
          (managed-sorted-build values (1+ middle) end map-mode present)))))

  (defconst iterator-states (new globalThis/WeakMap))
  (defun iterator-state (receiver)
    (let ((state (js-call iterator-states :get receiver)))
      (when (undefined? state) (throw (new globalThis/TypeError "incompatible sorted iterator receiver"))) state))
  (defun iterator-not-running (state)
    (when (get state :busy) (throw (new globalThis/TypeError "Generator is already running"))))
  (defun iterator-clear (state)
    (put state :done t) (put state :root nil) (put state :comparison nil)
    (put state :resume nil) (put state :start nil) (put state :end nil) (put state :stack nil)
    (put state :factory nil) (put state :source nil) (put state :next nil))
  (defun push-start (state root start)
    (let ((current root) (stack (get state :stack)) (ascending (get state :ascending)))
      (while (not (nil? current))
        (if (nil? start)
          (progn (js-call stack :push current) (setq current (get current (if ascending "left" "right"))))
          (let* ((order (funcall (get state :comparison) (get current :key) (get start :key)))
                 (eligible (if ascending (or (> order 0) (and (get start :inclusive) (= order 0)))
                             (or (< order 0) (and (get start :inclusive) (= order 0))))))
            (if eligible
              (progn (js-call stack :push current) (setq current (get current (if ascending "left" "right"))))
              (setq current (get current (if ascending "right" "left")))))))))
  (defun iterator-next-avl (receiver &optional ignored)
    (let ((state (iterator-state receiver)))
      (iterator-not-running state)
      (if (get state :done) (js-object :value undefined :done t)
        (progn
          (put state :busy t)
          (try
            (unless (get state :started)
              (put state :started t) (push-start state (get state :root) (get state :start))
              (put state :root nil) (put state :start nil))
            ;; The right/left subtree is visited only on resume, after the
            ;; previous yield, preserving comparator effects between nexts.
            (unless (nil? (get state :resume))
              (let ((resume (get state :resume))) (put state :resume nil) (push-start state resume nil)))
            (let ((stack (get state :stack)))
              (if (= (js-length stack) 0)
                (progn (iterator-clear state) (js-object :value undefined :done t))
                (let* ((current (js-call stack :pop)) (end (get state :end)) (beyond false))
                  (unless (nil? end)
                    (let ((order (funcall (get state :comparison) (get current :key) (get end :key))))
                      (setq beyond (if (get state :ascending)
                        (or (> order 0) (and (not (get end :inclusive)) (= order 0)))
                        (or (< order 0) (and (not (get end :inclusive)) (= order 0)))))))
                  (if beyond (progn (iterator-clear state) (js-object :value undefined :done t))
                    (let* ((mode (get state :mode))
                           (value (cond ((= mode 0) current)
                             ((= mode 1) (Object/freeze (js-array (get current :key) (get current :value))))
                             ((= mode 3) (get current :value))
                             ((= mode 4) (Object/freeze (js-array (get current :key) (get current :key))))
                             (t (get current :key)))))
                      (put state :resume (get current (if (get state :ascending) "right" "left")))
                      (js-object :value value :done false))))))
            (catch error (iterator-clear state) (throw error))
            (finally (put state :busy false)))))))
  (defun source-object? (value)
    (or (and (not (nil? value)) (= (js* "typeof value") "object")) (= (js* "typeof value") "function")))
  (defun transform-start (state)
    (let* ((iterable (funcall (get state :factory)))
           (method (get iterable (get globalThis/Symbol :iterator)))
           (source (js-call method :call iterable)))
      (unless (source-object? source) (throw (new globalThis/TypeError "iterator must be an object")))
      (put state :source source) (put state :next (get source :next))
      (put state :factory nil) (put state :started t)))
  (defun transform-close (state)
    (let ((source (get state :source)))
      (unless (nil? source)
        (let ((close (get source :return)))
          (unless (nullish? close)
            (let ((result (js-call close :call source)))
              (unless (source-object? result) (throw (new globalThis/TypeError "iterator return must return an object")))))))))
  (defun iterator-next-transform (receiver)
    (let ((state (iterator-state receiver)) (body-active false))
      (iterator-not-running state)
      (if (get state :done) (js-object :value undefined :done t)
        (progn
          (put state :busy t)
          (try
            (unless (get state :started) (transform-start state))
            (let ((step (js-call (get state :next) :call (get state :source))))
              (unless (source-object? step) (throw (new globalThis/TypeError "iterator result must be an object")))
              (if (funcall globalThis/Boolean (get step :done))
                (progn (iterator-clear state) (js-object :value undefined :done t))
                (let ((item (get step :value)))
                  ;; IteratorStepValue abrupt completion does not close. Only
                  ;; an abrupt mapping/yield-body completion closes its input.
                  (setq body-active t)
                  (let ((mode (get state :mode)))
                    (js-object :value (if (= mode 2) (Object/freeze (js-array item item))
                                        (get item (if (= mode 0) 0 1))) :done false)))))
            (catch error
              (when body-active (try (transform-close state) (catch ignored nil)))
              (iterator-clear state) (throw error))
            (finally (put state :busy false)))))))
  (defun iterator-next (receiver &optional ignored)
    (if (get (iterator-state receiver) :transform false)
      (iterator-next-transform receiver) (iterator-next-avl receiver ignored)))
  (defun iterator-return (receiver &optional value)
    (let ((state (iterator-state receiver)))
      (iterator-not-running state) (put state :busy t)
      (try
        (when (and (get state :transform false) (get state :started) (not (get state :done)))
          (transform-close state))
        (js-object :value value :done t)
        (finally (iterator-clear state) (put state :busy false)))))
  (defun iterator-throw (receiver &optional value)
    (let ((state (iterator-state receiver)))
      (iterator-not-running state) (put state :busy t)
      (try
        (when (and (get state :transform false) (get state :started) (not (get state :done)))
          (try (transform-close state) (catch ignored nil)))
        (throw value)
        (finally (iterator-clear state) (put state :busy false)))))
  (defun iterator-self (receiver) receiver)
  (defun iterator-method (implementation name arity)
    (let ((method (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (Object/defineProperty method "length" (js-object :value arity :configurable t)) method))
  (defconst iterator-prototype (js-object))
  (Object/defineProperties iterator-prototype (js-object
    :next (js-object :value (iterator-method iterator-next "next" 1) :writable t :configurable t)
    :return (js-object :value (iterator-method iterator-return "return" 1) :writable t :configurable t)
    :throw (js-object :value (iterator-method iterator-throw "throw" 1) :writable t :configurable t)))
  (Object/defineProperty iterator-prototype (get globalThis/Symbol :iterator)
    (js-object :value (iterator-method iterator-self "[Symbol.iterator]" 0) :writable t :configurable t))
  (Object/defineProperty iterator-prototype (get globalThis/Symbol :toStringTag)
    (js-object :value "Generator" :configurable t))
  (defun managed-sorted-iterator (root comparison ascending start end mode)
    (let ((iterator (Object/create (Object/create iterator-prototype))))
      (js-call iterator-states :set iterator (js-object :root root :comparison comparison
        :ascending (funcall globalThis/Boolean ascending) :start start :end end :mode mode
        :stack (js-array) :resume nil :started false :done false :busy false)) iterator))
  (defun managed-sorted-transform-iterator (factory mode)
    (let ((iterator (Object/create (Object/create iterator-prototype))))
      (js-call iterator-states :set iterator (js-object :transform t :factory factory :mode mode
        :source nil :next nil :root nil :comparison nil :resume nil :start nil :end nil :stack nil
        :started false :done false :busy false)) iterator))
  (export managed-sorted-height managed-sorted-size managed-sorted-find managed-sorted-assoc
    managed-sorted-dissoc managed-sorted-iterator managed-sorted-transform-iterator managed-sorted-build))
