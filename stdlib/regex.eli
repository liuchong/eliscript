(module eliscript.regex
  (import "../runtime/core/regex.mjs" :as Runtime)
  (import "../runtime/core/vector.mjs" PersistentVector)
  (defconst regex-meta-pattern (new globalThis/RegExp "[.*+?^${}()|[\\]\\\\]" "g"))
  (defun regex (&rest arguments) (apply Runtime/compileRegex arguments))
  (defun regex? (value) (Runtime/isRegexPattern value))
  (defun re-pattern? (value) (Runtime/isRegexPattern value))
  (defun regex-source (pattern) (Runtime/regexSource pattern))
  (defun regex-flags (pattern) (Runtime/regexFlags pattern))
  (defun re-matches (pattern text) (Runtime/regexMatches pattern text))
  (defun re-find
    (pattern text &rest start)
    (apply Runtime/regexFind (js-cons pattern (js-cons text start))))
  (defun re-seq
    (pattern text &rest start)
    (apply Runtime/regexSequence (js-cons pattern (js-cons text start))))
  (defun re-replace
    (pattern replacement text)
    (Runtime/regexReplace pattern replacement text))
  (defun re-quote-replacement (replacement)
    (unless (= (value-type replacement) "string")
      (throw (new globalThis/TypeError "re-quote-replacement requires a string")))
    (js-call (js-call replacement :split "$") :join "$$"))
  (defun re-quote (text)
    (unless (= (value-type text) "string")
      (throw (new globalThis/TypeError "re-quote requires a string")))
    (js-call text :replace regex-meta-pattern "\\$&"))
  (defun re-split (pattern text &optional limit)
    (unless (Runtime/isRegexPattern pattern)
      (throw (new globalThis/TypeError "re-split requires a regex pattern")))
    (unless (= (value-type text) "string")
      (throw (new globalThis/TypeError "re-split requires a string")))
    (let ((effective-limit (if (nullish? limit) 0 limit)))
      (unless (Number/isSafeInteger effective-limit)
        (throw (new globalThis/TypeError "re-split limit must be a safe integer")))
      (if (= effective-limit 1)
        (js-call PersistentVector :from (js-array text))
        (let* ((flags (Runtime/regexFlags pattern))
               (gflags (if (js-call flags :includes "g") flags (str flags "g")))
               (re (new globalThis/RegExp (Runtime/regexSource pattern) gflags))
               (unicode (get re :unicode))
               (parts (js-array))
               (cursor 0)
               (done false))
          (while (not done)
            (if (and (> effective-limit 0) (>= (js-length parts) (1- effective-limit)))
              (setq done t)
              (let ((match (js-call re :exec text)))
                (if (nil? match)
                  (setq done t)
                  (let ((start (get match :index))
                        (len (js-length (aref match 0))))
                    (js-call parts :push (js-call text :slice cursor start))
                    (setq cursor (+ start len))
                    (when (= len 0)
                      (let ((step (if (and unicode (< (1+ start) (js-length text))
                                           (>= (js-call text :charCodeAt start) 55296)
                                           (<= (js-call text :charCodeAt start) 56319)
                                           (>= (js-call text :charCodeAt (1+ start)) 56320)
                                           (<= (js-call text :charCodeAt (1+ start)) 57343))
                                    2 1)))
                        (put re :lastIndex (+ start step))))
                    (when (> cursor (js-length text))
                      (setq done t)))))))
          (js-call parts :push (js-call text :slice cursor))
          (when (= effective-limit 0)
            (while (and (> (js-length parts) 1) (= (aref parts (1- (js-length parts))) ""))
              (js-call parts :pop)))
          (js-call PersistentVector :from parts)))))
  (export re-find re-matches re-pattern? re-quote re-quote-replacement re-replace re-seq re-split regex regex-flags regex-source regex?))
