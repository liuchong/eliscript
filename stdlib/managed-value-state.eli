(module eliscript.managed-value-state
  (import-portable "./bit.eli" rotate-left)

  (defvar protocol-hashes (new globalThis/WeakMap))
  (defvar host-object-hashes (new globalThis/WeakMap))
  (defvar host-symbol-hashes (new globalThis/Map))
  (defvar next-host-identity 1)
  (defconst metrics (js-object :hashValueCalls 0 :protocolHashComputations 0
    :protocolHashCacheHits 0 :hostIdentityAssignments 0))
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun object? (value)
    (and (not (nil? value)) (or (= (js* "typeof value") "object") (callable? value))))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun numberPrimitive (value)
    (if (not (object? value)) value
      (let ((exotic (aref value (get globalThis/Symbol :toPrimitive))))
        (if (not (nullish? exotic))
          (progn
            (unless (callable? exotic) (fail "Symbol.toPrimitive must be callable"))
            (let ((primitive (js-call exotic :call value "number")))
              (when (object? primitive) (fail "Cannot convert object to primitive value")) primitive))
          (let ((names (js-array "valueOf" "toString")) (index 0) (found false) (primitive undefined))
            (while (and (< index 2) (not found))
              (let ((method (get value (get names index))))
                (when (callable? method)
                  (setq primitive (js-call method :call value))
                  (unless (object? primitive) (setq found t))))
              (setq index (1+ index)))
            (unless found (fail "Cannot convert object to primitive value")) primitive)))))
  (defun toNumber (value)
    (let ((primitive (numberPrimitive value)))
      (when (= (js* "typeof primitive") "bigint") (fail "Cannot convert a BigInt value to a number"))
      (funcall globalThis/Number primitive)))
  (defun avalancheHash (value)
    (let ((hash (uint32 value)))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 16)))
      (setq hash (imul32 hash 2246822507))
      (setq hash (bit-xor hash (unsigned-bit-shift-right hash 13)))
      (setq hash (imul32 hash 3266489909))
      (uint32 (bit-xor hash (unsigned-bit-shift-right hash 16)))))
  (defun mixHash (hash value)
    (let ((mixed (imul32 (uint32 (bit-xor hash value)) 1540483477)))
      (uint32 (bit-xor mixed (unsigned-bit-shift-right mixed 15)))))
  (defun finishHash (hash count) (avalancheHash (mixHash hash (uint32 count))))
  (defun hashString (value &rest tags)
    (let* ((tag (if (or (= (js-length tags) 0) (undefined? (aref tags 0)))
                    1831565813 (aref tags 0)))
           (hash (mixHash tag (aref value "length"))) (index 0))
      (while (< index (aref value "length"))
        (setq hash (mixHash hash (js-call value :charCodeAt index)) index (1+ index)))
      (finishHash hash (aref value "length"))))
  (defun hashNumber (value)
    (if (funcall globalThis/Boolean (Number/isNaN value)) 1490037359
      (let* ((normalized (if (= value 0) 0 value))
             (words (number-float64-words (toNumber normalized))))
        (finishHash (mixHash (mixHash 374761393 (get words 0)) (get words 1)) 2))))
  (defun hashBigInt (value)
    (let* ((zero (funcall globalThis/BigInt "0")) (base (funcall globalThis/BigInt "4294967296"))
           (negative (< value zero)) (magnitude (if negative (- value) value))
           (hash (mixHash 2017827537 (if negative 1 0))) (limbs 0) (complete false))
      (while (not complete)
        (setq hash (mixHash hash (funcall globalThis/Number (% magnitude base)))
          magnitude (/ magnitude base) limbs (1+ limbs) complete (= magnitude zero)))
      (finishHash hash limbs)))
  (defun hashBoolean (value) (mixHash 1260232563 (if (funcall globalThis/Boolean value) 1911856395 423263297)))
  (defun hashNull () 1108378657)
  (defun hashUndefined () 2135587861)
  (defun hashGlobalSymbol (key) (hashString key 2657455275))
  (defun walkIterable (iterable visit)
    (let* ((iterator (js-call (aref iterable (get globalThis/Symbol :iterator)) :call iterable))
           (next nil) (complete false) (active false))
      (unless (object? iterator) (fail "iterator must be an object"))
      (setq next (aref iterator "next"))
      (try
        (while (not complete)
          (setq active false)
          (let ((step (js-call next :call iterator)))
            (unless (object? step) (fail "iterator result must be an object"))
            (if (funcall globalThis/Boolean (aref step "done")) (setq complete t)
              (let ((value (aref step "value")))
                (setq active t) (funcall visit value)))))
        (catch error
          (when (and active (not complete))
            (try
              (let ((close (get iterator :return)))
                (unless (nullish? close) (js-call close :call iterator)))
              (catch close-error nil)))
          (throw error)))))
  (defun orderedCollectionHash (iterable hashValue tag)
    (let ((hash (uint32 tag)) (count 0))
      (walkIterable iterable (lambda (value)
        (setq hash (mixHash hash (funcall hashValue value)) count (1+ count))))
      (finishHash hash count)))
  (defun unorderedCollectionHash (iterable hashElement tag)
    (let ((sum 0) (xor 0) (product 1) (count 0))
      (walkIterable iterable (lambda (value)
        (let ((hash (uint32 (funcall hashElement value))))
          (setq sum (uint32 (+ sum hash))
            xor (uint32 (bit-xor xor (rotate-left hash (bit-and hash 31))))
            product (uint32 (imul32 product (bit-or hash 1))) count (1+ count)))))
      (finishHash (mixHash (mixHash (mixHash tag sum) xor) product) count)))
  (defun cachedProtocolHash (value compute)
    (let ((cached (js-call protocol-hashes :get value)))
      (if (not (undefined? cached))
        (progn (put metrics :protocolHashCacheHits (1+ (get metrics :protocolHashCacheHits))) cached)
        (progn
          (put metrics :protocolHashComputations (1+ (get metrics :protocolHashComputations)))
          (let ((hash (uint32 (funcall compute))))
            (js-call protocol-hashes :set value hash) hash)))))
  (defun recordHashValueCall ()
    (put metrics :hashValueCalls (1+ (get metrics :hashValueCalls))) undefined)
  (defun hostIdentityHash (value)
    (let* ((hashes (if (= (js* "typeof value") "symbol") host-symbol-hashes host-object-hashes))
           (cached (js-call hashes :get value)))
      (if (not (undefined? cached)) cached
        (let ((hash (finishHash 762272397 next-host-identity)))
          (setq next-host-identity (1+ next-host-identity))
          (put metrics :hostIdentityAssignments (1+ (get metrics :hostIdentityAssignments)))
          (js-call hashes :set value hash) hash))))
  (defun resetValueMetrics ()
    (put metrics :hashValueCalls 0)
    (put metrics :protocolHashComputations 0)
    (put metrics :protocolHashCacheHits 0)
    (put metrics :hostIdentityAssignments 0)
    undefined)
  (defun clearValueCaches ()
    (setq protocol-hashes (new globalThis/WeakMap)
      host-object-hashes (new globalThis/WeakMap)
      host-symbol-hashes (new globalThis/Map)
      next-host-identity 1)
    (resetValueMetrics))
  (defun readValueMetrics ()
    (Object/freeze (js-object :hashValueCalls (get metrics :hashValueCalls)
      :protocolHashComputations (get metrics :protocolHashComputations)
      :protocolHashCacheHits (get metrics :protocolHashCacheHits)
      :hostIdentityAssignments (get metrics :hostIdentityAssignments))))
  (defun hashPrimitiveValue (value)
    (let ((type (js* "typeof value")))
      (cond ((nil? value) (hashNull))
        ((= type "undefined") (hashUndefined))
        ((= type "boolean") (hashBoolean value))
        ((= type "number") (hashNumber value))
        ((= type "bigint") (hashBigInt value))
        ((= type "string") (hashString value))
        ((= type "symbol")
          (let ((key (js-call globalThis/Symbol :keyFor value)))
            (if (undefined? key) (hostIdentityHash value) (hashGlobalSymbol key))))
        ((or (= type "object") (= type "function")) (hostIdentityHash value))
        (t (fail (str "cannot hash JavaScript value of type " type))))))
  (Object/defineProperty hashString "length" (js-object :value 1 :configurable t))
  (export avalancheHash mixHash finishHash hashString hashNumber hashBigInt hashBoolean hashNull hashUndefined hashGlobalSymbol
    orderedCollectionHash unorderedCollectionHash cachedProtocolHash recordHashValueCall hostIdentityHash
    resetValueMetrics clearValueCaches readValueMetrics hashPrimitiveValue))
