(module eliscript.managed-vector-view-state
  (import-portable "./persistent-vector.eli"
    empty-persistent-vector persistent-vector? persistent-vector-count
    persistent-vector-nth persistent-vector-assoc persistent-vector-conj
    persistent-vector-with-meta)

  ;; Private range storage. Frozen public SubVector objects and their brands
  ;; are created by the literal adapter, never by accepting these record keys.
  (defportable managed-vector-view-state? (value)
    (and (not (nullish? value)) (= (get value :kind nil) "managed-vector-view")))

  (defportable managed-vector-view-state-make (vector start end metadata)
    (js-object :kind "managed-vector-view" :vector vector :start start :end end :metadata metadata))

  (defportable managed-vector-view-state-vector (view) (get view :vector))
  (defportable managed-vector-view-state-start (view) (get view :start))
  (defportable managed-vector-view-state-end (view) (get view :end))
  (defportable managed-vector-view-state-count (view) (- (get view :end) (get view :start)))
  (defportable managed-vector-view-state-meta (view) (get view :metadata))

  (defportable managed-vector-view-state-valid-index? (index count inclusive)
    (and (= (value-type index) "number")
         (>= index -9007199254740991) (<= index 9007199254740991)
         (= (% index 1) 0) (>= index 0)
         (if inclusive (<= index count) (< index count))))

  (defportable managed-vector-view-state-subvec (vector start end)
    (let* ((view? (managed-vector-view-state? vector))
           (valid? (or view? (persistent-vector? vector)))
           (count (if view? (managed-vector-view-state-count vector)
                    (if valid? (persistent-vector-count vector) 0)))
           (limit (if (nullish? end) count end)))
      (if (or (not valid?)
              (not (managed-vector-view-state-valid-index? start count t))
              (not (managed-vector-view-state-valid-index? limit count t)) (< limit start))
          nil
        ;; subvec creates a new unannotated view, including when its source is
        ;; itself annotated. Nested views share the original underlying trie.
        (if view?
            (managed-vector-view-state-make (get vector :vector)
              (+ (get vector :start) start) (+ (get vector :start) limit) nil)
          (managed-vector-view-state-make vector start limit nil)))))

  (defportable managed-vector-view-state-with-meta (view metadata)
    (if (eq metadata (get view :metadata)) view
      (managed-vector-view-state-make (get view :vector) (get view :start) (get view :end) metadata)))

  (defportable managed-vector-view-state-nth (view index not-found)
    (if (managed-vector-view-state-valid-index? index (managed-vector-view-state-count view) false)
        (persistent-vector-nth (get view :vector) (+ (get view :start) index) not-found)
      not-found))

  (defportable managed-vector-view-state-assoc (view index value)
    (let ((count (managed-vector-view-state-count view)))
      (if (not (managed-vector-view-state-valid-index? index count t)) nil
        (let* ((vector (get view :vector)) (absolute (+ (get view :start) index))
               (next (if (= absolute (persistent-vector-count vector))
                         (persistent-vector-conj vector value)
                       (persistent-vector-assoc vector absolute value))))
          (if (nil? next) nil
            (managed-vector-view-state-make next (get view :start)
              (if (> (1+ absolute) (get view :end)) (1+ absolute) (get view :end))
              (get view :metadata)))))))

  (defportable managed-vector-view-state-conj (view value)
    (managed-vector-view-state-assoc view (managed-vector-view-state-count view) value))

  (defportable managed-vector-view-state-peek (view not-found)
    (if (= (get view :start) (get view :end)) not-found
      (persistent-vector-nth (get view :vector) (1- (get view :end)) not-found)))

  (defportable managed-vector-view-state-empty (view)
    (persistent-vector-with-meta (empty-persistent-vector) (get view :metadata)))

  (defportable managed-vector-view-state-pop (view)
    (let ((count (managed-vector-view-state-count view)))
      (if (= count 0) nil
        (if (= count 1) (managed-vector-view-state-empty view)
          (managed-vector-view-state-make (get view :vector) (get view :start)
            (1- (get view :end)) (get view :metadata))))))

  (defportable managed-vector-view-state-array-reverse (values)
    (let ((result (js-array)) (index 0))
      (while (< index (js-length values))
        (setq result (js-cons (get values index) result) index (1+ index)))
      result))

  (defportable managed-vector-view-state-to-array (view)
    (let ((values (js-array)) (index (get view :start))
          (end (get view :end)) (vector (get view :vector)))
      (while (< index end)
        (setq values (js-cons (persistent-vector-nth vector index nil) values)
              index (1+ index)))
      (managed-vector-view-state-array-reverse values)))

  (export managed-vector-view-state? managed-vector-view-state-make
    managed-vector-view-state-vector managed-vector-view-state-start managed-vector-view-state-end
    managed-vector-view-state-count managed-vector-view-state-meta managed-vector-view-state-subvec
    managed-vector-view-state-valid-index? managed-vector-view-state-with-meta
    managed-vector-view-state-nth managed-vector-view-state-assoc managed-vector-view-state-conj
    managed-vector-view-state-peek managed-vector-view-state-empty managed-vector-view-state-pop
    managed-vector-view-state-to-array))
