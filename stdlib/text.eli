(module eliscript.text
  (defportable empty? (text)
    (= (js-length text) 0))

  (defportable slice (start end text)
    (let ((result "")
          (index (if (< start 0) 0 start))
          (limit (if (> end (js-length text)) (js-length text) end)))
      (while (< index limit)
        (setq result (str result (js-nth index text))
              index (1+ index)))
      result))

  (defportable starts-at? (prefix offset text)
    (let ((matched
           (and (>= offset 0)
                (<= (+ offset (js-length prefix)) (js-length text))))
          (index 0))
      (while (and matched (< index (js-length prefix)))
        (unless (= (js-nth index prefix) (js-nth (+ offset index) text))
          (setq matched false))
        (setq index (1+ index)))
      matched))

  (defportable starts-with? (prefix text)
    (starts-at? prefix 0 text))

  (defportable ends-with? (suffix text)
    (starts-at? suffix (- (js-length text) (js-length suffix)) text))

  (defportable contains? (needle text)
    (let ((found false)
          (offset 0)
          (last-offset (- (js-length text) (js-length needle))))
      (while (and (not found) (<= offset last-offset))
        (when (starts-at? needle offset text)
          (setq found t))
        (setq offset (1+ offset)))
      found))

  (defportable strip-prefix (prefix text)
    (if (starts-with? prefix text)
        (slice (js-length prefix) (js-length text) text)
      text))

  (defportable strip-suffix (suffix text)
    (if (ends-with? suffix text)
        (slice 0 (- (js-length text) (js-length suffix)) text)
      text))

  (defportable whitespace? (character)
    (or (= character " ")
        (= character "\t")
        (= character "\n")
        (= character "\r")))

  (defportable trim (text)
    (let ((start 0)
          (end (1- (js-length text))))
      (while (and (<= start end) (whitespace? (js-nth start text)))
        (setq start (1+ start)))
      (while (and (>= end start) (whitespace? (js-nth end text)))
        (setq end (1- end)))
      (slice start (1+ end) text)))

  (defportable blank? (text)
    (empty? (trim text)))

  (defportable join (separator values)
    (let ((result "")
          (index 0))
      (while (< index (js-length values))
        (when (> index 0)
          (setq result (str result separator)))
        (setq result (str result (js-nth index values))
              index (1+ index)))
      result))

  (defportable repeat (count text)
    (let ((result "")
          (index 0))
      (while (< index count)
        (setq result (str result text)
              index (1+ index)))
      result))

  (export empty? slice starts-at? starts-with? ends-with? contains?
          strip-prefix strip-suffix whitespace? trim blank? join repeat))
