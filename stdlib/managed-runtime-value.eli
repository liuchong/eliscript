(module eliscript.managed-runtime-value
  (import "../../stdlib/core/protocol.eli" extend-protocol-type)
  (import "../../stdlib/managed-literal-protocols.eli"
    I_EQUIV I_HASH managed-literal-equal-values managed-literal-hash-value)
  (import "../../stdlib/managed-literals.eli" literal-protocols)
  (defconst IEquiv I_EQUIV)
  (defconst IHash I_HASH)
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun extendValueType (constructor implementations)
    (unless (and (not (nil? implementations)) (= (js* "typeof implementations") "object")
                 (callable? (aref implementations "equal"))
                 (callable? (aref implementations "hash")))
      (throw (new globalThis/TypeError "value type extension requires equal and hash functions")))
    (extend-protocol-type IEquiv constructor (js-object :equal (aref implementations "equal")))
    (extend-protocol-type IHash constructor (js-object :hash (aref implementations "hash")))
    constructor)
  (defun equalValues (left right) (literal-protocols) (managed-literal-equal-values left right))
  (defun hashValue (value) (literal-protocols) (managed-literal-hash-value value))
  (export IEquiv IHash extendValueType equalValues hashValue))
