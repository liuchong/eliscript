(module eliscript.persistent-list
  (defconst persistent-list-kind "eliscript/persistent-list")
  (defconst persistent-list-max-count 2147483647)

  (defportable make-empty-persistent-list (metadata)
    (js-object :kind persistent-list-kind
            :count 0
            :empty t
            :value nil
            :rest nil
            :metadata metadata))

  (defportable make-persistent-list-node (value rest metadata)
    (js-object :kind persistent-list-kind
            :count (1+ (get rest "count" 0))
            :empty false
            :value value
            :rest rest
            :metadata metadata))

  (defportable persistent-list? (value)
    (and (not (nullish? value))
         (object-has? value "kind")
         (= (get value "kind" nil) persistent-list-kind)))

  (defportable empty-persistent-list ()
    (make-empty-persistent-list nil))

  (defportable persistent-list-empty? (list)
    (= (get list "count" 0) 0))

  (defportable persistent-list-count (list)
    (get list "count" 0))

  (defportable persistent-list-cons (list value)
    (if (>= (persistent-list-count list) persistent-list-max-count)
        nil
      (make-persistent-list-node
       value list (get list "metadata" nil))))

  (defportable persistent-list-conj (list value)
    (persistent-list-cons list value))

  (defportable persistent-list-first (list not-found)
    (if (persistent-list-empty? list)
        not-found
      (get list "value")))

  (defportable persistent-list-rest (list not-found)
    (if (persistent-list-empty? list)
        not-found
      (get list "rest" nil)))

  (defportable persistent-list-peek (list not-found)
    (persistent-list-first list not-found))

  (defportable persistent-list-pop (list)
    (if (persistent-list-empty? list)
        nil
      (get list "rest" nil)))

  (defportable persistent-list-meta (list)
    (get list "metadata" nil))

  (defportable persistent-list-with-meta (list metadata)
    (if (= metadata (persistent-list-meta list))
        list
      (if (persistent-list-empty? list)
          (make-empty-persistent-list metadata)
        (make-persistent-list-node
         (get list "value")
         (get list "rest" nil)
         metadata))))

  (defportable persistent-list-valid-index? (index count)
    (and (= index (int32 index))
         (>= index 0)
         (< index count)))

  (defportable persistent-list-nth (list index not-found)
    (if (not (persistent-list-valid-index?
              index
              (persistent-list-count list)))
        not-found
      (let ((current list)
            (current-index 0))
        (while (< current-index index)
          (setq current (get current "rest" nil)
                current-index (1+ current-index)))
        (get current "value"))))

  (defportable persistent-list-reduce (function initial list)
    (let ((result initial)
          (current list))
      (while (not (persistent-list-empty? current))
        (setq result (funcall function result (get current "value"))
              current (get current "rest" nil)))
      result))

  (defportable persistent-list-reverse (list)
    (persistent-list-reduce
     (lambda (result value) (persistent-list-cons result value))
     (make-empty-persistent-list (persistent-list-meta list))
     list))

  (defportable persistent-list-array-reverse (values)
    (let ((result (js-array))
          (index 0))
      (while (< index (js-length values))
        (setq result (js-cons (get values index) result)
              index (1+ index)))
      result))

  (defportable persistent-list-to-array (list)
    (persistent-list-array-reverse
     (persistent-list-reduce
      (lambda (result value) (js-cons value result))
      (js-array)
      list)))

  (defportable persistent-list-from-array (values)
    (let ((result (empty-persistent-list))
          (index (1- (js-length values))))
      (while (>= index 0)
        (setq result (persistent-list-cons result (get values index))
              index (1- index)))
      result))

  (export empty-persistent-list
          persistent-list?
          persistent-list-empty?
          persistent-list-count
          persistent-list-cons
          persistent-list-conj
          persistent-list-first
          persistent-list-rest
          persistent-list-peek
          persistent-list-pop
          persistent-list-meta
          persistent-list-with-meta
          persistent-list-nth
          persistent-list-reduce
          persistent-list-reverse
          persistent-list-to-array
          persistent-list-from-array))
