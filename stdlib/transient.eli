(module eliscript.transient
  (import "../runtime/core/transient.mjs" :as Runtime)

  (defconst IEditable Runtime/IEditable)
  (defconst ITransientCollection Runtime/ITransientCollection)
  (defconst ITransientSet Runtime/ITransientSet)

  (defun transient (collection)
    (Runtime/transient collection))

  (defun conj! (collection &rest values)
    (apply Runtime/conjBang (js-cons collection values)))

  (defun assoc! (collection key value &rest key-values)
    (apply Runtime/assocBang
           (js-cons collection (js-cons key (js-cons value key-values)))))

  (defun dissoc! (collection &rest keys)
    (apply Runtime/dissocBang (js-cons collection keys)))

  (defun disj! (collection &rest values)
    (apply Runtime/disjBang (js-cons collection values)))

  (defun persistent! (collection)
    (Runtime/persistentBang collection))

  (export IEditable ITransientCollection ITransientSet assoc! conj! disj! dissoc! persistent!
          transient))
