  (extend-protocol-type ISeqable globalThis/Map (js-object :seq mapSequence))
  (extend-protocol-type IReduce globalThis/Map (js-object :reduce (lambda (values reducer &rest initial)
    (managed-literal-reduce-iterable (or (mapSequence values) (js-array)) reducer initial))))
  (extend-protocol-type IKVReduce globalThis/Map (js-object :reduceKV reduceMapValues))
  (extend-protocol-type IMap globalThis/Map (js-object :dissoc mapDissoc))
  (extend-protocol-type ICounted globalThis/Set (js-object :count (lambda (values) (aref values "size"))))
  (extend-protocol-type IEmptyable globalThis/Set (js-object :empty (lambda (&rest ignored) (new globalThis/Set))))
  (extend-protocol-type IConj globalThis/Set (js-object :conj setConj))
  (extend-protocol-type ILookup globalThis/Set (js-object :get (lambda (values key &optional not-found)
    (if (truth (js-call values :has key)) key (if (undefined? not-found) nil not-found)))))
  (extend-protocol-type IAssociative globalThis/Set (js-object :contains (lambda (values key) (js-call values :has key))))
  (extend-protocol-type ISeqable globalThis/Set (js-object :seq setSequence))
  (extend-protocol-type IReduce globalThis/Set (js-object :reduce (lambda (values reducer &rest initial)
