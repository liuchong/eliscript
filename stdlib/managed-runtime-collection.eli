(module eliscript.managed-runtime-collection
  (import "../../stdlib/core/protocol.eli"
    extend-protocol-category extend-protocol-type implements-protocol? protocol-method protocol-slot
    register-protocol-extension-loader)
  (import "../../stdlib/managed-literal-protocols.eli"
    managed-literal-protocol managed-literal-protocol-role
    managed-literal-is-reduced managed-literal-reduced managed-literal-unreduced
    managed-literal-reduce-iterable managed-literal-sequence-view managed-literal-unbounded-sequence-view
    managed-literal-install-slot managed-literal-checked-count SequenceView
    MemoizedSequenceView memoizedSequenceView memoizedSequenceStatus
    managed-literal-read-sequence-state managed-literal-shift-sequence-count managed-literal-sequence-from-count
    managed-literal-self-iterable managed-literal-string-sequence managed-literal-object-sequence
    managed-literal-mapped-iterator managed-literal-map-sequence managed-literal-reduce
    PERSISTENT_MAP_KIND PERSISTENT_MAP_HAS_VALUE_KEY PERSISTENT_SET_KIND PERSISTENT_SET_HAS_VALUE)
  (import "../../stdlib/managed-literals.eli"
    PersistentList PersistentVector PersistentQueue literal-instance? literal-set)
  (import "./record.mjs" isRecord)

  (defconst ICounted (managed-literal-protocol "collection.ICounted"))
  (defconst IEmptyable (managed-literal-protocol "collection.IEmptyable"))
  (defconst IConj (managed-literal-protocol "collection.IConj"))
  (defconst ILookup (managed-literal-protocol "collection.ILookup"))
  (defconst IAssociative (managed-literal-protocol "collection.IAssociative"))
  (defconst IIndexed (managed-literal-protocol "collection.IIndexed"))
  (defconst ISeqable (managed-literal-protocol "collection.ISeqable"))
  (defconst IReduce (managed-literal-protocol "collection.IReduce"))
  (defconst IKVReduce (managed-literal-protocol "collection.IKVReduce"))
  (defconst IMap (managed-literal-protocol "collection.IMap"))
  (defconst ISet (managed-literal-protocol "collection.ISet"))
  (defconst IStack (managed-literal-protocol "collection.IStack"))
  (defconst IReversible (managed-literal-protocol "collection.IReversible"))
  (defconst COLLECTION_COUNT (protocol-slot ICounted "count"))
  (defconst COLLECTION_EMPTY (protocol-slot IEmptyable "empty"))
  (defconst COLLECTION_CONJ (protocol-slot IConj "conj"))
  (defconst COLLECTION_GET (protocol-slot ILookup "get"))
  (defconst COLLECTION_ASSOC (protocol-slot IAssociative "assoc"))
  (defconst COLLECTION_CONTAINS (protocol-slot IAssociative "contains"))
  (defconst COLLECTION_NTH (protocol-slot IIndexed "nth"))
  (defconst COLLECTION_SEQ (protocol-slot ISeqable "seq"))
  (defconst COLLECTION_REDUCE (protocol-slot IReduce "reduce"))
  (defconst COLLECTION_REDUCE_KV (protocol-slot IKVReduce "reduceKV"))
  (defconst COLLECTION_DISSOC (protocol-slot IMap "dissoc"))
  (defconst COLLECTION_DISJ (protocol-slot ISet "disj"))
  (defconst COLLECTION_PEEK (protocol-slot IStack "peek"))
  (defconst COLLECTION_POP (protocol-slot IStack "pop"))
  (defconst COLLECTION_RSEQ (protocol-slot IReversible "rseq"))
  (defvar MISSING nil)
  (defvar reduction-state nil)
  (defvar reduction-token nil)
  (defun ensure-missing ()
    (or MISSING (setq MISSING (funcall globalThis/Symbol "eliscript.collection.missing"))))
  (defun ensure-reduction-state ()
    (or reduction-state (setq reduction-state (funcall globalThis/Symbol "eliscript.collection.reduction-state"))))
  (defun ensure-reduction-token ()
    (or reduction-token (setq reduction-token (funcall globalThis/Symbol "eliscript.collection.reduction-token"))))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun boolean? (value) (= (js* "typeof value") "boolean"))
  (defun object? (value) (and (not (nil? value)) (= (js* "typeof value") "object")))
  (defun instance? (value constructor)
    (unless (or (= (js* "typeof constructor") "function")
                (and (not (nil? constructor)) (= (js* "typeof constructor") "object")))
      (fail "Right-hand side of instanceof is not an object"))
    (let ((method (get constructor (get globalThis/Symbol :hasInstance))))
      (when (nullish? method)
        (unless (= (js* "typeof constructor") "function")
          (fail "Right-hand side of instanceof is not callable"))
        (setq method (get (get globalThis/Function :prototype) (get globalThis/Symbol :hasInstance))))
      (let ((res (Reflect/apply method constructor (js-array value))))
        (js* "!!res"))))
  (defun truth (value) (js* "!!value"))
  (defun selfIterable (iterator enumerable)
    (managed-literal-self-iterable iterator enumerable))
  (defun invoke (protocol operation &rest arguments) (apply (protocol-method protocol operation) arguments))
  (defun iteratorFromFactory (factory)
    (let ((iterator (funcall factory)))
      (unless (and (object? iterator) (callable? (aref iterator "next")))
        (fail "sequence view factory must return an iterator")) iterator))
  (defun isPersistentMapValue (value)
    (and (not (nullish? value)) (eq (aref value PERSISTENT_MAP_KIND) t)
         (callable? (aref value PERSISTENT_MAP_HAS_VALUE_KEY))))
  (defun isPersistentSetValue (value)
    (and (not (nullish? value)) (eq (aref value PERSISTENT_SET_KIND) t)
         (callable? (aref value PERSISTENT_SET_HAS_VALUE))))

  (defvar reduction-prototype-ready false)
  (defun ensure-reduction-prototype ()
    (unless reduction-prototype-ready
      (managed-literal-install-slot (aref ReductionView "prototype") COLLECTION_REDUCE reductionReduce 1)
      (Object/defineProperty (aref ReductionView "prototype") (aref globalThis/Symbol "toStringTag")
        (js-object :get (lambda () "EliscriptReductionView") :configurable t))
      (setq reduction-prototype-ready t)))
  (defun ReductionView (token reduce-function)
    (unless (and (not (nil? reduction-token)) (eq token reduction-token) (callable? reduce-function))
      (fail "ReductionView values must be created by reductionView"))
    (ensure-reduction-prototype)
    (Object/defineProperty (js* "this") (ensure-reduction-state)
      (js-object :value reduce-function :enumerable t :writable t :configurable t))
    (Object/freeze (js* "this")))
  (defun reductionView (reduce-function)
    (unless (callable? reduce-function) (fail "reduction view function must be a function"))
    (new ReductionView (ensure-reduction-token) reduce-function))
  (defun sequenceView (factory &optional count)
    (managed-literal-sequence-view factory (if (undefined? count) nil count)))
  (defun unboundedSequenceView (factory) (managed-literal-unbounded-sequence-view factory))
  (defun sequenceState (sequence)
    (managed-literal-read-sequence-state sequence))
  (defun sliceSequenceView (sequence offset)
    (if (nil? sequence) nil
      (progn
        (unless (isSequenceView sequence) (fail "sequence slice expects a SequenceView or nil"))
        (managed-literal-checked-count offset)
        (if (= offset 0) sequence
          (let* ((state (sequenceState sequence))
                 (factory (lambda ()
                   (let ((iterator (js-call (aref sequence (aref globalThis/Symbol "iterator")) :call sequence))
                         (remaining offset) (done false))
                     (while (and (> remaining 0) (not done))
                       (if (truth (aref (js-call iterator :next) "done")) (setq done t)
                         (setq remaining (1- remaining)))) iterator)))
                 (count (managed-literal-shift-sequence-count state offset false)))
            (managed-literal-sequence-from-count factory count))))))
  (defun prependIterator (value sequence)
    (let ((stage 0) (running false) (delegate nil) (next nil) (iterator nil) (action nil))
      (setq action (lambda (operation sent)
        (when running (fail "Generator is already running"))
        (setq running t)
        (try
          (cond
            ((= stage 3)
              (if (= operation 2) (throw sent) (js-object :value (if (= operation 1) sent undefined) :done t)))
            ((and (< stage 2) (/= operation 0))
              (setq stage 3)
              (if (= operation 2) (throw sent) (js-object :value sent :done t)))
            ((= stage 0) (setq stage 1) (js-object :value value :done false))
            (t
              (let ((beginning (= stage 1)))
                (when beginning
                  (setq stage 2)
                  (unless (nil? sequence)
                    (setq delegate (js-call (aref sequence (aref globalThis/Symbol "iterator")) :call sequence))
                    (unless (or (object? delegate) (callable? delegate)) (fail "iterator must be an object"))
                    (setq next (aref delegate "next"))))
                (if (nil? delegate) (progn (setq stage 3) (js-object :value undefined :done t))
                  (let ((method (if (= operation 0) next (aref delegate (if (= operation 1) "return" "throw")))))
                    (cond
                      ((and (= operation 1) (nullish? method))
                        (setq stage 3) (js-object :value sent :done t))
                      ((and (= operation 2) (nullish? method))
                        (let ((close (aref delegate "return")))
                          (unless (nullish? close)
                            (let ((result (js-call close :call delegate)))
                              (unless (or (object? result) (callable? result)) (fail "iterator return must return an object")))))
                        (fail "The iterator does not provide a throw method"))
                      (t
                        (let ((result (js-call method :call delegate (if beginning undefined sent))))
                          (unless (or (object? result) (callable? result)) (fail "iterator result must be an object"))
                          (if (truth (aref result "done"))
                            (let ((returned (aref result "value")))
                              (setq stage 3) (js-object :value (if (= operation 1) returned undefined) :done t)) result)))))))))
          (catch error (setq stage 3) (throw error))
          (finally (setq running false)))))
      (setq iterator (js-object
        :next (lambda (&optional sent) (funcall action 0 sent))
        :return (lambda (&optional sent) (funcall action 1 sent))
        :throw (lambda (&optional sent) (funcall action 2 sent))))
      (selfIterable iterator false)))
  (defun prependSequenceView (value sequence)
    (unless (or (nil? sequence) (isSequenceView sequence)) (fail "sequence prepend expects a SequenceView or nil"))
    (let ((factory (lambda () (prependIterator value sequence))))
      (if (nil? sequence) (sequenceView factory 1)
        (managed-literal-sequence-from-count factory (managed-literal-shift-sequence-count (sequenceState sequence) 0 t)))))
  (defun reductionReduce (receiver reducer &rest initial)
    (let ((method (aref receiver (ensure-reduction-state))))
      (js-call method :apply receiver (js-cons reducer initial))))

  (defun indexedValue (values index &rest fallbacks)
    (let* ((missing (ensure-missing))
           (not-found (if (or (= (js-length fallbacks) 0) (undefined? (aref fallbacks 0)))
                        missing (aref fallbacks 0))))
      (cond ((and (Number/isInteger index) (>= index 0) (< index (js-length values))) (aref values index))
        ((not (eq not-found missing)) not-found)
        (t (throw (new globalThis/RangeError (str "nth index " index " is outside collection bounds")))))))
  (defun indexedAssoc (values index value)
    (unless (and (Number/isInteger index) (>= index 0) (<= index (js-length values)))
      (throw (new globalThis/RangeError (str "assoc index " index " is outside collection bounds"))))
    (let ((result (js-call values :slice))) (put result index value) result))
  (defun indexedContains (values index) (and (Number/isInteger index) (>= index 0) (< index (js-length values))))
  (defun readEntry (entry)
    (unless (and (not (nullish? entry)) (callable? (aref entry (aref globalThis/Symbol "iterator"))))
      (fail "persistent hash map entries must be iterable key/value pairs"))
    (let ((iterator (iteratorFromFactory (lambda () (js-call (aref entry (aref globalThis/Symbol "iterator")) :call entry))))
          (complete false))
      (try
        (let* ((first (js-call iterator :next)))
          (when (truth (aref first "done")) (fail "persistent hash map entries must contain exactly two values"))
          (let ((second (js-call iterator :next)))
            (when (truth (aref second "done")) (fail "persistent hash map entries must contain exactly two values"))
            (let ((third (js-call iterator :next)))
              (unless (truth (aref third "done")) (fail "persistent hash map entries must contain exactly two values")))
            (setq complete t) (js-array (aref first "value") (aref second "value"))))
        (finally (when (and (not complete) (callable? (aref iterator "return"))) (js-call iterator :return))))))
  (defun cloneObject (source)
    (let ((result (js-object)) (keys (Reflect/ownKeys source)) (index 0))
      (while (< index (js-length keys))
        (let* ((key (aref keys index)) (descriptor (Object/getOwnPropertyDescriptor source key)))
          (when (and (not (undefined? descriptor)) (aref descriptor "enumerable"))
            (Object/defineProperty result key (js-object :value (aref source key) :writable t :enumerable t :configurable t))))
        (setq index (1+ index))) result))
  (defun objectAssoc (values key value)
    (unless (= (js* "typeof key") "string") (fail "plain object association keys must be strings"))
    (let ((result (cloneObject values)))
      (Object/defineProperty result key (js-object :value value :writable t :enumerable t :configurable t)) result))
  (defun objectConj (values entry) (let ((pair (readEntry entry))) (objectAssoc values (aref pair 0) (aref pair 1))))
  (defun objectDissoc (values key)
    (unless (= (js* "typeof key") "string") (fail "plain object dissociation keys must be strings"))
    (let ((result (cloneObject values))) (Reflect/deleteProperty result key) result))
  (defun mapConj (values entry)
    (let* ((pair (readEntry entry)) (result (new globalThis/Map values)))
      (js-call result :set (aref pair 0) (aref pair 1)) result))
  (defun mapAssoc (values key value) (let ((result (new globalThis/Map values))) (js-call result :set key value) result))
  (defun mapDissoc (values key) (let ((result (new globalThis/Map values))) (js-call result :delete key) result))
  (defun setConj (values value) (let ((result (new globalThis/Set values))) (js-call result :add value) result))
  (defun setDisj (values value) (let ((result (new globalThis/Set values))) (js-call result :delete value) result))
  (defun arrayConj (values value)
    (let ((result (managed-literal-reduce-iterable values
            (lambda (result item)
              (Object/defineProperty result (js-length result)
                (js-object :value item :writable t :enumerable t :configurable t)) result)
            (js-array (js-array)))))
      (Object/defineProperty result (js-length result) (js-object :value value :writable t :enumerable t :configurable t)) result))
  (defun arrayPeek (values) (if (= (js-length values) 0) nil (aref values (1- (js-length values)))))
  (defun arrayPop (values)
    (when (= (js-length values) 0) (throw (new globalThis/RangeError "cannot pop an empty array")))
    (js-call values :slice 0 -1))
  (defun indexedReverseSequence (values)
    (if (= (js-length values) 0) nil
      (sequenceView (lambda ()
        (let ((index (js-length values)))
          (js-object :next (lambda ()
            (if (= index 0) (js-object :value undefined :done t)
              (progn (setq index (1- index)) (js-object :value (aref values index) :done false)))))))
        (lambda () (js-length values)))))
  (defun arraySequence (values)
    (if (= (js-length values) 0) nil
      (sequenceView (lambda () (js-call (aref values (aref globalThis/Symbol "iterator")) :call values)) (lambda () (js-length values)))))
  (defun stringSequence (value) (managed-literal-string-sequence value))
  (defun objectSequence (value) (managed-literal-object-sequence value))
  (defun mappedIterator (factory transform) (managed-literal-mapped-iterator factory transform))
  (defun mapSequence (values) (managed-literal-map-sequence values))
  (defun setSequence (values)
    (if (= (aref values "size") 0) nil
      (sequenceView (lambda () (js-call (aref values (aref globalThis/Symbol "iterator")) :call values)) (lambda () (aref values "size")))))
  (defun reduceIndexedValues (values reducer initial)
    (let ((result initial) (index 0) (done false))
      (while (and (< index (js-length values)) (not done))
        (setq result (funcall reducer result index (aref values index)))
        (when (managed-literal-is-reduced result)
          (setq result (managed-literal-unreduced result) done t))
        (setq index (1+ index)))
      result))
  (defun reduceObjectValues (value reducer initial)
    (let ((keys (Object/keys value)) (index 0) (result initial) (done false))
      (while (and (< index (js-length keys)) (not done))
        (let ((key (aref keys index)))
          (setq result (funcall reducer result key (aref value key))))
        (setq index (1+ index))
        (when (managed-literal-is-reduced result)
          (setq result (managed-literal-unreduced result) done t)))
      result))
  (defun reduceMapValues (values reducer initial)
    (managed-literal-reduce-iterable values
      (lambda (result entry)
        (let* ((iterator (js-call (aref entry (aref globalThis/Symbol "iterator")) :call entry))
               (next nil) (done false) (key undefined) (value undefined) (active false))
          (unless (or (object? iterator) (callable? iterator)) (fail "iterator must be an object"))
          (setq next (aref iterator "next"))
          (try
            (let ((first (js-call next :call iterator)))
              (unless (or (object? first) (callable? first)) (fail "iterator result must be an object"))
              (setq done (truth (aref first "done")))
              (unless done
                (setq key (aref first "value"))
                (let ((second (js-call next :call iterator)))
                  (unless (or (object? second) (callable? second)) (fail "iterator result must be an object"))
                  (setq done (truth (aref second "done")))
                  (unless done (setq value (aref second "value"))))))
            (setq active t)
            (unless done
              (setq done t)
              (let ((close (aref iterator "return")))
                (unless (nullish? close)
                  (let ((closed (js-call close :call iterator)))
                    (unless (or (object? closed) (callable? closed)) (fail "iterator return must return an object"))))))
            (setq done t)
            (funcall reducer result key value)
            (catch error
              (when (and active (not done))
                (try (let ((close (aref iterator "return")))
                  (unless (nullish? close) (js-call close :call iterator))) (catch ignored nil)))
              (throw error))))) (js-array initial)))

  (defun collection-return-nil (&rest ignored) nil)
  (defun collection-return-zero (&rest ignored) 0)
  (defun collection-empty-string (&rest ignored) "")
  (defun collection-empty-object (&rest ignored) (js-object))
  (defun collection-empty-array (&rest ignored) (js-array))
  (defun collection-empty-map (&rest ignored) (new globalThis/Map))
  (defun collection-empty-set (&rest ignored) (new globalThis/Set))
  (defun collection-length-count (values) (js-length values))
  (defun collection-object-count (value) (js-length (Object/keys value)))
  (defun collection-size-count (values) (aref values "size"))
  (defun collection-indexed-get (values index &optional not-found)
    (indexedValue values index (if (undefined? not-found) nil not-found)))
  (defun collection-object-get (value key &optional not-found)
    (if (and (= (js* "typeof key") "string") (Object/hasOwn value key)) (aref value key) (if (undefined? not-found) nil not-found)))
  (defun collection-map-get (values key &optional not-found)
    (if (truth (js-call values :has key)) (js-call values :get key) (if (undefined? not-found) nil not-found)))
  (defun collection-set-get (values key &optional not-found)
    (if (truth (js-call values :has key)) key (if (undefined? not-found) nil not-found)))
  (defun collection-object-contains (value key)
    (and (= (js* "typeof key") "string") (Object/hasOwn value key)))
  (defun collection-has-contains (values key) (js-call values :has key))
  (defun collection-null-reduce-kv (_ reducer initial) initial)

  (defun install-collection-role-extension (role protocol)
    (cond
      ((= role "collection.ICounted")
        (extend-protocol-category protocol "string" (js-object :count collection-length-count))
        (extend-protocol-type protocol globalThis/Object (js-object :count collection-object-count))
        (extend-protocol-type protocol globalThis/Array (js-object :count collection-length-count))
        (extend-protocol-type protocol globalThis/Map (js-object :count collection-size-count))
        (extend-protocol-type protocol globalThis/Set (js-object :count collection-size-count))
        (extend-protocol-category protocol "null" (js-object :count collection-return-zero)))
      ((= role "collection.IEmptyable")
        (extend-protocol-category protocol "string" (js-object :empty collection-empty-string))
        (extend-protocol-type protocol globalThis/Object (js-object :empty collection-empty-object))
        (extend-protocol-type protocol globalThis/Array (js-object :empty collection-empty-array))
        (extend-protocol-type protocol globalThis/Map (js-object :empty collection-empty-map))
        (extend-protocol-type protocol globalThis/Set (js-object :empty collection-empty-set))
        (extend-protocol-category protocol "null" (js-object :empty collection-return-nil)))
      ((= role "collection.IConj")
        (extend-protocol-type protocol globalThis/Object (js-object :conj objectConj))
        (extend-protocol-type protocol globalThis/Array (js-object :conj arrayConj))
        (extend-protocol-type protocol globalThis/Map (js-object :conj mapConj))
        (extend-protocol-type protocol globalThis/Set (js-object :conj setConj)))
      ((= role "collection.ILookup")
        (extend-protocol-category protocol "string" (js-object :get collection-indexed-get))
        (extend-protocol-type protocol globalThis/Object (js-object :get collection-object-get))
        (extend-protocol-type protocol globalThis/Array (js-object :get collection-indexed-get))
        (extend-protocol-type protocol globalThis/Map (js-object :get collection-map-get))
        (extend-protocol-type protocol globalThis/Set (js-object :get collection-set-get)))
      ((= role "collection.IAssociative")
        (extend-protocol-type protocol globalThis/Object (js-object :assoc objectAssoc :contains collection-object-contains))
        (extend-protocol-type protocol globalThis/Array (js-object :assoc indexedAssoc :contains indexedContains))
        (extend-protocol-type protocol globalThis/Map (js-object :assoc mapAssoc :contains collection-has-contains))
        (extend-protocol-type protocol globalThis/Set (js-object :contains collection-has-contains)))
      ((= role "collection.IIndexed")
        (extend-protocol-category protocol "string" (js-object :nth indexedValue))
        (extend-protocol-type protocol globalThis/Array (js-object :nth indexedValue)))
      ((= role "collection.ISeqable")
        (extend-protocol-category protocol "string" (js-object :seq stringSequence))
        (extend-protocol-type protocol globalThis/Object (js-object :seq objectSequence))
        (extend-protocol-type protocol globalThis/Array (js-object :seq arraySequence))
        (extend-protocol-type protocol globalThis/Map (js-object :seq mapSequence))
        (extend-protocol-type protocol globalThis/Set (js-object :seq setSequence))
        (extend-protocol-category protocol "null" (js-object :seq collection-return-nil)))
      ((= role "collection.IKVReduce")
        (extend-protocol-type protocol globalThis/Object (js-object :reduceKV reduceObjectValues))
        (extend-protocol-type protocol globalThis/Array (js-object :reduceKV reduceIndexedValues))
        (extend-protocol-type protocol globalThis/Map (js-object :reduceKV reduceMapValues))
        (extend-protocol-category protocol "null" (js-object :reduceKV collection-null-reduce-kv)))
      ((= role "collection.IMap")
        (extend-protocol-type protocol globalThis/Object (js-object :dissoc objectDissoc))
        (extend-protocol-type protocol globalThis/Map (js-object :dissoc mapDissoc))
        (extend-protocol-category protocol "null" (js-object :dissoc collection-return-nil)))
      ((= role "collection.ISet")
        (extend-protocol-type protocol globalThis/Set (js-object :disj setDisj))
        (extend-protocol-category protocol "null" (js-object :disj collection-return-nil)))
      ((= role "collection.IStack")
        (extend-protocol-type protocol globalThis/Array (js-object :peek arrayPeek :pop arrayPop))
        (extend-protocol-category protocol "null" (js-object :peek collection-return-nil :pop collection-return-nil)))
      ((= role "collection.IReversible")
        (extend-protocol-category protocol "string" (js-object :rseq indexedReverseSequence))
        (extend-protocol-type protocol globalThis/Array (js-object :rseq indexedReverseSequence))
        (extend-protocol-category protocol "null" (js-object :rseq collection-return-nil)))))
  (defun flush-collection-role-extension (protocol)
    (let ((role (managed-literal-protocol-role protocol)))
      (unless (undefined? role)
        (install-collection-role-extension role protocol))))
  (let ((protocols (js-array
          ICounted IEmptyable IConj ILookup IAssociative IIndexed
          ISeqable IKVReduce IMap ISet IStack IReversible))
        (index 0))
    (while (< index (js-length protocols))
      (register-protocol-extension-loader flush-collection-role-extension (aref protocols index))
      (setq index (1+ index))))

  (defconst count-method (protocol-method ICounted "count"))
  (defconst empty-method (protocol-method IEmptyable "empty"))
  (defconst conj-method (protocol-method IConj "conj"))
  (defconst get-method (protocol-method ILookup "get"))
  (defconst assoc-method (protocol-method IAssociative "assoc"))
  (defconst contains-method (protocol-method IAssociative "contains"))
  (defconst nth-method (protocol-method IIndexed "nth"))
  (defconst seq-method (protocol-method ISeqable "seq"))
  (defconst reduce-method (protocol-method IReduce "reduce"))
  (defconst reduce-kv-method (protocol-method IKVReduce "reduceKV"))
  (defconst dissoc-method (protocol-method IMap "dissoc"))
  (defconst disj-method (protocol-method ISet "disj"))
  (defconst peek-method (protocol-method IStack "peek"))
  (defconst pop-method (protocol-method IStack "pop"))
  (defconst rseq-method (protocol-method IReversible "rseq"))

  (defun directSlot (value slot)
    (when (and (not (nullish? value))
               (or (= (js* "typeof value") "object") (= (js* "typeof value") "function")))
      (let ((method (aref value slot)))
        (when (= (js* "typeof method") "function") method))))
  (defun count (collection)
    (let ((slot (directSlot collection COLLECTION_COUNT)))
      (managed-literal-checked-count (if (not (nullish? slot)) (js-call slot :call collection) (funcall count-method collection)))))
  (defun isCounted (collection) (implements-protocol? ICounted collection))
  (defun isIndexed (collection) (implements-protocol? IIndexed collection))
  (defun isSeqable (collection) (implements-protocol? ISeqable collection))
  (defun isReducible (collection) (implements-protocol? IReduce collection))
  (defun isReversible (collection) (implements-protocol? IReversible collection))
  (defun isAssociative (collection) (implements-protocol? IAssociative collection))
  (defun isSequenceView (value) (or (instance? value SequenceView) (instance? value MemoizedSequenceView)))
  (defun isReductionView (value) (instance? value ReductionView))
  (defun isList (value) (literal-instance? value PersistentList))
  (defun isVector (value) (literal-instance? value PersistentVector))
  (defun isQueue (value) (literal-instance? value PersistentQueue))
  (defun isMap (value) (or (isPersistentMapValue value) (isRecord value)))
  (defun isSet (value) (isPersistentSetValue value))
  (defun isCollection (value) (or (isSequenceView value) (isList value) (isQueue value)
    (isVector value) (isPersistentMapValue value) (isRecord value) (isPersistentSetValue value)))
  (defun isSequential (value) (or (isSequenceView value) (isList value) (isQueue value) (isVector value)))
  (defun isSequence (value) (or (isSequenceView value) (isList value)))
  (defun boundedCount (limit collection)
    (unless (and (Number/isSafeInteger limit) (>= limit 0)) (fail "boundedCount limit must be a non-negative safe integer"))
    (if (= limit 0) 0
      (let ((sequence (seq collection)))
        (if (nil? sequence) 0
          (let ((iterator (js-call (aref sequence (aref globalThis/Symbol "iterator")) :call sequence)) (result 0) (complete false))
            (try
              (while (and (< result limit) (not (truth (aref (js-call iterator :next) "done"))))
                (setq result (1+ result)))
              (setq complete t)
              (finally
                (when (and (or (not complete) (= result limit)) (callable? (aref iterator "return")))
                  (js-call iterator :return))))
            result)))))
  (defun areDistinct (&rest values)
    (let ((seen (literal-set)) (index 0) (distinct t))
      (while (and distinct (< index (js-length values)))
        (let ((value (aref values index)))
          (if (truth (js-call seen :has value)) (setq distinct false) (setq seen (js-call seen :conj value))))
        (setq index (1+ index))) distinct))
  (defun empty (collection)
    (let ((slot (directSlot collection COLLECTION_EMPTY)))
      (if (not (nullish? slot)) (js-call slot :call collection) (funcall empty-method collection))))
  (defun conj (collection &rest values)
    (let ((result collection) (index 0))
      (while (< index (js-length values))
        (let ((slot (directSlot result COLLECTION_CONJ)) (value (aref values index)))
          (setq result (if (not (nullish? slot)) (js-call slot :call result value) (funcall conj-method result value))
                index (1+ index))))
      result))
  (defun get (collection key &optional not-found)
    (let ((slot (directSlot collection COLLECTION_GET)) (fallback (if (undefined? not-found) nil not-found)))
      (if (not (nullish? slot)) (js-call slot :call collection key fallback) (funcall get-method collection key fallback))))
  (defun assoc (&rest arguments)
    (unless (and (>= (js-length arguments) 3) (= (% (- (js-length arguments) 1) 2) 0))
      (fail "assoc requires a collection followed by one or more key/value pairs"))
    (let ((result (aref arguments 0)) (index 1))
      (while (< index (js-length arguments))
        ;; The protocol owns both slot validation and its single property read.
        ;; Pre-reading here would repeat observable accessors on fallback.
        (setq result (funcall assoc-method result
                       (aref arguments index) (aref arguments (1+ index)))
              index (+ index 2))) result))
  (defun contains (collection key)
    (let* ((slot (directSlot collection COLLECTION_CONTAINS))
           (result (if (not (nullish? slot)) (js-call slot :call collection key) (funcall contains-method collection key))))
      (unless (= (js* "typeof result") "boolean") (fail "IAssociative/contains must return a boolean")) result))
  (defun nth (collection index &rest not-found)
    (let ((slot (directSlot collection COLLECTION_NTH)))
      (if (= (js-length not-found) 0)
        (if (not (nullish? slot)) (js-call slot :call collection index) (funcall nth-method collection index))
        (if (not (nullish? slot)) (js-call slot :call collection index (aref not-found 0)) (funcall nth-method collection index (aref not-found 0))))))
  (defun checkedSequence (result message)
    (if (nil? result) nil
      (progn (when (or (undefined? result) (not (callable? (aref result (aref globalThis/Symbol "iterator"))))) (fail message)) result)))
  (defun seq (collection)
    (let ((slot (directSlot collection COLLECTION_SEQ)))
      (checkedSequence (if (not (nullish? slot)) (js-call slot :call collection) (funcall seq-method collection))
        "ISeqable/seq must return null or an iterable sequence view")))
  (defun isEmpty (collection) (nil? (seq collection)))
  (defun notEmpty (collection) (if (isEmpty collection) nil collection))
  (defun reduce (collection reducer &rest initial)
    (unless (callable? reducer) (fail "collection reducer must be a function"))
    (let ((slot (directSlot collection COLLECTION_REDUCE)))
      (managed-literal-unreduced (if (= (js-length initial) 0)
        (if (not (nullish? slot)) (js-call slot :call collection reducer) (funcall reduce-method collection reducer))
        (if (not (nullish? slot)) (js-call slot :call collection reducer (aref initial 0)) (funcall reduce-method collection reducer (aref initial 0)))))))
  (defun reduceKV (&rest arguments)
    (unless (= (js-length arguments) 3) (fail "reduceKV requires a collection, reducer, and initial value"))
    (unless (callable? (aref arguments 1)) (fail "key/value reducer must be a function"))
    (let* ((collection (aref arguments 0)) (slot (directSlot collection COLLECTION_REDUCE_KV)))
      (managed-literal-unreduced (if (not (nullish? slot))
        (js-call slot :call collection (aref arguments 1) (aref arguments 2))
        (funcall reduce-kv-method collection (aref arguments 1) (aref arguments 2))))))
  (defun dissoc (collection &rest keys)
    (let ((result collection) (index 0))
      (while (< index (js-length keys))
        (let ((slot (directSlot result COLLECTION_DISSOC)) (key (aref keys index)))
          (setq result (if (not (nullish? slot)) (js-call slot :call result key) (funcall dissoc-method result key))
                index (1+ index)))) result))
  (defun disj (collection &rest values)
    (let ((result collection) (index 0))
      (while (< index (js-length values))
        (let ((slot (directSlot result COLLECTION_DISJ)) (value (aref values index)))
          (setq result (if (not (nullish? slot)) (js-call slot :call result value) (funcall disj-method result value))
                index (1+ index)))) result))
  (defun peek (&rest arguments)
    (unless (= (js-length arguments) 1) (fail "peek requires exactly one collection"))
    (let* ((collection (aref arguments 0)) (slot (directSlot collection COLLECTION_PEEK)))
      (if (not (nullish? slot)) (js-call slot :call collection) (funcall peek-method collection))))
  (defun pop (&rest arguments)
    (unless (= (js-length arguments) 1) (fail "pop requires exactly one collection"))
    (let* ((collection (aref arguments 0)) (slot (directSlot collection COLLECTION_POP)))
      (if (not (nullish? slot)) (js-call slot :call collection) (funcall pop-method collection))))
  (defun rseq (&rest arguments)
    (unless (= (js-length arguments) 1) (fail "rseq requires exactly one collection"))
    (let* ((collection (aref arguments 0)) (slot (directSlot collection COLLECTION_RSEQ)))
      (checkedSequence (if (not (nullish? slot)) (js-call slot :call collection) (funcall rseq-method collection))
        "IReversible/rseq must return null or an iterable sequence view")))
  (defun reduced (value) (managed-literal-reduced value))
  (defun isReduced (value) (managed-literal-is-reduced value))
  (defun unreduced (value) (managed-literal-unreduced value))
  (Object/defineProperty assoc "length" (js-object :value 3 :configurable t))
  (Object/defineProperty reduceKV "length" (js-object :value 3 :configurable t))
  (Object/defineProperty peek "length" (js-object :value 1 :configurable t))
  (Object/defineProperty pop "length" (js-object :value 1 :configurable t))
  (Object/defineProperty rseq "length" (js-object :value 1 :configurable t))
  (Object/defineProperty sequenceView "length" (js-object :value 1 :configurable t))
  (Object/defineProperty get "length" (js-object :value 2 :configurable t))
  (export ICounted IEmptyable IConj ILookup IAssociative IIndexed ISeqable IReduce IKVReduce IMap ISet IStack IReversible
    ReductionView MemoizedSequenceView SequenceView reductionView memoizedSequenceView memoizedSequenceStatus sequenceView unboundedSequenceView
    sliceSequenceView prependSequenceView
    count isCounted isIndexed isSeqable isReducible isReversible isAssociative isCollection isList isVector isQueue isMap isSet
    isSequential isSequence boundedCount areDistinct empty conj get assoc contains nth seq isEmpty notEmpty reduce reduceKV
    dissoc disj peek pop rseq reduced isReduced unreduced isSequenceView isReductionView))
