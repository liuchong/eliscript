  (extend-protocol-type IKVReduce globalThis/Array (js-object :reduceKV reduceIndexedValues))
  (extend-protocol-type IStack globalThis/Array (js-object :peek arrayPeek :pop arrayPop))
  (extend-protocol-type IReversible globalThis/Array (js-object :rseq indexedReverseSequence))
  (extend-protocol-type ICounted globalThis/Map (js-object :count (lambda (values) (aref values "size"))))
  (extend-protocol-type IEmptyable globalThis/Map (js-object :empty (lambda (&rest ignored) (new globalThis/Map))))
  (extend-protocol-type IConj globalThis/Map (js-object :conj mapConj))
  (extend-protocol-type ILookup globalThis/Map (js-object :get (lambda (values key &optional not-found)
