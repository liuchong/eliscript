  (extend-protocol-type IAssociative globalThis/Array (js-object :assoc indexedAssoc :contains indexedContains))
  (extend-protocol-type IIndexed globalThis/Array (js-object :nth indexedValue))
  (extend-protocol-type ISeqable globalThis/Array (js-object :seq arraySequence))
  (extend-protocol-type IReduce globalThis/Array (js-object :reduce (lambda (values reducer &rest initial)
