(module eliscript.managed-runtime-collection
  (import "../../stdlib/core/protocol.eli"
    extend-protocol-category extend-protocol-type implements-protocol? protocol-method)
  (import "../../stdlib/managed-literal-protocols.eli"
    I_COUNTED I_EMPTYABLE I_CONJ I_INDEXED I_LOOKUP I_ASSOCIATIVE I_REDUCE I_KV_REDUCE I_MAP I_SET I_STACK I_REVERSIBLE I_SEQABLE
    managed-literal-is-reduced managed-literal-reduced managed-literal-unreduced
    managed-literal-reduce-iterable managed-literal-sequence-view managed-literal-unbounded-sequence-view
    managed-literal-install-slot managed-literal-checked-count ManagedLiteralSequenceView
    managed-literal-read-sequence-state managed-literal-shift-sequence-count managed-literal-sequence-from-count
    PERSISTENT_MAP_KIND PERSISTENT_MAP_HAS_VALUE_KEY PERSISTENT_SET_KIND PERSISTENT_SET_HAS_VALUE)
  (import "./list.mjs" isPersistentList)
  (import "./vector.mjs" isPersistentVector)
  (import "./queue.mjs" isPersistentQueue)
  (import "./record.mjs" isRecord)
  (import "./set.mjs" persistentHashSet)

  (defconst ICounted I_COUNTED)
  (defconst IEmptyable I_EMPTYABLE)
  (defconst IConj I_CONJ)
  (defconst ILookup I_LOOKUP)
  (defconst IAssociative I_ASSOCIATIVE)
  (defconst IIndexed I_INDEXED)
  (defconst ISeqable I_SEQABLE)
  (defconst IReduce I_REDUCE)
  (defconst IKVReduce I_KV_REDUCE)
  (defconst IMap I_MAP)
  (defconst ISet I_SET)
  (defconst IStack I_STACK)
  (defconst IReversible I_REVERSIBLE)
  (defconst SequenceView ManagedLiteralSequenceView)
  (defconst MISSING (funcall globalThis/Symbol "eliscript.collection.missing"))
  (defconst memo-state (funcall globalThis/Symbol "eliscript.collection.memoized-sequence-state"))
  (defconst memo-token (funcall globalThis/Symbol "eliscript.collection.memoized-sequence-token"))
  (defconst no-memo-failure (funcall globalThis/Symbol "eliscript.collection.no-memoized-sequence-failure"))
  (defconst reduction-state (funcall globalThis/Symbol "eliscript.collection.reduction-state"))
  (defconst reduction-token (funcall globalThis/Symbol "eliscript.collection.reduction-token"))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun callable? (value) (= (js* "typeof value") "function"))
  (defun boolean? (value) (= (js* "typeof value") "boolean"))
  (defun object? (value) (and (not (nil? value)) (= (js* "typeof value") "object")))
  (defun instance? (value constructor)
    (let ((method (aref constructor (aref globalThis/Symbol "hasInstance"))))
      (when (nullish? method)
        (setq method (aref (aref globalThis/Function "prototype") (aref globalThis/Symbol "hasInstance"))))
      (js-call method :call constructor value)))
  (defun truth (value) (funcall globalThis/Boolean value))
  (defun selfIterable (iterator enumerable)
    (let ((method (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      (lambda (receiver) receiver) "[Symbol.iterator]")))
      (Object/defineProperty iterator (aref globalThis/Symbol "iterator")
        (js-object :value method :enumerable enumerable :writable t :configurable t))) iterator)
  (defun invoke (protocol operation &rest arguments) (apply (protocol-method protocol operation) arguments))
  (defun iteratorFromFactory (factory)
    (let ((iterator (funcall factory)))
      (unless (and (object? iterator) (callable? (aref iterator "next")))
        (fail "sequence view factory must return an iterator")) iterator))
  (defun isPersistentMapValue (value)
    (and (not (nullish? value)) (eq (aref value PERSISTENT_MAP_KIND) t)
         (callable? (aref value PERSISTENT_MAP_HAS_VALUE_KEY))))
  (defun isPersistentSetValue (value)
    (and (not (nullish? value)) (eq (aref value PERSISTENT_SET_KIND) t)
         (callable? (aref value PERSISTENT_SET_HAS_VALUE))))

  (defun memoRead (state index)
    (cond
      ((< index (js-length (aref state "values")))
        (js-object :value (aref (aref state "values") index) :done false))
      ((not (eq (aref state "failure") no-memo-failure)) (throw (aref state "failure")))
      ((aref state "complete") (js-object :value undefined :done t))
      (t
        (unless (aref state "started")
          (put state :started t)
          (try
            (put state :source (iteratorFromFactory (aref state "factory")))
            (put state :factory nil)
            (catch error (put state :failure error) (throw error))))
        (try
          (let ((result (js-call (aref state "source") :next)))
            (unless (and (object? result) (boolean? (aref result "done")))
              (fail "sequence iterator must return an iterator result"))
            (if (truth (aref result "done"))
              (progn (put state :complete t) (put state :source nil) (js-object :value undefined :done t))
              (progn
                (js-call (aref state "values") :push (aref result "value"))
                (js-object :value (aref result "value") :done false))))
          (catch error
            (let ((source (aref state "source")))
              (put state :failure error)
              (put state :source nil)
              (when (and (not (nil? source)) (callable? (aref source "return")))
                (try (js-call source :return) (catch close-error nil)))
              (throw error)))))))
  (defun memoSourceIterator (state)
    (let ((index 0) (closed false) (iterator nil))
      (setq iterator (js-object
        :next (lambda ()
          (if closed (js-object :value undefined :done t)
            (let ((result (js-call state :read index)))
              (unless (truth (aref result "done")) (setq index (1+ index))) result)))
        :return (lambda (&optional value) (setq closed t) (js-object :value value :done t))))
      (selfIterable iterator t)))
  (defun memoIterator (receiver)
    (js-call (aref (aref receiver memo-state) "source") :iterator))
  (defun MemoizedSequenceSource (factory)
    (put (js* "this") :factory factory)
    (put (js* "this") :source nil)
    (put (js* "this") :values (js-array))
    (put (js* "this") :started false)
    (put (js* "this") :complete false)
    (put (js* "this") :failure no-memo-failure))
  (defun installMethod (prototype name implementation arity)
    (let ((method (funcall
      (js* "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")
      implementation name)))
      (Object/defineProperty method "length" (js-object :value arity :configurable t))
      (Object/defineProperty prototype name (js-object :value method :writable t :configurable t))))
  (installMethod (aref MemoizedSequenceSource "prototype") "read" memoRead 1)
  (installMethod (aref MemoizedSequenceSource "prototype") "iterator" memoSourceIterator 0)
  (defun MemoizedSequenceView (token factory count)
    (unless (and (eq token memo-token) (callable? factory))
      (fail "MemoizedSequenceView values must be created by memoizedSequenceView"))
    (Object/defineProperty (js* "this") memo-state
      (js-object :value (Object/freeze (js-object :source (new MemoizedSequenceSource factory) :count count))
        :enumerable t :writable t :configurable t))
    (Object/freeze (js* "this")))
  (defun memoizedSequenceView (factory &optional count)
    (when (undefined? count) (setq count nil))
    (unless (callable? factory) (fail "memoized sequence view factory must be a function"))
    (unless (nil? count) (managed-literal-checked-count count))
    (if (eq count 0) nil (new MemoizedSequenceView memo-token factory count)))
  (defun memoCount (receiver)
    (let ((count (aref (aref receiver memo-state) "count")))
      (if (not (nil? count)) count
        (let ((iterator (memoIterator receiver)) (result 0) (done false))
          (while (not done)
            (setq done (truth (aref (js-call iterator :next) "done")))
            (unless done (setq result (managed-literal-checked-count (1+ result))))) result))))
  (defun memoSeq (receiver)
    (let ((iterator (memoIterator receiver)))
      (try (if (truth (aref (js-call iterator :next) "done")) nil receiver)
        (finally (js-call iterator :return)))))
  (defun memoizedSequenceStatus (value)
    (unless (instance? value MemoizedSequenceView) (fail "expected a memoized sequence view"))
    (let ((source (aref (aref value memo-state) "source")))
      (Object/freeze (js-object :started (aref source "started") :complete (aref source "complete")
        :failed (not (eq (aref source "failure") no-memo-failure)) :realizedCount (js-length (aref source "values"))))))
  (defun ReductionView (token reduce-function)
    (unless (and (eq token reduction-token) (callable? reduce-function))
      (fail "ReductionView values must be created by reductionView"))
    (Object/defineProperty (js* "this") reduction-state
      (js-object :value reduce-function :enumerable t :writable t :configurable t))
    (Object/freeze (js* "this")))
  (defun reductionView (reduce-function)
    (unless (callable? reduce-function) (fail "reduction view function must be a function"))
    (new ReductionView reduction-token reduce-function))
  (defun sequenceView (factory &optional count)
    (managed-literal-sequence-view factory (if (undefined? count) nil count)))
  (defun unboundedSequenceView (factory) (managed-literal-unbounded-sequence-view factory))
  (defun sequenceState (sequence)
    (if (instance? sequence SequenceView) (managed-literal-read-sequence-state sequence)
      (js-object :factory (lambda () (js-call (aref sequence (aref globalThis/Symbol "iterator")) :call sequence))
        :count (aref (aref sequence memo-state) "count"))))
  (defun sliceSequenceView (sequence offset)
    (if (nil? sequence) nil
      (progn
        (unless (isSequenceView sequence) (fail "sequence slice expects a SequenceView or nil"))
        (managed-literal-checked-count offset)
        (if (= offset 0) sequence
          (let* ((state (sequenceState sequence))
                 (factory (lambda ()
                   (let ((iterator (js-call (aref sequence (aref globalThis/Symbol "iterator")) :call sequence))
                         (remaining offset) (done false))
                     (while (and (> remaining 0) (not done))
                       (if (truth (aref (js-call iterator :next) "done")) (setq done t)
                         (setq remaining (1- remaining)))) iterator)))
                 (count (managed-literal-shift-sequence-count state offset false)))
            (managed-literal-sequence-from-count factory count))))))
  (defun prependIterator (value sequence)
    (let ((stage 0) (running false) (delegate nil) (next nil) (iterator nil) (action nil))
      (setq action (lambda (operation sent)
        (when running (fail "Generator is already running"))
        (setq running t)
        (try
          (cond
            ((= stage 3)
              (if (= operation 2) (throw sent) (js-object :value (if (= operation 1) sent undefined) :done t)))
            ((and (< stage 2) (/= operation 0))
              (setq stage 3)
              (if (= operation 2) (throw sent) (js-object :value sent :done t)))
            ((= stage 0) (setq stage 1) (js-object :value value :done false))
            (t
              (let ((beginning (= stage 1)))
                (when beginning
                  (setq stage 2)
                  (unless (nil? sequence)
                    (setq delegate (js-call (aref sequence (aref globalThis/Symbol "iterator")) :call sequence))
                    (unless (or (object? delegate) (callable? delegate)) (fail "iterator must be an object"))
                    (setq next (aref delegate "next"))))
                (if (nil? delegate) (progn (setq stage 3) (js-object :value undefined :done t))
                  (let ((method (if (= operation 0) next (aref delegate (if (= operation 1) "return" "throw")))))
                    (cond
                      ((and (= operation 1) (nullish? method))
                        (setq stage 3) (js-object :value sent :done t))
                      ((and (= operation 2) (nullish? method))
                        (let ((close (aref delegate "return")))
                          (unless (nullish? close)
                            (let ((result (js-call close :call delegate)))
                              (unless (or (object? result) (callable? result)) (fail "iterator return must return an object")))))
                        (fail "The iterator does not provide a throw method"))
                      (t
                        (let ((result (js-call method :call delegate (if beginning undefined sent))))
                          (unless (or (object? result) (callable? result)) (fail "iterator result must be an object"))
                          (if (truth (aref result "done"))
                            (let ((returned (aref result "value")))
                              (setq stage 3) (js-object :value (if (= operation 1) returned undefined) :done t)) result)))))))))
          (catch error (setq stage 3) (throw error))
          (finally (setq running false)))))
      (setq iterator (js-object
        :next (lambda (&optional sent) (funcall action 0 sent))
        :return (lambda (&optional sent) (funcall action 1 sent))
        :throw (lambda (&optional sent) (funcall action 2 sent))))
      (selfIterable iterator false)))
  (defun prependSequenceView (value sequence)
    (unless (or (nil? sequence) (isSequenceView sequence)) (fail "sequence prepend expects a SequenceView or nil"))
    (let ((factory (lambda () (prependIterator value sequence))))
      (if (nil? sequence) (sequenceView factory 1)
        (managed-literal-sequence-from-count factory (managed-literal-shift-sequence-count (sequenceState sequence) 0 t)))))
  (defun viewReduce (receiver reducer &rest initial)
    (managed-literal-reduce-iterable receiver reducer initial))
  (defun reductionReduce (receiver reducer &rest initial)
    (let ((method (aref receiver reduction-state)))
      (js-call method :apply receiver (js-cons reducer initial))))
  (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (aref globalThis/Symbol "iterator") memoIterator)
  (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (aref (protocol-method ICounted "count") "slot") memoCount)
  (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (aref (protocol-method ISeqable "seq") "slot") memoSeq)
  (managed-literal-install-slot (aref MemoizedSequenceView "prototype") (aref (protocol-method IReduce "reduce") "slot") viewReduce)
  (managed-literal-install-slot (aref ReductionView "prototype") (aref (protocol-method IReduce "reduce") "slot") reductionReduce)
  (Object/defineProperty (aref MemoizedSequenceView "prototype") (aref globalThis/Symbol "toStringTag")
    (js-object :get (lambda () "EliscriptMemoizedSequenceView") :configurable t))
  (Object/defineProperty (aref ReductionView "prototype") (aref globalThis/Symbol "toStringTag")
    (js-object :get (lambda () "EliscriptReductionView") :configurable t))

  (defun indexedValue (values index &rest fallbacks)
    (let ((not-found (if (or (= (js-length fallbacks) 0) (undefined? (aref fallbacks 0)))
                        MISSING (aref fallbacks 0))))
      (cond ((and (Number/isInteger index) (>= index 0) (< index (js-length values))) (aref values index))
        ((not (eq not-found MISSING)) not-found)
        (t (throw (new globalThis/RangeError (str "nth index " index " is outside collection bounds")))))))
  (defun indexedAssoc (values index value)
    (unless (and (Number/isInteger index) (>= index 0) (<= index (js-length values)))
      (throw (new globalThis/RangeError (str "assoc index " index " is outside collection bounds"))))
    (let ((result (js-call values :slice))) (put result index value) result))
  (defun indexedContains (values index) (and (Number/isInteger index) (>= index 0) (< index (js-length values))))
  (defun readEntry (entry)
    (unless (and (not (nullish? entry)) (callable? (aref entry (aref globalThis/Symbol "iterator"))))
      (fail "persistent hash map entries must be iterable key/value pairs"))
    (let ((iterator (iteratorFromFactory (lambda () (js-call (aref entry (aref globalThis/Symbol "iterator")) :call entry))))
          (complete false))
      (try
        (let* ((first (js-call iterator :next)))
          (when (truth (aref first "done")) (fail "persistent hash map entries must contain exactly two values"))
          (let ((second (js-call iterator :next)))
            (when (truth (aref second "done")) (fail "persistent hash map entries must contain exactly two values"))
            (let ((third (js-call iterator :next)))
              (unless (truth (aref third "done")) (fail "persistent hash map entries must contain exactly two values")))
            (setq complete t) (js-array (aref first "value") (aref second "value"))))
        (finally (when (and (not complete) (callable? (aref iterator "return"))) (js-call iterator :return))))))
  (defun cloneObject (source)
    (let ((result (js-object)) (keys (Reflect/ownKeys source)) (index 0))
      (while (< index (js-length keys))
        (let* ((key (aref keys index)) (descriptor (Object/getOwnPropertyDescriptor source key)))
          (when (and (not (undefined? descriptor)) (aref descriptor "enumerable"))
            (Object/defineProperty result key (js-object :value (aref source key) :writable t :enumerable t :configurable t))))
        (setq index (1+ index))) result))
  (defun objectAssoc (values key value)
    (unless (= (js* "typeof key") "string") (fail "plain object association keys must be strings"))
    (let ((result (cloneObject values)))
      (Object/defineProperty result key (js-object :value value :writable t :enumerable t :configurable t)) result))
  (defun objectConj (values entry) (let ((pair (readEntry entry))) (objectAssoc values (aref pair 0) (aref pair 1))))
  (defun objectDissoc (values key)
    (unless (= (js* "typeof key") "string") (fail "plain object dissociation keys must be strings"))
    (let ((result (cloneObject values))) (Reflect/deleteProperty result key) result))
  (defun mapConj (values entry)
    (let* ((pair (readEntry entry)) (result (new globalThis/Map values)))
      (js-call result :set (aref pair 0) (aref pair 1)) result))
  (defun mapAssoc (values key value) (let ((result (new globalThis/Map values))) (js-call result :set key value) result))
  (defun mapDissoc (values key) (let ((result (new globalThis/Map values))) (js-call result :delete key) result))
  (defun setConj (values value) (let ((result (new globalThis/Set values))) (js-call result :add value) result))
  (defun setDisj (values value) (let ((result (new globalThis/Set values))) (js-call result :delete value) result))
  (defun arrayConj (values value)
    (let ((result (managed-literal-reduce-iterable values
            (lambda (result item)
              (Object/defineProperty result (js-length result)
                (js-object :value item :writable t :enumerable t :configurable t)) result)
            (js-array (js-array)))))
      (Object/defineProperty result (js-length result) (js-object :value value :writable t :enumerable t :configurable t)) result))
  (defun arrayPeek (values) (if (= (js-length values) 0) nil (aref values (1- (js-length values)))))
  (defun arrayPop (values)
    (when (= (js-length values) 0) (throw (new globalThis/RangeError "cannot pop an empty array")))
    (js-call values :slice 0 -1))
  (defun indexedReverseSequence (values)
    (if (= (js-length values) 0) nil
      (sequenceView (lambda ()
        (let ((index (js-length values)))
          (js-object :next (lambda ()
            (if (= index 0) (js-object :value undefined :done t)
              (progn (setq index (1- index)) (js-object :value (aref values index) :done false)))))))
        (lambda () (js-length values)))))
  (defun arraySequence (values)
    (if (= (js-length values) 0) nil
      (sequenceView (lambda () (js-call (aref values (aref globalThis/Symbol "iterator")) :call values)) (lambda () (js-length values)))))
  (defun stringSequence (value)
    (if (= (js-length value) 0) nil
      (sequenceView (lambda ()
        (let ((index 0))
          (js-object :next (lambda ()
            (if (>= index (js-length value)) (js-object :value undefined :done t)
              (let ((current (aref value index))) (setq index (1+ index)) (js-object :value current :done false)))))))
        (lambda () (js-length value)))))
  (defun objectSequence (value)
    (if (= (js-length (Object/keys value)) 0) nil
      (sequenceView (lambda ()
        (let ((keys nil) (index 0))
          (js-object :next (lambda ()
            (when (nil? keys) (setq keys (Object/keys value)))
            (if (>= index (js-length keys)) (js-object :value undefined :done t)
              (let ((key (aref keys index))) (setq index (1+ index))
                (js-object :value (Object/freeze (js-array key (aref value key))) :done false)))))))
        (lambda () (js-length (Object/keys value))))))
  (defun mappedIterator (factory transform)
    (let ((source nil) (next nil) (closed false) (iterator nil))
      (setq iterator (js-object :next (lambda ()
        (if closed (js-object :value undefined :done t)
          (progn
            (when (nil? source)
              (setq source (funcall factory))
              (unless (or (object? source) (callable? source)) (fail "iterator must be an object"))
              (setq next (aref source "next")))
            (let ((result (js-call next :call source)))
              (unless (or (object? result) (callable? result)) (fail "iterator result must be an object"))
              (if (truth (aref result "done")) (progn (setq closed t) (js-object :value undefined :done t))
                (try (js-object :value (funcall transform (aref result "value")) :done false)
                  (catch error (setq closed t)
                    (try (let ((close (aref source "return")))
                      (unless (nullish? close) (js-call close :call source))) (catch close-error nil))
                    (throw error))))))))
        :return (lambda (&optional value)
          (unless closed (setq closed t)
            (unless (nil? source)
              (let ((close (aref source "return")))
                (unless (nullish? close)
                  (let ((result (js-call close :call source)))
                    (unless (or (object? result) (callable? result)) (fail "iterator return must return an object")))))))
          (js-object :value value :done t))))
      (selfIterable iterator false)))
  (defun mapSequence (values)
    (if (= (aref values "size") 0) nil
      (sequenceView (lambda () (mappedIterator
        (lambda () (js-call (aref values (aref globalThis/Symbol "iterator")) :call values))
        (lambda (entry) (Object/freeze (js-array (aref entry 0) (aref entry 1))))))
        (lambda () (aref values "size")))))
  (defun setSequence (values)
    (if (= (aref values "size") 0) nil
      (sequenceView (lambda () (js-call (aref values (aref globalThis/Symbol "iterator")) :call values)) (lambda () (aref values "size")))))
  (defun reduceIndexedValues (values reducer initial)
    (let ((result initial) (index 0) (done false))
      (while (and (< index (js-length values)) (not done))
        (setq result (funcall reducer result index (aref values index)))
        (when (managed-literal-is-reduced result)
          (setq result (managed-literal-unreduced result) done t))
        (setq index (1+ index)))
      result))
  (defun reduceObjectValues (value reducer initial)
    (let ((keys (Object/keys value)) (index 0) (result initial) (done false))
      (while (and (< index (js-length keys)) (not done))
        (let ((key (aref keys index)))
          (setq result (funcall reducer result key (aref value key))))
        (setq index (1+ index))
        (when (managed-literal-is-reduced result)
          (setq result (managed-literal-unreduced result) done t)))
      result))
  (defun reduceMapValues (values reducer initial)
    (managed-literal-reduce-iterable values
      (lambda (result entry)
        (let* ((iterator (js-call (aref entry (aref globalThis/Symbol "iterator")) :call entry))
               (next nil) (done false) (key undefined) (value undefined) (active false))
          (unless (or (object? iterator) (callable? iterator)) (fail "iterator must be an object"))
          (setq next (aref iterator "next"))
          (try
            (let ((first (js-call next :call iterator)))
              (unless (or (object? first) (callable? first)) (fail "iterator result must be an object"))
              (setq done (truth (aref first "done")))
              (unless done
                (setq key (aref first "value"))
                (let ((second (js-call next :call iterator)))
                  (unless (or (object? second) (callable? second)) (fail "iterator result must be an object"))
                  (setq done (truth (aref second "done")))
                  (unless done (setq value (aref second "value"))))))
            (setq active t)
            (unless done
              (setq done t)
              (let ((close (aref iterator "return")))
                (unless (nullish? close)
                  (let ((closed (js-call close :call iterator)))
                    (unless (or (object? closed) (callable? closed)) (fail "iterator return must return an object"))))))
            (setq done t)
            (funcall reducer result key value)
            (catch error
              (when (and active (not done))
                (try (let ((close (aref iterator "return")))
                  (unless (nullish? close) (js-call close :call iterator))) (catch ignored nil)))
              (throw error))))) (js-array initial)))

  (extend-protocol-category ICounted "string" (js-object :count (lambda (value) (js-length value))))
  (extend-protocol-category IEmptyable "string" (js-object :empty (lambda (&rest ignored) "")))
  (extend-protocol-category ILookup "string" (js-object :get (lambda (value index &optional not-found)
    (indexedValue value index (if (undefined? not-found) nil not-found)))))
  (extend-protocol-category IIndexed "string" (js-object :nth indexedValue))
  (extend-protocol-category ISeqable "string" (js-object :seq stringSequence))
  (extend-protocol-category IReduce "string" (js-object :reduce (lambda (value reducer &rest initial)
    (managed-literal-reduce-iterable (or (stringSequence value) (js-array)) reducer initial))))
  (extend-protocol-category IReversible "string" (js-object :rseq indexedReverseSequence))
  (extend-protocol-type ICounted globalThis/Object (js-object :count (lambda (value) (js-length (Object/keys value)))))
  (extend-protocol-type IEmptyable globalThis/Object (js-object :empty (lambda (&rest ignored) (js-object))))
  (extend-protocol-type IConj globalThis/Object (js-object :conj objectConj))
  (extend-protocol-type ILookup globalThis/Object (js-object :get (lambda (value key &optional not-found)
    (if (and (= (js* "typeof key") "string") (Object/hasOwn value key)) (aref value key) (if (undefined? not-found) nil not-found)))))
