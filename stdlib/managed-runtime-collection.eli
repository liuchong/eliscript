  (extend-protocol-type ISet globalThis/Set (js-object :disj setDisj))
  (extend-protocol-category ICounted "null" (js-object :count (lambda (&rest ignored) 0)))
  (extend-protocol-category IEmptyable "null" (js-object :empty (lambda (&rest ignored) nil)))
  (extend-protocol-category ISeqable "null" (js-object :seq (lambda (&rest ignored) nil)))
  (extend-protocol-category IReduce "null" (js-object :reduce (lambda (_ reducer &rest initial)
    (managed-literal-reduce-iterable (js-array) reducer initial))))
  (extend-protocol-category IKVReduce "null" (js-object :reduceKV (lambda (_ reducer initial) initial)))
  (extend-protocol-category IMap "null" (js-object :dissoc (lambda (&rest ignored) nil)))
  (extend-protocol-category ISet "null" (js-object :disj (lambda (&rest ignored) nil)))
  (extend-protocol-category IStack "null" (js-object :peek (lambda (&rest ignored) nil) :pop (lambda (&rest ignored) nil)))
  (extend-protocol-category IReversible "null" (js-object :rseq (lambda (&rest ignored) nil)))

  (defun count (collection) (managed-literal-checked-count (invoke ICounted "count" collection)))
  (defun isCounted (collection) (implements-protocol? ICounted collection))
  (defun isIndexed (collection) (implements-protocol? IIndexed collection))
  (defun isSeqable (collection) (implements-protocol? ISeqable collection))
  (defun isReducible (collection) (implements-protocol? IReduce collection))
  (defun isReversible (collection) (implements-protocol? IReversible collection))
  (defun isAssociative (collection) (implements-protocol? IAssociative collection))
  (defun isSequenceView (value) (or (instance? value SequenceView) (instance? value MemoizedSequenceView)))
  (defun isReductionView (value) (instance? value ReductionView))
  (defun isCollection (value) (or (isSequenceView value) (isPersistentList value) (isPersistentQueue value)
    (isPersistentVector value) (isPersistentMapValue value) (isRecord value) (isPersistentSetValue value)))
  (defun isList (value) (isPersistentList value))
  (defun isVector (value) (isPersistentVector value))
  (defun isQueue (value) (isPersistentQueue value))
  (defun isMap (value) (or (isPersistentMapValue value) (isRecord value)))
  (defun isSet (value) (isPersistentSetValue value))
  (defun isSequential (value) (or (isSequenceView value) (isPersistentList value) (isPersistentQueue value) (isPersistentVector value)))
  (defun isSequence (value) (or (isSequenceView value) (isPersistentList value)))
  (defun boundedCount (limit collection)
    (unless (and (Number/isSafeInteger limit) (>= limit 0)) (fail "boundedCount limit must be a non-negative safe integer"))
    (if (= limit 0) 0
      (let ((sequence (seq collection)))
        (if (nil? sequence) 0
          (let ((iterator (js-call (aref sequence (aref globalThis/Symbol "iterator")) :call sequence)) (result 0) (complete false))
            (try
              (while (and (< result limit) (not (truth (aref (js-call iterator :next) "done"))))
                (setq result (1+ result)))
              (setq complete t)
              (finally
                (when (and (or (not complete) (= result limit)) (callable? (aref iterator "return")))
                  (js-call iterator :return))))
            result)))))
  (defun areDistinct (&rest values)
    (let ((seen (persistentHashSet)) (index 0) (distinct t))
      (while (and distinct (< index (js-length values)))
        (let ((value (aref values index)))
          (if (truth (js-call seen :has value)) (setq distinct false) (setq seen (js-call seen :conj value))))
        (setq index (1+ index))) distinct))
  (defun empty (collection) (invoke IEmptyable "empty" collection))
  (defun conj (collection &rest values)
    (let ((result collection) (index 0))
      (while (< index (js-length values)) (setq result (invoke IConj "conj" result (aref values index)) index (1+ index))) result))
  (defun get (collection key &optional not-found)
    (invoke ILookup "get" collection key (if (undefined? not-found) nil not-found)))
  (defun assoc (&rest arguments)
    (unless (and (>= (js-length arguments) 3) (= (% (- (js-length arguments) 1) 2) 0))
      (fail "assoc requires a collection followed by one or more key/value pairs"))
    (let ((result (aref arguments 0)) (index 1))
      (while (< index (js-length arguments))
        (setq result (invoke IAssociative "assoc" result (aref arguments index) (aref arguments (1+ index))) index (+ index 2))) result))
  (defun contains (collection key)
    (let ((result (invoke IAssociative "contains" collection key)))
      (unless (= (js* "typeof result") "boolean") (fail "IAssociative/contains must return a boolean")) result))
  (defun nth (collection index &rest not-found)
    (if (= (js-length not-found) 0) (invoke IIndexed "nth" collection index) (invoke IIndexed "nth" collection index (aref not-found 0))))
  (defun checkedSequence (result message)
    (if (nil? result) nil
      (progn (when (or (undefined? result) (not (callable? (aref result (aref globalThis/Symbol "iterator"))))) (fail message)) result)))
  (defun seq (collection) (checkedSequence (invoke ISeqable "seq" collection) "ISeqable/seq must return null or an iterable sequence view"))
  (defun isEmpty (collection) (nil? (seq collection)))
  (defun notEmpty (collection) (if (isEmpty collection) nil collection))
  (defun reduce (collection reducer &rest initial)
    (unless (callable? reducer) (fail "collection reducer must be a function"))
    (managed-literal-unreduced (if (= (js-length initial) 0)
      (invoke IReduce "reduce" collection reducer) (invoke IReduce "reduce" collection reducer (aref initial 0)))))
  (defun reduceKV (&rest arguments)
    (unless (= (js-length arguments) 3) (fail "reduceKV requires a collection, reducer, and initial value"))
    (unless (callable? (aref arguments 1)) (fail "key/value reducer must be a function"))
    (managed-literal-unreduced (invoke IKVReduce "reduceKV" (aref arguments 0) (aref arguments 1) (aref arguments 2))))
  (defun dissoc (collection &rest keys)
    (let ((result collection) (index 0))
      (while (< index (js-length keys)) (setq result (invoke IMap "dissoc" result (aref keys index)) index (1+ index))) result))
  (defun disj (collection &rest values)
    (let ((result collection) (index 0))
      (while (< index (js-length values)) (setq result (invoke ISet "disj" result (aref values index)) index (1+ index))) result))
  (defun peek (&rest arguments)
    (unless (= (js-length arguments) 1) (fail "peek requires exactly one collection")) (invoke IStack "peek" (aref arguments 0)))
  (defun pop (&rest arguments)
    (unless (= (js-length arguments) 1) (fail "pop requires exactly one collection")) (invoke IStack "pop" (aref arguments 0)))
  (defun rseq (&rest arguments)
    (unless (= (js-length arguments) 1) (fail "rseq requires exactly one collection"))
    (checkedSequence (invoke IReversible "rseq" (aref arguments 0)) "IReversible/rseq must return null or an iterable sequence view"))
  (defun reduced (value) (managed-literal-reduced value))
  (defun isReduced (value) (managed-literal-is-reduced value))
  (defun unreduced (value) (managed-literal-unreduced value))
  (Object/defineProperty assoc "length" (js-object :value 3 :configurable t))
  (Object/defineProperty reduceKV "length" (js-object :value 3 :configurable t))
  (Object/defineProperty peek "length" (js-object :value 1 :configurable t))
  (Object/defineProperty pop "length" (js-object :value 1 :configurable t))
  (Object/defineProperty rseq "length" (js-object :value 1 :configurable t))
  (Object/defineProperty sequenceView "length" (js-object :value 1 :configurable t))
  (Object/defineProperty memoizedSequenceView "length" (js-object :value 1 :configurable t))
  (Object/defineProperty get "length" (js-object :value 2 :configurable t))
