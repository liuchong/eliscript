(module eliscript.managed-runtime-data-text
  (import "./identifier.mjs" EliscriptSymbol Keyword eliscriptSymbol identifierName identifierNamespace keyword qualifiedIdentifierName)
  (import "./map.mjs" EMPTY_MAP PersistentHashMap isPersistentHashMap)
  (import "./list.mjs" PersistentList)
  (import "./metadata.mjs" meta withMeta)
  (import "./queue.mjs" PersistentQueue persistentQueue)
  (import "./protocol.mjs" defineProtocol extendProtocolCategory extendProtocolType protocolMethod)
  (import "./set.mjs" EMPTY_SET PersistentHashSet)
  (import "./sorted.mjs" PersistentSortedMap PersistentSortedSet)
  (import "./transient.mjs" assocBang conjBang persistentBang transient)
  (import "./vector.mjs" EMPTY_VECTOR PersistentVector isPersistentVector)
  (import "../../stdlib/managed-literals.eli" literal-each)
  (import "../../stdlib/managed-literal-protocols.eli" managed-literal-register-protocol-role)

  (defconst number-pattern (js* "/^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/"))
  (defconst bigint-pattern (js* "/^-?(?:0|[1-9]\\d*)N$/"))
  (defconst unsafe-identifier (js* "/[\\s()[\\]{}\"';,@^`~\\\\]/u"))
  (defconst reserved-symbols (new globalThis/Set (js-array "nil" "true" "false" "undefined" "##NaN" "##Inf" "##-Inf")))
  (defconst IPrint (defineProtocol "IPrint" (js-array "print")))
  (managed-literal-register-protocol-role "data-text.IPrint" IPrint)
  (defconst dispatch-print (protocolMethod IPrint "print"))
  (defun fail (message) (throw (new globalThis/TypeError message)))
  (defun range-fail (message) (throw (new globalThis/RangeError message)))
  (defun truth (value) (funcall globalThis/Boolean value))
  (defun positive-option (options name fallback)
    (let* ((input (if (nullish? options) undefined (aref options name))) (value (if (nullish? input) fallback input)))
      (unless (and (Number/isSafeInteger value) (> value 0)) (fail (str name " must be a positive safe integer"))) value))
  (defun normalize-options (options)
    (if (nullish? options) (Object/freeze (js-object :maxDepth 256 :maxLength 16777216 :maxValues 1000000))
      (progn
        (when (or (not (= (js* "typeof options") "object")) (Array/isArray options)) (fail "data text options must be an object"))
        (Object/freeze (js-object :maxDepth (positive-option options "maxDepth" 256)
          :maxLength (positive-option options "maxLength" 16777216) :maxValues (positive-option options "maxValues" 1000000))))))
  (defun compare-text (left right) (if (< left right) -1 (if (> left right) 1 0)))
  (defun safe-part (value)
    (and (> (js-length value) 0) (not (js-call value :includes "/")) (not (js-call unsafe-identifier :test value))))
  (defun safe-bare (value symbol)
    (let ((namespace (identifierNamespace value)) (name (identifierName value)))
      (if (or (not (safe-part name)) (and (not (nil? namespace)) (not (safe-part namespace)))) false
        (let ((qualified (qualifiedIdentifierName value)))
          (or (not symbol) (and (not (js-call reserved-symbols :has qualified))
            (not (js-call number-pattern :test qualified)) (not (js-call bigint-pattern :test qualified))
            (not (js-call qualified :startsWith ":")) (not (js-call qualified :startsWith "#"))))))))
  (defun tagged-identifier (tag value)
    (let ((namespace (identifierNamespace value)))
      (str "#eliscript/" tag " [" (if (nil? namespace) "nil" (JSON/stringify namespace))
        " " (JSON/stringify (identifierName value)) "]")))
  (defun print-number (value)
    (cond ((Number/isNaN value) "##NaN") ((= value (get globalThis/Number :POSITIVE_INFINITY)) "##Inf")
      ((= value (get globalThis/Number :NEGATIVE_INFINITY)) "##-Inf")
      ((Object/is value -0.0) "0") (t (funcall globalThis/String value))))
  (defun print-keyword (value)
    (if (safe-bare value false) (str ":" (qualifiedIdentifierName value)) (tagged-identifier "keyword" value)))
  (defun print-symbol (value)
    (if (safe-bare value t) (qualifiedIdentifierName value) (tagged-identifier "symbol" value)))
  (defun iterable-array (value)
    (let ((out (js-array))) (literal-each value (lambda (item) (js-call out :push item))) out))
  (defun print-vector (value context)
    (str "[" (js-call (js-call (iterable-array value) :map (lambda (item) (js-call context :print item))) :join " ") "]"))
  (defun print-list (value context)
    (str "(" (js-call (js-call (iterable-array value) :map (lambda (item) (js-call context :print item))) :join " ") ")"))
  (defun object? (value)
    (or (and (not (nil? value)) (= (js* "typeof value") "object")) (= (js* "typeof value") "function")))
  (defun close-entry (iterator abrupt)
    (try
      (let ((close (get iterator :return)))
        (unless (nullish? close)
          (unless (= (value-type close) "function") (fail "iterator return must be callable"))
          (unless (object? (js-call close :call iterator)) (fail "iterator return must be an object"))))
      (catch error (unless abrupt (throw error)))))
  (defun entry-two (entry)
    (let* ((iterator (js-call entry (get globalThis/Symbol :iterator))) (next undefined)
           (done false) (first undefined) (second undefined))
      (unless (object? iterator) (fail "iterator must be an object"))
      (setq next (get iterator :next))
      (try
        (let ((step (js-call next :call iterator)))
          (unless (object? step) (fail "iterator result must be an object"))
          (setq done (truth (get step :done)))
          (unless done
            (setq first (get step :value))
            (setq step (js-call next :call iterator))
            (unless (object? step) (fail "iterator result must be an object"))
            (setq done (truth (get step :done)))
            (unless done (setq second (get step :value)))))
        (catch error (unless done (close-entry iterator t)) (throw error)))
      (unless done (close-entry iterator false)) (js-array first second)))
  (defun print-map (value context)
    (let ((entries (js-call (iterable-array value) :map (lambda (entry)
      (let ((pair (entry-two entry)))
        (js-object :key (js-call context :print (get pair 0)) :value (js-call context :print (get pair 1))))))))
      (js-call entries :sort (lambda (left right)
        (let ((order (compare-text (get left :key) (get right :key))))
          (if (= order 0) (compare-text (get left :value) (get right :value)) order))))
      (str "{" (js-call (js-call entries :map (lambda (entry) (str (get entry :key) " " (get entry :value)))) :join " ") "}")))
  (defun print-set (value context)
    (let ((items (js-call (iterable-array value) :map (lambda (item) (js-call context :print item)))))
      (js-call items :sort compare-text) (str "#{" (js-call items :join " ") "}")))
  (defun print-queue (value context)
    (str "#queue [" (js-call (js-call (iterable-array value) :map (lambda (item) (js-call context :print item))) :join " ") "]"))
  (extendProtocolCategory IPrint "null" (js-object :print (lambda () "nil")))
  (extendProtocolCategory IPrint "undefined" (js-object :print (lambda () "undefined")))
  (extendProtocolCategory IPrint "boolean" (js-object :print (lambda (value) (if (truth value) "true" "false"))))
  (extendProtocolCategory IPrint "number" (js-object :print print-number))
  (extendProtocolCategory IPrint "bigint" (js-object :print (lambda (value) (str value "N"))))
  (extendProtocolCategory IPrint "string" (js-object :print (lambda (value) (JSON/stringify value))))
  (extendProtocolType IPrint Keyword (js-object :print print-keyword))
  (extendProtocolType IPrint EliscriptSymbol (js-object :print print-symbol))
  (extendProtocolType IPrint PersistentList (js-object :print print-list))
  (extendProtocolType IPrint PersistentVector (js-object :print print-vector))
  (extendProtocolType IPrint PersistentHashMap (js-object :print print-map))
  (extendProtocolType IPrint PersistentHashSet (js-object :print print-set))
  (extendProtocolType IPrint PersistentSortedMap (js-object :print print-map))
  (extendProtocolType IPrint PersistentSortedSet (js-object :print print-set))
  (extendProtocolType IPrint PersistentQueue (js-object :print print-queue))
  (defun make-print-context (options)
    (let ((values 0) (render nil))
      (setq render (lambda (value depth)
        (when (> depth (get options :maxDepth)) (range-fail (str "data text exceeds maxDepth " (get options :maxDepth))))
        (setq values (1+ values))
        (when (> values (get options :maxValues)) (range-fail (str "data text exceeds maxValues " (get options :maxValues))))
        (let* ((context (Object/freeze (js-object :print (lambda (item) (funcall render item (1+ depth))))))
               (body (funcall dispatch-print value context)))
          (unless (= (js* "typeof body") "string") (fail "IPrint/print must return a string"))
          (let* ((metadata (meta value)) (result (if (nil? metadata) body (str "^" (funcall render metadata (1+ depth)) " " body))))
            (when (> (js-length result) (get options :maxLength)) (range-fail (str "data text exceeds maxLength " (get options :maxLength)))) result))))
      (lambda (value) (funcall render value 0))))
  (defun printValue (value &optional options) (funcall (make-print-context (normalize-options options)) value))

  (defconst DataTextError (funcall
    (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
    (lambda (self message source position)
      (let ((error (new globalThis/SyntaxError (str message " at " (get position :line) ":" (get position :column)))))
        (Object/setPrototypeOf error (Object/getPrototypeOf self))
        (put error :name "DataTextError") (put error :code "ELI-DATA-TEXT")
        (put error :offset (get position :index)) (put error :line (get position :line))
        (put error :column (get position :column)) (put error :sourceLength (js-length source)) error)) "DataTextError"))
  (Object/setPrototypeOf DataTextError globalThis/SyntaxError)
  (Object/setPrototypeOf (get DataTextError :prototype) (get globalThis/SyntaxError :prototype))
  (Object/defineProperty DataTextError "length" (js-object :value 3 :configurable t))
  (defun reader-position (reader) (js-object :index (get reader :index) :line (get reader :line) :column (get reader :column)))
  (defun reader-fail (reader message &rest optional-position)
    (let ((position (if (= (js-length optional-position) 0) undefined (get optional-position 0))))
      (throw (new DataTextError message (get reader :source) (if (undefined? position) (reader-position reader) position)))))
  (defun reader-peek (reader &optional ahead)
    (aref (get reader :source) (+ (get reader :index) (if (nil? ahead) 0 ahead))))
  (defun reader-advance (reader)
    (let ((code (js-call (get reader :source) :codePointAt (get reader :index))))
      (unless (undefined? code)
        (put reader :index (+ (get reader :index) (if (> code 65535) 2 1)))
        (if (= code 10) (progn (put reader :line (1+ (get reader :line))) (put reader :column 1))
          (put reader :column (1+ (get reader :column))))) code))
  (defun reader-skip (reader)
    (let ((done false))
      (while (and (not done) (< (get reader :index) (js-length (get reader :source))))
        (let ((character (reader-peek reader)))
          (cond ((or (js-call (js* "/\\s/u") :test character) (= character ",")) (reader-advance reader))
            ((= character ";")
              (while (and (< (get reader :index) (js-length (get reader :source))) (not (= (reader-peek reader) "\n")))
                (reader-advance reader)))
            (t (setq done t)))))))
  (defun delimiter? (character)
    (or (undefined? character) (js-call (js* "/[\\s,()[\\]{}\";^]/u") :test character)))
  (defun reader-token (reader start)
    (while (not (delimiter? (reader-peek reader))) (reader-advance reader))
    (let ((token (js-call (get reader :source) :slice (get start :index) (get reader :index))))
      (when (= (js-length token) 0) (reader-fail reader "expected token" start)) token))
  (defun reader-string (reader start)
    (reader-advance reader)
    (let ((escaped false) (done false) (result undefined))
      (while (and (not done) (< (get reader :index) (js-length (get reader :source))))
        (let ((character (reader-peek reader)))
          (when (and (not escaped) (= character "\n")) (reader-fail reader "newline in string literal" start))
          (reader-advance reader)
          (when (and (not escaped) (= character "\""))
            (let ((raw (js-call (get reader :source) :slice (get start :index) (get reader :index))))
              (setq result (try (JSON/parse raw) (catch error (reader-fail reader "invalid string escape" start))) done t)))
          (setq escaped (and (not escaped) (= character "\\")))
          (unless (= character "\\") (setq escaped false))))
      (unless done (reader-fail reader "unexpected end of string" start)) result))
  (defun reader-vector (reader depth start)
    (reader-advance reader)
    (let ((editable (transient EMPTY_VECTOR)) (done false))
      (while (not done)
        (reader-skip reader)
        (cond ((= (reader-peek reader) "]") (reader-advance reader) (setq done t))
          ((undefined? (reader-peek reader)) (reader-fail reader "unexpected end of vector" start))
          (t (conjBang editable (reader-value reader (1+ depth))))))
      (persistentBang editable)))
  (defun reader-list (reader depth start)
    (reader-advance reader)
    (let ((values (js-array)) (done false))
      (while (not done)
        (reader-skip reader)
        (cond ((= (reader-peek reader) ")") (reader-advance reader) (setq done t))
          ((undefined? (reader-peek reader)) (reader-fail reader "unexpected end of list" start))
          (t (js-call values :push (reader-value reader (1+ depth))))))
      (js-call PersistentList :from values)))
  (defun reader-map (reader depth start)
    (reader-advance reader)
    (let ((editable (transient EMPTY_MAP)) (seen EMPTY_MAP) (done false))
      (while (not done)
        (reader-skip reader)
        (cond ((= (reader-peek reader) "}") (reader-advance reader) (setq done t))
          ((undefined? (reader-peek reader)) (reader-fail reader "unexpected end of map" start))
          (t (let* ((position (reader-position reader)) (key (reader-value reader (1+ depth))))
            (reader-skip reader)
            (when (or (= (reader-peek reader) "}") (undefined? (reader-peek reader)))
              (reader-fail reader "map requires a value for every key" position))
            (let ((item (reader-value reader (1+ depth))))
              (when (js-call seen :has key) (reader-fail reader "duplicate map key" position))
              (setq seen (js-call seen :assoc key t)) (assocBang editable key item))))))
      (persistentBang editable)))
  (defun reader-set (reader depth start)
    (reader-advance reader)
    (let ((editable (transient EMPTY_SET)) (seen EMPTY_SET) (done false))
      (while (not done)
        (reader-skip reader)
        (cond ((= (reader-peek reader) "}") (reader-advance reader) (setq done t))
          ((undefined? (reader-peek reader)) (reader-fail reader "unexpected end of set" start))
          (t (let* ((position (reader-position reader)) (item (reader-value reader (1+ depth))))
            (when (js-call seen :has item) (reader-fail reader "duplicate set value" position))
            (setq seen (js-call seen :conj item)) (conjBang editable item)))))
      (persistentBang editable)))
  (defun reader-tagged-identifier (reader tag depth start)
    (reader-skip reader)
    (let ((payload (reader-value reader (1+ depth))))
      (unless (and (isPersistentVector payload) (= (get payload :count) 2))
        (reader-fail reader (str tag " tag requires [namespace name]") start))
      (let ((namespace (js-call payload :nth 0)) (name (js-call payload :nth 1)))
        (unless (and (or (nil? namespace) (= (js* "typeof namespace") "string")) (= (js* "typeof name") "string"))
          (reader-fail reader (str tag " tag requires a nil/string namespace and string name") start))
        (try (if (= tag "keyword") (keyword namespace name) (eliscriptSymbol namespace name))
          (catch error (reader-fail reader (get error :message) start))))))
  (defun reader-tagged-queue (reader depth start)
    (reader-skip reader)
    (let ((payload (reader-value reader (1+ depth))))
      (unless (isPersistentVector payload) (reader-fail reader "queue tag requires a vector" start))
      (apply persistentQueue (iterable-array payload))))
  (defun reader-dispatch (reader depth start)
    (if (= (reader-peek reader 1) "{") (progn (reader-advance reader) (reader-set reader depth start))
      (let ((token (reader-token reader start)))
        (cond ((= token "##NaN") (get globalThis/Number :NaN))
          ((= token "##Inf") (get globalThis/Number :POSITIVE_INFINITY))
          ((= token "##-Inf") (get globalThis/Number :NEGATIVE_INFINITY))
          ((= token "#eliscript/keyword") (reader-tagged-identifier reader "keyword" depth start))
          ((= token "#eliscript/symbol") (reader-tagged-identifier reader "symbol" depth start))
          ((= token "#queue") (reader-tagged-queue reader depth start))
          (t (reader-fail reader (str "unknown dispatch " token) start))))))
  (defun reader-atom (reader start)
    (let ((token (reader-token reader start)))
      (cond ((= token "nil") nil) ((= token "true") t) ((= token "false") false) ((= token "undefined") undefined)
        ((js-call bigint-pattern :test token) (funcall globalThis/BigInt (js-call token :slice 0 -1)))
        ((js-call number-pattern :test token) (funcall globalThis/Number token))
        (t (try (if (js-call token :startsWith ":") (keyword (js-call token :slice 1)) (eliscriptSymbol token))
          (catch error (reader-fail reader (get error :message) start)))))))
  (defun reader-metadata (reader depth start)
    (reader-advance reader)
    (let ((metadata (reader-value reader (1+ depth))))
      (unless (isPersistentHashMap metadata) (reader-fail reader "metadata prefix requires a persistent map" start))
      (let ((value (reader-value reader (1+ depth))))
        (try (withMeta value metadata) (catch error (reader-fail reader (get error :message) start))))))
  (defun reader-value (reader depth)
    (reader-skip reader)
    (let* ((start (reader-position reader)) (options (get reader :options)))
      (when (> depth (get options :maxDepth)) (reader-fail reader (str "data text exceeds maxDepth " (get options :maxDepth)) start))
      (put reader :values (1+ (get reader :values)))
      (when (> (get reader :values) (get options :maxValues)) (reader-fail reader (str "data text exceeds maxValues " (get options :maxValues)) start))
      (let ((character (reader-peek reader)))
        (cond ((undefined? character) (reader-fail reader "unexpected end of input" start))
          ((= character "\"") (reader-string reader start)) ((= character "(") (reader-list reader depth start))
          ((= character "[") (reader-vector reader depth start)) ((= character "{") (reader-map reader depth start))
          ((= character "#") (reader-dispatch reader depth start)) ((= character "^") (reader-metadata reader depth start))
          ((js-call "]})" :includes character) (reader-fail reader (str "unexpected closing delimiter " character) start))
          (t (reader-atom reader start))))))
  (defun make-reader (source options)
    (unless (= (js* "typeof source") "string") (fail "data text source must be a string"))
    (let ((normalized (normalize-options options)))
      (when (> (js-length source) (get normalized :maxLength)) (range-fail (str "data text exceeds maxLength " (get normalized :maxLength))))
      (js-object :source source :options normalized :index 0 :line 1 :column 1 :values 0)))
  (defun readValue (source &optional options)
    (let* ((reader (make-reader source options)) (value (reader-value reader 0)))
      (reader-skip reader)
      (unless (= (get reader :index) (js-length source)) (reader-fail reader "trailing data after value" (reader-position reader))) value))
  (defun readValues (source &optional options)
    (let ((reader (make-reader source options)) (values (js-array)))
      (reader-skip reader)
      (while (< (get reader :index) (js-length source))
        (js-call values :push (reader-value reader 0)) (reader-skip reader)) (Object/freeze values)))
  (export IPrint printValue DataTextError readValue readValues))
