(module eliscript.persistent-map
  (defconst persistent-map-kind "eliscript/persistent-map")
  (defconst persistent-map-entry-kind "entry")
  (defconst persistent-map-bitmap-kind "bitmap")
  (defconst persistent-map-array-kind "array")
  (defconst persistent-map-collision-kind "collision")
  (defconst persistent-map-branch-bits 5)
  (defconst persistent-map-branch-width 32)
  (defconst persistent-map-branch-mask 31)
  (defconst persistent-map-array-threshold 32)
  (defconst persistent-map-bitmap-threshold 24)
  (defconst persistent-map-max-count 2147483647)

  (defportable persistent-map-array-reverse (values)
    ;; Read original getters in ascending order, then materialize the private
    ;; linked snapshot without copying a growing array at every element.
    (let ((pending nil) (index 0))
      (while (< index (js-length values))
        (setq pending (js-object :value (get values index) :next pending)
              index (1+ index)))
      (__eliscript_array_build index
        (lambda (_index)
          (let ((value (get pending "value")))
            (setq pending (get pending "next")) value)))))


  (defportable persistent-map-array-copy-assoc (values wanted-index value)
    (let ((length (js-length values)))
      (cond
        ((and (= length 0) (= wanted-index 0)) (js-array value))
        ((and (= length 1) (= wanted-index 0)) (js-array value))
        ((and (= length 1) (= wanted-index 1)) (js-array (get values 0) value))
        ((and (= length 2) (= wanted-index 0)) (js-array value (get values 1)))
        ((and (= length 2) (= wanted-index 1)) (js-array (get values 0) value))
        ((and (= length 2) (= wanted-index 2)) (js-array (get values 0) (get values 1) value))
        (t (__eliscript_array_copy_assoc
             (if (< wanted-index length) length (1+ wanted-index))
             values wanted-index value)))))


  (defportable persistent-map-array-insert (values wanted-index value)
    (let* ((length (js-length values))
           (insert (and (>= wanted-index 0) (<= wanted-index length) (= wanted-index (int32 wanted-index)))))
      (if (not insert)
          (if (= length 0)
              (js-array)
            (__eliscript_array_copy_assoc length values 0 (get values 0)))
        (cond
          ((= length 0) (js-array value))
          ((= length 1)
           (if (= wanted-index 0)
               (js-array value (get values 0))
             (js-array (get values 0) value)))
          ((= length 2)
           (cond
             ((= wanted-index 0) (js-array value (get values 0) (get values 1)))
             ((= wanted-index 1) (js-array (get values 0) value (get values 1)))
             (t (js-array (get values 0) (get values 1) value))))
          ((= length 3)
           (cond
             ((= wanted-index 0) (js-array value (get values 0) (get values 1) (get values 2)))
             ((= wanted-index 1) (js-array (get values 0) value (get values 1) (get values 2)))
             ((= wanted-index 2) (js-array (get values 0) (get values 1) value (get values 2)))
             (t (js-array (get values 0) (get values 1) (get values 2) value))))
          (t
           (__eliscript_array_build (1+ length)
             (lambda (index)
               (if (= index wanted-index)
                   value
                 (get values (if (< index wanted-index) index (1- index)))))))))))


  (defportable persistent-map-array-remove (values wanted-index)
    (let* ((length (js-length values))
           (remove (and (>= wanted-index 0) (< wanted-index length) (= wanted-index (int32 wanted-index)))))
      (if (not remove)
          (if (= length 0)
              (js-array)
            (__eliscript_array_copy_assoc length values 0 (get values 0)))
        (cond
          ((<= length 1) (js-array))
          ((= length 2) (js-array (get values (if (= wanted-index 0) 1 0))))
          ((= length 3)
           (cond
             ((= wanted-index 0) (js-array (get values 1) (get values 2)))
             ((= wanted-index 1) (js-array (get values 0) (get values 2)))
             (t (js-array (get values 0) (get values 1)))))
          (t
           (__eliscript_array_build (1- length)
             (lambda (index)
               (get values (if (>= index wanted-index) (1+ index) index)))))))))


  (defportable persistent-map-array-append (values value)
    (persistent-map-array-copy-assoc values (js-length values) value))

  (defportable persistent-map-bit-count (value)
    (let* ((bits (uint32 value))
           (pairs
            (- bits
               (bit-and
                (unsigned-bit-shift-right bits 1)
                1431655765)))
           (quads
            (+ (bit-and pairs 858993459)
               (bit-and
                (unsigned-bit-shift-right pairs 2)
                858993459)))
           (octets
            (bit-and
             (+ quads (unsigned-bit-shift-right quads 4))
             252645135)))
      (unsigned-bit-shift-right
       (imul32 octets 16843009)
       24)))

  (defportable persistent-map-branch-index (hash shift)
    (bit-and
     (unsigned-bit-shift-right hash shift)
     persistent-map-branch-mask))

  (defportable persistent-map-bit-position (hash shift)
    (uint32
     (bit-shift-left 1 (persistent-map-branch-index hash shift))))

  (defportable persistent-map-packed-index (bitmap bit)
    (persistent-map-bit-count (bit-and bitmap (1- bit))))

  (defportable persistent-map-make-entry (hash key value)
    (js-object :kind persistent-map-entry-kind
            :hash hash
            :key key
            :value value))

  (defportable persistent-map-make-bitmap-node (bitmap items)
    (js-object :kind persistent-map-bitmap-kind
            :bitmap (uint32 bitmap)
            :items items))

  (defportable persistent-map-make-array-node (count children)
    (js-object :kind persistent-map-array-kind
            :count count
            :children children))

  (defportable persistent-map-make-collision-node (hash entries)
    (js-object :kind persistent-map-collision-kind
            :hash hash
            :entries entries))

  (defconst persistent-map-missing (js-object))

  (defportable persistent-map-item-kind (item)
    (get item "kind" nil))

  (defportable persistent-map-entry? (item)
    (= (persistent-map-item-kind item) persistent-map-entry-kind))

  (defportable persistent-map-same-entry?
      (entry hash key key-equal-function)
    (and (= (get entry "hash") hash)
         (funcall key-equal-function (get entry "key") key)))

  (defportable persistent-map-merge-entries (shift left right)
    (let ((left-hash (get left "hash"))
          (right-hash (get right "hash")))
      (if (= left-hash right-hash)
          (js-object :kind persistent-map-collision-kind
                  :hash left-hash
                  :entries (js-array left right))
        (let* ((left-index
                (bit-and (unsigned-bit-shift-right left-hash shift) persistent-map-branch-mask))
               (right-index
                (bit-and (unsigned-bit-shift-right right-hash shift) persistent-map-branch-mask)))
          (if (= left-index right-index)
              (js-object :kind persistent-map-bitmap-kind
                      :bitmap (uint32 (bit-shift-left 1 left-index))
                      :items (js-array (persistent-map-merge-entries
                        (+ shift persistent-map-branch-bits)
                        left
                        right)))
            (js-object :kind persistent-map-bitmap-kind
                    :bitmap (uint32
                             (bit-or
                              (uint32 (bit-shift-left 1 left-index))
                              (uint32 (bit-shift-left 1 right-index))))
                    :items (if (< left-index right-index)
                               (js-array left right)
                             (js-array right left))))))))

  (defportable persistent-map-merge-hash-node-entry
      (shift node node-hash entry)
    (let ((node-index (bit-and (unsigned-bit-shift-right node-hash shift) persistent-map-branch-mask))
          (entry-index
           (bit-and (unsigned-bit-shift-right (get entry "hash") shift) persistent-map-branch-mask)))
      (if (= node-index entry-index)
          (js-object :kind persistent-map-bitmap-kind
                  :bitmap (uint32 (bit-shift-left 1 node-index))
                  :items (js-array (persistent-map-merge-hash-node-entry
                    (+ shift persistent-map-branch-bits)
                    node
                    node-hash
                    entry)))
        (js-object :kind persistent-map-bitmap-kind
                :bitmap (uint32
                         (bit-or
                          (uint32 (bit-shift-left 1 node-index))
                          (uint32 (bit-shift-left 1 entry-index))))
                :items (if (< node-index entry-index)
                           (js-array node entry)
                         (js-array entry node))))))

  (defportable persistent-map-promote-bitmap-node (node shift entry)
    (let* ((bitmap (get node "bitmap"))
           (items (get node "items"))
           (entry-index
            (bit-and (unsigned-bit-shift-right (get entry "hash") shift) persistent-map-branch-mask))
           (pos 0))
      (js-object :kind persistent-map-array-kind
              :count (1+ (js-length items))
              :children
              (__eliscript_array_build persistent-map-branch-width
                (lambda (index)
                  (let ((bit (uint32 (bit-shift-left 1 index))))
                    (if (/= (bit-and bitmap bit) 0)
                        (let ((child (js-nth pos items)))
                          (setq pos (1+ pos))
                          child)
                      (if (= index entry-index) entry nil))))))))

  (defportable persistent-map-pack-array-node (node)
    (let ((bitmap 0)
          (items (js-array))
          (children (get node "children"))
          (index 0))
      (while (< index persistent-map-branch-width)
        (let ((child (js-nth index children)))
          (when child
            (setq bitmap
                  (uint32 (bit-or bitmap (bit-shift-left 1 index)))
                  items (js-cons child items))))
        (setq index (1+ index)))
      (persistent-map-make-bitmap-node
       bitmap
       (persistent-map-array-reverse items))))

  (defportable persistent-map-assoc-entry
      (entry shift hash key value key-equal-function value-equal-function)
    (if (persistent-map-same-entry? entry hash key key-equal-function)
        (if (funcall value-equal-function
                     (get entry "value")
                     value)
            nil
          (js-array
           (persistent-map-make-entry
            hash
            (get entry "key")
            value)))
      (persistent-map-merge-entries
       shift
       entry
       (persistent-map-make-entry hash key value))))

  (defportable persistent-map-assoc-item
      (item shift hash key value key-equal-function value-equal-function)
    (let ((kind (get item "kind" nil)))
      (if (= kind persistent-map-entry-kind)
          (if (and (= (get item "hash") hash)
                   (funcall key-equal-function (get item "key") key))
              (if (funcall value-equal-function (get item "value") value)
                  nil
                (js-array
                 (js-object :kind persistent-map-entry-kind
                         :hash hash
                         :key (get item "key")
                         :value value)))
            (persistent-map-merge-entries
             shift
             item
             (js-object :kind persistent-map-entry-kind :hash hash :key key :value value)))
        (if (= kind persistent-map-bitmap-kind)
            (let* ((bidx (bit-and (unsigned-bit-shift-right hash shift) persistent-map-branch-mask))
                   (bit (uint32 (bit-shift-left 1 bidx)))
                   (bitmap (get item "bitmap"))
                   (items (get item "items"))
                   (bits (uint32 (bit-and bitmap (1- bit))))
                   (pairs (- bits (bit-and (unsigned-bit-shift-right bits 1) 1431655765)))
                   (quads (+ (bit-and pairs 858993459) (bit-and (unsigned-bit-shift-right pairs 2) 858993459)))
                   (octets (bit-and (+ quads (unsigned-bit-shift-right quads 4)) 252645135))
                   (index (unsigned-bit-shift-right (imul32 octets 16843009) 24)))
              (if (= (bit-and bitmap bit) 0)
                  (let ((new-entry (js-object :kind persistent-map-entry-kind :hash hash :key key :value value))
                        (len (js-length items)))
                    (if (>= (1+ len) persistent-map-array-threshold)
                        (persistent-map-promote-bitmap-node item shift new-entry)
                      (js-object :kind persistent-map-bitmap-kind
                              :bitmap (uint32 (bit-or bitmap bit))
                              :items (__eliscript_array_build (1+ len)
                                       (lambda (j)
                                         (if (= j index)
                                             new-entry
                                           (get items (if (< j index) j (1- j)))))))))
                (let* ((existing (js-nth index items))
                       (result
                        (persistent-map-assoc-item
                         existing
                         (+ shift persistent-map-branch-bits)
                         hash
                         key
                         value
                         key-equal-function
                         value-equal-function)))
                  (if (nil? result)
                      nil
                    (let* ((replaced (nil? (get result :kind nil)))
                           (child (if replaced (js-nth 0 result) result))
                           (node
                            (js-object :kind persistent-map-bitmap-kind
                                    :bitmap bitmap
                                    :items (__eliscript_array_copy_assoc (js-length items) items index child))))
                      (if replaced (js-array node) node))))))
          (if (= kind persistent-map-array-kind)
              (let* ((index (bit-and (unsigned-bit-shift-right hash shift) persistent-map-branch-mask))
                     (children (get item "children"))
                     (existing (js-nth index children)))
                (if (nil? existing)
                    (js-object :kind persistent-map-array-kind
                            :count (1+ (get item "count"))
                            :children (__eliscript_array_copy_assoc persistent-map-branch-width children index
                                        (js-object :kind persistent-map-entry-kind :hash hash :key key :value value)))
                  (let ((result
                         (persistent-map-assoc-item
                          existing
                          (+ shift persistent-map-branch-bits)
                          hash
                          key
                          value
                          key-equal-function
                          value-equal-function)))
                    (if (nil? result)
                        nil
                      (let* ((replaced (nil? (get result :kind nil)))
                             (node
                              (js-object :kind persistent-map-array-kind
                                      :count (get item "count")
                                      :children (__eliscript_array_copy_assoc persistent-map-branch-width children index
                                                  (if replaced (js-nth 0 result) result)))))
                        (if replaced (js-array node) node))))))
            (let ((node-hash (get item "hash")))
              (if (/= node-hash hash)
                  (persistent-map-merge-hash-node-entry
                   shift
                   item
                   node-hash
                   (js-object :kind persistent-map-entry-kind :hash hash :key key :value value))
                (let ((entries (get item "entries"))
                      (index 0)
                      (found-index -1))
                  (while (and (< index (js-length entries))
                              (< found-index 0))
                    (when (funcall
                           key-equal-function
                           (get (js-nth index entries) "key")
                           key)
                      (setq found-index index))
                    (setq index (1+ index)))
                  (if (>= found-index 0)
                      (let ((existing (js-nth found-index entries)))
                        (if (funcall
                             value-equal-function
                             (get existing "value")
                             value)
                            nil
                          (js-array
                           (js-object :kind persistent-map-collision-kind
                                   :hash hash
                                   :entries (persistent-map-array-copy-assoc
                                             entries
                                             found-index
                                             (js-object :kind persistent-map-entry-kind
                                                     :hash hash
                                                     :key (get existing "key")
                                                     :value value))))))
                    (js-object :kind persistent-map-collision-kind
                            :hash hash
                            :entries (persistent-map-array-append
                                      entries
                                      (js-object :kind persistent-map-entry-kind :hash hash :key key :value value))))))))))))

  (defportable persistent-map-remove-bitmap-item (node bit index)
    (let* ((items
            (persistent-map-array-remove
             (get node "items")
             index))
           (bitmap
            (uint32
             (bit-and (get node "bitmap") (bit-not bit)))))
      (if (= (js-length items) 0)
          nil
        (persistent-map-make-bitmap-node bitmap items))))

  (defportable persistent-map-dissoc-item
      (item shift hash key key-equal-function)
    (let ((kind (get item "kind" nil)))
      (if (= kind persistent-map-entry-kind)
          (if (persistent-map-same-entry?
               item hash key key-equal-function)
              nil
            item)
        (if (= kind persistent-map-bitmap-kind)
            (let* ((bit (persistent-map-bit-position hash shift))
                   (bitmap (get item "bitmap")))
              (if (= (bit-and bitmap bit) 0)
                  item
                (let* ((index
                        (persistent-map-packed-index bitmap bit))
                       (items (get item "items"))
                       (existing (js-nth index items))
                       (next-item
                        (persistent-map-dissoc-item
                         existing
                         (+ shift persistent-map-branch-bits)
                         hash
                         key
                         key-equal-function)))
                  (if (= next-item existing)
                      item
                    (if (nil? next-item)
                        (persistent-map-remove-bitmap-item
                         item bit index)
                      (persistent-map-make-bitmap-node
                       bitmap
                       (persistent-map-array-copy-assoc
                        items index next-item)))))))
          (if (= kind persistent-map-array-kind)
              (let* ((index (persistent-map-branch-index hash shift))
                     (children (get item "children"))
                     (existing (js-nth index children)))
                (if (nil? existing)
                    item
                  (let ((next-item
                         (persistent-map-dissoc-item
                          existing
                          (+ shift persistent-map-branch-bits)
                          hash
                          key
                          key-equal-function)))
                    (if (= next-item existing)
                        item
                      (let* ((next-count
                              (if (nil? next-item)
                                  (1- (get item "count"))
                                (get item "count")))
                             (next-node
                              (persistent-map-make-array-node
                               next-count
                               (persistent-map-array-copy-assoc
                                children index next-item))))
                        (if (<= next-count
                                persistent-map-bitmap-threshold)
                            (persistent-map-pack-array-node next-node)
                          next-node))))))
            (if (/= (get item "hash") hash)
                item
              (let ((entries (get item "entries"))
                    (index 0)
                    (found-index -1))
                (while (and (< index (js-length entries))
                            (< found-index 0))
                  (when (funcall
                         key-equal-function
                         (get (js-nth index entries) "key")
                         key)
                    (setq found-index index))
                  (setq index (1+ index)))
                (if (< found-index 0)
                    item
                  (if (= (js-length entries) 2)
                      (js-nth (if (= found-index 0) 1 0) entries)
                    (persistent-map-make-collision-node
                     hash
                     (persistent-map-array-remove entries found-index)))))))))))

  (defportable persistent-map-lookup-item
      (item shift hash key key-equal-function)
    (let ((current item)
          (current-shift shift)
          (finished false)
          (result persistent-map-missing))
      (while (and current (not finished))
        (let ((kind (get current "kind" nil)))
          (if (= kind persistent-map-entry-kind)
              (progn
                (when (and (= (get current "hash") hash)
                           (funcall key-equal-function (get current "key") key))
                  (setq result (get current "value")))
                (setq finished t))
            (if (= kind persistent-map-bitmap-kind)
                (let* ((bidx (bit-and (unsigned-bit-shift-right hash current-shift) persistent-map-branch-mask))
                       (bit (uint32 (bit-shift-left 1 bidx)))
                       (bitmap (get current "bitmap")))
                  (if (= (bit-and bitmap bit) 0)
                      (setq finished t)
                    (let* ((bits (uint32 (bit-and bitmap (1- bit))))
                           (pairs (- bits (bit-and (unsigned-bit-shift-right bits 1) 1431655765)))
                           (quads (+ (bit-and pairs 858993459) (bit-and (unsigned-bit-shift-right pairs 2) 858993459)))
                           (octets (bit-and (+ quads (unsigned-bit-shift-right quads 4)) 252645135))
                           (packed (unsigned-bit-shift-right (imul32 octets 16843009) 24)))
                      (setq current (js-nth packed (get current "items"))
                            current-shift (+ current-shift persistent-map-branch-bits)))))
              (if (= kind persistent-map-array-kind)
                  (let ((child
                         (js-nth
                          (bit-and (unsigned-bit-shift-right hash current-shift) persistent-map-branch-mask)
                          (get current "children"))))
                    (if (nil? child)
                        (setq finished t)
                      (setq current child
                            current-shift
                            (+ current-shift
                               persistent-map-branch-bits))))
                (progn
                  (when (= (get current "hash") hash)
                    (let ((entries (get current "entries"))
                          (index 0)
                          (done false))
                      (while (and (< index (js-length entries)) (not done))
                        (let ((entry (js-nth index entries)))
                          (when (funcall
                                 key-equal-function
                                 (get entry "key")
                                 key)
                            (setq result (get entry "value")
                                  done t)))
                        (setq index (1+ index)))))
                  (setq finished t)))))))
      result))

  (defportable persistent-map-reduce-item (function initial item)
    (let ((kind (persistent-map-item-kind item)))
      (if (= kind persistent-map-entry-kind)
          (funcall function
                   initial
                   (get item "key")
                   (get item "value"))
        (let ((result initial)
              (index 0)
              (children
               (if (= kind persistent-map-bitmap-kind)
                   (get item "items")
                 (if (= kind persistent-map-array-kind)
                     (get item "children")
                   (get item "entries")))))
          (while (< index (js-length children))
            (let ((child (js-nth index children)))
              (when child
                (setq result
                      (persistent-map-reduce-item
                       function result child))))
            (setq index (1+ index)))
          result))))

  (defportable persistent-map-make-fns (count root fns metadata)
    (if (nil? metadata)
        (js-object :kind persistent-map-kind
                :count count
                :root root
                :fns fns)
      (js-object :kind persistent-map-kind
              :count count
              :root root
              :fns fns
              :metadata metadata)))

  (defportable persistent-map-make
      (count root hash-function key-equal-function value-equal-function metadata)
    (persistent-map-make-fns
     count
     root
     (js-array hash-function key-equal-function value-equal-function)
     metadata))

  (defportable empty-persistent-map
      (hash-function key-equal-function value-equal-function)
    (persistent-map-make
     0 nil hash-function key-equal-function value-equal-function nil))

  (defportable persistent-map? (value)
    (and (not (nullish? value))
         (object-has? value "kind")
         (= (get value "kind" nil) persistent-map-kind)))

  (defportable persistent-map-count (map)
    (get map "count"))

  (defportable persistent-map-meta (map)
    (get map "metadata" nil))

  (defportable persistent-map-with-meta (map metadata)
    (if (= metadata (persistent-map-meta map))
        map
      (persistent-map-make-fns
       (persistent-map-count map)
       (get map "root")
       (get map "fns")
       metadata)))

  (defportable persistent-map-has? (map key)
    (let ((root (get map "root")))
      (if (nil? root)
          false
        (let ((fns (get map "fns")))
          (/= (persistent-map-lookup-item
               root
               0
               (uint32 (funcall (get fns 0) key))
               key
               (get fns 1))
              persistent-map-missing)))))

  (defportable persistent-map-get (map key not-found)
    (let ((root (get map "root")))
      (if (nil? root)
          not-found
        (let* ((fns (get map "fns"))
               (found
                (persistent-map-lookup-item
                 root
                 0
                 (uint32 (funcall (get fns 0) key))
                 key
                 (get fns 1))))
          (if (= found persistent-map-missing)
              not-found
            found)))))

  (defportable persistent-map-assoc (map key value)
    (let* ((root (get map "root"))
           (fns (get map "fns"))
           (hash-function (get fns 0))
           (key-equal-function (get fns 1))
           (value-equal-function (get fns 2))
           (hash (uint32 (funcall hash-function key)))
           (metadata (get map "metadata" nil)))
      (if (nil? root)
          (let ((first-entry (js-object :kind persistent-map-entry-kind :hash hash :key key :value value)))
            (if (nil? metadata)
                (js-object :kind persistent-map-kind :count 1 :root first-entry :fns fns)
              (js-object :kind persistent-map-kind :count 1 :root first-entry :fns fns :metadata metadata)))
        (let ((result
               (persistent-map-assoc-item
                root
                0
                hash
                key
                value
                key-equal-function
                value-equal-function)))
          (if (nil? result)
              map
            (let* ((count (get map "count"))
                   (replaced (nil? (get result :kind nil)))
                   (added (not replaced))
                   (next-root (if replaced (js-nth 0 result) result))
                   (next-count (if added (1+ count) count)))
              (if (and added (>= count persistent-map-max-count))
                  nil
                (if (nil? metadata)
                    (js-object :kind persistent-map-kind :count next-count :root next-root :fns fns)
                  (js-object :kind persistent-map-kind :count next-count :root next-root :fns fns :metadata metadata)))))))))

  (defportable persistent-map-dissoc (map key)
    (let ((root (get map "root")))
      (if (nil? root)
          map
        (let* ((fns (get map "fns"))
               (hash-function (get fns 0))
               (key-equal-function (get fns 1))
               (next-root
                (persistent-map-dissoc-item
                 root
                 0
                 (uint32 (funcall hash-function key))
                 key
                 key-equal-function)))
          (if (= next-root root)
              map
            (persistent-map-make-fns
             (1- (persistent-map-count map))
             next-root
             fns
             (persistent-map-meta map)))))))

  (defportable persistent-map-reduce (function initial map)
    (let ((root (get map "root")))
      (if (nil? root)
          initial
        (persistent-map-reduce-item function initial root))))

  (defportable persistent-map-to-entries (map)
    (let ((pending (persistent-map-reduce
            (lambda (result key value) (js-object :value (js-array key value) :next result)) nil map))
          (ordered nil))
      (while (not (nil? pending))
        (setq ordered (js-object :value (get pending "value") :next ordered)
              pending (get pending "next")))
      (__eliscript_array_build (persistent-map-count map)
        (lambda (_index)
          (let ((value (get ordered "value")))
            (setq ordered (get ordered "next")) value)))))


  (defportable persistent-map-from-entries
      (hash-function key-equal-function value-equal-function entries)
    (let ((result
           (empty-persistent-map
            hash-function key-equal-function value-equal-function))
          (index 0))
      (while (< index (js-length entries))
        (let ((entry (get entries index)))
          (setq result
                (persistent-map-assoc
                 result
                 (get entry 0)
                 (get entry 1))))
        (setq index (1+ index)))
      result))

  (export empty-persistent-map
          persistent-map?
          persistent-map-count
          persistent-map-meta
          persistent-map-with-meta
          persistent-map-has?
          persistent-map-get
          persistent-map-assoc
          persistent-map-dissoc
          persistent-map-reduce
          persistent-map-to-entries
          persistent-map-from-entries))
