{
  "schemaVersion": 1,
  "format": "eliscript-repository-integrity",
  "version": 1,
  "packageManifest": "package.json",
  "lockfile": "bun.lock",
  "packages": [
    {
      "name": "@vitejs/plugin-react",
      "version": "6.1.0",
      "section": "devDependencies",
      "allowedRoots": ["examples/"]
    },
    {
      "name": "react",
      "version": "19.2.8",
      "section": "devDependencies",
      "allowedRoots": ["examples/"]
    },
    {
      "name": "react-dom",
      "version": "19.2.8",
      "section": "devDependencies",
      "allowedRoots": ["examples/"]
    },
    {
      "name": "vite",
      "version": "8.2.2",
      "section": "devDependencies",
      "allowedRoots": ["examples/", "tests/"]
    }
  ],
  "imports": {
    "eliscriptSourceRoots": ["bootstrap/compiler/", "examples/", "stdlib/"],
    "localPackageRoots": ["tests/fixtures/packages/"],
    "coreRoots": [
      "bin/",
      "bootstrap/",
      "compiler/",
      "editor/",
      "platform/",
      "runtime/",
      "stdlib/"
    ],
    "specialSpecifiers": [
      {
        "specifier": "bun",
        "allowedRoots": ["tests/"]
      },
      {
        "specifier": "bun:test",
        "allowedRoots": ["tests/"]
      },
      {
        "prefix": "eliscript/",
        "allowedRoots": ["examples/", "tests/"]
      },
      {
        "prefix": "node:",
        "allowedRoots": [
          "bootstrap/host/",
          "examples/",
          "runtime/worker",
          "tests/",
          "tools/"
        ]
      },
      {
        "prefix": "virtual:",
        "allowedRoots": ["examples/org-site/"]
      }
    ]
  },
  "artifacts": {
    "generatedMarker": "// Generated by Eliscript. Do not edit.",
    "deterministic": [
      {
        "source": "stdlib/core/object.eli",
        "output": "runtime/core/object-impl.mjs",
        "sourceMap": "runtime/core/object-impl.mjs.map"
      },
      {
        "source": "stdlib/core/protocol.eli",
        "output": "runtime/core/protocol-impl.mjs",
        "sourceMap": "runtime/core/protocol-impl.mjs.map"
      },
      {
        "source": "stdlib/core/text.eli",
        "output": "runtime/core/text-impl.mjs",
        "sourceMap": "runtime/core/text-impl.mjs.map"
      },
      {
        "source": "tests/fixtures/core.eli",
        "output": "tests/snapshots/core.mjs"
      }
    ],
    "derived": [
      {
        "id": "compatibility-workflow",
        "outputs": [".github/workflows/compatibility.yml"]
      },
      {
        "id": "library-api",
        "outputs": ["docs/pages/api-index.json", "docs/pages/api.html"]
      }
    ],
    "benchmarkDirectory": "benchmarks/",
    "benchmarkReports": [
      "benchmarks/compiler-binary-comparison-macos-arm64.json",
      "benchmarks/compiler-indent-macos-arm64.json",
      "benchmarks/compiler-ir-kind-macos-arm64.json",
      "benchmarks/compiler-locate-macos-arm64.json",
      "benchmarks/compiler-reader-character-macos-arm64.json",
      "benchmarks/compiler-runtime-scan-macos-arm64.json",
      "benchmarks/compiler-source-map-cursor-macos-arm64.json",
      "benchmarks/core-performance-macos-arm64.json",
      "benchmarks/emacs-analysis-macos-arm64.json",
      "benchmarks/emacs-analysis-soak-macos-arm64.json",
      "benchmarks/hamt-layout-macos-arm64.json",
      "benchmarks/transient-builder-macos-arm64.json",
      "benchmarks/worker-lifecycle-soak-macos-arm64.json",
      "benchmarks/worker-value-stream-macos-arm64.json"
    ]
  }
}
