{
  "schemaVersion": 1,
  "format": "eliscript-documentation-contract",
  "version": 1,
  "guides": [
    {
      "id": "getting-started",
      "file": "docs/getting-started.md",
      "requiredSections": [
        "Supported Environment",
        "Install from a Checkout",
        "Create a Project",
        "Check Format Build and Run",
        "Unsaved Source and Diagnostics",
        "Terminal REPL",
        "Emacs Setup",
        "Project Watch",
        "Troubleshooting",
        "Verification Boundaries"
      ],
      "requiredLiterals": [
        "ELISCRIPT_JS_RUNTIME=node",
        "M-x eliscript-mode-stop-watch",
        "M-x eliscript-mode-watch-project",
        "bun install --frozen-lockfile",
        "bun run check:contracts",
        "bun run check:integrity",
        "bun run test",
        "eliscript-build --config eliscript.json",
        "eliscript-check --json --config eliscript.json",
        "eliscript-eval --repl --root",
        "eliscript-format --check",
        "eliscript-watch --config eliscript.json --json",
        "make byte-compile"
      ]
    }
  ],
  "entryPoints": [
    {
      "file": "README.md",
      "literal": "docs/getting-started.md"
    },
    {
      "file": "editor/README.md",
      "literal": "../docs/getting-started.md"
    },
    {
      "file": "examples/README.md",
      "literal": "getting-started/README.md"
    }
  ]
}
