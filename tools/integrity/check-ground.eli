(module tools.integrity.check-ground
  (import "node:crypto" createHash)
  (import "node:fs" existsSync realpathSync)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:module" createRequire)
  (import "node:os" tmpdir)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "../ci/render-workflow.mjs" checkCompatibilityWorkflow)
  (import "../ci/render-browser-workflow.mjs" checkBrowserCompatibilityWorkflow)
  (import "../surface/generate-api.mjs" generateApiArtifacts)

  (defun find-repo-root ()
    (let ((dir (js-call path :resolve (js-call process :cwd)))
          (done false))
      (while (not done)
        (if (existsSync (js-call path :join dir "contracts/repository-integrity.json"))
            (setq done t)
          (let ((parent (js-call path :dirname dir)))
            (if (= parent dir)
                (setq done t)
              (setq dir parent)))))
      dir))

  (defconst DEFAULT_ROOT (find-repo-root))
  (defconst CONTRACT_FILE "contracts/repository-integrity.json")
  (defconst PACKAGE_SECTIONS
    (Object/freeze (js-array "dependencies" "devDependencies" "optionalDependencies" "peerDependencies")))
  (defconst SEMVER_RE (new globalThis.RegExp "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"))
  (defconst SHA256_RE (new globalThis.RegExp "^[0-9a-f]{64}$"))
  (defconst SHEBANG_RE (new globalThis.RegExp "^#![^\\n]*\\n" "u"))

  (defun RepositoryIntegrityError (errors)
    (let* ((items (if (Array/isArray errors) errors (js-array (str errors))))
           (msg (+ "repository integrity validation failed:\n- " (js-call items :join "\n- ")))
           (inst (new globalThis.Error msg)))
      (put inst :name "RepositoryIntegrityError")
      (put inst :errors items)
      (Object/setPrototypeOf inst (get RepositoryIntegrityError :prototype))
      inst))
  (Object/setPrototypeOf (get RepositoryIntegrityError :prototype) (get globalThis.Error :prototype))
  (put (get RepositoryIntegrityError :prototype) :name "RepositoryIntegrityError")

  (defun nullish (value fallback)
    (if (or (eq value undefined) (eq value nil)) fallback value))

  (defun is-plain-object (value)
    (and (not (eq value nil))
         (not (eq value undefined))
         (= (value-type value) "object")
         (not (Array/isArray value))))

  (defun safe-relative-path (value)
    (and (= (value-type value) "string")
         (> (js-length value) 0)
         (not (js-call path :isAbsolute value))
         (not (js-call (js-call value :split "/") :includes ".."))
         (= (js-call (get path :posix) :normalize value) value)))

  (defun sorted-unique (values)
    (js-call (Array/from (new globalThis.Set values)) :sort))

  (defun valid-roots (roots)
    (and (Array/isArray roots)
         (> (js-length roots) 0)
         (js-call roots :every (lambda (root) (safe-relative-path root)))
         (= (JSON/stringify roots) (JSON/stringify (sorted-unique roots)))))

  (defun validateIntegrityContract (contract)
    (let ((errors (js-array)))
      (when (or (not (is-plain-object contract))
                (/= (get contract :schemaVersion) 1)
                (/= (get contract :format) "eliscript-repository-integrity")
                (/= (get contract :version) 1))
        (throw (new RepositoryIntegrityError
                    (js-array "contract must use eliscript-repository-integrity version 1"))))
      (unless (and (safe-relative-path (get contract :packageManifest))
                   (safe-relative-path (get contract :lockfile)))
        (js-call errors :push "package manifest and lockfile must be safe relative paths"))
      (let ((packages (if (Array/isArray (get contract :packages)) (get contract :packages) (js-array)))
            (package-names (js-array))
            (index 0))
        (when (or (not (Array/isArray (get contract :packages))) (= (js-length packages) 0))
          (js-call errors :push "packages must be a non-empty array"))
        (while (< index (js-length packages))
          (let ((entry (aref packages index))
                (label (+ "package " index)))
            (if (not (is-plain-object entry))
                (js-call errors :push (+ label " must be an object"))
              (progn
                (js-call package-names :push (get entry :name))
                (when (or (/= (value-type (get entry :name)) "string") (= (js-length (get entry :name)) 0))
                  (js-call errors :push (+ label " must declare a name")))
                (unless (js-call SEMVER_RE :test (nullish (get entry :version) ""))
                  (js-call errors :push (+ label " must pin an exact semantic version")))
                (unless (js-call PACKAGE_SECTIONS :includes (get entry :section))
                  (js-call errors :push (+ label " has unsupported package section " (get entry :section))))
                (unless (valid-roots (get entry :allowedRoots))
                  (js-call errors :push (+ label " allowedRoots must be unique sorted path prefixes"))))))
          (setq index (1+ index)))
        (unless (= (JSON/stringify package-names) (JSON/stringify (sorted-unique package-names)))
          (js-call errors :push "package names must be unique and sorted")))
      (let ((imports (get contract :imports)))
        (unless (and (is-plain-object imports)
                     (valid-roots (get imports :eliscriptSourceRoots))
                     (valid-roots (get imports :coreRoots))
                     (valid-roots (get imports :localPackageRoots)))
          (js-call errors :push
                   "import source, core, and local package roots must be unique sorted path prefixes"))
        (let ((special (if (and (is-plain-object imports) (Array/isArray (get imports :specialSpecifiers)))
                           (get imports :specialSpecifiers)
                         (js-array)))
              (selectors (js-array))
              (index 0))
          (while (< index (js-length special))
            (let* ((entry (aref special index))
                   (has-spec (and (is-plain-object entry) (= (value-type (get entry :specifier)) "string")))
                   (has-pref (and (is-plain-object entry) (= (value-type (get entry :prefix)) "string")))
                   (selector-count (+ (if has-spec 1 0) (if has-pref 1 0))))
              (if (or (not (is-plain-object entry))
                      (/= selector-count 1)
                      (not (valid-roots (get entry :allowedRoots))))
                  (js-call errors :push
                           (+ "special import " index " must have one selector and sorted allowed roots"))
                (let ((selector (nullish (get entry :specifier) (get entry :prefix))))
                  (when (= (js-length selector) 0)
                    (js-call errors :push (+ "special import " index " selector must not be empty")))
                  (js-call selectors :push (+ (if has-spec "=" "^") selector)))))
            (setq index (1+ index)))
          (when (or (= (js-length selectors) 0)
                    (/= (JSON/stringify selectors) (JSON/stringify (sorted-unique selectors))))
            (js-call errors :push "special import selectors must be non-empty unique and sorted"))))
      (let ((artifacts (get contract :artifacts)))
        (unless (and (is-plain-object artifacts)
                     (= (get artifacts :generatedMarker) "// Generated by Eliscript. Do not edit.")
                     (= (get artifacts :benchmarkDirectory) "benchmarks/"))
          (js-call errors :push "artifact roots and generated marker do not match the contract"))
        (let ((bench-reports (if (is-plain-object artifacts) (get artifacts :benchmarkReports) undefined)))
          (when (or (not (Array/isArray bench-reports))
                    (= (js-length bench-reports) 0)
                    (js-call bench-reports :some
                             (lambda (file)
                               (or (not (safe-relative-path file))
                                   (not (js-call file :startsWith (get artifacts :benchmarkDirectory)))
                                   (not (js-call file :endsWith ".json")))))
                    (/= (JSON/stringify bench-reports) (JSON/stringify (sorted-unique bench-reports))))
            (js-call errors :push "benchmark reports must be non-empty safe unique and sorted")))
        (let ((deterministic (if (and (is-plain-object artifacts) (Array/isArray (get artifacts :deterministic)))
                                 (get artifacts :deterministic)
                               (js-array)))
              (outputs (js-array))
              (index 0))
          (while (< index (js-length deterministic))
            (let ((artifact (aref deterministic index)))
              (if (or (not (is-plain-object artifact))
                      (not (safe-relative-path (get artifact :source)))
                      (not (safe-relative-path (get artifact :output)))
                      (and (not (eq (get artifact :sourceMap) undefined))
                           (or (not (safe-relative-path (get artifact :sourceMap)))
                               (/= (get artifact :sourceMap) (+ (get artifact :output) ".map")))))
                  (js-call errors :push (+ "deterministic artifact " index " is invalid"))
                (progn
                  (js-call outputs :push (get artifact :output))
                  (when (get artifact :sourceMap)
                    (js-call outputs :push (get artifact :sourceMap))))))
            (setq index (1+ index)))
          (let ((out-list (js-call deterministic :map (lambda (entry) (if (is-plain-object entry) (get entry :output) "")))))
            (when (or (= (js-length deterministic) 0)
                      (/= (get (new globalThis.Set outputs) :size) (js-length outputs))
                      (/= (JSON/stringify out-list) (JSON/stringify (sorted-unique out-list))))
              (js-call errors :push "deterministic artifact outputs must be non-empty unique and sorted"))))
        (let* ((derived (if (and (is-plain-object artifacts) (Array/isArray (get artifacts :derived)))
                            (get artifacts :derived)
                          (js-array)))
               (derived-ids (js-call derived :map (lambda (entry) (if (is-plain-object entry) (get entry :id) undefined)))))
          (when (or (/= (JSON/stringify derived-ids)
                        (JSON/stringify (js-array "browser-compatibility-workflow" "compatibility-workflow" "library-api")))
                    (js-call derived :some
                             (lambda (entry)
                               (or (not (is-plain-object entry))
                                   (not (Array/isArray (get entry :outputs)))
                                   (= (js-length (get entry :outputs)) 0)
                                   (js-call (get entry :outputs) :some (lambda (output) (not (safe-relative-path output))))
                                   (/= (JSON/stringify (get entry :outputs))
                                       (JSON/stringify (sorted-unique (get entry :outputs))))))))
            (js-call errors :push "derived artifacts must declare the complete sorted generator set"))))
      (when (> (js-length errors) 0)
        (throw (new RepositoryIntegrityError errors)))
      contract))

  (defasync capture (command root &rest rest)
    (let* ((timeout-ms (if (and (> (js-length rest) 0) (not (eq (aref rest 0) undefined))) (aref rest 0) 120000))
           (environment (if (> (js-length rest) 1) (aref rest 1) undefined))
           (options (js-object :cwd root :stdout "pipe" :stderr "pipe"))
           (timed-out false)
           (force-kill undefined)
           (timer undefined)
           (child undefined))
      (when environment
        (put options :env (Object/assign (js-object) (get process :env) environment)))
      (setq child (js-call globalThis.Bun :spawn command options))
      (setq timer
            (globalThis.setTimeout
              (lambda ()
                (setq timed-out t)
                (js-call child :kill "SIGTERM")
                (setq force-kill (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 2000)))
              timeout-ms))
      (try
        (let* ((values (await (Promise/all (js-array (get child :exited)
                                                     (js-call (new globalThis.Response (get child :stdout)) :text)
                                                     (js-call (new globalThis.Response (get child :stderr)) :text)))))
               (exit-code (aref values 0))
               (stdout (aref values 1))
               (stderr (aref values 2)))
          (when (or timed-out (/= exit-code 0))
            (throw (new RepositoryIntegrityError
                        (js-array (if timed-out
                                      (+ (aref command 0) " exceeded " timeout-ms "ms")
                                    (or (js-call stderr :trim)
                                        (js-call stdout :trim)
                                        (+ (aref command 0) " exited with " exit-code)))))))
          stdout)
        (finally
          (globalThis.clearTimeout timer)
          (globalThis.clearTimeout force-kill)))))

  (defasync repositoryTrackedFiles (&rest args)
    (let* ((root (if (and (> (js-length args) 0) (not (eq (aref args 0) undefined))) (aref args 0) DEFAULT_ROOT))
           (output (await (capture (js-array "git" "ls-files" "-z") root))))
      (js-call (js-call (js-call output :split "\u0000") :filter (lambda (item) (> (js-length item) 0))) :sort)))

  (defasync load-compiler (root)
    (let ((directory (await (mkdtemp (js-call path :join (tmpdir) "eliscript-integrity-compiler-")))))
      (try
        (await (capture (js-array (js-call path :join root "bin/eliscript-bootstrap"))
                        root 120000 (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory)))
        (let* ((filename (realpathSync (js-call path :join directory "compiler.mjs")))
               (require-module (createRequire filename)))
          (funcall require-module filename))
        (finally
          (await (rm directory (js-object :recursive t :force t)))))))

  (defun walk-imports (node file records)
    (cond
      ((Array/isArray node)
        (let ((i 0))
          (while (< i (js-length node))
            (walk-imports (aref node i) file records)
            (setq i (1+ i)))))
      ((is-plain-object node)
        (when (and (= (get node :kind) "import-declaration") (= (value-type (get node :value)) "string"))
          (js-call records :push
                   (js-object :file file
                              :specifier (get node :value)
                              :kind "import-declaration"
                              :language "eliscript")))
        (walk-imports (get node :body) file records)
        (walk-imports (get node :children) file records))))

  (defasync scan-import-records (root tracked-files contract compiler)
    (let ((records (js-array))
          (scanner (new globalThis.Bun.Transpiler (js-object :loader "js")))
          (index 0))
      (while (< index (js-length tracked-files))
        (let ((file (aref tracked-files index)))
          (when (or (js-call file :endsWith ".mjs") (js-call file :endsWith ".js"))
            (let* ((raw (await (readFile (js-call path :join root file) "utf8")))
                   (source (js-call raw :replace SHEBANG_RE ""))
                   (scanned (js-call scanner :scanImports source))
                   (j 0))
              (while (< j (js-length scanned))
                (let ((imported (aref scanned j)))
                  (js-call records :push
                           (js-object :file file
                                      :specifier (get imported :path)
                                      :kind (get imported :kind)
                                      :language "javascript")))
                (setq j (1+ j))))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length tracked-files))
        (let ((file (aref tracked-files index)))
          (when (and (js-call file :endsWith ".eli")
                     (js-call (get (get contract :imports) :eliscriptSourceRoots)
                              :some (lambda (root-prefix) (js-call file :startsWith root-prefix))))
            (let* ((source (await (readFile (js-call path :join root file) "utf8")))
                   (program (js-call compiler :compile_ir_string source (js-call path :join root file))))
              (walk-imports program file records))))
        (setq index (1+ index)))
      records))

  (defun package-name (specifier)
    (if (js-call specifier :startsWith "@")
        (js-call (js-call (js-call specifier :split "/") :slice 0 2) :join "/")
      (aref (js-call specifier :split "/" 1) 0)))

  (defun under-allowed-root (file roots)
    (js-call roots :some (lambda (root) (js-call file :startsWith root))))

  (defun under-package-directory (file directory)
    (or (= file directory) (js-call file :startsWith (+ directory "/"))))

  (defun special-policy (specifier policies)
    (js-call policies :find
             (lambda (policy)
               (or (= (get policy :specifier) specifier)
                   (and (not (eq (get policy :prefix) undefined))
                        (js-call specifier :startsWith (get policy :prefix)))))))

  (defun validateImportRecords (records contract &rest rest)
    (let* ((local-package-scopes (if (and (> (js-length rest) 0) (Array/isArray (aref rest 0))) (aref rest 0) (js-array)))
           (errors (js-array))
           (packages (new globalThis.Map
                          (js-call (get contract :packages) :map (lambda (entry) (js-array (get entry :name) entry)))))
           (external-imports 0)
           (core-external-imports 0)
           (index 0))
      (while (< index (js-length records))
        (let* ((record (aref records index))
               (specifier (get record :specifier)))
          (unless (or (js-call specifier :startsWith ".") (js-call specifier :startsWith "/"))
            (let ((special (special-policy specifier (get (get contract :imports) :specialSpecifiers))))
              (if special
                  (unless (under-allowed-root (get record :file) (get special :allowedRoots))
                    (js-call errors :push (+ (get record :file) " imports " specifier " outside its allowed boundary")))
                (progn
                  (setq external-imports (1+ external-imports))
                  (when (js-call (get (get contract :imports) :coreRoots)
                                 :some (lambda (root) (js-call (get record :file) :startsWith root)))
                    (setq core-external-imports (1+ core-external-imports)))
                  (let* ((name (package-name specifier))
                         (matching-scopes
                           (js-call (js-call local-package-scopes :filter
                                             (lambda (scope)
                                               (under-package-directory (get record :file) (get scope :directory))))
                                    :sort (lambda (left right)
                                            (- (js-length (get right :directory)) (js-length (get left :directory))))))
                         (local-scope (aref matching-scopes 0)))
                    (if local-scope
                        (unless (js-call (get local-scope :packages) :includes name)
                          (js-call errors :push
                                   (+ (get record :file) " imports undeclared package " specifier
                                      " in " (get local-scope :manifest))))
                      (let ((dependency (js-call packages :get name)))
                        (if (not dependency)
                            (js-call errors :push (+ (get record :file) " imports undeclared package " specifier))
                          (unless (under-allowed-root (get record :file) (get dependency :allowedRoots))
                            (js-call errors :push
                                     (+ (get record :file) " imports " specifier " outside its allowed boundary"))))))))))))
        (setq index (1+ index)))
      (when (> (js-length errors) 0)
        (throw (new RepositoryIntegrityError errors)))
      (js-object :totalImports (js-length records)
                 :externalImports external-imports
                 :coreExternalImports core-external-imports)))

  (defasync read-local-package-scopes (root tracked-files contract)
    (let* ((roots (get (get contract :imports) :localPackageRoots))
           (manifests (js-call tracked-files :filter
                               (lambda (file)
                                 (and (js-call file :endsWith "/package.json")
                                      (under-allowed-root file roots)))))
           (scopes (js-array))
           (errors (js-array))
           (index 0))
      (while (< index (js-length manifests))
        (let ((filename (aref manifests index))
              (manifest nil)
              (parse-ok t))
          (try
            (setq manifest (JSON/parse (await (readFile (js-call path :join root filename) "utf8"))))
            (catch error
              (setq parse-ok false)
              (js-call errors :push (+ filename " is not valid JSON: " (get error :message)))))
          (when parse-ok
            (if (or (not (is-plain-object manifest))
                    (not (eq (get manifest :private) t))
                    (/= (value-type (get manifest :name)) "string")
                    (= (js-length (get manifest :name)) 0))
                (js-call errors :push (+ filename " must describe one named private package"))
              (let ((packages (js-array))
                    (s-idx 0))
                (while (< s-idx (js-length PACKAGE_SECTIONS))
                  (let* ((section (aref PACKAGE_SECTIONS s-idx))
                         (dependencies (get manifest section)))
                    (unless (eq dependencies undefined)
                      (if (or (not (is-plain-object dependencies))
                              (js-call (Object/values dependencies) :some
                                       (lambda (val) (or (/= (value-type val) "string") (= (js-length val) 0)))))
                          (js-call errors :push (+ filename " " section " must map package names to versions"))
                        (js-call (Object/keys dependencies) :forEach (lambda (k) (js-call packages :push k))))))
                  (setq s-idx (1+ s-idx)))
                (js-call scopes :push
                         (js-object :directory (js-call (get path :posix) :dirname filename)
                                    :manifest filename
                                    :name (get manifest :name)
                                    :packages (sorted-unique (js-call (js-array (get manifest :name)) :concat packages))))))))
        (setq index (1+ index)))
      (when (> (js-length errors) 0)
        (throw (new RepositoryIntegrityError errors)))
      scopes))

  (defun exact-object (value)
    (Object/fromEntries
      (js-call (Object/entries (nullish value (js-object)))
               :sort (lambda (left right) (js-call (aref left 0) :localeCompare (aref right 0))))))

  (defasync checkDependencyBoundaries (&rest args)
    (let* ((options (if (and (> (js-length args) 0) (is-plain-object (aref args 0))) (aref args 0) (js-object)))
           (root (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (contract (validateIntegrityContract
                       (if (not (eq (get options :contract) undefined))
                           (get options :contract)
                         (JSON/parse (await (readFile (js-call path :join root CONTRACT_FILE) "utf8"))))))
           (tracked-files (if (not (eq (get options :trackedFiles) undefined))
                              (get options :trackedFiles)
                            (await (repositoryTrackedFiles root))))
           (package-manifest (if (not (eq (get options :packageManifest) undefined))
                                 (get options :packageManifest)
                               (JSON/parse (await (readFile (js-call path :join root (get contract :packageManifest)) "utf8")))))
           (errors (js-array))
           (s-idx 0))
      (while (< s-idx (js-length PACKAGE_SECTIONS))
        (let* ((section (aref PACKAGE_SECTIONS s-idx))
               (expected (Object/fromEntries
                           (js-call (js-call (get contract :packages) :filter
                                             (lambda (entry) (= (get entry :section) section)))
                                    :map (lambda (entry) (js-array (get entry :name) (get entry :version)))))))
          (unless (= (JSON/stringify (exact-object (get package-manifest section)))
                     (JSON/stringify (exact-object expected)))
            (js-call errors :push (+ (get contract :packageManifest) " " section " differs from the integrity contract"))))
        (setq s-idx (1+ s-idx)))
      (when (> (js-length errors) 0)
        (throw (new RepositoryIntegrityError errors)))
      (unless (get options :skipLockfile)
        (await (capture (js-array (get process :execPath) "install" "--frozen-lockfile" "--dry-run" "--ignore-scripts" "--silent") root)))
      (let* ((local-package-scopes (if (not (eq (get options :localPackageScopes) undefined))
                                       (get options :localPackageScopes)
                                     (await (read-local-package-scopes root tracked-files contract))))
             (compiler (if (not (eq (get options :compiler) undefined))
                           (get options :compiler)
                         (await (load-compiler root))))
             (records (if (not (eq (get options :importRecords) undefined))
                          (get options :importRecords)
                        (await (scan-import-records root tracked-files contract compiler))))
             (imports (validateImportRecords records contract local-package-scopes))
             (scanned-js (js-length (js-call tracked-files :filter
                                             (lambda (file) (or (js-call file :endsWith ".mjs") (js-call file :endsWith ".js"))))))
             (scanned-eli (js-length (js-call tracked-files :filter
                                              (lambda (file)
                                                (and (js-call file :endsWith ".eli")
                                                     (js-call (get (get contract :imports) :eliscriptSourceRoots)
                                                              :some (lambda (root-prefix) (js-call file :startsWith root-prefix)))))))))
        (Object/assign
          (js-object :packages (js-length (get contract :packages))
                     :localPackages (js-length local-package-scopes)
                     :lockfile (if (get options :skipLockfile) "skipped" "frozen")
                     :scannedJavaScript scanned-js
                     :scannedEliscript scanned-eli)
          imports))))

  (defun sha256 (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))

  (defasync checked-source (root tracked-set file)
    (unless (and (safe-relative-path file) (js-call tracked-set :has file))
      (throw (new RepositoryIntegrityError
                  (js-array (+ "benchmark source is not a tracked safe path: " file)))))
    (await (readFile (js-call path :join root file))))

  (defasync validateBenchmarkSource (root tracked-files filename report)
    (let ((tracked-set (new globalThis.Set tracked-files)))
      (when (or (not (is-plain-object report))
                (/= (value-type (get report :format)) "string")
                (not (js-call (get report :format) :startsWith "eliscript-"))
                (not (Number/isSafeInteger (get report :version))))
        (throw (new RepositoryIntegrityError (js-array (+ filename " has invalid report identity")))))
      (if (is-plain-object (get report :sourceDigest))
          (let ((binding (get report :sourceDigest)))
            (when (or (/= (get binding :algorithm) "sha256")
                      (not (Array/isArray (get binding :files)))
                      (= (js-length (get binding :files)) 0)
                      (not (js-call SHA256_RE :test (nullish (get binding :value) "")))
                      (/= (get (new globalThis.Set (get binding :files)) :size) (js-length (get binding :files))))
              (throw (new RepositoryIntegrityError (js-array (+ filename " has invalid sourceDigest")))))
            (let ((aggregate (createHash "sha256"))
                  (files (get binding :files))
                  (index 0))
              (while (< index (js-length files))
                (let* ((file (aref files index))
                       (bytes (await (checked-source root tracked-set file))))
                  (js-call aggregate :update file)
                  (js-call aggregate :update "\u0000")
                  (js-call aggregate :update bytes)
                  (js-call aggregate :update "\u0000"))
                (setq index (1+ index)))
              (unless (= (js-call aggregate :digest "hex") (get binding :value))
                (throw (new RepositoryIntegrityError (js-array (+ filename " sourceDigest is stale")))))
              (js-length files)))
        (let ((binding (get report :source)))
          (when (or (not (is-plain-object binding))
                    (not (Array/isArray (get binding :files)))
                    (= (js-length (get binding :files)) 0)
                    (not (js-call SHA256_RE :test (nullish (get binding :digest) ""))))
            (throw (new RepositoryIntegrityError (js-array (+ filename " has no valid source binding")))))
          (let ((path-bytes (createHash "sha256"))
                (digest-manifest (createHash "sha256"))
                (names (js-array))
                (entries (get binding :files))
                (index 0))
            (while (< index (js-length entries))
              (let ((entry (aref entries index)))
                (when (or (not (is-plain-object entry))
                          (/= (value-type (get entry :file)) "string")
                          (not (js-call SHA256_RE :test (nullish (get entry :sha256) ""))))
                  (throw (new RepositoryIntegrityError (js-array (+ filename " has invalid source entries")))))
                (js-call names :push (get entry :file))
                (let* ((bytes (await (checked-source root tracked-set (get entry :file))))
                       (digest (sha256 bytes)))
                  (unless (= digest (get entry :sha256))
                    (throw (new RepositoryIntegrityError
                                (js-array (+ filename " source entry is stale: " (get entry :file))))))
                  (js-call path-bytes :update (get entry :file))
                  (js-call path-bytes :update "\u0000")
                  (js-call path-bytes :update bytes)
                  (js-call path-bytes :update "\u0000")
                  (js-call digest-manifest :update (+ (get entry :file) ":" digest "\n"))))
              (setq index (1+ index)))
            (unless (and (= (get (new globalThis.Set names) :size) (js-length names))
                         (js-call (js-array (js-call path-bytes :digest "hex")
                                            (js-call digest-manifest :digest "hex"))
                                  :includes (get binding :digest)))
              (throw (new RepositoryIntegrityError (js-array (+ filename " aggregate source digest is stale")))))
            (js-length names))))))

  (defasync checkGeneratedMarkerCoverage (root tracked-files contract)
    (let ((marked (js-array))
          (candidates (js-call tracked-files :filter (lambda (c) (js-call c :endsWith ".mjs"))))
          (index 0))
      (while (< index (js-length candidates))
        (let* ((file (aref candidates index))
               (source (await (readFile (js-call path :join root file) "utf8"))))
          (when (js-call source :startsWith (get (get contract :artifacts) :generatedMarker))
            (js-call marked :push file)))
        (setq index (1+ index)))
      (let ((declared (js-call (js-call (get (get contract :artifacts) :deterministic)
                                        :map (lambda (artifact) (get artifact :output)))
                               :sort)))
        (unless (= (JSON/stringify (js-call marked :sort)) (JSON/stringify declared))
          (throw (new RepositoryIntegrityError
                      (js-array "generated Eliscript module markers differ from the artifact registry")))))
      marked))

  (defun validateBenchmarkInventory (tracked-files contract)
    (let ((actual (js-call tracked-files :filter
                           (lambda (file)
                             (and (js-call file :startsWith (get (get contract :artifacts) :benchmarkDirectory))
                                  (js-call file :endsWith ".json")))))
          (expected (get (get contract :artifacts) :benchmarkReports)))
      (unless (= (JSON/stringify actual) (JSON/stringify expected))
        (throw (new RepositoryIntegrityError
                    (js-array "tracked benchmark reports differ from the artifact registry"))))
      actual))

  (defasync check-deterministic-artifacts (root contract compiler)
    (let ((errors (js-array))
          (deterministic (get (get contract :artifacts) :deterministic))
          (index 0))
      (while (< index (js-length deterministic))
        (let* ((artifact (aref deterministic index))
               (source-path (js-call path :join root (get artifact :source)))
               (output-path (js-call path :join root (get artifact :output)))
               (source (await (readFile source-path "utf8"))))
          (if (not (get artifact :sourceMap))
              (let ((expected (js-call compiler :compile_string source source-path))
                    (actual (await (readFile output-path "utf8"))))
                (unless (= actual expected)
                  (js-call errors :push (+ (get artifact :output) " is stale"))))
            (let* ((map-path (js-call path :join root (get artifact :sourceMap)))
                   (emission (js-call compiler :compile_string_with_source_map
                                      source source-path
                                      (js-call path :relative (js-call path :dirname map-path) output-path)
                                      (js-call path :relative (js-call path :dirname map-path) source-path)))
                   (map-url (js-call path :relative (js-call path :dirname output-path) map-path))
                   (expected-output (+ (get emission :javascript) "//# sourceMappingURL=" map-url "\n"))
                   (pair (await (Promise/all (js-array (readFile output-path "utf8") (readFile map-path "utf8"))))))
              (unless (= (aref pair 0) expected-output)
                (js-call errors :push (+ (get artifact :output) " is stale")))
              (unless (= (aref pair 1) (get emission :sourceMap))
                (js-call errors :push (+ (get artifact :sourceMap) " is stale"))))))
        (setq index (1+ index)))
      (when (> (js-length errors) 0)
        (throw (new RepositoryIntegrityError errors)))))

  (defasync check-derived-artifacts (root contract)
    (let* ((expected (new globalThis.Map
                          (js-call (get (get contract :artifacts) :derived)
                                   :map (lambda (entry) (js-array (get entry :id) (get entry :outputs))))))
           (browser (await (checkBrowserCompatibilityWorkflow (js-object :root root)))))
      (unless (= (JSON/stringify (js-call expected :get "browser-compatibility-workflow"))
                 (JSON/stringify (js-array (get browser :workflow))))
        (throw (new RepositoryIntegrityError (js-array "browser workflow outputs differ from the artifact registry"))))
      (let ((workflow (await (checkCompatibilityWorkflow (js-object :root root)))))
        (unless (= (JSON/stringify (js-call expected :get "compatibility-workflow"))
                   (JSON/stringify (js-array (get workflow :workflow))))
          (throw (new RepositoryIntegrityError (js-array "compatibility workflow outputs differ from the artifact registry")))))
      (let ((api (await (generateApiArtifacts (js-object :root root :check t)))))
        (unless (= (JSON/stringify (js-call expected :get "library-api"))
                   (JSON/stringify (js-call (Array/from (get api :files)) :sort)))
          (throw (new RepositoryIntegrityError (js-array "library API outputs differ from the artifact registry"))))
        (+ 2 (js-length (get api :files))))))

  (defasync checkGeneratedArtifacts (&rest args)
    (let* ((options (if (and (> (js-length args) 0) (is-plain-object (aref args 0))) (aref args 0) (js-object)))
           (root (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (contract (validateIntegrityContract
                       (if (not (eq (get options :contract) undefined))
                           (get options :contract)
                         (JSON/parse (await (readFile (js-call path :join root CONTRACT_FILE) "utf8"))))))
           (tracked-files (if (not (eq (get options :trackedFiles) undefined))
                              (get options :trackedFiles)
                            (await (repositoryTrackedFiles root))))
           (compiler (if (not (eq (get options :compiler) undefined))
                         (get options :compiler)
                       (await (load-compiler root)))))
      (await (checkGeneratedMarkerCoverage root tracked-files contract))
      (await (check-deterministic-artifacts root contract compiler))
      (let* ((derived-artifacts (await (check-derived-artifacts root contract)))
             (benchmark-files (validateBenchmarkInventory tracked-files contract))
             (benchmark-sources 0)
             (defer-perf (eq (get options :deferPerformanceAcceptance) t))
             (index 0))
        (unless defer-perf
          (while (< index (js-length benchmark-files))
            (let* ((file (aref benchmark-files index))
                   (report (JSON/parse (await (readFile (js-call path :join root file) "utf8")))))
              (setq benchmark-sources (+ benchmark-sources (await (validateBenchmarkSource root tracked-files file report)))))
            (setq index (1+ index))))
        (let ((result (js-object :deterministicArtifacts (js-length (get (get contract :artifacts) :deterministic))
                                 :deterministicOutputs
                                 (js-call (get (get contract :artifacts) :deterministic)
                                          :reduce (lambda (count artifact) (+ count 1 (if (get artifact :sourceMap) 1 0))) 0)
                                 :derivedArtifacts derived-artifacts
                                 :benchmarkArtifacts (js-length benchmark-files)
                                 :benchmarkSources benchmark-sources)))
          (when defer-perf
            (put result :deferredBenchmarkSources benchmark-files))
          result))))

  (defasync checkRepositoryIntegrity (&rest args)
    (let* ((options (if (and (> (js-length args) 0) (is-plain-object (aref args 0))) (aref args 0) (js-object)))
           (root (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (contract (validateIntegrityContract
                       (if (not (eq (get options :contract) undefined))
                           (get options :contract)
                         (JSON/parse (await (readFile (js-call path :join root CONTRACT_FILE) "utf8"))))))
           (tracked-files (if (not (eq (get options :trackedFiles) undefined))
                              (get options :trackedFiles)
                            (await (repositoryTrackedFiles root))))
           (compiler (if (not (eq (get options :compiler) undefined))
                         (get options :compiler)
                       (await (load-compiler root))))
           (merged (Object/assign (js-object) options
                                  (js-object :root root :contract contract :trackedFiles tracked-files :compiler compiler)))
           (dependency (if (get options :artifactsOnly) undefined (await (checkDependencyBoundaries merged))))
           (artifacts (if (get options :dependenciesOnly) undefined (await (checkGeneratedArtifacts merged)))))
      (js-object :schemaVersion 1
                 :format "eliscript-repository-integrity-report"
                 :version 1
                 :dependency dependency
                 :artifacts artifacts)))

  (defun humanIntegrityReport (report)
    (let ((lines (js-array "Repository integrity:")))
      (when (get report :dependency)
        (let ((dep (get report :dependency)))
          (js-call lines :push
                   (+ "  Dependencies  " (get dep :packages) " declared packages, "
                      (get dep :coreExternalImports) " core package imports")
                   (+ "  Sources       " (get dep :scannedJavaScript) " JavaScript, "
                      (get dep :scannedEliscript) " Eliscript")
                   (+ "  Lockfile      " (get dep :lockfile)))))
      (when (get report :artifacts)
        (let ((art (get report :artifacts)))
          (js-call lines :push
                   (+ "  Generated     " (get art :deterministicOutputs) " deterministic outputs, "
                      (get art :derivedArtifacts) " derived outputs")
                   (+ "  Benchmarks    " (get art :benchmarkArtifacts) " reports, "
                      (get art :benchmarkSources) " source bindings"))
          (when (get art :deferredBenchmarkSources)
            (js-call lines :push
                     (+ "  Performance   DEFERRED / NOT ACCEPTED: "
                        (js-length (get art :deferredBenchmarkSources)) " current-source bindings")))))
      (js-call lines :join "\n")))

  (export
    DEFAULT_ROOT
    RepositoryIntegrityError
    validateIntegrityContract
    repositoryTrackedFiles
    validateImportRecords
    checkDependencyBoundaries
    validateBenchmarkSource
    checkGeneratedMarkerCoverage
    validateBenchmarkInventory
    checkGeneratedArtifacts
    checkRepositoryIntegrity
    humanIntegrityReport))
