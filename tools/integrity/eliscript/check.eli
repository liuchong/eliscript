(module tools.integrity.check
  (import "./check-legacy.mjs" :as legacy)
  (import "node:fs/promises" mkdtemp readFile readdir rm)
  (import "node:os" tmpdir)
  (import "node:path" :default path)
  (import "node:module" createRequire)
  (import "node:fs" realpathSync)
  (import "../ci/render-workflow.mjs" checkCompatibilityWorkflow)
  (import "../ci/render-browser-workflow.mjs" checkBrowserCompatibilityWorkflow)
  (import "../surface/generate-api.mjs" generateApiArtifacts)

  (defconst DEFAULT_ROOT (get legacy :DEFAULT_ROOT))
  (defconst RepositoryIntegrityError (get legacy :RepositoryIntegrityError))
  (defconst validateIntegrityContract (get legacy :validateIntegrityContract))
  (defconst repositoryTrackedFiles (get legacy :repositoryTrackedFiles))
  (defconst validateImportRecords (get legacy :validateImportRecords))
  (defconst legacyCheckDependencyBoundaries (get legacy :checkDependencyBoundaries))
  (defconst legacyValidateBenchmarkSource (get legacy :validateBenchmarkSource))
  (defconst validateBenchmarkInventory (get legacy :validateBenchmarkInventory))
  (defconst humanIntegrityReport (get legacy :humanIntegrityReport))
  (defconst contract-file "contracts/repository-integrity.json")
  ;; These are the existing deterministic source-output inventories. The
  ;; bootstrap tool outputs live outside this registry and remain generated.
  (defconst generated-directories (js-array "runtime/core" "tests/snapshots"))

  (defun call-options (arguments)
    (if (or (= (js-length arguments) 0) (eq (aref arguments 0) undefined))
      (js-object) (aref arguments 0)))
  (defun nullish (value fallback) (if (or (eq value undefined) (eq value nil)) fallback value))
  (defun integrity-error (message) (throw (new RepositoryIntegrityError (js-array message))))
  (defun safe-path-p (value)
    (and (= (value-type value) "string") (> (js-length value) 0)
      (not (js-call value :includes "\u0000"))
      (not (js-call path :isAbsolute value))
      (not (js-call (js-call value :split "/") :includes ".."))
      (= (js-call (get path :posix) :normalize value) value)))

  ;; Keep the original bounded bootstrap subprocess contract. This helper also
  ;; reads Git's real ignore policy without manufacturing tracked source files.
  (defasync capture (command directory timeout environment allowed &rest input)
    (let* ((options (js-object :cwd directory :stdout "pipe" :stderr "pipe"))
           (timed-out false) (force-kill undefined) (timer undefined) (child undefined))
      (when environment (put options :env (Object/assign (js-object) (get globalThis.process :env) environment)))
      (when (> (js-length input) 0)
        (put options :stdin (new globalThis.Blob (js-array (aref input 0)))))
      (setq child (js-call globalThis.Bun :spawn command options))
      (setq timer (globalThis.setTimeout (lambda ()
        (setq timed-out t)
        (js-call child :kill "SIGTERM")
        (setq force-kill (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 2000))) timeout))
      (try
        (let* ((values (await (Promise/all (js-array (get child :exited)
                         (js-call (new globalThis.Response (get child :stdout)) :text)
                         (js-call (new globalThis.Response (get child :stderr)) :text)))))
               (exit-code (aref values 0)) (stdout (aref values 1)) (stderr (aref values 2)))
          (when (or timed-out (not (js-call allowed :includes exit-code)))
            (integrity-error (if timed-out
              (+ (aref command 0) " exceeded " timeout "ms")
              (or (js-call stderr :trim) (js-call stdout :trim) (+ (aref command 0) " exited with " exit-code)))))
          stdout)
        (finally (globalThis.clearTimeout timer) (globalThis.clearTimeout force-kill)))))

  (defasync load-compiler (directory)
    (let ((temporary (await (mkdtemp (js-call path :join (tmpdir) "eliscript-integrity-compiler-")))))
      (try
        (await (capture (js-array (js-call path :join directory "bin/eliscript-bootstrap"))
          directory 120000 (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR temporary) (js-array 0)))
        (let* ((filename (realpathSync (js-call path :join temporary "compiler.mjs")))
               (require-module (createRequire filename)))
          (funcall require-module filename))
        (finally (await (rm temporary (js-object :recursive t :force t)))))))

  (defasync checkGeneratedMarkerCoverage (directory tracked-files contract)
    (let* ((artifacts (get contract :artifacts)) (registry (get artifacts :deterministic))
           (marker (get artifacts :generatedMarker)) (tracked (new globalThis.Set tracked-files))
           (candidates (new globalThis.Set)) (declared (js-array)) (outputs (js-array)) (marked (js-array))
           (index 0))
      (js-call tracked-files :forEach (lambda (file)
        (when (js-call file :endsWith ".mjs") (js-call candidates :add file))))
      (while (< index (js-length registry))
        (let* ((artifact (aref registry index)) (source (get artifact :source)) (output (get artifact :output))
               (source-map (get artifact :sourceMap)))
          (unless (and (safe-path-p source) (js-call tracked :has source))
            (integrity-error (+ "deterministic artifact source must be tracked: " source)))
          (js-call declared :push output)
          (js-call candidates :add output)
          (js-call outputs :push output)
          (when source-map (js-call outputs :push source-map)))
        (setq index (1+ index)))
      (js-call outputs :forEach (lambda (output)
        (unless (safe-path-p output) (integrity-error (+ "generated artifact output must be a safe path: " output)))
        (when (js-call tracked :has output) (integrity-error (+ "generated artifact output must not be tracked: " output)))))
      (when (> (js-length outputs) 0)
        (let* ((ignored-output (await (capture
                 (js-array "git" "check-ignore" "--no-index" "-z" "--stdin")
                 directory 120000 undefined (js-array 0 1)
                 (+ (js-call outputs :join "\u0000") "\u0000"))))
               (ignored (new globalThis.Set (js-call ignored-output :split "\u0000"))))
          (js-call outputs :forEach (lambda (output)
            (unless (js-call ignored :has output)
              (integrity-error (+ "generated artifact output must be ignored: " output)))))))
      (setq index 0)
      (while (< index (js-length generated-directories))
        (let ((prefix (aref generated-directories index)))
          (try
            (let ((files (await (readdir (js-call path :join directory prefix)))))
              (js-call files :forEach (lambda (file)
                (when (js-call file :endsWith ".mjs") (js-call candidates :add (+ prefix "/" file))))))
            (catch error (unless (= (get error :code) "ENOENT") (throw error)))))
        (setq index (1+ index)))
      (let ((files (js-call (Array/from candidates) :sort)) (position 0))
        (while (< position (js-length files))
          (let* ((file (aref files position)) (source (await (readFile (js-call path :join directory file) "utf8"))))
            (when (js-call source :startsWith marker) (js-call marked :push file)))
          (setq position (1+ position))))
      (unless (= (JSON/stringify marked) (JSON/stringify (js-call declared :sort)))
        (integrity-error "generated Eliscript module markers differ from the artifact registry"))
      marked))

  (defasync check-deterministic-artifacts (directory contract compiler)
    (let ((artifacts (get (get contract :artifacts) :deterministic)) (errors (js-array)) (index 0))
      (while (< index (js-length artifacts))
        (let* ((artifact (aref artifacts index))
               (source-path (js-call path :join directory (get artifact :source)))
               (output-path (js-call path :join directory (get artifact :output)))
               (source (await (readFile source-path "utf8"))))
          (if (not (get artifact :sourceMap))
            (let ((expected (js-call compiler :compile_string source source-path))
                  (actual (await (readFile output-path "utf8"))))
              (unless (= actual expected) (js-call errors :push (+ (get artifact :output) " is stale"))))
            (let* ((map-path (js-call path :join directory (get artifact :sourceMap)))
                   (emission (js-call compiler :compile_string_with_source_map source source-path
                     (js-call path :relative (js-call path :dirname map-path) output-path)
                     (js-call path :relative (js-call path :dirname map-path) source-path)))
                   (map-url (js-call path :relative (js-call path :dirname output-path) map-path))
                   (expected (+ (get emission :javascript) "//# sourceMappingURL=" map-url "\n"))
                   (actual (await (Promise/all (js-array (readFile output-path "utf8") (readFile map-path "utf8"))))))
              (unless (= (aref actual 0) expected) (js-call errors :push (+ (get artifact :output) " is stale")))
              (unless (= (aref actual 1) (get emission :sourceMap))
                (js-call errors :push (+ (get artifact :sourceMap) " is stale"))))))
        (setq index (1+ index)))
      (when (> (js-length errors) 0) (throw (new RepositoryIntegrityError errors)))))

  (defasync check-derived-artifacts (directory contract)
    (let* ((expected (new globalThis.Map (js-call (get (get contract :artifacts) :derived) :map
                       (lambda (entry) (js-array (get entry :id) (get entry :outputs))))))
           (browser (await (checkBrowserCompatibilityWorkflow (js-object :root directory)))))
      (unless (= (JSON/stringify (js-call expected :get "browser-compatibility-workflow"))
                 (JSON/stringify (js-array (get browser :workflow))))
        (integrity-error "browser workflow outputs differ from the artifact registry"))
      (let ((workflow (await (checkCompatibilityWorkflow (js-object :root directory)))))
        (unless (= (JSON/stringify (js-call expected :get "compatibility-workflow"))
                   (JSON/stringify (js-array (get workflow :workflow))))
          (integrity-error "compatibility workflow outputs differ from the artifact registry")))
      (let ((api (await (generateApiArtifacts (js-object :root directory :check t)))))
        (unless (= (JSON/stringify (js-call expected :get "library-api"))
                   (JSON/stringify (js-call (Array/from (get api :files)) :sort)))
          (integrity-error "library API outputs differ from the artifact registry"))
        (+ 2 (js-length (get api :files))))))

  (defasync checkGeneratedArtifacts (&rest arguments)
    (let* ((options (call-options arguments))
           (directory (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (contract (validateIntegrityContract (await (read-contract options directory))))
           (tracked (await (read-tracked options directory)))
           (compiler (await (read-compiler options directory))))
      (await (checkGeneratedMarkerCoverage directory tracked contract))
      (await (check-deterministic-artifacts directory contract compiler))
      (let* ((derived (await (check-derived-artifacts directory contract)))
             (files (validateBenchmarkInventory tracked contract)) (sources 0)
             (deferred (eq (get options :deferPerformanceAcceptance) t)) (index 0))
        (unless deferred
          (while (< index (js-length files))
            (let* ((filename (aref files index))
                   (report (JSON/parse (await (readFile (js-call path :join directory filename) "utf8")))))
              (setq sources (+ sources (await (validateBenchmarkSource directory tracked filename report)))))
            (setq index (1+ index))))
        (let ((result (js-object :deterministicArtifacts (js-length (get (get contract :artifacts) :deterministic))
          :deterministicOutputs (js-call (get (get contract :artifacts) :deterministic) :reduce
            (lambda (count artifact) (+ count 1 (if (get artifact :sourceMap) 1 0))) 0)
          :derivedArtifacts derived :benchmarkArtifacts (js-length files) :benchmarkSources sources)))
          (when deferred (put result :deferredBenchmarkSources files))
          result))))

  (defasync read-contract (options directory)
    (let ((value (get options :contract)))
      (if (or (eq value undefined) (eq value nil))
        (JSON/parse (await (readFile (js-call path :join directory contract-file) "utf8"))) value)))
  (defasync read-tracked (options directory)
    (let ((value (get options :trackedFiles)))
      (if (or (eq value undefined) (eq value nil)) (await (repositoryTrackedFiles directory)) value)))
  (defasync read-compiler (options directory)
    (let ((value (get options :compiler)))
      (if (or (eq value undefined) (eq value nil)) (await (load-compiler directory)) value)))

  (defasync augment-capsule-tracked-files (directory tracked-files)
    (if (not (Array/isArray tracked-files))
      tracked-files
      (let ((expanded (new globalThis.Set)) (index 0))
        (while (< index (js-length tracked-files))
          (let ((file (aref tracked-files index)))
            (if (and (= (value-type file) "string") (js-call file :endsWith ".eli"))
              (let ((is-capsule false))
                (try
                  (let ((text (await (readFile (js-call path :join directory file) "utf8"))))
                    (setq is-capsule (js-call text :startsWith "(module capsules.")))
                  (catch error (setq is-capsule false)))
                (if is-capsule
                  (js-call expanded :add (+ (js-call file :slice 0 -4) ".mjs"))
                  (js-call expanded :add file)))
              (js-call expanded :add file)))
          (setq index (1+ index)))
        (js-call (Array/from expanded) :sort))))

  (defasync checkDependencyBoundaries (&rest arguments)
    (let* ((options (call-options arguments))
           (directory (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (tracked (await (augment-capsule-tracked-files directory (await (read-tracked options directory))))))
      (await (legacyCheckDependencyBoundaries
        (Object/assign (js-object) options (js-object :root directory :trackedFiles tracked))))))

  (defasync validateBenchmarkSource (directory tracked-files filename report)
    (await (legacyValidateBenchmarkSource
      directory (await (augment-capsule-tracked-files directory tracked-files)) filename report)))

  (defasync checkRepositoryIntegrity (&rest arguments)
    (let* ((options (call-options arguments))
           (directory (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (contract (validateIntegrityContract (await (read-contract options directory))))
           (tracked (await (read-tracked options directory)))
           (compiler (await (read-compiler options directory)))
           (configured (Object/assign (js-object) options
                         (js-object :root directory :contract contract :trackedFiles tracked :compiler compiler)))
           (dependency (if (get options :artifactsOnly) undefined (await (checkDependencyBoundaries configured))))
           (artifacts (if (get options :dependenciesOnly) undefined (await (checkGeneratedArtifacts configured)))))
      (js-object :schemaVersion 1 :format "eliscript-repository-integrity-report" :version 1
        :dependency dependency :artifacts artifacts)))

  (defasync main ()
    (let* ((arguments (js-call (get globalThis.process :argv) :slice 2))
           (dependencies-only (js-call arguments :includes "--dependencies"))
           (artifacts-only (js-call arguments :includes "--artifacts"))
           (unknown (js-call arguments :filter (lambda (argument)
                      (and (/= argument "--dependencies") (/= argument "--artifacts"))))))
      (if (or (> (js-length unknown) 0) (and dependencies-only artifacts-only))
        (progn (js-call globalThis.console :error "Usage: bun tools/integrity/check.mjs [--dependencies|--artifacts]")
          (put globalThis.process :exitCode 2))
        (try
          (let ((report (await (checkRepositoryIntegrity (js-object :dependenciesOnly dependencies-only :artifactsOnly artifacts-only
                         :deferPerformanceAcceptance (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))))))
            (js-call globalThis.console :log (humanIntegrityReport report)))
          (catch error (js-call globalThis.console :error (get error :message)) (put globalThis.process :exitCode 1))))))
  (when (and (> (js-length (get globalThis.process :argv)) 1)
             (= (js-call path :resolve (aref (get globalThis.process :argv) 1))
                (js-call path :join DEFAULT_ROOT "tools/integrity/check.mjs")))
    (main))

  (export DEFAULT_ROOT RepositoryIntegrityError validateIntegrityContract repositoryTrackedFiles
    validateImportRecords checkDependencyBoundaries validateBenchmarkSource checkGeneratedMarkerCoverage
    validateBenchmarkInventory checkGeneratedArtifacts checkRepositoryIntegrity humanIntegrityReport))
