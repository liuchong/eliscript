(module tools.surface.generate-api
  (import "node:fs/promises" mkdir readFile writeFile)
  (import "node:path" dirname join resolve)
  (import "./check.mjs" checkPublicSurface)

  (defconst DEFAULT_ROOT
    (let ((arg1 (aref (get globalThis.process :argv) 1)))
      (if (and arg1 (js-call (resolve arg1) :endsWith "/tools/surface/generate-api.mjs"))
          (resolve (dirname (resolve arg1)) "../..")
        (resolve (js-call globalThis.process :cwd)))))

  (defconst METADATA_FILE "contracts/library-api.json")
  (defconst SURFACE_FILE "contracts/public-surface.json")
  (defconst SPEC_INDEX_FILE "specs/index.json")
  (defconst JSON_OUTPUT "docs/pages/api-index.json")
  (defconst HTML_OUTPUT "docs/pages/api.html")
  (defconst ROLE_ENTRIES (js-array
    (js-array "portable" "Portable libraries")
    (js-array "runtime-core" "Runtime core")
    (js-array "host-interop" "Host interoperation")
    (js-array "state" "State")))
  (defconst ROLES (new globalThis.Map ROLE_ENTRIES))

  (defun ApiIndexValidationError (errors)
    (let ((instance (new globalThis.Error
                         (+ "Library API metadata validation failed:\n"
                            (js-call (js-call errors :map (lambda (err) (+ "- " err))) :join "\n")))))
      (put instance :name "ApiIndexValidationError")
      (put instance :errors errors)
      (Object/setPrototypeOf instance (get ApiIndexValidationError :prototype))
      instance))
  (Object/setPrototypeOf (get ApiIndexValidationError :prototype) (get globalThis.Error :prototype))

  (defun isPlainObject (value)
    (and (not (nil? value))
         (= (value-type value) "object")
         (not (Array/isArray value))))

  (defasync readJson (filename)
    (JSON/parse (await (readFile filename "utf8"))))

  (defun exactSortedNames (values)
    (js-call (Array/from (new globalThis.Set values)) :sort))

  (defun compareNames (label expected actual errors)
    (let* ((expectedSet (new globalThis.Set expected))
           (actualSet (new globalThis.Set actual))
           (missing (js-call actual :filter (lambda (value) (not (js-call expectedSet :has value)))))
           (stale (js-call expected :filter (lambda (value) (not (js-call actualSet :has value))))))
      (when (> (js-length missing) 0)
        (js-call errors :push (+ label " is missing current entries: " (js-call missing :join ", "))))
      (when (> (js-length stale) 0)
        (js-call errors :push (+ label " declares absent entries: " (js-call stale :join ", "))))))

  (defasync buildApiIndex (&optional options-input)
    (let* ((options (if (or (nil? options-input) (undefined? options-input)) (js-object) options-input))
           (root (resolve (if (or (nil? (get options :root)) (undefined? (get options :root)))
                              DEFAULT_ROOT
                            (get options :root))))
           (metadata (if (or (nil? (get options :metadata)) (undefined? (get options :metadata)))
                         (await (readJson (join root METADATA_FILE)))
                       (get options :metadata)))
           (surface (if (or (nil? (get options :surface)) (undefined? (get options :surface)))
                        (await (readJson (join root SURFACE_FILE)))
                      (get options :surface)))
           (specIndex (if (or (nil? (get options :specIndex)) (undefined? (get options :specIndex)))
                          (await (readJson (join root SPEC_INDEX_FILE)))
                        (get options :specIndex)))
           (errors (js-array)))
      (await (checkPublicSurface (js-object :root root :surface surface :specIndex specIndex)))
      (when (or (not (isPlainObject metadata))
                (/= (get metadata :schemaVersion) 1)
                (/= (get metadata :format) "eliscript-library-api-metadata")
                (/= (get metadata :version) 1))
        (js-call errors :push "library API metadata must use eliscript-library-api-metadata version 1"))
      (let* ((raw-modules (if (isPlainObject metadata) (get metadata :modules) nil))
             (modules (if (Array/isArray raw-modules) raw-modules (js-array))))
        (unless (Array/isArray raw-modules)
          (js-call errors :push "library API modules must be an array"))
        (let* ((surfaceModules (new globalThis.Map
                 (js-call (get surface :standardLibrary) :map
                   (lambda (mod) (js-array (get mod :module) mod)))))
               (specs (new globalThis.Map
                 (js-call (get specIndex :specifications) :map
                   (lambda (spec) (js-array (get spec :id) spec)))))
               (names (js-call modules :map (lambda (mod) (if (isPlainObject mod) (get mod :module) nil))))
               (validNames (js-call names :filter
                 (lambda (name)
                   (and (= (value-type name) "string")
                        (> (js-length name) 0)
                        (= (js-call name :trim) name))))))
          (when (/= (JSON/stringify validNames) (JSON/stringify (exactSortedNames validNames)))
            (js-call errors :push "library API modules must be unique and sorted by module name"))
          (compareNames
            "library API module inventory"
            (exactSortedNames (js-call names :filter (lambda (name) (= (value-type name) "string"))))
            (js-call (Array/from (js-call surfaceModules :keys)) :sort)
            errors)
          (let ((generatedModules (js-array))
                (idx 0))
            (while (< idx (js-length modules))
              (let ((mod (aref modules idx))
                    (label (+ "library API module " (str idx))))
                (cond
                  ((not (isPlainObject mod))
                   (js-call errors :push (+ label " must be an object")))
                  ((or (/= (value-type (get mod :module)) "string")
                       (= (js-length (get mod :module)) 0)
                       (/= (js-call (get mod :module) :trim) (get mod :module)))
                   (js-call errors :push (+ label " must have a non-empty trimmed module name")))
                  (t
                   (let* ((mod-name (get mod :module))
                          (surfaceModule (js-call surfaceModules :get mod-name))
                          (spec (js-call specs :get (get mod :spec))))
                     (when surfaceModule
                       (when (/= (get mod :source) (get surfaceModule :file))
                         (js-call errors :push (+ mod-name " source must match " (get surfaceModule :file))))
                       (when (/= (get mod :spec) (get surfaceModule :spec))
                         (js-call errors :push (+ mod-name " specification must match " (get surfaceModule :spec))))
                       (if (not spec)
                           (js-call errors :push (+ mod-name " references unknown specification " (str (get mod :spec))))
                         (progn
                           (when (/= (get spec :implementation) "implemented")
                             (js-call errors :push (+ mod-name " references non-implemented specification " (str (get mod :spec)))))
                           (when (/= (get mod :stability) (get spec :status))
                             (js-call errors :push (+ mod-name " stability must match specification " (str (get mod :spec)) " status " (get spec :status))))))
                       (unless (js-call ROLES :has (get mod :role))
                         (js-call errors :push (+ mod-name " has invalid role " (JSON/stringify (get mod :role)))))
                       (when (or (/= (value-type (get mod :summary)) "string")
                                 (/= (js-call (get mod :summary) :trim) (get mod :summary))
                                 (= (js-length (get mod :summary)) 0))
                         (js-call errors :push (+ mod-name " must have a non-empty trimmed summary")))
                       (js-call generatedModules :push
                         (js-object
                           :module mod-name
                           :source (get mod :source)
                           :spec (get mod :spec)
                           :specFile (if (and spec (get spec :file)) (get spec :file) "")
                           :stability (get mod :stability)
                           :role (get mod :role)
                           :summary (get mod :summary)
                           :exports (Array/from (get surfaceModule :exports)))))))))
              (setq idx (1+ idx)))
            (when (> (js-length errors) 0)
              (throw (ApiIndexValidationError errors)))
            (let ((exportCount (js-call generatedModules :reduce
                    (lambda (count mod) (+ count (js-length (get mod :exports))))
                    0)))
              (js-object
                :format "eliscript-library-api-index"
                :version 1
                :moduleCount (js-length generatedModules)
                :exportCount exportCount
                :modules generatedModules)))))))

  (defun escapeHtml (value)
    (let ((s (str value)))
      (setq s (js-call s :replaceAll "&" "&amp;"))
      (setq s (js-call s :replaceAll "<" "&lt;"))
      (setq s (js-call s :replaceAll ">" "&gt;"))
      (setq s (js-call s :replaceAll "\"" "&quot;"))
      (setq s (js-call s :replaceAll "'" "&#39;"))
      s))

  (defun renderApiJson (index)
    (+ (JSON/stringify index nil 2) "\n"))

  (defun renderModule (mod)
    (let* ((searchable (js-call
                         (js-call
                           (js-call (js-array (get mod :module) (get mod :summary) (get mod :role))
                                    :concat (get mod :exports))
                           :join " ")
                         :toLowerCase))
           (exports-html (js-call
                           (js-call (get mod :exports) :map
                             (lambda (name) (+ "<li><code>" (escapeHtml name) "</code></li>")))
                           :join "")))
      (+ "            <article class=\"api-module\" data-api-module data-api-searchable=\"" (escapeHtml searchable) "\">\n"
         "              <header class=\"api-module-header\">\n"
         "                <div><p class=\"api-module-path\">" (escapeHtml (get mod :source)) "</p><h3>" (escapeHtml (get mod :module)) "</h3></div>\n"
         "                <span class=\"status status-next\">" (escapeHtml (get mod :stability)) "</span>\n"
         "              </header>\n"
         "              <p>" (escapeHtml (get mod :summary)) "</p>\n"
         "              <p class=\"api-module-meta\"><a href=\"https://github.com/liuchong/eliscript/blob/master/" (escapeHtml (get mod :source)) "\">Source</a><a href=\"https://github.com/liuchong/eliscript/blob/master/" (escapeHtml (get mod :specFile)) "\" data-spec-link=\"" (escapeHtml (get mod :spec)) "\">Specification " (escapeHtml (get mod :spec)) "</a></p>\n"
         "              <ul class=\"api-export-list\" aria-label=\"" (escapeHtml (get mod :module)) " exports\">" exports-html "</ul>\n"
         "            </article>")))

  (defun renderSection (role title modules)
    (let ((export-total (js-call modules :reduce
                          (lambda (count mod) (+ count (js-length (get mod :exports))))
                          0)))
      (+ "          <section id=\"" (escapeHtml role) "\" data-api-section>\n"
         "            <h2>" (escapeHtml title) "</h2>\n"
         "            <p>" (str (js-length modules)) " modules, " (str export-total) " exports.</p>\n"
         (js-call (js-call modules :map renderModule) :join "\n") "\n"
         "          </section>")))

  (defun renderApiHtml (index)
    (let* ((sections (js-call ROLE_ENTRIES :map
                       (lambda (entry)
                         (let ((role (aref entry 0))
                               (title (aref entry 1)))
                           (renderSection
                             role
                             title
                             (js-call (get index :modules) :filter
                               (lambda (mod) (= (get mod :role) role))))))))
           (nav-links (js-call
                        (js-call ROLE_ENTRIES :map
                          (lambda (entry)
                            (let ((role (aref entry 0))
                                  (title (aref entry 1)))
                              (+ "<a href=\"#" role "\">" (escapeHtml title) "</a>"))))
                        :join "\n          ")))
      (+ "<!doctype html>\n"
         "<html lang=\"en\">\n"
         "  <head>\n"
         "    <meta charset=\"utf-8\">\n"
         "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
         "    <meta name=\"description\" content=\"The generated Eliscript standard-library module and export index.\">\n"
         "    <meta name=\"theme-color\" content=\"#f2f0e8\">\n"
         "    <title>Library API · Eliscript</title>\n"
         "    <link rel=\"icon\" type=\"image/png\" href=\"assets/favicon.png\">\n"
         "    <link rel=\"apple-touch-icon\" href=\"assets/eliscript-logo.png\">\n"
         "    <link rel=\"stylesheet\" href=\"assets/site.css\">\n"
         "    <!-- The page's behaviours are Eliscript: this loader compiles the source\n"
         "         it names and runs the result. Nothing here is handwritten JavaScript. -->\n"
         "    <script defer src=\"assets/eliscript-loader.js\"\n"
         "            data-eliscript=\"site.eli\"></script>\n"
         "  </head>\n"
         "  <body>\n"
         "    <a class=\"skip-link\" href=\"#main\">Skip to content</a>\n"
         "    <header class=\"site-header\">\n"
         "      <nav class=\"nav-shell\" aria-label=\"Primary navigation\">\n"
         "        <a class=\"brand\" href=\"../index.html\"><img class=\"brand-mark\" src=\"assets/eliscript-logo.png\" alt=\"\"><span>Eliscript</span></a>\n"
         "        <div class=\"nav-links\">\n"
         "          <a href=\"getting-started.html\">Start</a>\n"
         "          <a href=\"language.html\">Language</a>\n"
         "          <a href=\"api.html\" aria-current=\"page\">API</a>\n"
         "          <a class=\"nav-optional\" href=\"specifications.html\">Specs</a>\n"
         "          <a class=\"nav-optional\" href=\"roadmap.html\">Roadmap</a>\n"
         "          <a class=\"nav-optional\" href=\"playground.html\">Playground</a>\n"
         "          <a href=\"https://github.com/liuchong/eliscript\">GitHub</a>\n"
         "        </div>\n"
         "      </nav>\n"
         "    </header>\n\n"
         "    <main id=\"main\">\n"
         "      <header class=\"doc-hero\">\n"
         "        <div class=\"doc-hero-inner\">\n"
         "          <p class=\"eyebrow\">Library API</p>\n"
         "          <h1>One exact index for every library export.</h1>\n"
         "          <p class=\"doc-lede\">" (str (get index :moduleCount)) " modules and " (str (get index :exportCount)) " exports, generated from reviewed module metadata and the checked public surface.</p>\n"
         "        </div>\n"
         "      </header>\n\n"
         "      <div class=\"doc-shell\">\n"
         "        <nav class=\"doc-nav\" aria-label=\"On this page\">\n"
         "          <p class=\"doc-nav-title\">Library groups</p>\n"
         "          " nav-links "\n"
         "          <a href=\"api-index.json\">Machine-readable index</a>\n"
         "        </nav>\n\n"
         "        <article class=\"doc-content\">\n"
         "          <div class=\"api-toolbar\">\n"
         "            <input class=\"api-search\" type=\"search\" data-api-search aria-label=\"Search modules and exports\" placeholder=\"Search modules and exports\">\n"
         "            <p class=\"api-search-count\" aria-live=\"polite\" data-api-count>" (str (get index :moduleCount)) " modules</p>\n"
         "          </div>\n"
         (js-call sections :join "\n") "\n"
         "          <p class=\"api-empty\" data-api-empty hidden>No matching modules.</p>\n"
         "        </article>\n"
         "      </div>\n"
         "    </main>\n\n"
         "    <footer class=\"site-footer\"><div class=\"footer-shell\"><p>Eliscript · Library API</p><div class=\"footer-links\"><a href=\"language.html\">Language</a><a href=\"https://github.com/liuchong/eliscript/blob/master/LICENSE\">GPL-3.0+</a><a href=\"https://www.npmjs.com/package/eliscript/v/0.1.1\" data-version-npm>npm</a><a href=\"https://github.com/liuchong/eliscript\">GitHub</a><a href=\"https://github.com/liuchong/eliscript/releases/tag/v0.1.1\" data-version data-version-github>v0.1.1</a><span>© <span data-year>2026</span></span></div></div></footer>\n"
         "  </body>\n"
         "</html>\n")))

  (defasync generateApiArtifacts (&optional options-input)
    (let* ((options (if (or (nil? options-input) (undefined? options-input)) (js-object) options-input))
           (root (resolve (if (or (nil? (get options :root)) (undefined? (get options :root)))
                              DEFAULT_ROOT
                            (get options :root))))
           (outputRoot (resolve (if (or (nil? (get options :outputRoot)) (undefined? (get options :outputRoot)))
                                    root
                                  (get options :outputRoot))))
           (index (await (buildApiIndex (Object/assign (js-object) options (js-object :root root)))))
           (artifact-entries (js-array
             (js-array JSON_OUTPUT (renderApiJson index))
             (js-array HTML_OUTPUT (renderApiHtml index))))
           (stale (js-array))
           (idx 0))
      (while (< idx (js-length artifact-entries))
        (let* ((entry (aref artifact-entries idx))
               (relativePath (aref entry 0))
               (content (aref entry 1))
               (filename (join outputRoot relativePath)))
          (if (get options :check)
              (let ((existing (try (await (readFile filename "utf8"))
                                (catch err undefined))))
                (when (/= existing content)
                  (js-call stale :push relativePath)))
            (progn
              (await (mkdir (dirname filename) (js-object :recursive t)))
              (await (writeFile filename content "utf8")))))
        (setq idx (1+ idx)))
      (when (> (js-length stale) 0)
        (throw (ApiIndexValidationError
                 (js-array (+ "generated API artifacts are stale: " (js-call stale :join ", "))))))
      (js-object
        :index index
        :files (js-array JSON_OUTPUT HTML_OUTPUT))))

  (defconst invokedFilename
    (let ((arg1 (aref (get globalThis.process :argv) 1)))
      (if arg1 (resolve arg1) nil)))

  (when (and invokedFilename (js-call invokedFilename :endsWith "/tools/surface/generate-api.mjs"))
    (let* ((arguments_ (js-call (get globalThis.process :argv) :slice 2))
           (unknown (js-call arguments_ :filter (lambda (argument) (/= argument "--check")))))
      (if (> (js-length unknown) 0)
          (progn
            (js-call globalThis.console :error (+ "Unknown argument: " (aref unknown 0)))
            (put globalThis.process :exitCode 2))
        (js-call
          (funcall
            (async ()
              (try
                (let ((result (await (generateApiArtifacts
                                       (js-object :check (js-call arguments_ :includes "--check"))))))
                  (js-call globalThis.console :log
                    (+ (str (get (get result :index) :moduleCount)) " modules / "
                       (str (get (get result :index) :exportCount)) " exports; "
                       (if (js-call arguments_ :includes "--check") "verified" "generated") " "
                       (js-call (get result :files) :join ", "))))
                (catch error
                  (js-call globalThis.console :error (get error :message))
                  (put globalThis.process :exitCode 1)))))
          :catch
          (lambda (error)
            (js-call globalThis.console :error (get error :message))
            (put globalThis.process :exitCode 1))))))

  (export DEFAULT_ROOT ApiIndexValidationError buildApiIndex renderApiJson renderApiHtml generateApiArtifacts))
