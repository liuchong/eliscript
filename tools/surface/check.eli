(module tools.surface.check
  (import "node:fs/promises" readFile readdir)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst DEFAULT_ROOT (js-call path :resolve (js-call path :dirname module-file) "../.."))
  (defconst group-id-pattern "^[a-z][a-z0-9-]*$")
  (defconst ir-kinds-pattern "\\(defconst eliscript-ir-node-kinds\\s+'\\(([\\s\\S]*?)\\)\\s+\"Public")
  (defconst ir-name-pattern "[a-z][a-z0-9-]*")
  (defconst long-option-pattern "\"(--[a-z][a-z-]*)\"")
  (defconst export-declaration-pattern "^export\\s+(?:async\\s+)?(?:function\\s*\\*?|const|class)\\s+([A-Za-z_$][\\w$]*)")
  (defconst export-list-pattern "^export\\s*\\{([^}]*)\\}\\s*(?:from\\s*[\"'][^\"']+[\"'])?\\s*;?")
  (defconst export-default-pattern "^export\\s+default\\s+")
  (defconst export-as-pattern "\\s+as\\s+")
  (defconst export-name-pattern "[^\\s()]+")
  (defconst defun-pattern "^\\((?:cl-)?defun\\s+(eliscript-[^\\s()]+)")
  (defconst define-mode-pattern "^\\(define-(?:derived|compilation)-mode\\s+(eliscript-[^\\s()]+)")
  (defconst defstruct-pattern "^\\(cl-defstruct\\s+\\((eliscript-[^\\s()]+)")
  (defconst path-separator-pattern "[\\\\/]")
  (defconst export-boundary-pattern "[\\s)]")

  (defun surface-error-message (errors)
    (str "Public surface validation failed:\n"
         (js-call (js-call errors :map (lambda (error) (str "- " error))) :join "\n")))

  (defun surface-error-fields (self errors)
    (put self :name "SurfaceValidationError")
    (put self :errors errors)
    self)

  (defconst SurfaceValidationError
    (funcall
      (js* "(message, fields) => class SurfaceValidationError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      surface-error-message
      surface-error-fields))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun plain-object? (value)
    (and (not (nil? value))
         (= (host-type value) "object")
         (not (Array/isArray value))))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object)
      (aref supplied 0)))

  (defun json-equal (left right)
    (= (JSON/stringify left) (JSON/stringify right)))

  (defun nonempty-text? (value)
    (and (= (host-type value) "string") (> (js-length value) 0)))

  (defun regexp-test (source text flags)
    (js-call (new globalThis.RegExp source flags) :test text))

  (defun regexp-matches (text source flags)
    (Array/from (js-call text :matchAll (new globalThis.RegExp source flags))))

  (defun mapped (values mapper)
    (let ((result (js-array)) (index 0))
      (while (< index (js-length values))
        (js-call result :push (funcall mapper (aref values index)))
        (setq index (1+ index)))
      result))

  (defun some-bad-text (values)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length values)))
        (unless (nonempty-text? (aref values index))
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun safe-relative-path (value)
    (and (nonempty-text? value)
         (not (js-call path :isAbsolute value))
         (not (js-call (js-call value :split (new globalThis.RegExp path-separator-pattern "u")) :includes ".."))))

  (defun sorted-unique-strings (values label errors)
    (if (or (not (Array/isArray values)) (some-bad-text values))
      (progn
        (js-call errors :push (str label " must be an array of non-empty strings"))
        (js-array))
      (let ((sorted (js-call (Array/from (new globalThis.Set values)) :sort)))
        (unless (= (js-length sorted) (js-length values))
          (js-call errors :push (str label " contains duplicates")))
        (unless (json-equal sorted values)
          (js-call errors :push (str label " must be sorted")))
        sorted)))

  (defun compare-inventory (label expected actual errors)
    (let ((expected-set (new globalThis.Set expected))
          (actual-set (new globalThis.Set actual))
          (missing (js-array))
          (stale (js-array))
          (index 0))
      (while (< index (js-length actual))
        (let ((value (aref actual index)))
          (unless (js-call expected-set :has value)
            (js-call missing :push value)))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length expected))
        (let ((value (aref expected index)))
          (unless (js-call actual-set :has value)
            (js-call stale :push value)))
        (setq index (1+ index)))
      (when (> (js-length missing) 0)
        (js-call errors :push (str label " is missing current entries: " (js-call missing :join ", "))))
      (when (> (js-length stale) 0)
        (js-call errors :push (str label " declares absent entries: " (js-call stale :join ", "))))))

  (defasync read-json (filename)
    (JSON/parse (await (readFile filename "utf8"))))

  (defasync read-surface-file (root relative-path cache errors)
    (if (not (safe-relative-path relative-path))
      (progn
        (js-call errors :push (str "unsafe surface path " (JSON/stringify relative-path)))
        "")
      (let ((filename (js-call path :resolve root relative-path)))
        (try
          (unless (js-call cache :has filename)
            (js-call cache :set filename (await (readFile filename "utf8"))))
          (js-call cache :get filename)
          (catch error
            (js-call errors :push (str relative-path " cannot be read: " (get error :message)))
            "")))))

  (defun validate-spec (specs spec-id label errors)
    (let ((spec (js-call specs :get spec-id)))
      (if (not spec)
        (js-call errors :push (str label " references unknown specification " spec-id))
        (unless (= (get spec :implementation) "implemented")
          (js-call errors :push (str label " references non-implemented specification " spec-id))))))

  (defasync validate-language (root language specs cache errors)
    (if (or (not (plain-object? language)) (not (Array/isArray (get language :groups))))
      (progn
        (js-call errors :push "language groups must be an array")
        (js-object :groups 0 :entries 0))
      (let ((ids (new globalThis.Set)) (entries 0) (index 0) (groups (get language :groups)))
        (while (< index (js-length groups))
          (let ((group (aref groups index)) (label (str "language group " index)))
            (if (not (plain-object? group))
              (js-call errors :push (str label " must be an object"))
              (progn
                (if (not (regexp-test group-id-pattern (get group :id "") "u"))
                  (js-call errors :push (str label " has invalid id " (JSON/stringify (get group :id))))
                  (when (js-call ids :has (get group :id))
                    (js-call errors :push (str "duplicate language group " (get group :id)))))
                (js-call ids :add (get group :id))
                (validate-spec specs (get group :spec) (get group :id) errors)
                (let ((names (sorted-unique-strings (get group :names) (str (get group :id) " names") errors))
                      (sources (sorted-unique-strings (get group :sources) (str (get group :id) " sources") errors))
                      (combined "")
                      (source-index 0))
                  (setq entries (+ entries (js-length names)))
                  (while (< source-index (js-length sources))
                    (setq combined (str combined (await (read-surface-file root (aref sources source-index) cache errors))))
                    (setq source-index (1+ source-index)))
                  (cond
                    ((= (get group :verifyNames) t)
                     (let ((name-index 0))
                       (while (< name-index (js-length names))
                         (let ((name (aref names name-index)))
                           (unless (js-call combined :includes name)
                             (js-call errors :push (str (get group :id) " form " (JSON/stringify name) " is absent from its sources"))))
                         (setq name-index (1+ name-index)))))
                    ((not (= (get group :verifyNames) false))
                     (js-call errors :push (str (get group :id) " verifyNames must be true or false"))))))))
          (setq index (1+ index)))
        (js-object :groups (js-length groups) :entries entries))))

  (defun extract-ir-kinds (source)
    (let ((match (js-call source :match (new globalThis.RegExp ir-kinds-pattern "u"))))
      (if (nullish? match)
        (js-array)
        (let ((found (js-call (aref match 1) :match (new globalThis.RegExp ir-name-pattern "gu"))))
          (if (nullish? found) (js-array) (js-call found :sort))))))

  (defasync validate-ir (root ir cache errors)
    (if (not (plain-object? ir))
      (progn
        (js-call errors :push "ir surface must be an object")
        0)
      (let ((expected (sorted-unique-strings (get ir :nodeKinds) "IR node kinds" errors))
            (source (await (read-surface-file root (get ir :source) cache errors))))
        (compare-inventory "IR node kind inventory" expected (extract-ir-kinds source) errors)
        (js-length expected))))

  (defun extract-long-options (source)
    (js-call (Array/from (new globalThis.Set (mapped (regexp-matches source long-option-pattern "gu")
                                              (lambda (match) (aref match 1)))))
      :sort))

  (defasync validate-commands (root commands cache errors)
    (if (not (Array/isArray commands))
      (progn
        (js-call errors :push "commands must be an array")
        (js-object :commands 0 :options 0))
      (let ((names (js-array)) (option-count 0) (index 0))
        (while (< index (js-length commands))
          (let ((command (aref commands index)) (label (str "command " index)))
            (when (plain-object? command)
              (js-call names :push (get command :name))
              (let ((options (sorted-unique-strings (get command :options) (str (get command :name) " options") errors)))
                (setq option-count (+ option-count (js-length options)))
                (await (read-surface-file root (get command :entry) cache errors))
                (let ((implementation (await (read-surface-file root (get command :implementation) cache errors))))
                  (compare-inventory (str (get command :name) " option inventory") options
                    (extract-long-options implementation) errors)))))
          (unless (plain-object? (aref commands index))
            (js-call errors :push (str "command " index " must be an object")))
          (setq index (1+ index)))
        (sorted-unique-strings names "command names" errors)
        (js-object :commands (js-length commands) :options option-count))))

  (defun export-alias (entry)
    (let* ((parts (js-call (js-call entry :trim) :split (new globalThis.RegExp export-as-pattern "u")))
           (last (if (= (js-length parts) 0) undefined (aref parts (1- (js-length parts))))))
      (if (nullish? last) undefined (js-call last :trim))))

  (defun extract-js-exports (source)
    (let ((declarations (mapped (regexp-matches source export-declaration-pattern "gmu")
                           (lambda (match) (aref match 1))))
          (lists (js-array))
          (matches (regexp-matches source export-list-pattern "gmu"))
          (index 0))
      (while (< index (js-length matches))
        (let ((pieces (js-call (aref (aref matches index) 1) :split ",")) (piece-index 0))
          (while (< piece-index (js-length pieces))
            (let ((name (export-alias (aref pieces piece-index))))
              (when (host-truthy name)
                (js-call lists :push name)))
            (setq piece-index (1+ piece-index))))
        (setq index (1+ index)))
      (js-object :named (js-call (Array/from (new globalThis.Set (js-call declarations :concat lists))) :sort)
        :defaultExport (regexp-test export-default-pattern source "mu"))))

  (defun count-default (value)
    (if (host-truthy value) 1 0))

  (defasync validate-adapters (root adapters specs cache errors)
    (if (not (Array/isArray adapters))
      (progn
        (js-call errors :push "adapters must be an array")
        (js-object :adapters 0 :exports 0))
      (let ((ids (js-array)) (export-count 0) (index 0))
        (while (< index (js-length adapters))
          (let ((adapter (aref adapters index)))
            (if (not (plain-object? adapter))
              (js-call errors :push (str "adapter " index " must be an object"))
              (let ((expected (sorted-unique-strings (get adapter :namedExports)
                                (str (get adapter :id) " named exports") errors))
                    (source (await (read-surface-file root (get adapter :file) cache errors))))
                (js-call ids :push (get adapter :id))
                (validate-spec specs (get adapter :spec) (get adapter :id) errors)
                (let ((actual (extract-js-exports source)))
                  (compare-inventory (str (get adapter :id) " export inventory") expected (get actual :named) errors)
                  (unless (= (get adapter :defaultExport) (get actual :defaultExport))
                    (js-call errors :push (str (get adapter :id) " default export does not match its implementation")))
                  (setq export-count (+ export-count (js-length expected) (count-default (get adapter :defaultExport))))))))
          (setq index (1+ index)))
        (sorted-unique-strings ids "adapter ids" errors)
        (js-object :adapters (js-length adapters) :exports export-count))))

  (defasync validate-platform-packages (root packages specs cache errors)
    (if (not (Array/isArray packages))
      (progn
        (js-call errors :push "platformPackages must be an array")
        (js-object :packages 0 :exports 0))
      (let ((ids (js-array)) (export-count 0) (index 0))
        (while (< index (js-length packages))
          (let ((package (aref packages index)))
            (if (not (plain-object? package))
              (js-call errors :push (str "platform package " index " must be an object"))
              (progn
                (js-call ids :push (get package :id))
                (validate-spec specs (get package :spec) (get package :id) errors)
                (unless (or (= (get package :host) "browser") (= (get package :host) "worker"))
                  (js-call errors :push (str (get package :id) " has invalid platform host " (JSON/stringify (get package :host)))))
                (let ((spec (js-call specs :get (get package :spec))))
                  (when (and spec (not (= (get package :stability) (get spec :status))))
                    (js-call errors :push (str (get package :id) " stability must match specification "
                                               (get package :spec) " status " (get spec :status)))))
                (let ((expected (sorted-unique-strings (get package :namedExports)
                                  (str (get package :id) " named exports") errors))
                      (source (await (read-surface-file root (get package :file) cache errors)))
                      (actual nil))
                  (setq actual (extract-js-exports source))
                  (compare-inventory (str (get package :id) " export inventory") expected (get actual :named) errors)
                  (unless (= (get package :defaultExport) (get actual :defaultExport))
                    (js-call errors :push (str (get package :id) " default export does not match its implementation")))
                  (setq export-count (+ export-count (js-length expected) (count-default (get package :defaultExport))))))))
          (setq index (1+ index)))
        (sorted-unique-strings ids "platform package ids" errors)
        (js-object :packages (js-length packages) :exports export-count))))

  (defasync validate-runtime-modules (root modules specs cache errors)
    (if (not (Array/isArray modules))
      (progn
        (js-call errors :push "runtimeModules must be an array")
        (js-object :modules 0 :exports 0 :public 0 :internal 0))
      (let ((ids (js-array)) (export-count 0) (public-count 0) (internal-count 0) (index 0))
        (while (< index (js-length modules))
          (let ((module (aref modules index)))
            (if (not (plain-object? module))
              (js-call errors :push (str "runtime module " index " must be an object"))
              (progn
                (js-call ids :push (get module :id))
                (validate-spec specs (get module :spec) (get module :id) errors)
                (cond
                  ((= (get module :visibility) "public") (setq public-count (1+ public-count)))
                  ((= (get module :visibility) "internal") (setq internal-count (1+ internal-count)))
                  (t (js-call errors :push (str (get module :id) " has invalid visibility "
                                                (JSON/stringify (get module :visibility))))))
                (let ((expected (sorted-unique-strings (get module :namedExports)
                                  (str (get module :id) " named exports") errors))
                      (source (await (read-surface-file root (get module :file) cache errors)))
                      (actual (extract-js-exports "")))
                  (setq actual (extract-js-exports source))
                  (compare-inventory (str (get module :id) " export inventory") expected (get actual :named) errors)
                  (unless (= (get module :defaultExport) (get actual :defaultExport))
                    (js-call errors :push (str (get module :id) " default export does not match its implementation")))
                  (setq export-count (+ export-count (js-length expected) (count-default (get module :defaultExport))))))))
          (setq index (1+ index)))
        (sorted-unique-strings ids "runtime module ids" errors)
        (js-object :modules (js-length modules) :exports export-count :public public-count :internal internal-count))))

  (defun extractLibraryExports (source)
    (let ((start (js-call source :lastIndexOf "(export")))
      (if (or (< start 0)
              (not (regexp-test export-boundary-pattern
                     (let ((character (aref source (+ start 7))))
                       (if (undefined? character) "" character))
                     "u")))
        (js-array)
        (let ((depth 0) (index start) (done nil) (names nil))
          (while (and (not done) (< index (js-length source)))
            (cond
              ((= (aref source index) "(") (setq depth (1+ depth)))
              ((= (aref source index) ")")
               (setq depth (1- depth))
               (when (= depth 0)
                 (let ((found (js-call (js-call source :slice (+ start 7) index)
                                :match (new globalThis.RegExp export-name-pattern "gu"))))
                   (setq names (if (nullish? found) (js-array) (js-call found :sort)))
                   (setq done t)))))
            (setq index (1+ index)))
          (if names names (js-array))))))

  (defasync validate-standard-library (root modules specs cache errors)
    (if (not (Array/isArray modules))
      (progn
        (js-call errors :push "standardLibrary must be an array")
        (js-object :modules 0 :exports 0))
      (let ((names (js-array)) (export-count 0) (index 0))
        (while (< index (js-length modules))
          (let ((module (aref modules index)) (label (str "standard library module " index)))
            (if (not (plain-object? module))
              (js-call errors :push (str label " must be an object"))
              (let ((expected (sorted-unique-strings (get module :exports)
                                (str (get module :module) " exports") errors))
                    (source (await (read-surface-file root (get module :file) cache errors))))
                (js-call names :push (get module :module))
                (validate-spec specs (get module :spec) (get module :module) errors)
                (compare-inventory (str (get module :module) " export inventory") expected
                  (extractLibraryExports source) errors)
                (setq export-count (+ export-count (js-length expected))))))
          (setq index (1+ index)))
        (sorted-unique-strings names "standard library modules" errors)
        (js-object :modules (js-length modules) :exports export-count))))

  (defasync elisp-files (root relative-roots errors)
    (let ((files (js-array)) (index 0))
      (while (< index (js-length relative-roots))
        (let ((relative-root (aref relative-roots index)))
          (if (not (safe-relative-path relative-root))
            (js-call errors :push (str "unsafe Emacs root " (JSON/stringify relative-root)))
            (try
              (let ((entries (await (readdir (js-call path :resolve root relative-root)))) (entry-index 0))
                (while (< entry-index (js-length entries))
                  (let ((entry (aref entries entry-index)))
                    (when (js-call entry :endsWith ".el")
                      (js-call files :push (str relative-root "/" entry))))
                  (setq entry-index (1+ entry-index))))
              (catch error
                (js-call errors :push (str relative-root " cannot be listed: " (get error :message)))))))
        (setq index (1+ index)))
      (js-call files :sort)))

  (defun collect-matches (source pattern into)
    (let ((matches (regexp-matches source pattern "gmu")) (index 0))
      (while (< index (js-length matches))
        (let ((name (aref (aref matches index) 1)))
          (unless (js-call name :includes "--")
            (js-call into :push name)))
        (setq index (1+ index)))))

  (defun collect-records (source into)
    (let ((matches (regexp-matches source defstruct-pattern "gmu")) (index 0))
      (while (< index (js-length matches))
        (js-call into :push (aref (aref matches index) 1))
        (setq index (1+ index)))))

  (defasync validate-emacs (root emacs cache errors)
    (if (not (plain-object? emacs))
      (progn
        (js-call errors :push "emacs surface must be an object")
        (js-object :functions 0 :records 0))
      (let* ((roots (sorted-unique-strings (get emacs :roots) "Emacs roots" errors))
             (expected-functions (sorted-unique-strings (get emacs :publicFunctions) "Emacs public functions" errors))
             (records (host-get emacs "records"))
             (public-records (sorted-unique-strings (host-get records "public") "Emacs public records" errors))
             (internal-records (sorted-unique-strings (host-get records "internal") "Emacs internal records" errors))
             (files (await (elisp-files root roots errors)))
             (actual-functions (js-array))
             (actual-records (js-array))
             (index 0))
        (while (< index (js-length files))
          (let ((source (await (read-surface-file root (aref files index) cache errors))))
            (collect-matches source defun-pattern actual-functions)
            (collect-matches source define-mode-pattern actual-functions)
            (collect-records source actual-records))
          (setq index (1+ index)))
        (compare-inventory "Emacs public function inventory" expected-functions
          (js-call (Array/from (new globalThis.Set actual-functions)) :sort) errors)
        (compare-inventory "Emacs record inventory"
          (js-call (js-call public-records :concat internal-records) :sort)
          (js-call (Array/from (new globalThis.Set actual-records)) :sort) errors)
        (let ((overlap (js-array)) (record-index 0))
          (while (< record-index (js-length public-records))
            (let ((name (aref public-records record-index)))
              (when (js-call internal-records :includes name)
                (js-call overlap :push name)))
            (setq record-index (1+ record-index)))
          (when (> (js-length overlap) 0)
            (js-call errors :push (str "Emacs records have conflicting visibility: " (js-call overlap :join ", ")))))
        (js-object :functions (js-length expected-functions)
          :records (+ (js-length public-records) (js-length internal-records))
          :publicRecords (js-length public-records)
          :internalRecords (js-length internal-records)))))

  (defun present-list (value)
    (if (nullish? value) (js-array) value))

  (defasync validate-schemas (root schemas specs cache errors)
    (if (not (Array/isArray schemas))
      (progn
        (js-call errors :push "schemas must be an array")
        0)
      (let ((ids (js-array)) (index 0))
        (while (< index (js-length schemas))
          (let ((schema (aref schemas index)))
            (if (not (plain-object? schema))
              (js-call errors :push (str "schema " index " must be an object"))
              (let ((evidence (present-list (get schema :evidence))) (evidence-index 0))
                (js-call ids :push (get schema :id))
                (validate-spec specs (get schema :spec) (get schema :id) errors)
                (unless (and (= (host-type (get schema :format)) "string")
                             (Number/isInteger (get schema :version)))
                  (js-call errors :push (str (get schema :id) " must declare a format and integer version")))
                (while (< evidence-index (js-length evidence))
                  (let* ((item (aref evidence evidence-index))
                         (source (await (read-surface-file root (get item :file) cache errors)))
                         (locators (present-list (get item :contains)))
                         (locator-index 0))
                    (while (< locator-index (js-length locators))
                      (let ((locator (aref locators locator-index)))
                        (unless (js-call source :includes locator)
                          (js-call errors :push (str (get schema :id) " locator " (JSON/stringify locator)
                                                     " is absent from " (get item :file)))))
                      (setq locator-index (1+ locator-index))))
                  (setq evidence-index (1+ evidence-index))))))
          (setq index (1+ index)))
        (sorted-unique-strings ids "schema ids" errors)
        (js-length schemas))))

  (defasync validate-documents (root documents cache errors)
    (when (not (Array/isArray documents))
      (js-call errors :push "documentation assertions must be an array"))
    (when (Array/isArray documents)
      (let ((index 0))
        (while (< index (js-length documents))
          (let* ((document (aref documents index))
                 (source (await (read-surface-file root (get document :file) cache errors)))
                 (required (present-list (get document :mustContain)))
                 (forbidden (present-list (get document :mustNotContain)))
                 (locator-index 0))
            (while (< locator-index (js-length required))
              (let ((locator (aref required locator-index)))
                (unless (js-call source :includes locator)
                  (js-call errors :push (str (get document :file) " is missing required text " (JSON/stringify locator)))))
              (setq locator-index (1+ locator-index)))
            (setq locator-index 0)
            (while (< locator-index (js-length forbidden))
              (let ((locator (aref forbidden locator-index)))
                (when (js-call source :includes locator)
                  (js-call errors :push (str (get document :file) " retains stale text " (JSON/stringify locator)))))
              (setq locator-index (1+ locator-index))))
          (setq index (1+ index))))))

  (defasync checkPublicSurface (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (errors (js-array))
           (cache (new globalThis.Map))
           (surface (if (nullish? (get options :surface))
                      (await (read-json (js-call path :join root "contracts/public-surface.json")))
                      (get options :surface)))
           (spec-index (if (nullish? (get options :specIndex))
                         (await (read-json (js-call path :join root "specs/index.json")))
                         (get options :specIndex)))
           (listed (present-list (get spec-index :specifications)))
           (specs (new globalThis.Map (js-call listed :map (lambda (spec) (js-array (get spec :id) spec))))))
      (unless (and (plain-object? surface) (= (get surface :schemaVersion) 1))
        (throw (new SurfaceValidationError (js-array "public surface must use schemaVersion 1"))))
      (let ((language (await (validate-language root (get surface :language) specs cache errors)))
            (ir-node-kinds (await (validate-ir root (get surface :ir) cache errors)))
            (commands (await (validate-commands root (get surface :commands) cache errors)))
            (schemas (await (validate-schemas root (get surface :schemas) specs cache errors)))
            (adapters (await (validate-adapters root (get surface :adapters) specs cache errors)))
            (platform-packages (await (validate-platform-packages root (get surface :platformPackages) specs cache errors)))
            (runtime-modules (await (validate-runtime-modules root (get surface :runtimeModules) specs cache errors)))
            (standard-library (await (validate-standard-library root (get surface :standardLibrary) specs cache errors)))
            (emacs (await (validate-emacs root (get surface :emacs) cache errors))))
        (await (validate-documents root (get surface :documentation) cache errors))
        (when (> (js-length errors) 0)
          (throw (new SurfaceValidationError errors)))
        (js-object :schemaVersion 1 :language language :ir (js-object :nodeKinds ir-node-kinds)
          :commands commands :schemas (js-object :total schemas) :adapters adapters
          :platformPackages platform-packages :runtimeModules runtime-modules
          :standardLibrary standard-library :emacs emacs))))

  (defun humanSurfaceReport (report)
    (js-call (js-array
               "Public surface matrix:"
               (str "  Language       " (get (get report :language) :groups) " groups / " (get (get report :language) :entries) " entries")
               (str "  IR             " (get (get report :ir) :nodeKinds) " node kinds")
               (str "  Commands       " (get (get report :commands) :commands) " commands / " (get (get report :commands) :options) " options")
               (str "  Schemas        " (get (get report :schemas) :total) " versioned schemas")
               (str "  Adapters       " (get (get report :adapters) :adapters) " adapters / " (get (get report :adapters) :exports) " exports")
               (str "  Platform       " (get (get report :platformPackages) :packages) " packages / " (get (get report :platformPackages) :exports) " exports")
               (str "  Runtime        " (get (get report :runtimeModules) :modules) " modules / " (get (get report :runtimeModules) :exports) " exports")
               (str "  Standard lib   " (get (get report :standardLibrary) :modules) " modules / " (get (get report :standardLibrary) :exports) " exports")
               (str "  Emacs API      " (get (get report :emacs) :functions) " functions / " (get (get report :emacs) :records) " records"))
      :join "\n"))

  (defasync main ()
    (let ((unknown (js-call (js-call (get globalThis.process :argv) :slice 2) :filter
                     (lambda (argument) (not (= argument "--json"))))))
      (if (> (js-length unknown) 0)
        (progn
          (console/error (str "Unknown argument: " (aref unknown 0)))
          (put globalThis.process :exitCode 2))
        (try
          (let ((report (await (checkPublicSurface))))
            (console/log (if (js-call (get globalThis.process :argv) :includes "--json")
                           (JSON/stringify report)
                           (humanSurfaceReport report))))
          (catch error
            (console/error (get error :message))
            (put globalThis.process :exitCode 1))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (host-truthy entry) (= (js-call path :resolve entry) module-file))
      (main)))

  (export DEFAULT_ROOT SurfaceValidationError extractLibraryExports checkPublicSurface humanSurfaceReport))
