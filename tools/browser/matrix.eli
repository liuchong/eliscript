(module tools.browser.matrix
  (import "playwright-core" chromium firefox webkit)
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile readdir stat writeFile)
  (import "node:path" join resolve)

  (defconst ENGINES (js-call globalThis.Object :freeze (js-array "chromium" "firefox" "webkit")))
  (defconst VIEWPORTS
    (js-call globalThis.Object :freeze
      (js-array
        (js-object :name "narrow" :viewport (js-object :width 320 :height 640)
          :isMobile t :hasTouch t :deviceScaleFactor 2)
        (js-object :name "mobile" :viewport (js-object :width 390 :height 844)
          :isMobile t :hasTouch t :deviceScaleFactor 3)
        (js-object :name "desktop" :viewport (js-object :width 1280 :height 800)))))
  (defconst drivers (js-object :chromium chromium :firefox firefox :webkit webkit))
  (defconst color-pattern "rgba?\\(([^)]+)\\)")
  (defconst channel-pattern "[\\s,/]+")

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun defined-or (object key default)
    (let ((value (get object key)))
      (if (undefined? value) default value)))

  (defun parseColor (value)
    (let ((match (js-call (new globalThis.RegExp color-pattern "u") :exec (if (nullish? value) "" value))))
      (if (not match)
        nil
        (let ((parts (js-call (js-call (js-call (aref match 1) :split (new globalThis.RegExp channel-pattern "u"))
                                 :filter host-truthy)
                        :map globalThis.Number)))
          (if (or (< (js-length parts) 3) (js-call parts :some (get globalThis.Number :isNaN)))
            nil
            (js-call parts :slice 0 3))))))

  (defun channel-luminance (value)
    (let ((scaled (/ value 255)))
      (if (<= scaled 0.03928)
        (/ scaled 12.92)
        (js-call globalThis.Math :pow (/ (+ scaled 0.055) 1.055) 2.4))))

  (defun contrastRatio (foreground background)
    (let* ((first (+ (* 0.2126 (channel-luminance (aref foreground 0)))
                     (* 0.7152 (channel-luminance (aref foreground 1)))
                     (* 0.0722 (channel-luminance (aref foreground 2)))))
           (second (+ (* 0.2126 (channel-luminance (aref background 0)))
                      (* 0.7152 (channel-luminance (aref background 1)))
                      (* 0.0722 (channel-luminance (aref background 2)))))
           (lighter (js-call globalThis.Math :max first second))
           (darker (js-call globalThis.Math :min first second)))
      (/ (+ lighter 0.05) (+ darker 0.05))))

  (defasync visible (page selector)
    (await (js-call (js-call (js-call page :locator selector) :first) :isVisible)))

  (defasync scripted-checks (page base viewport)
    (let ((failures (js-array)) (measured (js-object)))
      (await (js-call page :goto base (js-object :waitUntil "load")))
      (put measured :title (await (js-call page :title)))
      (unless (host-truthy (js-call (get measured :title) :trim))
        (js-call failures :push "the home page has no title"))
      (unless (await (visible page "h1"))
        (js-call failures :push "the home page has no visible first-level heading"))
      (unless (await (visible page ".wordmark"))
        (js-call failures :push "the publication identity is not visible"))
      (put measured :overflow (await (js-call page :evaluate
                                       (js* "() => ({ scrollWidth: document.documentElement.scrollWidth, innerWidth: window.innerWidth })"))))
      (when (> (get (get measured :overflow) :scrollWidth) (+ (get (get measured :overflow) :innerWidth) 1))
        (js-call failures :push
          (str "the page is " (get (get measured :overflow) :scrollWidth) "px wide in a "
               (get (get measured :overflow) :innerWidth) "px viewport")))
      (let ((summary-visible (await (visible page ".menu > summary")))
            (links-visible (await (visible page ".menu > nav a"))))
        (put measured :navigation (js-object :summaryVisible summary-visible :linksVisible links-visible))
        (if (get viewport :isMobile)
          (progn
            (unless summary-visible (js-call failures :push "the narrow layout hides the navigation control"))
            (when links-visible (js-call failures :push "the narrow layout shows the links before they are asked for"))
            (await (js-call (js-call (js-call page :locator ".menu > summary") :first) :click))
            (await (js-call page :waitForTimeout 120))
            (unless (await (visible page ".menu > nav a"))
              (js-call failures :push "opening the navigation control does not reveal the links")))
          (unless links-visible
            (js-call failures :push "the wide layout hides the navigation links"))))
      (let ((toggle (js-call (js-call page :locator "#theme-toggle") :first)))
        (if (= (await (js-call toggle :count)) 0)
          (js-call failures :push "there is no theme control")
          (progn
            (await (js-call toggle :click))
            (await (js-call page :waitForTimeout 80))
            (put measured :theme (await (js-call page :evaluate
                                          (js* "() => document.documentElement.getAttribute(\"data-theme\")"))))
            (unless (host-truthy (get measured :theme))
              (js-call failures :push "the theme control does not select a theme"))
            (await (js-call page :reload (js-object :waitUntil "load")))
            (unless (= (await (js-call page :evaluate
                                (js* "() => document.documentElement.getAttribute(\"data-theme\")")))
                       (get measured :theme))
              (js-call failures :push "the selected theme is not restored after a reload")))))
      (let* ((colors (await (js-call page :evaluate
                              (js* "() => { const body = getComputedStyle(document.body); return { foreground: body.color, background: body.backgroundColor }; }"))))
             (foreground (parseColor (get colors :foreground)))
             (background (parseColor (get colors :background))))
        (put measured :contrast (if (and foreground background) (contrastRatio foreground background) nil))
        (if (nil? (get measured :contrast))
          (js-call failures :push "the text or page colour could not be read")
          (when (< (get measured :contrast) 4.5)
            (js-call failures :push (str "body contrast is " (js-call (get measured :contrast) :toFixed 2) ", below 4.5")))))
      (await (js-call page :goto (str base "search/") (js-object :waitUntil "load")))
      (let ((input (js-call (js-call page :locator "#search-input") :first)))
        (if (= (await (js-call input :count)) 0)
          (js-call failures :push "the search page has no input")
          (progn
            (await (js-call input :fill "a"))
            (await (js-call page :waitForTimeout 600))
            (put measured :searchResults (await (js-call (js-call page :locator "#search-results li") :count)))
            (when (< (get measured :searchResults) 1)
              (js-call failures :push "a search for a common letter returns nothing")))))
      (js-object :failures failures :measured measured)))

  (defasync scriptless-checks (page base)
    (let ((failures (js-array)) (measured (js-object)))
      (await (js-call page :goto (str base "archive/") (js-object :waitUntil "load")))
      (let ((href (await (js-call (js-call (js-call page :locator ".list a.title") :first) :getAttribute "href"))))
        (if (not (host-truthy href))
          (progn
            (js-call failures :push "the archive lists no article to read")
            (js-object :failures failures :measured measured))
          (progn
            (await (js-call page :goto (get (new globalThis.URL href (str base "archive/")) :href)
                     (js-object :waitUntil "load")))
            (put measured :articleCharacters
              (js-length (js-call (await (js-call (js-call (js-call page :locator "article") :first) :innerText)) :trim)))
            (when (< (get measured :articleCharacters) 200)
              (js-call failures :push (str "the article is " (get measured :articleCharacters) " characters without scripts")))
            (unless (await (visible page "article h1"))
              (js-call failures :push "the article heading is not visible without scripts"))
            (put measured :scriptCount (await (js-call (js-call page :locator "script") :count)))
            (js-object :failures failures :measured measured))))))

  (defun content-type (path)
    (cond
      ((js-call path :endsWith ".html") "text/html; charset=utf-8")
      ((js-call path :endsWith ".css") "text/css; charset=utf-8")
      ((or (js-call path :endsWith ".js") (js-call path :endsWith ".mjs")) "text/javascript; charset=utf-8")
      ((js-call path :endsWith ".map") "application/json; charset=utf-8")
      ((js-call path :endsWith ".svg") "image/svg+xml")
      ((js-call path :endsWith ".json") "application/json; charset=utf-8")
      ((js-call path :endsWith ".xml") "application/xml; charset=utf-8")
      (t "application/octet-stream")))

  (defasync serveTree (directory port)
    (let* ((root (resolve directory))
           (server (globalThis.Bun.serve
                     (js-object :port port :hostname "127.0.0.1"
                       :fetch (async (request)
                                (let ((path (join root (funcall globalThis.decodeURIComponent
                                                         (get (new globalThis.URL (get request :url)) :pathname)))))
                                  (when (js-call path :endsWith "/")
                                    (setq path (join path "index.html")))
                                  (try
                                    (let ((info (await (stat path))))
                                      (when (js-call info :isDirectory)
                                        (setq path (join path "index.html")))
                                      (new globalThis.Response (await (readFile path))
                                        (js-object :headers (js-object "content-type" (content-type path)))))
                                    (catch ignored
                                      (new globalThis.Response "not found" (js-object :status 404))))))))))
      (js-object :origin (str "http://127.0.0.1:" (get server :port) "/")
        :stop (lambda () (js-call server :stop t)))))

  (defasync fingerprint-walk (digest path relative-name)
    (let ((entries (js-call (await (readdir path (js-object :withFileTypes t))) :sort
                     (lambda (left right) (js-call (get left :name) :localeCompare (get right :name)))))
          (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index))
               (child (join path (get entry :name)))
               (name (if (host-truthy relative-name) (str relative-name "/" (get entry :name)) (get entry :name))))
          (if (js-call entry :isDirectory)
            (await (fingerprint-walk digest child name))
            (progn
              (js-call digest :update name)
              (js-call digest :update (await (readFile child))))))
        (setq index (1+ index)))))

  (defasync fingerprintTree (directory)
    (let ((digest (createHash "sha256")))
      (await (fingerprint-walk digest (resolve directory) ""))
      (js-call digest :digest "hex")))

  (defun known-engines (engines)
    (let ((index 0) (bad nil))
      (while (and (not bad) (< index (js-length engines)))
        (let ((name (aref engines index)))
          (when (or (not (= (host-type name) "string"))
                    (not (js-call globalThis.Object :hasOwn drivers name)))
            (setq bad t)))
        (setq index (1+ index)))
      bad))

  (defun context-options (spec scriptless)
    (let ((options (js-object :viewport (get spec :viewport)
                     :isMobile (host-truthy (get spec :isMobile))
                     :hasTouch (host-truthy (get spec :hasTouch))
                     :deviceScaleFactor (get spec :deviceScaleFactor 1))))
      (when scriptless (put options :javaScriptEnabled false))
      options))

  (defasync runMatrix (input)
    (let ((site (get input :site))
          (engines (defined-or input "engines" ENGINES))
          (port (defined-or input "port" 8899)))
      (when (or (not (Array/isArray engines)) (= (js-length engines) 0)
                (not (= (get (new globalThis.Set engines) :size) (js-length engines)))
                (known-engines engines))
        (throw (new globalThis.Error "engines must name nonempty, unique known engines")))
      (let ((server (await (serveTree site port)))
            (failures (js-array)))
        (try
          (let ((report (js-object :format "dogfood-browser-matrix" :version 1
                          :viewports (js-call VIEWPORTS :map (lambda (entry) (get entry :name)))
                          :siteFingerprint (await (fingerprintTree site))
                          :engines (js-array)))
                (engine-index 0))
            (while (< engine-index (js-length engines))
              (let* ((name (aref engines engine-index))
                     (driver (get drivers name))
                     (entry (js-object :name name :version nil :viewports (js-array)))
                     (browser nil))
                (unless driver (throw (new globalThis.Error (str "unknown engine " name))))
                (try
                  (setq browser (await (js-call driver :launch)))
                  (put entry :version (js-call browser :version))
                  (let ((checks (await (js-call globalThis.Promise :allSettled
                                         (js-call VIEWPORTS :map
                                           (lambda (spec)
                                             (funcall (async ()
                                               (let ((context (await (js-call browser :newContext (context-options spec nil))))
                                                     (scripted nil)
                                                     (plain nil))
                                                 (try
                                                   (setq scripted (await (scripted-checks (await (js-call context :newPage))
                                                                     (get server :origin) spec)))
                                                   (finally (await (js-call context :close))))
                                                 (let ((plain-context (await (js-call browser :newContext (context-options spec t)))))
                                                   (try
                                                     (setq plain (await (scriptless-checks (await (js-call plain-context :newPage))
                                                                      (get server :origin))))
                                                     (finally (await (js-call plain-context :close)))))
                                                 (js-object :scripted scripted :plain plain)))))))))
                        (check-index 0))
                    (while (< check-index (js-length checks))
                      (let ((check (aref checks check-index)) (spec (aref VIEWPORTS check-index)))
                        (when (= (get check :status) "rejected")
                          (throw (get check :reason)))
                        (let* ((scripted (get (get check :value) :scripted))
                               (plain (get (get check :value) :plain))
                               (viewport-failures (js-call (js-array) :concat (get scripted :failures) (get plain :failures)))
                               (failure-index 0))
                          (js-call (get entry :viewports) :push
                            (js-object :name (get spec :name) :width (get (get spec :viewport) :width)
                              :measured (js-call globalThis.Object :assign (js-object) (get scripted :measured)
                                          (js-object :withoutScripts (get plain :measured)))
                              :failures viewport-failures))
                          (while (< failure-index (js-length viewport-failures))
                            (js-call failures :push (str name "/" (get spec :name) ": " (aref viewport-failures failure-index)))
                            (setq failure-index (1+ failure-index)))))
                      (setq check-index (1+ check-index))))
                  (catch error
                    (put entry :error (aref (js-call (funcall globalThis.String error) :split "\n") 0))
                    (js-call failures :push (str name ": " (get entry :error))))
                  (finally
                    (when browser
                      (js-call (js-call browser :close) :catch (lambda () nil)))))
                (js-call (get report :engines) :push entry))
              (setq engine-index (1+ engine-index)))
            (js-object :report report :failures failures))
          (finally (funcall (get server :stop)))))))

  (defun parse-arguments (argv)
    (let ((options (js-object :site "examples/dogfood/_site" :out nil :engines (Array/from ENGINES) :port 8899))
          (index 0))
      (while (< index (js-length argv))
        (let ((argument (aref argv index)))
          (if (js-call (js-array "--site" "--out" "--port") :includes argument)
            (let ((value (aref argv (1+ index))))
              (when (undefined? value)
                (throw (new globalThis.Error (str argument " requires a value"))))
              (put options (js-call argument :slice 2) (if (= argument "--port") (funcall globalThis.Number value) value))
              (setq index (1+ index)))
            (if (= argument "--engines")
              (progn
                (put options :engines (js-call (aref argv (1+ index)) :split ","))
                (setq index (1+ index)))
              (throw (new globalThis.Error (str "unknown argument " argument))))))
        (setq index (1+ index)))
      options))

  (defun print-report (report failures)
    (let ((engines (get report :engines)) (index 0))
      (while (< index (js-length engines))
        (let ((entry (aref engines index)))
          (if (get entry :error)
            (js-call (get globalThis.process :stdout) :write
              (str (get entry :name) ": unavailable (" (get entry :error) ")\n"))
            (let ((viewports (get entry :viewports)) (cursor 0))
              (while (< cursor (js-length viewports))
                (let* ((viewport (aref viewports cursor))
                       (verdict (if (= (js-length (get viewport :failures)) 0) "ok"
                                  (str (js-length (get viewport :failures)) " failed")))
                       (failure-index 0))
                  (js-call (get globalThis.process :stdout) :write
                    (str (get entry :name) " " (get entry :version) " " (get viewport :name) " "
                         (get viewport :width) "px: " verdict "\n"))
                  (while (< failure-index (js-length (get viewport :failures)))
                    (js-call (get globalThis.process :stdout) :write
                      (str "  - " (aref (get viewport :failures) failure-index) "\n"))
                    (setq failure-index (1+ failure-index))))
                (setq cursor (1+ cursor))))))
        (setq index (1+ index)))
      (put report :failures failures)))

  (when (js* "import.meta.main")
    (js-call (funcall (async ()
                        (let* ((options (parse-arguments (js-call (get globalThis.process :argv) :slice 2)))
                               (result (await (runMatrix (js-object :site (get options :site)
                                                          :engines (get options :engines)
                                                          :port (get options :port)))))
                               (report (get result :report))
                               (failures (get result :failures)))
                          (print-report report failures)
                          (when (host-truthy (get options :out))
                            (await (writeFile (get options :out) (str (JSON/stringify report nil 2) "\n") "utf8"))
                            (js-call (get globalThis.process :stdout) :write (str "report " (get options :out) "\n")))
                          (when (> (js-length failures) 0)
                            (put globalThis.process :exitCode 1)))))
      :catch (lambda (error)
               (js-call (get globalThis.process :stderr) :write (str "browser matrix: " (get error :message) "\n"))
               (put globalThis.process :exitCode 1))))

  (export ENGINES VIEWPORTS parseColor contrastRatio serveTree fingerprintTree runMatrix))
