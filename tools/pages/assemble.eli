(module tools.pages.assemble
  (import "node:fs/promises" cp mkdir copyFile writeFile readFile readdir rm stat)
  (import "node:crypto" createHash)
  (import "node:path" resolve dirname)
  (import "node:url" fileURLToPath)
  (import "../backends/compiler-package.mjs" bundleCompilerBrowserTransport)

  (defconst SITE_SOURCE "docs")
  (defconst PUBLISHED_TREES (Object/freeze (js-array
    "runtime"
    "platform"
    "browser"
    "dist/browser"
    "dist/browser-playground"
    "examples/dogfood/_site")))
  (defconst ROOT_REFERENCES (Object/freeze (js-array
    (js-array "\"eliscript/\": \"../../\"" "\"eliscript/\": \"../\"")
    (js-array "src=\"../../" "src=\"../")
    (js-array "href=\"../../" "href=\"../")
    (js-array "import(\"../../" "import(\"../"))))
  (defconst SITE_SCRIPT "dist/docs-site/site.js")
  (defconst PREVIOUS_PREFIX "docs")
  (defconst base-published-files (Object/freeze (js-array
    "LICENSE"
    "examples/browser-playground/README.md"
    "tools/backends/compiler-browser.mjs"
    "tools/backends/compiler-debug.mjs"
    "tools/backends/compiler-session.mjs"
    "tools/backends/compiler-sha256.mjs"
    "tools/backends/compiler-worker.mjs"
    "tools/backends/managed-runtime.mjs"
    "tools/backends/managed-host.mjs"
    "tools/backends/managed-source-view.mjs"
    "tools/backends/managed-module-graph.mjs")))
  (defconst runtime-transports (Object/freeze (js-call (js-array
    "tools/backends/managed-host-object-provider.mjs"
    "tools/backends/managed-host-object-realm.mjs"
    "tools/backends/managed-host-legacy.mjs"
    "tools/backends/managed-host-runtime.mjs"
    "tools/backends/managed-host-runtime.mjs.map"
    "tools/backends/managed-host-lifecycle.mjs"
    "tools/backends/managed-foreign-binding.mjs"
    "tools/backends/managed-host-proxy.mjs"
    "tools/backends/managed-runtime-host-legacy.mjs"
    "tools/backends/managed-source-view-legacy.mjs"
    "tools/backends/managed-module-graph-legacy.mjs"
    "tools/runtime/unicode-case-profiles.mjs") :concat
      ;; The prepared-binding adapter imports the real formal frontend. Ship
      ;; its complete graph and maps from the prepared stage3 view.
      (js-call (js-array "analyzer" "compiler" "emitter" "expander" "formatter"
        "ir" "lower" "project" "reader" "source-map" "symbol" "syntax" "transient-analysis")
        :flatMap (lambda (name) (js-array (str "dist/bootstrap/" name ".mjs")
          (str "dist/bootstrap/" name ".mjs.map"))))
      (js-array "dist/runtime/math.mjs" "dist/runtime/math.mjs.map"
        "dist/runtime/unicode-case.mjs" "dist/runtime/unicode-case.mjs.map"
        "dist/runtime/unicode-case-data.mjs" "dist/runtime/unicode-case-data.mjs.map"))))
  (defconst PUBLISHED_FILES (Object/freeze
    (js-call base-published-files :concat runtime-transports (js-array "package.json"))))

  (defun rebasePage (html &optional versions-input)
    (let ((result html)
          (versions (if (undefined? versions-input) (new globalThis.Map) versions-input))
          (index 0))
      (while (< index (js-length ROOT_REFERENCES))
        (let ((pair (aref ROOT_REFERENCES index)))
          (setq result (js-call (js-call result :split (aref pair 0)) :join (aref pair 1))))
        (setq index (1+ index)))
      (js-call (Array/from (js-call versions :entries)) :forEach
        (lambda (entry)
          (let ((asset (aref entry 0)) (version (aref entry 1)))
            (setq result (js-call (js-call result :split (+ "assets/" asset))
                           :join (+ "assets/" asset "?v=" version))))))
      result))

  (defasync assetVersions (options)
    (let ((root (get options :root))
          (site-directory (get options :siteDirectory))
          (digest (lambda (bytes)
            (js-call (js-call (js-call (createHash "sha256") :update bytes) :digest "hex") :slice 0 12)))
          (versions (new globalThis.Map)))
      (js-call versions :set "site.css"
        (funcall digest (await (readFile (resolve site-directory "pages/assets/site.css")))))
      (js-call versions :set "eliscript-loader.js"
        (funcall digest (await (readFile (resolve root SITE_SCRIPT)))))
      versions))

  (defun redirectDocument (target)
    (+ "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n"
       "<meta http-equiv=\"refresh\" content=\"0; url=" target "\">\n"
       "<link rel=\"canonical\" href=\"" target "\">\n"
       "<title>Moved</title>\n</head>\n<body>\n"
       "<p>This page moved to <a href=\"" target "\">" target "</a>.</p>\n"
       "</body>\n</html>\n"))

  (defasync path-exists (path)
    (try (progn (await (stat path)) t) (catch error false)))

  (defasync copy-site (from to versions)
    (await (mkdir to (js-object :recursive t)))
    (let ((entries (await (readdir from (js-object :withFileTypes t)))) (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index))
               (name (get entry :name))
               (child (resolve from name))
               (destination (resolve to name)))
          (cond
            ((js-call entry :isDirectory) (await (copy-site child destination versions)))
            ((js-call name :endsWith ".html")
              (await (writeFile destination (rebasePage (await (readFile child "utf8")) versions))))
            (t (await (cp child destination (js-object :recursive t))))))
        (setq index (1+ index)))))

  (defasync write-previous-addresses (artifact site-directory)
    (let ((walk nil))
      (setq walk (async (from relative)
        (let ((entries (await (readdir from (js-object :withFileTypes t)))) (index 0))
          (while (< index (js-length entries))
            (let* ((entry (aref entries index))
                   (entry-name (get entry :name))
                   (child (resolve from entry-name))
                   (name (if (= relative "") entry-name (+ relative "/" entry-name))))
              (if (js-call entry :isDirectory)
                (await (funcall walk child name))
                (when (js-call entry-name :endsWith ".html")
                  (let ((target (if (= name "index.html") "/" (+ "/" name)))
                        (stub (resolve artifact PREVIOUS_PREFIX name)))
                    (await (mkdir (dirname stub) (js-object :recursive t)))
                    (await (writeFile stub (redirectDocument target)))))))
            (setq index (1+ index))))))
      (await (funcall walk site-directory ""))))

  (defasync assemble-base-pages (options)
    (let* ((source (resolve (get options :root)))
           (target (resolve (get options :outDir)))
           (compiler-artifacts (if (undefined? (get options :compilerArtifacts))
                                 (js-array) (get options :compilerArtifacts))))
      (when (or (= target source) (js-call source :startsWith (+ target "/")))
        (throw (new globalThis.Error (+ "refusing to assemble into the source tree: " (get options :outDir)))))
      (await (rm target (js-object :recursive t :force t)))
      (await (mkdir target (js-object :recursive t)))
      (let ((script (resolve source SITE_SCRIPT)))
        (unless (await (path-exists script))
          (throw (new globalThis.Error
            (+ "the site script is not built: run `bun run build:docs-site` (" SITE_SCRIPT ")"))))
        (let ((versions (await (assetVersions (js-object :root source :siteDirectory (resolve source SITE_SOURCE))))))
          (await (copy-site (resolve source SITE_SOURCE) target versions))
          (await (mkdir (resolve target "pages/assets") (js-object :recursive t)))
          (await (writeFile (resolve target "pages/assets/eliscript-loader.js") (await (readFile script))))
          (await (write-previous-addresses target (resolve source SITE_SOURCE)))))
      (let ((index 0))
        (while (< index (js-length PUBLISHED_TREES))
          (let ((entry (aref PUBLISHED_TREES index)))
            (when (await (path-exists (resolve target entry)))
              (throw (new globalThis.Error (+ "site entry collides with published tree: " entry)))))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length PUBLISHED_TREES))
          (let* ((entry (aref PUBLISHED_TREES index))
                 (destination (resolve target entry)))
            (await (mkdir (dirname destination) (js-object :recursive t)))
            (await (cp (resolve source entry) destination (js-object :recursive t))))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length base-published-files))
          (let ((entry (aref base-published-files index)))
            (await (mkdir (dirname (resolve target entry)) (js-object :recursive t)))
            (await (cp (resolve source entry) (resolve target entry))))
          (setq index (1+ index))))
      (let ((compiler-trees (js-array)) (index 0))
        (while (< index (js-length compiler-artifacts))
          (let ((entry (aref compiler-artifacts index)))
            (when (or (/= (value-type entry) "string")
                      (not (js-call entry :startsWith "dist/"))
                      (js-call (js-call entry :split "/") :some (lambda (part) (or (= part "..") (= part ""))))
                      (js-call entry :includes "\\"))
              (throw (new globalThis.Error "compiler artifact must be a relative directory inside dist")))
            (let ((destination (resolve target entry)))
              (when (await (path-exists destination))
                (throw (new globalThis.Error (+ "compiler artifact collides with published tree: " entry))))
              (await (mkdir (dirname destination) (js-object :recursive t)))
              (await (cp (resolve source entry) destination (js-object :recursive t)))
              (js-call compiler-trees :push entry)))
          (setq index (1+ index)))
        (js-object
          :trees (js-call (js-array SITE_SOURCE) :concat PUBLISHED_TREES compiler-trees)
          :files (Array/from base-published-files)))))

  (defasync pages-file-identity (directory path)
    (let ((bytes (await (readFile (resolve directory path)))))
      (js-object :path path :bytes (js-length bytes)
        :sha256 (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))))

  (defasync assemblePages (options)
    ;; Preserve the existing source-tree guard, compiler packages, pages and
    ;; asset stamps. Complete the real imports of the generated Eli adapters.
    (let* ((result (await (assemble-base-pages options)))
           (source (resolve (get options :root))) (target (resolve (get options :outDir)))
           (index 0))
      (while (< index (js-length runtime-transports))
        (let* ((file (aref runtime-transports index)) (output (resolve target file)))
          (await (mkdir (dirname output) (js-object :recursive t)))
          (await (copyFile (resolve source file) output))
          (unless (js-call (get result :files) :includes file)
            (js-call (get result :files) :push file)))
        (setq index (1+ index)))
      ;; Node/Bun use the same root-relative runtime graph as the browser's
      ;; existing import map when the published Worker is loaded in isolation.
      (await (copyFile (resolve source "package.json") (resolve target "package.json")))
      (unless (js-call (get result :files) :includes "package.json")
        (js-call (get result :files) :push "package.json"))
      ;; The exact published source files above remain byte-identical. Workers
      ;; consume separate browser representations and their own identity file;
      ;; these bundles are never certified compiler fixed-point products.
      (let ((entries (js-array
               (js-array "tools/backends/compiler-browser.mjs" "tools/backends/browser/compiler-browser.mjs")
               (js-array "tools/backends/compiler-worker.mjs" "tools/backends/browser/compiler-worker.mjs")))
            (transports (js-array)) (published-sources (js-array)) (index 0))
        (while (< index (js-length entries))
          (let* ((entry (aref entries index)) (input (aref entry 0)) (output (aref entry 1)))
            (await (bundleCompilerBrowserTransport (resolve source input) (resolve target output) source))
            (js-call transports :push (js-object
              :source (await (pages-file-identity source input))
              :bundle (await (pages-file-identity target output))
              :sourceMap (await (pages-file-identity target (str output ".map")))))
            (js-call (get result :files) :push output (str output ".map")))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length PUBLISHED_FILES))
          (js-call published-sources :push (await (pages-file-identity target (aref PUBLISHED_FILES index))))
          (setq index (1+ index)))
        (let ((manifest "tools/backends/browser/transport.json"))
          (await (writeFile (resolve target manifest)
            (str (JSON/stringify (js-object :format "eliscript-pages-browser-transports" :version 1
              :representation "derived-browser-bundle" :compilerFixedPointEvidence false
              :publishedSourceFiles published-sources :transports transports) nil 2) "\n")))
          (js-call (get result :files) :push manifest))) result))

  (defasync main (arguments)
    (let ((options (js-object :root "." :outDir "dist/pages" :compilerArtifacts (js-array))) (index 0))
      (while (< index (js-length arguments))
        (let ((flag (aref arguments index)))
          (unless (js-call (js-array "--root" "--out" "--compiler-artifact") :includes flag)
            (throw (new globalThis.TypeError (+ "unknown argument " flag))))
          (setq index (1+ index))
          (when (>= index (js-length arguments))
            (throw (new globalThis.TypeError (+ flag " requires a path"))))
          (let ((value (aref arguments index)))
            (cond ((= flag "--compiler-artifact") (js-call (get options :compilerArtifacts) :push value))
              ((= flag "--root") (put options :root value))
              (t (put options :outDir value)))))
        (setq index (1+ index)))
      (let ((result (await (assemblePages options))))
        (js-call (get globalThis.process :stdout) :write
          (+ "Pages artifact: " (js-length (get result :trees)) " trees, "
            (js-length (get result :files)) " files into " (resolve (get options :outDir)) "\n")) result)))

  (when (and (aref (get globalThis.process :argv) 1)
             (= (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath (js* "import.meta.url"))))
    (js-call (main (js-call (get globalThis.process :argv) :slice 2)) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write (+ "assemble: " (get error :message) "\n"))
        (put globalThis.process :exitCode 1))))
  (export SITE_SOURCE PUBLISHED_TREES ROOT_REFERENCES SITE_SCRIPT PREVIOUS_PREFIX
    PUBLISHED_FILES rebasePage assetVersions redirectDocument assemblePages main))
