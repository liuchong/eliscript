(module tools.compiler.array-text-capsule
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve dirname)
  (import "node:url" fileURLToPath)

  (defconst root (resolve (dirname (fileURLToPath (js* "import.meta.url"))) "../.."))

  ;; Maintenance only: normal compilation emits the fixed literal and never runs
  ;; a bundler. One identical offline URL shares guards and the bundled exact
  ;; Number radix formatter across generated modules; no runtime fetch is needed.
  (defasync renderArrayTextImport ()
    (let ((result (await (js-call globalThis.Bun :build
                           (js-object
                             :entrypoints (js-array (resolve root "runtime/array-text.mjs"))
                             :target "browser"
                             :format "esm"
                             :minify t)))))
      (when (or (not (get result :success))
                (not (= (js-length (get result :outputs)) 1)))
        (throw (new globalThis.Error "array text capsule build failed"
                 (js-object :cause (get result :logs)))))
      (let* ((source (js-call (await (js-call (aref (get result :outputs) 0) :text)) :trim))
             (url (str "data:text/javascript;base64,"
                       (js-call (Buffer/from source) :toString "base64"))))
        (str "import { c as __eliscript_at, d as __eliscript_at_direct } from "
             (JSON/stringify url) ";\n"))))

  (defun import-url (text)
    (let ((match (js-call (new globalThis.RegExp "from (\"(?:[^\"\\\\]|\\\\.)*\");\\n$") :exec text)))
      (when (not match)
        (throw (new globalThis.Error "invalid array text capsule import")))
      (JSON/parse (aref match 1))))

  (defasync checkArrayTextCapsule (&optional options)
    (let* ((opts (or options (js-object)))
           (write (if (= (get opts :write) undefined) nil (get opts :write)))
           (prelude (await (renderArrayTextImport)))
           (literal (JSON/stringify prelude))
           (changed (js-array))
           (updates (js-array))
           (previous-urls (new globalThis.Set))
           (specifier (import-url prelude))
           (targets (js-array
                      (js-array "compiler/eliscript-emitter.el" "eliscript-emitter--array-text-import")
                      (js-array "bootstrap/compiler/emitter.eli" "array-text-import"))))
      (let ((index 0))
        (while (< index (js-length targets))
          (let* ((entry (aref targets index))
                 (file (aref entry 0))
                 (name (aref entry 1))
                 (file-path (resolve root file))
                 (source (await (readFile file-path "utf8")))
                 (pattern (new globalThis.RegExp (str "(\\(defconst " name "\\s+)(\"(?:[^\"\\\\]|\\\\.)*\")")))
                 (match (js-call source :match pattern)))
            (when (not match)
              (throw (new globalThis.Error (str "missing array text capsule declaration: " file))))
            (js-call previous-urls :add (import-url (JSON/parse (aref match 2))))
            (when (not (= (JSON/parse (aref match 2)) prelude))
              (js-call changed :push file)
              (js-call updates :push
                (js-array file-path
                  (js-call source :replace pattern (lambda (_ prefix) (str prefix literal)))))))
          (setq index (+ index 1))))
      ;; Pin the exact compiler-owned URL at its two checked-in consumers. This
      ;; never permits arbitrary data imports or expands the core package boundary.
      (let* ((contract-file "contracts/repository-integrity.json")
             (contract-path (resolve root contract-file))
             (contract (JSON/parse (await (readFile contract-path "utf8"))))
             (imports (get contract :imports))
             (records (if imports (get imports :specialSpecifiers) undefined)))
        (when (not (Array/isArray records))
          (throw (new globalThis.Error "missing integrity special specifiers")))
        (let* ((allowed-roots (js-array "runtime/core/protocol-impl.mjs" "tests/snapshots/core.mjs"))
               (existing (js-call records :find (lambda (record) (= (get record :specifier) specifier)))))
          (when (and existing
                     (not (= (JSON/stringify (get existing :allowedRoots))
                             (JSON/stringify allowed-roots))))
            (throw (new globalThis.Error "array text capsule integrity roots differ")))
          (let ((next (js-call records :filter
                        (lambda (record)
                          (or (= (get record :specifier) specifier)
                              (not (js-call previous-urls :has (get record :specifier)))))))
                (selector (lambda (record)
                            (if (= (get record :specifier) undefined)
                                (str "^" (get record :prefix))
                              (str "=" (get record :specifier))))))
            (when (not existing)
              (js-call next :push (js-object :specifier specifier :allowedRoots allowed-roots)))
            (js-call next :sort
              (lambda (left right)
                (let ((l (funcall selector left))
                      (r (funcall selector right)))
                  (if (< l r) -1 (if (> l r) 1 0)))))
            (when (not (= (JSON/stringify next) (JSON/stringify records)))
              (put imports :specialSpecifiers next)
              (js-call changed :push contract-file)
              (js-call updates :push (js-array contract-path (str (JSON/stringify contract nil 2) "\n")))))))
      (when write
        (let ((index 0))
          (while (< index (js-length updates))
            (let ((update (aref updates index)))
              (await (writeFile (aref update 0) (aref update 1))))
            (setq index (+ index 1)))))
      (when (and (> (js-length changed) 0) (not write))
        (throw (new globalThis.Error (str "array text capsule is stale: " (js-call changed :join ", ")))))
      (js-object
        :bytes (Buffer/byteLength prelude)
        :changed changed)))

  (defasync run-main ()
    (let ((args (js-call (get globalThis.process :argv) :slice 2)))
      (when (js-call args :some (lambda (arg) (not (= arg "--write"))))
        (throw (new globalThis.Error "unknown array text capsule argument")))
      (js-call globalThis.console :log
        (JSON/stringify
          (await (checkArrayTextCapsule
                   (js-object :write (js-call (get globalThis.process :argv) :includes "--write"))))))))

  (when (js* "import.meta.main")
    (run-main))

  (export renderArrayTextImport checkArrayTextCapsule))
