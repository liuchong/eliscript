(module tools.compiler.indent-benchmark
  (import "node:fs/promises" readFile writeFile)
  (import "node:os" :default os)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../backends/dist/release-cli.mjs" requirePreparedStage3)
  (import "./controlled-baseline.mjs" compilerBenchmarkSourceDigest)

  (defconst COMPILER_INDENT_FORMAT "eliscript-compiler-indent-benchmark")
  (defconst COMPILER_INDENT_VERSION 1)

  (defconst directory (js-call path :dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst project-directory (js-call path :resolve directory "../.."))
  (defconst compiler-sources
    (Object/freeze
      (js-array
        "bootstrap/compiler/symbol.eli"
        "bootstrap/compiler/syntax.eli"
        "bootstrap/compiler/reader.eli"
        "bootstrap/compiler/formatter.eli"
        "bootstrap/compiler/expander.eli"
        "bootstrap/compiler/transient-analysis.eli"
        "bootstrap/compiler/analyzer.eli"
        "bootstrap/compiler/ir.eli"
        "bootstrap/compiler/lower.eli"
        "bootstrap/compiler/source-map.eli"
        "bootstrap/compiler/emitter.eli"
        "bootstrap/compiler/project.eli"
        "bootstrap/compiler/compiler.eli")))
  (defconst digest-files
    (Object/freeze
      (js-call compiler-sources :concat (js-array "tools/compiler/indent-benchmark.eli" "tools/compiler/indent-benchmark.mjs"))))

  (defun parse-positive-integer (value name)
    (let ((parsed (globalThis.Number value)))
      (when (or (not (Number/isSafeInteger parsed)) (<= parsed 0))
        (throw (new globalThis.TypeError (str name " must be a positive safe integer"))))
      parsed))

  (defun parse-arguments (arguments*)
    (let ((output undefined)
          (index 0))
      (while (< index (js-length arguments*))
        (let ((argument (aref arguments* index)))
          (cond
            ((= argument "--output")
             (setq output (aref arguments* (+ index 1)))
             (when (= output undefined)
               (throw (new globalThis.TypeError "--output requires a path")))
             (setq index (+ index 1)))
            ((= argument "--help")
             (js-call (get process :stdout) :write
               (str "Usage: bun tools/compiler/indent-benchmark.mjs "
                    "[--output REPORT.json]\n"))
             (js-call process :exit 0))
            (t
             (throw (new globalThis.TypeError (str "unknown argument " argument))))))
        (setq index (+ index 1)))
      (js-object :output output)))

  (defasync compilerIndentSourceDigest ()
    (await (compilerBenchmarkSourceDigest project-directory digest-files
             (await (requirePreparedStage3)))))

  (defun span (filename offset &rest __opt)
    (let* ((line (aref __opt 0))
           (resolved-line (if (= line undefined) 1 line)))
      (js-object
        :filename filename
        :start offset
        :end (+ offset 1)
        :line resolved-line
        :column offset)))

  (defun source-bound-fragments (artifact)
    (let ((fragments (js-array))
          (text (get artifact :text))
          (marks (get artifact :marks))
          (block-start 0)
          (done nil))
      (while (and (< block-start (js-length text)) (not done))
        (let* ((separator (js-call text :indexOf "\n\n" block-start))
               (block-end (if (= separator -1) (js-length text) separator)))
          (when (> block-end block-start)
            (js-call fragments :push
              (js-object
                :text (js-call text :slice block-start block-end)
                :marks (js-call (js-call marks :filter
                            (lambda (mark)
                              (and (>= (get mark :offset) block-start)
                                   (< (get mark :offset) block-end))))
                          :map
                          (lambda (mark)
                            (js-object
                              :offset (- (get mark :offset) block-start)
                              :span (get mark :span)))))))
          (if (= separator -1)
              (setq done t)
            (setq block-start (+ block-end 2)))))
      fragments))

  (defun boundary-fragments ()
    (js-array
      (js-object :text "" :marks (js-array))
      (js-object :text "" :marks (js-array (js-object :offset 0 :span (span "empty" 0))))
      (js-object :text "\n" :marks (js-array (js-object :offset 0 :span (span "blank" 0))))
      (js-object
        :text "\n\n"
        :marks (js-array
                 (js-object :offset 0 :span (span "blank-lines" 0))
                 (js-object :offset 1 :span (span "blank-lines" 1 2))))
      (js-object
        :text "a"
        :marks (js-array
                 (js-object :offset 0 :span (span "single" 0))
                 (js-object :offset 0 :span (span "single-duplicate" 0))
                 (js-object :offset 1 :span (span "single-tail" 1))))
      (js-object
        :text "a\n"
        :marks (js-array
                 (js-object :offset 0 :span (span "trailing-newline" 0))
                 (js-object :offset 1 :span (span "trailing-newline" 1))
                 (js-object :offset 2 :span (span "trailing-newline-tail" 2))))
      (js-object
        :text "\na"
        :marks (js-array
                 (js-object :offset 0 :span (span "leading-newline" 0))
                 (js-object :offset 1 :span (span "leading-newline" 1 2))))
      (js-object
        :text "a\n\nb"
        :marks (js-array
                 (js-object :offset 0 :span (span "mixed-lines" 0))
                 (js-object :offset 1 :span (span "mixed-lines" 1))
                 (js-object :offset 2 :span (span "mixed-lines" 2 2))
                 (js-object :offset 3 :span (span "mixed-lines" 3 3))
                 (js-object :offset 4 :span (span "mixed-lines-tail" 4 3))))
      (js-object
        :text "\r\nx"
        :marks (js-array
                 (js-object :offset 0 :span (span "crlf" 0))
                 (js-object :offset 2 :span (span "crlf" 2 2))))
      (js-object
        :text "🙂\nλ"
        :marks (js-array
                 (js-object :offset 0 :span (span "unicode" 0))
                 (js-object :offset 2 :span (span "unicode" 2))
                 (js-object :offset 3 :span (span "unicode" 3 2))))))

  (defun median (values)
    (let ((sorted (js-call (js-call values :slice) :sort (lambda (left right) (- left right)))))
      (aref sorted (Math/floor (/ (js-length sorted) 2)))))

  (defun fragment-checksum (fragment)
    (let* ((marks (get fragment :marks))
           (checksum (+ (* (js-length (get fragment :text)) 31)
                        (js-length (get fragment :marks))))
           (mark-count (js-length marks))
           (index 0))
      ;; The timed checksum receives fresh plain emitter/boundary fragments with
      ;; plain marks arrays. The index starts at zero and only advances while it
      ;; is below this guarded bound, so both operands of the fused native
      ;; comparison are safe Number integers for every iteration.
      (unless (and (Number/isSafeInteger mark-count) (>= mark-count 0))
        (throw (new globalThis.TypeError
                 "indent benchmark checksum requires a safe nonnegative mark count")))
      (while (funcall (js* "(a, b) => a < b") index mark-count)
        (setq checksum (+ checksum (get (aref marks index) :offset)))
        (setq index (+ index 1)))
      checksum))

  (defun measure (indent fragments iterations)
    (let ((fragment-count (js-length fragments)))
      ;; The fragment count comes from the benchmark-created plain array and the
      ;; iteration count from parse-positive-integer. Both loop indices start at
      ;; zero and only advance below these guarded bounds.
      (unless (and (Number/isSafeInteger iterations) (>= iterations 0)
                   (Number/isSafeInteger fragment-count) (>= fragment-count 0))
        (throw (new globalThis.TypeError
                 "indent benchmark requires safe nonnegative loop bounds")))
      (let ((checksum 0)
            (start (js-call globalThis.performance :now))
            (iteration 0))
        (while (funcall (js* "(a, b) => a < b") iteration iterations)
          (let ((index 0))
            (while (funcall (js* "(a, b) => a < b") index fragment-count)
              (setq checksum (+ checksum (fragment-checksum (funcall indent (aref fragments index)))))
              (setq index (+ index 1))))
          (setq iteration (+ iteration 1)))
        (js-object
          :milliseconds (- (js-call globalThis.performance :now) start)
          :checksum checksum))))

  (defasync load-generated-compiler ()
    (let ((module-directory (js-call path :join project-directory "dist/bootstrap")))
      (try
        (let ((loaded
                (await (Promise/all
                         (js-array
                           (funcall (js* "(u) => import(u)") (get (pathToFileURL (js-call path :join module-directory "compiler.mjs")) :href))
                           (funcall (js* "(u) => import(u)") (get (pathToFileURL (js-call path :join module-directory "emitter.mjs")) :href)))))))
          (js-object
            :compiler (aref loaded 0)
            :emitter (aref loaded 1)))
        (catch error
          (throw (new globalThis.Error
                   "generated compiler is unavailable; run bun run build:bootstrap first"
                   (js-object :cause error)))))))

  (defun validateCompilerIndentReport (report)
    (when (or (not report)
              (not (= (get report :format) COMPILER_INDENT_FORMAT))
              (not (= (get report :version) COMPILER_INDENT_VERSION)))
      (throw (new globalThis.TypeError "invalid compiler indent report identity")))
    (let ((validation (get report :validation))
          (corpus (get report :corpus)))
      (when (or (not validation)
                (not corpus)
                (not (= (get validation :equivalent) t))
                (not (= (get validation :fragments)
                        (+ (get corpus :fragments) (get corpus :boundaryFragments))))
                (<= (get validation :checksum) 0))
        (throw (new globalThis.TypeError "compiler indent equivalence was not proven"))))
    (let* ((measurements (get report :measurements))
           (parameters (get report :parameters))
           (samples (if parameters (get parameters :timingSamples) undefined))
           (opt-meas (if measurements (get measurements :optimized) undefined))
           (ref-meas (if measurements (get measurements :reference) undefined))
           (opt-samples (if opt-meas (get opt-meas :samplesMs) undefined))
           (ref-samples (if ref-meas (get ref-meas :samplesMs) undefined)))
      (when (or (not (Array/isArray opt-samples))
                (not (Array/isArray ref-samples))
                (not (= (js-length opt-samples) samples))
                (not (= (js-length ref-samples) samples)))
        (throw (new globalThis.TypeError "compiler indent timing samples are incomplete"))))
    (let ((decision (get report :decision))
          (measurements (get report :measurements)))
      (when (or (not decision)
                (not (Number/isFinite (get decision :minimumSpeedup)))
                (< (get decision :minimumSpeedup) 10)
                (not (= (get decision :passed) t))
                (< (get measurements :speedup) (get decision :minimumSpeedup)))
        (let ((error (new globalThis.TypeError "compiler indent speedup decision did not pass")))
          (put error :report report)
          (throw error))))
    report)

  (defun coalesce (a b c)
    (if (not (= a undefined))
        (if (not (= a nil)) a (if (not (= b undefined)) (if (not (= b nil)) b c) c))
      (if (not (= b undefined)) (if (not (= b nil)) b c) c)))

  (defasync runCompilerIndentBenchmark (&optional options)
    (await (requirePreparedStage3))
    (let* ((opts (or options (js-object)))
           (env (get process :env))
           (warmup-iterations
             (parse-positive-integer
               (coalesce (get opts :warmupIterations)
                         (get env :ELISCRIPT_COMPILER_INDENT_WARMUP_ITERATIONS)
                         5)
               "warmup iterations"))
           (timing-iterations
             (parse-positive-integer
               (coalesce (get opts :timingIterations)
                         (get env :ELISCRIPT_COMPILER_INDENT_TIMING_ITERATIONS)
                         20)
               "timing iterations"))
           (timing-samples
             (parse-positive-integer
               (coalesce (get opts :timingSamples)
                         (get env :ELISCRIPT_COMPILER_INDENT_TIMING_SAMPLES)
                         9)
               "timing samples")))
      (when (= (% timing-samples 2) 0)
        (throw (new globalThis.TypeError "timing samples must be odd")))
      (let ((minimum-speedup
              (globalThis.Number
                (coalesce (get opts :minimumSpeedup)
                          (get env :ELISCRIPT_COMPILER_INDENT_MINIMUM_SPEEDUP)
                          10))))
        (when (or (not (Number/isFinite minimum-speedup)) (<= minimum-speedup 1))
          (throw (new globalThis.TypeError "minimum speedup must be greater than 1")))
        (let* ((loaded (await (load-generated-compiler)))
               (compiler (get loaded :compiler))
               (emitter (get loaded :emitter))
               (fragments (js-array))
               (source-bytes 0)
               (index 0))
          (while (< index (js-length compiler-sources))
            (let* ((relative (aref compiler-sources index))
                   (source (await (readFile (js-call path :join project-directory relative) "utf8")))
                   (program (js-call compiler :compile_ir_string source relative))
                   (bound (source-bound-fragments (js-call emitter :emit_module_artifact program)))
                   (bound-idx 0))
              (setq source-bytes (+ source-bytes (Buffer/byteLength source)))
              (while (< bound-idx (js-length bound))
                (js-call fragments :push (aref bound bound-idx))
                (setq bound-idx (+ bound-idx 1))))
            (setq index (+ index 1)))
          (let* ((boundaries (boundary-fragments))
                 (all-fragments (js-call fragments :concat boundaries))
                 (validation-checksum 0)
                 (frag-index 0))
            (while (< frag-index (js-length all-fragments))
              (let* ((fragment (aref all-fragments frag-index))
                     (optimized (js-call emitter :indent fragment))
                     (reference (js-call emitter :reference_indent fragment)))
                (when (not (= (JSON/stringify optimized) (JSON/stringify reference)))
                  (throw (new globalThis.Error "optimized and reference compiler indentation differ")))
                (setq validation-checksum (+ validation-checksum (fragment-checksum optimized))))
              (setq frag-index (+ frag-index 1)))
            (measure (get emitter :indent) all-fragments warmup-iterations)
            (measure (get emitter :reference_indent) all-fragments warmup-iterations)
            (let ((optimized-samples (js-array))
                  (reference-samples (js-array))
                  (sample 0))
              (while (< sample timing-samples)
                (let ((order (if (= (% sample 2) 0)
                                 (js-array
                                   (js-array (get emitter :indent) optimized-samples)
                                   (js-array (get emitter :reference_indent) reference-samples))
                               (js-array
                                 (js-array (get emitter :reference_indent) reference-samples)
                                 (js-array (get emitter :indent) optimized-samples))))
                      (expected-checksum undefined)
                      (order-idx 0))
                  (while (< order-idx (js-length order))
                    (let* ((entry (aref order order-idx))
                           (indent-fn (aref entry 0))
                           (samples (aref entry 1))
                           (measured (measure indent-fn all-fragments timing-iterations)))
                      (js-call samples :push (get measured :milliseconds))
                      (when (= expected-checksum undefined)
                        (setq expected-checksum (get measured :checksum)))
                      (when (not (= (get measured :checksum) expected-checksum))
                        (throw (new globalThis.Error "compiler indent benchmark checksum drifted"))))
                    (setq order-idx (+ order-idx 1))))
                (setq sample (+ sample 1)))
              (let* ((optimized-median (median optimized-samples))
                     (reference-median (median reference-samples))
                     (speedup (/ reference-median optimized-median))
                     (report
                       (js-object
                         :format COMPILER_INDENT_FORMAT
                         :version COMPILER_INDENT_VERSION
                         :generatedAt (js-call (new globalThis.Date) :toISOString)
                         :sourceDigest (await (compilerIndentSourceDigest))
                         :host (js-object
                                 :runtime "bun"
                                 :runtimeVersion (get globalThis.Bun :version)
                                 :engine "JavaScriptCore"
                                 :platform (get process :platform)
                                 :architecture (get process :arch)
                                 :operatingSystem (str (js-call os :type) " " (js-call os :release)))
                         :corpus (js-object
                                   :files compiler-sources
                                   :sourceBytes source-bytes
                                   :programs (js-length compiler-sources)
                                   :fragments (js-length fragments)
                                   :boundaryFragments (js-length boundaries)
                                   :generatedBytes (js-call fragments :reduce
                                                     (lambda (total fragment)
                                                       (+ total (Buffer/byteLength (get fragment :text))))
                                                     0)
                                   :marks (js-call fragments :reduce
                                            (lambda (total fragment)
                                              (+ total (js-length (get fragment :marks))))
                                            0))
                         :parameters (js-object
                                       :warmupIterations warmup-iterations
                                       :timingIterations timing-iterations
                                       :timingSamples timing-samples)
                         :validation (js-object
                                       :equivalent t
                                       :fragments (js-length all-fragments)
                                       :checksum validation-checksum)
                         :measurements (js-object
                                         :optimized (js-object :samplesMs optimized-samples :medianMs optimized-median)
                                         :reference (js-object :samplesMs reference-samples :medianMs reference-median)
                                         :speedup speedup)
                         :decision (js-object
                                     :minimumSpeedup minimum-speedup
                                     :passed (>= speedup minimum-speedup)))))
                (validateCompilerIndentReport report))))))))

  (defasync run-main ()
    (let* ((parsed (parse-arguments (js-call (get process :argv) :slice 2)))
           (output (get parsed :output))
           (report undefined))
      (try
        (setq report (await (runCompilerIndentBenchmark)))
        (catch error
          (when (get error :report)
            (let ((failed (str (JSON/stringify (get error :report) nil 2) "\n")))
              (if (= output undefined)
                (js-call (get process :stdout) :write failed)
                (await (writeFile (js-call path :resolve output) failed)))))
          (throw error)))
      (let ((serialized (str (JSON/stringify report nil 2) "\n")))
        (if (= output undefined)
          (js-call (get process :stdout) :write serialized)
          (progn
            (await (writeFile (js-call path :resolve output) serialized))
            (js-call (get process :stdout) :write (str (js-call path :resolve output) "\n")))))))

  (when (js* "import.meta.main")
    (run-main))

  (export
    COMPILER_INDENT_FORMAT
    COMPILER_INDENT_VERSION
    compilerIndentSourceDigest
    validateCompilerIndentReport
    runCompilerIndentBenchmark))
