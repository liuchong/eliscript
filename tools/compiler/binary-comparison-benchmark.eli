(module tools.compiler.binary-comparison-benchmark
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile writeFile)
  (import "node:os" :default os)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath pathToFileURL)

  (defconst COMPILER_BINARY_COMPARISON_FORMAT "eliscript-compiler-binary-comparison-benchmark")
  (defconst COMPILER_BINARY_COMPARISON_VERSION 1)
  (defconst COMPILER_BINARY_COMPARISON_BASELINE "a123937b275d89e833434e84064e4e120cf5495b")

  (defconst directory (js-call path :dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst project-directory (js-call path :resolve directory "../.."))
  (defconst compiler-sources
    (Object/freeze
      (js-array
        "bootstrap/compiler/symbol.eli"
        "bootstrap/compiler/syntax.eli"
        "bootstrap/compiler/reader.eli"
        "bootstrap/compiler/formatter.eli"
        "bootstrap/compiler/expander.eli"
        "bootstrap/compiler/transient-analysis.eli"
        "bootstrap/compiler/analyzer.eli"
        "bootstrap/compiler/ir.eli"
        "bootstrap/compiler/lower.eli"
        "bootstrap/compiler/source-map.eli"
        "bootstrap/compiler/emitter.eli"
        "bootstrap/compiler/project.eli"
        "bootstrap/compiler/compiler.eli")))
  (defconst digest-files
    (Object/freeze
      (js-call compiler-sources :concat
        (js-array
          "compiler/eliscript-emitter.el"
          "compiler/eliscript-ir-emitter.el"
          "tools/compiler/binary-comparison-benchmark.mjs"))))

  (defun positive-integer (value name)
    (let ((parsed (globalThis.Number value)))
      (when (or (not (Number/isSafeInteger parsed)) (<= parsed 0))
        (throw (new globalThis.TypeError (str name " must be a positive safe integer"))))
      parsed))

  (defun parse-arguments (arguments*)
    (let ((baseline-root undefined)
          (output undefined)
          (index 0))
      (while (< index (js-length arguments*))
        (let ((argument (aref arguments* index)))
          (cond
            ((= argument "--baseline-root")
             (setq index (+ index 1))
             (setq baseline-root (aref arguments* index)))
            ((= argument "--output")
             (setq index (+ index 1))
             (setq output (aref arguments* index)))
            ((= argument "--help")
             (js-call (get process :stdout) :write
               (str "Usage: bun tools/compiler/binary-comparison-benchmark.mjs "
                    "--baseline-root DIR [--output REPORT.json]\n"))
             (js-call process :exit 0))
            (t
             (throw (new globalThis.TypeError (str "unknown argument " argument))))))
        (setq index (+ index 1)))
      (when (not baseline-root)
        (throw (new globalThis.TypeError "--baseline-root is required")))
      (js-object
        :baselineRoot (js-call path :resolve baseline-root)
        :output output)))

  (defasync compilerBinaryComparisonSourceDigest ()
    (let ((hash (createHash "sha256"))
          (index 0))
      (while (< index (js-length digest-files))
        (let ((relative (aref digest-files index)))
          (js-call hash :update relative)
          (js-call hash :update "\u0000")
          (js-call hash :update (await (readFile (js-call path :join project-directory relative))))
          (js-call hash :update "\u0000"))
        (setq index (+ index 1)))
      (js-object
        :algorithm "sha256"
        :files digest-files
        :value (js-call hash :digest "hex"))))

  (defun git-revision (root)
    (let ((result (js-call globalThis.Bun :spawnSync (js-array "git" "-C" root "rev-parse" "HEAD"))))
      (when (not (= (get result :exitCode) 0))
        (throw (new globalThis.Error (js-call (js-call (new globalThis.TextDecoder) :decode (get result :stderr)) :trim))))
      (js-call (js-call (new globalThis.TextDecoder) :decode (get result :stdout)) :trim)))

  (defasync load-compiler (root identity)
    (let ((location (js-call path :join root "dist/bootstrap/compiler.mjs")))
      (funcall (js* "(u) => import(u)") (str (get (pathToFileURL location) :href) "?benchmark=" identity))))

  (defun median (samples)
    (let ((values (js-call (js-call samples :slice) :sort (lambda (left right) (- left right)))))
      (aref values (Math/floor (/ (js-length values) 2)))))

  (defun compile-corpus (compiler corpus rounds)
    (let ((checksum 0)
          (start (js-call globalThis.performance :now))
          (round 0))
      (while (< round rounds)
        (let ((index 0))
          (while (< index (js-length corpus))
            (let* ((item (aref corpus index))
                   (relative (get item :relative))
                   (result (js-call compiler :compile_string_with_source_map
                             (get item :source)
                             relative
                             (str (js-call path :basename relative ".eli") ".mjs")
                             relative)))
              (setq checksum (+ checksum
                                (js-length (get result :javascript))
                                (js-length (get result :sourceMap)))))
            (setq index (+ index 1))))
        (setq round (+ round 1)))
      (js-object
        :milliseconds (- (js-call globalThis.performance :now) start)
        :checksum checksum)))

  (defun validateCompilerBinaryComparisonReport (report)
    (let ((reject (lambda (message)
                    (let ((err (new globalThis.TypeError message)))
                      (put err :report report)
                      (throw err)))))
      (when (or (not report)
                (not (= (get report :format) COMPILER_BINARY_COMPARISON_FORMAT))
                (not (= (get report :version) COMPILER_BINARY_COMPARISON_VERSION))
                (not (get report :baseline))
                (not (= (get (get report :baseline) :revision) COMPILER_BINARY_COMPARISON_BASELINE)))
        (funcall reject "invalid compiler binary comparison report identity"))
      (let* ((parameters (get report :parameters))
             (samples (if parameters (get parameters :timingSamples) undefined))
             (measurements (get report :measurements))
             (baseline-meas (if measurements (get measurements :baseline) undefined))
             (optimized-meas (if measurements (get measurements :optimized) undefined))
             (baseline-samples (if baseline-meas (get baseline-meas :samplesMs) undefined))
             (optimized-samples (if optimized-meas (get optimized-meas :samplesMs) undefined)))
        (when (or (not (Array/isArray baseline-samples))
                  (not (Array/isArray optimized-samples))
                  (not (= (js-length baseline-samples) samples))
                  (not (= (js-length optimized-samples) samples)))
          (funcall reject "compiler binary comparison samples are incomplete")))
      (let* ((validation (get report :validation))
             (corpus (get report :corpus))
             (files (if corpus (get corpus :files) undefined))
             (file-count (if files (js-length files) undefined)))
        (when (or (not validation)
                  (not (= (get validation :compiledModules) file-count))
                  (not (= (get validation :validSourceMaps) file-count))
                  (<= (get validation :baselineChecksum) 0)
                  (<= (get validation :optimizedChecksum) 0)
                  (>= (get validation :optimizedBytes) (get validation :baselineBytes)))
          (funcall reject "compiler binary comparison validation failed")))
      (let ((decision (get report :decision))
            (measurements (get report :measurements)))
        (when (or (not decision)
                  (not (= (get decision :passed) t))
                  (< (get measurements :speedup) (get decision :minimumSpeedup)))
          (funcall reject "compiler binary comparison speedup decision failed")))
      report))

  (defun coalesce (a b c)
    (if (not (= a undefined))
        (if (not (= a nil)) a (if (not (= b undefined)) (if (not (= b nil)) b c) c))
      (if (not (= b undefined)) (if (not (= b nil)) b c) c)))

  (defasync runCompilerBinaryComparisonBenchmark (options)
    (let* ((env (get process :env))
           (warmup-rounds
             (positive-integer
               (coalesce (get options :warmupRounds)
                         (get env :ELISCRIPT_COMPILER_COMPARISON_WARMUP_ROUNDS)
                         2)
               "warmup rounds"))
           (timing-rounds
             (positive-integer
               (coalesce (get options :timingRounds)
                         (get env :ELISCRIPT_COMPILER_COMPARISON_TIMING_ROUNDS)
                         6)
               "timing rounds"))
           (timing-samples
             (positive-integer
               (coalesce (get options :timingSamples)
                         (get env :ELISCRIPT_COMPILER_COMPARISON_TIMING_SAMPLES)
                         11)
               "timing samples")))
      (when (= (% timing-samples 2) 0)
        (throw (new globalThis.TypeError "timing samples must be odd")))
      (let ((minimum-speedup
              (globalThis.Number
                (coalesce (get options :minimumSpeedup)
                          (get env :ELISCRIPT_COMPILER_COMPARISON_MINIMUM_SPEEDUP)
                          1.15))))
        (when (or (not (Number/isFinite minimum-speedup)) (<= minimum-speedup 1))
          (throw (new globalThis.TypeError "minimum speedup must be greater than 1")))
        (let* ((baseline-root (js-call path :resolve (get options :baselineRoot)))
               (revision (git-revision baseline-root)))
          (when (not (= revision COMPILER_BINARY_COMPARISON_BASELINE))
            (throw (new globalThis.TypeError
                     (str "baseline must be " COMPILER_BINARY_COMPARISON_BASELINE ", got " revision))))
          (let* ((corpus
                   (await (Promise/all
                            (js-call compiler-sources :map
                              (async (relative)
                                (let ((source (await (readFile (js-call path :join project-directory relative) "utf8"))))
                                  (js-object :relative relative :source source)))))))
                 (source-bytes
                   (js-call corpus :reduce
                     (lambda (total item) (+ total (Buffer/byteLength (get item :source))))
                     0))
                 (compilers
                   (await (Promise/all
                            (js-array
                              (load-compiler baseline-root "baseline")
                              (load-compiler project-directory "optimized")))))
                 (baseline (aref compilers 0))
                 (optimized (aref compilers 1))
                 (baseline-bytes 0)
                 (optimized-bytes 0)
                 (valid-source-maps 0))
            (let ((index 0))
              (while (< index (js-length corpus))
                (let* ((item (aref corpus index))
                       (relative (get item :relative))
                       (source (get item :source))
                       (baseline-result (js-call baseline :compile_string_with_source_map source relative "module.mjs" relative))
                       (optimized-result (js-call optimized :compile_string_with_source_map source relative "module.mjs" relative)))
                  (JSON/parse (get baseline-result :sourceMap))
                  (JSON/parse (get optimized-result :sourceMap))
                  (setq valid-source-maps (+ valid-source-maps 1))
                  (setq baseline-bytes (+ baseline-bytes (Buffer/byteLength (get baseline-result :javascript))))
                  (setq optimized-bytes (+ optimized-bytes (Buffer/byteLength (get optimized-result :javascript)))))
                (setq index (+ index 1))))
            (let ((round 0))
              (while (< round warmup-rounds)
                (compile-corpus baseline corpus 1)
                (compile-corpus optimized corpus 1)
                (setq round (+ round 1))))
            (let ((baseline-samples (js-array))
                  (optimized-samples (js-array))
                  (baseline-checksum 0)
                  (optimized-checksum 0)
                  (sample 0))
              (while (< sample timing-samples)
                (let ((order (if (= (% sample 2) 0)
                                 (js-array
                                   (js-array baseline baseline-samples "baseline")
                                   (js-array optimized optimized-samples "optimized"))
                               (js-array
                                 (js-array optimized optimized-samples "optimized")
                                 (js-array baseline baseline-samples "baseline"))))
                      (order-index 0))
                  (while (< order-index (js-length order))
                    (let* ((entry (aref order order-index))
                           (compiler (aref entry 0))
                           (samples (aref entry 1))
                           (identity (aref entry 2))
                           (result (compile-corpus compiler corpus timing-rounds)))
                      (js-call samples :push (get result :milliseconds))
                      (if (= identity "baseline")
                          (setq baseline-checksum (get result :checksum))
                        (setq optimized-checksum (get result :checksum))))
                    (setq order-index (+ order-index 1))))
                (setq sample (+ sample 1)))
              (let* ((baseline-median (median baseline-samples))
                     (optimized-median (median optimized-samples))
                     (speedup (/ baseline-median optimized-median)))
                (validateCompilerBinaryComparisonReport
                  (js-object
                    :format COMPILER_BINARY_COMPARISON_FORMAT
                    :version COMPILER_BINARY_COMPARISON_VERSION
                    :generatedAt (js-call (new globalThis.Date) :toISOString)
                    :sourceDigest (await (compilerBinaryComparisonSourceDigest))
                    :host (js-object
                            :runtime "bun"
                            :runtimeVersion (get globalThis.Bun :version)
                            :engine "JavaScriptCore"
                            :platform (get process :platform)
                            :architecture (get process :arch)
                            :operatingSystem (str (js-call os :type) " " (js-call os :release)))
                    :baseline (js-object
                                :revision revision
                                :root (js-call path :basename baseline-root))
                    :corpus (js-object
                              :files compiler-sources
                              :sourceBytes source-bytes)
                    :parameters (js-object
                                  :warmupRounds warmup-rounds
                                  :timingRounds timing-rounds
                                  :timingSamples timing-samples)
                    :validation (js-object
                                  :compiledModules (js-length corpus)
                                  :validSourceMaps valid-source-maps
                                  :baselineBytes baseline-bytes
                                  :optimizedBytes optimized-bytes
                                  :baselineChecksum baseline-checksum
                                  :optimizedChecksum optimized-checksum)
                    :measurements (js-object
                                    :baseline (js-object :samplesMs baseline-samples :medianMs baseline-median)
                                    :optimized (js-object :samplesMs optimized-samples :medianMs optimized-median)
                                    :speedup speedup)
                    :decision (js-object
                                :minimumSpeedup minimum-speedup
                                :passed (>= speedup minimum-speedup)))))))))))

  (defasync run-main ()
    (let ((options (parse-arguments (js-call (get process :argv) :slice 2)))
          (report undefined))
      (try
        (setq report (await (runCompilerBinaryComparisonBenchmark options)))
        (catch error
          (when (get error :report)
            (let ((failed (str (JSON/stringify (get error :report) nil 2) "\n")))
              (if (= (get options :output) undefined)
                  (js-call (get process :stdout) :write failed)
                (await (writeFile (js-call path :resolve (get options :output)) failed)))))
          (throw error)))
      (let ((json (str (JSON/stringify report nil 2) "\n")))
        (if (get options :output)
            (await (writeFile (js-call path :resolve (get options :output)) json))
          (js-call (get process :stdout) :write json)))))

  (when (js* "import.meta.main")
    (run-main))

  (export
    COMPILER_BINARY_COMPARISON_FORMAT
    COMPILER_BINARY_COMPARISON_VERSION
    COMPILER_BINARY_COMPARISON_BASELINE
    compilerBinaryComparisonSourceDigest
    validateCompilerBinaryComparisonReport
    runCompilerBinaryComparisonBenchmark))
