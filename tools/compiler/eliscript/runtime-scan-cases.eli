(module tools.compiler.runtime-scan-cases
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile realpath)
  (import "node:path" resolve)
  (import "node:module" createRequire)

  (defconst compilerSources (Object/freeze (js-array "symbol" "syntax" "reader" "formatter" "expander"
    "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler")))
  (defun irNode (kind &rest arguments)
    (let* ((value (if (> (js-length arguments) 0) (aref arguments 0) nil))
           (children (if (> (js-length arguments) 1) (aref arguments 1) (js-array)))
           (properties (if (> (js-length arguments) 2) (aref arguments 2) undefined))
           (node (js-object :kind kind :span nil :value value :children children)))
      (unless (undefined? properties) (put node :properties properties)) node))
  (defun expression (node) (irNode "expression-statement" nil (js-array node)))
  (defun literal (value &rest arguments)
    (let ((kind (if (> (js-length arguments) 0) (aref arguments 0) undefined)))
      (irNode "literal" value (js-array) (if (undefined? kind) undefined (js-object :literalKind kind)))))
  (defasync verifyRuntimeScan (directory source-root)
    (let* ((path (await (realpath (resolve directory "compiler.mjs"))))
           (load (createRequire path)) (compiler (funcall load path))
           (emitter (funcall load (await (realpath (resolve directory "emitter.mjs")))))
           (programs (js-array)))
      (let ((index 0))
        (while (< index (js-length compilerSources))
          (let* ((filename (str "bootstrap/compiler/" (aref compilerSources index) ".eli"))
                 (source (await (readFile (resolve source-root filename) "utf8"))))
            (js-call programs :push (js-call compiler :compile_ir_string source filename)))
          (setq index (1+ index))))
      (let* ((all (js-object :filename "all-runtime-requirements.eli" :body (js-array
               (expression (irNode "persistent-vector-literal" nil (js-array (literal 1))))
               (expression (irNode "intrinsic" "string-to-number" (js-array (literal "0xff"))))
               (expression (irNode "intrinsic" "-" (js-array (literal "0xff") (literal 1))))
               (expression (irNode "intrinsic" "imul32" (js-array (literal 1) (literal 2))))
               (expression (irNode "intrinsic" "host-identity-token" (js-array (irNode "object-literal" nil))))
               (expression (irNode "intrinsic" "length" (js-array (irNode "array-literal" nil))))
               (expression (irNode "intrinsic" "car" (js-array (irNode "persistent-list-literal" nil))))
               (expression (irNode "intrinsic" "equal" (js-array (literal 1) (literal 1))))
               (expression (irNode "method-call" "js-call" (js-array (irNode "reference" "values") (literal "join")))))))
             (static (js-object :filename "static-keyword-property.eli" :body (js-array
               (expression (irNode "property-read" "get" (js-array (irNode "reference" "value")
                 (irNode "literal" "static-key" (js-array (irNode "persistent-vector-literal" nil (js-array (literal 1))))
                   (js-object :literalKind "keyword"))))))))
             (math (js-call compiler :compile_ir_string "(Math/sin 0)" "runtime-math-requirement.eli")))
        (js-call programs :push all static math)
        (js-call programs :forEach (lambda (program)
          (js-call assert :deepStrictEqual (js-call emitter :runtime_requirements program)
            (js-call emitter :reference_runtime_requirements program))))
        (js-call assert :deepStrictEqual (js-call emitter :runtime_requirements all)
          (js-object :numericCoercion t :imul t :arrayText t :numberConversion t :hostIdentityToken t
            :literal t :collection t :list t :value t :binding false :math false))
        (js-call assert :deepStrictEqual (js-call emitter :runtime_requirements static)
          (js-object :numericCoercion false :imul false :arrayText false :numberConversion false :hostIdentityToken false
            :literal false :collection false :list false :value false :binding false :math false))
        (js-call assert :strictEqual (get (js-call emitter :runtime_requirements math) :math) t))))
  (export verifyRuntimeScan compilerSources))
