(module tools.compiler.runtime-scan-benchmark
  (import "node:fs/promises" readFile writeFile)
  (import "node:os" :default os)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../backends/dist/release-cli.mjs" requirePreparedStage3)
  (import "./controlled-baseline.mjs" compilerBenchmarkSourceDigest)

  (defconst COMPILER_RUNTIME_SCAN_FORMAT "eliscript-compiler-runtime-scan-benchmark")
  (defconst COMPILER_RUNTIME_SCAN_VERSION 1)

  (defconst directory (js-call path :dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst project-directory (js-call path :resolve directory "../.."))
  (defconst compiler-sources
    (Object/freeze
      (js-array
        "bootstrap/compiler/symbol.eli"
        "bootstrap/compiler/syntax.eli"
        "bootstrap/compiler/reader.eli"
        "bootstrap/compiler/formatter.eli"
        "bootstrap/compiler/expander.eli"
        "bootstrap/compiler/transient-analysis.eli"
        "bootstrap/compiler/analyzer.eli"
        "bootstrap/compiler/ir.eli"
        "bootstrap/compiler/lower.eli"
        "bootstrap/compiler/source-map.eli"
        "bootstrap/compiler/emitter.eli"
        "bootstrap/compiler/project.eli"
        "bootstrap/compiler/compiler.eli")))
  (defconst digest-files
    (Object/freeze
      (js-call compiler-sources :concat (js-array "tools/compiler/runtime-scan-benchmark.eli" "tools/compiler/runtime-scan-benchmark.mjs"))))

  (defun parse-positive-integer (value name)
    (let ((parsed (globalThis.Number value)))
      (when (or (not (Number/isSafeInteger parsed)) (<= parsed 0))
        (throw (new globalThis.TypeError (str name " must be a positive safe integer"))))
      parsed))

  (defun parse-arguments (arguments*)
    (let ((output undefined)
          (index 0))
      (while (< index (js-length arguments*))
        (let ((argument (aref arguments* index)))
          (cond
            ((= argument "--output")
             (setq output (aref arguments* (+ index 1)))
             (when (= output undefined)
               (throw (new globalThis.TypeError "--output requires a path")))
             (setq index (+ index 1)))
            ((= argument "--help")
             (js-call (get process :stdout) :write
               (str "Usage: bun tools/compiler/runtime-scan-benchmark.mjs "
                    "[--output REPORT.json]\n"))
             (js-call process :exit 0))
            (t
             (throw (new globalThis.TypeError (str "unknown argument " argument))))))
        (setq index (+ index 1)))
      (js-object :output output)))

  (defasync compilerRuntimeScanSourceDigest ()
    (await (compilerBenchmarkSourceDigest project-directory digest-files
             (await (requirePreparedStage3)))))

  (defun ir-node (kind &rest __opt)
    (let* ((value (aref __opt 0))
           (children (aref __opt 1))
           (properties (aref __opt 2))
           (node (js-object
                   :kind kind
                   :span nil
                   :value (if (= value undefined) nil value)
                   :children (if (= children undefined) (js-array) children))))
      (when (not (= properties undefined))
        (put node :properties properties))
      node))

  (defun requirement-exercise-program ()
    (let ((literal (lambda (value &rest __opt)
                     (let ((literal-kind (aref __opt 0)))
                       (ir-node "literal" value (js-array)
                         (if (= literal-kind undefined)
                             undefined
                           (js-object :literalKind literal-kind))))))
          (expression (lambda (node)
                        (ir-node "expression-statement" nil (js-array node)))))
      (js-object
        :filename "<runtime-requirement-exercise>"
        :body (js-array
                (funcall expression
                  (ir-node "persistent-vector-literal" nil (js-array (funcall literal 1))))
                (funcall expression
                  (ir-node "intrinsic" "host-identity-token"
                    (js-array (ir-node "object-literal" nil))))
                (funcall expression
                  (ir-node "intrinsic" "length"
                    (js-array (ir-node "array-literal" nil))))
                (funcall expression
                  (ir-node "intrinsic" "car"
                    (js-array (ir-node "persistent-list-literal" nil))))
                (funcall expression
                  (ir-node "intrinsic" "equal"
                    (js-array (funcall literal 1) (funcall literal 1))))
                (funcall expression
                  (ir-node "property-read" "get"
                    (js-array
                      (ir-node "reference" "value")
                      (funcall literal "static-key" "keyword"))))))))

  (defun requirement-checksum (requirements)
    (+ (globalThis.Number (get requirements :hostIdentityToken))
       (* (globalThis.Number (get requirements :literal)) 2)
       (* (globalThis.Number (get requirements :collection)) 4)
       (* (globalThis.Number (get requirements :list)) 8)
       (* (globalThis.Number (get requirements :value)) 16)))

  (defun count-program-nodes (program)
    (let ((count 0)
          (stack (js-call (get program :body) :slice)))
      (while (> (js-length stack) 0)
        (let* ((node (js-call stack :pop))
               (children (or (get node :children) (js-array)))
               (idx 0))
          (setq count (+ count 1))
          (while (< idx (js-length children))
            (js-call stack :push (aref children idx))
            (setq idx (+ idx 1)))))
      count))

  (defun median (values)
    (let ((sorted (js-call (js-call values :slice) :sort (lambda (left right) (- left right)))))
      (aref sorted (Math/floor (/ (js-length sorted) 2)))))

  (defun measure (scan programs iterations)
    (let ((checksum 0)
          (start (js-call globalThis.performance :now))
          (iteration 0))
      (while (< iteration iterations)
        (let ((index 0))
          (while (< index (js-length programs))
            (setq checksum (+ checksum (requirement-checksum (funcall scan (aref programs index)))))
            (setq index (+ index 1))))
        (setq iteration (+ iteration 1)))
      (js-object
        :milliseconds (- (js-call globalThis.performance :now) start)
        :checksum checksum)))

  (defasync load-generated-compiler ()
    (let ((module-directory (js-call path :join project-directory "dist/bootstrap")))
      (try
        (let ((loaded
                (await (Promise/all
                         (js-array
                           (funcall (js* "(u) => import(u)") (get (pathToFileURL (js-call path :join module-directory "compiler.mjs")) :href))
                           (funcall (js* "(u) => import(u)") (get (pathToFileURL (js-call path :join module-directory "emitter.mjs")) :href)))))))
          (js-object
            :compiler (aref loaded 0)
            :emitter (aref loaded 1)))
        (catch error
          (throw (new globalThis.Error
                   "generated compiler is unavailable; run bun run build:bootstrap first"
                   (js-object :cause error)))))))

  (defun validateCompilerRuntimeScanReport (report)
    (when (or (not report)
              (not (= (get report :format) COMPILER_RUNTIME_SCAN_FORMAT))
              (not (= (get report :version) COMPILER_RUNTIME_SCAN_VERSION)))
      (throw (new globalThis.TypeError "invalid compiler runtime scan report identity")))
    (let ((validation (get report :validation)))
      (when (or (not validation)
                (not (= (get validation :equivalent) t))
                (< (get validation :programs) (+ (js-length compiler-sources) 1))
                (<= (get validation :checksum) 0))
        (throw (new globalThis.TypeError "compiler runtime scan equivalence was not proven"))))
    (let* ((measurements (get report :measurements))
           (parameters (get report :parameters))
           (samples (if parameters (get parameters :timingSamples) undefined))
           (opt-meas (if measurements (get measurements :optimized) undefined))
           (ref-meas (if measurements (get measurements :reference) undefined))
           (opt-samples (if opt-meas (get opt-meas :samplesMs) undefined))
           (ref-samples (if ref-meas (get ref-meas :samplesMs) undefined)))
      (when (or (not (Array/isArray opt-samples))
                (not (Array/isArray ref-samples))
                (not (= (js-length opt-samples) samples))
                (not (= (js-length ref-samples) samples)))
        (throw (new globalThis.TypeError "compiler runtime scan timing samples are incomplete"))))
    (let ((decision (get report :decision))
          (measurements (get report :measurements)))
      (when (or (not decision)
                (not (= (get decision :passed) t))
                (< (get measurements :speedup) (get decision :minimumSpeedup)))
        (throw (new globalThis.TypeError "compiler runtime scan speedup decision did not pass"))))
    report)

  (defun coalesce (a b c)
    (if (not (= a undefined))
        (if (not (= a nil)) a (if (not (= b undefined)) (if (not (= b nil)) b c) c))
      (if (not (= b undefined)) (if (not (= b nil)) b c) c)))

  (defasync runCompilerRuntimeScanBenchmark (&optional options)
    (await (requirePreparedStage3))
    (let* ((opts (or options (js-object)))
           (env (get process :env))
           (warmup-iterations
             (parse-positive-integer
               (coalesce (get opts :warmupIterations)
                         (get env :ELISCRIPT_COMPILER_SCAN_WARMUP_ITERATIONS)
                         20)
               "warmup iterations"))
           (timing-iterations
             (parse-positive-integer
               (coalesce (get opts :timingIterations)
                         (get env :ELISCRIPT_COMPILER_SCAN_TIMING_ITERATIONS)
                         80)
               "timing iterations"))
           (timing-samples
             (parse-positive-integer
               (coalesce (get opts :timingSamples)
                         (get env :ELISCRIPT_COMPILER_SCAN_TIMING_SAMPLES)
                         9)
               "timing samples")))
      (when (= (% timing-samples 2) 0)
        (throw (new globalThis.TypeError "timing samples must be odd")))
      (let ((minimum-speedup
              (globalThis.Number
                (coalesce (get opts :minimumSpeedup)
                          (get env :ELISCRIPT_COMPILER_SCAN_MINIMUM_SPEEDUP)
                          1.25))))
        (when (or (not (Number/isFinite minimum-speedup)) (<= minimum-speedup 1))
          (throw (new globalThis.TypeError "minimum speedup must be greater than 1")))
        (let* ((loaded (await (load-generated-compiler)))
               (compiler (get loaded :compiler))
               (emitter (get loaded :emitter))
               (programs (js-array))
               (source-bytes 0)
               (index 0))
          (while (< index (js-length compiler-sources))
            (let* ((relative (aref compiler-sources index))
                   (source (await (readFile (js-call path :join project-directory relative) "utf8"))))
              (setq source-bytes (+ source-bytes (Buffer/byteLength source)))
              (js-call programs :push (js-call compiler :compile_ir_string source relative)))
            (setq index (+ index 1)))
          (js-call programs :push (requirement-exercise-program))
          (let ((checksum 0)
                (prog-idx 0))
            (while (< prog-idx (js-length programs))
              (let* ((program (aref programs prog-idx))
                     (optimized (js-call emitter :runtime_requirements program))
                     (reference (js-call emitter :reference_runtime_requirements program)))
                (when (not (= (JSON/stringify optimized) (JSON/stringify reference)))
                  (throw (new globalThis.Error
                           (str "runtime requirement mismatch for " (get program :filename) ": "
                                (JSON/stringify optimized) " != " (JSON/stringify reference)))))
                (setq checksum (+ checksum (requirement-checksum optimized))))
              (setq prog-idx (+ prog-idx 1)))
            (measure (get emitter :runtime_requirements) programs warmup-iterations)
            (measure (get emitter :reference_runtime_requirements) programs warmup-iterations)
            (let ((optimized-samples (js-array))
                  (reference-samples (js-array))
                  (sample 0))
              (while (< sample timing-samples)
                (let ((order (if (= (% sample 2) 0)
                                 (js-array
                                   (js-array (get emitter :runtime_requirements) optimized-samples)
                                   (js-array (get emitter :reference_runtime_requirements) reference-samples))
                               (js-array
                                 (js-array (get emitter :reference_runtime_requirements) reference-samples)
                                 (js-array (get emitter :runtime_requirements) optimized-samples))))
                      (expected-checksum undefined)
                      (order-idx 0))
                  (while (< order-idx (js-length order))
                    (let* ((entry (aref order order-idx))
                           (scan-fn (aref entry 0))
                           (samples (aref entry 1))
                           (measured (measure scan-fn programs timing-iterations)))
                      (js-call samples :push (get measured :milliseconds))
                      (when (= expected-checksum undefined)
                        (setq expected-checksum (get measured :checksum)))
                      (when (not (= (get measured :checksum) expected-checksum))
                        (throw (new globalThis.Error "runtime requirement benchmark checksum drifted"))))
                    (setq order-idx (+ order-idx 1))))
                (setq sample (+ sample 1)))
              (let* ((optimized-median (median optimized-samples))
                     (reference-median (median reference-samples))
                     (speedup (/ reference-median optimized-median))
                     (report
                       (js-object
                         :format COMPILER_RUNTIME_SCAN_FORMAT
                         :version COMPILER_RUNTIME_SCAN_VERSION
                         :generatedAt (js-call (new globalThis.Date) :toISOString)
                         :sourceDigest (await (compilerRuntimeScanSourceDigest))
                         :host (js-object
                                 :runtime "bun"
                                 :runtimeVersion (get globalThis.Bun :version)
                                 :engine "JavaScriptCore"
                                 :platform (get process :platform)
                                 :architecture (get process :arch)
                                 :operatingSystem (str (js-call os :type) " " (js-call os :release)))
                         :corpus (js-object
                                   :files compiler-sources
                                   :sourceBytes source-bytes
                                   :programs (js-length programs)
                                   :irNodes (js-call programs :reduce
                                              (lambda (total program)
                                                (+ total (count-program-nodes program)))
                                              0))
                         :parameters (js-object
                                       :warmupIterations warmup-iterations
                                       :timingIterations timing-iterations
                                       :timingSamples timing-samples)
                         :validation (js-object
                                       :equivalent t
                                       :programs (js-length programs)
                                       :checksum checksum)
                         :measurements (js-object
                                         :optimized (js-object :samplesMs optimized-samples :medianMs optimized-median)
                                         :reference (js-object :samplesMs reference-samples :medianMs reference-median)
                                         :speedup speedup)
                         :decision (js-object
                                     :minimumSpeedup minimum-speedup
                                     :passed (>= speedup minimum-speedup)))))
                (validateCompilerRuntimeScanReport report))))))))

  (defasync run-main ()
    (let* ((parsed (parse-arguments (js-call (get process :argv) :slice 2)))
           (output (get parsed :output))
           (report (await (runCompilerRuntimeScanBenchmark)))
           (serialized (str (JSON/stringify report nil 2) "\n")))
      (if (= output undefined)
          (js-call (get process :stdout) :write serialized)
        (progn
          (await (writeFile (js-call path :resolve output) serialized))
          (js-call (get process :stdout) :write (str (js-call path :resolve output) "\n"))))))

  (when (js* "import.meta.main")
    (run-main))

  (export
    COMPILER_RUNTIME_SCAN_FORMAT
    COMPILER_RUNTIME_SCAN_VERSION
    compilerRuntimeScanSourceDigest
    validateCompilerRuntimeScanReport
    runCompilerRuntimeScanBenchmark))
