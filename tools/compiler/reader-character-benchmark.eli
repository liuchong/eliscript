(module tools.compiler.reader-character-benchmark
  (import "node:fs/promises" readFile writeFile)
  (import "node:os" :default os)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../backends/dist/release-cli.mjs" requirePreparedStage3)
  (import "./controlled-baseline.mjs" buildControlledBaseline validateControlledBaseline
    compilerBenchmarkSourceDigest)

  (defconst COMPILER_READER_CHARACTER_FORMAT "eliscript-compiler-reader-character-benchmark")
  (defconst COMPILER_READER_CHARACTER_VERSION 1)
  (defconst COMPILER_READER_CHARACTER_BASELINE "d6822134a187d4247611db56822ef47164a76a61")

  (defconst controlled-target "bootstrap/compiler/reader.eli")
  (defconst controlled-names
    (js-array "whitespace-code-p" "delimiter-code-p" "read-token" "skip-space-and-comments"))

  (defconst directory (js-call path :dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst project-directory (js-call path :resolve directory "../.."))
  (defconst compiler-sources
    (Object/freeze
      (js-array
        "bootstrap/compiler/symbol.eli"
        "bootstrap/compiler/syntax.eli"
        "bootstrap/compiler/reader.eli"
        "bootstrap/compiler/formatter.eli"
        "bootstrap/compiler/expander.eli"
        "bootstrap/compiler/transient-analysis.eli"
        "bootstrap/compiler/analyzer.eli"
        "bootstrap/compiler/ir.eli"
        "bootstrap/compiler/lower.eli"
        "bootstrap/compiler/source-map.eli"
        "bootstrap/compiler/emitter.eli"
        "bootstrap/compiler/project.eli"
        "bootstrap/compiler/compiler.eli")))
  (defconst digest-files
    (Object/freeze
      (js-call compiler-sources :concat
        (js-array
          "tools/compiler/reader-character-benchmark.eli" "tools/compiler/reader-character-benchmark.mjs"
          "tools/compiler/controlled-baseline.mjs"))))

  (defun positive-integer (value name)
    (let ((parsed (globalThis.Number value)))
      (when (or (not (Number/isSafeInteger parsed)) (<= parsed 0))
        (throw (new globalThis.TypeError (str name " must be a positive safe integer"))))
      parsed))

  (defun parse-arguments (arguments*)
    (let ((baseline-root undefined)
          (output undefined)
          (index 0))
      (while (< index (js-length arguments*))
        (let ((argument (aref arguments* index)))
          (cond
            ((= argument "--baseline-root")
             (setq index (+ index 1))
             (setq baseline-root (aref arguments* index)))
            ((= argument "--output")
             (setq index (+ index 1))
             (setq output (aref arguments* index)))
            ((= argument "--help")
             (js-call (get process :stdout) :write
               (str "Usage: bun tools/compiler/reader-character-benchmark.mjs "
                    "--baseline-root DIR [--output REPORT.json]\n"))
             (js-call process :exit 0))
            (t
             (throw (new globalThis.TypeError (str "unknown argument " argument))))))
        (setq index (+ index 1)))
      (when (not baseline-root)
        (throw (new globalThis.TypeError "--baseline-root is required")))
      (js-object
        :baselineRoot (js-call path :resolve baseline-root)
        :output output)))

  (defasync compilerReaderCharacterSourceDigest ()
    (await (compilerBenchmarkSourceDigest project-directory digest-files
             (await (requirePreparedStage3)))))

  (defun git-revision (root)
    (let ((result (js-call globalThis.Bun :spawnSync (js-array "git" "-C" root "rev-parse" "HEAD"))))
      (when (not (= (get result :exitCode) 0))
        (throw (new globalThis.Error (js-call (js-call (new globalThis.TextDecoder) :decode (get result :stderr)) :trim))))
      (js-call (js-call (new globalThis.TextDecoder) :decode (get result :stdout)) :trim)))

  (defasync load-generated (root file identity)
    (let ((location (js-call path :join root "dist/bootstrap" (str file ".mjs"))))
      (funcall (js* "(u) => import(u)") (str (get (pathToFileURL location) :href) "?reader-character=" identity))))

  (defun median (samples)
    (let ((values (js-call (js-call samples :slice) :sort (lambda (left right) (- left right)))))
      (aref values (Math/floor (/ (js-length values) 2)))))

  (defun source-code-points (corpus)
    (let ((values (js-array undefined))
          (corpus-idx 0))
      (while (< corpus-idx (js-length corpus))
        (let* ((item (aref corpus corpus-idx))
               (source (get item :source))
               (index 0))
          (while (< index (js-length source))
            (let ((code (js-call source :codePointAt index)))
              (js-call values :push code)
              (setq index (+ index (if (> code 65535) 2 1))))))
        (setq corpus-idx (+ corpus-idx 1)))
      values))

  (defun measure-predicates (reader values iterations optimized)
    (let ((whitespace (if optimized
                          (get reader :whitespace_code_p)
                        (get reader :reference_whitespace_code_p)))
          (delimiter (if optimized
                         (get reader :delimiter_code_p)
                       (get reader :reference_delimiter_code_p)))
          (checksum 0)
          (start (js-call globalThis.performance :now))
          (iteration 0))
      (while (< iteration iterations)
        (let ((index 0))
          (while (< index (js-length values))
            (let ((value (aref values index)))
              (setq checksum (+ checksum (if (funcall whitespace value) 1 0)))
              (setq checksum (+ checksum (if (funcall delimiter value) 1 0))))
            (setq index (+ index 1))))
        (setq iteration (+ iteration 1)))
      (js-object
        :milliseconds (- (js-call globalThis.performance :now) start)
        :checksum checksum)))

  (defun compile-corpus (compiler corpus rounds)
    (let ((checksum 0)
          (start (js-call globalThis.performance :now))
          (round 0))
      (while (< round rounds)
        (let ((index 0))
          (while (< index (js-length corpus))
            (let* ((item (aref corpus index))
                   (relative (get item :relative))
                   (result (js-call compiler :compile_string_with_source_map
                             (get item :source)
                             relative
                             (str (js-call path :basename relative ".eli") ".mjs")
                             relative)))
              (setq checksum (+ checksum
                                (js-length (get result :javascript))
                                (js-length (get result :sourceMap)))))
            (setq index (+ index 1))))
        (setq round (+ round 1)))
      (js-object
        :milliseconds (- (js-call globalThis.performance :now) start)
        :checksum checksum)))

  (defun validateCompilerReaderCharacterReport (report)
    (when (or (not report)
              (not (= (get report :format) COMPILER_READER_CHARACTER_FORMAT))
              (not (= (get report :version) COMPILER_READER_CHARACTER_VERSION))
              (not (get report :baseline))
              (not (= (get (get report :baseline) :revision) COMPILER_READER_CHARACTER_BASELINE)))
      (throw (new globalThis.TypeError "invalid compiler reader character report identity")))
    (validateControlledBaseline
      (get (get report :baseline) :control)
      controlled-target
      controlled-names
      compiler-sources)
    (let* ((parameters (get report :parameters))
           (samples (if parameters (get parameters :timingSamples) undefined))
           (measurements (get report :measurements))
           (keys (js-array "referencePredicates" "optimizedPredicates" "baselineCompiler" "optimizedCompiler"))
           (idx 0))
      (while (< idx (js-length keys))
        (let* ((key (aref keys idx))
               (entry (if measurements (get measurements key) undefined))
               (samples-ms (if entry (get entry :samplesMs) undefined)))
          (when (or (not (Array/isArray samples-ms))
                    (not (= (js-length samples-ms) samples)))
            (throw (new globalThis.TypeError "compiler reader character samples are incomplete"))))
        (setq idx (+ idx 1))))
    (let* ((validation (get report :validation))
           (corpus (get report :corpus))
           (files (if corpus (get corpus :files) undefined))
           (file-count (if files (js-length files) undefined)))
      (when (or (not validation)
                (not corpus)
                (not (= (get validation :equivalentCodePoints) (get corpus :predicateCodePoints)))
                (not (= (get validation :identicalCompilerOutputs) file-count))
                (not (= (get validation :validSourceMaps) file-count))
                (<= (get validation :predicateChecksum) 0)
                (<= (get validation :baselineCompilerChecksum) 0)
                (not (= (get validation :baselineCompilerChecksum)
                        (get validation :optimizedCompilerChecksum))))
        (throw (new globalThis.TypeError "compiler reader character validation failed"))))
    (let ((decision (get report :decision))
          (measurements (get report :measurements)))
      (when (or (not decision)
                (not (Number/isFinite (get decision :minimumCompleteCompilerSpeedup)))
                (< (get decision :minimumCompleteCompilerSpeedup) 1.08)
                (not (= (get decision :passed) t))
                (< (get measurements :completeCompilerSpeedup)
                   (get decision :minimumCompleteCompilerSpeedup)))
        (let ((err (new globalThis.TypeError
                     (str "compiler reader character speedup decision failed: "
                          (get measurements :completeCompilerSpeedup)
                          " < "
                          (if decision (get decision :minimumCompleteCompilerSpeedup) undefined)))))
          (put err :report report)
          (throw err))))
    report)

  (defun coalesce (a b c)
    (if (not (= a undefined))
        (if (not (= a nil)) a (if (not (= b undefined)) (if (not (= b nil)) b c) c))
      (if (not (= b undefined)) (if (not (= b nil)) b c) c)))

  (defasync runCompilerReaderCharacterBenchmark (options)
    (await (requirePreparedStage3))
    (let* ((env (get process :env))
           (warmup-rounds
             (positive-integer
               (coalesce (get options :warmupRounds)
                         (get env :ELISCRIPT_COMPILER_READER_WARMUP_ROUNDS)
                         2)
               "warmup rounds"))
           (predicate-iterations
             (positive-integer
               (coalesce (get options :predicateIterations)
                         (get env :ELISCRIPT_COMPILER_READER_PREDICATE_ITERATIONS)
                         20)
               "predicate iterations"))
           (compiler-rounds
             (positive-integer
               (coalesce (get options :compilerRounds)
                         (get env :ELISCRIPT_COMPILER_READER_COMPILER_ROUNDS)
                         8)
               "compiler rounds"))
           (timing-samples
             (positive-integer
               (coalesce (get options :timingSamples)
                         (get env :ELISCRIPT_COMPILER_READER_TIMING_SAMPLES)
                         15)
               "timing samples")))
      (when (= (% timing-samples 2) 0)
        (throw (new globalThis.TypeError "timing samples must be odd")))
      (let ((minimum-complete-compiler-speedup
              (globalThis.Number
                (coalesce (get options :minimumCompleteCompilerSpeedup)
                          (get env :ELISCRIPT_COMPILER_READER_MINIMUM_SPEEDUP)
                          1.08))))
        (when (or (not (Number/isFinite minimum-complete-compiler-speedup))
                  (<= minimum-complete-compiler-speedup 1))
          (throw (new globalThis.TypeError "minimum complete compiler speedup must exceed 1")))
        (let* ((baseline-root (js-call path :resolve (get options :baselineRoot)))
               (revision (git-revision baseline-root)))
          (when (not (= revision COMPILER_READER_CHARACTER_BASELINE))
            (throw (new globalThis.TypeError
                     (str "baseline must be " COMPILER_READER_CHARACTER_BASELINE ", got " revision))))
          (let* ((control
                   (await (buildControlledBaseline
                            (js-object
                              :root project-directory
                              :baselineRoot baseline-root
                              :revision revision
                              :sources compiler-sources
                              :target controlled-target
                              :names controlled-names))))
                 (corpus
                   (await (Promise/all
                            (js-call compiler-sources :map
                              (async (relative)
                                (js-object
                                  :relative relative
                                  :source (await (readFile (js-call path :join project-directory relative) "utf8"))))))))
                 (source-bytes
                   (js-call corpus :reduce
                     (lambda (total item) (+ total (Buffer/byteLength (get item :source))))
                     0))
                 (loaded
                   (await (Promise/all
                            (js-array
                              (funcall (js* "(u) => import(u)") (get (pathToFileURL (js-call path :join (get control :directory) "compiler.mjs")) :href))
                              (load-generated project-directory "compiler" "optimized")
                              (load-generated project-directory "reader" "predicates")))))
                 (baseline-compiler (aref loaded 0))
                 (optimized-compiler (aref loaded 1))
                 (reader (aref loaded 2))
                 (predicate-values (source-code-points corpus))
                 (equivalent-code-points 0))
            (let ((val-idx 0))
              (while (< val-idx (js-length predicate-values))
                (let ((value (aref predicate-values val-idx)))
                  (when (or (not (= (js-call reader :whitespace_code_p value)
                                    (js-call reader :reference_whitespace_code_p value)))
                            (not (= (js-call reader :delimiter_code_p value)
                                    (js-call reader :reference_delimiter_code_p value))))
                    (throw (new globalThis.Error (str "reader character decision differs for " (globalThis.String value)))))
                  (setq equivalent-code-points (+ equivalent-code-points 1)))
                (setq val-idx (+ val-idx 1))))
            (let ((identical-compiler-outputs 0)
                  (valid-source-maps 0)
                  (generated-bytes 0)
                  (corpus-idx 0))
              (while (< corpus-idx (js-length corpus))
                (let* ((item (aref corpus corpus-idx))
                       (relative (get item :relative))
                       (source (get item :source))
                       (baseline (js-call baseline-compiler :compile_string_with_source_map source relative "module.mjs" relative))
                       (optimized (js-call optimized-compiler :compile_string_with_source_map source relative "module.mjs" relative)))
                  (when (or (not (= (get baseline :javascript) (get optimized :javascript)))
                            (not (= (get baseline :sourceMap) (get optimized :sourceMap))))
                    (throw (new globalThis.Error (str "compiler output differs for " relative))))
                  (JSON/parse (get optimized :sourceMap))
                  (setq identical-compiler-outputs (+ identical-compiler-outputs 1))
                  (setq valid-source-maps (+ valid-source-maps 1))
                  (setq generated-bytes (+ generated-bytes (Buffer/byteLength (get optimized :javascript)))))
                (setq corpus-idx (+ corpus-idx 1)))
              (let ((warmup-idx 0))
                (while (< warmup-idx warmup-rounds)
                  (measure-predicates reader predicate-values 1 nil)
                  (measure-predicates reader predicate-values 1 t)
                  (compile-corpus baseline-compiler corpus 1)
                  (compile-corpus optimized-compiler corpus 1)
                  (setq warmup-idx (+ warmup-idx 1))))
              (let ((reference-predicate-samples (js-array))
                    (optimized-predicate-samples (js-array))
                    (baseline-compiler-samples (js-array))
                    (optimized-compiler-samples (js-array))
                    (predicate-checksum 0)
                    (baseline-compiler-checksum 0)
                    (optimized-compiler-checksum 0)
                    (sample 0))
                (while (< sample timing-samples)
                  (let* ((optimized-first (= (% sample 2) 1))
                         (predicate-order
                           (if optimized-first
                               (js-array
                                 (js-array t optimized-predicate-samples)
                                 (js-array nil reference-predicate-samples))
                             (js-array
                               (js-array nil reference-predicate-samples)
                               (js-array t optimized-predicate-samples))))
                         (pred-idx 0))
                    (while (< pred-idx (js-length predicate-order))
                      (let* ((entry (aref predicate-order pred-idx))
                             (opt (aref entry 0))
                             (samples (aref entry 1))
                             (result (measure-predicates reader predicate-values predicate-iterations opt)))
                        (js-call samples :push (get result :milliseconds))
                        (setq predicate-checksum (get result :checksum)))
                      (setq pred-idx (+ pred-idx 1)))
                    (let ((compiler-order
                            (if optimized-first
                                (js-array
                                  (js-array optimized-compiler optimized-compiler-samples t)
                                  (js-array baseline-compiler baseline-compiler-samples nil))
                              (js-array
                                (js-array baseline-compiler baseline-compiler-samples nil)
                                (js-array optimized-compiler optimized-compiler-samples t))))
                          (comp-idx 0))
                      (while (< comp-idx (js-length compiler-order))
                        (let* ((entry (aref compiler-order comp-idx))
                               (compiler (aref entry 0))
                               (samples (aref entry 1))
                               (opt (aref entry 2))
                               (result (compile-corpus compiler corpus compiler-rounds)))
                          (js-call samples :push (get result :milliseconds))
                          (if opt
                              (setq optimized-compiler-checksum (get result :checksum))
                            (setq baseline-compiler-checksum (get result :checksum))))
                        (setq comp-idx (+ comp-idx 1)))))
                  (setq sample (+ sample 1)))
                (let* ((reference-predicate-median (median reference-predicate-samples))
                       (optimized-predicate-median (median optimized-predicate-samples))
                       (baseline-compiler-median (median baseline-compiler-samples))
                       (optimized-compiler-median (median optimized-compiler-samples))
                       (complete-compiler-speedup (/ baseline-compiler-median optimized-compiler-median)))
                  (validateCompilerReaderCharacterReport
                    (js-object
                      :format COMPILER_READER_CHARACTER_FORMAT
                      :version COMPILER_READER_CHARACTER_VERSION
                      :generatedAt (js-call (new globalThis.Date) :toISOString)
                      :sourceDigest (await (compilerReaderCharacterSourceDigest))
                      :host (js-object
                              :runtime "bun"
                              :runtimeVersion (get globalThis.Bun :version)
                              :engine "JavaScriptCore"
                              :platform (get process :platform)
                              :architecture (get process :arch)
                              :operatingSystem (str (js-call os :type) " " (js-call os :release)))
                      :baseline (js-object
                                  :revision revision
                                  :root (js-call path :basename baseline-root)
                                  :control (get control :evidence))
                      :corpus (js-object
                                :files compiler-sources
                                :sourceBytes source-bytes
                                :generatedBytes generated-bytes
                                :predicateCodePoints (js-length predicate-values))
                      :parameters (js-object
                                    :warmupRounds warmup-rounds
                                    :predicateIterations predicate-iterations
                                    :compilerRounds compiler-rounds
                                    :timingSamples timing-samples)
                      :validation (js-object
                                    :equivalentCodePoints equivalent-code-points
                                    :identicalCompilerOutputs identical-compiler-outputs
                                    :validSourceMaps valid-source-maps
                                    :predicateChecksum predicate-checksum
                                    :baselineCompilerChecksum baseline-compiler-checksum
                                    :optimizedCompilerChecksum optimized-compiler-checksum)
                      :measurements (js-object
                                      :referencePredicates (js-object :samplesMs reference-predicate-samples :medianMs reference-predicate-median)
                                      :optimizedPredicates (js-object :samplesMs optimized-predicate-samples :medianMs optimized-predicate-median)
                                      :predicateSpeedup (/ reference-predicate-median optimized-predicate-median)
                                      :baselineCompiler (js-object :samplesMs baseline-compiler-samples :medianMs baseline-compiler-median)
                                      :optimizedCompiler (js-object :samplesMs optimized-compiler-samples :medianMs optimized-compiler-median)
                                      :completeCompilerSpeedup complete-compiler-speedup)
                      :decision (js-object
                                  :minimumCompleteCompilerSpeedup minimum-complete-compiler-speedup
                                  :passed (>= complete-compiler-speedup minimum-complete-compiler-speedup))))))))))))

  (defasync run-main ()
    (let ((options (parse-arguments (js-call (get process :argv) :slice 2)))
          (report undefined))
      (try
        (setq report (await (runCompilerReaderCharacterBenchmark options)))
        (catch error
          (when (get error :report)
            (let ((failed (str (JSON/stringify (get error :report) nil 2) "\n")))
              (if (get options :output)
                  (await (writeFile (js-call path :resolve (get options :output)) failed))
                (js-call (get process :stdout) :write failed))))
          (throw error)))
      (let ((json (str (JSON/stringify report nil 2) "\n")))
        (if (get options :output)
            (await (writeFile (js-call path :resolve (get options :output)) json))
          (js-call (get process :stdout) :write json)))))

  (when (js* "import.meta.main")
    (run-main))

  (export
    COMPILER_READER_CHARACTER_FORMAT
    COMPILER_READER_CHARACTER_VERSION
    COMPILER_READER_CHARACTER_BASELINE
    compilerReaderCharacterSourceDigest
    validateCompilerReaderCharacterReport
    runCompilerReaderCharacterBenchmark))
