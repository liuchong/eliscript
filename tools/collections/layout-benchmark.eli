(module tools.collections.layout-benchmark
  (import "../../runtime/core/map-internals.mjs"
    ArrayNode BitmapIndexedNode MapEntry mapAssoc mapDissoc mapFind mapHash)

  (defconst LAYOUT_HOST_REPORT_FORMAT "eliscript-hamt-layout-host")
  (defconst LAYOUT_HOST_REPORT_VERSION 1)
  (defconst DEFAULT_OCCUPANCIES (Object/freeze (js-array 4 8 12 15 16 20 24 28 32)))
  (defconst NOT_FOUND -1)
  (defconst MIXED_WEIGHTS (Object/freeze (js-object :lookup 0.8 :assoc 0.1 :dissoc 0.1)))

  (defun median (values)
    (let* ((sorted (js-call (Array/from values) :sort (lambda (left right) (- left right))))
           (middle (Math/floor (/ (js-length sorted) 2))))
      (if (= (% (js-length sorted) 2) 1)
        (aref sorted middle)
        (/ (+ (aref sorted (1- middle)) (aref sorted middle)) 2))))

  (defun validate-positive-integer (name value)
    (when (or (not (Number/isSafeInteger value)) (<= value 0))
      (throw (new globalThis.TypeError (str name " must be a positive safe integer"))))
    value)

  (defun validate-occupancies (occupancies)
    (let ((values (Array/from occupancies))
          (previous 0)
          (index 0))
      (when (= (js-length values) 0)
        (throw (new globalThis.TypeError "occupancies must not be empty")))
      (while (< index (js-length values))
        (let ((occupancy (aref values index)))
          (when (or (not (Number/isInteger occupancy)) (<= occupancy previous) (> occupancy 32))
            (throw (new globalThis.TypeError "occupancies must be strictly increasing integers between 1 and 32")))
          (setq previous occupancy))
        (setq index (1+ index)))
      (Object/freeze values)))

  (defun branch-keys (&rest __opt)
    (let* ((supplied-required (aref __opt 0))
           (required-per-branch (if (undefined? supplied-required) 2 supplied-required))
           (keys (Array/from (js-object :length 32) (lambda () (js-array))))
           (remaining (* 32 required-per-branch))
           (candidate 0))
      (while (> remaining 0)
        (let* ((h (mapHash candidate))
               (branch (bit-and h 31)))
          (when (< (js-length (aref keys branch)) required-per-branch)
            (js-call (aref keys branch) :push (Object/freeze (js-object :key candidate :hash h)))
            (setq remaining (1- remaining))))
        (setq candidate (1+ candidate)))
      (Object/freeze (js-call keys :map (lambda (values) (Object/freeze values))))))

  (defun scenario-for (occupancy keys)
    (let ((entries (js-array))
          (bitmap 0)
          (children (js-call (new globalThis.Array 32) :fill undefined))
          (probes (js-array))
          (branch 0))
      (while (< branch occupancy)
        (let* ((item (aref (aref keys branch) 0))
               (key (get item :key))
               (hash (get item :hash))
               (entry (new MapEntry key (1+ branch) hash)))
          (js-call entries :push entry)
          (put children branch entry)
          (setq bitmap (unsigned-bit-shift-right (bit-or bitmap (bit-shift-left 1 branch)) 0))
          (js-call probes :push (Object/freeze (js-object :key key :hash hash :expected (1+ branch)))))
        (setq branch (1+ branch)))
      (let* ((missing-branch (if (< occupancy 32) occupancy 0))
             (missing (aref (aref keys missing-branch) (if (< occupancy 32) 0 1))))
        (js-call probes :push (Object/freeze (js-object
          :key (get missing :key)
          :hash (get missing :hash)
          :expected NOT_FOUND)))
        (Object/freeze (js-object
          :occupancy occupancy
          :bitmapRoot (new BitmapIndexedNode bitmap entries)
          :arrayRoot (new ArrayNode occupancy children)
          :probes (Object/freeze probes))))))

  (defun validate-root (root probes)
    (let ((index 0))
      (while (< index (js-length probes))
        (let* ((probe (aref probes index))
               (actual (mapFind root (get probe :hash) (get probe :key) NOT_FOUND)))
          (unless (= actual (get probe :expected))
            (throw (new globalThis.Error
              (str "layout benchmark lookup mismatch: expected " (get probe :expected) ", received " actual)))))
        (setq index (1+ index)))))

  (defun lookup-checksum (root probes iterations)
    (let ((checksum 0) (index 0) (len (js-length probes)))
      (while (< index iterations)
        (let* ((probe (aref probes (% index len)))
               (value (mapFind root (get probe :hash) (get probe :key) NOT_FOUND)))
          (setq checksum (unsigned-bit-shift-right
                           (imul32 (unsigned-bit-shift-right (bit-xor checksum value) 0) 73244475) 0)))
        (setq index (1+ index)))
      checksum))

  (defun measure-lookups (root probes iterations samples now)
    (let ((warmup-iterations (Math/max 1000 (Math/floor (/ iterations 5))))
          (timings (js-array))
          (checksum undefined)
          (sample 0))
      (lookup-checksum root probes warmup-iterations)
      (while (< sample samples)
        (let* ((started (funcall now))
               (current (lookup-checksum root probes iterations)))
          (js-call timings :push (- (funcall now) started))
          (if (undefined? checksum)
            (setq checksum current)
            (unless (= checksum current)
              (throw (new globalThis.Error "layout benchmark checksum changed between samples")))))
        (setq sample (1+ sample)))
      (Object/freeze (js-object
        :samplesMs (Object/freeze timings)
        :medianMs (median timings)
        :checksum checksum))))

  (defun mutation-checksum (root probes iterations operation)
    (let ((checksum 0) (index 0) (limit (1- (js-length probes))))
      (while (< index iterations)
        (let* ((probe (aref probes (% index limit)))
               (result (if (= operation "assoc")
                         (mapAssoc root (get probe :hash) (get probe :key) (- 0 (+ index 2)))
                         (mapDissoc root (get probe :hash) (get probe :key))))
               (signal (if (= operation "assoc")
                         (+ (funcall globalThis.Number (get result :changed))
                            (bit-shift-left (funcall globalThis.Number (get result :added)) 1))
                         (funcall globalThis.Number (get result :removed))))
               (item (get result :item))
               (occupancy (if (eq (get item :constructor) ArrayNode)
                            (get item :count)
                            (js-length (get item :items)))))
          (setq checksum (unsigned-bit-shift-right
                           (imul32 (unsigned-bit-shift-right (bit-xor (bit-xor checksum signal) occupancy) 0) 73244475) 0)))
        (setq index (1+ index)))
      checksum))

  (defun measure-mutations (root probes iterations samples now operation)
    (let ((warmup-iterations (Math/max 500 (Math/floor (/ iterations 10))))
          (timings (js-array))
          (checksum undefined)
          (sample 0))
      (mutation-checksum root probes warmup-iterations operation)
      (while (< sample samples)
        (let* ((started (funcall now))
               (current (mutation-checksum root probes iterations operation)))
          (js-call timings :push (- (funcall now) started))
          (if (undefined? checksum)
            (setq checksum current)
            (unless (= checksum current)
              (throw (new globalThis.Error (str operation " benchmark checksum changed between samples"))))))
        (setq sample (1+ sample)))
      (Object/freeze (js-object
        :samplesMs (Object/freeze timings)
        :medianMs (median timings)
        :checksum checksum))))

  (defasync settle-heap (collect-garbage)
    (unless (undefined? collect-garbage)
      (await (funcall collect-garbage))
      (await (funcall collect-garbage))
      (await (Promise/resolve))))

  (defasync measure-node-bytes (options)
    (let ((factory (get options :factory))
          (node-count (get options :nodeCount))
          (samples (get options :samples))
          (collect-garbage (get options :collectGarbage))
          (heap-used (get options :heapUsed)))
      (if (or (undefined? collect-garbage) (undefined? heap-used))
        (Object/freeze (js-object :samples (Object/freeze (js-array)) :median nil))
        (let ((bytes (js-array)) (sample 0))
          (while (< sample samples)
            (await (settle-heap collect-garbage))
            (let* ((before (funcall heap-used))
                   (nodes (Array/from (js-object :length node-count) factory))
                   (_ (await (settle-heap collect-garbage)))
                   (after (funcall heap-used))
                   (retained (if (= (aref nodes 0) (aref nodes (1- (js-length nodes)))) 0 (js-length nodes))))
              (unless (= retained node-count)
                (throw (new globalThis.Error "layout benchmark failed to retain distinct nodes")))
              (js-call bytes :push (/ (Math/max 0 (- after before)) node-count))
              (setq nodes nil)
              (await (settle-heap collect-garbage)))
            (setq sample (1+ sample)))
          (Object/freeze (js-object
            :samples (Object/freeze bytes)
            :median (median bytes)))))))

  (defun finite-ratio (numerator denominator)
    (if (> denominator 0) (/ numerator denominator) nil))

  (defun mixed-operation-cost (lookup assoc dissoc lookup-iterations mutation-iterations)
    (+ (* (get MIXED_WEIGHTS :lookup) (/ (get lookup :medianMs) lookup-iterations))
       (* (get MIXED_WEIGHTS :assoc) (/ (get assoc :medianMs) mutation-iterations))
       (* (get MIXED_WEIGHTS :dissoc) (/ (get dissoc :medianMs) mutation-iterations))))

  (defasync runLayoutHostBenchmark (&rest __opt)
    (let* ((supplied-options (aref __opt 0))
           (options (if (undefined? supplied-options) (js-object) supplied-options))
           (host (get options :host))
           (occupancies (if (undefined? (get options :occupancies)) DEFAULT_OCCUPANCIES (get options :occupancies)))
           (lookup-iterations (if (undefined? (get options :lookupIterations)) 250000 (get options :lookupIterations)))
           (mutation-iterations (if (undefined? (get options :mutationIterations)) 50000 (get options :mutationIterations)))
           (timing-samples (if (undefined? (get options :timingSamples)) 7 (get options :timingSamples)))
           (memory-node-count (if (undefined? (get options :memoryNodeCount)) 20000 (get options :memoryNodeCount)))
           (memory-samples (if (undefined? (get options :memorySamples)) 3 (get options :memorySamples)))
           (now (if (undefined? (get options :now)) (lambda () (js-call globalThis.performance :now)) (get options :now)))
           (collect-garbage (get options :collectGarbage))
           (heap-used (get options :heapUsed)))
      (when (or (eq host nil) (/= (value-type host) "object"))
        (throw (new globalThis.TypeError "layout benchmark host metadata is required")))
      (let ((occupancy-values (validate-occupancies occupancies)))
        (validate-positive-integer "lookupIterations" lookup-iterations)
        (validate-positive-integer "mutationIterations" mutation-iterations)
        (validate-positive-integer "timingSamples" timing-samples)
        (validate-positive-integer "memoryNodeCount" memory-node-count)
        (validate-positive-integer "memorySamples" memory-samples)
        (let ((keys (branch-keys))
              (measurements (js-array))
              (index 0))
          (while (< index (js-length occupancy-values))
            (let* ((occupancy (aref occupancy-values index))
                   (scenario (scenario-for occupancy keys))
                   (bitmap-root (get scenario :bitmapRoot))
                   (array-root (get scenario :arrayRoot))
                   (probes (get scenario :probes)))
              (validate-root bitmap-root probes)
              (validate-root array-root probes)
              (let ((bitmap-lookup (measure-lookups bitmap-root probes lookup-iterations timing-samples now))
                    (array-lookup (measure-lookups array-root probes lookup-iterations timing-samples now)))
                (unless (= (get bitmap-lookup :checksum) (get array-lookup :checksum))
                  (throw (new globalThis.Error "bitmap and array layout checksums differ")))
                (let ((bitmap-assoc (measure-mutations bitmap-root probes mutation-iterations timing-samples now "assoc"))
                      (array-assoc (measure-mutations array-root probes mutation-iterations timing-samples now "assoc"))
                      (bitmap-dissoc (measure-mutations bitmap-root probes mutation-iterations timing-samples now "dissoc"))
                      (array-dissoc (measure-mutations array-root probes mutation-iterations timing-samples now "dissoc")))
                  (when (or (/= (get bitmap-assoc :checksum) (get array-assoc :checksum))
                            (/= (get bitmap-dissoc :checksum) (get array-dissoc :checksum)))
                    (throw (new globalThis.Error "bitmap and array mutation checksums differ")))
                  (let* ((bitmap-memory (await (measure-node-bytes (js-object
                           :factory (lambda () (new BitmapIndexedNode (get bitmap-root :bitmap)
                                                 (js-call (get bitmap-root :items) :slice)))
                           :nodeCount memory-node-count
                           :samples memory-samples
                           :collectGarbage collect-garbage
                           :heapUsed heap-used))))
                         (array-memory (await (measure-node-bytes (js-object
                           :factory (lambda () (new ArrayNode (get array-root :count)
                                                 (js-call (get array-root :children) :slice)))
                           :nodeCount memory-node-count
                           :samples memory-samples
                           :collectGarbage collect-garbage
                           :heapUsed heap-used))))
                         (bitmap-mixed (mixed-operation-cost bitmap-lookup bitmap-assoc bitmap-dissoc lookup-iterations mutation-iterations))
                         (array-mixed (mixed-operation-cost array-lookup array-assoc array-dissoc lookup-iterations mutation-iterations)))
                    (js-call measurements :push (Object/freeze (js-object
                      :occupancy occupancy
                      :probes (js-length probes)
                      :checksum (get bitmap-lookup :checksum)
                      :bitmap (Object/freeze (js-object
                        :lookup bitmap-lookup
                        :assoc bitmap-assoc
                        :dissoc bitmap-dissoc
                        :bytesPerNode bitmap-memory))
                      :array (Object/freeze (js-object
                        :lookup array-lookup
                        :assoc array-assoc
                        :dissoc array-dissoc
                        :bytesPerNode array-memory))
                      :ratios (Object/freeze (js-object
                        :arrayToBitmapLookup (finite-ratio (get array-lookup :medianMs) (get bitmap-lookup :medianMs))
                        :arrayToBitmapAssoc (finite-ratio (get array-assoc :medianMs) (get bitmap-assoc :medianMs))
                        :arrayToBitmapDissoc (finite-ratio (get array-dissoc :medianMs) (get bitmap-dissoc :medianMs))
                        :arrayToBitmapMixed (finite-ratio array-mixed bitmap-mixed)
                        :arrayToBitmapBytes (if (or (eq (get bitmap-memory :median) nil) (eq (get array-memory :median) nil))
                                              nil
                                              (finite-ratio (get array-memory :median) (get bitmap-memory :median))))))))))))
            (setq index (1+ index)))
          (Object/freeze (js-object
            :format LAYOUT_HOST_REPORT_FORMAT
            :version LAYOUT_HOST_REPORT_VERSION
            :host (Object/freeze (Object/assign (js-object) host))
            :parameters (Object/freeze (js-object
              :occupancies occupancy-values
              :lookupIterations lookup-iterations
              :mutationIterations mutation-iterations
              :timingSamples timing-samples
              :memoryNodeCount memory-node-count
              :memorySamples memory-samples
              :mixedWeights MIXED_WEIGHTS))
            :validation (Object/freeze (js-object
              :passed t
              :representations (Object/freeze (js-array "bitmap-indexed" "array-32"))
              :lookupPath "runtime/core/map-internals.mjs#mapFind"))
            :measurements (Object/freeze measurements)))))))

  (defun validateLayoutHostReport (report)
    (let ((errors (js-array))
          (format (unless (nullish? report) (get report :format)))
          (version (unless (nullish? report) (get report :version)))
          (validation (unless (nullish? report) (get report :validation)))
          (measurements (unless (nullish? report) (get report :measurements)))
          (parameters (unless (nullish? report) (get report :parameters))))
      (unless (= format LAYOUT_HOST_REPORT_FORMAT)
        (js-call errors :push (str "invalid format " (JSON/stringify format))))
      (unless (= version LAYOUT_HOST_REPORT_VERSION)
        (js-call errors :push (str "invalid version " (JSON/stringify version))))
      (unless (and validation (= (get validation :passed) t))
        (js-call errors :push "lookup validation did not pass"))
      (when (or (not (Array/isArray measurements)) (= (js-length measurements) 0))
        (js-call errors :push "measurements must not be empty"))
      (let ((occupancies (unless (nullish? parameters) (get parameters :occupancies))))
        (unless (= (if measurements (js-length measurements) undefined)
                   (if occupancies (js-length occupancies) undefined))
          (js-call errors :push "measurement and occupancy counts differ"))
        (let ((index 0) (len (if (Array/isArray measurements) (js-length measurements) 0)))
          (while (< index len)
            (let ((measurement (aref measurements index))
                  (expected-occ (when occupancies (aref occupancies index))))
              (when (or (not (Number/isInteger (get measurement :occupancy)))
                        (< (get measurement :occupancy) 1)
                        (> (get measurement :occupancy) 32))
                (js-call errors :push (str "invalid occupancy " (JSON/stringify (get measurement :occupancy)))))
              (unless (= (get measurement :occupancy) expected-occ)
                (js-call errors :push (str "measurement " index " does not match its declared occupancy")))
              (js-call (js-array "bitmap" "array") :forEach (lambda (representation)
                (let ((rep (unless (nullish? measurement) (get measurement representation))))
                  (js-call (js-array "lookup" "assoc" "dissoc") :forEach (lambda (operation)
                    (let ((measurement-op (unless (nullish? rep) (get rep operation))))
                      (when (or (not (Number/isFinite (unless (nullish? measurement-op) (get measurement-op :medianMs))))
                                (< (get measurement-op :medianMs) 0))
                        (js-call errors :push (str representation " " operation " median is invalid")))
                      (when (or (not (Array/isArray (unless (nullish? measurement-op) (get measurement-op :samplesMs))))
                                (/= (js-length (get measurement-op :samplesMs)) (get parameters :timingSamples)))
                        (js-call errors :push (str representation " " operation " samples are missing"))))))
                  (let ((memory (unless (nullish? rep) (get rep :bytesPerNode))))
                    (if (and memory (eq (get memory :median) nil))
                      (when (or (not (Array/isArray (get memory :samples))) (/= (js-length (get memory :samples)) 0))
                        (js-call errors :push (str representation " unsupported memory samples must be empty")))
                      (when (or (not (Number/isFinite (unless (nullish? memory) (get memory :median))))
                                (<= (get memory :median) 0)
                                (/= (if (and memory (get memory :samples)) (js-length (get memory :samples)) -1)
                                    (get parameters :memorySamples)))
                        (js-call errors :push (str representation " memory samples are invalid"))))))))
              (let ((bm (unless (nullish? measurement) (get measurement :bitmap)))
                    (ar (unless (nullish? measurement) (get measurement :array))))
                (unless (= (and bm (get bm :lookup) (get (get bm :lookup) :checksum))
                           (and ar (get ar :lookup) (get (get ar :lookup) :checksum)))
                  (js-call errors :push (str "occupancy " (get measurement :occupancy) " checksum differs")))
                (js-call (js-array "assoc" "dissoc") :forEach (lambda (operation)
                  (unless (= (and bm (get bm operation) (get (get bm operation) :checksum))
                             (and ar (get ar operation) (get (get ar operation) :checksum)))
                    (js-call errors :push (str "occupancy " (get measurement :occupancy) " " operation " checksum differs")))))
                (js-call (Object/entries (or (get measurement :ratios) (js-object))) :forEach (lambda (pair)
                  (let ((name (aref pair 0)) (ratio (aref pair 1)))
                    (when (and (not (eq ratio nil)) (or (not (Number/isFinite ratio)) (<= ratio 0)))
                      (js-call errors :push (str "occupancy " (get measurement :occupancy) " " name " ratio is invalid"))))))))
            (setq index (1+ index)))))
      (when (> (js-length errors) 0)
        (throw (new globalThis.TypeError (str "invalid HAMT layout host report: " (js-call errors :join "; ")))))
      report))

  (export LAYOUT_HOST_REPORT_FORMAT LAYOUT_HOST_REPORT_VERSION DEFAULT_OCCUPANCIES
          runLayoutHostBenchmark validateLayoutHostReport))
