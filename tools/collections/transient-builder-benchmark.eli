(module tools.collections.transient-builder-benchmark
  (import "node:crypto" createHash)
  (import "node:fs/promises" readdir readFile writeFile)
  (import "node:os" :default os)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath)
  (import "../../runtime/core/map.mjs" EMPTY_MAP)
  (import "../../runtime/core/set.mjs" EMPTY_SET)
  (import "../../runtime/core/transducer.mjs" into)
  (import "../../runtime/core/value.mjs" equalValues hashValue)
  (import "../../runtime/core/vector.mjs" EMPTY_VECTOR)
  (import "../../runtime/testing/map.mjs"
    persistentMapMetrics resetPersistentMapMetrics resetTransientMapMetrics transientMapMetrics)
  (import "../../runtime/testing/set.mjs"
    persistentSetMetrics resetPersistentSetMetrics resetTransientSetMetrics transientSetMetrics)
  (import "../../runtime/testing/vector.mjs"
    persistentVectorMetrics resetPersistentVectorMetrics resetTransientVectorMetrics transientVectorMetrics)

  (defconst TRANSIENT_BUILDER_BENCHMARK_FORMAT "eliscript-transient-builder-benchmark")
  (defconst TRANSIENT_BUILDER_BENCHMARK_VERSION 1)

  (defconst directory (js-call path :dirname (fileURLToPath (get (js* "import.meta") :url))))
  (defconst project-directory (js-call path :resolve directory "../.."))
  (defconst tool-file "tools/collections/transient-builder-benchmark.mjs")
  (defconst testing-files (js-array
    "runtime/testing/map.mjs"
    "runtime/testing/set.mjs"
    "runtime/testing/vector.mjs"))

  (defun positive-integer (value name)
    (let ((parsed (funcall globalThis.Number value)))
      (when (or (not (Number/isSafeInteger parsed)) (<= parsed 0))
        (throw (new globalThis.TypeError (str name " must be a positive safe integer"))))
      parsed))

  (defun parse-arguments (args)
    (let ((output undefined) (index 0))
      (while (< index (js-length args))
        (let ((argument (aref args index)))
          (cond
            ((= argument "--output")
             (setq index (1+ index))
             (setq output (aref args index)))
            ((= argument "--help")
             (js-call (get process :stdout) :write
               "Usage: bun tools/collections/transient-builder-benchmark.mjs [--output REPORT.json]\n")
             (js-call process :exit 0))
            (t (throw (new globalThis.TypeError (str "unknown argument " argument))))))
        (setq index (1+ index)))
      (js-object :output output)))

  (defasync source-files ()
    (let* ((core-directory (js-call path :join project-directory "runtime/core"))
           (core-files (js-call (js-call (js-call (await (readdir core-directory))
                                           :filter (lambda (name) (js-call name :endsWith ".mjs")))
                                  :map (lambda (name) (str "runtime/core/" name)))
                         :sort)))
      (js-call core-files :concat testing-files (js-array tool-file))))

  (defasync transientBuilderSourceDigest ()
    (let ((files (await (source-files)))
          (hash (createHash "sha256"))
          (index 0))
      (while (< index (js-length files))
        (let ((relative (aref files index)))
          (js-call hash :update relative)
          (js-call hash :update "\u0000")
          (js-call hash :update (await (readFile (js-call path :join project-directory relative))))
          (js-call hash :update "\u0000"))
        (setq index (1+ index)))
      (js-object :algorithm "sha256" :files files :value (js-call hash :digest "hex"))))

  (defun median (samples)
    (let ((values (js-call (Array/from samples) :sort (lambda (left right) (- left right)))))
      (aref values (Math/floor (/ (js-length values) 2)))))

  (defun measure (run observe)
    (let* ((start (js-call globalThis.performance :now))
           (value (funcall run))
           (milliseconds (- (js-call globalThis.performance :now) start))
           (observation (funcall observe value)))
      (unless (= (get observation :valid) t)
        (throw (new globalThis.Error "transient builder produced an invalid result")))
      (js-object :milliseconds milliseconds :observation observation)))

  (defun make-cases (parameters)
    (let ((vector-values (Array/from (js-object :length (get parameters :vectorSize)) (lambda (_ index) index)))
          (map-entries (Array/from (js-object :length (get parameters :mapSize))
                         (lambda (_ index) (Object/freeze (js-array index (* index 2))))))
          (set-values (Array/from (js-object :length (get parameters :setSize)) (lambda (_ index) index))))
      (js-array
        (js-object
          :name "vector"
          :size (get parameters :vectorSize)
          :persistent (lambda ()
            (let ((value EMPTY_VECTOR) (i 0) (len (js-length vector-values)))
              (while (< i len)
                (setq value (js-call value :conj (aref vector-values i)))
                (setq i (1+ i)))
              value))
          :transient (lambda () (into EMPTY_VECTOR vector-values))
          :observe (lambda (value)
            (let ((len (js-length vector-values)))
              (js-object
                :valid (and (= (get value :count) len)
                            (= (js-call value :nth 0) 0)
                            (= (js-call value :nth (1- len)) (1- len)))
                :count (get value :count)
                :first (js-call value :nth 0)
                :last (js-call value :nth (1- len)))))
          :resetPersistent resetPersistentVectorMetrics
          :persistentMetrics persistentVectorMetrics
          :resetTransient resetTransientVectorMetrics
          :transientMetrics transientVectorMetrics
          :persistentCallField "persistentCalls")
        (js-object
          :name "map"
          :size (get parameters :mapSize)
          :persistent (lambda ()
            (let ((value EMPTY_MAP) (i 0) (len (js-length map-entries)))
              (while (< i len)
                (let ((pair (aref map-entries i)))
                  (setq value (js-call value :assoc (aref pair 0) (aref pair 1))))
                (setq i (1+ i)))
              value))
          :transient (lambda () (into EMPTY_MAP map-entries))
          :observe (lambda (value)
            (let ((len (js-length map-entries)))
              (js-object
                :valid (and (= (get value :count) len)
                            (= (js-call value :get 0) 0)
                            (= (js-call value :get (1- len)) (* (1- len) 2)))
                :count (get value :count)
                :first (js-call value :get 0)
                :last (js-call value :get (1- len)))))
          :resetPersistent resetPersistentMapMetrics
          :persistentMetrics persistentMapMetrics
          :resetTransient resetTransientMapMetrics
          :transientMetrics transientMapMetrics
          :persistentCallField "persistentCalls")
        (js-object
          :name "set"
          :size (get parameters :setSize)
          :persistent (lambda ()
            (let ((value EMPTY_SET) (i 0) (len (js-length set-values)))
              (while (< i len)
                (setq value (js-call value :conj (aref set-values i)))
                (setq i (1+ i)))
              value))
          :transient (lambda () (into EMPTY_SET set-values))
          :observe (lambda (value)
            (let ((len (js-length set-values)))
              (js-object
                :valid (and (= (get value :count) len)
                            (js-call value :has 0)
                            (js-call value :has (1- len)))
                :count (get value :count)
                :first (js-call value :has 0)
                :last (js-call value :has (1- len)))))
          :resetPersistent resetPersistentSetMetrics
          :persistentMetrics persistentSetMetrics
          :resetTransient resetTransientSetMetrics
          :transientMetrics transientSetMetrics
          :persistentCallField "setPersistentCalls"))))

  (defun correctness-evidence (item)
    (let* ((persistent (js-call item :persistent))
           (transient (js-call item :transient))
           (persistent-observation (js-call item :observe persistent))
           (transient-observation (js-call item :observe transient))
           (persistent-hash (hashValue persistent))
           (transient-hash (hashValue transient)))
      (js-object
        :equivalent (equalValues persistent transient)
        :sameHash (= persistent-hash transient-hash)
        :persistentHash persistent-hash
        :transientHash transient-hash
        :persistentObservation persistent-observation
        :transientObservation transient-observation)))

  (defun allocation-evidence (item)
    (js-call item :resetPersistent)
    (js-call item :persistent)
    (let ((persistent (js-call item :persistentMetrics)))
      (js-call item :resetPersistent)
      (js-call item :resetTransient)
      (js-call item :transient)
      (let ((production-persistent (js-call item :persistentMetrics))
            (production-transient (js-call item :transientMetrics)))
        (js-object
          :persistentNodeAllocations (get persistent :nodeAllocations)
          :transientNodeAllocations (get production-persistent :nodeAllocations)
          :allocationRatio (/ (get production-persistent :nodeAllocations) (get persistent :nodeAllocations))
          :transientMetrics production-transient
          :completionCalls (get production-transient (get item :persistentCallField))))))

  (defun timing-evidence (item parameters)
    (let ((index 0)
          (persistent-samples (js-array))
          (transient-samples (js-array))
          (sample 0))
      (while (< index (get parameters :warmupRounds))
        (measure (get item :persistent) (get item :observe))
        (measure (get item :transient) (get item :observe))
        (setq index (1+ index)))
      (while (< sample (get parameters :timingSamples))
        (let* ((transient-first (= (% sample 2) 1))
               (order (if transient-first
                        (js-array (js-array (get item :transient) transient-samples)
                                  (js-array (get item :persistent) persistent-samples))
                        (js-array (js-array (get item :persistent) persistent-samples)
                                  (js-array (get item :transient) transient-samples)))))
          (js-call order :forEach (lambda (pair)
            (js-call (aref pair 1) :push (get (measure (aref pair 0) (get item :observe)) :milliseconds)))))
        (setq sample (1+ sample)))
      (let ((persistent-median (median persistent-samples))
            (transient-median (median transient-samples)))
        (js-object
          :persistentSamplesMs persistent-samples
          :transientSamplesMs transient-samples
          :persistentMedianMs persistent-median
          :transientMedianMs transient-median
          :speedup (/ persistent-median transient-median)))))

  (defun validateTransientBuilderReport (report)
    (when (or (nullish? report)
              (/= (get report :format) TRANSIENT_BUILDER_BENCHMARK_FORMAT)
              (/= (get report :version) TRANSIENT_BUILDER_BENCHMARK_VERSION))
      (throw (new globalThis.TypeError "invalid transient builder benchmark identity")))
    (let ((samples (and (get report :parameters) (get (get report :parameters) :timingSamples)))
          (results (get report :results))
          (decision (get report :decision)))
      (js-call (js-array "vector" "map" "set") :forEach (lambda (name)
        (let* ((result (and results (get results name)))
               (timing (and result (get result :timing)))
               (correctness (and result (get result :correctness)))
               (allocation (and result (get result :allocation))))
          (when (or (not (Array/isArray (and timing (get timing :persistentSamplesMs))))
                    (not (Array/isArray (and timing (get timing :transientSamplesMs))))
                    (/= (js-length (get timing :persistentSamplesMs)) samples)
                    (/= (js-length (get timing :transientSamplesMs)) samples)
                    (/= (and correctness (get correctness :equivalent)) t)
                    (/= (and correctness (get correctness :sameHash)) t)
                    (/= (and correctness (get correctness :persistentObservation)
                             (get (get correctness :persistentObservation) :valid)) t)
                    (/= (and correctness (get correctness :transientObservation)
                             (get (get correctness :transientObservation) :valid)) t)
                    (<= (and allocation (get allocation :persistentNodeAllocations)) 0)
                    (< (and allocation (get allocation :transientNodeAllocations)) 0)
                    (> (get allocation :allocationRatio) (get decision :maximumAllocationRatio))
                    (/= (get allocation :completionCalls) 1)
                    (< (get timing :speedup) (get decision :minimumSpeedup)))
            (throw (new globalThis.TypeError (str "transient " name " builder evidence failed")))))))
      (unless (and decision (= (get decision :passed) t))
        (throw (new globalThis.TypeError "transient builder benchmark decision failed")))
      report))

  (defasync runTransientBuilderBenchmark (&optional supplied-options)
    (let* ((options (or supplied-options (js-object)))
           (env (get process :env))
           (parameters (js-object
             :vectorSize (positive-integer
                           (or (get options :vectorSize) (get env :ELISCRIPT_TRANSIENT_VECTOR_SIZE) 200000)
                           "vector size")
             :mapSize (positive-integer
                        (or (get options :mapSize) (get env :ELISCRIPT_TRANSIENT_MAP_SIZE) 100000)
                        "map size")
             :setSize (positive-integer
                        (or (get options :setSize) (get env :ELISCRIPT_TRANSIENT_SET_SIZE) 100000)
                        "set size")
             :warmupRounds (positive-integer
                             (or (get options :warmupRounds) (get env :ELISCRIPT_TRANSIENT_BUILDER_WARMUP_ROUNDS) 2)
                             "warmup rounds")
             :timingSamples (positive-integer
                              (or (get options :timingSamples) (get env :ELISCRIPT_TRANSIENT_BUILDER_TIMING_SAMPLES) 11)
                              "timing samples"))))
      (when (= (% (get parameters :timingSamples) 2) 0)
        (throw (new globalThis.TypeError "timing samples must be odd")))
      (let ((minimum-speedup (funcall globalThis.Number
              (or (get options :minimumSpeedup) (get env :ELISCRIPT_TRANSIENT_BUILDER_MINIMUM_SPEEDUP) 1.5)))
            (maximum-allocation-ratio (funcall globalThis.Number
              (or (get options :maximumAllocationRatio) (get env :ELISCRIPT_TRANSIENT_BUILDER_MAXIMUM_ALLOCATION_RATIO) (/ 1 3)))))
        (when (or (not (Number/isFinite minimum-speedup)) (<= minimum-speedup 1)
                  (not (Number/isFinite maximum-allocation-ratio)) (<= maximum-allocation-ratio 0) (>= maximum-allocation-ratio 1))
          (throw (new globalThis.TypeError "invalid transient builder decision thresholds")))
        (let ((results (js-object))
              (cases (make-cases parameters))
              (index 0))
          (while (< index (js-length cases))
            (let ((item (aref cases index)))
              (put results (get item :name) (js-object
                :size (get item :size)
                :correctness (correctness-evidence item)
                :allocation (allocation-evidence item)
                :timing (timing-evidence item parameters))))
            (setq index (1+ index)))
          (let ((passed (js-call (Object/values results) :every (lambda (result)
                          (and (get (get result :correctness) :equivalent)
                               (get (get result :correctness) :sameHash)
                               (<= (get (get result :allocation) :allocationRatio) maximum-allocation-ratio)
                               (= (get (get result :allocation) :completionCalls) 1)
                               (>= (get (get result :timing) :speedup) minimum-speedup))))))
            (validateTransientBuilderReport (js-object
              :format TRANSIENT_BUILDER_BENCHMARK_FORMAT
              :version TRANSIENT_BUILDER_BENCHMARK_VERSION
              :generatedAt (js-call (new globalThis.Date) :toISOString)
              :sourceDigest (await (transientBuilderSourceDigest))
              :host (js-object
                      :runtime "bun"
                      :runtimeVersion (get globalThis.Bun :version)
                      :engine "JavaScriptCore"
                      :platform (get process :platform)
                      :architecture (get process :arch)
                      :operatingSystem (str (js-call os :type) " " (js-call os :release)))
              :parameters parameters
              :results results
              :decision (js-object
                          :minimumSpeedup minimum-speedup
                          :maximumAllocationRatio maximum-allocation-ratio
                          :passed passed))))))))

  (defasync main ()
    (let* ((options (parse-arguments (js-call (get process :argv) :slice 2)))
           (report (await (runTransientBuilderBenchmark)))
           (json (str (JSON/stringify report nil 2) "\n")))
      (if (get options :output)
        (await (writeFile (js-call path :resolve (get options :output)) json))
        (js-call (get process :stdout) :write json))))

  (when (get (js* "import.meta") :main)
    (js-call (main) :catch (lambda (error)
      (js-call globalThis.console :error error)
      (put process :exitCode 1))))

  (export TRANSIENT_BUILDER_BENCHMARK_FORMAT TRANSIENT_BUILDER_BENCHMARK_VERSION
          transientBuilderSourceDigest validateTransientBuilderReport runTransientBuilderBenchmark))
