(module tools.collections.benchmark
  (import "node:child_process" spawn)
  (import "node:crypto" createHash)
  (import "node:fs" createReadStream)
  (import "node:fs/promises" copyFile mkdir mkdtemp readFile rm stat writeFile)
  (import "node:http" createServer)
  (import "node:os" tmpdir)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./layout-benchmark.mjs" validateLayoutHostReport)

  (defconst LAYOUT_SUITE_FORMAT "eliscript-hamt-layout-benchmark")
  (defconst LAYOUT_SUITE_VERSION 1)
  (defconst BROWSER_PORT 8740)
  (defconst BROWSER_DEBUG_PORT 8741)

  (defconst directory (js-call path :dirname (fileURLToPath (get (js* "import.meta") :url))))
  (defconst project-directory (js-call path :resolve directory "../.."))
  (defconst host-runner (js-call path :join directory "layout-host.mjs"))

  (defconst browser-module-files (Object/freeze (js-array
    "runtime/core/map-internals.mjs"
    "runtime/core/protocol-error.mjs"
    "runtime/core/protocol-impl.mjs"
    "runtime/core/protocol.mjs"
    "runtime/core/value-internals.mjs"
    "runtime/core/value.mjs"
    "tools/collections/browser/index.html"
    "tools/collections/browser/main.mjs"
    "tools/collections/layout-benchmark.mjs")))

  (defconst digest-files (Object/freeze (js-array
    "runtime/core/map-internals.mjs"
    "runtime/core/protocol-error.mjs"
    "runtime/core/protocol-impl.mjs"
    "runtime/core/protocol.mjs"
    "runtime/core/value.mjs"
    "runtime/core/value-internals.mjs"
    "tools/collections/benchmark.mjs"
    "tools/collections/browser/index.html"
    "tools/collections/browser/main.mjs"
    "tools/collections/layout-benchmark.mjs")))

  (defun parse-arguments (args)
    (let ((output undefined) (index 0))
      (while (< index (js-length args))
        (let ((argument (aref args index)))
          (cond
            ((= argument "--output")
             (setq output (aref args (1+ index)))
             (when (undefined? output)
               (throw (new globalThis.TypeError "--output requires a path")))
             (setq index (1+ index)))
            ((= argument "--help")
             (js-call (get process :stdout) :write
               "Usage: bun tools/collections/benchmark.mjs [--output REPORT.json]\n")
             (js-call process :exit 0))
            (t (throw (new globalThis.TypeError (str "unknown argument " argument))))))
        (setq index (1+ index)))
      (js-object :output output)))

  (defun benchmark-environment ()
    (let ((env (get process :env)))
      (Object/assign (js-object) env (js-object
        :ELISCRIPT_LAYOUT_OCCUPANCIES (or (get env :ELISCRIPT_LAYOUT_OCCUPANCIES) "4,8,12,15,16,20,24,28,32")
        :ELISCRIPT_LAYOUT_ITERATIONS (or (get env :ELISCRIPT_LAYOUT_ITERATIONS) "250000")
        :ELISCRIPT_LAYOUT_MUTATION_ITERATIONS (or (get env :ELISCRIPT_LAYOUT_MUTATION_ITERATIONS) "50000")
        :ELISCRIPT_LAYOUT_TIMING_SAMPLES (or (get env :ELISCRIPT_LAYOUT_TIMING_SAMPLES) "7")
        :ELISCRIPT_LAYOUT_MEMORY_NODES (or (get env :ELISCRIPT_LAYOUT_MEMORY_NODES) "20000")
        :ELISCRIPT_LAYOUT_MEMORY_SAMPLES (or (get env :ELISCRIPT_LAYOUT_MEMORY_SAMPLES) "3")))))

  (defasync benchmarkSourceDigest ()
    (let ((hash (createHash "sha256")) (index 0))
      (while (< index (js-length digest-files))
        (let ((relative (aref digest-files index)))
          (js-call hash :update relative)
          (js-call hash :update "\u0000")
          (js-call hash :update (await (readFile (js-call path :join project-directory relative))))
          (js-call hash :update "\u0000"))
        (setq index (1+ index)))
      (js-object :algorithm "sha256" :files digest-files :value (js-call hash :digest "hex"))))

  (defun run-command (command args &optional options)
    (let* ((opts (or options (js-object)))
           (env (get opts :env))
           (timeout-ms (if (undefined? (get opts :timeoutMs)) 120000 (get opts :timeoutMs))))
      (new globalThis.Promise (lambda (resolve-fn reject-fn)
        (let* ((child (spawn command args (js-object
                        :cwd project-directory
                        :env env
                        :stdio (js-array "ignore" "pipe" "pipe"))))
               (stdout (js-array))
               (stderr (js-array))
               (timed-out false)
               (timeout (funcall globalThis.setTimeout (lambda ()
                          (setq timed-out t)
                          (js-call child :kill "SIGTERM")
                          (js-call (funcall globalThis.setTimeout (lambda ()
                            (when (eq (get child :exitCode) nil)
                              (js-call child :kill "SIGKILL"))) 2000) :unref))
                        timeout-ms)))
          (js-call (get child :stdout) :on "data" (lambda (chunk) (js-call stdout :push chunk)))
          (js-call (get child :stderr) :on "data" (lambda (chunk) (js-call stderr :push chunk)))
          (js-call child :once "error" (lambda (error)
            (funcall globalThis.clearTimeout timeout)
            (funcall reject-fn error)))
          (js-call child :once "close" (lambda (code signal)
            (funcall globalThis.clearTimeout timeout)
            (let ((output (js-call (js-call globalThis.Buffer :concat stdout) :toString "utf8"))
                  (error-output (js-call (js-call globalThis.Buffer :concat stderr) :toString "utf8")))
              (if (or timed-out (/= code 0))
                (funcall reject-fn (new globalThis.Error
                  (if timed-out
                    (str command " timed out after " timeout-ms "ms")
                    (str command " exited with " (if (nullish? code) signal code) ": "
                         (if (> (js-length error-output) 0) error-output output)))))
                (funcall resolve-fn (js-object :stdout output :stderr error-output)))))))))))

  (defasync find-chrome-executable ()
    (let ((candidates (js-call (js-array
                        (get (get process :env) :CHROME)
                        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
                        "/usr/bin/google-chrome"
                        "/usr/bin/google-chrome-stable"
                        "/usr/bin/chromium"
                        "/usr/bin/chromium-browser") :filter (lambda (x) x)))
          (found undefined)
          (index 0))
      (while (and (undefined? found) (< index (js-length candidates)))
        (let ((candidate (aref candidates index)))
          (try
            (let ((metadata (await (stat candidate))))
              (when (js-call metadata :isFile)
                (setq found candidate)))
            (catch ignored nil)))
        (setq index (1+ index)))
      (when (undefined? found)
        (throw (new globalThis.Error "Chrome or Chromium executable not found; set CHROME explicitly")))
      found))

  (defun content-type (file)
    (let ((ext (js-call path :extname file)))
      (cond
        ((= ext ".html") "text/html; charset=utf-8")
        ((= ext ".js") "text/javascript; charset=utf-8")
        ((= ext ".mjs") "text/javascript; charset=utf-8")
        ((= ext ".css") "text/css; charset=utf-8")
        ((= ext ".json") "application/json; charset=utf-8")
        (t "application/octet-stream"))))

  (defasync prepare-browser-root (temporary-directory)
    (let ((root (js-call path :join temporary-directory "browser-root"))
          (index 0))
      (while (< index (js-length browser-module-files))
        (let* ((relative (aref browser-module-files index))
               (destination (js-call path :join root relative)))
          (await (mkdir (js-call path :dirname destination) (js-object :recursive t)))
          (await (copyFile (js-call path :join project-directory relative) destination)))
        (setq index (1+ index)))
      root))

  (defun start-static-server (root)
    (let ((server (createServer (async (request response)
                    (try
                      (let* ((url (new globalThis.URL (or (get request :url) "/") (str "http://127.0.0.1:" BROWSER_PORT)))
                             (pathname (get url :pathname))
                             (relative (funcall globalThis.decodeURIComponent (if (= pathname "/") "/index.html" pathname)))
                             (file (js-call path :resolve root (str "." relative))))
                        (if (not (js-call file :startsWith (str (js-call path :resolve root) (get path :sep))))
                          (js-call (js-call response :writeHead 403) :end "forbidden")
                          (let ((metadata (await (stat file))))
                            (if (not (js-call metadata :isFile))
                              (js-call (js-call response :writeHead 404) :end "not found")
                              (progn
                                (js-call response :writeHead 200 (js-object
                                  "content-type" (content-type file)
                                  "content-length" (get metadata :size)
                                  "cache-control" "no-store"))
                                (js-call (createReadStream file) :pipe response))))))
                      (catch ignored
                        (js-call (js-call response :writeHead 404) :end "not found")))))))
      (new globalThis.Promise (lambda (resolve-fn reject-fn)
        (js-call server :once "error" reject-fn)
        (js-call server :listen BROWSER_PORT "127.0.0.1" (lambda () (funcall resolve-fn server)))))))

  (defun close-server (server)
    (new globalThis.Promise (lambda (resolve-fn reject-fn)
      (js-call server :close (lambda (error) (if error (funcall reject-fn error) (funcall resolve-fn undefined))))
      (when (get server :closeAllConnections)
        (js-call server :closeAllConnections)))))

  (defasync assert-port-available (port)
    (let ((server (createServer)))
      (await (new globalThis.Promise (lambda (resolve-fn reject-fn)
        (js-call server :once "error" reject-fn)
        (js-call server :listen port "127.0.0.1" resolve-fn))))
      (await (close-server server))))

  (defun launch-process (command args)
    (let* ((child (spawn command args (js-object
                    :cwd project-directory
                    :env (get process :env)
                    :stdio (js-array "ignore" "pipe" "pipe"))))
           (stdout (js-array))
           (stderr (js-array))
           (closed (new globalThis.Promise (lambda (resolve-fn reject-fn)
                     (js-call child :once "error" reject-fn)
                     (js-call child :once "close" (lambda (code signal)
                       (funcall resolve-fn (js-object
                         :code code
                         :signal signal
                         :stdout (js-call (js-call globalThis.Buffer :concat stdout) :toString "utf8")
                         :stderr (js-call (js-call globalThis.Buffer :concat stderr) :toString "utf8")))))))))
      (js-call (get child :stdout) :on "data" (lambda (chunk) (js-call stdout :push chunk)))
      (js-call (get child :stderr) :on "data" (lambda (chunk) (js-call stderr :push chunk)))
      (js-object :child child :closed closed)))

  (defun delay (ms)
    (new globalThis.Promise (lambda (resolve-fn) (funcall globalThis.setTimeout resolve-fn ms))))

  (defasync wait-for-debugger-target (process-handle page-url timeout-ms)
    (let ((deadline (+ (Date/now) timeout-ms))
          (found undefined))
      (while (and (undefined? found) (< (Date/now) deadline))
        (let ((child (get process-handle :child)))
          (when (or (not (eq (get child :exitCode) nil))
                    (not (eq (get child :signalCode) nil)))
            (let ((result (await (get process-handle :closed))))
              (throw (new globalThis.Error
                (str "Chrome exited before exposing its benchmark page: "
                     (or (get result :stderr) (get result :stdout))))))))
        (try
          (let ((response (await (funcall globalThis.fetch (str "http://127.0.0.1:" BROWSER_DEBUG_PORT "/json/list")))))
            (when (get response :ok)
              (let* ((targets (await (js-call response :json)))
                     (target (js-call targets :find (lambda (candidate)
                               (and (= (get candidate :type) "page")
                                    (js-call (get candidate :url) :startsWith page-url))))))
                (when (and target (not (undefined? (get target :webSocketDebuggerUrl))))
                  (setq found (get target :webSocketDebuggerUrl))))))
          (catch ignored nil))
        (when (undefined? found)
          (await (delay 100))))
      (when (undefined? found)
        (throw (new globalThis.Error (str "Chrome debugger did not become ready within " timeout-ms "ms"))))
      found))

  (defasync connect-debugger (web-socket-url)
    (let ((socket (new globalThis.WebSocket web-socket-url))
          (pending (new globalThis.Map))
          (next-id 1))
      (await (new globalThis.Promise (lambda (resolve-fn reject-fn)
        (js-call socket :addEventListener "open" resolve-fn (js-object :once t))
        (js-call socket :addEventListener "error" reject-fn (js-object :once t)))))
      (js-call socket :addEventListener "message" (lambda (event)
        (let ((message (JSON/parse (funcall globalThis.String (get event :data)))))
          (unless (undefined? (get message :id))
            (let ((request (js-call pending :get (get message :id))))
              (unless (undefined? request)
                (js-call pending :delete (get message :id))
                (if (not (undefined? (get message :error)))
                  (js-call request :reject (new globalThis.Error (get (get message :error) :message)))
                  (js-call request :resolve (get message :result)))))))))
      (js-call socket :addEventListener "close" (lambda ()
        (js-call (Array/from (js-call pending :values)) :forEach (lambda (request)
          (js-call request :reject (new globalThis.Error "Chrome debugger connection closed"))))
        (js-call pending :clear)))
      (js-object
        :call (lambda (method &optional params)
          (let ((id next-id) (actual-params (or params (js-object))))
            (setq next-id (1+ next-id))
            (new globalThis.Promise (lambda (resolve-fn reject-fn)
              (js-call pending :set id (js-object :resolve resolve-fn :reject reject-fn))
              (js-call socket :send (JSON/stringify (js-object :id id :method method :params actual-params)))))))
        :close (lambda () (js-call socket :close)))))

  (defasync wait-for-browser-report (debugger-client timeout-ms)
    (let ((deadline (+ (Date/now) timeout-ms))
          (report undefined))
      (while (and (undefined? report) (< (Date/now) deadline))
        (let* ((evaluation (await (js-call debugger-client :call "Runtime.evaluate" (js-object
                             :expression "document.querySelector('#result')?.textContent ?? ''"
                             :returnByValue t))))
               (res (get evaluation :result))
               (text (or (and res (get res :value)) "")))
          (cond
            ((js-call text :startsWith "ELISCRIPT_LAYOUT_RESULT:")
             (setq report (validateLayoutHostReport (JSON/parse
               (js-call text :slice (js-length "ELISCRIPT_LAYOUT_RESULT:"))))))
            ((js-call text :startsWith "ELISCRIPT_LAYOUT_ERROR:")
             (throw (new globalThis.Error (js-call text :slice (js-length "ELISCRIPT_LAYOUT_ERROR:")))))
            (t (await (delay 100))))))
      (when (undefined? report)
        (throw (new globalThis.Error (str "Chrome benchmark did not finish within " timeout-ms "ms"))))
      report))

  (defasync stop-chrome (process-handle debugger-client)
    (when debugger-client
      (try (await (js-call debugger-client :call "Browser.close")) (catch ignored nil))
      (js-call debugger-client :close))
    (let ((graceful (await (Promise/race (js-array
                      (js-call (get process-handle :closed) :then (lambda () t))
                      (js-call (delay 2000) :then (lambda () false))))))
          (child (get process-handle :child)))
      (when (and (not graceful) (eq (get child :exitCode) nil))
        (js-call child :kill "SIGTERM")
        (let ((terminated (await (Promise/race (js-array
                            (js-call (get process-handle :closed) :then (lambda () t))
                            (js-call (delay 2000) :then (lambda () false)))))))
          (when (and (not terminated) (eq (get child :exitCode) nil))
            (js-call child :kill "SIGKILL")
            (await (get process-handle :closed)))))))

  (defun browser-query (environment)
    (let ((parameters (new globalThis.URLSearchParams (js-object
            :occupancies (get environment :ELISCRIPT_LAYOUT_OCCUPANCIES)
            :iterations (get environment :ELISCRIPT_LAYOUT_ITERATIONS)
            :mutationIterations (get environment :ELISCRIPT_LAYOUT_MUTATION_ITERATIONS)
            :timingSamples (get environment :ELISCRIPT_LAYOUT_TIMING_SAMPLES)
            :memoryNodes (get environment :ELISCRIPT_LAYOUT_MEMORY_NODES)
            :memorySamples (get environment :ELISCRIPT_LAYOUT_MEMORY_SAMPLES)))))
      (js-call parameters :toString)))

  (defun median (values)
    (let* ((sorted (js-call (Array/from values) :sort (lambda (left right) (- left right))))
           (middle (Math/floor (/ (js-length sorted) 2))))
      (if (= (% (js-length sorted) 2) 1)
        (aref sorted middle)
        (/ (+ (aref sorted (1- middle)) (aref sorted middle)) 2))))

  (defun analyzeLayoutSuite (hosts)
    (let* ((occupancies (get (get (aref hosts 0) :parameters) :occupancies))
           (candidates (js-call occupancies :map (lambda (occupancy)
             (let* ((measurements (js-call hosts :map (lambda (host)
                                    (js-call (get host :measurements) :find
                                      (lambda (entry) (= (get entry :occupancy) occupancy))))))
                    (mixed-ratios (js-call measurements :map (lambda (entry)
                                    (get (get entry :ratios) :arrayToBitmapMixed))))
                    (memory-ratios (js-call (js-call measurements :map (lambda (entry)
                                      (get (get entry :ratios) :arrayToBitmapBytes)))
                                     :filter (lambda (value) (not (eq value nil))))))
               (js-object
                 :occupancy occupancy
                 :arrayMixedWins (js-length (js-call mixed-ratios :filter (lambda (value) (<= value 1))))
                 :medianArrayToBitmapMixed (median mixed-ratios)
                 :measuredMemoryHosts (js-length memory-ratios)
                 :medianArrayToBitmapBytes (if (= (js-length memory-ratios) 0) nil (median memory-ratios)))))))
           (promotion-candidate (js-call candidates :find (lambda (candidate)
                                  (and (>= (get candidate :arrayMixedWins) 2)
                                       (>= (get candidate :measuredMemoryHosts) 2)
                                       (<= (get candidate :medianArrayToBitmapBytes) 1.5)))))
           (demotion-candidates (js-call candidates :filter (lambda (candidate)
                                  (and (not (undefined? promotion-candidate))
                                       (< (get candidate :occupancy) (get promotion-candidate :occupancy))
                                       (>= (get candidate :medianArrayToBitmapMixed) 1.15)
                                       (>= (get candidate :measuredMemoryHosts) 2)
                                       (>= (get candidate :medianArrayToBitmapBytes) 1.15)))))
           (demotion-candidate (js-call demotion-candidates :at -1)))
      (js-object
        :policy (js-object
                  :workload (js-object :lookup 0.8 :assoc 0.1 :dissoc 0.1)
                  :minimumArrayWinningHosts 2
                  :minimumPreciseMemoryHosts 2
                  :maximumMedianArrayToBitmapBytes 1.5
                  :minimumBitmapMixedAdvantageAtDemotion 1.15
                  :minimumBitmapMemoryAdvantageAtDemotion 1.15)
        :candidates candidates
        :promotionCandidate (if promotion-candidate (get promotion-candidate :occupancy) nil)
        :demotionCandidate (if demotion-candidate (get demotion-candidate :occupancy) nil))))

  (defasync run-browser-benchmark (environment temporary-directory)
    (let ((browser-root (await (prepare-browser-root temporary-directory)))
          (chrome (await (find-chrome-executable)))
          (user-data-directory (js-call path :join temporary-directory "chrome-profile"))
          (server undefined)
          (process-handle undefined)
          (debugger-client undefined))
      (try
        (progn
          (await (assert-port-available BROWSER_DEBUG_PORT))
          (setq server (await (start-static-server browser-root)))
          (let ((url (str "http://127.0.0.1:" BROWSER_PORT "/tools/collections/browser/index.html?"
                          (browser-query environment))))
            (setq process-handle (launch-process chrome (js-array
              "--headless=new"
              "--disable-gpu"
              "--disable-background-networking"
              "--disable-component-update"
              "--disable-sync"
              "--no-first-run"
              "--no-default-browser-check"
              "--enable-precise-memory-info"
              "--js-flags=--expose-gc"
              (str "--remote-debugging-port=" BROWSER_DEBUG_PORT)
              "--remote-allow-origins=*"
              (str "--user-data-dir=" user-data-directory)
              url)))
            (let ((debugger-url (await (wait-for-debugger-target process-handle url 15000))))
              (setq debugger-client (await (connect-debugger debugger-url)))
              (await (wait-for-browser-report debugger-client 180000)))))
        (finally
          (unless (undefined? process-handle)
            (await (stop-chrome process-handle debugger-client)))
          (unless (undefined? server)
            (await (close-server server)))))))

  (defun validateLayoutSuiteReport (report)
    (when (or (nullish? report)
              (/= (get report :format) LAYOUT_SUITE_FORMAT)
              (/= (get report :version) LAYOUT_SUITE_VERSION))
      (throw (new globalThis.TypeError "invalid HAMT layout benchmark suite format or version")))
    (let ((hosts (get report :hosts)))
      (unless (and (Array/isArray hosts) (= (js-length hosts) 3))
        (throw (new globalThis.TypeError "HAMT layout benchmark requires exactly three host reports")))
      (let ((ids (new globalThis.Set))
            (parameters (JSON/stringify (get (aref hosts 0) :parameters)))
            (index 0))
        (while (< index (js-length hosts))
          (let ((host (aref hosts index)))
            (validateLayoutHostReport host)
            (unless (= (JSON/stringify (get host :parameters)) parameters)
              (throw (new globalThis.TypeError "HAMT layout benchmark host parameters differ")))
            (js-call ids :add (get (get host :host) :id)))
          (setq index (1+ index)))
        (js-call (js-array "bun" "node" "chrome") :forEach (lambda (required)
          (unless (js-call ids :has required)
            (throw (new globalThis.TypeError (str "HAMT layout benchmark is missing " required))))))
        (let ((source-digest (get report :sourceDigest)))
          (when (or (nullish? source-digest)
                    (/= (get source-digest :algorithm) "sha256")
                    (not (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (or (get source-digest :value) ""))))
            (throw (new globalThis.TypeError "HAMT layout benchmark source digest is invalid"))))
        (let ((analysis (analyzeLayoutSuite hosts))
              (thresholds (get report :runtimeThresholds)))
          (unless (= (JSON/stringify (get report :analysis)) (JSON/stringify analysis))
            (throw (new globalThis.TypeError "HAMT layout benchmark analysis does not match raw samples")))
          (when (or (nullish? thresholds)
                    (/= (get thresholds :promotion) (get analysis :promotionCandidate))
                    (/= (get thresholds :demotion) (get analysis :demotionCandidate)))
            (let* ((declared (str (if (or (nullish? thresholds) (nullish? (get thresholds :promotion))) "none" (get thresholds :promotion))
                                  "/"
                                  (if (or (nullish? thresholds) (nullish? (get thresholds :demotion))) "none" (get thresholds :demotion))))
                   (measured (str (if (nullish? (get analysis :promotionCandidate)) "none" (get analysis :promotionCandidate))
                                  "/"
                                  (if (nullish? (get analysis :demotionCandidate)) "none" (get analysis :demotionCandidate))))
                   (error (new globalThis.TypeError
                            (str "HAMT runtime thresholds " declared " do not match measured candidates " measured))))
              (put error :report report)
              (throw error))))
        report)))

  (defasync runLayoutSuiteBenchmark ()
    (let ((environment (benchmark-environment))
          (temporary-directory (await (mkdtemp (js-call path :join (tmpdir) "eliscript-layout-benchmark-")))))
      (try
        (let* ((env (get process :env))
               (bun (or (get env :BUN) (if (= (value-type globalThis.Bun) "object") (get process :execPath) "bun")))
               (node (or (get env :NODE) "node"))
               (bun-result (await (run-command bun (js-array host-runner) (js-object :env environment))))
               (node-result (await (run-command node (js-array "--expose-gc" host-runner) (js-object :env environment))))
               (hosts (js-array
                        (validateLayoutHostReport (JSON/parse (get bun-result :stdout)))
                        (validateLayoutHostReport (JSON/parse (get node-result :stdout)))
                        (await (run-browser-benchmark environment temporary-directory)))))
          (validateLayoutSuiteReport (js-object
            :format LAYOUT_SUITE_FORMAT
            :version LAYOUT_SUITE_VERSION
            :generatedAt (js-call (new globalThis.Date) :toISOString)
            :sourceDigest (await (benchmarkSourceDigest))
            :runtimeThresholds (js-object :promotion 32 :demotion 24)
            :hosts hosts
            :analysis (analyzeLayoutSuite hosts))))
        (finally
          (await (rm temporary-directory (js-object :recursive t :force t)))))))

  (defasync main ()
    (let* ((parsed (parse-arguments (js-call (get process :argv) :slice 2)))
           (output (get parsed :output))
           (report (await (runLayoutSuiteBenchmark)))
           (json (str (JSON/stringify report nil 2) "\n")))
      (if (undefined? output)
        (js-call (get process :stdout) :write json)
        (let ((resolved (js-call path :resolve project-directory output)))
          (await (writeFile resolved json "utf8"))
          (js-call (get process :stdout) :write (str (get (pathToFileURL resolved) :href) "\n"))))))

  (when (= (js-call path :resolve (or (aref (get process :argv) 1) ""))
           (fileURLToPath (get (js* "import.meta") :url)))
    (js-call (main) :catch (lambda (error)
      (js-call globalThis.console :error error)
      (put process :exitCode 1))))

  (export LAYOUT_SUITE_FORMAT LAYOUT_SUITE_VERSION BROWSER_PORT BROWSER_DEBUG_PORT
          benchmarkSourceDigest analyzeLayoutSuite validateLayoutSuiteReport runLayoutSuiteBenchmark))
