(module tools.collections.persistent-semantics
  (import "node:crypto" createHash)
  (import "node:url" fileURLToPath)
  (import "node:path" resolve)
  (import "../../runtime/core/list.mjs" EMPTY_LIST)
  (import "../../runtime/core/map.mjs" EMPTY_MAP)
  (import "../../runtime/core/set.mjs" EMPTY_SET)
  (import "../../runtime/core/vector.mjs" EMPTY_VECTOR)

  (defconst DEFAULT_SEED 1346646065)
  (defconst DEFAULT_SEQUENCES 100000)
  (defconst UPDATES_PER_SEQUENCE 8)
  (defconst FAMILY_ORDER (js-array "list" "vector" "map" "set"))
  (defconst FAMILY_SEEDS (Object/freeze (js-object
    :list 1279873876
    :vector 1447379796
    :map 1296125952
    :set 1397052416)))
  (defconst COLLISION_LEFT "key-50691")
  (defconst COLLISION_RIGHT "key-194634")
  (defconst PROBE_KEYS (Object/freeze (js-array
    nil
    undefined
    globalThis.NaN
    0
    COLLISION_LEFT
    COLLISION_RIGHT
    "key-0"
    "key-8"
    -8
    8)))

  (defun parse-positive-integer (raw option)
    (let ((value (funcall globalThis.Number raw)))
      (when (or (not (Number/isSafeInteger value)) (<= value 0))
        (throw (new globalThis.Error (str option " requires a positive safe integer"))))
      value))

  (defun parse-non-negative-integer (raw option)
    (let ((value (funcall globalThis.Number raw)))
      (when (or (not (Number/isSafeInteger value)) (< value 0))
        (throw (new globalThis.Error (str option " requires a non-negative safe integer"))))
      value))

  (defun parse-seed (raw)
    (unless (js-call (new globalThis.RegExp "^(?:0x[0-9a-f]+|[0-9]+)$" "iu") :test raw)
      (throw (new globalThis.Error "--seed requires an unsigned 32-bit integer")))
    (let ((value (funcall globalThis.Number raw)))
      (when (or (not (Number/isSafeInteger value)) (< value 0) (> value 4294967295))
        (throw (new globalThis.Error "--seed requires an unsigned 32-bit integer")))
      (unsigned-bit-shift-right value 0)))

  (defun parse-arguments (argv)
    (let ((options (js-object
                     :seed DEFAULT_SEED
                     :sequences DEFAULT_SEQUENCES
                     :family nil
                     :sequence nil))
          (index 0))
      (while (< index (js-length argv))
        (let ((option (aref argv index))
              (raw (aref argv (1+ index))))
          (cond
            ((= option "--seed")
             (when (undefined? raw) (throw (new globalThis.Error "--seed requires a value")))
             (put options :seed (parse-seed raw))
             (setq index (1+ index)))
            ((= option "--sequences")
             (when (undefined? raw) (throw (new globalThis.Error "--sequences requires a value")))
             (put options :sequences (parse-positive-integer raw "--sequences"))
             (setq index (1+ index)))
            ((= option "--family")
             (unless (js-call FAMILY_ORDER :includes raw)
               (throw (new globalThis.Error (str "--family requires one of " (js-call FAMILY_ORDER :join ", ")))))
             (put options :family raw)
             (setq index (1+ index)))
            ((= option "--sequence")
             (when (undefined? raw) (throw (new globalThis.Error "--sequence requires a value")))
             (put options :sequence (parse-non-negative-integer raw "--sequence"))
             (setq index (1+ index)))
            (t (throw (new globalThis.Error (str "unknown option " option))))))
        (setq index (1+ index)))
      (when (and (not (eq (get options :sequence) nil)) (eq (get options :family) nil))
        (throw (new globalThis.Error "--sequence requires --family")))
      (when (and (not (eq (get options :sequence) nil)) (>= (get options :sequence) (get options :sequences)))
        (throw (new globalThis.Error "--sequence must be smaller than --sequences")))
      options))

  (defun mix32 (value)
    (let ((mixed (unsigned-bit-shift-right value 0)))
      (setq mixed (bit-xor mixed (unsigned-bit-shift-right mixed 16)))
      (setq mixed (imul32 mixed 2146121005))
      (setq mixed (bit-xor mixed (unsigned-bit-shift-right mixed 15)))
      (setq mixed (imul32 mixed -2073254261))
      (setq mixed (bit-xor mixed (unsigned-bit-shift-right mixed 16)))
      (unsigned-bit-shift-right mixed 0)))

  (defun sequence-random (seed family sequence)
    (let ((mixed (mix32 (bit-xor (bit-xor seed (get FAMILY_SEEDS family))
                                 (imul32 (1+ sequence) -1640531535)))))
      (js-object :value (if (= mixed 0) 1 mixed))))

  (defun next-random (random)
    (let ((value (get random :value)))
      (setq value (bit-xor value (bit-shift-left value 13)))
      (setq value (bit-xor value (unsigned-bit-shift-right value 17)))
      (setq value (bit-xor value (bit-shift-left value 5)))
      (let ((u32 (unsigned-bit-shift-right value 0)))
        (put random :value u32)
        u32)))

  (defun generated-value (random)
    (let* ((bits (next-random random))
           (kind (bit-and bits 7)))
      (cond
        ((= kind 0) nil)
        ((= kind 1) undefined)
        ((= kind 2) globalThis.NaN)
        ((= kind 3) -0.0)
        ((= kind 4) (str "value-" (% bits 17)))
        (t (- (% bits 257) 128)))))

  (defun generated-key (random)
    (let* ((bits (next-random random))
           (kind (% bits 10)))
      (cond
        ((= kind 0) nil)
        ((= kind 1) undefined)
        ((= kind 2) globalThis.NaN)
        ((= kind 3) -0.0)
        ((= kind 4) COLLISION_LEFT)
        ((= kind 5) COLLISION_RIGHT)
        ((or (= kind 6) (= kind 7)) (str "key-" (% bits 17)))
        (t (- (% bits 17) 8)))))

  (defun value-token (value &optional key)
    (cond
      ((eq value nil) "null")
      ((undefined? value) "undefined")
      ((= (value-type value) "number")
       (cond
         ((Number/isNaN value) "number:nan")
         ((and key (Object/is value -0.0)) "number:0")
         ((Object/is value -0.0) "number:-0")
         (t (str "number:" value))))
      (t (str (value-type value) ":" (JSON/stringify value)))))

  (defun same-value (left right)
    (or (= left right)
        (and (= (value-type left) "number")
             (= (value-type right) "number")
             (Number/isNaN left)
             (Number/isNaN right))))

  (defun fail-check (context message)
    (let ((trace (if (undefined? (get context :trace))
                   ""
                   (str "\ntrace: " (JSON/stringify (get context :trace))))))
      (throw (new globalThis.Error
        (str (get context :family) " sequence " (get context :sequence) " step " (get context :step)
             " (" (get context :operation) "): " message trace)))))

  (defun invariant (condition context message)
    (unless condition (fail-check context message)))

  (defun equal-value-arrays (actual expected context label)
    (invariant (= (js-length actual) (js-length expected)) context (str label " length differs"))
    (let ((index 0))
      (while (< index (js-length actual))
        (invariant (same-value (aref actual index) (aref expected index)) context (str label "[" index "] differs"))
        (setq index (1+ index)))))

  (defun canonical-array (values)
    (str "[" (js-call (js-call values :map (lambda (value) (value-token value))) :join ",") "]"))

  (defun canonical-map-entries (entries)
    (js-call (js-call (js-call (Array/from entries)
                        :map (lambda (pair) (str (value-token (aref pair 0) t) "=" (value-token (aref pair 1)))))
               :sort) :join "|"))

  (defun canonical-set-values (values)
    (js-call (js-call (js-call (Array/from values)
                        :map (lambda (value) (value-token value t)))
               :sort) :join "|"))

  (defun record-operation (report operation)
    (let ((ops (get report :operations)))
      (put ops operation (1+ (or (get ops operation) 0)))))

  (defun retain-version (history value snapshot)
    (js-call history :push (js-object :value value :snapshot snapshot)))

  (defun check-history (history snapshot-fn report context)
    (let ((index 0))
      (while (< index (js-length history))
        (let ((version (aref history index)))
          (invariant (= (funcall snapshot-fn (get version :value)) (get version :snapshot))
            context "a previous version changed")
          (put report :previousVersionsChecked (1+ (get report :previousVersionsChecked))))
        (setq index (1+ index)))))

  (defun reduce-value-tokens (values)
    (js-call (js-call values :map (lambda (value) (value-token value))) :join "|"))

  (defun validate-list (list model report context)
    (record-operation report "count")
    (invariant (= (get list :count) (js-length model)) context "count differs")
    (record-operation report "size")
    (invariant (= (get list :size) (js-length model)) context "size differs")
    (record-operation report "isEmpty")
    (invariant (= (get list :isEmpty) (= (js-length model) 0)) context "isEmpty differs")
    (record-operation report "toArray")
    (equal-value-arrays (js-call list :toArray) model context "toArray")
    (record-operation report "iterator")
    (equal-value-arrays (Array/from list) model context "iterator")
    (let ((missing (funcall globalThis.Symbol "missing")))
      (record-operation report "first")
      (invariant (same-value (js-call list :first missing) (if (= (js-length model) 0) missing (aref model 0)))
        context "first differs")
      (record-operation report "peek")
      (invariant (same-value (js-call list :peek missing) (if (= (js-length model) 0) missing (aref model 0)))
        context "peek differs")
      (let ((index 0))
        (while (< index (js-length model))
          (record-operation report "nth")
          (invariant (same-value (js-call list :nth index) (aref model index)) context (str "nth(" index ") differs"))
          (setq index (1+ index))))
      (record-operation report "nth-not-found")
      (invariant (= (js-call list :nth (js-length model) missing) missing) context "nth fallback differs")
      (record-operation report "reduce")
      (let ((reduced (js-call list :reduce (lambda (tokens value) (str tokens "|" (value-token value))) "")))
        (invariant (= reduced (if (= (js-length model) 0) "" (str "|" (reduce-value-tokens model))))
          context "reduce differs"))))

  (defun run-list-sequence (sequence seed report digest)
    (let ((random (sequence-random seed "list" sequence))
          (value EMPTY_LIST)
          (model (js-array))
          (history (js-array))
          (step 0))
      (while (< step UPDATES_PER_SEQUENCE)
        (let ((choice (% (next-random random) 4))
              (context (js-object :family "list" :sequence sequence :step step :operation "")))
          (retain-version history value (canonical-array (js-call value :toArray)))
          (cond
            ((= choice 0)
             (put context :operation "conj")
             (record-operation report "conj")
             (let ((item (generated-value random)))
               (setq value (js-call value :conj item))
               (setq model (js-call (js-array item) :concat model))))
            ((= choice 1)
             (put context :operation "cons")
             (record-operation report "cons")
             (let ((item (generated-value random)))
               (setq value (js-call value :cons item))
               (setq model (js-call (js-array item) :concat model))))
            ((= choice 2)
             (put context :operation "rest")
             (record-operation report "rest")
             (setq value (js-call value :rest))
             (setq model (js-call model :slice 1)))
            (t
             (put context :operation "pop")
             (record-operation report "pop")
             (if (= (js-length model) 0)
               (let ((rejected false))
                 (try (js-call value :pop)
                   (catch error (setq rejected (eq (get error :constructor) globalThis.RangeError))))
                 (invariant rejected context "empty pop did not reject with RangeError")
                 (put report :rejectedUpdates (1+ (get report :rejectedUpdates))))
               (progn
                 (setq value (js-call value :pop))
                 (setq model (js-call model :slice 1))))))
          (put report :updates (1+ (get report :updates)))
          (check-history history (lambda (version) (canonical-array (js-call version :toArray))) report context)
          (validate-list value model report context)
          (js-call digest :update (str sequence ":" step ":" (get context :operation) ":" (canonical-array model) "\n")))
        (setq step (1+ step)))))

  (defun validate-vector (vector model report context)
    (record-operation report "count")
    (invariant (= (get vector :count) (js-length model)) context "count differs")
    (record-operation report "size")
    (invariant (= (get vector :size) (js-length model)) context "size differs")
    (record-operation report "toArray")
    (equal-value-arrays (js-call vector :toArray) model context "toArray")
    (record-operation report "iterator")
    (equal-value-arrays (Array/from vector) model context "iterator")
    (let ((missing (funcall globalThis.Symbol "missing")))
      (record-operation report "peek")
      (invariant (same-value (js-call vector :peek missing) (if (= (js-length model) 0) missing (js-call model :at -1)))
        context "peek differs")
      (let ((index 0))
        (while (< index (js-length model))
          (record-operation report "nth")
          (invariant (same-value (js-call vector :nth index) (aref model index)) context (str "nth(" index ") differs"))
          (setq index (1+ index))))
      (record-operation report "nth-not-found")
      (invariant (= (js-call vector :nth (js-length model) missing) missing) context "nth fallback differs")
      (record-operation report "reduce")
      (let ((reduced (js-call vector :reduce (lambda (tokens item) (str tokens "|" (value-token item))) "")))
        (invariant (= reduced (if (= (js-length model) 0) "" (str "|" (reduce-value-tokens model))))
          context "reduce differs"))))

  (defun run-vector-sequence (sequence seed report digest)
    (let ((random (sequence-random seed "vector" sequence))
          (value EMPTY_VECTOR)
          (model (js-array))
          (history (js-array))
          (step 0))
      (while (< step UPDATES_PER_SEQUENCE)
        (let ((choice (% (next-random random) 4))
              (context (js-object :family "vector" :sequence sequence :step step :operation "")))
          (retain-version history value (canonical-array (js-call value :toArray)))
          (cond
            ((= choice 0)
             (put context :operation "conj")
             (record-operation report "conj")
             (let ((item (generated-value random)))
               (setq value (js-call value :conj item))
               (setq model (js-call model :concat (js-array item)))))
            ((= choice 1)
             (put context :operation "assoc")
             (record-operation report "assoc")
             (let ((index (if (= (js-length model) 0) 0 (% (next-random random) (js-length model))))
                   (item (generated-value random)))
               (setq value (js-call value :assoc index item))
               (setq model (js-call model :slice))
               (put model index item)))
            ((= choice 2)
             (put context :operation "assoc-append")
             (record-operation report "assoc-append")
             (let ((item (generated-value random)))
               (setq value (js-call value :assoc (get value :count) item))
               (setq model (js-call model :concat (js-array item)))))
            (t
             (put context :operation "pop")
             (record-operation report "pop")
             (if (= (js-length model) 0)
               (let ((rejected false))
                 (try (js-call value :pop)
                   (catch error (setq rejected (eq (get error :constructor) globalThis.RangeError))))
                 (invariant rejected context "empty pop did not reject with RangeError")
                 (put report :rejectedUpdates (1+ (get report :rejectedUpdates))))
               (progn
                 (setq value (js-call value :pop))
                 (setq model (js-call model :slice 0 -1))))))
          (put report :updates (1+ (get report :updates)))
          (check-history history (lambda (version) (canonical-array (js-call version :toArray))) report context)
          (validate-vector value model report context)
          (js-call digest :update (str sequence ":" step ":" (get context :operation) ":" (canonical-array model) "\n")))
        (setq step (1+ step)))))

  (defun map-snapshot (map)
    (canonical-map-entries (js-call map :entries)))

  (defun validate-map (map model report context last-key)
    (record-operation report "count")
    (invariant (= (get map :count) (get model :size)) context "count differs")
    (record-operation report "size")
    (invariant (= (get map :size) (get model :size)) context "size differs")
    (let ((probes (js-call (Array/from PROBE_KEYS) :concat (Array/from (js-call model :keys)) (js-array last-key)))
          (index 0))
      (while (< index (js-length probes))
        (let ((key (aref probes index)))
          (record-operation report "has")
          (invariant (= (js-call map :has key) (js-call model :has key))
            context (str "has(" (value-token key t) ") differs"))
          (let ((missing (funcall globalThis.Symbol "missing")))
            (record-operation report "get")
            (let ((actual (js-call map :get key missing))
                  (expected (if (js-call model :has key) (js-call model :get key) missing)))
              (invariant (if (= actual missing) (= expected missing) (same-value actual expected))
                context (str "get(" (value-token key t) ") differs")))))
        (setq index (1+ index))))
    (record-operation report "entries")
    (invariant (= (map-snapshot map) (canonical-map-entries (js-call model :entries))) context "entries differ")
    (record-operation report "iterator")
    (invariant (= (canonical-map-entries map) (canonical-map-entries model)) context "iterator differs")
    (record-operation report "keys")
    (invariant (= (canonical-set-values (js-call map :keys)) (canonical-set-values (js-call model :keys))) context "keys differ")
    (record-operation report "values")
    (invariant (= (js-call (js-call (js-call (Array/from (js-call map :values)) :map (lambda (item) (value-token item))) :sort) :join "|")
                  (js-call (js-call (js-call (Array/from (js-call model :values)) :map (lambda (item) (value-token item))) :sort) :join "|"))
      context "values differ")
    (record-operation report "toMap")
    (invariant (= (canonical-map-entries (js-call map :toMap)) (canonical-map-entries model)) context "toMap differs")
    (record-operation report "reduce")
    (let ((reduced (js-call map :reduce (lambda (items item key)
                     (js-call items :push (str (value-token key t) "=" (value-token item)))
                     items) (js-array))))
      (invariant (= (js-call (js-call reduced :sort) :join "|") (canonical-map-entries model)) context "reduce differs")))

  (defun run-map-sequence (sequence seed report digest)
    (let ((random (sequence-random seed "map" sequence))
          (value EMPTY_MAP)
          (model (new globalThis.Map))
          (history (js-array))
          (trace (js-array))
          (step 0))
      (while (< step UPDATES_PER_SEQUENCE)
        (let ((key (generated-key random))
              (choice (% (next-random random) 3))
              (context (js-object :family "map" :sequence sequence :step step :operation "" :trace trace)))
          (retain-version history value (map-snapshot value))
          (if (< choice 2)
            (let ((item (generated-value random)))
              (put context :operation "assoc")
              (record-operation report "assoc")
              (js-call trace :push (js-array "assoc" (value-token key t) (value-token item)))
              (setq value (js-call value :assoc key item))
              (when (or (not (js-call model :has key)) (not (same-value (js-call model :get key) item)))
                (js-call model :set key item)))
            (progn
              (put context :operation "dissoc")
              (record-operation report "dissoc")
              (js-call trace :push (js-array "dissoc" (value-token key t)))
              (setq value (js-call value :dissoc key))
              (js-call model :delete key)))
          (put report :updates (1+ (get report :updates)))
          (check-history history map-snapshot report context)
          (validate-map value model report context key)
          (js-call digest :update (str sequence ":" step ":" (get context :operation) ":" (canonical-map-entries model) "\n")))
        (setq step (1+ step)))))

  (defun set-snapshot (set)
    (canonical-set-values (js-call set :values)))

  (defun generated-key-group (random)
    (js-array (generated-key random) (generated-key random) (generated-key random) (generated-key random)))

  (defun validate-set (set model report context last-values)
    (record-operation report "count")
    (invariant (= (get set :count) (get model :size)) context "count differs")
    (record-operation report "size")
    (invariant (= (get set :size) (get model :size)) context "size differs")
    (let ((probes (js-call (Array/from PROBE_KEYS) :concat (Array/from model) last-values))
          (index 0))
      (while (< index (js-length probes))
        (let ((item (aref probes index)))
          (record-operation report "has")
          (invariant (= (js-call set :has item) (js-call model :has item))
            context (str "has(" (value-token item t) ") differs")))
        (setq index (1+ index))))
    (record-operation report "values")
    (invariant (= (set-snapshot set) (canonical-set-values model)) context "values differ")
    (record-operation report "keys")
    (invariant (= (canonical-set-values (js-call set :keys)) (canonical-set-values model)) context "keys differ")
    (record-operation report "iterator")
    (invariant (= (canonical-set-values set) (canonical-set-values model)) context "iterator differs")
    (record-operation report "entries")
    (js-call (Array/from (js-call set :entries)) :forEach (lambda (pair)
      (invariant (same-value (aref pair 0) (aref pair 1)) context "entry member pair differs")
      (invariant (js-call model :has (aref pair 0)) context "entry member is absent from model")))
    (record-operation report "toSet")
    (invariant (= (canonical-set-values (js-call set :toSet)) (canonical-set-values model)) context "toSet differs")
    (record-operation report "reduce")
    (let ((reduced (js-call set :reduce (lambda (items item)
                     (js-call items :push (value-token item t))
                     items) (js-array))))
      (invariant (= (js-call (js-call reduced :sort) :join "|") (canonical-set-values model)) context "reduce differs"))
    (let ((comparison (new globalThis.Set last-values)))
      (record-operation report "isSubsetOf")
      (invariant (= (js-call set :isSubsetOf last-values)
                    (js-call (Array/from model) :every (lambda (item) (js-call comparison :has item))))
        context "isSubsetOf differs")
      (record-operation report "isSupersetOf")
      (invariant (= (js-call set :isSupersetOf last-values)
                    (js-call (Array/from comparison) :every (lambda (item) (js-call model :has item))))
        context "isSupersetOf differs")
      (record-operation report "isDisjointFrom")
      (invariant (= (js-call set :isDisjointFrom last-values)
                    (js-call (Array/from comparison) :every (lambda (item) (not (js-call model :has item)))))
        context "isDisjointFrom differs")))

  (defun run-set-sequence (sequence seed report digest)
    (let ((random (sequence-random seed "set" sequence))
          (value EMPTY_SET)
          (model (new globalThis.Set))
          (history (js-array))
          (step 0))
      (while (< step UPDATES_PER_SEQUENCE)
        (let ((choice (% (next-random random) 5))
              (items (generated-key-group random))
              (context (js-object :family "set" :sequence sequence :step step :operation "")))
          (retain-version history value (set-snapshot value))
          (cond
            ((= choice 0)
             (put context :operation "conj")
             (record-operation report "conj")
             (setq value (js-call value :conj (aref items 0)))
             (js-call model :add (aref items 0)))
            ((= choice 1)
             (put context :operation "disj")
             (record-operation report "disj")
             (setq value (js-call value :disj (aref items 0)))
             (js-call model :delete (aref items 0)))
            ((= choice 2)
             (put context :operation "union")
             (record-operation report "union")
             (setq value (js-call value :union items))
             (setq model (new globalThis.Set (js-call (Array/from model) :concat items))))
            ((= choice 3)
             (put context :operation "intersection")
             (record-operation report "intersection")
             (let ((other (new globalThis.Set items)))
               (setq value (js-call value :intersection items))
               (setq model (new globalThis.Set (js-call (Array/from model) :filter (lambda (item) (js-call other :has item)))))))
            (t
             (put context :operation "difference")
             (record-operation report "difference")
             (let ((other (new globalThis.Set items)))
               (setq value (js-call value :difference items))
               (setq model (new globalThis.Set (js-call (Array/from model) :filter (lambda (item) (not (js-call other :has item)))))))))
          (put report :updates (1+ (get report :updates)))
          (check-history history set-snapshot report context)
          (validate-set value model report context items)
          (js-call digest :update (str sequence ":" step ":" (get context :operation) ":" (canonical-set-values model) "\n")))
        (setq step (1+ step)))))

  (defconst FAMILY_RUNNERS (Object/freeze (js-object
    :list run-list-sequence
    :vector run-vector-sequence
    :map run-map-sequence
    :set run-set-sequence)))

  (defun empty-family-report ()
    (js-object
      :sequences 0
      :updates 0
      :rejectedUpdates 0
      :previousVersionsChecked 0
      :operations (js-object)
      :digest ""))

  (defun runPersistentSemanticsCorpus (&optional supplied-options)
    (let* ((options (or supplied-options (js-object)))
           (seed (if (nullish? (get options :seed)) DEFAULT_SEED (get options :seed)))
           (sequences (if (nullish? (get options :sequences)) DEFAULT_SEQUENCES (get options :sequences)))
           (selected-families (if (nullish? (get options :family))
                                FAMILY_ORDER
                                (js-array (get options :family))))
           (selected-sequence (if (nullish? (get options :sequence)) nil (get options :sequence)))
           (family-reports (js-object))
           (overall (createHash "sha256"))
           (f-idx 0))
      (while (< f-idx (js-length selected-families))
        (let* ((family (aref selected-families f-idx))
               (report (empty-family-report))
               (digest (createHash "sha256"))
               (start (if (eq selected-sequence nil) 0 selected-sequence))
               (end (if (eq selected-sequence nil) sequences (1+ selected-sequence)))
               (runner (get FAMILY_RUNNERS family))
               (sequence start))
          (while (< sequence end)
            (funcall runner sequence seed report digest)
            (put report :sequences (1+ (get report :sequences)))
            (setq sequence (1+ sequence)))
          (put report :digest (js-call digest :digest "hex"))
          (put family-reports family report)
          (js-call overall :update
            (str family ":" (get report :sequences) ":" (get report :updates) ":" (get report :digest) "\n")))
        (setq f-idx (1+ f-idx)))
      (let ((acceptance-eligible (and (= seed DEFAULT_SEED)
                                      (= sequences DEFAULT_SEQUENCES)
                                      (= (js-length selected-families) (js-length FAMILY_ORDER))
                                      (eq selected-sequence nil)))
            (values (Object/values family-reports)))
        (js-object
          :schemaVersion 1
          :format "eliscript-persistent-semantics-corpus"
          :version 1
          :verified t
          :acceptanceEligible acceptance-eligible
          :seed (str "0x" (js-call (js-call seed :toString 16) :padStart 8 "0"))
          :sequencesPerFamily sequences
          :updatesPerSequence UPDATES_PER_SEQUENCE
          :totalSequences (js-call values :reduce (lambda (total rep) (+ total (get rep :sequences))) 0)
          :totalUpdates (js-call values :reduce (lambda (total rep) (+ total (get rep :updates))) 0)
          :families family-reports
          :digest (js-call overall :digest "hex")))))

  (let* ((arg1 (aref (get globalThis.process :argv) 1))
         (invoked-path (if (undefined? arg1) nil (resolve arg1))))
    (when (= invoked-path (fileURLToPath (get (js* "import.meta") :url)))
      (let ((options (parse-arguments (js-call (get globalThis.process :argv) :slice 2))))
        (js-call (get globalThis.process :stdout) :write
          (str (JSON/stringify (runPersistentSemanticsCorpus options) nil 2) "\n")))))

  (export runPersistentSemanticsCorpus))
