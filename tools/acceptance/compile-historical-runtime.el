;;; compile-historical-runtime.el --- Reproduce a pinned runtime asset -*- lexical-binding: t; -*-
(declare-function eliscript-compile-file-with-source-map "eliscript" (input output &optional options))
(declare-function eliscript-generate-unicode-case-runtime-data "unicode-case-runtime" (root))
(let* ((args command-line-args-left)
       (root (file-name-as-directory (expand-file-name (nth 0 args))))
       (mode (nth 1 args))
       (default-directory root))
  ;; --script is processed before -L actions by Emacs. Load the compiler from
  ;; the authenticated snapshot explicitly, never the current checkout.
  (add-to-list 'load-path (expand-file-name "compiler" root))
  (require 'eliscript)
  (cond
   ((and (= (length args) 2) (string= mode "--stage-runtime-capsules"))
    (let ((generator (expand-file-name "tools/runtime/unicode-case-runtime.el" root)))
      (unless (file-regular-p generator)
        (error "Historical Unicode case runtime generator is missing"))
      (load generator nil t)
      (eliscript-generate-unicode-case-runtime-data root))
    (dolist (name '("number-radix" "array-text" "primitives" "errors"
                    "prelude" "unicode-case-data" "unicode-case" "math"))
      (let ((source (concat "runtime/" name ".eli"))
            (target (expand-file-name (concat "runtime/" name ".mjs") root)))
        (make-directory (file-name-directory target) t)
        (eliscript-compile-file-with-source-map source target)))
    (let ((compiler-dir (expand-file-name "bootstrap/compiler" root))
          (stage1-dir (expand-file-name "stage1" root)))
      (make-directory stage1-dir t)
      (dolist (file (sort (directory-files compiler-dir nil "\\.eli\\'") #'string<))
        (eliscript-compile-file-with-source-map
         (concat "bootstrap/compiler/" file)
         (expand-file-name (concat (file-name-sans-extension file) ".mjs") stage1-dir)))
      (with-temp-file (expand-file-name "emit-stage-capsules.eli" root)
        (insert
         "(module historical.stage-capsules\n"
         "  (import \"node:fs\" mkdirSync readFileSync writeFileSync)\n"
         "  (import \"./stage1/compiler.mjs\" compile_string)\n"
         "  (mkdirSync \"./stage2-runtime\" (js-object :recursive t))\n"
         "  (let ((names (js-array \"array-text\" \"errors\" \"math\" \"number-radix\" \"prelude\" \"primitives\" \"unicode-case\" \"unicode-case-data\")) (i 0))\n"
         "    (while (< i (js-length names))\n"
         "      (let* ((name (aref names i)) (source (readFileSync (str \"./runtime/\" name \".eli\") \"utf8\")))\n"
         "        (writeFileSync (str \"./stage2-runtime/\" name \".mjs\") (compile_string source (str \"runtime/\" name \".eli\"))))\n"
         "      (setq i (1+ i)))))\n"))
      (eliscript-compile-file-with-source-map
       "emit-stage-capsules.eli"
       (expand-file-name "emit-stage-capsules.mjs" root))))
   ((and (= (length args) 2) (string= mode "--worker-modules"))
    ;; The measured worker-lifecycle report binds these two published entries
    ;; while their generated bytes are not Git blobs at that revision. Compile
    ;; both maintained modules with the historical seed compiler, then apply the
    ;; historical bootstrap's Bun shebang exactly, including its source-map
    ;; shift, so the reproduced bytes are the published bytes.
    (dolist (name '("platform" "runtime"))
      (let ((target (expand-file-name (concat name "/worker.mjs") root)))
        (make-directory (file-name-directory target) t)
        (eliscript-compile-file-with-source-map
         (concat name "/worker.eli") target)))
    (let ((entry (expand-file-name "runtime/worker.mjs" root))
          (coding-system-for-read 'utf-8-unix)
          (coding-system-for-write 'utf-8-unix))
      (with-temp-buffer
        (insert-file-contents entry)
        (goto-char (point-min))
        (unless (looking-at-p "\\`#!")
          (insert "#!/usr/bin/env bun\n")
          (write-region (point-min) (point-max) entry nil 'silent)
          (let ((map-path (concat entry ".map")))
            (when (file-exists-p map-path)
              (let ((map (json-parse-string
                          (with-temp-buffer
                            (insert-file-contents map-path)
                            (buffer-string)))))
                (puthash "mappings" (concat ";" (gethash "mappings" map)) map)
                (with-temp-file map-path (insert (json-serialize map))))))))))
   ((and (= (length args) 2) (string= mode "--transient-modules"))
    (dolist (pair '(("stdlib/core/object.eli" . "runtime/core/object-impl.mjs")
                    ("stdlib/core/protocol.eli" . "runtime/core/protocol-impl.mjs")
                    ("stdlib/core/text.eli" . "runtime/core/text-impl.mjs")
                    ("runtime/binding.eli" . "runtime/binding.mjs")
                    ("runtime/testing/map.eli" . "runtime/testing/map.mjs")
                    ("runtime/testing/set.eli" . "runtime/testing/set.mjs")
                    ("runtime/testing/vector.eli" . "runtime/testing/vector.mjs")
                    ("tools/collections/transient-builder-benchmark.eli" . "tools/collections/transient-builder-benchmark.mjs")
                    ("tools/compiler/controlled-baseline.eli" . "tools/compiler/controlled-baseline.mjs")))
      (when (file-regular-p (expand-file-name (car pair) root))
        (let ((target (expand-file-name (cdr pair) root)))
          (make-directory (file-name-directory target) t)
          (eliscript-compile-file-with-source-map (car pair) target))))
    (let ((core-dir (expand-file-name "runtime/core" root)))
      (when (file-directory-p core-dir)
        (dolist (file (sort (directory-files core-dir nil "\\.eli\\'") #'string<))
          (eliscript-compile-file-with-source-map
           (concat "runtime/core/" file)
           (expand-file-name (concat "runtime/core/" (file-name-sans-extension file) ".mjs") root))))))
   ((and (= (length args) 3)
         (member mode '("stdlib/core/object.eli" "stdlib/core/protocol.eli" "stdlib/core/text.eli"))
         (file-in-directory-p (expand-file-name (nth 2 args)) root))
    (let ((output (expand-file-name (nth 2 args))))
      (make-directory (file-name-directory output) t)
      (eliscript-compile-file-with-source-map mode output)))
   (t
    (error "Invalid historical runtime compilation arguments")))
  ;; A script loaded through --script would otherwise let Emacs continue and
  ;; reject the mode token as an unknown command-line option after all work
  ;; has already succeeded. Exit explicitly on the completed compilation.
  (kill-emacs 0))
