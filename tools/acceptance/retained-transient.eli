(module tools.acceptance.retained-transient
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile readdir)
  (import "node:path" :as path)
  (import "../collections/transient-builder-benchmark.mjs" validateTransientBuilderReport)
  (import "./retained-performance-snapshot.mjs" retainedPerformanceSnapshot deferredPerformanceAcceptance retainedGitSnapshotBytes retainedRuntimeSourceFiles)
  (defconst FILE "benchmarks/transient-builder-macos-arm64.json")
  (defconst PARAMETERS (js-object :vectorSize 200000 :mapSize 100000 :setSize 100000 :warmupRounds 2 :timingSamples 11))
  (defconst POLICY (js-object :minimumSpeedup 1.5 :maximumAllocationRatio (/ 1 3) :passed t))
  (defconst support-files (js-array "runtime/testing/map.mjs" "runtime/testing/set.mjs" "runtime/testing/vector.mjs" "tools/collections/transient-builder-benchmark.mjs"))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun same (a b) (= (JSON/stringify a) (JSON/stringify b)))
  (defun ensure (condition message) (unless condition (throw (new globalThis.Error (str "retained transient refresh: " message)))))
  (defun relative (file) (and (= (value-type file) "string") (> (js-length file) 0) (not (js-call path :isAbsolute file))
    (not (js-call (js-call file :split "/") :includes "..")) (= (js-call (get path :posix) :normalize file) file)))
  (defun git (root arguments) (try (retainedGitSnapshotBytes root arguments) (catch error (ensure false "accepted Git snapshot is unavailable"))))
  (defun decode (bytes) (js-call (new globalThis.TextDecoder) :decode bytes))
  (defun median (values) (aref (js-call (js-call values :slice) :sort (lambda (a b) (- a b))) (Math/floor (/ (js-length values) 2))))
  (defasync source-digest (root files &optional revision)
    (ensure (and (Array/isArray files) (> (js-length files) 0) (= (get (new globalThis.Set files) :size) (js-length files))) "source inventory is incomplete")
    (let ((hash (createHash "sha256")) (index 0))
      (while (< index (js-length files))
        (let ((file (aref files index)))
          (ensure (relative file) "unsafe source path")
          (js-call hash :update file) (js-call hash :update (globalThis.String.fromCharCode 0))
          (js-call hash :update (if revision (git root (js-array "show" (str revision ":" file))) (await (readFile (js-call path :join root file)))))
          (js-call hash :update (globalThis.String.fromCharCode 0)))
        (setq index (1+ index)))
      (js-call hash :digest "hex")))
  (defasync validateRefreshedTransientBuilder (root filename currentBytes run &rest settings)
    (let* ((options (if (undefined? (aref settings 0)) (js-object) (aref settings 0)))
           (revision (get (get run :source) :commit)) (tree (get (get run :source) :tree)))
      (ensure (= filename FILE) "only the source-bound transient benchmark can be refreshed")
      (ensure (and (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test (or revision ""))
        (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test (or tree ""))) "invalid accepted source identity")
      (ensure (= (js-call (decode (git root (js-array "rev-parse" (str revision "^{tree}")))) :trim) tree) "accepted tree identity changed")
      (let* ((bound (js-call (get run :artifacts) :filter (lambda (entry) (= (get entry :file) filename))))
             (_bound (ensure (and (= (js-length bound) 1) (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (get (aref bound 0) :sha256))) "artifact is not uniquely bound to the accepted run"))
             (acceptedBytes (git root (js-array "show" (str revision ":" filename))))
             (_accepted (ensure (= (digest acceptedBytes) (get (aref bound 0) :sha256)) "accepted artifact differs from its Git snapshot"))
             (accepted (JSON/parse (decode acceptedBytes))) (current (JSON/parse (decode currentBytes))))
        (js-call (js-array accepted current) :forEach (lambda (report)
          (validateTransientBuilderReport report)
          (ensure (and (same (get report :parameters) PARAMETERS) (same (get report :decision) POLICY)) "original workload or decision policy changed")))
        (ensure (same (js-call (Object/keys (get current :results)) :sort) (js-array "map" "set" "vector")) "result inventory changed")
        (js-call (js-array "vector" "map" "set") :forEach (lambda (name)
          (let* ((item (get (get current :results) name)) (size (get PARAMETERS (str name "Size")))
                 (a (get item :allocation)) (timing (get item :timing)) (c (get item :correctness))
                 (expected (js-object :valid t :count size :first (if (= name "set") t 0) :last (if (= name "set") t (* (- size 1) (if (= name "map") 2 1)))))
                 (calls (if (= name "set") "setPersistentCalls" "persistentCalls")) (invalid (if (= name "set") "setInvalidCalls" "invalidCalls")))
            (ensure (= (get item :size) size) "workload size changed")
            (ensure (and (same (get c :persistentObservation) expected) (same (get c :transientObservation) expected)) "observed workload is incomplete")
            (ensure (and (= (get c :persistentHash) (get c :transientHash))
              (= (get c :persistentHash) (get (get (get (get accepted :results) name) :correctness) :persistentHash))) "value/hash equivalence changed")
            (ensure (and (Number/isSafeInteger (get a :persistentNodeAllocations)) (> (get a :persistentNodeAllocations) 0)
              (Number/isSafeInteger (get a :transientNodeAllocations)) (>= (get a :transientNodeAllocations) 0)) "allocation counters are invalid")
            (ensure (and (= (get a :allocationRatio) (/ (get a :transientNodeAllocations) (get a :persistentNodeAllocations))) (<= (get a :allocationRatio) (/ 1 3))) "allocation ratio differs from counters")
            (ensure (and (= (get a :completionCalls) 1) (= (get (get a :transientMetrics) calls) 1) (= (get (get a :transientMetrics) invalid) 0)) "transient lifecycle is incomplete")
            (js-call (js-array "persistent" "transient") :forEach (lambda (family)
              (let ((samples (get timing (str family "SamplesMs"))))
                (ensure (and (= (js-length samples) 11) (js-call samples :every (lambda (v) (and (Number/isFinite v) (> v 0))))) "timing samples are incomplete")
                (ensure (= (get timing (str family "MedianMs")) (median samples)) "timing median differs from raw samples"))))
            (ensure (and (= (get timing :speedup) (/ (get timing :persistentMedianMs) (get timing :transientMedianMs))) (>= (get timing :speedup) 1.5)) "speedup differs from raw medians"))))
        (ensure (and (= (get (get accepted :sourceDigest) :algorithm) "sha256") (= (get (get current :sourceDigest) :algorithm) "sha256")) "source digest algorithm changed")
        (ensure (= (await (source-digest root (get (get accepted :sourceDigest) :files) revision)) (get (get accepted :sourceDigest) :value)) "accepted source aggregate differs from its Git snapshot")
        (let ((validate-fresh (async ()
                (let* ((core (js-call (js-call (js-call (await (readdir (js-call path :join root "runtime/core"))) :filter (lambda (name) (js-call name :endsWith ".mjs"))) :sort)
                                :map (lambda (name) (str "runtime/core/" name))))
                       (inventory (js-call core :concat support-files)))
                  (ensure (same (get (get current :sourceDigest) :files) inventory) "fresh source inventory is incomplete")
                  (ensure (= (await (source-digest root inventory)) (get (get current :sourceDigest) :value)) "fresh source aggregate is stale"))))
              (failure undefined) (fresh false))
          (if (not (eq (get options :deferPerformanceAcceptance) t))
            (progn (await (funcall validate-fresh)) t)
            (progn
              (try (progn (await (funcall validate-fresh)) (setq fresh t)) (catch error (setq failure error)))
              (if fresh t
                (try
                  (let* ((measured (retainedPerformanceSnapshot root filename currentBytes))
                         (inventory (js-call (retainedRuntimeSourceFiles root (get measured :commit)) :concat support-files)))
                    (ensure (same (get (get current :sourceDigest) :files) inventory) "measured source inventory is incomplete")
                    (ensure (= (await (source-digest root inventory (get measured :commit))) (get (get current :sourceDigest) :value)) "measured source aggregate differs from its Git snapshot")
                    (Object/assign (deferredPerformanceAcceptance filename measured)
                      (js-object :currentSourceFailure (js-object :name (get failure :name) :message (get failure :message)))))
                  (catch error (put error :cause failure) (throw error))))))))))
  (export validateRefreshedTransientBuilder))
