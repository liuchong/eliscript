(module tools.acceptance.check
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdir readFile readdir stat writeFile)
  (import "node:os" :as os)
  (import "node:path" :as path)
  (import "node:process" :default process)
  (import "node:child_process" spawn)
  (import "node:timers" setTimeout clearTimeout)
  (import "node:url" fileURLToPath)
  (import "./check-legacy.mjs" :as legacy)

  (defconst DEFAULT_ROOT (js-call path :resolve
    (js-call path :dirname (fileURLToPath (js* "import.meta.url"))) "../.."))
  (defconst AcceptanceCorpusError (get legacy :AcceptanceCorpusError))
  (defconst humanRunReport (get legacy :humanRunReport))
  (defconst humanCorpusReport (get legacy :humanCorpusReport))
  (defconst humanVerifiedRunReport (get legacy :humanVerifiedRunReport))
  (defconst contract-file "contracts/core-acceptance-corpus.json")
  (defconst generated-evidence-proofs (new globalThis.Map))
  (defun maintained-evidence-source (filename)
    (cond ((= filename "tests/bootstrap-compiler.test.mjs") "tests/eliscript/bootstrap-compiler.eli")
      ((= filename "tools/integrity/check.mjs") "tools/integrity/eliscript/check.eli")
      ((= filename "tools/acceptance/finalize.mjs") "tools/acceptance/finalize.eli")
      ((= filename "tests/conformance.test.mjs") "tests/eliscript/conformance.eli")
      ((= filename "tests/ci-contract.test.mjs") "tests/eliscript/ci-contract.eli")
      ((= filename "tests/compiler-parity-corpus.test.mjs") "tests/eliscript/compiler-parity-corpus.eli")
      ((= filename "tests/stable-compatibility-corpus.test.mjs") "tests/eliscript/stable-compatibility-corpus.eli")
      (t undefined)))
  (defun capsule-evidence-source (filename)
    (if (and (= (value-type filename) "string") (js-call filename :endsWith ".mjs"))
      (str "tools/capsules/" (js-call filename :slice 0 -4) ".eli")
      undefined))
  (defconst run-results (new globalThis.Set (js-array "pass" "incomplete" "fail")))
  (defun field (object key &rest defaults)
    (let ((fallback (if (= (js-length defaults) 0) undefined (aref defaults 0))))
      (if (nullish? object) fallback (get object key fallback))))
  (defun plain-object (value)
    (and (not (nullish? value)) (= (value-type value) "object") (not (Array/isArray value))))
  (defun safe-relative (value)
    (and (= (value-type value) "string") (> (js-length value) 0)
      (not (js-call path :isAbsolute value)) (not (js-call (js-call value :split "/") :includes ".."))
      (= (js-call (get path :posix) :normalize value) value)))
  (defun sorted-unique (values) (js-call (Array/from (new globalThis.Set values)) :sort))
  (defun same (left right) (= (JSON/stringify left) (JSON/stringify right)))
  (defun sha256 (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defasync read-json (filename) (JSON/parse (await (readFile filename "utf8"))))
  (defun fail (errors) (throw (new AcceptanceCorpusError errors)))
  (defun criteria-from (source expression)
    (js-call (Array/from (js-call source :matchAll expression)) :map (lambda (match)
      (js-object :id (aref match 1) :title (js-call (aref match 2) :trim)))))

  (defasync capture (argv root timeout-ms &rest supplied)
    (let ((environment (if (undefined? (aref supplied 0)) (get process :env) (aref supplied 0))))
      (await (new globalThis.Promise (lambda (resolve-result reject-result)
      (let* ((child (spawn (aref argv 0) (js-call argv :slice 1)
                      (js-object :cwd root :env (if (undefined? environment) (get process :env) environment)
                        :stdio (js-array "ignore" "pipe" "pipe"))))
             (stdout "") (stderr "") (timed-out false) (timer undefined) (force-timer undefined))
        (js-call (get child :stdout) :setEncoding "utf8")
        (js-call (get child :stderr) :setEncoding "utf8")
        (js-call (get child :stdout) :on "data" (lambda (value) (setq stdout (str stdout value))))
        (js-call (get child :stderr) :on "data" (lambda (value) (setq stderr (str stderr value))))
        (when (and (= (value-type timeout-ms) "number") (> timeout-ms 0))
          (setq timer (setTimeout (lambda ()
            (setq timed-out t) (js-call child :kill "SIGTERM")
            (setq force-timer (setTimeout (lambda () (js-call child :kill "SIGKILL")) 2000))) timeout-ms)))
        (js-call child :once "error" (lambda (error)
          (clearTimeout timer) (clearTimeout force-timer) (funcall reject-result error)))
        (js-call child :once "close" (lambda (code)
          (clearTimeout timer) (clearTimeout force-timer)
          (funcall resolve-result (js-object :exitCode code :stdout stdout :stderr stderr :timedOut timed-out))))))))))

  (defasync tracked-files (root)
    (let ((result (await (capture (js-array "git" "ls-files" "-z") root 30000))))
      (unless (and (= (get result :exitCode) 0) (not (get result :timedOut)))
        (fail (js-array "git ls-files could not enumerate corpus evidence")))
      (new globalThis.Set (js-call (js-call (get result :stdout) :split (globalThis.String.fromCharCode 0)) :filter
        (lambda (value) (> (js-length value) 0))))))
  (defasync generated-evidence-fingerprint (root maintained filename emacs)
    (let* ((entries (await (readdir (js-call path :join root "compiler") (js-object :withFileTypes t))))
           (names (js-call (js-call entries :filter (lambda (entry)
             (and (js-call entry :isFile) (js-call (new globalThis.RegExp "\\.elc?$") :test (get entry :name)))))
             :map (lambda (entry) (str "compiler/" (get entry :name)))))
           (digest (createHash "sha256")))
      (js-call names :push maintained filename (str filename ".map") "tools/acceptance/compile-evidence.el")
      (js-call names :sort)
      (js-call digest :update (JSON/stringify (js-array root emacs (get (get process :env) :PATH) names)))
      (let ((index 0))
        (while (< index (js-length names))
          (let ((bytes (await (readFile (js-call path :join root (aref names index))))))
            (js-call digest :update (str (js-length bytes) ":")) (js-call digest :update bytes))
          (setq index (1+ index))))
      (js-call digest :digest "hex")))
  (defasync authenticate-generated (root filename files)
    (let ((maintained (maintained-evidence-source filename)))
      (when (undefined? maintained)
        (throw (new globalThis.Error "unknown generated acceptance evidence")))
      (unless (js-call files :has maintained)
        (throw (new globalThis.Error "maintained source is not tracked")))
      (unless (js-call files :has "tools/acceptance/compile-evidence.el")
        (throw (new globalThis.Error "maintained evidence compiler is not tracked")))
    (let* ((source (await (readFile (js-call path :join root maintained))))
           (module (await (readFile (js-call path :join root filename))))
           (mapping (await (readFile (js-call path :join root (str filename ".map")))))
           (emacs (get (get process :env) :EMACS "emacs"))
           (fingerprint (await (generated-evidence-fingerprint root maintained filename emacs))))
      ;; Reuse only a successful independent proof of these exact current
      ;; bytes. Every invocation rereads the source, output, map, helper and
      ;; all Emacs compiler modules; Git tracked checks above remain live.
      (unless (js-call generated-evidence-proofs :has fingerprint)
      (let ((result (await (capture (js-array emacs "--batch" "-Q" "-l"
             "tools/acceptance/compile-evidence.el" maintained filename) root nil))))
      (unless (and (= (get result :exitCode) 0) (not (get result :timedOut)))
        (throw (new globalThis.Error (str "maintained Emacs compilation failed: " (get result :stderr)))))
      (let ((fresh (JSON/parse (get result :stdout))))
        (unless (and (js-call module :equals (js-call Buffer :from (get fresh :javascript) "utf8"))
                     (js-call mapping :equals (js-call Buffer :from (get fresh :sourceMap) "utf8")))
          (throw (new globalThis.Error "complete generated module or source map differs from the maintained compiler result"))))
      ;; Detect source mutation during the independent compiler invocation too.
      (unless (js-call source :equals (await (readFile (js-call path :join root maintained))))
        (throw (new globalThis.Error "maintained source changed during evidence compilation")))
      (unless (= fingerprint (await (generated-evidence-fingerprint root maintained filename emacs)))
        (throw (new globalThis.Error "independent evidence inputs changed during compilation")))
      (when (>= (get generated-evidence-proofs :size) 128) (js-call generated-evidence-proofs :clear))
      (js-call generated-evidence-proofs :set fingerprint t)))
      t)))
  (defun string-array (values label errors)
    (if (or (not (Array/isArray values)) (= (js-length values) 0)
          (js-call values :some (lambda (value) (or (/= (value-type value) "string") (= (js-length value) 0)))))
      (progn (js-call errors :push (str label " must be a non-empty string array")) (js-array))
      (progn
        (unless (same values (sorted-unique values))
          (js-call errors :push (str label " must be unique and lexicographically sorted"))) values)))

  (defasync validateAcceptanceCorpus (contract &optional options)
    (let* ((root (js-call path :resolve (field options "root" DEFAULT_ROOT))) (errors (js-array)))
      (unless (and (plain-object contract) (= (get contract :schemaVersion) 1)
        (= (get contract :format) "eliscript-core-acceptance-corpus") (= (get contract :version) 1))
        (fail (js-array "contract must use eliscript-core-acceptance-corpus version 1")))
      (let* ((expected-sources (js-object :acceptance "specs/0040-maturity-roadmap.md"
                :persistentData "specs/0041-host-symbiosis-and-persistent-data.md" :progress "contracts/maturity-progress.json"))
             (commands (if (Array/isArray (get contract :commands)) (get contract :commands) (js-array)))
             (command-ids (js-call commands :map (lambda (command) (field command "id"))))
             (acceptance-source "") (persistent-source "") (progress (js-object))
             (files (new globalThis.Set)) (referenced (new globalThis.Set)) (generated (new globalThis.Map)))
        (unless (same (get contract :sources) expected-sources)
          (js-call errors :push "sources must identify the normative acceptance and progress files"))
        (when (or (= (js-length commands) 0) (not (same command-ids (sorted-unique command-ids))))
          (js-call errors :push "command ids must be non-empty, unique, and sorted"))
        (js-call commands :forEach (lambda (command index)
          (when (or (not (plain-object command)) (/= (value-type (field command "id")) "string")
            (not (Array/isArray (field command "argv"))) (= (js-length (field command "argv" (js-array))) 0)
            (js-call (field command "argv" (js-array)) :some (lambda (part)
              (or (/= (value-type part) "string") (= (js-length part) 0))))
            (not (Number/isInteger (field command "timeoutMs"))) (< (field command "timeoutMs") 1000))
            (js-call errors :push (str "command " index " must declare id, argv, and a bounded timeout")))))
        (try
          (let ((values (await (Promise/all (js-array
            (readFile (js-call path :join root (get expected-sources :acceptance)) "utf8")
            (readFile (js-call path :join root (get expected-sources :persistentData)) "utf8")
            (read-json (js-call path :join root (get expected-sources :progress))))))))
            (setq acceptance-source (aref values 0)) (setq persistent-source (aref values 1)) (setq progress (aref values 2)))
          (catch error (js-call errors :push (str "normative source could not be read: " (get error :message)))))
        (let* ((acceptance (criteria-from acceptance-source (new globalThis.RegExp "^\\*\\*(AC-\\d{2}) MUST - ([^*]+)\\*\\*$" "gmu")))
               (persistent (criteria-from persistent-source (new globalThis.RegExp "^### (PD-\\d{2}): (.+)$" "gmu")))
               (expected (js-call acceptance :concat persistent))
               (criteria (if (Array/isArray (get contract :criteria)) (get contract :criteria) (js-array)))
               (actual (js-call criteria :map (lambda (criterion) (js-object :id (get criterion :id) :title (get criterion :title)))))
               (progress-criteria (field (field progress "verification") "criteria" (js-array))))
          (when (or (= (js-length acceptance) 0) (= (js-length persistent) 0) (not (same actual expected)))
            (js-call errors :push "criteria must exactly match the ordered AC and PD headings in the normative specifications"))
          (unless (same (js-call criteria :map (lambda (criterion) (field criterion "id")))
                       (js-call (if (Array/isArray progress-criteria) progress-criteria (js-array)) :map
                         (lambda (criterion) (field criterion "id"))))
            (js-call errors :push "corpus and maturity progress criteria must have identical ids and order"))
          (try (setq files (await (tracked-files root)))
            (catch error (js-call errors :push (str "git ls-files could not enumerate corpus evidence"))))
          (let ((index 0))
            (while (< index (js-length criteria))
              (let* ((criterion (aref criteria index)) (label (field (aref expected index) "id" (str "criterion " index))))
                (if (not (plain-object criterion)) (js-call errors :push (str label " must be an object"))
                  (progn
                    (unless (= (get criterion :sourceSpec)
                      (if (and (= (value-type (get criterion :id)) "string") (js-call (get criterion :id) :startsWith "AC-")) "0040" "0041"))
                      (js-call errors :push (str label " sourceSpec must be "
                        (if (and (= (value-type (get criterion :id)) "string") (js-call (get criterion :id) :startsWith "AC-")) "0040" "0041"))))
                    (js-call (string-array (get criterion :probes) (str label " probes") errors) :forEach (lambda (probe)
                      (js-call referenced :add probe)
                      (unless (js-call command-ids :includes probe)
                        (js-call errors :push (str label " references unknown command " probe)))))
                    (let* ((evidence (string-array (get criterion :evidence) (str label " evidence") errors)) (file-index 0))
                      (while (< file-index (js-length evidence))
                        (let ((filename (aref evidence file-index)))
                          (cond
                            ((not (safe-relative filename))
                              (js-call errors :push (str label " has unsafe evidence path " (JSON/stringify filename))))
                            ((not (js-call files :has filename))
                              (if (and (not (undefined? (capsule-evidence-source filename)))
                                       (js-call files :has (capsule-evidence-source filename)))
                                (try
                                  (unless (js-call (await (stat (js-call path :join root filename))) :isFile)
                                    (js-call errors :push (str label " evidence is not a file: " filename)))
                                  (catch error (js-call errors :push (str label " evidence is missing: " filename))))
                                (if (undefined? (maintained-evidence-source filename))
                                  (js-call errors :push (str label " evidence is not tracked: " filename))
                                  (progn
                                    (unless (js-call generated :has filename)
                                      (try
                                        (await (authenticate-generated root filename files)) (js-call generated :set filename nil)
                                        (catch error (js-call generated :set filename (get error :message)))))
                                    (let ((failure (js-call generated :get filename)))
                                      (when failure (js-call errors :push (str label " generated acceptance evidence authentication failed: " filename ": " failure))))))))
                            (t (try
                              (unless (js-call (await (stat (js-call path :join root filename))) :isFile)
                                (js-call errors :push (str label " evidence is not a file: " filename)))
                              (catch error (js-call errors :push (str label " evidence is missing: " filename)))))))
                        (setq file-index (1+ file-index)))))))
              (setq index (1+ index))))
          (js-call command-ids :forEach (lambda (id)
            (unless (js-call referenced :has id) (js-call errors :push (str "command " id " is not used by any criterion")))))
          (let* ((applications (criteria-from acceptance-source (new globalThis.RegExp "^\\*\\*(AV-\\d{2}) - ([^*]+)\\*\\*$" "gmu")))
                 (declared (get contract :applications))
                 (actual-applications (if (Array/isArray declared)
                   (js-call declared :map (lambda (entry) (js-object :id (get entry :id) :title (get entry :title)))) (js-array))))
            (when (or (not (same actual-applications applications))
              (and (not (nullish? declared)) (js-call declared :some (lambda (entry) (not (eq (get entry :contributesToCore) false))))))
              (js-call errors :push "applications must match AV headings and contribute no core evidence"))
            (when (> (js-length errors) 0) (fail errors))
            (js-object :contract contract :progress progress :criteria expected :applications applications))))))

  (defasync checkAcceptanceCorpus (&optional options)
    (let* ((root (js-call path :resolve (field options "root" DEFAULT_ROOT)))
           (contract (field options "contract")))
      (when (nullish? contract) (setq contract (await (read-json (js-call path :join root contract-file)))))
      (await (validateAcceptanceCorpus contract (js-object :root root)))))

  (defun count-results (criteria)
    (let ((counts (js-object :pass 0 :incomplete 0 :fail 0 :total (js-length criteria))))
      (js-call criteria :forEach (lambda (criterion)
        (let ((key (get criterion :result))) (put counts key (1+ (get counts key)))))) counts))
  (defun pick (object fields)
    (let ((result (js-object)))
      (js-call fields :forEach (lambda (key) (put result key (get object key)))) result))
  (defun digest-string-p (value length)
    (and (= (value-type value) "string") (= (js-length value) length)
      (js-call (new globalThis.RegExp "^[0-9a-f]+$" "u") :test value)))
  (defun validate-run-shape (report checked errors)
    (if (or (not (plain-object report)) (/= (get report :schemaVersion) 1)
            (/= (get report :format) "eliscript-core-acceptance-run") (/= (get report :version) 1))
      (js-call errors :push "run must use eliscript-core-acceptance-run version 1")
      (let* ((source (get report :source)) (contract (get checked :contract))
             (commands (field report "commands")) (criteria (field report "criteria"))
             (command-fields (js-array "id" "argv" "timeoutMs"))
             (criterion-fields (js-array "id" "title" "sourceSpec" "probes" "evidence")))
        (unless (and (js-call (new globalThis.RegExp "^\\d{4}-\\d{2}-\\d{2}T" "u") :test (field report "generatedAt" ""))
          (digest-string-p (field source "commit" "") 40) (digest-string-p (field source "tree" "") 40)
          (eq (field source "cleanBefore") t) (eq (field source "cleanAfter") t))
          (js-call errors :push "run source identity and clean-worktree evidence are invalid"))
        (unless (and (plain-object (get report :environment))
          (js-call (js-array "platform" "architecture" "operatingSystem" "bunVersion" "nodeVersion" "emacsVersion" "cpu") :every
            (lambda (key) (let ((value (field (get report :environment) key)))
              (and (= (value-type value) "string") (> (js-length value) 0))))))
          (js-call errors :push "run environment metadata is incomplete"))
        (unless (and (= (field (get report :corpus) "contract") contract-file)
          (digest-string-p (field (get report :corpus) "contractSha256" "") 64)
          (= (field (get report :corpus) "criterionCount") (js-length (get contract :criteria))))
          (js-call errors :push "run corpus identity is invalid"))
        (unless (and (Array/isArray commands)
          (same (js-call commands :map (lambda (value) (pick value command-fields)))
                (js-call (get contract :commands) :map (lambda (value) (pick value command-fields))))
          (not (js-call commands :some (lambda (command)
            (or (not (js-call (js-array "pass" "fail") :includes (get command :status)))
              (not (Number/isInteger (get command :exitCode))) (/= (value-type (get command :timedOut)) "boolean")
              (/= (value-type (get command :durationMs)) "number") (< (get command :durationMs) 0)
              (not (digest-string-p (get command :outputSha256 "") 64)))))))
          (js-call errors :push "run command records do not match the corpus contract"))
        (unless (and (Array/isArray criteria)
          (same (js-call criteria :map (lambda (value) (pick value criterion-fields)))
                (js-call (get contract :criteria) :map (lambda (value) (pick value criterion-fields))))
          (not (js-call criteria :some (lambda (criterion)
            (or (not (js-call run-results :has (get criterion :result)))
              (not (js-call (js-array "complete" "partial" "open" "blocked") :includes (get criterion :declaredStatus))))))))
          (js-call errors :push "run criteria do not match the complete corpus contract"))
        (let ((expected (sorted-unique (js-call (js-array contract-file) :concat
          (Object/values (get contract :sources))
          (js-call (get contract :criteria) :flatMap (lambda (criterion) (get criterion :evidence)))))))
          (unless (and (Array/isArray (get report :artifacts))
            (same (js-call (get report :artifacts) :map (lambda (artifact) (get artifact :file))) expected)
            (not (js-call (get report :artifacts) :some (lambda (artifact) (not (digest-string-p (get artifact :sha256 "") 64))))))
            (js-call errors :push "run artifact digest inventory is incomplete or invalid")))
        (unless (same (get report :applications) (js-call (get contract :applications) :map
          (lambda (application) (Object/assign (js-object) application (js-object :result "not-run")))))
          (js-call errors :push "run application results must remain separate and non-contributing"))
        (let* ((counts (if (Array/isArray criteria) (count-results criteria) (js-object :pass 0 :incomplete 0 :fail 0 :total 0)))
               (operational (and (not (nullish? commands)) (js-call commands :every (lambda (command) (= (get command :status) "pass")))
                 (eq (field source "cleanBefore") t) (eq (field source "cleanAfter") t)))
               (expected (js-object :criteria counts :corpusComplete (= (get counts :total) (js-length (get contract :criteria)))
                 :operationalSuccess operational :acceptancePass (and operational (= (get counts :pass) (get counts :total))))))
          (unless (same (get report :summary) expected)
            (js-call errors :push "run summary is not derived from recorded results"))))))

  (defasync verifyAcceptanceRun (run-file &optional options)
    (let* ((root (js-call path :resolve (field options "root" DEFAULT_ROOT)))
           (checked (await (checkAcceptanceCorpus (js-object :root root :contract (field options "contract")))))
           (report (field options "report")) (errors (js-array)))
      (when (nullish? report) (setq report (await (read-json (js-call path :resolve root run-file)))))
      (validate-run-shape report checked errors)
      (unless (= (field (field report "corpus") "contractSha256")
                 (sha256 (await (readFile (js-call path :join root contract-file)))))
        (js-call errors :push "run was produced from a different acceptance corpus contract"))
      (when (field options "markdownFile")
        (unless (= (await (readFile (js-call path :resolve root (get options :markdownFile)) "utf8")) (humanRunReport report))
          (js-call errors :push "human report does not match its machine-readable run")))
      (when (> (js-length errors) 0) (fail errors)) report))

  (defasync command-text (argv root)
    (let ((result (await (capture argv root 30000))))
      (unless (and (= (get result :exitCode) 0) (not (get result :timedOut)))
        (fail (js-array (str (js-call argv :join " ") " could not be recorded"))))
      (js-call (get result :stdout) :trim)))
  (defasync repository-status (root)
    (await (command-text (js-array "git" "status" "--short" "--untracked-files=all") root)))
  (defasync run-probe (command root)
    (let* ((started (performance/now))
           (result (await (capture (get command :argv) root (get command :timeoutMs)
             (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE "1")))))
           (output (str (get result :stdout) "\n" (get result :stderr)))
           (lines (js-call (js-call (js-call output :split (new globalThis.RegExp "\\r?\\n" "u")) :map
             (lambda (line) (js-call line :trim))) :filter (lambda (line) (> (js-length line) 0)))))
      (js-object :id (get command :id) :argv (get command :argv) :timeoutMs (get command :timeoutMs)
        :status (if (and (not (get result :timedOut)) (= (get result :exitCode) 0)) "pass" "fail")
        :exitCode (get result :exitCode) :timedOut (get result :timedOut)
        :durationMs (/ (Math/round (* (- (performance/now) started) 1000)) 1000)
        :outputSha256 (sha256 output)
        :summary (js-call (js-call (js-call lines :slice -3) :join " | ") :slice 0 600))))
  (defasync environment-record (root)
    (let* ((values (await (Promise/all (js-array
      (command-text (js-array "uname" "-sr") root) (command-text (js-array "bun" "--version") root)
      (command-text (js-array "node" "--version") root)
      (command-text (js-array "emacs" "--batch" "-Q" "--eval" "(princ emacs-version)") root)))))
           (cpus (js-call os :cpus)))
      (js-object :platform (get process :platform) :architecture (get process :arch)
        :operatingSystem (aref values 0) :bunVersion (aref values 1) :nodeVersion (aref values 2)
        :emacsVersion (aref values 3) :cpu (field (aref cpus 0) "model" "unknown"))))
  (defasync artifact-records (root contract)
    (let* ((filenames (sorted-unique (js-call (js-array contract-file) :concat (Object/values (get contract :sources))
      (js-call (get contract :criteria) :flatMap (lambda (criterion) (get criterion :evidence))))))
           (records (js-array)) (index 0))
      (while (< index (js-length filenames))
        (let ((file (aref filenames index)))
          (js-call records :push (js-object :file file :sha256 (sha256 (await (readFile (js-call path :join root file)))))))
        (setq index (1+ index))) records))
  (defasync runAcceptanceCorpus (&optional options)
    (let* ((root (js-call path :resolve (field options "root" DEFAULT_ROOT)))
           (checked (await (checkAcceptanceCorpus (js-object :root root :contract (field options "contract")))))
           (before (await (repository-status root))))
      (when (> (js-length before) 0) (fail (js-array "acceptance runs require a clean tracked and untracked worktree")))
      (let* ((source (js-object :commit (await (command-text (js-array "git" "rev-parse" "HEAD") root))
                :tree (await (command-text (js-array "git" "rev-parse" "HEAD^{tree}") root)) :cleanBefore t :cleanAfter false))
             (commands (js-array)) (index 0) (contract (get checked :contract)))
        (while (< index (js-length (get contract :commands)))
          (js-call commands :push (await (run-probe (aref (get contract :commands) index) root)))
          (setq index (1+ index)))
        (put source :cleanAfter (= (js-length (await (repository-status root))) 0))
        (let* ((artifacts (await (artifact-records root contract)))
               (command-results (new globalThis.Map (js-call commands :map (lambda (command) (js-array (get command :id) command)))))
               (progress-results (new globalThis.Map (js-call (get (get (get checked :progress) :verification) :criteria) :map
                 (lambda (criterion) (js-array (get criterion :id) criterion)))))
               (criteria (js-call (get contract :criteria) :map (lambda (criterion)
                 (let* ((progress (js-call progress-results :get (get criterion :id)))
                        (passed (js-call (get criterion :probes) :every (lambda (id)
                          (= (field (js-call command-results :get id) "status") "pass"))))
                        (record (js-object :id (get criterion :id) :title (get criterion :title)
                          :sourceSpec (get criterion :sourceSpec) :result (if (not passed) "fail"
                            (if (= (get progress :status) "complete") "pass" "incomplete"))
                          :declaredStatus (get progress :status) :probes (get criterion :probes) :evidence (get criterion :evidence))))
                   (when (get progress :remaining) (put record :remaining (get progress :remaining))) record))))
               (counts (count-results criteria))
               (operational (and (js-call commands :every (lambda (command) (= (get command :status) "pass")))
                 (get source :cleanBefore) (get source :cleanAfter)))
               (report (js-object :schemaVersion 1 :format "eliscript-core-acceptance-run" :version 1
                 :generatedAt (js-call (new globalThis.Date) :toISOString) :source source :environment (await (environment-record root))
                 :corpus (js-object :contract contract-file :contractSha256 (sha256 (await (readFile (js-call path :join root contract-file))))
                   :criterionCount (js-length (get contract :criteria)))
                 :commands commands :artifacts artifacts :criteria criteria
                 :applications (js-call (get contract :applications) :map (lambda (application)
                   (Object/assign (js-object) application (js-object :result "not-run"))))
                 :summary (js-object :criteria counts :corpusComplete (= (js-length criteria) (js-length (get checked :criteria)))
                   :operationalSuccess operational :acceptancePass (and operational (= (get counts :pass) (get counts :total)))))))
          (when (field options "jsonOutput")
            (let ((filename (js-call path :resolve root (get options :jsonOutput))))
              (await (mkdir (js-call path :dirname filename) (js-object :recursive t)))
              (await (writeFile filename (str (JSON/stringify report nil 2) "\n")))))
          (when (field options "markdownOutput")
            (let ((filename (js-call path :resolve root (get options :markdownOutput))))
              (await (mkdir (js-call path :dirname filename) (js-object :recursive t)))
              (await (writeFile filename (humanRunReport report)))))
          (when (and (field options "requirePass") (not (get (get report :summary) :acceptancePass)))
            (fail (js-array "the complete corpus ran, but the final acceptance gate did not pass")))
          (unless (get (get report :summary) :operationalSuccess)
            (fail (js-array "one or more corpus commands failed or changed the repository"))) report))))

  (defun parse-arguments (argv)
    (let ((options (js-object)) (index 0)
          (paths (js-object "--json-output" "jsonOutput" "--markdown-output" "markdownOutput"
            "--verify-run" "verifyRun" "--verify-markdown" "verifyMarkdown")))
      (while (< index (js-length argv))
        (let ((argument (aref argv index)))
          (cond ((= argument "--run") (put options :run t))
            ((= argument "--require-pass") (put options :requirePass t))
            ((= argument "--json") (put options :json t))
            ((Object/hasOwn paths argument)
              (let ((value (aref argv (1+ index))))
                (unless value (fail (js-array (str argument " requires a path"))))
                (put options (get paths argument) value) (setq index (1+ index))))
            (t (fail (js-array (str "unknown argument " argument))))))
        (setq index (1+ index))) options))
  (defasync main ()
    (let ((options (parse-arguments (js-call (get process :argv) :slice 2))))
      (cond ((get options :run)
        (unless (and (get options :jsonOutput) (get options :markdownOutput))
          (fail (js-array "--run requires --json-output and --markdown-output")))
        (let ((report (await (runAcceptanceCorpus options))))
          (js-call (get process :stdout) :write (if (get options :json) (str (JSON/stringify report nil 2) "\n") (humanRunReport report)))))
        ((get options :verifyRun)
          (let ((report (await (verifyAcceptanceRun (get options :verifyRun) (js-object :markdownFile (get options :verifyMarkdown))))))
            (js-call (get process :stdout) :write (if (get options :json) (str (JSON/stringify report nil 2) "\n")
              (str (humanVerifiedRunReport report) "\n")))))
        (t (let ((checked (await (checkAcceptanceCorpus))))
          (js-call (get process :stdout) :write (if (get options :json)
            (str (JSON/stringify (js-object :format "eliscript-core-acceptance-corpus-report" :version 1
              :criteria (js-length (get checked :criteria)) :commands (js-call (get (get checked :contract) :commands) :map (lambda (command) (get command :id)))
              :applications (js-length (get checked :applications))) nil 2) "\n") (str (humanCorpusReport checked) "\n"))))))))
  (when (and (not (undefined? (aref (get process :argv) 1)))
    (= (js-call path :resolve (aref (get process :argv) 1)) (fileURLToPath (js* "import.meta.url"))))
    (js-call (main) :catch (lambda (error)
      (js-call (get process :stderr) :write (str (field error "stack" error) "\n")) (put process :exitCode 1))))

  (export DEFAULT_ROOT AcceptanceCorpusError validateAcceptanceCorpus checkAcceptanceCorpus runAcceptanceCorpus
    humanRunReport verifyAcceptanceRun humanCorpusReport humanVerifiedRunReport))
