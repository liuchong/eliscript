(module tools.acceptance.repeat
  (import "node:crypto" createHash)
  (import "node:fs/promises" mkdtemp readdir readFile rm writeFile mkdir)
  (import "node:os" tmpdir)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)
  (import "./check.mjs" runAcceptanceCorpus)

  (defconst module-directory (js-call path :dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst DEFAULT_ROOT (js-call path :resolve module-directory "../.."))
  (defconst REPEATED_DETERMINISM_FORMAT "eliscript-repeated-determinism-run")
  (defconst REPEATED_DETERMINISM_VERSION 1)
  (defconst REQUIRED_ITERATIONS 20)
  (defconst compiler-modules
    (js-array "analyzer" "compiler" "emitter" "expander" "formatter" "ir" "lower" "project"
      "reader" "source-map" "symbol" "syntax" "transient-analysis"))
  (defconst compiler-artifacts
    (js-call (js-call compiler-modules :flatMap
               (lambda (name) (js-array (str name ".mjs") (str name ".mjs.map"))))
      :sort))
  (defconst excluded-observations
    (js-array "acceptance.generatedAt" "acceptance.commands[].durationMs" "acceptance.commands[].outputSha256"
      "acceptance.commands[].summary" "compiler.temporaryDirectory"))
  (defconst identity-projection-format "eliscript-repeated-determinism-identity")
  (defconst identity-projection-version 1)
  (defconst commit-pattern "^[0-9a-f]{40}$")

  (defun repeat-error-message (messages)
    (str "repeated determinism validation failed:\n- " (js-call messages :join "\n- ")))
  (defun repeat-error-fields (self messages)
    (put self :name "RepeatedDeterminismError")
    self)
  (defconst RepeatedDeterminismError
    (funcall
      (js* "(message, fields) => class RepeatedDeterminismError extends Error { constructor(messages) { const self = super(message(messages)); return fields(self, messages); } }")
      repeat-error-message repeat-error-fields))

  (defun host-type (value) (funcall (js* "(value) => typeof value") value))
  (defun host-truthy (value) (funcall (js* "(value) => !!value") value))
  (defun host-get (value key) (if (nullish? value) undefined (get value key)))
  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
  (defun sha256 (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))

  (defun canonical-value (value)
    (if (Array/isArray value)
      (js-call value :map canonical-value)
      (if (and value (= (host-type value) "object"))
        (js-call globalThis.Object :fromEntries
          (js-call (js-call (js-call globalThis.Object :keys value) :sort) :map
            (lambda (key) (js-array key (canonical-value (get value key))))))
        value)))

  (defun identity-digest (value) (sha256 (JSON/stringify (canonical-value value))))

  (defasync capture (command &rest supplied)
    (let* ((options (call-options supplied))
           (child (globalThis.Bun.spawn command
                    (js-object :cwd (get options :cwd) :env (get options :env) :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                  (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2))))

  (defasync artifact-record (directory file)
    (let ((bytes (await (readFile (js-call path :join directory file)))))
      (js-object :file file :bytes (js-length bytes) :sha256 (sha256 bytes))))

  (defasync compiler-identity (directory)
    (let ((actual (js-call (await (readdir directory)) :sort)))
      (unless (= (JSON/stringify actual) (JSON/stringify compiler-artifacts))
        (throw (new RepeatedDeterminismError
                 (js-array "compiler build did not produce the exact declared artifact inventory"))))
      (let ((artifacts (await (Promise/all (js-call actual :map (lambda (file) (artifact-record directory file)))))))
        (js-object :artifactCount (js-length artifacts) :sha256 (identity-digest artifacts) :artifacts artifacts))))

  (defun acceptanceIdentity (report)
    (js-object :schemaVersion 1 :format "eliscript-core-acceptance-identity" :version 1
      :source (get report :source) :environment (get report :environment) :corpus (get report :corpus)
      :commands (js-call (get report :commands) :map
                  (lambda (command)
                    (js-object :id (get command :id) :argv (get command :argv) :timeoutMs (get command :timeoutMs)
                      :status (get command :status) :exitCode (get command :exitCode) :timedOut (get command :timedOut))))
      :artifacts (get report :artifacts) :criteria (get report :criteria)
      :applications (get report :applications) :summary (get report :summary)))

  (defun run-identity (compiler acceptance)
    (let* ((acceptance-value (acceptanceIdentity acceptance))
           (acceptance-sha (identity-digest acceptance-value))
           (value (js-object :compilerSha256 (get compiler :sha256) :acceptanceSha256 acceptance-sha)))
      (js-object :sha256 (identity-digest value) :compilerSha256 (get compiler :sha256)
        :acceptanceSha256 acceptance-sha :acceptanceValue acceptance-value)))

  (defasync build-compiler (root iteration)
    (let ((directory (await (mkdtemp (js-call path :join (tmpdir) (str "eliscript-determinism-" iteration "-"))))))
      (try
        (let ((result (await (capture (js-array (js-call path :join root "bin/eliscript-bootstrap"))
                               (js-object :cwd root
                                 :env (js-call globalThis.Object :assign (js-object) (get globalThis.process :env)
                                        (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory)))))))
          (unless (= (get result :exitCode) 0)
            (let ((err (js-call (get result :stderr) :trim)) (out (js-call (get result :stdout) :trim)))
              (throw (new RepeatedDeterminismError
                       (js-array (str "compiler build " iteration " failed: "
                                   (if (host-truthy err) err out)))))))
          (await (compiler-identity directory)))
        (finally (await (rm directory (js-object :recursive t :force t)))))))

  (defasync runRepeatedDeterminism (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (iterations (get options :iterations REQUIRED_ITERATIONS)))
      (unless (and (js-call globalThis.Number :isSafeInteger iterations) (>= iterations 1) (<= iterations 100))
        (throw (new RepeatedDeterminismError (js-array "iterations must be an integer between 1 and 100"))))
      (let ((runs (js-array)) (reference nil) (index 1))
        (while (<= index iterations)
          (let* ((compiler (await (build-compiler root index)))
                 (acceptance (await (runAcceptanceCorpus (js-object :root root))))
                 (identity (run-identity compiler acceptance)))
            (when (nullish? reference) (setq reference identity))
            (unless (= (get identity :sha256) (get reference :sha256))
              (throw (new RepeatedDeterminismError
                       (js-array (str "iteration " index " produced identity " (get identity :sha256)
                                   ", expected " (get reference :sha256))))))
            (js-call runs :push
              (js-object :iteration index :source (get acceptance :source)
                :compiler (js-object :artifactCount (get compiler :artifactCount) :sha256 (get compiler :sha256))
                :acceptance (js-object :criterionCount (get (get (get acceptance :summary) :criteria) :total)
                              :artifactCount (js-length (get acceptance :artifacts))
                              :corpusComplete (get (get acceptance :summary) :corpusComplete)
                              :operationalSuccess (get (get acceptance :summary) :operationalSuccess)
                              :acceptancePass (get (get acceptance :summary) :acceptancePass)
                              :sha256 (get identity :acceptanceSha256))
                :identitySha256 (get identity :sha256)
                :observations (js-object :generatedAt (get acceptance :generatedAt)
                                :commands (js-call (get acceptance :commands) :map
                                            (lambda (command)
                                              (js-object :id (get command :id) :durationMs (get command :durationMs)
                                                :outputSha256 (get command :outputSha256)))))))
            (let ((callback (host-get options "onIteration")))
              (when (not (nullish? callback))
                (funcall callback (js-object :iteration index :iterations iterations
                                     :identitySha256 (get identity :sha256))))))
          (setq index (1+ index)))
        (let* ((all-operational (let ((cursor 0) (ok t))
                                  (while (and ok (< cursor (js-length runs)))
                                    (let ((run (aref runs cursor)))
                                      (unless (and (get (get run :source) :cleanBefore)
                                                   (get (get run :source) :cleanAfter)
                                                   (get (get run :acceptance) :corpusComplete)
                                                   (get (get run :acceptance) :operationalSuccess))
                                        (setq ok nil)))
                                    (setq cursor (1+ cursor)))
                                  ok))
               (report (js-object :schemaVersion 1 :format REPEATED_DETERMINISM_FORMAT
                         :version REPEATED_DETERMINISM_VERSION
                         :generatedAt (js-call (new globalThis.Date) :toISOString)
                         :source (js-object :commit (get (get (aref runs 0) :source) :commit)
                                   :tree (get (get (aref runs 0) :source) :tree))
                         :parameters (js-object :iterations iterations :requiredIterations REQUIRED_ITERATIONS)
                         :identityProjection (js-object :format identity-projection-format
                                               :version identity-projection-version
                                               :excludedObservations excluded-observations)
                         :identity (js-object :sha256 (get reference :sha256)
                                     :compilerSha256 (get reference :compilerSha256)
                                     :acceptanceSha256 (get reference :acceptanceSha256)
                                     :compilerArtifactCount (get (get (aref runs 0) :compiler) :artifactCount)
                                     :acceptanceArtifactCount (get (get (aref runs 0) :acceptance) :artifactCount)
                                     :criterionCount (get (get (aref runs 0) :acceptance) :criterionCount))
                         :runs runs
                         :summary (js-object :allIdentical t :allOperational all-operational
                                    :acceptanceQualified (and (= iterations REQUIRED_ITERATIONS) all-operational)))))
          (validateRepeatedDeterminismReport report)))))

  (defun hash-text (value)
    (js-call (new globalThis.RegExp commit-pattern "u") :test (if (nullish? value) "" value)))

  (defun run-count (report)
    (let ((count (host-get (host-get report "runs") "length")))
      (if (nullish? count) 0 count)))

  (defun validateRepeatedDeterminismReport (report &rest supplied)
    (let* ((options (call-options supplied))
           (required (get options :requiredIterations REQUIRED_ITERATIONS))
           (errors (js-array))
           (identity (host-get report "identity"))
           (parameters (host-get report "parameters"))
           (projection (host-get report "identityProjection"))
           (iterations (host-get parameters "iterations")))
      (when (or (not (= (host-get report "schemaVersion") 1))
                (not (= (host-get report "format") REPEATED_DETERMINISM_FORMAT))
                (not (= (host-get report "version") REPEATED_DETERMINISM_VERSION)))
        (js-call errors :push "report identity is invalid"))
      (when (or (not (hash-text (host-get (host-get report "source") "commit")))
                (not (hash-text (host-get (host-get report "source") "tree"))))
        (js-call errors :push "source commit and tree identities are invalid"))
      (when (or (not (js-call globalThis.Number :isSafeInteger iterations))
                (< iterations 1)
                (not (= (host-get parameters "requiredIterations") required))
                (not (= (run-count report) iterations)))
        (js-call errors :push "iteration parameters and run inventory do not agree"))
      (when (or (not (= (JSON/stringify (host-get projection "excludedObservations")) (JSON/stringify excluded-observations)))
                (not (= (host-get projection "format") identity-projection-format))
                (not (= (host-get projection "version") identity-projection-version)))
        (js-call errors :push "identity projection does not declare the exact observations"))
      (when (or (not (= (host-get identity "compilerArtifactCount") (js-length compiler-artifacts)))
                (not (js-call globalThis.Number :isSafeInteger (host-get identity "acceptanceArtifactCount")))
                (< (get identity :acceptanceArtifactCount) 1)
                (not (js-call globalThis.Number :isSafeInteger (host-get identity "criterionCount")))
                (< (get identity :criterionCount) 1))
        (js-call errors :push "identity artifact counts are invalid"))
      (unless (= (host-get identity "sha256")
                 (identity-digest (js-object :compilerSha256 (host-get identity "compilerSha256")
                                    :acceptanceSha256 (host-get identity "acceptanceSha256"))))
        (js-call errors :push "combined identity digest cannot be reproduced"))
      (let ((index 0) (total (run-count report)))
        (while (< index total)
          (let ((run (aref (get report :runs) index)))
            (when (or (not (= (get run :iteration) (1+ index)))
                      (not (= (host-get (host-get run "source") "commit") (get (get report :source) :commit)))
                      (not (= (host-get (host-get run "source") "tree") (get (get report :source) :tree)))
                      (not (= (host-get (host-get run "source") "cleanBefore") t))
                      (not (= (host-get (host-get run "source") "cleanAfter") t)))
              (js-call errors :push (str "run " (1+ index) " has invalid source identity or cleanliness")))
            (when (or (not (= (host-get (host-get run "compiler") "artifactCount") (js-length compiler-artifacts)))
                      (not (= (host-get (host-get run "compiler") "sha256") (get identity :compilerSha256)))
                      (not (= (host-get (host-get run "acceptance") "artifactCount") (get identity :acceptanceArtifactCount)))
                      (not (= (host-get (host-get run "acceptance") "criterionCount") (get identity :criterionCount)))
                      (not (= (host-get (host-get run "acceptance") "corpusComplete") t))
                      (not (= (host-get (host-get run "acceptance") "operationalSuccess") t))
                      (not (= (host-get (host-get run "acceptance") "sha256") (get identity :acceptanceSha256)))
                      (not (= (get run :identitySha256) (host-get identity "sha256"))))
              (js-call errors :push (str "run " (1+ index) " does not match the declared identity"))))
          (setq index (1+ index))))
      (let ((qualified (and (= iterations required) (= (run-count report) required) (= (js-length errors) 0)))
            (summary (host-get report "summary")))
        (when (or (not (= (host-get summary "allIdentical") t))
                  (not (= (host-get summary "allOperational") t))
                  (not (= (host-get summary "acceptanceQualified") qualified)))
          (js-call errors :push "summary is not derived from the complete run inventory")))
      (when (> (js-length errors) 0) (throw (new RepeatedDeterminismError errors)))
      report))

  (defun yes-no (value) (if (host-truthy value) "yes" "no"))

  (defun humanRepeatedDeterminismReport (report)
    (let ((lines (js-array "# Repeated Determinism Run" ""
                   (str "- Source commit: `" (get (get report :source) :commit) "`")
                   (str "- Source tree: `" (get (get report :source) :tree) "`")
                   (str "- Iterations: " (get (get report :parameters) :iterations) "/"
                        (get (get report :parameters) :requiredIterations))
                   (str "- Compiler artifacts per iteration: " (get (get report :identity) :compilerArtifactCount))
                   (str "- Acceptance artifacts per iteration: " (get (get report :identity) :acceptanceArtifactCount))
                   (str "- Mandatory criteria per iteration: " (get (get report :identity) :criterionCount))
                   (str "- Identity SHA-256: `" (get (get report :identity) :sha256) "`")
                   (str "- All identical: " (yes-no (get (get report :summary) :allIdentical)))
                   (str "- All operational: " (yes-no (get (get report :summary) :allOperational)))
                   (str "- Acceptance qualified: " (yes-no (get (get report :summary) :acceptanceQualified)))
                   ""
                   "Timing, command-output digests, summaries, and temporary directories are"
                   "observations outside artifact identity by the versioned projection schema."
                   ""
                   "| Run | Compiler SHA-256 | Acceptance SHA-256 | Identity SHA-256 |"
                   "| ---: | --- | --- | --- |"))
          (index 0)
          (runs (get report :runs)))
      (while (< index (js-length runs))
        (let ((run (aref runs index)))
          (js-call lines :push
            (str "| " (get run :iteration) " | `" (get (get run :compiler) :sha256) "` | `"
                 (get (get run :acceptance) :sha256) "` | `" (get run :identitySha256) "` |")))
        (setq index (1+ index)))
      (js-call lines :push "")
      (js-call lines :join "\n")))

  (defasync write-report (report json-output markdown-output root)
    (let ((json-path (js-call path :resolve root json-output))
          (markdown-path (js-call path :resolve root markdown-output)))
      (await (mkdir (js-call path :dirname json-path) (js-object :recursive t)))
      (await (mkdir (js-call path :dirname markdown-path) (js-object :recursive t)))
      (await (writeFile json-path (str (JSON/stringify report nil 2) "\n")))
      (await (writeFile markdown-path (humanRepeatedDeterminismReport report)))))

  (defun option-name (argument)
    (cond ((= argument "--iterations") "iterations")
      ((= argument "--json-output") "jsonOutput")
      ((= argument "--markdown-output") "markdownOutput")
      ((= argument "--json-report") "jsonReport")
      ((= argument "--markdown-report") "markdownReport")))

  (defun parse-arguments (argv)
    (let ((options (js-object)) (index 0))
      (while (< index (js-length argv))
        (let ((argument (aref argv index)))
          (cond
            ((= argument "--run") (put options :run t))
            ((= argument "--verify") (put options :verify t))
            ((js-call (js-array "--iterations" "--json-output" "--markdown-output" "--json-report" "--markdown-report")
               :includes argument)
             (let ((value (aref argv (1+ index))))
               (unless (host-truthy value)
                 (throw (new RepeatedDeterminismError (js-array (str argument " requires a value")))))
               (put options (option-name argument)
                 (if (= argument "--iterations") (funcall globalThis.Number value) value))
               (setq index (1+ index))))
            (t (throw (new RepeatedDeterminismError (js-array (str "unknown argument " argument)))))))
        (setq index (1+ index)))
      (when (= (get options :run) (get options :verify))
        (throw (new RepeatedDeterminismError (js-array "choose exactly one of --run or --verify"))))
      options))

  (defasync main ()
    (let ((options (parse-arguments (js-call (get globalThis.process :argv) :slice 2))))
      (if (host-truthy (get options :run))
        (progn
          (unless (and (host-truthy (get options :jsonOutput)) (host-truthy (get options :markdownOutput)))
            (throw (new RepeatedDeterminismError (js-array "--run requires --json-output and --markdown-output"))))
          (let ((report (await (runRepeatedDeterminism
                                 (js-object :iterations (get options :iterations)
                                   :onIteration (lambda (event)
                                                  (js-call (get globalThis.process :stderr) :write
                                                    (str "Repeated determinism: " (get event :iteration) "/"
                                                         (get event :iterations) " matched "
                                                         (get event :identitySha256) "\n"))))))))
            (await (write-report report (get options :jsonOutput) (get options :markdownOutput) DEFAULT_ROOT))
            (js-call (get globalThis.process :stdout) :write (str (humanRepeatedDeterminismReport report) "\n"))))
        (progn
          (unless (and (host-truthy (get options :jsonReport)) (host-truthy (get options :markdownReport)))
            (throw (new RepeatedDeterminismError (js-array "--verify requires --json-report and --markdown-report"))))
          (let* ((report (validateRepeatedDeterminismReport
                           (JSON/parse (await (readFile (js-call path :resolve DEFAULT_ROOT (get options :jsonReport)) "utf8")))))
                 (markdown (await (readFile (js-call path :resolve DEFAULT_ROOT (get options :markdownReport)) "utf8"))))
            (unless (= markdown (humanRepeatedDeterminismReport report))
              (throw (new RepeatedDeterminismError (js-array "Markdown report does not match the machine-readable report"))))
            (js-call (get globalThis.process :stdout) :write
              (str "Repeated determinism verified: " (js-length (get report :runs)) "/" REQUIRED_ITERATIONS
                   " identical clean runs\n")))))))

  (when (js* "import.meta.main")
    (js-call (main) :catch
      (lambda (error)
        (let ((stack (get error :stack)))
          (js-call (get globalThis.process :stderr) :write (str (if (nullish? stack) error stack) "\n")))
        (put globalThis.process :exitCode 1))))

  (export DEFAULT_ROOT REPEATED_DETERMINISM_FORMAT REPEATED_DETERMINISM_VERSION REQUIRED_ITERATIONS
    RepeatedDeterminismError acceptanceIdentity runRepeatedDeterminism validateRepeatedDeterminismReport
    humanRepeatedDeterminismReport))
