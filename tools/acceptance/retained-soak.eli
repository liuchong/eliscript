(module tools.acceptance.retained-soak
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile)
  (import "node:path" :as path)
  (import "./retained-performance-snapshot.mjs" retainedPerformanceSnapshot deferredPerformanceAcceptance retainedGitSnapshotBytes)
  (defconst SOAK "benchmarks/worker-lifecycle-soak-macos-arm64.json")
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun same (a b) (= (JSON/stringify a) (JSON/stringify b)))
  (defun ensure (condition message)
    (unless condition (throw (new globalThis.Error (str "retained soak refresh: " message)))))
  (defun field (object key) (if (nullish? object) undefined (get object key)))
  (defun relative (file)
    (and (= (value-type file) "string") (> (js-length file) 0) (not (js-call path :isAbsolute file))
      (not (js-call (js-call file :split "/") :includes "..")) (= (js-call (get path "posix") :normalize file) file)))
  (defun git (root args)
    (try (retainedGitSnapshotBytes root args) (catch error (ensure false "accepted Git snapshot is unavailable"))))
  (defun decode (bytes) (js-call (new globalThis.TextDecoder) :decode bytes))
  (defun median (values)
    (let ((sorted (js-call (js-call values "slice") :sort (lambda (a b) (- a b))))) (/ (+ (aref sorted 0) (aref sorted 1)) 2)))
  (defun check-fields (object expected prefix)
    (js-call (Object/entries expected) :forEach (lambda (entry)
      (ensure (eq (field object (aref entry 0)) (aref entry 1)) (str prefix " " (aref entry 0) " failed")))))
  (defasync source-manifests (root files revision)
    (let ((lines (createHash "sha256")) (bytes-hash (createHash "sha256")) (index 0))
      (while (< index (js-length files))
        (let* ((entry (aref files index)) (file (get entry "file"))
               (_ (ensure (and (relative file) (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (get entry "sha256"))) "unsafe source entry"))
               (bytes (if revision (git root (js-array "show" (str revision ":" file)))
                        (await (readFile (js-call path :join root file)))))
               (actual (digest bytes)))
          (ensure (= actual (get entry "sha256")) (if revision "measured source entry differs from its Git snapshot" "fresh source entry is stale"))
          ;; These are the two existing source-binding algorithms accepted by
          ;; repository-integrity: filename/hash lines and filename/raw bytes.
          ;; Both authenticate every actual byte; neither changes a report.
          (js-call lines :update (str file ":" actual "\n"))
          (js-call bytes-hash :update file) (js-call bytes-hash :update (globalThis.String.fromCharCode 0))
          (js-call bytes-hash :update bytes) (js-call bytes-hash :update (globalThis.String.fromCharCode 0)))
        (setq index (1+ index)))
      (js-array (js-call lines :digest "hex") (js-call bytes-hash :digest "hex"))))
  (defasync validateRefreshedWorkerSoak (root filename currentBytes run &rest settings)
    (let* ((options (if (undefined? (aref settings 0)) (js-object) (aref settings 0)))
           (revision (field (field run "source") "commit")) (tree (field (field run "source") "tree")))
      (ensure (= filename SOAK) "only the source-bound worker soak can be refreshed")
      (ensure (and (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test (or revision ""))
                   (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test (or tree ""))) "invalid accepted source identity")
      (ensure (= (js-call (decode (git root (js-array "rev-parse" (str revision "^{tree}")))) "trim") tree) "accepted tree identity changed")
      (let* ((bound (js-call (get run "artifacts") :filter (lambda (entry) (= (get entry "file") filename))))
             (_bound (ensure (and (= (js-length bound) 1) (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (field (aref bound 0) "sha256"))) "artifact is not uniquely bound to the accepted run"))
             (acceptedBytes (git root (js-array "show" (str revision ":" filename))))
             (_accepted (ensure (= (digest acceptedBytes) (get (aref bound 0) "sha256")) "accepted artifact hash does not match its Git snapshot"))
             (accepted (JSON/parse (decode acceptedBytes))) (current (JSON/parse (decode currentBytes))))
        (ensure (and (= (get current "schemaVersion") 1) (= (get current "format") "eliscript-worker-lifecycle-soak")
                     (= (get current "version") 1) (eq (get current "verified") t) (eq (get current "acceptanceQualified") t)) "fresh report is not acceptance qualified")
        (ensure (same (get current "limits") (js-object :runTimeoutSeconds 180 :requestTimeoutMs 5000 :blockingTimeoutMs 25)) "original timeout policy changed")
        (ensure (and (Number/isFinite (get current "elapsedMs")) (> (get current "elapsedMs") 0) (<= (get current "elapsedMs") 180000)) "original elapsed budget failed")
        (check-fields (get current "workload") (js-object :successfulRequests 100000 :responseCount 100000 :uniqueResponses 100000
          :duplicateResponses 0 :lostResponses 0 :batchSize 64 :peakInFlight 64 :checkpointEvery 2500 :resultChecksum 2409405 :expectedChecksum 2409405) "workload")
        (let* ((recovery (get current "recovery"))
               (events (js-array
                 (js-object :name "cooperative-cancellation" :errorCode "cancelled" :callbackCount 1 :pendingAfter 0)
                 (js-object :name "explicit-restart" :fromGeneration 1 :toGeneration 2 :pendingAfter 0)
                 (js-object :name "module-replacement" :fromGeneration 2 :toGeneration 3 :revision 2 :pendingAfter 0)
                 (js-object :name "blocking-timeout" :fromGeneration 3 :errorCode "timeout" :callbackCount 1 :workerStopped t :pendingAfter 0)
                 (js-object :name "process-death" :fromGeneration 4 :errorCode "worker-exit" :callbackCount 1 :pendingAfter 0))) (index 0))
          (check-fields recovery (js-object :faultCallbacks 3 :initialGeneration 1 :finalGeneration 5 :restartCount 4) "recovery counts")
          (ensure (= (js-length (get recovery "events")) (js-length events)) "recovery event inventory changed")
          (while (< index (js-length events)) (check-fields (aref (get recovery "events") index) (aref events index) "recovery") (setq index (1+ index))))
        (let* ((lifecycle (get current "lifecycle")) (memory (get current "memory"))
               (budgets (js-object :emacs 524288 :worker 524288 :combined 786432)) (medians (js-array)))
          (check-fields lifecycle (js-object :cleanShutdown t :temporaryDirectoryRemoved t :reclaimedProcessCount 5 :pendingAfterCorpus 0 :ownedProcessCount 5) "lifecycle")
          (ensure (and (= (js-length (get lifecycle "ownedPids")) 5) (= (get (new globalThis.Set (get lifecycle "ownedPids")) "size") 5)
                       (js-call (get lifecycle "ownedPids") :every (lambda (pid) (and (Number/isSafeInteger pid) (> pid 0))))) "owned process inventory failed")
          (ensure (and (= (get memory "unit") "KiB") (eq (get memory "withinBudget") t) (eq (get memory "boundedTrend") t) (same (get memory "budgetKiB") budgets)) "original memory policy changed")
          (ensure (and (Number/isSafeInteger (get memory "sampleCount")) (>= (get memory "sampleCount") 40)) "memory sampling incomplete")
          (js-call (Object/entries budgets) :forEach (lambda (entry)
            (let ((value (field (get memory "peakKiB") (aref entry 0))))
              (ensure (and (Number/isFinite value) (>= value 0) (<= value (aref entry 1))) (str "absolute " (aref entry 0) " budget failed")))))
          (ensure (and (= (js-length (get memory "checkpoints")) 40) (= (js-length (get memory "generations")) 5)) "memory checkpoint inventory failed")
          (let ((index 0)) (while (< index 40)
            (let ((sample (aref (get memory "checkpoints") index)) (group (Math/floor (/ index 8))))
              (ensure (and (= (get sample "request") (* (1+ index) 2500)) (= (get sample "generation") (1+ group))
                           (= (get sample "pid") (aref (get lifecycle "ownedPids") group))) "checkpoint source identity failed")
              (js-call (js-array (js-array "emacsKiB" "emacs") (js-array "workerKiB" "worker")) :forEach (lambda (entry)
                (let ((value (get sample (aref entry 0)))) (ensure (and (Number/isSafeInteger value) (>= value 0)
                  (<= value (get (get memory "peakKiB") (aref entry 1)))) (str "checkpoint " (aref entry 0) " exceeds retained peak")))))
              (ensure (<= (+ (get sample "emacsKiB") (get sample "workerKiB")) (get (get memory "peakKiB") "combined")) "combined checkpoint exceeds retained peak"))
            (setq index (1+ index))))
          (let ((index 0)) (while (< index 5)
            (let* ((group (aref (get memory "generations") index)) (steady (get group "steadyState"))
                   (samples (js-call (get memory "checkpoints") :slice (+ (* index 8) 4) (+ (* index 8) 8)))
                   (first (js-object)) (last (js-object)))
              (ensure (and (= (get group "generation") (1+ index)) (= (get group "pid") (aref (get lifecycle "ownedPids") index))
                (= (get group "checkpointCount") 8) (= (get steady "checkpoints") 8) (= (get steady "warmupCheckpoints") 4)
                (= (get steady "allowanceKiB") 16384) (eq (get steady "bounded") t)) "original per-generation trend policy failed")
              (js-call (js-array (js-array "emacs" "emacsKiB") (js-array "worker" "workerKiB")) :forEach (lambda (entry)
                (let* ((key (aref entry 0)) (field-name (aref entry 1))
                       (initial (median (js-call (js-call samples :slice 0 2) :map (lambda (sample) (get sample field-name)))))
                       (final (median (js-call (js-call samples :slice 2) :map (lambda (sample) (get sample field-name))))))
                  (put first key initial) (put last key final)
                  (ensure (and (= (get (get steady "initialMedianKiB") key) initial) (= (get (get steady "finalMedianKiB") key) final)
                    (= (get (get steady "deltaKiB") key) (- final initial)) (<= (- final initial) 16384)) (str "per-generation " key " trend failed")))))
              (js-call medians :push last)) (setq index (1+ index))))
          (let ((trend (get memory "steadyState")))
            (ensure (and (= (field trend "fromGeneration") 1) (= (field trend "toGeneration") 5) (= (field trend "allowanceKiB") 16384) (eq (field trend "bounded") t)) "original total trend policy failed")
            (js-call (js-array "emacs" "worker") :forEach (lambda (key)
              (let ((initial (get (aref medians 0) key)) (final (get (aref medians 4) key)))
                (ensure (and (= (get (get trend "initialMedianKiB") key) initial) (= (get (get trend "finalMedianKiB") key) final)
                  (= (get (get trend "deltaKiB") key) (- final initial)) (<= (- final initial) 16384)) (str "total " key " trend failed")))))))
        (let ((files (field (get current "source") "files")) (old-files (field (get accepted "source") "files")))
          (ensure (and (Array/isArray files) (Array/isArray old-files) (> (js-length files) 0)
            (same (js-call files :map (lambda (entry) (get entry "file"))) (js-call old-files :map (lambda (entry) (get entry "file"))))
            (= (get (new globalThis.Set (js-call files :map (lambda (entry) (get entry "file")))) "size") (js-length files))) "source inventory changed")
          (letfn ((validate-sources (measured)
            (async ()
              (let ((fresh (await (source-manifests root files (when measured (get measured "commit")))))
                    (old (await (source-manifests root old-files revision))))
                (ensure (js-call fresh :includes (get (get current "source") "digest")) "fresh source aggregate is stale")
                (ensure (js-call old :includes (get (get accepted "source") "digest")) "accepted source aggregate differs from its snapshot")))))
            (if (not (eq (get options "deferPerformanceAcceptance") t))
              (progn (await (funcall (validate-sources nil))) t)
              (let ((failure undefined) (fresh false))
                (try (progn (await (funcall (validate-sources nil))) (setq fresh t)) (catch error (setq failure error)))
                (if fresh t
                  (try
                    (let ((measured (retainedPerformanceSnapshot root filename currentBytes)))
                      (await (funcall (validate-sources measured)))
                      (Object/assign (deferredPerformanceAcceptance filename measured)
                        (js-object :currentSourceFailure (js-object :name (get failure "name") :message (get failure "message")))))
                    (catch error (put error :cause failure) (throw error)))))))))))
  (export validateRefreshedWorkerSoak))
