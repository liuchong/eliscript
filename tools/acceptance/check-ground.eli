                             (records-with-fields (get contract :commands) (js-array "id" "argv" "timeoutMs"))))
                  (and (not (nullish? (get report :commands)))
                    (js-call (get report :commands) :some (lambda (command)
                      (not (and (js-call (js-array "pass" "fail") :includes (get command :status))
                        (or (Number/isInteger (get command :exitCode))
                            (and (= (get command :status) "fail") (= (get command :exitCode) nil)
                                 (= (funcall host-typeof (get command :launchError)) "string") (> (get (get command :launchError) :length) 0)))
                        (= (funcall host-typeof (get command :timedOut)) "boolean")
                        (= (funcall host-typeof (get command :durationMs)) "number") (>= (get command :durationMs) 0)
                        (regex-p "^[0-9a-f]{64}$" (get command :outputSha256))))))))
          (js-call errors :push "run command records do not match the corpus contract"))
        (when (or (not (json-equal (records-with-fields (get report :criteria) (js-array "id" "title" "sourceSpec" "probes" "evidence"))
                             (records-with-fields (get contract :criteria) (js-array "id" "title" "sourceSpec" "probes" "evidence"))))
                  (and (not (nullish? (get report :criteria)))
                    (js-call (get report :criteria) :some (lambda (criterion)
                      (or (not (js-call RUN_RESULTS :has (get criterion :result)))
                          (not (js-call (js-array "complete" "partial" "open" "blocked") :includes (get criterion :declaredStatus))))))))
          (js-call errors :push "run criteria do not match the complete corpus contract"))
        (unless (and (Array/isArray (get report :artifacts))
                     (json-equal (js-call (get report :artifacts) :map (lambda (artifact) (get artifact :file))) (artifactNames contract))
                     (js-call (get report :artifacts) :every (lambda (artifact) (regex-p "^[0-9a-f]{64}$" (get artifact :sha256)))))
          (js-call errors :push "run artifact digest inventory is incomplete or invalid"))
        (unless (json-equal (get report :applications) (js-call (get contract :applications) :map (lambda (application) (copyHostRecord application (js-object :result "not-run")))))
          (js-call errors :push "run application results must remain separate and non-contributing"))
        (let* ((counts (if (Array/isArray (get report :criteria)) (countResults (get report :criteria)) (js-object :pass 0 :incomplete 0 :fail 0 :total 0)))
               (operationalSuccess (and (if (nullish? (get report :commands)) undefined (js-call (get report :commands) :every (lambda (command) (= (get command :status) "pass"))))
                                        (= (at source "cleanBefore") t) (= (at source "cleanAfter") t)))
               (expectedSummary (js-object :criteria counts :corpusComplete (= (get counts :total) (get (get contract :criteria) :length)) :operationalSuccess operationalSuccess :acceptancePass (and operationalSuccess (= (get counts :pass) (get counts :total))))))
          (unless (json-equal (get report :summary) expectedSummary) (js-call errors :push "run summary is not derived from recorded results"))))))
  (defasync verifyAcceptanceRun (runFile options)
    (setq options (if (= options undefined) (js-object) options))
    (let* ((root (js-call path :resolve (coalesce (get options :root) DEFAULT_ROOT)))
           (checked (await (checkAcceptanceCorpus (js-object :root root :contract (get options :contract))))) (report (get options :report)) (errors (js-array)))
      (when (nullish? report) (setq report (await (readJson (js-call path :resolve root runFile)))))
      (validateRunShape report checked errors)
      (unless (= (at (get report :corpus) "contractSha256") (sha256 (await (readFile (js-call path :join root CONTRACT_FILE)))))
        (js-call errors :push "run was produced from a different acceptance corpus contract"))
      (when (get options :markdownFile)
        (unless (= (await (readFile (js-call path :resolve root (get options :markdownFile)) "utf8")) (humanRunReport report))
          (js-call errors :push "human report does not match its machine-readable run")))
      (when (> (get errors :length) 0) (throw (new AcceptanceCorpusError errors))) report))
  (defun humanCorpusReport (checked)
    (js-call (js-array (+ "Core acceptance corpus: " (get (get checked :criteria) :length) " mandatory criteria") (+ "Commands: " (js-call (js-call (get (get checked :contract) :commands) :map (lambda (command) (get command :id))) :join ", ")) (+ "Applications: " (get (get checked :applications) :length) " separate non-contributing validations")) :join "\n"))
  (defun humanVerifiedRunReport (report)
    (let* ((summary (get report :summary)) (counts (get summary :criteria)))
      (js-call (js-array (+ "Verified core acceptance run: " (get (get report :source) :commit)) (+ "Criteria: " (get counts :pass) "/" (get counts :total) " pass, " (get counts :incomplete) " incomplete, " (get counts :fail) " fail") (+ "Corpus complete: " (yes-no (get summary :corpusComplete))) (+ "Operational success: " (yes-no (get summary :operationalSuccess))) (+ "Final acceptance: " (if (get summary :acceptancePass) "pass" "not reached"))) :join "\n")))
  (defun parseArguments (argv)
    (let ((options (js-object)) (index 0) (pathKeys (js-object "--json-output" "jsonOutput" "--markdown-output" "markdownOutput" "--verify-run" "verifyRun" "--verify-markdown" "verifyMarkdown")))
      (while (< index (get argv :length))
        (let ((argument (aref argv index)))
          (cond ((= argument "--run") (put options :run t)) ((= argument "--require-pass") (put options :requirePass t)) ((= argument "--json") (put options :json t))
                ((Object/hasOwn pathKeys argument)
                  (let ((value (aref argv (+ index 1))))
                    (unless (funcall host-truth value) (throw (new AcceptanceCorpusError (js-array (+ argument " requires a path")))))
                    (put options (get pathKeys argument) value) (setq index (+ index 1))))
                (t (throw (new AcceptanceCorpusError (js-array (+ "unknown argument " argument)))))))
        (setq index (+ index 1))) options))
  (defasync main ()
    (let* ((options (parseArguments (js-call (get process :argv) :slice 2))) (report undefined) (human undefined))
      (cond ((get options :run)
               (unless (and (get options :jsonOutput) (get options :markdownOutput))
                 (throw (new AcceptanceCorpusError (js-array "--run requires --json-output and --markdown-output"))))
               (setq report (await (runAcceptanceCorpus options)) human (humanRunReport report)))
            ((get options :verifyRun)
               (setq report (await (verifyAcceptanceRun (get options :verifyRun) (js-object :markdownFile (get options :verifyMarkdown))))
                     human (+ (humanVerifiedRunReport report) "\n")))
            (t (let ((checked (await (checkAcceptanceCorpus (js-object)))))
                 (setq report (js-object :format "eliscript-core-acceptance-corpus-report" :version 1 :criteria (get (get checked :criteria) :length) :commands (js-call (get (get checked :contract) :commands) :map (lambda (command) (get command :id))) :applications (get (get checked :applications) :length)) human (+ (humanCorpusReport checked) "\n")))))
      (js-call (get process :stdout) :write (if (get options :json) (+ (JSON/stringify report nil 2) "\n") human))))
  (defasync run-module-entry ()
(when (js* "import.meta.main")
    (try (await (main)) (catch error (js-call (get process :stderr) :write (+ (coalesce (at error "stack") error) "\n")) (put process :exitCode 1)))))
  (js-call (run-module-entry) :catch (lambda (error)
    (js-call (get (js* "globalThis") :console) :error error)
    (put (get (js* "globalThis") :process) :exitCode 1)))
  (export DEFAULT_ROOT AcceptanceCorpusError validateAcceptanceCorpus checkAcceptanceCorpus runAcceptanceCorpus
          humanRunReport verifyAcceptanceRun humanCorpusReport humanVerifiedRunReport))
