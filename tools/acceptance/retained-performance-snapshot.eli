(module tools.acceptance.retained-performance-snapshot
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "node:fs" existsSync mkdirSync mkdtempSync readFileSync readdirSync renameSync rmSync statSync writeFileSync)
  (import "node:path" resolve dirname)
  (import "../backends/build.mjs" :as backend-build)
  (defconst reports (new globalThis.Set (js-array
    "benchmarks/transient-builder-macos-arm64.json" "benchmarks/worker-lifecycle-soak-macos-arm64.json")))
  (defconst immutableGitBytes (new globalThis.Map))
  (defconst immutableStageCapsules (new globalThis.Map))
  (defconst immutableWorkerModules (new globalThis.Map))
  (defconst immutableTransientModules (new globalThis.Map))
  (defconst worker-modules (new globalThis.Set (js-array
    "platform/worker.mjs" "runtime/worker.mjs")))
  (defconst transient-extra-modules (new globalThis.Set (js-array
    "runtime/binding.mjs" "runtime/testing/map.mjs" "runtime/testing/set.mjs" "runtime/testing/vector.mjs"
    "tools/collections/transient-builder-benchmark.mjs" "tools/compiler/controlled-baseline.mjs")))
  (defun transient-module-p (filename)
    (or (js-call transient-extra-modules :has filename)
        (and (js-call filename :startsWith "runtime/core/") (js-call filename :endsWith ".mjs"))))
  (defconst generated-runtime (js-object
    "runtime/core/object-impl.mjs" "stdlib/core/object.eli"
    "runtime/core/protocol-impl.mjs" "stdlib/core/protocol.eli"
    "runtime/core/text-impl.mjs" "stdlib/core/text.eli"))
  (defconst stage-runtime-capsules (new globalThis.Set (js-array
    "runtime/array-text.mjs" "runtime/errors.mjs" "runtime/math.mjs"
    "runtime/number-radix.mjs" "runtime/prelude.mjs" "runtime/primitives.mjs"
    "runtime/unicode-case.mjs" "runtime/unicode-case-data.mjs"
    "runtime/unicode-case-data.eli")))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun git-read (root arguments)
    (spawnSync "git" arguments (js-object :cwd root :encoding nil :maxBuffer 33554432 :timeout 30000)))
  (defun revision-has-legacy-stdlib-core-p (root revision)
    (let ((legacy-core (git-read root (js-array "ls-tree" "-d" "--name-only" revision "stdlib/core"))))
      (and legacy-core
           (= (get legacy-core :status) 0)
           (get legacy-core :stdout)
           (> (js-length (get legacy-core :stdout)) 0))))
  (defun checked-output (result)
    (unless (and (= (get result :status) 0) (not (get result :error)))
      (throw (new globalThis.Error "retained performance snapshot: measured Git snapshot is unavailable")))
    (get result :stdout))
  (defun capsule-bytes (bytes)
    ;; Decode source data only. Never evaluate archived JavaScript or accept a
    ;; non-capsule as a substitute for the measured generated artifact.
    (let* ((text (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode bytes))
           (match (js-call (new globalThis.RegExp
             "^\\(module [a-zA-Z0-9_.-]+\\s+\\(js\\* (\"(?:[^\"\\\\]|\\\\[\\s\\S])*\")\\)\\s*\\)\\s*$") :exec text)))
      (when match (globalThis.Buffer.from (JSON/parse (aref match 1)) "utf8"))))

  (defconst immutableRuntimeModules (new globalThis.Map))
  (defconst historicalLockSleepState (new globalThis.Int32Array (new globalThis.SharedArrayBuffer 4)))
  (defvar historicalScriptDigestCache undefined)

  (defun historical-script-digest (project-root)
    (when (undefined? historicalScriptDigestCache)
      (setq historicalScriptDigestCache
        (js-call (digest (readFileSync (resolve project-root "tools/acceptance/compile-historical-runtime.el"))) :slice 0 16)))
    historicalScriptDigestCache)

  (defun acquire-historical-cache-lock (cache-dir)
    (let ((lock-dir (str cache-dir ".lock"))
          (ready-file (resolve cache-dir "READY"))
          (deadline (+ (Date/now) 240000))
          (acquired false))
      (mkdirSync (resolve cache-dir "..") (js-object :recursive t))
      (while (and (not acquired) (not (existsSync ready-file)))
        (try
          (mkdirSync lock-dir)
          (setq acquired t)
          (catch error
            (if (= (get error :code) "EEXIST")
              (progn
                (try
                  (let ((info (statSync lock-dir)))
                    (when (> (- (Date/now) (get info :mtimeMs)) 240000)
                      (rmSync lock-dir (js-object :recursive t :force t))))
                  (catch _ nil))
                (unless (existsSync ready-file)
                  (when (>= (Date/now) deadline)
                    (throw error))
                  (js-call globalThis.Atomics :wait historicalLockSleepState 0 0 100)))
              (throw error)))))
      acquired))

  (defun read-historical-cache-map (cache-dir)
    (try
      (let* ((manifest (JSON/parse (readFileSync (resolve cache-dir "manifest.json") "utf8")))
             (table (new globalThis.Map))
             (i 0))
        (while (< i (js-length manifest))
          (let* ((entry (aref manifest i))
                 (key (aref entry 0))
                 (rel (aref entry 1)))
            (js-call table :set key
              (globalThis.Uint8Array.from (readFileSync (resolve cache-dir "files" rel)))))
          (setq i (1+ i)))
        table)
      (catch _ undefined)))

  (defun write-historical-cache-map (cache-dir table)
    (unless (existsSync (resolve cache-dir "READY"))
      (let ((tmp-dir (str cache-dir ".tmp." (get globalThis.process :pid) "." (Math/floor (* (Math/random) 1000000000)))))
        (try
          (let ((files-dir (resolve tmp-dir "files"))
                (manifest (js-array))
                (entries (js-call globalThis.Array :from (js-call table :entries)))
                (i 0))
            (mkdirSync files-dir (js-object :recursive t))
            (while (< i (js-length entries))
              (let* ((pair (aref entries i))
                     (key (aref pair 0))
                     (bytes (aref pair 1))
                     (rel (str i ".bin")))
                (writeFileSync (resolve files-dir rel) bytes)
                (js-call manifest :push (js-array key rel)))
              (setq i (1+ i)))
            (writeFileSync (resolve tmp-dir "manifest.json") (JSON/stringify manifest))
            (writeFileSync (resolve tmp-dir "READY") "ok\n")
            (mkdirSync (resolve cache-dir "..") (js-object :recursive t))
            (renameSync tmp-dir cache-dir))
          (catch _
            (try (rmSync tmp-dir (js-object :recursive t :force t)) (catch _ nil)))))))

  (defun load-or-build-historical-table (project-root memory-cache memory-key disk-cache-name scratch-prefix build-fn)
    (unless (js-call memory-cache :has memory-key)
      (let* ((base (resolve project-root ".eliscript-cache/historical-source"))
             (cache-dir (resolve base (str disk-cache-name "-" (historical-script-digest project-root))))
             (loaded (when (existsSync (resolve cache-dir "READY")) (read-historical-cache-map cache-dir))))
        (if loaded
          (js-call memory-cache :set memory-key loaded)
          (let ((lock-held (acquire-historical-cache-lock cache-dir)))
            (try
              (progn
                (when (existsSync (resolve cache-dir "READY"))
                  (setq loaded (read-historical-cache-map cache-dir)))
                (if loaded
                  (js-call memory-cache :set memory-key loaded)
                  (let* ((_ (mkdirSync base (js-object :recursive t)))
                         (scratch (mkdtempSync (resolve base scratch-prefix)))
                         (compiled (new globalThis.Map)))
                    (try
                      (progn
                        (funcall build-fn scratch compiled)
                        (write-historical-cache-map cache-dir compiled)
                        (js-call memory-cache :set memory-key compiled))
                      (finally (rmSync scratch (js-object :recursive t :force t)))))))
              (finally
                (when lock-held
                  (try (rmSync (str cache-dir ".lock") (js-object :recursive t :force t)) (catch _ nil)))))))))
    (js-call memory-cache :get memory-key))

  (defun compile-historical-runtime (root revision filename)
    (let* ((tree (js-call (js-call (new globalThis.TextDecoder) :decode
                  (checked-output (git-read root (js-array "rev-parse" "--verify" (str revision "^{tree}"))))) :trim))
           (memory-key (str tree ":" filename))
           (project-root (get backend-build :root))
           (table (load-or-build-historical-table project-root immutableRuntimeModules memory-key
                    (str "runtime-" tree "-" (js-call (digest filename) :slice 0 12))
                    "build-"
                    (lambda (scratch compiled)
                      (let ((archive (resolve scratch "source.tar"))
                            (output (resolve scratch filename)))
                        (writeFileSync archive (checked-output (git-read root
                          (js-array "archive" "--format=tar" revision "compiler" "stdlib/core"))))
                        (checked-output (spawnSync "tar" (js-array "-xf" archive "-C" scratch)
                          (js-object :encoding nil :timeout 30000)))
                        (mkdirSync (dirname output) (js-object :recursive t))
                        (checked-output (spawnSync (or (get (get globalThis.process :env) :EMACS) "emacs")
                          (js-array "--batch" "-Q" "--script"
                            (resolve project-root "tools/acceptance/compile-historical-runtime.el")
                            scratch (get generated-runtime filename) output)
                          (js-object :cwd scratch :encoding nil :timeout 60000 :maxBuffer 1048576)))
                        (js-call compiled :set filename (globalThis.Uint8Array.from (readFileSync output))))))))
      (js-call (js-call table :get filename) :slice)))

  (defun compile-historical-stage-capsules (root revision filename)
    (let* ((tree (js-call (js-call (new globalThis.TextDecoder) :decode
                  (checked-output (git-read root (js-array "rev-parse" "--verify" (str revision "^{tree}"))))) :trim))
           (project-root (get backend-build :root))
           (table (load-or-build-historical-table project-root immutableStageCapsules tree
                    (str "stage-capsules-" tree)
                    "stage-"
                    (lambda (scratch compiled)
                      (let ((archive (resolve scratch "source.tar")))
                        (writeFileSync archive (checked-output (git-read root
                          (js-array "archive" "--format=tar" revision
                            "package.json" "compiler" "bootstrap/compiler"
                            "bootstrap/runtime/memory.eli" "runtime" "tools/runtime/unicode-case-runtime.el"))))
                        (checked-output (spawnSync "tar" (js-array "-xf" archive "-C" scratch)
                          (js-object :encoding nil :timeout 30000)))
                        (checked-output (spawnSync (or (get (get globalThis.process :env) :EMACS) "emacs")
                          (js-array "--batch" "-Q" "--script"
                            (resolve project-root "tools/acceptance/compile-historical-runtime.el")
                            scratch "--stage-runtime-capsules")
                          (js-object :cwd scratch :encoding nil :timeout 120000 :maxBuffer 4194304)))
                        (checked-output (spawnSync (get globalThis.process :execPath)
                          (js-array (resolve scratch "emit-stage-capsules.mjs"))
                          (js-object :cwd scratch :encoding nil :timeout 60000 :maxBuffer 4194304)))
                        (js-call stage-runtime-capsules :forEach (lambda (item)
                          (if (= item "runtime/unicode-case-data.eli")
                            (js-call compiled :set item
                              (globalThis.Uint8Array.from (readFileSync (resolve scratch item))))
                            (let ((name (js-call item :slice (js-length "runtime/"))))
                              (js-call compiled :set item
                                (globalThis.Uint8Array.from (readFileSync (resolve scratch "stage2-runtime" name)))))))))))))
      (when (and table (js-call table :has filename))
        (js-call (js-call table :get filename) :slice))))

  (defun compile-historical-transient-modules (root revision filename)
    (let* ((tree (js-call (js-call (new globalThis.TextDecoder) :decode
                  (checked-output (git-read root (js-array "rev-parse" "--verify" (str revision "^{tree}"))))) :trim))
           (project-root (get backend-build :root))
           (table (load-or-build-historical-table project-root immutableTransientModules tree
                    (str "transient-modules-" tree)
                    "transient-"
                    (lambda (scratch compiled)
                      (let ((archive (resolve scratch "source.tar")))
                        (writeFileSync
                          archive
                          (checked-output
                            (git-read
                              root
                              (if (revision-has-legacy-stdlib-core-p root revision)
                                (js-array "archive" "--format=tar" revision "compiler" "stdlib/core" "runtime" "tools")
                                (js-array "archive" "--format=tar" revision "compiler" "runtime" "tools")))))
                        (checked-output (spawnSync "tar" (js-array "-xf" archive "-C" scratch)
                          (js-object :encoding nil :timeout 30000)))
                        (checked-output (spawnSync (or (get (get globalThis.process :env) :EMACS) "emacs")
                          (js-array "--batch" "-Q" "--script"
                            (resolve project-root "tools/acceptance/compile-historical-runtime.el")
                            scratch "--transient-modules")
                          (js-object :cwd scratch :encoding nil :timeout 180000 :maxBuffer 4194304)))
                        (js-call transient-extra-modules :forEach (lambda (item)
                          (let ((built (resolve scratch item)))
                            (try (js-call compiled :set item (globalThis.Uint8Array.from (readFileSync built)))
                              (catch _ignored nil)))))
                        (let ((core-names (js-call (js-call (js-call (new globalThis.TextDecoder) :decode
                                            (checked-output (git-read root (js-array "ls-tree" "-r" "--name-only" revision "runtime/core")))) :trim) :split "\n")))
                          (js-call core-names :forEach (lambda (name)
                            (when (js-call name :endsWith ".eli")
                              (let* ((out (str (js-call name :slice 0 -4) ".mjs"))
                                     (built (resolve scratch out)))
                                (try (js-call compiled :set out (globalThis.Uint8Array.from (readFileSync built)))
                                  (catch _ignored nil))))))
                          (js-call (Object/keys generated-runtime) :forEach (lambda (out)
                            (let ((built (resolve scratch out)))
                              (try (js-call compiled :set out (globalThis.Uint8Array.from (readFileSync built)))
                                (catch _ignored nil)))))))))))
      (when (and table (js-call table :has filename))
        (js-call (js-call table :get filename) :slice))))

  (defun compile-historical-worker-modules (root revision filename)
    ;; Two published worker entries are ordinary maintained modules whose
    ;; generated bytes are not Git blobs at the measured revision. Reproduce
    ;; them from that revision's real compiler and sources in one isolated
    ;; tree. They are intentionally not part of generated-runtime, whose keys
    ;; are merged into the retained runtime/core inventory.
    (let* ((tree (js-call (js-call (new globalThis.TextDecoder) :decode
                  (checked-output (git-read root (js-array "rev-parse" "--verify" (str revision "^{tree}"))))) :trim))
           (project-root (get backend-build :root))
           (table (load-or-build-historical-table project-root immutableWorkerModules tree
                    (str "worker-modules-" tree)
                    "workers-"
                    (lambda (scratch compiled)
                      (let ((archive (resolve scratch "source.tar")))
                        (writeFileSync archive (checked-output (git-read root
                          (js-array "archive" "--format=tar" revision
                            "compiler" "platform" "runtime"))))
                        (checked-output (spawnSync "tar" (js-array "-xf" archive "-C" scratch)
                          (js-object :encoding nil :timeout 30000)))
                        (checked-output (spawnSync (or (get (get globalThis.process :env) :EMACS) "emacs")
                          (js-array "--batch" "-Q" "--script"
                            (resolve project-root "tools/acceptance/compile-historical-runtime.el")
                            scratch "--worker-modules")
                          (js-object :cwd scratch :encoding nil :timeout 120000 :maxBuffer 4194304)))
                        (js-call worker-modules :forEach (lambda (item)
                          (js-call compiled :set item
                            (globalThis.Uint8Array.from (readFileSync (resolve scratch item)))))))))))
      (when (and table (js-call table :has filename))
        (js-call (js-call table :get filename) :slice))))
  (defun retainedGitSnapshotBytes (root arguments)
    (unless (js-call (js-array "show" "rev-parse" "log" "ls-tree") :includes (aref arguments 0))
      (throw (new globalThis.Error "retained performance snapshot: unsupported Git read")))
    (let* ((immutable (and (/= (aref arguments 0) "log")
              (js-call arguments :some (lambda (arg)
                (js-call (new globalThis.RegExp "^[0-9a-f]{40}(?::|\\^\\{tree\\}$)") :test arg)))))
           (key (JSON/stringify (js-array root arguments))))
      (if (and immutable (js-call immutableGitBytes :has key))
        (js-call (js-call immutableGitBytes :get key) :slice)
        (let* ((result (git-read root arguments)) (bytes (get result :stdout)))
          (unless (= (get result :status) 0)
            (let ((match (when (and (= (aref arguments 0) "show") (= (js-length arguments) 2))
              (js-call (new globalThis.RegExp "^([0-9a-f]{40}):([^\\\\]+[.](?:mjs|eli))$") :exec (aref arguments 1)))))
              (unless (and match (not (js-call (js-call (aref match 2) :split "/") :includes "..")))
                (checked-output result))
              (let* ((revision (aref match 1)) (filename (aref match 2))
                     (source (when (js-call filename :endsWith ".mjs")
                               (git-read root (js-array "show" (str revision ":" (js-call filename :slice 0 -4) ".eli"))))))
                (setq bytes (when (and source (= (get source :status) 0)) (capsule-bytes (get source :stdout))))
                (when (and (not bytes)
                           (Object/hasOwn generated-runtime filename)
                           (revision-has-legacy-stdlib-core-p root revision))
                  (setq bytes (compile-historical-runtime root revision filename)))
                (when (and (not bytes) (js-call stage-runtime-capsules :has filename))
                  (setq bytes (compile-historical-stage-capsules root revision filename)))
                (when (and (not bytes) (transient-module-p filename))
                  (setq bytes (compile-historical-transient-modules root revision filename)))
                (when (and (not bytes) (js-call worker-modules :has filename))
                  (setq bytes (compile-historical-worker-modules root revision filename)))
                (unless bytes (checked-output result)))))
          ;; The caller still checks every measured hash/aggregate. A source
          ;; representation change never grants performance acceptance.
          (when immutable (js-call immutableGitBytes :set key (globalThis.Uint8Array.from bytes)))
          (globalThis.Uint8Array.from bytes)))))
  (defun retainedPerformanceSnapshot (root filename bytes)
    (unless (js-call reports :has filename)
      (throw (new globalThis.Error "retained performance snapshot: unsupported report")))
    ;; A restoration must not reattribute an old measurement to today's source
    ;; tree. Find the original introduction of these exact recorded bytes.
    (let* ((history (js-call (js-call (js-call (new globalThis.TextDecoder) :decode
                     (retainedGitSnapshotBytes root (js-array "log" "--reverse" "--format=%H" "--" filename))) :trim) :split "\n"))
           (artifactSha256 (digest bytes)) (commit undefined) (index 0))
      (while (and (< index (js-length history)) (undefined? commit))
        (let* ((revision (aref history index))
               (candidate (git-read root (js-array "show" (str revision ":" filename)))))
          (when (and (= (get candidate :status) 0) (= (digest (get candidate :stdout)) artifactSha256))
            (setq commit revision)))
        (setq index (1+ index)))
      (when (and (undefined? commit) (> (js-length history) 0) (/= (aref history 0) ""))
        (throw (new globalThis.Error "retained performance snapshot: report bytes differ from their measured Git snapshot")))
      (unless (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test commit)
        (throw (new globalThis.Error "retained performance snapshot: measured commit is unavailable")))
      (unless (= (digest (retainedGitSnapshotBytes root (js-array "show" (str commit ":" filename)))) artifactSha256)
        (throw (new globalThis.Error "retained performance snapshot: report bytes differ from their measured Git snapshot")))
      (let ((tree (js-call (js-call (new globalThis.TextDecoder) :decode
                    (retainedGitSnapshotBytes root (js-array "rev-parse" (str commit "^{tree}")))) :trim)))
        (unless (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test tree)
          (throw (new globalThis.Error "retained performance snapshot: measured tree is unavailable")))
        (js-object :commit commit :tree tree :artifactSha256 artifactSha256))))
  (defun retainedRuntimeSourceFiles (root revision)
    (let* ((names (js-call (js-call (js-call (new globalThis.TextDecoder) :decode
                   (retainedGitSnapshotBytes root (js-array "ls-tree" "-r" "--name-only" revision "runtime/core"))) :trim) :split "\n"))
           (outputs (new globalThis.Set)))
      ;; Inventory logical outputs from actual files in the pinned tree.
      ;; Their contents are independently reproduced and hash-checked below.
      (js-call names :forEach (lambda (name)
        (cond ((js-call name :endsWith ".mjs") (js-call outputs :add name))
              ((js-call name :endsWith ".eli") (js-call outputs :add (str (js-call name :slice 0 -4) ".mjs"))))))
      (js-call (Object/entries generated-runtime) :forEach (lambda (entry)
        (when (= (get (git-read root (js-array "show" (str revision ":" (aref entry 1)))) :status) 0)
          (js-call outputs :add (aref entry 0)))))
      (js-call (Array/from outputs) :sort)))
  (defun deferredPerformanceAcceptance (report measuredSource)
    (js-object :report report :historicalSourcesVerified t :currentSourceAcceptance "deferred"
      :performanceAccepted false :measuredSource measuredSource))
  (export retainedGitSnapshotBytes retainedPerformanceSnapshot retainedRuntimeSourceFiles deferredPerformanceAcceptance))
