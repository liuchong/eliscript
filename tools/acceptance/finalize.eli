(module tools.acceptance.finalize
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdir readFile stat writeFile)
  (import "node:path" :as path)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath)
  (import "./check.mjs" verifyAcceptanceRun)
  (import "./retained-soak.mjs" validateRefreshedWorkerSoak)
  (import "./retained-transient.mjs" validateRefreshedTransientBuilder)
  (import "./retained-performance-snapshot.mjs" retainedGitSnapshotBytes)
  (import "./finalize-legacy.mjs" :as legacy)

  (defconst DEFAULT_ROOT (js-call path :resolve
    (js-call path :dirname (fileURLToPath (js* "import.meta.url"))) "../.."))
  (defconst FinalAcceptanceError (get legacy :FinalAcceptanceError))
  (defconst validateDefectRegister (get legacy :validateDefectRegister))
  (defconst humanFinalAcceptanceReport (get legacy :humanFinalAcceptanceReport))
  (defconst validateFinalManifest (get legacy :validateFinalManifest))
  (defconst humanFinalAcceptanceSummary (get legacy :humanFinalAcceptanceSummary))
  (defconst contract-file "contracts/final-acceptance.json")
  (defconst fuzz-file "tests/reader-program-fuzz.test.mjs")
  (defconst expected-source (js-object :run "acceptance/runs/m13-01.json" :report "acceptance/runs/m13-01.md"))
  (defconst expected-outputs (js-object :manifest "acceptance/manifest.json" :report "acceptance/report.md"))
  (defconst expected-groups (js-array "benchmark" "fuzz" "scale" "soak" "test"))
  (defconst revision-pattern (new globalThis.RegExp "^[0-9a-f]{40}$"))
  (defconst digest-pattern (new globalThis.RegExp "^[0-9a-f]{64}$"))
  (defun fail (message) (throw (new FinalAcceptanceError (js-array message))))
  (defun field (object key &rest defaults)
    (if (nullish? object) (aref defaults 0) (get object key (aref defaults 0))))
  (defun call-options (arguments)
    (if (undefined? (aref arguments 0)) (js-object) (aref arguments 0)))
  (defun nullish (value fallback) (if (nullish? value) fallback value))
  (defun plain-object (value)
    (and (not (nullish? value)) (= (value-type value) "object") (not (Array/isArray value))))
  (defun same (left right) (= (JSON/stringify left) (JSON/stringify right)))
  (defun sha256 (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun safe-relative (value)
    (and (= (value-type value) "string") (> (js-length value) 0)
      (not (js-call path :isAbsolute value))
      (not (js-call (js-call value :split "/") :includes ".."))
      (= (js-call (get path :posix) :normalize value) value)))
  (defun sorted-strings (values)
    (and (Array/isArray values) (> (js-length values) 0)
      (js-call values :every (lambda (value) (and (= (value-type value) "string") (> (js-length value) 0))))
      (= (get (new globalThis.Set values) :size) (js-length values))
      (same values (js-call (js-call values :slice) :sort))))
  (defasync read-json (root file) (JSON/parse (await (readFile (js-call path :join root file) "utf8"))))
  (defasync regular-file (root file)
    (try (js-call (await (stat (js-call path :join root file))) :isFile)
      (catch error false)))
  (defun git-text (root arguments)
    (js-call (new globalThis.TextDecoder) :decode (retainedGitSnapshotBytes root arguments)))

  ;; This authenticates the original source run only. It never certifies the
  ;; current fuzz implementation, changes its digest, or executes its workload.
  (defasync verifyHistoricalFuzzArtifact (root filename run)
    (unless (= filename fuzz-file) (fail "only the retained reader/program fuzz artifact has historical source authentication"))
    (let* ((source (field run "source")) (commit (field source "commit")) (tree (field source "tree"))
           (artifacts (field run "artifacts")))
      (unless (and (= (value-type commit) "string") (js-call revision-pattern :test commit)
                   (= (value-type tree) "string") (js-call revision-pattern :test tree))
        (fail "historical fuzz source must identify a full Git commit and tree"))
      (unless (Array/isArray artifacts) (fail "historical fuzz artifact inventory is missing"))
      (let* ((bound (js-call artifacts :filter (lambda (entry) (= (field entry "file") filename))))
             (digest (field (aref bound 0) "sha256")))
        (unless (and (= (js-length bound) 1) (= (value-type digest) "string") (js-call digest-pattern :test digest))
          (fail "historical fuzz artifact must be uniquely bound by the source run"))
        (try
          (unless (= (js-call (git-text root (js-array "rev-parse" (str commit "^{tree}"))) :trim) tree)
            (fail "historical fuzz source tree does not belong to its source commit"))
          (unless (= (sha256 (retainedGitSnapshotBytes root (js-array "show" (str commit ":" filename)))) digest)
            (fail "historical fuzz artifact differs from its accepted Git snapshot"))
          (catch error
            (if (js-call (get FinalAcceptanceError :prototype) :isPrototypeOf error) (throw error)
              (fail (str "historical fuzz Git source authentication failed: " (get error :message))))))
        (js-object :artifact filename :artifactSha256 digest :sourceCommit commit :sourceTree tree
          :historicalSourcesVerified t :currentSourceAcceptance "not-asserted" :currentSourceClaim false))))

  (defun record-refresh (options result)
    (let ((items (get options :deferredPerformanceAcceptance)))
      (when (and (not (eq result t)) (Array/isArray items)
             (not (js-call items :some (lambda (item) (= (get item :report) (get result :report))))))
        (js-call items :push result))))
  (defun record-history (options result)
    (let ((items (get options :historicalSourceEvidence)))
      (when (and (Array/isArray items)
             (not (js-call items :some (lambda (item) (= (get item :artifact) (get result :artifact))))))
        (js-call items :push result))))

  (defasync validateFinalAcceptanceContract (contract run &rest arguments)
    (let* ((options (call-options arguments)) (root (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (errors (js-array)))
      (unless (and (plain-object contract) (= (get contract :schemaVersion) 1)
                   (= (get contract :format) "eliscript-final-acceptance-contract") (= (get contract :version) 1))
        (fail "contract must use eliscript-final-acceptance-contract version 1"))
      (unless (same (get contract :source) expected-source)
        (js-call errors :push "contract source must identify the retained core run and report"))
      (unless (= (get contract :defects) "acceptance/defects.json")
        (js-call errors :push "contract defects must identify acceptance/defects.json"))
      (unless (same (get contract :outputs) expected-outputs)
        (js-call errors :push "contract outputs must be the canonical acceptance artifacts"))
      (unless (same (get contract :blockingSeverities) (js-array 1 2))
        (js-call errors :push "blocking severities must be exactly 1 and 2"))
      (let* ((groups (if (Array/isArray (get contract :evidenceGroups)) (get contract :evidenceGroups) (js-array)))
             (criterion-ids (new globalThis.Set (js-call (get run :criteria) :map (lambda (criterion) (get criterion :id)))))
             (artifacts (new globalThis.Map (js-call (get run :artifacts) :map
                          (lambda (artifact) (js-array (get artifact :file) (get artifact :sha256))))))
             (index 0))
        (unless (same (js-call groups :map (lambda (group) (field group "id"))) expected-groups)
          (js-call errors :push "evidence groups must be exactly benchmark fuzz scale soak and test"))
        (while (< index (js-length groups))
          (let* ((group (aref groups index)) (label (nullish (field group "id") (str "evidence group " index))))
            (if (not (and (plain-object group) (sorted-strings (get group :criteria)) (sorted-strings (get group :artifacts))))
              (js-call errors :push (str label " must declare sorted unique criteria and artifacts"))
              (progn
                (when (and (js-call (get group :criteria) :includes "*") (not (same (get group :criteria) (js-array "*"))))
                  (js-call errors :push (str label " wildcard criterion must be the only criterion")))
                (js-call (get group :criteria) :forEach (lambda (id)
                  (when (and (/= id "*") (not (js-call criterion-ids :has id)))
                    (js-call errors :push (str label " references unknown criterion " id)))))
                (let ((files (get group :artifacts)) (file-index 0))
                  (while (< file-index (js-length files))
                    (let ((file (aref files file-index)))
                      (cond
                        ((not (safe-relative file))
                          (js-call errors :push (str label " has unsafe artifact path " (JSON/stringify file))))
                        ((not (js-call artifacts :has file))
                          (js-call errors :push (str label " artifact is not bound by the source run: " file)))
                        ((not (await (regular-file root file)))
                          (js-call errors :push (str label " artifact is missing: " file)))
                        (t
                          (let ((bytes (await (readFile (js-call path :join root file)))))
                            (unless (= (sha256 bytes) (js-call artifacts :get file))
                              (let ((refresh-options (js-object :deferPerformanceAcceptance (eq (get options :deferPerformanceAcceptance) t))))
                                (cond
                                  ((= file "benchmarks/worker-lifecycle-soak-macos-arm64.json")
                                    (try (record-refresh options (await (validateRefreshedWorkerSoak root file bytes run refresh-options)))
                                      (catch error (js-call errors :push (str label " artifact changed after the source run: " file ": " (get error :message))))))
                                  ((= file "benchmarks/transient-builder-macos-arm64.json")
                                    (try (record-refresh options (await (validateRefreshedTransientBuilder root file bytes run refresh-options)))
                                      (catch error (js-call errors :push (str label " artifact changed after the source run: " file ": " (get error :message))))))
                                  ((and (= file fuzz-file) (eq (get options :deferPerformanceAcceptance) t))
                                    (try (record-history options (await (verifyHistoricalFuzzArtifact root file run)))
                                      (catch error (js-call errors :push (str label " artifact changed after the source run: " file ": " (get error :message))))))
                                  (t (js-call errors :push (str label " artifact changed after the source run: " file))))))))))
                    (setq file-index (1+ file-index)))))))
          (setq index (1+ index))))
      (when (> (js-length errors) 0) (throw (new FinalAcceptanceError errors)))
      contract))

  (defun result-counts (criteria)
    (let ((result (js-object :pass 0 :incomplete 0 :fail 0 :total (js-length criteria))))
      (js-call criteria :forEach (lambda (criterion)
        (let ((key (get criterion :result))) (put result key (1+ (get result key))))))
      result))
  (defun evidence-records (contract run)
    (let* ((all (js-call (get run :criteria) :map (lambda (criterion) (get criterion :id))))
           (criteria (new globalThis.Map (js-call (get run :criteria) :map
                       (lambda (criterion) (js-array (get criterion :id) (get criterion :result))))))
           (artifacts (new globalThis.Map (js-call (get run :artifacts) :map
                        (lambda (artifact) (js-array (get artifact :file) (get artifact :sha256)))))))
      (js-call (get contract :evidenceGroups) :map (lambda (group)
        (let ((ids (if (same (get group :criteria) (js-array "*")) all (get group :criteria))))
          (js-object :id (get group :id) :complete t
            :criteria (js-call ids :map (lambda (id) (js-object :id id :result (js-call criteria :get id))))
            :artifacts (js-call (get group :artifacts) :map
              (lambda (file) (js-object :file file :sha256 (js-call artifacts :get file))))))))))

  (defasync buildFinalAcceptance (&rest arguments)
    (let* ((options (call-options arguments)) (root (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract)) (await (read-json root contract-file)) (get options :contract)))
           (run (if (nullish? (get options :run))
             (await (verifyAcceptanceRun (get (get contract :source) :run)
               (js-object :root root :markdownFile (get (get contract :source) :report)))) (get options :run))))
      (await (validateFinalAcceptanceContract contract run (js-object :root root
        :deferPerformanceAcceptance (eq (get options :deferPerformanceAcceptance) t)
        :deferredPerformanceAcceptance (get options :deferredPerformanceAcceptance)
        :historicalSourceEvidence (get options :historicalSourceEvidence))))
      (let* ((defects (await (validateDefectRegister
               (if (nullish? (get options :defects)) (await (read-json root (get contract :defects))) (get options :defects))
               (js-object :root root))))
             (run-bytes (await (readFile (js-call path :join root (get (get contract :source) :run)))))
             (report-bytes (await (readFile (js-call path :join root (get (get contract :source) :report)))))
             (defect-bytes (if (get options :defects) (js-call Buffer :from (str (JSON/stringify defects nil 2) "\n"))
                            (await (readFile (js-call path :join root (get contract :defects))))))
             (evidence (evidence-records contract run))
             (contract-bytes (await (readFile (js-call path :join root contract-file))))
             (blocking (js-length (js-call (get defects :unresolved) :filter
                         (lambda (defect) (js-call (get contract :blockingSeverities) :includes (get defect :severity))))))
             (complete (js-call evidence :every (lambda (group) (get group :complete))))
             (counts (result-counts (get run :criteria))))
        (js-object :schemaVersion 1 :format "eliscript-1.0-acceptance-manifest" :version 1
          :generatedAt (get run :generatedAt) :source (get run :source) :environment (get run :environment)
          :contract (js-object :file contract-file :sha256 (sha256 contract-bytes))
          :sourceRun (js-object :json (get (get contract :source) :run) :jsonSha256 (sha256 run-bytes)
            :markdown (get (get contract :source) :report) :markdownSha256 (sha256 report-bytes))
          :commands (get run :commands) :criteria (get run :criteria) :artifacts (get run :artifacts) :evidence evidence
          :defects (js-object :register (get contract :defects) :registerSha256 (sha256 defect-bytes)
            :blockingSeverities (get contract :blockingSeverities) :unresolved (get defects :unresolved) :blockingCount blocking)
          :applications (get run :applications)
          :summary (js-object :criteria counts :corpusComplete (get (get run :summary) :corpusComplete)
            :operationalSuccess (get (get run :summary) :operationalSuccess) :evidenceComplete complete :blockingDefects blocking
            :acceptancePass (and (get (get run :summary) :acceptancePass) complete (= blocking 0)))))))

  (defasync generateFinalAcceptance (&rest arguments)
    (let* ((options (call-options arguments)) (root (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT))))
      (when (eq (get options :deferPerformanceAcceptance) t)
        (fail "cannot generate acceptance artifacts while current performance acceptance is deferred"))
      (let* ((contract (if (nullish? (get options :contract)) (await (read-json root contract-file)) (get options :contract)))
             (manifest (await (buildFinalAcceptance (Object/assign (js-object) options (js-object :root root :contract contract))))))
        (await (mkdir (js-call path :dirname (js-call path :join root (get (get contract :outputs) :manifest)))
          (js-object :recursive t)))
        (await (writeFile (js-call path :join root (get (get contract :outputs) :manifest)) (str (JSON/stringify manifest nil 2) "\n")))
        (await (writeFile (js-call path :join root (get (get contract :outputs) :report)) (humanFinalAcceptanceReport manifest)))
        manifest)))
  (defasync verifyFinalAcceptance (&rest arguments)
    (let* ((options (call-options arguments)) (root (js-call path :resolve (nullish (get options :root) DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract)) (await (read-json root contract-file)) (get options :contract)))
           (expected (await (buildFinalAcceptance (Object/assign (js-object) options (js-object :root root :contract contract)))))
           (manifest (if (nullish? (get options :manifest)) (await (read-json root (get (get contract :outputs) :manifest))) (get options :manifest)))
           (markdown (if (nullish? (get options :markdown))
                       (await (readFile (js-call path :join root (get (get contract :outputs) :report)) "utf8")) (get options :markdown))))
      (validateFinalManifest manifest expected)
      (unless (= markdown (humanFinalAcceptanceReport manifest))
        (fail "human acceptance report does not match the machine-readable manifest"))
      (when (and (get options :requirePass) (not (get (get manifest :summary) :acceptancePass)))
        (fail "the canonical artifacts are valid, but final acceptance has not been reached"))
      (when (and (get options :requirePass) (eq (get options :deferPerformanceAcceptance) t))
        (fail "current performance acceptance is deferred and has not passed"))
      manifest))

  (defun parse-arguments (arguments)
    (let ((options (js-object)) (index 0))
      (while (< index (js-length arguments))
        (let ((argument (aref arguments index)))
          (cond ((= argument "--generate") (put options :generate t))
                ((= argument "--verify") (put options :verify t))
                ((= argument "--require-pass") (put options :requirePass t))
                (t (fail (str "unknown argument " argument)))))
        (setq index (1+ index)))
      (when (eq (get options :generate) (get options :verify)) (fail "choose exactly one of --generate or --verify"))
      options))
  (defasync main ()
    (let* ((options (parse-arguments (js-call (get process :argv) :slice 2)))
           (deferred (= (get (get process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")))
      (put options :deferPerformanceAcceptance deferred)
      (put options :deferredPerformanceAcceptance (js-array))
      (put options :historicalSourceEvidence (js-array))
      (let* ((manifest (if (get options :generate) (await (generateFinalAcceptance options)) (await (verifyFinalAcceptance options))))
             (summary (humanFinalAcceptanceSummary manifest)))
        (js-call (get process :stdout) :write (str (if deferred
          (js-call summary :replace (new globalThis.RegExp "^Final acceptance:" "mu") "Historical final acceptance:") summary) "\n"))
        (when deferred
          (js-call (get process :stdout) :write "Current performance acceptance: DEFERRED / NOT ACCEPTED\n")
          (js-call (get options :deferredPerformanceAcceptance) :forEach (lambda (item)
            (js-call (get process :stdout) :write (str "  " (get item :report) ": measured Git snapshot "
              (get (get item :measuredSource) :commit) " verified; current source comparison not performed\n"))))
          (js-call (get options :historicalSourceEvidence) :forEach (lambda (item)
            (js-call (get process :stdout) :write (str "Historical fuzz source: " (get item :artifact) " at "
              (get item :sourceCommit) " verified; current fuzz acceptance is provided by the independent complete functional run\n")))))
        (when (and (get options :requirePass) (not (get (get manifest :summary) :acceptancePass)))
          (fail "the canonical artifacts are valid, but final acceptance has not been reached")))))
  (when (js* "import.meta.main")
    (js-call (main) :catch (lambda (error)
      (js-call (get process :stderr) :write (str (nullish (get error :stack) error) "\n"))
      (put process :exitCode 1))))
  (export DEFAULT_ROOT FinalAcceptanceError validateFinalAcceptanceContract verifyHistoricalFuzzArtifact
    validateDefectRegister buildFinalAcceptance humanFinalAcceptanceReport validateFinalManifest
    generateFinalAcceptance verifyFinalAcceptance humanFinalAcceptanceSummary))
