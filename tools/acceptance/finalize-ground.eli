(module tools.acceptance.finalize-ground
  (import "node:crypto" createHash)
  (import "node:fs/promises" mkdir readFile stat writeFile)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)
  (import "./check.mjs" verifyAcceptanceRun)
  (import "./retained-soak.mjs" validateRefreshedWorkerSoak)
  (import "./retained-transient.mjs" validateRefreshedTransientBuilder)

  (defconst module-directory (js-call path :dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst DEFAULT_ROOT (js-call path :resolve module-directory "../.."))
  (defconst contract-file "contracts/final-acceptance.json")
  (defconst expected-source (js-object :run "acceptance/runs/m13-01.json" :report "acceptance/runs/m13-01.md"))
  (defconst expected-outputs (js-object :manifest "acceptance/manifest.json" :report "acceptance/report.md"))
  (defconst expected-groups (js-array "benchmark" "fuzz" "scale" "soak" "test"))
  (defconst defect-classes (new globalThis.Set (js-array "bootstrap" "compatibility" "correctness" "data-loss" "security")))
  (defconst defect-id-pattern "^[A-Z][A-Z0-9-]+$")
  (defconst summary-heading-pattern "^Final acceptance:")

  (defun final-error-message (errors)
    (str "final acceptance validation failed:\n- " (js-call errors :join "\n- ")))
  (defun final-error-fields (self errors)
    (put self :name "FinalAcceptanceError")
    (put self :errors errors)
    self)
  (defconst FinalAcceptanceError
    (funcall
      (js* "(message, fields) => class FinalAcceptanceError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      final-error-message final-error-fields))

  (defun host-type (value) (funcall (js* "(value) => typeof value") value))
  (defun host-truthy (value) (funcall (js* "(value) => !!value") value))
  (defun host-get (value key) (if (nullish? value) undefined (get value key)))
  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
  (defun plain-object? (value)
    (and (not (nil? value)) (= (host-type value) "object") (not (Array/isArray value))))
  (defun json-equal (left right) (= (JSON/stringify left) (JSON/stringify right)))
  (defun sha256 (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))

  (defun safe-relative-path (value)
    (and (= (host-type value) "string") (> (js-length value) 0)
         (not (js-call path :isAbsolute value))
         (not (js-call (js-call value :split "/") :includes ".."))
         (= (js-call (get path :posix) :normalize value) value)))

  (defun every-text (values)
    (let ((index 0) (ok t))
      (while (and ok (< index (js-length values)))
        (let ((value (aref values index)))
          (unless (and (= (host-type value) "string") (> (js-length value) 0))
            (setq ok nil)))
        (setq index (1+ index)))
      ok))

  (defun sorted-unique-strings (values)
    (and (Array/isArray values) (> (js-length values) 0) (every-text values)
         (= (get (new globalThis.Set values) :size) (js-length values))
         (json-equal values (js-call (Array/from values) :sort))))

  (defasync read-json (root file)
    (JSON/parse (await (readFile (js-call path :join root file) "utf8"))))

  (defasync regular-file (root file)
    (try
      (js-call (await (stat (js-call path :join root file))) :isFile)
      (catch ignored false)))

  (defun already-deferred (items result)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length items)))
        (when (= (get (aref items index) :report) (get result :report))
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun record-refresh (options result)
    (when (and (not (= result t))
               (Array/isArray (get options :deferredPerformanceAcceptance))
               (not (already-deferred (get options :deferredPerformanceAcceptance) result)))
      (js-call (get options :deferredPerformanceAcceptance) :push result)))

  (defasync validateFinalAcceptanceContract (contract run &rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (errors (js-array)))
      (unless (and (plain-object? contract) (= (get contract :schemaVersion) 1)
                   (= (get contract :format) "eliscript-final-acceptance-contract")
                   (= (get contract :version) 1))
        (throw (new FinalAcceptanceError (js-array "contract must use eliscript-final-acceptance-contract version 1"))))
      (unless (json-equal (get contract :source) expected-source)
        (js-call errors :push "contract source must identify the retained core run and report"))
      (unless (= (get contract :defects) "acceptance/defects.json")
        (js-call errors :push "contract defects must identify acceptance/defects.json"))
      (unless (json-equal (get contract :outputs) expected-outputs)
        (js-call errors :push "contract outputs must be the canonical acceptance artifacts"))
      (unless (json-equal (get contract :blockingSeverities) (js-array 1 2))
        (js-call errors :push "blocking severities must be exactly 1 and 2"))
      (let* ((groups (if (Array/isArray (get contract :evidenceGroups)) (get contract :evidenceGroups) (js-array)))
             (group-ids (js-call groups :map (lambda (group) (host-get group "id"))))
             (criterion-ids (new globalThis.Set (js-call (get run :criteria) :map (lambda (criterion) (get criterion :id)))))
             (run-artifacts (new globalThis.Map (js-call (get run :artifacts) :map
                                                   (lambda (artifact) (js-array (get artifact :file) (get artifact :sha256))))))
             (index 0))
        (unless (json-equal group-ids expected-groups)
          (js-call errors :push "evidence groups must be exactly benchmark fuzz scale soak and test"))
        (while (< index (js-length groups))
          (let* ((group (aref groups index))
                 (group-id (host-get group "id"))
                 (label (if (nullish? group-id) (str "evidence group " index) group-id)))
            (if (or (not (plain-object? group)) (not (sorted-unique-strings (get group :criteria)))
                    (not (sorted-unique-strings (get group :artifacts))))
              (js-call errors :push (str label " must declare sorted unique criteria and artifacts"))
              (progn
                (when (and (js-call (get group :criteria) :includes "*")
                           (not (json-equal (get group :criteria) (js-array "*"))))
                  (js-call errors :push (str label " wildcard criterion must be the only criterion")))
                (let ((cursor 0))
                  (while (< cursor (js-length (get group :criteria)))
                    (let ((id (aref (get group :criteria) cursor)))
                      (when (and (not (= id "*")) (not (js-call criterion-ids :has id)))
                        (js-call errors :push (str label " references unknown criterion " id))))
                    (setq cursor (1+ cursor)))
                  (setq cursor 0)
                  (while (< cursor (js-length (get group :artifacts)))
                  (let ((file (aref (get group :artifacts) cursor)))
                    (if (not (safe-relative-path file))
                      (js-call errors :push (str label " has unsafe artifact path " (JSON/stringify file)))
                      (if (not (js-call run-artifacts :has file))
                        (js-call errors :push (str label " artifact is not bound by the source run: " file))
                        (if (not (await (regular-file root file)))
                          (js-call errors :push (str label " artifact is missing: " file))
                          (let* ((current (await (readFile (js-call path :join root file))))
                                 (digest (sha256 current)))
                            (unless (= digest (js-call run-artifacts :get file))
                              (let ((refresh (js-object :deferPerformanceAcceptance
                                                (= (get options :deferPerformanceAcceptance) t))))
                                (if (= file "benchmarks/worker-lifecycle-soak-macos-arm64.json")
                                  (try
                                    (record-refresh options
                                      (await (validateRefreshedWorkerSoak root file current run refresh)))
                                    (catch error
                                      (js-call errors :push
                                        (str label " artifact changed after the source run: " file ": " (get error :message)))))
                                  (if (= file "benchmarks/transient-builder-macos-arm64.json")
                                    (try
                                      (record-refresh options
                                        (await (validateRefreshedTransientBuilder root file current run refresh)))
                                      (catch error
                                        (js-call errors :push
                                          (str label " artifact changed after the source run: " file ": " (get error :message)))))
                                    (js-call errors :push
                                      (str label " artifact changed after the source run: " file)))))))))))
                  (setq cursor (1+ cursor)))))))
          (setq index (1+ index))))
      (when (> (js-length errors) 0) (throw (new FinalAcceptanceError errors)))
      contract))

  (defasync validateDefectRegister (register &rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (errors (js-array)))
      (unless (and (plain-object? register) (= (get register :schemaVersion) 1)
                   (= (get register :format) "eliscript-acceptance-defect-register")
                   (= (get register :version) 1) (Array/isArray (get register :unresolved)))
        (throw (new FinalAcceptanceError
                 (js-array "defect register must use eliscript-acceptance-defect-register version 1"))))
      (let ((ids (js-array)) (index 0) (defects (get register :unresolved)))
        (while (< index (js-length defects))
          (let* ((defect (aref defects index))
                 (defect-id (host-get defect "id"))
                 (label (if (nullish? defect-id) (str "defect " index) defect-id)))
            (if (or (not (plain-object? defect))
                    (not (js-call (new globalThis.RegExp defect-id-pattern "u") :test (get defect :id "")))
                    (not (js-call globalThis.Number :isInteger (get defect :severity)))
                    (< (get defect :severity) 1) (> (get defect :severity) 4)
                    (not (js-call defect-classes :has (get defect :class)))
                    (not (= (host-type (get defect :title)) "string"))
                    (= (js-length (get defect :title)) 0)
                    (not (sorted-unique-strings (get defect :evidence))))
              (js-call errors :push (str label " must declare id severity class title and evidence"))
              (progn
                (js-call ids :push (get defect :id))
                (let ((cursor 0))
                  (while (< cursor (js-length (get defect :evidence)))
                    (let ((file (aref (get defect :evidence) cursor)))
                      (unless (and (safe-relative-path file) (await (regular-file root file)))
                        (js-call errors :push (str label " has missing or unsafe evidence " (JSON/stringify file)))))
                    (setq cursor (1+ cursor)))))))
          (setq index (1+ index)))
        (unless (and (= (get (new globalThis.Set ids) :size) (js-length ids))
                     (json-equal ids (js-call (Array/from ids) :sort)))
          (js-call errors :push "unresolved defect ids must be unique and sorted")))
      (when (> (js-length errors) 0) (throw (new FinalAcceptanceError errors)))
      register))

  (defun result-counts (criteria)
    (let ((result (js-object :pass 0 :incomplete 0 :fail 0 :total (js-length criteria))) (index 0))
      (while (< index (js-length criteria))
        (let ((name (get (aref criteria index) :result)))
          (put result name (1+ (get result name))))
        (setq index (1+ index)))
      result))

  (defun evidence-records (contract run)
    (let ((all-criteria (js-call (get run :criteria) :map (lambda (criterion) (get criterion :id))))
          (criteria (new globalThis.Map (js-call (get run :criteria) :map
                                           (lambda (criterion) (js-array (get criterion :id) (get criterion :result))))))
          (artifacts (new globalThis.Map (js-call (get run :artifacts) :map
                                            (lambda (artifact) (js-array (get artifact :file) (get artifact :sha256)))))))
      (js-call (get contract :evidenceGroups) :map
        (lambda (group)
          (let ((ids (if (json-equal (get group :criteria) (js-array "*")) all-criteria (get group :criteria))))
            (js-object :id (get group :id) :complete t
              :criteria (js-call ids :map (lambda (id) (js-object :id id :result (js-call criteria :get id))))
              :artifacts (js-call (get group :artifacts) :map
                           (lambda (file) (js-object :file file :sha256 (js-call artifacts :get file))))))))))

  (defun count-blocking (defects severities)
    (js-length (js-call (get defects :unresolved) :filter
                 (lambda (defect) (js-call severities :includes (get defect :severity))))))

  (defun every-complete (evidence)
    (let ((index 0) (ok t))
      (while (and ok (< index (js-length evidence)))
        (unless (get (aref evidence index) :complete) (setq ok nil))
        (setq index (1+ index)))
      ok))

  (defasync buildFinalAcceptance (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract))
                       (await (read-json root contract-file))
                       (get options :contract)))
           (run (if (nullish? (get options :run))
                  (await (verifyAcceptanceRun (get (get contract :source) :run)
                           (js-object :root root :markdownFile (get (get contract :source) :report))))
                  (get options :run))))
      (await (validateFinalAcceptanceContract contract run
               (js-object :root root
                 :deferPerformanceAcceptance (= (get options :deferPerformanceAcceptance) t)
                 :deferredPerformanceAcceptance (get options :deferredPerformanceAcceptance))))
      (let* ((defects (await (validateDefectRegister
                               (if (nullish? (get options :defects))
                                 (await (read-json root (get contract :defects)))
                                 (get options :defects))
                               (js-object :root root))))
             (source-run (await (readFile (js-call path :join root (get (get contract :source) :run)))))
             (source-report (await (readFile (js-call path :join root (get (get contract :source) :report)))))
             (defect-bytes (if (host-truthy (get options :defects))
                             (js-call globalThis.Buffer :from
                               (str (JSON/stringify defects nil 2) "\n"))
                             (await (readFile (js-call path :join root (get contract :defects))))))
             (evidence (evidence-records contract run))
             (contract-bytes (await (readFile (js-call path :join root contract-file))))
             (blocking (count-blocking defects (get contract :blockingSeverities)))
             (complete (every-complete evidence))
             (criteria (result-counts (get run :criteria))))
        (js-object :schemaVersion 1 :format "eliscript-1.0-acceptance-manifest" :version 1
          :generatedAt (get run :generatedAt) :source (get run :source) :environment (get run :environment)
          :contract (js-object :file contract-file :sha256 (sha256 contract-bytes))
          :sourceRun (js-object :json (get (get contract :source) :run) :jsonSha256 (sha256 source-run)
                       :markdown (get (get contract :source) :report) :markdownSha256 (sha256 source-report))
          :commands (get run :commands) :criteria (get run :criteria) :artifacts (get run :artifacts)
          :evidence evidence
          :defects (js-object :register (get contract :defects) :registerSha256 (sha256 defect-bytes)
                     :blockingSeverities (get contract :blockingSeverities)
                     :unresolved (get defects :unresolved) :blockingCount blocking)
          :applications (get run :applications)
          :summary (js-object :criteria criteria
                     :corpusComplete (get (get run :summary) :corpusComplete)
                     :operationalSuccess (get (get run :summary) :operationalSuccess)
                     :evidenceComplete complete :blockingDefects blocking
                     :acceptancePass (and (get (get run :summary) :acceptancePass) complete (= blocking 0)))))))

  (defun markdown-cell (value)
    (js-call (js-call (funcall globalThis.String value) :replaceAll "|" "\\|") :replaceAll "\n" " "))

  (defun yes-no (value) (if (host-truthy value) "yes" "no"))

  (defun humanFinalAcceptanceReport (manifest)
    (let ((lines (js-array "# Eliscript 1.0 Acceptance Report" ""
                   (str "- Source commit: `" (get (get manifest :source) :commit) "`")
                   (str "- Source tree: `" (get (get manifest :source) :tree) "`")
                   (str "- Contract: `" (get (get manifest :contract) :file) "` (`" (get (get manifest :contract) :sha256) "`)")
                   (str "- Generated: " (get manifest :generatedAt))
                   (str "- Environment: " (get (get manifest :environment) :operatingSystem) "; "
                        (get (get manifest :environment) :architecture) "; Bun "
                        (get (get manifest :environment) :bunVersion) "; Node "
                        (get (get manifest :environment) :nodeVersion) "; Emacs "
                        (get (get manifest :environment) :emacsVersion))
                   (str "- Corpus complete: " (yes-no (get (get manifest :summary) :corpusComplete)))
                   (str "- Operational success: " (yes-no (get (get manifest :summary) :operationalSuccess)))
                   (str "- Evidence complete: " (yes-no (get (get manifest :summary) :evidenceComplete)))
                   (str "- Blocking defects: " (get (get manifest :summary) :blockingDefects))
                   (str "- Final acceptance: "
                        (if (host-truthy (get (get manifest :summary) :acceptancePass)) "pass" "not reached"))
                   ""
                   (if (host-truthy (get (get manifest :summary) :acceptancePass))
                     "Every mandatory core criterion and final gate passed in the source run."
                     "This is the canonical candidate report. It does not declare Eliscript 1.0 accepted while mandatory criteria remain incomplete.")
                   "" "## Mandatory Criteria" ""
                   (str "Results: " (get (get (get manifest :summary) :criteria) :pass) " pass, "
                        (get (get (get manifest :summary) :criteria) :incomplete) " incomplete, "
                        (get (get (get manifest :summary) :criteria) :fail) " fail, "
                        (get (get (get manifest :summary) :criteria) :total) " total.")
                   "" "| Criterion | Result | Declared state | Remaining work |"
                   "| --- | --- | --- | --- |"))
          (index 0))
      (while (< index (js-length (get manifest :criteria)))
        (let ((criterion (aref (get manifest :criteria) index)))
          (js-call lines :push
            (str "| " (get criterion :id) " " (markdown-cell (get criterion :title)) " | "
                 (get criterion :result) " | " (get criterion :declaredStatus) " | "
                 (markdown-cell (get criterion :remaining "-")) " |")))
        (setq index (1+ index)))
      (js-call lines :push "")
      (js-call lines :push "## Evidence Summaries")
      (js-call lines :push "")
      (js-call lines :push "| Group | Complete | Criteria | Artifacts |")
      (js-call lines :push "| --- | --- | ---: | ---: |")
      (setq index 0)
      (while (< index (js-length (get manifest :evidence)))
        (let ((group (aref (get manifest :evidence) index)))
          (js-call lines :push
            (str "| " (get group :id) " | " (yes-no (get group :complete)) " | "
                 (js-length (get group :criteria)) " | " (js-length (get group :artifacts)) " |")))
        (setq index (1+ index)))
      (js-call lines :push "")
      (js-call lines :push "## Unresolved Defects")
      (js-call lines :push "")
      (if (= (js-length (get (get manifest :defects) :unresolved)) 0)
        (js-call lines :push "No unresolved defects are recorded.")
        (progn
          (js-call lines :push "| ID | Severity | Class | Title |")
          (js-call lines :push "| --- | ---: | --- | --- |")
          (setq index 0)
          (while (< index (js-length (get (get manifest :defects) :unresolved)))
            (let ((defect (aref (get (get manifest :defects) :unresolved) index)))
              (js-call lines :push
                (str "| " (get defect :id) " | " (get defect :severity) " | " (get defect :class)
                     " | " (markdown-cell (get defect :title)) " |")))
            (setq index (1+ index)))))
      (js-call lines :push "")
      (js-call lines :push "## Application Validation")
      (js-call lines :push "")
      (js-call lines :push "| Criterion | Result | Core contribution |")
      (js-call lines :push "| --- | --- | --- |")
      (setq index 0)
      (while (< index (js-length (get manifest :applications)))
        (let ((application (aref (get manifest :applications) index)))
          (js-call lines :push
            (str "| " (get application :id) " " (markdown-cell (get application :title)) " | "
                 (get application :result) " | no |")))
        (setq index (1+ index)))
      (js-call lines :push "")
      (js-call lines :push "## Commands")
      (js-call lines :push "")
      (js-call lines :push "| Probe | Command | Result | Exit | Duration (ms) | Output SHA-256 |")
      (js-call lines :push "| --- | --- | --- | ---: | ---: | --- |")
      (setq index 0)
      (while (< index (js-length (get manifest :commands)))
        (let ((command (aref (get manifest :commands) index)))
          (js-call lines :push
            (str "| " (get command :id) " | `" (markdown-cell (js-call (get command :argv) :join " ")) "` | "
                 (get command :status) " | " (get command :exitCode) " | " (get command :durationMs)
                 " | `" (get command :outputSha256) "` |")))
        (setq index (1+ index)))
      (js-call lines :push "")
      (js-call lines :push "## Artifact Digests")
      (js-call lines :push "")
      (js-call lines :push "| File | SHA-256 |")
      (js-call lines :push "| --- | --- |")
      (setq index 0)
      (while (< index (js-length (get manifest :artifacts)))
        (let ((artifact (aref (get manifest :artifacts) index)))
          (js-call lines :push (str "| `" (get artifact :file) "` | `" (get artifact :sha256) "` |")))
        (setq index (1+ index)))
      (str (js-call lines :join "\n") "\n")))

  (defun validateFinalManifest (manifest expected)
    (let ((errors (js-array)))
      (when (or (not (plain-object? manifest)) (not (= (get manifest :schemaVersion) 1))
                (not (= (get manifest :format) "eliscript-1.0-acceptance-manifest"))
                (not (= (get manifest :version) 1)))
        (js-call errors :push "manifest must use eliscript-1.0-acceptance-manifest version 1"))
      (unless (json-equal (host-get manifest "summary") (get expected :summary))
        (js-call errors :push "final acceptance summary is not derived from its source evidence"))
      (unless (json-equal manifest expected)
        (js-call errors :push "final acceptance manifest does not match its verified source run"))
      (when (> (js-length errors) 0) (throw (new FinalAcceptanceError errors)))
      manifest))

  (defasync generateFinalAcceptance (&rest supplied)
    (let ((options (call-options supplied)))
      (when (= (get options :deferPerformanceAcceptance) t)
        (throw (new FinalAcceptanceError
                 (js-array "cannot generate acceptance artifacts while current performance acceptance is deferred"))))
      (let* ((root (js-call path :resolve (get options :root DEFAULT_ROOT)))
             (contract (if (nullish? (get options :contract))
                         (await (read-json root contract-file))
                         (get options :contract)))
             (manifest (await (buildFinalAcceptance
                                (js-call globalThis.Object :assign (js-object) options
                                  (js-object :root root :contract contract))))))
        (await (mkdir (js-call path :dirname (js-call path :join root (get (get contract :outputs) :manifest)))
                 (js-object :recursive t)))
        (await (writeFile (js-call path :join root (get (get contract :outputs) :manifest))
                 (str (JSON/stringify manifest nil 2) "\n")))
        (await (writeFile (js-call path :join root (get (get contract :outputs) :report))
                 (humanFinalAcceptanceReport manifest)))
        manifest)))

  (defasync verifyFinalAcceptance (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract))
                       (await (read-json root contract-file))
                       (get options :contract)))
           (expected (await (buildFinalAcceptance
                              (js-call globalThis.Object :assign (js-object) options
                                (js-object :root root :contract contract)))))
           (manifest (if (nullish? (get options :manifest))
                       (await (read-json root (get (get contract :outputs) :manifest)))
                       (get options :manifest)))
           (markdown (if (nullish? (get options :markdown))
                       (await (readFile (js-call path :join root (get (get contract :outputs) :report)) "utf8"))
                       (get options :markdown))))
      (validateFinalManifest manifest expected)
      (unless (= markdown (humanFinalAcceptanceReport manifest))
        (throw (new FinalAcceptanceError (js-array "human acceptance report does not match the machine-readable manifest"))))
      (when (and (host-truthy (get options :requirePass))
                 (not (host-truthy (get (get manifest :summary) :acceptancePass))))
        (throw (new FinalAcceptanceError
                 (js-array "the canonical artifacts are valid, but final acceptance has not been reached"))))
      (when (and (host-truthy (get options :requirePass)) (= (get options :deferPerformanceAcceptance) t))
        (throw (new FinalAcceptanceError
                 (js-array "current performance acceptance is deferred and has not passed"))))
      manifest))

  (defun humanFinalAcceptanceSummary (manifest)
    (js-call (js-array
               (str "Final acceptance artifacts: " (get (get manifest :source) :commit))
               (str "Criteria: " (get (get (get manifest :summary) :criteria) :pass) "/"
                    (get (get (get manifest :summary) :criteria) :total) " pass, "
                    (get (get (get manifest :summary) :criteria) :incomplete) " incomplete, "
                    (get (get (get manifest :summary) :criteria) :fail) " fail")
               (str "Evidence groups: " (js-length (get manifest :evidence)) "/"
                    (js-length (get manifest :evidence)) " complete")
               (str "Blocking defects: " (get (get manifest :summary) :blockingDefects))
               (str "Final acceptance: "
                    (if (host-truthy (get (get manifest :summary) :acceptancePass)) "pass" "not reached")))
      :join "\n"))

  (defun parse-arguments (argv)
    (let ((options (js-object)) (index 0))
      (while (< index (js-length argv))
        (let ((argument (aref argv index)))
          (cond
            ((= argument "--generate") (put options :generate t))
            ((= argument "--verify") (put options :verify t))
            ((= argument "--require-pass") (put options :requirePass t))
            (t (throw (new FinalAcceptanceError (js-array (str "unknown argument " argument)))))))
        (setq index (1+ index)))
      (when (= (get options :generate) (get options :verify))
        (throw (new FinalAcceptanceError (js-array "choose exactly one of --generate or --verify"))))
      options))

  (defasync main ()
    (let ((options (parse-arguments (js-call (get globalThis.process :argv) :slice 2))))
      (put options :deferPerformanceAcceptance
        (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))
      (put options :deferredPerformanceAcceptance (js-array))
      (let* ((manifest (if (host-truthy (get options :generate))
                         (await (generateFinalAcceptance options))
                         (await (verifyFinalAcceptance options))))
             (summary (humanFinalAcceptanceSummary manifest)))
        (js-call (get globalThis.process :stdout) :write
          (str (if (get options :deferPerformanceAcceptance)
                 (js-call summary :replace (new globalThis.RegExp summary-heading-pattern "mu")
                   "Historical final acceptance:")
                 summary)
               "\n"))
        (when (get options :deferPerformanceAcceptance)
          (js-call (get globalThis.process :stdout) :write "Current performance acceptance: DEFERRED / NOT ACCEPTED\n")
          (let ((index 0) (items (get options :deferredPerformanceAcceptance)))
            (while (< index (js-length items))
              (let ((item (aref items index)))
                (js-call (get globalThis.process :stdout) :write
                  (str "  " (get item :report) ": measured Git snapshot "
                       (get (get item :measuredSource) :commit)
                       " verified; current source comparison not performed\n")))
              (setq index (1+ index)))))
        (when (and (host-truthy (get options :requirePass))
                   (not (host-truthy (get (get manifest :summary) :acceptancePass))))
          (throw (new FinalAcceptanceError
                   (js-array "the canonical artifacts are valid, but final acceptance has not been reached")))))))

  (when (js* "import.meta.main")
    (js-call (main) :catch
      (lambda (error)
        (let ((stack (get error :stack)))
          (js-call (get globalThis.process :stderr) :write (str (if (nullish? stack) error stack) "\n")))
        (put globalThis.process :exitCode 1))))

  (export DEFAULT_ROOT FinalAcceptanceError validateFinalAcceptanceContract validateDefectRegister
    buildFinalAcceptance humanFinalAcceptanceReport validateFinalManifest generateFinalAcceptance
    verifyFinalAcceptance humanFinalAcceptanceSummary))
