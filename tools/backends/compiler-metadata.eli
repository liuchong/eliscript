(module tools.backends.compiler-metadata
  (defun open (path mode)
    (js-call (js-call globalThis.process :getBuiltinModule "node:fs/promises") :open path mode))

  ;; Decode artifact data without joining the complete document into a host
  ;; string. This is a JSON transport boundary, not a compiler or IR transform.
  (defun createCompilerMetadataDecoder ()
    (let* ((frames (js-array))
           ;; Source maps repeat filenames and range labels millions of times. Strings
           ;; are immutable primitive values: reusing their storage preserves JSON's
           ;; value semantics while every object and array still has its own identity.
           ;; Bound both the atom count and size for arbitrary caller metadata.
           (strings (new globalThis.Map))
           (root undefined) (has-root false) (done false) (offset 0)
           (token undefined) (parts (js-array)) (escaped false)
           ;; Retain only decoded UTF16 blocks, never an entire escaped JSON token.
           ;; The lexical backslash state above is deliberately separate from escape
           ;; decoding: even a malformed \u escape must wait for the same unescaped
           ;; closing quote at which JSON.parse used to reject the token.
           (string-units (new globalThis.Uint16Array 4096))
           (string-blocks (js-array)) (string-length 0) (string-escape 0)
           (unicode-digits 0) (unicode-value 0) (string-invalid false)
           (fail (lambda ()
             (throw (new globalThis.SyntaxError (+ "invalid compiler metadata JSON at offset " offset)))))
           (whitespace (lambda (c)
             (or (= c " ") (= c "\n") (= c "\r") (= c "\t"))))
           (delimiter (lambda (c)
             (or (= c " ") (= c "\n") (= c "\r") (= c "\t") (= c ",") (= c ":") (= c "]") (= c "}") (= c "[") (= c "{"))))
           (value (lambda (item)
             (let ((frame (aref frames (1- (js-length frames)))))
               (if (undefined? frame)
                 (progn
                   (when (= has-root t) (funcall fail))
                   (setq root item) (setq has-root t))
                 (progn
                   (if (= (get frame :array) t)
                     (progn
                       (unless (or (= (get frame :state) "first") (= (get frame :state) "value"))
                         (funcall fail))
                       (js-call (get frame :value) :push item))
                     (progn
                       (unless (= (get frame :state) "value") (funcall fail))
                       (if (= (get frame :key) "__proto__")
                         (Object/defineProperty (get frame :value) (get frame :key)
                           (js-object :value item :writable t :enumerable t :configurable t))
                         (put (get frame :value) (get frame :key) item))
                       (put frame :key undefined)))
                   (put frame :state "comma"))))))
           (string-value (lambda (item)
             (when (<= (js-length item) 256)
               (let ((previous (js-call strings :get item)))
                 (if (not (undefined? previous))
                   (setq item previous)
                   (when (< (get strings :size) 32768)
                     (js-call strings :set item item)))))
             (let ((frame (aref frames (1- (js-length frames)))))
               (if (and (not (undefined? frame)) (not (= (get frame :array) t))
                        (or (= (get frame :state) "first") (= (get frame :state) "key")))
                 (progn (put frame :key item) (put frame :state "colon"))
                 (funcall value item)))))
           (scalar (lambda (text)
             (funcall value (JSON/parse text))))
           (decoded-unit (lambda (unit)
             (put string-units string-length (js-call unit :charCodeAt 0))
             (setq string-length (1+ string-length))
             (when (= string-length (js-length string-units))
               ;; Materialize bounded flat blocks, avoiding a retained character-sized
               ;; rope node for every code unit of a large source string.
               (js-call string-blocks :push
                 (Reflect/apply globalThis.String.fromCharCode globalThis.String string-units))
               (setq string-length 0))))
           (invalid-string (lambda ()
             (setq string-invalid t)
             ;; Nothing from an invalid token can become a key or value. Keep scanning
             ;; its lexical boundary without retaining unusable decoded data.
             (setq string-blocks (js-array)) (setq string-length 0)))
           (string-character (lambda (c)
             (unless (= string-invalid t)
               (cond
                 ((= string-escape 2)
                  (let* ((code (js-call c :charCodeAt 0))
                         (hex (cond ((and (>= code 48) (<= code 57)) (- code 48))
                                    ((and (>= code 65) (<= code 70)) (- code 55))
                                    ((and (>= code 97) (<= code 102)) (- code 87))
                                    (t -1))))
                    (if (< hex 0)
                      (funcall invalid-string)
                      (progn
                        (setq unicode-value (+ (* unicode-value 16) hex))
                        (setq unicode-digits (1+ unicode-digits))
                        (when (= unicode-digits 4)
                          ;; JSON operates on UTF16 code units. In particular, an escaped lone
                          ;; surrogate is preserved instead of being repaired or UTF8-decoded.
                          (funcall decoded-unit (String/fromCharCode unicode-value))
                          (setq string-escape 0))))))
                 ((= string-escape 1)
                  (setq string-escape 0)
                  (cond
                    ((or (= c "\"") (= c "\\") (= c "/")) (funcall decoded-unit c))
                    ((= c "b") (funcall decoded-unit "\b"))
                    ((= c "f") (funcall decoded-unit "\f"))
                    ((= c "n") (funcall decoded-unit "\n"))
                    ((= c "r") (funcall decoded-unit "\r"))
                    ((= c "t") (funcall decoded-unit "\t"))
                    ((= c "u") (setq string-escape 2) (setq unicode-digits 0) (setq unicode-value 0))
                    (t (funcall invalid-string))))
                 ((= c "\\") (setq string-escape 1))
                 ((< (js-call c :charCodeAt 0) 32) (funcall invalid-string))
                 (t (funcall decoded-unit c))))))
           (finish-string (lambda ()
             (when (or (= string-invalid t) (not (= string-escape 0))) (funcall fail))
             (let ((item (if (= (js-length string-blocks) 0)
                           (Reflect/apply globalThis.String.fromCharCode globalThis.String
                             (js-call string-units :subarray 0 string-length))
                           (progn
                             (when (> string-length 0)
                               (js-call string-blocks :push
                                 (Reflect/apply globalThis.String.fromCharCode globalThis.String
                                   (js-call string-units :subarray 0 string-length))))
                             (js-call string-blocks :join "")))))
               (setq string-blocks (js-array)) (setq string-length 0)
               (funcall string-value item))))
           (punctuation (lambda (c)
             (let ((frame (aref frames (1- (js-length frames)))))
               (cond
                 ((or (= c "[") (= c "{"))
                  (let* ((array (= c "[")) (item (if (= array t) (js-array) (js-object))))
                    (funcall value item)
                    (js-call frames :push (js-object :array array :value item :state "first"))))
                 ((or (= c "]") (= c "}"))
                  (when (or (undefined? frame) (not (= (get frame :array) (= c "]")))
                            (and (not (= (get frame :state) "first")) (not (= (get frame :state) "comma"))))
                    (funcall fail))
                  (js-call frames :pop))
                 ((= c ",")
                  (when (or (undefined? frame) (not (= (get frame :state) "comma"))) (funcall fail))
                  (put frame :state (if (= (get frame :array) t) "value" "key")))
                 ((= c ":")
                  (when (or (undefined? frame) (= (get frame :array) t) (not (= (get frame :state) "colon")))
                    (funcall fail))
                  (put frame :state "value"))
                 (t (funcall fail)))))))
      (Object/freeze
        (js-object
          :write (lambda (text)
            (when (= done t) (throw (new globalThis.TypeError "compiler metadata decoder is closed")))
            (unless (= (value-type text) "string")
              (throw (new globalThis.TypeError "compiler metadata chunks must be strings")))
            (let ((start 0) (index 0) (len (js-length text)))
              (while (< index len)
                (let ((c (aref text index)))
                  (if (= token "string")
                    (if (= escaped t)
                      (progn (setq escaped false) (funcall string-character c))
                      (if (= c "\\")
                        (progn (setq escaped t) (funcall string-character c))
                        (if (= c "\"")
                          (progn (funcall finish-string) (setq token undefined))
                          (funcall string-character c))))
                    (let ((keep-going t))
                      (when (= token "scalar")
                        (if (not (= (funcall delimiter c) t))
                          (setq keep-going false)
                          (progn
                            (js-call parts :push (js-call text :slice start index))
                            (funcall scalar (js-call parts :join ""))
                            (setq parts (js-array)) (setq token undefined))))
                      (when (and (= keep-going t) (not (= (funcall whitespace c) t)))
                        (cond
                          ((= c "\"")
                           (setq token "string") (setq escaped false)
                           (setq string-blocks (js-array)) (setq string-length 0) (setq string-escape 0)
                           (setq unicode-digits 0) (setq unicode-value 0) (setq string-invalid false))
                          ((or (= c "-") (and (>= c "0") (<= c "9")) (= c "t") (= c "f") (= c "n"))
                           (setq token "scalar") (setq start index))
                          (t (funcall punctuation c)))))))
                (setq index (1+ index)))
              (when (= token "scalar")
                (js-call parts :push (js-call text :slice start)))
              (setq offset (+ offset len))
              undefined))
          :finish (lambda ()
            (when (= done t) (throw (new globalThis.TypeError "compiler metadata decoder is closed")))
            (setq done t)
            (when (= token "scalar")
              (funcall scalar (js-call parts :join ""))
              (setq parts (js-array)) (setq token undefined))
            (when (or (not (undefined? token)) (> (js-length frames) 0) (not (= has-root t)))
              (funcall fail))
            root)))))

  (defasync readCompilerMetadata (path)
    (let* ((file (await (open path "r")))
           (decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))
           (parser (createCompilerMetadataDecoder))
           (buffer (new globalThis.Uint8Array 65536))
           (failed false) (eof false))
      (try
        (progn
          (while (not eof)
            (let ((bytes-read (get (await (js-call file :read buffer 0 (js-length buffer) nil)) :bytesRead)))
              (if (or (not bytes-read) (= bytes-read 0))
                (setq eof t)
                (js-call parser :write
                  (js-call decoder :decode (js-call buffer :subarray 0 bytes-read) (js-object :stream t))))))
          (js-call parser :write (js-call decoder :decode))
          (js-call parser :finish))
        (catch error (setq failed t) (throw error))
        (finally
          (try (await (js-call file :close))
            (catch error (unless failed (throw error))))))))

  ;; Resource identity validation stays with the caller. Decode only the checked
  ;; bytes, without constructing a second document-sized text buffer.
  (defun decodeCompilerMetadataBytes (bytes)
    (unless (js-call globalThis.Uint8Array (get globalThis.Symbol :hasInstance) bytes)
      (throw (new globalThis.TypeError "compiler metadata must contain UTF8 bytes")))
    (let ((decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))
          (parser (createCompilerMetadataDecoder))
          (offset 0) (byte-length (get bytes :byteLength)))
      (while (< offset byte-length)
        (js-call parser :write
          (js-call decoder :decode (js-call bytes :subarray offset (+ offset 65536)) (js-object :stream t)))
        (setq offset (+ offset 65536)))
      (js-call parser :write (js-call decoder :decode))
      (js-call parser :finish)))

  (export createCompilerMetadataDecoder readCompilerMetadata decodeCompilerMetadataBytes))
