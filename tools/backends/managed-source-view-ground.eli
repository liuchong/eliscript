          (if (not (js-call operations :setPrototype prototype)) false (Reflect/setPrototypeOf target prototype)))
        :isExtensible (lambda () (funcall synchronize) (Reflect/isExtensible target))
        :preventExtensions (lambda ()
          (if (not (js-call operations :preventExtensions)) false
            (progn (funcall synchronize (js-object :all t)) (not (Reflect/isExtensible target))))))))
        (when (eq (host-type target) "function")
          (put handler :apply (lambda (ignored receiver args) (js-call operations :apply receiver args)))
          (when (host-truth (get operations :construct))
            (put handler :construct (lambda (ignored args newTarget) (js-call operations :construct args newTarget)))))
        (setq proxy (new globalThis.Proxy target handler))
        (Object/freeze (js-object :value proxy :refresh (method "refresh" 0
          (lambda () (funcall synchronize (js-object :all t)) proxy)))))))
  (export createManagedLiteralHostProvider createManagedSourceView))
