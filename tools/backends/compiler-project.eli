(module tools.backends.compiler-project
  (import "node:fs/promises" readdir realpath stat open)
  (import "node:fs" constants)
  (import "node:path" resolve relative isAbsolute sep)
  (defconst excludedDirectories (new globalThis.Set (js-array ".git" "node_modules" "dist" "build" "target" "coverage"
    ".cache" ".eliscript-cache" ".next" ".nuxt" ".turbo" ".parcel-cache")))
  (defconst scheme-pattern (new globalThis.RegExp "^[a-z][a-z0-9+.-]*:" "i"))
  (defun host-type (value) (js* "typeof value"))
  (defun host-truth (value) (js* "!!value"))
  (defun option (options key fallback)
    (let ((value (get options key))) (if (undefined? value) fallback value)))
  (defun inside (root path)
    (let ((part (relative root path)))
      (or (eq part "") (and (not (isAbsolute part)) (not (eq part "..")) (not (js-call part :startsWith (str ".." sep)))))))
  (defun virtualPath (root path) (js-call (js-call (relative root path) :split sep) :join "/"))
  (defasync authorizedPath (root path)
    (let ((actual (await (realpath path))))
      (unless (inside root actual) (throw (new globalThis.Error "project path escapes the authorized root"))) actual))
  (defasync sourceText (root path)
    (let* ((actual (await (authorizedPath root path)))
           (handle (await (open actual (bit-or (get constants :O_RDONLY) (get constants :O_NOFOLLOW 0))))) (failed false))
      (try
        (let* ((current (await (authorizedPath root path))) (opened (await (js-call handle :stat))) (named (await (stat current))))
          (unless (and (js-call opened :isFile) (eq (get opened :dev) (get named :dev)) (eq (get opened :ino) (get named :ino)))
            (throw (new globalThis.Error "project source changed while opening")))
          (let ((bytes (await (js-call handle :readFile))))
            (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode bytes)))
        (catch error (setq failed t) (throw error))
        (finally (try (await (js-call handle :close)) (catch error (unless failed (throw error))))))))
  (defun macroSpecifier (value)
    (when (or (not (eq (host-type value) "string")) (not (host-truth value)) (js-call value :includes "\\")
              (js-call value :startsWith "/") (js-call scheme-pattern :test value))
      (throw (new globalThis.TypeError "macro dependency specifier must be a relative string")))
    (let ((depth 0) (parts (js-call value :split "/")) (index 0))
      (while (< index (js-length parts))
        (let ((part (aref parts index)))
          (if (eq part "..")
            (progn (setq depth (1- depth))
              (when (< depth 0) (throw (new globalThis.TypeError "macro dependency specifier escapes its virtual root"))))
            (unless (or (eq part "") (eq part ".")) (setq depth (1+ depth)))))
        (setq index (1+ index)))) value)
  (defasync loadCompilerProject (&rest supplied)
    (let* ((options (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
           (root (get options :root)) (entry (get options :entry)) (target (option options "target" "javascript"))
           (sourceMap (option options "sourceMap" false)) (debug (option options "debug" false))
           (macroCapabilities (option options "macroCapabilities" (js-array)))
           (macroDependencies (option options "macroDependencies" (js-array))) (memory (get options :memory))
           (hostModules (option options "hostModules" (js-array))) (literalSources (get options :literalSources))
           (nativeTarget (let ((value (get options :nativeTarget)))
             (if (undefined? value) (if (eq (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos") value)))
           (nativeFormat (option options "nativeFormat" "library")))
      (unless (and (eq (host-type root) "string") (host-truth root) (eq (host-type entry) "string") (host-truth entry))
        (throw (new globalThis.TypeError "project input requires an explicit root and entry")))
      (when (eq target "js") (setq target "javascript"))
      (unless (js-call (js-array "javascript" "wasm" "native") :includes target) (throw (new globalThis.TypeError "unknown project target")))
      (unless (and (js-call (js-array "arm64-macos" "arm64-linux") :includes nativeTarget)
                   (js-call (js-array "library" "object") :includes nativeFormat))
        (throw (new globalThis.TypeError "unsupported native project output")))
      (let* ((logicalRoot (resolve root)) (authorizedRoot (await (realpath logicalRoot))))
        (unless (js-call (await (stat authorizedRoot)) :isDirectory) (throw (new globalThis.TypeError "project root is not a directory")))
        (let ((entryPath (resolve logicalRoot entry)))
          (unless (and (inside logicalRoot entryPath) (js-call entryPath :endsWith ".eli"))
            (throw (new globalThis.TypeError "project entry must be an .eli file inside root")))
          (await (authorizedPath authorizedRoot entryPath))
          (let ((modules (js-array)) (hostSources (js-array)) (walk nil))
            (unless (Array/isArray hostModules) (throw (new globalThis.TypeError "host module declarations must be an array")))
            (setq walk (async (path ancestors)
              (let ((actual (await (authorizedPath authorizedRoot path))))
                (unless (js-call ancestors :has actual)
                  (let ((next (new globalThis.Set ancestors)))
                    (js-call next :add actual)
                    (let ((entries (await (readdir actual (js-object :withFileTypes t)))) (index 0))
                      (js-call entries :sort (lambda (a b) (cond ((< (get a :name) (get b :name)) -1) ((> (get a :name) (get b :name)) 1) (t 0))))
                      (while (< index (js-length entries))
                        (let ((child (aref entries index)))
                          (unless (js-call excludedDirectories :has (get child :name))
                            (let* ((file (resolve path (get child :name))) (resolved (await (authorizedPath authorizedRoot file)))
                                   (details (await (stat resolved))))
                              (cond
                                ((js-call details :isDirectory) (await (funcall walk file next)))
                                ((and (js-call details :isFile) (js-call (get child :name) :endsWith ".eli"))
                                  (let ((filename (virtualPath logicalRoot file)))
                                    (js-call modules :push (js-object :id (str (js-call filename :slice 0 -4) ".mjs") :filename filename
                                      :source (await (sourceText authorizedRoot file))))))
                                ((and (js-call details :isFile) (js-call (get child :name) :endsWith ".mjs"))
                                  (let ((filename (virtualPath logicalRoot file)))
                                    (js-call hostSources :push (js-object :id filename :filename filename :source (await (sourceText authorizedRoot file))))))))))
                        (setq index (1+ index)))))))
              undefined))
            (await (funcall walk logicalRoot (new globalThis.Set)))
            (let ((entryFilename (virtualPath logicalRoot entryPath)))
              (unless (js-call modules :some (lambda (module) (eq (get module :filename) entryFilename)))
                (throw (new globalThis.Error "project entry is excluded or missing from the source graph")))
              (unless (and (Array/isArray macroCapabilities) (Array/isArray macroDependencies))
                (throw (new globalThis.TypeError "macro capabilities and dependencies must be arrays")))
              (let ((capabilities (Array/from (new globalThis.Set macroCapabilities))))
                (when (js-call capabilities :some (lambda (value) (not (eq value "read-file"))))
                  (throw (new globalThis.TypeError "unsupported macro capability")))
                (when (and (> (js-length macroDependencies) 0) (not (js-call capabilities :includes "read-file")))
                  (throw (new globalThis.Error "macro dependencies require explicit read-file capability")))
                (let ((files (js-array)) (specifiers (new globalThis.Set)) (index 0))
                  (while (< index (js-length macroDependencies))
                    (let* ((dependency (aref macroDependencies index))
                           (specifier (macroSpecifier (if (nullish? dependency) undefined (get dependency :specifier)))))
                      (when (js-call specifiers :has specifier) (throw (new globalThis.TypeError "duplicate macro dependency specifier")))
                      (unless (and (eq (host-type (get dependency :path)) "string") (host-truth (get dependency :path)))
                        (throw (new globalThis.TypeError "macro dependency requires a path")))
                      (let ((path (resolve logicalRoot (get dependency :path))))
                        (unless (inside logicalRoot path) (throw (new globalThis.Error "macro dependency escapes the authorized root")))
                        (js-call files :push (js-object :specifier specifier :content (await (sourceText authorizedRoot path)))))
                      (js-call specifiers :add specifier))
                    (setq index (1+ index)))
                  (let ((result (js-object :operation "project" :modules modules)))
                    (when (> (js-length hostSources) 0) (put result :hostSources hostSources))
                    (when (> (js-length hostModules) 0) (put result :hostModules hostModules))
                    (unless (undefined? literalSources) (put result :literalSources literalSources))
                    (put result :entry (str (js-call entryFilename :slice 0 -4) ".mjs")) (put result :target target)
                    (put result :resolveImports t) (put result :sourceMap (funcall globalThis.Boolean sourceMap))
                    (put result :debug (funcall globalThis.Boolean debug))
                    (when (or (> (js-length capabilities) 0) (> (js-length files) 0))
                      (put result :macroContext (js-object :capabilities capabilities :files files)))
                    (when (host-truth memory) (put result :memory memory))
                    (put result :nativeTarget nativeTarget) (put result :nativeFormat nativeFormat) result)))))))))
  (export loadCompilerProject))
