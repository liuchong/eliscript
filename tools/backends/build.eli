(module tools.backends.build
  (import "node:fs" readdirSync)
  (import "node:fs/promises" mkdir readFile readdir writeFile symlink realpath)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve dirname relative)
  (import "node:url" fileURLToPath pathToFileURL)
  ;; Filesystem and ESM loading are host operations. Build orchestration and
  ;; the managed target's source inventory are maintained in Eliscript.
  (defconst module-url (js* "import.meta.url"))
  (defconst host-import (js* "(specifier) => import(specifier)"))
  (defun host-truth (value) (js* "!!value"))
  (defconst root (resolve (dirname (fileURLToPath module-url)) "../.."))
  (defconst module-pattern (new globalThis.RegExp "^[a-z][a-z0-9-]*[.]eli$"))
  (defun module-names (entries)
    (js-call (js-call (js-call entries :filter (lambda (name) (js-call module-pattern :test name))) :sort)
      :map (lambda (name) (js-call name :slice 0 -4))))
  (defconst backendModules (Object/freeze (module-names (readdirSync (resolve root "bootstrap/backends")))))
  (defun options-from (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
  (defun source-record (id filename) (js-object :id id :filename filename))
  (defasync loadLiteralSources (&rest supplied)
    (let* ((options (options-from supplied)) (sourceRoot (get options :sourceRoot))
           (records (js-array)) (inputs (js-array)))
      (when (undefined? sourceRoot) (setq sourceRoot root))
      (js-call (js-array "bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value"
                 "managed-queue-state" "managed-vector-view-state" "managed-transient-state" "managed-sorted-state" "managed-value-state")
        :forEach (lambda (name) (js-call inputs :push (source-record (str "stdlib/" name ".mjs") (str "stdlib/" name ".eli")))))
      (js-call inputs :push
        (source-record "runtime/core/protocol-error.mjs" "stdlib/managed-protocol-error.eli")
        (source-record "stdlib/core/protocol.mjs" "stdlib/core/protocol.eli")
        (source-record "stdlib/core/text.mjs" "stdlib/core/text.eli")
        (source-record "stdlib/core/object.mjs" "stdlib/core/object.eli")
        (source-record "stdlib/core/set.mjs" "stdlib/core/set.eli")
        (source-record "stdlib/core/data.mjs" "stdlib/core/data.eli")
        (source-record "stdlib/managed-literal-protocols.mjs" "stdlib/managed-literal-protocols.eli")
        (source-record "stdlib/managed-literals.mjs" "stdlib/managed-literals.eli"))
      (js-call (js-array "list" "vector" "map" "set" "queue" "identifier" "record" "value" "metadata" "collection" "transient" "protocol" "type"
                 "order" "sorted" "regex" "transducer" "lazy-sequence" "truth" "text" "object" "sequence"
                 "set-algebra" "collection-internals" "metadata-internals" "persistent-kind" "data" "data-text" "value-internals")
        :forEach (lambda (name) (js-call inputs :push
          (source-record (str "runtime/core/" name ".mjs") (str "stdlib/managed-runtime-" name ".eli")))))
      (js-call inputs :push (source-record "runtime/literals.mjs" "stdlib/managed-runtime-literals.eli")
        (source-record "runtime/wire/markdown.mjs" "stdlib/managed-wire-markdown.eli")
        (source-record "runtime/wire/schema.mjs" "stdlib/managed-wire-schema.eli")
        (source-record "runtime/wire/http-rpc.mjs" "stdlib/managed-wire-http-rpc.eli")
        (source-record "runtime/testing/value.mjs" "stdlib/managed-testing-value.eli"))
      (let ((index 0))
        (while (< index (js-length inputs))
          (let* ((input (aref inputs index)) (id (get input :id)) (filename (get input :filename))
                 (source (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode
                           (await (readFile (resolve sourceRoot filename))))))
            (js-call records :push (js-object :id id :filename filename :source source)))
          (setq index (1+ index)))) records))

  (defasync buildBackends (&rest supplied)
    (let* ((options (options-from supplied))
           (output-value (get options :outputRoot))
           (outputRoot (if (undefined? output-value) (resolve root "dist") output-value))
           (seed-value (get options :seed)) (seed (if (undefined? seed-value) false seed-value))
           (frontend (get options :frontend))
           (compilerDirectory (resolve outputRoot "bootstrap")) (directory (resolve outputRoot "backends"))
           (packageDirectory (resolve outputRoot "node_modules")) (packageLink (resolve packageDirectory "eliscript")))
      (await (mkdir packageDirectory (js-object :recursive t)))
      (try (await (symlink root packageLink "dir"))
        (catch error
          (unless (eq (get error :code) "EEXIST") (throw error))
          (unless (eq (await (realpath packageLink)) (await (realpath root)))
            (throw (new globalThis.Error "backend bootstrap resolves a different Eliscript runtime package")))))
      (let ((modules (module-names (await (readdir (resolve root "bootstrap/compiler"))))))
        (unless (js-call modules :includes "compiler") (throw (new globalThis.Error "bootstrap compiler module is missing")))
        (await (mkdir compilerDirectory (js-object :recursive t)))
        (if (not (host-truth frontend))
          (let ((result (spawnSync (get (get globalThis.process :env) :EMACS "emacs")
                          (js-call (js-array "--batch" "-Q" "--script" (resolve root "tools/bootstrap-seed.el") "--" root compilerDirectory) :concat modules)
                          (js-object :cwd root :encoding "utf8" :timeout 120000 :env (Object/assign (js-object) (get globalThis.process :env))))))
            (unless (eq (get result :status) 0)
              (let ((stderr (get result :stderr)))
                (throw (new globalThis.Error (if (host-truth stderr) stderr (funcall globalThis.String (get result :error))))))))
          (let ((index 0))
            (while (< index (js-length modules))
              (let* ((name (aref modules index)) (sourcePath (resolve root (str "bootstrap/compiler/" name ".eli")))
                     (source (await (readFile sourcePath "utf8")))
                     (emission (js-call frontend :compile_string_with_source_map source sourcePath (str name ".mjs") (relative compilerDirectory sourcePath))))
                (await (writeFile (resolve compilerDirectory (str name ".mjs")) (str (get emission :javascript) "//# sourceMappingURL=" name ".mjs.map\n")))
                (await (writeFile (resolve compilerDirectory (str name ".mjs.map")) (get emission :sourceMap))))
              (setq index (1+ index))))))
        (let ((compiler (if (nullish? frontend)
                          (await (funcall host-import (get (pathToFileURL (resolve compilerDirectory "compiler.mjs")) :href))) frontend)))
          (await (mkdir directory (js-object :recursive t)))
          (let ((index 0))
            (while (< index (js-length backendModules))
              (let* ((name (aref backendModules index)) (sourcePath (resolve root (str "bootstrap/backends/" name ".eli")))
                     (outputPath (resolve directory (str name ".mjs"))))
                (if (host-truth seed)
                  (let ((child (spawnSync (resolve root "bin/eliscript-seed") (js-array "--source-map" "--output" outputPath sourcePath)
                                 (js-object :cwd root :encoding "utf8" :timeout 120000))))
                    (unless (eq (get child :status) 0)
                      (let* ((stderr (get child :stderr))
                             (failure (new globalThis.Error (str "Seed backend " name " (" sourcePath "): "
                                        (if (host-truth stderr) stderr (funcall globalThis.String (get child :error))))
                                        (js-object :cause (get child :error)))))
                        (put failure :compilerModule name) (put failure :sourcePath sourcePath)
                        (put failure :exitCode (get child :status)) (put failure :signal (get child :signal)) (throw failure))))
                  (let* ((source (await (readFile sourcePath "utf8")))
                         (emission (js-call compiler :compile_string_with_source_map source sourcePath (str name ".mjs") (relative directory sourcePath))))
                    (await (writeFile outputPath (str (get emission :javascript) "//# sourceMappingURL=" name ".mjs.map\n")))
                    (await (writeFile (str outputPath ".map") (get emission :sourceMap))))))
              (setq index (1+ index))))
          (let ((result (js-object :compiler compiler :directory directory)))
            (put result :loadLiteralModules (async ()
              (let ((literalSources (await (loadLiteralSources))))
                (js-object :literalSources literalSources :literalModules (js-call literalSources :map (lambda (record)
                  (js-object :id (get record :id) :program (js-call compiler :compile_ir_string (get record :source) (get record :filename)))))))))
            (put result :optimizer (await (funcall host-import (get (pathToFileURL (resolve directory "optimize.mjs")) :href))))
            (put result :numeric (await (funcall host-import (get (pathToFileURL (resolve directory "numeric.mjs")) :href))))
            (put result :wasm (await (funcall host-import (get (pathToFileURL (resolve directory "wasm.mjs")) :href))))
            (put result :native (await (funcall host-import (get (pathToFileURL (resolve directory "native.mjs")) :href))))
            (put result :sha256 (await (funcall host-import (get (pathToFileURL (resolve directory "sha256.mjs")) :href))))
            (put result :regexp (await (funcall host-import (get (pathToFileURL (resolve directory "regexp.mjs")) :href))))
            (put result :managed (await (funcall host-import (get (pathToFileURL (resolve directory "managed.mjs")) :href)))) result))))

  (defasync run-module-entry ()
(let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (host-truth entry) (eq (resolve entry) (fileURLToPath module-url)))
      (let ((result (await (buildBackends)))) (js-call (get globalThis.process :stdout) :write (str (get result :directory) "\n"))))))
  (js-call (run-module-entry) :catch (lambda (error)
    (js-call (get (js* "globalThis") :console) :error error)
    (put (get (js* "globalThis") :process) :exitCode 1)))
  (export root backendModules loadLiteralSources buildBackends))
