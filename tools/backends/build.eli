(module tools.backends.build
  (import "node:fs" existsSync readdirSync)
  (import "node:fs/promises" copyFile mkdir readFile readdir rename rm stat symlink realpath writeFile)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "node:path" resolve dirname relative)
  (import "node:url" fileURLToPath pathToFileURL)
  ;; Filesystem and ESM loading are host operations. Build orchestration and
  ;; the managed target's source inventory are maintained in Eliscript.
  (defconst module-url (js* "import.meta.url"))
  (defconst host-import (js* "(specifier) => import(specifier)"))
  (defun host-truth (value) (js* "!!value"))
  (defconst root (resolve (dirname (fileURLToPath module-url)) "../.."))
  (defconst module-pattern (new globalThis.RegExp "^[a-z][a-z0-9-]*[.]eli$"))
  (defun module-names (entries)
    (js-call (js-call (js-call entries :filter (lambda (name) (js-call module-pattern :test name))) :sort)
      :map (lambda (name) (js-call name :slice 0 -4))))
  ;; Avoid Object.freeze on dynamic .map() arrays at module load: in JavaScriptCore,
  ;; freezing an over-allocated JSArray butterfly triggers JSGlobalObject::haveABadTime.
  (defconst backendModules (module-names (readdirSync (resolve root "bootstrap/backends"))))
  (defun options-from (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
  (defun source-record (id filename) (js-object :id id :filename filename))
  (defasync loadLiteralSources (&rest supplied)
    (let* ((options (options-from supplied)) (sourceRoot (get options :sourceRoot))
           (records (js-array)) (inputs (js-array)))
      (when (undefined? sourceRoot) (setq sourceRoot root))
      (js-call (js-array "bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value")
        :forEach (lambda (name) (js-call inputs :push (source-record (str "stdlib/" name ".mjs") (str "stdlib/" name ".eli")))))
      (js-call (js-array "managed-queue-state" "managed-vector-view-state" "managed-transient-state" "managed-sorted-state" "managed-value-state")
        :forEach (lambda (name) (js-call inputs :push (source-record (str "runtime/managed/" name ".mjs") (str "runtime/managed/" name ".eli")))))
      (js-call inputs :push
        (source-record "runtime/core/protocol-error.mjs" "runtime/managed/managed-protocol-error.eli")
        (source-record "runtime/core/protocol-impl.mjs" "runtime/core/protocol-impl.eli")
        (source-record "runtime/core/text-impl.mjs" "runtime/core/text-impl.eli")
        (source-record "runtime/core/object-impl.mjs" "runtime/core/object-impl.eli")
        (source-record "stdlib/protocol.mjs" "stdlib/protocol.eli")
        (source-record "stdlib/string.mjs" "stdlib/string.eli")
        (source-record "stdlib/interop/object.mjs" "stdlib/interop/object.eli")
        (source-record "stdlib/set.mjs" "stdlib/set.eli")
        (source-record "stdlib/data.mjs" "stdlib/data.eli")
        (source-record "runtime/managed/managed-literal-protocols.mjs" "runtime/managed/managed-literal-protocols.eli")
        (source-record "runtime/managed/managed-literals.mjs" "runtime/managed/managed-literals.eli"))
      (js-call (js-array "array-map" "list" "vector" "map" "set" "queue" "identifier" "record" "value" "metadata" "collection" "transient" "protocol" "type"
                 "order" "sorted" "regex" "transducer" "lazy-sequence" "truth" "text" "object" "sequence"
                 "set-algebra" "collection-internals" "metadata-internals" "persistent-kind" "data" "data-text" "value-internals")
        :forEach (lambda (name) (js-call inputs :push
          (source-record (str "runtime/core/" name ".mjs") (str "runtime/managed/managed-runtime-" name ".eli")))))
      (js-call inputs :push (source-record "runtime/literals.mjs" "runtime/managed/managed-runtime-literals.eli")
        (source-record "runtime/wire/markdown.mjs" "runtime/managed/managed-wire-markdown.eli")
        (source-record "runtime/wire/schema.mjs" "runtime/managed/managed-wire-schema.eli")
        (source-record "runtime/wire/http-rpc.mjs" "runtime/managed/managed-wire-http-rpc.eli")
        (source-record "runtime/testing/value.mjs" "runtime/managed/managed-testing-value.eli"))
      (let ((index 0))
        (while (< index (js-length inputs))
          (let* ((input (aref inputs index)) (id (get input :id)) (filename (get input :filename))
                 (source (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode
                           (await (readFile (resolve sourceRoot filename))))))
            (js-call records :push (js-object :id id :filename filename :source source)))
          (setq index (1+ index)))) records))

  (defconst cache-runtime-modules (js-array
    "number-radix" "array-text" "primitives" "errors" "prelude" "unicode-case-data" "unicode-case" "math"))

  (defasync compute-backend-cache-key (compiler-modules)
    (let ((ready t) (i 0))
      (while (and ready (< i (js-length cache-runtime-modules)))
        (unless (existsSync (resolve root "runtime" (str (aref cache-runtime-modules i) ".eli")))
          (setq ready false))
        (setq i (1+ i)))
      (if (not ready) nil
        (let* ((hash (createHash "sha256"))
               (el-files (js-call (js-call (await (readdir (resolve root "compiler")))
                                    :filter (lambda (name) (js-call name :endsWith ".el"))) :sort)))
          (js-call hash :update "backends-v1\n")
          (setq i 0)
          (while (< i (js-length el-files))
            (let* ((f (aref el-files i))
                   (bytes (await (readFile (resolve root "compiler" f)))))
              (js-call hash :update (str "compiler/" f "\0"))
              (js-call hash :update bytes))
            (setq i (1+ i)))
          (let ((tools (js-array "tools/bootstrap-seed.el" "tools/bootstrap-runtime.el")))
            (setq i 0)
            (while (< i (js-length tools))
              (let* ((p (aref tools i)) (bytes (await (readFile (resolve root p)))))
                (js-call hash :update (str p "\0")) (js-call hash :update bytes))
              (setq i (1+ i))))
          (setq i 0)
          (while (< i (js-length cache-runtime-modules))
            (let* ((rt (aref cache-runtime-modules i))
                   (p (str "runtime/" rt ".eli"))
                   (bytes (await (readFile (resolve root p)))))
              (js-call hash :update (str p "\0")) (js-call hash :update bytes))
            (setq i (1+ i)))
          (setq i 0)
          (while (< i (js-length compiler-modules))
            (let* ((m (aref compiler-modules i))
                   (p (str "bootstrap/compiler/" m ".eli"))
                   (bytes (await (readFile (resolve root p)))))
              (js-call hash :update (str p "\0")) (js-call hash :update bytes))
            (setq i (1+ i)))
          (setq i 0)
          (while (< i (js-length backendModules))
            (let* ((m (aref backendModules i))
                   (p (str "bootstrap/backends/" m ".eli"))
                   (bytes (await (readFile (resolve root p)))))
              (js-call hash :update (str p "\0")) (js-call hash :update bytes))
            (setq i (1+ i)))
          (js-call hash :digest "hex")))))

  (defasync copy-backend-map (src-map-path dst-map-path target-dir rel-source)
    (let ((parsed (JSON/parse (await (readFile src-map-path "utf8")))))
      (put parsed :sources (js-array (relative target-dir (resolve root rel-source))))
      (await (writeFile dst-map-path (JSON/stringify parsed)))))

  (defasync copy-backend-tree (src-compiler src-backends dst-compiler dst-backends compiler-modules rewrite-maps)
    (let ((tasks (js-array)) (i 0)
          (src-rt (resolve src-compiler "runtime"))
          (dst-rt (resolve dst-compiler "runtime")))
      (await (mkdir dst-rt (js-object :recursive t)))
      (await (mkdir dst-backends (js-object :recursive t)))
      (js-call tasks :push (copyFile (resolve src-compiler "package.json") (resolve dst-compiler "package.json")))
      (while (< i (js-length cache-runtime-modules))
        (let ((name (aref cache-runtime-modules i)))
          (js-call tasks :push (copyFile (resolve src-rt (str name ".mjs")) (resolve dst-rt (str name ".mjs"))))
          (if rewrite-maps
            (js-call tasks :push (copy-backend-map (resolve src-rt (str name ".mjs.map"))
                                   (resolve dst-rt (str name ".mjs.map")) dst-rt (str "runtime/" name ".eli")))
            (js-call tasks :push (copyFile (resolve src-rt (str name ".mjs.map")) (resolve dst-rt (str name ".mjs.map"))))))
        (setq i (1+ i)))
      (setq i 0)
      (while (< i (js-length compiler-modules))
        (let ((name (aref compiler-modules i)))
          (js-call tasks :push (copyFile (resolve src-compiler (str name ".mjs")) (resolve dst-compiler (str name ".mjs"))))
          (if rewrite-maps
            (js-call tasks :push (copy-backend-map (resolve src-compiler (str name ".mjs.map"))
                                   (resolve dst-compiler (str name ".mjs.map")) dst-compiler (str "bootstrap/compiler/" name ".eli")))
            (js-call tasks :push (copyFile (resolve src-compiler (str name ".mjs.map")) (resolve dst-compiler (str name ".mjs.map"))))))
        (setq i (1+ i)))
      (setq i 0)
      (while (< i (js-length backendModules))
        (let ((name (aref backendModules i)))
          (js-call tasks :push (copyFile (resolve src-backends (str name ".mjs")) (resolve dst-backends (str name ".mjs"))))
          (if rewrite-maps
            (js-call tasks :push (copy-backend-map (resolve src-backends (str name ".mjs.map"))
                                   (resolve dst-backends (str name ".mjs.map")) dst-backends (str "bootstrap/backends/" name ".eli")))
            (js-call tasks :push (copyFile (resolve src-backends (str name ".mjs.map")) (resolve dst-backends (str name ".mjs.map"))))))
        (setq i (1+ i)))
      (await (Promise/all tasks))))

  (defasync materialize-cached-backends (cache-dir compiler-dir backends-dir compiler-modules)
    (await (copy-backend-tree (resolve cache-dir "bootstrap") (resolve cache-dir "backends")
                              compiler-dir backends-dir compiler-modules t)))

  (defasync store-cached-backends (cache-dir compiler-dir backends-dir compiler-modules)
    (unless (existsSync (resolve cache-dir "READY"))
      (let ((tmp-dir (str cache-dir ".tmp." (get globalThis.process :pid) "." (Math/floor (* (Math/random) 1000000000)))))
        (try
          (await (copy-backend-tree compiler-dir backends-dir
                                    (resolve tmp-dir "bootstrap") (resolve tmp-dir "backends")
                                    compiler-modules nil))
          (await (writeFile (resolve tmp-dir "READY") "ok\n"))
          (await (mkdir (dirname cache-dir) (js-object :recursive t)))
          (await (rename tmp-dir cache-dir))
          (catch error
            (try (await (rm tmp-dir (js-object :recursive t :force t))) (catch _ nil)))))))

  (defasync acquire-backend-cache-lock (cache-dir)
    (let* ((lock-dir (str cache-dir ".lock"))
           (ready-file (resolve cache-dir "READY"))
           (deadline (+ (Date/now) 180000)))
      (await (mkdir (dirname cache-dir) (js-object :recursive t)))
      (let ((acquired false))
        (while (and (not acquired) (not (existsSync ready-file)))
          (try
            (await (mkdir lock-dir))
            (setq acquired t)
            (catch error
              (if (= (get error :code) "EEXIST")
                (progn
                  (try
                    (let ((info (await (stat lock-dir))))
                      (when (> (- (Date/now) (get info :mtimeMs)) 180000)
                        (await (rm lock-dir (js-object :recursive t :force t)))))
                    (catch _ nil))
                  (unless (existsSync ready-file)
                    (when (>= (Date/now) deadline)
                      (throw error))
                    (await (new globalThis.Promise (lambda (done) (globalThis.setTimeout done 100))))))
                (throw error)))))
        acquired)))

  (defasync buildBackends (&rest supplied)
    (let* ((options (options-from supplied))
           (output-value (get options :outputRoot))
           (outputRoot (if (undefined? output-value) (resolve root "dist") output-value))
           (seed-value (get options :seed)) (seed (if (undefined? seed-value) false seed-value))
           (frontend (get options :frontend))
           (compilerDirectory (resolve outputRoot "bootstrap")) (directory (resolve outputRoot "backends"))
           (packageDirectory (resolve outputRoot "node_modules")) (packageLink (resolve packageDirectory "eliscript")))
      (await (mkdir packageDirectory (js-object :recursive t)))
      (try (await (symlink root packageLink "dir"))
        (catch error
          (unless (eq (get error :code) "EEXIST") (throw error))
          (unless (eq (await (realpath packageLink)) (await (realpath root)))
            (throw (new globalThis.Error "backend bootstrap resolves a different Eliscript runtime package")))))
      (let ((modules (module-names (await (readdir (resolve root "bootstrap/compiler"))))))
        (unless (js-call modules :includes "compiler") (throw (new globalThis.Error "bootstrap compiler module is missing")))
        (await (mkdir compilerDirectory (js-object :recursive t)))
        (let* ((emacs-env (get (get globalThis.process :env) :EMACS nil))
               (cache-enabled (and (not (host-truth seed))
                                   (not (host-truth frontend))
                                   (not (= (resolve outputRoot) (resolve root "dist")))
                                   (or (nullish? emacs-env) (= emacs-env "") (= emacs-env "emacs"))
                                   (or (existsSync (resolve root "dist/stage3-release.json"))
                                       (existsSync (resolve root "bootstrap/host/project.mjs")))
                                   (not (= (get (get globalThis.process :env) :ELISCRIPT_DISABLE_BACKEND_CACHE nil) "1"))))
               (cache-key (when cache-enabled (await (compute-backend-cache-key modules))))
               (cache-dir (when cache-key (resolve root ".eliscript-cache/backends-build" cache-key)))
               (cache-hit (and cache-dir (existsSync (resolve cache-dir "READY"))))
               (compiler nil))
          (if cache-hit
            (progn
              (await (materialize-cached-backends cache-dir compilerDirectory directory modules))
              (setq compiler (await (funcall host-import (get (pathToFileURL (resolve compilerDirectory "compiler.mjs")) :href)))))
            (let ((lock-held (if cache-dir (await (acquire-backend-cache-lock cache-dir)) false)))
              (try
                (setq cache-hit (and cache-dir (existsSync (resolve cache-dir "READY"))))
                (if cache-hit
                  (progn
                    (await (materialize-cached-backends cache-dir compilerDirectory directory modules))
                    (setq compiler (await (funcall host-import (get (pathToFileURL (resolve compilerDirectory "compiler.mjs")) :href)))))
                  (progn
                    (if (not (host-truth frontend))
                      (let ((result (spawnSync (get (get globalThis.process :env) :EMACS "emacs")
                                      (js-call (js-array "--batch" "-Q" "--script" (resolve root "tools/bootstrap-seed.el") "--" root compilerDirectory) :concat modules)
                                      (js-object :cwd root :encoding "utf8" :timeout 120000 :env (Object/assign (js-object) (get globalThis.process :env))))))
                        (unless (eq (get result :status) 0)
                          (let ((stderr (get result :stderr)))
                            (throw (new globalThis.Error (if (host-truth stderr) stderr (funcall globalThis.String (get result :error))))))))
                      (let ((index 0))
                        (while (< index (js-length modules))
                          (let* ((name (aref modules index)) (sourcePath (resolve root (str "bootstrap/compiler/" name ".eli")))
                                 (source (await (readFile sourcePath "utf8")))
                                 (emission (js-call frontend :compile_string_with_source_map source sourcePath (str name ".mjs") (relative compilerDirectory sourcePath))))
                            (await (writeFile (resolve compilerDirectory (str name ".mjs")) (str (get emission :javascript) "//# sourceMappingURL=" name ".mjs.map\n")))
                            (await (writeFile (resolve compilerDirectory (str name ".mjs.map")) (get emission :sourceMap))))
                          (setq index (1+ index)))))
                    (setq compiler (if (nullish? frontend)
                                     (await (funcall host-import (get (pathToFileURL (resolve compilerDirectory "compiler.mjs")) :href))) frontend))
                    (await (mkdir directory (js-object :recursive t)))
                    (let ((index 0))
                      (while (< index (js-length backendModules))
                        (let* ((name (aref backendModules index)) (sourcePath (resolve root (str "bootstrap/backends/" name ".eli")))
                               (outputPath (resolve directory (str name ".mjs"))))
                          (if (host-truth seed)
                            (let ((child (spawnSync (resolve root "bin/eliscript-seed") (js-array "--source-map" "--output" outputPath sourcePath)
                                           (js-object :cwd root :encoding "utf8" :timeout 120000))))
                              (unless (eq (get child :status) 0)
                                (let* ((stderr (get child :stderr))
                                       (failure (new globalThis.Error (str "Seed backend " name " (" sourcePath "): "
                                                  (if (host-truth stderr) stderr (funcall globalThis.String (get child :error))))
                                                  (js-object :cause (get child :error)))))
                                  (put failure :compilerModule name) (put failure :sourcePath sourcePath)
                                  (put failure :exitCode (get child :status)) (put failure :signal (get child :signal)) (throw failure))))
                            (let* ((source (await (readFile sourcePath "utf8")))
                                   (emission (js-call compiler :compile_string_with_source_map source sourcePath (str name ".mjs") (relative directory sourcePath))))
                              (await (writeFile outputPath (str (get emission :javascript) "//# sourceMappingURL=" name ".mjs.map\n")))
                              (await (writeFile (str outputPath ".map") (get emission :sourceMap))))))
                        (setq index (1+ index))))
                    (when cache-dir
                      (await (store-cached-backends cache-dir compilerDirectory directory modules)))))
                (finally
                  (when lock-held
                    (try (await (rm (str cache-dir ".lock") (js-object :recursive t :force t))) (catch _ nil)))))))
          (let* ((env (get globalThis.process :env))
                 (ir-cache-path (resolve (dirname (fileURLToPath module-url)) "../testing/artifact-cache.mjs"))
                 (cached-compiler
                   (if (and (= (aref env "ELISCRIPT_TEST_IR_CACHE") "1")
                            (/= (aref env "ELISCRIPT_DISABLE_TEST_IR_CACHE") "1")
                            (existsSync ir-cache-path))
                     (let ((cache-mod (await (funcall host-import (get (pathToFileURL ir-cache-path) :href)))))
                       (js-call cache-mod :createCachedCompiler compiler cache-key
                         (js-object :cacheRoot (resolve root ".eliscript-cache/test-framework/ir-cache"))))
                     compiler))
                 (result (js-object :compiler cached-compiler :directory directory)))
            (put result :loadLiteralModules (async ()
              (let ((literalSources (await (loadLiteralSources))))
                (js-object :literalSources literalSources :literalModules (js-call literalSources :map (lambda (record)
                  (js-object :id (get record :id) :program (js-call cached-compiler :compile_ir_string (get record :source) (get record :filename)))))))))
            (put result :optimizer (await (funcall host-import (get (pathToFileURL (resolve directory "optimize.mjs")) :href))))
            (put result :numeric (await (funcall host-import (get (pathToFileURL (resolve directory "numeric.mjs")) :href))))
            (put result :wasm (await (funcall host-import (get (pathToFileURL (resolve directory "wasm.mjs")) :href))))
            (put result :native (await (funcall host-import (get (pathToFileURL (resolve directory "native.mjs")) :href))))
            (put result :sha256 (await (funcall host-import (get (pathToFileURL (resolve directory "sha256.mjs")) :href))))
            (put result :regexp (await (funcall host-import (get (pathToFileURL (resolve directory "regexp.mjs")) :href))))
            (put result :managed (await (funcall host-import (get (pathToFileURL (resolve directory "managed.mjs")) :href)))) result)))))

  (defasync run-module-entry ()
(let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (host-truth entry) (eq (resolve entry) (fileURLToPath module-url)))
      (let ((result (await (buildBackends)))) (js-call (get globalThis.process :stdout) :write (str (get result :directory) "\n"))))))
  (js-call (run-module-entry) :catch (lambda (error)
    (js-call (get (js* "globalThis") :console) :error error)
    (put (get (js* "globalThis") :process) :exitCode 1)))
  (export root backendModules loadLiteralSources buildBackends))
