  ;; Read dynamic registrations as data. No suite, predicate oracle, callback,
  ;; or title expression is evaluated while collecting provenance.
  (defun originalParameterizedSourceCases (file source binding prefix decode-row title-of count fixed-count)
    (let* ((stream (tokens source)) (array-start -1) (array-end -1)
           (registration -1) (registration-end -1) (title-end -1)
           (loop-end -1) (loops (js-array)) (index 0) (rows (js-array)))
      (while (< index (js-length stream))
        (when (and (= (get (aref stream index) :text) "const")
                   (aref stream (+ index 3))
                   (= (get (aref stream (1+ index)) :text) binding)
                   (= (get (aref stream (+ index 2)) :text) "=")
                   (= (get (aref stream (+ index 3)) :text) "["))
          (when (>= array-start 0) (throw (new globalThis.TypeError "duplicate original parameter binding")))
          (setq array-start (+ index 3)) (setq array-end (closing stream array-start)))
        (when (and (= (get (aref stream index) :text) "test")
                   (aref stream (1+ index)) (= (get (aref stream (1+ index)) :text) "("))
          (let* ((end (closing stream (1+ index))) (cursor (+ index 2)) (separator -1))
            (while (and (< cursor end) (< separator 0))
              (let ((token (get (aref stream cursor) :text)))
                (cond ((js-call (js-array "(" "[" "{") :includes token)
                       (setq cursor (1+ (closing stream cursor))))
                      ((= token ",") (setq separator cursor))
                      (t (setq cursor (1+ cursor))))))
            (when (and (>= separator 0)
                       (js-call (js-call source :slice (get (aref stream (+ index 2)) :start)
                         (get (aref stream separator) :start)) :includes (JSON/stringify prefix)))
              (when (>= registration 0) (throw (new globalThis.TypeError "duplicate original dynamic registration")))
              (setq registration index) (setq registration-end end) (setq title-end separator))))
        (when (and (= (get (aref stream index) :text) "(")
                   (aref stream (+ index 7)) (= (get (aref stream (1+ index)) :text) binding)
                   (= (get (aref stream (+ index 2)) :text) ")")
                   (= (get (aref stream (+ index 3)) :text) "[")
                   (= (get (aref stream (+ index 4)) :type) "string")
                   (= (string-data (aref stream (+ index 4))) "forEach")
                   (= (get (aref stream (+ index 5)) :text) "]")
                   (= (get (aref stream (+ index 6)) :text) "("))
          (js-call loops :push (js-object :start index :end (closing stream (+ index 6)))))
        (setq index (1+ index)))
      (let ((owners (js-call loops :filter (lambda (loop)
               (and (< (get loop :start) registration) (> (get loop :end) registration-end))))))
        (unless (= (js-length owners) 1) (throw (new globalThis.TypeError "original parameter loop ownership changed")))
        (setq loop-end (get (aref owners 0) :end)))
      (unless (and (>= array-start 0) (> registration array-end) (> registration-end registration)
                   (> loop-end registration-end))
        (throw (new globalThis.TypeError "original parameter binding or registration boundary changed")))
      (setq index (1+ array-start))
      (while (< index array-end)
        (if (= (get (aref stream index) :text) ",") (setq index (1+ index))
          (let ((end (closing stream index)))
            (js-call rows :push (js-object :start (get (aref stream index) :start)
              :end (get (aref stream end) :end)
              :value (funcall decode-row stream index end)))
            (setq index (1+ end)))))
      (let* ((start (get (aref stream registration) :start))
             (end (get (aref stream registration-end) :end))
             (after (get (aref stream loop-end) :end))
             (before (parameter-registration-slice file (js-call source :slice 0 start)))
             (later (parameter-registration-slice file (js-call source :slice after)))
             (identity (hash source)) (body (js-call source :slice start end))
             (expression (js-call source :slice (get (aref stream (+ registration 2)) :start)
                           (get (aref stream title-end) :start))) (result (js-call before :slice)))
        (unless (and (= (js-length rows) count) (= (+ (js-length before) (js-length later)) fixed-count))
          (throw (new globalThis.TypeError "complete original parameterized inventory changed")))
        (js-call before :forEach (lambda (item) (put (get item :originalCase) :sourceSha256 identity)))
        (js-call rows :forEach (lambda (row variant)
          (let* ((value (get row :value)) (title (funcall title-of value))
                 (input-start (get row :start)) (input-end (get row :end)))
            (js-call result :push (js-object :id (str "stable-compatibility:source-case:" file ":" (js-length before) ":" variant)
              :file file :kind "test" :contains title :originalCase (js-object :title title :templateTitle prefix
                :titleExpression expression :parameters value :titleKind "expression" :sourceSha256 identity
                :registration "test" :timeoutMs 5000 :span (js-object :start start :end end)
                :byteStart (Buffer/byteLength (js-call source :slice 0 start))
                :byteEnd (Buffer/byteLength (js-call source :slice 0 end)) :sha256 (hash body)
                :input (js-object :span (js-object :start input-start :end input-end)
                  :byteStart (Buffer/byteLength (js-call source :slice 0 input-start))
                  :byteEnd (Buffer/byteLength (js-call source :slice 0 input-end))
                  :sha256 (hash (js-call source :slice input-start input-end)))))))))
        (js-call later :forEach (lambda (item offset)
          (let* ((original (get item :originalCase)) (span (get original :span))
                 (begin (+ after (get span :start))) (finish (+ after (get span :end))))
            (put item :id (str "stable-compatibility:source-case:" file ":" (+ (js-length before) 1 offset) ":0"))
            (put original :sourceSha256 identity) (put original :span (js-object :start begin :end finish))
            (put original :byteStart (Buffer/byteLength (js-call source :slice 0 begin)))
            (put original :byteEnd (Buffer/byteLength (js-call source :slice 0 finish)))
            (js-call result :push item)))) result)))

  (defun originalPredicateSourceCases (file source)
    (originalParameterizedSourceCases file source "cases" "Given original "
      (lambda (stream start end)
        (unless (and (= (get (aref stream start) :text) "[") (> end (+ start 5))
          (= (get (aref stream (1+ start)) :type) "string")
          (= (get (aref stream (+ start 2)) :text) ",")
          (= (get (aref stream (+ start 3)) :type) "string")
          (= (get (aref stream (+ start 4)) :text) ","))
          (throw (new globalThis.TypeError "original predicate row changed")))
        (js-object :file (string-data (aref stream (1+ start))) :name (string-data (aref stream (+ start 3)))))
      (lambda (row) (str "Given original " (get row :file) " helper " (get row :name)
        ", when compiled as an independent predicate unit, then managed WASM needs no raw JavaScript function")) 11 6))

  (defun originalIntegritySourceCases (file source)
    (originalParameterizedSourceCases file source "integrityScenarios" "Scenario: "
      (lambda (stream start end)
        (let ((index start) (result (js-object)))
          (when (= (get (aref stream index) :text) "(") (setq index (1+ index)))
          (unless (= (get (aref stream index) :text) "{")
            (throw (new globalThis.TypeError "original scenario object changed")))
          (setq index (1+ index))
