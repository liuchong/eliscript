(module tools.backends.compiler-corpus-managed-cases
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)

  (defconst originalManagedSuites
    (Object/freeze (js-array
                     "tests/compiler-session-tools.test.mjs"
                     "tests/wasm-managed-core-modules.test.mjs"
                     "tests/wasm-managed-transient-state.test.mjs"
                     "tests/wasm-managed-sorted-core.test.mjs"
                     "tests/wasm-managed-sequence-data.test.mjs"
                     "tests/wasm-managed-wire.test.mjs")))

  (defun hash (text)
    (js-call (js-call (createHash "sha256") :update text) :digest "hex"))

  ;; Read registration boundaries as source data. This does not import a suite,
  ;; evaluate its title expressions, run its loops, or execute assertion code.
  (defun tokens (source)
    (let ((result (js-array))
          (at 0)
          (len (js-length source))
          (ws-re (new globalThis.RegExp "\\s"))
          (flag-re (new globalThis.RegExp "[a-z]" "i"))
          (id-re (new globalThis.RegExp "^[$A-Z_a-z][$\\w]*"))
          (num-re (new globalThis.RegExp "^(?:0[xob][0-9a-f_]+|[0-9][0-9_.]*(?:e[+-]?[0-9_]+)?)" "i")))
      (while (< at len)
        (let ((start at)
              (c (aref source at)))
          (if (js-call ws-re :test c)
            (setq at (1+ at))
            (if (and (= c "/") (= (aref source (1+ at)) "/"))
              (while (and (< at len) (/= (aref source at) "\n"))
                (setq at (1+ at)))
              (if (and (= c "/") (= (aref source (1+ at)) "*"))
                (let ((end (js-call source :indexOf "*/" (+ at 2))))
                  (when (< end 0)
                    (throw (new globalThis.TypeError "unterminated original suite comment")))
                  (setq at (+ end 2)))
                (if (or (= c "\"") (= c "'") (= c "`"))
                  (let ((closed false))
                    (setq at (1+ at))
                    (while (and (< at len) (not closed))
                      (let ((next (aref source at)))
                        (setq at (1+ at))
                        (if (= next "\\")
                          (setq at (1+ at))
                          (when (= next c)
                            (setq closed t)))))
                    (unless closed
                      (throw (new globalThis.TypeError "unterminated original suite string")))
                    (js-call result :push
                      (js-object :type "string" :start start :end at :text (js-call source :slice start at))))
                  (let* ((previous (js-call result :at -1))
                         (regexp
                           (and (= c "/")
                                (or (not previous)
                                    (and (not (js-call (js-array "identifier" "number" "string") :includes (get previous :type)))
                                         (not (js-call (js-array ")" "]" "}") :includes (get previous :text))))
                                    (and (= (get previous :type) "identifier")
                                         (js-call (js-array "return" "throw" "case" "yield" "await") :includes (get previous :text)))))))
                    (if regexp
                      (let ((bracket false)
                            (closed false))
                        (setq at (1+ at))
                        (while (and (< at len) (not closed))
                          (let ((next (aref source at)))
                            (setq at (1+ at))
                            (cond
                              ((= next "\\") (setq at (1+ at)))
                              ((= next "[") (setq bracket t))
                              ((= next "]") (setq bracket false))
                              ((and (= next "/") (not bracket)) (setq closed t)))))
                        (unless closed
                          (throw (new globalThis.TypeError "unterminated original suite regular expression")))
                        (while (and (< at len) (js-call flag-re :test (let ((ch (aref source at))) (if (nullish? ch) "" ch))))
                          (setq at (1+ at)))
                        (js-call result :push
                          (js-object :type "regexp" :start start :end at :text (js-call source :slice start at))))
                      (let ((id-match (js-call id-re :exec (js-call source :slice at))))
                        (if id-match
                          (let ((text (aref id-match 0)))
                            (setq at (+ at (js-length text)))
                            (js-call result :push
                              (js-object :type "identifier" :start start :end at :text text)))
                          (let ((num-match (js-call num-re :exec (js-call source :slice at))))
                            (if num-match
                              (let ((text (aref num-match 0)))
                                (setq at (+ at (js-length text)))
                                (js-call result :push
                                  (js-object :type "number" :start start :end at :text text)))
                              (progn
                                (setq at (1+ at))
                                (js-call result :push
                                  (js-object :type "punctuation" :start start :end at :text c)))))))))))))))
      result))

  (defun closing (list start)
    (let ((pairs (js-object "(" ")" "[" "]" "{" "}"))
          (stack (js-array))
          (index start)
          (found -1))
      (while (and (< index (js-length list)) (< found 0))
        (let ((token (aref list index)))
          (when (= (get token :type) "punctuation")
            (let ((text (get token :text)))
              (if (get pairs text)
                (js-call stack :push (get pairs text))
                (when (js-call (js-array ")" "]" "}") :includes text)
                  (when (/= (js-call stack :pop) text)
                    (throw (new globalThis.TypeError "original suite registration has unbalanced source")))
                  (when (= (js-length stack) 0)
                    (setq found index)))))))
        (setq index (1+ index)))
      (when (< found 0)
        (throw (new globalThis.TypeError "original suite registration is incomplete")))
      found))

  (defun string-data (token)
    (let ((source (get token :text))
          (value "")
          (index 1)
          (escapes (js-object :n "\n" :r "\r" :t "\t" :b "\b" :f "\f" :v "\u000b" "0" "\u0000")))
      (while (< index (1- (js-length source)))
        (let ((character (aref source index)))
          (if (/= character "\\")
            (setq value (str value character))
            (progn
              (setq index (1+ index))
              (setq character (aref source index))
              (cond
                ((Object/hasOwn escapes character)
                 (setq value (str value (get escapes character))))
                ((= character "\n") nil)
                ((= character "\r")
                 (when (= (aref source (1+ index)) "\n")
                   (setq index (1+ index))))
                ((or (= character "u") (= character "x"))
                 (let* ((count (if (= character "u") 4 2))
                        (hex (js-call source :slice (1+ index) (+ index 1 count))))
                   (unless (js-call (new globalThis.RegExp (str "^[0-9a-f]{" count "}$") "i") :test hex)
                     (throw (new globalThis.TypeError "unsupported original title escape")))
                   (setq value (str value (String/fromCharCode (globalThis.parseInt hex 16))))
                   (setq index (+ index count))))
                (t (setq value (str value character)))))))
        (setq index (1+ index)))
      value))

  (defun iterator-step-value-p (list start step-name)
    (and (< (+ start 6) (js-length list))
      (= (get (aref list start) :text) "(")
      (= (get (aref list (+ start 1)) :text) step-name)
      (= (get (aref list (+ start 2)) :text) ")")
      (= (get (aref list (+ start 3)) :text) "[")
      (= (get (aref list (+ start 4)) :type) "string")
      (= (string-data (aref list (+ start 4))) "value")
      (= (get (aref list (+ start 5)) :text) "]")
      (= (get (aref list (+ start 6)) :text) ";")))

  (defun title-instances (list first last)
    (let* ((array-at
             (lambda (start)
               (let ((tok (aref list start)))
                 (when (or (not tok) (/= (get tok :text) "["))
                   (throw (new globalThis.TypeError "original title inputs must remain a literal array"))))
               (let ((end (closing list start))
                     (values (js-array))
                     (at (1+ start)))
                 (while (< at end)
                   (let ((token (aref list at)))
                     (unless (= (get token :text) ",")
                       (cond
                         ((= (get token :type) "string")
                          (js-call values :push (string-data token)))
                         ((= (get token :type) "number")
                          (js-call values :push (globalThis.Number (js-call (get token :text) :replaceAll "_" ""))))
                         (t (throw (new globalThis.TypeError "original title inputs acquired a computed value"))))))
                   (setq at (1+ at)))
                 values)))
           (constant
             (lambda (name)
               (let ((at 0)
                     (found undefined))
                 (while (and (< at (- (js-length list) 3)) (undefined? found))
                   (when (and (= (get (aref list at) :text) "const")
                              (= (get (aref list (1+ at)) :text) name)
                              (= (get (aref list (+ at 2)) :text) "="))
                     (setq found (funcall array-at (+ at 3))))
                   (setq at (1+ at)))
                 (when (undefined? found)
                   (throw (new globalThis.TypeError (str "original dynamic title lost its data binding: " name))))
                 found)))
           (binding
             (lambda (name)
               (let ((values undefined)
                     (iter-re (new globalThis.RegExp "^(__eli_iteration_\\d+_)sequence$"))
                     (at 0))
                 (while (< at first)
                   (when (and (= (get (aref list at) :text) "for")
                              (aref list (1+ at)) (= (get (aref list (1+ at)) :text) "(")
                              (aref list (+ at 2)) (= (get (aref list (+ at 2)) :text) "const")
                              (aref list (+ at 3)) (= (get (aref list (+ at 3)) :text) name)
                              (aref list (+ at 4)) (= (get (aref list (+ at 4)) :text) "of"))
                     (let* ((body (1+ (closing list (1+ at))))
                            (body-tok (aref list body))
                            (end (cond
                                   ((and body-tok (= (get body-tok :text) "{"))
                                    (closing list body))
                                   ((and body-tok
                                         (js-call (js-array "test" "actualTest") :includes (get body-tok :text))
                                         (aref list (1+ body))
                                         (= (get (aref list (1+ body)) :text) "("))
                                    (closing list (1+ body)))
                                   (t undefined))))
                       (when (and (not (undefined? end)) (<= body first) (>= end first))
                         (setq values
                           (if (= (get (aref list (+ at 5)) :text) "[")
                             (funcall array-at (+ at 5))
                             (funcall constant (get (aref list (+ at 5)) :text)))))))
                   (when (= (get (aref list at) :text) "(")
                     (let* ((next-tok (aref list (1+ at)))
                            (recv-close
                              (cond
                                ((and next-tok (= (get next-tok :text) "["))
                                 (closing list at))
                                ((and next-tok (= (get next-tok :type) "identifier")
                                      (aref list (+ at 2)) (= (get (aref list (+ at 2)) :text) ")"))
                                 (+ at 2))
                                (t -1)))
                            (call-open
                              (if (< recv-close 0)
                                -1
                                (cond
                                  ((and (aref list (1+ recv-close)) (= (get (aref list (1+ recv-close)) :text) "[")
                                        (aref list (+ recv-close 2)) (= (get (aref list (+ recv-close 2)) :type) "string")
                                        (= (string-data (aref list (+ recv-close 2))) "forEach")
                                        (aref list (+ recv-close 3)) (= (get (aref list (+ recv-close 3)) :text) "]")
                                        (aref list (+ recv-close 4)) (= (get (aref list (+ recv-close 4)) :text) "("))
                                   (+ recv-close 4))
                                  ((and (aref list (1+ recv-close)) (= (get (aref list (1+ recv-close)) :text) ".")
                                        (aref list (+ recv-close 2)) (= (get (aref list (+ recv-close 2)) :text) "forEach")
                                        (aref list (+ recv-close 3)) (= (get (aref list (+ recv-close 3)) :text) "("))
                                   (+ recv-close 3))
                                  (t -1)))))
                       (when (>= call-open 0)
                         (let ((call-end (closing list call-open)))
                           (when (and (<= call-open first) (>= call-end first))
                             (let ((param-idx (1+ call-open)))
                               (while (and (< param-idx call-end) (= (get (aref list param-idx) :text) "("))
                                 (setq param-idx (1+ param-idx)))
                               (when (and (< param-idx call-end)
                                          (= (get (aref list param-idx) :type) "identifier")
                                          (= (get (aref list param-idx) :text) name)
                                          (aref list (1+ param-idx))
                                          (or (= (get (aref list (1+ param-idx)) :text) ")")
                                              (= (get (aref list (1+ param-idx)) :text) ",")))
                                 (setq values
                                   (if (= (get next-tok :text) "[")
                                     (funcall array-at (1+ at))
                                     (funcall constant (get next-tok :text))))))))))
                     (when (and (aref list (1+ at)) (= (get (aref list (1+ at)) :text) "(")
                                (aref list (+ at 2)) (= (get (aref list (+ at 2)) :type) "identifier")
                                (aref list (+ at 3)) (= (get (aref list (+ at 3)) :text) ")")
                                (aref list (+ at 4)) (= (get (aref list (+ at 4)) :text) "=")
                                (aref list (+ at 5)) (= (get (aref list (+ at 5)) :text) ">"))
                       (let ((iter-match (js-call iter-re :exec (get (aref list (+ at 2)) :text))))
                         (when iter-match
                           (let ((fn-close (closing list at)))
                             (when (and (< at first) (> fn-close first)
                                        (aref list (1+ fn-close)) (= (get (aref list (1+ fn-close)) :text) "("))
                               (let ((step-name (str (aref iter-match 1) "step"))
                                     (scan (+ at 6))
                                     (matched false))
                                 (while (and (< scan first) (not matched))
                                   (when (and (= (get (aref list scan) :text) "let")
                                              (aref list (1+ scan)) (= (get (aref list (1+ scan)) :text) name)
                                              (aref list (+ scan 2)) (= (get (aref list (+ scan 2)) :text) "="))
                                     (if (iterator-step-value-p list (+ scan 3) step-name)
                                       (setq matched t)
                                       (when (and (aref list (+ scan 3)) (= (get (aref list (+ scan 3)) :type) "identifier"))
                                         (let ((val-var (get (aref list (+ scan 3)) :text))
                                               (back (Math/max at (- scan 20))))
                                           (while (and (< back scan) (not matched))
                                             (when (and (= (get (aref list back) :text) "const")
                                                        (aref list (1+ back)) (= (get (aref list (1+ back)) :text) val-var)
                                                        (aref list (+ back 2)) (= (get (aref list (+ back 2)) :text) "=")
                                                        (iterator-step-value-p list (+ back 3) step-name))
                                               (setq matched t))
                                             (setq back (1+ back)))))))
                                   (setq scan (1+ scan)))
                                 (when matched
                                   (let ((arg-tok (aref list (+ fn-close 2))))
                                     (when arg-tok
                                       (setq values
                                         (if (= (get arg-tok :text) "[")
                                           (funcall array-at (+ fn-close 2))
                                           (funcall constant (get arg-tok :text))))))))))))))
                   (setq at (1+ at)))
                 (when (undefined? values)
                   (throw (new globalThis.TypeError (str "original title lost its enclosing input loop: " name))))
                 values)))
           (first-token (aref list first))
           (template (and (= (get first-token :type) "string") (= (aref (get first-token :text) 0) "`")))
           (names (js-array))
           (interp-re (new globalThis.RegExp "\\$\\{([^}]+)\\}" "g"))
           (id-re (new globalThis.RegExp "^[$A-Z_a-z][$\\w]*$")))
      (if template
        (let ((matches (Array/from (js-call (string-data first-token) :matchAll interp-re)))
              (i 0))
          (while (< i (js-length matches))
            (let ((expr (aref (aref matches i) 1)))
              (unless (js-call id-re :test expr)
                (throw (new globalThis.TypeError "original title interpolation requires an explicit adapter")))
              (unless (js-call names :includes expr)
                (js-call names :push expr)))
            (setq i (1+ i))))
        (let ((at first))
          (while (< at last)
            (let ((token (aref list at)))
              (if (= (get token :type) "identifier")
                (unless (and (= (get token :text) "String")
                             (< (1+ at) last)
                             (= (get (aref list (1+ at)) :text) "("))
                  (unless (js-call names :includes (get token :text))
                    (js-call names :push (get token :text))))
                (unless (or (= (get token :type) "string")
                            (= (get token :type) "number")
                            (= (get token :text) "+")
                            (= (get token :text) "(")
                            (= (get token :text) ")"))
                  (throw (new globalThis.TypeError "original title expression requires an explicit adapter")))))
            (setq at (1+ at)))))
      (let ((variants (js-array (js-object)))
            (n-idx 0))
        (while (< n-idx (js-length names))
          (let* ((name (aref names n-idx))
                 (values (funcall binding name)))
            (setq variants
              (js-call variants :flatMap
                (lambda (parameters)
                  (js-call values :map
                    (lambda (value)
                      (let ((copy (Object/assign (js-object) parameters)))
                        (put copy name value)
                        copy)))))))
          (setq n-idx (1+ n-idx)))
        (js-call variants :map
          (lambda (parameters)
            (if template
              (js-object
                :parameters parameters
                :title (js-call (string-data first-token) :replace interp-re
                         (lambda (_all name) (globalThis.String (get parameters name)))))
              (let ((title "")
                    (at first))
                (while (< at last)
                  (let ((token (aref list at)))
                    (unless (or (= (get token :text) "+")
                                (= (get token :text) "(")
                                (= (get token :text) ")")
                                (and (= (get token :type) "identifier")
                                     (= (get token :text) "String")
                                     (< (1+ at) last)
                                     (= (get (aref list (1+ at)) :text) "(")))
                      (setq title
                        (str title
                          (cond
                            ((= (get token :type) "string") (string-data token))
                            ((= (get token :type) "identifier") (globalThis.String (get parameters (get token :text))))
                            (t (js-call (get token :text) :replaceAll "_" "")))))))
                  (setq at (1+ at)))
                (js-object :parameters parameters :title title))))))))

  ;; Other declared original adapters share the same source-only registration
  ;; reader. Admission remains with each adapter's explicit suite inventory.
  (defun originalSourceCaseLocators (file source)
    (when (or (/= (value-type file) "string")
              (not (js-call file :startsWith "tests/"))
              (not (js-call file :endsWith ".test.mjs"))
              (js-call (new globalThis.RegExp "[\\\\:\\u0000]") :test file)
              (js-call (js-call file :split "/") :some
                (lambda (part) (or (= part "") (= part ".") (= part ".."))))
              (/= (value-type source) "string"))
      (throw (new globalThis.TypeError "original cases require an exact relative source suite")))
    (let ((list (tokens source))
          (locators (js-array))
          (source-sha256 (hash source))
          (registration-index 0)
          (index 0)
          (auto-re (new globalThis.RegExp "(?:\\bruntime[.]auto|\\(runtime\\)\\[\"auto\"\\])\\(\\s*([0-9_]+)\\s*\\)")))
      (while (< index (js-length list))
        (let* ((token (aref list index))
               (prev (if (> index 0) (aref list (1- index)) nil)))
          (if (or (/= (get token :type) "identifier")
                  (not (js-call (js-array "test" "actualTest") :includes (get token :text)))
                  (and prev (= (get prev :text) ".")))
            (setq index (1+ index))
            (let ((open (1+ index))
                  (reg-start (get token :start)))
              (cond
                ((and (aref list open) (= (get (aref list open) :text) ".")
                      (aref list (1+ open)) (= (get (aref list (1+ open)) :text) "skipIf")
                      (aref list (+ open 2)) (= (get (aref list (+ open 2)) :text) "("))
                 (setq open (1+ (closing list (+ open 2)))))
                ((and (>= index 2)
                      (= (get (aref list (- index 2)) :text) "(")
                      (= (get (aref list (1- index)) :text) "(")
                      (aref list open) (= (get (aref list open) :text) ")")
                      (aref list (1+ open)) (= (get (aref list (1+ open)) :text) "[")
                      (aref list (+ open 2)) (= (get (aref list (+ open 2)) :type) "string")
                      (= (string-data (aref list (+ open 2))) "skipIf")
                      (aref list (+ open 3)) (= (get (aref list (+ open 3)) :text) "]")
                      (aref list (+ open 4)) (= (get (aref list (+ open 4)) :text) "("))
                 (let ((cond-close (closing list (+ open 4))))
                   (when (and (aref list (1+ cond-close)) (= (get (aref list (1+ cond-close)) :text) ")"))
                     (setq reg-start (get (aref list (- index 2)) :start))
                     (setq open (+ cond-close 2))))))
              (if (or (not (aref list open))
                      (/= (get (aref list open) :text) "(")
                      (not (aref list (1+ open)))
                      (not (or (= (get (aref list (1+ open)) :type) "string")
                               (and (= (get (aref list (1+ open)) :text) "(")
                                    (aref list (+ open 2)) (= (get (aref list (+ open 2)) :text) "String")
                                    (aref list (+ open 3)) (= (get (aref list (+ open 3)) :text) "(")))))
                (setq index (1+ index))
                (let ((end (closing list open))
                      (arguments (js-array))
                      (first (1+ open))
                      (part (1+ open))
                      (cursor (1+ open)))
                  (while (< cursor end)
                    (let ((current (aref list cursor)))
                      (cond
                        ((and (= (get current :type) "punctuation")
                              (js-call (js-array "(" "[" "{") :includes (get current :text)))
                         (setq cursor (1+ (closing list cursor))))
                        ((and (= (get current :type) "punctuation")
                              (= (get current :text) ","))
                         (js-call arguments :push (js-array part cursor))
                         (setq part (1+ cursor))
                         (setq cursor (1+ cursor)))
                        (t (setq cursor (1+ cursor))))))
                  (js-call arguments :push (js-array part end))
                  (when (< (js-length arguments) 2)
                    (throw (new globalThis.TypeError "original test registration lost its assertion body")))
                  (let* ((arg0-end (aref (aref arguments 0) 1))
                         (title-end (get (aref list (1- arg0-end)) :end))
                         (title-expression (js-call source :slice (get (aref list first) :start) title-end))
                         (template-title
                           (if (and (= (get (aref list first) :type) "string")
                                    (or (= (- arg0-end first) 1)
                                        (= (aref (get (aref list first) :text) 0) "`")))
                             (string-data (aref list first))
                             (let ((shape "") (scan first))
                               ;; The emitter spells interpolation as String
                               ;; concatenation. Preserve every literal and
                               ;; parameter instead of keeping only its first
                               ;; literal (often just "/"). title-instances
                               ;; below still validates the complete expression.
                               (while (< scan arg0-end)
                                 (let ((part (aref list scan)))
                                   (cond
                                     ((= (get part :type) "string")
                                      (setq shape (str shape (string-data part))))
                                     ((and (= (get part :type) "identifier")
                                           (/= (get part :text) "String"))
                                      (setq shape (str shape "${" (get part :text) "}")))
                                     ((= (get part :type) "number")
                                      (setq shape (str shape (js-call (get part :text) :replaceAll "_" ""))))))
                                 (setq scan (1+ scan)))
                               shape)))
                         (close-end (get (aref list end) :end))
                         (end-offset (+ close-end (if (= (aref source close-end) ";") 1 0)))
                         (registration (js-call source :slice reg-start end-offset))
                         (limit (aref arguments 2))
                         (timeout-ms 5000))
                    (when limit
                      (when (or (/= (- (aref limit 1) (aref limit 0)) 1)
                                (/= (get (aref list (aref limit 0)) :type) "number"))
                        (throw (new globalThis.TypeError "original case deadline is no longer a numeric literal")))
                      (setq timeout-ms (globalThis.Number (js-call (get (aref list (aref limit 0)) :text) :replaceAll "_" "")))
                      (when (or (not (Number/isSafeInteger timeout-ms)) (<= timeout-ms 0))
                        (throw (new globalThis.TypeError "invalid original case deadline"))))
                    (let ((instances (title-instances list first arg0-end))
                          (fixed-auto (js-call auto-re :exec registration))
                          (variant 0))
                      (while (< variant (js-length instances))
                        (let* ((inst (aref instances variant))
                               (parameters (get inst :parameters))
                               (title (get inst :title))
                               (orig-case
                                 (js-object
                                   :title title
                                   :templateTitle template-title
                                   :titleExpression title-expression
                                   :parameters parameters
                                   :titleKind (if (and (= (get (aref list first) :type) "string")
                                                       (= (aref (get (aref list first) :text) 0) "`"))
                                                "template"
                                                (if (= (- arg0-end first) 1) "literal" "expression"))
                                   :sourceSha256 source-sha256
