            (let ((token (get (aref stream index) :text)))
              (if (js-call (js-array "," "}" ")") :includes token) (setq index (1+ index))
                (progn
                  (unless (and (= (get (aref stream index) :type) "string")
                    (= (get (aref stream (1+ index)) :text) ":"))
                    (throw (new globalThis.TypeError "original scenario field syntax changed")))
                  (let ((key (string-data (aref stream index))) (value (+ index 2)))
                    (cond
                      ((= key "expected")
                       (unless (= (get (aref stream value) :text) "[")
                         (throw (new globalThis.TypeError "original scenario expectation must remain a literal array")))
                       (setq index (1+ (closing stream value))))
                      ((and (js-call (js-array "error" "recover") :includes key)
                            (or (= (get (aref stream value) :text) "true")
                                (= (get (aref stream value) :text) "false")
                                (= (get (aref stream value) :type) "number")))
                       (setq index (1+ value)))
                      ((and (js-call (js-array "id" "given" "when" "then" "source") :includes key)
                            (= (get (aref stream value) :type) "string"))
                       (put result key (string-data (aref stream value)))
                       (setq index (1+ value)))
                      (t (throw (new globalThis.TypeError "original scenario fields must remain literal strings")))))))))
          (unless (js-call (js-array "id" "given" "when" "then" "source") :every
                    (lambda (key) (Object/hasOwn result key)))
            (throw (new globalThis.TypeError "original scenario lost required fields")))
          (js-object :scenario result)))
      (lambda (row) (let ((value (get row :scenario)))
        (str "Scenario: " (get value :id) "\nGiven " (get value :given) "\nWhen " (get value :when) "\nThen " (get value :then)))) 4 17))

  (defun originalManagedCaseLocators (file source)
    (when (or (not (js-call originalManagedSuites :includes file))
              (/= (value-type source) "string"))
      (throw (new globalThis.TypeError "unregistered original managed source suite")))
    (originalSourceCaseLocators file source))

  (export originalManagedSuites originalManagedCaseLocators originalSourceCaseLocators originalPredicateSourceCases originalIntegritySourceCases))
