(module tools.backends.compiler-browser
  (import "./compiler-session.mjs" createCompilerSession encodeCompilerIR decodeCompilerSourceAsset)
  (import "./compiler-worker.mjs" installCompilerWorker createCompilerWorkerClient compilerSourceIdentity)

  (defconst artifact-resources (new globalThis.WeakMap))
  (defconst scheme-pattern "^[a-z][a-z0-9+.-]*:")
  (defconst module-pattern "\\.(?:mjs|js)$")
  (defconst digest-pattern "^[0-9a-f]{64}$")
  (defconst browser-hosts (js-array "javascript" "wasm"))
  (defconst binary-operations (js-array "project" "project-ir" "emit-ir"))
  (defconst read-only-operations (js-array "analyze" "query" "edit-preview"))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun defined-or (object key default)
    (let ((value (get object key)))
      (if (undefined? value) default value)))

  (defun at (supplied index default)
    (if (or (>= index (js-length supplied)) (undefined? (aref supplied index)))
      default (aref supplied index)))

  (defun input-or (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object) (aref supplied 0)))

  (defun page-base ()
    (let ((location globalThis.location))
      (if (nullish? location)
        (js* "import.meta.url")
        (let ((href (get location :href)))
          (if (nullish? href) (js* "import.meta.url") href)))))

  (defun abort (signal)
    (when (host-truthy signal)
      (if (= (host-type (get signal :throwIfAborted)) "function")
        (js-call signal :throwIfAborted)
        (when (host-truthy (get signal :aborted))
          (if (not (undefined? (get signal :reason)))
            (throw (get signal :reason))
            (let ((error (new globalThis.Error "browser compiler request aborted")))
              (put error :name "AbortError")
              (throw error)))))))

  (defun stale (message)
    (let ((error (new globalThis.Error message)))
      (put error :code "stale-source")
      error))

  (defun relative-url (path base label)
    (when (or (not (= (host-type path) "string"))
              (not (host-truthy path))
              (js-call path :startsWith "/")
              (js-call path :includes "\\")
              (js-call (new globalThis.RegExp scheme-pattern "i") :test path)
              (js-call (js-call path :split "/") :includes ".."))
      (throw (new globalThis.TypeError (str label " must be a relative artifact path"))))
    (new globalThis.URL path base))

  (defun resource-identity (manifest path)
    (if (not (js-call globalThis.Object :hasOwn manifest "artifactIdentity"))
      undefined
      (let ((files (js-call artifact-resources :get manifest)))
        (unless files
          (let ((identity (get manifest :artifactIdentity)))
            (when (or (not (= (host-get identity "algorithm") "sha256"))
                      (not (Array/isArray (host-get identity "files"))))
              (throw (new globalThis.TypeError "invalid compiler artifact resource identities")))
            (setq files (new globalThis.Map))
            (let ((records (get identity :files)) (index 0))
              (while (< index (js-length records))
                (let ((record (aref records index)))
                  (when (or (not (= (host-type (host-get record "path")) "string"))
                            (not (host-truthy (host-get record "path")))
                            (js-call files :has (get record :path))
                            (not (js-call globalThis.Number :isSafeInteger (get record :bytes)))
                            (< (get record :bytes) 0)
                            (not (= (host-type (get record :sha256)) "string"))
                            (not (js-call (new globalThis.RegExp digest-pattern) :test (get record :sha256))))
                    (throw (new globalThis.TypeError "invalid or repeated compiler artifact resource identity")))
                  (js-call files :set (get record :path)
                    (js-object :bytes (get record :bytes) :sha256 (get record :sha256))))
                (setq index (1+ index))))
            (js-call artifact-resources :set manifest files)))
        (let ((expected (js-call files :get path)))
          (unless expected
            (throw (new globalThis.TypeError (str "compiler resource has no artifact identity: " path))))
          expected))))

  (defasync response (url signal)
    (abort signal)
    (let ((result (await (funcall globalThis.fetch url (js-object :signal signal)))))
      (unless (host-truthy (get result :ok))
        (let ((error (new globalThis.Error
                       (str "compiler resource request failed: " (get result :status) " " (get result :statusText)))))
          (put error :status (get result :status))
          (put error :url (if (host-truthy (get result :url)) (get result :url) (funcall globalThis.String url)))
          (throw error)))
      (abort signal)
      result))

  (defasync resource-bytes (url signal identity)
    (let* ((resource (await (response url signal)))
           (bytes (new globalThis.Uint8Array (await (js-call resource :arrayBuffer)))))
      (abort signal)
      (when (host-truthy identity)
        (unless (= (get bytes :byteLength) (get identity :bytes))
          (throw (new globalThis.Error (str "compiler resource byte count mismatch: " url))))
        (let* ((crypto globalThis.crypto)
               (subtle (if (nullish? crypto) undefined (get crypto :subtle))))
          (unless (host-truthy subtle)
            (throw (new globalThis.Error "compiler resource SHA-256 verification is unavailable")))
          (let* ((digest (new globalThis.Uint8Array (await (js-call subtle :digest "SHA-256" bytes))))
                 (actual (js-call (Array/from digest
                                   (lambda (byte)
                                     (js-call (js-call byte :toString 16) :padStart 2 "0")))
                          :join "")))
            (abort signal)
            (unless (= actual (get identity :sha256))
              (throw (new globalThis.Error (str "compiler resource SHA-256 mismatch: " url)))))))
      bytes))

  (defasync source-text (url signal identity encoding)
    (decodeCompilerSourceAsset (await (resource-bytes url signal identity)) encoding))

  (defun merged-options (manifest options)
    (js-call globalThis.Object :assign (js-object) (get manifest :budget)
      (js-object :auto (get manifest :auto 65536)) options))

  (defasync session-configuration (input)
    (let ((host (get input :host))
          (manifest-url (get input :manifestURL))
          (options (defined-or input "options" (js-object)))
          (signal (get input :signal)))
      (unless (js-call browser-hosts :includes host)
        (throw (new globalThis.TypeError "browser compiler host must be javascript or wasm")))
      (unless (host-truthy manifest-url)
        (throw (new globalThis.TypeError "browser compiler requires an explicit artifact manifest URL")))
      (let* ((resolved (new globalThis.URL manifest-url (page-base)))
             (fetched (await (response resolved signal)))
             (manifest (await (js-call fetched :json))))
        (abort signal)
        (when (or (not (host-truthy manifest))
                  (not (= (host-type manifest) "object"))
                  (Array/isArray manifest)
                  (not (= (get manifest :host) host))
                  (and (not (undefined? (get manifest :target)))
                       (not (= (get manifest :target) host))))
          (throw (new globalThis.TypeError "compiler manifest does not match the requested browser host")))
        (let* ((base (new globalThis.URL "./" (if (host-truthy (get fetched :url)) (get fetched :url) (get resolved :href))))
               (artifact-url (relative-url (get manifest :path) base "compiler path"))
               (configuration (js-object :host host :memory (get manifest :memory (js-object))
                                 :options (merged-options manifest options))))
          (when (and (undefined? (host-get options "debug"))
                     (not (undefined? (get manifest :debugPath)))
                     (not (nil? (get manifest :debugPath))))
            (let ((bytes (await (resource-bytes
                                  (relative-url (get manifest :debugPath) base "compiler debug path")
                                  signal (resource-identity manifest (get manifest :debugPath))))))
              (put (get configuration :options) :debug
                (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode bytes)))
              (abort signal)))
          (if (= host "javascript")
            (progn
              (unless (js-call (new globalThis.RegExp module-pattern) :test (get artifact-url :pathname))
                (throw (new globalThis.TypeError "JavaScript compiler manifest must name a module")))
              (put configuration :compiler
                (await (funcall (js* "(specifier) => import(/* @vite-ignore */ specifier)") (get artifact-url :href))))
              (abort signal))
            (progn
              (put configuration :bytes
                (await (resource-bytes artifact-url signal (resource-identity manifest (get manifest :path)))))
              (abort signal)))
          (js-object :configuration configuration :manifest manifest
            :manifestURL (if (host-truthy (get fetched :url)) (get fetched :url) (get resolved :href)))))))

  (defasync installBrowserCompilerWorker (scope options)
    (installCompilerWorker scope (get (await (session-configuration options)) :configuration)))

  (defun key-for (payload)
    (if (Array/isArray (get payload :modules))
      (str (if (= (get payload :operation) "project-ir") "project-ir:" "project:") (get payload :entry))
      (if (= (host-type (get payload :ir)) "string")
        (str "ir:" (get payload :filename "<input>"))
        (if (= (host-type (get payload :source)) "string")
          (str "source:" (get payload :filename "<input>"))
          nil))))

  (defun snapshot-payload (payload)
    (let ((text (if (= (host-type payload) "string") payload (JSON/stringify payload))))
      (unless (= (host-type text) "string")
        (throw (new globalThis.TypeError "compiler request requires a JSON object")))
      (let ((value (JSON/parse text)))
        (when (or (nil? value) (not (= (host-type value) "object")) (Array/isArray value))
          (throw (new globalThis.TypeError "compiler request requires a JSON object")))
        value)))

  (defasync dispose-state (state)
    (unless (get state :closed)
      (put state :closed t)
      (js-call (get state :snapshots) :clear)
      (let ((failed nil) (failure nil))
        (try
          (if (and (host-truthy (get state :client)) (host-truthy (get state :ownsClient)))
            (await (js-call (get state :client) :close))
            (when (not (nullish? (get state :session)))
              (js-call (get state :session) :close)))
          (catch error
            (setq failed t)
            (setq failure error))
          (finally
            (when (not (nullish? (get state :ownedWorker)))
              (js-call (get state :ownedWorker) :terminate))
            (when (host-truthy (get state :blobURL))
              (js-call globalThis.URL :revokeObjectURL (get state :blobURL)))))
        (put state :client undefined)
        (put state :session undefined)
        (put state :ownedWorker undefined)
        (put state :blobURL undefined)
        (when failed (throw failure)))))

  (defun ensure-open (state)
    (when (get state :closed)
      (throw (new globalThis.Error "browser compiler is disposed"))))

  (defun worker-entry (configuration)
    (str "const waiting=[],loading=new AbortController();const hold=event=>{if(event.data?.type==='abort-browser-compiler-loading')loading.abort();else waiting.push(event.data);};self.addEventListener('message',hold);\n"
         "const{installBrowserCompilerWorker}=await import(" (JSON/stringify (js* "import.meta.url")) ");\n"
         "await installBrowserCompilerWorker(self,{..." (JSON/stringify configuration) ",signal:loading.signal});\n"
         "self.removeEventListener('message',hold);for(const data of waiting)self.dispatchEvent(new MessageEvent('message',{data}));\n"))

  (defasync open-compiler (state)
    (try
      (if (and (not (host-truthy (get state :client))) (host-truthy (get state :worker)))
        (progn
          (unless (= (host-type globalThis.Worker) "function")
            (throw (new globalThis.Error "module Workers are unavailable; select worker:false explicitly to use the same artifact on this thread")))
          (unless (host-truthy (get state :manifestURL))
            (throw (new globalThis.TypeError "browser compiler requires an explicit artifact manifest URL")))
          (let ((configuration (js-object :host (get state :host)
                                 :manifestURL (get (new globalThis.URL (get state :manifestURL) (page-base)) :href)
                                 :options (get state :options)))
                (blob nil))
            (setq blob (js-call globalThis.URL :createObjectURL
                         (new globalThis.Blob (js-array (worker-entry configuration))
                           (js-object :type "text/javascript"))))
            (put state :blobURL blob)
            (put state :ownedWorker (new globalThis.Worker blob (js-object :type "module")))
            (when (host-truthy (get state :signal))
              (let ((cancel (lambda ()
                              (try
                                (when (not (nullish? (get state :ownedWorker)))
                                  (js-call (get state :ownedWorker) :postMessage
                                    (js-object :type "abort-browser-compiler-loading")))
                                (catch ignored)))))
                (js-call (get state :signal) :addEventListener "abort" cancel (js-object :once t))
                (put state :removeLoadingAbort
                  (lambda () (js-call (get state :signal) :removeEventListener "abort" cancel)))
                (when (host-truthy (get (get state :signal) :aborted))
                  (funcall cancel))))
            (put state :client (createCompilerWorkerClient (get state :ownedWorker) (js-object :ownsWorker t)))
            (put state :ownsClient t)))
        (when (not (host-truthy (get state :client)))
          (let ((loaded (await (session-configuration
                                 (js-object :host (get state :host) :manifestURL (get state :manifestURL)
                                   :options (get state :options) :signal (get state :signal))))))
            (put state :artifactManifest (get loaded :manifest))
            (put state :artifactManifestURL (get loaded :manifestURL))
            (put state :session (await (createCompilerSession (get loaded :configuration))))
            (abort (get state :signal)))))
      (when (host-truthy (get state :client))
        (let ((client (get state :client)))
          (when (or (not (= (host-type (get client :request)) "function"))
                    (not (= (host-type (get client :setSource)) "function"))
                    (not (= (host-type (get client :close)) "function")))
            (throw (new globalThis.TypeError "browser compiler requires a compiler Worker client")))
          (let ((capabilities (await (js-call client :request (js-object :operation "capabilities")
                                       (js-object :signal (get state :signal))))))
            (unless (= (host-get capabilities "host") (get state :host))
              (throw (new globalThis.TypeError "compiler Worker is executing a different host artifact")))
            (abort (get state :signal)))))
      (catch error
        (try (await (dispose-state state)) (catch ignored))
        (throw error))
      (finally
        (when (not (nullish? (get state :removeLoadingAbort)))
          (funcall (get state :removeLoadingAbort)))
        (put state :removeLoadingAbort undefined))))

  (defasync dispatch-state (state payload request-options)
    (ensure-open state)
    (abort (host-get request-options "signal"))
    (if (not (host-truthy (get state :client)))
      (js-call (get state :session) :request payload request-options)
      (let ((reply (await (js-call (get state :client) :request payload request-options))))
        (ensure-open state)
        (unless (= (get reply :host) (get state :host))
          (throw (new globalThis.TypeError "compiler Worker changed its host artifact")))
        (get reply :result))))

  (defasync ensure-manifest (state signal)
    (when (and (not (host-truthy (get state :artifactManifest))) (host-truthy (get state :manifestURL)))
      (let* ((resolved (new globalThis.URL (get state :manifestURL) (page-base)))
             (fetched (await (response resolved signal)))
             (manifest (await (js-call fetched :json))))
        (ensure-open state)
        (abort signal)
        (when (or (not (host-truthy manifest)) (not (= (get manifest :host) (get state :host))))
          (throw (new globalThis.TypeError "compiler runtime manifest host mismatch")))
        (put state :artifactManifest manifest)
        (put state :artifactManifestURL (if (host-truthy (get fetched :url)) (get fetched :url) (get resolved :href))))))

  (defasync attach-literals (state payload request-options)
    (if (js-call globalThis.Object :hasOwn payload "literalSources")
      payload
      (progn
        (ensure-open state)
        (abort (get request-options :signal))
        (await (ensure-manifest state (get request-options :signal)))
        (if (undefined? (host-get (get state :artifactManifest) "literalSources"))
          payload
          (progn
            (unless (host-truthy (get state :literalSourcesLoading))
              (put state :literalSourcesLoading
                (js-call (funcall (async ()
                                   (unless (Array/isArray (get (get state :artifactManifest) :literalSources))
                                     (throw (new globalThis.TypeError "compiler literalSources must be an array")))
                                   (await (Promise/all
                                            (js-call (get (get state :artifactManifest) :literalSources) :map
                                              (lambda (item)
                                                (funcall (async ()
                                                  (when (or (not (= (host-type (host-get item "id")) "string"))
                                                            (not (= (host-type (get item :filename)) "string")))
                                                    (throw (new globalThis.TypeError "invalid compiler literal source asset")))
                                                  (let ((source (await (source-text
                                                                         (relative-url (get item :path)
                                                                           (new globalThis.URL "./" (get state :artifactManifestURL))
                                                                           "compiler literal source path")
                                                                         (get request-options :signal)
                                                                         (resource-identity (get state :artifactManifest) (get item :path))
                                                                         (get item :encoding)))))
                                                    (ensure-open state)
                                                    (abort (get request-options :signal))
                                                    (js-object :id (get item :id) :filename (get item :filename) :source source))))))))))
                  :catch (lambda (error)
                           (put state :literalSourcesLoading undefined)
                           (throw error)))))
            (let ((literal-sources (await (get state :literalSourcesLoading))))
              (ensure-open state)
              (abort (get request-options :signal))
              (js-call globalThis.Object :assign (js-object) payload (js-object :literalSources literal-sources))))))))

  (defasync load-runtime-state (state request-options)
    (ensure-open state)
    (abort (get request-options :signal))
    (unless (get state :runtimeReady)
      (unless (host-truthy (get state :runtimeLoading))
        (put state :runtimeLoading
          (funcall (async ()
            (let ((source (get state :runtimeSource)))
              (when (and (not (undefined? source)) (not (= (host-type source) "string")))
                (throw (new globalThis.TypeError "compiler runtime source must be a string")))
              (when (undefined? source)
                (let ((url nil) (identity nil) (encoding nil))
                  (if (not (undefined? (get state :runtimeURL)))
                    (setq url (new globalThis.URL (get state :runtimeURL) (page-base)))
                    (progn
                      (unless (host-truthy (get state :artifactManifest))
                        (unless (host-truthy (get state :manifestURL))
                          (throw (new globalThis.TypeError "binary output requires the compiler runtime source or an artifact manifest")))
                        (let* ((resolved (new globalThis.URL (get state :manifestURL) (page-base)))
                               (fetched (await (response resolved (get request-options :signal))))
                               (manifest (await (js-call fetched :json))))
                          (abort (get request-options :signal))
                          (when (or (not (host-truthy manifest)) (not (= (get manifest :host) (get state :host))))
                            (throw (new globalThis.TypeError "compiler runtime manifest host mismatch")))
                          (put state :artifactManifest manifest)
                          (put state :artifactManifestURL
                            (if (host-truthy (get fetched :url)) (get fetched :url) (get resolved :href)))))
                      (setq url (relative-url (get (get state :artifactManifest) :runtimePath)
                                  (new globalThis.URL "./" (get state :artifactManifestURL))
                                  "compiler runtime path"))
                      (setq identity (resource-identity (get state :artifactManifest)
                                       (get (get state :artifactManifest) :runtimePath)))
                      (setq encoding (get (get state :artifactManifest) :runtimeEncoding))))
                  (setq source (await (source-text url (get request-options :signal) identity encoding)))))
              (ensure-open state)
              (abort (get request-options :signal))
              (unless (get state :runtimeReady)
                (let ((request (await (attach-literals state
                                      (js-object :operation "runtime" :source source
                                        :filename "bootstrap/runtime/memory.eli")
                                      request-options))))
                  (ensure-open state)
                  (abort (get request-options :signal))
                  (unless (get state :runtimeReady)
                    (when (host-truthy (get state :client))
                      (await (remember-source state request (js-object :signal (get request-options :signal)))))
                    (ensure-open state)
                    (abort (get request-options :signal))
                    (unless (get state :runtimeReady)
                      (await (dispatch-state state request (js-object :signal (get request-options :signal))))
                      (put state :runtimeReady t))))))))))
      (let ((pending (get state :runtimeLoading)))
        (try
          (await pending)
          (ensure-open state)
          (abort (get request-options :signal))
          (finally
            (when (= (get state :runtimeLoading) pending)
              (put state :runtimeLoading undefined)))))))

  (defasync remember-source (state payload &rest supplied)
    (let* ((options (input-or supplied))
           (revision (get options :revision))
           (request-signal (get options :signal))
           (body (snapshot-payload payload))
           (key (key-for body)))
      (ensure-open state)
      (abort request-signal)
      (when (nil? key)
        (throw (new globalThis.TypeError "source snapshot requires source text or project modules")))
      (let* ((source-identity (await (compilerSourceIdentity body)))
             (previous (progn (ensure-open state) (abort request-signal)
                         (js-call (get state :snapshots) :get key)))
             (next-revision (if (not (nullish? revision))
                              revision
                              (if (and (not (nullish? previous))
                                       (= (get previous :sourceIdentity) source-identity))
                                (get previous :revision)
                                (+ (get state :sourceRevision) 1)))))
        (when (or (not (js-call globalThis.Number :isSafeInteger next-revision))
                  (< next-revision 0)
                  (and previous
                       (or (< next-revision (get previous :revision))
                           (and (= next-revision (get previous :revision))
                                (not (= (get previous :sourceIdentity) source-identity))))))
          (throw (stale "source snapshot belongs to an older revision")))
        (let ((next (js-object :revision next-revision :sourceIdentity source-identity)))
          (put state :sourceRevision (js-call globalThis.Math :max (get state :sourceRevision) next-revision))
          (js-call (get state :snapshots) :set key next)
          (try
            (when (host-truthy (get state :client))
              (await (js-call (get state :client) :setSource body
                       (js-object :revision next-revision :signal request-signal))))
            (ensure-open state)
            (abort request-signal)
            (js-call globalThis.Object :assign (js-object) next)
            (catch error
              (when (and (not (get state :closed))
                         (= (js-call (get state :snapshots) :get key) next))
                (if previous
                  (js-call (get state :snapshots) :set key previous)
                  (js-call (get state :snapshots) :delete key)))
              (throw error)))))))

  (defasync perform-request (state payload request-options)
    (ensure-open state)
    (abort (get request-options :signal))
    (setq payload (snapshot-payload payload))
    (when (= (get payload :operation) "runtime")
      (setq payload (await (attach-literals state payload request-options))))
    (when (and (js-call binary-operations :includes (get payload :operation))
               (or (= (get payload :target) "wasm") (= (get payload :target) "native")))
      (await (load-runtime-state state request-options)))
    (let ((key (key-for payload))
          (read-only (js-call read-only-operations :includes (get payload :operation)))
          (selected nil))
      (when (not (nil? key))
        (let ((source-identity (await (compilerSourceIdentity payload))))
          (ensure-open state)
          (abort (get request-options :signal))
          (let ((current (js-call (get state :snapshots) :get key)))
            (when (or (nullish? current) (not (= (get current :sourceIdentity) source-identity)))
              (when (or read-only
                        (not (undefined? (get request-options :expectedSourceIdentity)))
                        (not (undefined? (get request-options :expectedRevision))))
                (throw (stale "register the current source snapshot before requesting queries or applying older results")))
              (await (remember-source state payload (js-object :signal (get request-options :signal)))))
            (setq selected (js-call (get state :snapshots) :get key))
            (when (or (and (not (undefined? (get request-options :expectedSourceIdentity)))
                           (not (= (get request-options :expectedSourceIdentity) (get selected :sourceIdentity))))
                      (and (not (undefined? (get request-options :expectedRevision)))
                           (not (= (get request-options :expectedRevision) (get selected :revision)))))
              (throw (stale "request belongs to an older source snapshot"))))))
      (ensure-open state)
      (let ((result (await (dispatch-state state payload request-options))))
        (ensure-open state)
        (abort (get request-options :signal))
        (when (not (nil? key))
          (let ((current (js-call (get state :snapshots) :get key)))
            (when (or (nullish? current)
                      (not (= (get current :revision) (get selected :revision)))
                      (not (= (get current :sourceIdentity) (get selected :sourceIdentity))))
              (throw (stale "compiler response belongs to an older source snapshot")))))
        (when (= (get payload :operation) "runtime")
          (put state :runtimeReady t))
        result)))

  (defun with-operation (project operation)
    (js-call globalThis.Object :assign (js-object) project (js-object :operation operation)))

  (defasync createBrowserCompiler (&rest supplied)
    (let* ((input (input-or supplied))
           (host (defined-or input "host" "javascript")))
      (unless (js-call browser-hosts :includes host)
        (throw (new globalThis.TypeError "browser compiler host must be javascript or wasm")))
      (abort (get input :signal))
      (let ((state (js-object :host host :manifestURL (get input :manifestURL)
                     :worker (defined-or input "worker" t) :signal (get input :signal)
                     :options (defined-or input "options" (js-object))
                     :runtimeURL (get input :runtimeURL) :runtimeSource (get input :runtimeSource)
                     :session nil :client (get input :workerClient)
                     :ownsClient (defined-or input "ownsWorkerClient" false)
                     :ownedWorker nil :blobURL nil :closed false :removeLoadingAbort nil
                     :snapshots (new globalThis.Map) :sourceRevision 0
                     :artifactManifest nil :artifactManifestURL nil
                     :runtimeReady false :runtimeLoading nil :literalSourcesLoading nil)))
        (await (open-compiler state))
        (let ((dispose (async () (await (dispose-state state)))))
          (js-call globalThis.Object :freeze
            (js-object :host host
            :request (async (payload &rest args)
                       (await (perform-request state payload (at args 0 (js-object)))))
            :setSource (async (payload &rest args)
                         (await (remember-source state payload (at args 0 (js-object)))))
            :loadRuntime (async (&rest args)
                           (await (load-runtime-state state (at args 0 (js-object)))))
            :compile_string (async (source &rest args)
                              (get (await (perform-request state
                                            (js-object :operation "compile" :source source
                                              :filename (at args 0 "<input>")
                                              :macroContext (at args 1 nil))
                                            (at args 2 (js-object))))
                                :javascript))
            :compile_string_with_source_map
            (async (source &rest args)
              (let* ((filename (at args 0 "<input>"))
                     (result (await (perform-request state
                                      (js-object :operation "compile" :source source :filename filename
                                        :macroContext (at args 3 nil)
                                        :sourceMap (js-object :generatedFile (at args 1 "output.mjs")
                                                      :sourceName (at args 2 filename)))
                                      (at args 4 (js-object))))))
                (js-object :javascript (get result :javascript) :sourceMap (get result :sourceMap))))
            :compile_ir_string (async (source &rest args)
                                 (JSON/parse (get (await (perform-request state
                                                           (js-object :operation "compile-ir" :source source
                                                             :filename (at args 0 "<input>")
                                                             :macroContext (at args 1 nil))
                                                           (at args 2 (js-object))))
                                               :ir)))
            :serialize_ir_program (async (program &rest args)
                                    (get (await (perform-request state
                                                  (js-object :operation "serialize-ir" :ir (encodeCompilerIR program))
                                                  (at args 0 (js-object))))
                                      :canonicalIR))
            :deserialize_ir_program (async (canonical-ir &rest args)
                                      (JSON/parse (get (await (perform-request state
                                                                (js-object :operation "deserialize-ir"
                                                                  :canonicalIR canonical-ir)
                                                                (at args 0 (js-object))))
                                                    :ir)))
            :emit_ir_string (async (program &rest args)
                              (get (await (perform-request state
                                            (js-object :operation "emit-ir" :ir (encodeCompilerIR program))
                                            (at args 0 (js-object))))
                                :javascript))
            :emit_ir_string_with_source_map
            (async (program source &rest args)
              (await (perform-request state
                       (js-object :operation "emit-ir" :ir (encodeCompilerIR program) :source source
                         :sourceMap (js-object :generatedFile (at args 0 "output.mjs")
                                       :sourceName (at args 1 (get program :filename))))
                       (at args 2 (js-object)))))
            :compile_portable_ir_string
            (async (source entries &rest args)
              (JSON/parse (get (await (perform-request state
                                        (js-object :operation "compile-ir" :source source :filename (at args 0 "<input>")
                                          :macroContext (at args 1 nil) :portableEntries entries)
                                        (at args 2 (js-object))))
                            :ir)))
            :compile_project_portable_ir_string
            (async (source entries &rest args)
              (JSON/parse (get (await (perform-request state
                                        (js-object :operation "compile-ir" :source source :filename (at args 0 "<input>")
                                          :macroContext (at args 1 nil) :portableEntries entries
                                          :allowProjectImports t)
                                        (at args 2 (js-object))))
                            :ir)))
            :compile_portable_string
            (async (source entries &rest args)
              (get (await (perform-request state
                            (js-object :operation "compile" :source source :filename (at args 0 "<input>")
                              :macroContext (at args 1 nil) :portableEntries entries)
                            (at args 2 (js-object))))
                :javascript))
            :compile_portable_string_with_source_map
            (async (source entries &rest args)
              (let* ((filename (at args 0 "<input>"))
                     (result (await (perform-request state
                                      (js-object :operation "compile" :source source :filename filename
                                        :macroContext (at args 3 nil) :portableEntries entries
                                        :sourceMap (js-object :generatedFile (at args 1 "output.mjs")
                                                      :sourceName (at args 2 filename)))
                                      (at args 4 (js-object))))))
                (js-object :javascript (get result :javascript) :sourceMap (get result :sourceMap))))
            :format_source (async (source &rest args)
                             (get (await (perform-request state
                                           (js-object :operation "format" :source source
                                             :filename (at args 0 "<input>") :options (at args 1 nil))
                                           (at args 2 (js-object))))
                               :source))
            :compile_project (lambda (project &rest args)
                               (perform-request state (with-operation project "project") (at args 0 (js-object))))
            :project_plan (lambda (project &rest args)
                            (perform-request state (with-operation project "project-plan") (at args 0 (js-object))))
            :protocol (lambda (name input &rest args)
                        (perform-request state (js-object :operation "protocol" :name name :input input)
                          (at args 0 (js-object))))
            :analyze (lambda (input &rest args)
                       (perform-request state (with-operation input "analyze") (at args 0 (js-object))))
            :query (lambda (input &rest args)
                     (perform-request state (with-operation input "query") (at args 0 (js-object))))
            :dispose dispose
            :close dispose))))))

  (export installBrowserCompilerWorker createBrowserCompiler))
