(module tools.backends.native-benchmark
  (import "node:fs" readdirSync)
  (import "./compiler-host-iteration.mjs" openHostIterator advanceHostIterator closeHostIterator)
  (import "./compiler-host-record.mjs" copyHostRecord)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile writeFile mkdtemp rm readdir)
  (import "node:os" tmpdir cpus)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "./build.mjs" backendModules buildBackends root)
  (defconst module-url (js* "import.meta.url"))
  ;; The frozen native workload includes exactly one Bun FFI call per batch.
  (defconst inputs (js-array
    (js-object :name "recurrence-batch" :fn "recurrence_batch" :nativeFn "recurrence-batch" :args (js-array 1000000 0.123 2))
    (js-object :name "escape-grid-batch" :fn "escape_grid_batch" :nativeFn "escape-grid-batch" :args (js-array 160 64 2))
    (js-object :name "recurrence-tiny-batch" :fn "recurrence_batch" :nativeFn "recurrence-batch" :args (js-array 1 0.123 2000000))))
  (defconst parameters (js-object :sessions 3 :warmups 5 :samples 9 :minimumSpeedup 1))
  (defconst helperNames (js-array "compiler-host-iteration" "numeric-benchmark-kernel" "numeric-benchmark-runner"))
  (defconst files (js-call (js-call backendModules :map (lambda (n) (str "bootstrap/backends/" n ".eli"))) :concat
    (js-call (js-call (js-call (readdirSync (resolve root "bootstrap/compiler")) :filter
      (lambda (n) (js-call n :endsWith ".eli"))) :sort) :map (lambda (n) (str "bootstrap/compiler/" n)))
    (js-array "tools/backends/compiler-host-record.eli" "tools/backends/build.mjs" "tools/backends/native-benchmark.mjs" "tools/bootstrap-seed.el"
      "tools/backends/batches.eli" "tools/experiments/native-wasm/kernels.eli")
    (js-call helperNames :map (lambda (name) (str "tools/backends/" name ".eli")))))
  (defun hash (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun median (values) (aref (js-call (js-call values :slice) :sort (lambda (a b) (- a b))) (Math/floor (/ (js-length values) 2))))
  (defasync sources () (Object/fromEntries (await (Promise/all (js-call files :map (async (file)
    (js-array file (hash (await (readFile (resolve root file)))))))))))
  (defun summarize (sessions)
    (js-call inputs :map (lambda (input)
      (let* ((samples (lambda (mode) (js-call sessions :flatMap (lambda (session)
                (get (get (get (js-call (get session :results) :find (lambda (r) (eq (get r :name) (get input :name))))
                  :measurements) mode) :samplesMs)))))
             (jsMs (median (funcall samples "js"))) (nativeMs (median (funcall samples "native"))))
        (js-object :name (get input :name) :jsMs jsMs :nativeMs nativeMs :speedup (/ jsMs nativeMs))))))
  (defasync validateNativeReport (report &rest supplied)
    (let* ((options (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
           (verifySources (if (undefined? (get options :verifySources)) t (get options :verifySources))))
      (js-call assert :equal (get report :format) "eliscript-native-numeric-performance")
      (js-call assert :equal (get report :scope) "arm64-macos numeric-f64 hot execution including Bun FFI; not complete compiler performance")
      (js-call assert :deepEqual (get report :inputs) inputs) (js-call assert :deepEqual (get report :parameters) parameters)
      (when verifySources (js-call assert :deepEqual (get report :sourceHashes) (await (sources))))
      (js-call assert :equal (funcall (js* "(value) => typeof value") (get report :baseline)) "boolean")
      (js-call assert :deepEqual (js-call (Object/keys (get report :expected)) :sort)
        (js-call (js-call inputs :map (lambda (input) (get input :name))) :sort))
      (funcall assert (js-call (Object/values (get report :expected)) :every (get globalThis.Number :isFinite)))
      (js-call assert :equal (get (get report :environment) :platform) "darwin")
      (js-call assert :equal (get (get report :environment) :arch) "arm64")
      (js-call assert :equal (funcall (js* "(value) => typeof value") (get (get report :environment) :cpu)) "string")
      (funcall assert (> (js-length (get (get report :environment) :cpu)) 0))
      (js-call assert :equal (js-length (get report :sessions)) 3)
      (js-call assert :deepEqual (js-call (get report :sessions) :map (lambda (s) (get s :session))) (js-array 0 1 2))
      (let ((__eli_iterator_5 (openHostIterator (get report :sessions)))) (try (while (advanceHostIterator __eli_iterator_5) (let ((session (get __eli_iterator_5 :value))) (js-call assert :match (get session :version) (new globalThis.RegExp "^\\d+\\.\\d+\\.\\d+(?:[-+].*)?$")) (js-call assert :deepEqual (js-call (get session :results) :map (lambda (r) (get r :name))) (js-call inputs :map (lambda (i) (get i :name)))) (let ((__eli_iterator_3 (openHostIterator inputs))) (try (while (advanceHostIterator __eli_iterator_3) (let ((input (get __eli_iterator_3 :value))) (let ((__eli_iterator_1 (openHostIterator (js-array "js" "native")))) (try (while (advanceHostIterator __eli_iterator_1) (let ((mode (get __eli_iterator_1 :value))) (let ((value (get (get (js-call (get session :results) :find (lambda (r) (eq (get r :name) (get input :name)))) :measurements) mode)))
              (js-call assert :equal (js-length (get value :samplesMs)) 9)
              (funcall assert (js-call (get value :samplesMs) :every (lambda (n) (and (Number/isFinite n) (> n 0)))))
              (js-call assert :equal (js-length (get value :checksums)) 9)
              (funcall assert (js-call (get value :checksums) :every (lambda (n) (Object/is n (get (get report :expected) (get input :name))))))))) (catch __eli_iteration_error_2 (closeHostIterator __eli_iterator_1 t) (throw __eli_iteration_error_2)) (finally (closeHostIterator __eli_iterator_1 false)))))) (catch __eli_iteration_error_4 (closeHostIterator __eli_iterator_3 t) (throw __eli_iteration_error_4)) (finally (closeHostIterator __eli_iterator_3 false)))))) (catch __eli_iteration_error_6 (closeHostIterator __eli_iterator_5 t) (throw __eli_iteration_error_6)) (finally (closeHostIterator __eli_iterator_5 false))))
      (js-call assert :deepEqual (get report :summary) (summarize (get report :sessions)))
      (js-call assert :deepEqual (get report :decision) (js-object :productionPassed
        (js-call (get report :summary) :every (lambda (r) (>= (get r :speedup) 1))) :minimumSpeedup 1))
      (js-call assert :equal (get (get report :artifacts) :externalBackend) false)
      (funcall assert (and (Number/isSafeInteger (get (get report :artifacts) :nativeBytes)) (> (get (get report :artifacts) :nativeBytes) 4096)))
      (let ((__eli_iterator_7 (openHostIterator (js-array "javascriptSha256" "nativeSha256")))) (try (while (advanceHostIterator __eli_iterator_7) (let ((key (get __eli_iterator_7 :value))) (js-call assert :match (get (get report :artifacts) key) (new globalThis.RegExp "^[a-f0-9]{64}$")))) (catch __eli_iteration_error_8 (closeHostIterator __eli_iterator_7 t) (throw __eli_iteration_error_8)) (finally (closeHostIterator __eli_iterator_7 false))))
      report))
  (defasync runNativeBenchmark (&rest supplied)
    (let* ((options (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
           (baseline (if (undefined? (get options :baseline)) false (get options :baseline))))
      (funcall assert (and (eq (get globalThis.process :platform) "darwin") (eq (get globalThis.process :arch) "arm64")) "native measurement requires its actual target")
      (let ((sourceHashes (await (sources))) (directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-perf-")))))
        (try
          (let* ((backends (await (buildBackends (js-object :outputRoot directory))))
                 (compiler (get backends :compiler)) (numeric (get backends :numeric)) (native (get backends :native))
                 (source (str (await (readFile (resolve root "tools/experiments/native-wasm/kernels.eli") "utf8")) "\n"
                              (await (readFile (resolve root "tools/backends/batches.eli") "utf8"))))
                 (program (js-call compiler :compile_ir_string source "direct-batches.eli"))
                 (javascript (js-call numeric :emit_numeric_javascript program))
                 (bytes (Uint8Array/from (js-call native :emit_native_numeric_library program "arm64-macos" (js-object :registerAllocation (not baseline)))))
                 (jsPath (resolve directory "batches.mjs")) (library (resolve directory "batches.dylib"))
                 (runner (resolve directory "numeric-benchmark-runner.mjs")) (sessions (js-array)) (session 0))
            (await (writeFile jsPath javascript)) (await (writeFile library bytes))
            (let ((__eli_iterator_9 (openHostIterator helperNames))) (try (while (advanceHostIterator __eli_iterator_9) (let ((name (get __eli_iterator_9 :value))) (let ((filename (resolve root (str "tools/backends/" name ".eli"))))
                (await (writeFile (resolve directory (str name ".mjs"))
                  (js-call compiler :compile_string (await (readFile filename "utf8")) filename)))))) (catch __eli_iteration_error_10 (closeHostIterator __eli_iterator_9 t) (throw __eli_iteration_error_10)) (finally (closeHostIterator __eli_iterator_9 false))))
            (while (< session 3)
              (let ((child (spawnSync "bun" (js-array runner (get (pathToFileURL jsPath) :href) library
                      (funcall globalThis.String session) "native" (JSON/stringify inputs) (JSON/stringify parameters))
                      (js-object :encoding "utf8" :timeout 120000))))
                (js-call assert :equal (get child :status) 0 (get child :stderr))
                (js-call sessions :push (copyHostRecord (js-object :session session) (JSON/parse (get child :stdout)))))
              (setq session (1+ session)))
            (let ((report (js-object :format "eliscript-native-numeric-performance" :generatedAt (js-call (new globalThis.Date) :toISOString)
              :scope "arm64-macos numeric-f64 hot execution including Bun FFI; not complete compiler performance"
              :parameters parameters :inputs inputs :baseline baseline :environment (js-object :platform (get globalThis.process :platform)
                :arch (get globalThis.process :arch) :cpu (get (aref (cpus) 0) :model)) :sourceHashes sourceHashes
              :artifacts (js-object :javascriptSha256 (hash javascript) :nativeSha256 (hash bytes) :nativeBytes (js-length bytes) :externalBackend false)
              :expected (Object/fromEntries (js-call inputs :map (lambda (input) (js-array (get input :name)
                (aref (get (get (get (js-call (get (aref sessions 0) :results) :find
                  (lambda (r) (eq (get r :name) (get input :name)))) :measurements) :js) :checksums) 0)))))
              :sessions sessions :summary (summarize sessions))))
              (put report :decision (js-object :productionPassed (js-call (get report :summary) :every (lambda (r) (>= (get r :speedup) 1))) :minimumSpeedup 1))
              (await (validateNativeReport report))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (defasync run-module-entry ()
(when (and (funcall (js* "(value) => !!value") (aref (get globalThis.process :argv) 1))
             (eq (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath module-url)))
    (let* ((args (js-call (get globalThis.process :argv) :slice 2)) (baseline (js-call args :includes "--baseline")))
      (funcall assert (js-call args :every (lambda (a) (js-call (js-array "--verify" "--require-production" "--baseline") :includes a))) "unknown native benchmark argument")
      (let* ((path (resolve root (str "tools/backends/results/native-" (if baseline "baseline-" "") "macos-arm64.json")))
             (verify (or (js-call args :includes "--verify") (js-call args :includes "--require-production")))
             (report (if verify (await (validateNativeReport (JSON/parse (await (readFile path "utf8"))))) (await (runNativeBenchmark (js-object :baseline baseline))))))
        (unless verify (await (writeFile path (str (JSON/stringify report nil 2) "\n"))))
        (js-call assert :equal (get report :baseline) baseline "baseline selection must match the retained report")
        (console/log (JSON/stringify (js-object :summary (get report :summary) :decision (get report :decision)) nil 2))
        (when (and (js-call args :includes "--require-production") (not (get (get report :decision) :productionPassed))) (put globalThis.process :exitCode 1))))))
  (js-call (run-module-entry) :catch (lambda (error)
    (js-call (get (js* "globalThis") :console) :error error)
    (put (get (js* "globalThis") :process) :exitCode 1)))
  (export validateNativeReport runNativeBenchmark))
