(module tools.backends.compiler-bootstrap
  (import "./compiler-host-iteration.mjs" openHostIterator advanceHostIterator closeHostIterator)
  (import "./compiler-host-record.mjs" copyHostRecord)
  (import "node:crypto" createHash randomUUID)
  (import "node:fs/promises" mkdir readFile writeFile rename mkdtemp lstat open unlink)
  (import "node:fs" createReadStream)
  (import "node:path" resolve join dirname relative sep)
  (import "node:url" pathToFileURL)
  (import "./build.mjs" root)
  (import "./compiler-build.mjs" loadCompilerSources buildIndependentCompiler independentCompilerProductIdentity compilerMetadataDigest writeCompilerMetadata writeOwnedCompilerMetadata)
  (import "./compiler-session.mjs" createCompilerSession registerCompilerBuildProductForwarder registerVerifiedCompilerBuildConsumption)
  (import "./compiler-metadata.mjs" createCompilerMetadataDecoder)
  (import "./compiler-debug.mjs" ownCompilerDebugDocument)

  (defconst compilerHosts (js-call globalThis.Object :freeze (js-array "javascript" "wasm" "native")))
  (defconst verified-sessions (new globalThis.WeakSet))
  (defconst module-id-pattern "[\\\\:\\u0000]")
  (defconst digest-pattern "^[0-9a-f]{64}$")
  (defconst archive-path-pattern "^source-codeunits\\/(?:runtime[.]utf16le|(?:module|host|literal)\\/[0-9]+[.]utf16le)$")
  (defconst script-path-pattern "\\.(?:mjs|js)$")
  (defconst failure-fields (js-array "eliscriptDiagnostic" "diagnostics" "macroOrigins" "code" "eliscriptFrames" "eliscriptSourceFrames"))

  (defun host-type (value) (funcall (js* "(value) => typeof value") value))
  (defun host-truthy (value) (funcall (js* "(value) => !!value") value))
  (defun host-get (value key) (if (nullish? value) undefined (get value key)))
  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
  (defun text-of (value) (funcall globalThis.String value))

  (defun isVerifiedCompilerBuildSession (session) (js-call verified-sessions :has session))

  (defun normalizeCompilerHost (value)
    (let ((host (if (= value "js") "javascript" value)))
      (unless (js-call compilerHosts :includes host)
        (throw (new globalThis.TypeError "compiler host must be javascript, wasm or native")))
      host))

  (defun compilerDigest (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))

  (defasync saveCompilerMetadata (path value)
    (let ((temporary (str path "." (randomUUID) ".tmp")))
      (await (writeCompilerMetadata temporary value (js-object :flag "wx")))
      (await (rename temporary path))))

  (defasync saveOwnedCompilerMetadata (path value)
    (let ((temporary (str path "." (randomUUID) ".tmp")) (published false) (failed false))
      (try
        (let ((digest (await (writeOwnedCompilerMetadata temporary value))))
          (await (rename temporary path))
          (setq published t)
          digest)
        (catch error (setq failed t) (throw error))
        (finally
          (unless published
            (try (await (unlink temporary))
              (catch error
                (unless (or failed (= (get error :code) "ENOENT")) (throw error)))))))))

  (defun failure-property (value name)
    (try (if (nullish? value) undefined (get value name)) (catch ignored undefined)))

  (defun failure-text (value fallback)
    (try (text-of value) (catch ignored fallback)))

  (defun failure-data (value ancestors)
    (cond
      ((or (nil? value) (undefined? value) (= (host-type value) "string") (= (host-type value) "boolean") (= (host-type value) "number")) value)
      ((= (host-type value) "bigint") (js-call value :toString))
      ((not (= (host-type value) "object")) undefined)
      ((or (js-call ancestors :has value) (>= (get ancestors :size) 64)) (js-object :truncatedCause t))
      (t
       (let ((path (new globalThis.Set ancestors)))
         (js-call path :add value)
         (try
           (if (Array/isArray value)
             (let ((result (js-array)) (index 0))
               (while (< index (js-length value))
                 (js-call result :push (failure-data (failure-property value index) path))
                 (setq index (1+ index)))
               result)
             (let ((result (js-object)) (keys (js-call globalThis.Object :keys value)) (index 0))
               (while (< index (js-length keys))
                 (let* ((key (aref keys index))
                        (item (failure-data (failure-property value key) path)))
                   (when (not (undefined? item))
                     (js-call globalThis.Object :defineProperty result key
                       (js-object :value item :enumerable t :writable t :configurable t))))
                 (setq index (1+ index)))
               result))
           (catch ignored (js-object :truncatedCause t)))))))

  (defun compilerFailure (error &rest supplied)
    (let* ((ancestors (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (new globalThis.Set) (aref supplied 0)))
           (name (failure-property error "name"))
           (message (failure-property error "message"))
           (record (js-object
                     :name (if (nullish? name) "Error" (failure-text name "Error"))
                     :message (if (nullish? message) (failure-text error "unavailable error") (failure-text message "unavailable error")))))
      (when (and (not (nil? error)) (or (= (host-type error) "object") (= (host-type error) "function"))
                 (not (or (js-call ancestors :has error) (>= (get ancestors :size) 64))))
        (setq ancestors (new globalThis.Set ancestors))
        (js-call ancestors :add error))
      (if (and (not (nil? error)) (or (= (host-type error) "object") (= (host-type error) "function"))
               (or (js-call (new globalThis.Set (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (new globalThis.Set) (aref supplied 0))) :has error)
                   (>= (get (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (new globalThis.Set) (aref supplied 0)) :size) 64)))
        (js-call globalThis.Object :assign (js-object) record (js-object :truncatedCause t))
        (progn
      (let ((stack (failure-property error "stack")) (index 0))
        (when (not (undefined? stack))
          (put record :stack (failure-text stack "unavailable stack")))
        (while (< index (js-length failure-fields))
          (let* ((key (aref failure-fields index)) (field (failure-property error key)))
            (when (not (undefined? field))
              (let ((keep t))
                (when (or (= key "eliscriptFrames") (= key "eliscriptSourceFrames"))
                  (try (unless (Array/isArray field) (setq keep nil)) (catch ignored (setq keep nil))))
                (when keep
                  (let ((data (failure-data field ancestors)))
                    (when (not (undefined? data)) (put record key data)))))))
          (setq index (1+ index)))
        (let ((errors (failure-property error "errors")))
          (when (not (undefined? errors))
            (try
              (if (Array/isArray errors)
                (if (or (js-call ancestors :has errors) (>= (get ancestors :size) 64))
                  (put record :errors (js-object :truncatedCause t))
                  (let ((path (new globalThis.Set ancestors)) (cursor 0))
                    (js-call path :add errors)
                    (put record :errors (js-array))
                    (while (< cursor (js-length errors))
                      (js-call (get record :errors) :push (compilerFailure (failure-property errors cursor) path))
                      (setq cursor (1+ cursor)))))
                (put record :errors (failure-data errors ancestors)))
              (catch ignored (put record :errors (js-object :truncatedCause t))))))
        (let ((cause (failure-property error "cause")))
          (when (not (undefined? cause))
            (put record :cause (compilerFailure cause ancestors)))))
      record))))

  (defun module-id (id)
    (when (or (not (= (host-type id) "string")) (not (host-truthy id))
              (js-call (new globalThis.RegExp module-id-pattern) :test id)
              (let ((parts (js-call id :split "/")) (index 0) (bad nil))
                (while (and (not bad) (< index (js-length parts)))
                  (let ((part (aref parts index)))
                    (when (or (not (host-truthy part)) (= part ".") (= part "..")) (setq bad t)))
                  (setq index (1+ index)))
                bad))
      (throw (new globalThis.TypeError "compiler module requires a relative source identity")))
    id)

  (defun declaration-data (value ancestors)
    (cond
      ((or (nil? value) (= (host-type value) "string") (= (host-type value) "boolean")) value)
      ((and (= (host-type value) "number") (js-call globalThis.Number :isFinite value)) value)
      ((or (not (= (host-type value) "object")) (js-call ancestors :has value))
       (throw (new globalThis.TypeError "host declarations require finite JSON data")))
      (t
       (let ((prototype (js-call globalThis.Object :getPrototypeOf value)))
         (when (and (not (Array/isArray value)) (not (= prototype (get globalThis.Object :prototype))) (not (nil? prototype)))
           (throw (new globalThis.TypeError "host declarations require plain JSON records")))
         (when (> (js-length (js-call globalThis.Object :getOwnPropertySymbols value)) 0)
           (throw (new globalThis.TypeError "host declarations cannot contain symbol keys")))
         (let ((path (new globalThis.Set ancestors)))
           (js-call path :add value)
           (if (Array/isArray value)
             (progn
               (unless (= (js-length (js-call globalThis.Object :keys value)) (js-length value))
                 (throw (new globalThis.TypeError "host declarations require dense JSON arrays")))
               (let ((result (js-array)) (index 0))
                 (while (< index (js-length value))
                   (unless (js-call globalThis.Object :hasOwn value index)
                     (throw (new globalThis.TypeError "host declarations require dense JSON arrays")))
                   (js-call result :push (declaration-data (aref value index) path))
                   (setq index (1+ index)))
                 result))
             (js-call globalThis.Object :fromEntries
               (js-call (js-call (js-call globalThis.Object :keys value) :sort) :map
                 (lambda (key) (js-array key (declaration-data (get value key) path)))))))))))

  (defun each-source-bytes (source encoding consume)
    (let ((offset 0))
      (while (< offset (js-length source))
        (let ((end (js-call globalThis.Math :min (js-length source)
                     (+ offset (if (= encoding "utf8") 16384 32768)))))
          (when (and (= encoding "utf8") (< end (js-length source))
                     (>= (js-call source :charCodeAt (1- end)) 55296) (<= (js-call source :charCodeAt (1- end)) 56319)
                     (>= (js-call source :charCodeAt end) 56320) (<= (js-call source :charCodeAt end) 57343))
            (setq end (1- end)))
          (funcall consume (js-call globalThis.Buffer :from (js-call source :slice offset end) encoding))
          (setq offset end)))))

  (defun source-text-digest (source)
    (let ((hash (createHash "sha256")))
      (each-source-bytes source "utf16le" (lambda (bytes) (js-call hash :update bytes)))
      (js-object :encoding "utf16le" :sha256 (js-call hash :digest "hex") :bytes (* (js-length source) 2))))

  (defun compare-id (left right)
    (if (< (get left :id) (get right :id)) -1 (if (> (get left :id) (get right :id)) 1 0)))

  (defun source-declaration (sources)
    (let ((input-modules (host-get sources "modules"))
          (input-runtime (host-get sources "runtime")))
      (when (or (not (Array/isArray input-modules)) (= (js-length input-modules) 0)
                (not input-runtime))
        (throw (new globalThis.TypeError "complete compiler modules and runtime source are required")))
      (let* ((runtime-source (host-get input-runtime "source"))
             (snapshot (js-object :modules (js-array)))
             (ids (new globalThis.Set)))
        (unless (= (host-type runtime-source) "string")
          (throw (new globalThis.TypeError "complete compiler modules and runtime source are required")))
        (let ((modules (js-call input-modules :map
                         (lambda (record)
                           (let ((id (module-id (host-get record "id")))
                                 (source (get record :source))
                                 (filename (get record :filename)))
                             (when (or (js-call ids :has id) (not (= (host-type source) "string")) (not (= (host-type filename) "string")))
                               (throw (new globalThis.TypeError "invalid compiler source record")))
                             (js-call ids :add id)
                             (js-call (get snapshot :modules) :push (js-object :id id :filename filename :source source))
                             (js-call globalThis.Object :assign (js-object :id id :filename filename) (source-text-digest source)))))))
        (js-call modules :sort compare-id)
        (unless (js-call ids :has (get sources :entry))
          (throw (new globalThis.TypeError "compiler entry and runtime filename are required")))
        (unless (= (host-type (get input-runtime :filename)) "string")
          (throw (new globalThis.TypeError "compiler entry and runtime filename are required")))
        (put snapshot :entry (get sources :entry))
        (put snapshot :runtime (js-object :filename (get input-runtime :filename) :source runtime-source))
        (let ((identity (js-object :encoding "utf16le" :entry (get sources :entry) :modules modules
                          :runtime (js-call globalThis.Object :assign
                                    (js-object :filename (get input-runtime :filename))
                                    (source-text-digest runtime-source)))))
          (when (js-call globalThis.Object :hasOwn sources "hostModules")
            (unless (Array/isArray (get sources :hostModules))
              (throw (new globalThis.TypeError "compiler hostModules must be an array")))
            (put identity :hostModules (declaration-data (get sources :hostModules) (new globalThis.Set)))
            (put snapshot :hostModules (get identity :hostModules)))
          (when (js-call globalThis.Object :hasOwn sources "hostSources")
            (unless (Array/isArray (get sources :hostSources))
              (throw (new globalThis.TypeError "compiler hostSources must be an array")))
            (put snapshot :hostSources (js-array))
            (put identity :hostSources
              (js-call (get sources :hostSources) :map
                (lambda (record)
                  (let* ((id (module-id (host-get record "id")))
                         (filename (get record :filename id))
                         (source (get record :source)))
                    (when (or (js-call ids :has id) (not (= (host-type source) "string")) (not (= (host-type filename) "string")))
                      (throw (new globalThis.TypeError "invalid compiler host source record")))
                    (js-call ids :add id)
                    (js-call (get snapshot :hostSources) :push (js-object :id id :filename filename :source source))
                    (js-call globalThis.Object :assign (js-object :id id :filename filename) (source-text-digest source)))))))
          (when (js-call globalThis.Object :hasOwn sources "phased")
            (unless (= (host-type (get sources :phased)) "boolean")
              (throw (new globalThis.TypeError "compiler phased input must be boolean")))
            (put identity :phased (get sources :phased))
            (put snapshot :phased (get sources :phased)))
          (when (js-call globalThis.Object :hasOwn sources "literalSources")
            (unless (Array/isArray (get sources :literalSources))
              (throw (new globalThis.TypeError "compiler literalSources must be an array")))
            (put snapshot :literalSources (js-array))
            (put identity :literalSources
              (js-call (get sources :literalSources) :map
                (lambda (record)
                  (let ((id (module-id (host-get record "id")))
                        (filename (get record :filename))
                        (source (get record :source)))
                    (when (or (js-call ids :has id) (not (= (host-type filename) "string")) (not (= (host-type source) "string")))
                      (throw (new globalThis.TypeError "invalid or colliding persistent literal source")))
                    (js-call ids :add id)
                    (js-call (get snapshot :literalSources) :push (js-object :id id :filename filename :source source))
                    (js-call globalThis.Object :assign (js-object :id id :filename filename) (source-text-digest source)))))))
          (put identity :sha256 (get (source-text-digest (JSON/stringify identity)) :sha256))
          (js-object :sources snapshot :identity identity))))))

  (defun compilerSourceIdentity (sources) (get (source-declaration sources) :identity))

  (defasync write-source-text (path source encoding)
    (let ((file (await (open path "wx"))) (hash (createHash "sha256")) (bytes 0) (failed nil) (offset 0))
      (try
        (while (< offset (js-length source))
          (let ((end (js-call globalThis.Math :min (js-length source)
                       (+ offset (if (= encoding "utf8") 16384 32768)))))
            (when (and (= encoding "utf8") (< end (js-length source))
                       (>= (js-call source :charCodeAt (1- end)) 55296) (<= (js-call source :charCodeAt (1- end)) 56319)
                       (>= (js-call source :charCodeAt end) 56320) (<= (js-call source :charCodeAt end) 57343))
              (setq end (1- end)))
            (let ((block (js-call globalThis.Buffer :from (js-call source :slice offset end) encoding))
                  (position 0))
              (js-call hash :update block)
              (setq bytes (+ bytes (js-length block)))
              (while (< position (js-length block))
                (let* ((written (await (js-call file :write block position (- (js-length block) position) nil)))
                       (count (get written :bytesWritten)))
                  (unless (and (js-call globalThis.Number :isInteger count) (>= count 1) (<= count (- (js-length block) position)))
                    (throw (new globalThis.Error "compiler source archive write did not advance")))
                  (setq position (+ position count)))))
            (setq offset end)))
        (js-object :bytes bytes :sha256 (js-call hash :digest "hex"))
        (catch error (setq failed t) (throw error))
        (finally
          (try (await (js-call file :close))
            (catch error (unless failed (throw error))))))))

  (defun archived-tool-path (kind id)
    (cond ((= kind "runtime") "runtime.eli")
      ((= kind "module") (str "modules/" (module-id id) ".eli"))
      ((= kind "host") (str "host-sources/" (module-id id)))
      ((= kind "literal") (str "literal-sources/" (module-id id) ".eli"))
      (t (throw (new globalThis.TypeError "unknown archived compiler source kind")))))

  (defun tool-lossless (source)
    (let ((index 0) (ok t))
      (while (and ok (< index (js-length source)))
        (let ((unit (js-call source :charCodeAt index)))
          (cond
            ((and (>= unit 55296) (<= unit 56319))
             (let ((next (js-call source :charCodeAt (1+ index))))
               (if (and (>= next 56320) (<= next 57343)) (setq index (+ index 2)) (setq ok false))))
            ((and (>= unit 56320) (<= unit 57343)) (setq ok false))
            (t (setq index (1+ index))))))
      ok))

  (defasync archive-one (directory records kind record index)
    (let ((archive-path (if (= kind "runtime") "source-codeunits/runtime.utf16le"
                          (str "source-codeunits/" kind "/" (js-call (funcall globalThis.String index) :padStart 4 "0") ".utf16le")))
          (tool-path (archived-tool-path kind (get record :id))))
      (await (mkdir (dirname (join directory archive-path)) (js-object :recursive t)))
      (await (mkdir (dirname (join directory tool-path)) (js-object :recursive t)))
      (let ((raw (await (write-source-text (join directory archive-path) (get record :source) "utf16le")))
            (tool (await (write-source-text (join directory tool-path) (get record :source) "utf8"))))
        (js-call records :push
          (js-call globalThis.Object :assign
            (js-object :kind kind :id (if (= kind "runtime") nil (get record :id))
              :filename (get record :filename) :path archive-path :encoding "utf16le")
            raw
            (js-object :tool (js-call globalThis.Object :assign
                              (js-object :path tool-path :encoding "utf8" :role "tool-projection"
                                :lossless (tool-lossless (get record :source)))
                              tool)))))))

  (defasync archiveCompilerSources (sources directory)
    (let* ((declaration (source-declaration sources))
           (identity (get declaration :identity))
           (snapshot (get declaration :sources))
           (records (js-array))
           (index 0))
      (await (mkdir directory (js-object :recursive t)))
      (while (< index (js-length (get snapshot :modules)))
        (await (archive-one directory records "module" (aref (get snapshot :modules) index) index))
        (setq index (1+ index)))
      (setq index 0)
      (let ((hosts (if (nullish? (get snapshot :hostSources)) (js-array) (get snapshot :hostSources))))
        (while (< index (js-length hosts))
          (await (archive-one directory records "host" (aref hosts index) index))
          (setq index (1+ index))))
      (setq index 0)
      (let ((literals (if (nullish? (get snapshot :literalSources)) (js-array) (get snapshot :literalSources))))
        (while (< index (js-length literals))
          (await (archive-one directory records "literal" (aref literals index) index))
          (setq index (1+ index))))
      (await (archive-one directory records "runtime" (get snapshot :runtime) 0))
      (await (saveCompilerMetadata (join directory "identity.json") identity))
      (await (saveCompilerMetadata (join directory "source-archive.json")
               (js-object :format "eliscript-compiler-source-archive" :version 1 :encoding "utf16le"
                 :identityPath "identity.json" :identitySha256 (get identity :sha256) :records records)))
      identity))

  (defasync archived-bytes (directory path consume)
    (module-id path)
    (let ((parts (js-call path :split "/")) (index 0))
      (while (< index (js-length parts))
        (let ((info (await (lstat (apply resolve (js-call (js-array directory) :concat (js-call parts :slice 0 (1+ index))))))))
          (unless (if (= index (1- (js-length parts))) (js-call info :isFile) (js-call info :isDirectory))
            (throw (new globalThis.Error (str "compiler source archive contains an unsupported file entry: " path)))))
        (setq index (1+ index))))
    (let ((file (await (open (resolve directory path) "r")))
          (buffer (js-call globalThis.Buffer :allocUnsafe 65536))
          (hash (createHash "sha256"))
          (bytes 0)
          (failed nil))
      (try
        (let ((done nil))
          (while (not done)
            (let* ((read (await (js-call file :read buffer 0 (js-length buffer) nil)))
                   (count (get read :bytesRead)))
              (unless (and (js-call globalThis.Number :isInteger count) (>= count 0) (<= count (js-length buffer)))
                (throw (new globalThis.Error "compiler source archive read returned an invalid byte count")))
              (if (= count 0)
                (setq done t)
                (let ((block (js-call buffer :subarray 0 count)))
                  (js-call hash :update block)
                  (setq bytes (+ bytes count))
                  (funcall consume block))))))
        (js-object :bytes bytes :sha256 (js-call hash :digest "hex"))
        (catch error (setq failed t) (throw error))
        (finally (try (await (js-call file :close)) (catch error (unless failed (throw error))))))))

  (defun archived-file-matches (record actual label)
    (unless (and (js-call globalThis.Number :isSafeInteger (host-get record "bytes"))
                 (>= (host-get record "bytes") 0)
                 (js-call (new globalThis.RegExp digest-pattern) :test (get record :sha256 ""))
                 (= (get actual :bytes) (get record :bytes))
                 (= (get actual :sha256) (get record :sha256)))
      (throw (new globalThis.Error (str "compiler source archive " label " bytes differ from their identity")))))

  (defasync read-archived-json (directory path)
    (let ((decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t)))
          (parser (createCompilerMetadataDecoder))
          (decode-failed nil) (decode-failure nil) (parse-failed nil) (parse-failure nil))
      (await (archived-bytes directory path
               (lambda (block)
                 (unless decode-failed
                   (let ((text nil) (decoded t))
                     (try (setq text (js-call decoder :decode block (js-object :stream t)))
                       (catch error (setq decode-failed t) (setq decode-failure error) (setq decoded nil)))
                     (when (and decoded (not parse-failed))
                       (try (js-call parser :write text) (catch error (setq parse-failed t) (setq parse-failure error)))))))))
      (when decode-failed (throw decode-failure))
      (let ((tail (js-call decoder :decode)))
        (when parse-failed (throw parse-failure))
        (js-call parser :write tail)
        (js-call parser :finish))))

  (defun utf8-blocks (source)
    (let ((offset 0))
      (lambda ()
        (if (>= offset (js-length source))
          (js-object :done t)
          (let ((start offset)
                (end (js-call globalThis.Math :min (js-length source) (+ offset 16384))))
            (when (and (< end (js-length source))
                       (>= (js-call source :charCodeAt (1- end)) 55296) (<= (js-call source :charCodeAt (1- end)) 56319)
                       (>= (js-call source :charCodeAt end) 56320) (<= (js-call source :charCodeAt end) 57343))
              (setq end (1- end)))
            (setq offset end)
            (js-object :done false :value (js-call globalThis.Buffer :from (js-call source :slice start end) "utf8")))))))

  (defun inventory-sources (kind records expected seen-ids)
    (unless (Array/isArray records)
      (throw (new globalThis.TypeError "compiler source archive has an incomplete source inventory")))
    (let ((index 0))
      (while (< index (js-length records))
        (let* ((record (aref records index)) (id (module-id (host-get record "id"))))
          (when (or (js-call seen-ids :has id) (not (= (host-type (get record :filename)) "string")))
            (throw (new globalThis.TypeError "duplicate or invalid archived compiler source identity")))
          (js-call seen-ids :add id)
          (js-call expected :set (str kind ":" id) record))
        (setq index (1+ index)))))

  (defasync readArchivedCompilerSources (directory &rest supplied)
    (let* ((options (call-options supplied))
           (manifest (await (read-archived-json directory "source-archive.json")))
           (identity (await (read-archived-json directory "identity.json"))))
      (unless (and (= (host-get manifest "format") "eliscript-compiler-source-archive")
                   (= (get manifest :version) 1) (= (get manifest :encoding) "utf16le")
                   (= (get manifest :identityPath) "identity.json")
                   (Array/isArray (get manifest :records))
