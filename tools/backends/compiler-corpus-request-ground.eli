(module tools.backends.compiler-corpus-request-ground
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "node:fs/promises" readdir)
  (import "./compiler-corpus-runtime-adapters.mjs" addOriginalStdlibRuntimeAdapters originalRuntimeHostArtifact isOriginalRuntimeHostOnly originalRuntimeHostCompletionSource originalRuntimeOnlyCase)
  (import "./compiler-corpus-evaluation-adapters.mjs" addOriginalEvaluationPrograms)
  (import "./compiler-corpus-project-adapters.mjs" addOriginalProjectPrograms)
  (import "./compiler-corpus-cli-adapters.mjs" addOriginalCLIPrograms)
  (import "./compiler-corpus-managed-adapters.mjs" addOriginalManagedLibraryAdapters)
  (import "./compiler-corpus-managed-fixtures.mjs" addOriginalManagedFixtureAdapters)
  (import "./compiler-corpus-tools-artifact-adapters.mjs" addOriginalToolsArtifactPrograms originalToolsHostGateCase)
  (import "./compiler-corpus-identity-value-adapters.mjs" addOriginalIdentityValueAdapters)
  (import "./compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)
  (import "./compiler-corpus-source-ground.mjs"
    null? nullish-or digest stages originalReportOnlyLocators originalDataLiteral originalRegion
    eli-head-p eli-symbol-p eli-binding-p eli-node-text eli-walk eli-one eli-module-members
    eli-named-member eli-test-case eli-static-data stable-fixture-source maintained-fixture-proof
    suite-case-region sourcePath createOriginalCorpusSourceReader
    cloneCompilerCorpusData cloneCompilerCorpusModules cloneSourceProjectRequest)
  (import "./compiler-corpus-migrated-ground.mjs"
    addOriginalFormatterRecipes addOriginalGeneratedNamesRecipes addOriginalESMRecipes addOriginalCompilerModulePrograms)

  (defasync loadOriginalCompilerCorpus (options)
    (let* ((sourceRoot (get options :sourceRoot))
           (originals (get options :originals)))
      (when (or (not (and originals (get originals :manifests))) (/= (value-type sourceRoot) "string"))
        (throw (new globalThis.TypeError "original compiler manifests and sourceRoot are required")))
      (let* ((parity (js-call (get originals :manifests) :find (lambda (item) (= (get item :id) "compiler-parity"))))
             (stable (js-call (get originals :manifests) :find (lambda (item) (= (get item :id) "stable-compatibility")))))
        (when (or (not parity) (not stable))
          (throw (new globalThis.Error "both original compiler corpora are required")))
        (let* ((records (js-array))
               (claimed (new globalThis.Set))
               (irCases (js-array))
               (fullyMappedSuites (new globalThis.Set))
               (reader (createOriginalCorpusSourceReader (js-object :sourceRoot sourceRoot)))
               (file (get reader :file))
               (text (get reader :text))
               (sourceEvidence (get reader :evidence))
               (json (async (filename) (JSON/parse (await (funcall text filename)))))
               (diagnostics (await (funcall json "contracts/diagnostic-corpus.json")))
               (add (lambda (record)
                      (js-call (get record :coverage) :forEach (lambda (id) (js-call claimed :add id)))
                      (js-call records :push record)))
               (bindCoverage
                 (lambda (record ids)
                   (when (or (not (js-call records :includes record))
                             (not (Array/isArray ids))
                             (js-call ids :some (lambda (id)
                               (or (/= (value-type id) "string")
                                   (not (js-call (get originals :requiredCoverage) :includes id))))))
                     (throw (new globalThis.TypeError "original coverage must bind an existing recipe and retained identities")))
                   (js-call ids :forEach (lambda (id)
                     (unless (js-call (get record :coverage) :includes id)
                       (js-call (get record :coverage) :push id))
                     (js-call claimed :add id)))))
               (stableFiles (new globalThis.Set (get (get stable :document) :fixtureFiles)))
               (parity-fixtures (get (get parity :document) :fixtures))
               (pf-idx 0))
          (while (< pf-idx (js-length parity-fixtures))
            (let ((fixture (aref parity-fixtures pf-idx)))
              (unless (js-call stages :has (get fixture :id))
                (throw (new globalThis.Error (str "unrepresented original compiler stage: " (get fixture :id)))))
              (let ((suite (await (funcall json (get fixture :file))))
                    (classifications (js-array "valid" "invalid"))
                    (c-idx 0))
                (while (< c-idx (js-length classifications))
                  (let* ((classification (aref classifications c-idx))
                         (cases (if (and (not (Object/hasOwn suite classification)) (= (get fixture classification) 0))
                                  (js-array)
                                  (get suite classification))))
                    (when (or (not (Array/isArray cases)) (/= (js-length cases) (get fixture classification)))
                      (throw (new globalThis.Error (str "original fixture case count changed: " (get fixture :file) ":" classification))))
                    (let ((index 0))
                      (while (< index (js-length cases))
                        (let* ((item (aref cases index))
                               (source (if (Object/hasOwn item "source")
                                         (get item :source)
                                         (await (funcall text (get item :file))))))
                          (when (or (/= (value-type source) "string") (/= (value-type (get item :filename)) "string"))
                            (throw (new globalThis.Error (str "unrepresented original source case: " (get fixture :file) ":" index))))
                          (let* ((id (str "compiler-parity:" (get fixture :id) ":" classification ":" index))
                                 (coverage (js-array id)))
                            (await (funcall file (str "tests/bootstrap-" (get fixture :id) "-oracle.el")))
                            (when (js-call stableFiles :has (get fixture :file))
                              (js-call coverage :push (str "stable-compatibility:" (get fixture :file))))
                            (let* ((diag-suite (and (get diagnostics :suites)
                                                    (js-call (get diagnostics :suites) :find (lambda (s) (= (get s :id) (get fixture :id))))))
                                   (diagnostic (and diag-suite (get diag-suite :cases)
                                                    (js-call (get diag-suite :cases) :find (lambda (c) (= (get c :name) (get item :name))))))
                                   (expected (if (= classification "invalid")
                                               (let ((exp (js-object :kind "diagnostic" :message (get item :error))))
                                                 (when diagnostic (put exp :diagnostic (get diagnostic :diagnostic)))
                                                 exp)
                                               (js-object :kind "stage" :oracleRequired t)))
                                   (request (js-object :operation "stage" :stage (get fixture :id) :source source :filename (get item :filename)))
                                   (rec (js-object :id id :kind "stage" :coverage coverage :request request :expected expected
                                          :original (js-object :manifest (get parity :id) :fixture (get fixture :file)
                                                      :classification classification :index index
                                                      :case (globalThis.structuredClone item)))))
                              (when (Object/hasOwn item "macroContext")
                                (put request :macroContext (globalThis.structuredClone (get item :macroContext))))
                              (when (get item :file)
                                (put rec :dependencies (js-array (get item :file))))
                              (funcall add rec)
                              (when (and (= (get fixture :id) "ir") (= classification "valid"))
                                (js-call irCases :push (js-object :source source :filename (get item :filename) :name (get item :name)))
                                (await (funcall file "tests/bootstrap-emitter-oracle.el"))
                                (funcall add
                                  (js-object :id (str id ":emitter") :kind "stage" :coverage (js-call coverage :slice)
                                    :request (Object/assign (js-object) request
                                               (js-object :stage "emitter"
                                                 :sourceMap (js-object :generatedFile "fixture.mjs" :sourceName (get item :filename))))
                                    :expected (js-object :kind "stage" :oracleRequired t)
                                    :original (js-object :manifest (get parity :id) :fixture (get fixture :file)
                                                :classification classification :index index
                                                :case (globalThis.structuredClone item)
                                                :suite "tests/bootstrap-emitter.test.mjs")))))))
                        (setq index (1+ index)))))
                  (setq c-idx (1+ c-idx)))))
            (setq pf-idx (1+ pf-idx)))
          (let ((sf-list (get (get stable :document) :fixtureFiles))
                (sf-idx 0))
            (while (< sf-idx (js-length sf-list))
              (let ((filename (aref sf-list sf-idx)))
                (await (funcall file filename))
                (when (js-call filename :endsWith ".json")
                  (let ((document (JSON/parse (await (funcall text filename)))))
                    (when (and document (= (get document :format) "eliscript-managed-bdd"))
                      (when (not (Array/isArray (get document :features)))
                        (throw (new globalThis.Error "unsupported original BDD catalog shape")))
                      (let ((ids (new globalThis.Set))
                            (features (get document :features))
                            (f-idx 0))
                        (while (< f-idx (js-length features))
                          (let ((feature (aref features f-idx)))
                            (unless (Array/isArray (get feature :scenarios))
                              (throw (new globalThis.Error "original BDD feature has no scenarios")))
                            (let ((scenarios (get feature :scenarios))
                                  (s-idx 0))
                              (while (< s-idx (js-length scenarios))
                                (let ((scenario (aref scenarios s-idx)))
                                  (when (or (/= (value-type (get scenario :id)) "string")
                                            (js-call ids :has (get scenario :id))
                                            (/= (value-type (get scenario :source)) "string"))
                                    (throw (new globalThis.Error "invalid original BDD scenario")))
                                  (js-call ids :add (get scenario :id))
                                  (let* ((suffix (str "\n(export run" (if (Object/hasOwn scenario "recover") " recover" "") ")"))
                                         (source (str ";中😀\n(defconst marker 1)\n" (get scenario :source) suffix))
                                         (sourceFilename (str "bdd-" (get scenario :id) ".eli")))
                                    (funcall add
                                      (js-object :id (str "stable-compatibility:bdd:" (get scenario :id))
                                        :kind "project" :coverage (js-array (str "stable-compatibility:" filename))
                                        :modules (js-array (js-object :id "entry.mjs" :filename sourceFilename :source source))
                                        :entry "entry.mjs" :request (js-object :operation "project") :auto 1
                                        :execution (js-object :kind "managed-bdd" :export "run" :scenario (globalThis.structuredClone scenario))
                                        :expected (js-object :kind "managed-bdd" :scenario (globalThis.structuredClone scenario))
                                        :original (js-object :manifest (get stable :id) :fixture filename :feature (get feature :name)
                                                    :case (globalThis.structuredClone scenario)
                                                    :sourceRecipe (js-object :prefix ";中😀\n(defconst marker 1)\n" :suffix suffix)
                                                    :suite "tests/wasm-managed-behavior.test.mjs")))))
                                (setq s-idx (1+ s-idx)))))
                          (setq f-idx (1+ f-idx))))))))
              (setq sf-idx (1+ sf-idx))))
          (let* ((conformance (await (funcall json "tests/conformance/manifest.json")))
                 (features (new globalThis.Map (js-call (get conformance :features) :map (lambda (f) (js-array (get f :id) f)))))
                 (locators (js-array))
                 (stable-fids (get (get stable :document) :stableCoreFeatureIds))
                 (fid-idx 0))
            (while (< fid-idx (js-length stable-fids))
              (let* ((featureId (aref stable-fids fid-idx))
                     (feature (js-call features :get featureId)))
                (when (or (not feature) (/= (get feature :status) "stable"))
                  (throw (new globalThis.Error (str "original stable feature is unavailable: " featureId))))
                (let ((ev-list (nullish-or (get feature :evidence) (js-array)))
                      (index 0))
                  (while (< index (js-length ev-list))
                    (let ((locator (aref ev-list index)))
                      (await (funcall file (get locator :file)))
                      (js-call locators :push
                        (Object/assign (js-object :id (str "stable-compatibility:evidence:" featureId ":" index) :featureId featureId)
                          (globalThis.structuredClone locator))))
                    (setq index (1+ index)))))
              (setq fid-idx (1+ fid-idx)))
            (unless (= (js-length locators) (get (get stable :document) :evidenceLocatorCount))
              (throw (new globalThis.Error "original stable evidence inventory changed")))
            (let ((dimensions (get (get parity :document) :dimensions))
                  (d-idx 0))
              (while (< d-idx (js-length dimensions))
                (let* ((dimension (aref dimensions d-idx))
                       (ev-list (get dimension :evidence))
                       (index 0))
                  (while (< index (js-length ev-list))
                    (let ((locator (aref ev-list index)))
                      (await (funcall file (get locator :file)))
                      (js-call locators :push
                        (Object/assign (js-object :id (str "compiler-parity:dimension:" (get dimension :id) ":" index) :dimension (get dimension :id))
                          (globalThis.structuredClone locator))))
                    (setq index (1+ index))))
                (setq d-idx (1+ d-idx))))
            (let ((add-locs (nullish-or (get originals :additionalLocators) (js-array)))
                  (al-idx 0))
              (while (< al-idx (js-length add-locs))
                (let* ((locator (aref add-locs al-idx))
                       (original (await (funcall file (get locator :file)))))
                  (unless (= (get original :sha256) (and (get locator :originalCase) (get (get locator :originalCase) :sourceSha256)))
                    (throw (new globalThis.Error "original managed case source changed while binding its corpus")))
                  (js-call locators :push (globalThis.structuredClone locator)))
                (setq al-idx (1+ al-idx))))
            (let ((r-idx 0))
              (while (< r-idx (js-length records))
                (let* ((record (aref records r-idx))
                       (orig (get record :original))
                       (orig-case (and orig (get orig :case))))
                  (when (and (= (get record :kind) "stage")
                             orig (= (get orig :manifest) (get parity :id))
                             (= (value-type (get orig :fixture)) "string")
                             orig-case (= (value-type (get orig-case :name)) "string"))
                    (let ((named (js-call locators :filter (lambda (locator)
                                   (and (= (get locator :file) (get orig :fixture))
                                        (= (get locator :contains) (get orig-case :name))
                                        (not (js-call (get record :coverage) :includes (get locator :id))))))))
                      (Reflect/apply (get (get record :coverage) :splice) (get record :coverage)
                        (js-call (js-array 1 0) :concat (js-call named :map (lambda (locator) (get locator :id)))))
                      (js-call named :forEach (lambda (locator) (js-call claimed :add (get locator :id)))))))
                (setq r-idx (1+ r-idx))))
            (let ((bs-list (get (get parity :document) :bootstrapSources))
                  (bs-idx 0))
              (while (< bs-idx (js-length bs-list))
                (await (funcall file (aref bs-list bs-idx)))
                (setq bs-idx (1+ bs-idx))))
            (await (funcall file "tests/bootstrap-tests.el"))
            (when (js-call stableFiles :has "tests/fixtures/bootstrap-symbols.json")
              (let* ((symbolCases (await (funcall json "tests/fixtures/bootstrap-symbols.json")))
                     (functions (js-object :segment (js-array "munge-segment" "munge_segment")
                                  :binding (js-array "binding-name" "binding_name")
                                  :reference (js-array "reference-name" "reference_name")))
                     (calls (js-array))
                     (entries (Object/entries symbolCases))
                     (e-idx 0))
                (while (< e-idx (js-length entries))
                  (let* ((entry (aref entries e-idx))
                         (operation (aref entry 0))
                         (cases (aref entry 1))
                         (fn-pair (get functions operation)))
                    (when (or (not fn-pair) (not (Array/isArray cases)))
                      (throw (new globalThis.Error "unrepresented original symbol fixture operation")))
                    (js-call cases :forEach (lambda (item)
                      (let ((call-obj (js-object :name (aref fn-pair 0) :javascriptName (aref fn-pair 1)
                                        :args (js-array (get item :input)))))
                        (if (Object/hasOwn item "error")
                          (put call-obj :error (get item :error))
                          (put call-obj :expected (get item :output)))
                        (js-call calls :push call-obj)))))
                  (setq e-idx (1+ e-idx)))
                (let ((request (js-object :operation "project" :entry "symbol.mjs" :sourceMap t
                                 :modules (js-array (js-object :id "symbol.mjs" :filename "bootstrap/compiler/symbol.eli"
                                                      :source (await (funcall text "bootstrap/compiler/symbol.eli")))))))
                  (funcall add
                    (js-object :id "stable-compatibility:symbol-mapping" :kind "sequence"
                      :coverage (js-call (js-array "stable-compatibility:tests/fixtures/bootstrap-symbols.json")
                                  :concat (js-call (js-call locators :filter (lambda (item) (= (get item :file) "tests/bootstrap-symbol.test.mjs")))
                                            :map (lambda (item) (get item :id))))
                      :original (js-object :suite "tests/bootstrap-symbol.test.mjs" :fixture "tests/fixtures/bootstrap-symbols.json")
                      :expected (js-object :kind "sequence")
                      :steps (js-array
                               (js-object :id "first" :request request :artifact (js-object :kind "exports" :auto 1 :calls calls))
                               (js-object :id "repeat" :request (cloneSourceProjectRequest request)
                                 :artifact (js-object :kind "exports" :auto 1 :calls (globalThis.structuredClone calls))
                                 :sameProductAs "first"))))
                  (await (funcall file "tests/bootstrap-symbol.test.mjs"))
                  (js-call fullyMappedSuites :add "tests/bootstrap-symbol.test.mjs"))))
            (let ((extra-suites (js-array "tests/bootstrap-project.test.mjs" "tests/macro-file-dependencies.test.mjs"
                                  "tests/esm-imports.test.mjs" "tests/bootstrap-ir-serialization.test.mjs"))
                  (es-idx 0))
              (while (< es-idx (js-length extra-suites))
                (await (funcall file (aref extra-suites es-idx)))
                (setq es-idx (1+ es-idx))))
            (let ((portableSources (js-object))
                  (ps-names (js-array "sequence" "text" "object"))
                  (ps-idx 0))
              (while (< ps-idx (js-length ps-names))
                (let ((name (aref ps-names ps-idx)))
                  (put portableSources name (await (funcall text (str "stdlib/" name ".eli")))))
                (setq ps-idx (1+ ps-idx)))
              (addOriginalRequestRecipes (js-object :add add :locators locators :irCases irCases :portableSources portableSources)))
            (let* ((formatterSuite (await (addOriginalFormatterRecipes (js-object :add add :locators locators :text text :file file :sourceRoot sourceRoot))))
                   (generatedNamesSuite (await (addOriginalGeneratedNamesRecipes (js-object :add add :locators locators :text text :file file :sourceRoot sourceRoot))))
                   (esmSuite (await (addOriginalESMRecipes (js-object :add add :locators locators :text text :file file))))
                   (bs-sources (get (get parity :document) :bootstrapSources)))
              (when generatedNamesSuite (js-call fullyMappedSuites :add generatedNamesSuite))
              (when esmSuite (js-call fullyMappedSuites :add esmSuite))
              (js-call (await (addOriginalCompilerModulePrograms (js-object :add add :locators locators :text text :file file :bootstrapSources bs-sources)))
                :forEach (lambda (suite) (js-call fullyMappedSuites :add suite)))
              (js-call (await (addOriginalEvaluationPrograms (js-object :add add :locators locators :text text :file file :bootstrapSources bs-sources :sourceRoot sourceRoot)))
                :forEach (lambda (suite) (js-call fullyMappedSuites :add suite)))
              (js-call (await (addOriginalProjectPrograms (js-object :add add :locators locators :text text :file file :stableFiles stableFiles :bootstrapSources bs-sources :sourceRoot sourceRoot)))
                :forEach (lambda (suite) (js-call fullyMappedSuites :add suite)))
              (js-call (await (addOriginalCLIPrograms (js-object :add add :locators locators :text text :file file :bootstrapSources bs-sources :sourceRoot sourceRoot)))
                :forEach (lambda (suite) (js-call fullyMappedSuites :add suite)))
              (when formatterSuite (js-call fullyMappedSuites :add formatterSuite)))
            (let ((cliSource (await (funcall text "tests/cli-test.sh")))
                  (diagnosticFilename "tests/fixtures/diagnostic-unbound.eli"))
              (when (js-call stableFiles :has diagnosticFilename)
                (let ((assertion (originalRegion cliSource "DIAGNOSTIC_FILE=\"$TEMP_DIR/diagnostic.json\" bun -e '" "\n'\n")))
                  (funcall add
                    (js-object :id "original-sequence:cli-unbound-diagnostic" :kind "sequence"
                      :coverage (js-array (str "stable-compatibility:" diagnosticFilename))
                      :expected (js-object :kind "sequence")
                      :original (js-object :fixture diagnosticFilename :suite "tests/cli-test.sh"
                                  :sourceSha256 (get (await (funcall file "tests/cli-test.sh")) :sha256)
                                  :regions (js-array (js-object :start (get assertion :start) :end (get assertion :end)
                                                       :byteStart (get assertion :byteStart) :byteEnd (get assertion :byteEnd)
                                                       :sha256 (get assertion :sha256))))
                      :steps (js-array
                               (js-object :id "original-json-diagnostic"
                                 :request (js-object :operation "compile" :source (await (funcall text diagnosticFilename)) :filename diagnosticFilename)
                                 :error (js-object :code "ELI-A0001" :phase "analysis"
                                          :expectFields (js-array
                                                          (js-object :path (js-array "message") :value "unbound symbol: missing")
                                                          (js-object :path (js-array "format") :value "eliscript-diagnostic")
                                                          (js-object :path (js-array "severity") :value "error")
                                                          (js-object :path (js-array "location" "file") :value diagnosticFilename)
                                                          (js-object :path (js-array "location" "start" "offset") :value 19)
                                                          (js-object :path (js-array "location" "start" "line") :value 2)
                                                          (js-object :path (js-array "location" "start" "column") :value 3)))))))))
              (let* ((runtimeSources nil)
                     (originalRuntimeSources
                       (async ()
                         (if runtimeSources
                           runtimeSources
                           (let ((result (js-array))
                                 (walk nil))
                             (setq walk
                               (async (directory)
                                 (let ((entries (await (readdir (sourcePath sourceRoot directory) (js-object :withFileTypes t))))
                                       (e-idx 0))
                                   (js-call entries :sort (lambda (left right)
                                     (if (< (get left :name) (get right :name)) -1
                                       (if (> (get left :name) (get right :name)) 1 0))))
                                   (while (< e-idx (js-length entries))
                                     (let* ((item (aref entries e-idx))
                                            (filename (str directory "/" (get item :name))))
                                       (if (js-call item :isDirectory)
                                         (await (funcall walk filename))
                                         (when (and (js-call item :isFile) (js-call filename :endsWith ".mjs"))
                                           (js-call result :push (js-object :id filename :filename filename :source (await (funcall text filename)))))))
                                     (setq e-idx (1+ e-idx))))))
                             (await (funcall walk "runtime"))
                             (js-call result :push (js-object :id "stdlib/bit.mjs" :filename "stdlib/bit.mjs"
                               :source (await (funcall text "stdlib/bit.mjs"))))
                             (setq runtimeSources result)
                             result))))
                     (originalInlineHost
                       (lambda (marker)
                         (let* ((block (js-call cliSource :indexOf marker))
                                (begin (if (< block 0) -1 (js-call cliSource :indexOf "bun --eval '\n" block)))
                                (end (if (< begin 0) -1 (js-call cliSource :indexOf "\n')" begin))))
                           (when (or (< block 0) (< begin 0) (< end 0))
                             (throw (new globalThis.Error (str "original inline host oracle is unavailable: " marker))))
                           (str (js-call cliSource :slice (+ begin (js-length "bun --eval '\n")) end) "\n"))))
                     (coreSetSuite (await (funcall text "tests/core-set.test.mjs")))
                     (coreStdlibSuite (await (funcall text "tests/core-stdlib.test.mjs")))
                     (coreSetEli (await (funcall text "tests/core-set.test.eli")))
                     (coreSetUsageHostEli (await (funcall text "tests/fixtures/core-set-usage-host.eli")))
                     (coreStdlibEli (await (funcall text "tests/core-stdlib.test.eli")))
                     (coreStdlibApiHostEli (await (funcall text "tests/fixtures/core-stdlib-api-host.eli")))
                     (coreSetTitle "Eliscript-authored set algebra compiles and agrees across local hosts")
                     (coreStdlibTitle "Eliscript core modules compile and execute against runtime protocols")
                     (coreSetCase (eli-test-case (eli-module-members coreSetEli "tests/core-set.test.eli") coreSetTitle))
                     (coreSetExpectedLet (eli-one (eli-walk coreSetCase (lambda (node) (eli-binding-p node "expected"))) "core-set expected"))
                     (coreSetExpectedValue (eli-static-data (aref (get (aref (get (aref (get coreSetExpectedLet :items) 1) :items) 0) :items) 1)))
                     (coreSetHostMembers (eli-module-members coreSetUsageHostEli "tests/fixtures/core-set-usage-host.eli"))
                     (coreSetHostRunIndex (js-call coreSetHostMembers :findIndex
                       (lambda (node) (and (eli-head-p node "defasync") (eli-symbol-p (aref (get node :items) 1) "run-host-main")))))
                     (_checkCoreSetHost (unless (> coreSetHostRunIndex 0) (throw (new globalThis.TypeError "core-set-usage-host run-host-main missing"))))
                     (coreSetHostDefs (js-call (js-call coreSetHostMembers :slice 2 (1+ coreSetHostRunIndex))
                                        :map (lambda (node) (eli-node-text coreSetUsageHostEli node))))
                     (coreSetGeneratedHost
                       (compile-string
                         (str "(module original.inline-core-set-host\n"
                           (js-call coreSetHostDefs :join "\n") "\n"
                           "(defasync run-original-literal-host () (await (run-host-main)))\n"
                           originalRuntimeHostCompletionSource "\n)\n")
                         "original-inline-core-set-host.eli"))
                     (coreLibraryNames (js-array "protocol" "identifier" "data-text" "metadata" "collection" "transient" "transducer" "seq" "data"))
                     (coreLibraryModules (js-call coreLibraryNames :map (lambda (name) (js-object :id (str "stdlib/core/" name ".mjs") :filename (str "stdlib/core/" name ".eli")))))
                     (coreModuleBindings
