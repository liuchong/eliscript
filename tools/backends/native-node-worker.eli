(module tools.backends.native-node-worker
  (import "node:worker_threads" parentPort workerData)
  (import "node:child_process" spawn)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./compiler-worker.mjs" errorData)

  (defun worker-module-url ()
    (let* ((stack (str (get (new globalThis.Error) :stack)))
           (file-match (js-call (new globalThis.RegExp "(file://[^\\s):]+\\.mjs):\\d+:\\d+") :exec stack)))
      (if file-match
        (aref file-match 1)
        (let ((path-match (js-call (new globalThis.RegExp "(/[^\\s():]+\\.mjs):\\d+:\\d+") :exec stack)))
          (if path-match
            (get (pathToFileURL (aref path-match 1)) :href)
            (get (pathToFileURL (resolve "tools/backends/native-node-worker.mjs")) :href))))))

  (defvar buffer (get workerData :buffer))
  (defvar control (new globalThis.Int32Array buffer 0 4))
  (defvar payload (new globalThis.Uint8Array buffer 16))
  (defvar current nil)
  (defvar ready false)
  (defvar failed false)
  (defvar closing false)
  (defvar parent-closed false)
  (defvar received-bytes 0)
  (defconst received (js-array))
  (defconst packets (js-array))
  (defconst encoder (new globalThis.TextEncoder))
  (defconst decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))
  (defvar child undefined)

  (defun failure (error)
    (errorData error (js-object :transport "json")))

  (defun flush ()
    (unless (nil? current)
      (if (> (js-length current) (js-length payload))
        (progn
          (Atomics/store control 1 (js-length current))
          (Atomics/store control 0 2))
        (progn
          (js-call payload :set current)
          (Atomics/store control 1 (js-length current))
          (Atomics/store control 0 1)))
      (Atomics/notify control 0)))

  (defun publish ()
    (when (and (not (nil? current)) (= (Atomics/load control 0) 0))
      (setq current nil))
    (unless (or (not (nil? current)) (= (js-length packets) 0))
      (setq current (js-call packets :shift))
      (Atomics/store control 2 (js-length packets))
      (flush)))

  (defun deliver (message)
    (js-call packets :push (js-call encoder :encode (JSON/stringify message)))
    (Atomics/store control 2 (js-length packets))
    (publish))

  (defun fail (error)
    (unless (or failed parent-closed)
      (setq failed t)
      (put received :length 0)
      (setq received-bytes 0)
      (let ((record (failure error)))
        (if (not ready)
          (js-call parentPort :postMessage (js-object :startupFailure record))
          (deliver (js-object :transportFailure record))))
      (js-call child :kill)))

  (setq child
    (spawn (get workerData :bunExecutable)
      (js-array (fileURLToPath (new globalThis.URL "./native-node-runner.mjs" (worker-module-url))))
      (js-object
        :stdio (js-array "pipe" "pipe" "inherit")
        :env (Object/assign (js-object) (get globalThis.process :env)
               (js-object :NODE_OPTIONS "" :BUN_OPTIONS "")))))

  (js-call child :on "error" fail)
  (js-call (get child :stdin) :on "error"
    (lambda (error) (unless closing (fail error))))
  ;; Wait for stdio to drain before reporting process termination. Its final
  ;; packet may still be buffered when the process emits the earlier exit event.
  (js-call child :on "close"
    (lambda (code signal)
      (unless parent-closed
        (if (and (not failed) (/= received-bytes 0))
          (fail (new globalThis.Error "native process ended with an incomplete JSON packet"))
          (if (not closing)
            (fail (new globalThis.Error (+ "native process exited: " (if (nullish? signal) code signal))))
            (unless failed (js-call parentPort :close)))))))
  (js-call (get child :stdout) :on "error" fail)
  (js-call (get child :stdout) :on "data"
    (lambda (chunk)
      (unless (or failed parent-closed)
        (try
          (let ((start 0)
                (end (js-call chunk :indexOf 10 0)))
            ;; Search only the newly arrived bytes. Retained fragments are never
            ;; rescanned or decoded until their single complete JSON packet arrives.
            (while (/= end -1)
              (let ((tail (js-call chunk :subarray start end)))
                (when (> (js-length tail) 0)
                  (js-call received :push tail)
                  (setq received-bytes (+ received-bytes (js-length tail))))
                (let ((packet (Buffer/concat received received-bytes)))
                  (put received :length 0)
                  (setq received-bytes 0)
                  (setq start (1+ end))
                  (let ((message (JSON/parse (js-call decoder :decode packet))))
                    (if (and (not (nullish? message)) (get message :ready))
                      (progn
                        (when ready (throw (new globalThis.Error "duplicate native process initialization")))
                        (setq ready t)
                        (js-call parentPort :postMessage (js-object :ready t)))
                      (progn
                        (unless ready (throw (new globalThis.Error "native process responded before initialization")))
                        (deliver message))))))
              (setq end (js-call chunk :indexOf 10 start)))
            (when (< start (js-length chunk))
              (let ((tail (js-call chunk :subarray start)))
                (js-call received :push tail)
                (setq received-bytes (+ received-bytes (js-length tail))))))
          (catch error (fail error))))))
  (js-call (get child :stdout) :on "end"
    (lambda ()
      (when (and (not failed) (not parent-closed) (/= received-bytes 0))
        (fail (new globalThis.Error "native process ended with an incomplete JSON packet")))))
  (js-call parentPort :on "message"
    (lambda (message)
      (cond
        ((and (not (nullish? message)) (get message :buffer))
         (setq buffer (get message :buffer))
         (setq control (new globalThis.Int32Array buffer 0 4))
         (setq payload (new globalThis.Uint8Array buffer 16))
         (flush))
        ((and (not (nullish? message)) (get message :consumed))
         (publish))
        ((and (not (nullish? message)) (get message :shutdown))
         (setq closing t)
         (js-call (get child :stdin) :end))
        ((and (not (nullish? message)) (get message :request))
         (if failed
           (deliver (js-object :transportFailure (failure (new globalThis.Error "native process is unavailable"))))
           (try
             (js-call (get child :stdin) :write (+ (JSON/stringify (get message :request)) "\n"))
             (catch error (fail error))))))))
  (js-call parentPort :once "close"
    (lambda ()
      (setq parent-closed t)
      (setq closing t)
      (put received :length 0)
      (setq received-bytes 0)
      (js-call child :kill "SIGTERM")))
  (js-call globalThis.process :on "uncaughtException" fail)
  (js-call globalThis.process :on "unhandledRejection" fail))
