(module tools.backends.native-node-watchdog
  (import "node:worker_threads" parentPort workerData)
  ;; This worker monitors only the owning loader process.
  (defconst owner (if (nullish? workerData) undefined (get workerData :parentPID)))
  (unless (and (Number/isSafeInteger owner) (>= owner 1))
    (throw (new globalThis.TypeError "native loader requires its owning process identity")))
  (defun checkOwner ()
    (try (js-call globalThis.process :kill owner 0)
      (catch error
        (let ((code (if (nullish? error) undefined (get error :code))))
          (unless (eq code "EPERM")
            (unless (eq code "ESRCH") (throw error))
            (js-call globalThis.process :kill (get globalThis.process :pid) "SIGTERM"))))))
  (checkOwner)
  (defconst timer (js-call (js* "globalThis") :setInterval checkOwner 250))
  (js-call parentPort :once "close" (lambda () (js-call (js* "globalThis") :clearInterval timer)))
  (js-call parentPort :postMessage (js-object :ready t)))
