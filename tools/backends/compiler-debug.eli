(module tools.backends.compiler-debug
  (import "./compiler-host-record.mjs" copyHostRecord)
  (defconst formats (new globalThis.Set (js-array "eliscript-wasm-source-map" "eliscript-native-source-map")))
  (defconst ownedDocuments (new globalThis.WeakSet))
  (defconst offset-pattern (new globalThis.RegExp "^(?:0x[0-9a-f]+|[0-9]+)$" "i"))
  (defconst host-method (js* "(implementation, name) => ({ [name](...args) { return implementation(this, ...args); } })[name]"))
  (defun host-type (value) (js* "typeof value"))
  (defun host-truth (value) (js* "!!value"))
  (defun optional-get (value key) (if (nullish? value) undefined (get value key)))
  (defun nullable-get (value key fallback)
    (let ((found (optional-get value key))) (if (nullish? found) fallback found)))
  (defun default-option (options key fallback)
    (let ((value (get options key))) (if (undefined? value) fallback value)))
  (defun ownCompilerDebugDocument (document)
    (when (and (not (nil? document)) (eq (host-type document) "object")) (js-call ownedDocuments :add document)) document)
  (defun offset (value label)
    (cond ((eq (host-type value) "bigint") value)
      ((and (eq (host-type value) "number") (Number/isSafeInteger value)) (funcall globalThis.BigInt value))
      ((and (eq (host-type value) "string") (js-call offset-pattern :test value)) (funcall globalThis.BigInt value))
      (t (throw (new globalThis.TypeError (str label " must be an exact byte offset"))))))
  (defun range (value)
    (and (host-truth value) (Number/isSafeInteger (get value :start)) (>= (get value :start) 0)
      (Number/isSafeInteger (get value :end)) (>= (get value :end) (get value :start))))
  (defun intervalIndex (entries)
    (let ((sorted (js-array)) (index 0))
      (while (< index (js-length entries))
        (when (range (aref entries index)) (js-call sorted :push index)) (setq index (1+ index)))
      (js-call sorted :sort (lambda (a b)
        (let ((order (- (get (aref entries a) :start) (get (aref entries b) :start))))
          (if (host-truth order) order (- a b)))))
      (let ((maximumEnds (new globalThis.Float64Array (js-length sorted))) (end 0) (index 0))
        (while (< index (js-length sorted))
          (setq end (Math/max end (get (aref entries (aref sorted index)) :end)))
          (put maximumEnds index end) (setq index (1+ index)))
        (lambda (byte)
          (let ((low 0) (high (js-length sorted)))
            (while (< low high)
              (let ((middle (+ low (Math/floor (/ (- high low) 2)))))
                (if (<= (get (aref entries (aref sorted middle)) :start) byte) (setq low (1+ middle)) (setq high middle))))
            (let ((matches (js-array)) (index (1- low)))
              (while (and (>= index 0) (> (aref maximumEnds index) byte))
                (let ((entryIndex (aref sorted index)))
                  (when (> (get (aref entries entryIndex) :end) byte) (js-call matches :push entryIndex)))
                (setq index (1- index)))
              (js-call matches :sort (lambda (a b)
                (let ((depth (- (get (aref entries b) :depth 0) (get (aref entries a) :depth 0))))
                  (if (host-truth depth) depth
                    (let ((width (- (- (get (aref entries a) :end) (get (aref entries a) :start))
                                    (- (get (aref entries b) :end) (get (aref entries b) :start)))))
                      (if (host-truth width) width (- a b)))))))
              (js-call matches :map (lambda (entryIndex) (aref entries entryIndex)))))))))
  (defun createCompilerDebugMap (document)
    (unless (and (host-truth document) (js-call formats :has (get document :format)) (eq (get document :version) 1)
                 (eq (get document :offsetUnit) "byte") (Array/isArray (get document :functions)) (Array/isArray (get document :ranges)))
      (throw (new globalThis.TypeError "unsupported compiler instruction map")))
    (let* ((debug (if (js-call ownedDocuments :has document) document (funcall globalThis.structuredClone document)))
           (wasm (eq (get debug :format) "eliscript-wasm-source-map")) (code (get debug :codeSection)))
      (unless (eq (get debug :offsetBase) (if wasm "module" "code-section")) (throw (new globalThis.TypeError "incorrect compiler map offset base")))
      (when (or (not (host-truth code))
                (and wasm (or (not (Number/isSafeInteger (get code :payloadStart))) (not (Number/isSafeInteger (get code :end)))))
                (and (not wasm) (or (not (Number/isSafeInteger (get code :fileOffset)))
                                  (not (Number/isSafeInteger (get code :virtualAddress))) (not (Number/isSafeInteger (get code :size))))))
        (throw (new globalThis.TypeError "compiler map has no exact code section")))
      (let* ((functions (js-call (get debug :functions) :map (lambda (fn)
               (if wasm (copyHostRecord (copyHostRecord fn) (js-object :start (optional-get (get fn :instructions) "start")
                 :end (optional-get (get fn :instructions) "end"))) fn))))
             (sources (new globalThis.Map)) (byIndex (new globalThis.Map)))
        (when (or (js-call functions :some (lambda (fn) (not (range fn))))
                  (js-call (get debug :ranges) :some (lambda (item) (not (range item)))))
          (throw (new globalThis.TypeError "invalid compiler instruction range")))
        (let ((findFunction (intervalIndex functions)) (findRanges (intervalIndex (get debug :ranges))))
          (js-call (get debug :sources (js-array)) :forEach (lambda (source)
            (when (or (not (eq (host-type (get source :filename)) "string")) (js-call sources :has (get source :filename))
                      (not (Array/isArray (get source :macroOrigins))))
              (throw (new globalThis.TypeError "invalid compiler macro source map")))
            (js-call sources :set (get source :filename) source)))
          (js-call functions :forEach (lambda (fn)
            (when (or (not (Number/isSafeInteger (get fn :index))) (js-call byIndex :has (get fn :index)))
              (throw (new globalThis.TypeError "invalid compiler function index"))) (js-call byIndex :set (get fn :index) fn)))
          (let ((normalize (lambda (address options)
                  (when (undefined? options) (setq options (js-object)))
                  (let* ((offsetBase (default-option options "offsetBase" (get debug :offsetBase)))
                         (loadAddress (default-option options "loadAddress" 0)) (functionIndex (get options :functionIndex))
                         (returnAddress (default-option options "returnAddress" false)) (byte (offset address "instruction address")) (valid t))
                    (if wasm
                      (progn
                        (cond ((eq offsetBase "code-payload") (setq byte (+ byte (funcall globalThis.BigInt (get code :payloadStart)))))
                          ((or (eq offsetBase "function-body") (eq offsetBase "function-instructions"))
                            (let ((fn (js-call byIndex :get functionIndex)))
                              (if (not (host-truth fn)) (setq valid false)
                                (setq byte (+ byte (funcall globalThis.BigInt (if (eq offsetBase "function-body")
                                  (get (get fn :body) :start) (get (get fn :instructions) :start))))))))
                          ((not (eq offsetBase "module")) (throw (new globalThis.TypeError "unsupported WASM instruction offset base"))))
                        (when valid
                          (when (host-truth returnAddress) (setq byte (- byte (funcall globalThis.BigInt 1))))
                          (when (or (< byte (funcall globalThis.BigInt (get code :payloadStart))) (>= byte (funcall globalThis.BigInt (get code :end))))
                            (setq valid false))))
                      (progn
                        (cond ((eq offsetBase "file") (setq byte (- byte (funcall globalThis.BigInt (get code :fileOffset)))))
                          ((eq offsetBase "virtual-address") (setq byte (- byte (funcall globalThis.BigInt (get code :virtualAddress)))))
                          ((eq offsetBase "loaded-address") (setq byte (- byte (+ (offset loadAddress "image load slide")
                                                                              (funcall globalThis.BigInt (get code :virtualAddress))))))
                          ((not (eq offsetBase "code-section")) (throw (new globalThis.TypeError "unsupported native instruction offset base"))))
                        (when (host-truth returnAddress) (setq byte (- byte (funcall globalThis.BigInt 4))))
                        (when (or (< byte (funcall globalThis.BigInt 0)) (>= byte (funcall globalThis.BigInt (get code :size)))) (setq valid false))))
                    (if valid (funcall globalThis.Number byte) nil)))))
            (let ((result (js-object :target (get debug :target) :offsetBase (get debug :offsetBase))))
              (put result :lookup (funcall host-method (lambda (self address options)
                (let ((byte (funcall normalize address options)))
                  (if (nil? byte) nil
                    (let ((fn (get (funcall findFunction byte) 0 nil)))
                      (if (and (not (undefined? (optional-get options "functionIndex")))
                               (not (eq (optional-get fn "index") (get options :functionIndex)))) nil
                        (let* ((matches (js-call (funcall findRanges byte) :filter (lambda (item) (or (nil? fn) (eq (get item :functionIndex) (get fn :index))))))
                               (mapped (js-call matches :find (lambda (item) (not (nullish? (get item :span))))))
                               (rawSpan (nullable-get mapped "span" (optional-get fn "span")))
                               (span (if (nullish? rawSpan) nil rawSpan))
                               (source (if (nil? span) undefined (js-call sources :get (get span :filename))))
                               (macroOrigins (if (nullish? source) (js-array) (js-call (get source :macroOrigins) :filter (lambda (event)
                                 (and (eq (optional-get (get event :callSpan) "start") (get span :start))
                                      (eq (optional-get (get event :callSpan) "end") (get span :end))
                                      (eq (optional-get (get event :callSpan) "filename") (get span :filename))))))))
                          (js-object :target (get debug :target) :offset byte :offsetBase (get debug :offsetBase)
                            :function (nullable-get fn "name" nil) :functionIndex (nullable-get fn "index" nil) :span span :source (nullable-get source "id" nil)
                            :macroOrigins macroOrigins :generated (and (undefined? mapped) (nullish? (optional-get fn "span"))) :ranges matches))))))) "lookup"))
              (Object/defineProperty (get result :lookup) "length" (js-object :value 2 :configurable t))
              (put result :mapFrames (funcall host-method (lambda (self frames options)
                (when (undefined? options) (setq options (js-object)))
                (unless (Array/isArray frames) (throw (new globalThis.TypeError "compiler stack frames must be an array")))
                (js-call frames :map (lambda (frame)
                  (if (or (not (host-truth frame)) (undefined? (get frame :address))) (js-object :frame frame :source nil)
                    (js-object :frame frame :source (js-call self :lookup (get frame :address) (copyHostRecord (js-object) options frame))))))) "mapFrames"))
              (Object/defineProperty (get result :mapFrames) "length" (js-object :value 1 :configurable t)) (Object/freeze result)))))))
  (defun locateCompilerInstruction (document address options) (js-call (createCompilerDebugMap document) :lookup address options))
  (export ownCompilerDebugDocument createCompilerDebugMap locateCompilerInstruction))
