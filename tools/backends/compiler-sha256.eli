(module tools.backends.compiler-sha256
  ;; Streaming SHA-256 owns one block, schedule and state per instance, with no
  ;; Node dependency. Typed-array intrinsics validate the host byte transport.
  (defconst ROUND_CONSTANTS (Object/freeze (js-array 1116352408 1899447441 3049323471 3921009573 961987163 1508970993 2453635748 2870763221 3624381080 310598401 607225278 1426881987 1925078388 2162078206 2614888103 3248222580 3835390401 4022224774 264347078 604807628 770255983 1249150122 1555081692 1996064986 2554220882 2821834349 2952996808 3210313671 3336571891 3584528711 113926993 338241895 666307205 773529912 1294757372 1396182291 1695183700 1986661051 2177026350 2456956037 2730485921 2820302411 3259730800 3345764771 3516065817 3600352804 4094571909 275423344 430227734 506948616 659060556 883997877 958139571 1322822218 1537002063 1747873779 1955562222 2024104815 2227730452 2361852424 2428436474 2756734187 3204031479 3329325298)))
  (defconst typedArrayPrototype (Object/getPrototypeOf (get globalThis.Uint8Array :prototype)))
  (defconst typedArrayTag (get (Object/getOwnPropertyDescriptor typedArrayPrototype (get globalThis.Symbol :toStringTag)) :get))
  (defconst typedArrayLength (get (Object/getOwnPropertyDescriptor typedArrayPrototype "length") :get))
  (defconst typedArraySet (get (get globalThis.Uint8Array :prototype) :set))
  (defconst emptyBytes (new globalThis.Uint8Array 0))
  (defconst host-method (js* "(implementation, name) => ({ [name](...args) { return implementation(this, ...args); } })[name]"))
  (defun addCompilerSha256Bytes (length amount)
    (unless (and (Number/isSafeInteger amount) (>= amount 0))
      (throw (new globalThis.RangeError "compiler SHA-256 byte count must be a nonnegative safe integer")))
    (let* ((low (+ (get length :low) (% amount 4294967296)))
           (high (+ (get length :high) (Math/floor (/ amount 4294967296)) (if (>= low 4294967296) 1 0))))
      (when (>= high 536870912) (throw (new globalThis.RangeError "compiler SHA-256 message must contain fewer than 2^64 bits")))
      (put length :low (uint32 low)) (put length :high high)))
  (defun writeCompilerSha256BitLength (block length)
    (let ((high (uint32 (bit-or (bit-shift-left (get length :high) 3) (unsigned-bit-shift-right (get length :low) 29))))
          (low (uint32 (bit-shift-left (get length :low) 3))))
      (put block 56 (unsigned-bit-shift-right high 24)) (put block 57 (unsigned-bit-shift-right high 16))
      (put block 58 (unsigned-bit-shift-right high 8)) (put block 59 high)
      (put block 60 (unsigned-bit-shift-right low 24)) (put block 61 (unsigned-bit-shift-right low 16))
      (put block 62 (unsigned-bit-shift-right low 8)) (put block 63 low)))
  (defun rotateRight (value shift) (bit-or (unsigned-bit-shift-right value shift) (bit-shift-left value (- 32 shift))))
  (defun compressCompilerSha256Block (state words bytes offset)
    (let ((index 0))
      (while (< index 16)
        (let ((at (+ offset (* index 4))))
          (put words index (bit-or (bit-or (bit-or (bit-shift-left (aref bytes at) 24)
            (bit-shift-left (aref bytes (1+ at)) 16)) (bit-shift-left (aref bytes (+ at 2)) 8)) (aref bytes (+ at 3)))))
        (setq index (1+ index)))
      (while (< index 64)
        (let* ((x (aref words (- index 15))) (y (aref words (- index 2)))
               (small0 (bit-xor (bit-xor (rotateRight x 7) (rotateRight x 18)) (unsigned-bit-shift-right x 3)))
               (small1 (bit-xor (bit-xor (rotateRight y 17) (rotateRight y 19)) (unsigned-bit-shift-right y 10))))
          (put words index (uint32 (+ (aref words (- index 16)) small0 (aref words (- index 7)) small1))))
        (setq index (1+ index))))
    (let ((a (aref state 0)) (b (aref state 1)) (c (aref state 2)) (d (aref state 3))
          (e (aref state 4)) (f (aref state 5)) (g (aref state 6)) (h (aref state 7)) (index 0))
      (while (< index 64)
        (let* ((large1 (bit-xor (bit-xor (rotateRight e 6) (rotateRight e 11)) (rotateRight e 25)))
               (choice (bit-xor (bit-and e f) (bit-and (bit-xor e -1) g)))
               (large0 (bit-xor (bit-xor (rotateRight a 2) (rotateRight a 13)) (rotateRight a 22)))
               (majority (bit-xor (bit-xor (bit-and a b) (bit-and a c)) (bit-and b c)))
               (first (uint32 (+ h large1 choice (aref ROUND_CONSTANTS index) (aref words index))))
               (second (uint32 (+ large0 majority))))
          (setq h g g f f e e (uint32 (+ d first)) d c c b b a a (uint32 (+ first second))))
        (setq index (1+ index)))
      (put state 0 (uint32 (+ (aref state 0) a))) (put state 1 (uint32 (+ (aref state 1) b)))
      (put state 2 (uint32 (+ (aref state 2) c))) (put state 3 (uint32 (+ (aref state 3) d)))
      (put state 4 (uint32 (+ (aref state 4) e))) (put state 5 (uint32 (+ (aref state 5) f)))
      (put state 6 (uint32 (+ (aref state 6) g))) (put state 7 (uint32 (+ (aref state 7) h)))))
  (defun createCompilerSha256 ()
    (let ((block (new globalThis.Uint8Array 64)) (words (new globalThis.Uint32Array 64))
          (state (new globalThis.Uint32Array (js-array 1779033703 3144134277 1013904242 2773480762 1359893119 2600822924 528734635 1541459225)))
          (length (js-object :high 0 :low 0)) (buffered 0) (finalized false) (hasher (js-object)))
      (let ((requireOpen (lambda ()
              (when finalized (throw (new globalThis.TypeError "compiler SHA-256 has already been finalized"))))))
        (put hasher :update (funcall host-method (lambda (self bytes)
          (funcall requireOpen)
          (unless (and (ArrayBuffer/isView bytes) (eq (js-call typedArrayTag :call bytes) "Uint8Array"))
            (throw (new globalThis.TypeError "compiler SHA-256 update requires a Uint8Array")))
          (js-call typedArraySet :call bytes emptyBytes)
          (let ((count (js-call typedArrayLength :call bytes)) (offset 0))
            (addCompilerSha256Bytes length count)
            (unless (eq buffered 0)
              (while (and (< buffered 64) (< offset count))
                (put block buffered (aref bytes offset)) (setq buffered (1+ buffered) offset (1+ offset)))
              (when (eq buffered 64) (compressCompilerSha256Block state words block 0) (setq buffered 0)))
            (while (<= (+ offset 64) count)
              (compressCompilerSha256Block state words bytes offset) (setq offset (+ offset 64)))
            (while (< offset count)
              (put block buffered (aref bytes offset)) (setq buffered (1+ buffered) offset (1+ offset)))) hasher) "update"))
        (Object/defineProperty (get hasher :update) "length" (js-object :value 1 :configurable t))
        (put hasher :digestHex (funcall host-method (lambda (self)
          (funcall requireOpen) (setq finalized t)
          (put block buffered 128) (setq buffered (1+ buffered))
          (when (> buffered 56)
            (js-call block :fill 0 buffered) (compressCompilerSha256Block state words block 0) (setq buffered 0))
          (js-call block :fill 0 buffered 56) (writeCompilerSha256BitLength block length)
          (compressCompilerSha256Block state words block 0)
          (let ((result "") (index 0))
            (while (< index (js-length state))
              (setq result (str result (js-call (js-call (aref state index) :toString 16) :padStart 8 "0")) index (1+ index))) result)) "digestHex")))
      (Object/freeze hasher)))
  (export createCompilerSha256))
