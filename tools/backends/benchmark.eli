                    (funcall assert (js-call (get value :samplesMs) :every (lambda (n) (and (Number/isFinite n) (> n 0)))))
                    (funcall assert (js-call (get value :checksums) :every
                      (lambda (n) (Object/is n (get (get report :expected) (get input :name))))))))) (catch __eli_iteration_error_2 (closeHostIterator __eli_iterator_1 t) (throw __eli_iteration_error_2)) (finally (closeHostIterator __eli_iterator_1 false))))))) (catch __eli_iteration_error_4 (closeHostIterator __eli_iterator_3 t) (throw __eli_iteration_error_4)) (finally (closeHostIterator __eli_iterator_3 false)))))) (catch __eli_iteration_error_6 (closeHostIterator __eli_iterator_5 t) (throw __eli_iteration_error_6)) (finally (closeHostIterator __eli_iterator_5 false))))))) (catch __eli_iteration_error_8 (closeHostIterator __eli_iterator_7 t) (throw __eli_iteration_error_8)) (finally (closeHostIterator __eli_iterator_7 false))))
