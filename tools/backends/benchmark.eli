                        (funcall globalThis.String session) "wasm" (JSON/stringify inputs) (JSON/stringify parameters))
                        (js-object :encoding "utf8" :timeout 120000))))
                  (js-call assert :equal (get result :status) 0 (get result :stderr))
                  (js-call sessions :push (copyHostRecord (js-object :engine engine :session session) (JSON/parse (get result :stdout))))))) (catch __eli_iteration_error_14 (closeHostIterator __eli_iterator_13 t) (throw __eli_iteration_error_14)) (finally (closeHostIterator __eli_iterator_13 false))))
              (let ((browser (await (js-call chromium :launch))))
                (try (let ((page (await (js-call browser :newPage))))
                  (await (js-call page :goto (str "http://127.0.0.1:" (get (js-call server :address) :port))))
                  (let ((results (await (js-call page :evaluate browser-measure (js-object :session session :inputs inputs :parameters parameters)))))
                    (js-call sessions :push (js-object :engine "chromium" :session session :version (js-call browser :version) :results results))))
                  (finally (await (js-call browser :close)))))
              (setq session (1+ session)))
            (let* ((module (new globalThis.WebAssembly.Module bytes)) (instance (new globalThis.WebAssembly.Instance module))
                   (report (js-object :format "eliscript-direct-wasm-performance" :generatedAt (js-call (new globalThis.Date) :toISOString)
                     :scope "numeric-f64 whole-program hot execution; not complete compiler performance"
                     :environment (js-object :platform (platform) :arch (arch) :cpu (get (aref (cpus) 0) :model))
                     :parameters parameters :inputs inputs :sourceHashes (await (sourceHashes))
