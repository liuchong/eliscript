    (js-object :name "escape-grid-batch" :fn "escape_grid_batch" :wasmFn "escape-grid-batch" :args (js-array 160 64 2))
    (js-object :name "recurrence-tiny-batch" :fn "recurrence_batch" :wasmFn "recurrence-batch" :args (js-array 1 0.123 2000000))))
  (defconst parameters (js-object :sessions 3 :warmups 5 :samples 9 :minimumSpeedup 1))
  (defconst helperNames (js-array "compiler-host-iteration" "numeric-benchmark-kernel" "numeric-benchmark-runner"))
  (defconst sourceFiles (js-call
