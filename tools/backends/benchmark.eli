                    (t (js-call response :setHeader "Content-Type" "text/html") (js-call response :end html))))
                (catch error (put response :statusCode 404) (js-call response :end "Not found")))))))
          (await (new globalThis.Promise (lambda (done) (js-call server :listen 0 "127.0.0.1" done))))
          (let ((sessions (js-array)) (session 0))
