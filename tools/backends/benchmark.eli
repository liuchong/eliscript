  ;; Only browser ESM/HTTP transport is expressed as host syntax. All timed
  ;; iteration and validation is compiled from numeric-benchmark-kernel.eli.
  (defconst browser-measure (js* "async ({session, inputs, parameters}) => { const js = await import('/batches.mjs'); const kernel = await import('/numeric-benchmark-kernel.mjs'); const wasm = (await WebAssembly.instantiate(await (await fetch('/batches.wasm')).arrayBuffer())).instance.exports; return kernel.measureNumericBenchmark(js, wasm, session, inputs, parameters, () => performance.now(), 'wasm', 'wasmFn'); }"))
  (defasync runDirectWasmBenchmark ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-direct-wasm-perf-")))) (server undefined))
      (try
        (let* ((backends (await (buildBackends (js-object :outputRoot directory))))
               (compiler (get backends :compiler)) (numeric (get backends :numeric)) (wasm (get backends :wasm))
               (source (str (await (readFile (resolve root "tools/experiments/native-wasm/kernels.eli") "utf8")) "\n"
                            (await (readFile (resolve root "tools/backends/batches.eli") "utf8"))))
               (program (js-call compiler :compile_ir_string source "direct-batches.eli"))
               (javascript (js-call numeric :emit_numeric_javascript program)) (bytes (Uint8Array/from (js-call wasm :emit_numeric_wasm program)))
               (jsPath (resolve directory "batches.mjs")) (wasmPath (resolve directory "batches.wasm"))
               (runner (resolve directory "numeric-benchmark-runner.mjs")))
          (await (writeFile jsPath javascript)) (await (writeFile wasmPath bytes)) (await (compileRunners compiler directory))
          (let ((kernel (await (readFile (resolve directory "numeric-benchmark-kernel.mjs"))))
                (iteration (await (readFile (resolve directory "compiler-host-iteration.mjs"))))
                (html "<!doctype html><title>Direct WASM benchmark</title><script type=\"importmap\">{\"imports\":{\"eliscript/\":\"/eliscript/\"}}</script>"))
            (setq server (createServer (async (request response)
              (js-call response :setHeader "Cross-Origin-Opener-Policy" "same-origin")
              (js-call response :setHeader "Cross-Origin-Embedder-Policy" "require-corp")
              (try
                (let ((url (get request :url)))
                  (cond
                    ((eq url "/batches.mjs") (js-call response :setHeader "Content-Type" "text/javascript") (js-call response :end javascript))
                    ((eq url "/numeric-benchmark-kernel.mjs") (js-call response :setHeader "Content-Type" "text/javascript") (js-call response :end kernel))
                    ((eq url "/compiler-host-iteration.mjs") (js-call response :setHeader "Content-Type" "text/javascript") (js-call response :end iteration))
                    ((eq url "/batches.wasm") (js-call response :setHeader "Content-Type" "application/wasm") (js-call response :end bytes))
                    ((js-call url :startsWith "/eliscript/")
                      (let* ((filename (resolve root (funcall (get (js* "globalThis") :decodeURIComponent) (js-call url :slice 11))))
