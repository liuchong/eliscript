      "tools/backends/benchmark.mjs" "tools/bootstrap-seed.el")
    (js-call helperNames :map (lambda (name) (str "tools/backends/" name ".eli")))))
  (defun hash (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun median (values) (aref (js-call (js-call values :slice) :sort (lambda (a b) (- a b))) (Math/floor (/ (js-length values) 2))))
  (defasync sourceHashes ()
    (Object/fromEntries (await (Promise/all (js-call sourceFiles :map (async (file)
      (js-array file (hash (await (readFile (resolve root file)))))))))))
  (defun summarize (sessions)
    (js-call (js-array "node" "bun" "chromium") :flatMap (lambda (engine)
      (js-call inputs :map (lambda (input)
        (let* ((matching (js-call sessions :filter (lambda (session) (eq (get session :engine) engine))))
               (samples (lambda (mode) (js-call matching :flatMap (lambda (session)
                 (get (get (get (js-call (get session :results) :find
                   (lambda (result) (eq (get result :name) (get input :name)))) :measurements) mode) :samplesMs)))))
               (jsMs (median (funcall samples "js"))) (wasmMs (median (funcall samples "wasm"))))
          (js-object :engine engine :name (get input :name) :jsMs jsMs :wasmMs wasmMs :speedup (/ jsMs wasmMs))))))))
