  (defasync run-module-entry ()
(when (and (funcall (js* "(value) => !!value") (aref (get globalThis.process :argv) 1))
             (eq (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath module-url)))
    (let ((args (js-call (get globalThis.process :argv) :slice 2)))
      (funcall assert (js-call args :every (lambda (a) (js-call (js-array "--verify" "--require-production") :includes a))) "unknown benchmark argument")
      (let ((report (if (> (js-length args) 0) (await (validateDirectWasmReport (JSON/parse (await (readFile reportPath "utf8")))))
                      (await (runDirectWasmBenchmark)))))
        (when (= (js-length args) 0) (await (mkdir (resolve root "tools/backends/results") (js-object :recursive t)))
          (await (writeFile reportPath (str (JSON/stringify report nil 2) "\n"))))
        (console/log (JSON/stringify (js-object :summary (get report :summary) :decision (get report :decision)) nil 2))
        (when (and (js-call args :includes "--require-production") (not (get (get report :decision) :productionPassed)))
          (put globalThis.process :exitCode 1))))))
  (js-call (run-module-entry) :catch (lambda (error)
    (js-call (get (js* "globalThis") :console) :error error)
    (put (get (js* "globalThis") :process) :exitCode 1)))
  (export validateDirectWasmReport runDirectWasmBenchmark))
