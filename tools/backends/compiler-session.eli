                                               (/= (get product :target) target)
                                               (if (= target "wasm")
                                                 (not (undefined? (get product :typed)))
                                                 (or (not (get product :typed))
                                                     (/= (value-type (get product :typed)) "object")
                                                     (Array/isArray (get product :typed))
                                                     (/= (get (get product :typed) :abi) "memory-u32")
                                                     (not (Array/isArray (get (get product :typed) :functions)))
                                                     (not (Array/isArray (get (get product :typed) :exports)))
                                                     (/= (value-type (get product :nativeTarget)) "string")
                                                     (/= (get product :nativeTarget) native-target)
                                                     (not (js-call (js-array "library" "object") :includes (get product :nativeFormat)))
                                                     (/= (get product :nativeFormat) native-format)))
                                               (not (get product :descriptor))
                                               (/= (value-type (get product :descriptor)) "object")
                                               (Array/isArray (get product :descriptor))
                                               (undefined? (get product :bytes)))
                                       (throw (new globalThis.TypeError (+ "compiler returned an invalid owned " target " project"))))
                                     ;; The small lowering descriptor retains the exact public JSON
                                     ;; data contract. The fresh binary and complete debug graph have
                                     ;; a single build owner and require no second serialized graph.
                                     ;; The descriptor remains a small, independent public snapshot.
                                     ;; Native typed data is also public artifact metadata: use the
                                     ;; exact wire normalization, retaining canonical DAG nodes.
                                     (setq result (session-copy-properties (js-object) product))
                                     (put result :descriptor (JSON/parse (encodeCompilerIR (get product :descriptor))))
                                     (let ((normalize (ownedCompilerDataNormalizer)))
                                       (when (= target "native")
                                         (put result :typed (funcall normalize (get product :typed))))
                                       (when (not (undefined? (get product :debug)))
                                         (put result :debug (funcall normalize (get product :debug)))))
                                     (js-call ownedCompilerBuildProducts :add result)
                                     (setq owned t))))))))
                       (when (and (not owned) (not (undefined? response-mode)))
                         (let ((input (JSON/parse text)))
                           (when (or (nil? input) (/= (value-type input) "object") (Array/isArray input))
                             (throw (new globalThis.TypeError "compiler event request must be an object")))
                           (let ((patched (session-copy-properties (js-object) input)))
                             (put patched :responseMode response-mode)
                             (when (eq response-string-chunks t)
                               (put patched :responseStringChunks t))
                             (setq text (JSON/stringify patched)))))
                       (unless owned
                         (setq result (funcall receive text)))
                       (when (and (not owned) (not (undefined? response-mode)))
                         (let* ((graph (= response-mode "graph-events-v1"))
                                (expected-version (if (= graph t) 2 1))
                                (decoder (compiler-response-events graph (eq response-string-chunks t)))
                                (next-request undefined)
                                (done-loop false))
                           (try
                             (while (not (= done-loop t))
                               (when (or (nullish? result)
                                         (not (= (get result :format) "eliscript-compiler-response-events"))
                                         (not (= (get result :version) expected-version))
                                         (not (= (Number/isSafeInteger (get result :token)) t))
                                         (< (get result :token) 1)
                                         (not (= (session-value-type (get result :done)) "boolean"))
                                         (and (not (undefined? token)) (not (= token (get result :token)))))
                                 (throw (new globalThis.TypeError "compiler returned an invalid response envelope")))
                               (when (undefined? token)
                                 (setq token (get result :token))
                                 (setq next-request (JSON/stringify (js-object :operation "response-next" :token token))))
                               (setq pending (not (= (get result :done) t)))
                               (js-call decoder :append (get result :events))
                               (check-signal signal)
                               (if (= (get result :done) t)
                                 (progn
                                   (setq result (get decoder :value))
                                   (setq done-loop t))
                                 (progn
                                   (when (= (get decoder :complete) t)
                                     (throw (new globalThis.TypeError "compiler response completed before its final envelope")))
                                   (setq result (funcall receive next-request)))))
                             (finally (js-call decoder :release)))))
                       ;; Synchronous WASM/native execution cannot be preempted by AbortSignal.
                       ;; Observe cancellation at the completed request boundary only.
                       (check-signal signal))
                     (catch error
                       (setq failed t)
                       (setq failure (if transferred error (transfer-error runtime error))))
                     (finally
                       (when pending
                         (try
                           (funcall exchange (JSON/stringify (js-object :operation "response-close" :token token)))
                           (catch ignored nil)))
                       (setq busy false)))
                   (when failed (throw failure))
                   result))))
           (session
             (js-object
               :host host
               :request (lambda (request &rest rest-args)
                 (funcall request-data request (aref rest-args 0) false))
               :close (lambda ()
                 (unless closed
                   (when busy
                     (throw (new globalThis.Error "cannot close a compiler session during a request")))
                   (setq closed t)
                   (funcall close-owned))
                 undefined))))
      (Object/defineProperty session "closed"
        (js-object :get (lambda () closed) :enumerable t :configurable t))
      (Object/freeze session)
      (when (= host "javascript")
        (js-call ownedCompilerBuildRequests :set session
          (lambda (request &rest rest-args)
            (funcall request-data request (aref rest-args 0) t))))
      (js-call compilerBuildConsumptionRequests :set session
        (lambda (request &rest rest-args)
          (funcall request-data request (aref rest-args 0) false)))
      session))

  ;; A session owns one long-lived driver state. Requests cross as one JSON
  ;; string; target selection, compilation and runtime caching stay in the driver.
  ;; Only the private JS build handoff consumes a fresh result without a JSON copy.
  (defasync createCompilerSession (&rest session-args)
    (let* ((config (if (or (= (js-length session-args) 0) (undefined? (aref session-args 0)))
                     (js-object)
                     (aref session-args 0)))
           (host (get config :host))
           (compiler (get config :compiler))
           (bytes (get config :bytes))
           (descriptor (get config :descriptor))
           (path (get config :path))
           (memory (if (undefined? (get config :memory)) (js-object) (get config :memory)))
           (options (if (undefined? (get config :options)) (js-object) (get config :options))))
      (setq session-args undefined)
      (setq config undefined)
      (unless (js-call (js-array "javascript" "wasm" "native") :includes host)
        (throw (new globalThis.TypeError "unknown compiler session host")))
      (when (or (nil? options) (/= (value-type options) "object") (Array/isArray options)
                (nil? memory) (/= (value-type memory) "object") (Array/isArray memory))
        (throw (new globalThis.TypeError "compiler session memory and options must be objects")))
      (let* ((runtime undefined) (driver undefined) (state undefined)
             (has-state false)
             (auto (session-default (get options :auto) 65536))
             (heap-options (session-copy-properties (js-object) options (js-array "auto"))))
        (setq options undefined)
        (unless (and (Number/isInteger auto) (>= auto 0) (<= auto 4294967295))
          (throw (new globalThis.RangeError "invalid compiler collection threshold")))
        (try
          (if (= host "javascript")
            (progn
              (unless (and compiler (= (value-type compiler) "object"))
                (throw (new globalThis.TypeError "JavaScript compiler session requires a driver module")))
              (setq driver
                (js-object :module compiler
                  :create (get compiler (get names :create))
                  :request (get compiler (get names :request))
                  :close (get compiler (get names :close))))
              (setq compiler undefined)
              (when (js-call (js-array (get driver :create) (get driver :request) (get driver :close))
                      :some (lambda (value) (/= (value-type value) "function")))
                (throw (new globalThis.TypeError "compiler driver is missing its session exports")))
              (setq state (Reflect/apply (get driver :create) (get driver :module) (js-array)))
              (setq has-state t))
            (let ((settings (session-copy-properties
                              (session-copy-properties (js-object) compilerHeap)
                              heap-options)))
              (setq heap-options undefined)
              (put settings :initializeModule false)
              (if (= host "wasm")
                (progn
                  (when (undefined? bytes)
                    (throw (new globalThis.TypeError "WASM compiler session requires an artifact")))
                  (let ((input-bytes bytes))
                    (setq bytes undefined)
                    (setq runtime (instantiateManagedRuntime input-bytes settings))))
                (progn
                  (unless (and (= (value-type path) "string") (> (js-length path) 0)
                               (= (session-optional (session-optional descriptor "typed") "abi") "memory-u32")
                               (session-optional descriptor "descriptor"))
                    (throw (new globalThis.TypeError "native compiler session requires its library path and complete lowering descriptor")))
                  (let* ((native-module "./native-managed-runtime.mjs")
                         (native-mod (await (session-import-relative native-module)))
                         (instantiate-native (get native-mod :instantiateNativeManagedRuntime))
                         (native-opts (session-copy-properties
                                        (session-copy-properties
                                          (session-copy-properties (js-object) compilerMemory)
                                          memory)
                                        settings))
                         (input-path path)
                         (input-descriptor descriptor))
                    (setq path undefined)
                    (setq descriptor undefined)
                    (setq memory undefined)
                    (setq settings undefined)
                    (setq runtime (await (funcall instantiate-native input-path input-descriptor native-opts))))))
              (js-call runtime :auto auto)
              (js-call runtime :initializeModule)
              (setq state (js-call runtime :invoke (get names :create)))
              (setq has-state t)))
          (catch error
            (let ((primary (transfer-error runtime error)))
              (try (close-compiler-session-owned runtime driver state has-state) (catch ignored nil))
              (throw primary))))
        (create-compiler-session-handle host runtime driver state has-state))))

  (export
    isOwnedCompilerBuildProduct requestCompilerBuildProduct
    requestCompilerBuildConsumption registerVerifiedCompilerBuildConsumption
    registerCompilerBuildProductForwarder compilerSourceAssetEncoding
    encodeCompilerSourceAsset decodeCompilerSourceAsset
    encodeCompilerIR encodeCompilerMetadata
    forEachCompilerMetadataChunk forEachCompilerIRChunk
    createCompilerSession))
