(module tools.backends.compiler-session
  (import "./managed-runtime.mjs" instantiateManagedRuntime)

  (defconst names
    (Object/freeze
      (js-object
        :create "compiler_session_new"
        :request "compiler_session_request"
        :close "compiler_session_close")))

  (defconst compilerHeap
    (Object/freeze
      (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864)))

  (defconst compilerMemory
    (Object/freeze
      (js-object :initialPages 128 :maximumPages 4096)))

  (defconst ownedCompilerBuildRequests (new globalThis.WeakMap))
  (defconst ownedCompilerBuildProducts (new globalThis.WeakSet))
  (defconst compilerBuildConsumptionRequests (new globalThis.WeakMap))

  (defun session-default (value fallback)
    (if (undefined? value) fallback value))

  (defun session-value-type (value)
    (value-type value))

  (defun session-nullish (value fallback)
    (if (nullish? value) fallback value))

  (defun session-optional (value key)
    (if (nullish? value) undefined (get value key)))

  (defun session-module-url ()
    (let* ((stack (str (get (new globalThis.Error) :stack)))
           (file-match (js-call (new globalThis.RegExp "(file:\\/\\/[^\\s):]+\\.mjs):\\d+:\\d+") :exec stack)))
      (if file-match
        (aref file-match 1)
        (let* ((url-mod (js-call globalThis.process :getBuiltinModule "node:url"))
               (path-mod (js-call globalThis.process :getBuiltinModule "node:path"))
               (path-match (js-call (new globalThis.RegExp "(/[^\\s():]+\\.mjs):\\d+:\\d+") :exec stack)))
          (if path-match
            (get (js-call url-mod :pathToFileURL (aref path-match 1)) :href)
            (get (js-call url-mod :pathToFileURL (js-call path-mod :resolve "tools/backends/compiler-session.mjs")) :href))))))

  (defasync session-import-relative (specifier)
    (let ((url (get (new globalThis.URL specifier (session-module-url)) :href))
          (importer (new globalThis.Function "u" "return import(u);")))
      (await (funcall importer url))))

  (defun session-copy-properties (target source &optional excluded)
    (unless (nullish? source)
      (let* ((object (funcall globalThis.Object source))
             (keys (Reflect/ownKeys object))
             (index 0))
        (while (< index (js-length keys))
          (let ((key (aref keys index)))
            (unless (and excluded (js-call excluded :includes key))
              (let ((descriptor (Object/getOwnPropertyDescriptor object key)))
                (when (and descriptor (get descriptor :enumerable))
                  (Object/defineProperty target key
                    (js-object :value (get object key) :writable t :enumerable t :configurable t))))))
          (setq index (1+ index)))))
    target)

  ;; Ownership is recorded by the successful private handoff, never by a field
  ;; on a caller-provided producer or response. Only these products may stream
  ;; their private debug values without the public writer's eager snapshot.
  (defun isOwnedCompilerBuildProduct (value)
    (js-call ownedCompilerBuildProducts :has value))

  ;; Only the concrete JavaScript session below can own a freshly emitted binary
  ;; product. Public requests and arbitrary producer wrappers keep their wire
  ;; snapshot contract; no caller-provided property enables this internal path.
  (defun requestCompilerBuildProduct (session request &rest rest-args)
    (let ((options (aref rest-args 0))
          (owned (js-call ownedCompilerBuildRequests :get session)))
      (if owned
        (funcall owned request options)
        (js-call session :request request options))))

  ;; A driver's private handoff can retain canonical subtrees. Its public wire
  ;; response instead creates a complete new data graph, including debug/typed
  ;; records. A verified artifact loader may register its existing fresh-product
  ;; handoff instead. Public producers cannot transfer either right through
  ;; fields on a response or an old ownership token.
  (defasync requestCompilerBuildConsumption (session request &rest rest-args)
    (let ((options (aref rest-args 0))
          (consume (js-call compilerBuildConsumptionRequests :get session)))
      (js-object
        :product (await (if consume
                          (funcall consume request options)
                          (js-call session :request request options)))
        :owned (not (undefined? consume)))))

  (defasync registerVerifiedCompilerBuildConsumption (session)
    (let* ((loader "./compiler-bootstrap.mjs")
           (mod (await (session-import-relative loader)))
           (is-verified (get mod :isVerifiedCompilerBuildSession))
           (owned (js-call ownedCompilerBuildRequests :get session)))
      (unless (and owned (funcall is-verified session))
        (throw (new globalThis.TypeError "exclusive compiler consumption requires a verified JavaScript artifact session")))
      (js-call compilerBuildConsumptionRequests :set session owned)
      session))

  ;; The authenticated artifact adapter injects runtime assets in its public
  ;; request method. Only its project dispatch forwards ownership unchanged;
  ;; wrapping that adapter again does not inherit this private registration.
  (defun registerCompilerBuildProductForwarder (adapter session)
    (let ((owned (js-call ownedCompilerBuildRequests :get session)))
      (when owned
        (js-call ownedCompilerBuildRequests :set adapter
          (lambda (request &rest rest-args)
            (let ((options (aref rest-args 0))
                  (record (if (= (value-type request) "string") (JSON/parse request) request)))
              (if (and (not (nullish? record)) (= (get record :operation) "project"))
                (funcall owned request options)
                (js-call adapter :request request options)))))))
    (let ((consume (js-call compilerBuildConsumptionRequests :get session)))
      (when consume
        (js-call compilerBuildConsumptionRequests :set adapter
          (lambda (request &rest rest-args)
            (let ((options (aref rest-args 0))
                  (record (if (= (value-type request) "string") (JSON/parse request) request)))
              (if (and (not (nullish? record)) (= (get record :operation) "project"))
                (funcall consume request options)
                (js-call adapter :request request options)))))))
    adapter)

  ;; UTF-8 files cannot represent an unpaired UTF-16 surrogate. Such virtual
  ;; source text crosses the file/download boundary as a JSON string instead of
  ;; silently becoming U+FFFD; ordinary source files keep their existing format.
  (defun compilerSourceAssetEncoding (source)
    (unless (= (value-type source) "string")
      (throw (new globalThis.TypeError "compiler source asset must contain a string")))
    (let ((index 0) (len (js-length source)) (encoding "utf8"))
      (while (and (< index len) (= encoding "utf8"))
        (let ((unit (js-call source :charCodeAt index)))
          (cond
            ((and (>= unit 55296) (<= unit 56319))
             (let ((next (js-call source :charCodeAt (1+ index))))
               (if (and (>= next 56320) (<= next 57343))
                 (setq index (1+ index))
                 (setq encoding "json-utf16"))))
            ((and (>= unit 56320) (<= unit 57343))
             (setq encoding "json-utf16"))))
        (setq index (1+ index)))
      encoding))

  (defun encodeCompilerSourceAsset (source)
    (let ((encoding (compilerSourceAssetEncoding source)))
      (js-object :encoding encoding
        :text (if (= encoding "utf8") source (JSON/stringify source)))))

  (defun decodeCompilerSourceAsset (bytes &rest rest)
    (let ((encoding (if (or (= (js-length rest) 0) (undefined? (aref rest 0))) "utf8" (aref rest 0))))
      (unless (or (= encoding "utf8") (= encoding "json-utf16"))
        (throw (new globalThis.TypeError "unsupported compiler source asset encoding")))
      (let ((text (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode bytes)))
        (if (= encoding "utf8")
          text
          (let ((source (JSON/parse text)))
            (unless (= (value-type source) "string")
              (throw (new globalThis.TypeError "encoded compiler source asset must contain a JSON string")))
            source)))))

  (defun check-signal (signal)
    (unless (undefined? signal)
      (when (or (nil? signal) (/= (value-type signal) "object") (/= (value-type (get signal :aborted)) "boolean"))
        (throw (new globalThis.TypeError "compiler request requires an AbortSignal")))
      (if (= (value-type (get signal :throwIfAborted)) "function")
        (js-call signal :throwIfAborted)
        (when (get signal :aborted)
          (if (not (undefined? (get signal :reason)))
            (throw (get signal :reason))
            (let ((error (new globalThis.Error "compiler request aborted")))
              (put error :name "AbortError")
              (throw error)))))))

  (defun compiler-response-events (&optional graph-arg string-chunks-arg)
    (let* ((graph (if (nullish? graph-arg) false (funcall globalThis.Boolean graph-arg)))
           (string-chunks (if (nullish? string-chunks-arg) false (funcall globalThis.Boolean string-chunks-arg)))
           (root undefined)
           (has-root false)
           (frames (js-array))
           (references (js-array))
           (active-references (new globalThis.Set))
           (invalid (lambda ()
             (throw (new globalThis.TypeError "compiler returned invalid response events"))))
           (attach (lambda (value)
             (if (= (js-length frames) 0)
               (progn
                 (when (= has-root t) (funcall invalid))
                 (setq root value)
                 (setq has-root t))
               (let ((frame (aref frames (1- (js-length frames)))))
                 (if (= (get frame :array) t)
                   (js-call (get frame :value) :push value)
                   (progn
                     (unless (= (get frame :hasKey) t) (funcall invalid))
                     (if (= (get frame :key) "__proto__")
                       (Object/defineProperty (get frame :value) (get frame :key)
                         (js-object :value value :writable t :enumerable t :configurable t))
                       (put (get frame :value) (get frame :key) value))
                     (put frame :hasKey false)
                     (put frame :key undefined))))))))
      (let ((decoder
              (js-object
                :append (lambda (events)
                  (when (or (not (= (Array/isArray events) t)) (= (js-length events) 0) (> (js-length events) 256))
                    (funcall invalid))
                  (let ((idx 0) (len (js-length events)))
                    (while (< idx len)
                      (let ((event (aref events idx)))
                        (unless (= (Array/isArray event) t) (funcall invalid))
                        (let ((kind (aref event 0))
                              (value (aref event 1))
                              (active (aref frames (1- (js-length frames)))))
                          (if (and (not (undefined? active)) (= (get active :string) t))
                            (cond
                              ((and (= kind "string-chunk") (= (js-length event) 2) (= (session-value-type value) "string")
                                    (> (js-length value) 0) (<= (js-length value) 8192)
                                    (<= (+ (get active :units) (js-length value)) (get active :length)))
                               (js-call (get active :parts) :push value)
                               (put active :units (+ (get active :units) (js-length value))))
                              ((and (= kind "end") (= (js-length event) 1) (= (get active :units) (get active :length)))
                               (js-call frames :pop)
                               (let ((text (js-call (get active :parts) :join "")))
                                 (put active :parts undefined)
                                 (funcall attach text)))
                              (t (funcall invalid)))
                            (cond
                              ((and (= string-chunks t) (= kind "string") (= (js-length event) 2)
                                    (= (Number/isSafeInteger value) t) (> value 0))
                               ;; Complete only after the announced UTF16 length is received. The
                               ;; parent key remains pending until this single scalar is attached.
                               (js-call frames :push (js-object :string t :length value :units 0 :parts (js-array))))
                              ((and (or (= kind "object") (= kind "array"))
                                    (or (and (= graph t) (= (js-length event) 2)
                                             (= (Number/isSafeInteger value) t)
                                             (= value (1+ (js-length references))))
                                        (and (not (= graph t)) (= (js-length event) 1))))
                               (let ((container (if (= kind "array") (js-array) (js-object))))
                                 (when (= graph t)
                                   (js-call references :push container)
                                   (js-call active-references :add value))
                                 (funcall attach container)
                                 (js-call frames :push
                                   (js-object :value container :array (= kind "array") :hasKey false
                                     :reference (if (= graph t) value undefined)))))
                              ((and (= graph t) (= kind "reference") (= (js-length event) 2))
                               (when (or (not (= (Number/isSafeInteger value) t)) (< value 1)
                                         (> value (js-length references))
                                         (= (js-call active-references :has value) t))
                                 (funcall invalid))
                               (funcall attach (aref references (1- value))))
                              ((and (= kind "key") (= (js-length event) 2) (= (session-value-type value) "string"))
                               (let ((frame (aref frames (1- (js-length frames)))))
                                 (when (or (undefined? frame) (= (get frame :array) t) (= (get frame :hasKey) t))
                                   (funcall invalid))
                                 (put frame :key value)
                                 (put frame :hasKey t)))
                              ((and (= kind "value") (= (js-length event) 2))
                               (if (nil? value)
                                 (funcall attach value)
                                 (let ((vtype (session-value-type value)))
                                   (if (or (= vtype "string") (= vtype "number") (= vtype "boolean"))
                                     (funcall attach value)
                                     (funcall invalid)))))
                              ((and (= kind "array-values") (= (js-length event) 2))
                               (let ((frame (aref frames (1- (js-length frames)))))
                                 (when (or (undefined? frame) (not (= (get frame :array) t))
                                           (not (= (Array/isArray value) t)) (< (js-length value) 1) (> (js-length value) 256))
                                   (funcall invalid))
                                 ;; Bounded scalar runs preserve every element, including IEEE -0.
                                 ;; Validate the whole run before appending any of its values.
                                 (let ((v-idx 0) (v-len (js-length value)) (target (get frame :value)))
                                   (while (< v-idx v-len)
                                     (let ((item (aref value v-idx)))
                                       (unless (or (nil? item) (= (Number/isFinite item) t))
                                         (funcall invalid)))
                                     (setq v-idx (1+ v-idx)))
                                   (setq v-idx 0)
                                   (while (< v-idx v-len)
                                     (js-call target :push (aref value v-idx))
                                     (setq v-idx (1+ v-idx))))))
                              ((and (= kind "end") (= (js-length event) 1))
                               (let ((frame (js-call frames :pop)))
                                 (when (or (undefined? frame) (= (get frame :hasKey) t))
                                   (funcall invalid))
                                 (when (= graph t)
                                   (js-call active-references :delete (get frame :reference)))))
                              (t (funcall invalid))))))
                      (setq idx (1+ idx)))))
                :release (lambda ()
                  ;; Neither a failed/cancelled response nor a completed handoff keeps its
                  ;; temporary string pieces or graph identity index beside later replies.
                  (let ((idx 0) (len (js-length frames)))
                    (while (< idx len)
                      (let ((frame (aref frames idx)))
                        (when (= (get frame :string) t)
                          (put frame :parts undefined)))
                      (setq idx (1+ idx))))
                  (put frames :length 0)
                  (put references :length 0)
                  (js-call active-references :clear)
                  (setq root undefined)
                  (setq has-root false)))))
        (Object/defineProperty decoder "complete"
          (js-object :get (lambda () (and (= has-root t) (= (js-length frames) 0)))
            :enumerable t :configurable t))
        (Object/defineProperty decoder "value"
          (js-object :get (lambda ()
                            (unless (and (= has-root t) (= (js-length frames) 0))
                              (funcall invalid))
                            root)
            :enumerable t :configurable t))
        decoder)))

  (defun encode-request (request)
    (if (= (session-value-type request) "string")
      request
      (let ((text (JSON/stringify request)))
        (unless (= (session-value-type text) "string")
          (throw (new globalThis.TypeError "compiler request must contain JSON data")))
        text)))

  (defun encode-compiler-data (program metadata &optional consume)
    ;; Bound the number of live token strings while retaining exact wire bytes.
    ;; Large binaries/typed IR otherwise keep millions of tiny strings and an
    ;; equally large pointer array until the final join.
    (let* ((chunks (if (nullish? consume) (js-array) undefined))
           (ancestors (new globalThis.Set))
           (frames (js-array))
           (quoted-strings (new globalThis.Map))
           (short-quotes (new globalThis.Map))
           (emit (if (nullish? consume) (lambda (text) (js-call chunks :push text)) consume))
           (large-token-units 1024)
           ;; Quoting is a discardable primitive-value cache, not an identity table.
           ;; Getters can produce arbitrarily many distinct long strings during a
           ;; streaming hash. Bound both key and quoted text retained by this call.
           (quoted-string-units-limit 4194304)
           (quoted-string-entries-limit 1024)
           (quoted-string-block-units 8192)
           (quoted-string-whole-units 32768)
           (quoted-string-units 0)
           (pending (js-array))
           (pending-units 0)
           (flush (lambda ()
             (when (> (js-length pending) 0)
               (funcall emit (Array.prototype.join.call pending ""))
               (put pending :length 0)
               (setq pending-units 0))))
           (push (lambda (text)
             ;; A repeated source token already owns its exact quoted bytes. Joining it
             ;; with punctuation here would create another large copy for every edge,
             ;; defeating sharing until the final output is assembled.
             (if (>= (js-length text) large-token-units)
               (progn (funcall flush) (funcall emit text))
               (progn
                 (js-call pending :push text)
                 (setq pending-units (+ pending-units (js-length text)))
                 (when (or (>= (js-length pending) 2048) (>= pending-units 32768))
                   (funcall flush))))))
           (remember-quote (lambda (value text units)
             (when (or (>= (get quoted-strings :size) quoted-string-entries-limit)
                       (> (+ quoted-string-units units) quoted-string-units-limit))
               (js-call quoted-strings :clear)
               (setq quoted-string-units 0))
             (js-call quoted-strings :set value text)
             (setq quoted-string-units (+ quoted-string-units units))))
           (quote-str (lambda (value)
             (if (< (js-length value) large-token-units)
               (let ((text (js-call short-quotes :get value)))
                 (when (undefined? text)
                   (setq text (JSON/stringify value))
                   (when (< (get short-quotes :size) 4096)
                     (js-call short-quotes :set value text)))
                 text)
               (let ((text (js-call quoted-strings :get value)))
                 (when (undefined? text)
                   (setq text (JSON/stringify value))
                   (let ((units (+ (js-length value) (js-length text))))
                     (when (<= units quoted-string-units-limit)
                       (funcall remember-quote value text units))))
                 text))))
           (push-quoted (lambda (value)
             (if (<= (js-length value) quoted-string-whole-units)
               (funcall push (funcall quote-str value))
               ;; A bounded output writer must also bound quoting its largest primitive.
               ;; Never form a second complete escaped source string before streaming it.
               (let ((cached (js-call quoted-strings :get value)))
                 (if (not (undefined? cached))
                   (let ((idx 0) (len (js-length cached)))
                     (funcall push "\"")
                     (while (< idx len)
                       (funcall push (aref cached idx))
                       (setq idx (1+ idx)))
                     (funcall push "\""))
                   (let ((parts (if (<= (+ (* (js-length value) 2) 2) quoted-string-units-limit) (js-array) undefined))
                         (units (+ (js-length value) 2))
                         (start 0)
                         (len (js-length value)))
                     (funcall push "\"")
                     (while (< start len)
                       (let ((end (Math/min (+ start quoted-string-block-units) len)))
                         (when (< end len)
                           (let ((high (js-call value :charCodeAt (1- end)))
                                 (low (js-call value :charCodeAt end)))
                             (when (and (>= high 55296) (<= high 56319) (>= low 56320) (<= low 57343))
                               (setq end (1- end)))))
                         ;; JSON's escaping is local to code points. Keeping a surrogate pair in
                         ;; one block preserves both well-formed JSON spelling and UTF8 hashing.
                         (let ((part (js-call (JSON/stringify (js-call value :slice start end)) :slice 1 -1)))
                           (funcall push part)
                           (setq units (+ units (js-length part)))
                           (when (not (undefined? parts))
                             (if (> units quoted-string-units-limit)
                               (setq parts undefined)
                               (js-call parts :push part))))
                         (setq start end)))
                     (funcall push "\"")
                     (when (not (undefined? parts))
                       (funcall remember-quote value parts units))))))))
           (append (lambda (value &optional array-element)
             (if (nil? value)
               (progn (funcall push "null") t)
               (let ((kind (session-value-type value)))
                 (cond
                   ((= kind "number")
                    (funcall push
                      (if (and (= value 0) (< (/ 1 value) 0))
                        "-0"
                        (if (= (Number/isFinite value) t) (str value) "null")))
                    t)
                   ((= kind "string")
                    (funcall push-quoted value)
                    t)
                   ((= kind "boolean")
                    (funcall push (if (= value t) "true" "false"))
                    t)
                   ((= kind "bigint")
                    (unless (= metadata t)
                      (throw (new globalThis.TypeError "compiler IR cannot contain BigInt values")))
                    (funcall push-quoted (str value))
                    t)
                   ((not (= kind "object"))
                    (when (= array-element t) (funcall push "null"))
                    false)
                   (t
                    (when (= (js-call ancestors :has value) t)
                      (throw (new globalThis.TypeError "compiler IR cannot contain cycles")))
                    (js-call ancestors :add value)
                    (if (= (Array/isArray value) t)
                      (progn
                        (funcall push "[")
                        (js-call frames :push (js-object :value value :array t :index 0)))
                      (progn
                        (funcall push "{")
                        (js-call frames :push
                          (js-object :value value :array false :keys (Object/keys value) :index 0 :first t))))
                    t)))))))
      (unless (= (funcall append program false) t)
        (throw (new globalThis.TypeError "compiler IR must be JSON data")))
      ;; Keep traversal state on the data stack. Complete compiler IR can exceed
      ;; the host call-stack depth, and shared subtrees must remain legal once
      ;; their previous traversal has completed.
      (while (> (js-length frames) 0)
        (let ((frame (aref frames (1- (js-length frames)))))
          (if (= (get frame :array) t)
            (if (< (get frame :index) (js-length (get frame :value)))
              (let ((index (get frame :index)))
                (put frame :index (1+ index))
                (when (> index 0) (funcall push ","))
                (funcall append (aref (get frame :value) index) t))
              (progn
                (funcall push "]")
                (js-call ancestors :delete (get frame :value))
                (js-call frames :pop)))
            (if (< (get frame :index) (js-length (get frame :keys)))
              (let* ((index (get frame :index))
                     (key (aref (get frame :keys) index))
                     (item (get (get frame :value) key))
                     (item-kind (session-value-type item)))
                (put frame :index (1+ index))
                (unless (or (undefined? item) (= item-kind "function") (= item-kind "symbol"))
                  (unless (= (get frame :first) t) (funcall push ","))
                  (put frame :first false)
                  (funcall push-quoted key)
                  (funcall push ":")
                  (funcall append item false)))
              (progn
                (funcall push "}")
                (js-call ancestors :delete (get frame :value))
                (js-call frames :pop))))))
      (funcall flush)
      (if (undefined? chunks) undefined (Array.prototype.join.call chunks ""))))

  ;; A data codec for the already produced IR. It performs no compilation or IR
  ;; reconstruction, and preserves the IEEE negative zero in JSON number text.
  (defun encodeCompilerIR (program)
    (encode-compiler-data program false))

  ;; Retained compiler data uses the same IEEE-preserving, non-recursive wire
  ;; format. Diagnostic BigInts keep the metadata boundary's decimal-string form;
  ;; executable IR continues to reject them rather than silently changing types.
  (defun encodeCompilerMetadata (value)
    (encode-compiler-data value t))

  ;; Packaging can hash the exact metadata wire without first materializing one
  ;; giant string. Consumption is synchronous, so getters and shared subtrees
  ;; have the same visit order as encodeCompilerMetadata.
  (defun forEachCompilerMetadataChunk (value consume)
    (unless (= (session-value-type consume) "function")
      (throw (new globalThis.TypeError "compiler metadata chunk consumer must be a function")))
    (encode-compiler-data value t consume))

  ;; The IR wire differs from metadata only in rejecting BigInt. Archive writers
  ;; use this exact codec without materializing an additional complete document.
  (defun forEachCompilerIRChunk (value consume)
    (unless (= (session-value-type consume) "function")
      (throw (new globalThis.TypeError "compiler IR chunk consumer must be a function")))
    (encode-compiler-data value false consume))

  ;; Like the response identity index, necessary object identities are split
  ;; across finite host tables. The index lives only for one private handoff;
  ;; its keys are already owned by that handoff or the compiler's source cache.
  (defun compilerOwnedDataMemo (&rest rest-args)
    (let* ((segment-size-arg (aref rest-args 0))
           (segment-size (if (undefined? segment-size-arg) 1048576 segment-size-arg)))
      (unless (and (= (Number/isSafeInteger segment-size) t)
                   (= (Math/min (Math/max segment-size 1) 1048576) segment-size))
        (throw (new globalThis.TypeError "invalid owned compiler memo segment size")))
      (let* ((segments (js-array (new globalThis.Map)))
             (find (lambda (key)
               (let ((index (+ (js-length segments) -1))
                     (found undefined))
                 (while (and (not (= index -1)) (undefined? found))
                   (when (= (js-call (aref segments index) :has key) t)
                     (setq found (aref segments index)))
                   (setq index (+ index -1)))
                 found))))
        (js-object
          :segments segments
          :has (lambda (key) (not (undefined? (funcall find key))))
          :get (lambda (key)
                 (let ((seg (funcall find key)))
                   (if (undefined? seg) undefined (js-call seg :get key))))
          :set (lambda (key value)
                 (let ((segment (funcall find key)))
                   (when (undefined? segment)
                     (setq segment (aref segments (+ (js-length segments) -1)))
                     (when (= (Math/max (get segment :size) segment-size) (get segment :size))
                       (setq segment (new globalThis.Map))
                       (js-call segments :push segment)))
