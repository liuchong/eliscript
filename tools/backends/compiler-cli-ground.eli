(module tools.backends.compiler-cli-ground
  (import "node:fs/promises" readFile writeFile mkdir open)
  (import "node:fs" writeSync)
  (import "node:path" resolve dirname relative isAbsolute sep basename)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:util" parseArgs)
  (import "node:crypto" createHash)
  (import "./compiler-build.mjs" buildIndependentCompiler decodeCompilerBinary writeCompilerMetadata)
  (import "./compiler-project.mjs" loadCompilerProject)
  (import "./compiler-bootstrap.mjs"
    bootstrapCompilerChain bootstrapIndependentCompilers bootstrapCompilerGrid
    compilerFailure openCompilerArtifact)
  (import "./compiler-package.mjs" packageIndependentCompiler)
  (import "./compiler-matrix.mjs" buildCompilerMatrix)
  (import "./managed-module-graph.mjs" createManagedProjectFacades)
  (import "./compiler-session.mjs"
    encodeCompilerMetadata forEachCompilerMetadataChunk
    isOwnedCompilerBuildProduct requestCompilerBuildProduct)
  (import "./compiler-metadata.mjs" readCompilerMetadata)

  (defun cli-default (value fallback)
    (if (undefined? value) fallback value))

  (defun cli-nullish (value fallback)
    (if (nullish? value) fallback value))

  (defun cli-optional (value key)
    (if (nullish? value) undefined (get value key)))

  (defun cli-module-url ()
    (let* ((stack (str (get (new globalThis.Error) :stack)))
           (file-match (js-call (new globalThis.RegExp "(file:\\/\\/[^\\s):]+\\.mjs):\\d+:\\d+") :exec stack)))
      (if file-match
        (aref file-match 1)
        (let ((path-match (js-call (new globalThis.RegExp "(/[^\\s():]+\\.mjs):\\d+:\\d+") :exec stack)))
          (if path-match
            (get (pathToFileURL (aref path-match 1)) :href)
            (get (pathToFileURL (resolve "tools/backends/compiler-cli-ground.mjs")) :href))))))

  (defasync write-owned-compiler-metadata (path value)
    (let ((file (await (open path "w"))) (failed false))
      (try
        (let* ((encoder (new globalThis.TextEncoder))
               (bytes (new globalThis.Uint8Array 65536))
               (consume
                 (lambda (chunk)
                   (let ((start 0) (len (js-length chunk)))
                     (while (< start len)
                       (let ((end (Math/min (+ start 65536) len)))
                         (when (and (< end len)
                                    (>= (js-call chunk :charCodeAt (1- end)) 55296)
                                    (<= (js-call chunk :charCodeAt (1- end)) 56319)
                                    (>= (js-call chunk :charCodeAt end) 56320)
                                    (<= (js-call chunk :charCodeAt end) 57343))
                           (setq end (1- end)))
                         (let* ((encoded (js-call encoder :encodeInto (js-call chunk :slice start end) bytes))
                                (read-units (get encoded :read))
                                (written (get encoded :written)))
                           (unless (and (Number/isInteger read-units) (>= read-units 1) (<= read-units (- end start))
                                        (Number/isInteger written) (>= written 1) (<= written (js-length bytes)))
                             (throw (new globalThis.Error "compiler metadata UTF8 encoding did not advance")))
                           (let ((offset 0))
                             (while (< offset written)
                               (let ((count (writeSync (get file :fd) bytes offset (- written offset))))
                                 (unless (and (Number/isInteger count) (>= count 1) (<= count (- written offset)))
                                   (throw (new globalThis.Error "compiler metadata write did not advance")))
                                 (setq offset (+ offset count)))))
                           (setq start (+ start read-units)))))))))
          (forEachCompilerMetadataChunk value consume)
          (funcall consume "\n")
          undefined)
        (catch error (setq failed t) (throw error))
        (finally
          (try (await (js-call file :close))
            (catch error (unless failed (throw error))))))))

  (defconst help
    "Usage:\n  compiler-cli.mjs build --seed --host wasm --output DIRECTORY\n  compiler-cli.mjs build --producer-artifact METADATA --host native --output DIRECTORY\n  compiler-cli.mjs compile --compiler-artifact METADATA --input SOURCE --target javascript --output FILE\n  compiler-cli.mjs compile --compiler-artifact METADATA --input SOURCE --target wasm --output FILE\n  compiler-cli.mjs compile --compiler-artifact METADATA --project ENTRY.eli --root DIRECTORY --target javascript --output DIRECTORY\n  compiler-cli.mjs request --compiler-artifact METADATA --request REQUEST_JSON --output FILE\n  compiler-cli.mjs bootstrap --output DIRECTORY [--host wasm --generations 3]\n  compiler-cli.mjs bootstrap --output DIRECTORY --hosts javascript,wasm,native\n  compiler-cli.mjs bootstrap-all --output DIRECTORY [--generations 3]\n  compiler-cli.mjs compiler-grid --output DIRECTORY [--profile full-runtime]\n  compiler-cli.mjs matrix --output DIRECTORY [--compiler-artifacts METADATA]...\n  compiler-cli.mjs package --compiler-artifact METADATA --output DIRECTORY\n\nBuilds default to the unchanged small resource profile. Use --profile full-runtime\nexplicitly for the separate full-runtime configuration. An existing compiler\nartifact always executes its own host; the CLI does not substitute the seed.\nNative output uses --native-target arm64-macos|arm64-linux and --native-format library|object.\nUse --debug to retain binary instruction-to-source mappings beside the output.\nUse --json-errors for a structured error record on stderr and a nonzero exit status.\nMacro file access requires --macro-capability read-file and one or more\n--macro-dependency SPECIFIER=ROOT_RELATIVE_FILE options; access stays inside --root.\nUse --host-modules DECLARATIONS_JSON to explicitly declare foreign MJS edges.\nBinary mixed projects emit ESM facades beside the binary; deploy the unchanged\nforeign providers at their declared paths beside those facades.\n")

  (defasync read-text (path)
    (let ((decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t))))
      (if (/= path "-")
        (js-call decoder :decode (await (readFile (resolve path))))
        ;; A UTF-8 scalar may straddle two pipe chunks. Keep decoder state until
        ;; EOF, and retain a source BOM so compiler offsets still name the input.
        (let ((iterator (js-call (get globalThis.process :stdin) (get globalThis.Symbol :asyncIterator)))
              (parts (js-array))
              (done false))
          (while (not done)
            (let ((step (await (js-call iterator :next))))
              (if (get step :done)
                (setq done t)
                (js-call parts :push (js-call decoder :decode (get step :value) (js-object :stream t))))))
          (js-call parts :push (js-call decoder :decode))
          (js-call parts :join "")))))

  (defasync open-compiler (metadata-file)
    (let* ((metadata-path (resolve metadata-file))
           (loaded (await (readCompilerMetadata metadata-path)))
           (artifact (Object/assign (js-object) loaded
                       (js-object :directory (dirname metadata-path) :metadataPath metadata-path)))
           (session (await (openCompilerArtifact artifact))))
      (js-object :session session :artifact artifact :metadataPath metadata-path)))

  (defasync close-compiler (session failed)
    (try
      (when (not (nullish? session))
        (await (js-call session :close)))
      (catch error
        (unless failed (throw error)))))

  (defasync save-host-sources (directory sources &optional reserved-arg)
    (if (undefined? sources)
      (js-array)
      (progn
        (unless (Array/isArray sources)
          (throw (new globalThis.TypeError "host sources must be an array")))
        (let ((occupied (new globalThis.Set (if (nullish? reserved-arg) (js-array) reserved-arg)))
              (records (js-array))
              (invalid-re (new globalThis.RegExp "[\\\\:\\u0000?#]"))
              (index 0))
          (while (< index (js-length sources))
            (let* ((source (aref sources index))
                   (id (cli-optional source "id")))
              (when (or (/= (value-type id) "string")
                        (not (js-call id :endsWith ".mjs"))
                        (js-call invalid-re :test id)
                        (isAbsolute id)
                        (js-call (js-call id :split "/") :some
                          (lambda (part) (or (not part) (= part ".") (= part ".."))))
                        (/= (value-type (get source :source)) "string")
                        (js-call occupied :has id))
                (throw (new globalThis.TypeError "invalid or colliding original host source")))
              (let* ((path (resolve directory id))
                     (part (relative directory path)))
                (when (or (not part) (= part "..") (js-call part :startsWith (+ ".." sep)) (isAbsolute part))
                  (throw (new globalThis.TypeError "host source escapes the output directory")))
                (js-call occupied :add id)
                (let ((bytes (Buffer/from (get source :source) "utf8")))
                  (await (mkdir (dirname path) (js-object :recursive t)))
                  (await (writeFile path bytes))
                  (js-call records :push
                    (js-object :id id :path id
                      :sha256 (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))))))
            (setq index (1+ index)))
          records))))

  (defasync save-result (result output request)
    (if (Array/isArray (cli-optional result "modules"))
      (progn
        (unless output
          (throw (new globalThis.TypeError "JavaScript project output requires --output directory")))
        (let ((directory (resolve output))
              (ids (new globalThis.Set))
              (modules (get result :modules))
              (index 0))
          (while (< index (js-length modules))
            (let* ((mod (aref modules index))
                   (id (get mod :id))
                   (javascript (get mod :javascript)))
              (when (or (/= (value-type id) "string")
                        (/= (value-type javascript) "string")
                        (js-call ids :has id)
                        (js-call id :includes "\\")
                        (isAbsolute id))
                (throw (new globalThis.TypeError "invalid compiler project module")))
              (let* ((path (resolve directory id))
                     (part (relative directory path)))
                (when (or (not part) (= part "..") (js-call part :startsWith (+ ".." sep)) (isAbsolute part))
                  (throw (new globalThis.TypeError "project output escapes its directory")))
                (js-call ids :add id)
                (await (mkdir (dirname path) (js-object :recursive t)))
                (let ((mapping (= (value-type (get mod :sourceMap)) "string")))
                  (await (writeFile path
                    (+ javascript
                       (if mapping
                         (+ "\n//# sourceMappingURL=" (globalThis.encodeURIComponent (+ (basename path) ".map")) "\n")
                         ""))))
                  (when mapping
                    (await (writeFile (+ path ".map") (get mod :sourceMap))))
                  (when (Array/isArray (get mod :macroOrigins))
                    (await (writeFile (+ path ".macro-origins.json")
                      (+ (JSON/stringify (get mod :macroOrigins) nil 2) "\n")))))))
            (setq index (1+ index)))
          (let* ((reserved (js-call (Array/from ids) :concat (js-array "eliscript-project.json")))
                 (host-sources (await (save-host-sources directory (cli-optional request "hostSources") reserved)))
                 (project-manifest
                   (js-object :target (get result :target) :entry (get result :entry)
                     :modules (js-call modules :map
                       (lambda (mod)
                         (let ((rec (js-object :id (get mod :id) :path (get mod :id))))
                           (when (= (value-type (get mod :sourceMap)) "string")
                             (put rec :sourceMapPath (+ (get mod :id) ".map")))
                           (when (Array/isArray (get mod :macroOrigins))
                             (put rec :macroOriginsPath (+ (get mod :id) ".macro-origins.json")))
                           rec))))))
            (when (> (js-length host-sources) 0)
              (put project-manifest :hostSources host-sources))
            (await (writeFile (resolve directory "eliscript-project.json")
              (+ (JSON/stringify project-manifest nil 2) "\n"))))))
      (let* ((owned (isOwnedCompilerBuildProduct result))
             (data
               (cond
                 ((not (undefined? (cli-optional result "bytes")))
                  (let ((decoded (decodeCompilerBinary (get result :bytes))))
                    (when owned (put result :bytes undefined))
                    decoded))
                 ((= (value-type (cli-optional result "javascript")) "string")
                  (get result :javascript))
                 (t (+ (encodeCompilerMetadata result) "\n")))))
        (if (not output)
          (progn
            (when (js-call globalThis.Uint8Array (get globalThis.Symbol :hasInstance) data)
              (throw (new globalThis.TypeError "binary compiler output requires --output")))
            (js-call (get globalThis.process :stdout) :write data))
          (let ((path (resolve output)))
            (await (mkdir (dirname path) (js-object :recursive t)))
            (await (writeFile path data))
            (when (= (value-type (cli-optional result "sourceMap")) "string")
              (await (writeFile (+ path ".map") (get result :sourceMap))))
            (let ((has-debug (not (nullish? (cli-optional result "debug")))))
              (when has-debug
                (if owned
                  (progn
                    (await (write-owned-compiler-metadata (+ path ".debug.json") (get result :debug)))
                    (put result :debug undefined))
                  (await (writeCompilerMetadata (+ path ".debug.json") (get result :debug)))))
              (when (and (or (js-call globalThis.Uint8Array (get globalThis.Symbol :hasInstance) data)
                             (not (undefined? (cli-optional result "bytes"))))
                         (or (cli-optional result "descriptor")
                             (= (cli-optional result "abi") "memory-u32")))
                (let ((project undefined))
                  (when (cli-optional (cli-optional result "descriptor") "project")
                    (let* ((entry-val (cli-nullish (get result :entry) (cli-optional request "entry")))
                           (facades (createManagedProjectFacades (get result :descriptor) (js-object :entry entry-val)))
                           (files (get facades :files))
                           (f-idx 0))
                      (while (< f-idx (js-length files))
                        (let* ((file (aref files f-idx))
                               (facade-path (resolve (dirname path) (get file :id)))
                               (part (relative (dirname path) facade-path)))
                          (when (or (not part) (= part "..") (js-call part :startsWith (+ ".." sep)) (isAbsolute part))
                            (throw (new globalThis.TypeError "mixed project facade escapes the output directory")))
                          (await (mkdir (dirname facade-path) (js-object :recursive t)))
                          (await (writeFile facade-path (get file :source))))
                        (setq f-idx (1+ f-idx)))
                      (setq project
                        (js-object :entry (get facades :entry) :registry (get facades :registry)
                          :loadEntry (get facades :loadEntry)
                          :files (js-call files :map (lambda (file) (get file :id)))))))
                  (let* ((reserved-base (js-array (basename path) (+ (basename path) ".json") (+ (basename path) ".debug.json")))
                         (reserved (if project (js-call reserved-base :concat (get project :files)) reserved-base))
                         (host-sources (await (save-host-sources (dirname path) (cli-optional request "hostSources") reserved)))
                         (sidecar (js-object :target (get result :target))))
                    (when (= (get result :abi) "memory-u32")
                      (put sidecar :abi "memory-u32"))
                    (put sidecar :entry (cli-nullish (get result :entry) (cli-optional request "entry")))
                    (when (= (get result :target) "native")
                      (put sidecar :nativeTarget (cli-nullish (get result :nativeTarget) (cli-optional request "nativeTarget")))
                      (put sidecar :nativeFormat (cli-nullish (get result :nativeFormat) (cli-optional request "nativeFormat"))))
                    (put sidecar :descriptor (get result :descriptor))
                    (when (get result :typed)
                      (put sidecar :typed (get result :typed)))
                    (when has-debug
                      (put sidecar :debugPath (+ (basename path) ".debug.json")))
                    (when project
                      (put sidecar :project project))
                    (when (> (js-length host-sources) 0)
                      (put sidecar :hostSources host-sources))
                    (if owned
                      (progn
                        (await (write-owned-compiler-metadata (+ path ".json") sidecar))
                        (put result :typed undefined))
                      (await (writeCompilerMetadata (+ path ".json") sidecar))))))))))))

  (defasync run-command (args)
    (let* ((parsed (parseArgs (js-object :args args :allowPositionals t :strict t
                     :options (js-object
                       :help (js-object :type "boolean" :short "h")
                       :json-errors (js-object :type "boolean")
                       :seed (js-object :type "boolean")
                       :host (js-object :type "string")
                       :profile (js-object :type "string")
                       :output (js-object :type "string" :short "o")
                       :input (js-object :type "string" :short "i")
                       :project (js-object :type "string")
                       :root (js-object :type "string")
                       :host-modules (js-object :type "string")
                       :macro-capability (js-object :type "string" :multiple t)
                       :macro-dependency (js-object :type "string" :multiple t)
                       :target (js-object :type "string")
                       :request (js-object :type "string")
                       :runtime (js-object :type "string")
                       :compiler-artifact (js-object :type "string")
                       :compiler-artifacts (js-object :type "string" :multiple t)
                       :producer-artifact (js-object :type "string")
                       :native-target (js-object :type "string")
                       :native-format (js-object :type "string")
                       :source-map (js-object :type "boolean")
                       :debug (js-object :type "boolean")
                       :generations (js-object :type "string")
                       :hosts (js-object :type "string")))))
           (values (get parsed :values))
           (positionals (get parsed :positionals)))
      (if (get values :help)
        (js-call (get globalThis.process :stdout) :write help)
        (progn
          (unless (= (js-length positionals) 1)
            (throw (new globalThis.TypeError "provide exactly one compiler command")))
          (let ((cmd (aref positionals 0))
                (native-target (cli-nullish (get values :native-target)
                                 (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos")))
                (pos-int-re (new globalThis.RegExp "^[1-9][0-9]*$")))
            (cond
              ((or (= cmd "compiler-grid") (= cmd "matrix"))
               (unless (get values :output)
                 (throw (new globalThis.TypeError (+ cmd " requires --output"))))
               (let ((generations (if (undefined? (get values :generations))
                                    undefined
                                    (funcall globalThis.Number (get values :generations)))))
                 (when (and (not (undefined? generations))
                            (or (not (js-call pos-int-re :test (get values :generations)))
                                (not (Number/isSafeInteger generations))))
                   (throw (new globalThis.TypeError "--generations requires a positive safe integer")))
                 (let ((options (js-object :outputRoot (resolve (get values :output))
                                  :profile (cli-nullish (get values :profile) "small")
                                  :nativeTarget native-target)))
                   (when (get values :root)
                     (put options :sourceRoot (resolve (get values :root))))
                   (when (not (undefined? generations))
                     (put options :generations generations))
                   (when (get values :compiler-artifacts)
                     (put options :compilerArtifacts (js-array))
                     (let ((files (get values :compiler-artifacts)) (idx 0))
                       (while (< idx (js-length files))
                         (let* ((metadata-file (aref files idx))
                                (metadata-path (resolve metadata-file))
                                (artifact (await (readCompilerMetadata metadata-path))))
                           (js-call (get options :compilerArtifacts) :push
                             (Object/assign (js-object) artifact
                               (js-object :path (resolve (dirname metadata-path) (get artifact :path))
                                 :metadataPath metadata-path))))
                         (setq idx (1+ idx)))))
                   (let ((grid (await (bootstrapCompilerGrid options))))
                     (js-call (get globalThis.process :stdout) :write (+ (get grid :directory) "\n"))
                     (unless (= (get (get grid :metadata) :identityVerification) "identical")
                       (throw (new globalThis.Error "complete compiler grid has not established all same-target identities")))
                     (when (= cmd "matrix")
                       (let ((matrix (await (buildCompilerMatrix
                                       (Object/assign (js-object) options
                                         (js-object :compilerArtifacts (get grid :canonicalArtifacts)
                                           :compilerGrid (js-object :directory (get grid :directory)
                                                           :metadata (get grid :metadata))))))))
                         (js-call (get globalThis.process :stdout) :write (+ (get matrix :directory) "\n"))
                         (unless (= (get (get matrix :metadata) :verification) "equivalent")
                           (throw (new globalThis.Error "complete original compiler corpus matrix has not passed")))))))))
              ((or (= cmd "bootstrap") (= cmd "bootstrap-all"))
               (unless (get values :output)
                 (throw (new globalThis.TypeError (+ cmd " requires --output"))))
               (let ((generations (if (undefined? (get values :generations))
                                    undefined
                                    (funcall globalThis.Number (get values :generations)))))
                 (when (and (not (undefined? generations))
                            (or (not (js-call pos-int-re :test (get values :generations)))
                                (not (Number/isSafeInteger generations))))
                   (throw (new globalThis.TypeError "--generations requires a positive safe integer")))
                 (when (and (= cmd "bootstrap-all") (not (undefined? (get values :hosts))))
                   (throw (new globalThis.TypeError "bootstrap-all uses all three hosts")))
                 (let ((options (js-object :outputRoot (resolve (get values :output))
                                  :profile (cli-nullish (get values :profile) "small")
                                  :nativeTarget native-target)))
                   (when (get values :root)
                     (put options :sourceRoot (resolve (get values :root))))
                   (when (not (undefined? generations))
                     (put options :generations generations))
                   (when (= cmd "bootstrap")
                     (if (not (undefined? (get values :hosts)))
                       (put options :hosts (js-call (get values :hosts) :split ","))
                       (put options :host (cli-nullish (get values :host) "wasm"))))
                   (let ((result (if (= cmd "bootstrap-all")
                                   (await (bootstrapIndependentCompilers options))
                                   (await (bootstrapCompilerChain options)))))
                     (js-call (get globalThis.process :stdout) :write (+ (get result :directory) "\n"))))))
              ((= cmd "package")
               (unless (and (get values :compiler-artifact) (get values :output))
                 (throw (new globalThis.TypeError "package requires --compiler-artifact and --output")))
               (let ((result (await (packageIndependentCompiler
                               (js-object :artifact (get values :compiler-artifact)
                                 :outputRoot (resolve (get values :output)))))))
                 (js-call (get globalThis.process :stdout) :write (+ (get result :manifestPath) "\n"))))
              ((= cmd "build")
               (unless (get values :output)
                 (throw (new globalThis.TypeError "build requires --output")))
               (when (eq (funcall globalThis.Boolean (get values :seed))
                         (funcall globalThis.Boolean (get values :producer-artifact)))
                 (throw (new globalThis.TypeError "build requires exactly one of --seed or --producer-artifact")))
               (let ((opened undefined) (failed false))
                 (try
                   (progn
                     (when (get values :producer-artifact)
                       (setq opened (await (open-compiler (get values :producer-artifact)))))
                     (let ((build-opts (js-object
                                         :host (cli-nullish (get values :host) "wasm")
                                         :outputRoot (resolve (get values :output))
                                         :profile (cli-nullish (get values :profile) "small")
                                         :session (cli-optional opened "session")
                                         :nativeTarget native-target)))
                       (when (get values :root)
                         (put build-opts :sourceRoot (resolve (get values :root))))
                       (when (not (undefined? (get values :debug)))
                         (put build-opts :debug (get values :debug)))
                       (let ((artifact (await (buildIndependentCompiler build-opts))))
                         (js-call (get globalThis.process :stdout) :write (+ (get artifact :metadataPath) "\n")))))
                   (catch error (setq failed t) (throw error))
                   (finally (await (close-compiler (cli-optional opened "session") failed))))))
              (t
               (unless (or (= cmd "compile") (= cmd "request"))
                 (throw (new globalThis.TypeError (+ "unknown compiler command: " cmd))))
               (unless (get values :compiler-artifact)
                 (throw (new globalThis.TypeError (+ cmd " requires --compiler-artifact"))))
               (let* ((opened (await (open-compiler (get values :compiler-artifact))))
                      (session (get opened :session))
                      (artifact (get opened :artifact))
                      (failed false))
                 (try
                   (let ((request undefined))
                     (if (= cmd "request")
                       (progn
                         (unless (get values :request)
                           (throw (new globalThis.TypeError "request requires --request")))
                         (setq request (JSON/parse (await (read-text (get values :request)))))
                         (when (and (js-call (js-array "project" "project-ir" "emit-ir") :includes (cli-optional request "operation"))
                                    (or (= (get request :target) "wasm") (= (get request :target) "native")))
                           (await (js-call session :request
                             (if (get values :runtime)
                               (js-object :operation "runtime" :source (await (read-text (get values :runtime)))
                                 :filename "bootstrap/runtime/memory.eli")
                               (js-object :operation "runtime"))))))
                       (progn
                         (when (eq (funcall globalThis.Boolean (get values :input))
                                   (funcall globalThis.Boolean (get values :project)))
                           (throw (new globalThis.TypeError "compile requires exactly one of --input or --project")))
                         (let ((target (if (= (get values :target) "js")
                                         "javascript"
                                         (cli-nullish (get values :target) "javascript"))))
                           (if (get values :project)
                             (progn
                               (unless (get values :root)
                                 (throw (new globalThis.TypeError "project compilation requires an explicit --root")))
                               (unless (get values :output)
                                 (throw (new globalThis.TypeError "project compilation requires --output")))
                               (let ((dependencies
                                       (js-call (cli-nullish (get values :macro-dependency) (js-array)) :map
                                         (lambda (value)
                                           (let ((equal (js-call value :indexOf "=")))
                                             (when (or (<= equal 0) (= equal (1- (js-length value))))
                                               (throw (new globalThis.TypeError "macro dependency must be SPECIFIER=ROOT_RELATIVE_FILE")))
                                             (js-object :specifier (js-call value :slice 0 equal)
                                               :path (js-call value :slice (1+ equal))))))))
                                 (setq request
                                   (await (loadCompilerProject
                                     (js-object :root (get values :root) :entry (get values :project) :target target
                                       :sourceMap (funcall globalThis.Boolean (get values :source-map))
                                       :debug (funcall globalThis.Boolean (get values :debug))
                                       :macroCapabilities (cli-nullish (get values :macro-capability) (js-array))
                                       :macroDependencies dependencies
                                       :memory (get artifact :memory)
                                       :nativeTarget native-target
                                       :nativeFormat (cli-nullish (get values :native-format) "library")))))
                                 (when (or (= target "wasm") (= target "native"))
                                   (put request :binaryEncoding "u16le-chunks")
                                   (await (js-call session :request
                                     (if (get values :runtime)
                                       (js-object :operation "runtime" :source (await (read-text (get values :runtime)))
                                         :filename "bootstrap/runtime/memory.eli")
                                       (js-object :operation "runtime")))))))
                             (progn
                               (when (or (get values :root)
                                         (and (get values :macro-capability) (> (js-length (get values :macro-capability)) 0))
                                         (and (get values :macro-dependency) (> (js-length (get values :macro-dependency)) 0)))
                                 (throw (new globalThis.TypeError "project root and macro file options require --project")))
                               (let ((source (await (read-text (get values :input))))
                                     (filename (if (= (get values :input) "-") "<stdin>" (get values :input))))
                                 (cond
                                   ((= target "javascript")
                                    (setq request (js-object :operation "compile" :source source :filename filename))
                                    (when (get values :source-map)
                                      (put request :sourceMap
                                        (js-object :generatedFile (cli-nullish (get values :output) "output.mjs")
                                          :sourceName filename))))
                                   ((or (= target "wasm") (= target "native"))
                                    (unless (get values :output)
                                      (throw (new globalThis.TypeError "binary compiler output requires --output")))
                                    (await (js-call session :request
                                      (if (get values :runtime)
                                        (js-object :operation "runtime" :source (await (read-text (get values :runtime)))
                                          :filename "bootstrap/runtime/memory.eli")
                                        (js-object :operation "runtime"))))
                                    (setq request
                                      (js-object :operation "project"
                                        :modules (js-array (js-object :id "entry.mjs" :source source :filename filename))
                                        :entry "entry.mjs"
                                        :target target
                                        :debug (funcall globalThis.Boolean (get values :debug))
                                        :memory (get artifact :memory)
                                        :nativeTarget native-target
                                        :nativeFormat (cli-nullish (get values :native-format) "library")
                                        :binaryEncoding "u16le-chunks")))
                                   (t (throw (new globalThis.TypeError (+ "unknown compiler output target: " target)))))))))))
                     (when (get values :host-modules)
                       (unless (js-call (js-array "project" "project-ir") :includes (cli-optional request "operation"))
                         (throw (new globalThis.TypeError "--host-modules requires a project request")))
                       (let ((declarations (JSON/parse (await (read-text (get values :host-modules))))))
                         (unless (Array/isArray declarations)
                           (throw (new globalThis.TypeError "host module declarations must be an array")))
                         (put request :hostModules declarations)))
                     (let ((response (if (= cmd "compile")
                                       (await (requestCompilerBuildProduct session request))
                                       (await (js-call session :request request)))))
                       (await (save-result response (get values :output) request))))
                   (catch error (setq failed t) (throw error))
                   (finally (await (close-compiler session failed))))))))))))

  (defun renderCompilerCLIError (error &optional options)
    (let ((json (and (not (nullish? options)) (get options :json))))
      (if json
        (JSON/stringify (js-object :format "eliscript-compiler-cli-error" :version 1 :error (compilerFailure error)))
        (if (and (not (nullish? error)) (= (value-type (get error :stack)) "string"))
          (get error :stack)
          (if (and (not (nil? error)) (= (value-type error) "object"))
            (JSON/stringify (compilerFailure error) nil 2)
            (str error))))))

  (defasync main (&rest rest)
    (let ((args (if (or (= (js-length rest) 0) (undefined? (aref rest 0)))
                  (js-call (get globalThis.process :argv) :slice 2)
                  (aref rest 0))))
      (try
        (await (run-command args))
        (catch error
          (unless (js-call args :includes "--json-errors")
            (throw error))
          (js-call (get globalThis.process :stderr) :write
            (+ (renderCompilerCLIError error (js-object :json t)) "\n"))
          (put globalThis.process :exitCode 1)))))

  (defconst runCompilerCLI main)

  (when (and (aref (get globalThis.process :argv) 1)
             (= (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath (cli-module-url))))
    (js-call (main) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write (+ (renderCompilerCLIError error) "\n"))
        (put globalThis.process :exitCode 1))))

  (export main runCompilerCLI renderCompilerCLIError))
