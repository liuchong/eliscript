(module tools.backends.compiler-corpus-identity-value-adapters-ground
  (import "node:path" posix resolve)
  (import "node:url" pathToFileURL)
  (import "../../dist/bootstrap/reader.mjs" read-string)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "./compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)

  (defconst originalIdentityValueSuites
    (Object/freeze (js-array
                     "tests/wasm-managed-host-identity.test.mjs"
                     "tests/managed-stdlib-value-json.test.mjs")))

  ;; Recipes transport the original programs and assertions. They do not execute
  ;; a fixture or use a JavaScript implementation in place of a selected compiler.
  (defun region (source begin end &rest __opt)
    (let* ((from (aref __opt 0))
           (from-idx (if (undefined? from) 0 from))
           (start (js-call source :indexOf begin from-idx))
           (finish (if (< start 0) -1 (js-call source :indexOf end (+ start (js-length begin))))))
      (when (or (< start 0) (< finish 0))
        (throw (new globalThis.TypeError (str "original identity/value source boundary changed: " begin))))
      (let ((code (js-call source :slice start finish)))
        (js-object
          :text code
          :start start
          :end finish
          :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
          :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 finish))
          :sha256 (js-call (js-call (createHash "sha256") :update code) :digest "hex")))))

  (defun proof (item)
    (js-object
      :start (get item :start)
      :end (get item :end)
      :byteStart (get item :byteStart)
      :byteEnd (get item :byteEnd)
      :sha256 (get item :sha256)))

  (defun source-region (source start end)
    (let ((text (js-call source :slice start end)))
      (js-object
        :text text
        :start start
        :end end
        :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
        :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 end))
        :sha256 (js-call (js-call (createHash "sha256") :update text) :digest "hex"))))

  (defun originalIdentityValueCaseLocators (file source)
    (unless (js-call originalIdentityValueSuites :includes file)
      (throw (new globalThis.TypeError "unregistered original identity/value source suite")))
    (let ((cases (originalSourceCaseLocators file source)))
      (if (/= file "tests/wasm-managed-host-identity.test.mjs")
        cases
        (let* ((title "Given linked modules with opposite encounter orders when imported aliases and closures are called then defining-module identity tables remain separate")
               (owners (js-call cases :filter (lambda (locator) (= (get (get locator :originalCase) :title) title)))))
          (unless (= (js-length owners) 1)
            (throw (new globalThis.TypeError "original module-order helper lost its unique registered caller")))
          (let* ((owner (aref owners 0))
                 (helper (region source "async function get_project() {" "\nfunction check_encounters("))
                 (needle "[\"emit_managed_project_wasm\"](rev_modules, \"main.mjs\"")
                 (call-index (js-call source :indexOf needle (get helper :start)))
                 (start (if (< call-index 0) -1 (js-call source :lastIndexOf "(assert)[\"deepEqual\"]" call-index)))
                 (end (if (< start 0) -1 (js-call source :indexOf ";" call-index)))
                 (assertion (if (< end 0) "" (js-call source :slice start (1+ end)))))
            (when (or (= (js-length assertion) 0) (< start (get helper :start)) (> (+ start (js-length assertion)) (get helper :end)))
              (throw (new globalThis.TypeError "original project module-order assertion left its helper")))
            (let* ((executed (source-region source start (+ start (js-length assertion))))
                   (caller (source-region source
                             (get (get (get owner :originalCase) :span) :start)
                             (get (get (get owner :originalCase) :span) :end)))
                   (invocation "})(await (get_project()));")
                   (call-start (js-call (get caller :text) :indexOf invocation)))
              (when (< call-start 0)
                (throw (new globalThis.TypeError "original registered case no longer invokes its module-order helper")))
              (let ((call (source-region source (+ (get caller :start) call-start)
                            (+ (get caller :start) call-start (js-length invocation)))))
                (js-call cases :concat
                  (js-array
                    (js-object
                      :id (str "stable-compatibility:source-region:" file ":project-module-order:0")
                      :file file
                      :kind "test"
                      :contains (get executed :text)
                      :originalCase (globalThis.structuredClone (get owner :originalCase))
                      :originalExecution
                        (js-object
                          :record "original-identity-value:host-token-module-order"
                          :span (js-object :start (get executed :start) :end (get executed :end))
                          :byteStart (get executed :byteStart)
                          :byteEnd (get executed :byteEnd)
                          :sha256 (get executed :sha256)
                          :helper (Object/assign (js-object :name "get_project") (proof helper))
                          :invocation (proof call))))))))))))

  (defun original-titles (source file)
    ;; Use the same complete source inventory as the full-suite replay. Auxiliary
    ;; helper execution regions are provenance, not additional test registrations.
    (js-call
      (js-call (originalIdentityValueCaseLocators file source)
        :filter (lambda (locator) (not (get locator :originalExecution))))
      :map (lambda (locator) (get (get locator :originalCase) :title))))

  (defasync source-graph (options entry filename)
    (let ((text (get options :text))
          (file (get options :file))
          (modules (new globalThis.Map))
          (pending (js-array (js-object :id entry :filename filename)))
          (import-re (new globalThis.RegExp "\\(import(?:-portable)?\\s+\"([^\"\\n]+)\"" "g")))
      (while (> (js-length pending) 0)
        (let ((input (js-call pending :shift)))
          (unless (js-call modules :has (get input :id))
            (let ((source (await (funcall text (get input :filename)))))
              (await (funcall file (get input :filename)))
              (js-call modules :set (get input :id) (Object/assign (js-object) input (js-object :source source)))
              (let ((matches (Array/from (js-call source :matchAll import-re)))
                    (i 0))
                (while (< i (js-length matches))
                  (let* ((match (aref matches i))
                         (specifier (aref match 1)))
                    (unless (js-call specifier :startsWith ".")
                      (throw (new globalThis.TypeError "original Value/JSON graph gained an undeclared external dependency")))
                    (let ((path (js-call posix :normalize (js-call posix :join (js-call posix :dirname (get input :id)) specifier))))
                      (unless (js-call path :startsWith "stdlib/")
                        (throw (new globalThis.TypeError "original Value/JSON dependency escapes the stdlib graph")))
                      (let ((id (if (js-call path :endsWith ".eli") (str (js-call path :slice 0 -4) ".mjs") path)))
                        (js-call pending :push
                          (js-object
                            :id id
                            :filename (if (js-call path :endsWith ".mjs") (str (js-call path :slice 0 -4) ".eli") path))))))
                  (setq i (1+ i))))))))
      (Array/from (js-call modules :values))))

  (defun source-node-text (source node)
    (let ((points (Array/from source)) (span (get node :span)))
      (js-call (js-call points :slice (get span :start) (get span :end)) :join "")))

  (defun source-node-proof (source node)
    (let ((points (Array/from source)) (span (get node :span)))
      (source-region source
        (js-length (js-call (js-call points :slice 0 (get span :start)) :join ""))
        (js-length (js-call (js-call points :slice 0 (get span :end)) :join "")))))

  (defun source-head (node name)
    (let ((items (get node :items)))
      (and (Array/isArray items) (> (js-length items) 0) (= (get (aref items 0) :name) name))))

  (defasync maintained-helper (options suite names extra exports)
    (let* ((source-file (str (js-call suite :slice 0 -4) ".eli"))
           (source (await (funcall (get options :text) source-file)))
           (identity (await (funcall (get options :file) source-file)))
           (artifact (await (funcall (get options :text) suite)))
           (emitted (compile-string source source-file))
           (body (js-call artifact :replace
             (new globalThis.RegExp "\\n?//# sourceMappingURL=[^\\r\\n]*\\r?\\n?$") "\n"))
           (forms (read-string source source-file))
           (module (aref forms 0)) (items (get module :items))
           (selected (js-array)) (parts (js-array)) (regions (js-array)))
      (unless (and (= emitted body) (= (js-length forms) 1) (source-head module "module")
                   (= (get identity :sha256) (js-call (js-call (createHash "sha256") :update source) :digest "hex")))
        (throw (new globalThis.TypeError "original identity maintained source differs from its authenticated module")))
      (js-call names :forEach (lambda (entry)
        (let* ((name (if (= (value-type entry) "string") entry (get entry :name)))
               (matches (js-call items :filter (lambda (node)
          (and (or (source-head node "defun") (source-head node "defasync") (source-head node "defconst") (source-head node "defvar"))
               (= (get (aref (get node :items) 1) :name) name))))))
          (unless (= (js-length matches) 1)
            (throw (new globalThis.TypeError (str "original identity maintained helper changed: " name))))
          (let* ((node (aref matches 0)) (span (get node :span)) (points (Array/from source))
                 (start (js-length (js-call (js-call points :slice 0 (get span :start)) :join "")))
                 (end (js-length (js-call (js-call points :slice 0 (get span :end)) :join ""))))
            (js-call selected :push node)
            (js-call parts :push (if (= (value-type entry) "string") (source-node-text source node) (get entry :replacement)))
            (js-call regions :push (source-region source start end))))))
      (let* ((eli (str "(module original.identity.helpers\n(import \"node:assert/strict\" :default assert)\n"
                      (js-call parts :join "\n") "\n" extra "\n(export " (js-call exports :join " ") ")\n)"))
             (javascript (compile-string eli "original-identity-helpers.eli"))
             (source-root (get options :sourceRoot)))
        (setq javascript (js-call javascript :replace
          (new globalThis.RegExp "([\"'])eliscript/(runtime/[^\"']+)\\1" "g")
          (lambda (whole quote path)
            (JSON/stringify (get (pathToFileURL (resolve source-root path)) :href)))))
        (js-object :javascript javascript
          :maintainedSource (js-object :sourceFile source-file :sourceSha256 (get identity :sha256) :sourceRegions regions)
          :sourceAssets (js-array (js-object :file source-file :sourceSha256 (get identity :sha256)))
          :helpersSha256 (js-call (js-call (createHash "sha256") :update javascript) :digest "hex")))))

  (defun helper-module-url (source)
    ;; Both Node and Bun interpret this URL as an ES module. Percent-encoded
    ;; data URLs are treated as a text module by Bun's loader.
    (str "data:text/javascript;base64," (js-call (Buffer/from source "utf8") :toString "base64")))

  (defun helper-transport (helper bindings)
    (str "const {" bindings "}=await import(" (JSON/stringify (helper-module-url (get helper :javascript))) ");\n"))

  (defasync identity-contract-helper (options suite)
    (let* ((source-file (str (js-call suite :slice 0 -4) ".eli"))
           (source (await (funcall (get options :text) source-file)))
           (module (aref (read-string source source-file) 0))
           (tests (js-call (get module :items) :filter (lambda (node)
             (and (source-head node "test")
                  (= (get (aref (get node :items) 1) :value)
                     "Given scalar inputs when host identity is requested then original TypeError messages and later calls recover")))))
           (opening "(instantiateManagedRuntime (artifact) options)"))
      (unless (= (js-length tests) 1)
        (throw (new globalThis.TypeError "original identity scalar registration changed")))
      (let* ((callback (aref (get (aref tests 0) :items) 2))
             (body (source-node-text source callback)))
        (unless (and (= (js-length (js-call body :split opening)) 2) (source-head callback "lambda"))
          (throw (new globalThis.TypeError "original identity scalar setup changed")))
        (let ((helper (await (maintained-helper options suite
          (js-array "js-typeof" "diag-code?" "read-val" "invoke-val" "finish-heap" "check-identities" "check-encounters" "check-heap-isolation")
          (str "(defun check-scalars (instance reference) (funcall " (js-call body :replace opening "instance") "))")
          (js-array "read-val" "invoke-val" "finish-heap" "check-identities" "check-encounters" "check-heap-isolation" "check-scalars")))))
          (js-call (get (get helper :maintainedSource) :sourceRegions) :push (source-node-proof source callback)) helper))))

  (defasync json-contract-helper (options suite)
    (let* ((filename (str (js-call suite :slice 0 -4) ".eli"))
           (source (await (funcall (get options :text) filename)))
           (forms (read-string source filename)) (pending (js-call forms :slice))
           (assertions (js-array)) (assertion-nodes (js-array)) (opaque nil))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :shift)) (items (get node :items)))
          (cond
            ((and (source-head node "js-call") (= (get (aref items 1) :name) "assert")
                  (js-call (source-node-text source node) :includes "expected"))
             (js-call assertions :push (source-node-text source node)) (js-call assertion-nodes :push node))
            ((and (source-head node "test")
                  (= (get (aref items 1) :value)
                     "Given an ordinary source function when existing own-property predicates and actual Value hash are used then opaque function semantics agree with JavaScript"))
             (setq opaque (aref items 2)))
            ((Array/isArray items) (Reflect/apply (get pending :push) pending items)))))
      (unless (and (> (js-length assertions) 0) opaque)
        (throw (new globalThis.TypeError "original Value/JSON assertions or opaque case changed")))
      (let* ((body (source-node-text source opaque))
             (opening "(instantiateManagedRuntime bytes options)")
             (helper-file "tests/helpers/managed-json-contract.mjs")
             (helper (await (funcall (get options :file) helper-file)))
             (helper-source (await (funcall (get options :file) "tests/helpers/managed-json-contract.eli")))
             (extra (str "(import " (JSON/stringify (get (pathToFileURL (resolve (get options :sourceRoot) helper-file)) :href))
                         " read value finish box checkAll)\n"
                         "(defun check-json-expected (expected) " (js-call assertions :join "\n") ")\n"
                         "(defun check-opaque (instance) (funcall " (js-call body :replace opening "instance") "))")))
        (unless (and (= (js-length (js-call body :split opening)) 2) (source-head opaque "lambda"))
          (throw (new globalThis.TypeError "original Value/JSON opaque setup changed")))
        (let ((compiled (await (maintained-helper options suite (js-array) extra (js-array "check-json-expected" "check-opaque")))))
          (js-call assertion-nodes :forEach (lambda (node)
            (js-call (get (get compiled :maintainedSource) :sourceRegions) :push (source-node-proof source node))))
          (js-call (get (get compiled :maintainedSource) :sourceRegions) :push (source-node-proof source opaque))
          (put compiled :sourceAssets (js-call (get compiled :sourceAssets) :concat
            (js-array (js-object :file helper-file :sourceSha256 (get helper :sha256))
              (js-object :file "tests/helpers/managed-json-contract.eli" :sourceSha256 (get helper-source :sha256)))))
          compiled))))

  (defun identity-host-prelude (source-root)
    (str "\nimport assert from 'node:assert/strict';\nimport {readFile} from 'node:fs/promises';\n"
      "import {resolve} from 'node:path';\nimport {pathToFileURL} from 'node:url';\nimport {spawnSync} from 'node:child_process';\n"
      "import {openOriginalIdentityRuntime} from "
      (JSON/stringify (get (pathToFileURL (resolve source-root "tools/backends/compiler-corpus-identity-runtime.mjs")) :href)) ";\n"
      "const identity = await openOriginalIdentityRuntime();\n"
      "const {root,referenceDirectory,product,entry,originalEntry,reference,m,configuration,selected,binary,observe,freshRuntime,plain} = identity;\n"))

  (defun identity-scenario-call (options name arguments)
    (str "import {" name " as runIdentityScenario} from "
      (JSON/stringify (get (pathToFileURL (resolve (get options :sourceRoot)
        "tools/backends/compiler-corpus-identity-scenarios.mjs")) :href))
      ";\nawait runIdentityScenario(" arguments ");\n"))

  (defasync identity-runtime-assets (file)
    (let ((paths (js-array "tools/backends/eliscript/compiler-corpus-identity-runtime.eli"
                   "tools/backends/compiler-corpus-identity-runtime.mjs"
                   "tools/backends/eliscript/compiler-corpus-identity-observer.eli"
                   "tools/backends/compiler-corpus-identity-observer.mjs"
                   "tools/backends/eliscript/compiler-corpus-identity-scenarios.eli"
                   "tools/backends/compiler-corpus-identity-scenarios.mjs"
                   "tests/helpers/managed-stdlib-corpus.eli" "tests/helpers/managed-stdlib-corpus.mjs"
                   "tools/backends/compiler-host-record.eli" "tools/backends/compiler-host-record.mjs"
                   "tools/backends/compiler-host-iteration.eli" "tools/backends/compiler-host-iteration.mjs"))
          (assets (js-array)) (index 0))
      (while (< index (js-length paths))
        (let* ((filename (aref paths index)) (identity (await (funcall file filename))))
          (unless (and (= (get identity :file) filename) (= (value-type (get identity :sha256)) "string"))
            (throw (new globalThis.TypeError "identity/value runtime source binding changed")))
          (js-call assets :push (js-object :file filename :sourceSha256 (get identity :sha256))))
        (setq index (1+ index))) assets))

  (defun merge-runtime-assets (original extra)
    (let ((result (if (Array/isArray original) (js-call original :slice) (js-array))) (index 0))
      (while (< index (js-length extra))
        (let* ((asset (aref extra index)) (existing (js-call result :find (lambda (item) (= (get item :file) (get asset :file))))))
          (if (undefined? existing) (js-call result :push asset)
            (unless (= (get existing :sourceSha256) (get asset :sourceSha256))
              (throw (new globalThis.TypeError "identity/value runtime source binding changed")))))
        (setq index (1+ index))) result))

  (defasync addOriginalIdentityValueAdapters (options)
    (let* ((add (get options :add))
           (locators (get options :locators))
           (text (get options :text))
           (file (get options :file))
           (stable-files (get options :stableFiles))
           (host-prelude (identity-host-prelude (get options :sourceRoot)))
           (runtime-assets (await (identity-runtime-assets file)))
           (add-program
             (async (plan)
               (let* ((suite-identity (await (funcall file (get plan :suite))))
                      (fixture-cov (if (and (get plan :fixture) (js-call stable-files :has (get plan :fixture)))
                                     (js-array (str "stable-compatibility:" (get plan :fixture)))
                                     (js-array)))
                      (locator-cov
                        (js-call
                          (js-call locators :filter
                            (lambda (locator)
                              (and (= (get locator :file) (get plan :suite))
                                   (= (value-type (get locator :contains)) "string")
                                   (not (get locator :originalCase))
                                   (or (js-call (get plan :titles) :some
                                         (lambda (title) (js-call title :includes (get locator :contains))))
                                       (js-call (get plan :assertions) :includes (get locator :contains))))))
                          :map (lambda (locator) (get locator :id))))
                      (coverage (js-call fixture-cov :concat locator-cov))
                      (original-cases
                        (js-call
                          (js-call locators :filter
                            (lambda (locator)
                              (and (= (get locator :file) (get plan :suite))
                                   (get locator :originalCase)
                                   (not (get locator :originalExecution))
                                   (js-call (get plan :titles) :includes (get (get locator :originalCase) :title)))))
                          :map (lambda (locator)
                                 (Object/assign (js-object :id (get locator :id))
                                   (globalThis.structuredClone (get locator :originalCase)))))))
                 (when (= (js-length coverage) 0)
                   (throw (new globalThis.TypeError (str "original identity/value product has no executed source coverage: " (get plan :name)))))
                 (let ((autos (let ((v (get plan :autos))) (if (nullish? v) (js-array 1) v)))
                       (hosts (js-array "node" "bun"))
                       (a-idx 0))
                   (while (< a-idx (js-length autos))
                     (let ((auto (aref autos a-idx))
                           (h-idx 0))
                       (while (< h-idx (js-length hosts))
                         (let ((host-runtime (aref hosts h-idx))
                               (timeout (let ((v (get plan :timeout))) (if (nullish? v) 30000 v))))
                           (funcall add
                             (js-object
                               :id (str "original-identity-value:" (get plan :name) ":" host-runtime ":auto-" auto)
                               :kind "project"
                               :coverage (Array/from (new globalThis.Set coverage))
                               :modules (globalThis.structuredClone (get plan :modules))
                               :entry (get plan :entry)
                               :auto auto
                               :memory (globalThis.structuredClone
                                         (let ((v (get plan :memory)))
                                           (if (nullish? v) (js-object :initialPages 1 :maximumPages 256) v)))
                               :request (js-object :operation "project" :resolveImports t :phased t :sourceMap t)
                               :execution
                                 (js-object
                                   :kind "original-program"
                                   :host (str "tests/__eliscript_identity_value_" (get plan :name) "_" host-runtime "_" auto ".mjs")
                                   :hostSource (str host-prelude "\n" (get plan :hostSource))
                                   :hostRuntime host-runtime
                                   :arguments (js-array (js-object :directory t) (js-object :literal (get plan :entry)))
                                   :aliases t
                                   :referenceArtifact t
                                   :zeroImports t
                                   :childProcesses "inherit-selected-artifact"
                                   :timeoutByTarget (js-object :javascript timeout :wasm timeout :native 120000)
                                   :runtimeOptions (Object/assign (js-object) (globalThis.structuredClone (get plan :budget)) (js-object :auto auto)))
                               :expected (js-object :kind "seed-program" :oracleRequired t)
                               :original
                                 (js-object
                                   :manifest "stable-compatibility"
                                   :suite (get plan :suite)
                                   :maintainedSource (get plan :maintainedSource)
                                   :sourceAssets (merge-runtime-assets (get plan :sourceAssets) runtime-assets)
                                   :helpersSha256 (get plan :helpersSha256)
                                   :fixture (let ((v (get plan :fixture))) (if (nullish? v) nil v))
                                   :host (get plan :suite)
                                   :sourceSha256 (get suite-identity :sha256)
                                   :originalAssertion (get plan :titles)
                                   :originalCases original-cases
                                   :completeOriginalCaseCoverage false
                                   :completeCases "the unchanged original suite runs with its selected compiler and original deadlines"
                                   :regions (js-call (let ((v (get plan :regions))) (if (nullish? v) (js-array) v)) :map proof)
                                   :graph (let ((v (get plan :graph))) (if (nullish? v) nil v))
                                   :targetSpecificAssertions
                                     (js-object
                                       :javascript "original source-level observations in the original Node/Bun host"
                                       :binary "original raw-handle assertions, unchanged per-heap capacity, GC and cleanup on the actual selected binary")))))
                         (setq h-idx (1+ h-idx))))
                     (setq a-idx (1+ a-idx)))))))
           (stdlib-fixture "tests/fixtures/managed-stdlib-value-json.eli")
           (stdlib-suite "tests/managed-stdlib-value-json.test.mjs"))
      (when (js-call stable-files :has stdlib-fixture)
        (let* ((original (await (funcall text stdlib-suite)))
               (helper "tests/helpers/managed-stdlib-corpus.mjs")
               (_ (await (funcall file helper)))
               (contract (await (json-contract-helper options stdlib-suite)))
               (contract-url (get (pathToFileURL (resolve (get options :sourceRoot) "tests/helpers/managed-json-contract.mjs")) :href))
               (raw (region original "import {read, value, finish, box, checkAll}" ";"))
               (assertions (region original "    (assert)[\"deepEqual\"](((expected)[\"errors\"])[0]" "\n  })(new (globalThis.Set)()"))
               (modules (await (source-graph options "entry.mjs" stdlib-fixture)))
               (opaque-owner (js-call (originalSourceCaseLocators stdlib-suite original) :find
                 (lambda (locator) (= (get (get locator :originalCase) :title)
                   "Given an ordinary source function when existing own-property predicates and actual Value hash are used then opaque function semantics agree with JavaScript"))))
               (opaque (if opaque-owner
                 (source-region original (get (get (get opaque-owner :originalCase) :span) :start)
                   (get (get (get opaque-owner :originalCase) :span) :end))
                 (throw (new globalThis.TypeError "original Value/JSON opaque case changed"))))
               (corpus (str (helper-transport contract "check_json_expected:checkJSONExpected,check_opaque:checkOpaque")
                            (identity-scenario-call options "runOriginalValueJson" "identity,{checkJSONExpected,checkOpaque}"))))
          (await (funcall add-program
                   (js-object
                     :name "stdlib-value-json"
                     :maintainedSource (get contract :maintainedSource)
                     :sourceAssets (get contract :sourceAssets)
                     :helpersSha256 (get contract :helpersSha256)
                     :fixture stdlib-fixture
                     :suite stdlib-suite
                     :entry "entry.mjs"
                     :modules modules
                     :autos (js-array 65536 1)
                     :memory (js-object :initialPages 4 :maximumPages 1024)
                     :budget (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216)
                     :titles (original-titles original stdlib-suite)
                     :assertions (str (get raw :text) (get assertions :text) (get opaque :text))
                     :regions (js-array raw assertions opaque)
                     :hostSource corpus)))))
      (let ((identity-fixture "tests/fixtures/wasm-managed-host-identity.eli")
            (projects-fixture "tests/fixtures/managed-host-identity-projects.json"))
        (when (or (js-call stable-files :has identity-fixture)
                  (js-call stable-files :has projects-fixture))
          (let* ((suite "tests/wasm-managed-host-identity.test.mjs")
                 (original (await (funcall text suite)))
                 (data (JSON/parse (await (funcall text projects-fixture)))))
            (await (funcall file identity-fixture))
            (await (funcall file projects-fixture))
            (when (or (not data)
                      (js-call (Object/keys data) :some
                        (lambda (key) (not (js-call (js-array "project" "cycle" "cycleOperands") :includes key))))
                      (js-call (js-array "project" "cycle" "cycleOperands") :some
                        (lambda (key)
                          (let ((v (get data key)))
                            (or (not v) (/= (value-type v) "object") (Array/isArray v))))))
              (throw (new globalThis.TypeError "original identity project fixture shape changed")))
            (let* ((helpers (region original "function read_val(a, v) {" "\ntest(\"Given the existing intrinsic"))
                   (helper-program (await (identity-contract-helper options suite)))
                   (helper-code (helper-transport helper-program "read_val:read,invoke_val:value,finish_heap:finish,check_identities:identities,check_encounters:encounters,check_heap_isolation:heapIsolation,check_scalars:checkScalars"))
                   (encounters (region original "function check_encounters(a, p) {" "\ntest(\"Given linked modules"))
                   (isolation (region original "function check_heap_isolation(first_inst, second_inst) {" "\ntest(\"Given two heaps"))
                   (budget (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 16777216))
                   (titles-in-source (original-titles original suite))
                   (native-title (js-call titles-in-source :find
                                   (lambda (title) (js-call title :includes "true native module and linked project"))))
                   (entry "main.mjs")
                   (single (js-array (js-object :id entry :filename "host-identity.eli" :source (await (funcall text identity-fixture)))))
                   (single-filter-re (new globalThis.RegExp "wrong source|no intrinsic|linked modules with|cyclic|Node calls imported aliases"))
                   (single-titles (js-call titles-in-source :filter
                                    (lambda (title) (not (js-call single-filter-re :test title)))))
                   (scalar-title "Given scalar inputs when host identity is requested then original TypeError messages and later calls recover")
                   (scalar-owner (js-call (originalSourceCaseLocators suite original) :find
                     (lambda (locator) (= (get (get locator :originalCase) :title) scalar-title))))
                   (scalar (if scalar-owner
                     (source-region original (get (get (get scalar-owner :originalCase) :span) :start)
                       (get (get (get scalar-owner :originalCase) :span) :end))
                     (throw (new globalThis.TypeError "original identity scalar registration changed")))))
              (let* (
(code (str helper-code
                      (identity-scenario-call options "runOriginalHostTokenSingle"
                        "identity,{read,value,finish,identities,encounters,heapIsolation,checkScalars}"))))
                (await (funcall add-program
                         (js-object
                           :name "host-token-single"
                           :maintainedSource (get helper-program :maintainedSource)
                           :sourceAssets (get helper-program :sourceAssets)
                           :helpersSha256 (get helper-program :helpersSha256)
                           :suite suite
                           :fixture identity-fixture
                           :entry entry
                           :modules single
                           :budget budget
                           :titles single-titles
                           :assertions (str (get helpers :text) (get isolation :text) (get scalar :text))
                           :regions (js-array helpers isolation scalar)
                           :hostSource code))))
              (let ((data-entries (Object/entries data))
                    (d-idx 0)
                    (mod-id-re (new globalThis.RegExp "^[a-z][a-z0-9-]*\\.mjs$"))
                    (proj-title-re (new globalThis.RegExp "linked modules with|Node calls imported aliases")))
                (while (< d-idx (js-length data-entries))
                  (let* ((pair (aref data-entries d-idx))
                         (name (aref pair 0))
                         (sources (aref pair 1))
                         (modules
                           (js-call (Object/entries sources) :map
                             (lambda (s-pair)
                               (let ((id (aref s-pair 0))
                                     (source (aref s-pair 1)))
                                 (when (or (/= (value-type source) "string")
                                           (not (js-call mod-id-re :test id)))
                                   (throw (new globalThis.TypeError "original identity module declaration changed")))
                                 (js-object :id id :filename (str (js-call id :slice 0 -4) ".eli") :source source))))))
                    (unless (js-call modules :some (lambda (item) (= (get item :id) entry)))
                      (throw (new globalThis.TypeError "original identity graph lost its entry")))
                    (let ((host-source undefined)
                          (titles undefined))
                      (if (= name "project")
                        (progn
                          (setq host-source (str helper-code
                            (identity-scenario-call options "runOriginalHostTokenProject" "identity,{encounters}")))
                          (setq titles (js-call titles-in-source :filter (lambda (title) (js-call proj-title-re :test title))))
                          (when native-title
                            (js-call titles :push native-title)))
                        (progn
                          (setq host-source (str helper-code
                            (identity-scenario-call options "runOriginalHostTokenCycle"
                              (str "identity,{read,finish}," (JSON/stringify name)))))
                          (setq titles
                            (js-call titles-in-source :filter
                              (lambda (title)
                                (js-call title :includes
                                  (if (= name "cycle") "cyclic modules before" "cyclic early helper call")))))))
                      (let ((case-regions
                              (js-call
                                (js-call locators :filter
                                  (lambda (locator)
                                    (and (= (get locator :file) suite)
                                         (get locator :originalCase)
                                         (not (get locator :originalExecution))
                                         (js-call titles :includes (get (get locator :originalCase) :title)))))
                                :map (lambda (locator)
                                       (source-region original
                                         (get (get (get locator :originalCase) :span) :start)
                                         (get (get (get locator :originalCase) :span) :end))))))
                        (await (funcall add-program
                                 (js-object
                                   :name (str "host-token-" name)
                                   :maintainedSource (get helper-program :maintainedSource)
                                   :sourceAssets (get helper-program :sourceAssets)
                                   :helpersSha256 (get helper-program :helpersSha256)
                                   :suite suite
                                   :fixture projects-fixture
                                   :graph name
                                   :entry entry
                                   :modules modules
                                   :budget budget
                                   :titles titles
                                   :assertions (str (get helpers :text) (if (= name "project") (get encounters :text) "")
                                     (js-call (js-call case-regions :map (lambda (item) (get item :text))) :join "\n"))
                                   :regions (if (= name "project")
                                              (js-array helpers encounters)
                                              (js-call (js-array helpers) :concat case-regions))
                                   :hostSource host-source)))
                        (when (= name "project")
                          (let ((order (js-call locators :filter
                                         (lambda (locator)
                                           (and (= (get locator :file) suite)
                                                (get locator :originalExecution)
                                                (= (get (get locator :originalExecution) :record)
                                                   "original-identity-value:host-token-module-order"))))))
                            (unless (= (js-length order) 1)
                              (throw (new globalThis.TypeError "original module-order recipe requires its exact helper assertion")))
                            (let ((bound (js-call order :map (lambda (locator) (get locator :id)))))
                              (funcall add
                                (js-object
                                  :id "original-identity-value:host-token-module-order"
                                  :kind "sequence"
                                  :coverage bound
                                  :memory (js-object :initialPages 1 :maximumPages 256)
                                  :expected (js-object :kind "sequence")
                                  :steps (js-array
                                           (js-object
                                             :id "original-order"
                                             :request (js-object :operation "project" :entry entry
                                                        :modules (globalThis.structuredClone modules) :resolveImports t))
                                           (js-object
                                             :id "reversed-order"
                                             :request (js-object :operation "project" :entry entry
                                                        :modules (globalThis.structuredClone (js-call (js-call modules :slice) :reverse))
                                                        :resolveImports t)
                                             :sameProductAs "original-order"))
                                  :original
                                    (js-object
                                      :manifest "stable-compatibility"
                                      :suite suite
                                      :fixture projects-fixture
                                      :graph name
                                      :sourceSha256 (get (await (funcall file suite)) :sha256)
                                      :originalAssertion "project module order does not change emitted bytes"
                                      :originalCase (globalThis.structuredClone (get (aref order 0) :originalCase))
                                      :originalExecution (globalThis.structuredClone (get (aref order 0) :originalExecution)))))))))))
                  (setq d-idx (1+ d-idx))))
              (let* ((arity-title (js-call titles-in-source :find (lambda (title) (js-call title :includes "wrong source and IR arity"))))
                     (plain-title (js-call titles-in-source :find (lambda (title) (js-call title :includes "no intrinsic"))))
                     (coverage
                       (js-call
                         (js-call locators :filter
                           (lambda (locator)
                             (and (= (get locator :file) suite)
                                  (= (value-type (get locator :contains)) "string")
                                  (js-call (js-array arity-title plain-title) :some
                                    (lambda (title) (and (not (nullish? title)) (js-call title :includes (get locator :contains))))))))
                         :map (lambda (locator) (get locator :id)))))
                (when (= (js-length coverage) 0)
                  (throw (new globalThis.TypeError "original identity rejection recipe has no registered source cases")))
                (let* ((valid "(defun token (x) (host-identity-token x))")
                       (identity "(defun identity (x) x) (export identity)")
                       (steps
                         (js-call
                           (js-call (js-array "(host-identity-token)" "(host-identity-token 1 2)") :map
                             (lambda (source index)
                               (js-object
                                 :id (str "source-arity-" index)
                                 :request (js-object :operation "compile" :source source :filename "arity.eli")
                                 :error (js-object))))
                           :concat
                           (js-array
                             (js-object
                               :id "valid-intrinsic-ir"
                               :request (js-object :operation "compile-ir" :source valid :filename "arity.eli")))
                           (js-call (js-array 0 2) :map
                             (lambda (count)
                               (js-object
                                 :id (str "ir-arity-" count)
                                 :request
                                   (js-object
                                     :operation "emit-ir"
                                     :target "wasm"
                                     :ir (js-object
                                           :$compilerCorpusJsonPatch
                                           (js-array
                                             (js-object :$compilerCorpusRef "valid-intrinsic-ir.ir")
                                             (js-array
                                               (Object/assign
                                                 (js-object :path (js-array "body" 0 "children" 1 "children"))
                                                 (if (= count 0)
                                                   (js-object :value (js-array))
                                                   (js-object :duplicateIndex 0)))))))
                                 :error (js-object :code "ELI-B0001"))))
                           (js-array
                             (js-object
                               :id "plain-ir"
                               :request (js-object :operation "compile-ir" :source identity :filename "plain.eli"))
                             (js-object
                               :id "plain-descriptor"
                               :request (js-object :operation "emit-ir" :target "wasm" :ir (js-object :$compilerCorpusRef "plain-ir.ir"))
                               :expectFields (js-array
                                               (js-object :path (js-array "descriptor" "abi") :value "managed-control-v1")
                                               (js-object :path (js-array "descriptor" "module") :value undefined)))
                             (js-object
                               :id "recovered-ir"
                               :request (js-object :operation "compile-ir" :source valid :filename "arity.eli")
                               :sameFieldsAs (js-object :step "valid-intrinsic-ir" :fields (js-array "ir")))))))
                  (funcall add
                    (js-object
                      :id "original-identity-value:host-token-rejections"
                      :kind "sequence"
                      :coverage coverage
                      :steps steps
                      :expected (js-object :kind "sequence")
                      :original
                        (js-object
                          :manifest "stable-compatibility"
                          :suite suite
                          :sourceSha256 (get (await (funcall file suite)) :sha256)
                          :originalAssertion (js-array arity-title plain-title)
                          :originalCases
                            (js-call
                              (js-call locators :filter
                                (lambda (locator)
                                  (and (js-call coverage :includes (get locator :id))
                                       (get locator :originalCase))))
                              :map (lambda (locator)
                                     (Object/assign (js-object :id (get locator :id))
                                       (globalThis.structuredClone (get locator :originalCase)))))
                          :fixture identity-fixture
                          :originalIRMutation "only host-identity-token operands are removed or duplicated")))))))))))

  (export originalIdentityValueSuites originalIdentityValueCaseLocators addOriginalIdentityValueAdapters maintained-helper helper-transport helper-module-url source-head source-node-text source-node-proof))
