(module tools.backends.compile
  (import "node:fs/promises" chmod mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./build.mjs" buildBackends)
  ;; Target validation, request preparation and emission are Eli. Node/Bun
  ;; filesystem and process operations remain explicit host adapters.
  (defconst module-url (js* "import.meta.url"))
  (defun host-truth (value) (js* "!!value"))
  (defun host-type (value) (js* "typeof value"))
  (defun host-get (value key) (if (nullish? value) undefined (get value key)))
  (defun decode-source (bytes)
    (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode bytes))
  (defasync run-module-entry ()
(let ((args (js-call (get globalThis.process :argv) :slice 2)))
(when (js-call args :includes "--help")
    (console/log "Usage: bun tools/backends/compile.mjs --abi numeric-f64 --target js|wasm|native -o OUTPUT INPUT\nManaged control: --abi managed-control-v1|managed-module-v1 --target wasm -o OUTPUT INPUT\nManaged project: --abi managed-module-v1 --target wasm --project -o OUTPUT REQUEST.json\nNative: --platform arm64-macos|arm64-linux --native-format object|library\nNative executable: --platform arm64-macos --native-format executable --entry FUNCTION")
    (js-call globalThis.process :exit 0))
(let ((abi undefined))
(let ((target undefined))
(let ((output undefined))
(let ((input undefined))
(let ((platform undefined))
(let ((nativeFormat undefined))
(let ((entry undefined))
(let ((project false))
(let ((buildDirectory undefined))
(try
    (let ((index 0))
      (while (< index (js-length args))
        (let ((argument (aref args index)))
          (cond
            ((eq argument "--project")
              (when project (throw (new globalThis.Error "duplicate --project"))) (setq project t))
            ((js-call (js-array "--abi" "--target" "-o" "--output" "--platform" "--native-format" "--entry") :includes argument)
              (setq index (1+ index))
              (let ((value (aref args index)))
                (unless (host-truth value) (throw (new globalThis.Error (str argument " requires a value"))))
                (cond ((eq argument "--abi") (setq abi value)) ((eq argument "--target") (setq target value))
                  ((eq argument "--platform") (setq platform value)) ((eq argument "--native-format") (setq nativeFormat value))
                  ((eq argument "--entry") (setq entry value)) (t (setq output value)))))
            ((or (js-call argument :startsWith "-") (host-truth input))
              (throw (new globalThis.Error (str "unexpected argument: " argument))))
            (t (setq input argument))))
        (setq index (1+ index))))
    (unless (and (js-call (js-array "numeric-f64" "managed-control-v1" "managed-module-v1") :includes abi)
                 (js-call (js-array "js" "wasm" "native") :includes target) (host-truth input) (host-truth output))
      (throw (new globalThis.Error "require --abi numeric-f64 --target js|wasm|native -o OUTPUT INPUT")))
    (when (and (not (eq abi "numeric-f64")) (not (eq target "wasm")))
      (throw (new globalThis.Error (str abi " currently requires --target wasm"))))
    (when (and project (or (not (eq abi "managed-module-v1")) (not (eq target "wasm"))))
      (throw (new globalThis.Error "managed projects require --abi managed-module-v1 --target wasm")))
    (if (eq target "native")
      (progn
        (when (or (not (js-call (js-array "arm64-macos" "arm64-linux") :includes platform))
                  (not (js-call (js-array "object" "library" "executable") :includes nativeFormat))
                  (if (eq nativeFormat "executable") (not (host-truth entry)) (not (undefined? entry))))
          (throw (new globalThis.Error "native requires --platform arm64-macos|arm64-linux --native-format object|library|executable; --entry is required only for executable")))
        (when (and (eq nativeFormat "executable") (not (eq platform "arm64-macos")))
          (throw (new globalThis.Error "native executable requires --platform arm64-macos"))))
      (when (or (not (undefined? platform)) (not (undefined? nativeFormat)) (not (undefined? entry)))
        (throw (new globalThis.Error "native options require --target native"))))
    ;; Each invocation owns its backend directory and always removes it below.
    (setq buildDirectory (await (mkdtemp (resolve (tmpdir) "eliscript-backend-cli-"))))
    (let* ((backends (await (buildBackends (js-object :outputRoot buildDirectory))))
           (compiler (get backends :compiler)) (numeric (get backends :numeric)) (wasm (get backends :wasm))
           (native (get backends :native)) (managed (get backends :managed)) (loadLiteralModules (get backends :loadLiteralModules))
           (filename (resolve input)) (source (decode-source (await (readFile filename))))
           (program (if project nil (js-call compiler :compile_ir_string source filename))) (bytes undefined))
      (if (not (eq abi "numeric-f64"))
        (let* ((runtimePath (fileURLToPath (new globalThis.URL "../../bootstrap/runtime/memory.eli" module-url)))
               (runtimeProgram (js-call compiler :compile_ir_string (decode-source (await (readFile runtimePath))) runtimePath))
               (literalModules (get (await (funcall loadLiteralModules)) :literalModules)))
          (if project
            (let ((request (JSON/parse source)))
              (when (or (not (host-truth request)) (not (eq (get request :mode) "project"))
                        (not (eq (host-type (get request :entry)) "string"))
                        (not (host-truth (get request :files))) (not (eq (host-type (get request :files)) "object"))
                        (Array/isArray (get request :files)))
                (throw (new globalThis.Error "managed project input requires mode project, entry and files")))
              (let ((modules (js-call (js-call (Object/keys (get request :files)) :sort) :map (lambda (id)
                      (unless (eq (host-type (get (get request :files) id)) "string")
                        (throw (new globalThis.Error "managed project sources must be strings")))
                      (js-object :id id :program (js-call compiler :compile_ir_string (get (get request :files) id) id))))))
                (setq bytes (Uint8Array/from (js-call managed :emit_managed_project_wasm modules (get request :entry) runtimeProgram
                                              (js-object :abi abi :literalModules literalModules))))))
            (setq bytes (Uint8Array/from (js-call managed :emit_managed_wasm program runtimeProgram (js-object :abi abi :literalModules literalModules))))))
        (progn
          ;; Lower and validate before target selection removes unsupported code.
          (js-call numeric :lower_numeric_program program)
          (setq bytes (cond
            ((eq target "wasm") (Uint8Array/from (js-call wasm :emit_numeric_wasm program)))
            ((eq target "native") (Uint8Array/from (cond
              ((eq nativeFormat "executable") (js-call native :emit_native_numeric_executable program platform entry))
              ((eq nativeFormat "library") (js-call native :emit_native_numeric_library program platform))
              (t (js-call native :emit_native_numeric_object program platform)))))
            (t (js-call numeric :emit_numeric_javascript program))))))
      (await (writeFile (resolve output) bytes))
      (when (and (eq target "native") (eq nativeFormat "executable")) (await (chmod (resolve output) 493))))
    (catch error
      (let* ((diagnostic (host-get error "eliscriptDiagnostic")) (location (host-get diagnostic "location")))
        (console/error (if (host-truth location)
          (str (get location :file) ":" (get (get location :start) :line) ":" (get (get location :start) :column) ": "
            (get diagnostic :code) ": " (get diagnostic :message))
          (let ((message (host-get error "message")))
            (if (nullish? message) (funcall globalThis.String error) message)))))
      (put globalThis.process :exitCode 1))
    (finally
      (when (host-truth buildDirectory) (await (rm buildDirectory (js-object :recursive t :force t))))))
)))))))))))
  (js-call (run-module-entry) :catch (lambda (error)
    (js-call (get (js* "globalThis") :console) :error error)
    (put (get (js* "globalThis") :process) :exitCode 1)))
)
