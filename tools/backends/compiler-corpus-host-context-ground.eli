(module tools.backends.compiler-corpus-host-context-ground
  (import "node:fs/promises" readFile writeFile copyFile chmod)
  (import "node:fs" constants)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "./compiler-metadata.mjs" readCompilerMetadata)
  (import "./managed-runtime.mjs"
    createManagedModuleGraph
    createManagedProjectFacades
    instantiateManagedRuntimeWithHostModules)
  (import "./native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  (defconst own-url (js* "import.meta.url"))
  (defconst contexts (new globalThis.Map))
  (defconst environmentKey "ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT")

  ;; This installs an already emitted program. No source is compiled here, and a
  ;; native context continues through the native loader in every host process.
  (defasync openOriginalProgramContext (input &optional options)
    (let* ((identity (if (nullish? options) undefined (get options :identity)))
           (key (if (undefined? identity) undefined (resolve identity))))
      (if (and (not (undefined? key)) (js-call contexts :has key))
        (await (js-call contexts :get key))
        (let ((pending
                (funcall
                  (async ()
                    (when (or (not input)
                              (not (js-call (js-array "wasm" "native") :includes (get input :target)))
                              (/= (value-type (get input :path)) "string")
                              (/= (value-type (get input :base)) "string")
                              (/= (value-type (get input :entry)) "string")
                              (nullish? (get input :descriptor))
                              (nullish? (get (get input :descriptor) :project)))
                      (throw (new globalThis.TypeError "original program context requires the selected phased binary artifact")))
                    (let* ((graph (createManagedModuleGraph (get input :descriptor)))
                           (facades (createManagedProjectFacades (get input :descriptor)
                                      (js-object :entry (get input :entry))))
                           (runtime undefined)
                           (closed false)
                           (close
                             (async ()
                               (unless closed
                                 (setq closed t)
                                 (let ((failure undefined)
                                       (actions (js-array
                                                  (lambda () (when runtime (js-call runtime :closeModule)))
                                                  (lambda () (when runtime (js-call runtime :collect)))
                                                  (lambda ()
                                                    (when (and runtime (/= (js-call runtime :live) 0))
                                                      (throw (new globalThis.Error "original program retained managed values after module close"))))
                                                  (lambda ()
                                                    (when (and runtime (/= (get (js-call runtime :stats) :frameDepth) 0))
                                                      (throw (new globalThis.Error "original program retained managed frames after module close"))))
                                                  (lambda ()
                                                    (when (and runtime (= (value-type (get runtime :close)) "function"))
                                                      (js-call runtime :close)))
                                                  (lambda () (js-call graph :close))))
                                       (i 0))
                                   (while (< i (js-length actions))
                                     (try
                                       (await (funcall (aref actions i)))
                                       (catch error
                                         (when (undefined? failure)
                                           (setq failure error))))
                                     (setq i (1+ i)))
                                   (unless (undefined? key)
                                     (js-call contexts :delete key))
                                   (unless (undefined? failure)
                                     (throw failure)))))))
                      (try
                        (let ((rt-options
                                (Object/assign (js-object)
                                  (get input :memory)
                                  (get input :runtimeOptions)
                                  (js-object
                                    :moduleGraph graph
                                    :initializeModule false
                                    :projectEntry (get input :entry)
                                    :projectModuleBaseURL (get input :base)
                                    :moduleBaseURL (get (pathToFileURL (get input :path)) :href)
                                    :nativeTarget (get input :nativeTarget)))))
                          (if (= (get input :target) "wasm")
                            (setq runtime
                              (await (instantiateManagedRuntimeWithHostModules
                                       (new globalThis.Uint8Array (await (readFile (get input :path))))
                                       rt-options)))
                            (setq runtime
                              (await (instantiateNativeManagedRuntime
                                       (get input :path)
                                       (js-object :typed (get input :typed) :descriptor (get input :descriptor))
                                       rt-options))))
                          (when (and (not (nullish? (get input :runtimeOptions)))
                                     (not (undefined? (get (get input :runtimeOptions) :auto))))
                            (js-call runtime :auto (get (get input :runtimeOptions) :auto)))
                          (js-call (js-call graph :attachRuntime runtime) :prepare)
                          (let ((registry (await (js-call (js* "(u => import(u))") :call nil
                                                   (new globalThis.URL (get facades :registry) (get input :base))))))
                            (js-call registry :install graph))
                          (Object/freeze (js-object :graph graph :runtime runtime :facades facades :close close)))
                        (catch error
                          (try (await (funcall close)) (catch _ nil))
                          (throw error))))))))
          (unless (undefined? key)
            (js-call contexts :set key pending))
          (try
            (await pending)
            (catch error
              (when (and (not (undefined? key)) (eq (js-call contexts :get key) pending))
                (js-call contexts :delete key))
              (throw error)))))))

  ;; NODE_OPTIONS is inherited by the original suite's real Node subprocesses.
  ;; The parent host keeps its original executable and command arguments. Each
  ;; child installs fresh VM cells for the same product before its original code.
  (defun inheritOriginalProgramContext (options)
    (let ((configuration (get options :configuration))
          (source-root (get options :sourceRoot)))
      (when (or (/= (value-type configuration) "string")
                (/= (value-type source-root) "string"))
        (throw (new globalThis.TypeError "original child context requires its actual configuration and source root")))
      (let* ((env (get globalThis.process :env))
             (option (str "--import=" own-url))
             (previous (let ((v (get env :NODE_OPTIONS))) (if (nullish? v) "" v))))
        (put env :NODE_OPTIONS
          (if (js-call (js-call previous :split (new globalThis.RegExp "\\s+")) :includes option)
            previous
            (str (if (= previous "") "" (str previous " ")) option)))
        (put env environmentKey (resolve configuration))
        (put env :ELISCRIPT_ORIGINAL_SOURCE_ROOT (resolve source-root)))))

  ;; Shell entry points accept one runtime executable, rather than an executable
  ;; plus preload arguments. Keep the actual Bun host and add only the selected
  ;; artifact's initialization before its unchanged CLI program starts.
  (defasync originalProgramBunLauncher (options)
    (let ((directory (get options :directory))
          (bun (get options :bun))
          (configuration (get options :configuration))
          (source-root (get options :sourceRoot)))
      (when (js-call (js-array directory bun configuration source-root) :some
              (lambda (value) (or (/= (value-type value) "string") (= (js-length value) 0))))
        (throw (new globalThis.TypeError "original Bun launcher requires its selected artifact and executable")))
      (let* ((env (get globalThis.process :env))
             (option (str "--import=" own-url))
             (node-options
               (js-call
                 (js-call
                   (js-call (let ((v (get env :NODE_OPTIONS))) (if (nullish? v) "" v))
                     :split (new globalThis.RegExp "\\s+"))
                   :filter (lambda (value) (and (/= value "") (/= value option))))
                 :join " "))
             (path (resolve directory "__eliscript_original_bun"))
             (source (fileURLToPath (new globalThis.URL "./original-program-bun-launcher.el" own-url))))
        (await (writeFile (str path ".json")
                 (JSON/stringify
                   (js-object
                     :bun bun
                     :preload (fileURLToPath own-url)
                     :configuration (resolve configuration)
                     :sourceRoot (resolve source-root)
                     :nodeOptions node-options))
                 (js-object :flag "wx" :mode 384)))
        (await (copyFile source path (get constants :COPYFILE_EXCL)))
        (await (chmod path 448))
        path)))

  ;; This branch is reached only through the explicit original-program preload.
  ;; Importing the scheduler or defining an adapter never executes an artifact.
  (defasync initialize-inherited-context ()
    (let* ((env (get globalThis.process :env))
           (inherited (get env environmentKey)))
      (when inherited
        (let* ((input (await (readCompilerMetadata (resolve inherited))))
               (context (await (openOriginalProgramContext input (js-object :identity inherited)))))
          (put env :ELISCRIPT_ORIGINAL_TARGET (get input :target))
          (when (get input :sourceRoot)
            (put env :ELISCRIPT_ORIGINAL_SOURCE_ROOT (get input :sourceRoot)))
          (js-call globalThis.process :once "beforeExit"
            (lambda ()
              (js-call (js-call context :close) :catch
                (lambda (error)
                  (js-call (get globalThis.process :stderr) :write
                    (str (if (and (not (nullish? error)) (get error :stack))
                           (get error :stack)
                           (globalThis.String error))
                         "\n"))
                  (unless (get globalThis.process :exitCode)
                    (put globalThis.process :exitCode 1))))))))))

  (defconst inherited-completion (initialize-inherited-context))
  (js-call inherited-completion :catch (lambda (_) undefined))

  (export openOriginalProgramContext inheritOriginalProgramContext originalProgramBunLauncher))
