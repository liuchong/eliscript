                            ("tests/eliscript/compiler-browser-session-reference.eli" . "tests/helpers/compiler-browser-session-reference.mjs")
                            ("tests/eliscript/compiler-corpus-host-completion.eli" . "tests/compiler-corpus-host-completion-selfhosted.test.mjs")
                            ("tests/eliscript/managed-project-zero-imports.eli" . "tests/managed-project-zero-imports-selfhosted.test.mjs")
                            ("tests/eliscript/managed-protocol-dispatch.eli" . "tests/managed-protocol-dispatch-selfhosted.test.mjs")
                            ("tests/eliscript/compiler-corpus-matchers.eli" . "tests/compiler-corpus-matchers-selfhosted.test.mjs")
                            ("tests/eliscript/wasm-managed-language-intrinsics.eli" . "tests/wasm-managed-language-intrinsics.test.mjs")
                            ("tests/eliscript/managed-language-intrinsics-node.eli" . "tests/managed-language-intrinsics-node.mjs")
                            ("tests/eliscript/wasm-managed-apply.eli" . "tests/wasm-managed-apply.test.mjs")
                            ("tests/eliscript/managed-apply-node.eli" . "tests/helpers/managed-apply-node-selfhosted.mjs")
                            ("tests/eliscript/wasm-managed-numeric-shared.eli" . "tests/helpers/managed-numeric-selfhosted.mjs")
                            ("tests/eliscript/managed-numeric-node.eli" . "tests/helpers/managed-numeric-node.mjs")
                            ("tests/eliscript/wasm-managed-arithmetic.eli" . "tests/wasm-managed-arithmetic.test.mjs")
                            ("tests/eliscript/wasm-managed-word.eli" . "tests/wasm-managed-word.test.mjs")
                            ("tests/eliscript/wasm-managed-control.eli" . "tests/wasm-managed-control.test.mjs")
                            ("tests/eliscript/managed-control-node.eli" . "tests/helpers/managed-control-node-selfhosted.mjs")
                            ("tests/eliscript/wasm-managed-sequence-data.eli" . "tests/wasm-managed-sequence-data.test.mjs")
                            ("tests/eliscript/managed-sequence-data-host.eli" . "tests/helpers/managed-sequence-data-host-selfhosted.mjs")
                            ("tests/eliscript/managed-sequence-build.eli" . "tests/helpers/managed-sequence-build-selfhosted.mjs")
                            ("tests/eliscript/memory-allocator.eli" . "tests/wasm-memory-allocator.test.mjs")
                            ("tests/eliscript/managed-runtime-extended.eli" . "tests/managed-runtime-extended-selfhosted.test.mjs")
                            ("tests/eliscript/run-artifact.eli" . "tests/run-artifact-selfhosted.test.mjs")
                            ("tests/eliscript/record-grid.eli" . "tests/record-grid-selfhosted.test.mjs")
                            ("tests/eliscript/compiler-session-protocol.eli" . "tests/compiler-session-protocol-selfhosted.test.mjs")
                            ("tests/eliscript/literal-runtime.eli" . "tests/literal-runtime.test.mjs")
                            ("tests/eliscript/managed-literal-nth-node.eli" . "tests/helpers/managed-literal-nth-node-selfhosted.mjs")
                            ("tests/eliscript/compiler-corpus-source-archive.eli" . "tests/compiler-corpus-source-archive.test.mjs")
                            ("tests/eliscript/compiler-literal-corpus.eli" . "tests/compiler-literal-corpus-selfhosted.test.mjs")))))
    (when include-tests
      (setq tools (append tools
                          '(("tests/eliscript/compiler-corpus-exports.eli" . "tests/compiler-corpus-exports-selfhosted.test.mjs")
                            ("tests/eliscript/compiler-corpus-implicit-resources.eli" . "tests/compiler-corpus-implicit-resources-selfhosted.test.mjs")
                            ("tests/eliscript/compiler-corpus-tools-cli.eli" . "tests/compiler-corpus-tools-cli-selfhosted.test.mjs")
                            ("tests/eliscript/compiler-cli-corpus.eli" . "tests/compiler-cli-corpus-selfhosted.test.mjs")
                            ("tests/eliscript/compiler-core-project-corpus.eli" . "tests/compiler-core-project-corpus-selfhosted.test.mjs")))))
    (eliscript-backend-bootstrap-runtimes)
    (make-directory output t)
    (dolist (source (directory-files source-directory t "\\.eli\\'"))
      (eliscript-compile-file-with-source-map
       source (expand-file-name (concat (file-name-base source) ".mjs") output)))
    (setenv "ELISCRIPT_BOOTSTRAP_MODULE_DIR" output)
    (let ((failures nil))
      (dolist (tool tools)
        (make-directory (file-name-directory (expand-file-name (cdr tool) default-directory)) t)
        (with-temp-buffer
          (let ((status (call-process
                         runtime nil t nil "bootstrap/host/bun.mjs"
                         (car tool) "--output" (cdr tool))))
            (unless (and (integerp status) (zerop status))
              (push (format "Self-hosted tool bootstrap failed for %s (%s): %s"
                            (car tool) status (buffer-string))
                    failures))
            (when (and (integerp status) (zerop status)
                       (equal (cdr tool) "bootstrap/host/eliscript-cli.mjs"))
              (let ((entry (expand-file-name (cdr tool) default-directory))
                    (coding-system-for-write 'utf-8-unix))
                (with-temp-buffer
                  (insert-file-contents entry)
                  (goto-char (point-min))
                  (insert "#!/usr/bin/env node\n")
                  (write-region (point-min) (point-max) entry nil 'silent))
                (when (file-exists-p (concat entry ".map"))
                  (let* ((map-path (concat entry ".map"))
                         (map (json-parse-string (eliscript-backend-stage0-read map-path))))
                    (puthash "mappings" (concat ";" (gethash "mappings" map)) map)
                    (with-temp-file map-path (insert (json-serialize map)))))
                (set-file-modes entry #o755))))))
      (when failures
        (error "%s" (mapconcat #'identity (nreverse failures) "\n"))))))

(when noninteractive
  (condition-case error-data
      (let* ((include-tests (member "--tests" command-line-args-left))
             (stage0 (member "--stage0" command-line-args-left))
             (output-arguments (member "--output" command-line-args-left))
             (output (cadr output-arguments)))
        (when (and stage0 (or (null output) (string-prefix-p "--" output)))
          (error "--stage0 requires --output DIR"))
        (setq command-line-args-left (delete "--tests" (delete "--stage0" command-line-args-left)))
        (when output-arguments
          (setq command-line-args-left (delete output (delete "--output" command-line-args-left))))
        (when stage0 (eliscript-backend-bootstrap-stage0 output))
        (when (or (not stage0) include-tests) (eliscript-backend-bootstrap include-tests)))
    (error
     (message "eliscript: %s" (error-message-string error-data))
     (kill-emacs 1))))

(provide 'eliscript-backend-bootstrap)
