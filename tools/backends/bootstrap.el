                            ("tests/direct-wasm-backend-test-ground.eli" . "tests/direct-wasm-backend-test-ground.mjs")
                            ("tests/helpers/tools-artifact-contract.eli" . "tests/helpers/tools-artifact-contract.mjs")
                            ("tests/helpers/compiler-source-archive-bounded-host.eli" . "tests/helpers/compiler-source-archive-bounded-host.mjs")
                            ("tests/compiler-corpus-tools-artifact-adapters.test.eli" . "tests/compiler-corpus-tools-artifact-adapters.test.mjs")))))
    (eliscript-backend-bootstrap-runtimes)
    (make-directory output t)
    (dolist (source (directory-files source-directory t "\\.eli\\'"))
      (eliscript-compile-file-with-source-map
       source (expand-file-name (concat (file-name-base source) ".mjs") output)))
    (setenv "ELISCRIPT_BOOTSTRAP_MODULE_DIR" output)
    (eliscript-backend-reset-runtime-support)
    (let ((failures nil))
      (with-temp-buffer
        (let ((status (call-process
                       runtime nil t nil "bootstrap/host/project-cli.mjs"
                       "--root" "runtime"
                       "--out-dir" "dist/runtime"
                       "runtime/lisp.eli" "runtime/lisp/io-worker.eli")))
          (unless (and (integerp status) (zerop status))
            (push (format "Self-hosted lisp runtime build failed (%s): %s"
                          status (buffer-string))
                  failures))))
      ;; Keep the runtime prerequisites and the batch driver on the original
      ;; single-file path. Everything after that uses the same compileFile
      ;; entry, without restarting Node and reloading the compiler per module.
      (let ((pending tools)
            (driver "tools/testing/bootstrap-tools-driver.mjs")
            ready)
        (unless (assoc "tools/testing/bootstrap-tools-driver.eli" tools)
          (error "formal bootstrap is missing its maintained batch driver"))
        (while (and pending (not ready))
          (let* ((tool (pop pending))
                 (failure (eliscript-backend-compile-tool runtime tool)))
            (when failure (push failure failures))
            (when (equal (cdr tool) driver)
              (if failure
                  (progn
                    (push (format "%s remaining tools unexecuted: batch driver prerequisite failed"
                                  (length pending)) failures)
                    (setq pending nil))
                (setq ready t)))))
        (when pending
          (setq failures (append (eliscript-backend-compile-tool-batch runtime driver pending)
                                 failures))))
      (when failures
        (error "%s" (mapconcat #'identity (nreverse failures) "\n"))))))

(when noninteractive
  (condition-case error-data
      (let* ((include-tests (member "--tests" command-line-args-left))
             (stage0 (member "--stage0" command-line-args-left))
             (output-arguments (member "--output" command-line-args-left))
             (output (cadr output-arguments)))
        (when (and stage0 (or (null output) (string-prefix-p "--" output)))
          (error "--stage0 requires --output DIR"))
        (setq command-line-args-left (delete "--tests" (delete "--stage0" command-line-args-left)))
        (when output-arguments
          (setq command-line-args-left (delete output (delete "--output" command-line-args-left))))
        (when stage0 (eliscript-backend-bootstrap-stage0 output))
        (when (or (not stage0) include-tests) (eliscript-backend-bootstrap include-tests)))
    (error
     (message "eliscript: %s" (error-message-string error-data))
     (kill-emacs 1))))

(provide 'eliscript-backend-bootstrap)
;;; bootstrap.el ends here
