;;; bootstrap.el --- Build self-hosted backend tools from source -*- lexical-binding: t; -*-

(defconst eliscript-backend-bootstrap-root
  (expand-file-name "../.." (file-name-directory (or load-file-name buffer-file-name))))

(add-to-list 'load-path
             (expand-file-name "compiler" eliscript-backend-bootstrap-root))
(require 'eliscript)
(require 'json)

(declare-function eliscript-generate-unicode-case-runtime-data "../runtime/unicode-case-runtime" (root))

(defun eliscript-backend-stage0-read (path)
  "Read PATH without changing its Unicode source text."
  (with-temp-buffer
    (let ((coding-system-for-read 'utf-8-unix)) (insert-file-contents path))
    (buffer-string)))

(defun eliscript-backend-stage0-write (root path text)
  "Write original TEXT under ROOT/PATH and return its byte identity."
  (let ((file (expand-file-name path root)))
    (make-directory (file-name-directory file) t)
    (let ((coding-system-for-write 'utf-8-unix))
      (with-temp-file file (insert text)))
    (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert-file-contents-literally file)
      `((path . ,path) (bytes . ,(buffer-size))
        (sha256 . ,(secure-hash 'sha256 (current-buffer)))))))

(defun eliscript-backend-stage0-json (value)
  "Encode the primitive declaration VALUE in canonical insertion order."
  (decode-coding-string
   (json-serialize value :null-object nil :false-object :false) 'utf-8-unix))

(defun eliscript-backend-stage0-u16 (text)
  "Return the exact UTF-16LE code units of TEXT without a signature."
  (let ((bytes (generate-new-buffer " *eliscript-stage0-units*")))
    (unwind-protect
        (with-current-buffer bytes
          (set-buffer-multibyte nil)
          (mapc (lambda (point)
                  (if (> point #xffff)
                      (let* ((rest (- point #x10000))
                             (high (+ #xd800 (ash rest -10)))
                             (low (+ #xdc00 (logand rest #x3ff))))
                        (insert (unibyte-string (logand high 255) (ash high -8)
                                              (logand low 255) (ash low -8))))
                    (insert (unibyte-string (logand point 255) (ash point -8)))))
                (string-to-list text))
          (buffer-string))
      (kill-buffer bytes))))

(defun eliscript-backend-stage0-source-identity (record &optional declaration)
  "Return RECORD's source identity, including transport fields for DECLARATION."
  (let* ((text (alist-get 'source record))
         (bytes (eliscript-backend-stage0-u16 text)))
    (append (when (alist-get 'id record) `((id . ,(alist-get 'id record))))
            `((filename . ,(alist-get 'filename record)))
            (when declaration '((encoding . "utf16le")))
            `((sha256 . ,(secure-hash 'sha256 bytes)))
            (when declaration `((bytes . ,(length bytes)))))))

(defun eliscript-backend-stage0-literal-records ()
  "Read the canonical literal source declarations used by the build adapter.
The JS driver independently compares this inventory to loadCompilerSources;
an added or changed declaration cannot silently bootstrap an incomplete graph."
  (let ((pairs nil))
    (dolist (name '("bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value"
                    "managed-queue-state" "managed-vector-view-state" "managed-transient-state" "managed-sorted-state" "managed-value-state"))
      (push (cons (concat "stdlib/" name ".mjs") (concat "stdlib/" name ".eli")) pairs))
    (dolist (pair '(("runtime/core/protocol-error.mjs" . "stdlib/managed-protocol-error.eli")
                    ("stdlib/core/protocol.mjs" . "stdlib/core/protocol.eli")
                    ("stdlib/core/text.mjs" . "stdlib/core/text.eli")
                    ("stdlib/core/object.mjs" . "stdlib/core/object.eli")
                    ("stdlib/core/set.mjs" . "stdlib/core/set.eli")
                    ("stdlib/core/data.mjs" . "stdlib/core/data.eli")
                    ("stdlib/managed-literal-protocols.mjs" . "stdlib/managed-literal-protocols.eli")
                    ("stdlib/managed-literals.mjs" . "stdlib/managed-literals.eli")))
      (push pair pairs))
    (dolist (name '("list" "vector" "map" "set" "queue" "identifier" "record" "value" "metadata" "collection" "transient" "protocol" "type"
                    "order" "sorted" "regex" "transducer" "lazy-sequence" "truth" "text" "object" "sequence"
                    "set-algebra" "collection-internals" "metadata-internals" "persistent-kind" "data" "data-text" "value-internals"))
      (push (cons (concat "runtime/core/" name ".mjs") (concat "stdlib/managed-runtime-" name ".eli")) pairs))
    (dolist (pair '(("runtime/literals.mjs" . "stdlib/managed-runtime-literals.eli")
                    ("runtime/wire/markdown.mjs" . "stdlib/managed-wire-markdown.eli")
                    ("runtime/wire/schema.mjs" . "stdlib/managed-wire-schema.eli")
                    ("runtime/wire/http-rpc.mjs" . "stdlib/managed-wire-http-rpc.eli")
                    ("runtime/testing/value.mjs" . "stdlib/managed-testing-value.eli")))
      (push pair pairs))
    (mapcar (lambda (pair)
              `((id . ,(car pair)) (filename . ,(cdr pair))
                (source . ,(eliscript-backend-stage0-read
                            (expand-file-name (cdr pair) eliscript-backend-bootstrap-root)))))
            (nreverse pairs))))

(defun eliscript-backend-materialize-capsules (root-directory)
  "Materialize all in-place .eli capsule modules ((module capsules....)) to <rel>.mjs."
  (dolist (dir '("bootstrap/host" "browser" "examples" "platform" "runtime" "tests" "tools"))
    (let ((scan-root (expand-file-name dir root-directory)))
      (when (file-directory-p scan-root)
        (dolist (capsule (directory-files-recursively scan-root "\\.eli\\'"))
          (let* ((rel (file-relative-name capsule root-directory))
                 (coding-system-for-read 'utf-8-unix)
                 (coding-system-for-write 'utf-8-unix)
                 (payload (with-temp-buffer
                            (insert-file-contents capsule)
                            (goto-char (point-min))
                            (when (looking-at-p "\\`(module capsules\\.")
                              (search-forward "(js* ")
                              (json-parse-string
                               (buffer-substring-no-properties
                                (point) (- (point-max) 3)))))))
            (when payload
              (unless (stringp payload)
                (error "Invalid capsule module %s" rel))
              (let ((target (expand-file-name (concat (substring rel 0 -4) ".mjs") root-directory)))
                (make-directory (file-name-directory target) t)
                (with-temp-buffer
                  (set-buffer-multibyte t)
                  (insert payload)
                  (write-region (point-min) (point-max) target nil 'silent))
                (when (member rel '("bootstrap/host/bun.eli"
                                    "bootstrap/host/project-cli-legacy.eli"
                                    "runtime/worker.eli"))
                  (set-file-modes target #o755))))))))))

(defun eliscript-backend-bootstrap-runtimes ()
  "Prepare maintained runtime modules before loading generated compiler tools."
  (let ((default-directory eliscript-backend-bootstrap-root))
    (eliscript-backend-materialize-capsules default-directory)
    (let ((generator (expand-file-name "tools/runtime/unicode-case-runtime.el" default-directory)))
      (unless (file-regular-p generator)
        (error "formal bootstrap requires its maintained Unicode data generator"))
      (load generator nil t)
      (eliscript-generate-unicode-case-runtime-data default-directory))
    ;; The exact two Unicode capsules have no default-import dependency.
    ;; Prepare them before any ordinary generated ESM, including Math.
    (dolist (entry '(("runtime/unicode-case-data.eli" . "runtime/unicode-case-data.mjs")
                     ("runtime/unicode-case.eli" . "runtime/unicode-case.mjs")
                     ("runtime/math.eli" . "runtime/math.mjs")
                     ("runtime/unicode-case-data.eli" . "dist/runtime/unicode-case-data.mjs")
                     ("runtime/unicode-case.eli" . "dist/runtime/unicode-case.mjs")
                     ("runtime/math.eli" . "dist/runtime/math.mjs")
                     ("stdlib/core/protocol.eli" . "runtime/core/protocol-impl.mjs")
                     ("stdlib/core/text.eli" . "runtime/core/text-impl.mjs")
                     ("stdlib/core/object.eli" . "runtime/core/object-impl.mjs")
                     ("tools/project/project.eli" . "bootstrap/host/project.mjs")
                     ("tools/project/project-cli.eli" . "bootstrap/host/project-cli.mjs")))
      (when (file-exists-p (expand-file-name (car entry) default-directory))
        (make-directory (file-name-directory (expand-file-name (cdr entry) default-directory)) t)
        (eliscript-compile-file-with-source-map (car entry) (cdr entry))))
    ;; Deterministic test snapshots are build products, never Git sources.
    ;; Minimal compiler-only source checkouts need not contain this fixture.
    (when (file-exists-p "tests/fixtures/core.eli")
      (make-directory "tests/snapshots" t)
      (eliscript-compile-file "tests/fixtures/core.eli" "tests/snapshots/core.mjs"))))

(defun eliscript-backend-bootstrap-stage0 (output-root)
  "Compile the complete formal compiler directly with maintained Emacs Lisp.
Return the relative receipt path stage0.json. No generated compiler is loaded."
  (let* ((output (file-name-as-directory (expand-file-name output-root)))
         (entry "host/compiler-session.mjs") (records nil) (files nil) (modules nil)
         (seed nil) (literals nil) (literal-assets nil) (runtime nil) (formal nil))
    (eliscript-backend-bootstrap-runtimes)
    (make-directory output t)
    (condition-case failure
        (progn
          (dolist (group '(("bootstrap/compiler/" . "bootstrap/")
                           ("bootstrap/backends/" . "backends/")
                           ("bootstrap/host/" . "host/")))
            (dolist (name (directory-files (expand-file-name (car group) eliscript-backend-bootstrap-root)
                                          nil "\\`[a-z][a-z0-9-]*\\.eli\\'"))
              (when (or (not (equal (car group) "bootstrap/host/"))
                        (member name '("compiler-session.eli" "compiler-tools.eli")))
                (let ((filename (concat (car group) name)))
                  (push `((id . ,(concat (cdr group) (file-name-base name) ".mjs"))
                          (filename . ,filename)
                          (source . ,(eliscript-backend-stage0-read
                                      (expand-file-name filename eliscript-backend-bootstrap-root)))) records)))))
          (setq records (append (nreverse records)
                          (mapcar (lambda (entry)
                                    `((id . ,(car entry)) (filename . ,(cdr entry))
                                      (source . ,(eliscript-backend-stage0-read
                                                  (expand-file-name (cdr entry) eliscript-backend-bootstrap-root)))))
                                  '(("runtime/math.mjs" . "runtime/math.eli")
                                    ("runtime/unicode-case.mjs" . "runtime/unicode-case.eli")
                                    ("runtime/unicode-case-data.mjs" . "runtime/unicode-case-data.eli"))))
                literals (eliscript-backend-stage0-literal-records)
                runtime `((filename . "bootstrap/runtime/memory.eli")
                          (source . ,(eliscript-backend-stage0-read
                                      (expand-file-name "bootstrap/runtime/memory.eli" eliscript-backend-bootstrap-root)))))
          (let* ((ordered (sort (copy-sequence records)
                                (lambda (left right) (string< (alist-get 'id left) (alist-get 'id right)))))
                 (identity `((encoding . "utf16le") (entry . ,entry)
                             (modules . ,(vconcat (mapcar (lambda (record) (eliscript-backend-stage0-source-identity record t)) ordered)))
                             (runtime . ,(eliscript-backend-stage0-source-identity runtime t))
                             (literalSources . ,(vconcat (mapcar (lambda (record) (eliscript-backend-stage0-source-identity record t)) literals))))))
            (setq formal (append identity `((sha256 . ,(secure-hash 'sha256
                                                       (eliscript-backend-stage0-u16
                                                        (eliscript-backend-stage0-json identity))))))))
          (dolist (name (append '("tools/backends/bootstrap.el" "tools/runtime/unicode-case-runtime.el")
                               (mapcar (lambda (file) (concat "compiler/" file))
                                       (directory-files (expand-file-name "compiler" eliscript-backend-bootstrap-root) nil "\\.el\\'"))))
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert-file-contents-literally (expand-file-name name eliscript-backend-bootstrap-root))
              (push `((path . ,name) (bytes . ,(buffer-size))
                      (sha256 . ,(secure-hash 'sha256 (current-buffer)))) seed)))
          (dolist (record records)
            (let* ((id (alist-get 'id record)) (filename (alist-get 'filename record))
                   (source (alist-get 'source record))
                   (emission (eliscript-compile-string-with-source-map source filename id filename)))
              (message "eliscript stage0 %s" id)
              (push (eliscript-backend-stage0-write output id (eliscript-emission-javascript emission)) files)
              (push (eliscript-backend-stage0-write output (concat id ".map") (eliscript-emission-source-map emission)) files)
              (push `((id . ,id) (path . ,id) (sourceMapPath . ,(concat id ".map"))) modules)))
          (push (eliscript-backend-stage0-write output "runtime.eli" (alist-get 'source runtime)) files)
          (dolist (record literals)
            (let ((path (concat "literal-sources/" (substring (alist-get 'id record) 0 -4) ".eli")))
              (push (eliscript-backend-stage0-write output path (alist-get 'source record)) files)
              (push `((id . ,(alist-get 'id record)) (filename . ,(alist-get 'filename record)) (path . ,path)) literal-assets)))
          (setq files (nreverse files))
          (let* ((product-data `((host . "javascript")
                                 (files . ,(vconcat (sort (copy-sequence files)
                                                         (lambda (left right) (string< (alist-get 'path left) (alist-get 'path right))))))))
                 (product (append `((algorithm . "sha256")
                                    (sha256 . ,(secure-hash 'sha256 (encode-coding-string (eliscript-backend-stage0-json product-data) 'utf-8-unix)))) product-data))
                 (artifact `((host . "javascript") (target . "javascript") (entry . ,entry) (path . ,entry)
                             (modules . ,(vconcat (nreverse modules))) (runtimePath . "runtime.eli")
                             (literalSources . ,(vconcat (nreverse literal-assets)))
                             (sourceIdentity . ((algorithm . "sha256") (encoding . "utf16le")
                                                (modules . ,(vconcat (mapcar #'eliscript-backend-stage0-source-identity records)))
                                                (runtime . ,(eliscript-backend-stage0-source-identity runtime))
                                                (literalSources . ,(vconcat (mapcar #'eliscript-backend-stage0-source-identity literals)))))
                             (provenance . ((mode . "emacs-lisp") (producerHost . "emacs-lisp")
                                            (compiledModuleIds . ,(vconcat (mapcar (lambda (record) (alist-get 'id record)) records)))))
                             (artifactIdentity . ((algorithm . "sha256") (files . ,(vconcat files))))
                             (productIdentity . ,product))))
            (eliscript-backend-stage0-write output "compiler-artifact.json" (eliscript-backend-stage0-json artifact))
            (eliscript-backend-stage0-write output "stage0.json"
              (eliscript-backend-stage0-json
               `((format . "eliscript-js-stage0") (version . 1) (status . "built")
                 (host . "javascript") (target . "javascript") (producer . "emacs-lisp")
                 (seedSourceIdentity . ,(vconcat (nreverse seed))) (formalSourceIdentity . ,formal)
                 (productIdentity . ,product) (metadataPath . "compiler-artifact.json")))))
          (let* ((package (if (file-exists-p (expand-file-name "package.json" eliscript-backend-bootstrap-root))
                              eliscript-backend-bootstrap-root
                            (expand-file-name "node_modules/eliscript" eliscript-backend-bootstrap-root)))
                 (link (expand-file-name "node_modules/eliscript" output)))
            (make-directory (file-name-directory link) t)
            (if (file-exists-p link)
                (unless (equal (file-truename link) (file-truename package))
                  (error "stage0 runtime package resolves to a different source"))
              (make-symbolic-link package link)))
          "stage0.json")
      (error
       (ignore-errors
         (eliscript-backend-stage0-write output "stage0.json"
           (eliscript-backend-stage0-json
            `((format . "eliscript-js-stage0") (version . 1) (status . "failed")
              (error . ((message . ,(error-message-string failure))))))))
       (signal (car failure) (cdr failure))))))

