;;; bootstrap.el --- Build self-hosted backend tools from source -*- lexical-binding: t; -*-

(defconst eliscript-backend-bootstrap-root
  (expand-file-name "../.." (file-name-directory (or load-file-name buffer-file-name))))

(add-to-list 'load-path
             (expand-file-name "compiler" eliscript-backend-bootstrap-root))
(require 'eliscript)
(require 'json)
(require 'eliscript-bootstrap-runtime
         (expand-file-name "tools/bootstrap-runtime.el" eliscript-backend-bootstrap-root))

(declare-function eliscript-generate-unicode-case-runtime-data "../runtime/unicode-case-runtime" (root))

(defun eliscript-backend-stage0-read (path)
  "Read PATH without changing its Unicode source text."
  (with-temp-buffer
    (let ((coding-system-for-read 'utf-8-unix)) (insert-file-contents path))
    (buffer-string)))

(defun eliscript-backend-stage0-write (root path text)
  "Write original TEXT under ROOT/PATH and return its byte identity."
  (let ((file (expand-file-name path root)))
    (make-directory (file-name-directory file) t)
    (let ((coding-system-for-write 'utf-8-unix))
      (with-temp-file file (insert text)))
    (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert-file-contents-literally file)
      `((path . ,path) (bytes . ,(buffer-size))
        (sha256 . ,(secure-hash 'sha256 (current-buffer)))))))

(defun eliscript-backend-stage0-json (value)
  "Encode the primitive declaration VALUE in canonical insertion order."
  (decode-coding-string
   (json-serialize value :null-object nil :false-object :false) 'utf-8-unix))

(defun eliscript-backend-stage0-u16 (text)
  "Return the exact UTF-16LE code units of TEXT without a signature."
  (let ((bytes (generate-new-buffer " *eliscript-stage0-units*")))
    (unwind-protect
        (with-current-buffer bytes
          (set-buffer-multibyte nil)
          (mapc (lambda (point)
                  (if (> point #xffff)
                      (let* ((rest (- point #x10000))
                             (high (+ #xd800 (ash rest -10)))
                             (low (+ #xdc00 (logand rest #x3ff))))
                        (insert (unibyte-string (logand high 255) (ash high -8)
                                              (logand low 255) (ash low -8))))
                    (insert (unibyte-string (logand point 255) (ash point -8)))))
                (string-to-list text))
          (buffer-string))
      (kill-buffer bytes))))

(defun eliscript-backend-stage0-source-identity (record &optional declaration)
  "Return RECORD's source identity, including transport fields for DECLARATION."
  (let* ((text (alist-get 'source record))
         (bytes (eliscript-backend-stage0-u16 text)))
    (append (when (alist-get 'id record) `((id . ,(alist-get 'id record))))
            `((filename . ,(alist-get 'filename record)))
            (when declaration '((encoding . "utf16le")))
            `((sha256 . ,(secure-hash 'sha256 bytes)))
            (when declaration `((bytes . ,(length bytes)))))))

(defun eliscript-backend-stage0-literal-records ()
  "Read the canonical literal source declarations used by the build adapter.
The JS driver independently compares this inventory to loadCompilerSources;
an added or changed declaration cannot silently bootstrap an incomplete graph."
  (let ((pairs nil))
    (dolist (name '("bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value"
                    "managed-queue-state" "managed-vector-view-state" "managed-transient-state" "managed-sorted-state" "managed-value-state"))
      (push (cons (concat "stdlib/" name ".mjs") (concat "stdlib/" name ".eli")) pairs))
    (dolist (pair '(("runtime/core/protocol-error.mjs" . "stdlib/managed-protocol-error.eli")
                    ("stdlib/core/protocol.mjs" . "stdlib/core/protocol.eli")
                    ("stdlib/core/text.mjs" . "stdlib/core/text.eli")
                    ("stdlib/core/object.mjs" . "stdlib/core/object.eli")
                    ("stdlib/core/set.mjs" . "stdlib/core/set.eli")
                    ("stdlib/core/data.mjs" . "stdlib/core/data.eli")
                    ("stdlib/managed-literal-protocols.mjs" . "stdlib/managed-literal-protocols.eli")
                    ("stdlib/managed-literals.mjs" . "stdlib/managed-literals.eli")))
      (push pair pairs))
    (dolist (name '("list" "vector" "map" "set" "queue" "identifier" "record" "value" "metadata" "collection" "transient" "protocol" "type"
                    "order" "sorted" "regex" "transducer" "lazy-sequence" "truth" "text" "object" "sequence"
                    "set-algebra" "collection-internals" "metadata-internals" "persistent-kind" "data" "data-text" "value-internals"))
      (push (cons (concat "runtime/core/" name ".mjs") (concat "stdlib/managed-runtime-" name ".eli")) pairs))
    (dolist (pair '(("runtime/literals.mjs" . "stdlib/managed-runtime-literals.eli")
                    ("runtime/wire/markdown.mjs" . "stdlib/managed-wire-markdown.eli")
                    ("runtime/wire/schema.mjs" . "stdlib/managed-wire-schema.eli")
                    ("runtime/wire/http-rpc.mjs" . "stdlib/managed-wire-http-rpc.eli")
                    ("runtime/testing/value.mjs" . "stdlib/managed-testing-value.eli")))
      (push pair pairs))
    (mapcar (lambda (pair)
              `((id . ,(car pair)) (filename . ,(cdr pair))
                (source . ,(eliscript-backend-stage0-read
                            (expand-file-name (cdr pair) eliscript-backend-bootstrap-root)))))
            (nreverse pairs))))

(defun eliscript-backend-install-bun-shebang (entry)
  "Ensure ENTRY starts with #!/usr/bin/env bun, shift its source map, and set #o755."
  (let ((full (expand-file-name entry eliscript-backend-bootstrap-root))
        (coding-system-for-read 'utf-8-unix)
        (coding-system-for-write 'utf-8-unix))
    (when (file-exists-p full)
      (with-temp-buffer
        (insert-file-contents full)
        (goto-char (point-min))
        (unless (looking-at-p "\\`#!")
          (insert "#!/usr/bin/env bun\n")
          (write-region (point-min) (point-max) full nil 'silent)
          (let ((map-path (concat full ".map")))
            (when (file-exists-p map-path)
              (let ((map (json-parse-string (eliscript-backend-stage0-read map-path))))
                (puthash "mappings" (concat ";" (gethash "mappings" map)) map)
                (with-temp-file map-path (insert (json-serialize map))))))))
      (set-file-modes full #o755))))

(defun eliscript-backend-reset-runtime-support ()
  "Discard the bootstrap-owned copied runtime before regenerating it.
Public project builds still reject conflicting user output.  This exact path
belongs to the compiler build; its former bytes are not an incremental input."
  (dolist (relative '("dist" "dist/runtime" "dist/runtime/node_modules"
                      "dist/runtime/node_modules/eliscript"))
    (when (file-symlink-p (expand-file-name relative eliscript-backend-bootstrap-root))
      (error "Bootstrap runtime support output is a symlink: %s" relative)))
  (let ((directory (expand-file-name "dist/runtime/node_modules/eliscript"
                                     eliscript-backend-bootstrap-root)))
    (when (file-exists-p directory)
      (unless (file-directory-p directory)
        (error "Bootstrap runtime support output is not a directory"))
      (delete-directory directory t))))

