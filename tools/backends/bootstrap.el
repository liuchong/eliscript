(defun eliscript-backend-bootstrap-stage0 (output-root)
  "Compile the complete formal compiler directly with maintained Emacs Lisp.
Return the relative receipt path stage0.json. No generated compiler is loaded."
  (let* ((output (file-name-as-directory (expand-file-name output-root)))
         (entry "host/compiler-session.mjs") (records nil) (files nil) (modules nil)
         (seed nil) (literals nil) (literal-assets nil) (runtime nil) (formal nil))
    (eliscript-backend-bootstrap-runtimes)
    (make-directory output t)
    (condition-case failure
        (progn
          (dolist (group '(("bootstrap/compiler/" . "bootstrap/")
                           ("bootstrap/backends/" . "backends/")
                           ("bootstrap/host/" . "host/")))
            (dolist (name (directory-files (expand-file-name (car group) eliscript-backend-bootstrap-root)
                                          nil "\\`[a-z][a-z0-9-]*\\.eli\\'"))
              (when (or (not (equal (car group) "bootstrap/host/"))
                        (member name '("compiler-session.eli" "compiler-tools.eli")))
                (let ((filename (concat (car group) name)))
                  (push `((id . ,(concat (cdr group) (file-name-base name) ".mjs"))
                          (filename . ,filename)
                          (source . ,(eliscript-backend-stage0-read
                                      (expand-file-name filename eliscript-backend-bootstrap-root)))) records)))))
          (setq records (append (nreverse records)
                          (mapcar (lambda (entry)
                                    `((id . ,(car entry)) (filename . ,(cdr entry))
                                      (source . ,(eliscript-backend-stage0-read
                                                  (expand-file-name (cdr entry) eliscript-backend-bootstrap-root)))))
                                  '(("runtime/array-text.mjs" . "runtime/array-text.eli")
                                    ("runtime/errors.mjs" . "runtime/errors.eli")
                                    ("runtime/math.mjs" . "runtime/math.eli")
                                    ("runtime/number-radix.mjs" . "runtime/number-radix.eli")
                                    ("runtime/prelude.mjs" . "runtime/prelude.eli")
                                    ("runtime/primitives.mjs" . "runtime/primitives.eli")
                                    ("runtime/unicode-case.mjs" . "runtime/unicode-case.eli")
                                    ("runtime/unicode-case-data.mjs" . "runtime/unicode-case-data.eli"))))
                literals (eliscript-backend-stage0-literal-records)
                runtime `((filename . "bootstrap/runtime/memory.eli")
                          (source . ,(eliscript-backend-stage0-read
                                      (expand-file-name "bootstrap/runtime/memory.eli" eliscript-backend-bootstrap-root)))))
          (let* ((ordered (sort (copy-sequence records)
                                (lambda (left right) (string< (alist-get 'id left) (alist-get 'id right)))))
                 (identity `((encoding . "utf16le") (entry . ,entry)
                             (modules . ,(vconcat (mapcar (lambda (record) (eliscript-backend-stage0-source-identity record t)) ordered)))
                             (runtime . ,(eliscript-backend-stage0-source-identity runtime t))
                             (literalSources . ,(vconcat (mapcar (lambda (record) (eliscript-backend-stage0-source-identity record t)) literals))))))
            (setq formal (append identity `((sha256 . ,(secure-hash 'sha256
                                                       (eliscript-backend-stage0-u16
                                                        (eliscript-backend-stage0-json identity))))))))
          (dolist (name (append '("tools/backends/bootstrap.el" "tools/runtime/unicode-case-runtime.el")
                               (mapcar (lambda (file) (concat "compiler/" file))
                                       (directory-files (expand-file-name "compiler" eliscript-backend-bootstrap-root) nil "\\.el\\'"))))
            (with-temp-buffer
              (set-buffer-multibyte nil)
              (insert-file-contents-literally (expand-file-name name eliscript-backend-bootstrap-root))
              (push `((path . ,name) (bytes . ,(buffer-size))
                      (sha256 . ,(secure-hash 'sha256 (current-buffer)))) seed)))
          (dolist (record records)
            (let* ((id (alist-get 'id record)) (filename (alist-get 'filename record))
                   (source (alist-get 'source record))
                   (emission (eliscript-compile-string-with-source-map source filename id filename)))
              (message "eliscript stage0 %s" id)
              (push (eliscript-backend-stage0-write output id (eliscript-emission-javascript emission)) files)
              (push (eliscript-backend-stage0-write output (concat id ".map") (eliscript-emission-source-map emission)) files)
              (push `((id . ,id) (path . ,id) (sourceMapPath . ,(concat id ".map"))) modules)))
          (push (eliscript-backend-stage0-write output "runtime.eli" (alist-get 'source runtime)) files)
          (dolist (record literals)
            (let ((path (concat "literal-sources/" (substring (alist-get 'id record) 0 -4) ".eli")))
              (push (eliscript-backend-stage0-write output path (alist-get 'source record)) files)
              (push `((id . ,(alist-get 'id record)) (filename . ,(alist-get 'filename record)) (path . ,path)) literal-assets)))
          (setq files (nreverse files))
          (let* ((product-data `((host . "javascript")
                                 (files . ,(vconcat (sort (copy-sequence files)
                                                         (lambda (left right) (string< (alist-get 'path left) (alist-get 'path right))))))))
                 (product (append `((algorithm . "sha256")
                                    (sha256 . ,(secure-hash 'sha256 (encode-coding-string (eliscript-backend-stage0-json product-data) 'utf-8-unix)))) product-data))
                 (artifact `((host . "javascript") (target . "javascript") (entry . ,entry) (path . ,entry)
                             (modules . ,(vconcat (nreverse modules))) (runtimePath . "runtime.eli")
                             (literalSources . ,(vconcat (nreverse literal-assets)))
                             (sourceIdentity . ((algorithm . "sha256") (encoding . "utf16le")
                                                (modules . ,(vconcat (mapcar #'eliscript-backend-stage0-source-identity records)))
                                                (runtime . ,(eliscript-backend-stage0-source-identity runtime))
                                                (literalSources . ,(vconcat (mapcar #'eliscript-backend-stage0-source-identity literals)))))
                             (provenance . ((mode . "emacs-lisp") (producerHost . "emacs-lisp")
                                            (compiledModuleIds . ,(vconcat (mapcar (lambda (record) (alist-get 'id record)) records)))))
                             (artifactIdentity . ((algorithm . "sha256") (files . ,(vconcat files))))
                             (productIdentity . ,product))))
            (eliscript-backend-stage0-write output "compiler-artifact.json" (eliscript-backend-stage0-json artifact))
            (eliscript-backend-stage0-write output "stage0.json"
              (eliscript-backend-stage0-json
               `((format . "eliscript-js-stage0") (version . 1) (status . "built")
                 (host . "javascript") (target . "javascript") (producer . "emacs-lisp")
                 (seedSourceIdentity . ,(vconcat (nreverse seed))) (formalSourceIdentity . ,formal)
                 (productIdentity . ,product) (metadataPath . "compiler-artifact.json")))))
          (let* ((package (if (file-exists-p (expand-file-name "package.json" eliscript-backend-bootstrap-root))
                              eliscript-backend-bootstrap-root
                            (expand-file-name "node_modules/eliscript" eliscript-backend-bootstrap-root)))
                 (link (expand-file-name "node_modules/eliscript" output)))
            (make-directory (file-name-directory link) t)
            (if (file-exists-p link)
                (unless (equal (file-truename link) (file-truename package))
                  (error "stage0 runtime package resolves to a different source"))
              (make-symbolic-link package link)))
          "stage0.json")
      (error
       (ignore-errors
         (eliscript-backend-stage0-write output "stage0.json"
           (eliscript-backend-stage0-json
            `((format . "eliscript-js-stage0") (version . 1) (status . "failed")
              (error . ((message . ,(error-message-string failure))))))))
       (signal (car failure) (cdr failure))))))

(defun eliscript-backend-finalize-tool (output)
  "Restore the executable wrapper for a successfully compiled OUTPUT."
  (when (member output '("bootstrap/host/bun.mjs"
                         "bootstrap/host/project-cli-ground.mjs"
                         "runtime/worker.mjs"))
    (eliscript-backend-install-bun-shebang output))
  (when (equal output "bootstrap/host/eliscript-cli.mjs")
    (let ((entry (expand-file-name output default-directory))
          (coding-system-for-write 'utf-8-unix))
      (with-temp-buffer
        (insert-file-contents entry)
        (goto-char (point-min))
        (insert (format "#!%s node\n" (or (executable-find "env")
                                         (error "Cannot locate env for the CLI executable"))))
        (write-region (point-min) (point-max) entry nil 'silent))
      (when (file-exists-p (concat entry ".map"))
        (let* ((map-path (concat entry ".map"))
               (map (json-parse-string (eliscript-backend-stage0-read map-path))))
          (puthash "mappings" (concat ";" (gethash "mappings" map)) map)
          (with-temp-file map-path (insert (json-serialize map)))))
      (set-file-modes entry #o755))))

(defun eliscript-backend-compile-tool (runtime tool)
  "Compile one bootstrap prerequisite TOOL, returning its failure or nil."
  (make-directory (file-name-directory (expand-file-name (cdr tool) default-directory)) t)
  (with-temp-buffer
    (let ((status (call-process runtime nil t nil "bootstrap/host/bun.mjs"
                                (car tool) "--output" (cdr tool) "--source-map")))
      (if (and (integerp status) (zerop status))
          (progn (eliscript-backend-finalize-tool (cdr tool)) nil)
        (format "Self-hosted tool bootstrap failed for %s (%s): %s"
                (car tool) status (buffer-string))))))

(defun eliscript-backend-compile-tool-batch (runtime driver tools)
  "Compile ordered TOOLS in one RUNTIME; return failures in reverse order."
  (let ((destination (generate-new-buffer " *eliscript-bootstrap-results*"))
        status stderr-file diagnostics)
    (unwind-protect
        (condition-case failure
            (let ((requests (vconcat (mapcar (lambda (tool) (vector (car tool) (cdr tool))) tools)))
                  results failures)
              (let ((directory (expand-file-name ".eliscript-cache/bootstrap" default-directory)))
                (make-directory directory t)
                (setq stderr-file (make-temp-file (expand-file-name "stderr-" directory))))
              (with-temp-buffer
                (let ((encoded (json-serialize requests)))
                  (insert (if (multibyte-string-p encoded) encoded
                            (decode-coding-string encoded 'utf-8))))
                (let ((coding-system-for-write 'utf-8-unix)
                      (coding-system-for-read 'utf-8-unix))
                  (setq status (call-process-region (point-min) (point-max)
                                                    runtime nil (list destination stderr-file) nil driver))))
              (setq diagnostics (eliscript-backend-stage0-read stderr-file))
              (unless (zerop (length diagnostics)) (message "%s" diagnostics))
              (with-current-buffer destination
                (goto-char (point-min))
                (setq results (json-parse-buffer :object-type 'alist :array-type 'list)))
              (unless (and (memq status '(0 1)) (= (length results) (length tools)))
                (error "batch status/count differs from the requested inventory"))
              ;; Validate the complete response before treating any output as
              ;; successful. Missing, reordered or misbound results never pass.
              (let ((rows results))
                (dolist (tool tools)
                  (let ((row (pop rows)))
                    (unless (and (equal (alist-get 'input row) (car tool))
                                 (equal (alist-get 'output row) (cdr tool))
                                 (memq (alist-get 'status row) '(0 1))
                                 (or (= (alist-get 'status row) 0)
                                     (stringp (alist-get 'error row))))
                      (error "batch result differs for %s" (car tool))))))
              (dolist (row results)
                (unless (zerop (alist-get 'status row))
                  (push (format "Self-hosted tool bootstrap failed for %s: %s"
                                (alist-get 'input row) (alist-get 'error row)) failures)))
              (unless (eq (zerop status) (null failures))
                (error "batch exit status disagrees with its per-file results"))
              (dolist (row results)
                (when (zerop (alist-get 'status row))
                  (eliscript-backend-finalize-tool (alist-get 'output row))))
              failures)
          (error
           (list (format "Self-hosted batch bootstrap failed (status %S); remaining outputs are unverified: %s\n%s"
                         status
                         (error-message-string failure)
                         (let ((text (if (and diagnostics (> (length diagnostics) 0)) diagnostics
                                       (with-current-buffer destination (buffer-string)))))
                           (substring text 0 (min (length text) 4096)))))))
      (when (and stderr-file (file-exists-p stderr-file)) (delete-file stderr-file))
      (kill-buffer destination))))

