(module tools.backends.memory-runtime
  ;; Bulk memory transport and instance-owned handles only. Allocation, growth,
  ;; validation and UTF8 algorithms remain in the compiled Eli runtime.
  (defconst messages (js-array "" "invalid or retired runtime handle" "runtime capacity exhausted"
    "runtime bounds or argument error" "invalid UTF8" "unpaired UTF16 surrogate"
    "string builder must be sealed" "runtime lifetime epoch exhausted"))
  (defconst host-method (js* "(implementation, name) => ({ [name](...args) { return implementation(this, ...args); } })[name]"))
  (defun host-type (value) (js* "typeof value"))
  (defun host-truth (value) (js* "!!value"))
  (defun memory-instance? (value) (js* "value instanceof WebAssembly.Memory"))
  (defun fail (code)
    (let ((error (new globalThis.Error (get messages code))))
      (put error :eliscriptDiagnostic (js-object :format "eliscript-diagnostic" :version 1
        :code (str "ELI-RT" (js-call (funcall globalThis.String code) :padStart 4 "0")) :severity "error" :phase "runtime"
        :message (get error :message))) (throw error)))
  (defun word (value max)
    (when (undefined? max) (setq max 4294967295))
    (unless (and (eq (host-type value) "number") (Number/isInteger value) (>= value 0) (<= value max)
                 (not (Object/is value (js* "-0")))) (fail 3)) value)
  (Object/defineProperty word "length" (js-object :value 1 :configurable t))
  (defun flag (value) (unless (eq (host-type value) "boolean") (fail 3)) (funcall globalThis.Number value))
  (defun install (api name implementation arity)
    (let ((method (funcall host-method implementation name)))
      (Object/defineProperty method "length" (js-object :value arity :configurable t)) (put api name method)))
  (defun argument-options (value) (if (undefined? value) (js-object) value))
  (defun option (value key fallback) (let ((found (get value key))) (if (undefined? found) fallback found)))
  (defun instantiateMemoryRuntime (bytes)
    (let ((module (new globalThis.WebAssembly.Module bytes)))
      (when (> (js-length (js-call globalThis.WebAssembly.Module :imports module)) 0)
        (throw (new globalThis.Error "memory runtime requires zero host imports")))
      (let* ((e (get (new globalThis.WebAssembly.Instance module) :exports))
             (handles (new globalThis.WeakMap)) (epoch 0) (call nil) (wrap nil) (pointer nil) (data nil)
             (view (lambda () (new globalThis.DataView (get (get e :memory) :buffer)))) (api (js-object)))
        (unless (memory-instance? (get e :memory)) (throw (new globalThis.Error "memory runtime must export owned memory")))
        (setq call (lambda (name &rest args)
          (let* ((value (uint32 (Reflect/apply (get e name) e args))) (code (js-call (get e "last-error") :call e)))
            (when (host-truth code) (fail code)) value)))
        (setq wrap (lambda (address kind)
          (let ((handle (Object/freeze (js-object :kind kind))))
            (js-call handles :set handle (js-object :pointer address :kind kind :epoch epoch)) handle)))
        (setq pointer (lambda (handle kind)
          (let ((entry (js-call handles :get handle)))
            (unless (and (host-truth entry) (eq (get entry :kind) kind) (eq (get entry :epoch) epoch)) (fail 1)) (get entry :pointer))))
        (setq data (lambda (handle kind)
          (let* ((p (funcall pointer handle kind))
                 (length (funcall call (cond ((eq kind "buffer") "buffer-length") ((eq kind "string") "string-length") (t "record-length")) p)))
            (js-object :p p :length length :offset (js-call (funcall view) :getUint32 (+ p 16) t)))))
        (install api "buffer" (lambda (self input)
          (let* ((array (Array/from input (lambda (value) (word value 255)))) (p (funcall call "buffer-new" (word (js-length array)))))
            (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) (js-call (funcall view) :getUint32 (+ p 16) t) (js-length array)) :set array)
            (js-call (funcall view) :setUint32 (+ p 8) (js-length array) t) (funcall wrap p "buffer"))) 1)
        (install api "string" (lambda (self input)
          (unless (eq (host-type input) "string") (fail 3))
          (let* ((p (funcall call "string-new" (word (js-length input)))) (offset (js-call (funcall view) :getUint32 (+ p 16) t))
                 (target (funcall view)) (index 0))
            (while (< index (js-length input))
              (js-call target :setUint16 (+ offset (* index 2)) (js-call input :charCodeAt index) t) (setq index (1+ index)))
            (funcall call "string-seal" p) (funcall wrap p "string"))) 1)
        (install api "record" (lambda (self input)
          (let* ((array (Array/from input (lambda (value) (word value)))) (p (funcall call "record-new" (word (js-length array))))
                 (offset (js-call (funcall view) :getUint32 (+ p 16) t)) (target (funcall view)) (index 0))
            (while (< index (js-length array))
              (js-call target :setUint32 (+ offset (* index 4)) (aref array index) t) (setq index (1+ index)))
            (funcall wrap p "record"))) 1)
        (install api "bytes" (lambda (self handle)
          (let ((entry (funcall data handle "buffer")))
            (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) (get entry :offset) (get entry :length)) :slice))) 1)
        (install api "text" (lambda (self handle)
          (let* ((entry (funcall data handle "string")) (length (get entry :length)) (offset (get entry :offset))
                 (source (funcall view)) (chunks (js-array)) (start 0))
            (while (< start length)
              (let ((units (js-array)) (index start))
                (while (< index (Math/min (+ start 8192) length))
                  (js-call units :push (js-call source :getUint16 (+ offset (* index 2)) t)) (setq index (1+ index)))
                (js-call chunks :push (Reflect/apply String/fromCharCode globalThis.String units)))
              (setq start (+ start 8192))) (js-call chunks :join ""))) 1)
        (install api "words" (lambda (self handle)
          (let* ((entry (funcall data handle "record")) (length (get entry :length)) (offset (get entry :offset)) (source (funcall view)))
            (Uint32Array/from (js-object :length length) (lambda (ignored index) (js-call source :getUint32 (+ offset (* index 4)) t))))) 1)
        (install api "encode" (lambda (self handle options)
          (let* ((options (argument-options options)) (strict (option options "strict" false)))
            (funcall wrap (funcall call "utf8-encode" (funcall pointer handle "string") (flag strict)) "buffer"))) 1)
        (install api "decode" (lambda (self handle options)
          (let* ((options (argument-options options)) (strict (option options "strict" false)) (preserveBOM (option options "preserveBOM" false)))
            (funcall wrap (funcall call "utf8-decode" (funcall pointer handle "buffer") (flag strict) (flag preserveBOM)) "string"))) 1)
        (install api "reserve" (lambda (self handle capacity) (funcall call "buffer-reserve" (funcall pointer handle "buffer") (word capacity)) undefined) 2)
        (install api "push" (lambda (self handle byte) (funcall call "buffer-push" (funcall pointer handle "buffer") (word byte 255)) undefined) 2)
        (install api "retire" (lambda (self) (funcall call "retire") (setq epoch (1+ epoch)) undefined) 0)
        (Object/freeze api))))
  (export instantiateMemoryRuntime))
