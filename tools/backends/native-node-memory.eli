                    (funcall reject-ready
                      (new globalThis.Error (+ "native transport exited before initialization: " code)))))
                (js-call worker :on "message" ready)
                (js-call worker :once "error" fail)
                (js-call worker :once "exit" exit)))))
          (catch error
            (await (js-call worker :terminate))
            (throw error)))
        ;; Worker failures after initialization are also delivered through the shared
        ;; channel, which remains observable while this thread is synchronously waiting.
        (js-call worker :on "error"
          (lambda (error)
            (when (undefined? terminal) (setq terminal error))))
        (js-call worker :unref)
        (let* ((stop (lambda ()
                 (unless stopped
                   (setq stopped t)
                   (js-call worker :postMessage (js-object :shutdown t)))))
               (active (lambda ()
                 (when closed (throw (new globalThis.Error "native memory is closed")))))
               (invalidate-get-cache (lambda ()
                 (when (> (get fast-get-cache :size) 0)
                   (js-call fast-get-cache :clear))))
               (record-unadopted-pin (lambda (raw)
                 (let ((cur (js-call unadopted-pins :get raw)))
                   (js-call unadopted-pins :set raw (if (undefined? cur) 1 (1+ cur)))
                   (setq unadopted-pin-total (1+ unadopted-pin-total)))))
               (parse-compact-p-response (lambda (text)
                 (let* ((parts (js-call text :split "\t"))
                        (id (funcall globalThis.Number (js-call (aref parts 0) :slice 1)))
                        (kind (aref parts 1)))
                   (unless (and (Number/isSafeInteger id) (>= id 1))
                     (throw (new globalThis.TypeError "invalid native compact result")))
                   (cond
                     ((= kind "U") (js-object :id id :result t :lastError 0))
                     ((= kind "M") (js-object :id id :result false :lastError 0))
                     ((= kind "A")
                      (let* ((col (funcall globalThis.Number (aref parts 2)))
                             (rk (aref parts 3))
                             (res (cond
                                    ((= rk "i")
                                     (js-object :kind "immediate"
                                       :raw (normalize-u64 (funcall globalThis.BigInt (aref parts 4)))
                                       :collections col :pendingForeign undefined))
                                    ((= rk "n")
                                     (js-object :kind "number"
                                       :value (if (= (aref parts 4) "m") (* -1 0) (funcall globalThis.Number (aref parts 4)))
                                       :collections col :pendingForeign undefined))
                                    ((= rk "s")
                                     (js-object :kind "string"
                                       :value (compact-wire-decode-str (aref parts 4))
                                       :collections col :pendingForeign undefined))
                                    ((= rk "p")
                                     (js-object :kind "pinned"
                                       :raw (normalize-u64 (funcall globalThis.BigInt (aref parts 4)))
                                       :valueKind (funcall globalThis.Number (aref parts 5))
                                       :token (funcall globalThis.Number (aref parts 6))
                                       :collections col :pendingForeign undefined))
