                      (when (> (get fast-get-cache :size) 32768)
                        (js-call fast-get-cache :clear))
                      (let ((pi 2) (plen (js-length parts)))
                        (while (< pi plen)
                          (let ((btag (aref parts pi)))
                            (cond
                              ((= btag "Y")
                               (let* ((blkRaw (normalize-u64 (funcall globalThis.BigInt (aref parts (1+ pi)))))
                                      (len (funcall globalThis.Number (aref parts (+ pi 2))))
                                      (cnt (funcall globalThis.Number (aref parts (+ pi 3))))
                                      (fields (new globalThis.Map))
                                      (ei 0))
                                 (setq pi (+ pi 4))
                                 (while (< ei cnt)
                                   (let* ((k (aref parts pi))
                                          (dv (decode-bundle-scalar (aref parts (1+ pi)))))
                                     (when (= (get dv :tag) "o")
                                       (funcall record-unadopted-pin (get dv :raw)))
                                     (js-call fields :set k dv))
                                   (setq pi (+ pi 2) ei (1+ ei)))
                                 (js-call fast-get-cache :set blkRaw (js-object :isArr t :length len :fields fields))))
                              ((= btag "O")
                               (let* ((blkRaw (normalize-u64 (funcall globalThis.BigInt (aref parts (1+ pi)))))
                                      (cnt (funcall globalThis.Number (aref parts (+ pi 2))))
                                      (fields (new globalThis.Map))
                                      (ei 0))
                                 (setq pi (+ pi 3))
                                 (while (< ei cnt)
                                   (let* ((k (compact-wire-decode-str (aref parts pi)))
                                          (dv (decode-bundle-scalar (aref parts (1+ pi)))))
                                     (when (= (get dv :tag) "o")
                                       (funcall record-unadopted-pin (get dv :raw)))
                                     (js-call fields :set k dv))
                                   (setq pi (+ pi 2) ei (1+ ei)))
                                 (js-call fast-get-cache :set blkRaw (js-object :isArr false :length 0 :fields fields))))
                              (t (throw (new globalThis.TypeError "invalid compact bundle block")))))))
                      (js-object :id id :result t :lastError 0))
                     (t (throw (new globalThis.TypeError "invalid native compact response")))))))
               (receive (lambda ()
                 (let ((result undefined) (done false))
                   (while (not done)
                     (when (not (undefined? terminal)) (throw terminal))
                     (let ((status (Atomics/load control 0)))
                       (while (= status 0)
                         (Atomics/wait control 0 0)
                         (setq status (Atomics/load control 0)))
                       (if (= status 2)
                         (let ((length (Atomics/load control 1)))
                           (when (< length 1)
                             (throw (new globalThis.Error "invalid native transport buffer request")))
                           (setq buffer
