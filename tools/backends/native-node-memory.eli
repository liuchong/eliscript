                       (funcall flush-unadopted-pins fheap t)))
                   (let ((is-ro (or (= method "size")
                                    (= method "getUint16")
                                    (= method "getUint32")
                                    (= method "getFloat64")
                                    (= method "getBigUint64")
                                    (= method "read")
