(module tools.backends.native-node-memory
  (import "node:worker_threads" Worker)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./compiler-worker.mjs" fromErrorData)
  (import "./managed-layout.mjs" normalize-u64)

  (defun wire-replacer (key value)
    (cond
      ((= (value-type value) "bigint") (js-object :__v64 (str (normalize-u64 value))))
      ((and (= (value-type value) "number")
            (or (not (Number/isFinite value)) (Object/is value (* -1 0))))
       (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
         (js-call bits :setFloat64 0 value t)
         (js-object :__f64 (js-array (js-call bits :getUint32 0 t) (js-call bits :getUint32 4 t)))))
      (t value)))
  (defun wire-reviver (key value)
    (if (and (not (nullish? value)) (= (value-type value) "object")
             (= (js-length (Object/keys value)) 1))
      (cond
        ((Object/hasOwn value "__v64")
         (unless (= (value-type (get value :__v64)) "string")
           (throw (new globalThis.TypeError "invalid native Val64 wire value")))
         (normalize-u64 (funcall globalThis.BigInt (get value :__v64))))
        ((Object/hasOwn value "__f64")
         (let ((words (get value :__f64))
               (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
           (unless (and (Array/isArray words) (= (js-length words) 2)
                        (js-call words :every (lambda (word)
                          (and (Number/isInteger word) (>= word 0) (<= word 4294967295)))))
             (throw (new globalThis.TypeError "invalid native f64 wire value")))
           (js-call bits :setUint32 0 (aref words 0) t)
           (js-call bits :setUint32 4 (aref words 1) t)
           (js-call bits :getFloat64 0 t)))
        (t value))
      value))


  (defun memory-module-url ()
    (let* ((stack (str (get (new globalThis.Error) :stack)))
           (file-match (js-call (new globalThis.RegExp "(file://[^\\s):]+\\.mjs):\\d+:\\d+") :exec stack)))
      (if file-match
        (aref file-match 1)
        (let ((path-match (js-call (new globalThis.RegExp "(/[^\\s():]+\\.mjs):\\d+:\\d+") :exec stack)))
          (if path-match
            (get (pathToFileURL (aref path-match 1)) :href)
            (get (pathToFileURL (resolve "tools/backends/native-node-memory.mjs")) :href))))))

  (defun remoteFailure (record)
    (fromErrorData record))
  (defconst fast-name-pattern (new globalThis.RegExp "^[A-Za-z0-9_.:-]+$"))
  (defun fast-invoke-request (id args)
    (let ((parts (js-array (str "F" id) "invoke")) (ok t) (index 0))
      (while (and ok (< index (js-length args)))
        (let* ((arg (aref args index)) (type (value-type arg)))
          (cond
            ((= type "string")
             (if (js-call fast-name-pattern :test arg)
               (js-call parts :push (str "s" arg))
               (setq ok false)))
            ((= type "number")
             ;; -0 is a safe integer and String(-0) is "0", so it must stay
             ;; on the IEEE JSON path instead of the unsigned n-frame.
             (if (and (Number/isSafeInteger arg) (not (Object/is arg (* -1 0)))
                      (>= arg 0) (<= arg 4294967295))
               (js-call parts :push (str "n" arg))
               (setq ok false)))
            ((= type "bigint")
             (js-call parts :push (str "b" (normalize-u64 arg))))
            (t (setq ok false))))
        (setq index (1+ index)))
      (if ok (js-call parts :join " ") nil)))
  (defun parse-fast-result (text)
    (let ((parts (js-call text :split " ")))
      (unless (and (= (js-length parts) 3) (js-call (aref parts 0) :startsWith "R"))
        (throw (new globalThis.TypeError "invalid native fast result")))
      (let ((id (funcall globalThis.Number (js-call (aref parts 0) :slice 1)))
            (last-error (funcall globalThis.Number (aref parts 1)))
            (body (aref parts 2))
            (tag (js-call (aref parts 2) :charAt 0))
            (rest (js-call (aref parts 2) :slice 1))
            (result undefined))
        (unless (and (Number/isSafeInteger id) (>= id 1)
                     (Number/isSafeInteger last-error) (>= last-error 0) (<= last-error 4294967295))
          (throw (new globalThis.TypeError "invalid native fast result")))
        (cond
          ((= body "z") (setq result nil))
          ((= body "t") (setq result t))
          ((= body "f") (setq result false))
          ((= tag "n")
           (setq result (funcall globalThis.Number rest))
           (unless (and (Number/isSafeInteger result) (>= result 0) (<= result 4294967295))
             (throw (new globalThis.TypeError "invalid native fast result"))))
          ((= tag "b")
           (setq result (normalize-u64 (funcall globalThis.BigInt rest))))
          (t (throw (new globalThis.TypeError "invalid native fast result"))))
        (js-object :id id :result result :lastError last-error))))

  (defconst nativeMemoryBlockBytes 65536)

  (defun copy-configuration (options)
    (let ((target (js-object)))
      (unless (nullish? options)
        (let* ((object (funcall globalThis.Object options))
               (keys (Reflect/ownKeys object))
               (index 0))
          (while (< index (js-length keys))
            (let ((key (aref keys index)))
              (unless (or (= key "hostCall") (= key "bunExecutable"))
                (let ((descriptor (Object/getOwnPropertyDescriptor object key)))
                  (when (and descriptor (get descriptor :enumerable))
                    (Object/defineProperty target key
                      (js-object :value (get object key) :writable t :enumerable t :configurable t))))))
            (setq index (1+ index)))))
      target))

  ;; Node keeps the original host program in its own process. A dedicated Bun
  ;; process owns the native library and its linear memory; the wire carries only
  ;; memory-u32 calls and byte blocks, never compiler or source-language work.
  (defun node-signature-snapshot (input)
    (Object/fromEntries (js-call (Object/entries input) :map
      (lambda (entry)
        (let* ((signature (aref entry 1)) (arity (get signature :arity))
               (source-types (get signature :parameterTypes))
               (types (when (Array/isArray source-types) (js-call source-types :slice)))
               (result (get signature :resultType)))
          (unless (and (> (js-length (aref entry 0)) 0) (Number/isInteger arity) (>= arity 0)
                       (Array/isArray types) (= arity (js-length types))
                       (js-call (js-array "u32" "f64" "v64" "bits64") :includes result))
            (throw (new globalThis.TypeError "native export requires an exact signature")))
          (js-call types :forEach (lambda (type)
            (unless (js-call (js-array "u32" "f64" "v64" "bits64") :includes type)
              (throw (new globalThis.TypeError "unknown native parameter type")))))
          (js-array (aref entry 0) (Object/freeze (js-object :arity arity
            :parameterTypes (Object/freeze types) :resultType result))))))))
  (defun node-signature (signatures name)
    (let ((sig (js-call signatures :get name)))
      (unless sig (throw (new globalThis.TypeError "unknown native memory export"))) sig))
  (defun node-encode-args (types args)
    (js-call args :map (lambda (value index)
      (if (or (= (aref types index) "v64") (= (aref types index) "bits64"))
        (normalize-u64 value) value))))
  (defun node-decode-result (type value)
    (if (or (= type "v64") (= type "bits64"))
      (progn
        (unless (= (value-type value) "bigint")
          (throw (new globalThis.TypeError "native wire returned an inexact 64-bit value")))
        (normalize-u64 value)) value))

  (defconst readonly-native-invokes
    (new globalThis.Set (js-array "last-error" "value-kind" "value-length" "value-data"
      "value-number-bits" "value-foreign-token" "heap-pin" "frame-current"
      "heap-collections" "heap-used" "heap-capacity" "heap-live" "frame-depth" "read")))
  (defun compact-wire-encode-str (s)
    (if (and (= (js-call s :indexOf "\t") -1)
             (= (js-call s :indexOf "\n") -1)
             (= (js-call s :indexOf "\r") -1))
      (str "S" s)
      (str "Q" (JSON/stringify s))))
  (defun compact-wire-decode-str (tok)
    (if (js-call tok :startsWith "S")
      (js-call tok :slice 1)
      (JSON/parse (js-call tok :slice 1))))
  (defun compact-encode-apply-val (arg)
    (let ((kind (get arg :kind)))
      (cond
        ((= kind "raw") (str "r" (normalize-u64 (get arg :raw))))
        ((= kind "number")
         (let ((v (get arg :value)))
           (if (Number/isFinite v)
             (if (Object/is v (* -1 0)) "m" (str "n" v))
             nil)))
        ((= kind "string") (compact-wire-encode-str (get arg :text)))
        ((= kind "foreign")
         (str "f" (unsigned-bit-shift-right (get arg :token) 0) ":"
           (unsigned-bit-shift-right (get arg :slot) 0) ":"
           (if (get arg :constructible) "1" "0")))
        (t nil))))
  (defun compact-apply-request (id spec)
    (let ((args (get spec :args)))
      (when (and (not (nullish? (get spec :heap)))
                 (not (nullish? (get spec :receiver)))
                 (Array/isArray args) (<= (js-length args) 4)
                 (or (not (undefined? (get spec :targetRaw)))
                     (and (not (undefined? (get spec :hoistedIndex))) (= (value-type (get spec :invokeName)) "string"))))
        (let ((rec (compact-encode-apply-val (get spec :receiver))))
          (when rec
            (let ((parts (js-array (str "A" id) (unsigned-bit-shift-right (get spec :heap) 0)))
                  (ok t)
                  (i 0))
              (if (undefined? (get spec :hoistedIndex))
                (js-call parts :push "R" (str (normalize-u64 (get spec :targetRaw))))
                (js-call parts :push "H" (get spec :hoistedIndex) (compact-wire-encode-str (get spec :invokeName))))
              (js-call parts :push rec (js-length args))
              (while (and ok (< i (js-length args)))
                (let ((enc (compact-encode-apply-val (aref args i))))
                  (if enc (js-call parts :push enc) (setq ok false)))
                (setq i (1+ i)))
              (when ok (js-call parts :join "\t"))))))))
  (defun decode-bundle-scalar (tok)
    (let ((tag (js-call tok :charAt 0)))
      (cond
        ((= tag "z") (js-object :hit t :tag "v" :value nil))
        ((= tag "u") (js-object :hit t :tag "v" :value undefined))
        ((= tag "t") (js-object :hit t :tag "v" :value t))
        ((= tag "f") (js-object :hit t :tag "v" :value false))
        ((= tag "m") (js-object :hit t :tag "v" :value (* -1 0)))
        ((= tag "P") (js-object :hit t :tag "v" :value globalThis.Number.POSITIVE_INFINITY))
        ((= tag "M") (js-object :hit t :tag "v" :value globalThis.Number.NEGATIVE_INFINITY))
        ((= tag "Z") (js-object :hit t :tag "v" :value globalThis.Number.NaN))
        ((= tag "n") (js-object :hit t :tag "v" :value (funcall globalThis.Number (js-call tok :slice 1))))
        ((or (= tag "S") (= tag "Q")) (js-object :hit t :tag "v" :value (compact-wire-decode-str tok)))
        ((= tag "x")
         (let* ((sep (js-call tok :indexOf ":"))
                (raw (normalize-u64 (funcall globalThis.BigInt (js-call tok :slice 1 sep))))
                (token (funcall globalThis.Number (js-call tok :slice (1+ sep)))))
           (js-object :hit t :tag "x" :raw raw :token token)))
        ((= tag "o")
         (let* ((sep (js-call tok :indexOf ":"))
                (raw (normalize-u64 (funcall globalThis.BigInt (js-call tok :slice 1 sep))))
                (ek (funcall globalThis.Number (js-call tok :slice (1+ sep)))))
           (js-object :hit t :tag "o" :raw raw :valueKind ek)))
        (t (throw (new globalThis.TypeError "invalid compact bundle value"))))))
  (defconst FAST_GET_MISS (Object/freeze (js-object :hit false)))
  (defasync openNodeNativeMemory (path signatures &rest rest)
    (let* ((options (if (or (= (js-length rest) 0) (undefined? (aref rest 0))) (js-object) (aref rest 0)))
           (host-call (get options :hostCall))
           (bun-executable (if (undefined? (get options :bunExecutable))
                             (let ((env-bun (get (get globalThis.process :env) :BUN)))
                               (if (nullish? env-bun) "bun" env-bun))
                             (get options :bunExecutable)))
