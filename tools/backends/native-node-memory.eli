                       (funcall invalidate-get-cache))
                     (setq cached-heap-stats undefined)
                     (when (or (= method "invoke") (= method "open") (= method "close"))
                       (setq cached-last-error undefined))
                     (setq sequence (1+ sequence))
                     (let ((id sequence)
                           (done false)
                           (response-result undefined))
                       (setq depth (1+ depth))
                       (try
                         (progn
                           (let ((fast (cond
                                         ((= method "invoke") (fast-invoke-request id args))
                                         ((= method "fastApply") (compact-apply-request id (aref args 0)))
                                         (t nil))))
                             (js-call worker :postMessage
                               (js-object :request (if fast fast
                                                     (JSON/stringify (js-object :id id :method method :args args) wire-replacer)))))
                           (while (not done)
                             (let ((message (funcall receive)))
                               (if (and (not (nullish? message)) (not (undefined? (get message :callback))))
                                 (let ((callback (get message :callback)))
                                   (funcall invalidate-get-cache)
                                   (setq cached-heap-stats undefined)
                                   (setq cached-last-error (if (get callback :tuple) 0 undefined))
                                   (try
                                     (progn
                                       (unless (= (value-type host-call) "function")
                                         (throw (new globalThis.TypeError "native artifact requires an explicit host capability dispatcher")))
                                       (let ((value (if (not (undefined? (get callback :tuple)))
                                                      (funcall host-call (get callback :index) (get callback :heap) (get callback :argv) (get callback :tuple))
                                                      (funcall host-call (get callback :index) (get callback :heap) (get callback :argv)))))
                                         ;; Closing in a callback rejects later calls; the
                                         ;; current response completes before depth-zero stop.
                                         (if (and (not (undefined? (get callback :tuple)))
                                                  (not (nil? value))
                                                  (= (value-type value) "object")
                                                  (= (value-type (get value :fastOp)) "string"))
                                           (progn
                                             (setq cached-last-error undefined)
                                             (js-call worker :postMessage
                                               (js-object :request (JSON/stringify (js-object :callback (get callback :id) :fastOp value) wire-replacer))))
                                           (progn
                                             (unless (= (value-type value) "bigint")
                                               (throw (new globalThis.TypeError "native host capability returned an invalid Val64")))
                                             (setq value (normalize-u64 value))
                                             (setq cached-last-error undefined)
                                             (js-call worker :postMessage
                                               (js-object :request (JSON/stringify (js-object :callback (get callback :id) :result value) wire-replacer)))))))
                                     (catch error
                                       (setq cached-last-error undefined)
                                       (setq host-sequence (1+ host-sequence))
                                       (let ((token host-sequence))
                                         (js-call host-failures :set token error)
                                         (js-call worker :postMessage
                                           (js-object :request (JSON/stringify (js-object :callback (get callback :id) :hostError token) wire-replacer))))))
                                   (funcall invalidate-get-cache))
                                 (progn
                                   (unless (and (not (nullish? message)) (= (get message :id) id))
                                     (throw (new globalThis.Error "native transport response belongs to a different invocation")))
                                   (when (Object/hasOwn message "hostError")
                                     (unless (js-call host-failures :has (get message :hostError))
                                       (throw (new globalThis.Error "unknown native host exception identity")))
                                     (let ((error (js-call host-failures :get (get message :hostError))))
                                       (js-call host-failures :delete (get message :hostError))
                                       (throw error)))
                                   (when (get message :error)
                                     (throw (remoteFailure (get message :error))))
                                   (when (not (undefined? (get message :lastError)))
                                     (setq cached-last-error (get message :lastError)))
                                   (when (Array/isArray (get message :heapStats))
                                     (setq cached-heap-stats (get message :heapStats)))
                                   (setq response-result (get message :result))
                                   (setq done t)))))
                           (unless is-ro
                             (funcall invalidate-get-cache))
                           response-result)
                         (finally
                           (setq depth (1- depth))
                           (when (and closed (= depth 0))
                             (js-call host-failures :clear)
                             (funcall stop)))))))))
               (scalar-offset (lambda (offset)
                 (funcall active)
                 (unless (and (Number/isSafeInteger offset) (>= offset 0))
                   (throw (new globalThis.RangeError "memory access out of bounds")))))
               (range (lambda (offset length)
                 (funcall active)
                 ;; Validate in the original Node realm before the JSON wire can coerce an
                 ;; unsupported value (for example NaN, undefined or a boxed number).
                 (unless (and (Number/isSafeInteger offset) (Number/isSafeInteger length)
                              (>= offset 0) (>= length 0))
                   (throw (new globalThis.RangeError "memory access out of bounds")))
                 (when (> (+ offset length) (funcall exchange "size"))
                   (throw (new globalThis.RangeError "memory access out of bounds"))))))
          (try
            (funcall exchange "open" (js-array path signature-snapshot configuration))
            (catch error
              (setq closed t)
              (funcall stop)
              (throw error)))
          (let ((handle
                  (js-object
                    :invoke (lambda (name &rest args)
                      (funcall active)
                      (let* ((signature (node-signature native-signatures name))
                             (arity (get signature :arity))
                             (types (get signature :parameterTypes)))
                        (unless (= (js-length args) arity)
                          (throw (new globalThis.TypeError "native memory argument count mismatch")))
                        (let ((index 0))
                          (while (< index (js-length args))
                            (let ((type (aref types index)) (value (aref args index)))
                              (cond
                                ((= type "u32")
                                  (unless (and (Number/isInteger value) (>= value 0) (<= value 4294967295))
                                    (throw (new globalThis.RangeError "memory32 arguments must be u32"))))
                                ((= type "f64")
                                  (unless (= (value-type value) "number")
                                    (throw (new globalThis.TypeError "native f64 argument must be a number"))))
                                ((or (= type "v64") (= type "bits64"))
                                  (unless (= (value-type value) "bigint")
                                    (throw (new globalThis.TypeError "native v64 argument must be a bigint"))))
                                (t (throw (new globalThis.TypeError "unknown native argument type")))))
                            (setq index (1+ index))))
                        (cond
                          ((and (= name "last-error") (= (js-length args) 0) (not (undefined? cached-last-error)))
                           cached-last-error)
                          ((and (= (js-length args) 1) (Array/isArray cached-heap-stats)
                                (= (aref args 0) (aref cached-heap-stats 0))
                                (js-call (js-array "heap-used" "heap-capacity" "heap-live" "frame-depth" "heap-collections") :includes name))
                           (setq cached-last-error 0)
                           (cond
                             ((= name "heap-used") (aref cached-heap-stats 1))
                             ((= name "heap-capacity") (aref cached-heap-stats 2))
                             ((= name "heap-live") (aref cached-heap-stats 3))
                             ((= name "frame-depth") (aref cached-heap-stats 4))
                             (t (aref cached-heap-stats 5))))
                          (t (node-decode-result (get signature :resultType)
                               (funcall exchange "invoke"
                                 (js-call (js-array name) :concat (node-encode-args types args))))))))
                    :fastApply (lambda (spec)
                      (funcall active)
                      (setq cached-last-error 0)
                      (setq last-pin-heap (unsigned-bit-shift-right (get spec :heap) 0))
                      (funcall flush-unadopted-pins last-pin-heap false)
                      (funcall exchange "fastApply" (js-array spec)))
                    :fastGet (lambda (heap raw key)
                      (funcall active)
                      (if (or (/= (value-type key) "string") (= key "__proto__"))
                        FAST_GET_MISS
                        (progn
                          (setq last-pin-heap (unsigned-bit-shift-right heap 0))
                          (let ((cached (js-call fast-get-cache :get raw)))
                            (when (undefined? cached)
                              (funcall flush-unadopted-pins last-pin-heap false)
                              (setq sequence (1+ sequence))
                              (let ((ok (funcall send-raw-and-wait sequence
                                          (str "G" sequence "\t" last-pin-heap "\t" (normalize-u64 raw) "\t" (compact-wire-encode-str key)))))
                                (when ok (setq cached (js-call fast-get-cache :get raw)))))
                            (if (undefined? cached)
                              FAST_GET_MISS
                              (if (and (get cached :isArr) (= key "length"))
                                (js-object :hit t :tag "v" :value (get cached :length))
                                (let ((v (js-call (get cached :fields) :get key)))
                                  (if (undefined? v) FAST_GET_MISS v))))))))
                    :adoptFastGetPin (lambda (raw)
                      (let ((cur (js-call unadopted-pins :get raw)))
                        (if (and (not (undefined? cur)) (> cur 0))
                          (progn
                            (if (= cur 1) (js-call unadopted-pins :delete raw) (js-call unadopted-pins :set raw (1- cur)))
                            (setq unadopted-pin-total (1- unadopted-pin-total))
                            t)
                          false)))
                    :releaseBatch (lambda (heap raws)
                      (funcall active)
                      (when (and (Array/isArray raws) (> (js-length raws) 0))
                        (setq cached-last-error 0)
                        (let ((target-heap (unsigned-bit-shift-right heap 0)))
                          (setq sequence (1+ sequence))
                          (funcall send-raw-and-wait sequence
                            (str "U" sequence "\t" target-heap "\t" (js-call raws :join ",")))))
                      undefined)
                    :fastRaw (lambda (spec)
                      (funcall active)
                      (setq cached-last-error 0)
                      (funcall exchange "fastRaw" (js-array spec)))
                    :getUint16 (lambda (offset endian)
                      (funcall scalar-offset offset)
                      (funcall exchange "getUint16" (js-array offset (funcall globalThis.Boolean endian))))
                    :getUint32 (lambda (offset endian)
                      (funcall scalar-offset offset)
                      (funcall exchange "getUint32" (js-array offset (funcall globalThis.Boolean endian))))
                    :getBigUint64 (lambda (offset endian)
                      (funcall scalar-offset offset)
                      (node-decode-result "bits64" (funcall exchange "getBigUint64"
                        (js-array offset (funcall globalThis.Boolean endian)))))
                    :setBigUint64 (lambda (offset value endian)
                      (funcall scalar-offset offset)
                      (unless (= (value-type value) "bigint")
                        (throw (new globalThis.TypeError "native 64-bit scalar write requires a bigint")))
                      (funcall exchange "setBigUint64"
                        (js-array offset (normalize-u64 value) (funcall globalThis.Boolean endian)))
                      undefined)
                    :getFloat64 (lambda (offset endian)
                      (funcall scalar-offset offset)
                      (funcall exchange "getFloat64" (js-array offset (funcall globalThis.Boolean endian))))
                    :setUint16 (lambda (offset value endian)
                      (let ((converted (Math/trunc value)))
                        (funcall scalar-offset offset)
                        (funcall exchange "setUint16"
                          (js-array offset (if (Number/isFinite converted) (bit-or converted 0) 0)
                            (funcall globalThis.Boolean endian)))
                        undefined))
                    :setUint32 (lambda (offset value endian)
                      (let ((converted (Math/trunc value)))
                        (funcall scalar-offset offset)
                        (funcall exchange "setUint32"
                          (js-array offset (if (Number/isFinite converted) (unsigned-bit-shift-right converted 0) 0)
                            (funcall globalThis.Boolean endian)))
                        undefined))
                    :read (lambda (offset length)
                      (funcall range offset length)
                      (let ((result (new globalThis.Uint8Array length))
                            (start 0))
                        ;; Keep the complete independent public result, but never a second
                        ;; complete base64 string/decoded Buffer beside it. The empty operation
                        ;; still crosses the original remote boundary once.
                        (while (or (< start length) (= start 0))
                          (let* ((count (Math/min nativeMemoryBlockBytes (- length start)))
                                 (encoded (funcall exchange "read" (js-array (+ offset start) count))))
                            (unless (and (= (value-type encoded) "string")
                                         (= (js-length encoded) (* (Math/ceil (/ count 3)) 4)))
                              (throw (new globalThis.Error "native memory read returned an invalid byte count")))
                            (let ((bytes (Buffer/from encoded "base64")))
                              (unless (= (get bytes :byteLength) count)
                                (throw (new globalThis.Error "native memory read returned an invalid byte count")))
                              (js-call result :set bytes start)))
                          (setq start (+ start nativeMemoryBlockBytes)))
                        result))
                    :write (lambda (input &rest write-rest)
                      (let ((offset (if (or (= (js-length write-rest) 0) (undefined? (aref write-rest 0)))
                                      0
                                      (aref write-rest 0))))
                        (funcall active)
                        (unless (js-call globalThis.Uint8Array (get globalThis.Symbol :hasInstance) input)
                          (throw (new globalThis.TypeError "memory write requires Uint8Array")))
                        ;; Snapshot the whole caller view before dispatch, including before the
                        ;; full range check. Only its cross-process encoding is block bounded.
                        (let ((bytes (Buffer/from input))
                              (start 0))
                          (funcall range offset (get bytes :byteLength))
                          (while (or (< start (get bytes :byteLength)) (= start 0))
                            (funcall exchange "write"
                              (js-array
                                (js-call bytes :toString "base64" start
                                  (Math/min (+ start nativeMemoryBlockBytes) (get bytes :byteLength)))
                                (+ offset start)))
                            (setq start (+ start nativeMemoryBlockBytes)))
                          undefined)))
                    :close (lambda ()
                      (unless closed
                        (try
                          (funcall exchange "close")
                          (finally
                            (setq closed t)
                            (when (= depth 0)
                              (js-call host-failures :clear)
                              (funcall stop))))
                        undefined)))))
            (Object/defineProperty handle "byteLength"
              (js-object :get (lambda () (funcall active) (funcall exchange "size"))
                :enumerable t :configurable t))
            (Object/freeze handle))))))

  (export openNodeNativeMemory))
