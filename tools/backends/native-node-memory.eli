(module tools.backends.native-node-memory
  (import "node:worker_threads" Worker)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./compiler-worker.mjs" fromErrorData)

  (defun memory-module-url ()
    (let* ((stack (str (get (new globalThis.Error) :stack)))
           (file-match (js-call (new globalThis.RegExp "(file://[^\\s):]+\\.mjs):\\d+:\\d+") :exec stack)))
      (if file-match
        (aref file-match 1)
        (let ((path-match (js-call (new globalThis.RegExp "(/[^\\s():]+\\.mjs):\\d+:\\d+") :exec stack)))
          (if path-match
            (get (pathToFileURL (aref path-match 1)) :href)
            (get (pathToFileURL (resolve "tools/backends/native-node-memory.mjs")) :href))))))

  (defun remoteFailure (record)
    (fromErrorData record))

  (defconst nativeMemoryBlockBytes 65536)

  (defun copy-configuration (options)
    (let ((target (js-object)))
      (unless (nullish? options)
        (let* ((object (funcall globalThis.Object options))
               (keys (Reflect/ownKeys object))
               (index 0))
          (while (< index (js-length keys))
            (let ((key (aref keys index)))
              (unless (or (= key "hostCall") (= key "bunExecutable"))
                (let ((descriptor (Object/getOwnPropertyDescriptor object key)))
                  (when (and descriptor (get descriptor :enumerable))
                    (Object/defineProperty target key
                      (js-object :value (get object key) :writable t :enumerable t :configurable t))))))
            (setq index (1+ index)))))
      target))

  ;; Node keeps the original host program in its own process. A dedicated Bun
  ;; process owns the native library and its linear memory; the wire carries only
  ;; memory-u32 calls and byte blocks, never compiler or source-language work.
  (defasync openNodeNativeMemory (path signatures &rest rest)
    (let* ((options (if (or (= (js-length rest) 0) (undefined? (aref rest 0))) (js-object) (aref rest 0)))
           (host-call (get options :hostCall))
           (bun-executable (if (undefined? (get options :bunExecutable))
                             (let ((env-bun (get (get globalThis.process :env) :BUN)))
                               (if (nullish? env-bun) "bun" env-bun))
                             (get options :bunExecutable)))
           (configuration (copy-configuration options)))
      (unless (and (= (value-type bun-executable) "string") (> (js-length bun-executable) 0))
        (throw (new globalThis.TypeError "native Node transport requires a Bun executable")))
      (let* ((arities (new globalThis.Map (Object/entries signatures)))
             (buffer (new globalThis.SharedArrayBuffer 65536))
             (control (new globalThis.Int32Array buffer 0 4))
             (payload (new globalThis.Uint8Array buffer 16))
             (closed false) (depth 0) (sequence 0) (host-sequence 0)
             (stopped false) (terminal undefined) (cached-last-error undefined)
             (host-failures (new globalThis.Map))
             (decoder (new globalThis.TextDecoder))
             (worker (new Worker (new globalThis.URL "./native-node-worker.mjs" (memory-module-url))
                       (js-object
                         :workerData (js-object :buffer buffer :bunExecutable bun-executable)
                         ;; The source program's preload belongs to its Node host. Replaying that
                         ;; preload in this transport worker would instantiate the project again.
                         :execArgv (js-array)
                         :env (Object/assign (js-object) (get globalThis.process :env)
                                (js-object :NODE_OPTIONS ""))))))
        (try
          (await (new globalThis.Promise
            (lambda (resolve-ready reject-ready)
              (let ((ready undefined) (fail undefined) (exit undefined) (cleanup undefined))
                (setq cleanup
                  (lambda ()
                    (js-call worker :off "message" ready)
                    (js-call worker :off "error" fail)
                    (js-call worker :off "exit" exit)))
                (setq ready
                  (lambda (message)
                    (cond
                      ((and (not (nullish? message)) (get message :ready))
                       (funcall cleanup) (funcall resolve-ready undefined))
                      ((and (not (nullish? message)) (get message :startupFailure))
                       (funcall cleanup)
                       (funcall reject-ready (remoteFailure (get message :startupFailure)))))))
                (setq fail
                  (lambda (error) (funcall cleanup) (funcall reject-ready error)))
                (setq exit
                  (lambda (code)
                    (funcall cleanup)
                    (funcall reject-ready
                      (new globalThis.Error (+ "native transport exited before initialization: " code)))))
                (js-call worker :on "message" ready)
                (js-call worker :once "error" fail)
                (js-call worker :once "exit" exit)))))
          (catch error
            (await (js-call worker :terminate))
            (throw error)))
        ;; Worker failures after initialization are also delivered through the shared
        ;; channel, which remains observable while this thread is synchronously waiting.
        (js-call worker :on "error"
          (lambda (error)
            (when (undefined? terminal) (setq terminal error))))
        (js-call worker :unref)
        (let* ((stop (lambda ()
                 (unless stopped
                   (setq stopped t)
                   (js-call worker :postMessage (js-object :shutdown t)))))
               (receive (lambda ()
                 (let ((result undefined) (done false))
                   (while (not done)
                     (when (not (undefined? terminal)) (throw terminal))
                     (let ((status (Atomics/load control 0)))
                       (while (= status 0)
                         (Atomics/wait control 0 0)
                         (setq status (Atomics/load control 0)))
                       (if (= status 2)
                         (let ((length (Atomics/load control 1)))
                           (when (< length 1)
                             (throw (new globalThis.Error "invalid native transport buffer request")))
                           (setq buffer
                             (new globalThis.SharedArrayBuffer
                               (Math/max (* (get buffer :byteLength) 2) (+ length 16))))
                           (setq control (new globalThis.Int32Array buffer 0 4))
                           (setq payload (new globalThis.Uint8Array buffer 16))
                           (js-call worker :postMessage (js-object :buffer buffer)))
                         (progn
                           (unless (= status 1)
                             (throw (new globalThis.Error "invalid native transport response state")))
                           (let ((length (Atomics/load control 1)))
                             (when (or (< length 0) (> length (js-length payload)))
                               (throw (new globalThis.Error "invalid native transport response length")))
                             (let ((text (js-call decoder :decode (js-call payload :subarray 0 length))))
                               (Atomics/store control 0 0)
                               (when (/= (Atomics/load control 2) 0)
                                 (js-call worker :postMessage (js-object :consumed t)))
                               (let ((record (JSON/parse text)))
                                 (when (and (not (nullish? record)) (get record :transportFailure))
                                   (setq terminal (remoteFailure (get record :transportFailure)))
                                   (throw terminal))
                                 (setq result record)
                                 (setq done t))))))))
                   result)))
               (exchange (lambda (method &optional args-arg)
                 (when stopped (throw (new globalThis.Error "native memory is closed")))
                 (when (or (= method "invoke") (= method "open") (= method "close"))
                   (setq cached-last-error undefined))
                 (setq sequence (1+ sequence))
                 (let ((id sequence)
                       (args (if (nullish? args-arg) (js-array) args-arg))
                       (done false)
                       (response-result undefined))
                   (setq depth (1+ depth))
                   (try
                     (progn
                       (js-call worker :postMessage (js-object :request (js-object :id id :method method :args args)))
                       (while (not done)
                         (let ((message (funcall receive)))
                           (if (and (not (nullish? message)) (not (undefined? (get message :callback))))
                             (let ((callback (get message :callback)))
                               (setq cached-last-error (if (get callback :tuple) 0 undefined))
                               (try
                                 (progn
                                   (unless (= (value-type host-call) "function")
                                     (throw (new globalThis.TypeError "native artifact requires an explicit host capability dispatcher")))
                                   (let ((value (if (not (undefined? (get callback :tuple)))
                                                  (funcall host-call (get callback :index) (get callback :heap) (get callback :argv) (get callback :tuple))
                                                  (funcall host-call (get callback :index) (get callback :heap) (get callback :argv)))))
                                     (if (and (not (undefined? (get callback :tuple)))
                                              (not (nil? value))
                                              (= (value-type value) "object")
                                              (= (value-type (get value :fastOp)) "string"))
                                       (progn
                                         (setq cached-last-error undefined)
                                         (js-call worker :postMessage
                                           (js-object :request (js-object :callback (get callback :id) :fastOp value))))
                                       (progn
                                         (unless (and (Number/isInteger value) (>= value 0) (<= value 4294967295))
                                           (throw (new globalThis.TypeError "native host capability returned an invalid managed word")))
                                         (setq cached-last-error undefined)
                                         (js-call worker :postMessage
                                           (js-object :request (js-object :callback (get callback :id) :result value)))))))
                                 (catch error
                                   (setq cached-last-error undefined)
                                   (setq host-sequence (1+ host-sequence))
                                   (let ((token host-sequence))
                                     (js-call host-failures :set token error)
                                     (js-call worker :postMessage
                                       (js-object :request (js-object :callback (get callback :id) :hostError token)))))))
                             (progn
                               (unless (and (not (nullish? message)) (= (get message :id) id))
                                 (throw (new globalThis.Error "native transport response belongs to a different invocation")))
                               (when (Object/hasOwn message "hostError")
                                 (unless (js-call host-failures :has (get message :hostError))
                                   (throw (new globalThis.Error "unknown native host exception identity")))
                                 (let ((error (js-call host-failures :get (get message :hostError))))
                                   (js-call host-failures :delete (get message :hostError))
                                   (throw error)))
                               (when (get message :error)
                                 (throw (remoteFailure (get message :error))))
                               (when (not (undefined? (get message :lastError)))
                                 (setq cached-last-error (get message :lastError)))
                               (setq response-result (get message :result))
                               (setq done t)))))
                       response-result)
                     (finally
                       (setq depth (1- depth))
                       (when (and closed (= depth 0))
                         (js-call host-failures :clear)
                         (funcall stop)))))))
               (active (lambda ()
                 (when closed (throw (new globalThis.Error "native memory is closed")))))
               (scalar-offset (lambda (offset)
                 (funcall active)
                 (unless (and (Number/isSafeInteger offset) (>= offset 0))
                   (throw (new globalThis.RangeError "memory access out of bounds")))))
               (range (lambda (offset length)
                 (funcall active)
                 ;; Validate in the original Node realm before the JSON wire can coerce an
                 ;; unsupported value (for example NaN, undefined or a boxed number).
                 (unless (and (Number/isSafeInteger offset) (Number/isSafeInteger length)
                              (>= offset 0) (>= length 0))
                   (throw (new globalThis.RangeError "memory access out of bounds")))
                 (when (> (+ offset length) (funcall exchange "size"))
                   (throw (new globalThis.RangeError "memory access out of bounds"))))))
          (try
            (funcall exchange "open" (js-array path signatures configuration))
            (catch error
              (setq closed t)
              (funcall stop)
              (throw error)))
          (let ((handle
                  (js-object
                    :invoke (lambda (name &rest args)
                      (funcall active)
                      (unless (js-call arities :has name)
                        (throw (new globalThis.TypeError "unknown native memory export")))
                      (unless (= (js-length args) (js-call arities :get name))
                        (throw (new globalThis.TypeError "native memory argument count mismatch")))
                      (let ((index 0))
                        (while (< index (js-length args))
                          (let ((value (aref args index)))
                            (unless (and (Number/isInteger value) (>= value 0) (<= value 4294967295))
                              (throw (new globalThis.RangeError "memory32 arguments must be u32"))))
                          (setq index (1+ index))))
                      (if (and (= name "last-error") (= (js-length args) 0) (not (undefined? cached-last-error)))
                        cached-last-error
                        (funcall exchange "invoke" (js-call (js-array name) :concat args))))
                    :getUint16 (lambda (offset endian)
                      (funcall scalar-offset offset)
                      (funcall exchange "getUint16" (js-array offset (funcall globalThis.Boolean endian))))
                    :getUint32 (lambda (offset endian)
                      (funcall scalar-offset offset)
                      (funcall exchange "getUint32" (js-array offset (funcall globalThis.Boolean endian))))
                    :getFloat64 (lambda (offset endian)
                      (funcall scalar-offset offset)
                      (let ((value (funcall exchange "getFloat64" (js-array offset (funcall globalThis.Boolean endian)))))
                        (cond
                          ((= value "NaN") globalThis.NaN)
                          ((= value "Infinity") globalThis.Infinity)
                          ((= value "-Infinity") (- globalThis.Infinity))
                          ((= value "-0") (* -1 0))
                          (t value))))
                    :setUint16 (lambda (offset value endian)
                      (let ((converted (Math/trunc value)))
                        (funcall scalar-offset offset)
                        (funcall exchange "setUint16"
                          (js-array offset (if (Number/isFinite converted) (bit-or converted 0) 0)
                            (funcall globalThis.Boolean endian)))
                        undefined))
                    :setUint32 (lambda (offset value endian)
                      (let ((converted (Math/trunc value)))
                        (funcall scalar-offset offset)
                        (funcall exchange "setUint32"
                          (js-array offset (if (Number/isFinite converted) (unsigned-bit-shift-right converted 0) 0)
                            (funcall globalThis.Boolean endian)))
                        undefined))
                    :read (lambda (offset length)
                      (funcall range offset length)
                      (let ((result (new globalThis.Uint8Array length))
                            (start 0))
                        ;; Keep the complete independent public result, but never a second
                        ;; complete base64 string/decoded Buffer beside it. The empty operation
                        ;; still crosses the original remote boundary once.
                        (while (or (< start length) (= start 0))
                          (let* ((count (Math/min nativeMemoryBlockBytes (- length start)))
                                 (encoded (funcall exchange "read" (js-array (+ offset start) count))))
                            (unless (and (= (value-type encoded) "string")
                                         (= (js-length encoded) (* (Math/ceil (/ count 3)) 4)))
                              (throw (new globalThis.Error "native memory read returned an invalid byte count")))
                            (let ((bytes (Buffer/from encoded "base64")))
                              (unless (= (get bytes :byteLength) count)
                                (throw (new globalThis.Error "native memory read returned an invalid byte count")))
                              (js-call result :set bytes start)))
                          (setq start (+ start nativeMemoryBlockBytes)))
                        result))
                    :write (lambda (input &rest write-rest)
                      (let ((offset (if (or (= (js-length write-rest) 0) (undefined? (aref write-rest 0)))
                                      0
                                      (aref write-rest 0))))
                        (funcall active)
                        (unless (js-call globalThis.Uint8Array (get globalThis.Symbol :hasInstance) input)
                          (throw (new globalThis.TypeError "memory write requires Uint8Array")))
                        ;; Snapshot the whole caller view before dispatch, including before the
                        ;; full range check. Only its cross-process encoding is block bounded.
                        (let ((bytes (Buffer/from input))
                              (start 0))
                          (funcall range offset (get bytes :byteLength))
                          (while (or (< start (get bytes :byteLength)) (= start 0))
                            (funcall exchange "write"
                              (js-array
                                (js-call bytes :toString "base64" start
                                  (Math/min (+ start nativeMemoryBlockBytes) (get bytes :byteLength)))
                                (+ offset start)))
                            (setq start (+ start nativeMemoryBlockBytes)))
                          undefined)))
                    :close (lambda ()
                      (unless closed
                        (try
                          (funcall exchange "close")
                          (finally
                            (setq closed t)
                            (when (= depth 0)
                              (js-call host-failures :clear)
                              (funcall stop))))
                        undefined)))))
            (Object/defineProperty handle "byteLength"
              (js-object :get (lambda () (funcall active) (funcall exchange "size"))
                :enumerable t :configurable t))
            (Object/freeze handle))))))

  (export openNodeNativeMemory))
