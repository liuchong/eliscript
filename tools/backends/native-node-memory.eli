                       (unless (and (not (nullish? message)) (= (get message :id) id))
                         (throw (new globalThis.Error "native transport response belongs to a different invocation")))
                       (when (get message :error)
                         (throw (remoteFailure (get message :error))))
                       (when (not (undefined? (get message :lastError)))
                         (setq cached-last-error (get message :lastError)))
                       (get message :result)))
                   (finally
                     (setq depth (1- depth))
                     (when (and closed (= depth 0))
                       (js-call host-failures :clear)
                       (funcall stop))))))
               (flush-unadopted-pins (lambda (heap force)
                 (when (and (not stopped) (> unadopted-pin-total 0)
                            (or force (>= unadopted-pin-total 512)))
                   (let ((target-heap (if (and (Number/isFinite heap) (> heap 0)) heap last-pin-heap)))
                     (when (> target-heap 0)
                       (funcall invalidate-get-cache)
                       (let ((items (js-array)))
                         (js-call unadopted-pins :forEach (lambda (cnt raw)
                           (js-call items :push (if (= cnt 1) (str raw) (str raw ":" cnt)))))
                         (js-call unadopted-pins :clear)
                         (setq unadopted-pin-total 0)
                         (let ((start 0) (total (js-length items)))
                           (while (< start total)
                             (let ((end (Math/min (+ start 1024) total)))
                               (setq sequence (1+ sequence))
                               (funcall send-raw-and-wait sequence
                                 (str "U" sequence "\t" target-heap "\t" (js-call (js-call items :slice start end) :join ",")))
                               (setq start end))))))))))
