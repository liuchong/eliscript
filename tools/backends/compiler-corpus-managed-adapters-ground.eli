(module tools.backends.compiler-corpus-managed-adapters-ground
  (import "node:path" posix resolve)
  (import "node:url" pathToFileURL)
  (import "./build.mjs" loadLiteralSources)
  (import "node:crypto" createHash)
  (import "../testing/maintained-suite-source.mjs" rewriteSourceForms sourceCall sourceRuntimeFileImports)
  (import "../../dist/bootstrap/reader.mjs" read-string)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "./compiler-corpus-identity-value-adapters-ground.mjs" maintained-helper helper-transport helper-module-url source-head source-node-text source-node-proof)

  ;; These adapters retain original fixture algorithms and original host assertion
  ;; bodies. Their extra source only transports a selected artifact into those
  ;; bodies; the independent reference is always a separate Seed product.
  (defun between (source begin end &rest __opt)
    (let* ((from (aref __opt 0))
           (from-idx (if (undefined? from) 0 from))
           (start (js-call source :indexOf begin from-idx))
           (finish (if (< start 0) -1 (js-call source :indexOf end (+ start (js-length begin))))))
      (when (or (< start 0) (< finish 0))
        (throw (new globalThis.TypeError (str "original managed corpus source boundary changed: " begin))))
      (js-call source :slice start finish)))

  (defun template (source name)
    ;; Read only frozen static text, never evaluate a JavaScript expression.
    (let ((declaration (js-call (new globalThis.RegExp (str "const " name "\\s*=\\s*")) :exec source)))
      (unless declaration
        (throw (new globalThis.TypeError (str "original managed source declaration changed: " name))))
      (let* ((start (+ (get declaration :index) (js-length (aref declaration 0))))
             (tail (js-call source :slice start)))
        (if (= (aref tail 0) "`")
          (let ((finish (js-call tail :indexOf "`;" 1)))
            (when (< finish 0) (throw (new globalThis.TypeError "original managed source template is not closed")))
            (let ((text (js-call tail :slice 1 finish)))
              (when (or (js-call text :includes "${") (js-call text :includes "\\"))
                (throw (new globalThis.TypeError "original managed source template requires explicit escape transport"))) text))
          (let ((cursor 0) (parts (js-array)) (expect-value t) (depth 0) (done false))
            (while (and (< cursor (js-length tail)) (not done))
              (let ((ch (aref tail cursor)))
                (cond
                  ((js-call (new globalThis.RegExp "\\s") :test ch) (setq cursor (1+ cursor)))
                  ((and expect-value (= (js-call tail :slice cursor (+ cursor 7)) "String("))
                   (setq depth (1+ depth) cursor (+ cursor 7)))
                  ((and expect-value (= ch "(")) (setq depth (1+ depth) cursor (1+ cursor)))
                  ((and (not expect-value) (= ch ")") (> depth 0)) (setq depth (1- depth) cursor (1+ cursor)))
                  ((and expect-value (= ch "\""))
                   (let ((end (1+ cursor)) (escaped false) (closed false))
                     (while (and (< end (js-length tail)) (not closed))
                       (let ((next (aref tail end)))
                         (cond (escaped (setq escaped false)) ((= next "\\") (setq escaped t))
                               ((= next "\"") (setq closed t))))
                       (setq end (1+ end)))
                     (unless closed (throw (new globalThis.TypeError "original managed source string is not closed")))
                     (js-call parts :push (JSON/parse (js-call tail :slice cursor end)))
                     (setq cursor end expect-value false)))
                  ((and (not expect-value) (= ch "+")) (setq cursor (1+ cursor) expect-value t))
                  ((and (not expect-value) (= depth 0) (= ch ";")) (setq done t))
                  (t (throw (new globalThis.TypeError (str "original managed source declaration is not static text: " name)))))))
            (unless (and done (not expect-value) (= depth 0) (> (js-length parts) 0))
              (throw (new globalThis.TypeError (str "original managed source declaration changed: " name))))
            (js-call parts :join ""))))))

  (defasync maintained-source (options suite)
    (let* ((file (str (js-call suite :slice 0 -4) ".eli"))
           (source (await (funcall (get options :text) file))))
      (js-object :source source :nodes (get (aref (read-string source file) 0) :items))))

  (defun fixed-tail (input marker stop)
    ;; Search every original sibling group before rejecting a missing boundary.
    ;; Keep complete following forms, including their lexical scopes/assertions.
    (let ((pending (js-array (get input :nodes))) (found nil))
      (while (> (js-length pending) 0)
        (let ((siblings (js-call pending :shift)) (index 0))
          (while (< index (js-length siblings))
            (let* ((child (aref siblings index)) (items (get child :items)))
              (when (and (or (source-head child "assert")
                             (and (or (source-head child "js-call") (source-head child "funcall"))
                                  (= (get (aref items 1) :name) "assert")))
                         (js-call (source-node-text (get input :source) child) :includes marker))
                (when found (throw (new globalThis.TypeError "original semantic assertion boundary is ambiguous")))
                (let ((tail (js-call siblings :slice index)) (selected (js-array)) (done false))
                  (js-call tail :forEach (lambda (entry)
                    (let ((text (source-node-text (get input :source) entry)))
                      (when (and stop (js-call text :includes stop)) (setq done t))
                      (unless done (js-call selected :push text)))))
                  (setq found (js-call selected :join "\n"))))
              (when (Array/isArray items) (js-call pending :push items)))
            (setq index (1+ index)))))
      (unless found (throw (new globalThis.TypeError (str "original semantic assertion boundary changed: " marker))))
      found))

  (defun original-function (input name)
    (let ((matches (js-call (get input :nodes) :filter (lambda (node)
      (and (or (source-head node "defun") (source-head node "defasync"))
           (= (get (aref (get node :items) 1) :name) name))))))
      (unless (= (js-length matches) 1)
        (throw (new globalThis.TypeError (str "original managed helper changed: " name))))
      (source-node-text (get input :source) (aref matches 0))))

  (defun projected-callback (input title opening replacement name parameters)
    (let ((matches (js-call (get input :nodes) :filter (lambda (node)
      (and (source-head node "test") (= (get (aref (get node :items) 1) :value) title))))))
      (unless (= (js-length matches) 1)
        (throw (new globalThis.TypeError (str "original managed callback changed: " title))))
      (let* ((callback (aref (get (aref matches 0) :items) 2))
             (body (source-node-text (get input :source) callback)))
        (unless (= (js-length (js-call body :split opening)) 2)
          (throw (new globalThis.TypeError "original managed callback setup changed")))
        (str "(defun " name " (" parameters ") (funcall " (js-call body :replace opening replacement) "))"))))

  (defasync actual-host-script (options filename)
    (let* ((body (await (funcall (get options :text) filename)))
           (identity (await (funcall (get options :file) filename)))
           (source-file (str (js-call filename :slice 0 -4) ".eli"))
           (source (await (funcall (get options :text) source-file)))
           (source-identity (await (funcall (get options :file) source-file)))
           (artifact (js-call body :replace (new globalThis.RegExp "\\n?//# sourceMappingURL=[^\\r\\n]*\\r?\\n?$") "\n")))
      (unless (and (= (get identity :sha256) (js-call (js-call (createHash "sha256") :update body) :digest "hex"))
                   (= (get source-identity :sha256) (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
                   (= artifact (compile-string source source-file)))
        (throw (new globalThis.TypeError "original managed host differs from its source identity")))
      (js-call (sourceRuntimeFileImports (get options :sourceRoot) body) :replace
        (new globalThis.RegExp "(^import [^\\n;]*?from\\s+)([\"'])(\\.[^\"']+)\\2" "gm")
        (lambda (whole prefix quote specifier)
          (str prefix (JSON/stringify (get (pathToFileURL (resolve (get options :sourceRoot) (posix/dirname filename) specifier)) :href)))))))

  (defasync actual-host-assets (options filename)
    (let* ((source-file (str (js-call filename :slice 0 -4) ".eli"))
           (source (await (funcall (get options :file) source-file)))
           (artifact (await (funcall (get options :file) filename))))
      (js-array (js-object :file source-file :sourceSha256 (get source :sha256))
                (js-object :file filename :sourceSha256 (get artifact :sha256)))))

  (defun helper-plan (plan helper)
    (Object/assign (js-object) plan (js-object :maintainedSource (get helper :maintainedSource)
      :sourceAssets (get helper :sourceAssets) :helpersSha256 (get helper :helpersSha256))))

  (defun managed-host-prelude (source-root)
    (str "import assert from 'node:assert/strict';\nimport {readFile} from 'node:fs/promises';\n"
      "import {resolve} from 'node:path';\nimport {pathToFileURL} from 'node:url';\n"
      "import {spawnSync} from 'node:child_process';\nimport {createServer} from 'node:http';\n"
      "import {openOriginalManagedRuntime} from "
      (JSON/stringify (get (pathToFileURL (resolve source-root "tools/backends/compiler-corpus-identity-runtime.mjs")) :href)) ";\n"
      "const __managed_context = await openOriginalManagedRuntime();\n"
      "const {root,product,entry,reference,originalEntry,m,originalObservation,plain} = __managed_context;\n"
      "let {runtime,boundaryLowered,selectedInput} = __managed_context;\n"))

  (defun managed-scenario-call (options name arguments)
    (str "import {" name "} from "
      (JSON/stringify (get (pathToFileURL (resolve (get options :sourceRoot)
        "tools/backends/compiler-corpus-managed-scenarios.mjs")) :href))
      ";\nawait " name "(" arguments ");\n"))

  (defasync managed-runtime-assets (file)
    (let ((paths (js-array "tools/backends/eliscript/compiler-corpus-identity-runtime.eli"
                   "tools/backends/compiler-corpus-identity-runtime.mjs"
                   "tools/backends/eliscript/compiler-corpus-managed-observer.eli"
                   "tools/backends/compiler-corpus-managed-observer.mjs"
                   "tools/backends/eliscript/compiler-corpus-managed-scenarios.eli"
                   "tools/backends/compiler-corpus-managed-scenarios.mjs"
                   "tools/backends/compiler-host-record.eli" "tools/backends/compiler-host-record.mjs"
                   "tools/backends/compiler-host-iteration.eli" "tools/backends/compiler-host-iteration.mjs"))
          (assets (js-array)) (index 0))
      (while (< index (js-length paths))
        (let* ((filename (aref paths index)) (identity (await (funcall file filename))))
          (unless (and (= (get identity :file) filename) (= (value-type (get identity :sha256)) "string"))
            (throw (new globalThis.TypeError "original managed runtime source binding changed")))
          (js-call assets :push (js-object :file filename :sourceSha256 (get identity :sha256))))
        (setq index (1+ index))) assets))

  (defun bind-runtime-assets (original additional)
    (let ((result (if (Array/isArray original) (js-call original :slice) (js-array))) (index 0))
      (while (< index (js-length additional))
        (let* ((asset (aref additional index)) (existing (js-call result :find (lambda (item) (= (get item :file) (get asset :file))))))
          (if (undefined? existing) (js-call result :push asset)
            (unless (= (get existing :sourceSha256) (get asset :sourceSha256))
              (throw (new globalThis.TypeError "original managed runtime source binding changed")))))
        (setq index (1+ index))) result))

  (defasync graph (text initial)
    (let ((modules (new globalThis.Map))
          (pending (js-call initial :slice))
          (import-re (new globalThis.RegExp "\\(import(?:-portable)?\\s+\"([^\"\\n]+)\"" "g")))
      (while (> (js-length pending) 0)
        (let ((record (js-call pending :shift)))
          (unless (js-call modules :has (get record :id))
            (let ((source (let ((s (get record :source)))
                            (if (nullish? s) (await (funcall text (get record :filename))) s))))
              (js-call modules :set (get record :id)
                (js-object :id (get record :id) :filename (get record :filename) :source source))
              (let ((matches (Array/from (js-call source :matchAll import-re)))
                    (i 0))
                (while (< i (js-length matches))
                  (let ((specifier (aref (aref matches i) 1)))
                    (when (js-call specifier :startsWith ".")
                      (let ((target (js-call posix :normalize (js-call posix :join (js-call posix :dirname (get record :id)) specifier))))
                        (unless (js-call target :startsWith "runtime/")
                          (when (js-call target :startsWith "../")
                            (throw (new globalThis.TypeError "managed fixture import escapes its source graph")))
                          (let ((id (if (js-call target :endsWith ".eli") (str (js-call target :slice 0 -4) ".mjs") target)))
                            (unless (or (js-call modules :has id)
                                        (js-call pending :some (lambda (item) (= (get item :id) id))))
                              (js-call pending :push
                                (js-object
                                  :id id
                                  :filename (if (js-call target :endsWith ".mjs") (str (js-call target :slice 0 -4) ".eli") target)))))))))
                  (setq i (1+ i))))))))
      (Array/from (js-call modules :values))))

  (defasync addOriginalManagedLibraryAdapters (options)
    (let* ((add (get options :add))
           (locators (get options :locators))
           (text (get options :text))
           (file (get options :file))
           (stable-files (get options :stableFiles))
           (source-root (get options :sourceRoot))
           (common (managed-host-prelude source-root))
           (runtime-assets (await (managed-runtime-assets file)))
           (mapped (js-array))
           (literal-sources (await (loadLiteralSources (js-object :sourceRoot source-root))))
           (l-idx 0))
      (while (< l-idx (js-length literal-sources))
        (await (funcall file (get (aref literal-sources l-idx) :filename)))
        (setq l-idx (1+ l-idx)))
      (let ((add-program
              (async (plan host-source modules &rest __opt)
                (let* ((autos (aref __opt 0))
                       (auto-list (if (undefined? autos) (js-array 65536 1) autos))
                       (coverage
                         (if (js-call stable-files :has (get plan :fixture))
                           (js-array (str "stable-compatibility:" (get plan :fixture)))
                           (js-array)))
                       (suite-locs (js-call locators :filter (lambda (item) (= (get item :file) (get plan :suite)))))
                       (case-params (let ((p (get plan :caseParameters))) (if (nullish? p) (js-object) p)))
                       (case-titles (let ((t-arr (get plan :caseTitles))) (if (nullish? t-arr) (js-array) t-arr)))
                       (assertions (let ((a-arr (get plan :assertions))) (if (nullish? a-arr) (js-array) a-arr)))
                       (s-idx 0))
                  (while (< s-idx (js-length suite-locs))
                    (let* ((locator (aref suite-locs s-idx))
                           (orig-case (get locator :originalCase))
                           (skip
                             (and orig-case
                                  (js-call (Object/entries case-params) :some
                                    (lambda (pair)
                                      (/= (get (get orig-case :parameters) (aref pair 0)) (aref pair 1)))))))
                      (unless skip
                        (when (and (= (value-type (get locator :contains)) "string")
                                   (or (js-call host-source :includes (get locator :contains))
                                       (and (get plan :assertionSource)
                                            (js-call (get plan :assertionSource) :includes (get locator :contains)))
                                       (and orig-case
                                            (js-call case-titles :includes (get orig-case :templateTitle)))
                                       (js-call assertions :some (lambda (title) (= title (get locator :contains))))))
                          (js-call coverage :push (get locator :id)))))
                    (setq s-idx (1+ s-idx)))
                  (when (> (js-length coverage) 0)
                    (let ((original (await (funcall file (get plan :suite))))
                          (hosts (js-array "node" "bun"))
                          (a-idx 0))
                      (while (< a-idx (js-length auto-list))
                        (let ((auto (aref auto-list a-idx))
                              (h-idx 0))
                          (while (< h-idx (js-length hosts))
                            (let* ((host-runtime (aref hosts h-idx))
                                   (selected-coverage
                                     (js-call coverage :filter
                                       (lambda (id)
                                         (let* ((found (js-call locators :find (lambda (l) (= (get l :id) id))))
                                                (bound (if (nullish? found) undefined (get found :originalCase))))
                                           (or (not bound)
                                               (and (or (undefined? (get (get bound :parameters) :engine))
                                                        (= (get (get bound :parameters) :engine) host-runtime))
                                                    (or (undefined? (get (get bound :parameters) :auto))
                                                        (= (get (get bound :parameters) :auto) auto))
                                                    (or (undefined? (get bound :auto))
                                                        (= (get bound :auto) auto))))))))
                                   (exec-obj
                                     (js-object
                                       :kind "original-program"
                                       :host (str "tests/__eliscript_managed_" (get plan :name) "_" host-runtime "_" auto ".mjs")
                                       :hostSource (js-call host-source :replaceAll "__ELISCRIPT_ORIGINAL_HOST_RUNTIME__" (JSON/stringify host-runtime))
                                       :arguments (js-array (js-object :directory t) (js-object :literal (get plan :entry)))
                                       :hostRuntime host-runtime
                                       :aliases t
                                       :referenceArtifact t
                                       :zeroImports (/= (get plan :capabilityImports) t)
                                       :childProcesses "inherit-selected-artifact"
                                       :timeoutMs (let ((v (get plan :timeoutMs))) (if (nullish? v) 30000 v)))))
                              (when (undefined? (get plan :timeoutMs))
                                (put exec-obj :timeoutByTarget (js-object :javascript 30000 :wasm 30000 :native 120000)))
                              (put exec-obj :runtimeOptions
                                (globalThis.structuredClone
                                  (let ((v (get plan :budget)))
                                    (if (nullish? v) (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216) v))))
                              (funcall add
                                (js-object
                                  :id (str "original-managed:" (get plan :name) ":" host-runtime ":auto-" auto)
                                  :kind "project"
                                  :coverage selected-coverage
                                  :modules (globalThis.structuredClone modules)
                                  :entry (get plan :entry)
                                  :memory (globalThis.structuredClone
                                            (let ((v (get plan :memory)))
                                              (if (nullish? v) (js-object :initialPages 4 :maximumPages 1024) v)))
                                  :auto auto
                                  :request (js-object
                                             :operation "project"
                                             :resolveImports t
                                             :phased t
                                             :entries (js-call modules :map (lambda (item) (get item :id)))
                                             :sourceMap t)
                                  :execution exec-obj
                                  :expected (js-object :kind "seed-program" :oracleRequired t)
                                  :original
                                    (js-object
                                      :manifest "stable-compatibility"
                                      :fixture (get plan :fixture)
                                      :suite (get plan :suite)
                                      :sourceSha256 (get original :sha256)
                                      :maintainedSource (get plan :maintainedSource)
                                      :sourceAssets (bind-runtime-assets (get plan :sourceAssets) runtime-assets)
                                      :helpersSha256 (get plan :helpersSha256)
                                      :host (get plan :suite)
                                      :originalAssertion assertions
                                      :cases
                                        (js-call
                                          (js-call locators :filter
                                            (lambda (locator)
                                              (and (js-call selected-coverage :includes (get locator :id))
                                                   (get locator :originalCase))))
                                          :map (lambda (locator)
                                                 (Object/assign (js-object :id (get locator :id))
                                                   (globalThis.structuredClone (get locator :originalCase)))))
                                      :targetSpecificAssertions
                                        (js-object
                                          :javascript "original public observations; managed root/frame assertions apply only to real binary heaps"
                                          :binary "original raw checkAll and GC/frame assertions on the actual selected artifact")))))
                            (setq h-idx (1+ h-idx))))
                        (setq a-idx (1+ a-idx)))))))))
        ;; 1. core-modules
        (let ((core (js-object
                      :name "core-modules"
                      :fixture "tests/fixtures/wasm-managed-core-modules.eli"
                      :suite "tests/wasm-managed-core-modules.test.mjs"
                      :entry "tests/core-entry.mjs")))
          (when (js-call stable-files :has (get core :fixture))
            (let* ((source (await (funcall text (get core :suite))))
                   (alias-source (template source "aliasSource"))
                   (fixture
                     (js-call (await (funcall text (get core :fixture))) :replace
                       "  (export aliases"
                       "  (import \"./core-patterns.mjs\" :as Patterns)\n  (defun patterns () (Patterns/report))\n  (defun held-pattern () (Patterns/capture-pattern (js-array 17)))\n  (defun inspect-held-pattern (callback) (funcall callback))\n  (export patterns held-pattern inspect-held-pattern aliases"))
                   (modules
                     (await (graph text
                              (js-array
                                (js-object :id (get core :entry) :filename (get core :fixture) :source fixture)
                                (js-object :id "tests/core-aliases.mjs" :filename "tests/core-aliases.eli" :source alias-source)
                                (js-object :id "tests/core-patterns.mjs" :filename "tests/core-patterns.eli" :source (template source "patternSource"))
                                (js-object :id "tests/core-pattern-provider.mjs" :filename "tests/core-pattern-provider.eli" :source (template source "patternProvider"))))))
                   (input (await (maintained-source options (get core :suite))))
                   (fixed-eli (fixed-tail input "(get expected :aliases)" nil))
                   (helper (await (maintained-helper options (get core :suite)
                     (js-array "cases" "read" "invoke" "finish" "checkAll")
                     (str "(defvar expected nil) (defun bind-expected (value) (setq expected value))\n"
                          "(defun original-fixed-checks (expected) " fixed-eli ")")
                     (js-array "cases" "read" "invoke" "finish" "checkAll" "bind-expected" "original-fixed-checks"))))
                   (names (helper-transport helper "cases,read,invoke,finish,checkAll,bind_expected,original_fixed_checks"))
                   (raw "bind_expected(expected);original_fixed_checks(expected);\n")
                   (body (str common names
                     (managed-scenario-call options "runOriginalManagedCore"
                       "__managed_context,{cases,checkAll,bind_expected,original_fixed_checks}"))))
              (await (funcall add-program
                       (Object/assign (js-object) (helper-plan core helper)
                         (js-object :assertionSource (between source "test(\"Given original standard module imports" "test(\"Given no actual source library")))
                       body
                       modules))
              (let* ((code "(import \"eliscript/runtime/core/type.mjs\" defineType) (export defineType)")
                     (unrel-code "(import \"../vendor/core/vector.mjs\" PersistentVector) (export PersistentVector)")
                     (reject-coverage
                       (js-call
                         (js-call locators :filter
                           (lambda (item)
                             (and (= (get item :file) (get core :suite))
                                  (= (value-type (get item :contains)) "string")
                                  (js-call (get item :contains) :includes "no actual source library"))))
                         :map (lambda (item) (get item :id)))))
                (when (> (js-length reject-coverage) 0)
                  (funcall add
                    (js-object
                      :id "original-managed:core-modules:missing-private-graph"
                      :kind "sequence"
                      :coverage reject-coverage
                      :original
                        (js-object
                          :suite (get core :suite)
                          :completeLocatorCoverage t
                          :sourceSha256 (get (await (funcall file (get core :suite))) :sha256))
                      :expected (js-object :kind "sequence")
                      :steps
                        (js-array
                          (js-object
                            :id "empty-private-graph"
                            :request (js-object
                                       :operation "runtime"
                                       :source (await (funcall text "bootstrap/runtime/memory.eli"))
                                       :filename "runtime.eli"
                                       :literalSources (js-array)))
                          (js-object
                            :id "before-private-refusal"
                            :request (js-object :operation "compile-ir" :source code :filename "missing-core-library.eli"))
                          (js-object
                            :id "actual-private-refusal"
                            :backendTarget "wasm"
                            :request (js-object
                                       :operation "project"
                                       :modules (js-array (js-object :id (get core :entry) :filename "missing-core-library.eli" :source code))
                                       :entry (get core :entry)
                                       :resolveImports t)
                            :error (js-object :code "ELI-B0001"))
                          (js-object
                            :id "after-private-refusal"
                            :request (js-object :operation "compile-ir" :source code :filename "missing-core-library.eli")
                            :sameFieldsAs (js-object :step "before-private-refusal" :fields (js-array "ir")))
                          (js-object
                            :id "before-unrelated-refusal"
                            :request (js-object :operation "compile-ir" :source unrel-code :filename "unrelated-core-name.eli"))
                          (js-object
                            :id "unrelated-path-refusal"
                            :backendTarget "wasm"
                            :request (js-object
                                       :operation "project"
                                       :modules (js-array (js-object :id (get core :entry) :filename "unrelated-core-name.eli" :source unrel-code))
                                       :entry (get core :entry)
                                       :resolveImports t)
                            :error (js-object :code "ELI-B0001" :phase "managed-link"))
                          (js-object
                            :id "after-unrelated-refusal"
                            :request (js-object :operation "compile-ir" :source unrel-code :filename "unrelated-core-name.eli")
                            :sameFieldsAs (js-object :step "before-unrelated-refusal" :fields (js-array "ir")))
                          (js-object
                            :id "restore-complete-private-graph"
                            :request (js-object
                                       :operation "runtime"
                                       :source (await (funcall text "bootstrap/runtime/memory.eli"))
                                       :filename "runtime.eli"
                                       :literalSources (globalThis.structuredClone literal-sources)))))))))))
        ;; 2. transient-state
        (let ((transient (js-object
                           :name "transient-state"
                           :fixture "tests/fixtures/wasm-managed-transient-state.eli"
                           :suite "tests/wasm-managed-transient-state.test.mjs"
                           :entry "entry.mjs")))
          (when (js-call stable-files :has (get transient :fixture))
            (let* ((source (await (funcall text (get transient :suite))))
                   (modules (await (graph text (js-array (js-object :id (get transient :entry) :filename (get transient :fixture))))))
                   (input (await (maintained-source options (get transient :suite))))
                   (held-eli (projected-callback input
                     "Given a live edit state retained between exported calls when GC runs repeatedly then owner paths and source values remain rooted until persistent sealing"
                     "(instantiateManagedRuntime bytes options)" "instance" "verify-held" "instance"))
                   (helper (await (maintained-helper options (get transient :suite)
                     (js-array "counts" "read-val" "invoke" "finish" "check-all")
                     (str "(defvar expected nil) (defun bind-expected (value) (setq expected value))\n" held-eli)
                     (js-array "counts" "read-val" "invoke" "finish" "check-all" "verify-held" "bind-expected"))))
                   (counts (helper-transport helper "counts,read_val:read,invoke,finish,check_all:checkAll,verify_held:verifyHeld,bind_expected"))
                   (reference (await (actual-host-script options "tests/helpers/wasm-managed-transient-state-node.mjs")))
                   (raw "bind_expected(expected);\n")
                   (held "verifyHeld(runtime);")
                   (body (str common counts
                     (managed-scenario-call options "runOriginalManagedTransient"
                       (str "__managed_context,{counts,bind_expected,checkAll,verifyHeld}," (JSON/stringify reference))))))
              (await (funcall add-program
                       (Object/assign (js-object) (helper-plan transient helper)
                         (js-object :assertionSource (js-call source :slice (js-call source :indexOf "test(\"Given the complete transient state"))
                           :sourceAssets (bind-runtime-assets (get helper :sourceAssets)
                             (await (actual-host-assets options "tests/helpers/wasm-managed-transient-state-node.mjs")))))
                       body
                       modules)))))
        ;; 3. wire
        (let ((wire (js-object
                      :name "wire"
                      :fixture "tests/fixtures/wasm-managed-wire.eli"
                      :suite "tests/wasm-managed-wire.test.mjs"
                      :entry "tests/fixtures/wasm-managed-wire.mjs"
                      :timeoutMs 120000
                      :capabilityImports t)))
          (when (js-call stable-files :has (get wire :fixture))
            (let* ((source (await (funcall text (get wire :suite))))
                   (modules (await (graph text (js-array (js-object :id (get wire :entry) :filename (get wire :fixture))))))
                   (input (await (maintained-source options (get wire :suite))))
                   (runtime-root (get options :sourceRoot))
                   (oracle-file "tests/helpers/wasm-managed-wire-oracle.mjs")
                   (network-original (original-function input "check-network"))
                   (network-eli (get (rewriteSourceForms network-original (lambda (node node-text)
                     (let ((body (funcall node-text node)))
                       (cond
                         ((= body "(js-object :timeoutMs 3000)") "(wireNetworkOptions)")
                         ((= body "(new globalThis.Promise (lambda (res) (js-call server :listen 0 \"127.0.0.1\" res)))")
                          "(wireNetworkListen server)")
                         (t undefined))))) :source))
                   (javascript-network-projection (get (rewriteSourceForms network-eli (lambda (node node-text)
                     (cond
                       ((sourceCall node "target-http") "platform")
                       ((and (sourceCall node "call-sync") (= (get (aref (get node :items) 2) :value) "original-roundtrip"))
                        "(js-call m :original_roundtrip (JSON/stringify original-payload))")
                       ((and (sourceCall node "call-async") (= (get (aref (get node :items) 2) :value) "original-echo"))
                        "(js-call m :original_echo (str origin \"/rpc/echo\") (JSON/stringify payload))")
                       ((and (sourceCall node "js-call") (= (get (aref (get node :items) 1) :name) "assert")
                             (js-call (funcall node-text node) :includes "(js-call runtime :stats)")) "nil")
                       (t undefined)))) :source))
                   (javascript-network (js-call javascript-network-projection :replace
                     "(defasync check-network (runtime)" "(defasync check-javascript-network (m platform)"))
                   (fixed-eli (fixed-tail input "js-length roundtrips" "((payload"))
                   (helper (await (maintained-helper options (get wire :suite)
                     (js-array "options" "entry" "sources" "finish" "pin-arguments" "call-sync" "call-async" "host-call" "target-http" "check-corpus" "platform-options" (js-object :name "check-network" :replacement network-eli))
                     (str "(import \"node:buffer\" Buffer) (import \"node:http\" createServer)\n"
                       "(import " (JSON/stringify (get (pathToFileURL (resolve runtime-root "tools/testing/wire-call-cases.mjs")) :href)) " wireNetworkOptions wireNetworkListen)\n"
                       "(import " (JSON/stringify (get (pathToFileURL (resolve runtime-root "platform/http.mjs")) :href)) " :as http-platform)\n"
                       "(import " (JSON/stringify (get (pathToFileURL (resolve runtime-root oracle-file)) :href))
                       " roundtrips parse-cases original-error-codes cases httpContracts)\n"
                       "(defvar expected nil) (defun bind-expected (value) (setq expected value))\n"
                       "(defun original-fixed-checks (expected) " fixed-eli ")\n" javascript-network)
                     (js-array "roundtrips" "parse-cases" "original-error-codes" "cases" "httpContracts" "finish" "call-sync" "target-http" "check-corpus" "check-network" "check-javascript-network" "bind-expected" "original-fixed-checks"))))
                   (corpus (helper-transport helper "roundtrips,parse_cases:parseCases,original_error_codes:originalErrorCodes,cases,httpContracts,finish,call_sync:call,target_http:targetHTTP,check_corpus:checkCorpus,check_network:checkNetwork,check_javascript_network:checkJavaScriptNetwork,bind_expected,original_fixed_checks"))
                   (helpers "")
                   (network "")
                   (assertions "bind_expected(expected);original_fixed_checks(expected);\n")
                   (oracle-source (await (actual-host-script options oracle-file)))
                   (capability-proof (managed-scenario-call options "verifyOriginalWireCapabilities" "__managed_context"))
                   (body (str common capability-proof corpus
                     (managed-scenario-call options "runOriginalManagedWire"
                       (str "__managed_context,{cases,httpContracts,bind_expected,original_fixed_checks,checkCorpus,checkNetwork,checkJavaScriptNetwork,call,targetHTTP},"
                         (JSON/stringify oracle-source))))))
              (await (funcall add-program
                       (Object/assign (js-object) (helper-plan wire helper)
                         (js-object
                           :sourceAssets (bind-runtime-assets (get helper :sourceAssets) (await (actual-host-assets options oracle-file)))
                           :caseTitles (js-array "Given complete original wire corpus and actual HTTP capabilities when WASM executes MDP MDS and GEPO at auto(${auto}) then independent Node and Bun observations and cleanup agree")
                           :assertionSource (js-call source :slice (js-call source :indexOf "Given complete original wire corpus and actual HTTP capabilities"))))
                       body
                       modules))
              (let ((original-host (await (actual-host-script options "tests/fixtures/wire-host.mjs"))))
                (await (funcall add-program
                         (Object/assign (js-object) wire (js-object :name "wire-original-host"
                           :sourceAssets (await (actual-host-assets options "tests/fixtures/wire-host.mjs"))))
                         (str common capability-proof
                           (managed-scenario-call options "runOriginalWireHost"
                             (str "__managed_context," (JSON/stringify original-host) ",__ELISCRIPT_ORIGINAL_HOST_RUNTIME__")))
                         modules))))))
        ;; 4. sequence-data
        (let ((sequence (js-object
                          :name "sequence-data"
                          :fixture "tests/fixtures/wasm-managed-sequence-data.eli"
                          :suite "tests/wasm-managed-sequence-data.test.mjs"
                          :entry "sequence-data.mjs"
                          :memory (js-object :initialPages 128 :maximumPages 4096)
                          :budget (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)
                          :timeoutMs 60000)))
          (when (js-call stable-files :has (get sequence :fixture))
            (let* ((source (await (funcall text "tests/wasm-managed-sequence-data-test-ground.mjs")))
                   (public-modules (new globalThis.Map))
                   (initial
                     (js-array
                       (js-object :id (get sequence :entry) :filename (get sequence :fixture))
                       (js-object :id "tests/fixtures/lazy-sequence.mjs" :filename "tests/fixtures/lazy-sequence.eli")
                       (js-object :id "core-set-usage.mjs" :filename "tests/fixtures/core-set-usage.eli")))
                   (rt-re (new globalThis.RegExp "^runtime/(?:core|testing)/.+[.]mjs$"))
                   (exp-re (new globalThis.RegExp "\\(export\\s+([^()]*)\\)" "g"))
                   (ws-re (new globalThis.RegExp "\\s+"))
                   (rt-records (js-call literal-sources :filter (lambda (item) (js-call rt-re :test (get item :id)))))
                   (r-idx 0))
              ;; Export names are read from the actual canonical source declarations.
              ;; These generated project cells contain imports/re-exports only.
              (while (< r-idx (js-length rt-records))
                (let* ((record (aref rt-records r-idx))
                       (names (js-array))
                       (matches (Array/from (js-call (get record :source) :matchAll exp-re)))
                       (m-idx 0))
                  (while (< m-idx (js-length matches))
                    (let ((parts
                            (js-call
                              (js-call (js-call (aref (aref matches m-idx) 1) :trim) :split ws-re)
                              :filter (lambda (s) (> (js-length s) 0)))))
                      (Reflect/apply (get names :push) names parts))
                    (setq m-idx (1+ m-idx)))
                  (when (= (js-length names) 0)
                    (throw (new globalThis.TypeError (str "actual canonical library has no export declaration: " (get record :id)))))
                  (let ((id (str "public/" (get record :id))))
                    (js-call public-modules :set (get record :id) id)
                    (js-call initial :push
                      (js-object
                        :id id
                        :filename (str "sequence-data-public/" (get record :id))
                        :source (str "(import " (JSON/stringify (str "eliscript/" (get record :id))) " "
                                     (js-call names :join " ") ")\n(export " (js-call names :join " ") ")\n")))))
                (setq r-idx (1+ r-idx)))
              (let ((families (js-array "sequence" "text" "object"))
                    (f-idx 0))
                (while (< f-idx (js-length families))
                  (let ((family (aref families f-idx)))
                    (js-call initial :push
                      (js-object :id (str family ".mjs") :filename (str "stdlib/" family ".eli"))
                      (js-object :id (str family "-usage.mjs") :filename (str "tests/fixtures/" family "-usage.eli")))
                    (when (= family "object")
                      (js-call initial :push
                        (js-object :id "data.mjs" :filename "stdlib/data.eli"))))
                  (setq f-idx (1+ f-idx))))
              (let* ((modules (await (graph text initial)))
                     (sequence-suite "tests/wasm-managed-sequence-data-test-ground.mjs")
                     (input (await (maintained-source options sequence-suite)))
                     (helper (await (maintained-helper options sequence-suite (js-array "observations")
                       (str "(defun original-fixed-checks (actual) " (fixed-tail input "(get actual :bounded_consumption)" nil) ")")
                       (js-array "observations" "original-fixed-checks"))))
                     (observation-helper (await (maintained-helper options "tests/helpers/wasm-managed-sequence-data-ground-node.mjs"
                       (js-array "js-typeof" "observation-json") "" (js-array "observation-json"))))
                     (names (helper-transport helper "observations,original_fixed_checks"))
                     (observation (helper-transport observation-helper "observation_json:observationJSON"))
                     (fixed "original_fixed_checks(actual);\n")
                     (boundary-body (str common names observation
                       (managed-scenario-call options "runOriginalManagedSequence"
                         (str "__managed_context,{observations,original_fixed_checks},{observationJSON,url:"
                           (JSON/stringify (helper-module-url (get observation-helper :javascript))) "}")))))
                (await (funcall add-program
                         (Object/assign (js-object) (helper-plan sequence helper)
                           (js-object
                             :caseTitles (js-array "${host}/${engine}: internal infinite, cache, close, metadata, paths, metrics and IEEE observations")
                             :assertions (js-array "internal infinite, cache, close, metadata, paths, metrics and IEEE observations")))
                         boundary-body
                         modules
                         (js-array 65536)))
                (let ((replacements (JSON/stringify (Array/from public-modules)))
                      (host-names (js-array "transducer" "core-stdlib" "data-text" "value-hash" "lazy-sequence" "core-text-object"))
                      (hn-idx 0))
                  (while (< hn-idx (js-length host-names))
                    (let* ((name (aref host-names hn-idx))
                           (filename (str "tests/fixtures/" name "-host.mjs"))
                           (original (await (funcall text filename)))
                           (argument-ids
                             (if (= name "lazy-sequence")
                               (js-array "tests/fixtures/lazy-sequence.mjs")
                               (if (= name "core-text-object")
                                 (js-array "public/runtime/core/text.mjs" "public/runtime/core/object.mjs")
                                 (js-array))))
                           (body (str common
                             (managed-scenario-call options "runOriginalSequenceHost"
                               (str "__managed_context," (JSON/stringify original) "," replacements "," (JSON/stringify argument-ids)
                                 "," (JSON/stringify name) ",__ELISCRIPT_ORIGINAL_HOST_RUNTIME__"))))
                           (plan-ext
                             (Object/assign (js-object) sequence
                               (js-object
                                 :name (str "sequence-data-host-" name)
                                 :caseTitles
                                   (js-array
                                     (if (= name "lazy-sequence")
                                       "${host}/${engine}: complete original compiled lazy-sequence fixture"
                                       (if (= name "core-text-object")
                                         "${host}/${engine}: complete original core text/object host corpus"
                                         "${host}/${engine}: complete original ${name} host corpus")))
                                 :assertions
                                   (js-array
                                     (if (= name "lazy-sequence")
                                       "complete original compiled lazy-sequence fixture"
                                       (if (= name "core-text-object")
                                         "complete original core text/object host corpus"
                                         (str "complete original " name " host corpus"))))))))
                      (unless (or (= name "lazy-sequence") (= name "core-text-object"))
                        (put plan-ext :caseParameters (js-object :name name)))
                      (await (funcall add-program plan-ext body modules (js-array 65536))))
                    (setq hn-idx (1+ hn-idx))))
                (let ((families (js-array "sequence" "text" "object"))
                      (pf-idx 0))
                  (while (< pf-idx (js-length families))
                    (let* ((family (aref families pf-idx))
                           (id (str family "-usage.mjs")))
                      (await (funcall add-program
                               (Object/assign (js-object) sequence
                                 (js-object
                                   :name (str "sequence-data-portable-" family)
                                   :caseParameters (js-object :family family)
                                   :caseTitles (js-array "${host}/${engine}: entire original portable ${family} usage")
                                   :assertions (js-array (str "entire original portable " family " usage"))))
                               (str common
                                 (managed-scenario-call options "runOriginalSequenceUsage"
                                   (str "__managed_context," (JSON/stringify id) ",__ELISCRIPT_ORIGINAL_HOST_RUNTIME__")))
                               modules
                               (js-array 65536))))
                    (setq pf-idx (1+ pf-idx))))
                (let ((set-host (await (actual-host-script options "tests/fixtures/core-set-usage-host.mjs"))))
                    (await (funcall add-program
                             (Object/assign (js-object) sequence
                               (js-object
                                 :name "sequence-data-relational-set"
                                 :sourceAssets (await (actual-host-assets options "tests/fixtures/core-set-usage-host.mjs"))
                                 :caseTitles (js-array "${host}/${engine}: original relational set complete usage and host observations")
                                 :assertions (js-array "original relational set complete usage and host observations")))
                             (str common
                               (managed-scenario-call options "runOriginalRelationalSet"
                                 (str "__managed_context," (JSON/stringify set-host) ",__ELISCRIPT_ORIGINAL_HOST_RUNTIME__")))
                             modules
                             (js-array 65536))))
                (let* ((helper-file "tests/helpers/wasm-managed-sequence-data-ground-node.mjs")
                       (runtime-root (get options :sourceRoot))
                       (identity-helper (await (maintained-helper options helper-file
                         (js-array "dyn-import" "run-standard-protocols")
                         (str "(import \"node:url\" pathToFileURL)\n"
                           "(import " (JSON/stringify (get (pathToFileURL (resolve runtime-root "runtime/core/data-text.mjs")) :href)) " IPrint printValue)\n"
                           "(import " (JSON/stringify (get (pathToFileURL (resolve runtime-root "runtime/core/order.mjs")) :href)) " IComparable compareValues)\n"
                           "(import " (JSON/stringify (get (pathToFileURL (resolve runtime-root "runtime/core/protocol.mjs")) :href)) " protocolSlot protocolMethod isProtocol)\n")
                         (js-array "run-standard-protocols"))))
                       (identity-source (str (helper-transport identity-helper "run_standard_protocols")
                         "await run_standard_protocols(process.argv[2]);\n")))
                  (await (funcall add-program
                           (Object/assign (js-object) sequence
                             (js-object
                               :name "sequence-data-standard-identities"
                               :caseTitles (js-array "${host}/${engine}: standard print/compare slots keep identity in both boundary directions")
                               :assertions (js-array "standard print/compare slots keep identity in both boundary directions")))
                           (str common
                             (managed-scenario-call options "runOriginalStandardIdentities"
                               (str "__managed_context," (JSON/stringify (helper-module-url identity-source)))))
                           modules
                           (js-array 65536))))))))
        mapped)))

  (export addOriginalManagedLibraryAdapters template))
