              (ground nil))
          (setq ground (lambda (record)
                         (if (or (nil? record) (not (= (host-type record) "object")))
                           record
                           (if (js-call records :has record)
                             (js-call records :get record)
                             (let* ((constructor (if (js-call globalThis.Object :hasOwn constructors (get record :name))
                                                   (get constructors (get record :name)) globalThis.Error))
                                    (message (get record :message "compiler worker failed"))
                                    (error (if (= constructor globalThis.AggregateError)
                                             (new constructor (js-array) message)
                                             (new constructor message)))
                                    (field-index 0))
                               (js-call records :set record error)
                               (put error :name (get record :name "Error"))
                               (when (= (host-type (get record :stack)) "string")
                                 (js-call globalThis.Object :defineProperty error "stack"
                                   (js-object :value (get record :stack) :configurable t :writable t)))
                               (while (< field-index (js-length legacy-error-fields))
                                 (let ((name (aref legacy-error-fields field-index)))
                                   (when (js-call globalThis.Object :hasOwn record name)
                                     (put error name (get record name))))
                                 (setq field-index (1+ field-index)))
                               (when (js-call globalThis.Object :hasOwn record "cause")
                                 (put error :cause (funcall ground (get record :cause))))
                               error)))))
          (funcall ground value)))))

  (defun errorData (error &rest supplied)
    (let* ((options (input-or supplied))
           (transport (defined-or options "transport" "structured-clone"))
           (state (js-object :nodes (js-array) :seen (new globalThis.Map) :transport transport
                    :typedArrays (new globalThis.Set typed-array-names))))
      (try
        (unless (js-call (js-array "structured-clone" "json") :includes transport)
          (throw (failure-at "$" "unknown exception transport")))
        (let* ((root (visit-error state error "$"))
               (nodes (get state :nodes))
               (graph (js-object :format "eliscript-worker-error-value" :version 1 :root root :nodes nodes))
               (ground (fromErrorData (js-object :errorValue graph) t))
               (is-error (and (js-call globalThis.Object :hasOwn root "ref")
                              (= (get (aref nodes (get root :ref)) :type) "error")))
               (result (js-object
                         :name (if is-error (get (aref nodes (get root :ref)) :name) "Error")
                         :message (if is-error (get (aref nodes (get root :ref)) :message)
                                    (if (= (host-type error) "string") error
                                      "compiler worker threw a non-Error value")))))
          (if is-error
            (progn
              (when (= (host-type (get ground :stack)) "string")
                (put result :stack (get ground :stack)))
              (if (= transport "structured-clone")
                (let ((field-index 0))
                  (while (< field-index (js-length public-error-fields))
                    (let ((key (aref public-error-fields field-index)))
                      (when (js-call globalThis.Object :hasOwn ground key)
                        (put result key (get ground key))))
                    (setq field-index (1+ field-index)))
                  (put result :diagnostics
                    (if (Array/isArray (get ground :diagnostics)) (get ground :diagnostics)
                      (if (host-truthy (get ground :eliscriptDiagnostic))
                        (js-array (get ground :eliscriptDiagnostic)) (js-array)))))
                (progn
                  (when (= (host-type (get ground :code)) "string")
                    (put result :code (get ground :code)))
                  (put result :diagnostics (js-array)))))
            (put result :diagnostics (js-array)))
          (put result :errorValue graph)
          result)
        (catch cause
          (let ((result (js-object :name "CompilerWorkerError" :code "uncloneable-error-cause"
                          :message "compiler worker could not transport the original exception"
                          :diagnostics (js-array))))
            (when (= (host-type (host-get cause "message")) "string")
              (put result :message (str (get result :message) ": " (get cause :message))))
            (when (= (host-type (host-get cause "path")) "string")
              (put result :transportPath (get cause :path)))
            (when (= (host-type (host-get cause "stack")) "string")
              (put result :stack (get cause :stack)))
            result)))))

  (defun activeSource (records request message)
    (let ((key (sourceKey request)))
      (unless (nil? key)
        (let ((current (js-call records :get key)))
          (when (or (not current) (not (= (get current :revision) (revision (get message :revision))))
                    (not (= (get current :sourceIdentity) (get message :sourceIdentity))))
            (throw (transportError "stale-source" "compiler request does not match the current source revision and identity")))
          (when (or (and (not (undefined? (get message :expectedRevision)))
                         (not (= (revision (get message :expectedRevision)) (get current :revision))))
                    (and (not (undefined? (get message :expectedSourceIdentity)))
                         (not (= (get message :expectedSourceIdentity) (get current :sourceIdentity)))))
            (throw (transportError "stale-source" "edit or query belongs to an older source snapshot")))))))

  (defun same-reply (message request)
    (and (= (get message :version) compilerWorkerVersion)
         (= (get message :requestIdentity) (get request :requestIdentity))
         (= (get message :sourceIdentity) (get request :sourceIdentity))
         (= (get message :revision) (get request :revision))))

  (defun reject-pending (state error)
    (js-call (get state :pending) :forEach
      (lambda (entry)
        (when (not (nullish? (get entry :removeAbort))) (funcall (get entry :removeAbort)))
        (funcall (get entry :reject) error)))
    (js-call (get state :pending) :clear))

  (defun detach-client (state)
    (let ((worker (get state :worker)))
      (js-call worker :removeEventListener "message" (get state :receive))
      (js-call worker :removeEventListener "error" (get state :failed))
      (js-call worker :removeEventListener "messageerror" (get state :failed))))

  (defun terminate-owned (state)
    (when (and (get state :ownsWorker) (not (get state :terminated)))
      (put state :terminated t)
      (put state :terminationResult (js-call (get state :worker) :terminate)))
    (get state :terminationResult))

  (defun client-failed (state event)
    (put state :terminalError
      (get event :error (transportError "worker-failed"
                          (get event :message "compiler worker transport failed"))))
    (put state :closed t)
    (js-call (get state :records) :clear)
    (js-call (get state :posted) :clear)
    (reject-pending state (get state :terminalError))
    (detach-client state)
    (terminate-owned state))

  (defun client-receive (state event)
    (let ((message (get event :data (js-object))))
      (when (= (get message :type) "result")
        (let ((work (js-call (get state :posted) :get (get message :id))))
          (when (and work (same-reply message work))
            (js-call (get state :posted) :delete (get message :id))))
        (let ((entry (js-call (get state :pending) :get (get message :id))))
          (when entry
            (js-call (get state :pending) :delete (get message :id))
            (when (not (nullish? (get entry :removeAbort))) (funcall (get entry :removeAbort)))
            (if (not (same-reply message (get entry :message)))
              (funcall (get entry :reject)
                (transportError "stale-response" "compiler response belongs to a different request or source"))
              (if (and (not (nil? (get entry :key)))
                       (let ((current (js-call (get state :records) :get (get entry :key))))
                         (or (not current)
                             (not (= (get current :revision) (get message :revision)))
                             (not (= (get current :sourceIdentity) (get message :sourceIdentity))))))
                (funcall (get entry :reject)
                  (transportError "stale-response" "compiler response is older than the current source"))
                (if (get message :ok)
                  (funcall (get entry :resolve)
                    (if (= (get (get entry :message) :type) "request")
                      (js-call globalThis.Object :freeze
                        (js-call globalThis.Object :assign (js-object) (metadata message)
                          (js-object :host (get message :host) :result (get message :result))))
                      (get message :result)))
                  (try
                    (funcall (get entry :reject) (fromErrorData (get message :error message) false))
                    (catch error (funcall (get entry :reject) error)))))))))))

  (defun client-send (state message key signal)
    (when (not (undefined? (get state :terminalError)))
      (throw (get state :terminalError)))
    (when (and (get state :closed) (not (= (get message :type) "shutdown")))
      (throw (transportError "closed" "compiler worker client is closed")))
    (when (>= (get state :counter) (get globalThis.Number :MAX_SAFE_INTEGER))
      (throw (transportError "request-id-exhausted" "compiler request id space exhausted")))
    (put state :counter (1+ (get state :counter)))
    (put message :id (get state :counter))
    (new globalThis.Promise
      (lambda (resolve-promise reject-promise)
        (let ((entry (js-object :message message :key key :resolve resolve-promise :reject reject-promise))
              (abort nil))
          (js-call (get state :pending) :set (get message :id) entry)
          (setq abort (lambda ()
                        (when (js-call (get state :pending) :delete (get message :id))
                          (when (not (nullish? (get entry :removeAbort))) (funcall (get entry :removeAbort)))
                          (funcall reject-promise (abortError signal))
                          (when (js-call (get state :posted) :has (get message :id))
                            (try
                              (js-call (get state :worker) :postMessage
                                (js-object :version compilerWorkerVersion :type "cancel" :id (get message :id)))
                              (catch ignored))))))
          (let ((stop nil))
            (when (not (undefined? signal))
              (if (or (not (host-truthy signal))
                      (not (= (host-type (get signal :addEventListener)) "function"))
                      (not (= (host-type (get signal :aborted)) "boolean")))
                (progn
                  (js-call (get state :pending) :delete (get message :id))
                  (funcall reject-promise (new globalThis.TypeError "compiler request requires an AbortSignal"))
                  (setq stop t))
                (progn
                  (js-call signal :addEventListener "abort" abort (js-object :once t))
                  (put entry :removeAbort (lambda () (js-call signal :removeEventListener "abort" abort)))
                  (when (get signal :aborted)
                    (funcall abort)
                    (setq stop t)))))
            (unless stop
          (try
            (when (not (undefined? (get state :terminalError)))
              (throw (get state :terminalError)))
            (when (and (get state :closed) (not (= (get message :type) "shutdown")))
              (throw (transportError "closed" "compiler worker client is closed")))
            (when (or (= (get message :type) "request") (= (get message :type) "source"))
              (js-call (get state :posted) :set (get message :id)
                (js-object :version (get message :version) :requestIdentity (get message :requestIdentity)
                  :sourceIdentity (get message :sourceIdentity) :revision (get message :revision))))
            (js-call (get state :worker) :postMessage message)
            (catch error
              (js-call (get state :posted) :delete (get message :id))
              (js-call (get state :pending) :delete (get message :id))
              (when (not (nullish? (get entry :removeAbort))) (funcall (get entry :removeAbort)))
              (funcall reject-promise error)))))))))

  (defasync client-envelope (payload kind selected-revision)
    (let* ((request (encode payload))
           (parsed (decode request)))
      (js-object :version compilerWorkerVersion :type kind :request request :revision selected-revision
        :requestIdentity (await (compilerRequestIdentity request))
        :sourceIdentity (await (compilerSourceIdentity parsed)))))

  (defun createCompilerWorkerClient (worker &rest supplied)
    (let ((options (input-or supplied)))
      (when (or (not (host-truthy worker))
                (not (= (host-type (get worker :postMessage)) "function"))
                (not (= (host-type (get worker :addEventListener)) "function")))
        (throw (new globalThis.TypeError "compiler client requires a Worker")))
      (let ((state (js-object :worker worker :ownsWorker (defined-or options "ownsWorker" false)
                     :pending (new globalThis.Map) :records (new globalThis.Map) :posted (new globalThis.Map)
                     :counter 0 :closed false :closing nil :terminated false :terminationResult nil
                     :terminalError undefined :receive nil :failed nil)))
        (put state :failed (lambda (event) (client-failed state event)))
        (put state :receive (lambda (event) (client-receive state event)))
        (js-call worker :addEventListener "message" (get state :receive))
        (js-call worker :addEventListener "error" (get state :failed))
        (js-call worker :addEventListener "messageerror" (get state :failed))
        (js-call globalThis.Object :freeze
          (js-object
            :setSource (async (snapshot &rest args)
                         (let* ((call (input-or args))
                                (next-revision (get call :revision))
                                (signal (get call :signal)))
                           (when (get state :closed)
                             (throw (transportError "closed" "compiler worker client is closed")))
                           (let* ((message (await (client-envelope snapshot "source" (revision next-revision))))
                                  (key (sourceKey (decode (get message :request)))))
                             (when (get state :closed)
                               (throw (transportError "closed" "compiler worker client is closed")))
                             (when (nil? key)
                               (throw (transportError "invalid-source" "source update requires source text or project modules")))
                             (let ((previous (js-call (get state :records) :get key))
                                   (next (js-object :revision (get message :revision)
                                           :sourceIdentity (get message :sourceIdentity))))
                               (when (and previous
                                          (or (< (get next :revision) (get previous :revision))
                                              (and (= (get next :revision) (get previous :revision))
                                                   (not (= (get next :sourceIdentity) (get previous :sourceIdentity))))))
                                 (throw (transportError "stale-source" "source update belongs to an older revision")))
                               (js-call (get state :records) :set key next)
                               (try
                                 (await (client-send state message key signal))
                                 (catch error
                                   (when (and (not (get state :closed))
                                              (= (js-call (get state :records) :get key) next))
                                     (if previous
                                       (js-call (get state :records) :set key previous)
                                       (js-call (get state :records) :delete key)))
                                   (throw error)))))))
            :request (async (payload &rest args)
                       (let* ((call (input-or args))
                              (signal (get call :signal))
                              (expected-revision (get call :expectedRevision))
                              (expected-source (get call :expectedSourceIdentity)))
                         (when (get state :closed)
                           (throw (transportError "closed" "compiler worker client is closed")))
                         (let* ((text (encode payload))
                                (parsed (decode text))
                                (key (sourceKey parsed))
                                (current (if (nil? key) nil (js-call (get state :records) :get key))))
                           (when (and (not (nil? key)) (not current))
                             (throw (transportError "stale-source" "register the source snapshot before requesting compilation or queries")))
                           (let ((message (await (client-envelope text "request" (host-get current "revision")))))
                             (when (get state :closed)
                               (throw (transportError "closed" "compiler worker client is closed")))
                             (when (and (not (nil? key)) (not (= (js-call (get state :records) :get key) current)))
                               (throw (transportError "stale-source" "source changed before compiler request dispatch")))
                             (when (and current
                                        (or (not (= (get message :sourceIdentity) (get current :sourceIdentity)))
                                            (and (not (undefined? expected-revision))
                                                 (not (= (revision expected-revision) (get current :revision))))
                                            (and (not (undefined? expected-source))
                                                 (not (= expected-source (get current :sourceIdentity))))))
                               (throw (transportError "stale-source" "edit or request belongs to an older source snapshot")))
                             (put message :expectedRevision expected-revision)
                             (put message :expectedSourceIdentity expected-source)
                             (client-send state message key signal)))))
            :close (lambda ()
                     (if (get state :closing)
                       (get state :closing)
                       (if (get state :closed)
                         (js-call globalThis.Promise :resolve)
                         (progn
                           (put state :closed t)
                           (let ((busy (not (= (get (get state :posted) :size) 0))))
                             (reject-pending state (transportError "closed" "compiler worker client is closed"))
                             (js-call (get state :records) :clear)
                             (if (and (get state :ownsWorker) busy)
                               (let ((complete nil) (fail nil))
                                 (js-call (get state :posted) :clear)
                                 (detach-client state)
                                 (put state :closing
                                   (new globalThis.Promise (lambda (resolve-promise reject-promise)
                                                              (setq complete resolve-promise)
                                                              (setq fail reject-promise))))
                                 (try
                                   (js-call (js-call globalThis.Promise :resolve (terminate-owned state)) :then complete fail)
                                   (catch error (funcall fail error)))
                                 (get state :closing))
                               (progn
                                 (put state :closing
                                   (js-call
                                     (js-call (js-call globalThis.Promise :resolve) :then
                                       (lambda ()
                                         (client-send state
                                           (js-object :version compilerWorkerVersion :type "shutdown") nil)))
                                     :finally
                                     (lambda ()
                                       (js-call (get state :posted) :clear)
                                       (detach-client state)
                                       (terminate-owned state))))
                                 (get state :closing)))))))))))))

  (defasync installCompilerWorker (scope configuration)
    (unless (and (host-truthy scope)
                 (= (host-type (get scope :addEventListener)) "function")
                 (= (host-type (get scope :postMessage)) "function"))
      (throw (new globalThis.TypeError "compiler worker requires a message scope")))
    (let* ((records (new globalThis.Map)) (pending (new globalThis.Map)) (queue (js-array))
           (session undefined) (closed false) (draining false) (last-id 0)
           (opening (createCompilerSession configuration))
           (identity (new globalThis.RegExp identity-pattern))
           (reply nil) (validate nil) (drain nil) (close nil) (receive nil))
      (setq reply (lambda (message fields)
                    (js-call scope :postMessage
                      (js-call globalThis.Object :assign (js-object) (metadata message)
                        (js-object :host (if (nullish? session) undefined (get session :host)) :type "result") fields))))
      (setq validate (async (message)
                       (unless (= (get message :version) compilerWorkerVersion)
                         (throw (transportError "version-mismatch" "compiler worker protocol version 1 required")))
                       (unless (and (js-call identity :test (get message :requestIdentity ""))
                                    (js-call identity :test (get message :sourceIdentity ""))
                                    (= (host-type (get message :request)) "string"))
                         (throw (transportError "invalid-identity" "compiler request requires request and source identities")))
                       (unless (and (= (await (compilerRequestIdentity (get message :request))) (get message :requestIdentity))
                                    (= (await (compilerSourceIdentity (get message :request))) (get message :sourceIdentity)))
                         (throw (transportError "stale-source" "compiler request identity differs from its transported source")))
                       (decode (get message :request))))
      (setq drain (async ()
                    (unless draining
                      (setq draining t)
                      (try
                        (when (nullish? session) (setq session (await opening)))
                        (while (and (not closed) (> (js-length queue) 0))
                          (let* ((entry (js-call queue :shift))
                                 (message (get entry :message))
                                 (signal (get (get entry :controller) :signal)))
                            (try
                              (let ((request (await (funcall validate message))))
                                (when (or closed (get signal :aborted)) (throw (abortError signal)))
                                (if (= (get message :type) "source")
                                  (let* ((key (sourceKey request))
                                         (next (js-object :revision (revision (get message :revision))
                                                 :sourceIdentity (get message :sourceIdentity)))
                                         (previous (js-call records :get key)))
                                    (when (nil? key)
                                      (throw (transportError "invalid-source" "source update requires source text or project modules")))
                                    (when (and previous
                                               (or (< (get next :revision) (get previous :revision))
                                                   (and (= (get next :revision) (get previous :revision))
                                                        (not (= (get next :sourceIdentity) (get previous :sourceIdentity))))))
                                      (throw (transportError "stale-source" "source updates must not overwrite a newer revision")))
                                    (js-call records :set key next)
                                    (funcall reply message (js-object :ok t :result next)))
                                  (progn
                                    (activeSource records request message)
                                    (let ((options (js-object :signal signal)))
                                      (when (and (= (get request :target) "native")
                                                 (js-call (js-array "emit-ir" "project-ir") :includes (get request :operation)))
                                        (put options :responseMode "graph-events-v1")
                                        (put options :responseStringChunks t))
                                      (let* ((result (js-call session :request (get message :request) options))
                                             (fields (js-object :ok t :result result)))
                                        (activeSource records request message)
                                        (when (or closed (get signal :aborted)) (throw (abortError signal)))
                                        (when (and (not (nullish? result)) (not (undefined? (get result :plan))))
                                          (put fields :plan (get result :plan)))
                                        (when (and (not (nullish? result)) (not (undefined? (get result :modules))))
                                          (put fields :modules (get result :modules)))
                                        (funcall reply message fields))))))
                              (catch error
                                (unless closed
                                  (let ((diagnostic (errorData error)))
                                    (funcall reply message
                                      (js-call globalThis.Object :assign (js-object :ok false) diagnostic
                                        (js-object :error diagnostic))))))
                              (finally (js-call pending :delete (get message :id))))))
                        (catch error
                          (let ((diagnostic (errorData error)))
                            (js-call pending :forEach
                              (lambda (entry)
                                (funcall reply (get entry :message)
                                  (js-call globalThis.Object :assign (js-object :ok false) diagnostic
                                    (js-object :error diagnostic)))))
                            (js-call pending :clear)
                            (put queue :length 0)))
                        (finally (setq draining false))))))
      (setq close (async ()
                    (unless closed
                      (setq closed t)
                      (js-call scope :removeEventListener "message" receive)
                      (js-call pending :forEach (lambda (entry) (js-call (get entry :controller) :abort)))
                      (js-call pending :clear)
                      (put queue :length 0)
                      (js-call records :clear)
                      (let ((owned (if (nullish? session) (await opening) session)))
                        (setq session undefined)
                        (js-call owned :close)))))
      (setq receive (lambda (event)
                      (let ((message (if (nullish? (get event :data)) (js-object) (get event :data))))
                        (cond
                          ((= (get message :type) "cancel")
                           (let ((entry (js-call pending :get (get message :id))))
                             (when (and entry (= (get message :version) compilerWorkerVersion))
                               (js-call (get entry :controller) :abort))
                             (js-call scope :postMessage
                               (js-object :version compilerWorkerVersion :type "cancel" :id (get message :id)
                                 :accepted (funcall globalThis.Boolean entry)))))
                          ((= (get message :type) "shutdown")
                           (if (not (= (get message :version) compilerWorkerVersion))
                             (funcall reply message
                               (js-object :ok false :error (errorData
                                                             (transportError "version-mismatch" "compiler worker protocol version 1 required"))))
                             (js-call (funcall close) :then
                               (lambda () (funcall reply message (js-object :ok t)))
                               (lambda (error) (funcall reply message (js-object :ok false :error (errorData error)))))))
                          (closed
                           (funcall reply message
                             (js-object :ok false :error (errorData (transportError "closed" "compiler worker is closed")))))
                          ((or (not (js-call globalThis.Number :isSafeInteger (get message :id)))
                               (<= (get message :id) last-id)
                               (not (js-call (js-array "request" "source") :includes
                                      (get message :type "request"))))
                           (funcall reply message
                             (js-object :ok false :error (errorData
                                                           (transportError "invalid-message" "compiler request ids must increase without reuse")))))
                          (t
                           (setq last-id (get message :id))
                           (let ((entry (js-object :message (js-call globalThis.Object :assign (js-object) message
                                                              (js-object :type (get message :type "request")))
                                          :controller (new globalThis.AbortController))))
                             (js-call pending :set (get message :id) entry)
                             (js-call queue :push entry)
                             (funcall globalThis.setTimeout (lambda () (funcall drain)) 0)))))))
      (js-call scope :addEventListener "message" receive)
      (try
        (setq session (await opening))
        (unless closed
          (js-call scope :postMessage
            (js-object :ready t :version compilerWorkerVersion :host (get session :host))))
        (catch error
          (js-call scope :removeEventListener "message" receive)
          (setq closed t)
          (throw error)))
      (js-call globalThis.Object :freeze (js-object :close close))))

  (export compilerWorkerVersion compilerRequestIdentity compilerSourceIdentity errorData
    fromErrorData createCompilerWorkerClient installCompilerWorker))
