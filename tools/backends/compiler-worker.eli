                         (js-call globalThis.Object :defineProperty result "name"
                           (js-object :value (get node :name) :writable t :configurable t)))))
                    ((= (get node :type) "object")
                     (setq result (js-call globalThis.Object :create
                                     (if (get node :nullPrototype) nil (get globalThis.Object :prototype)))))
                    ((= (get node :type) "array") (setq result (js-array)))
                    ((= (get node :type) "map") (setq result (new globalThis.Map)))
                    ((= (get node :type) "set") (setq result (new globalThis.Set)))
                    ((= (get node :type) "date") (setq result (new globalThis.Date (funcall restore (get node :time)))))
                    ((= (get node :type) "regexp") (setq result (new globalThis.RegExp (get node :source) (get node :flags))))
                    ((and (= (get node :type) "array-buffer") (Array/isArray (get node :bytes)) (valid-bytes (get node :bytes)))
                     (setq result (get (js-call globalThis.Uint8Array :from (get node :bytes)) :buffer)))
                    ((and (= (get node :type) "shared-buffer")
