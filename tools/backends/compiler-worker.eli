  (defun metadata (message)
    (js-object :version (get Worker :compilerWorkerVersion) :id (get message :id)
      :sourceIdentity (get message :sourceIdentity) :requestIdentity (get message :requestIdentity)
      :revision (get message :revision)))
  (defun activeSource (records request message)
    (let ((key (sourceKey request)))
      (unless (= key nil)
        (let ((current (js-call records :get key)))
          (when (or (not current) (not (= (get current :revision) (revision (get message :revision))))
                    (not (= (get current :sourceIdentity) (get message :sourceIdentity))))
            (throw (transportError "stale-source" "compiler request does not match the current source revision and identity")))
          (when (or (and (not (undefined? (get message :expectedRevision)))
                         (not (= (revision (get message :expectedRevision)) (get current :revision))))
                    (and (not (undefined? (get message :expectedSourceIdentity)))
                         (not (= (get message :expectedSourceIdentity) (get current :sourceIdentity)))))
            (throw (transportError "stale-source" "edit or query belongs to an older source snapshot")))))))

  (defasync installCompilerWorker (scope configuration)
    (unless (and scope (= (value-type (get scope :addEventListener)) "function")
                       (= (value-type (get scope :postMessage)) "function"))
      (throw (new globalThis.TypeError "compiler worker requires a message scope")))
    (let* ((records (new globalThis.Map)) (pending (new globalThis.Map)) (queue (js-array))
           (session undefined) (closed false) (draining false) (lastID 0)
           (opening (Sessions/createCompilerSession configuration))
           (identity (new globalThis.RegExp "^[0-9a-f]{64}$"))
           (reply undefined) (validate undefined) (drain undefined) (close undefined) (receive undefined))
      (setq reply (lambda (message fields)
        (js-call scope :postMessage (Object/assign (js-object) (metadata message)
          (js-object :host (if (nullish? session) undefined (get session :host)) :type "result") fields))))
      (setq validate (async (message)
        (unless (= (get message :version) (get Worker :compilerWorkerVersion))
          (throw (transportError "version-mismatch" "compiler worker protocol version 1 required")))
        (unless (and (js-call identity :test (if (nullish? (get message :requestIdentity)) "" (get message :requestIdentity)))
                     (js-call identity :test (if (nullish? (get message :sourceIdentity)) "" (get message :sourceIdentity)))
                     (= (value-type (get message :request)) "string"))
          (throw (transportError "invalid-identity" "compiler request requires request and source identities")))
        (unless (and (= (await (Worker/compilerRequestIdentity (get message :request))) (get message :requestIdentity))
                     (= (await (Worker/compilerSourceIdentity (get message :request))) (get message :sourceIdentity)))
          (throw (transportError "stale-source" "compiler request identity differs from its transported source")))
        (decode (get message :request))))
      (setq drain (async ()
        (unless draining
          (setq draining t)
          (try
            (when (nullish? session) (setq session (await opening)))
            (while (and (not closed) (> (js-length queue) 0))
              (let* ((entry (js-call queue :shift)) (message (get entry :message))
                     (signal (get (get entry :controller) :signal)))
                (try
                  (let ((request (await (funcall validate message))))
                    (when (or closed (get signal :aborted)) (throw (abortError signal)))
                    (if (= (get message :type) "source")
                      (let* ((key (sourceKey request))
                             (next (js-object :revision (revision (get message :revision)) :sourceIdentity (get message :sourceIdentity)))
                             (previous (js-call records :get key)))
                        (when (= key nil) (throw (transportError "invalid-source" "source update requires source text or project modules")))
                        (when (and previous (or (< (get next :revision) (get previous :revision))
                          (and (= (get next :revision) (get previous :revision))
                               (not (= (get next :sourceIdentity) (get previous :sourceIdentity))))))
                          (throw (transportError "stale-source" "source updates must not overwrite a newer revision")))
                        (js-call records :set key next) (funcall reply message (js-object :ok t :result next)))
                      (progn
                        (activeSource records request message)
                        (let ((options (js-object :signal signal)))
                          ;; Keep response cursors inside this serialized transaction:
                          ;; the session drains and closes them before accepting another
                          ;; Worker message. Preserve the complete shared IR graph rather
                          ;; than expanding it into a whole-response JSON tree.
                          (when (and (= (get request :target) "native")
                            (js-call (js-array "emit-ir" "project-ir") :includes (get request :operation)))
                            (put options :responseMode "graph-events-v1")
                            (put options :responseStringChunks t))
                          (let* ((result (js-call session :request (get message :request) options))
                                 (fields (js-object :ok t :result result)))
                            (activeSource records request message)
                            (when (or closed (get signal :aborted)) (throw (abortError signal)))
                            (when (and (not (nullish? result)) (not (undefined? (get result :plan))))
                              (put fields :plan (get result :plan)))
                            (when (and (not (nullish? result)) (not (undefined? (get result :modules))))
                              (put fields :modules (get result :modules)))
                            (funcall reply message fields))))))
                  (catch error
                    (unless closed
                      (let ((diagnostic (Worker/errorData error)))
                        (funcall reply message (Object/assign (js-object :ok false) diagnostic (js-object :error diagnostic))))))
                  (finally (js-call pending :delete (get message :id))))))
            (catch error
              (let ((diagnostic (Worker/errorData error)))
                (js-call pending :forEach (lambda (entry)
                  (funcall reply (get entry :message) (Object/assign (js-object :ok false) diagnostic (js-object :error diagnostic)))))
                (js-call pending :clear) (put queue :length 0)))
            (finally (setq draining false))))))
      (setq close (async ()
        (unless closed
          (setq closed t) (js-call scope :removeEventListener "message" receive)
          (js-call pending :forEach (lambda (entry) (js-call (get entry :controller) :abort)))
          (js-call pending :clear) (put queue :length 0) (js-call records :clear)
          (let ((owned (if (nullish? session) (await opening) session)))
            (setq session undefined) (js-call owned :close)))))
      (setq receive (lambda (event)
        (let ((message (if (nullish? (get event :data)) (js-object) (get event :data))))
          (cond
            ((= (get message :type) "cancel")
             (let ((entry (js-call pending :get (get message :id))))
               (when (and entry (= (get message :version) (get Worker :compilerWorkerVersion)))
                 (js-call (get entry :controller) :abort))
               (js-call scope :postMessage (js-object :version (get Worker :compilerWorkerVersion)
                 :type "cancel" :id (get message :id) :accepted (globalThis.Boolean entry)))))
            ((= (get message :type) "shutdown")
             (if (not (= (get message :version) (get Worker :compilerWorkerVersion)))
               (funcall reply message (js-object :ok false :error (Worker/errorData
                 (transportError "version-mismatch" "compiler worker protocol version 1 required"))))
               (js-call (funcall close) :then (lambda () (funcall reply message (js-object :ok t)))
                 (lambda (error) (funcall reply message (js-object :ok false :error (Worker/errorData error)))))))
            (closed (funcall reply message (js-object :ok false :error (Worker/errorData
              (transportError "closed" "compiler worker is closed")))))
            ((or (not (Number/isSafeInteger (get message :id))) (<= (get message :id) lastID)
                 (not (js-call (js-array "request" "source") :includes
                   (if (nullish? (get message :type)) "request" (get message :type)))))
             (funcall reply message (js-object :ok false :error (Worker/errorData
               (transportError "invalid-message" "compiler request ids must increase without reuse")))))
            (t
             (setq lastID (get message :id))
             (let ((entry (js-object :message (Object/assign (js-object) message
                      (js-object :type (if (nullish? (get message :type)) "request" (get message :type))))
                      :controller (new globalThis.AbortController))))
               (js-call pending :set (get message :id) entry) (js-call queue :push entry)
               (globalThis.setTimeout (lambda () (funcall drain)) 0)))))))
      (js-call scope :addEventListener "message" receive)
      (try
        (setq session (await opening))
        (unless closed (js-call scope :postMessage (js-object :ready t
          :version (get Worker :compilerWorkerVersion) :host (get session :host))))
        (catch error (js-call scope :removeEventListener "message" receive) (setq closed t) (throw error)))
      (Object/freeze (js-object :close close))))
  (export installCompilerWorker)
)
