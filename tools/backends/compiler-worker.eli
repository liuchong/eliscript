                     (new (get (js* "globalThis") (get node :arrayType))
                       (funcall restore (get node :buffer)) (get node :byteOffset) (get node :length))))))
              (setq index (1+ index)))
            (setq index 0)
            (while (< index (js-length nodes))
              (let ((node (aref nodes index)) (result (js-call objects :get index)) (property-index 0))
                (while (< property-index (js-length (get node :properties)))
                  (let ((property (aref (get node :properties) property-index)))
                    (unless (= (host-type (host-get property "key")) "string")
                      (throw (funcall invalid "invalid exception property")))
                    (js-call globalThis.Object :defineProperty result (get property :key)
                      (js-object :value (funcall restore (get property :value))
                        :writable (= (get property :writable) t)
                        :enumerable (if (and ground-records (= (get node :type) "error")) t (= (get property :enumerable) t))
                        :configurable (= (get property :configurable) t))))
                  (setq property-index (1+ property-index)))
                (when (= (get node :type) "map")
                  (unless (Array/isArray (get node :entries))
                    (throw (funcall invalid "invalid exception Map entries")))
                  (let ((entry-index 0))
                    (while (< entry-index (js-length (get node :entries)))
                      (let ((entry (aref (get node :entries) entry-index)))
                        (unless (and (Array/isArray entry) (= (js-length entry) 2))
                          (throw (funcall invalid "invalid exception Map entry")))
                        (js-call (get (get globalThis.Map :prototype) :set) :call result
                          (funcall restore (aref entry 0)) (funcall restore (aref entry 1))))
                      (setq entry-index (1+ entry-index)))))
                (when (= (get node :type) "set")
                  (unless (Array/isArray (get node :values))
                    (throw (funcall invalid "invalid exception Set values")))
