(module tools.backends.compiler-worker
  (import "./compiler-sha256.mjs" createCompilerSha256)
  (import "./compiler-session.mjs" createCompilerSession)

  (defconst compilerWorkerVersion 1)
  (defconst identity-pattern "^[0-9a-f]{64}$")
  (defconst frontend-operations
    (js-array "compile" "compile-ir" "stage" "format" "analyze" "query" "edit-preview"
      "serialize-ir" "deserialize-ir" "emit-memory-ir" "emit-typed-memory" "protocol"))
  (defconst typed-array-names
    (js-array "Int8Array" "Uint8Array" "Uint8ClampedArray" "Int16Array" "Uint16Array"
      "Int32Array" "Uint32Array" "Float32Array" "Float64Array" "BigInt64Array" "BigUint64Array"))
  (defconst regexp-flags
    (js-array (js-array "hasIndices" "d") (js-array "global" "g") (js-array "ignoreCase" "i")
      (js-array "multiline" "m") (js-array "dotAll" "s") (js-array "unicode" "u")
      (js-array "unicodeSets" "v") (js-array "sticky" "y")))
  (defconst index-key-pattern "^(?:0|[1-9][0-9]*)$")
  (defconst bigint-pattern "^-?(?:0|[1-9][0-9]*)$")
  (defconst public-error-fields (js-array "code" "eliscriptDiagnostic" "macroOrigins" "cause"
                                  "truncatedCause" "eliscriptFrames" "eliscriptSourceFrames"))
  (defconst legacy-error-fields (js-array "code" "eliscriptDiagnostic" "diagnostics" "macroOrigins"
                                  "truncatedCause" "eliscriptFrames" "eliscriptSourceFrames" "transportPath"))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun defined-or (object key default)
    (let ((value (get object key)))
      (if (undefined? value) default value)))

  (defun input-or (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object) (aref supplied 0)))

  (defun transportError (code message)
    (let ((error (new globalThis.Error message)))
      (put error :name "CompilerWorkerError")
      (put error :code code)
      error))

  (defun abortError (signal)
    (if (and (host-truthy signal) (not (undefined? (get signal :reason))))
      (get signal :reason)
      (let ((error (new globalThis.Error "compiler request cancelled")))
        (put error :name "AbortError")
        error)))

  (defun decode (text)
    (let ((request (JSON/parse text)))
      (when (or (nil? request) (not (= (host-type request) "object")) (Array/isArray request))
        (throw (transportError "invalid-request" "request must be a JSON object")))
      request))

  (defun sourceKey (request)
    (cond
      ((Array/isArray (get request :modules))
       (str (if (= (get request :operation) "project-ir") "project-ir:" "project:") (get request :entry)))
      ((= (host-type (get request :ir)) "string")
       (str "ir:" (get request :filename "<input>")))
      ((= (host-type (get request :source)) "string")
       (str "source:" (get request :filename "<input>")))
      (t nil)))

  (defun revision (value)
    (unless (and (js-call globalThis.Number :isSafeInteger value) (>= value 0))
      (throw (transportError "invalid-revision" "source revision must be a nonnegative safe integer")))
    value)

  (defun metadata (message)
    (js-object :version compilerWorkerVersion :id (get message :id)
      :sourceIdentity (get message :sourceIdentity) :requestIdentity (get message :requestIdentity)
      :revision (get message :revision)))

  (defun encode (request)
    (if (= (host-type request) "string")
      request
      (let ((text (JSON/stringify request)))
        (unless (= (host-type text) "string")
          (throw (transportError "invalid-request" "request must contain JSON data")))
        text)))

  (defun copy-list (value)
    (Array/from value))

  (defun macro-context (value)
    (js-object
      :capabilities (if (Array/isArray (host-get value "capabilities")) (copy-list (get value :capabilities)) (js-array))
      :files (if (Array/isArray (host-get value "files"))
               (js-call (get value :files) :map
                 (lambda (file) (js-object :specifier (get file :specifier) :content (get file :content))))
               (js-array))))

  (defun source-module (module request)
    (let ((record (js-object :id (get module :id)
                    :filename (get module :filename (get module :id))
                    :source (get module :source))))
      (when (= (host-type (get module :ir)) "string")
        (put record :ir (get module :ir))
        (when (js-call globalThis.Object :hasOwn module "macroOrigins")
          (put record :macroOrigins (get module :macroOrigins))))
      (put record :portableEntries (get module :portableEntries))
      (put record :macroContext (macro-context (get module :macroContext (get request :macroContext))))
      record))

  (defun named-source (module)
    (js-object :id (get module :id) :filename (get module :filename (get module :id)) :source (get module :source)))

  (defun host-module (module)
    (js-object :id (get module :id) :specifier (get module :specifier) :referrer (get module :referrer)
      :allowedExports (get module :allowedExports) :namespace (get module :namespace)))

  (defun with-libraries (request snapshot)
    (unless (js-call frontend-operations :includes (get request :operation))
      (when (js-call globalThis.Object :hasOwn request "literalSources")
        (put snapshot :literalSources
          (if (Array/isArray (get request :literalSources))
            (js-call (get request :literalSources) :map
              (lambda (module) (js-object :id (get module :id) :filename (get module :filename) :source (get module :source))))
            (get request :literalSources)))))
    snapshot)

  (defun source-snapshot (request)
    (if (Array/isArray (get request :modules))
      (with-libraries request
        (js-object :entry (get request :entry) :entries (get request :entries)
          :portableEntries (get request :portableEntries) :resolveImports (get request :resolveImports)
          :modules (js-call (get request :modules) :map (lambda (module) (source-module module request)))
          :hostSources (if (Array/isArray (get request :hostSources))
                         (js-call (get request :hostSources) :map named-source) (js-array))
          :hostModules (if (Array/isArray (get request :hostModules))
                         (js-call (get request :hostModules) :map host-module) (js-array))))
      (if (= (host-type (get request :ir)) "string")
        (with-libraries request
          (let ((snapshot (js-object :ir (get request :ir) :filename (get request :filename "<input>"))))
            (when (= (host-type (get request :source)) "string")
              (put snapshot :source (get request :source)))
            snapshot))
        (if (= (host-type (get request :source)) "string")
          (with-libraries request
            (js-object :filename (get request :filename "<input>") :source (get request :source)
              :portableEntries (get request :portableEntries)
              :allowProjectImports (get request :allowProjectImports)
              :macroContext (macro-context (get request :macroContext))))
          nil))))

  (defun require-subtle ()
    (let* ((crypto globalThis.crypto)
           (subtle (if (nullish? crypto) undefined (get crypto :subtle))))
      (unless (host-truthy subtle)
        (throw (transportError "unavailable-identity" "SHA-256 is unavailable in this host")))))

  (defasync digest (text)
    (require-subtle)
    (let ((hash (createCompilerSha256))
          (bytes (new globalThis.Uint8Array 65536))
          (start 0))
      (while (< start (js-length text))
        (let ((count (js-call globalThis.Math :min (/ (get bytes :length) 2) (- (js-length text) start)))
              (index 0))
          (while (< index count)
            (let ((unit (js-call text :charCodeAt (+ start index))))
              (put bytes (* index 2) (bit-and unit 255))
              (put bytes (1+ (* index 2)) (unsigned-bit-shift-right unit 8)))
            (setq index (1+ index)))
          (js-call hash :update (js-call bytes :subarray 0 (* count 2)))
          (setq start (+ start count))))
      (js-call hash :digestHex)))

  (defasync compilerRequestIdentity (request)
    (await (digest (encode request))))

  (defasync compilerSourceIdentity (request)
    (await (digest (JSON/stringify
                     (source-snapshot (if (= (host-type request) "string") (decode request) request))))))

  (defun host-instance (value constructor)
    (funcall (js* "(value, constructor) => value instanceof constructor") value constructor))

  (defun object-tag (value)
    (js-call (get (get globalThis.Object :prototype) :toString) :call value))

  (defun descriptor-get (prototype key)
    (host-get (js-call globalThis.Object :getOwnPropertyDescriptor prototype key) "get"))

  (defun failure-at (path message)
    (let ((result (transportError "uncloneable-error-cause" (str message " at " path))))
      (put result :path path)
      result))

  (defun visit-error (state value path)
    (cond
      ((undefined? value) (js-object :primitive "undefined"))
      ((nil? value) (js-object :primitive "null"))
      ((= (host-type value) "number")
       (cond
         ((js-call globalThis.Object :is value (js* "-0")) (js-object :primitive "negative-zero"))
         ((js-call globalThis.Number :isNaN value) (js-object :primitive "nan"))
         ((= value (js* "Infinity")) (js-object :primitive "positive-infinity"))
         ((= value (js* "-Infinity")) (js-object :primitive "negative-infinity"))
         (t (js-object :primitive "number" :value value))))
      ((= (host-type value) "bigint")
       (js-object :primitive "bigint" :value (js-call value :toString)))
      ((or (= (host-type value) "string") (= (host-type value) "boolean"))
       (js-object :primitive (host-type value) :value value))
      ((not (= (host-type value) "object"))
       (throw (failure-at path (str "compiler worker exception contains an uncloneable " (host-type value)))))
      ((js-call (get state :seen) :has value)
       (js-object :ref (js-call (get state :seen) :get value)))
      (t
       (let* ((nodes (get state :nodes))
              (index (js-length nodes))
              (node (js-object :type "object" :properties (js-array)
                      :extensible (js-call globalThis.Object :isExtensible value)))
              (tag (object-tag value))
              (public-fields (new globalThis.Map)))
         (js-call (get state :seen) :set value index)
         (js-call nodes :push node)
         (cond
           ((or (host-instance value globalThis.Error) (= tag "[object Error]"))
            (let ((name (js-call globalThis.Reflect :get value "name"))
                  (message (js-call globalThis.Reflect :get value "message")))
              (put node :type "error")
              (js-call public-fields :set "name" name)
              (js-call public-fields :set "message" message)
              (put node :name (if (= (host-type name) "string") name "Error"))
              (put node :message (if (= (host-type message) "string") message ""))))
           ((Array/isArray value) (put node :type "array"))
           ((= tag "[object Map]")
            (put node :type "map")
            (put node :entries (js-array))
            (js-call (get (get globalThis.Map :prototype) :forEach) :call value
              (lambda (item key)
                (js-call (get node :entries) :push
                  (js-array (visit-error state key (str path ".<key>"))
                    (visit-error state item (str path ".<value>")))))))
           ((= tag "[object Set]")
            (put node :type "set")
            (put node :values (js-array))
            (js-call (get (get globalThis.Set :prototype) :forEach) :call value
              (lambda (item)
                (js-call (get node :values) :push (visit-error state item (str path ".<value>"))))))
           ((= tag "[object Date]")
            (put node :type "date")
            (put node :time (visit-error state
                              (js-call (get (get globalThis.Date :prototype) :getTime) :call value)
                              (str path ".<time>"))))
           ((= tag "[object RegExp]")
            (put node :type "regexp")
            (put node :source (js-call (descriptor-get (get globalThis.RegExp :prototype) "source") :call value))
            (put node :flags "")
            (let ((flag-index 0))
              (while (< flag-index (js-length regexp-flags))
                (let* ((pair (aref regexp-flags flag-index))
                       (getter (descriptor-get (get globalThis.RegExp :prototype) (aref pair 0))))
                  (when (and getter (js-call getter :call value))
                    (put node :flags (str (get node :flags) (aref pair 1)))))
                (setq flag-index (1+ flag-index)))))
           ((= tag "[object ArrayBuffer]")
            (put node :type "array-buffer")
            (put node :bytes (Array/from (new globalThis.Uint8Array
                                        (js-call (get (get globalThis.ArrayBuffer :prototype) :slice) :call value 0)))))
           ((and (not (= (host-type globalThis.SharedArrayBuffer) "undefined")) (= tag "[object SharedArrayBuffer]"))
            (when (= (get state :transport) "json")
              (throw (failure-at path "shared memory cannot be represented by the JSON exception transport")))
            (put node :type "shared-buffer")
            (put node :buffer (funcall globalThis.structuredClone value)))
           ((js-call globalThis.ArrayBuffer :isView value)
            (put node :type (if (= tag "[object DataView]") "data-view" "typed-array"))
            (put node :arrayType (js-call tag :slice 8 -1))
            (when (and (= (get node :type) "typed-array") (not (js-call (get state :typedArrays) :has (get node :arrayType))))
              (throw (failure-at path "unsupported exception typed array")))
            (put node :buffer (visit-error state (get value :buffer) (str path ".buffer")))
            (put node :byteOffset (get value :byteOffset))
            (put node :length (if (= (get node :type) "data-view") (get value :byteLength) (get value :length))))
           (t
            (let ((prototype (js-call globalThis.Object :getPrototypeOf value)))
              (when (and (not (= prototype (get globalThis.Object :prototype))) (not (nil? prototype)))
                (throw (failure-at path "unsupported exception object prototype")))
              (put node :nullPrototype (nil? prototype)))))
         (when (> (js-length (js-call globalThis.Object :getOwnPropertySymbols value)) 0)
           (throw (failure-at path "exception contains symbol property keys")))
         (let ((names (js-call globalThis.Object :getOwnPropertyNames value)) (name-index 0))
           (while (< name-index (js-length names))
             (let ((key (aref names name-index)))
               (unless (and (= (get node :type) "typed-array")
                            (js-call (new globalThis.RegExp index-key-pattern) :test key))
                 (let* ((descriptor (js-call globalThis.Object :getOwnPropertyDescriptor value key))
                        (data (js-call globalThis.Object :hasOwn descriptor "value")))
                   (when (and (not data)
                              (not (and (= (get node :type) "error")
                                        (js-call (js-array "stack" "name" "message" "cause") :includes key))))
                     (throw (failure-at (str path "." key) "exception contains an unsupported accessor property")))
                   (js-call (get node :properties) :push
                     (js-object :key key
                       :value (visit-error state
                                (if data (get descriptor :value)
                                  (if (js-call public-fields :has key)
                                    (js-call public-fields :get key)
                                    (js-call globalThis.Reflect :get value key)))
                                (str path "." key))
                       :writable (if data (get descriptor :writable) t)
                       :enumerable (get descriptor :enumerable)
                       :configurable (get descriptor :configurable))))))
             (setq name-index (1+ name-index))))
         (js-object :ref index)))))

  (defun error-constructors ()
    (let ((constructors (js-object :Error globalThis.Error :TypeError globalThis.TypeError
                          :RangeError globalThis.RangeError :SyntaxError globalThis.SyntaxError
                          :ReferenceError globalThis.ReferenceError :URIError globalThis.URIError
                          :EvalError globalThis.EvalError)))
      (when (not (= (host-type globalThis.WebAssembly) "undefined"))
        (put constructors :RuntimeError (get globalThis.WebAssembly :RuntimeError))
        (put constructors :CompileError (get globalThis.WebAssembly :CompileError))
        (put constructors :LinkError (get globalThis.WebAssembly :LinkError)))
      (when (= (host-type globalThis.AggregateError) "function")
        (put constructors :AggregateError globalThis.AggregateError))
      constructors))

  (defun restore-primitive (token invalid)
    (cond
      ((= (get token :primitive) "undefined") undefined)
      ((= (get token :primitive) "null") nil)
      ((= (get token :primitive) "negative-zero") (js* "-0"))
      ((= (get token :primitive) "nan") (js* "NaN"))
      ((= (get token :primitive) "positive-infinity") (js* "Infinity"))
      ((= (get token :primitive) "negative-infinity") (js* "-Infinity"))
      ((and (= (get token :primitive) "number") (= (host-type (get token :value)) "number")
            (js-call globalThis.Number :isFinite (get token :value)))
       (get token :value))
      ((and (= (get token :primitive) "string") (= (host-type (get token :value)) "string"))
       (get token :value))
      ((and (= (get token :primitive) "boolean") (= (host-type (get token :value)) "boolean"))
       (get token :value))
      ((and (= (get token :primitive) "bigint") (= (host-type (get token :value)) "string")
            (js-call (new globalThis.RegExp bigint-pattern) :test (get token :value)))
       (funcall globalThis.BigInt (get token :value)))
      (t (throw (funcall invalid "compiler worker exception graph has an invalid primitive")))))

  (defun valid-bytes (bytes)
    (let ((index 0) (valid t))
      (while (and valid (< index (js-length bytes)))
        (let ((byte (aref bytes index)))
          (unless (and (js-call globalThis.Number :isInteger byte) (>= byte 0) (<= byte 255))
            (setq valid nil)))
        (setq index (1+ index)))
      valid))

  (defun fromErrorData (value ground-records)
    (let ((constructors (error-constructors))
          (graph (host-get value "errorValue")))
      (if (not (undefined? graph))
        (let ((invalid (lambda (message) (transportError "invalid-error-value" message)))
              (objects (new globalThis.Map))
              (typed (new globalThis.Set typed-array-names)))
          (when (or (not (= (host-get graph "format") "eliscript-worker-error-value"))
                    (not (= (get graph :version) 1))
                    (not (Array/isArray (host-get graph "nodes"))))
            (throw (funcall invalid "compiler worker exception graph has an invalid format")))
          (let ((restore (lambda (token)
                           (if (and (host-truthy token) (js-call globalThis.Object :hasOwn token "primitive"))
                             (restore-primitive token invalid)
                             (progn
                               (when (or (not (js-call globalThis.Number :isSafeInteger (host-get token "ref")))
                                         (not (js-call objects :has (get token :ref))))
                                 (throw (funcall invalid "compiler worker exception graph has an invalid reference")))
                               (js-call objects :get (get token :ref))))))
                (index 0)
                (nodes (get graph :nodes)))
            (while (< index (js-length nodes))
              (let ((node (aref nodes index)) (result nil))
                (when (or (nil? node) (not (= (host-type node) "object")) (not (Array/isArray (get node :properties))))
                  (throw (funcall invalid "invalid exception node")))
                (unless (or (= (get node :type) "data-view") (= (get node :type) "typed-array"))
                  (cond
                    ((= (get node :type) "error")
                     (when (or (not (= (host-type (get node :name)) "string"))
                               (not (= (host-type (get node :message)) "string")))
                       (throw (funcall invalid "invalid Error summary")))
                     (let ((constructor (if (js-call globalThis.Object :hasOwn constructors (get node :name))
                                          (get constructors (get node :name)) globalThis.Error)))
                       (setq result (if ground-records
                                      (js-object :name (get node :name) :message (get node :message))
                                      (if (= constructor globalThis.AggregateError)
                                        (new constructor (js-array))
                                        (new constructor))))
                       (unless ground-records
                         (let ((names (js-call globalThis.Object :getOwnPropertyNames result)) (cursor 0))
                           (while (< cursor (js-length names))
                             (let ((key (aref names cursor)) (found nil) (property-index 0))
                               (while (and (not found) (< property-index (js-length (get node :properties))))
                                 (when (= (get (aref (get node :properties) property-index) :key) key)
                                   (setq found t))
                                 (setq property-index (1+ property-index)))
                               (unless found (js-call globalThis.Reflect :deleteProperty result key)))
                             (setq cursor (1+ cursor)))))
