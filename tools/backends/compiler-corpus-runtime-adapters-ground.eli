                 (let ((child (aref items index)))
                   (when (or (and (source-head child "same")
                              (js-call (runtime-source-node input child) :includes "runSuccessful"))
                             (and (runtime-let-binding-p child "output")
                               (js-call (runtime-source-node input child) :includes "runSuccessful")))
                     (when (>= start 0) (throw (new globalThis.TypeError "ambiguous original usage assertion")))
                     (setq start index))
                   (when (or (source-head child "catch") (source-head child "finally")) (setq stop index)))
                 (setq index (1+ index)))
               (when (and (>= start 0) (> stop start))
                 (js-call tails :push (js-call (js-call (js-call items :slice start stop) :map
                   (lambda (child)
                     (if (and (runtime-let-binding-p child "output")
                              (js-call (runtime-source-node input child) :includes "runSuccessful"))
                       (let ((body (js-call (get child :items) :slice 2)))
                         (unless (js-call body :every (lambda (form)
                           (or (source-head form "same")
                             (and (source-head form "be") (= (get (aref (get form :items) 1) :name) "output")
                                  (= (get (aref (get form :items) 2) :value) "")))))
                           (throw (new globalThis.TypeError "original CLI setup acquired an unprojected assertion")))
                         (js-call (js-call (js-call body :filter (lambda (form) (source-head form "same"))) :map
                           (lambda (form) (runtime-source-node input form))) :join "\n"))
                       (runtime-source-node input child)))) :join "\n")))))))
         (unless (= (js-length tails) 1) (throw (new globalThis.TypeError "original stdlib assertion scope changed")))
         (get (rewriteSourceForms (aref tails 0) (lambda (child node-text)
           (if (and (sourceCall child "await") (sourceCall (aref (get child :items) 1) "runSuccessful"))
             "(get context :output)" undefined))) :source)))
      (t (str "(funcall " (runtime-source-node input (get input :callback)) ")"))))

  (defun runtime-static-data (node)
    (cond
      ((= (get node :kind) "literal") (get node :value))
      ((= (get node :kind) "keyword") (get node :name))
      ((= (get node :kind) "symbol")
       (cond ((= (get node :name) "t") t) ((= (get node :name) "false") false)
             ((= (get node :name) "nil") nil)
             (t (throw (new globalThis.TypeError "original runtime expectation contains an unsupported symbol")))))
      ((and (source-head node "-") (= (js-length (get node :items)) 2))
       (- (runtime-static-data (aref (get node :items) 1))))
      ((source-head node "js-array") (js-call (js-call (get node :items) :slice 1) :map runtime-static-data))
      ((source-head node "js-object")
       (let ((items (get node :items)) (out (js-object)) (index 1))
         (unless (= (% (1- (js-length items)) 2) 0)
           (throw (new globalThis.TypeError "original runtime expectation has incomplete key/value pairs")))
         (while (< index (js-length items))
           (Object/defineProperty out (funcall globalThis.String (runtime-static-data (aref items index)))
             (js-object :value (runtime-static-data (aref items (1+ index))) :writable t :enumerable t :configurable t))
           (setq index (+ index 2))) out))
      (t (throw (new globalThis.TypeError "original runtime expectation is not static Eliscript data")))))

  (defun runtime-output-expectation (input)
    (let ((matches (js-call (runtime-nodes (get input :callback)) :filter (lambda (node)
      (and (source-head node "same") (= (js-length (get node :items)) 3)
           (js-call (runtime-source-node input (aref (get node :items) 1)) :includes "runSuccessful")
           (source-head (aref (get node :items) 2) "js-object"))))))
      (unless (= (js-length matches) 1)
        (throw (new globalThis.TypeError "original runtime output expectation changed")))
      (runtime-static-data (aref (get (aref matches 0) :items) 2))))

  (defasync runtime-assertion-helper (ctx suite title mode)
    (let* ((input (await (runtime-maintained-case ctx suite title)))
           (root (get ctx :sourceRoot))
           (original-url (get (pathToFileURL (resolve root suite)) :href))
           (declarations (js-array)) (imports (js-array)) (own-names (new globalThis.Set))
           (body (runtime-assertion-body input mode)))
      (when (= suite "tests/core-stdlib.test.mjs")
        (setq body (get (rewriteSourceForms body (lambda (node node-text)
          (when (and (source-head node "js-call")
                     (js-call (funcall node-text node) :startsWith "(js-call (expect (transientMapMetrics)) :toMatchObject"))
            (str "(when (= (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_TARGET) \"javascript\") "
              (funcall node-text node) ")")))) :source)))
      (when (= suite "tests/persistent-core-exit.test.mjs")
        (setq body (js-call body :replace "(js-array \"vector\" \"map\" \"set\")" "(js-array (get context :collection))")))
      (when (= suite "tests/multimethod.test.mjs")
        (setq body (js-call (js-call body :replaceAll "multimethod.eli.map" "multimethod.mjs.map") :replaceAll "hierarchy.eli.map" "hierarchy.mjs.map")))
      (js-call (get input :items) :forEach (lambda (node)
        (let ((items (get node :items)))
          (cond
            ((source-head node "import")
             (let* ((specifier (get (aref items 1) :value))
                    (names (js-call (js-call items :slice 2) :filter (lambda (item)
                      (not (js-call (js-array "be" "same" "contains" "excludes") :includes (get item :name)))))))
               (if (= specifier "bun:test")
                 (js-call imports :push (str "(import " (JSON/stringify (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-matchers.mjs")) :href)) " expect)"))
                 (when (and (> (js-length names) 0) (/= specifier "node:assert/strict")) (js-call imports :push (str "(import "
                   (JSON/stringify (if (js-call specifier :startsWith ".")
                     (get (pathToFileURL (resolve root (posix/dirname suite) specifier)) :href) specifier)) " "
                   (js-call (js-call names :map (lambda (item) (runtime-source-node input item))) :join " ") ")"))))))
            ((or (source-head node "defconst") (source-head node "defvar")
                 (source-head node "defun") (source-head node "defasync"))
             (js-call own-names :add (get (aref items 1) :name))
             (js-call declarations :push (js-object :name (get (aref items 1) :name)
               :replacement (js-call (runtime-source-node input node) :replaceAll "(js* \"import.meta.url\")" (JSON/stringify original-url)))))))))
      (js-call (js-array
        (js-array "be" "(defun be (actual expected) (js-call (expect actual) :toBe expected))")
        (js-array "same" "(defun same (actual expected) (js-call (expect actual) :toEqual expected))")
        (js-array "contains" "(defun contains (actual expected) (js-call (expect actual) :toContain expected))")
        (js-array "excludes" "(defun excludes (actual expected) (js-call (get (expect actual) :not) :toContain expected))"))
        :forEach (lambda (entry) (unless (js-call own-names :has (aref entry 0)) (js-call imports :push (aref entry 1)))))
      (let* ((extra (str (js-call imports :join "\n") "\n"
        "(import \"node:fs/promises\" :as original-fs) (import \"node:url\" :as original-url) (import \"node:path\" :as original-path)\n"
        "(import " (JSON/stringify (get (pathToFileURL (resolve root "tests/helpers/portable-stdlib.mjs")) :href)) " :as original-assertions)\n"

        "(defconst original-import (js* \"(specifier) => import(specifier)\"))\n"
        (if (= mode "identity-shape")
          (str
            "(defasync original-cli-view (context)\n"
            " (let* ((input (get context :modulePath)) (id \"tests/fixtures/identity.mjs\")\n"
            "   (output (js-call original-path :resolve (get context :product) \"original-cli-view\" id))\n"
            "   (javascript (await (js-call original-fs :readFile input \"utf8\")))\n"
            "   (map (JSON/parse (await (js-call original-fs :readFile (str input \".map\") \"utf8\"))))\n"
            "   (original-file (get map :file)))\n"
            "  (unless (and (= (js-call original-path :relative (get context :javascriptRoot) input) id)\n"
            "    (= (js-length (get map :sources)) 1) (= (js-length (get map :sourcesContent)) 1)\n"
            "    (or (= (aref (get map :sources) 0) \"identity-only.eli\")\n"
            "        (= (aref (get map :sources) 0) \"../../../sources/identity-only.eli\")\n"
            "        (= (aref (get map :sources) 0) \"../sources/identity-only.eli\")))\n"
            "   (throw (new globalThis.TypeError \"original identity CLI source map changed\")))\n"
            "  (put map :file (js-call original-path :basename id))\n"
            "  (put map :sources (js-array (js-call original-path :relative\n"
            "    (js-call original-path :dirname (js-call original-path :resolve \"/seed-output\" id))\n"
            "    (js-call original-path :resolve \"/sources\" \"identity-only.eli\"))))\n"
            "  (await (js-call original-fs :mkdir (js-call original-path :dirname output) (js-object :recursive t)))\n"
            "  (unless (js-call (js-array \"tests/fixtures/identity.mjs\" \"identity.mjs\" \"identity-only.mjs\") :includes original-file)\n"
            "   (throw (new globalThis.TypeError \"original identity CLI output identity changed\")))\n"
            "  (let* ((comment (str \"//# sourceMappingURL=\" (js-call original-path :basename (str id \".map\")) \"\\n\"))\n"
            "         (original-comment (str \"//# sourceMappingURL=\" (js-call original-path :basename original-file) \".map\\n\"))\n"
            "         (body (if (js-call javascript :endsWith original-comment)\n"
            "           (js-call javascript :slice 0 (- (js-length original-comment))) javascript)))\n"
            "   (when (js-call body :includes \"\\n//# sourceMappingURL=\")\n"
            "    (throw (new globalThis.TypeError \"original identity CLI source map footer changed\")))\n"
            "   (await (js-call original-fs :writeFile output (str body comment))))\n"
            "  (await (js-call original-fs :writeFile (str output \".map\") (str (JSON/stringify map) \"\\n\"))) output))\n")
          "")
        "(defasync run-original-assertions (context)\n"
        " (let* ((product (get context :product)) (directory product) (seed "
        (if (= suite "tests/eliscript-protocol.test.mjs") "(get context :modulePath)" "(get context :javascriptRoot product)") ")\n"
        "  (self seed) (seedDirectory seed) (selfHostedDirectory seed) (outputRoot (get context :outputRoot product)) (library (get context :modulePath))\n"
        "  (modulePath (get context :selectedModulePath)) (seedModule modulePath) (seedSet modulePath)\n"
        "  (objectModule library) (dataModule (js-call original-path :resolve library \"..\" \"data.mjs\"))\n"
        "  (identitySeed (get context :referenceModulePath)) (identitySelf "
        (if (= mode "identity-shape") "(await (original-cli-view context))" "(get context :modulePath)") ")\n"
        "  (usage (get context :usage)) (collection (get context :collection)) (output (get context :output)) (executed output)\n"
        "  (reports (get context :reports (js-array))) (hostReports reports) (report (if (> (js-length reports) 0) (aref reports 0) nil)) (bunReport report) (nodeReport (if (> (js-length reports) 1) (aref reports 1) report))\n"
        "  (importGeneratedModule (async (ignored) (await (funcall original-import (get (js-call original-url :pathToFileURL (get context :selectedModulePath)) :href)))))\n"
        "  (generatedModules (async (label) (let ((modules (js-object)))\n"
        "   (js-call (js-array \"bit\" \"persistent-list\" \"persistent-vector\" \"persistent-map\" \"persistent-set\" \"value\") :forEach\n"
        "     (lambda (name) (put modules name (funcall original-import (get (js-call original-url :pathToFileURL\n"
        "       (js-call original-path :resolve product (str name \".mjs\"))) :href)))))\n"
        "   (let ((names (Object/keys modules)) (index 0)) (while (< index (js-length names))\n"
        "     (let ((name (aref names index))) (put modules name (await (get modules name)))) (setq index (1+ index)))) modules)))\n"
        "  (withPortableLibraries (async (settings check) (await (funcall check (Object/assign (js-object) context\n"
        "    (js-object :report report :reports reports :seedDirectory seed :selfHostedDirectory seed :directory product))))))\n"
        "  (pruneLibrary (async (settings exported include exclude)\n"
        "   (when (get context :pruningOnly)\n"
        "    (let ((source (await (js-call original-fs :readFile (get context :prunedModulePath) \"utf8\"))))\n"
        "      (js-call include :forEach (lambda (value) (js-call original-assertions :contains source value)))\n"
        "      (js-call exclude :forEach (lambda (value) (js-call original-assertions :excludes source value))))))))\n"
        body "))\n"))
             (helper (await (maintained-helper ctx suite declarations extra (js-array "run-original-assertions")))))
        (put helper :case (get input :locator))
        (put helper :regions (js-array (get (get input :locator) :originalCase)))
        (js-call (get (get helper :maintainedSource) :sourceRegions) :push
          (source-node-proof (get input :source) (get input :callback))) helper)))

(defconst runtime-stdlib-plans
    (js-array (js-object :name "sequence" :library "sequence" :assertion "portable sequence library compiles and executes as an ESM module") (js-object :name "object" :library "object" :assertion "portable object and data libraries preserve immutable own-property semantics") (js-object :name "text" :library "text" :assertion "portable text library compiles and executes as an ESM module")))
(defconst runtime-callable-plans
    (js-array (js-object :name "function" :assertions (js-array "portable function combinators compile and agree across local hosts" "predicate combinators preserve Lisp truth and short-circuit order") :directBodies 2) (js-object :name "deferred" :assertions (js-array "deferred computations compile and agree across local hosts" "delay and memoize retry failures without caching partial state") :directBodies 1)))
(defconst runtime-history-plans
    (js-array (js-object :name "value" :suite "portable-value-semantics" :helperStart "function nextRandom(state)" :multiModules t :tests (js-array "portable persistent collections preserve nested undefined values" "optimized and portable persistent Lists share frozen hash semantics" "Eliscript-authored value semantics preserve generated cross-family invariants" "Eliscript-authored value hashing traverses one million persistent values")) (js-object :name "persistent-list" :helperStart "function nextRandom(state)" :tests (js-array "Eliscript-authored persistent list preserves generated history" "Eliscript-authored persistent list shares a million-node suffix")) (js-object :name "persistent-vector" :helperStart "function nodeCount(node, level)" :vector t :tests (js-array "Eliscript-authored persistent vector preserves generated history" "Eliscript-authored persistent vector keeps million-value trie bounds")) (js-object :name "persistent-map" :helperStart "function integerHash(value)" :tests (js-array "Eliscript-authored HAMT Map preserves generated value-key histories" "Eliscript-authored HAMT Map promotes and demotes measured layouts" "Eliscript-authored HAMT Map shares the million-key update path")) (js-object :name "persistent-set" :helperStart "function integerHash(value)" :tests (js-array "Eliscript-authored persistent Set preserves generated value-key histories" "Eliscript-authored persistent Set preserves algebra and HAMT layouts" "Eliscript-authored persistent Set shares the million-member update path"))))
(defconst runtime-portable-plans
    (js-call (js-array (js-object :name "persistent-list" :suite "portable-persistent-list" :assertion "Eliscript-authored persistent list compiles and agrees across hosts" :begin "    for (const report of reports) {") (js-object :name "persistent-vector" :suite "portable-persistent-vector" :assertion "Eliscript-authored persistent vector compiles and agrees across hosts" :begin "    for (const report of hostReports) {") (js-object :name "persistent-map" :suite "portable-persistent-map" :assertion "Eliscript-authored HAMT Map compiles and agrees across hosts") (js-object :name "persistent-set" :suite "portable-persistent-set" :assertion "Eliscript-authored persistent Set compiles and agrees across hosts") (js-object :name "numeric" :suite "portable-numeric" :assertion "portable numeric functions preserve exact Number and safe-integer contracts") (js-object :name "json" :suite "portable-json" :assertion "portable JSON values are strict, canonical, bounded, and self-hosted") (js-object :name "result" :suite "portable-result" :assertion "portable Result values are byte-identical and short-circuit at scale") (js-object :name "metadata" :suite "portable-metadata" :assertion "Eliscript-authored metadata is byte-identical and portable") (js-object :name "data-text" :suite "portable-data-text" :assertion "portable canonical data text is byte-identical and host-independent") (js-object :name "value" :suite "portable-value-semantics" :assertion "Eliscript-authored value semantics compile and agree across hosts") (js-object :name "persistent-queue" :suite "persistent-queue" :assertion "Eliscript persistent queue API compiles and runs on both hosts" :begin "    expect(reports[1]).toEqual(reports[0]);" :maps false) (js-object :name "lazy-sequence" :suite "lazy-sequence" :source "tests/fixtures/lazy-sequence.eli" :assertion "Eliscript lazy sequences agree across compilers and local hosts" :maps false) (js-object :name "persistent-sorted" :suite "persistent-sorted" :source "tests/fixtures/persistent-sorted.eli" :assertion "Eliscript sorted API agrees across compilers and local hosts" :maps false) (js-object :name "regex" :suite "regex" :source "tests/fixtures/regex.eli" :assertion "Eliscript regex APIs agree across compilers and local hosts" :maps false) (js-object :name "persistent-tree-walk" :suite "persistent-tree-walk" :source "tests/fixtures/persistent-tree-walk.eli" :assertion "persistent tree walk is stack safe and agrees across compilers and hosts" :maps false) (js-object :name "persistent-zipper" :suite "persistent-zipper" :source "tests/fixtures/persistent-zipper.eli" :assertion "persistent zippers navigate edit and rebuild stack-safe trees" :maps false) (js-object :name "core-text-object" :suite "core-text-object" :source "stdlib/core/text.eli" :assertion "core text/object production artifacts are fixed-point and cross-host" :maps false) (js-object :name "interop-js" :suite "interop-js" :source "stdlib/interop/js.eli" :mapRoot "stdlib" :assertion "Eliscript JS interop preserves explicit host and persistent boundaries") (js-object :name "declarative-protocol" :suite "declarative-protocol" :source "tests/fixtures/declarative-protocol.eli" :assertion "declarative protocols preserve protocol identity and host dispatch") (js-object :name "declarative-record" :suite "declarative-record" :source "tests/fixtures/declarative-record.eli" :assertion "defrecord is identical across seed and self-hosted compilers" :maps false) (js-object :name "declarative-type" :suite "declarative-type" :source "tests/fixtures/declarative-type.eli" :assertion "deftype and reify agree across compilers and hosts" :maps false) (js-object :name "multimethod" :suite "multimethod" :assertion "Eliscript multimethods dispatch on values with persistent method snapshots") (js-object :name "core-expression-forms" :suite "core-expression-forms" :source "tests/fixtures/core-expression-forms.eli" :assertion "core expression forms preserve threading and single-evaluation semantics" :maps false) (js-object :name "local-recursive-functions" :suite "local-recursive-functions" :source "tests/fixtures/local-recursive-functions.eli" :assertion "local recursive functions agree across compilers and local hosts" :maps false) (js-object :name "multi-arity" :suite "multi-arity" :source "tests/fixtures/multi-arity.eli" :assertion "multi-arity functions agree across compilers and local hosts" :maps false) (js-object :name "value-dispatch" :suite "value-dispatch" :source "tests/fixtures/value-dispatch.eli" :assertion "case and condp agree across compilers and local hosts" :maps false) (js-object :name "literal-runtime" :suite "literal-runtime" :source "tests/fixtures/literal-runtime.eli" :assertion "persistent literals and quoted data preserve language value categories" :begin "    expect(nodeReport).toEqual(bunReport);") (js-object :name "atom" :suite "atom" :source "stdlib/state/atom.eli" :assertion "Eliscript Atom preserves ordered single-transition state semantics") (js-object :name "eliscript-protocol" :suite "eliscript-protocol" :source "stdlib/core/protocol.eli" :assertion "Eliscript-authored protocol policy preserves open dispatch semantics")) :concat (js-call (js-array "vector" "map" "set") :map (lambda (collection) (js-object :name (str "persistent-core-exit-" collection) :suite "persistent-core-exit" :source "stdlib/value.eli" :baseId (str "persistent-core-exit-" collection) :idSuffix collection :locals (str "const collection=" (globalThis.JSON.stringify collection) ";") :assertion "persistent collection core closes its all-host million-value exit gate" :begin "      expect(reports[1]).toEqual(reports[0]);" :end "\n    }\n  } finally {" :maps false))) (js-array (js-object :name "language-equality" :suite "language-equality" :source "tests/fixtures/language-equality.eli" :assertion "language equal uses value semantics across compilers and local hosts" :begin "    const expected = {" :end "    const identitySource ="))))

  (defun runtime-json-source (value) (str "(JSON/parse " (JSON/stringify (JSON/stringify value)) ")"))

  (defun runtime-host-program (ctx base plan helpers timeout)
    (let* ((root (get ctx :sourceRoot))
           (original-execution (get base :execution))
           (fixture (get original-execution :host))
           (arguments (get original-execution :arguments
             (js-call (get original-execution :argumentModules (js-array (get base :entry)))
               :map (lambda (id) (js-object :module id)))))
           (process-url (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-process.mjs")) :href))
           (helper-inputs (js-call helpers :map (lambda (helper)
             (js-object :javascript (get helper :javascript)))))
           (settings (js-object :entry (get base :entry) :fixture fixture :arguments arguments
             :mapRoot (get plan :mapRoot ".") :module (get plan :name)
             :modulePath (get plan :modulePath (get base :entry))
             :libraryRoot (get plan :libraryRoot ".")
             :usage (get base :entry) :timeout timeout
             :pruningOnly (get plan :pruningOnly false) :collection (get plan :idSuffix)
             :runFixture (get plan :runFixture t)))
           (source (str
      "(module original.runtime.assertions\n"
      " (import \"node:path\" resolve) (import \"node:url\" pathToFileURL) (import \"node:process\" :default process)\n"
      " (import " (JSON/stringify process-url) " readOriginalCorpusExecutionContext originalCorpusExecutionPolicy runOriginalCorpusProcess)\n"
      " (defconst host-import (js* \"(specifier) => import(specifier)\"))\n"
      " (defconst settings " (runtime-json-source settings) ")\n"
      " (import \"node:buffer\" Buffer)\n"
      " (defconst helpers " (runtime-json-source helper-inputs) ")\n"
      " (defasync original-report (engine product fixture arguments)\n"
      "  (let* ((env (Object/assign (js-object) (get process :env)))\n"
      "    (root (get env :ELISCRIPT_ORIGINAL_SOURCE_ROOT))\n"
      "    (context (readOriginalCorpusExecutionContext (get env :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT)))\n"
      "    (bun (= engine \"bun\")) (command (if bun (get env :BUN (get process :execPath)) (get env :NODE \"node\")))\n"
      "    (flags (if bun (js-array \"--preload\" (resolve root \"tests/fixtures/compiled-eli-bun-preload.mjs\"))\n"
      "      (js-array \"--experimental-loader\" (resolve root \"tests/fixtures/compiled-eli-node-loader.mjs\")))))\n"
      "    (when (and bun (get env :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT))\n"
      "      (js-call flags :push \"--preload\" (resolve root \"tools/backends/compiler-corpus-host-context.mjs\")))\n"
      "    (js-call flags :push (resolve product fixture))\n"
      "    (js-call arguments :forEach (lambda (argument)\n"
      "      (js-call flags :push (cond ((get argument :directory) product)\n"
      "        ((Object/hasOwn argument \"literal\") (get argument :literal))\n"
      "        ((= (value-type (get argument :module)) \"string\") (resolve product (get argument :module)))\n"
      "        (t (throw (new globalThis.TypeError \"original host argument lost its exact source form\")))))))\n"
      "    (let ((receipt (await (runOriginalCorpusProcess command flags\n"
      "      (Object/assign (js-object) context (js-object :cwd root :env env\n"
      "        :directory (resolve (get context :directory) (str \"runtime-observation-\" engine))\n"
      "        :policy (originalCorpusExecutionPolicy (Object/assign (js-object) context\n"
      "          (js-object :record (js-object :id (get context :caseId) :execution (js-object :timeoutMs (get settings :timeout))))))))))))\n"
      "      (get receipt :stdout))))\n"
      " (defasync main ()\n"
      "  (let* ((product (aref (get process :argv) 2)) (env (get process :env))\n"
      "    (javascript (get env :ELISCRIPT_ORIGINAL_JAVASCRIPT_PRODUCT_ROOT product))\n"
      "    (fixture (if (nullish? (get settings :fixture)) (get settings :entry) (get settings :fixture)))\n"
      "    (arguments (if (nullish? (get settings :fixture)) (js-array) (get settings :arguments)))\n"
      "    (reports (js-array)) (rawOutputs (js-array)) (output undefined))\n"
      "    (when (get settings :runFixture)\n"
      "      (let ((bun (await (original-report \"bun\" product fixture arguments)))\n"
      "            (node (await (original-report \"node\" product fixture arguments))))\n"
      "        (setq output bun) (js-call rawOutputs :push bun node) (js-call reports :push (JSON/parse bun) (JSON/parse node))))\n"
      "    (let ((input (js-object :product product :javascriptRoot (resolve javascript (get settings :mapRoot))\n"
      "      :module (get settings :module) :directory product :output output :rawOutputs rawOutputs :reports reports :report (aref reports 0)\n"
      "      :modulePath (resolve javascript (get settings :modulePath))\n"
      "      :selectedModulePath (resolve product (get settings :entry))\n"
      "      :outputRoot (resolve product (get settings :libraryRoot))\n"
      "      :usage (resolve product (get settings :usage))\n"
      "      :pruningOnly (get settings :pruningOnly) :collection (get settings :collection)\n"
      "      :prunedModulePath (resolve javascript (str (get settings :module) \".mjs\")))))\n"
      "      (let ((index 0)) (while (< index (js-length helpers))\n"
      "        (let ((module (await (funcall host-import (str \"data:text/javascript;base64,\"\n"
      "          (js-call (Buffer/from (get (aref helpers index) :javascript) \"utf8\") :toString \"base64\"))))))\n"
      "          (await (js-call module :run_original_assertions input)))\n"
      "        (setq index (1+ index)))))))\n"
      " (defconst completion (main))\n"
      " (js-call completion :catch (lambda (error) (console/error error) (put process :exitCode 1)))\n"
      " (defun then (fulfill reject) (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject)) (export then))\n")))
      (compile-string source "original-runtime-assertions-host.eli")))

  (defasync publish-runtime-assertions (ctx plan base titles mode id)
    (let* ((suite (get plan :suite)) (locators (get ctx :locators)) (text (get ctx :text)) (file (get ctx :file))
           (source (await (funcall text suite))) (identity (await (funcall file suite)))
           (helpers (js-array)) (owners (js-array)) (regions (js-array)) (coverage (new globalThis.Set))
           (source-assets (js-array)) (timeout 0) (index 0))
      (unless base (throw (new globalThis.TypeError (str "original runtime program graph is unavailable: " id))))
      (while (< index (js-length titles))
        (let* ((title (aref titles index)) (input (await (runtime-maintained-case ctx suite title)))
               (owner (get (get input :locator) :originalCase))
               (actual-mode (if (= mode "auto")
                 (if (js-call (runtime-nodes (get input :callback)) :some (lambda (node) (source-head node "withPortableLibraries"))) "context" "reports") mode))
               (helper (await (runtime-assertion-helper ctx suite title actual-mode))))
          (when (or (not (Number/isFinite (get owner :timeoutMs))) (<= (get owner :timeoutMs) 0))
            (throw (new globalThis.TypeError "original runtime case requires its positive original deadline")))
          (setq timeout (if (> (get owner :timeoutMs) timeout) (get owner :timeoutMs) timeout))
          (js-call helpers :push helper) (js-call owners :push (Object/assign (js-object :id (get (get input :locator) :id)) (globalThis.structuredClone owner)))
          (js-call regions :push (runtime-owner-region source owner))
          (js-call (get helper :sourceAssets) :forEach (lambda (asset) (js-call source-assets :push asset)))
          (js-call locators :forEach (lambda (locator)
            (when (and (= (get locator :file) suite)
              (if (get locator :originalExecution) (= (get (get locator :originalExecution) :record) id)
                (if (get locator :originalCase) (= (get (get locator :originalCase) :title) title)
                  (and (= (value-type (get locator :contains)) "string")
                    (js-call (str title "\n" (js-call source :slice (get (get owner :span) :start) (get (get owner :span) :end))) :includes (get locator :contains))))))
              (js-call coverage :add (get locator :id))))))
        (setq index (1+ index)))
      (when (= (get coverage :size) 0) (throw (new globalThis.TypeError (str "original runtime assertions lost their exact coverage: " id))))
      (let* ((fixture (get (get base :execution) :host))
             (host-source (get (get base :execution) :hostSource))
             (request (merge-objs (globalThis.structuredClone (get base :request)) (js-object :phased t)))
             (maintained (globalThis.structuredClone (get (aref helpers 0) :maintainedSource)))
             (pruning (get plan :pruningOnly false)))
        (when (and fixture (= (value-type host-source) "string"))
          (put request :hostSources (js-call (get request :hostSources (js-array)) :concat
            (js-array (js-object :id fixture :filename fixture :source host-source)))))
        (when pruning
          (put request :portableEntries (js-array (get plan :portableEntry))))
        (let ((h 1))
          (while (< h (js-length helpers))
            (Reflect/apply (get (get maintained :sourceRegions) :push) (get maintained :sourceRegions)
              (get (get (aref helpers h) :maintainedSource) :sourceRegions))
            (setq h (1+ h))))
        (js-call (get (get base :original) :sourceAssets (js-array)) :forEach (lambda (asset) (js-call source-assets :push asset)))
        (funcall (get ctx :add) (merge-objs (globalThis.structuredClone base) (js-object :id id :kind "project" :coverage (Array/from coverage)
          :modules (globalThis.structuredClone (get base :modules)) :entry (get base :entry) :request request
          :execution (js-object :kind "original-program" :host (str "tests/__eliscript_original_" (js-call id :replaceAll ":" "_") ".mjs")
            :hostSource (runtime-host-program ctx base plan helpers timeout) :arguments (js-array (js-object :directory t))
            :aliases t :requiresBun t :hostRuntime "bun" :compilerSourceMaps t :childProcesses "inherit-selected-artifact" :timeoutMs timeout)
          :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
          :original (js-object :manifest "stable-compatibility" :suite suite :host suite
            :sourceSha256 (get identity :sha256) :originalAssertion titles :originalCases owners
            :completeOriginalCaseCoverage false :regions regions :maintainedSource maintained
            :nativeInstrumentationScope (when (= suite "tests/core-stdlib.test.mjs")
              (js-object :kind "javascript-host-implementation-counters" :version 1
                :executedTargets (js-array "javascript") :notEvaluatedTargets (js-array "wasm" "native")
                :functionalInputCount 50000 :functionalResultsUnchanged t))
            :sourceAssets source-assets :helperPrograms (js-call helpers :map (lambda (helper) (js-object :sha256 (get helper :helpersSha256)))) :setupReplacement (js-object :kind "actual-selected-library-artifacts"
              :originalAssertions "compiled unchanged from authenticated maintained source"
              :compilerSetup "executed by the actual selected compiler matrix request"
              :cliSetupAssertions "original CLI stdout and per-build counts remain mandatory in the unchanged original suites; not asserted by this matrix runtime projection"
              :splitPruning pruning))))))))

  (defasync add-indexed-runtime-records (ctx)
    (let ((records (get ctx :records)) (locators (get ctx :locators)) (text (get ctx :text)) (file (get ctx :file)) (add (get ctx :add)))
      (let* ((suite "tests/persistent-zipper.test.mjs")
             (title "deep zipper ascent reads indexed ancestor slots without reducing wide parent vectors"))
        (when (js-call locators :some (lambda (item) (= (get item :file) suite)))
          (let* ((original (await (text suite)))
                 (input (await (runtime-maintained-case ctx suite title)))
                 (owner (get (get input :locator) :originalCase))
                 (fixture "tests/fixtures/persistent-zipper-indexed-host.mjs")
                 (fixture-source (await (text fixture))) (fixture-identity (await (file fixture)))
                 (maintained-file "tests/fixtures/persistent-zipper-indexed-host.eli")
                 (maintained-identity (await (file maintained-file)))
                 (base (js-call records :find (lambda (record)
                   (= (get record :id) "stable-compatibility:program:tests/fixtures/persistent-zipper.eli")))))
            (unless base (throw (new globalThis.TypeError "original indexed zipper graph is unavailable")))
            (add (js-object :id "original-program:persistent-zipper-indexed-ascent" :kind "project"
              :coverage (runtime-case-coverage locators suite title "original-program:persistent-zipper-indexed-ascent")
              :modules (globalThis.structuredClone (get base :modules)) :entry (get base :entry)
              :request (merge-objs (globalThis.structuredClone (get base :request))
                (js-object :phased t :hostSources (js-call (get (get base :request) :hostSources (js-array)) :concat
                  (js-array (js-object :id fixture :filename fixture :source fixture-source)))))
              :execution (js-object :kind "original-program" :host "tests/__eliscript_original_zipper_indexed_ascent.mjs"
                :hostSource (str "import {resolve} from \"node:path\";\nimport {pathToFileURL} from \"node:url\";\n"
                  "const product=process.argv[2];process.argv=[process.execPath,'indexed-zipper.mjs',resolve(product,'stdlib/core/zipper.eli')];\n"
                  "await import(pathToFileURL(resolve(product," (JSON/stringify fixture) ")).href);\n")
                :arguments (js-array (js-object :directory t)) :aliases t :requiresBun t :hostRuntime "bun"
                :childProcesses "inherit-selected-artifact" :timeoutMs (get owner :timeoutMs))
              :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
              :original (js-object :manifest "stable-compatibility" :suite suite :host suite
                :sourceSha256 (get (await (file suite)) :sha256) :originalAssertion title
                :regions (js-array (runtime-owner-region original owner))
                :maintainedSource (js-object :sourceFile (get input :file)
                  :sourceSha256 (get (await (file (get input :file))) :sha256)
                  :sourceRegions (js-array (source-node-proof (get input :source) (get input :callback))))
                :sourceAssets (js-array
                  (js-object :file fixture :sourceSha256 (get fixture-identity :sha256))
                  (js-object :file maintained-file :sourceSha256 (get maintained-identity :sha256)))))))))
      (let* ((suite "tests/language-equality.test.mjs")
             (title "language equal uses value semantics across compilers and local hosts")
             (id "original-program:language-equality-identity-only"))
        (when (js-call locators :some (lambda (item) (= (get item :file) suite)))
          (let* ((input (await (runtime-maintained-case ctx suite title)))
                 (pending (js-array (get input :callback))) (sources (js-array))
                 (entry "tests/fixtures/identity.mjs")
                 (base (js-call records :find (lambda (record)
                   (= (get record :id) "stable-compatibility:program:tests/fixtures/language-equality.eli")))))
            (while (> (js-length pending) 0)
              (let* ((node (js-call pending :shift)) (items (get node :items)))
                (when (Array/isArray items)
                  (when (and (source-head node "Bun/write") (= (get (aref items 1) :name) "identitySource")
                             (and (= (get (aref items 2) :kind) "literal") (= (value-type (get (aref items 2) :value)) "string")))
                    (js-call sources :push (get (aref items 2) :value)))
                  (Reflect/apply (get pending :push) pending items))))
            (unless (and base (= (js-length sources) 1))
              (throw (new globalThis.TypeError "original identity input or graph changed")))
            (let* ((helper (await (runtime-assertion-helper ctx suite title "identity-shape")))
                   (link (helper-transport helper "run_original_assertions")))
              (add (js-object :id id :kind "project" :coverage (runtime-case-coverage locators suite title id)
                :modules (js-array (js-object :id entry :filename "identity-only.eli" :source (aref sources 0))) :entry entry
                :request (merge-objs (globalThis.structuredClone (get base :request)) (js-object :entries (js-array entry)))
                :execution (js-object :kind "original-program" :host "tests/__eliscript_original_identity_shape.mjs"
                  :hostSource (str "import {resolve} from \"node:path\";\n" link
                    "const product=process.argv[2],reference=process.env.ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT,javascript=process.env.ELISCRIPT_ORIGINAL_JAVASCRIPT_PRODUCT_ROOT??product;\n"
                    "if(!reference)throw new Error('original identity comparison requires its actual independent reference');\n"
                    "await run_original_assertions({product,javascriptRoot:javascript,modulePath:resolve(javascript,"
                    (JSON/stringify entry) "),referenceModulePath:resolve(reference," (JSON/stringify entry) "),reports:[]});\n")
                  :arguments (js-array (js-object :directory t)) :aliases t :requiresBun t :hostRuntime "bun"
                  :referenceArtifact t :compilerSourceMaps t :timeoutMs (get (get (get input :locator) :originalCase) :timeoutMs))
                :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
                :original (js-object :manifest "stable-compatibility" :suite suite :host suite
                  :sourceSha256 (get (await (file suite)) :sha256) :originalAssertion title
                  :regions (js-array (runtime-owner-region (get input :artifact) (get (get input :locator) :originalCase)))
                  :maintainedSource (get helper :maintainedSource) :sourceAssets (get helper :sourceAssets)
                  :setupReplacement (js-object :kind "actual-selected-and-independent-seed-artifacts"))))))))
      nil))

  (defasync addOriginalStdlibRuntimeAdapters (ctx)
    (let* ((records (get ctx :records)) (locators (get ctx :locators))
           (file (get ctx :file)) (text (get ctx :text)) (add (get ctx :add))
           (mapped (js-array)) (index 0))
      (while (< index (js-length runtime-stdlib-plans))
        (let* ((input (aref runtime-stdlib-plans index))
               (suite (str "tests/stdlib-" (get input :name) ".test.mjs")))
          (when (js-call locators :some (lambda (item) (= (get item :file) suite)))
            (let* ((base (js-call records :find (lambda (record)
                      (= (get record :id) (str "stable-compatibility:program:tests/fixtures/" (get input :name) "-usage.eli")))))
                   (plan (merge-objs input (js-object :suite suite
                     :modulePath (str "tests/fixtures/" (get input :library) ".mjs")))))
              (await (publish-runtime-assertions ctx plan base (js-array (get input :assertion)) "usage"
                (str "original-program:stdlib-" (get input :name) "-complete-host")))
              (js-call mapped :push suite))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length runtime-callable-plans))
        (let* ((input (aref runtime-callable-plans index)) (name (get input :name))
               (suite (str "tests/stdlib-" name ".test.mjs")))
          (when (js-call locators :some (lambda (item) (= (get item :file) suite)))
            (let* ((base (js-call records :find (lambda (record)
                     (= (get record :id) (str "stable-compatibility:program:tests/fixtures/" name "-usage.eli")))))
                   (plan (merge-objs input (js-object :suite suite :runFixture (= name "deferred") :libraryRoot "tests/fixtures/stdlib")))
                   (source (await (runtime-maintained-case ctx suite (aref (get input :assertions) 0))))
                   (suite-identity (await (file suite)))
                   (maintained-identity (await (file (get source :file))))
                   (expected (runtime-output-expectation source)))
              (unless base (throw (new globalThis.TypeError "original callable library graph is unavailable")))
              (js-call (js-array "bun" "node") :forEach (lambda (host)
                (funcall add (merge-objs (globalThis.structuredClone base)
                  (js-object :id (str "original-program:stdlib-" name "-output-" host)
                    :coverage (runtime-case-coverage locators suite (aref (get input :assertions) 0) "")
                    :request (merge-objs (globalThis.structuredClone (get base :request)) (js-object :phased t))
                    :execution (js-object :kind "original-program" :host nil :hostRuntime host :aliases t :requiresBun (= host "bun"))
                    :expected (js-object :kind "seed-program" :oracleRequired t :stdoutJSON expected)
                    :original (js-object :manifest "stable-compatibility" :suite suite :host suite
                      :sourceSha256 (get suite-identity :sha256)
                      :fixture (str "tests/fixtures/" name "-usage.eli")
                      :originalAssertion (get input :assertions)
                      :regions (js-array (runtime-owner-region (get source :artifact) (get (get source :locator) :originalCase)))
                      :maintainedSource (js-object :sourceFile (get source :file) :sourceSha256 (get maintained-identity :sha256)
                        :sourceRegions (js-array (source-node-proof (get source :source) (get source :callback))))))))))
              (await (publish-runtime-assertions ctx plan base (get input :assertions) "callables"
                (str "original-program:stdlib-" name "-complete-callables")))
              (js-call mapped :push suite))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length runtime-history-plans))
        (let* ((input (aref runtime-history-plans index))
               (suite (str "tests/" (get input :suite (str "portable-" (get input :name))) ".test.mjs")))
          (when (js-call locators :some (lambda (item) (= (get item :file) suite)))
            (let ((base (js-call records :find (lambda (record)
                    (= (get record :id) (str "stable-compatibility:program:stdlib/" (get input :name) ".eli")))))
                  (test-index 0))
              (while (< test-index (js-length (get input :tests)))
                (await (publish-runtime-assertions ctx (merge-objs input (js-object :suite suite :runFixture false)) base
                  (js-array (aref (get input :tests) test-index)) "history"
                  (str "original-program:portable-" (get input :name) "-" test-index)))
                (setq test-index (1+ test-index))))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length runtime-portable-plans))
        (let* ((input (aref runtime-portable-plans index)) (suite (str "tests/" (get input :suite) ".test.mjs")))
          (when (js-call locators :some (lambda (item) (= (get item :file) suite)))
            (let* ((source (get input :source (str "stdlib/" (get input :name) ".eli")))
                   (base (js-call records :find (lambda (record)
                      (= (get record :id) (str "stable-compatibility:program:" (get input :baseId source))))))
                   (plan (merge-objs input (js-object :suite suite)))
                   (case (await (runtime-maintained-case ctx suite (get input :assertion))))
                   (pruning (runtime-pruning-node case))
                   (id (str "original-program:" (get input :suite) "-complete-hosts"
                         (if (get input :idSuffix) (str "-" (get input :idSuffix)) ""))))
              (await (publish-runtime-assertions ctx plan base (js-array (get input :assertion))
                (if (= (get input :name) "language-equality") "equality" "auto") id))
              (when pruning
                (let* ((entry (aref (get pruning :items) 2)) (exported (get entry :value)))
                  (unless (and (= (get entry :kind) "literal") (= (value-type exported) "string"))
                    (throw (new globalThis.TypeError "original pruning export must remain a literal entry name")))
                  (await (publish-runtime-assertions ctx
                    (merge-objs plan (js-object :pruningOnly t :runFixture false :portableEntry exported))
                    base (js-array (get input :assertion)) "pruning" (str "original-program:" (get input :suite) "-pruned")))))
              (js-call mapped :push suite))))
        (setq index (1+ index)))
      (await (add-indexed-runtime-records ctx))
      mapped))

  (export originalRuntimeSourceSuites originalRuntimeCaseLocators originalRuntimeHostArtifact isOriginalRuntimeHostOnly originalRuntimeOnlyCase addOriginalStdlibRuntimeAdapters))
