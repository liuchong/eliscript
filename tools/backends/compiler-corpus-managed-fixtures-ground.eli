  (defun fixture-host-prelude (source-root)
    (str "import assert from 'node:assert/strict';\n"
      "import {readFile} from 'node:fs/promises';\n"
      "import {resolve} from 'node:path';\n"
      "import {pathToFileURL} from 'node:url';\n"
