      (JSON/stringify (get (pathToFileURL (resolve source-root "tools/backends/compiler-corpus-fixture-runtime.mjs")) :href))
      ";\nconst fixture=await openOriginalFixtureRuntime(__ELISCRIPT_ORIGINAL_AUTO__);\n"
      "const {root,product,entry,reference,m,oracle,runtime,compare,outcome,named,finish}=fixture;\n"))

  (defasync fixture-runtime-assets (file)
    (let ((assets (js-array)))
      (let ((files (js-array "tools/backends/eliscript/compiler-corpus-fixture-runtime.eli"
                            "tools/backends/compiler-corpus-fixture-runtime.mjs")) (index 0))
        (while (< index (js-length files))
          (let* ((filename (aref files index)) (identity (await (funcall file filename))))
            (js-call assets :push (js-object :file filename :sourceSha256 (get identity :sha256))))
          (setq index (1+ index))))
      assets))

  (defasync fixture-scenario-body (name source-root file &optional call-arguments)
    (let ((assets (js-array))
          (files (js-array "tools/backends/eliscript/compiler-corpus-fixture-scenarios.eli"
                           "tools/backends/compiler-corpus-fixture-scenarios.mjs"))
          (prefix "") (arguments (or call-arguments "fixture")) (index 0))
      (when (= name "functionProperties")
        (js-call files :push "tests/helpers/wasm-managed-function-properties-node.eli"
                            "tests/helpers/wasm-managed-function-properties-node.mjs")
        (setq prefix (str "import {reflection_keys as reflectionKeys} from "
          (JSON/stringify (get (pathToFileURL (resolve source-root "tests/helpers/wasm-managed-function-properties-node.mjs")) :href)) ";\n"))
        (setq arguments "fixture,reflectionKeys"))
      (while (< index (js-length files))
        (let* ((filename (aref files index)) (identity (await (funcall file filename))))
          (js-call assets :push (js-object :file filename :sourceSha256 (get identity :sha256))))
        (setq index (1+ index)))
      (js-object :sourceAssets assets :maintainedSource nil
        :body (str prefix "import {" name " as runFixtureScenario} from "
          (JSON/stringify (get (pathToFileURL (resolve source-root "tools/backends/compiler-corpus-fixture-scenarios.mjs")) :href))
          ";\nrunFixtureScenario(" arguments ");\n"))))

  (defun fixture-body-assets (body common)
    (let ((assets (js-call common :slice)))
      (unless (= (typeof-str body) "string")
        (unless (Array/isArray (get body :sourceAssets))
          (throw (new globalThis.TypeError "maintained fixture body requires its source assets")))
        (js-call (get body :sourceAssets) :forEach
          (lambda (asset)
            (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
              (if (undefined? previous) (js-call assets :push asset)
                (unless (= (get previous :sourceSha256) (get asset :sourceSha256))
                  (throw (new globalThis.TypeError "maintained fixture runtime source identity conflicts"))))))))
      assets))
