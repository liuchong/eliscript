        (catch error (throw (new globalThis.TypeError
          (str "original managed template " name ": " (get error :message))))))))

  (defasync fixture-helper (ctx suite names aliases extra)
    (let* ((helper (await (maintained-helper ctx suite names extra names)))
           (body (helper-transport helper aliases)))
      (js-object :body body :sourceAssets (get helper :sourceAssets)
        :maintainedSource (get helper :maintainedSource) :helpersSha256 (get helper :helpersSha256))))

  (defasync math-prefix (ctx)
    (let* ((file "tests/helpers/wasm-managed-math-node.mjs")
           (source-file "tests/helpers/wasm-managed-math-node.eli")
           (url (get (pathToFileURL (resolve (get ctx :sourceRoot) file)) :href)))
      (js-object :body (str "const {unary_names:unaryNames,constants,method_lengths:methodLengths,primitives,adjacent,"
        "fround_boundaries:froundBoundaries,fround_random:froundRandom,f16_model:f16Model,f16_boundaries:f16Boundaries,"
        "sum_precise_model:sumPreciseModel,sum_samples:sumSamples,sum_iterator_observation:sumIteratorObservation}=await import("
        (JSON/stringify url) ");\n")
        :sourceAssets (js-array
          (js-object :file file :sourceSha256 (get (await (funcall (get ctx :file) file)) :sha256))
          (js-object :file source-file :sourceSha256 (get (await (funcall (get ctx :file) source-file)) :sha256))))))

  (defasync reflection-source (ctx suite)
    (let* ((helper-file "tests/helpers/wasm-managed-function-properties-node.mjs")
           (helper-url (get (pathToFileURL (resolve (get ctx :sourceRoot) helper-file)) :href))
           (helper (await (maintained-helper ctx suite (js-array "reflection-source")
             (str "(import " (JSON/stringify helper-url) " well-known-symbol-names)") (js-array "reflection-source"))))
           (namespace (await (funcall (js* "(specifier) => import(specifier)")
             (helper-module-url (get helper :javascript))))))
      (unless (= (value-type (get namespace :reflection_source)) "string")
        (throw (new globalThis.TypeError "original reflection extension must be source text")))
      (get namespace :reflection_source)))
  (defasync fixture-model-scenario (ctx name prefix arguments)
    (let ((scenario (await (fixture-scenario-body name (get ctx :sourceRoot) (get ctx :file) arguments))))
      (put prefix :sourceAssets (fixture-body-assets prefix (get scenario :sourceAssets)))
      (put prefix :body (str (get prefix :body) (get scenario :body)))
      prefix))
  (defasync mathBody (source ctx)
    (let ((prefix (await (math-prefix ctx))))
      (await (fixture-model-scenario ctx "math" prefix "fixture,{unaryNames,constants,methodLengths,primitives,froundBoundaries,froundRandom,f16Model,f16Boundaries,sumPreciseModel,sumSamples,sumIteratorObservation}"))))
  (defasync numberBody (source ctx)
