                           (= (get signatures "heap-capacity") 1)
                           (= (get signatures "heap-live") 1)
                           (= (get signatures "frame-depth") 1)
                           (= (get signatures "heap-collections") 1))))
                  (setq has-fast-ops
                    (funcall globalThis.Boolean
                      (and has-tuple-header
                           (= (get signatures "heap-pin") 2)
                           (= (get signatures "heap-release") 2)
                           (= (get signatures "value-number") 3)
                           (= (get signatures "value-string") 2)
                           (= (get signatures "value-seal") 2)
                           (= (get signatures "value-array-new") 2)
                           (= (get signatures "value-array-resize") 3)
                           (= (get signatures "value-set") 4)
                           (= (get signatures "value-object-has") 3)
                           (= (get signatures "value-object-put") 5)
                           (= (get signatures "value-foreign-new") 3)
                           (= (get signatures "value-foreign-constructor-set") 3)
                           (= (get signatures "value-table-put") 4)
                           (= (get signatures "value-table-add") 3)
                           (= (get signatures "value-table-has") 3)
                           (= (get signatures "value-table-delete") 3)
                           (= (get signatures "value-table-get") 3)
                           (= (get signatures "value-table-clear") 2)
                           (= (get signatures "value-table-size") 2))))
                  (setq has-current-this
                    (funcall globalThis.Boolean
                      (and has-tuple-header (= (get signatures "value-function-current-this") 1))))
                  (setq has-call-restore
                    (funcall globalThis.Boolean
                      (and has-tuple-header (= (get signatures "value-call-restore") 2))))
                  (setq has-call-reset
                    (funcall globalThis.Boolean
                      (and has-tuple-header (= (get signatures "value-call-reset") 1))))
                  (setq has-exception-take
                    (funcall globalThis.Boolean
                      (and has-tuple-header (= (get signatures "value-exception-take") 1))))
                  (setq has-exception-class
                    (funcall globalThis.Boolean
                      (and has-tuple-header (= (get signatures "value-exception-class") 1))))
                  (setq has-exception-class-set
                    (funcall globalThis.Boolean
                      (and has-tuple-header (= (get signatures "value-exception-class-set") 2))))
                  (setq has-exception-clear
                    (funcall globalThis.Boolean
                      (and has-tuple-header (= (get signatures "value-exception-clear") 1))))
