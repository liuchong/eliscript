                     (js-array h
                       (if (= (aref args 0) "heap-used") result (js-call memory :invoke "heap-used" h))
                       (js-call memory :invoke "heap-capacity" h)
                       (js-call memory :invoke "heap-live" h)
                       (js-call memory :invoke "frame-depth" h)
                       (js-call memory :invoke "heap-collections" h))))))
              ((= method "getUint16")
               (setq result (Reflect/apply (get memory :getUint16) memory args)))
              ((= method "getUint32")
               (setq result (Reflect/apply (get memory :getUint32) memory args)))
              ((= method "getFloat64")
