    (let ((id callback-sequence)
          (tuple undefined))
      (when (and has-tuple-header (> argv 3) (= (js-call memory :invoke "last-error") 0))
        (when (and (= (js-call memory :invoke "value-kind" heap argv) 7)
                   (= (js-call memory :invoke "last-error") 0))
          (let ((count (js-call memory :invoke "value-length" heap argv)))
            (when (and (= (js-call memory :invoke "last-error") 0) (>= count 0) (<= count 8))
              (let ((offset (if (> count 0) (js-call memory :invoke "value-data" heap argv 7) 0)))
                (when (= (js-call memory :invoke "last-error") 0)
                  (let ((items (js-array)) (kinds (js-array)) (tokens (js-array))
                        (strings (js-array)) (numbers (js-array)) (symbols (js-array))
