          (put apply-tuple-pool argc tuple)
          (try (js-call memory :invoke "heap-release" heap tuple) (catch ignored nil))))
      (try (js-call memory :invoke "heap-release" heap tuple) (catch ignored nil))))
  (defun execute-fast-apply (spec)
    (let ((heap (unsigned-bit-shift-right (get spec :heap) 0))
          (hoisted-index (get spec :hoistedIndex))
          (invoke-name (get spec :invokeName))
          (has-hoisted false)
          (target-raw VAL64_NIL)
          (receiver (get spec :receiver))
          (args (get spec :args))
          (previous-this VAL64_UNDEFINED)
          (pinned-previous-this false)
          (target-frame undefined)
          (root-mark 0)
          (call-entered false)
          (pooled-tuple undefined)
          (pooled-argc 0)
          (pinned (js-array)))
      (setq has-hoisted (and (Number/isInteger hoisted-index) (>= hoisted-index 0) (= (value-type invoke-name) "string")))
      (unless has-hoisted
        (setq target-raw (fast-value (get spec :targetRaw))))
