(module tools.backends.native-node-runner
  (import "node:fs" readSync writeSync)
  (import "node:worker_threads" Worker)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./native-memory.mjs" openNativeMemory)
  (import "./compiler-worker.mjs" errorData)
  (import "./managed-layout.mjs"
    normalize-u64 val64-singleton-p val64-inline-number-p val64-dynamic-p
    val64-decode-inline-number bits64-u64-to-f64 words64-to-u64 encode-inline-f64-words
    f64-raw-collides-p VAL64_NIL VAL64_FALSE VAL64_TRUE VAL64_UNDEFINED VAL64_HOLE)

  (defun runner-module-url ()
    (let* ((stack (str (get (new globalThis.Error) :stack)))
           (file-match (js-call (new globalThis.RegExp (+ "(file" "://[^\\s):]+\\.mjs):\\d+:\\d+")) :exec stack)))
      (if file-match
        (aref file-match 1)
        (let ((path-match (js-call (new globalThis.RegExp "(/[^\\s():]+\\.mjs):\\d+:\\d+") :exec stack)))
          (if path-match
            (get (pathToFileURL (aref path-match 1)) :href)
            (get (pathToFileURL (resolve "tools/backends/native-node-runner.mjs")) :href))))))

  (defvar memory undefined)
  (defvar has-last-error false)
  (defvar has-tuple-header false)
  (defvar has-foreign-token false)
  (defvar has-collections false)
  (defvar has-heap-stats false)
  (defvar has-fast-ops false)
  (defvar has-current-this false)
  (defvar has-call-restore false)
  (defvar has-call-reset false)
  (defvar has-exception-take false)
  (defvar has-exception-class false)
  (defvar has-exception-class-set false)
  (defvar has-exception-clear false)
  (defvar has-root-scope-mark false)
  (defvar has-root-scope-unwind false)
  (defvar callback-sequence 0)
  (defvar remainder (Buffer/alloc 0))
  (defvar eof false)
  (defconst pending-foreign (js-array))
  (defconst fast-number-buffer (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
  (defconst input (Buffer/allocUnsafe 65536))
  (defconst host-failures (new globalThis.WeakMap))
  (defconst pause (new globalThis.Int32Array (new globalThis.SharedArrayBuffer 4)))
  (defconst decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))

  ;; The JSON channel transports exact tagged values and IEEE special Numbers.
  ;; Source objects remain in their owning process and cross as foreign tokens.
  (defun wire-replacer (key value)
    (cond
      ((= (value-type value) "bigint") (js-object :__v64 (str (normalize-u64 value))))
      ((and (= (value-type value) "number")
            (or (not (Number/isFinite value)) (Object/is value (* -1 0))))
       (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
         (js-call bits :setFloat64 0 value t)
         (js-object :__f64 (js-array (js-call bits :getUint32 0 t) (js-call bits :getUint32 4 t)))))
      (t value)))
  (defun wire-reviver (key value)
    (if (and (not (nullish? value)) (= (value-type value) "object")
             (= (js-length (Object/keys value)) 1))
      (cond
        ((Object/hasOwn value "__v64")
         (unless (= (value-type (get value :__v64)) "string")
           (throw (new globalThis.TypeError "invalid native Val64 wire value")))
         (normalize-u64 (funcall globalThis.BigInt (get value :__v64))))
        ((Object/hasOwn value "__f64")
         (let ((words (get value :__f64))
               (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
           (unless (and (Array/isArray words) (= (js-length words) 2)
                        (js-call words :every (lambda (word)
                          (and (Number/isInteger word) (>= word 0) (<= word 4294967295)))))
             (throw (new globalThis.TypeError "invalid native f64 wire value")))
           (js-call bits :setUint32 0 (aref words 0) t)
           (js-call bits :setUint32 4 (aref words 1) t)
           (js-call bits :getFloat64 0 t)))
        (t value))
      value))

  (defun fast-value (value)
    (unless (= (value-type value) "bigint")
      (throw (new globalThis.TypeError "native managed value must be a bigint")))
    (normalize-u64 value))
  (defun fast-number-from-words (heap low high)
    (if (f64-raw-collides-p low high)
      (normalize-u64 (invoke-checked "value-number" heap low high))
      (words64-to-u64 (encode-inline-f64-words low high))))
  (defun fast-number (heap value)
    (js-call fast-number-buffer :setFloat64 0 value t)
    (fast-number-from-words heap
      (js-call fast-number-buffer :getUint32 0 t)
      (js-call fast-number-buffer :getUint32 4 t)))

  (defun alloc-fast-string (heap str)
    (let* ((len (unsigned-bit-shift-right (js-length str) 0))
           (val (fast-value (invoke-checked "value-string" heap len)))
           (off (invoke-checked "value-data" heap val 5))
           (i 0))
      (while (< i len)
        (js-call memory :setUint16 (+ off (* i 2)) (js-call str :charCodeAt i) t)
        (setq i (1+ i)))
      (invoke-checked "value-seal" heap val)
      val))

  (defun execute-fast-op (heap op)
    (let ((fast-op (get op :fastOp)))
      (cond
        ((= fast-op "number")
         (fast-number-from-words heap
           (unsigned-bit-shift-right (get op :low) 0)
           (unsigned-bit-shift-right (get op :high) 0)))
        ((= fast-op "string") (alloc-fast-string heap (get op :value)))
        ((= fast-op "string-array")
         (let* ((list (get op :strings)) (count (js-length list))
                (arr (fast-value (invoke-checked "value-array-new" heap count))) (i 0))
           (invoke-checked "heap-pin" heap arr)
           (try
             (while (< i count)
               (invoke-checked "value-set" heap arr i (alloc-fast-string heap (aref list i)))
               (setq i (1+ i)))
             (finally (js-call memory :invoke "heap-release" heap arr)))
           arr))
        ((= fast-op "array-new")
         (fast-value (invoke-checked "value-array-new" heap (get op :length))))
        ((= fast-op "foreign-new")
         (let* ((identity (unsigned-bit-shift-right (get op :identity) 0))
                (raw (fast-value (invoke-checked "value-foreign-new" heap identity
                                  (if (get op :callable) 1 0)))))
           (when (get op :constructible)
             (invoke-checked "value-foreign-constructor-set" heap raw 1))
           (js-call pending-foreign :push (js-array identity raw)) raw))
        ((= fast-op "array-set")
         (let ((receiver (fast-value (get op :receiver))) (index (get op :index))
               (length (get op :length)) (value (fast-value (get op :value))))
           (when (>= index length)
             (invoke-checked "value-array-resize" heap receiver (1+ index)))
           (invoke-checked "value-set" heap receiver index value)
           VAL64_TRUE))
        ((= fast-op "object-put")
         (let ((args (fast-value (get op :arguments)))
               (receiver (fast-value (get op :receiver)))
               (key (fast-value (get op :key))) (value (fast-value (get op :value))))
           (invoke-checked "heap-pin" heap args)
           (try (invoke-checked "value-object-put" heap receiver key value 2)
             (finally (js-call memory :invoke "heap-release" heap args)))
           VAL64_TRUE))
        ((= fast-op "table-op")
         (let* ((args (fast-value (get op :arguments)))
                (target (fast-value (get op :target))) (kind (get op :kind))
                (arg0 (fast-value (get op :arg0))) (arg1 (fast-value (get op :arg1)))
                (offset (invoke-checked "value-data" heap target kind))
                (table (js-call memory :getBigUint64 offset t)) (mode (get op :mode)))
           (cond
             ((= mode "put")
              (invoke-checked "heap-pin" heap args)
              (try (invoke-checked "value-table-put" heap table arg0 arg1)
                (finally (js-call memory :invoke "heap-release" heap args))) target)
             ((= mode "add")
              (invoke-checked "heap-pin" heap args)
              (try (invoke-checked "value-table-add" heap table arg0)
                (finally (js-call memory :invoke "heap-release" heap args))) target)
             ((= mode "has")
              (if (/= (invoke-checked "value-table-has" heap table arg0) 0) VAL64_TRUE VAL64_FALSE))
             ((= mode "delete")
              (if (/= (invoke-checked "value-table-delete" heap table arg0) 0) VAL64_TRUE VAL64_FALSE))
             ((= mode "get") (fast-value (invoke-checked "value-table-get" heap table arg0)))
             ((= mode "clear") (invoke-checked "value-table-clear" heap table) VAL64_UNDEFINED)
             ((= mode "size") (fast-number heap (invoke-checked "value-table-size" heap table)))
             (t (throw (new globalThis.TypeError "unknown fast table op"))))))
        (t (throw (new globalThis.TypeError "unknown native fastOp"))))))

  (defun parse-fast-request (text)
    (let ((parts (js-call text :split " ")))
      (unless (and (>= (js-length parts) 2) (js-call (aref parts 0) :startsWith "F") (= (aref parts 1) "invoke"))
        (throw (new globalThis.TypeError "invalid native fast request")))
      (let ((id (funcall globalThis.Number (js-call (aref parts 0) :slice 1)))
            (args (js-array))
            (index 2))
        (unless (and (Number/isSafeInteger id) (>= id 1))
          (throw (new globalThis.TypeError "invalid native fast request")))
        (while (< index (js-length parts))
          (let* ((token (aref parts index)) (tag (js-call token :charAt 0)) (body (js-call token :slice 1)))
            (cond
              ((= tag "s")
               (unless (> (js-length body) 0) (throw (new globalThis.TypeError "invalid native fast request")))
               (js-call args :push body))
              ((= tag "n")
               (let ((value (funcall globalThis.Number body)))
                 (unless (and (Number/isSafeInteger value) (>= value 0) (<= value 4294967295))
                   (throw (new globalThis.TypeError "invalid native fast request")))
                 (js-call args :push value)))
              ((= tag "b")
               (js-call args :push (normalize-u64 (funcall globalThis.BigInt body))))
              (t (throw (new globalThis.TypeError "invalid native fast request")))))
          (setq index (1+ index)))
        (js-object :id id :method "invoke" :args args :fast t))))
  (defun fast-result-line (record)
    (when (and (Number/isSafeInteger (get record :id)) (>= (get record :id) 1)
               (Number/isSafeInteger (get record :lastError)) (>= (get record :lastError) 0)
               (<= (get record :lastError) 4294967295)
               (not (Object/hasOwn record "heapStats"))
               (not (Object/hasOwn record "error"))
               (not (Object/hasOwn record "hostError"))
               (not (Object/hasOwn record "callback")))
      (let* ((result (get record :result))
             (body (cond
                    ((eq result nil) "z")
                    ((= (value-type result) "boolean") (if result "t" "f"))
                    ((= (value-type result) "number")
                     ;; Number.isSafeInteger(-0) is true and would emit n0.
                     (when (and (Number/isSafeInteger result) (not (Object/is result (* -1 0)))
                                (>= result 0) (<= result 4294967295))
                       (str "n" result)))
                    ((= (value-type result) "bigint") (str "b" (normalize-u64 result)))
                    (t nil))))
        (when body (str "R" (get record :id) " " (get record :lastError) " " body)))))
  (defun read-packet ()
    (let ((pieces (js-array)) (length 0) (done false) (result nil))
      (while (not done)
        (let ((end (js-call remainder :indexOf 10)))
          (if (>= end 0)
            (let* ((tail (js-call remainder :subarray 0 end))
                   (bytes (if (> (js-length pieces) 0)
                            (Buffer/concat (js-call pieces :concat (js-array tail)) (+ length (js-length tail)))
                            tail)))
              (setq remainder (js-call remainder :subarray (1+ end)))
              (setq result (if (and (> (js-length bytes) 0) (= (aref bytes 0) 70))
                             (parse-fast-request (js-call decoder :decode bytes))
                             (JSON/parse (js-call decoder :decode bytes) wire-reviver)))
              (setq done t))
            (progn
              (when (> (js-length remainder) 0)
                (js-call pieces :push remainder)
                (setq length (+ length (js-length remainder)))
                (setq remainder (Buffer/alloc 0)))
              (if eof
                (progn
                  (when (> length 0)
                    (throw (new globalThis.Error "incomplete native transport request")))
                  (setq result nil)
                  (setq done t))
                (let ((count undefined) (retry false))
                  (try
                    (setq count (readSync 0 input 0 (js-length input) nil))
                    (catch error
                      (let ((code (if (nullish? error) undefined (get error :code))))
                        (cond
                          ((= code "EINTR") (setq retry t))
                          ((or (= code "EAGAIN") (= code "EWOULDBLOCK"))
                           (Atomics/wait pause 0 0 1)
                           (setq retry t))
                          (t (throw error))))))
                  (unless retry
                    (if (= count 0)
                      (setq eof t)
                      ;; Keep each filled read buffer once, then join a complete packet once.
                      ;; Growing the entire prefix here copies large compiler inputs repeatedly.
                      (setq remainder (Buffer/from (js-call input :subarray 0 count)))))))))))
      result))

  (defun send (record &rest supplied)
    (let* ((fast (when (eq (aref supplied 0) t) (fast-result-line record)))
           (bytes (Buffer/from (if fast (str fast "\n") (str (JSON/stringify record wire-replacer) "\n"))))
           (offset 0))
      (while (< offset (js-length bytes))
        (try
          (let ((written (writeSync 1 bytes offset (- (js-length bytes) offset) nil)))
            (when (= written 0)
              (throw (new globalThis.Error "native transport output made no progress")))
            (setq offset (+ offset written)))
          (catch error
            (let ((code (if (nullish? error) undefined (get error :code))))
              (cond
                ((= code "EINTR") nil)
                ((or (= code "EAGAIN") (= code "EWOULDBLOCK"))
                 (Atomics/wait pause 0 0 1))
                (t (throw error)))))))))

  (defun describe (error)
    (errorData error (js-object :transport "json")))

  (defun decode-short-string (heap v)
    (let ((len (js-call memory :invoke "value-length" heap v)))
      (cond
        ((= len 0) "")
        ((<= len 1024)
         (let ((str-off (js-call memory :invoke "value-data" heap v 5))
               (units (js-array))
               (j 0))
           (while (< j len)
             (js-call units :push (js-call memory :getUint16 (+ str-off (* j 2)) t))
             (setq j (1+ j)))
           (Reflect/apply globalThis.String.fromCharCode globalThis.String units)))
        (t nil))))

  (defun decode-finite-number (heap v)
    (let ((n (if (val64-inline-number-p v)
               (val64-decode-inline-number v)
               (bits64-u64-to-f64 (invoke-checked "value-number-bits" heap v)))))
      (if (and (Number/isFinite n) (not (Object/is n (* -1 0)))) n nil)))

  (defun decode-symbol-pair (heap v)
    (let ((sym-off (js-call memory :invoke "value-data" heap v 22)))
      (js-array (js-call memory :getUint32 (- sym-off 20) t)
        (js-call memory :getUint32 (- sym-off 16) t))))

  (defun invoke-checked (name &rest args)
    (let ((value (Reflect/apply (get memory :invoke) memory (js-call (js-array name) :concat args)))
          (code (js-call memory :invoke "last-error")))
      (unless (= code 0)
        (throw (js-object :__fastApplyRuntimeError code)))
      value))

  (defun flush-pending-foreign (heap)
    (if (= (js-length pending-foreign) 0)
      undefined
      (let ((items (js-call pending-foreign :splice 0 (js-length pending-foreign)))
            (out (js-array))
            (saved-err (if has-last-error (js-call memory :invoke "last-error") 0))
            (collections (if has-collections (js-call memory :invoke "heap-collections" heap) -1))
            (i 0))
        (while (< i (js-length items))
          (let* ((pair (aref items i))
                 (token (aref pair 0))
                 (raw (aref pair 1))
                 (alive false))
            (if (and (not (val64-singleton-p raw)) has-foreign-token)
              (let ((k (js-call memory :invoke "value-kind" heap raw))
                    (err1 (js-call memory :invoke "last-error")))
                (if (and (= err1 0) (= k 35))
                  (let ((actual-tok (unsigned-bit-shift-right (js-call memory :invoke "value-foreign-token" heap raw) 0))
                        (err2 (js-call memory :invoke "last-error")))
                    (when (and (= err2 0) (= actual-tok token))
                      (setq alive t))
                    (when (/= err2 0)
                      (js-call memory :invoke "value-error-restore" 0)))
                  (when (/= err1 0)
                    (js-call memory :invoke "value-error-restore" 0))))
              (when (not (val64-singleton-p raw)) (setq alive t)))
            (js-call out :push (js-array token (if alive raw VAL64_NIL) (if alive collections -1))))
          (setq i (1+ i)))
        (when has-tuple-header
          (js-call memory :invoke "value-error-restore" saved-err))
        out)))

  (defun current-root-mark (heap)
    (if has-root-scope-mark
      (unsigned-bit-shift-right (invoke-checked "root-scope-mark" heap) 0)
      0))
  (defun restore-root-mark (heap mark)
    (when has-root-scope-unwind
      (try (js-call memory :invoke "root-scope-unwind" heap mark) (catch ignored nil))))
  (defun execute-fast-apply (spec)
    (let ((heap (unsigned-bit-shift-right (get spec :heap) 0))
          (target-raw (fast-value (get spec :targetRaw)))
          (receiver (get spec :receiver))
          (args (get spec :args))
          (previous-this VAL64_UNDEFINED)
          (pinned-previous-this false)
          (target-frame undefined)
          (root-mark 0)
          (call-entered false)
          (pinned (js-array)))
      (letfn ((pin-raw (r)
                (when (not (or (val64-singleton-p r) (val64-inline-number-p r)))
                  (invoke-checked "heap-pin" heap r)
                  (js-call pinned :push r))))
        (try
          (progn
            (when has-current-this
              (setq previous-this (fast-value (invoke-checked "value-function-current-this" heap)))
              (when (not (val64-singleton-p previous-this))
                (invoke-checked "heap-pin" heap previous-this)
                (setq pinned-previous-this t)))
            (setq target-frame (fast-value (invoke-checked "frame-current" heap))
                  root-mark (current-root-mark heap)
                  call-entered t)
            (when (= (get receiver :kind) "raw")
              (pin-raw (fast-value (get receiver :raw))))
            (let ((argc (js-length args))
                  (i 0))
              (while (< i argc)
                (let ((arg (aref args i)))
                  (when (= (get arg :kind) "raw")
                    (pin-raw (fast-value (get arg :raw)))))
                (setq i (1+ i)))
              (let ((tuple (fast-value (invoke-checked "value-refs" heap 7 argc)))
                    (allocated-foreign (new globalThis.Map)))
                (pin-raw tuple)
                (let* ((encode-arg
                         (lambda (arg is-this)
                           (let ((kind (get arg :kind)))
                             (cond
                               ((= kind "raw") (fast-value (get arg :raw)))
                               ((= kind "number")
                                (let* ((v (get arg :value))
                                       (num v))
                                  (js-call fast-number-buffer :setFloat64 0 num t)
                                  (let ((raw (fast-value (invoke-checked "value-number" heap
                                                 (js-call fast-number-buffer :getUint32 0 t)
                                                 (js-call fast-number-buffer :getUint32 4 t)))))
                                    (when is-this (pin-raw raw))
                                    raw)))
                               ((= kind "foreign")
                                (let ((token (unsigned-bit-shift-right (get arg :token) 0)))
                                  (if (js-call allocated-foreign :has token)
                                    (let ((raw (js-call allocated-foreign :get token)))
                                      (when is-this (pin-raw raw))
                                      raw)
                                    (let* ((slot (unsigned-bit-shift-right (get arg :slot) 0))
                                           (raw (fast-value (invoke-checked "value-foreign-new" heap token slot))))
                                      (when (get arg :constructible)
                                        (invoke-checked "value-foreign-constructor-set" heap raw 1))
                                      (js-call allocated-foreign :set token raw)
                                      (js-call pending-foreign :push (js-array token raw))
                                      (when is-this (pin-raw raw))
                                      raw))))
                               ((= kind "string")
                                (let* ((text (get arg :text))
                                       (len (unsigned-bit-shift-right (js-length text) 0))
                                       (raw (fast-value (invoke-checked "value-string" heap len))))
                                  (when (> len 0)
                                    (let ((off (invoke-checked "value-data" heap raw 5))
                                          (j 0))
                                      (while (< j len)
                                        (js-call memory :setUint16 (+ off (* j 2)) (js-call text :charCodeAt j) t)
                                        (setq j (1+ j)))))
                                  (invoke-checked "value-seal" heap raw)
                                  (when is-this (pin-raw raw))
                                  raw))
                               (t (throw (new globalThis.TypeError "unsupported fastApply argument")))))))
                       (this-raw (funcall encode-arg receiver t))
                       (idx 0))
                  (while (< idx argc)
                    (let ((item-raw (funcall encode-arg (aref args idx) false)))
                      (invoke-checked "value-set" heap tuple idx item-raw))
                    (setq idx (1+ idx)))
                  (let ((raw (fast-value (invoke-checked "value-source-invoke-with-this"
                                 heap target-raw this-raw tuple argc)))
                        (collections (if has-collections
                                       (invoke-checked "heap-collections" heap)
                                       -1)))
                    (if (val64-singleton-p raw)
                      (let ((synced (flush-pending-foreign heap)))
                        (js-object :kind "immediate" :raw raw :collections collections :pendingForeign synced))
                      (let ((res-kind (invoke-checked "value-kind" heap raw)))
                        (cond
                          ((= res-kind 4)
                           (let* ((v (if (val64-inline-number-p raw)
                                     (val64-decode-inline-number raw)
                                     (bits64-u64-to-f64 (invoke-checked "value-number-bits" heap raw))))
                                  (enc v)
                                  (synced (flush-pending-foreign heap)))
                             (js-object :kind "number" :value enc :collections collections :pendingForeign synced)))
                          ((and (= res-kind 5) (<= (invoke-checked "value-length" heap raw) 1024))
                           (let ((str (decode-short-string heap raw))
                                 (synced (flush-pending-foreign heap)))
                             (js-object :kind "string" :value str :collections collections :pendingForeign synced)))
                          (t
                           (let ((token (if (and (= res-kind 35) has-foreign-token)
                                          (unsigned-bit-shift-right (invoke-checked "value-foreign-token" heap raw) 0)
                                          0)))
                             (invoke-checked "heap-pin" heap raw)
                             (let ((synced (flush-pending-foreign heap)))
                               (js-object :kind "pinned" :raw raw :valueKind res-kind
                                 :token token :collections collections :pendingForeign synced))))))))))))
          (catch error
            (if (and (not (nil? error)) (= (value-type error) "object")
                     (Object/hasOwn error "__fastApplyRuntimeError"))
              (let ((code (get error :__fastApplyRuntimeError)))
                (if (and (= code 11) has-exception-take)
                  (let* ((thrown (fast-value (js-call memory :invoke "value-exception-take" heap)))
                         (take-err (js-call memory :invoke "last-error")))
                    (when call-entered
                      (try (js-call memory :invoke "frame-unwind" heap target-frame) (catch ignored nil))
                      (restore-root-mark heap root-mark)
                      (try (cond
                             (has-call-restore (js-call memory :invoke "value-call-restore" heap previous-this))
                             (has-call-reset (js-call memory :invoke "value-call-reset" heap)))
                        (catch ignored nil)))
                    (if (/= take-err 0)
                      (let ((synced (flush-pending-foreign heap)))
                        (js-object :kind "runtimeError" :code take-err :exceptionClass 0 :pendingForeign synced))
                      (let* ((thrown-kind (if (not (val64-singleton-p thrown)) (js-call memory :invoke "value-kind" heap thrown) 0))
                             (thrown-token (if (and (= thrown-kind 35) has-foreign-token)
                                             (unsigned-bit-shift-right (js-call memory :invoke "value-foreign-token" heap thrown) 0)
                                             0))
                             (thrown-pinned (and (not (val64-singleton-p thrown)) (/= thrown-kind 35))))
                        (when thrown-pinned
                          (js-call memory :invoke "heap-pin" heap thrown))
                        (let ((synced (flush-pending-foreign heap)))
                          (js-object :kind "thrown" :raw thrown :valueKind thrown-kind
                            :token thrown-token :pinned thrown-pinned :pendingForeign synced)))))
                  (let ((cls (if has-exception-class
                               (unsigned-bit-shift-right (js-call memory :invoke "value-exception-class" heap) 0)
                               0)))
                    (when has-exception-class-set
                      (js-call memory :invoke "value-exception-class-set" heap 0))
                    (when call-entered
                      (try (js-call memory :invoke "frame-unwind" heap target-frame) (catch ignored nil))
