              ((= method "size")
               (setq result (get memory :byteLength)))
              ((= method "invoke")
               (setq result (Reflect/apply (get memory :invoke) memory args))
               (when has-last-error
                 (setq last-error
                   (if (= (aref args 0) "last-error")
                     result
                     (js-call memory :invoke "last-error"))))
               (when (and has-heap-stats (= last-error 0) (= (js-length args) 2)
                          (or (= (aref args 0) "heap-collect") (= (aref args 0) "heap-used")))
                 (let ((h (aref args 1)))
