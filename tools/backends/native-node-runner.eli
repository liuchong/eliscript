        (progn
          (unless (and (Number/isSafeInteger id) (>= id 1))
            (throw (new globalThis.TypeError "invalid native transport invocation")))
          (when (= method "open")
            (throw (new globalThis.Error "native memory is already open")))
          (unless memory
            (throw (new globalThis.Error "native memory is closed")))
          (let ((result undefined) (last-error undefined) (heap-stats undefined))
