  (defconst decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))

  ;; The JSON channel transports exact tagged values and IEEE special Numbers.
  ;; Source objects remain in their owning process and cross as foreign tokens.
  (defun wire-replacer (key value)
    (cond
      ((= (value-type value) "bigint") (js-object :__v64 (str (normalize-u64 value))))
      ((and (= (value-type value) "number")
            (or (not (Number/isFinite value)) (Object/is value (* -1 0))))
       (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
         (js-call bits :setFloat64 0 value t)
         (js-object :__f64 (js-array (js-call bits :getUint32 0 t) (js-call bits :getUint32 4 t)))))
      (t value)))
  (defun wire-reviver (key value)
    (if (and (not (nullish? value)) (= (value-type value) "object")
             (= (js-length (Object/keys value)) 1))
      (cond
        ((Object/hasOwn value "__v64")
         (unless (= (value-type (get value :__v64)) "string")
           (throw (new globalThis.TypeError "invalid native Val64 wire value")))
         (normalize-u64 (funcall globalThis.BigInt (get value :__v64))))
        ((Object/hasOwn value "__f64")
         (let ((words (get value :__f64))
               (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
           (unless (and (Array/isArray words) (= (js-length words) 2)
                        (js-call words :every (lambda (word)
                          (and (Number/isInteger word) (>= word 0) (<= word 4294967295)))))
             (throw (new globalThis.TypeError "invalid native f64 wire value")))
           (js-call bits :setUint32 0 (aref words 0) t)
           (js-call bits :setUint32 4 (aref words 1) t)
           (js-call bits :getFloat64 0 t)))
        (t value))
      value))

  (defun fast-value (value)
    (unless (= (value-type value) "bigint")
      (throw (new globalThis.TypeError "native managed value must be a bigint")))
    (normalize-u64 value))
  (defun fast-number-from-words (heap low high)
    (if (f64-raw-collides-p low high)
      (normalize-u64 (invoke-checked "value-number" heap low high))
      (words64-to-u64 (encode-inline-f64-words low high))))
  (defun fast-number (heap value)
    (js-call fast-number-buffer :setFloat64 0 value t)
    (fast-number-from-words heap
      (js-call fast-number-buffer :getUint32 0 t)
      (js-call fast-number-buffer :getUint32 4 t)))

  (defun alloc-fast-string (heap str)
    (let* ((len (unsigned-bit-shift-right (js-length str) 0))
           (val (fast-value (invoke-checked "value-string" heap len)))
           (off (invoke-checked "value-data" heap val 5))
           (i 0))
      (while (< i len)
        (js-call memory :setUint16 (+ off (* i 2)) (js-call str :charCodeAt i) t)
        (setq i (1+ i)))
      (invoke-checked "value-seal" heap val)
      val))

  (defun execute-fast-op (heap op)
    (let ((fast-op (get op :fastOp)))
      (cond
        ((= fast-op "number")
         (fast-number-from-words heap
           (unsigned-bit-shift-right (get op :low) 0)
           (unsigned-bit-shift-right (get op :high) 0)))
        ((= fast-op "string") (alloc-fast-string heap (get op :value)))
        ((= fast-op "string-array")
         (let* ((list (get op :strings)) (count (js-length list))
                (arr (fast-value (invoke-checked "value-array-new" heap count))) (i 0))
           (invoke-checked "heap-pin" heap arr)
           (try
             (while (< i count)
               (invoke-checked "value-set" heap arr i (alloc-fast-string heap (aref list i)))
               (setq i (1+ i)))
             (finally (js-call memory :invoke "heap-release" heap arr)))
           arr))
        ((= fast-op "array-new")
         (fast-value (invoke-checked "value-array-new" heap (get op :length))))
        ((= fast-op "foreign-new")
         (let* ((identity (unsigned-bit-shift-right (get op :identity) 0))
                (raw (fast-value (invoke-checked "value-foreign-new" heap identity
                                  (if (get op :callable) 1 0)))))
           (when (get op :constructible)
             (invoke-checked "value-foreign-constructor-set" heap raw 1))
           (js-call pending-foreign :push (js-array identity raw)) raw))
        ((= fast-op "array-set")
         (let ((receiver (fast-value (get op :receiver))) (index (get op :index))
               (length (get op :length)) (value (fast-value (get op :value))))
           (when (>= index length)
             (invoke-checked "value-array-resize" heap receiver (1+ index)))
           (invoke-checked "value-set" heap receiver index value)
           VAL64_TRUE))
        ((= fast-op "object-put")
         (let ((args (fast-value (get op :arguments)))
               (receiver (fast-value (get op :receiver)))
               (key (fast-value (get op :key))) (value (fast-value (get op :value))))
           (invoke-checked "heap-pin" heap args)
           (try (invoke-checked "value-object-put" heap receiver key value 2)
             (finally (js-call memory :invoke "heap-release" heap args)))
           VAL64_TRUE))
        ((= fast-op "table-op")
         (let* ((args (fast-value (get op :arguments)))
                (target (fast-value (get op :target))) (kind (get op :kind))
                (arg0 (fast-value (get op :arg0))) (arg1 (fast-value (get op :arg1)))
                (offset (invoke-checked "value-data" heap target kind))
                (table (js-call memory :getBigUint64 offset t)) (mode (get op :mode)))
           (cond
             ((= mode "put")
              (invoke-checked "heap-pin" heap args)
              (try (invoke-checked "value-table-put" heap table arg0 arg1)
                (finally (js-call memory :invoke "heap-release" heap args))) target)
             ((= mode "add")
              (invoke-checked "heap-pin" heap args)
              (try (invoke-checked "value-table-add" heap table arg0)
                (finally (js-call memory :invoke "heap-release" heap args))) target)
             ((= mode "has")
              (if (/= (invoke-checked "value-table-has" heap table arg0) 0) VAL64_TRUE VAL64_FALSE))
             ((= mode "delete")
              (if (/= (invoke-checked "value-table-delete" heap table arg0) 0) VAL64_TRUE VAL64_FALSE))
             ((= mode "get") (fast-value (invoke-checked "value-table-get" heap table arg0)))
             ((= mode "clear") (invoke-checked "value-table-clear" heap table) VAL64_UNDEFINED)
             ((= mode "size") (fast-number heap (invoke-checked "value-table-size" heap table)))
             (t (throw (new globalThis.TypeError "unknown fast table op"))))))
        (t (throw (new globalThis.TypeError "unknown native fastOp"))))))

  (defun parse-fast-request (text)
    (let ((parts (js-call text :split " ")))
      (unless (and (>= (js-length parts) 2) (js-call (aref parts 0) :startsWith "F") (= (aref parts 1) "invoke"))
        (throw (new globalThis.TypeError "invalid native fast request")))
      (let ((id (funcall globalThis.Number (js-call (aref parts 0) :slice 1)))
            (args (js-array))
            (index 2))
        (unless (and (Number/isSafeInteger id) (>= id 1))
          (throw (new globalThis.TypeError "invalid native fast request")))
        (while (< index (js-length parts))
          (let* ((token (aref parts index)) (tag (js-call token :charAt 0)) (body (js-call token :slice 1)))
            (cond
              ((= tag "s")
               (unless (> (js-length body) 0) (throw (new globalThis.TypeError "invalid native fast request")))
               (js-call args :push body))
              ((= tag "n")
               (let ((value (funcall globalThis.Number body)))
                 (unless (and (Number/isSafeInteger value) (>= value 0) (<= value 4294967295))
                   (throw (new globalThis.TypeError "invalid native fast request")))
                 (js-call args :push value)))
              ((= tag "b")
               (js-call args :push (normalize-u64 (funcall globalThis.BigInt body))))
              (t (throw (new globalThis.TypeError "invalid native fast request")))))
          (setq index (1+ index)))
        (js-object :id id :method "invoke" :args args :fast t))))
  (defun fast-result-line (record)
    (when (and (Number/isSafeInteger (get record :id)) (>= (get record :id) 1)
               (Number/isSafeInteger (get record :lastError)) (>= (get record :lastError) 0)
               (<= (get record :lastError) 4294967295)
               (not (Object/hasOwn record "heapStats"))
               (not (Object/hasOwn record "error"))
               (not (Object/hasOwn record "hostError"))
               (not (Object/hasOwn record "callback")))
      (let* ((result (get record :result))
             (body (cond
                    ((eq result nil) "z")
                    ((= (value-type result) "boolean") (if result "t" "f"))
                    ((= (value-type result) "number")
                     ;; Number.isSafeInteger(-0) is true and would emit n0.
                     (when (and (Number/isSafeInteger result) (not (Object/is result (* -1 0)))
                                (>= result 0) (<= result 4294967295))
                       (str "n" result)))
                    ((= (value-type result) "bigint") (str "b" (normalize-u64 result)))
                    (t nil))))
        (when body (str "R" (get record :id) " " (get record :lastError) " " body)))))
  (defun wire-encode-str (s)
    (if (and (= (js-call s :indexOf "\t") -1)
             (= (js-call s :indexOf "\n") -1)
             (= (js-call s :indexOf "\r") -1))
      (str "S" s)
      (str "Q" (JSON/stringify s))))
  (defun wire-decode-str (tok)
    (if (js-call tok :startsWith "S")
      (js-call tok :slice 1)
      (JSON/parse (js-call tok :slice 1))))
  (defun parse-compact-val (tok)
    (let ((tag (js-call tok :charAt 0)))
      (cond
        ((= tag "r") (js-object :kind "raw" :raw (normalize-u64 (funcall globalThis.BigInt (js-call tok :slice 1)))))
        ((= tag "n") (js-object :kind "number" :value (funcall globalThis.Number (js-call tok :slice 1))))
        ((= tag "m") (js-object :kind "number" :value (* -1 0)))
        ((or (= tag "S") (= tag "Q")) (js-object :kind "string" :text (wire-decode-str tok)))
        ((= tag "f")
         (let ((parts (js-call (js-call tok :slice 1) :split ":")))
           (js-object :kind "foreign"
             :token (funcall globalThis.Number (aref parts 0))
             :slot (funcall globalThis.Number (aref parts 1))
             :constructible (= (aref parts 2) "1"))))
        (t (throw (new globalThis.TypeError "invalid compact apply value"))))))
  (defun parse-compact-apply (text)
    (let* ((parts (js-call text :split "\t"))
           (id (funcall globalThis.Number (js-call (aref parts 0) :slice 1)))
           (heap (funcall globalThis.Number (aref parts 1)))
           (ttag (aref parts 2))
           (idx 3)
           (spec (js-object :heap heap)))
      (if (= ttag "R")
        (progn
          (put spec :targetRaw (normalize-u64 (funcall globalThis.BigInt (aref parts idx))))
          (setq idx (1+ idx)))
        (progn
          (put spec :hoistedIndex (funcall globalThis.Number (aref parts idx)))
          (put spec :invokeName (wire-decode-str (aref parts (1+ idx))))
          (setq idx (+ idx 2))))
      (put spec :receiver (parse-compact-val (aref parts idx)))
      (setq idx (1+ idx))
      (let ((argc (funcall globalThis.Number (aref parts idx)))
            (args (js-array))
            (ai 0))
        (setq idx (1+ idx))
        (while (< ai argc)
          (js-call args :push (parse-compact-val (aref parts (+ idx ai))))
          (setq ai (1+ ai)))
        (put spec :args args))
      (js-object :id id :method "fastApply" :compact t :args (js-array spec))))
  (defun parse-fast-get-request (text)
    (let* ((parts (js-call text :split "\t"))
           (id (funcall globalThis.Number (js-call (aref parts 0) :slice 1)))
           (heap (funcall globalThis.Number (aref parts 1)))
           (raw (normalize-u64 (funcall globalThis.BigInt (aref parts 2))))
           (key (wire-decode-str (aref parts 3))))
      (js-object :id id :method "fastGet" :args (js-array heap raw key))))
  (defun parse-release-batch-request (text)
    (let* ((parts (js-call text :split "\t"))
           (id (funcall globalThis.Number (js-call (aref parts 0) :slice 1)))
           (heap (funcall globalThis.Number (aref parts 1)))
           (items (if (> (js-length parts) 2) (aref parts 2) "")))
      (js-object :id id :method "releaseBatch" :args (js-array heap items))))
  (defun read-packet ()
    (let ((pieces (js-array)) (length 0) (done false) (result nil))
      (while (not done)
        (let ((end (js-call remainder :indexOf 10)))
          (if (>= end 0)
            (let* ((tail (js-call remainder :subarray 0 end))
                   (bytes (if (> (js-length pieces) 0)
                            (Buffer/concat (js-call pieces :concat (js-array tail)) (+ length (js-length tail)))
                            tail)))
              (setq remainder (js-call remainder :subarray (1+ end)))
              (let ((b0 (if (> (js-length bytes) 0) (aref bytes 0) 0)))
                (setq result (cond
                               ((= b0 70) (parse-fast-request (js-call decoder :decode bytes)))
                               ((= b0 65) (parse-compact-apply (js-call decoder :decode bytes)))
                               ((= b0 71) (parse-fast-get-request (js-call decoder :decode bytes)))
                               ((= b0 85) (parse-release-batch-request (js-call decoder :decode bytes)))
                               (t (JSON/parse (js-call decoder :decode bytes) wire-reviver)))))
              (setq done t))
            (progn
              (when (> (js-length remainder) 0)
                (js-call pieces :push remainder)
                (setq length (+ length (js-length remainder)))
                (setq remainder (Buffer/alloc 0)))
              (if eof
                (progn
                  (when (> length 0)
                    (throw (new globalThis.Error "incomplete native transport request")))
                  (setq result nil)
                  (setq done t))
                (let ((count undefined) (retry false))
                  (try
                    (setq count (readSync 0 input 0 (js-length input) nil))
                    (catch error
                      (let ((code (if (nullish? error) undefined (get error :code))))
                        (cond
                          ((= code "EINTR") (setq retry t))
                          ((or (= code "EAGAIN") (= code "EWOULDBLOCK"))
                           (Atomics/wait pause 0 0 1)
                           (setq retry t))
                          (t (throw error))))))
                  (unless retry
                    (if (= count 0)
                      (setq eof t)
                      ;; Keep each filled read buffer once, then join a complete packet once.
                      ;; Growing the entire prefix here copies large compiler inputs repeatedly.
                      (setq remainder (Buffer/from (js-call input :subarray 0 count)))))))))))
      result))

  (defun send-raw-line (line)
    (let ((bytes (Buffer/from (str line "\n")))
          (offset 0))
      (while (< offset (js-length bytes))
        (try
          (let ((written (writeSync 1 bytes offset (- (js-length bytes) offset) nil)))
            (when (= written 0)
              (throw (new globalThis.Error "native transport output made no progress")))
            (setq offset (+ offset written)))
          (catch error
            (let ((code (if (nullish? error) undefined (get error :code))))
              (cond
                ((= code "EINTR") nil)
                ((or (= code "EAGAIN") (= code "EWOULDBLOCK"))
                 (Atomics/wait pause 0 0 1))
                (t (throw error)))))))))
  (defun send (record &rest supplied)
    (let* ((fast (when (eq (aref supplied 0) t) (fast-result-line record)))
           (bytes (Buffer/from (if fast (str fast "\n") (str (JSON/stringify record wire-replacer) "\n"))))
           (offset 0))
      (while (< offset (js-length bytes))
        (try
          (let ((written (writeSync 1 bytes offset (- (js-length bytes) offset) nil)))
            (when (= written 0)
              (throw (new globalThis.Error "native transport output made no progress")))
            (setq offset (+ offset written)))
          (catch error
            (let ((code (if (nullish? error) undefined (get error :code))))
              (cond
                ((= code "EINTR") nil)
                ((or (= code "EAGAIN") (= code "EWOULDBLOCK"))
                 (Atomics/wait pause 0 0 1))
                (t (throw error)))))))))

  (defun describe (error)
    (errorData error (js-object :transport "json")))

  (defun decode-short-string (heap v)
    (let ((len (js-call memory :invoke "value-length" heap v)))
      (cond
        ((= len 0) "")
        ((<= len 1024)
         (let ((str-off (js-call memory :invoke "value-data" heap v 5))
               (units (js-array))
               (j 0))
