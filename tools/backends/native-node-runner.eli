                                   (js-call memory :getUint32 (- r-off 4) t)))
                               (let* ((ns (js-call memory :getUint32 (- r-off 12) t))
                                      (fl (js-call memory :getUint32 (- r-off 8) t))
                                      (ig (js-call memory :getUint32 (- r-off 4) t))
                                      (has-own (if (and (= ns 0) (= (bit-and fl 16416) 0) (= (bit-and ig 3) 0)
