(module tools.backends.native-node-runner
  (import "node:fs" readSync writeSync)
  (import "node:worker_threads" Worker)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./native-memory.mjs" openNativeMemory)
  (import "./compiler-worker.mjs" errorData)

  (defun runner-module-url ()
    (let* ((stack (str (get (new globalThis.Error) :stack)))
           (file-match (js-call (new globalThis.RegExp (+ "(file" "://[^\\s):]+\\.mjs):\\d+:\\d+")) :exec stack)))
      (if file-match
        (aref file-match 1)
        (let ((path-match (js-call (new globalThis.RegExp "(/[^\\s():]+\\.mjs):\\d+:\\d+") :exec stack)))
          (if path-match
            (get (pathToFileURL (aref path-match 1)) :href)
            (get (pathToFileURL (resolve "tools/backends/native-node-runner.mjs")) :href))))))

  (defvar memory undefined)
  (defvar has-last-error false)
  (defvar has-tuple-header false)
  (defvar has-foreign-token false)
  (defvar has-collections false)
  (defvar has-heap-stats false)
  (defvar has-fast-ops false)
  (defvar has-current-this false)
  (defvar has-call-restore false)
  (defvar has-call-reset false)
  (defvar has-exception-take false)
  (defvar has-exception-class false)
  (defvar has-exception-class-set false)
  (defvar has-exception-clear false)
  (defvar callback-sequence 0)
  (defvar remainder (Buffer/alloc 0))
  (defvar eof false)
  (defconst pending-foreign (js-array))
  (defconst fast-number-buffer (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
  (defconst input (Buffer/allocUnsafe 65536))
  (defconst host-failures (new globalThis.WeakMap))
  (defconst pause (new globalThis.Int32Array (new globalThis.SharedArrayBuffer 4)))
  (defconst decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))

  (defun alloc-fast-string (heap str)
    (let* ((len (unsigned-bit-shift-right (js-length str) 0))
           (val (unsigned-bit-shift-right (js-call memory :invoke "value-string" heap len) 0))
           (off (js-call memory :invoke "value-data" heap val 5))
           (i 0))
      (while (< i len)
        (js-call memory :setUint16 (+ off (* i 2)) (js-call str :charCodeAt i) t)
        (setq i (1+ i)))
      (js-call memory :invoke "value-seal" heap val)
      val))

  (defun execute-fast-op (heap op)
    (let ((fast-op (get op :fastOp)))
      (cond
        ((= fast-op "number")
         (unsigned-bit-shift-right
           (js-call memory :invoke "value-number" heap
             (unsigned-bit-shift-right (get op :low) 0)
             (unsigned-bit-shift-right (get op :high) 0))
           0))
        ((= fast-op "string")
         (alloc-fast-string heap (get op :value)))
        ((= fast-op "string-array")
         (let* ((list (get op :strings))
                (count (unsigned-bit-shift-right (js-length list) 0))
                (arr (unsigned-bit-shift-right (js-call memory :invoke "value-array-new" heap count) 0))
                (i 0))
           (js-call memory :invoke "heap-pin" heap arr)
           (try
             (while (< i count)
               (let ((s (alloc-fast-string heap (aref list i))))
                 (js-call memory :invoke "value-set" heap arr i s))
               (setq i (1+ i)))
             (finally (js-call memory :invoke "heap-release" heap arr)))
           arr))
        ((= fast-op "array-new")
         (unsigned-bit-shift-right
           (js-call memory :invoke "value-array-new" heap (unsigned-bit-shift-right (get op :length) 0))
           0))
        ((= fast-op "foreign-new")
         (let* ((identity (unsigned-bit-shift-right (get op :identity) 0))
                (raw (unsigned-bit-shift-right
                       (js-call memory :invoke "value-foreign-new" heap identity (if (get op :callable) 1 0))
                       0)))
           (when (get op :constructible)
             (js-call memory :invoke "value-foreign-constructor-set" heap raw 1))
           (js-call pending-foreign :push (js-array identity raw))
           raw))
        ((= fast-op "array-set")
         (let ((receiver (unsigned-bit-shift-right (get op :receiver) 0))
               (index (unsigned-bit-shift-right (get op :index) 0))
               (length (unsigned-bit-shift-right (get op :length) 0))
               (value (unsigned-bit-shift-right (get op :value) 0)))
           (when (>= index length)
             (js-call memory :invoke "value-array-resize" heap receiver (1+ index)))
           (js-call memory :invoke "value-set" heap receiver index value)
           2))
        ((= fast-op "object-put")
         (let ((args (unsigned-bit-shift-right (get op :arguments) 0))
               (receiver (unsigned-bit-shift-right (get op :receiver) 0))
               (key (unsigned-bit-shift-right (get op :key) 0))
               (value (unsigned-bit-shift-right (get op :value) 0)))
           (js-call memory :invoke "heap-pin" heap args)
           (try (js-call memory :invoke "value-object-put" heap receiver key value 2)
             (finally (js-call memory :invoke "heap-release" heap args)))
           2))
        ((= fast-op "table-op")
         (let* ((args (unsigned-bit-shift-right (get op :arguments) 0))
                (target (unsigned-bit-shift-right (get op :target) 0))
                (kind (unsigned-bit-shift-right (get op :kind) 0))
                (arg0 (unsigned-bit-shift-right (get op :arg0) 0))
                (arg1 (unsigned-bit-shift-right (get op :arg1) 0))
                (t-off (js-call memory :invoke "value-data" heap target kind))
                (table (js-call memory :getUint32 t-off t))
                (mode (get op :mode)))
           (cond
             ((= mode "put")
              (js-call memory :invoke "heap-pin" heap args)
              (try (js-call memory :invoke "value-table-put" heap table arg0 arg1)
                (finally (js-call memory :invoke "heap-release" heap args)))
              target)
             ((= mode "add")
              (js-call memory :invoke "heap-pin" heap args)
              (try (js-call memory :invoke "value-table-add" heap table arg0)
                (finally (js-call memory :invoke "heap-release" heap args)))
              target)
             ((= mode "has")
              (if (/= (js-call memory :invoke "value-table-has" heap table arg0) 0) 2 1))
             ((= mode "delete")
              (if (/= (js-call memory :invoke "value-table-delete" heap table arg0) 0) 2 1))
             ((= mode "get")
              (unsigned-bit-shift-right (js-call memory :invoke "value-table-get" heap table arg0) 0))
             ((= mode "clear")
              (js-call memory :invoke "value-table-clear" heap table)
              3)
             ((= mode "size")
              (let ((sz (unsigned-bit-shift-right (js-call memory :invoke "value-table-size" heap table) 0)))
                (js-call fast-number-buffer :setFloat64 0 sz t)
                (unsigned-bit-shift-right
                  (js-call memory :invoke "value-number" heap
                    (js-call fast-number-buffer :getUint32 0 t)
                    (js-call fast-number-buffer :getUint32 4 t))
                  0)))
             (t (throw (new globalThis.TypeError "unknown fast table op"))))))
        (t (throw (new globalThis.TypeError "unknown native fastOp"))))))

  (defun read-packet ()
    (let ((pieces (js-array)) (length 0) (done false) (result nil))
      (while (not done)
        (let ((end (js-call remainder :indexOf 10)))
          (if (>= end 0)
            (let* ((tail (js-call remainder :subarray 0 end))
                   (bytes (if (> (js-length pieces) 0)
                            (Buffer/concat (js-call pieces :concat (js-array tail)) (+ length (js-length tail)))
                            tail)))
              (setq remainder (js-call remainder :subarray (1+ end)))
              (setq result (JSON/parse (js-call decoder :decode bytes)))
              (setq done t))
            (progn
              (when (> (js-length remainder) 0)
                (js-call pieces :push remainder)
                (setq length (+ length (js-length remainder)))
                (setq remainder (Buffer/alloc 0)))
              (if eof
                (progn
                  (when (> length 0)
                    (throw (new globalThis.Error "incomplete native transport request")))
                  (setq result nil)
                  (setq done t))
                (let ((count undefined) (retry false))
                  (try
                    (setq count (readSync 0 input 0 (js-length input) nil))
                    (catch error
                      (let ((code (if (nullish? error) undefined (get error :code))))
                        (cond
                          ((= code "EINTR") (setq retry t))
                          ((or (= code "EAGAIN") (= code "EWOULDBLOCK"))
                           (Atomics/wait pause 0 0 1)
                           (setq retry t))
                          (t (throw error))))))
                  (unless retry
                    (if (= count 0)
                      (setq eof t)
                      ;; Keep each filled read buffer once, then join a complete packet once.
                      ;; Growing the entire prefix here copies large compiler inputs repeatedly.
                      (setq remainder (Buffer/from (js-call input :subarray 0 count)))))))))))
      result))

  (defun send (record)
    (let ((bytes (Buffer/from (+ (JSON/stringify record) "\n")))
          (offset 0))
      (while (< offset (js-length bytes))
        (try
          (let ((written (writeSync 1 bytes offset (- (js-length bytes) offset) nil)))
            (when (= written 0)
              (throw (new globalThis.Error "native transport output made no progress")))
            (setq offset (+ offset written)))
          (catch error
            (let ((code (if (nullish? error) undefined (get error :code))))
              (cond
                ((= code "EINTR") nil)
                ((or (= code "EAGAIN") (= code "EWOULDBLOCK"))
                 (Atomics/wait pause 0 0 1))
                (t (throw error)))))))))

  (defun describe (error)
    (errorData error (js-object :transport "json")))

  (defun decode-short-string (heap v)
    (let ((len (js-call memory :invoke "value-length" heap v)))
      (cond
        ((= len 0) "")
        ((<= len 1024)
         (let ((str-off (js-call memory :invoke "value-data" heap v 5))
               (units (js-array))
               (j 0))
           (while (< j len)
             (js-call units :push (js-call memory :getUint16 (+ str-off (* j 2)) t))
             (setq j (1+ j)))
           (Reflect/apply globalThis.String.fromCharCode globalThis.String units)))
        (t nil))))

  (defun decode-finite-number (heap v)
    (let* ((num-off (js-call memory :invoke "value-data" heap v 4))
           (n (js-call memory :getFloat64 num-off t)))
      (if (and (Number/isFinite n) (not (Object/is n (* -1 0)))) n nil)))

  (defun decode-symbol-pair (heap v)
    (let ((sym-off (js-call memory :invoke "value-data" heap v 22)))
      (js-array (js-call memory :getUint32 (- sym-off 20) t)
        (js-call memory :getUint32 (- sym-off 16) t))))

  (defun invoke-checked (name &rest args)
    (let ((value (Reflect/apply (get memory :invoke) memory (js-call (js-array name) :concat args)))
          (code (js-call memory :invoke "last-error")))
      (unless (= code 0)
        (throw (js-object :__fastApplyRuntimeError code)))
      value))

  (defun flush-pending-foreign (heap)
    (if (= (js-length pending-foreign) 0)
      undefined
      (let ((items (js-call pending-foreign :splice 0 (js-length pending-foreign)))
            (out (js-array))
            (saved-err (if has-last-error (js-call memory :invoke "last-error") 0))
            (collections (if has-collections (js-call memory :invoke "heap-collections" heap) -1))
            (i 0))
        (while (< i (js-length items))
          (let* ((pair (aref items i))
                 (token (aref pair 0))
                 (raw (aref pair 1))
                 (alive false))
            (if (and (> raw 3) has-foreign-token)
              (let ((k (js-call memory :invoke "value-kind" heap raw))
                    (err1 (js-call memory :invoke "last-error")))
                (if (and (= err1 0) (= k 35))
                  (let ((actual-tok (unsigned-bit-shift-right (js-call memory :invoke "value-foreign-token" heap raw) 0))
                        (err2 (js-call memory :invoke "last-error")))
                    (when (and (= err2 0) (= actual-tok token))
                      (setq alive t))
                    (when (/= err2 0)
                      (js-call memory :invoke "value-error-restore" 0)))
                  (when (/= err1 0)
                    (js-call memory :invoke "value-error-restore" 0))))
              (when (> raw 3) (setq alive t)))
            (js-call out :push (js-array token (if alive raw 0) (if alive collections -1))))
          (setq i (1+ i)))
        (when has-tuple-header
          (js-call memory :invoke "value-error-restore" saved-err))
        out)))

  (defun execute-fast-apply (spec)
    (let ((heap (unsigned-bit-shift-right (get spec :heap) 0))
          (target-raw (unsigned-bit-shift-right (get spec :targetRaw) 0))
          (receiver (get spec :receiver))
          (args (get spec :args))
          (previous-this 3)
          (pinned-previous-this false)
          (target-frame undefined)
          (call-entered false)
          (pinned (js-array)))
      (letfn ((pin-raw (r)
                (when (> r 3)
                  (invoke-checked "heap-pin" heap r)
                  (js-call pinned :push r))))
        (try
          (progn
            (when has-current-this
              (setq previous-this (unsigned-bit-shift-right (invoke-checked "value-function-current-this" heap) 0))
              (when (> previous-this 3)
                (invoke-checked "heap-pin" heap previous-this)
                (setq pinned-previous-this t)))
            (setq target-frame (unsigned-bit-shift-right (invoke-checked "frame-current" heap) 0)
                  call-entered t)
            (when (= (get receiver :kind) "raw")
              (pin-raw (unsigned-bit-shift-right (get receiver :raw) 0)))
            (let ((argc (js-length args))
                  (i 0))
              (while (< i argc)
                (let ((arg (aref args i)))
                  (when (= (get arg :kind) "raw")
                    (pin-raw (unsigned-bit-shift-right (get arg :raw) 0))))
                (setq i (1+ i)))
              (let ((tuple (unsigned-bit-shift-right (invoke-checked "value-refs" heap 7 argc) 0))
                    (allocated-foreign (new globalThis.Map)))
                (pin-raw tuple)
                (let* ((encode-arg
                         (lambda (arg is-this)
                           (let ((kind (get arg :kind)))
                             (cond
                               ((= kind "raw") (unsigned-bit-shift-right (get arg :raw) 0))
                               ((= kind "number")
                                (let* ((v (get arg :value))
                                       (num (cond
                                              ((= v "NaN") globalThis.NaN)
                                              ((= v "Infinity") globalThis.Infinity)
                                              ((= v "-Infinity") (- globalThis.Infinity))
                                              ((= v "-0") (* -1 0))
                                              (t v))))
                                  (js-call fast-number-buffer :setFloat64 0 num t)
                                  (let ((raw (unsigned-bit-shift-right
                                               (invoke-checked "value-number" heap
                                                 (js-call fast-number-buffer :getUint32 0 t)
                                                 (js-call fast-number-buffer :getUint32 4 t))
                                               0)))
                                    (when is-this (pin-raw raw))
                                    raw)))
                               ((= kind "foreign")
                                (let ((token (unsigned-bit-shift-right (get arg :token) 0)))
                                  (if (js-call allocated-foreign :has token)
                                    (let ((raw (js-call allocated-foreign :get token)))
                                      (when is-this (pin-raw raw))
                                      raw)
                                    (let* ((slot (unsigned-bit-shift-right (get arg :slot) 0))
                                           (raw (unsigned-bit-shift-right (invoke-checked "value-foreign-new" heap token slot) 0)))
                                      (when (get arg :constructible)
                                        (invoke-checked "value-foreign-constructor-set" heap raw 1))
                                      (js-call allocated-foreign :set token raw)
                                      (js-call pending-foreign :push (js-array token raw))
                                      (when is-this (pin-raw raw))
                                      raw))))
                               ((= kind "string")
                                (let* ((text (get arg :text))
                                       (len (unsigned-bit-shift-right (js-length text) 0))
                                       (raw (unsigned-bit-shift-right (invoke-checked "value-string" heap len) 0)))
                                  (when (> len 0)
                                    (let ((off (invoke-checked "value-data" heap raw 5))
                                          (j 0))
                                      (while (< j len)
                                        (js-call memory :setUint16 (+ off (* j 2)) (js-call text :charCodeAt j) t)
                                        (setq j (1+ j)))))
                                  (invoke-checked "value-seal" heap raw)
                                  (when is-this (pin-raw raw))
                                  raw))
                               (t (throw (new globalThis.TypeError "unsupported fastApply argument")))))))
                       (this-raw (funcall encode-arg receiver t))
                       (idx 0))
                  (while (< idx argc)
                    (let ((item-raw (funcall encode-arg (aref args idx) false)))
                      (invoke-checked "value-set" heap tuple idx item-raw))
                    (setq idx (1+ idx)))
                  (let ((raw (unsigned-bit-shift-right
                               (invoke-checked "value-source-invoke-with-this"
                                 heap target-raw this-raw tuple argc)
                               0))
                        (collections (if has-collections
                                       (invoke-checked "heap-collections" heap)
                                       -1)))
                    (if (<= raw 3)
                      (let ((synced (flush-pending-foreign heap)))
                        (js-object :kind "immediate" :raw raw :collections collections :pendingForeign synced))
                      (let ((res-kind (invoke-checked "value-kind" heap raw)))
                        (cond
                          ((= res-kind 4)
                           (let* ((off (invoke-checked "value-data" heap raw 4))
                                  (v (js-call memory :getFloat64 off t))
                                  (enc (cond
                                         ((Number/isNaN v) "NaN")
                                         ((= v globalThis.Infinity) "Infinity")
                                         ((= v (- globalThis.Infinity)) "-Infinity")
                                         ((Object/is v (* -1 0)) "-0")
                                         (t v)))
                                  (synced (flush-pending-foreign heap)))
                             (js-object :kind "number" :value enc :collections collections :pendingForeign synced)))
                          ((and (= res-kind 5) (<= (invoke-checked "value-length" heap raw) 1024))
                           (let ((str (decode-short-string heap raw))
                                 (synced (flush-pending-foreign heap)))
                             (js-object :kind "string" :value str :collections collections :pendingForeign synced)))
                          (t
                           (let ((token (if (and (= res-kind 35) has-foreign-token)
                                          (unsigned-bit-shift-right (invoke-checked "value-foreign-token" heap raw) 0)
                                          0)))
                             (invoke-checked "heap-pin" heap raw)
                             (let ((synced (flush-pending-foreign heap)))
                               (js-object :kind "pinned" :raw raw :valueKind res-kind
                                 :token token :collections collections :pendingForeign synced))))))))))))
          (catch error
            (if (and (not (nil? error)) (= (value-type error) "object")
                     (Object/hasOwn error "__fastApplyRuntimeError"))
              (let ((code (get error :__fastApplyRuntimeError)))
                (if (and (= code 11) has-exception-take)
                  (let* ((thrown (unsigned-bit-shift-right (js-call memory :invoke "value-exception-take" heap) 0))
                         (take-err (js-call memory :invoke "last-error")))
                    (when call-entered
                      (try (js-call memory :invoke "frame-unwind" heap target-frame) (catch ignored nil))
                      (try (cond
                             (has-call-restore (js-call memory :invoke "value-call-restore" heap previous-this))
                             (has-call-reset (js-call memory :invoke "value-call-reset" heap)))
                        (catch ignored nil)))
                    (if (/= take-err 0)
                      (let ((synced (flush-pending-foreign heap)))
                        (js-object :kind "runtimeError" :code take-err :exceptionClass 0 :pendingForeign synced))
                      (let* ((thrown-kind (if (> thrown 3) (js-call memory :invoke "value-kind" heap thrown) 0))
                             (thrown-token (if (and (= thrown-kind 35) has-foreign-token)
                                             (unsigned-bit-shift-right (js-call memory :invoke "value-foreign-token" heap thrown) 0)
                                             0))
                             (thrown-pinned (and (> thrown 3) (/= thrown-kind 35))))
                        (when thrown-pinned
                          (js-call memory :invoke "heap-pin" heap thrown))
                        (let ((synced (flush-pending-foreign heap)))
                          (js-object :kind "thrown" :raw thrown :valueKind thrown-kind
                            :token thrown-token :pinned thrown-pinned :pendingForeign synced)))))
                  (let ((cls (if has-exception-class
                               (unsigned-bit-shift-right (js-call memory :invoke "value-exception-class" heap) 0)
                               0)))
                    (when has-exception-class-set
                      (js-call memory :invoke "value-exception-class-set" heap 0))
                    (when call-entered
                      (try (js-call memory :invoke "frame-unwind" heap target-frame) (catch ignored nil))
                      (try (cond
                             (has-call-restore (js-call memory :invoke "value-call-restore" heap previous-this))
                             (has-call-reset (js-call memory :invoke "value-call-reset" heap)))
                        (catch ignored nil)))
                    (let ((synced (flush-pending-foreign heap)))
                      (js-object :kind "runtimeError" :code code :exceptionClass cls :pendingForeign synced)))))
              (progn
                (when call-entered
                  (try (js-call memory :invoke "frame-unwind" heap target-frame) (catch ignored nil))
                  (try (cond
                         (has-call-restore (js-call memory :invoke "value-call-restore" heap previous-this))
                         (has-call-reset (js-call memory :invoke "value-call-reset" heap)))
                    (catch ignored nil)))
                (throw error))))
          (finally
            (while (> (js-length pinned) 0)
              (try (js-call memory :invoke "heap-release" heap (js-call pinned :pop)) (catch ignored nil)))
            (when pinned-previous-this
              (try (js-call memory :invoke "heap-release" heap previous-this) (catch ignored nil))))))))

  (defun capture-fast-raw-failure (heap code)
    (if (and (= code 11) has-exception-take)
      (let* ((thrown (unsigned-bit-shift-right (js-call memory :invoke "value-exception-take" heap) 0))
             (take-err (js-call memory :invoke "last-error")))
        (if (/= take-err 0)
          (js-object :ok false :code take-err :exceptionClass 0)
          (let* ((thrown-kind (if (> thrown 3) (js-call memory :invoke "value-kind" heap thrown) 0))
                 (thrown-token (if (and (= thrown-kind 35) has-foreign-token)
                                 (unsigned-bit-shift-right (js-call memory :invoke "value-foreign-token" heap thrown) 0)
                                 0))
                 (thrown-pinned (and (> thrown 3) (/= thrown-kind 35))))
            (when thrown-pinned
              (js-call memory :invoke "heap-pin" heap thrown))
            (js-object :ok false :thrown t :raw thrown :valueKind thrown-kind
              :token thrown-token :pinned thrown-pinned))))
      (let ((cls (if has-exception-class
                   (unsigned-bit-shift-right (js-call memory :invoke "value-exception-class" heap) 0)
                   0)))
        (when has-exception-class-set
          (js-call memory :invoke "value-exception-class-set" heap 0))
        (js-object :ok false :code code :exceptionClass cls))))

  (defun execute-fast-raw (spec)
    (let ((op (get spec :op))
          (heap (unsigned-bit-shift-right (get spec :heap) 0)))
      (cond
        ((= op "number")
         (try
           (let ((val (unsigned-bit-shift-right
                        (invoke-checked "value-number" heap
                          (unsigned-bit-shift-right (get spec :low) 0)
                          (unsigned-bit-shift-right (get spec :high) 0))
                        0)))
             (invoke-checked "heap-pin" heap val)
             (js-object :ok t :raw val :kind 4))
           (catch error
             (if (and (not (nil? error)) (= (value-type error) "object")
                      (Object/hasOwn error "__fastApplyRuntimeError"))
               (capture-fast-raw-failure heap (get error :__fastApplyRuntimeError))
               (throw error)))))
        ((= op "readNumber")
         (try
           (let ((raw (unsigned-bit-shift-right (get spec :raw) 0)))
             (invoke-checked "value-kind" heap raw)
             (invoke-checked "value-length" heap raw)
             (let ((off (invoke-checked "value-data" heap raw 4)))
               (js-object :ok t
                 :low (js-call memory :getUint32 off t)
                 :high (js-call memory :getUint32 (+ off 4) t))))
           (catch error
             (if (and (not (nil? error)) (= (value-type error) "object")
                      (Object/hasOwn error "__fastApplyRuntimeError"))
               (capture-fast-raw-failure heap (get error :__fastApplyRuntimeError))
               (throw error)))))
        ((= op "string")
         (try
           (let* ((text (get spec :text))
                  (len (unsigned-bit-shift-right (js-length text) 0))
                  (val (unsigned-bit-shift-right (invoke-checked "value-string" heap len) 0))
                  (off (invoke-checked "value-data" heap val 5))
                  (i 0))
             (while (< i len)
               (js-call memory :setUint16 (+ off (* i 2)) (js-call text :charCodeAt i) t)
               (setq i (1+ i)))
             (invoke-checked "value-seal" heap val)
             (invoke-checked "heap-pin" heap val)
             (js-object :ok t :raw val :kind 5))
           (catch error
             (if (and (not (nil? error)) (= (value-type error) "object")
                      (Object/hasOwn error "__fastApplyRuntimeError"))
               (capture-fast-raw-failure heap (get error :__fastApplyRuntimeError))
               (throw error)))))
        ((= op "readString")
         (try
           (let* ((raw (unsigned-bit-shift-right (get spec :raw) 0))
                  (_kind (invoke-checked "value-kind" heap raw))
                  (len (unsigned-bit-shift-right (invoke-checked "value-length" heap raw) 0))
                  (off (invoke-checked "value-data" heap raw 5))
                  (parts (js-array))
