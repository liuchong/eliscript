(module capsules.tools.backends.native-node-runner
  (js* "import {readSync,writeSync} from 'node:fs';\nimport {Worker} from 'node:worker_threads';\nimport {openNativeMemory} from './native-memory.mjs';\nimport {errorData} from './compiler-worker.mjs';\n\nlet memory,hasLastError=false,hasTupleHeader=false,hasForeignToken=false,hasCollections=false,hasFastOps=false,callbackSequence=0,remainder=Buffer.alloc(0),eof=false;\nconst pendingForeign=[],fastNumberBuffer=new DataView(new ArrayBuffer(8));\nconst input=Buffer.allocUnsafe(65536),hostFailures=new WeakMap(),pause=new Int32Array(new SharedArrayBuffer(4));\nconst decoder=new TextDecoder('utf-8',{fatal:true,ignoreBOM:true});\nfunction allocFastString(heap,str){\n  const len=str.length>>>0,val=memory.invoke('value-string',heap,len)>>>0,off=memory.invoke('value-data',heap,val,5);\n  for(let i=0;i<len;i++)memory.setUint16(off+i*2,str.charCodeAt(i),true);\n  memory.invoke('value-seal',heap,val);\n  return val;\n}\nfunction executeFastOp(heap,op){\n  switch(op.fastOp){\n    case 'number':\n      return memory.invoke('value-number',heap,op.low>>>0,op.high>>>0)>>>0;\n    case 'string':\n      return allocFastString(heap,op.value);\n    case 'string-array':{\n      const list=op.strings,count=list.length>>>0,arr=memory.invoke('value-array-new',heap,count)>>>0;\n      memory.invoke('heap-pin',heap,arr);\n      try{\n        for(let i=0;i<count;i++){\n          const s=allocFastString(heap,list[i]);\n          memory.invoke('value-set',heap,arr,i,s);\n        }\n      }finally{memory.invoke('heap-release',heap,arr);}\n      return arr;\n    }\n    case 'array-new':\n      return memory.invoke('value-array-new',heap,op.length>>>0)>>>0;\n    case 'foreign-new':{\n      const raw=memory.invoke('value-foreign-new',heap,op.identity>>>0,op.callable?1:0)>>>0;\n      if(op.constructible)memory.invoke('value-foreign-constructor-set',heap,raw,1);\n      pendingForeign.push([op.identity>>>0,raw]);\n      return raw;\n    }\n    case 'array-set':{\n      const receiver=op.receiver>>>0,index=op.index>>>0,length=op.length>>>0,value=op.value>>>0;\n      if(index>=length)memory.invoke('value-array-resize',heap,receiver,index+1);\n      memory.invoke('value-set',heap,receiver,index,value);\n      return 2;\n    }\n    case 'object-put':{\n      const args=op.arguments>>>0,receiver=op.receiver>>>0,key=op.key>>>0,value=op.value>>>0;\n      memory.invoke('heap-pin',heap,args);\n      try{memory.invoke('value-object-put',heap,receiver,key,value,2);}\n      finally{memory.invoke('heap-release',heap,args);}\n      return 2;\n    }\n    case 'table-op':{\n      const args=op.arguments>>>0,target=op.target>>>0,kind=op.kind>>>0,arg0=op.arg0>>>0,arg1=op.arg1>>>0;\n      const tOff=memory.invoke('value-data',heap,target,kind),table=memory.getUint32(tOff,true);\n      if(op.mode==='put'){\n        memory.invoke('heap-pin',heap,args);\n        try{memory.invoke('value-table-put',heap,table,arg0,arg1);}\n        finally{memory.invoke('heap-release',heap,args);}\n        return target;\n      }\n      if(op.mode==='add'){\n        memory.invoke('heap-pin',heap,args);\n        try{memory.invoke('value-table-add',heap,table,arg0);}\n        finally{memory.invoke('heap-release',heap,args);}\n        return target;\n      }\n      if(op.mode==='has')return memory.invoke('value-table-has',heap,table,arg0)!==0?2:1;\n      if(op.mode==='delete')return memory.invoke('value-table-delete',heap,table,arg0)!==0?2:1;\n      if(op.mode==='get')return memory.invoke('value-table-get',heap,table,arg0)>>>0;\n      if(op.mode==='clear'){memory.invoke('value-table-clear',heap,table);return 3;}\n      if(op.mode==='size'){\n        const sz=memory.invoke('value-table-size',heap,table)>>>0;\n        fastNumberBuffer.setFloat64(0,sz,true);\n        return memory.invoke('value-number',heap,fastNumberBuffer.getUint32(0,true),fastNumberBuffer.getUint32(4,true))>>>0;\n      }\n      throw new TypeError('unknown fast table op');\n    }\n    default:\n      throw new TypeError('unknown native fastOp');\n  }\n}\nfunction read(){\n  const pieces=[];let length=0;\n  for(;;){\n    const end=remainder.indexOf(10);\n    if(end>=0){\n      const tail=remainder.subarray(0,end);\n      const bytes=pieces.length?Buffer.concat([...pieces,tail],length+tail.length):tail;\n      remainder=remainder.subarray(end+1);\n      return JSON.parse(decoder.decode(bytes));\n    }\n    if(remainder.length){pieces.push(remainder);length+=remainder.length;remainder=Buffer.alloc(0);}\n    if(eof){if(length)throw new Error('incomplete native transport request');return null;}\n    let count;\n    try{count=readSync(0,input,0,input.length,null);}\n    catch(error){if(error?.code==='EINTR')continue;if(error?.code==='EAGAIN'||error?.code==='EWOULDBLOCK'){Atomics.wait(pause,0,0,1);continue;}throw error;}\n    if(count===0)eof=true;\n    // Keep each filled read buffer once, then join a complete packet once.\n    // Growing the entire prefix here copies large compiler inputs repeatedly.\n    else remainder=Buffer.from(input.subarray(0,count));\n  }\n}\nfunction send(record){\n  const bytes=Buffer.from(JSON.stringify(record)+'\\n');let offset=0;\n  while(offset<bytes.length){\n    try{const written=writeSync(1,bytes,offset,bytes.length-offset,null);if(written===0)throw new Error('native transport output made no progress');offset+=written;}\n    catch(error){if(error?.code==='EINTR')continue;if(error?.code==='EAGAIN'||error?.code==='EWOULDBLOCK'){Atomics.wait(pause,0,0,1);continue;}throw error;}\n  }\n}\nfunction describe(error){\n  return errorData(error,{transport:'json'});\n}\nfunction hostCall(index,heap,argv){\n  const id=++callbackSequence;\n  let tuple;\n  if(hasTupleHeader&&argv>3&&memory.invoke('last-error')===0){\n    if(memory.invoke('value-kind',heap,argv)===7&&memory.invoke('last-error')===0){\n      const count=memory.invoke('value-length',heap,argv);\n      if(memory.invoke('last-error')===0&&count>=0&&count<=8){\n        const offset=count>0?memory.invoke('value-data',heap,argv,7):0;\n        if(memory.invoke('last-error')===0){\n          const items=[],kinds=[],tokens=[],strings=[],numbers=[],symbols=[];\n          for(let i=0;i<count;i++){\n            const v=memory.getUint32(offset+i*4,true);\n            items.push(v);\n            const k=v>3?memory.invoke('value-kind',heap,v):0;\n            kinds.push(k);\n            tokens.push(k===35&&hasForeignToken?memory.invoke('value-foreign-token',heap,v):0);\n            if(k===5){\n              const len=memory.invoke('value-length',heap,v);\n              if(len===0)strings.push('');\n              else if(len<=64){\n                const strOff=memory.invoke('value-data',heap,v,5),units=[];\n                for(let j=0;j<len;j++)units.push(memory.getUint16(strOff+j*2,true));\n                strings.push(String.fromCharCode(...units));\n              }else strings.push(null);\n            }else strings.push(null);\n            if(k===4){\n              const numOff=memory.invoke('value-data',heap,v,4),n=memory.getFloat64(numOff,true);\n              numbers.push(Number.isFinite(n)&&!Object.is(n,-0)?n:null);\n            }else numbers.push(null);\n            if(k===22){\n              const symOff=memory.invoke('value-data',heap,v,22);\n              symbols.push([memory.getUint32(symOff-20,true),memory.getUint32(symOff-16,true)]);\n            }else symbols.push(null);\n          }\n          const opcodeNumber=count>0&&kinds[0]===4&&Number.isInteger(numbers[0])?numbers[0]:-1;\n          let receiverHeader=null,applyArgs=null;\n          if(opcodeNumber===20&&count===5&&(kinds[4]===13||kinds[4]===14)){\n            const rOff=memory.invoke('value-data',heap,items[4],kinds[4]);\n            if(memory.invoke('last-error')===0){\n              if(kinds[4]===14){\n                receiverHeader=[memory.getUint32(rOff-28,true),memory.getUint32(rOff-8,true),memory.getUint32(rOff-4,true)];\n              }else{\n                const ns=memory.getUint32(rOff-12,true),fl=memory.getUint32(rOff-8,true),ig=memory.getUint32(rOff-4,true);\n                const hasOwn=(ns===0&&(fl&16416)===0&&(ig&3)===0&&kinds[2]===5&&hasFastOps)?memory.invoke('value-object-has',heap,items[4],items[2]):-1;\n                receiverHeader=[ns,fl,ig,memory.invoke('last-error')===0?hasOwn:-1];\n              }\n            }\n          }else if(opcodeNumber===8&&count===5&&kinds[4]===14){\n            const aOff=memory.invoke('value-data',heap,items[4],14);\n            if(memory.invoke('last-error')===0){\n              const aLen=memory.getUint32(aOff-28,true),aFlags=memory.getUint32(aOff-8,true);\n              if((aFlags&16384)===0&&aLen<=8){\n                const list=[];let ok=true;\n                for(let i=0;i<aLen;i++){\n                  const av=memory.getUint32(aOff+i*4,true);\n                  if(av===4){ok=false;break;}\n                  const ak=av>3?memory.invoke('value-kind',heap,av):0;\n                  const at=ak===35&&hasForeignToken?memory.invoke('value-foreign-token',heap,av):0;\n                  let as=null,an=null,asym=null;\n                  if(ak===5){\n                    const sl=memory.invoke('value-length',heap,av);\n                    if(sl===0)as='';\n                    else if(sl<=64){\n                      const sOff=memory.invoke('value-data',heap,av,5),units=[];\n                      for(let j=0;j<sl;j++)units.push(memory.getUint16(sOff+j*2,true));\n                      as=String.fromCharCode(...units);\n                    }\n                  }else if(ak===4){\n                    const nOff=memory.invoke('value-data',heap,av,4),n=memory.getFloat64(nOff,true);\n                    if(Number.isFinite(n)&&!Object.is(n,-0))an=n;\n                  }else if(ak===22){\n                    const yOff=memory.invoke('value-data',heap,av,22);\n                    asym=[memory.getUint32(yOff-20,true),memory.getUint32(yOff-16,true)];\n                  }\n                  list.push({raw:av,kind:ak,token:at,string:as,number:an,symbol:asym});\n                }\n                if(ok&&memory.invoke('last-error')===0)applyArgs=list;\n              }\n            }\n          }\n          const collections=hasCollections?memory.invoke('heap-collections',heap):-1;\n          if(memory.invoke('last-error')===0){\n            const syncedForeign=pendingForeign.length?pendingForeign.splice(0,pendingForeign.length):undefined;\n            tuple={count,opcode:count>0?items[0]:0,opcodeNumber,items,kinds,tokens,strings,numbers,symbols,receiverHeader,applyArgs,collections,fastOpOk:hasFastOps,pendingForeign:syncedForeign};\n          }\n        }\n      }\n    }\n    if(!tuple){\n      memory.invoke('value-error-restore',0);\n      if(pendingForeign.length)tuple={untupled:true,pendingForeign:pendingForeign.splice(0,pendingForeign.length)};\n    }\n  }\n  send({callback:tuple?{id,index,heap,argv,tuple}:{id,index,heap,argv}});\n  for(;;){\n    const message=read();\n    if(message===null)throw new Error('native host disconnected during a callback');\n    if(message.callback!==undefined){\n      if(message.callback!==id)throw new Error('native callback response belongs to a different invocation');\n      if(Object.hasOwn(message,'hostError')){const error=Object.freeze({});hostFailures.set(error,message.hostError);throw error;}\n      if(message.fastOp!==undefined)return executeFastOp(heap,message.fastOp);\n      return message.result;\n    }\n    // Host reflection may call back into the same library while a source frame\n    // is suspended. Run that nested memory operation before resuming the frame.\n    dispatch(message);\n  }\n}\nfunction dispatch(message){\n  const {id,method,args=[]}=message;\n  try {\n    if(!Number.isSafeInteger(id)||id<1)throw new TypeError('invalid native transport invocation');\n    if(method==='open')throw new Error('native memory is already open');\n    if(!memory)throw new Error('native memory is closed');\n    let result,lastError;\n    if(method==='size')result=memory.byteLength;\n    else if(method==='invoke'){\n      result=memory.invoke(...args);\n      if(hasLastError)lastError=args[0]==='last-error'?result:memory.invoke('last-error');\n    }\n    else if(method==='getUint16')result=memory.getUint16(...args);\n    else if(method==='getUint32')result=memory.getUint32(...args);\n    else if(method==='getFloat64'){const v=memory.getFloat64(...args);result=Number.isNaN(v)?'NaN':v===Infinity?'Infinity':v===-Infinity?'-Infinity':Object.is(v,-0)?'-0':v;}\n    else if(method==='setUint16')result=memory.setUint16(...args);\n    else if(method==='setUint32')result=memory.setUint32(...args);\n    else if(method==='read')result=Buffer.from(memory.read(...args)).toString('base64');\n    else if(method==='write')result=memory.write(new Uint8Array(Buffer.from(args[0],'base64')),args[1]);\n    else if(method==='close')result=memory.close();\n    else throw new TypeError('unknown native transport method');\n    send(lastError===undefined?{id,result:result??null}:{id,result:result??null,lastError});\n  }catch(error){\n    if(error!==null&&(typeof error==='object'||typeof error==='function')&&hostFailures.has(error))send({id,hostError:hostFailures.get(error)});\n    else send({id,error:describe(error)});\n  }\n}\nconst watchdog=new Worker(new URL('./native-node-watchdog.mjs',import.meta.url),{\n  workerData:{parentPID:process.ppid},execArgv:[],env:{...process.env,NODE_OPTIONS:'',BUN_OPTIONS:''},\n});\ntry {\n  await new Promise((resolve,reject)=>{\n    const ready=message=>{if(message?.ready){cleanup();resolve();}};\n    const fail=error=>{cleanup();reject(error);};\n    const exit=code=>fail(new Error('native loader ownership watcher exited before initialization: '+code));\n    const cleanup=()=>{watchdog.off('message',ready);watchdog.off('error',fail);watchdog.off('exit',exit);};\n    watchdog.on('message',ready);watchdog.once('error',fail);watchdog.once('exit',exit);\n  });\n} catch(error) {await watchdog.terminate();throw error;}\nwatchdog.on('error',error=>{send({transportFailure:describe(error)});process.exit(1);});\nwatchdog.unref();\nsend({ready:true});\ntry {\n  const first=read();\n  if(first!==null){\n    try{\n      if(first.method!=='open'||!Array.isArray(first.args)||first.args.length!==3)throw new TypeError('native transport requires initialization');\n      const signatures=first.args[1];\n      hasLastError=Boolean(signatures&&typeof signatures==='object'&&Object.hasOwn(signatures,'last-error')&&signatures['last-error']===0);\n      hasTupleHeader=Boolean(hasLastError&&signatures['value-error-restore']===1&&signatures['value-kind']===2&&signatures['value-length']===2&&signatures['value-get']===3&&signatures['value-data']===3);\n      hasForeignToken=Boolean(hasTupleHeader&&signatures['value-foreign-token']===2);\n      hasCollections=Boolean(hasTupleHeader&&signatures['heap-collections']===1);\n      hasFastOps=Boolean(hasTupleHeader&&signatures['heap-pin']===2&&signatures['heap-release']===2&&signatures['value-number']===3&&signatures['value-string']===2&&signatures['value-seal']===2&&signatures['value-array-new']===2&&signatures['value-array-resize']===3&&signatures['value-set']===4&&signatures['value-object-has']===3&&signatures['value-object-put']===5&&signatures['value-foreign-new']===3&&signatures['value-foreign-constructor-set']===3&&signatures['value-table-put']===4&&signatures['value-table-add']===3&&signatures['value-table-has']===3&&signatures['value-table-delete']===3&&signatures['value-table-get']===3&&signatures['value-table-clear']===2&&signatures['value-table-size']===2);\n      memory=await openNativeMemory(first.args[0],signatures,{...first.args[2],hostCall});\n      send({id:first.id,result:true});\n    }catch(error){send({id:first.id,error:describe(error)});process.exitCode=1;}\n    if(memory){let message;while((message=read())!==null)dispatch(message);}\n  }\n}finally{try{memory?.close();}finally{await watchdog.terminate();}}\n"))
