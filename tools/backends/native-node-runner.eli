                     ((Number/isNaN v) "NaN")
                     ((= v globalThis.Infinity) "Infinity")
                     ((= v (- globalThis.Infinity)) "-Infinity")
                     ((Object/is v (* -1 0)) "-0")
                     (t v)))))
              ((= method "setUint16")
               (setq result (Reflect/apply (get memory :setUint16) memory args)))
              ((= method "setUint32")
               (setq result (Reflect/apply (get memory :setUint32) memory args)))
              ((= method "read")
