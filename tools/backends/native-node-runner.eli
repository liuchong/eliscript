                      (signature-matches-p "value-object-has" (js-array "u32" "v64" "v64") "u32")
                      (signature-matches-p "value-object-put" (js-array "u32" "v64" "v64" "v64" "u32") "u32")
                      (signature-matches-p "value-foreign-new" (js-array "u32" "u32" "u32") "v64")
                      (signature-matches-p "value-foreign-constructor-set" (js-array "u32" "v64" "u32") "v64")
                      (signature-matches-p "value-table-put" (js-array "u32" "v64" "v64" "v64") "u32")
                      (signature-matches-p "value-table-add" (js-array "u32" "v64" "v64") "u32")
                      (signature-matches-p "value-table-has" (js-array "u32" "v64" "v64") "u32")
                      (signature-matches-p "value-table-delete" (js-array "u32" "v64" "v64") "u32")
                      (signature-matches-p "value-table-get" (js-array "u32" "v64" "v64") "v64")
                      (signature-matches-p "value-table-clear" (js-array "u32" "v64") "u32")
                      (signature-matches-p "value-table-size" (js-array "u32" "v64") "u32")))
                  (setq has-current-this
                    (and has-tuple-header (signature-matches-p "value-function-current-this" (js-array "u32") "v64")))
                  (setq has-call-restore
                    (and has-tuple-header (signature-matches-p "value-call-restore" (js-array "u32" "v64") "u32")))
                  (setq has-call-reset
                    (and has-tuple-header (signature-matches-p "value-call-reset" (js-array "u32") "u32")))
                  (setq has-exception-take
                    (and has-tuple-header (signature-matches-p "value-exception-take" (js-array "u32") "v64")))
                  (setq has-exception-class
                    (and has-tuple-header (signature-matches-p "value-exception-class" (js-array "u32") "u32")))
                  (setq has-exception-class-set
                    (and has-tuple-header (signature-matches-p "value-exception-class-set" (js-array "u32" "u32") "u32")))
                  (setq has-exception-clear
                    (and has-tuple-header (signature-matches-p "value-exception-clear" (js-array "u32") "u32")))
                  (setq has-root-scope-mark
                    (and has-tuple-header (signature-matches-p "root-scope-mark" (js-array "u32") "u32")))
                  (setq has-root-scope-unwind
                    (and has-tuple-header (signature-matches-p "root-scope-unwind" (js-array "u32" "u32") "u32")))
                  (setq memory
                    (await (openNativeMemory (aref args 0) signatures
                             (Object/assign (js-object) (aref args 2) (js-object :hostCall host-call)))))
                  (send (js-object :id (get first :id) :result t))))
              (catch error
                (send (js-object :id (get first :id) :error (describe error)))
                (put globalThis.process :exitCode 1)))
            (when memory
              (let ((message (read-packet)))
                (while (not (nil? message))
                  (dispatch message)
                  (setq message (read-packet)))))))
        (finally
          (try (when memory (js-call memory :close))
            (finally (await (js-call watchdog :terminate))))))))

  (js-call (run-native-node-runner) :catch
    (lambda (error)
      (js-call (get globalThis.process :stderr) :write
        (+ (if (and (not (nullish? error)) (= (value-type (get error :stack)) "string"))
             (get error :stack)
             (str error))
           "\n"))
      (js-call globalThis.process :exit 1))))
