          (js-call memory :invoke "value-error-restore" saved-err))
        out)))

  (defun current-root-mark (heap)
    (if has-root-scope-mark
      (unsigned-bit-shift-right (invoke-checked "root-scope-mark" heap) 0)
      0))
  (defun restore-root-mark (heap mark)
    (when has-root-scope-unwind
      (try (js-call memory :invoke "root-scope-unwind" heap mark) (catch ignored nil))))
  (defun clear-apply-tuple-pool ()
    (let ((h apply-tuple-heap) (i 0))
      (while (< i 5)
        (let ((item (aref apply-tuple-pool i)))
          (when (and item (not (undefined? h)) memory)
            (try (js-call memory :invoke "heap-release" h item) (catch ignored nil)))
          (put apply-tuple-pool i nil))
        (setq i (1+ i))))
    (setq apply-tuple-heap undefined))
  (defun acquire-apply-tuple (heap argc)
    (when (and (not (undefined? apply-tuple-heap)) (/= apply-tuple-heap heap))
      (clear-apply-tuple-pool))
    (if (and (< argc 5) (not (nil? (aref apply-tuple-pool argc))))
      (let ((tuple (aref apply-tuple-pool argc)))
        (put apply-tuple-pool argc nil)
        tuple)
      (let ((tuple (fast-value (invoke-checked "value-refs" heap 7 argc))))
        (invoke-checked "heap-pin" heap tuple)
        (setq apply-tuple-heap heap)
        tuple)))
  (defun release-apply-tuple (heap argc tuple)
