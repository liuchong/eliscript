                  (js-object :format "eliscript-build-operation" :version 1 :mode "single" :input "src/defaults.eli" :output nil :sourceMap false :portableEntries (js-array)))
                (js-array "single-portable-order" "build-operation-request"
                  (js-object :mode "single" :input "src/main.eli" :output nil :sourceMap false :portableEntries (js-array "zeta" "alpha" "zeta"))
                  (js-object :format "eliscript-build-operation" :version 1 :mode "single" :input "src/main.eli" :output nil :sourceMap false :portableEntries (js-array "alpha" "zeta")))
                (js-array "project-request" "project-request"
                  (js-object :entry "src/main.eli" :outDir "dist" :root nil :portableEntries (js-array "zeta" "alpha" "zeta") :useCache t)
                  (js-object :format "eliscript-project-request" :version 1 :entry "src/main.eli" :outDir "dist" :root nil
                    :portableEntries (js-array "alpha" "zeta") :macroCapabilities (js-array) :macroFileDependencies (js-array) :useCache t))
                (js-array "check-report" "project-check-report"
                  (js-object :mode "standard" :root "root" :entries (js-array "src/z.eli" "src/a.eli") :portableEntries (js-array)
                    :modules (js-array (js-object :source "src/z.eli" :dependencies (js-array) :portableEntries (js-array))
                                       (js-object :source "src/a.eli" :dependencies (js-array "src/z.eli") :portableEntries (js-array))))
                  (js-object :format "eliscript-check-report" :version 1 :status "ok" :mode "standard" :root "root"
                    :entries (js-array "src/a.eli" "src/z.eli") :portableEntries (js-array)
                    :counts (js-object :modules 2)
                    :modules (js-array (js-object :source "src/a.eli" :dependencies (js-array "src/z.eli") :portableEntries (js-array))
                                       (js-object :source "src/z.eli" :dependencies (js-array) :portableEntries (js-array))))))))
        (funcall addSequence "project-protocols" "tests/bootstrap-project.test.mjs"
          (js-call protocolCases :map (lambda (row)
            (js-object :id (aref row 0) :request (js-object :operation "protocol" :name (aref row 1) :input (aref row 2)) :expected (aref row 3))))))
      (let ((portableSource "(defconst step 2)\n(defportable helper (value) (* value step))\n(defportable work (value) (helper value))\n(defportable unused () 99)\n(defun ordinary () 1)")
            (p-entry-map (js-object :sequence "map" :text "blank?" :object "omit"))
            (p-inc-map (js-object :sequence (js-array "function reverse(values)" "function map(function$, values)")
                         :text (js-array "function slice(start, end, text)" "function whitespace" "function trim(text)" "function blank")
                         :object (js-array "function keys(object)" "function key_in_QMARK_" "function omit(object, omitted_keys)")))
            (p-exc-map (js-object :sequence (js-array "function filter" "function range")
                         :text (js-array "function join" "function repeat")
                         :object (js-array "function map_values" "function update"))))
        (funcall addSequence "portable-transitive-closure" "tests/eliscript-tests.el"
          (js-call
            (js-array
              (js-object :id "selection" :request (js-object :operation "stage" :stage "portable" :source portableSource :filename "portable.eli" :entries (js-array "work") :allowProjectImports false))
              (js-object :id "emission" :request (js-object :operation "compile" :source portableSource :filename "portable.eli" :portableEntries (js-array "work"))
                :includesJavascript (js-array "const step = 2;" "function helper(value)" "function work(value)")
                :excludesJavascript (js-array "function unused" "function ordinary"))
              (js-object :id "import-requires-project"
                :request (js-object :operation "stage" :stage "portable"
                           :source "(import-portable \"./math.eli\" increment)\n(defportable work (value) (increment value))"
                           :filename "portable.eli" :entries (js-array "work") :allowProjectImports false)
                :error (js-object :contains "portable import increment requires a project build")))
            :concat
            (js-call (Object/entries portableSources) :map (lambda (pair)
              (let ((name (aref pair 0))
                    (source (aref pair 1)))
                (js-object :id (str "stdlib-" name)
                  :request (js-object :operation "compile" :source source :filename (str "stdlib/" name ".eli")
                             :portableEntries (js-array (get p-entry-map name)))
                  :includesJavascript (get p-inc-map name)
                  :excludesJavascript (get p-exc-map name))))))))
      (let* ((cacheModules (js-array (js-object :source "src/main.eli" :output "src/main.mjs" :sourceMap "src/main.mjs.map"
                                       :sourceDigest "source" :outputDigest "output" :sourceMapDigest "map")))
             (metadataModules (js-array (js-object :source "src/main.eli" :dependencies (js-array) :portableEntries (js-array))))
             (cacheLookupInput (js-object :enabled t :manifestStatus "readable" :expectedEntry "src/main.mjs"
                                 :graphDigestValid t :cacheDigestValid t :compilerDigest "compiler" :mode "standard" :portableEntries (js-array)))
             (cacheManifest
               (lambda (version)
                 (let ((cache-obj (js-object :version version :compilerDigest "compiler" :mode "standard"
                                    :portableEntries (js-array) :modules metadataModules)))
                   (when (= version 2) (put cache-obj :format "eliscript-project-cache"))
                   (js-object :format "eliscript-project" :version 1 :entry "src/main.mjs" :digest "manifest"
                     :modules cacheModules :cache cache-obj))))
             (reportInput
               (js-object :mode "standard" :root "root" :outDir "root/dist" :entry "src/main.eli" :entryOutput "src/main.mjs"
                 :manifest "eliscript-project.json" :digest "abc123" :portableEntries (js-array)
                 :cache (js-object :enabled t :reason "verified")
                 :timings (js-object :cacheReadMs 0.1236 :workMs 1.2344 :manifestWriteMs 0.3456 :totalMs 1.7036)
                 :modules (js-array
                            (js-object :source "src/value.eli" :output "src/value.mjs" :sourceMap "src/value.mjs.map"
                              :status "compiled" :reason "source-changed" :dependencies (js-array) :portableEntries (js-array))
                            (js-object :source "src/main.eli" :output "src/main.mjs" :sourceMap "src/main.mjs.map"
                              :status "reused" :reason "verified" :dependencies (js-array "src/value.eli" "src/value.eli") :portableEntries (js-array))))))
        (funcall addSequence "project-cache-reports" "tests/bootstrap-project.test.mjs"
          (js-array
            (js-object :id "current-cache"
              :request (js-object :operation "protocol" :name "project-cache-lookup"
                         :input (Object/assign (js-object) cacheLookupInput (js-object :manifest (funcall cacheManifest 2))))
              :expectFields (js-array (js-object :path (js-array "reason") :value "verified")
                                      (js-object :path (js-array "cache" "sourceVersion") :value 2)))
            (js-object :id "ground-cache"
              :request (js-object :operation "protocol" :name "project-cache-lookup"
                         :input (Object/assign (js-object) cacheLookupInput (js-object :manifest (funcall cacheManifest 1))))
              :expectFields (js-array (js-object :path (js-array "reason") :value "verified")
                                      (js-object :path (js-array "cache" "sourceVersion") :value 1)))
            (js-object :id "unreadable-artifact"
              :request (js-object :operation "protocol" :name "project-cache-decision"
                         :input (js-object :record (js-object :$compilerCorpusRef "current-cache.cache.records.0")
                                  :output "src/main.mjs" :sourceMap "src/main.mjs.map" :expectedPortableEntries (js-array)
                                  :sourceDigest "changed" :outputExists t :sourceMapExists t :outputDigest "output"
                                  :sourceMapDigest "map" :dependenciesValid t :artifactFailure "artifact-unreadable"))
              :expected (js-object :reused false :reason "artifact-unreadable"))
            (js-object :id "report"
              :request (js-object :operation "protocol" :name "project-build-report" :input reportInput)
