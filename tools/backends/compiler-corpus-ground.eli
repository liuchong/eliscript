                                          :byteStart (get region :byteStart) :byteEnd (get region :byteEnd) :sha256 (get region :sha256))))
                        (js-call originalGateCoverage :push id)
                        (js-call hostOnlyDependencies :push
                          (js-object :coverageId id :file originalFile
                            :sourceSha256 (get (await (funcall file originalFile)) :sha256)
                            :kind "host-only-runtime-case-fixture" :maintainedHost maintained :originalAssertion title
                            :engines (js-array "bun" "node")
                            :originalCase (js-object :file suite :sourceSha256 (get (await (funcall file suite)) :sha256) :region caseRegion)
                            :dependencies (await (Promise/all
                                                   (js-call (js-array "runtime/core/collection.mjs" "runtime/core/protocol.mjs")
                                                     :map (async (filename)
                                                       (js-object :file filename :sourceSha256 (get (await (funcall file filename)) :sha256))))))
                            :reason "original Bun and Node fixture checks runtime protocol adapter isolation without a compiler or language-product injection"))
                        (setq handled t))))
                  (when (and (not handled) locator)
                    (let ((bound (await (originalToolsHostGateCase (js-object :locator locator :source (await (funcall text (get locator :file))) :file file)))))
                      (when bound
                        (js-call originalGateCoverage :push id)
                        (js-call hostOnlyDependencies :push
                          (Object/assign (js-object) bound
                            (js-object :coverageId id :file (get locator :file)
                              :sourceSha256 (get (await (funcall file (get locator :file))) :sha256)
                              :locator (globalThis.structuredClone locator))))
                        (setq handled t))))
                  (when (and (not handled)
                             originalFile (js-call originalFile :startsWith "tests/")
                             (originalRuntimeHostArtifact originalFile)
                             (isOriginalRuntimeHostOnly (originalRuntimeHostArtifact originalFile)
                               (await (funcall text (originalRuntimeHostArtifact originalFile)))))
                    (js-call originalGateCoverage :push id)
                    (js-call hostOnlyDependencies :push
                      (js-object :coverageId id :file originalFile
                        :sourceSha256 (get (await (funcall file originalFile)) :sha256)
                        :maintainedHost (when (/= originalFile (originalRuntimeHostArtifact originalFile))
                          (await (maintained-fixture-proof originalFile (originalRuntimeHostArtifact originalFile) text file)))
                        :kind "host-only-runtime"
                        :reason "unchanged original host runtime; no selected compiler or language-product injection"))
                    (setq handled t))
                  (when (and (not handled) locator
                             (js-call (js-array "tests/persistent-queue.test.mjs" "tests/lazy-sequence.test.mjs"
                                        "tests/persistent-sorted.test.mjs" "tests/regex.test.mjs"
                                        "tests/core-text-object.test.mjs" "tests/core-set.test.mjs" "tests/core-stdlib.test.mjs")
                               :includes (get locator :file)))
                    (let* ((originalSource (await (funcall text (get locator :file))))
                           (runtimeCase (originalRuntimeOnlyCase (get locator :file) originalSource (get locator :contains))))
                      (when runtimeCase
                        (js-call originalGateCoverage :push id)
                        (js-call hostOnlyDependencies :push
                          (js-object :coverageId id :file (get locator :file)
                            :sourceSha256 (get (await (funcall file (get locator :file))) :sha256)
                            :kind "host-only-runtime-case" :region runtimeCase
                            :reason "unchanged original runtime-only case; the separate compiled-language case remains selected-session evidence"))
                        (setq handled t))))
                  (when (and (not handled) locator (= (get locator :file) "tests/diagnostic-corpus.test.mjs")
                             (js-call (js-array "complete negative diagnostic corpus is frozen and source-derived"
                                        "diagnostic corpus rejects missing cases and fixture drift"
                                        "diagnostic corpus rejects structured and human diagnostic drift")
                               :includes (get locator :contains)))
                    (let* ((originalSource (await (funcall text (get locator :file))))
                           (matches (js-call (originalSourceCaseLocators (get locator :file) originalSource) :filter
                             (lambda (item) (= (get (get item :originalCase) :title) (get locator :contains)))))
                           (actual (when (= (js-length matches) 1) (get (aref matches 0) :originalCase))))
                      (unless actual
                        (throw (new globalThis.TypeError "original diagnostic manifest case boundary changed")))
                      (let* ((start (get (get actual :span) :start)) (end (get (get actual :span) :end))
                             (caseSource (js-call originalSource :slice start end)))
                        (when (and (not (js-call caseSource :includes "checkDiagnosticCorpus("))
                                   (not (js-call caseSource :includes "validationErrors(")))
                          (throw (new globalThis.TypeError "original diagnostic manifest case lost its validator")))
                        (let ((dependencies (js-array))
                              (dep-files (js-array "tools/diagnostics/check.mjs" "contracts/diagnostic-corpus.json"
                                           "tests/fixtures/bootstrap-reader.json" "tests/fixtures/bootstrap-expander.json"
                                           "tests/fixtures/bootstrap-analyzer.json"))
                              (df-idx 0))
                          (while (< df-idx (js-length dep-files))
                            (let ((filename (aref dep-files df-idx)))
                              (js-call dependencies :push (js-object :file filename :sourceSha256 (get (await (funcall file filename)) :sha256))))
                            (setq df-idx (1+ df-idx)))
                          (js-call originalGateCoverage :push id)
                          (js-call hostOnlyDependencies :push
                            (js-object :coverageId id :file (get locator :file)
                              :sourceSha256 (get (await (funcall file (get locator :file))) :sha256)
                              :kind "frozen-diagnostic-manifest-case" :originalAssertion (get locator :contains)
                              :locator (globalThis.structuredClone locator) :dependencies dependencies
                              :region (js-object :start start :end end
                                        :byteStart (js-call globalThis.Buffer :byteLength (js-call originalSource :slice 0 start))
                                        :byteEnd (js-call globalThis.Buffer :byteLength (js-call originalSource :slice 0 end))
                                        :sha256 (digest (js-call globalThis.Buffer :from caseSource)))
                              :reason "original validator checks frozen diagnostic inventory and mutation rejection; every compiler negative input remains an independent selected-session stage record"))
                          (setq handled t)))))
                  (when (and (not handled) locator (= (get locator :file) "tests/literal-runtime.test.mjs")
                             (= (get locator :contains) "maintained Eliscript sources use explicit host constructors"))
                    (let* ((originalSource (await (funcall text (get locator :file))))
                           (title "maintained Eliscript sources use explicit host constructors")
                           (prefix (str "test(" (JSON/stringify title) ", async () => {"))
                           (start (js-call originalSource :indexOf prefix)))
                      (when (or (< start 0) (>= (js-call originalSource :indexOf prefix (+ start (js-length prefix))) 0))
                        (throw (new globalThis.TypeError "original source-only audit case boundary changed")))
                      (let ((region (originalRegion originalSource prefix "\ntest(" start)))
                        (unless (js-call (get region :text) :includes "expect(violations).toEqual([]);")
                          (throw (new globalThis.TypeError "original source-only audit assertion changed")))
                        (js-call originalGateCoverage :push id)
                        (js-call hostOnlyDependencies :push
                          (js-object :coverageId id :file (get locator :file)
                            :sourceSha256 (get (await (funcall file (get locator :file))) :sha256)
                            :kind "source-only-case" :originalAssertion title
                            :locator (globalThis.structuredClone locator)
                            :region (js-object :start (get region :start) :end (get region :end)
                                      :byteStart (get region :byteStart) :byteEnd (get region :byteEnd) :sha256 (get region :sha256))
                            :reason "unchanged original source constructor audit; all compiled-language cases retain selected-session execution"))
                        (setq handled t))))
                  (when (and (not handled) locator (= (js-call originalReportOnlyLocators :get (get locator :file)) (get locator :contains)))
                    (js-call originalGateCoverage :push id)
                    (setq handled t))
                  (unless handled
                    (if (and locator (/= (get locator :kind) "ert") (/= (get locator :kind) "shell")
                             (or (not (get locator :featureId)) (js-call semanticFeature :test (get locator :featureId))))
                      (js-call missingCaseAdapters :push
                        (js-object :coverageId id :file (get locator :file) :contains (get locator :contains)
                          :featureId (get locator :featureId)
                          :reason "original semantic suite still needs its complete selected-session adapter"))
                      (if (js-call id :startsWith "stable-compatibility:tests/fixtures/")
                        (let* ((filename (js-call id :slice (js-length "stable-compatibility:")))
                               (transport (js-call (new globalThis.RegExp "\\/(?:compiled-eli-(?:bun-preload|node-loader)|platform-capabilities|worker-value-stream-probe)[.](?:mjs|eli)$") :test filename))
                               (auxiliary (or (js-call filename :endsWith ".stdout")
                                              (js-call filename :endsWith ".el")
                                              (js-call filename :endsWith "/package.json")
                                              (js-call filename :endsWith "/.gitkeep")
                                              transport)))
                          (if auxiliary
                            (js-call originalGateCoverage :push id)
                            (js-call missingCaseAdapters :push
                              (js-object :coverageId id :file filename
                                :reason "original language fixture or host oracle has not yet been mapped to complete selected-session requests"))))
                        (js-call originalGateCoverage :push id)))))
                (setq u-idx (1+ u-idx)))
              (let ((partialSuites
                      (new globalThis.Set
                        (js-call (js-call (js-call records :filter (lambda (record)
                                            (and (= (get record :kind) "sequence")
                                                 (/= (and (get record :original) (get (get record :original) :completeLocatorCoverage)) t))))
                                   :map (lambda (record) (and (get record :original) (get (get record :original) :suite))))
                          :filter (lambda (suite) (and suite (not (js-call fullyMappedSuites :has suite)))))))
                    (completeReplayCoverage (new globalThis.Set))
                    (rec-idx 0))
                (while (< rec-idx (js-length records))
                  (let* ((record (aref records rec-idx))
                         (exec (get record :execution))
                         (orig (get record :original)))
                    (when (and (= (get record :kind) "project")
                               exec (= (get exec :kind) "compiler-session-program")
                               orig (= (get orig :completeLocatorCoverage) t)
                               (= (get orig :coverageScope) "complete-source-mapping-worker-case-only"))
                      (let* ((suite (get orig :suite))
                             (source (await (funcall text suite))))
                        (when (= (get orig :sourceSha256) (get (await (funcall file suite)) :sha256))
                          (let ((cases (originalSourceCaseLocators suite source))
                                (orig-cases (nullish-or (get orig :cases) (js-array)))
                                (oc-idx 0))
                            (while (< oc-idx (js-length orig-cases))
                              (let* ((original (aref orig-cases oc-idx))
                                     (locator (js-call byLocator :get (get original :id)))
                                     (exact (js-call cases :find (lambda (item)
                                              (let ((oc (get item :originalCase)))
                                                (and (= (get oc :sha256) (get original :sha256))
                                                     (= (get (get oc :span) :start) (and (get original :span) (get (get original :span) :start)))
                                                     (= (get (get oc :span) :end) (and (get original :span) (get (get original :span) :end)))
                                                     (= (get oc :sourceSha256) (get original :sourceSha256))
                                                     (= (get oc :timeoutMs) (get original :timeoutMs))))))))
                                (when (and locator (= (get locator :file) suite)
                                           (= (value-type (get locator :contains)) "string")
                                           (> (js-length (get locator :contains)) 0)
                                           (js-call (get record :coverage) :includes (get original :id))
                                           exact
                                           (js-call (js-call source :slice (get (get (get exact :originalCase) :span) :start)
                                                      (get (get (get exact :originalCase) :span) :end))
                                             :includes (get locator :contains)))
                                  (js-call completeReplayCoverage :add (get original :id))))
                              (setq oc-idx (1+ oc-idx)))))))
                    (when (and (= (get record :kind) "project")
                               exec (= (get exec :kind) "original-program")
                               orig (= (get orig :semanticCoverage) "complete-original-suite-with-selected-compiler-namespaces"))
                      (let ((coverage (new globalThis.Set (get record :coverage)))
                            (suites (nullish-or (get orig :suites) (js-array)))
                            (s-idx 0))
                        (while (< s-idx (js-length suites))
                          (let ((suite (aref suites s-idx)))
                            (when (= (get suite :sourceSha256) (get (await (funcall file (get suite :file))) :sha256))
                              (js-call (nullish-or (get suite :coverage) (js-array)) :forEach (lambda (id)
                                (when (and (js-call coverage :has id)
                                           (= (and (js-call byLocator :get id) (get (js-call byLocator :get id) :file)) (get suite :file)))
                                  (js-call completeReplayCoverage :add id))))))
                          (setq s-idx (1+ s-idx))))))
                  (setq rec-idx (1+ rec-idx)))
                (js-call locators :forEach (lambda (locator)
                  (when (and (js-call partialSuites :has (get locator :file))
                             (/= (get locator :kind) "ert")
                             (/= (get locator :kind) "shell")
                             (not (js-call completeReplayCoverage :has (get locator :id)))
                             (not (js-call missingCaseAdapters :some (lambda (item) (= (get item :coverageId) (get locator :id))))))
                    (js-call missingCaseAdapters :push
                      (js-object :coverageId (get locator :id) :file (get locator :file)
                        :contains (get locator :contains) :featureId (get locator :featureId)
                        :reason "request recipes exist; remaining original suite assertions are not yet fully mapped")))))
                (let ((originalGateEvidence
                        (js-object :required t :verification "not-executed"
                          :execution (globalThis.structuredClone (get (get stable :document) :execution))
                          :coverageIds originalGateCoverage :hostOnlyDependencies hostOnlyDependencies
                          :locators locators :fixtures (js-call (get (get stable :document) :fixtureFiles) :slice)
                          :bootstrapSources (js-call (get (get parity :document) :bootstrapSources) :slice)
                          :dimensions (js-call (get (get parity :document) :dimensions) :map (lambda (item) (get item :id)))))
                      (evidence (funcall sourceEvidence)))
                  (js-object :format "eliscript-compiler-matrix-corpus" :version 1
                    :manifests (Object/fromEntries (js-call (get originals :manifests) :map (lambda (item)
                                 (js-array (get item :id) (js-object :sha256 (get item :sha256) :identity (get item :identity))))))
                    :coverageIds (js-call (get originals :requiredCoverage) :slice)
                    :expectedIds (js-call records :map (lambda (record) (get record :id)))
                    :records records :evidence evidence :originalGateEvidence originalGateEvidence
                    :missingCaseAdapters missingCaseAdapters)))))))))

  (defun compilerCorpusRequest (record target &rest __opt)
    (let* ((options-opt (aref __opt 0))
           (options (if (undefined? options-opt) (js-object) options-opt)))
      (cond
        ((= (get record :kind) "stage") (cloneCompilerCorpusData (get record :request)))
        ((or (= (get record :kind) "original-suite") (= (get record :kind) "sequence")) nil)
        (t
         (Object/assign (js-object) (get record :request)
           (js-object :operation "project"
             :modules (cloneCompilerCorpusModules (get record :modules))
             :entry (get record :entry)
             :target target
             :memory (nullish-or (get record :memory) (get options :memory))
             :nativeTarget (nullish-or (get record :nativeTarget)
                             (nullish-or (get options :nativeTarget)
                               (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos")))
             :nativeFormat (nullish-or (get record :nativeFormat) (nullish-or (get options :nativeFormat) "library"))))))))

  (defun addOriginalRequestRecipes (options)
    (let* ((add (get options :add))
           (locators (get options :locators))
           (irCases (get options :irCases))
           (portableSources (get options :portableSources))
           (locatorIds
             (lambda (file)
               (let ((ids (js-call (js-call locators :filter (lambda (item) (= (get item :file) file)))
                            :map (lambda (item) (get item :id)))))
                 (when (= (js-length ids) 0)
                   (throw (new globalThis.Error (str "original recipe has no retained suite locator: " file))))
                 ids)))
           (addSequence
             (lambda (id suite steps)
               (funcall add
                 (js-object :id (str "original-sequence:" id) :kind "sequence"
                   :coverage (funcall locatorIds suite)
                   :original (js-object :suite suite)
                   :steps steps :expected (js-object :kind "sequence")))))
           (project
             (lambda (source &rest __opt)
               (let ((helper (aref __opt 0))
                     (modules (js-array (js-object :id "main.mjs" :filename "main.eli" :source source))))
                 (unless (undefined? helper)
                   (js-call modules :push (js-object :id "helper.mjs" :filename "helper.eli" :source helper)))
                 (js-object :operation "project" :resolveImports t :sourceMap t :entry "main.mjs" :modules modules))))
           (diskSource "(import \"./helper.eli\" answer)\n(print answer)\n")
           (virtualSource "(import \"./helper.eli\" answer)\n(print (+ answer 1))\n")
           (helper "(defconst answer 42)\n(export answer)\n"))
      (funcall addSequence "project-source-edits" "tests/bootstrap-project.test.mjs"
        (js-array
          (js-object :id "initial" :request (funcall project diskSource helper) :artifact (js-object :kind "stdout" :expected "42\n"))
          (js-object :id "identical" :request (funcall project diskSource helper) :artifact (js-object :kind "stdout" :expected "42\n") :sameProductAs "initial")
          (js-object :id "override" :request (funcall project virtualSource helper) :artifact (js-object :kind "stdout" :expected "43\n"))
          (js-object :id "restore-disk" :request (funcall project diskSource helper) :artifact (js-object :kind "stdout" :expected "42\n") :sameProductAs "initial")
          (js-object :id "invalid-edit" :request (funcall project "(print missing)\n" helper) :error (js-object :code "ELI-A0001" :phase "analysis"))
          (js-object :id "after-failed-edit" :request (funcall project diskSource helper) :artifact (js-object :kind "stdout" :expected "42\n") :sameProductAs "initial")))
      (let* ((macro "(defmacro configured-value ()\n  (macro-read-file \"build-value.txt\"))\n(defconst value (configured-value))\n(export value)")
             (macroProject
               (lambda (value)
                 (Object/assign (js-object) (funcall project macro)
                   (js-object :macroContext
                     (js-object :capabilities (js-array "read-file")
                       :files (js-array (js-object :specifier "unused.txt" :content "declared-but-unused")
                                        (js-object :specifier "build-value.txt" :content value))))))))
        (funcall addSequence "macro-file-edits" "tests/macro-file-dependencies.test.mjs"
          (js-array
            (js-object :id "initial" :request (funcall macroProject "first-value") :artifact (js-object :kind "exports" :values (js-object :value "first-value")))
            (js-object :id "cache-hit" :request (funcall macroProject "first-value") :artifact (js-object :kind "exports" :values (js-object :value "first-value")) :sameProductAs "initial")
            (js-object :id "changed-file" :request (funcall macroProject "second-value") :artifact (js-object :kind "exports" :values (js-object :value "second-value")))
            (js-object :id "no-capability" :request (js-object :operation "stage" :stage "ir" :source macro :filename "macro-context.eli")
              :error (js-object :contains "macro capability is not enabled: read-file"))
            (js-object :id "undeclared-file"
              :request (js-object :operation "stage" :stage "ir" :source macro :filename "macro-context.eli"
                         :macroContext (js-object :capabilities (js-array "read-file") :files (js-array)))
              :error (js-object :contains "macro file dependency is not declared: build-value.txt"))
            (js-object :id "direct-context"
              :request (js-object :operation "stage" :stage "emitter" :source macro :filename "macro-context.eli"
                         :macroContext (js-object :capabilities (js-array "read-file")
                                         :files (js-array (js-object :specifier "build-value.txt" :content "forty-two"))))
              :containsData "const value = \"forty-two\";"))))
      (let ((provider (js-call (js-array
                                 "globalThis.__eliscript_import_effects ="
                                 "  (globalThis.__eliscript_import_effects ?? 0) + 1;"
                                 "export default 11;"
                                 "export const named_value = 22;"
                                 "export const namespace_value = 33;"
                                 "export const effect_count = () => globalThis.__eliscript_import_effects;"
                                 "")
                        :join "\n"))
            (imports (js-call (js-array
                                "(import \"./provider.mjs\")"
                                "(import \"./provider.mjs\" :default default-value effect-count named-value)"
                                "(import \"./provider.mjs\" :default namespace-default :as Provider)"
                                "(defun report ()"
                                "  (js-array default-value"
                                "            named-value"
                                "            namespace-default"
                                "            (get Provider \"namespace_value\")"
                                "            (effect-count)))"
                                "(export report)"
                                "")
                       :join "\n")))
        (funcall addSequence "esm-imports" "tests/esm-imports.test.mjs"
          (js-array
            (js-object :id "imports"
              :request (Object/assign (js-object) (funcall project imports)
                         (js-object :resolveImports false
                           :hostModules (js-array (js-object :id "provider.mjs" :specifier "./provider.mjs" :referrer "main.mjs"
                                                    :allowedExports (js-array "default" "effect_count" "named_value") :namespace t))
                           :hostSources (js-array (js-object :id "provider.mjs" :filename "provider.mjs" :source provider))))
              :sidecars (js-array (js-object :file "provider.mjs" :source provider))
              :artifact (js-object :kind "exports" :isolated t
                          :calls (js-array (js-object :name "report" :args (js-array) :expected (js-array 11 22 11 33 1))))))))
      (let ((protocolCases
              (js-array
                (js-array "single-defaults" "build-operation-request"
