                              (js-object :path (js-array "cache") :value (js-object :enabled t :status "partial" :reason "dirty-modules"))
                              (js-object :path (js-array "counts") :value (js-object :modules 2 :compiled 1 :reused 1))
                              (js-object :path (js-array "timings") :value (js-object :cacheReadMs 0.124 :workMs 1.234 :manifestWriteMs 0.346 :totalMs 1.704))
                              (js-object :path (js-array "modules" 0 "source") :value "src/main.eli")
                              (js-object :path (js-array "modules" 0 "dependencies") :value (js-array "src/value.eli"))
                              (js-object :path (js-array "modules" 1 "source") :value "src/value.eli")))
            (js-object :id "bad-report"
              :request (js-object :operation "protocol" :name "project-build-report"
                         :input (Object/assign (js-object) reportInput (js-object :cache (js-object :enabled "yes" :reason "verified"))))
              :error (js-object :contains "build report cache enabled must be a boolean"))
            (js-object :id "empty-entries"
              :request (js-object :operation "protocol" :name "project-request"
