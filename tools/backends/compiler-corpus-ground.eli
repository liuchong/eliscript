              :error (js-object :code "ELI-B0001" :phase "project-build"))
            (js-object :id "graph"
              :request (js-object :operation "protocol" :name "project-plan"
                         :input (js-object :entries (js-array "b" "a" "a") :dependencies (js-object :a (js-array "b") :b (js-array "a"))))
              :expected (js-object :format "eliscript-project-plan" :version 1 :mode "standard"
                          :entries (js-array "a" "b")
                          :modules (js-array (js-object :id "a" :dependencies (js-array "b"))
                                             (js-object :id "b" :dependencies (js-array "a")))))
            (js-object :id "portable-graph"
              :request (js-object :operation "protocol" :name "portable-project-plan"
                         :input (js-object :entries (js-array (js-object :id "a" :entries (js-array "x")))
                                  :resolutions (js-array
                                                 (js-object :id "a" :includes "z" :dependencies (js-array (js-object :id "c" :entries (js-array "q"))))
                                                 (js-object :id "a" :dependencies (js-array (js-object :id "b" :entries (js-array "y"))))
                                                 (js-object :id "b" :dependencies (js-array (js-object :id "a" :entries (js-array "z")))))))
              :expectFields (js-array
                              (js-object :path (js-array "calls")
                                :value (js-array (js-object :id "a" :entries (js-array "x"))
                                                 (js-object :id "b" :entries (js-array "y"))
                                                 (js-object :id "a" :entries (js-array "x" "z"))
                                                 (js-object :id "c" :entries (js-array "q"))))
                              (js-object :path (js-array "plan" "modules" 0 "entries") :value (js-array "x" "z"))
                              (js-object :path (js-array "plan" "modules" 0 "dependencies")
                                :value (js-array (js-object :id "b" :entries (js-array "y"))
                                                 (js-object :id "c" :entries (js-array "q")))))))))
      (let* ((configuration (js-object :schemaVersion 1 :entry "src/main.eli" :outDir "dist"))
