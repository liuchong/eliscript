(module tools.backends.compiler-corpus-ground
  (import "../../dist/bootstrap/reader.mjs" read-string)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile readdir)
  (import "node:path" resolve relative sep isAbsolute)
  (import "node:util" types)
  (import "node:url" pathToFileURL)
  (import "./compiler-corpus-runtime-adapters.mjs" addOriginalStdlibRuntimeAdapters originalRuntimeHostArtifact isOriginalRuntimeHostOnly originalRuntimeHostCompletionSource originalRuntimeOnlyCase)
  (import "./compiler-corpus-evaluation-adapters.mjs" addOriginalEvaluationPrograms)
  (import "./compiler-corpus-project-adapters.mjs" addOriginalProjectPrograms)
  (import "./compiler-corpus-cli-adapters.mjs" addOriginalCLIPrograms)
  (import "./compiler-corpus-managed-adapters.mjs" addOriginalManagedLibraryAdapters)
  (import "./compiler-corpus-managed-fixtures.mjs" addOriginalManagedFixtureAdapters)
  (import "./compiler-corpus-tools-artifact-adapters.mjs" addOriginalToolsArtifactPrograms originalToolsHostGateCase)
  (import "./compiler-corpus-identity-value-adapters.mjs" addOriginalIdentityValueAdapters)
  (import "./compiler-corpus-managed-cases.mjs" originalSourceCaseLocators)

  (defun null? (v) (= v nil))
  (defun nullish-or (a b) (if (nullish? a) b a))

  (defun digest (value)
    (js-call (js-call (createHash "sha256") :update value) :digest "hex"))

  (defconst stages (new globalThis.Set (js-array "reader" "expander" "analyzer" "ir")))

  (defconst originalReportOnlyLocators
    (new globalThis.Map
      (js-array
        (js-array "tests/compiler-runtime-scan.test.mjs" "committed compiler runtime scan report matches measured sources")
        (js-array "tests/compiler-ir-kind.test.mjs" "committed compiler IR kind report matches measured sources")
        (js-array "tests/compiler-indent.test.mjs" "committed compiler indentation report matches measured sources")
        (js-array "tests/compiler-locate.test.mjs" "committed compiler location report matches measured sources")
        (js-array "tests/compiler-binary-comparison.test.mjs" "committed binary comparison report matches measured sources")
        (js-array "tests/compiler-reader-character.test.mjs" "committed reader character report matches measured sources")
        (js-array "tests/compiler-source-map-cursor.test.mjs" "committed Source Map cursor report matches measured sources"))))

  (defconst textDecoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))

  (defun originalDataLiteral (source)
    (let* ((at 0)
           (ws-re (new globalThis.RegExp "\\s"))
           (key-re (new globalThis.RegExp "^[$A-Z_a-z][$\\w]*"))
           (lit-re (new globalThis.RegExp "^(?:true|false|null|-?(?:0|[1-9][0-9]*)(?:[.][0-9]+)?(?:[eE][+-]?[0-9]+)?)(?![$\\w.])"))
           (space (lambda ()
                    (while (and (< at (js-length source))
                                (js-call ws-re :test (nullish-or (aref source at) "")))
                      (setq at (1+ at)))))
           (parse-string (lambda ()
                           (let ((start at)
                                 (escaped false)
                                 (found nil)
                                 (done false))
                             (setq at (1+ at))
                             (while (and (< at (js-length source)) (not done))
                               (let ((code (aref source at)))
                                 (setq at (1+ at))
                                 (cond
                                   ((and (not escaped) (= code "\""))
                                    (setq found (JSON/parse (js-call source :slice start at)))
                                    (setq done t))
                                   ((and (not escaped) (= code "\\"))
                                    (setq escaped t))
                                   (t (setq escaped false)))))
                             (unless done
                               (throw (new globalThis.TypeError "unterminated original data string")))
                             found)))
           (parse-value nil))
      (setq parse-value
        (lambda ()
          (funcall space)
          (let ((code (aref source at)))
            (cond
              ((= code "\"") (funcall parse-string))
              ((or (= code "[") (= code "{"))
               (setq at (1+ at))
               (let* ((is-array (= code "["))
                      (result (if is-array (js-array) (js-object)))
                      (end-ch (if is-array "]" "}"))
                      (done false))
                 (funcall space)
                 (while (and (not done) (/= (aref source at) end-ch))
                   (when (>= at (js-length source))
                     (throw (new globalThis.TypeError "unterminated original data literal")))
                   (if is-array
                     (js-call result :push (funcall parse-value))
                     (progn
                       (funcall space)
                       (let ((key (if (= (aref source at) "\"")
                                    (funcall parse-string)
                                    (let ((match (js-call key-re :exec (js-call source :slice at))))
                                      (unless match
                                        (throw (new globalThis.TypeError "original data key is not literal")))
                                      (let ((k (aref match 0)))
                                        (setq at (+ at (js-length k)))
                                        k)))))
                         (funcall space)
                         (let ((colon (aref source at)))
                           (setq at (1+ at))
                           (unless (= colon ":")
                             (throw (new globalThis.TypeError "original data field lacks a colon"))))
                         (Object/defineProperty result key
                           (js-object :value (funcall parse-value)
                                      :writable t :enumerable t :configurable t)))))
                   (funcall space)
                   (if (= (aref source at) end-ch)
                     (setq done t)
                     (let ((comma (aref source at)))
                       (setq at (1+ at))
                       (unless (= comma ",")
                         (throw (new globalThis.TypeError "original data literal contains an expression")))
                       (funcall space))))
                 (setq at (1+ at))
                 result))
              (t
               (let ((literal (js-call lit-re :exec (js-call source :slice at))))
                 (unless literal
                   (throw (new globalThis.TypeError "original data contains a nonliteral expression")))
                 (let ((tok (aref literal 0)))
                   (setq at (+ at (js-length tok)))
                   (JSON/parse tok))))))))
      (let ((result (funcall parse-value)))
        (funcall space)
        (unless (= at (js-length source))
          (throw (new globalThis.TypeError "original data has trailing code")))
        result)))

  (defun originalRegion (source begin end &rest __opt)
    (let* ((from (aref __opt 0))
           (from-idx (if (undefined? from) 0 from))
           (start (js-call source :indexOf begin from-idx))
           (finish (if (< start 0) -1 (js-call source :indexOf end (+ start (js-length begin))))))
      (when (or (< start 0) (< finish 0))
        (throw (new globalThis.TypeError (str "original inline host boundary changed: " (JSON/stringify begin) " -> " (JSON/stringify end)))))
      (let ((text (js-call source :slice start finish)))
        (js-object :text text :start start :end finish
          :byteStart (js-call globalThis.Buffer :byteLength (js-call source :slice 0 start))
          :byteEnd (js-call globalThis.Buffer :byteLength (js-call source :slice 0 finish))
          :sha256 (digest (js-call globalThis.Buffer :from text))))))

  (defun eli-head-p (node name)
    (and node (= (get node :kind) "list") (Array/isArray (get node :items))
      (> (js-length (get node :items)) 0)
      (= (get (aref (get node :items) 0) :kind) "symbol")
      (= (get (aref (get node :items) 0) :name) name)))
  (defun eli-symbol-p (node name)
    (and node (= (get node :kind) "symbol") (= (get node :name) name)))
  (defun eli-binding-p (node name)
    (and (or (eli-head-p node "let") (eli-head-p node "let*"))
      (let ((bindings (get (aref (get node :items) 1) :items)))
        (and (Array/isArray bindings) (> (js-length bindings) 0)
             (eli-symbol-p (aref (get (aref bindings 0) :items) 0) name)))))
  (defun eli-unit-offset (source point)
    (let ((unit 0) (offset 0))
      (while (< offset point)
        (when (>= unit (js-length source))
          (throw (new globalThis.TypeError "original inline Eli AST span exceeds source")))
        (setq unit (+ unit (if (> (js-call source :codePointAt unit) 65535) 2 1)))
        (setq offset (1+ offset)))
      unit))
  (defun eli-node-text (source node)
    (let ((span (get node :span)))
      (js-call source :slice (eli-unit-offset source (get span :start)) (eli-unit-offset source (get span :end)))))
  (defun eli-walk (node predicate)
    (let ((result (js-array)) (pending (js-array node)))
      (while (> (js-length pending) 0)
        (let ((current (js-call pending :pop)))
          (when (funcall predicate current) (js-call result :push current))
          (when (and current (Array/isArray (get current :items)))
            (let* ((items (get current :items)) (index (1- (js-length items))))
              (while (>= index 0) (js-call pending :push (aref items index)) (setq index (1- index)))))))
      result))
  (defun eli-one (items label)
    (unless (= (js-length items) 1)
      (throw (new globalThis.TypeError (str "original inline Eli " label " requires one authentic AST boundary"))))
    (aref items 0))
  (defun eli-module-members (source filename)
    (let* ((forms (read-string source filename))
           (mod (eli-one (js-call forms :filter (lambda (node) (eli-head-p node "module"))) "module")))
      (get mod :items)))
  (defun eli-named-member (members head name)
    (eli-one (js-call members :filter (lambda (node)
               (and (eli-head-p node head) (> (js-length (get node :items)) 1)
                    (eli-symbol-p (aref (get node :items) 1) name))))
             (str head " " name)))
  (defun eli-test-case (members title)
    (eli-one (js-call members :filter (lambda (node)
               (and (eli-head-p node "test")
                    (= (get (aref (get node :items) 1) :kind) "literal")
                    (= (get (aref (get node :items) 1) :value) title))))
             title))
  (defun eli-static-data (node)
    (cond
      ((= (get node :kind) "literal") (get node :value))
      ((= (get node :kind) "keyword") (get node :name))
      ((= (get node :kind) "symbol")
       (let ((name (get node :name)))
         (cond ((= name "t") t) ((= name "false") false)
               ((or (= name "nil") (= name "null")) nil)
               (t (throw (new globalThis.TypeError (str "original static data symbol unsupported: " name)))))))
      ((and (eli-head-p node "-") (= (js-length (get node :items)) 2))
       (- (eli-static-data (aref (get node :items) 1))))
      ((eli-head-p node "js-array")
       (js-call (js-call (get node :items) :slice 1) :map eli-static-data))
      ((eli-head-p node "js-object")
       (let ((items (get node :items)) (result (js-object)) (index 1))
         (unless (= (% (1- (js-length items)) 2) 0)
           (throw (new globalThis.TypeError "original static js-object requires key/value pairs")))
         (while (< index (js-length items))
           (let ((key (eli-static-data (aref items index)))
                 (val (eli-static-data (aref items (1+ index)))))
             (Object/defineProperty result (funcall globalThis.String key)
               (js-object :value val :writable t :enumerable t :configurable t)))
           (setq index (+ index 2)))
         result))
      (t (throw (new globalThis.TypeError "original static data contains a nonliteral expression")))))
  ;; Stable fixture coverage binds maintained sources. Generated host modules
  ;; remain execution assets and are authenticated as exact compiler products.
  (defun stable-fixture-source (files filename)
    (cond ((js-call files :has filename) filename)
          ((js-call filename :endsWith ".mjs")
           (let ((source (str (js-call filename :slice 0 -4) ".eli")))
             (when (js-call files :has source) source)))
          (t nil)))
  (defasync maintained-fixture-proof (source artifact text file)
    (let* ((source-proof (await (funcall file source)))
           (artifact-proof (await (funcall file artifact)))
           (expected (compile-string (await (funcall text source)) source))
           (actual (js-call (await (funcall text artifact)) :replace
             (new globalThis.RegExp "\\n?//# sourceMappingURL=[^\\r\\n]*\\r?\\n?$") "\n")))
      (unless (= (js-call expected :trimEnd) (js-call actual :trimEnd))
        (throw (new globalThis.TypeError (str "maintained fixture differs from its actual compiler output: " source))))
      (js-object :file source :sourceSha256 (get source-proof :sha256)
        :artifact artifact :artifactSha256 (get artifact-proof :sha256))))
  (defun suite-case-region (file suite-text title)
    (let* ((cases (originalSourceCaseLocators file suite-text))
           (matched (eli-one (js-call cases :filter
                      (lambda (item) (= (get (get item :originalCase) :title) title))) title))
           (span (get (get matched :originalCase) :span))
           (start (get span :start)) (end (get span :end))
           (slice (js-call suite-text :slice start end)))
      (js-object :start start :end end
        :byteStart (js-call globalThis.Buffer :byteLength (js-call suite-text :slice 0 start))
        :byteEnd (js-call globalThis.Buffer :byteLength (js-call suite-text :slice 0 end))
        :sha256 (digest (js-call globalThis.Buffer :from slice)))))

  (defun originalInlineArray (source begin end bindings joiner)
    (let* ((region (originalRegion source begin end))
           (body (js-call (get region :text) :slice (js-length begin)))
           (lines (js-call (js-call (js-call body :split "\n") :map (lambda (line) (js-call line :trim)))
                    :filter globalThis.Boolean))
           (parts (js-array))
           (quote-re (new globalThis.RegExp "[\\\\']"))
           (index 0))
      (while (< index (js-length lines))
        (let ((line (aref lines index)))
          (unless (js-call bindings :has line)
            (let* ((literal (if (js-call line :endsWith ",") (js-call line :slice 0 -1) line))
                   (plain-single (and (= (aref literal 0) "'")
                                      (= (js-call literal :at -1) "'")
                                      (not (js-call quote-re :test (js-call literal :slice 1 -1))))))
              (when (and (/= (aref literal 0) "\"") (not plain-single))
                (throw (new globalThis.TypeError "original inline host contains unsupported dynamic concatenation")))
              (let ((value (if plain-single (js-call literal :slice 1 -1) (originalDataLiteral literal))))
                (unless (= (value-type value) "string")
                  (throw (new globalThis.TypeError "original inline host item is not a string literal")))
                (js-call parts :push value)))))
        (setq index (1+ index)))
      (unless (= (js-length (js-call lines :filter (lambda (line) (js-call bindings :has line))))
                 (get bindings :size))
        (throw (new globalThis.TypeError "original host-path interpolation changed")))
      (Object/assign (js-object) region (js-object :code (js-call parts :join joiner)))))

  (defun originalTemplate (source prefix &rest __opt)
    (let* ((bindings-opt (aref __opt 0))
           (bindings (if (undefined? bindings-opt) (new globalThis.Map) bindings-opt))
           (start (js-call source :indexOf prefix)))
      (when (< start 0)
        (throw (new globalThis.TypeError "original template boundary changed")))
      (let ((at (+ start (js-length prefix)))
            (code "")
            (result nil)
            (simple (Object/fromEntries
                      (js-array
                        (js-array "n" "\n") (js-array "r" "\r") (js-array "t" "\t")
                        (js-array "b" "\b") (js-array "f" "\f") (js-array "v" "\u000b")
                        (js-array "0" "\u0000") (js-array "\\" "\\") (js-array "`" "`")
                        (js-array "$" "$") (js-array "'" "'") (js-array "\"" "\"")))))
        (while (and (< at (js-length source)) (null? result))
          (let ((unit (aref source at)))
            (setq at (1+ at))
            (cond
              ((= unit "`")
               (setq result
                 (js-object :code code :start start :end at
                   :byteStart (js-call globalThis.Buffer :byteLength (js-call source :slice 0 start))
                   :byteEnd (js-call globalThis.Buffer :byteLength (js-call source :slice 0 at))
                   :sha256 (digest (js-call globalThis.Buffer :from (js-call source :slice start at))))))
              ((and (= unit "$") (= (aref source at) "{"))
               (let* ((end (js-call source :indexOf "}" (1+ at)))
                      (name (js-call source :slice (1+ at) end)))
                 (when (or (< end 0) (not (js-call bindings :has name)))
                   (throw (new globalThis.TypeError "original template has an unbound interpolation")))
                 (setq code (+ code (js-call bindings :get name)))
                 (setq at (1+ end))))
              ((/= unit "\\")
               (setq code (+ code unit)))
              (t
               (let ((escape (aref source at)))
                 (setq at (1+ at))
                 (cond
                   ((Object/hasOwn simple escape)
                    (setq code (+ code (get simple escape))))
                   ((= escape "\n") nil)
                   ((= escape "\r")
                    (when (= (aref source at) "\n")
                      (setq at (1+ at))))
                   ((or (= escape "x") (= escape "u"))
                    (let* ((count (if (= escape "x") 2 4))
                           (hex (js-call source :slice at (+ at count))))
                      (unless (js-call (new globalThis.RegExp (str "^[0-9a-fA-F]{" count "}$")) :test hex)
                        (throw (new globalThis.TypeError "original template contains unsupported escape")))
                      (setq code (+ code (String/fromCharCode (globalThis.parseInt hex 16))))
                      (setq at (+ at count))))
                   (t (throw (new globalThis.TypeError "original template contains unsupported escape")))))))))
        (when (null? result)
          (throw (new globalThis.TypeError "unterminated original template")))
        result)))

  (defun sourcePath (root filename)
    (when (or (/= (value-type filename) "string")
              (not filename)
              (isAbsolute filename)
              (js-call (new globalThis.RegExp "[\\\\:\\u0000]") :test filename))
      (throw (new globalThis.TypeError "invalid original corpus filename")))
    (let* ((path (resolve root filename))
           (part (relative (resolve root) path)))
      (when (or (isAbsolute part) (= part "..") (js-call part :startsWith (str ".." sep)))
        (throw (new globalThis.TypeError "original corpus filename escapes its root")))
      path))

  (defun createOriginalCorpusSourceReader (options)
    (let* ((sourceRoot (get options :sourceRoot))
           (read (if (undefined? (get options :read)) readFile (get options :read)))
           (decode (if (undefined? (get options :decode))
                     (lambda (bytes) (js-call textDecoder :decode bytes))
                     (get options :decode)))
           (files (new globalThis.Map))
           (loading (new globalThis.Map))
           (decoded (new globalThis.Map))
           (read-file-fn
             (async (filename)
               (unless (js-call files :has filename)
                 (unless (js-call loading :has filename)
                   (js-call loading :set filename
                     (funcall
                       (async ()
                         (let* ((bytes (await (funcall read (sourcePath sourceRoot filename))))
                                (asset (js-object :file filename :sha256 (digest bytes) :bytes (js-length bytes)
                                         :encoding "base64" :content (js-call bytes :toString "base64"))))
                           (js-call files :set filename asset))))))
                 (try
                   (await (js-call loading :get filename))
                   (finally (js-call loading :delete filename))))
               (js-call files :get filename)))
           (read-text-fn
             (async (filename)
               (let ((asset (await (funcall read-file-fn filename))))
                 (unless (js-call decoded :has filename)
                   (js-call decoded :set filename
                     (funcall decode (js-call globalThis.Buffer :from (get asset :content) "base64"))))
                 (js-call decoded :get filename)))))
      (js-object :file read-file-fn :text read-text-fn
        :evidence (lambda () (Array/from (js-call files :values))))))

  (defun cloneCompilerCorpusData (value)
    (let* ((shapes (new globalThis.Map))
           (pending (js-array value))
           (fallback-used false)
           (fallback-result nil)
           (trigger-fallback
             (lambda ()
               (js-call shapes :clear)
               (put pending :length 0)
               (setq fallback-used t)
               (setq fallback-result (globalThis.structuredClone value)))))
      (while (and (> (js-length pending) 0) (not fallback-used))
        (let* ((item (js-call pending :pop))
               (kind (value-type item)))
          (unless (or (null? item) (= kind "undefined") (= kind "string") (= kind "number")
                      (= kind "boolean") (= kind "bigint"))
            (if (or (/= kind "object") (js-call types :isProxy item))
              (funcall trigger-fallback)
              (unless (js-call shapes :has item)
                (let* ((is-arr (Array/isArray item))
                       (proto (Object/getPrototypeOf item)))
                  (if (if is-arr
                        (not (eq proto (get globalThis.Array :prototype)))
                        (and (not (eq proto (get globalThis.Object :prototype))) (not (null? proto))))
                    (funcall trigger-fallback)
                    (let* ((descriptors (Object/getOwnPropertyDescriptors item))
                           (keys (Object/keys descriptors))
                           (entries (js-array))
                           (k-idx 0))
                      (while (and (< k-idx (js-length keys)) (not fallback-used))
                        (let* ((key (aref keys k-idx))
                               (descriptor (get descriptors key)))
                          (if (not (Object/hasOwn descriptor "value"))
                            (funcall trigger-fallback)
                            (when (get descriptor :enumerable)
                              (js-call entries :push key (get descriptor :value))
                              (js-call pending :push (get descriptor :value)))))
                        (setq k-idx (1+ k-idx)))
                      (unless fallback-used
                        (js-call shapes :set item
                          (js-object :array is-arr
                            :length (if is-arr (get (get descriptors :length) :value) 0)
                            :entries entries)))))))))))
      (if fallback-used
        fallback-result
        (let ((shape-list (Array/from (js-call shapes :values)))
              (s-idx 0))
          (while (< s-idx (js-length shape-list))
            (let ((shape (aref shape-list s-idx)))
              (put shape :copy (if (get shape :array) (new globalThis.Array (get shape :length)) (js-object))))
            (setq s-idx (1+ s-idx)))
          (setq s-idx 0)
          (while (< s-idx (js-length shape-list))
            (let* ((shape (aref shape-list s-idx))
                   (entries (get shape :entries))
                   (e-idx 0))
              (while (< e-idx (js-length entries))
                (let ((key (aref entries e-idx))
                      (member (aref entries (1+ e-idx))))
                  (Object/defineProperty (get shape :copy) key
                    (js-object :value (if (and (not (null? member)) (= (value-type member) "object"))
                                        (get (js-call shapes :get member) :copy)
                                        member)
                               :writable t :enumerable t :configurable t)))
                (setq e-idx (+ e-idx 2))))
            (setq s-idx (1+ s-idx)))
          (if (and (not (null? value)) (= (value-type value) "object"))
            (get (js-call shapes :get value) :copy)
            value)))))

  (defun cloneCompilerCorpusModules (modules)
    (cloneCompilerCorpusData modules))

  (defun cloneSourceProjectRequest (request)
    (cloneCompilerCorpusData request))

  (defasync loadOriginalCompilerCorpus (options)
    (let* ((sourceRoot (get options :sourceRoot))
           (originals (get options :originals)))
      (when (or (not (and originals (get originals :manifests))) (/= (value-type sourceRoot) "string"))
        (throw (new globalThis.TypeError "original compiler manifests and sourceRoot are required")))
      (let* ((parity (js-call (get originals :manifests) :find (lambda (item) (= (get item :id) "compiler-parity"))))
             (stable (js-call (get originals :manifests) :find (lambda (item) (= (get item :id) "stable-compatibility")))))
        (when (or (not parity) (not stable))
          (throw (new globalThis.Error "both original compiler corpora are required")))
        (let* ((records (js-array))
               (claimed (new globalThis.Set))
               (irCases (js-array))
               (fullyMappedSuites (new globalThis.Set))
               (reader (createOriginalCorpusSourceReader (js-object :sourceRoot sourceRoot)))
               (file (get reader :file))
               (text (get reader :text))
               (sourceEvidence (get reader :evidence))
               (json (async (filename) (JSON/parse (await (funcall text filename)))))
               (diagnostics (await (funcall json "contracts/diagnostic-corpus.json")))
               (add (lambda (record)
                      (js-call (get record :coverage) :forEach (lambda (id) (js-call claimed :add id)))
                      (js-call records :push record)))
               (bindCoverage
                 (lambda (record ids)
                   (when (or (not (js-call records :includes record))
                             (not (Array/isArray ids))
                             (js-call ids :some (lambda (id)
                               (or (/= (value-type id) "string")
                                   (not (js-call (get originals :requiredCoverage) :includes id))))))
                     (throw (new globalThis.TypeError "original coverage must bind an existing recipe and retained identities")))
                   (js-call ids :forEach (lambda (id)
                     (unless (js-call (get record :coverage) :includes id)
                       (js-call (get record :coverage) :push id))
                     (js-call claimed :add id)))))
               (stableFiles (new globalThis.Set (get (get stable :document) :fixtureFiles)))
               (parity-fixtures (get (get parity :document) :fixtures))
               (pf-idx 0))
          (while (< pf-idx (js-length parity-fixtures))
            (let ((fixture (aref parity-fixtures pf-idx)))
              (unless (js-call stages :has (get fixture :id))
                (throw (new globalThis.Error (str "unrepresented original compiler stage: " (get fixture :id)))))
              (let ((suite (await (funcall json (get fixture :file))))
                    (classifications (js-array "valid" "invalid"))
                    (c-idx 0))
                (while (< c-idx (js-length classifications))
