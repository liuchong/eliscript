(module tools.backends.compiler-corpus-program-driver
  (import "./compiler-corpus-process.mjs" readOriginalCorpusExecutionContext)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:path" basename resolve)
  (import "node:fs/promises" appendFile mkdir mkdtemp readFile writeFile)
  (import "node:crypto" createHash)
  (import "node:util" inspect types)
  (import "./managed-source-view.mjs" isManagedSourceView snapshotManagedSourceView)
  (import "./compiler-metadata.mjs" readCompilerMetadata)
  (import "./compiler-corpus-host-context.mjs" openOriginalProgramContext inheritOriginalProgramContext originalProgramBunLauncher)
  (import "./compiler-corpus-original-program.mjs" originalProgramArguments)
  (import "./managed-runtime.mjs" loadManagedHostModules)
  (import "node:assert/strict" :default assert)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "../../bootstrap/host/bun.mjs" loadCompiler)
  (defasync loadOriginalProgramBody (specifier base)
    ;; A real file with a static namespace import retains the original body's
    ;; TLA and ESM identity on both hosts. Read that namespace synchronously;
    ;; Promise assimilation must never replace the loader's namespace value.
    (await (mkdir base (js-object :recursive t)))
    (let* ((directory (await (mkdtemp (resolve base "original-body-namespace-"))))
           (source (str "(import " (JSON/stringify specifier) " :as originalNamespace)\n"
             "(defun readOriginalNamespace () originalNamespace)\n(export readOriginalNamespace)")))
      (await (writeFile (resolve directory "compiler.mjs")
        (compile-string source "original-program-body-namespace.eli")))
      (let* ((reader (await (loadCompiler directory)))
             (namespace (js-call reader :readOriginalNamespace))
             (descriptor (js-object :hostModules
               (js-array (js-object :id "original-body" :specifier specifier :referrer "original-program-driver.mjs"
                 :allowedExports (js-array) :namespace t))))
             (provided (js-object :hostModules (new globalThis.Map (js-array (js-array "original-body" namespace)))))
             (loaded (await (loadManagedHostModules descriptor provided))))
        (js-call assert :strictEqual (get namespace globalThis.Symbol.toStringTag) "Module")
        (js-call assert :strictEqual (js-call loaded :get "original-body") namespace)
        ;; Maintained Eli original hosts expose their asynchronous completion
        ;; through then. Await it without changing the genuine namespace Map.
        (await namespace)
        loaded)))
  (defconst wire-host-sha "eb7664103d14a0343f8bbe98ab4124cf03079e5af6f7f5138fa616e36f1b4eb5")
  (defconst wire-inspect-options (js-object :depth nil :maxArrayLength nil :maxStringLength nil
    :customInspect false :getters false :colors false))
  (defun wire-inspect (value) (inspect value wire-inspect-options))
  (defun wire-readable (value)
    (and (not (nullish? value))
      (or (not (js-call types :isProxy value)) (isManagedSourceView value))))
  (defun wire-own-value (value key)
    (if (not (wire-readable value)) (js-object :observable false :reason "opaque or null value")
      (let ((entry (Reflect/getOwnPropertyDescriptor value key)))
        (cond ((undefined? entry) (js-object :observable false :reason "missing own property"))
          ((not (Object/hasOwn entry "value")) (js-object :observable false :reason "accessor not invoked"))
          (t (js-object :observable t :value (get entry :value)))))))
  (defun wire-tags (value)
    (let ((user (wire-own-value value "User")))
      (if (get user :observable) (wire-own-value (get user :value) "tags") user)))
  (defun wire-constructor (value)
    (let ((seen (new globalThis.WeakSet)) (current value) (found undefined))
      (while (and (not (nullish? current)) (undefined? found))
        (cond ((not (wire-readable current)) (setq found (js-object :observable false :reason "opaque prototype")))
          ((js-call seen :has current) (setq found (js-object :observable false :reason "prototype cycle")))
          (t
            (js-call seen :add current)
            (let ((entry (Reflect/getOwnPropertyDescriptor current "constructor")))
              (if (undefined? entry) (setq current (Reflect/getPrototypeOf current))
                (setq found (if (Object/hasOwn entry "value")
                  (js-object :observable t :value (get entry :value))
                  (js-object :observable false :reason "constructor accessor not invoked"))))))))
      (or found (js-object :observable t :value undefined))))
  (defun wire-array-evidence (actual expected)
    (let ((left (wire-tags actual)) (right (wire-tags expected)))
      (if (not (and (get left :observable) (get right :observable)
                    (Array/isArray (get left :value)) (Array/isArray (get right :value))))
        (js-object :observable false :actual (get left :reason "not an array") :expected (get right :reason "not an array"))
        (let* ((a (get left :value)) (b (get right :value))
               (ac (wire-constructor a)) (bc (wire-constructor b)))
          (js-object :observable t
            :actualLength (wire-inspect (wire-own-value a "length"))
            :expectedLength (wire-inspect (wire-own-value b "length"))
            :actualOwnKeys (wire-inspect (Reflect/ownKeys a))
            :expectedOwnKeys (wire-inspect (Reflect/ownKeys b))
            :prototypeSame (eq (Reflect/getPrototypeOf a) (Reflect/getPrototypeOf b))
            :constructorObservable (and (get ac :observable) (get bc :observable))
            :constructorSame (when (and (get ac :observable) (get bc :observable)) (eq (get ac :value) (get bc :value)))
            :constructorUnavailable (unless (and (get ac :observable) (get bc :observable))
              (js-array (get ac :reason) (get bc :reason))))))))
  (defasync recordOriginalWireFailure (input error)
    ;; This is failure evidence only. The original result/error are never
    ;; replaced, re-invoked, JSON-coerced or supplied to another assertion.
    (let ((destination undefined) (receipt undefined))
      (try
        (let* ((serialized (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT))
               (context (when serialized (readOriginalCorpusExecutionContext serialized)))
               (id (when context (get context :caseId)))
               (eligible (and context
                 (js-call (js-array "wasm" "native") :includes (get context :target))
                 (= (value-type id) "string")
                 (or (= id "stable-compatibility:program:tests/fixtures/wire.eli")
                   (js-call (new globalThis.RegExp "^original-managed:wire-original-host:(node|bun):auto-(1|65536)$") :test id))
                 (= (value-type (get context :directory)) "string")
                 (get context :sourceIdentity))))
          (when eligible
            (let* ((host (await (readFile (get input :host))))
                   (original (await (readFile (resolve (get input :sourceRoot) "tests/fixtures/wire-host.mjs"))))
                   (digest (lambda (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))))
              (when (and (= (funcall digest host) wire-host-sha) (= (funcall digest original) wire-host-sha)
                         (not (js-call types :isProxy error)) (js-call types :isNativeError error))
                (let ((code (wire-own-value error "code")) (actual (wire-own-value error "actual"))
                      (expected (wire-own-value error "expected")))
                  (when (and (get code :observable) (= (get code :value) "ERR_ASSERTION")
                             (get actual :observable) (get expected :observable)
                             (isManagedSourceView (get actual :value)))
                    (setq destination (resolve (get context :directory) "wire-first-failure.json"))
                    (setq receipt (js-object :version 1 :caseId id :target (get context :target)
                      :sourceIdentity (get context :sourceIdentity) :originalHostSha256 wire-host-sha
                      :phase "original-wire-assertion-before-close" :status "unobservable"))
                    (let ((snapshot (snapshotManagedSourceView (get actual :value))))
                      (put receipt :actualOwnKeys (wire-inspect (Reflect/ownKeys snapshot)))
                      (put receipt :actualSnapshot (wire-inspect snapshot))
                      (put receipt :expected (wire-inspect (get expected :value)))
                      (put receipt :tags (wire-array-evidence (get actual :value) (get expected :value)))
                      (put receipt :status "observed"))))))))
        (catch diagnostic-error
          (when receipt (put receipt :diagnosticError (wire-inspect diagnostic-error)))))
      (when destination
        (try (await (writeFile destination (JSON/stringify receipt)))
          (catch diagnostic-error
            (try (js-call globalThis.console :error "wire failure diagnostic could not be saved" (wire-inspect diagnostic-error))
              (catch ignored nil)))))))
  (defasync runOriginalProgramDriver (configuration)
    (let* ((input (await (readCompilerMetadata configuration))) (context undefined)
           (failed false) (first undefined) (sequence 0)
           (stage (async (phase)
             (when (get input :driverEvidence)
               (await (appendFile (get input :driverEvidence)
                 (str (JSON/stringify (js-object :sequence sequence :phase phase :pid (get globalThis.process :pid)
                   :time (js-call globalThis.performance :now))) "\n"))))
             (setq sequence (1+ sequence)))))
      (put (get globalThis.process :env) :ELISCRIPT_ORIGINAL_TARGET (get input :target))
      (put (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT (get input :sourceRoot))
      (try
        (progn
          (await (funcall stage "runtime-open-start"))
          (setq context (await (openOriginalProgramContext input (js-object :identity configuration))))
          (await (funcall stage "runtime-open-end"))
          (when (= (get input :childProcesses) "inherit-selected-artifact")
            (inheritOriginalProgramContext (js-object :configuration configuration :sourceRoot (get input :sourceRoot))))
          (when (get input :runtimeLaunchers)
            (let ((launcher (await (originalProgramBunLauncher
                    (js-object :directory (fileURLToPath (get input :base)) :bun (get globalThis.process :execPath)
                      :configuration configuration :sourceRoot (get input :sourceRoot))))))
              (put (get globalThis.process :env) :ELISCRIPT_ORIGINAL_BUN launcher)
              (put (get globalThis.process :env) :ELISCRIPT_JS_RUNTIME launcher)))
          (await (funcall stage "host-start"))
          (let ((entry (new globalThis.URL (get input :entry) (get input :base))))
            (cond
              ((get input :hostEval)
               (put (get globalThis.process :env) (get input :environment) (fileURLToPath entry))
               (await (loadOriginalProgramBody (str "data:text/javascript;charset=utf-8," (globalThis.encodeURIComponent (get input :hostEval))) (fileURLToPath (get input :base)))))
              ((get input :host)
               (put globalThis.process :argv (js-call (js-array (get globalThis.process :execPath) (get input :host)) :concat
                  (originalProgramArguments input (get input :entry) (get input :base))))
               (await (loadOriginalProgramBody (get (pathToFileURL (get input :host)) :href) (fileURLToPath (get input :base)))))
              (t (await (loadOriginalProgramBody (get (new globalThis.URL (get (get context :facades) :loadEntry) (get input :base)) :href) (fileURLToPath (get input :base)))))))
          (await (funcall stage "host-end")))
        (catch error
          (setq failed t first error)
          (try (await (recordOriginalWireFailure input error)) (catch ignored nil)))
        (finally
          (when context
            (try
              (progn (await (funcall stage "runtime-close-start")) (await (js-call context :close))
                     (await (funcall stage "runtime-close-end")))
              (catch error
                (if failed
                  (try
                    (when (get input :driverEvidence)
                      (await (appendFile (get input :driverEvidence)
                        (str (JSON/stringify (js-object :sequence sequence :phase "runtime-close-secondary-failure"
                          :secondaryFailure (cond ((undefined? error) (js-object :$eliscriptObservation "undefined"))
                            ((and error (js-call globalThis.Error globalThis.Symbol.hasInstance error))
                             (js-object :name (get error :name) :message (get error :message) :stack (get error :stack)))
                            (t error)))) "\n"))))
                    (catch ignored nil))
                  (setq failed t first error)))))))
      (when failed (throw first))))
  (let ((path (aref (get globalThis.process :argv) 1)))
    (when (and (= (value-type path) "string") (= (basename path) "compiler-corpus-program-driver.mjs"))
      (js-call (runOriginalProgramDriver (aref (get globalThis.process :argv) 2)) :catch
        (lambda (error) (js-call globalThis.console :error error) (put globalThis.process :exitCode 1)))))
  (export runOriginalProgramDriver recordOriginalWireFailure loadOriginalProgramBody))
