(module tools.backends.compiler-corpus-raw-special-fixtures
  (import "node:assert/strict" :default assert)
  (import "./compiler-corpus-raw-fixture-observer.mjs" raw-scope)

  ;; These are observations of the original raw ABI, not language-value
  ;; conversions. Opaque source identities are compared in their owning heap.
  (defun oracle-call (oracle name &rest args)
    (Reflect/apply (get oracle (js-call name :replaceAll "-" "_")) oracle args))
  (defun each (values body) (js-call values :forEach body))
  (defun property-outcome (action raw)
    (try (js-object :value (funcall action))
      (catch error
        (if raw
          (progn
            (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003")
            (js-object :error (js-object :name "TypeError")))
          (js-object :error (js-object :name (get error :name)))))))
  (defun call-args (scope name values)
    (Reflect/apply (get scope :call) scope
      (js-call (js-array name) :concat (js-call values :map (lambda (value) (js-call scope :box value))))))
  (defun run-vector (check oracle family)
    (each (if (= family "persistent-vector-auto-1") (js-array 33)
      (js-array 0 1 31 32 33 63 64 65 1023 1024 1025 1056 1057))
      (lambda (count)
        (funcall check (if (= family "persistent-vector-auto-1") "collecting persistent Vector callbacks"
          (str "full persistent Vector boundaries " count)) (lambda (scope)
          (js-call assert :deepStrictEqual
            (js-call scope :value "vector-case" (js-call scope :box count))
            (oracle-call oracle "vector-case" count)))))))

  (defun run-symbols (check oracle)
    (funcall check "symbol identities and protocols" (lambda (s)
      (js-call assert :deepStrictEqual
        (js-array (js-call s :value "identities") (js-call s :value "exercise"))
        (js-array (oracle-call oracle "identities") (oracle-call oracle "exercise")))))
    (each (js-array (js-array) (js-array undefined) (js-array nil) (js-array "")
            (js-array "中😀\ud800") (js-array 7))
      (lambda (args) (funcall check "unique symbols" (lambda (s)
        (let ((a (call-args s "create" args)) (b (call-args s "create" args))
              (ra (Reflect/apply (get oracle :create) oracle args))
              (rb (Reflect/apply (get oracle :create) oracle args)))
          (js-call assert :strictEqual (get a :kind) 22)
          (js-call assert :strictEqual (get b :kind) 22)
          (js-call assert :deepStrictEqual
            (js-array (js-call s :value "equal" a a) (js-call s :value "equal" a b)
              (js-call s :value "description" a) (js-call s :value "label" a)
              (js-call s :value "text" a) (js-call s :value "key" a))
            (js-array (oracle-call oracle "equal" ra ra) (oracle-call oracle "equal" ra rb)
              (oracle-call oracle "description" ra) (oracle-call oracle "label" ra)
              (oracle-call oracle "text" ra) (oracle-call oracle "key" ra))))))))
    (each (js-array "" "shared" "中😀\ud800") (lambda (name)
      (funcall check "registered symbols" (lambda (s)
        (let ((a (js-call s :call "registered" (js-call s :box name)))
              (b (js-call s :call "registered" (js-call s :box name)))
              (ra (oracle-call oracle "registered" name)) (rb (oracle-call oracle "registered" name)))
          (js-call assert :deepStrictEqual
            (js-array (js-call s :value "equal" a b) (js-call s :value "key" a) (js-call s :value "description" a))
            (js-array (oracle-call oracle "equal" ra rb) (oracle-call oracle "key" ra) (oracle-call oracle "description" ra))))))))
    (funcall check "well known symbols" (lambda (s)
      (let ((iterator (js-call s :call "iterator")) (primitive (js-call s :call "primitive")))
        (js-call assert :strictEqual (oracle-call oracle "iterator") globalThis.Symbol.iterator)
        (js-call assert :strictEqual (oracle-call oracle "primitive") globalThis.Symbol.toPrimitive)
        (js-call assert :strictEqual (js-call s :value "equal" iterator (js-call s :call "iterator")) t)
        (js-call assert :strictEqual (js-call s :value "equal" primitive (js-call s :call "primitive")) t)
        (js-call assert :strictEqual (js-call s :value "equal" iterator primitive) false)
        (js-call assert :deepStrictEqual
          (js-array (js-call s :value "description" iterator) (js-call s :value "description" primitive)
            (js-call s :value "key" iterator) (js-call s :value "key" primitive))
          (js-array "Symbol.iterator" "Symbol.toPrimitive" undefined undefined)))))
    (funcall check "symbol property identity" (lambda (s)
      (let* ((key (js-call s :call "create" (js-call s :box "x")))
             (a (js-call s :object (js-object))) (b (js-call s :object (js-object)))
             (rk (oracle-call oracle "create" "x")) (ra (js-object)) (rb (js-object)))
        (js-call s :call "write" a key (js-call s :box 7)) (oracle-call oracle "write" ra rk 7)
        (js-call s :call "assign" b a) (oracle-call oracle "assign" rb ra)
        (let ((keys (js-call s :call "symbols" b)))
          (js-call assert :ok (js-call s :same (js-call s :get keys 0) key)))
        (js-call assert :strictEqual (aref (oracle-call oracle "symbols" rb) 0) rk)
        (js-call assert :deepStrictEqual
          (js-array (js-call s :value "own" a key) (js-call s :value "member" b key)
            (js-call s :value "keys" a) (js-call s :value "json" a))
          (js-array (oracle-call oracle "own" ra rk) (oracle-call oracle "member" rb rk)
            (oracle-call oracle "keys" ra) (oracle-call oracle "json" ra)))))))

  (defun run-regexp (check oracle)
    (each (js-array "0" "-0" "+1" ".5" "1." "1.e2" "1e-2" "+1e" "0x10" "x" "" "1\n" nil t 65 globalThis.NaN globalThis.Infinity)
      (lambda (value) (funcall check "numeric regexp" (lambda (s)
        (js-call assert :strictEqual (js-call s :value "numeric" (js-call s :box value)) (oracle-call oracle "numeric" value))))))
    (each (js-array "" "a" "aa" "bc" "abc" "ab" "1" "a\nb" "a\nb\nc" "wordx" "words" "\u0000" "😀" "\ud800" "zzab12")
      (lambda (text) (each (js-array "groups" "nullable" "unicode") (lambda (name)
        (funcall check name (lambda (s)
          (let ((out (js-call s :call name (js-call s :box text))) (ref (oracle-call oracle name text)))
            (if (eq ref nil) (js-call assert :strictEqual out nil)
              (progn
                (js-call assert :deepStrictEqual (js-call s :read out) (Array/from ref))
                (each (js-array "index" "input" "groups") (lambda (key)
                  (js-call assert :deepStrictEqual (js-call s :value "meta" out (js-call s :box key))
                    (oracle-call oracle "meta" ref key))))
                (js-call assert :deepStrictEqual (js-call s :value "keys" out) (oracle-call oracle "keys" ref)))))))))))
    (each (js-array "b" "a\nb" "ab" "b\n" "a\nb\nc") (lambda (text)
      (funcall check "multiline" (lambda (s)
        (js-call assert :strictEqual (js-call s :value "line" (js-call s :box text)) (oracle-call oracle "line" text))))))
    (funcall check "regexp call capture" (lambda (s)
      (let ((trace (js-call s :object (js-object))) (expected (js-object)))
        (js-call assert :deepStrictEqual
          (js-array (js-call s :value "capture" (js-call s :box "12") trace) (js-call s :read trace))
          (js-array (oracle-call oracle "capture" "12" expected) expected))))))

  (defun run-module-bindings (check oracle runtime)
    (funcall check "initializers and live exports" (lambda (s)
      (let* ((state (js-call s :export "state")) (identity (js-call s :export "identity"))
             (result (js-array)) (expected (js-array)))
        (js-call assert :ok (Object/is (js-call s :read (js-call s :export "negative-zero")) -0))
        (js-call assert :ok (Object/is (get oracle :negative_zero) -0))
        (js-call assert :ok (js-call s :same (js-call s :property state "self") state))
        (js-call assert :strictEqual (get (get oracle :state) :self) (get oracle :state))
        (js-call assert :ok (js-call s :same (js-call s :call "read-state") state))
        (js-call assert :strictEqual (oracle-call oracle "read-state") (get oracle :state))
        (js-call assert :ok (js-call s :same (js-call s :call "identity-value") identity))
        (js-call assert :strictEqual (oracle-call oracle "identity-value") (get oracle :identity))
        (each (js-array "initialization-log" "first" "second" "counter" "unset" "missing") (lambda (name)
          (js-call result :push (js-call s :read (js-call s :export name)))
          (let ((value (get oracle (js-call name :replaceAll "-" "_"))))
            (js-call expected :push (if (Array/isArray value) (js-call value :slice) value)))))
        (let ((i 0))
          (while (< i 8)
            (js-call result :push (js-call s :value "tick")) (js-call expected :push (oracle-call oracle "tick"))
            (setq i (1+ i))))
        (js-call s :call "write-counter" (js-call s :box 9)) (oracle-call oracle "write-counter" 9)
        (js-call result :push (js-call s :read (js-call s :export "counter")) (js-call s :value "read-counter")
          (js-call s :value "local-counter" (js-call s :box 3)) (js-call s :value "emitted-alias" (js-call s :box 99)))
        (js-call expected :push (get oracle :counter) (oracle-call oracle "read-counter")
          (oracle-call oracle "local-counter" 3) (oracle-call oracle "emitted-alias" 99))
        ;; Only an existing source closure crosses this boundary; no host
        ;; callback is injected into the zero-import program.
        (let ((closure (js-call runtime :toHostValue (js-call s :call "captured-global")))
              (reference (oracle-call oracle "captured-global")))
          (js-call result :push (funcall closure 2) (funcall closure 3) (js-call s :value "read-counter"))
          (js-call expected :push (funcall reference 2) (funcall reference 3) (oracle-call oracle "read-counter")))
        (let ((i 0))
          (while (< i 96)
            (let ((value (js-call runtime :invoke "allocate" (js-array)))) (js-call runtime :release value))
            (oracle-call oracle "allocate")
            (setq i (1+ i))))
        (js-call assert :ok (js-call s :same (js-call s :call "read-state") state))
        (js-call assert :strictEqual (oracle-call oracle "read-state") (get oracle :state))
        (js-call result :push (js-call s :read (js-call s :property state "values"))
          (js-call s :read (js-call s :property state "label")))
        (js-call expected :push (js-call (get (get oracle :state) :values) :slice) (get (get oracle :state) :label))
        (js-call assert :deepStrictEqual result expected))))
    (funcall check "dynamic export reassignment" (lambda (s)
      (let* ((old (js-call s :export "current")) (ref-old (get oracle :current))
             (initial (js-call s :value "call-current" (js-call s :box -0) (js-call s :box globalThis.NaN) t))
             (ref-initial (oracle-call oracle "call-current" -0 globalThis.NaN t)) (identity (js-call s :export "identity")))
        (js-call s :call "set-current" identity) (oracle-call oracle "set-current" (get oracle :identity))
        (js-call assert :ok (js-call s :same (js-call s :export "current") identity))
        (js-call assert :ok (not (js-call s :same (js-call s :export "current") old)))
        (js-call assert :strictEqual (get oracle :current) (get oracle :identity))
        (js-call assert :notStrictEqual (get oracle :current) ref-old)
        (js-call assert :deepStrictEqual (js-array initial (js-call s :value "call-current" (js-call s :box -0)))
          (js-array ref-initial (oracle-call oracle "call-current" -0)))))))

  (defun run-properties (check oracle runtime)
    (funcall check "identities and integer order" (lambda (s)
      (js-call assert :deepStrictEqual
        (js-array (js-call s :value "identities") (js-call s :value "exercise"))
        (js-array (oracle-call oracle "identities") (oracle-call oracle "exercise")))))
    (let ((sparse (new globalThis.Array 3)))
      (put sparse 0 1) (put sparse 2 undefined)
      (each (js-array (js-object) sparse "😀" false 1 (globalThis.Symbol "key") nil undefined)
        (lambda (source) (funcall check "keys/hasOwn" (lambda (s)
          (let* ((value (cond ((Array/isArray source) (js-call s :array source))
                              ((= (value-type source) "symbol") (js-call s :keep (js-call runtime :fromHostValue source)))
                              ((and (not (eq source nil)) (= (value-type source) "object")) (js-call s :object source))
                              (t (js-call s :box source))))
                 (result (js-array)) (expected (js-array)))
            (each (js-array "keys" "direct-keys") (lambda (name)
              (js-call result :push (property-outcome (lambda () (js-call s :value name value)) t))
              (js-call expected :push (property-outcome (lambda () (oracle-call oracle name source)) false))))
            (each (js-array "0" "1" "length" "missing" "__proto__") (lambda (name)
              (let ((actual-pair (js-array)) (expected-pair (js-array)))
                (each (js-array "own" "direct-own") (lambda (method)
                  (js-call actual-pair :push (property-outcome
                    (lambda () (js-call s :value method value (js-call s :box name))) t))
                  (js-call expected-pair :push (property-outcome (lambda () (oracle-call oracle method source name)) false))))
                (js-call result :push actual-pair) (js-call expected :push expected-pair))))
            (js-call assert :deepStrictEqual result expected)))))))
    (each (js-array "object" "array" "map" "set" "iterator") (lambda (kind)
      (funcall check "assign own properties" (lambda (s)
        (let* ((reference (cond ((= kind "object") (js-object :2 "two" :1 "one" :z 3))
                                ((= kind "array") (let ((array (new globalThis.Array 3))) (put array 0 1) (put array 2 undefined) array))
                                (t (oracle-call oracle kind))))
               (source (cond ((= kind "object") (js-call s :object reference))
                             ((= kind "array") (js-call s :array reference))
                             (t (js-call s :call kind))))
               (target (js-call s :object (js-object :first 0))) (ref-target (js-object :first 0)))
          ;; The original fixture constructors return empty source collections.
          ;; Compare with those same independent oracle exports; raw tableSet
          ;; and tableAdd operate on ABI tables, not source Map/Set values.
          (put reference :tag 7)
          ;; The raw objectSet ABI owns ordinary object storage only. Map,
          ;; Set, arrays and iterators acquire ordinary own properties through
          ;; the original fixture's portable Object.assign operation.
          (js-call s :call "assign" source (js-call s :object (js-object :tag 7)))
          (js-call assert :ok (js-call s :same
            (js-call s :call "assign" target nil source undefined (js-call s :box "😀")) target))
          (js-call assert :strictEqual (oracle-call oracle "assign" ref-target nil reference undefined "😀") ref-target)
          (js-call assert :deepStrictEqual
            (js-array (js-call s :value "keys" target) (js-call s :value "member" target (js-call s :box "tag"))
              (js-call s :value "member" target (js-call s :box "0")) (js-call s :value "member" target (js-call s :box "1"))
              (js-call s :value "member" target (js-call s :box "first")))
            (js-array (oracle-call oracle "keys" ref-target) (get ref-target :tag) (aref ref-target 0)
              (aref ref-target 1) (oracle-call oracle "member" ref-target "first"))))))))
    (funcall check "frozen target" (lambda (s)
      (let* ((target (js-call s :object (js-object :x 1)))
             (view (js-call runtime :toHostValue target)) (source (js-call s :object (js-object :x 2))))
        (Object/freeze view)
        (js-call assert :deepStrictEqual (property-outcome (lambda () (js-call s :value "assign" target source)) t)
          (property-outcome (lambda () (oracle-call oracle "assign" (Object/freeze (js-object :x 1)) (js-object :x 2))) false)))))
    (funcall check "own proto assignment" (lambda (s)
      (let* ((parent (js-call s :object (js-object :inherited 7)))
             (fields (Object/create nil))
             (unused (Object/defineProperty fields "__proto__"
               (js-object :value parent :enumerable t :configurable t :writable t)))
             (source (js-call s :keep (js-call runtime :sourceObject fields)))
             (target (js-call s :object (js-object))) (ref-source (Object/create nil)) (ref-target (js-object)))
        (Object/setPrototypeOf (js-call runtime :toHostValue source) nil)
        (put ref-source "__proto__" (js-object :inherited 7))
        (js-call s :call "assign" target source) (oracle-call oracle "assign" ref-target ref-source)
        (js-call assert :deepStrictEqual
          (js-array (js-call s :value "member" target (js-call s :box "inherited"))
            (js-call s :value "own" target (js-call s :box "__proto__")))
          (js-array (get (Object/getPrototypeOf ref-target) :inherited) (Object/hasOwn ref-target "__proto__")))))))

  (defun runOriginalRawSpecialFixtureHost (configuration)
    (let* ((family (get configuration :family)) (runtime (get configuration :runtime))
           (oracle (get configuration :oracle)) (observations 0) (groups (Object/create nil))
           (check (lambda (label action)
             (let ((scope (raw-scope runtime family)) (failed false))
               (try (progn (funcall action scope) (setq observations (1+ observations))
                 (put groups label (1+ (get groups label 0))))
                 (catch error
                   (setq failed t)
                   (when (and (not (nullish? error))
                     (or (= (value-type error) "object") (= (value-type error) "function")))
                     (try
                       (when (and (Object/isExtensible error) (not (Object/hasOwn error "originalRawFixture")))
                         (Object/defineProperty error "originalRawFixture" (js-object :configurable t
                           :value (Object/freeze (js-object :family family :label label :completedObservations observations)))))
                       (catch ignored nil)))
                   (throw error))
                 (finally
                   (if failed (try (js-call scope :close) (catch ignored nil)) (js-call scope :close))))))))
      (cond ((js-call (js-array "persistent-vector-auto-1" "persistent-vector-auto-65536") :includes family)
              (run-vector check oracle family))
            ((= family "symbols") (run-symbols check oracle))
            ((= family "regexp") (run-regexp check oracle))
            ((= family "module-bindings") (run-module-bindings check oracle runtime))
            ((= family "object-properties") (run-properties check oracle runtime))
            (t (throw (new globalThis.TypeError (str "unsupported raw special fixture: " family)))))
      (js-object :observations observations :groups groups)))
  (export runOriginalRawSpecialFixtureHost)
)
