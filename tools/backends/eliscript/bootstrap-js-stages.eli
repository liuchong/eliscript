(module tools.backends.bootstrap-js-stages
  (import "node:fs/promises" mkdir readFile readdir lstat open symlink realpath)
  (import "node:path" resolve dirname relative isAbsolute sep)
  (import "node:crypto" createHash)
  (import "node:util" isDeepStrictEqual)
  (import "../build.mjs" root)
  (import "../compiler-build.mjs" loadCompilerSources buildIndependentCompiler
    independentCompilerProductIdentity writeCompilerMetadata)
  (import "../compiler-metadata.mjs" readCompilerMetadata)
  (import "../compiler-bootstrap.mjs" compilerSourceIdentity assertCompilerArtifactSources
    archiveCompilerSources openCompilerArtifact compilerFailure)

  (defun fail (message) (throw (new globalThis.Error message)))
  (defun plain (value)
    (and (not (nullish? value)) (= (value-type value) "object") (not (Array/isArray value))))
  (defun same (left right message)
    (unless (isDeepStrictEqual left right) (fail message)))
  (defun ordered (records)
    (js-call (Array/from records) :sort (lambda (left right)
      (cond ((< (get left :path) (get right :path)) -1)
            ((> (get left :path) (get right :path)) 1) (t 0)))))
  (defun portable (base path)
    (js-call (js-call (relative base path) :split sep) :join "/"))
  (defun safe-path (path)
    (unless (and (= (value-type path) "string") (> (js-length path) 0)
                 (not (isAbsolute path)) (not (js-call path :includes "\\"))
                 (not (js-call (js-call path :split "/") :some
                   (lambda (part) (or (= part "") (= part ".") (= part ".."))))))
      (fail "bootstrap product contains an invalid relative path")) path)
  (defun stopped (signal)
    (when (and (not (nullish? signal)) (get signal :aborted)) (throw (get signal :reason))))
  (defun observe (observer stage phase &optional detail)
    (when (= (value-type observer) "function")
      (try
        (let ((event (js-object :stage stage :host "javascript" :target "javascript" :phase phase)))
          (unless (nullish? detail)
            (js-call (js-array "count" "moduleCount" "fileCount" "byteLength" "id") :forEach
              (lambda (key)
                (let ((value (get detail key)))
                  (when (or (= (value-type value) "string") (= (value-type value) "number"))
                    (put event key value))))))
          (funcall observer (Object/freeze event)))
        (catch ignored nil))))

  (defasync artifact (metadata-path)
    (unless (= (value-type metadata-path) "string")
      (throw (new globalThis.TypeError "compiler metadata path is required")))
    (let* ((path (resolve metadata-path)) (record (await (readCompilerMetadata path))))
      (unless (plain record) (fail "compiler artifact metadata must be an object"))
      (put record :directory (dirname path)) (put record :metadataPath path)
      (unless (and (= (get record :host) "javascript") (= (get record :target) "javascript"))
        (fail "JavaScript bootstrap requires a JavaScript compiler artifact"))
      record))

  (defasync regular-file (base path)
    (safe-path path)
    (let ((parts (js-call path :split "/")) (current base) (index 0))
      (while (< index (js-length parts))
        (setq current (resolve current (aref parts index)))
        (let ((stat (await (lstat current))))
          (unless (if (= index (1- (js-length parts))) (js-call stat :isFile) (js-call stat :isDirectory))
            (fail (+ "bootstrap product contains a nonregular entry: " path))))
        (setq index (1+ index))))
    (resolve base path))

  (defasync file-digest (path)
    (let ((file (await (open path "r"))) (hash (createHash "sha256"))
          (buffer (new globalThis.Uint8Array 65536)) (bytes 0) (failed false) (done false))
      (try
        (while (not done)
          (let ((count (get (await (js-call file :read buffer 0 (js-length buffer) nil)) :bytesRead)))
            (if (= count 0) (setq done t)
              (progn (js-call hash :update (js-call buffer :subarray 0 count)) (setq bytes (+ bytes count))))))
        (js-object :bytes bytes :sha256 (js-call hash :digest "hex"))
        (catch error (setq failed t) (throw error))
        (finally (try (await (js-call file :close)) (catch error (unless failed (throw error))))))))

  (defasync product-paths (directory prefix)
    (let ((entries (await (readdir (resolve directory prefix) (js-object :withFileTypes t))))
          (paths (js-array)) (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (name (get entry :name))
               (path (if (= prefix "") name (+ prefix "/" name))))
          ;; These two names are control receipts defined before comparison.
          ;; No executable, map, macro, source asset or IR is excluded.
          (unless (or (= path "compiler-artifact.json") (= path "ir/runtime-checkpoint.json"))
            (cond
              ((js-call entry :isDirectory)
               (setq paths (js-call paths :concat (await (product-paths directory path)))))
              ((js-call entry :isFile) (js-call paths :push path))
              (t (fail (+ "bootstrap product contains a nonregular entry: " path))))))
        (setq index (1+ index)))
      (js-call paths :sort)))

  (defasync verify-product (value strict-inventory)
    (let* ((identity (get value :artifactIdentity)) (records (get identity :files))
           (seen (new globalThis.Set)) (files (js-array)) (index 0))
      (unless (and (= (get identity :algorithm) "sha256") (Array/isArray records) (> (js-length records) 0))
        (fail "compiler artifact has no complete emitted file identity"))
      (while (< index (js-length records))
        (let* ((record (aref records index)) (path (safe-path (get record :path))))
          (when (js-call seen :has path) (fail "compiler artifact repeats an emitted file"))
          (js-call seen :add path)
          (let* ((actual (await (file-digest (await (regular-file (get value :directory) path)))))
                 (expected (js-object :bytes (get record :bytes) :sha256 (get record :sha256))))
            (same actual expected (+ "compiler artifact changed after emission: " path))
            (js-call files :push (js-object :path path :bytes (get actual :bytes) :sha256 (get actual :sha256)))))
        (setq index (1+ index)))
      (unless (js-call seen :has (safe-path (get value :path))) (fail "compiler entry is absent from product files"))
      (unless (and (Array/isArray (get value :modules)) (> (js-length (get value :modules)) 0))
        (fail "compiler artifact has no JavaScript module graph"))
      (let ((ids (new globalThis.Set)))
        (js-call (get value :modules) :forEach (lambda (record)
          (when (or (js-call ids :has (get record :id)) (not (js-call seen :has (get record :path))))
            (fail "compiler JavaScript module graph is incomplete or repeated"))
          (js-call ids :add (get record :id))
          (js-call (js-array "sourceMapPath" "macroOriginsPath") :forEach (lambda (key)
            (when (Object/hasOwn record key)
              (unless (js-call seen :has (get record key)) (fail "compiler map or macro origins are undeclared"))))))))
      (when strict-inventory
        (same (await (product-paths (get value :directory) "")) (js-call (Array/from seen) :sort)
          "compiler artifact contains extra or missing product files"))
      (same (independentCompilerProductIdentity (js-object :host "javascript" :files files))
        (get value :productIdentity) "compiler product identity differs from its actual files")
      (ordered files)))

  (defun source-record (item)
    (js-object :id (get item :id) :filename (get item :filename) :sha256 (get item :sha256)))
  (defun source-order (items)
    (js-call (Array/from items) :sort (lambda (left right)
      (cond ((< (get left :id) (get right :id)) -1) ((> (get left :id) (get right :id)) 1) (t 0)))))
  (defun bind-sources (value identity)
    (unless (and (plain identity) (= (get identity :encoding) "utf16le")
                 (= (value-type (get identity :sha256)) "string")
                 (Array/isArray (get identity :modules)) (plain (get identity :runtime)))
      (fail "complete bootstrap source identity is required"))
    (let ((body (js-object)))
      (js-call (Object/keys identity) :forEach (lambda (key)
        (unless (= key "sha256") (put body key (get identity key)))))
      (same (get identity :sha256)
        (js-call (js-call (createHash "sha256") :update (JSON/stringify body) "utf16le") :digest "hex")
        "bootstrap source identity has an invalid digest"))
    (let ((actual (get value :sourceIdentity)))
      (unless (and (= (get actual :algorithm) "sha256") (= (get actual :encoding) "utf16le")
                   (= (get value :entry) (get identity :entry)))
        (fail "compiler artifact has no complete UTF-16 source identity"))
      (same (source-order (get actual :modules))
        (source-order (js-call (get identity :modules) :map source-record)) "compiler source modules differ")
      (same (get actual :runtime) (js-object :filename (get (get identity :runtime) :filename)
        :sha256 (get (get identity :runtime) :sha256)) "compiler runtime source differs")
      (js-call (js-array "literalSources" "hostSources") :forEach (lambda (key)
        (if (Object/hasOwn identity key)
          (same (source-order (get actual key)) (source-order (js-call (get identity key) :map source-record))
            (+ "compiler " key " source inventory differs"))
          (when (Object/hasOwn actual key) (fail "compiler artifact contains undeclared source assets"))))))
    value)

  (defasync exact-bytes (left-path right-path)
    (let ((left (await (open left-path "r"))) (right nil) (failed false)
          (a (new globalThis.Uint8Array 65536)) (b (new globalThis.Uint8Array 65536)) (position 0) (done false))
      (try
        (setq right (await (open right-path "r")))
        (while (not done)
          ;; Explicit positions and bounded filling handle legal short reads
          ;; without manufacturing a difference between identical files.
          (let ((counts (js-array 0 0)) (which 0))
            (while (< which 2)
              (let ((file (if (= which 0) left right)) (buffer (if (= which 0) a b))
                    (count 0) (eof false))
                (while (and (< count (js-length buffer)) (not eof))
                  (let ((read (get (await (js-call file :read buffer count (- (js-length buffer) count) (+ position count))) :bytesRead)))
                    (if (= read 0) (setq eof t) (setq count (+ count read)))))
                (put counts which count))
              (setq which (1+ which)))
            (unless (= (aref counts 0) (aref counts 1)) (fail "JavaScript fixed point has different file lengths"))
            (let ((index 0) (count (aref counts 0)))
              (while (< index count)
                (unless (= (aref a index) (aref b index)) (fail "JavaScript fixed point has different original bytes"))
                (setq index (1+ index)))
              (setq position (+ position count))
              (when (= count 0) (setq done t)))))
        (catch error (setq failed t) (throw error))
        (finally
          (let ((close-failed false) (close-error undefined))
            (try (await (js-call left :close)) (catch error (setq close-failed t close-error error)))
            (when right (try (await (js-call right :close))
              (catch error (unless close-failed (setq close-failed t close-error error)))))
            (when (and close-failed (not failed)) (throw close-error)))))))

  (defasync compareJsFixedPoint (input)
    (unless (plain input) (throw (new globalThis.TypeError "fixed point options are required")))
    (let* ((identity (get input :sourceIdentity))
           (second (await (artifact (get input :stage2)))) (third (await (artifact (get input :stage3))))
           (files nil) (other nil) (index 0))
      (bind-sources second identity) (bind-sources third identity)
      ;; Compiler configuration is a product input even when it happens not
      ;; to alter a particular emitted byte. Control paths are not compared.
      (js-call (js-array "profile" "budget" "memory" "auto" "debugEnabled" "capabilities") :forEach (lambda (key)
        (same (get second key) (get third key) (+ "JavaScript fixed point configuration differs: " key))))
      (setq files (await (verify-product second t)) other (await (verify-product third t)))
      (same files other "JavaScript fixed point has a different complete file inventory")
      (same (get second :productIdentity) (get third :productIdentity) "JavaScript fixed point product identities differ")
      (while (< index (js-length files))
        (let ((path (get (aref files index) :path)))
          (await (exact-bytes (resolve (get second :directory) path) (resolve (get third :directory) path))))
        (setq index (1+ index)))
      (js-object :format "eliscript-js-fixed-point" :version 1 :status "identical" :from 2 :to 3
        :sourceIdentity identity :stage2ProductIdentity (get second :productIdentity)
        :stage3ProductIdentity (get third :productIdentity) :files files)))

  (defasync verify-seed (receipt source-root sources)
    (unless (and (= (get receipt :format) "eliscript-js-stage0") (= (get receipt :version) 1)
                 (= (get receipt :status) "built") (= (get receipt :host) "javascript")
                 (= (get receipt :target) "javascript") (= (get receipt :producer) "emacs-lisp"))
      (fail "stage0 must be an authentic completed Emacs Lisp bootstrap"))
    (same (get receipt :formalSourceIdentity) (compilerSourceIdentity sources) "stage0 formal source identity differs")
    (let* ((records (get receipt :seedSourceIdentity))
           (names (js-call (await (readdir (resolve source-root "compiler"))) :filter
                    (lambda (name) (js-call name :endsWith ".el"))))
           (expected (js-call (js-array "tools/backends/bootstrap.el" "tools/runtime/unicode-case-runtime.el") :concat
                       (js-call (js-call names :sort) :map (lambda (name) (+ "compiler/" name)))))
           (index 0))
      (unless (Array/isArray records) (fail "stage0 has no maintained Emacs source identity"))
      (same (js-call records :map (lambda (record) (get record :path))) expected "stage0 seed source inventory differs")
      (while (< index (js-length records))
        (let* ((record (aref records index)) (actual (await (file-digest
                       (await (regular-file source-root (get record :path)))))))
          (same actual (js-object :bytes (get record :bytes) :sha256 (get record :sha256))
            (+ "stage0 seed source changed: " (get record :path))))
        (setq index (1+ index)))))

  (defasync install-runtime-package (source-root directory)
    (let ((candidate (resolve source-root "node_modules/eliscript")) (package source-root))
      (try (await (lstat (resolve source-root "package.json")))
        (catch error
          (if (= (get error :code) "ENOENT") (setq package (await (realpath candidate))) (throw error))))
      (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
      (let ((link (resolve directory "node_modules/eliscript")))
        (try (await (symlink package link "dir"))
          (catch error
            (unless (= (get error :code) "EEXIST") (throw error))
            (same (await (realpath link)) (await (realpath package)) "bootstrap runtime package resolves to a different source"))))))

  (defasync reuse-completed (path identity seed initial-path sources signal observer)
    (let ((record undefined))
      (try (setq record (await (readCompilerMetadata path)))
        (catch error (unless (= (get error :code) "ENOENT") (throw error))))
      (if (undefined? record) nil
        (let ((base (dirname path)) (stages (get record :stages)) (index 0) (last nil))
          ;; An interrupted/failed invocation remains evidence. It cannot be
          ;; silently changed into a new successful invocation at the same path.
          (unless (and (= (get record :format) "eliscript-js-bootstrap") (= (get record :version) 1)
                       (= (get record :status) "accepted") (Array/isArray stages) (= (js-length stages) 4))
            (fail "bootstrap output already contains an incomplete or failed invocation; preserve it and use a new outputRoot"))
          (same (get record :formalSourceIdentity) identity "completed bootstrap source identity changed")
          (same (get record :seedSourceIdentity) seed "completed bootstrap seed identity changed")
          (same (get record :configuration)
            (js-object :host "javascript" :target "javascript" :profile "full-compiler" :retainIR t :debug t)
            "completed bootstrap configuration changed")
          (same (await (realpath (resolve base (get (aref stages 0) :metadataPath))))
            (await (realpath initial-path)) "completed bootstrap uses a different stage0")
          (while (< index 4)
            (stopped signal)
            (let* ((stage (aref stages index))
                   (value (await (artifact (resolve base (get stage :metadataPath))))))
              (unless (and (= (get stage :stage) index) (= (get stage :host) "javascript")
                           (= (get stage :target) "javascript") (= (get stage :status) "built")
                           (= (get stage :producer) (if (= index 0) "emacs-lisp" (+ "stage" (1- index)))))
                (fail "completed bootstrap stage provenance changed"))
              (same (get stage :inputIdentity) identity "completed bootstrap stage input changed")
              (assertCompilerArtifactSources value sources)
              (await (verify-product value (> index 0)))
              (same (get stage :productIdentity) (get value :productIdentity) "completed bootstrap stage product changed")
              (when (> index 0)
                (unless (and (= (get (get value :provenance) :mode) "session")
                             (= (get (get value :provenance) :producerHost) "javascript"))
                  (fail "completed bootstrap stage has an invalid producer")))
              (setq last value))
            (setq index (1+ index)))
          (unless (and (= (get (get record :fixedPoint) :from) 2) (= (get (get record :fixedPoint) :to) 3)
                       (= (get (get record :fixedPoint) :status) "identical"))
            (fail "completed bootstrap has no stage2-stage3 fixed point"))
          (let* ((actual (await (compareJsFixedPoint (js-object
                   :stage2 (resolve base (get (aref stages 2) :metadataPath))
                   :stage3 (get last :metadataPath) :sourceIdentity identity))))
                 (saved (await (readCompilerMetadata (resolve base (get (get record :fixedPoint) :comparisonPath))))))
            (same actual saved "completed bootstrap fixed-point receipt changed"))
          (observe observer 3 "candidate-reuse-initialize")
          (let ((session (await (openCompilerArtifact last))) (failed false))
            (try
              (unless (= (get (await (js-call session :request (js-object :operation "capabilities")
                                     (js-object :signal signal))) :format) "eliscript-compiler-capabilities")
                (fail "completed stage3 returned invalid capabilities"))
              (catch error (setq failed t) (throw error))
              (finally (try (await (js-call session :close)) (catch error (unless failed (throw error)))))))
          (js-object :manifestPath path :stage3MetadataPath (get last :metadataPath))))))

  (defasync bootstrapJsStages (input)
    (unless (plain input) (throw (new globalThis.TypeError "JavaScript bootstrap options are required")))
    ;; Read only the declared API fields. Neither producer functions, binary
    ;; hosts, skip flags nor arbitrary caller records can authorize a stage.
    (let* ((stage0-path (get input :stage0ManifestPath))
           (source-root (get input :sourceRoot)) (output-root (get input :outputRoot))
           (signal (get input :signal)) (observer (get input :onStage)))
      (unless (and (= (value-type stage0-path) "string") (= (value-type output-root) "string"))
        (throw (new globalThis.TypeError "stage0ManifestPath and outputRoot are required")))
      (unless (or (undefined? observer) (= (value-type observer) "function"))
        (throw (new globalThis.TypeError "bootstrap stage observer must be a function")))
      (when (nullish? source-root) (setq source-root root))
      (setq source-root (resolve source-root) stage0-path (resolve stage0-path) output-root (resolve output-root))
      (stopped signal)
      (observe observer 0 "sources-start")
      (let* ((sources (await (loadCompilerSources (js-object :sourceRoot source-root))))
             (identity (compilerSourceIdentity sources))
             (receipt (await (readCompilerMetadata stage0-path)))
             (initial-path (resolve (dirname stage0-path) (safe-path (get receipt :metadataPath))))
             (initial (await (artifact initial-path)))
             (manifest-path (resolve output-root "bootstrap.json"))
             (record (js-object :format "eliscript-js-bootstrap" :version 1 :status "created"
               :seedSourceIdentity (get receipt :seedSourceIdentity) :formalSourceIdentity identity
               :configuration (js-object :host "javascript" :target "javascript" :profile "full-compiler" :retainIR t :debug t)
               :stages (js-array)
               :fixedPoint (js-object :from 2 :to 3 :status "pending" :comparisonPath nil)
               :finalAcceptance (js-object :status "pending" :targets (js-array "javascript" "wasm" "native") :reportPath nil)))
             (previous initial) (previous-path initial-path) (index 1) (active nil)
             (current nil) (failed false) (primary undefined) (reused nil))
        (await (verify-seed receipt source-root sources))
        (assertCompilerArtifactSources initial sources)
        (unless (= (get (get initial :provenance) :mode) "emacs-lisp") (fail "stage0 compiler provenance differs"))
        (await (verify-product initial false))
        (same (get receipt :productIdentity) (get initial :productIdentity) "stage0 product identity differs")
        (setq reused (await (reuse-completed manifest-path identity (get receipt :seedSourceIdentity)
          initial-path sources signal observer)))
        (if reused reused
        (progn
        ;; All three stages receive this one owned immutable source snapshot.
        (js-call (get sources :modules) :forEach Object/freeze)
        (js-call (get sources :literalSources) :forEach Object/freeze)
        (Object/freeze (get sources :modules)) (Object/freeze (get sources :literalSources))
        (Object/freeze (get sources :runtime)) (Object/freeze sources)
        (await (mkdir output-root (js-object :recursive t)))
        (await (install-runtime-package source-root output-root))
        (await (archiveCompilerSources sources (resolve output-root "sources")))
        (js-call (get record :stages) :push (js-object :stage 0 :host "javascript" :target "javascript"
          :producer "emacs-lisp" :status "built" :metadataPath (portable output-root initial-path)
          :inputIdentity identity :productIdentity (get initial :productIdentity)))
        (while (<= index 3)
          (js-call (get record :stages) :push (js-object :stage index :host "javascript" :target "javascript"
            :producer (+ "stage" (1- index)) :status "pending" :metadataPath nil
            :inputIdentity identity :productIdentity nil))
          (setq index (1+ index)))
        (setq index 1)
        (await (writeCompilerMetadata manifest-path record))
        (try
          (put record :status "building")
          (while (<= index 3)
            (stopped signal)
            (setq current (aref (get record :stages) index))
            (put current :status "building")
            (await (writeCompilerMetadata manifest-path record))
            (observe observer index "producer-open")
            (setq active (await (openCompilerArtifact previous)))
            (let ((stage-failed false) (stage-error undefined) (next nil))
              (try
                (same (get active :host) "javascript" "bootstrap producer changed its host")
                (stopped signal)
                (observe observer index "capabilities-start")
                (unless (= (get (await (js-call active :request (js-object :operation "capabilities")
                                       (js-object :signal signal))) :format) "eliscript-compiler-capabilities")
                  (fail "bootstrap producer returned invalid capabilities"))
                (observe observer index "capabilities-complete")
                (setq next (await (buildIndependentCompiler
                  (js-object :host "javascript" :session active :sourceRoot source-root :sources sources
                    :outputRoot (resolve output-root (+ "stage" index)) :profile "full-compiler"
                    :retainIR t :debug t :signal signal
                    :onPhase (lambda (phase detail) (observe observer index phase detail))))))
                (assertCompilerArtifactSources next sources)
                (unless (and (= (get (get next :provenance) :mode) "session")
                             (= (get (get next :provenance) :producerHost) "javascript"))
                  (fail "bootstrap successor was not compiled by the active JavaScript producer"))
                (same (get (get next :provenance) :compiledModuleIds)
                  (js-call (get sources :modules) :map (lambda (item) (get item :id))) "bootstrap omitted formal source modules")
                ;; Persistence returns absolute paths; read the saved metadata
                ;; back to authenticate its actual declared product boundary.
                (setq next (await (artifact (get next :metadataPath))))
                (await (verify-product next t))
                (put current :metadataPath (portable output-root (get next :metadataPath)))
                (put current :productIdentity (get next :productIdentity))
                (catch error (setq stage-failed t stage-error error))
                (finally
                  (observe observer index "producer-close-start")
                  (try (await (js-call active :close))
                    (catch error
                      (put current :closeError (compilerFailure error))
                      (unless stage-failed (setq stage-failed t stage-error error))))
                  (setq active nil)
                  (observe observer index "producer-close-complete")))
              (when stage-failed (throw stage-error))
              (put current :status "built")
              (setq previous next previous-path (get next :metadataPath))
              (await (writeCompilerMetadata manifest-path record))
              (observe observer index "stage-complete")
              (setq index (1+ index))))
          ;; Stage3 must itself initialize successfully before it can become a
          ;; release candidate. Its three output targets are a separate gate.
          (stopped signal)
          (observe observer 3 "candidate-initialize")
          (setq active (await (openCompilerArtifact previous)))
          (let ((initialization-failed false) (initialization-error undefined))
            (try
              (unless (= (get (await (js-call active :request (js-object :operation "capabilities")
                                     (js-object :signal signal))) :format) "eliscript-compiler-capabilities")
                (fail "stage3 returned invalid capabilities"))
              (catch error (setq initialization-failed t initialization-error error))
              (finally
                (try (await (js-call active :close))
                  (catch error
                    (put current :closeError (compilerFailure error))
                    (unless initialization-failed (setq initialization-failed t initialization-error error))))
                (setq active nil)))
            (when initialization-failed (throw initialization-error)))
          (observe observer 3 "fixed-point-start")
          (let* ((second (aref (get record :stages) 2))
                 (comparison (await (compareJsFixedPoint (js-object
                   :stage2 (resolve output-root (get second :metadataPath)) :stage3 previous-path :sourceIdentity identity))))
                 (path (resolve output-root "fixed-point.json")))
            (await (writeCompilerMetadata path comparison))
            (put record :fixedPoint (js-object :from 2 :to 3 :status "identical" :comparisonPath (portable output-root path))))
          (put record :status "accepted")
          (await (writeCompilerMetadata manifest-path record))
          (observe observer 3 "fixed-point-complete")
          (js-object :manifestPath manifest-path :stage3MetadataPath previous-path)
          (catch error
            (setq failed t primary error)
            (let ((cancelled (and (not (nullish? signal)) (get signal :aborted))))
              (put record :status (if cancelled "cancelled" "failed"))
              (when current (put current :status (if cancelled "cancelled" "failed"))
                (put current :error (compilerFailure error)))
              (put record :error (compilerFailure error))
              (when (> index 3) (put (get record :fixedPoint) :status "failed")))
            (try (await (writeCompilerMetadata manifest-path record)) (catch ignored nil))
            (throw error))
          (finally
            (when active
              (try (await (js-call active :close))
                (catch error (unless failed (throw error))))
              (setq active nil))
            (setq previous nil sources nil))))))))

  (export bootstrapJsStages compareJsFixedPoint))
