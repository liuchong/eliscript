(module tools.backends.compiler-matrix-resume
  (import "node:fs/promises" readFile readdir open)
  (import "node:crypto" createHash)
  (import "node:path" resolve dirname join relative isAbsolute)
  (import "node:util" isDeepStrictEqual)
  (import "./compiler-bootstrap.mjs" compilerDigest)
  (import "./compiler-build.mjs" compilerMetadataDigest)
  (import "./compiler-session.mjs" encodeCompilerIR)
  (import "./compiler-metadata.mjs" readCompilerMetadata)
  (import "./compiler-corpus-source-archive.mjs" readArchivedCompilerCorpusSources)

  (defun require-same (actual expected label)
    (unless (isDeepStrictEqual actual expected)
      (throw (new globalThis.Error (str "matrix continuation changed " label)))))
  (defun owned-path (directory path)
    (let* ((result (resolve directory path)) (suffix (relative directory result)))
      (when (or (= suffix "..") (js-call suffix :startsWith "../") (isAbsolute suffix))
        (throw (new globalThis.Error "matrix continuation asset escaped its original record"))) result))
  (defasync stream-digest (path metadata)
    (let ((file (await (open path "r"))) (failed false))
      (try
        (let* ((before (await (js-call file :stat))) (size (get before :size))
               (length (- size (if metadata 1 0))) (position 0)
               (buffer (new globalThis.Uint8Array 1048576)) (hash (createHash "sha256")))
          (unless (and (Number/isSafeInteger length) (>= length 0))
            (throw (new globalThis.Error "invalid archived product size")))
          (while (< position length)
            (let* ((limit (Math/min (js-length buffer) (- length position)))
                   (count (get (await (js-call file :read buffer 0 limit position)) :bytesRead)))
              (unless (and (Number/isInteger count) (> count 0) (<= count limit))
                (throw (new globalThis.Error "archived product read did not advance")))
              (js-call hash :update (js-call buffer :subarray 0 count))
              (setq position (+ position count))))
          ;; writeCompilerMetadata writes the exact chunks used by
          ;; compilerMetadataDigest, followed by one LF. Hash those original
          ;; bytes directly; parsing and serializing every large typed graph
          ;; again is unnecessary and accepts fewer byte-level distinctions.
          (when metadata
            (unless (and (= (get (await (js-call file :read buffer 0 1 position)) :bytesRead) 1)
                         (= (aref buffer 0) 10))
              (throw (new globalThis.Error "archived metadata terminator differs"))))
          (let ((after (await (js-call file :stat))))
            (require-same (get after :size) size "archived product size")
            (require-same (get after :mtimeMs) (get before :mtimeMs) "archived product modification time"))
          (js-call hash :digest "hex"))
        (catch error (setq failed t) (throw error))
        (finally (try (await (js-call file :close))
          (catch error (unless failed (throw error))))))))
  (defasync file-hash (path expected)
    (require-same (await (stream-digest path false)) expected "archived product bytes"))
  (defasync metadata-hash (path expected)
    (require-same (await (stream-digest path t)) expected "archived product metadata"))
  (defasync verify-product (directory outcome expected-target)
    (when (get outcome :productIdentitySha256)
      (let* ((product (await (readCompilerMetadata (join directory "product" "product.json"))))
             (target (get product :target)))
        (require-same (get product :identitySha256) (get outcome :productIdentitySha256) "product envelope")
        (require-same target expected-target "product output target")
        (let ((identity (if (= target "javascript")
          (js-object :target target :entry (get product :entry)
            :modules (js-call (js-call (get product :modules) :map (lambda (item)
              (js-object :id (get item :id) :sha256 (get item :sha256) :sourceMapSha256 (get item :sourceMapSha256)))) :sort
              (lambda (left right) (if (< (get left :id) (get right :id)) -1 (if (> (get left :id) (get right :id)) 1 0)))))
          (js-object :target target :abi (get product :abi) :sha256 (get product :sha256)
            :descriptorSha256 (get product :descriptorSha256) :typedSha256 (get product :typedSha256)
            :debugSha256 (get product :debugSha256) :nativeTarget (get product :nativeTarget) :nativeFormat (get product :nativeFormat)))))
          (require-same (compilerDigest (JSON/stringify identity)) (get outcome :productIdentitySha256) "recomputed product identity"))
        (if (= target "javascript")
          (let ((modules (get product :modules)) (index 0))
            (while (< index (js-length modules))
              (let ((item (aref modules index)))
                (await (file-hash (owned-path directory (get item :path)) (get item :sha256)))
                (when (get item :sourceMapPath)
                  (await (file-hash (owned-path directory (get item :sourceMapPath)) (get item :sourceMapSha256)))))
              (setq index (1+ index))))
          (await (file-hash (owned-path directory (get product :path)) (get product :sha256))))
        (let ((index 0) (fields (js-array "descriptor" "typed" "debug")))
          (while (< index (js-length fields))
            (let* ((field (aref fields index)) (hash (get product (str field "Sha256"))))
              (when hash (await (metadata-hash (join directory "product" (str field ".json")) hash))))
            (setq index (1+ index)))))))
  (defasync loadCompilerMatrixResume (path expected &rest ancestry)
    (if (undefined? path) undefined
      (let* ((bytes (await (readFile path))) (old (await (readCompilerMetadata path)))
             (cells (get old :cells)) (records (get expected :records))
             (rows (js-array)) (selection (get expected :selection))
             (trail (if (> (js-length ancestry) 0) (aref ancestry 0) (js-array)))
             (absolute (resolve path)) (inherited undefined))
        (when (or (>= (js-length trail) 32) (js-call trail :includes absolute))
          (throw (new globalThis.Error "matrix continuation ancestry is cyclic or too deep")))
        (setq trail (js-call trail :concat (js-array absolute)))
        (require-same (get old :format) "eliscript-independent-compiler-matrix-cell" "manifest format")
        (require-same (get old :version) 1 "manifest version")
        (require-same (get old :acceptanceScope) "javascript-stage3-output-targets" "acceptance scope")
        (require-same (get old :host) "javascript" "producer host")
        (require-same (get old :target) (get expected :target) "output target")
        (require-same (get old :sourceIdentity) (get expected :sourceIdentity) "formal source identity")
        (require-same (get old :corpusIdentity) (get expected :corpusIdentity) "complete original corpus")
        ;; Persisted evidence uses the metadata transport: optional undefined
        ;; properties are omitted. Compare its complete canonical bytes, not
        ;; the presence of in-memory properties that JSON cannot preserve.
        (require-same (compilerMetadataDigest (get old :corpusSelection))
          (compilerMetadataDigest selection) "original selection and resource deferrals")
        (require-same (get old :producerIdentity) (get expected :producerIdentity) "actual compiler product")
        (unless (and (Array/isArray cells) (= (js-length cells) 1) (Array/isArray (get (aref cells 0) :records)))
          (throw (new globalThis.Error "matrix continuation requires one actual original cell")))
        (let* ((cell (aref cells 0)) (previous (get cell :records)) (index 0) (finished false))
          (when (get old :resume)
            (let* ((proof (get old :resume)) (parent (get proof :manifestPath)))
              (require-same (compilerDigest (await (readFile parent)))
                (get proof :manifestSha256) "retained manifest bytes")
              (setq inherited (await (loadCompilerMatrixResume parent expected trail)))
              (require-same (js-length (get inherited :records))
                (get proof :retainedRecordCount) "retained prefix length")))
          (require-same (get cell :compilerIdentity) (get expected :producerIdentity) "cell compiler identity")
          (require-same (get cell :runtimeSourceSha256) (get (get (get expected :sourceIdentity) :runtime) :sha256) "cell runtime source")
          (require-same (get cell :literalSourceIdentity) (get (get expected :sourceIdentity) :literalSources) "cell literal sources")
          (when (> (js-length previous) (js-length records))
            (throw (new globalThis.Error "matrix continuation has extra records")))
          (when (and inherited (< (js-length previous) (js-length (get inherited :records))))
            (throw (new globalThis.Error "matrix continuation lost retained results")))
          (while (< index (js-length previous))
            (let* ((row (aref previous index)) (record (aref records index))
                   (verification (get row :verification)) (id (get record :id))
                   ;; A finished selected execution may lack an independent
                   ;; Seed result. Retain that failure without retrying it;
                   ;; compiling/produced rows are still an unfinished gap.
                   (oracle-unverified (and (= verification "unverified")
                     (= (get row :status) "executed")
                     (= (get row :functionalVerification) "unverified")
                     (= (get row :verificationReason) "original complete program Seed oracle did not finish"))))
              (require-same (get row :id) id "original record order")
              (if (not (or oracle-unverified
                        (js-call (js-array "equivalent" "different" "cancelled" "deferred") :includes verification)))
                (setq finished t)
                (progn
                  (when finished (throw (new globalThis.Error "matrix continuation contains a completed record after a gap")))
                  (if (and inherited (< index (js-length (get inherited :records))))
                    (require-same row (aref (get inherited :records) index) "retained measured result")
                  (if (= verification "cancelled")
                    (let ((entry (js-call (get selection :cancelled) :find (lambda (item) (= (get item :id) id)))))
                      (unless entry (throw (new globalThis.Error "matrix continuation cancelled a required record")))
                      (require-same (get row :reason) (get entry :reason) "cancellation reason"))
                    (let* ((directory (owned-path (dirname path) (get row :directory)))
                           (archived (await (readArchivedCompilerCorpusSources (join directory "sources")
                             (js-object :expectedIdentity (get (get row :sourceIdentity) :sha256))))))
                      (require-same (await (readCompilerMetadata (join directory "sources" "source-identity.json")))
                        (get row :sourceIdentity) "archived source identity envelope")
                      (require-same (encodeCompilerIR (js-object :value archived))
                        (encodeCompilerIR (js-object :value record)) "exact archived input")
                      (if (= verification "deferred")
                        (progn
                          (unless (js-call (get selection :resourceDeferred) :some (lambda (item) (= (get item :id) id)))
                            (throw (new globalThis.Error "matrix continuation deferred a required record")))
                          (require-same (await (readCompilerMetadata (join directory "resource-deferred.json"))) row "deferred receipt"))
                        (progn
                          (require-same (await (readCompilerMetadata (join directory "outcome.json"))) row "measured outcome")
                          (when (= verification "equivalent")
                            (require-same (get (await (readCompilerMetadata (join directory "comparison.json"))) :status)
                              "equivalent" "independent comparison"))
                          (when oracle-unverified
                            (let ((comparison (await (readCompilerMetadata (join directory "comparison.json")))))
                              (require-same (get comparison :status) "unverified" "unfinished independent Seed comparison")
                              (require-same (get comparison :reason) (get row :verificationReason) "unfinished independent Seed reason")
                              (require-same (get (get comparison :failure) :kind) "diagnostic" "independent Seed failure evidence")))
                          (await (verify-product directory row (get expected :target)))
                          (when (get row :stageIdentitySha256)
                            (let ((response (await (readCompilerMetadata (join directory "stage-response.json")))))
                              (require-same (compilerDigest (JSON/stringify (js-object :stage (get response :stage)
                                :filename (get response :filename) :data (get response :data))))
                                (get row :stageIdentitySha256) "stage response"))))))))
                  ;; Retain genuine failures too: continuation collects missing
                  ;; results, it never retries or relabels an earlier failure.
                  (js-call rows :push row))))
            (setq index (1+ index)))
          (js-object :records rows :manifestPath (resolve path) :manifestSha256 (compilerDigest bytes)
            :resourceOutcomes (js-call (or (get old :resourceOutcomes) (js-array)) :filter
              (lambda (receipt) (js-call rows :some (lambda (row) (= (get row :id) (get receipt :id))))))
            :resourceAcceptance (get old :resourceAcceptance)
            :previousStatus (get cell :status) :previousCleanupStatus (get cell :cleanupStatus)
            :previousVerification (get old :verification))))))
  (defasync findCompilerMatrixResumeManifests (directory expected)
    (if (undefined? directory) (js-object)
      (let* ((base (resolve directory)) (seen (new globalThis.Set)) (sizes (js-object))
             (result (js-object)) (targets (js-array "javascript" "wasm" "native")))
        (while base
        (when (or (>= (get seen :size) 32) (js-call seen :has base))
          (throw (new globalThis.Error "target continuation ancestry is cyclic or too deep")))
        (js-call seen :add base)
        (let ((summary (await (readCompilerMetadata (join base "stage3-targets.json")))) (index 0))
        (require-same (get summary :format) "eliscript-stage3-targets" "target summary format")
        (require-same (get summary :version) 1 "target summary version")
        (require-same (get summary :sourceIdentity) (get expected :sourceIdentity) "target summary source")
        (require-same (get summary :producerIdentity) (get expected :producerIdentity) "target summary producer")
        (require-same (get summary :corpusRecordsSha256) (get expected :corpusRecordsSha256) "target summary corpus")
        (require-same (get summary :functionalRuntimeProfile) (get expected :functionalRuntimeProfile) "functional profile")
        (require-same (compilerDigest (await (readFile (owned-path base (get summary :corpusRecordsPath)))))
          (get expected :corpusRecordsSha256) "frozen original records")
        (while (< index (js-length targets))
          (let* ((target (aref targets index)) (folder (join base target)) (entries undefined))
            (try (setq entries (await (readdir folder (js-object :withFileTypes t))))
              (catch error (unless (= (get error :code) "ENOENT") (throw error))))
            (when entries
              (let ((matches (js-call entries :filter (lambda (entry)
                (and (js-call entry :isDirectory) (js-call (get entry :name) :startsWith (str "compiler-matrix-cell-javascript-" target "-")))))))
                (when (> (js-length matches) 1) (throw (new globalThis.Error "matrix continuation requires an unambiguous previous cell")))
                (when (= (js-length matches) 1)
                  (let* ((path (join folder (get (aref matches 0) :name) "matrix.json"))
                         (manifest (await (readCompilerMetadata path)))
                         (cells (get manifest :cells))
                         (count (if (and (Array/isArray cells) (= (js-length cells) 1)
                                        (Array/isArray (get (aref cells 0) :records)))
                                  (js-length (get (aref cells 0) :records)) -1)))
                    ;; A preparation failure has no measured prefix. Reuse
                    ;; the longest existing prefix across authenticated runs;
                    ;; the loader validates every selected receipt and input.
                    (when (> count (get sizes target -1))
                      (put sizes target count) (put result target path)))))))
          (setq index (1+ index)))
        (setq base (when (get summary :resumeFrom) (resolve (get summary :resumeFrom)))))) result)))
  (export loadCompilerMatrixResume findCompilerMatrixResumeManifests))
