(module tools.backends.managed-ir-inventory
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve basename posix)
  (import "node:crypto" createHash)
  (import "../build.mjs" root loadLiteralSources)
  (import "../../../dist/bootstrap/compiler.mjs" compile-ir-string)

  ;; Read current source IR only. This tool neither lowers a managed program
  ;; nor claims that a recorded operation is supported by a backend.
  (defun inventory-error (message) (throw (new globalThis.Error message)))
  (defun inventory-sha (text)
    (js-call (js-call (createHash "sha256") :update text "utf16le") :digest "hex"))
  (defun inventory-source (source filename)
    (unless (= (value-type source) "string")
      (inventory-error (+ "inventory source must be a string: " filename)))
    source)
  (defun inventory-path (path)
    (let ((normalized (js-call posix :normalize path)))
      (when (or (js-call posix :isAbsolute normalized) (= normalized "..")
                (js-call normalized :startsWith "../"))
        (inventory-error (+ "sequence dependency escapes source root: " path)))
      normalized))
  (defun inventory-output-id (path)
    (let ((normalized (inventory-path path)))
      (if (js-call normalized :endsWith ".eli")
        (+ (js-call normalized :slice 0 -4) ".mjs") normalized)))
  (defun inventory-relative (from to)
    (let ((path (js-call posix :relative (js-call posix :dirname from) to)))
      (if (js-call path :startsWith ".") path (+ "./" path))))

  (defun inventory-value (value)
    (let ((type (value-type value)))
      (cond
        ((nil? value) (js-object :encoding "null" :value nil :identity "null"))
        ((undefined? value) (js-object :encoding "undefined" :value nil :identity "undefined"))
        ((= type "number")
          (let ((text (cond ((Object/is value -0) "-0") ((Number/isNaN value) "NaN")
                            ((= value (/ 1 0)) "+Infinity") ((= value (/ -1 0)) "-Infinity")
                            (t (JSON/stringify value)))))
            (js-object :encoding "number" :value text :identity (+ "number:" text))))
        ((= type "boolean")
          (js-object :encoding "boolean" :value value :identity (if value "true" "false")))
        ((or (= type "string") (= type "object"))
          (let* ((text (if (= type "string") value (JSON/stringify value)))
                 (encoding (if (= type "string") "string" "json")))
            (if (<= (js-length text) 256)
              (js-object :encoding encoding :value text :identity (+ encoding ":" text))
              (let ((sha (inventory-sha text)))
                (js-object :encoding (+ encoding "-sha256-utf16le") :sha256 sha
                  :codeUnits (js-length text) :identity (+ encoding ":sha256:" sha))))))
        (t (inventory-error (+ "unexpected non-JSON IR value type: " type))))))

  (defun inventory-add-node (state node file group module-id)
    (let* ((kind (get node :kind)) (value (inventory-value (get node :value)))
           (key (JSON/stringify (js-array kind (get value :identity))))
           (kinds (get state :kinds)) (pairs (get state :pairs))
           (record (js-call pairs :get key)))
      (unless (= (value-type kind) "string") (inventory-error (+ "IR node lacks kind: " file)))
      (js-call kinds :set kind (1+ (if (js-call kinds :has kind) (js-call kinds :get kind) 0)))
      (unless record
        (setq record (js-object :kind kind :valueEncoding (get value :encoding) :count 0
          :arities (new globalThis.Map) :examples (js-array)))
        (if (Object/hasOwn value "sha256")
          (progn (put record :valueSha256 (get value :sha256)) (put record :valueCodeUnits (get value :codeUnits)))
          (put record :value (get value :value)))
        (js-call pairs :set key record))
      (put record :count (1+ (get record :count)))
      (let* ((arity (js-length (get node :children))) (arities (get record :arities)))
        (js-call arities :set arity (1+ (if (js-call arities :has arity) (js-call arities :get arity) 0))))
      (when (< (js-length (get record :examples)) 3)
        (js-call (get record :examples) :push
          (js-object :group group :id module-id :filename file :span (get node :span nil))))))

  (defun inventory-nodes (program)
    (let ((pending (js-call (get program :body) :slice)) (nodes (js-array))
          (seen (new globalThis.WeakSet)))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :pop)))
          (unless (or (nil? node) (js-call seen :has node))
            (js-call seen :add node) (js-call nodes :push node)
            (let ((children (get node :children)) (index 0))
              (while (< index (js-length children))
                (js-call pending :push (aref children index)) (setq index (1+ index)))))))
      nodes))
  (defun inventory-program (state program id filename source group)
    (let ((nodes (inventory-nodes program)) (index 0))
      (while (< index (js-length nodes))
        (inventory-add-node state (aref nodes index) filename group id)
        (setq index (1+ index)))
      (js-call (get state :modules) :push
        (js-object :group group :id id :filename filename :sourceSha256 (inventory-sha source)
          :sourceEncoding "utf16le" :nodeCount (js-length nodes)))))
  (defun inventory-exports (program)
    (let ((pending (js-call (get program :body) :slice)) (names (js-array)))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :shift)))
          (cond ((= (get node :kind) "module-declaration")
                 (Reflect/apply (get pending :unshift) pending (get node :children)))
                ((= (get node :kind) "export-declaration")
                 (js-call (get node :children) :forEach (lambda (child)
                   (js-call names :push (get child :value)))))))) names))

  (defasync inventoryManagedSourceIR ()
    (let* ((sources (await (loadLiteralSources)))
           (state (js-object :kinds (new globalThis.Map) :pairs (new globalThis.Map) :modules (js-array)))
           (canonical (new globalThis.Set)) (source-files (new globalThis.Map))
           (public-sources (js-array)) (project (new globalThis.Map))
           (external-imports (js-array)) (index 0))
      (unless (= (js-length sources) 53) (inventory-error "current literal registry must contain all 53 sources"))
      ;; Compile every exact registry record, including private dependencies.
      (while (< index (js-length sources))
        (let* ((record (aref sources index)) (id (get record :id)) (filename (get record :filename))
               (source (inventory-source (get record :source) filename))
               (program (compile-ir-string source filename)))
          (when (js-call canonical :has id) (inventory-error (+ "duplicate literal id: " id)))
          (js-call canonical :add id) (js-call source-files :set id filename)
          (inventory-program state program id filename source "literal")
          (when (and (or (js-call id :startsWith "runtime/core/") (js-call id :startsWith "runtime/testing/"))
                     (js-call id :endsWith ".mjs"))
            (let ((names (inventory-exports program)))
              (when (= (js-length names) 0) (inventory-error (+ "public literal lacks exports: " id)))
              (js-call public-sources :push
                (js-object :id (+ "public/" id) :filename (+ "sequence-data-public/" id)
                  :source (+ "(import " (JSON/stringify (+ "eliscript/" id)) " "
                    (js-call names :join " ") ")\n(export " (js-call names :join " ") ")\n"))))))
        (setq index (1+ index)))
      ;; Same virtual IDs and physical files as the complete sequence fixture.
      (let ((entries (js-array
        (js-array "sequence-data.mjs" "tests/fixtures/wasm-managed-sequence-data.eli")
        (js-array "tests/fixtures/lazy-sequence.mjs" "tests/fixtures/lazy-sequence.eli")
        (js-array "core-set-usage.mjs" "tests/fixtures/core-set-usage.eli")
        (js-array "sequence.mjs" "stdlib/sequence.eli") (js-array "text.mjs" "stdlib/text.eli")
        (js-array "object.mjs" "stdlib/object.eli") (js-array "data.mjs" "stdlib/data.eli")
        (js-array "sequence-usage.mjs" "tests/fixtures/sequence-usage.eli")
        (js-array "text-usage.mjs" "tests/fixtures/text-usage.eli")
        (js-array "object-usage.mjs" "tests/fixtures/object-usage.eli"))))
        (js-call entries :forEach (lambda (pair) (js-call source-files :set (aref pair 0) (aref pair 1))))
        (letfn ((add (id filename &optional provided-source)
                  (async ()
                    (inventory-path id) (inventory-path filename)
                    (unless (js-call project :has id)
                      ;; Eli supplies nil for an omitted optional argument.
                      ;; Keep empty strings as actual input; only nullish
                      ;; omission selects the same file read as the fixture.
                      (let* ((source (inventory-source
                                     (if (nullish? provided-source)
                                       (await (readFile (resolve root filename) "utf8")) provided-source)
                                     filename))
                             (program (compile-ir-string source filename))
                             (nodes (inventory-nodes program)) (position 0))
                        (js-call project :set id (js-object :filename filename))
                        (while (< position (js-length nodes))
                          (let ((node (aref nodes position)))
                            (when (= (get node :kind) "import-declaration")
                              (let ((specifier (get node :value)))
                                (cond
                                  ((js-call specifier :startsWith ".")
                                    (let ((target (inventory-output-id (js-call posix :join (js-call posix :dirname id) specifier))))
                                      (if (js-call target :startsWith "runtime/")
                                        (progn
                                          (unless (js-call canonical :has target)
                                            (inventory-error (+ "sequence runtime import lacks actual literal declaration: " target)))
                                          (put node :value (+ "eliscript/" target)))
                                        (let* ((physical (if (js-call source-files :has target) (js-call source-files :get target)
                                                           (inventory-path (js-call posix :join (js-call posix :dirname filename) specifier))))
                                               (source-path (if (js-call physical :endsWith ".mjs")
                                                              (+ (js-call physical :slice 0 -4) ".eli") physical)))
                                          (put node :value (inventory-relative id target))
                                          (await (funcall (add target source-path)))))))
                                  ((js-call specifier :startsWith "eliscript/runtime/")
                                    (unless (js-call canonical :has (js-call specifier :slice 10))
                                      (inventory-error (+ "sequence package import lacks actual literal declaration: " specifier))))
                                  (t (js-call external-imports :push
                                       (js-object :id id :filename filename :specifier specifier :span (get node :span nil))))))))
                          (setq position (1+ position)))
                        (inventory-program state program id filename source "sequence-project"))))))
          (setq index 0)
          (while (< index (js-length public-sources))
            (let ((record (aref public-sources index)))
              (await (funcall (add (get record :id) (get record :filename) (get record :source)))))
            (setq index (1+ index)))
          (setq index 0)
          (while (< index (js-length entries))
            (let ((pair (aref entries index))) (await (funcall (add (aref pair 0) (aref pair 1)))))
            (setq index (1+ index)))))
      (let ((kinds (js-array)) (pairs (js-array)))
        (js-call (get state :kinds) :forEach (lambda (count kind) (js-call kinds :push (js-object :kind kind :count count))))
        (js-call (get state :pairs) :forEach (lambda (record key)
          (let ((arities (js-array)))
            (js-call (get record :arities) :forEach (lambda (count arity)
              (js-call arities :push (js-object :arity arity :count count))))
            (put record :arities (js-call arities :sort (lambda (left right) (- (get left :arity) (get right :arity))))))
          (put record :sortKey key) (js-call pairs :push record)))
        (js-call kinds :sort (lambda (left right) (js-call (get left :kind) :localeCompare (get right :kind))))
        (js-call pairs :sort (lambda (left right) (js-call (get left :sortKey) :localeCompare (get right :sortKey))))
        (js-call pairs :forEach (lambda (record) (Reflect/deleteProperty record "sortKey")))
        (js-object :format "eliscript-managed-ir-inventory" :version 1
          :compilerPath (resolve root "dist/bootstrap/compiler.mjs")
          :literalCount (js-length sources) :projectCount (get project :size)
          :traversal "unique-node-per-program/body-and-children"
          :supportVerification "not-performed" :modules (get state :modules)
          :externalImports external-imports :kinds kinds :kindValues pairs))))

  (defasync run-inventory (arguments)
    (unless (or (= (js-length arguments) 0)
                (and (= (js-length arguments) 2) (= (aref arguments 0) "--output")))
      (inventory-error "Usage: managed-ir-inventory [--output FILE]"))
    (let ((text (+ (JSON/stringify (await (inventoryManagedSourceIR)) nil 2) "\n")))
      (if (= (js-length arguments) 2)
        (await (writeFile (resolve (aref arguments 1)) text "utf8"))
        (js-call (get globalThis.process :stdout) :write text))))
  (export inventoryManagedSourceIR)
  (when (and (> (js-length (get globalThis.process :argv)) 1)
             (= (basename (aref (get globalThis.process :argv) 1)) "managed-ir-inventory.mjs"))
    (js-call (run-inventory (js-call (get globalThis.process :argv) :slice 2)) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write (+ (get error :stack (str error)) "\n"))
        (put globalThis.process :exitCode 1)))))
