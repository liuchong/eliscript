(module tools.backends.compiler-corpus-process
  (import "node:child_process" spawn)
  (import "node:fs/promises" mkdir mkdtemp open readFile writeFile rm)
  (import "node:fs" lstatSync realpathSync readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve isAbsolute posix)
  (import "node:buffer" Buffer)
  (import "./compiler-corpus-sorted-observation.mjs" sortedFunctionalDeadline)
  (import "./compiler-corpus-wire-host.mjs" wireFunctionalPartition wireFunctionalDeadline wireCasePolicy)
  ;; The complete context is evidence, and may contain every original source
  ;; and map. Only this authenticated file reference belongs in a child env.
  (defasync writeOriginalCorpusExecutionContext (directory context)
    (let* ((bytes (Buffer/from (JSON/stringify context) "utf8"))
           (parent (resolve directory "original-process")))
      (await (mkdir parent (js-object :recursive t)))
      (let* ((owned (await (mkdtemp (resolve parent "execution-context-"))))
             (path (resolve owned "context.json")))
        (try
          (await (writeFile path bytes (js-object :flag "wx" :mode 384)))
          (JSON/stringify (js-object :format "eliscript-original-execution-context" :version 1
            :path path :bytes (get bytes :length)
            :sha256 (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")))
          (catch error
            ;; Never replace the owning write failure with cleanup failure.
            (try (await (rm owned (js-object :recursive t :force t))) (catch ignored nil))
            (throw error))))))
  (defun readOriginalCorpusExecutionContext (serialized)
    (let ((reference (JSON/parse serialized)))
      ;; Existing in-process adapters may still supply their literal context.
      (if (or (nullish? reference) (/= (value-type reference) "object")
              (not (Object/hasOwn reference "format"))) reference
        (progn
          (unless (and (= (get reference :format) "eliscript-original-execution-context")
                       (= (get reference :version) 1) (= (js-length (Object/keys reference)) 5)
                       (= (value-type (get reference :path)) "string") (isAbsolute (get reference :path))
                       (Number/isSafeInteger (get reference :bytes)) (> (get reference :bytes) 0)
                       (= (value-type (get reference :sha256)) "string")
                       (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (get reference :sha256)))
            (throw (new globalThis.TypeError "invalid original execution context reference")))
          (let* ((path (get reference :path)) (stat (lstatSync path)))
            (unless (and (js-call stat :isFile) (not (js-call stat :isSymbolicLink))
                         (= (realpathSync path) (resolve path)))
              (throw (new globalThis.TypeError "original execution context must retain its canonical regular file")))
            (let* ((bytes (readFileSync path)) (source (js-call bytes :toString "utf8")))
              (unless (and (= (get bytes :length) (get reference :bytes))
                           (= (js-call (js-call (createHash "sha256") :update bytes) :digest "hex") (get reference :sha256))
                           (js-call (Buffer/from source "utf8") :equals bytes))
                (throw (new globalThis.TypeError "original execution context bytes differ from their authenticated reference")))
              (JSON/parse source)))))))
  (defconst process-host-files (js-array "tools/backends/eliscript/compiler-corpus-process.eli"
    "tools/backends/compiler-corpus-process.mjs"
    "tools/backends/eliscript/compiler-corpus-sorted-observation.eli"
    "tools/backends/compiler-corpus-sorted-observation.mjs"
    "tools/backends/eliscript/compiler-corpus-wire-host.eli"
    "tools/backends/compiler-corpus-wire-host.mjs"))
  (defun dependency-invalid ()
    (throw (new globalThis.TypeError "original process host dependency differs from its authenticated source assets")))
  (defun dependency-hash (source)
    (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
  (defun dependency-proofs (dependency)
    (let ((proofs (get dependency :sourceAssets)) (modules (get dependency :modules)))
      (unless (and (Array/isArray proofs) (= (js-length proofs) (js-length process-host-files))
                   (Array/isArray modules) (= (js-length modules) 3)
                   (= (value-type (get dependency :source)) "string")) (dependency-invalid))
      (js-call process-host-files :forEach (lambda (file index)
        (let ((proof (aref proofs index)))
          (unless (and proof (= (get proof :file) file)
                       (Number/isSafeInteger (get proof :bytes)) (> (get proof :bytes) 0)
                       (= (value-type (get proof :sourceSha256)) "string")
                       (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (get proof :sourceSha256)))
            (dependency-invalid)))))
      (js-call modules :forEach (lambda (module index)
        (let* ((generated (aref proofs (1+ (* index 2)))) (source (get module :source)))
          (unless (and (= (get module :filename) (get generated :file))
                       (= (value-type source) "string")
                       (= (get generated :bytes) (Buffer/byteLength source "utf8"))
                       (= (get generated :sourceSha256) (dependency-hash source))
                       (or (/= index 0) (= source (get dependency :source)))) (dependency-invalid)))))
      proofs))
  (defasync readOriginalProcessHostDependency (options)
    (let ((proofs (js-array)) (modules (js-array)) (generated undefined) (index 0))
      (while (< index (js-length process-host-files))
        (let* ((file (aref process-host-files index)) (source (await (js-call options :text file)))
               (identity (await (js-call options :file file)))
               (bytes (if (= (value-type source) "string") (Buffer/from source "utf8") undefined)))
          (unless (and bytes (= (get identity :file) file)
                       (= (get identity :sha256) (dependency-hash bytes))
                       (= (get identity :bytes) (get bytes :length))
                       (= (get identity :encoding) "base64")
                       (= (get identity :content) (js-call bytes :toString "base64"))) (dependency-invalid))
          (js-call proofs :push (js-object :file file :sourceSha256 (get identity :sha256) :bytes (get identity :bytes)))
          (when (= (% index 2) 1)
            (js-call modules :push (js-object :filename file :source source)))
          (when (= index 1) (setq generated source)))
        (setq index (1+ index)))
      (js-object :source generated :modules modules :sourceAssets proofs)))
  (defun dependency-id (record)
    (let ((host (get (get record :execution) :host)))
      (unless (and (= (value-type host) "string") (> (js-length host) 0)
                   (not (isAbsolute host))
                   (not (js-call (new globalThis.RegExp "[\\\\:\\u0000]") :test host))
                   (not (js-call (js-call host :split "/") :some
                     (lambda (part) (or (= part "") (= part ".") (= part "..")))))) (dependency-invalid))
      (js-call posix :join (js-call posix :dirname host) "compiler-corpus-process.mjs")))
  (defun validateOriginalProcessHostDependency (record)
    (let* ((original (or (get record :original) (js-object))) (marker (get original :processHostDependency)))
      (when marker
        (let* ((id (dependency-id record)) (sources (get (get record :request) :hostSources))
               (assets (get original :sourceAssets)) (selected undefined) (count 0))
          (unless (and (= (get marker :version) 1) (= (get marker :id) id)
                       (Array/isArray sources) (Array/isArray assets)) (dependency-invalid))
          (js-call sources :forEach (lambda (source)
            (when (= (get source :id) id) (setq selected source count (1+ count)))))
          (unless (and (= count 1) (= (get selected :filename) (aref process-host-files 1))) (dependency-invalid))
          (let* ((modules (js-call (js-array 1 3 5) :map (lambda (index)
                    (let* ((filename (aref process-host-files index))
                           (module-id (js-call posix :join (js-call posix :dirname id) (js-call posix :basename filename)))
                           (matches (js-call sources :filter (lambda (source) (= (get source :id) module-id)))))
                      (unless (and (= (js-length matches) 1) (= (get (aref matches 0) :filename) filename)) (dependency-invalid))
                      (aref matches 0)))))
                 (proofs (dependency-proofs (js-object :source (get selected :source) :modules modules :sourceAssets (get marker :sourceAssets)))))
            (js-call proofs :forEach (lambda (proof)
              (let ((matches (js-call assets :filter (lambda (asset) (= (get asset :file) (get proof :file))))))
                (unless (and (= (js-length matches) 1)
                             (= (get (aref matches 0) :sourceSha256) (get proof :sourceSha256))
                             (= (get (aref matches 0) :bytes) (get proof :bytes))) (dependency-invalid)))))))))
    record)
  (defun bindOriginalProcessHostDependency (record dependency)
    (validateOriginalProcessHostDependency record)
    (let* ((proofs (dependency-proofs dependency)) (id (dependency-id record))
           (request (Object/assign (js-object) (get record :request)))
           (original (Object/assign (js-object) (get record :original)))
           (sources (js-call (or (get request :hostSources) (js-array)) :slice))
           (assets (js-call (or (get original :sourceAssets) (js-array)) :slice)))
      (js-call (get dependency :modules) :forEach (lambda (module)
        (let* ((filename (get module :filename))
               (module-id (js-call posix :join (js-call posix :dirname id) (js-call posix :basename filename)))
               (matches (js-call sources :filter (lambda (source) (= (get source :id) module-id)))))
          (when (> (js-length matches) 1) (dependency-invalid))
          (if (= (js-length matches) 1)
            (unless (and (= (get (aref matches 0) :filename) filename)
                         (= (get (aref matches 0) :source) (get module :source))) (dependency-invalid))
            (js-call sources :push (js-object :id module-id :filename filename :source (get module :source)))))))
      (js-call proofs :forEach (lambda (proof)
        (let ((found (js-call assets :filter (lambda (asset) (= (get asset :file) (get proof :file))))))
          (when (> (js-length found) 1) (dependency-invalid))
          (if (= (js-length found) 1)
            (let ((existing (aref found 0)))
              (unless (and (= (get existing :sourceSha256) (get proof :sourceSha256))
                           (or (undefined? (get existing :bytes)) (= (get existing :bytes) (get proof :bytes)))) (dependency-invalid))
              (put assets (js-call assets :indexOf existing) (Object/assign (js-object) existing proof)))
            (js-call assets :push (Object/assign (js-object) proof))))))
      (put request :hostSources sources)
      (put original :sourceAssets assets)
      (put original :processHostDependency (js-object :version 1 :id id
        :sourceAssets (js-call proofs :map (lambda (proof) (Object/assign (js-object) proof)))))
      (validateOriginalProcessHostDependency (Object/assign (js-object) record (js-object :request request :original original)))))
  (defun originalCorpusExecutionPolicy (context)
    (let* ((execution (or (get (get context :record) :execution) (js-object)))
           (target (get context :target)) (by-target (get execution :timeoutByTarget))
           (deadline (if (and by-target (not (nullish? (get by-target target))))
                       (get by-target target) (get execution :timeoutMs)))
           (settings (or (get context :options) (js-object)))
           (profile (get settings :functionalRuntimeProfile))
           (measured-deadline (get settings :functionalExecutionDeadlineMs))
           (wire-deadline (when (and (= profile "small")
             (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
             (wireFunctionalPartition (get context :record)))
             (wireFunctionalDeadline (get context :record) target))))
      (unless (or (undefined? profile) (= profile "small"))
        (throw (new globalThis.TypeError "invalid original corpus functional runtime profile")))
      (unless (or (nullish? deadline) (and (Number/isSafeInteger deadline) (> deadline 0)))
        (throw (new globalThis.TypeError "original host deadline must retain its positive integer timeout")))
      (let ((id (get (get context :record) :id)))
        (unless (or (undefined? measured-deadline)
                    (and (= profile "small")
                      (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
                      (or
                        (and (js-call (js-array "original-program:core-stdlib-complete-protocols"
                          "original-program:eliscript-protocol-complete-hosts"
                          "original-program:portable-persistent-set-complete-hosts"
                          "original-program:portable-persistent-map-complete-hosts") :includes id)
                          (= measured-deadline 600000))
                        (and (js-call (js-array "original-program:portable-persistent-list-1"
                          "original-program:portable-persistent-list-0"
                          "original-program:portable-persistent-vector-complete-hosts"
                          "original-program:persistent-tree-walk-complete-hosts") :includes id)
                          (= measured-deadline 360000))
                        (and (js-call (js-array "original-program:portable-numeric-complete-hosts"
                          "original-program:portable-value-semantics-complete-hosts"
                          "original-program:multimethod-complete-hosts") :includes id)
                          (= measured-deadline 720000))
                        (and (js-call (js-array "stable-compatibility:program:stdlib/core/protocol.eli"
                          "original-program:interop-js-complete-hosts") :includes id)
                          (= measured-deadline 1200000))
                        (and (= id "original-program:portable-result-complete-hosts")
                          (= measured-deadline 1500000)))))
          (throw (new globalThis.TypeError "measured functional deadline requires its authenticated complete original program")))
        (let ((policy (js-object :mode (if (= profile "small") "functional" "strict")
          :originalDeadlineMs (if (nullish? deadline) nil deadline)
          ;; Deferring the original performance gate never authorizes an
          ;; unbounded child. Include compilation in the declared budget, allow
          ;; fourfold functional overhead, and retain an executable ceiling.
          :effectiveDeadlineMs (if (= profile "small")
            (if wire-deadline wire-deadline
            (Math/min 1800000 (Math/max 60000 (if (nullish? deadline) 600000 (* deadline 4))
              (if (and (not (undefined? measured-deadline))
                   (if (js-call (js-array "original-program:core-stdlib-complete-protocols"
                         "original-program:eliscript-protocol-complete-hosts"
                         "original-program:portable-persistent-set-complete-hosts"
                         "original-program:portable-persistent-list-1"
                         "original-program:portable-persistent-list-0") :includes id)
                     (js-call (js-array "wasm" "native") :includes target)
                     (= target "native")))
                (cond ((and (= id "original-program:eliscript-protocol-complete-hosts") (= target "native")) 1800000)
                      ((and (js-call (js-array "original-program:portable-persistent-list-1"
                                               "original-program:portable-persistent-list-0") :includes id)
                            (= target "native")) 720000)
                      (t measured-deadline))
                0)
              (if (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
                (or (if (wireFunctionalPartition (get context :record))
                      (wireFunctionalDeadline (get context :record) target)
                      (sortedFunctionalDeadline (get context :record) target)) 0) 0))))
            (if (nullish? deadline) nil deadline))
          :performanceAcceptance (if (= profile "small") "deferred" "not-evaluated"))))
          (let ((cases (wireCasePolicy (get context :record) target)))
            (when cases (put policy :wireCase cases))) policy))))
  (defun evidence-value (value)
    (cond ((undefined? value) (js-object :$eliscriptObservation "undefined"))
      ((and value (js-call globalThis.Error globalThis.Symbol.hasInstance value))
       (let ((record (js-object :name (get value :name) :message (get value :message))))
         (js-call (js-array "code" "stack" "timeoutMs") :forEach
           (lambda (key) (unless (undefined? (get value key)) (put record key (get value key))))) record))
      (t value)))
  (defun process-error (code message)
    (let ((error (new globalThis.Error message))) (put error :code code) error))
  (defun wire-case-monitor (policy services fail)
    ;; The parent owns this timer, so a synchronous target cannot keep itself
    ;; alive merely by blocking its own event loop. Original stderr is spooled
    ;; separately and never truncated by this bounded protocol decoder.
    (let* ((rows (js-array)) (next (get policy :start)) (active undefined)
           (timer undefined) (pending (Buffer/alloc 0)) (discard false)
           (now (get services :now)) (schedule (get services :schedule))
           (unschedule (get services :unschedule)))
      (letfn (
        (cancel () (unless (undefined? timer) (funcall unschedule timer) (setq timer undefined)))
        (invalid (message) (throw (process-error "ELISCRIPT_ORIGINAL_CASE_PROTOCOL" message)))
        (line (bytes)
          (let* ((text (js-call bytes :toString "utf8")) (prefix "[wire-original-case] "))
            (when (js-call text :startsWith prefix)
              (let* ((record (JSON/parse (js-call text :slice (js-length prefix))))
                     (index (get record :index)) (event (get record :event)))
                (unless (and (Number/isInteger index) (= index next) (< index (get policy :end)))
                  (invalid "wire original-case index differs from its complete ordered schedule"))
                (cond
                  ((= event "start")
                    (when active (invalid "wire original case started before the preceding case completed"))
                    (setq active (Object/assign (js-object) record (js-object :status "failed" :startedAtMs (funcall now))))
                    (js-call rows :push active)
                    (setq timer (funcall schedule (lambda ()
                      (let ((error (process-error "ELISCRIPT_ORIGINAL_CASE_TIMEOUT"
                        (str "wire original case " index " exceeded " (get policy :deadlineMs) " ms"))))
                        (put error :timeoutMs (get policy :deadlineMs))
                        (put error :originalCase index)
                        (put active :failure (evidence-value error))
                        (funcall fail error))) (get policy :deadlineMs))))
                  ((= event "complete")
                    (unless active (invalid "wire original case completed without starting"))
                    (unless (and (= (get record :name) (get active :name))
                      (Number/isFinite (get record :elapsedMs)) (>= (get record :elapsedMs) 0))
                      (invalid "wire original-case completion differs from its start"))
                    (cancel)
                    (unless (get active :failure) (put active :status "passed"))
                    (put active :elapsedMs (get record :elapsedMs))
                    (put active :completedResources (get record :resources))
                    (put active :supervisorElapsedMs (- (funcall now) (get active :startedAtMs)))
                    (setq active undefined next (1+ next)))
                  (t (invalid "unknown wire original-case event")))))))
        (consume (bytes)
          (let ((offset 0) (end 0))
            (while (< offset (get bytes :length))
              (setq end (js-call bytes :indexOf 10 offset))
              (let* ((complete (>= end 0))
                     (piece (js-call bytes :subarray offset (if complete end (get bytes :length)))))
                (unless discard
                  (if (> (+ (get pending :length) (get piece :length)) 8192)
                    (setq discard t pending (Buffer/alloc 0))
                    (setq pending (Buffer/concat (js-array pending piece)))))
                (when complete
                  (unless discard (line pending))
                  (setq pending (Buffer/alloc 0) discard false))
                (setq offset (if complete (1+ end) (get bytes :length)))))))
        (finish (failed)
          (cancel)
          (try (when (and (not discard) (> (get pending :length) 0)) (line pending))
            (finally (cancel)))
          (unless (or failed (and (not active) (= next (get policy :end))))
            (invalid "wire original program exited without completing every scheduled original case"))
          rows))
        (js-object :consume consume :finish finish :cancel cancel :measurements rows))))
  (defasync runOriginalCorpusProcess (command args options)
    (let* ((directory (resolve (get options :directory)))
           (files (js-object :stdout (resolve directory "stdout.log") :stderr (resolve directory "stderr.log")
                   :events (resolve directory "lifecycle.jsonl")))
           (receipt-path (resolve directory "process-outcome.json"))
           (services (or (get options :services) (js-object)))
           (spawn-child (or (get services :spawn) spawn))
           (now (or (get services :now) (lambda () (js-call globalThis.performance :now))))
           (schedule (or (get services :setTimeout) globalThis.setTimeout))
           (unschedule (or (get services :clearTimeout) globalThis.clearTimeout))
           (policy (get options :policy)) (signal (get options :signal))
           (child undefined) (timer undefined) (sequence 0) (settling false)
           (has-failure false) (first undefined) (exit-failure undefined) (secondary (js-array))
           (terminated false) (handles (js-object)) (writes (js-object)) (drains (js-array))
           (counts (js-object :stdout 0 :stderr 0))
           (receipt (js-object :status "failed" :exitCode nil :signal nil :policy policy
              :caseId (get options :caseId) :target (get options :target) :sourceIdentity (get options :sourceIdentity)
              :stdout "" :stderr "" :outputFiles files :outputBytes counts :secondaryFailures secondary))
           (accept undefined) (reject undefined)
           (result (new globalThis.Promise (lambda (yes no) (setq accept yes reject no))))
           (fail (lambda (error)
             (if has-failure (unless (eq error first) (js-call secondary :push error))
               (setq has-failure t first error))))
           (terminate (lambda (reason)
             (when (and child (not terminated))
               (setq terminated t)
               (try
                 (if (get options :terminate) (js-call options :terminate child reason)
                   (js-call child :kill "SIGTERM"))
                 (catch error (funcall fail error))))))
           (event (lambda (phase)
             (let ((record (js-object :sequence sequence :caseId (get options :caseId)
                    :sourceIdentity (get options :sourceIdentity) :target (get options :target)
                    :pid (if child (get child :pid) nil) :phase phase :time (funcall now))))
               (setq sequence (1+ sequence))
               (put writes :events (js-call (get writes :events) :then
                 (lambda () (js-call (get handles :events) :writeFile (str (JSON/stringify record) "\n"))))))))
           (case-monitor (when (get policy :wireCase)
             (wire-case-monitor (get policy :wireCase)
               (js-object :now now :schedule schedule :unschedule unschedule)
               (lambda (error) (funcall fail error) (funcall terminate error)))))
           (abort (lambda ()
             (let ((reason (if (and signal (not (undefined? (get signal :reason)))) (get signal :reason)
                             (process-error "ABORT_ERR" "original corpus process aborted"))))
               (funcall fail reason) (funcall terminate reason)))))
      (unless (undefined? (get options :executionContext))
        (put receipt :executionContext (get options :executionContext)))
      (await (mkdir directory (js-object :recursive t)))
      (try
        (progn
          (js-call (js-array "stdout" "stderr" "events") :forEach
            (lambda (key) (put writes key (Promise/resolve undefined))))
          (let ((keys (js-array "stdout" "stderr" "events")) (index 0))
            (while (< index (js-length keys))
              (let ((key (aref keys index))) (put handles key (await (open (get files key) "w"))))
              (setq index (1+ index)))))
        (catch error
          (let ((keys (Object/keys handles)) (index 0))
            (while (< index (js-length keys))
              (try (await (js-call (get handles (aref keys index)) :close)) (catch ignored nil))
              (setq index (1+ index))))
          (throw error)))
      (let ((settle (async ()
        (unless settling
          (setq settling t)
          (unless (undefined? timer) (funcall unschedule timer))
          (when case-monitor (js-call case-monitor :cancel))
          (when signal (js-call signal :removeEventListener "abort" abort))
          (funcall event "child-exit")
          (await (Promise/all drains))
          (when case-monitor
            (try (js-call case-monitor :finish has-failure) (catch error (funcall fail error)))
            (put receipt :originalCases (get case-monitor :measurements)))
          (let ((keys (js-array "stdout" "stderr" "events")) (index 0))
            (while (< index (js-length keys))
              (try (await (get writes (aref keys index))) (catch error (funcall fail error)))
              (setq index (1+ index))))
          (when child
            (try (when (get options :cleanup) (await (js-call options :cleanup child)))
              (catch error (funcall fail error))))
          (funcall event "tree-cleanup-end")
          (try (await (get writes :events)) (catch error (funcall fail error)))
          (let ((keys (Object/keys handles)) (index 0))
            (while (< index (js-length keys))
              (try (await (js-call (get handles (aref keys index)) :close)) (catch error (funcall fail error)))
              (setq index (1+ index))))
          (let ((keys (js-array "stdout" "stderr")) (index 0))
            (while (< index (js-length keys))
              (let ((key (aref keys index)))
                (try (put receipt key (await (readFile (get files key) "utf8"))) (catch error (funcall fail error))))
              (setq index (1+ index))))
          ;; Only the supervisor's own exit failure gains the fully drained
          ;; original diagnostic. Never replace an earlier timeout, callback,
          ;; abort reason or caller-thrown value with process output.
          (when (and exit-failure (eq first exit-failure) (> (js-length (get receipt :stderr)) 0))
            (put exit-failure :message (str (get exit-failure :message) "\n" (get receipt :stderr))))
          (put receipt :status (if has-failure "failed" "passed"))
          (when has-failure (put receipt :failure (evidence-value first)))
          (let ((serialized (Object/assign (js-object) receipt
                  (js-object :secondaryFailures (js-call secondary :map evidence-value)))))
            (try (await (writeFile receipt-path (str (JSON/stringify serialized) "\n")))
              (catch error (funcall fail error) (put receipt :status "failed"))))
          (if has-failure
            (progn
              (when (and first (or (= (value-type first) "object") (= (value-type first) "function"))
                         (Object/isExtensible first))
                (try (Object/defineProperty first "execution" (js-object :value receipt :configurable t)) (catch ignored nil)))
              (funcall reject first))
            (funcall accept receipt))))))
        (if (and signal (get signal :aborted))
          (progn (funcall abort) (funcall settle))
          (try
            (progn
              (setq child (funcall spawn-child command args (js-object :cwd (get options :cwd)
                :env (Object/assign (js-object) (get globalThis.process :env) (get options :env))
                :stdio (js-array "ignore" "pipe" "pipe"))))
              (funcall event "spawn")
              (js-call (js-array "stdout" "stderr") :forEach (lambda (key)
                (let ((stream (get child key)))
                  (js-call drains :push (new globalThis.Promise (lambda (done)
                    (js-call stream :once "end" done)
                    (js-call stream :once "close" done)
                    (js-call stream :once "error" done))))
                  (js-call stream :on "data" (lambda (chunk)
                    (js-call stream :pause)
                    (let ((bytes (if (Buffer/isBuffer chunk) chunk (Buffer/from chunk))))
                      (when (and case-monitor (= key "stderr"))
                        (try (js-call case-monitor :consume bytes)
                          (catch error (funcall fail error) (funcall terminate error))))
                      (put counts key (+ (get counts key) (get bytes :length)))
                      (put writes key (js-call (get writes key) :then
                        (lambda () (js-call (get handles key) :writeFile bytes))))
                      (put writes key (js-call (get writes key) :then
                        (lambda () (js-call stream :resume))
                        (lambda (error) (funcall fail error) (funcall terminate error) (js-call stream :resume)))))))
                  (js-call stream :on "error" (lambda (error) (funcall fail error) (funcall terminate error))))))
              (js-call child :on "error" (lambda (error) (funcall fail error)))
              (js-call child :once "close" (lambda (code child-signal)
                (put receipt :exitCode (if (nullish? code) nil code))
                (put receipt :signal (if (nullish? child-signal) nil child-signal))
                (unless (or has-failure (= code 0))
                  (setq exit-failure (process-error (if child-signal "ELISCRIPT_ORIGINAL_HOST_SIGNAL" "ELISCRIPT_ORIGINAL_HOST_EXIT")
                    (if child-signal (str "original corpus host exited by " child-signal) (str "original corpus host exited with " code))))
                  (funcall fail exit-failure))
                (funcall settle)))
              (when signal
                (js-call signal :addEventListener "abort" abort (js-object :once t))
                (when (get signal :aborted) (funcall abort)))
              (unless (nullish? (get policy :effectiveDeadlineMs))
                (setq timer (funcall schedule (lambda ()
                  (let ((error (process-error "ELISCRIPT_ORIGINAL_HOST_TIMEOUT"
                          (str "original corpus host exceeded its " (get policy :effectiveDeadlineMs) " ms timeout"))))
                    (put error :timeoutMs (get policy :effectiveDeadlineMs))
                    (funcall fail error) (funcall terminate error))) (get policy :effectiveDeadlineMs)))))
            (catch error (funcall fail error) (funcall settle)))))
      (await result)))
  (export readOriginalProcessHostDependency bindOriginalProcessHostDependency validateOriginalProcessHostDependency originalCorpusExecutionPolicy runOriginalCorpusProcess writeOriginalCorpusExecutionContext readOriginalCorpusExecutionContext))
