(module tools.backends.compiler-corpus-managed-preload
  (import "node:fs/promises" realpath readFile writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "./compiler-data-transport.mjs" transportCompilerData transportCompilerNamespace)
  (import "./compiler-host-record.mjs" copyHostRecord)
  (import "./compiler-host-iteration.mjs" openHostIterator advanceHostIterator closeHostIterator)
  (defconst import-module (js* "(specifier) => import(specifier)"))
  (defun digest (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun append-plugins (values plugin)
    (let ((result (js-array)) (iterator (openHostIterator values)))
      (try
        (while (advanceHostIterator iterator) (js-call result :push (get iterator :value)))
        (catch error (closeHostIterator iterator t) (throw error))
        (finally (closeHostIterator iterator false)))
      (js-call result :push plugin) result))

  (defasync installOriginalManagedPreload (config-path expected-digest)
    (let ((raw (await (readFile config-path))))
      (unless (= (digest raw) expected-digest)
        (throw (new globalThis.TypeError "original managed suite transport configuration changed")))
      (let* ((configuration (JSON/parse (js-call raw :toString "utf8")))
             (root (get configuration :sourceRoot)) (product (get configuration :product))
             (build-path (resolve root "tools/backends/build.mjs"))
             (canonical-build-path (await (realpath build-path)))
             (module-records (get configuration :moduleRecords))
             (functions (new globalThis.WeakMap)) (loading undefined)
             (selected (js-object :directory (resolve product "backends") :product product
               :transportCompilerData transportCompilerData :transportModule (get configuration :transportModule)
               :moduleRecords module-records :moduleIds (js-call module-records :map (lambda (record) (get record :id)))
               :browserModules (new globalThis.Map))))
        (unless (and (= (get configuration :format) "eliscript-original-managed-suite")
                     (= (get configuration :version) 1)
                     (= (digest (await (readFile build-path))) (get configuration :buildSha256)))
          (throw (new globalThis.TypeError "original selected frontend build source changed")))
        (put selected :load (async ()
          (when (undefined? loading)
            (setq loading (js-call
              (funcall (async ()
                (put selected :compiler (transportCompilerNamespace
                  (await (funcall import-module (get (pathToFileURL (resolve product "bootstrap/compiler.mjs")) :href))) functions))
                (let ((plans (js-array (js-array "optimizer" "optimize") (js-array "numeric" "numeric")
                               (js-array "wasm" "wasm") (js-array "native" "native")
                               (js-array "sha256" "sha256") (js-array "regexp" "regexp")
                               (js-array "managed" "managed") (js-array "memory" "memory"))) (index 0))
                  (while (< index (js-length plans))
                    (let* ((plan (aref plans index)) (name (aref plan 1)))
                      (put selected (aref plan 0) (transportCompilerNamespace
                        (await (funcall import-module (get (pathToFileURL (resolve (get selected :directory) (str name ".mjs"))) :href))) functions)))
                    (setq index (1+ index)))) selected))
              :catch (lambda (error) (setq loading undefined) (throw error))))) loading))
        (put (js* "globalThis") (Symbol/for "eliscript.original.selected-backends") selected)
        (let ((original-build (get (js* "Bun") :build)))
          (put (js* "Bun") :build (lambda (options)
            (if (or (nullish? options) (/= (get options :target) "browser"))
              (Reflect/apply original-build (js* "Bun") (js-array options))
              (let* ((plugin (js-object :name "selected-compiler-browser-source" :setup (lambda (builder)
                       (js-call builder :onLoad (js-object :filter (new globalThis.RegExp "[.]mjs$"))
                         (async (arguments)
                           (let ((record (js-call (get selected :browserModules) :get (await (realpath (get arguments :path))))))
                             (if (undefined? record) undefined
                               (let ((source (await (readFile (get record :filename) "utf8"))))
                                 (js-object :contents (js-call (get record :compiler) :compile_string source (get record :filename))
                                   :loader "js" :resolveDir (resolve (get arguments :path) ".."))))))))))
                     (forwarded (copyHostRecord options))
                     (provided (get options :plugins))
                     (plugins (append-plugins (if (nullish? provided) (js-array) provided) plugin)))
                (Reflect/apply original-build (js* "Bun")
                  (js-array (copyHostRecord forwarded (js-object :plugins plugins))))))))
        (js-call (js* "Bun") :plugin
          (js-object :name "actual-selected-compiler-backends" :setup (lambda (builder)
            (js-call builder :onLoad (js-object :filter (new globalThis.RegExp "build[.]mjs$"))
              (async (arguments)
                (if (/= (await (realpath (get arguments :path))) canonical-build-path) undefined
                  (progn
                    (unless (= (digest (await (readFile build-path))) (get configuration :buildSha256))
                      (throw (new globalThis.TypeError "original selected frontend build source changed")))
                    (await (writeFile (get configuration :interceptionPath)
                      (JSON/stringify (js-object :product product :modules (get selected :moduleIds)))))
                    (js-object :contents (get configuration :contents) :loader "js")))))))))))
  )
  (export installOriginalManagedPreload))
