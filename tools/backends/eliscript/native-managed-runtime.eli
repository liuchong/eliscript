(module tools.backends.native-managed-runtime
  (import "./native-memory.mjs" openNativeMemory)
  (import "./managed-host.mjs"
    createManagedHostRuntime createManagedHostCapabilityBridge failManagedRuntime validateManagedRuntimeOptions)
  (import "./managed-runtime.mjs" loadManagedHostModules createManagedModuleGraph loadManagedProjectGraph)
  (import "./managed-module-graph.mjs" observeManagedProjectRuntime observeManagedProjectExports)
  (import "./managed-source-view.mjs" registerManagedSourceDecodeRuntime)
  (import "./compiler-debug.mjs" createCompilerDebugMap)

  (defun native-nullish (value fallback) (if (nullish? value) fallback value))
  (defun native-optional (value key) (if (nullish? value) undefined (get value key)))
  (defun native-truth (value) (funcall globalThis.Boolean value))
  (defun native-copy (target source)
    (unless (nullish? source)
      (let* ((object (funcall globalThis.Object source)) (keys (Reflect/ownKeys object)) (index 0))
        (while (< index (js-length keys))
          (let* ((key (aref keys index)) (descriptor (Object/getOwnPropertyDescriptor object key)))
            (when (get descriptor :enumerable)
              (Object/defineProperty target key
                (js-object :value (get object key) :writable t :enumerable t :configurable t))))
          (setq index (1+ index))))) target)

  (defun native-options (arguments)
    (let* ((provided (if (> (js-length arguments) 0) (aref arguments 0) undefined))
           (input (if (undefined? provided) (js-object) provided))
           (options (native-copy (js-object) input)) (seed (validateManagedRuntimeOptions input)))
      (Object/defineProperty options "randomSeed"
        (js-object :value seed :writable t :enumerable t :configurable t))
      (let ((extended (get options :extendedHeap)))
        (unless (or (undefined? extended) (= extended false) (= extended t))
          (throw (new globalThis.TypeError "extendedHeap must be a boolean")))) options))

  (defun native-source-error (source-map error)
    (when (and source-map (not (eq error nil)) (= (value-type error) "object")
               (Array/isArray (get error :eliscriptFrames)) (not (Array/isArray (get error :eliscriptSourceFrames))))
      (try (put error :eliscriptSourceFrames (js-call source-map :mapFrames (get error :eliscriptFrames)))
        (catch ignored nil))) error)

  (defun native-debug-value (options lowered)
    (let ((value (get options :debug))) (if (nullish? value) (get lowered :debug) value)))
  (defun closeNativeManagedResources (lifecycle owned)
    (let ((failed false) (failure undefined))
      (try (when (get lifecycle :dispose) (js-call lifecycle :dispose))
        (catch error (setq failed t failure error)))
      ;; Releasing the native owner is mandatory even when managed disposal
      ;; failed. A later cleanup failure cannot replace false or undefined.
      (try (js-call owned :close)
        (catch error (unless failed (setq failed t failure error))))
      (when failed (throw failure))))
  (defun native-trap-sites (options lowered)
    (let ((value (get options :trapSites)))
      (if (not (nullish? value)) value
        (let ((value (native-optional (get options :debug) "trapSites")))
          (if (not (nullish? value)) value (native-optional (get lowered :debug) "trapSites"))))))

  (defun native-memory-view (owned offset length)
    (let ((bytes (js-call owned :read offset length)))
      (new globalThis.DataView (get bytes :buffer) (get bytes :byteOffset) (get bytes :byteLength))))

  (defun native-memory-scalar-view (owned)
    ;; This facade contains scalar operations only. The private backing view
    ;; remains inside its owner, while the Node child transport keeps its
    ;; existing independent byte-copy fallback.
    (let ((read16 (= (value-type (get owned :getUint16)) "function"))
          (read32 (= (value-type (get owned :getUint32)) "function"))
          (read64 (= (value-type (get owned :getFloat64)) "function"))
          (write16 (= (value-type (get owned :setUint16)) "function"))
          (write32 (= (value-type (get owned :setUint32)) "function")))
      (Object/freeze (js-object
        :getFloat64 (lambda (offset endian)
          (if read64 (js-call owned :getFloat64 offset endian) (js-call (native-memory-view owned offset 8) :getFloat64 0 endian)))
        :getUint16 (lambda (offset endian)
          (if read16 (js-call owned :getUint16 offset endian) (js-call (native-memory-view owned offset 2) :getUint16 0 endian)))
        :getUint32 (lambda (offset endian)
          (if read32 (js-call owned :getUint32 offset endian) (js-call (native-memory-view owned offset 4) :getUint32 0 endian)))
        :setUint16 (lambda (offset value endian)
          (if write16 (js-call owned :setUint16 offset value endian)
            (let ((bytes (new globalThis.Uint8Array 2)))
              (js-call (new globalThis.DataView (get bytes :buffer)) :setUint16 0 value endian)
              (js-call owned :write bytes offset))))
        :setUint32 (lambda (offset value endian)
          (if write32 (js-call owned :setUint32 offset value endian)
            (let ((bytes (new globalThis.Uint8Array 4)))
              (js-call (new globalThis.DataView (get bytes :buffer)) :setUint32 0 value endian)
              (js-call owned :write bytes offset))))))))

  (defun native-heap-exports (exports options)
    (if (not (= (get options :extendedHeap) t)) exports
      (let ((constructor (get exports "heap-new-extended")))
        (unless (= (value-type constructor) "function")
          (throw (new globalThis.TypeError "managed runtime requires heap-new-extended for extendedHeap")))
        (let* ((descriptors (Object/getOwnPropertyDescriptors exports))
               (legacy (get descriptors "heap-new")) (facade (Object/create (Object/getPrototypeOf exports))))
          (unless legacy (failManagedRuntime 3))
          (put legacy :value constructor)
          (Object/defineProperties facade descriptors) (Object/freeze facade)))))

  (defun native-runtime-abi (lowered)
      (unless (and (native-truth lowered) (= (native-optional (get lowered :typed) "abi") "memory-u32")
                   (Array/isArray (get (get lowered :typed) :functions))
                   (Array/isArray (get (get lowered :typed) :exports)) (native-truth (get lowered :descriptor)))
        (failManagedRuntime 3))
      ;; Snapshot exactly the original ABI fields before any host-module await;
      ;; executable typed bodies remain owned by the emitted library/artifact.
      (let* ((source-typed (get lowered :typed))
             (function-abi (js-call (get source-typed :functions) :map
               (lambda (fn) (js-object :name (get fn :name) :arity (get fn :arity)))))
             (export-abi (js-call (get source-typed :exports) :slice))
             (source-aliases (get source-typed :aliases))
             (alias-abi (if (Array/isArray source-aliases)
               (js-call source-aliases :map (lambda (alias) (js-object :name (get alias :name) :function (get alias :function))))
               source-aliases))
             (snapshot (funcall globalThis.structuredClone
               (js-object :typed (js-object :abi "memory-u32" :functions function-abi :exports export-abi :aliases alias-abi)
                 :descriptor (get lowered :descriptor))))
             (typed (get snapshot :typed)) (descriptor (get snapshot :descriptor))
             (functions (new globalThis.Map)) (arities (Object/create nil)) (index 0))
        (while (< index (js-length (get typed :functions)))
          (let ((fn (aref (get typed :functions) index)))
            (unless (and (= (value-type (get fn :name)) "string") (not (js-call functions :has (get fn :name)))
                         (Number/isInteger (get fn :arity)) (>= (get fn :arity) 0) (<= (get fn :arity) 65535))
              (failManagedRuntime 3))
            (js-call functions :set (get fn :name) (get fn :arity))) (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length (get typed :exports)))
          (let ((name (aref (get typed :exports) index)))
            (unless (and (js-call functions :has name) (not (Object/hasOwn arities name))) (failManagedRuntime 3))
            (put arities name (js-call functions :get name))) (setq index (1+ index)))
        (unless (or (undefined? (get typed :aliases)) (Array/isArray (get typed :aliases))) (failManagedRuntime 3))
        (let ((aliases (native-nullish (get typed :aliases) (js-array))) (position 0))
          (while (< position (js-length aliases))
            (let ((alias (aref aliases position)))
              (unless (and (= (value-type (get alias :name)) "string")
                           (js-call functions :has (get alias :function)) (not (Object/hasOwn arities (get alias :name))))
                (failManagedRuntime 3))
              (put arities (get alias :name) (js-call functions :get (get alias :function))))
            (setq position (1+ position))))
        (let ((required (js-array (js-array "last-error" 0) (js-array "heap-new" 3) (js-array "value-kind" 2)
                        (js-array "heap-pin" 2) (js-array "heap-release" 2) (js-array "frame-current" 1) (js-array "frame-unwind" 2)))
              (position 0))
          (while (< position (js-length required))
            (let ((entry (aref required position)))
              (unless (= (get arities (aref entry 0)) (aref entry 1)) (failManagedRuntime 3)))
            (setq position (1+ position))))
        (js-array snapshot arities)))

  ;; This is the same validated snapshot consumed by the native factory. It
  ;; describes already emitted code; no executable body or debug getter is read.
  (defun snapshotNativeManagedRuntimeABI (lowered)
    (aref (native-runtime-abi lowered) 0))

  (defasync instantiateNativeManagedRuntime (path lowered &rest arguments)
    (let* ((options (native-options arguments))
           (abi (native-runtime-abi lowered)) (snapshot (aref abi 0))
           (descriptor (get snapshot :descriptor)) (arities (aref abi 1)))
        (when (and (= (get options :extendedHeap) t) (not (= (get arities "heap-new-extended") 3)))
          (throw (new globalThis.TypeError "managed runtime requires heap-new-extended for extendedHeap")))
        (let* ((provided-graph (get options :moduleGraph))
               (module-graph (when (native-truth (get descriptor :project))
                 (if (nullish? provided-graph) (createManagedModuleGraph descriptor) provided-graph))))
          (when (and module-graph (or (native-truth (get module-graph :closed)) (native-truth (get module-graph :attached))))
            (throw (new globalThis.Error "module graph is already attached or closed")))
          (let* ((load-options (native-copy (js-object) options))
                 (_graph-options (when module-graph
                   (native-copy load-options (js-object :moduleGraph module-graph :hostModules (get module-graph :hostModules)))))
                 (host-modules (await (loadManagedHostModules descriptor load-options)))
                 (_provided-namespaces
                   (when module-graph
                     (let ((provided (get options :hostModules))
                           (declarations (native-nullish (get descriptor :hostModules) (js-array))))
                       ;; Keep the graph's live NamespaceBindings instance. Its
                       ;; declared IDs still resolve through the original phased
                       ;; namespace validation, while explicit auxiliary literal
                       ;; providers retain the caller's exact namespace identity.
                       (when (and (js-call globalThis.Map globalThis.Symbol.hasInstance provided)
                                  (not (eq provided host-modules)))
                         (js-call provided :forEach (lambda (namespace id)
                           (unless (js-call declarations :some (lambda (entry) (= (get entry :id) id)))
                             (js-call host-modules :set id namespace))))))))
                 (configuration (native-copy (native-copy (js-object) options) (js-object :hostModules host-modules)))
                 (_configuration-graph (when module-graph
                   (native-copy configuration (js-object :moduleGraph module-graph :initializeModule false))))
                 (bridge (createManagedHostCapabilityBridge descriptor configuration))
                 (debug (native-debug-value options lowered))
                 (source-map (when (and (native-truth debug) (= (value-type debug) "object")) (createCompilerDebugMap debug)))
                 (lifecycle (js-object :capabilityBridge bridge)) (owned undefined) (closed false))
            (try
              (setq owned (await (openNativeMemory path arities
                (js-object :initialPages (native-nullish (get options :initialPages) 1)
                  :maximumPages (native-nullish (get options :maximumPages) 256)
                  :nativeTarget (get options :nativeTarget) :libcLibrary (get options :libcLibrary) :bunExecutable (get options :bunExecutable)
                  :trapSites (native-trap-sites options lowered)
                  :debug (native-debug-value options lowered)
                  :hostCapabilities (native-nullish (get descriptor :hostCapabilities) (js-array))
                  :hostCall (lambda (index heap argv)
                    (let ((capability (native-optional (get descriptor :hostCapabilities) index)))
                      (unless (native-truth capability) (throw (new globalThis.TypeError "undeclared native host capability")))
                      (js-call bridge :dispatch (get capability :name) heap argv)))))))
              (catch error
                (try (js-call bridge :close) (catch ignored nil))
                (try (when module-graph (js-call module-graph :close)) (catch ignored nil))
                (throw error)))
            (try
              (let ((exports (Object/create nil)) (entries (Object/entries arities)) (position 0))
                (while (< position (js-length entries))
                  (let* ((entry (aref entries position)) (name (aref entry 0)) (arity (aref entry 1))
                         (fn (lambda (&rest args) (Reflect/apply (get owned :invoke) owned (js-call (js-array name) :concat args)))))
                    (Object/defineProperty fn "length" (js-object :value arity)) (put exports name fn))
                  (setq position (1+ position)))
                (let* ((scalar-view (native-memory-scalar-view owned))
                       (memory (js-object
                        :view (lambda () scalar-view)
                        :readBytes (lambda (offset length) (js-call owned :read offset length))
                        :writeBytes (lambda (offset bytes) (js-call owned :write bytes offset))))
                       (api (createManagedHostRuntime
                              (observeManagedProjectExports (native-heap-exports exports options) module-graph)
                              descriptor memory configuration lifecycle))
                       (methods (js-object)) (api-entries (Object/entries api)) (item 0))
                  (while (< item (js-length api-entries))
                    (let* ((entry (aref api-entries item)) (name (aref entry 0)) (value (aref entry 1)))
                      (cond
                        ((and (= name "project") (native-truth value))
                          (let ((project (js-object)))
                            (js-call (Object/entries value) :forEach
                              (lambda (entry)
                                (let ((key (aref entry 0)) (method (aref entry 1)))
                                  (put project key (lambda (&rest args)
                                    (when closed (throw (new globalThis.Error "native managed runtime is closed")))
                                    (try (Reflect/apply method undefined args)
                                      (catch error (throw (native-source-error source-map error)))))))))
                            (put methods name (Object/freeze project))))
                        ((not (= (value-type value) "function")) (put methods name value))
                        (t
                          (let ((guarded (lambda (&rest args)
                                  (when closed (throw (new globalThis.Error "native managed runtime is closed")))
                                  (try
                                    (let ((result (Reflect/apply value undefined args)))
                                      (if (= name "invokeAsync")
                                        (js-call result :catch (lambda (error) (throw (native-source-error source-map error)))) result))
                                    (catch error (throw (native-source-error source-map error)))))))
                            (Object/defineProperties guarded
                              (js-object :length (js-object :value (get value :length)) :name (js-object :value (get value :name))))
                            (put methods name guarded)))))
                    (setq item (1+ item)))
                  (put methods :close (lambda ()
                    (unless closed
                      (setq closed t)
                      (closeNativeManagedResources lifecycle owned))))
                  (let ((runtime (observeManagedProjectRuntime
                                  (registerManagedSourceDecodeRuntime (Object/freeze methods) api) module-graph)))
                    (when module-graph
                      (if (= (get options :initializeModule) false) (js-call module-graph :attachRuntime runtime)
                        (await (loadManagedProjectGraph runtime descriptor
                          (native-copy (native-copy (js-object) options) (js-object :moduleGraph module-graph)))))) runtime)))
              (catch error
                (unless closed
                  (setq closed t)
                  (try (closeNativeManagedResources lifecycle owned) (catch ignored nil)))
                (throw (native-source-error source-map error))))))))

  (export instantiateNativeManagedRuntime snapshotNativeManagedRuntimeABI closeNativeManagedResources))
