(module tools.backends.compiler-corpus-wire
  (import "../../dist/bootstrap/compiler.mjs" compile-string compile-ir-string)
  (import "../../dist/bootstrap/emitter.mjs" emit-top-level)
  (import "./compiler-corpus-wire-host.mjs" wireFunctionalParts wireWholePart wireSuiteSha)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (defun fail (message) (throw (new globalThis.TypeError message)))
  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defasync prepareOriginalWirePartitions (options)
    (let ((assets (js-array)) (files (js-array
      "tools/backends/eliscript/compiler-corpus-wire.eli" "tools/backends/compiler-corpus-wire.mjs"
      "tools/backends/eliscript/compiler-corpus-wire-host.eli" "tools/backends/compiler-corpus-wire-host.mjs"))
      (index 0))
      (while (< index (js-length files))
        (let* ((file (aref files index)) (identity (await (js-call options :file file))))
          (js-call assets :push (js-object :file file :sourceSha256 (get identity :sha256))))
        (setq index (1+ index)))
      (js-object :assets assets :sourceRoot (get options :sourceRoot))))
  (defun wire-host (original root part)
    (let* ((boundary "let {runtime,boundaryLowered,selectedInput} = __managed_context;\n")
           (begin (js-call original :indexOf boundary))
           (source (str "(put (js* \"__managed_context\") :wirePartition (JSON/parse "
                       (JSON/stringify (JSON/stringify part)) "))"))
           (filename "original-wire-controller.eli")
           (program (compile-ir-string source filename))
           (statement (get (emit-top-level (aref (get program :body) 0)) :text))
           (emitted (compile-string source filename)))
      (unless (and (>= begin 0) (= (js-call original :indexOf boundary (1+ begin)) -1)
                   (= (js-length (js-call emitted :split statement)) 2))
        (fail "complete original wire maintained context or controller changed"))
      (let ((end (+ begin (js-length boundary))))
        (js-object :source (str (js-call original :slice 0 end) statement "\n" (js-call original :slice end))
          :installation (js-object :filename filename :source source :sourceSha256 (digest source)
            :statement statement :statementSha256 (digest statement) :emittedSha256 (digest emitted) :part part)))))
  (defun expandOriginalWireRecord (record prepared)
    (let* ((id (get record :id)) (original (get record :original))
           (execution (get record :execution))
           (canonical (and (= (value-type id) "string")
             (js-call (new globalThis.RegExp "^original-managed:wire(?:-original-host)?:(node|bun):auto-(65536|1)$") :test id)))
           (selected (and canonical (js-call id :startsWith "original-managed:wire:")
             (= (get record :auto) 1)
             (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))))
      (if (not canonical) (js-array record)
        (progn
          (unless (and (= (get original :suite) "tests/wasm-managed-wire.test.mjs")
            (= (get original :fixture) "tests/fixtures/wasm-managed-wire.eli")
            (= (get original :sourceSha256) wireSuiteSha)
            (= (get execution :kind) "original-program")
            (= (value-type (get execution :hostSource)) "string"))
            (fail "wire functional schedule requires the complete authenticated original recipe"))
          (if (js-call id :startsWith "original-managed:wire-original-host:")
            (js-array (Object/assign (js-object) record (js-object :request
              (Object/assign (js-object) (get record :request) (js-object :foreignEntry t)))))
          (js-call (if selected wireFunctionalParts (js-array wireWholePart)) :map (lambda (part index)
            (let* ((copy (globalThis.structuredClone record)) (provenance (get copy :original))
                   (assets (get provenance :sourceAssets))
                   (name (if (= index 0) id (str id ":part-" (get part :name))))
                   (controller (wire-host (get execution :hostSource) (get prepared :sourceRoot) part)))
              (put copy :id name)
              (put (get copy :request) :foreignEntry t)
              (js-call (get prepared :assets) :forEach (lambda (asset)
                (unless (js-call assets :some (lambda (item) (= (get item :file) (get asset :file))))
                  (js-call assets :push (globalThis.structuredClone asset)))))
              (when selected (put provenance :functionalPartition (js-object :family "wire" :originalId id :index index
                :part (get part :name) :corpusCount 253
                :parts (js-call wireFunctionalParts :map (lambda (item) (get item :name)))
                :originalHostSha256 (digest (get execution :hostSource))
                :originalAggregatePerformance "NOT ACCEPTED")))
              (put provenance :wireController (js-object :sourceSha256 wireSuiteSha
                :originalHostSha256 (digest (get execution :hostSource)) :scope (get part :name) :installation (get controller :installation)))
              (put (get copy :execution) :hostSource (get controller :source))
              (put (get copy :execution) :host (str "tests/__eliscript_wire_" (get execution :hostRuntime) "_" (get part :name) ".mjs"))
              copy))))))))
  (export prepareOriginalWirePartitions expandOriginalWireRecord))
