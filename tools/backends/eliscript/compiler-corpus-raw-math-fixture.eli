(module tools.backends.compiler-corpus-raw-math-fixture
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:vm" runInNewContext)
  (import "../../dist/bootstrap/compiler.mjs" compile-ir-string)
  (import "../../dist/bootstrap/emitter.mjs" emit-expression)
  (import "./compiler-corpus-raw-fixture-observer.mjs" raw-scope)

  (defun source-section (source begin end)
    (let* ((start (js-call source :indexOf begin)) (finish (js-call source :indexOf end (+ start (js-length begin)))))
      (unless (and (>= start 0) (> finish start)
                   (let ((next (js-call source :indexOf begin (1+ start))))
                     (or (= next -1) (>= next finish))))
        (throw (new globalThis.TypeError "original Math model source boundaries changed")))
      (js-call source :slice start finish)))

  (defun loadOriginalRawMathModels (input)
    (let* ((source (get input :source))
           (digest (js-call (js-call (createHash "sha256") :update source) :digest "hex")))
      (unless (= digest (get input :sourceSha256))
        (throw (new globalThis.TypeError "original Math model source identity mismatch")))
      ;; Original source is authenticated data. Only the result expression is
      ;; newly emitted, through the existing Eli compiler and emitter.
      (let* ((program (compile-ir-string
               "(js-object :unaryNames (js* \"unaryNames\") :constants (js* \"constants\") :methodLengths (js* \"methodLengths\") :primitives (js* \"primitives\") :adjacent (js* \"adjacent\") :froundBoundaries (js* \"froundBoundaries\") :froundRandom (js* \"froundRandom\") :f16Model (js* \"f16Model\") :f16Boundaries (js* \"f16Boundaries\") :sumPreciseModel (js* \"sumPreciseModel\") :sumSamples (js* \"sumSamples\") :sumIteratorObservation (js* \"sumIteratorObservation\"))"
               "original-math-model-exports.eli"))
             (expression (get (emit-expression (aref (get (aref (get program :body) 0) :children) 0)) :text))
             (body (str (source-section source "const unaryNames =" "const sqrtSource =") "\n"
                     (source-section source "function adjacent(" "function sumArray(") "\n(" expression ")")))
        (runInNewContext body (js-object :assert assert) (js-object :filename "original-math-models")))))

  (defun runOriginalRawMathFixtureHost (input)
    (let* ((runtime (get input :runtime)) (oracle (get input :oracle))
           (models (or (get input :models) (loadOriginalRawMathModels input)))
           (unary (get models :unaryNames)) (primitives (get models :primitives)) (observations 0))
      (letfn ((check (body)
                (let ((scope (raw-scope runtime "math")))
                  (try (funcall body scope) (setq observations (1+ observations))
                    (finally (js-call scope :close)))))
              (raw (scope name arguments)
                (Reflect/apply (get scope :value) scope
                  (js-call (js-array name) :concat (js-call arguments :map (lambda (v) (js-call scope :box v))))))
              (reference (name arguments)
                (Reflect/apply (get oracle (js-call name :replaceAll "-" "_")) oracle arguments))
              (compare (name arguments)
                (check (lambda (scope) (js-call assert :deepStrictEqual (raw scope name arguments) (reference name arguments)))))
              (direct-dynamic (name arguments)
                (check (lambda (scope)
                  (js-call assert :deepStrictEqual
                    (js-array (raw scope (str "direct-" name) arguments)
                      (raw scope "math-invoke" (js-call (js-array name) :concat arguments)))
                    (js-array (reference (str "direct-" name) arguments)
                      (reference "math-invoke" (js-call (js-array name) :concat arguments)))))))
              (held (scope name argument)
                (js-call scope :value "invoke-held" (js-call scope :call "namespace-get" (js-call scope :box name)) argument)))
        (js-call (js-array "namespace-summary" "namespace-tag-description" "lexical-shadow" "namespace-mutation"
          "namespace-extension" "namespace-constant-errors") :forEach (lambda (name) (compare name (js-array))))
        (js-call (get models :constants) :forEach (lambda (key) (compare "constant-description" (js-array key))))
        (js-call (js-call (Object/keys (get models :methodLengths)) :concat (js-array "f16round" "sumPrecise")) :forEach
          (lambda (key) (compare "method-description" (js-array key))))
        (js-call (js-array false t) :forEach (lambda (dynamic)
          (js-call (js-array false t) :forEach (lambda (abrupt) (compare "callee-order" (js-array dynamic abrupt))))))
        (js-call (js-array false t) :forEach (lambda (abrupt) (compare "key-order" (js-array abrupt))))
        (js-call unary :forEach (lambda (name)
          (js-call primitives :forEach (lambda (value) (direct-dynamic name (js-array value))))))
        (let ((bit 0))
          (while (< bit 32)
            (let ((power (Math/pow 2 bit)))
              (js-call (js-array power (1- power) (1+ power) (- power)) :forEach
                (lambda (value) (compare "direct-clz32" (js-array value)))))
            (setq bit (1+ bit))))
        (let ((pairs (js-array (js-array 0 -0) (js-array globalThis.NaN 7) (js-array globalThis.Infinity (- globalThis.Infinity))
                  (js-array -1 5) (js-array 4294967295 5) (js-array 2147483648 2)
                  (js-array 2147483647 2147483647) (js-array 4294967295 4294967295)
                  (js-array 9007199254740991 -4294967297) (js-array "0xffffffff" "-1")
                  (js-array undefined t) (js-array nil "3"))) (state 477785657) (index 0))
          (letfn ((next () (setq state (% (+ (Math/imul state 1664525) 1013904223) 4294967296))
                            (when (< state 0) (setq state (+ state 4294967296))) state))
            (while (< index 64) (js-call pairs :push (js-array (next) (next))) (setq index (1+ index))))
          (js-call pairs :forEach (lambda (pair) (direct-dynamic "imul" pair))))
        (js-call (js-call unary :concat (js-array "imul" "f16round")) :forEach (lambda (name)
          (js-call (js-array (js-array) (js-array undefined) (js-array nil) (js-array -0 99 "ignored")) :forEach
            (lambda (arguments) (compare "math-invoke" (js-call (js-array name) :concat arguments))))
          (js-call (js-array "conversion-order" "conversion-hint" "primitive-rejections") :forEach
            (lambda (call) (compare call (js-array name))))
          (js-call (js-array 0 1 2) :forEach (lambda (mode) (compare "conversion-abrupt" (js-array name mode))))))
        (js-call (js-array "min" "max") :forEach (lambda (name)
          (compare "extreme-order" (js-array name))
          (js-call (js-array (js-array) (js-array -0) (js-array 0 -0) (js-array -0 0)
            (js-array globalThis.NaN 4) (js-array 4 globalThis.NaN) (js-array undefined) (js-array 1 9 -7 2)) :forEach
            (lambda (arguments) (compare "math-invoke" (js-call (js-array name) :concat arguments))))))
        (js-call (js-call (js-call models :froundBoundaries) :concat (js-call models :froundRandom)) :forEach
          (lambda (value) (check (lambda (scope)
            (js-call assert :deepStrictEqual
              (js-array (raw scope "direct-fround" (js-array value)) (raw scope "math-invoke" (js-array "fround" value))
                (held scope "fround" (js-call scope :box value)))
              (js-array (reference "direct-fround" (js-array value)) (reference "math-invoke" (js-array "fround" value))
                (reference "invoke-held" (js-array (reference "namespace-get" (js-array "fround")) value))))))))
        (js-call (js-call (js-call models :f16Boundaries) :concat (js-call (js-call models :froundRandom) :slice 0 48) primitives) :forEach
          (lambda (value) (check (lambda (scope)
            (let ((expected (js-call models :f16Model value)))
              (js-call assert :ok (Object/is (raw scope "direct-f16round" (js-array value)) expected))
              (js-call assert :ok (Object/is (raw scope "math-invoke" (js-array "f16round" value)) expected))
              (js-call assert :ok (Object/is (held scope "f16round" (js-call scope :box value)) expected)))))))
        (js-call (js-call models :sumSamples) :forEach (lambda (values) (check (lambda (scope)
          (let ((expected (js-call models :sumPreciseModel values)) (argument (js-call scope :array values)))
            (js-call assert :ok (Object/is (js-call scope :value "sum-direct" argument) expected))
            (js-call assert :ok (Object/is (js-call scope :value "sum-dynamic" argument) expected))
            (js-call assert :ok (Object/is (held scope "sumPrecise" argument) expected)))))))
        (let ((mode 0))
          (while (<= mode 29)
            (check (lambda (scope) (js-call assert :deepStrictEqual
              (raw scope "sum-iterator-case" (js-array mode))
              ;; vm models retain primitive/array observations; compare in this
              ;; realm without changing globalThis.NaN, negative zero or undefined.
              (globalThis.structuredClone (js-call models :sumIteratorObservation mode)))))
            (setq mode (1+ mode))))
        (compare "sum-extra-order" (js-array)) (compare "sum-array-like-rejection" (js-array))
        (check (lambda (scope)
          (let ((method (js-call scope :call "namespace-get" (js-call scope :box "fround")))
                (ref (reference "namespace-get" (js-array "fround"))))
            (raw scope "set-namespace-state" (js-array -0)) (reference "set-namespace-state" (js-array -0))
            (js-call assert :ok (Object/is (raw scope "read-namespace-state" (js-array)) -0))
            (js-call assert :ok (Object/is (reference "read-namespace-state" (js-array)) -0))
            (js-call assert :deepStrictEqual (js-call scope :value "invoke-held" method (js-call scope :box -0))
              (reference "invoke-held" (js-array ref -0)))
            (js-call assert :ok (raw scope "delete-namespace-state" (js-array)))
            (js-call assert :ok (reference "delete-namespace-state" (js-array))))))
        (js-object :observations observations))))
  (export loadOriginalRawMathModels runOriginalRawMathFixtureHost))
