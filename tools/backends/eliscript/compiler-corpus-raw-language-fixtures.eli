          (js-array (oc oracle "stringify-value" (js-array ref ref)) (error-name (lambda () (oc oracle "stringify-value" ref-cycle))))))))
    (funcall check "JSON proto own descriptor" (lambda (s)
      (let* ((object (js-call s :call "parse-value" (js-call s :box "{\"__proto__\":7}"))) (ref (oc oracle "parse-value" "{\"__proto__\":7}")))
        (js-call assert :ok (js-call s :value "own-value" object (js-call s :box "__proto__")))
        (js-call assert :ok (oc oracle "own-value" ref "__proto__"))
        (js-call assert :deepStrictEqual
          (js-array (js-call s :value "key-value" object (js-call s :box "__proto__")) (js-call s :read (js-call s :keep (js-call runtime :objectKeys object))))
          (js-array (oc oracle "key-value" ref "__proto__") (Object/keys ref)))))))
  (defun runOriginalRawLanguageFixtureHost (configuration)
    (let* ((family (get configuration :family)) (plan (js-call plans :find (lambda (item) (= (get item :family) family))))
           (runtime (get configuration :runtime)) (oracle (get configuration :oracle)) (observations 0)
           (groups (Object/create nil)))
      (unless plan (throw (new globalThis.TypeError "unknown original raw language fixture family")))
      (letfn ((check (label body)
        (let ((scope (raw-scope runtime family)) (failed false))
          (try (funcall body scope)
            (setq observations (1+ observations))
            (put groups label (1+ (or (get groups label) 0)))
            (catch error
              (setq failed t)
              ;; Evidence belongs to this original observation. Keep the exact
              ;; thrown identity and do not inspect a frozen/foreign failure.
              (when (and (not (nullish? error))
                         (or (= (value-type error) "object") (= (value-type error) "function")))
                (try
                  (when (and (Object/isExtensible error) (not (Object/hasOwn error "originalRawFixture")))
                    (Object/defineProperty error "originalRawFixture" (js-object :configurable t
                      :value (Object/freeze (js-object :family family :label label :completedObservations observations)))))
                  (catch ignored nil)))
              (throw error))
            (finally
              (try (js-call scope :close)
                (catch error (unless failed (throw error)))))))))
        (cond ((= family "empty-bindings") (run-empty check oracle runtime))
          ((= family "exceptions") (run-exceptions check oracle runtime))
          ((= family "catch-destructuring") (run-catch check oracle runtime))
          ((= family "builtins") (run-builtins check oracle runtime))
          ((= family "typeof") (run-typeof check oracle runtime))
          ((= family "array-text") (run-array-text check oracle runtime))
          ((= family "strings") (run-strings check oracle runtime))
          ((= family "callables") (run-callables check oracle runtime))
          ((= family "primitive-operators") (run-primitive check oracle runtime))
          ((= family "js-cons") (run-cons check oracle runtime))
          ((= family "json") (run-json check oracle runtime (or (get configuration :models) (loadOriginalRawLanguageModels configuration)))))
        (js-object :observations observations :groups groups :hostOnlyGroups (get plan :hostOnlyGroups)))))
  (defun finishOriginalFixtureObservation (configuration observations groups)
    (let* ((family (get configuration :family)) (portable observations) (excluded (js-array))
           (context (readOriginalCorpusExecutionContext (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT)))
           (directory (get context :directory)))
      (unless (and (js-call (js-array "javascript" "wasm" "native") :includes (get context :target))
                   (= (value-type (get context :sourceIdentity)) "object") (not (nullish? (get context :sourceIdentity)))
                   (> (js-length (Object/keys (get context :sourceIdentity))) 0)
                   (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (get configuration :originalHostSha256))
                   (= (value-type directory) "string") (> (js-length directory) 0)
                   (= (value-type groups) "object") (not (nullish? groups))
                   (js-call (Object/values groups) :every (lambda (count) (and (Number/isInteger count) (>= count 0)))))
        (throw (new globalThis.TypeError "original fixture receipt requires actual target source identity and integral group counts")))
      (unless (and (Number/isInteger observations) (> observations 0)
                   (= observations (+ (js-call (Object/values groups) :reduce (lambda (total count) (+ total count)) 0) (if (= family "primitive-operators") 8 0))))
        (throw (new globalThis.TypeError "original fixture complete observation count differs from actual compare calls")))
      (letfn ((exclude (label original-count count boundary)
        (unless (= (get groups label) original-count)
          (throw (new globalThis.TypeError (str "original fixture group count changed: " family "/" label))))
        (setq portable (- portable count))
        (js-call excluded :push (js-object :label label :actualOriginalCalls original-count
          :hostOnlyCalls count :boundary boundary))))
        (cond ((= family "catch-destructuring") (exclude "iterator destructuring" 5 1 "external Set iterator is not a zero-import source input"))
          ((= family "typeof")
            (exclude "typeof and captured member" 16 1 "arbitrary host function requires explicit interoperability")
            (exclude "existing predicates and imported paths" 16 1 "arbitrary host function requires explicit interoperability"))
          ((= family "js-cons") (exclude "js-cons spread" 11 2 "external Set and Map iterators require explicit interoperability"))
          ((= family "object-properties")
            (exclude "assign effects and partial mutation" 1 1 "host accessors require explicit interoperability")
            (exclude "own property key hook" 1 1 "host Symbol.toPrimitive callback requires explicit interoperability"))
          ((= family "array-construction") (exclude "Array.from" 7 1 "external iterator object requires explicit interoperability"))
          ((= family "primitive-operators")
            (exclude "source hooks and bigint" 1 0 "host valueOf callbacks are separate; the same group retains all raw BigInt checks"))
          ((= family "objects")
            (exclude "own order and prototypes" 1 0 "raw prototype identities replace host-view prototype reflection"))))
      (mkdirSync directory (js-object :recursive t))
      (writeFileSync (resolve directory "original-fixture-observations.json")
        (JSON/stringify (js-object :version 1 :family family :target (get context :target)
          :sourceIdentity (get context :sourceIdentity) :originalHostSha256 (get configuration :originalHostSha256)
          :completeOriginalObservations observations :portableObservations portable :groups groups :hostOnlyGroups excluded)))
      (js-call globalThis.console :log (JSON/stringify (js-object :observations portable)))))
  (export finishOriginalFixtureObservation originalRawLanguageFixturePlans loadOriginalRawLanguageModels runOriginalRawLanguageFixtureHost))
