(module tools.backends.release-cli
  (import "node:fs/promises" readFile writeFile mkdir cp realpath)
  (import "node:fs" existsSync)
  (import "node:path" resolve dirname join relative isAbsolute sep)
  (import "node:url" fileURLToPath)
  (import "node:util" parseArgs isDeepStrictEqual)
  (import "../build.mjs" root)
  (import "../compiler-cli-ground.mjs" runCompilerCLI)
  (import "../compiler-bootstrap.mjs" compilerFailure saveCompilerMetadata)
  (import "../compiler-build.mjs" independentCompilerProductIdentity)
  (import "../compiler-metadata.mjs" readCompilerMetadata)
  (import "./bootstrap-js-stages.mjs" bootstrapJsStages)
  (import "../stage3-targets.mjs" runStage3Targets authenticateStage3Targets)
  (defconst import-release-tool (js* "(specifier) => import(specifier)"))

  (defconst release-help
    "Eliscript JavaScript compiler bootstrap and final outputs\n\n  bootstrap --stage0-manifest FILE --output DIRECTORY\n  verify-bootstrap [--bootstrap-manifest FILE]\n  targets [--bootstrap-manifest FILE] [--corpus-records FILE] [--output DIRECTORY] [--native-target arm64-macos|arm64-linux] [--functional-runtime-profile small] [--resume-from PREVIOUS_DIRECTORY] [--retain-artifacts]\n  compile [--bootstrap-manifest FILE] --input SOURCE --target javascript|wasm|native --output PATH\n  compile [--bootstrap-manifest FILE] --project ENTRY --root DIRECTORY --target TARGET --output PATH\n  request [--bootstrap-manifest FILE] --request FILE [--output PATH]\n  package [--bootstrap-manifest FILE] --output DIRECTORY\n  prepare-release-package [--bootstrap-manifest FILE]\n\nEmacs generates JavaScript stage0. stage0 -> stage1 -> stage2 -> stage3 all run as JavaScript.\nOnly stage3 supplies the final javascript, wasm and native program outputs.\nThe stage2/stage3 fixed point is verified before a final compiler is used.\nFunctional small resources explicitly defer the original sequence capacity acceptance.\n")

  (defun release-default (value fallback) (if (undefined? value) fallback value))
  (defun release-type-error (message) (throw (new globalThis.TypeError message)))
  (defun release-native-target (value)
    (let ((resolved (release-default value
            (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos"))))
      (unless (js-call (js-array "arm64-macos" "arm64-linux") :includes resolved)
        (release-type-error "nativeTarget must be arm64-macos or arm64-linux"))
      resolved))
  (defun default-release-manifest ()
    (let ((bootstrap-path (resolve root "dist/bootstrap-release/bootstrap.json"))
          (release-path (resolve root "dist/stage3-release.json")))
      ;; A completed package preparation designates the public compiler.
      ;; An older build directory may coexist with that certified package;
      ;; explicit --bootstrap-manifest still selects it without substitution.
      (if (existsSync release-path) release-path bootstrap-path)))
  (defun release-manifest (values)
    (resolve (release-default (get values :bootstrap-manifest)
      (release-default (get (get globalThis.process :env) :ELISCRIPT_BOOTSTRAP_MANIFEST)
        (default-release-manifest)))))

  (defasync resolveReleaseCompiler (&optional options)
    (let ((settings (if (undefined? options) (js-object) options)))
      (unless (and settings (= (value-type settings) "object") (not (Array/isArray settings)))
        (release-type-error "final compiler options must be an object"))
      (await (authenticateStage3Targets
        (js-object :bootstrapManifestPath (release-default (get settings :bootstrapManifestPath)
          (release-manifest (js-object))) :stage3MetadataPath (get settings :stage3MetadataPath))))))

  (defun release-forward-arguments (arguments metadata-path)
    (let ((result (js-array)) (index 0) (artifact false))
      (while (< index (js-length arguments))
        (let ((value (aref arguments index)))
          (cond
            ((or (= value "--bootstrap-manifest") (= value "--host"))
             (setq index (1+ index)))
            ((or (js-call value :startsWith "--bootstrap-manifest=")
                 (js-call value :startsWith "--host=")) nil)
            (t
             (when (or (= value "--compiler-artifact")
                       (js-call value :startsWith "--compiler-artifact=")) (setq artifact t))
             (js-call result :push value))))
        (setq index (1+ index)))
      (unless artifact (js-call result :push "--compiler-artifact" metadata-path)) result))

  (defasync verify-release-bootstrap (values)
    ;; Read-only verification is deliberately independent of public runtime
    ;; preparation and compiler dispatch. The authenticator rereads and compares
    ;; every declared product byte and the original fixed-point receipt.
    (js-call (Object/keys values) :forEach (lambda (key)
      (unless (js-call (js-array "bootstrap-manifest" "json-errors") :includes key)
        (release-type-error (+ "verify-bootstrap does not accept " key)))))
    (let* ((certified (await (resolveReleaseCompiler
                        (js-object :bootstrapManifestPath (release-manifest values)))))
           (source (get certified :sourceIdentity)))
      (js-object :format "eliscript-bootstrap-verification" :version 1
        :scope "stage2-stage3-complete-products" :verification "identical"
        :bootstrapManifestPath (get certified :bootstrapManifestPath)
        :fileCount (get certified :fixedPointFileCount)
        :stage2 (js-object :stage 2 :metadataPath (get certified :stage2MetadataPath)
          :productSha256 (get (get certified :stage2ProductIdentity) :sha256))
        :stage3 (js-object :stage 3 :metadataPath (get certified :stage3MetadataPath)
          :productSha256 (get (get certified :productIdentity) :sha256))
        :sourceIdentity (js-object :entry (get source :entry) :encoding (get source :encoding)
          :sha256 (get source :sha256)))))

  (defconst prepared-runtime-support-files
    (js-array "runtime/array-text.mjs" "runtime/errors.mjs" "runtime/math.mjs"
      "runtime/number-radix.mjs" "runtime/prelude.mjs" "runtime/primitives.mjs"
      "runtime/unicode-case.mjs" "runtime/unicode-case-data.mjs"))

  (defconst prepared-compiler-modules
    (js-array "bootstrap/symbol.mjs" "bootstrap/syntax.mjs" "bootstrap/reader.mjs"
      "bootstrap/formatter.mjs" "bootstrap/expander.mjs" "bootstrap/transient-analysis.mjs"
      "bootstrap/analyzer.mjs" "bootstrap/ir.mjs" "bootstrap/lower.mjs"
      "bootstrap/source-map.mjs" "bootstrap/emitter.mjs" "bootstrap/project.mjs"
      "bootstrap/compiler.mjs"))

  (defasync require-prepared-runtime (certified &optional directory)
    (let* ((metadata-path (get certified :stage3MetadataPath))
           (metadata (await (readCompilerMetadata metadata-path)))
           (supports (js-call (get metadata :modules) :filter
             (lambda (record) (js-call prepared-runtime-support-files :includes (get record :id))))) (index 0))
      (while (< index (js-length supports))
        (let* ((support (aref supports index))
               (actual (await (readFile (resolve (dirname metadata-path) (get support :path)))))
               (prepared (await (readFile (resolve (if (nullish? directory) root directory) (get support :id))))))
          (unless (isDeepStrictEqual actual prepared)
            (release-type-error "prepare-release-package must install the final stage3 runtime before compiler execution")))
        (setq index (1+ index)))))

  ;; The single gate every formal measurement calls before timing. It accepts
  ;; only the prepared final stage3 package layout: the release receipt names
  ;; dist/compiler-artifact.json, every declared product is authenticated there,
  ;; the compiler module graph and runtime support set are complete, and the
  ;; root runtime capsules equal their certified bytes. Nothing is rebuilt.
  (defasync requirePreparedStage3 (&optional directory)
    (let* ((prepared-root (await (realpath (resolve (if (nullish? directory) root directory)))))
           (manifest (resolve prepared-root "dist/stage3-release.json")))
      (unless (existsSync manifest)
        (release-type-error
         "prepared stage3 required: dist/stage3-release.json is missing; run make prepare-release-package"))
      (let* ((certified (await (resolveReleaseCompiler (js-object :bootstrapManifestPath manifest))))
             (metadata-path (await (realpath (get certified :stage3MetadataPath))))
             (expected (resolve prepared-root "dist/compiler-artifact.json")))
        (unless (= (get certified :scope) "stage3-identity")
          (release-type-error "prepared stage3 required: the release receipt is not an accepted stage3 receipt"))
        (unless (= metadata-path expected)
          (release-type-error "prepared stage3 required: stage3 metadata must be dist/compiler-artifact.json"))
        (let* ((metadata (await (readCompilerMetadata metadata-path)))
               (declared
                 (new globalThis.Set
                   (js-call (get metadata :modules) :map (lambda (record) (get record :id))))))
          (js-call prepared-compiler-modules :forEach
            (lambda (id)
              (unless (js-call declared :has id)
                (release-type-error (+ "prepared stage3 is missing compiler module " id)))))
          (js-call prepared-runtime-support-files :forEach
            (lambda (id)
              (unless (js-call declared :has id)
                (release-type-error (+ "prepared stage3 is missing runtime support " id)))))
          ;; Authenticate the paths the benchmark will actually load, not a
          ;; second copy named by a module record elsewhere in the artifact.
          (let ((modules (get metadata :modules)) (index 0))
            (while (< index (js-length modules))
              (let ((record (aref modules index)))
                (when (or (js-call prepared-compiler-modules :includes (get record :id))
                          (js-call prepared-runtime-support-files :includes (get record :id)))
                  (unless (= (await (realpath (resolve (dirname metadata-path) (get record :path))))
                             (resolve prepared-root "dist" (get record :id)))
                    (release-type-error "prepared stage3 module path differs from the measured package layout"))))
              (setq index (1+ index)))))
        (await (require-prepared-runtime certified prepared-root))
        (js-object :scope (get certified :scope)
          :bootstrapManifestPath (get certified :bootstrapManifestPath)
          :stage3MetadataPath metadata-path
          :fixedPointFileCount (get certified :fixedPointFileCount)
          :sourceIdentity (get certified :sourceIdentity)
          :productIdentity (get certified :productIdentity)
          ;; Portable identity for retained reports; checkout paths never enter
          ;; the committed measurement, and current-source checks compare this
          ;; certificate with freshly authenticated final bytes.
          :reportIdentity (js-object :format "eliscript-prepared-stage3" :version 1
            :fixedPointFileCount (get certified :fixedPointFileCount)
            :sourceSha256 (get (get certified :sourceIdentity) :sha256)
            :productSha256 (get (get certified :productIdentity) :sha256))))))

  (defun assertPreparedBenchmarkSource (source certified)
    (unless (and (not (nullish? source)) (not (nullish? certified))
                 (not (nullish? (get certified :reportIdentity)))
                 (= (get (get certified :reportIdentity) :format) "eliscript-prepared-stage3")
                 (isDeepStrictEqual (get source :preparedCompiler) (get certified :reportIdentity)))
      (release-type-error "benchmark source does not match the authenticated prepared stage3 compiler"))
    (unless (Array/isArray (get source :files))
      (release-type-error "benchmark source must declare prepared runtime files"))
    (let ((declared (new globalThis.Set
                      (js-call (get source :files) :map
                        (lambda (entry) (if (= (value-type entry) "string") entry
                          (if (nullish? entry) undefined (get entry :file))))))))
      (js-call prepared-runtime-support-files :forEach (lambda (file)
        (unless (js-call declared :has file)
          (release-type-error (+ "benchmark source is missing prepared runtime " file))))))
    source)

  (defun release-write (io text)
    (if (and io (= (value-type (get io :write)) "function"))
      (js-call io :write text)
      (js-call (get globalThis.process :stdout) :write text)))

  (defun release-progress (event)
    ;; Only scalar progress is observed; a broken output pipe cannot replace
    ;; the compiler's result or original exception.
    (try
      (let ((record (js-object))
            (fields (js-array "phase" "stage" "generation" "target" "filename" "id" "index" "completed" "total"
                      "elapsedMs" "inputArchiveMs" "compilationMs" "archiveMs" "executionMs" "comparisonMs"))
            (index 0))
        (while (< index (js-length fields))
          (let* ((key (aref fields index)) (value (get event key)))
            (when (or (= (value-type value) "string") (= (value-type value) "number"))
              (put record key value)))
          (setq index (1+ index)))
        (js-call (get globalThis.process :stderr) :write (+ "eliscript release " (JSON/stringify record) "\n")))
      (catch ignored nil)))

  (defasync release-corpus-path (values output)
    (if (not (undefined? (get values :corpus-records))) (resolve (get values :corpus-records))
      (let* ((corpus (await (js-call (await (funcall import-release-tool "../compiler-matrix.mjs")) :loadCompilerMatrixCorpus (js-object :sourceRoot root))))
             (path (resolve output "original-corpus.json")))
        (await (mkdir output (js-object :recursive t)))
        (await (writeFile path (get corpus :recordsBytes))) path)))

  (defasync copy-if-different (source destination)
    (unless (= (resolve source) (resolve destination))
      (await (mkdir (dirname destination) (js-object :recursive t)))
      (await (cp source destination))))

  (defasync prepareReleasePackage (&optional options)
    (let* ((settings (if (undefined? options) (js-object) options))
           (certified (await (resolveReleaseCompiler settings)))
           (metadata-path (get certified :stage3MetadataPath))
           (metadata (await (readCompilerMetadata metadata-path)))
           (directory (dirname metadata-path)) (modules (get metadata :modules)) (index 0))
      (unless (and (= (get metadata :host) "javascript") (Array/isArray modules) (> (js-length modules) 0))
        (release-type-error "stage3 package requires the complete JavaScript module graph"))
      ;; Copy the actual final frontend modules into the established public
      ;; compiler paths. The full authenticated stage3 remains alongside them.
      (while (< index (js-length modules))
        (let* ((record (aref modules index)) (id (get record :id))
               (module-path (release-default (get record :path) id)))
          (unless (and (= (value-type id) "string") (= (value-type module-path) "string")
                       (not (isAbsolute id)) (not (js-call id :includes "\\"))
                       (not (js-call (js-call id :split "/") :includes "..")))
            (release-type-error "stage3 package contains an invalid module path"))
          (let* ((source (resolve directory module-path))
                 (part (relative directory source)) (destination (resolve root "dist" id)))
            (when (or (isAbsolute part) (= part "..") (js-call part :startsWith (+ ".." sep)))
              (release-type-error "stage3 package source escapes its artifact"))
            (await (copy-if-different source destination))
            (when (js-call (js-array "runtime/array-text.mjs" "runtime/errors.mjs" "runtime/math.mjs" "runtime/number-radix.mjs" "runtime/prelude.mjs" "runtime/primitives.mjs" "runtime/unicode-case.mjs" "runtime/unicode-case-data.mjs") :includes id)
              (await (copy-if-different source (resolve root id))))
            (when (= (value-type (get record :sourceMapPath)) "string")
              (await (copy-if-different (resolve directory (get record :sourceMapPath)) (+ destination ".map")))
              (when (js-call (js-array "runtime/array-text.mjs" "runtime/errors.mjs" "runtime/math.mjs" "runtime/number-radix.mjs" "runtime/prelude.mjs" "runtime/primitives.mjs" "runtime/unicode-case.mjs" "runtime/unicode-case-data.mjs") :includes id)
                (await (copy-if-different (resolve directory (get record :sourceMapPath))
                  (resolve root (+ id ".map"))))))))
        (setq index (1+ index)))
      (let ((runtime-rel (release-default (get metadata :runtimePath) "runtime.eli"))
            (literals (release-default (get metadata :literalSources) (js-array)))
            (lit-index 0))
        (await (copy-if-different (resolve directory "package.json") (resolve root "dist/package.json")))
        (await (copy-if-different (resolve directory runtime-rel) (resolve root "dist" runtime-rel)))
        (while (< lit-index (js-length literals))
          (let* ((item (aref literals lit-index))
                 (lit-path (get item :path)))
            (when (= (value-type lit-path) "string")
              (await (copy-if-different (resolve directory lit-path) (resolve root "dist" lit-path)))))
          (setq lit-index (1+ lit-index))))
      (unless (= (resolve directory) (resolve root "dist"))
        (let* ((all-files (get (get metadata :artifactIdentity) :files))
               (packaged-files (js-call all-files :filter
                 (lambda (entry) (not (js-call (get entry :path) :startsWith "ir/")))))
               (file-index 0))
          (while (< file-index (js-length packaged-files))
            (let ((rel-path (get (aref packaged-files file-index) :path)))
              (await (copy-if-different (resolve directory rel-path) (resolve root "dist" rel-path))))
            (setq file-index (1+ file-index)))
          (let* ((packaged-product-identity (independentCompilerProductIdentity
                   (js-object :host (get metadata :host) :nativeTarget (get metadata :nativeTarget)
                     :files packaged-files :descriptor (get metadata :descriptor) :typed (get metadata :typed))))
                 (packaged-metadata (Object/assign (js-object) metadata
                   (js-object :artifactIdentity (js-object :algorithm "sha256" :files packaged-files)
                     :productIdentity packaged-product-identity
                     :stage3FullProductIdentity (get metadata :productIdentity))))
                 (release-receipt (js-object
                   :format "eliscript-stage3-release" :version 1 :status "accepted"
                   :scope "stage2-stage3-complete-products" :verification "identical"
                   :metadataPath "compiler-artifact.json"
                   :fixedPointFileCount (get certified :fixedPointFileCount)
                   :formalSourceIdentity (get certified :sourceIdentity)
                   :artifactSourceIdentity (get metadata :sourceIdentity)
                   :stage2ProductIdentity (get certified :stage2ProductIdentity)
                   :stage3ProductIdentity (get certified :productIdentity)
                   :packagedProductIdentity packaged-product-identity)))
            (Reflect/deleteProperty packaged-metadata "frontendIR")
            (Reflect/deleteProperty packaged-metadata "literalIR")
            (await (saveCompilerMetadata (resolve root "dist/compiler-artifact.json") packaged-metadata))
            (await (saveCompilerMetadata (resolve root "dist/stage3-release.json") release-receipt)))))
      certified))

  (defasync runReleaseCLI (arguments &optional io)
    (unless (and (Array/isArray arguments)
                 (js-call arguments :every (lambda (value) (= (value-type value) "string"))))
      (release-type-error "compiler CLI requires an argument array"))
    (let* ((parsed (parseArgs (js-object :args arguments :allowPositionals t :strict t
              :options (js-object
                :help (js-object :type "boolean" :short "h")
                :json-errors (js-object :type "boolean")
                :host (js-object :type "string") :hosts (js-object :type "string")
                :seed (js-object :type "boolean") :profile (js-object :type "string")
                :stage0-manifest (js-object :type "string")
                :bootstrap-manifest (js-object :type "string")
                :compiler-artifact (js-object :type "string")
                :corpus-records (js-object :type "string")
                :resume-from (js-object :type "string")
                :retain-artifacts (js-object :type "boolean")
                :functional-runtime-profile (js-object :type "string")
                :output (js-object :type "string" :short "o")
                :input (js-object :type "string" :short "i")
                :project (js-object :type "string") :root (js-object :type "string")
                :target (js-object :type "string") :request (js-object :type "string")
                :runtime (js-object :type "string") :host-modules (js-object :type "string")
                :macro-capability (js-object :type "string" :multiple t)
                :macro-dependency (js-object :type "string" :multiple t)
                :source-map (js-object :type "boolean") :debug (js-object :type "boolean")
                :native-target (js-object :type "string") :native-format (js-object :type "string")))))
           (values (get parsed :values)) (positionals (get parsed :positionals))
           (command (aref positionals 0)))
      (if (get values :help) (release-write io release-help)
        (progn
      (when (or (get values :hosts)
                (and (not (undefined? (get values :host))) (/= (get values :host) "javascript")))
        (release-type-error "this release supports only a JavaScript compiler host"))
      (unless (= (js-length positionals) 1) (release-type-error "provide exactly one compiler command"))
      (when (and (not (undefined? (get values :resume-from))) (not (= command "targets")))
        (release-type-error "resume-from is supported only for targets"))
      (when (and (get values :retain-artifacts) (not (= command "targets")))
        (release-type-error "retain-artifacts is supported only for targets"))
      (unless (undefined? (get values :functional-runtime-profile))
        (unless (and (= command "targets") (= (get values :functional-runtime-profile) "small"))
          (release-type-error "functionalRuntimeProfile is supported only as targets --functional-runtime-profile small")))
      (when (js-call (js-array "compiler-grid" "matrix" "bootstrap-all" "build") :includes command)
        (release-type-error "cancelled compiler-host or grid command; use the JavaScript bootstrap"))
      (cond
        ((= command "verify-bootstrap")
         (let ((report (await (verify-release-bootstrap values))))
           (release-write io (+ (JSON/stringify report) "\n")) report))
        ((= command "bootstrap")
         (unless (and (get values :stage0-manifest) (get values :output))
           (release-type-error "bootstrap requires --stage0-manifest and --output"))
         (release-progress (js-object :phase "bootstrap-start"))
         (let ((result (await (bootstrapJsStages
                 (js-object :stage0ManifestPath (resolve (get values :stage0-manifest))
                   :sourceRoot (resolve (release-default (get values :root) root))
                   :outputRoot (resolve (get values :output)) :onStage release-progress)))))
           (release-write io (+ (get result :manifestPath) "\n")) result))
        ((= command "targets")
         (let ((native-target (release-native-target (get values :native-target))))
           (await (require-prepared-runtime (await (resolveReleaseCompiler
             (js-object :bootstrapManifestPath (release-manifest values)
               :stage3MetadataPath (get values :compiler-artifact))))))
           (unless (existsSync (resolve root "tools/backends/compiler-matrix.mjs"))
             (release-type-error "Full target acceptance requires an Eliscript source checkout"))
           (let* ((output (resolve (release-default (get values :output) (resolve root "dist/bootstrap-release/targets"))))
                  (corpus-path (await (release-corpus-path values output))))
             (release-progress (js-object :phase "targets-start"))
             (let ((result (await (runStage3Targets
                     (js-object :bootstrapManifestPath (release-manifest values)
                       :stage3MetadataPath (get values :compiler-artifact) :corpusRecordsPath corpus-path
                       :resumeFrom (get values :resume-from)
                       :retainArtifacts (= (get values :retain-artifacts) t)
                       :functionalRuntimeProfile (get values :functional-runtime-profile)
                       :outputRoot output :nativeTarget native-target
                       :onStage release-progress)))))
               (release-write io (+ (if (= (value-type result) "string") result
                 (release-default (get result :reportPath) (release-default (get result :manifestPath) "targets-complete"))) "\n")) result))))
        ((= command "prepare-release-package")
         (let ((result (await (prepareReleasePackage (js-object :bootstrapManifestPath (release-manifest values))))))
           (release-write io (+ (get result :stage3MetadataPath) "\n")) result))
        ((js-call (js-array "compile" "request" "package") :includes command)
         (let ((certified (await (resolveReleaseCompiler
                 (js-object :bootstrapManifestPath (release-manifest values)
                   :stage3MetadataPath (get values :compiler-artifact))))))
           (await (require-prepared-runtime certified))
           (await (runCompilerCLI (release-forward-arguments arguments (get certified :stage3MetadataPath))))))
        (t (release-type-error (+ "unsupported compiler command: " command))))))))

  (defun renderReleaseCLIError (error &optional options)
    (if (and options (get options :json))
      (JSON/stringify (js-object :format "eliscript-compiler-cli-error" :version 1 :error (compilerFailure error)))
      (let ((record (compilerFailure error)))
        (release-default (get record :stack) (JSON/stringify record nil 2)))))

  (when (and (aref (get globalThis.process :argv) 1)
             (= (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath (js* "import.meta.url"))))
    (js-call (runReleaseCLI (js-call (get globalThis.process :argv) :slice 2)) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write
          (+ (renderReleaseCLIError error (js-object :json
            (js-call (get globalThis.process :argv) :includes "--json-errors"))) "\n"))
        (put globalThis.process :exitCode 1))))
  (export runReleaseCLI resolveReleaseCompiler renderReleaseCLIError prepareReleasePackage
    requirePreparedStage3 assertPreparedBenchmarkSource))
