        (and (Object/hasOwn method "constructObject") (eq (aref method "constructObject") t))))
  (defun native-intrinsic-operation (context heap arguments count opcode &optional header)
    ;; Authenticate the actual function, rather than a property name. Borrowed
    ;; native methods keep their identities; replacements and host Proxies do
    ;; not qualify. Existing source algorithms own iteration, species and holes.
    (when (>= count (if (= opcode 9) 2 3))
      (let* ((checked (aref context "checked")) (tokens (aref context "nativeTokens"))
             (items (when header (get header :items)))
             (kinds (when header (get header :kinds)))
             (header-tokens (when header (get header :tokens)))
             (target (if items (aref items 1)
                       (if (and header (not (undefined? (get header :target))))
                         (get header :target)
                         (let ((tval (funcall checked "value-get" heap arguments 1)))
                           (when header (put header :target tval))
                           tval))))
             (target-kind (if kinds (aref kinds 1)
                            (if (and header (not (undefined? (get header :targetKind))))
                              (get header :targetKind)
                              (let ((tk (if (not (val64-singleton-p target)) (funcall checked "value-kind" heap target) 0)))
                                (when header (put header :targetKind tk))
                                tk)))))
        (when (and tokens (not (val64-singleton-p target)) (= target-kind 35))
          (let* ((token (if header-tokens (aref header-tokens 1)
                          (if (and header (not (undefined? (get header :targetToken))))
                            (get header :targetToken)
                            (let ((ttok (funcall checked "value-foreign-token" heap target)))
                              (when header (put header :targetToken ttok))
                              ttok))))
                 (method (js-call tokens :get token)))
            (when (and method (aref method "runtime"))
              (cond
                ((= (aref method "runtime") "value-reflect-builtin")
                  (when (and (= opcode 8) (>= (- count 3) (aref method "minimumArity")))
                    (let* ((value (if items (aref items 3) (funcall checked "value-get" heap arguments 3)))
                           (kind (if kinds (aref kinds 3) (if (not (val64-singleton-p value)) (funcall checked "value-kind" heap value) 0))))
                      ;; The original foreign path owns host Proxies and their
                      ;; native exception identities. Only represented source
                      ;; targets enter the existing owned Reflect algorithms.
                      (when (or (= kind 18) (ordinary-native-object-p context heap value kind))
                        (js-object :name (aref method "name") :arity (- count 3)
                          :runtime (aref method "runtime") :operation (aref method "operation"))))))
                ((= (aref method "runtime") "value-builtin-primitive")
                  (when (= opcode 8)
                    (js-object :name (aref method "name") :arity (if (> count 3) 1 0)
                      :value (if (> count 3) (if items (aref items 3) (funcall checked "value-get" heap arguments 3)) VAL64_UNDEFINED)
                      :runtime (aref method "runtime") :operation (aref method "operation"))))
                ((= (aref method "runtime") "value-array-construction")
                  (when (= opcode 8)
                    (let* ((receiver (if items (aref items 2) (funcall checked "value-get" heap arguments 2)))
                           (receiver-kind (if kinds (aref kinds 2) (if (not (val64-singleton-p receiver)) (funcall checked "value-kind" heap receiver) 0)))
                           (receiver-method (when (= receiver-kind 35)
                             (js-call tokens :get (if header-tokens (aref header-tokens 2)
                               (funcall checked "value-foreign-token" heap receiver)))))
                           (arity (- count 3)))
                      (when (or (val64-singleton-p receiver)
                                (and (/= receiver-kind 18) (/= receiver-kind 35))
                                (and receiver-method (= (aref receiver-method "operation") 75)))
                        (if (= (aref method "operation") 1)
                          (js-object :name (aref method "name") :arity arity
                            :runtime (aref method "runtime") :operation 1 :header header)
                          (when (>= arity 1)
                            (let* ((arg0 (if items (aref items 3) (funcall checked "value-get" heap arguments 3)))
                                   (arg0-kind (if kinds (aref kinds 3) (if (not (val64-singleton-p arg0)) (funcall checked "value-kind" heap arg0) 0)))
                                   (mapper (if (>= arity 2) (if items (aref items 4) (funcall checked "value-get" heap arguments 4)) VAL64_UNDEFINED))
                                   (mapper-kind (if (and (>= arity 2) kinds) (aref kinds 4)
                                                  (if (not (val64-singleton-p mapper)) (funcall checked "value-kind" heap mapper) 0))))
                              (when (and (not (val64-singleton-p arg0))
                                         (or (= arg0-kind 5) (= arg0-kind 14) (= arg0-kind 15) (= arg0-kind 16) (= arg0-kind 17)
                                             (ordinary-native-object-p context heap arg0 arg0-kind))
                                         (or (< arity 2) (= mapper VAL64_UNDEFINED) (= mapper-kind 18)))
                                (js-object :name (aref method "name") :arity arity
                                  :runtime (aref method "runtime") :operation 0 :header header)))))))))
                ((native-constructor-method-p method)
                (when (or (/= opcode 19) (= (if items (aref items 2) (funcall checked "value-get" heap arguments 2)) target))
                  (let* ((offset (if (= opcode 9) 2 3))
