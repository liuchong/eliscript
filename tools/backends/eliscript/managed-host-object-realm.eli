                 (or (= parent VAL64_NIL) (hostObjectDescriptorPrototypeClear)))
        (if (aref context "ordinaryDefinition")
          (= (funcall checked "value-source-ordinary-definition-p" heap definition 0) 1)
          (when (aref context "dataDefinition")
            (= (funcall checked "value-source-data-definition-p" heap definition) 1))))))

  (defun native-constructor-method-p (method)
