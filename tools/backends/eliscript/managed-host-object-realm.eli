                         (input-kind (if (and (> count offset) kinds) (aref kinds offset) (if (not (val64-singleton-p input)) (funcall checked "value-kind" heap input) 0))))
                    ;; Object's identity/nullish cases consume no source
                    ;; properties. Primitive boxing retains the host route;
                    ;; a different newTarget retains its allocation semantics.
                    (when (or (= (aref method "operation") 75) (= input VAL64_NIL) (= input VAL64_UNDEFINED)
                      (and (not (val64-singleton-p input)) (js-call (js-array 13 14 15 16 17 18 21 23 24 26 35 36)
                        :includes input-kind)))
                      (js-object :name (aref method "name") :arity (- count offset) :value target
                        :argumentOffset offset :nativeConstructor t :construct (if (= opcode 8) 0 1)
                        :runtime (aref method "runtime") :operation (aref method "operation") :header header)))))
                (t (when (= opcode 8)
                  (let* ((receiver (if items (aref items 2) (funcall checked "value-get" heap arguments 2)))
                         (receiver-kind (if kinds (aref kinds 2) (if (not (val64-singleton-p receiver)) (funcall checked "value-kind" heap receiver) 0))))
                    (when (and (not (val64-singleton-p receiver))
                      (= receiver-kind (if (= (aref method "runtime") "value-array-prototype-call") 14 17)))
                      (js-object :name (aref method "name") :arity (- count 3) :value receiver
