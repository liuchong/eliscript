  (defun native-object-operation (context heap arguments count &optional header)
    ;; Return a routing decision, not an ABI result (nil/false/zero are valid
    ;; results). Reading these raw tuples does not decode or publish a view.
    (let* ((checked (aref context "checked")) (tokens (aref context "nativeTokens"))
           (items (when header (get header :items)))
           (kinds (when header (get header :kinds)))
           (header-tokens (when header (get header :tokens)))
           (target (if (>= count 3)
                     (if items (aref items 1)
                       (if (and header (not (undefined? (get header :target))))
                         (get header :target)
                         (funcall checked "value-get" heap arguments 1)))
                     VAL64_NIL))
           (target-kind (if (>= count 3)
                          (if kinds (aref kinds 1)
                            (if (and header (not (undefined? (get header :targetKind))))
                              (get header :targetKind)
                              (if (not (val64-singleton-p target)) (funcall checked "value-kind" heap target) 0)))
                          0)))
      (when (and tokens (not (val64-singleton-p target)) (= target-kind 35))
        (let* ((token (if header-tokens (aref header-tokens 1)
                        (if (and header (not (undefined? (get header :targetToken))))
                          (get header :targetToken)
                          (funcall checked "value-foreign-token" heap target))))
               (method (js-call tokens :get token)))
          (when (and method (not (aref method "runtime")))
            (let ((name (aref method "name")))
              (cond
                ((= name "is")
                  (when (and (= count 5) (aref context "objectIs"))
                    (js-object :name name :arity 2 :value VAL64_NIL)))
                ((= name "assign")
                  (when (>= count 4)
                    (let* ((value (if items (aref items 3) (funcall checked "value-get" heap arguments 3)))
                           (kind (if kinds (aref kinds 3) (if (not (val64-singleton-p value)) (funcall checked "value-kind" heap value) 0))))
                      (when (and (not (val64-singleton-p value)) (ordinary-native-object-p context heap value kind))
                        (let ((idx 4) (ok t))
                          (while (and ok (< idx count))
                            (let* ((src (if items (aref items idx) (funcall checked "value-get" heap arguments idx)))
                                   (skind (if kinds (aref kinds idx) (if (not (val64-singleton-p src)) (funcall checked "value-kind" heap src) 0))))
                              (unless (or (= src VAL64_NIL) (= src VAL64_UNDEFINED) (= skind 5)
                                          (and (not (val64-singleton-p src)) (ordinary-native-object-p context heap src skind)))
                                (setq ok false)))
                            (setq idx (1+ idx)))
                          (when ok
                            (js-object :name name :arity (- count 3) :value value)))))))
                ((= name "fromEntries")
                  (when (= count 4)
                    (let* ((value (if items (aref items 3) (funcall checked "value-get" heap arguments 3)))
                           (kind (if kinds (aref kinds 3) (if (not (val64-singleton-p value)) (funcall checked "value-kind" heap value) 0))))
                      (when (and (not (val64-singleton-p value)) (or (= kind 14) (= kind 15) (= kind 16) (= kind 17)))
                        (js-object :name name :arity 1 :value value)))))
                ((and (or (= name "getOwnPropertyNames") (= name "getOwnPropertySymbols"))
                      (not (aref context "sourceOwnKeys")))
                  nil)
                (t
                  (let* ((arity (if (or (= name "hasOwn") (= name "getOwnPropertyDescriptor")
                                        (= name "defineProperties") (= name "setPrototypeOf")) 2
                                  (if (= name "defineProperty") 3 1)))
                         (value (if (= count (+ arity 3)) (if items (aref items 3) (funcall checked "value-get" heap arguments 3)) VAL64_NIL))
                         (kind (if (and (= count (+ arity 3)) kinds) (aref kinds 3) (if (not (val64-singleton-p value)) (funcall checked "value-kind" heap value) 0))))
                    ;; Foreign targets include actual host Proxies. They and every
                    ;; unsupported shape retain the unchanged host implementation.
                    (when (and (= count (+ arity 3))
                               (if (= name "create")
                                 (or (= value VAL64_NIL) (and (= kind 13) (ordinary-native-object-p context heap value kind)))
                                 (or (ordinary-native-object-p context heap value kind) (= kind 18))))
                      (let* ((key (if (> arity 1) (if items (aref items 4) (funcall checked "value-get" heap arguments 4)) VAL64_UNDEFINED))
                             (key-kind (if (and (> arity 1) kinds) (aref kinds 4) (if (not (val64-singleton-p key)) (funcall checked "value-kind" heap key) 0)))
                             (definition (if (= arity 3) (if items (aref items 5) (funcall checked "value-get" heap arguments 5)) VAL64_UNDEFINED))
                             (def-kind (if (and (= arity 3) kinds) (aref kinds 5) (if (not (val64-singleton-p definition)) (funcall checked "value-kind" heap definition) 0))))
                        ;; Object-valued keys may invoke arbitrary host coercion.
                        ;; Keep their original evaluation/first-error path intact.
                        (when (and (cond
                                     ((= name "defineProperties")
                                       (and (not (val64-singleton-p key)) (ordinary-native-object-p context heap key key-kind)))
                                     ((= name "setPrototypeOf")
                                       (or (= key VAL64_NIL) (and (not (val64-singleton-p key)) (or (ordinary-native-object-p context heap key key-kind) (= key-kind 18)))))
                                     (t
                                       (or (= arity 1) (val64-singleton-p key) (= key-kind 4) (= key-kind 5) (= key-kind 22) (= key-kind 34))))
                                   (or (/= arity 3) (and (not (val64-singleton-p definition))
                                     (= def-kind 13)
                                     (ordinary-native-object-p context heap definition 13)
                                     (native-data-definition-p context heap value key definition))))
                          (js-object :name name :arity arity :value value)))))))))))))

  (defun call-native-object-operation (context heap arguments operation)
    (let ((raw (aref context "raw")) (checked (aref context "checked"))
          (arity (aref operation "arity"))
          (offset (let ((v (aref operation "argumentOffset"))) (if (undefined? v) 3 v)))
          (header (aref operation "header"))
          (frame VAL64_NIL) (result VAL64_NIL) (status 0) (source-class 0) (handled false))
      (when (and (Object/hasOwn operation "nativeConstructor") (eq (aref operation "nativeConstructor") t)
                 (= (aref operation "operation") 75)
                 (eq (get (readHostArrayConstructor) :prototype) (readHostArrayPrototype)))
        (cond
          ((= arity 0)
            (setq handled t)
            (setq result (if (and header (eq (get header :fastOpOk) t))
              (js-object :fastOp "array-new" :length 0)
              (funcall raw "value-array-new" heap 0))))
          ((= arity 1)
            (let* ((items (when header (get header :items)))
                   (kinds (when header (get header :kinds)))
                   (numbers (when header (get header :numbers)))
                   (arg0 (if items (aref items offset) (funcall checked "value-get" heap arguments offset)))
                   (arg0-kind (if kinds (aref kinds offset) (if (not (val64-singleton-p arg0)) (funcall checked "value-kind" heap arg0) 0))))
              (when (= arg0-kind 4)
                (let ((n (if numbers (aref numbers offset)
                           (bits64-u64-to-f64 (funcall checked "value-number-bits" heap arg0)))))
                  (when (and (Number/isInteger n) (>= n 0) (<= n 67108854))
                    (setq handled t)
                    (setq result (if (and header (eq (get header :fastOpOk) t))
                      (js-object :fastOp "array-new" :length n)
                      (funcall raw "value-array-new" heap n))))))))))
      (unless handled
        (try
          (progn
            (setq frame (funcall checked "frame-new" heap 1))
            (let ((tuple (funcall checked "value-refs" heap 7 arity)) (index 0))
              (funcall checked "frame-set" heap frame 0 tuple)
              (while (< index arity)
                (funcall checked "value-set" heap tuple index (funcall checked "value-get" heap arguments (+ index offset)))
                (setq index (1+ index)))
              ;; These are the same public raw implementations used by an owned
              ;; zero-import Object builtin. No source value crosses the host
              ;; codec solely because the real native intrinsic consumed it.
              (setq result (cond
                ((and (Object/hasOwn operation "nativeConstructor") (eq (aref operation "nativeConstructor") t))
                  (funcall raw "value-native-constructor-call" heap (aref operation "value") tuple arity
                    (aref operation "operation") (aref operation "construct")))
                ((= (aref operation "runtime") "value-builtin-primitive")
                  (funcall raw "value-builtin-primitive" heap (aref operation "value") arity (aref operation "operation")))
                ((= (aref operation "runtime") "value-reflect-builtin")
                  (funcall raw "value-reflect-builtin" heap tuple arity (aref operation "operation")))
                ((= (aref operation "runtime") "value-array-construction")
                  (funcall raw "value-array-construction" heap tuple arity (aref operation "operation")))
                ((aref operation "runtime")
                  (funcall raw (aref operation "runtime") heap (aref operation "value") tuple arity (aref operation "operation")))
                ((= (aref operation "name") "is")
                  (funcall raw "value-object-is" heap (funcall checked "value-get" heap tuple 0) (funcall checked "value-get" heap tuple 1)))
                ((= (aref operation "name") "keys")
                  (funcall raw "value-object-properties" heap tuple arity 0))
                ((= (aref operation "name") "values")
                  (funcall raw "value-object-properties" heap tuple arity 3))
                ((= (aref operation "name") "entries")
                  (funcall raw "value-object-properties" heap tuple arity 4))
                ((= (aref operation "name") "assign")
                  (funcall raw "value-object-properties" heap tuple arity 2))
                ((= (aref operation "name") "getOwnPropertyNames")
                  (funcall raw "value-source-own-keys" heap (aref operation "value") 1))
                ((= (aref operation "name") "getOwnPropertySymbols")
                  (funcall raw "value-source-own-keys" heap (aref operation "value") 2))
                ((= (aref operation "name") "setPrototypeOf")
                  (funcall raw "value-object-meta-builtin" heap tuple arity 3))
                ((= (aref operation "name") "preventExtensions")
                  (funcall raw "value-object-meta-builtin" heap tuple arity 4))
                ((= (aref operation "name") "isExtensible")
                  (funcall raw "value-object-meta-builtin" heap tuple arity 5))
                ((= (aref operation "name") "fromEntries")
                  (funcall raw "value-object-meta-builtin" heap tuple arity 6))
                ((= (aref operation "name") "getOwnPropertyDescriptors")
                  (funcall raw "value-object-meta-builtin" heap tuple arity 7))
                ((= (aref operation "name") "seal")
                  (funcall raw "value-object-meta-builtin" heap tuple arity 8))
                ((= (aref operation "name") "isSealed")
                  (funcall raw "value-object-meta-builtin" heap tuple arity 9))
                ((= (aref operation "name") "create")
                  ;; A null or owned ordinary prototype starts an owned object
                  ;; with that exact source chain. Creating a foreign host object
                  ;; instead would leave a source WeakMap's foreign iterator key
                  ;; unrooted between native iterator callbacks. Actual foreign
                  ;; prototypes and two-argument Create retain their host route.
                  (funcall raw "value-object-new" heap (aref operation "value")))
                ((= (aref operation "name") "getPrototypeOf")
                  ;; The native intrinsic observes the source object itself.
                  ;; Decoding a persistent value first would substitute its host
                  ;; materializer prototype for the registered source prototype.
                  (funcall raw "value-object-reflection" heap tuple arity 0))
                ((= (aref operation "name") "getOwnPropertyDescriptor")
                  ;; Read the source descriptor before a transport predicate can
                  ;; publish its target as an ordinary host view. This raw ABI
                  ;; retains descriptor presence and original value/accessor
                  ;; identities without decoding the object being inspected.
                  (funcall raw "value-object-reflection" heap tuple arity 2))
                ((= (aref operation "name") "freeze")
                  (funcall raw "value-object-integrity" heap (aref operation "value") 0))
                ((= (aref operation "name") "isFrozen")
                  ;; Observe the source descriptors before a literal predicate
                  ;; finishes branding; decoding here would publish an ordinary
                  ;; view during that same predicate's automatic brand probe.
                  (funcall raw "value-object-integrity" heap (aref operation "value") 1))
                ((= (aref operation "name") "hasOwn")
                  (funcall raw "value-object-properties" heap tuple arity 1))
                ((= (aref operation "name") "defineProperties")
                  ;; The existing raw algorithm collects and normalizes every
                  ;; descriptor before applying any of them, including accessors
                  ;; and their first source throw. No constructor is decoded
                  ;; merely to prepare its own declaration before branding.
                  (funcall raw "value-object-meta-builtin" heap tuple arity 1))
                (t (funcall raw "value-object-meta-builtin" heap tuple arity 0))))))
          (finally
            (setq status (funcall raw "last-error") source-class (funcall raw "value-exception-class" heap))
            (when (/= frame VAL64_NIL) (funcall raw "frame-pop" heap frame))
            (funcall raw "value-exception-class-set" heap source-class)
            (funcall raw "value-error-restore" status)))) result))

  (defun native-runtime-intrinsic-tag (context method)
    ;; These records come only from the existing native identity authenticator.
    ;; Source property names and user brands never grant a tag.
    (let ((runtime (get method :runtime)) (operation (get method :operation))
          (extended (funcall globalThis.Boolean (get context :ordinaryDefinition))))
      (cond
        ((and extended (= runtime "value-native-constructor-call") (= operation 75)) 75)
        ((and (= runtime "value-native-constructor-call") (= operation 76)
              (Object/hasOwn method "constructObject") (eq (get method :constructObject) t)) 76)
        ((and (= runtime "value-builtin-primitive") (= operation 5)) 5)
        ((and extended (= runtime "value-array-construction") (or (= operation 0) (= operation 1))) (+ operation 19))
        ((and (= runtime "value-reflect-builtin") (>= operation 0) (<= operation 12)) (+ operation 181))
        ((and (= runtime "value-array-prototype-call")
              (>= operation 200) (<= operation 227)) operation)
        ((and (= runtime "value-collection-prototype-iterator-builtin") (= operation 328)) 328)
        ((not runtime)
          (let ((name (get method :name)))
            (cond
              ((= name "freeze") 401) ((= name "isFrozen") 402)
              ((= name "create") 403) ((= name "getPrototypeOf") 404)
              ((= name "getOwnPropertyDescriptor") 405) ((= name "hasOwn") 406)
              ((= name "defineProperties") 407)
              ((not extended) 0)
              ((= name "defineProperty") 400) ((= name "keys") 408)
              ((= name "values") 409) ((= name "entries") 410)
              ((= name "is") 411) ((= name "assign") 412)
              ((= name "setPrototypeOf") 413) ((= name "getOwnPropertyNames") 414)
              ((= name "getOwnPropertySymbols") 415) ((= name "preventExtensions") 416)
              ((= name "isExtensible") 417) ((= name "fromEntries") 418)
              ((= name "getOwnPropertyDescriptors") 419) ((= name "seal") 420)
              ((= name "isSealed") 421) (t 0))))
        (t 0))))

  (defun register-native-object-operations (context lifecycle)
    (let ((checked (get context :checked))
          (raw (get context :raw)) (owner (get context :owner))
          (extended (funcall globalThis.Boolean (get context :ordinaryDefinition)))
          (methodByFn (new globalThis.WeakMap)) (registered (new globalThis.Set))
          (tokens (new globalThis.Map)) (released false))
      (put context :nativeTokens tokens)
      ;; Authenticate native intrinsics lazily when the host codec first encodes
      ;; a foreign callable, rather than pre-pinning dozens of unused WASM handles
      ;; on every runtime instance.
      (js-call (js-call (js-call (readHostObjectIntrinsics) :concat (readHostArrayIntrinsics) (readHostReflectIntrinsics))
        :filter (lambda (method)
          (and method
               (cond
                 ((not (get method :runtime))
                  (let ((name (get method :name)))
                    (cond
                      ((js-call (js-array "defineProperty" "freeze" "isFrozen" "create"
                                          "getPrototypeOf" "getOwnPropertyDescriptor" "hasOwn" "defineProperties")
                         :includes name) t)
                      ((= name "is") (get context :objectIs))
                      ((or (= name "getOwnPropertyNames") (= name "getOwnPropertySymbols"))
                       (get context :sourceOwnKeys))
                      ((or (= name "values") (= name "entries")) extended)
                      (t t))))
                 ((native-constructor-method-p method) (get context :nativeConstructor))
                 ((= (get method :runtime) "value-builtin-primitive") (get context :primitivePredicate))
                 ((= (get method :runtime) "value-array-construction") (get context :arrayConstruction))
                 ((= (get method :runtime) "value-reflect-builtin") (get context :reflectBuiltin))
                 ((= (get method :runtime) "value-array-prototype-call") (get context :arraySlice))
                 (t (get context :arrayIterator))))))
        :forEach (lambda (method)
          (js-call methodByFn :set (get method :method) method)))
      (put lifecycle :onForeignFunction (lambda (fn token functionRaw)
        (when (not released)
          (let ((method (js-call methodByFn :get fn)))
            (when method
              (when (and (Number/isInteger token) (> token 0))
                (js-call tokens :set token method))
              (when (and (val64-dynamic-p functionRaw)
                         (not (js-call registered :has functionRaw)))
                (let ((operation (native-runtime-intrinsic-tag context method)))
                  (when (and (/= operation 0) (get context :foreignIntrinsic))
                    (js-call registered :add functionRaw)
                    (funcall checked "value-foreign-intrinsic-register" owner functionRaw operation)))))))))
      (let ((dispose (get lifecycle :dispose)))
        (put lifecycle :dispose (lambda ()
          (let ((status (funcall raw "last-error")) (source-class (funcall raw "value-exception-class" owner))
                (failure undefined) (failed false))
            (unless released
              (setq released t)
              ;; Revoke any still-live foreign callable handles before closing
              ;; the capability so an escaped handle keeps no internal route.
              (js-call registered :forEach (lambda (function)
                (try
                  (if (= (funcall raw "value-kind" owner function) 35)
                    (funcall checked "value-foreign-intrinsic-register" owner function 0)
                    (progn
                      (funcall raw "value-exception-class-set" owner 0)
                      (funcall raw "value-error-restore" 0)))
                  (catch error (unless failed (setq failed t failure error))))))
              (js-call registered :clear)
              (js-call tokens :clear))
            (funcall raw "value-exception-class-set" owner source-class)
            (funcall raw "value-error-restore" status)
            (Reflect/apply dispose lifecycle (js-array))
            (when failed (throw failure))))))))

  (defun dispatch-host-object-identity (context handler name heap arguments &optional supplied)
    (if (not (and (= name "source-operation") (= heap (aref context "owner"))))
      (funcall handler name heap arguments)
      (let ((raw (aref context "raw")) (checked (aref context "checked")))
        (if (and (not supplied) (/= (funcall raw "last-error") 0)) VAL64_NIL
          (let* ((kind (if supplied 7 (funcall checked "value-kind" heap arguments)))
                 (count (if supplied (get supplied :count) (if (= kind 7) (funcall checked "value-length" heap arguments) 0)))
                 (opcode (if supplied (get supplied :opcode) (if (> count 0) (funcall checked "value-get" heap arguments 0) VAL64_NIL)))
                 (operation (if supplied (get supplied :opcodeNumber)
                   (if (and (not (val64-singleton-p opcode)) (= (funcall checked "value-kind" heap opcode) 4))
                     (bits64-u64-to-f64 (funcall checked "value-number-bits" heap opcode)) -1)))
                 (header (or supplied (when (= kind 7) (js-object :count count :opcode opcode :opcodeNumber operation)))))
            (if (/= operation 35)
              (let ((htokens (when header (get header :tokens)))
                    (hkinds (when header (get header :kinds)))
                    (nt (aref context "nativeTokens")))
                (if (and nt (or (= operation 8) (= operation 9) (= operation 19)))
                  (let ((skip (and htokens hkinds
                                   (or (/= (aref hkinds 1) 35)
                                       (not (js-call nt :has (aref htokens 1)))))))
                    (if skip
                      (funcall handler name heap arguments header)
                      (let ((native (or (native-intrinsic-operation context heap arguments count operation header)
                                        (when (= operation 8) (native-object-operation context heap arguments count header)))))
                        (if native (call-native-object-operation context heap arguments native)
                          (if header (funcall handler name heap arguments header)
                            (funcall handler name heap arguments))))))
                  (if header (funcall handler name heap arguments header)
                    (funcall handler name heap arguments))))
              (progn
                (unless (and (= kind 7) (= count 2)) (failManagedRuntime 3))
                (let* ((member (funcall checked "value-get" heap arguments 1))
                       (runtime (aref context "runtime"))
                       (frame undefined) (callee undefined) (result VAL64_NIL) (primary false)
                       (status 0) (source-class 0) (cleanup undefined) (cleanup-failed false))
                  (unless (and (not (undefined? runtime))
                               (or (= member VAL64_NIL) (= member VAL64_FALSE) (= member VAL64_TRUE) (= member VAL64_UNDEFINED)))
                    (failManagedRuntime 3))
                  (try
                    (progn
                      (setq frame (js-call runtime :frame 3))
                      (let ((frame-id (funcall checked "frame-current" heap)))
                        (setq callee (js-call runtime :fromHostValue
                          (cond ((= member VAL64_NIL) readHostObjectPrototype) ((= member VAL64_FALSE) readHostObjectConstructor)
                            ((= member VAL64_TRUE) readHostArrayPrototype) (t readHostArrayConstructor))))
                        (js-call runtime :frameSet frame 0 callee)
                        (let ((tuple (funcall checked "value-refs" heap 7 3)))
                          (funcall checked "frame-set" heap frame-id 1 tuple)
                          (let ((number (js-call runtime :number 8)))
                            (try
                              (js-call runtime :frameSet frame 2 number)
                              (funcall checked "value-set" heap tuple 0 (funcall checked "frame-get" heap frame-id 2))
                              (finally (js-call runtime :release number))))
                          (funcall checked "value-set" heap tuple 1 (funcall checked "frame-get" heap frame-id 0))
                          (funcall checked "value-set" heap tuple 2 VAL64_UNDEFINED)
                          ;; The unchanged Call capability encodes the actual
                          ;; host intrinsic in this owner's foreign registry.
                          (setq result (if (and supplied (get supplied :pendingForeign))
                                         (funcall handler name heap tuple (js-object :untupled t :pendingForeign (get supplied :pendingForeign)))
                                         (funcall handler name heap tuple))))))
                    (catch error (setq primary t) (throw error))
                    (finally
                      (setq status (funcall raw "last-error")
                        source-class (if (/= status 0) (funcall raw "value-exception-class" heap) 0))
                      (js-call (js-array
                        (lambda () (unless (undefined? callee) (js-call runtime :release callee)))
                        (lambda () (unless (undefined? frame) (js-call runtime :leaveFrame frame))))
                        :forEach (lambda (action)
                          (try (funcall action)
                            (catch error (unless cleanup-failed (setq cleanup-failed t cleanup error))))))
                      (funcall raw "value-exception-class-set" heap source-class)
                      (funcall raw "value-error-restore" status)
                      (when (and cleanup-failed (not primary) (= status 0)) (throw cleanup))))
                  result))))))))

  (defun createManagedHostObjectRealmRuntime (creator exports descriptor memory tail completions)
    (let* ((descriptors (Object/getOwnPropertyDescriptors exports))
           (enabled (data-function descriptors "host-object-identity-enabled"))
           (required (js-array "heap-new" "last-error" "value-error-restore" "value-exception-class"
             "value-exception-class-set" "value-kind" "value-get" "value-length" "value-data"
             "value-refs" "value-set" "frame-current" "frame-get" "frame-set"))
           (options (if (> (js-length tail) 0) (aref tail 0) undefined))
           (lifecycle (if (> (js-length tail) 1) (aref tail 1) undefined))
           (locals (when (and lifecycle (= (value-type lifecycle) "object"))
             (Object/getOwnPropertyDescriptors lifecycle)))
           (bridge-entry (when locals (get locals :capabilityBridge)))
           (bridge (when (and bridge-entry (Object/hasOwn bridge-entry "value")) (get bridge-entry :value)))
           (bridge-descriptors (when bridge (Object/getOwnPropertyDescriptors bridge)))
           (attach (when bridge-descriptors (data-function bridge-descriptors "attach"))))
      (if (not (and enabled (= (funcall enabled) 1) attach (not (eq options nil))
             descriptor (Array/isArray (get descriptor :hostCapabilities))
             (js-call (get descriptor :hostCapabilities) :some (lambda (item)
               (and (= (get item :module) "eliscript.host") (= (get item :name) "source-operation")
                 (= (get item :arity) 2) (= (get item :abi) "managed-host-call"))))
             (js-call required :every (lambda (name) (data-function descriptors name)))))
        (Reflect/apply creator undefined (js-call (js-array exports descriptor memory) :concat tail))
        (let* ((forwarded (Array/from tail))
               (original-options (if (undefined? options) (js-object) (funcall globalThis.Object options)))
               (receiver (if (undefined? options) original-options options))
               (option-descriptors (Object/getOwnPropertyDescriptors original-options))
               (initialize t) (runtime undefined)
               (functions (let ((table (Object/create nil)))
                 (js-call (Object/keys descriptors) :forEach (lambda (name)
                   (let ((fn (data-function descriptors name)))
                     (when fn (put table name fn)))))
                 table))
               (last-error-fn (aref functions "last-error"))
               (exception-class-fn (aref functions "value-exception-class"))
               (context (js-object :owner 0 :runtime undefined :memory memory
                         :dataDefinition (aref functions "value-source-data-definition-p")
                         :ordinaryDefinition (aref functions "value-source-ordinary-definition-p")
                         :objectIs (aref functions "value-object-is")
                         :sourceOwnKeys (aref functions "value-source-own-keys")
                         :arrayConstruction (aref functions "value-array-construction")
                         :foreignIntrinsic (aref functions "value-foreign-intrinsic-register")
                         :nativeConstructor (aref functions "value-native-constructor-call")
                         :primitivePredicate (aref functions "value-builtin-primitive")
                         :reflectBuiltin (aref functions "value-reflect-builtin")
                         :arraySlice (aref functions "value-array-prototype-call")
                         :arrayIterator (aref functions "value-collection-prototype-iterator-builtin")))
               (signatures (managedExportSignatures descriptor))
               (raw (lambda (name &rest arguments)
                 (invokeManagedABIExport functions signatures name arguments)))
               (checked (lambda (name &rest arguments)
                 (let* ((value (Reflect/apply raw undefined (js-call (js-array name) :concat arguments)))
                        (code (funcall raw "last-error")))
                   (when (/= code 0) (failManagedRuntime code (funcall raw "value-exception-class" (aref context "owner")))) value)))
               (new-heap (aref functions "heap-new")))
          (put context :raw raw) (put context :checked checked)
          ;; Preserve accessor receivers and the original destructuring order.
          ;; Invalid initialize values pass through to the original validator.
          (js-call (Reflect/ownKeys option-descriptors) :forEach (lambda (key)
            (let ((entry (get option-descriptors key)))
              (unless (Object/hasOwn entry "value")
                (let ((getter (get entry :get)) (setter (get entry :set)))
                  (when getter (put entry :get (lambda () (Reflect/apply getter receiver (js-array)))))
                  (when setter (put entry :set (lambda (value) (Reflect/apply setter receiver (js-array value))))))))))
          (put option-descriptors :initializeModule (js-object :configurable t :enumerable t
            :get (lambda ()
              (let ((value (Reflect/get original-options "initializeModule" receiver)))
                (setq initialize (if (undefined? value) t value))
                (if (or (undefined? value) (= (value-type value) "boolean")) false value)))))
          (put forwarded 0 (Object/create (Object/getPrototypeOf original-options) option-descriptors))
          (put (get bridge-descriptors :attach) :value (function-shape (lambda (handler)
            (Reflect/apply attach bridge (js-array (lambda (name heap arguments &rest extra)
              (dispatch-host-object-identity context handler name heap arguments (aref extra 0)))))) attach))
          (put bridge-entry :value (Object/create (Object/getPrototypeOf bridge) bridge-descriptors))
          ;; Every nesting layer forwards the final disposer installed by the
          ;; creator. Neither close ownership nor the actual project is cloned.
          (put locals :dispose (js-object :configurable t :enumerable t
            :get (lambda () (get lifecycle :dispose))
            :set (lambda (value) (put lifecycle :dispose value))))
          (put locals :onForeignFunction (js-object :configurable t :enumerable t
            :get (lambda () (get lifecycle :onForeignFunction))
            :set (lambda (value) (put lifecycle :onForeignFunction value))))
          (put forwarded 1 (Object/create (Object/getPrototypeOf lifecycle) locals))
          (put (get descriptors "heap-new") :value (function-shape (lambda (slots initial maximum)
            (let ((owner (Reflect/apply new-heap exports (js-array slots initial maximum))))
              (put context :owner owner) owner)) new-heap))
          (setq runtime (Reflect/apply creator undefined (js-call (js-array
            (Object/create (Object/getPrototypeOf exports) descriptors) descriptor memory) :concat forwarded)))
          (put context :runtime runtime)
          ;; Native Object operations belong to this authenticated host realm
          ;; even when the source program has no persistent literal library.
          (when (js-call (js-array "value-foreign-token" "value-object-new" "value-object-properties" "value-object-integrity"
                               "value-object-meta-builtin" "value-object-reflection" "frame-new" "frame-pop" "value-string" "value-unit-set"
                               "value-seal" "value-object-has" "value-source-own-descriptor"
                               "value-source-extensible" "value-standard-prototype-existing")
                       :every (lambda (name) (data-function descriptors name)))
            (register-native-object-operations context lifecycle))
          ;; Outer lifecycle/foreign/decode registrations finish first. This
          ;; runs the same initializer before the public factory returns.
          (when (and (= (get descriptor :abi) "managed-module") (eq initialize t))
            (js-call completions :push (lambda () (js-call runtime :initializeModule))))
          runtime))))
  (export createManagedHostObjectRealmRuntime))
