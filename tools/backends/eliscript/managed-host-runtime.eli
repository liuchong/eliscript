                            (let ((type (value-type target)))
                              (setq output (if (js-call (js-array "keyword" "symbol") :includes type) type undefined))))
                          ((= operation 38)
                            ;; A JS object can outlive its collected guest
                            ;; wrapper. Cache its assigned module token weakly
                            ;; by actual host identity, not that wrapper's raw.
                            (unless (and (not (nullish? target))
                              (js-call (js-array "object" "function") :includes (hostType target))
                              (Number/isSafeInteger key) (> key 3))
                              (throw (new globalThis.TypeError "invalid foreign identity owner")))
                            (let ((cache (js-call foreignIdentityCaches :get key)))
                              (if (undefined? value)
                                (setq output (if cache (js-call cache :get target) undefined))
                                (progn
                                  (unless (and (Number/isSafeInteger value) (> value 0))
                                    (throw (new globalThis.TypeError "invalid foreign identity token")))
                                  (unless cache
                                    (setq cache (new globalThis.WeakMap))
                                    (js-call foreignIdentityCaches :set key cache))
                                  (when (and (js-call cache :has target) (/= (js-call cache :get target) value))
                                    (throw (new globalThis.TypeError "foreign identity token changed")))
                                  (js-call cache :set target value) (setq output value)))))
                          ((= operation 37)
                            (let* ((provider (literalProvider)) (lookup (get provider :externalProtocolMethod)))
                              (setq output (if lookup (Reflect/apply lookup provider (js-array target key value)) undefined)))))))
                    (t (throw (new globalThis.TypeError "unknown managed host capability")))))))
                    (if skipHostCallback (funcall runCapability) (withHostCallback runCapability))))
                    (setq output inheritedResult rawOutput t))
                  (if rawOutput output (funcall encode output))))) t t)))))))
      (when (and moduleInfo initialize) (initializeModuleInstance))
      api
      )))
  (export createManagedHostRuntime createManagedSourceOperationObserver readManagedSourceOperationDiagnostics))
