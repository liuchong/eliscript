(module tools.backends.managed-runtime
  (import "./managed-host.mjs"
    createManagedHostRuntime createManagedHostCapabilityBridge failManagedRuntime validateManagedRuntimeOptions)
  (import "./managed-module-graph.mjs"
    createManagedModuleGraph createManagedProjectFacades loadManagedProjectGraph managedHostModuleEdges
    observeManagedProjectRuntime observeManagedProjectExports)
  (import "./compiler-debug.mjs" createCompilerDebugMap)
  (import "./managed-runtime-host-legacy.mjs" :as runtime-host)
  (import "./managed-host-proxy.mjs" prepareManagedHostProxyClassifier)

  (defasync loadManagedHostModules (descriptor &rest arguments)
    ;; Reuse the existing real asynchronous module importer for Bun hosts that
    ;; lack process.getBuiltinModule. The predicate is shared with runtimes
    ;; created synchronously before their first original host body is loaded.
    (await (prepareManagedHostProxyClassifier (get runtime-host :loadManagedHostModules)))
    (Reflect/apply (get runtime-host :loadManagedHostModules) undefined
      (js-call (js-array descriptor) :concat arguments)))

  (defconst runtime-allocator-records (new globalThis.WeakMap))

  (defun runtime-default (value fallback) (if (undefined? value) fallback value))
  (defun runtime-nullish (value fallback) (if (nullish? value) fallback value))
  (defun runtime-optional (value key) (if (nullish? value) undefined (get value key)))
  (defun runtime-truth (value) (funcall globalThis.Boolean value))
  (defun runtime-instance-p (value constructor)
    (js-call constructor (get globalThis.Symbol :hasInstance) value))

  (defun runtime-copy (target source)
    ;; CopyDataProperties, including symbols and own __proto__ data fields.
    (unless (nullish? source)
      (let* ((object (funcall globalThis.Object source)) (keys (Reflect/ownKeys object)) (index 0))
        (while (< index (js-length keys))
          (let* ((key (aref keys index)) (descriptor (Object/getOwnPropertyDescriptor object key)))
            (when (get descriptor :enumerable)
              (Object/defineProperty target key
                (js-object :value (get object key) :writable t :enumerable t :configurable t))))
          (setq index (1+ index))))) target)

  (defun runtime-options (arguments)
    (let* ((input (runtime-default (if (> (js-length arguments) 0) (aref arguments 0) undefined) (js-object)))
           (options (runtime-copy (js-object) input))
           (seed (validateManagedRuntimeOptions input)))
      (Object/defineProperty options "randomSeed"
        (js-object :value seed :writable t :enumerable t :configurable t))
      (let ((extended (get options :extendedHeap)))
        (unless (or (undefined? extended) (= extended false) (= extended t))
          (throw (new globalThis.TypeError "extendedHeap must be a boolean")))) options))

  (defun runtime-heap-exports (exports options record)
    (let ((constructor (get exports "heap-new")))
      (when (= (get options :extendedHeap) t)
        (setq constructor (get exports "heap-new-extended"))
        (unless (= (value-type constructor) "function")
          (throw (new globalThis.TypeError "managed runtime requires heap-new-extended for extendedHeap"))))
      (unless (= (value-type constructor) "function") (failManagedRuntime 3))
      (let* ((descriptors (Object/getOwnPropertyDescriptors exports))
             (legacy (get descriptors "heap-new"))
             (facade (Object/create (Object/getPrototypeOf exports))))
        (unless legacy (failManagedRuntime 3))
        (put legacy :value (lambda (slots initial maximum)
          (let ((heap (Reflect/apply constructor undefined (js-array slots initial maximum))))
            (put record :heap (uint32 heap)) heap)))
        (Object/defineProperties facade descriptors)
        (Object/freeze facade))))

  (defun allocator-invalid ()
    (throw (new globalThis.TypeError "unsupported or inconsistent managed allocator layout")))

  (defun allocator-word (view address)
    (unless (and (Number/isSafeInteger address) (>= address 0) (= (% address 4) 0)
                 (<= (+ address 4) (get view :byteLength))) (allocator-invalid))
    (js-call view :getUint32 address t))

  (defun readManagedAllocatorSnapshot (runtime)
    (let ((record (js-call runtime-allocator-records :get runtime)))
      (unless record (throw (new globalThis.TypeError "unknown managed runtime allocator instance")))
      (when (get record :closed)
        (throw (new globalThis.TypeError "managed runtime allocator snapshot is closed")))
      ;; No managed call, allocation, error reset, collection or pool copy.
      ;; Read a fresh view because reserve may have replaced the memory buffer.
      (let* ((view (js-call (get record :memory) :view)) (heap (get record :heap))
             (epoch (allocator-word view 4)))
        (unless (and (> heap 0) (= (allocator-word view heap) 3)
                     (= (allocator-word view (+ heap 4)) epoch)
                     (= (allocator-word view (+ heap 8)) 294)
                     (= (allocator-word view (+ heap 12)) 294)) (allocator-invalid))
        (let* ((control (allocator-word view (+ heap 16)))
               (_bounds (allocator-word view (+ control (* 293 4))))
               (pool (allocator-word view (+ control 4)))
               (max-slots (allocator-word view (+ control 8)))
               (high-water (allocator-word view (+ control 12)))
               (free-head (allocator-word view (+ control 16)))
               (used (allocator-word view (+ control 20)))
               (blocks (allocator-word view (+ control 24)))
               (live (allocator-word view (+ control 28)))
               (maximum (allocator-word view (+ control 32)))
               (tree (allocator-word view (+ control 132)))
               (free-tail (allocator-word view (+ control 1160)))
               (bits (allocator-word view (+ control 1164)))
               (mask (allocator-word view (+ control 1168)))
               (generation-max (allocator-word view (+ control 1172))))
          (unless (and (= (allocator-word view control) 1212498256)
                       (>= bits 20) (<= bits 23) (= mask (1- (Math/pow 2 bits)))
                       (= generation-max (1- (Math/pow 2 (- 32 bits))))
                       (> max-slots 0) (<= max-slots mask) (<= high-water max-slots)
                       (= (allocator-word view pool) 1) (= (allocator-word view (+ pool 4)) epoch))
            (allocator-invalid))
          (let* ((base (allocator-word view (+ pool 16))) (capacity (allocator-word view (+ pool 12)))
                 (table-bytes (* (1+ max-slots) 24))
                 (slot 1) (scanned-live 0) (reusable 0) (retired 0)
                 (chain-length 0) (last-free 0) (current free-head)
                 (free-bytes 0) (largest 0) (block-count 0) (previous-end table-bytes))
            (unless (and (>= used table-bytes) (<= used capacity) (<= capacity maximum)
                         (<= maximum 1073741824) (<= (+ base capacity) (get view :byteLength)))
              (allocator-invalid))
            (while (<= slot high-water)
              (let* ((entry (+ base (* slot 24))) (generation (allocator-word view entry))
                     (flags (allocator-word view (+ entry 4))))
                (unless (and (> generation 0) (<= generation generation-max)) (allocator-invalid))
                (if (/= (bit-and flags 1) 0) (setq scanned-live (1+ scanned-live))
                  (progn
                    (unless (= flags 0) (allocator-invalid))
                    (if (= generation generation-max) (setq retired (1+ retired))
                      (setq reusable (1+ reusable))))))
              (setq slot (1+ slot)))
            (unless (= scanned-live live) (allocator-invalid))
            ;; A repeated link implies a cycle; the independently scanned free
            ;; count bounds this walk without an extra set or slot-sized copy.
            (while (/= current 0)
              (unless (and (> current 0) (<= current high-water) (< chain-length reusable)) (allocator-invalid))
              (let ((entry (+ base (* current 24))))
                (unless (and (= (allocator-word view (+ entry 4)) 0)
                             (< (allocator-word view entry) generation-max)) (allocator-invalid))
                (setq last-free current)
                (setq current (allocator-word view (+ entry 20))))
              (setq chain-length (1+ chain-length)))
            (unless (and (= chain-length reusable) (= last-free free-tail)) (allocator-invalid))
            (setq current blocks)
            (while (/= current 0)
              (unless (and (>= current previous-end) (<= (+ current 32) used)
                           (= (% current 8) 0) (< block-count (Math/floor (/ (- used table-bytes) 32))))
                (allocator-invalid))
              (let* ((address (+ base current)) (size (allocator-word view address))
                     (next (allocator-word view (+ address 4))))
                (unless (and (>= size 32) (= (% size 8) 0) (<= (+ current size) used)
                             (or (= next 0) (> next current))) (allocator-invalid))
                (setq free-bytes (+ free-bytes size))
                (setq largest (Math/max largest size))
                (setq previous-end (+ current size)) (setq current next))
              (setq block-count (1+ block-count)))
            (unless (and (<= free-bytes (- used table-bytes))
                         (if (= tree 0) (= block-count 0)
                           (and (>= tree table-bytes) (<= (+ tree 32) used)
                             (= (allocator-word view (+ (+ base tree) 24)) largest)))) (allocator-invalid))
            (Object/freeze (js-object :format "eliscript-managed-allocator-snapshot" :version 1
              :maxSlots max-slots :highWater high-water :liveValues live
              :freeReusableSlots reusable :retiredSlots retired :neverAllocatedSlots (- max-slots high-water)
              :availableSlots (+ reusable (- max-slots high-water))
              :slotBits bits :slotMask mask :generationMax generation-max :slotTableBytes table-bytes
              :usedBytes used :capacityBytes capacity :maxBytes maximum
              :freeBytes free-bytes :largestFreeBlock largest :freeBlockCount block-count
              :tailCapacityBytes (- capacity used) :byteHeadroomBytes (- maximum used)
              :freeSlotsHead free-head :freeSlotsTail free-tail :freeTreeRoot tree
              :memoryByteLength (get view :byteLength) :rawCursorBytes (allocator-word view 0)
              :lastError (allocator-word view 8))))))))

  (defun allocator-detail-field (value key)
    (unless (and (not (nullish? value)) (= (value-type value) "object"))
      (throw (new globalThis.TypeError "invalid managed initialization diagnostic descriptor")))
    (let ((descriptor (Object/getOwnPropertyDescriptor value key)))
      (unless (and descriptor (Object/hasOwn descriptor "value"))
        (throw (new globalThis.TypeError "invalid managed initialization diagnostic descriptor")))
      (get descriptor :value)))
  (defun allocator-initialization-hint (descriptor)
    (let* ((module (allocator-detail-field descriptor "module"))
           (count (allocator-detail-field module "bindingCount"))
           (project (allocator-detail-field descriptor "project"))
           (bindings (allocator-detail-field project "preparedBindings")))
      (unless (and (Number/isInteger count) (>= count 0) (<= count 9586979)
                   (Array/isArray bindings) (<= (js-length bindings) count))
        (throw (new globalThis.TypeError "invalid managed initialization diagnostic descriptor")))
      (let ((names (js-array)) (seen (new globalThis.Set)) (position 0))
        (while (< position (js-length bindings))
          (let* ((item (allocator-detail-field bindings (funcall globalThis.String position)))
                 (index (allocator-detail-field item "index")) (name (allocator-detail-field item "name")))
            (unless (and (Number/isInteger index) (>= index 0) (< index count)
                         (= (value-type name) "string") (not (js-call seen :has index)))
              (throw (new globalThis.TypeError "invalid managed initialization diagnostic descriptor")))
            (js-call seen :add index)
            (js-call names :push (js-object :index index :name (js-call name :slice 0 256))))
          (setq position (1+ position)))
        (js-object :bindingCount count :prepared names))))
  (defun allocator-module-slab-p (view address count)
    (if (or (= count 0) (/= (allocator-word view (+ address 4)) (* count 7))) false
      (let ((index 0) (valid t))
        (while (and valid (< index count))
          (let* ((cell (+ address 32 (* index 28))) (mutable (allocator-word view (+ cell 4)))
                 (initialized (allocator-word view (+ cell 8))) (external (allocator-word view (+ cell 12))))
            (unless (and (= (allocator-word view cell) 2) (or (= mutable 1) (= mutable 2))
                         (or (= initialized 1) (= initialized 2)) (or (= external 1) (= external 2)))
              (setq valid false)))
          (setq index (1+ index))) valid)))
  (defun readManagedAllocatorValueCounts (runtime &rest arguments)
    ;; Explicit diagnostic detail only. Default snapshots retain their shape;
    ;; these fixed-size counts neither call nor allocate in the managed heap.
    (let* ((hint (when (and (> (js-length arguments) 0) (not (undefined? (aref arguments 0))))
                   (allocator-initialization-hint (aref arguments 0))))
           (snapshot (readManagedAllocatorSnapshot runtime))
           (record (js-call runtime-allocator-records :get runtime))
           (view (js-call (get record :memory) :view)) (heap (get record :heap))
           (control (allocator-word view (+ heap 16)))
           (pool (allocator-word view (+ control 4))) (base (allocator-word view (+ pool 16)))
           (high-water (get snapshot :highWater)) (mask (get snapshot :slotMask))
           (bits (get snapshot :slotBits))
           (live-kinds (js-call (new globalThis.Array 39) :fill 0))
           (pinned-kinds (js-call (new globalThis.Array 39) :fill 0))
           (frame-kinds (js-call (new globalThis.Array 39) :fill 0))
           (slot 1) (frames 0) (frame-slots 0) (frame (allocator-word view base))
           (slab-count 0) (slab-address 0))
      (while (<= slot high-water)
        (let* ((entry (+ base (* slot 24))) (flags (allocator-word view (+ entry 4))))
          (when (/= (bit-and flags 1) 0)
            (let* ((offset (allocator-word view (+ entry 8))) (kind (allocator-word view (+ base offset))))
              (unless (and (> kind 0) (< kind 39)) (allocator-invalid))
              (put live-kinds kind (1+ (aref live-kinds kind)))
              (when (> (allocator-word view (+ entry 16)) 0)
                (put pinned-kinds kind (1+ (aref pinned-kinds kind))))
              (when (and hint (= kind 8) (allocator-module-slab-p view (+ base offset) (get hint :bindingCount)))
                (setq slab-count (1+ slab-count) slab-address (+ base offset))))))
        (setq slot (1+ slot)))
      (while (/= frame 0)
        (let* ((index (bit-and frame mask)) (entry (+ base (* index 24)))
               (generation (Math/floor (/ frame (Math/pow 2 bits)))))
          (unless (and (> index 0) (<= index high-water) (< frames (get snapshot :liveValues))
                       (= (allocator-word view entry) generation)
                       (/= (bit-and (allocator-word view (+ entry 4)) 1) 0)) (allocator-invalid))
          (let* ((address (+ base (allocator-word view (+ entry 8))))
                 (length (allocator-word view (+ address 4))) (index 0))
            (unless (= (allocator-word view address) 9) (allocator-invalid))
            (setq frame-slots (+ frame-slots length))
            (while (< index length)
              (let ((child (allocator-word view (+ (+ address 32) (* index 4)))))
                (when (> child 3)
                  (let* ((child-index (bit-and child mask)) (child-entry (+ base (* child-index 24))))
                    (unless (and (> child-index 0) (<= child-index high-water)
                                 (= (allocator-word view child-entry) (Math/floor (/ child (Math/pow 2 bits))))
                                 (/= (bit-and (allocator-word view (+ child-entry 4)) 1) 0)) (allocator-invalid))
                    (let ((kind (allocator-word view (+ base (allocator-word view (+ child-entry 8))))))
                      (unless (and (> kind 0) (< kind 39)) (allocator-invalid))
                      (put frame-kinds kind (1+ (aref frame-kinds kind)))))))
              (setq index (1+ index)))
            (setq frame (allocator-word view (+ address 12)))))
        (setq frames (1+ frames)))
      (let ((counts (js-object :liveKinds (Object/freeze live-kinds) :pinnedKinds (Object/freeze pinned-kinds)
                     :frameRootKinds (Object/freeze frame-kinds) :frameDepth frames :frameSlots frame-slots)))
        (when hint
          (let ((first undefined) (initialized 0) (position 0))
            ;; Abort intentionally clears the active slab root. Do not infer
            ;; ownership from a matching size alone: require every seven-field
            ;; declaration marker and refuse to attribute an ambiguous match.
            (when (= slab-count 1)
              (while (< position (js-length (get hint :prepared)))
                (let* ((binding (aref (get hint :prepared) position)) (index (get binding :index)))
                  (if (= (allocator-word view (+ slab-address 40 (* index 28))) 2)
                    (setq initialized (1+ initialized))
                    (when (undefined? first) (setq first (Object/freeze
                      (js-object :index index :name (get binding :name)))))))
                (setq position (1+ position))))
            (put counts :projectInitialization (Object/freeze
              (js-object :bindingCount (get hint :bindingCount) :matchingSlabs slab-count :uniqueSlab (= slab-count 1)
                :initializedPreparedBindings (if (= slab-count 1) initialized undefined) :firstUninitialized first)))))
        (Object/freeze counts))))

  (defun module-metadata (module name)
    (let ((sections (js-call globalThis.WebAssembly.Module :customSections module name)) (descriptor nil))
      (when (> (js-length sections) 1) (failManagedRuntime 3))
      (when (> (js-length sections) 0)
        (let ((payload (new globalThis.Uint8Array (aref sections 0)))
              (length 0) (index 0) (shift 0) (ended false))
          (while (and (< index (js-length payload)) (< index 5) (not ended))
            (let ((byte (aref payload index)))
              (setq index (1+ index))
              (when (and (= index 5) (/= (bit-and byte 240) 0)) (failManagedRuntime 3))
              (setq length (+ length (* (bit-and byte 127) (Math/pow 2 shift))))
              (if (= (bit-and byte 128) 0) (setq ended t) (setq shift (+ shift 7)))))
          (unless (and ended (= (+ index length) (js-length payload))) (failManagedRuntime 3))
          (try
            (setq descriptor (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t))
              :decode (js-call payload :subarray index))))
            (catch ignored (failManagedRuntime 3)))
          (when (eq descriptor nil) (failManagedRuntime 3)))) descriptor))

  (defun exact-trap-exports (module exports options capability-errors)
    (let ((document (module-metadata module "eliscript-trap-sites"))
          (global (get exports :__eliscript_trap_site)))
      (if (eq document nil) exports
        (progn
          (unless (and (Array/isArray document) (runtime-instance-p global globalThis.WebAssembly.Global)
                       (= (value-type (get global :value)) "number"))
            (throw (new globalThis.TypeError "invalid WASM trap site transport")))
          (let ((sites (new globalThis.Map)) (index 0))
            (while (< index (js-length document))
              (let ((item (aref document index)))
                (unless (and (runtime-truth item) (Number/isSafeInteger (get item :site))
                             (>= (get item :site) 1) (<= (get item :site) 4294967295)
                             (not (js-call sites :has (get item :site)))
                             (Number/isSafeInteger (get item :address)) (>= (get item :address) 0)
                             (= (get item :offsetBase) "module")
                             (Number/isSafeInteger (get item :functionIndex)) (>= (get item :functionIndex) 0)
                             (= (get item :returnAddress) false))
                  (throw (new globalThis.TypeError "invalid exact WASM trap site")))
                (js-call sites :set (get item :site) (Object/freeze (runtime-copy (js-object) item))))
              (setq index (1+ index)))
            (let* ((debug (get options :debug))
                   (source-map (if (or (undefined? debug) (= debug false)) nil (createCompilerDebugMap debug)))
                   (wrapped (Object/create nil)) (entries (Object/entries exports)) (position 0))
              (while (< position (js-length entries))
                (let* ((entry (aref entries position)) (name (aref entry 0)) (value (aref entry 1)))
                  (if (not (= (value-type value) "function")) (put wrapped name value)
                    (let ((invoke
                      (lambda (&rest arguments)
                        (let ((previous (get global :value)))
                          (put global :value 0)
                          (try (Reflect/apply value undefined arguments)
                            (catch error
                              (when (and (runtime-instance-p error globalThis.WebAssembly.RuntimeError)
                                         (not (js-call capability-errors :has error))
                                         (not (Object/hasOwn error "eliscriptFrames")))
                                (let ((site (js-call sites :get (uint32 (get global :value)))))
                                  (when site
                                    (try
                                      (let ((frames (Object/freeze (js-array (Object/freeze
                                              (js-object :address (get site :address) :offsetBase "module"
                                                :functionIndex (get site :functionIndex) :returnAddress false))))))
                                        (Object/defineProperty error "eliscriptFrames"
                                          (js-object :value frames :enumerable t :configurable t))
                                        (when (and source-map (not (Object/hasOwn error "eliscriptSourceFrames")))
                                          (Object/defineProperty error "eliscriptSourceFrames"
                                            (js-object :value (js-call source-map :mapFrames frames) :enumerable t :configurable t))))
                                      (catch ignored nil)))))
                              (throw error))
                            (finally (put global :value previous)))))))
                      (Object/defineProperties invoke
                        (js-object :length (js-object :value (get value :length)) :name (js-object :value (get value :name))))
                      (put wrapped name invoke))))
                (setq position (1+ position)))
              (Object/freeze wrapped)))))))

  (defun instantiateManagedRuntime (bytes &rest arguments)
    (let* ((options (runtime-options arguments)) (module (new globalThis.WebAssembly.Module bytes))
           (descriptor (module-metadata module "eliscript-managed-control"))
           (declared (runtime-nullish (runtime-optional descriptor "hostCapabilities") (js-array)))
           (required (js-call globalThis.WebAssembly.Module :imports module)))
      (unless (and (Array/isArray declared) (= (js-length declared) (js-length required)))
        (throw (new globalThis.Error "managed imports differ from declared host capabilities")))
      (let* ((bridge (createManagedHostCapabilityBridge descriptor options)) (imports (Object/create nil))
             (lifecycle (js-object :capabilityBridge bridge)) (capability-errors (new globalThis.WeakSet)) (exports undefined))
        (try
          (let ((seen (new globalThis.Set)) (index 0))
            (while (< index (js-length required))
              (let ((actual (aref required index)) (capability (aref declared index)))
                (unless (and (runtime-truth capability) (= (get actual :kind) "function")
                             (= (get actual :module) "eliscript.host") (= (get actual :module) (get capability :module))
                             (= (get actual :name) (get capability :name)) (= (get capability :arity) 2)
                             (= (get capability :abi) "managed-host-call-v1") (not (js-call seen :has (get actual :name))))
                  (throw (new globalThis.Error "managed import is not an allowed declared capability")))
                (js-call seen :add (get actual :name))
                (unless (Object/hasOwn imports (get actual :module))
                  (put imports (get actual :module) (Object/create nil)))
                (put (get imports (get actual :module)) (get actual :name)
                  (lambda (heap argv)
                    (try
                      (let ((result (js-call bridge :dispatch (get actual :name) (uint32 heap) (uint32 argv))))
                        (unless (and (Number/isInteger result) (>= result 0) (<= result 4294967295))
                          (throw (new globalThis.TypeError "host capability returned an invalid managed word"))) result)
                      (catch error
                        (when (and (not (eq error nil))
                          (or (= (value-type error) "object") (= (value-type error) "function")))
                          (js-call capability-errors :add error))
                        (throw error))))))
              (setq index (1+ index)))
            (setq exports (exact-trap-exports module
              (get (new globalThis.WebAssembly.Instance module imports) :exports) options capability-errors))
            (unless (runtime-instance-p (get exports :memory) globalThis.WebAssembly.Memory)
              (throw (new globalThis.Error "managed runtime requires owned memory"))))
          (catch error (try (js-call bridge :close) (catch ignored nil)) (throw error)))
        (let* ((memory (js-object
                :view (lambda () (new globalThis.DataView (get (get exports :memory) :buffer)))
                :writeBytes (lambda (offset bytes)
                  (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset (js-length bytes)) :set bytes))
                :readBytes (lambda (offset length)
                  (js-call (new globalThis.Uint8Array (get (get exports :memory) :buffer) offset length) :slice))))
               (record (js-object :heap 0 :memory memory :closed false)))
          (try
            (let* ((runtime (observeManagedProjectRuntime
                              (createManagedHostRuntime
                                (observeManagedProjectExports (runtime-heap-exports exports options record) (get options :moduleGraph))
                                descriptor memory options lifecycle)
                              (get options :moduleGraph)))
                   (dispose (get lifecycle :dispose)))
              ;; Lifecycle is private to the loader. The frozen runtime API and
              ;; its stats result keep exactly their original fields/methods.
              (put lifecycle :dispose (lambda (&rest arguments)
                (put record :closed t) (put record :memory nil)
                (when dispose (Reflect/apply dispose lifecycle arguments))))
              (js-call runtime-allocator-records :set runtime record)
              runtime)
            (catch error
              (try (let ((dispose (get lifecycle :dispose)))
                (when dispose (js-call lifecycle :dispose))) (catch ignored nil))
              (try (js-call bridge :close) (catch ignored nil)) (throw error)))))))

  (defasync instantiateManagedRuntimeWithHostModules (bytes &rest arguments)
    (let* ((options (runtime-options arguments)) (module (new globalThis.WebAssembly.Module bytes))
           (descriptor (module-metadata module "eliscript-managed-control")))
      (if (runtime-truth (runtime-optional descriptor "project"))
        (let* ((provided-graph (get options :moduleGraph))
               (module-graph (if (nullish? provided-graph) (createManagedModuleGraph descriptor) provided-graph))
               (configuration (runtime-copy (runtime-copy (js-object) options)
                 (js-object :moduleGraph module-graph :hostModules (get module-graph :hostModules) :initializeModule false)))
               (runtime undefined))
          (when (or (runtime-truth (get module-graph :closed)) (runtime-truth (get module-graph :attached)))
            (throw (new globalThis.Error "module graph is already attached or closed")))
          (try
            (progn
              (setq runtime (instantiateManagedRuntime bytes configuration))
              (if (= (get options :initializeModule) false)
                (progn (js-call module-graph :attachRuntime runtime) runtime)
                (progn (await (loadManagedProjectGraph runtime descriptor configuration)) runtime)))
            (catch error
              (unless (runtime-truth (get module-graph :closed))
                (try (when runtime (js-call runtime :closeModule)) (catch ignored nil))
                (try (js-call module-graph :close) (catch ignored nil)))
              (throw error))))
        (let ((host-modules (await (loadManagedHostModules descriptor options))))
          (instantiateManagedRuntime bytes
            (runtime-copy (runtime-copy (js-object) options) (js-object :hostModules host-modules)))))))

  (export instantiateManagedRuntime instantiateManagedRuntimeWithHostModules loadManagedHostModules readManagedAllocatorSnapshot readManagedAllocatorValueCounts
    createManagedModuleGraph createManagedProjectFacades loadManagedProjectGraph))
