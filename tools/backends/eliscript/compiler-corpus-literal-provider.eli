(module tools.backends.compiler-corpus-literal-provider
  (import "node:fs/promises" readFile readdir realpath)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "./compiler-corpus-sorted-observation.mjs" sortedFunctionalPartition)
  (defconst format "eliscript-local-literal-provider")
  (defun fail () (throw (new globalThis.TypeError "original local literal provider source identity differs")))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun runtime-file-p (name)
    (and (= (value-type name) "string") (js-call name :startsWith "runtime/") (js-call name :endsWith ".mjs")
      (not (js-call (new globalThis.RegExp "[\\\\:\u0000]") :test name))
      (js-call (js-call name :split "/") :every (lambda (part) (and (/= part "") (/= part ".") (/= part ".."))))))
  (defasync runtime-files (directory prefix)
    (let ((result (js-array)) (entries (await (readdir directory (js-object :withFileTypes t)))) (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (name (get entry :name)) (id (+ prefix "/" name)))
          (cond ((js-call entry :isDirectory)
            (setq result (js-call result :concat (await (runtime-files (resolve directory name) id)))))
            ((and (js-call entry :isFile) (js-call name :endsWith ".mjs")) (js-call result :push id))
            ((and (js-call entry :isSymbolicLink) (js-call name :endsWith ".mjs")) (fail))))
        (setq index (1+ index)))
      (js-call result :sort) result))
  (defasync verify (directory files)
    (unless (and (Array/isArray files) (> (js-length files) 0)) (fail))
    (let* ((base (await (realpath directory)))
           (actual (await (runtime-files (resolve base "runtime") "runtime")))
           (seen (new globalThis.Set)) (index 0))
      (while (< index (js-length files))
        (let* ((item (aref files index)) (id (get item :id)))
          (unless (and (runtime-file-p id) (not (js-call seen :has id))
                       (Number/isSafeInteger (get item :bytes)) (>= (get item :bytes) 0)
                       (= (value-type (get item :sha256)) "string")) (fail))
          (unless (= (await (realpath (resolve base id))) (resolve base id)) (fail))
          (let ((bytes (await (readFile (resolve base id)))))
            (unless (and (= (js-length bytes) (get item :bytes)) (= (digest bytes) (get item :sha256))) (fail)))
          (js-call seen :add id))
        (setq index (1+ index)))
      (unless (and (= (get seen :size) (js-length actual)) (js-call actual :every (lambda (id) (js-call seen :has id)))) (fail))
      base))
  (defasync prepareOriginalLiteralHostProvider (context)
    (let* ((record (get context :record)) (execution (get record :execution (js-object)))
           (artifact (get context :artifact)) (descriptor (when artifact (get artifact :descriptor)))
           (sources (when (get record :request) (get (get record :request) :hostSources)))
           (source-root-provider false))
      ;; These original hosts compare against the genuine independent Seed,
      ;; whose persistent constructors belong to the source package realm.
      ;; Verify the same archived runtime bytes in that realm for the decoder.
      (when (and (js-call (js-array "original-program:literal-runtime-complete-hosts"
                         "original-program:literal-runtime-portable-codec") :includes (get record :id))
                 (= (get (get record :original) :suite) "tests/literal-runtime.test.mjs")
                 (Array/isArray sources))
        (setq source-root-provider t))
      ;; Sorted's completed compiler request acquires its native providers from
      ;; the authenticated archive. Its raw recipe intentionally has none.
      ;; Publish those same bytes before constructing the literal decoder;
      ;; falling back to another provider realm loses protocol/class identity.
      (when (and (nullish? sources) (not (Object/hasOwn context "failure"))
                 (js-call (js-array "wasm" "native") :includes (get context :target))
                 (= (get execution :kind) "original-program") descriptor (get descriptor :literalRuntime)
                 (= (get (get record :original) :fixture) "tests/fixtures/wasm-managed-sorted.eli")
                 (= (get (get record :original) :suite) "tests/wasm-managed-sorted-core.test.mjs")
                 (or (js-call (new globalThis.RegExp "^original-managed:sorted-core(?:-provider)?:(node|bun):auto-(65536|1)$") :test (get record :id))
                     (sortedFunctionalPartition record))
                 (Array/isArray (get context :sourceAssets)))
        (setq sources (js-array))
        (js-call (get context :sourceAssets) :forEach (lambda (asset)
          (when (runtime-file-p (get asset :file))
            (unless (and (= (get asset :encoding) "base64") (= (value-type (get asset :content)) "string")) (fail))
            (let ((bytes (js-call Buffer :from (get asset :content) "base64")))
              (unless (and (= (js-call bytes :toString "base64") (get asset :content))
                           (= (js-length bytes) (get asset :bytes)) (= (digest bytes) (get asset :sha256))) (fail))
              (js-call sources :push (js-object :id (get asset :file) :filename (get asset :file)
                :source (js-call bytes :toString "utf8")))))))
        (unless (js-call sources :some (lambda (source) (= (get source :id) "runtime/literals.mjs"))) (fail))
        ;; Keep the independent Seed reference's original dependency URLs.
        ;; This boundary explicitly supplies sourceRoot's native classes, so
        ;; authenticate and load that realm instead of cloning it into product.
        (setq source-root-provider t))
      (if (or (Object/hasOwn context "failure") (not (js-call (js-array "wasm" "native") :includes (get context :target)))
              (not descriptor) (not (get descriptor :literalRuntime))
              (not (= (get execution :kind) "original-program")) (not (Array/isArray sources))
              (not (js-call sources :some (lambda (source) (= (get source :id) "runtime/literals.mjs"))))) context
        (let* ((options (Object/assign (js-object) (get execution :runtimeOptions)))
               (existing (get options :literalHostProvider)) (files (js-array)))
          ;; Explicit caller providers retain the original factory contract.
          (if (and existing (/= (get existing :format) format)) context
            (progn
              (js-call sources :forEach (lambda (source)
                (when (runtime-file-p (get source :id))
                  (unless (= (value-type (get source :source)) "string") (fail))
                  (let ((bytes (js-call Buffer :from (get source :source) "utf8")))
                    (js-call files :push (js-object :id (get source :id) :bytes (js-length bytes) :sha256 (digest bytes)))))))
              (js-call files :sort (lambda (left right) (if (< (get left :id) (get right :id)) -1 (if (> (get left :id) (get right :id)) 1 0))))
              ;; Ground sidecar publication happens after this wrapper. Bind
              ;; the authenticated declarations here; the child validates the
              ;; complete published byte graph before loading any namespace.
              (let ((proof (Object/assign (js-object :format format :version 1 :files files)
                             (if source-root-provider (js-object :base "source-root") (js-object)))))
                (if existing
                  (progn (unless (= (JSON/stringify existing) (JSON/stringify proof)) (fail)) context)
                  (progn
                    (put options :literalHostProvider proof)
                    (Object/assign (js-object) context (js-object :record
                      (Object/assign (js-object) record (js-object :execution
                        (Object/assign (js-object) execution (js-object :runtimeOptions options)))))))))))))))
  (defasync resolveOriginalLiteralHostProvider (input)
    (let* ((options (when input (get input :runtimeOptions)))
           (proof (when options (get options :literalHostProvider))))
      (if (or (not proof) (/= (get proof :format) format)) input
        (progn
          (unless (and (= (get proof :version) 1) (js-call (js-array "wasm" "native") :includes (get input :target))
                       (get (get input :descriptor) :literalRuntime)) (fail))
          (unless (or (undefined? (get proof :base)) (= (get proof :base) "source-root")) (fail))
          (let* ((base (await (verify (if (= (get proof :base) "source-root")
                          (get input :sourceRoot) (fileURLToPath (get input :base))) (get proof :files))))
                 (require (createRequire (resolve base "__eliscript_original_program.json")))
                 (load (lambda (name) (funcall require (resolve base (+ "runtime/" name ".mjs")))))
                 (namespaces (js-object))
                 (provider (Object/assign (js-object) (funcall load "literals"))))
            (js-call (js-array "vector" "collection-internals" "record" "metadata" "type" "protocol" "regex" "sorted")
              :forEach (lambda (name) (Object/assign provider (funcall load (+ "core/" name)))))
            (js-call (js-array "collection" "value" "metadata" "transient" "order" "data-text")
              :forEach (lambda (name) (put namespaces name (funcall load (+ "core/" name)))))
            (put provider :protocolNamespaces namespaces)
            (Object/assign (js-object) input (js-object :runtimeOptions
              (Object/assign (js-object) options (js-object :literalHostProvider provider)))))))))
  (export prepareOriginalLiteralHostProvider resolveOriginalLiteralHostProvider))
