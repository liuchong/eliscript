(module tools.backends.compiler-corpus-emitter
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:path" posix)
  (import "./build.mjs" root)
  (import "./compiler-corpus-legacy.mjs" createOriginalCorpusSourceReader)
  (defconst id "original-program:compiler-module-bootstrap-emitter")
  (defconst suite "tests/bootstrap-emitter.test.mjs")
  (defconst suite-sha "1fb3dc7ac20d64c2b6cd392fa6980451d01269f4dbd3f2c91483bb3e6fda6ed0")
  (defconst actual-suite "tests/bootstrap-emitter-selfhosted.test.mjs")
  (defconst title "bootstrapped emitter matches seed ESM and Source Map output")
  (defconst pairs (js-array
    (js-array "tools/testing/bootstrap-emitter.eli" "tools/testing/bootstrap-emitter.mjs")
    (js-array "tools/testing/bootstrap-emitter-corpus-host.eli" "tools/testing/bootstrap-emitter-corpus-host.mjs")
    (js-array "tests/eliscript/bootstrap-emitter.eli" "tests/bootstrap-emitter-selfhosted.test.mjs")
    (js-array "tests/eliscript/bootstrap-emitter-node.eli" "tests/helpers/bootstrap-emitter-node.mjs")))
  (defun hash (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun fail (message) (throw (new globalThis.TypeError message)))
  (defun archive-locator (locator)
    (if (and (= (get locator :file) actual-suite) (= (get locator :contains) title))
      (Object/assign (js-object) locator (js-object :file suite)) locator))
  (defun archive-dimension (dimension)
    (Object/assign (js-object) dimension (js-object :evidence
      (js-call (get dimension :evidence) :map archive-locator))))
  (defun archive-manifest (manifest)
    (if (/= (get manifest :id) "compiler-parity") manifest
      (let* ((document (get manifest :document))
             (updated (Object/assign (js-object) document (js-object :dimensions
               (js-call (get document :dimensions) :map archive-dimension)))))
        (Object/assign (js-object) manifest (js-object :document updated)))))
  (defun prepareOriginalBootstrapEmitterOptions (options)
    (let* ((originals (get options :originals)) (manifests (and originals (get originals :manifests))))
      (if (not (Array/isArray manifests)) options
        (let ((updated (Object/assign (js-object) originals (js-object :manifests
                         (js-call manifests :map archive-manifest)))))
          (Object/assign (js-object) options (js-object :originals updated))))))
  (defun region (source begin finish)
    (let* ((start (js-call source :indexOf begin))
           (end (if (< start 0) -1 (js-call source :indexOf finish (+ start (js-length begin))))))
      (when (or (< start 0) (< end 0)) (fail "original emitter assertion boundary changed"))
      (js-object :start start :end end :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
        :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 end))
        :sha256 (hash (js-call source :slice start end)))))
  (defasync transportOriginalBootstrapEmitterCorpus (document options)
    (let ((records (js-call (get document :records) :filter (lambda (record) (= (get record :id) id)))))
      (when (> (js-length records) 0)
        (unless (= (js-length records) 1) (fail "original emitter record must be unique"))
        (let* ((record (aref records 0)) (original (get record :original)) (execution (get record :execution))
               (reader (createOriginalCorpusSourceReader (js-object :sourceRoot (get options :sourceRoot root))))
               (source (await (js-call reader :text suite))) (proofs (js-array))
               (regions (js-array (region source "async function run(" "\ntest(")
                 (region source "    const module = async (name) => import(" "\n  } finally {")))
               (files (js-array suite "tests/fixtures/bootstrap-ir.json" "tests/bootstrap-emitter-oracle.el"
                 "tools/backends/eliscript/compiler-corpus-emitter.eli")) (index 0))
          (unless (and (= (hash source) suite-sha) (= (get original :sourceSha256) suite-sha)
                       (= (get original :suite) suite) (= (get execution :kind) "original-program")
                       (= (get original :fixture) suite) (= (get original :host) suite)
                       (= (get original :originalAssertion) "bootstrapped emitter matches seed ESM and Source Map output")
                       (= (get record :entry) "bootstrap/compiler/compiler.mjs")
                       (Array/isArray (get record :modules)) (= (js-length (get record :modules)) 13)
                       (= (get execution :runtimeProfile) "compiler") (= (get execution :requiresBun) t)
                       (= (get execution :childProcesses) "inherit-selected-artifact")
                       (= (get execution :compilerSourceMaps) t)
                       (= (JSON/stringify (get original :regions)) (JSON/stringify regions)))
            (fail "original emitter identity, complete assertion spans or execution contract changed"))
          (while (< index (js-length pairs))
            (let* ((pair (aref pairs index)) (source-file (aref pair 0)) (output (aref pair 1))
                   (text (await (js-call reader :text source-file)))
                   (map (JSON/parse (await (js-call reader :text (str output ".map"))))))
              (unless (and (= (get map :version) 3) (= (js-length (get map :sourcesContent)) 1)
                           (= (aref (get map :sourcesContent) 0) text)
                           (= (js-call posix :normalize (js-call posix :join (js-call posix :dirname output)
                             (aref (get map :sources) 0))) source-file))
                (fail "maintained emitter source map does not bind its actual source"))
              (js-call files :push source-file output (str output ".map")))
            (setq index (1+ index)))
          (setq index 0)
          (while (< index (js-length files))
            (let* ((filename (aref files index)) (asset (await (js-call reader :file filename)))
                   (prior (js-call (get document :evidence) :find (lambda (item) (= (get item :file) filename)))))
              (when (and prior (/= (JSON/stringify prior) (JSON/stringify asset)))
                (fail "original emitter asset identity conflicts with its corpus"))
              (unless prior (js-call (get document :evidence) :push asset))
              (js-call proofs :push (js-object :file filename :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (let* ((host "tools/testing/bootstrap-emitter-corpus-host.mjs")
                 (updated (Object/assign (js-object) execution (js-object :host host)))
                 (assets (js-call (get original :sourceAssets (js-array)) :slice)))
            (Reflect/deleteProperty updated "hostSource")
            (js-call proofs :forEach (lambda (proof)
              (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get proof :file))))))
                (when (and previous (/= (get previous :sourceSha256) (get proof :sourceSha256)))
                  (fail "original emitter maintained source identity changed"))
                (unless previous (js-call assets :push proof)))))
            (put record :execution updated)
            (put record :original (Object/assign (js-object) original (js-object :sourceAssets assets
              :assertionSource (js-object :file suite :sourceSha256 suite-sha :regions regions)
              :maintainedAssertions (js-object :sourceFile "tools/testing/bootstrap-emitter.eli"
                :sourceSha256 (hash (await (js-call reader :text "tools/testing/bootstrap-emitter.eli")))
                :generatedFile "tools/testing/bootstrap-emitter.mjs"
                :generatedSha256 (hash (await (js-call reader :text "tools/testing/bootstrap-emitter.mjs"))))
              :maintainedTransport (js-object :kind "maintained-eli-complete-bootstrap-emitter" :version 1
                :sourceFile "tools/testing/bootstrap-emitter-corpus-host.eli" :generatedFile host
                :generatedSha256 (hash (await (js-call reader :text host)))
                :logicalSuite suite :originalSourceSha256 suite-sha
                :executedSuite actual-suite :fallback false)))))))
      ;; Restore each exact current parity locator after the historical builder
      ;; consumes its original assertion file. IDs and source bytes stay real.
      (let* ((originals (get options :originals)) (manifests (and originals (get originals :manifests)))
             (parity (and (Array/isArray manifests) (js-call manifests :find
               (lambda (manifest) (= (get manifest :id) "compiler-parity"))))))
        (when parity
          (js-call (get (get parity :document) :dimensions) :forEach (lambda (dimension)
            (js-call (get dimension :evidence) :forEach (lambda (locator index)
              (when (and (= (get locator :file) actual-suite) (= (get locator :contains) title))
                (let* ((locator-id (str "compiler-parity:dimension:" (get dimension :id) ":" index))
                       (actual (js-call (get (get document :originalGateEvidence) :locators) :find
                         (lambda (item) (= (get item :id) locator-id)))))
                  (unless (and actual (= (get actual :file) suite) (= (get actual :contains) title))
                    (fail "original emitter parity locator identity changed"))
                  (put actual :file actual-suite)))))))))
      document))
  (export transportOriginalBootstrapEmitterCorpus prepareOriginalBootstrapEmitterOptions))
