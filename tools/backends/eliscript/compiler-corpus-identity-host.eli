(module tools.backends.compiler-corpus-identity-host
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdir lstat realpath)
  (import "node:path" resolve dirname relative)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "node:crypto" createHash)
  (defconst arguments (js-call (get globalThis.process :argv) :slice 2))
  (defconst host-file (aref (get globalThis.process :argv) 1))
  (defconst require-module (createRequire host-file))
  (defun observe (module)
    (let* ((left (js-object)) (right (js-object)) (first (js-call module :token left))
           (out (js-object :tokens (js-array first (js-call module :alias left)
                  (js-call module :nested left) (js-call module :token right))
             :effects (js-call module :effects) :abrupt (js-call module :abrupt)
             :conversion (js-call module :no_conversion)))
           (symbols (js-call module :symbol_case)) (functions (js-call module :function_case)))
      (put out :symbols (js-array (= (aref symbols 0) (aref symbols 2)) (not (= (aref symbols 0) (aref symbols 1)))))
      (put out :functions (js-array (= (aref functions 0) (aref functions 2)) (not (= (aref functions 0) (aref functions 1))))) out))
  (defun independent (engine path root)
    (let* ((environment (Object/assign (js-object) (get globalThis.process :env)))
           (bun (= engine "bun")) (preload (resolve root "tools/backends/compiler-corpus-host-context.mjs"))
           (command (if bun (or (get environment :BUN) "bun") (or (get environment :NODE) "node")))
           (args (if bun (js-array "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
             (js-array "--experimental-loader" (resolve root "tests/fixtures/compiled-eli-node-loader.mjs")))))
      (Reflect/deleteProperty environment "ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT")
      (Reflect/deleteProperty environment "ELISCRIPT_ORIGINAL_TARGET")
      (when (get environment :NODE_OPTIONS)
        (put environment :NODE_OPTIONS (js-call (js-call (js-call (get environment :NODE_OPTIONS)
          :split (new globalThis.RegExp "\\s+")) :filter (lambda (value)
            (/= value (+ "--import=" (get (pathToFileURL preload) :href))))) :join " ")))
      (js-call args :push host-file "--observe" path)
      (let ((child (spawnSync command args (js-object :cwd root :env environment :encoding "utf8" :timeout 30000))))
        (js-call assert :strictEqual (get child :error) undefined)
        (js-call assert :strictEqual (get child :signal) nil)
        (js-call assert :strictEqual (get child :status) 0 (+ (get child :stderr) (get child :stdout)))
        (JSON/parse (get child :stdout)))))
  (defasync copy-instance (product entry label bytes)
    (let* ((id (+ "original-identity-isolation/" label "/" entry)) (path (resolve product id)))
      (await (mkdir (dirname path) (js-object :recursive t)))
      (try (await (writeFile path bytes (js-object :flag "wx")))
        (catch error (unless (= (get error :code) "EEXIST") (throw error))))
      (let ((details (await (lstat path))))
        (js-call assert :strictEqual (js-call details :isSymbolicLink) false)
        (js-call assert :strictEqual (js-call details :isFile) t)
        (js-call assert :strictEqual (js-call (await (readFile path)) :equals bytes) t))
      (js-call assert :notStrictEqual (await (realpath path)) (await (realpath (resolve product entry))))
      (js-object :id id :path path :module (funcall require-module path))))
  (defasync run ()
    (if (= (aref arguments 0) "--observe")
      (js-call (get globalThis.process :stdout) :write (JSON/stringify (observe (funcall require-module (aref arguments 1)))))
      (let* ((environment (get globalThis.process :env)) (root (get environment :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
             (reference-directory (get environment :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT))
             (product (aref arguments 0)) (entry (aref arguments 1)))
        (unless (and root reference-directory product (= (get environment :ELISCRIPT_ORIGINAL_TARGET) "javascript")
                     (= (value-type entry) "string")
                     (not (js-call (js-call entry :split "/") :some (lambda (part) (or (= part "") (= part ".") (= part ".."))))))
          (throw (new globalThis.Error "identity/value corpus requires its actual selected JS and independent reference")))
        (let* ((reference-path (resolve reference-directory entry)) (reference (funcall require-module reference-path))
               (module (funcall require-module (resolve product entry)))
               (scalars (js-array nil undefined false t -0 globalThis.NaN ""))
               (scalar-expected (js-call scalars :map (lambda (value) (js-call reference :safe value))))
               (expected (independent "node" reference-path root)))
          (js-call assert :deepStrictEqual (independent "bun" reference-path root) expected)
          (js-call assert :deepStrictEqual expected
            (js-object :tokens (js-array 1 1 1 2) :effects (js-array t (js-array 1 2))
              :abrupt (js-array t (js-array 1)) :conversion (js-array) :symbols (js-array t t) :functions (js-array t t)))
          (let* ((bytes (await (readFile (resolve product entry))))
                 (first (await (copy-instance product entry "first" bytes)))
                 (second (await (copy-instance product entry "second" bytes)))
                 (left (js-object)) (right (js-object)))
            (js-call assert :notStrictEqual (await (realpath (get first :path))) (await (realpath (get second :path))))
            (js-call assert :strictEqual (js-call (get first :module) :token left) 1)
            (js-call assert :strictEqual (js-call (get second :module) :token right) 1)
            (js-call assert :strictEqual (js-call (get first :module) :token left) 1)
            (js-call assert :strictEqual (js-call (get second :module) :token right) 1)
            (await (writeFile (resolve product "original-identity-isolation.json")
              (JSON/stringify (js-object :sourceSha256 (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")
                :copies (js-array (relative product (get first :path)) (relative product (get second :path)))))))
          (let* ((left (js-object)) (right (js-object)) (first (js-call module :token left)) (index 0))
            (js-call assert :strictEqual first 1)
            (js-call assert :strictEqual (js-call module :alias left) first)
            (js-call assert :strictEqual (js-call module :nested left) first)
            (js-call assert :strictEqual (js-call module :token right) 2)
            (while (< index 8) (js-call assert :strictEqual (js-call module :token left) first) (setq index (1+ index))))
          (js-call assert :deepStrictEqual (js-call module :effects) (js-array t (js-array 1 2)))
          (js-call assert :deepStrictEqual (js-call module :abrupt) (js-array t (js-array 1)))
          (js-call assert :deepStrictEqual (js-call module :no_conversion) (js-array))
          (let ((symbols (js-call module :symbol_case)) (functions (js-call module :function_case)))
            (js-call assert :strictEqual (aref symbols 0) (aref symbols 2))
            (js-call assert :notStrictEqual (aref symbols 0) (aref symbols 1))
            (js-call assert :strictEqual (aref functions 0) (aref functions 2))
            (js-call assert :notStrictEqual (aref functions 0) (aref functions 1)))
          (js-call assert :deepStrictEqual (js-call scalars :map (lambda (value) (js-call module :safe value))) scalar-expected)
          (js-call (get globalThis.process :stdout) :write (+ (JSON/stringify expected) "\n")))))))
  (js-call (run) :catch (lambda (error)
    (js-call (get globalThis.process :stderr) :write (+ (or (get error :stack) (funcall globalThis.String error)) "\n"))
    (put globalThis.process :exitCode 1))))
