(module tools.backends.compiler-corpus-identity-host
  (import "./compiler-corpus-process.mjs" readOriginalCorpusExecutionContext)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdir lstat realpath)
  (import "node:path" resolve dirname relative)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (defconst arguments (js-call (get globalThis.process :argv) :slice 2))
  (defconst host-file (aref (get globalThis.process :argv) 1))
  (defconst require-module (createRequire host-file))
  (defun observe (module)
    (let* ((left (js-object)) (right (js-object)) (first (js-call module :token left))
           (out (js-object :tokens (js-array first (js-call module :alias left)
                  (js-call module :nested left) (js-call module :token right))
             :effects (js-call module :effects) :abrupt (js-call module :abrupt)
             :conversion (js-call module :no_conversion)))
           (symbols (js-call module :symbol_case)) (functions (js-call module :function_case)))
      (put out :symbols (js-array (= (aref symbols 0) (aref symbols 2)) (not (= (aref symbols 0) (aref symbols 1)))))
      (put out :functions (js-array (= (aref functions 0) (aref functions 2)) (not (= (aref functions 0) (aref functions 1))))) out))
  (defun identityOracleLaunch (engine path root host context inherited)
    (let* ((environment (Object/assign (js-object) inherited))
           (process-tools (funcall require-module (resolve root "tools/backends/compiler-corpus-process.mjs")))
           (bun (= engine "bun")) (preload (resolve root "tools/backends/compiler-corpus-host-context.mjs"))
           (command (if bun (or (get environment :BUN) "bun") (or (get environment :NODE) "node")))
           (args (if bun (js-array "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
             (js-array "--experimental-loader" (resolve root "tests/fixtures/compiled-eli-node-loader.mjs")))))
      (put environment :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT undefined)
      (put environment :ELISCRIPT_ORIGINAL_TARGET undefined)
      (when (get environment :NODE_OPTIONS)
        (put environment :NODE_OPTIONS (js-call (js-call (js-call (get environment :NODE_OPTIONS)
          :split (new globalThis.RegExp "\\s+")) :filter (lambda (value)
            (/= value (+ "--import=" (get (pathToFileURL preload) :href))))) :join " ")))
      (js-call args :push host "--observe" path)
      (js-object :command command :args args :options
        (Object/assign (js-object) context (js-object :cwd root :env environment
          :directory (resolve (get context :directory) (str "identity-oracle-" engine))
          :policy (js-call process-tools :originalCorpusExecutionPolicy
            (Object/assign (js-object) context (js-object :record (js-object :execution (js-object :timeoutMs 30000))))))))))
  (defasync independent (engine path root)
    (let* ((environment (get globalThis.process :env))
           (context (readOriginalCorpusExecutionContext (get environment :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT)))
           (launch (identityOracleLaunch engine path root host-file context environment))
           (process-tools (funcall require-module (resolve root "tools/backends/compiler-corpus-process.mjs")))
           (receipt (await (js-call process-tools :runOriginalCorpusProcess
             (get launch :command) (get launch :args) (get launch :options)))))
      (JSON/parse (get receipt :stdout))))
  (defasync copy-instance (product entry label bytes)
    (let* ((id (+ "original-identity-isolation/" label "/" entry)) (path (resolve product id)))
      (await (mkdir (dirname path) (js-object :recursive t)))
      (try (await (writeFile path bytes (js-object :flag "wx")))
        (catch error (unless (= (get error :code) "EEXIST") (throw error))))
      (let ((details (await (lstat path))))
        (js-call assert :strictEqual (js-call details :isSymbolicLink) false)
        (js-call assert :strictEqual (js-call details :isFile) t)
        (js-call assert :strictEqual (js-call (await (readFile path)) :equals bytes) t))
      (js-call assert :notStrictEqual (await (realpath path)) (await (realpath (resolve product entry))))
      (js-object :id id :path path :module (funcall require-module path))))
  (defun read-value (runtime value)
    (cond ((and value (= (get value :kind) 4)) (js-call runtime :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call runtime :readString value))
      ((and value (= (get value :kind) 14))
       (let ((out (js-array)) (index 0))
         (while (< index (js-call runtime :length value))
           (let ((child (js-call runtime :get value index)))
             (try (js-call out :push (read-value runtime child)) (finally (js-call runtime :release child))))
           (setq index (1+ index))) out))
      (t value)))
  (defun call-value (runtime name &rest supplied)
    (let ((out (js-call runtime :invoke name (or (aref supplied 0) (js-array)))))
      (try (read-value runtime out) (finally (js-call runtime :release out)))))
  (defun finish-runtime (runtime &rest supplied)
    (try
      (progn
        (js-call (or (aref supplied 0) (js-array)) :forEach (lambda (value) (js-call runtime :release value)))
        (js-call runtime :closeModule) (js-call runtime :collect)
        (js-call assert :strictEqual (js-call runtime :live) 0)
        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
      (finally (when (get runtime :close) (js-call runtime :close)))))
  (defasync fresh-runtime (root selected)
    (let* ((options (Object/assign (js-object) (get selected :memory) (get selected :runtimeOptions)
                     (js-object :initializeModule false :nativeTarget (get selected :nativeTarget))))
           (runtime undefined))
      (if (= (get selected :target) "wasm")
        (let ((bytes (new globalThis.Uint8Array (await (readFile (get selected :path)))))
              (backend (funcall require-module (resolve root "tools/backends/managed-runtime.mjs"))))
          (js-call assert :deepStrictEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (setq runtime (js-call backend :instantiateManagedRuntime bytes options)))
        (let ((backend (funcall require-module (resolve root "tools/backends/native-managed-runtime.mjs"))))
          (setq runtime (await (js-call backend :instantiateNativeManagedRuntime (get selected :path)
            (js-object :typed (get selected :typed) :descriptor (get selected :descriptor)) options)))))
      (try
        (progn
          (js-call runtime :initializeModule) (js-call runtime :auto (get (get selected :runtimeOptions) :auto))
          (let ((context (funcall require-module (resolve root "tools/backends/compiler-corpus-host-context.mjs"))))
            (get (js-call context :bindOriginalManagedProgramContext
              (Object/assign (js-object) selected (js-object :host host-file)) (js-object :runtime runtime)) :runtime)))
        (catch error
          (try (when (get runtime :close) (js-call runtime :close)) (catch ignored nil))
          (throw error)))))
  (defun identities (runtime)
    (js-call runtime :auto 1)
    (let ((left (js-call runtime :sourceObject (js-object))) (right (js-call runtime :sourceObject (js-object))))
      (try
        (let ((first (call-value runtime "token" (js-array left))) (index 0))
          (js-call assert :strictEqual first 1)
          (js-call assert :strictEqual (call-value runtime "alias" (js-array left)) first)
          (js-call assert :strictEqual (call-value runtime "nested" (js-array left)) first)
          (js-call assert :strictEqual (call-value runtime "token" (js-array right)) 2)
          (while (< index 8)
            (js-call runtime :collect)
            (js-call assert :strictEqual (call-value runtime "token" (js-array left)) first)
            (setq index (1+ index)))
          (js-call assert :deepStrictEqual (call-value runtime "effects") (js-array t (js-array 1 2)))
          (js-call assert :deepStrictEqual (call-value runtime "abrupt") (js-array t (js-array 1)))
          (js-call assert :deepStrictEqual (call-value runtime "no-conversion") (js-array))
          (let ((symbols (call-value runtime "symbol-case")) (functions (call-value runtime "function-case")))
            (js-call assert :strictEqual (aref symbols 0) (aref symbols 2))
            (js-call assert :notStrictEqual (aref symbols 0) (aref symbols 1))
            (js-call assert :strictEqual (aref functions 0) (aref functions 2))
            (js-call assert :notStrictEqual (aref functions 0) (aref functions 1))))
        (finally (finish-runtime runtime (js-array left right))))))
  (defasync binary-identities (root selected reference)
    (identities (await (fresh-runtime root selected)))
    (let ((runtime (await (fresh-runtime root selected))))
      (js-call runtime :auto 1)
      (let ((values (js-array nil undefined false t (js-call runtime :number -0)
                     (js-call runtime :number globalThis.NaN) (js-call runtime :string ""))))
        (try
          (progn
            (js-call values :forEach (lambda (value)
              (js-call assert :strictEqual (call-value runtime "safe" (js-array value))
                (js-call reference :safe (read-value runtime value)))))
            (let ((object (js-call runtime :sourceObject (js-object))))
              (try (js-call assert :strictEqual (call-value runtime "token" (js-array object)) 1)
                (finally (js-call runtime :release object)))))
          (finally (finish-runtime runtime values)))))
    (let* ((first (await (fresh-runtime root selected))) (second (await (fresh-runtime root selected)))
           (left (js-call first :sourceObject (js-object))) (right (js-call second :sourceObject (js-object))))
      (try
        (progn
          (js-call assert :strictEqual (call-value first "token" (js-array left)) 1)
          (js-call assert :strictEqual (call-value second "token" (js-array right)) 1)
          (js-call assert :strictEqual (call-value first "token" (js-array left)) 1)
          (js-call assert :strictEqual (call-value second "token" (js-array right)) 1)
          (js-call assert :throws (lambda () (js-call first :invoke "token" (js-array right)))
            (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0001"))))
        (finally (try (finish-runtime first (js-array left)) (finally (finish-runtime second (js-array right)))))))
    (let ((runtime (await (fresh-runtime root selected))))
      (js-call runtime :auto 1)
      (try
        (progn
          (js-call assert :deepStrictEqual (call-value runtime "effects") (js-array t (js-array 1 2)))
          (js-call assert :deepStrictEqual (call-value runtime "abrupt") (js-array t (js-array 1))))
        (finally (finish-runtime runtime)))))
  (defasync run ()
    (if (= (aref arguments 0) "--observe")
      (js-call (get globalThis.process :stdout) :write (JSON/stringify (observe (funcall require-module (aref arguments 1)))))
      (let* ((environment (get globalThis.process :env)) (root (get environment :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
             (reference-directory (get environment :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT))
             (product (aref arguments 0)) (entry (aref arguments 1)))
        (unless (and root reference-directory product
                     (= (value-type entry) "string")
                     (not (js-call (js-call entry :split "/") :some (lambda (part) (or (= part "") (= part ".") (= part ".."))))))
          (throw (new globalThis.Error "identity/value corpus requires its actual selected JS and independent reference")))
        (let* ((reference-path (resolve reference-directory entry)) (reference (funcall require-module reference-path))
               (module (funcall require-module (resolve product entry)))
               (scalars (js-array nil undefined false t -0 globalThis.NaN ""))
               (scalar-expected (js-call scalars :map (lambda (value) (js-call reference :safe value))))
               (expected (await (independent "node" reference-path root))))
          (js-call assert :deepStrictEqual (await (independent "bun" reference-path root)) expected)
          (js-call assert :deepStrictEqual expected
            (js-object :tokens (js-array 1 1 1 2) :effects (js-array t (js-array 1 2))
              :abrupt (js-array t (js-array 1)) :conversion (js-array) :symbols (js-array t t) :functions (js-array t t)))
          (if (/= (get environment :ELISCRIPT_ORIGINAL_TARGET) "javascript")
            (let* ((metadata (funcall require-module (resolve root "tools/backends/compiler-metadata.mjs")))
                   (selected (await (js-call metadata :readCompilerMetadata (get environment :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT)))))
              (await (binary-identities root selected reference)))
            (progn
          (let* ((bytes (await (readFile (resolve product entry))))
                 (first (await (copy-instance product entry "first" bytes)))
                 (second (await (copy-instance product entry "second" bytes)))
                 (left (js-object)) (right (js-object)))
            (js-call assert :notStrictEqual (await (realpath (get first :path))) (await (realpath (get second :path))))
            (js-call assert :strictEqual (js-call (get first :module) :token left) 1)
            (js-call assert :strictEqual (js-call (get second :module) :token right) 1)
            (js-call assert :strictEqual (js-call (get first :module) :token left) 1)
            (js-call assert :strictEqual (js-call (get second :module) :token right) 1)
            (await (writeFile (resolve product "original-identity-isolation.json")
              (JSON/stringify (js-object :sourceSha256 (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")
                :copies (js-array (relative product (get first :path)) (relative product (get second :path))))))))
          (let* ((left (js-object)) (right (js-object)) (first (js-call module :token left)) (index 0))
            (js-call assert :strictEqual first 1)
            (js-call assert :strictEqual (js-call module :alias left) first)
            (js-call assert :strictEqual (js-call module :nested left) first)
            (js-call assert :strictEqual (js-call module :token right) 2)
            (while (< index 8) (js-call assert :strictEqual (js-call module :token left) first) (setq index (1+ index))))
          (js-call assert :deepStrictEqual (js-call module :effects) (js-array t (js-array 1 2)))
          (js-call assert :deepStrictEqual (js-call module :abrupt) (js-array t (js-array 1)))
          (js-call assert :deepStrictEqual (js-call module :no_conversion) (js-array))
          (let ((symbols (js-call module :symbol_case)) (functions (js-call module :function_case)))
            (js-call assert :strictEqual (aref symbols 0) (aref symbols 2))
            (js-call assert :notStrictEqual (aref symbols 0) (aref symbols 1))
            (js-call assert :strictEqual (aref functions 0) (aref functions 2))
            (js-call assert :notStrictEqual (aref functions 0) (aref functions 1)))
          (js-call assert :deepStrictEqual (js-call scalars :map (lambda (value) (js-call module :safe value))) scalar-expected)))
          (js-call (get globalThis.process :stdout) :write (+ (JSON/stringify expected) "\n"))))))
  ;; CLI execution depends on the actual module path, not an archived host
  ;; basename. Relocated explicit JavaScript hosts retain this same program.
  (defconst main-invocation (and (= (value-type host-file) "string")
    (= (resolve host-file) (resolve (fileURLToPath (js* "import.meta.url"))))))
  (defconst helperAPI (Object/freeze (js-object :identityOracleLaunch identityOracleLaunch)))
  (defconst completion (if main-invocation (run) (Promise/resolve)))
  (defun identityHostCompletionThen (pending resolve reject)
    (js-call pending :then (lambda () (funcall resolve helperAPI)) reject))
  (defun then (resolve reject)
    (identityHostCompletionThen completion resolve reject))
  ;; Keep the original rejection on completion for the awaiting driver.
  ;; CLI diagnostics are secondary and cannot replace it.
  (when main-invocation
    (js-call completion :catch (lambda (error)
      (put globalThis.process :exitCode 1)
      (try
        (js-call (get globalThis.process :stderr) :write
          (+ (or (and error (get error :stack)) (funcall globalThis.String error)) "\n"))
        (catch ignored nil)))))
  (export identityOracleLaunch helperAPI completion then identityHostCompletionThen))
