(module tools.backends.compiler-corpus-original-program
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir readFile writeFile symlink lstat realpath)
  (import "node:path" resolve join relative isAbsolute sep)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:buffer" Buffer)
  (import "node:crypto" createHash)
  (import "./compiler-build.mjs" independentCompilerResources)
  (import "./compiler-bootstrap.mjs" archiveCompilerArtifact normalizeCompilerHost saveCompilerMetadata)
  (import "./compiler-corpus-generations.mjs" prepareOriginalCompilerGenerations)
  (import "./compiler-corpus-reference.mjs" prepareOriginalReferenceArtifact)
  (import "./compiler-corpus-process.mjs" originalCorpusExecutionPolicy runOriginalCorpusProcess writeOriginalCorpusExecutionContext validateOriginalProcessHostDependency)
  (defun fallback (value other) (if (nullish? value) other value))
  (defun invalid (message) (throw (new globalThis.TypeError message)))
  (defun safe-id (id)
    (and (= (value-type id) "string") (> (js-length id) 0)
      (not (js-call (new globalThis.RegExp "[\\\\:\\u0000]") :test id))
      (not (js-call (js-call id :split "/") :some
        (lambda (part) (or (= part "") (= part ".") (= part "..")))))))
  (defasync javascript-environment (artifact source-root)
    (let ((modules (join (resolve (get artifact :path) "..") "node_modules")))
      (await (mkdir modules (js-object :recursive t)))
      (try (await (symlink (resolve source-root) (join modules "eliscript") "dir"))
        (catch error (unless (= (get error :code) "EEXIST") (throw error))))))
  (defasync originalProgramAliases (artifact source-root)
    (let* ((directory (fallback (get artifact :directory) (resolve (get artifact :path) "..")))
           (modules (if (= (get artifact :target) "javascript") (get artifact :modules)
                      (get (get (get artifact :descriptor) :project) :modules))) (index 0))
      (unless (Array/isArray modules) (invalid "original host oracle requires actual phased module exports"))
      ;; Alias the actual generated module. Realpath preserves its ESM identity
      ;; and live bindings without manufacturing another implementation string.
      (while (< index (js-length modules))
        (let* ((module (aref modules index)) (id (get module :id)))
          (unless (and (safe-id id) (js-call id :endsWith ".mjs"))
            (invalid "original program alias escapes the product"))
          (let* ((file (resolve directory (str (js-call id :slice 0 -4) ".eli")))
                 (actual (resolve directory id)) (base (aref (js-call id :split "/") (- (js-length (js-call id :split "/")) 1))))
            (await (mkdir (resolve file "..") (js-object :recursive t)))
            (try (await (symlink base file "file"))
              (catch error
                (unless (and (= (get error :code) "EEXIST") (= (await (realpath file)) (await (realpath actual))))
                  (throw error))))))
        (setq index (1+ index)))
      (await (javascript-environment artifact source-root))
      (try (await (symlink (resolve source-root "runtime") (resolve directory "runtime") "dir"))
        (catch error (unless (= (get error :code) "EEXIST") (throw error))))))
  (defasync put-sidecar (directory id source)
    (unless (and (safe-id id) (= (value-type source) "string")) (invalid "invalid original provider sidecar"))
    (let* ((path (resolve directory id)) (part (relative directory path))
           (segments (js-call (js-call id :split "/") :slice 0 -1)) (parent directory) (index 0))
      (when (or (isAbsolute part) (= part "..") (js-call part :startsWith (str ".." sep)))
        (invalid "original provider sidecar escapes its artifact"))
      (while (< index (js-length segments))
        (setq parent (join parent (aref segments index)))
        (await (mkdir parent (js-object :recursive t)))
        (let ((details (await (lstat parent))))
          (when (or (js-call details :isSymbolicLink) (not (js-call details :isDirectory)))
            (invalid "original provider sidecar traverses an alias")))
        (setq index (1+ index)))
      (try (await (writeFile path source (js-object :flag "wx")))
        (catch error
          (unless (= (get error :code) "EEXIST") (throw error))
          (let ((details (await (lstat path))))
            (when (or (js-call details :isSymbolicLink) (not (js-call details :isFile))
                (not (js-call (await (readFile path)) :equals (Buffer/from source))))
              (throw (new globalThis.Error "original provider sidecar conflicts with emitted source")))))) path))
  (defasync originalProgramSidecars (artifact record)
    (validateOriginalProcessHostDependency record)
    (let* ((declared-directory (get artifact :directory))
           (directory (resolve (if (nullish? declared-directory)
             (resolve (get artifact :path) "..") declared-directory)))
           (request (or (get record :request) (js-object)))
           (sources (fallback (get request :hostSources) (js-array))) (index 0)
           (execution (get record :execution)))
      (while (< index (js-length sources))
        (let ((source (aref sources index)))
          (await (put-sidecar directory (get source :id) (get source :source))))
        (setq index (1+ index)))
      (if (not (nullish? (get execution :hostSource)))
        (await (put-sidecar directory (get execution :host) (get execution :hostSource)))
        (if (get execution :host) (resolve (get record :sourceRoot) (get execution :host)) nil))))
  (defun originalProgramArguments (contract entry base)
    (let ((records (fallback (get contract :arguments)
             (js-call (fallback (get contract :argumentModules) (js-array entry)) :map
               (lambda (module) (js-object :module module))))))
      (unless (Array/isArray records) (invalid "original program arguments must be an array"))
      (js-call records :map (lambda (record)
        (unless (and record (= (value-type record) "object") (not (Array/isArray record))
                     (= (js-length (Object/keys record)) 1))
          (invalid "original program requires an explicit argument recipe"))
        (cond
          ((Object/hasOwn record "literal")
           (unless (= (value-type (get record :literal)) "string") (invalid "original program literal argument must be text"))
           (get record :literal))
          ((Object/hasOwn record "directory")
           (unless (= (get record :directory) t) (invalid "original program directory argument must select its artifact"))
           (fileURLToPath (new globalThis.URL "./" base)))
          (t (let ((id (get record :module)))
            (unless (safe-id id) (invalid "original program module argument must stay inside its artifact"))
            (let ((url (new globalThis.URL (js-call (js-call (js-call id :split "/") :map globalThis.encodeURIComponent) :join "/") base)))
              (if (= (get contract :argument) "url") (get url :href) (fileURLToPath url))))))))))
  (defasync originalCompilerSourceMaps (context)
    (let* ((record (get context :record)) (target (get context :target)))
      (if (or (not (get (get record :execution) :compilerSourceMaps)) (= target "javascript")) (js-array)
        (let* ((modules (fallback (get record :modules) (get (get record :request) :modules)))
               (request (Object/assign (js-object) (get record :request)
                 (js-object :operation "project" :modules modules :entry (fallback (get record :entry) (get (get record :request) :entry))
                   :target "javascript" :sourceMap t :debug false :phased false))))
          (unless (and (Array/isArray modules) (> (js-length modules) 0))
            (invalid "original compiler source maps require the entire original source graph"))
          (let* ((response (await (js-call (get context :session) :request request (js-object :signal (get context :signal)))))
                 (support (await (js-call context :archiveProduct response "original-compiler-javascript-maps" "javascript")))
                 (maps (js-array)) (index 0))
            (js-call assert :equal (get support :target) "javascript")
            (js-call assert :deepEqual (js-call (js-call (get support :modules) :map (lambda (m) (get m :id))) :sort)
              (js-call (js-call modules :map (lambda (m) (get m :id))) :sort))
            (while (< index (js-length (get support :modules)))
              (let ((module (aref (get support :modules) index)))
                (unless (= (value-type (get module :sourceMapPath)) "string")
                  (throw (new globalThis.Error "original compiler JavaScript source map was not emitted")))
                (let ((source (await (readFile (get module :sourceMapPath) "utf8"))))
                  (js-call assert :equal (js-call (js-call (createHash "sha256") :update source) :digest "hex") (get module :sourceMapSha256))
                  (js-call maps :push (js-object :id (str (get module :id) ".map") :source source))))
              (setq index (1+ index)))
            (await (originalProgramSidecars (get context :artifact) (js-object :request (js-object :hostSources maps) :execution (js-object))))
            (js-array (js-object :role "original-compiler-javascript-source-maps" :target "javascript"
              :directory (js-call (js-call (relative (get context :directory) (get support :directory)) :split sep) :join "/")
              :identitySha256 (get support :identitySha256))))))))
  (defasync run-program (context command args env policy cwd)
    (put env :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT
      (await (writeOriginalCorpusExecutionContext (get context :directory)
        (js-object :options (or (get context :options) (js-object))
          :directory (get context :directory) :caseId (get (get context :record) :id)
          :target (get context :target) :sourceIdentity (get context :sourceIdentity)))))
    (let* ((settings (or (get context :options) (js-object)))
           (receipt (await (runOriginalCorpusProcess command args
            (js-object :directory (resolve (get context :directory) "original-process")
              :caseId (get (get context :record) :id) :target (get context :target)
              :sourceIdentity (get context :sourceIdentity) :policy policy :cwd cwd :env env
              :executionContext (JSON/parse (get env :ELISCRIPT_ORIGINAL_EXECUTION_CONTEXT))
              :signal (get context :signal) :terminate (get settings :terminateOriginalProcess)
              :cleanup (get settings :cleanupOriginalProcess))))))
      (get receipt :stdout)))
  (defasync executeOriginalProgram (input-context)
    (let* ((artifact (get input-context :artifact)) (record (get input-context :record))
           (target (get input-context :target)) (source-root (get input-context :sourceRoot))
           (contract (get record :execution)) (supplied (or (get input-context :options) (js-object)))
           (resources (when (= (get contract :runtimeProfile) "compiler") (independentCompilerResources supplied)))
           (configured (if resources (Object/assign (js-object) supplied
             (js-object :profile (get resources :profile) :budget (get resources :budget) :memory (get resources :memory)
               :auto (get resources :auto) :runtimeOptions (Object/assign (js-object) (get resources :budget)
                 (js-object :auto (get resources :auto)) (get supplied :runtimeOptions)))) supplied))
           (options (Object/assign (js-object) configured
             (when (get record :memory) (js-object :memory (globalThis.structuredClone (get record :memory))))
             (js-object :runtimeOptions (Object/assign (js-object) (get configured :runtimeOptions) (get contract :runtimeOptions)))))
           (context (Object/assign (js-object) input-context (js-object :options options
             :directory (fallback (get input-context :directory)
               (fallback (get artifact :directory) (resolve (get artifact :path) ".."))))))
           (policy (originalCorpusExecutionPolicy context))
           (supporting (await (originalCompilerSourceMaps context))))
      (when (and (= (get contract :zeroImports) t) (= target "wasm"))
        (let ((module (new globalThis.WebAssembly.Module (new globalThis.Uint8Array (await (readFile (get artifact :path)))))))
          (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array) "original source graph must remain a zero-import WASM product")))
      (let* ((reference (await (prepareOriginalReferenceArtifact context)))
             (generations (await (prepareOriginalCompilerGenerations context))) (env (js-object))
             (directory (fallback (get artifact :directory) (resolve (get artifact :path) "..")))
             (entry (resolve directory (get artifact :entry)))
             (host (await (originalProgramSidecars artifact (Object/assign (js-object) record (js-object :sourceRoot source-root))))))
        (when reference
          (Reflect/apply (get supporting :push) supporting (get reference :supportingProducts))
          (put env :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT (get reference :directory)))
        (when generations
          (Reflect/apply (get supporting :push) supporting (get generations :supportingProducts))
          (put env :ELISCRIPT_ORIGINAL_COMPILER_GENERATIONS (get generations :manifestPath)))
        (let* ((companion (js-call supporting :find (lambda (item) (= (get item :role) "original-compiler-javascript-source-maps"))))
               (javascript-directory (if (= target "javascript") (get artifact :directory)
                 (when companion (resolve (get context :directory) (get companion :directory))))))
          (unless (undefined? javascript-directory) (put env :ELISCRIPT_ORIGINAL_JAVASCRIPT_PRODUCT_ROOT javascript-directory)))
        (await (originalProgramAliases artifact source-root))
        (unless (or (undefined? (get contract :hostRuntime)) (js-call (js-array "node" "bun") :includes (get contract :hostRuntime)))
          (invalid "original host runtime must be node or bun"))
        (let* ((bun (if (undefined? (get contract :hostRuntime))
                       (or (= (get options :programHost) "bun") (get contract :requiresBun)) (= (get contract :hostRuntime) "bun")))
               (command (if bun (fallback (get options :bun) (fallback (get (get globalThis.process :env) :BUN) "bun"))
                          (fallback (get options :node) (fallback (get (get globalThis.process :env) :NODE) "node"))))
               (preload (if bun (js-array "--preload" (resolve source-root "tests/fixtures/compiled-eli-bun-preload.mjs"))
                          (js-array "--experimental-loader" (resolve source-root "tests/fixtures/compiled-eli-node-loader.mjs"))))
               (args undefined))
          (put env :ELISCRIPT_ORIGINAL_TARGET target) (put env :ELISCRIPT_ORIGINAL_SOURCE_ROOT source-root)
          (if (= target "javascript")
            (if (get contract :hostEval)
              (let ((script (resolve directory "__eliscript_original_inline.mjs")))
                (await (writeFile script (get contract :hostEval)))
                (setq args (js-call preload :concat (js-array script))) (put env (get contract :environment) entry))
              (setq args (if host (js-call preload :concat (js-array host)
                   (originalProgramArguments contract (get artifact :entry) (get (pathToFileURL (str directory "/")) :href)))
                 (js-call preload :concat (js-array entry)))))
            (let ((configuration (resolve directory "__eliscript_original_program.json")))
              (await (saveCompilerMetadata configuration
                (js-object :target target :path (get artifact :path) :descriptor (get artifact :descriptor) :typed (get artifact :typed)
                  :nativeTarget (fallback (get artifact :nativeTarget) (fallback (get options :nativeTarget)
                    (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos")))
                  :entry (get artifact :entry) :host host :argument (get contract :argument) :arguments (get contract :arguments)
                  :argumentModules (fallback (get contract :argumentModules) (js-array (get artifact :entry)))
                  :hostEval (get contract :hostEval) :environment (get contract :environment)
                  :base (get (pathToFileURL (str directory "/")) :href) :sourceRoot source-root :childProcesses (get contract :childProcesses)
                  :runtimeLaunchers (= (get contract :runtimeLaunchers) t) :memory (get options :memory)
                  :driverEvidence (resolve directory "original-driver-lifecycle.jsonl")
                  :runtimeOptions (Object/assign (js-object) (get options :runtimeOptions)
                    (unless (undefined? (get record :auto)) (js-object :auto (get record :auto)))
                    (when (get artifact :debug) (js-object :debug (get artifact :debug)))))))
              (setq args (js-call preload :concat (js-array
                (resolve source-root "tools/backends/compiler-corpus-program-driver.mjs") configuration)))))
          (let ((result (js-object :kind "original-program" :stdout (await (run-program context command args env policy directory)))))
            (when (> (js-length supporting) 0) (put result :supportingProducts supporting)) result)))))
  (defasync executeCompilerSessionProgram (context)
    (let* ((artifact (get context :artifact)) (record (get context :record)) (target (get context :target))
           (source-root (get context :sourceRoot)) (contract (get record :execution))
           (supplied (or (get context :options) (js-object)))
           (resources (independentCompilerResources
             (if (undefined? (get contract :compilerProfile)) supplied (js-object :profile (get contract :compilerProfile)))))
           (options (Object/assign (js-object) supplied (js-object :memory (fallback (get record :memory) (get resources :memory))
             :runtimeOptions (Object/assign (js-object) (get resources :budget) (js-object :auto (get resources :auto))
               (get supplied :runtimeOptions) (get contract :runtimeOptions)))))
           (directory (fallback (get artifact :directory) (resolve (get artifact :path) ".."))))
      (unless (js-call (js-array "javascript" "wasm" "native") :includes target)
        (invalid "original compiler tools require a real selected compiler target"))
      (unless (js-call (js-array "node" "bun") :includes (get contract :hostRuntime))
        (invalid "original compiler tools require their explicit host runtime"))
      (await (javascript-environment artifact source-root))
      (let* ((host (await (originalProgramSidecars artifact (Object/assign (js-object) record (js-object :sourceRoot source-root)))))
             (configuration (resolve directory "__eliscript_original_compiler_session.json"))
             (supporting-directory (resolve (get context :directory) "original-tool-products"))
             (supporting-manifest (resolve (get context :directory) "original-tool-products.json"))
             (preparation (get contract :preparationTimeoutMs))
             (deadline (if (undefined? preparation) (get contract :timeoutMs) (+ preparation (get contract :timeoutMs))))
             (policy-context (Object/assign (js-object) context
               (js-object :record (Object/assign (js-object) record
                 (js-object :execution (Object/assign (js-object) contract
                   (js-object :timeoutMs deadline :timeoutByTarget undefined)))))))
             (policy (originalCorpusExecutionPolicy policy-context)))
        (unless host (invalid "original compiler tools require their retained original host source"))
        (unless (or (undefined? preparation) (and (Number/isSafeInteger preparation) (> preparation 0)))
          (invalid "original compiler preparation requires its positive original beforeAll timeout"))
        (await (saveCompilerMetadata configuration
          (Object/assign (js-object :target target :path (get artifact :path) :sourceRoot source-root :entry (get artifact :entry)
            :descriptor (get artifact :descriptor) :typed (get artifact :typed) :memory (get options :memory)
            :runtimeOptions (Object/assign (js-object) (get options :runtimeOptions)
              (js-object :nativeTarget (fallback (get artifact :nativeTarget) (fallback (get options :nativeTarget)
                (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos"))))
              (when (get artifact :debug) (js-object :debug (get artifact :debug)))))
            (unless (undefined? preparation) (js-object :preparationTimeoutMs preparation))
            (when (= (get contract :supportingCompilerProducts) t)
              (js-object :supportingDirectory supporting-directory :supportingManifest supporting-manifest)))))
        (let* ((command (if (= (get contract :hostRuntime) "bun")
                 (fallback (get options :bun) (fallback (get (get globalThis.process :env) :BUN) "bun"))
                 (fallback (get options :node) (fallback (get (get globalThis.process :env) :NODE) "node"))))
               (stdout (await (run-program context command (js-array host)
                 (js-object :ELISCRIPT_ORIGINAL_SOURCE_ROOT source-root :ELISCRIPT_ORIGINAL_TARGET target
                   :ELISCRIPT_ORIGINAL_COMPILER_SESSION configuration) policy source-root)))
               (supporting (js-array)))
          (when (= (get contract :supportingCompilerProducts) t)
            (let* ((manifest (JSON/parse (await (readFile supporting-manifest "utf8"))))
                   (products (get manifest :products)) (roles (new globalThis.Set)) (index 0))
              (unless (and (= (get manifest :format) "eliscript-original-compiler-supporting-products")
                   (= (get manifest :version) 1) (Array/isArray products) (> (js-length products) 0))
                (invalid "original compiler tools did not retain their real supporting products"))
              (while (< index (js-length products))
                (let* ((product (aref products index)) (role (get product :role)) (built (get product :artifact)))
                  (unless (and (= (value-type role) "string") (> (js-length role) 0) (not (js-call roles :has role)))
                    (invalid "original compiler supporting product role is missing or duplicate"))
                  (js-call roles :add role)
                  (js-call (js-array (get built :directory) (get built :path)) :forEach (lambda (path)
                    (unless (= (value-type path) "string") (invalid "original compiler supporting product requires actual local files"))
                    (let ((inside (relative supporting-directory (resolve path))))
                      (when (or (= inside "") (isAbsolute inside) (= inside "..") (js-call inside :startsWith (str ".." sep)))
                        (invalid "original compiler supporting product escapes its case archive")))))
                  (let ((provenance (get built :provenance)) (source (get built :sourceIdentity)))
                    (unless (and provenance (= (get provenance :mode) "session")
                      (= (normalizeCompilerHost (get provenance :producerHost)) target)
                      (= (get provenance :runtimeCompiled) t) (Array/isArray (get provenance :compiledModuleIds))
                      source (Array/isArray (get source :modules))
                      (= (JSON/stringify (js-call (js-call (get provenance :compiledModuleIds) :slice) :sort))
                         (JSON/stringify (js-call (js-call (get source :modules) :map (lambda (item) (get item :id))) :sort))))
                      (throw (new globalThis.Error "original compiler supporting product was not built completely by the selected real compiler"))))
                  (let* ((archived (await (archiveCompilerArtifact built
                            (resolve (get context :directory) (str "original-tool-product-" index "-metadata")))))
                         (product-identity (get archived :productIdentity)))
                    (unless (and product-identity (get product-identity :sha256))
                      (throw (new globalThis.Error "original compiler supporting product has no authenticated emitted file identity")))
                    (js-call supporting :push (js-object :role role :target (normalizeCompilerHost (get built :host)) :producerHost target
                      :directory (js-call (js-call (relative (get context :directory) (get built :directory)) :split sep) :join "/")
                      :identitySha256 (get product-identity :sha256)))))
                (setq index (1+ index)))))
          (let ((result (js-object :kind "original-program" :stdout stdout)))
            (when (> (js-length supporting) 0) (put result :supportingProducts supporting)) result)))))
  (export executeOriginalProgram executeCompilerSessionProgram originalProgramArguments
    originalProgramAliases originalProgramSidecars originalCompilerSourceMaps))
