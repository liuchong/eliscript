             (js-array "tests/eliscript/direct-wasm-value-json-page.eli" "tests/helpers/direct-wasm-value-json-page.mjs")
             (js-array "tests/eliscript/direct-wasm-error-profile.eli" "tests/helpers/direct-wasm-error-profile.mjs")
             (js-array "tests/eliscript/direct-wasm-error-profile-tests.eli" "tests/direct-wasm-error-profile-selfhosted.test.mjs")
             (js-array "tests/eliscript/direct-wasm-registration-tests.eli" "tests/direct-wasm-registration-selfhosted.test.mjs")))
           (index 0))
      (unless (= (get proof :sourceSha256) "542fd41674f45c68e0f8e1bddd574d57f5d14cc7df80e906f23452cf304cbace")
        (throw (new globalThis.TypeError "original direct WASM assertion archive identity changed")))
      (while (< index (js-length pairs))
        (let* ((pair (aref pairs index)) (source (await (browser-source-asset options (aref pair 0))))
               (generated (await (browser-source-asset options (aref pair 1))))
               (mapping (await (browser-source-asset options (str (aref pair 1) ".map"))))
               (map (JSON/parse (get mapping :source))))
          (unless (and (= (get map :version) 3) (= (js-length (get map :sourcesContent)) 1)
                       (= (aref (get map :sourcesContent) 0) (get source :source))
                       (= (js-call posix :normalize (js-call posix :join (js-call posix :dirname (aref pair 1))
                         (aref (get map :sources) 0))) (aref pair 0)))
            (throw (new globalThis.TypeError "direct WASM maintained map does not bind its actual source")))
          (js-call assets :push (get source :proof) (get generated :proof) (get mapping :proof)))
        (setq index (1+ index)))
      (js-object :assertionSource (Object/assign (js-object) proof (js-object :region
          (js-object :start 0 :end (js-length (get original :source)) :byteStart 0 :byteEnd (get proof :bytes)
            :sha256 (get proof :sourceSha256))))
        :executedSuite "tests/direct-wasm-backend.test.mjs" :sourceAssets assets
        :registration "complete-native-bun-registration-with-exact-maintained-callbacks")))
  (defun project-entry-record (record javascript identity bridge-assets direct-migration)
    (if (and (js-call (js-array "original-managed-fixture:project-entry:node"
                              "original-managed-fixture:project-entry:bun") :includes (get record :id))
             (= (get (get record :original) :fixture) entry-fixture))
      (let* ((original (get record :original))
             (assets (js-call (get original :sourceAssets (js-array)) :slice))
             (previous (js-call assets :find (lambda (item) (= (get item :file) host-source-file))))
             (proof (js-object :file host-source-file :sourceSha256 (get identity :sha256))))
        (when (and previous (/= (get previous :sourceSha256) (get proof :sourceSha256)))
          (throw (new globalThis.TypeError "original project-entry host source asset identity conflicts")))
        (unless previous (js-call assets :push proof))
        (js-call bridge-assets :forEach (lambda (asset)
          (let ((prior (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
            (when (and prior (/= (get prior :sourceSha256) (get asset :sourceSha256)))
              (throw (new globalThis.TypeError "original project-entry host bridge source identity conflicts")))
            (unless prior (js-call assets :push asset)))))
        (js-call (get direct-migration :sourceAssets) :forEach (lambda (asset)
          (let ((prior (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
            (when (and prior (/= (get prior :sourceSha256) (get asset :sourceSha256)))
              (throw (new globalThis.TypeError "direct WASM source archive conflicts with its actual execution assets")))
            (unless prior (js-call assets :push asset)))))
        (Object/assign (js-object) record
          (js-object :execution (Object/assign (js-object) (get record :execution)
                       (js-object :hostSource javascript))
            :original (Object/assign (js-object) original (js-object :sourceAssets assets
              :suite (get (get direct-migration :assertionSource) :file)
              :sourceSha256 (get (get direct-migration :assertionSource) :sourceSha256)
              :assertionSource (get direct-migration :assertionSource)
              :directWasmSourceMigration direct-migration))))) record))
  (defun intrinsic-observation (value)
    (cond ((undefined? value) (js-object :$eliscriptObservation "undefined"))
      ((= (value-type value) "bigint") (js-object :$eliscriptObservation "bigint" :decimal (globalThis.String value)))
      ((and (= (value-type value) "number") (Object/is value -0)) (js-object :$eliscriptObservation "-0"))
      ((and (= (value-type value) "number") (not (Number/isFinite value)))
        (js-object :$eliscriptObservation (globalThis.String value)))
      ((Array/isArray value) (js-call value :map intrinsic-observation))
      ((and (not (eq value nil)) (= (value-type value) "object"))
        (Object/fromEntries (js-call (Object/entries value) :map
          (lambda (entry) (js-array (aref entry 0) (intrinsic-observation (aref entry 1)))))))
      (t value)))
  (defun intrinsic-call (name arguments expected)
    (js-object :name name :javascriptName (js-call name :replaceAll "-" "_")
      :args (intrinsic-observation arguments) :expected (intrinsic-observation expected)))
  (defasync addOriginalManagedLanguageIntrinsics (options)
    (let ((fixture "tests/fixtures/wasm-managed-language-intrinsics.eli"))
      (when (js-call (get options :stableFiles) :has fixture)
        (let* ((input (await (browser-source-asset options fixture)))
               (suite "tests/wasm-managed-language-intrinsics.test.mjs")
               (suite-source "tests/eliscript/wasm-managed-language-intrinsics.eli")
               (suite-proof (get (await (browser-source-asset options suite)) :proof))
               (maintained-proof (get (await (browser-source-asset options suite-source)) :proof))
               (rows (js-array
                 (js-array "0" (globalThis.BigInt 0)) (js-array "-0" (globalThis.BigInt 0))
                 (js-array " 42 " (globalThis.BigInt 42)) (js-array "0xFF" (globalThis.BigInt 255))
                 (js-array "0o17" (globalThis.BigInt 15)) (js-array "0b101" (globalThis.BigInt 5))
                 (js-array "9007199254740993123456789" (globalThis.BigInt "9007199254740993123456789"))
                 (js-array "" (globalThis.BigInt 0)) (js-array "bad" nil) (js-array "1.2" nil)
                 (js-array "1e3" nil) (js-array "1N" nil) (js-array "0x" nil)
                 (js-array nil nil) (js-array undefined nil) (js-array false (globalThis.BigInt 0))
                 (js-array t (globalThis.BigInt 1)) (js-array 42 (globalThis.BigInt 42))
                 (js-array -42 (globalThis.BigInt -42)) (js-array -0 (globalThis.BigInt 0))
                 (js-array 1.5 nil) (js-array globalThis.NaN nil) (js-array globalThis.Infinity nil)
                 (js-array (globalThis.BigInt "9223372036854775808") (globalThis.BigInt "9223372036854775808"))))
               (calls (js-call rows :map (lambda (row) (intrinsic-call "parse-bigint" (js-array (aref row 0)) (aref row 1)))))
               (owner (js-object :undefined -0 :NaN 17 :Infinity 23)))
          (js-call (js-array nil undefined false t -0 globalThis.NaN globalThis.Infinity "") :forEach (lambda (value)
            (js-call calls :push (intrinsic-call "qualified-nullish" (js-array value) (nullish? value)))))
          (js-call calls :push
            (intrinsic-call "choose" (js-array) "none") (intrinsic-call "choose" (js-array -0) -0)
            (intrinsic-call "conversion-throw" (js-array) nil)
            (intrinsic-call "conversion-reentry" (js-array) (globalThis.BigInt 42))
            (intrinsic-call "qualified-undefined" (js-array) (js-array undefined undefined))
            (intrinsic-call "qualified-numbers" (js-array) (js-array globalThis.NaN globalThis.NaN globalThis.Infinity globalThis.Infinity))
            (intrinsic-call "qualified-shadow" (js-array owner) (js-array -0 -0 17 17 23 23))
            (intrinsic-call "qualified-capture" (js-array owner) -0)
            (intrinsic-call "qualified-getters" (js-array) (js-array -0 -0 17 17 23 23 2))
            (intrinsic-call "qualified-number-shadow" (js-array) (js-array 31 32 33)))
          (let* ((entry "language-intrinsics.mjs")
                 (request (js-object :operation "project" :resolveImports t :phased t :sourceMap t :entry entry
                   :entries (js-array entry) :modules (js-array (js-object :id entry :filename fixture :source (get input :source)))))
                 (artifact (js-object :kind "exports" :auto 1 :calls calls :valueEncoding "eliscript-observation-v1")))
            (js-call options :add (js-object :id "original-sequence:managed-language-intrinsics-source" :kind "sequence"
              :coverage (js-array (str "stable-compatibility:" fixture))
              :original (js-object :fixture fixture :suite suite :sourceSha256 (get (get input :proof) :sourceSha256)
                :sourceAssets (js-array (get input :proof) suite-proof maintained-proof)
                :semanticCoverage "source-fixture-public-operations"
                :unclaimedAssertions "raw ABI, forged IR, native linkage and exceptional host frames remain in the complete original suite")
              :expected (js-object :kind "sequence") :steps (js-array
                (js-object :id "first" :request request :artifact artifact)
                (js-object :id "repeat" :request (globalThis.structuredClone request)
                  :artifact (globalThis.structuredClone artifact) :sameProductAs "first")))))))))
  (defasync project-entry-adapters (options)
    (if (or (nullish? options) (/= (value-type (get options :add)) "function")
            (/= (value-type (get options :text)) "function")
            (/= (value-type (get options :file)) "function")
            (nullish? (get options :stableFiles))
            (not (js-call (get options :stableFiles) :has entry-fixture))
            (not (js-call (get options :stableFiles) :has state-fixture)))
      (await (js-call ground :addOriginalManagedFixtureAdapters options))
      (let* ((source (await (js-call options :text host-source-file)))
             (identity (await (js-call options :file host-source-file))))
        (unless (and (= (value-type source) "string") (= (hash source) (get identity :sha256))
                     (= (js-call Buffer :byteLength source) (get identity :bytes)))
          (throw (new globalThis.TypeError "original project-entry host text differs from its source asset")))
        (let* ((javascript (compile-string source host-source-file))
               (dependency (await (readOriginalProcessHostDependency options)))
               (bridge-assets (js-array)) (index 0)
               (direct-migration (await (direct-wasm-source-migration options)))
               (add (get options :add)) (forwarded (Object/assign (js-object) options)))
          (while (< index (js-length host-bridge-files))
            (let* ((filename (aref host-bridge-files index)) (asset (await (js-call options :file filename))))
              (js-call bridge-assets :push (js-object :file filename :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (put forwarded :add (lambda (record)
            (let ((selected (project-entry-record record javascript identity bridge-assets direct-migration)))
              (funcall add (if (js-call (js-array "original-managed-fixture:project-entry:node"
                  "original-managed-fixture:project-entry:bun") :includes (get record :id))
                (bindOriginalProcessHostDependency selected dependency) selected)))))
          (await (js-call ground :addOriginalManagedFixtureAdapters forwarded))))))
