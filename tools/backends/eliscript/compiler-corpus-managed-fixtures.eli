  (defun raw-fixture-javascript-host (old family helper-url)
    (if (not (js-call (js-array "catch-destructuring" "typeof" "js-cons" "object-properties" "array-construction" "primitive-operators" "objects") :includes family)) old
      (let* ((boundary "const {root,product,entry,reference,m,oracle,runtime,compare,outcome,named,finish}=fixture;\n")
             (start (js-call old :indexOf boundary))
             (configuration (js-object :family family :originalHostSha256 (hash old))))
        (unless (and (>= start 0) (= (js-call old :indexOf boundary (1+ start)) -1))
          (throw (new globalThis.TypeError "original fixture context boundary changed")))
        (let* ((program (compile-string (str "(import " (JSON/stringify helper-url) " finishOriginalFixtureObservation)\n"
                   "(put (js* \"fixture\") :report (lambda (observations groups)"
                   " (finishOriginalFixtureObservation (JSON/parse " (JSON/stringify (JSON/stringify configuration))
                   ") observations groups)))") "original-fixture-observation-counter.eli"))
               (end (+ start (js-length boundary))))
          (str (js-call old :slice 0 end) program (js-call old :slice end))))))
  (defasync fixture-observation-options (options)
    (if (or (nullish? options) (nullish? (get options :stableFiles))
            (/= (value-type (get options :add)) "function")) options
      (let* ((families (js-call (js-array "function-properties" "math") :concat raw-basic-families raw-special-families raw-language-families))
             (selected (js-call families :filter (lambda (family)
               (js-call (get options :stableFiles) :has (raw-fixture-file family))))))
        (if (= (js-length selected) 0) options
          (let* ((assets (js-array)) (keys (js-array)) (suite-proofs (new globalThis.Map))
                 (files (js-call host-bridge-files :concat (js-array host-source-file
                   "tools/backends/compiler-corpus-project-entry-host.mjs"
                   "tools/backends/eliscript/compiler-corpus-managed-adapters.eli"
                   "tools/backends/compiler-corpus-managed-adapters.mjs"
                   "tools/backends/eliscript/compiler-corpus-process.eli"
                   "tools/backends/compiler-corpus-process.mjs")))
                 (helper (get (pathToFileURL (resolve (get options :sourceRoot)
                   "tools/backends/compiler-corpus-project-entry-host.mjs")) :href))
                 (index 0) (add (get options :add)))
            (when (js-call selected :includes "function-properties")
              (let* ((suite "tests/wasm-managed-function-properties.test.mjs")
                     ;; Preserve the original parser boundary: invalid raw
                     ;; templates reject before any provenance file is loaded.
                     (fixture-source (await (js-call options :text (raw-fixture-file "function-properties"))))
                     (source (await (js-call options :text suite)))
                     (model-file "tests/helpers/wasm-managed-function-properties-node.eli")
                     (admission (unless (and (js-call source :includes "const reflection_source =")
                         (js-call source :includes "./helpers/wasm-managed-function-properties-node.mjs"))
                       (throw (new globalThis.TypeError "original managed reflection source declaration changed"))))
                     (model (await (browser-source-asset options model-file)))
                     (nodes (get (aref (read-string (get model :source) model-file) 0) :items))
                     (symbols (js-call nodes :filter (lambda (node)
                       (let ((items (get node :items)))
                         (and (Array/isArray items) (= (get (aref items 0) :name) "defconst")
                              (= (get (aref items 1) :name) "well-known-symbol-names"))))))
                     (names (js-array "isFinite" "missing" "name" "length" "prototype" "caller" "arguments"
                       "call" "apply" "bind" "constructor" "toString" "__proto__" "parseInt" "parseFloat"
                       "fromCharCode" "fromCodePoint" "raw")))
                (unless (and (= (js-length symbols) 1)
                  (js-call source :includes "standard_error_own_names")
                  (js-call source :includes "standard_error_shape")
                  (js-call source :includes "currentHostBuiltinShape")
                  (js-call source :includes "spawnSync(\"node\""))
                  (throw (new globalThis.TypeError "function properties requires its complete original Node oracle and standard Error contract")))
                (let* ((value (aref (get (aref symbols 0) :items) 2)) (items (get value :items)))
                  (unless (and (Array/isArray items) (= (get (aref items 0) :name) "js-array")
                               (= (js-length items) 16)
                               (js-call (js-call items :slice 1) :every (lambda (node)
                                 (and (= (get node :kind) "literal") (= (value-type (get node :value)) "string")))))
                    (throw (new globalThis.TypeError "function reflection symbols must remain fifteen literal names")))
                  (setq keys (js-call names :concat (js-call (js-call items :slice 1) :map (lambda (node) (get node :value))))))
                (js-call assets :push (get model :proof))
                (js-call files :push "tests/helpers/wasm-managed-function-properties-node.mjs")
                (let ((asset (await (browser-source-asset options suite))))
                  (unless (= (get asset :source) source)
                    (throw (new globalThis.TypeError "original function properties source changed during authentication")))
                  (js-call assets :push (get asset :proof)))))
            (when (js-call selected :some (lambda (family) (/= family "function-properties")))
              (js-call files :push "tools/backends/eliscript/compiler-corpus-raw-fixture-observer.eli"
                "tools/backends/compiler-corpus-raw-fixture-observer.mjs"
                "tools/backends/eliscript/compiler-corpus-raw-language-fixtures.eli" "tools/backends/compiler-corpus-raw-language-fixtures.mjs"
                "tools/backends/eliscript/compiler-corpus-raw-special-fixtures.eli" "tools/backends/compiler-corpus-raw-special-fixtures.mjs"
                "tools/backends/eliscript/compiler-corpus-raw-math-fixture.eli" "tools/backends/compiler-corpus-raw-math-fixture.mjs"
                "tests/helpers/wasm-managed-math-node.eli" "tests/helpers/wasm-managed-math-node.mjs"))
            (let ((suite-index 0))
              (while (< suite-index (js-length selected))
                (let* ((family (aref selected suite-index))
                       (suite (if (js-call family :startsWith "persistent-vector-auto-") "tests/managed-persistent-vector.test.mjs" (str "tests/wasm-managed-" family ".test.mjs")))
                       (asset (await (browser-source-asset options suite))))
                  (js-call suite-proofs :set family (get asset :proof))
                  (js-call assets :push (get asset :proof)))
                (setq suite-index (1+ suite-index))))
            (while (< index (js-length files))
              (let ((asset (await (browser-source-asset options (aref files index)))))
                (js-call assets :push (get asset :proof)))
              (setq index (1+ index)))
            (Object/assign (js-object) options (js-object :add (lambda (record)
              (let* ((match (js-call (new globalThis.RegExp "^original-managed-fixture:([^:]+):(node|bun)$") :exec (get record :id)))
                     (family (and match (aref match 1))))
                (if (not (and family (js-call selected :includes family))) (funcall add record)
                  (let* ((execution (get record :execution)) (original (get record :original))
                         (old (get execution :hostSource)) (proofs (js-call (get original :sourceAssets (js-array)) :slice))
                         (properties (= family "function-properties"))
                         (kind (cond ((= family "math") "math-fixture")
                           ((js-call raw-basic-families :includes family) "fixture-observer")
                           ((js-call raw-special-families :includes family) "special-fixtures") (t "language-fixtures")))
                         (raw-export (cond ((= family "math") "runOriginalRawMathFixtureHost")
                           ((js-call raw-basic-families :includes family) "runOriginalRawFixtureHost")
                           ((js-call raw-special-families :includes family) "runOriginalRawSpecialFixtureHost") (t "runOriginalRawLanguageFixtureHost")))
                         (suite-proof (js-call suite-proofs :get family))
                         (raw-config (js-object :family family :helper (str "tools/backends/compiler-corpus-raw-" kind ".mjs")
                           :export raw-export :auto (get record :auto 1) :suite (get suite-proof :file)
                           :sourceSha256 (get suite-proof :sourceSha256) :originalHostSha256 (hash old)))
                         (entry (if properties "runOriginalFunctionPropertiesHost" "runOriginalRawFixtureMain"))
                         (forms (str "(import " (JSON/stringify helper) " " entry ")\n"
                           (originalManagedProgramCompletionSource (str "(await (" entry " "
                             (if properties (str "(JSON/parse " (JSON/stringify (JSON/stringify keys)) ")")
                               (str "(JSON/parse " (JSON/stringify (JSON/stringify raw-config)) ")")) "))")))))
                    (unless (= (get original :fixture) (raw-fixture-file family))
                      (throw (new globalThis.TypeError "original fixture observer source identity mismatch")))
                    (js-call assets :forEach (lambda (asset)
                      (let ((prior (js-call proofs :find (lambda (item) (= (get item :file) (get asset :file))))))
                        (when (and prior (/= (get prior :sourceSha256) (get asset :sourceSha256)))
                          (throw (new globalThis.TypeError "original fixture observer source evidence conflict")))
                        (unless prior (js-call proofs :push asset)))))
                    (funcall add (Object/assign (js-object) record
                      (js-object :execution (Object/assign (js-object) execution
                        (js-object :hostSource (compile-string forms "original-fixture-observer.eli")
                          :javascriptHostSource (if properties (compile-string forms "original-fixture-observer.eli")
                            (raw-fixture-javascript-host old family (get (pathToFileURL (resolve (get options :sourceRoot)
                              "tools/backends/compiler-corpus-raw-language-fixtures.mjs")) :href)))))
                        :original (Object/assign (js-object) original (js-object :sourceAssets proofs
                          :observationTransport (js-object :version 1 :family family
                            :originalHostSource old :originalHostSha256 (hash old)
                            :binaryObservation (if properties "original-node-oracle-standard-error" "original-raw-suite"))))))))))))))))))
  (defasync addOriginalManagedFixtureAdapters (options)
    (setq options (await (fixture-observation-options options)))
    (if (or (nullish? options) (/= (value-type (get options :add)) "function")
            (/= (value-type (get options :text)) "function") (/= (value-type (get options :file)) "function")
            (nullish? (get options :stableFiles)))
      (await (project-entry-adapters options))
      (let* ((add (get options :add)) (pending undefined)
             (forwarded (Object/assign (js-object) options (js-object :add (lambda (record)
               (if (= (get record :id) "original-managed-suite:complete-fixture-suites")
                 (setq pending record) (funcall add record)))))))
        (when (js-call (js-array "tests/fixtures/managed-splice-rejected.eli" "tests/fixtures/managed-splice-species.eli"
                    "tests/fixtures/managed-splice-accessor.eli" "tests/fixtures/managed-splice-observe.eli") :some
                (lambda (filename) (js-call (get options :stableFiles) :has filename)))
          (let* ((suite "tests/wasm-managed-array-splice.test.mjs")
                 (source (await (browser-source-asset options "tests/wasm-managed-array-splice-test-ground.mjs")))
                 (wrapper (await (browser-source-asset options suite))) (proof (get wrapper :proof))
                 (cases (originalSourceCaseLocators suite (get source :source)))
                 (selection (js-call (get options :locators) :slice)))
            (unless (and (= (get proof :sourceSha256) "947ceebb36b4822653b18f9e4d1cf3dd0131091a0405f212389fb8c416063fe0")
                         (= (js-length cases) 11))
              (throw (new globalThis.TypeError "maintained splice inputs require the complete unchanged original suite")))
            ;; This selects a real whole-suite execution; it is not a source
            ;; case locator and cannot invent a case ID or coverage claim.
            (js-call selection :push (Object/assign (js-object) proof
              (js-object :kind "maintained-fixture-execution-selection")))
            (put forwarded :locators selection)))
        (when (js-call (get options :stableFiles) :has "tests/fixtures/wasm-managed-js-cons-fast.eli")
          (let* ((source (await (browser-source-asset options "tests/wasm-managed-js-cons-fast.test.mjs")))
                 (selection (js-call (get forwarded :locators) :slice)))
            (js-call selection :push (Object/assign (js-object) (get source :proof)
              (js-object :kind "maintained-fixture-execution-selection")))
            (put forwarded :locators selection)))
        (when (js-call (get options :stableFiles) :has "tests/fixtures/persistent-vector-copy.eli")
          (let* ((source (await (browser-source-asset options "tests/wasm-managed-vector-copy.test.mjs")))
                 (selection (js-call (get forwarded :locators) :slice)))
            (js-call selection :push (Object/assign (js-object) (get source :proof)
              (js-object :kind "maintained-fixture-execution-selection")))
            (put forwarded :locators selection)))
        (when (js-call (get options :stableFiles) :has "tests/fixtures/wasm-managed-type-construction.eli")
          (let* ((source (await (browser-source-asset options "tests/wasm-managed-type-construction.test.mjs")))
                 (selection (js-call (get forwarded :locators) :slice)))
            (js-call selection :push (Object/assign (js-object) (get source :proof)
              (js-object :kind "maintained-fixture-execution-selection")))
            (put forwarded :locators selection)))
        (let ((result (await (project-entry-adapters forwarded))))
        (await (addOriginalManagedLanguageIntrinsics options))
        ;; Only a complete real replay can acquire the migration evidence.
        ;; Original fixture/template failures precede all extra asset reads.
        (when pending
          (funcall add (await (final-fixture-record (await (static-data-fixture-record
            (browser-suite-record pending (await (readOriginalManagedSuiteMigrations options)) options) options)) options))))
        result))))
  (export addOriginalManagedFixtureAdapters addOriginalManagedLanguageIntrinsics readOriginalManagedStaticTemplate buildBackends bindOriginalManagedSourceEvidence readOriginalManagedSuiteMigrations readOriginalManagedBrowserCases readOriginalStaticDataFixtureMigration readOriginalFinalFixtureMigrations readOriginalManagedFixtureRepairs))
