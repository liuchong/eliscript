  (defun portable-predicate-cases (suite source)
    (originalPredicateSourceCases suite source))
  (defun final-fixture-cases (suite source)
    (cond
      ((= suite "tests/native-node-memory.test.mjs")
       ;; Equal-width parser view, followed by proof of the unmodified bytes.
       (js-call (originalSourceCaseLocators suite (js-call (js-call source :split "nativeTest") :join "actualTest"))
         :map (lambda (item)
           (let* ((original (get item :originalCase)) (span (get original :span)))
             (put original :registration "nativeTest") (put original :sourceSha256 (hash source))
             (put original :sha256 (hash (js-call source :slice (get span :start) (get span :end)))) item))))
      ((= suite "tests/compiler-portable-predicates.test.mjs") (portable-predicate-cases suite source))
      ((= suite "tests/wasm-managed-object-integrity.test.mjs") (originalIntegritySourceCases suite source))
      (t (originalSourceCaseLocators suite source))))
  (defasync readOriginalFinalFixtureMigrations (options)
    (let ((result (js-array)) (plan-index 0))
      (while (< plan-index (js-length final-fixture-plans))
        (let* ((plan (aref final-fixture-plans plan-index)) (archive (get plan :archive))
               (original (await (browser-source-asset options archive))) (proof (get original :proof))
               (cases (final-fixture-cases (get plan :suite) (get original :source)))
               (assets (js-array proof)) (pairs (get plan :pairs)) (index 0))
          (unless (and (= (get proof :sourceSha256) (get plan :sha256)) (= (js-length cases) (get plan :count)))
            (throw (new globalThis.TypeError (str "original final fixture identity or full case inventory changed: " archive))))
          (while (< index (js-length pairs))
            (let* ((pair (aref pairs index)) (source (await (browser-source-asset options (aref pair 0))))
                   (generated (await (browser-source-asset options (aref pair 1))))
                   (mapping (await (browser-source-asset options (str (aref pair 1) ".map"))))
                   (map (JSON/parse (get mapping :source))))
              (unless (and (= (get map :version) 3) (= (get map :file) (js-call posix :basename (aref pair 1)))
                           (= (js-length (get map :sources)) 1) (= (js-length (get map :sourcesContent)) 1)
                           (= (aref (get map :sourcesContent) 0) (get source :source))
                           (= (js-call posix :normalize (js-call posix :join (js-call posix :dirname (aref pair 1))
                             (aref (get map :sources) 0))) (aref pair 0)))
                (throw (new globalThis.TypeError (str "final fixture map does not bind its maintained source: " (aref pair 1)))))
              (js-call assets :push (get source :proof) (get generated :proof) (get mapping :proof)))
            (setq index (1+ index)))
          (let ((inputs (get plan :inputs (js-array))))
            (let ((position 0))
              (while (< position (js-length inputs))
                (js-call assets :push (get (await (browser-source-asset options (aref inputs position))) :proof))
                (setq position (1+ position)))))
          (js-call result :push (js-object :suite (get plan :suite) :executedSuite (get plan :executedSuite (get plan :suite))
            :sourceAssets assets :existingReplaySuite (get plan :replay)
            :execution "final-make-gate-only-not-a-target-record" :gateCommand "make test" :targetExecution false
            :assertionSource (Object/assign (js-object) proof (js-object :cases
              (js-call cases :map (lambda (item)
                (Object/assign (js-object) item (js-object :file archive :sourceFile archive :originalSuite (get plan :suite)
                  :originalCase (Object/assign (js-object) (get item :originalCase) (js-object :sourceFile archive)))))))))))
        (setq plan-index (1+ plan-index)))
      result))
  (defasync final-fixture-record (record options)
    (let* ((original (get record :original)) (migrations (await (readOriginalFinalFixtureMigrations options)))
           (repairs (await (readOriginalManagedFixtureRepairs options)))
           (assets (js-call (get original :sourceAssets (js-array)) :slice))
           (coverage (js-call (get record :coverage) :slice)) (fixture-inputs (js-array)))
      (js-call migrations :forEach (lambda (migration)
        (when (and (get migration :existingReplaySuite)
          (not (js-call (get original :suites) :some (lambda (suite) (= (get suite :file) (get migration :suite))))))
          (throw (new globalThis.TypeError "migrated final fixture is absent from its actual original replay")))
        (js-call (get migration :sourceAssets) :forEach (lambda (asset)
          (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
            (when (and previous (/= (get previous :sourceSha256) (get asset :sourceSha256)))
              (throw (new globalThis.TypeError "final fixture source identity conflicts with original replay")))
            (unless previous (js-call assets :push asset)))))))
      (js-call (get repairs :sourceAssets) :forEach (lambda (asset)
        (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
          (when (and previous (/= (get previous :sourceSha256) (get asset :sourceSha256)))
            (throw (new globalThis.TypeError "managed fixture repair source identity conflicts with its original replay")))
          (unless previous (js-call assets :push asset)))))
      (let ((supplemental (js-array
              (js-array "tests/fixtures/wasm-managed-js-cons-fast.eli" "tests/eliscript/js-cons-fast-path.eli" "tests/wasm-managed-js-cons-fast.test.mjs" 3)
              (js-array "tests/fixtures/persistent-vector-copy.eli" "tests/eliscript/persistent-vector-copy.eli" "tests/wasm-managed-vector-copy.test.mjs" 3)
              (js-array "tests/fixtures/wasm-managed-type-construction.eli" "tests/eliscript/managed-type-construction.eli" "tests/wasm-managed-type-construction.test.mjs" 10)))
            (position 0))
        (while (< position (js-length supplemental))
          (let* ((plan (aref supplemental position)) (filename (aref plan 0))
                 (source-file (aref plan 1)) (suite (aref plan 2)))
            (when (js-call (get options :stableFiles) :has filename)
              (let* ((source (await (browser-source-asset options source-file)))
               (generated (await (browser-source-asset options suite)))
               (mapping (await (browser-source-asset options (str suite ".map"))))
               (map (JSON/parse (get mapping :source)))
               (cases (readOriginalManagedBrowserCases (get source :source) source-file)))
          (unless (and (= (js-length cases) (aref plan 3))
                       (js-call (get original :suites) :some (lambda (item) (= (get item :file) suite)))
                       (js-call (get (get record :execution) :hostSource) :includes (JSON/stringify suite))
                       (= (get map :version) 3) (= (get map :file) (js-call posix :basename suite))
                       (= (js-length (get map :sources)) 1) (= (js-length (get map :sourcesContent)) 1)
                       (= (aref (get map :sourcesContent) 0) (get source :source))
                       (= (js-call posix :normalize (js-call posix :join (js-call posix :dirname suite)
                         (aref (get map :sources) 0))) source-file)
                       (js-call cases :every (lambda (item)
                         (js-call (get generated :source) :includes (JSON/stringify (get (get item :originalCase) :title))))))
            (throw (new globalThis.TypeError (str suite " requires its real complete replay and maintained source map"))))
          (js-call (js-array source generated mapping) :forEach (lambda (item)
            (let ((proof (get item :proof)))
              (unless (js-call assets :some (lambda (asset) (= (get asset :file) (get proof :file))))
                (js-call assets :push proof))))))))
          (setq position (1+ position))))
      ;; These complete suites execute the maintained fixture inputs. Their
      ;; generated entry is not the original source text scanned by the old
      ;; builder, so retain the real archive/helper and input identities.
      (let ((plans (js-array
              (js-array "tests/fixtures/wasm-managed-text.eli" "tests/wasm-managed-runtime.test.mjs"
                "tests/wasm-managed-runtime-test-ground.mjs")
              (js-array "tests/fixtures/managed-splice-rejected.eli" "tests/wasm-managed-array-splice.test.mjs"
                "tools/testing/managed-array-repairs.eli")
              (js-array "tests/fixtures/managed-splice-species.eli" "tests/wasm-managed-array-splice.test.mjs"
                "tools/testing/managed-array-repairs.eli")
              (js-array "tests/fixtures/managed-splice-accessor.eli" "tests/wasm-managed-array-splice.test.mjs"
                "tools/testing/managed-array-repairs.eli")
              (js-array "tests/fixtures/managed-splice-observe.eli" "tests/wasm-managed-array-splice.test.mjs"
                "tools/testing/managed-array-repairs.eli")
              (js-array "tests/fixtures/wasm-managed-js-cons-fast.eli" "tests/wasm-managed-js-cons-fast.test.mjs"
                "tests/eliscript/js-cons-fast-path.eli")
              (js-array "tests/fixtures/persistent-vector-copy.eli" "tests/wasm-managed-vector-copy.test.mjs"
                "tests/eliscript/persistent-vector-copy.eli")
              (js-array "tests/fixtures/wasm-managed-type-construction.eli" "tests/wasm-managed-type-construction.test.mjs"
                "tests/eliscript/managed-type-construction.eli"))) (index 0))
        (while (< index (js-length plans))
          (let* ((plan (aref plans index)) (filename (aref plan 0)) (suite (aref plan 1))
                 (maintained (aref plan 2)))
            (when (js-call (get options :stableFiles) :has filename)
              (unless (js-call (get original :suites) :some (lambda (item) (= (get item :file) suite)))
                (throw (new globalThis.TypeError "maintained fixture input is absent from its complete original replay")))
              (let* ((input (get (await (browser-source-asset options filename)) :proof))
                     (source (await (browser-source-asset options maintained)))
                     (proof (get source :proof)) (id (str "stable-compatibility:" filename)))
                (unless (js-call assets :some (lambda (asset)
                  (and (= (get asset :file) maintained) (= (get asset :sourceSha256) (get proof :sourceSha256)))))
                  (throw (new globalThis.TypeError "maintained fixture input lost its authenticated execution source")))
                (unless (if (or (= index 2) (= index 3))
                  (and (js-call (get source :source) :includes "tests/fixtures/managed-splice-")
                    (js-call (get source :source) :includes "(js-array \"species\" \"accessor\")"))
                  (js-call (get source :source) :includes filename))
                  (throw (new globalThis.TypeError "maintained execution source no longer reads its declared fixture input")))
                (let ((previous (js-call assets :find (lambda (asset) (= (get asset :file) filename)))))
                  (when (and previous (/= (get previous :sourceSha256) (get input :sourceSha256)))
                    (throw (new globalThis.TypeError "maintained fixture input differs from its retained source asset")))
                  (unless previous (js-call assets :push input)))
                (unless (js-call coverage :includes id) (js-call coverage :push id))
                (js-call fixture-inputs :push (Object/assign (js-object) input
                  (js-object :suite suite :coverageId id :executionSource proof
                    :execution "complete-maintained-original-suite-input"))))))
          (setq index (1+ index))))
      (Object/assign (js-object) record (js-object :coverage coverage :original
        (Object/assign (js-object) original (js-object :sourceAssets assets :finalGateSuiteMigrations migrations
          :fixtureRepairs repairs :maintainedFinalFixtureInputs fixture-inputs))))))
  (defasync readOriginalManagedFixtureRepairs (options)
    (let ((assets (js-array)) (suites (js-array))
          (plans (js-array
