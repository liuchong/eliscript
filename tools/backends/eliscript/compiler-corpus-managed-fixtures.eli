  (defasync browser-source-asset (options filename)
    (let* ((source (await (js-call options :text filename)))
           (identity (await (js-call options :file filename))))
      (unless (and (= (value-type source) "string") (= (get identity :file) filename)
                   (= (hash source) (get identity :sha256))
                   (= (js-call Buffer :byteLength source) (get identity :bytes))
                   (= (get identity :encoding) "base64")
                   (js-call (js-call Buffer :from source) :equals
                     (js-call Buffer :from (get identity :content) "base64")))
        (throw (new globalThis.TypeError (str "managed browser source differs from its actual asset: " filename))))
      (js-object :source source :proof (js-object :file filename
        :sourceSha256 (get identity :sha256) :bytes (get identity :bytes)))))
  (defun readOriginalManagedBrowserCases (source filename)
    (let ((pending (read-string source filename)) (cases (js-array)))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :shift)) (items (get node :items))
               (head (and (Array/isArray items) (> (js-length items) 0) (get (aref items 0) :name))))
          (when (Array/isArray items)
            (cond
              ((= head "quote") nil)
              ((= head "test")
                (let* ((title-node (aref items 1)) (title (get title-node :value))
                       (timeout-node (aref items 3))
                       (timeout (if (= (js-length items) 3) 5000 (get timeout-node :value))))
                  (unless (and (js-call (js-array 3 4) :includes (js-length items))
                               (= (get title-node :kind) "literal") (= (value-type title) "string")
                               (Number/isSafeInteger timeout) (> timeout 0))
                    (throw (new globalThis.TypeError (str "maintained managed browser case requires its literal title and deadline: " filename))))
                  (js-call cases :push (js-object :originalCase
                    (js-object :title title :timeoutMs timeout :sourceFile filename)))))
              (t (Reflect/apply (get pending :push) pending items))))))
      cases))
  (defasync readOriginalManagedSuiteMigrations (options)
    (let ((result (js-array)) (index 0))
      (while (< index (js-length browser-suite-plans))
        (let* ((plan (aref browser-suite-plans index)) (suite (get plan :suite))
               (archive (get plan :archive)) (original (await (browser-source-asset options archive)))
               (proof (get original :proof))
               (cases (originalSourceCaseLocators suite (get original :source)))
               (assets (js-array proof)) (actual-cases (js-array)) (position 0))
          (unless (and (= (get proof :sourceSha256) (get plan :sha256))
                       (= (js-length cases) (get plan :count)))
            (throw (new globalThis.TypeError (str "original managed browser suite identity changed: " archive))))
          (while (< position (js-length (get plan :pairs)))
            (let* ((pair (aref (get plan :pairs) position)) (source-file (aref pair 0))
                   (module-file (aref pair 1))
                   (source (await (browser-source-asset options source-file)))
                   (generated (await (browser-source-asset options module-file)))
                   (map-asset (await (browser-source-asset options (str module-file ".map"))))
                   (map (JSON/parse (get map-asset :source))))
              (unless (and (= (get map :version) 3) (= (get map :file) (js-call posix :basename module-file))
                           (Array/isArray (get map :sources)) (= (js-length (get map :sources)) 1)
                           (= (js-call posix :normalize (js-call posix :join (js-call posix :dirname module-file)
                                (aref (get map :sources) 0))) source-file)
                           (Array/isArray (get map :sourcesContent)) (= (js-length (get map :sourcesContent)) 1)
                           (= (aref (get map :sourcesContent) 0) (get source :source)))
                (throw (new globalThis.TypeError (str "managed browser map does not bind its maintained source: " module-file))))
              (js-call assets :push (get source :proof) (get generated :proof) (get map-asset :proof))
              (when (js-call (get plan :caseModules) :includes module-file)
                (Reflect/apply (get actual-cases :push) actual-cases
                  (readOriginalManagedBrowserCases (get source :source) source-file))))
            (setq position (1+ position)))
          (unless (and (= (js-length actual-cases) (js-length cases))
                       (js-call cases :every (lambda (item)
                         (= (js-length (js-call actual-cases :filter (lambda (actual)
                           (and (= (get (get actual :originalCase) :title) (get (get item :originalCase) :title))
                                (= (get (get actual :originalCase) :timeoutMs) (get (get item :originalCase) :timeoutMs)))))) 1))))
            (throw (new globalThis.TypeError (str "maintained managed browser suite lost an original case or deadline: " suite))))
          (setq position 0)
          (while (< position (js-length (get plan :fixtures)))
            (js-call assets :push (get (await (browser-source-asset options (aref (get plan :fixtures) position))) :proof))
            (setq position (1+ position)))
          (js-call result :push (js-object :suite suite :sourceAssets assets
            :assertionSource (Object/assign (js-object) proof (js-object :cases
              (js-call cases :map (lambda (item)
                (Object/assign (js-object) item (js-object :file archive :sourceFile archive
                  :originalSuite suite :originalCase (Object/assign (js-object) (get item :originalCase)
                    (js-object :sourceFile archive)))))))))))
        (setq index (1+ index)))
      result))
  (defun browser-suite-record (record migrations options)
    (if (/= (get record :id) "original-managed-suite:complete-fixture-suites") record
      (let* ((original (get record :original))
             (assets (js-call (get original :sourceAssets (js-array)) :slice))
             (coverage (js-call (get record :coverage) :slice)) (fixture-inputs (js-array)))
        (js-call migrations :forEach (lambda (migration)
          (unless (js-call (get original :suites) :some (lambda (suite) (= (get suite :file) (get migration :suite))))
            (throw (new globalThis.TypeError "migrated managed browser suite is absent from its complete original replay")))
          (js-call (get migration :sourceAssets) :forEach (lambda (asset)
            (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
              (if previous
                (unless (= (get previous :sourceSha256) (get asset :sourceSha256))
                  (throw (new globalThis.TypeError "managed browser replay source asset identity conflicts")))
                (js-call assets :push asset)))))
          (let ((plan (js-call browser-suite-plans :find (lambda (item) (= (get item :suite) (get migration :suite))))))
            (js-call (get plan :fixtures) :forEach (lambda (filename)
              (when (js-call (get options :stableFiles) :has filename)
                (let ((asset (js-call (get migration :sourceAssets) :find (lambda (item) (= (get item :file) filename))))
                      (id (str "stable-compatibility:" filename)))
                  (unless asset (throw (new globalThis.TypeError "complete managed replay lost its declared fixture input")))
                  (unless (js-call coverage :includes id) (js-call coverage :push id))
                  (js-call fixture-inputs :push (js-object :file filename :sourceSha256 (get asset :sourceSha256)
                    :suite (get migration :suite) :coverageId id :execution "complete-maintained-original-suite-input")))))))))
        (Object/assign (js-object) record (js-object :coverage coverage :original (Object/assign (js-object) original
          (js-object :sourceAssets assets :maintainedSuiteSources migrations :maintainedFixtureInputs fixture-inputs)))))))
  (defasync readOriginalStaticDataFixtureMigration (options)
    (let* ((suite "tests/wasm-memory-static-data.test.mjs")
           (archive "tests/wasm-memory-static-data-test-ground.mjs")
           (original (await (browser-source-asset options archive)))
           (proof (get original :proof)) (assets (js-array proof))
           (cases (originalSourceCaseLocators suite (get original :source)))
           (pairs (js-array
             (js-array "tools/testing/wasm-static-snapshot.eli" "tools/testing/wasm-static-snapshot.mjs")
             (js-array "tools/testing/wasm-static-repairs.eli" "tools/testing/wasm-static-repairs.mjs")
             (js-array "tools/testing/generated-fixture-module.eli" "tools/testing/generated-fixture-module.mjs")
             (js-array "tools/testing/portable-node-fixtures.eli" "tools/testing/portable-node-fixtures.mjs")
             (js-array "tests/eliscript/portable-node-build.eli" "tests/helpers/portable-node-build.mjs")
             (js-array "tests/eliscript/portable-node-test.eli" "tests/helpers/portable-node-test.mjs")
             (js-array "tests/eliscript/portable-node-install.eli" "tests/helpers/portable-node-install.mjs")
             (js-array "tools/testing/number-text-node.eli" "tools/testing/number-text-node.mjs")
             (js-array "tests/eliscript/wasm-memory-static-data.eli" suite)
             (js-array "tests/eliscript/wasm-static-snapshot-install.eli" "tests/helpers/wasm-static-snapshot-install.mjs")
             (js-array "tests/eliscript/wasm-static-snapshot-fixture.eli" "tests/wasm-static-snapshot-fixture-selfhosted.test.mjs")))
           (index 0))
      (unless (and (= (get proof :sourceSha256) "d0b9839cd2a5c75b6412e5d40985eb4c8b5d340e217a3381866b4452e7d2e7e5")
                   (= (js-length cases) 19))
        (throw (new globalThis.TypeError "original static-data fixture suite identity or case inventory changed")))
      (while (< index (js-length pairs))
        (let* ((pair (aref pairs index)) (source (await (browser-source-asset options (aref pair 0))))
               (generated (await (browser-source-asset options (aref pair 1))))
               (mapping (await (browser-source-asset options (str (aref pair 1) ".map"))))
               (map (JSON/parse (get mapping :source))))
          (unless (and (= (get map :version) 3) (= (get map :file) (js-call posix :basename (aref pair 1)))
                       (= (js-length (get map :sources)) 1) (= (js-length (get map :sourcesContent)) 1)
                       (= (aref (get map :sourcesContent) 0) (get source :source))
                       (= (js-call posix :normalize (js-call posix :join (js-call posix :dirname (aref pair 1))
                         (aref (get map :sources) 0))) (aref pair 0)))
            (throw (new globalThis.TypeError "static-data fixture map does not bind its maintained source")))
          (js-call assets :push (get source :proof) (get generated :proof) (get mapping :proof)))
        (setq index (1+ index)))
      (js-object :executedSuite suite :sourceAssets assets
        :assertionSource (Object/assign (js-object) proof (js-object :cases
          (js-call cases :map (lambda (item)
            (Object/assign (js-object) item (js-object :file archive :sourceFile archive :originalSuite suite
              :originalCase (Object/assign (js-object) (get item :originalCase) (js-object :sourceFile archive)))))))))))
  (defasync static-data-fixture-record (record options)
    (unless (and (= (get record :id) "original-managed-suite:complete-fixture-suites")
                 (= (get (get record :original) :testRunner) "bun test")
                 (= (get (get record :original) :semanticCoverage) "complete-original-suite-with-selected-compiler-namespaces")
                 (js-call (get (get record :original) :suites) :some
                   (lambda (suite) (= (get suite :file) "tests/wasm-memory-static-data.test.mjs"))))
      (throw (new globalThis.TypeError "static-data fixture evidence requires its complete real original replay")))
    (let* ((migration (await (readOriginalStaticDataFixtureMigration options)))
           (original (get record :original)) (assets (js-call (get original :sourceAssets (js-array)) :slice)))
      (js-call (get migration :sourceAssets) :forEach (lambda (asset)
        (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
          (when (and previous (/= (get previous :sourceSha256) (get asset :sourceSha256)))
            (throw (new globalThis.TypeError "static-data fixture source identity conflicts with original replay")))
          (unless previous (js-call assets :push asset)))))
      (Object/assign (js-object) record (js-object :original
        (Object/assign (js-object) original (js-object :sourceAssets assets :staticDataFixtureMigration migration))))))
