(module tools.backends.compiler-corpus-managed-fixtures
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "./compiler-corpus-managed-fixtures-legacy.mjs" :as legacy)

  (defconst readOriginalManagedStaticTemplate (get legacy :readOriginalManagedStaticTemplate))
  (defconst buildBackends (get legacy :buildBackends))
  (defconst bindOriginalManagedSourceEvidence (get legacy :bindOriginalManagedSourceEvidence))
  (defconst entry-fixture "tests/fixtures/wasm-managed-project-entry.eli")
  (defconst state-fixture "tests/fixtures/wasm-managed-project-state.eli")
  (defconst host-source-file "tools/backends/eliscript/compiler-corpus-project-entry-host.eli")
  (defconst host-bridge-files (js-array "tools/backends/eliscript/managed-host.eli"
    "tools/backends/managed-host.mjs" "tools/backends/managed-host-legacy.mjs"
    "tools/backends/eliscript/managed-host-lifecycle.eli" "tools/backends/managed-host-lifecycle.mjs"
    "tools/backends/eliscript/managed-host-object-provider.eli" "tools/backends/managed-host-object-provider.mjs"
    "tools/backends/eliscript/managed-host-object-realm.eli" "tools/backends/managed-host-object-realm.mjs"))
  (defun hash (source) (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
  (defun project-entry-record (record javascript identity bridge-assets)
    (if (and (js-call (js-array "original-managed-fixture:project-entry:node"
                              "original-managed-fixture:project-entry:bun") :includes (get record :id))
             (= (get (get record :original) :fixture) entry-fixture))
      (let* ((original (get record :original))
             (assets (js-call (get original :sourceAssets (js-array)) :slice))
             (previous (js-call assets :find (lambda (item) (= (get item :file) host-source-file))))
             (proof (js-object :file host-source-file :sourceSha256 (get identity :sha256))))
        (when (and previous (/= (get previous :sourceSha256) (get proof :sourceSha256)))
          (throw (new globalThis.TypeError "original project-entry host source asset identity conflicts")))
        (unless previous (js-call assets :push proof))
        (js-call bridge-assets :forEach (lambda (asset)
          (let ((prior (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
            (when (and prior (/= (get prior :sourceSha256) (get asset :sourceSha256)))
              (throw (new globalThis.TypeError "original project-entry host bridge source identity conflicts")))
            (unless prior (js-call assets :push asset)))))
        (Object/assign (js-object) record
          (js-object :execution (Object/assign (js-object) (get record :execution)
                       (js-object :hostSource javascript))
            :original (Object/assign (js-object) original (js-object :sourceAssets assets))))) record))
  (defasync addOriginalManagedFixtureAdapters (options)
    (if (or (nullish? options) (/= (value-type (get options :add)) "function")
            (/= (value-type (get options :text)) "function")
            (/= (value-type (get options :file)) "function")
            (nullish? (get options :stableFiles))
            (not (js-call (get options :stableFiles) :has entry-fixture))
            (not (js-call (get options :stableFiles) :has state-fixture)))
      (await (js-call legacy :addOriginalManagedFixtureAdapters options))
      (let* ((source (await (js-call options :text host-source-file)))
             (identity (await (js-call options :file host-source-file))))
        (unless (and (= (value-type source) "string") (= (hash source) (get identity :sha256))
                     (= (js-call Buffer :byteLength source) (get identity :bytes)))
          (throw (new globalThis.TypeError "original project-entry host text differs from its source asset")))
        (let* ((javascript (compile-string source host-source-file)) (bridge-assets (js-array)) (index 0)
               (add (get options :add)) (forwarded (Object/assign (js-object) options)))
          (while (< index (js-length host-bridge-files))
            (let* ((filename (aref host-bridge-files index)) (asset (await (js-call options :file filename))))
              (js-call bridge-assets :push (js-object :file filename :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (put forwarded :add (lambda (record) (funcall add (project-entry-record record javascript identity bridge-assets))))
          (await (js-call legacy :addOriginalManagedFixtureAdapters forwarded))))))
  (export addOriginalManagedFixtureAdapters readOriginalManagedStaticTemplate buildBackends bindOriginalManagedSourceEvidence))
