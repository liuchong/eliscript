  (defasync direct-wasm-source-migration (options)
    (let* ((archive "tests/direct-wasm-backend-test-ground.mjs")
           (original (await (browser-source-asset options archive)))
           (proof (get original :proof)) (assets (js-array proof))
           (pairs (js-array
