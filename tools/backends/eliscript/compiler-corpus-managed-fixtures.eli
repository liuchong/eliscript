  (defun portable-predicate-cases (suite source)
    (unless (= (hash source) "4bbc319b83880938df01f3f952250b3a844f36975e4ad41edf7137122de6a894")
      (throw (new globalThis.TypeError "the exact original portable predicate source changed")))
    (let* ((start (js-call source :indexOf "test('Given original '"))
           (next (js-call source :indexOf "\ntest(" start)) (offset (1+ next)) (end next)
           (expression-end (js-call source :indexOf ", () => {" start))
           (rows (Array/from (js-call source :matchAll (new globalThis.RegExp "^  \\['([^']+)', '([^']+)'," "gm"))))
           (registration (js-call source :slice start end))
           (fixed (originalSourceCaseLocators suite (js-call source :slice offset))) (result (js-array)))
      (unless (and (> start 0) (> next start) (> expression-end start)
                   (= (js-call source :slice (- end 3) end) "});") (= (js-length rows) 11) (= (js-length fixed) 6))
        (throw (new globalThis.TypeError "the complete original portable predicate case inventory changed")))
      (js-call rows :forEach (lambda (row variant)
        (let* ((input-start (get row :index)) (input-end (js-call source :indexOf "\n" input-start))
               (title (str "Given original " (aref row 1) " helper " (aref row 2)
                 ", when compiled as an independent predicate unit, then managed WASM needs no raw JavaScript function")))
          (unless (< input-end start) (throw (new globalThis.TypeError "predicate inputs escaped their original binding")))
          (js-call result :push (js-object :id (str "stable-compatibility:source-case:" suite ":0:" variant)
            :file suite :kind "test" :contains title :originalCase (js-object
              :title title :templateTitle "Given original " :titleExpression (js-call source :slice (+ start 5) expression-end)
              :parameters (js-object :file (aref row 1) :name (aref row 2)) :titleKind "expression"
              :sourceSha256 (hash source) :timeoutMs 5000 :registration "test" :span (js-object :start start :end end)
              :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
              :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 end)) :sha256 (hash registration)
              :input (js-object :span (js-object :start input-start :end input-end)
                :sha256 (hash (js-call source :slice input-start input-end)))))))))
      (js-call fixed :forEach (lambda (item index)
        (let* ((original (get item :originalCase)) (span (get original :span))
               (begin (+ offset (get span :start))) (finish (+ offset (get span :end))))
          (put item :id (str "stable-compatibility:source-case:" suite ":" (1+ index) ":0"))
          (put original :sourceSha256 (hash source)) (put original :span (js-object :start begin :end finish))
          (put original :byteStart (js-call Buffer :byteLength (js-call source :slice 0 begin)))
          (put original :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 finish)))
          (js-call result :push item)))) result))
  (defun final-fixture-cases (suite source)
    (if (= suite "tests/native-node-memory.test.mjs")
      (progn
        (unless (= (hash source) "4949de1619237a588945486e5f40958a9e248582db8f438e8a08d9da590e041c")
          (throw (new globalThis.TypeError "the exact native Node fixture source changed")))
        ;; These two static identifiers have equal UTF16/UTF8 lengths. This
        ;; parser view changes no original byte or source coordinate.
        (js-call (originalSourceCaseLocators suite (js-call (js-call source :split "nativeTest") :join "actualTest"))
          :map (lambda (item)
            (let* ((original (get item :originalCase)) (span (get original :span)))
              (put original :registration "nativeTest") (put original :sourceSha256 (hash source))
              (put original :sha256 (hash (js-call source :slice (get span :start) (get span :end)))) item))))
    (if (= suite "tests/compiler-portable-predicates.test.mjs") (portable-predicate-cases suite source)
    (if (/= suite "tests/wasm-managed-object-integrity.test.mjs")
      (originalSourceCaseLocators suite source)
      (let* ((identity (hash source))
             (boundary (js-call source :indexOf "const integrityScenarios=["))
             (start (js-call source :lastIndexOf "test('Scenario: '"))
             (tail (js-call source :lastIndexOf "}});});"))
             (end (+ tail 4)))
        (unless (and (= identity "a6a752d58e7399aa5228061736c52cdd7ca81129b6ab810205f109317abed349")
                     (> boundary 0) (> start boundary) (> tail start))
          (throw (new globalThis.TypeError "the exact original integrity scenario source changed")))
        (let* ((cases (originalSourceCaseLocators suite (js-call source :slice 0 boundary)))
               (registration (js-call source :slice start end))
               (expression-end (js-call source :indexOf ",async()=>" start))
               (expression (js-call source :slice (+ start 5) expression-end))
               (pattern (new globalThis.RegExp "\\{id:'([^']+)',given:'([^']+)',when:'([^']+)',then:'([^']+)',source:" "g"))
               (rows (Array/from (js-call source :matchAll pattern))))
          (unless (and (= (js-length cases) 17) (= (js-length rows) 4) (> expression-end start))
            (throw (new globalThis.TypeError "the complete integrity literal and scenario inventories changed")))
          (js-call cases :forEach (lambda (item) (put (get item :originalCase) :sourceSha256 identity)))
          (js-call rows :forEach (lambda (row variant)
            (let* ((input-start (get row :index)) (input-end (js-call source :indexOf "\n" input-start))
                   (input (js-call source :slice input-start input-end))
                   (scenario (js-object :id (aref row 1) :given (aref row 2) :when (aref row 3) :then (aref row 4)))
                   (title (str "Scenario: " (aref row 1) "\nGiven " (aref row 2) "\nWhen " (aref row 3) "\nThen " (aref row 4))))
              (unless (and (> input-start boundary) (< input-end start))
                (throw (new globalThis.TypeError "the original integrity scenario input escaped its real source region")))
              (js-call cases :push (js-object
                :id (str "stable-compatibility:source-case:" suite ":17:" variant) :file suite :kind "test" :contains title
                :originalCase (js-object :title title :templateTitle "Scenario: " :titleExpression expression
                  :parameters (js-object :scenario scenario) :titleKind "expression" :sourceSha256 identity :timeoutMs 5000 :registration "test"
                  :span (js-object :start start :end end)
                  :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
                  :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 end)) :sha256 (hash registration)
                  :input (js-object :span (js-object :start input-start :end input-end)
                    :byteStart (js-call Buffer :byteLength (js-call source :slice 0 input-start))
                    :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 input-end)) :sha256 (hash input)))))))) cases))))))
  (defasync readOriginalFinalFixtureMigrations (options)
    (let ((result (js-array)) (plan-index 0))
      (while (< plan-index (js-length final-fixture-plans))
        (let* ((plan (aref final-fixture-plans plan-index)) (archive (get plan :archive))
               (original (await (browser-source-asset options archive))) (proof (get original :proof))
               (cases (final-fixture-cases (get plan :suite) (get original :source)))
               (assets (js-array proof)) (pairs (get plan :pairs)) (index 0))
          (unless (and (= (get proof :sourceSha256) (get plan :sha256)) (= (js-length cases) (get plan :count)))
            (throw (new globalThis.TypeError (str "original final fixture identity or full case inventory changed: " archive))))
          (while (< index (js-length pairs))
            (let* ((pair (aref pairs index)) (source (await (browser-source-asset options (aref pair 0))))
                   (generated (await (browser-source-asset options (aref pair 1))))
                   (mapping (await (browser-source-asset options (str (aref pair 1) ".map"))))
                   (map (JSON/parse (get mapping :source))))
              (unless (and (= (get map :version) 3) (= (get map :file) (js-call posix :basename (aref pair 1)))
                           (= (js-length (get map :sources)) 1) (= (js-length (get map :sourcesContent)) 1)
                           (= (aref (get map :sourcesContent) 0) (get source :source))
                           (= (js-call posix :normalize (js-call posix :join (js-call posix :dirname (aref pair 1))
                             (aref (get map :sources) 0))) (aref pair 0)))
                (throw (new globalThis.TypeError (str "final fixture map does not bind its maintained source: " (aref pair 1)))))
              (js-call assets :push (get source :proof) (get generated :proof) (get mapping :proof)))
            (setq index (1+ index)))
          (let ((inputs (get plan :inputs (js-array))))
            (let ((position 0))
              (while (< position (js-length inputs))
                (js-call assets :push (get (await (browser-source-asset options (aref inputs position))) :proof))
                (setq position (1+ position)))))
          (js-call result :push (js-object :suite (get plan :suite) :executedSuite (get plan :executedSuite (get plan :suite))
            :sourceAssets assets :existingReplaySuite (get plan :replay)
            :execution "final-make-gate-only-not-a-target-record" :gateCommand "make test" :targetExecution false
            :assertionSource (Object/assign (js-object) proof (js-object :cases
              (js-call cases :map (lambda (item)
                (Object/assign (js-object) item (js-object :file archive :sourceFile archive :originalSuite (get plan :suite)
                  :originalCase (Object/assign (js-object) (get item :originalCase) (js-object :sourceFile archive)))))))))))
        (setq plan-index (1+ plan-index)))
      result))
  (defasync final-fixture-record (record options)
    (let* ((original (get record :original)) (migrations (await (readOriginalFinalFixtureMigrations options)))
           (repairs (await (readOriginalManagedFixtureRepairs options)))
           (assets (js-call (get original :sourceAssets (js-array)) :slice))
           (coverage (js-call (get record :coverage) :slice)) (fixture-inputs (js-array)))
      (js-call migrations :forEach (lambda (migration)
        (when (and (get migration :existingReplaySuite)
          (not (js-call (get original :suites) :some (lambda (suite) (= (get suite :file) (get migration :suite))))))
          (throw (new globalThis.TypeError "migrated final fixture is absent from its actual original replay")))
        (js-call (get migration :sourceAssets) :forEach (lambda (asset)
          (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
            (when (and previous (/= (get previous :sourceSha256) (get asset :sourceSha256)))
              (throw (new globalThis.TypeError "final fixture source identity conflicts with original replay")))
            (unless previous (js-call assets :push asset)))))))
      (js-call (get repairs :sourceAssets) :forEach (lambda (asset)
        (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
          (when (and previous (/= (get previous :sourceSha256) (get asset :sourceSha256)))
            (throw (new globalThis.TypeError "managed fixture repair source identity conflicts with its original replay")))
          (unless previous (js-call assets :push asset)))))
      (let ((supplemental (js-array
              (js-array "tests/fixtures/wasm-managed-js-cons-fast.eli" "tests/eliscript/js-cons-fast-path.eli" "tests/wasm-managed-js-cons-fast.test.mjs" 3)
              (js-array "tests/fixtures/persistent-vector-copy.eli" "tests/eliscript/persistent-vector-copy.eli" "tests/wasm-managed-vector-copy.test.mjs" 3)
              (js-array "tests/fixtures/wasm-managed-type-construction.eli" "tests/eliscript/managed-type-construction.eli" "tests/wasm-managed-type-construction.test.mjs" 10)))
            (position 0))
        (while (< position (js-length supplemental))
          (let* ((plan (aref supplemental position)) (filename (aref plan 0))
                 (source-file (aref plan 1)) (suite (aref plan 2)))
            (when (js-call (get options :stableFiles) :has filename)
              (let* ((source (await (browser-source-asset options source-file)))
               (generated (await (browser-source-asset options suite)))
               (mapping (await (browser-source-asset options (str suite ".map"))))
               (map (JSON/parse (get mapping :source)))
