  (defun project-entry-record (record javascript identity bridge-assets direct-migration)
    (if (and (js-call (js-array "original-managed-fixture:project-entry:node"
                              "original-managed-fixture:project-entry:bun") :includes (get record :id))
             (= (get (get record :original) :fixture) entry-fixture))
      (let* ((original (get record :original))
             (assets (js-call (get original :sourceAssets (js-array)) :slice))
             (previous (js-call assets :find (lambda (item) (= (get item :file) host-source-file))))
             (proof (js-object :file host-source-file :sourceSha256 (get identity :sha256))))
        (when (and previous (/= (get previous :sourceSha256) (get proof :sourceSha256)))
          (throw (new globalThis.TypeError "original project-entry host source asset identity conflicts")))
        (unless previous (js-call assets :push proof))
        (js-call bridge-assets :forEach (lambda (asset)
          (let ((prior (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
            (when (and prior (/= (get prior :sourceSha256) (get asset :sourceSha256)))
              (throw (new globalThis.TypeError "original project-entry host bridge source identity conflicts")))
            (unless prior (js-call assets :push asset)))))
        (js-call (get direct-migration :sourceAssets) :forEach (lambda (asset)
          (let ((prior (js-call assets :find (lambda (item) (= (get item :file) (get asset :file))))))
            (when (and prior (/= (get prior :sourceSha256) (get asset :sourceSha256)))
              (throw (new globalThis.TypeError "direct WASM source archive conflicts with its actual execution assets")))
            (unless prior (js-call assets :push asset)))))
        (Object/assign (js-object) record
          (js-object :execution (Object/assign (js-object) (get record :execution)
                       (js-object :hostSource javascript))
            :original (Object/assign (js-object) original (js-object :sourceAssets assets
              :suite (get (get direct-migration :assertionSource) :file)
              :sourceSha256 (get (get direct-migration :assertionSource) :sourceSha256)
              :assertionSource (get direct-migration :assertionSource)
              :directWasmSourceMigration direct-migration))))) record))
  (defun intrinsic-observation (value)
    (cond ((undefined? value) (js-object :$eliscriptObservation "undefined"))
      ((= (value-type value) "bigint") (js-object :$eliscriptObservation "bigint" :decimal (globalThis.String value)))
      ((and (= (value-type value) "number") (Object/is value -0)) (js-object :$eliscriptObservation "-0"))
      ((and (= (value-type value) "number") (not (Number/isFinite value)))
        (js-object :$eliscriptObservation (globalThis.String value)))
      ((Array/isArray value) (js-call value :map intrinsic-observation))
      ((and (not (eq value nil)) (= (value-type value) "object"))
        (Object/fromEntries (js-call (Object/entries value) :map
          (lambda (entry) (js-array (aref entry 0) (intrinsic-observation (aref entry 1)))))))
      (t value)))
  (defun intrinsic-call (name arguments expected)
    (js-object :name name :javascriptName (js-call name :replaceAll "-" "_")
      :args (intrinsic-observation arguments) :expected (intrinsic-observation expected)))
