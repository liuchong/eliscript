(module tools.backends.compiler-corpus-cli-transport
  (import "node:fs/promises" mkdir readFile writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (import "./compiler-corpus-host-context.mjs" openOriginalProgramContext)
  (import "./compiler-host-record.mjs" copyHostRecord)

  ;; This is ESM linkage syntax, not a replacement compiler implementation.
  ;; Both the module and its map are the selected generation's actual files.
  (defasync installOriginalCLICompiler (source destination names)
    (await (mkdir destination (js-object :recursive t)))
    (let ((index 0))
      (while (< index (js-length names))
        (let* ((name (aref names index)) (path (resolve source (str name ".mjs"))))
          (await (readFile path))
          (await (writeFile (resolve destination (str name ".mjs"))
            (str "export * from " (JSON/stringify (get (pathToFileURL path) :href)) ";\n")))
          (await (writeFile (resolve destination (str name ".mjs.map")) (await (readFile (str path ".map"))))))
        (setq index (1+ index)))))

  (defasync close-contexts (contexts preserve-failure)
    (let ((index (1- (js-length contexts))) (failed false) (failure undefined))
      (while (>= index 0)
        (try (await (js-call (aref contexts index) :close))
          (catch error (unless failed (setq failed t failure error))))
        (setq index (1- index)))
      (when (and failed (not preserve-failure)) (throw failure))))

  (defasync openOriginalCLITransport (names paths)
    (let ((manifest-path (get (get process :env) :ELISCRIPT_ORIGINAL_COMPILER_GENERATIONS)))
      (unless (funcall (js* "(value) => !!value") manifest-path)
        (throw (new globalThis.Error "original three-generation CLI requires selected compiler generation artifacts")))
      (let* ((manifest (JSON/parse (await (readFile manifest-path "utf8"))))
             (target (get manifest :target)) (generations (get manifest :generations))
             (directories (new globalThis.Map)) (contexts (js-array)) (index 0))
        (unless (and (= (get manifest :format) "eliscript-original-compiler-generations")
                     (= (get manifest :version) 1)
                     (js-call (js-array "javascript" "wasm" "native") :includes target)
                     (= target (get (get process :env) :ELISCRIPT_ORIGINAL_TARGET))
                     (Array/isArray generations) (= (js-length generations) 3))
          (throw (new globalThis.TypeError "original CLI requires three actual generations for the selected target")))
        (try
          (while (< index 3)
            (let ((generation (aref generations index)))
              (unless (and (= (get generation :generation) (1+ index))
                           (= (value-type (get generation :compilerDirectory)) "string")
                           (= (value-type (get generation :javascriptDirectory)) "string")
                           (js-call (js-array "javascript" "wasm" "native") :includes (get generation :producerHost))
                           (or (= index 0) (= (get generation :producerHost) target)))
                (throw (new globalThis.TypeError "original CLI generation provenance is incomplete")))
              (unless (= target "javascript")
                (unless (= (value-type (get generation :context)) "string")
                  (throw (new globalThis.TypeError "binary compiler generation requires its actual runtime context")))
                (let ((input (JSON/parse (await (readFile (get generation :context) "utf8")))))
                  (unless (= (get input :target) target)
                    (throw (new globalThis.Error "compiler generation changed its execution target")))
                  (js-call contexts :push (await (openOriginalProgramContext input
                    (js-object :identity (get generation :context))))))))
            (setq index (1+ index)))
          (catch error (await (close-contexts contexts t)) (throw error)))
        (let* ((place (async (generation-index destination)
                 (let ((generation (aref generations generation-index)))
                   (when (undefined? generation)
                     (throw (new globalThis.Error "original CLI requested an unavailable compiler generation")))
                   (await (installOriginalCLICompiler (get generation :compilerDirectory) destination names))
                   (js-call directories :set (resolve destination) generation))))
               (generation-for (lambda (directory)
                 (let ((generation (js-call directories :get (resolve directory))))
                   (when (undefined? generation)
                     (throw (new globalThis.Error "generation producer is not the selected compiler")))
                   generation))))
          (js-object
            :prepare (async (command options)
              (let* ((environment (if (nullish? options) undefined (get options :env)))
                     (executable (aref command 0)))
                (cond
                  ((= executable (get paths :build))
                    (let ((destination (if (nullish? environment) undefined
                                         (get environment :ELISCRIPT_BOOTSTRAP_OUT_DIR))))
                      (unless (and (= (js-length command) 1) (funcall (js* "(value) => !!value") destination))
                        (throw (new globalThis.TypeError "original bootstrap setup command changed")))
                      (await (funcall place 0 destination))
                      (js-object :exitCode 0 :stdout "" :stderr "")))
                  ((or (= executable (get paths :public)) (= executable (get paths :portable)))
                    (let ((directory (if (nullish? environment) undefined
                                       (get environment :ELISCRIPT_BOOTSTRAP_MODULE_DIR))))
                      (unless (= (value-type directory) "string")
                        (throw (new globalThis.TypeError "original public compiler command lost its module directory")))
                      (unless (js-call directories :has (resolve directory)) (await (funcall place 0 directory)))
                      (let ((generation (funcall generation-for directory)))
                        (when (funcall (js* "(value) => !!value") (get generation :context))
                          (put environment :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT (get generation :context)))))
                    nil)
                  (t nil))))
            :build (async (compiler-directory output-directory)
              (await (funcall place (get (funcall generation-for compiler-directory) :generation) output-directory)))
            :comparisonDirectory (lambda (directory) (get (funcall generation-for directory) :javascriptDirectory))
            :close (async (preserve-failure) (await (close-contexts contexts preserve-failure))))))))

  (defasync runOriginalCLICases (transport cases)
    (let ((failed false) (index 0))
      (try
        (while (< index (js-length cases))
          (let* ((record (aref cases index)) (timeout (get record :timeout)) (timer undefined))
            (try
              (await (Promise/race (js-array
                (js-call (Promise/resolve) :then (get record :body))
                (new globalThis.Promise (lambda (_ reject)
                  (setq timer (globalThis.setTimeout
                    (lambda () (funcall reject (new globalThis.Error
                      (str (get record :name) " exceeded its original " timeout " ms timeout")))) timeout)))))))
              (finally (globalThis.clearTimeout timer))))
          (setq index (1+ index)))
        (catch error (setq failed t) (throw error))
        (finally (await (js-call transport :close failed))))))

  (defasync runOriginalShellCLI (names)
    (let ((root (get (get process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT)))
      (unless (funcall (js* "(value) => !!value") root)
        (throw (new globalThis.Error "original shell CLI requires its source root")))
      (let ((directory (resolve (aref (get process :argv) 2) "__eliscript_original_cli_compiler")))
        (await (installOriginalCLICompiler (resolve (aref (get process :argv) 2) "bootstrap/compiler") directory names))
        (let* ((child (Bun/spawn (js-array "sh" (resolve root "tests/cli-test.sh"))
                        (js-object :cwd root :env (copyHostRecord (get process :env)
                          (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR directory)) :stdout "pipe" :stderr "pipe")))
               (result (await (Promise/all (js-array (get child :exited)
                         (js-call (new globalThis.Response (get child :stdout)) :text)
                         (js-call (new globalThis.Response (get child :stderr)) :text)))))
               (code (aref result 0)) (out (aref result 1)) (err (aref result 2)))
          (unless (= code 0)
            (throw (new globalThis.Error (cond ((/= (js-call err :trim) "") (js-call err :trim))
              ((/= (js-call out :trim) "") (js-call out :trim)) (t (str "original shell CLI failed: " code))))))
          (js-call (get process :stdout) :write out)))))

  (export installOriginalCLICompiler openOriginalCLITransport runOriginalCLICases runOriginalShellCLI))
