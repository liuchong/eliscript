(module tools.backends.compiler-matrix
  (import "node:fs/promises" mkdir readFile writeFile mkdtemp)
  (import "node:path" resolve join relative)
  (import "node:child_process" spawn)
  (import "node:buffer" Buffer)
  (import "./build.mjs" root)
  (import "./compiler-build.mjs" loadCompilerSources compilerMetadataDigest decodeCompilerBinary)
  (import "./compiler-corpus.mjs" loadOriginalCompilerCorpus compilerCorpusRequest cloneCompilerCorpusData compilerCorpusResourceDeferred)
  (import "./compiler-corpus-managed-cases.mjs" originalManagedSuites originalManagedCaseLocators)
  (import "./compiler-corpus-runtime-adapters.mjs" originalRuntimeSourceSuites originalRuntimeCaseLocators)
  (import "./compiler-corpus-identity-value-adapters.mjs" originalIdentityValueSuites originalIdentityValueCaseLocators)
  (import "./compiler-corpus-execution.mjs"
    executeCompilerCorpusRecord compareCompilerCorpusObservation createOriginalSeedOracle compilerCorpusRuntimeAcceptance)
  (import "./managed-module-graph.mjs" createManagedProjectFacades)
  (import "./compiler-corpus-source-archive.mjs" archiveCompilerCorpusSources)
  (import "./compiler-session.mjs" encodeCompilerMetadata)
  (import "./compiler-metadata.mjs" readCompilerMetadata)
  (import "./compiler-bootstrap.mjs"
    compilerHosts normalizeCompilerHost compilerDigest compilerFailure compilerSourceIdentity
    archiveCompilerSources saveCompilerMetadata bootstrapCompilerGrid assertCompilerArtifactSources openCompilerArtifact)

  (defconst original-manifests (Object/freeze (js-array
    (js-object :id "compiler-parity" :file "contracts/compiler-parity-corpus.json" :format "eliscript-compiler-parity-corpus")
    (js-object :id "stable-compatibility" :file "contracts/stable-compatibility-corpus.json" :format "eliscript-stable-compatibility-corpus"))))
  (defun matrix-error (message) (throw (new globalThis.Error message)))
  (defun matrix-type-error (message) (throw (new globalThis.TypeError message)))
  (defun field (value key) (if (nullish? value) undefined (aref value key)))
  (defun otherwise (value fallback) (if (nullish? value) fallback value))
  ;; Host default parameters apply to omission and undefined, never null.
  ;; &optional would replace an omitted host argument with Eliscript nil.
  (defun matrix-call-options (arguments)
    (let ((value (if (> (js-length arguments) 0) (aref arguments 0) undefined)))
      (if (undefined? value) (js-object) value)))
  (defun clone (value) (funcall globalThis.structuredClone value))
  (defun matrix-spread (&rest sources)
    ;; CopyDataProperties semantics: own enumerable keys, getter order, symbols
    ;; and an own __proto__ data field are retained without invoking setters.
    (let ((result (js-object)) (index 0))
      (while (< index (js-length sources))
        (let ((source (aref sources index)))
          (unless (nullish? source)
            (let* ((object (funcall globalThis.Object source)) (keys (Reflect/ownKeys object)) (position 0))
              (while (< position (js-length keys))
                (let* ((key (aref keys position)) (descriptor (Object/getOwnPropertyDescriptor object key)))
                  (when (and descriptor (get descriptor :enumerable))
                    (Object/defineProperty result key (js-object :value (aref object key)
                      :writable t :enumerable t :configurable t))))
                (setq position (1+ position))))))
        (setq index (1+ index))) result))
  (defun relative-identity (value)
    (unless (and (= (value-type value) "string") (> (js-length value) 0)
                 (not (js-call value :includes "\\")) (not (js-call value :includes ":"))
                 (not (js-call value :includes "\u0000"))
                 (not (js-call (js-call value :split "/") :some
                   (lambda (part) (or (= part "") (= part ".") (= part ".."))))))
      (matrix-type-error "corpus sources require relative module identities")) value)
  (defun identical-ids (actual expected label)
    (unless (and (Array/isArray actual)
                 (not (js-call actual :some (lambda (id) (/= (value-type id) "string"))))
                 (= (get (new globalThis.Set actual) :size) (js-length actual))
                 (= (JSON/stringify (js-call (Array/from actual) :sort))
                    (JSON/stringify (js-call (Array/from expected) :sort))))
      (matrix-error (+ label " coverage differs from its bound identities"))))

  (defasync loadOriginalCompilerManifests (&rest arguments)
    (let* ((options (matrix-call-options arguments))
           (source-root (if (undefined? (get options :sourceRoot)) root (get options :sourceRoot)))
           (manifests (js-array)) (required (js-array)) (evidence (new globalThis.Map))
           (additional (js-array)) (spec-index 0))
      (while (< spec-index (js-length original-manifests))
        (let* ((specification (aref original-manifests spec-index))
               (bytes (await (readFile (resolve source-root (get specification :file)))))
               (document (JSON/parse (js-call bytes :toString "utf8"))))
          (unless (and (= (get document :format) (get specification :format))
                       (= (value-type (get document :identity)) "string"))
            (matrix-error "invalid original compiler corpus manifest"))
          (js-call manifests :push (matrix-spread specification
            (js-object :sha256 (compilerDigest bytes) :identity (get document :identity) :document document)))
          (if (= (get specification :id) "compiler-parity")
            (progn
              (unless (Array/isArray (get document :fixtures)) (matrix-error "compiler parity fixtures are missing"))
              (let ((fixtures (get document :fixtures)) (index 0))
                (while (< index (js-length fixtures))
                  (let ((fixture (aref fixtures index)) (kind-index 0))
                    (relative-identity (get fixture :file)) (js-call evidence :set (get fixture :file) nil)
                    (while (< kind-index 2)
                      (let* ((kind (aref (js-array "valid" "invalid") kind-index))
                             (count (aref fixture kind)) (position 0))
                        (unless (and (Number/isSafeInteger count) (>= count 0))
                          (matrix-error "invalid original fixture case count"))
                        (while (< position count)
                          (js-call required :push (+ "compiler-parity:" (get fixture :id) ":" kind ":" position))
                          (setq position (1+ position))))
                      (setq kind-index (1+ kind-index)))) (setq index (1+ index))))
              (let ((dimensions (otherwise (get document :dimensions) (js-array))) (index 0))
                (while (< index (js-length dimensions))
                  (let* ((dimension (aref dimensions index)) (locators (get dimension :evidence)) (position 0))
                    (while (< position (js-length locators))
                      (let ((locator (aref locators position)))
                        (relative-identity (get locator :file)) (js-call evidence :set (get locator :file) nil)
                        (js-call required :push (+ "compiler-parity:dimension:" (get dimension :id) ":" position)))
                      (setq position (1+ position)))) (setq index (1+ index)))))
            (progn
              (unless (Array/isArray (get document :fixtureFiles)) (matrix-error "stable compatibility fixtures are missing"))
              (let ((files (get document :fixtureFiles)) (index 0))
                (while (< index (js-length files))
                  (let ((file (aref files index)))
                    (relative-identity file) (js-call evidence :set file nil)
                    (js-call required :push (+ "stable-compatibility:" file))) (setq index (1+ index))))
              (let* ((file "tests/conformance/manifest.json")
                     (ignored (js-call evidence :set file nil))
                     (conformance (JSON/parse (await (readFile (resolve source-root file) "utf8"))))
                     (feature-ids (get document :stableCoreFeatureIds)) (index 0))
                (while (< index (js-length feature-ids))
                  (let* ((feature-id (aref feature-ids index))
                         (feature (js-call (get conformance :features) :find (lambda (item) (= (get item :id) feature-id)))))
                    (unless feature (matrix-error (+ "original stable feature is unavailable: " feature-id)))
                    (let ((locators (otherwise (get feature :evidence) (js-array))) (position 0))
                      (while (< position (js-length locators))
                        (let ((locator (aref locators position)))
                          (relative-identity (get locator :file)) (js-call evidence :set (get locator :file) nil)
                          (js-call required :push (+ "stable-compatibility:evidence:" feature-id ":" position)))
                        (setq position (1+ position))))) (setq index (1+ index)))))))
        (setq spec-index (1+ spec-index)))
      (let ((families (js-array
               (js-array originalManagedSuites originalManagedCaseLocators)
               (js-array originalRuntimeSourceSuites originalRuntimeCaseLocators)
               (js-array originalIdentityValueSuites originalIdentityValueCaseLocators))) (family-index 0))
        (while (< family-index (js-length families))
          (let* ((family (aref families family-index)) (files (aref family 0)) (locate (aref family 1)) (index 0))
            (while (< index (js-length files))
              (let* ((file (aref files index)) (bytes (await (readFile (resolve source-root file))))
                     (source (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode bytes))
                     (cases (funcall locate file source)) (position 0))
                (js-call evidence :set file nil)
                (while (< position (js-length cases))
                  (js-call additional :push (aref cases position))
                  (js-call required :push (get (aref cases position) :id)) (setq position (1+ position))))
              (setq index (1+ index)))) (setq family-index (1+ family-index))))
      (let ((files (Array/from (js-call evidence :keys))) (index 0))
        (while (< index (js-length files))
          (let* ((file (aref files index)) (bytes (await (readFile (resolve source-root file)))))
            (js-call evidence :set file (js-object :file file :sha256 (compilerDigest bytes) :bytes (js-length bytes))))
          (setq index (1+ index))))
      (unless (= (get (new globalThis.Set required) :size) (js-length required))
        (matrix-error "duplicate original corpus coverage identity"))
      (js-object :manifests manifests :requiredCoverage required :additionalLocators additional
        :evidence (Array/from (js-call evidence :values)))))

  (defun matrix-case (record required covered)
    (unless (and (Array/isArray (get record :coverage)) (> (js-length (get record :coverage)) 0))
      (matrix-error (+ "corpus record has no original coverage identity: " (get record :id))))
    (js-call (get record :coverage) :forEach (lambda (id)
      (unless (js-call required :has id) (matrix-error (+ "unknown original corpus coverage identity: " id)))
      (js-call covered :add id)))
    (let ((kind (get record :kind)))
      (cond
        ((= kind "stage")
          (let ((request (get record :request)))
            (unless (and (= (field request "operation") "stage")
                         (js-call (js-array "reader" "expander" "analyzer" "portable" "ir" "emitter") :includes (get request :stage))
                         (= (value-type (get request :source)) "string") (= (value-type (get request :filename)) "string"))
              (matrix-error (+ "invalid original stage request: " (get record :id))))))
        ((= kind "original-suite")
          (let ((suite (get record :suite)) (expected (get record :expected)))
            (unless (and (Array/isArray (field suite "locators")) (Array/isArray (field suite "fixtures"))
                         (Array/isArray (field expected "requiredLocatorIds")))
              (matrix-error (+ "invalid original suite execution request: " (get record :id))))
            (identical-ids (js-call (get suite :locators) :map (lambda (item) (get item :id)))
              (get expected :requiredLocatorIds) "original suite locator")))
        ((= kind "sequence")
          (unless (and (Array/isArray (get record :steps)) (> (js-length (get record :steps)) 0)
                       (not (js-call (get record :steps) :some (lambda (step)
                         (or (/= (value-type (field step "id")) "string") (not (field step "request")))))))
            (matrix-error (+ "invalid original request sequence: " (get record :id))))
          (let ((ids (js-call (get record :steps) :map (lambda (step) (get step :id)))))
            (identical-ids ids ids "original sequence step")))
        (t
          (unless (or (undefined? kind) (= kind "project")) (matrix-error (+ "unknown original corpus record kind: " kind)))
          (unless (and (Array/isArray (get record :modules)) (> (js-length (get record :modules)) 0))
            (matrix-error (+ "corpus record must contain its complete source graph: " (get record :id))))
          (let ((ids (new globalThis.Set)))
            (js-call (get record :modules) :forEach (lambda (item)
              (relative-identity (field item "id"))
              (when (or (js-call ids :has (get item :id)) (/= (value-type (get item :source)) "string")
                        (/= (value-type (get item :filename)) "string"))
                (matrix-error (+ "invalid corpus source record: " (get record :id))))
              (js-call ids :add (get item :id))))
            (unless (js-call ids :has (get record :entry))
              (matrix-error (+ "corpus entry is outside its source graph: " (get record :id))))))))
    (cloneCompilerCorpusData record))

  (defasync loadCompilerMatrixCorpus (&rest arguments)
    (let* ((settings (matrix-call-options arguments))
           (source-root (if (undefined? (get settings :sourceRoot)) root (get settings :sourceRoot)))
           (records (get settings :records)) (path (get settings :recordsPath)))
      (when (and (not (undefined? records)) (not (undefined? path)))
        (matrix-type-error "provide corpus records or their JSON path"))
      ;; The caller snapshot is synchronous, before the first asynchronous IO.
      (let ((document (if (undefined? records) undefined (cloneCompilerCorpusData records))) (bytes undefined))
        (unless (undefined? path)
          (setq bytes (await (readFile path)))
          (setq document (JSON/parse (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode bytes))))
        (let ((originals (await (loadOriginalCompilerManifests (js-object :sourceRoot source-root)))))
          (when (undefined? document) (setq document (await (loadOriginalCompilerCorpus (js-object :sourceRoot source-root :originals originals)))))
          (unless (and document (= (get document :format) "eliscript-compiler-matrix-corpus")
                       (= (get document :version) 1) (Array/isArray (get document :records)))
            (matrix-type-error "original compiler matrix corpus records are required"))
          (js-call (get originals :manifests) :forEach (lambda (manifest)
            (let ((binding (field (get document :manifests) (get manifest :id))))
              (unless (and (= (field binding "sha256") (get manifest :sha256))
                           (= (field binding "identity") (get manifest :identity)))
                (matrix-error (+ "corpus adapter is bound to a different original manifest: " (get manifest :id)))))))
          (identical-ids (get document :coverageIds) (get originals :requiredCoverage) "original corpus")
          (identical-ids (js-call (get document :records) :map (lambda (record) (field record "id")))
            (otherwise (get document :expectedIds) (js-array)) "original case")
          (when (= (js-length (get document :records)) 0) (matrix-error "original compiler corpus cannot be empty"))
          (let ((required (new globalThis.Set (get originals :requiredCoverage))) (covered (new globalThis.Set)))
            (js-call (otherwise (field (get document :originalGateEvidence) "coverageIds") (js-array)) :forEach (lambda (id)
              (unless (js-call required :has id) (matrix-error (+ "unknown original gate coverage identity: " id))) (js-call covered :add id)))
            (js-call (otherwise (get document :missingCaseAdapters) (js-array)) :forEach (lambda (adapter)
              (let ((id (field adapter "coverageId")))
                (unless (js-call required :has id) (matrix-error "unknown missing original case identity")) (js-call covered :add id))))
            (let* ((cases (js-call (get document :records) :map (lambda (record) (matrix-case record required covered))))
                   (identity (js-object
                     :manifests (js-call (get originals :manifests) :map (lambda (item)
                       (js-object :id (get item :id) :file (get item :file) :sha256 (get item :sha256) :identity (get item :identity))))
                     :evidence (get originals :evidence)
                     :adapterEvidence (js-call (otherwise (get document :evidence) (js-array)) :map (lambda (item)
                       (js-object :file (get item :file) :sha256 (get item :sha256) :bytes (get item :bytes))))
                     :expectedIds (Array/from (get document :expectedIds)) :coverageIds (Array/from (get document :coverageIds))
                     :originalGateEvidence (cloneCompilerCorpusData (get document :originalGateEvidence))
                     :missingCaseAdapters (cloneCompilerCorpusData (otherwise (get document :missingCaseAdapters) (js-array))))))
              (identical-ids (Array/from covered) (get originals :requiredCoverage) "adapted original corpus")
              (when (nullish? bytes) (setq bytes (js-call Buffer :from (+ (encodeCompilerMetadata document) "\n"))))
              (js-object :records cases :identity identity :originals originals :recordsBytes bytes
                :recordsSha256 (compilerDigest bytes) :document document)))))))

  (defasync verifyOriginalCompilerCorpusFiles (options)
    (let* ((source-root (get options :sourceRoot)) (corpus (get options :corpus))
           (declared (new globalThis.Map)) (files (js-array)) (changed (js-array))
           (inputs (js-call (get (get corpus :originals) :manifests) :concat
             (get (get corpus :originals) :evidence) (otherwise (get (get corpus :document) :evidence) (js-array))))
           (index 0))
      (while (< index (js-length inputs))
        (let* ((item (aref inputs index)) (name (get item :file)) (previous (js-call declared :get name)))
          (relative-identity name)
          (unless (= (value-type (get item :sha256)) "string") (matrix-type-error "original corpus file has no source digest"))
          (when (and previous (or (/= (get previous :sha256) (get item :sha256))
             (and (not (undefined? (get previous :bytes))) (not (undefined? (get item :bytes)))
                  (/= (get previous :bytes) (get item :bytes)))))
            (matrix-error (+ "original corpus file has conflicting source revisions: " name)))
          (js-call declared :set name (js-object :file name :sha256 (get item :sha256)
            :bytes (otherwise (get item :bytes) (field previous "bytes"))))) (setq index (1+ index)))
      (let ((records (Array/from (js-call declared :values))) (position 0))
        (while (< position (js-length records))
          (let ((expected (aref records position)) (actual undefined))
            (try
              (let ((bytes (await (readFile (resolve source-root (get expected :file))))))
                (setq actual (js-object :file (get expected :file) :bytes (js-length bytes) :sha256 (compilerDigest bytes)))
                (put actual :unchanged (and (= (get actual :sha256) (get expected :sha256))
                  (or (undefined? (get expected :bytes)) (= (get actual :bytes) (get expected :bytes))))))
              (catch error
                (setq actual (js-object :file (get expected :file) :unchanged false
                  :error (js-object :name (field error "name") :code (field error "code"))))))
            (js-call files :push actual)
            (unless (get actual :unchanged) (js-call changed :push (get expected :file))))
          (setq position (1+ position))))
      (js-object :status (if (> (js-length changed) 0) "changed" "unchanged") :changedFiles changed :files files)))

  (defasync archive-original-corpus (corpus directory source-root)
    (await (mkdir directory (js-object :recursive t)))
    (unless (and (js-call globalThis.Uint8Array globalThis.Symbol.hasInstance (get corpus :recordsBytes))
                 (= (compilerDigest (get corpus :recordsBytes)) (get corpus :recordsSha256)))
      (matrix-error "original corpus recipe bytes changed before archival"))
    (await (writeFile (join directory "records.json") (get corpus :recordsBytes) (js-object :flag "wx")))
    (await (saveCompilerMetadata (join directory "identity.json")
      (matrix-spread (get corpus :identity) (js-object :recordsSha256 (get corpus :recordsSha256)))))
    (let ((manifests (get (get corpus :originals) :manifests)) (index 0))
      (while (< index (js-length manifests))
        (let* ((manifest (aref manifests index)) (raw (await (readFile (resolve source-root (get manifest :file))))))
          (unless (= (compilerDigest raw) (get manifest :sha256)) (matrix-error "original corpus changed while being archived"))
          (await (writeFile (join directory (+ (get manifest :id) ".json")) raw (js-object :flag "wx"))))
        (setq index (1+ index))))
    (let ((items (get (get corpus :originals) :evidence)) (index 0))
      (while (< index (js-length items))
        (let* ((item (aref items index)) (raw (await (readFile (resolve source-root (get item :file)))))
               (path (join directory "original-fixtures" (get item :file))))
          (unless (= (compilerDigest raw) (get item :sha256))
            (matrix-error (+ "original fixture changed while being archived: " (get item :file))))
          (await (mkdir (resolve path "..") (js-object :recursive t)))
          (await (writeFile path raw (js-object :flag "wx")))) (setq index (1+ index))))
    (let ((original-files (new globalThis.Set
             (js-call (get (get corpus :originals) :evidence) :map (lambda (item) (get item :file)))))
          (items (otherwise (get (get corpus :document) :evidence) (js-array))) (index 0))
      (while (< index (js-length items))
        (let ((item (aref items index)))
          (relative-identity (get item :file))
          (let ((raw (await (readFile (resolve source-root (get item :file))))))
            (unless (and (= (compilerDigest raw) (get item :sha256)) (= (js-length raw) (get item :bytes))
                         (= (js-call raw :toString "base64") (get item :content)))
              (matrix-error (+ "original adapter dependency changed while being archived: " (get item :file))))
            (unless (js-call original-files :has (get item :file))
              (let ((path (join directory "original-fixtures" (get item :file))))
                (await (mkdir (resolve path "..") (js-object :recursive t)))
                (await (writeFile path raw (js-object :flag "wx"))))))) (setq index (1+ index)))))

  (defun byte-array (value)
    (cond
      ((js-call globalThis.Uint8Array globalThis.Symbol.hasInstance value) (Uint8Array/from value))
      ((= (field value "encoding") "u16le-chunks") (decodeCompilerBinary value))
      (t
        (unless (Array/isArray value) (matrix-type-error "compiler did not return actual output bytes"))
        (let ((result (new globalThis.Uint8Array (js-length value))) (index 0))
          (while (< index (js-length value))
            (let ((byte (aref value index)))
              (unless (and (Number/isInteger byte) (>= byte 0) (<= byte 255))
                (matrix-type-error "compiler did not return actual output bytes"))
              (put result index byte)) (setq index (1+ index))) result))))

  (defasync archiveProduct (input target directory)
    (let ((response (clone input)))
      (unless (= (field response "target") target) (matrix-error "compiler returned a different product target"))
      (await (mkdir directory (js-object :recursive t)))
      (let ((product (js-object :target target :entry (get response :entry) :directory directory :modules (js-array))))
        (if (= target "javascript")
          (progn
            (unless (and (Array/isArray (get response :modules)) (> (js-length (get response :modules)) 0))
              (matrix-error "compiler returned no JavaScript modules"))
            (let ((seen (new globalThis.Set)) (modules (get response :modules)) (index 0))
              (while (< index (js-length modules))
                (let* ((item (aref modules index)) (id (field item "id")))
                  (relative-identity id)
                  (when (or (js-call seen :has id) (/= (value-type (get item :javascript)) "string"))
                    (matrix-error "invalid emitted JavaScript module"))
                  (js-call seen :add id)
                  (let ((path (join directory id)))
                    (await (mkdir (resolve path "..") (js-object :recursive t)))
                    (await (writeFile path (get item :javascript) (js-object :flag "wx")))
                    (let ((record (js-object :id id :path path :sha256 (compilerDigest (get item :javascript))
                            :bytes (js-call Buffer :byteLength (get item :javascript)))))
                      (unless (undefined? (get item :sourceMap))
                        (unless (= (value-type (get item :sourceMap)) "string")
                          (matrix-type-error "source map must retain its actual serialized bytes"))
                        (put record :sourceMapPath (+ path ".map"))
                        (put record :sourceMapSha256 (compilerDigest (get item :sourceMap)))
                        (await (writeFile (get record :sourceMapPath) (get item :sourceMap) (js-object :flag "wx"))))
                      (js-call (get product :modules) :push record)))) (setq index (1+ index)))
              (unless (js-call seen :has (get response :entry)) (matrix-error "emitted JavaScript entry is missing"))
              (put product :path (join directory (get response :entry)))))
          (let* ((bytes (byte-array (get response :bytes)))
                 (extension (if (= target "wasm") ".wasm" (if (= (get response :nativeFormat) "object") ".o"
                   (if (= (get response :nativeTarget) "arm64-linux") ".so" ".dylib")))))
            (put product :path (join directory (+ "program" extension)))
            (put product :bytes (js-length bytes)) (put product :sha256 (compilerDigest bytes))
            (put product :nativeTarget (get response :nativeTarget)) (put product :nativeFormat (get response :nativeFormat))
            (await (writeFile (get product :path) bytes (js-object :flag "wx")))
            (if (= (get response :abi) "memory-u32")
              (progn
                (unless (= (field (get response :typed) "abi") "memory-u32") (matrix-error "raw memory product has no actual typed memory ABI"))
                (put product :abi "memory-u32"))
              (when (undefined? (get response :descriptor)) (matrix-error "managed product descriptor is missing")))
            (unless (undefined? (get response :descriptor))
              ;; response already owns the synchronous pre-I/O snapshot.
              ;; Transfer these detached graphs instead of duplicating the
              ;; complete lowering once more during archival.
              (put product :descriptor (get response :descriptor))
              (put product :descriptorSha256 (compilerMetadataDigest (get response :descriptor)))
              (await (saveCompilerMetadata (join directory "descriptor.json") (get response :descriptor))))
            (unless (undefined? (get response :typed))
              (put product :typed (get response :typed))
              (put product :typedSha256 (compilerMetadataDigest (get response :typed)))
              (await (saveCompilerMetadata (join directory "typed.json") (get response :typed))))
            (unless (undefined? (get response :debug))
              (put product :debug (get response :debug)) (put product :debugPath (join directory "debug.json"))
              (put product :debugSha256 (compilerMetadataDigest (get response :debug)))
              (await (saveCompilerMetadata (get product :debugPath) (get response :debug))))
            (when (and (= target "native") (undefined? (get response :typed)))
              (matrix-error "native product has no actual typed lowering record"))
            (when (field (get product :descriptor) "project")
              (let* ((facades (createManagedProjectFacades (get product :descriptor) (js-object :entry (get response :entry))))
                     (files (get facades :files)) (index 0))
                (put product :facades (js-array))
                (while (< index (js-length files))
                  (let* ((file (aref files index)) (id (relative-identity (get file :id))) (path (join directory id)))
                    (await (mkdir (resolve path "..") (js-object :recursive t)))
                    (await (writeFile path (get file :source) (js-object :flag "wx")))
                    (js-call (get product :facades) :push (js-object :id id :path path :sha256 (compilerDigest (get file :source)))))
                  (setq index (1+ index)))
                (put product :facadeRegistry (get facades :registry)) (put product :facadeEntry (get facades :loadEntry))))))
        (let ((identity (if (= target "javascript")
                (js-object :target target :entry (get product :entry)
                  :modules (js-call (js-call (get product :modules) :map (lambda (item)
                    (js-object :id (get item :id) :sha256 (get item :sha256) :sourceMapSha256 (get item :sourceMapSha256)))) :sort
                    (lambda (left right) (if (< (get left :id) (get right :id)) -1 (if (> (get left :id) (get right :id)) 1 0)))))
                (js-object :target target :abi (get product :abi) :sha256 (get product :sha256)
                  :descriptorSha256 (get product :descriptorSha256) :typedSha256 (get product :typedSha256)
                  :debugSha256 (get product :debugSha256) :nativeTarget (get product :nativeTarget) :nativeFormat (get product :nativeFormat)))))
          (put product :identitySha256 (compilerDigest (JSON/stringify identity))))
        ;; Full typed/debug records are already archived separately. Keep the
        ;; returned graphs for execution while storing only their references
        ;; and original identities in the small product envelope.
        (await (saveCompilerMetadata (join directory "product.json")
          (matrix-spread product (js-object :typed undefined :debug undefined))))
        product)))

  (defun aborted (signal)
    (when (field signal "aborted")
      (throw (if (undefined? (get signal :reason)) (new globalThis.Error "compiler matrix aborted") (get signal :reason)))))

  (defasync runOriginalCompilerGates (options)
    (let* ((source-root (get options :sourceRoot)) (corpus (get options :corpus))
           (source-identity (get options :sourceIdentity)) (directory (get options :directory)) (signal (get options :signal))
           (expected (get (get corpus :document) :originalGateEvidence)))
      (if (/= (field expected "required") t) (js-object :status "not-required")
        (progn
          (unless (and (= (field (get expected :execution) "provider") "local")
                       (= (get (get expected :execution) :command) "make test-core")
                       (= (get (get expected :execution) :applicationEvidence) false))
            (matrix-error "original compiler gate command differs from the stable core contract"))
          (let ((logs (js-object :stdout (js-array) :stderr (js-array)))
                (environment (matrix-spread (get globalThis.process :env) (js-object :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE "0"))))
            (js-call (js-array "MAKEFLAGS" "GNUMAKEFLAGS" "MFLAGS" "BUN_TEST_RUNNER") :forEach
              (lambda (name) (Reflect/deleteProperty environment name)))
            (let ((execution (await (new globalThis.Promise (lambda (accept reject)
                    (let ((child (spawn "make" (js-array "test-core")
                            (js-object :cwd source-root :signal signal :env environment :stdio (js-array "ignore" "pipe" "pipe")))))
                      (js-call (get child :stdout) :on "data" (lambda (bytes) (js-call (get logs :stdout) :push bytes)))
                      (js-call (get child :stderr) :on "data" (lambda (bytes) (js-call (get logs :stderr) :push bytes)))
                      (js-call child :once "error" reject)
                      (js-call child :once "close" (lambda (exit-code termination-signal)
                        (funcall accept (js-object :exitCode exit-code :signal termination-signal)))))))))
                  (files (js-array)) (index 0))
              (while (< index 2)
                (let* ((channel (aref (js-array "stdout" "stderr") index))
                       (bytes (js-call Buffer :concat (aref logs channel))) (path (+ "original-gates." channel ".log")))
                  (await (writeFile (join directory path) bytes (js-object :flag "wx")))
                  (js-call files :push (js-object :path path :bytes (js-length bytes) :sha256 (compilerDigest bytes)))) (setq index (1+ index)))
              (let* ((after (compilerSourceIdentity (await (loadCompilerSources (js-object :sourceRoot source-root)))))
                     (unchanged (= (get after :sha256) (get source-identity :sha256))) (manifests-unchanged t)
                     (manifests (get (get corpus :originals) :manifests)) (position 0))
                (while (< position (js-length manifests))
                  (let ((manifest (aref manifests position)))
                    (unless (= (compilerDigest (await (readFile (resolve source-root (get manifest :file))))) (get manifest :sha256))
                      (setq manifests-unchanged false))) (setq position (1+ position)))
                (let ((result (matrix-spread (js-object :command (js-array "make" "test-core")) execution
                        (js-object :sourceUnchanged unchanged :manifestsUnchanged manifests-unchanged
                          :sourceSha256 (get source-identity :sha256) :files files :coverageIds (Array/from (get expected :coverageIds))
                          :status (if (and (= (get execution :exitCode) 0) (nil? (get execution :signal)) unchanged manifests-unchanged)
                                    "passed" "failed")))))
                  (await (saveCompilerMetadata (join directory "original-gates.json") result)) result))))))))

  (defasync retain-compiler-grid (grid directory source-identity artifacts)
    (unless (and grid (= (value-type (get grid :directory)) "string"))
      (matrix-type-error "compiler grid evidence requires its actual directory"))
    (let* ((bytes (await (readFile (join (resolve (get grid :directory)) "grid.json"))))
           (actual (JSON/parse (js-call bytes :toString "utf8")))
           (pairs (new globalThis.Set)) (targets (new globalThis.Map)) (generations-verified false))
      (unless (and (= (get actual :format) "eliscript-independent-compiler-grid") (= (get actual :version) 1)
                   (= (field (get actual :sourceIdentity) "sha256") (get source-identity :sha256))
                   (Array/isArray (get actual :cells)) (Array/isArray (get actual :comparisons)))
        (matrix-error "compiler grid does not bind the current complete compiler source"))
      (when (and (not (undefined? (get grid :metadata)))
                 (/= (compilerDigest (JSON/stringify (get grid :metadata))) (compilerDigest (JSON/stringify actual))))
        (matrix-error "compiler grid metadata differs from the retained manifest"))
      (js-call (get actual :cells) :forEach (lambda (cell)
        (let* ((host (normalizeCompilerHost (get cell :host))) (target (normalizeCompilerHost (get cell :target)))
               (pair (+ host "-to-" target)) (group (otherwise (js-call targets :get target) (js-array))))
          (when (js-call pairs :has pair) (matrix-error "compiler grid repeats a producer/target cell"))
          (js-call pairs :add pair) (js-call group :push cell) (js-call targets :set target group))))
      (let ((generation-evidence (get actual :generations)))
        (when (field generation-evidence "directory")
          (let* ((generation-bytes (await (readFile (join (resolve (get generation-evidence :directory)) "bootstrap.json"))))
                 (generations (JSON/parse (js-call generation-bytes :toString "utf8")))
                 (bound (and (= (get generations :format) "eliscript-independent-compiler-bootstrap") (= (get generations :version) 1)
                   (= (field (get generations :sourceIdentity) "sha256") (get source-identity :sha256))
                   (= (get generations :status) "constructed") (= (field (get generations :fixedPoint) "status") "identical")
                   (Array/isArray (get generations :chains)) (= (js-length (get generations :chains)) 3)))
                 (hosts (new globalThis.Set)) (verified bound) (index 0))
            (when bound
              (while (and verified (< index (js-length (get generations :chains))))
                (let* ((chain (aref (get generations :chains) index)) (sequence (get chain :hosts))
                       (host (normalizeCompilerHost (field sequence "0"))))
                  (if (or (js-call hosts :has host) (< (js-length sequence) 3)
                          (js-call sequence :some (lambda (item) (/= (normalizeCompilerHost item) host)))
                          (/= (get chain :status) "constructed"))
                    (setq verified false)
                    (progn
                      (js-call hosts :add host)
                      (let* ((chain-bytes (await (readFile (join (resolve (get chain :directory)) "bootstrap.json"))))
                             (original (JSON/parse (js-call chain-bytes :toString "utf8"))) (records (get original :generations))
                             (fixed-point (get original :fixedPoint)))
                        (if (or (/= (get original :format) "eliscript-compiler-bootstrap") (/= (get original :version) 1)
                                (/= (field (get original :sourceIdentity) "sha256") (get source-identity :sha256))
                                (/= (get original :status) "constructed") (get original :cleanupFailure)
                                (not (Array/isArray records)) (/= (js-length records) (js-length sequence))
                                (js-call records :some (lambda (record position)
                                  (or (/= (get record :generation) (1+ position)) (/= (get record :target) host)
                                      (/= (get record :status) "instantiated") (/= (get record :sourceSha256) (get source-identity :sha256)))))
                                (js-call records :some (lambda (record position) (and (> position 0) (/= (get record :producerHost) host))))
                                (/= (field fixed-point "status") "identical")
                                (/= (js-length (get fixed-point :comparisons)) (1- (js-length records)))
                                (js-call (get fixed-point :comparisons) :some (lambda (item) (/= (get item :status) "identical"))))
                          (setq verified false)
                          (await (writeFile (join directory (+ "compiler-generation-" host ".json")) chain-bytes (js-object :flag "wx"))))))))
                (setq index (1+ index))))
            (setq generations-verified (and verified (= (get hosts :size) 3)))
            (await (writeFile (join directory "compiler-generations-evidence.json") generation-bytes (js-object :flag "wx"))))))
      (let ((consistent (and generations-verified (= (js-length (get actual :cells)) 9)
              (js-call compilerHosts :every (lambda (target)
                (let* ((cells (otherwise (js-call targets :get target) (js-array)))
                       (comparisons (js-call (get actual :comparisons) :filter (lambda (item) (= (get item :target) target))))
                       (identities (js-call cells :map (lambda (cell) (field (field (get cell :artifact) "productIdentity") "sha256")))))
                  (and (= (js-length cells) 3)
                       (not (js-call cells :some (lambda (cell) (or (/= (get cell :status) "constructed") (/= (get cell :execution) "initialized")))))
                       (js-call identities :every globalThis.Boolean) (= (get (new globalThis.Set identities) :size) 1)
                       (= (js-length comparisons) 1) (= (get (aref comparisons 0) :status) "identical")
                       (= (compilerDigest (JSON/stringify (get (aref comparisons 0) :identities))) (compilerDigest (JSON/stringify identities)))
                       (= (field (field (js-call artifacts :get target) "productIdentity") "sha256") (aref identities 0))))))
              (not (field (get actual :cleanupFailures) "length")) (= (get actual :identityVerification) "identical"))))
        (await (writeFile (join directory "compiler-grid-evidence.json") bytes (js-object :flag "wx")))
        (js-object :directory (relative directory (resolve (get grid :directory))) :manifest "compiler-grid-evidence.json"
          :sha256 (compilerDigest bytes) :sourceIdentity (clone (get actual :sourceIdentity))
          :cells (js-call (get actual :cells) :map (lambda (cell)
            (js-object :host (get cell :host) :target (get cell :target) :status (get cell :status) :execution (get cell :execution)
              :identity (otherwise (field (field (get cell :artifact) "productIdentity") "sha256") nil))))
          :generationsVerification (if generations-verified "identical" "unverified")
          :identityVerification (if consistent "identical" "unverified") :verification "unverified"))))

  ;; Small progress records identify the actual awaited operation. They do not
  ;; certify an outcome, session cleanup, or a resumable completed cell.
  (defasync matrix-progress (options directory event)
    (await (saveCompilerMetadata (join directory "progress.json") event))
    (unless (nullish? (get options :onStage))
      (await (js-call options :onStage event))))

  (defun matrix-response-mode (modes)
    (cond ((and (not (nullish? modes)) (js-call modes :includes "graph-events-v1")) "graph-events-v1")
          ((and (not (nullish? modes)) (js-call modes :includes "events-v1")) "events-v1")
          (t undefined)))

  (defun matrix-suite-request-options (mode options input)
    (cond ((or (undefined? mode) (eq options nil)
               ;; Explicit wire modes and raw/malformed inputs keep their
               ;; original request path, validation and first exception.
               (nullish? input) (/= (value-type input) "object") (Array/isArray input)
               (Object/hasOwn input "responseMode")
               ;; A token request belongs to an explicitly opened wire
               ;; cursor. Its next/close envelope must not be auto-decoded.
               (Object/hasOwn input "token")) options)
          ((undefined? options) (js-object :responseMode mode))
          (t
            ;; Preserve the public session's own option read order and the
            ;; original getter receiver. Do not enumerate unrelated options or
            ;; evaluate them before the actual request reads them. An explicit
            ;; responseMode, including an own undefined, remains authoritative.
            (let ((forwarded (js-object)))
              (js-call (js-array "signal" "responseMode" "responseStringChunks") :forEach (lambda (key)
                (Object/defineProperty forwarded key (js-object :enumerable t :get (lambda ()
                  (let ((value (get options key)))
                    (if (and (= key "responseMode") (undefined? value) (not (Object/hasOwn options key)))
                        mode value)))))))
              forwarded))))

  (defasync matrix-case-execution (record index host target session mode cell-directory metadata manifest corpus execution-options options cell
                                  literal-sources literal-identity)
    (aborted (get options :signal))
    (let* ((directory (join cell-directory (+ (js-call (funcall globalThis.String index) :padStart 6 "0") "-"
                         (js-call (compilerDigest (get record :id)) :slice 0 16))))
           (outcome (js-object :id (get record :id) :status "compiling" :verification "unverified" :directory directory))
           (runtime-acceptance (compilerCorpusRuntimeAcceptance record execution-options))
           (request (compilerCorpusRequest record target
                      (matrix-spread options (js-object :sourceAssets (get (get corpus :document) :evidence)
                        :literalSources literal-sources :literalSourceIdentity literal-identity))))
           (observation undefined) (response undefined) (product undefined) (execution-started false) (trace (js-array)))
      (js-call (get cell :records) :push outcome)
      (unless (undefined? runtime-acceptance)
        (Object/assign outcome runtime-acceptance)
        (put metadata :resourceAcceptance "deferred")
        (unless (get metadata :resourceOutcomes) (put metadata :resourceOutcomes (js-array)))
        (js-call (get metadata :resourceOutcomes) :push
          (matrix-spread (js-object :id (get record :id)) runtime-acceptance)))
      (put outcome :sourceIdentity (await (archiveCompilerCorpusSources record (join directory "sources"))))
      (when (and request (Object/hasOwn request "runtimeImportTransport"))
        (put outcome :runtimeImportTransport (get request :runtimeImportTransport)))
      (when (and (not (nil? request)) (/= target "javascript") (= (get request :target) target))
        (setq request (matrix-spread request (js-object :binaryEncoding "u16le-chunks"))))
      (await (saveCompilerMetadata (join directory "request.json") request))
      (unless (nullish? (get options :onStage))
        (await (js-call options :onStage (js-object :host host :target target :id (get record :id) :phase "compile" :directory directory))))
      (let* ((traced-session (js-object :host (get session :host) :request (async (input request-options)
               (let* ((position (js-length trace))
                      (entry (js-object :position position :operation (field input "operation") :status "started"))
                      (event (js-object :host host :target target :id (get record :id) :index position
                               :operation (get entry :operation))))
                 (js-call trace :push entry)
                 (await (saveCompilerMetadata (join directory (+ "suite-request-" position ".json")) input))
                 (await (matrix-progress options directory
                   (matrix-spread event (js-object :phase "record-request-start"))))
                 (try
                   (let ((result (await (js-call session :request input (matrix-suite-request-options mode request-options input)))))
                     (put (aref trace position) :status "returned") result)
                   (catch error (put (aref trace position) :status "failed") (throw error))
                   (finally
                     (if (= (get entry :status) "returned")
                       (await (matrix-progress options directory
                         (matrix-spread event (js-object :phase "record-request-complete"))))
                       ;; Observation must never replace the original request
                       ;; failure, including cancellation and source throws.
                       (try (await (matrix-progress options directory
                              (matrix-spread event (js-object :phase "record-request-failed"))))
                         (catch progress-error nil)))))))))
             (context (js-object :host host :target target :record (cloneCompilerCorpusData record) :session traced-session
               :sourceRoot (otherwise (get options :sourceRoot) root)
               :fixtures (if (= (get record :kind) "original-suite")
                           (cloneCompilerCorpusData (otherwise (get (get corpus :document) :evidence) (js-array))) undefined)
               :directory directory :signal (get options :signal) :options execution-options
               :transportEvidence (js-object) :sourceAssets (get (get corpus :document) :evidence)
               :archiveProduct (async (value &optional name product-target)
                 (await (archiveProduct value (if (undefined? product-target) target product-target)
                   (join directory (relative-identity (if (undefined? name) "product" name)))))))))
        (try
          (progn
            (unless (nil? request)
              (setq response (await (js-call session :request request
                (matrix-spread (js-object :signal (get options :signal))
                  (if (undefined? mode) (js-object) (js-object :responseMode mode))))))
              (if (= (get record :kind) "stage")
                (progn
                  (await (saveCompilerMetadata (join directory "stage-response.json") response))
                  (when (= (value-type (field response "data")) "string")
                    (put outcome :stageIdentitySha256 (compilerDigest (JSON/stringify
                      (js-object :stage (get response :stage) :filename (get response :filename) :data (get response :data)))))))
                (progn
                  (setq product (await (archiveProduct response target (join directory "product"))))
                  (put outcome :productIdentitySha256 (get product :identitySha256))))
              (put outcome :status "produced"))
            (setq execution-started t)
            (setq observation (await (funcall (otherwise (get options :execute) executeCompilerCorpusRecord)
              (matrix-spread context (js-object :response response :artifact product)))))
            (await (saveCompilerMetadata (join directory "execution.json") observation))
            (put outcome :status (if (= (field observation "status") "executor-required") "executor-required" "executed"))
            (when (and (or (= (get record :kind) "original-suite") (= (get record :kind) "sequence"))
                       (not (undefined? (field observation "identity"))))
              (put outcome :observationIdentitySha256 (compilerMetadataDigest (get observation :identity)))))
          (catch error
            (put outcome :failure (compilerFailure error))
            (put outcome :status (if execution-started "execution-failed" "compilation-failed"))
            (setq observation (if (undefined? (get options :execute))
              (await (executeCompilerCorpusRecord (matrix-spread context (js-object :failure error))))
              (js-object :kind "diagnostic" :error (get outcome :failure))))
            (put outcome :diagnosticIdentitySha256 (compilerDigest (JSON/stringify
              (otherwise (get (get outcome :failure) :eliscriptDiagnostic)
                (js-object :name (get (get outcome :failure) :name) :message (get (get outcome :failure) :message))))))
            (await (saveCompilerMetadata (join directory "diagnostic.json") (get outcome :failure)))))
        (when (Object/hasOwn (get context :transportEvidence) "nativeProviderIdentity")
          (put outcome :nativeProviderIdentity (get (get context :transportEvidence) :nativeProviderIdentity)))
        (when (or (= (get record :kind) "original-suite") (= (get record :kind) "sequence"))
          (await (saveCompilerMetadata (join directory "suite-request-trace.json") trace)))
        (unless (undefined? observation)
          (try
            (let ((comparison (await (funcall (otherwise (get options :compare) compareCompilerCorpusObservation)
                                  (matrix-spread context (js-object :observation observation))))))
              (await (saveCompilerMetadata (join directory "comparison.json") comparison))
              (cond ((= (field comparison "status") "equivalent") (put outcome :verification "equivalent"))
                    ((= (field comparison "status") "different") (put outcome :verification "different")))
              (unless (undefined? (field comparison "reason")) (put outcome :verificationReason (get comparison :reason))))
            (catch error (put outcome :comparisonFailure (compilerFailure error)) (put outcome :verification "different")))))
      (unless (undefined? runtime-acceptance)
        (put outcome :functionalVerification (if (= (get outcome :verification) "equivalent") "passed"
          (if (= (get outcome :verification) "different") "failed" "unverified"))))
      (await (saveCompilerMetadata (join directory "outcome.json") outcome))
      (await (saveCompilerMetadata manifest metadata))
      (await (matrix-progress options directory
        (js-object :host host :target target :id (get record :id) :index index :phase "record-complete")))))

  (defun stage3-original-js-generations-p (record)
    (let* ((execution (get record :execution)) (original (get record :original))
           (contract (field execution "compilerGenerations"))
           (setup (field execution "setupReplacement")) (modules (get record :modules)))
      (and (= (get record :id) "original-program:compiler-cli-bootstrap-generations")
           (= (get record :kind) "project") (= (get record :entry) "bootstrap/compiler/compiler.mjs")
           (= (field execution "kind") "original-program")
           (= (field execution "host") "tests/__eliscript_original_compiler_cli_generations.mjs")
           (= (field original "manifest") "stable-compatibility")
           (= (field original "suite") "tests/bootstrap-compiler.test.mjs")
           (= (field original "fixture") "tests/bootstrap-compiler.test.mjs")
           (= (field original "host") "tests/bootstrap-compiler.test.mjs")
           (= (field setup "kind") "selected-compiler-generations")
           (= (field (field original "setupReplacement") "kind") "selected-compiler-generations")
           (= (value-type (field original "sourceSha256")) "string")
           (= (field original "sourceSha256") (field setup "sourceSha256"))
           (Array/isArray (get record :coverage)) (> (js-length (get record :coverage)) 0)
           (Array/isArray modules) (= (js-length modules) 13)
           (js-call (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis"
                     "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler") :every
             (lambda (name) (js-call modules :some (lambda (module)
               (= (get module :id) (+ "bootstrap/compiler/" name ".mjs"))))))
           (= (field contract "count") 3) (= (field contract "producer") "previous-generation")
           (= (field contract "target") "selected-target") (= (field contract "completeCompiler") t)
           (= (field contract "sourceMaps") t)
           (= (field contract "manifestEnvironment") "ELISCRIPT_ORIGINAL_COMPILER_GENERATIONS")
           (= (field contract "manifestFormat") "eliscript-original-compiler-generations")
           (= (field contract "manifestVersion") 1)
           (= (field contract "javascriptCompanions") "selected-generation-producer")
           (= (field contract "fixedPoint") "complete-target-artifacts-and-original-javascript-files"))))

  (defun stage3-compiler-host-reason (record target)
    (cond
      ((stage3-original-js-generations-p record)
       "moved original JS compiler generations: exact original bootstrap-compiler suite runs once through make test; output-target acceptance does not bootstrap successor compilers")
      ((and (= (get record :id) "original-managed-suite:complete-fixture-suites")
             (= (get record :kind) "project")
             (= (field (get record :execution) "kind") "original-program")
             (= (field (get record :original) "testRunner") "bun test")
             (= (field (get record :original) "semanticCoverage") "complete-original-suite-with-selected-compiler-namespaces")
             (Array/isArray (field (get record :original) "suites"))
             (> (js-length (get (get record :original) :suites)) 0))
      "moved original suite runner: original.testRunner=bun test aggregates the complete original suites; execute once through make test at the final functional gate")
      (t (when (/= target "javascript")
      (let* ((execution (get record :execution)) (original (get record :original))
             (generations (unless (nullish? execution) (get execution :compilerGenerations)))
             (complete-graph (lambda (modules)
               (and (Array/isArray modules)
                 (js-call modules :some (lambda (item) (= (get item :id) "host/compiler-session.mjs")))
                 (js-call modules :some (lambda (item) (= (get item :id) "backends/managed.mjs")))))))
        (cond
          ((and execution (= (get execution :runtimeProfile) "compiler"))
            "cancelled compiler binary host: execution.runtimeProfile=compiler")
          ((and generations (= (get generations :completeCompiler) t))
            "cancelled compiler binary host: execution.compilerGenerations.completeCompiler=true")
          ((and original (= (get original :compilerProduct) "complete actual frontend and backend graph in the selected output target"))
            "cancelled compiler binary host: original.compilerProduct declares the complete compiler")
          ((funcall complete-graph (get record :modules))
            "cancelled compiler binary host: selected output contains the complete compiler session/backend graph")
          ((and (= (get record :kind) "sequence")
             (js-call (get record :steps) :some (lambda (step)
               (funcall complete-graph (get (get step :request) :modules)))))
            "cancelled compiler binary host: sequence requests a complete compiler binary")))))))

  (defun classifyStage3Corpus (records target &rest configuration)
    (unless (and (Array/isArray records) (js-call compilerHosts :includes target))
      (matrix-type-error "stage3 corpus classification requires records and an output target"))
    (let ((effective (js-array)) (cancelled (js-array)) (deferred (js-array))
          (options (if (> (js-length configuration) 0) (aref configuration 0) undefined)))
      (js-call records :forEach (lambda (record)
        (let ((reason (stage3-compiler-host-reason record target)))
          (if reason
            (js-call cancelled :push (Object/assign (js-object :id (get record :id) :target target :status "cancelled" :reason reason)
              (cond ((js-call reason :startsWith "moved original JS compiler generations:")
                (js-object :movedTo "original-javascript-compiler-functional-gates" :gateCommand "make test"
                  :gateFile "tests/bootstrap-compiler.test.mjs" :gateVerification "pending"
                  :sourceSha256 (get (get record :original) :sourceSha256)
                  :coverage (js-call (get record :coverage) :slice)))
                ((js-call reason :startsWith "moved original suite runner:")
                (js-object :movedTo "original-final-functional-gates" :gateCommand "make test" :gateVerification "pending")
                ) (t (js-object)))))
            (let ((receipt (compilerCorpusResourceDeferred record target options)))
              (if receipt (js-call deferred :push receipt)
                (js-call effective :push (get record :id))))))))
      (js-object :scope "javascript-stage3-output-targets" :target target
        :completeIds (js-call records :map (lambda (record) (get record :id)))
        :effectiveIds effective :cancelled cancelled :resourceDeferred deferred
        :identitySha256 (compilerMetadataDigest (if (= (js-length deferred) 0)
          (js-object :effectiveIds effective :cancelled cancelled)
          (js-object :effectiveIds effective :cancelled cancelled :resourceDeferred deferred))))))

  (defasync matrix-resource-deferred (record index host target directory metadata manifest cell receipt)
    (let* ((output (join directory (+ (js-call (funcall globalThis.String index) :padStart 6 "0") "-"
                     (js-call (compilerDigest (get record :id)) :slice 0 16))))
           (outcome (Object/assign (js-object :host host :directory output) receipt)))
      (await (mkdir output (js-object :recursive t)))
      (put outcome :sourceIdentity (await (archiveCompilerCorpusSources record (join output "sources"))))
      (put outcome :execution (js-object :status "not-executed" :reason (get receipt :reason)))
      (js-call (get cell :records) :push outcome)
      (put metadata :fullCorpusVerification "unverified")
      (put cell :fullCorpusVerification "unverified")
      (await (saveCompilerMetadata (join output "resource-deferred.json") outcome))
      (await (saveCompilerMetadata manifest metadata))))

  (defasync matrix-cell (host target artifacts sources source-identity directory corpus metadata manifest execution-options options initialize-stage stage3-scope)
    (aborted (get options :signal))
    (let* ((cell (js-object :host host :target target :status "created" :verification "unverified"
                  :cleanupStatus "not-opened" :records (js-array)))
           (cell-directory (join directory (+ host "-to-" target))) (session nil) (artifact undefined))
      (js-call (get metadata :cells) :push cell)
      (await (mkdir cell-directory (js-object :recursive t)))
      (try
        (progn
          (unless (js-call artifacts :has host) (matrix-error (+ "independent compiler artifact unavailable for " host)))
          (setq artifact (if (undefined? (get options :readCompilerArtifact)) (js-call artifacts :get host)
                           (await (js-call options :readCompilerArtifact host))))
          (unless (= (normalizeCompilerHost (field artifact "host")) host)
            (matrix-error "loaded independent compiler has a different host"))
          (assertCompilerArtifactSources artifact sources)
          (unless (= (field (get artifact :productIdentity) "sha256")
                     (field (get (js-call artifacts :get host) :productIdentity) "sha256"))
            (matrix-error "loaded independent compiler differs from its retained product identity"))
          (when initialize-stage (await (funcall initialize-stage "compiler-initialize")))
          (setq session (await (openCompilerArtifact artifact (get options :sessionOptions))))
          (put cell :cleanupStatus "open")
          (put cell :status "initializing-runtime") (await (saveCompilerMetadata manifest metadata))
          (when initialize-stage (await (funcall initialize-stage "runtime-start")))
          (await (js-call session :request
            (matrix-spread (js-object :operation "runtime" :source (get (get sources :runtime) :source)
                            :filename (get (get sources :runtime) :filename))
              (if (Object/hasOwn sources "literalSources")
                (js-object :literalSources (cloneCompilerCorpusData (get sources :literalSources))) (js-object)))
            (js-object :signal (get options :signal))))
          (when initialize-stage (await (funcall initialize-stage "runtime-complete")))
          (let ((mode undefined))
            (unless (= target "javascript")
              (let* ((capabilities (await (js-call session :request (js-object :operation "capabilities") (js-object :signal (get options :signal)))))
                     (modes (field capabilities "responseModes")))
                (setq mode (matrix-response-mode modes))
                (unless (undefined? mode) (put cell :responseMode mode))))
            (put cell :runtimeSourceSha256 (get (get source-identity :runtime) :sha256))
            (put cell :literalSourceIdentity (clone (otherwise (get source-identity :literalSources) (js-array))))
            (put cell :compilerIdentity (field (get artifact :productIdentity) "sha256"))
            (let ((index 0) (records (get corpus :records)))
              (while (< index (js-length records))
                (let* ((record (aref records index))
                       (reason (when stage3-scope (stage3-compiler-host-reason record target)))
                       (deferred (when (and stage3-scope (not reason))
                         (compilerCorpusResourceDeferred record target
                           (matrix-spread options (js-object :sourceAssets (get (get corpus :document) :evidence)))))))
                  (if reason
                    (progn
                      (js-call (get cell :records) :push (js-object :id (get record :id) :host host :target target
                        :status "cancelled" :verification "cancelled" :reason reason))
                      (await (saveCompilerMetadata manifest metadata)))
                    (if deferred
                      (await (matrix-resource-deferred record index host target cell-directory metadata manifest cell deferred))
                      (await (matrix-case-execution record index host target session mode cell-directory
                      metadata manifest corpus execution-options options cell (get sources :literalSources)
                      (get source-identity :literalSources)))))) (setq index (1+ index)))))
          (put cell :status "constructed")
          (await (matrix-progress options cell-directory
            (js-object :host host :target target :phase "records-complete" :count (js-length (get cell :records))))))
        (catch error (put cell :status "failed") (put cell :failure (compilerFailure error)))
        (finally
          (when session
            (put cell :cleanupStatus "closing")
            (try
              (progn
                ;; Even a progress IO/observer failure must not skip close.
                (try
                  (await (matrix-progress options cell-directory
                    (js-object :host host :target target :phase "session-close-start" :count (js-length (get cell :records)))))
                  (finally (await (js-call session :close))))
                (put cell :cleanupStatus "closed")
                (await (matrix-progress options cell-directory
                  (js-object :host host :target target :phase "session-close-complete" :count (js-length (get cell :records))))))
              (catch error (put cell :cleanupFailure (compilerFailure error))
                (put cell :cleanupStatus "failed") (put cell :status "failed")
                (try (await (matrix-progress options cell-directory
                       (js-object :host host :target target :phase "session-close-failed" :count (js-length (get cell :records)))))
                  (catch progress-error nil)))))
          (setq session nil artifact undefined)))
      (await (saveCompilerMetadata manifest metadata))))

  ;; A single cell executes the complete original corpus with the actual
  ;; selected producer. It is independent work, never complete-grid evidence:
  ;; cross-producer products, original gates and self-host fixed points still
  ;; require the unchanged full matrix entry below.
  (defasync runCompilerMatrixCell (options) (await (run-matrix-cell options false)))
  ;; Scope is chosen by this entry, never read from public options. The old
  ;; cell and nine-grid paths still execute every original record unchanged.
  (defasync runStage3CompilerTargetCell (options) (await (run-matrix-cell options t)))
  (defasync run-matrix-cell (options stage3-scope)
    (unless (and options (= (value-type options) "object")
                 (not (Array/isArray options)))
      (matrix-type-error "compiler matrix cell options are required"))
    (unless (and (= (value-type (get options :host)) "string")
                 (= (value-type (get options :target)) "string"))
      (matrix-type-error "matrix cell host and target are required"))
    (let* ((host (normalizeCompilerHost (get options :host)))
           (target (normalizeCompilerHost (get options :target)))
           (output (get options :outputRoot))
           (path (get options :metadataPath)) (initial (get options :compilerArtifact))
           (source-root (otherwise (get options :sourceRoot) root))
           (profile (otherwise (get options :profile) "small"))
           (stage (get options :onStage)))
      (unless (and (= (value-type output) "string") (> (js-length output) 0))
        (matrix-type-error "matrix cell outputRoot is required"))
      (when (= (undefined? path) (undefined? initial))
        (matrix-type-error "matrix cell requires one compilerArtifact or metadataPath"))
      (unless (undefined? path)
        (unless (and (= (value-type path) "string") (> (js-length path) 0))
          (matrix-type-error "matrix cell metadataPath is required"))
        (setq path (resolve path)))
      (unless (undefined? initial)
        (unless (and initial (= (value-type initial) "object") (not (Array/isArray initial)))
          (matrix-type-error "matrix cell compilerArtifact is required")))
      (setq source-root (resolve source-root) output (resolve output))
      (aborted (get options :signal))
      (let* ((corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot source-root
                        :records (get options :corpusRecords) :recordsPath (get options :corpusRecordsPath)))))
             (sources (await (loadCompilerSources (js-object :sourceRoot source-root))))
             (source-identity (compilerSourceIdentity sources)))
        (await (mkdir output (js-object :recursive t)))
        (let* ((directory (await (mkdtemp (join output (+ "compiler-matrix-cell-" host "-" target "-")))))
               (manifest (join directory "matrix.json"))
               (metadata (js-object :format "eliscript-independent-compiler-matrix-cell" :version 1
                 :scope "single-cell" :host host :target target :status "constructing" :verification "unverified"
                 :finalGridVerification "unverified" :crossCellVerification "unverified"
                 :generationsVerification "unverified" :originalGateVerification "not-evaluated"
                 :pendingVerifications (js-array "cross-cell-identities" "three-generation-fixed-point" "original-gates")
                 :sourceIdentity source-identity
                 :corpusIdentity (matrix-spread (get corpus :identity) (js-object :recordsSha256 (get corpus :recordsSha256)))
                 :cells (js-array) :comparisons (js-array)))
               (artifacts (new globalThis.Map))
               (producer-record (js-object :host host))
               (cell-options (matrix-spread options))
               (execution-options (matrix-spread options (js-object :profile profile
                 :originalOracle (if (nullish? (get options :originalOracle))
                   (createOriginalSeedOracle (js-object :sourceRoot source-root :emacs (get options :emacs) :signal (get options :signal)
                     :bootstrapManifestPath (get options :bootstrapManifestPath)
                     :directory (join directory "original-seed-oracles") :node (get options :node) :bun (get options :bun)
                     :sourceAssets (get (get corpus :document) :evidence) :literalSources (get sources :literalSources)
                     :literalSourceIdentity (get source-identity :literalSources) :programCache (get options :programCache)
                     :programHost (get options :programHost) :profile profile :budget (get options :budget) :memory (get options :memory)
                     :auto (get options :auto) :nativeTarget (get options :nativeTarget) :sessionOptions (get options :sessionOptions)))
                   (get options :originalOracle))))))
          ;; Only this actual producer is loaded. Keep no second typed graph in
          ;; the identity map; the per-cell scope owns the decoded manifest.
          (js-call artifacts :set host producer-record)
          (put cell-options :sourceRoot source-root)
          (put cell-options :readCompilerArtifact (async (requested-host)
            (unless (= requested-host host) (matrix-error "matrix cell requested a different producer"))
            (let ((artifact (if (undefined? path) initial (await (readCompilerMetadata path)))))
              (setq initial undefined)
              (unless (undefined? path) (put artifact :metadataPath path))
              (unless (= (normalizeCompilerHost (field artifact "host")) host)
                (matrix-error "loaded independent compiler has a different host"))
              (assertCompilerArtifactSources artifact sources)
              (let ((identity (field (get artifact :productIdentity) "sha256")))
                (unless (and (= (value-type identity) "string") (> (js-length identity) 0))
                  (matrix-type-error "matrix cell requires its actual compiler product identity"))
                (put producer-record :productIdentity (js-object :sha256 identity))
                (put metadata :producerIdentity identity))
              artifact)))
          (await (saveCompilerMetadata manifest metadata))
          (try
            (progn
              (await (archiveCompilerSources sources (join directory "compiler-sources")))
              (await (archive-original-corpus corpus (join directory "corpus") source-root))
              (put metadata :originalCorpusBeforeExecution
                (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot source-root :corpus corpus))))
              (when stage3-scope
                (put metadata :acceptanceScope "javascript-stage3-output-targets")
                (put metadata :corpusSelection (classifyStage3Corpus (get corpus :records) target
                  (matrix-spread options (js-object :sourceAssets (get (get corpus :document) :evidence))))))
              (await (matrix-cell host target artifacts sources source-identity directory corpus metadata manifest
                execution-options cell-options
                (async (phase)
                  (unless (nullish? stage)
                    (await (funcall stage (js-object :host host :target target :phase phase :directory directory))))) stage3-scope))
              ;; These private wrappers (including the independent oracle's
              ;; memo) have no consumer after all requests and close finished.
              ;; Caller-owned options and corpus declarations remain untouched.
              (setq execution-options nil cell-options nil)
              (await (matrix-progress options directory
                (js-object :host host :target target :phase "source-verify-start")))
              (let* ((cell (aref (get metadata :cells) 0))
                     (complete (and (= (get cell :status) "constructed")
                                    (= (js-length (get cell :records)) (js-length (get corpus :records)))))
                     (semantics (js-call (get cell :records) :every
                                  (lambda (record) (or (= (get record :verification) "equivalent")
                                    (and stage3-scope (= (get record :verification) "cancelled"))
                                    (and stage3-scope (= (get record :status) "resource-deferred")
                                      (= (get record :verification) "deferred"))))))
                     (missing (/= (js-length (get (get corpus :identity) :missingCaseAdapters)) 0))
                     (final-identity (compilerSourceIdentity (await (loadCompilerSources (js-object :sourceRoot source-root)))))
                     (after undefined))
                (await (matrix-progress options directory
                  (js-object :host host :target target :phase "source-verify-complete")))
                (await (matrix-progress options directory
                  (js-object :host host :target target :phase "corpus-verify-start")))
                (setq after (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot source-root :corpus corpus))))
                (await (matrix-progress options directory
                  (js-object :host host :target target :phase "corpus-verify-complete")))
                (put metadata :finalSourceIdentity final-identity)
                (put metadata :sourceUnchanged (= (get final-identity :sha256) (get source-identity :sha256)))
                (put metadata :originalCorpusAfterExecution after)
                (put metadata :originalCorpusUnchanged
                  (and (= (get (get metadata :originalCorpusBeforeExecution) :status) "unchanged")
                       (= (get after :status) "unchanged")))
                (let ((equivalent (and complete semantics (not missing)
                                      (get metadata :sourceUnchanged) (get metadata :originalCorpusUnchanged))))
                  (put cell :verification (if equivalent "equivalent" "unverified"))
                  (put metadata :verification (if equivalent "equivalent" "unverified"))
                  (when (Object/hasOwn metadata "fullCorpusVerification")
                    (put metadata :verificationScope "effective-corpus")
                    (put metadata :effectiveVerification (if equivalent "equivalent" "unverified"))
                    (put metadata :passedCount (js-length (js-call (get cell :records) :filter
                      (lambda (record) (= (get record :verification) "equivalent")))))
                    (put metadata :resourceDeferredCount (js-length (js-call (get cell :records) :filter
                      (lambda (record) (= (get record :status) "resource-deferred"))))))
                  (put metadata :status (if (= (get cell :status) "failed") "failed"
                                         (if equivalent "consistent" "incomplete"))))
                (await (saveCompilerMetadata manifest metadata))
                (unless (nullish? stage)
                  (await (funcall stage (js-object :host host :target target :phase "cell-complete" :directory directory))))
                (js-object :directory directory :metadata metadata :cell cell)))
            (catch error
              (put metadata :status "failed") (put metadata :verification "unverified")
              (put metadata :failure (compilerFailure error))
              (await (saveCompilerMetadata manifest metadata)) (throw error)))))))

  (defun matrix-comparisons (metadata corpus)
    (js-call compilerHosts :forEach (lambda (target)
      (js-call (get corpus :records) :forEach (lambda (record)
        (let* ((records (js-call compilerHosts :map (lambda (host)
                 (let ((cell (js-call (get metadata :cells) :find (lambda (item)
                         (and (= (get item :host) host) (= (get item :target) target))))))
                   (if (nullish? cell) undefined
                     (js-call (get cell :records) :find (lambda (item) (= (get item :id) (get record :id)))))))))
               (products (js-call records :map (lambda (item) (field item "productIdentitySha256"))))
               (diagnostics (js-call records :map (lambda (item) (field item "diagnosticIdentitySha256"))))
               (stages (js-call records :map (lambda (item) (field item "stageIdentitySha256"))))
               (observations (js-call records :map (lambda (item) (field item "observationIdentitySha256"))))
               (kind "incomplete") (identities nil))
          (cond
            ((js-call products :every globalThis.Boolean) (setq kind "product" identities products))
            ((js-call diagnostics :every globalThis.Boolean) (setq kind "diagnostic" identities diagnostics))
            ((js-call stages :every globalThis.Boolean) (setq kind "stage" identities stages))
            ((js-call observations :every globalThis.Boolean) (setq kind "observation" identities observations)))
          (js-call (get metadata :comparisons) :push (js-object :id (get record :id) :target target :kind kind
            :status (if identities (if (= (get (new globalThis.Set identities) :size) 1) "identical" "different") "unverified")
            :identities identities))))))))

  (defasync buildCompilerMatrix (&rest arguments)
    (let ((options (matrix-call-options arguments)))
      (unless (= (value-type (get options :outputRoot)) "string") (matrix-type-error "matrix outputRoot is required"))
      (let* ((source-root (otherwise (get options :sourceRoot) root))
             (corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot source-root
                       :records (get options :corpusRecords) :recordsPath (get options :corpusRecordsPath)))))
             (sources (await (loadCompilerSources (js-object :sourceRoot source-root))))
             (source-identity (compilerSourceIdentity sources)))
        (await (mkdir (get options :outputRoot) (js-object :recursive t)))
        (let* ((directory (await (mkdtemp (join (resolve (get options :outputRoot)) "compiler-matrix-"))))
               (profile (otherwise (get options :profile) "small"))
               (execution-options (matrix-spread options (js-object :profile profile
                 :originalOracle (if (nullish? (get options :originalOracle))
                   (createOriginalSeedOracle (js-object :sourceRoot source-root :emacs (get options :emacs) :signal (get options :signal)
                     :bootstrapManifestPath (get options :bootstrapManifestPath)
                     :directory (join directory "original-seed-oracles") :node (get options :node) :bun (get options :bun)
                     :sourceAssets (get (get corpus :document) :evidence) :literalSources (get sources :literalSources)
                     :literalSourceIdentity (get source-identity :literalSources) :programCache (get options :programCache)
                     :programHost (get options :programHost) :profile profile :budget (get options :budget) :memory (get options :memory)
                     :auto (get options :auto) :nativeTarget (get options :nativeTarget) :sessionOptions (get options :sessionOptions)))
                   (get options :originalOracle))))))
          (await (archiveCompilerSources sources (join directory "compiler-sources")))
          (await (archive-original-corpus corpus (join directory "corpus") source-root))
          (let* ((metadata (js-object :format "eliscript-independent-compiler-matrix" :version 1 :status "constructing"
                    :verification "unverified" :sourceIdentity source-identity
                    :originalGateVerification (otherwise (field (get (get corpus :document) :originalGateEvidence) "verification") "not-supplied")
                    :corpusIdentity (matrix-spread (get corpus :identity) (js-object :recordsSha256 (get corpus :recordsSha256)))
                    :cells (js-array) :comparisons (js-array)))
                 (manifest (join directory "matrix.json")) (artifacts (new globalThis.Map)))
            (await (saveCompilerMetadata manifest metadata))
            (try
              (progn
                (let ((grid (get options :compilerGrid)))
                  (when (undefined? grid)
                    (setq grid (await (bootstrapCompilerGrid (matrix-spread options
                      (js-object :outputRoot (join directory "compilers") :sources sources
                        :generations (otherwise (get options :generations) 3) :continueOnError t))))))
                  (let* ((reader (get options :readCompilerArtifact))
                         (lazy (not (undefined? reader)))
                         (supplied (if lazy (get options :compilerArtifactRecords)
                                     (otherwise (get options :compilerArtifacts) (get grid :canonicalArtifacts)))))
                    (when lazy
                      (unless (and (= (value-type reader) "function") (Array/isArray supplied) (= (js-length supplied) 3))
                        (matrix-type-error "lazy compiler matrix requires its reader and three artifact records")))
                    (when supplied
                      (let ((records (if (Array/isArray supplied) supplied (Object/values supplied))) (index 0))
                        (while (< index (js-length records))
                          (let* ((artifact (aref records index)) (host (normalizeCompilerHost (get artifact :host))))
                            (when (js-call artifacts :has host) (matrix-error "duplicate independent compiler host"))
                            (if lazy
                              (progn
                                (unless (and (= (value-type (get artifact :metadataPath)) "string")
                                             (> (js-length (get artifact :metadataPath)) 0)
                                             (= (value-type (field (get artifact :productIdentity) "sha256")) "string")
                                             (> (js-length (get (get artifact :productIdentity) :sha256)) 0))
                                  (matrix-type-error "lazy compiler matrix requires authenticated artifact paths and identities"))
                                ;; Keep no arbitrary caller fields or typed graph in
                                ;; the long-lived host map. The real manifest is
                                ;; checked at the existing per-cell boundary.
                                (js-call artifacts :set host (js-object :host host
                                  :metadataPath (get artifact :metadataPath)
                                  :productIdentity (js-object :sha256 (get (get artifact :productIdentity) :sha256)))))
                              (progn (assertCompilerArtifactSources artifact sources) (js-call artifacts :set host artifact))))
                          (setq index (1+ index))))))
                  (put metadata :bootstrapDirectory (field (field (get grid :metadata) "generations") "directory"))
                  (put metadata :compilerGrid (await (retain-compiler-grid grid directory source-identity artifacts))))
                (await (saveCompilerMetadata manifest metadata))
                (let ((host-index 0))
                  (while (< host-index (js-length compilerHosts))
                    (let ((target-index 0) (host (aref compilerHosts host-index)))
                      (while (< target-index (js-length compilerHosts))
                        (await (matrix-cell host (aref compilerHosts target-index) artifacts sources source-identity directory corpus
                          metadata manifest execution-options options)) (setq target-index (1+ target-index))))
                    (setq host-index (1+ host-index))))
                (matrix-comparisons metadata corpus)
                (let* ((cells (get metadata :cells)) (comparisons (get metadata :comparisons))
                       (complete (and (= (js-length cells) 9) (js-call cells :every (lambda (cell)
                         (and (= (get cell :status) "constructed") (= (js-length (get cell :records)) (js-length (get corpus :records))))))))
                       (semantics (js-call cells :every (lambda (cell) (js-call (get cell :records) :every (lambda (record) (= (get record :verification) "equivalent"))))))
                       (identities (js-call comparisons :every (lambda (item) (= (get item :status) "identical"))))
                       (different (or (js-call comparisons :some (lambda (item) (= (get item :status) "different")))
                         (js-call cells :some (lambda (cell) (js-call (get cell :records) :some (lambda (record) (= (get record :verification) "different")))))))
                       (pending (js-call cells :some (lambda (cell) (js-call (get cell :records) :some (lambda (record) (= (get record :status) "executor-required"))))))
                       (missing (/= (js-length (get (get corpus :identity) :missingCaseAdapters)) 0))
                       (grid-complete (= (field (get metadata :compilerGrid) "identityVerification") "identical"))
                       (before (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot source-root :corpus corpus)))))
                  (put metadata :originalCorpusBeforeGates before)
                  (when (and complete semantics identities (not missing) grid-complete (= (get before :status) "unchanged"))
                    (put metadata :originalGates (await (runOriginalCompilerGates (js-object :sourceRoot source-root :corpus corpus
                      :sourceIdentity source-identity :directory directory :signal (get options :signal)))))
                    (put metadata :originalGateVerification (get (get metadata :originalGates) :status)))
                  (let* ((gates-complete (or (/= (field (get (get corpus :document) :originalGateEvidence) "required") t)
                                            (= (get metadata :originalGateVerification) "passed")))
                         (final-identity (compilerSourceIdentity (await (loadCompilerSources (js-object :sourceRoot source-root))))))
                    (put metadata :sourceUnchanged (= (get final-identity :sha256) (get source-identity :sha256)))
                    (put metadata :finalSourceIdentity final-identity)
                    (put metadata :originalCorpusAfterGates (await (verifyOriginalCompilerCorpusFiles (js-object :sourceRoot source-root :corpus corpus))))
                    (put metadata :originalCorpusUnchanged (and (= (get before :status) "unchanged")
                      (= (get (get metadata :originalCorpusAfterGates) :status) "unchanged")))
                    (put metadata :performanceAcceptance (if (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1") "deferred" "not-evaluated"))
                    (put metadata :status (if (or (not complete) different pending missing (not grid-complete) (not gates-complete)
                       (not (get metadata :sourceUnchanged)) (not (get metadata :originalCorpusUnchanged)))
                      "incomplete" (if (and semantics identities) "consistent" "constructed")))
                    (put metadata :verification (if (and complete semantics identities (not missing) grid-complete gates-complete
                      (get metadata :sourceUnchanged) (get metadata :originalCorpusUnchanged)) "equivalent" "unverified"))))
                (await (saveCompilerMetadata manifest metadata)) (js-object :directory directory :metadata metadata))
              (catch error (put metadata :status "failed") (put metadata :failure (compilerFailure error))
                (await (saveCompilerMetadata manifest metadata)) (throw error))))))))

  (export loadOriginalCompilerManifests loadCompilerMatrixCorpus verifyOriginalCompilerCorpusFiles
    archiveProduct runOriginalCompilerGates buildCompilerMatrix runCompilerMatrixCell
    runStage3CompilerTargetCell classifyStage3Corpus
    ;; Uncertified transport seams: these cannot open or authenticate a cell.
    matrix-case-execution matrix-response-mode))
