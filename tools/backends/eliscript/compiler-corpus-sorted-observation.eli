(module tools.backends.compiler-corpus-sorted-observation
  (import "node:assert/strict" :default assert)
  ;; These are the maintained suite's complete functional partitions. They
  ;; change scheduling only: auto(1), every update and every assertion remain.
  (defconst sortedFunctionalParts (Object/freeze (js-array
    "rotations" "sharing" "randomized" "recovery-0" "recovery-1"
    "original-report" "original-boundaries" "ranges" "semantics" "order-cases"
    "full-order-contracts" "comparator-failure" "transport" "lazy-iterators" "held")))
  (defconst sortedMaintainedSha "b50ef30a27b71ca6b35e8f15b2727ed825bee98c16091547abb45dbe47eae7ca")
  (defun sortedFunctionalPartition (record)
    (let* ((original (get record :original)) (bound (when original (get original :functionalPartition)))
           (proof (when original (get original :maintainedAssertions))))
      (when bound
        (let* ((part (get bound :part)) (index (js-call sortedFunctionalParts :indexOf part))
               (id (get record :id)) (base (get bound :originalId)))
          (unless (and (>= index 0) (= (get bound :index) index)
            (= (JSON/stringify (get bound :parts)) (JSON/stringify sortedFunctionalParts))
            (= (get proof :sourceSha256) sortedMaintainedSha)
            (= (get original :suite) "tests/wasm-managed-sorted-core.test.mjs")
            (= (get original :fixture) "tests/fixtures/wasm-managed-sorted.eli")
            (= (get record :auto) 1) (= (value-type base) "string")
            (js-call (new globalThis.RegExp "^original-managed:sorted-core:(node|bun):auto-1$") :test base)
            (= id (if (= index 0) base (str base ":part-" part))))
            (throw (new globalThis.TypeError "sorted functional partition differs from its complete maintained schedule")))
          part))))
  (defun sortedFunctionalDeadline (record target)
    (let ((part (sortedFunctionalPartition record)))
      (when part
        (cond ((= target "javascript") 30000)
          ((js-call part :startsWith "recovery-") (if (= target "native") 1200000 240000))
          ((or (= part "rotations") (= part "sharing")) (if (= target "native") 900000 240000))
          ((= part "randomized") (if (= target "native") 600000 240000))
          (t (if (= target "native") 120000 30000))))))
  (defun observeSortedPart (m part random-operations)
    (unless (js-call sortedFunctionalParts :includes part)
      (throw (new globalThis.TypeError "unknown sorted functional partition")))
    (let ((calls (js-array)) (errors (js-array)))
      (letfn ((call (name &rest arguments)
        (let ((result (Reflect/apply (get m (js-call name :replaceAll "-" "_")) m arguments)))
          (js-call calls :push (js-array name result)) result))
        (rotations ()
          (let ((state (js-call m :rotations_state)) (index 0))
            (while (< index 196)
              (let ((progress (call "rotations-step" state))
                    (expected (cond ((< index 3) (js-array 0 0 (1+ index)))
                      ((< index 99) (js-array 1 (- index 3) 4))
                      ((< index 195) (js-array 2 (- index 99) 4)) (t (js-array 3 96 4)))))
                (js-call assert :deepStrictEqual progress expected))
              (setq index (1+ index)))
            (call "rotations-result" state))))
        (cond ((= part "rotations") (rotations))
          ((= part "sharing")
            (let ((state (js-call m :sharing_state)) (index 0))
              (while (< index 127)
                (js-call assert :strictEqual (call "sharing-step" state) (1+ index))
                (setq index (1+ index)))
              (call "sharing-result" state)))
          ((= part "randomized") (call "randomized" random-operations))
          ((= part "held")
            (let ((state (js-call m :held_state)) (index 0))
              (while (< index 5) (call "held-step" state) (setq index (1+ index)))))
          ((js-call part :startsWith "recovery-")
            (js-call assert :throws (lambda () (js-call m :throw_comparison))
              (lambda (error)
                (js-call errors :push (js-array (get error :name) (get error :message)))
                (and (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) error)
                     (= (get error :message) "sorted comparison marker"))))
            (rotations))
          (t (call part))))
      (js-object :calls calls :errors errors)))
  (export sortedFunctionalParts sortedMaintainedSha sortedFunctionalPartition sortedFunctionalDeadline observeSortedPart))
