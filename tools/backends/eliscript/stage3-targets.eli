(module tools.backends.stage3-targets
  (import "node:fs/promises" readFile writeFile mkdir realpath)
  (import "node:path" resolve dirname relative)
  (import "node:util" isDeepStrictEqual)
  (import "./build.mjs" root)
  (import "./compiler-bootstrap.mjs" compilerFailure compilerDigest saveCompilerMetadata compilerSourceIdentity)
  (import "./compiler-build.mjs" loadCompilerSources independentCompilerProductIdentity)
  (import "./compiler-metadata.mjs" readCompilerMetadata)
  (import "./compiler-matrix.mjs" loadCompilerMatrixCorpus runStage3CompilerTargetCell classifyStage3Corpus)
  (import "./compiler-corpus-execution.mjs" compilerCorpusRuntimeAcceptance)
  (import "./dist/bootstrap-js-stages.mjs" compareJsFixedPoint)

  (defconst targets (Object/freeze (js-array "javascript" "wasm" "native")))
  (defun fail (message) (throw (new globalThis.Error message)))
  (defun type-fail (message) (throw (new globalThis.TypeError message)))
  (defun object-options (value)
    (unless (and value (= (value-type value) "object") (not (Array/isArray value)))
      (type-fail "stage3 options must be an object")) value)
  (defun required-path (value label)
    (unless (and (= (value-type value) "string") (> (js-length value) 0))
      (type-fail (+ label " is required"))) (resolve value))
  (defun snapshot (value)
    (let ((result (js-object)))
      (js-call (Reflect/ownKeys value) :forEach (lambda (key)
        (when (get (Object/getOwnPropertyDescriptor value key) :enumerable)
          (Object/defineProperty result key (js-object :value (get value key)
            :enumerable t :writable t :configurable t))))) result))
  (defun identical (actual expected label)
    (unless (isDeepStrictEqual actual expected) (fail (+ label " differs from authenticated stage3"))))
  (defun reason (signal)
    (if (undefined? (get signal :reason)) (new globalThis.Error "stage3 targets cancelled") (get signal :reason)))
  (defun cancelled (signal) (and (not (nullish? signal)) (get signal :aborted)))
  (defasync progress (callback event)
    ;; Progress is scalar evidence, never an alternative executor or a source
    ;; of program errors. It cannot replace the first actual failure.
    (unless (nullish? callback)
      (try (await (funcall callback (Object/freeze event))) (catch ignored nil))))

  (defasync authenticateStage3Targets (input)
    (let* ((options (snapshot (object-options input)))
           (manifest-path (await (realpath (required-path (get options :bootstrapManifestPath) "bootstrapManifestPath"))))
           (base (dirname manifest-path))
           (manifest (await (readCompilerMetadata manifest-path)))
           (stages (get manifest :stages)))
      (if (= (get manifest :format) "eliscript-stage3-release")
        (progn
          (unless (and (= (get manifest :version) 1) (= (get manifest :status) "accepted")
                       (= (get manifest :verification) "identical")
                       (Number/isInteger (get manifest :fixedPointFileCount))
                       (> (get manifest :fixedPointFileCount) 0))
            (fail "an accepted stage3 release receipt is required"))
          (let* ((path3 (await (realpath (resolve base (get manifest :metadataPath)))))
                 (supplied (get options :stage3MetadataPath))
                 (artifact (await (readCompilerMetadata path3)))
                 (directory (dirname path3))
                 (declared-files (get (get artifact :artifactIdentity) :files))
                 (verified-files (js-array))
                 (index 0))
            (unless (undefined? supplied)
              (unless (= (await (realpath (required-path supplied "stage3MetadataPath"))) path3)
                (fail "the requested compiler is not the designated final stage3")))
            (identical (get artifact :sourceIdentity) (get manifest :artifactSourceIdentity) "stage3 source identity")
            (identical (get artifact :stage3FullProductIdentity) (get manifest :stage3ProductIdentity) "stage3 product identity")
            (unless (and (Array/isArray declared-files) (> (js-length declared-files) 0))
              (fail "packaged stage3 artifact requires declared files"))
            (while (< index (js-length declared-files))
              (let* ((entry (aref declared-files index))
                     (rel-path (get entry :path))
                     (bytes (await (readFile (resolve directory rel-path))))
                     (actual-sha (compilerDigest bytes)))
                (unless (and (= (js-length bytes) (get entry :bytes)) (= actual-sha (get entry :sha256)))
                  (fail (+ "packaged stage3 file changed after emission: " rel-path)))
                (js-call verified-files :push (js-object :path rel-path :bytes (js-length bytes) :sha256 actual-sha)))
              (setq index (1+ index)))
            (let ((actual-packaged (independentCompilerProductIdentity
                    (js-object :host (get artifact :host) :nativeTarget (get artifact :nativeTarget)
                      :files verified-files :descriptor (get artifact :descriptor) :typed (get artifact :typed)))))
              (identical actual-packaged (get artifact :productIdentity) "packaged stage3 artifact product identity")
              (identical actual-packaged (get manifest :packagedProductIdentity) "packaged stage3 release product identity")
              (js-object :scope "stage3-identity" :verification "authenticated"
                :bootstrapManifestPath manifest-path :stage3MetadataPath path3
                :stage2MetadataPath path3 :stage2ProductIdentity (get manifest :stage2ProductIdentity)
                :fixedPointFileCount (get manifest :fixedPointFileCount)
                :sourceIdentity (get manifest :formalSourceIdentity)
                :productIdentity (get manifest :stage3ProductIdentity)))))
        (progn
          (unless (and (= (get manifest :format) "eliscript-js-bootstrap") (= (get manifest :version) 1)
                       (= (get manifest :status) "accepted") (Array/isArray stages) (= (js-length stages) 4))
            (fail "an accepted JavaScript stage0-stage3 bootstrap is required"))
          (let ((index 0))
            (while (< index 4)
              (let ((stage (aref stages index)))
                (unless (and (= (get stage :stage) index) (= (get stage :host) "javascript")
                             (= (get stage :target) "javascript") (= (get stage :status) "built")
                             (= (get stage :producer) (if (= index 0) "emacs-lisp" (+ "stage" (1- index)))))
                  (fail "bootstrap stage provenance is invalid"))
                (identical (get stage :inputIdentity) (get manifest :formalSourceIdentity) "stage source identity"))
              (setq index (1+ index))))
          (unless (and (= (get (get manifest :fixedPoint) :from) 2)
                       (= (get (get manifest :fixedPoint) :to) 3)
                       (= (get (get manifest :fixedPoint) :status) "identical"))
            (fail "stage2-stage3 fixed point is not identical"))
          (let* ((stage2 (aref stages 2)) (stage3 (aref stages 3))
                 (path2 (await (realpath (resolve base (get stage2 :metadataPath)))))
                 (path3 (await (realpath (resolve base (get stage3 :metadataPath)))))
                 (supplied (get options :stage3MetadataPath))
                 (receipt-path (resolve base (get (get manifest :fixedPoint) :comparisonPath))))
            (unless (undefined? supplied)
              (unless (= (await (realpath (required-path supplied "stage3MetadataPath"))) path3)
                (fail "the requested compiler is not the designated final stage3")))
            (let* ((receipt (await (readCompilerMetadata receipt-path)))
                   (actual (await (compareJsFixedPoint (js-object :stage2 path2 :stage3 path3
                     :sourceIdentity (get manifest :formalSourceIdentity))))))
              (identical actual receipt "fixed-point receipt")
              (identical (get actual :stage2ProductIdentity) (get stage2 :productIdentity) "stage2 product identity")
              (identical (get actual :stage3ProductIdentity) (get stage3 :productIdentity) "stage3 product identity")
              (js-object :scope "stage3-identity" :verification "authenticated"
                :bootstrapManifestPath manifest-path :stage3MetadataPath path3
                :stage2MetadataPath path2 :stage2ProductIdentity (get actual :stage2ProductIdentity)
                :fixedPointFileCount (js-length (get actual :files))
                :sourceIdentity (get manifest :formalSourceIdentity) :productIdentity (get actual :stage3ProductIdentity))))))))

  (defun cancel-target-entry (result entry signal)
    (unless (get result :hasFailure)
      (put result :hasFailure t) (put result :failure (reason signal)))
    (put result :status "cancelled")
    (put entry :status "cancelled"))

  (defasync run-target-entry (options run-cell result entry)
    (let ((target (get entry :target)) (signal (get options :signal)) (observer (get options :onStage)))
      (if (cancelled signal) (cancel-target-entry result entry signal)
        (progn
          (put entry :status "running")
          (await (progress observer (js-object :host "javascript" :target target :phase "target-start")))
          ;; A callback or an earlier target can abort while progress yields.
          ;; A pending cell must not start merely because it was scheduled.
          (if (cancelled signal) (cancel-target-entry result entry signal)
            (try
              (let* ((call (js-object :host "javascript" :target target :metadataPath (get options :stage3MetadataPath)
                             :corpusRecordsPath (get options :corpusRecordsPath)
                             :outputRoot (resolve (get options :outputRoot) target)
                             :sourceRoot (get options :sourceRoot) :nativeTarget (get options :nativeTarget)
                             :programCache (get options :programCache)
                             :bootstrapManifestPath (get options :bootstrapManifestPath)
                             :signal signal :sessionOptions (get options :sessionOptions) :onStage observer))
                     (_resources (unless (undefined? (get options :functionalRuntimeProfile))
                       (put call :functionalRuntimeProfile (get options :functionalRuntimeProfile))))
                     (actual (await (funcall run-cell call)))
                     (metadata (get actual :metadata)))
                (put entry :directory (get actual :directory))
                (put entry :manifestPath (resolve (get actual :directory) "matrix.json"))
                (put entry :status (if (= (get metadata :verification) "equivalent") "passed" "failed"))
                (when (get metadata :resourceAcceptance)
                  (put entry :resourceAcceptance (get metadata :resourceAcceptance))
                  (put entry :resourceOutcomes (get metadata :resourceOutcomes)))
                (when (get metadata :corpusSelection)
                  (let ((selection (get metadata :corpusSelection)))
                    (put entry :corpusSelection selection)
                    (put entry :effectiveCount (js-length (get selection :effectiveIds)))
                    (put entry :cancelledCount (js-length (get selection :cancelled)))
                    (put entry :resourceDeferred (get selection :resourceDeferred (js-array)))
                    (put entry :resourceDeferredCount (js-length (get entry :resourceDeferred)))
                    (when (> (get entry :resourceDeferredCount) 0)
                      (put entry :fullCorpusVerification "unverified")
                      (put entry :verificationScope "effective-corpus")
                      (put entry :passedCount (get metadata :passedCount 0)))
                    (when (and (= (get entry :status) "passed")
                               (or (> (get entry :cancelledCount) 0) (> (get entry :resourceDeferredCount) 0)))
                      (put entry :status "passed-effective-scope"))))
                (when (= (get entry :status) "failed")
                  (throw (new globalThis.Error (+ "stage3 " target " output acceptance failed; see " (get entry :manifestPath))))))
              (catch error
                (put entry :status (if (cancelled signal) "cancelled" "failed"))
                (put entry :failure (compilerFailure error))
                ;; Completion order defines the first failure, including
                ;; false/undefined; target-array order never replaces it.
                (unless (get result :hasFailure) (put result :hasFailure t) (put result :failure error))
                (put result :status (if (cancelled signal) "cancelled" "failed")))))
          (await (progress observer (js-object :host "javascript" :target target :phase "target-complete" :status (get entry :status))))))))

  ;; A deliberately uncertified scheduling seam. Only runStage3Targets below
  ;; authenticates files, captures the corpus, and fixes the real cell runner.
  ;; Parallelism uses promises in this process, not another worker/process.
  (defasync run-stage3-target-schedule (input run-cell)
    (let* ((options (snapshot (object-options input)))
           (parallel (get options :parallelTargets))
           (entries (js-call targets :map (lambda (target)
                      (js-object :host "javascript" :target target :status "pending"))))
           (result (js-object :scope "target-schedule" :verification "unverified" :status "completed"
                     :hasFailure false :targets entries)))
      (compilerCorpusRuntimeAcceptance nil options)
      (unless (or (undefined? parallel) (= parallel false) (= parallel t))
        (type-fail "parallelTargets must be a boolean"))
      (if (= parallel t)
        ;; Each entry catches and records its own failure, so every started
        ;; cell finishes and persists evidence before final acceptance throws.
        (await (Promise/all (js-call entries :map (lambda (entry)
          (run-target-entry options run-cell result entry)))))
        (let ((index 0))
          (while (< index 3)
            (await (run-target-entry options run-cell result (aref entries index)))
            (setq index (1+ index))))) result))

  (defasync runStage3Targets (input)
    (object-options input)
    (compilerCorpusRuntimeAcceptance nil input)
    (js-call (js-array "host" "target" "producer" "producers" "compilerArtifact" "runCell" "execute" "compare" "corpusRecords"
              "originalOracle" "programCache" "seedOracleCache" "parallelTargets")
      :forEach (lambda (key) (when (Object/hasOwn input key)
        (type-fail (+ "final stage3 acceptance does not accept " key)))))
    (let* ((options (snapshot input))
           (output (required-path (get options :outputRoot) "outputRoot"))
           (source-root (if (undefined? (get options :sourceRoot)) root (resolve (get options :sourceRoot))))
           (authentication (await (authenticateStage3Targets options)))
           (corpus (await (loadCompilerMatrixCorpus (js-object :sourceRoot source-root :recordsPath (get options :corpusRecordsPath)))))
           (sources (await (loadCompilerSources (js-object :sourceRoot source-root))))
           (source-identity (compilerSourceIdentity sources))
           (frozen-path (resolve output "corpus" "records.json"))
           (summary-path (resolve output "stage3-targets.json")))
      (identical source-identity (get authentication :sourceIdentity) "current formal source identity")
      (await (mkdir (dirname frozen-path) (js-object :recursive t)))
      (await (writeFile frozen-path (get corpus :recordsBytes)))
      (let* ((summary (js-object :format "eliscript-stage3-targets" :version 1 :scope "javascript-stage3-output-targets"
               :status "running" :verification "unverified" :bootstrapManifestPath (get authentication :bootstrapManifestPath)
               :stage3MetadataPath (get authentication :stage3MetadataPath) :sourceIdentity source-identity
               :producerIdentity (get authentication :productIdentity) :corpusIdentity (get corpus :identity)
               :corpusRecordsSha256 (get corpus :recordsSha256) :corpusRecordsPath (relative output frozen-path)
               :completeIds (js-call (get corpus :records) :map (lambda (record) (get record :id)))
               :targetSelections (js-call targets :map (lambda (target) (classifyStage3Corpus (get corpus :records) target
                 (Object/assign (js-object) options (js-object :sourceAssets (get (get corpus :document) :evidence))))))
               :semanticComparison "each effective record uses the original independent Seed oracle and exact comparison"
               :functionalRuntimeProfile (get options :functionalRuntimeProfile) :resourceAcceptance "not-evaluated"
               :targets (js-array)))
             ;; Each complete binary-output cell can retain a large compiler
             ;; and managed heap. Keep final acceptance sequential; the
             ;; uncertified parallel seam remains available to its unit tests.
             (schedule-options (js-object :parallelTargets false :stage3MetadataPath (get authentication :stage3MetadataPath)
               :bootstrapManifestPath (get authentication :bootstrapManifestPath)
               :corpusRecordsPath frozen-path :outputRoot output :sourceRoot source-root
               :programCache (new globalThis.Map)
               :nativeTarget (get options :nativeTarget) :signal (get options :signal)
               :functionalRuntimeProfile (get options :functionalRuntimeProfile)
               :sessionOptions (get options :sessionOptions) :onStage (get options :onStage))))
        (await (saveCompilerMetadata summary-path summary))
        ;; The frozen corpus is checked before every target. Each cell keeps
        ;; its complete original source/IR/map/diagnostic/Seed-oracle records.
        (let ((result (await (run-stage3-target-schedule schedule-options (async (call)
                (unless (= (compilerDigest (await (readFile frozen-path))) (get corpus :recordsSha256))
                  (fail "frozen stage3 corpus changed before target execution"))
                (await (runStage3CompilerTargetCell call)))))))
          (put summary :targets (get result :targets))
          (when (js-call (get result :targets) :some (lambda (entry) (> (get entry :resourceDeferredCount 0) 0)))
            (put summary :fullCorpusVerification "unverified")
            (put summary :verificationScope "effective-corpus")
            (put summary :resourceDeferred (js-call (get result :targets) :map
              (lambda (entry) (js-object :target (get entry :target)
                :records (get entry :resourceDeferred (js-array)) :count (get entry :resourceDeferredCount 0))))))
          (put summary :resourceAcceptance (if (js-call (get result :targets) :some
            (lambda (entry) (= (get entry :resourceAcceptance) "deferred"))) "deferred" "not-overridden"))
          (put summary :status (if (= (get result :status) "completed") "passed-effective-scope" (get result :status)))
          (when (get result :hasFailure) (put summary :failure (compilerFailure (get result :failure))))
          (try
            (identical (await (authenticateStage3Targets options)) authentication "final stage3 identity")
            (identical (compilerSourceIdentity (await (loadCompilerSources (js-object :sourceRoot source-root)))) source-identity "final source identity")
            (unless (= (compilerDigest (await (readFile frozen-path))) (get corpus :recordsSha256))
              (fail "frozen stage3 corpus changed during target execution"))
            (when (= (get result :status) "completed") (put summary :verification "equivalent"))
            (catch error
              (unless (get result :hasFailure) (put result :hasFailure t) (put result :failure error))
              (put summary :status "failed") (put summary :verification "unverified")
              (put summary :failure (compilerFailure (get result :failure)))))
          (put summary :functionalVerification (if (= (get summary :verification) "equivalent") "passed" "unverified"))
          (await (saveCompilerMetadata summary-path summary))
          (when (get result :hasFailure) (throw (get result :failure)))
          summary-path))))

  (export authenticateStage3Targets runStage3Targets run-stage3-target-schedule))
