          (let* ((size (1+ (% (funcall next) 96))) (pieces (js-array)) (at 0))
            (while (< at size) (js-call pieces :push (globalThis.String (% (funcall next) 10))) (setq at (1+ at)))
            (let* ((digits (js-call pieces :join "")) (point (% (funcall next) (1+ (js-length digits))))
                   (input (str (if (/= (bit-and (funcall next) 1) 0) "-" "") (js-call digits :slice 0 point) "."
                               (js-call digits :slice point) "e" (- (% (funcall next) 1201) 600))))
              (check-named fixture "random decimal grammar" "parse" (js-array input)))
            (let* ((radix (aref (js-array 2 8 16) (% (funcall next) 3)))
                   (prefix (cond ((= radix 2) "0b") ((= radix 8) "0o") (t "0x")))
                   (size (1+ (% (funcall next) 128))) (pieces (js-array)) (at 0))
              (while (< at size)
                (js-call pieces :push (js-call (% (funcall next) radix) :toString radix)) (setq at (1+ at)))
              (let ((text (str prefix (js-call pieces :join ""))))
                (funcall assert (Object/is (js-call module :parse text) (globalThis.Number (globalThis.BigInt text))))
                (increment-observations fixture))))
          (setq index (1+ index))))
      (each (js-array nil false t undefined "" "中😀\ud800" globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                     -0 globalThis.Number.MIN_VALUE globalThis.Number.MAX_VALUE 1e-7 1e-6 1e20 1e21 .1 .5 1000000000000000100
                     (- (Math/pow 2 53) 1) (Math/pow 2 53) (+ (Math/pow 2 53) 2))
        (lambda (input) (check-named fixture "shortest text" "text" (js-array input))))
      (let ((next (model-call model "random" 2672016241)) (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))) (index 0))
        (while (< index 2048)
          (js-call bits :setUint32 0 (funcall next) t) (js-call bits :setUint32 4 (funcall next) t)
          (js-call fixture :compare "random binary64 text" (lambda (target) (js-call target :text (js-call bits :getFloat64 0 t))))
          (setq index (1+ index))))
      (each (js-array .5 -.5 1e-7 1e-6 1e20 1e21 globalThis.Number.MIN_VALUE globalThis.Number.MAX_VALUE
                     globalThis.NaN globalThis.Infinity (- globalThis.Infinity) -0)
        (lambda (input) (check-named fixture "numeric property key" "named-key" (js-array input))))
      (each (js-array "" "1" "-1" "1.9" "-1.9" "0x2" "0b10" (str whitespace "2" whitespace) "NaN" "Infinity" "-Infinity" "invalid" "5e-324")
        (lambda (input) (check-named fixture "position conversion" "position" (js-array input))))
      (check-named fixture "str argument snapshot" "join" (js-array "first" -0))))

  (defun json (fixture model)
    (each (get model :valid) (lambda (text) (check-named fixture "JSON grammar canonical form" "canonical-value" (js-array text))))
    (each (get model :invalid) (lambda (text)
      (js-call fixture :compare "invalid JSON and effects" (lambda (module)
        (let* ((trace (js-object)) (error (outcome-name fixture (lambda () (js-call module :parse_extra text trace))))) (js-array error trace))))))
    (js-call fixture :compare "JSON omission and sparse arrays" (lambda (module)
      (let ((b (js-array undefined globalThis.NaN "中😀\ud800\0\n\"\\" -0)))
        (put b :length 6)
        (let ((value (js-object "2" "中😀\ud800\0\n\"\\" :b b :a undefined :nan globalThis.NaN :zero -0)))
          (js-array (js-call module :stringify_value value) (js-call module :pretty_value value 2)
            (js-call module :select_value value (js-array "b" "nan" "b") "😀abcdefghijk")
            (js-call module :stringify_value undefined) (js-call module :same_parser))))))
    (each (js-array "-0" "-1e-9999" "5e-324" "2.2250738585072014e-308" "1.7976931348623157e308" "1e9999" "9007199254740993")
      (lambda (text) (check-named fixture "JSON number exactness" "parse-value" (js-array text))))
    (each (js-array "" "x" "\ud800" "123456789😀" "😀abcdefghijk" -0 (- globalThis.Infinity) globalThis.Infinity globalThis.NaN -2 1.9 12)
      (lambda (space) (check-named fixture "JSON indentation" "pretty-value" (js-array (js-object :a 1) space))))
    (let ((seed 1762688499) (strings (js-array "" "中😀" "\ud800" "\udc00" "\0\b\n" "\"\\/\u2028" "__proto__")) (index 0))
      (letfn ((next () (setq seed (unsigned-bit-shift-right (+ (Math/imul seed 1664525) 1013904223) 0)))
              (value (depth)
                (let ((choice (% (next) (if (/= depth 0) 7 5))))
                  (cond ((= choice 0) nil) ((= choice 1) (/= (bit-and (next) 1) 0))
                    ((= choice 2) (aref strings (% (next) (js-length strings))))
                    ((< choice 5) (* (- (next) 2147483648) (Math/pow 10 (- (% (next) 601) 300))))
                    ((= choice 5)
                      (let ((count (% (next) 4)) (items (js-array)) (at 0))
                        (while (< at count) (js-call items :push (value (1- depth))) (setq at (1+ at))) items))
                    (t (let ((entries (js-array)) (count (% (next) 4)))
                         (while (> count 0)
                           (js-call entries :push (js-array (aref (js-array "a" "2" "1" "__proto__" "") (% (next) 5)) (value (1- depth))))
                           (setq count (1- count))) (Object/fromEntries entries)))))))
        (while (< index 256)
          (let ((text (JSON/stringify (value 4))))
            (js-call fixture :compare "seeded JSON tree" (lambda (module)
              (js-array (js-call module :canonical_value text) (outcome-name fixture (lambda () (js-call module :parse_value (str text "#"))))))))
          (setq index (1+ index)))))
    (js-call fixture :compare "JSON cycles and repeated aliases" (lambda (module)
      (let ((shared (js-object :a 1)) (cycle (js-object)))
        (put cycle :self cycle)
        (js-array (js-call module :stringify_value (js-array shared shared))
          (outcome-name fixture (lambda () (js-call module :stringify_value cycle)))))))
    (js-call fixture :compare "JSON proto own descriptor" (lambda (module)
      (let ((object (js-call module :parse_value "{\"__proto__\":7}")))
        (funcall assert (js-call module :own_value object "__proto__"))
        (js-array (js-call module :key_value object "__proto__") (Object/keys object))))))

  (defun primitive (fixture model)
    (let ((inputs (js-array nil false t undefined 0 -0 1 -1 globalThis.NaN globalThis.Infinity globalThis.Number.MIN_VALUE .5
                           "" "0" "-0" "1.5" " 0x10 " "0b101" "0o77" "invalid" "中😀\ud800")) (hex (get model :hex)))
      (each inputs (lambda (x)
        (check-names fixture (js-array "negate" "reciprocal" "increment" "decrement" "signed" "unsigned" "invert" "identity-add" "identity-multiply") (js-array x))
        (each inputs (lambda (y)
          (check-names fixture (js-array "add" "subtract" "multiply" "divide" "remainder" "mask" "union" "exclusive" "shift-left"
             "shift-right" "logical-right" "product-word" "equal" "less" "less-equal" "greater" "greater-equal") (js-array x y))))))
      (each (js-array (js-array "1" 2 3) (js-array 1 2 "3") (js-array nil false "x") (js-array "invalid" 1 2)
                     (js-array "10" "2" 3) (js-array -0 "0" nil) (js-array undefined 1 "x"))
        (lambda (values)
          (check-names fixture (js-array "ordered-add" "ordered-subtract" "comparison-snapshot") values)
          (check-names fixture (js-array "snapshot" "comparison-effects") (js-call values :slice 0 2))))
      (each (js-array "identity-add" "identity-multiply") (lambda (name)
        (js-call fixture :compare "opaque identity" (lambda (module)
          (let ((object (js-object))) (eq (js-call fixture :named module name object) object))))))
      (each (js-array "subtract" "multiply" "divide" "remainder" "less" "less-equal" "greater" "greater-equal") (lambda (name)
        (let ((value (globalThis.Number (globalThis.BigInt hex))))
          (funcall assert (Object/is (js-call fixture :named (get fixture :m) name hex value)
            (Reflect/apply (get (get model :expected) name) (get model :expected) (js-array hex value))))
          (increment-observations fixture))))
      (let ((random (random-bits 1470339873)) (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))) (index 0))
        (while (< index 512)
          (js-call bits :setUint32 0 (js-call random :next) t) (js-call bits :setUint32 4 (js-call random :next) t)
          (let* ((value (js-call bits :getFloat64 0 t)) (text (globalThis.String value)))
            (check-names fixture (js-array "add" "subtract" "multiply" "remainder" "less" "greater-equal") (js-array text value)))
          (setq index (1+ index))))
      (each (js-array 0 1 3 -0 globalThis.NaN -1 2.5 "3") (lambda (n)
        (each (js-array -0 globalThis.NaN globalThis.Infinity .123 "0.123" hex) (lambda (seed)
          (check-named fixture "closed scalar loop" "scalar-loop" (js-array n seed))))))
      (js-call fixture :compare "source hooks and bigint" (lambda (module)
        (let* ((trace (js-array)) (left (js-object :valueOf (lambda () (js-call trace :push "left") 5)))
               (right (js-object :valueOf (lambda () (js-call trace :push "right") 2))))
          (js-array (js-call module :subtract left right) trace (js-call module :subtract (js* "5n") (js* "2n"))
            (js-call module :negate (js* "5n")) (js-call module :shift_left (js* "5n") (js* "2n"))
            (outcome-name fixture (lambda () (js-call module :subtract (js* "5n") 2)))
            (outcome-name fixture (lambda () (js-call module :product_word (js* "5n") (js* "2n"))))))))))

