(module tools.backends.compiler-corpus-fixture-scenarios
  (import "node:assert/strict" :default assert)
  ;; These loops operate on the declared dense scenario lists. Sparse arrays
  ;; inside those lists remain untouched and reach the actual source exports.
  (defun each (items visit)
    (let ((index 0))
      (while (< index (js-length items))
        (funcall visit (aref items index))
        (setq index (1+ index)))))
  (defun check-named (fixture label name arguments)
    (js-call fixture :compare label
      (lambda (module)
        (Reflect/apply (get module (js-call name :replaceAll "-" "_")) module arguments))))
  (defun check-names (fixture names arguments)
    (each names (lambda (name) (check-named fixture name name arguments))))
  (defun random-bits (seed)
    (let ((state seed) (view (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (letfn ((next ()
                (setq state (bit-xor state (bit-shift-left state 13)))
                (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                (setq state (bit-xor state (bit-shift-left state 5)))
                (unsigned-bit-shift-right state 0))
              (random ()
                (js-call view :setUint32 0 (next) t)
                (js-call view :setUint32 4 (next) t)
                (js-call view :getFloat64 0 t)))
        (js-object :next next :random random))))

  (defun arithmetic (fixture)
    (let ((numbers (js-array 0 -0 1 -1 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                     globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) globalThis.Number.MAX_VALUE
                     (Math/pow 2 53) 1e16 .1 -.25)))
      (each numbers (lambda (x)
        (check-names fixture (js-array "negate" "reciprocal" "increment" "decrement" "unary-add" "unary-multiply") (js-array x))
        (each numbers (lambda (y)
          (check-names fixture (js-array "add" "subtract" "multiply" "divide" "equal" "distinct" "not-equal"
                                   "less" "less-equal" "greater" "greater-equal" "snapshot") (js-array x y))))))
      (check-names fixture (js-array "zero" "one") (js-array))
      (each (js-array undefined nil false t "" " " "x" "-0" "0x10" "中\ud800")
        (lambda (x) (check-names fixture (js-array "increment" "decrement") (js-array x))))
      (each (js-array (js-array 1 1e16 -1e16) (js-array 1e16 -1e16 1)
              (js-array globalThis.Number.MAX_VALUE 2 .5) (js-array -0 0 -0)
              (js-array globalThis.NaN 1 2) (js-array 1 globalThis.NaN 2)
              (js-array 1 1 2) (js-array 1 2 1) (js-array 3 2 1) (js-array 0 1 1)
              (js-array globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE))
        (lambda (arguments)
          (check-names fixture (js-array "ordered-sum" "ordered-product" "ordered-subtract" "ordered-divide"
                                   "equal-three" "distinct-three" "less-three" "compare-snapshot") arguments)))
      (each (js-array (js-array 2 1) (js-array globalThis.NaN globalThis.NaN))
        (lambda (pair) (check-named fixture "comparison effects" "comparison-effects" pair)))
      (let ((values (js-call (js-array nil false t undefined) :concat numbers (js-array "" "x" "中😀\ud800"))))
        (each values (lambda (left) (each values (lambda (right)
          (check-names fixture (js-array "equal" "identical" "distinct" "not-equal") (js-array left right)))))))
      (each (js-array (js-array (js-object) (js-object)) (js-array (js-array) (js-array))
                     (js-array (js-object) (js-array)))
        (lambda (pair)
          (each (js-array "equal" "identical" "distinct") (lambda (name)
            (js-call fixture :compare (str "opaque " name)
              (lambda (module)
                (js-array (js-call fixture :named module name (aref pair 0) (aref pair 0))
                          (js-call fixture :named module name (aref pair 0) (aref pair 1)))))))))
      (let ((strings (js-array "" "a" "aa" "\0" "中" "😀" "\ud800" "\udfff" "\ud800x")))
        (each strings (lambda (left) (each strings (lambda (right)
          (check-names fixture (js-array "less" "less-equal" "greater" "greater-equal") (js-array left right)))))))
      (each (js-array "sum-to" "recursive-sum") (lambda (name)
        (each (js-array 0 1 8 32) (lambda (n) (check-named fixture name name (js-array n))))))
      (let ((index 0))
        (while (< index 100)
          (check-named fixture "repeated numeric loop" "sum-to" (js-array 32))
          (setq index (1+ index))))
      (let ((random (random-bits 102997105)) (index 0))
        (while (< index 512)
          (let ((pair (js-array (js-call random :random) (js-call random :random))))
            (check-names fixture (js-array "add" "subtract" "multiply" "divide" "equal" "distinct"
                                     "less" "less-equal" "greater" "greater-equal") pair))
          (setq index (1+ index))))))

  (defun word (fixture)
    (let ((numbers (js-array 0 -0 1 -1 .1 -.1 3.5 -3.5 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                     globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) globalThis.Number.MAX_VALUE
                     (- globalThis.Number.MAX_VALUE) (- (Math/pow 2 31) 1) (Math/pow 2 31)
                     (- (Math/pow 2 32) 1) (+ (Math/pow 2 32) 1) (- (- (Math/pow 2 32)) 1)
                     (+ (Math/pow 2 52) 1) (- (Math/pow 2 53) 1) (+ (Math/pow 2 53) 2)
                     (Math/pow 2 83) (Math/pow 2 84))))
      (each numbers (lambda (x)
        (check-names fixture (js-array "signed" "unsigned" "invert") (js-array x))
        (each numbers (lambda (y)
          (check-names fixture (js-array "remainder" "modulo" "mask" "union" "exclusive" "shift-left"
                                   "shift-right" "logical-right" "multiply" "snapshot" "remainder-snapshot") (js-array x y))))))
      (each (js-array (js-array 1 .1) (js-array 1e16 3) (js-array globalThis.Number.MAX_VALUE 3)
              (js-array globalThis.Number.MAX_VALUE globalThis.Number.MIN_VALUE)
              (js-array (* globalThis.Number.MIN_VALUE 3) (* globalThis.Number.MIN_VALUE 2))
              (js-array 1 (* globalThis.Number.MIN_VALUE 3)) (js-array -4 2) (js-array -0 3)
              (js-array 3 -0) (js-array 1 globalThis.Infinity) (js-array globalThis.Infinity 1))
        (lambda (pair) (check-named fixture "subnormal remainder" "remainder" pair)))
      (each (js-array (js-array 17 5 2) (js-array -17 5 2) (js-array globalThis.Number.MAX_VALUE 3 .1)
                     (js-array globalThis.NaN 1 2) (js-array 17 0 2))
        (lambda (triple) (check-named fixture "remainder-many" "remainder-many" triple)))
      (let ((exponent -1074))
        (while (<= exponent 1023)
          (each (js-array (Math/pow 2 exponent) (- (Math/pow 2 exponent))) (lambda (x)
            (check-names fixture (js-array "signed" "unsigned" "invert") (js-array x))))
          (setq exponent (1+ exponent)))
        (setq exponent 0)
        (while (< exponent 85)
          (each (js-array (+ (Math/pow 2 exponent) 1) (+ (Math/pow 2 exponent) .5)
                         (- (+ (Math/pow 2 exponent) 1)) (- (+ (Math/pow 2 exponent) .5)))
            (lambda (x) (check-names fixture (js-array "signed" "unsigned") (js-array x))))
          (setq exponent (1+ exponent))))
      (each (js-array -1 -2 (Math/pow 2 31) (- (Math/pow 2 32) 1) 2147483647 2147483649 4294967293)
        (lambda (x)
          (each (js-array -65 -33 -32 -31 -1 0 1 20 31 32 33 63 64 65 (+ (Math/pow 2 32) 1) globalThis.NaN globalThis.Infinity)
            (lambda (count)
              (check-names fixture (js-array "shift-left" "shift-right" "logical-right") (js-array x count))))))
      (each (js-array (js-array 4294967295 4294967295) (js-array 4294967295 4294967293)
                     (js-array 2147483649 2147483649) (js-array 2147483647 2147483647))
        (lambda (pair) (check-named fixture "multiply" "multiply" pair)))
      (let ((random (random-bits 82220343)) (index 0))
        (while (< index 2048)
          (let ((x (js-call random :random)) (y (js-call random :random)))
            (each (js-array "remainder" "signed" "unsigned" "mask" "exclusive" "multiply" "logical-right")
              (lambda (name) (check-named fixture name name
                (if (or (= name "signed") (= name "unsigned")) (js-array x) (js-array x y)))))
            (check-named fixture "integer imul" "multiply" (js-array (js-call random :next) (js-call random :next))))
          (setq index (1+ index))))
      (each (js-array 0 -0 globalThis.NaN globalThis.Infinity globalThis.Number.MAX_VALUE 2147483649)
        (lambda (seed) (check-named fixture "loop-mix" "loop-mix" (js-array 128 seed))))
      (let ((x 0))
        (while (< x 64)
          (let ((y 1))
            (while (< y 32)
              (each (js-array 1 -1) (lambda (sign)
                (check-named fixture "exhaustive subnormal remainder" "remainder"
                  (js-array (* sign x globalThis.Number.MIN_VALUE) (* y globalThis.Number.MIN_VALUE)))))
              (setq y (1+ y))))
          (setq x (1+ x))))))
  (defun callbacks (fixture)
    (let* ((methods (js-array "map" "filter" "for-each" "some" "every" "find" "find-index" "find-last" "find-last-index"))
           (sparse (new globalThis.Array 6)))
      (put sparse 1 false) (put sparse 3 3) (put sparse 5 undefined)
      (each (js-array (js-array 0 -0 globalThis.NaN "" nil undefined false globalThis.Number.MIN_VALUE "中😀" t globalThis.Infinity) sparse)
        (lambda (values) (each methods (lambda (name)
          (js-call fixture :compare name (lambda (module)
            (js-call fixture :named module (str name "-with") (js-call values :slice) (js-call module :identity))))))))
      (each methods (lambda (name)
        (js-call fixture :compare (str "arguments " name) (lambda (module)
          (let ((values (js-array false t false)) (log (js-array)))
            (js-call fixture :named module (str name "-with") values (js-call module :collect_arguments log))
            (js-call log :map (lambda (arguments)
              (js-array (aref arguments 0) (aref arguments 1) (eq (aref arguments 2) values) (js-length arguments)))))))))
      (each (js-array (js-array) (js-array undefined) (js-array 1) (js-array 1 2 3) (js-array -0)
                     (js-array -0 globalThis.Number.MIN_VALUE globalThis.Infinity) (new globalThis.Array 5))
        (lambda (values)
          (each (js-array "reduce" "reduce-right") (lambda (name)
            (js-call fixture :compare name (lambda (module)
              (js-array
                (js-call fixture :outcome (lambda ()
                  (js-call fixture :named module (str name "-with") (js-call values :slice) (js-call module :sum_callback))))
                (js-call fixture :named module (if (= name "reduce") "reduce-initial" "reduce-right-initial")
                  (js-call values :slice) (js-call module :sum_callback) -0))))))))
      (each (js-array "reduce-initial" "reduce-right-initial") (lambda (name)
        (js-call fixture :compare name (lambda (module)
          (let* ((values (js-array 1 2 3)) (log (js-array))
                 (out (js-call fixture :named module name values (js-call module :ordered_callback log) 0)))
            (js-array out (js-call log :map (lambda (row)
              (js-array (aref row 0) (aref row 1) (eq (aref row 2) values))))))))))
      (each methods (lambda (name)
        (js-call fixture :compare (str "live " name) (lambda (module)
          (let* ((values (js-array 1 2 3 4))
                 (out (js-call fixture :named module (str name "-with") values (js-call module :mutation_callback values))))
            (js-array out values))))))
      (js-call fixture :compare "capture order" (lambda (module)
        (let* ((values (js-array 1 2)) (other (js-array 8)) (marker (js-array false))
               (out (js-call module :evaluation_order values other marker))) (js-array out marker))))
      (each (js-array nil undefined) (lambda (receiver)
        (js-call fixture :compare "nullish lookup" (lambda (module)
          (let ((marker (js-array false)))
            (js-array (js-call fixture :outcome (lambda () (js-call module :nullish_order receiver marker))) marker))))))
      (js-call fixture :compare "own captured method"
        (lambda (module) (js-call module :map_shadow (js-array 1 2) (js-call module :shadow_value))))
      (js-call fixture :compare "replaced builtin" (lambda (module)
        (let* ((values (js-array 1 2)) (first (js-call module :map_replaced values (js-call module :identity))))
          (js-array first (js-call fixture :outcome (lambda () (js-call module :map_with values (js-call module :identity))))))))
      (js-call fixture :compare "reentrant map"
        (lambda (module) (js-call module :map_recursive (js-array 0 1 2 -0 globalThis.Number.MIN_VALUE))))
      (each (js-call methods :concat (js-array "reduce" "reduce-right")) (lambda (name)
        (each (js-array nil undefined false t) (lambda (bad)
          (js-call fixture :compare (str "invalid " name) (lambda (module)
            (js-call fixture :outcome (lambda () (js-call fixture :named module (str name "-with") (js-array) bad)))))))))
      (js-call fixture :compare "first error" (lambda (module)
        (let ((marker (js-array false)))
          (js-array (js-call fixture :outcome (lambda () (js-call module :first_error (js-array 1 2) marker))) marker))))
      (js-call fixture :compare "stable sort" (lambda (module) (js-call module :sort_stable)))
      (let ((sparse-sort (new globalThis.Array 4)))
        (put sparse-sort 0 undefined) (put sparse-sort 2 3) (put sparse-sort 3 1)
        (each (js-array (js-array 3 1 2) (js-array -0 globalThis.NaN 1) (js-array "b" "a") sparse-sort)
          (lambda (values) (each (js-array "sort-default" "sort-copy" "sort-nan-ties") (lambda (name)
            (js-call fixture :compare name (lambda (module)
              (let* ((items (js-call values :slice)) (out (js-call fixture :named module name items)))
                (js-array out (eq out items) items (Object/keys out))))))))))
      (each (js-array false t) (lambda (reverse)
        (js-call fixture :compare "numeric sort" (lambda (module) (js-call module :sort_numeric (js-array 3 1 2) reverse)))))
      (js-call fixture :compare "sort copy mutation" (lambda (module)
        (let ((items (js-array 3 1 2))) (js-array (js-call module :sort_copy_mutation items) items))))
      (js-call fixture :compare "concat shared children" (lambda (module) (js-call module :concat_summary)))
      (js-call fixture :compare "concat one level" (lambda (module)
        (let* ((nested (js-array 7)) (items (new globalThis.Array 3)))
          (put items 1 undefined) (put items 2 nested)
          (let ((out (js-call module :concat_copy items items)))
            (js-call assert :equal (aref out 2) (aref out 5))
            (put nested 0 9)
            (js-array out (Object/keys out) (eq out items))))))))

  (defun arrays (fixture)
    (each (js-array (js-array undefined nil false) (js-array t -0 globalThis.NaN)
                   (js-array "中😀" globalThis.Number.MIN_VALUE globalThis.Infinity))
      (lambda (values)
        (js-call fixture :compare "array construction" (lambda (module)
          (let ((out (Reflect/apply (get module :make) module values)))
            (js-array out (js-call module :size out) (js-call module :nth_value 1 out)
              (js-call module :at out 2) (js-call module :get_value out "missing" 7)))))))
    (js-call fixture :compare "array identity and copy" (lambda (module)
      (let ((a (js-call module :empty)))
        (js-call assert :equal (js-call module :write a 1 undefined) undefined)
        (js-call module :write a 3 "last")
        (let ((b (js-call module :copy a)))
          (js-call assert :notEqual a b)
          (js-array a b (js-call module :keys a) (js-call module :keys b)
            (js-call module :has a 0) (js-call module :has a 1) (js-call module :has a "length"))))))
    (each (js-array (js-array "1" "5") (js-array "0x2" "Infinity") (js-array "-2" undefined)
             (js-array "not-number" "4") (js-array t false) (js-array nil "3.5")
             (js-array "0xbcf8f9bdba22840724d028768a8a77b3e6b0f283670085477910eccc4e9d6b278a11db79c280d4e9c237774812029ac7ce82daaafca38" undefined))
      (lambda (pair)
        (js-call fixture :compare "primitive slice" (lambda (module)
          (let ((items (new globalThis.Array 6)))
            (put items 0 t) (put items 2 undefined) (put items 3 false) (put items 5 t)
            (let ((out (js-call module :interval items (aref pair 0) (aref pair 1))))
              (js-array out (Object/keys out))))))))
    (js-call fixture :compare "mutations" (lambda (module)
      (let* ((a (js-array)) (out (js-array (js-call module :append a 1 2) (js-call module :append_none a)
                                  (js-call module :remove_last a) (js-call module :truncate a 5))))
        (js-call out :push (js-call a :slice) (js-call module :keys a)) out)))
    (js-call fixture :compare "self cycle" (lambda (module)
      (let ((out (js-call module :nested 1 2)))
        (js-call assert :equal (aref out 0) out) (js-array (aref out 1) (js-length out)))))
    (js-call fixture :compare "operand order" (lambda (module)
      (let ((a (js-array 1 2 3)) (b (js-array 8)) (marker (js-array false)))
        (js-array (js-call module :key_order a) (js-call module :fallback_order a)
          (js-call module :append_order a b) a b (js-call module :pop_extra a marker) marker
          (js-call module :slice_extra a 0 2 marker) (js-call module :write_order a b) (eq (aref a 0) b)))))
    (each (js-array 0 1 8 32 128) (lambda (n) (check-named fixture "grow loop" "grow-loop" (js-array n))))
    (each (js-array nil undefined) (lambda (receiver)
      (js-call fixture :compare "nullish write" (lambda (module)
        (let ((marker (js-array false)))
          (js-array (js-call fixture :outcome (lambda () (js-call module :null_write receiver marker))) marker))))))
    (js-call fixture :compare "named properties and assoc" (lambda (module)
      (let ((a (js-array)))
        (each (js-array "tag" "2" "01" "1" "__proto__") (lambda (key)
          (js-call module :write a key (if (= key "__proto__") nil key))))
        (let ((b (js-call module :assoc a "other" 7)))
          (js-array (js-call module :keys a) (js-call module :keys b) (js-call module :at a "tag")
            (js-call module :has a "other") (js-call module :at b "other"))))))
    (each (js-array "append-shadow" "pop-shadow" "slice-shadow") (lambda (name)
      (js-call fixture :compare name (lambda (module)
        (let ((a (js-array 1 2)) (marker (js-array false)) (method (aref (js-call name :split "-") 0)))
          (put a (if (= method "append") "push" method) false)
          (js-array (js-call fixture :outcome (lambda () (js-call fixture :named module name a marker))) marker))))))
    (js-call fixture :compare "captured push" (lambda (module)
      (let ((a (js-array))) (js-array (js-call module :append_replace a) a (get a :push))))))

  (defun outcome-name (fixture action)
    (let ((error (get (js-call fixture :outcome action) :error)))
      (if (nullish? error) undefined (get error :name))))

  (defun emptyBindings (fixture)
    (each (js-array undefined nil false t -0 globalThis.NaN globalThis.Infinity globalThis.Number.MIN_VALUE "中😀\ud800")
      (lambda (value) (check-names fixture (js-array "parallel-value" "sequential-value" "capture-value") (js-array value))))
    (check-named fixture "nil default" "default-value" (js-array))
    (each (js-array 0 1 8 32) (lambda (n) (check-named fixture "binding loop" "loop-value" (js-array n))))
    (js-call fixture :compare "escaped cells" (lambda (module)
      (let ((a (js-call module :escape_value)) (b (js-call module :escape_value)))
        (js-array (funcall a nil) (funcall a -0) (funcall a nil) (funcall b nil)
          (funcall a globalThis.NaN) (funcall a nil) (funcall b 7) (funcall b nil)))))
    (js-call fixture :compare "initializer effects" (lambda (module)
      (let ((trace (js-object))) (js-array (js-call module :effect_value trace) trace)))))

  (defun control (fixture)
    (let ((values (js-array nil false t undefined 0 -0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                           globalThis.Number.MIN_VALUE 42.5 "" "中😀\ud800" (js-object) (js-array))))
      (each values (lambda (value)
        (check-names fixture (js-array "identity" "truth" "invert" "once" "optional-result" "unless-result" "recurse") (js-array value))))
      (each values (lambda (a) (each values (lambda (b)
        (check-names fixture (js-array "both" "either" "parallel" "sequential" "effects" "clauses" "call-choose") (js-array a b))))))
      (each values (lambda (condition) (check-named fixture "choose" "choose" (js-array condition -0 "no"))))
      (check-names fixture (js-array "unicode" "negative-zero" "finite-number" "undefined-result" "empty-and" "empty-or") (js-array))))

  (defun exceptions (fixture)
    (each (js-array undefined nil false t -0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                   globalThis.Number.MIN_VALUE "中😀\ud800" (js-object) (js-array))
      (lambda (value)
        (js-call fixture :compare "source throw identity" (lambda (module)
          (js-call assert :equal (js-call module :caught value) value)
          (js-call assert :equal (js-call module :indirect value) value)
          (js-call assert :equal (js-call module :across 24 value) value)
          (js-call assert :equal (js-call module :call_handler (js-call module :handler_closure value)) value)
          (let ((trace (js-array)))
            (js-call assert :equal (js-call module :normal value trace) value)
            (let ((nested (js-array)))
              (js-call assert :equal (js-call module :nested value nested) value)
              (let ((shadow (js-call module :shadow value)))
                (js-call assert :equal (aref shadow 0) value)
                (js-array trace nested (aref shadow 1)))))))))
    (js-call fixture :compare "finally replacement" (lambda (module)
      (let ((first (js-object)) (second (js-object)) (trace (js-array)) (out undefined))
        (try (js-call module :replaced first second trace)
          (catch error (js-call assert :equal error second) (setq out t)))
        (js-call assert :equal (aref trace 0) first)
        (js-array out (js-call trace :slice 1) (eq (js-call module :handler_throw first second) second)))))
    (let ((kind 0))
      (while (< kind 4)
        (each (js-array undefined "" "中😀\ud800") (lambda (message)
          (js-call fixture :compare "Error constructors" (lambda (module)
            (let* ((marker (js-object)) (error (js-call module :make_error kind message (js-object :cause marker))))
              (js-call assert :equal (get error :cause) marker)
              (js-array (js-call module :error_summary error) (Object/keys error)
                (funcall (js* "(value, constructor) => value instanceof constructor") error
                  (aref (js-array globalThis.Error globalThis.TypeError globalThis.RangeError globalThis.SyntaxError) kind))))))))
        (setq kind (1+ kind)))))

  (defun moduleBindings (fixture)
    (js-call fixture :compare "initializers and live exports" (lambda (module)
      (funcall assert (Object/is (get module :negative_zero) -0))
      (js-call assert :equal (get (get module :state) :self) (get module :state))
      (js-call assert :equal (js-call module :read_state) (get module :state))
      (js-call assert :equal (js-call module :identity_value) (get module :identity))
      (let ((out (js-array (js-call (get module :initialization_log) :slice) (get module :first) (get module :second)
                          (get module :counter) (get module :unset) (get module :missing))) (index 0))
        (while (< index 8) (js-call out :push (js-call module :tick)) (setq index (1+ index)))
        (js-call module :write_counter 9)
        (js-call out :push (get module :counter) (js-call module :read_counter)
          (js-call module :local_counter 3) (js-call module :emitted_alias 99))
        (let ((closure (js-call module :captured_global)))
          (js-call out :push (funcall closure 2) (funcall closure 3) (js-call module :read_counter)))
        (setq index 0)
        (while (< index 96) (js-call module :allocate) (setq index (1+ index)))
        (js-call assert :equal (js-call module :read_state) (get module :state))
        (js-call out :push (js-call (get (get module :state) :values) :slice) (get (get module :state) :label)) out)))
    (js-call fixture :compare "dynamic export reassignment" (lambda (module)
      (let ((first (get module :current)) (initial (js-call module :call_current -0 globalThis.NaN t)))
        (js-call module :set_current (get module :identity))
