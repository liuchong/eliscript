(module tools.backends.native-memory
  (import "node:buffer" Buffer)
  (import "node:crypto" createHash)
  (import "node:fs" closeSync copyFileSync existsSync fstatSync mkdirSync openSync readSync renameSync rmSync)
  (import "node:module" createRequire)
  (import "node:os" tmpdir)
  (import "node:path" :as node-path)
  (import "./compiler-debug.mjs" createCompilerDebugMap)
  (import "./native-node-ffi.mjs" openNodeInProcessFFI)
  (import "./native-node-memory.mjs" openNodeNativeMemory)

  (defconst default-libc-cache (new globalThis.WeakMap))
  (defconst callback-pool-cache (new globalThis.WeakMap))
  (defconst library-pool-cache (new globalThis.WeakMap))
  (defconst owned-invoker-tables (new globalThis.WeakMap))
  (defun nativeMemoryInvokers (owned)
    (js-call owned-invoker-tables :get owned))
  (defconst max-cached-library-bytes 67108864)
  (defconst library-hash-chunk-bytes 65536)
  (defconst U64_ZERO (funcall globalThis.BigInt 0))
  (defconst U64_MAX (funcall globalThis.BigInt "18446744073709551615"))

  (defun bun-gc-sweep ()
    (let ((bun globalThis.Bun))
      (when (and (not (nullish? bun)) (= (value-type bun) "object") (= (value-type (get bun :gc)) "function"))
        (js-call bun :gc t))))

  (defun memory-truth (value) (globalThis.Boolean value))
  (defun memory-default (value fallback) (if (undefined? value) fallback value))
  (defun memory-copy (source)
    (let ((result (js-object)))
      (unless (nullish? source)
        (js-call (Reflect/ownKeys (globalThis.Object source)) :forEach (lambda (key)
          (let ((descriptor (Object/getOwnPropertyDescriptor source key)))
            (when (get descriptor :enumerable)
              (Object/defineProperty result key (js-object :value (get source key)
                :writable t :enumerable t :configurable t))))))) result))
  (defun nativePlatform (target)
    (let ((actual (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
                       ((= (get globalThis.process :platform) "linux") "arm64-linux") (t nil))))
      (when (or (/= (get globalThis.process :arch) "arm64") (eq actual nil)
                (and (not (undefined? target)) (not (eq target actual))))
        (throw (new globalThis.Error "native memory requires the matching arm64-macos or arm64-linux host"))) actual))

  (defun openDefaultLibc (ffi platform)
    (let ((by-platform (js-call default-libc-cache :get ffi)))
      (unless by-platform
        (setq by-platform (new globalThis.Map))
        (js-call default-libc-cache :set ffi by-platform))
      (let ((cached (js-call by-platform :get platform)))
        (if cached cached
          (let* ((signatures (js-object
                    :mmap (js-object :args (js-array "ptr" "u64" "i32" "i32" "i32" "i64") :returns "ptr")
                    :mprotect (js-object :args (js-array "ptr" "u64" "i32") :returns "i32")
                    :munmap (js-object :args (js-array "ptr" "u64") :returns "i32")
                    :getpagesize (js-object :args (js-array) :returns "i32")))
                 (mac (= platform "arm64-macos"))
                 (names (if mac (js-array "libSystem.B.dylib") (js-array "libc.so.6" "libc.musl-aarch64.so.1")))
                 (libc undefined) (failure undefined) (index 0))
            (bun-gc-sweep)
            (while (and (< index (js-length names)) (not (memory-truth libc)))
              (try (setq libc (js-call ffi :dlopen (aref names index) signatures))
                (catch error (setq failure error)))
              (setq index (1+ index)))
            (unless (memory-truth libc)
              (throw (new globalThis.Error
                (if mac "unable to load macOS virtual memory functions" "unable to load Linux virtual memory functions")
                (js-object :cause failure))))
            (try
              (let ((page (js-call (get libc :symbols) :getpagesize)))
                (unless (and (Number/isSafeInteger page) (> page 0) (= (bit-and page (1- page)) 0))
                  (throw (new globalThis.Error (if mac "invalid macOS memory page size" "invalid Linux memory page size"))))
                (let ((entry (js-object :libc libc :page page)))
                  (js-call by-platform :set platform entry)
                  entry))
              (catch error
                (try (js-call libc :close) (catch ignored nil))
                (throw error))))))))

  (defun acquireHostCallback (ffi handler)
    (let ((pool (js-call callback-pool-cache :get ffi)))
      (unless pool
        (setq pool (js-array))
        (js-call callback-pool-cache :set ffi pool))
      (if (> (js-length pool) 0)
        (let ((slot (js-call pool :pop)))
          (js-call slot :attach handler)
          slot)
        (let* ((active-handler handler)
               (_ (bun-gc-sweep))
               (raw (new (get ffi :JSCallback)
                 (lambda (actualContext index heap argv)
                   (if (eq active-handler nil)
                     (throw (new globalThis.Error "native host callback is outside its active invocation"))
                     (funcall active-handler actualContext index heap argv)))
                 (js-object :args (js-array "ptr" "u32" "u32" "u64") :returns "u64" :threadsafe false))))
          (when (eq (get raw :ptr) nil)
            (try (js-call raw :close) (catch ignored nil))
            (throw (new globalThis.Error "unable to create native host callback")))
          (let ((released false) (slot nil))
            (setq slot (js-object
              :ptr (get raw :ptr)
              :attach (lambda (next-handler) (setq released false active-handler next-handler))
              :close (lambda ()
                (unless released
                  (setq released t active-handler nil)
                  (if (< (js-length pool) 16)
                    (js-call pool :push slot)
                    (js-call raw :close))))))
            slot)))))

  ;; Content identity. Same inode, size and restored mtime can still hide a
  ;; rewrite, so a cached raw library is reused only when this hash matches.
  (defun boundedFileIdentity (file-path)
    (try
      (let ((fd (openSync file-path "r")))
        (try
          (let ((stat (fstatSync fd)))
            (if (or (not (js-call stat :isFile))
                    (not (Number/isSafeInteger (get stat :size)))
                    (< (get stat :size) 0)
                    (> (get stat :size) max-cached-library-bytes))
              nil
              (let ((chunk (Buffer/allocUnsafe library-hash-chunk-bytes))
                    (hash (createHash "sha256"))
                    (total 0)
                    (aborted false)
                    (done false))
                (while (and (not done) (not aborted))
                  (let* ((want (Math/min library-hash-chunk-bytes (1+ (- max-cached-library-bytes total))))
                         (count (readSync fd chunk 0 want total)))
                    (if (<= count 0)
                      (setq done t)
                      (progn
                        (setq total (+ total count))
                        (if (> total max-cached-library-bytes)
                          (setq aborted t)
                          (js-call hash :update (js-call chunk :subarray 0 count)))))))
                (if aborted nil
                  (str total ":" (js-call hash :digest "hex"))))))
          (finally
            (try (closeSync fd) (catch ignored nil)))))
      (catch ignored nil)))

  ;; Every export carries an exact signature.  There is deliberately no
  ;; arity-based u32 fallback: a missing or malformed signature would silently
  ;; truncate a v64/bits64 value.
  (defun native-ffi-type (type)
    (cond ((= type "u32") "u32") ((= type "f64") "f64")
      ((or (= type "v64") (= type "bits64")) "u64")
      (t (throw (new globalThis.TypeError "unknown native parameter type")))))
  (defun native-parameter-types (signature expected-arity)
    (let ((types (get signature :parameterTypes)) (result (get signature :resultType)))
      (unless (and (Array/isArray types) (= (js-length types) expected-arity))
        (throw (new globalThis.TypeError "native export requires exact parameterTypes")))
      (js-call types :forEach (lambda (type)
        (unless (js-call (js-array "u32" "f64" "bits64" "v64") :includes type)
          (throw (new globalThis.TypeError "unknown native parameter type")))))
      (unless (js-call (js-array "u32" "f64" "bits64" "v64") :includes result)
        (throw (new globalThis.TypeError "native export requires exact resultType")))
      types))
  (defun normalize-u32-result (value) (uint32 value))
  (defun normalize-f64-result (value) (funcall globalThis.Number value))
  (defun normalize-u64-result (value)
    ;; Bun may return a lossless small u64 as Number; reject any lossy word.
    (if (= (value-type value) "bigint")
      (if (and (>= value U64_ZERO) (<= value U64_MAX))
        value
        (js-call globalThis.BigInt :asUintN 64 value))
      (progn
        (unless (and (Number/isSafeInteger value) (>= value 0))
          (throw (new globalThis.TypeError "native u64 result is not exact")))
        (funcall globalThis.BigInt value))))
  (defun make-result-normalizer (type)
    (cond ((= type "u32") normalize-u32-result)
      ((= type "f64") normalize-f64-result)
      ((or (= type "v64") (= type "bits64")) normalize-u64-result)
      (t (throw (new globalThis.TypeError "unknown native result type")))))
  (defun native-normalize-result (type value)
    (funcall (make-result-normalizer type) value))

  (defun check-u32-argument (value)
    (unless (and (Number/isInteger value) (>= value 0) (<= value 4294967295))
      (throw (new globalThis.RangeError "native u32 argument is out of range")))
    value)
  (defun check-f64-argument (value)
    (unless (= (value-type value) "number")
      (throw (new globalThis.TypeError "native f64 argument must be a number")))
    value)
  (defun check-u64-argument (value)
    (unless (= (value-type value) "bigint")
      (throw (new globalThis.TypeError "native v64/bits64 argument must be a bigint")))
    (if (and (>= value U64_ZERO) (<= value U64_MAX))
      value
      (js-call globalThis.BigInt :asUintN 64 value)))
  (defun make-arg-checker (type)
    (cond ((= type "u32") check-u32-argument)
      ((= type "f64") check-f64-argument)
      ((or (= type "v64") (= type "bits64")) check-u64-argument)
      (t (throw (new globalThis.TypeError "unknown native argument type")))))
  (defun native-check-argument (type value)
    (funcall (make-arg-checker type) value))
  (defun native-read-exact (fd offset size file-size)
    (unless (and (Number/isSafeInteger offset) (Number/isSafeInteger size)
                 (>= offset 0) (>= size 0) (<= (+ offset size) file-size))
      (throw (new globalThis.TypeError "native section is outside its image")))
    (let ((bytes (Buffer/allocUnsafe size)) (done 0))
      (while (< done size)
        (let ((count (readSync fd bytes done (- size done) (+ offset done))))
          (when (= count 0) (throw (new globalThis.TypeError "native image is truncated")))
          (setq done (+ done count)))) bytes))
  (defun read-native-section (path offset size)
    (let ((fd (openSync path "r")))
      (try (native-read-exact fd offset size (get (fstatSync fd) :size))
        (finally (closeSync fd)))))
  (defun native-file-u64 (bytes offset)
    (let ((word (js-call bytes :readBigUInt64LE offset)))
      (when (> word (funcall globalThis.BigInt 9007199254740991))
        (throw (new globalThis.TypeError "native file offset is not exact")))
      (funcall globalThis.Number word)))
  (defun native-file-name-p (bytes offset length name)
    (and (<= (1+ (js-length name)) length)
         (= (js-call bytes :toString "ascii" offset (+ offset (js-length name))) name)
         (= (aref bytes (+ offset (js-length name))) 0)))
  (defun discover-native-rodata (path)
    ;; Inspect only bounded container headers; the RO payload is read after the
    ;; declared memory budget and the self-describing prefix have been checked.
    (let ((fd (openSync path "r")))
      (try
        (let* ((file-size (get (fstatSync fd) :size))
               (header (native-read-exact fd 0 (Math/min 64 file-size) file-size))
               (result nil))
          (unless (>= file-size 32) (throw (new globalThis.TypeError "native image has no container header")))
          (letfn ((accept (name offset size alignment)
                    (unless (and (not result) (Number/isSafeInteger offset) (>= offset 0)
                                 (Number/isSafeInteger size) (>= size 32)
                                 (<= (+ offset size) file-size) (= (mod offset 8) 0)
                                 (>= alignment 8))
                      (throw (new globalThis.TypeError "invalid or duplicate native readonly data section")))
                    (setq result (Object/freeze (js-object :name name :fileOffset offset :size size :align 8)))))
            (cond
              ((= (js-call header :readUInt32LE 0) 4277009103)
               (let ((count (js-call header :readUInt32LE 16))
                     (command-end (+ 32 (js-call header :readUInt32LE 20))) (cursor 32) (index 0))
                 (unless (and (<= command-end file-size) (<= count (/ (- command-end 32) 8)))
                   (throw (new globalThis.TypeError "invalid Mach-O load command table")))
                 (while (< index count)
                   (let* ((prefix (native-read-exact fd cursor 8 command-end))
                          (command (js-call prefix :readUInt32LE 0))
                          (size (js-call prefix :readUInt32LE 4)))
                     (unless (and (>= size 8) (<= (+ cursor size) command-end))
                       (throw (new globalThis.TypeError "invalid Mach-O load command size")))
                     (when (= command 25)
                       (let* ((segment (native-read-exact fd cursor 72 command-end))
                              (sections (js-call segment :readUInt32LE 64)) (slot 0))
                         (unless (<= (+ 72 (* sections 80)) size)
                           (throw (new globalThis.TypeError "invalid Mach-O section table")))
                         (while (< slot sections)
                           (let ((section (native-read-exact fd (+ cursor 72 (* slot 80)) 80 command-end)))
                             (when (and (native-file-name-p section 0 16 "__const")
                                        (native-file-name-p section 16 16 "__TEXT"))
                               (let ((exponent (js-call section :readUInt32LE 52)))
                                 (unless (and (>= exponent 3) (<= exponent 31))
                                   (throw (new globalThis.TypeError "invalid Mach-O readonly alignment")))
                                 (accept "__const" (js-call section :readUInt32LE 48)
                                   (native-file-u64 section 40) (Math/pow 2 exponent)))))
                           (setq slot (1+ slot)))))
                     (setq cursor (+ cursor size)))
                   (setq index (1+ index)))
                 (unless (= cursor command-end)
                   (throw (new globalThis.TypeError "Mach-O load command length mismatch")))))
              ((= (js-call header :readUInt32LE 0) 1179403647)
               (unless (and (>= file-size 64) (= (aref header 4) 2) (= (aref header 5) 1)
                            (= (js-call header :readUInt16LE 18) 183))
                 (throw (new globalThis.TypeError "native image must be little-endian AArch64 ELF64")))
               (let ((table-offset (native-file-u64 header 40))
                     (entry-size (js-call header :readUInt16LE 58))
                     (count (js-call header :readUInt16LE 60))
                     (names-index (js-call header :readUInt16LE 62)))
                 (unless (and (>= entry-size 64) (> count 0) (< names-index count)
                              (<= (+ table-offset (* entry-size count)) file-size))
                   (throw (new globalThis.TypeError "invalid ELF section table")))
                 (let* ((names-header (native-read-exact fd (+ table-offset (* entry-size names-index)) 64 file-size))
                        (names-offset (native-file-u64 names-header 24))
                        (names-size (native-file-u64 names-header 32)) (index 0))
                   (unless (<= (+ names-offset names-size) file-size)
                     (throw (new globalThis.TypeError "invalid ELF section names")))
                   (while (< index count)
                     (let* ((section (native-read-exact fd (+ table-offset (* entry-size index)) 64 file-size))
                            (name-offset (js-call section :readUInt32LE 0)))
                       (when (< name-offset names-size)
                         (let ((name (native-read-exact fd (+ names-offset name-offset)
                                       (Math/min 8 (- names-size name-offset)) file-size)))
                           (when (native-file-name-p name 0 (js-length name) ".rodata")
                             (unless (and (= (js-call section :readUInt32LE 4) 1)
                                          (= (bit-and (js-call section :readUInt32LE 8) 3) 2))
                               (throw (new globalThis.TypeError "ELF readonly section has invalid flags")))
                             (accept ".rodata" (native-file-u64 section 24)
                               (native-file-u64 section 32) (native-file-u64 section 48))))))
                     (setq index (1+ index))))))
              (t (throw (new globalThis.TypeError "unsupported native image container"))))) result)
        (finally (closeSync fd)))))
  (defun native-rodata-header (path section declared)
    (if (not section)
      (progn
        (unless (nullish? declared)
          (throw (new globalThis.TypeError "native ROData header has no readonly section"))) nil)
      (let* ((bytes (read-native-section path (get section :fileOffset) 32))
             (header (js-object :roBase (js-call bytes :readUInt32LE 0)
                       :roDir (js-call bytes :readUInt32LE 4) :roCount (js-call bytes :readUInt32LE 8)
                       :roImageSlot (js-call bytes :readUInt32LE 12) :imageDataEnd (js-call bytes :readUInt32LE 16)
                       :metaDir (js-call bytes :readUInt32LE 20) :metaCount (js-call bytes :readUInt32LE 24)))
             (end (+ 256 (get section :size))))
        (unless (and (= (get header :roBase) 256) (= (get header :imageDataEnd) end) (= (mod end 8) 0)
                     (= (js-call bytes :readUInt32LE 28) 0)
                     (or (> (get header :roCount) 0) (> (get header :metaCount) 0))
                     (> (get header :roImageSlot) 0) (<= (get header :roImageSlot) 65535)
                     (or (= (get header :roCount) 0)
                         (and (>= (get header :roDir) 288) (= (mod (get header :roDir) 8) 0)
                              (<= (+ (get header :roDir) (* (get header :roCount) 4)) end)))
                     (or (= (get header :metaCount) 0)
                         (and (>= (get header :metaDir) 288) (= (mod (get header :metaDir) 8) 0)
                              (<= (+ (get header :metaDir) (* (get header :metaCount) 24)) end))))
          (throw (new globalThis.TypeError "invalid native ROData self-describing header")))
        (unless (nullish? declared)
          (js-call (Object/keys header) :forEach (lambda (key)
            (unless (= (get declared key) (get header key))
              (throw (new globalThis.TypeError "native ROData descriptor differs from its image"))))))
        (Object/freeze header))))

  (defvar dlopen-staging-dir nil)
  (defvar dlopen-staging-serial 0)
  (defun ensureDlopenStagingDir ()
    (when (eq dlopen-staging-dir nil)
      (let ((dir (js-call node-path :resolve (tmpdir)
                   (str "eliscript-dlopen-" (get globalThis.process :pid) "-"
                     (Math/floor (* (Math/random) 1000000000))))))
        (mkdirSync dir (js-object :recursive t))
        (setq dlopen-staging-dir dir)
        (js-call globalThis.process :once "exit" (lambda ()
          (try (rmSync dir (js-object :recursive t :force t)) (catch ignored nil))))))
    dlopen-staging-dir)
  (defun stageImmutableLibraryPath (resolved-path file-identity)
    (if (or (/= (get globalThis.process :platform) "darwin") (eq file-identity nil))
      resolved-path
      (let* ((dir (ensureDlopenStagingDir))
             (safe-key (js-call file-identity :replace ":" "-"))
             (staged (js-call node-path :resolve dir (str safe-key ".dylib"))))
        (unless (existsSync staged)
          (setq dlopen-staging-serial (1+ dlopen-staging-serial))
          (let ((tmp (str staged ".tmp." dlopen-staging-serial)))
            (try
              (progn
                (copyFileSync resolved-path tmp)
                (renameSync tmp staged))
              (catch error
                (try (rmSync tmp (js-object :recursive t :force t)) (catch ignored nil))
                (unless (existsSync staged) (throw error))))))
        staged)))

  (defun acquireNativeLibrary (ffi path entries)
    (let* ((ffi-signatures (Object/fromEntries (js-call entries :map (lambda (entry)
              (let* ((signature (aref entry 1)) (arity (get signature :arity))
                     (types (native-parameter-types signature arity)))
                (js-array (aref entry 0) (js-object :args
                  (js-call (js-array "ptr") :concat (js-call types :map native-ffi-type))
                  :returns (native-ffi-type (get signature :resultType)))))))))
           (resolved-path (if (and (= (value-type path) "string") (> (js-length path) 0))
                            (js-call node-path :resolve path)
                            nil))
           (pool (if (not (eq resolved-path nil))
                   (let ((existing (js-call library-pool-cache :get ffi)))
                     (if existing existing
                       (let ((created (js-array))) (js-call library-pool-cache :set ffi created) created)))
                   nil))
           ;; Content hash enables pooling across repeated instantiations of
           ;; identical compiled libraries while invalidating rewritten files.
           (file-identity (if (not (eq pool nil))
                            (boundedFileIdentity resolved-path) nil)))
      (when (not (eq pool nil))
        (let ((scan 0))
          (while (< scan (js-length pool))
            (let ((candidate (aref pool scan)))
              (if (and (= (get candidate :path) resolved-path)
                       (or (eq file-identity nil) (/= (get candidate :identity) file-identity)))
                (progn
                  (js-call pool :splice scan 1)
                  (try (js-call (get candidate :raw) :close) (catch ignored nil)))
                (setq scan (1+ scan)))))))
      (if (eq file-identity nil)
        (progn
          (bun-gc-sweep)
          (js-call ffi :dlopen path ffi-signatures))
        (let* ((sorted-entries (js-call (js-call entries :slice) :sort
                 (lambda (left right)
                   (cond ((< (aref left 0) (aref right 0)) -1) ((> (aref left 0) (aref right 0)) 1) (t 0)))))
               (cache-key (str resolved-path "\u0000" (JSON/stringify sorted-entries)))
               (scan 0) (reused nil))
          (while (and (eq reused nil) (< scan (js-length pool)))
            (let ((candidate (aref pool scan)))
              (when (and (= (get candidate :key) cache-key)
                         (= (get candidate :identity) file-identity))
                (js-call pool :splice scan 1)
                (setq reused (get candidate :raw))))
            (setq scan (1+ scan)))
          (let* ((raw (if (not (eq reused nil)) reused
                        (progn
                          (bun-gc-sweep)
                          (js-call ffi :dlopen (stageImmutableLibraryPath resolved-path file-identity) ffi-signatures))))
                 (released false))
            (js-object
              :symbols (get raw :symbols)
              :close (lambda ()
                (unless released
                  (setq released t)
                  (let ((disk-identity (boundedFileIdentity resolved-path)))
                    (if (and (not (eq disk-identity nil))
                             (= disk-identity file-identity)
                             (< (js-length pool) 8))
                      (js-call pool :push (js-object :path resolved-path :key cache-key :identity file-identity :raw raw))
                      (js-call raw :close)))))))))))

  (defasync anonymousMapping (ffi maximumBytes libcLibrary platform)
    (let* ((custom-libc (memory-truth libcLibrary))
           (mac (= platform "arm64-macos"))
           (flags (if mac 4098 34))
           (libc undefined) (cached-page undefined)
           (mapping 0) (mappingBytes 0) (released false))
      (if (not custom-libc)
        (let ((shared (openDefaultLibc ffi platform)))
          (setq libc (get shared :libc) cached-page (get shared :page)))
        (let ((signatures (js-object
                :mmap (js-object :args (js-array "ptr" "u64" "i32" "i32" "i32" "i64") :returns "ptr")
                :mprotect (js-object :args (js-array "ptr" "u64" "i32") :returns "i32")
                :munmap (js-object :args (js-array "ptr" "u64") :returns "i32")
                :getpagesize (js-object :args (js-array) :returns "i32")))
              (failure undefined))
          (bun-gc-sweep)
          (try (setq libc (js-call ffi :dlopen libcLibrary signatures))
            (catch error (setq failure error)))
          (unless (memory-truth libc)
            (throw (new globalThis.Error (if mac "unable to load macOS virtual memory functions" "unable to load Linux virtual memory functions")
              (js-object :cause failure))))))
      (try
        (let* ((page (if (not custom-libc) cached-page (js-call (get libc :symbols) :getpagesize))))
          (unless (and (Number/isSafeInteger page) (> page 0) (= (bit-and page (1- page)) 0))
            (throw (new globalThis.Error (if mac "invalid macOS memory page size" "invalid Linux memory page size"))))
          (let* ((usableBytes (* (Math/ceil (/ (Math/max 1 maximumBytes) page)) page)))
            (setq mappingBytes (+ usableBytes (* 2 page)))
            ;; Both platforms reserve inaccessible guard pages around the
            ;; usable anonymous range. No whole-region ArrayBuffer is created.
            (let ((address (js-call (get libc :symbols) :mmap nil (globalThis.BigInt mappingBytes) 0 flags -1 (globalThis.BigInt 0))))
              (unless (and (Number/isSafeInteger address) (> address 0))
                (throw (new globalThis.Error "unable to reserve native linear memory")))
              (setq mapping address))
            (let* ((base (+ mapping page))
                   (DataViewCtor globalThis.DataView)
                   (scratch (new globalThis.Uint8Array 8))
                   (scratchView (new DataViewCtor (get scratch :buffer)))
                   (scratch16 (new globalThis.Uint8Array (get scratch :buffer) 0 2))
                   (scratch32 (new globalThis.Uint8Array (get scratch :buffer) 0 4))
                   (pageViews (js-array))
                   (page0View undefined)
                   (lastPageIndex -1)
                   (lastPageView undefined))
              (unless (= (js-call (get libc :symbols) :mprotect base (globalThis.BigInt usableBytes) 3) 0)
                (throw (new globalThis.Error "unable to enable native linear memory")))
              (letfn ((rangeView (offset length)
                         (new globalThis.Uint8Array (js-call ffi :toArrayBuffer (+ base offset) 0 length)))
