                          ((= argCount 2) (funcall invoker (aref args 0) (aref args 1)))
                          ((= argCount 3) (funcall invoker (aref args 0) (aref args 1) (aref args 2)))
                          ((= argCount 4) (funcall invoker (aref args 0) (aref args 1) (aref args 2) (aref args 3)))
                          ((= argCount 5) (funcall invoker (aref args 0) (aref args 1) (aref args 2) (aref args 3) (aref args 4)))
                          ((= argCount 7) (funcall invoker (aref args 0) (aref args 1) (aref args 2) (aref args 3) (aref args 4) (aref args 5) (aref args 6)))
                          (t (Reflect/apply invoker undefined args))))))
                  :getUint16 (lambda (offset endian)
                    (unless (and (not closed) (= (aref contextWords 3) 0) (>= offset 0) (= (bit-or offset 0) offset) (<= (+ offset 2) (aref contextWords 2)))
                      (range offset 2))
                    (js-call mapping :getUint16 offset endian))
                  :getUint32 (lambda (offset endian)
                    (unless (and (not closed) (= (aref contextWords 3) 0) (>= offset 0) (= (bit-or offset 0) offset) (<= (+ offset 4) (aref contextWords 2)))
                      (range offset 4))
                    (js-call mapping :getUint32 offset endian))
                  :getBigUint64 (lambda (offset endian)
                    (unless (and (not closed) (= (aref contextWords 3) 0) (>= offset 0) (= (bit-or offset 0) offset) (<= (+ offset 8) (aref contextWords 2)))
                      (range offset 8))
                    (js-call mapping :getBigUint64 offset endian))
                  :getFloat64 (lambda (offset endian)
                    (unless (and (not closed) (= (aref contextWords 3) 0) (>= offset 0) (= (bit-or offset 0) offset) (<= (+ offset 8) (aref contextWords 2)))
                      (range offset 8))
                    (js-call mapping :getFloat64 offset endian))
                  :setUint16 (lambda (offset value endian)
                    (let ((converted (Math/trunc value)))
                      (unless (and (not closed) (= (aref contextWords 3) 0) (>= offset 0) (= (bit-or offset 0) offset) (<= (+ offset 2) (aref contextWords 2)))
                        (range offset 2))
                      (js-call mapping :setUint16 offset converted endian)))
                  :setUint32 (lambda (offset value endian)
                    (let ((converted (Math/trunc value)))
                      (unless (and (not closed) (= (aref contextWords 3) 0) (>= offset 0) (= (bit-or offset 0) offset) (<= (+ offset 4) (aref contextWords 2)))
                        (range offset 4))
                      (js-call mapping :setUint32 offset converted endian)))
                  :setBigUint64 (lambda (offset value endian)
                    (active)
                    (unless (and (Number/isSafeInteger offset) (>= offset 0))
                      (throw (new globalThis.RangeError "memory access out of bounds")))
                    (unless (= (value-type value) "bigint")
                      (throw (new globalThis.TypeError "native 64-bit scalar write requires a bigint")))
                    (range offset 8)
                    (js-call mapping :setBigUint64 offset (js-call globalThis.BigInt :asUintN 64 value) endian))
                  :read (lambda (offset length)
                    (range offset length)
                    (js-call mapping :read offset length))
                  :write (lambda (input &rest positions)
                    (let ((offset (memory-default (aref positions 0) 0)))
                      (unless (js-call globalThis.Uint8Array globalThis.Symbol.hasInstance input)
                        (throw (new globalThis.TypeError "memory write requires Uint8Array")))
                      (let ((copy (new globalThis.Uint8Array input)))
                        (range offset (get copy :byteLength)) (js-call mapping :write copy offset)))
                    undefined)
                  :directView (lambda ()
                    (if closed nil
                      (let ((curSize (if (= (aref contextWords 3) 0) (aref contextWords 2) 0)))
                        (if (and cachedDirectView (= cachedDirectSize curSize))
                          cachedDirectView
                          (if (> curSize 0)
                            (progn
                              (setq cachedDirectView (new globalThis.DataView (js-call ffi :toArrayBuffer (get mapping :base) 0 curSize))
                                    cachedDirectSize curSize)
                              cachedDirectView)
                            nil)))))
                  :close (lambda ()
                    (unless closed
                      (setq closed t cachedDirectView nil cachedDirectSize 0)
                      (when (= (js-length invocations) 0) (dispose)))
                    undefined))))
                  (js-call owned-invoker-tables :set owned invokers)
                  (Object/defineProperty owned "byteLength" (js-object :enumerable t :configurable t
                    :get (lambda () (active) (size)))) owned)))))))))
  (export openNativeMemory nativeMemoryInvokers))
