(module tools.backends.compiler-corpus-reference
  (import "node:fs/promises" readFile writeFile readdir lstat realpath rename symlink unlink)
  (import "node:path" resolve relative)
  (import "node:crypto" createHash)
  (import "./compiler-corpus-reference-legacy.mjs" :as legacy)
  (defun optional (value key) (if (nullish? value) undefined (get value key)))
  (defasync runtime-files (directory prefix)
    (let ((entries (await (readdir directory (js-object :withFileTypes t)))) (result (js-array)) (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (name (get entry :name)) (id (+ prefix "/" name)))
          (cond ((js-call entry :isDirectory)
            (setq result (js-call result :concat (await (runtime-files (resolve directory name) id)))))
            ((and (js-call entry :isFile) (js-call name :endsWith ".mjs")) (js-call result :push id))))
        (setq index (1+ index))) result))
  (defasync shared-runtime (context)
    (let* ((record (get context :record)) (sources (optional (get record :request) "hostSources"))
           (artifact (get context :artifact)) (declared (new globalThis.Map)))
      (when (and (= (get context :target) "javascript") (Array/isArray sources))
        (js-call sources :forEach (lambda (source)
          (when (and (= (value-type (get source :id)) "string") (= (value-type (get source :source)) "string"))
            (js-call declared :set (get source :id) (get source :source)))))
        (when (and (js-call declared :has "runtime/literals.mjs") (js-call declared :has "runtime/core/data-text.mjs"))
          (let ((files (await (runtime-files (resolve (get context :sourceRoot) "runtime") "runtime"))))
            (when (js-call files :every (lambda (id) (js-call declared :has id)))
              (let* ((directory (if (undefined? (get artifact :directory)) (resolve (get artifact :path) "..") (get artifact :directory)))
                     (index 0))
                (while (< index (js-length files))
                  (let* ((id (aref files index)) (path (resolve directory id)) (details (await (lstat path))))
                    (unless (and (js-call details :isFile) (not (js-call details :isSymbolicLink))
                                 (= (await (readFile path "utf8")) (js-call declared :get id)))
                      (throw (new globalThis.Error "independent reference shared runtime differs from declared source"))))
                  (setq index (1+ index)))
                (js-object :directory directory :files files :declared declared
                  :packageSource (await (readFile (resolve directory "package.json") "utf8"))))))))))
  (defasync prepareOriginalReferenceArtifact (context)
    ;; Seed compilation and the authenticated module archive remain untouched.
    ;; Only original declared runtime assets share a canonical real path with
    ;; the host, as they do in the original CLI's single runtime environment.
    (let* ((sharing (when (= (optional (get (get context :record) :execution) "referenceArtifact") t)
                      (await (shared-runtime context))))
           (result (await (js-call legacy :prepareOriginalReferenceArtifact context))))
      (when (and sharing result)
        (let* ((directory (get result :directory)) (selected (get sharing :directory))
               (files (get sharing :files)) (declared (get sharing :declared)) (index 0))
          (while (< index (js-length files))
            (let ((id (aref files index)))
              (unless (= (await (readFile (resolve directory id) "utf8")) (js-call declared :get id))
                (throw (new globalThis.Error "independent reference runtime differs from original declared source"))))
            (setq index (1+ index)))
          (let* ((path (resolve directory "runtime")) (details (await (lstat path))))
            (unless (and (js-call details :isDirectory) (not (js-call details :isSymbolicLink)))
              (throw (new globalThis.Error "independent reference runtime is not its original declared graph")))
            ;; Preserve the separately archived provider source bytes as well
            ;; as the environment path recorded by the original manifest.
            (await (rename path (resolve directory "runtime-original-declared")))
            (await (symlink (await (realpath (resolve selected "runtime"))) path "dir")))
          (let* ((path (resolve directory "node_modules/eliscript")) (details (await (lstat path))))
            (unless (js-call details :isSymbolicLink)
              (throw (new globalThis.Error "independent reference package environment conflicts with declared runtime")))
            (await (unlink path)) (await (symlink selected path "dir")))
          (await (writeFile (resolve directory "package.json") (get sharing :packageSource) (js-object :flag "wx")))
          (let* ((path (get result :manifestPath)) (manifest (JSON/parse (await (readFile path "utf8"))))
                 (dependency (js-object :role "original-runtime-package" :specifier "eliscript"
                    :implementation "original-declared-runtime-shared-realpath"
                    :directory (relative (get context :directory) (resolve selected "runtime")))))
            (put manifest :environmentDependencies (js-array dependency))
            (put manifest :environmentFiles (js-call (get manifest :environmentFiles) :concat
              (js-array (js-object :path "package.json" :role "original-runtime-package-self-reference"
                :bytes (js-length (js-call (new globalThis.TextEncoder) :encode (get sharing :packageSource)))
                :sha256 (js-call (js-call (createHash "sha256") :update (get sharing :packageSource)) :digest "hex")))))
            ;; The original entry/module/source identities are unchanged;
            ;; the returned evidence hash must describe this final environment.
            (let ((bytes (+ (JSON/stringify manifest nil 2) "\n")))
              (await (writeFile path bytes))
              (js-call (get result :supportingProducts) :forEach (lambda (product)
                (when (= (get product :role) "original-independent-reference")
                  (put product :manifestSha256 (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")))))))))
      result))
  (export prepareOriginalReferenceArtifact))
