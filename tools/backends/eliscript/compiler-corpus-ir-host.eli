(module tools.backends.compiler-corpus-ir-host
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (defasync main ()
    (let* ((root (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (directory (resolve (aref (get globalThis.process :argv) 2) "bootstrap/compiler"))
           (require (createRequire (resolve directory "compiler.mjs")))
           (compiler (funcall require (resolve directory "compiler.mjs")))
           (ir (funcall require (resolve directory "ir.mjs")))
           (fixture-path (resolve root "tests/fixtures/bootstrap-ir.json"))
           (fixture (JSON/parse (await (readFile fixture-path "utf8"))))
           (oracle (spawnSync (get (get globalThis.process :env) :EMACS "emacs")
             (js-array "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script"
               (resolve root "tests/bootstrap-ir-oracle.el"))
             (js-object :cwd root :encoding "utf8" :timeout 20000 :maxBuffer 67108864
               :env (Object/assign (js-object) (get globalThis.process :env)
                 (js-object :ELISCRIPT_IR_FIXTURE fixture-path)))))
           (generated (js-array)) (kinds (new globalThis.Set)))
      (js-call assert :strictEqual (get oracle :status) 0
        (str "independent Emacs IR oracle failed: " (get oracle :stderr)))
      (let ((index 0))
        (while (< index (js-length (get fixture :valid)))
          (let* ((entry (aref (get fixture :valid) index))
                 (source (if (Object/hasOwn entry "source") (get entry :source)
                   (await (readFile (resolve root (get entry :file)) "utf8"))))
                 (program (js-call compiler :compile_ir_string source (get entry :filename)))
                 (pending (js-call (get program :body) :slice)))
            (js-call generated :push (js-object :name (get entry :name) :status "ok" :program program))
            (while (> (js-length pending) 0)
              (let ((node (js-call pending :pop)))
                (js-call kinds :add (get node :kind))
                (Reflect/apply (get pending :push) pending (get node :children)))))
          (setq index (1+ index))))
      (js-call assert :deepStrictEqual generated (JSON/parse (get oracle :stdout)))
      (js-call assert :deepStrictEqual (js-call (Array/from kinds) :sort)
        (js-call (js-call (get ir :node_kinds) :slice) :sort))
      (js-call assert :ok (js-call (await (readFile (resolve directory "lower.mjs.map") "utf8"))
        :includes "bootstrap/compiler/lower.eli"))))
  (defconst completion (main))
  (js-call completion :catch (lambda (error)
    (console/error error) (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
