(module tools.backends.compiler-corpus-raw-fixture-observer
  (import "node:assert/strict" :default assert)

  ;; Test-observation ownership only. Nothing here changes the language codec
  ;; or turns arbitrary host objects into managed capabilities.
  (defun raw-scope (runtime family)
    (let ((owned (js-array)))
      (letfn ((keep (value) (js-call owned :push value) value)
              (box (value)
                (cond ((= (value-type value) "number") (keep (js-call runtime :number value)))
                      ((= (value-type value) "bigint") (keep (js-call runtime :bigint value)))
                      ((= (value-type value) "string") (keep (js-call runtime :string value)))
                      ((or (eq value nil) (undefined? value) (= (value-type value) "boolean")) value)
                      (t (throw (new globalThis.TypeError "raw fixture scalar requires explicit ownership")))))
              (array (values)
                (let ((items (new globalThis.Array (js-length values))))
                  (js-call (Object/keys values) :forEach (lambda (key)
                    (put items key (funcall box (get values key)))))
                  (keep (js-call runtime :sourceArray items))))
              (object (values)
                (let ((items (Object/create nil)))
                  (js-call (Object/keys values) :forEach (lambda (key)
                    (Object/defineProperty items key (js-object :value (box (get values key)) :enumerable t :configurable t :writable t))))
                  (keep (js-call runtime :sourceObject items))))
              (call (name &rest arguments) (keep (js-call runtime :invoke name arguments)))
              (read (value)
                (let ((seen (js-array)))
                  (letfn ((visit (item)
                    (if (or (eq item nil) (undefined? item) (= (value-type item) "boolean")) item
                      (let ((kind (get item :kind)))
                        (cond ((= kind 4) (js-call runtime :readNumber item))
                              ((= kind 5) (js-call runtime :readString item))
                              ((= kind 34) (js-call runtime :readBigInt item))
                              ((or (= kind 14) (= kind 13))
                                (let ((found (js-call seen :find (lambda (pair) (js-call runtime :keyEqual (aref pair 0) item)))))
                                  (if found (aref found 1)
                                    (let ((output (if (= kind 14) (new globalThis.Array (js-call runtime :length item)) (js-object))))
                                      (js-call seen :push (js-array item output))
                                      (if (= kind 14)
                                        (let ((index 0))
                                          (while (< index (js-length output))
                                            (when (or (not (js-call (js-array "arrays" "array-callbacks") :includes family))
                                                      (call (if (= family "array-callbacks") "has-index" "has") item (box index)))
                                              (put output index (visit (keep (js-call runtime :get item index)))))
                                            (setq index (1+ index))))
                                        (let* ((keys (keep (js-call runtime :objectKeys item))) (index 0))
                                          (while (< index (js-call runtime :length keys))
                                            (let* ((key (keep (js-call runtime :get keys index)))
                                                   (name (js-call runtime :readString key))
                                                   (child (keep (js-call runtime :objectGet item key))))
                                              (Object/defineProperty output name (js-object :value (visit child)
                                                :enumerable t :configurable t :writable t)))
                                            (setq index (1+ index))))) output))))
                              (t (throw (new globalThis.TypeError "raw fixture opaque value requires an explicit identity assertion"))))))))
                    (visit value))))
              (value (name &rest arguments) (read (Reflect/apply call undefined (js-call (js-array name) :concat arguments))))
              (get-child (value index) (keep (js-call runtime :get value index)))
              (close ()
                (let ((index (1- (js-length owned))))
                  (while (>= index 0) (js-call runtime :release (aref owned index)) (setq index (1- index))))
                (js-call runtime :collect)
                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)))
        (js-object :keep keep :export (lambda (name) (keep (js-call runtime :getExport name)))
          :property (lambda (value name) (keep (js-call runtime :objectGet value (box name))))
          :box box :array array :object object :call call :read read :value value
          :get get-child :same (lambda (a b) (js-call runtime :keyEqual a b)) :close close))))

  (defun oracle-call (oracle name &rest arguments)
    (Reflect/apply (get oracle (js-call name :replaceAll "-" "_")) oracle arguments))

  (defun run-objects (check oracle)
    (funcall check "ordinary construction" (lambda (s)
      (js-call assert :deepStrictEqual
        (js-array (js-call s :value "make" (js-call s :box -0) (js-call s :box globalThis.NaN))
          (js-call s :value "duplicate" (js-call s :box 1) (js-call s :box 2))
          (js-call s :value "computed" (js-call s :box "😀") (js-call s :box 7)) (js-call s :value "empty"))
        (js-array (oracle-call oracle "make" -0 globalThis.NaN) (oracle-call oracle "duplicate" 1 2)
          (oracle-call oracle "computed" "😀" 7) (oracle-call oracle "empty")))))
    (funcall check "own order and prototypes" (lambda (s)
      (let* ((parent (js-call s :object (js-object :inherited 7)))
             (value (js-call s :call "inherit" parent (js-call s :box 9)))
             (ref-parent (js-object :inherited 7)) (ref (oracle-call oracle "inherit" ref-parent 9))
             (null-proto (js-call s :call "null-proto")) (data (js-call s :call "proto-data" (js-call s :box 7))))
        (js-call assert :ok (js-call s :same (js-call s :call "proto" value) parent))
        (js-call assert :strictEqual (oracle-call oracle "proto" ref) ref-parent)
        (let ((null-ref (oracle-call oracle "null-proto")))
          (js-call (js-array "constructor" "toString" "__proto__") :forEach (lambda (key)
            (js-call assert :deepStrictEqual (js-call s :value "read-value" null-proto (js-call s :box key))
              (oracle-call oracle "read-value" null-ref key)))))
        (js-call assert :deepStrictEqual
          (js-array (js-call s :value "read-value" value (js-call s :box "inherited"))
            (js-call s :value "has" value (js-call s :box "inherited")) (js-call s :value "keys" value)
            (js-call s :value "has" data (js-call s :box "__proto__")) (js-call s :value "read-value" data (js-call s :box "__proto__")))
          (js-array (oracle-call oracle "read-value" ref "inherited") (oracle-call oracle "has" ref "inherited")
            (oracle-call oracle "keys" ref) t 7)))))
    (funcall check "copy and exact getters" (lambda (s)
      (let* ((value (js-call s :call "make" undefined nil)) (ref (oracle-call oracle "make" undefined nil))
             (copy (js-call s :call "assoc" value (js-call s :box "extra") (js-call s :box 7))))
        (js-call assert :ok (not (js-call s :same value copy)))
        (js-call assert :deepStrictEqual
          (js-array (js-call s :read value) (js-call s :read copy) (js-call s :value "nth-value" (js-call s :box "x") value)
            (js-call s :value "default-value" value (js-call s :box "absent") (js-call s :box -0))
            (js-call s :value "default-order" value (js-call s :box "x")) (js-call s :value "size" value))
          (js-array ref (oracle-call oracle "assoc" ref "extra" 7) (oracle-call oracle "nth-value" "x" ref)
            (oracle-call oracle "default-value" ref "absent" -0) (oracle-call oracle "default-order" ref "x") (oracle-call oracle "size" ref))))))
    (funcall check "object evaluation order" (lambda (s)
      (let* ((value (js-call s :object (js-object :old 1))) (other (js-call s :object (js-object)))
             (ref (js-object :old 1)) (ref-other (js-object))
             (copy (js-call s :call "assoc-order" value (js-call s :box "tag")))
             (ref-copy (oracle-call oracle "assoc-order" ref "tag")))
        (js-call assert :ok (js-call s :same (js-call s :call "write-order" value other) other))
        (js-call assert :ok (js-call s :same (js-call s :call "read-value" value (js-call s :box "saved")) other))
        (js-call assert :strictEqual (oracle-call oracle "write-order" ref ref-other) ref-other)
        (js-call assert :strictEqual (get ref :saved) ref-other)
        (js-call assert :deepStrictEqual
          (js-array (js-call s :read copy) (js-call s :value "read-value" value (js-call s :box "old"))
            (js-call s :value "read-value" copy (js-call s :box "tag")))
          (js-array ref-copy (get ref :old) (oracle-call oracle "read-value" ref-copy "tag"))))))
    (funcall check "cycle and mutation" (lambda (s)
      (let* ((value (js-call s :call "self-cycle" (js-call s :box -0))) (ref (oracle-call oracle "self-cycle" -0)))
        (js-call assert :ok (js-call s :same value (js-call s :call "read-value" value (js-call s :box "self"))))
        (js-call assert :strictEqual (get ref :self) ref)
        (js-call assert :strictEqual (js-call s :value "write" value (js-call s :box "tag") (js-call s :box 7))
          (oracle-call oracle "write" ref "tag" 7))
        (js-call assert :deepStrictEqual (js-array (js-call s :value "read-value" value (js-call s :box "v"))
          (js-call s :value "keys" value) (js-call s :value "has" value (js-call s :box "tag")))
          (js-array (get ref :v) (oracle-call oracle "keys" ref) (oracle-call oracle "has" ref "tag"))))))
    (js-call (js-array 0 1 8 32 128) :forEach (lambda (count)
      (funcall check "object growth" (lambda (s)
        (let ((value (js-call s :call "grow-loop" (js-call s :box count))) (ref (oracle-call oracle "grow-loop" count)))
          (js-call assert :deepStrictEqual (js-call s :read value) ref)
          (js-call assert :deepStrictEqual (js-call s :value "keys" value) (Object/keys ref)))))))
    (js-call (js-array nil undefined) :forEach (lambda (receiver)
      (funcall check "member first error" (lambda (s)
        (js-call assert :throws (lambda () (js-call s :call "fault" receiver (js-call s :box "x"))))
        (js-call assert :throws (lambda () (oracle-call oracle "fault" receiver "x"))))))))

  (defun run-arrays (check oracle)
    (js-call (js-array (js-array undefined nil false) (js-array t -0 globalThis.NaN) (js-array "中😀" globalThis.Number.MIN_VALUE globalThis.Infinity)) :forEach
      (lambda (values) (funcall check "array construction" (lambda (s)
        (let* ((raw (js-call values :map (lambda (v) (js-call s :box v))))
               (value (Reflect/apply (get s :call) s (js-call (js-array "make") :concat raw)))
               (ref (Reflect/apply (get oracle :make) oracle values)))
          (js-call assert :deepStrictEqual
            (js-array (js-call s :read value) (js-call s :value "size" value)
              (js-call s :value "nth-value" (js-call s :box 1) value)
              (js-call s :value "at" value (js-call s :box 2))
              (js-call s :value "get-value" value (js-call s :box "missing") (js-call s :box 7)))
            (js-array ref (oracle-call oracle "size" ref) (oracle-call oracle "nth-value" 1 ref)
              (oracle-call oracle "at" ref 2) (oracle-call oracle "get-value" ref "missing" 7))))))))
    (funcall check "array identity and copy" (lambda (s)
      (let ((value (js-call s :call "empty")) (ref (oracle-call oracle "empty")))
        (js-call assert :strictEqual (js-call s :call "write" value (js-call s :box 1) undefined)
          (oracle-call oracle "write" ref 1 undefined))
