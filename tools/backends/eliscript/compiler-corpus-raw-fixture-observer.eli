        (funcall check name (lambda (s)
          (let ((result (js-call s :call name (js-call s :box count))) (expected (oracle-call oracle name count)))
            (js-call assert :deepStrictEqual (raw-collection-values s runtime result (if (= name "map-loop") "entries" "values"))
              (Array/from expected)))))))))
    (funcall check "collection own properties" (lambda (s)
      (let ((map (js-call s :call "raw-map")) (set (js-call s :call "raw-set"))
            (ref-map (oracle-call oracle "raw-map")) (ref-set (oracle-call oracle "raw-set")))
        (js-call s :call "write" map (js-call s :box "tag") (js-call s :box 7))
        (js-call s :call "write" set (js-call s :box "tag") (js-call s :box 9))
        (oracle-call oracle "write" ref-map "tag" 7) (oracle-call oracle "write" ref-set "tag" 9)
        (js-call assert :deepStrictEqual
          (js-array (js-call s :value "own" map (js-call s :box "tag")) (js-call s :value "own" map (js-call s :box "size"))
            (js-call s :value "own-keys" map) (js-call s :value "read-value" map (js-call s :box "tag"))
            (js-call s :value "read-value" set (js-call s :box "tag")) (js-call s :value "assoc" map (js-call s :box "other") (js-call s :box 11)))
          (js-array (oracle-call oracle "own" ref-map "tag") (oracle-call oracle "own" ref-map "size")
            (oracle-call oracle "own-keys" ref-map) (oracle-call oracle "read-value" ref-map "tag")
            (oracle-call oracle "read-value" ref-set "tag") (oracle-call oracle "assoc" ref-map "other" 11)))))))

  (defun originalRawFixtureInteropGroups (family)
    ;; These host-realm assertions were added by the old adapter, not by the
    ;; zero-import raw suite. Keep their exact original recipe in evidence and
    ;; route them to a separately declared capability-enabled interop case.
    (cond ((= family "array-construction")
           (js-array (js-object :group "Array.from" :input "host Array iterator from [8,9].values()"
             :reason "the original raw fixture exposes collection iterators, not host Array iterator ingress")))
          ((= family "objects")
           (js-array (js-object :group "own order and prototypes" :input "Object.getPrototypeOf on the returned host view"
             :reason "the original raw suite asserts constructor/toString/__proto__ absence and raw prototype aliases")))
          (t (js-array))))

  (defun runOriginalRawFixtureHost (configuration)
    (let* ((runtime (get configuration :runtime)) (family (get configuration :family))
           (oracle (get configuration :oracle)) (observations 0) (groups (Object/create nil))
           (check (lambda (label action)
             (let ((scope (raw-scope runtime family)) (failed false))
               (try (progn (funcall action scope) (setq observations (1+ observations))
                      (put groups label (1+ (or (get groups label) 0))))
                 (catch error (setq failed t) (throw error))
                 (finally (try (js-call scope :close) (catch error (unless failed (throw error))))))))))
      (cond ((= family "objects") (run-objects check oracle))
            ((= family "arrays") (run-arrays check oracle))
            ((= family "array-callbacks") (run-callbacks check oracle runtime))
            ((= family "array-search") (run-search check oracle))
            ((= family "array-construction") (run-construction check oracle runtime))
            ((= family "variadic-calls") (run-variadic check oracle runtime))
            ((= family "source-collections") (run-collections check oracle runtime))
            (t (throw (new globalThis.TypeError (str "unsupported original raw fixture family: " family)))))
      (js-object :observations observations :groups groups :interopGroups (originalRawFixtureInteropGroups family))))
  (export runOriginalRawFixtureHost raw-scope originalRawFixtureInteropGroups)
)
