          (js-call assert :throws (lambda () (oracle-call oracle "null-write" receiver ref)))
          (js-call assert :deepStrictEqual (js-call s :read marker) ref))))))
    (funcall check "named properties and assoc" (lambda (s)
      (let ((value (js-call s :call "empty")) (ref (js-array)))
        (js-call (js-array "tag" "2" "01" "1" "__proto__") :forEach (lambda (key)
          (let ((child (if (= key "__proto__") nil key)))
