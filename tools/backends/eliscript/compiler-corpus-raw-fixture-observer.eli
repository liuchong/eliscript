          (js-call assert :ok (js-call s :same (js-call s :get a 0) b)) (js-call assert :strictEqual (aref ra 0) rb)
          (js-call actual :push (js-call s :read a) (js-call s :read b) pop (js-call s :read marker) (js-call s :read slice))
          (js-call expected :push ra rb rpop rm rslice)
