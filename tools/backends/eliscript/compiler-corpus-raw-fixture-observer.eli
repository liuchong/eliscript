        (oracle-call oracle "write" ref 3 "last")
        (let ((copy (js-call s :call "copy" value)) (ref-copy (oracle-call oracle "copy" ref)))
          (js-call assert :ok (not (js-call s :same value copy)))
          (js-call assert :notStrictEqual ref ref-copy)
          (js-call assert :deepStrictEqual
            (js-array (js-call s :read value) (js-call s :read copy) (js-call s :value "keys" value) (js-call s :value "keys" copy)
              (js-call s :value "has" value (js-call s :box 0)) (js-call s :value "has" value (js-call s :box 1))
              (js-call s :value "has" value (js-call s :box "length")))
            (js-array ref ref-copy (oracle-call oracle "keys" ref) (oracle-call oracle "keys" ref-copy)
              (oracle-call oracle "has" ref 0) (oracle-call oracle "has" ref 1) (oracle-call oracle "has" ref "length")))))))
    (js-call (js-array (js-array "1" "5") (js-array "0x2" "Infinity") (js-array "-2" undefined)
      (js-array "not-number" "4") (js-array t false) (js-array nil "3.5")
      (js-array "0xbcf8f9bdba22840724d028768a8a77b3e6b0f283670085477910eccc4e9d6b278a11db79c280d4e9c237774812029ac7ce82daaafca38" undefined)) :forEach
      (lambda (bounds) (funcall check "primitive slice" (lambda (s)
        (let ((input (new globalThis.Array 6)))
          (put input 0 t) (put input 2 undefined) (put input 3 false) (put input 5 t)
          (let* ((value (js-call s :array input))
                 (out (js-call s :call "interval" value (js-call s :box (aref bounds 0)) (js-call s :box (aref bounds 1))))
                 (ref (oracle-call oracle "interval" input (aref bounds 0) (aref bounds 1))))
            (js-call assert :deepStrictEqual (js-array (js-call s :read out) (js-call s :value "keys" out))
              (js-array ref (Object/keys ref)))))))))
    (funcall check "mutations" (lambda (s)
      (let* ((value (js-call s :call "empty")) (ref (js-array))
             (actual (js-array (js-call s :value "append" value (js-call s :box 1) (js-call s :box 2))
               (js-call s :value "append-none" value) (js-call s :value "remove-last" value)
               (js-call s :value "truncate" value (js-call s :box 5))))
             (expected (js-array (oracle-call oracle "append" ref 1 2) (oracle-call oracle "append-none" ref)
               (oracle-call oracle "remove-last" ref) (oracle-call oracle "truncate" ref 5))))
        (js-call actual :push (js-call s :read value) (js-call s :value "keys" value))
        (js-call expected :push (js-call ref :slice) (oracle-call oracle "keys" ref))
        (js-call assert :deepStrictEqual actual expected))))
    (funcall check "self cycle" (lambda (s)
      (let ((value (js-call s :call "nested" (js-call s :box 1) (js-call s :box 2))) (ref (oracle-call oracle "nested" 1 2)))
        (js-call assert :ok (js-call s :same value (js-call s :get value 0)))
        (js-call assert :strictEqual (aref ref 0) ref)
        (js-call assert :deepStrictEqual (js-array (js-call s :read (js-call s :get value 1)) (js-call s :value "size" value))
          (js-array (aref ref 1) (js-length ref))))))
    (funcall check "operand order" (lambda (s)
