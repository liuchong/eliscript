          (js-array rout (Array/from ref) (get ref :push)))))))

  (defun run-callbacks (check oracle runtime)
    (let ((methods (js-array "map" "filter" "for-each" "some" "every" "find" "find-index" "find-last" "find-last-index"))
          (sparse (new globalThis.Array 6)))
      (put sparse 1 false) (put sparse 3 3) (put sparse 5 undefined)
      (js-call (js-array (js-array 0 -0 globalThis.NaN "" nil undefined false globalThis.Number.MIN_VALUE "中😀" t globalThis.Infinity) sparse) :forEach
        (lambda (values) (js-call methods :forEach (lambda (name)
          (funcall check name (lambda (s)
            (js-call assert :deepStrictEqual
              (js-call s :value (str name "-with") (js-call s :array values) (js-call s :call "identity"))
              (oracle-call oracle (str name "-with") (js-call values :slice) (oracle-call oracle "identity")))))))))
      (js-call methods :forEach (lambda (name)
        (funcall check (str "arguments " name) (lambda (s)
          (let* ((values (js-array false t false)) (items (js-call s :array values)) (log (js-call s :array (js-array)))
                 (callback (js-call s :call "collect-arguments" log)) (ref-log (js-array)))
            (js-call s :call (str name "-with") items callback)
            (oracle-call oracle (str name "-with") values (oracle-call oracle "collect-arguments" ref-log))
            (js-call assert :strictEqual (js-call runtime :length log) (js-length ref-log))
            (let ((index 0))
              (while (< index (js-length ref-log))
                (let ((arguments (js-call s :get log index)) (expected (aref ref-log index)))
                  (js-call assert :deepStrictEqual (js-call s :read (js-call s :get arguments 0)) (aref expected 0))
                  (js-call assert :strictEqual (js-call s :read (js-call s :get arguments 1)) (aref expected 1))
                  (js-call assert :ok (js-call s :same (js-call s :get arguments 2) items))
                  (js-call assert :strictEqual (aref expected 2) values)
                  (js-call assert :strictEqual (js-call runtime :length arguments) (js-length expected)))
                (setq index (1+ index)))))))))
      (js-call (js-array (js-array) (js-array undefined) (js-array 1) (js-array 1 2 3) (js-array -0)
        (js-array -0 globalThis.Number.MIN_VALUE globalThis.Infinity) (new globalThis.Array 5)) :forEach (lambda (values)
        (js-call (js-array "reduce" "reduce-right") :forEach (lambda (name)
          (funcall check name (lambda (s)
            (let ((items (js-call s :array values)) (callback (js-call s :call "sum-callback"))
                  (ref-callback (oracle-call oracle "sum-callback")) (expected undefined) (failed false))
              (try (setq expected (oracle-call oracle (str name "-with") (js-call values :slice) ref-callback))
                (catch ignored (setq failed t)))
              (if failed (js-call assert :throws (lambda () (js-call s :call (str name "-with") items callback)))
                (js-call assert :deepStrictEqual (js-call s :value (str name "-with") items callback) expected))
              (js-call assert :deepStrictEqual
                (js-call s :value (str name "-initial") items callback (js-call s :box -0))
                (oracle-call oracle (str name "-initial") (js-call values :slice) ref-callback -0)))))))))
      (js-call (js-array "reduce-initial" "reduce-right-initial") :forEach (lambda (name)
        (funcall check name (lambda (s)
          (let* ((values (js-array 1 2 3)) (items (js-call s :array values)) (log (js-call s :array (js-array)))
                 (ref-log (js-array)) (out (js-call s :value name items (js-call s :call "ordered-callback" log) (js-call s :box 0)))
                 (expected (oracle-call oracle name values (oracle-call oracle "ordered-callback" ref-log) 0)))
            (js-call assert :deepStrictEqual out expected)
            (js-call assert :strictEqual (js-call runtime :length log) (js-length ref-log))
            (let ((index 0))
              (while (< index (js-length ref-log))
                (let ((row (js-call s :get log index)) (ref (aref ref-log index)))
                  (js-call assert :deepStrictEqual (js-array (js-call s :read (js-call s :get row 0)) (js-call s :read (js-call s :get row 1)))
                    (js-array (aref ref 0) (aref ref 1)))
                  (js-call assert :ok (js-call s :same (js-call s :get row 2) items))
                  (js-call assert :strictEqual (aref ref 2) values))
                (setq index (1+ index)))))))))
      (js-call methods :forEach (lambda (name)
        (funcall check (str "live " name) (lambda (s)
          (let* ((values (js-array 1 2 3 4)) (items (js-call s :array values))
                 (out (js-call s :value (str name "-with") items (js-call s :call "mutation-callback" items)))
                 (expected (oracle-call oracle (str name "-with") values (oracle-call oracle "mutation-callback" values))))
            (js-call assert :deepStrictEqual (js-array out (js-call s :read items)) (js-array expected values)))))))
      (funcall check "capture order" (lambda (s)
