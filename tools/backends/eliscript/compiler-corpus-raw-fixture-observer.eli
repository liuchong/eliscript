        (let ((copy (js-call s :call "assoc" value (js-call s :box "other") (js-call s :box 7)))
              (ref-copy (oracle-call oracle "assoc" ref "other" 7)))
          (js-call assert :deepStrictEqual
            (js-array (js-call s :value "keys" value) (js-call s :value "keys" copy)
