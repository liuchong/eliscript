(module tools.backends.compiler-corpus-identity-runtime
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:process" :default process)
  (import "./compiler-host-record.mjs" copyHostRecord)
  (import "./compiler-host-iteration.mjs" openHostIterator advanceHostIterator closeHostIterator)
  (defconst import-module (js* "(specifier) => import(specifier)"))
  (defun host-truth (value) (js* "!!value"))
  (defun environment-value (key fallback)
    (let ((value (get (get process :env) key))) (if (nullish? value) fallback value)))

  (defun observe-original (root source engine arguments selected check-signal)
    (let* ((environment (copyHostRecord (get process :env)))
           (context-url (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-host-context.mjs")) :href))
           (preload (if (= engine "bun")
             (js-array "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
             (js-array "--experimental-loader" (resolve root "tests/fixtures/compiled-eli-node-loader.mjs")))))
      (unless (host-truth selected)
        (Reflect/deleteProperty environment "ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT")
        (Reflect/deleteProperty environment "ELISCRIPT_ORIGINAL_TARGET")
        (when (host-truth (get environment :NODE_OPTIONS))
          (put environment :NODE_OPTIONS
            (js-call (js-call (js-call (get environment :NODE_OPTIONS) :split (new globalThis.RegExp "\\s+"))
              :filter (lambda (value) (/= value (str "--import=" context-url)))) :join " "))))
      (when (and (host-truth selected) (host-truth (get environment :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT)))
        (setq source (str "await import(" (JSON/stringify context-url) ");\n" source)))
      (js-call preload :push "--input-type=module" "--eval" source)
      (let ((iterator (openHostIterator arguments)))
        (try
          (while (advanceHostIterator iterator) (js-call preload :push (get iterator :value)))
          (catch error (closeHostIterator iterator t) (throw error))
          (finally (closeHostIterator iterator false))))
      (let ((child (spawnSync (if (= engine "bun") (environment-value "BUN" "bun") (environment-value "NODE" "node"))
                     preload (js-object :cwd root :env environment :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :error) undefined)
        (when check-signal (js-call assert :equal (get child :signal) nil))
        (js-call assert :equal (get child :status) 0
          (if check-signal (str (get child :stderr) (get child :stdout))
            (if (host-truth (get child :stderr)) (get child :stderr) (get child :stdout))))
        (JSON/parse (get child :stdout)))))

  (defasync openOriginalIdentityRuntime ()
    (let* ((root (get (get process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (reference-directory (get (get process :env) :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT)))
      (unless (and (host-truth root) (host-truth reference-directory))
        (throw (new globalThis.Error "identity/value corpus requires its actual original source and independent reference")))
      (let* ((product (aref (get process :argv) 2)) (entry (aref (get process :argv) 3))
             (original-entry (get (pathToFileURL (resolve reference-directory entry)) :href))
             (reference (await (funcall import-module original-entry)))
             (module (await (funcall import-module (get (pathToFileURL (resolve product entry)) :href))))
             (configuration (get (get process :env) :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT))
             (metadata (await (funcall import-module (get (pathToFileURL (resolve root "tools/backends/compiler-metadata.mjs")) :href))))
             (selected (if (host-truth configuration) (await (js-call metadata :readCompilerMetadata configuration)) nil))
             (binary (/= (get (get process :env) :ELISCRIPT_ORIGINAL_TARGET) "javascript")))
        (when (and binary (not selected)) (throw (new globalThis.Error "identity/value corpus lost its selected binary artifact")))
        (js-object :root root :referenceDirectory reference-directory :product product :entry entry
          :originalEntry original-entry :reference reference :m module :configuration configuration :selected selected :binary binary
          :plain (lambda (value) (JSON/parse (JSON/stringify value)))
          :observe (lambda (script engine &rest supplied)
            (observe-original root script engine
              (if (undefined? (aref supplied 0)) (js-array) (aref supplied 0)) false t))
          :freshRuntime (async ()
            (unless selected (throw (new globalThis.Error "a raw managed heap requires its actual selected binary")))
            (let ((options (copyHostRecord (get selected :memory) (get selected :runtimeOptions)
                             (js-object :initializeModule false :nativeTarget (get selected :nativeTarget))))
                  (runtime undefined))
              (if (= (get selected :target) "wasm")
                (let ((bytes (new globalThis.Uint8Array (await (readFile (get selected :path))))))
                  (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
                  (let ((implementation (await (funcall import-module (get (pathToFileURL (resolve root "tools/backends/managed-runtime.mjs")) :href)))))
                    (setq runtime (js-call implementation :instantiateManagedRuntime bytes options))))
                (let ((implementation (await (funcall import-module (get (pathToFileURL (resolve root "tools/backends/native-managed-runtime.mjs")) :href)))))
                  (setq runtime (await (js-call implementation :instantiateNativeManagedRuntime (get selected :path)
                    (js-object :typed (get selected :typed) :descriptor (get selected :descriptor)) options)))))
              (try
                (js-call runtime :initializeModule)
                (js-call runtime :auto (get (get selected :runtimeOptions) :auto)) runtime
                (catch error
                  (try
                    (let ((close (get runtime :close))) (unless (nullish? close) (Reflect/apply close runtime (js-array))))
                    (catch ignored nil))
                  (throw error)))))))))
  (defasync openOriginalManagedRuntime ()
    (let* ((root (get (get process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (reference (get (get process :env) :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT)))
      (unless (and (host-truth root) (host-truth reference))
        (throw (new globalThis.Error "complete original managed corpus requires its independent Seed source graph")))
      (let* ((product (aref (get process :argv) 2)) (entry (aref (get process :argv) 3))
             (original-entry (get (pathToFileURL (resolve reference entry)) :href))
             (module (await (funcall import-module (get (pathToFileURL (resolve product entry)) :href))))
             (runtime undefined) (boundary-lowered undefined) (selected-input undefined))
        (unless (= (get (get process :env) :ELISCRIPT_ORIGINAL_TARGET) "javascript")
          (let ((configuration (get (get process :env) :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT)))
            (unless (host-truth configuration)
              (throw (new globalThis.Error "selected binary original corpus requires its actual runtime context")))
            (let* ((metadata (await (funcall import-module (get (pathToFileURL (resolve root "tools/backends/compiler-metadata.mjs")) :href))))
                   (input (await (js-call metadata :readCompilerMetadata configuration)))
                   (context (await (funcall import-module (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-host-context.mjs")) :href)))))
              (setq selected-input input)
              (setq runtime (get (await (js-call context :openOriginalProgramContext input (js-object :identity configuration))) :runtime))
              (setq boundary-lowered (js-object :descriptor (get input :descriptor))))))
        (js-object :root root :product product :entry entry :reference reference :originalEntry original-entry :m module
          :runtime runtime :boundaryLowered boundary-lowered :selectedInput selected-input
          :plain (lambda (value) (JSON/parse (JSON/stringify value)))
          :originalObservation (lambda (source &rest supplied)
            (observe-original root source
              (if (undefined? (aref supplied 0)) "node" (aref supplied 0))
              (if (undefined? (aref supplied 1)) (js-array) (aref supplied 1))
              (if (undefined? (aref supplied 2)) false (aref supplied 2)) false))))))
  (export openOriginalIdentityRuntime openOriginalManagedRuntime))
