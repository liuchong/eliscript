               :bun (get configuration :bun) :profile (get configuration :profile)
               :budget (get configuration :budget) :memory (get configuration :memory)
               :auto (get configuration :auto) :nativeTarget (get configuration :nativeTarget)
               :sessionOptions (get configuration :sessionOptions)
               :functionalRuntimeProfile (get configuration :functionalRuntimeProfile)
               :bootstrapManifestPath (get configuration :bootstrapManifestPath)))
             (context (js-object :artifact artifact :record record :target "javascript"
               :independentSeedProgram t
               :sourceAssets (get configuration :sourceAssets)
               :sourceRoot source-root :signal signal :options options :directory output
               :archiveProduct (async (value &rest arguments)
                 (let ((name (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0)))
                               "product" (aref arguments 0)))
