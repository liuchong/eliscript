  (defasync execute-seed-program (record configuration original-host key cache)
    (let* ((original-record record) (record (seed-authenticated-record record configuration))
           (source-root (get configuration :sourceRoot)) (directory (get configuration :directory))
           (signal (get configuration :signal))
           (output (resolve directory (execution-digest key))) (product (resolve output "product"))
