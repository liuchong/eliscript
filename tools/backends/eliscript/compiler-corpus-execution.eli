                          :outputRoot (resolve output "independent-seed-compiler")
                          :profile (fallback (get configuration :profile) "small")
                          :budget (get configuration :budget) :memory (get configuration :memory)
                          :auto (get configuration :auto) :nativeTarget (get configuration :nativeTarget)
                          :retainIR t :debug t :signal signal))))
