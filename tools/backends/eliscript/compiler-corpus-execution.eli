                   (= (get asset :sha256) (execution-digest bytes))) (native-provider-fail))
      (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode bytes)))
  (defasync ensure-local-runtime-file (directory id source)
    (let* ((segments (js-call id :split "/")) (parent directory) (index 0))
      (while (< index (1- (js-length segments)))
        (setq parent (join parent (aref segments index)))
        (await (mkdir parent (js-object :recursive t)))
        (let ((details (await (lstat parent))))
          (unless (and (js-call details :isDirectory) (not (js-call details :isSymbolicLink)))
            (throw (new globalThis.Error "original local runtime graph conflicts with emitted source"))))
        (setq index (1+ index)))
      (let ((path (resolve directory id)))
        (try (await (writeFile path source (js-object :flag "wx")))
          (catch error
            (unless (= (get error :code) "EEXIST") (throw error))
            (let ((details (await (lstat path))))
              (unless (and (js-call details :isFile) (not (js-call details :isSymbolicLink))
                           (= (await (readFile path "utf8")) source))
                (throw (new globalThis.Error "original local runtime graph conflicts with emitted source")))))))))
  (defasync configure-local-runtime-package (context)
    ;; The original host sidecars already declare the entire runtime graph.
    ;; A package self-reference must use that graph, just as relative host
    ;; imports do. Other products retain the legacy source-root package route.
    (let* ((record (get context :record)) (sources (field (get record :request) "hostSources"))
           (declared (new globalThis.Map)))
      (when (Array/isArray sources)
        (js-call sources :forEach (lambda (source)
          (when (and (= (value-type (get source :id)) "string") (= (value-type (get source :source)) "string"))
            (js-call declared :set (get source :id) (get source :source)))))
        (when (and (js-call declared :has "runtime/literals.mjs")
                   (js-call declared :has "runtime/core/queue.mjs")
                   (js-call declared :has "runtime/core/data-text.mjs"))
          (let* ((files (await (local-runtime-files (resolve (get context :sourceRoot) "runtime") "runtime")))
                 (complete (js-call files :every (lambda (id) (js-call declared :has id)))))
            (when complete
              (let* ((artifact (get context :artifact))
                     (directory (fallback (get artifact :directory) (resolve (get artifact :path) "..")))
                     (root-package (JSON/parse (await (readFile (resolve (get context :sourceRoot) "package.json") "utf8"))))
                     (root-exports (get root-package :exports))
                     (exports (Object/fromEntries (js-array (js-array "./runtime/*" "./runtime/*"))))
                     (keys (Object/keys root-exports)) (index 0))
                ;; Preserve the package's explicit runtime aliases, including
                ;; extensionless entry points. Platform capabilities require
                ;; their exact declared file and original explicit export;
                ;; no platform/compiler/browser wildcard is introduced.
                (while (< index (js-length keys))
                  (let* ((key (aref keys index)) (target (get root-exports key)))
                    (when (js-call key :startsWith "./runtime/")
                      (Object/defineProperty exports key (js-object :value target
                        :writable t :enumerable t :configurable t)))
                    (when (and (js-call key :startsWith "./platform/")
                               (not (js-call key :includes "*")) (= (value-type target) "string")
                               (js-call target :startsWith "./platform/")
                               (js-call target :endsWith ".mjs") (not (js-call target :includes "*"))
                               (js-call declared :has (js-call target :slice 2)))
                      (let ((id (js-call target :slice 2)))
                        (unless (js-call files :includes id) (js-call files :push id)))
                      (Object/defineProperty exports key (js-object :value target
                        :writable t :enumerable t :configurable t))))
                  (setq index (1+ index)))
