              (unless plan
                (await (mkdir (resolve input "..") (js-object :recursive t)))
                (await (writeFile input (get item :source))))
              (await (mkdir (resolve path "..") (js-object :recursive t)))
              (let ((arguments (js-array "--source-map" "--output" path)))
                (unless (nullish? (field (get record :request) "portableEntries"))
