                                 "javascript" (aref arguments 1))))
                   (await (archiveProduct value target (resolve output name))))))))
        ;; Enter the same maintained prelaunch path as the selected product.
        ;; It installs only authentic declared runtime bytes and exact tools.
        (if (or (= (field (field record "execution") "kind") "compiler-session-program")
                (not (original-host-enabled (field (field record "execution") "compilerGenerations"))))
