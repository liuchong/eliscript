                  (try (await (writeFile path source (js-object :flag "wx")))
                    (catch error
                      (unless (= (get error :code) "EEXIST") (throw error))
                      (let ((details (await (lstat path))))
                        (unless (and (js-call details :isFile) (not (js-call details :isSymbolicLink))
                                     (= (await (readFile path "utf8")) source))
                          (throw (new globalThis.Error "original local runtime package conflicts with emitted source"))))))))))))))
  (defun sequence-result-needed (steps start id)
    ;; Original recipes are data. Inspect descriptors rather than evaluating a
    ;; later accessor ahead of its request. Opaque/large inputs conservatively
    ;; retain the response and follow the original evaluator's error order.
    (let ((pending (js-array)) (seen (new globalThis.WeakSet)) (needed false) (index start) (visits 0))
      (try
        (progn
          (while (< index (js-length steps))
            (let ((descriptors (Object/getOwnPropertyDescriptors (aref steps index))))
              (js-call (js-array "request" "sameFieldsAs") :forEach (lambda (key)
                (let ((descriptor (get descriptors key)))
                  (when descriptor
                    (if (Object/hasOwn descriptor "value") (js-call pending :push (get descriptor :value))
                      (setq needed t)))))))
            (setq index (1+ index)))
          (while (and (not needed) (> (js-length pending) 0))
            (let ((value (js-call pending :pop)))
              (when (and (not (nullish? value)) (= (value-type value) "object") (not (js-call seen :has value)))
                (js-call seen :add value) (setq visits (1+ visits))
                (if (> visits 4096) (setq needed t)
                  (let* ((descriptors (Object/getOwnPropertyDescriptors value)) (keys (Object/keys descriptors)) (position 0)
                         (prototype (Object/getPrototypeOf value)))
                    (unless (or (eq prototype nil) (eq prototype (get globalThis.Object :prototype))
                                (and (Array/isArray value) (eq prototype (get globalThis.Array :prototype))))
                      (setq needed t))
                    (when (Array/isArray value)
                      (let ((length (get (get descriptors "length") :value)) (at 0))
                        (while (and (not needed) (< at length))
                          (unless (Object/hasOwn descriptors (funcall globalThis.String at)) (setq needed t))
                          (setq at (1+ at)))))
                    (while (and (not needed) (< position (js-length keys)))
                      (let* ((key (aref keys position)) (descriptor (get descriptors key)))
                        (when (get descriptor :enumerable)
                          (if (not (Object/hasOwn descriptor "value")) (setq needed t)
                            (let ((item (get descriptor :value)))
                              (when (or (and (= key "$compilerCorpusRef") (= (value-type item) "string")
                                             (= (aref (js-call item :split ".") 0) id))
                                        (and (= key "step") (= item id)))
                                (setq needed t))
                              (js-call pending :push item)))))
                      (setq position (1+ position)))))))))
        (catch error (setq needed t))) needed))
  (defun release-sequence-results (results steps start)
    (js-call results :forEach (lambda (value id)
      (unless (sequence-result-needed steps start id) (js-call results :delete id)))))
  (defasync check-required-managed-imports (context)
    (let* ((record (get context :record)) (execution (field record "execution"))
           (target (get context :target)))
      (when (and (not (Object/hasOwn context "failure"))
                 (= (field execution "kind") "original-program")
                 (Object/hasOwn execution "requiredManagedImports")
                 (or (= target "wasm") (= target "native")))
        ;; This is the exact existing sequence/usage print contract, never an
        ;; open-ended allow-host-capabilities switch. It precedes host launch.
        (let* ((names (js-array "source-operation" "console-log-capture" "console-log"))
               (expected (js-call names :map (lambda (name)
                 (js-object :name name :module "eliscript.host" :arity 2 :abi "managed-host-call-v1"))))
               (artifact (get context :artifact)))
          (js-call assert :deepStrictEqual (get execution :requiredManagedImports) expected)
          (js-call assert :deepStrictEqual (get (get artifact :descriptor) :hostCapabilities) expected)
          (when (= target "wasm")
            (let ((imports (globalThis.WebAssembly.Module.imports
                    (new globalThis.WebAssembly.Module (new globalThis.Uint8Array (await (readFile (get artifact :path))))))))
              (js-call assert :deepStrictEqual
                (js-call imports :map (lambda (item)
                  (js-object :module (get item :module) :name (get item :name) :kind (get item :kind))))
                (js-call names :map (lambda (name)
                  (js-object :module "eliscript.host" :name name :kind "function"))))
              (js-call imports :forEach (lambda (item)
                (when (Object/hasOwn item "type")
                  (js-call assert :deepStrictEqual (get item :type)
                    (js-object :parameters (js-array "i32" "i32") :results (js-array "i32"))))))))))))
  (defasync execute-js-unicode-profile (context)
    (let* ((record (get context :record)) (artifact (get context :artifact))
           (options (fallback (get context :options) (js-object)))
           (source-root (get context :sourceRoot)) (directory (get context :directory))
           (profile (get (get record :execution) :profile))
           (modules (join (resolve (get artifact :path) "..") "node_modules"))
           (profile-path (resolve directory "unicode-profile.json")))
      ;; Preserve the original actual-product package environment. Only this
      ;; explicitly versioned case selects a profile, in its own process.
      (await (mkdir modules (js-object :recursive t)))
      (try (await (symlink (resolve source-root) (join modules "eliscript") "dir"))
        (catch error (unless (= (get error :code) "EEXIST") (throw error))))
      (await (mkdir directory (js-object :recursive t)))
      (await (writeFile profile-path (JSON/stringify profile)))
      (let* ((command (fallback (get options :node) "node"))
             (host (resolve source-root "tools/backends/compiler-unicode-profile-host.mjs"))
             (stdout (await (seed-child-output command
               (js-array host (resolve (get artifact :path)) profile-path) source-root (get context :signal) directory context)))
             (observation (JSON/parse stdout)))
        (js-call assert :deepStrictEqual observation (js-object :kind "unicode-profile" :expectedSatisfied t
          :version (get profile :version) :checked 1112064 :sigmaCases (js-length (get profile :sigma))
          :hashes (js-object :upper (get profile :upper) :lower (get profile :lower))))
        observation)))

  (defasync prepareOriginalToolsCLIContext (context)
    (let* ((record (get context :record)) (id (field record "id"))
           (ids (js-array "original-tools-artifact:compiler-session-tools:node"
                          "original-tools-artifact:compiler-session-tools:bun")))
      (if (or (Object/hasOwn context "failure") (/= (get context :target) "javascript")
              (not (js-call ids :includes id))) context
        (let* ((original (get record :original)) (execution (get record :execution))
               (declaration (get original :toolsCLITransport))
               (assets (field declaration "sourceAssets"))
               (files (js-array "tools/backends/eliscript/compiler-corpus-tools-cli.eli"
                                "tools/backends/compiler-corpus-tools-cli.mjs"))
               (source-root (get context :sourceRoot)) (host (get execution :hostSource))
               (manifest (field (get context :options) "bootstrapManifestPath"))
               (seen (new globalThis.Set)) (index 0))
          (unless (and (= (get execution :kind) "compiler-session-program")
                       (= (get original :suite) "tests/compiler-session-tools.test.mjs")
                       (= (get original :host) "tests/compiler-session-tools.test.mjs")
                       (= (get (get execution :setupReplacement) :kind) "selected-complete-compiler-artifacts")
                       (= (field declaration "kind") "original-tools-final-cli")
                       (Array/isArray assets) (= (js-length assets) 2)
                       (= (value-type host) "string") (= (value-type manifest) "string")
                       (> (js-length manifest) 0) (Array/isArray (get context :sourceAssets)))
            (throw (new globalThis.TypeError "original tools CLI requires explicit final-stage transport and source evidence")))
          (while (< index (js-length assets))
            (let* ((proof (aref assets index)) (file (get proof :file))
                   (archive (js-call (get context :sourceAssets) :find (lambda (item) (= (get item :file) file))))
                   (bytes (await (readFile (resolve source-root file)))))
              (unless (and (js-call files :includes file) (not (js-call seen :has file)) archive
                           (= (get proof :sourceSha256) (execution-digest bytes))
                           (= (get archive :sha256) (execution-digest bytes))
                           (= (get archive :encoding) "base64") (= (get archive :bytes) (js-length bytes))
                           (= (get archive :content) (js-call bytes :toString "base64"))
                           (= (await (realpath (resolve source-root file))) (resolve (await (realpath source-root)) file)))
                (throw (new globalThis.TypeError "original tools CLI source evidence differs from its real transport")))
              (js-call seen :add file))
            (setq index (1+ index)))
          (let* ((before (JSON/stringify (resolve source-root "tools/backends/compiler-cli.mjs")))
                 (after (JSON/stringify (resolve source-root "tools/backends/compiler-corpus-tools-cli.mjs")))
                 (at (js-call host :indexOf before))
                 (artifact (get context :artifact))
                 (directory (fallback (get artifact :directory) (resolve (get artifact :path) "..")))
                 (configuration (resolve directory "__eliscript_original_compiler_session.json"))
                 (projected (str (js-call host :slice 0 at) after (js-call host :slice (+ at (js-length before)))))
                 (proof (js-object :kind "original-tools-final-cli" :version 1 :recordId id
                   :sourceRoot source-root :configurationPath configuration
                   :producerPath (resolve directory (get artifact :path))
                   :supportingDirectory (resolve (get context :directory) "original-tool-products")
                   :bootstrapManifestPath (await (realpath manifest)) :sourceAssets assets
                   :originalHostSha256 (execution-digest host) :transportHostSha256 (execution-digest projected)
                   :before before :after after)))
            (unless (and (>= at 0) (= (js-call host :indexOf before (1+ at)) -1))
              (throw (new globalThis.TypeError "original tools CLI path token changed")))
            (await (saveCompilerMetadata (resolve directory "__eliscript_tools_cli_projection.json") proof))
            (unless (nullish? (get context :transportEvidence))
              (put (get context :transportEvidence) :originalToolsCLI proof))
            (copy context (js-object :record (copy record
              (js-object :execution (copy execution (js-object :hostSource projected)))))))))))

  (defasync prepareOriginalToolsDataReferenceContext (context)
