                 (token (aref matches 0)) (before (field token "text"))
                 (module-file "tools/backends/compiler-corpus-tools-reference.mjs")
                 (after (JSON/stringify (get (pathToFileURL (resolve source-root module-file)) :href))))
            (unless (and (= (js-length matches) 1) (= (js-call host :indexOf before (1+ (js-call host :indexOf before))) -1))
              (throw (new globalThis.TypeError "original tools child-process import changed")))
            (let* ((projected (js-call host :replace before after)) (artifact (get context :artifact))
                   (directory (fallback (get artifact :directory) (resolve (get artifact :path) "..")))
                   (proof (js-object :kind "original-tools-data-reference" :version 1 :recordId id
                     :sourceRoot source-root :configurationPath (resolve directory "__eliscript_original_compiler_session.json")
                     :sourceAssets assets :moduleFile module-file :runtimeFile "runtime/unicode-case.mjs"
                     :runtimeSha256 (execution-digest (await (readFile (resolve source-root "runtime/unicode-case.mjs"))))
                     :originalHostSource original-host :originalHostSha256 (execution-digest original-host)
                     :transportHostSha256 (execution-digest projected)
                     :importSites (js-array "compile" "aggregate-error" "edit-preview"))))
              (await (saveCompilerMetadata (resolve directory "__eliscript_tools_data_reference.json") proof))
              (when (get context :transportEvidence)
                (put (get context :transportEvidence) :originalToolsDataReference proof))
              (copy context (js-object :record (copy record
                (js-object :execution (copy execution (js-object :hostSource projected))))))))))))

  (defasync execute-compiler-corpus-record (context)
    (setq context (await (prepareOriginalToolsCLIContext context)))
    (setq context (await (prepareOriginalToolsDataReferenceContext context)))
    (let* ((record (field (Object/getOwnPropertyDescriptor context "record") "value"))
           (execution (and record (field (Object/getOwnPropertyDescriptor record "execution") "value"))))
      ;; No marker means no added await, artifact access or caller getter read.
      (when (and execution (Object/hasOwn execution "requiredManagedImports"))
        (await (check-required-managed-imports context)))
      (when (and execution (not (Object/hasOwn context "failure"))
                 (Object/hasOwn execution "hostToolProjection")
                 (= (field execution "kind") "original-program"))
        (await (project-original-host-tools context))))
    ;; A target-specific original host is explicit archived source data. The
    ;; binary host and its raw-ABI assertions remain the untouched capability.
    (when (and (= (get context :target) "javascript") (not (Object/hasOwn context "failure"))
               (= (field (get (get context :record) :execution) "kind") "original-program")
               (not (undefined? (field (get (get context :record) :execution) "javascriptHostSource"))))
      (let* ((record (get context :record)) (execution (get record :execution))
             (source (get execution :javascriptHostSource)))
        (unless (= (value-type source) "string")
          (throw (new globalThis.TypeError "original JavaScript host capability must retain its complete source")))
        (setq context (copy context (js-object :record (copy record
          (js-object :execution (copy execution (js-object :hostSource source)))))))))
    (when (and (not (Object/hasOwn context "failure")) (= (get context :target) "javascript")
               (= (field (get (get context :record) :execution) "kind") "original-program"))
      (await (configure-local-runtime-package context)))
    (if (or (Object/hasOwn context "failure") (not (exports-sequence-p context)))
      (if (and (not (Object/hasOwn context "failure")) (= (get context :target) "javascript")
               (= (field (get (get context :record) :execution) "kind") "unicode-profile"))
        (await (execute-js-unicode-profile context))
        (let ((kind (field (get (get context :record) :execution) "kind")))
          (cond
            ((and (not (Object/hasOwn context "failure")) (= kind "original-program"))
              (await (executeOriginalProgram context)))
            ((and (not (Object/hasOwn context "failure")) (= kind "compiler-session-program"))
              (await (executeCompilerSessionProgram context)))
            (t (await (js-call legacy :executeCompilerCorpusRecord context))))))
      (let* ((record (get context :record)) (options (fallback (get context :options) (js-object)))
             (resources (independentCompilerResources options)) (configured (copy context (js-object :options options)))
             (results (new globalThis.Map)) (products (new globalThis.Map)) (observations (js-array))
             (satisfied t) (steps (get record :steps)) (index 0))
        (while (< index (js-length steps))
          (let ((step (aref steps index)) (evidence (js-object)))
            (try (js-call observations :push (await (execute-step configured step results products resources evidence)))
              (catch error
                (when (field (get context :signal) "aborted") (throw (if (undefined? (get (get context :signal) :reason)) error (get (get context :signal) :reason))))
                (setq satisfied false) (js-call observations :push (js-object :id (get step :id) :status "failed" :error (export-diagnostic error evidence))))))
          (release-sequence-results results steps (1+ index))
          (setq index (1+ index)))
        (js-object :kind "sequence" :expectedSatisfied satisfied :identity observations))))
  (defun prepareOriginalProgramProcessLifetime (context)
    (let ((record (get context :record)))
      (if (or (Object/hasOwn context "failure")
              (not (js-call (js-array "wasm" "native") :includes (get context :target)))
              (/= (field record "id") "original-program:macro-generated-names-node")) context
        (let ((execution (get record :execution)))
          (unless (and (= (get execution :kind) "original-program")
                       (= (get execution :hostRuntime) "node")
                       (= (get execution :host) "tests/__eliscript_original_generated_names_node.mjs")
                       (= (value-type (get execution :hostSource)) "string")
                       (= (field (get record :original) "suite") "tests/macro-generated-names.test.mjs"))
            (throw (new globalThis.TypeError "original macro Node process lifetime boundary changed")))
          ;; Only this private execution copy changes. The raw record, source
          ;; proof, expected output and entire original host remain unchanged.
          (copy context (js-object :record (copy record (js-object :execution
            (copy execution (js-object :runtimeOptions
              (copy (get execution :runtimeOptions) (js-object :originalHostLifetime "process"))))))))))))
  (defasync executeCompilerCorpusRecord (context)
    (when (and (not (Object/hasOwn context "failure")) (originalSequenceNativeInteropP (get context :record)))
      (let ((record (transportOriginalSequenceRuntime (get context :record)
                      (await (loadLiteralSources (js-object :sourceRoot (get context :sourceRoot)))))))
        (setq context (copy context (js-object :record record)))))
    (setq context (await (prepareCompilerCorpusSourceMapContext context)))
    (let* ((acceptance (compilerCorpusRuntimeAcceptance (get context :record) (get context :options)))
           (configured (await (prepareCompilerCorpusNativeProviders context)))
           (provider (if (eq configured context) undefined (get configured :nativeProviderIdentity))))
      (setq configured (prepareCompilerCorpusRuntimeContext configured acceptance))
      (setq configured (await (prepareOriginalLiteralHostProvider configured)))
      (setq configured (prepareOriginalProgramProcessLifetime configured))
      (let ((observation (await (execute-compiler-corpus-record configured))))
        (unless (undefined? acceptance) (setq observation (copy observation acceptance)))
        (if (undefined? provider) observation
          (copy observation (js-object :nativeProviderIdentity provider))))))
  (defconst prepareOriginalSeedCorpusRecord seed-authenticated-record)
  (export prepareOriginalSeedCorpusRecord resolveOriginalCorpusRequest originalProgramArguments createOriginalSeedOracle executeCompilerCorpusRecord
    executeIsolatedCompilerCorpusExports decodeCompilerCorpusObservation compilerCorpusRuntimeAcceptance prepareCompilerCorpusRuntimeContext prepareOriginalToolsCLIContext prepareCompilerCorpusNativeProviders prepareCompilerCorpusSourceMapContext
    prepareOriginalProgramProcessLifetime prepareOriginalToolsDataReferenceContext compareCompilerCorpusObservation))
