(module tools.backends.compiler-corpus-execution
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdir mkdtemp readdir lstat realpath symlink copyFile)
  (import "node:fs" constants)
  (import "node:path" resolve join relative isAbsolute sep posix)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "./compiler-corpus-execution-legacy.mjs" :as legacy)
  (import "./compiler-build.mjs" independentCompilerResources buildIndependentCompiler compilerMetadataDigest)
  (import "./compiler-corpus.mjs" prepareOriginalSeedSources originalSequenceNativeInteropP transportOriginalSequenceRuntime
    compilerCorpusRequest compilerCorpusFunctionalResources bindOriginalFunctionalResourceInputs)
  (import "./build.mjs" loadLiteralSources)
  (import "./compiler-bootstrap.mjs" openCompilerArtifact saveCompilerMetadata)
  (import "./compiler-matrix.mjs" archiveProduct)
  (import "./managed-runtime.mjs" instantiateManagedRuntimeWithHostModules loadManagedHostModules)
  (import "./native-managed-runtime.mjs" instantiateNativeManagedRuntime snapshotNativeManagedRuntimeABI)
  (import "./compiler-corpus-literal-provider.mjs" prepareOriginalLiteralHostProvider)
  (import "./compiler-corpus-original-program.mjs" executeOriginalProgram executeCompilerSessionProgram)
  (import "./compiler-corpus-process.mjs" originalCorpusExecutionPolicy runOriginalCorpusProcess)
  (import "../../dist/bootstrap/reader.mjs" read-string)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "../../bootstrap/host/bun.mjs" loadCompiler)
  (defconst resolveOriginalCorpusRequest (get legacy :resolveOriginalCorpusRequest))
  (defconst originalProgramArguments (get legacy :originalProgramArguments))
  (defconst compareCompilerCorpusObservation (get legacy :compareCompilerCorpusObservation))
  (defun field (value key) (if (nullish? value) undefined (get value key)))
  (defun fallback (value other) (if (nullish? value) other value))
  (defun execution-digest (bytes)
    (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun original-host-enabled (value)
    (and (not (nullish? value)) (not (eq value false)) (not (eq value 0))
      (not (eq value "")) (not (and (= (value-type value) "number") (Number/isNaN value)))))
  (defun seed-original-host (record configuration)
    (let ((host (field (field record "execution") "hostRuntime")))
      (if (not (nullish? host)) host
        (if (or (= (get configuration :programHost) "bun")
                (original-host-enabled (field (field record "execution") "requiresBun"))) "bun" "node"))))

  (defasync seed-child-output (command arguments source-root signal evidence-root &optional context)
    ;; Stream the original independent command's IO through the same owner.
    (await (mkdir evidence-root (js-object :recursive t)))
    (let* ((directory (await (mkdtemp (resolve evidence-root "process-"))))
           (configured (fallback context (js-object :record (js-object :execution (js-object))
                         :target "javascript" :options (js-object))))
           (receipt (await (runOriginalCorpusProcess command arguments
             (js-object :cwd source-root :signal signal :directory directory
               :caseId (field (get configured :record) "id") :target (get configured :target)
               :sourceIdentity (get configured :sourceIdentity)
               :policy (originalCorpusExecutionPolicy configured))))))
      (get receipt :stdout)))

  (defun seed-project-groups (record)
    (let* ((request (field record "request")) (portable (field request "portableEntries"))
           (groups (new globalThis.Map)) (by-id (new globalThis.Map))
           (pruned (not (nullish? portable))))
      (when pruned
        (unless (and (Array/isArray portable) (> (js-length portable) 0)
                     (js-call portable :every (lambda (name)
                       (and (= (value-type name) "string") (> (js-length name) 0)))))
          (throw (new globalThis.TypeError "original Seed portable entries must retain their entry names"))))
      (when (or pruned (= (field request "resolveImports") t))
        (js-call (get record :modules) :forEach (lambda (item)
          (let ((id (get item :id)) (filename (get item :filename)))
            (when (and (= (value-type id) "string") (= (value-type filename) "string")
                       (js-call id :endsWith ".mjs"))
              (let ((source-id (str (js-call id :slice 0 -4) ".eli")))
                ;; The existing Seed project builder retains original source
                ;; paths. Use it only when that real source root yields exactly
                ;; the record's declared output IDs, never a guessed relocation.
                (when (or (= filename source-id) (js-call filename :endsWith (str "/" source-id)))
                  (let* ((prefix (js-call filename :slice 0 (- (js-length filename) (js-length source-id))))
                         (group (js-call groups :get prefix)))
                    (unless group
                      (setq group (js-object :prefix prefix :records (js-array)))
                      (js-call groups :set prefix group))
                    (js-call (get group :records) :push item) (js-call by-id :set id group))))))))
        (let ((entry-group (js-call by-id :get (get record :entry))))
          (when (and pruned (not entry-group) (/= (js-length (get record :modules)) 1))
            (throw (new globalThis.TypeError "original Seed portable source and output layouts differ")))
          (unless (and pruned (not entry-group))
            (js-object :groups groups :byId by-id :portableEntries portable :entryGroup entry-group :pruned pruned))))))

  (defun seed-relative-path (value)
    (unless (and (= (value-type value) "string") (> (js-length value) 0) (not (isAbsolute value))
                 (not (js-call value :includes "\\")) (not (js-call value :includes ":"))
                 (not (js-call value :includes "\u0000"))
                 (not (js-call (js-call value :split "/") :some
                   (lambda (part) (or (= part "") (= part ".") (= part ".."))))))
      (throw (new globalThis.TypeError "original Seed source identities must remain relative to their archive"))) value)

  (defun seed-authenticated-record (record configuration)
    ;; Use the same verified source declarations as the selected request, not
    ;; its compiled response. The original record and its source identities
    ;; remain immutable; only this independent compiler's private layout changes.
    (if (undefined? (get configuration :sourceAssets)) record
      (let* ((proofs (js-object :sourceAssets (get configuration :sourceAssets)
                       :literalSources (get configuration :literalSources)
                       :literalSourceIdentity (get configuration :literalSourceIdentity)))
             (retained (field (get record :original) "functionalResourceInputs")))
        ;; Authenticate the original complete input before resolving its private
        ;; Seed graph. An altered original proof can never be refreshed away.
        (when retained
          (compilerCorpusFunctionalResources record (js-object :functionalRuntimeProfile "small")))
        (let ((request (prepareOriginalSeedSources record proofs)))
          (if (or (nullish? request) (not (= (get request :resolveImports) t))) record
            (let* ((original (get record :original))
                   (private (copy record (js-object :modules (get request :modules) :request request
                     :original (copy original)))))
              (when retained
                ;; The existing archive binder verifies every expanded module
                ;; and the complete original host against actual source bytes.
                ;; Only this independently resolved record receives its proof.
                (bindOriginalFunctionalResourceInputs (js-object :evidence (get configuration :sourceAssets)
                  :records (js-array private))))
              private))))))

  (defun seed-host-tokens (source)
    ;; Source-data scanning only: preserve the original suite scanner's opaque
    ;; strings/comments/regular expressions. Never execute the host to discover
    ;; imports or mistake text inside a fixture literal for another entry.
    (let ((result (js-array)) (at 0)
          (identifier (new globalThis.RegExp "^[$A-Z_a-z][$\\w]*"))
          (number (new globalThis.RegExp "^(?:0[xob][0-9a-f_]+|[0-9][0-9_.]*(?:e[+-]?[0-9_]+)?)" "i")))
      (while (< at (js-length source))
        (let* ((start at) (character (aref source at)) (previous (js-call result :at -1)))
          (cond
            ((js-call (new globalThis.RegExp "\\s") :test character) (setq at (1+ at)))
            ((and (= character "/") (= (aref source (1+ at)) "/"))
             (while (and (< at (js-length source)) (/= (aref source at) "\n")) (setq at (1+ at))))
            ((and (= character "/") (= (aref source (1+ at)) "*"))
             (let ((end (js-call source :indexOf "*/" (+ at 2))))
               (when (< end 0) (throw (new globalThis.TypeError "unterminated original Seed host comment")))
               (setq at (+ end 2))))
            ((or (= character "\"") (= character "'") (= character "`"))
             (setq at (1+ at))
             (let ((closed false))
               (while (and (< at (js-length source)) (not closed))
                 (let ((next (aref source at)))
                   (setq at (1+ at))
                   (cond ((= next "\\") (setq at (1+ at))) ((= next character) (setq closed t)))))
               (unless closed (throw (new globalThis.TypeError "unterminated original Seed host string"))))
             (js-call result :push (js-object :type "string" :text (js-call source :slice start at))))
            ((and (= character "/")
               (or (nullish? previous)
                 (and (not (js-call (js-array "identifier" "number" "string") :includes (field previous "type")))
                      (not (js-call (js-array ")" "]" "}") :includes (field previous "text"))))
                 (and (= (field previous "type") "identifier")
                   (js-call (js-array "return" "throw" "case" "yield" "await") :includes (field previous "text")))))
             (setq at (1+ at))
             (let ((bracket false) (closed false))
               (while (and (< at (js-length source)) (not closed))
                 (let ((next (aref source at))) (setq at (1+ at))
                   (cond ((= next "\\") (setq at (1+ at))) ((= next "[") (setq bracket t))
                     ((= next "]") (setq bracket false)) ((and (= next "/") (not bracket)) (setq closed t)))))
               (unless closed (throw (new globalThis.TypeError "unterminated original Seed host regular expression"))))
             (while (and (< at (js-length source)) (js-call (new globalThis.RegExp "[a-z]" "i") :test (aref source at)))
               (setq at (1+ at)))
             (js-call result :push (js-object :type "regexp" :text (js-call source :slice start at))))
            (t
             (let* ((rest (js-call source :slice at)) (word (js-call identifier :exec rest))
                    (digits (unless word (js-call number :exec rest))))
               (cond (word (setq at (+ at (js-length (aref word 0))))
                      (js-call result :push (js-object :type "identifier" :text (aref word 0))))
                 (digits (setq at (+ at (js-length (aref digits 0))))
                   (js-call result :push (js-object :type "number" :text (aref digits 0))))
                 (t (setq at (1+ at)) (js-call result :push (js-object :type "punctuation" :text character)))))))))
      result))

  (defun seed-host-string (token)
    (when (and token (= (get token :type) "string") (/= (aref (get token :text) 0) "`"))
      (let ((source (get token :text)) (value "") (at 1)
            (escapes (js-object :n "\n" :r "\r" :t "\t" :b "\b" :f "\f" :v "\u000b" :0 "\u0000")))
        (while (< at (1- (js-length source)))
          (let ((character (aref source at)))
            (when (= character "\\")
              (setq at (1+ at)) (setq character (aref source at))
              (cond ((Object/hasOwn escapes character) (setq character (get escapes character)))
                ((= character "\n") (setq character ""))
                ((= character "\r") (when (= (aref source (1+ at)) "\n") (setq at (1+ at))) (setq character ""))
                ((or (= character "u") (= character "x"))
                 (let* ((count (if (= character "u") 4 2)) (hex (js-call source :slice (1+ at) (+ at count 1))))
                   (unless (js-call (new globalThis.RegExp (+ "^[0-9a-f]{" count "}$") "i") :test hex)
                     (throw (new globalThis.TypeError "unsupported original Seed host import escape")))
                   (setq character (String/fromCharCode (Number/parseInt hex 16))) (setq at (+ at count))))))
            (setq value (+ value character)))
          (setq at (1+ at))) value)))

  (defun seed-declared-host-provider-p (record path)
    ;; A real .mjs import denotes the declared host asset, even when a
    ;; managed literal implementation has the same physical output stem.
    ;; This predicate is used only while preparing the independent graph;
    ;; explicit entries and .eli source imports still compile their producers.
    (and (js-call path :endsWith ".mjs")
      (js-call (fallback (field (get record :request) "hostSources") (js-array)) :some
        (lambda (provider)
          (and (= (value-type (field provider "source")) "string")
            (= (field provider "id") path))))))

  (defun seed-host-source-entries (record by-id by-file outputs)
    (let* ((execution (get record :execution)) (source (field execution "hostSource"))
           (host (field execution "host")) (result (js-array)))
      (when (and (= (value-type source) "string") (> (js-length source) 0)
                 (= (value-type host) "string"))
        (let ((tokens (seed-host-tokens source)) (index 0))
          (while (< index (js-length tokens))
            (when (and (= (field (aref tokens index) "text") "import")
                       (/= (field (aref tokens (1- index)) "text") "."))
              (let* ((next (field (aref tokens (1+ index)) "text"))
                     (token (aref tokens (1+ index))))
                (cond
                  ((= next "(")
                   (setq token (aref tokens (+ index 2)))
                   (if (= (field token "type") "string")
                     (unless (= (field (aref tokens (+ index 3)) "text") ")") (setq token undefined))
                     (if (and (= (field token "text") "new")
                              (= (field (aref tokens (+ index 3)) "text") "URL")
                              (= (field (aref tokens (+ index 4)) "text") "(")
                              (= (field (aref tokens (+ index 6)) "text") ",")
                              (= (field (aref tokens (+ index 7)) "text") "import")
                              (= (field (aref tokens (+ index 8)) "text") ".")
                              (= (field (aref tokens (+ index 9)) "text") "meta")
                              (= (field (aref tokens (+ index 10)) "text") ".")
                              (= (field (aref tokens (+ index 11)) "text") "url")
                              (= (field (aref tokens (+ index 12)) "text") ")")
                              (= (field (aref tokens (+ index 13)) "text") ")"))
                       (setq token (aref tokens (+ index 5))) (setq token undefined))))
                  ((= next ".") (setq token undefined))
                  ((/= (field token "type") "string")
                   (let ((cursor (+ index 1)))
                     (setq token undefined)
                     (while (and (< cursor (js-length tokens))
                                 (/= (field (aref tokens cursor) "text") ";") (undefined? token))
                       (when (= (field (aref tokens cursor) "text") "from")
                         (setq token (aref tokens (1+ cursor))))
                       (setq cursor (1+ cursor))))))
                (let ((specifier (seed-host-string token)))
                  (when (and (= (value-type specifier) "string") (js-call specifier :startsWith "."))
                    (let* ((path (js-call posix :normalize (js-call posix :join (js-call posix :dirname host) specifier)))
                           (id (if (js-call path :endsWith ".eli") (+ (js-call path :slice 0 -4) ".mjs") path))
                           (item (unless (seed-declared-host-provider-p record path)
                             (or (js-call by-id :get id) (js-call by-file :get path) (js-call outputs :get path)))))
                      (when item (js-call result :push (get item :id))))))))
            (setq index (1+ index))))) result))

  (defun seed-source-entries (record by-id by-file outputs entries)
    ;; Seed's project CLI follows .eli files; source .mjs imports denote host
    ;; files to that CLI even when this request declares their actual .eli
    ;; producers. Explicitly compile only the declared reachable producers.
    ;; Resolve physical source paths first, then the request's virtual IDs;
    ;; the existing authenticated output aliases preserve both layouts.
    (let ((pending (js-call entries :slice)) (seen (new globalThis.Set)) (result (js-array)) (index 0))
      (while (< index (js-length pending))
        (let* ((id (aref pending index)) (item (js-call by-id :get id)))
          (unless item (throw (new globalThis.TypeError "original Seed entry is outside its authenticated source graph")))
          (unless (js-call seen :has id)
            (js-call seen :add id) (js-call result :push id)
            (let ((forms (read-string (get item :source) (get item :filename))))
              (while (> (js-length forms) 0)
                (let* ((form (js-call forms :shift)) (children (get form :items))
                       (head (and (Array/isArray children) (> (js-length children) 0) (get (aref children 0) :name))))
                  (cond
                    ((= head "module")
                     (Reflect/apply (get forms :push) forms (js-call children :slice 2)))
                    ((or (= head "import") (= head "import-portable"))
                     (let ((specifier (get (aref children 1) :value)))
                       (when (and (= (value-type specifier) "string") (js-call specifier :startsWith "."))
                         (let* ((physical (js-call posix :normalize (js-call posix :join
                                           (js-call posix :dirname (get item :filename)) specifier)))
                                (virtual (js-call posix :normalize (js-call posix :join
                                          (js-call posix :dirname id) specifier)))
                                (dependency (unless (seed-declared-host-provider-p record physical)
                                  (or (js-call by-file :get physical) (js-call outputs :get physical)
                                      (js-call by-id :get physical) (js-call by-id :get virtual)
                                      (js-call by-file :get virtual) (js-call outputs :get virtual)))))
                           (when dependency (js-call pending :push (get dependency :id)))))))))))))
        (setq index (1+ index)))
      result))

  (defasync seed-authenticated-source-graph (record output product source-root signal)
    (let* ((records (get record :modules)) (request (get record :request))
           (by-id (new globalThis.Map)) (by-file (new globalThis.Map))
           (outputs (new globalThis.Map)) (index 0) (compiled (js-array))
           (arguments (js-array "--no-cache" "--root" (resolve output "sources") "--out-dir" product)))
      (while (< index (js-length records))
        (let* ((item (aref records index)) (id (seed-relative-path (get item :id)))
               (filename (seed-relative-path (get item :filename))) (source (get item :source))
               (destination (+ (js-call filename :slice 0 -4) ".mjs")))
          (unless (and (js-call filename :endsWith ".eli") (js-call id :endsWith ".mjs")
                       (= (value-type source) "string") (not (js-call by-id :has id))
                       (not (js-call by-file :has filename)))
            (throw (new globalThis.TypeError "original Seed requires distinct complete authenticated source modules")))
          (js-call by-id :set id item) (js-call by-file :set filename item)
          (js-call outputs :set destination item)
          (let ((input (resolve output "sources" filename)))
            (await (mkdir (resolve input "..") (js-object :recursive t)))
            (await (writeFile input source))))
        (setq index (1+ index)))
      (let ((portable (get request :portableEntries))
            (entries (fallback (get request :entries) (js-array (get record :entry)))))
        (unless (and (Array/isArray entries) (> (js-length entries) 0))
          (throw (new globalThis.TypeError "original Seed requires its declared project entries")))
        (when (undefined? portable)
          ;; An unchanged original host can import a declared module which is
          ;; not reachable from the program entry. Retain only those literal
          ;; host edges; unrelated declared inputs remain uncompiled.
          (setq entries (seed-source-entries record by-id by-file outputs
            (js-call entries :concat (seed-host-source-entries record by-id by-file outputs)))))
        (unless (undefined? portable)
          (unless (and (Array/isArray portable) (> (js-length portable) 0)
                       (js-call portable :every (lambda (name) (and (= (value-type name) "string") (> (js-length name) 0)))))
            (throw (new globalThis.TypeError "original Seed portable entries must retain their entry names")))
          (js-call portable :forEach (lambda (name) (js-call arguments :push "--portable" name)))
          (setq entries (js-array (get record :entry))))
        (js-call entries :forEach (lambda (id)
          (let ((item (js-call by-id :get id)))
            (unless item (throw (new globalThis.TypeError "original Seed entry is outside its authenticated source graph")))
            (js-call arguments :push (resolve output "sources" (get item :filename)))))))
      (await (seed-child-output (resolve source-root "bin/eliscript-seed-build") arguments source-root signal output))
      (let* ((bytes (await (readFile (resolve product "eliscript-project.json"))))
             (manifest (JSON/parse (js-call bytes :toString "utf8"))) (seen (new globalThis.Set)))
        (unless (and (= (get manifest :format) "eliscript-project") (Array/isArray (get manifest :modules)))
          (throw (new globalThis.Error "original Seed project manifest is missing")))
        (await (writeFile (resolve output "seed-project-0.json") bytes))
        (setq index 0)
        (while (< index (js-length (get manifest :modules)))
          (let* ((emitted (aref (get manifest :modules) index)) (id (seed-relative-path (get emitted :output)))
                 (item (js-call outputs :get id)) (path (resolve product id))
                 (map (resolve product (seed-relative-path (get emitted :sourceMap)))))
            (unless (and item (not (js-call seen :has id)) (= (get emitted :source) (get item :filename))
                         (= (get emitted :sourceDigest) (execution-digest (js-call Buffer :from (get item :source) "utf8")))
                         (= (get emitted :outputDigest) (execution-digest (await (readFile path))))
                         (= (get emitted :sourceMapDigest) (execution-digest (await (readFile map)))))
              (throw (new globalThis.Error "original Seed project output identity differs from its authenticated graph")))
            (js-call seen :add id)
            (let* ((alias-id (get item :id)) (alias (resolve product alias-id)))
              (when (/= alias-id id)
                (when (or (js-call outputs :has alias-id)
                          (js-call (fallback (get request :hostSources) (js-array)) :some
                            (lambda (provider) (= (get provider :id) alias-id))))
                  (throw (new globalThis.TypeError "original Seed output alias conflicts with its authenticated graph")))
                (await (mkdir (resolve alias "..") (js-object :recursive t)))
                (await (symlink (relative (resolve alias "..") path) alias))
                (await (symlink (relative (resolve alias "..") map) (+ alias ".map"))))
              (js-call compiled :push (js-object :id alias-id :path alias :sourceMapPath (+ alias ".map")
                :seedPath id :seedMapPath (get emitted :sourceMap)))))
          (setq index (1+ index)))
        (unless (js-call compiled :some (lambda (item) (= (get item :id) (get record :entry))))
          (throw (new globalThis.Error "original Seed project did not emit its declared entry"))))
      compiled))

  (defun seed-host-entry-ids (record)
    (let ((by-id (new globalThis.Map)) (by-file (new globalThis.Map)) (outputs (new globalThis.Map)))
      (js-call (get record :modules) :forEach (lambda (item)
        (js-call by-id :set (get item :id) item)
        (js-call by-file :set (get item :filename) item)
        (js-call outputs :set (+ (js-call (get item :filename) :slice 0 -4) ".mjs") item)))
      (if (undefined? (get (get record :request) :portableEntries))
        (Array/from (new globalThis.Set (seed-host-source-entries record by-id by-file outputs))) (js-array))))

  (defasync seed-cached-source-graph (record configuration output product source-root signal cache)
    ;; Only compiler input participates in this key. Each original host still
    ;; runs in a distinct writable product; neither stdout nor mutable files
    ;; from a different host is reused as an independent observation.
    (let* ((identity (compilerMetadataDigest (js-object :entry (get record :entry)
                      :modules (get record :modules) :request (get record :request)
                      :hostEntries (seed-host-entry-ids record)
                      :sourceRoot source-root :emacs (get configuration :emacs))))
           (key (+ "compiled:" identity))
           (origin (resolve (get configuration :directory) "seed-compiled-cache" identity))
           (origin-product (resolve origin "product")))
      (unless (js-call cache :has key)
        (js-call cache :set key (funcall (async ()
          (await (mkdir origin-product (js-object :recursive t)))
          (let* ((modules (await (seed-authenticated-source-graph record origin origin-product source-root signal)))
                 (files (js-array)) (index 0))
            (while (< index (js-length modules))
              (let ((module (aref modules index)))
                (let ((names (js-array (get module :seedPath) (get module :seedMapPath))) (position 0))
                  (while (< position (js-length names))
                    (let* ((path (aref names position)) (bytes (await (readFile (resolve origin-product path)))))
                      (js-call files :push (js-object :path path :bytes (js-length bytes) :sha256 (execution-digest bytes))))
                    (setq position (1+ position)))))
              (setq index (1+ index)))
            (js-object :identity identity :directory origin-product :modules modules :files files))))))
      (let* ((compiled (await (js-call cache :get key))) (files (get compiled :files))
             (actual (js-array)) (index 0))
        ;; Maps refer to these same authenticated original source bytes in
        ;; this observation archive, never to a selected compiler response.
        (while (< index (js-length (get record :modules)))
          (let* ((module (aref (get record :modules) index))
                 (path (resolve output "sources" (seed-relative-path (get module :filename)))))
            (await (mkdir (resolve path "..") (js-object :recursive t)))
            (await (writeFile path (get module :source))))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length files))
          (let* ((file (aref files index)) (id (seed-relative-path (get file :path)))
                 (source (resolve (get compiled :directory) id)) (destination (resolve product id))
                 (bytes (await (readFile source))))
            (unless (and (= (js-length bytes) (get file :bytes)) (= (execution-digest bytes) (get file :sha256)))
              (throw (new globalThis.Error "independent Seed cached compiler product identity differs")))
            (await (mkdir (resolve destination "..") (js-object :recursive t)))
            (await (copyFile source destination (get constants :COPYFILE_EXCL)))
            (unless (= (execution-digest (await (readFile destination))) (get file :sha256))
              (throw (new globalThis.Error "independent Seed copied compiler product identity differs"))))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length (get compiled :modules)))
          (let* ((module (aref (get compiled :modules) index)) (id (seed-relative-path (get module :id)))
