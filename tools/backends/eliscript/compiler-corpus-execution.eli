  (defconst canonical-native-core-records
    (js-array "original-program:core-project-core" "original-program:core-project-utility"
      "original-program:core-project-persistent-values" "original-program:core-project-value-text"
      "original-program:core-project-public"))
  (defun canonical-native-sorted-record-p (record)
    (and (= (field (get record :original) "suite") "tests/wasm-managed-sorted-core.test.mjs")
      (= (field (get record :original) "fixture") "tests/fixtures/wasm-managed-sorted.eli")
      (= (value-type (field record "id")) "string")
      (js-call (new globalThis.RegExp "^original-managed:sorted-core:(node|bun):auto-(65536|1)$")
        :test (get record :id))))
  (defun canonical-native-literal-seed-p (context)
    ;; The original complete suite creates its portable outputs below
    ;; sourceRoot, where their real package reference resolves. Its independent
    ;; host must observe that same native runtime URL, rather than a second
    ;; text-identical copy. This policy is private to a real Seed preparation;
    ;; selected programs and unrelated original hosts keep their own routing.
    (let* ((record (get context :record)) (execution (field record "execution"))
           (original (field record "original")) (expected (field record "expected")))
      (and (eq (get context :independentSeedProgram) t)
        (= (field record "id") "original-program:compiler-literal-runtime-complete")
        (= (field original "suite") "tests/literal-runtime.test.mjs")
        (= (field original "fixture") "tests/fixtures/literal-runtime.eli")
        (= (field execution "kind") "original-program")
        (= (field execution "host") "tests/__eliscript_original_literal_runtime_complete.mjs")
        (= (field execution "runtimeProfile") "compiler")
        (eq (field execution "referenceArtifact") t)
        (= (field (field execution "setupReplacement") "kind")
          "selected-and-independent-reference-compiler-directories")
        (= (field expected "kind") "seed-program") (eq (field expected "oracleRequired") t))))
  (defun native-provider-fail ()
    (throw (new globalThis.TypeError "original canonical native provider identity conflicts with the selected product")))
  (defasync prepareCompilerCorpusNativeProviders (context)
    ;; These original hosts construct native collections from sourceRoot and
    ;; pass them to selected library code. Copying identical provider text to a
    ;; second URL creates distinct protocol Symbols. Preserve the original
    ;; native interop boundary, not a replacement implementation or namespace.
    (let* ((record (get context :record)) (execution (field record "execution"))
           (sequence (originalSequenceNativeInteropP record))
           (sorted (canonical-native-sorted-record-p record))
           (literal-seed (canonical-native-literal-seed-p context)))
      (if (or (Object/hasOwn context "failure") (/= (get context :target) "javascript")
              (and (not sequence) (not sorted) (not literal-seed)
                   (not (js-call canonical-native-core-records :includes (field record "id"))))) context
        (progn
          (unless (and (= (field execution "kind") "original-program")
                       (or sequence sorted literal-seed (and (= (field execution "runtimeProfile") "compiler")
                         (= (field (get record :original) "suite") "tests/core-stdlib.test.mjs"))))
            (native-provider-fail))
          (let* ((artifact (get context :artifact)) (modules (field artifact "modules"))
                 ;; These four selected sorted recipes acquire their native
                 ;; providers when the compiler request is completed from the
                 ;; archive. The raw record deliberately has no hostSources.
                 ;; Authenticate that same archive here, as for sequence, but
                 ;; never let it override an explicit provider declaration.
                 (archived-providers (or sequence
                   (and sorted (not (Object/hasOwn (get record :request) "hostSources")))))
                 (sources (if archived-providers
                   (js-call (fallback (get context :sourceAssets) (js-array)) :filter
                     (lambda (asset) (and (= (value-type (get asset :file)) "string")
                       (js-call (get asset :file) :startsWith "runtime/")
                       (js-call (get asset :file) :endsWith ".mjs"))))
                   (field (get record :request) "hostSources")))
                 (source-root (get context :sourceRoot))
                 (runtime-root (await (realpath (resolve source-root "runtime"))))
                 (files (await (local-runtime-files runtime-root "runtime")))
                 (required (new globalThis.Set files)) (seen (new globalThis.Set))
                 (proofs (js-array)) (retained (js-array)) (index 0))
            (unless (and (Array/isArray modules) (Array/isArray sources)
                         (not (js-call modules :some (lambda (item)
                           (let ((id (field item "id")))
                             (and (= (value-type id) "string")
                               (or (= id "runtime") (js-call id :startsWith "runtime/"))))))))
              (native-provider-fail))
            ;; Validate the complete declaration before changing any execution
            ;; routing. The raw record, archive, selected modules and oracle
            ;; retain all original source bytes and hashes.
            (while (< index (js-length sources))
              (let* ((item (aref sources index)) (id (if archived-providers (get item :file) (field item "id")))
                     (declared (if archived-providers
                       (request-native-provider-source item) (field item "source"))))
                (if (and (= (value-type id) "string") (js-call id :startsWith "runtime/"))
                  (progn
                    (unless (and (js-call required :has id) (not (js-call seen :has id))
                                 (= (value-type declared) "string"))
                      (native-provider-fail))
                    (let* ((path (resolve source-root id)) (canonical (await (realpath path)))
                           (expected (resolve runtime-root (js-call id :slice (js-length "runtime/"))))
                           (bytes (await (readFile path))))
                      (unless (and (= canonical expected)
                                   (js-call bytes :equals (js-call Buffer :from declared "utf8")))
                        (native-provider-fail))
                      (js-call proofs :push (js-object :id id :sha256 (execution-digest bytes) :bytes (js-length bytes))))
                    (js-call seen :add id))
                  (js-call retained :push item)))
              (setq index (1+ index)))
            (unless (= (get seen :size) (js-length files)) (native-provider-fail))
            (let* ((directory (fallback (get artifact :directory) (resolve (get artifact :path) "..")))
                   (runtime (resolve directory "runtime"))
                   (package-source (await (readFile (resolve source-root "package.json"))))
                   (package-name (get (JSON/parse (js-call package-source :toString "utf8")) :name)))
              ;; A selected runtime module or a pre-existing copied provider
              ;; must never be silently replaced by a source-root alias.
              (try
                (let ((details (await (lstat runtime))))
                  (unless (and (js-call details :isSymbolicLink)
                               (= (await (realpath runtime)) runtime-root)) (native-provider-fail)))
                (catch error (unless (= (field error "code") "ENOENT") (throw error))))
              (try
                (let ((local (JSON/parse (await (readFile (resolve directory "package.json") "utf8")))))
                  (when (= (get local :name) package-name) (native-provider-fail)))
                (catch error (unless (= (field error "code") "ENOENT") (throw error))))
              (js-call proofs :sort (lambda (a b)
                (if (< (get a :id) (get b :id)) -1 (if (> (get a :id) (get b :id)) 1 0))))
              (let ((proof (js-object :policy "canonical-source-runtime" :runtimeRoot runtime-root
                            :packageSha256 (execution-digest package-source) :files proofs
                            :identitySha256 (compilerMetadataDigest proofs))))
                (unless (nullish? (get context :transportEvidence))
                  (put (get context :transportEvidence) :nativeProviderIdentity proof))
                (copy context (js-object :nativeProviderIdentity proof
                  :record (copy record (js-object :request
                    (copy (get record :request) (js-object :hostSources
                      (if archived-providers (fallback (field (get record :request) "hostSources") (js-array)) retained))))))))))))))
  (defun request-native-provider-source (asset)
    (let ((bytes (js-call Buffer :from (get asset :content) "base64")))
      (unless (and (= (get asset :encoding) "base64") (= (get asset :bytes) (js-length bytes))
