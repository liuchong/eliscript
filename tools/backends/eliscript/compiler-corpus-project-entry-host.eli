(module tools.backends.compiler-corpus-project-entry-host
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve basename)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "node:fs/promises" realpath)

  (defasync loadProjectEntryNamespace (path id loader)
    ;; These emitted fixture and IO modules have no top-level await. Supply
    ;; their actual namespace using the loader's existing second argument;
    ;; do not ask Bun's async file wrapper to manufacture a namespace export.
    (let ((canonical path))
      (try (setq canonical (await (realpath path)))
        (catch error (unless (= (get error :code) "ENOENT") (throw error))))
      (let* ((namespace (funcall (createRequire canonical) canonical))
             (loaded (await (js-call loader :loadManagedHostModules
               (js-object :hostModules (js-array (js-object :id id
                 :specifier (get (pathToFileURL canonical) :href) :referrer "project-entry-host.mjs"
                 :allowedExports (js-array) :namespace t)))
               (js-object :hostModules (new globalThis.Map (js-array (js-array id namespace))))))))
        (js-call assert :strictEqual (get namespace globalThis.Symbol.toStringTag) "Module")
        (js-call assert :strictEqual (js-call loaded :get id) namespace)
        namespace)))

  ;; This is the project-entry observation from the original managed fixture
  ;; adapter. Functions belong to their own independently instantiated graph;
  ;; only the resulting data is compared between the two products.
  (defun observeProjectEntry (module)
    (js-call assert :strictEqual (get (get module :api) :history) (get module :history))
    (js-call assert :strictEqual (get (get module :api) :identity) (get module :identity))
    (js-call assert :strictEqual (get (get module :initial) :self) (get module :initial))
    (let ((reader (js-call module :read)))
      (js-call assert :strictEqual reader (get (get module :api) :read_counter))
      (js-call assert :strictEqual (funcall reader) (get module :counter))
      (let ((initial (js-array (get module :counter) (js-call module :current) (funcall reader)
                       (js-call (get module :history) :slice) (js-call (get module :order) :slice)
                       (js-call module :alias 99)))
            (deltas (js-array 4 -0 -1 2)) (index 0))
        (while (< index (js-length deltas))
          (js-call module :increment (aref deltas index))
          (js-call assert :strictEqual (get module :counter) (js-call module :current))
          (js-call assert :strictEqual (js-call module :read) reader)
          (js-call assert :strictEqual (funcall reader) (get module :counter))
          (setq index (1+ index)))
        (let* ((snapshot (js-call module :snapshot))
               (names (js-call module :names)) (failed false) (failure undefined))
          (js-call assert :strictEqual (get snapshot :extra) 7)
          (js-call assert :strictEqual (get snapshot :history) (get module :history))
          (try (js-call module :forbidden)
            (catch error (setq failed t failure error)))
          (js-call assert :strictEqual failed t "the original namespace assignment must fail")
          (js-array initial (get module :counter) (js-call (get module :history) :slice)
            names (get failure :name) (get (get module :initial) :values)
            (get (get module :initial) :label))))))

  (defasync main ()
    (let* ((env (get globalThis.process :env)) (argv (get globalThis.process :argv))
           (root (get env :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (reference (get env :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT))
           (product (aref argv 2)) (entry (aref argv 3)) (runtime undefined) (observations 0))
      (unless (and root reference)
        (throw (new globalThis.Error "original fixture execution requires its independent Seed product")))
      (let* ((loader-path (resolve root "tools/backends/managed-runtime.mjs"))
             (loader (funcall (createRequire loader-path) loader-path)))
        (letfn ((load (path id)
                  (async ()
                    (await (loadProjectEntryNamespace path id loader)))))
          (let* ((selected (await (funcall (load (resolve product entry) "selected-project"))))
                 (oracle (await (funcall (load (resolve reference entry) "reference-project")))))
            (unless (= (get env :ELISCRIPT_ORIGINAL_TARGET) "javascript")
              (let ((configuration (get env :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT)))
                (unless configuration
                  (throw (new globalThis.Error "selected binary fixture requires its real runtime context")))
                (let* ((metadata (await (funcall (load (resolve root "tools/backends/compiler-metadata.mjs") "metadata"))))
                       (input (await (js-call metadata :readCompilerMetadata configuration)))
                       (context (await (funcall (load (resolve root "tools/backends/compiler-corpus-host-context.mjs") "context"))))
                       (opened (await (js-call context :openOriginalProgramContext input (js-object :identity configuration)))))
                  (setq runtime (get opened :runtime))
                  (js-call runtime :auto 1))))
            ;; As in the original compare(), the Seed observation runs first.
            (let* ((expected (observeProjectEntry oracle)) (actual (observeProjectEntry selected)))
              (js-call assert :deepStrictEqual actual expected "linked defaults namespaces and live bindings")
              (setq observations (1+ observations))
              (when runtime
                (js-call runtime :collect)
                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0
                  "linked defaults namespaces and live bindings restores private frames")
                (js-call runtime :closeModule) (js-call runtime :collect)
                (js-call assert :strictEqual (js-call runtime :live) 0)
                (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
              (js-call assert :ok (> observations 0) "a fixture must execute assertions, not merely compile")
              (js-call globalThis.console :log (JSON/stringify (js-object :observations observations)))))))))
  (defun observeStandardIdentities (module data-text order protocol)
    (let* ((IPrint (get data-text :IPrint)) (IComparable (get order :IComparable))
           (input (js-object)))
      (Object/defineProperty input (js-call protocol :protocolSlot IPrint "print")
        (js-object :value (lambda () "host-print") :writable t :enumerable t :configurable t))
      (Object/defineProperty input (js-call protocol :protocolSlot IComparable "compare")
        (js-object :value (lambda () 0) :writable t :enumerable t :configurable t))
      (js-call assert :deepStrictEqual (Array/from (js-call module :read_standard_input input)) (js-array "host-print" 0))
      (let ((values (js-call module :standard_protocol_identities)))
        (js-call assert :strictEqual (aref values 0) (js-call protocol :protocolSlot IPrint "print"))
        (js-call assert :strictEqual (aref values 1) (js-call protocol :protocolMethod IPrint "print"))
        (js-call assert :strictEqual (aref values 2) (get IPrint :operations))
        (js-call assert :strictEqual (aref values 3) IPrint)
        (js-call assert :strictEqual (aref values 4) (js-call protocol :protocolSlot IComparable "compare"))
        (js-call assert :strictEqual (aref values 5) IComparable)
        (js-call assert :strictEqual (js-call data-text :printValue (aref values 6)) "target-print")
        (js-call assert :strictEqual (js-call order :compareValues (aref values 6) (aref values 6)) 0)
        (js-call assert :strictEqual (js-call protocol :isProtocol (aref values 7)) t)
        (js-call assert :notStrictEqual (aref values 7) IPrint)
        (js-call assert :notStrictEqual (js-call protocol :protocolSlot (aref values 7) "print")
          (js-call protocol :protocolSlot IPrint "print")))))
  (defasync standard-main ()
    (let* ((env (get globalThis.process :env)) (argv (get globalThis.process :argv))
           (root (get env :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (reference (get env :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT)))
      (unless (and root reference)
        (throw (new globalThis.Error "complete original managed corpus requires its independent Seed source graph")))
      (let* ((loader-path (resolve root "tools/backends/managed-runtime.mjs"))
             (loader (funcall (createRequire loader-path) loader-path))
             (module (await (loadProjectEntryNamespace (resolve (aref argv 2) (aref argv 3)) "selected" loader))))
        (unless (= (get env :ELISCRIPT_ORIGINAL_TARGET) "javascript")
          (let* ((configuration (get env :ELISCRIPT_ORIGINAL_PROGRAM_CONTEXT)))
            (unless configuration
              (throw (new globalThis.Error "selected binary original corpus requires its actual runtime context")))
            (let* ((metadata (await (loadProjectEntryNamespace (resolve root "tools/backends/compiler-metadata.mjs") "metadata" loader)))
                   (input (await (js-call metadata :readCompilerMetadata configuration)))
                   (context (await (loadProjectEntryNamespace (resolve root "tools/backends/compiler-corpus-host-context.mjs") "context" loader))))
              (await (js-call context :openOriginalProgramContext input (js-object :identity configuration))))))
        (observeStandardIdentities module
          (await (loadProjectEntryNamespace (resolve root "runtime/core/data-text.mjs") "data-text" loader))
          (await (loadProjectEntryNamespace (resolve root "runtime/core/order.mjs") "order" loader))
          (await (loadProjectEntryNamespace (resolve root "runtime/core/protocol.mjs") "protocol" loader)))
        (js-call globalThis.console :log "standard identities preserved"))))
  (let ((path (aref (get globalThis.process :argv) 1)))
    (when (= (value-type path) "string")
      (cond
        ((js-call (basename path) :startsWith "__eliscript_managed_fixture_project-entry_") (main))
        ((js-call (basename path) :startsWith "__eliscript_managed_sequence-data-standard-identities_") (standard-main)))))
  (export observeProjectEntry loadProjectEntryNamespace observeStandardIdentities))
