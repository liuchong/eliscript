(module tools.backends.compiler-corpus-identity-observer
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (defconst import-module (js* "(specifier) => import(specifier)"))
  (defasync observeOriginalIdentityReference (kind entry)
    (let ((module undefined) (out undefined))
      (cond
        ((= kind "stdlib-value-json")
          (let* ((root (get (get process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
                 (data (await (funcall import-module
                         (get (pathToFileURL (resolve root "tests/helpers/managed-stdlib-corpus.mjs")) :href)))))
            (setq module (await (funcall import-module entry)))
            (setq out (js-object
              :values (js-call module :values) :identities (js-call module :identities)
              :json (js-call (get data :inputs) :map (lambda (input) (js-call module :json_case input)))
              :boundaries (js-call module :json_boundaries) :order (js-call module :order_and_identity)
              :errors (js-call (Reflect/apply (get data :parseBoundaryCases) undefined (js-array)) :map
                        (lambda (arguments) (Reflect/apply (get module :parse_report) module arguments)))
              :encoded (js-call (Reflect/apply (get data :encodeBoundaryCases) undefined (js-array)) :map
                         (lambda (input) (js-call module :encode_report input)))))))
        ((= kind "host-token-single")
          (setq module (await (funcall import-module entry)))
          (let* ((x (js-object)) (y (js-object)) (first (js-call module :token x)))
            (setq out (js-object :tokens (js-array first (js-call module :alias x) (js-call module :nested x) (js-call module :token y))
              :effects (js-call module :effects) :abrupt (js-call module :abrupt) :conversion (js-call module :no_conversion)))
            (let ((symbols (js-call module :symbol_case)) (functions (js-call module :function_case)))
              (put out :symbols (js-array (eq (aref symbols 0) (aref symbols 2)) (not (eq (aref symbols 0) (aref symbols 1)))))
              (put out :functions (js-array (eq (aref functions 0) (aref functions 2)) (not (eq (aref functions 0) (aref functions 1))))))))
        ((= kind "project")
          (setq module (await (funcall import-module entry)))
          (let ((x (js-object)) (y (js-object)))
            (setq out (js-object :values (js-call module :encounters x y) :same (eq (get module :left) (get module :left_copy))))))
        ((or (= kind "cycle") (= kind "cycleOperands"))
          (setq module (await (funcall import-module entry)))
          (setq out (get module :early)))
        (t (throw (new globalThis.TypeError "unregistered original identity reference observation"))))
      (js-call globalThis.console :log (JSON/stringify out))))
  (export observeOriginalIdentityReference))
