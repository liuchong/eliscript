(module tools.backends.compiler-corpus-managed-scenarios
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (defconst import-module (js* "(specifier) => import(specifier)"))
  (defasync paired-observation (context script engine arguments)
    (let ((expected (await (js-call context :originalObservation script engine arguments))))
      (js-call assert :deepEqual (await (js-call context :originalObservation script "bun" arguments)) expected)
      expected))
  (defun observation-script (context kind configuration)
    (str "import {observeOriginalManagedReference} from "
      (JSON/stringify (get (pathToFileURL (resolve (get context :root) "tools/backends/compiler-corpus-managed-observer.mjs")) :href))
      ";\nawait observeOriginalManagedReference(" (JSON/stringify kind) ",process.argv[1]," (JSON/stringify configuration) ");\n"))

  (defasync runOriginalManagedCore (context helpers)
    (let* ((cases (get helpers :cases))
           (script (observation-script context "core-modules" (js-object :cases cases)))
           (expected (await (paired-observation context script "node" (js-array (get context :originalEntry)))))
           (module (get context :m)) (runtime (get context :runtime)))
      (js-call helpers :bind_expected expected)
      (js-call helpers :original_fixed_checks expected)
      (if runtime (js-call helpers :checkAll runtime)
        (let ((out (js-object)))
          (js-call cases :forEach (lambda (name)
            (put out name (Reflect/apply (get module (js-call name :replaceAll "-" "_")) module (js-array)))))
          (let ((held (js-call module :held_record))) (put out :held (js-call module :inspect_held held)))
          (js-call assert :deepEqual (js-call context :plain out) expected)
          (let ((captured (js-call module :held_pattern)) (round 0))
            (while (< round 3) (js-call assert :equal (js-call module :inspect_held_pattern captured) 17) (setq round (1+ round))))))
      (js-call globalThis.console :log (JSON/stringify expected))))

  (defasync runOriginalManagedTransient (context helpers reference-source)
    (let ((expected (await (paired-observation context reference-source "node" (js-array))))
          (module (get context :m)) (runtime (get context :runtime)))
      (js-call helpers :bind_expected expected)
      (if runtime (progn (js-call helpers :checkAll runtime) (js-call helpers :verifyHeld runtime))
        (let ((out (js-object
                     :vectors (js-call (get helpers :counts) :map (lambda (count) (js-call module :vector_case count)))
                     :vectorOwnership (js-call module :vector_ownership) :mapBranches (js-call module :map_branches)
                     :collisions (js-call module :collisions) :realCollision (js-call module :real_collision) :setCase (js-call module :set_case)
                     :callbacks (js-call (js-array 0 1 2 3) :map (lambda (mode) (js-call module :callback_order mode)))
                     :indexErrors (js-call module :index_errors) :vectorLimit (js-call module :vector_limit) :invalidSources (js-call module :invalid_sources))))
          (js-call assert :deepEqual (js-call context :plain out) expected)
          (let* ((held (js-call module :held_state)) (original (Array/from (js-object :length 65) (lambda (_ index) index)))
                 (result (js-call original :slice)))
            (js-call (js-array (js-array 0 100) (js-array 1 101) (js-array 32 132) (js-array 64 164)) :forEach
              (lambda (pair)
                (js-call assert :equal (js-call module :held_step held (aref pair 0) (aref pair 1)) held)
                (put result (aref pair 0) (aref pair 1))))
            (js-call assert :deepEqual (js-call context :plain (js-call module :held_finish held)) (js-array original result 17)))))
      (js-call globalThis.console :log (JSON/stringify expected))))

  (defasync verifyOriginalWireCapabilities (context)
    (when (get context :runtime)
      (let* ((input (get context :selectedInput)) (descriptor (get input :descriptor)))
        (funcall assert (js-call (get descriptor :hostModules) :some
          (lambda (item) (= (get item :specifier) "eliscript/platform/http.mjs"))))
        (when (= (get input :target) "wasm")
          (let ((imports (js-call globalThis.WebAssembly.Module :imports
                           (new globalThis.WebAssembly.Module (new globalThis.Uint8Array (await (readFile (get input :path))))))))
            (js-call assert :deepEqual
              (js-call imports :map (lambda (item) (js-array (get item :module) (get item :name) (get item :kind))))
              (js-call (get descriptor :hostCapabilities) :map (lambda (item) (js-array (get item :module) (get item :name) "function"))))
            (js-call imports :forEach (lambda (item) (js-call assert :equal (get item :module) "eliscript.host"))))))))

  (defun javascript-wire-platform (module)
    (js-object
                  :createService (lambda (settings) (js-call module :http_service settings))
                  :createClient (lambda (settings) (js-call module :http_client settings))
                  :discoveryCandidates (lambda (url) (js-call module :http_candidates url))
                  :pathIndexMarkdown (lambda (title operations &rest supplied)
                    (js-call module :http_index title operations (if (undefined? (aref supplied 0)) "/" (aref supplied 0))))))

  (defasync runOriginalManagedWire (context helpers reference-source)
    (let* ((root (get context :root))
           (arguments (js-array "wire-oracle.mjs" "--run-oracle" (get context :originalEntry)
                         (get (pathToFileURL (resolve root "runtime/wire/http-rpc.mjs")) :href)))
           (expected (await (paired-observation context reference-source "node" arguments)))
           (module (get context :m)) (runtime (get context :runtime)) (observation expected))
      (js-call helpers :bind_expected expected)
      (js-call helpers :original_fixed_checks expected)
      (if (Object/hasOwn context "wirePartition")
        (let* ((implementation (await (funcall import-module
                      (get (pathToFileURL (resolve root "tools/backends/compiler-corpus-wire-host.mjs")) :href))))
               (platform (javascript-wire-platform module))
               (library (js-object :cases (get helpers :cases) :expected expected :runtime runtime :module module
                          :call (get helpers :call) :targetHTTP (get helpers :targetHTTP) :httpContracts (get helpers :httpContracts)
                          :checkNetwork (get helpers :checkNetwork)
                          :checkJavaScriptNetwork (async () (await (js-call helpers :checkJavaScriptNetwork module platform)))
                          :javascriptHTTP platform)))
          (setq observation (await (js-call implementation :runWirePartition library (get context :wirePartition)))))
        (if runtime (progn (await (js-call helpers :checkCorpus runtime)) (await (js-call helpers :checkNetwork runtime)))
          (let ((results (js-array)))
            (let ((cases (get helpers :cases)) (index 0))
              (while (< index (js-length cases))
                (let* ((record (aref cases index))
                       (value (await (Reflect/apply (get module (js-call (get record :fn) :replaceAll "-" "_")) module (get record :args)))))
                  (js-call results :push (JSON/parse value)))
                (setq index (1+ index))))
            (js-call assert :deepEqual results (get expected :results))
            (js-call assert :equal (js-call module :parse_negative_zero) (get expected :negativeZero))
            (let ((platform (javascript-wire-platform module)))
              (js-call assert :deepEqual (await (js-call helpers :httpContracts platform)) (get expected :http))
              (await (js-call helpers :checkJavaScriptNetwork module platform))))))
      (js-call globalThis.console :log (JSON/stringify observation))))

  (defasync runOriginalWireHost (context script engine)
    (let* ((expected (await (js-call context :originalObservation script engine
                       (js-array "wire-host.mjs" (resolve (get context :reference) "tests/fixtures/wire.mjs"))))))
      (js-call assert :deepEqual expected (js-object :codec t :discovery t :usageSafe t :post t))
      (js-call assert :deepEqual (await (js-call context :originalObservation script engine
        (js-array "wire-host.mjs" (resolve (get context :product) "tests/fixtures/wire.mjs")) t)) expected)
      (js-call globalThis.console :log (JSON/stringify expected))))

  (defasync runOriginalManagedSequence (context helpers observation-helper)
    (let* ((observer-url (get observation-helper :url))
           (script (observation-script context "sequence-data" (js-object :observations (get helpers :observations) :observer observer-url)))
           (expected (await (paired-observation context script "node" (js-array (get context :originalEntry)))))
           (out (js-object)) (module (get context :m)))
      (js-call (get helpers :observations) :forEach (lambda (name)
        (put out name (Reflect/apply (get module name) module (js-array)))))
      (let ((actual (JSON/parse (js-call observation-helper :observationJSON out))))
        (js-call assert :deepEqual actual expected)
        (js-call helpers :original_fixed_checks actual))
      (when (get context :runtime) (js-call assert :equal (get (js-call (get context :runtime) :stats) :frameDepth) 0))
      (js-call globalThis.console :log (JSON/stringify expected))))

  (defun relocate-host (context source directory selected modules)
    (js-call source :replace (new globalThis.RegExp "from ([\"'])(?:\\.\\.\\/)+runtime\\/(core|testing)\\/([^\"']+)\\1" "g")
      (lambda (whole quote family filename)
        (let* ((canonical (str "runtime/" family "/" filename))
               (id (if selected (js-call modules :get canonical) canonical)))
          (funcall assert id (str "actual public source module " canonical))
          (str "from " (JSON/stringify (get (pathToFileURL (resolve (if selected directory (get context :root)) id)) :href)))))))
  (defasync runOriginalSequenceHost (context original replacements argument-ids name engine)
    (let* ((public-modules (new globalThis.Map replacements))
           (reference (get context :reference)) (product (get context :product))
           (expected (await (js-call context :originalObservation (relocate-host context original reference false public-modules) engine
                       (js-call (js-array "original-host.mjs") :concat (js-call argument-ids :map (lambda (id) (resolve reference id)))))))
           (actual (await (js-call context :originalObservation (relocate-host context original product t public-modules) engine
                     (js-call (js-array "original-host.mjs") :concat (js-call argument-ids :map (lambda (id) (resolve product id)))) t))))
      (js-call assert :deepEqual actual expected)
      (when (= name "value-hash")
        (js-call assert :deepEqual actual (JSON/parse (await (readFile (resolve (get context :root) "tests/fixtures/value-hashes.json") "utf8")))))
      (js-call globalThis.console :log (JSON/stringify expected))))
  (defasync runOriginalSequenceUsage (context id engine)
    (let* ((script "await import(process.argv[1]);")
           (expected (await (js-call context :originalObservation script engine
                       (js-array (get (pathToFileURL (resolve (get context :reference) id)) :href))))))
      (js-call assert :deepEqual (await (js-call context :originalObservation script engine
        (js-array (get (pathToFileURL (resolve (get context :product) id)) :href)) t)) expected)
      (js-call globalThis.console :log (JSON/stringify expected))))
  (defasync runOriginalRelationalSet (context script engine)
    (let* ((id "core-set-usage.mjs")
           (expected (await (js-call context :originalObservation script engine
                       (js-array "core-set-host.mjs" (resolve (get context :reference) id))))))
      (js-call assert :deepEqual (await (js-call context :originalObservation script engine
        (js-array "core-set-host.mjs" (resolve (get context :product) id)) t)) expected)
      (js-call globalThis.console :log (JSON/stringify expected))))
  (defasync runOriginalStandardIdentities (context source)
    (put process :argv (js-array (get process :execPath) "standard-protocols.mjs" (resolve (get context :product) (get context :entry))))
    (await (funcall import-module source)))
  (export runOriginalManagedCore runOriginalManagedTransient verifyOriginalWireCapabilities runOriginalManagedWire runOriginalWireHost
    runOriginalManagedSequence runOriginalSequenceHost runOriginalSequenceUsage runOriginalRelationalSet runOriginalStandardIdentities))
