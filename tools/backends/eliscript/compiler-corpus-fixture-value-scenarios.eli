        (setq mode (1+ mode)))
      (setq mode 0)
      (while (< mode 6) (check-named fixture "function key lists and prototype" "reflection-shape" (js-array mode)) (setq mode (1+ mode)))
      (setq mode 0)
      (while (< mode 3) (check-named fixture "function accessor lookup and callee order" "reflection-effects" (js-array mode)) (setq mode (1+ mode))))
    (let ((iteration 0))
      (while (< iteration 4)
        (js-call fixture :compare "canonical functions and call effects" (lambda (module)
          (js-array (js-call module :cached) (js-call module :call_number "12") (js-call module :call_string 2)
            (js-call module :call_finite 2) (js-call module :static_finite 2) (js-call module :call_symbol)
            (js-call module :call_error) (js-call module :effects))))
        (setq iteration (1+ iteration)))))

