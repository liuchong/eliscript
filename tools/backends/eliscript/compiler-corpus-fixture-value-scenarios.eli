        (check-named fixture "conversion abrupt" "conversion-abrupt" (js-array name mode)) (setq mode (1+ mode))))))
    (each (js-array "min" "max") (lambda (name)
      (check-named fixture "extreme conversion order" "extreme-order" (js-array name))
      (each (js-array (js-array) (js-array -0) (js-array 0 -0) (js-array -0 0) (js-array globalThis.NaN 4)
                     (js-array 4 globalThis.NaN) (js-array undefined) (js-array 1 9 -7 2))
        (lambda (arguments) (js-call fixture :compare name (lambda (module)
          (Reflect/apply (get module :math_invoke) module (js-call (js-array name) :concat arguments))))))))
    (each (js-call (model-call model "froundBoundaries") :concat (model-call model "froundRandom")) (lambda (input)
      (js-call fixture :compare "fround exact samples" (lambda (module)
        (js-array (js-call module :direct_fround input) (js-call module :math_invoke "fround" input)
          (js-call module :invoke_held (js-call module :namespace_get "fround") input))))))
    (let ((module (get fixture :m)))
