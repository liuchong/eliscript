                     (js-array -1 5) (js-array 4294967295 5) (js-array 2147483648 2) (js-array 2147483647 2147483647)
                     (js-array 4294967295 4294967295) (js-array (- (Math/pow 2 53) 1) (- (- (Math/pow 2 32)) 1))
                     (js-array "0xffffffff" "-1") (js-array undefined t) (js-array nil "3"))) (state 477785657) (index 0))
      (letfn ((next () (setq state (unsigned-bit-shift-right (+ (Math/imul state 1664525) 1013904223) 0))))
        (while (< index 64) (js-call pairs :push (js-array (next) (next))) (setq index (1+ index))))
      (each pairs (lambda (pair) (js-call fixture :compare "Math imul" (lambda (module)
        (js-array (js-call module :direct_imul (aref pair 0) (aref pair 1))
          (js-call module :math_invoke "imul" (aref pair 0) (aref pair 1))))))))
    (each (js-call (get model :unaryNames) :concat (js-array "imul" "f16round")) (lambda (name)
      (each (js-array (js-array) (js-array undefined) (js-array nil) (js-array -0 99 "ignored")) (lambda (arguments)
        (js-call fixture :compare (str name " arity") (lambda (module)
          (Reflect/apply (get module :math_invoke) module (js-call (js-array name) :concat arguments))))))
      (each (js-array "conversion-order" "conversion-hint" "primitive-rejections")
