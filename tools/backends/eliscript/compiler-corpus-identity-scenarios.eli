(module tools.backends.compiler-corpus-identity-scenarios
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (defconst import-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defun close-runtime (runtime)
    (let ((close (get runtime :close)))
      (unless (nullish? close) (Reflect/apply close runtime (js-array)))))
  (defun reference-observation (context kind)
    (let* ((script (str "import {observeOriginalIdentityReference} from "
                    (JSON/stringify (get (pathToFileURL (resolve (get context :root)
                      "tools/backends/compiler-corpus-identity-observer.mjs")) :href))
                    ";\nawait observeOriginalIdentityReference(" (JSON/stringify kind) ",process.argv[1]);\n"))
           (arguments (js-array (get context :originalEntry)))
           (expected (js-call context :observe script "node" arguments)))
      (js-call assert :deepEqual (js-call context :observe script "bun" arguments) expected)
      expected))

  (defasync runOriginalValueJson (context contract)
    (let* ((data (await (funcall import-module (get (pathToFileURL
                   (resolve (get context :root) "tests/helpers/managed-stdlib-corpus.mjs")) :href))))
           (inputs (get data :inputs))
           (expected (reference-observation context "stdlib-value-json"))
           (_checked (js-call contract :checkJSONExpected expected))
           (raw (await (funcall import-module (get (pathToFileURL
                  (resolve (get context :root) "tests/helpers/managed-json-contract.mjs")) :href))))
           (module (get context :m)))
      (if (get context :binary)
        (let ((a (await (js-call context :freshRuntime))))
          (try (js-call raw :checkAll a inputs expected)
            (finally (try (js-call raw :finish a) (finally (close-runtime a))))))
        (let ((actual (js-object :values (js-call module :values) :identities (js-call module :identities)
                        :json (js-call inputs :map (lambda (input) (js-call module :json_case input)))
                        :boundaries (js-call module :json_boundaries) :order (js-call module :order_and_identity)
                        :errors (js-call (get data :parseCases) :map
                          (lambda (arguments) (Reflect/apply (get module :parse_report) module arguments)))
                        :encoded (js-call (get data :encodeInputs) :map (lambda (input) (js-call module :encode_report input))))))
          (js-call assert :deepEqual (js-call context :plain actual) expected)))
      (if (get context :binary)
        (let ((a (await (js-call context :freshRuntime))))
          (js-call a :auto 1)
          (try (js-call contract :checkOpaque a) (finally (close-runtime a))))
        (let ((mode 0))
          (while (< mode 5)
            (let ((out (js-call module :opaque_probe mode)))
              (when (< mode 3) (js-call assert :deepEqual out (aref (js-array "function" false nil) mode)))
              (when (= mode 3) (js-call assert :equal (funcall host-typeof out) "number"))
              (when (= mode 4) (js-call assert :equal out false)))
            (setq mode (1+ mode)))))
      (js-call globalThis.console :log (JSON/stringify expected))))

  (defasync runOriginalHostTokenSingle (context helpers)
    (let* ((reference (get context :reference)) (module (get context :m))
           (scalar-expected (js-call (js-array nil undefined false t -0 globalThis.NaN "") :map
                              (lambda (input) (js-call reference :safe input))))
           (expected (reference-observation context "host-token-single")))
      (js-call assert :deepEqual expected
        (js-object :tokens (js-array 1 1 1 2) :effects (js-array t (js-array 1 2)) :abrupt (js-array t (js-array 1))
          :conversion (js-array) :symbols (js-array t t) :functions (js-array t t)))
      (if (get context :binary)
        (progn
          (js-call helpers :identities (await (js-call context :freshRuntime)))
          (let ((a (await (js-call context :freshRuntime)))) (js-call a :auto 1) (js-call helpers :checkScalars a reference))
          (let* ((first (await (js-call context :freshRuntime))) (second (await (js-call context :freshRuntime))))
            (js-call helpers :heapIsolation first second))
          (let ((a (await (js-call context :freshRuntime))))
            (js-call a :auto 1)
            (try
              (js-call assert :deepEqual (js-call helpers :value a "effects") (js-array t (js-array 1 2)))
              (js-call assert :deepEqual (js-call helpers :value a "abrupt") (js-array t (js-array 1)))
              (finally (js-call helpers :finish a)))))
        (let* ((url (get (pathToFileURL (resolve (get context :product) (get context :entry))) :href))
               (first-module (await (funcall import-module (str url "?identity-isolation=first"))))
               (second-module (await (funcall import-module (str url "?identity-isolation=second"))))
               (first-object (js-object)) (second-object (js-object)))
          (js-call assert :equal (js-call first-module :token first-object) 1)
          (js-call assert :equal (js-call second-module :token second-object) 1)
          (js-call assert :equal (js-call first-module :token first-object) 1)
          (js-call assert :equal (js-call second-module :token second-object) 1)
          (let* ((x (js-object)) (y (js-object)) (first (js-call module :token x)))
            (js-call assert :equal first 1)
            (js-call assert :equal (js-call module :alias x) first)
            (js-call assert :equal (js-call module :nested x) first)
            (js-call assert :equal (js-call module :token y) 2)
            (let ((index 0))
              (while (< index 8) (js-call assert :equal (js-call module :token x) first) (setq index (1+ index))))
            (js-call assert :deepEqual (js-call module :effects) (js-array t (js-array 1 2)))
            (js-call assert :deepEqual (js-call module :abrupt) (js-array t (js-array 1)))
            (js-call assert :deepEqual (js-call module :no_conversion) (js-array))
            (let ((symbols (js-call module :symbol_case)) (functions (js-call module :function_case)))
              (js-call assert :equal (aref symbols 0) (aref symbols 2))
              (js-call assert :notEqual (aref symbols 0) (aref symbols 1))
              (js-call assert :equal (aref functions 0) (aref functions 2))
              (js-call assert :notEqual (aref functions 0) (aref functions 1)))
            (js-call assert :deepEqual (js-call (js-array nil undefined false t -0 globalThis.NaN "") :map
              (lambda (input) (js-call module :safe input))) scalar-expected))))
      (js-call globalThis.console :log (JSON/stringify expected))))

  (defasync runOriginalHostTokenProject (context helpers)
    (let ((expected (reference-observation context "project")) (module (get context :m)))
      (js-call assert :deepEqual (get expected :values) (js-array 1 2 1 2 1 1 2))
      (if (get context :binary)
        (js-call helpers :encounters (await (js-call context :freshRuntime)) (js-object :expected expected))
        (let ((x (js-object)) (y (js-object)))
          (js-call assert :equal (eq (get module :left) (get module :left_copy)) (get expected :same))
          (js-call assert :deepEqual (js-call module :encounters x y) (get expected :values))
          (js-call assert :equal (js-call module :left x) 1)
          (js-call assert :equal (js-call module :right x) 2)
          (js-call assert :equal (js-call module :closure x) 1)
          (js-call assert :equal (js-call module :own x) 2)))
      (js-call globalThis.console :log (JSON/stringify expected))))

  (defasync runOriginalHostTokenCycle (context helpers kind)
    (let ((expected (reference-observation context kind)))
      (js-call assert :deepEqual expected (if (= kind "cycle") "ReferenceError" (js-array "ReferenceError" false (js-array))))
      (if (get context :binary)
        (let ((a (await (js-call context :freshRuntime))))
          (js-call a :auto 1)
          (try
            (let ((early (js-call a :getExport "early")))
              (try (js-call assert :deepEqual (js-call helpers :read a early) expected) (finally (js-call a :release early))))
            (finally (js-call helpers :finish a))))
        (js-call assert :deepEqual (js-call context :plain (get (get context :m) :early)) expected))
      (js-call globalThis.console :log (JSON/stringify expected))))
  (export runOriginalValueJson runOriginalHostTokenSingle runOriginalHostTokenProject runOriginalHostTokenCycle))
