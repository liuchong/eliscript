  (defasync project-runtime-assets (document options)
    (let* ((records (js-call (get document :records) :filter (lambda (record)
             (let* ((original (get record :original))
                    (proofs (and original (get original :sourceAssets))))
               (and original
                 (or (js-call (js-array "tests/bootstrap-project.test.mjs" "tests/bootstrap-evaluation.test.mjs")
                       :includes (get original :suite))
                   (and (Array/isArray proofs) (js-call proofs :some (lambda (proof)
                     (= (get proof :file) "bootstrap/host/project.mjs"))))))))))
           (files (js-array "bootstrap/host/project.mjs" "bootstrap/host/project-ground.mjs" "tools/project/project.eli"
             "bootstrap/host/project-cli.mjs" "bootstrap/host/project-cli.mjs.map"
             "bootstrap/host/project-cli-ground.mjs" "tools/project/project-cli.eli")))
      (when (> (js-length records) 0)
        (js-call (js-array "array-text" "binding" "errors" "math" "number-radix" "prelude" "primitives" "unicode-case" "unicode-case-data") :forEach (lambda (name)
          (js-call files :push (str "runtime/" name ".eli")
            (str "runtime/" name ".mjs") (str "runtime/" name ".mjs.map"))))
        (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot
                         (if (nullish? options) root (get options :sourceRoot root)))))
               (proofs (js-array)) (index 0))
          (while (< index (js-length files))
            (let* ((filename (aref files index)) (asset (await (js-call reader :file filename)))
                   (existing (js-call (get document :evidence) :find
                     (lambda (entry) (= (get entry :file) filename)))))
              (when (and (= filename "bootstrap/host/project-cli-ground.mjs")
                         (/= (get asset :sha256) "cbaaf12e9aa56c696e555d2cd101c17ac8c3177046c513d0fbe8655a10f916d2"))
                (throw (new globalThis.TypeError "original project CLI archive bytes changed")))
              (if existing
                (unless (and (= (get existing :bytes) (get asset :bytes))
                             (= (get existing :sha256) (get asset :sha256))
                             (= (get existing :encoding) (get asset :encoding))
                             (= (get existing :content) (get asset :content)))
                  (throw (new globalThis.TypeError (str "original project runtime source identity differs: " filename))))
                (js-call (get document :evidence) :push asset))
              (js-call proofs :push (js-object :file filename :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (js-call records :forEach (lambda (record)
            (let* ((original (get record :original))
                   (assets (js-call (get original :sourceAssets (js-array)) :slice)))
              (js-call proofs :forEach (lambda (proof)
                (let ((existing (js-call assets :find (lambda (entry) (= (get entry :file) (get proof :file))))))
                  (if existing
                    (unless (= (get existing :sourceSha256) (get proof :sourceSha256))
                      (throw (new globalThis.TypeError (str "original project runtime dependency changed: " (get proof :file)))))
                    (js-call assets :push (Object/assign (js-object) proof))))))
              (put original :sourceAssets assets))))))) document)

  (defun bindOriginalMaintainedSuiteEvidence (document)
    (let* ((gate (get document :originalGateEvidence)) (locators (get gate :locators))
           (claimed (new globalThis.Set)))
      (when (Array/isArray locators)
        (js-call (js-array
          (js-array "original-program:compiler-module-reader-program-fuzz" "tests/reader-program-fuzz-acceptance-selfhosted.test.mjs"
            "100000 deterministic reader and program mutations preserve every invariant" "maintained-eli-complete-fuzz-acceptance")
          (js-array "original-program:compiler-stdlib-bit-complete" "tests/stdlib-bit-selfhosted.test.mjs"
            "portable 32-bit operations and algorithms agree under Bun and Node" "maintained-eli-complete-stdlib-bit")
          (js-array "original-program:compiler-module-bootstrap-emitter" "tests/bootstrap-emitter-selfhosted.test.mjs"
            "bootstrapped emitter matches seed ESM and Source Map output" "maintained-eli-complete-bootstrap-emitter")) :forEach
          (lambda (plan)
            (let ((selected (js-call locators :filter (lambda (locator)
                    (and (= (get locator :file) (aref plan 1)) (= (get locator :contains) (aref plan 2)))))))
              (when (> (js-length selected) 0)
                (let* ((record (js-call (get document :records) :find (lambda (item) (= (get item :id) (aref plan 0)))))
                       (original (and record (get record :original)))
                       (asset (js-call (get document :evidence) :find (lambda (item) (= (get item :file) (aref plan 1)))))
                       (proof (and original (js-call (get original :sourceAssets) :find
                         (lambda (item) (= (get item :file) (aref plan 1)))))))
                  (unless (and record proof asset (= (get (get original :maintainedTransport) :kind) (aref plan 3))
                               (= (get proof :sourceSha256) (get asset :sha256))
                               (= (get asset :encoding) "base64")
                               (= (corpus-hash (js-call Buffer :from (get asset :content) "base64")) (get asset :sha256))
                               (js-call (js-call (js-call Buffer :from (get asset :content) "base64") :toString "utf8") :includes (aref plan 2)))
                    (throw (new globalThis.TypeError "maintained suite locator lacks its complete authenticated original execution")))
                  (let ((bindings (js-array)))
                    (js-call selected :forEach (lambda (locator)
                      (let ((id (get locator :id)))
                        (unless (js-call (get record :coverage) :includes id) (js-call (get record :coverage) :push id))
                        (js-call claimed :add id)
                        (js-call bindings :push (js-object :coverageId id :file (aref plan 1)
                          :sourceSha256 (get asset :sha256) :record (aref plan 0))))))
                    (put original :maintainedLocatorBindings bindings)))))))
        (put document :missingCaseAdapters (js-call (get document :missingCaseAdapters) :filter
          (lambda (item) (not (js-call claimed :has (get item :coverageId))))))
        (put gate :coverageIds (js-call (get gate :coverageIds) :filter (lambda (id) (not (js-call claimed :has id)))))
        (put gate :hostOnlyDependencies (js-call (get gate :hostOnlyDependencies) :filter
          (lambda (item) (not (js-call claimed :has (get item :coverageId)))))))
      document))

  (defasync bindOriginalRuntimeScanReportEvidence (document options)
    (let* ((gate (get document :originalGateEvidence)) (locators (get gate :locators))
           (generated "tests/compiler-runtime-scan-selfhosted.test.mjs")
           (maintained "tests/eliscript/compiler-runtime-scan.eli")
           (title "committed compiler runtime scan report matches measured sources")
           (selected (if (Array/isArray locators) (js-call locators :filter
             (lambda (item) (and (= (get item :file) generated) (= (get item :contains) title)))) (js-array))))
      (when (> (js-length selected) 0)
        (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot (get options :sourceRoot))))
               (source (await (js-call reader :text maintained)))
               (pending (read-string source maintained)) (forms (js-array)) (proofs (js-array))
               (files (js-array maintained generated "benchmarks/compiler-runtime-scan-macos-arm64.json"
                        "tools/compiler/runtime-scan-benchmark.mjs" "tests/helpers/performance-acceptance.mjs"))
               (index 0) (claimed (new globalThis.Set))
               (deferred (or (= (resource-field options "functionalRuntimeProfile") "small")
                 (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))))
          (while (> (js-length pending) 0)
            (let* ((form (js-call pending :shift)) (items (get form :items)))
              (when (Array/isArray items)
                (if (and (= (get (aref items 0) :name) "funcall")
                         (= (get (aref items 2) :value) title)
                         (= (get (aref (get (aref items 1) :items) 0) :name) "currentPerformanceTest"))
                  (js-call forms :push form) (Reflect/apply (get pending :push) pending items)))))
          (unless (= (js-length forms) 1)
            (throw (new globalThis.TypeError "runtime-scan performance evidence requires its exact maintained original gate")))
          (while (< index (js-length files))
            (let* ((file (aref files index)) (asset (await (js-call reader :file file)))
                   (prior (js-call (get document :evidence) :find (lambda (item) (= (get item :file) file)))))
              (when (and prior (or (/= (get prior :sha256) (get asset :sha256)) (/= (get prior :content) (get asset :content))))
                (throw (new globalThis.TypeError "runtime-scan performance gate source identity changed")))
              (unless prior (js-call (get document :evidence) :push asset))
              (js-call proofs :push (js-object :file file :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (let* ((form (aref forms 0)) (span (get form :span))
                 (start (audit-unit-offset source (get span :start))) (end (audit-unit-offset source (get span :end)))
                 (region (js-object :start start :end end :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
                   :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 end)) :sha256 (corpus-hash (js-call source :slice start end)))))
            (js-call selected :forEach (lambda (locator)
              (let ((id (get locator :id)))
                (js-call claimed :add id)
                (unless (js-call (get gate :coverageIds) :includes id) (js-call (get gate :coverageIds) :push id))
                (unless (js-call (get gate :hostOnlyDependencies) :some (lambda (item) (= (get item :coverageId) id)))
                  (js-call (get gate :hostOnlyDependencies) :push (js-object :coverageId id :file maintained
                    :sourceSha256 (corpus-hash source) :kind "source-bound-performance-report-case" :locator locator
                    :originalAssertion title :region region :dependencies proofs
                    :currentPerformanceAcceptance (if deferred "DEFERRED / NOT ACCEPTED" "required-by-original-gate")
                    :performanceAccepted false
                    :reason "the original current-source performance test remains strict by default and is explicitly deferred in functional mode; this binding does not assert current performance acceptance")))))))
          (put document :missingCaseAdapters (js-call (get document :missingCaseAdapters) :filter
            (lambda (item) (not (js-call claimed :has (get item :coverageId))))))
          (let* ((required (resource-field (get options :originals) "requiredCoverage"))
                 (ids (new globalThis.Set (get gate :coverageIds))))
            (when (Array/isArray required)
              (put gate :coverageIds (js-call required :filter (lambda (id) (js-call ids :has id))))))))
      document))

  ;; These are the finite source assets introduced by the capsule migration.
  ;; Program assets remain attached to their actual selected-program record;
  ;; harness fixtures belong to the unchanged required make test-core gate.
  ;; Source authentication here never counts a program or host test as passed.
  (defconst maintained-fixture-plans (js-array
    (js-array "tests/fixtures/archive-resource-driver.eli" "host-fixture" (js-array "tests/helpers/archive-resource-contract.eli" "archive-resource-driver"))
    (js-array "tests/fixtures/archive-session-host.eli" "host-fixture" (js-array "tests/compiler-source-archive-streaming.test.eli" "archive-session-host"))
    (js-array "tests/fixtures/archive-source-assets-host.eli" "host-fixture" (js-array "tests/compiler-artifact-archive-test-ground.eli" "archive-source-assets-host"))
    (js-array "tests/fixtures/archive-transport-driver.eli" "host-fixture" (js-array "tests/compiler-artifact-archive-test-ground.eli" "archive-transport-driver"))
    (js-array "tests/fixtures/array-text-call-host.eli" "host-fixture" (js-array "tests/compiler-js-array-text-call.test.eli" "array-text-call-host"))
    (js-array "tests/fixtures/array-text-host.eli" "host-fixture" (js-array "tests/js-array-text-fast-path.test.eli" "array-text-host"))
    (js-array "tests/fixtures/array-text-maintenance-runtime.eli" "host-fixture" (js-array "tests/compiler-js-array-text-call.test.eli" "array-text-maintenance-runtime"))
    (js-array "tests/fixtures/bootstrap-emitter-host.eli" "host-fixture" (js-array "tests/bootstrap-emitter.test.eli" "bootstrap-emitter-host"))
    (js-array "tests/fixtures/bootstrap-formatter-host.eli" "host-fixture" (js-array "tests/bootstrap-formatter.test.eli" "bootstrap-formatter-host"))
    (js-array "tests/fixtures/bootstrap-ir-host.eli" "host-fixture" (js-array "tests/bootstrap-ir-serialization.test.eli" "bootstrap-ir-host"))
    (js-array "tests/fixtures/bootstrap-project-node-host.eli" "host-fixture" (js-array "tests/bootstrap-project.test.eli" "bootstrap-project-node-host"))
    (js-array "tests/fixtures/boundary-project-host.eli" "host-fixture" (js-array "tests/boundary-security.test.eli" "boundary-project-host"))
    (js-array "tests/fixtures/browser-project-reference-host.eli" "host-fixture" (js-array "tests/compiler-browser-session-test-ground.eli" "browser-project-reference-host"))
    (js-array "tests/fixtures/browser-session-page.eli" "host-fixture" (js-array "tests/compiler-browser-session-test-ground.eli" "browser-session-page"))
