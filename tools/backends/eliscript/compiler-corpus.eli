                    "runtime/unicode-case.eli" "runtime/unicode-case.mjs"
                    "runtime/unicode-case-data.eli" "runtime/unicode-case-data.mjs")) (index 0))
      (when (> (js-length records) 0)
        (while (< index (js-length files))
          (let* ((file (aref files index)) (asset (await (js-call reader :file file)))
                 (existing (js-call (get document :evidence) :find (lambda (item) (= (get item :file) file)))))
            (when (and existing (or (/= (get existing :sha256) (get asset :sha256))
                                   (/= (get existing :content) (get asset :content))))
              (throw (new globalThis.TypeError "original tools data reference source identity conflicts")))
            (unless existing (js-call (get document :evidence) :push asset))
            (js-call proofs :push (js-object :file file :sourceSha256 (get asset :sha256))))
          (setq index (1+ index)))
        (js-call records :forEach (lambda (record)
          (let ((original (get record :original)))
            (put original :toolsDataReferenceTransport
              (js-object :kind "original-tools-data-reference" :version 1 :sourceAssets proofs
                :hostSha256 (corpus-hash (get (get record :execution) :hostSource))))))))
