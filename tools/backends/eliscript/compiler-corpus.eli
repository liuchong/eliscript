(module tools.backends.compiler-corpus
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:path" posix resolve)
  (import "node:url" pathToFileURL)
  (import "../../dist/bootstrap/reader.mjs" read-string)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (import "./compiler-build.mjs" independentCompilerResources)
  (import "./build.mjs" root)
  (import "./compiler-corpus-legacy.mjs" :as legacy)

  ;; Preserve the unaffected public implementations and function identities.
  ;; The source-audit branch and binary replay request transport live here.
  (defconst createOriginalCorpusSourceReader (get legacy :createOriginalCorpusSourceReader))
  (defconst cloneCompilerCorpusData (get legacy :cloneCompilerCorpusData))
  (defconst cloneCompilerCorpusModules (get legacy :cloneCompilerCorpusModules))
  (defconst literal-suite "tests/literal-runtime.test.mjs")
  (defconst literal-source "tests/eliscript/literal-runtime.eli")
  (defconst literal-title "maintained Eliscript sources use explicit host constructors")

  ;; Exact retained recipes whose original tests compile into a virtual output
  ;; directory or supply canonical runtime modules outside their source list.
  (defconst request-layouts
    (let ((plans (new globalThis.Map)))
      (js-call (js-array "core-set-usage" "core-stdlib-usage" "core-language-api-usage") :forEach (lambda (name)
        (js-call plans :set (+ "stable-compatibility:program:tests/fixtures/" name ".eli")
          (js-array (+ name ".mjs") "keep"))))
      (js-call plans :set "original-program:core-set-source-map" (js-array "core-set-usage.mjs" "keep"))
      (js-call plans :set "original-program:core-stdlib-complete-protocols" (js-array "core-stdlib-usage.mjs" "keep"))
      (js-call plans :set "stable-compatibility:program:stdlib/multimethod.eli" (js-array "multimethod.mjs" "stdlib"))
      (js-call plans :set "original-program:multimethod-complete-hosts" (js-array "multimethod.mjs" "stdlib"))
      (js-call (js-array "persistent-list" "persistent-vector" "persistent-map" "persistent-set"
                        "numeric" "json" "result" "metadata" "data-text" "value-semantics") :forEach (lambda (name)
        (js-call plans :set (+ "original-program:portable-" name "-complete-hosts")
          (js-array (+ (if (= name "value-semantics") "value" name) ".mjs") "stdlib"))))
      (js-call plans :set "original-managed-suite:complete-fixture-suites" (js-array "host/compiler-session.mjs" "compiler"))
      (js-call plans :set "original-tools-artifact:worker-source-mapping:bun" (js-array "host/compiler-session.mjs" "compiler"))
      (js-call (js-array "node" "bun") :forEach (lambda (engine)
        (js-call (js-array "original-tools-artifact:" "original-managed:") :forEach (lambda (prefix)
          (js-call plans :set (+ prefix "compiler-session-tools:" engine) (js-array "host/compiler-session.mjs" "compiler"))))
        (js-call (js-array 65536 1) :forEach (lambda (auto)
          (js-call (js-array (js-array "core-modules" "tests/core-entry.mjs")
                            (js-array "transient-state" "entry.mjs")
                            (js-array "sorted-core" "tests/sorted-entry.mjs")
                            (js-array "wire" "tests/fixtures/wasm-managed-wire.mjs")
                            (js-array "wire-original-host" "tests/fixtures/wasm-managed-wire.mjs")) :forEach (lambda (family)
            (js-call plans :set (+ "original-managed:" (aref family 0) ":" engine ":auto-" auto)
              (js-array (aref family 1) (if (js-call (aref family 0) :startsWith "wire") "keep" "entry")))))
          (js-call plans :set (+ "original-managed-fixture:persistent-vector-auto-" auto ":" engine) (js-array "entry.mjs" "entry"))
          (js-call plans :set (+ "original-identity-value:stdlib-value-json:" engine ":auto-" auto) (js-array "entry.mjs" "entry"))))))
      plans))

  (defun request-source (assets filename)
    (let ((asset (js-call assets :get filename)))
      (unless asset (throw (new globalThis.TypeError (+ "original recipe is missing source asset: " filename))))
      (let ((bytes (js-call Buffer :from (get asset :content) "base64")))
        (unless (and (= (get asset :encoding) "base64")
                     (= (js-call bytes :toString "base64") (get asset :content))
                     (= (js-length bytes) (get asset :bytes))
                     (= (corpus-hash bytes) (get asset :sha256)))
          (throw (new globalThis.TypeError (+ "original recipe source asset identity differs: " filename))))
        (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode bytes))))

  (defun request-imports (module)
    (let ((pending (read-string (get module :source) (get module :filename))) (result (js-array)))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :shift)) (items (get node :items))
               (head (and items (get (aref items 0) :name))))
          (cond
            ((= head "module") (Reflect/apply (get pending :push) pending (js-call items :slice 2)))
            ((or (= head "import") (= head "import-portable"))
             (let ((specifier (get (aref items 1) :value)))
               (when (and (= (value-type specifier) "string") (js-call specifier :startsWith "."))
                 (js-call result :push (js-call posix :normalize (js-call posix :join
                   (js-call posix :dirname (get module :filename)) specifier)))))))))
      result))

  (defun request-canonical-library-filenames (modules options assets)
    (let ((libraries (get options :literalSources)) (identity (get options :literalSourceIdentity))
          (proofs (new globalThis.Map)) (by-file (new globalThis.Map)))
      (unless (and (Array/isArray libraries) (Array/isArray identity)
                   (> (js-length libraries) 0) (= (js-length libraries) (js-length identity)))
        (throw (new globalThis.TypeError "original recipe requires its complete literal source declarations")))
      (js-call identity :forEach (lambda (proof)
        (when (js-call proofs :has (get proof :id))
          (throw (new globalThis.TypeError "original recipe literal source declarations repeat an identity")))
        (js-call proofs :set (get proof :id) proof)))
      (js-call libraries :forEach (lambda (library)
        (let* ((id (get library :id)) (filename (get library :filename))
               (proof (js-call proofs :get id)) (source (get library :source)))
          (unless (and proof (= (get proof :filename) filename) (= (value-type source) "string")
                       (= (get proof :sha256) (js-call (js-call (createHash "sha256") :update source "utf16le") :digest "hex"))
                       (= source (request-source assets filename))
                       (not (js-call by-file :has filename)))
            (throw (new globalThis.TypeError "original recipe literal source declarations differ from their source identity")))
          (js-call by-file :set filename library))))
      (js-call modules :forEach (lambda (module)
        (let ((library (js-call by-file :get (get module :filename))))
          (when (and library (js-call (get library :id) :startsWith "runtime/"))
            (unless (= (get module :source) (get library :source))
              (throw (new globalThis.TypeError "original recipe literal source declarations differ from their module source")))
            ;; Physical managed-runtime files are emitted at their canonical
            ;; runtime/* location. Keep the original output ID and source, and
            ;; do not overwrite a caller's already correct virtual filename.
            (put module :filename (+ (js-call (get library :id) :slice 0 -4) ".eli"))))))))

  (defun complete-request-sources (record request options &optional independent-seed)
    (let ((plan (or (js-call request-layouts :get (get record :id))
                    (when independent-seed (js-array (get record :entry) "stdlib")))))
      (when (and request plan (= (get record :entry) (aref plan 0)))
        (let ((modules (get request :modules)) (layout (aref plan 1)))
          (js-call modules :forEach (lambda (module)
            (when (or (= layout "compiler")
                      (and (= layout "entry") (= (get module :id) (get record :entry))))
              (put module :filename (+ (js-call (get module :id) :slice 0 -4) ".eli")))))
          (let ((source-assets (and options (get options :sourceAssets))))
            (unless (nullish? source-assets)
              (unless (Array/isArray source-assets)
                (throw (new globalThis.TypeError "original recipe source assets must be an array")))
              (let ((assets (new globalThis.Map)) (aliases (new globalThis.Map))
                    (hosts (cloneCompilerCorpusData (get request :hostSources (js-array)))) (index 0))
                (js-call source-assets :forEach (lambda (asset)
                  (let* ((filename (get asset :file)) (previous (js-call assets :get filename)))
                    (when (and previous (or (/= (get previous :sha256) (get asset :sha256))
                                           (/= (get previous :content) (get asset :content))))
                      (throw (new globalThis.TypeError (+ "original recipe has conflicting source assets: " filename))))
                    (js-call assets :set filename asset))))
                (when (= layout "stdlib") (request-canonical-library-filenames modules options assets))
                (js-call (js-call modules :concat hosts) :forEach (lambda (module)
                  (js-call aliases :set (js-call posix :normalize (get module :id)) module)
                  (js-call aliases :set (js-call posix :normalize (get module :filename)) module)))
                ;; Runtime providers are the exact archived implementations,
                ;; not synthetic declarations or a selected-host substitute.
                (unless (= layout "compiler")
                  (js-call assets :forEach (lambda (asset filename)
                    (when (and (or (js-call filename :startsWith "runtime/")
                                   (js-call filename :startsWith "platform/"))
                               (js-call filename :endsWith ".mjs")
                               (not (js-call aliases :has filename)))
                      (let ((provider (js-object :id filename :filename filename :source (request-source assets filename))))
                        (js-call hosts :push provider) (js-call aliases :set filename provider))))))
                (while (< index (js-length modules))
                  (js-call (request-imports (aref modules index)) :forEach (lambda (path)
                    (unless (js-call aliases :has path)
                      (let* ((filename (if (and (js-call path :endsWith ".mjs")
                                               (not (js-call path :startsWith "runtime/"))
                                               (not (js-call path :startsWith "platform/")))
                                          (+ (js-call path :slice 0 -4) ".eli") path))
                             (id (if (js-call path :endsWith ".eli") (+ (js-call path :slice 0 -4) ".mjs") path))
                             (module (js-object :id id :filename filename :source (request-source assets filename))))
                        (when (or (js-call aliases :has id) (js-call aliases :has filename))
                          (throw (new globalThis.TypeError (+ "original recipe source alias conflicts: " path))))
                        (if (js-call filename :endsWith ".mjs")
                          (js-call hosts :push module)
                          (js-call modules :push module))
                        (js-call aliases :set id module) (js-call aliases :set filename module)))))
                  (setq index (1+ index)))
                (when (or (> (js-length hosts) 0) (Object/hasOwn request "hostSources"))
                  (put request :hostSources hosts)))))))
      request))

  (defun prepareOriginalSeedSources (record options)
    ;; Independent Seed needs the same authenticated dependency declarations
    ;; even for recipes whose selected session already registered its literals.
    ;; This does not change the public request or invent a different record ID.
    (let ((request (compilerCorpusRequest record "javascript" options)))
      (if (js-call request-layouts :has (get record :id)) request
        (complete-request-sources record request options t))))

  (defun originalSequenceNativeInteropP (record)
    (and (not (nullish? record)) (not (nullish? (get record :original)))
      (= (get (get record :original) :suite) "tests/wasm-managed-sequence-data.test.mjs")
      (js-call (new globalThis.RegExp
        "^original-managed:sequence-data-(relational-set|standard-identities):(node|bun):auto-65536$")
        :test (get record :id))))
  (defun transportOriginalSequenceRuntime (record libraries)
    (if (not (originalSequenceNativeInteropP record)) record
      (let ((canonical (new globalThis.Map)) (proofs (new globalThis.Map))
            (modules (js-array)) (evidence (js-array)))
        (unless (Array/isArray libraries)
          (throw (new globalThis.TypeError "original sequence runtime import transport requires real literal sources")))
        (js-call (get (get record :original) :sourceAssets) :forEach
          (lambda (asset) (js-call proofs :set (get asset :file) (get asset :sourceSha256))))
        (js-call libraries :forEach (lambda (library)
          (unless (= (js-call proofs :get (get library :filename)) (corpus-hash (get library :source)))
            (throw (new globalThis.TypeError "original sequence runtime source identity differs")))
          (js-call canonical :set (get library :id) library)))
        (js-call (get record :modules) :forEach (lambda (module)
          (let* ((id (get module :id)) (source (get module :source))
                 (library (js-call canonical :get id)))
            (if (and (js-call id :startsWith "runtime/") library)
              (unless (= source (get library :source))
                (throw (new globalThis.TypeError "original sequence runtime source identity differs")))
              (let ((pending (read-string source (get module :filename))) (changes (js-array)))
                ;; This is the same import-node relocation performed by the
                ;; authentic suite before emitting its ordinary JS oracle.
                ;; Reader coordinates count Unicode points; untouched source,
                ;; including comments, literals and lone surrogates, is retained.
                (while (> (js-length pending) 0)
                  (let* ((form (js-call pending :shift)) (items (get form :items))
                         (head (and items (> (js-length items) 0) (get (aref items 0) :name))))
                    (cond
                      ((= head "module") (Reflect/apply (get pending :push) pending (js-call items :slice 2)))
                      ((or (= head "import") (= head "import-portable"))
                       (let* ((token (aref items 1)) (specifier (get token :value)))
                         (when (and (= (value-type specifier) "string") (js-call specifier :startsWith "."))
                           (let* ((target (js-call posix :normalize (js-call posix :join (js-call posix :dirname id) specifier)))
                                  (provider (js-call canonical :get target)))
                             (when (and provider (js-call target :startsWith "runtime/"))
                               (js-call changes :push (js-object
                                 :start (get (get token :span) :start)
                                 :end (get (get token :span) :end)
                                 :from specifier :to (+ "eliscript/" target)))))))))))
                (let ((points (Array/from source)) (routed source))
                  (js-call changes :sort (lambda (left right) (- (get right :start) (get left :start))))
                  (js-call changes :forEach (lambda (change)
                    (let ((start (get change :start)) (end (get change :end)))
                      (unless (and (Number/isSafeInteger start) (Number/isSafeInteger end)
                                   (>= start 0) (> end start) (<= end (js-length points)))
                        (throw (new globalThis.TypeError "original sequence runtime import span differs")))
                      (unless (= (JSON/parse (js-call (js-call points :slice start end) :join "")) (get change :from))
                        (throw (new globalThis.TypeError "original sequence runtime import span differs")))
                      (setq points (js-call (js-call points :slice 0 start) :concat
                        (Array/from (JSON/stringify (get change :to))) (js-call points :slice end))))))
                  (setq routed (js-call points :join ""))
                  (js-call modules :push (Object/assign (js-object) module (js-object :source routed)))
                  (js-call evidence :push (js-object :id id :sourceSha256 (corpus-hash source)
                    :transportSourceSha256 (corpus-hash routed) :imports changes))))))))
        (Object/assign (js-object) record (js-object :modules modules :runtimeImportTransport
          (js-object :kind "original-sequence-native-provider-imports" :modules evidence))))))

  (defun resource-field (value key) (if (nullish? value) undefined (get value key)))
  (defun resource-budget-specified-p (value)
    (and (not (nullish? value))
      (js-call (js-array "maxSlots" "initialBytes" "maxBytes") :some
        (lambda (key) (Object/hasOwn value key)))))
  (defun implicit-tool-resource-recipe-p (record)
    ;; This is admission after the matrix's source authentication, not a new
    ;; provenance certificate. Only these retained positive tool recipes had
    ;; implicit host defaults rather than a declared capacity contract.
    (let* ((id (resource-field record "id")) (original (resource-field record "original"))
           (formatter (= id "original-program:formatter-node"))
           (macro (or (= id "original-program:macro-generated-names-bun")
                      (= id "original-program:macro-generated-names-node")))
           (suite (if formatter "tests/bootstrap-formatter.test.mjs" "tests/macro-generated-names.test.mjs"))
           (filename (if formatter "bootstrap/compiler/formatter.eli" "generated-names.eli"))
           (entry (if formatter "bootstrap/compiler/formatter.mjs" "generated-names.mjs"))
           (regions (resource-field original "regions")) (modules (resource-field record "modules"))
           (sha (new globalThis.RegExp "^[0-9a-f]{64}$")))
      (and (or formatter macro) (= (resource-field original "suite") suite)
           (= (resource-field original "host") suite)
           (= (resource-field original "fixture") (if formatter filename suite))
           (= (resource-field record "entry") entry)
           (= (value-type (resource-field original "sourceSha256")) "string")
           (js-call sha :test (get original :sourceSha256))
           (Array/isArray regions) (> (js-length regions) 0)
           (js-call regions :every (lambda (region)
             (and region (Number/isSafeInteger (get region :start)) (>= (get region :start) 0)
                  (Number/isSafeInteger (get region :end)) (> (get region :end) (get region :start))
                  (Number/isSafeInteger (get region :byteStart)) (>= (get region :byteStart) 0)
                  (Number/isSafeInteger (get region :byteEnd)) (> (get region :byteEnd) (get region :byteStart))
                  (= (value-type (get region :sha256)) "string") (js-call sha :test (get region :sha256)))))
           (Array/isArray modules)
           (= (js-length (js-call modules :filter (lambda (module)
             (and (= (get module :id) entry) (= (get module :filename) filename)
                  (= (value-type (get module :source)) "string"))))) 1))))
  (defun implicit-core-exit-resource-recipe-p (record)
    (let ((original (resource-field record "original")) (id (resource-field record "id")))
      (and (js-call (js-array "vector" "map" "set") :some (lambda (name)
             (= id (+ "stable-compatibility:program:persistent-core-exit-" name))))
           (= (resource-field original "manifest") "stable-compatibility")
           (= (resource-field original "fixture") "stdlib/value.eli")
           (= (resource-field original "host") "tests/fixtures/persistent-core-exit-host.mjs")
           (= (resource-field record "entry") "value.mjs")
           (Array/isArray (resource-field record "modules"))
           (= (js-length (js-call (get record :modules) :filter (lambda (module)
             (and (= (get module :id) "value.mjs") (= (get module :filename) "stdlib/value.eli")
                  (= (value-type (get module :source)) "string"))))) 1))))
  (defun million-core-exit-resource-recipe-p (record)
    (let* ((id (resource-field record "id")) (execution (resource-field record "execution"))
           (arguments (resource-field execution "arguments"))
           (collection (when (Array/isArray arguments) (resource-field (aref arguments 1) "literal"))))
      (and (implicit-core-exit-resource-recipe-p record)
           (js-call (js-array "vector" "map" "set") :includes collection)
           (= id (+ "stable-compatibility:program:persistent-core-exit-" collection))
           (= (resource-field execution "host") "tests/fixtures/persistent-core-exit-host.mjs")
           (= (js-length arguments) 2) (= (resource-field (aref arguments 0) "directory") t))))
  (defun retained-deep-walk-resource-recipe-p (record)
    (let* ((original (resource-field record "original"))
           (fixture "tests/fixtures/persistent-tree-walk.eli")
           (modules (resource-field record "modules"))
           (entry (when (Array/isArray modules)
             (js-call modules :find (lambda (item) (= (get item :id) (get record :entry)))))))
      (and (js-call (js-array "stable-compatibility:program:tests/fixtures/persistent-tree-walk.eli"
                   "original-program:persistent-tree-walk-complete-hosts") :includes (resource-field record "id"))
           (= (resource-field original "manifest") "stable-compatibility")
           (= (resource-field original "fixture") fixture)
           (= (resource-field original "host") "tests/fixtures/persistent-tree-walk-host.mjs")
           entry (= (get entry :filename) fixture) (= (value-type (get entry :source)) "string")
           (js-call (get entry :source) :includes "(depth 12000)"))))
  (defun compilerCorpusFunctionalResources (record options)
    (let ((profile (resource-field options "functionalRuntimeProfile")) (result undefined))
      (unless (undefined? profile)
        (unless (= profile "small")
          (throw (new globalThis.TypeError "functionalRuntimeProfile must be small when explicitly supplied")))
        (let* ((id (resource-field record "id")) (execution (resource-field record "execution"))
               (original (resource-field record "original")) (expected (resource-field record "expected"))
               (provided (resource-field options "runtimeOptions"))
               (declared (resource-field execution "runtimeOptions"))
               (sequence (and (= (value-type id) "string")
                 (js-call (new globalThis.RegExp "^original-managed:sequence-data(?::|-)") :test id)
                 (= (resource-field original "suite") "tests/wasm-managed-sequence-data.test.mjs")
                 (= (resource-field original "fixture") "tests/fixtures/wasm-managed-sequence-data.eli")))
               (ordinary (and (or (implicit-tool-resource-recipe-p record)
                 (implicit-core-exit-resource-recipe-p record)
                 (and (= (resource-field original "manifest") "stable-compatibility")
                 (= (value-type (resource-field original "fixture")) "string")
                 (or (= id (+ "stable-compatibility:program:" (get original :fixture)))
                     (and (= (value-type id) "string") (js-call id :startsWith "original-program:")))))
                 (not (resource-budget-specified-p provided)) (not (resource-budget-specified-p declared))
                 (not (= (resource-field execution "runtimeProfile") "compiler")))))
          ;; No admission by failure text. Raw low-slot, OOM, refusal and
          ;; recovery contracts stay strict even during functional acceptance.
          (when (and (= (value-type id) "string") (or sequence ordinary)
                     (not (js-call (new globalThis.RegExp "(?:^|[-:])(?:negative|oom|capacity|recovery|recover|refusal|exhaustion)(?:[-:]|$)") :test id))
                     (= (resource-field record "kind") "project") (not (Object/hasOwn record "error"))
                     (= (resource-field execution "kind") "original-program")
                     (= (resource-field expected "kind") "seed-program") (= (resource-field expected "oracleRequired") t))
            (let* ((selected-profile (if (or (million-core-exit-resource-recipe-p record)
                                          (retained-deep-walk-resource-recipe-p record)) "full-compiler" "small"))
                   (resources (independentCompilerResources (js-object :profile selected-profile)))
                   (before (Object/assign (js-object)
                     (if sequence (js-object) (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216 :auto 0))
                     provided declared
                     (if (undefined? (resource-field record "auto")) (js-object) (js-object :auto (get record :auto)))))
                   (explicit-auto (or (and provided (Object/hasOwn provided "auto"))
                                      (and declared (Object/hasOwn declared "auto"))
                                      (not (undefined? (resource-field record "auto")))))
                   (after (Object/assign (js-object) before (get resources :budget)
                     (if (or sequence explicit-auto) (js-object) (js-object :auto (get resources :auto))))))
              (setq result (js-object :functionalRuntimeProfile "small" :effectiveRuntimeProfile selected-profile :resourceAcceptance "deferred"
                :originalRuntimeOptions before :effectiveRuntimeOptions after))))))
      result))

  (defun compilerCorpusResourceDeferred (record target options)
    (let* ((id (resource-field record "id"))
           (rows (js-array
             (js-array "stable-compatibility:program:persistent-core-exit-vector" "vector" nil)
             (js-array "stable-compatibility:program:persistent-core-exit-map" "map" nil)
             (js-array "stable-compatibility:program:persistent-core-exit-set" "set" nil)
             (js-array "original-program:portable-persistent-vector-1" "vector" "Eliscript-authored persistent vector keeps million-value trie bounds")
             (js-array "original-program:portable-persistent-map-2" "map" "Eliscript-authored HAMT Map shares the million-key update path")
             (js-array "original-program:portable-persistent-set-2" "set" "Eliscript-authored persistent Set shares the million-member update path")))
           (row (js-call rows :find (lambda (entry) (= (aref entry 0) id)))) (result undefined))
      (when (and row (= (resource-field options "functionalRuntimeProfile") "small")
                 (js-call (js-array "javascript" "wasm" "native") :includes target)
                 (not (undefined? (compilerCorpusFunctionalResources record options))))
        (let* ((original (get record :original)) (execution (get record :execution))
               (assets (new globalThis.Map)) (input (resource-field options "sourceAssets"))
               (name (aref row 1)) (assertion (aref row 2)) (suite-source undefined)
               (proofs (js-array))
               (refuse (lambda () (throw (new globalThis.TypeError "million-value resource deferral source identity differs")))))
          (unless (Array/isArray input) (funcall refuse))
          (js-call input :forEach (lambda (asset)
            (let ((previous (js-call assets :get (get asset :file))))
              (when (and previous (or (/= (get previous :sha256) (get asset :sha256))
                                     (/= (get previous :content) (get asset :content)))) (funcall refuse))
              (js-call assets :set (get asset :file) asset))))
          (unless (= (get original :manifest) "stable-compatibility") (funcall refuse))
          (if (nil? assertion)
            (progn
              (unless (million-core-exit-resource-recipe-p record) (funcall refuse))
              (setq suite-source (request-source assets "tests/fixtures/persistent-core-exit-host.mjs"))
              (unless (= (resource-field execution "hostSource") suite-source) (funcall refuse))
              (js-call proofs :push (js-object :file "tests/fixtures/persistent-core-exit-host.mjs" :sha256 (corpus-hash suite-source))))
            (let* ((suite (+ "tests/portable-persistent-" name ".test.mjs"))
                   (fixture (+ "stdlib/persistent-" name ".eli"))
                   (regions (resource-field original "regions")) (million-region false))
              (unless (and (= (get original :suite) suite) (= (get original :host) suite)
                           (= (get original :fixture) fixture) (= (get original :originalAssertion) assertion)
                           (= (get record :entry) (+ "persistent-" name ".mjs"))
                           (Array/isArray regions) (> (js-length regions) 0)) (funcall refuse))
              (setq suite-source (request-source assets suite))
              (unless (= (corpus-hash suite-source) (get original :sourceSha256)) (funcall refuse))
              (js-call proofs :push (js-object :file suite :sha256 (corpus-hash suite-source)))
              (let ((bytes (js-call Buffer :from suite-source)))
                (js-call regions :forEach (lambda (region)
                  (let ((start (get region :start)) (end (get region :end))
                        (byte-start (get region :byteStart)) (byte-end (get region :byteEnd)))
                    (unless (and (Number/isSafeInteger start) (Number/isSafeInteger end)
                                 (Number/isSafeInteger byte-start) (Number/isSafeInteger byte-end)
                                 (>= start 0) (> end start) (<= end (js-length suite-source))
                                 (>= byte-start 0) (> byte-end byte-start) (<= byte-end (js-length bytes))
                                 (= (corpus-hash (js-call bytes :subarray byte-start byte-end)) (get region :sha256))
                                 (= (js-call (js-call bytes :subarray byte-start byte-end) :toString "utf8")
                                    (js-call suite-source :slice start end))) (funcall refuse))
                    (when (js-call (js-call suite-source :slice start end) :includes "1_000_000") (setq million-region t)))))
              (unless million-region (funcall refuse)))))
          ;; The complete source and original assertion remain in the corpus.
          ;; This private admission grants only a deferred resource receipt.
          (unless (and (= (value-type (get execution :hostSource)) "string")
                       (js-call (get execution :hostSource) :includes "1_000_000")) (funcall refuse))
          (let* ((entry (js-call (get record :modules) :find (lambda (module) (= (get module :id) (get record :entry)))))
                 (filename (and entry (get entry :filename))))
            (unless (and entry (= (get entry :source) (request-source assets filename))) (funcall refuse))
            (js-call proofs :push (js-object :file filename :sha256 (corpus-hash (get entry :source)))))
          (setq result (js-object :id id :target target :status "resource-deferred" :verification "deferred"
            :functionalRuntimeProfile "small" :fullCorpusVerification "unverified" :valueCount 1000000
            :reason "explicit functional profile defers the authenticated million-value synchronous host job; retained WeakRef views exceed managed slot capacity and incur quadratic cache scans"
            :sourceProofs proofs :originalAssertion (resource-field original "originalAssertion")
            :hostSourceSha256 (corpus-hash (get execution :hostSource)))))) result))

  (defun original-foreign-entry-p (record options)
    (let* ((execution (get record :execution)) (expected (get record :expected))
           (original (get record :original))
           (assets-input (and options (get options :sourceAssets)))
           (host-source (and execution (get execution :hostSource)))
           (host-eval (and execution (get execution :hostEval))))
      (when (and execution expected (= (get execution :kind) "original-program")
                 (= (get expected :kind) "seed-program") (= (get expected :oracleRequired) t)
                 (= (get execution :aliases) t) (not (= (get execution :zeroImports) t))
                 (or (and (= (value-type host-source) "string") (> (js-length host-source) 0))
                     (and (= (value-type host-eval) "string") (> (js-length host-eval) 0)))
                 (not (nullish? assets-input)))
        (unless (Array/isArray assets-input)
          (throw (new globalThis.TypeError "original recipe source assets must be an array")))
        (let ((assets (new globalThis.Map)) (authenticated false))
          (js-call assets-input :forEach (lambda (asset)
            (let ((file (get asset :file)) (previous (js-call assets :get (get asset :file))))
              (when (and previous (or (/= (get previous :sha256) (get asset :sha256))
                                     (/= (get previous :content) (get asset :content))))
                (throw (new globalThis.TypeError (str "original recipe has conflicting source assets: " file))))
              (js-call assets :set file asset))))
          ;; These are the existing source-bound original host contracts. The
          ;; private request gains a source-value boundary, never a fabricated
          ;; host module or an alteration of the archived original record.
          (js-call (js-array (and original (get original :host))
                    (and original (get original :suite)) (get execution :host)) :forEach (lambda (filename)
            (when (and (= (value-type filename) "string") (js-call assets :has filename))
              (request-source assets filename) (setq authenticated t))))
          (when (and original (Array/isArray (get original :sourceAssets)))
            (js-call (get original :sourceAssets) :forEach (lambda (proof)
              (let* ((filename (get proof :file)) (asset (js-call assets :get filename)))
                (unless (and asset (= (get proof :sourceSha256) (get asset :sha256)))
                  (throw (new globalThis.TypeError (str "original recipe source asset identity differs: " filename))))
                (request-source assets filename) (setq authenticated t)))))
          (unless authenticated
            (throw (new globalThis.TypeError "original foreign entry has no authenticated host source"))) t))))

  (defun compilerCorpusRequest (record target &rest arguments)
    (let ((request (Reflect/apply (get legacy :compilerCorpusRequest) undefined
                     (js-call (js-array record target) :concat arguments))))
      ;; These original hosts emit usage modules at their output root, beside
      ;; runtime/ and stdlib/. Their archived source filenames remain the real
      ;; tests/fixtures paths; only the private project request uses the same
      ;; virtual layout as the original compiler command's output directory.
      (let* ((names (js-array "core-set-usage" "core-stdlib-usage" "core-language-api-usage"))
             (name (js-call names :find (lambda (candidate)
               (and (= (get record :entry) (+ candidate ".mjs"))
                    (or (= (get record :id)
                           (+ "stable-compatibility:program:tests/fixtures/" candidate ".eli"))
                        (and (= candidate "core-set-usage")
                             (= (get record :id) "original-program:core-set-source-map"))
                        (and (= candidate "core-stdlib-usage")
                             (= (get record :id) "original-program:core-stdlib-complete-protocols"))))))))
        (when (and name request)
          (js-call (get request :modules) :forEach (lambda (module)
            (let ((fixture (js-call names :find (lambda (candidate)
                    (and (= (get module :id) (+ candidate ".mjs"))
                         (= (get module :filename) (+ "tests/fixtures/" candidate ".eli")))))))
              (when fixture (put module :filename (+ fixture ".eli"))))))))
      ;; This retained Node host imports the complete declared library graph,
      ;; including seq which the API fixture itself does not import. Preserve
      ;; that original output directory rather than pruning its host inputs.
      (when (and request
                 (= (get record :id) "stable-compatibility:program:tests/fixtures/core-language-api-usage.eli")
                 (= (get record :entry) "core-language-api-usage.mjs"))
        (put request :entries (js-call (get record :modules) :map (lambda (module) (get module :id)))))
      ;; The original multimethod family also shares one output directory.
      ;; Keep its existing stdlib source aliases and place only the declarative
      ;; fixture beside them for its unchanged ./multimethod.eli import.
      (when (and request
                 (or (= (get record :id) "stable-compatibility:program:stdlib/multimethod.eli")
                     (= (get record :id) "original-program:multimethod-complete-hosts"))
                 (= (get record :entry) "multimethod.mjs"))
        (js-call (get request :modules) :forEach (lambda (module)
          (when (and (= (get module :id) "declarative-multimethod.mjs")
                     (= (get module :filename) "tests/fixtures/declarative-multimethod.eli"))
            (put module :filename "stdlib/declarative-multimethod.eli")))))
      ;; A binary original-program host imports real ESM facades/exports. The
      ;; project interface must therefore be emitted in that same actual build;
      ;; runtime aliases cannot reconstruct it from a nonphased artifact.
      (when (and request (or (= target "wasm") (= target "native"))
                 (undefined? (get request :phased))
                 (get record :execution) (= (get (get record :execution) :kind) "original-program"))
        (put request :phased t))
      ;; The original compiler hosts initialize their runtime with this exact
      ;; resource profile. A later loader option cannot enlarge a binary whose
      ;; declared memory maximum was emitted with the generic tiny default.
      ;; Keep an explicit per-record memory contract ahead of profile defaults.
      (when (and request (or (= target "wasm") (= target "native"))
                 (get record :execution) (= (get (get record :execution) :kind) "original-program")
                 (= (get (get record :execution) :runtimeProfile) "compiler")
                 (nullish? (get record :memory)))
        (put request :memory (get (independentCompilerResources
          (if (> (js-length arguments) 0) (aref arguments 0) undefined)) :memory)))
      (when (and request (or (= target "wasm") (= target "native"))
                 (nullish? (get record :memory))
                 (compilerCorpusFunctionalResources record (if (> (js-length arguments) 0) (aref arguments 0) undefined)))
        (let ((acceptance (compilerCorpusFunctionalResources record (if (> (js-length arguments) 0) (aref arguments 0) undefined))))
          (put request :memory (get (independentCompilerResources (js-object :profile (get acceptance :effectiveRuntimeProfile))) :memory))))
      (setq request (complete-request-sources record request (if (> (js-length arguments) 0) (aref arguments 0) undefined)))
      (when (and request (originalSequenceNativeInteropP record))
        (let* ((options (if (> (js-length arguments) 0) (aref arguments 0) undefined))
               (transport (transportOriginalSequenceRuntime record (and options (get options :literalSources))))
               (ids (new globalThis.Set (js-call (get transport :modules) :map (lambda (module) (get module :id))))))
          (put request :modules (get transport :modules))
          (put request :runtimeImportTransport (get transport :runtimeImportTransport))
          (when (Array/isArray (get request :entries))
            (put request :entries (js-call (get request :entries) :filter (lambda (id) (js-call ids :has id)))))))
      (when (and request (or (= target "wasm") (= target "native"))
                 (not (Object/hasOwn request "foreignEntry"))
                 (original-foreign-entry-p record (if (> (js-length arguments) 0) (aref arguments 0) undefined)))
        (put request :foreignEntry t))
      request))

  (defun corpus-hash (value)
    (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun audit-symbol-p (node name)
    (and (not (nullish? node)) (= (get node :kind) "symbol") (= (get node :name) name)))
  (defun audit-list-p (node)
    (and (not (nullish? node)) (= (get node :kind) "list") (Array/isArray (get node :items))))
  (defun audit-head-p (node name)
    (and (audit-list-p node) (> (js-length (get node :items)) 0)
         (audit-symbol-p (aref (get node :items) 0) name)))

  (defun audit-final-assertion-p (node)
    (let ((current node) (searching t))
      ;; Follow only the final executed expression of the function's ordinary
      ;; lexical containers; text in comments or an unused nested form cannot
      ;; establish the source audit's final assertion.
      (while (and searching (audit-list-p current))
        (let* ((items (get current :items)) (head (aref items 0)))
          (if (or (audit-symbol-p head "let") (audit-symbol-p head "let*")
                  (audit-symbol-p head "progn"))
              (setq current (aref items (1- (js-length items))))
            (setq searching false))))
      (and (audit-head-p current "js-call") (= (js-length (get current :items)) 4)
        (let* ((items (get current :items)) (expectation (aref items 1))
               (method (aref items 2)) (empty (aref items 3)))
          (and (audit-head-p expectation "expect") (= (js-length (get expectation :items)) 2)
               (audit-symbol-p (aref (get expectation :items) 1) "violations")
               (= (get method :kind) "keyword") (= (get method :name) "toEqual")
               (audit-head-p empty "js-array") (= (js-length (get empty :items)) 1))))))

  (defun audit-unit-offset (source offset)
    (let ((unit 0) (point 0))
      (while (and (< point offset) (< unit (js-length source)))
        (let ((first (js-call source :charCodeAt unit)))
          (if (and (>= first 55296) (<= first 56319) (< (1+ unit) (js-length source))
                   (>= (js-call source :charCodeAt (1+ unit)) 56320)
                   (<= (js-call source :charCodeAt (1+ unit)) 57343))
              (setq unit (+ unit 2))
            (setq unit (1+ unit))))
        (setq point (1+ point)))
      (unless (= point offset)
        (throw (new globalThis.TypeError "literal source audit position is outside its actual source")))
      unit))

  ;; Tool-internal provenance helper. Reader parses data only; it never runs the
  ;; original test, nor can a matching comment substitute for its named form.
  (defun readOriginalLiteralRuntimeAudit (source filename expected-source-sha256)
    (unless (and (= (value-type source) "string") (= (value-type filename) "string")
                 (= (value-type expected-source-sha256) "string")
                 (= (corpus-hash source) expected-source-sha256))
      (throw (new globalThis.TypeError "literal source audit SHA-256 does not match its actual source")))
    (let* ((forms (read-string source filename)) (candidates (js-array)) (index 0))
      (while (< index (js-length forms))
        (let ((form (aref forms index)))
          (if (audit-head-p form "module")
              (let ((members (get form :items)) (position 2))
                (while (< position (js-length members))
                  (let ((member (aref members position)))
                    (when (and (audit-head-p member "defasync")
                               (audit-symbol-p (aref (get member :items) 1) "literal-runtime-source-audit"))
                      (js-call candidates :push member)))
                  (setq position (1+ position))))
            (when (and (audit-head-p form "defasync")
                       (audit-symbol-p (aref (get form :items) 1) "literal-runtime-source-audit"))
              (js-call candidates :push form))))
        (setq index (1+ index)))
      (unless (= (js-length candidates) 1)
        (throw (new globalThis.TypeError "literal source audit requires one complete named async form")))
      (let* ((form (aref candidates 0)) (items (get form :items))
             (span (get form :span))
             (start (audit-unit-offset source (get span :start)))
             (end (audit-unit-offset source (get span :end)))
             (body (js-call source :slice start end)))
        (unless (and (>= (js-length items) 4)
                     (= (get (aref items 2) :kind) "literal") (eq (get (aref items 2) :value) nil)
                     (audit-final-assertion-p (aref items (1- (js-length items)))))
          (throw (new globalThis.TypeError "literal source audit final empty violations assertion changed")))
        (js-object :file filename :sourceSha256 expected-source-sha256
          :region (js-object :start start :end end
            :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
            :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 end))
            :sha256 (corpus-hash body))))))

  (defasync restore-runtime-scan-recipe (document options)
    (let* ((id "original-program:compiler-module-runtime-scan")
           (records (get document :records)) (gate (get document :originalGateEvidence))
           (suite "tests/compiler-runtime-scan.test.mjs")
           (generated "tests/compiler-runtime-scan-selfhosted.test.mjs")
           (title "optimized compiler runtime scan matches its readable reference")
           (locators (js-call (get gate :locators) :filter (lambda (locator)
             (and (= (get locator :file) generated) (= (get locator :contains) title))))))
      (when (and (> (js-length locators) 0)
                 (not (js-call records :some (lambda (record) (= (get record :id) id)))))
        ;; Different stable feature IDs may bind the same original file/title.
        ;; One complete recipe executes that semantic case and retains every
        ;; original coverage ID; only repeated IDs are conflicting evidence.
        (let ((coverage-ids (js-call locators :map (lambda (locator) (get locator :id)))))
          (unless (= (get (new globalThis.Set coverage-ids) :size) (js-length locators))
            (throw (new globalThis.TypeError "runtime scan has duplicate original coverage identities"))))
        (let* ((source-root (get options :sourceRoot))
               (reader (createOriginalCorpusSourceReader (js-object :sourceRoot source-root)))
               (source (await (js-call reader :text suite)))
               (proof (await (js-call reader :file suite)))
               (locator-proof (await (js-call reader :file generated)))
               (originals (get options :originals))
               (parity (get (js-call (get originals :manifests) :find
                 (lambda (item) (= (get item :id) "compiler-parity"))) :document))
               (files (get parity :bootstrapSources)) (modules (js-array))
               (regions (js-array)) (index 0))
          ;; Keep the original bytes and all three exact legacy regions. Only
          ;; the locator moved to the maintained generated suite; it has its
          ;; own authenticated identity, never the old file's invented spans.
          (js-call (js-array
              (js-array "async function run(" "\ntest(")
              (js-array "    const module = (name) => import(" "\n  } finally {")
              (js-array "const compilerSources = [" "\n];")) :forEach (lambda (pair)
            (let* ((start (js-call source :indexOf (aref pair 0)))
                   (end (js-call source :indexOf (aref pair 1) start)))
              (unless (and (>= start 0) (> end start)
                           (< (js-call source :indexOf (aref pair 0) (1+ start)) 0))
                (throw (new globalThis.TypeError "original runtime scan source region differs")))
              (js-call regions :push (js-object :start start :end end
                :byteStart (js-call Buffer :byteLength (js-call source :slice 0 start))
                :byteEnd (js-call Buffer :byteLength (js-call source :slice 0 end))
                :sha256 (corpus-hash (js-call source :slice start end)))))))
          (unless (and (Array/isArray files) (= (js-length files) 13))
            (throw (new globalThis.TypeError "runtime scan requires its complete original thirteen compiler modules")))
          (while (< index (js-length files))
            (let ((filename (aref files index)))
              (js-call modules :push (js-object :id (+ (js-call filename :slice 0 -4) ".mjs")
                :filename filename :source (await (js-call reader :text filename)))))
            (setq index (1+ index)))
          (let* ((coverage (js-call locators :map (lambda (locator) (get locator :id))))
                 (entries (js-call modules :map (lambda (module) (get module :id))))
                 (original (js-object :manifest "stable-compatibility" :suite suite :fixture suite :host suite
                   :sourceSha256 (get proof :sha256) :regions regions :originalAssertion title
                   :locatorSource (js-object :file generated :sourceSha256 (get locator-proof :sha256))
                   :sourceAssets (js-array (js-object :file generated :sourceSha256 (get locator-proof :sha256)))))
                 (record (js-object :id id :kind "project" :coverage coverage :modules modules
                   :entry "bootstrap/compiler/compiler.mjs"
                   :request (js-object :operation "project" :resolveImports t :phased t :sourceMap t :entries entries)
                   :execution (js-object :kind "original-program"
                     :host "tests/__eliscript_original_compiler_runtime-scan.mjs"
                     :arguments (js-array (js-object :directory t)) :aliases t :requiresBun t :runtimeProfile "compiler")
                   :expected (js-object :kind "seed-program" :oracleRequired t :stdout "") :original original))
                 (position (js-call records :findIndex (lambda (item)
                   (= (get item :id) "original-program:compiler-module-source-map-cursor")))))
            (when (< position 0) (setq position (js-length records)))
            (js-call records :splice position 0 record)
            (js-call (get document :expectedIds) :splice position 0 id)
            (put document :missingCaseAdapters (js-call (get document :missingCaseAdapters) :filter
              (lambda (item) (not (js-call coverage :includes (get item :coverageId))))))
            (put gate :coverageIds (js-call (get gate :coverageIds) :filter
              (lambda (value) (not (js-call coverage :includes value)))))
            (put gate :hostOnlyDependencies (js-call (get gate :hostOnlyDependencies) :filter
              (lambda (item) (not (js-call coverage :includes (get item :coverageId)))))))
          (let ((evidence (get document :evidence)))
            (js-call (js-array proof locator-proof) :forEach (lambda (asset)
              (let ((prior (js-call evidence :find (lambda (item) (= (get item :file) (get asset :file))))))
                (if prior
                  (unless (and (= (get prior :sha256) (get asset :sha256)) (= (get prior :content) (get asset :content)))
                    (throw (new globalThis.TypeError "runtime scan original source identity differs")))
                  (js-call evidence :push asset)))))))))
    document)

  (defasync runtime-scan-replay (document options)
    (let ((record (js-call (get document :records) :find (lambda (item)
                    (= (get item :id) "original-program:compiler-module-runtime-scan")))))
      (when record
        (let* ((source-root (get options :sourceRoot))
               (reader (createOriginalCorpusSourceReader (js-object :sourceRoot source-root)))
               (assets (js-array "tools/compiler/eliscript/runtime-scan-cases.eli"
                         "tools/compiler/runtime-scan-cases.mjs" "tests/eliscript/compiler-runtime-scan.eli"))
               (proofs (js-array)) (index 0))
          (while (< index (js-length assets))
            (let* ((filename (aref assets index)) (asset (await (js-call reader :file filename)))
                   (previous (js-call (get document :evidence) :find (lambda (item) (= (get item :file) filename)))))
              (when (and previous (/= (get previous :sha256) (get asset :sha256)))
                (throw (new globalThis.TypeError "runtime scan replay source identity differs")))
              (unless previous (js-call (get document :evidence) :push asset))
              (js-call proofs :push (js-object :file filename :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (let* ((source (str "(import " (JSON/stringify (resolve source-root "tools/compiler/runtime-scan-cases.mjs"))
                    " verifyRuntimeScan)\n(import \"node:path\" resolve)\n"
                    "(defasync run () (await (verifyRuntimeScan (resolve (aref (get globalThis.process :argv) 2) \"bootstrap/compiler\") "
                    "(get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))))\n"
                    "(js-call (run) :catch (lambda (error) (js-call (get globalThis.process :stderr) :write (str (get error :stack error) \"\\n\")) (put globalThis.process :exitCode 1)))\n"))
                 (execution (get record :execution)) (original (get record :original))
                 (old-assets (get original :sourceAssets (js-array))))
            ;; The old suite remains exact source evidence. Its whole original
            ;; semantic case is maintained in Eli, including every input and
            ;; strict field; the newly introduced Math field is now explicit.
            (put execution :hostSource (compile-string source "runtime-scan-replay.eli"))
            (put original :sourceAssets (js-call old-assets :concat proofs))
            (put original :setupReplacement
              (js-object :kind "maintained-eli-runtime-scan-case" :sourceAssets proofs
                :originalSourceSha256 (get original :sourceSha256)
                :changes (js-array "declare the actual math requirement in both exact schema models")
                :compilerDirectory "selected-artifact/bootstrap/compiler" :fallback false))))))
    document)

  ;; This is an original-host dependency transport, not an assertion rewrite.
  ;; The host body and golden remain their archived bytes. The maintained Eli
  ;; matcher uses public reflection for real source views before delegating to
  ;; the same Bun matcher; ordinary JS values retain the original matcher.
  (defconst matcher-records (js-array
    "stable-compatibility:program:tests/fixtures/core-stdlib-usage.eli"
    "original-program:core-stdlib-complete-protocols"))
  (defconst matcher-files (js-array "tools/backends/eliscript/compiler-corpus-matchers.eli"
    "tools/backends/compiler-corpus-matchers.mjs"
    "tools/backends/eliscript/managed-source-view.eli" "tools/backends/managed-source-view.mjs"
    "tools/backends/eliscript/managed-host-proxy.eli" "tools/backends/managed-host-proxy.mjs"))
  (defun transportOriginalMatcherRecord (record source-root assets)
    (if (not (js-call matcher-records :includes (get record :id))) record
      (let* ((execution (get record :execution)) (original (get record :original))
             (source (get execution :hostSource)) (before "\"bun:test\"")
             (after (JSON/stringify (get (pathToFileURL
               (resolve source-root "tools/backends/compiler-corpus-matchers.mjs")) :href)))
             (seen (new globalThis.Set)))
        (unless (and (= (get execution :kind) "original-program") original
          (= (value-type source) "string") (Array/isArray assets)
          (= (js-length assets) (js-length matcher-files)))
          (throw (new globalThis.TypeError "original matcher transport declaration is incomplete")))
        (js-call assets :forEach (lambda (asset)
          (let ((name (get asset :file)) (digest (get asset :sourceSha256)))
            (unless (and (js-call matcher-files :includes name) (not (js-call seen :has name))
              (= (value-type digest) "string")
              (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test digest))
              (throw (new globalThis.TypeError "original matcher transport source identity is invalid")))
            (js-call seen :add name))))
        (let* ((line-end (js-call source :indexOf "\n"))
               (line (js-call source :slice 0 line-end)) (start (js-call line :indexOf before)))
          (unless (and (> line-end 0) (js-call line :startsWith "import ")
            (>= start 0) (= (js-call line :indexOf before (1+ start)) -1)
            (= (js-call line :slice (+ start (js-length before))) ";"))
            (throw (new globalThis.TypeError "original matcher import boundary changed")))
          (let* ((output (str (js-call source :slice 0 start) after
                           (js-call source :slice (+ start (js-length before)))))
                 (proofs (js-call (get original :sourceAssets (js-array)) :slice)))
            (js-call assets :forEach (lambda (asset)
              (let ((existing (js-call proofs :find (lambda (item) (= (get item :file) (get asset :file))))))
                (when (and existing (/= (get existing :sourceSha256) (get asset :sourceSha256)))
                  (throw (new globalThis.TypeError "original matcher source proof conflicts")))
                (unless existing (js-call proofs :push asset)))))
            (Object/assign (js-object) record (js-object
              :execution (Object/assign (js-object) execution (js-object :hostSource output))
              :original (Object/assign (js-object) original (js-object :sourceAssets proofs
                :matcherTransport (js-object :kind "managed-source-view-reflection-snapshot"
                  :originalHostSha256 (corpus-hash source) :transportedHostSha256 (corpus-hash output)
                  :originalSpecifier "bun:test" :sourceAssets assets :assertionsUnchanged t))))))))))

  (defasync matcher-transport (document options)
    (when (js-call (get document :records) :some (lambda (record)
      (js-call matcher-records :includes (get record :id))))
      (let* ((source-root (if (nullish? options) root (get options :sourceRoot root)))
             (reader (createOriginalCorpusSourceReader (js-object :sourceRoot source-root)))
             (proofs (js-array)) (index 0))
        (while (< index (js-length matcher-files))
          (let* ((name (aref matcher-files index)) (asset (await (js-call reader :file name)))
                 (existing (js-call (get document :evidence) :find (lambda (item) (= (get item :file) name)))))
            (when (and existing (or (/= (get existing :sha256) (get asset :sha256))
              (/= (get existing :content) (get asset :content))))
              (throw (new globalThis.TypeError "original matcher archived source identity conflicts")))
            (unless existing (js-call (get document :evidence) :push asset))
            (js-call proofs :push (js-object :file name :sourceSha256 (get asset :sha256))))
          (setq index (1+ index)))
        (put document :records (js-call (get document :records) :map (lambda (record)
          (transportOriginalMatcherRecord record source-root proofs))))))
    document)

  (defasync tools-cli-assets (document options)
    (let* ((ids (js-array "original-tools-artifact:compiler-session-tools:node"
                         "original-tools-artifact:compiler-session-tools:bun"))
           (records (js-call (get document :records) :filter
             (lambda (record) (js-call ids :includes (get record :id))))))
      (when (> (js-length records) 0)
        (let ((reader (createOriginalCorpusSourceReader options)) (proofs (js-array))
              (files (js-array "tools/backends/eliscript/compiler-corpus-tools-cli.eli"
                               "tools/backends/compiler-corpus-tools-cli.mjs")) (index 0))
          (while (< index (js-length files))
            (let* ((file (aref files index)) (asset (await (js-call reader :file file)))
                   (previous (js-call (get document :evidence) :find (lambda (item) (= (get item :file) file)))))
              (when (and previous (or (/= (get previous :sha256) (get asset :sha256))
                                     (/= (get previous :content) (get asset :content))))
                (throw (new globalThis.TypeError "original tools CLI source identity conflicts")))
              (unless previous (js-call (get document :evidence) :push asset))
              (js-call proofs :push (js-object :file file :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (js-call records :forEach (lambda (record)
            (let* ((original (get record :original))
                   (assets (js-call (get original :sourceAssets (js-array)) :slice)))
              (js-call proofs :forEach (lambda (proof)
                (let ((previous (js-call assets :find (lambda (item) (= (get item :file) (get proof :file))))))
                  (when (and previous (/= (get previous :sourceSha256) (get proof :sourceSha256)))
                    (throw (new globalThis.TypeError "original tools CLI declaration conflicts")))
                  (unless previous (js-call assets :push proof)))))
              (put original :sourceAssets assets)
              (put original :toolsCLITransport (js-object :kind "original-tools-final-cli" :sourceAssets proofs))))))))
    document)
  (defasync project-runtime-assets (document options)
    (let* ((records (js-call (get document :records) :filter (lambda (record)
             (let* ((original (get record :original))
                    (proofs (and original (get original :sourceAssets))))
               (and original
                 (or (js-call (js-array "tests/bootstrap-project.test.mjs" "tests/bootstrap-evaluation.test.mjs")
                       :includes (get original :suite))
                   (and (Array/isArray proofs) (js-call proofs :some (lambda (proof)
                     (= (get proof :file) "bootstrap/host/project.mjs"))))))))))
           (files (js-array "bootstrap/host/project.mjs" "bootstrap/host/project-legacy.mjs" "tools/project/project.eli")))
      (when (> (js-length records) 0)
        (js-call (js-array "math" "unicode-case" "unicode-case-data") :forEach (lambda (name)
          (js-call files :push (str "runtime/" name ".eli")
            (str "runtime/" name ".mjs") (str "runtime/" name ".mjs.map"))))
        (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot
                         (if (nullish? options) root (get options :sourceRoot root)))))
               (proofs (js-array)) (index 0))
          (while (< index (js-length files))
            (let* ((filename (aref files index)) (asset (await (js-call reader :file filename)))
                   (existing (js-call (get document :evidence) :find
                     (lambda (entry) (= (get entry :file) filename)))))
              (if existing
                (unless (and (= (get existing :bytes) (get asset :bytes))
                             (= (get existing :sha256) (get asset :sha256))
                             (= (get existing :encoding) (get asset :encoding))
                             (= (get existing :content) (get asset :content)))
                  (throw (new globalThis.TypeError (str "original project runtime source identity differs: " filename))))
                (js-call (get document :evidence) :push asset))
              (js-call proofs :push (js-object :file filename :sourceSha256 (get asset :sha256))))
            (setq index (1+ index)))
          (js-call records :forEach (lambda (record)
            (let* ((original (get record :original))
                   (assets (js-call (get original :sourceAssets (js-array)) :slice)))
              (js-call proofs :forEach (lambda (proof)
                (let ((existing (js-call assets :find (lambda (entry) (= (get entry :file) (get proof :file))))))
                  (if existing
                    (unless (= (get existing :sourceSha256) (get proof :sourceSha256))
                      (throw (new globalThis.TypeError (str "original project runtime dependency changed: " (get proof :file)))))
                    (js-call assets :push (Object/assign (js-object) proof))))))
              (put original :sourceAssets assets))))))) document)

  (defasync load-original-corpus (options)
    (let ((document (await (js-call legacy :loadOriginalCompilerCorpus options))))
      ;; The canonical HTTP literal imports the actual host provider. It is
      ;; source evidence and a hostSource, never a fabricated .eli module.
      (when (js-call (get document :records) :some
              (lambda (record) (js-call request-layouts :has (get record :id))))
        (let* ((reader (createOriginalCorpusSourceReader
                         (js-object :sourceRoot (if (nullish? options) root (get options :sourceRoot root)))))
               (provider (await (js-call reader :file "platform/http.mjs")))
               (existing (js-call (get document :evidence) :find
                           (lambda (asset) (= (get asset :file) "platform/http.mjs")))))
          (if existing
            (unless (and (= (get existing :sha256) (get provider :sha256))
                         (= (get existing :content) (get provider :content)))
              (throw (new globalThis.TypeError "original recipe HTTP provider source identity differs")))
            (js-call (get document :evidence) :push provider))))
      (await (restore-runtime-scan-recipe document options))
      (await (runtime-scan-replay document options))
      (await (matcher-transport document options))
      (await (tools-cli-assets document options))
      (await (project-runtime-assets document options))))

  (defasync loadOriginalCompilerCorpus (options)
    (let* ((source-root (get options :sourceRoot)) (originals (get options :originals)))
      (if (or (nullish? originals) (not (Array/isArray (get originals :manifests)))
              (/= (value-type source-root) "string"))
          (await (load-original-corpus options))
        (let ((stable (js-call (get originals :manifests) :find
                        (lambda (item) (= (get item :id) "stable-compatibility")))))
          (if (nullish? stable)
              (await (load-original-corpus options))
            (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot source-root)))
                   (conformance (JSON/parse (await (js-call reader :text "tests/conformance/manifest.json"))))
                   (features (get conformance :features)) (matches (js-array))
                   (feature-ids (get (get stable :document) :stableCoreFeatureIds)) (index 0))
              (while (< index (js-length feature-ids))
                (let* ((feature-id (aref feature-ids index))
                       (feature (js-call features :find (lambda (item) (= (get item :id) feature-id))))
                       (locators (if (nullish? feature) (js-array) (get feature :evidence))) (position 0))
                  (while (< position (js-length locators))
                    (let ((locator (aref locators position)))
                      (when (and (= (get locator :file) literal-suite) (= (get locator :contains) literal-title))
                        (js-call matches :push (js-object
                          :id (+ "stable-compatibility:evidence:" feature-id ":" position)
                          :locator (Object/assign (js-object)
                            (js-object :id (+ "stable-compatibility:evidence:" feature-id ":" position) :featureId feature-id)
                            (funcall globalThis.structuredClone locator))))))
                    (setq position (1+ position))))
                (setq index (1+ index)))
              (unless (= (js-length matches) 1)
                (throw (new globalThis.TypeError "literal source audit must retain its unique original coverage locator")))
              (let* ((match (aref matches 0)) (id (get match :id))
                     (required (get originals :requiredCoverage)))
                (if (not (js-call required :includes id))
                    (await (load-original-corpus options))
                  (let* ((private-originals (Object/assign (js-object) originals
                            (js-object :requiredCoverage (js-call required :filter (lambda (value) (/= value id))))))
                         (document (await (load-original-corpus
                           (Object/assign (js-object) options (js-object :originals private-originals)))))
                         (evidence (js-call (get document :evidence) :find (lambda (asset) (= (get asset :file) literal-source)))))
                    (unless evidence
                      (throw (new globalThis.TypeError "literal source audit must be bound to its actual archived Eli source")))
                    (let* ((source (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t))
                                    :decode (js-call Buffer :from (get evidence :content) "base64")))
                           (audit (readOriginalLiteralRuntimeAudit source literal-source (get evidence :sha256)))
                           (gate (get document :originalGateEvidence))
                           (gate-ids (new globalThis.Set (get gate :coverageIds)))
                           (dependencies (get gate :hostOnlyDependencies))
                           (dependency (js-object :coverageId id :file literal-source :sourceSha256 (get audit :sourceSha256)
                             :kind "source-only-case" :originalAssertion literal-title :locator (get match :locator)
                             :region (get audit :region)
                             :reason "unchanged original source constructor audit; all compiled-language cases retain selected-session execution")))
                      (js-call gate-ids :add id)
                      (put gate :coverageIds (js-call required :filter (lambda (value) (js-call gate-ids :has value))))
                      ;; Gate dependencies retain their original relative order;
                      ;; the replacement occupies its denominator's exact place.
                      (let ((position (js-call dependencies :findIndex (lambda (item)
                                        (> (js-call required :indexOf (get item :coverageId))
                                           (js-call required :indexOf id))))))
                        (js-call dependencies :splice (if (< position 0) (js-length dependencies) position) 0 dependency))
                      (put document :coverageIds (Array/from required))
                      document))))))))))

  (export createOriginalCorpusSourceReader cloneCompilerCorpusData cloneCompilerCorpusModules
    compilerCorpusRequest prepareOriginalSeedSources loadOriginalCompilerCorpus readOriginalLiteralRuntimeAudit transportOriginalMatcherRecord
    originalSequenceNativeInteropP transportOriginalSequenceRuntime compilerCorpusFunctionalResources compilerCorpusResourceDeferred))
