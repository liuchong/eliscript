  (defun fixture-consumer-region (source filename token)
    (let ((pending (read-string source filename)) (found undefined))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :pop)))
          (when (and (undefined? found) (= (get node :kind) "literal")
                     (= (value-type (get node :value)) "string")
                     (js-call (get node :value) :includes token)) (setq found node))
          (when (Array/isArray (get node :items))
            (Reflect/apply (get pending :push) pending (get node :items)))))
      (unless found (throw (new globalThis.TypeError (str "maintained fixture consumer lost its actual source literal: " filename))))
      (let* ((span (get found :span))
             (start (audit-unit-offset source (get span :start)))
             (end (audit-unit-offset source (get span :end))))
        (js-object :start start :end end :byteStart (Buffer/byteLength (js-call source :slice 0 start))
          :byteEnd (Buffer/byteLength (js-call source :slice 0 end))
          :sha256 (corpus-hash (js-call source :slice start end))))))

  (defasync bindOriginalMaintainedFixtureEvidence (document options)
    (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot (get options :sourceRoot root))))
           (gate (get document :originalGateEvidence))
           (missing (new globalThis.Map (js-call (get document :missingCaseAdapters) :map
             (lambda (item) (js-array (get item :file) item)))))
           (pending (js-array)) (errors (js-array)) (assets (new globalThis.Map)) (index 0))
      (unless (and (= (get gate :required) t) (= (get (get gate :execution) :provider) "local")
                   (= (get (get gate :execution) :command) "make test-core"))
        (throw (new globalThis.TypeError "maintained fixture coverage requires the real original host gate")))
      ;; Validate the entire batch before assigning any coverage. Independent
      ;; source/consumer failures are retained together, without partial claims.
      (while (< index (js-length maintained-fixture-plans))
        (let* ((plan (aref maintained-fixture-plans index)) (filename (aref plan 0))
               (unmapped (js-call missing :get filename)))
          (when unmapped
            (try
              (let* ((source (await (js-call reader :text filename)))
                     (source-proof (await (js-call reader :file filename)))
                     (artifact (str (js-call filename :slice 0 -4) ".mjs"))
                     (artifact-proof (await (js-call reader :file artifact)))
                     (actual (js-call (await (js-call reader :text artifact)) :replace
                       (new globalThis.RegExp "\\n?//# sourceMappingURL=[^\\r\\n]*\\r?\\n?$") "\n"))
                     (expected (compile-string source filename))
                     (bindings (js-array)) (detail undefined))
                (unless (= (js-call actual :trimEnd) (js-call expected :trimEnd))
                  (throw (new globalThis.TypeError "fixture source differs from its complete generated artifact")))
                (js-call assets :set filename source-proof) (js-call assets :set artifact artifact-proof)
                (if (= (aref plan 1) "program-asset")
                  (js-call (aref plan 2) :forEach (lambda (id)
                    (let* ((record (js-call (get document :records) :find (lambda (record) (= (get record :id) id))))
                           (original (and record (get record :original)))
                           (proof (and original (js-call (get original :sourceAssets (js-array)) :find
                             (lambda (asset)
                               (or (and (= (get asset :file) filename)
                                     (= (get asset :sourceSha256) (get source-proof :sha256)))
                                   (and (= (get asset :file) artifact)
                                     (= (get asset :sourceSha256) (get artifact-proof :sha256))))))))
                           (module (and record (js-call (get record :modules (js-array)) :find
                             (lambda (module) (and (= (get module :filename) filename) (= (get module :source) source)))))))
                      (unless (and record (or proof module))
                        (throw (new globalThis.TypeError (str "selected program lost its exact maintained fixture asset: " id))))
                      (js-call bindings :push record))))
                  (let* ((consumer (aref (aref plan 2) 0)) (token (aref (aref plan 2) 1))
                         (text (await (js-call reader :text consumer)))
                         (proof (await (js-call reader :file consumer)))
                         (region (fixture-consumer-region text consumer token)))
                    (js-call assets :set consumer proof)
                    (setq detail (js-object :consumer consumer :consumerSha256 (get proof :sha256) :region region
                      :hostGate "make test-core" :executionStatus "not-executed-by-this-binding"))))
                (js-call pending :push (js-object :coverageId (get unmapped :coverageId) :file filename
                  :sourceSha256 (get source-proof :sha256) :artifact artifact :artifactSha256 (get artifact-proof :sha256)
                  :kind (aref plan 1) :records bindings :consumer detail)))
              (catch error (js-call errors :push (str filename ": " (get error :message)))))))
        (setq index (1+ index)))
      (when (> (js-length errors) 0)
        (throw (new globalThis.TypeError (str "maintained fixture bindings failed:\n" (js-call errors :join "\n")))))
      (let ((claimed (new globalThis.Set)) (gate-ids (new globalThis.Set (get gate :coverageIds))))
        (js-call pending :forEach (lambda (binding)
          (let ((id (get binding :coverageId)))
            (js-call claimed :add id)
            (if (= (get binding :kind) "program-asset")
              (js-call (get binding :records) :forEach (lambda (record)
                (unless (js-call (get record :coverage) :includes id) (js-call (get record :coverage) :push id))
                (let* ((original (get record :original))
                       (proofs (get original :maintainedFixtureAssets (js-array))))
                  (js-call proofs :push (js-object :file (get binding :file) :sourceSha256 (get binding :sourceSha256)
                    :artifact (get binding :artifact) :artifactSha256 (get binding :artifactSha256)))
                  (put original :maintainedFixtureAssets proofs))))
              (progn
                (js-call gate-ids :add id)
                (js-call (get gate :hostOnlyDependencies) :push
                  (js-object :coverageId id :file (get binding :file) :sourceSha256 (get binding :sourceSha256)
                    :artifact (get binding :artifact) :artifactSha256 (get binding :artifactSha256)
                    :kind "maintained-test-harness-fixture" :consumer (get binding :consumer)
                    :reason "exact migrated harness source and emitted module; only its original required host gate may assert execution")))))))
        (put gate :coverageIds (js-call (get document :coverageIds) :filter (lambda (id) (js-call gate-ids :has id))))
        (put document :missingCaseAdapters (js-call (get document :missingCaseAdapters) :filter
          (lambda (item) (not (js-call claimed :has (get item :coverageId))))))
        (js-call (Array/from (js-call assets :values)) :forEach (lambda (asset)
          (let ((prior (js-call (get document :evidence) :find (lambda (entry) (= (get entry :file) (get asset :file))))))
            (if prior
              (unless (and (= (get prior :sha256) (get asset :sha256)) (= (get prior :content) (get asset :content)))
                (throw (new globalThis.TypeError "maintained fixture archive source identity changed")))
              (js-call (get document :evidence) :push asset)))))) document))

  (defasync load-original-corpus (options)
    (let* ((document (await (js-call ground :loadOriginalCompilerCorpus (prepareOriginalBootstrapEmitterOptions options))))
           (reader (createOriginalCorpusSourceReader
                     (js-object :sourceRoot (if (nullish? options) root (get options :sourceRoot root)))))
           (bit-source (await (js-call reader :file "stdlib/bit.eli")))
           (bit-provider (await (js-call reader :file "stdlib/bit.mjs")))
           (bit-text (await (js-call reader :text "stdlib/bit.mjs"))))
      (js-call (js-array bit-source bit-provider) :forEach (lambda (asset)
        (let ((existing (js-call (get document :evidence) :find
                          (lambda (entry) (= (get entry :file) (get asset :file))))))
          (if existing
            (unless (and (= (get existing :sha256) (get asset :sha256))
                         (= (get existing :content) (get asset :content)))
              (throw (new globalThis.TypeError (+ "original runtime stdlib/bit source identity differs: " (get asset :file)))))
            (js-call (get document :evidence) :push asset)))))
      (js-call (get document :records) :forEach (lambda (record)
        (let ((hosts (and (get record :request) (get (get record :request) :hostSources)))
              (modules (get record :modules)))
          (when (and (Array/isArray hosts)
                     (js-call hosts :some (lambda (item) (= (get item :id) "runtime/literals.mjs")))
                     (or (js-call hosts :some (lambda (item) (= (get item :id) "runtime/core/value-internals.mjs")))
                         (js-call hosts :some (lambda (item) (= (get item :id) "runtime/core/map-internals.mjs"))))
                     (not (js-call hosts :some (lambda (item) (= (get item :id) "stdlib/bit.mjs"))))
                     (not (and (Array/isArray modules)
                               (js-call modules :some (lambda (item) (= (get item :id) "stdlib/bit.mjs"))))))
            (js-call hosts :push (js-object :id "stdlib/bit.mjs" :filename "stdlib/bit.mjs" :source bit-text))))))
      ;; The canonical HTTP literal imports the actual host provider. It is
      ;; source evidence and a hostSource, never a fabricated .eli module.
      (when (js-call (get document :records) :some
              (lambda (record) (js-call request-layouts :has (get record :id))))
        (let* ((provider (await (js-call reader :file "platform/http.mjs")))
               (existing (js-call (get document :evidence) :find
                           (lambda (asset) (= (get asset :file) "platform/http.mjs")))))
          (if existing
            (unless (and (= (get existing :sha256) (get provider :sha256))
                         (= (get existing :content) (get provider :content)))
              (throw (new globalThis.TypeError "original recipe HTTP provider source identity differs")))
            (js-call (get document :evidence) :push provider))))
      (await (restore-runtime-scan-recipe document options))
      (await (runtime-scan-replay document options))
      (await (matcher-transport document options))
      (await (maintained-execution-assets document options))
      (await (tools-cli-assets document options))
      (await (tools-data-reference-assets document options))
      (await (project-runtime-assets document options))
      (await (transportOriginalFuzzCorpus document options))
      (await (transportOriginalStdlibBitCorpus document options))
      (await (transportOriginalSourceDebuggingCorpus document options))
      (await (transportOriginalBootstrapEmitterCorpus document options))
      (bindOriginalMaintainedSuiteEvidence document)
      (await (bindOriginalRuntimeScanReportEvidence document options))
      (await (bindOriginalMaintainedFixtureEvidence document options))
      ;; Added maintained assets keep their authenticated source proofs. The
      ;; caller's frozen gate inventory still selects which host IDs it owns.
      (let* ((required (resource-field (get options :originals) "requiredCoverage"))
             (gate (get document :originalGateEvidence))
             (ids (new globalThis.Set (get gate :coverageIds))))
        (when (Array/isArray required)
          (put gate :coverageIds (js-call required :filter (lambda (id) (js-call ids :has id))))))
      (bind-complete-library-resource-inputs document)))

  (defasync loadOriginalCompilerCorpus (options)
    (let* ((source-root (get options :sourceRoot)) (originals (get options :originals)))
      (if (or (nullish? originals) (not (Array/isArray (get originals :manifests)))
              (/= (value-type source-root) "string"))
          (await (load-original-corpus options))
        (let ((stable (js-call (get originals :manifests) :find
                        (lambda (item) (= (get item :id) "stable-compatibility")))))
          (if (nullish? stable)
              (await (load-original-corpus options))
            (let* ((reader (createOriginalCorpusSourceReader (js-object :sourceRoot source-root)))
                   (conformance (JSON/parse (await (js-call reader :text "tests/conformance/manifest.json"))))
                   (features (get conformance :features)) (matches (js-array))
                   (feature-ids (get (get stable :document) :stableCoreFeatureIds)) (index 0))
              (while (< index (js-length feature-ids))
                (let* ((feature-id (aref feature-ids index))
                       (feature (js-call features :find (lambda (item) (= (get item :id) feature-id))))
                       (locators (if (nullish? feature) (js-array) (get feature :evidence))) (position 0))
                  (while (< position (js-length locators))
                    (let ((locator (aref locators position)))
                      (when (and (= (get locator :file) literal-suite) (= (get locator :contains) literal-title))
                        (js-call matches :push (js-object
                          :id (+ "stable-compatibility:evidence:" feature-id ":" position)
                          :locator (Object/assign (js-object)
                            (js-object :id (+ "stable-compatibility:evidence:" feature-id ":" position) :featureId feature-id)
                            (funcall globalThis.structuredClone locator))))))
                    (setq position (1+ position))))
                (setq index (1+ index)))
              (unless (= (js-length matches) 1)
                (throw (new globalThis.TypeError "literal source audit must retain its unique original coverage locator")))
              (let* ((match (aref matches 0)) (id (get match :id))
                     (required (get originals :requiredCoverage)))
                (if (not (js-call required :includes id))
                    (await (load-original-corpus options))
                  (let* ((private-originals (Object/assign (js-object) originals
                            (js-object :requiredCoverage (js-call required :filter (lambda (value) (/= value id))))))
                         (document (await (load-original-corpus
                           (Object/assign (js-object) options (js-object :originals private-originals)))))
                         (evidence (js-call (get document :evidence) :find (lambda (asset) (= (get asset :file) literal-source)))))
                    (unless evidence
                      (throw (new globalThis.TypeError "literal source audit must be bound to its actual archived Eli source")))
                    (let* ((source (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t))
                                    :decode (js-call Buffer :from (get evidence :content) "base64")))
                           (audit (readOriginalLiteralRuntimeAudit source literal-source (get evidence :sha256)))
                           (gate (get document :originalGateEvidence))
                           (gate-ids (new globalThis.Set (get gate :coverageIds)))
                           (dependencies (get gate :hostOnlyDependencies))
                           (dependency (js-object :coverageId id :file literal-source :sourceSha256 (get audit :sourceSha256)
                             :kind "source-only-case" :originalAssertion literal-title :locator (get match :locator)
                             :region (get audit :region)
                             :reason "unchanged original source constructor audit; all compiled-language cases retain selected-session execution")))
                      (js-call gate-ids :add id)
                      (put gate :coverageIds (js-call required :filter (lambda (value) (js-call gate-ids :has value))))
                      ;; Gate dependencies retain their original relative order;
                      ;; the replacement occupies its denominator's exact place.
                      (let ((position (js-call dependencies :findIndex (lambda (item)
                                        (> (js-call required :indexOf (get item :coverageId))
                                           (js-call required :indexOf id))))))
                        (js-call dependencies :splice (if (< position 0) (js-length dependencies) position) 0 dependency))
                      (put document :coverageIds (Array/from required))
                      document))))))))))

  (defconst transportOriginalExecutionAssets maintained-execution-assets)
  (defconst transportOriginalToolsDataReferenceAssets tools-data-reference-assets)
  (defconst bindOriginalFunctionalResourceInputs bind-complete-library-resource-inputs)
