(module tools.backends.compiler-corpus-tools-cli
  (import "node:fs/promises" readFile writeFile realpath lstat)
  (import "node:path" resolve dirname basename isAbsolute)
  (import "node:crypto" createHash)
  (import "node:util" isDeepStrictEqual)
  (import "./stage3-targets.mjs" authenticateStage3Targets)
  (import "./compiler-build.mjs" independentCompilerProductIdentity)
  (import "./dist/release-cli.mjs" runReleaseCLI renderReleaseCLIError)
  (defconst original-tools-cli-records (Object/freeze (js-array
    "original-tools-artifact:compiler-session-tools:node"
    "original-tools-artifact:compiler-session-tools:bun")))
  (defun fail (message) (throw (new globalThis.TypeError (str "original tools CLI projection: " message))))
  (defun same (actual expected message)
    (unless (isDeepStrictEqual actual expected) (fail message)))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun safe (path)
    (unless (and (= (value-type path) "string") (> (js-length path) 0)
      (not (isAbsolute path)) (not (js-call path :includes "\\"))
      (not (js-call path :includes ":"))
      (not (js-call (js-call path :split "/") :some
        (lambda (part) (or (= part "") (= part ".") (= part ".."))))))
      (fail "invalid emitted relative path")) path)
  (defasync original-tools-file (directory path)
    (safe path)
    (let ((parts (js-call path :split "/")) (current directory) (index 0))
      (while (< index (js-length parts))
        (setq current (resolve current (aref parts index)))
        (let ((stat (await (lstat current))))
          (unless (if (= index (1- (js-length parts))) (js-call stat :isFile)
                    (js-call stat :isDirectory)) (fail "nonregular selected product entry")))
        (setq index (1+ index)))
      (await (readFile current))))
  (defun sorted (values) (js-call (Array/from values) :sort))
  (defasync authenticateOriginalToolsCLI (input)
    (unless (and input (= (value-type (get input :configurationPath)) "string")
                       (= (value-type (get input :selectedMetadataPath)) "string"))
      (fail "actual original configuration and selected metadata are required"))
    (let* ((configuration-path (await (realpath (get input :configurationPath))))
           (projection-path (resolve (dirname configuration-path) "__eliscript_tools_cli_projection.json"))
           (projection (JSON/parse (await (readFile projection-path "utf8"))))
           (configuration (JSON/parse (await (readFile configuration-path "utf8")))))
      (unless (and (= (get projection :kind) "original-tools-final-cli") (= (get projection :version) 1)
                   (js-call original-tools-cli-records :includes (get projection :recordId))
                   (= (get configuration :target) "javascript")
                   (= (get configuration :sourceRoot) (get projection :sourceRoot))
                   (= (get configuration :supportingDirectory) (get projection :supportingDirectory))
                   (= (get configuration :path) (get projection :producerPath))
                   (= configuration-path (await (realpath (get projection :configurationPath)))))
        (fail "original configuration differs from its exact source-bound transport"))
      (let* ((selected-path (await (realpath (get input :selectedMetadataPath))))
             (expected (await (realpath (resolve (get projection :supportingDirectory)
                         "standard-selected/compiler-artifact.json"))))
             (certified (await (authenticateStage3Targets
               (js-object :bootstrapManifestPath (get projection :bootstrapManifestPath)))))
             (final-path (get certified :stage3MetadataPath))
             (final (JSON/parse (await (readFile final-path "utf8"))))
             (selected (JSON/parse (await (readFile selected-path "utf8")))))
        (unless (= selected-path expected) (fail "requested metadata is not the original standard-selected product"))
        (unless (and (= (get selected :host) "javascript") (= (get selected :target) "javascript")
                     (= (get selected :entry) (get final :entry)) (= (get selected :path) (get final :path))
                     (= (get (get selected :provenance) :mode) "session")
                     (= (get (get selected :provenance) :producerHost) "javascript")
                     (eq (get (get selected :provenance) :runtimeCompiled) t))
          (fail "selected compiler provenance is not a complete real JavaScript session build"))
        (same (get selected :sourceIdentity) (get final :sourceIdentity) "selected compiler source identity differs")
        (same (sorted (get (get selected :provenance) :compiledModuleIds))
          (sorted (js-call (get (get final :sourceIdentity) :modules) :map (lambda (record) (get record :id))))
          "selected compiler did not compile the complete formal module graph")
        (unless (and (Array/isArray (get selected :modules))
                     (= (js-length (get selected :modules)) (js-length (get final :modules)))
                     (Array/isArray (get selected :literalSources)))
          (fail "selected compiler module or literal inventory is incomplete"))
        (let* ((required (new globalThis.Set (js-array "package.json")))
               (seen-modules (new globalThis.Set))
               (wanted-modules (new globalThis.Map (js-call (get final :modules) :map
                 (lambda (record) (js-array (get record :id) record)))))
               (final-files (new globalThis.Map (js-call (get (get final :artifactIdentity) :files) :map
                 (lambda (record) (js-array (get record :path) record)))))
               (identity (get selected :artifactIdentity)) (files (get identity :files))
               (actual (js-array)) (seen-files (new globalThis.Set)) (index 0))
          (js-call (get selected :modules) :forEach (lambda (record)
            (let ((wanted (js-call wanted-modules :get (get record :id))))
              (unless (and wanted (not (js-call seen-modules :has (get record :id)))
                           (= (get record :path) (get wanted :path))) (fail "selected module identity differs"))
              (js-call seen-modules :add (get record :id))
              (js-call required :add (safe (get record :path)))
              (js-call (js-array "sourceMapPath" "macroOriginsPath") :forEach (lambda (key)
                (when (Object/hasOwn record key)
                  (unless (= (get record key) (get wanted key)) (fail "selected map declaration differs"))
                  (js-call required :add (safe (get record key)))))))))
          (same (get selected :runtimePath) (get final :runtimePath) "selected runtime declaration differs")
          (same (get selected :literalSources) (get final :literalSources) "selected literal source declarations differ")
          (js-call required :add (safe (get selected :runtimePath)))
          (js-call (get selected :literalSources) :forEach (lambda (record)
            (js-call required :add (safe (get record :path)))))
          (unless (and (= (get identity :algorithm) "sha256") (Array/isArray files)
                       (= (js-length files) (get required :size)))
            (fail "selected complete executable file declaration differs"))
          (while (< index (js-length files))
            (let* ((record (aref files index)) (path (safe (get record :path)))
                   (wanted (js-call final-files :get path))
                   (bytes (await (original-tools-file (dirname selected-path) path)))
                   (proof (js-object :path path :bytes (js-length bytes) :sha256 (digest bytes))))
              (unless (and (js-call required :has path) (not (js-call seen-files :has path)) wanted)
                (fail "selected emitted file is missing repeated or undeclared"))
              (same proof record "selected emitted file differs from its real metadata")
              (same proof wanted "selected emitted file differs from authenticated stage3")
              ;; Re-read actual designated files too. No metadata-only alias or
              ;; claimed digest authenticates the selected executable bytes.
              (let ((final-bytes (await (original-tools-file (dirname final-path) path))))
                (unless (js-call bytes :equals final-bytes) (fail "selected original bytes differ from designated stage3")))
              (js-call actual :push proof) (js-call seen-files :add path))
            (setq index (1+ index)))
          (same (independentCompilerProductIdentity (js-object :host "javascript" :files actual))
            (get selected :productIdentity) "selected product identity differs from actual emitted files")
          (js-object :kind "original-tools-final-cli" :version 1
            :bootstrapManifestPath (get certified :bootstrapManifestPath)
            :stage3MetadataPath final-path :selectedMetadataPath selected-path
            :selectedArgumentPath (resolve (get input :selectedMetadataPath))
            :selectedProductIdentity (get selected :productIdentity)
            :stage3ProductIdentity (get certified :productIdentity) :files actual)))))

  (defun projectOriginalToolsCLIArguments (arguments proof)
    (unless (and (Array/isArray arguments) (= (get proof :kind) "original-tools-final-cli"))
      (fail "an authenticated original argument projection is required"))
    (let ((result (js-array)) (count 0) (index 0))
      (while (< index (js-length arguments))
        (let ((argument (aref arguments index)))
          (cond
            ((= argument "--compiler-artifact")
              (setq index (1+ index) count (1+ count))
              (unless (= (resolve (aref arguments index)) (get proof :selectedArgumentPath))
                (fail "original requested artifact differs"))
              (js-call result :push argument (get proof :stage3MetadataPath)))
            ((js-call argument :startsWith "--compiler-artifact=")
              (setq count (1+ count))
              (unless (= (resolve (js-call argument :slice (js-length "--compiler-artifact=")))
                         (get proof :selectedArgumentPath)) (fail "original requested artifact differs"))
              (js-call result :push (str "--compiler-artifact=" (get proof :stage3MetadataPath))))
            ((or (= argument "--bootstrap-manifest") (js-call argument :startsWith "--bootstrap-manifest="))
              (fail "original tools argv must not replace the explicitly authenticated manifest"))
            (t (js-call result :push argument))))
        (setq index (1+ index)))
      (unless (= count 1) (fail "original tools argv must select exactly one actual artifact"))
      (js-call result :push "--bootstrap-manifest" (get proof :bootstrapManifestPath)) result))
  (defasync runOriginalToolsCLI (arguments)
    (let* ((configuration (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_COMPILER_SESSION))
           (index (js-call arguments :indexOf "--compiler-artifact"))
           (joined (js-call arguments :find (lambda (argument) (js-call argument :startsWith "--compiler-artifact="))))
           (selected (if (>= index 0) (aref arguments (1+ index))
                       (when joined (js-call joined :slice (js-length "--compiler-artifact=")))))
           (proof (await (authenticateOriginalToolsCLI
             (js-object :configurationPath configuration :selectedMetadataPath selected)))))
      (await (writeFile (resolve (dirname configuration) "__eliscript_tools_cli_authentication.json")
        (JSON/stringify proof)))
      (await (runReleaseCLI (projectOriginalToolsCLIArguments arguments proof)))))
  (when (= (basename (or (aref (get globalThis.process :argv) 1) "")) "compiler-corpus-tools-cli.mjs")
    (js-call (runOriginalToolsCLI (js-call (get globalThis.process :argv) :slice 2)) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write
          (str (renderReleaseCLIError error (js-object :json
            (js-call (get globalThis.process :argv) :includes "--json-errors"))) "\n"))
        (put globalThis.process :exitCode 1))))
  (defconst main runOriginalToolsCLI)
  (export authenticateOriginalToolsCLI projectOriginalToolsCLIArguments runOriginalToolsCLI main))
