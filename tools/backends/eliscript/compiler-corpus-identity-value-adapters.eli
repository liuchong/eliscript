(module tools.backends.compiler-corpus-identity-value-adapters
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "./compiler-corpus-identity-value-adapters-legacy.mjs" :as legacy)
  (import "./compiler-corpus-process.mjs" readOriginalProcessHostDependency bindOriginalProcessHostDependency)
  (defconst originalIdentityValueSuites (get legacy :originalIdentityValueSuites))
  (defconst originalIdentityValueCaseLocators (get legacy :originalIdentityValueCaseLocators))
  (defasync addOriginalIdentityValueAdapters (options)
    (let* ((text (get options :text)) (file (get options :file))
           (source-path "tools/backends/eliscript/compiler-corpus-identity-host.eli")
           (generated-path "tools/backends/compiler-corpus-identity-host.mjs")
           (host-source (await (funcall text generated-path)))
           (source-identity (await (funcall file source-path)))
           (generated-identity (await (funcall file generated-path)))
           (dependency (await (readOriginalProcessHostDependency options)))
           (publish (get options :add))
           (forwarded (Object/assign (js-object) options)))
      (unless (and (= (value-type host-source) "string")
                   (= (get generated-identity :file) generated-path)
                   (= (get source-identity :file) source-path)
                   (= (get generated-identity :bytes) (Buffer/byteLength host-source "utf8"))
                   (= (get generated-identity :sha256)
                     (js-call (js-call (createHash "sha256") :update host-source) :digest "hex")))
        (throw (new globalThis.TypeError "original identity host text differs from its generated source asset")))
      (put forwarded :add (lambda (record)
        (if (js-call (get record :id) :startsWith "original-identity-value:host-token-single:")
          (let* ((original (get record :original)) (modules (get record :modules))
                 (execution (get record :execution)))
            (unless (and (= (get original :fixture) "tests/fixtures/wasm-managed-host-identity.eli")
                         (= (js-length modules) 1) (= (get (aref modules 0) :id) (get record :entry)))
              (throw (new globalThis.TypeError "original single-module identity replay lost its actual source boundary")))
            (let* ((proofs (js-array
                     (js-object :file source-path :sourceSha256 (get source-identity :sha256) :bytes (get source-identity :bytes))
                     (js-object :file generated-path :sourceSha256 (get generated-identity :sha256) :bytes (get generated-identity :bytes))))
                   (assets (js-call (or (get original :sourceAssets) (js-array)) :concat proofs))
                   (selected (Object/assign (js-object) record
                     (js-object :execution (Object/assign (js-object) execution
                         (js-object :hostSource host-source :javascriptHostSource host-source))
                       :original (Object/assign (js-object) original (js-object :sourceAssets assets))))))
              (funcall publish (bindOriginalProcessHostDependency selected dependency))))
          (funcall publish record))))
      (await (js-call legacy :addOriginalIdentityValueAdapters forwarded))))
  (export originalIdentityValueSuites originalIdentityValueCaseLocators addOriginalIdentityValueAdapters))
