(module tools.backends.compiler-unicode-profile-host
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile realpath)
  (import "node:path" resolve)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (import "../../runtime/unicode-case.mjs" installUnicodeCaseProfile)

  (defasync main ()
    (let* ((arguments (js-call (get globalThis.process :argv) :slice 2)))
      (unless (= (js-length arguments) 2)
        (throw (new globalThis.TypeError "Unicode profile host requires actual module and profile paths")))
      (let* ((path (resolve (aref arguments 0)))
             (profile (JSON/parse (await (readFile (resolve (aref arguments 1)) "utf8")))))
        ;; Install before importing the actual selected user program. Its
        ;; ordinary String calls and any subsequent method edits stay real.
        (installUnicodeCaseProfile (get profile :version))
        (let* ((canonical (await (realpath path)))
               (require-module (createRequire canonical)) (selected (funcall require-module canonical))
               (hashes (js-object :upper (createHash "sha256") :lower (createHash "sha256")))
               (names (js-array "upper" "lower")) (checked 0) (start 0))
          (while (< start 1114112)
            (let ((points (js-array)) (point start))
              (while (< point (Math/min (+ start 512) 1114112))
                (when (or (< point 55296) (> point 57343)) (js-call points :push point))
                (setq point (1+ point)))
              (setq checked (+ checked (js-length points)))
              (let ((text (Reflect/apply (get globalThis.String :fromCodePoint) globalThis.String points)) (index 0))
                (while (< index 2)
                  (let* ((name (aref names index)) (method (get selected name))
                         (value (Reflect/apply method undefined (js-array text))))
                    (js-call (get hashes name) :update value "utf16le"))
                  (setq index (1+ index)))))
            (setq start (+ start 512)))
          (js-call assert :strictEqual checked 1112064)
          (let ((actual (js-object)) (index 0))
            (while (< index 2)
              (let* ((name (aref names index)) (value (js-call (get hashes name) :digest "hex")))
                (put actual name value) (js-call assert :strictEqual value (get profile name)))
              (setq index (1+ index)))
            (js-call (get profile :sigma) :forEach (lambda (pair)
              (js-call assert :strictEqual (Reflect/apply (get selected :lower) undefined (js-array (aref pair 0))) (aref pair 1))))
            (js-call (get globalThis.process :stdout) :write (JSON/stringify
              (js-object :kind "unicode-profile" :expectedSatisfied t :version (get profile :version)
                :checked checked :sigmaCases (js-length (get profile :sigma)) :hashes actual))))))))
  (js-call (main) :catch (lambda (error)
    (js-call (get globalThis.process :stderr) :write (+
      (if (and (not (nullish? error)) (or (= (value-type error) "object") (= (value-type error) "function")))
        (get error :stack (funcall globalThis.String error)) (funcall globalThis.String error)) "\n"))
    (put globalThis.process :exitCode 1))))
