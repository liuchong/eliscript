(module tools.backends.compiler-corpus-tools-reference
  ;; Only the authenticated original host's direct data modules acquire this
  ;; runtime import. Their complete source bytes and module identities survive.
  (import "node:child_process" spawnSync)
  (import "node:module" :as Module)
  (import "node:fs" readFileSync realpathSync)
  (import "node:path" resolve dirname)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "./build.mjs" root)
  (defun fail (message) (throw (new globalThis.TypeError (str "original tools reference: " message))))
  (defun digest (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defconst configuration-path (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_COMPILER_SESSION))
  (unless (and (= (value-type configuration-path) "string") (> (js-length configuration-path) 0))
    (fail "the actual original session configuration is required"))
  (defconst configuration (JSON/parse (readFileSync configuration-path "utf8")))
  (defconst proof (JSON/parse (readFileSync
    (resolve (dirname configuration-path) "__eliscript_tools_data_reference.json") "utf8")))
  (defconst self (fileURLToPath (js* "import.meta.url")))
  (defconst module-file "tools/backends/compiler-corpus-tools-reference.mjs")
  (defconst host (realpathSync (aref (get globalThis.process :argv) 1)))
  (defconst assets (get proof :sourceAssets))
  (defconst asset (when (Array/isArray assets)
    (js-call assets :find (lambda (entry) (= (get entry :file) module-file)))))
  (defconst record-match (when (= (value-type (get proof :recordId)) "string")
    (js-call (new globalThis.RegExp "^original-(?:tools-artifact|managed):compiler-session-tools:(node|bun)$")
      :exec (get proof :recordId))))
  (defconst runtime-file "runtime/unicode-case.mjs")
  (defconst runtime-path (resolve root runtime-file))
  (unless (and (= (get proof :kind) "original-tools-data-reference") (= (get proof :version) 1)
               record-match (= (aref record-match 1) (if globalThis.Bun "bun" "node"))
               (= (get configuration :target) "javascript")
               (= (realpathSync root) (realpathSync (get configuration :sourceRoot)))
               (= (get proof :sourceRoot) (get configuration :sourceRoot))
               (= (realpathSync configuration-path) (realpathSync (get proof :configurationPath)))
               (= (get proof :moduleFile) module-file) (= (get proof :runtimeFile) runtime-file)
               (= (realpathSync self) (realpathSync (resolve root module-file)))
               (= (realpathSync runtime-path) runtime-path)
               (= (get proof :runtimeSha256) (digest (readFileSync runtime-path)))
               asset (= (get asset :sourceSha256) (digest (readFileSync self)))
               (= (get proof :transportHostSha256) (digest (readFileSync host))))
    (fail "the original host or dependency differs from its authenticated source transport"))
  (defconst host-url (get (pathToFileURL host) :href))
  (defconst runtime-url (get (pathToFileURL runtime-path) :href))
  (defconst prefix "data:text/javascript;base64,")
  (defconst parents (new globalThis.Set))
  (defun data-bytes (specifier)
    (let* ((encoded (js-call specifier :slice (js-length prefix)))
           (bytes (js-call Buffer :from encoded "base64")))
      (unless (= (js-call bytes :toString "base64") encoded)
        (fail "the original generated data module must retain canonical complete bytes"))
      bytes))
  (defun host-parent-p (parent)
    (or (= parent host-url) (= parent host)))
  (if (not globalThis.Bun)
    (progn
      (unless (= (value-type (get Module :registerHooks)) "function")
        (fail "the selected Node host requires synchronous module hooks"))
      (js-call Module :registerHooks (js-object :resolve (lambda (specifier context nextResolve)
        (when (and (or (host-parent-p (get context :parentURL)) (js-call parents :has (get context :parentURL)))
                   (= (value-type specifier) "string")
                   (js-call specifier :startsWith prefix))
          (data-bytes specifier)
          (js-call parents :add specifier))
        (funcall nextResolve
          (if (and (= specifier "eliscript/runtime/unicode-case.mjs")
                   (js-call parents :has (get context :parentURL))) runtime-url specifier)
          context)))))
    (js-call globalThis.Bun :plugin (js-object :name "authenticated-original-tools-data" :setup (lambda (builder)
      (js-call builder :onResolve (js-object :filter (new globalThis.RegExp "^data:text/javascript;base64,"))
        (lambda (request)
          (when (host-parent-p (get request :importer))
            (let ((path (get request :path)))
              (data-bytes path) (js-call parents :add path)
              (js-object :path path :namespace "original-tools-data")))))
      (js-call builder :onResolve
        (js-object :filter (new globalThis.RegExp "^data:text/javascript;base64,") :namespace "original-tools-data")
        (lambda (request)
          (unless (js-call parents :has (get request :importer)) (fail "unrecognized original data importer"))
          (let ((path (get request :path)))
            (data-bytes path) (js-call parents :add path)
            (js-object :path path :namespace "original-tools-data"))))
      (js-call builder :onLoad (js-object :filter (new globalThis.RegExp ".*") :namespace "original-tools-data")
        (lambda (request)
          (unless (js-call parents :has (get request :path)) (fail "unrecognized original data module"))
          (js-object :contents (data-bytes (get request :path)) :loader "js")))
      (js-call builder :onResolve
        (js-object :filter (new globalThis.RegExp "^eliscript/runtime/unicode-case[.]mjs$") :namespace "original-tools-data")
        (lambda (request)
          (unless (js-call parents :has (get request :importer)) (fail "unrecognized original data importer"))
          (js-object :path runtime-path :namespace "file")))
      ;; The AggregateError reference also imports its actual compiler driver
      ;; by file URL. Preserve that URL's canonical file identity.
      (js-call builder :onResolve
        (js-object :filter (new globalThis.RegExp "^file:") :namespace "original-tools-data")
        (lambda (request)
          (unless (js-call parents :has (get request :importer)) (fail "unrecognized original data importer"))
          (js-object :path (fileURLToPath (get request :path)) :namespace "file")))))))
  (export spawnSync))
