(module tools.backends.compiler-corpus-project-adapters-ground
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)

  (defun sha256 (value)
    (js-call (js-call (createHash "sha256") :update value) :digest "hex"))

  (defun replace-setup (source before after changes)
    (let ((start (js-call source :indexOf before)))
      (when (or (< start 0) (>= (js-call source :indexOf before (+ start (js-length before))) 0))
        (throw (new globalThis.TypeError (str "original project setup boundary changed: " before))))
      (js-call changes :push
        (js-object
          :beforeSha256 (sha256 before)
          :afterSha256 (sha256 after)
          :role "selected-artifact-transport"))
      (str (js-call source :slice 0 start)
           after
           (js-call source :slice (+ start (js-length before))))))

  (defun source-imports (source source-root changes)
    (let ((result source)
          (names (js-array "project" "project-cli"))
          (i 0))
      (while (< i (js-length names))
        (let* ((name (aref names i))
               (specifier (str "../bootstrap/host/" name ".mjs"))
               (before (JSON/stringify specifier)))
          (when (js-call result :includes before)
            (let ((after (JSON/stringify (get (pathToFileURL (resolve source-root (str "bootstrap/host/" name ".mjs"))) :href))))
              ;; Static and dynamic imports continue to use the original host service;
              ;; its compiler argument/directory always points at the selected product.
              (setq result (replace-setup result before after changes)))))
        (setq i (1+ i)))
      result))

  (defun project-transport-url (source-root)
    (JSON/stringify (get (pathToFileURL (resolve source-root "tools/backends/compiler-corpus-project-transport.mjs")) :href)))

  ;; The remaining JS here is only ESM linkage and call forwarding. All file
  ;; traversal, registration validation and execution are maintained Eli.
  (defun selected-directory-transport (source-root module-names bootstrap-binding)
    (str "\nimport {createOriginalProjectTransport as __eliscript_create_project} from "
      (project-transport-url source-root) ";\n"
      "const __eliscript_project_transport = __eliscript_create_project("
      (JSON/stringify module-names) ", () => " bootstrap-binding ");\n"
      "const __eliscript_project_cases = __eliscript_project_transport.cases;\n"
      "function test(...args) { return __eliscript_project_transport.register(...args); }\n"
      "async function __eliscript_materialize_compiler(...args) { return await __eliscript_project_transport.install(...args); }\n"
      "async function __eliscript_original_setup(...args) { return await __eliscript_project_transport.setup(...args); }\n"))

  (defun project-registration (source-root names namespace configuration)
    (str "\nimport {createOriginalProjectTransport as __eliscript_create_project} from "
      (project-transport-url source-root) ";\nconst " namespace " = __eliscript_create_project("
      (JSON/stringify names) ", () => undefined, " (JSON/stringify configuration) ");\n"
      "const __eliscript_project_cases = " namespace ".cases;\n"
      "function test(...args) { return " namespace ".register(...args); }\n"))

  (defun run-cases (source-root &optional hooks)
    (str "\nimport {runOriginalProjectCases as __eliscript_run_project_cases} from "
      (project-transport-url source-root) ";\n"
      "await __eliscript_run_project_cases(__eliscript_project_cases"
      (if hooks (str ", " hooks) "") ");\n"))

  (defasync add-original-frontend-cli-suites (options)
    (let ((add (get options :add))
          (locators (get options :locators))
          (text (get options :text))
          (file (get options :file))
          (source-root (get options :sourceRoot))
          (stable-files (get options :stableFiles))
          (modules (get options :modules))
          (mapped (js-array))
          (plans
            (js-array
              (js-object
                :name "loop-recur"
                :suite "tests/loop-recur.test.mjs"
                :title "loop/recur is stack-safe and identical after self-hosting"
                :root "projectDirectory"
                :rootDecl "const projectDirectory = resolve(import.meta.dir, \"..\");"
                :seed "seedCliPath"
                :portable "portableCliPath"
                :loop t
                :assets (js-array "bin/eliscript" "bin/eliscript-portable" "bin/eliscript-bootstrap"))
              (js-object
                :name "stdlib-bit"
                :suite "tests/stdlib-bit.test.mjs"
                :title "portable 32-bit operations and algorithms agree under Bun and Node"
                :root "ROOT"
                :rootDecl "const ROOT = resolve(fileURLToPath(new (globalThis.URL)(\".\", import.meta.url)), \"..\");"
                :seed "COMPILER"
                :portable "portableCompiler"
                :assets (js-array
                          "stdlib/bit.eli"
                          "tests/fixtures/bit-usage.eli"
                          "tests/fixtures/bit-host.mjs"
                          "tests/helpers/seed-compiler.mjs"
                          "bin/eliscript"
                          "bin/eliscript-portable"))))
          (p-idx 0))
      (while (< p-idx (js-length plans))
        (let* ((plan (aref plans p-idx))
               (suite (get plan :suite))
               (selected (js-call locators :filter (lambda (locator) (= (get locator :file) suite)))))
          (when (> (js-length selected) 0)
            (let* ((original (await (funcall text suite)))
                   (identity (await (funcall file suite)))
                   (changes (js-array))
                   (source-assets (js-array))
                   (map-trailer (str "}), 30000);\n//# sourceMappingURL=" (get plan :name) ".test.mjs.map\n")))
              (when (or (not (js-call original :includes (str "test(" (JSON/stringify (get plan :title)) ", (async () => {")))
                        (not (js-call original :endsWith map-trailer)))
                (throw (new globalThis.TypeError (str "original frontend CLI assertion or deadline changed: " suite))))
              (let ((s-idx 0))
                (while (< s-idx (js-length selected))
                  (let ((locator (aref selected s-idx)))
                    (when (or (/= (value-type (get locator :contains)) "string")
                              (not (js-call original :includes (get locator :contains))))
                      (throw (new globalThis.TypeError (str "original frontend CLI locator changed: " (get locator :id))))))
                  (setq s-idx (1+ s-idx))))
              (let ((assets (get plan :assets))
                    (a-idx 0))
                (while (< a-idx (js-length assets))
                  (let* ((filename (aref assets a-idx))
                         (evidence (await (funcall file filename))))
                    (js-call source-assets :push
                      (js-object :file filename :sourceSha256 (get evidence :sha256))))
                  (setq a-idx (1+ a-idx))))
              (let ((transported (replace-setup original "import {expect, test} from \"bun:test\";"
                                   "import {expect} from \"bun:test\";" changes)))
                (unless (get plan :loop)
                  (setq transported
                    (replace-setup
                      (replace-setup transported "import {seedCompilerFixture} from \"./helpers/seed-compiler.mjs\";"
                        "// Bootstrap setup forwards the complete actual selected compiler." changes)
                      "\"./helpers/portable-stdlib.mjs\""
                      (JSON/stringify (get (pathToFileURL (resolve source-root "tests/helpers/portable-stdlib.mjs")) :href))
                      changes)))
                (setq transported
                  (replace-setup transported (get plan :rootDecl)
                    (str "const " (get plan :root) " = process.env.ELISCRIPT_ORIGINAL_SOURCE_ROOT;\n"
                         "if (!" (get plan :root) ") throw new Error(\"original frontend CLI requires its source root\");")
                    changes))
                (if (get plan :loop)
                  (setq transported
                    (replace-setup transported "async function run(command, ...__host_forwarded_arguments_1) {\n  return (await (async (options) => {\n"
                      "async function run(command, ...args) { return await __frontend_transport.runFrontend(__frontend_original_run, command, args[0], {build: buildPath, seed: seedCliPath}); }\nasync function __frontend_original_run(command, ...__host_forwarded_arguments_1) {\n  return (await (async (options) => {\n"
                      changes))
                  (setq transported
                    (replace-setup transported "async function compile(source, output) {\n"
                      (str "async function compile(source, output) {\n"
                           "  return await (runSuccessful([(__eliscript_tdz_ready_3 === true ? COMPILER : __eliscript_tdz_error(\"COMPILER\")), \"--source-map\", \"--output\", output, source], {ELISCRIPT_BOOTSTRAP_MODULE_DIR: __frontend_reference}));\n"
                           "}\nasync function __unused_original_compile(source, output) {\n")
                      changes)))
                (let* ((mod-names (js-call modules :map (lambda (m) (js-call (get m :id) :slice (js-length "bootstrap/compiler/") -4))))
                       (setup
                         (str (project-registration source-root mod-names "__frontend_transport"
                           (js-object :title (get plan :title) :timeout 30000 :returnDirectory t
                             :referenceRequired t :referenceError "original frontend CLI requires its independent Seed product"
                             :registrationError "original frontend CLI registration changed"
                             :directoryError "original frontend CLI bootstrap output changed"))
                           "const __frontend_selected=__frontend_transport.selected;\n"
                           "const __frontend_reference=__frontend_transport.reference;\n"
                           "async function __frontend_install(...args) { return await __frontend_transport.install(...args); }\n"
                           "async function seedCompilerFixture(...args) { return await __frontend_transport.install(...args); }\n"))
                       (coverage
                         (Array/from
                           (new globalThis.Set
                             (js-call
                               (js-call selected :map (lambda (l) (get l :id)))
                               :concat
                               (js-call
                                 (js-call source-assets :filter (lambda (a) (js-call stable-files :has (get a :file))))
                                 :map (lambda (a) (str "stable-compatibility:" (get a :file)))))))))
                  (funcall add
                    (js-object
                      :id (str "original-program:compiler-" (get plan :name) "-complete")
                      :kind "project"
                      :coverage coverage
                      :modules (globalThis.structuredClone modules)
                      :entry "bootstrap/compiler/compiler.mjs"
                      :request (js-object
                                 :operation "project"
                                 :resolveImports t
                                 :phased t
                                 :sourceMap t
                                 :entries (js-call modules :map (lambda (m) (get m :id))))
                      :execution
                        (js-object
                          :kind "original-program"
                          :host (str "tests/__eliscript_original_" (get plan :name) "_complete.mjs")
                          :hostSource (str setup transported (run-cases source-root))
                          :arguments (js-array (js-object :directory t))
                          :aliases t
                          :requiresBun t
                          :hostRuntime "bun"
                          :referenceArtifact t
                          :childProcesses "inherit-selected-artifact"
                          :runtimeLaunchers t
                          :compilerSourceMaps t
                          :runtimeProfile "compiler"
                          :timeoutMs 30000
                          :setupReplacement
                            (js-object
                              :kind "selected-and-independent-reference-compiler-directories"
                              :algorithms "selected-target-only"
                              :sourceSha256 (get identity :sha256)
                              :changes changes
                              :originalCaseTimeouts (js-array 30000)))
                      :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
                      :original
                        (js-object
                          :manifest "stable-compatibility"
                          :suite suite
                          :fixture suite
                          :host suite
                          :sourceSha256 (get identity :sha256)
                          :originalAssertions (js-array (get plan :title))
                          :sourceAssets source-assets
                          :regions (js-array
                                     (js-object
                                       :start 0
                                       :end (js-length original)
                                       :byteStart 0
                                       :byteEnd (js-call Buffer :byteLength original)
                                       :sha256 (sha256 original)))
                          :setupReplacement
                            (js-object
                              :kind "selected-and-independent-reference-compiler-directories"
                              :changes changes))))
                  (js-call mapped :push suite))))))
        (setq p-idx (1+ p-idx)))
      mapped))

  (defasync add-original-interop-package-program (options)
    (let* ((add (get options :add))
           (locators (get options :locators))
           (text (get options :text))
           (file (get options :file))
           (source-root (get options :sourceRoot))
           (stable-files (get options :stableFiles))
           (modules (get options :modules))
           (suite "tests/interop-package.test.mjs")
           (suite-locators (js-call locators :filter (lambda (locator) (= (get locator :file) suite)))))
      (if (= (js-length suite-locators) 0)
        nil
        (let* ((original (await (funcall text suite)))
               (identity (await (funcall file suite)))
               (changes (js-array))
               (assertion "maintained JavaScript package consumes native values across compilers and hosts"))
          (when (or (not (js-call original :includes (str "test(" (JSON/stringify assertion) ", (async () => {")))
                    (not (js-call original :endsWith "}), 120000);\n//# sourceMappingURL=interop-package.test.mjs.map\n")))
            (throw (new globalThis.TypeError "original interop package assertion or deadline changed")))
          (let ((l-idx 0))
            (while (< l-idx (js-length suite-locators))
              (let ((locator (aref suite-locators l-idx)))
                (when (or (/= (value-type (get locator :contains)) "string")
                          (not (js-call original :includes (get locator :contains))))
                  (throw (new globalThis.TypeError "original interop package locator is absent from its complete suite"))))
              (setq l-idx (1+ l-idx))))
          (let ((declaration (js-call (new globalThis.RegExp "const dependencies = (\\[[^\\]]*\\]);") :exec original)))
            (unless declaration
              (throw (new globalThis.TypeError "original interop package dependency declaration changed")))
            (let* ((dependencies (JSON/parse (js-call (aref declaration 1) :replace (new globalThis.RegExp ",\\s*]$") "]")))
                   (dep-name-re (new globalThis.RegExp "^[-a-z]+$")))
              (when (or (not (Array/isArray dependencies))
                        (js-call dependencies :some
                          (lambda (name) (or (/= (value-type name) "string") (not (js-call dep-name-re :test name))))))
                (throw (new globalThis.TypeError "original interop package dependencies are not static module names")))
              (let ((source-assets (js-array))
                    (asset-files
                      (js-call
                        (js-array
                          "tests/fixtures/packages/interop-consumer/package.json"
                          "tests/fixtures/packages/interop-consumer/index.mjs"
                          "tests/fixtures/packages/native-container-consumer/package.json"
                          "tests/fixtures/packages/native-container-consumer/index.mjs"
                          "tests/helpers/seed-compiler.mjs"
                          "bin/eliscript-seed-build"
                          "bin/eliscript-build"
                          "bootstrap/host/project-cli.mjs"
                          "bootstrap/host/project.mjs"
                          "bootstrap/host/build.mjs"
                          "bootstrap/host/bun.mjs"
                          "stdlib/interop/js.eli")
                        :concat
                        (js-call dependencies :map (lambda (name) (str "stdlib/" name ".eli")))))
                    (f-idx 0))
                (while (< f-idx (js-length asset-files))
                  (let* ((filename (aref asset-files f-idx))
                         (evidence (await (funcall file filename))))
                    (js-call source-assets :push
                      (js-object :file filename :sourceSha256 (get evidence :sha256))))
                  (setq f-idx (1+ f-idx)))
                (let* ((transported
                         (replace-setup
                           (replace-setup
                             (replace-setup
                               (replace-setup
                                 (replace-setup
                                   (replace-setup original
                                     "import {seedCompilerFixture} from \"./helpers/seed-compiler.mjs\";"
                                     "// The complete selected compiler supplies the original bootstrap setup."
                                     changes)
                                   "import {expect, test} from \"bun:test\";"
                                   "import {expect} from \"bun:test\";"
                                   changes)
                                 "\"./helpers/bootstrap-fixture.mjs\""
                                 (JSON/stringify (get (pathToFileURL (resolve source-root "tests/helpers/bootstrap-fixture.mjs")) :href))
                                 changes)
                               "\"../tools/backends/compiler-host-record.mjs\""
                               (JSON/stringify (get (pathToFileURL (resolve source-root "tools/backends/compiler-host-record.mjs")) :href))
                               changes)
                             "const root = projectDirectory;"
                             "const root = process.env.ELISCRIPT_ORIGINAL_SOURCE_ROOT;\nif (!root) throw new Error(\"original interop package requires its source root\");"
                             changes)
                           "async function runSuccessful(command, options) {\n"
                           "async function runSuccessful(command, options) { return await __interop_transport.runInterop(__interop_original_run, command, options, root); }\nasync function __interop_original_run(command, options) {\n"
                           changes))
                       (mod-names (js-call modules :map (lambda (m) (js-call (get m :id) :slice (js-length "bootstrap/compiler/") -4))))
                       (registration
                         (str (project-registration source-root mod-names "__interop_transport"
                           (js-object :timeout 120000 :returnDirectory t
                             :registrationError "original interop package case registration changed"
                             :directoryError "original interop compiler output directory changed"))
                           "const __interop_selected=__interop_transport.selected;\n"
                           "async function seedCompilerFixture(...args) { return await __interop_transport.install(...args); }\n"))
                       (fixture-coverage
                         (js-call
                           (js-call source-assets :filter (lambda (a) (js-call stable-files :has (get a :file))))
                           :map (lambda (a) (str "stable-compatibility:" (get a :file))))))
                  (funcall add
                    (js-object
                      :id "original-program:compiler-interop-package-complete"
                      :kind "project"
                      :coverage (Array/from
                                  (new globalThis.Set
                                    (js-call (js-call suite-locators :map (lambda (l) (get l :id))) :concat fixture-coverage)))
                      :modules (globalThis.structuredClone modules)
                      :entry "bootstrap/compiler/compiler.mjs"
                      :request (js-object
                                 :operation "project"
                                 :resolveImports t
                                 :phased t
                                 :sourceMap t
                                 :entries (js-call modules :map (lambda (m) (get m :id))))
                      :execution
                        (js-object
                          :kind "original-program"
                          :host "tests/__eliscript_original_interop_package_complete.mjs"
                          :hostSource (str registration transported (run-cases source-root))
                          :arguments (js-array (js-object :directory t))
                          :aliases t
                          :requiresBun t
                          :hostRuntime "bun"
                          :childProcesses "inherit-selected-artifact"
                          :runtimeLaunchers t
                          :compilerSourceMaps t
                          :runtimeProfile "compiler"
                          :timeoutMs 120000
                          :setupReplacement
                            (js-object
                              :kind "selected-compiler-module-directory"
                              :algorithms "selected-target-only"
                              :sourceSha256 (get identity :sha256)
                              :modules (js-call modules :map (lambda (m) (get m :id)))
                              :changes changes
                              :originalCaseTimeouts (js-array 120000)
                              :independentOracle "unchanged bin/eliscript-seed-build"))
                      :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
                      :original
                        (js-object
                          :manifest "stable-compatibility"
                          :suite suite
                          :fixture "tests/fixtures/packages/interop-consumer/index.mjs"
                          :host suite
                          :sourceSha256 (get identity :sha256)
                          :originalAssertions (js-array assertion)
                          :sourceAssets source-assets
                          :regions (js-array
                                     (js-object
                                       :start 0
                                       :end (js-length original)
                                       :byteStart 0
                                       :byteEnd (js-call Buffer :byteLength original)
                                       :sha256 (sha256 original)))
                          :setupReplacement
                            (js-object
                              :kind "selected-compiler-module-directory"
                              :changes changes))))
                  suite))))))))

  (defasync add-original-literal-runtime-program (options)
    (let* ((add (get options :add))
           (locators (get options :locators))
           (text (get options :text))
           (file (get options :file))
           (source-root (get options :sourceRoot))
           (stable-files (get options :stableFiles))
           (modules (get options :modules))
           (suite "tests/literal-runtime.test.mjs")
           (suite-locators (js-call locators :filter (lambda (locator) (= (get locator :file) suite)))))
      (if (= (js-length suite-locators) 0)
        nil
        (let* ((original (await (funcall text suite)))
               (identity (await (funcall file suite)))
               (changes (js-array))
               (assertions
                 (js-array
                   "persistent literals and quoted data preserve language value categories"
                   "hash-map rejects incomplete pairs in both compilers"
                   "explicit host-only modules do not link the persistent runtime"
                   "maintained Eliscript sources use explicit host constructors"
                   "portable closures produce persistent values for the versioned worker codec"))
               (a-idx 0))
          (while (< a-idx (js-length assertions))
            (let ((title (aref assertions a-idx)))
              (unless (js-call original :includes (str "test(" (JSON/stringify title) ","))
                (throw (new globalThis.TypeError (str "original literal runtime assertion boundary changed: " title)))))
            (setq a-idx (1+ a-idx)))
          (let ((l-idx 0))
            (while (< l-idx (js-length suite-locators))
              (let ((locator (aref suite-locators l-idx)))
                (when (or (/= (value-type (get locator :contains)) "string")
                          (not (js-call original :includes (get locator :contains))))
                  (throw (new globalThis.TypeError "original literal runtime locator is absent from its complete suite"))))
              (setq l-idx (1+ l-idx))))
          (let ((source-assets (js-array))
                (asset-files
                  (js-array
                    "tests/fixtures/literal-runtime.eli"
                    "tests/fixtures/literal-runtime-host.mjs"
                    "bin/eliscript"
                    "bin/eliscript-portable"
                    "bin/eliscript-bootstrap"
                    "bootstrap/host/bun.mjs"))
                (f-idx 0))
            (while (< f-idx (js-length asset-files))
              (let* ((filename (aref asset-files f-idx))
                     (evidence (await (funcall file filename))))
                (js-call source-assets :push
                  (js-object :file filename :sourceSha256 (get evidence :sha256))))
              (setq f-idx (1+ f-idx)))
            (let ((transported (replace-setup original "import { expect, test } from \"bun:test\";"
                                 "import { expect } from \"bun:test\";" changes))
                  (matches (Array/from (js-call original :matchAll (new globalThis.RegExp "from \"(\\.\\.\\/runtime\\/[^\"\\n]+)\"" "g"))))
                  (m-idx 0))
              (while (< m-idx (js-length matches))
                (let* ((specifier (aref (aref matches m-idx) 1))
                       (filename (js-call specifier :slice 3))
                       (evidence (await (funcall file filename))))
                  (js-call source-assets :push
                    (js-object :file filename :sourceSha256 (get evidence :sha256)))
                  (setq transported
                    (replace-setup transported
                      (JSON/stringify specifier)
                      (JSON/stringify (get (pathToFileURL (resolve source-root filename)) :href))
                      changes)))
                (setq m-idx (1+ m-idx)))
              (setq transported
                (replace-setup
                  (replace-setup transported
                    "const ROOT = resolve(import.meta.dir, \"..\");"
                    "const ROOT = process.env.ELISCRIPT_ORIGINAL_SOURCE_ROOT;\nif (!ROOT) throw new Error(\"original literal runtime requires its source root\");"
                    changes)
                  "async function run(command, environment = {}, allowFailure = false) {\n"
                  "async function run(command, environment = {}, allowFailure = false) { return await __literal_transport.runLiteral(__literal_original_run, command, environment, allowFailure, {build: BUILD_BOOTSTRAP, seed: SEED, portable: SELF_HOSTED}); }\nasync function __literal_original_run(command, environment = {}, allowFailure = false) {\n"
                  changes))
              (let* ((mod-names (js-call modules :map (lambda (m) (js-call (get m :id) :slice (js-length "bootstrap/compiler/") -4))))
                     (registration
                       (str (project-registration source-root mod-names "__literal_transport"
                         (js-object :defaultTimeout 5000 :referenceRequired t
                           :referenceError "original dual-compiler literal assertions require their independent Seed product"
                           :registrationError "original literal runtime case registration changed"
                           :directoryError "original literal bootstrap output directory changed"))
                         "const __literal_selected=__literal_transport.selected;\n"
                         "const __literal_reference=__literal_transport.reference;\n"
                         "async function __literal_install_selected(...args) { return await __literal_transport.install(...args); }\n"))
                     (fixture-coverage
                       (js-call
                         (js-call source-assets :filter (lambda (a) (js-call stable-files :has (get a :file))))
                         :map (lambda (a) (str "stable-compatibility:" (get a :file))))))
                (funcall add
                  (js-object
                    :id "original-program:compiler-literal-runtime-complete"
                    :kind "project"
                    ;; The source-constructor audit still belongs to its precise original
                    ;; source-only gate. It also executes verbatim here, but is not relabelled
                    ;; as selected compiler semantic evidence.
                    :coverage (Array/from
                                (new globalThis.Set
                                  (js-call
                                    (js-call
                                      (js-call suite-locators :filter
                                        (lambda (l) (/= (get l :contains) (aref assertions 3))))
                                      :map (lambda (l) (get l :id)))
                                    :concat fixture-coverage)))
                    :modules (globalThis.structuredClone modules)
                    :entry "bootstrap/compiler/compiler.mjs"
                    :request (js-object
                               :operation "project"
                               :resolveImports t
                               :phased t
                               :sourceMap t
                               :entries (js-call modules :map (lambda (m) (get m :id))))
                    :execution
                      (js-object
                        :kind "original-program"
                        :host "tests/__eliscript_original_literal_runtime_complete.mjs"
                        :hostSource (str registration transported (run-cases source-root))
                        :arguments (js-array (js-object :directory t))
                        :aliases t
                        :requiresBun t
                        :hostRuntime "bun"
                        :referenceArtifact t
                        :childProcesses "inherit-selected-artifact"
                        :runtimeLaunchers t
                        :compilerSourceMaps t
                        :runtimeProfile "compiler"
                        :timeoutMs 245000
                        :setupReplacement
                          (js-object
                            :kind "selected-and-independent-reference-compiler-directories"
                            :algorithms "selected-target-only"
                            :sourceSha256 (get identity :sha256)
                            :modules (js-call modules :map (lambda (m) (get m :id)))
                            :changes changes
                            :originalCaseTimeouts (js-array 60000 60000 60000 5000 60000)
                            :originalHost "tests/fixtures/literal-runtime-host.mjs"))
                    :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
                    :original
                      (js-object
                        :manifest "stable-compatibility"
                        :suite suite
                        :fixture "tests/fixtures/literal-runtime.eli"
                        :host "tests/fixtures/literal-runtime-host.mjs"
                        :sourceSha256 (get identity :sha256)
                        :originalAssertions assertions
                        :sourceAssets source-assets
                        :regions (js-array
                                   (js-object
                                     :start 0
                                     :end (js-length original)
                                     :byteStart 0
                                     :byteEnd (js-call Buffer :byteLength original)
                                     :sha256 (sha256 original)))
                        :setupReplacement
                          (js-object
                            :kind "selected-and-independent-reference-compiler-directories"
                            :changes changes))))
                suite)))))))

  (defasync add-original-source-debugging-program (options)
    (let* ((add (get options :add))
           (locators (get options :locators))
           (text (get options :text))
           (file (get options :file))
           (source-root (get options :sourceRoot))
           (stable-files (get options :stableFiles))
           (modules (get options :modules))
           (suite "tests/source-debugging.test.mjs")
           (suite-locators (js-call locators :filter (lambda (locator) (= (get locator :file) suite)))))
      (if (= (js-length suite-locators) 0)
        nil
        (let* ((original (await (funcall text suite)))
               (identity (await (funcall file suite)))
               (changes (js-array))
               (l-idx 0))
          (while (< l-idx (js-length suite-locators))
            (let ((locator (aref suite-locators l-idx)))
              (when (or (/= (value-type (get locator :contains)) "string")
                        (not (js-call original :includes (get locator :contains))))
                (throw (new globalThis.TypeError "original source debugging locator is absent from its complete suite"))))
            (setq l-idx (1+ l-idx)))
          (let ((assertions
                  (js-array
                    "source mapping decodes V8 and browser stack dialects without a host API"
                    "compiler failure preserves its complete Eliscript source span"
                    "runtime failure maps through persistent evaluation"
                    "browser event and async rejection map under Bun and Node"
                    "source debugging corpus is complete and rejects evidence drift"))
                (a-idx 0))
            (while (< a-idx (js-length assertions))
              (let ((title (aref assertions a-idx)))
                (unless (js-call original :includes (str "test(" (JSON/stringify title) ","))
                  (throw (new globalThis.TypeError (str "original source debugging assertion boundary changed: " title)))))
              (setq a-idx (1+ a-idx)))
            (let ((source-assets (js-array))
                  (asset-files
                    (js-array
                      "tests/fixtures/source-debugging.eli"
                      "tests/fixtures/source-debugging-host.mjs"
                      "tests/fixtures/evaluation-session/main.eli"
                      "tests/fixtures/diagnostic-unbound.eli"
                      "tests/fixtures/worker.eli"
                      "contracts/source-debugging-corpus.json"
                      "tests/worker-runtime.test.mjs"
                      "runtime/source-mapping.mjs"
                      "platform/browser.mjs"
                      "tools/debugging/check.mjs"
                      "tools/backends/compiler-host-record.mjs"
                      "bootstrap/host/bun.mjs"
                      "bootstrap/host/evaluation.mjs"
                      "bootstrap/host/project.mjs"
                      "bin/eliscript"))
                  (f-idx 0))
              (while (< f-idx (js-length asset-files))
                (let* ((filename (aref asset-files f-idx))
                       (evidence (await (funcall file filename))))
                  (js-call source-assets :push
                    (js-object :file filename :sourceSha256 (get evidence :sha256))))
                (setq f-idx (1+ f-idx)))
              (let ((transported (replace-setup original "import {beforeAll, expect, test} from \"bun:test\";"
                                   "import {expect} from \"bun:test\";" changes))
                    (specifiers
                      (js-array
                        "../bootstrap/host/bun.mjs"
                        "../bootstrap/host/evaluation.mjs"
                        "../runtime/source-mapping.mjs"
                        "../tools/debugging/check.mjs"
                        "../tools/backends/compiler-host-record.mjs"))
                    (s-idx 0))
                (while (< s-idx (js-length specifiers))
                  (let ((specifier (aref specifiers s-idx)))
                    (setq transported
                      (replace-setup transported
                        (JSON/stringify specifier)
                        (JSON/stringify (get (pathToFileURL (resolve source-root (js-call specifier :slice 3))) :href))
                        changes)))
                  (setq s-idx (1+ s-idx)))
                (setq transported
                  (replace-setup
                    (replace-setup
                      (replace-setup transported
                        "const ROOT = fileURLToPath(new (globalThis.URL)(\"..\", import.meta.url));"
                        "const ROOT = process.env.ELISCRIPT_ORIGINAL_SOURCE_ROOT;\nif (!ROOT) throw new Error(\"original source debugging requires its source root\");"
                        changes)
                      "return ((compiler = await (loadCompiler())));"
                      "return ((compiler = await (loadCompiler(__eliscript_debug_compiler_directory))));"
                      changes)
                    "async function run(command, options) {\n"
                    "async function run(command, options) { return await __debug_transport.runDebug(__debug_original_run, command, options); }\nasync function __debug_original_run(command, options) {\n"
                    changes))
                ;; Only setup changes. In particular, both actual Node/Bun event hosts, CLI
                ;; diagnostics, persistent evaluation and every original assertion stay verbatim.
                (let* ((registration
                         (str (project-registration source-root (js-array) "__debug_transport"
                           (js-object :defaultTimeout 5000
                             :registrationError "original source debugging case registration changed"))
                           "const __eliscript_project_before_all=__debug_transport.hooks;\n"
                           "const __eliscript_debug_compiler_directory=__debug_transport.selected;\n"
                           "function beforeAll(...args) { return __debug_transport.beforeAll(...args); }\n"))
                       (debug-run-cases
                         (run-cases source-root "__eliscript_project_before_all"))
                       (fixture-coverage
                         (js-call
                           (js-call source-assets :filter (lambda (a) (js-call stable-files :has (get a :file))))
                           :map (lambda (a) (str "stable-compatibility:" (get a :file))))))
                  (funcall add
                    (js-object
                      :id "original-program:compiler-source-debugging"
                      :kind "project"
                      :coverage (Array/from
                                  (new globalThis.Set
                                    (js-call (js-call suite-locators :map (lambda (l) (get l :id))) :concat fixture-coverage)))
                      :modules (globalThis.structuredClone modules)
                      :entry "bootstrap/compiler/compiler.mjs"
                      :request (js-object
                                 :operation "project"
                                 :resolveImports t
                                 :phased t
                                 :sourceMap t
                                 :entries (js-call modules :map (lambda (m) (get m :id))))
                      :execution
                        (js-object
                          :kind "original-program"
                          :host "tests/__eliscript_original_source_debugging.mjs"
                          :hostSource (str registration transported debug-run-cases)
                          :arguments (js-array (js-object :directory t))
                          :aliases t
                          :requiresBun t
                          :childProcesses "inherit-selected-artifact"
                          :runtimeLaunchers t
                          :compilerSourceMaps t
                          :runtimeProfile "compiler"
                          :timeoutMs 30000
                          :setupReplacement
                            (js-object
                              :kind "selected-compiler-module-directory"
                              :algorithms "selected-target-only"
                              :sourceSha256 (get identity :sha256)
                              :modules (js-call modules :map (lambda (m) (get m :id)))
                              :changes changes
                              :originalCaseTimeouts (js-call assertions :map (lambda (_) 5000))
                              :originalHost "tests/fixtures/source-debugging-host.mjs"))
                      :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
                      :original
                        (js-object
                          :manifest "stable-compatibility"
                          :suite suite
                          :fixture "tests/fixtures/source-debugging.eli"
                          :host "tests/fixtures/source-debugging-host.mjs"
                          :sourceSha256 (get identity :sha256)
                          :originalAssertions assertions
                          :sourceAssets source-assets
                          :regions (js-array
                                     (js-object
                                       :start 0
                                       :end (js-length original)
                                       :byteStart 0
                                       :byteEnd (js-call Buffer :byteLength original)
                                       :sha256 (sha256 original)))
                          :setupReplacement
                            (js-object
                              :kind "selected-compiler-module-directory"
                              :changes changes))))
                  suite))))))))

  ;; Preserve the complete original suite, including its real filesystem, cache,
  ;; CLI, Node and independent Emacs assertions. Only setup transport changes:
  ;; the matrix has already compiled the entire original compiler source graph
  ;; on its selected host/target before this program can start.
  (defasync addOriginalProjectPrograms (options)
    (let ((add (get options :add))
          (locators (get options :locators))
          (text (get options :text))
          (file (get options :file))
          (bootstrap-sources (get options :bootstrapSources))
          (source-root (get options :sourceRoot))
          (stable-files (let ((v (get options :stableFiles))) (if (nullish? v) (new globalThis.Set) v))))
      (when (or (/= (value-type add) "function")
                (/= (value-type text) "function")
                (/= (value-type file) "function")
                (not (Array/isArray locators))
                (not (Array/isArray bootstrap-sources))
                (/= (value-type source-root) "string"))
        (throw (new globalThis.TypeError "original project adapter requires its complete source manifest and services")))
      (let ((assets (js-array)) (publish add)
            (paths (js-array "tools/backends/eliscript/compiler-corpus-project-transport.eli"
              "tools/backends/compiler-corpus-project-transport.mjs"
              "tools/backends/compiler-host-record.eli" "tools/backends/compiler-host-record.mjs"
              "tools/backends/compiler-host-iteration.eli" "tools/backends/compiler-host-iteration.mjs"
              "tools/backends/eliscript/compiler-corpus-cli-transport.eli"
              "tools/backends/compiler-corpus-cli-transport.mjs")) (index 0))
        (while (< index (js-length paths))
          (let* ((filename (aref paths index)) (source (await (funcall text filename)))
                 (identity (await (funcall file filename))))
            (unless (and (= (get identity :file) filename) (= (get identity :sha256) (sha256 source))
                         (= (get identity :bytes) (js-call Buffer :byteLength source)))
              (throw (new globalThis.TypeError "original project maintained transport source identity differs")))
            (js-call assets :push (js-object :file filename :sourceSha256 (get identity :sha256))))
          (setq index (1+ index)))
        (setq add (lambda (record)
          (let* ((original (get record :original))
                 (bound (if (Array/isArray (get original :sourceAssets))
                          (js-call (get original :sourceAssets) :slice) (js-array))) (index 0))
            (while (< index (js-length assets))
              (let* ((asset (aref assets index))
                     (existing (js-call bound :find (lambda (item) (= (get item :file) (get asset :file))))))
                (if (undefined? existing) (js-call bound :push asset)
                  (unless (= (get existing :sourceSha256) (get asset :sourceSha256))
                    (throw (new globalThis.TypeError "original project maintained transport source identity differs")))))
              (setq index (1+ index)))
            (funcall publish (Object/assign (js-object) record
              (js-object :original (Object/assign (js-object) original (js-object :sourceAssets bound)))))))))
      (let ((modules (js-array))
            (module-names (js-array))
            (seen (new globalThis.Set))
            (mod-re (new globalThis.RegExp "^bootstrap/compiler/[a-z][a-z0-9-]*\\.eli$"))
            (i 0))
        (while (< i (js-length bootstrap-sources))
          (let ((filename (aref bootstrap-sources i)))
            (when (or (/= (value-type filename) "string")
                      (not (js-call mod-re :test filename))
                      (js-call seen :has filename))
              (throw (new globalThis.TypeError "original compiler source manifest has an invalid or repeated module")))
            (js-call seen :add filename)
            (js-call modules :push
              (js-object
                :id (str (js-call filename :slice 0 -4) ".mjs")
                :filename filename
                :source (await (funcall text filename))))
            (js-call module-names :push (js-call filename :slice (js-length "bootstrap/compiler/") -4)))
          (setq i (1+ i)))
        (unless (and (= (js-length modules) 13)
                     (js-call seen :has "bootstrap/compiler/compiler.eli"))
          (throw (new globalThis.TypeError "original project programs require the complete thirteen-module compiler")))
        (let ((mapped (js-array))
              (plans
                (js-array
                  (js-object
                    :suite "tests/bootstrap-project.test.mjs"
                    :name "bootstrap-project"
                    :bootstrapBinding "bootstrapPath"
                    :rootDecl "const projectDirectory = resolve(fileURLToPath(new (globalThis.URL)(\".\", import.meta.url)), \"..\");"
                    :runHeader "async function run(command, ...__host_forwarded_arguments_2) {\n  return (await (async (options) => {\n"
                    :assertions
                      (js-array
                        "self-hosted project planning reaches deterministic graph fixed points"
                        "self-hosted project service matches seed output under Bun and Node"))
                  (js-object
                    :suite "tests/macro-file-dependencies.test.mjs"
                    :name "macro-file-dependencies"
                    :bootstrapBinding "buildPath"
                    :rootDecl "const projectDirectory = resolve(import.meta.dir, \"..\");"
                    :runHeader "async function run(command, ...__host_forwarded_arguments_1) {\n  return (await (async (options) => {\n"
                    :assertions
                      (js-array
                        "self-hosted macros read only declared context files"
                        "declared macro files drive deterministic project builds and cache invalidation"))))
              (p-idx 0))
          (while (< p-idx (js-length plans))
            (let* ((plan (aref plans p-idx))
                   (suite (get plan :suite))
                   (suite-locators (js-call locators :filter (lambda (locator) (= (get locator :file) suite)))))
              (when (> (js-length suite-locators) 0)
                (let* ((original (await (funcall text suite)))
                       (identity (await (funcall file suite)))
                       (changes (js-array))
                       (assertions (get plan :assertions))
                       (a-idx 0))
                  (while (< a-idx (js-length assertions))
                    (let ((name (aref assertions a-idx)))
                      (unless (js-call original :includes (str "test(" (JSON/stringify name) ", (async () => {"))
                        (throw (new globalThis.TypeError (str "original project suite assertion boundary changed: " name)))))
                    (setq a-idx (1+ a-idx)))
                  (let ((l-idx 0))
                    (while (< l-idx (js-length suite-locators))
                      (let ((locator (aref suite-locators l-idx)))
                        (when (or (/= (value-type (get locator :contains)) "string")
                                  (not (js-call original :includes (get locator :contains))))
                          (throw (new globalThis.TypeError "original project suite locator is not present in its complete source"))))
                      (setq l-idx (1+ l-idx))))
                  (let* ((transported
                           (replace-setup
                             (source-imports
                               (replace-setup
                                 (replace-setup original
                                   "import {expect, test} from \"bun:test\";"
                                   "import {expect} from \"bun:test\";"
                                   changes)
                                 (get plan :rootDecl)
                                 "const projectDirectory = process.env.ELISCRIPT_ORIGINAL_SOURCE_ROOT;\nif (!projectDirectory) throw new Error(\"original project program requires its source root\");"
                                 changes)
                               source-root
                               changes)
                             (get plan :runHeader)
                             (str (get plan :runHeader) "    if (await __eliscript_original_setup(command, options)) return \"\";\n")
                             changes))
                         (source (str (selected-directory-transport source-root module-names (get plan :bootstrapBinding))
                                      transported
                                      (run-cases source-root))))
                    (funcall add
                      (js-object
                        :id (str "original-program:compiler-project-" (get plan :name))
                        :kind "project"
                        :coverage (js-call suite-locators :map (lambda (locator) (get locator :id)))
                        :modules (globalThis.structuredClone modules)
                        :entry "bootstrap/compiler/compiler.mjs"
                        :request (js-object
                                   :operation "project"
                                   :resolveImports t
                                   :phased t
                                   :sourceMap t
                                   :entries (js-call modules :map (lambda (m) (get m :id))))
                        :execution
                          (js-object
                            :kind "original-program"
                            :host (str "tests/__eliscript_original_project_" (get plan :name) ".mjs")
                            :hostSource source
                            :arguments (js-array (js-object :directory t))
                            :aliases t
                            :requiresBun t
                            :childProcesses "inherit-selected-artifact"
                            :runtimeLaunchers t
                            :compilerSourceMaps t
                            :runtimeProfile "compiler"
                            :setupReplacement
                              (js-object
                                :kind "selected-compiler-module-directory"
                                :algorithms "selected-target-only"
                                :originalCommand "bin/eliscript-bootstrap"
                                :modules (js-call modules :map (lambda (m) (get m :id)))
                                :sourceSha256 (get identity :sha256)
                                :changes changes
                                :sourceMaps "independently-archived-selected-host-javascript-product"))
                        :expected (js-object :kind "seed-program" :oracleRequired t :stdout "")
                        :original
                          (js-object
                            :manifest "stable-compatibility"
                            :suite suite
                            :fixture suite
                            :host suite
                            :sourceSha256 (get identity :sha256)
                            :originalAssertions assertions
                            :regions (js-array
                                       (js-object
                                         :start 0
                                         :end (js-length original)
                                         :byteStart 0
                                         :byteEnd (js-call Buffer :byteLength original)
                                         :sha256 (sha256 original)))
                            :setupReplacement
                              (js-object
                                :kind "selected-compiler-module-directory"
                                :changes changes))))
                    (js-call mapped :push suite)))))
            (setq p-idx (1+ p-idx)))
          (let* ((sub-opts (js-object
                             :add add
                             :locators locators
                             :text text
                             :file file
                             :sourceRoot source-root
                             :stableFiles stable-files
                             :modules modules))
                 (debugging (await (add-original-source-debugging-program sub-opts)))
                 (_0 (when debugging (js-call mapped :push debugging)))
                 (literals (await (add-original-literal-runtime-program sub-opts)))
                 (_1 (when literals (js-call mapped :push literals)))
                 (interop (await (add-original-interop-package-program sub-opts)))
                 (_2 (when interop (js-call mapped :push interop)))
                 (cli-suites (await (add-original-frontend-cli-suites sub-opts))))
            (js-call mapped :concat cli-suites))))))

  (export addOriginalProjectPrograms))
