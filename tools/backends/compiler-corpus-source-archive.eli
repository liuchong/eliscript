(module tools.backends.compiler-corpus-source-archive
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdir lstat open)
  (import "node:fs" writeSync)
  (import "node:path" resolve dirname)
  (import "./compiler-session.mjs" encodeCompilerIR forEachCompilerIRChunk compilerSourceAssetEncoding)
  (import "./compiler-metadata.mjs" createCompilerMetadataDecoder)
  (import "./compiler-corpus.mjs" cloneCompilerCorpusData)

  (defun utf16-identity (source)
    (let ((hash (createHash "sha256"))
          (at 0)
          (len (js-length source)))
      ;; UTF16 hashes code units, so splitting a surrogate pair is lossless here.
      (while (< at len)
        (js-call hash :update (js-call source :slice at (+ at 32768)) "utf16le")
        (setq at (+ at 32768)))
      (js-object
        :encoding "utf16le"
        :bytes (* len 2)
        :sha256 (js-call hash :digest "hex"))))

  (defun json-chunks (value consume)
    (forEachCompilerIRChunk value consume)
    (funcall consume "\n"))

  (defun source-chunks (source encoding consume)
    (if (= encoding "json-utf16")
      (forEachCompilerIRChunk source consume)
      (let ((start 0)
            (len (js-length source)))
        (while (< start len)
          (let ((end (Math/min (+ start 32768) len)))
            (when (and (< end len)
                       (>= (js-call source :charCodeAt (1- end)) 55296)
                       (<= (js-call source :charCodeAt (1- end)) 56319)
                       (>= (js-call source :charCodeAt end) 56320)
                       (<= (js-call source :charCodeAt end) 57343))
              (setq end (1- end)))
            (funcall consume (js-call source :slice start end))
            (setq start end))))))

  (defun chunk-identity (visit)
    (let ((hash (createHash "sha256"))
          (bytes 0))
      (funcall visit
        (lambda (chunk)
          (setq bytes (+ bytes (js-call Buffer :byteLength chunk "utf8")))
          (js-call hash :update chunk "utf8")))
      (js-object :bytes bytes :sha256 (js-call hash :digest "hex"))))

  (defun normalize-ir (value)
    (let ((decoder (createCompilerMetadataDecoder)))
      (forEachCompilerIRChunk value (lambda (chunk) (js-call decoder :write chunk)))
      (js-call decoder :finish)))

  (defasync write-owned-chunks (path visit)
    ;; The caller already owns a complete snapshot and checked it before I/O.
    ;; Never retain its full escaped text or buffers for other pending assets.
    (let ((file (await (open path "wx")))
          (failed false))
      (try
        (funcall visit
          (lambda (chunk)
            (let ((bytes (js-call Buffer :from chunk "utf8"))
                  (offset 0))
              (while (< offset (js-length bytes))
                (let ((count (writeSync (get file :fd) bytes offset (- (js-length bytes) offset))))
                  (when (or (not (Number/isInteger count))
                            (< count 1)
                            (> count (- (js-length bytes) offset)))
                    (throw (new globalThis.Error "original source archive write did not advance")))
                  (setq offset (+ offset count)))))))
        (catch error
          (setq failed t)
          (throw error))
        (finally
          (try
            (await (js-call file :close))
            (catch error
              (unless failed
                (throw error))))))))

  (defun local-file (directory path)
    (when (or (/= (value-type path) "string")
              (= path "")
              (js-call (new globalThis.RegExp "[\\\\:\\u0000]") :test path)
              (js-call (js-call path :split "/") :some
                (lambda (part) (or (= part "") (= part ".") (= part "..")))))
      (throw (new globalThis.TypeError "original source archive requires a relative asset path")))
    (Reflect/apply resolve nil (js-call (js-array directory) :concat (js-call path :split "/"))))

  (defasync read-asset (directory path &rest __opt)
    (let* ((encoding (aref __opt 0))
           (identity (aref __opt 1))
           (mismatch (aref __opt 2))
           (enc (if (undefined? encoding) "json" encoding))
           (file (local-file directory path))
           (parent (resolve directory))
           (root (await (lstat parent))))
      (when (or (js-call root :isSymbolicLink) (not (js-call root :isDirectory)))
        (throw (new globalThis.TypeError "original source archive directory must be a real directory")))
      (let ((parts (js-call path :split "/"))
            (p-idx 0))
        (while (< p-idx (js-length parts))
          (setq parent (resolve parent (aref parts p-idx)))
          (let ((info (await (lstat parent))))
            (when (js-call info :isSymbolicLink)
              (throw (new globalThis.TypeError "original source archive traverses a filesystem alias")))
            (when (if (= parent file) (not (js-call info :isFile)) (not (js-call info :isDirectory)))
              (throw (new globalThis.TypeError "original source archive asset has the wrong file type"))))
          (setq p-idx (1+ p-idx))))
      (let ((input (await (open file "r")))
            (buffer (new globalThis.Uint8Array 65536))
            (hash (createHash "sha256"))
            (decoder (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)))
            (parser (if (or (= enc "json") (= enc "json-utf16")) (createCompilerMetadataDecoder) undefined))
            (parts (if (= enc "utf8") (js-array) undefined))
            (bytes 0)
            (decode-error undefined)
            (decode-failed false)
            (result undefined)
            (failed false))
        (unless (js-call (js-array "json" "json-utf16" "utf8") :includes enc)
          (setq decode-error (new globalThis.TypeError "unsupported compiler source asset encoding"))
          (setq decode-failed t))
        (let ((accept
                (lambda (text)
                  (if parser
                    (js-call parser :write text)
                    (js-call parts :push text)))))
          (try
            (let ((reading t))
              (while reading
                (let* ((read-res (await (js-call input :read buffer 0 (js-length buffer) nil)))
                       (bytes-read (get read-res :bytesRead)))
                  (when (or (not (Number/isInteger bytes-read))
                            (< bytes-read 0)
                            (> bytes-read (js-length buffer)))
                    (throw (new globalThis.Error "original source archive read returned an invalid byte count")))
                  (if (= bytes-read 0)
                    (setq reading false)
                    (let ((chunk (js-call buffer :subarray 0 bytes-read)))
                      (setq bytes (+ bytes bytes-read))
                      (js-call hash :update chunk)
                      (unless decode-failed
                        (try
                          (funcall accept (js-call decoder :decode chunk (js-object :stream t)))
                          (catch error
                            (setq decode-error error)
                            (setq decode-failed t)
                            (setq parser undefined)
                            (setq parts undefined)))))))))
            (unless decode-failed
              (try
                (funcall accept (js-call decoder :decode))
                (setq result (if parser (js-call parser :finish) (js-call parts :join "")))
                (when (and (= enc "json-utf16") (/= (value-type result) "string"))
                  (throw (new globalThis.TypeError "encoded compiler source asset must contain a JSON string")))
                (catch error
                  (setq decode-error error)
                  (setq decode-failed t))))
            (let ((sha256 (js-call hash :digest "hex")))
              ;; The original boundary checks complete file identity BEFORE decoding.
              ;; Defer any streaming parse/UTF8 failure until that same check succeeds.
              (when (and identity
                         (or (/= bytes (get identity :bytes))
                             (/= sha256 (get identity :sha256))))
                (throw (new globalThis.Error mismatch)))
              (when decode-failed
                (throw decode-error))
              result)
            (catch error
              (setq failed t)
              (throw error))
            (finally
              (try
                (await (js-call input :close))
                (catch error
                  (unless failed
                    (throw error))))))))))

  (defun source-record (value label)
    (when (or (nil? value)
              (/= (value-type value) "object")
              (/= (value-type (get value :source)) "string")
              (/= (value-type (get value :filename)) "string"))
      (throw (new globalThis.TypeError (str label " requires its exact source and filename"))))
    value)

  ;; A case archive is replay input, not only a display copy. Keep the entire
  ;; request/expected/execution recipe and its IEEE values, and store source text
  ;; without UTF-8 replacement of lone UTF-16 surrogates. Ordinal disk paths avoid
  ;; making virtual module identities depend on the host filesystem's encoding.
  (defasync archiveCompilerCorpusSources (record directory)
    (let ((snapshot (cloneCompilerCorpusData record)))
      (when (or (nil? snapshot)
                (/= (value-type snapshot) "object")
                (Array/isArray snapshot)
                (/= (value-type (get snapshot :id)) "string"))
        (throw (new globalThis.TypeError "original source archive requires a corpus case")))
      (when (and (not (undefined? (get snapshot :modules)))
                 (not (Array/isArray (get snapshot :modules))))
        (throw (new globalThis.TypeError "original source modules must be an array")))
      (let ((modules (let ((m (get snapshot :modules))) (if (nullish? m) (js-array) m)))
            (ids (new globalThis.Set))
            (m-idx 0))
        (while (< m-idx (js-length modules))
          (let ((module (aref modules m-idx)))
            (source-record module "original source module")
            (when (or (/= (value-type (get module :id)) "string")
                      (js-call ids :has (get module :id)))
              (throw (new globalThis.TypeError "original source module identities must be unique strings")))
            (js-call ids :add (get module :id)))
          (setq m-idx (1+ m-idx)))
        (when (= (get snapshot :kind) "stage")
          (source-record (get snapshot :request) "original stage request"))
        ;; Finish the immutable in-memory snapshot before the first asynchronous I/O.
        (let* ((record-identity (chunk-identity (lambda (consume) (json-chunks snapshot consume))))
               (assets (js-array))
               (prepare
                 (lambda (source name)
                   (let* ((encoding (compilerSourceAssetEncoding source))
                          (path (str name (if (= encoding "utf8") ".eli" ".eli.json")))
                          (asset (Object/assign
                                   (js-object :path path :encoding encoding)
                                   (chunk-identity (lambda (consume) (source-chunks source encoding consume))))))
                     (js-call assets :push (js-object :asset asset :source source))
                     (Object/assign (utf16-identity source) (js-object :asset asset)))))
               (archived-modules
                 (js-call modules :map
                   (lambda (module index)
                     (Object/assign
                       (js-object :id (get module :id) :filename (get module :filename))
                       (funcall prepare (get module :source)
                         (str "modules/" (js-call (globalThis.String index) :padStart 6 "0")))))))
               (stage
                 (if (= (get snapshot :kind) "stage")
                   (Object/assign
                     (js-object :filename (get (get snapshot :request) :filename))
                     (funcall prepare (get (get snapshot :request) :source) "stage-input")
                     (js-object :macroContext (get (get snapshot :request) :macroContext)))
                   undefined))
               (identity
                 (js-object
                   :format "eliscript-original-case-sources"
                   :version 1
                   :id (get snapshot :id)
                   :kind (get snapshot :kind)
                   :entry (get snapshot :entry)
                   :modules archived-modules
                   :stage stage
                   :coverage (get snapshot :coverage)
                   :original (get snapshot :original)
                   :suite (get snapshot :suite)
                   :steps (get snapshot :steps)
                   :record (Object/assign (js-object :path "record.json" :encoding "json") record-identity)))
               ;; Normalize optional fields exactly as they appear in the retained JSON.
               (body (normalize-ir identity))
               (result
                 (Object/assign (js-object) body
                   (js-object :sha256 (get (chunk-identity (lambda (consume) (json-chunks body consume))) :sha256)))))
          (await (mkdir directory (js-object :recursive t)))
          (let ((root (await (lstat directory))))
            (when (or (js-call root :isSymbolicLink) (not (js-call root :isDirectory)))
              (throw (new globalThis.TypeError "original source archive directory must be a real directory"))))
          (let ((a-idx 0))
            (while (< a-idx (js-length assets))
              (let* ((item (aref assets a-idx))
                     (asset (get item :asset))
                     (source (get item :source))
                     (path (local-file directory (get asset :path))))
                (await (mkdir (dirname path) (js-object :recursive t)))
                (let ((parent (await (lstat (dirname path)))))
                  (when (or (js-call parent :isSymbolicLink) (not (js-call parent :isDirectory)))
                    (throw (new globalThis.TypeError "original source archive traverses a filesystem alias"))))
                (await (write-owned-chunks path
                         (lambda (consume) (source-chunks source (get asset :encoding) consume)))))
              (setq a-idx (1+ a-idx))))
          (await (write-owned-chunks (local-file directory "record.json")
                   (lambda (consume) (json-chunks snapshot consume))))
          (await (write-owned-chunks (local-file directory "source-identity.json")
                   (lambda (consume) (json-chunks result consume))))
          result))))

  (defasync readArchivedCompilerCorpusSources (directory &optional options)
    (let* ((expected-identity (if (nullish? options) undefined (get options :expectedIdentity)))
           (identity (await (read-asset directory "source-identity.json")))
           (sha256 (get identity :sha256))
           (body (Object/assign (js-object) identity)))
      (Reflect/deleteProperty body "sha256")
      (when (or (/= (get identity :format) "eliscript-original-case-sources")
                (/= (get identity :version) 1)
                (/= sha256 (get (chunk-identity (lambda (consume) (json-chunks body consume))) :sha256))
                (and (not (undefined? expected-identity))
                     (/= sha256 expected-identity)))
        (throw (new globalThis.Error "original source archive identity differs")))
      (let ((record-asset (get identity :record)))
        (when (or (nullish? record-asset)
                  (/= (get record-asset :path) "record.json")
                  (/= (get record-asset :encoding) "json"))
          (throw (new globalThis.TypeError "original source archive has no complete case recipe")))
        (let* ((record (await (read-asset directory (get record-asset :path) "json" record-asset "original source case recipe bytes changed")))
               (rec-mods (let ((m (get record :modules))) (if (nullish? m) (js-array) m))))
          (when (or (/= (get record :id) (get identity :id))
                    (/= (get record :kind) (get identity :kind))
                    (/= (get record :entry) (get identity :entry))
                    (not (Array/isArray (get identity :modules)))
                    (/= (js-length rec-mods) (js-length (get identity :modules))))
            (throw (new globalThis.Error "original source archive case inventory differs")))
          (let* ((paths (new globalThis.Set (js-array "record.json" "source-identity.json")))
                 (check
                   (async (archived source)
                     (when (or (nullish? archived)
                               (/= (get archived :encoding) "utf16le")
                               (/= (get archived :filename) (get source :filename))
                               (/= (get archived :bytes) (* (js-length (get source :source)) 2))
                               (/= (get archived :sha256) (get (utf16-identity (get source :source)) :sha256)))
                       (throw (new globalThis.Error "original source archive does not bind the exact UTF16 source")))
                     (let ((asset (get archived :asset)))
                       (when (or (not asset) (js-call paths :has (get asset :path)))
                         (throw (new globalThis.Error "original source archive repeats an asset")))
                       (js-call paths :add (get asset :path))
                       (let ((text (await (read-asset directory (get asset :path)
                                            (if (undefined? (get asset :encoding)) "utf8" (get asset :encoding))
                                            asset "original source archive asset bytes changed"))))
                         (when (/= text (get source :source))
                           (throw (new globalThis.Error "original source archive text differs from its case recipe")))))))
                 (index 0))
            (while (< index (js-length (get identity :modules)))
              (let ((archived (aref (get identity :modules) index))
                    (module (source-record (aref rec-mods index) "archived source module")))
                (when (/= (get archived :id) (get module :id))
                  (throw (new globalThis.Error "original source module order or identity changed")))
                (await (funcall check archived module)))
              (setq index (1+ index)))
            (if (= (get record :kind) "stage")
              (progn
                (await (funcall check (get identity :stage) (source-record (get record :request) "archived stage request")))
                (when (/= (encodeCompilerIR (js-object :value (get (get identity :stage) :macroContext)))
                          (encodeCompilerIR (js-object :value (get (get record :request) :macroContext))))
                  (throw (new globalThis.Error "original stage archive changed its macro context"))))
              (unless (undefined? (get identity :stage))
                (throw (new globalThis.Error "original source archive added a stage request"))))
            (let ((fields (js-array "coverage" "original" "suite" "steps"))
                  (f-idx 0))
              (while (< f-idx (js-length fields))
                (let ((field (aref fields f-idx)))
                  (when (/= (encodeCompilerIR (js-object :value (get identity field)))
                            (encodeCompilerIR (js-object :value (get record field))))
                    (throw (new globalThis.Error "original source archive recipe metadata differs"))))
                (setq f-idx (1+ f-idx))))
            record)))))

  (export archiveCompilerCorpusSources readArchivedCompilerCorpusSources))
