(module tools.backends.compiler-build
  (import "node:fs/promises" mkdir readFile readdir writeFile open)
  (import "node:fs" writeSync)
  (import "node:path" resolve dirname relative sep)
  (import "node:crypto" createHash)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "./build.mjs" buildBackends root loadLiteralSources)
  (import "./compiler-session.mjs"
    encodeCompilerIR encodeCompilerSourceAsset forEachCompilerMetadataChunk
    requestCompilerBuildConsumption)
  (import "./managed-module-graph.mjs" createManagedProjectFacades)

  ;; This module owns orchestration, validation, and persistence. Imported
  ;; adapters supply filesystem access, compilation, and session transport.
  (defconst independentCompilerProfiles
    (Object/freeze
      (js-object
        :small (Object/freeze
          (js-object
            :budget (Object/freeze (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864))
            :memory (Object/freeze (js-object :initialPages 128 :maximumPages 4096)) :auto 65536))
        :full-runtime (Object/freeze
          (js-object
            :budget (Object/freeze (js-object :maxSlots 1048575 :initialBytes 67108864 :maxBytes 268435456))
            :memory (Object/freeze (js-object :initialPages 2048 :maximumPages 16384)) :auto 4194304))
        ;; Complete compiler source has more distinct AST objects than the
        ;; original full-runtime slot count can represent. This explicit heap
        ;; constructor leaves the original resource profiles and their gates
        ;; intact; its handles retire permanently at their declared generation
        ;; limit instead of wrapping or aliasing an older live reference.
        :full-compiler (Object/freeze
          (js-object
            :budget (Object/freeze (js-object :maxSlots 8388607 :initialBytes 268435456
              :maxBytes 1073741824 :extendedHeap t))
            :memory (Object/freeze (js-object :initialPages 4096 :maximumPages 65535)) :auto 16777216)))))

  (defun build-truth (value) (funcall globalThis.Boolean value))
  (defun build-default (value fallback) (if (undefined? value) fallback value))
  (defun build-nullish (value fallback) (if (nullish? value) fallback value))
  (defun build-optional-get (value key)
    (if (nullish? value) undefined (get value key)))
  (defun build-options (value)
    (when (eq value nil) (throw (new globalThis.TypeError "compiler options must not be null")))
    (build-default value (js-object)))
  ;; Optional Eliscript parameters default to nil. Preserve this public host
  ;; API's distinction between omitted/undefined options and explicit null.
  (defun build-call-options (arguments)
    (build-options (if (> (js-length arguments) 0) (aref arguments 0) undefined)))

  (defun build-trace (enabled phase context)
    (when enabled
      ;; Only internally captured scalar fields enter this diagnostic. IO is
      ;; secondary and must never replace a compiler or producer exception.
      (try
        (js-call (get globalThis.process :stderr) :write
          (+ "compiler-build trace " (JSON/stringify
            (build-copy-properties (js-object :phase phase) context)) "\n"))
        (catch ignored nil))))

  (defun build-observed-request (enabled request action)
    (if (not enabled) (funcall action)
      (let ((context (js-object :operation (get request :operation))))
        ;; Requests at these call sites are fresh private plain records; never
        ;; inspect arbitrary producer results, errors, source text or options.
        (js-call (js-array "kind" "id" "revision") :forEach (lambda (key)
          (when (Object/hasOwn request key)
            (let ((value (get request key)))
              (cond ((= (value-type value) "string") (put context key (js-call value :slice 0 256)))
                    ((and (= (value-type value) "number") (Number/isFinite value)) (put context key value)))))))
        (build-trace t "request-start" context)
        (try
          (let ((pending (funcall action)))
            (js-call (Promise/resolve pending) :then
              (lambda (value) (build-trace t "request-complete" context) value)
              (lambda (error) (build-trace t "request-failure" context) (throw error))))
          (catch error (build-trace t "request-failure" context) (throw error))))))

  ;; CopyDataProperties preserves spread's own-key order, symbols, getter
  ;; reads, and __proto__ data-property semantics without invoking setters.
  (defun build-copy-properties (target source &optional excluded)
    (unless (nullish? source)
      (let* ((object (funcall globalThis.Object source))
             (keys (Reflect/ownKeys object)) (index 0))
        (while (< index (js-length keys))
          (let ((key (aref keys index)))
            (unless (and excluded (js-call excluded :includes key))
              (let ((descriptor (Object/getOwnPropertyDescriptor object key)))
                (when (and descriptor (get descriptor :enumerable))
                  (Object/defineProperty target key
                    (js-object :value (get object key) :writable t :enumerable t :configurable t))))))
          (setq index (1+ index)))))
    target)

  (defun independentCompilerResources (&rest arguments)
    (let* ((input (build-call-options arguments))
           (profile (build-default (get input :profile) "small"))
           (budget (get input :budget)) (memory (get input :memory)) (auto (get input :auto))
           (defaults (get independentCompilerProfiles profile)))
      (unless (build-truth defaults)
        (throw (new globalThis.TypeError (+ "unknown independent compiler profile: " profile))))
      (js-object :profile profile
        :budget (build-copy-properties (build-copy-properties (js-object) (get defaults :budget)) budget)
        :memory (build-copy-properties (build-copy-properties (js-object) (get defaults :memory)) memory)
        :auto (build-nullish auto (get defaults :auto)))))

  (defasync read-compiler-source (path)
    (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t))
      :decode (await (readFile path))))

  (defasync compiler-source-names (source-root directory)
    (js-call
      (js-call (await (readdir (resolve source-root directory))) :filter
        (lambda (name) (js-call (new globalThis.RegExp "^[a-z][a-z0-9-]*[.]eli$") :test name)))
      :sort))

  (defasync loadCompilerSources (&rest arguments)
    (let* ((input (build-call-options arguments))
           (source-root (build-default (get input :sourceRoot) root))
           (names (await (compiler-source-names source-root "bootstrap/compiler")))
           (hosts (await (compiler-source-names source-root "bootstrap/host")))
           (backends (await (compiler-source-names source-root "bootstrap/backends")))
           (records (js-array)) (modules (js-array))
           (groups (js-array
             (js-array names "bootstrap/" "bootstrap/compiler/")
             (js-array backends "backends/" "bootstrap/backends/")
             (js-array hosts "host/" "bootstrap/host/")))
           (group-index 0) (index 0))
      (while (< group-index (js-length groups))
        (let* ((group (aref groups group-index)) (entries (aref group 0)))
          (setq index 0)
          (while (< index (js-length entries))
            (let ((name (aref entries index)))
              (js-call records :push (js-object
                :id (+ (aref group 1) (js-call name :slice 0 -4) ".mjs")
                :filename (+ (aref group 2) name))))
            (setq index (1+ index))))
        (setq group-index (1+ group-index)))
      (js-call records :push (js-object :id "runtime/math.mjs" :filename "runtime/math.eli"))
      (js-call records :push (js-object :id "runtime/unicode-case.mjs" :filename "runtime/unicode-case.eli"))
      (js-call records :push (js-object :id "runtime/unicode-case-data.mjs" :filename "runtime/unicode-case-data.eli"))
      (setq index 0)
      (while (< index (js-length records))
        (let ((record (aref records index)))
          (js-call modules :push
            (js-object :id (get record :id) :filename (get record :filename)
              :source (await (read-compiler-source (resolve source-root (get record :filename)))))))
        (setq index (1+ index)))
      (let ((filename "bootstrap/runtime/memory.eli"))
        (js-object :entry "host/compiler-session.mjs" :modules modules
          :literalSources (await (loadLiteralSources (js-object :sourceRoot source-root)))
          :runtime (js-object :filename filename
            :source (await (read-compiler-source (resolve source-root filename))))))))

  (defun decodeCompilerBinary (value)
    (cond
      ((js-call globalThis.Uint8Array (get globalThis.Symbol :hasInstance) value)
       (new globalThis.Uint8Array value))
      ((Array/isArray value)
       (let ((index 0))
         (while (< index (js-length value))
           (let ((byte (aref value index)))
             (unless (and (Number/isInteger byte) (>= byte 0) (<= byte 255))
               (throw (new globalThis.TypeError "compiler binary contains an invalid byte"))))
           (setq index (1+ index))))
       (js-call globalThis.Uint8Array :from value))
      (t
       (unless (and (not (nil? value)) (= (value-type value) "object")
                    (= (get value :encoding) "u16le-chunks"))
         (throw (new globalThis.TypeError "compiler binary has an unsupported encoding")))
       (let ((byte-length (get value :byteLength)) (chunks (get value :chunks)) (index 0))
         (unless (and (Number/isSafeInteger byte-length) (>= byte-length 0) (<= byte-length 4294967295)
                      (Array/isArray chunks) (= (js-length chunks) (Math/ceil (/ byte-length 4096))))
           (throw (new globalThis.TypeError "compiler binary has an invalid chunk layout")))
         (while (< index (js-length chunks))
           (let ((chunk (aref chunks index)) (size (Math/min 4096 (- byte-length (* index 4096)))))
             (unless (and (= (value-type chunk) "string") (= (js-length chunk) (Math/ceil (/ size 2)))
                          (or (= (% size 2) 0) (<= (js-call chunk :charCodeAt (1- (js-length chunk))) 255)))
               (throw (new globalThis.TypeError "compiler binary has a noncanonical chunk"))))
           (setq index (1+ index)))
         (let ((bytes (new globalThis.Uint8Array byte-length)))
           (setq index 0)
           (while (< index (js-length chunks))
             (let ((chunk (aref chunks index)) (unit 0))
               (while (< unit (js-length chunk))
                 (let ((word (js-call chunk :charCodeAt unit)) (at (+ (* index 4096) (* unit 2))))
                   (put bytes at (bit-and word 255))
                   (when (< (1+ at) byte-length) (put bytes (1+ at) (unsigned-bit-shift-right word 8))))
                 (setq unit (1+ unit))))
             (setq index (1+ index)))
           bytes)))))

  (defasync write-module (directory id javascript)
    (let ((path (resolve directory id)))
      (unless (js-call path :startsWith (+ (resolve directory) sep))
        (throw (new globalThis.TypeError "compiler module escapes output directory")))
      (await (mkdir (dirname path) (js-object :recursive t)))
      (await (writeFile path javascript))
      path))

  (defasync write-compiler-math-scope (directory)
    ;; Resolve the formal Math and Unicode support from this product, even when the
    ;; output is outside a checkout or installed package. No canonical runtime
    ;; symlink or caller package name participates in the compiler's imports.
    (let* ((path (resolve directory "package.json"))
           (text (str (JSON/stringify (js-object :name "eliscript" :type "module" :private t
             :exports (js-object "./runtime/math.mjs" "./runtime/math.mjs"
               "./runtime/unicode-case.mjs" "./runtime/unicode-case.mjs"
               "./runtime/unicode-case-data.mjs" "./runtime/unicode-case-data.mjs")) nil 2) "\n")))
      (try (await (writeFile path text (js-object :flag "wx")))
        (catch error
          (unless (and (= (get error :code) "EEXIST") (= (await (readFile path "utf8")) text))
            (throw error)))) path))

  (defasync write-compiler-seed-scope (directory)
    ;; The seed's existing local node_modules link supplies its real runtime.
    ;; Do not inherit the enclosing product's self-reference while that product
    ;; is still being emitted, or cache a missing enclosing package scope.
    (await (mkdir directory (js-object :recursive t)))
    (let* ((path (resolve directory "package.json"))
           (text (str (JSON/stringify (js-object :type "module" :private t) nil 2) "\n")))
      (try (await (writeFile path text (js-object :flag "wx")))
        (catch error
          (unless (and (= (get error :code) "EEXIST") (= (await (readFile path "utf8")) text))
            (throw error)))) path))

  (defun target-for-host (host)
    (cond ((or (= host "js") (= host "javascript")) "javascript")
          ((or (= host "wasm") (= host "native")) host)
          (t (throw (new globalThis.TypeError (+ "unknown compiler host: " host))))))

  (defun compiler-metadata-utf8-block (encoder bytes text start)
    (let ((end (Math/min (+ start 65536) (js-length text))))
      (when (and (< end (js-length text))
                 (>= (js-call text :charCodeAt (1- end)) 55296)
                 (<= (js-call text :charCodeAt (1- end)) 56319)
                 (>= (js-call text :charCodeAt end) 56320)
                 (<= (js-call text :charCodeAt end) 57343))
        (setq end (1- end)))
      (if (= end start) (js-object :read 0 :written 0)
        (let ((result (js-call encoder :encodeInto (js-call text :slice start end) bytes)))
          (unless (and (Number/isInteger (get result :read)) (>= (get result :read) 1)
                       (<= (get result :read) (- end start))
                       (Number/isInteger (get result :written)) (>= (get result :written) 1)
                       (<= (get result :written) (js-length bytes)))
            (throw (new globalThis.Error "compiler metadata UTF8 encoding did not advance")))
          result))))

  (defun compilerMetadataDigest (value)
    (let ((hash (createHash "sha256")) (encoder (new globalThis.TextEncoder))
          (bytes (new globalThis.Uint8Array 65536)))
      (forEachCompilerMetadataChunk value
        (lambda (chunk)
          (let ((start 0))
            (while (< start (js-length chunk))
              (let ((result (compiler-metadata-utf8-block encoder bytes chunk start)))
                (js-call hash :update (js-call bytes :subarray 0 (get result :written)))
                (setq start (+ start (get result :read))))))))
      (js-call hash :digest "hex")))

  (defasync compiler-file-identity (path buffer)
    (let* ((hash (createHash "sha256")) (file (await (open path "r")))
           (bytes 0) (failed false) (done false))
      (try
        (progn
          (while (not done)
            (let ((count (get (await (js-call file :read buffer 0 (js-length buffer) nil)) :bytesRead)))
              (unless (and (Number/isInteger count) (>= count 0) (<= count (js-length buffer)))
                (throw (new globalThis.Error "compiler artifact read returned an invalid byte count")))
              (if (= count 0) (setq done t)
                (progn (js-call hash :update (js-call buffer :subarray 0 count))
                       (setq bytes (+ bytes count))))))
          (js-object :bytes bytes :sha256 (js-call hash :digest "hex")))
        (catch error (setq failed t) (throw error))
        (finally (try (await (js-call file :close))
          (catch error (unless failed (throw error))))))))

  (defasync writeCompilerMetadata (path value &optional options)
    ;; Capture public values synchronously, before open yields to their owner.
    (let ((chunks (js-array)))
      (forEachCompilerMetadataChunk value (lambda (chunk) (js-call chunks :push chunk)))
      (js-call chunks :push "\n")
      (let ((file (await (open path (build-nullish (build-optional-get options "flag") "w")
                              (build-optional-get options "mode"))))
            (failed false))
        (try
          (let ((encoder (new globalThis.TextEncoder)) (bytes (new globalThis.Uint8Array 65536)) (index 0))
            (while (< index (js-length chunks))
              (let ((chunk (aref chunks index)) (start 0))
                (while (< start (js-length chunk))
                  (let* ((result (compiler-metadata-utf8-block encoder bytes chunk start))
                         (written (get result :written)) (offset 0))
                    (while (< offset written)
                      (let ((count (get (await (js-call file :write bytes offset (- written offset) nil)) :bytesWritten)))
                        (unless (and (Number/isInteger count) (>= count 1) (<= count (- written offset)))
                          (throw (new globalThis.Error "compiler metadata write did not advance")))
                        (setq offset (+ offset count))))
                    (setq start (+ start (get result :read))))))
              (put chunks index undefined)
              (setq index (1+ index)))
            undefined)
          (catch error (setq failed t) (throw error))
          (finally (try (await (js-call file :close))
            (catch error (unless failed (throw error)))))))))

  (defasync write-owned-compiler-metadata (path value)
    (let ((file (await (open path "w"))) (failed false))
      (try
        (let* ((encoder (new globalThis.TextEncoder)) (bytes (new globalThis.Uint8Array 65536))
               (consume (lambda (chunk)
                 (let ((start 0))
                   (while (< start (js-length chunk))
                     (let* ((result (compiler-metadata-utf8-block encoder bytes chunk start))
                            (written (get result :written)) (offset 0))
                       (while (< offset written)
                         (let ((count (writeSync (get file :fd) bytes offset (- written offset))))
                           (unless (and (Number/isInteger count) (>= count 1) (<= count (- written offset)))
                             (throw (new globalThis.Error "compiler metadata write did not advance")))
                           (setq offset (+ offset count))))
                       (setq start (+ start (get result :read)))))))))
          (forEachCompilerMetadataChunk value consume)
          (funcall consume "\n")
          undefined)
        (catch error (setq failed t) (throw error))
        (finally (try (await (js-call file :close))
          (catch error (unless failed (throw error))))))))

  (defun independentCompilerProductIdentity (input)
    (let* ((host (get input :host)) (native-target (get input :nativeTarget))
           (files (get input :files)) (descriptor (get input :descriptor)) (typed (get input :typed))
           (identity (js-object :host host)))
      (when (= host "native") (put identity :nativeTarget native-target) (put identity :nativeFormat "library"))
      (put identity :files
        (js-call (Array/from files) :sort
          (lambda (a b) (cond ((< (get a :path) (get b :path)) -1)
                             ((> (get a :path) (get b :path)) 1) (t 0)))))
      (when (build-truth descriptor) (put identity :descriptor (compilerMetadataDigest descriptor)))
      (when (build-truth typed) (put identity :typed (compilerMetadataDigest typed)))
      (build-copy-properties
        (js-object :algorithm "sha256"
          :sha256 (js-call (js-call (createHash "sha256") :update (JSON/stringify identity)) :digest "hex"))
        identity)))

  (defun seed-javascript-product (sources compiler debug)
    (let ((modules (js-array)) (failed false) (failure undefined) (index 0)
          (records (get sources :modules)))
      (while (< index (js-length records))
        (let* ((record (aref records index)) (program undefined) (origins undefined))
          (if (build-truth debug)
            (let ((expansion (js-call compiler :compile_ir_string_with_origins
                    (get record :source) (build-nullish (get record :filename) (get record :id)))))
              (setq program (get expansion :program)) (setq origins (get expansion :macroOrigins)))
            (setq program (js-call compiler :compile_ir_string (get record :source)
                            (build-nullish (get record :filename) (get record :id)))))
          (unless failed
            (try
              (let* ((emission (if (build-truth debug)
                       (js-call compiler :emit_ir_string_with_source_map program (get record :source)
                         (get record :id) (get record :filename))
                       (js-object :javascript (js-call compiler :emit_ir_string program))))
                     (output (build-copy-properties (js-object :id (get record :id)) emission)))
                (when (build-truth debug) (put output :macroOrigins origins))
                (js-call modules :push output))
              (catch error (setq failed t) (setq failure error)))))
        (setq index (1+ index)))
      (let ((runtime (get sources :runtime)))
        (if (build-truth debug)
          (js-call compiler :compile_ir_string_with_origins (get runtime :source) (get runtime :filename))
          (js-call compiler :compile_ir_string (get runtime :source) (get runtime :filename))))
      (when failed (throw failure))
      (js-object :target "javascript" :modules modules)))

  (defun compiler-ir-record (compiler record)
    (js-object :id (get record :id) :ir (encodeCompilerIR (get record :program))
      :canonicalIR (js-call compiler :serialize_ir_program (get record :program))))

  (defun compiler-retain-ir (product compiler modules runtime literal-ir)
    (put product :frontendIR (js-call modules :map (lambda (record) (compiler-ir-record compiler record))))
    (put product :runtimeIR (compiler-ir-record compiler (js-object :id "runtime" :program runtime)))
    (put product :literalIR literal-ir)
    product)

  (defasync seed-product (sources host directory frontend memory native-target retain-ir debug phase)
    (await (write-compiler-seed-scope (resolve directory "seed")))
    (funcall phase "seed-backends-start")
    (let* ((backend (await (buildBackends (js-object :outputRoot (resolve directory "seed") :frontend frontend))))
           (compiler (get backend :compiler)))
      (funcall phase "seed-backends-complete")
      (if (and (undefined? frontend) (= host "javascript") (not (build-truth retain-ir)))
        (progn
          (funcall phase "seed-javascript-start")
          (let ((product (seed-javascript-product sources compiler debug)))
            (funcall phase "seed-javascript-complete") product))
        (progn
          (funcall phase "seed-frontend-start")
          (let* ((origins (new globalThis.Map))
                 (modules (js-call (get sources :modules) :map
                   (lambda (record)
                     (js-object :id (get record :id) :program
                       (if (build-truth debug)
                         (let ((result (js-call compiler :compile_ir_string_with_origins (get record :source)
                                         (build-nullish (get record :filename) (get record :id)))))
                           (js-call origins :set (get record :id) (get result :macroOrigins))
                           (get result :program))
                         (js-call compiler :compile_ir_string (get record :source)
                           (build-nullish (get record :filename) (get record :id))))))))
                 (runtime-source (get sources :runtime))
                 (runtime-emission (if (build-truth debug)
                   (js-call compiler :compile_ir_string_with_origins (get runtime-source :source) (get runtime-source :filename))
                   undefined))
                 (runtime (if (nullish? (build-optional-get runtime-emission "program"))
                   (js-call compiler :compile_ir_string (get runtime-source :source) (get runtime-source :filename))
                   (get runtime-emission :program)))
                 (literal-modules (if (or (not (= host "javascript")) (build-truth retain-ir))
                   (js-call (build-nullish (get sources :literalSources) (js-array)) :map
                     (lambda (record)
                       (if (not (build-truth debug))
                         (js-object :id (get record :id) :program
                           (js-call compiler :compile_ir_string (get record :source) (get record :filename)))
                         (let ((emission (js-call compiler :compile_ir_string_with_origins
                                           (get record :source) (get record :filename))))
                           (js-call origins :set (get record :id) (get emission :macroOrigins))
                           (js-object :id (get record :id) :program (get emission :program))))))
                   (js-array)))
                 (literal-ir (if (build-truth retain-ir)
                   (js-call literal-modules :map (lambda (record) (compiler-ir-record compiler record))) undefined)))
            (funcall phase "seed-frontend-complete")
            (if (= host "javascript")
              (progn
                (unless (build-truth retain-ir) (setq runtime nil) (setq runtime-emission nil))
                (let ((product (js-object :target "javascript" :modules
                        (js-call modules :map
                          (lambda (record index)
                            (let* ((source (aref (get sources :modules) index))
                                   (emission (if (build-truth debug)
                                     (js-call compiler :emit_ir_string_with_source_map (get record :program)
                                       (get source :source) (get record :id) (get source :filename))
                                     (js-object :javascript (js-call compiler :emit_ir_string (get record :program)))))
                                   (output (build-copy-properties (js-object :id (get record :id)) emission)))
                              (when (build-truth debug) (put output :macroOrigins (js-call origins :get (get record :id))))
                              (unless (build-truth retain-ir) (put record :program nil))
                              output))))))
                  (when (build-truth retain-ir) (compiler-retain-ir product compiler modules runtime literal-ir))
                  product))
              (let* ((lower-options (js-object :hostModules (build-nullish (get sources :hostModules) (js-array))
                                      :phased (= (get sources :phased) t) :literalModules literal-modules))
                     (release-programs (lambda ()
                       (js-call modules :forEach (lambda (record) (put record :program nil)))
                       (js-call literal-modules :forEach (lambda (record) (put record :program nil)))
                       (setq runtime nil))))
                (funcall phase "seed-managed-lower-start")
                (let* ((lowered (if (= host "wasm")
                         (js-call (get backend :wasm) :emit_managed_project_wasm_product modules (get sources :entry) runtime lower-options
                           (lambda ()
                             (unless (build-truth retain-ir) (funcall release-programs))
                             (funcall phase "seed-managed-lower-complete") (funcall phase "seed-wasm-emit-start")
                             (js-object :memory (object-assoc memory :binaryEncoding "u16le-chunks") :debug debug)))
                         (js-call (get backend :managed) :lower_managed_project modules (get sources :entry) runtime lower-options))))
                  (unless (build-truth retain-ir) (funcall release-programs))
                  (funcall phase (if (= host "wasm") "seed-wasm-emit-complete" "seed-managed-lower-complete"))
                  (let* ((emission (if (build-truth debug)
                           (if (= host "wasm") lowered
                             (js-call (get backend :native) :emit_fresh_observed_typed_native_memory_artifact
                               (get lowered :typed) native-target (js-object :format "library" :binaryEncoding "u16le-chunks") phase)) nil))
                         (bytes (if (= host "wasm") (get lowered :bytes)
                           (if (build-truth emission) (get emission :bytes)
                             (js-call (get backend :native) :emit_fresh_observed_typed_native_memory_library
                               (get lowered :typed) native-target (js-object :binaryEncoding "u16le-chunks") phase))))
                         (debug-map undefined))
                    (when (build-truth emission)
                      (setq debug-map (build-copy-properties (js-object) (get emission :debug)))
                      (when (= host "wasm")
                        (put debug-map :moduleByteLength (if (Array/isArray bytes) (js-length bytes) (get bytes :byteLength))))
                      (let* ((source-record (lambda (record)
                               (js-object :id (get record :id) :filename (get record :filename)
                                 :macroOrigins (js-call origins :get (get record :id)))))
                             (debug-sources (js-call (get sources :modules) :map source-record)))
                        (js-call (build-nullish (get sources :literalSources) (js-array)) :forEach
                          (lambda (record) (js-call debug-sources :push (funcall source-record record))))
                        (js-call debug-sources :push (js-object :id "runtime" :filename (get runtime-source :filename)
                          :macroOrigins (build-nullish (build-optional-get runtime-emission "macroOrigins") (js-array))))
                        (put debug-map :sources debug-sources)))
                    (let ((product (js-object :target (target-for-host host) :bytes bytes :descriptor (get lowered :descriptor))))
                      (when (= host "native") (put product :typed (get lowered :typed)))
                      (put product :debug debug-map)
                      (when (build-truth retain-ir) (compiler-retain-ir product compiler modules runtime literal-ir))
                      (funcall release-programs) (setq runtime-emission nil)
                      product))))))))))

  (defun compiler-source-identity-record (record)
    (js-object :id (get record :id) :filename (get record :filename)
      :sha256 (js-call (js-call (createHash "sha256") :update (get record :source) "utf16le") :digest "hex")))

  (defun compiler-source-identity (graph)
    (let* ((runtime (get graph :runtime))
           (identity (js-object :algorithm "sha256" :encoding "utf16le"
             :modules (js-call (get graph :modules) :map compiler-source-identity-record)
             :runtime (js-object :filename (get runtime :filename)
               :sha256 (js-call (js-call (createHash "sha256") :update (get runtime :source) "utf16le") :digest "hex")))))
      (when (build-truth (get graph :literalSources))
        (put identity :literalSources (js-call (get graph :literalSources) :map compiler-source-identity-record)))
      (when (build-truth (get graph :hostSources))
        (put identity :hostSources (js-call (get graph :hostSources) :map compiler-source-identity-record)))
      identity))

  (defun compiler-portable-path (directory path)
    (js-call (js-call (relative directory path) :split sep) :join "/"))

  (defun compiler-portable-ir-record (directory record)
    (let ((output (build-copy-properties (js-object) record)))
      (put output :path (compiler-portable-path directory (get record :path)))
      (put output :canonicalPath (compiler-portable-path directory (get record :canonicalPath)))
      output))

  (defun compiler-artifact-metadata (artifact directory)
    (let ((metadata (build-copy-properties (js-object) artifact
                      (js-array "bytes" "lowered" "load" "directory" "url" "metadataPath"))))
      (put metadata :path (compiler-portable-path directory (get artifact :path)))
      (put metadata :runtimePath (compiler-portable-path directory (get artifact :runtimePath)))
      (when (build-truth (get artifact :debugPath))
        (put metadata :debugPath (compiler-portable-path directory (get artifact :debugPath))))
      (when (build-truth (get artifact :frontendIR))
        (put metadata :frontendIR (js-call (get artifact :frontendIR) :map
          (lambda (record) (compiler-portable-ir-record directory record)))))
      (when (build-truth (get artifact :literalIR))
        (put metadata :literalIR (js-call (get artifact :literalIR) :map
          (lambda (record) (compiler-portable-ir-record directory record)))))
      (when (build-truth (get artifact :modules))
        (put metadata :modules (js-call (get artifact :modules) :map
          (lambda (record)
            (let ((output (js-object :id (get record :id) :path (compiler-portable-path directory (get record :path)))))
              (when (build-truth (get record :sourceMapPath))
                (put output :sourceMapPath (compiler-portable-path directory (get record :sourceMapPath))))
              (when (build-truth (get record :macroOriginsPath))
                (put output :macroOriginsPath (compiler-portable-path directory (get record :macroOriginsPath))))
              output)))))
      (when (build-truth (get artifact :hostSources))
        (put metadata :hostSources (js-call (get artifact :hostSources) :map
          (lambda (record) (js-object :id (get record :id)
            :path (compiler-portable-path directory (get record :path)))))))
      (when (build-truth (get artifact :literalSources))
        (put metadata :literalSources (js-call (get artifact :literalSources) :map
          (lambda (record) (object-assoc record :path (compiler-portable-path directory (get record :path)))))))
      metadata))

  (defasync compiler-save-ir (directory record index literal)
    (let* ((name (+ (js-call (funcall globalThis.String index) :padStart 4 "0") ".json"))
           (path (if literal (resolve directory "ir" "literal" name) (resolve directory "ir" name)))
           (canonical-path (+ path ".canonical")))
      (await (mkdir (dirname path) (js-object :recursive t)))
      (await (writeFile path (get record :ir)))
      (await (writeFile canonical-path (get record :canonicalIR)))
      (js-object :id (get record :id) :stage "frontend" :path path :canonicalPath canonical-path)))

  (defasync compiler-runtime-ir-checkpoint (producer graph ready directory signal trace phase)
    (funcall phase "runtime-retained-ir-start")
    (let* ((literals (build-nullish (get graph :literalSources) (js-array)))
           (identity (compiler-source-identity (js-object :modules (js-array)
                       :runtime (get graph :runtime) :literalSources literals)))
           (checkpoint (js-object :format "eliscript-compiler-runtime-ir-checkpoint" :version 1
             :producerHost (if (= (get producer :host) "js") "javascript" (get producer :host))
             :revision (get ready :revision) :literalRevision (get ready :literalRevision)
             :sourceIdentity identity :literals (js-array)))
           (receipt (resolve directory "ir/runtime-checkpoint.json"))
           (request (js-object :operation "cached-ir" :kind "runtime" :revision (get ready :revision))))
      (Reflect/deleteProperty identity "modules")
      ;; Persist each response before requesting the next one. Only small file
      ;; references survive this scope; no runtime/literal IR graph or text is
      ;; retained alongside the subsequent project build.
      (let ((record (await (build-observed-request trace request
                      (lambda () (js-call producer :request request (js-object :signal signal)))))))
        (unless (and (= (build-optional-get record "id") "runtime")
                     (= (value-type (get record :ir)) "string")
                     (= (value-type (get record :canonicalIR)) "string"))
          (throw (new globalThis.TypeError "compiler omitted its original frontend IR")))
        (put checkpoint :runtime (await (compiler-save-ir directory record (js-length (get graph :modules)) false))))
      (let ((save-receipt (async ()
              (let ((output (build-copy-properties (js-object) checkpoint)))
                (put output :runtime (compiler-portable-ir-record directory (get checkpoint :runtime)))
                (put output :literals (js-call (get checkpoint :literals) :map
                  (lambda (record) (compiler-portable-ir-record directory record))))
                (await (writeCompilerMetadata receipt output))))))
        (await (funcall save-receipt))
        (let ((index 0))
          (while (< index (js-length literals))
            (let* ((expected (aref literals index))
                   (literal-request (js-object :operation "cached-ir" :kind "literal"
                     :id (get expected :id) :revision (get ready :literalRevision)))
                   (record (await (build-observed-request trace literal-request
                     (lambda () (js-call producer :request literal-request (js-object :signal signal)))))))
              (unless (and (= (build-optional-get record "id") (get expected :id))
                           (= (value-type (get record :ir)) "string")
                           (= (value-type (get record :canonicalIR)) "string"))
                (throw (new globalThis.TypeError "compiler changed its persistent literal frontend IR identity")))
              (js-call (get checkpoint :literals) :push (await (compiler-save-ir directory record index t))))
            (await (funcall save-receipt))
            (setq index (1+ index)))))
      (funcall phase "runtime-retained-ir-complete")
      checkpoint))

  (defasync buildIndependentCompiler (&rest arguments)
    (let* ((input (build-call-options arguments))
           (host (build-default (get input :host) "wasm"))
           (output-root (let ((value (get input :outputRoot)))
                          (if (undefined? value) (resolve root "dist/independent-compiler" host) value)))
           (source-root (build-default (get input :sourceRoot) root))
           (sources (get input :sources)) (frontend (get input :frontend)) (session (get input :session))
           (profile (build-default (get input :profile) "small"))
           (budget (get input :budget)) (memory (get input :memory)) (auto (get input :auto))
           (native-target (let ((value (get input :nativeTarget)))
             (if (undefined? value)
               (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos") value)))
           (retain-ir (build-default (get input :retainIR) false))
           (debug (build-default (get input :debug) false))
           (signal (get input :signal)) (on-phase (get input :onPhase))
           (target (target-for-host host)))
      (setq host target)
      (unless (js-call (js-array "arm64-macos" "arm64-linux") :includes native-target)
        (throw (new globalThis.TypeError "unsupported native compiler target")))
      (let ((resources (independentCompilerResources
              (js-object :profile profile :budget budget :memory memory :auto auto))))
        (unless (or (undefined? on-phase) (= (value-type on-phase) "function"))
          (throw (new globalThis.TypeError "compiler phase observer must be a function")))
        (let* ((trace (= (get (get globalThis.process :env) "ELISCRIPT_COMPILER_BUILD_TRACE") "1"))
               (phase (lambda (name &optional counts)
                 (build-trace trace name nil)
                 (unless (undefined? on-phase)
                   (try
                     (funcall on-phase name (Object/freeze (build-copy-properties (js-object :host host) counts)))
                     (catch ignored undefined)))))
               (directory (resolve output-root)))
          (funcall phase "sources-start")
          ;; The supplied graph is captured before this invocation yields.
          ;; Loader-created source records already belong to this build.
          (let ((graph (if (nullish? sources)
                        (await (loadCompilerSources (js-object :sourceRoot source-root)))
                        (funcall globalThis.structuredClone sources))))
            (funcall phase "sources-complete")
            (let ((producer (if (nullish? session)
                    (if (= (value-type (build-optional-get frontend "request")) "function") frontend undefined) session)))
              (when (and (not (undefined? session))
                         (not (= (value-type (build-optional-get session "request")) "function")))
                (throw (new globalThis.TypeError "independent compiler producer requires session.request")))
              (await (mkdir directory (js-object :recursive t)))
              ;; Establish the final package before any nested seed modules are
              ;; loaded. Node retains package-scope lookups for this directory;
              ;; writing this only after emission is too late for artifact.load.
              (when (and (= host "javascript")
                         (js-call (get graph :modules) :some
                           (lambda (record) (= (get record :id) "runtime/math.mjs"))))
                (await (write-compiler-math-scope directory)))
              (let ((product undefined) (owned-product false) (runtime-checkpoint undefined))
                (if (build-truth producer)
                  (progn
                    (funcall phase "runtime-start")
                    (let ((runtime-request (js-object :operation "runtime" :source (get (get graph :runtime) :source)
                                             :filename (get (get graph :runtime) :filename))))
                      (when (build-truth (get graph :literalSources))
                        (put runtime-request :literalSources (get graph :literalSources)))
                      (let ((runtime-response (await (build-observed-request trace runtime-request
                               (lambda () (js-call producer :request runtime-request (js-object :signal signal))))))
                            (response-options (js-object :signal signal)))
                        (funcall phase "runtime-complete")
                        (when (build-truth retain-ir)
                          (setq runtime-checkpoint (await (compiler-runtime-ir-checkpoint
                            producer graph runtime-response directory signal trace phase))))
                        (when (or (= host "native") (= host "wasm"))
                          (let* ((capability-request (js-object :operation "capabilities"))
                                 (capabilities (await (build-observed-request trace capability-request
                                   (lambda () (js-call producer :request capability-request (js-object :signal signal))))))
                                 (modes (build-optional-get capabilities "responseModes")))
                            (cond
                              ((and (or (= host "native") (= debug t))
                                    (not (nullish? modes)) (js-call modes :includes "graph-events-v1"))
                               (setq response-options (js-object :signal signal :responseMode "graph-events-v1")))
                              ((and (not (nullish? modes)) (js-call modes :includes "events-v1"))
                               (setq response-options (js-object :signal signal :responseMode "events-v1")))
                              ((and (not (nullish? modes)) (js-call modes :includes "graph-events-v1"))
                               (setq response-options (js-object :signal signal :responseMode "graph-events-v1"))))))
                        (funcall phase "project-start")
                        (let ((request (js-object :operation "project" :modules (get graph :modules))))
                          (when (build-truth (get graph :hostModules)) (put request :hostModules (get graph :hostModules)))
                          (when (build-truth (get graph :hostSources)) (put request :hostSources (get graph :hostSources)))
                          (when (= (get graph :phased) t) (put request :phased t))
                          (put request :entry (get graph :entry)) (put request :target target)
                          (put request :memory (get resources :memory)) (put request :nativeTarget native-target)
                          (put request :nativeFormat "library")
                          (when (or (= host "native") (= host "wasm")) (put request :binaryEncoding "u16le-chunks"))
                          (when (and (= host "javascript") (= debug t)) (put request :sourceMap t))
                          (put request :debug debug)
                          ;; Full WASM debug arrays can exceed the engine's
                          ;; ownKeys limit. Their existing event transport
                          ;; preserves all entries without eager enumeration;
                          ;; native keeps its verified single-owner handoff.
                          (let ((consumption (if (= host "wasm")
                                  (js-object :product (await (build-observed-request trace request
                                    (lambda () (js-call producer :request request response-options)))) :owned false)
                                  (await (build-observed-request trace request
                                    (lambda () (requestCompilerBuildConsumption producer request response-options)))))))
                            (setq product (get consumption :product)) (setq owned-product (get consumption :owned))))
                        (funcall phase "project-complete")
                        (when (build-truth retain-ir)
                          (funcall phase "retained-ir-start")
                          (put product :frontendIR (js-array))
                          (let ((index 0) (modules (get graph :modules)))
                            (while (< index (js-length modules))
                              (let ((request (js-object :operation "cached-ir" :kind "module" :id (get (aref modules index) :id)
                                               :revision (get product :revision))))
                                (js-call (get product :frontendIR) :push
                                  (await (build-observed-request trace request
                                    (lambda () (js-call producer :request request (js-object :signal signal)))))))
                              (setq index (1+ index))))
                          (funcall phase "retained-ir-complete")))))
                  (progn
                    (when (build-truth (build-optional-get signal "aborted"))
                      (let ((reason (get signal :reason)))
                        (throw (if (nullish? reason) (new globalThis.Error "compiler build aborted") reason))))
                    (setq product (await (seed-product graph host directory frontend (get resources :memory)
                                           native-target retain-ir debug phase)))
                    (setq owned-product t)))
                (unless (= (build-optional-get product "target") target)
                  (throw (new globalThis.TypeError "compiler producer returned a different target")))
                (let* ((artifact (build-copy-properties
                         (js-object :host host :target target :directory directory :entry (get graph :entry)) resources))
                       (files undefined) (reserved undefined))
                  (put artifact :nativeTarget native-target) (put artifact :debugEnabled debug)
                  (put artifact :capabilities (js-object :productTargets (js-array "javascript" "wasm" "native")
                    :nativeProductTargets (if (js-call (get graph :modules) :some
                                                (lambda (record) (= (get record :id) "backends/elf.mjs")))
                                           (js-array "arm64-macos" "arm64-linux") (js-array "arm64-macos"))))
                  (put artifact :sourceIdentity (compiler-source-identity graph))
                  (put artifact :provenance
                    (js-object :mode (if (build-truth producer) "session" "seed")
                      :producerHost (if (build-truth producer)
                        (if (= (get producer :host) "js") "javascript" (get producer :host)) "javascript")
                      :compiledModuleIds (js-call (get graph :modules) :map (lambda (record) (get record :id)))
                      :runtimeCompiled t))
                  (if (= host "javascript")
                    (progn
                      (funcall phase "javascript-files-start")
                      (unless (Array/isArray (get product :modules))
                        (throw (new globalThis.TypeError "JavaScript compiler product has no modules")))
                      (let ((expected (new globalThis.Set
                                       (js-call (get graph :modules) :map (lambda (record) (get record :id)))))
                            (index 0))
                        (put artifact :modules (js-array))
                        (while (< index (js-length (get product :modules)))
                          (let ((record (aref (get product :modules) index)))
                            (unless (and (js-call expected :delete (get record :id))
                                         (= (value-type (get record :javascript)) "string"))
                              (throw (new globalThis.TypeError "JavaScript compiler product contains an unexpected module")))
                            (let* ((path (await (write-module directory (get record :id) (get record :javascript))))
                                   (output (js-object :id (get record :id) :path path)))
                              (when (= (value-type (get record :sourceMap)) "string")
                                (await (writeFile (+ path ".map") (get record :sourceMap))))
                              (when (Array/isArray (get record :macroOrigins))
                                (await (writeFile (+ path ".macro-origins.json")
                                  (+ (JSON/stringify (get record :macroOrigins) nil 2) "\n"))))
                              (when (= (value-type (get record :sourceMap)) "string") (put output :sourceMapPath (+ path ".map")))
                              (when (Array/isArray (get record :macroOrigins)) (put output :macroOriginsPath (+ path ".macro-origins.json")))
                              (js-call (get artifact :modules) :push output))
                            (when owned-product (put (get product :modules) index undefined)))
                          (setq index (1+ index)))
                        (unless (= (get expected :size) 0)
                          (throw (new globalThis.TypeError "JavaScript compiler product omitted modules"))))
                      (put artifact :path (resolve directory (get graph :entry)))
                      (put artifact :url (get (pathToFileURL (get artifact :path)) :href))
                      ;; Emitted compiler modules have no top-level await.
                      ;; The host module loader remains an IO-only adapter.
                      (let ((require-module (createRequire (resolve root "tools/backends/compiler-build.mjs")))
                            (module-path (get artifact :path)))
                        (put artifact :load (async () (funcall require-module module-path))))
                      (funcall phase "javascript-files-complete"))
                    (progn
                      (unless (and (build-truth (get product :descriptor)) (build-truth (get product :bytes))
                                   (or (not (= host "native")) (build-truth (get product :typed))))
                        (throw (new globalThis.TypeError "binary compiler product omitted its bytes or lowering record")))
                      (funcall phase "binary-decode-start")
                      (put artifact :bytes (decodeCompilerBinary (get product :bytes)))
                      (when owned-product (put product :bytes undefined))
                      (funcall phase "binary-decode-complete" (js-object :byteLength (get (get artifact :bytes) :byteLength)))
                      (put artifact :descriptor (get product :descriptor)) (put artifact :typed (get product :typed))
                      (when (build-truth (get product :typed))
                        (put artifact :lowered (js-object :typed (get product :typed) :descriptor (get product :descriptor))))
                      (put artifact :path (resolve directory (if (= host "wasm") "compiler.wasm"
                        (if (= native-target "arm64-linux") "compiler.so" "compiler.dylib"))))
                      (await (writeFile (get artifact :path) (get artifact :bytes)))
                      (funcall phase "binary-file-complete")))
                  (let ((runtime-asset (encodeCompilerSourceAsset (get (get graph :runtime) :source))))
                    (put artifact :runtimePath (resolve directory
                      (if (= (get runtime-asset :encoding) "utf8") "runtime.eli" "runtime.eli.json")))
                    (unless (= (get runtime-asset :encoding) "utf8") (put artifact :runtimeEncoding (get runtime-asset :encoding)))
                    (await (writeFile (get artifact :runtimePath) (get runtime-asset :text))))
                  (setq files (if (= host "javascript")
                    (js-call (get artifact :modules) :flatMap
                      (lambda (record)
                        (let ((paths (js-array (get record :path))))
                          (when (build-truth (get record :sourceMapPath)) (js-call paths :push (get record :sourceMapPath)))
                          (when (build-truth (get record :macroOriginsPath)) (js-call paths :push (get record :macroOriginsPath)))
                          paths)))
                    (js-array (get artifact :path))))
                  (when (and (= host "javascript")
                             (js-call (get artifact :modules) :some (lambda (record) (= (get record :id) "runtime/math.mjs"))))
                    (js-call files :push (await (write-compiler-math-scope directory))))
                  (setq reserved (new globalThis.Set (if (= host "javascript")
                    (js-call (get artifact :modules) :map (lambda (record) (get record :id)))
                    (js-array (compiler-portable-path directory (get artifact :path))))))
                  (when (build-truth (build-optional-get (get product :descriptor) "project"))
                    (let ((facades (createManagedProjectFacades (get product :descriptor) (js-object :entry (get graph :entry))))
                          (index 0))
                      (put artifact :project (js-object :entry (get facades :entry) :registry (get facades :registry)
                                               :loadEntry (get facades :loadEntry) :files (js-array)))
                      (while (< index (js-length (get facades :files)))
                        (let ((record (aref (get facades :files) index)))
                          (when (js-call reserved :has (get record :id))
                            (throw (new globalThis.TypeError "managed facade collides with a compiler artifact")))
                          (js-call reserved :add (get record :id))
                          (let ((path (await (write-module directory (get record :id) (get record :source)))))
                            (js-call (get (get artifact :project) :files) :push (get record :id))
                            (js-call files :push path)))
                        (setq index (1+ index)))))
                  (when (build-truth (get graph :hostSources))
                    (put artifact :hostSources (js-array))
                    (let ((index 0) (records (get graph :hostSources)))
                      (while (< index (js-length records))
                        (let ((record (aref records index)))
                          (unless (and (= (value-type (build-optional-get record "id")) "string")
                                       (js-call (get record :id) :endsWith ".mjs")
                                       (not (js-call (js-call (get record :id) :split "/") :some
                                         (lambda (part) (or (not (build-truth part)) (= part ".") (= part "..")))))
                                       (not (js-call reserved :has (get record :id)))
                                       (= (value-type (get record :source)) "string"))
                            (throw (new globalThis.TypeError "invalid or colliding host source artifact")))
                          (js-call reserved :add (get record :id))
                          (let ((path (await (write-module directory (get record :id) (get record :source)))))
                            (js-call files :push path)
                            (js-call (get artifact :hostSources) :push (js-object :id (get record :id) :path path))))
                        (setq index (1+ index)))))
                  (js-call files :push (get artifact :runtimePath))
                  (when (build-truth (get graph :literalSources))
                    (put artifact :literalSources (js-array))
                    (let ((records (get graph :literalSources)) (index 0))
                      (while (< index (js-length records))
                        (let ((record (aref records index)))
                          (unless (and (= (value-type (build-optional-get record "id")) "string")
                                       (js-call (new globalThis.RegExp "^(?:stdlib|runtime)/(?:[a-z][a-z0-9-]*/)*[a-z][a-z0-9-]*[.]mjs$") :test (get record :id))
                                       (= (value-type (get record :filename)) "string")
                                       (= (value-type (get record :source)) "string"))
                            (throw (new globalThis.TypeError "invalid persistent literal source")))
                          (let* ((encoded (encodeCompilerSourceAsset (get record :source)))
                                 (asset (+ "literal-sources/" (js-call (get record :id) :slice 0 -4)
                                          (if (= (get encoded :encoding) "utf8") ".eli" ".eli.json"))))
                            (when (js-call reserved :has asset)
                              (throw (new globalThis.TypeError "persistent literal source collides with a compiler artifact")))
                            (js-call reserved :add asset)
                            (let* ((path (resolve directory asset))
                                   (output (js-object :id (get record :id) :filename (get record :filename) :path path)))
                              (await (mkdir (dirname path) (js-object :recursive t)))
                              (await (writeFile path (get encoded :text)))
                              (js-call files :push path)
                              (unless (= (get encoded :encoding) "utf8") (put output :encoding (get encoded :encoding)))
                              (js-call (get artifact :literalSources) :push output))))
                        (setq index (1+ index)))))
                  (unless (undefined? (get product :debug))
                    (put artifact :debugPath (+ (get artifact :path) ".debug.json"))
                    (funcall phase "debug-file-start")
                    (if owned-product (await (write-owned-compiler-metadata (get artifact :debugPath) (get product :debug)))
                      (await (writeCompilerMetadata (get artifact :debugPath) (get product :debug))))
                    (funcall phase "debug-file-complete")
                    (js-call files :push (get artifact :debugPath))
                    (when owned-product (put product :debug undefined)))
                  (when (build-truth retain-ir)
                    (let ((records (Array/from (get product :frontendIR))) (index 0))
                      (unless runtime-checkpoint (js-call records :push (get product :runtimeIR)))
                      (put artifact :frontendIR (js-array))
                      (while (< index (js-length records))
                        (let ((record (aref records index)))
                          (unless (and (= (value-type (build-optional-get record "id")) "string")
                                       (= (value-type (get record :ir)) "string") (= (value-type (get record :canonicalIR)) "string"))
                            (throw (new globalThis.TypeError "compiler omitted its original frontend IR")))
                          (let ((saved (await (compiler-save-ir directory record index false))))
                            (js-call (get artifact :frontendIR) :push saved)
                            (js-call files :push (get saved :path) (get saved :canonicalPath)))
                          (when owned-product
                            (put records index undefined)
                            (if (< index (js-length (get product :frontendIR))) (put (get product :frontendIR) index undefined)
                              (put product :runtimeIR undefined))))
                        (setq index (1+ index))))
                    (when runtime-checkpoint
                      (let ((saved (get runtime-checkpoint :runtime)))
                        (js-call (get artifact :frontendIR) :push saved)
                        (js-call files :push (get saved :path) (get saved :canonicalPath))))
                    (when (Object/hasOwn graph "literalSources")
                      (unless (or runtime-checkpoint
                                  (and (Array/isArray (get product :literalIR))
                                    (= (js-length (get product :literalIR)) (js-length (get graph :literalSources)))))
                        (throw (new globalThis.TypeError "compiler omitted its persistent literal frontend IR")))
                      (put artifact :literalIR (js-array))
                      (if runtime-checkpoint
                        (js-call (get runtime-checkpoint :literals) :forEach (lambda (saved)
                          (js-call (get artifact :literalIR) :push saved)
                          (js-call files :push (get saved :path) (get saved :canonicalPath))))
                      (let ((index 0))
                        (while (< index (js-length (get product :literalIR)))
                          (let ((record (aref (get product :literalIR) index)))
                            (unless (and (= (build-optional-get record "id") (get (aref (get graph :literalSources) index) :id))
                                         (= (value-type (get record :ir)) "string") (= (value-type (get record :canonicalIR)) "string"))
                              (throw (new globalThis.TypeError "compiler changed its persistent literal frontend IR identity")))
                            (let ((saved (await (compiler-save-ir directory record index t))))
                              (js-call (get artifact :literalIR) :push saved)
                              (js-call files :push (get saved :path) (get saved :canonicalPath)))
                            (when owned-product (put (get product :literalIR) index undefined)))
                          (setq index (1+ index)))))))
                  (setq product undefined)
                  (put artifact :artifactIdentity (js-object :algorithm "sha256" :files (js-array)))
                  (funcall phase "file-identities-start")
                  (let ((buffer (new globalThis.Uint8Array 65536)) (index 0))
                    (while (< index (js-length files))
                      (let* ((path (aref files index)) (identity (await (compiler-file-identity path buffer))))
                        (js-call (get (get artifact :artifactIdentity) :files) :push
                          (build-copy-properties (js-object :path (compiler-portable-path directory path)) identity)))
                      (setq index (1+ index))))
                  (funcall phase "file-identities-complete" (js-object :fileCount (js-length (get (get artifact :artifactIdentity) :files))))
                  (funcall phase "product-identity-start")
                  (put artifact :productIdentity (independentCompilerProductIdentity
                    (js-object :host host :nativeTarget native-target :files (get (get artifact :artifactIdentity) :files)
                      :descriptor (get artifact :descriptor) :typed (get artifact :typed))))
                  (funcall phase "product-identity-complete")
                  (let ((metadata-path (resolve directory "compiler-artifact.json")))
                    (put artifact :metadataPath metadata-path)
                    (let ((metadata (compiler-artifact-metadata artifact directory)))
                      (funcall phase "artifact-metadata-start")
                      (if owned-product (await (write-owned-compiler-metadata metadata-path metadata))
                        (await (writeCompilerMetadata metadata-path metadata)))
                      (funcall phase "artifact-metadata-complete")))
                  artifact))))))))

  (export independentCompilerProfiles loadCompilerSources independentCompilerResources
    decodeCompilerBinary compilerMetadataDigest writeCompilerMetadata
    independentCompilerProductIdentity buildIndependentCompiler))
