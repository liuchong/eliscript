(module tools.runtime.unicode-property-ranges
  ;; Maintenance only. The compiler consumes checked-in data without fetching
  ;; Unicode files, compiling a ground function, or invoking a host matcher.
  (import "node:crypto" createHash)
  (import "node:fs" readFileSync writeFileSync existsSync)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)

  (defconst maximum-point 1114111)
  (defconst row-count 519)
  (defconst begin "  ;; BEGIN GENERATED UNICODE PROPERTY RANGES")
  (defconst end "  ;; END GENERATED UNICODE PROPERTY RANGES")
  (defconst data-file "tools/runtime/unicode-property-ranges.json")
  (defconst runtime-file "bootstrap/runtime/memory.eli")
  (defconst license-url "https://www.unicode.org/license.txt")

  (defun hash-text (text)
    (js-call (js-call (createHash "sha256") :update text) :digest "hex"))

  (defun parse-integer (token)
    (if (not (js-call (new globalThis.RegExp "^-?(?:0|[1-9][0-9]*)$") :test token))
      undefined
      (let ((value (funcall globalThis.Number token)))
        (when (or (not (Number/isSafeInteger value)) (< value -4294967296) (> value 4294967295))
          (throw (new globalThis.Error "ground range bound exceeds the supported integer domain")))
        value)))

  ;; This is a parser for the generated decision-tree grammar, not an Eliscript
  ;; evaluator. In particular, even an unreachable unknown call is rejected.
  (defun parse-tree (source)
    (let ((tokens (or (js-call source :match (new globalThis.RegExp "[()]|[^\\s()]+" "g")) (js-array)))
          (index 0))
      (letfn ((read-node (depth)
                (when (or (> depth 128) (>= index (js-length tokens)))
                  (throw (new globalThis.Error "invalid ground range tree")))
                (let ((token (aref tokens index)))
                  (setq index (1+ index))
                  (when (= token ")")
                    (throw (new globalThis.Error "unexpected ground range close")))
                  (if (/= token "(")
                    (let ((parsed (parse-integer token)))
                      (if (undefined? parsed) token parsed))
                    (let ((list (js-array)))
                      (while (and (< index (js-length tokens)) (/= (aref tokens index) ")"))
                        (js-call list :push (read-node (1+ depth))))
                      (let ((close (aref tokens index)))
                        (setq index (1+ index))
                        (unless (= close ")")
                          (throw (new globalThis.Error "unterminated ground range tree")))
                        list))))))
        (let ((tree (read-node 0)))
          (unless (= index (js-length tokens))
            (throw (new globalThis.Error "trailing ground range tree data")))
          tree))))

  (defun tree-ranges (tree)
    (let ((ranges (js-array)))
      (letfn ((visit (node low high)
                (if (or (= node 0) (= node 1))
                  (when (and (= node 1) (<= low high))
                    (let ((previous (aref ranges (1- (js-length ranges)))))
                      (if (and previous (= (1+ (aref previous 1)) low))
                        (put previous 1 high)
                        (js-call ranges :push (js-array low high)))))
                  (progn
                    (unless (and (Array/isArray node) (= (js-length node) 4) (= (aref node 0) "if"))
                      (throw (new globalThis.Error "unsupported ground range expression")))
                    (let ((condition (aref node 1)))
                      (unless (and (Array/isArray condition) (= (js-length condition) 3)
                                   (js-call (js-array "<" "<=") :includes (aref condition 0))
                                   (= (aref condition 1) "point")
                                   (Number/isSafeInteger (aref condition 2)))
                        (throw (new globalThis.Error "unsupported ground range comparison")))
                      (let ((boundary (- (aref condition 2) (if (= (aref condition 0) "<") 1 0))))
                        (visit (aref node 2) low (Math/min high boundary))
                        (visit (aref node 3) (Math/max low (1+ boundary)) high)))))))
        (visit tree 0 maximum-point)
        ranges)))

  ;; Exposed for permanent migration tests, including small mathematical trees.
  ;; Each original function is parsed independently so no whole-runtime AST lives
  ;; alongside the extracted declaration. Hashes describe source provenance only.
  (defun extractRangeRows (source)
    (unless (= (value-type source) "string")
      (throw (new globalThis.TypeError "range source must be a string")))
    (let ((matcher (new globalThis.RegExp "\\(defun heap-regexp-property-ranges-([0-9]+)\\s+\\(point\\)" "g"))
          (rows (js-array))
          (ids (new globalThis.Set))
          (match nil))
      (while (setq match (js-call matcher :exec source))
        (let ((id (funcall globalThis.Number (aref match 1))))
          (when (or (not (Number/isSafeInteger id)) (js-call ids :has id))
            (throw (new globalThis.Error "duplicate or invalid ground range ID")))
          (js-call ids :add id)
          (let ((position (get matcher :lastIndex))
                (depth 1))
            (while (and (< position (js-length source)) (> depth 0))
              (let ((ch (aref source position)))
                (cond
                  ((= ch "(") (setq depth (1+ depth)))
                  ((= ch ")") (setq depth (1- depth)))))
              (setq position (1+ position)))
            (when (> depth 0)
              (throw (new globalThis.Error "unterminated ground range function")))
            (let ((original (js-call source :slice (get match :index) position))
                  (body (js-call source :slice (get matcher :lastIndex) (1- position))))
              (js-call rows :push (js-object
                :id id
                :ranges (tree-ranges (parse-tree body))
                :sourceSha256 (hash-text (js-call original :replace (new globalThis.RegExp "\\s" "g") ""))))
              (put matcher :lastIndex position)))))
      (when (= (js-length rows) 0)
        (throw (new globalThis.Error "no ground range functions found")))
      (js-call rows :sort (lambda (left right) (- (get left :id) (get right :id))))))

  (defun validate-row (row)
    (unless (and row (Number/isInteger (get row :id)) (>= (get row :id) 0) (< (get row :id) row-count)
                 (= (value-type (get row :sourceSha256)) "string")
                 (js-call (new globalThis.RegExp "^[a-f0-9]{64}$") :test (get row :sourceSha256))
                 (Array/isArray (get row :ranges)))
      (throw (new globalThis.Error "invalid Unicode range row identity")))
    (let ((previous -1) (ranges (get row :ranges)) (i 0))
      (while (< i (js-length ranges))
        (let ((range (aref ranges i)))
          (unless (and (Array/isArray range) (= (js-length range) 2))
            (throw (new globalThis.Error "invalid Unicode interval")))
          (let ((low (aref range 0)) (high (aref range 1)))
            (when (or (not (Number/isInteger low)) (not (Number/isInteger high))
                      (<= low previous) (< low 0) (> high maximum-point) (> low high))
              (throw (new globalThis.Error "invalid Unicode interval order or bounds")))
            (setq previous high)))
        (setq i (1+ i)))))

  (defun packRangeRow (row)
    (validate-row row)
    (let ((words (js-array (js-length (get row :ranges))))
          (ranges (get row :ranges))
          (i 0))
      (while (< i (js-length ranges))
        (let ((range (aref ranges i)))
          (js-call words :push (aref range 0) (aref range 1)))
        (setq i (1+ i)))
      words))

  (defun validate-declaration (value)
    (unless (and value (= (get value :format) "eliscript-unicode-property-ranges")
                 (= (get value :version) 1) (= (get value :license) "Unicode-3.0")
                 (= (get value :licenseUrl) license-url)
                 (Array/isArray (get value :rows)) (= (js-length (get value :rows)) row-count))
      (throw (new globalThis.Error "invalid complete Unicode property declaration")))
    (let ((index 0))
      (while (< index row-count)
        (let ((row (aref (get value :rows) index)))
          (validate-row row)
          (unless (= (get row :id) index)
            (throw (new globalThis.Error "missing, duplicate, or unsorted Unicode property row"))))
        (setq index (1+ index)))))

  (defun literal-words (words)
    (str "\"" (js-call (js-call words :map (lambda (word)
                (str "\\u" (js-call (js-call (bit-and word 65535) :toString 16) :padStart 4 "0")
                     "\\u" (js-call (js-call (unsigned-bit-shift-right word 16) :toString 16) :padStart 4 "0"))))
                :join "") "\""))

  (defun generate-ranges (declaration)
    (validate-declaration declaration)
    (let ((maximum-bytes (Reflect/apply (get globalThis.Math :max) globalThis.Math
                           (js-call (get declaration :rows) :map
                             (lambda (row) (* (1+ (* (js-length (get row :ranges)) 2)) 4)))))
          (source nil))
      (setq source (str begin "\n"
        "  ;; Unicode 15.1 / 16.0 / 17.0 property rows; Unicode-3.0: " license-url "\n"
        "  ;; Reproduce offline with tools/runtime/unicode-property-ranges.mjs --write.\n"
        "  ;; Each literal is little-endian u32 [count, inclusiveLow, inclusiveHigh, ...].\n"
        "  ;; Word 44 owns one instance-private raw buffer; word 48 is cached row ID+1.\n"
        "  ;; The buffer holds no heap handles and survives retire, like code constants.\n"
        "  ;; It is never reclaimed/reused by heap GC and allocates only once, not per row.\n"
        "  (defun heap-regexp-property-range-table ()\n"
        "    (initialize)\n"
        "    (let ((table (load-u32 44)))\n"
        "      (when (= table 0)\n"
        "        (setq table (allocate " maximum-bytes "))\n"
        "        (when (/= table 0) (store-u32 44 table))) table))\n"
        "  (defun heap-regexp-property-range-find (table point)\n"
        "    (let ((low 0) (high (load-u32 table)) (found 0))\n"
        "      (while (< low high)\n"
        "        (let* ((middle (word-div (+ low high) 2)) (entry (+ table (+ 4 (* middle 8)))))\n"
        "          (if (< point (load-u32 entry)) (setq high middle)\n"
        "            (if (> point (load-u32 (+ entry 4))) (setq low (1+ middle))\n"
        "              (progn (setq found 1) (setq low high)))))) found))\n"))
      (js-call (get declaration :rows) :forEach (lambda (row)
        (let ((words (packRangeRow row)))
          (setq source (str source
            "  ;; Original range " (get row :id) " normalized-source SHA-256 " (get row :sourceSha256) "\n"
            "  (defun heap-regexp-property-ranges-" (get row :id) " (point)\n"
            "    (if (> point 1114111) 0\n"
            "      (let ((table (heap-regexp-property-range-table)))\n"
            "        (if (= table 0) 0\n"
            "          (progn\n"
            "            (when (/= (load-u32 48) " (1+ (get row :id)) ")\n"
            "              (copy-static-u16 table " (literal-words words) ")\n"
            "              (store-u32 48 " (1+ (get row :id)) "))\n"
            "            (heap-regexp-property-range-find table point))))))\n")))))
      (js-object :source (str source end) :maximumBytes maximum-bytes)))

  (defun replace-region (source generated extracting)
    (let ((first (js-call source :indexOf begin))
          (last (js-call source :indexOf end)))
      (if (or (>= first 0) (>= last 0))
        (progn
          (when (or (< first 0) (< last first)
                    (>= (js-call source :indexOf begin (+ first (js-length begin))) 0)
                    (>= (js-call source :indexOf end (+ last (js-length end))) 0))
            (throw (new globalThis.Error "invalid generated Unicode range region")))
          (str (js-call source :slice 0 first) generated (js-call source :slice (+ last (js-length end)))))
        (progn
          (unless extracting
            (throw (new globalThis.Error "missing generated Unicode range region")))
          (let* ((match (js-call (new globalThis.RegExp "^  \\(defun heap-regexp-property-ranges-0 \\(point\\)" "m") :exec source))
                 (match-idx (if match (get match :index) 0)))
            (setq last (js-call source :indexOf "  (defun heap-regexp-property-contains-151 " match-idx))
            (when (or (not match) (< last match-idx))
              (throw (new globalThis.Error "missing ground Unicode range region")))
            (setq first match-idx)
            (let ((region (js-call source :slice first last)))
              (unless (= (js-length (js-call (js-call region :split "\n")
                           :filter (lambda (line) (> (js-length (js-call line :trim)) 0))))
                         row-count)
                (throw (new globalThis.Error "unexpected code between ground Unicode range functions")))
              (str (js-call source :slice 0 first) generated "\n" (js-call source :slice last))))))))

  (defun main (args)
    (let ((root (fileURLToPath (new globalThis.URL "../../" (get (js* "import.meta") :url))))
          (mode undefined)
          (extracting false)
          (index 0))
      (while (< index (js-length args))
        (let ((arg (aref args index)))
          (cond
            ((and (= arg "--root") (aref args (1+ index)))
             (setq index (1+ index))
             (setq root (resolve (aref args index))))
            ((= arg "--extract")
             (setq extracting t))
            ((or (= arg "--write") (= arg "--check"))
             (when mode (throw (new globalThis.Error "choose exactly one generation mode")))
             (setq mode arg))
            (t (throw (new globalThis.Error "unknown or incomplete Unicode range option")))))
        (setq index (1+ index)))
      (when (or (not mode) (and extracting (/= mode "--write")))
        (throw (new globalThis.Error "require --write or --check; extraction requires --write")))
      (let* ((filename (resolve root runtime-file))
             (declaration-path (resolve root data-file))
             (source (readFileSync filename "utf8"))
             (declaration nil))
        (if extracting
          (progn
            (when (existsSync declaration-path)
              (throw (new globalThis.Error "range declaration exists; refusing to replace its provenance")))
            (setq declaration (js-object
              :format "eliscript-unicode-property-ranges"
              :version 1
              :license "Unicode-3.0"
              :licenseUrl license-url
              :rows (extractRangeRows source))))
          (setq declaration (JSON/parse (readFileSync declaration-path "utf8"))))
        (let* ((generated (generate-ranges declaration))
               (next (replace-region source (get generated :source) extracting)))
          (if (= mode "--write")
            (progn
              (when extracting
                (writeFileSync declaration-path (str (JSON/stringify declaration nil 2) "\n") (js-object :flag "wx")))
              (writeFileSync filename next))
            (when (/= next source)
              (throw (new globalThis.Error "generated Unicode property ranges differ"))))
          (js-call globalThis.console :log (JSON/stringify (js-object
            :rows (js-length (get declaration :rows))
            :maximumRowBytes (get generated :maximumBytes)
            :generatedBytes (js-call globalThis.Buffer :byteLength (get generated :source)))))))))

  (when (and (aref (get globalThis.process :argv) 1)
             (= (resolve (aref (get globalThis.process :argv) 1))
                (fileURLToPath (get (js* "import.meta") :url))))
    (main (js-call (get globalThis.process :argv) :slice 2)))

  (export extractRangeRows packRangeRow))
