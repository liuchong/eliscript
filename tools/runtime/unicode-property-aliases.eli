      (when (or (> (js-length stack) 0) (not result)) (invalid "unbalanced form")) result))
  (defun definitions (source root-name)
    (let ((result (new globalThis.Map))
          (matches (Array/from (js-call source :matchAll (new globalThis.RegExp "\\(defun ([A-Za-z][A-Za-z0-9-]*) " "g")))))
      (js-call matches :forEach (lambda (match)
        (let ((name (aref match 1)))
          (when (or (= name root-name)
            (js-call (new globalThis.RegExp (str "^" root-name "-part-\\d{4}$")) :test name))
            (let ((depth 0) (end (get match :index)) (first t))
              (while (or first (and (< end (js-length source)) (/= depth 0)))
                (setq first false)
                (let ((character (aref source end)))
                  (setq end (1+ end))
                  (cond ((= character "(") (setq depth (1+ depth))) ((= character ")") (setq depth (1- depth))))))
              (when (or (/= depth 0) (js-call result :has name)) (invalid "duplicate/unclosed function"))
              (let ((tree (parse-tree (js-call source :slice (get match :index) end))))
                (unless (and (= (js-length tree) 4) (= (aref tree 0) "defun") (= (aref tree 1) name)) (invalid "function schema"))
                (js-call result :set name tree)))))))
      (unless (js-call result :has root-name) (invalid "missing root")) result))
  (defun restrict-state (state field operation number yes)
    (let ((next (Object/assign (js-object) state (js-object
      :units (new globalThis.Map (get state :units)) :excludedLengths (new globalThis.Set (get state :excludedLengths))))) (valid t))
      (if (= field "length")
        (progn
          (unless (= operation "=") (invalid "length comparator"))
          (if yes
            (progn
              (when (or (and (not (eq (get next :length) nil)) (/= (get next :length) number))
                (js-call (get next :excludedLengths) :has number)) (setq valid false))
              (put next :length number))
            (progn
              (when (= (get next :length) number) (setq valid false))
              (js-call (get next :excludedLengths) :add number))))
        (progn
          (unless (and (= field "unit") (Number/isInteger (get state :unit))) (invalid "unit comparator"))
          (let* ((old (or (js-call (get state :units) :get (get state :unit)) (js-object :low 0 :high 65535 :except (js-array))))
                 (domain (Object/assign (js-object) old (js-object :except (js-call (get old :except) :slice)))))
            (cond
              ((= operation "<") (if yes (put domain :high (Math/min (get domain :high) (1- number)))
                (put domain :low (Math/max (get domain :low) number))))
              ((= operation "=") (if yes
                (progn (put domain :low (Math/max (get domain :low) number)) (put domain :high (Math/min (get domain :high) number)))
                (js-call (get domain :except) :push number)))
              (t (invalid "unit comparator")))
            (when (or (> (get domain :low) (get domain :high))
              (and (= (get domain :low) (get domain :high)) (js-call (get domain :except) :includes (get domain :low)))) (setq valid false))
            (js-call (get next :units) :set (get state :unit) domain)))) (if valid next nil)))
  (defun extractLegacyPropertyAliases (source &rest supplied)
    (let* ((root-name (if (undefined? (aref supplied 0)) "regexp-property-id-base" (aref supplied 0)))
           (runtime (globalThis.Boolean (if (undefined? (aref supplied 1)) false (aref supplied 1))))
           (funcs (definitions source root-name)) (aliases (new globalThis.Map))
           (params (if runtime (js-array "heap" "source" "start" "length") (js-array "source" "start" "length")))
           (unit-reader (if runtime "heap-regexp-unit" "string-code-unit-at")))
      (letfn ((visit (value state active)
        (cond
          ((not state) undefined)
          ((Number/isInteger value)
            (unless (= value 0)
              (when (or (< value 1) (> value 65535)) (invalid "property ID"))
              (when (= (get (get state :units) :size) 0) (invalid "empty alias path"))
              (let* ((count (1+ (Reflect/apply (get globalThis.Math :max) globalThis.Math (Array/from (js-call (get state :units) :keys)))))
                     (characters (js-array)) (index 0))
                (while (< index count)
                  (let ((domain (js-call (get state :units) :get index)))
                    (when (or (not domain) (/= (get domain :low) (get domain :high))
                      (js-call (get domain :except) :includes (get domain :low)) (> (get domain :low) 127)) (invalid "nonliteral alias path"))
                    (js-call characters :push (get domain :low)))
                  (setq index (1+ index)))
                (when (or (= count 0) (and (not (eq (get state :length) nil)) (/= (get state :length) count))
                  (js-call (get state :excludedLengths) :has count)) (invalid "terminal length"))
                (let* ((entry (js-array (Reflect/apply (get globalThis.String :fromCharCode) globalThis.String characters)
                               value (if (eq (get state :length) nil) 0 1)))
                       (previous (js-call aliases :get (aref entry 0))))
                  (when (and previous (/= (JSON/stringify previous) (JSON/stringify entry))) (invalid "conflicting alias"))
                  (js-call aliases :set (aref entry 0) entry)))))
          ((not (Array/isArray value)) (invalid "non-numeric leaf"))
          ((and (= (aref value 0) "if") (= (js-length value) 4))
            (let ((condition (aref value 1)))
              (unless (and (Array/isArray condition) (= (js-length condition) 3) (Number/isInteger (aref condition 2))) (invalid "condition"))
              (visit (aref value 2) (restrict-state state (aref condition 1) (aref condition 0) (aref condition 2) t) active)
              (visit (aref value 3) (restrict-state state (aref condition 1) (aref condition 0) (aref condition 2) false) active)))
          ((and (= (aref value 0) "let") (= (js-length value) 3) (= (js-length (aref value 1)) 1))
            (let* ((binding (aref (aref value 1) 0)) (read (unless (nullish? binding) (aref binding 1)))
                   (expected (if runtime (js-array "heap" "source") (js-array "source"))))
              (unless (and (Array/isArray binding) (= (js-length binding) 2) (= (aref binding 0) "unit") (Array/isArray read)
                (= (aref read 0) unit-reader) (= (JSON/stringify (js-call read :slice 1 -1)) (JSON/stringify expected))) (invalid "unit binding"))
              (let ((offset (js-call read :at -1)))
                (unless (and (Array/isArray offset) (= (js-length offset) 3) (= (aref offset 0) "+") (= (aref offset 1) "start")
                  (Number/isInteger (aref offset 2)) (>= (aref offset 2) 0) (<= (aref offset 2) 65535)) (invalid "unit offset"))
                (visit (aref value 2) (Object/assign (js-object) state (js-object :unit (aref offset 2))) active))))
          (t
            (let* ((name (aref value 0)) (fn (js-call funcs :get name)))
              (unless (and fn (/= name root-name) (not (js-call active :has name))
                (= (JSON/stringify (js-call value :slice 1)) (JSON/stringify (aref fn 2)))
                (= (JSON/stringify (aref fn 2)) (JSON/stringify (js-call params :concat (js-array "unit"))))) (invalid "private call"))
              (visit (aref fn 3) state (new globalThis.Set (js-call (Array/from active) :concat (js-array name))))))))
        (inline-tree (value)
          (if (not (Array/isArray value)) value
            (if (and (= (value-type (aref value 0)) "string") (js-call (aref value 0) :startsWith (str root-name "-part-")))
              (inline-tree (aref (js-call funcs :get (aref value 0)) 3)) (js-call value :map inline-tree)))))
        (unless (= (JSON/stringify (aref (js-call funcs :get root-name) 2)) (JSON/stringify params)) (invalid "root parameters"))
        (visit (aref (js-call funcs :get root-name) 3)
          (js-object :units (new globalThis.Map) :excludedLengths (new globalThis.Set) :length nil :unit nil) (new globalThis.Set (js-array root-name)))
        (js-object :records (js-call (Array/from (js-call aliases :values)) :sort
          (lambda (a b) (cond ((< (aref a 0) (aref b 0)) -1) ((> (aref a 0) (aref b 0)) 1) (t 0))))
          :sourceSHA256 (digest (normalize (print-tree (inline-tree (js-call funcs :get root-name)))))))))
  (defun compileLegacyPropertyAliasDecisions (source)
    (let* ((root-name "regexp-property-id-base") (funcs (definitions source root-name))
           (provenance (extractLegacyPropertyAliases source)) (nodes (js-array)) (seen (new globalThis.Map)))
      (letfn ((compile-node (value)
        (cond
          ((js-call seen :has value) (js-call seen :get value))
          ((and (Array/isArray value) (= (value-type (aref value 0)) "string")
            (js-call (aref value 0) :startsWith (str root-name "-part-")))
            (compile-node (aref (js-call funcs :get (aref value 0)) 3)))
          (t
            (let ((index (js-length nodes)))
              (js-call nodes :push nil) (js-call seen :set value index)
              (cond
                ((Number/isInteger value) (put nodes index (js-array 0 value 0 0)))
                ((= (aref value 0) "let") (put nodes index (js-array 4
                  (aref (aref (aref (aref (aref value 1) 0) 1) 2) 2) (compile-node (aref value 2)) 0)))
                (t (let* ((condition (aref value 1)) (operation (aref condition 0)) (field (aref condition 1)) (number (aref condition 2))
                          (kind (if (= field "length") 3 (if (= operation "<") 1 2))))
                  (put nodes index (js-array kind number (compile-node (aref value 2)) (compile-node (aref value 3))))))) index)))))
        (js-object :root (compile-node (aref (js-call funcs :get root-name) 3)) :nodes nodes :sourceSHA256 (get provenance :sourceSHA256)))))
  (defun validate-declaration (data)
    (unless (and (not (nullish? data)) (= (get data :format) "eliscript-unicode-property-aliases")
      (= (get data :version) 1) (= (get data :license) "Unicode-3.0")
      (= (JSON/stringify (get data :unicodeVersions)) (JSON/stringify (js-array "15.1.0" "16.0.0" "17.0.0")))
      (js-call (new globalThis.RegExp "^[a-f0-9]{64}$") :test (get data :sourceSHA256 ""))
      (js-call (new globalThis.RegExp "^[a-f0-9]{64}$") :test (get data :runtimeSourceSHA256 ""))
      (Array/isArray (get data :records)) (> (js-length (get data :records)) 0))
      (throw (new globalThis.TypeError "invalid Unicode property alias declaration"))))
  (defun u16-literal (units)
    (str "\"" (js-call (js-call units :map (lambda (unit) (str "\\u" (js-call (js-call unit :toString 16) :padStart 4 "0")))) :join "") "\""))
  (defun packPropertyAliases (data)
    (validate-declaration data)
    (let ((units (js-call (new globalThis.Array (* (js-length (get data :records)) 4)) :fill 0)) (previous ""))
      (js-call (get data :records) :forEach (lambda (row index)
        (unless (and (Array/isArray row) (= (js-length row) 3) (= (value-type (aref row 0)) "string")
          (js-call (new globalThis.RegExp "^[A-Za-z0-9_=]+$") :test (aref row 0)) (> (aref row 0) previous)
          (<= (js-length (aref row 0)) 65535) (Number/isInteger (aref row 1)) (>= (aref row 1) 1) (<= (aref row 1) 65535)
          (or (= (aref row 2) 0) (= (aref row 2) 1))) (throw (new globalThis.TypeError "invalid Unicode property alias record")))
        (setq previous (aref row 0))
        (let ((offset (js-length units)))
          (put units (* index 4) (bit-and offset 65535)) (put units (1+ (* index 4)) (unsigned-bit-shift-right offset 16))
          (put units (+ (* index 4) 2) (aref row 1)) (put units (+ (* index 4) 3) (aref row 2))
          (js-call units :push (js-length (aref row 0)))
          (js-call (Array/from (aref row 0)) :forEach
            (lambda (character)
              (js-call units :push (js-call character :charCodeAt 0)))))))
      (when (> (js-length units) 2147483647) (throw (new globalThis.TypeError "Unicode property alias dictionary is too large")))
      (js-object :count (js-length (get data :records)) :byteLength (* (js-length units) 2) :units units :literal (u16-literal units))))
  (defconst static-begin "  ;; BEGIN GENERATED UNICODE PROPERTY ALIASES")
  (defconst static-end "  ;; END GENERATED UNICODE PROPERTY ALIASES")
  (defun legacy-template (archive name)
    (let* ((marker (str "const " name " = staticBegin + notice + `"))
           (begin (js-call archive :indexOf marker)) (start (+ begin (js-length marker)))
           (end (js-call archive :indexOf "` + staticEnd;" start)))
      (unless (and (>= begin 0) (> end start) (= (js-call archive :indexOf marker (1+ begin)) -1))
        (throw (new globalThis.TypeError "authenticated Unicode alias template boundary changed")))
      (js-call archive :slice start end)))
  (defun generatePropertyAliasSources (data)
    (let* ((packed (packPropertyAliases data)) (legacy (get data :legacyDecisions)))
      (unless (and legacy (= (get legacy :sourceSHA256) (get data :sourceSHA256))
        (Array/isArray (get legacy :nodes)) (> (js-length (get legacy :nodes)) 0) (Number/isInteger (get legacy :root))
        (>= (get legacy :root) 0) (< (get legacy :root) (js-length (get legacy :nodes))))
        (throw (new globalThis.TypeError "invalid Unicode property legacy decisions")))
      (js-call (get legacy :nodes) :forEach (lambda (node)
        (unless (and (Array/isArray node) (= (js-length node) 4)
          (not (js-call node :some (lambda (value) (or (not (Number/isInteger value)) (< value 0) (> value 4294967295)))))
          (<= (aref node 0) 4)
          (or (= (aref node 0) 0) (and (< (aref node 2) (js-length (get legacy :nodes)))
            (or (= (aref node 0) 4) (< (aref node 3) (js-length (get legacy :nodes)))))))
          (throw (new globalThis.TypeError "invalid Unicode property legacy decision node")))))
      (let ((active (new globalThis.Set)) (visited (new globalThis.Set)) (pending (js-array (js-array (get legacy :root) false))))
        (while (> (js-length pending) 0)
          (let* ((item (js-call pending :pop)) (index (aref item 0)) (done (aref item 1)))
            (if done (progn (js-call active :delete index) (js-call visited :add index))
              (progn
                (when (js-call active :has index) (throw (new globalThis.TypeError "cyclic Unicode property legacy decisions")))
                (unless (js-call visited :has index)
                  (js-call active :add index) (js-call pending :push (js-array index t))
                  (let ((node (aref (get legacy :nodes) index)))
                    (unless (= (aref node 0) 0)
                      (unless (= (aref node 0) 4) (js-call pending :push (js-array (aref node 3) false)))
                      (js-call pending :push (js-array (aref node 2) false))))))))))
      (let* ((archive (readFileSync (resolve root "tools/runtime/unicode-property-aliases-legacy.mjs") "utf8"))
             (legacy-literal (u16-literal (js-call (get legacy :nodes) :flatMap (lambda (node)
               (js-call node :flatMap (lambda (value) (js-array (bit-and value 65535) (unsigned-bit-shift-right value 16))))))))
             (notice (str "\n  ;; Unicode 15.1 / 16.0 / 17.0, Unicode-3.0: https://www.unicode.org/license.txt\n"
               "  ;; Reproduce with tools/runtime/unicode-property-aliases.mjs --write.\n"
               "  ;; Original normalized trie SHA-256 " (get data :sourceSHA256) "\n"
               "  ;; Original runtime trie SHA-256 " (get data :runtimeSourceSHA256) "\n"
               "  ;; Directory: u32 unit offset, u16 original ID, u16 exact-terminal flag.\n")))
        (unless (= (digest archive) "41b22843329ec13e6377f6ce457e7d695288cdfedc690a636584bd5e40105309") (throw (new globalThis.TypeError "Unicode alias data archive identity changed")))
        (let ((static (legacy-template archive "staticSource")) (runtime (legacy-template archive "runtimeSource")))
          (setq static (js-call static :replace "(js* \"typeof source\")" "(value-type source)"))
          (js-call (js-array (js-array "${packed.literal}" (get packed :literal)) (js-array "${legacyLiteral}" legacy-literal)
            (js-array "${legacy.root}" (globalThis.String (get legacy :root))) (js-array "${packed.count}" (globalThis.String (get packed :count)))
            (js-array "${packed.byteLength}" (globalThis.String (get packed :byteLength)))) :forEach (lambda (replacement)
              (setq static (js-call (js-call static :split (aref replacement 0)) :join (aref replacement 1)))
              (setq runtime (js-call (js-call runtime :split (aref replacement 0)) :join (aref replacement 1)))))
          (js-object :staticSource (str static-begin notice static static-end) :runtimeSource (str static-begin notice runtime static-end))))))
  (defun replace-source (source generated runtime)
    (let ((begin (js-call source :indexOf static-begin)) (end (js-call source :indexOf static-end (js-call source :indexOf static-begin))))
      (if (and (>= begin 0) (>= end begin))
        (str (js-call source :slice 0 begin) generated (js-call source :slice (+ end (js-length static-end))))
        (let* ((expression (new globalThis.RegExp (if runtime "^  \\(defun heap-regexp-property-id-base .*$"
                            "^  \\(defun regexp-property-id-base(?:-part-\\d{4})? .*$") "gm"))
               (count 0) (result (js-call source :replace expression (lambda ()
                 (let ((previous count)) (setq count (1+ count)) (if (= previous 0) generated ""))))))
          (setq result (js-call result :replace "  ;; Exact private trie partitions retain all branches and lexical unit values.\n" ""))
          (unless (= count (if runtime 1 69)) (throw (new globalThis.Error "unexpected original property alias definition inventory"))) result))))
  (defun main (args)
    (let* ((root-at (js-call args :indexOf "--root")) (selected-root (if (< root-at 0) root (resolve (aref args (1+ root-at)))))
           (modes (js-call args :filter (lambda (arg) (js-call (js-array "--import-legacy" "--import-compatibility" "--write" "--check") :includes arg)))))
      (unless (and (= (js-length modes) 1) (not (js-call args :some (lambda (arg at)
        (and (not (js-call modes :includes arg)) (/= arg "--root") (or (< root-at 0) (/= at (1+ root-at))))))))
        (throw (new globalThis.TypeError "usage: unicode-property-aliases.mjs [--root DIR] --import-legacy|--import-compatibility|--write|--check")))
      (let* ((paths (js-array (resolve selected-root "bootstrap/backends/regexp.eli") (resolve selected-root "bootstrap/runtime/memory.eli")))
             (declaration (resolve selected-root "tools/runtime/unicode-property-aliases.json"))
             (sources (js-call paths :map (lambda (path) (readFileSync path "utf8")))) (data undefined))
        (if (= (aref modes 0) "--import-legacy")
          (let ((original (extractLegacyPropertyAliases (aref sources 0)))
                (runtime (extractLegacyPropertyAliases (aref sources 1) "heap-regexp-property-id-base" t)))
            (unless (= (JSON/stringify (get original :records)) (JSON/stringify (get runtime :records)))
              (throw (new globalThis.Error "static and dynamic Unicode alias dictionaries disagree")))
            (setq data (js-object :format "eliscript-unicode-property-aliases" :version 1 :license "Unicode-3.0"
              :unicodeVersions (js-array "15.1.0" "16.0.0" "17.0.0") :sourceSHA256 (get original :sourceSHA256)
              :runtimeSourceSHA256 (get runtime :sourceSHA256) :records (get original :records)
              :legacyDecisions (compileLegacyPropertyAliasDecisions (aref sources 0))))
            (writeFileSync declaration (str (JSON/stringify data nil 2) "\n")))
          (progn
            (setq data (JSON/parse (readFileSync declaration "utf8")))
            (when (= (aref modes 0) "--import-compatibility")
              (put data :legacyDecisions (compileLegacyPropertyAliasDecisions
                (readFileSync (resolve selected-root "tests/fixtures/regexp-property-original-trie.eli") "utf8")))
              (unless (= (get (get data :legacyDecisions) :sourceSHA256) (get data :sourceSHA256))
                (throw (new globalThis.Error "legacy compatibility source identity mismatch")))
              (writeFileSync declaration (str (JSON/stringify data nil 2) "\n")))))
        (let* ((generated (generatePropertyAliasSources data)) (outputs (js-array (get generated :staticSource) (get generated :runtimeSource))))
          (js-call paths :forEach (lambda (path index)
            (let ((output (replace-source (aref sources index) (aref outputs index) (= index 1))))
              (if (= (aref modes 0) "--check")
                (unless (= (aref sources index) output) (throw (new globalThis.Error (str "Unicode property aliases need regeneration: " path))))
                (writeFileSync path output)))))
          (let ((packed (packPropertyAliases data)))
            (js-call (get globalThis.process :stdout) :write (str (JSON/stringify
              (js-object :aliases (get packed :count) :byteLength (get packed :byteLength) :sourceSHA256 (get data :sourceSHA256))) "\n")))))))
  (when (and (aref (get globalThis.process :argv) 1)
    (= (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath (get (js* "import.meta") :url))))
    (main (js-call (get globalThis.process :argv) :slice 2)))
  (export extractLegacyPropertyAliases compileLegacyPropertyAliasDecisions packPropertyAliases generatePropertyAliasSources))
