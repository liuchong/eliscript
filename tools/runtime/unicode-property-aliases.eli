  (defun invalid (message) (throw (new globalThis.Error (str "invalid legacy property alias tree: " message))))
  (defun parse-tree (text)
    (let ((stack (js-array)) (result undefined)
          (tokens (or (js-call text :match (new globalThis.RegExp "\\(|\\)|[^\\s()]+" "g")) (js-array))))
      (js-call tokens :forEach (lambda (token)
        (cond
          ((= token "(")
            (let ((list (js-array)))
              (when (> (js-length stack) 0) (js-call (js-call stack :at -1) :push list))
              (js-call stack :push list)))
          ((= token ")")
            (when (= (js-length stack) 0) (invalid "unbalanced close"))
            (let ((value (js-call stack :pop)))
              (when (= (js-length stack) 0)
                (when result (invalid "multiple forms")) (setq result value))))
          (t
            (unless (and (> (js-length stack) 0)
              (js-call (new globalThis.RegExp "^(?:[A-Za-z][A-Za-z0-9-]*|\\d+|[+=<])$") :test token))
              (invalid (str "token " token)))
