  (defun digest (text) (js-call (js-call (createHash "sha256") :update text) :digest "hex"))
  (defun normalize (text) (js-call (js-call text :replace (new globalThis.RegExp "\\s+" "g") " ") :trim))
  (defun print-tree (value)
