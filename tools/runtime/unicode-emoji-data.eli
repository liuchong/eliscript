(module tools.runtime.unicode-emoji-data
  ;; Maintenance only. Runtime compilation consumes checked-in packed data and
  ;; never fetches Unicode files or delegates matching to a host RegExp engine.
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile writeFile)
  (import "node:url" fileURLToPath)

  (defconst properties (js-array
    "Basic_Emoji" "Emoji_Keycap_Sequence" "RGI_Emoji_Modifier_Sequence"
    "RGI_Emoji_Flag_Sequence" "RGI_Emoji_Tag_Sequence" "RGI_Emoji_ZWJ_Sequence" "RGI_Emoji"))
  (defconst versions (js-array (js-array "15.1" 151) (js-array "16.0" 160) (js-array "17.0" 170)))
  (defconst begin "  ;; BEGIN GENERATED UNICODE EMOJI DATA")
  (defconst end "  ;; END GENERATED UNICODE EMOJI DATA")

  (defun compare-sequences (a b)
    (let ((limit (Math/min (js-length a) (js-length b))) (i 0) (diff 0))
      (while (and (= diff 0) (< i limit))
        (when (/= (aref a i) (aref b i))
          (setq diff (- (aref a i) (aref b i))))
        (setq i (1+ i)))
      (if (/= diff 0) diff (- (js-length a) (js-length b)))))

  (defasync main ()
    (let* ((argv (get globalThis.process :argv))
           (write (js-call argv :includes "--write"))
           (initialize (js-call argv :includes "--initialize-pins")))
      (when (and (not write) (not (js-call argv :includes "--check")))
        (throw (new globalThis.Error "require --write or --check")))
      (when (and initialize (not write))
        (throw (new globalThis.Error "initializing input pins requires --write")))
      (let* ((base-url (get (js* "import.meta") :url))
             (manifest-path (fileURLToPath (new globalThis.URL "./unicode-emoji-inputs.json" base-url)))
             (manifest undefined))
        (try
          (progn
            (setq manifest (JSON/parse (await (readFile manifest-path "utf8"))))
            (when initialize
              (throw (new globalThis.Error "Unicode input pins already exist; refusing to replace them"))))
          (catch error
            (if (or (not initialize) (/= (get error :code) "ENOENT"))
              (throw error)
              (setq manifest (js-object :license "https://www.unicode.org/license.txt" :inputs (js-object))))))
        (let ((generated (str begin "\n  ;; Unicode 15.1 / 16.0 / 17.0; Unicode-3.0: https://www.unicode.org/license.txt\n"
                          "  ;; Reproduce with tools/runtime/unicode-emoji-data.mjs --write.\n"
                          "  ;; Directory: seven [count, indexByteOffset] pairs, followed by sorted\n"
                          "  ;; offset indexes and shared [codePointCount, codePoints...] records.\n"))
              (sizes (js-array))
              (v-idx 0))
          (while (< v-idx (js-length versions))
            (let* ((v-entry (aref versions v-idx))
                   (version (aref v-entry 0))
                   (id (aref v-entry 1))
                   (sets (new globalThis.Map (js-call properties :map (lambda (name) (js-array name (new globalThis.Map))))))
                   (add (lambda (name points)
                     (when (or (= (js-length points) 0) (> (js-length points) 32)
                               (js-call points :some (lambda (p) (or (not (Number/isInteger p)) (< p 0) (> p 1114111)))))
                       (throw (new globalThis.Error "invalid Unicode emoji sequence")))
                     (js-call (js-call sets :get name) :set (js-call points :join ",") points)))
                   (filenames (js-array "emoji-sequences.txt" "emoji-zwj-sequences.txt"))
                   (f-idx 0))
              (while (< f-idx (js-length filenames))
                (let* ((filename (aref filenames f-idx))
                       (url (if (= version "17.0")
                              (str "https://www.unicode.org/Public/17.0.0/emoji/" filename)
                              (str "https://www.unicode.org/Public/emoji/" version "/" filename)))
                       (response (await (funcall globalThis.fetch url
                                   (js-object :signal (js-call globalThis.AbortSignal :timeout 30000))))))
                  (unless (get response :ok)
                    (throw (new globalThis.Error (str url ": " (get response :status)))))
                  (let* ((buffer (await (js-call response :arrayBuffer)))
                         (_ (when (> (get buffer :byteLength) 2097152)
                              (throw (new globalThis.Error "Unicode input exceeds maintenance bound"))))
                         (bytes (new globalThis.Uint8Array buffer))
                         (sha256 (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
                         (key (str version "/" filename))
                         (pinned (get (get manifest :inputs) key)))
                    (if initialize
                      (put (get manifest :inputs) key (js-object :url url :sha256 sha256))
                      (when (or (not pinned) (/= (get pinned :url) url) (/= (get pinned :sha256) sha256))
                        (throw (new globalThis.Error (str key ": unexpected Unicode data identity")))))
                    (setq generated (str generated "  ;; " key " SHA-256 " sha256 "\n"))
                    (js-call (js-call (js-call (new globalThis.TextDecoder) :decode bytes) :split "\n") :forEach
                      (lambda (line)
                        (let* ((parts (js-call (js-call (aref (js-call line :split "#" 1) 0) :split ";")
                                        :map (lambda (s) (js-call s :trim))))
                               (field (aref parts 0))
                               (property (aref parts 1)))
                          (when (> (js-length (or field "")) 0)
                            (when (or (not (js-call sets :has property)) (= property "RGI_Emoji"))
                              (throw (new globalThis.Error (str "unexpected emoji property: " property))))
                            (if (js-call field :includes "..")
                              (let* ((bounds (js-call (js-call field :split "..") :map (lambda (s) (Number/parseInt s 16))))
                                     (lo (aref bounds 0))
                                     (hi (aref bounds 1))
                                     (p lo))
                                (when (or (> lo hi) (> (- hi lo) 4096))
                                  (throw (new globalThis.Error "invalid emoji range")))
                                (while (<= p hi)
                                  (funcall add property (js-array p))
                                  (setq p (1+ p))))
                              (funcall add property
                                (js-call (js-call field :split (new globalThis.RegExp "\\s+"))
                                  :map (lambda (s) (Number/parseInt s 16)))))))))))
                (setq f-idx (1+ f-idx)))
              (js-call (js-call properties :slice 0 -1) :forEach (lambda (property)
                (let ((prop-map (js-call sets :get property)))
                  (when (= (get prop-map :size) 0)
                    (throw (new globalThis.Error (str "missing " property " in Unicode " version))))
                  (js-call (Array/from (js-call prop-map :values)) :forEach (lambda (points)
                    (funcall add "RGI_Emoji" points))))))
              (let* ((all (js-call (Array/from (js-call (js-call sets :get "RGI_Emoji") :values)) :sort compare-sequences))
                     (words (js-call (new globalThis.Array (* (js-length properties) 2)) :fill 0))
                     (lists (js-call properties :map (lambda (property)
                              (js-call (Array/from (js-call (js-call sets :get property) :values)) :sort compare-sequences))))
                     (offsets (new globalThis.Map))
                     (i 0))
                (while (< i (js-length lists))
                  (let ((list (aref lists i)) (j 0))
                    (put words (* i 2) (js-length list))
                    (put words (1+ (* i 2)) (* (js-length words) 4))
                    (while (< j (js-length list))
                      (js-call words :push 0)
                      (setq j (1+ j))))
                  (setq i (1+ i)))
                (js-call all :forEach (lambda (points)
                  (js-call offsets :set (js-call points :join ",") (* (js-length words) 4))
                  (js-call words :push (js-length points))
                  (js-call points :forEach (lambda (pt) (js-call words :push pt)))))
                (setq i 0)
                (while (< i (js-length lists))
                  (let ((list (aref lists i))
                        (at (/ (aref words (1+ (* i 2))) 4))
                        (j 0))
                    (while (< j (js-length list))
                      (put words (+ at j) (js-call offsets :get (js-call (aref list j) :join ",")))
                      (setq j (1+ j))))
                  (setq i (1+ i)))
                (let ((literal (str "\"" (js-call (js-call words :map (lambda (word)
                                 (str "\\u" (js-call (js-call (bit-and word 65535) :toString 16) :padStart 4 "0")
                                      "\\u" (js-call (js-call (unsigned-bit-shift-right word 16) :toString 16) :padStart 4 "0"))))
                                 :join "") "\"")))
                  (setq generated (str generated "  (defun heap-regexp-string-property-copy-" id " (destination)\n"
                                    "    (copy-static-u16 destination " literal "))\n"))
                  (js-call sizes :push (js-array id (* (js-length words) 4))))))
            (setq v-idx (1+ v-idx)))
          (setq generated (str generated
            "  (defun heap-regexp-string-property-bytes ()\n"
            "    (if (= (load-u32 16) 151) " (aref (aref sizes 0) 1)
            " (if (= (load-u32 16) 160) " (aref (aref sizes 1) 1) " " (aref (aref sizes 2) 1) ")))\n"
            "  (defun heap-regexp-string-property-id (heap source start length)\n    (cond\n"))
          (let ((i 0))
            (while (< i (js-length properties))
              (let* ((name (aref properties i))
                     (checks (js-call (js-call (Array/from name) :map (lambda (character j)
                               (str "(= (heap-regexp-unit heap source (+ start " j ")) "
                                    (js-call character :charCodeAt 0) ")"))) :join " ")))
                (setq generated (str generated "      ((and (= length " (js-length name) ")\n        " checks ") " (1+ i) ")\n")))
              (setq i (1+ i))))
          (setq generated (str generated "      (t 0)))\n" end))
          (let* ((filename (fileURLToPath (new globalThis.URL "../../bootstrap/runtime/memory.eli" base-url)))
                 (source (await (readFile filename "utf8")))
                 (first (js-call source :indexOf begin))
                 (last (js-call source :indexOf end)))
            (when (or (< first 0) (< last first))
              (throw (new globalThis.Error "invalid Unicode emoji region")))
            (let ((next (str (js-call source :slice 0 first) generated (js-call source :slice (+ last (js-length end))))))
              (if write
                (progn
                  (when initialize
                    (await (writeFile manifest-path (str (JSON/stringify manifest nil 2) "\n") (js-object :flag "wx"))))
                  (await (writeFile filename next)))
                (when (/= next source)
                  (throw (new globalThis.Error "Unicode emoji data differs"))))
              (js-call globalThis.console :log (JSON/stringify (js-object
                :versions (js-call sizes :map (lambda (pair) (js-object :version (aref pair 0) :bytes (aref pair 1))))
                :generatedBytes (js-call globalThis.Buffer :byteLength generated))))))))))

  (js-call (main) :catch (lambda (error)
    (js-call globalThis.console :error error)
    (put globalThis.process :exitCode 1))))
