(module tools.testing.stdlib-bit
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile readdir realpath rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../../tests/helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "../backends/build.mjs" root)

  (defasync run-successful (command source-root extra-environment)
    (let* ((emacs (get (get globalThis.process :env) :EMACS "emacs"))
           (child (Bun/spawn command (js-object :cwd source-root
             :env (Object/assign (js-object) (get globalThis.process :env) (js-object :EMACS emacs) extra-environment)
             :stdout "pipe" :stderr "pipe")))
           (values (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (unless (= (aref values 0) 0)
        (throw (new globalThis.Error (or (js-call (aref values 2) :trim)
          (js-call (aref values 1) :trim) (str (aref command 0) " exited with " (aref values 0))))))
      (aref values 1)))
  (defasync actual-compiler-directory (source-root directory)
    (unless (and (= (value-type directory) "string") (> (js-length directory) 0))
      (throw (new globalThis.TypeError "complete bit acceptance requires its real compiler directory")))
    (let* ((files (js-call (await (readdir (resolve source-root "bootstrap/compiler"))) :filter
                    (lambda (name) (js-call (new globalThis.RegExp "^[a-z][a-z-]*[.]eli$") :test name))))
           (index 0))
      (unless (and (= (js-length files) 13) (js-call files :includes "compiler.eli"))
        (throw (new globalThis.TypeError "complete bit acceptance requires the original thirteen-module compiler")))
      (while (< index (js-length files))
        (let* ((name (js-call (aref files index) :slice 0 -4)) (path (resolve directory (str name ".mjs"))))
          (await (readFile path)) (await (readFile (str path ".map"))))
        (setq index (1+ index)))
      (await (realpath directory))))

  (defasync runStdlibBitAcceptance (&rest supplied)
    (let* ((options (if (undefined? (aref supplied 0)) (js-object) (aref supplied 0)))
           (source-root (get options :sourceRoot root))
           (selected (get options :selectedDirectory)) (reference (get options :referenceDirectory))
           (compiler (resolve source-root "bin/eliscript"))
           (portable-compiler (resolve source-root "bin/eliscript-portable")))
      (unless (or (and (undefined? selected) (undefined? reference))
                  (and (= (value-type selected) "string") (= (value-type reference) "string")))
        (throw (new globalThis.TypeError "complete bit corpus must supply separate selected and independent Seed directories")))
      (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-bit-"))))
             (bit-source (resolve source-root "stdlib/bit.eli"))
             (usage-source (resolve source-root "tests/fixtures/bit-usage.eli"))
             (host-fixture (resolve source-root "tests/fixtures/bit-host.mjs"))
             (seed-directory (resolve directory "seed"))
             (self-hosted-directory (resolve directory "self-hosted"))
             (bootstrap-directory (resolve directory "bootstrap"))
             (bit-module (resolve seed-directory "bit.mjs"))
             (self-hosted-bit-module (resolve self-hosted-directory "bit.mjs"))
             (usage-module (resolve seed-directory "bit-usage.mjs")))
        (try
          (await (Promise/all (js-array
            (mkdir seed-directory (js-object :recursive t))
            (mkdir self-hosted-directory (js-object :recursive t))
            (mkdir (resolve directory "node_modules") (js-object :recursive t)))))
          ;; All emitted outputs belong to this new disposable root. Resolve
          ;; their genuine language runtime; no compiler or program is replaced.
          (let ((package (JSON/parse (await (readFile (resolve source-root "package.json") "utf8")))))
            (js-call assert :strictEqual (get package :name) "eliscript"))
          (await (symlink (await (realpath source-root)) (resolve directory "node_modules/eliscript") "dir"))
          (when (not (undefined? reference))
            (setq reference (await (actual-compiler-directory source-root reference)))
            (setq selected (await (actual-compiler-directory source-root selected)))
            (js-call assert :notStrictEqual selected reference "selected compiler and independent Seed retain different artifact directories"))
          (let ((inputs (js-array (js-array bit-source bit-module) (js-array usage-source usage-module))) (index 0))
            (while (< index (js-length inputs))
              (let* ((pair (aref inputs index)) (environment (js-object)))
                (unless (undefined? reference) (put environment :ELISCRIPT_BOOTSTRAP_MODULE_DIR reference))
                (await (run-successful (js-array compiler "--source-map" "--output" (aref pair 1) (aref pair 0)) source-root environment)))
              (setq index (1+ index))))
          (let ((compiler-directory (if (undefined? selected)
                    (await (seedCompilerFixture bootstrap-directory)) selected)))
            (await (run-successful (js-array portable-compiler "--source-map" "--output" self-hosted-bit-module bit-source)
              source-root (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR compiler-directory))))
          (js-call assert :strictEqual (await (readFile self-hosted-bit-module "utf8")) (await (readFile bit-module "utf8")))
          (js-call assert :strictEqual (await (readFile (str self-hosted-bit-module ".map") "utf8"))
            (await (readFile (str bit-module ".map") "utf8")))
          (let* ((expected (js-object :intrinsics (js-object
                    :int32 -1 "int32-fraction" 3 "int32-negative-fraction" -3 "int32-nan" 0
                    :uint32 4294967295 "uint32-infinity" 0 "uint32-wrap" 1 :imul32 -5
                    "bit-and" 15 "bit-or" 3855 "bit-xor" 85 "bit-not" -1
                    "shift-left" -2147483648 "shift-mask" 3 "shift-right" -1 "unsigned-shift-right" 1)
                  :evaluation (js-object :result 3 :order (js-array "left" "right"))
                  :library (js-object :zero 0 :all 32 :alternating 16 :high 1
                    :rotateLeft 878082066 :rotateRight 2014458966 :rotateIdentity 305419896 :rotateMasked 878082066)))
                 (hosts (js-array "bun" "node")) (modules (js-array bit-module self-hosted-bit-module))
                 (host-index 0))
            (while (< host-index (js-length hosts))
              (let ((module-index 0))
                (while (< module-index (js-length modules))
                  (let ((output (await (run-successful (js-array (aref hosts host-index) host-fixture usage-module
                                  (aref modules module-index)) source-root (js-object)))))
                    (js-call assert :deepStrictEqual (JSON/parse output) expected))
                  (setq module-index (1+ module-index))))
              (setq host-index (1+ host-index))))
          (let ((source-map (JSON/parse (await (readFile (str bit-module ".map") "utf8")))))
            (js-call assert :strictEqual (js-length (get source-map :sourcesContent)) 1)
            (js-call assert :ok (js-call (aref (get source-map :sourcesContent) 0) :includes "(defportable bit-count"))
            (js-call assert :ok (> (js-length (get source-map :mappings)) 0)))
          (finally (await (rm directory (js-object :recursive t :force t))))))))
  (export runStdlibBitAcceptance))
