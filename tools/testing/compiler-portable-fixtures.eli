(module tools.testing.compiler-portable-fixtures
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "../backends/build.mjs" root)
  (import "../backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../../dist/bootstrap/ir.mjs" validate-serializable-program)
  (defun flattenPortableNodes (nodes)
    (js-call nodes :flatMap (lambda (node) (if (= (get node :kind) "module-declaration")
      (flattenPortableNodes (get node :children)) (js-array node)))))
  (defun repairPortableExportSpans (compiler program)
    (let ((saved (JSON/stringify program)) (copy (globalThis.structuredClone program)))
      (letfn ((walk (nodes)
        (js-call nodes :forEach (lambda (node)
          (if (= (get node :kind) "export-declaration")
            (let* ((children (get node :children)) (names (js-call children :map (lambda (child)
                     (js-call assert :strictEqual (get child :kind) "reference")
                     (js-call assert :strictEqual (value-type (get child :value)) "string") (get child :value))))
                   (declarations (js-call names :map (lambda (name) (+ "(defun " name " (&rest ignored) nil)"))))
                   (source (+ (js-call declarations :join " ") " (export " (js-call names :join " ") ")"))
                   (actual (js-call compiler :compile_ir_string source "portable-fixture-exports.eli"))
                   (export (js-call (flattenPortableNodes (get actual :body)) :find (lambda (item) (= (get item :kind) "export-declaration")))))
              (js-call assert :ok export)
              (when (eq (get node :span) nil) (put node :span (globalThis.structuredClone (get export :span))))
              (js-call children :forEach (lambda (child index)
                (when (eq (get child :span) nil)
                  (put child :span (globalThis.structuredClone (get (aref (get export :children) index) :span)))))))
            (walk (get node :children (js-array))))))))
        (walk (get copy :body)))
      (validate-serializable-program copy)
      (js-call assert :strictEqual (JSON/stringify program) saved) copy))
  (defvar readerFixture undefined)
  (defconst portableReaderPressureTitle "Given live caller roots and allocation pressure, when callbacks exhaust capacity, then state writeback stops and later scans recover")
  (defun adaptPortableManagedFixtures (backend)
    (let* ((managed (get backend :managed)) (descriptors (Object/getOwnPropertyDescriptors managed))
           (entry (get descriptors :emit_managed_wasm)) (original (get entry :value))
           (facade (Object/create (Object/getPrototypeOf managed))))
      (put entry :value (lambda (&rest arguments)
        (let* ((program (aref arguments 0)) (saved (JSON/stringify program)) (forwarded (js-call arguments :slice)))
          (put forwarded 0 (repairPortableExportSpans (get backend :compiler) program))
          (when (js-call (flattenPortableNodes (get program :body)) :some (lambda (node) (= (get node :value) "reader-exhaust")))
            (setq readerFixture (js-object :backend backend :program (globalThis.structuredClone (aref forwarded 0)) :runtime (aref arguments 1))))
          (try (Reflect/apply original managed forwarded)
            (finally (js-call assert :strictEqual (JSON/stringify program) saved))))))
      (Object/defineProperties facade descriptors)
      (Object/assign (js-object) backend (js-object :managed facade))))
  (defun readReaderState (a input)
    (let ((output (js-object)))
      (js-call (js-array "source" "index" "offset" "line" "column") :forEach (lambda (name)
        (let* ((key (js-call a :string name)) (value (js-call a :objectGet input key)))
          (try (put output name (if (= name "source") (js-call a :readString value) (js-call a :readNumber value)))
            (finally (js-call a :release key) (js-call a :release value)))))) output))
  (defasync runPortableReaderRecovery ()
    (js-call assert :ok readerFixture)
    (let* ((backend (get readerFixture :backend)) (compiler (get backend :compiler))
           (program (globalThis.structuredClone (get readerFixture :program)))
           (support (flattenPortableNodes (get (js-call compiler :compile_ir_string
             (await (readFile (resolve root "tools/testing/fixtures/portable-reader-failure.eli") "utf8")) "reader-failure.eli") :body)))
           (nodes (flattenPortableNodes (get program :body)))
           (exports (js-call nodes :find (lambda (node) (= (get node :kind) "export-declaration"))))
           (added (js-call support :find (lambda (node) (= (get node :kind) "function-declaration"))))
           (reference (aref (get (js-call support :find (lambda (node) (= (get node :kind) "export-declaration"))) :children) 0)))
      (put program :body (js-call (js-call nodes :filter (lambda (node) (/= (get node :kind) "export-declaration"))) :concat (js-array added exports)))
      (js-call (get exports :children) :push reference)
      (validate-serializable-program program)
      (let* ((before (JSON/stringify program))
             (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program (get readerFixture :runtime))))
             (a (instantiateManagedRuntime bytes (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 1048576)))
             (ignored (js-call a :auto 1))
             (values (js-array (js-call a :string "abc ") (js-call a :number 0) (js-call a :number 11) (js-call a :number 3) (js-call a :number 7)))
             (input (js-call a :sourceObject (Object/fromEntries (js-call (js-array "source" "index" "offset" "line" "column") :map
               (lambda (key index) (js-array key (aref values index)))))))
             (trace (js-call a :sourceObject (js-object :called false))) (callback (js-call a :invoke "reader-failure" (js-array trace)))
             (saved (js-call a :number -0)) (frame (js-call a :frame 1))
             (state (readReaderState a input)) (key undefined) (out undefined))
        (js-call assert :strictEqual (JSON/stringify program) before)
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (js-call values :forEach (lambda (value) (js-call a :release value)))
        (js-call a :frameSet frame 0 saved)
        (try
          (progn
            (js-call assert :throws (lambda () (js-call a :invoke "native-skip-space-and-comments" (js-array input callback))) (lambda (error) (eq error false)))
            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :ok (Object/is (js-call a :readNumber saved) -0))
            (js-call assert :deepStrictEqual (readReaderState a input) state)
            (setq key (js-call a :string "called"))
            (js-call assert :strictEqual (js-call a :objectGet trace key) t)
            (setq out (js-call a :invoke "reader-skip" (js-array input)))
            (js-call assert :strictEqual out nil)
            (js-call assert :deepStrictEqual (readReaderState a input) state))
          (finally (js-call a :leaveFrame frame)
            (js-call (js-array input trace callback saved key out) :forEach (lambda (value) (js-call a :release value)))
            (js-call a :closeModule) (js-call a :collect)
            (js-call assert :strictEqual (js-call a :live) 0)
            (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))))))
  (defconst nativeNodeMemoryOriginalSource "\n    (import \"eliscript:memory32\" load-u32 store-u32 memory-grow)\n    (defun read32 (p) (load-u32 p))\n    (defun write32 (p v) (store-u32 p v))\n    (defun grow (n) (memory-grow n))\n    (defun notify (heap argv) 0)\n    (defun spin (heap argv) (while true (store-u32 64 1)))\n    (export read32 write32 grow notify spin)")
  (defun adaptNativeNodeMemoryCompiler (backend)
    (let* ((compiler (get backend :compiler)) (descriptors (Object/getOwnPropertyDescriptors compiler))
           (entry (get descriptors :compile_ir_string)) (original (get entry :value))
           (facade (Object/create (Object/getPrototypeOf compiler))))
      (put entry :value (lambda (&rest arguments)
        (let ((forwarded (js-call arguments :slice)))
          (when (= (aref arguments 1) "native-node-memory.eli")
            (js-call assert :strictEqual (aref arguments 0) nativeNodeMemoryOriginalSource)
            (let ((pieces (js-call (aref arguments 0) :split "(while true (store-u32 64 1))")))
              (js-call assert :strictEqual (js-length pieces) 2)
              ;; The memory kernel requires a u32 function result. The loop
              ;; remains infinite; the unreachable zero gives its sequence
              ;; the required type without changing the observed execution.
              (put forwarded 0 (js-call pieces :join "(while 1 (store-u32 64 1)) 0"))))
          (Reflect/apply original compiler forwarded))))
      (Object/defineProperties facade descriptors)
      (Object/assign (js-object) backend (js-object :compiler facade))))
  (export flattenPortableNodes repairPortableExportSpans adaptPortableManagedFixtures portableReaderPressureTitle runPortableReaderRecovery adaptNativeNodeMemoryCompiler))
