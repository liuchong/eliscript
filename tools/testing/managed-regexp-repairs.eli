(module tools.testing.managed-regexp-repairs
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve)
  (import "../backends/build.mjs" root)
  (import "../compiler/controlled-baseline.mjs" definition)
  (import "../backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../../tests/helpers/managed-browser-transport.mjs" loadManagedReference)
  (defconst regexpBacktrackingTitle "backtracking capacity failure and actual matching traps preserve caller frames and live source text")
  (defconst regexpIndicesTitle "indices allocation capacity and input-conversion throws preserve caller roots and permit later execution")
  (defun bytes (backend runtime program)
    (let* ((saved (JSON/stringify program)) (out (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (js-call assert :strictEqual (JSON/stringify program) saved)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module out)) (js-array)) out))
  (defun finish (a roots)
    (try
      (progn (js-call roots :forEach (lambda (value) (js-call a :release value)))
        (js-call a :closeModule) (js-call a :collect)
        (js-call assert :strictEqual (js-call a :live) 0)
        (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
      (finally (when (get a :close) (js-call a :close)))))
  (defasync runRegexpBacktrackingSemantics (backend runtime)
    (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
           (source "(defconst pattern (js* \"/(a|aa)*b/\")) (defun test-value (x) (js-call pattern :test x)) (defun match-value (x) (js-call pattern :exec x)) (defun meta-value (x key) (get x key)) (export test-value match-value meta-value)")
           (program (js-call (get backend :compiler) :compile_ir_string source "regexp.eli")))
      (try
        (let* ((javascript (await (loadManagedReference (get fixture :directory) (js-call (get backend :compiler) :emit_ir_string program) "regexp-trap-oracle")))
               (runtimeSource (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
               (start (js-call runtimeSource :indexOf "  (defun heap-regexp-point "))
               (end (js-call runtimeSource :indexOf "  (defun heap-regexp-line " start)))
          (js-call assert :ok (and (>= start 0) (> end start)))
          (let* ((injected (+ (js-call runtimeSource :slice 0 start) "  (defun heap-regexp-point (heap text position flags) (load-u32 4294967295))\n" (js-call runtimeSource :slice end)))
                 (rt (js-call (get backend :compiler) :compile_ir_string injected "regexp-trap.eli"))
                 (a (instantiateManagedRuntime (bytes backend rt program)))
                 (ignored (js-call a :auto 1)) (original (js-call a :string "ab"))
                 (saved (js-call a :number -0)) (frame (js-call a :frame 1))
                 (object (js-call a :sourceObject (js-object)))
                 (invalid (js-call a :sourceObject (js-object :toString false :valueOf false))))
            (js-call a :frameSet frame 0 saved)
            (try
              (progn
                ;; Ordinary Object conversion is now implemented; preserve the
                ;; original empty object and prove its actual JS conversion.
                (js-call assert :strictEqual (js-call javascript :test_value (js-object)) t)
                (js-call assert :throws (lambda () (js-call javascript :test_value (js-object :toString false :valueOf false))) globalThis.TypeError)
                (js-call assert :throws (lambda () (js-call a :invoke "test-value" (js-array invalid)))
                  (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0003")))
                (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
                (js-call assert :throws (lambda () (js-call a :invoke "test-value" (js-array object))) globalThis.WebAssembly.RuntimeError)
                (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
                (js-call assert :throws (lambda () (js-call a :invoke "test-value" (js-array original))) globalThis.WebAssembly.RuntimeError)
                (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
                (js-call assert :ok (Object/is (js-call a :readNumber saved) -0))
                (js-call assert :strictEqual (js-call a :readString original) "ab"))
              (finally (js-call a :leaveFrame frame) (finish a (js-array original saved object invalid))))))
        (finally (js-call fixture :close)))))
  (defun call (a name values)
    (let ((owned (js-array)))
      (let ((arguments (js-call values :map (lambda (value)
        (if (or (= (value-type value) "string") (= (value-type value) "number"))
          (let ((boxed (if (= (value-type value) "string") (js-call a :string value) (js-call a :number value))))
            (js-call owned :push boxed) boxed) value)))))
        (try (js-call a :invoke name arguments) (finally (js-call owned :forEach (lambda (value) (js-call a :release value))))))))
  (defun textCall (a name values)
    (let ((value (call a name values))) (try (js-call a :readString value) (finally (js-call a :release value)))))
  (defun discard (a name values) (js-call a :release (call a name values)))
  (defun failureRecovery (a js)
    (let* ((regex (call a "make" (js-array "(a)" "dg"))) (oracle (js-call js :make "(a)" "dg"))
           (zero (js-call a :number -0)) (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 zero)
      (try
        (progn
          (discard a "last" (js-array regex 1)) (js-call js :last oracle 1)
          (discard a "clear" (js-array)) (js-call js :clear)
          (js-call assert :throws (lambda () (call a "throwing" (js-array regex))) (lambda (error) (eq error false)))
          (js-call assert :throws (lambda () (js-call js :throwing oracle)) (lambda (error) (eq error false)))
          (js-call assert :strictEqual (textCall a "trace" (js-array)) (js-call js :trace))
          (js-call assert :strictEqual (textCall a "meta" (js-array regex)) (js-call js :meta oracle))
          (js-call assert :ok (Object/is (js-call a :readNumber zero) -0))
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :strictEqual (textCall a "recover" (js-array)) (js-call js :recover)))
        (finally (js-call a :leaveFrame frame) (js-call a :release zero) (js-call a :release regex)))))
  (defasync runRegexpIndicesSemantics (backend runtime)
    (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
           (name "tests/fixtures/wasm-managed-regexp-indices.eli")
           (source (await (readFile (resolve root name) "utf8")))
           (program (js-call (get backend :compiler) :compile_ir_string source name))
           (saved (JSON/stringify program))
           (lowered (js-call (get backend :managed) :lower_managed_program program runtime t))
           (raw (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) (js-object :initialPages 1 :maximumPages 32)))
           (image (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section raw "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
           (target (if (= (get globalThis.process :arch) "arm64")
             (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
                   ((= (get globalThis.process :platform) "linux") "arm64-linux") (t undefined)) undefined))
           (options (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 1048576 :maximumPages 32))
           (library undefined))
      (try
        (let ((js (await (loadManagedReference (get fixture :directory) (js-call (get backend :compiler) :emit_ir_string program) "regexp-indices-oracle"))))
          (js-call assert :strictEqual (JSON/stringify program) saved)
          (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module image)) (js-array))
          (unless (undefined? target)
            (setq library (resolve (get fixture :directory) (if (= target "arm64-linux") "indices.so" "indices.dylib")))
            (await (writeFile library (globalThis.Uint8Array.from (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) target)))))
          (let ((kinds (if (undefined? target) (js-array "wasm") (js-array "wasm" "native"))) (index 0))
            (while (< index (js-length kinds))
              (let ((kind (aref kinds index)) (round 0))
                (while (< round 2)
                  (let ((a (if (= kind "wasm") (instantiateManagedRuntime image options)
                    (await (instantiateNativeManagedRuntime library lowered (Object/assign (js-object) options (js-object :nativeTarget target)))))))
                    (js-call a :auto 1)
                    (try
                      (progn
                        (if (= round 0) (failureRecovery a js)
                          (js-call assert :strictEqual (textCall a "recover" (js-array)) (js-call js :recover)
                            "the same full report succeeds in the existing full-report configuration"))
                        (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
                      (finally (finish a (js-array)))))
                  (setq round (1+ round))))
              (setq index (1+ index)))))
        (finally (js-call fixture :close)))))
  (defconst regexpPropertySourceTitle "actual split and original JS retain every supported property alias plus case offsets trailing UTF16 and source read failures")
  (defun trieTree (source)
    (let ((stack (js-array)) (result undefined))
      (js-call (js-call source :match (js* "/\\(|\\)|[^\\s()]+/g")) :forEach (lambda (token)
        (cond ((= token "(") (let ((value (js-array)))
          (when (> (js-length stack) 0) (js-call (js-call stack :at -1) :push value)) (js-call stack :push value)))
          ((= token ")") (setq result (js-call stack :pop)))
          (t (js-call (js-call stack :at -1) :push token)))))
      (js-call assert :strictEqual (js-length stack) 0) result))
  (defun trieNames (tree)
    (let ((result (new globalThis.Map)))
      (letfn ((visit (value unit characters)
        (if (not (Array/isArray value))
          (when (and (js-call (js* "/^\\d+$/") :test value) (> (globalThis.Number value) 0))
            (js-call assert :ok (and (> (js-length characters) 0) (js-call characters :every globalThis.Number.isInteger)))
            (let ((name (js-call globalThis.String.fromCharCode :apply undefined characters)) (id (globalThis.Number value)))
              (if (js-call result :has name) (js-call assert :strictEqual (js-call result :get name) id) (js-call result :set name id))))
          (if (= (aref value 0) "let")
            (let* ((binding (aref (aref value 1) 0)) (offset (aref (aref binding 1) 2)))
              (js-call assert :strictEqual (aref binding 0) "unit")
              (js-call assert :deepStrictEqual (js-call (aref binding 1) :slice 0 2) (js-array "string-code-unit-at" "source"))
              (js-call assert :deepStrictEqual (js-call offset :slice 0 2) (js-array "+" "start"))
              (visit (aref value 2) (globalThis.Number (aref offset 2)) characters))
            (let* ((condition (aref value 1)) (yes characters))
              (js-call assert :strictEqual (aref value 0) "if")
              (when (and (= (aref condition 0) "=") (= (aref condition 1) "unit"))
                (setq yes (js-call characters :slice)) (put yes unit (globalThis.Number (aref condition 2))))
              (visit (aref value 2) unit yes) (visit (aref value 3) unit characters))))))
        (visit (aref tree 3) nil (js-array))) result))
  (defun observeRead (operation)
    (try (js-object :ok t :value (funcall operation))
      (catch error
        ;; Native engine diagnostics include generated local expression text.
        ;; The actual constructor and name remain strict error evidence.
        (js-object :ok false :constructor (get error :constructor) :name (get error :name)))))
  (defasync runRegexpPropertySourceReads (backend)
    (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
           (originalSource (await (readFile (resolve root "tests/fixtures/regexp-property-original-trie.eli") "utf8")))
           (definitions (new globalThis.Map)) (rootName "regexp-property-id-base"))
      (try
        (progn
          (js-call (Array/from (js-call originalSource :matchAll (js* "/\\(defun (regexp-property-id-base(?:-part-\\d{4})?) /g"))) :forEach
            (lambda (match)
              (js-call assert :strictEqual (js-call definitions :has (aref match 1)) false)
              (js-call definitions :set (aref match 1) (definition originalSource (+ (aref match 1) " ")))))
          (letfn ((inline (source active)
            (js-call source :replace (js* "/\\((regexp-property-id-base-part-\\d{4}) (source start length(?: unit)?)\\)/g")
              (lambda (ignored name arguments)
                (js-call assert :strictEqual (js-call active :has name) false)
                (let* ((text (js-call definitions :get name))
                       (match (js-call (js* "/^\\(defun [^\\s]+ \\(([^)]*)\\) ([\\s\\S]*)\\)$/") :exec text))
                       (next (new globalThis.Set active)))
                  (js-call assert :ok text) (js-call assert :ok match)
                  (js-call assert :strictEqual arguments (aref match 1))
                  (js-call next :add name) (inline (aref match 2) next))))))
            (let* ((reconstructed (inline (js-call definitions :get rootName) (new globalThis.Set)))
                   (names (trieNames (trieTree reconstructed)))
                   (source (await (readFile (resolve root "bootstrap/backends/regexp.eli") "utf8")))
                   (start (js-call source :indexOf ";; BEGIN GENERATED UNICODE PROPERTY ALIASES"))
                   (end (js-call source :indexOf ";; END GENERATED UNICODE PROPERTY ALIASES" start)))
              (js-call assert :ok (and (>= start 0) (> end start)))
              (js-call assert :strictEqual (get definitions :size) 69)
              (js-call assert :ok (> (get names :size) 100))
              (let* ((outlined (+ "(module regexp.outline\n" (js-call source :slice start end) "\n(export " rootName "))"))
                     (splitJS (await (loadManagedReference (get fixture :directory)
                       (js-call (get backend :compiler) :compile_string outlined "regexp-outline.eli") "regexp-outline")))
                     (originalJS (await (loadManagedReference (get fixture :directory)
                       (js-call (get backend :compiler) :compile_string (+ "(module regexp.original " reconstructed " (export " rootName "))") "regexp-original.eli") "regexp-original")))
                     (actual (get splitJS :regexp_property_id_base)) (original (get originalJS :regexp_property_id_base)))
                (js-call names :forEach (lambda (id name)
                  (js-call (js-array name (js-call name :toLowerCase) (js-call name :toUpperCase) (+ name "x")
                    (js-call name :slice 0 -1) (+ "\ud800" name) (+ name "\udfff")) :forEach (lambda (text)
                      (js-call assert :deepStrictEqual (observeRead (lambda () (funcall actual text 0 (js-length text))))
                        (observeRead (lambda () (funcall original text 0 (js-length text)))) text)))
                  (js-call assert :strictEqual (funcall actual (+ "!" name "?") 1 (js-length name)) (funcall original (+ "!" name "?") 1 (js-length name)))
                  (js-call assert :strictEqual (funcall actual (+ "😀" name) 2 (js-length name)) (funcall original (+ "😀" name) 2 (js-length name)))))
                (js-call (js-array "" nil undefined 17 false (js-object) "\u0000" "\ud800" "\udfff" "😀") :forEach (lambda (input)
                  (js-call (js-array (js-array 0 0) (js-array 0 1) (js-array -1 3) (js-array 1 2)
                    (js-array globalThis.NaN 2) (js-array 0 globalThis.NaN) (js-array 0 -1) (js-array 0 globalThis.Infinity)) :forEach (lambda (row)
                      (js-call assert :deepStrictEqual (observeRead (lambda () (funcall actual input (aref row 0) (aref row 1))))
                        (observeRead (lambda () (funcall original input (aref row 0) (aref row 1)))))))))
                ;; Both getter and actual method failures retain the identical
                ;; user error, including message, and exact access/argument order.
                (letfn ((readTrace (fn mode)
                  (let ((reads (js-array)) (marker (new globalThis.Error "original source read")) (caught undefined)
                        (input (js-object)))
                    (Object/defineProperty input "charCodeAt" (js-object :get (lambda ()
                      (when (= mode 1) (js-call reads :push "get") (throw marker))
                      (lambda (index) (js-call reads :push index)
                        (when (= (js-length reads) 3) (throw marker)) (js-call "ASCII" :charCodeAt index)))))
                    (try (funcall fn input 0 5) (catch error (setq caught error)))
                    (js-call assert :strictEqual caught marker)
                    (js-object :reads reads :name (get caught :name) :message (get caught :message)))))
                  (js-call (js-array 0 1) :forEach (lambda (mode)
                    (js-call assert :deepStrictEqual (readTrace actual mode) (readTrace original mode)))))))))
        (finally (js-call fixture :close)))))
  (export regexpBacktrackingTitle regexpIndicesTitle runRegexpBacktrackingSemantics runRegexpIndicesSemantics
    regexpPropertySourceTitle runRegexpPropertySourceReads))
