(module tools.testing.scheduler
  ;; Memory-aware Longest-Processing-Time-First (LPT) dynamic admission scheduler.
  ;; Dispatches heaviest files first while gating new worker starts on live RSS
  ;; telemetry plus cold-start reservations, preventing aggregate OOM kills.
  (defconst DEFAULT_ADMISSION_RATIO 0.78)
  (defconst DEFAULT_COLD_START_GRACE_MS 4000)
  (defconst DEFAULT_POLL_MS 75)
  (defconst DEFAULT_ESTIMATED_RSS_BYTES (* 512 1024 1024))

  (defun num-or (value fallback)
    (if (and (Number/isFinite value) (> value 0)) value fallback))

  (defun ratio-or (value fallback)
    (if (and (Number/isFinite value) (> value 0) (<= value 1.0)) value fallback))

  (defun item-rss-estimate (item)
    (let ((val (when item (get item :estimatedRssBytes))))
      (num-or val DEFAULT_ESTIMATED_RSS_BYTES)))

  (defasync runMemoryAwareLptQueue (items config &optional hooks)
    (let* ((cfg (or config (js-object)))
           (hk (or hooks (js-object)))
           (max-workers (Math/max 1 (num-or (get cfg :maxWorkers) 2)))
           (heavy-workers (Math/max 1 (Math/min max-workers (num-or (get cfg :heavyWorkers) 1))))
           (agg-ceiling (get cfg :aggregateCeilingBytes))
           (has-ceiling (and (Number/isFinite agg-ceiling) (> agg-ceiling 0)))
           (admission-ratio (ratio-or (get cfg :admissionRatio) DEFAULT_ADMISSION_RATIO))
           (admission-ceiling (when has-ceiling (Math/floor (* agg-ceiling admission-ratio))))
           (cold-grace-ms (num-or (get cfg :coldStartGraceMs) DEFAULT_COLD_START_GRACE_MS))
           (poll-ms (num-or (get cfg :pollMs) DEFAULT_POLL_MS))
           (should-stop (or (get hk :shouldStop) (lambda () false)))
           (get-telemetry (get hk :getLiveTelemetry))
           (run-item (get hk :runItem))
           (on-dispatch (get hk :onDispatch))
           (on-settle (get hk :onSettle))
           (queue (js-call items :slice))
           (active-total 0)
           (active-heavy 0)
           (active-exclusive 0)
           (in-flight (new globalThis.Map))
           (next-token 1)
           (peak-rss-bytes 0)
           (admission-pauses 0)
           (last-pause-counted false)
           (wake-timer nil)
           (settled false))
      (unless (= (value-type run-item) "function")
        (throw (new globalThis.TypeError "runMemoryAwareLptQueue requires hooks.runItem")))
      (new globalThis.Promise (lambda (resolve-done reject-done)
        (letfn ((clear-wake ()
                  (when wake-timer
                    (funcall globalThis.clearTimeout wake-timer)
                    (setq wake-timer nil)))
                (cold-reserve-bytes (now)
                  (let ((sum 0))
                    (js-call in-flight :forEach (lambda (rec)
                      (when (< (- now (get rec :startedAt)) cold-grace-ms)
                        (setq sum (+ sum (get rec :estimatedRssBytes))))))
                    sum))
                (current-live-rss ()
                  (let ((snap (when (= (value-type get-telemetry) "function") (funcall get-telemetry))))
                    (if (and snap (Number/isFinite (get snap :aggregateRssBytes)) (>= (get snap :aggregateRssBytes) 0))
                      (let ((rss (get snap :aggregateRssBytes)))
                        (when (> rss peak-rss-bytes) (setq peak-rss-bytes rss))
                        rss)
                      0)))
                (can-admit-rss-p (entry now)
                  (if (or (not has-ceiling) (= active-total 0))
                    t
                    (let* ((live-rss (current-live-rss))
                           (reserved (cold-reserve-bytes now))
                           (projected (+ live-rss reserved (item-rss-estimate entry))))
                      (<= projected admission-ceiling))))
                (schedule-wake ()
                  (unless (or settled wake-timer)
                    (setq wake-timer (funcall globalThis.setTimeout (lambda ()
                      (setq wake-timer nil)
                      (pump)) poll-ms))))
                (pump ()
                  (unless settled
                    (clear-wake)
                    (let ((can-launch t) (paused-by-memory false) (now (Date/now)))
                      (while (and can-launch
                                  (= active-exclusive 0)
                                  (< active-total max-workers)
                                  (not (funcall should-stop))
                                  (> (js-length queue) 0))
                        (let ((pos -1) (k 0) (found-slot false))
                          (while (and (< pos 0) (< k (js-length queue)))
                            (let ((candidate (aref queue k)))
                              (when (if (get candidate :exclusive)
                                      (= active-total 0)
                                      (or (not (get candidate :heavy)) (< active-heavy heavy-workers)))
                                (setq found-slot t)
                                (when (can-admit-rss-p candidate now)
                                  (setq pos k))))
                            (setq k (1+ k)))
                          (if (< pos 0)
                            (progn
                              (setq can-launch false)
                              (when (and found-slot (> active-total 0) has-ceiling)
                                (setq paused-by-memory t)))
                            (let* ((entry (aref (js-call queue :splice pos 1) 0))
                                   (token next-token)
                                   (est-rss (item-rss-estimate entry))
                                   (started-at (Date/now)))
                              (setq next-token (1+ next-token))
                              (setq last-pause-counted false)
                              (setq active-total (1+ active-total))
                              (when (get entry :heavy) (setq active-heavy (1+ active-heavy)))
                              (when (get entry :exclusive) (setq active-exclusive (1+ active-exclusive)))
                              (js-call in-flight :set token (js-object :startedAt started-at :estimatedRssBytes est-rss))
                              (when (= (value-type on-dispatch) "function")
                                (try (funcall on-dispatch entry) (catch _hook nil)))
                              (js-call (funcall (async () (await (funcall run-item entry)))) :then
                                (lambda ()
                                  (setq active-total (1- active-total))
                                  (when (get entry :heavy) (setq active-heavy (1- active-heavy)))
                                  (when (get entry :exclusive) (setq active-exclusive (1- active-exclusive)))
                                  (js-call in-flight :delete token)
                                  (current-live-rss)
                                  (when (= (value-type on-settle) "function")
                                    (try (funcall on-settle entry (- (Date/now) started-at)) (catch _hook nil)))
                                  (pump))
                                (lambda (error)
                                  (setq active-total (1- active-total))
                                  (when (get entry :heavy) (setq active-heavy (1- active-heavy)))
                                  (when (get entry :exclusive) (setq active-exclusive (1- active-exclusive)))
                                  (js-call in-flight :delete token)
                                  (unless settled
                                    (setq settled t)
                                    (clear-wake)
                                    (funcall reject-done error))))))))
                      (when paused-by-memory
                        (unless last-pause-counted
                          (setq last-pause-counted t)
                          (setq admission-pauses (1+ admission-pauses)))
                        (schedule-wake))
                      (when (and (not settled)
                                 (= active-total 0)
                                 (or (= (js-length queue) 0) (funcall should-stop)))
                        (setq settled t)
                        (clear-wake)
                        (funcall resolve-done (js-object
                          :peakAggregateRssBytes peak-rss-bytes
                          :admissionPauses admission-pauses)))))))
          (pump))))))

  (export DEFAULT_ADMISSION_RATIO DEFAULT_COLD_START_GRACE_MS DEFAULT_POLL_MS runMemoryAwareLptQueue))
