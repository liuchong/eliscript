(module tools.testing.wasm-analyzer-corpus
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../../tests/wasm-compiler-analyzer-rig.mjs" setup teardown artifact analyzeObserved expectedAnalysis finish)

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defasync run-corpus ()
    (let* ((source-root (resolve (fileURLToPath (new globalThis.URL "../.." (js* "import.meta.url")))))
           (fixture (progn (js-call globalThis.process :chdir source-root)
                      (JSON/parse (await (readFile "tests/fixtures/bootstrap-analyzer.json" "utf8")))))
           (cases (js-call (get fixture :valid) :filter (lambda (item) (get item :file))))
           (configuration (js-object :maxSlots 524288 :initialBytes 16777216 :maxBytes 134217728))
           (memory-options (js-object :maximumPages 4096))
           (auto-bytes 65536)
           (passed 0)
           (failed 0))
      (js-call assert :equal (js-length (get fixture :valid)) 30)
      (js-call assert :equal (js-length cases) 12)
      (js-call assert :equal (js-length (get fixture :invalid)) 57)
      (console/log (JSON/stringify (js-call globalThis.Object :assign
                                    (js-object :format "eliscript-wasm-analyzer-corpus-config")
                                    configuration memory-options
                                    (js-object :autoBytes auto-bytes :pageBytes 65536
                                      :cases (js-call cases :map (lambda (item) (get item :name)))))))
      (try
        (await (setup))
        (let ((runtime (instantiateManagedRuntime (artifact memory-options) configuration))
              (index 0))
          (js-call runtime :auto auto-bytes)
          (while (< index (js-length cases))
            (let* ((item (aref cases index))
                   (source (await (readFile (get item :file) "utf8")))
                   (result (js-object :case (get item :name) :target "wasm"
                             :bytes (js-call globalThis.Buffer :byteLength source))))
              (console/log (JSON/stringify (js-call globalThis.Object :assign (js-object) result
                                            (js-object :status "running" :stats (js-call runtime :stats)))))
              (try
                (let ((expected (expectedAnalysis source (get item :filename))))
                  (js-call assert :equal (get expected :status) "ok")
                  (js-call assert :deepEqual (analyzeObserved runtime source (get item :filename)) expected)
                  (put result :status "pass"))
                (catch error
                  (put result :status "fail")
                  (put result :name (get error :name))
                  (put result :message (get error :message))
                  (put result :diagnostic (get error :eliscriptDiagnostic))
                  (put result :statsAtFailure (get error :testManagedState (js-call runtime :stats))))
                (finally
                  (try
                    (js-call runtime :collect)
                    (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
                    (catch error
                      (put result :status "fail")
                      (put result :cleanupFailure (get error :message))))))
              (if (= (get result :status) "pass")
                (setq passed (1+ passed))
                (setq failed (1+ failed)))
              (console/log (JSON/stringify result)))
            (setq index (1+ index)))
          (finish runtime))
        (finally (await (teardown))))
      (console/log (JSON/stringify (js-object :format "eliscript-wasm-analyzer-corpus" :passed passed :failed failed)))
      (when (host-truthy-number failed)
        (put globalThis.process :exitCode 1))))

  (defun host-truthy-number (value)
    (funcall (js* "(value) => !!value") value))

  (js-call (run-corpus) :catch
    (lambda (error)
      (console/error error)
      (put globalThis.process :exitCode 1))))
