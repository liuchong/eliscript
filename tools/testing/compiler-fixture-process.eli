(module tools.testing.compiler-fixture-process
  (defasync readCompilerFixtureErrors (stream)
    (let ((reader (js-call stream :getReader)) (decoder (new globalThis.TextDecoder)) (tail ""))
      (try
        (let ((done false))
          (while (not done)
            (let ((chunk (await (js-call reader :read))))
              (setq done (get chunk :done))
              (let ((text (if done (js-call decoder :decode)
                            (js-call decoder :decode (get chunk :value) (js-object :stream t)))))
                (when (> (js-length text) 0)
                  (js-call (get globalThis.process :stderr) :write text)
                  (setq tail (js-call (str tail text) :slice -32768)))))))
        tail
        (finally (js-call reader :releaseLock)))))
  (defasync runCompilerFixture (command options deadline)
    (unless (and (Number/isSafeInteger deadline) (> deadline 0) (<= deadline 1800000))
      (throw (new globalThis.RangeError "compiler fixture requires a bounded process deadline")))
    (let* ((child (js-call globalThis.Bun :spawn command
                    (Object/assign (js-object :stdin "ignore" :stdout "pipe" :stderr "pipe") options)))
           (expired false) (force undefined)
           (timer (globalThis.setTimeout (lambda ()
             (setq expired t) (js-call child :kill "SIGTERM")
             (setq force (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 500))) deadline)))
      (try
        (let* ((result (await (Promise/all (js-array (get child :exited)
                          (js-call (new globalThis.Response (get child :stdout)) :text)
                          (readCompilerFixtureErrors (get child :stderr))))))
               (status (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
          (when expired (throw (new globalThis.Error (str "compiler fixture process exceeded " deadline "ms: " (aref command 0)))))
          (unless (= status 0)
            (throw (new globalThis.Error (if (> (js-length (js-call stderr :trim)) 0) (js-call stderr :trim)
              (if (> (js-length (js-call stdout :trim)) 0) (js-call stdout :trim) (str (aref command 0) " exited with " status))))))
          stdout)
        (finally (globalThis.clearTimeout timer) (globalThis.clearTimeout force)))))
  (export runCompilerFixture))
