(module tools.testing.managed-host-default-contract
  (import "node:assert/strict" :default assert)
  (defun caught (operation)
    (let ((failed false) (failure undefined))
      (try (funcall operation) (catch error (setq failed t failure error)))
      (js-call assert :strictEqual failed t) failure))
  (defun typeError (failure)
    (js-call assert :strictEqual (get failure :constructor) globalThis.TypeError)
    (js-call assert :strictEqual (get failure :name) "TypeError")
    (js-call assert :strictEqual (get failure :eliscriptDiagnostic) undefined))
  (defun assertManagedHostDefaultContract (host legacy)
    (js-call (js-array "failManagedRuntime" "validateManagedRuntimeOptions" "createManagedHostCapabilityBridge") :forEach
      (lambda (name) (js-call assert :strictEqual (get host name) (get legacy name))))
    (js-call assert :strictEqual (get (get host :createManagedHostRuntime) :length) 3)
    (let ((factories (js-array (get host :createManagedHostRuntime) (get legacy :createManagedHostRuntime))))
      ;; The same malformed call must retain its actual error class. Engine
      ;; expression spellings in native TypeError messages are private code.
      (js-call (js-array (js-array) (js-array undefined) (js-array nil)) :forEach (lambda (tail)
        (js-call factories :forEach (lambda (factory)
          (typeError (caught (lambda () (Reflect/apply factory undefined
            (js-call (js-array (Object/create nil) nil nil) :concat tail)))))))))
      ;; Reach a genuine caller-supplied export boundary to prove the defaults
      ;; rather than inferring them from a missing JS function's error text.
      (js-call (js-array (js-array) (js-array undefined) (js-array (js-object)) (js-array (Object/create nil))) :forEach
        (lambda (tail)
          (js-call factories :forEach (lambda (factory)
            (let* ((marker (new globalThis.Error "original heap allocation boundary")) (trace (js-array))
                   (exports (js-object :heap-new (lambda (&rest values) (js-call trace :push values) (throw marker))))
                   (failure (caught (lambda () (Reflect/apply factory undefined (js-call (js-array exports nil nil) :concat tail))))))
              (js-call assert :strictEqual failure marker)
              (js-call assert :deepStrictEqual trace (js-array (js-array 1024 65536 16777216))))))))
      (js-call factories :forEach (lambda (factory)
        (let* ((fields (js-array "maxSlots" "initialBytes" "maxBytes" "initializeModule" "unicodeVersion" "randomSeed"))
               (values (js-array 2048 8192 1048576 false 17 (js-array 1 2 3 4)))
               (options (js-object)) (reads (js-array)) (calls (js-array)) (abiCalls (js-array))
               (marker (new globalThis.Error "explicit heap allocation boundary"))
               (exports (js-object :last-error (lambda () 0)
                 :runtime-case-version (lambda (version) (js-call abiCalls :push (js-array "case" version)) 0)
                 :runtime-random-seed (lambda (&rest seed) (js-call abiCalls :push (js-call (js-array "seed") :concat seed)) 0)
                 :heap-new (lambda (&rest arguments) (js-call calls :push arguments) (throw marker)))))
          (js-call fields :forEach (lambda (field index)
            (Object/defineProperty options field (js-object :enumerable t :get (lambda ()
              (js-call reads :push field) (aref values index))))))
          (let ((failure (caught (lambda () (funcall factory exports nil nil options)))))
            (js-call assert :strictEqual failure marker)
            (js-call assert :deepStrictEqual reads fields)
            (js-call assert :deepStrictEqual calls (js-array (js-array 2048 8192 1048576)))
            (js-call assert :deepStrictEqual abiCalls (js-array (js-array "case" 170) (js-array "seed" 1 2 3 4))))
          ;; A user getter's exact original error wins before any export call.
          (let ((throwing (js-object)) (observed (js-array)) (first (new globalThis.Error "original option getter")))
            (js-call fields :forEach (lambda (field index)
              (Object/defineProperty throwing field (js-object :get (lambda ()
                (js-call observed :push field) (when (= field "maxBytes") (throw first)) (aref values index))))))
            (let ((failure (caught (lambda () (funcall factory exports nil nil throwing)))))
              (js-call assert :strictEqual failure first)
              (js-call assert :deepStrictEqual observed (js-array "maxSlots" "initialBytes" "maxBytes"))
              (js-call assert :strictEqual (js-length calls) 1))))))))
  (export assertManagedHostDefaultContract))
