(module tools.testing.profile-store
  (import "node:fs" existsSync mkdirSync readFileSync renameSync unlinkSync writeFileSync)
  (import "node:path" basename dirname join resolve)
  (import "node:crypto" randomUUID)

  ;; Rolling EWMA test duration and peak RSS profile store plus failure ledger.
  ;; Enables data-driven LPT scheduling, cold-start RSS estimation, and --rerun-failed.
  (defconst PROFILE_FORMAT "eliscript-test-profile-v1")
  (defconst FAILURES_FORMAT "eliscript-test-failures-v1")
  (defconst DEFAULT_STANDARD_RSS_BYTES (* 450 1024 1024))
  (defconst DEFAULT_HEAVY_RSS_BYTES (* 1200 1024 1024))
  (defconst MIN_ESTIMATED_RSS_BYTES (* 128 1024 1024))
  (defconst MAX_ESTIMATED_RSS_BYTES (* 4096 1024 1024))

  (defun profile-file-path (source-root &optional custom-path)
    (if (and (= (value-type custom-path) "string") (> (js-length custom-path) 0))
      (resolve source-root custom-path)
      (resolve source-root ".eliscript-cache/test-framework/profile.json")))

  (defun failures-file-path (source-root &optional custom-path)
    (if (and (= (value-type custom-path) "string") (> (js-length custom-path) 0))
      (resolve source-root custom-path)
      (resolve source-root ".eliscript-cache/test-framework/last-failures.json")))

  (defun empty-profile ()
    (js-object :format PROFILE_FORMAT :files (js-object)))

  (defun atomic-write-json (target payload)
    (let* ((dir (dirname target))
           (temp (join dir (str "." (basename target) "." (get globalThis.process :pid) "." (randomUUID) ".tmp"))))
      (try
        (progn
          (mkdirSync dir (js-object :recursive t))
          (writeFileSync temp (str (JSON/stringify payload nil 2) "\n") "utf8")
          (renameSync temp target)
          t)
        (catch _error false)
        (finally
          (when (existsSync temp)
            (try (unlinkSync temp) (catch _cleanup nil)))))))

  (defun loadTestProfile (source-root &optional custom-path)
    (let ((target (profile-file-path source-root custom-path)))
      (if (not (existsSync target))
        (empty-profile)
        (try
          (let ((parsed (JSON/parse (readFileSync target "utf8"))))
            (if (and parsed (= (get parsed :format) PROFILE_FORMAT)
                     (get parsed :files) (= (value-type (get parsed :files)) "object"))
              parsed
              (empty-profile)))
          (catch _error (empty-profile))))))

  (defun profile-key (file)
    (basename (funcall globalThis.String file)))

  (defun clamp-rss (value)
    (Math/max MIN_ESTIMATED_RSS_BYTES (Math/min MAX_ESTIMATED_RSS_BYTES (Math/round value))))

  (defun recordTestProfile (source-root results &optional custom-path)
    (let* ((target (profile-file-path source-root custom-path))
           (profile (loadTestProfile source-root custom-path))
           (files (get profile :files))
           (now (js-call (new globalThis.Date) :toISOString))
           (index 0))
      (when (Array/isArray results)
        (while (< index (js-length results))
          (let ((row (aref results index)))
            (when (and row (= (value-type (get row :file)) "string")
                       (not (eq (get row :started) false)))
              (let* ((key (profile-key (get row :file)))
                     (prev (aref files key))
                     (elapsed (get row :elapsedMs))
                     (peak-rss (get row :peakRssBytes))
                     (ok (and (= (get row :exitCode) 0) (not (funcall globalThis.Boolean (get row :failure)))))
                     (prev-elapsed (when (and prev (Number/isFinite (get prev :elapsedMs))) (get prev :elapsedMs)))
                     (prev-rss (when (and prev (Number/isFinite (get prev :peakRssBytes))) (get prev :peakRssBytes)))
                     (next-elapsed (if (and (Number/isFinite elapsed) (>= elapsed 0))
                                     (if prev-elapsed (Math/round (+ (* 0.7 elapsed) (* 0.3 prev-elapsed))) (Math/round elapsed))
                                     prev-elapsed))
                     (next-rss (if (and (Number/isFinite peak-rss) (> peak-rss 0))
                                 (if prev-rss (clamp-rss (+ (* 0.7 peak-rss) (* 0.3 prev-rss))) (clamp-rss peak-rss))
                                 prev-rss))
                     (runs (if (and prev (Number/isSafeInteger (get prev :runs))) (1+ (get prev :runs)) 1))
                     (entry (js-object :runs runs :status (if ok "passed" "failed") :updatedAt now)))
                (when (Number/isFinite next-elapsed) (put entry :elapsedMs next-elapsed))
                (when (Number/isFinite next-rss) (put entry :peakRssBytes next-rss))
                (put files key entry))))
          (setq index (1+ index))))
      (atomic-write-json target profile)
      profile))

  (defun estimateTestWeight (profile file static-fallback)
    (let* ((files (when profile (get profile :files)))
           (entry (when (and files (= (value-type file) "string")) (aref files (profile-key file))))
           (recorded (when entry (get entry :elapsedMs)))
           (fallback (if (and (Number/isFinite static-fallback) (>= static-fallback 0)) static-fallback 500)))
      (if (and (Number/isFinite recorded) (> recorded 0))
        (Math/round (+ (* 0.8 recorded) (* 0.2 fallback)))
        fallback)))

  (defun estimateTestRssBytes (profile file heavy &optional default-standard default-heavy)
    (let* ((files (when profile (get profile :files)))
           (entry (when (and files (= (value-type file) "string")) (aref files (profile-key file))))
           (recorded (when entry (get entry :peakRssBytes)))
           (std-bytes (if (and (Number/isFinite default-standard) (> default-standard 0)) default-standard DEFAULT_STANDARD_RSS_BYTES))
           (heavy-bytes (if (and (Number/isFinite default-heavy) (> default-heavy 0)) default-heavy DEFAULT_HEAVY_RSS_BYTES)))
      (if (and (Number/isFinite recorded) (> recorded 0))
        (clamp-rss recorded)
        (if heavy heavy-bytes std-bytes))))

  (defun loadLastFailures (source-root &optional suite custom-path)
    (let ((target (failures-file-path source-root custom-path)))
      (if (not (existsSync target))
        (js-array)
        (try
          (let ((parsed (JSON/parse (readFileSync target "utf8"))))
            (if (and parsed (= (get parsed :format) FAILURES_FORMAT)
                     (or (nullish? suite) (= (get parsed :suite) suite))
                     (Array/isArray (get parsed :failedFiles)))
              (js-call (get parsed :failedFiles) :filter (lambda (f) (= (value-type f) "string")))
              (js-array)))
          (catch _error (js-array))))))

  (defun saveLastFailures (source-root suite failed-files &optional custom-path)
    (let* ((target (failures-file-path source-root custom-path))
           (list (if (Array/isArray failed-files)
                   (js-call failed-files :filter (lambda (f) (= (value-type f) "string")))
                   (js-array)))
           (payload (js-object :format FAILURES_FORMAT :suite (or suite "default")
                      :updatedAt (js-call (new globalThis.Date) :toISOString) :failedFiles list)))
      (atomic-write-json target payload)
      target))

  (export PROFILE_FORMAT FAILURES_FORMAT DEFAULT_STANDARD_RSS_BYTES DEFAULT_HEAVY_RSS_BYTES
    loadTestProfile recordTestProfile estimateTestWeight estimateTestRssBytes
    loadLastFailures saveLastFailures))
