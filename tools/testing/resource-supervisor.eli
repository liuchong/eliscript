(module tools.testing.resource-supervisor
  (import "node:child_process" execFile fork spawn)
  (import "node:crypto" randomUUID)
  (import "node:url" fileURLToPath)

  ;; Limits remain per owned tree and per invocation, never across chats.
  (defconst TREE_RSS_LIMIT (* 8 1024 1024 1024))
  (defconst TOTAL_RSS_LIMIT TREE_RSS_LIMIT)
  (defconst SAMPLE_MS 75)
  (defconst GRACE_MS 150)
  (defconst PS_TIMEOUT_MS 3000)
  (defconst SNAPSHOT_ATTEMPTS 3)
  (defconst HEALTH_TIMEOUT_MS 12000)
  (defconst SELF (fileURLToPath (js* "import.meta.url")))
  (defconst GUARD_EXEC_ARGV (js-array "--max-old-space-size=64"))
  (defconst process-row (new globalThis.RegExp "^\\s*(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\d+)\\s+(\\S+\\s+\\S+\\s+\\d+\\s+\\d+:\\d+:\\d+\\s+\\d+)\\s+(.+)$"))
  (defconst spaces (new globalThis.RegExp "\\s+" "g"))
  (defconst split-spaces (new globalThis.RegExp "\\s+"))
  (defun truth (value) (funcall globalThis.Boolean value))
  (defun optional-field (value key) (if (nullish? value) undefined (get value key)))
  (defun default-undefined (value fallback) (if (undefined? value) fallback value))
  (defun null-default (value fallback) (if (nullish? value) fallback value))
  (defun lower-limit (value ceiling name)
    (let ((limit (if (undefined? value) ceiling (funcall globalThis.Number value))))
      (unless (and (Number/isSafeInteger limit) (>= limit 1) (<= limit ceiling))
        (throw (new globalThis.RangeError (str name " must be a positive integer no greater than " ceiling)))) limit))
  (defun resourceLimits (&rest arguments)
    (let ((options (default-undefined (aref arguments 0) (js-object))))
      (js-object :treeBytes (lower-limit (get options :treeBytes) TREE_RSS_LIMIT "tree RSS limit")
        :totalBytes (lower-limit (get options :totalBytes) TOTAL_RSS_LIMIT "total RSS limit"))))

  (defun parseProcessSnapshot (text)
    (let ((rows (new globalThis.Map)))
      (js-call (js-call text :split "\n") :forEach (lambda (line)
        (when (truth (js-call line :trim))
          (let ((match (js-call process-row :exec line)))
            (unless match (throw (new globalThis.Error "resource monitor received an invalid ps row")))
            (let ((row (js-object :pid (funcall globalThis.Number (aref match 1))
                        :ppid (funcall globalThis.Number (aref match 2))
                        :pgid (funcall globalThis.Number (aref match 3))
                        :rssBytes (* (funcall globalThis.Number (aref match 4)) 1024)
                        :birth (js-call (aref match 5) :replace spaces " ") :command (aref match 6))))
              (unless (and (js-call (js-array (get row :pid) (get row :ppid) (get row :pgid) (get row :rssBytes))
                              :every (lambda (number) (Number/isSafeInteger number)))
                           (>= (get row :pid) 1) (>= (get row :ppid) 0) (>= (get row :pgid) 0)
                           (>= (get row :rssBytes) 0) (not (js-call rows :has (get row :pid))))
                (throw (new globalThis.Error "resource monitor received invalid process data")))
              (js-call rows :set (get row :pid) row))))))
      (when (= (get rows :size) 0) (throw (new globalThis.Error "resource monitor received an empty process snapshot"))) rows))
  (defun collectOwnedProcesses (snapshot root &rest arguments)
    (let* ((known (default-undefined (aref arguments 0) (new globalThis.Map)))
           (owned (new globalThis.Map)) (current-root (js-call snapshot :get (get root :pid)))
           (root-matches (and current-root
             (js-call (js-call (get current-root :command) :split split-spaces) :includes (get root :token))
             (or (not (truth (get root :birth))) (= (get current-root :birth) (get root :birth)))
             (= (get current-root :pgid) (get root :pid)))))
      (when root-matches
        (when (nullish? (get root :birth)) (put root :birth (get current-root :birth)))
        (js-call owned :set (get root :pid) current-root))
      (js-call known :forEach (lambda (birth pid)
        (let ((row (js-call snapshot :get pid)))
          (when (and row (= (get row :birth) birth)) (js-call owned :set pid row)))))
      (when root-matches (js-call snapshot :forEach (lambda (row)
        (when (= (get row :pgid) (get root :pid)) (js-call owned :set (get row :pid) row)))))
      (let ((changed t))
        (while changed
          (setq changed false)
          (js-call snapshot :forEach (lambda (row)
            (when (and (not (js-call owned :has (get row :pid))) (js-call owned :has (get row :ppid)))
              (js-call owned :set (get row :pid) row) (setq changed t))))))
      (js-call owned :forEach (lambda (row) (js-call known :set (get row :pid) (get row :birth)))) owned))
  (defun evaluateResourceUsage (snapshot roots limits)
    (let ((total-bytes 0) (counted (new globalThis.Set)) (trees (js-array)))
      (js-call roots :forEach (lambda (root)
        (let ((owned (collectOwnedProcesses snapshot root (get root :known))) (rss-bytes 0))
          (js-call owned :forEach (lambda (row)
            (setq rss-bytes (+ rss-bytes (get row :rssBytes)))
            (unless (js-call counted :has (get row :pid))
              (setq total-bytes (+ total-bytes (get row :rssBytes))) (js-call counted :add (get row :pid)))))
          (js-call trees :push (js-object :id (get root :id) :file (get root :file) :rssBytes rss-bytes)))))
      (let ((exceeded (js-call trees :find (lambda (tree) (> (get tree :rssBytes) (get limits :treeBytes))))))
        (js-object :trees trees :totalBytes total-bytes :violation
          (cond (exceeded (Object/assign (js-object :kind "tree") exceeded (js-object :limitBytes (get limits :treeBytes))))
            ((> total-bytes (get limits :totalBytes)) (js-object :kind "aggregate" :rssBytes total-bytes :limitBytes (get limits :totalBytes)))
            (t nil))))))

  ;; This is an OS-command deadline, never a program or test deadline. Bad data
  ;; fails immediately. Only a proved command timeout may take another sample.
  (defun snapshot-error (error attempts)
    (Object/assign (new globalThis.Error (str "resource monitor unavailable: " (get error :message)) (js-object :cause error))
      (js-object :code (get error :code) :signal (get error :signal) :killed (get error :killed) :attempts attempts)))
  (defun snapshot-transient (error)
    (or (= (get error :code) "ETIMEDOUT") (and (= (get error :killed) t) (= (get error :signal) "SIGTERM"))))
  (defun readProcessSnapshot (&rest arguments)
    (let* ((options (default-undefined (aref arguments 0) (js-object)))
           (execute (default-undefined (get options :execute) execFile))
           (pid (default-undefined (get options :pid) (get globalThis.process :pid))))
      (new globalThis.Promise (lambda (resolve reject)
        (let ((attempts 0))
          (letfn ((attempt ()
            (setq attempts (1+ attempts))
            (try
              (funcall execute "ps" (js-array "-axo" "pid=,ppid=,pgid=,rss=,lstart=,args=")
                (js-object :encoding "utf8" :timeout PS_TIMEOUT_MS :maxBuffer (* 16 1024 1024))
                (lambda (error stdout)
                  (if error
                    (if (and (snapshot-transient error) (< attempts SNAPSHOT_ATTEMPTS))
                      (funcall globalThis.setTimeout attempt SAMPLE_MS)
                      (funcall reject (snapshot-error error attempts)))
                    (try
                      (let ((rows (parseProcessSnapshot stdout)))
                        (unless (js-call rows :has pid) (throw (new globalThis.Error "resource monitor cannot see its own process")))
                        (funcall resolve rows))
                      (catch failure (funcall reject (snapshot-error failure attempts)))))))
              (catch failure (funcall reject (snapshot-error failure attempts))))))
            (attempt)))))))
  (defun monitor-outcome (error)
    (js-object :failure "monitor-unavailable" :exitCode 1 :message (get error :message)
      :code (get error :code) :signal (get error :signal) :killed (get error :killed) :attempts (get error :attempts)))
  (defun send (target message)
    (if (not (get target :connected)) false
      (try (progn (js-call target :send message (lambda () nil)) t) (catch error false))))
  (defun send-confirmed (target message)
    (new globalThis.Promise (lambda (resolve)
      (if (not (get target :connected)) (funcall resolve false)
        (try (js-call target :send message (lambda (error) (funcall resolve (not error))))
          (catch error (funcall resolve false)))))))
  (defun signal-pid (pid signal)
    (try (js-call globalThis.process :kill pid signal)
      (catch error (unless (= (get error :code) "ESRCH") (throw error)))))
  (defasync signal-owned (root signal &rest arguments)
    (let ((fallback-group (default-undefined (aref arguments 0) false))
          (include-root (default-undefined (aref arguments 1) t)) (rows nil))
      (try (setq rows (await (readProcessSnapshot)))
        (catch error
          (when (and fallback-group (= (get root :pid) (get globalThis.process :pid)))
            (signal-pid (- (get globalThis.process :pid)) signal)) (throw error)))
      (let* ((owned (collectOwnedProcesses rows root (get root :known))) (current-root (js-call owned :get (get root :pid))))
        (js-call owned :forEach (lambda (row)
          (unless (= (get row :pid) (get root :pid)) (signal-pid (get row :pid) signal))))
        (when (and include-root current-root (= (get current-root :pgid) (get root :pid)))
          (signal-pid (- (get root :pid)) signal)))))
  (defun start-sampling (sample fail)
    (let ((busy false) (stopped false) (timer nil))
      (setq timer (funcall globalThis.setInterval (async ()
        (unless (or busy stopped)
          (setq busy t)
          (try (await (funcall sample)) (catch error (funcall fail error)) (finally (setq busy false))))) SAMPLE_MS))
      (lambda () (setq stopped t) (funcall globalThis.clearInterval timer))))

  (defasync launcher-main (token)
    (let ((root (js-object :pid (get globalThis.process :pid) :token token :known (new globalThis.Map)))
          (child nil) (child-exited false) (stopping false) (stop-sampling (lambda () nil))
          (outcome undefined) (last-heartbeat (Date/now)) (heartbeat nil))
      (letfn ((kill-and-reap ()
                (funcall (async ()
                  (try (await (signal-owned root "SIGKILL" t false))
                    (catch error (signal-pid (- (get globalThis.process :pid)) "SIGKILL")))
                  (when (and child (not child-exited))
                    (await (new globalThis.Promise (lambda (resolve)
                      (let ((timeout (funcall globalThis.setTimeout resolve GRACE_MS)))
                        (js-call child :once "exit" (lambda () (funcall globalThis.clearTimeout timeout) (funcall resolve))))))))
                  (signal-pid (- (get globalThis.process :pid)) "SIGKILL"))))
              (finish (reason &rest arguments)
                (funcall (async ()
                  (unless stopping
                    (let ((signal (default-undefined (aref arguments 0) "SIGKILL")))
                      (setq stopping t) (funcall stop-sampling)
                      (when (nullish? outcome) (setq outcome reason))
                      (funcall globalThis.clearInterval heartbeat)
                      (await (send-confirmed globalThis.process (Object/assign (js-object) outcome (js-object :type "outcome"))))
                      (if (/= signal "SIGKILL")
                        (progn
                          (try (await (signal-owned root signal false false)) (catch error nil))
                          (funcall globalThis.setTimeout (lambda () (kill-and-reap)) GRACE_MS))
                        (await (kill-and-reap)))))))))
        (js-call globalThis.process :on "disconnect" (lambda () (finish (js-object :failure "guard-disconnected" :exitCode 1))))
        (js-call globalThis.process :on "SIGINT" (lambda () (finish (js-object :failure "cancelled" :exitCode 130) "SIGINT")))
        (js-call globalThis.process :on "SIGTERM" (lambda () (finish (js-object :failure "cancelled" :exitCode 143) "SIGTERM")))
        (js-call globalThis.process :on "message" (lambda (message)
          (cond
            ((= (optional-field message "type") "heartbeat") (setq last-heartbeat (Date/now)))
            ((= (optional-field message "type") "cancel") (finish (get message :outcome) (null-default (get message :signal) "SIGKILL")))
            ((and (= (optional-field message "type") "start") (not child) (not stopping))
              (let ((limits (resourceLimits (get message :limits))))
                (put root :id (get message :id)) (put root :file (get message :file))
                (try
                  (progn
                    (setq child (spawn (get message :command) (get message :args)
                      (js-object :cwd (get message :cwd) :env (get message :env) :stdio (js-array "ignore" "inherit" "inherit"))))
                    (js-call child :once "error" (lambda (error) (finish (js-object :failure "spawn-error" :message (get error :message) :exitCode 1))))
                    (js-call child :once "exit" (lambda (code signal)
                      (setq child-exited t)
                      (finish (js-object :exitCode (null-default code (cond ((= signal "SIGINT") 130) ((= signal "SIGTERM") 143) (t 1))) :signal signal))))
                    (setq stop-sampling (start-sampling (async ()
                      (let* ((rows (await (readProcessSnapshot))) (usage (evaluateResourceUsage rows (js-array root) limits)))
                        (when (get usage :violation) (await (finish (js-object :failure "resource-limit" :exitCode 1 :resource (get usage :violation)))))))
                      (lambda (error) (finish (monitor-outcome error)))))
                    (send globalThis.process (js-object :type "running" :pid (get child :pid))))
                  (catch error (finish (js-object :failure "spawn-error" :exitCode 1 :message (get error :message))))))))))
        (setq heartbeat (funcall globalThis.setInterval (lambda ()
          (when (> (- (Date/now) last-heartbeat) HEALTH_TIMEOUT_MS)
            (finish (js-object :failure "monitor-unavailable" :exitCode 1 :message "central resource guard stopped responding")))) SAMPLE_MS))
        (await (readProcessSnapshot))
        (send globalThis.process (js-object :type "launcher-ready" :pid (get globalThis.process :pid) :token token)))))

  (defasync supervisor-main ()
    (let ((active (new globalThis.Map)) (limits nil) (stopped false) (stop-sampling (lambda () nil)) (heartbeat nil))
      (letfn ((stop-all (outcome &rest arguments)
        (funcall (async ()
          (unless stopped
            (let ((signal (default-undefined (aref arguments 0) "SIGKILL")))
              (setq stopped t) (funcall stop-sampling) (funcall globalThis.clearInterval heartbeat)
              (send globalThis.process (Object/assign (js-object) outcome (js-object :type "fatal")))
              (js-call active :forEach (lambda (entry)
                (when (nullish? (get entry :outcome)) (put entry :outcome outcome))
                (send (get entry :guard) (js-object :type "cancel" :outcome outcome :signal signal))))
              (funcall globalThis.setTimeout (async ()
                (let ((entries (Array/from (js-call active :values))) (index 0))
                  (while (< index (js-length entries))
                    (let ((entry (aref entries index)))
                      (try (await (signal-owned (get entry :root) "SIGKILL")) (catch error nil))
                      (when (get (get entry :guard) :connected) (js-call (get entry :guard) :disconnect)))
                    (setq index (1+ index))))
                (when (= (get active :size) 0)
                  (js-call globalThis.process :exit (if (truth (get outcome :exitCode)) (get outcome :exitCode) 1))))
                (if (= signal "SIGKILL") SAMPLE_MS (+ GRACE_MS SAMPLE_MS)))))))))
        (js-call globalThis.process :on "disconnect" (lambda () (stop-all (js-object :failure "runner-disconnected" :exitCode 1))))
        (js-call globalThis.process :on "SIGINT" (lambda () (stop-all (js-object :failure "cancelled" :exitCode 130) "SIGINT")))
        (js-call globalThis.process :on "SIGTERM" (lambda () (stop-all (js-object :failure "cancelled" :exitCode 143) "SIGTERM")))
        (js-call globalThis.process :on "message" (lambda (message)
          (cond
            ((and (= (optional-field message "type") "init") (not limits))
              (try
                (progn
                  (setq limits (resourceLimits (get message :limits)))
                  ;; IPC liveness is independent of successful memory samples.
                  ;; A failed bounded sample still calls stop-all immediately.
                  (setq heartbeat (funcall globalThis.setInterval (lambda ()
                    (unless stopped
                      (js-call active :forEach (lambda (entry) (send (get entry :guard) (js-object :type "heartbeat"))))
                      (send globalThis.process (js-object :type "health")))) SAMPLE_MS))
                  (js-call (readProcessSnapshot) :then (lambda ()
                    (unless stopped
                      (setq stop-sampling (start-sampling (async ()
                        (let* ((rows (await (readProcessSnapshot)))
                               (roots (js-call (js-call (Array/from (js-call active :values)) :filter (lambda (entry) (get entry :running)))
                                        :map (lambda (entry) (get entry :root))))
                               (usage (evaluateResourceUsage rows roots limits)))
                          (when (get usage :violation)
                            (await (stop-all (js-object :failure "resource-limit" :exitCode 1 :resource (get usage :violation)))))))
                        (lambda (error) (stop-all (monitor-outcome error)))))
                      (send globalThis.process (js-object :type "ready"))))
                    (lambda (error) (stop-all (monitor-outcome error)))))
                (catch error (stop-all (js-object :failure "invalid-resource-limit" :message (get error :message) :exitCode 1)))))
            ((and (= (optional-field message "type") "run") limits (not stopped))
              (let* ((token (randomUUID))
                     (guard (fork SELF (js-array "--launcher" token) (js-object :detached t :execPath (get globalThis.process :execPath)
                       :execArgv GUARD_EXEC_ARGV :stdio (js-array "ignore" "inherit" "inherit" "ipc"))))
                     (entry (js-object :guard guard :request message :root (js-object :id (get message :id) :file (get message :file)
                       :pid (get guard :pid) :token token :known (new globalThis.Map)))))
                (js-call active :set (get message :id) entry)
                (js-call guard :on "message" (lambda (data)
                  (cond
                    ((= (optional-field data "type") "launcher-ready")
                      (send globalThis.process (js-object :type "owned" :id (get message :id) :pid (get guard :pid) :token token)))
                    ((= (optional-field data "type") "running")
                      (put entry :running t) (send globalThis.process (js-object :type "started" :id (get message :id) :pid (get data :pid))))
                    ((= (optional-field data "type") "outcome")
                      (let ((outcome (Object/assign (js-object) data)))
                        (Reflect/deleteProperty outcome "type") (put entry :outcome outcome)
                        (when (or (= (get data :failure) "resource-limit") (= (get data :failure) "monitor-unavailable")) (stop-all outcome)))))))
                (js-call guard :once "error" (lambda (error)
                  (put entry :outcome (js-object :failure "guard-start-failed" :message (get error :message) :exitCode 1))
                  (stop-all (get entry :outcome))))
                (js-call guard :once "exit" (async ()
                  (try (await (signal-owned (get entry :root) "SIGKILL")) (catch error nil))
                  (js-call active :delete (get message :id))
                  (let ((outcome (null-default (get entry :outcome) (js-object :failure "guard-exited" :exitCode 1))))
                    (unless (get entry :outcome) (await (stop-all outcome)))
                    (await (send-confirmed globalThis.process (Object/assign (js-object) outcome (js-object :type "result" :id (get message :id)))))
                    (when (and stopped (= (get active :size) 0)) (js-call globalThis.process :exit 1)))))))
            ((and (= (optional-field message "type") "ack") (not stopped))
              (let ((entry (js-call active :get (get message :id))))
                (when entry (send (get entry :guard) (Object/assign (js-object) (get entry :request) (js-object :type "start" :limits limits))))))
            ((= (optional-field message "type") "cancel") (stop-all (get message :outcome) (get message :signal)))
            ((= (optional-field message "type") "close")
              (if (> (get active :size) 0) (stop-all (js-object :failure "guard-closed-with-active-tests" :exitCode 1))
                (progn (funcall stop-sampling) (funcall globalThis.clearInterval heartbeat) (js-call globalThis.process :exit 0))))))))))

  (defasync startResourceSupervisor (&rest arguments)
    (let* ((options (default-undefined (aref arguments 0) (js-object)))
           (limits (resourceLimits (null-default (get options :limits) (js-object
             :treeBytes (get (get globalThis.process :env) :ELISCRIPT_TEST_TREE_RSS_BYTES)
             :totalBytes (get (get globalThis.process :env) :ELISCRIPT_TEST_TOTAL_RSS_BYTES)))))
           (guard (fork SELF (js-array "--supervisor") (js-object :execPath (null-default (get options :node) "node")
             :execArgv GUARD_EXEC_ARGV :stdio (js-array "ignore" "inherit" "inherit" "ipc"))))
           (pending (new globalThis.Map)) (owned (new globalThis.Map))
           (failure nil) (closing false) (ready-resolve nil) (ready-reject nil) (exited-resolve nil)
           (last-health (Date/now)) (health-timer nil)
           (ready (new globalThis.Promise (lambda (resolve reject) (setq ready-resolve resolve) (setq ready-reject reject))))
           (exited (new globalThis.Promise (lambda (resolve) (setq exited-resolve resolve)))))
      (letfn ((fail (outcome)
        (when (nullish? failure) (setq failure outcome))
        (funcall ready-reject (new globalThis.Error (null-default (get outcome :message) (get outcome :failure))))
        (when (truth (get options :onFailure)) (funcall (get options :onFailure) failure))))
        (js-call guard :on "message" (lambda (message)
          (setq last-health (Date/now))
          (cond
            ((= (optional-field message "type") "ready") (funcall ready-resolve))
            ((= (optional-field message "type") "owned")
              (js-call owned :set (get message :id) (js-object :pid (get message :pid) :token (get message :token) :known (new globalThis.Map)))
              (send guard (js-object :type "ack" :id (get message :id))))
            ((= (optional-field message "type") "started") (when (truth (get options :onStart)) (funcall (get options :onStart) message)))
            ((= (optional-field message "type") "fatal") (fail message))
            ((= (optional-field message "type") "result")
              (let ((resolve (js-call pending :get (get message :id))))
                (js-call pending :delete (get message :id)) (js-call owned :delete (get message :id))
                (when (truth resolve) (funcall resolve message)))))))
        (js-call guard :once "error" (lambda (error)
          (funcall globalThis.clearInterval health-timer)
          (fail (js-object :failure "guard-start-failed" :exitCode 1 :message (get error :message))) (funcall exited-resolve)))
        (js-call guard :once "exit" (async (code signal)
          (funcall globalThis.clearInterval health-timer)
          (when (or (not closing) (> (get pending :size) 0) (/= code 0))
            (fail (js-object :failure "guard-exited" :exitCode 1 :code code :signal signal)))
          (let ((roots (Array/from (js-call owned :values))) (index 0))
            (while (< index (js-length roots))
              (try (await (signal-owned (aref roots index) "SIGKILL")) (catch error nil))
              (setq index (1+ index))))
          (when (> (get owned :size) 0)
            (await (new globalThis.Promise (lambda (resolve) (funcall globalThis.setTimeout resolve (+ GRACE_MS (* SNAPSHOT_ATTEMPTS (+ PS_TIMEOUT_MS SAMPLE_MS))))))))
          (js-call pending :forEach (lambda (resolve) (funcall resolve (null-default failure (js-object :failure "guard-exited" :exitCode 1)))))
          (js-call pending :clear) (funcall exited-resolve)))
        (setq health-timer (funcall globalThis.setInterval (lambda ()
          (when (> (- (Date/now) last-health) HEALTH_TIMEOUT_MS)
            (fail (js-object :failure "monitor-unavailable" :exitCode 1 :message "external resource guard stopped responding"))
            (js-call guard :kill "SIGKILL"))) SAMPLE_MS))
        (send guard (js-object :type "init" :limits limits))
        (await ready)
        (let ((result (js-object
          :run (lambda (request)
            (if (or failure closing) (Promise/resolve (null-default failure (js-object :failure "guard-closed" :exitCode 1)))
              (progn
                (when (js-call pending :has (get request :id)) (throw (new globalThis.Error "duplicate supervised test id")))
                (new globalThis.Promise (lambda (resolve)
                  (js-call pending :set (get request :id) resolve)
                  (unless (send guard (Object/assign (js-object :type "run") request))
                    (js-call pending :delete (get request :id)) (fail (js-object :failure "guard-disconnected" :exitCode 1))
                    (funcall resolve failure)))))))
          :cancel (lambda (&rest arguments)
            (let* ((signal (default-undefined (aref arguments 0) "SIGTERM"))
                   (outcome (js-object :failure "cancelled" :exitCode (if (= signal "SIGINT") 130 143))))
              (when (nullish? failure) (setq failure outcome)) (send guard (js-object :type "cancel" :signal signal :outcome outcome))))
          :close (async () (setq closing t) (send guard (js-object :type "close")) (await exited)) :pid (get guard :pid))))
          (Object/defineProperty result "failure" (js-object :get (lambda () failure) :enumerable t :configurable t)) result))))

  (defasync run-private-entry ()
    (let ((operation (aref (get globalThis.process :argv) 2)))
      (try
        (cond ((= operation "--supervisor") (await (supervisor-main)))
          ((and (= operation "--launcher") (truth (aref (get globalThis.process :argv) 3)))
            (await (launcher-main (aref (get globalThis.process :argv) 3))))
          (t (throw (new globalThis.Error "resource supervisor requires its private IPC entry point"))))
        (catch error
          (await (send-confirmed globalThis.process (Object/assign (monitor-outcome error) (js-object :type "fatal"))))
          (js-call globalThis.console :error (str "[resource-monitor] " (get error :message)))
          (js-call globalThis.process :exit 1)))))
  (when (= (aref (get globalThis.process :argv) 1) SELF)
    (js-call (run-private-entry) :catch
      (lambda (error)
        (js-call globalThis.console :error error)
        (put globalThis.process :exitCode 1))))
  (export TREE_RSS_LIMIT TOTAL_RSS_LIMIT SAMPLE_MS resourceLimits parseProcessSnapshot collectOwnedProcesses evaluateResourceUsage readProcessSnapshot startResourceSupervisor))
