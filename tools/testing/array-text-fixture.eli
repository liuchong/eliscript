(module tools.testing.array-text-fixture
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (defun arrayTextMeasuredSource (root source)
    (let ((identity (js-call (js-call (createHash "sha256") :update source) :digest "hex")))
      ;; Both official current producers emit the same body: the Seed writer
      ;; appends its exact source-map coordinate; certified stage3 retains the
      ;; body without that trailer. Neither arbitrary edits nor added LF pass.
      (unless (or (= identity "8bd4ac0ca7f5d8077131c7e226299b7a14378cb6619d8be0ae9b3fe0a7832528")
                  (= identity "2d7bf169b3594280836550151222b93c1cfabcb1f530e5a1a439ed671acf8e8b"))
        (throw (new globalThis.TypeError "original measured array text source identity changed"))))
    ;; A data URL has no package/relative base. Preserve every algorithm byte;
    ;; rewrite only the two authenticated imports to actual runtime file URLs.
    (let ((output source))
      (js-call (js-array (js-array "./number-radix.mjs" "runtime/number-radix.mjs")
                        (js-array "eliscript/runtime/errors.mjs" "runtime/errors.mjs"))
        :forEach (lambda (entry)
          (let ((literal (JSON/stringify (aref entry 0))))
            (unless (= (js-length (js-call output :split literal)) 2)
              (throw (new globalThis.TypeError "original measured array text dependency is absent or ambiguous")))
            (setq output (js-call output :replace literal
              (JSON/stringify (get (pathToFileURL (resolve root (aref entry 1))) :href)))))))
      output))
  (export arrayTextMeasuredSource))
