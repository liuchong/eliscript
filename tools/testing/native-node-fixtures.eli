(module tools.testing.native-node-fixtures
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "node:buffer" Buffer)
  (import "../backends/build.mjs" root)
  (defconst nativeBoundaryTitle "Node native memory validates the original ABI and restores native trap classes before recovery")
  (defconst nativePacketsTitle "the real native loader consumes multiple packets and closes only after complete requests")
  (defconst target (if (= (get globalThis.process :arch) "arm64")
    (cond ((= (get globalThis.process :platform) "darwin") "arm64-macos")
      ((= (get globalThis.process :platform) "linux") "arm64-linux") (t undefined)) undefined))
  (defconst signatures (js-object :read32 1 :write32 2 :grow 1 :notify 2 :spin 2))
  (defconst capabilities (js-array (js-object :name "source-operation" :module "eliscript.host" :arity 2 :abi "managed-host-call-v1")))
  (defun libraryPath (directory) (resolve directory (if (= target "arm64-macos") "memory.dylib" "memory.so")))
  (defun runNativeBoundary (directory)
    (let* ((configuration (js-object :initialPages 1 :maximumPages 8 :nativeTarget target
              :bunExecutable (get globalThis.process :execPath) :hostCapabilities capabilities))
           (result (spawnSync (get (get globalThis.process :env) :NODE)
             (js-array (resolve root "tests/helpers/native-node-boundaries.mjs") (libraryPath directory)
               (JSON/stringify signatures) (JSON/stringify configuration))
             (js-object :cwd directory :encoding "utf8" :timeout 30000
               :env (Object/assign (js-object) (get globalThis.process :env) (js-object :NODE_OPTIONS "" :BUN_OPTIONS ""))))))
      (js-call assert :strictEqual (get result :error) undefined (get result :stderr))
      (js-call assert :strictEqual (get result :status) 0 (str (get result :stderr) (get result :stdout)))
      (js-call assert :strictEqual (get result :stdout) "native-node-verified\n")))
  (defun runNativePackets (directory)
    (let* ((configuration (js-object :initialPages 1 :maximumPages 8 :nativeTarget target :hostCapabilities capabilities))
           (messages (js-array (js-object :id 1 :method "open" :args (js-array (libraryPath directory) signatures configuration))
             (js-object :id 2 :method "invoke" :args (js-array "write32" 3 4275878552))
             (js-object :id 3 :method "invoke" :args (js-array "read32" 3))
             (js-object :id 4 :method "read" :args (js-array 3 4))
             (js-object :id 5 :method "close" :args (js-array))))
           (input (js-call (js-call messages :map (lambda (message) (str (JSON/stringify message) "\n"))) :join ""))
           (result (spawnSync (get globalThis.process :execPath) (js-array (resolve root "tools/backends/native-node-runner.mjs"))
             (js-object :cwd directory :input input :encoding "utf8" :timeout 30000
               :env (Object/assign (js-object) (get globalThis.process :env) (js-object :NODE_OPTIONS "" :BUN_OPTIONS ""))))))
      (js-call assert :strictEqual (get result :error) undefined (get result :stderr))
      (js-call assert :strictEqual (get result :status) 0 (get result :stderr))
      (js-call assert :deepStrictEqual (js-call (js-call (js-call (get result :stdout) :trim) :split "\n") :map (lambda (line) (JSON/parse line)))
        (js-array (js-object :ready t) (js-object :id 1 :result t) (js-object :id 2 :result 0)
          (js-object :id 3 :result 4275878552)
          (js-object :id 4 :result (js-call (js-call Buffer :from (js-array 152 186 220 254)) :toString "base64"))
          (js-object :id 5 :result nil)))))
  (export nativeBoundaryTitle nativePacketsTitle runNativeBoundary runNativePackets))
