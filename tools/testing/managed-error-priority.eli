(module tools.testing.managed-error-priority
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "../backends/build.mjs" root)
  (import "../backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../../tests/helpers/managed-browser-transport.mjs" loadManagedReference)
  (defun box (a value)
    (cond ((= (value-type value) "number") (js-call a :number value))
      ((= (value-type value) "string") (js-call a :string value)) (t value)))
  (defun array (a values)
    (let ((items (js-call values :map (lambda (value) (box a value)))))
      (try (js-call a :sourceArray items)
        (finally (js-call items :forEach (lambda (value) (js-call a :release value)))))))
  (defun read (a value)
    (cond ((or (nullish? value) (/= (value-type value) "object")) value)
      ((= (get value :kind) 4) (js-call a :readNumber value))
      ((= (get value :kind) 5) (js-call a :readString value))
      (t (js-call assert :strictEqual (get value :kind) 14)
        (let ((result (js-array)) (index 0))
          (while (< index (js-call a :length value))
            (let ((child (js-call a :get value index)))
              (try (js-call result :push (read a child)) (finally (js-call a :release child))))
            (setq index (1+ index))) result))))
  (defun get-field (a target name)
    (let ((key (js-call a :string name)) (value undefined))
      (try (setq value (js-call a :objectGet target key)) (read a value)
        (finally (js-call a :release value) (js-call a :release key)))))
  (defun diagnostic (code)
    (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) code)))
  (defun release (a values)
    (js-call values :forEach (lambda (value) (js-call a :release value))))
  (defun finish (a)
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (defasync context (backend runtime program)
    (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
           (before (JSON/stringify program))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (try
        (js-call assert :strictEqual (JSON/stringify program) before)
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (let* ((reference (await (loadManagedReference (get fixture :directory)
                            (js-call (get backend :compiler) :emit_ir_string program) "error-priority")))
               (a (instantiateManagedRuntime bytes)))
          (js-call a :auto 1) (js-object :fixture fixture :a a :js reference))
        (catch error (js-call fixture :close) (throw error)))))
  (defasync assertSortErrorPriority (backend runtime)
    (let* ((source "(defconst marker 1) (defun f (items) (js-call items :sort (lambda (a b) (put items 0 99) (js-call nil :charAt 0)))) (defun recover (items) (js-call items :sort)) (export f recover)")
           (program (js-call (get backend :compiler) :compile_ir_string source "array-sort.eli"))
           (c (await (context backend runtime program))) (a (get c :a)) (js (get c :js))
           (values (js-array 3 2 1)) (input (array a values)) (caller (js-call a :frame 1)) (out undefined))
      (try
        (js-call a :frameSet caller 0 input)
        (js-call assert :throws (lambda () (js-call js :f values)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call a :invoke "f" (js-array input))) (diagnostic "ELI-RT0001"))
        (js-call assert :deepStrictEqual (read a input) values)
        (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
        (setq out (js-call a :invoke "recover" (js-array input)))
        (js-call assert :deepStrictEqual (read a out) (js-call js :recover values))
        (finally (js-call a :leaveFrame caller) (release a (js-array out input))
          (finish a) (js-call (get c :fixture) :close)))))
  (defasync assertConcatErrorPriority (backend family)
    (let* ((array? (= family "array")) (compiler (get backend :compiler))
           (source (str "(defconst marker 1) (defun f (items other) (js-call items :concat other))"
             " (defun fail-first (items) (js-call items :concat (js-call nil :charAt))) (export f fail-first)"))
           (program (js-call compiler :compile_ir_string source "concat.eli"))
           (text (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
           (anchor (if array? "(setq result (value-array-new heap total))" "  (defun value-string-concat (heap "))
           (start (js-call text :indexOf anchor (if array? (js-call text :indexOf "  (defun value-sequence-concat ") 0)))
           (end (if array? (+ start (js-length anchor)) (js-call text :indexOf "  (defun " (+ start 10)))))
      (js-call assert :ok (and (>= start 0) (> end start)))
      (let* ((faulty (str (js-call text :slice 0 start)
                     (if array? "(setq result (load-u32 4294967295))"
                       "  (defun value-string-concat (heap left right) (load-u32 4294967295))\n") (js-call text :slice end)))
             (runtime (js-call compiler :compile_ir_string faulty "concat-trap.eli"))
             (c (await (context backend runtime program))) (a (get c :a)) (js (get c :js))
             (input (if array? (array a (js-array t false)) (js-call a :string "中😀")))
             (other (if array? (array a (js-array undefined)) (js-call a :string "x")))
             (caller (js-call a :frame 1)))
        (try
          (js-call a :frameSet caller 0 input)
          (js-call assert :throws (lambda () (js-call a :invoke "f" (js-array input other))) globalThis.WebAssembly.RuntimeError)
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :deepStrictEqual (read a input) (if array? (js-array t false) "中😀"))
          (js-call assert :throws (lambda () (js-call js :fail_first (if array? (js-array t false) "中😀"))) globalThis.TypeError)
          (js-call assert :throws (lambda () (js-call a :invoke "fail-first" (js-array input))) (diagnostic "ELI-RT0001"))
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (finally (js-call a :leaveFrame caller) (release a (js-array input other))
            (finish a) (js-call (get c :fixture) :close))))))
  (defasync assertTextMethodErrorPriority (backend runtime program)
    (let* ((c (await (context backend runtime program))) (a (get c :a)) (js (get c :js))
           (methods (js-array "at" "charAt" "charCodeAt" "codePointAt" "substring" "startsWith" "endsWith" "repeat" "trim" "trimStart"
             "trimEnd" "isWellFormed" "toWellFormed" "valueOf" "substr" "toUpperCase" "toLowerCase" "padStart" "padEnd" "split")))
      (try
        (let ((index 0))
          (while (< index (js-length methods))
            (let* ((empty (js-call a :string "")) (trace (js-call a :sourceObject (js-object :events empty)))
                   (name (js-call a :string (aref methods index))) (receiver (js-call a :invoke "receiver" (js-array trace name)))
                   (out (js-call a :invoke (str "ordinary-" index) (js-array receiver trace)))
                   (js-trace (js-object :events "")) (js-receiver (js-call js :receiver js-trace (aref methods index))))
              (try
                (js-call assert :deepStrictEqual (read a out) (Reflect/apply (get js (str "ordinary_" index)) undefined (js-array js-receiver js-trace)))
                (js-call assert :strictEqual (get-field a trace "events") (get js-trace :events))
                (js-call assert :strictEqual (get js-trace :events) "abco")
                (finally (release a (js-array empty trace name receiver out)) (js-call a :collect))))
            (setq index (1+ index))))
        (js-call (js-array (js-object) (js-object :split nil) (js-object :split false) (js-object :split 7)) :forEach (lambda (value)
          (let* ((roots (Object/fromEntries (js-call (Object/entries value) :map (lambda (entry) (js-array (aref entry 0) (box a (aref entry 1)))))))
                 (receiver (js-call a :sourceObject roots)) (empty (js-call a :string "")) (trace (js-call a :sourceObject (js-object :events empty)))
                 (js-trace (js-object :events "")))
            (try
              (js-call assert :throws (lambda () (js-call js :ordinary_19 (Object/assign (js-object) value) js-trace)) globalThis.TypeError)
              (js-call assert :throws (lambda () (js-call a :invoke "ordinary-19" (js-array receiver trace))) (diagnostic "ELI-RT0003"))
              (js-call assert :strictEqual (get-field a trace "events") (get js-trace :events))
              (js-call assert :strictEqual (get js-trace :events) "abc")
              (finally (release a (js-call (Object/values roots) :concat (js-array receiver empty trace))) (js-call a :collect))))))
        (js-call (js-array nil undefined) :forEach (lambda (receiver)
          (let* ((empty (js-call a :string "")) (trace (js-call a :sourceObject (js-object :events empty))) (js-trace (js-object :events "")))
            (try
              (js-call assert :throws (lambda () (js-call js :ordinary_19 receiver js-trace)) globalThis.TypeError)
              (js-call assert :throws (lambda () (js-call a :invoke "ordinary-19" (js-array receiver trace))) (diagnostic "ELI-RT0001"))
              (js-call assert :strictEqual (get-field a trace "events") (get js-trace :events))
              (js-call assert :strictEqual (get js-trace :events) "")
              (finally (release a (js-array empty trace)) (js-call a :collect))))))
        (finally (finish a) (js-call (get c :fixture) :close)))))
  (export assertSortErrorPriority assertConcatErrorPriority assertTextMethodErrorPriority))
