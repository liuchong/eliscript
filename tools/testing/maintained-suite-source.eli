(module tools.testing.maintained-suite-source
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../../dist/bootstrap/reader.mjs" read-string)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)

  (defun maintainedSuiteSource (root suite artifact)
    ;; The caller authenticates the complete emitted artifact against its
    ;; fixed digest. Bind its maintained input too, rather than guessing which
    ;; old JavaScript formatting happened to describe the same operation.
    (unless (and (= (value-type suite) "string") (js-call suite :endsWith ".mjs")
                 (= artifact (readFileSync (resolve root suite) "utf8")))
      (throw (new globalThis.TypeError "maintained suite requires the complete current artifact")))
    (let* ((file (str (js-call suite :slice 0 -4) ".eli"))
           (source (readFileSync (resolve root file) "utf8"))
           (map (JSON/parse (readFileSync (resolve root (str suite ".map")) "utf8"))))
      (unless (and (Array/isArray (get map :sourcesContent))
                   (= (js-length (js-call (get map :sourcesContent) :filter (lambda (text) (= text source)))) 1))
        (throw (new globalThis.TypeError "maintained suite differs from the artifact source map")))
      source))

  (defun sourceFormText (source node)
    (let ((span (get node :span)))
      (js-call (js-call (Array/from source) :slice (get span :start) (get span :end)) :join "")))

  (defun sourceCall (node name)
    (let ((items (get node :items)))
      (and (Array/isArray items) (> (js-length items) 0) (= (get (aref items 0) :name) name))))

  (defun rewriteSourceForms (source select)
    (let* ((pending (js-call (read-string source "maintained-suite.eli") :slice))
           (changes (js-array)) (points (Array/from source))
           (node-text (lambda (node)
             (let ((span (get node :span)))
               (js-call (js-call points :slice (get span :start) (get span :end)) :join "")))))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :pop)) (replacement (funcall select node node-text)))
          (if (undefined? replacement)
            (when (Array/isArray (get node :items)) (Reflect/apply (get pending :push) pending (get node :items)))
            (progn
              (unless (= (value-type replacement) "string")
                (throw (new globalThis.TypeError "source projection must replace a complete form with source text")))
              (js-call changes :push (js-object :start (get (get node :span) :start)
                :end (get (get node :span) :end) :replacement replacement))))))
      (js-call changes :sort (lambda (a b) (- (get b :start) (get a :start))))
      (let ((end (js-length points)) (pieces (js-array)))
        (js-call changes :forEach (lambda (change)
          (unless (<= (get change :end) end)
            (throw (new globalThis.TypeError "source projection regions overlap")))
          (js-call pieces :push (js-call (js-call points :slice (get change :end) end) :join "") (get change :replacement))
          (setq end (get change :start))))
        (js-call pieces :push (js-call (js-call points :slice 0 end) :join ""))
        (js-object :source (js-call (js-call pieces :reverse) :join "") :changes changes))))

  (defun compileMaintainedSuite (source suite imports)
    ;; Add imports inside the existing module. The official compiler owns all
    ;; emitted algorithms, lexical scopes, helpers and escaping.
    (let* ((forms (read-string source suite)) (module (aref forms 0))
           (items (get module :items)))
      (unless (and (= (js-length forms) 1) (sourceCall module "module") (> (js-length items) 1))
        (throw (new globalThis.TypeError "maintained suite requires one complete module")))
      (let* ((points (Array/from source)) (at (get (get (aref items 1) :span) :end))
             (text (str (js-call (js-call points :slice 0 at) :join "") "\n" imports "\n"
                     (js-call (js-call points :slice at) :join ""))))
        (compile-string text suite))))
  (defun maintainedLiteralBinding (root suite artifact name)
    ;; Read literal fixture data from the authenticated maintained AST. Emitted
    ;; whitespace, identifier spelling and quote style are not source syntax.
    (let* ((source (maintainedSuiteSource root suite artifact))
           (pending (js-call (read-string source suite) :slice)) (matches (js-array))
           (bindings (new globalThis.Map)) (active (new globalThis.Set)))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :shift)) (items (get node :items)))
          (cond
            ((sourceCall node "module") (Reflect/apply (get pending :push) pending (js-call items :slice 2)))
            ((or (sourceCall node "defconst") (sourceCall node "defvar"))
             (let ((key (get (aref items 1) :name)))
               (when (js-call bindings :has key)
                 (throw (new globalThis.TypeError "maintained fixture has duplicate data bindings")))
               (js-call bindings :set key (aref items 2))
               (when (= key name) (js-call matches :push (aref items 2))))))))
      (unless (= (js-length matches) 1)
        (throw (new globalThis.TypeError (str "maintained fixture requires one literal binding: " name))))
      (letfn ((literal (node)
                (let ((value (get node :value)) (items (get node :items)) (key (get node :name)))
                  (cond
                    ((= (value-type value) "string") value)
                    ((and (= (get node :kind) "symbol") (js-call bindings :has key))
                     (when (js-call active :has key)
                       (throw (new globalThis.TypeError "maintained fixture data bindings form a cycle")))
                     (js-call active :add key)
                     (try (literal (js-call bindings :get key)) (finally (js-call active :delete key))))
                    ((sourceCall node "js-array")
                     (js-call (js-call items :slice 1) :map literal))
                    ((or (sourceCall node "str") (sourceCall node "+"))
                     (let ((parts (js-call (js-call items :slice 1) :map literal)))
                       (unless (js-call parts :every (lambda (part) (= (value-type part) "string")))
                         (throw (new globalThis.TypeError "maintained fixture concatenation requires literal strings")))
                       (js-call parts :join "")))
                    ((and (sourceCall node "js-call") (= (js-length items) 4)
                          (= (get (aref items 2) :kind) "keyword") (= (get (aref items 2) :name) "join"))
                     (let ((parts (literal (aref items 1))) (separator (literal (aref items 3))))
                       (unless (and (Array/isArray parts) (= (value-type separator) "string"))
                         (throw (new globalThis.TypeError "maintained fixture join requires literal string data")))
                       (js-call parts :join separator)))
                    (t (throw (new globalThis.TypeError "maintained fixture binding is not complete literal source data")))))))
        (let ((result (literal (aref matches 0))))
          (unless (= (value-type result) "string")
            (throw (new globalThis.TypeError "maintained fixture requires complete string source data"))) result))))
  (defun sourceRuntimeFileImports (root javascript)
    ;; Relocate only compiler-owned runtime coordinates for an in-memory host
    ;; script. The caller authenticates its complete maintained source first.
    (js-call javascript :replace
      (new globalThis.RegExp "(^import\\s+(?:[^\\n;]*?from\\s+)?)([\"'])(eliscript/runtime/[^\"']+)\\2" "gm")
      (lambda (_all prefix _quote specifier)
        (let* ((file (js-call specifier :slice (js-length "eliscript/")))
               (path (resolve root file)))
          (unless (and (js-call path :startsWith (str (resolve root "runtime") "/"))
                       (js-call file :endsWith ".mjs"))
            (throw (new globalThis.TypeError "runtime host import leaves its authenticated source graph")))
          (str prefix (JSON/stringify (get (pathToFileURL path) :href)))))))
  (export sourceRuntimeFileImports maintainedLiteralBinding maintainedSuiteSource sourceFormText sourceCall rewriteSourceForms compileMaintainedSuite))
