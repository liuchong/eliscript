(module tools.testing.wasm-static-repairs
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../backends/build.mjs" root)
  (import "./wasm-static-snapshot.mjs" staticSnapshotSource)
  (import "./generated-fixture-module.mjs" loadGeneratedFixture)
  (defconst staticSourceRefusalTitle "Given dynamic or malformed static-copy arguments When lowering Then source diagnostics reject them before execution")
  (defconst staticFreshMemoTitle "Given a wide shared fresh graph When the validation memo fills Then every edge remains checked and forgotten subtrees are revisited within bounded caches")
  (defun caught (operation)
    (let ((failed false) (failure undefined)) (try (funcall operation) (catch error (setq failed t failure error)))
      (js-call assert :strictEqual failed t) failure))
  (defun assertStaticSourceRefusals (backend)
    (js-call (js-array "(copy-static-u16 address address)" "(copy-static-u16 address 42)" "(copy-static-u16 address)"
      "(copy-static-u16 address \"a\" \"b\")" "(let ((copy-static-u16 address)) (copy-static-u16 address \"a\"))") :forEach
      (lambda (body)
        (let* ((source (+ "(import \"eliscript:memory32\" copy-static-u16)\n(defun run (address) " body ")\n(export run)"))
               (program (js-call (get backend :compiler) :compile_ir_string source "bad-static-kernel.eli"))
               (saved (JSON/stringify program)))
          (let ((failure (caught (lambda () (js-call (get backend :wasm) :emit_memory_wasm program)))))
            (js-call assert :strictEqual (get (get failure :eliscriptDiagnostic) :code) "ELI-B0001"))
          (js-call (js-array "arm64-macos" "arm64-linux") :forEach (lambda (target)
            (let ((failure (caught (lambda () (js-call (get backend :native) :emit_native_memory_library program target)))))
              (js-call assert :strictEqual (get (get failure :eliscriptDiagnostic) :code) "ELI-B0001"))))
          (js-call assert :strictEqual (JSON/stringify program) saved))))
    (let* ((source "(defun run (address) (copy-static-u16 address \"a\"))\n(export run)")
           (expected (caught (lambda () (js-call (get backend :compiler) :compile_string source "unimported.eli"))))
           (actual (caught (lambda () (js-call (get backend :wasm) :emit_memory_wasm
             (js-call (get backend :compiler) :compile_ir_string source "unimported.eli")))))
           (diagnostic (get actual :eliscriptDiagnostic)))
      ;; Analysis rejects the original source before any IR can be returned.
      ;; Compare the entire compile+emit call to the independent JS entry.
      (js-call assert :strictEqual (get actual :name) (get expected :name))
      (js-call assert :strictEqual (get actual :message) (get expected :message))
      (js-call assert :deepStrictEqual diagnostic (get expected :eliscriptDiagnostic))
      (js-call assert :strictEqual (get diagnostic :code) "ELI-A0001")
      (js-call assert :strictEqual (get diagnostic :phase) "analysis")
      (js-call assert :strictEqual (get (get diagnostic :location) :file) "unimported.eli")
      (js-call assert :strictEqual (get (get (get diagnostic :location) :start) :line) 1)
      (js-call assert :strictEqual (get (get (get diagnostic :location) :start) :column) 23)))
  (defun trackedSet ()
    (let ((set (new globalThis.Set)))
      (Object/assign set (js-object :peak 0 :clears 0 :deleted 0 :peakDeleted 0
        :add (lambda (value)
          (Reflect/apply globalThis.Set.prototype.add set (js-array value))
          (put set :peak (Math/max (get set :peak) (get set :size))) set)
        :delete (lambda (value)
          (let ((removed (Reflect/apply (get globalThis.Set.prototype "delete") set (js-array value))))
            (when removed (put set :deleted (1+ (get set :deleted))))
            (put set :peakDeleted (Math/max (get set :peakDeleted) (get set :deleted))) removed))
        :clear (lambda () (Reflect/apply globalThis.Set.prototype.clear set (js-array))
          (put set :clears (1+ (get set :clears))) (put set :deleted 0))))))
  (defasync assertStaticFreshMemo (backend directory)
    (let* ((source (await (readFile (resolve root "bootstrap/backends/wasm.eli") "utf8")))
           (url (get (pathToFileURL (resolve directory "backends/numeric.mjs")) :href))
           (javascript (js-call (get backend :compiler) :compile_string (staticSnapshotSource source url t) "wasm-snapshot-repairs.eli"))
           (snapshot (await (loadGeneratedFixture directory javascript "wasm-snapshot-repairs")))
           (work (js-call snapshot :make_wasm_validation_workspace))
           (empty (Object/freeze (js-array))) (kinds 0) (childReads 0)
           (shared (Object/freeze (Object/defineProperties (js-object :type "u32" :value 7)
             (js-object :kind (js-object :enumerable t :get (lambda () (setq kinds (1+ kinds)) "literal"))
               :children (js-object :enumerable t :get (lambda () (setq childReads (1+ childReads)) empty)))))))
      (put work :seen (trackedSet)) (put work :active (trackedSet))
      ;; Two actual capability checks read kind, then the leaf's children are
      ;; checked and visited. Establish that contract independently of DAG memo.
      (js-call assert :strictEqual (js-call snapshot :validate_fresh_wasm_expression shared nil t work) shared)
      (js-call assert :strictEqual kinds 2) (js-call assert :strictEqual childReads 2)
      (setq kinds 0 childReads 0)
      (let* ((unique (Array/from (js-object :length 65543) (lambda (ignored index)
               (Object/freeze (js-object :kind "literal" :type "u32" :value index :children empty)))))
             (children (Object/freeze (js-call (js-array shared shared) :concat unique (js-array shared))))
             (node (Object/freeze (js-object :kind "sequence" :type "u32" :value nil :children children))))
        (js-call assert :strictEqual (js-call snapshot :validate_fresh_wasm_expression node nil t work) node)
        (js-call assert :strictEqual kinds 6 "both actual capability guards run for all three incoming edges")
        (js-call assert :strictEqual childReads 5 "the late shared leaf is revisited after the finite memo forgets it")
        (js-call assert :ok (<= (get (get work :seen) :peak) 65536))
        (js-call assert :ok (>= (get (get work :seen) :clears) 2))
        (js-call assert :ok (<= (get (get work :active) :peak) 2))
        (js-call assert :ok (> (get (get work :active) :clears) 10))
        (js-call assert :ok (<= (get (get work :active) :peakDeleted) 4096))
        (js-call assert :strictEqual (get (get work :active) :size) 0)
        (js-call assert :strictEqual (js-length (get work :nodes)) 2)
        (js-call assert :strictEqual (js-length (get work :positions)) 2)
        (js-call assert :ok (js-call (get work :nodes) :every (lambda (value) (eq value nil))))
        (js-call assert :strictEqual (get node :children) children)
        (js-call assert :strictEqual (js-call children :at -1) shared))
      (let* ((marker (js-object :originalFailure t)) (reads (js-array))
             (bad (Object/defineProperties (js-object :type "u32" :value 7)
               (js-object :kind (js-object :get (lambda ()
                 (js-call reads :push "kind") (when (= (js-length reads) 2) (throw marker)) "literal"))
                 :children (js-object :get (lambda () (js-call reads :push "children") empty))))))
        (js-call assert :strictEqual (caught (lambda () (js-call snapshot :validate_fresh_wasm_expression bad nil t work))) marker)
        (js-call assert :deepStrictEqual reads (js-array "kind" "kind"))
        (js-call assert :strictEqual (js-call snapshot :validate_fresh_wasm_expression shared nil t work) shared))))
  (export staticSourceRefusalTitle staticFreshMemoTitle assertStaticSourceRefusals assertStaticFreshMemo))
