(module tools.testing.fixture-environment
  (import "node:fs" readFileSync realpathSync mkdirSync mkdtempSync rmSync lstatSync existsSync)
  (import "node:path" resolve relative dirname basename)
  (import "playwright-core" chromium firefox webkit)
  (import "./initializer-array-fixture.mjs" prepareInitializerFixtureArguments)

  (defconst fixture-origin "http://eliscript-fixture.invalid")
  (defconst runtime-files (js-array "prelude.mjs" "unicode-case.mjs" "unicode-case-data.mjs" "math.mjs"))
  (defun fixture-root (source-root)
    (let* ((root (realpathSync (resolve source-root)))
           (package (JSON/parse (readFileSync (resolve root "package.json") "utf8")))
           (exports (get package :exports)))
      (unless (and (= (get package :name) "eliscript") exports
                   (= (get exports "./runtime/prelude.mjs") "./runtime/prelude.mjs")
                   (= (get exports "./runtime/unicode-case.mjs") "./runtime/unicode-case.mjs")
                   (= (get exports "./runtime/math.mjs") "./runtime/math.mjs"))
        (throw (new globalThis.TypeError "fixture environment requires the actual Eliscript runtime package")))
      (js-call runtime-files :forEach (lambda (name) (readFileSync (resolve root "runtime" name))))
      root))
  (defun fixture-scratch-base (root)
    (let ((base (resolve root ".eliscript-cache/test-fixtures")))
      (mkdirSync base (js-object :recursive t))
      (let ((actual (realpathSync base)))
        (unless (and (not (js-call (relative root actual) :startsWith ".."))
                     (= actual base)
                     (not (existsSync (resolve root ".eliscript-cache/package.json")))
                     (not (existsSync (resolve base "package.json"))))
          (throw (new globalThis.TypeError "fixture scratch must retain the actual root package scope"))))
      base))
  (defun validate-fixture-directory (root directory)
    (let ((base (fixture-scratch-base root)))
      (unless (and (= (dirname directory) base) (js-call (basename directory) :startsWith "session-")
                   (not (js-call (lstatSync directory) :isSymbolicLink))
                   (js-call (lstatSync directory) :isDirectory) (= (realpathSync directory) directory))
        (throw (new globalThis.TypeError "fixture directory is outside its owned package-scoped scratch"))) directory))
  (defun prepareFixtureEnvironment (source-root environment)
    (unless (and environment (= (value-type environment) "object"))
      (throw (new globalThis.TypeError "fixture environment must be an environment record")))
    (let* ((root (fixture-root source-root))
           (directory (mkdtempSync (resolve (fixture-scratch-base root) "session-")))
           (env (Object/assign (js-object) environment (js-object
             :TMPDIR directory :TMP directory :TEMP directory
             :ELISCRIPT_TEST_FIXTURE_DIRECTORY directory :ELISCRIPT_TEST_FIXTURE_ROOT root
             :ELISCRIPT_TEST_FIXTURE_PRELOAD "1"
             :ELISCRIPT_TEST_FIXTURE_PRELOAD_PATH (resolve root "tools/testing/fixture-environment.mjs"))))
           (closed false))
      (js-object :directory directory :environment env :close (lambda ()
        (unless closed
          (validate-fixture-directory root directory)
          (rmSync directory (js-object :recursive t :force t))
          (setq closed t))))))
  (defun fixtureChildArguments (arguments environment)
    (let* ((fixtures (= (get environment :ELISCRIPT_TEST_FIXTURE_PRELOAD) "1"))
           (root (if fixtures (get environment :ELISCRIPT_TEST_FIXTURE_ROOT) (js-call globalThis.process :cwd)))
           (path (get environment :ELISCRIPT_TEST_FIXTURE_PRELOAD_PATH))
           (preloads (js-array)))
      (when fixtures
        (unless (and (= (value-type root) "string") (= (value-type path) "string")
                     (= path (resolve root "tools/testing/fixture-environment.mjs")))
          (throw (new globalThis.TypeError "fixture preload coordinates do not match the actual source root")))
        (js-call preloads :push path))
      ;; These complete archived suites need their maintained registration
      ;; adapters before ESM links the archive's real bun:test dependency.
      (js-call (js-array
        (js-array "tests/js-array-text-fast-path.test.mjs" "tests/helpers/array-text-fixture-install.mjs")
        (js-array "tests/wasm-managed-math.test.mjs" "tests/helpers/math-oracle-fixture-install.mjs")
        (js-array "tests/wasm-managed-number-text.test.mjs" "tests/helpers/managed-numeric-fixtures-install.mjs")
        (js-array "tests/wasm-managed-primitive-operators.test.mjs" "tests/helpers/managed-numeric-fixtures-install.mjs")
        (js-array "tests/native-node-memory.test.mjs" "tests/helpers/compiler-portable-fixtures-install.mjs")
        (js-array "tests/emacs-analysis-evidence.test.mjs" "tests/helpers/managed-capacity-registration.mjs")
        (js-array "tests/compiler-fragment-combine.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/compiler-portable-predicates.test.mjs" "tests/helpers/compiler-portable-fixtures-install.mjs")
        (js-array "tests/compiler-portable-reader.test.mjs" "tests/helpers/compiler-portable-fixtures-install.mjs")
        (js-array "tests/wasm-managed-object-integrity.test.mjs" "tests/helpers/managed-integrity-install.mjs")
        (js-array "tests/wasm-managed-function-properties.test.mjs" "tests/helpers/managed-function-properties-install.mjs")
        (js-array "tests/direct-wasm-backend.test.mjs" "tests/helpers/direct-wasm-registration-install.mjs")
        (js-array "tests/dogfood-action.test.mjs" "tests/helpers/dogfood-action-install.mjs")
        (js-array "tests/dogfood-workflow.test.mjs" "tests/helpers/dogfood-workflow-install.mjs")
        (js-array "tests/ci-contract.test.mjs" "tests/helpers/ci-contract-install.mjs")
        (js-array "tests/retained-soak-refresh.test.mjs" "tests/helpers/retained-soak-refresh-install.mjs")
        (js-array "tests/retained-transient-refresh.test.mjs" "tests/helpers/retained-transient-refresh-install.mjs")
        (js-array "tests/compiler-package-session.test.mjs" "tools/testing/independent-cli-fixture.mjs")
        (js-array "tests/compiler-package-session.test.mjs" "tests/helpers/bounded-assertions-install.mjs")
        (js-array "tests/compiler-package-session.test.mjs" "tests/helpers/compiler-package-runtime-install.mjs")
        (js-array "tests/compiler-session-tools.test.mjs" "tools/testing/independent-cli-fixture.mjs")
        (js-array "tests/compiler-corpus-arguments.test.mjs" "tools/testing/independent-cli-fixture.mjs")
        (js-array "tests/wasm-managed-runtime.test.mjs" "tests/helpers/managed-runtime-install.mjs")
        (js-array "tests/wasm-managed-primitive-properties.test.mjs" "tests/helpers/managed-primitive-properties-install.mjs")
        (js-array "tests/wasm-managed-objects.test.mjs" "tests/helpers/managed-container-install.mjs")
        (js-array "tests/wasm-managed-arrays.test.mjs" "tests/helpers/managed-container-install.mjs")
        (js-array "tests/wasm-managed-builtins.test.mjs" "tests/helpers/managed-container-install.mjs")
        (js-array "tests/wasm-managed-identity.test.mjs" "tests/helpers/managed-container-install.mjs")
        (js-array "tests/wasm-managed-source-collections.test.mjs" "tests/helpers/managed-collection-install.mjs")
        (js-array "tests/wasm-managed-collection-for-each.test.mjs" "tests/helpers/managed-collection-install.mjs")
        (js-array "tests/compiler-response-events.test.mjs" "tests/helpers/response-identities-install.mjs")
        (js-array "tests/wasm-managed-transient-state.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
        (js-array "tests/wasm-managed-core-modules.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
        (js-array "tests/wasm-managed-sorted-core.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
        (js-array "tests/managed-stdlib-value-json.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
        (js-array "tests/wasm-managed-math-transcendental.test.mjs" "tests/helpers/standard-library-fixture-install.mjs")
        (js-array "tests/wasm-managed-project-sharing.test.mjs" "tests/helpers/managed-sharing-fixture-install.mjs")
        (js-array "tests/wasm-managed-array-inheritance.test.mjs" "tests/helpers/managed-capacity-registration.mjs")
        (js-array "tests/wasm-managed-array-index-storage.test.mjs" "tests/helpers/managed-capacity-registration.mjs")
        (js-array "tests/wasm-managed-empty-bindings.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-callables.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-realm-lifetime.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-native-prototype-callables.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-str.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-persistent-literals.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-variadic-calls.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-typeof.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-typeof-paths.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-array-callbacks.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-array-splice.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-project-linking.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-strings.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-text-constructors.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-regexp.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-regexp-exact.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-regexp-indices.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/regexp-property-outlining.test.mjs" "tests/helpers/managed-fixture-repairs-install.mjs")
        (js-array "tests/wasm-managed-wire-selfhosted.test.mjs" "tests/helpers/wire-project-fixture-install.mjs")
        (js-array "tests/compiler-artifact-archive-selfhosted.test.mjs" "tests/helpers/compiler-fixture-registration-install.mjs")
        (js-array "tests/compiler-metadata-codec-selfhosted.test.mjs" "tests/helpers/compiler-fixture-registration-install.mjs")
        (js-array "tests/compiler-matrix-original-gates-selfhosted.test.mjs" "tests/helpers/compiler-fixture-registration-install.mjs")) :forEach
        (lambda (route)
          (when (js-call arguments :some (lambda (argument) (= (resolve root argument) (resolve root (aref route 0)))))
            (js-call preloads :push (resolve root (aref route 1))))))
      (setq arguments (prepareInitializerFixtureArguments arguments root environment))
      (if (= (js-length preloads) 0) arguments
        (let ((index (js-call arguments :indexOf "test")) (added (js-array)))
          (when (< index 0)
            (throw (new globalThis.TypeError "fixture preload requires an explicit Bun test subcommand")))
          (js-call preloads :forEach (lambda (preload)
            (unless (js-call arguments :some (lambda (argument position)
                      (and (> position 0) (= (aref arguments (1- position)) "--preload")
                           (= (resolve root argument) preload))))
              (js-call added :push "--preload" preload))))
          (js-call (js-call arguments :slice 0 (1+ index)) :concat added (js-call arguments :slice (1+ index)))))))

  (defun fixtureRuntimeResponse (source-root address)
    (let* ((url (new globalThis.URL address)) (path (get url :pathname))
           (name (js-call path :slice (js-length "/runtime/"))))
      (if (and (= (get url :origin) fixture-origin) (js-call path :startsWith "/runtime/")
               (js-call runtime-files :includes name))
        (js-object :status 200 :body (readFileSync (resolve source-root "runtime" name) "utf8")
          :headers (js-object "content-type" "text/javascript; charset=utf-8" "access-control-allow-origin" "*"))
        (js-object :status 404 :body "Not found"))))
  ;; This function is serialized by the real Playwright API after Eli emits it.
  ;; Its entire browser operation is standard DOM import-map installation.
  (defun installFixtureImportMap (configuration)
    (let ((script (js-call globalThis.document :createElement "script")) (observer undefined) (attached false))
      (put script :type "importmap")
      (put script :textContent (JSON/stringify configuration))
      ;; Playwright init scripts run before the parser has necessarily created
      ;; its head. Observe that real parser boundary instead of throwing or
      ;; constructing a competing document/head before the page parses.
      (letfn ((attach ()
                (when (and (= attached false) (not (nullish? (get globalThis.document :head))))
                  (setq attached t)
                  (unless (nullish? observer) (js-call observer :disconnect))
                  (js-call (get globalThis.document :head) :appendChild script))))
        (if (nullish? (get globalThis.document :head))
          (progn
            (setq observer (new globalThis.MutationObserver (lambda () (attach))))
            (js-call observer :observe globalThis.document (js-object :childList t :subtree t)))
          (attach)))))
  (defun installFixtureBrowserEnvironment (types source-root)
    (let ((restorations (js-array)) (browsers (new globalThis.WeakSet))
          (configuration (js-object :imports (js-object
            "eliscript/runtime/prelude.mjs" (+ fixture-origin "/runtime/prelude.mjs")
            "eliscript/runtime/unicode-case" (+ fixture-origin "/runtime/unicode-case.mjs")
            "eliscript/runtime/unicode-case.mjs" (+ fixture-origin "/runtime/unicode-case.mjs")
            "eliscript/runtime/math.mjs" (+ fixture-origin "/runtime/math.mjs")))))
      (letfn ((replace (target name replacement)
                (let ((descriptor (Object/getOwnPropertyDescriptor target name)))
                  (Object/defineProperty target name (Object/assign
                    (js-object :configurable t :writable t :enumerable false) descriptor (js-object :value replacement)))
                  (js-call restorations :push (lambda ()
                    (if descriptor (Object/defineProperty target name descriptor) (Reflect/deleteProperty target name))))))
              (prepare-browser (browser)
                (unless (js-call browsers :has browser)
                  (js-call browsers :add browser)
                  (let ((original (get browser :newContext)))
                    (replace browser "newContext" (async (&rest arguments)
                      (let ((context (await (Reflect/apply original browser arguments))))
                        (try
                          (await (js-call context :route (+ fixture-origin "/**")
                            (async (route) (await (js-call route :fulfill
                              (fixtureRuntimeResponse source-root (js-call (js-call route :request) :url)))))))
                          (await (js-call context :addInitScript installFixtureImportMap configuration))
                          context
                          (catch error
                            (try (await (js-call context :close)) (catch ignored nil))
                            (throw error)))))))) browser))
        (js-call types :forEach (lambda (type)
          (let ((original (get type :launch)))
            (replace type "launch" (async (&rest arguments)
              (prepare-browser (await (Reflect/apply original type arguments)))))))))
      (lambda ()
        (while (> (js-length restorations) 0) (funcall (js-call restorations :pop))))))

  (defun install-fixture-preload ()
    (let* ((environment (get globalThis.process :env))
           (root (fixture-root (or (get environment :ELISCRIPT_TEST_FIXTURE_ROOT) (js-call globalThis.process :cwd))))
           (existing (get environment :ELISCRIPT_TEST_FIXTURE_DIRECTORY))
           (owned (unless existing (prepareFixtureEnvironment root environment))))
      (if owned
        (js-call (js-array "TMPDIR" "TMP" "TEMP" "ELISCRIPT_TEST_FIXTURE_DIRECTORY"
                          "ELISCRIPT_TEST_FIXTURE_ROOT" "ELISCRIPT_TEST_FIXTURE_PRELOAD_PATH") :forEach
          (lambda (name) (put environment name (get (get owned :environment) name))))
        (validate-fixture-directory root existing))
      (let ((restore (installFixtureBrowserEnvironment (js-array chromium firefox webkit) root)))
        (js-call globalThis.process :once "exit" (lambda ()
          (funcall restore) (when owned (js-call owned :close)))))))
  (when (= (get (get globalThis.process :env) :ELISCRIPT_TEST_FIXTURE_PRELOAD) "1")
    (install-fixture-preload))
  (export prepareFixtureEnvironment fixtureChildArguments fixtureRuntimeResponse
    installFixtureImportMap installFixtureBrowserEnvironment))
