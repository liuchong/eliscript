(module tools.testing.number-text-regressions
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp writeFile)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "../backends/build.mjs" root)
  (import "../backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./portable-node-fixtures.mjs" portableStaticBackend portableStaticDirectory)
  (import "./generated-fixture-module.mjs" loadGeneratedFixture)
  (defconst numberCrossHostTitle "the same generated Number method calls keep managed radix text and exact input bits in Bun and independent Node")
  (defasync assertNumberCrossHost ()
    (let* ((backend portableStaticBackend) (compiler (get backend :compiler))
           (program (js-call compiler :compile_ir_string "(defconst marker 1) (defun f (value radix) (js-call value :toString radix)) (defun dynamic (value key radix) (js-call value key radix)) (export f dynamic)" "number-text.eli"))
           (before (JSON/stringify program)) (javascript (js-call compiler :emit_ir_string program))
           (js (await (loadGeneratedFixture portableStaticDirectory javascript "number-text-cross-host")))
           (runtime (js-call compiler :compile_ir_string (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
           (a (instantiateManagedRuntime bytes)) (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
           (samples (js-array)) (key (js-call a :string "toString"))
           (values (js-array -0 0 -1 1 0.1 -0.1 0.5 (/ 1 3) 1.0000000000000002 0.9999999999999999
             globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) (Math/pow 2 -1022)
             globalThis.Number.MAX_VALUE (- globalThis.Number.MAX_VALUE) globalThis.NaN globalThis.Infinity (- globalThis.Infinity)))
           (state 1897679417) (checks 0))
      (js-call assert :strictEqual (JSON/stringify program) before)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-call a :auto 1)
      (let ((index 0))
        (while (< index 64)
          (setq state (uint32 (+ (Math/imul state 1664525) 1013904223))) (js-call view :setUint32 0 state)
          (setq state (uint32 (+ (Math/imul state 1664525) 1013904223))) (js-call view :setUint32 4 state)
          (js-call values :push (js-call view :getFloat64 0)) (setq index (1+ index))))
      (js-call assert :strictEqual (js-length values) 82)
      (try
        (js-call values :forEach (lambda (number)
          (js-call view :setFloat64 0 number)
          (let* ((words (js-array (js-call view :getUint32 0) (js-call view :getUint32 4)))
                 (texts (js-array)) (input (js-call a :number number)))
            (try
              (let ((radix 2))
                (while (<= radix 36)
                  (let ((base (js-call a :number radix)) (result undefined))
                    (try
                      (setq result (js-call a :invoke "f" (js-array input base)))
                      (let ((expected (js-call a :readString result)))
                        (js-call assert :strictEqual (js-call js :f number radix) expected)
                        (js-call assert :strictEqual (js-call js :dynamic number "toString" radix) expected)
                        ;; Decimal uses Number's shortest spelling; the common
                        ;; nondecimal integer contract uses the exact integer.
                        (if (= radix 10)
                          (js-call assert :strictEqual expected (Reflect/apply (get globalThis.Number.prototype "toString") number (js-array 10)))
                          (when (Number/isInteger number)
                            (js-call assert :strictEqual expected (js-call (globalThis.BigInt number) :toString radix)
                              "exact nondecimal integer digits have an independent BigInt oracle")))
                        (let ((dynamic (js-call a :invoke "dynamic" (js-array input key base))))
                          (try (js-call assert :strictEqual (js-call a :readString dynamic) expected)
                            (finally (js-call a :release dynamic))))
                        (js-call assert :ok (Object/is (js-call a :readNumber input) number))
                        (js-call texts :push expected) (setq checks (1+ checks)))
                      (finally (unless (undefined? result) (js-call a :release result)) (js-call a :release base))))
                  (setq radix (1+ radix))))
              (finally (js-call a :release input)))
            (js-call samples :push (js-object :words words :texts texts)))))
        (finally (js-call a :release key) (js-call a :closeModule) (js-call a :collect)
          (js-call assert :strictEqual (js-call a :live) 0)
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0)))
      (js-call assert :strictEqual checks (* 82 35))
      (let* ((directory (await (mkdtemp (resolve portableStaticDirectory "number-cross-node-"))))
             (path (resolve directory "compiler.mjs")))
        (await (writeFile path javascript))
        (js-call assert :strictEqual (await (readFile path "utf8")) javascript)
        (let ((child (spawnSync (get (get globalThis.process :env) :NODE)
          (js-array (resolve root "tests/helpers/number-text-cross-host.mjs"))
          (js-object :encoding "utf8" :input (JSON/stringify (js-object :directory directory :samples samples))
            :timeout 30000 :maxBuffer 65536))))
          (js-call assert :strictEqual (get child :error) undefined)
          (js-call assert :strictEqual (get child :signal) nil)
          (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
          (js-call assert :deepStrictEqual (JSON/parse (get child :stdout)) (js-object :samples 82 :radices 35))))))
  (export numberCrossHostTitle assertNumberCrossHost))
