(module tools.testing.guarded-command
  (import "node:fs/promises" mkdir writeFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./resource-supervisor.mjs" resourceLimits startResourceSupervisor)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst byte-pattern "^[1-9][0-9]*$")
  (defconst usage "usage: guarded-command.mjs [--tree-rss-bytes N] [--total-rss-bytes N] -- command [args...]")

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun defined-or (object key default)
    (let ((value (get object key)))
      (if (undefined? value) default value)))

  (defun input-or (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object) (aref supplied 0)))

  (defun some-non-string (values)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length values)))
        (unless (= (host-type (aref values index)) "string")
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun parseProtectedCommandArgs (args &rest supplied)
    (let* ((env (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
                  (get globalThis.process :env) (aref supplied 0)))
           (separator (js-call args :indexOf "--")))
      (when (or (< separator 0) (= separator (1- (js-length args))))
        (throw (new globalThis.TypeError usage)))
      (let ((values (new globalThis.Map)) (index 0))
        (while (< index separator)
          (let ((option (aref args index)) (value (aref args (1+ index))))
            (when (or (not (js-call (js-array "--tree-rss-bytes" "--total-rss-bytes") :includes option))
                      (js-call values :has option)
                      (>= (1+ index) separator)
                      (not (js-call (new globalThis.RegExp byte-pattern) :test value)))
              (throw (new globalThis.TypeError "resource options require unique positive integer byte counts")))
            (js-call values :set option (funcall globalThis.Number value)))
          (setq index (+ index 2)))
        (let* ((ceiling (resourceLimits (js-object :treeBytes (get env :ELISCRIPT_TEST_TREE_RSS_BYTES)
                                          :totalBytes (get env :ELISCRIPT_TEST_TOTAL_RSS_BYTES))))
               (tree-limit (js-call values :get "--tree-rss-bytes"))
               (total-limit (js-call values :get "--total-rss-bytes"))
               (limits (resourceLimits (js-object
                                         :treeBytes (if (nullish? tree-limit) (get ceiling :treeBytes) tree-limit)
                                         :totalBytes (if (nullish? total-limit) (get ceiling :totalBytes) total-limit))))
               (command (aref args (1+ separator)))
               (command-args (js-call args :slice (+ separator 2))))
          (when (or (> (get limits :treeBytes) (get ceiling :treeBytes))
                    (> (get limits :totalBytes) (get ceiling :totalBytes)))
            (throw (new globalThis.RangeError "command-line limits cannot raise an existing environment limit")))
          (when (or (not (= (host-type command) "string")) (= (js-length command) 0) (some-non-string command-args))
            (throw (new globalThis.TypeError "expected a command and string arguments")))
          (js-object :command command :args command-args :limits limits)))))

  (defasync runProtectedCommand (command &rest supplied)
    (let ((args (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-array) (aref supplied 0)))
          (options (if (or (< (js-length supplied) 2) (undefined? (aref supplied 1))) (js-object) (aref supplied 1))))
      (when (or (not (= (host-type command) "string")) (not (host-truthy command))
                (not (Array/isArray args)) (some-non-string args))
        (throw (new globalThis.TypeError "expected a command and string arguments")))
      (let* ((archive-directory (resolve ".eliscript-cache" "test-results"))
             (archive (resolve archive-directory
                        (str "guarded-command-" (js-call globalThis.Date :now) "-" (get globalThis.process :pid) ".json")))
             (signal-code 0)
             (supervisor nil)
             (outcome nil)
             (interrupt (lambda () (setq signal-code 130) (when (not (nullish? supervisor)) (js-call supervisor :cancel "SIGINT"))))
             (terminate (lambda () (setq signal-code 143) (when (not (nullish? supervisor)) (js-call supervisor :cancel "SIGTERM")))))
        (js-call globalThis.process :on "SIGINT" interrupt)
        (js-call globalThis.process :on "SIGTERM" terminate)
        (try
          (setq supervisor (await (startResourceSupervisor (js-object :limits (get options :limits)))))
          (if (host-truthy signal-code)
            (progn
              (js-call supervisor :cancel (if (= signal-code 130) "SIGINT" "SIGTERM"))
              (setq outcome (js-object :failure "cancelled" :exitCode signal-code)))
            (setq outcome (await (js-call supervisor :run
                                   (js-object :id "command" :file command :command command :args args
                                     :cwd (get options :cwd (js-call globalThis.process :cwd))
                                     :env (get globalThis.process :env))))))
          (catch error
            (setq outcome (js-object :failure "resource-supervisor-unavailable" :message (get error :message) :exitCode 1)))
          (finally
            (try
              (when supervisor (await (js-call supervisor :close)))
              (finally
                (js-call globalThis.process :off "SIGINT" interrupt)
                (js-call globalThis.process :off "SIGTERM" terminate)))))
        (let* ((failure (host-get supervisor "failure"))
               (result (js-call globalThis.Object :assign (js-object) outcome
                         (js-object :exitCode (if (host-truthy signal-code) signal-code (get outcome :exitCode)))
                         (if (and failure (not (get outcome :failure)))
                           (js-object :failure (get failure :failure)
                             :exitCode (if (host-truthy signal-code) signal-code 1))
                           (js-object)))))
          (try
            (await (mkdir archive-directory (js-object :recursive t)))
            (await (writeFile archive
                     (str (JSON/stringify (js-call globalThis.Object :assign (js-object) (js-object :command command :args args) result
                                            (js-object :resourceFailure (if (nullish? failure) nil failure)))
                            nil 2) "\n")))
            (catch error
              (console/error (str "Cannot archive protected command outcome: " (get error :message)))
              (put result :exitCode (if (host-truthy signal-code) signal-code 1))))
          (when (get result :failure)
            (console/error (str "[" (get result :failure) "] protected command stopped; details: " archive)))
          result))))

  (when (= (aref (get globalThis.process :argv) 1) module-file)
    (js-call (funcall (async ()
                        (let ((parsed (parseProtectedCommandArgs (js-call (get globalThis.process :argv) :slice 2))))
                          (put globalThis.process :exitCode
                            (get (await (runProtectedCommand (get parsed :command) (get parsed :args)
                                           (js-object :limits (get parsed :limits))))
                              :exitCode)))))
      :catch (lambda (error)
               (console/error (get error :message))
               (put globalThis.process :exitCode 1))))

  (export parseProtectedCommandArgs runProtectedCommand))
