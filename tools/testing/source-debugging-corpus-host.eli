(module tools.testing.source-debugging-corpus-host
  (import "node:path" resolve)
  (import "./source-debugging.mjs" runSourceDebuggingAcceptance)
  (defasync main ()
    (let* ((root (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (product (aref (get globalThis.process :argv) 2)))
      (unless (and (= (value-type root) "string") (> (js-length root) 0)
                   (= (value-type product) "string") (> (js-length product) 0))
        (throw (new globalThis.TypeError "source debugging requires its real source root and selected compiler product")))
      (await (runSourceDebuggingAcceptance (js-object :compilerDirectory (resolve product "bootstrap/compiler"))))))
  (defconst completion (main))
  (js-call completion :catch (lambda (error)
    (console/error (get error :stack error)) (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
