(module tools.testing.stdlib-bit-corpus-host
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./stdlib-bit.mjs" runStdlibBitAcceptance)
  (defasync main ()
    (let* ((environment (get globalThis.process :env))
           (source-root (get environment :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (reference-root (get environment :ELISCRIPT_ORIGINAL_REFERENCE_PRODUCT_ROOT))
           (product (aref (get globalThis.process :argv) 2)))
      (unless (and (= (value-type source-root) "string") (> (js-length source-root) 0)
                   (= (value-type reference-root) "string") (> (js-length reference-root) 0)
                   (= (value-type product) "string") (> (js-length product) 0))
        (throw (new globalThis.TypeError "complete original bit host requires its selected and independent Seed products")))
      (await (runStdlibBitAcceptance (js-object :sourceRoot source-root
        :selectedDirectory (resolve product "bootstrap/compiler")
        :referenceDirectory (resolve reference-root "bootstrap/compiler"))))))
  (when (and (not (undefined? (aref (get globalThis.process :argv) 1)))
             (= (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath (js* "import.meta.url"))))
    (js-call (main) :catch (lambda (error)
      (js-call (get globalThis.process :stderr) :write (str (get error :stack error) "\n"))
      (put globalThis.process :exitCode 1)))))
