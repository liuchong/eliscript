(module tools.testing.managed-primitive-own-repairs
  (import "node:crypto" createHash)
  (import "../backends/build.mjs" root)
  (import "./maintained-suite-source.mjs" maintainedSuiteSource sourceCall rewriteSourceForms compileMaintainedSuite)
  (import "../../dist/bootstrap/compiler.mjs" compile-ir-string)
  (import "../../dist/bootstrap/emitter.mjs" emit-expression)

  (defun replace-once (source before after)
    (let ((position (js-call source :indexOf before)))
      (unless (and (>= position 0) (= (js-call source :indexOf before (1+ position)) -1))
        (throw (new globalThis.TypeError "original primitive runtime source boundary changed")))
      (str (js-call source :slice 0 position) after (js-call source :slice (+ position (js-length before))))))

  (defun symbol-observation ()
    (let* ((program (compile-ir-string
             "(let* ((artifact (Uint8Array/from (js-call (get (js* \"b\") :managed) :emit_managed_wasm (js* \"p\") (js* \"runtime\")))) (actual (funcall (js* \"instantiateManagedRuntime\") artifact)) (value undefined)) (try (setq value (js-call actual :invoke \"unsupported\")) (js-call (js* \"assert\") :strictEqual (js-call actual :toHostValue value) globalThis.Symbol.split) (js-call (js* \"assert\") :strictEqual (get (js-call actual :stats) :frameDepth) 0) (finally (js-call actual :release value) (js-call actual :closeModule) (js-call actual :collect))) (js-call (js* \"assert\") :strictEqual (js-call actual :live) 0))"
             "primitive-symbol-observation.eli"))
           (statement (aref (get program :body) 0)))
      (unless (= (get statement :kind) "expression-statement")
        (throw (new globalThis.TypeError "primitive observation requires one expression statement")))
      (get (emit-expression (aref (get statement :children) 0)) :text)))

  (defun operand-setup-capacity-observation ()
    ;; The original 8KiB pool includes its 3096-byte slot table. Keep that exact
    ;; failed setup as a cleanup regression; the operation-exhaustion phase
    ;; below retains 128 slots and all original conversion/recovery assertions.
    (let* ((program (compile-ir-string
             "(let* ((actual (funcall (js* \"instance\") (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 8192))) (roots (js-array)) (keep (lambda (value) (js-call roots :push value) value))) (try (js-call (js* \"assert\") :throws (lambda () (let* ((empty (funcall keep (js-call actual :string \"\"))) (trace (funcall keep (js-call actual :sourceObject (js-object :events empty))))) (funcall keep (funcall (js* \"hook\") actual trace \"l\" 2 2)) (funcall keep (funcall (js* \"hook\") actual trace \"r\" 3 3)))) (lambda (error) (= (get (get error :eliscriptDiagnostic (js-object)) :code) \"ELI-RT0002\")) \"operand setup byte budget\") (js-call (js* \"assert\") :strictEqual (get (js-call actual :stats) :frameDepth) 0) (finally (js-call roots :forEach (lambda (value) (js-call actual :release value))) (js-call actual :closeModule) (js-call actual :collect))) (js-call (js* \"assert\") :strictEqual (js-call actual :live) 0))"
             "operand-setup-capacity-observation.eli"))
           (statement (aref (get program :body) 0)))
      (unless (= (get statement :kind) "expression-statement")
        (throw (new globalThis.TypeError "operand setup observation requires one expression statement")))
      (get (emit-expression (aref (get statement :children) 0)) :text)))

    (defconst symbol-observation-source "(let* ((artifact (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))) (actual (funcall instantiateManagedRuntime artifact)) (value undefined)) (try (setq value (js-call actual :invoke \"unsupported\")) (js-call assert :strictEqual (js-call actual :toHostValue value) globalThis.Symbol.split) (js-call assert :strictEqual (get (js-call actual :stats) :frameDepth) 0) (finally (js-call actual :release value) (js-call actual :closeModule) (js-call actual :collect))) (js-call assert :strictEqual (js-call actual :live) 0))")
  (defconst operand-setup-source "(let* ((actual (funcall make-instance (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 8192))) (roots (js-array)) (keep (lambda (value) (js-call roots :push value) value))) (try (js-call assert :throws (lambda () (let* ((empty (funcall keep (js-call actual :string \"\"))) (trace (funcall keep (js-call actual :sourceObject (js-object :events empty))))) (funcall keep (funcall make-hook actual trace \"l\" 2 2)) (funcall keep (funcall make-hook actual trace \"r\" 3 3)))) (lambda (error) (= (get (get error :eliscriptDiagnostic (js-object)) :code) \"ELI-RT0002\")) \"operand setup byte budget\") (js-call assert :strictEqual (get (js-call actual :stats) :frameDepth) 0) (finally (js-call roots :forEach (lambda (value) (js-call actual :release value))) (js-call actual :closeModule) (js-call actual :collect))) (js-call assert :strictEqual (js-call actual :live) 0))")
  (defun transformOriginalPrimitiveRuntimeSuite (source relative)
    (let* ((primitive (= relative "tests/wasm-managed-primitive-own-runtime.test.mjs"))
           (operand (= relative "tests/wasm-managed-operand-conversion.test.mjs"))
           (expected (if primitive "9594c226bd13e1b921a98be0a285d192620df1760e26ce5ccef6bb95be4f7541" "8200a307bdca1f2c63d687866061b21e39e4a5f977220e0c70681fd8b39fc23b")))
      (unless (and (or primitive operand) (= (js-call (js-call (createHash "sha256") :update source) :digest "hex") expected))
        (throw (new globalThis.TypeError "complete original primitive runtime source identity changed")))
      (let* ((maintained (maintainedSuiteSource root relative source)) (seen (new globalThis.Set))
             (projected (rewriteSourceForms maintained
               (lambda (node node-text)
                 (let ((text (funcall node-text node)) (replacement undefined) (kind undefined))
                   (cond
                     ((and primitive (= (value-type (get node :value)) "string")
                           (js-call (get node :value) :includes "(when (and (= value 2) (= (load-u32 20) 0)) (store-u32 20 1) (load-u32 4294967295))"))
                       (setq kind "trap" replacement (JSON/stringify (js-call (get node :value) :replace
                         "(when (and (= value 2) (= (load-u32 20) 0)) (store-u32 20 1) (load-u32 4294967295))"
                         "(when (= value 2) (load-u32 4294967295))"))))
                     ((and primitive (sourceCall node "js-call") (js-call text :startsWith "(js-call assert :equal")
                           (js-call text :includes "(js-call a :invoke \"own\" (js-array t field))"))
                       (setq kind "own" replacement "(js-call assert :equal (js-call a :invoke \"own\" (js-array false field)) false)"))
                     ((and operand (sourceCall node "js-call") (js-call text :startsWith "(js-call assert :throws")
                           (js-call text :includes "conversion-protocol.eli"))
                       (setq kind "symbol" replacement symbol-observation-source))
                     ((and operand (sourceCall node "let*") (js-call text :includes "(a (make-instance (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 8192)))")
                           (js-call text :includes "saved"))
                       (setq kind "capacity" replacement (str "(progn " operand-setup-source " "
                         (js-call text :replace "(a (make-instance (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 8192)))"
                           "(a (make-instance (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 65536)))") ")"))))
                   (unless (undefined? kind)
                     (when (js-call seen :has kind) (throw (new globalThis.TypeError "primitive repair source is ambiguous")))
                     (js-call seen :add kind))
                   replacement)))))
        (unless (= (get seen :size) 2) (throw (new globalThis.TypeError "original primitive runtime source boundary changed")))
        (compileMaintainedSuite (get projected :source) relative ""))))

  (export transformOriginalPrimitiveRuntimeSuite))
