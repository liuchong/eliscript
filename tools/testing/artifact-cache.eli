(module tools.testing.artifact-cache
  (import "node:fs" existsSync mkdirSync readFileSync readdirSync renameSync rmSync statSync unlinkSync writeFileSync)
  (import "node:path" join resolve dirname)
  (import "node:crypto" createHash randomUUID)

  ;; Content-addressed compilation IR cache for the Eliscript test framework.
  ;; Keyed by compiler/runtime source closure digest + filename + source bytes.
  ;; Every hit parses into a fresh object graph so caller AST mutations remain isolated.
  (defconst IR_CACHE_VERSION "ir-exact")
  (defconst IR_TAG_KEY "__eliIrTag")
  (defconst MIN_CACHED_SOURCE_LENGTH 16384)
  (defconst MAX_IR_CACHE_ENTRIES 512)
  (defconst STALE_TEMP_MS 300000)

  (defun irCacheEnabled (&optional environment)
    (let ((env (or environment (get globalThis.process :env))))
      (and (= (aref env "ELISCRIPT_TEST_IR_CACHE") "1")
           (/= (aref env "ELISCRIPT_DISABLE_TEST_IR_CACHE") "1"))))

  (defun irCacheKey (compiler-cache-key filename source &optional min-length)
    (let ((threshold (if (Number/isFinite min-length) min-length MIN_CACHED_SOURCE_LENGTH)))
      (when (and (= (value-type compiler-cache-key) "string")
                 (> (js-length compiler-cache-key) 0)
                 (= (value-type filename) "string")
                 (> (js-length filename) 0)
                 (= (value-type source) "string")
                 (>= (js-length source) threshold))
        (let ((hasher (createHash "sha256")))
          (js-call hasher :update IR_CACHE_VERSION)
          (js-call hasher :update "\0")
          (js-call hasher :update compiler-cache-key)
          (js-call hasher :update "\0")
          (js-call hasher :update filename)
          (js-call hasher :update "\0")
          (js-call hasher :update source)
          (js-call hasher :digest "hex")))))

  (defun entry-path (cache-root key)
    (join cache-root (str key ".json")))

  (defun encodeIrValue (node)
    (cond
      ((Object/is node -0.0) (js-object :__eliIrTag "neg0"))
      ((and (= (value-type node) "number") (not (Number/isFinite node)))
       (js-object :__eliIrTag "num" :v (globalThis.String node)))
      ((= (value-type node) "bigint")
       (js-object :__eliIrTag "bigint" :v (js-call node :toString)))
      ((undefined? node) (js-object :__eliIrTag "undef"))
      ((or (nil? node) (/= (value-type node) "object")) node)
      ((Array/isArray node) (js-call node :map (lambda (item) (encodeIrValue item))))
      (t
       (let ((out (js-object))
             (keys (Object/keys node))
             (index 0))
         (while (< index (js-length keys))
           (let ((key (aref keys index)))
             (put out key (encodeIrValue (get node key))))
           (setq index (1+ index)))
         (if (Object/hasOwn node IR_TAG_KEY)
           (js-object :__eliIrTag "esc" :v out)
           out)))))

  (defun decodeIrProperties (obj)
    (let ((keys (Object/keys obj))
          (index 0))
      (while (< index (js-length keys))
        (let ((key (aref keys index)))
          (put obj key (decodeIrValue (get obj key))))
        (setq index (1+ index)))
      obj))

  (defun decodeIrValue (node)
    (cond
      ((or (nullish? node) (/= (value-type node) "object")) node)
      ((Array/isArray node)
       (let ((index 0))
         (while (< index (js-length node))
           (put node index (decodeIrValue (aref node index)))
           (setq index (1+ index)))
         node))
      ((Object/hasOwn node IR_TAG_KEY)
       (let ((tag (get node IR_TAG_KEY)))
         (cond
           ((= tag "neg0") -0.0)
           ((= tag "num") (globalThis.Number (get node :v)))
           ((= tag "bigint") (globalThis.BigInt (get node :v)))
           ((= tag "undef") undefined)
           ((= tag "esc") (decodeIrProperties (get node :v)))
           (t (decodeIrProperties node)))))
      (t (decodeIrProperties node))))

  (defun readCachedIr (cache-root key)
    (if (and (= (value-type cache-root) "string") (= (value-type key) "string"))
      (let ((file (entry-path cache-root key)))
        (if (existsSync file)
          (try
            (decodeIrValue (JSON/parse (readFileSync file "utf8")))
            (catch _error undefined))
          undefined))
      undefined))

  (defun writeCachedIr (cache-root key ir)
    (when (and (= (value-type cache-root) "string") (= (value-type key) "string") (not (undefined? ir)))
      (let* ((target (entry-path cache-root key))
             (temp (join cache-root (str key "." (get globalThis.process :pid) "." (randomUUID) ".tmp"))))
        (try
          (progn
            (mkdirSync cache-root (js-object :recursive t))
            (unless (existsSync target)
              (let ((serialized (JSON/stringify (encodeIrValue ir))))
                (when (= (value-type serialized) "string")
                  (writeFileSync temp serialized "utf8")
                  (renameSync temp target))))
            t)
          (catch _error false)
          (finally
            (when (existsSync temp)
              (try (unlinkSync temp) (catch _cleanup nil))))))))

  (defun pruneIrCache (cache-root &optional max-entries)
    (let ((limit (if (and (Number/isSafeInteger max-entries) (> max-entries 0)) max-entries MAX_IR_CACHE_ENTRIES))
          (removed 0))
      (when (and (= (value-type cache-root) "string") (existsSync cache-root))
        (try
          (let ((names (readdirSync cache-root))
                (json-entries (js-array))
                (now (Date/now))
                (index 0))
            (while (< index (js-length names))
              (let* ((name (aref names index))
                     (full (join cache-root name)))
                (try
                  (let ((st (statSync full)))
                    (if (js-call name :endsWith ".tmp")
                      (when (> (- now (get st :mtimeMs)) STALE_TEMP_MS)
                        (unlinkSync full)
                        (setq removed (1+ removed)))
                      (when (js-call name :endsWith ".json")
                        (js-call json-entries :push (js-object :path full :mtimeMs (get st :mtimeMs))))))
                  (catch _stat nil)))
              (setq index (1+ index)))
            (when (> (js-length json-entries) limit)
              (js-call json-entries :sort (lambda (a b) (- (get a :mtimeMs) (get b :mtimeMs))))
              (let ((excess (- (js-length json-entries) limit))
                    (k 0))
                (while (< k excess)
                  (try
                    (unlinkSync (get (aref json-entries k) :path))
                    (setq removed (1+ removed))
                    (catch _rm nil))
                  (setq k (1+ k))))))
          (catch _dir nil)))
      removed))

  (defun getCompilerCacheStats (compiler)
    (when (and compiler (= (value-type compiler) "object"))
      (let ((stats (get compiler :__eliscriptIrCacheStats)))
        (when stats (Object/assign (js-object) stats)))))

  (defun createCachedCompiler (compiler compiler-cache-key &optional options)
    (let* ((opts (or options (js-object)))
           (environment (or (get opts :environment) (get globalThis.process :env)))
           (force-enabled (= (get opts :enabled) t))
           (enabled (or force-enabled (irCacheEnabled environment)))
           (cache-root (get opts :cacheRoot))
           (min-length (get opts :minLength)))
      (if (or (nullish? compiler)
              (not enabled)
              (/= (value-type compiler-cache-key) "string")
              (= (js-length compiler-cache-key) 0)
              (/= (value-type cache-root) "string")
              (= (js-length cache-root) 0))
        compiler
        (let ((original (get compiler :compile_ir_string)))
          (if (/= (value-type original) "function")
            compiler
            (let ((facade (js-object))
                  (stats (js-object :hits 0 :misses 0 :bypassed 0)))
              (js-call (Object/keys compiler) :forEach (lambda (k)
                (put facade k (aref compiler k))))
              (put facade :compile_ir_string (lambda (source &rest rest-args)
                (let* ((filename (if (> (js-length rest-args) 0) (aref rest-args 0) undefined))
                       (key (when (= (js-length rest-args) 1)
                              (irCacheKey compiler-cache-key filename source min-length))))
                  (if (nullish? key)
                    (progn
                      (put stats :bypassed (1+ (get stats :bypassed)))
                      (Reflect/apply original compiler (js-call (js-array source) :concat rest-args)))
                    (let ((cached (readCachedIr cache-root key)))
                      (if (not (nullish? cached))
                        (progn
                          (put stats :hits (1+ (get stats :hits)))
                          cached)
                        (let ((compiled (Reflect/apply original compiler (js-call (js-array source) :concat rest-args))))
                          (put stats :misses (1+ (get stats :misses)))
                          (writeCachedIr cache-root key compiled)
                          compiled)))))))
              (Object/defineProperty facade "__eliscriptIrCacheStats"
                (js-object :value stats :enumerable false :configurable t))
              facade))))))

  (export MIN_CACHED_SOURCE_LENGTH MAX_IR_CACHE_ENTRIES irCacheEnabled irCacheKey
    readCachedIr writeCachedIr pruneIrCache getCompilerCacheStats createCachedCompiler))
