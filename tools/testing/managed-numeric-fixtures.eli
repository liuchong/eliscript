(module tools.testing.managed-numeric-fixtures
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp symlink realpath mkdir copyFile writeFile rm)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "../backends/build.mjs" root)
  (import "../../bootstrap/host/bun.mjs" loadCompiler)
  (defconst typedNumericOutputTitle "typed Number-only JS emission validates every source node and preserves the accepted optimized JS control bytes")
  (defconst boundedRadixTitle "radix conversion bounds exact integer parsing after full grammar validation instead of allocating from unbounded prefixes")
  (defun digest (source) (js-call (js-call (createHash "sha256") :update source) :digest "hex"))

  ;; The archived direct-WASM acceptance record keeps the accepted optimized
  ;; module bytes. Two later boundaries are reversible, one line-exact step
  ;; each: every independent module carries the mandatory unicode-case prelude
  ;; import exactly once, and independent parallel lexical groups emit direct
  ;; `let` initializers instead of `const __eliscript_value_N` temporaries
  ;; inside one extra block. The artifact is a fixed control product of four
  ;; functions, seven groups and eighteen bindings, so the linear transforms
  ;; below only follow its emitted indentation; there is no general parser.
  (defconst temporary-value-pattern
    (new globalThis.RegExp "^const (__eliscript_value_[0-9]+) = (.*);$"))
  (defconst binding-value-pattern
    (new globalThis.RegExp "^let ([A-Za-z_$][A-Za-z0-9_$]*) = (__eliscript_value_[0-9]+);$"))
  (defconst initializer-pattern
    (new globalThis.RegExp "^let ([A-Za-z_$][A-Za-z0-9_$]*) = (.*);$"))
  (defun spaces (count) (js-call " " :repeat count))
  (defun line-indent (line)
    (let ((index 0))
      (while (and (< index (js-length line)) (= (js-call line :charAt index) " "))
        (setq index (1+ index)))
      index))
  (defun statement-line (line) (js-call line :slice (line-indent line)))
  (defun block-end (lines start limit indent)
    ;; Bounded scan for the closer of the fixed block that owns a group.
    (let ((index start) (found -1))
      (while (and (< index limit) (< found 0))
        (when (and (= (line-indent (aref lines index)) indent) (= (js-call (aref lines index) :trim) "}"))
          (setq found index))
        (setq index (1+ index)))
      found))
  (defun group-start? (lines index pattern)
    (and (> index 0)
         (js-call (js-call (aref lines (1- index)) :trimEnd) :endsWith "{")
         (js-call pattern :exec (statement-line (aref lines index)))))
  (defun expand-artifact (lines counter)
    ;; Current optimized module -> archived accepted bytes.
    (let ((output (js-array)) (open (js-array)) (shift 0) (index 0) (limit (js-length lines)))
      (while (< index limit)
        (when (and (> (js-length open) 0) (= (get (aref open (1- (js-length open))) :close) index))
          (js-call output :push (str (spaces (get (js-call open :pop) :indent)) "}"))
          (setq shift (- shift 2)))
        (let* ((line (aref lines index)) (indent (line-indent line)))
          (if (group-start? lines index initializer-pattern)
            (let ((scan index) (names (js-array)) (expressions (js-array)) (active t))
              (while (and active (< scan limit))
                (let ((item (and (= (line-indent (aref lines scan)) indent)
                                 (js-call initializer-pattern :exec (statement-line (aref lines scan))))))
                  (if item
                    (progn (js-call names :push (aref item 1))
                           (js-call expressions :push (aref item 2))
                           (setq scan (1+ scan)))
                    (setq active nil))))
              (let ((close (block-end lines scan limit (- indent 2)))
                    (temporaries (js-array)) (position 0))
                (js-call assert :ok (> close scan) "optimized lexical group has no enclosing block")
                (while (< position (js-length names))
                  (let ((temporary (str "__eliscript_value_" (get counter :value))))
                    (put counter :value (1+ (get counter :value)))
                    (js-call temporaries :push temporary)
                    (js-call output :push
                      (str (spaces (+ indent shift)) "const " temporary " = " (aref expressions position) ";")))
                  (setq position (1+ position)))
                (js-call output :push (str (spaces (+ indent shift)) "{"))
                (setq position 0)
                (while (< position (js-length names))
                  (js-call output :push
                    (str (spaces (+ indent shift 2)) "let " (aref names position) " = " (aref temporaries position) ";"))
                  (setq position (1+ position)))
                (put counter :groups (1+ (get counter :groups)))
                (js-call open :push (js-object :close close :indent (+ indent shift)))
                (setq shift (+ shift 2))
                (setq index scan)))
            (progn
              (js-call output :push (if (= shift 0) line (str (spaces shift) line)))
              (setq index (1+ index))))))
      output))
  (defun compact-artifact (lines)
    ;; Archived accepted bytes -> current optimized module.
    (let ((output (js-array)) (open (js-array)) (shift 0) (index 0) (limit (js-length lines)))
      (while (< index limit)
        (when (and (> (js-length open) 0) (= (get (aref open (1- (js-length open))) :close) index))
          (js-call open :pop)
          (setq shift (+ shift 2))
          (setq index (1+ index)))
        (when (< index limit)
          (let* ((line (aref lines index)) (indent (line-indent line)))
            (if (group-start? lines index temporary-value-pattern)
              (let ((scan index) (temporaries (js-array)) (expressions (js-array)) (active t))
                (while (and active (< scan limit))
                  (let ((item (and (= (line-indent (aref lines scan)) indent)
                                   (js-call temporary-value-pattern :exec (statement-line (aref lines scan))))))
                    (if item
                      (progn (js-call temporaries :push (aref item 1))
                             (js-call expressions :push (aref item 2))
                             (setq scan (1+ scan)))
                      (setq active nil))))
                (js-call assert :strictEqual (aref lines scan) (str (spaces indent) "{") "generated temporary block is malformed")
                (let ((names (js-array)) (position 0))
                  (while (< position (js-length temporaries))
                    (let* ((binding (aref lines (+ scan 1 position)))
                           (match (js-call binding-value-pattern :exec (statement-line binding))))
                      (js-call assert :ok match "generated binding is missing")
                      (js-call assert :strictEqual (line-indent binding) (+ indent 2) "generated binding indentation changed")
                      (js-call assert :strictEqual (aref match 2) (aref temporaries position) "generated binding order changed")
                      (js-call names :push (aref match 1)))
                    (setq position (1+ position)))
                  (let ((close (block-end lines (+ scan 1 (js-length temporaries)) limit indent)))
                    (js-call assert :ok (> close scan) "generated temporary block has no close")
                    (setq position 0)
                    (while (< position (js-length names))
                      (js-call output :push
                        (str (spaces (+ indent shift)) "let " (aref names position) " = " (aref expressions position) ";"))
                      (setq position (1+ position)))
                    (js-call open :push (js-object :close close))
                    (setq shift (- shift 2))
                    (setq index (+ scan 1 (js-length temporaries))))))
              (progn
                (js-call assert :ok (>= (line-indent line) (- shift)) "generated block body indentation changed")
                (js-call output :push (if (= shift 0) line (js-call line :slice (- shift))))
                (setq index (1+ index)))))))
      output))

  (defasync assertTypedNumericOutput (backend)
    (let* ((kernels (await (readFile (resolve root "tools/experiments/native-wasm/kernels.eli") "utf8")))
           (batches (await (readFile (resolve root "tools/backends/batches.eli") "utf8")))
           (source (+ kernels "\n" batches))
           (program (js-call (get backend :compiler) :compile_ir_string source "direct-batches.eli"))
           (saved (JSON/stringify program)) (code (js-call (get backend :numeric) :emit_numeric_javascript program))
           (retained (JSON/parse (await (readFile (resolve root "tools/backends/results/direct-wasm-macos-arm64.json") "utf8"))))
           (line "import \"eliscript/runtime/unicode-case.mjs\";") (lines (js-call code :split "\n")))
      ;; Same accepted inputs, exactly one mandatory import, and byte-exact
      ;; restoration of the complete emitted module.
      (js-call assert :strictEqual (digest kernels)
        (get (get retained :sourceHashes) "tools/experiments/native-wasm/kernels.eli"))
      (js-call assert :strictEqual (digest batches)
        (get (get retained :sourceHashes) "tools/backends/batches.eli"))
      (js-call assert :strictEqual (js-length (js-call lines :filter (lambda (value) (= value line)))) 1)
      (js-call assert :strictEqual (aref lines 1) line)
      (js-call assert :strictEqual (str (aref lines 0) "\n" line "\n" (js-call (js-call lines :slice 2) :join "\n")) code)
      (let ((position 0))
        (js-call (js-array "recurrence" "escape_grid" "recurrence_batch" "escape_grid_batch") :forEach (lambda (name)
          (let ((found (js-call code :indexOf (str "function " name "(") position)))
            (js-call assert :ok (> found position) (str "accepted function boundary moved: " name))
            (setq position found)))))
      (let* ((kept (js-call lines :filter (lambda (value) (/= value line))))
             (historical (js-call kept :join "\n"))
             (counter (js-object :value 1 :groups 0))
             (expanded (expand-artifact kept counter)))
        ;; The declared boundaries are precise and unique: seven independent
        ;; parallel groups and their eighteen archived temporaries.
        (js-call assert :strictEqual (get counter :groups) 7)
        (js-call assert :strictEqual (get counter :value) 19)
        (js-call assert :strictEqual (digest (js-call expanded :join "\n"))
          (get (get retained :artifacts) :javascriptSha256))
        (js-call assert :strictEqual (js-call (compact-artifact expanded) :join "\n") historical))
      (js-call assert :strictEqual (JSON/stringify program) saved)
      (let* ((input (resolve root "bootstrap/backends/numeric.eli"))
             (output (resolve (get backend :directory) "numeric-independent-seed.mjs"))
             (child (spawnSync (resolve root "bin/eliscript-seed") (js-array "--output" output input)
               (js-object :cwd root :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
        (js-call assert :strictEqual (get child :error) undefined)
        (js-call assert :strictEqual (get child :signal) nil)
        (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
        (let* ((directory (await (mkdtemp (resolve (get backend :directory) "numeric-seed-node-"))))
               (entry (resolve directory "compiler.mjs")))
          (await (symlink output entry "file"))
          (js-call assert :strictEqual (await (realpath entry)) (await (realpath output)))
          (let ((reference (spawnSync (get (get globalThis.process :env) :NODE "node")
            (js-array (resolve root "tests/helpers/numeric-seed-node.mjs") directory)
            (js-object :cwd root :encoding "utf8" :input saved :timeout 30000 :maxBuffer (* 1024 1024)))))
            (js-call assert :strictEqual (get reference :error) undefined)
            (js-call assert :strictEqual (get reference :signal) nil)
            (js-call assert :strictEqual (get reference :status) 0 (get reference :stderr))
            (js-call assert :strictEqual code (JSON/parse (get reference :stdout))))))
      (js-call (js-array "\"1\"" "(js-object)" "(string-to-number x)") :forEach (lambda (expression)
        (let* ((source (+ "(defun f (x) (if false " expression " x)) (export f)"))
               (bad (js-call (get backend :compiler) :compile_ir_string source "invalid-numeric-js.eli"))
               (before (JSON/stringify bad)))
          (js-call assert :throws (lambda () (js-call (get backend :numeric) :emit_numeric_javascript bad))
            (lambda (error) (and (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")
              (= (get (get (get error :eliscriptDiagnostic) :location) :file) "invalid-numeric-js.eli"))))
          (js-call assert :strictEqual (JSON/stringify bad) before))))))
  (defasync assertBoundedRadixParsing (backend)
    (let* ((directory (await (mkdtemp (resolve (get backend :directory) "radix-isolation-"))))
           (compiler (get backend :compiler))
           (program (js-call compiler :compile_ir_string
             (await (readFile (resolve root "tests/fixtures/wasm-managed-primitive-operators.eli") "utf8")) "primitive-operators.eli"))
           (before (JSON/stringify program))
           (original globalThis.BigInt) (calls 0) (module undefined))
      (try
        ;; The public prelude was already imported by the test process. Its
        ;; captured intrinsics cannot be probed by replacing globalThis.BigInt.
        ;; Import byte-identical runtime modules at fresh physical identities.
        (await (mkdir (resolve directory "runtime")))
        (let ((files (js-array "array-text" "binding" "errors" "math" "number-radix" "prelude" "primitives" "unicode-case" "unicode-case-data")) (index 0))
          (while (< index (js-length files))
            (let* ((name (str (aref files index) ".mjs")) (input (resolve root "runtime" name))
                   (output (resolve directory "runtime" name)))
              (await (copyFile input output))
              (js-call assert :deepStrictEqual (await (readFile output)) (await (readFile input))))
            (setq index (1+ index))))
        (await (writeFile (resolve directory "package.json") (JSON/stringify (js-object
          :name "eliscript" :type "module" :private t :exports (js-object
            "./runtime/array-text.mjs" "./runtime/array-text.mjs"
                "./runtime/binding.mjs" "./runtime/binding.mjs"
            "./runtime/errors.mjs" "./runtime/errors.mjs"
            "./runtime/math.mjs" "./runtime/math.mjs"
            "./runtime/number-radix.mjs" "./runtime/number-radix.mjs"
            "./runtime/prelude.mjs" "./runtime/prelude.mjs"
            "./runtime/primitives.mjs" "./runtime/primitives.mjs"
            "./runtime/unicode-case.mjs" "./runtime/unicode-case.mjs"
            "./runtime/unicode-case-data.mjs" "./runtime/unicode-case-data.mjs")))))
        (await (writeFile (resolve directory "compiler.mjs") (js-call compiler :emit_ir_string program)))
        (try
          (put globalThis.globalThis :BigInt (lambda () (setq calls (1+ calls)) (throw (new globalThis.Error "integer parser called"))))
          (setq module (await (loadCompiler directory)))
          (finally (put globalThis.globalThis :BigInt original)))
        (js-call (js-array (str "0x" (js-call "f" :repeat 4096))
                   (str "0b" (js-call "1" :repeat 4096)) (str "0o" (js-call "7" :repeat 4096))) :forEach
          (lambda (text) (js-call assert :strictEqual (js-call module :subtract text 0) globalThis.Infinity)))
        (js-call assert :ok (Object/is (js-call module :subtract (str "0x" (js-call "0" :repeat 10000)) 0) 0))
        (js-call assert :ok (Number/isNaN (js-call module :subtract (str "0x" (js-call "f" :repeat 4096) "z") 0)))
        (js-call assert :strictEqual calls 0)
        (js-call assert :throws (lambda () (js-call module :subtract "0xff" 0)) (new globalThis.RegExp "integer parser called"))
        (js-call assert :strictEqual calls 1)
        (js-call assert :strictEqual (JSON/stringify program) before)
        (finally (put globalThis.globalThis :BigInt original) (await (rm directory (js-object :recursive t :force t)))))))
  (export typedNumericOutputTitle assertTypedNumericOutput boundedRadixTitle assertBoundedRadixParsing))
