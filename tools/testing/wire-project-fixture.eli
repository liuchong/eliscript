(module tools.testing.wire-project-fixture
  (import "node:fs/promises" mkdtemp mkdir writeFile rm)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:assert/strict" :default assert)
  (import "node:url" pathToFileURL)
  (import "../backends/compiler-build.mjs" independentCompilerResources)
  (import "../backends/managed-runtime.mjs" createManagedProjectFacades createManagedModuleGraph readManagedModuleMetadata)
  (defun wireFixtureFunctionalProfile (sourceSha environment)
    (and (= sourceSha "05835e2d5f6fd6e973a052df3389cafb3e131fbcfce305272070b13d20453df0")
      (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
      (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")))
  (defconst wireFunctionalTitles (js-array
    "Given complete original wire corpus and actual HTTP capabilities when WASM executes MDP MDS and GEPO at auto(65536) then independent Node and Bun observations and cleanup agree"
    "Given complete original wire corpus and actual HTTP capabilities when WASM executes MDP MDS and GEPO at auto(1) then independent Node and Bun observations and cleanup agree"
    "Given the identical complete wire graph when actual native code executes original codecs schema discovery and real HTTP then Node and Bun expectations and roots agree"))
  (defun wireFixtureTestRegistration (original sourceSha environment)
    (if (not (wireFixtureFunctionalProfile sourceSha environment)) original
      (letfn ((wrap (target)
        (new globalThis.Proxy target (js-object
          :apply (lambda (actual receiver arguments)
            (let ((selected arguments))
              (when (and (= (js-length arguments) 3) (js-call wireFunctionalTitles :includes (aref arguments 0))
                      (= (value-type (aref arguments 1)) "function") (= (aref arguments 2) 120000))
                (setq selected (js-call arguments :slice)) (put selected 2 0))
              (Reflect/apply actual receiver selected)))
          :get (lambda (actual key receiver)
            (let ((value (Reflect/get actual key actual)))
              (cond ((and (= key "skipIf") (= (value-type value) "function"))
                     (lambda (&rest arguments) (wrap (Reflect/apply value actual arguments))))
                    ((= (value-type value) "function") (js-call value :bind actual))
                    (t value))))))))
        (wrap original))))
  (defun observeWireCorpusProgress (runtime report)
    (let* ((descriptors (Object/getOwnPropertyDescriptors runtime)) (facade (Object/create (Object/getPrototypeOf runtime)))
           (index 0) (pending undefined))
      (js-call (js-array "invoke" "collect") :forEach (lambda (method)
        (let* ((entry (get descriptors method)) (original (get entry :value))
               (wrapped (lambda (&rest arguments)
                 (let ((result (Reflect/apply original runtime arguments)))
                   (when (and (= method "invoke")
                     (js-call (js-array "original-codec-report" "roundtrip-report" "parse-report" "invalid-encode" "validate-report" "gepo-pure-report")
                       :includes (aref arguments 0)))
                     (setq pending (aref arguments 0)))
                   (when (and (= method "collect") (not (undefined? pending)))
                     (let ((name pending))
                       (setq pending undefined)
                       (try (funcall report (js-object :index index :function name)) (catch ignored nil))
                       (setq index (1+ index))))
                   result))))
          (Object/defineProperties wrapped (js-object
            :name (Object/getOwnPropertyDescriptor original "name") :length (Object/getOwnPropertyDescriptor original "length")))
          (put entry :value wrapped))))
      (Object/defineProperties facade descriptors)
      (unless (Reflect/isExtensible runtime) (Object/preventExtensions facade)) facade))
  (defun wireFixtureRuntimeOptions (sourceSha environment input)
    (let* ((enabled (and (wireFixtureFunctionalProfile sourceSha environment)
                    input (= (get input :maxSlots) 8192) (= (get input :initialBytes) 262144)
                    (= (get input :maxBytes) 16777216)))
           (resources (when enabled (independentCompilerResources (js-object :profile "small"))))
           (effective (if enabled (Object/assign (js-object) input (get resources :budget)) input)))
      (js-object :options effective :resourceAcceptance (if enabled "deferred" "baseline")
        :originalCapacityAcceptance (if enabled "DEFERRED / NOT ACCEPTED" "required-by-original-gate")
        :originalRuntimeOptions input :effectiveRuntimeOptions effective)))
  (defun wireRuntimeResourceSnapshot (runtime settings)
    (let ((actual (js-call runtime :stats)))
      (js-object :maxSlots (get settings :maxSlots) :maxBytes (get settings :maxBytes)
        :usedBytes (get actual :usedBytes) :capacityBytes (get actual :capacityBytes)
        :liveValues (get actual :liveValues) :frameDepth (get actual :frameDepth)
        :collections (get actual :collections))))
  (defun readWireProjectDescriptor (bytes)
    (let* ((module (if (js-call globalThis.WebAssembly.Module (get globalThis.Symbol :hasInstance) bytes) bytes
                     (new globalThis.WebAssembly.Module bytes)))
           (sections (js-call globalThis.WebAssembly.Module :customSections module "eliscript-managed-control")))
      (unless (= (js-length sections) 1)
        (throw (new globalThis.TypeError "wire fixture requires exactly one actual managed control section")))
      (readManagedModuleMetadata module "eliscript-managed-control")))
  (defun wireHTTPRuntimeFacade (runtime)
    (let* ((descriptors (Object/getOwnPropertyDescriptors runtime))
           (facade (Object/create (Object/getPrototypeOf runtime)))
           (entry (get descriptors :invoke)) (invoke (get entry :value))
           (wrapped (lambda (name &rest arguments)
             (try (Reflect/apply invoke runtime (js-call (js-array name) :concat arguments))
               (catch error
                 (let ((kind undefined))
                   (when (and (not (nullish? error)) (= (value-type error) "object")
                              (js-call (js-array "http-service" "http-client" "http-candidates" "http-index") :includes name))
                     (try (setq kind (Object/getOwnPropertyDescriptor error "kind")) (catch ignored nil)))
                   (if (and kind (Object/hasOwn kind "value")
                            (or (= (get kind :value) 13) (= (get kind :value) 35)))
                     (let ((decoded error) (owned false))
                       ;; pin authenticates against the runtime's private
                       ;; handles before acquiring a temporary root. A plain
                       ;; object with a matching kind is never decoded/released.
                       (try (js-call runtime :pin error) (setq owned t) (catch ignored nil))
                       (unless owned (throw error))
                       (try (js-call runtime :release error) (catch ignored nil))
                       ;; The original invoke owner remains live for decode.
                       ;; Release exactly that root before hostCall releases
                       ;; its arguments; secondary failures preserve the throw.
                       (try (setq decoded (js-call runtime :toHostValue error)) (catch ignored nil))
                       (try (js-call runtime :release error) (catch ignored nil))
                       (throw decoded))
                     (throw error))))))))
      (Object/defineProperties wrapped (js-object
        :name (Object/getOwnPropertyDescriptor invoke "name") :length (Object/getOwnPropertyDescriptor invoke "length")))
      (put entry :value wrapped)
      (Object/defineProperties facade descriptors)
      (unless (Reflect/isExtensible runtime) (Object/preventExtensions facade)) facade))
  (defun createWireProjectFixture ()
    (let ((directories (js-array)))
      (js-object
        :options (async (descriptor settings)
          (if (or (not (get descriptor :project))
                  (not (eq (get settings :projectModuleBaseURL) undefined))) settings
            (let* ((entry (if (nullish? (get settings :projectEntry))
                           (get (get descriptor :project) :entry) (get settings :projectEntry)))
                   (facades (createManagedProjectFacades descriptor (js-object
                     :entry entry :privateDirectory (get settings :projectPrivateDirectory))))
                   (directory (await (mkdtemp (resolve (tmpdir) "eliscript-wire-project-facades-"))))
                   (files (get facades :files)) (index 0))
              (js-call directories :push directory)
              (while (< index (js-length files))
                (let* ((file (aref files index)) (path (resolve directory (get file :id))))
                  (await (mkdir (dirname path) (js-object :recursive t)))
                  (await (writeFile path (get file :source))))
                (setq index (1+ index)))
              (Object/assign (js-object) settings
                (js-object :projectModuleBaseURL (get (pathToFileURL (+ directory "/")) :href)
                  :moduleGraph (createManagedModuleGraph descriptor))))))
        :close (async ()
          (while (> (js-length directories) 0)
            (await (rm (js-call directories :pop) (js-object :recursive t :force t))))))))
  (defun observeWireRuntimeFailures (runtime report)
    (unless (= (value-type report) "function")
      (throw (new globalThis.TypeError "wire failure observation requires its actual reporter")))
    (let* ((descriptors (Object/getOwnPropertyDescriptors runtime))
           (facade (Object/create (Object/getPrototypeOf runtime))) (reported false)
           (observe (lambda (method arguments error)
             (unless reported
               (setq reported t)
               (try (funcall report method arguments error) (catch ignored nil))))))
      (js-call (js-array "invoke" "invokeAsync" "readString" "toHostValue") :forEach (lambda (method)
        (let ((entry (get descriptors method)))
          (when (and entry (Object/hasOwn entry "value") (= (value-type (get entry :value)) "function"))
            (let* ((original (get entry :value))
                   (wrapped (lambda (&rest arguments)
                     (try
                       (let ((result (Reflect/apply original runtime arguments)))
                         (when (= method "invokeAsync")
                           (js-call result :then undefined (lambda (error) (funcall observe method arguments error))))
                         result)
                       (catch error (funcall observe method arguments error) (throw error))))))
              (Object/defineProperties wrapped (js-object
                :name (Object/getOwnPropertyDescriptor original "name")
                :length (Object/getOwnPropertyDescriptor original "length")))
              (put entry :value wrapped))))))
      (Object/defineProperties facade descriptors)
      (unless (Reflect/isExtensible runtime) (Object/preventExtensions facade)) facade))
  (defun diagnoseWireRoundtrip (runtime source)
    ;; Explicit failure diagnosis only: retain the complete graph/runtime and
    ;; derive every smaller input from the real first failed original input.
    (let* ((input (JSON/parse source)) (rows (js-array (js-array "complete-original-input" input)))
           (user (get input :User)))
      (js-call (Object/entries input) :forEach (lambda (entry)
        (js-call rows :push (js-array (str "top:" (aref entry 0))
          (Object/fromEntries (js-array entry))))))
      (when (and user (= (value-type user) "object"))
        (let ((cumulative (js-object)))
          (js-call (Object/entries user) :forEach (lambda (entry)
            (Object/defineProperty cumulative (aref entry 0)
              (js-object :value (aref entry 1) :writable t :configurable t :enumerable t))
            (js-call rows :push (js-array (str "User:" (aref entry 0))
                (js-object :User (Object/fromEntries (js-array entry))))
              (js-array (str "User-prefix:" (aref entry 0))
                (js-object :User (Object/assign (js-object) cumulative))))))))
      (js-call rows :forEach (lambda (row)
        (let ((argument (js-call runtime :string (JSON/stringify (aref row 1)))) (result undefined))
          (try
            (setq result (js-call runtime :invoke "roundtrip-report" (js-array argument)))
            (js-call globalThis.console :error "wire branch diagnostic" (aref row 0) "returned"
              (js-call runtime :readString result))
            (catch error
              (js-call globalThis.console :error "wire branch diagnostic" (aref row 0) "threw"
                (get error :name) (get error :message)
                (let ((diagnostic (get error :eliscriptDiagnostic))) (if diagnostic (get diagnostic :code) undefined)))
              (when (and error (Object/hasOwn error "kind"))
                (try (js-call runtime :release error) (catch ignored nil))))
            (finally
              (when (not (undefined? result)) (js-call runtime :release result))
              (js-call runtime :release argument) (js-call runtime :collect))))))))
  (defun observeWireHTTPPromise (name operation report)
    (letfn ((notice (phase &rest values)
      (try (funcall report (js-object :name name :phase phase :value (aref values 0))) (catch ignored nil))))
      (notice "start")
      (try
        (let ((result (funcall operation)))
          (js-call result :then (lambda (value) (notice "resolve") undefined)
            (lambda (error) (notice "reject" error) undefined))
          result)
        (catch error (notice "throw" error) (throw error)))))

  ;; Exact HTTP contract from the retained original wire suite. Diagnostic
  ;; execution is separate from acceptance of that complete five-test suite.
  (defasync verifyOriginalWireHTTPContracts (api report)
    (let ((createService (get api :createService)) (createClient (get api :createClient))
          (discoveryCandidates (get api :discoveryCandidates)) (pathIndexMarkdown (get api :pathIndexMarkdown))
          (calls 0) (posts 0) (requests 0))
      (letfn ((step (name operation) (observeWireHTTPPromise name operation report)))
        (let* ((service (funcall createService (js-object :title "Example" :operations (js-array
                 (js-object :path "/math/add" :title "Add" :request "JSON a,b" :success "200 JSON sum" :effect "Read only"
                   :execute (async (request) (setq calls (1+ calls))
                     (let ((body (await (js-call request :json))))
                       (js-call globalThis.Response :json (js-object :sum (+ (get body :a) (get body :b)))))))
                 (js-object :path "/math" :title "Math" :execute (lambda () (new globalThis.Response "math")))))))
               (transport (lambda (url settings) (funcall service (new globalThis.Request url settings))))
               (client (funcall createClient (js-object :fetch transport)))
               (discovery (await (step "hierarchical.discover" (lambda () (js-call client :discover "https://example.test/"))))))
          (js-call assert :equal (get discovery :state) "found")
          (js-call assert :deepEqual (Array/from (get discovery :paths)) (js-array "/math"))
          (let ((index (await (step "hierarchical.index" (lambda () (js-call client :index "https://example.test/math?secret=removed"))))))
            (js-call assert :match (get index :body) (new globalThis.RegExp "operation and directory" "u"))
            (js-call assert :match (get index :body) (new globalThis.RegExp "`/math/add`" "u")))
          (js-call assert :match (get (await (step "hierarchical.usage" (lambda () (js-call client :usage "https://example.test/math/add?.gepo&x=1")))) :body)
            (new globalThis.RegExp "POST `/math/add`" "u"))
          (js-call assert :equal calls 0)
          (await (js-call assert :rejects (step "invoke.permission" (lambda () (js-call client :invoke "https://example.test/math/add" "{}")))))
          (js-call assert :equal calls 0)
          (let ((reply (await (step "invoke.reply" (lambda () (js-call client :invoke "https://example.test/math/add" "{\"a\":2,\"b\":3}"
                   (js-object :allowPost t :contentType "application/json")))))))
            (js-call assert :deepEqual (JSON/parse (get reply :body)) (js-object :sum 5)))
          (js-call assert :equal calls 1)
          (js-call assert :equal (get (await (step "service.discovery-false" (lambda () (funcall service (new globalThis.Request "https://example.test/math/add?.gepo=false"))))) :status) 200)
          (js-call assert :equal (get (await (step "service.head" (lambda () (funcall service (new globalThis.Request "https://example.test/math/add" (js-object :method "HEAD")))))) :body) nil)
          (let ((head (await (step "service.head-index" (lambda () (funcall service (new globalThis.Request "https://example.test/.gepo" (js-object :method "HEAD"))))))))
            (js-call assert :equal (get head :status) 200) (js-call assert :equal (get head :body) nil))
          (js-call assert :equal (js-call (get (await (step "service.options" (lambda () (funcall service (new globalThis.Request "https://example.test/.gepo" (js-object :method "OPTIONS")))))) :headers) :get "Allow") "GET, HEAD, OPTIONS")
          (js-call assert :equal (get (await (step "service.post-index" (lambda () (funcall service (new globalThis.Request "https://example.test/.gepo" (js-object :method "POST")))))) :status) 405)
          (js-call assert :equal (get (await (step "service.delete" (lambda () (funcall service (new globalThis.Request "https://example.test/math" (js-object :method "DELETE")))))) :status) 405))
        (let* ((urls (js-array))
               (fallback (funcall createClient (js-object :fetch (async (url settings)
                 (js-call urls :push (funcall globalThis.String url)) (js-call assert :equal (get settings :redirect) "manual")
                 (if (= (js-length urls) 1) (new globalThis.Response "<html>GEPO</html>" (js-object :headers (js-object :Content-Type "text/html")))
                   (new globalThis.Response (funcall pathIndexMarkdown "Empty" (js-array) "/") (js-object :headers (js-object :Content-Type "text/markdown")))))))))
          (js-call assert :equal (get (await (step "fallback.discover" (lambda () (js-call fallback :discover "https://example.test/?secret=x#fragment")))) :state) "empty")
          (js-call assert :deepEqual urls (js-array "https://example.test/?.gepo" "https://example.test/.gepo"))
          (js-call assert :equal (aref (funcall discoveryCandidates "https://example.test/a?secret=x") 0) "https://example.test/a?.gepo")
          (let* ((service (funcall createService (js-object :operations (js-array (js-object :path "/" :execute (lambda () (new globalThis.Response "root")))))))
                 (client (funcall createClient (js-object :fetch (lambda (url settings) (funcall service (new globalThis.Request url settings)))))))
            (js-call assert :equal (get (await (step "root.discover" (lambda () (js-call client :discover "https://example.test")))) :state) "found"))
          (js-call assert :throws (lambda () (funcall createService (js-object :operations (js-array (js-object :path "/a/../b" :execute (lambda () undefined)))))))
          (await (js-call assert :rejects (step "credentials.reject" (lambda () (js-call fallback :discover "https://user:password@example.test"))))))
        (let* ((forbiddenCalls 0)
               (forbidden (funcall createService (js-object :operations (js-array (js-object :path "/private" :execute (lambda () (setq forbiddenCalls (1+ forbiddenCalls)) (new globalThis.Response "done")))) :authorize (lambda () false)))))
          (js-call assert :equal (get (await (step "authorization.reject" (lambda () (funcall forbidden (new globalThis.Request "https://example.test/private" (js-object :method "POST")))))) :status) 403)
          (js-call assert :equal forbiddenCalls 0))
        (let ((bounded (funcall createClient (js-object :fetch (async () (new globalThis.Response "12345")) :maxBytes 4))))
          (await (js-call assert :rejects (step "body.limit" (lambda () (js-call bounded :usage "https://example.test/a"))) (new globalThis.RegExp "limit" "u"))))
        (let ((redirect (funcall createClient (js-object :fetch (async () (new globalThis.Response nil (js-object :status 302 :headers (js-object :Location "https://elsewhere.test/"))))))))
          (await (js-call assert :rejects (step "redirect.reject" (lambda () (js-call redirect :usage "https://example.test/a"))) (new globalThis.RegExp "Redirect" "u"))))
        (let* ((loss (funcall createClient (js-object :fetch (async (url settings)
                 (if (= (get settings :method) "POST") (progn (setq posts (1+ posts)) (throw (new globalThis.Error "lost"))) (new globalThis.Response "usage")))))))
          (await (js-call assert :rejects (step "lost-post.reject" (lambda () (js-call loss :invoke "https://example.test/a" "" (js-object :allowPost t)))) (new globalThis.RegExp "lost" "u")))
          (js-call assert :equal posts 1))
        (let ((timeout (funcall createClient (js-object :fetch (lambda () (new globalThis.Promise (lambda () undefined))) :timeoutMs 10))))
          (await (js-call assert :rejects (step "timeout.never-fetch" (lambda () (js-call timeout :usage "https://example.test/a"))) (new globalThis.RegExp "timeout" "u"))))
        (let ((stalledBody (funcall createClient (js-object :fetch (async () (new globalThis.Response (new globalThis.ReadableStream (js-object :pull (lambda () undefined))))) :timeoutMs 10))))
          (await (js-call assert :rejects (step "timeout.stalled-body" (lambda () (js-call stalledBody :usage "https://example.test/a"))) (new globalThis.RegExp "timeout" "u"))))
        (let ((aborted (new globalThis.AbortController)))
          (js-call aborted :abort (new globalThis.Error "cancelled"))
          (let ((cancelled (funcall createClient (js-object :fetch (async () (setq requests (1+ requests)) (new globalThis.Response "bad"))))))
            (await (js-call assert :rejects (step "abort.already-cancelled" (lambda () (js-call cancelled :usage "https://example.test/a" (js-object :signal (get aborted :signal))))) (new globalThis.RegExp "cancelled" "u"))))
          (js-call assert :equal requests 0))
        (let ((identity (funcall createService (js-object :operations (js-array
                  (js-object :path "/public/read" :execute (lambda () (js-call globalThis.Response :json (js-object :ok t))))
                  (js-object :path "/private/read" :execute (lambda () (new globalThis.Response "secret"))))
                :visible (lambda (request operation) (or (not (js-call (get operation :path) :startsWith "/private")) (= (js-call (get request :headers) :get "Authorization") "example-user")))
                :authorize (lambda (request) (if (/= (get request :method) "POST") t (new globalThis.Response "Sign in" (js-object :status 401))))))))
          (let ((publicIndex (await (js-call (await (step "visibility.public" (lambda () (funcall identity (new globalThis.Request "https://example.test/?.gepo"))))) :text))))
            (js-call assert :match publicIndex (new globalThis.RegExp "`/public`" "u"))
            (funcall assert (not (js-call publicIndex :includes "/private"))))
          (let ((privateIndex (await (js-call (await (step "visibility.private" (lambda () (funcall identity (new globalThis.Request "https://example.test/?.gepo" (js-object :headers (js-object :Authorization "example-user"))))))) :text))))
            (js-call assert :match privateIndex (new globalThis.RegExp "`/private`" "u")))
          (js-call assert :equal (get (await (step "authorization.response" (lambda () (funcall identity (new globalThis.Request "https://example.test/public/read" (js-object :method "POST")))))) :status) 401))
        (let* ((notFound (funcall createClient (js-object :fetch (async () (new globalThis.Response "ordinary site")))))
               (failure (await (step "discovery.not-found" (lambda () (js-call notFound :discover "https://example.test"))))))
          (js-call assert :equal (get failure :state) "not-found") (js-call assert :equal (js-length (get failure :attempts)) 3))
        (let ((json (funcall createClient (js-object :fetch (async () (js-call globalThis.Response :json (js-object :protocol "GEPO" :children (js-array "/api"))))
                  :classify (lambda (response) (let ((body (JSON/parse (get response :body))))
                    (js-object :accepted (= (get body :protocol) "GEPO") :paths (get body :children) :empty (= (js-length (get body :children)) 0))))))))
          (js-call assert :deepEqual (Array/from (get (await (step "discovery.classifier" (lambda () (js-call json :discover "https://example.test")))) :paths)) (js-array "/api")))
        (js-object :hierarchical t :fallback t :authorization t :bounds t :redirects t :lostPosts posts :timeouts t :cancelledRequests requests :visibility t :customClassifier t))))
  (defun createWireHTTPProgressObserver (report)
    (let ((sequence 0) (next-id 0) (pending (new globalThis.Map)) (timers (new globalThis.Map)))
      (letfn (
        (notice (phase detail)
          (try (funcall report (Object/assign (js-object :sequence sequence :phase phase
            :pending (Array/from (js-call pending :values))) detail)) (catch ignored nil))
          (setq sequence (1+ sequence)))
        (wrap-call (label operation receiver)
          (lambda (&rest args)
            (let* ((id next-id) (record (js-object :id id :operation label
                    :callsite (get (new globalThis.Error "original wire HTTP await") :stack))))
              (setq next-id (1+ next-id)) (js-call pending :set id record) (notice "start" record)
              (try
                (let ((result (Reflect/apply operation receiver args)))
                  ;; Return the exact original Promise; observe settlement on a
                  ;; separate chain, never replace its value or rejection.
                  (Reflect/apply globalThis.Promise.prototype.then result
                    (js-array (lambda (value) (js-call pending :delete id) (notice "resolve" record))
                      (lambda (error) (js-call pending :delete id) (notice "reject" record)))) result)
                (catch error (js-call pending :delete id) (notice "throw" record) (throw error))))))
        (service (value) (wrap-call "service" value undefined))
        (client (value)
          (let ((facade (Object/create value)))
            (js-call (js-array "discover" "index" "usage" "invoke") :forEach (lambda (name)
              (let ((method (get value name)))
                (when (= (value-type method) "function")
                  (Object/defineProperty facade name (js-object :value (wrap-call (str "client." name) method value))))))) facade))
        (platform (original)
          (let* ((globals (get original :globals)) (descriptors (Object/getOwnPropertyDescriptors globals))
                 (observed (Object/create (Object/getPrototypeOf globals))))
            (put descriptors :setTimeout (js-object :enumerable t :value (lambda (callback delay &rest arguments)
              (let* ((id next-id) (record (js-object :id id :delay delay
                       :callsite (get (new globalThis.Error "original wire HTTP business timer") :stack)))
                     (wrapped (lambda (&rest values)
                       (notice "timer-fired" record) (Reflect/apply callback (js* "globalThis") values)))
                     (token (Reflect/apply (get globals :setTimeout) (js* "globalThis")
                       (js-call (js-array wrapped delay) :concat arguments))))
                (setq next-id (1+ next-id)) (js-call timers :set token record) (notice "timer-scheduled" record) token))))
            (put descriptors :clearTimeout (js-object :enumerable t :value (lambda (token)
              (let ((record (js-call timers :get token)))
                (when record (notice "timer-cleared" record) (js-call timers :delete token))
                (Reflect/apply (get globals :clearTimeout) (js* "globalThis") (js-array token))))))
            (Object/defineProperties observed descriptors)
            (Object/assign (js-object) original (js-object :globals (Object/freeze observed)
              :readHttpGlobal (lambda (name)
                (if (or (= name "setTimeout") (= name "clearTimeout")) (get observed name)
                  (js-call original :readHttpGlobal name)))))))
        (runtime (original)
          (let* ((descriptors (Object/getOwnPropertyDescriptors original)) (facade (Object/create (Object/getPrototypeOf original)))
                 (names (new globalThis.Map)) (invoke (get original :invoke)) (decode (get original :toHostValue)))
            (put (get descriptors :invoke) :value (lambda (name &rest arguments)
              (let ((result (Reflect/apply invoke original (js-call (js-array name) :concat arguments))))
                (when (or (= name "http-service") (= name "http-client")) (js-call names :set result name)) result)))
            (put (get descriptors :toHostValue) :value (lambda (value)
              (let ((name (js-call names :get value)) (result (Reflect/apply decode original (js-array value))))
                (js-call names :delete value)
                (cond ((= name "http-service") (service result)) ((= name "http-client") (client result)) (t result)))))
            (Object/defineProperties facade descriptors) facade)))
        (js-object :service service :client client :platform platform :runtime runtime))))
