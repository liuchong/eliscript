(module tools.testing.source-debugging
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:path" resolve)
  (import "node:timers" setTimeout clearTimeout)
  (import "../../bootstrap/host/bun.mjs" loadCompiler)
  (import "../../bootstrap/host/evaluation.mjs" EvaluationSession)
  (import "../../runtime/source-mapping.mjs" SourceMappingError mapSourceFrames parseJavaScriptStack sourceMapDescriptor)
  (import "../debugging/check.mjs" checkSourceDebuggingCorpus SourceDebuggingCorpusError validateSourceDebuggingCorpus)
  (import "./fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../backends/build.mjs" :as backend)
  ;; A selected program keeps its emitted compiler directory, while fixtures,
  ;; package scope and original assertions belong to its authenticated sources.
  (defconst root (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT
                     (get backend :root)))
  (defconst sourceDebuggingCaseTitles (js-array
    "source mapping decodes V8 and browser stack dialects without a host API"
    "compiler failure preserves its complete Eliscript source span"
    "runtime failure maps through persistent evaluation"
    "browser event and async rejection map under Bun and Node"
    "source debugging corpus is complete and rejects evidence drift"))
  (defconst case-ids (js-array "stack" "compiler" "runtime" "browser" "corpus"))
  (defun options-from (arguments) (if (undefined? (aref arguments 0)) (js-object) (aref arguments 0)))
  (defasync contract () (JSON/parse (await (readFile (resolve root "contracts/source-debugging-corpus.json") "utf8"))))
  (defun acceptance-case (value id)
    (let ((entry (js-call (get value :cases) :find (lambda (candidate) (= (get candidate :id) id)))))
      (unless entry (throw (new globalThis.Error (str "missing source debugging case " id)))) entry))
  (defun presentDebuggingCommandResult (command result &rest arguments)
    (let ((expected (if (undefined? (aref arguments 0)) 0 (aref arguments 0))))
      (unless (= (get result :exitCode) expected)
        (let ((error (new globalThis.Error (str "source debugging child " (JSON/stringify command)
                       " exited with " (get result :exitCode) "; expected " expected
                       "\nchild stderr:\n" (get result :stderr) "\nchild stdout:\n" (get result :stdout)))))
          (put error :childResult result) (throw error))) result))
  (defasync run-command (command options &rest arguments)
    (let* ((requested (options-from arguments))
           (environment (Object/assign (js-object) (get globalThis.process :env) (get requested :env)))
           (directory (get options :compilerDirectory)))
      (when (and (= (aref command 0) "./bin/eliscript") (not (undefined? directory)))
        (put environment :ELISCRIPT_BOOTSTRAP_MODULE_DIR directory))
      (let* ((child (Bun/spawn command (js-object :cwd root :stdout "pipe" :stderr "pipe" :env environment)))
             (values (await (Promise/all (js-array (get child :exited)
               (js-call (new globalThis.Response (get child :stdout)) :text)
               (js-call (new globalThis.Response (get child :stderr)) :text)))))
             (result (js-object :exitCode (aref values 0) :stdout (aref values 1) :stderr (aref values 2))))
        (presentDebuggingCommandResult command result (get requested :expectedExit)))))
  (defun stack-case ()
    (let* ((descriptor (sourceMapDescriptor (js-object :generatedFile "https://example.test/program.mjs"
                         :sources (js-array "https://example.test/program.eli") :mappings "AAAA")))
           (frames (parseJavaScriptStack (js-call (js-array "Error: broken"
                     "    at run (https://example.test/program.mjs?rev=1:1:1)"
                     "event@https://example.test/program.mjs#loaded:1:1") :join "\n"))))
      (js-call assert :deepStrictEqual (mapSourceFrames frames (js-array descriptor)) (js-array
        (js-object :function "run" :file "https://example.test/program.eli" :line 1 :column 1
          :generated (js-object :file "https://example.test/program.mjs?rev=1" :line 1 :column 1))
        (js-object :function "event" :file "https://example.test/program.eli" :line 1 :column 1
          :generated (js-object :file "https://example.test/program.mjs#loaded" :line 1 :column 1))))
      (js-call assert :throws (lambda () (sourceMapDescriptor
        (js-object :generatedFile "broken.mjs" :sources (js-array "broken.eli") :mappings "!"))) SourceMappingError)))
  (defasync compiler-case (options)
    (let* ((value (await (contract))) (entry (acceptance-case value "compiler"))
           (result (await (run-command (js-array "./bin/eliscript" "--diagnostic-format" "json" (get entry :source))
                     options (js-object :expectedExit 1))))
           (diagnostic (JSON/parse (get result :stderr))))
      (js-call assert :strictEqual (get result :exitCode) 1)
      (js-call assert :strictEqual (get result :stdout) "")
      (js-call assert :strictEqual (get (get diagnostic :location) :file) (resolve root (get entry :source)))
      (js-call assert :deepStrictEqual (get (get diagnostic :location) :start) (get (get entry :location) :start))
      (js-call assert :deepStrictEqual (get (get diagnostic :location) :end) (get (get entry :location) :end))))
  (defasync runtime-case (options)
    (let* ((value (await (contract))) (entry (acceptance-case value "runtime"))
           (compiler (await (loadCompiler (get options :compilerDirectory))))
           (session (await (js-call EvaluationSession :create (js-object :compiler compiler))))
           (fixture (resolve root "tests/fixtures/evaluation-session/main.eli")))
      (try
        (let ((source (await (readFile fixture "utf8"))))
          (js-call assert :strictEqual (get (await (js-call session :execute
            (js-object :id 1 :operation "load" :source source :filename fixture :root root))) :status) "ok")
          (let ((failure (await (js-call session :execute (js-object :id 2 :operation "evaluate" :source "(explode)" :filename fixture)))))
            (js-call assert :strictEqual (get failure :status) "error")
            (js-call assert :deepStrictEqual (get (get failure :diagnostic) :location)
              (Object/assign (js-object :file (resolve root (get entry :source))) (get entry :location)))
            (js-call assert :strictEqual (js-call (get (get (get failure :diagnostic) :location) :file) :endsWith ".mjs") false)))
        (finally (js-call session :close)))))
  (defasync browser-case (options)
    (let* ((value (await (contract)))
           (fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
           (directory (await (mkdtemp (resolve (get fixture :directory) "eliscript-source-debugging-")))))
      (try
        (let* ((module-file (resolve directory "source-debugging.mjs"))
               (built (await (run-command (js-array "./bin/eliscript" "--source-map" "--output" module-file
                         (resolve root "tests/fixtures/source-debugging.eli")) options)))
               (environment (Object/assign (js-object) (get globalThis.process :env)
                 (js-object :ELISCRIPT_DEBUG_MODULE module-file :ELISCRIPT_DEBUG_SOURCE_MAP (str module-file ".map"))))
               (host (resolve root "tests/fixtures/source-debugging-host.mjs"))
               (results (await (Promise/all (js-array
                 (run-command (js-array (get globalThis.process :execPath) host) options (js-object :env environment))
                 (run-command (js-array "node" host) options (js-object :env environment)))))))
          (js-call assert :strictEqual (get built :exitCode) 0)
          (js-call assert :strictEqual (get built :stderr) "")
          (js-call results :forEach (lambda (result)
            (js-call assert :strictEqual (get result :exitCode) 0)
            (js-call assert :strictEqual (get result :stderr) "")
            (let ((failures (JSON/parse (get result :stdout))))
              (js-call assert :deepStrictEqual (js-call failures :map (lambda (item) (get item :kind)))
                (js-array "browser-event" "async-rejection"))
              (js-call failures :forEach (lambda (item)
                (let* ((entry (acceptance-case value (get item :kind))) (location (get (get item :failure) :location))
                       (expected (Object/assign (js-object :file (resolve root (get entry :source))) (get entry :location))))
                  (js-call (Object/keys expected) :forEach (lambda (key)
                    (js-call assert :deepStrictEqual (get location key) (get expected key))))
                  (js-call assert :ok (js-call (get (get location :generated) :file) :includes ".mjs"))
                  (js-call assert :strictEqual (js-call (get location :file) :endsWith ".eli") t))))))))
        (finally (await (rm directory (js-object :recursive t :force t))) (js-call fixture :close)))))
  (defasync corpus-case ()
    (let ((checked (await (checkSourceDebuggingCorpus (js-object :root root)))))
      (js-call assert :deepStrictEqual (js-call (get checked :cases) :map (lambda (entry) (get entry :id)))
        (js-array "compiler" "runtime" "browser-event" "async-rejection" "worker")))
    (let ((changed (await (contract))))
      (js-call (get changed :cases) :pop)
      (await (js-call assert :rejects (validateSourceDebuggingCorpus changed (js-object :root root)) SourceDebuggingCorpusError))))
  (defasync runSourceDebuggingCase (id &rest arguments)
    (let ((options (options-from arguments)))
      (cond ((= id "stack") (stack-case)) ((= id "compiler") (await (compiler-case options)))
        ((= id "runtime") (await (runtime-case options))) ((= id "browser") (await (browser-case options)))
        ((= id "corpus") (await (corpus-case)))
        (t (throw (new globalThis.TypeError (str "unknown original source debugging case " id)))))))
  (defasync runSourceDebuggingAcceptance (&rest arguments)
    (let ((options (options-from arguments)) (index 0))
      (while (< index (js-length case-ids))
        (let ((timer undefined))
          (try
            (await (Promise/race (js-array (runSourceDebuggingCase (aref case-ids index) options)
              (new globalThis.Promise (lambda (accept reject)
                (setq timer (setTimeout (lambda () (funcall reject (new globalThis.Error
                  (str (aref sourceDebuggingCaseTitles index) " exceeded its original 5000 ms timeout")))) 5000)))))))
            (finally (clearTimeout timer))))
        (setq index (1+ index)))))
  (export sourceDebuggingCaseTitles presentDebuggingCommandResult runSourceDebuggingCase runSourceDebuggingAcceptance))
