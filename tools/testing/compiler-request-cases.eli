(module tools.testing.compiler-request-cases
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "node:url" pathToFileURL)
  (import "../../dist/bootstrap/compiler.mjs" compile-string compile-ir-string)
  (import "../../dist/bootstrap/emitter.mjs" emit-expression)
  (import "./maintained-suite-source.mjs" maintainedSuiteSource sourceCall sourceFormText rewriteSourceForms compileMaintainedSuite)
  (defconst compilerRequestSuite "tests/compiler-package-session.test.mjs")
  (defconst compilerRequestSuiteSha "1560a8e4862a96cb959b494382be66ce4b738e39e96532fe7211a9417ee1cd28")
  (defvar active undefined)
  (defun compilerRequestModes ()
    (if (undefined? active) (js-array "original" "package") (js-array (get active :mode))))
  (defun compilerRequestTargets (targets)
    (if (undefined? active) targets
      (progn
        (unless (js-call targets :includes (get active :target))
          (throw (new globalThis.TypeError "request case target does not belong to its original operation")))
        (js-array (get active :target)))))
  (defun replace-once (source before after)
    (let ((at (js-call source :indexOf before)))
      (unless (and (>= at 0) (= (js-call source :indexOf before (1+ at)) -1))
        (throw (new globalThis.TypeError "compiler request partition source boundary changed")))
      (str (js-call source :slice 0 at) after (js-call source :slice (+ at (js-length before))))))
    (defun projectCompilerRequestSuite (root source)
    (unless (= (js-call (js-call (createHash "sha256") :update source) :digest "hex") compilerRequestSuiteSha)
      (throw (new globalThis.TypeError "compiler request partition requires the complete original suite")))
    (let* ((maintained (maintainedSuiteSource root compilerRequestSuite source))
           (modes 0) (targets 0)
           (projected (rewriteSourceForms maintained
             (lambda (node node-text)
               (let ((items (get node :items)))
                 (cond
                   ((and (sourceCall node "js-array") (= (js-length items) 3)
                         (= (get (aref items 1) :value) "original") (= (get (aref items 2) :value) "package"))
                     (setq modes (1+ modes)) "(compilerRequestModes)")
                   ((and (Array/isArray items) (= (js-length items) 2)
                         (= (get (aref items 1) :name) "targets")
                         (= (value-type (get (aref items 0) :name)) "string")
                         (js-call (get (aref items 0) :name) :endsWith "_sequence"))
                     (setq targets (1+ targets))
                     (str "(" (funcall node-text (aref items 0)) " (compilerRequestTargets targets))"))
                   (t undefined)))))))
      (unless (and (= modes 3) (= targets 1))
        (throw (new globalThis.TypeError "compiler request partition source boundary changed")))
      (compileMaintainedSuite (get projected :source) compilerRequestSuite
        (str "(import " (JSON/stringify (get (pathToFileURL (resolve root "tools/testing/compiler-request-cases.mjs")) :href))
          " compilerRequestModes compilerRequestTargets)"))))

  (defun isCompilerRequestFixture (root argument environment)
    (let ((directory (get environment :ELISCRIPT_TEST_FIXTURE_DIRECTORY)))
      (and (= (value-type directory) "string")
        (= (resolve root argument) (resolve directory "initializer-source" compilerRequestSuite))
        (= (readFileSync (resolve root argument) "utf8")
          (projectCompilerRequestSuite root (readFileSync (resolve root compilerRequestSuite) "utf8"))))))
  (defun compilerRequestTestRegistration (original)
    (new globalThis.Proxy original (js-object
      :apply (lambda (target receiver arguments)
        (let* ((title (aref arguments 0))
               (match (and (= (value-type title) "string")
                 (js-call (new globalThis.RegExp "^Given the original and relocated javascript compiler When (bun|node) CLI request submits (emit-ir|project-ir) Then real products sidecars and recovery preserve their ABI$") :exec title))))
          (if (not match) (Reflect/apply target receiver arguments)
            (progn
              (unless (and (= (js-length arguments) 3) (= (aref arguments 2) 120000))
                (throw (new globalThis.TypeError "compiler request original callback deadline changed")))
              (let ((callback (aref arguments 1)) (targets (if (= (aref match 2) "project-ir")
                       (js-array "javascript" "wasm" "native") (js-array "wasm" "native"))))
                (js-call (js-array "original" "package") :forEach (lambda (mode)
                  (js-call targets :forEach (lambda (output)
                    (Reflect/apply target receiver (js-array (str title " [" mode "/" output "]")
                      (async ()
                        (unless (undefined? active) (throw (new globalThis.Error "compiler request partitions must execute independently")))
                        (setq active (js-object :mode mode :target output))
                        (try (await (funcall callback)) (finally (setq active undefined))))
                      ;; The existing 120s deadline now bounds one original
                      ;; artifact/output pair, with 240s for native codegen.
                      (if (= output "native") 240000 120000))))))))))))
      :get (lambda (target key receiver)
        (let ((value (Reflect/get target key target)))
          (if (= (value-type value) "function") (js-call value :bind target) value))))))
  (export compilerRequestSuite compilerRequestModes compilerRequestTargets projectCompilerRequestSuite isCompilerRequestFixture compilerRequestTestRegistration))
