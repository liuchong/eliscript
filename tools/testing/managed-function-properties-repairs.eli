(module tools.testing.managed-function-properties-repairs
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../backends/build.mjs" root)
  (import "../backends/managed-runtime.mjs" instantiateManagedRuntime readManagedModuleMetadata)
  (import "./fixture-environment.mjs" prepareFixtureEnvironment)
  (import "./generated-fixture-module.mjs" loadGeneratedFixture)
  (import "../../tests/helpers/managed-browser-transport.mjs" writeManagedReference)
  (defconst functionInitializationPressureTitle "manual initialization retains its capacity refusal and complete cleanup while the same bytes initialize under collecting GC")
  (defconst functionMissingDisposalTitle "a host missing a represented disposal symbol rejects transfer and preserves caller roots and supported identities")
  (defconst wellKnownSymbolNames (js-array "iterator" "toPrimitive" "match" "replace" "search" "split" "species"
    "isConcatSpreadable" "toStringTag" "hasInstance" "asyncIterator" "unscopables" "matchAll" "dispose" "asyncDispose"))
  (defun read (a value)
    (cond ((and (not (nullish? value)) (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and (not (nullish? value)) (= (get value :kind) 5)) (js-call a :readString value))
      ((and (not (nullish? value)) (= (get value :kind) 14))
        (Array/from (js-object :length (js-call a :length value)) (lambda (ignored index)
          (let ((child (js-call a :get value index))) (try (read a child) (finally (js-call a :release child)))))))
      (t value)))
  (defun value (a name arguments)
    (let ((result (js-call a :invoke name arguments))) (try (read a result) (finally (js-call a :release result)))))
  (defun finish (a)
    (js-call a :closeModule) (js-call a :collect)
    (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (defun image (backend runtime program)
    (let* ((saved (JSON/stringify program)) (lowered (js-call (get backend :managed) :lower_managed_program program runtime))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
           (module (new globalThis.WebAssembly.Module bytes))
           (sections (globalThis.WebAssembly.Module.customSections module "eliscript-managed-control")))
      (js-call assert :strictEqual (JSON/stringify program) saved)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports module) (js-array))
      (js-call assert :strictEqual (js-length sections) 1)
      (js-call assert :deepStrictEqual (readManagedModuleMetadata module "eliscript-managed-control") (get lowered :descriptor))
      (js-object :bytes bytes :descriptor (get lowered :descriptor))))
  (defasync runFunctionInitializationSemantics (backend runtime program)
    (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
           (compiled (image backend runtime program)) (bytes (get compiled :bytes)))
      (try
        (let* ((js (await (loadGeneratedFixture (get fixture :directory) (js-call (get backend :compiler) :emit_ir_string program) "function-properties-oracle")))
               (unpressured (instantiateManagedRuntime bytes (js-object :initializeModule false))))
          (try
            (progn
              (js-call unpressured :initializeModule)
              (js-call assert :strictEqual (get (js-call unpressured :stats) :collections) 0)
              (js-call assert :ok (> (js-call unpressured :live) 0))
              (js-call assert :strictEqual (get (js-call unpressured :stats) :frameDepth) 0)
              (js-call unpressured :collect)
              (js-call assert :deepStrictEqual (value unpressured "cached" (js-array)) (js-call js :cached)))
            (finally (finish unpressured)))
          (let ((collecting (instantiateManagedRuntime bytes (js-object :initializeModule false))))
            (try
              (progn
                (let ((index 0)) (while (< index 1024)
                  (let ((item (js-call collecting :number 7))) (js-call collecting :release item))
                  (setq index (1+ index))))
                (js-call assert :strictEqual (js-call collecting :live) 1024)
                (js-call assert :strictEqual (get (js-call collecting :stats) :collections) 0)
                (js-call collecting :auto 1) (js-call collecting :initializeModule)
                (js-call assert :deepStrictEqual (value collecting "cached" (js-array)) (js-call js :cached))
                (js-call assert :strictEqual (get (js-call collecting :stats) :frameDepth) 0)
                (js-call collecting :collect)
                (js-call assert :ok (> (js-call collecting :live) 0))
                (js-call assert :ok (< (js-call collecting :live) 1024)))
              (finally (finish collecting)))))
        (finally (js-call fixture :close)))))
  (defun relocateHostImports (program replacement)
    (letfn ((walk (nodes)
      (js-call nodes :forEach (lambda (node)
        (when (= (get node :kind) "import-declaration")
          (let ((path (get node :value)))
            (when (js-call path :startsWith ".")
              (put node :value (if (and (not (undefined? replacement)) (= path "./managed-host-runtime.mjs")) replacement
                (get (pathToFileURL (resolve root "tools/backends" path)) :href))))))
        (walk (get node :children (js-array)))))))
      (walk (get program :body))) program)
  (defasync runFunctionMissingDisposal (backend runtime program)
    (let* ((fixture (prepareFixtureEnvironment root (get globalThis.process :env)))
           (compiled (image backend runtime program))
           (source (await (readFile (resolve root "tools/backends/eliscript/managed-host-runtime.eli") "utf8")))
           (needle "globalThis.Symbol.matchAll globalThis.Symbol.dispose globalThis.Symbol.asyncDispose")
           (pieces (js-call source :split needle)))
      (try
        (progn
          ;; Injection applies to maintained Eliscript before compilation. All
          ;; original generated bytes and the complete descriptor remain intact.
          (js-call assert :strictEqual (js-length pieces) 2)
          (let* ((changed (js-call pieces :join "globalThis.Symbol.matchAll undefined undefined"))
                 (hostIR (js-call (get backend :compiler) :compile_ir_string changed "isolated-managed-host-runtime.eli"))
                 (hostPath (await (writeManagedReference (get fixture :directory)
                   (js-call (get backend :compiler) :emit_ir_string (relocateHostImports hostIR undefined)) "isolated-managed-host-runtime")))
                 (facadeSource (await (readFile (resolve root "tools/backends/eliscript/managed-host.eli") "utf8")))
                 (facadeIR (js-call (get backend :compiler) :compile_ir_string facadeSource "isolated-managed-host.eli"))
                 (host (await (loadGeneratedFixture (get fixture :directory)
                   (js-call (get backend :compiler) :emit_ir_string (relocateHostImports facadeIR (get (pathToFileURL hostPath) :href))) "isolated-managed-host")))
                 (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (get compiled :bytes))) :exports))
                 (memory (js-object :view (lambda () (new globalThis.DataView (get (get e :memory) :buffer)))
                   :writeBytes (lambda (offset bytes) (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) offset (js-length bytes)) :set bytes))
                   :readBytes (lambda (offset length) (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) offset length) :slice))))
                 (a (js-call host :createManagedHostRuntime e (get compiled :descriptor) memory (js-object :initializeModule false)))
                 (held (js-call a :number -0)) (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 held)
            (try
              (progn
                (js-call a :auto 1) (js-call a :initializeModule)
                (js-call (js-array 13 14) :forEach (lambda (identifier)
                  (let* ((index (js-call a :number identifier)) (symbol (js-call a :invoke "symbol-static" (js-array index))))
                    (try
                      (progn
                        (js-call assert :throws (lambda () (js-call a :toHostValue symbol))
                          (lambda (error) (and (Reflect/apply (get globalThis.TypeError globalThis.Symbol.hasInstance) globalThis.TypeError (js-array error))
                            (= (get error :message) "unknown managed well-known Symbol"))))
                        (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
                        (js-call assert :ok (Object/is (js-call a :readNumber held) -0))
                        (js-call a :collect)
                        (js-call assert :strictEqual (value a "symbol-description" (js-array symbol)) (+ "Symbol." (aref wellKnownSymbolNames identifier))))
                      (finally (js-call a :release index) (js-call a :release symbol))))))
                (let* ((index (js-call a :number 0)) (symbol (js-call a :invoke "symbol-static" (js-array index))))
                  (try (js-call assert :strictEqual (js-call a :toHostValue symbol) globalThis.Symbol.iterator)
                    (finally (js-call a :release index) (js-call a :release symbol)))))
              (finally (js-call a :leaveFrame frame) (js-call a :release held) (finish a)))))
        (finally (js-call fixture :close)))))
  (export functionInitializationPressureTitle functionMissingDisposalTitle runFunctionInitializationSemantics runFunctionMissingDisposal))
