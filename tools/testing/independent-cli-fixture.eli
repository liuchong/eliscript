(module tools.testing.independent-cli-fixture
  ;; These unchanged historical suites exercise the independent parser. The
  ;; release CLI has a separate authenticated final-stage acceptance surface.
  (import "node:child_process" :default processes)
  (import "node:child_process" :as process-exports)
  (import "node:module" syncBuiltinESMExports createRequire)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "../backends/build.mjs" root)
  (import "./compiler-package-execution.mjs" rewriteCompilerPackageExecution)
  (defconst suites (js-object
    "tests/compiler-package-session.test.mjs" "cabaee3897e99a1c920dc4d3ba16459351a6d4864b327a03839c0c8d7d7d2b4c"
    "tests/compiler-session-tools.test.mjs" "4668c61b9956b5501e496fc6246300667cf3fb85d5ebdd414d86269c5a56acd0"
    "tests/compiler-corpus-arguments.test.mjs" "615cdb65fadc8bdc483cc8fb08cea82a41eeb49eea3fd4d97035a5474dff1640"))
  (defconst canonical (resolve root "tools/backends/compiler-cli.mjs"))
  (defconst independent (resolve root "tools/backends/compiler-cli-legacy.mjs"))
  (defconst original-bin (resolve root "bin/eliscript-compiler"))
  (defconst canonical-url (get (pathToFileURL canonical) :href))
  (defconst independent-url (get (pathToFileURL independent) :href))
  (defun rewriteIndependentCLIArguments (arguments)
    (unless (Array/isArray arguments) (throw (new globalThis.TypeError "independent CLI fixture requires argv")))
    (let ((count 0) (result (js-call arguments :slice)) (index 0))
      (while (< index (js-length result))
        (let ((argument (aref result index)))
          (cond
            ((or (= argument canonical) (= argument original-bin))
              (put result index independent) (setq count (1+ count)))
            ((and (> index 0) (js-call (js-array "--eval" "-e") :includes (aref result (1- index)))
                  (= (value-type argument) "string") (js-call argument :includes canonical-url))
              (let ((parts (js-call argument :split canonical-url)))
                (unless (= (js-length parts) 2)
                  (throw (new globalThis.TypeError "independent CLI eval must name exactly one original CLI URL")))
                ;; Relocate one existing module coordinate; every other source
                ;; byte remains the original historical script implementation.
                (put result index (js-call parts :join independent-url))
                (setq count (1+ count))))))
        (setq index (1+ index)))
      (when (> count 1) (throw (new globalThis.TypeError "independent CLI fixture refuses ambiguous CLI coordinates")))
      (js-object :arguments result :substitutions count)))
  (defun rewriteIndependentCLIInvocation (command arguments options)
    (let ((rewritten (rewriteIndependentCLIArguments arguments)))
      (if (= command original-bin)
        (progn
          (unless (= (get rewritten :substitutions) 0)
            (throw (new globalThis.TypeError "independent CLI fixture refuses ambiguous CLI coordinates")))
          (let* ((environment (unless (nullish? options) (get options :env)))
                 (selected (unless (nullish? environment) (get environment :BUN)))
                 (engine (if (nullish? selected) (get globalThis.process :execPath) selected)))
            (js-object :command engine :arguments (js-call (js-array independent) :concat arguments)
              :options options :substitutions 1)))
        (js-object :command command :arguments (get rewritten :arguments)
          :options options :substitutions (get rewritten :substitutions)))))
  (defun installIndependentCLIFixture (suite)
    (let ((expected (get suites suite)))
      (unless expected (throw (new globalThis.TypeError "independent CLI fixture requires a declared original suite")))
      (let ((actual (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root suite))) :digest "hex")))
        (unless (= actual expected) (throw (new globalThis.TypeError "independent CLI fixture source identity changed"))))
      (let* ((original (get processes :spawnSync)) (closed false)
             (original-exports (Object/assign (js-object) process-exports))
             (mock (unless (undefined? globalThis.Bun)
               (get (funcall (createRequire (resolve root "package.json")) "bun:test") :mock)))
             (spawn (lambda (command arguments &rest configuration)
               (let* ((rewritten (rewriteIndependentCLIInvocation command arguments (aref configuration 0)))
                      (package-arguments (when (= suite "tests/compiler-package-session.test.mjs")
                        (rewriteCompilerPackageExecution (get rewritten :arguments) (aref configuration 0) root))))
                 (Reflect/apply original processes
                   (js-call (js-array (get rewritten :command) (if package-arguments package-arguments (get rewritten :arguments))) :concat configuration))))))
        (put processes :spawnSync spawn)
        (syncBuiltinESMExports)
        ;; Bun's original suites import the named builtin binding. Updating
        ;; only its default object does not replace that actual call site.
        (unless (undefined? mock)
          (js-call mock :module "node:child_process" (lambda ()
            (Object/assign (js-object) original-exports (js-object :default processes :spawnSync spawn)))))
        (lambda ()
          (unless closed
            (put processes :spawnSync original) (syncBuiltinESMExports)
            (unless (undefined? mock)
              (js-call mock :module "node:child_process" (lambda () original-exports)))
            (setq closed t))))))
  (let* ((arguments (get globalThis.process :argv))
         (selected (js-call (Object/keys suites) :filter (lambda (suite)
           (js-call arguments :some (lambda (argument) (= (resolve root argument) (resolve root suite))))))))
    (when (> (js-length selected) 1) (throw (new globalThis.TypeError "independent CLI fixture owns exactly one original suite process")))
    (when (= (js-length selected) 1)
      (let ((restore (installIndependentCLIFixture (aref selected 0))))
        (js-call globalThis.process :once "exit" restore))))
  (export rewriteIndependentCLIArguments rewriteIndependentCLIInvocation installIndependentCLIFixture))
