(module tools.testing.number-text-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../backends/build.mjs" root)
  (defconst numberTextSuite "tests/wasm-managed-number-text.test.mjs")
  (defconst numberTextSuiteSHA "efb82a6a9f2457924f661ceaf8780412e4d2c80a983a535b7c066817a9f9e913")
  (defconst numberTextSuiteURL (get (pathToFileURL (resolve root numberTextSuite)) :href))
  (defun verifyNumberTextSource ()
    (js-call assert :strictEqual (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root numberTextSuite))) :digest "hex") numberTextSuiteSHA))
  (defun numberTextTimeout (value)
    (let ((timeout (if (undefined? value) 300000 value)))
      (unless (and (= (value-type timeout) "number") (Number/isFinite timeout) (> timeout 0))
        (throw (new globalThis.TypeError "number-text Node bridge requires its original positive numeric timeout"))) timeout))
  (defun numberTextTestArguments (arguments)
    (unless (and (Array/isArray arguments) (or (= (js-length arguments) 2) (= (js-length arguments) 3))
                 (= (value-type (aref arguments 0)) "string") (= (value-type (aref arguments 1)) "function"))
      (throw (new globalThis.TypeError "number-text Node bridge requires the original title callback and optional numeric timeout")))
    (js-array (aref arguments 0) (js-object :timeout (numberTextTimeout (aref arguments 2))) (aref arguments 1)))
  (defun numberTextHookArguments (arguments)
    (unless (and (Array/isArray arguments) (or (= (js-length arguments) 1) (= (js-length arguments) 2))
                 (= (value-type (aref arguments 0)) "function"))
      (throw (new globalThis.TypeError "number-text Node hook requires its original callback and optional numeric timeout")))
    (js-array (aref arguments 0) (js-object :timeout (numberTextTimeout (aref arguments 1)))))
  (defun numberTextImportRoute (specifier parentURL bridgeURL)
    (if (and (= specifier "bun:test") (= parentURL numberTextSuiteURL))
      (js-object :url bridgeURL :shortCircuit t) undefined))
  (export numberTextSuite numberTextSuiteSHA numberTextSuiteURL verifyNumberTextSource numberTextTestArguments numberTextHookArguments numberTextImportRoute))
