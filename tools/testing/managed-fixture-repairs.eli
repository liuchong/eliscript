      :sha256 "30a083b2072d64bea0be1dcbfbacd833dc63afad32ff34a873875458e20468f6")
    (js-object :suite "tests/wasm-managed-regexp.test.mjs" :kind "regexp"
      :sha256 "65d8dc751109174f90eb41ee0d0332e23e3b354d123c733448a84a32ad7ae2ad")
    (js-object :suite "tests/wasm-managed-regexp-exact.test.mjs" :kind "regexp-exact"
