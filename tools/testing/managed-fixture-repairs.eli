      :sha256 "b45811f343ae5942e33c7bb2bb47fade0de2d0e5cfdb7cfc889f7d287660bcb9")))
  (defconst malformedEmptyBindingsTitle "malformed binding shape is refused before child lowering with exact Unicode source position and immutable input IR")
  (defconst malformedVariadicCallsTitle "variadic lowering refuses invalid parameter modes, hidden children and malformed apply shapes immutably")
  (defconst nativePromiseTitle "foreign Promise.then uses actual host Promise internal slots without accepting an ordinary thenable")
  (defconst nativePrototypeNodeTitle "Node executes the independent JavaScript prototype and Promise oracle")
  (defconst realmCapacityTitle "reading default null and custom Array prototype identity does not observe its methods in the original 64 slots")
  (defun managedFixtureTestMethod (target key)
    (let ((value (Reflect/get target key target)))
      (if (= (value-type value) "function") (js-call value :bind target) value)))
  (defun managedFixtureRealmPressureTitle (plan environment)
    (if (and (= (get plan :suite) "tests/wasm-managed-realm-lifetime.test.mjs")
               (= (get plan :sha256) "3e8722afe234131cf927c7999a52c4911a79aaeb233ce4177be5cb1d9e2feb6b")
               (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
               (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")) realmCapacityTitle undefined))
  (defun managedFixtureFunctionalArguments (plan environment arguments)
    (if (and (or (and (= (get plan :suite) "tests/wasm-managed-project-linking.test.mjs")
             (= (get plan :sha256) "fd9c909b7e5fa57ee9237385c142349fdad1b9d66d5e9d603c2323cdf3ec0c07")
             (= (aref arguments 0) "fixed random module graphs agree with independent binding models and fresh JS projects"))
             (and (= (get plan :suite) "tests/wasm-managed-regexp.test.mjs")
               (= (get plan :sha256) "65d8dc751109174f90eb41ee0d0332e23e3b354d123c733448a84a32ad7ae2ad")
               (= (aref arguments 0) "deterministic pattern/text models preserve captures and priorities including nullable repeated groups")))
             (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
             (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")
             (= (js-length arguments) 3) (= (value-type (aref arguments 1)) "function")
             (= (aref arguments 2) 30000))
      (let ((forwarded (js-call arguments :slice))) (put forwarded 2 0) forwarded) arguments))
  (defasync assertNativePrototypeNode (backend program)
    (let ((fixture (prepareFixtureEnvironment root (get globalThis.process :env))))
      (try
        (let* ((directory (get fixture :directory))
               (code (js-call (get backend :compiler) :emit_ir_string program)))
          (await (writeFile (resolve directory "compiler.mjs") code))
          (let ((child (spawnSync "node" (js-array (resolve root "tests/helpers/native-prototype-node.mjs") directory)
            (js-object :cwd root :encoding "utf8" :timeout 30000))))
            (js-call assert :strictEqual (get child :status) 0 (get child :stderr))))
        (finally (js-call fixture :close)))))
  (defasync assertNativePrototypePromise (backend runtime program)
    (let* ((before (JSON/stringify program))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_project_wasm
             (js-array (js-object :id "prototype-callables.mjs" :program program)) "prototype-callables.mjs" runtime
             (js-object :phased t :foreignEntry t))))
           (module (new globalThis.WebAssembly.Module bytes))
           (descriptor (readManagedModuleMetadata module "eliscript-managed-control"))
           (capabilities (get descriptor :hostCapabilities (js-array))))
      (js-call assert :strictEqual (JSON/stringify program) before)
      (js-call assert :deepStrictEqual
        (js-call (globalThis.WebAssembly.Module.imports module) :map (lambda (entry)
          (js-object :module (get entry :module) :name (get entry :name) :kind (get entry :kind))))
        (js-call capabilities :map (lambda (entry)
          (js-call assert :strictEqual (get entry :abi) "managed-host-call-v1")
          (js-call assert :strictEqual (get entry :arity) 2)
          (js-object :module (get entry :module) :name (get entry :name) :kind "function"))))
      (let* ((a (instantiateManagedRuntime bytes)) (_ (js-call a :auto 1))
             (input (js-call a :fromHostValue (globalThis.Promise.resolve 8)))
             (wrong (js-call a :fromHostValue (js-object :then (lambda () 99)))) (output undefined))
        (try
          (progn
            (setq output (js-call a :invoke "foreign_then" (js-array input)))
            (js-call assert :strictEqual (await (js-call a :toHostValue output)) 11)
            (js-call assert :throws (lambda () (js-call a :invoke "foreign_then" (js-array wrong)))
              (lambda (error)
                (cond ((js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) error) t)
                      ((= (get error :kind) 35)
                       (try (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) (js-call a :toHostValue error))
                         (finally (js-call a :release error)))) (t false)))))
          (finally (finishFixtureRuntime a (js-array input wrong output)))))))
  (defun persistentBoundaryFixtureSource (source filename)
    (if (/= filename "persistent-boundary.eli") source
      (let ((normalized source))
        ;; These are supplied source module identities, not host capabilities.
        (js-call (js-array "regex" "sorted" "metadata" "value" "value-internals" "protocol" "type" "record") :forEach
          (lambda (name)
            (let* ((original (str "(import \"eliscript/runtime/core/" name "\" "))
                   (parts (js-call normalized :split original)))
              (unless (= (js-length parts) 2)
                (throw (new globalThis.TypeError "persistent boundary must contain each original source import exactly once")))
              (setq normalized (js-call parts :join (str "(import \"eliscript/runtime/core/" name ".mjs\" "))))))
        normalized)))
  (defun nativePrototypeFixtureSource (source filename)
    (if (/= filename "native-prototype-callables.eli") source
      (let ((parts (js-call source :split "(js* \"NaN\")")))
        (unless (= (js-length parts) 2)
          (throw (new globalThis.TypeError "native prototype fixture must contain exactly its original NaN expression")))
        (js-call parts :join "(get globalThis/Number :NaN)"))))
  (defun managedReferenceChildArguments (arguments preload)
    (unless (and (Array/isArray arguments) (= (value-type preload) "string") (> (js-length preload) 0))
      (throw (new globalThis.TypeError "managed reference fixture requires real child arguments and module coordinates")))
    (let ((index (js-call arguments :findIndex (lambda (argument position)
      (and (> position 0) (js-call (js-array "--eval" "-e") :includes (aref arguments (1- position)))
           (= (value-type argument) "string") (js-call argument :includes "data:text/javascript;base64,"))))))
      (if (< index 0) arguments
        (js-call (js-array "--import" preload) :concat arguments))))
  (defun caught (run)
    (let ((failed false) (failure undefined))
      (try (funcall run) (catch error (setq failed t failure error)))
      (js-call assert :strictEqual failed t "the original invalid input must be refused") failure))
  (defun assertMalformedEmptyBindings (backend runtime)
    (js-call (js-array
      (lambda (node) (put node :children (js-array nil)))
      (lambda (node) (js-call (get node :children) :push (aref (get node :children) 0)))
      (lambda (node) (put node :value nil))
      (lambda (node) (put node :properties (js-object :pattern (js-object :kind "unsupported"))))
      (lambda (node) (put node :kind "literal"))) :forEach
      (lambda (change)
        (let* ((program (js-call (get backend :compiler) :compile_ir_string
                  ";中😀\n(defun f () (let ((x 1)) x)) (export f)" "unicode-bindings.eli"))
               (binding undefined))
          (letfn ((walk (node)
            (when (and (not (nullish? node)) (= (value-type node) "object"))
              (when (= (get node :kind) "lexical-binding") (setq binding node))
              (js-call (Object/values node) :forEach walk)))) (walk program))
          (js-call assert :ok binding)
          (let* ((span (get binding :span)) (ignored (funcall change binding))
                 (before (JSON/stringify program)) (schemaFailed false) (schemaError undefined))
            (try (validate-serializable-program program) (catch error (setq schemaFailed t schemaError error)))
            (let* ((error (caught (lambda () (js-call (get backend :managed) :emit_managed_wasm program runtime))))
                   (diagnostic (get error :eliscriptDiagnostic)))
              (if schemaFailed
                (progn
                  (js-call assert :strictEqual (get error :name) (get schemaError :name))
                  (js-call assert :strictEqual (get error :message) (get schemaError :message))
                  (js-call assert :strictEqual (JSON/stringify diagnostic) (JSON/stringify (get schemaError :eliscriptDiagnostic))))
                (progn
                  (js-call assert :strictEqual (get diagnostic :code) "ELI-B0001")
                  (js-call assert :strictEqual (get diagnostic :phase) "managed-backend")
                  (js-call assert :strictEqual (get (get diagnostic :location) :file) "unicode-bindings.eli")
                  (js-call assert :strictEqual (get (get (get diagnostic :location) :start) :line) (get span :line))
                  (js-call assert :strictEqual (get (get (get diagnostic :location) :start) :column) (get span :column))))
              (js-call assert :strictEqual (JSON/stringify program) before)))))))
  (defun assertMalformedVariadicCalls (backend runtime)
    (letfn ((refuse (program filename)
      (let ((before (JSON/stringify program)) (schemaFailed false) (schemaError undefined))
        (try (validate-serializable-program program) (catch error (setq schemaFailed t schemaError error)))
        (let ((error (caught (lambda () (js-call (get backend :managed) :emit_managed_wasm program runtime)))))
          (if schemaFailed
            (progn
              (js-call assert :strictEqual (get error :name) (get schemaError :name))
              (js-call assert :strictEqual (get error :message) (get schemaError :message))
              (js-call assert :strictEqual (JSON/stringify (get error :eliscriptDiagnostic)) (JSON/stringify (get schemaError :eliscriptDiagnostic))))
            (progn
              (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")
              (js-call assert :strictEqual (get (get (get error :eliscriptDiagnostic) :location) :file) filename)))
          (js-call assert :strictEqual (JSON/stringify program) before)))))
      (js-call (js-array
        (lambda (program) (put (get (aref (get (aref (get program :body) 0) :children) 0) :properties) :parameterKind "unknown"))
        (lambda (program) (put (get (aref (get (aref (get program :body) 0) :children) 1) :properties) :parameterKind "required"))
        (lambda (program) (put (get (aref (get (aref (get program :body) 0) :children) 0) :properties) :parameterKind "rest"))
        (lambda (program) (js-call (get (aref (get (aref (get program :body) 0) :children) 0) :children) :push
          (js-object :kind "raw-javascript" :children (js-array) :value "hidden")))) :forEach
        (lambda (mutate)
          (let ((program (js-call (get backend :compiler) :compile_ir_string
            "(defun f (&optional a b) (js-array a b)) (export f)" "bad-variadic.eli")))
            (funcall mutate program) (refuse program "bad-variadic.eli"))))
      (let* ((program (js-call (get backend :compiler) :compile_ir_string
                "(defun f (g values) (apply g values)) (export f)" "bad-apply.eli"))
             (children (get (js-call (get (aref (get program :body) 0) :children) :at -1) :children)))
        (js-call children :push (js-object :kind "literal" :value 7 :children (js-array)))
        (refuse program "bad-apply.eli"))))
  (defun findFixtureNode (program predicate)
    (let ((found undefined))
      (letfn ((walk (node)
        (when (and (not (nullish? node)) (= (value-type node) "object"))
          (when (funcall predicate node) (setq found node))
          (js-call (Object/values node) :forEach walk)))) (walk program))
      (js-call assert :ok found) found))
  (defun assertFixtureIRRefusal (backend runtime program filename span)
    (let ((before (JSON/stringify program)) (schemaFailed false) (schemaError undefined))
      (try (validate-serializable-program program) (catch error (setq schemaFailed t schemaError error)))
      (let* ((error (caught (lambda () (js-call (get backend :managed) :emit_managed_wasm program runtime))))
             (diagnostic (get error :eliscriptDiagnostic)))
        (js-call assert :ok diagnostic (str "missing source diagnostic for " filename ": " (get error :stack)))
        (if schemaFailed
          (progn
            (js-call assert :strictEqual (get error :name) (get schemaError :name))
            (js-call assert :strictEqual (get error :message) (get schemaError :message))
            (js-call assert :strictEqual (JSON/stringify diagnostic) (JSON/stringify (get schemaError :eliscriptDiagnostic))))
          (progn
            (js-call assert :strictEqual (get diagnostic :code) "ELI-B0001")
            (js-call assert :strictEqual (get (get diagnostic :location) :file) filename)
            (when (not (nullish? span))
              (js-call assert :strictEqual (get (get (get diagnostic :location) :start) :line) (get span :line))
              (when (Object/hasOwn span "column")
                (js-call assert :strictEqual (get (get (get diagnostic :location) :start) :column) (get span :column))))))
        (js-call assert :strictEqual (JSON/stringify program) before))))
  (defun assertMalformedTypeof (backend runtime)
    (js-call (js-array "typeof unknown" "typeof value()" "typeof (value)" "typeof value[key]") :forEach
      (lambda (expression)
        (let ((program (js-call (get backend :compiler) :compile_ir_string
          (str ";中😀\n(defun f (value) (if nil (js* " (JSON/stringify expression) ") 1)) (export f)") "type-refusal.eli")))
          (assertFixtureIRRefusal backend runtime program "type-refusal.eli" (js-object :line 2)))))
    (js-call (js-array
      (lambda (node) (js-call (get node :children) :push (aref (get node :children) 0)))
      (lambda (node) (put (aref (get node :children) 0) :value nil))
      (lambda (node) (js-call (get (aref (get node :children) 0) :children) :push (js-object :kind "literal" :value 7 :children (js-array))))) :forEach
      (lambda (mutate)
        (let* ((program (js-call (get backend :compiler) :compile_ir_string
                 "(defun f (value) (js* \"typeof value\")) (export f)" "malformed-type.eli"))
               (raw (findFixtureNode program (lambda (node) (= (get node :kind) "raw-javascript")))))
          (funcall mutate raw) (assertFixtureIRRefusal backend runtime program "malformed-type.eli" undefined)))))
  (defun assertMalformedIntrinsic (backend runtime names filename)
    (js-call names :forEach (lambda (name)
      (js-call (js-array
        (lambda (node) (put node :children (js-array)))
        (lambda (node) (js-call (get node :children) :push (aref (get node :children) 0)))
        (lambda (node) (put node :children (js-array nil)))) :forEach
        (lambda (mutate)
          (let* ((program (js-call (get backend :compiler) :compile_ir_string
                    (str ";中😀\n(defun f (value) (" name " value)) (export f)") filename))
                 (intrinsic (findFixtureNode program (lambda (node) (and (= (get node :kind) "intrinsic") (= (get node :value) name)))))
                 (span (get intrinsic :span)))
            (funcall mutate intrinsic) (assertFixtureIRRefusal backend runtime program filename span)))))))
  (defun finishFixtureRuntime (runtime values)
    (js-call values :forEach (lambda (value) (js-call runtime :release value)))
    (js-call runtime :closeModule) (js-call runtime :collect)
    (js-call assert :strictEqual (js-call runtime :live) 0)
    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
  (defasync assertNamespaceTypeAndPressure (backend runtime)
    (let* ((compiler (get backend :compiler))
           (lib (js-call compiler :compile_ir_string
             "(module lib (defvar kind \"eliscript/symbol\") (defun update () (setq kind \"eliscript/keyword\")) (export kind update))" "brand-lib.eli"))
           (entry (js-call compiler :compile_ir_string
             "(module entry (import \"./lib.mjs\" :as lib) (defun label () (value-type lib)) (defun change () (lib/update)) (export label change))" "brand-entry.eli"))
           (modules (js-array (js-object :id "lib.mjs" :program lib) (js-object :id "entry.mjs" :program entry)))
           (before (JSON/stringify modules))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_project_wasm modules "entry.mjs" runtime)))
           (a (instantiateManagedRuntime bytes)) (base (resolve root ".eliscript-cache/test-fixtures")) (directory undefined))
      (js-call assert :strictEqual (JSON/stringify modules) before)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-call a :auto 1)
      (try
        (progn
          (await (mkdir base (js-object :recursive t)))
          (setq directory (await (mkdtemp (resolve base "namespace-type-"))))
          (await (writeFile (resolve directory "lib.mjs") (js-call compiler :emit_ir_string lib)))
          (await (writeFile (resolve directory "entry.mjs") (js-call compiler :emit_ir_string entry)))
          (let* ((reference (funcall (createRequire (resolve directory "entry.mjs")) (resolve directory "entry.mjs")))
                 (namespace (funcall (createRequire (resolve directory "lib.mjs")) (resolve directory "lib.mjs")))
                 (descriptor (Object/getOwnPropertyDescriptor namespace "kind"))
                 (expected (if (and descriptor (Object/hasOwn descriptor "value") (= (get descriptor :value) "eliscript/symbol")) "symbol" "object"))
                 (first (js-call a :invoke "label")))
            (js-call assert :strictEqual (js-call reference :label) expected)
            (js-call assert :strictEqual expected "symbol")
            (try (js-call assert :strictEqual (js-call a :readString first) (js-call reference :label))
              (finally (js-call a :release first)))
            (let ((change (js-call a :invoke "change"))) (js-call a :release change))
            (js-call reference :change)
            (js-call assert :strictEqual (get namespace :kind) "eliscript/keyword")
            (let* ((updated (Object/getOwnPropertyDescriptor namespace "kind"))
                   (next (js-call a :invoke "label"))
                   (expected-next (if (and updated (Object/hasOwn updated "value") (= (get updated :value) "eliscript/keyword")) "keyword" "object")))
              (try (js-call assert :strictEqual (js-call reference :label) expected-next)
                (js-call assert :strictEqual expected-next "keyword")
                (js-call assert :strictEqual (js-call a :readString next) (js-call reference :label))
                (finally (js-call a :release next))))))
        (finally (finishFixtureRuntime a (js-array))
          (when directory (await (rm directory (js-object :recursive t :force t)))))))
    (let* ((program (js-call (get backend :compiler) :compile_ir_string
              "(defconst marker 1) (defun f (value) (value-type value)) (export f)" "type-oom.eli"))
           (before (JSON/stringify program))
           (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
           (small (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 8192)))
           (automatic (js-call small :auto 1))
           (retained (js-call small :number -0)) (outer (js-call small :frame 1)) (held (js-array)) (exhausted false) (index 0))
      (js-call assert :strictEqual (JSON/stringify program) before)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-call small :frameSet outer 0 retained)
      (while (and (< index 128) (not exhausted))
        (try (js-call held :push (js-call small :number index))
          (catch error (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002") (setq exhausted t)))
        (setq index (1+ index)))
      (js-call assert :ok exhausted)
      (js-call assert :throws (lambda () (js-call small :invoke "f" (js-array retained)))
        (lambda (error) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002")))
      (js-call assert :strictEqual (get (js-call small :stats) :frameDepth) 1)
      (js-call assert :ok (Object/is (js-call small :readNumber retained) -0))
      (js-call held :forEach (lambda (value) (js-call small :release value))) (js-call small :collect)
      (let ((out (js-call small :invoke "f" (js-array retained))))
        (js-call assert :strictEqual (js-call small :readString out) "number")
        (js-call small :leaveFrame outer) (finishFixtureRuntime small (js-array retained out)))))
  (defasync assertNamespaceCopyTrap (backend runtime)
    (let* ((compiler (get backend :compiler))
           (modules (js-array
             (js-object :id "lib.mjs" :program (js-call compiler :compile_ir_string "(defconst value (js-array 1 2 3)) (export value)" "lib.eli"))
             (js-object :id "main.mjs" :program (js-call compiler :compile_ir_string
               "(import \"./lib.mjs\" :as ns) (defun copy () (object-assoc ns :extra 7)) (export copy)" "main.eli"))))
           (source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
           (signature "  (defun heap-module-cell-read (heap cell index)")
           (start (js-call source :indexOf signature)) (end (js-call source :indexOf "  (defun " (+ start 10))))
      (js-call assert :ok (and (>= start 0) (> end start)))
      (js-call assert :strictEqual (js-call source :indexOf signature (1+ start)) -1)
      (let* ((faulty (str (js-call source :slice 0 start) "  (defun heap-module-cell-read (heap cell index) (load-u32 4294967295))\n" (js-call source :slice end)))
             (rt (js-call compiler :compile_ir_string faulty "namespace-copy-trap.eli"))
             (before (JSON/stringify modules))
             (a (instantiateManagedRuntime (globalThis.Uint8Array.from
               (js-call (get backend :managed) :emit_managed_project_wasm modules "main.mjs" rt))))
             (automatic (js-call a :auto 1)) (keep (js-call a :number -0)) (frame (js-call a :frame 1)))
        (js-call assert :strictEqual (JSON/stringify modules) before)
        (js-call a :frameSet frame 0 keep)
        (js-call assert :throws (lambda () (js-call a :invoke "copy")) globalThis.WebAssembly.RuntimeError)
        (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
        (let ((saved (js-call a :frameGet frame 0)))
          (js-call assert :ok (Object/is (js-call a :readNumber saved) -0))
          (js-call a :leaveFrame frame) (finishFixtureRuntime a (js-array keep saved))))))
  (defun firstFixtureNode (program predicate)
    (let ((found undefined))
      (letfn ((walk (node)
        (when (and (undefined? found) (not (nullish? node)) (= (value-type node) "object"))
          (if (funcall predicate node) (setq found node) (js-call (Object/values node) :forEach walk))))) (walk program))
      (js-call assert :ok found) found))
  (defasync assertMalformedTextMethods (backend runtime)
    (let ((program (js-call (get backend :compiler) :compile_ir_string
      (await (readFile (resolve root "tests/fixtures/wasm-managed-strings.eli") "utf8")) "strings.eli")))
      (js-call (js-array "missing" "null-receiver" "null-key") :forEach (lambda (malformed)
        (let* ((copy (globalThis.structuredClone program))
               (method (firstFixtureNode copy (lambda (node) (= (get node :kind) "method-call"))))
               (span (get method :span)))
          (if (= malformed "missing") (put method :children (js-call (get method :children) :slice 0 1))
            (put (get method :children) (if (= malformed "null-receiver") 0 1) nil))
          (assertFixtureIRRefusal backend runtime copy "strings.eli" span))))))
  (defasync withFixtureReference (backend program run)
    (let ((base (resolve root ".eliscript-cache/test-fixtures")) (directory undefined))
      (try
        (progn
          (await (mkdir base (js-object :recursive t)))
          (setq directory (await (mkdtemp (resolve base "managed-oracle-"))))
          (let ((filename (resolve directory "reference.mjs")))
            (await (writeFile filename (js-call (get backend :compiler) :emit_ir_string program)))
            (await (funcall run (funcall (createRequire filename) filename)))))
        (finally (when directory (await (rm directory (js-object :recursive t :force t))))))))
  (defasync assertTextConstructorSupport (backend runtime)
    (let ((sources (js-array
      "(defun f (String) (js-call (js* \"String\") :fromCodePoint 65)) (export f)"
      "(defun f (globalThis) (js-call globalThis/String :fromCodePoint 65)) (export f)"
      "(defconst String (js-object)) (defun f () (js-call (js* \"String\") :fromCharCode 65)) (export f)"
      "(defun f (method) (js-call (js* \"String\") method 65)) (export f)"
      "(defun f () (js-call (js* \"String\") :raw 65)) (export f)")) (index 0))
      (while (< index (js-length sources))
        (let* ((program (js-call (get backend :compiler) :compile_ir_string (aref sources index) "shadowed.eli"))
               (before (JSON/stringify program))
               (inputs (if (< index 2) (js-array (js-array nil))
                 (if (= index 3) (js-array (js-array "fromCodePoint") (js-array "absent")) (js-array (js-array)))))
               (case-index index))
          (await (withFixtureReference backend program (async (reference)
            (let ((mode 0)) (while (< mode 2)
              (let* ((bytes (globalThis.Uint8Array.from (if (= mode 0)
                       (js-call (get backend :managed) :emit_managed_wasm program runtime)
                       (js-call (get backend :managed) :emit_managed_project_wasm (js-array (js-object :id "main.mjs" :program program)) "main.mjs" runtime))))
                     (a (instantiateManagedRuntime bytes)))
                (js-call assert :strictEqual (JSON/stringify program) before)
                (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
                (js-call a :auto 1)
                (try
                  (js-call inputs :forEach (lambda (arguments)
                    (let* ((args (js-call arguments :map (lambda (value) (if (= (value-type value) "string") (js-call a :string value) value))))
                           (failed false) (expected undefined) (out undefined))
                      (try
                        (progn
                          (try (setq expected (Reflect/apply (get reference :f) undefined arguments)) (catch error (setq failed t expected error)))
                          (if failed
                            (let ((error (caught (lambda () (js-call a :invoke "f" args)))))
                              (js-call assert :strictEqual (get expected :name) "TypeError")
                              (js-call assert :strictEqual (get error :name) (get expected :name))
                              (js-call assert :strictEqual (get (get error :eliscriptDiagnostic) :code)
                                (if (< case-index 2) "ELI-RT0001" "ELI-RT0003")))
                            (progn (setq out (js-call a :invoke "f" args))
                              (js-call assert :strictEqual (js-call a :readString out) expected)
                              (js-call assert :strictEqual expected "A"))))
                        (finally (js-call a :release out) (js-call args :forEach (lambda (value) (js-call a :release value))))))))
                  (finally (finishFixtureRuntime a (js-array)))))
              (setq mode (1+ mode)))))))
        (setq index (1+ index)))))
    (let* ((program (js-call (get backend :compiler) :compile_ir_string
             (await (readFile (resolve root "tests/fixtures/wasm-managed-strings.eli") "utf8")) "text-constructors.eli"))
           (copy (globalThis.structuredClone program))
           (target (firstFixtureNode copy (lambda (node) (and (= (get node :kind) "method-call") (= (get (aref (get node :children) 1) :value) "fromCodePoint"))))))
      (js-call (get (aref (get target :children) 0) :children) :push (js-object :kind "literal" :value "extra" :children (js-array) :properties nil))
      (assertFixtureIRRefusal backend runtime copy "text-constructors.eli" undefined))
    (js-call (js-array nil false 0 (js-object) (js-object :kind "literal" :value 65 :children (js-array) :properties nil)) :forEach
      (lambda (literal)
        (let ((program (js-call (get backend :compiler) :compile_ir_string
          "(defun f () (js-call (js* \"String\") :fromCharCode 65)) (export f)" "malformed-constructor.eli")))
          (put (aref (get (aref (get (aref (get program :body) 0) :children) 0) :children) 0) :children (js-array literal))
          (assertFixtureIRRefusal backend runtime program "malformed-constructor.eli" undefined)))))
  (defasync assertRegexpMalformed (backend runtime)
    (let ((base (resolve root ".eliscript-cache/test-fixtures")) (directory undefined))
      (try
        (progn
          (await (mkdir base (js-object :recursive t)))
          (setq directory (await (mkdtemp (resolve base "regexp-invalid-"))))
          (let ((raws (js-array "/a\nb/" "/a\rb/" "/a\u2028b/" "/a\u2029b/")) (index 0))
            (while (< index (js-length raws))
              (let* ((program (js-call (get backend :compiler) :compile_ir_string
                       (str "(defun f () (js* " (JSON/stringify (aref raws index)) ")) (export f)") "bad-literal.eli"))
                     (reference (resolve directory "invalid-literal.mjs")))
                (await (writeFile reference (js-call (get backend :compiler) :emit_ir_string program)))
                (let ((child (spawnSync "node" (js-array "--check" reference) (js-object :encoding "utf8" :timeout 30000))))
                  (js-call assert :strictEqual (get child :status) 1)
                  (js-call assert :match (get child :stderr) (new globalThis.RegExp "SyntaxError")))
                (assertFixtureIRRefusal backend runtime program "bad-literal.eli" undefined))
              (setq index (1+ index)))))
        (finally (when directory (await (rm directory (js-object :recursive t :force t)))))))
    (let ((program (js-call (get backend :compiler) :compile_ir_string "(defun f () (js* \"/a/\")) (export f)" "bad-ir.eli")))
      (put (aref (get (aref (get program :body) 0) :children) 0) :children (js-array nil))
      (assertFixtureIRRefusal backend runtime program "bad-ir.eli" undefined)))
  (defasync assertRegexpExactSupport (backend runtime)
    (let ((cases (js-array (js-array "a{2,3}" "") (js-array "a{2,}" "") (js-array "a{" "u") (js-array "a{}" "u")
      (js-array "a{-1}" "u") (js-array "a{1.5}" "u") (js-array "a{2a}" "u") (js-array "a{2}*" "")
      (js-array "a{2}{3}" "u") (js-array "^{0}" "") (js-array "\\b{2}" "u") (js-array "a{1048577}" "")
      (js-array "a{99999999999999999999999999999999}" ""))) (index 0) (observations (js-array)))
      (while (< index (js-length cases))
        (let* ((row (aref cases index)) (literal (str "/" (aref row 0) "/" (aref row 1)))
               (source (str "(defun run () (js* " (JSON/stringify literal) ")) (export run)"))
               (program (js-call (get backend :compiler) :compile_ir_string source "exact-invalid.eli"))
               (before (JSON/stringify program)))
          (if (>= index 2)
            (let* ((error (caught (lambda () (js-call (get backend :managed) :emit_managed_wasm program runtime))))
                   (diagnostic (get error :eliscriptDiagnostic)))
              (js-call assert :strictEqual (get diagnostic :code) "ELI-B0001")
              (js-call assert :strictEqual (get diagnostic :phase) "regexp-backend")
              (js-call assert :strictEqual (get (get diagnostic :location) :file) "exact-invalid.eli"))
            (let* ((program (js-call (get backend :compiler) :compile_ir_string
                     (str "(defconst pattern (js* " (JSON/stringify literal) ")) (defun run (text) (js-call pattern :exec text)) (defun field (x key) (get x key)) (export run field)") "exact.eli"))
                   (snapshot (JSON/stringify program))
                   (bytes (globalThis.Uint8Array.from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
                   (a (instantiateManagedRuntime bytes)))
              (js-call assert :strictEqual (JSON/stringify program) snapshot)
              (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
              (js-call a :auto 1)
              (try
                (js-call (js-array "" "a" "aa" "aaa" "aaaa" "baaa" "aa\n") :forEach (lambda (text)
                  (let* ((input (js-call a :string text)) (out (js-call a :invoke "run" (js-array input))) (expected nil))
                    (try
                      (unless (eq out nil)
                        (let ((values (js-array)) (i 0))
                          (while (< i (js-call a :length out))
                            (let ((value (js-call a :get out i)))
                              (try (js-call values :push (if (undefined? value) (js-object :missing t) (js-call a :readString value)))
                                (finally (js-call a :release value))))
                            (setq i (1+ i)))
                          (let* ((key (js-call a :string "index")) (at (js-call a :invoke "field" (js-array out key))))
                            (try (setq expected (js-object :values values :index (js-call a :readNumber at) :input text))
                              (finally (js-call a :release key) (js-call a :release at))))))
                      (js-call observations :push (js-object :pattern (aref row 0) :flags (aref row 1) :text text :expected expected))
                      (finally (js-call a :release input) (js-call a :release out))))))
                (finally (finishFixtureRuntime a (js-array))))))
          (js-call assert :strictEqual (JSON/stringify program) before))
        (setq index (1+ index)))
      (let ((child (spawnSync "node" (js-array (resolve root "tests/helpers/managed-regexp-oracle-node.mjs"))
        (js-object :encoding "utf8" :timeout 30000 :input (JSON/stringify observations)))))
        (js-call assert :strictEqual (get child :status) 0 (get child :stderr)))))
