(module tools.testing.final-functional-scope
  (import "./file-workers.mjs" parseTestFileArgs partitionTestFiles runTestFiles workerTestArguments collectPassedFileDigests isExclusiveTestFile isHeavyParallelTestFile isSharedBuilderTestFile lptFileIndices resolveParallelConfig workerRunRequest runLptQueue raiseProcessMaxListeners testFileWeight)
  (import "./resource-supervisor.mjs" startResourceSupervisor)
  (import "./fixture-environment.mjs" prepareFixtureEnvironment fixtureChildArguments)
  (import "./wire-call-cases.mjs" wireCallProfile)
  (import "./profile-store.mjs" loadTestProfile recordTestProfile estimateTestWeight estimateTestRssBytes loadLastFailures saveLastFailures)
  (import "./scheduler.mjs" runMemoryAwareLptQueue)
  (import "./reporter.mjs" summarizeSuiteRun formatSuiteSummary writeSuiteReport)
  (import "node:fs/promises" readFile mkdir writeFile)
  (import "node:path" resolve relative basename dirname)
  (import "node:crypto" createHash)
  (import "node:child_process" spawn)

  (defconst package-file "tests/compiler-package-session.test.mjs")
  (defconst tools-file "tests/compiler-session-tools.test.mjs")
  (defconst sequence-file "tests/wasm-managed-sequence-data.test.mjs")
  (defconst record-grid-file "tests/record-grid-selfhosted.test.mjs")
  (defconst response-events-file "tests/compiler-response-events.test.mjs")
  (defconst literal-runtime-file "tests/literal-runtime.test.mjs")
  (defconst wire-runtime-file "tests/wasm-managed-wire-selfhosted.test.mjs")
  (defconst sorted-runtime-file "tests/wasm-managed-sorted-core.test.mjs")
  (defun functionalScopeFiles (inventory shard environment source-root)
    (let ((files (if shard (partitionTestFiles inventory (get shard :index) (get shard :count)) inventory)))
      (when (and shard (wireCallProfile environment))
        (js-call (js-array wire-runtime-file sorted-runtime-file) :forEach (lambda (target)
          (let ((selected (js-call inventory :find (lambda (file)
                        (= (resolve source-root file) (resolve source-root target))))))
            (when (and selected (not (js-call files :includes selected)))
              (setq files (js-call files :concat (js-array selected))))))))
      files))
  (defconst ingress-file "tests/compiler-ir-session-ingress.test.mjs")
  (defconst artifact-archive-file "tests/compiler-artifact-archive-selfhosted.test.mjs")
  (defconst package-execution-file "tests/compiler-package-execution-selfhosted.test.mjs")
  (defconst browser-session-file "tests/compiler-browser-session.test.mjs")
  (defconst archive-debug-file "tests/compiler-matrix-archive-debug-selfhosted.test.mjs")
  (defconst persistent-literals-file "tests/wasm-managed-persistent-literals.test.mjs")
  (defconst direct-wasm-file "tests/direct-wasm-backend.test.mjs")
  (defconst INTRA_FILE_SHARDS (new globalThis.Map (js-array
    (js-array "compiler-package-session.test.mjs" 4)
    (js-array "direct-wasm-backend.test.mjs" 4)
    (js-array "native-managed-behavior.test.mjs" 2))))
  (defconst ingress-sha "f1eebc44b0f38ad4afde8d8a3140468a350944b76f93e3bdd5ff6c8418fd86cb")
  (defconst package-sha "94cdcc46462a0df41059db03cc0d550e9476585777aed3915568bfcb28b5fe2b")
  (defconst tools-sha "8613e99c1b9e50a03b8a3d0296a71326f66cf7451d1e10c5d28b23e08affef11")
  (defconst cancellation-reason
    "The user cancelled WASM/native compiler execution hosts; JS stage3 still emits and executes all user-program targets.")
  (defun sha (source) (js-call (js-call (createHash "sha256") :update source) :digest "hex"))
  (defun field (value key) (if (nullish? value) undefined (get value key)))
  (defun option (value key fallback)
    (let ((found (field value key))) (if (eq found undefined) fallback found)))

  ;; This inventory is bound to the full unchanged original suite bytes, not
  ;; a substring or a broad host/compiler name match. A suite edit requires an
  ;; explicit scope update; no unrecognized test is silently cancelled.
  (defun cancelledCompilerHostCases (file source)
    (if (and (/= file package-file) (/= file tools-file) (/= file ingress-file)) (js-array)
      (let* ((expected (cond ((= file package-file) package-sha) ((= file ingress-file) ingress-sha) (t tools-sha)))
             (actual (sha source)) (cases (js-array)))
        (unless (= actual expected)
          (throw (new globalThis.TypeError (+ "final functional scope source identity changed: " file))))
        (let ((add (lambda (title host group parameters)
          (js-call cases :push (js-object
            :id (+ "cancelled-compiler-host:" file ":" (js-length cases))
            :file file :sourceSha256 actual :title title :host host :sourceGroup group
            :parameters parameters :status "cancelled" :reason cancellation-reason)))))
          (if (= file ingress-file)
            (js-call (js-array "wasm" "native") :forEach (lambda (host)
              (js-call (js-array
                "When validated single IR is emitted Then actual WASM and native output preserve IEEE values"
                "When original IR intrinsic operands are corrupted Then original lowering rejects them and later IR still emits"
                "When a source graph and its exact IR graph are emitted Then all target bytes and JS maps agree"
                "When original memory IR or typed memory IR is emitted Then the real raw ABI and refusal paths are preserved")
                :forEach (lambda (suffix)
                  (funcall add (+ "Given complete " host " compiler " suffix) host "completeCompilerIRIngress" (js-object :host host))))))
          (if (= file tools-file)
            (funcall add
              "a complete real managed compiler driver transports AggregateError graphs with shared errors and cause identity"
              "wasm" "complete-managed-compiler-aggregate" (js-object))
            (progn
              (js-call (js-array
                "genuine shared WASM package retries streamed HTTP metadata and loads complete default debug without arrayBuffer metadata copies"
                "package consumption rejects altered metadata, debug and actual WASM bytes before parsing or instantiation"
                "a genuine WASM package verifies runtime before use, retries failed downloads and shares one concurrent runtime load"
                "package runtime HTTP failures allow retry and closing during download prevents subsequent session use"
                "an explicit runtime request wins a concurrent default download without replacing its session state")
                :forEach (lambda (title) (funcall add title "wasm" "packagedWasm" (js-object))))
              (js-call (js-array "wasm" "native") :forEach (lambda (host)
                (funcall add (+ "complete " host " compiler JSON-UTF16 sources survive original and relocated package sessions in Node and Bun")
                  host "encodedCompiler" (js-object :host host))
                (js-call (js-array "bun" "node") :forEach (lambda (engine)
                  (funcall add (+ "the public " engine " CLI consumes original and relocated " host " compilers with exact input bytes and default assets")
                    host "encodedCompiler" (js-object :host host :engine engine))
                  (js-call (js-array "emit-ir" "project-ir" "emit-memory-ir" "emit-typed-memory") :forEach (lambda (operation)
                    (funcall add (+ "Given the original and relocated " host " compiler When " engine
                      " CLI request submits " operation " Then real products sidecars and recovery preserve their ABI")
                      host "requestIRInput/encodedCompiler" (js-object :host host :engine engine :operation operation))))))))))))
        cases)))

  (defun escape-pattern (title)
    (js-call (js-call (Array/from title) :map (lambda (character)
      (if (js-call "\\^$.*+?()[]{}|" :includes character) (+ "\\" character) character))) :join ""))
  (defun functionalScopePattern (cancelled)
    (if (= (js-length cancelled) 0) undefined
      (+ "^(?!(?:" (js-call (js-call cancelled :map (lambda (item) (escape-pattern (get item :title)))) :join "|")
         ")$)[\\s\\S]*$")))

  (defasync file-plan (file source-root)
    (let* ((name (relative source-root (resolve source-root file)))
           (mixed (or (= name package-file) (= name tools-file) (= name ingress-file)))
           (cancelled (if mixed (cancelledCompilerHostCases name
                         (await (readFile (resolve source-root
                           (if (= name ingress-file) "tests/compiler-ir-session-ingress-test-ground.mjs" name)) "utf8"))) (js-array))))
      (js-object :file file :kind (cond ((or (= name ingress-file) (= name package-file)) "sequence") (mixed "mixed")
          ((or (= name sequence-file) (= name record-grid-file) (= name response-events-file)
               (= name literal-runtime-file) (= name wire-runtime-file) (= name sorted-runtime-file) (= name artifact-archive-file)
               (= name package-execution-file) (= name browser-session-file) (= name archive-debug-file)
               (= name persistent-literals-file) (= name direct-wasm-file)) "sequence") (t "ordinary"))
        :cancelled cancelled :pattern (functionalScopePattern cancelled))))

  ;; Complete artifact-archive, package, sequence, record-grid and measured large-runtime files retain every original case and
  ;; deadline; IR ingress retains every active JavaScript compiler case.
  ;; Its process belongs to the caller's controlled-run tree (24 GiB build
  ;; hard ceiling); the smaller file-supervisor ceiling is intentionally absent.
  ;; stdout/stderr are forwarded as streams, never accumulated by this driver.
  (defasync runFunctionalChild (file arguments &rest configuration)
    (let* ((options (if (> (js-length configuration) 0) (aref configuration 0) (js-object)))
           (environment (option options "environment" (get globalThis.process :env)))
           (command (if (get (get globalThis.process :versions) :bun) (get globalThis.process :execPath)
                      (option environment "BUN" "bun")))
           (started-at (Date/now))
           (child (spawn command (fixtureChildArguments arguments environment) (js-object :cwd (option options "sourceRoot" (js-call globalThis.process :cwd))
                    :env environment :stdio (js-array "ignore" "pipe" "pipe"))))
           (failure undefined) (cancel-code 0)
           (interrupt (lambda () (setq cancel-code 130) (js-call child :kill "SIGINT")))
           (terminate (lambda () (setq cancel-code 143) (js-call child :kill "SIGTERM"))))
      (js-call (get child :stdout) :pipe (option options "stdout" (get globalThis.process :stdout)) (js-object :end false))
      (js-call (get child :stderr) :pipe (option options "stderr" (get globalThis.process :stderr)) (js-object :end false))
      (js-call globalThis.process :on "SIGINT" interrupt)
      (js-call globalThis.process :on "SIGTERM" terminate)
      (try
        (await (new globalThis.Promise (lambda (complete)
          (js-call child :once "error" (lambda (error) (setq failure error)))
          (js-call child :once "close" (lambda (code signal)
            (let ((result (js-object :file file :exitCode
                    (if (/= cancel-code 0) cancel-code
                      (if failure 1 (if (Number/isInteger code) code
                        (cond ((= signal "SIGINT") 130) ((= signal "SIGTERM") 143) (t 1)))))
                    :elapsedMs (Math/max 0 (- (Date/now) started-at))
                    :monitor "outer-controlled-run")))
              (when failure (put result :failure "child-start-failed") (put result :message (get failure :message)))
              (when signal (put result :signal signal))
              (funcall complete result)))))))
        (finally (js-call globalThis.process :off "SIGINT" interrupt)
          (js-call globalThis.process :off "SIGTERM" terminate)))))

  (defasync run-mixed (plan environment cancellation start-supervisor)
    (let ((supervisor undefined) (result undefined)
          (interrupt nil) (terminate nil))
      (try
        (setq supervisor (await (funcall start-supervisor)))
        (setq interrupt (lambda () (js-call supervisor :cancel "SIGINT")))
        (setq terminate (lambda () (js-call supervisor :cancel "SIGTERM")))
        (js-call globalThis.process :on "SIGINT" interrupt)
        (js-call globalThis.process :on "SIGTERM" terminate)
        ;; The outer listeners already cover the asynchronous supervisor start.
        ;; A signal received there must never launch a test after readiness.
        (if (/= (get cancellation :code) 0)
          (setq result (js-object :file (get plan :file) :exitCode (get cancellation :code)
            :failure "cancelled" :started false))
          (progn
            (setq result (await (js-call supervisor :run (js-object :id "0" :file (get plan :file)
              :command (get globalThis.process :execPath) :args
                (fixtureChildArguments
                  (js-call (workerTestArguments (get plan :file)) :concat
                    (js-array "--test-name-pattern" (get plan :pattern))) environment)
              :cwd (js-call globalThis.process :cwd) :env environment))))
            (setq result (Object/assign (js-object :file (get plan :file)) result))))
        (catch error (setq result (js-object :file (get plan :file)
          :exitCode (if (/= (get cancellation :code) 0) (get cancellation :code) 1)
          :failure (if (/= (get cancellation :code) 0) "cancelled" "resource-supervisor-unavailable")
          :message (get error :message))))
        (finally
          (when interrupt (js-call globalThis.process :off "SIGINT" interrupt))
          (when terminate (js-call globalThis.process :off "SIGTERM" terminate))
          (when supervisor
            (try (await (js-call supervisor :close))
              (catch error
                (if (and result (/= (get result :exitCode) 0))
                  (put result :cleanupFailure (get error :message))
                  (setq result (js-object :file (get plan :file) :exitCode 1
                    :failure "resource-supervisor-cleanup" :message (get error :message)))))))))
      result))

  (defun fatal-scope-failure? (failure)
    (and (funcall globalThis.Boolean failure)
         (/= failure "spawn-error")
         (/= failure "child-start-failed")))

  (defun merge-intra-shard-outcomes (file shard-count bucket cancellation)
    (let ((ran (js-call bucket :filter (lambda (item)
                   (and item (not (eq (get item :started) false)))))))
      (if (= (js-length ran) 0)
        (let ((cancel-code (get cancellation :code)))
          (js-object :file file
            :exitCode (if (and (Number/isInteger cancel-code) (/= cancel-code 0)) cancel-code 1)
            :started false :shards (js-array)))
        (let* ((failed (js-call ran :find (lambda (item)
                         (or (/= (get item :exitCode) 0)
                             (and (funcall globalThis.Boolean (get item :failure))
                                  (/= (get item :failure) "cancelled"))))))
               (missing (< (js-length ran) shard-count))
               (max-elapsed 0)
               (max-peak-rss 0)
               (shard-rows (js-call bucket :map (lambda (item idx)
                             (when (and item (Number/isFinite (get item :elapsedMs))
                                        (> (get item :elapsedMs) max-elapsed))
                               (setq max-elapsed (get item :elapsedMs)))
                             (when (and item (Number/isFinite (get item :peakRssBytes))
                                        (> (get item :peakRssBytes) max-peak-rss))
                               (setq max-peak-rss (get item :peakRssBytes)))
                             (if item
                               (js-object :shardIndex (get item :shardIndex idx)
                                 :shardCount shard-count :exitCode (get item :exitCode)
                                 :elapsedMs (or (get item :elapsedMs) 0))
                               (js-object :shardIndex idx :shardCount shard-count
                                 :started false :exitCode 1)))))
               (row (js-object :file file
                      :exitCode (if failed (get failed :exitCode) (if missing 1 0))
                      :elapsedMs max-elapsed
                      :shards shard-rows))
               (primary (or failed (aref ran 0))))
          (when (> max-peak-rss 0)
            (put row :peakRssBytes max-peak-rss))
          (when (and failed (funcall globalThis.Boolean (get failed :failure))
                     (/= (get failed :failure) "cancelled"))
            (put row :failure (get failed :failure)))
          (when (and failed (funcall globalThis.Boolean (get failed :resource)))
            (put row :resource (get failed :resource)))
          (when (and failed (funcall globalThis.Boolean (get failed :message)))
            (put row :message (get failed :message)))
          (when (and failed (get failed :signal))
            (put row :signal (get failed :signal)))
          (when (and primary (get primary :monitor))
            (put row :monitor (get primary :monitor)))
          row))))

  (defun parse-scope-cli-flags (arguments)
    (let ((args (js-array)) (keep-going false) (rerun-failed false) (index 0))
      (while (< index (js-length arguments))
        (let ((arg (aref arguments index)))
          (cond
            ((= arg "--keep-going") (setq keep-going t))
            ((= arg "--rerun-failed") (setq rerun-failed t))
            (t (js-call args :push arg))))
        (setq index (1+ index)))
      (js-object :args args :keepGoing keep-going :rerunFailed rerun-failed)))

  (defasync runFinalFunctionalScope (arguments &rest configuration)
    (let* ((options (if (> (js-length configuration) 0) (aref configuration 0) (js-object)))
           (cli-flags (parse-scope-cli-flags arguments))
           (source-root (resolve (option options "sourceRoot" (js-call globalThis.process :cwd))))
           (environment (option options "environment" (get globalThis.process :env)))
           (real-runner (nullish? (field options "executors")))
           (cache-dir (field options "cacheDirectory"))
           (profile-path (when (= (value-type cache-dir) "string") (resolve source-root cache-dir "profile.json")))
           (failures-path (when (= (value-type cache-dir) "string") (resolve source-root cache-dir "last-failures.json")))
           (keep-going (or (eq (field options "keepGoing") t)
                           (get cli-flags :keepGoing)
                           (= (field environment "ELISCRIPT_TEST_KEEP_GOING") "1")))
           (rerun-failed (or (eq (field options "rerunFailed") t) (get cli-flags :rerunFailed)))
           (has-file-args (js-call (get cli-flags :args) :some (lambda (arg)
                            (and (= (value-type arg) "string") (not (js-call arg :startsWith "-"))))))
           (failed-prev (when rerun-failed (loadLastFailures source-root "final-functional-scope" failures-path)))
           (args-for-parse (if (and rerun-failed (not has-file-args) (> (js-length failed-prev) 0))
                             (js-call (get cli-flags :args) :concat failed-prev)
                             (get cli-flags :args)))
           (empty-rerun (and rerun-failed (not has-file-args) (= (js-length failed-prev) 0)))
           (parsed (if empty-rerun (js-object :files (js-array) :shard nil) (parseTestFileArgs args-for-parse)))
           (original (get parsed :files))
           (shard (get parsed :shard))
           (_filter-rerun (when (and rerun-failed has-file-args)
                            (let ((failed-set (new globalThis.Set (js-call failed-prev :map (lambda (f) (resolve source-root f))))))
                              (setq original (js-call original :filter (lambda (f) (js-call failed-set :has (resolve source-root f))))))))
           (files (if (= (js-length original) 0)
                    (js-array)
                    (functionalScopeFiles original shard environment source-root)))
           (profile (when real-runner (loadTestProfile source-root profile-path)))
           (wall-started (Date/now))
           (admission-pauses 0)
           (peak-aggregate-rss 0)
           (explicit-archive (field environment "ELISCRIPT_TEST_SCOPE_ARCHIVE_OUT"))
           (executors (option options "executors" (js-object)))
           (ordinary (option executors "ordinary" (async (batch env)
             (await (runTestFiles batch (js-object :environment env :sourceRoot source-root))))))
           (mixed (option executors "mixed" (async (plan env cancellation)
             (await (run-mixed plan env cancellation (option executors "startSupervisor" startResourceSupervisor))))))
           (sequence (option executors "sequence" (async (plan env)
             (await (runFunctionalChild (get plan :file)
               (let ((arguments (workerTestArguments (get plan :file))))
                 (when (get plan :pattern) (js-call arguments :push "--test-name-pattern" (get plan :pattern))) arguments)
               (js-object :sourceRoot source-root :environment env))))))
           (plans (js-array)) (cancelled (js-array)) (results (js-array)) (cursor 0) (exit-code 0) (halt false)
           (fixture undefined)
           (shared-supervisor nil)
           (parallel-config (resolveParallelConfig environment options))
           (use-parallel (and (get parallel-config :parallel) (nullish? (field options "executors"))))
           (cancellation (option options "cancellation" (js-object :code 0)))
           (interrupt (lambda ()
             (when (= (get cancellation :code) 0) (put cancellation :code 130))
             (when shared-supervisor (js-call shared-supervisor :cancel "SIGINT"))))
           (terminate (lambda ()
             (when (= (get cancellation :code) 0) (put cancellation :code 143))
             (when shared-supervisor (js-call shared-supervisor :cancel "SIGTERM")))))
      ;; Validate every selected mixed-suite source before starting any child.
      (let ((index 0))
        (while (< index (js-length files))
          (let ((plan (await (file-plan (aref files index) source-root))))
            (js-call plans :push plan)
            (Reflect/apply (get cancelled :push) cancelled (get plan :cancelled)))
          (setq index (1+ index))))
      (when shard (js-call globalThis.console :log
        (+ "Test file shard " (get shard :index) "/" (get shard :count) ": " (js-length files) "/" (js-length original) " selected")))
      (setq fixture (prepareFixtureEnvironment source-root environment))
      (setq environment (get fixture :environment))
      (when (and (/= (field environment "ELISCRIPT_DISABLE_TEST_IR_CACHE") "1")
                 (/= (field options "irCache") false)
                 (undefined? (field environment "ELISCRIPT_TEST_IR_CACHE")))
        (setq environment (Object/assign (js-object) environment (js-object :ELISCRIPT_TEST_IR_CACHE "1"))))
      (js-call globalThis.process :on "SIGINT" interrupt)
      (js-call globalThis.process :on "SIGTERM" terminate)
      (try
        (if use-parallel
          (progn
            (raiseProcessMaxListeners 64)
            (when (js-call plans :some (lambda (p) (or (= (get p :kind) "ordinary") (= (get p :kind) "mixed"))))
              (let ((use-agg (and (nullish? (field environment "ELISCRIPT_TEST_TOTAL_RSS_BYTES"))
                                  (nullish? (field options "limits"))
                                  (not (nullish? (get parallel-config :aggregateCeilingBytes))))))
                (setq shared-supervisor (await (if use-agg
                  (startResourceSupervisor (js-object :aggregateCeilingBytes (get parallel-config :aggregateCeilingBytes)))
                  (startResourceSupervisor))))))
            (let* ((order (lptFileIndices plans (lambda (p) (get p :file))))
                   (shard-buckets (new globalThis.Map))
                   (can-intra-shard (>= (get parallel-config :maxWorkers) 4))
                   (lpt-items (js-array)))
              (js-call order :forEach (lambda (plan-idx)
                (let* ((plan (aref plans plan-idx))
                       (kind (get plan :kind))
                       (file (get plan :file))
                       (heavy (or (= kind "sequence") (= kind "mixed") (isHeavyParallelTestFile file)))
                       (wire-call-sharded (and shard (wireCallProfile environment) (= (basename file) (basename wire-runtime-file))))
                       (shard-count (if (and can-intra-shard (not wire-call-sharded))
                                      (or (js-call INTRA_FILE_SHARDS :get (basename file)) 1)
                                      1)))
                  (if (<= shard-count 1)
                    (js-call lpt-items :push (js-object :index plan-idx :plan plan :heavy heavy
                      :exclusive (isSharedBuilderTestFile file)
                      :shardIndex 0 :shardCount 1
                      :weight (if profile (estimateTestWeight profile file (testFileWeight file)) (testFileWeight file))
                      :estimatedRssBytes (if profile (estimateTestRssBytes profile file heavy) (* 512 1024 1024))))
                    (let* ((bucket (js-array))
                           (s 0)
                           (base-weight (if profile (estimateTestWeight profile file (testFileWeight file)) (testFileWeight file)))
                           (est-rss (if profile (estimateTestRssBytes profile file heavy) (* 512 1024 1024)))
                           (per-weight (Math/floor (/ base-weight shard-count))))
                      (while (< s shard-count)
                        (js-call bucket :push nil)
                        (js-call lpt-items :push (js-object :index plan-idx :plan plan :heavy heavy
                          :exclusive (isSharedBuilderTestFile file)
                          :shardIndex s :shardCount shard-count :weight per-weight :estimatedRssBytes est-rss))
                        (setq s (1+ s)))
                      (js-call shard-buckets :set plan-idx bucket))))))
              (js-call lpt-items :sort (lambda (left right)
                (let ((diff (- (get right :weight) (get left :weight))))
                  (if (/= diff 0) diff
                    (let ((idx-diff (- (get left :index) (get right :index))))
                      (if (/= idx-diff 0) idx-diff
                        (- (get left :shardIndex) (get right :shardIndex))))))))
              (let ((sched-stats (await (runMemoryAwareLptQueue lpt-items
                                          (js-object
                                            :maxWorkers (get parallel-config :maxWorkers)
                                            :heavyWorkers (get parallel-config :heavyWorkers)
                                            :aggregateCeilingBytes (get parallel-config :aggregateCeilingBytes))
                                          (js-object
                                            :shouldStop (lambda ()
                                              (or halt
                                                  (/= (get cancellation :code) 0)
                                                  (and shared-supervisor (funcall globalThis.Boolean (field shared-supervisor "failure")))))
                                            :getLiveTelemetry (lambda ()
                                              (when (and shared-supervisor (= (value-type (get shared-supervisor :telemetry)) "function"))
                                                (js-call shared-supervisor :telemetry)))
                                            :runItem (async (entry)
                  (let* ((plan-idx (get entry :index))
                         (plan (get entry :plan))
                         (kind (get plan :kind))
                         (shard-index (get entry :shardIndex))
                         (shard-count (get entry :shardCount))
                         (child-environment environment))
                    (when (and shard (wireCallProfile environment)
                               (js-call (js-array wire-runtime-file sorted-runtime-file) :some
                                 (lambda (file) (= (resolve source-root (get plan :file)) (resolve source-root file)))))
                      (setq child-environment (Object/assign (js-object) child-environment (js-object
                        :ELISCRIPT_CALL_SHARD_INDEX (str (get shard :index))
                        :ELISCRIPT_CALL_SHARD_COUNT (str (get shard :count))))))
                    (when (> shard-count 1)
                      (let ((extra (js-object
                                     :ELISCRIPT_INTRA_SHARD_INDEX (str shard-index)
                                     :ELISCRIPT_INTRA_SHARD_COUNT (str shard-count))))
                        (when (get plan :pattern)
                          (put extra :ELISCRIPT_INTRA_SHARD_PATTERN (get plan :pattern)))
                        (setq child-environment (Object/assign (js-object) child-environment extra))))
                    (let ((outcome nil))
                      (if (= kind "sequence")
                        (setq outcome (await (runFunctionalChild (get plan :file)
                                          (let ((args (workerTestArguments (get plan :file))))
                                            (when (get plan :pattern) (js-call args :push "--test-name-pattern" (get plan :pattern))) args)
                                          (js-object :sourceRoot source-root :environment child-environment))))
                        (let* ((req-id (if (> shard-count 1)
                                         (str plan-idx "-s" shard-index)
                                         (funcall globalThis.String plan-idx)))
                               (request (if (= kind "mixed")
                                          (js-object :id req-id :file (get plan :file)
                                            :command (get globalThis.process :execPath)
                                            :args (fixtureChildArguments
                                                    (js-call (workerTestArguments (get plan :file)) :concat
                                                      (if (get plan :pattern) (js-array "--test-name-pattern" (get plan :pattern)) (js-array)))
                                                    child-environment)
                                            :cwd source-root :env child-environment)
                                          (workerRunRequest (get plan :file) source-root child-environment req-id))))
                          (try
                            (let* ((sup-res (await (js-call shared-supervisor :run request)))
                                   (row (js-object :file (get plan :file) :exitCode (get sup-res :exitCode))))
                              (when (and (funcall globalThis.Boolean (get sup-res :failure)) (/= (get sup-res :failure) "cancelled"))
                                (put row :failure (get sup-res :failure)))
                              (when (funcall globalThis.Boolean (get sup-res :resource)) (put row :resource (get sup-res :resource)))
                              (when (funcall globalThis.Boolean (get sup-res :message)) (put row :message (get sup-res :message)))
                              (when (Number/isFinite (get sup-res :elapsedMs)) (put row :elapsedMs (get sup-res :elapsedMs)))
                              (when (Number/isFinite (get sup-res :peakRssBytes)) (put row :peakRssBytes (get sup-res :peakRssBytes)))
                              (when (eq (get sup-res :started) false) (put row :started false))
                              (setq outcome row))
                            (catch error
                              (console/error error)
                              (setq outcome (js-object :file (get plan :file) :exitCode 1))))))
                      (if (> shard-count 1)
                        (progn
                          (put outcome :shardIndex shard-index)
                          (put outcome :shardCount shard-count)
                          (put (js-call shard-buckets :get plan-idx) shard-index outcome))
                        (put results plan-idx outcome))
                      (when (/= (get outcome :exitCode) 0) (setq exit-code (get outcome :exitCode)))
                      (when (and (not keep-going) (fatal-scope-failure? (get outcome :failure))) (setq halt t))))))))))
                (when sched-stats
                  (setq admission-pauses (or (get sched-stats :admissionPauses) 0))
                  (when (and (Number/isFinite (get sched-stats :peakAggregateRssBytes))
                             (> (get sched-stats :peakAggregateRssBytes) peak-aggregate-rss))
                    (setq peak-aggregate-rss (get sched-stats :peakAggregateRssBytes)))))
              (js-call shard-buckets :forEach (lambda (bucket plan-idx)
                (let* ((plan (aref plans plan-idx))
                       (merged (merge-intra-shard-outcomes (get plan :file) (js-length bucket) bucket cancellation)))
                  (put results plan-idx merged)
                  (when (and (/= (get merged :exitCode) 0) (= exit-code 0))
                    (setq exit-code (get merged :exitCode)))))))
            (setq results (js-call results :filter globalThis.Boolean)))
          (while (and (not halt) (= (get cancellation :code) 0) (< cursor (js-length plans)))
            (let ((plan (aref plans cursor)))
              (if (= (get plan :kind) "ordinary")
                (let ((batch (js-array)))
                  (while (and (< cursor (js-length plans)) (= (get (aref plans cursor) :kind) "ordinary"))
                    (js-call batch :push (get (aref plans cursor) :file))
                    (setq cursor (1+ cursor)))
                  (let ((outcome (await (funcall ordinary batch environment))))
                    (Reflect/apply (get results :push) results (get outcome :results))
                    (when (/= (get outcome :exitCode) 0) (setq exit-code (get outcome :exitCode)))
                    (when (fatal-scope-failure? (get outcome :failure)) (setq halt t))))
                (let* ((child-environment (if (and shard (wireCallProfile environment)
                               (js-call (js-array wire-runtime-file sorted-runtime-file) :some
                                 (lambda (file) (= (resolve source-root (get plan :file)) (resolve source-root file)))))
                         (Object/assign (js-object) environment (js-object
                           :ELISCRIPT_CALL_SHARD_INDEX (str (get shard :index))
                           :ELISCRIPT_CALL_SHARD_COUNT (str (get shard :count)))) environment))
                       (outcome (await (funcall (if (= (get plan :kind) "mixed") mixed sequence) plan child-environment cancellation))))
                  (js-call results :push outcome) (setq cursor (1+ cursor))
                  (when (/= (get outcome :exitCode) 0) (setq exit-code (get outcome :exitCode)))
                  (when (fatal-scope-failure? (get outcome :failure)) (setq halt t)))))))
        (finally
          (js-call globalThis.process :off "SIGINT" interrupt)
          (js-call globalThis.process :off "SIGTERM" terminate)
          (when shared-supervisor
            (when (= (value-type (get shared-supervisor :telemetry)) "function")
              (try
                (let ((snap (js-call shared-supervisor :telemetry)))
                  (when (and snap (Number/isFinite (get snap :aggregateRssBytes))
                             (> (get snap :aggregateRssBytes) peak-aggregate-rss))
                    (setq peak-aggregate-rss (get snap :aggregateRssBytes))))
                (catch _tel nil)))
            (try (await (js-call shared-supervisor :close)) (catch error nil)))
          (js-call fixture :close)))
      (let* ((completed (new globalThis.Set (js-call
                (js-call results :filter (lambda (item) (not (eq (get item :started) false))))
                :map (lambda (item) (get item :file)))))
             (failed-files (js-call (js-call results :filter
                             (lambda (item) (and (not (eq (get item :started) false))
                                                 (or (/= (get item :exitCode) 0) (funcall globalThis.Boolean (get item :failure))))))
                             :map (lambda (item) (get item :file))))
             (unstarted-files (js-call files :filter (lambda (file) (not (js-call completed :has file)))))
             (summary (summarizeSuiteRun (js-object
                        :suite "final-functional-scope"
                        :results results
                        :unstarted unstarted-files
                        :cancelled cancelled
                        :wallMs (- (Date/now) wall-started)
                        :peakAggregateRssBytes peak-aggregate-rss
                        :admissionPauses admission-pauses)))
             (digest-outcome (await (collectPassedFileDigests source-root results)))
             (directory (resolve (option options "outputDirectory" (resolve source-root ".eliscript-cache" "test-results"))))
             (archive (resolve directory (+ "final-functional-scope-" (Date/now) "-" (get globalThis.process :pid) ".json")))
             (record (js-object :format "eliscript-final-functional-test-scope"
               :inventory files :originalInventory original :shard shard :results results :cancelled cancelled
               :failedFiles failed-files
               :summary summary
               :passedFileDigests (get digest-outcome :digests)
               :passedFileDigestErrors (get digest-outcome :errors)
               :unstarted unstarted-files
               :exitCode (if (/= (get cancellation :code) 0) (get cancellation :code) exit-code) :archive archive)))
        (when real-runner
          (try (recordTestProfile source-root results profile-path) (catch _prof nil))
          (try (saveLastFailures source-root "final-functional-scope" failed-files failures-path) (catch _fail nil))
          (try (writeSuiteReport source-root summary) (catch _rep nil)))
        (try (await (mkdir directory (js-object :recursive t)))
          (let ((payload (+ (JSON/stringify record nil 2) "\n")))
            (await (writeFile archive payload))
            (when (and (= (value-type explicit-archive) "string") (> (js-length (js-call explicit-archive :trim)) 0))
              (let ((target-out (resolve source-root (js-call explicit-archive :trim))))
                (await (mkdir (dirname target-out) (js-object :recursive t)))
                (await (writeFile target-out payload)))))
          (catch error
            (put record :archiveFailure (get error :message))
            (when (= (get record :exitCode) 0) (put record :exitCode 1))
            (js-call globalThis.console :error (+ "Cannot archive final functional scope: " (get error :message)))))
        record)))

  (defasync main ()
    (try
      (let ((result (await (runFinalFunctionalScope (js-call (get globalThis.process :argv) :slice 2)))))
        (js-call globalThis.console :log
          (+ "Test files: " (js-length (js-call (get result :results) :filter
                (lambda (item) (not (eq (get item :started) false))))) "/" (js-length (get result :inventory)) " completed; "
             (js-length (js-call (get result :results) :filter (lambda (item) (/= (get item :exitCode) 0)))) " failed; "
             (js-length (get result :cancelled)) " compiler-host cases cancelled (not passed); scope: " (get result :archive)))
        (when (and (> (js-length (get result :inventory)) 1) (get result :summary))
          (js-call globalThis.console :log (formatSuiteSummary (get result :summary))))
        (put globalThis.process :exitCode (get result :exitCode)))
      (catch error (js-call globalThis.console :error (+ "Invalid final-functional scope: " (get error :message)))
        (put globalThis.process :exitCode 1))))
  (when (and (> (js-length (get globalThis.process :argv)) 1)
             (= (basename (aref (get globalThis.process :argv) 1)) "final-functional-scope.mjs"))
    (main))
  (export cancelledCompilerHostCases functionalScopePattern functionalScopeFiles runFunctionalChild runFinalFunctionalScope))
