(module tools.testing.compiler-package-execution
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:fs/promises" readFile mkdir writeFile)
  (import "node:path" resolve dirname basename)
  (import "node:module" createRequire)
  (import "node:crypto" createHash)
  (import "../backends/build.mjs" root)
  (import "./generated-fixture-module.mjs" loadGeneratedFixture)
  (defun compilerPackageFunctionalArguments (source-root environment arguments)
    ;; Each original case performs several sequential compiler, execution,
    ;; refusal and recovery subprocesses. Keep all their own 120000ms limits;
    ;; functional acceptance only separates the authenticated case total.
    (if (and (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
             (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")
             (= (js-length arguments) 3) (= (value-type (aref arguments 1)) "function")
             (= (aref arguments 2) 120000)
             (js-call (js-array
               "Given the original and relocated javascript compiler When node CLI request submits emit-ir Then real products sidecars and recovery preserve their ABI"
               "Given the original and relocated javascript compiler When node CLI request submits project-ir Then real products sidecars and recovery preserve their ABI")
               :includes (aref arguments 0)))
      (progn
        (unless (= (js-call (js-call (createHash "sha256") :update
                     (readFileSync (resolve source-root "tests/compiler-package-session.test.mjs"))) :digest "hex")
                   "cabaee3897e99a1c920dc4d3ba16459351a6d4864b327a03839c0c8d7d7d2b4c")
          (throw (new globalThis.TypeError "package functional deadline requires the unchanged complete original suite")))
        (let ((forwarded (js-call arguments :slice))) (put forwarded 2 0) forwarded)) arguments))
  (defun compilerPackageRuntimeFacade (runtime)
    ;; The archived suite used close for both native and WASM runtimes. Native
    ;; keeps its real close; the maintained WASM lifetime ends at closeModule.
    (if (= (value-type (get runtime :close)) "function") runtime
      (let* ((facade (Object/create (Object/getPrototypeOf runtime)))
             (descriptors (Object/getOwnPropertyDescriptors runtime)))
        (put descriptors :close (js-object :value (lambda () (js-call runtime :closeModule))
          :enumerable false :writable false :configurable false))
        (Object/defineProperties facade descriptors)
        (unless (Reflect/isExtensible runtime) (Object/preventExtensions facade)) facade)))
  (defun rewriteCompilerPackageExecution (arguments options source-root)
    (let* ((file (when (and (Array/isArray arguments) (> (js-length arguments) 0)) (aref arguments 0)))
           (package (and (= (js-length arguments) 1) (= (value-type file) "string")
             (js-call (js-array "run-package-bun.mjs" "run-package-node.mjs") :includes (basename file))))
           (product (and (= (js-length arguments) 2) (= (value-type file) "string")
             (= (basename file) "execute-product.mjs"))))
      (if (or package product)
        (progn
          (unless (and options (= (value-type (get options :cwd)) "string")
                       (= file (resolve (get options :cwd) (basename file)))
                       (= (js-call (js-call (createHash "sha256") :update (readFileSync file)) :digest "hex")
                         (if package "4f1da8ea334e7739646b77a19f1b6fc80582a1d43ff4ac2d6553ffa7b77e0d89"
                           "34da69a6d1a5288bed8a2a1d091c9248b6123fa821763296915c6dcdd1cf91fa")))
            (throw (new globalThis.TypeError "relocated compiler package child source identity changed")))
          (if package (js-array (resolve source-root "tools/testing/compiler-package-execution.mjs"))
            (js-array (resolve source-root "tools/testing/compiler-package-product.mjs") (aref arguments 1)))) undefined)))
  (defasync runRelocatedPackage ()
    (let* ((directory (js-call globalThis.process :cwd))
           (loader-path (resolve directory "installed/compiler-loader.mjs"))
           (loader (funcall (createRequire loader-path) loader-path))
           (compiler (await (js-call loader :openCompilerPackage))))
      (try
        (js-call assert :equal (get compiler :host) "javascript")
        (let ((capabilities (await (js-call compiler :request (js-object :operation "capabilities")))))
          (js-call (js-array "compile" "compile-ir" "runtime" "project") :forEach (lambda (name)
            (funcall assert (js-call (get capabilities :operations) :includes name)))))
        (let* ((source "(defun add (a b) (+ a b)) (export add)")
               (compiled (await (js-call compiler :request (js-object :operation "compile" :source source :filename "sum.eli"
                 :sourceMap (js-object :generatedFile "sum.mjs" :sourceName "sum.eli")))))
               (executed (await (loadGeneratedFixture directory (get compiled :javascript) "sum")))
               (diagnostic undefined))
          (js-call assert :equal (get compiled :filename) "sum.eli")
          (js-call assert :equal (js-call executed :add 19 23) 42)
          (js-call assert :equal (aref (get (JSON/parse (get compiled :sourceMap)) :sources) 0) "sum.eli")
          (try (await (js-call compiler :request (js-object :operation "compile"
                 :source "(defun broken () missing)" :filename "broken.eli")))
            (catch error (setq diagnostic (get error :eliscriptDiagnostic)) (js-call assert :equal (get error :name) "Error")))
          (js-call assert :equal (get diagnostic :code) "ELI-A0001")
          (js-call assert :equal (get (get diagnostic :location) :file) "broken.eli")
          (js-call assert :match (get diagnostic :message) (new globalThis.RegExp "unbound symbol: missing"))
          (let ((project (await (js-call compiler :request (js-object :operation "project" :target "javascript"
                  :entry "main.mjs" :resolveImports t :modules (js-array
                    (js-object :id "library.mjs" :filename "library.eli" :source "(defun twice (x) (* x 2)) (export twice)")
                    (js-object :id "main.mjs" :filename "main.eli" :source "(import \"./library.eli\" twice) (defun run () (twice 21)) (export run)")))))))
            (js-call assert :equal (get project :target) "javascript")
            (js-call assert :deepEqual (js-call (js-call (get project :modules) :map (lambda (member) (get member :id))) :sort)
              (js-array "library.mjs" "main.mjs"))
            (let ((index 0))
              (while (< index (js-length (get project :modules)))
                (let* ((member (aref (get project :modules) index)) (path (resolve directory "executed" (get member :id))))
                  (await (mkdir (dirname path) (js-object :recursive t)))
                  (await (writeFile path (get member :javascript))))
                (setq index (1+ index))))
            ;; Load the exact emitted entry from disk, preserving its real
            ;; dependency coordinates and package scope on both engines.
            (let* ((entry-path (resolve directory "executed/main.mjs"))
                   (entry (funcall (createRequire entry-path) entry-path)))
              (js-call assert :equal (js-call entry :run) 42))
            (await (js-call compiler :loadRuntime))
            (let* ((runtime-source (await (readFile (resolve directory "installed" (get (get compiler :manifest) :runtime)) "utf8")))
                   (request (js-object :operation "runtime" :source runtime-source :filename "bootstrap/runtime/memory.eli"))
                   (first (await (js-call compiler :request request))))
              (js-call assert :equal (get first :ready) t)
              (js-call assert :equal (get first :filename) "bootstrap/runtime/memory.eli")
              (await (js-call compiler :loadRuntime))
              (js-call assert :deepEqual (await (js-call compiler :request request)) first)
              (let ((recovered (await (js-call compiler :request (js-object :operation "compile" :source source :filename "recovered.eli")))))
                (js-call assert :equal (value-type (get recovered :javascript)) "string"))
              (js-call (get globalThis.process :stdout) :write (str (JSON/stringify
                (js-object :host (get compiler :host) :executed 42 :modules (js-length (get project :modules))
                  :diagnostic (get diagnostic :code) :runtimeReady (get first :ready) :revision (get first :revision)
                  :provenance (get (get (get compiler :artifact) :provenance) :mode))) "\n")))))
        (finally (await (js-call compiler :close))))
      (await (js-call compiler :close))
      (await (js-call assert :rejects (lambda () (js-call compiler :request (js-object :operation "capabilities")))
        (new globalThis.RegExp "closed")))))
  (defasync main ()
    (try (await (runRelocatedPackage))
      (catch error (console/error error) (put globalThis.process :exitCode 1))))
  (when (= (aref (get globalThis.process :argv) 1) (resolve root "tools/testing/compiler-package-execution.mjs"))
    (main))
  (export rewriteCompilerPackageExecution runRelocatedPackage compilerPackageRuntimeFacade compilerPackageFunctionalArguments))
