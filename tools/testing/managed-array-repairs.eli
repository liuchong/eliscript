(module tools.testing.managed-array-repairs
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "../backends/build.mjs" root)
  (import "../backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./fixture-environment.mjs" prepareFixtureEnvironment)
  (import "../../tests/helpers/managed-browser-transport.mjs" loadManagedReference)
  (defconst arrayCallbackCapacityTitle "actual callback capacity failure preserves earlier effects and unwinds only the entered frames")
  (defconst arraySpliceSupportTitle "splice checks frozen arrays and unsupported species only after numeric conversion and leaves ordinary inputs intact on rejection")
  (defun read (a value)
    (if (or (eq value nil) (= (value-type value) "boolean") (undefined? value)) value
      (cond ((= (get value :kind) 4) (js-call a :readNumber value)) ((= (get value :kind) 5) (js-call a :readString value))
        (t (js-call assert :strictEqual (get value :kind) 14)
          (let* ((result (new globalThis.Array (js-call a :length value)))
                 (keys (js-call a :objectKeys value)))
            (try
              (let ((index 0))
                (while (< index (js-call a :length keys))
                  (let* ((key (js-call a :get keys index)) (name (js-call a :readString key))
                         (child undefined))
                    (try
                      (setq child (js-call a :invoke "field-value" (js-array value key)))
                      (Object/defineProperty result name (js-object :value (read a child)
                        :writable t :enumerable t :configurable t))
                      (finally (js-call a :release key) (js-call a :release child))))
                  (setq index (1+ index))))
              (finally (js-call a :release keys))) result)))))
  (defun finish (a roots close)
    (js-call roots :forEach (lambda (value) (js-call a :release value)))
    (when close (js-call a :closeModule))
    (js-call a :collect) (js-call assert :strictEqual (js-call a :live) 0)
    (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 0))
  (defun bytes (backend runtime program)
    (let* ((before (JSON/stringify program)) (bytes (globalThis.Uint8Array.from
      (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (js-call assert :strictEqual (JSON/stringify program) before)
      (js-call assert :strictEqual (globalThis.WebAssembly.validate bytes) t)
      (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array)) bytes))
  (defasync runNormalArrayCallbackCapacity (backend runtime)
    (let* ((source (await (readFile (resolve root "tests/fixtures/wasm-managed-array-callbacks.eli") "utf8")))
           (program (js-call (get backend :compiler) :compile_ir_string source "callbacks.eli"))
           (a (instantiateManagedRuntime (bytes backend runtime program)))
           (ignored (js-call a :auto 1))
           (items (js-call a :sourceArray (js-call (new globalThis.Array 128) :fill t)))
           (log (js-call a :sourceArray (js-array))) (callback (js-call a :invoke "collect-arguments" (js-array log)))
           (keep (js-call a :number 7)) (frame (js-call a :frame 1)) (out undefined))
      (js-call a :frameSet frame 0 keep)
      (try
        (progn
          (setq out (js-call a :invoke "map-with" (js-array items callback)))
          (js-call assert :strictEqual (js-call a :length out) 128)
          (js-call assert :strictEqual (js-call a :length log) 128)
          (js-call assert :strictEqual (js-call a :length items) 128)
          (let ((index 0)) (while (< index 128)
            (let* ((row (js-call a :get log index)) (value (js-call a :get row 0))
                   (number (js-call a :get row 1)) (receiver (js-call a :get row 2)))
              (try (js-call assert :strictEqual (js-call a :length row) 3)
                (js-call assert :strictEqual value t) (js-call assert :strictEqual (js-call a :readNumber number) index)
                (js-call assert :ok (js-call a :keyEqual receiver items)) (js-call assert :strictEqual (js-call a :get out index) t)
                (finally (js-call (js-array row value number receiver) :forEach (lambda (value) (js-call a :release value))))))
            (setq index (1+ index))))
          (js-call assert :strictEqual (get (js-call a :stats) :frameDepth) 1)
          (let ((saved (js-call a :frameGet frame 0)))
            (try (js-call assert :strictEqual (js-call a :readNumber saved) 7) (finally (js-call a :release saved)))))
        (finally (js-call a :leaveFrame frame) (finish a (js-array items log callback keep out) false)))))
  (defasync runArraySpliceSupport (backend runtime)
    (let ((fixture (prepareFixtureEnvironment root (get globalThis.process :env))))
      (try
        (progn
          (let* ((source (await (readFile (resolve root "tests/fixtures/managed-splice-rejected.eli") "utf8")))
                 (program (js-call (get backend :compiler) :compile_ir_string source "array-splice.eli"))
                 (a (instantiateManagedRuntime (bytes backend runtime program)))
                 (ignored (js-call a :auto 1))
                 (js (await (loadManagedReference (get fixture :directory) (js-call (get backend :compiler) :emit_ir_string program) "splice-rejected")))
                 (failed false))
            (try
              (js-call (js-array 0 1) :forEach (lambda (mode)
                (let* ((value (js-call a :number mode)) (trace (js-call a :sourceArray (js-array)))
                       (expected (js-array)) (out (js-call a :invoke "rejected" (js-array value trace))))
                  (try (js-call assert :deepStrictEqual (read a out) (js-call js :rejected mode expected))
                    (js-call assert :deepStrictEqual (read a trace) expected)
                    (finally (js-call (js-array value trace out) :forEach (lambda (value) (js-call a :release value))))))))
              (catch error (setq failed t) (throw error))
              (finally
                (try (finish a (js-array) t)
                  (catch cleanup
                    (if failed (console/error "splice cleanup also failed; the original failure is retained" cleanup)
                      (throw cleanup)))))))
          (let ((observer (await (readFile (resolve root "tests/fixtures/managed-splice-observe.eli") "utf8"))) (index 0)
                (names (js-array "species" "accessor")))
            (while (< index (js-length names))
              (let* ((source (await (readFile (resolve root (+ "tests/fixtures/managed-splice-" (aref names index) ".eli")) "utf8")))
                     (program (js-call (get backend :compiler) :compile_ir_string (+ source observer) "splice-unsupported.eli"))
                     (a (instantiateManagedRuntime (bytes backend runtime program)))
                     (ignored (js-call a :auto 1))
                     (js (await (loadManagedReference (get fixture :directory) (js-call (get backend :compiler) :emit_ir_string program) "splice-supported")))
                     (one (js-call a :number 1)) (two (js-call a :number 2)) (three (js-call a :number 3))
                     (items (js-call a :sourceArray (js-array one two three))) (ctor (js-call a :sourceObject (js-object)))
                     (out undefined))
                (try
                  (progn
                    (setq out (js-call a :invoke "observe" (js-array items ctor)))
                    (let ((expected (js-call js :observe (js-array 1 2 3) (js-object))))
                      (js-call assert :strictEqual (aref expected 0) "TypeError")
                      (js-call assert :deepStrictEqual (read a out) expected)))
                  (finally (finish a (js-array one two three items ctor out) t))))
              (setq index (1+ index)))))
        (finally (js-call fixture :close)))))
  (export arrayCallbackCapacityTitle arraySpliceSupportTitle runNormalArrayCallbackCapacity runArraySpliceSupport))
