(module tools.testing.compiler-package-product
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve dirname)
  (import "node:module" createRequire)
  (import "../backends/build.mjs" root)
  (import "./compiler-package-execution.mjs" compilerPackageRuntimeFacade)
  (defun backend (input name)
    (let ((path (resolve (get input :transport) name)))
      (funcall (createRequire path) path)))
  (defasync executeCompilerPackageProduct (input)
    (let ((encodeCompilerIR (get (backend input "compiler-session.mjs") :encodeCompilerIR)))
      (if (= (get input :target) "javascript")
        (let ((saved (JSON/parse (await (readFile (resolve (get input :path) "eliscript-project.json") "utf8")))))
          (js-call assert :equal (get saved :target) "javascript")
          (js-call assert :equal (get saved :entry) "entry.mjs")
          (js-call assert :deepEqual (js-call (js-call (get saved :modules) :map (lambda (item) (get item :id))) :sort)
            (js-call (js-call (get input :modules) :map (lambda (item) (get item :id))) :sort))
          (let ((index 0))
            (while (< index (js-length (get saved :modules)))
              (let* ((item (aref (get saved :modules) index))
                     (source (js-call (get input :modules) :find (lambda (module) (= (get module :id) (get item :id)))))
                     (map (JSON/parse (await (readFile (resolve (get input :path) (get item :sourceMapPath)) "utf8")))))
                (js-call assert :deepEqual (get map :sources) (js-array (get source :filename)))
                (js-call assert :deepEqual (get map :sourcesContent) (js-array (get source :source))))
              (setq index (1+ index))))
          (let* ((path (resolve (get input :path) (get saved :entry)))
                 (entry (funcall (createRequire path) path)))
            (funcall assert (Object/is (js-call entry :run) -0.0)))
          (js-object :target (get input :target) :negativeZero t :modules (js-length (get saved :modules))))
        (let* ((bytes (new globalThis.Uint8Array (await (readFile (get input :path)))))
               (sidecar (JSON/parse (await (readFile (str (get input :path) ".json") "utf8"))))
               (debug (JSON/parse (await (readFile (resolve (dirname (get input :path)) (get sidecar :debugPath)) "utf8")))))
          (js-call assert :equal (get sidecar :target) (get input :target))
          (js-call assert :equal (get sidecar :debugPath) (get input :debugName))
          (funcall assert (js-call (get debug :ranges) :some (lambda (item)
            (and (not (nullish? (get item :span))) (= (get (get item :span) :filename) (get input :filename))
              (> (get item :end) (get item :start))))))
          (let ((runtime undefined) (trap undefined) (snapshot undefined))
            (if (get input :raw)
              (progn
                (js-call assert :equal (get sidecar :abi) "memory-u32")
                (js-call assert :equal (get sidecar :descriptor) undefined)
                (funcall assert (get sidecar :typed))
                (js-call assert :equal (funcall encodeCompilerIR (get sidecar :typed)) (get input :typedIR)
                  "typed sidecar must preserve every original IEEE code unit")
                (try
                  (if (= (get input :target) "wasm")
                    (let ((module (new globalThis.WebAssembly.Module bytes)))
                      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array))
                      (let* ((instance (new globalThis.WebAssembly.Instance module)) (e (get instance :exports)))
                      (js-call assert :equal (unsigned-bit-shift-right (js-call e :set32 8 4294967295) 0) 4294967295)
                      (js-call assert :equal (unsigned-bit-shift-right (js-call e :read32 8) 0) 4294967295)
                      (js-call assert :equal (js-call e :zero64 16) 0)
                      (funcall assert (Object/is (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 16 t) -0.0))
                      (js-call assert :throws (lambda () (js-call e :read32 65533))
                        (lambda (error) (setq trap error) (js-call globalThis.WebAssembly.RuntimeError (get globalThis.Symbol :hasInstance) error)))
                      (js-call assert :equal (js-call e :grow 1) 1)
                      (js-call assert :equal (js-call e :size) 2)
                      (js-call assert :equal (unsigned-bit-shift-right (js-call e :grow 1) 0) 4294967295)
                      (js-call assert :equal (js-call e :set32 65536 42) 42)))
                    (progn
                      (js-call assert :equal (get sidecar :nativeTarget) (get input :nativeTarget))
                      (js-call assert :equal (get sidecar :nativeFormat) "library")
                      (setq runtime (await (js-call (backend input "native-memory.mjs") :openNativeMemory (get input :path)
                        (js-object :read32 1 :set32 2 :grow 1 :size 0 :zero64 1)
                        (js-object :initialPages 1 :maximumPages 2 :nativeTarget (get input :nativeTarget)
                          :debug debug :trapSites (get debug :trapSites)))))
                      (js-call assert :equal (unsigned-bit-shift-right (js-call runtime :invoke "set32" 8 4294967295) 0) 4294967295)
                      (js-call assert :equal (unsigned-bit-shift-right (js-call runtime :invoke "read32" 8) 0) 4294967295)
                      (js-call assert :equal (js-call runtime :invoke "zero64" 16) 0)
                      (let ((raw (js-call runtime :read 16 8)))
                        (funcall assert (Object/is (js-call (new globalThis.DataView (get raw :buffer) (get raw :byteOffset) (get raw :byteLength)) :getFloat64 0 t) -0.0)))
                      (js-call assert :throws (lambda () (js-call runtime :invoke "read32" 65533))
                        (lambda (error) (setq trap error) (js-call globalThis.WebAssembly.RuntimeError (get globalThis.Symbol :hasInstance) error)))
                      (setq snapshot (globalThis.structuredClone (js-object :frames (get trap :eliscriptFrames) :sourceFrames (get trap :eliscriptSourceFrames))))
                      (js-call assert :equal (js-call runtime :invoke "grow" 1) 1)
                      (js-call assert :equal (js-call runtime :invoke "size") 2)
                      (js-call assert :equal (unsigned-bit-shift-right (js-call runtime :invoke "grow" 1) 0) 4294967295)
                      (js-call assert :equal (js-call runtime :invoke "set32" 65536 42) 42)))
                  (finally (unless (nullish? runtime) (js-call runtime :close))))
                (when snapshot
                  (js-call assert :deepEqual (js-object :frames (get trap :eliscriptFrames) :sourceFrames (get trap :eliscriptSourceFrames)) snapshot))
                (js-object :target (get input :target) :abi (get sidecar :abi) :negativeZero t :trap (get trap :name) :recovered 42))
              (progn
                (js-call assert :equal (get sidecar :abi) undefined)
                (funcall assert (get sidecar :descriptor))
                (if (= (get input :target) "wasm")
                  (let ((module (new globalThis.WebAssembly.Module bytes)))
                    (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array))
                    (setq runtime (compilerPackageRuntimeFacade (js-call (backend input "managed-runtime.mjs")
                      :instantiateManagedRuntime bytes (js-object :debug debug)))))
                  (progn
                    (funcall assert (get sidecar :typed))
                    (js-call assert :equal (get sidecar :nativeTarget) (get input :nativeTarget))
                    (js-call assert :equal (get sidecar :nativeFormat) "library")
                    (setq runtime (await (js-call (backend input "native-managed-runtime.mjs") :instantiateNativeManagedRuntime
                      (get input :path) (js-object :typed (get sidecar :typed) :descriptor (get sidecar :descriptor))
                      (Object/assign (js-object) (get input :memory) (js-object :nativeTarget (get input :nativeTarget) :debug debug)))))))
                (try
                  (js-call runtime :auto 1)
                  (let ((value (js-call runtime :invoke "run")))
                    (try (funcall assert (Object/is (js-call runtime :readNumber value) -0.0))
                      (finally (js-call runtime :release value))))
                  (js-call runtime :closeModule) (js-call runtime :collect)
                  (js-call assert :equal (js-call runtime :live) 0)
                  (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
                  (finally (js-call runtime :close)))
                (js-object :target (get input :target) :negativeZero t :live 0 :frameDepth 0))))))))
  (defasync main ()
    (try
      (let ((input (JSON/parse (await (readFile (aref (get globalThis.process :argv) 2) "utf8")))))
        (js-call (get globalThis.process :stdout) :write (str (JSON/stringify (await (executeCompilerPackageProduct input))) "\n")))
      (catch error (console/error error) (put globalThis.process :exitCode 1))))
  (when (= (aref (get globalThis.process :argv) 1) (resolve root "tools/testing/compiler-package-product.mjs")) (main))
  (export executeCompilerPackageProduct))
