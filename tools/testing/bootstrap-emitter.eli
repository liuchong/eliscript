(module tools.testing.bootstrap-emitter
  (import "bun:test" expect)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../backends/build.mjs" root)
  (import "./fixture-environment.mjs" prepareFixtureEnvironment)
  (defasync run (command options source-root)
    (let* ((child (js-call globalThis.Bun :spawn command (Object/assign
               (js-object :cwd source-root :stdout "pipe" :stderr "pipe") options)))
           (result (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (code (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (when (/= code 0)
        (throw (new globalThis.Error (+ (aref command 0) " exited with " code
          "\nstdout:\n" stdout "\nstderr:\n" stderr)))) stdout))
  (defasync case-source (item source-root)
    (if (Object/hasOwn item "source") (get item :source)
      (await (js-call (js-call globalThis.Bun :file (resolve source-root (get item :file))) :text))))
  (defasync seed-results (source-root)
    (JSON/parse (await (run (js-array (get (get globalThis.process :env) :EMACS "emacs")
      "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script" (resolve source-root "tests/bootstrap-emitter-oracle.el"))
      (js-object :env (Object/assign (js-object) (get globalThis.process :env)
        (js-object :ELISCRIPT_EMITTER_FIXTURE (resolve source-root "tests/fixtures/bootstrap-ir.json")))) source-root))))
  (defasync runBootstrapEmitterAcceptance (&rest configuration)
    (let* ((options (if (> (js-length configuration) 0) (aref configuration 0) (js-object)))
           (source-root (resolve (get options :sourceRoot root)))
           (fixture-path (resolve source-root "tests/fixtures/bootstrap-ir.json"))
           (build-path (resolve source-root "bin/eliscript-bootstrap"))
           (provided (get options :compilerDirectory))
           (directory (if provided (resolve provided) (await (mkdtemp (resolve source-root ".eliscript-emitter-")))))
           (fixture (prepareFixtureEnvironment source-root (get globalThis.process :env))))
        (try
          (progn
            (unless provided
              (await (run (js-array build-path) (js-object :env (Object/assign
                (js-object) (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory))) source-root)))
            (let* ((require (createRequire (resolve directory "package.json")))
                   (reader (funcall require (resolve directory "reader.mjs")))
                   (expander (funcall require (resolve directory "expander.mjs")))
                   (analyzer (funcall require (resolve directory "analyzer.mjs")))
                   (ir (funcall require (resolve directory "ir.mjs")))
                   (lower (funcall require (resolve directory "lower.mjs")))
                   (emitter (funcall require (resolve directory "emitter.mjs")))
                   (source-map (funcall require (resolve directory "source-map.mjs")))
                   (cases (await (js-call (js-call globalThis.Bun :file fixture-path) :json)))
                   (generated (js-array)) (index 0))
              (while (< index (js-length (get cases :valid)))
                (let* ((item (aref (get cases :valid) index)) (source (await (case-source item source-root)))
                       (filename (get item :filename))
                       (forms (js-call expander :expand_module (js-call reader :read_string source filename) filename)))
                  (js-call analyzer :analyze_module forms filename)
                  (let* ((program (js-call lower :lower_module forms filename))
                         (emission (js-call emitter :emit_module_with_source_map program source "fixture.mjs" filename)))
                    (js-call generated :push (js-object :name (get item :name) :status "ok"
                      :javascript (get emission :javascript) :sourceMap (JSON/parse (get emission :sourceMap))))))
                (setq index (1+ index)))
              (js-call (expect generated) :toEqual (await (seed-results source-root)))
              (let ((invalid-import (js-call ir :make_node "import-declaration" nil "invalid"
                      (js-array (js-call ir :make_node "import-namespace" nil "Namespace" (js-array) nil)
                        (js-call ir :make_node "import-named" nil "named" (js-array) nil)) nil)))
                (js-call (expect (lambda () (js-call emitter :emit_module
                  (js-call ir :make_program "invalid-import.eli" (js-array invalid-import)))))
                  :toThrow "namespace and named imports cannot be combined"))
              (let ((raw (js-call ir :make_node "raw-javascript" nil "js*"
                      (js-array (js-call ir :make_node "literal" nil "\"a\"" (js-array) "a")
                        (js-call ir :make_node "literal" nil "\"b\"" (js-array) "b")) nil)))
                (js-call (expect (lambda () (js-call emitter :emit_module (js-call ir :make_program "raw.js"
                  (js-array (js-call ir :make_node "expression-statement" nil "statement" (js-array raw) nil))))))
                  :toThrow "js* expects 1 argument, got 2"))
              (let ((raw (js-call ir :make_node "raw-javascript" nil "js*"
                      (js-array (js-call ir :make_node "reference" nil "fragment" (js-array) nil)) nil)))
                (js-call (expect (lambda () (js-call emitter :emit_module (js-call ir :make_program "raw.js"
                  (js-array (js-call ir :make_node "expression-statement" nil "statement" (js-array raw) nil))))))
                  :toThrow "js* expects a string literal"))
              (js-call (expect (js-call (js-array 0 1 -1 16 -16) :map (lambda (value) (js-call source-map :encode_vlq value))))
                :toEqual (js-array "A" "C" "D" "gB" "hB"))
              (let* ((basic (js-call generated :find (lambda (item) (= (get item :name) "executable-basic-module"))))
                     ;; User output uses the actual full package scope, outside
                     ;; the compiler product's deliberately closed exports.
                     (path (resolve (get fixture :directory) "executable-basic.mjs")))
                (await (writeFile path (get basic :javascript)))
                (let* ((output (await (run (js-array (get globalThis.process :execPath)
                         (resolve source-root "tests/helpers/bootstrap-emitter-node.mjs"))
                         (js-object :env (Object/assign (js-object) (get globalThis.process :env)
                           (js-object :ELISCRIPT_TEST_MODULE (get (pathToFileURL path) :href)))) source-root)))
                       (lines (js-call (js-call output :trim) :split "\n")))
                  (js-call (expect (JSON/parse (js-call lines :at -1))) :toEqual
                    (js-object :factorial 120 :sum 15 :message "hello from Eliscript"))))
              (js-call (expect (await (js-call (js-call globalThis.Bun :file (resolve directory "emitter.mjs.map")) :text)))
                :toContain "bootstrap/compiler/emitter.eli")))
          (finally (unless provided (await (rm directory (js-object :recursive t :force t)))) (js-call fixture :close)))))
  (export runBootstrapEmitterAcceptance))
