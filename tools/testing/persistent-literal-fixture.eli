(module tools.testing.persistent-literal-fixture
  (import "node:crypto" createHash)
  (import "node:path" resolve relative dirname)
  (import "node:fs" readFileSync writeFileSync mkdtempSync symlinkSync realpathSync lstatSync rmSync)
  (import "node:child_process" spawnSync)
  (import "node:assert/strict" :default assert)
  (import "node:url" pathToFileURL)
  (import "../../dist/bootstrap/compiler.mjs" compile-string compile-ir-string)
  (import "../../dist/bootstrap/emitter.mjs" emit-top-level emit-expression)
  (import "../../dist/bootstrap/ir.mjs" make-node)
  (import "./maintained-suite-source.mjs" maintainedSuiteSource sourceCall rewriteSourceForms compileMaintainedSuite)
  (defun unique-boundary (source text start)
    (let ((index (js-call source :indexOf text start)))
      (unless (and (>= index 0) (= (js-call source :indexOf text (1+ index)) -1))
        (throw (new globalThis.TypeError "original persistent literal oracle source boundary changed"))) index))
  (defun persistentLiteralHostArtifactSource ()
    ;; Analyze the complete original host scope before selecting its body.
    ;; Parameters are mutable bindings, matching the two real output locals;
    ;; no analysis-only declaration or parameter is emitted into the host.
    (let* ((program (compile-ir-string (js-call (js-array
      "(defun persistent-literal-host-boundary-context"
      " (lowered wasmBytes backend modules runtime literalModules memory originalModules originalLibrary assert)"
      "(funcall (lambda (originalRuntime)"
      " (setq lowered (js-call (get backend :managed) :lower_managed_project modules \"boundary.mjs\" runtime"
      "   (js-object :literalModules literalModules :phased t :foreignEntry t)))"
      " (js-call assert :deepEqual modules originalModules)"
      " (js-call assert :deepEqual literalModules originalLibrary)"
      " (js-call assert :deepEqual runtime originalRuntime)"
      " (js-call assert :deepEqual (get (get lowered :descriptor) :hostCapabilities)"
      "   (js-array (js-object :module \"eliscript.host\" :name \"source-operation\" :arity 2 :abi \"managed-host-call-v1\")))"
      " (setq wasmBytes (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section"
      "   (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)"
      "   \"eliscript-managed-control\" (JSON/stringify (get lowered :descriptor)))))"
      " (funcall (lambda (imports)"
      "   (js-call assert :deepStrictEqual (js-call imports :map (lambda (entry)"
      "     (js-object :module (get entry :module) :name (get entry :name) :kind (get entry :kind))))"
      "     (js-array (js-object :module \"eliscript.host\" :name \"source-operation\" :kind \"function\")))"
      "   (js-call imports :forEach (lambda (entry)"
      "     (when (Object/hasOwn entry \"type\")"
      "       (js-call assert :deepStrictEqual (get entry :type)"
      "         (js-object :parameters (js-array \"i32\" \"i32\") :results (js-array \"i32\")))))))"
      "   (WebAssembly.Module/imports (new globalThis.WebAssembly.Module wasmBytes))))"
      " (globalThis.structuredClone runtime)))") :join "\n")
      "persistent-literal-host-boundary.eli"))
           (context (aref (get program :body) 0))
           (parameters (get (get context :properties) :parameterCount))
           (children (get context :children)))
      (unless (and (= (js-length (get program :body)) 1)
                   (= (get context :kind) "function-declaration")
                   (= (get context :value) "persistent-literal-host-boundary-context")
                   (= parameters 10) (= (js-length children) 11))
        (throw (new globalThis.TypeError "persistent host activation lost its complete lexical context")))
      (let* ((body (aref children parameters))
             (statement (make-node "expression-statement" (get body :span) nil (js-array body) nil)))
        ;; Reuse the analyzed expression unchanged. Only its statement framing
        ;; is added through the ordinary validated IR constructor and emitter.
        (str (get (emit-top-level statement) :text) "\n"))))
  (defun persistentLiteralHostOptions (root environment executable)
    (js-object :cwd root :encoding "utf8" :timeout 60000
      :env (Object/assign (js-object) environment (js-object :BUN executable))))
  (defun persistentLiteralFunctionalHostScript (root engine script arguments)
    (let* ((environment (get globalThis.process :env))
           (executable (get globalThis.process :execPath))
           (configured (get environment :NODE_BINARY))
           (command (if (= engine "bun") executable (if (nullish? configured) "node" configured)))
           (result (spawnSync command (js-call (js-array script) :concat arguments)
                     (persistentLiteralHostOptions root environment executable))))
      ;; Retain the original first failure, status, full report and JSON parser.
      ;; Capacity deferral does not remove the original host process deadline.
      (js-call assert :equal (get result :error) undefined)
      (js-call assert :equal (get result :status) 0 (str (get result :stderr) (get result :stdout)))
      (JSON/parse (js-call (get result :stdout) :trim))))
  (defun persistentLiteralPrivateRegexURL (root directory)
    (let* ((base (resolve root ".eliscript-cache/test-fixtures"))
           (path (resolve directory))
           (owned (relative base path))
           (session-name (aref (js-call owned :split "/") 0))
           (session (resolve base session-name)))
      (unless (and (not (= owned "")) (not (js-call owned :startsWith ".."))
                   (js-call session-name :startsWith "session-") (= (dirname session) base)
                   (= (realpathSync session) session) (= (realpathSync path) path)
                   (js-call (lstatSync session) :isDirectory) (js-call (lstatSync path) :isDirectory))
        (throw (new globalThis.TypeError "private regex fixture requires its actual owned session directory")))
      (let* ((source (readFileSync (resolve root "runtime/core/regex.mjs")))
             (digest (js-call (js-call (createHash "sha256") :update source) :digest "hex")))
        (unless (= digest "6eb46cffdaf397d83b81227b4141111508f1e624beafc6d9468313a6e2e9515d")
          (throw (new globalThis.TypeError "complete original private regex module source changed")))
        (let ((private (mkdtempSync (resolve path "private-regex-"))))
          (try
            ;; Copy only authenticated original bytes. Its two dependencies
            ;; keep the real canonical module identity; the WeakMap owner gets
            ;; a distinct physical URL even on hosts that merge query imports.
            (js-call (js-array "collection.mjs" "vector.mjs") :forEach (lambda (name)
              (let ((actual (realpathSync (resolve root "runtime/core" name))))
                (symlinkSync actual (resolve private name) "file"))))
            (let ((file (resolve private "regex.mjs")))
              (writeFileSync file source (js-object :flag "wx"))
              (get (pathToFileURL file) :href))
            (catch error (rmSync private (js-object :recursive t :force t)) (throw error)))))))
  (defun persistentLiteralPrivateRegexExpression ()
    (let* ((program (compile-ir-string
             "(defun persistent-literal-private-coordinate (persistentLiteralPrivateRegexURL root directory) (funcall persistentLiteralPrivateRegexURL root directory))"
             "persistent-literal-private-coordinate.eli"))
           (context (aref (get program :body) 0))
           (parameters (get (get context :properties) :parameterCount))
           (children (get context :children)))
      (unless (and (= (js-length (get program :body)) 1) (= (get context :kind) "function-declaration")
                   (= (get context :value) "persistent-literal-private-coordinate")
                   (= parameters 3) (= (js-length children) 4))
        (throw (new globalThis.TypeError "private regex coordinate lost its complete lexical context")))
      (get (emit-expression (aref children parameters)) :text)))
  (defun persistent-literal-tail (source start functional)
    (let* ((coordinate "pathToFileURL(resolve(root, 'runtime/core/regex.mjs')).href")
           (coordinate-at (unique-boundary source coordinate start))
           (expression (persistentLiteralPrivateRegexExpression))
           (tail (str (js-call source :slice start coordinate-at) expression
                   (js-call source :slice (+ coordinate-at (js-length coordinate))))))
      (when functional
        (let* ((begin (unique-boundary tail "function hostScript(" 0))
               (end (unique-boundary tail "\n\nfor (const host of" begin))
               (deadline (unique-boundary tail "    }, 60000);" end)))
          (setq tail (str (js-call tail :slice 0 begin) (js-call tail :slice end)))))
      tail))
    (defconst persistent-host-activation "(funcall (lambda (originalRuntime)\n (setq lowered (js-call (get backend :managed) :lower_managed_project modules \"boundary.mjs\" runtime\n   (js-object :literalModules literal-modules :phased t :foreignEntry t)))\n (js-call assert :deepEqual modules original-modules)\n (js-call assert :deepEqual literal-modules original-library)\n (js-call assert :deepEqual runtime originalRuntime)\n (js-call assert :deepEqual (get (get lowered :descriptor) :hostCapabilities)\n   (js-array (js-object :module \"eliscript.host\" :name \"source-operation\" :arity 2 :abi \"managed-host-call-v1\")))\n (setq wasm-bytes (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section\n   (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)\n   \"eliscript-managed-control\" (JSON/stringify (get lowered :descriptor)))))\n (funcall (lambda (imports)\n   (js-call assert :deepStrictEqual (js-call imports :map (lambda (entry)\n     (js-object :module (get entry :module) :name (get entry :name) :kind (get entry :kind))))\n     (js-array (js-object :module \"eliscript.host\" :name \"source-operation\" :kind \"function\")))\n   (js-call imports :forEach (lambda (entry)\n     (when (Object/hasOwn entry \"type\")\n       (js-call assert :deepStrictEqual (get entry :type)\n         (js-object :parameters (js-array \"i32\" \"i32\") :results (js-array \"i32\")))))))\n   (WebAssembly.Module/imports (new globalThis.WebAssembly.Module wasm-bytes))))\n (globalThis.structuredClone runtime))")
  (defun projectPersistentLiteralSource (root source &rest supplied)
    (unless (= (js-call (js-call (createHash "sha256") :update source) :digest "hex") "65f2e793ec63b62677aec16b74bbdaddb1e21cc56d5f38154784b07f51eabf78")
      (throw (new globalThis.TypeError "complete original persistent literal suite source changed")))
    (unless (= (js-call (js-call (createHash "sha256") :update (readFileSync (resolve root "tools/testing/persistent-literal-oracle.eli"))) :digest "hex") "6fada646b540292d8c44d346b4806e651c659489ef6dbe10b0a6df4fc3e031ba")
      (throw (new globalThis.TypeError "complete independent persistent literal expectation source changed")))
    (let* ((environment (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (get globalThis.process :env) (aref supplied 0)))
           (functional (and (= (get environment :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
                            (= (get environment :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")))
           (maintained (maintainedSuiteSource root "tests/wasm-managed-persistent-literals.test.mjs" source))
           (seen (new globalThis.Set))
           (projected (rewriteSourceForms maintained
             (lambda (node node-text)
               (let ((items (get node :items)) (kind undefined) (replacement undefined))
                 (cond
                   ((and (sourceCall node "defconst") (= (get (aref items 1) :name) "root"))
                    (setq kind "root" replacement (str "(defconst root " (JSON/stringify (resolve root)) ")")))
                   ((and (sourceCall node "defconst") (= (get (aref items 1) :name) "budget"))
                    (setq kind "budget" replacement
                      (if functional "(defconst budget (Object/freeze (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864)))" (funcall node-text node))))
                   ((and (sourceCall node "defun") (= (get (aref items 1) :name) "assert-original-report"))
                    (setq kind "oracle" replacement "(defun assert-original-report (report) (assertOriginalReport expect report))"))
                   ((and (sourceCall node "defun") (= (get (aref items 1) :name) "host-script"))
                    (setq kind "host" replacement
                      (if functional "(defun host-script (engine script args &rest ignored) (persistentLiteralFunctionalHostScript root engine script args))"
                        (funcall node-text node))))
                   ((and (sourceCall node "js-call")
                         (js-call (funcall node-text node) :startsWith "(js-call assert :deepEqual")
                         (js-call (funcall node-text node) :includes "(WebAssembly.Module/imports (new WebAssembly.Module wasm-bytes))"))
                    (setq kind "activation" replacement (str "(progn " (funcall node-text node) " " persistent-host-activation ")")))
                   ((and (sourceCall node "get")
                         (js-call (funcall node-text node) :includes "(pathToFileURL (resolve root \"runtime/core/regex.mjs\"))"))
                    (setq kind "regex" replacement "(persistentLiteralPrivateRegexURL root directory)")))
                 (unless (undefined? kind)
                   (when (js-call seen :has kind) (throw (new globalThis.TypeError "persistent literal projection source is ambiguous")))
                   (js-call seen :add kind))
                 replacement)))))
      (unless (= (get seen :size) 6) (throw (new globalThis.TypeError "original persistent literal source boundary changed")))
      (when functional
        (console/error "persistent literal original 1024-slot capacity DEFERRED / NOT ACCEPTED"
          (js-object :original (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)
            :effective (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864)))
        (console/error "persistent literal original 60000ms host and case deadlines retained"
          (js-object :originalHostDeadlineMs 60000 :originalCaseDeadlineMs 60000 :functionalDeadlineMs 60000)))
      (put projected :original maintained) projected))
  (defun projectPersistentLiteralSuite (root source &rest supplied)
    (let ((proof (Reflect/apply projectPersistentLiteralSource undefined (js-call (js-array root source) :concat supplied))))
      (compileMaintainedSuite (get proof :source) "tests/wasm-managed-persistent-literals.test.mjs"
        (str "(import " (JSON/stringify (get (pathToFileURL (resolve root "tools/testing/persistent-literal-oracle.mjs")) :href)) " assertOriginalReport)\n"
             "(import " (JSON/stringify (get (pathToFileURL (resolve root "tools/testing/persistent-literal-fixture.mjs")) :href))
             " persistentLiteralPrivateRegexURL persistentLiteralFunctionalHostScript)"))))
  (export projectPersistentLiteralSource projectPersistentLiteralSuite persistentLiteralHostArtifactSource
    persistentLiteralPrivateRegexURL persistentLiteralPrivateRegexExpression persistentLiteralHostOptions persistentLiteralFunctionalHostScript))
