(module tools.testing.initializer-array-fixture
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs" readFileSync writeFileSync mkdirSync symlinkSync realpathSync)
  (import "node:path" resolve dirname basename)
  (import "./managed-primitive-own-repairs.mjs" transformOriginalPrimitiveRuntimeSuite)
  (import "./persistent-literal-fixture.mjs" projectPersistentLiteralSuite)
  (import "node:url" pathToFileURL)
  (import "../../dist/bootstrap/compiler.mjs" compile-string)
  (defconst suite "tests/wasm-managed-initializer-outlining.test.mjs")
  (defconst source-sha "e3d2cd7d8e3d5f28a08f20401cf8cfa48ed10743136a2e39ef9b895bbd5e074e")
  (defconst initializerArrayMethods (js-array
    (js-array "push" 1) (js-array "pop" 0) (js-array "slice" 2) (js-array "map" 1)
    (js-array "filter" 1) (js-array "forEach" 1) (js-array "some" 1) (js-array "every" 1)
    (js-array "find" 1) (js-array "findIndex" 1) (js-array "findLast" 1) (js-array "findLastIndex" 1)
    (js-array "reduce" 1) (js-array "reduceRight" 1) (js-array "sort" 1) (js-array "toSorted" 1)
    (js-array "splice" 2) (js-array "join" 1) (js-array "toString" 0) (js-array "concat" 1)
    (js-array "includes" 1) (js-array "indexOf" 1) (js-array "lastIndexOf" 1)
    (js-array "entries" 0) (js-array "keys" 0) (js-array "values" 0) (js-array "at" 1) (js-array "reverse" 0)))
  (defun nodes (node)
    (let ((pending (js-array node)) (out (js-array)))
      (while (> (js-length pending) 0)
        (let ((next (js-call pending :pop)))
          (js-call out :push next)
          (Reflect/apply (get pending :push) pending (get next :children)))) out))
  (defun includes-reference (node name)
    (js-call (nodes node) :some (lambda (item) (and (= (get item :kind) "reference") (= (get item :value) name)))))
  (defun assertInitializerArrayRegistration (runtime)
    (let* ((declarations (js-call (get runtime :body) :flatMap nodes))
           (register (js-call declarations :filter (lambda (node)
             (and (= (get node :kind) "function-declaration") (= (get node :value) "value-array-prototype-register"))))))
      (js-call assert :strictEqual (js-length register) 1 "actual Array prototype registration must be unique")
      (let* ((body (nodes (aref register 0)))
             (updates (js-call body :filter (lambda (node)
               (and (= (get node :kind) "assignment-pair") (= (get node :value) "index")))))
             (loops (js-call body :filter (lambda (node)
               (and (= (get node :kind) "loop")
                 (let ((condition (aref (get node :children) 0)))
                   (and (includes-reference condition "index") (includes-reference condition "methods")
                     (includes-reference condition "load-u32")
                     (includes-reference condition "heap-block")
                     (js-call (nodes condition) :some (lambda (child)
                       (and (= (get child :kind) "literal") (= (get child :value) 4)))))))))))
        (js-call assert :strictEqual (js-length updates) 1 "registration advances its method index exactly once")
        (js-call assert :strictEqual (js-length loops) 1 "registration reads the actual method vector length")
        (js-call assert :ok (js-call (js-call (get (aref loops 0) :children) :slice 1) :some
          (lambda (child) (js-call (nodes child) :includes (aref updates 0))))
          "index advancement remains inside the genuine loop body"))))
  (defun boundary (source text start)
    (let ((at (js-call source :indexOf text start)))
      (unless (and (>= at 0) (= (js-call source :indexOf text (1+ at)) -1))
        (throw (new globalThis.TypeError "original initializer source boundary changed"))) at))
  (defun projectInitializerArraySuite (root source)
    (unless (= (js-call (js-call (createHash "sha256") :update source) :digest "hex") source-sha)
      (throw (new globalThis.TypeError "complete original initializer suite source changed")))
    (let* ((begin (boundary source "function assertArrayRegistrationAdvances(){" 0))
           (end (boundary source "\ntest('the actual runtime IR" begin))
           (table (boundary source " const methods=[[" end))
           (finish (+ (js-call source :indexOf "];" table) 2))
           (helper (compile-string (str "(import "
             (JSON/stringify (get (pathToFileURL (resolve root "tools/testing/initializer-array-fixture.mjs")) :href))
             " assertInitializerArrayRegistration)\n"
             "(defun assertArrayRegistrationAdvances () (assertInitializerArrayRegistration (js* \"runtime\")))")
             "initializer-array-registration.eli")))
      (unless (> finish table) (throw (new globalThis.TypeError "original initializer method table is incomplete")))
      (str (js-call source :slice 0 begin) helper (js-call source :slice end table)
        (js-call source :slice table (+ table (js-length " const methods=")))
        (JSON/stringify initializerArrayMethods) ";" (js-call source :slice finish))))
  (defun prepareInitializerFixtureArguments (arguments root environment)
    (let ((selected (js-call (js-array suite "tests/wasm-managed-primitive-own-runtime.test.mjs"
                     "tests/wasm-managed-operand-conversion.test.mjs" "tests/wasm-managed-persistent-literals.test.mjs") :find
                       (lambda (relative) (js-call arguments :some
                         (lambda (argument) (= (resolve root argument) (resolve root relative))))))))
      (if (undefined? selected) arguments
      (let* ((directory (get environment :ELISCRIPT_TEST_FIXTURE_DIRECTORY))
             (base (resolve root ".eliscript-cache/test-fixtures")))
        (unless (and (= (value-type directory) "string") (= (dirname directory) base)
                     (= (realpathSync directory) directory))
          (throw (new globalThis.TypeError "initializer projection requires its owned fixture directory")))
        (let* ((target-root (resolve directory "initializer-source")) (tests (resolve target-root "tests"))
               (target (resolve tests (basename selected)))
               (source (readFileSync (resolve root selected) "utf8")))
          (mkdirSync tests (js-object :recursive t))
          (let ((links (js-array (js-array (resolve root "tools") (resolve target-root "tools"))
            (js-array (resolve root "tests/helpers") (resolve tests "helpers")))))
            (when (= selected "tests/wasm-managed-persistent-literals.test.mjs")
              (js-call (js-array "runtime" "bootstrap" "dist" "stdlib" "bin" "node_modules" "package.json") :forEach
                (lambda (name) (js-call links :push (js-array (resolve root name) (resolve target-root name)))))
              (js-call links :push (js-array (resolve root "tests/fixtures") (resolve tests "fixtures"))))
          (js-call links :forEach (lambda (pair)
            (try (symlinkSync (aref pair 0) (aref pair 1) "dir")
              (catch error (unless (and (= (get error :code) "EEXIST") (= (realpathSync (aref pair 1)) (realpathSync (aref pair 0)))) (throw error)))))))
          (writeFileSync target (if (= selected suite) (projectInitializerArraySuite root source)
            (if (= selected "tests/wasm-managed-persistent-literals.test.mjs") (projectPersistentLiteralSuite root source environment)
              (transformOriginalPrimitiveRuntimeSuite source selected))))
          (js-call arguments :map (lambda (argument) (if (= (resolve root argument) (resolve root selected)) target argument))))))))
  (export initializerArrayMethods assertInitializerArrayRegistration projectInitializerArraySuite prepareInitializerFixtureArguments))
