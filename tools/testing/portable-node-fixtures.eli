(module tools.testing.portable-node-fixtures
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../backends/build.mjs" :as build)
  (import "./wasm-static-snapshot.mjs" adaptStaticSnapshotCompiler)
  (defconst plans (js-array
    (js-object :suite "tests/wasm-memory-static-data.test.mjs" :entry "tests/wasm-memory-static-data-test-ground.mjs" :cases 19
      :archive "tests/wasm-memory-static-data-test-ground.mjs" :sha256 "ad8c6c48bf1a732d3b2a86b0cc4e31d27900939486516b8e176a489597a81332")
    (js-object :suite "tests/compiler-portable-guards.test.mjs" :entry "tests/compiler-portable-guards.test.mjs" :cases 5
      :archive "tests/compiler-portable-guards-test-ground.mjs" :sha256 "11588f03a29593318908caa21953bc56178774c3b5c052a8079308d8a0e3d7a6")
    (js-object :suite "tests/wasm-managed-number-text.test.mjs" :entry "tests/wasm-managed-number-text.test.mjs" :cases 9
      :archive "tests/wasm-managed-number-text-test-ground.mjs" :sha256 "f3788d1cda58227d8e28a968ad3678de884ca546883afa7c97439044ecd9cf9d")))
  (defconst selected (js-call plans :filter (lambda (plan)
    (js-call (get globalThis.process :argv) :some (lambda (argument) (= (resolve (get build :root) argument) (resolve (get build :root) (get plan :entry))))))))
  (js-call assert :strictEqual (js-length selected) 1)
  (defconst portableNodePlan (aref selected 0))
  (js-call assert :strictEqual
    (js-call (js-call (createHash "sha256") :update (readFileSync (resolve (get build :root) (get portableNodePlan :archive)))) :digest "hex")
    (get portableNodePlan :sha256))
  (defvar portableStaticBackend undefined)
  (defvar portableStaticDirectory undefined)
  (defasync portableStaticBuild (&rest arguments)
    (let ((actual (await (Reflect/apply (get build :buildBackends) build arguments))))
      (setq portableStaticDirectory (get (aref arguments 0) :outputRoot))
      (js-call assert :strictEqual (value-type portableStaticDirectory) "string")
      (setq portableStaticBackend (Object/assign (js-object) actual
        (js-object :compiler (if (= (get portableNodePlan :cases) 19)
          (adaptStaticSnapshotCompiler (get actual :compiler) portableStaticDirectory) (get actual :compiler)))))
      portableStaticBackend))
  (defun portableNodeRoute (specifier parentURL bridgeURL buildURL)
    (let ((entryURL (get (pathToFileURL (resolve (get build :root) (get portableNodePlan :entry))) :href)))
      (cond
        ((and (= parentURL entryURL) (= specifier "bun:test")) (js-object :url bridgeURL :shortCircuit t))
        ((and (/= (get portableNodePlan :cases) 5) (= parentURL entryURL) (= specifier "../tools/backends/build.mjs"))
          (js-object :url buildURL :shortCircuit t))
        (t undefined))))
  (export portableNodePlan portableStaticBackend portableStaticDirectory portableStaticBuild portableNodeRoute))
