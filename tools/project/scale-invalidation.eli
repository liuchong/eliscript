    (try (let ((report (await (runProjectScaleInvalidation)))) (js-call (get globalThis.process :stdout) :write (str (JSON/stringify report nil 2) "\n")))
      (catch error (js-call (get globalThis.process :stderr) :write (str (coalesce (at error "stack") error) "\n")) (put globalThis.process :exitCode 1)))))
  (js-call (run-module-entry) :catch (lambda (error) (js-call (get globalThis.process :stderr) :write (str error "\n")) (put globalThis.process :exitCode 1)))
  (export runProjectScaleInvalidation))
