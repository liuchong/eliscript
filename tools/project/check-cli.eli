(module tools.project.check-cli
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./check-cli-legacy.mjs" :as legacy)
  (import "./bun.mjs" diagnosticFromError renderDiagnostic requestedDiagnosticFormat)
  (defconst parseArguments (get legacy :parseArguments))
  (defasync execute (arguments &rest supplied)
    (let* ((arguments (Array/from arguments))
           (options (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
           (parsed (parseArguments arguments)))
      (when (and (not (undefined? (get parsed :stdinFile))) (nullish? (get options :stdinSource)))
        (setq options (Object/assign (js-object) options (js-object :stdinSource (readFileSync 0 "utf8")))))
      (await (js-call legacy :execute arguments options))))
  (defasync main (&rest supplied)
    (let* ((arguments (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
                       (js-call (get globalThis.process :argv) :slice 2) (aref supplied 0)))
           (execution (await (execute arguments))))
      (if (get execution :help) (await (js-call legacy :main arguments))
        (js-call (get globalThis.process :stdout) :write
          (str (if (get execution :jsonReport) (JSON/stringify (get (get execution :result) :report))
            (str "Checked " (get (get (get (get execution :result) :report) :counts) :modules) " modules.")) "\n")))))
  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (not (undefined? entry)) (= (resolve entry) (fileURLToPath (js* "import.meta.url"))))
      (let ((format (requestedDiagnosticFormat (js-call (get globalThis.process :argv) :slice 2))))
        (js-call (main) :catch (lambda (error)
          (let ((diagnostic (diagnosticFromError error)))
            (if (= format "json") (console/error (JSON/stringify diagnostic))
              (console/error (str "eliscript-check: " (renderDiagnostic diagnostic))))
            (put globalThis.process :exitCode 1)))))))
  (export parseArguments execute main))
