(module tools.experiments.native-wasm.emit-c
  ;; Experimental, deliberately partial backend. This is not a public compiler.
  ;; Only pure scalar f64 expressions and statement control flow are accepted.
  (defun emitNumericC (program)
    (let ((serial 0)
          (functions (js-array))
          (exported (new globalThis.Set)))
      (letfn ((fail (node message)
                (let* ((span (or (get node :span) (js-object)))
                       (fname (or (get span :filename) (get program :filename)))
                       (line (or (get span :line) 1)))
                  (throw (new globalThis.Error (str fname ":" line ": " message)))))
              (fresh ()
                (let ((current serial))
                  (setq serial (1+ serial))
                  (str "v" current)))
              (emit-expression (node scope)
                (let ((kind (get node :kind))
                      (value (get node :value))
                      (children (get node :children)))
                  (cond
                    ((and (= kind "literal") (not (get node :properties)))
                     (cond
                       ((and (= (value-type value) "number") (Number/isFinite value))
                        (let* ((text (funcall globalThis.String value))
                               (literal (if (js-call (new globalThis.RegExp "[.e]" "i") :test text)
                                          text
                                          (str text ".0"))))
                          (js-object :type "double"
                            :code (if (Object/is value -0.0) "(-0.0)" (str "(" literal ")")))))
                       ((= (value-type value) "boolean")
                        (js-object :type "int" :code (if value "1" "0")))
                       (t (fail node (str "unsupported expression " kind ":" value "; no silent fallback")))))
                    ((and (= kind "reference") (js-call scope :has value))
                     (js-call scope :get value))
                    ((and (= kind "short-circuit")
                          (js-call (js-array "and" "or") :includes value)
                          (>= (js-length children) 2))
                     (let ((args (js-call children :map (lambda (child) (emit-expression child scope)))))
                       (when (js-call args :some (lambda (arg) (/= (get arg :type) "int")))
                         (fail node "and/or requires booleans in this probe"))
                       (js-object :type "int"
                         :code (str "(" (js-call (js-call args :map (lambda (arg) (get arg :code)))
                                          :join (if (= value "and") " && " " || ")) ")"))))
                    ((= kind "intrinsic")
                     (let ((args (js-call children :map (lambda (child) (emit-expression child scope)))))
                       (when (js-call args :some (lambda (arg) (/= (get arg :type) "double")))
                         (fail node "numeric operands required"))
                       (cond
                         ((and (js-call (js-array "1+" "1-") :includes value) (= (js-length args) 1))
                          (js-object :type "double"
                            :code (str "(" (get (aref args 0) :code) " " (if (= value "1+") "+" "-") " 1.0)")))
                         ((and (js-call (js-array "+" "-" "*" "/") :includes value) (= (js-length args) 2))
                          (js-object :type "double"
                            :code (str "(" (get (aref args 0) :code) " " value " " (get (aref args 1) :code) ")")))
                         ((and (js-call (js-array "<" "<=" ">" ">=" "=") :includes value) (= (js-length args) 2))
                          (js-object :type "int"
                            :code (str "(" (get (aref args 0) :code) " " (if (= value "=") "==" value) " " (get (aref args 1) :code) ")")))
                         (t (fail node (str "unsupported expression " kind ":" value "; no silent fallback"))))))
                    ((and (= kind "conditional") (= (js-length children) 3))
                     (let* ((items (js-call children :map (lambda (child) (emit-expression child scope))))
                            (condition (aref items 0))
                            (yes (aref items 1))
                            (no (aref items 2)))
                       (when (or (/= (get condition :type) "int") (/= (get yes :type) (get no :type)))
                         (fail node "typed conditional required"))
                       (js-object :type (get yes :type)
                         :code (str "(" (get condition :code) " ? " (get yes :code) " : " (get no :code) ")"))))
                    (t (fail node (str "unsupported expression " kind ":" value "; no silent fallback"))))))
              (emit-block (nodes scope returning)
                (when (= (js-length nodes) 0)
                  (throw (new globalThis.Error "empty numeric body")))
                (js-call (js-call nodes :map (lambda (node index)
                           (emit-statement node scope (and returning (= index (1- (js-length nodes)))))))
                  :join "\n"))
              (emit-statement (node scope returning)
                (let ((kind (get node :kind))
                      (value (get node :value))
                      (children (get node :children))
                      (props (or (get node :properties) (js-object))))
                  (cond
                    ((= kind "lexical-bindings")
                     (let ((inner (new globalThis.Map scope))
                           (bindings (js-call children :slice 0 (get props :bindingCount)))
                           (lines (js-array))
                           (seen (new globalThis.Set))
                           (b-idx 0))
                       (while (< b-idx (js-length bindings))
                         (let ((binding (aref bindings b-idx)))
                           (when (or (/= (get binding :kind) "lexical-binding")
                                     (/= (js-length (get binding :children)) 1)
                                     (js-call seen :has (get binding :value)))
                             (fail binding "simple, initialized, distinct bindings required"))
                           (js-call seen :add (get binding :value))
                           (let ((init (emit-expression (aref (get binding :children) 0)
                                         (if (get props :sequential) inner scope)))
                                 (code (fresh)))
                             (js-call lines :push (str (get init :type) " " code " = " (get init :code) ";"))
                             (js-call inner :set (get binding :value) (js-object :type (get init :type) :code code))))
                         (setq b-idx (1+ b-idx)))
                       (js-call lines :push (emit-block (js-call children :slice (js-length bindings)) inner returning))
                       (str "{\n" (js-call lines :join "\n") "\n}")))
                    ((and (= kind "loop") (= value "while") (not returning))
                     (let ((condition (emit-expression (aref children 0) scope)))
                       (when (/= (get condition :type) "int")
                         (fail node "while requires a boolean; numeric truthiness is not C truthiness"))
                       (str "while (" (get condition :code) ") {\n"
                            (emit-block (js-call children :slice 1) scope false) "\n}")))
                    ((and (= kind "assignment") (not returning))
                     (js-call (js-call children :map (lambda (pair)
                                (let ((target (js-call scope :get (get pair :value))))
                                  (when (or (/= (get pair :kind) "assignment-pair") (not target))
                                    (fail pair "assignment requires a local binding"))
                                  (let ((rhs (emit-expression (aref (get pair :children) 0) scope)))
                                    (when (/= (get rhs :type) (get target :type))
                                      (fail pair "assignment changes scalar type"))
                                    (str (get target :code) " = " (get rhs :code) ";")))))
                       :join "\n"))
                    ((= kind "sequence")
                     (emit-block children scope returning))
                    (t
                     (let ((result (emit-expression node scope)))
                       (when (and returning (/= (get result :type) "double"))
                         (fail node "numeric function result required"))
                       (if returning
                         (str "return " (get result :code) ";")
                         (str "(void)" (get result :code) ";"))))))))
        (let ((body-nodes (get program :body)) (i 0))
          (while (< i (js-length body-nodes))
            (let ((node (aref body-nodes i)))
              (if (= (get node :kind) "export-declaration")
                (js-call (get node :children) :forEach (lambda (child)
                  (js-call exported :add (get child :value))))
                (progn
                  (when (or (/= (get node :kind) "function-declaration")
                            (get (or (get node :properties) (js-object)) :async))
                    (fail node "only synchronous numeric functions and exports are supported"))
                  (when (js-call functions :some (lambda (fn) (= (get fn :name) (get node :value))))
                    (fail node "duplicate function"))
                  (let* ((scope (new globalThis.Map))
                         (parameters (js-call (get node :children) :slice 0
                                       (get (or (get node :properties) (js-object)) :parameterCount)))
                         (p-idx 0))
                    (while (< p-idx (js-length parameters))
                      (let ((parameter (aref parameters p-idx)))
                        (when (or (/= (get parameter :kind) "parameter-binding")
                                  (/= (get (or (get parameter :properties) (js-object)) :parameterKind) "required")
                                  (js-call scope :has (get parameter :value)))
                          (fail parameter "distinct required numeric parameters only"))
                        (js-call scope :set (get parameter :value)
                          (js-object :type "double" :code (fresh))))
                      (setq p-idx (1+ p-idx)))
                    (let* ((symbol (str "eli_" (js-length functions)))
                           (args-text (js-call (js-call (Array/from (js-call scope :values))
                                                 :map (lambda (arg) (str "double " (get arg :code))))
                                        :join ", "))
                           (args (if (> (js-length args-text) 0) args-text "void"))
                           (body (emit-block (js-call (get node :children) :slice (js-length parameters)) scope t)))
                      (js-call functions :push (js-object
                        :name (get node :value)
                        :symbol symbol
                        :arity (js-length parameters)
                        :code (str "double " symbol "(" args ") {\n" body "\n}"))))))))
            (setq i (1+ i))))
        (when (= (js-length functions) 0)
          (throw (new globalThis.Error "no numeric functions")))
        (js-call (Array/from exported) :forEach (lambda (name)
          (unless (js-call functions :some (lambda (fn) (= (get fn :name) name)))
            (throw (new globalThis.Error (str "unknown export " name))))))
        (js-object
          :code (str "/* Generated from Eliscript IR; f64 subset, no fast-math/FMA. */\n"
                     (js-call (js-call functions :map (lambda (fn) (get fn :code))) :join "\n\n") "\n")
          :functions (js-call functions :map (lambda (fn)
                       (js-object :name (get fn :name) :symbol (get fn :symbol) :arity (get fn :arity))))))))

  (export emitNumericC))
