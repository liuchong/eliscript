(module tools.experiments.native-wasm.measure-js
  (import "node:fs" readFileSync)
  (import "node:url" pathToFileURL)
  (import "./cases.mjs" cases samples warmups)

  (defasync main ()
    (let* ((argv (js-call (get globalThis.process :argv) :slice 2))
           (mode (aref argv 0))
           (module-path (aref argv 1))
           (manifest-path (aref argv 2))
           (load-start (js-call globalThis.performance :now))
           (functions nil))
      (cond
        ((or (= mode "js") (= mode "baseline-js") (= mode "reference-js"))
         (setq functions (await (js* "import(pathToFileURL(module_path).href)"))))
        ((= mode "wasm")
         (let* ((manifest (JSON/parse (readFileSync manifest-path "utf8")))
                (bytes (readFileSync module-path))
                (module (new globalThis.WebAssembly.Module bytes))
                (instance (new globalThis.WebAssembly.Instance module))
                (exports (get instance :exports)))
           (setq functions (Object/fromEntries (js-call manifest :map (lambda (fn)
                             (js-array (js-call (get fn :name) :replaceAll "-" "_")
                                       (get exports (get fn :symbol)))))))))
        (t (throw (new globalThis.Error "expected js or wasm"))))
      (let* ((load-ms (- (js-call globalThis.performance :now) load-start))
             (versions (get globalThis.process :versions))
             (engine (if (get versions :bun)
                       (str "Bun " (get versions :bun))
                       (str "Node " (get globalThis.process :version))))
             (result (js-object :engine engine :mode mode :loadMs load-ms :cases (js-array)))
             (c-idx 0))
        (while (< c-idx (js-length cases))
          (let* ((test-case (aref cases c-idx))
                 (fn (get functions (js-call (get test-case :fn) :replaceAll "-" "_")))
                 (checksum (js-array))
                 (times (js-array))
                 (run-case (lambda ()
                   (let ((sum 0) (index 0) (calls (get test-case :calls))
                         (arg0 (aref (get test-case :args) 0))
                         (arg1 (aref (get test-case :args) 1)))
                     (while (< index calls)
                       (setq sum (+ sum (funcall fn arg0 (+ arg1 (* (bit-and index 7) 0.000000001)))))
                       (setq index (1+ index)))
                     sum)))
                 (index 0))
            (while (< index warmups)
              (funcall run-case)
              (setq index (1+ index)))
            (setq index 0)
            (while (< index samples)
              (let ((start (js-call globalThis.performance :now)))
                (js-call checksum :push (funcall run-case))
                (js-call times :push (- (js-call globalThis.performance :now) start)))
              (setq index (1+ index)))
            (js-call (get result :cases) :push
              (js-object :name (get test-case :name) :samplesMs times :checksum checksum)))
          (setq c-idx (1+ c-idx)))
        (js-call (get globalThis.process :stdout) :write (JSON/stringify result)))))

  (js-call (main) :catch (lambda (error)
    (js-call globalThis.console :error error)
    (put globalThis.process :exitCode 1))))
