(module tools.experiments.native-wasm.cases
  (defconst warmups 5)
  (defconst samples 9)
  (defconst cases
    (js-array
      (js-object :name "recurrence-batch" :fn "recurrence" :args (js-array 1000000 0.123) :calls 2)
      (js-object :name "escape-grid" :fn "escape-grid" :args (js-array 160 64) :calls 2)
      (js-object :name "recurrence-tiny-calls" :fn "recurrence" :args (js-array 1 0.123) :calls 2000000)))

  (defun summarize (values)
    (let ((sorted (js-call (Array/from values) :sort (lambda (a b) (- a b)))))
      (js-object
        :medianMs (aref sorted (Math/floor (/ (js-length sorted) 2)))
        :minMs (aref sorted 0)
        :maxMs (js-call sorted :at -1)
        :samplesMs values)))

  (export warmups samples cases summarize))
