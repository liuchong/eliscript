(module capsules.tools.experiments.native-wasm.reference-js
  (js* "// Diagnostic baseline: same scalar algorithms, written directly in JavaScript.\n// This separates current JS emission overhead from target-engine limitations.\nexport function recurrence(n, seed) {\n  let i = 0, x = seed, total = 0;\n  while (i < n) {\n    x = (3.8 * x) * (1 - x);\n    total = total + x;\n    i = i + 1;\n  }\n  return total;\n}\n\nexport function escape_grid(width, limit) {\n  let row = 0, total = 0;\n  while (row < width) {\n    let column = 0;\n    while (column < width) {\n      const cx = (column * 3) / width - 2;\n      const cy = (row * 2) / width - 1;\n      let x = 0, y = 0, steps = 0;\n      while (steps < limit && x * x + y * y < 4) {\n        const nextX = (x * x - y * y) + cx;\n        y = ((2 * x) * y) + cy;\n        x = nextX;\n        steps = steps + 1;\n      }\n      total = total + steps;\n      column = column + 1;\n    }\n    row = row + 1;\n  }\n  return total;\n}\n"))
