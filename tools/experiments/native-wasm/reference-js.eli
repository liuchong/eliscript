(module tools.experiments.native-wasm.reference-js
  ;; Diagnostic baseline: same scalar algorithms, written directly in Eliscript.
  ;; This separates current JS emission overhead from target-engine limitations.
  (defun recurrence (n seed)
    (let ((i 0) (x seed) (total 0))
      (while (< i n)
        (setq x (* (* 3.8 x) (- 1 x)))
        (setq total (+ total x))
        (setq i (+ i 1)))
      total))

  (defun escape-grid (width limit)
    (let ((row 0) (total 0))
      (while (< row width)
        (let ((column 0))
          (while (< column width)
            (let ((cx (- (/ (* column 3) width) 2))
                  (cy (- (/ (* row 2) width) 1))
                  (x 0) (y 0) (steps 0))
              (while (and (< steps limit) (< (+ (* x x) (* y y)) 4))
                (let ((next-x (+ (- (* x x) (* y y)) cx)))
                  (setq y (+ (* (* 2 x) y) cy))
                  (setq x next-x)
                  (setq steps (+ steps 1))))
              (setq total (+ total steps))
              (setq column (+ column 1)))))
        (setq row (+ row 1)))
      total))

  (export recurrence escape-grid))
