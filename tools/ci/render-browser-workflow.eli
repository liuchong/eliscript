(module tools.ci.render-browser-workflow
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve dirname join)
  (import "node:url" fileURLToPath)
  (import "../backends/build.mjs" root)
  (import "./render-workflow.mjs" renderToolchainSteps)
  (import "./render-browser-workflow-ground.mjs" :as ground)

  (defconst default-root root)
  (defconst BrowserCompatibilityError (get ground :BrowserCompatibilityError))

  (defun validateBrowserCompatibility (contract matrix)
    (let ((validated (js-call ground :validateBrowserCompatibility contract matrix)))
      (Object/assign (js-object) validated (js-object :jobs 1))))

  (defun renderBrowserWorkflow (contract matrix)
    (let* ((validated (validateBrowserCompatibility contract matrix))
           (core (get validated :core))
           (linux-system (or (js-call (get core :systems) :find
                               (lambda (system) (and (= (get system :id) "linux") (= (get system :architecture) "x64"))))
                             (aref (get core :systems) 0)))
           (versions (get core :emacsVersions))
           (latest-emacs (aref versions (1- (js-length versions))))
           (engines (get contract :browserEngines))
           (command (js-call (get contract :testCommand) :replace "bun test " "bun tools/testing/file-workers.mjs "))
           (deferred (= (get matrix :performanceAcceptance) "deferred"))
           (suffix (if deferred " (performance reacceptance deferred)" ""))
           (action (get contract :artifactAction))
           (engine-steps (js-call engines :map (lambda (engine index)
             (+ "      - name: Run complete backend differential suite (" engine ")" suffix "\n"
                (if (= index 0)
                  (+ "        id: " engine "\n")
                  "        if: \"!cancelled() && steps.chromium.outcome != 'skipped'\"\n")
                "        shell: bash\n"
                "        env:\n"
                "          ELISCRIPT_TEST_BROWSER: " engine "\n"
                "          DEBUG: pw:browser\n"
                (if deferred "          ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE: \"1\"\n" "")
                "          ELISCRIPT_TEST_FIXTURE_PRELOAD: \"1\"\n"
                "        run: |\n"
                "          set -o pipefail\n"
                "          mkdir -p \"$RUNNER_TEMP/eliscript-browser-ci/" engine "\"\n"
                "          " command " 2>&1 | tee \"$RUNNER_TEMP/eliscript-browser-ci/" engine "/tests.log\"\n")))))
      (+ "# Generated by tools/ci/render-browser-workflow.mjs; do not edit.\n"
         "name: Browser compatibility\n\n"
         "on:\n  workflow_dispatch:\n\n"
         "permissions:\n  contents: read\n\n"
         "concurrency:\n  group: browsers-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\n"
         "jobs:\n  browser:\n    name: ${{ matrix.name }}\n    runs-on: ${{ matrix.os }}\n"
         "    timeout-minutes: 90\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n"
         "          - name: " (get linux-system :id) "-browsers\n"
         "            os: " (get linux-system :runner) "\n"
         "            architecture: " (get linux-system :architecture) "\n"
         "            emacs: \"" latest-emacs "\"\n"
         "            emacsCommit: \"" (get (get (get matrix :emacsInstall) latest-emacs) :commit) "\"\n"
         "    steps:\n"
         (renderToolchainSteps matrix)
         "      - name: Install locked dependencies\n        run: bun install --frozen-lockfile\n"
         "      - name: Bootstrap maintained compiler and backend tools\n        run: make bootstrap-backends\n"
         "      - name: Install selected browsers\n        run: bun node_modules/playwright-core/cli.js install --with-deps chromium firefox webkit\n"
         (js-call engine-steps :join "")
         "      - name: Preserve browser test evidence\n        if: always()\n"
         "        uses: " (get action :repository) "@" (get action :revision) " # " (get action :label) "\n"
         "        with:\n          name: browser-${{ matrix.name }}-${{ github.sha }}\n"
         "          path: ${{ runner.temp }}/eliscript-browser-ci/\n          if-no-files-found: warn\n")))

  (defasync checkBrowserCompatibilityWorkflow (&rest arguments)
    (let* ((options (if (or (= (js-length arguments) 0) (undefined? (aref arguments 0)))
                       (js-object) (aref arguments 0)))
           (root (if (nullish? (get options :root)) default-root (get options :root)))
           (contract (if (nullish? (get options :contract))
                       (JSON/parse (await (readFile (join root "contracts/browser-compatibility.json") "utf8")))
                       (get options :contract)))
           (matrix (if (nullish? (get options :matrix))
                     (JSON/parse (await (readFile (join root "contracts/compatibility-matrix.json") "utf8")))
                     (get options :matrix)))
           (report (validateBrowserCompatibility contract matrix))
           (actual (if (nullish? (get options :workflowText))
                     (await (readFile (join root (get contract :workflow)) "utf8"))
                     (get options :workflowText))))
      (unless (= actual (renderBrowserWorkflow contract matrix))
        (throw (new BrowserCompatibilityError "browser workflow differs from its contracts; run the renderer with --write")))
      (js-object :workflow (get contract :workflow) :jobs (get report :jobs)
        :browserEngines (get contract :browserEngines))))

  (defasync main ()
    (try
      (let ((contract (JSON/parse (await (readFile (join default-root "contracts/browser-compatibility.json") "utf8"))))
            (matrix (JSON/parse (await (readFile (join default-root "contracts/compatibility-matrix.json") "utf8")))))
        (when (js-call (get globalThis.process :argv) :includes "--write")
          (await (writeFile (join default-root (get contract :workflow)) (renderBrowserWorkflow contract matrix))))
        (console/log (JSON/stringify (await (checkBrowserCompatibilityWorkflow)) nil 2)))
      (catch error
        (console/error (get error :message))
        (put globalThis.process :exitCode 1))))
  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and entry (= (resolve entry) (resolve default-root "tools/ci/render-browser-workflow.mjs"))) (main)))
  (export BrowserCompatibilityError validateBrowserCompatibility renderBrowserWorkflow checkBrowserCompatibilityWorkflow))
