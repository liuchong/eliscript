(module capsules.tools.ci.render-browser-workflow-legacy
  (js* "import { readFile, writeFile } from \"node:fs/promises\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport { renderToolchainSteps, validateCompatibilityMatrix } from \"./render-workflow.mjs\";\n\nconst defaultRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), \"../..\");\nconst contractPath = \"contracts/browser-compatibility.json\";\n\nexport class BrowserCompatibilityError extends Error {}\n\nexport function validateBrowserCompatibility(contract, matrix) {\n  const core = validateCompatibilityMatrix(matrix);\n  if (contract?.schemaVersion !== 1 || contract?.version !== 1 ||\n      contract?.format !== \"eliscript-browser-compatibility\" ||\n      contract?.workflow !== \".github/workflows/browser-compatibility.yml\") {\n    throw new BrowserCompatibilityError(\"invalid browser compatibility contract\");\n  }\n  if (JSON.stringify(contract.browserEngines) !== JSON.stringify([\"chromium\", \"firefox\", \"webkit\"])) {\n    throw new BrowserCompatibilityError(\"browserEngines must be chromium, firefox, webkit in that order\");\n  }\n  if (contract.testCommand !== \"bun test tests/direct-wasm-backend.test.mjs tests/wasm-managed-array-search.test.mjs tests/wasm-managed-array-construction.test.mjs tests/wasm-managed-object-properties.test.mjs tests/wasm-managed-exceptions-browser.test.mjs tests/wasm-managed-symbols.test.mjs\") {\n    throw new BrowserCompatibilityError(\"testCommand must run the complete direct WASM backend suite\");\n  }\n  const action = contract.artifactAction;\n  if (action?.repository !== \"actions/upload-artifact\" ||\n      !/^[0-9a-f]{40}$/.test(action?.revision ?? \"\") ||\n      !/^v\\d+(?:\\.\\d+){0,2}$/.test(action?.label ?? \"\")) {\n    throw new BrowserCompatibilityError(\"artifactAction must pin actions/upload-artifact to a full commit SHA\");\n  }\n  return { core, jobs: core.systems.length * contract.browserEngines.length };\n}\n\nexport function renderBrowserWorkflow(contract, matrix) {\n  const { core } = validateBrowserCompatibility(contract, matrix);\n  const rows = core.systems.flatMap(system => contract.browserEngines.map(browser =>\n    `          - name: ${system.id}-${browser}\\n` +\n    `            os: ${system.runner}\\n` +\n    `            architecture: ${system.architecture}\\n` +\n    `            emacs: \"${core.emacsVersions.at(-1)}\"\\n` +\n    `            browser: ${browser}`)).join(\"\\n\");\n  return `# Generated by tools/ci/render-browser-workflow.mjs; do not edit.\\n` +\n    `name: Browser compatibility\\n\\n` +\n    `on:\\n  push:\\n    branches: [master]\\n  pull_request:\\n  workflow_dispatch:\\n\\n` +\n    `permissions:\\n  contents: read\\n\\n` +\n    `concurrency:\\n  group: browsers-\\${{ github.workflow }}-\\${{ github.ref }}\\n  cancel-in-progress: true\\n\\n` +\n    `jobs:\\n  browser:\\n    name: \\${{ matrix.name }}\\n    runs-on: \\${{ matrix.os }}\\n` +\n    `    timeout-minutes: 10\\n    strategy:\\n      fail-fast: false\\n      matrix:\\n        include:\\n${rows}\\n` +\n    `    steps:\\n` + renderToolchainSteps(matrix) +\n    `      - name: Install locked dependencies\\n        run: bun install --frozen-lockfile\\n` +\n    `      - name: Install selected browser\\n        run: bun node_modules/playwright-core/cli.js install --with-deps \"\\${{ matrix.browser }}\"\\n` +\n    `      - name: Run complete backend differential suite${matrix.performanceAcceptance === \"deferred\" ? \" (performance reacceptance deferred)\" : \"\"}\\n        shell: bash\\n` +\n    `        env:\\n          ELISCRIPT_TEST_BROWSER: \\${{ matrix.browser }}\\n          DEBUG: pw:browser\\n` +\n    (matrix.performanceAcceptance === \"deferred\" ? `          ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE: \"1\"\\n` : \"\") +\n    `        run: |\\n          set -o pipefail\\n          mkdir -p \"$RUNNER_TEMP/eliscript-browser-ci\"\\n` +\n    `          ${contract.testCommand} 2>&1 | tee \"$RUNNER_TEMP/eliscript-browser-ci/tests.log\"\\n` +\n    `      - name: Preserve browser test evidence\\n        if: always()\\n` +\n    `        uses: ${contract.artifactAction.repository}@${contract.artifactAction.revision} # ${contract.artifactAction.label}\\n` +\n    `        with:\\n          name: browser-\\${{ matrix.name }}-\\${{ github.sha }}\\n` +\n    `          path: \\${{ runner.temp }}/eliscript-browser-ci/\\n          if-no-files-found: warn\\n`;\n}\n\nexport async function checkBrowserCompatibilityWorkflow(options = {}) {\n  const root = options.root ?? defaultRoot;\n  const contract = options.contract ?? JSON.parse(await readFile(path.join(root, contractPath), \"utf8\"));\n  const matrix = options.matrix ?? JSON.parse(await readFile(path.join(root, \"contracts/compatibility-matrix.json\"), \"utf8\"));\n  const { jobs } = validateBrowserCompatibility(contract, matrix);\n  const actual = options.workflowText ?? await readFile(path.join(root, contract.workflow), \"utf8\");\n  if (actual !== renderBrowserWorkflow(contract, matrix)) {\n    throw new BrowserCompatibilityError(\"browser workflow differs from its contracts; run the renderer with --write\");\n  }\n  return { workflow: contract.workflow, jobs, browserEngines: contract.browserEngines };\n}\n\nif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  try {\n    const contract = JSON.parse(await readFile(path.join(defaultRoot, contractPath), \"utf8\"));\n    const matrix = JSON.parse(await readFile(path.join(defaultRoot, \"contracts/compatibility-matrix.json\"), \"utf8\"));\n    if (process.argv.includes(\"--write\")) {\n      await writeFile(path.join(defaultRoot, contract.workflow), renderBrowserWorkflow(contract, matrix));\n    }\n    console.log(JSON.stringify(await checkBrowserCompatibilityWorkflow(), null, 2));\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\n"))
