(module tools.ci.check-release-ready
  (import "node:child_process" spawnSync)
  (import "node:path" resolve)
  (import "../backends/build.mjs" :as build)
  (defconst requiredReleaseChecks (Object/freeze (js-array
    "Compatibility" "Browser compatibility" "Compiler bootstrap and final outputs" "Pages")))
  (defun validateReleaseReadiness (revision runs)
    (unless (and (= (value-type revision) "string")
                 (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test revision)
                 (Array/isArray runs))
      (throw (new globalThis.TypeError "release readiness requires an exact commit and workflow runs")))
    (let ((failures (js-array)) (accepted (js-array)))
      (js-call requiredReleaseChecks :forEach (lambda (name)
        (let ((matching (js-call (js-call runs :filter (lambda (run)
                        (and (= (get run :headSha) revision) (= (get run :name) name))))
                        :sort (lambda (a b) (- (get b :databaseId) (get a :databaseId))))))
          (let ((latest (aref matching 0)))
            (if (and latest (= (get latest :status) "completed") (= (get latest :conclusion) "success"))
              (js-call accepted :push (js-object :name name :runId (get latest :databaseId)))
              (js-call failures :push (str name ": " (if latest
                (str (get latest :status) "/" (get latest :conclusion)) "missing"))))))))
      (when (> (js-length failures) 0)
        (throw (new globalThis.Error (str "npm publication blocked: required CI has not passed for " revision "\n"
          (js-call failures :join "\n")))))
      (js-object :revision revision :checks accepted)))
  (defun checked-json (command arguments root)
    (let ((result (spawnSync command arguments (js-object :cwd root :encoding "utf8" :timeout 30000 :maxBuffer 4194304))))
      (unless (= (get result :status) 0)
        (throw (new globalThis.Error "release readiness could not read authoritative GitHub CI state")))
      (JSON/parse (get result :stdout))))
  (defun main ()
    (let* ((root (get build :root))
           (git (spawnSync "git" (js-array "rev-parse" "HEAD") (js-object :cwd root :encoding "utf8" :timeout 10000))))
      (unless (= (get git :status) 0) (throw (new globalThis.Error "release commit cannot be resolved")))
      (let* ((revision (js-call (get git :stdout) :trim))
             (runs (checked-json "gh" (js-array "run" "list" "--commit" revision "--limit" "100" "--json"
               "databaseId,name,status,conclusion,headSha") root))
             (result (validateReleaseReadiness revision runs)))
        (console/log (JSON/stringify result)) result)))
  (when (= (resolve (or (aref (get globalThis.process :argv) 1) "."))
           (resolve (get build :root) "tools/ci/check-release-ready.mjs"))
    (try (main) (catch error (console/error (get error :message)) (put globalThis.process :exitCode 1))))
  (export requiredReleaseChecks validateReleaseReadiness main))
