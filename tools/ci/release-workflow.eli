(module tools.ci.release-workflow
  (import "node:fs/promises" readFile writeFile)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../../backends/build.mjs" root)
  (import "../render-workflow.mjs" renderToolchainSteps validateCompatibilityMatrix)

  (defconst release-workflow-path ".github/workflows/compiler-release.yml")
  (defconst release-artifact-action
    (get (JSON/parse (readFileSync (resolve root "contracts/browser-compatibility.json") "utf8")) :artifactAction))

  (defun renderCompilerReleaseWorkflow (matrix)
    (let* ((declared (get matrix :operatingSystems))
           (arm-platforms (if (Array/isArray declared)
             (js-call (js-call declared :filter (lambda (system) (= (get system :architecture) "arm64")))
               :map release-system-platform) (js-array))))
      (unless (and (js-call arm-platforms :includes "linux") (js-call arm-platforms :includes "macos"))
        (throw (new globalThis.TypeError "stage3 native acceptance requires ARM64 Linux and macOS platforms"))))
    (let* ((validated (validateCompatibilityMatrix matrix))
           (systems (js-call (get validated :systems) :filter
             (lambda (system) (= (get system :architecture) "arm64"))))
           (platforms (new globalThis.Set)) (rows (js-array)) (index 0)
           (versions (get validated :emacsVersions)))
      (while (< index (js-length systems))
        (let* ((system (aref systems index))
               (platform (release-system-platform system)))
          (js-call platforms :add platform)
          (js-call rows :push
            (+ "          - name: " (get system :id) "-stage3\n"
               "            os: " (get system :runner) "\n"
               "            architecture: arm64\n"
               "            emacs: \"" (aref versions (1- (js-length versions))) "\"\n"
               "            native_target: " (if (= platform "linux") "arm64-linux" "arm64-macos"))))
        (setq index (1+ index)))
      (unless (and (js-call platforms :has "linux") (js-call platforms :has "macos"))
        (throw (new globalThis.TypeError "stage3 native acceptance requires ARM64 Linux and macOS platforms")))
      (+ "# Generated by tools/ci/release-workflow.eli; do not edit.\n"
         "name: Compiler bootstrap and final outputs\n\n"
         "on:\n  push:\n    branches: [master, feat/managed-project-linking]\n  pull_request:\n  workflow_dispatch:\n\n"
         "permissions:\n  contents: read\n\n"
         "concurrency:\n  group: compiler-release-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\n"
         "jobs:\n  bootstrap:\n    name: ${{ matrix.name }}\n    runs-on: ${{ matrix.os }}\n"
         "    strategy:\n      fail-fast: false\n      matrix:\n        include:\n"
         (js-call rows :join "\n") "\n"
         "    env:\n      ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE: \"1\"\n"
         "      NATIVE_TARGET: ${{ matrix.native_target }}\n"
         "    steps:\n" (renderToolchainSteps matrix)
         "      - name: Install locked dependencies\n        run: bun install --frozen-lockfile\n"
         "      - name: Install browser engines for final compiler validation\n"
         "        run: bun node_modules/playwright-core/cli.js install --with-deps chromium firefox webkit\n"
         "      - name: Build the JS stages and verify final outputs\n"
         "        run: make compiler-release-ci\n"
         "      - name: Strict byte compilation\n        run: make byte-compile\n"
         "      - name: Preserve compiler acceptance evidence\n        if: always()\n"
         "        uses: " (get release-artifact-action :repository) "@" (get release-artifact-action :revision)
         " # " (get release-artifact-action :label) "\n"
         "        with:\n          name: compiler-release-${{ matrix.name }}-${{ github.sha }}\n"
         "          path: dist/bootstrap-release/\n          if-no-files-found: warn\n")))

  (defun release-system-platform (system)
    (if (undefined? (get system :operatingSystem)) (get system :id) (get system :operatingSystem)))

  (defasync main (arguments)
    (unless (js-call arguments :every (lambda (value) (or (= value "--check") (= value "--write"))))
      (throw (new globalThis.TypeError "Usage: compiler-release.mjs --write|--check")))
    (let* ((matrix (JSON/parse (await (readFile (resolve root "contracts/compatibility-matrix.json") "utf8"))))
           (expected (renderCompilerReleaseWorkflow matrix)) (path (resolve root release-workflow-path)))
      (when (js-call arguments :includes "--write") (await (writeFile path expected)))
      (unless (= (await (readFile path "utf8")) expected)
        (throw (new globalThis.Error "compiler release workflow differs from its Eli source")))
      (js-call (get globalThis.process :stdout) :write (+ release-workflow-path " unchanged\n"))))

  (when (and (aref (get globalThis.process :argv) 1)
             (= (resolve (aref (get globalThis.process :argv) 1)) (fileURLToPath (js* "import.meta.url"))))
    (js-call (main (js-call (get globalThis.process :argv) :slice 2)) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write (+ (get error :message) "\n"))
        (put globalThis.process :exitCode 1))))
  (export renderCompilerReleaseWorkflow main))
