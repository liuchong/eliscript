(module tools.ci.render-browser-workflow-ground
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)
  (import "./render-workflow.mjs" renderToolchainSteps validateCompatibilityMatrix)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst default-root (js-call path :resolve (js-call path :dirname module-file) "../.."))
  (defconst contract-path "contracts/browser-compatibility.json")
  (defconst matrix-path "contracts/compatibility-matrix.json")
  (defconst browser-engines (js-array "chromium" "firefox" "webkit"))
  (defconst direct-wasm-command
    "bun test tests/direct-wasm-backend.test.mjs tests/wasm-managed-array-search.test.mjs tests/wasm-managed-array-construction.test.mjs tests/wasm-managed-object-properties.test.mjs tests/wasm-managed-exceptions-browser.test.mjs tests/wasm-managed-symbols.test.mjs")
  (defconst revision-pattern "^[0-9a-f]{40}$")
  (defconst label-pattern "^v\\d+(?:\\.\\d+){0,2}$")

  (defconst BrowserCompatibilityError
    (js* "(class BrowserCompatibilityError extends Error {})"))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun regexp-test (pattern text)
    (js-call (new globalThis.RegExp pattern) :test text))

  (defun optional-text (value key)
    (if (nullish? value) "" (get value key "")))

  (defun validateBrowserCompatibility (contract matrix)
    (let ((core (validateCompatibilityMatrix matrix)))
      (unless (and (= (host-get contract "schemaVersion") 1)
                   (= (host-get contract "version") 1)
                   (= (host-get contract "format") "eliscript-browser-compatibility")
                   (= (host-get contract "workflow") ".github/workflows/browser-compatibility.yml"))
        (throw (new BrowserCompatibilityError "invalid browser compatibility contract")))
      (unless (= (JSON/stringify (host-get contract "browserEngines")) (JSON/stringify browser-engines))
        (throw (new BrowserCompatibilityError "browserEngines must be chromium, firefox, webkit in that order")))
      (unless (= (host-get contract "testCommand") direct-wasm-command)
        (throw (new BrowserCompatibilityError "testCommand must run the complete direct WASM backend suite")))
      (let ((action (host-get contract "artifactAction")))
        (unless (and (= (host-get action "repository") "actions/upload-artifact")
                     (regexp-test revision-pattern (optional-text action "revision"))
                     (regexp-test label-pattern (optional-text action "label")))
          (throw (new BrowserCompatibilityError "artifactAction must pin actions/upload-artifact to a full commit SHA")))
        (js-object :core core
          :jobs (* (js-length (get core :systems)) (js-length (get contract :browserEngines)))))))

  (defun last-item (values)
    (aref values (1- (js-length values))))

  (defun browser-rows (core engines)
    (let ((rows (js-array))
          (systems (get core :systems))
          (latest (last-item (get core :emacsVersions)))
          (system-index 0))
      (while (< system-index (js-length systems))
        (let ((system (aref systems system-index)) (engine-index 0))
          (while (< engine-index (js-length engines))
            (let ((browser (aref engines engine-index)))
              (js-call rows :push
                (str "          - name: " (get system :id) "-" browser "\n"
                     "            os: " (get system :runner) "\n"
                     "            architecture: " (get system :architecture) "\n"
                     "            emacs: \"" latest "\"\n"
                     "            browser: " browser)))
            (setq engine-index (1+ engine-index))))
        (setq system-index (1+ system-index)))
      (js-call rows :join "\n")))

  (defun renderBrowserWorkflow (contract matrix)
    (let* ((validated (validateBrowserCompatibility contract matrix))
           (core (get validated :core))
           (action (get contract :artifactAction))
           (deferred (= (get matrix :performanceAcceptance) "deferred"))
           (suffix (if deferred " (performance reacceptance deferred)" "")))
      (+ "# Generated by tools/ci/render-browser-workflow.mjs; do not edit.\n"
         "name: Browser compatibility\n\n"
         "on:\n  push:\n    branches: [master]\n  pull_request:\n  workflow_dispatch:\n\n"
         "permissions:\n  contents: read\n\n"
         "concurrency:\n  group: browsers-${{ github.workflow }}-${{ github.ref }}\n  cancel-in-progress: true\n\n"
         "jobs:\n  browser:\n    name: ${{ matrix.name }}\n    runs-on: ${{ matrix.os }}\n"
         "    timeout-minutes: 10\n    strategy:\n      fail-fast: false\n      matrix:\n        include:\n"
         (browser-rows core (get contract :browserEngines)) "\n"
         "    steps:\n"
         (renderToolchainSteps matrix)
         "      - name: Install locked dependencies\n        run: bun install --frozen-lockfile\n"
         "      - name: Install selected browser\n        run: bun node_modules/playwright-core/cli.js install --with-deps \"${{ matrix.browser }}\"\n"
         "      - name: Run complete backend differential suite" suffix "\n        shell: bash\n"
         "        env:\n          ELISCRIPT_TEST_BROWSER: ${{ matrix.browser }}\n          DEBUG: pw:browser\n"
         (if deferred "          ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE: \"1\"\n" "")
         "        run: |\n          set -o pipefail\n          mkdir -p \"$RUNNER_TEMP/eliscript-browser-ci\"\n"
         "          " (get contract :testCommand) " 2>&1 | tee \"$RUNNER_TEMP/eliscript-browser-ci/tests.log\"\n"
         "      - name: Preserve browser test evidence\n        if: always()\n"
         "        uses: " (get action :repository) "@" (get action :revision) " # " (get action :label) "\n"
         "        with:\n          name: browser-${{ matrix.name }}-${{ github.sha }}\n"
         "          path: ${{ runner.temp }}/eliscript-browser-ci/\n          if-no-files-found: warn\n")))

  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object)
      (aref supplied 0)))

  (defasync checkBrowserCompatibilityWorkflow (&rest supplied)
    (let* ((options (call-options supplied))
           (root (get options :root default-root))
           (contract (if (nullish? (get options :contract))
                       (JSON/parse (await (readFile (js-call path :join root contract-path) "utf8")))
                       (get options :contract)))
           (matrix (if (nullish? (get options :matrix))
                     (JSON/parse (await (readFile (js-call path :join root matrix-path) "utf8")))
                     (get options :matrix)))
           (jobs (get (validateBrowserCompatibility contract matrix) :jobs))
           (actual (if (nullish? (get options :workflowText))
                     (await (readFile (js-call path :join root (get contract :workflow)) "utf8"))
                     (get options :workflowText))))
      (unless (= actual (renderBrowserWorkflow contract matrix))
        (throw (new BrowserCompatibilityError "browser workflow differs from its contracts; run the renderer with --write")))
      (js-object :workflow (get contract :workflow) :jobs jobs :browserEngines (get contract :browserEngines))))

  (defasync main ()
    (try
      (let ((contract (JSON/parse (await (readFile (js-call path :join default-root contract-path) "utf8"))))
            (matrix (JSON/parse (await (readFile (js-call path :join default-root matrix-path) "utf8")))))
        (when (js-call (get globalThis.process :argv) :includes "--write")
          (await (writeFile (js-call path :join default-root (get contract :workflow))
                   (renderBrowserWorkflow contract matrix))))
        (console/log (JSON/stringify (await (checkBrowserCompatibilityWorkflow)) nil 2)))
      (catch error
        (console/error (get error :message))
        (put globalThis.process :exitCode 1))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (host-truthy entry)
               (= (js-call path :resolve entry) module-file))
      (main)))

  (export BrowserCompatibilityError validateBrowserCompatibility renderBrowserWorkflow
    checkBrowserCompatibilityWorkflow))
