(module tools.ci.render-workflow
  (import "node:fs/promises" readFile writeFile)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "../backends/build.mjs" root)
  (import "./render-workflow-ground.mjs" :as ground)
  (defconst COMPATIBILITY_FILE_SHARDS 1)
  (defconst compatibility-artifact-action
    (get (JSON/parse (readFileSync (resolve root "contracts/browser-compatibility.json") "utf8")) :artifactAction))
  (defconst CompatibilityMatrixError (get ground :CompatibilityMatrixError))
  (defconst renderToolchainSteps (get ground :renderToolchainSteps))
  (defconst humanCompatibilityReport (get ground :humanCompatibilityReport))
  (defasync read-matrix (directory)
    (JSON/parse (await (readFile (resolve directory "contracts/compatibility-matrix.json") "utf8"))))
  (defun compatibility-job-pairs (systems versions)
    (let ((latest (aref versions (1- (js-length versions))))
          (pairs (js-array)))
      (js-call systems :forEach (lambda (system)
        (let ((selected (if (= (get system :id) "linux") versions (js-array latest))))
          (js-call selected :forEach (lambda (version)
            (js-call pairs :push (js-object :system system :emacs version)))))))
      pairs))
  (defun validateCompatibilityMatrix (matrix)
    (let* ((validated (js-call ground :validateCompatibilityMatrix matrix))
           (pairs (compatibility-job-pairs (get validated :systems) (get validated :emacsVersions)))
           (acceptance-pairs (compatibility-job-pairs (get validated :acceptanceSystems) (get validated :emacsVersions))))
      (Object/assign (js-object) validated (js-object :testFileShards COMPATIBILITY_FILE_SHARDS
        :jobs (js-length pairs)
        :acceptanceJobs (js-length acceptance-pairs)))))
  (defun renderWorkflow (matrix)
    (let* ((validated (validateCompatibilityMatrix matrix)) (original (js-call ground :renderWorkflow matrix))
           (marker "        include:\n") (start (+ (js-call original :indexOf marker) (js-length marker)))
           (end (js-call original :indexOf "    steps:\n" start)) (rows (js-array))
           (pairs (compatibility-job-pairs (get validated :systems) (get validated :emacsVersions))))
      (unless (and (>= (js-call original :indexOf marker) 0) (> end start))
        (throw (new CompatibilityMatrixError (js-array "workflow matrix boundaries are missing"))))
      (js-call pairs :forEach (lambda (pair)
        (let ((system (get pair :system)) (version (get pair :emacs)))
          (js-call rows :push (str "          - name: " (get system :id) "-emacs-" version
            "\n            os: " (get system :runner) "\n            architecture: " (get system :architecture)
            "\n            emacs: \"" version "\"")))))
      (let ((text (str (js-call original :slice 0 start) (js-call rows :join "\n") "\n" (js-call original :slice end))))
        (setq text (js-call (js-call (js-call (js-call (js-call text
          :replace "on:\n  push:\n    branches: [master]\n  pull_request:\n  workflow_dispatch:\n\n"
          "on:\n  workflow_dispatch:\n\n")
          :replace "      BUN_TEST_RUNNER: tools/testing/file-workers.mjs --shard-index ${{ matrix.shard }} --shard-count 2\n"
          "      BUN_TEST_RUNNER: tools/testing/file-workers.mjs\n")
          :replace "Run test file shard ${{ matrix.shard }}/2" "Run test file shard 1/1")
          :replace "        run: bun run test\n" "        id: test-suite\n        run: bun run test\n")
          :replace "      - name: Strict byte compilation\n        run: make byte-compile\n"
          (+ "      - name: Strict byte compilation\n"
             "        if: \"!cancelled() && steps.test-suite.outcome != 'skipped'\"\n"
             "        run: make byte-compile\n"
             "      - name: Preserve compatibility test evidence\n"
             "        if: always()\n"
             "        uses: " (get compatibility-artifact-action :repository) "@" (get compatibility-artifact-action :revision)
             " # " (get compatibility-artifact-action :label) "\n"
             "        with:\n"
             "          name: compatibility-${{ matrix.name }}-${{ github.sha }}\n"
             "          path: .eliscript-cache/test-results/\n"
             "          if-no-files-found: warn\n")))
        ;; Capacity deferral is an existing explicit release mode. Its normal
        ;; functional heap must be selected too; one flag alone remains strict.
        (if (= (get matrix :performanceAcceptance) "deferred")
          (let ((functional (js-call text :replace "      ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE: \"1\"\n"
            "      ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE: \"1\"\n      ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE: \"small\"\n")))
            ;; One native AVL case takes14 minutes locally, before its wire
            ;; share and other files. Do not repeat a provably undersized CI
            ;; job. This changes scheduling only; strict tests keep30 minutes.
            (js-call functional :replace "timeout-minutes: 30"
              "timeout-minutes: 240"))
          text))))
  (defasync checkCompatibilityWorkflow (&rest supplied)
    (let* ((options (if (= (js-length supplied) 0) (js-object) (aref supplied 0)))
           (directory (get options :root root))
           (matrix (if (nullish? (get options :matrix)) (await (read-matrix directory)) (get options :matrix)))
           (validated (validateCompatibilityMatrix matrix))
           (actual (if (nullish? (get options :workflowText))
             (await (readFile (resolve directory (get validated :workflow)) "utf8")) (get options :workflowText))))
      (unless (= actual (renderWorkflow matrix))
        (throw (new CompatibilityMatrixError (js-array
          (str (get validated :workflow) " differs from the compatibility matrix; run the renderer with --write")))))
      (js-object :schemaVersion 1
        :systems (js-call (get validated :systems) :map (lambda (system) (js-object :id (get system :id)
          :architecture (get system :architecture) :runner (get system :runner)
          :operatingSystem (get system :operatingSystem (get system :id)))))
        :acceptanceSystems (js-call (get validated :acceptanceSystems) :map (lambda (system)
          (js-object :id (get system :id) :architecture (get system :architecture) :runner (get system :runner))))
        :emacsVersions (get validated :emacsVersions) :javascriptHost (get validated :javascriptHost)
        :nodeHost (get (get validated :localEvidence) :nodeHost)
        :localEvidenceDirectory (get (get validated :localEvidence) :directory)
        :testFileShards COMPATIBILITY_FILE_SHARDS :jobs (get validated :jobs)
        :acceptanceJobs (get validated :acceptanceJobs) :workflow (get validated :workflow))))
  (defasync main (arguments)
    (let ((matrix (await (read-matrix root))))
      (when (js-call arguments :includes "--write") (await (writeFile (resolve root (get matrix :workflow)) (renderWorkflow matrix))))
      (let ((report (await (checkCompatibilityWorkflow))))
        (console/log (if (js-call arguments :includes "--json") (JSON/stringify report nil 2) (humanCompatibilityReport report))))))
  (when (= (resolve (or (aref (get globalThis.process :argv) 1) ".")) (resolve root "tools/ci/render-workflow.mjs"))
    (js-call (main (js-call (get globalThis.process :argv) :slice 2)) :catch (lambda (error)
      (console/error (get error :message)) (put globalThis.process :exitCode 1))))
  (export COMPATIBILITY_FILE_SHARDS CompatibilityMatrixError validateCompatibilityMatrix renderToolchainSteps
    renderWorkflow checkCompatibilityWorkflow humanCompatibilityReport))
