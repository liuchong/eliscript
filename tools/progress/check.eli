(module tools.progress.check
  (import "node:fs/promises" readFile)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst DEFAULT_ROOT (js-call path :resolve (js-call path :dirname module-file) "../.."))
  (defconst unit-statuses (new globalThis.Set (js-array "complete" "partial" "open" "blocked")))
  (defconst milestone-unit-counts
    (new globalThis.Map
      (js-array (js-array "M7" 6) (js-array "M8" 7) (js-array "M9" 6) (js-array "M10" 6)
        (js-array "M11" 6) (js-array "M12" 6) (js-array "M13" 5))))
  (defconst expected-milestones (Array/from (js-call milestone-unit-counts :keys)))
  (defconst expected-criteria
    (let ((values (js-array)) (index 1))
      (while (<= index 24)
        (js-call values :push (str "AC-" (js-call (funcall globalThis.String index) :padStart 2 "0")))
        (setq index (1+ index)))
      (setq index 1)
      (while (<= index 11)
        (js-call values :push (str "PD-" (js-call (funcall globalThis.String index) :padStart 2 "0")))
        (setq index (1+ index)))
      values))
  (defconst expected-application-criteria (js-array "AV-01" "AV-02"))
  (defconst expected-application-features
    (js-array "publishing.org-adapter" "tooling.vite-adapter"))

  (defun progress-error-message (errors)
    (str "Maturity progress validation failed:\n"
         (js-call (js-call errors :map (lambda (error) (str "- " error))) :join "\n")))

  (defun progress-error-fields (self errors)
    (put self :name "MaturityProgressValidationError")
    (put self :errors errors)
    self)

  (defconst MaturityProgressValidationError
    (funcall
      (js* "(message, fields) => class MaturityProgressValidationError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      progress-error-message
      progress-error-fields))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun plain-object? (value)
    (and (not (nil? value))
         (= (host-type value) "object")
         (not (Array/isArray value))))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object)
      (aref supplied 0)))

  (defun json-equal (left right)
    (= (JSON/stringify left) (JSON/stringify right)))

  (defun nonempty-text? (value)
    (and (= (host-type value) "string") (> (js-length value) 0)))

  (defun percentage (completed total)
    (/ (js-call globalThis.Math :round (* (/ completed total) 1000)) 10))

  (defun progress-record (completed total fields)
    (let* ((completed-percent (percentage completed total))
           (record (js-object :completed completed :total total :completedPercent completed-percent
                     :remaining (- total completed)
                     :remainingPercent (/ (js-call globalThis.Math :round (* (- 100 completed-percent) 10)) 10))))
      (Object/assign record (if (nullish? fields) (js-object) fields))))

  (defun some-bad-text (values)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length values)))
        (unless (nonempty-text? (aref values index))
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun validate-string-array (values label errors)
    (if (or (not (Array/isArray values)) (some-bad-text values))
      (progn
        (js-call errors :push (str label " must be an array of non-empty strings"))
        (js-array))
      (let ((sorted (js-call (Array/from (new globalThis.Set values)) :sort)))
        (unless (json-equal values sorted)
          (js-call errors :push (str label " must be unique and lexicographically sorted")))
        values)))

  (defun validate-feature-evidence (unit label feature-ids application-features errors)
    (let ((features (if (undefined? (get unit :features))
                      (js-array)
                      (validate-string-array (get unit :features) (str label " features") errors)))
          (index 0))
      (while (< index (js-length features))
        (let ((feature (aref features index)))
          (unless (js-call feature-ids :has feature)
            (js-call errors :push (str label " references unknown conformance feature " feature)))
          (when (js-call application-features :has feature)
            (js-call errors :push (str label " uses excluded application feature " feature))))
        (setq index (1+ index)))
      (when (and (or (= (get unit :status) "complete") (= (get unit :status) "partial"))
                 (= (js-length features) 0))
        (js-call errors :push (str label " " (get unit :status) " status requires core feature evidence")))))

  (defun validate-unit (unit expected-id label feature-ids application-features errors &rest rest)
    (let ((requires-title (if (= (js-length rest) 0) t (aref rest 0))))
      (if (not (plain-object? unit))
        (js-call errors :push (str label " must be an object"))
        (progn
          (unless (= (get unit :id) expected-id)
            (js-call errors :push (str label " id must be " expected-id ", received " (JSON/stringify (get unit :id)))))
          (when (and requires-title (not (nonempty-text? (get unit :title))))
            (js-call errors :push (str label " must have a title")))
          (if (not (js-call unit-statuses :has (get unit :status)))
            (js-call errors :push (str label " has invalid status " (JSON/stringify (get unit :status))))
            (progn
              (validate-feature-evidence unit label feature-ids application-features errors)
              (when (and (not (= (get unit :status) "complete"))
                         (not (nonempty-text? (get unit :remaining))))
                (js-call errors :push (str label " " (get unit :status) " status requires remaining work")))
              (when (and (= (get unit :status) "blocked")
                         (not (nonempty-text? (get unit :blocker))))
                (js-call errors :push (str label " blocked status requires a blocker")))))))))

  (defun validate-milestones (milestones feature-ids application-features errors)
    (if (not (Array/isArray milestones))
      (progn
        (js-call errors :push "implementation milestones must be an array")
        (js-object :completed 0 :total 42 :milestones (js-object) :incomplete (js-array) :blocked (js-array)))
      (let ((actual-ids (js-array)) (index 0))
        (while (< index (js-length milestones))
          (js-call actual-ids :push (host-get (aref milestones index) "id"))
          (setq index (1+ index)))
        (unless (json-equal actual-ids expected-milestones)
          (js-call errors :push (str "implementation milestones must be exactly " (js-call expected-milestones :join ", "))))
        (let ((completed 0) (total 0) (report (js-object)) (incomplete (js-array)) (blocked (js-array))
              (milestone-index 0))
          (while (< milestone-index (js-length expected-milestones))
            (let* ((expected-milestone (aref expected-milestones milestone-index))
                   (milestone (aref milestones milestone-index))
                   (expected-count (js-call milestone-unit-counts :get expected-milestone))
                   (units-value (host-get milestone "units"))
                   (units (if (Array/isArray units-value) units-value (js-array)))
                   (milestone-completed 0)
                   (unit-index 0))
              (unless (plain-object? milestone)
                (js-call errors :push (str "milestone " expected-milestone " must be an object")))
              (unless (= (js-length units) expected-count)
                (js-call errors :push (str "milestone " expected-milestone " must contain " expected-count " units")))
              (while (< unit-index expected-count)
                (let* ((expected-id (str expected-milestone "-"
                                         (js-call (funcall globalThis.String (1+ unit-index)) :padStart 2 "0")))
                       (unit (aref units unit-index)))
                  (validate-unit unit expected-id (str "implementation unit " expected-id)
                    feature-ids application-features errors)
                  (if (= (host-get unit "status") "complete")
                    (progn
                      (setq completed (1+ completed))
                      (setq milestone-completed (1+ milestone-completed)))
                    (progn
                      (js-call incomplete :push expected-id)
                      (when (= (host-get unit "status") "blocked")
                        (js-call blocked :push expected-id)))))
                (setq unit-index (1+ unit-index)))
              (setq total (+ total expected-count))
              (put report expected-milestone (progress-record milestone-completed expected-count nil)))
            (setq milestone-index (1+ milestone-index)))
          (js-object :completed completed :total total :milestones report :incomplete incomplete :blocked blocked)))))

  (defun validate-criteria (criteria feature-ids application-features errors)
    (if (not (Array/isArray criteria))
      (progn
        (js-call errors :push "verification criteria must be an array")
        (js-object :completed 0 :total (js-length expected-criteria) :incomplete (js-array) :blocked (js-array)))
      (let ((actual-ids (js-array)) (index 0))
        (while (< index (js-length criteria))
          (js-call actual-ids :push (host-get (aref criteria index) "id"))
          (setq index (1+ index)))
        (unless (json-equal actual-ids expected-criteria)
          (js-call errors :push "verification criteria must be exactly AC-01..AC-24 then PD-01..PD-11"))
        (let ((completed 0) (incomplete (js-array)) (blocked (js-array)) (criterion-index 0))
          (while (< criterion-index (js-length expected-criteria))
            (let* ((expected-id (aref expected-criteria criterion-index))
                   (criterion (aref criteria criterion-index))
                   (expected-spec (if (js-call expected-id :startsWith "AC-") "0040" "0041")))
              (validate-unit criterion expected-id (str "verification criterion " expected-id)
                feature-ids application-features errors nil)
              (unless (= (host-get criterion "sourceSpec") expected-spec)
                (js-call errors :push (str "verification criterion " expected-id " sourceSpec must be " expected-spec)))
              (if (= (host-get criterion "status") "complete")
                (setq completed (1+ completed))
                (progn
                  (js-call incomplete :push expected-id)
                  (when (= (host-get criterion "status") "blocked")
                    (js-call blocked :push expected-id)))))
            (setq criterion-index (1+ criterion-index)))
          (js-object :completed completed :total (js-length expected-criteria)
            :incomplete incomplete :blocked blocked)))))

  (defasync read-json (filename)
    (JSON/parse (await (readFile filename "utf8"))))

  (defasync checkMaturityProgress (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract))
                       (await (read-json (js-call path :join root "contracts/maturity-progress.json")))
                       (get options :contract)))
           (manifest (if (nullish? (get options :manifest))
                        (await (read-json (js-call path :join root "tests/conformance/manifest.json")))
                        (get options :manifest)))
           (errors (js-array)))
      (when (or (not (plain-object? contract))
                (not (= (get contract :schemaVersion) 1))
                (not (= (get contract :format) "eliscript-maturity-progress"))
                (not (= (get contract :version) 1)))
        (js-call errors :push "maturity progress contract must use eliscript-maturity-progress version 1"))
      (let* ((manifest-features (let ((features (host-get manifest "features")))
                                  (if (Array/isArray features) features (js-array))))
             (feature-ids (new globalThis.Set
                            (js-call manifest-features :map (lambda (feature) (get feature :id)))))
             (excluded-feature-ids (validate-string-array
                                     (host-get (host-get contract "stabilization") "excludedFeatureIds")
                                     "stabilization excludedFeatureIds" errors)))
        (unless (json-equal excluded-feature-ids expected-application-features)
          (js-call errors :push
            (str "application feature exclusions must be exactly "
                 (js-call expected-application-features :join ", "))))
        (let ((feature-index 0))
          (while (< feature-index (js-length excluded-feature-ids))
            (let ((feature (aref excluded-feature-ids feature-index)))
              (unless (js-call feature-ids :has feature)
                (js-call errors :push (str "excluded application feature " feature " is absent from conformance manifest"))))
            (setq feature-index (1+ feature-index))))
        (unless (= (host-get (host-get contract "applications") "contributesToCore") false)
          (js-call errors :push "application validation must contribute zero to core progress"))
        (let* ((excluded-criteria (validate-string-array
                                    (host-get (host-get contract "applications") "excludedCriteria")
                                    "application excludedCriteria" errors))
               (application-features (new globalThis.Set excluded-feature-ids)))
          (unless (json-equal excluded-criteria expected-application-criteria)
            (js-call errors :push
              (str "application criteria exclusions must be exactly "
                   (js-call expected-application-criteria :join ", "))))
          (let* ((implementation (validate-milestones
                                   (host-get (host-get contract "implementation") "milestones")
                                   feature-ids application-features errors))
                 (verification (validate-criteria
                                 (host-get (host-get contract "verification") "criteria")
                                 feature-ids application-features errors))
                 (core-features (js-call manifest-features :filter
                                  (lambda (feature)
                                    (not (js-call application-features :has (get feature :id))))))
                 (stable-features (js-call core-features :filter
                                    (lambda (feature) (= (get feature :status) "stable")))))
          (when (> (js-length errors) 0)
            (throw (new MaturityProgressValidationError errors)))
          (js-object :schemaVersion 1 :format "eliscript-maturity-progress-report" :version 1
            :implementation (progress-record (get implementation :completed) (get implementation :total)
                              (js-object :milestones (get implementation :milestones)
                                :incomplete (get implementation :incomplete)
                                :blocked (get implementation :blocked)))
            :verification (progress-record (get verification :completed) (get verification :total)
                            (js-object :incomplete (get verification :incomplete)
                              :blocked (get verification :blocked)))
            :stabilization (progress-record (js-length stable-features) (js-length core-features)
                             (js-object :provisional (- (js-length core-features) (js-length stable-features))
                               :excludedFeatureIds excluded-feature-ids))
            :applications (js-object :contributesToCore false
                            :excludedCriteria excluded-criteria
                            :excludedFeatureIds excluded-feature-ids)))))))

  (defun joined-or-none (values)
    (let ((text (js-call values :join ", ")))
      (if (host-truthy text) text "none")))

  (defun human-line (label progress)
    (str label ": " (get progress :completed) "/" (get progress :total)
         " (" (get progress :completedPercent) "% complete, "
         (get progress :remainingPercent) "% remaining)"))

  (defun humanReport (report)
    (js-call (js-array
               "Eliscript core maturity progress"
               (human-line "Implementation" (get report :implementation))
               (human-line "Verification" (get report :verification))
               (human-line "Stabilization" (get report :stabilization))
               (str "Incomplete implementation units: " (joined-or-none (get (get report :implementation) :incomplete)))
               (str "Incomplete verification criteria: " (joined-or-none (get (get report :verification) :incomplete)))
               (str "Blocked units: "
                    (joined-or-none (js-call (js-array) :concat
                                      (get (get report :implementation) :blocked)
                                      (get (get report :verification) :blocked))))
               (str "Application validation excluded: " (js-call (get (get report :applications) :excludedCriteria) :join ", ")))
      :join "\n"))

  (defasync main ()
    (let ((unknown (js-call (js-call (get globalThis.process :argv) :slice 2) :filter
                     (lambda (argument) (not (= argument "--json"))))))
      (if (> (js-length unknown) 0)
        (progn
          (console/error (str "Unknown argument: " (aref unknown 0)))
          (put globalThis.process :exitCode 2))
        (try
          (let ((report (await (checkMaturityProgress))))
            (console/log (if (js-call (get globalThis.process :argv) :includes "--json")
                           (JSON/stringify report)
                           (humanReport report))))
          (catch error
            (console/error (get error :message))
            (put globalThis.process :exitCode 1))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (host-truthy entry) (= (js-call path :resolve entry) module-file))
      (main)))

  (export DEFAULT_ROOT MaturityProgressValidationError checkMaturityProgress humanReport))
