(module capsules.tools.performance.version-comparison
  (js* "import { mkdtemp, readFile, rm, stat, symlink, writeFile, mkdir } from \"node:fs/promises\";\nimport os from \"node:os\";\nimport path from \"node:path\";\nimport process from \"node:process\";\nimport { fileURLToPath, pathToFileURL } from \"node:url\";\n\nexport const VERSION_COMPARISON_FORMAT = \"eliscript-version-comparison-benchmark\";\nexport const VERSION_COMPARISON_VERSION = 1;\n\nexport const VERSION_COMPARISON_DIMENSIONS = Object.freeze([\n  \"emacsLisp\",\n  \"previousMajor\",\n  \"previousMinor\",\n  \"latest\",\n]);\n\nexport const VERSION_COMPARISON_WORKLOADS = Object.freeze([\n  Object.freeze({\n    id: \"sequence.first10k\",\n    label: \"first(Vector, N=10,000)\",\n    category: \"sequence\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"sequence.last10k\",\n    label: \"last(Vector, N=10,000)\",\n    category: \"sequence\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"sequence.takeLast10k\",\n    label: \"take-last(64, N=10,000)\",\n    category: \"sequence\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"value.equalSameRef10k\",\n    label: \"[VALUE_EQUAL] / compare(sameVec, N=10,000)\",\n    category: \"equality\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"order.sort10k\",\n    label: \"sort(Vector, N=10,000)\",\n    category: \"ordering\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"data.groupBy10k\",\n    label: \"group-by(x % 100, N=10,000)\",\n    category: \"aggregation\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"data.frequencies100k\",\n    label: \"frequencies(1,000 keys, N=100,000)\",\n    category: \"aggregation\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"tree.zipper12k\",\n    label: \"12,000-depth Zipper (down*12k + path + replace + root)\",\n    category: \"tree\",\n    unit: \"ms\",\n  }),\n  Object.freeze({\n    id: \"worker.scoreValues\",\n    label: \"score-values(N=10,000 x 10 rounds)\",\n    category: \"numeric\",\n    unit: \"ms\",\n  }),\n]);\n\nconst toolPath = fileURLToPath(import.meta.url);\nconst projectDirectory = path.resolve(path.dirname(toolPath), \"../..\");\n\nexport function parseSemver(input) {\n  if (typeof input !== \"string\") return null;\n  const trimmed = input.trim();\n  const match = /^v?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$/u.exec(trimmed);\n  if (!match) return null;\n  const major = Number(match[1]);\n  const minor = Number(match[2]);\n  const patch = Number(match[3]);\n  const version = `${major}.${minor}.${patch}`;\n  return {\n    major,\n    minor,\n    patch,\n    version,\n    tag: `v${version}`,\n  };\n}\n\nexport function compareSemver(left, right) {\n  if (left.major !== right.major) return left.major - right.major;\n  if (left.minor !== right.minor) return left.minor - right.minor;\n  return left.patch - right.patch;\n}\n\nexport function resolveVersionComparisonMatrix({\n  currentVersion,\n  releasedTags = [],\n  emacsVersion = \"unknown\",\n} = {}) {\n  const current = parseSemver(currentVersion);\n  if (!current) {\n    throw new TypeError(`invalid current semantic version: ${String(currentVersion)}`);\n  }\n  const parsedReleases = [];\n  const seenVersions = new Set();\n  for (const rawTag of releasedTags) {\n    const parsed = parseSemver(rawTag);\n    if (!parsed || seenVersions.has(parsed.version)) continue;\n    seenVersions.add(parsed.version);\n    parsedReleases.push({\n      ...parsed,\n      tag: typeof rawTag === \"string\" && rawTag.startsWith(\"v\") ? rawTag : parsed.tag,\n    });\n  }\n  parsedReleases.sort(compareSemver);\n\n  const priorReleases = parsedReleases.filter((entry) => compareSemver(entry, current) < 0);\n  const priorMajorReleases = priorReleases.filter((entry) => entry.major < current.major);\n\n  const bestMinor = priorReleases.at(-1) ?? null;\n  const bestMajor = priorMajorReleases.at(-1) ?? null;\n  const sameMajorAndMinor = Boolean(\n    bestMajor && bestMinor && bestMajor.version === bestMinor.version,\n  );\n\n  const emacsDimension = Object.freeze({\n    id: \"emacsLisp\",\n    label: \"Emacs Lisp\",\n    status: \"active\",\n    version: String(emacsVersion),\n    tag: null,\n    mode: \"current-latest-only\",\n    reason: \"current-host-emacs\",\n  });\n\n  const previousMajorDimension = bestMajor\n    ? Object.freeze({\n        id: \"previousMajor\",\n        label: \"上一个大版本\",\n        status: \"active\",\n        version: bestMajor.version,\n        tag: bestMajor.tag,\n        reason: sameMajorAndMinor ? \"same-as-previous-minor\" : \"resolved\",\n        sameAsPreviousMinor: sameMajorAndMinor,\n      })\n    : Object.freeze({\n        id: \"previousMajor\",\n        label: \"上一个大版本\",\n        status: \"absent\",\n        version: null,\n        tag: null,\n        reason: \"no-prior-major-release\",\n        sameAsPreviousMinor: false,\n      });\n\n  const previousMinorDimension = bestMinor\n    ? Object.freeze({\n        id: \"previousMinor\",\n        label: \"上一个最近的小版本\",\n        status: \"active\",\n        version: bestMinor.version,\n        tag: bestMinor.tag,\n        reason: \"resolved\",\n        sameAsPreviousMajor: sameMajorAndMinor,\n      })\n    : Object.freeze({\n        id: \"previousMinor\",\n        label: \"上一个最近的小版本\",\n        status: \"absent\",\n        version: null,\n        tag: null,\n        reason: \"initial-release\",\n        sameAsPreviousMajor: false,\n      });\n\n  const latestDimension = Object.freeze({\n    id: \"latest\",\n    label: \"最新版\",\n    status: \"active\",\n    version: current.version,\n    tag: current.tag,\n    reason: \"current-workspace\",\n  });\n\n  return Object.freeze({\n    emacsLisp: emacsDimension,\n    previousMajor: previousMajorDimension,\n    previousMinor: previousMinorDimension,\n    latest: latestDimension,\n  });\n}\n\nasync function capture(command, options = {}) {\n  const child = Bun.spawn(command, {\n    cwd: projectDirectory,\n    stdout: \"pipe\",\n    stderr: \"pipe\",\n    ...options,\n  });\n  const [exitCode, stdout, stderr] = await Promise.all([\n    child.exited,\n    new Response(child.stdout).text(),\n    new Response(child.stderr).text(),\n  ]);\n  if (exitCode !== 0) {\n    throw new Error(\n      stderr.trim() || stdout.trim() || `${command[0]} exited with ${exitCode}`,\n    );\n  }\n  return { stdout, stderr };\n}\n\nexport async function discoverReleasedTags(root = projectDirectory) {\n  const result = await capture([\"git\", \"tag\", \"--list\", \"v*\"], { cwd: root });\n  return result.stdout\n    .split(/\\r?\\n/u)\n    .map((line) => line.trim())\n    .filter((line) => parseSemver(line) !== null);\n}\n\nexport async function detectEmacsVersion() {\n  const result = await capture([\n    process.env.EMACS ?? \"emacs\",\n    \"--batch\",\n    \"-Q\",\n    \"--eval\",\n    \"(princ emacs-version)\",\n  ]);\n  return result.stdout.trim();\n}\n\nexport async function defaultMeasureEmacsLisp() {\n  const elispScript = [\n    \"(progn\",\n    \"  (require (quote json))\",\n    \"  (require (quote cl-lib))\",\n    \"  (defun ms-since (t0) (* 1000.0 (- (float-time) t0)))\",\n    \"  (defun bench-el (iters fn)\",\n    \"    (funcall fn)\",\n    \"    (garbage-collect)\",\n    \"    (let ((t0 (float-time)))\",\n    \"      (dotimes (_ iters) (funcall fn))\",\n    \"      (/ (ms-since t0) (float iters))))\",\n    \"  (let* ((n 10000)\",\n    \"         (lst (number-sequence 0 (1- n)))\",\n    \"         (vec (vconcat lst))\",\n    \"         (shuffled-lst (mapcar (lambda (i) (% (* i 7919) n)) lst))\",\n    \"         (mod-100k (let (r) (dotimes (i 100000) (push (% i 1000) r)) (nreverse r)))\",\n    \"         (t-first (bench-el 20000 (lambda () (aref vec 0))))\",\n    \"         (t-last (bench-el 200 (lambda () (car (last lst)))))\",\n    \"         (t-take-last (bench-el 200 (lambda () (last lst 64))))\",\n    \"         (vec-copy (copy-sequence vec))\",\n    \"         (t-equal (bench-el 1000 (lambda () (equal vec vec-copy))))\",\n    \"         (t-sort (bench-el 30 (lambda () (vconcat (sort (copy-sequence shuffled-lst) (function <))))))\",\n    \"         (t-group-by (bench-el 30 (lambda ()\",\n    \"                                    (let ((ht (make-hash-table :test (quote eql))))\",\n    \"                                      (dolist (x lst)\",\n    \"                                        (let ((k (% x 100)))\",\n    \"                                          (puthash k (cons x (gethash k ht)) ht)))\",\n    \"                                      ht))))\",\n    \"         (t-freq-100k (bench-el 7 (lambda ()\",\n    \"                                    (let ((ht (make-hash-table :test (quote eql))))\",\n    \"                                      (dolist (x mod-100k)\",\n    \"                                        (puthash x (1+ (gethash x ht 0)) ht))\",\n    \"                                      ht))))\",\n    \"         (score-vec (let ((v (make-vector 10000 0))) (dotimes (i 10000) (aset v i (% i 997))) v))\",\n    \"         (t-score (bench-el 7 (lambda ()\",\n    \"                                (let ((total 0))\",\n    \"                                  (dotimes (round 10)\",\n    \"                                    (dotimes (idx 10000)\",\n    \"                                      (setq total (% (+ (* total 33) (aref score-vec idx) round) 1000000007))))\",\n    \"                                  total))))\",\n    \"         (t-zipper (let ((nested (vector 0)))\",\n    \"                     (dotimes (_ 12000) (setq nested (vector nested)))\",\n    \"                     (bench-el 3 (lambda ()\",\n    \"                                   (let ((cur nested)\",\n    \"                                         (p nil))\",\n    \"                                     (dotimes (_ 12000)\",\n    \"                                       (push cur p)\",\n    \"                                       (setq cur (aref cur 0)))\",\n    \"                                     (let ((rebuilt 42))\",\n    \"                                       (dolist (parent p)\",\n    \"                                         (let ((cp (copy-sequence parent)))\",\n    \"                                           (aset cp 0 rebuilt)\",\n    \"                                           (setq rebuilt cp)))\",\n    \"                                       rebuilt)))))))\",\n    \"    (princ (json-encode\",\n    \"            (list (cons (quote sequence.first10k) t-first)\",\n    \"                  (cons (quote sequence.last10k) t-last)\",\n    \"                  (cons (quote sequence.takeLast10k) t-take-last)\",\n    \"                  (cons (quote value.equalSameRef10k) t-equal)\",\n    \"                  (cons (quote order.sort10k) t-sort)\",\n    \"                  (cons (quote data.groupBy10k) t-group-by)\",\n    \"                  (cons (quote data.frequencies100k) t-freq-100k)\",\n    \"                  (cons (quote tree.zipper12k) t-zipper)\",\n    \"                  (cons (quote worker.scoreValues) t-score))))))\",\n  ].join(\"\\n\");\n  const result = await capture([\n    process.env.EMACS ?? \"emacs\",\n    \"--batch\",\n    \"-Q\",\n    \"--eval\",\n    elispScript,\n  ]);\n  return JSON.parse(result.stdout.trim());\n}\n\nasync function pathExists(targetPath) {\n  try {\n    await stat(targetPath);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nexport async function measureEliscriptDirectory(targetRoot, compilerRoot = projectDirectory) {\n  const compilerModulePath = path.join(compilerRoot, \"dist/bootstrap/compiler.mjs\");\n  if (!(await pathExists(compilerModulePath))) {\n    await capture([\"make\", \"bootstrap-backends\"], { cwd: compilerRoot });\n  }\n  const compiler = await import(pathToFileURL(compilerModulePath).href);\n  const literalsMjs = path.join(targetRoot, \"runtime/literals.mjs\");\n  if (!(await pathExists(literalsMjs))) {\n    await capture([\"make\", \"bootstrap-backends\"], { cwd: targetRoot });\n  }\n  const generatedPairs = [\n    [\"stdlib/core/protocol.eli\", \"runtime/core/protocol-impl.mjs\"],\n    [\"stdlib/core/text.eli\", \"runtime/core/text-impl.mjs\"],\n    [\"stdlib/core/object.eli\", \"runtime/core/object-impl.mjs\"],\n    [\"runtime/unicode-case-data.eli\", \"runtime/unicode-case-data.mjs\"],\n    [\"runtime/unicode-case.eli\", \"runtime/unicode-case.mjs\"],\n    [\"runtime/math.eli\", \"runtime/math.mjs\"],\n  ];\n  for (const [srcRel, outRel] of generatedPairs) {\n    const outPath = path.join(targetRoot, outRel);\n    if (!(await pathExists(outPath))) {\n      const srcPath = path.join(targetRoot, srcRel);\n      if (await pathExists(srcPath)) {\n        const srcText = await readFile(srcPath, \"utf8\");\n        await writeFile(outPath, compiler.compile_string(srcText, srcRel));\n      } else {\n        await writeFile(outPath, await readFile(path.join(compilerRoot, outRel)));\n      }\n    }\n  }\n  const zipperSource = await readFile(\n    path.join(targetRoot, \"stdlib/core/zipper.eli\"),\n    \"utf8\",\n  );\n  const compiledZipper = compiler.compile_string(\n    zipperSource,\n    \"stdlib/core/zipper.eli\",\n  );\n  const seqSource = await readFile(\n    path.join(targetRoot, \"stdlib/core/seq.eli\"),\n    \"utf8\",\n  );\n  const compiledSeq = compiler.compile_string(\n    seqSource,\n    \"stdlib/core/seq.eli\",\n  );\n\n  const tempDir = await mkdtemp(path.join(os.tmpdir(), \"eliscript-version-bench-\"));\n  try {\n    const stdlibCoreDir = path.join(tempDir, \"stdlib/core\");\n    await mkdir(stdlibCoreDir, { recursive: true });\n    await symlink(\n      path.join(targetRoot, \"runtime\"),\n      path.join(tempDir, \"runtime\"),\n      \"dir\",\n    );\n    const nodeModulesEliscript = path.join(tempDir, \"node_modules/eliscript\");\n    await mkdir(path.dirname(nodeModulesEliscript), { recursive: true });\n    await symlink(targetRoot, nodeModulesEliscript, \"dir\");\n\n    const zipperMjsPath = path.join(stdlibCoreDir, \"zipper.mjs\");\n    await writeFile(zipperMjsPath, compiledZipper);\n    const seqMjsPath = path.join(stdlibCoreDir, \"seq.mjs\");\n    await writeFile(seqMjsPath, compiledSeq);\n\n    const runnerPath = path.join(tempDir, \"run-bench.mjs\");\n    const runnerScript = [\n      \"import { performance } from \\\"node:perf_hooks\\\";\",\n      \"import { vector } from \\\"./runtime/literals.mjs\\\";\",\n      \"import { first, last } from \\\"./runtime/core/sequence.mjs\\\";\",\n      \"import { count } from \\\"./runtime/core/collection.mjs\\\";\",\n      \"import { sort, compareValues } from \\\"./runtime/core/order.mjs\\\";\",\n      \"import { groupBy, frequencies } from \\\"./runtime/core/data.mjs\\\";\",\n      \"import { equalValues } from \\\"./runtime/core/value.mjs\\\";\",\n      \"import { VALUE_EQUAL } from \\\"./runtime/core/value-internals.mjs\\\";\",\n      \"import { take_last } from \\\"./stdlib/core/seq.mjs\\\";\",\n      \"import { vector_zipper, down, path as zipPath, replace as zipReplace, root as zipRoot } from \\\"./stdlib/core/zipper.mjs\\\";\",\n      \"function bench(iters, fn) {\",\n      \"  for (let i = 0; i < Math.min(5, iters); i += 1) fn();\",\n      \"  const t0 = performance.now();\",\n      \"  for (let i = 0; i < iters; i += 1) fn();\",\n      \"  return (performance.now() - t0) / iters;\",\n      \"}\",\n      \"const N = 10000;\",\n      \"const arr = Array.from({ length: N }, (_, i) => i);\",\n      \"const vec = vector(...arr);\",\n      \"const shuffledVec = vector(...Array.from({ length: N }, (_, i) => (i * 7919) % N));\",\n      \"const modVec100k = vector(...Array.from({ length: 100000 }, (_, i) => i % 1000));\",\n      \"const scoreArr = Int32Array.from({ length: 10000 }, (_, i) => i % 997);\",\n      \"const takeLastFn = (n, col) => count(take_last(n, col));\",\n      \"let nested = vector(0);\",\n      \"for (let i = 0; i < 12000; i += 1) nested = vector(nested);\",\n      \"const metrics = {\",\n      \"  \\\"sequence.first10k\\\": bench(20000, () => first(vec)),\",\n      \"  \\\"sequence.last10k\\\": bench(200, () => last(vec)),\",\n      \"  \\\"sequence.takeLast10k\\\": bench(200, () => takeLastFn(64, vec)),\",\n      \"  \\\"value.equalSameRef10k\\\": bench(1000, () => vec[VALUE_EQUAL](vec, equalValues) && compareValues(vec, vec) === 0),\",\n      \"  \\\"order.sort10k\\\": bench(30, () => sort(shuffledVec)),\",\n      \"  \\\"data.groupBy10k\\\": bench(30, () => groupBy((x) => x % 100, vec)),\",\n      \"  \\\"data.frequencies100k\\\": bench(7, () => frequencies(modVec100k)),\",\n      \"  \\\"tree.zipper12k\\\": bench(3, () => {\",\n      \"    let loc = vector_zipper(nested);\",\n      \"    for (let i = 0; i < 12000; i += 1) loc = down(loc);\",\n      \"    zipPath(loc);\",\n      \"    return zipRoot(zipReplace(loc, 42));\",\n      \"  }),\",\n      \"  \\\"worker.scoreValues\\\": bench(7, () => {\",\n      \"    let total = 0;\",\n      \"    for (let round = 0; round < 10; round += 1) {\",\n      \"      for (let idx = 0; idx < 10000; idx += 1) {\",\n      \"        total = (total * 33 + scoreArr[idx] + round) % 1000000007;\",\n      \"      }\",\n      \"    }\",\n      \"    return total;\",\n      \"  }),\",\n      \"};\",\n      \"process.stdout.write(JSON.stringify(metrics) + \\\"\\\\n\\\");\",\n    ].join(\"\\n\");\n    await writeFile(runnerPath, runnerScript);\n    const result = await capture([process.execPath, runnerPath], { cwd: tempDir });\n    return JSON.parse(result.stdout.trim());\n  } finally {\n    await rm(tempDir, { recursive: true, force: true });\n  }\n}\n\nexport async function defaultMeasureEliscriptTarget(target, root = projectDirectory) {\n  if (target.id === \"latest\" || !target.tag) {\n    return measureEliscriptDirectory(root, root);\n  }\n  const worktreeDir = await mkdtemp(path.join(os.tmpdir(), `eliscript-wt-${target.version}-`));\n  try {\n    await rm(worktreeDir, { recursive: true, force: true });\n    await capture([\"git\", \"worktree\", \"add\", \"--detach\", worktreeDir, target.tag], {\n      cwd: root,\n    });\n    return await measureEliscriptDirectory(worktreeDir, root);\n  } finally {\n    try {\n      await capture([\"git\", \"worktree\", \"remove\", \"--force\", worktreeDir], {\n        cwd: root,\n      });\n    } catch {\n      await rm(worktreeDir, { recursive: true, force: true });\n    }\n  }\n}\n\nfunction buildSpeedupComparisons(results) {\n  const comparisons = {};\n  const latestMetrics = results.latest?.metricsMs;\n  if (!latestMetrics) return comparisons;\n\n  for (const workload of VERSION_COMPARISON_WORKLOADS) {\n    const id = workload.id;\n    const latestMs = latestMetrics[id];\n    const emacsMs = results.emacsLisp?.metricsMs?.[id] ?? null;\n    const majorMs = results.previousMajor?.metricsMs?.[id] ?? null;\n    const minorMs = results.previousMinor?.metricsMs?.[id] ?? null;\n    comparisons[id] = {\n      latestVsEmacsLisp:\n        emacsMs !== null && latestMs > 0 ? +(emacsMs / latestMs).toFixed(2) : null,\n      latestVsPreviousMajor:\n        majorMs !== null && latestMs > 0 ? +(majorMs / latestMs).toFixed(2) : null,\n      latestVsPreviousMinor:\n        minorMs !== null && latestMs > 0 ? +(minorMs / latestMs).toFixed(2) : null,\n    };\n  }\n  return comparisons;\n}\n\nexport function validateVersionComparisonReport(report) {\n  if (\n    report?.format !== VERSION_COMPARISON_FORMAT ||\n    report?.version !== VERSION_COMPARISON_VERSION\n  ) {\n    throw new TypeError(\"invalid version comparison benchmark report identity\");\n  }\n  for (const dimensionId of VERSION_COMPARISON_DIMENSIONS) {\n    const dim = report.matrix?.[dimensionId];\n    const res = report.results?.[dimensionId];\n    if (!dim || !res || dim.id !== dimensionId) {\n      throw new TypeError(`missing dimension ${dimensionId} in version comparison report`);\n    }\n    if (dim.status === \"active\") {\n      for (const workload of VERSION_COMPARISON_WORKLOADS) {\n        const value = res.metricsMs?.[workload.id];\n        if (typeof value !== \"number\" || !Number.isFinite(value) || value <= 0) {\n          throw new TypeError(\n            `invalid metric ${workload.id} for active dimension ${dimensionId}`,\n          );\n        }\n      }\n    } else if (dim.status === \"absent\") {\n      if (res.metricsMs !== null) {\n        throw new TypeError(`absent dimension ${dimensionId} must have null metricsMs`);\n      }\n    } else {\n      throw new TypeError(`unsupported dimension status ${String(dim.status)}`);\n    }\n  }\n  return report;\n}\n\nexport async function runVersionComparisonBenchmark(options = {}) {\n  const root = path.resolve(options.root ?? projectDirectory);\n  const pkg = JSON.parse(await readFile(path.join(root, \"package.json\"), \"utf8\"));\n  const currentVersion = options.currentVersion ?? pkg.version;\n  const releasedTags = options.releasedTags ?? (await discoverReleasedTags(root));\n  const emacsVersion = options.emacsVersion ?? (await detectEmacsVersion());\n\n  const matrix = resolveVersionComparisonMatrix({\n    currentVersion,\n    releasedTags,\n    emacsVersion,\n  });\n\n  const measureEmacs = options.measureEmacsLisp ?? defaultMeasureEmacsLisp;\n  const measureTarget =\n    options.measureEliscriptTarget ??\n    ((target) => defaultMeasureEliscriptTarget(target, root));\n\n  const results = {};\n\n  results.emacsLisp = {\n    ...matrix.emacsLisp,\n    deduplicatedFrom: null,\n    metricsMs: await measureEmacs(matrix.emacsLisp),\n  };\n\n  if (matrix.previousMinor.status === \"active\") {\n    results.previousMinor = {\n      ...matrix.previousMinor,\n      deduplicatedFrom: null,\n      metricsMs: await measureTarget(matrix.previousMinor),\n    };\n  } else {\n    results.previousMinor = {\n      ...matrix.previousMinor,\n      deduplicatedFrom: null,\n      metricsMs: null,\n    };\n  }\n\n  if (matrix.previousMajor.status === \"active\") {\n    if (matrix.previousMajor.sameAsPreviousMinor && results.previousMinor?.metricsMs) {\n      results.previousMajor = {\n        ...matrix.previousMajor,\n        deduplicatedFrom: \"previousMinor\",\n        metricsMs: { ...results.previousMinor.metricsMs },\n      };\n    } else {\n      results.previousMajor = {\n        ...matrix.previousMajor,\n        deduplicatedFrom: null,\n        metricsMs: await measureTarget(matrix.previousMajor),\n      };\n    }\n  } else {\n    results.previousMajor = {\n      ...matrix.previousMajor,\n      deduplicatedFrom: null,\n      metricsMs: null,\n    };\n  }\n\n  results.latest = {\n    ...matrix.latest,\n    deduplicatedFrom: null,\n    metricsMs: await measureTarget(matrix.latest),\n  };\n\n  const report = {\n    format: VERSION_COMPARISON_FORMAT,\n    version: VERSION_COMPARISON_VERSION,\n    generatedAt: new Date().toISOString(),\n    host: {\n      platform: process.platform,\n      architecture: process.arch,\n      operatingSystem: `${os.type()} ${os.release()}`,\n      bunVersion: Bun.version,\n      emacsVersion,\n    },\n    matrix,\n    workloads: VERSION_COMPARISON_WORKLOADS,\n    results,\n    comparisons: buildSpeedupComparisons(results),\n  };\n\n  return validateVersionComparisonReport(report);\n}\n\nfunction formatMs(value) {\n  if (value === null || value === undefined) return \"N/A\";\n  if (value < 0.01) return `${(value * 1000).toFixed(2)} µs (${value.toFixed(5)} ms)`;\n  return `${value.toFixed(3)} ms`;\n}\n\nfunction formatRatio(ratio) {\n  if (ratio === null || ratio === undefined) return \"N/A\";\n  return `${ratio.toFixed(2)}x`;\n}\n\nfunction dimensionHeader(dim) {\n  if (dim.id === \"emacsLisp\") {\n    return `1. Emacs Lisp (${dim.version}, 当前最新版)`;\n  }\n  if (dim.id === \"previousMajor\") {\n    if (dim.status === \"absent\") return \"2. 上一个大版本 (不存在 / N/A)\";\n    if (dim.sameAsPreviousMinor) return `2. 上一个大版本 (${dim.tag}, 同上一小版本)`;\n    return `2. 上一个大版本 (${dim.tag})`;\n  }\n  if (dim.id === \"previousMinor\") {\n    if (dim.status === \"absent\") return \"3. 上一个最近的小版本 (首个版本 / N/A)\";\n    return `3. 上一个最近的小版本 (${dim.tag})`;\n  }\n  return `4. 最新版 (${dim.tag})`;\n}\n\nexport function renderVersionComparisonMarkdown(report) {\n  validateVersionComparisonReport(report);\n  const { matrix, results, comparisons } = report;\n  const lines = [\n    \"# Eliscript 四维版本与原生 Emacs Lisp 性能对比报告\",\n    \"\",\n    `- **生成时间**: \\`${report.generatedAt}\\``,\n    `- **运行环境**: \\`${report.host.operatingSystem} (${report.host.platform}/${report.host.architecture})\\`, Bun \\`${report.host.bunVersion}\\`, Emacs \\`${report.host.emacsVersion}\\``,\n    \"\",\n    \"## 对比维度状态\",\n    \"\",\n    \"| 维度 | 状态 | 版本 / 标签 | 边界说明 |\",\n    \"| --- | --- | --- | --- |\",\n    `| **1. Emacs Lisp** | \\`${matrix.emacsLisp.status}\\` | \\`Emacs ${matrix.emacsLisp.version}\\` | 仅考虑当前宿主最新版 Emacs Lisp (\\`${matrix.emacsLisp.mode}\\`) |`,\n    `| **2. 上一个大版本** | \\`${matrix.previousMajor.status}\\` | \\`${matrix.previousMajor.tag ?? \"N/A\"}\\` | ${\n      matrix.previousMajor.status === \"absent\"\n        ? \"当前尚无上一大版本 (\\`no-prior-major-release\\`)\"\n        : matrix.previousMajor.sameAsPreviousMinor\n          ? \"与上一个最近的小版本相同，复用采样结果 (\\`same-as-previous-minor\\`)\"\n          : \"已解析上一大版本最新标签\"\n    } |`,\n    `| **3. 上一个最近的小版本** | \\`${matrix.previousMinor.status}\\` | \\`${matrix.previousMinor.tag ?? \"N/A\"}\\` | ${\n      matrix.previousMinor.status === \"absent\"\n        ? \"当前为首个版本，无上一小版本 (\\`initial-release\\`)\"\n        : \"已解析最近上一发布版本\"\n    } |`,\n    `| **4. 最新版** | \\`${matrix.latest.status}\\` | \\`${matrix.latest.tag}\\` | 当前工作区最新版本 |`,\n    \"\",\n    \"## 基准工作负载四维耗时与加速比\",\n    \"\",\n    `| 工作负载 | ${dimensionHeader(matrix.emacsLisp)} | ${dimensionHeader(matrix.previousMajor)} | ${dimensionHeader(matrix.previousMinor)} | ${dimensionHeader(matrix.latest)} | 最新版 vs Emacs Lisp | 最新版 vs 上一大版本 | 最新版 vs 上一小版本 |`,\n    \"| --- | --- | --- | --- | --- | --- | --- | --- |\",\n  ];\n\n  for (const workload of VERSION_COMPARISON_WORKLOADS) {\n    const id = workload.id;\n    const elMs = results.emacsLisp.metricsMs?.[id] ?? null;\n    const majMs = results.previousMajor.metricsMs?.[id] ?? null;\n    const minMs = results.previousMinor.metricsMs?.[id] ?? null;\n    const latMs = results.latest.metricsMs?.[id] ?? null;\n    const cmp = comparisons[id] ?? {};\n    lines.push(\n      `| **${workload.label}** | ${formatMs(elMs)} | ${formatMs(majMs)} | ${formatMs(minMs)} | **${formatMs(latMs)}** | **${formatRatio(cmp.latestVsEmacsLisp)}** | ${formatRatio(cmp.latestVsPreviousMajor)} | **${formatRatio(cmp.latestVsPreviousMinor)}** |`,\n    );\n  }\n  lines.push(\"\");\n  return lines.join(\"\\n\");\n}\n\nexport function renderReleaseNotesSummary(report) {\n  validateVersionComparisonReport(report);\n  const { matrix, results, comparisons } = report;\n  const version = matrix.latest.version;\n  const mdFile = `eliscript-${version}-benchmark-report.md`;\n  const jsonFile = `eliscript-${version}-benchmark-report.json`;\n  const lines = [\n    \"## 测试与四维性能基准摘要\",\n    \"\",\n    `- **对比维度**: \\`Emacs ${matrix.emacsLisp.version}\\` (当前最新版) | 上一个大版本: \\`${matrix.previousMajor.tag ?? \"N/A (尚无上一大版本)\"}\\` | 上一个最近的小版本: \\`${matrix.previousMinor.tag ?? \"N/A (首个版本)\"}\\` | 最新版: \\`${matrix.latest.tag}\\``,\n    `- **完整测试与基准报告附件**: 详见 Release 附件 \\`${mdFile}\\` 与 \\`${jsonFile}\\``,\n    \"\",\n    \"| 基准工作负载 | 最新版耗时 | vs Emacs Lisp | vs 上一大版本 | vs 上一小版本 |\",\n    \"| --- | --- | --- | --- | --- |\",\n  ];\n  for (const workload of VERSION_COMPARISON_WORKLOADS) {\n    const id = workload.id;\n    const latMs = results.latest.metricsMs?.[id] ?? null;\n    const cmp = comparisons[id] ?? {};\n    lines.push(\n      `| **${workload.label}** | **${formatMs(latMs)}** | **${formatRatio(cmp.latestVsEmacsLisp)}** | ${formatRatio(cmp.latestVsPreviousMajor)} | **${formatRatio(cmp.latestVsPreviousMinor)}** |`,\n    );\n  }\n  lines.push(\"\");\n  return lines.join(\"\\n\");\n}\n\nexport function mergeReleaseNotesWithSummary(existingNotes, summaryMarkdown) {\n  const cleanSummary = String(summaryMarkdown ?? \"\").trim();\n  const rawNotes = String(existingNotes ?? \"\").trim();\n  if (!rawNotes) {\n    return `${cleanSummary}\\n`;\n  }\n  const heading = \"## 测试与四维性能基准摘要\";\n  const idx = rawNotes.indexOf(heading);\n  if (idx === -1) {\n    return `${rawNotes}\\n\\n${cleanSummary}\\n`;\n  }\n  const prefix = rawNotes.slice(0, idx).trim();\n  const remainder = rawNotes.slice(idx + heading.length);\n  const nextSectionMatch = /\\n##\\s+/u.exec(remainder);\n  const suffix = nextSectionMatch\n    ? remainder.slice(nextSectionMatch.index).trim()\n    : \"\";\n  const parts = [];\n  if (prefix) parts.push(prefix);\n  if (cleanSummary) parts.push(cleanSummary);\n  if (suffix) parts.push(suffix);\n  return `${parts.join(\"\\n\\n\")}\\n`;\n}\n\nexport async function writeReleaseComparisonBundle(report, releaseDir, options = {}) {\n  validateVersionComparisonReport(report);\n  const resolvedDir = path.resolve(releaseDir);\n  await mkdir(resolvedDir, { recursive: true });\n  const version = report.matrix.latest.version;\n  const summaryPath = path.join(resolvedDir, \"release-summary.md\");\n  const mergedNotesPath = path.join(resolvedDir, \"release-notes-merged.md\");\n  const markdownPath = path.join(\n    resolvedDir,\n    `eliscript-${version}-benchmark-report.md`,\n  );\n  const jsonPath = path.join(\n    resolvedDir,\n    `eliscript-${version}-benchmark-report.json`,\n  );\n  const summaryMarkdown = renderReleaseNotesSummary(report);\n  const existingNotes =\n    options.existingNotes !== undefined\n      ? options.existingNotes\n      : options.mergeNotesPath\n        ? await readFile(path.resolve(options.mergeNotesPath), \"utf8\").catch(() => \"\")\n        : \"\";\n  const mergedNotes = mergeReleaseNotesWithSummary(existingNotes, summaryMarkdown);\n  await writeFile(summaryPath, summaryMarkdown);\n  await writeFile(mergedNotesPath, mergedNotes);\n  await writeFile(markdownPath, renderVersionComparisonMarkdown(report));\n  await writeFile(jsonPath, `${JSON.stringify(report, null, 2)}\\n`);\n  return {\n    summaryPath,\n    mergedNotesPath,\n    markdownPath,\n    jsonPath,\n  };\n}\n\nfunction parseCliArgs(argv) {\n  let format = \"markdown\";\n  let output = null;\n  let releaseDir = null;\n  let mergeNotesPath = null;\n  for (let i = 0; i < argv.length; i += 1) {\n    const arg = argv[i];\n    if (arg === \"--format\") {\n      format = argv[++i] ?? \"markdown\";\n    } else if (arg === \"--json\") {\n      format = \"json\";\n    } else if (arg === \"--markdown\") {\n      format = \"markdown\";\n    } else if (arg === \"--release-summary\") {\n      format = \"release-summary\";\n    } else if (arg === \"--output\") {\n      output = argv[++i];\n      if (!output) throw new TypeError(\"--output requires a file path\");\n    } else if (arg === \"--release-dir\") {\n      releaseDir = argv[++i];\n      if (!releaseDir) throw new TypeError(\"--release-dir requires a directory path\");\n    } else if (arg === \"--merge-notes\") {\n      mergeNotesPath = argv[++i];\n      if (!mergeNotesPath) throw new TypeError(\"--merge-notes requires a file path\");\n    } else {\n      throw new TypeError(`unknown argument: ${arg}`);\n    }\n  }\n  return { format, output, releaseDir, mergeNotesPath };\n}\n\nif (import.meta.main) {\n  const { format, output, releaseDir, mergeNotesPath } = parseCliArgs(process.argv.slice(2));\n  const report = await runVersionComparisonBenchmark();\n  if (releaseDir) {\n    await writeReleaseComparisonBundle(report, releaseDir, { mergeNotesPath });\n  }\n  const rendered =\n    format === \"json\"\n      ? `${JSON.stringify(report, null, 2)}\\n`\n      : format === \"release-summary\"\n        ? renderReleaseNotesSummary(report)\n        : renderVersionComparisonMarkdown(report);\n  if (output) {\n    await writeFile(path.resolve(output), rendered);\n  } else {\n    process.stdout.write(rendered);\n  }\n}\n"))
