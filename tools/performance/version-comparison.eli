(module tools.performance.version-comparison
  (import "node:fs" readFileSync)
  (import "node:fs/promises" mkdir mkdtemp readFile realpath rm stat symlink writeFile)
  (import "node:module" createRequire)
  (import "node:child_process" spawnSync)
  (import "node:os" :default os)
  (import "node:path" :default path)
  (import "node:process" :default process)
  (import "node:util" isDeepStrictEqual)
  (import "../backends/build.mjs" root)
  (import "../backends/dist/release-cli.mjs" requirePreparedStage3)

  (defconst projectDirectory root)
  (defconst VERSION_COMPARISON_FORMAT "eliscript-version-comparison-benchmark")
  (defconst VERSION_COMPARISON_VERSION 1)

  (defconst VERSION_COMPARISON_DIMENSIONS
    (Object/freeze (js-array "emacsLisp" "previousMajor" "previousMinor" "latest")))

  ;; One Git-declared input binds the minimum batch size of every workload for
  ;; the JavaScript runner, the native Emacs driver and report validation.
  (defconst VERSION_COMPARISON_MINIMA
    (JSON/parse
      (readFileSync
        (new globalThis.URL "./version-comparison-minima.json" (js* "import.meta.url"))
        "utf8")))

  (defconst VERSION_COMPARISON_WORKLOADS
    (Object/freeze
      (js-array
        (Object/freeze (js-object :id "sequence.first10k" :minimumIterations (get VERSION_COMPARISON_MINIMA "sequence.first10k") :label "first(Vector, N=10,000)" :category "sequence" :unit "ms"))
        (Object/freeze (js-object :id "sequence.last10k" :minimumIterations (get VERSION_COMPARISON_MINIMA "sequence.last10k") :label "last(Vector, N=10,000)" :category "sequence" :unit "ms"))
        (Object/freeze (js-object :id "sequence.takeLast10k" :minimumIterations (get VERSION_COMPARISON_MINIMA "sequence.takeLast10k") :label "take-last(64, N=10,000)" :category "sequence" :unit "ms"))
        (Object/freeze (js-object :id "value.equalSameRef10k" :minimumIterations (get VERSION_COMPARISON_MINIMA "value.equalSameRef10k") :label "equality(same Vector reference, N=10,000)" :category "equality" :unit "ms"))
        (Object/freeze (js-object :id "order.sort10k" :minimumIterations (get VERSION_COMPARISON_MINIMA "order.sort10k") :label "sort(Vector, N=10,000)" :category "ordering" :unit "ms"))
        (Object/freeze (js-object :id "data.groupBy10k" :minimumIterations (get VERSION_COMPARISON_MINIMA "data.groupBy10k") :label "group-by(x % 100, N=10,000)" :category "aggregation" :unit "ms"))
        (Object/freeze (js-object :id "data.frequencies100k" :minimumIterations (get VERSION_COMPARISON_MINIMA "data.frequencies100k") :label "frequencies(1,000 keys, N=100,000)" :category "aggregation" :unit "ms"))
        (Object/freeze (js-object :id "tree.zipper12k" :minimumIterations (get VERSION_COMPARISON_MINIMA "tree.zipper12k") :label "12,000-depth Zipper (down*12k + path + replace + root)" :category "tree" :unit "ms"))
        (Object/freeze (js-object :id "worker.scoreValues" :minimumIterations (get VERSION_COMPARISON_MINIMA "worker.scoreValues") :label "score-values(N=10,000 x 10 rounds)" :category "numeric" :unit "ms")))))

  (let ((ids (Object/keys VERSION_COMPARISON_MINIMA)) (index 0))
    (unless (= (js-length ids) (js-length VERSION_COMPARISON_WORKLOADS))
      (throw (new globalThis.TypeError "benchmark minima must cover every workload exactly once")))
    (while (< index (js-length ids))
      (let* ((id (aref ids index))
             (value (get VERSION_COMPARISON_MINIMA id)))
        (unless (and (= id (get (aref VERSION_COMPARISON_WORKLOADS index) :id))
                     (Number/isSafeInteger value) (> value 0))
          (throw (new globalThis.TypeError (str "invalid benchmark minimum for " id)))))
      (setq index (1+ index))))

  (defun nullish (value fallback)
    (if (or (eq value undefined) (eq value nil)) fallback value))

  (defun parseSemver (input)
    (if (/= (value-type input) "string")
      nil
      (let* ((trimmed (js-call input :trim))
             (re (new globalThis.RegExp "^v?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$" "u"))
             (match (js-call re :exec trimmed)))
        (if (not match)
          nil
          (let* ((major (globalThis.Number (aref match 1)))
                 (minor (globalThis.Number (aref match 2)))
                 (patch (globalThis.Number (aref match 3)))
                 (version (str major "." minor "." patch)))
            (js-object
              :major major
              :minor minor
              :patch patch
              :version version
              :tag (str "v" version)))))))

  (defun compareSemver (left right)
    (if (/= (get left :major) (get right :major))
      (- (get left :major) (get right :major))
      (if (/= (get left :minor) (get right :minor))
        (- (get left :minor) (get right :minor))
        (- (get left :patch) (get right :patch)))))

  (defun resolveVersionComparisonMatrix (&optional rawOptions)
    (let* ((options (nullish rawOptions (js-object)))
           (currentVersion (get options :currentVersion))
           (releasedTags (nullish (get options :releasedTags) (js-array)))
           (emacsVersion (nullish (get options :emacsVersion) "unknown"))
           (current (parseSemver currentVersion)))
      (unless current
        (throw (new globalThis.TypeError (str "invalid current semantic version: " (globalThis.String currentVersion)))))
      (let ((parsedReleases (js-array))
            (seenVersions (new globalThis.Set))
            (idx 0))
        (while (< idx (js-length releasedTags))
          (let* ((rawTag (aref releasedTags idx))
                 (parsed (parseSemver rawTag)))
            (when (and parsed (not (js-call seenVersions :has (get parsed :version))))
              (js-call seenVersions :add (get parsed :version))
              (js-call parsedReleases :push
                (Object/assign (js-object) parsed
                  (js-object :tag (if (and (= (value-type rawTag) "string")
                                           (js-call rawTag :startsWith "v"))
                                    rawTag
                                    (get parsed :tag)))))))
          (setq idx (1+ idx)))
        (js-call parsedReleases :sort compareSemver)
        (let* ((priorReleases (js-call parsedReleases :filter (lambda (entry) (< (compareSemver entry current) 0))))
               (priorMajorReleases (js-call priorReleases :filter (lambda (entry) (< (get entry :major) (get current :major)))))
               (bestMinor (nullish (js-call priorReleases :at -1) nil))
               (bestMajor (nullish (js-call priorMajorReleases :at -1) nil))
               (sameMajorAndMinor (globalThis.Boolean (and bestMajor bestMinor (= (get bestMajor :version) (get bestMinor :version)))))
               (emacsDimension
                 (Object/freeze
                   (js-object
                     :id "emacsLisp"
                     :label "Emacs Lisp"
                     :status "active"
                     :version (globalThis.String emacsVersion)
                     :tag nil
                     :mode "current-latest-only"
                     :reason "current-host-emacs")))
               (previousMajorDimension
                 (if bestMajor
                   (Object/freeze
                     (js-object
                       :id "previousMajor"
                       :label "上一个大版本"
                       :status "active"
                       :version (get bestMajor :version)
                       :tag (get bestMajor :tag)
                       :reason (if sameMajorAndMinor "same-as-previous-minor" "resolved")
                       :sameAsPreviousMinor sameMajorAndMinor))
                   (Object/freeze
                     (js-object
                       :id "previousMajor"
                       :label "上一个大版本"
                       :status "absent"
                       :version nil
                       :tag nil
                       :reason "no-prior-major-release"
                       :sameAsPreviousMinor false))))
               (previousMinorDimension
                 (if bestMinor
                   (Object/freeze
                     (js-object
                       :id "previousMinor"
                       :label "上一个最近的小版本"
                       :status "active"
                       :version (get bestMinor :version)
                       :tag (get bestMinor :tag)
                       :reason "resolved"
                       :sameAsPreviousMajor sameMajorAndMinor))
                   (Object/freeze
                     (js-object
                       :id "previousMinor"
                       :label "上一个最近的小版本"
                       :status "absent"
                       :version nil
                       :tag nil
                       :reason "initial-release"
                       :sameAsPreviousMajor false))))
               (latestDimension
                 (Object/freeze
                   (js-object
                     :id "latest"
                     :label "最新版"
                     :status "active"
                     :version (get current :version)
                     :tag (get current :tag)
                     :reason "current-workspace"))))
          (Object/freeze
            (js-object
              :emacsLisp emacsDimension
              :previousMajor previousMajorDimension
              :previousMinor previousMinorDimension
              :latest latestDimension))))))

  (defasync capture (command &optional rawOptions)
    (let* ((options (nullish rawOptions (js-object)))
           (result (spawnSync (aref command 0) (js-call command :slice 1)
             (Object/assign (js-object :cwd projectDirectory :encoding "utf8"
               :timeout 120000 :maxBuffer 4194304 :detached t :killSignal "SIGKILL") options)))
           (error (get result :error)))
      (unless (nullish? error)
        ;; Every command owns a POSIX process group. A timed-out build must not
        ;; leave make's compiler children writing into a removed worktree.
        (when (and (Number/isInteger (get result :pid)) (> (get result :pid) 0))
          (try (js-call process :kill (- (get result :pid)) "SIGKILL")
            (catch ignored nil)))
        (throw error))
      (let ((stdout (nullish (get result :stdout) ""))
            (stderr (nullish (get result :stderr) "")))
        (unless (= (get result :status) 0)
          (let ((trimmedErr (js-call stderr :trim)) (trimmedOut (js-call stdout :trim)))
            (throw (new globalThis.Error
              (if (> (js-length trimmedErr) 0) trimmedErr
                (if (> (js-length trimmedOut) 0) trimmedOut
                  (str (aref command 0) " exited with " (get result :status))))))))
        (js-object :stdout stdout :stderr stderr))))

  (defasync discoverReleasedTags (&optional rawRoot)
    (let* ((targetRoot (nullish rawRoot projectDirectory))
           (result (await (capture (js-array "git" "tag" "--list" "v*") (js-object :cwd targetRoot))))
           (lines (js-call (get result :stdout) :split (new globalThis.RegExp "\\r?\\n" "u"))))
      (js-call
        (js-call lines :map (lambda (line) (js-call line :trim)))
        :filter (lambda (line) (not (eq (parseSemver line) nil))))))

  (defasync detectEmacsVersion ()
    (let* ((emacsBin (nullish (get (get process :env) :EMACS) "emacs"))
           (result (await (capture (js-array emacsBin "--batch" "-Q" "--eval" "(princ emacs-version)")))))
      (js-call (get result :stdout) :trim)))

  (defasync defaultMeasureEmacsLisp ()
    (let* ((emacsBin (nullish (get (get process :env) :EMACS) "emacs"))
           (driver (js-call path :join projectDirectory "tools/performance/version-comparison-emacs.el"))
           (result (await (capture (js-array emacsBin "--batch" "-Q" "--load" driver)))))
      (JSON/parse (js-call (get result :stdout) :trim))))

  (defasync pathExists (targetPath)
    (try
      (progn (await (stat targetPath)) t)
      (catch error false)))

  (defasync measureEliscriptDirectory (targetRoot &optional rawCompilerRoot vectorDiagnostics)
    (let* ((compilerRoot (nullish rawCompilerRoot projectDirectory))
           (literalsMjs (js-call path :join targetRoot "runtime/literals.mjs"))
           (targetCompilerPath (js-call path :join targetRoot "dist/bootstrap/compiler.mjs"))
           (prepared undefined)
           (current-source-root
             (= (await (realpath targetRoot)) (await (realpath projectDirectory)))))
      ;; The current source root is the prepared final stage3 package: require
      ;; its authentication and never rebuild the seed for it. Historical
      ;; version dimensions keep measuring their own checkout build below.
      ;; compilerRoot supplies the common workload source and one shared timing
      ;; driver, never the compiler measured here.
      (if current-source-root
          (setq prepared (await (requirePreparedStage3)))
        (unless (and (await (pathExists literalsMjs)) (await (pathExists targetCompilerPath)))
          (await (capture (js-array "make" "bootstrap-backends") (js-object :cwd targetRoot :timeout 360000)))))
      (let* ((targetCompilerPath (js-call path :join targetRoot "dist/bootstrap/compiler.mjs"))
             (activeCompilerPath targetCompilerPath)
             (compiler (funcall (createRequire activeCompilerPath) activeCompilerPath)))
        (let* ((zipperSource (await (readFile (js-call path :join targetRoot "stdlib/core/zipper.eli") "utf8")))
               (compiledZipper
                 (js-call
                   (js-call
                     (js-call
                       (js-call (js-call compiler :compile_string zipperSource "stdlib/core/zipper.eli")
                         :split "\"eliscript/runtime/prelude.mjs\"")
                       :join "\"../../runtime/prelude.mjs\"")
                     :split "\"eliscript/runtime/primitives.mjs\"")
                   :join "\"../../runtime/primitives.mjs\""))
               (seqSource (await (readFile (js-call path :join targetRoot "stdlib/core/seq.eli") "utf8")))
               (compiledSeq
                 (js-call
                   (js-call
                     (js-call
                       (js-call (js-call compiler :compile_string seqSource "stdlib/core/seq.eli")
                         :split "\"eliscript/runtime/prelude.mjs\"")
                       :join "\"../../runtime/prelude.mjs\"")
                     :split "\"eliscript/runtime/primitives.mjs\"")
                   :join "\"../../runtime/primitives.mjs\""))
               (tempDir (await (mkdtemp (js-call path :join (js-call os :tmpdir) "eliscript-version-bench-")))))
          (try
            (let* ((stdlibCoreDir (js-call path :join tempDir "stdlib/core"))
                   (nodeModulesEliscript (js-call path :join tempDir "node_modules/eliscript"))
                   (zipperMjsPath (js-call path :join stdlibCoreDir "zipper.mjs"))
                   (seqMjsPath (js-call path :join stdlibCoreDir "seq.mjs"))
                   (runnerPath (js-call path :join tempDir "workloads.mjs"))
                   (timingPath (js-call path :join compilerRoot "tools/performance/version-comparison-runner.mjs"))
                   (runnerSource (await (readFile (js-call path :join compilerRoot "tools/performance/version-comparison-workloads.eli") "utf8")))
                   (relocatedRunner (js-call (js-call runnerSource :replaceAll
                     "(import \"../../runtime/" "(import \"./runtime/") :replaceAll
                     "(import \"../../stdlib/core/" "(import \"./stdlib/core/"))
                   (runnerScript (js-call compiler :compile_string relocatedRunner "version-comparison-workloads.eli")))
              (await (mkdir stdlibCoreDir (js-object :recursive t)))
              (await (symlink (js-call path :join targetRoot "runtime") (js-call path :join tempDir "runtime") "dir"))
              (await (mkdir (js-call path :dirname nodeModulesEliscript) (js-object :recursive t)))
              (await (symlink targetRoot nodeModulesEliscript "dir"))
              (await (writeFile zipperMjsPath compiledZipper))
              (await (writeFile seqMjsPath compiledSeq))
              (await (writeFile runnerPath runnerScript))
              (let* ((command (if (eq vectorDiagnostics t)
                               (js-array (get process :execPath) timingPath "--vector-diagnostics" runnerPath)
                               (js-array (get process :execPath) timingPath runnerPath)))
                     (result (await (capture command (js-object :cwd tempDir)))))
                (let ((measurement (JSON/parse (js-call (get result :stdout) :trim))))
                  (unless (undefined? prepared)
                    (put measurement :preparedCompiler (get prepared :reportIdentity))
                    (unless (isDeepStrictEqual (get measurement :preparedCompiler)
                              (get (await (requirePreparedStage3)) :reportIdentity))
                      (throw (new globalThis.Error "prepared latest compiler changed during measurement"))))
                  measurement)))
            (finally
              (await (rm tempDir (js-object :recursive t :force t)))))))))

  (defasync defaultMeasureEliscriptTarget (target &optional rawRoot vectorDiagnostics)
    (let ((targetRoot (nullish rawRoot projectDirectory)))
      (if (or (= (get target :id) "latest") (not (get target :tag)))
        (await (measureEliscriptDirectory targetRoot targetRoot vectorDiagnostics))
        (let* ((worktreeRoot (js-call path :join targetRoot "_worktree" "version-comparison"))
               (_ (await (mkdir worktreeRoot (js-object :recursive t))))
               (worktreeDir (await (mkdtemp (js-call path :join worktreeRoot (str "eliscript-wt-" (get target :version) "-"))))))
          (try
            (progn
              (await (rm worktreeDir (js-object :recursive t :force t)))
              (await (capture (js-array "git" "worktree" "add" "--detach" worktreeDir (get target :tag))
                       (js-object :cwd targetRoot)))
              (await (measureEliscriptDirectory worktreeDir targetRoot vectorDiagnostics)))
            (finally
              (try
                (await (capture (js-array "git" "worktree" "remove" "--force" worktreeDir)
                         (js-object :cwd targetRoot)))
                (catch error
                  (await (rm worktreeDir (js-object :recursive t :force t)))))))))))

  (defun roundRatio (numerator denominator)
    (if (and (not (eq numerator nil)) (not (eq numerator undefined)) (> denominator 0))
      (globalThis.Number (js-call (/ numerator denominator) :toFixed 2))
      nil))

  (defun buildSpeedupComparisons (results)
    (let* ((comparisons (js-object))
           (latestRes (get results :latest))
           (latestMetrics (if latestRes (get latestRes :metricsMs) nil)))
      (if (not latestMetrics)
        comparisons
        (let ((idx 0))
          (while (< idx (js-length VERSION_COMPARISON_WORKLOADS))
            (let* ((workload (aref VERSION_COMPARISON_WORKLOADS idx))
                   (id (get workload :id))
                   (latestMs (get latestMetrics id))
                   (emacsRes (get results :emacsLisp))
                   (emacsMetrics (if emacsRes (get emacsRes :metricsMs) nil))
                   (emacsMs (if emacsMetrics (nullish (get emacsMetrics id) nil) nil))
                   (majorRes (get results :previousMajor))
                   (majorMetrics (if majorRes (get majorRes :metricsMs) nil))
                   (majorMs (if majorMetrics (nullish (get majorMetrics id) nil) nil))
                   (minorRes (get results :previousMinor))
                   (minorMetrics (if minorRes (get minorRes :metricsMs) nil))
                   (minorMs (if minorMetrics (nullish (get minorMetrics id) nil) nil)))
              (put comparisons id
                (js-object
                  :latestVsEmacsLisp (roundRatio emacsMs latestMs)
                  :latestVsPreviousMajor (roundRatio majorMs latestMs)
                  :latestVsPreviousMinor (roundRatio minorMs latestMs))))
            (setq idx (1+ idx)))
          comparisons))))

  (defun validate-measurement-calibration (result workload dimension)
    (let* ((id (get workload :id))
           (minimum (get workload :minimumIterations))
           (all (get result :calibration))
           (calibration (if (and (not (nullish? all)) (= (value-type all) "object")) (get all id) nil)))
      (unless (and (not (nullish? calibration)) (= (value-type calibration) "object")
                   (Number/isSafeInteger (get calibration :minimumIterations))
                   (= (get calibration :minimumIterations) minimum)
                   (Number/isSafeInteger (get calibration :iterationsPerBatch))
                   (>= (get calibration :iterationsPerBatch) minimum)
                   (<= (get calibration :iterationsPerBatch) 16777216)
                   (Array/isArray (get calibration :batchMs))
                   (= (js-length (get calibration :batchMs)) 3)
                   (js-call (Array/from (get calibration :batchMs)) :every
                     (lambda (value) (and (= (value-type value) "number")
                       (Number/isFinite value) (>= value 1)))))
        (throw (new globalThis.TypeError (str "invalid calibration " id " for " dimension))))))

  (defun validateVersionComparisonReport (report)
    (when (or (not report)
              (/= (get report :format) VERSION_COMPARISON_FORMAT)
              (/= (get report :version) VERSION_COMPARISON_VERSION))
      (throw (new globalThis.TypeError "invalid version comparison benchmark report identity")))
    (let ((dimIdx 0))
      (while (< dimIdx (js-length VERSION_COMPARISON_DIMENSIONS))
        (let* ((dimensionId (aref VERSION_COMPARISON_DIMENSIONS dimIdx))
               (matrixObj (get report :matrix))
               (resultsObj (get report :results))
               (dim (if matrixObj (get matrixObj dimensionId) nil))
               (res (if resultsObj (get resultsObj dimensionId) nil)))
          (when (or (not dim) (not res) (/= (get dim :id) dimensionId))
            (throw (new globalThis.TypeError (str "missing dimension " dimensionId " in version comparison report"))))
          (let ((status (get dim :status)))
            (unless (and (= (get res :id) dimensionId) (= (get res :status) status))
              (throw (new globalThis.TypeError (str "dimension result identity differs: " dimensionId))))
            (cond
              ((= status "active")
               (let ((wIdx 0))
                 (while (< wIdx (js-length VERSION_COMPARISON_WORKLOADS))
                   (let* ((workload (aref VERSION_COMPARISON_WORKLOADS wIdx))
                          (wId (get workload :id))
                          (metrics (get res :metricsMs))
                          (val (if metrics (get metrics wId) undefined)))
                     (when (or (/= (value-type val) "number")
                               (not (Number/isFinite val))
                               (<= val 0))
                       (throw (new globalThis.TypeError
                                (str "invalid metric " wId " for active dimension " dimensionId))))
                     (validate-measurement-calibration res workload dimensionId)
                     ;; Every active dimension owns complete evidence. A
                     ;; deduplicated prior version receives it through the
                     ;; existing previousMinor copy; only absent dimensions
                     ;; have no measurements.
                     (let* ((table (get res :samplesMs))
                            (samples (if (and (not (nullish? table)) (= (value-type table) "object"))
                                       (get table wId) nil))
                            (valid (and (Array/isArray samples) (= (js-length samples) 3))))
                       (unless (and valid (js-call (Array/from samples) :every
                         (lambda (value) (and (= (value-type value) "number")
                           (Number/isFinite value) (> value 0)))))
                         (throw (new globalThis.TypeError (str "invalid samples " wId " for " dimensionId))))
                       (let ((ordered (js-call (js-call samples :slice) :sort (lambda (a b) (- a b)))))
                         (unless (= val (aref ordered 1))
                           (throw (new globalThis.TypeError (str "metric differs from sample median " wId " for " dimensionId)))))))
                   (setq wIdx (1+ wIdx)))))
              ((= status "absent")
               (when (not (eq (get res :metricsMs) nil))
                 (throw (new globalThis.TypeError (str "absent dimension " dimensionId " must have null metricsMs")))))
              (t
               (throw (new globalThis.TypeError (str "unsupported dimension status " (globalThis.String status))))))))
        (setq dimIdx (1+ dimIdx))))
    report)

  (defasync measure-comparison-dimension (dimension measure failures)
    (try
      (let ((measurement (await (funcall measure dimension))))
        ;; A measured dimension must hand back complete evidence. Bare
        ;; metric maps are rejected instead of passing the report validator.
        (unless (and (not (nullish? measurement)) (= (value-type measurement) "object")
                     (Object/hasOwn measurement "metricsMs")
                     (Object/hasOwn measurement "samplesMs")
                     (Object/hasOwn measurement "calibration"))
          (throw (new globalThis.TypeError
                   (str "dimension measurement requires samples and calibration: " (get dimension :id)))))
        (let ((result (Object/assign (js-object) dimension
          (js-object :deduplicatedFrom nil
            :metricsMs (get measurement :metricsMs)
            :samplesMs (get measurement :samplesMs)
            :calibration (get measurement :calibration)))))
          (when (Object/hasOwn measurement "preparedCompiler")
            (put result :preparedCompiler (get measurement :preparedCompiler)))
          result))
      (catch error
        (js-call failures :push (js-object :dimension (get dimension :id) :error error))
        (Object/assign (js-object) dimension (js-object :status "failed" :metricsMs nil)))))

  (defun validateVersionComparisonAcceptance (report)
    (validateVersionComparisonReport report)
    (let ((failures (js-array)) (index 0)
          (results (get report :results)))
      (while (< index (js-length VERSION_COMPARISON_WORKLOADS))
        (let* ((workload (aref VERSION_COMPARISON_WORKLOADS index))
               (id (get workload :id))
               (latest (get (get (get results :latest) :metricsMs) id))
               (emacs (get (get (get results :emacsLisp) :metricsMs) id)))
          (unless (< latest emacs)
            (js-call failures :push (str id ": latest " latest "ms does not outperform native Emacs Lisp " emacs "ms")))
          (js-call (js-array "previousMajor" "previousMinor") :forEach
            (lambda (dimension)
              (let ((baseline (get results dimension)))
                (when (and (= (get baseline :status) "active")
                           (> latest (get (get baseline :metricsMs) id)))
                  (js-call failures :push (str id ": latest " latest "ms regresses against " dimension " " (get (get baseline :metricsMs) id) "ms")))))))
        (setq index (1+ index)))
      (when (> (js-length failures) 0)
        (let ((error (new globalThis.Error (str "release performance acceptance failed\n"
                       (js-call failures :join "\n")))))
          (put error :results results)
          (throw error)))
      report))

  (defasync runVersionComparisonBenchmark (&optional rawOptions)
    (let* ((options (nullish rawOptions (js-object)))
           (targetRoot (js-call path :resolve (nullish (get options :root) projectDirectory)))
           (pkg (JSON/parse (await (readFile (js-call path :join targetRoot "package.json") "utf8"))))
           (currentVersion (nullish (get options :currentVersion) (get pkg :version)))
           (releasedTags
             (if (not (eq (get options :releasedTags) undefined))
               (get options :releasedTags)
               (await (discoverReleasedTags targetRoot))))
           (emacsVersion
             (if (not (eq (get options :emacsVersion) undefined))
               (get options :emacsVersion)
               (await (detectEmacsVersion))))
           (matrix (resolveVersionComparisonMatrix
                     (js-object
                       :currentVersion currentVersion
                       :releasedTags releasedTags
                       :emacsVersion emacsVersion)))
           (measureEmacs (nullish (get options :measureEmacsLisp) defaultMeasureEmacsLisp))
           (measureTarget
             (nullish (get options :measureEliscriptTarget)
               (lambda (target) (defaultMeasureEliscriptTarget target targetRoot))))
           (results (js-object)) (failures (js-array)))
      (put results :emacsLisp
        (await (measure-comparison-dimension (get matrix :emacsLisp) measureEmacs failures)))
      (if (= (get (get matrix :previousMinor) :status) "active")
        (put results :previousMinor
          (await (measure-comparison-dimension (get matrix :previousMinor) measureTarget failures)))
        (put results :previousMinor
          (Object/assign (js-object) (get matrix :previousMinor)
            (js-object :deduplicatedFrom nil :metricsMs nil))))
      (if (= (get (get matrix :previousMajor) :status) "active")
        (if (get (get matrix :previousMajor) :sameAsPreviousMinor)
          (put results :previousMajor
            (Object/assign (js-object) (get matrix :previousMajor)
              (js-object
                :deduplicatedFrom "previousMinor"
                :status (get (get results :previousMinor) :status)
                :metricsMs (if (eq (get (get results :previousMinor) :metricsMs) nil) nil
                  (Object/assign (js-object) (get (get results :previousMinor) :metricsMs))))))
          (put results :previousMajor
            (await (measure-comparison-dimension (get matrix :previousMajor) measureTarget failures))))
        (put results :previousMajor
          (Object/assign (js-object) (get matrix :previousMajor)
            (js-object :deduplicatedFrom nil :metricsMs nil))))
      (put results :latest
        (await (measure-comparison-dimension (get matrix :latest) measureTarget failures)))
      (when (and (get (get matrix :previousMajor) :sameAsPreviousMinor)
                 (Object/hasOwn (get results :previousMinor) "samplesMs"))
        (put (get results :previousMajor) :samplesMs (get (get results :previousMinor) :samplesMs)))
      (when (and (get (get matrix :previousMajor) :sameAsPreviousMinor)
                 (Object/hasOwn (get results :previousMinor) "calibration"))
        (put (get results :previousMajor) :calibration (get (get results :previousMinor) :calibration)))
      (when (> (js-length failures) 0)
        (let ((error (new globalThis.AggregateError
                (js-call failures :map (lambda (failure) (get failure :error)))
                (str "version comparison measurements failed: "
                  (js-call (js-call failures :map (lambda (failure) (get failure :dimension))) :join ", ")))))
          (put error :results results) (put error :matrix matrix)
          (throw error)))
      (let ((report
              (js-object
                :format VERSION_COMPARISON_FORMAT
                :version VERSION_COMPARISON_VERSION
                :generatedAt (js-call (new globalThis.Date) :toISOString)
                :host (js-object
                        :platform (get process :platform)
                        :architecture (get process :arch)
                        :operatingSystem (str (js-call os :type) " " (js-call os :release))
                        :bunVersion (get globalThis.Bun :version)
                        :emacsVersion emacsVersion)
                :matrix matrix
                :workloads VERSION_COMPARISON_WORKLOADS
                :results results
                :comparisons (buildSpeedupComparisons results))))
        (validateVersionComparisonReport report))))

  (defun formatMs (value)
    (if (or (eq value nil) (eq value undefined))
      "N/A"
      (if (< value 0.01)
        (str (js-call (* value 1000) :toFixed 2) " µs (" (js-call value :toFixed 5) " ms)")
        (str (js-call value :toFixed 3) " ms"))))

  (defun formatRatio (ratio)
    (if (or (eq ratio nil) (eq ratio undefined))
      "N/A"
      (str (js-call ratio :toFixed 2) "x")))

  (defun dimensionHeader (dim)
    (let ((id (get dim :id))
          (status (get dim :status))
          (tag (get dim :tag)))
      (cond
        ((= id "emacsLisp")
         (str "1. Emacs Lisp (" (get dim :version) ", 当前最新版)"))
        ((= id "previousMajor")
         (if (= status "absent")
           "2. 上一个大版本 (不存在 / N/A)"
           (if (get dim :sameAsPreviousMinor)
             (str "2. 上一个大版本 (" tag ", 同上一小版本)")
             (str "2. 上一个大版本 (" tag ")"))))
        ((= id "previousMinor")
         (if (= status "absent")
           "3. 上一个最近的小版本 (首个版本 / N/A)"
           (str "3. 上一个最近的小版本 (" tag ")")))
        (t
         (str "4. 最新版 (" tag ")")))))

  (defun renderVersionComparisonMarkdown (report)
    (validateVersionComparisonReport report)
    (let* ((matrix (get report :matrix))
           (results (get report :results))
           (comparisons (get report :comparisons))
           (host (get report :host))
           (emacsDim (get matrix :emacsLisp))
           (majorDim (get matrix :previousMajor))
           (minorDim (get matrix :previousMinor))
           (latestDim (get matrix :latest))
           (majorReasonText
             (if (= (get majorDim :status) "absent")
               "当前尚无上一大版本 (`no-prior-major-release`)"
               (if (get majorDim :sameAsPreviousMinor)
                 "与上一个最近的小版本相同，复用采样结果 (`same-as-previous-minor`)"
                 "已解析上一大版本最新标签")))
           (minorReasonText
             (if (= (get minorDim :status) "absent")
               "当前为首个版本，无上一小版本 (`initial-release`)"
               "已解析最近上一发布版本"))
           (lines
             (js-array
               "# Eliscript 四维版本与原生 Emacs Lisp 性能对比报告"
               ""
               (str "- **生成时间**: `" (get report :generatedAt) "`")
               (str "- **运行环境**: `" (get host :operatingSystem) " (" (get host :platform) "/" (get host :architecture) ")`, Bun `" (get host :bunVersion) "`, Emacs `" (get host :emacsVersion) "`")
               ""
               "## 对比维度状态"
               ""
               "| 维度 | 状态 | 版本 / 标签 | 边界说明 |"
               "| --- | --- | --- | --- |"
               (str "| **1. Emacs Lisp** | `" (get emacsDim :status) "` | `Emacs " (get emacsDim :version) "` | 仅考虑当前宿主最新版 Emacs Lisp (`" (get emacsDim :mode) "`) |")
               (str "| **2. 上一个大版本** | `" (get majorDim :status) "` | `" (nullish (get majorDim :tag) "N/A") "` | " majorReasonText " |")
               (str "| **3. 上一个最近的小版本** | `" (get minorDim :status) "` | `" (nullish (get minorDim :tag) "N/A") "` | " minorReasonText " |")
               (str "| **4. 最新版** | `" (get latestDim :status) "` | `" (get latestDim :tag) "` | 当前工作区最新版本 |")
               ""
               "## 基准工作负载四维耗时与加速比"
               ""
               (str "| 工作负载 | " (dimensionHeader emacsDim) " | " (dimensionHeader majorDim) " | " (dimensionHeader minorDim) " | " (dimensionHeader latestDim) " | 最新版 vs Emacs Lisp | 最新版 vs 上一大版本 | 最新版 vs 上一小版本 |")
               "| --- | --- | --- | --- | --- | --- | --- | --- |"))
           (wIdx 0))
      (while (< wIdx (js-length VERSION_COMPARISON_WORKLOADS))
        (let* ((workload (aref VERSION_COMPARISON_WORKLOADS wIdx))
               (id (get workload :id))
               (elMetrics (get (get results :emacsLisp) :metricsMs))
               (majMetrics (get (get results :previousMajor) :metricsMs))
               (minMetrics (get (get results :previousMinor) :metricsMs))
               (latMetrics (get (get results :latest) :metricsMs))
               (elMs (if elMetrics (nullish (get elMetrics id) nil) nil))
               (majMs (if majMetrics (nullish (get majMetrics id) nil) nil))
               (minMs (if minMetrics (nullish (get minMetrics id) nil) nil))
               (latMs (if latMetrics (nullish (get latMetrics id) nil) nil))
               (cmp (nullish (get comparisons id) (js-object))))
          (js-call lines :push
            (str "| **" (get workload :label) "** | "
                 (formatMs elMs) " | "
                 (formatMs majMs) " | "
                 (formatMs minMs) " | **"
                 (formatMs latMs) "** | **"
                 (formatRatio (get cmp :latestVsEmacsLisp)) "** | "
                 (formatRatio (get cmp :latestVsPreviousMajor)) " | **"
                 (formatRatio (get cmp :latestVsPreviousMinor)) "** |")))
        (setq wIdx (1+ wIdx)))
      (js-call lines :push "")
      (js-call lines :push "All raw samples are retained in acquisition order to diagnose timing variation. Both drivers calibrate batches to at least 1ms before collecting samples. Overlapping ranges do not waive a slower median: every latest median must improve over Emacs and must not regress against an active prior version.")
      (js-call lines :push "")
      (js-call lines :push "| Dimension | Workload | Samples (ms per operation, acquisition order) |")
      (js-call lines :push "| --- | --- | --- |")
      (js-call VERSION_COMPARISON_DIMENSIONS :forEach
        (lambda (dimension)
          (let ((result (get results dimension)))
            (when (and (= (get result :status) "active") (Object/hasOwn result "samplesMs"))
              (js-call VERSION_COMPARISON_WORKLOADS :forEach
                (lambda (workload)
                  (let* ((id (get workload :id)) (samples (get (get result :samplesMs) id)))
                    (js-call lines :push (str "| " dimension " | " id " | " (js-call samples :join ", ") " |")))))))))
      (js-call lines :push "")
      (when (js-call VERSION_COMPARISON_DIMENSIONS :some
        (lambda (dimension) (Object/hasOwn (get results dimension) "calibration")))
        (js-call lines :push "| Dimension | Workload | Minimum calls | Calls per batch | Calibration batches (ms) |")
        (js-call lines :push "| --- | --- | --- | --- | --- |")
        (js-call VERSION_COMPARISON_DIMENSIONS :forEach
          (lambda (dimension)
            (let ((result (get results dimension)))
              (when (and (= (get result :status) "active") (Object/hasOwn result "calibration"))
                (js-call VERSION_COMPARISON_WORKLOADS :forEach
                  (lambda (workload)
                    (let* ((id (get workload :id)) (calibration (get (get result :calibration) id)))
                      (js-call lines :push (str "| " dimension " | " id " | "
                        (get calibration :minimumIterations) " | " (get calibration :iterationsPerBatch)
                        " | " (js-call (get calibration :batchMs) :join ", ") " |")))))))))
        (js-call lines :push ""))
      (js-call lines :join "\n")))

  (defun renderReleaseNotesSummary (report)
    (validateVersionComparisonReport report)
    (let* ((matrix (get report :matrix))
           (results (get report :results))
           (comparisons (get report :comparisons))
           (version (get (get matrix :latest) :version))
           (mdFile (str "eliscript-" version "-benchmark-report.md"))
           (jsonFile (str "eliscript-" version "-benchmark-report.json"))
           (lines
             (js-array
               "## 测试与四维性能基准摘要"
               ""
               (str "- **对比维度**: `Emacs " (get (get matrix :emacsLisp) :version) "` (当前最新版) | 上一个大版本: `" (nullish (get (get matrix :previousMajor) :tag) "N/A (尚无上一大版本)") "` | 上一个最近的小版本: `" (nullish (get (get matrix :previousMinor) :tag) "N/A (首个版本)") "` | 最新版: `" (get (get matrix :latest) :tag) "`")
               (str "- **完整测试与基准报告附件**: 详见 Release 附件 `" mdFile "` 与 `" jsonFile "`")
               ""
               "| 基准工作负载 | 最新版耗时 | vs Emacs Lisp | vs 上一大版本 | vs 上一小版本 |"
               "| --- | --- | --- | --- | --- |"))
           (wIdx 0))
      (while (< wIdx (js-length VERSION_COMPARISON_WORKLOADS))
        (let* ((workload (aref VERSION_COMPARISON_WORKLOADS wIdx))
               (id (get workload :id))
               (latMetrics (get (get results :latest) :metricsMs))
               (latMs (if latMetrics (nullish (get latMetrics id) nil) nil))
               (cmp (nullish (get comparisons id) (js-object))))
          (js-call lines :push
            (str "| **" (get workload :label) "** | **"
                 (formatMs latMs) "** | **"
                 (formatRatio (get cmp :latestVsEmacsLisp)) "** | "
                 (formatRatio (get cmp :latestVsPreviousMajor)) " | **"
                 (formatRatio (get cmp :latestVsPreviousMinor)) "** |")))
        (setq wIdx (1+ wIdx)))
      (js-call lines :push "")
      (js-call lines :join "\n")))

  (defun mergeReleaseNotesWithSummary (existingNotes summaryMarkdown)
    (let ((cleanSummary (js-call (globalThis.String (nullish summaryMarkdown "")) :trim))
          (rawNotes (js-call (globalThis.String (nullish existingNotes "")) :trim)))
      (if (= (js-length rawNotes) 0)
        (str cleanSummary "\n")
        (let* ((heading "## 测试与四维性能基准摘要")
               (idx (js-call rawNotes :indexOf heading)))
          (if (= idx -1)
            (str rawNotes "\n\n" cleanSummary "\n")
            (let* ((prefix (js-call (js-call rawNotes :slice 0 idx) :trim))
                   (remainder (js-call rawNotes :slice (+ idx (js-length heading))))
                   (nextSectionMatch (js-call (new globalThis.RegExp "\\n##\\s+" "u") :exec remainder))
                   (suffix (if nextSectionMatch
                             (js-call (js-call remainder :slice (get nextSectionMatch :index)) :trim)
                             ""))
                   (parts (js-array)))
              (when (> (js-length prefix) 0) (js-call parts :push prefix))
              (when (> (js-length cleanSummary) 0) (js-call parts :push cleanSummary))
              (when (> (js-length suffix) 0) (js-call parts :push suffix))
              (str (js-call parts :join "\n\n") "\n")))))))

  (defasync writeReleaseComparisonBundle (report releaseDir &optional rawOptions)
    (validateVersionComparisonReport report)
    (let* ((options (nullish rawOptions (js-object)))
           (resolvedDir (js-call path :resolve releaseDir))
           (version (get (get (get report :matrix) :latest) :version))
           (summaryPath (js-call path :join resolvedDir "release-summary.md"))
           (mergedNotesPath (js-call path :join resolvedDir "release-notes-merged.md"))
           (markdownPath (js-call path :join resolvedDir (str "eliscript-" version "-benchmark-report.md")))
           (jsonPath (js-call path :join resolvedDir (str "eliscript-" version "-benchmark-report.json")))
           (summaryMarkdown (renderReleaseNotesSummary report))
           (existingNotes
             (if (not (eq (get options :existingNotes) undefined))
               (get options :existingNotes)
               (if (get options :mergeNotesPath)
                 (try
                   (await (readFile (js-call path :resolve (get options :mergeNotesPath)) "utf8"))
                   (catch error ""))
                 "")))
           (mergedNotes (mergeReleaseNotesWithSummary existingNotes summaryMarkdown)))
      (await (mkdir resolvedDir (js-object :recursive t)))
      (await (writeFile summaryPath summaryMarkdown))
      (await (writeFile mergedNotesPath mergedNotes))
      (await (writeFile markdownPath (renderVersionComparisonMarkdown report)))
      (await (writeFile jsonPath (str (JSON/stringify report nil 2) "\n")))
      (js-object
        :summaryPath summaryPath
        :mergedNotesPath mergedNotesPath
        :markdownPath markdownPath
        :jsonPath jsonPath)))

  (defun parseCliArgs (argv)
    (let ((format "markdown")
          (output nil)
          (releaseDir nil)
          (mergeNotesPath nil)
          (i 0))
      (while (< i (js-length argv))
        (let ((arg (aref argv i)))
          (cond
            ((= arg "--format")
             (setq i (1+ i))
             (setq format (nullish (aref argv i) "markdown")))
            ((= arg "--json")
             (setq format "json"))
            ((= arg "--markdown")
             (setq format "markdown"))
            ((= arg "--release-summary")
             (setq format "release-summary"))
            ((= arg "--output")
             (setq i (1+ i))
             (setq output (aref argv i))
             (unless output
               (throw (new globalThis.TypeError "--output requires a file path"))))
            ((= arg "--release-dir")
             (setq i (1+ i))
             (setq releaseDir (aref argv i))
             (unless releaseDir
               (throw (new globalThis.TypeError "--release-dir requires a directory path"))))
            ((= arg "--merge-notes")
             (setq i (1+ i))
             (setq mergeNotesPath (aref argv i))
             (unless mergeNotesPath
               (throw (new globalThis.TypeError "--merge-notes requires a file path"))))
            (t
             (throw (new globalThis.TypeError (str "unknown argument: " arg))))))
        (setq i (1+ i)))
      (js-object
        :format format
        :output output
        :releaseDir releaseDir
        :mergeNotesPath mergeNotesPath)))

  (defasync main ()
    (let* ((parsed (parseCliArgs (js-call (get process :argv) :slice 2)))
           (format (get parsed :format))
           (output (get parsed :output))
           (releaseDir (get parsed :releaseDir))
           (mergeNotesPath (get parsed :mergeNotesPath))
           (report (await (runVersionComparisonBenchmark))))
      ;; Producing positive timings is not the release performance gate.
      ;; Validate actual unrounded measurements before writing release assets.
      (validateVersionComparisonAcceptance report)
      (when releaseDir
        (await (writeReleaseComparisonBundle report releaseDir (js-object :mergeNotesPath mergeNotesPath))))
      (let ((rendered
              (if (= format "json")
                (str (JSON/stringify report nil 2) "\n")
                (if (= format "release-summary")
                  (renderReleaseNotesSummary report)
                  (renderVersionComparisonMarkdown report)))))
        (if output
          (await (writeFile (js-call path :resolve output) rendered))
          (js-call (get process :stdout) :write rendered)))))

  (when (and (> (js-length (get process :argv)) 1)
             (= (js-call path :resolve (aref (get process :argv) 1))
                (js-call path :join projectDirectory "tools/performance/version-comparison.mjs")))
    (js-call (main) :catch (lambda (error)
      (console/error error)
      (when (and (not (nullish? error)) (Object/hasOwn error "results"))
        (console/error (JSON/stringify (get error :results))))
      (put process :exitCode 1))))

  (export
    VERSION_COMPARISON_FORMAT
    VERSION_COMPARISON_VERSION
    VERSION_COMPARISON_DIMENSIONS
    VERSION_COMPARISON_WORKLOADS
    parseSemver
    compareSemver
    resolveVersionComparisonMatrix
    discoverReleasedTags
    detectEmacsVersion
    defaultMeasureEmacsLisp
    measureEliscriptDirectory
    defaultMeasureEliscriptTarget
    validateVersionComparisonReport
    validateVersionComparisonAcceptance
    runVersionComparisonBenchmark
    renderVersionComparisonMarkdown
    renderReleaseNotesSummary
    mergeReleaseNotesWithSummary
    writeReleaseComparisonBundle))
