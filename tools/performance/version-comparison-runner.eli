(module tools.performance.version-comparison-runner
  (import "node:perf_hooks" performance)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:assert/strict" :default assert)
  (defconst load (js* "(specifier) => import(specifier)"))
  ;; One identical timing artifact invokes every version's separately compiled
  ;; workloads. Loop/compiler overhead must not masquerade as library cost.
  (defconst iterations (js-object
    "sequence.first10k" 20000 "sequence.last10k" 200
    "sequence.takeLast10k" 200 "value.equalSameRef10k" 1000
    "order.sort10k" 30 "data.groupBy10k" 30
    "data.frequencies100k" 7 "tree.zipper12k" 3 "worker.scoreValues" 7))

  (defun timed-batch (iterations function)
    (let ((index 0) (start (js-call performance :now)))
      (while (< index iterations) (funcall function) (setq index (1+ index)))
      (- (js-call performance :now) start)))

  (defun bench (iterations function)
    ;; Fixed tiny samples mostly measured JIT tiering and timer resolution.
    ;; Both language drivers warm for 20ms, then take three >=100ms samples.
    ;; Original iteration counts are the minimum batch size, never reduced.
    (let ((warmup 0) (samples (js-array)) (sample 0))
      (while (< warmup 20)
        (setq warmup (+ warmup (timed-batch iterations function))))
      (while (< sample 3)
        (js-call globalThis.Bun :gc t)
        (let ((elapsed 0) (calls 0))
          (while (< elapsed 100)
            (setq elapsed (+ elapsed (timed-batch iterations function)))
            (setq calls (+ calls iterations)))
          (js-call samples :push (/ elapsed calls)))
        (setq sample (1+ sample)))
      (let ((ordered (js-call (js-call samples :slice) :sort (lambda (a b) (- a b)))))
        (js-object :medianMs (aref ordered 1) :samplesMs samples))))


  (defasync runVersionComparisonWorkloads (&optional workloadPath)
    (let* ((specifier (if (nullish? workloadPath)
                        (get (new globalThis.URL "./version-comparison-workloads.mjs" (js* "import.meta.url")) :href)
                        (get (pathToFileURL workloadPath) :href)))
           (module (await (load specifier)))
           (workloads (js-call module :createVersionComparisonWorkloads))
           (ids (Object/keys iterations))
           (metrics (js-object)) (samples (js-object)) (index 0))
      (js-call assert :deepStrictEqual (Object/keys workloads) ids)
      (while (< index (js-length ids))
        (let* ((id (aref ids index))
               (measurement (bench (aref iterations id) (aref workloads id))))
          (put metrics id (get measurement :medianMs))
          (put samples id (get measurement :samplesMs)))
        (setq index (1+ index)))
      (let ((result (js-object :metricsMs metrics :samplesMs samples)))
        (js-call (get process :stdout) :write (str (JSON/stringify result) "\n"))
        result)))
  (when (= (aref (get process :argv) 1) (fileURLToPath (js* "import.meta.url")))
    (runVersionComparisonWorkloads (aref (get process :argv) 2)))
  (export runVersionComparisonWorkloads))
