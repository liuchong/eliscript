(module tools.performance.version-comparison-runner
  (import "node:perf_hooks" performance)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath)
  (import "node:assert/strict" :default assert)
  (import "../../runtime/literals.mjs" vector)
  (import "../../runtime/core/sequence.mjs" first last)
  (import "../../runtime/core/collection.mjs" count)
  (import "../../runtime/core/order.mjs" sort compareValues)
  (import "../../runtime/core/data.mjs" groupBy frequencies)
  (import "../../runtime/core/value.mjs" equalValues)
  (import "../../runtime/core/value-internals.mjs" VALUE_EQUAL)
  (import "../../stdlib/core/seq.mjs" take-last)
  (import "../../stdlib/core/zipper.mjs" vector-zipper down path replace root)

  (defun timed-batch (iterations function)
    (let ((index 0) (start (js-call performance :now)))
      (while (< index iterations) (funcall function) (setq index (1+ index)))
      (- (js-call performance :now) start)))

  (defun bench (iterations function)
    ;; Fixed tiny samples mostly measured JIT tiering and timer resolution.
    ;; Both language drivers warm for 20ms, then take three >=100ms samples.
    ;; Original iteration counts are the minimum batch size, never reduced.
    (let ((warmup 0) (samples (js-array)) (sample 0))
      (while (< warmup 20)
        (setq warmup (+ warmup (timed-batch iterations function))))
      (while (< sample 3)
        (js-call globalThis.Bun :gc t)
        (let ((elapsed 0) (calls 0))
          (while (< elapsed 100)
            (setq elapsed (+ elapsed (timed-batch iterations function)))
            (setq calls (+ calls iterations)))
          (js-call samples :push (/ elapsed calls)))
        (setq sample (1+ sample)))
      (js-call samples :sort (lambda (a b) (- a b)))
      (aref samples 1)))

  (defun score-values (scores)
    (let ((total 0) (round 0))
      (while (< round 10)
        (let ((index 0))
          (while (< index 10000)
            (setq total (% (+ (* total 33) (aref scores index) round) 1000000007))
            (setq index (1+ index))))
        (setq round (1+ round))) total))

  (defun verify-workloads (values shuffled mod-values scores nested)
    (js-call assert :strictEqual (first values) 0)
    (js-call assert :strictEqual (last values) 9999)
    (js-call assert :deepStrictEqual (Array/from (take-last 64 values))
      (Array/from (js-object :length 64) (lambda (_ index) (+ 9936 index))))
    (js-call assert :strictEqual
      (Reflect/apply (get values VALUE_EQUAL) values (js-array values equalValues)) t)
    (js-call assert :strictEqual (compareValues values values) 0)
    (js-call assert :deepStrictEqual (Array/from (sort shuffled))
      (Array/from (js-object :length 10000) (lambda (_ index) index)))
    (let ((groups (groupBy (lambda (value) (% value 100)) values))
          (counts (frequencies mod-values)) (index 0))
      (js-call assert :strictEqual (count groups) 100)
      (js-call assert :deepStrictEqual (Array/from (js-call groups :get 0))
        (Array/from (js-object :length 100) (lambda (_ index) (* index 100))))
      (js-call assert :strictEqual (count counts) 1000)
      (while (< index 1000)
        (js-call assert :strictEqual (js-call counts :get index) 100)
        (setq index (1+ index))))
    (let ((location (vector-zipper nested)) (depth 0))
      (while (< depth 12000) (setq location (down location)) (setq depth (1+ depth)))
      (js-call assert :strictEqual (count (path location)) 12000)
      (let ((rebuilt (root (replace location 42))) (index 0))
        (while (< index 12000) (setq rebuilt (first rebuilt)) (setq index (1+ index)))
        (js-call assert :strictEqual rebuilt 42)))
    (js-call assert :strictEqual (score-values scores) 455649481))

  (defun runVersionComparisonWorkloads ()
    (let* ((size 10000) (items (Array/from (js-object :length size) (lambda (_ index) index)))
           (values (Reflect/apply vector undefined items))
           (shuffled (Reflect/apply vector undefined (Array/from (js-object :length size) (lambda (_ index) (% (* index 7919) size)))))
           (mod-values (Reflect/apply vector undefined (Array/from (js-object :length 100000) (lambda (_ index) (% index 1000)))))
           (scores (js-call globalThis.Int32Array :from (js-object :length 10000) (lambda (_ index) (% index 997))))
           (nested (vector 0)) (index 0))
      (while (< index 12000) (setq nested (vector nested)) (setq index (1+ index)))
      ;; Correctness checks are outside the timed region and run on each
      ;; measured version's actual collection/sequence/zipper implementation.
      (verify-workloads values shuffled mod-values scores nested)
      (let ((metrics (js-object
              "sequence.first10k" (bench 20000 (lambda () (first values)))
              "sequence.last10k" (bench 200 (lambda () (last values)))
              "sequence.takeLast10k" (bench 200 (lambda () (count (take-last 64 values))))
              "value.equalSameRef10k" (bench 1000 (lambda ()
                (Reflect/apply (get values VALUE_EQUAL) values (js-array values equalValues))))
              "order.sort10k" (bench 30 (lambda () (sort shuffled)))
              "data.groupBy10k" (bench 30 (lambda () (groupBy (lambda (value) (% value 100)) values)))
              "data.frequencies100k" (bench 7 (lambda () (frequencies mod-values)))
              "tree.zipper12k" (bench 3 (lambda ()
                (let ((location (vector-zipper nested)) (depth 0))
                  (while (< depth 12000) (setq location (down location)) (setq depth (1+ depth)))
                  (path location)
                  (root (replace location 42)))))
              "worker.scoreValues" (bench 7 (lambda () (score-values scores))))))
        (js-call (get process :stdout) :write (str (JSON/stringify metrics) "\n"))
        metrics)))
  (when (= (aref (get process :argv) 1) (fileURLToPath (js* "import.meta.url")))
    (runVersionComparisonWorkloads))
  (export runVersionComparisonWorkloads))
