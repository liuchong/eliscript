(module tools.performance.version-comparison-runner
  (import "node:perf_hooks" performance)
  (import "node:process" :default process)
  (import "node:url" fileURLToPath)
  (import "../../runtime/literals.mjs" vector)
  (import "../../runtime/core/sequence.mjs" first last)
  (import "../../runtime/core/collection.mjs" count)
  (import "../../runtime/core/order.mjs" sort compareValues)
  (import "../../runtime/core/data.mjs" groupBy frequencies)
  (import "../../runtime/core/value.mjs" equalValues)
  (import "../../runtime/core/value-internals.mjs" VALUE_EQUAL)
  (import "../../stdlib/core/seq.mjs" take-last)
  (import "../../stdlib/core/zipper.mjs" vector-zipper down path replace root)

  (defun bench (iterations function)
    (let ((index 0))
      (while (< index (Math/min 5 iterations)) (funcall function) (setq index (1+ index)))
      (let ((start (js-call performance :now)))
        (setq index 0)
        (while (< index iterations) (funcall function) (setq index (1+ index)))
        (/ (- (js-call performance :now) start) iterations))))

  (defun runVersionComparisonWorkloads ()
    (let* ((size 10000) (items (Array/from (js-object :length size) (lambda (_ index) index)))
           (values (Reflect/apply vector undefined items))
           (shuffled (Reflect/apply vector undefined (Array/from (js-object :length size) (lambda (_ index) (% (* index 7919) size)))))
           (mod-values (Reflect/apply vector undefined (Array/from (js-object :length 100000) (lambda (_ index) (% index 1000)))))
           (scores (js-call globalThis.Int32Array :from (js-object :length 10000) (lambda (_ index) (% index 997))))
           (nested (vector 0)) (index 0))
      (while (< index 12000) (setq nested (vector nested)) (setq index (1+ index)))
      (let ((metrics (js-object
              "sequence.first10k" (bench 20000 (lambda () (first values)))
              "sequence.last10k" (bench 200 (lambda () (last values)))
              "sequence.takeLast10k" (bench 200 (lambda () (count (take-last 64 values))))
              "value.equalSameRef10k" (bench 1000 (lambda ()
                (and (Reflect/apply (get values VALUE_EQUAL) values (js-array values equalValues)) (= (compareValues values values) 0))))
              "order.sort10k" (bench 30 (lambda () (sort shuffled)))
              "data.groupBy10k" (bench 30 (lambda () (groupBy (lambda (value) (% value 100)) values)))
              "data.frequencies100k" (bench 7 (lambda () (frequencies mod-values)))
              "tree.zipper12k" (bench 3 (lambda ()
                (let ((location (vector-zipper nested)) (depth 0))
                  (while (< depth 12000) (setq location (down location)) (setq depth (1+ depth)))
                  (path location)
                  (root (replace location 42)))))
              "worker.scoreValues" (bench 7 (lambda ()
                (let ((total 0) (round 0))
                  (while (< round 10)
                    (let ((index 0))
                      (while (< index 10000)
                        (setq total (% (+ (* total 33) (aref scores index) round) 1000000007))
                        (setq index (1+ index))))
                    (setq round (1+ round))) total))))))
        (js-call (get process :stdout) :write (str (JSON/stringify metrics) "\n"))
        metrics)))
  (when (= (aref (get process :argv) 1) (fileURLToPath (js* "import.meta.url")))
    (runVersionComparisonWorkloads))
  (export runVersionComparisonWorkloads))
