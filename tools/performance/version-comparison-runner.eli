(module tools.performance.version-comparison-runner
  (import "node:fs" readFileSync)
  (import "node:perf_hooks" performance)
  (import "node:process" :default process)
  (import "node:child_process" spawnSync)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:assert/strict" :default assert)
  (defconst load (js* "(specifier) => import(specifier)"))
  (defconst module-url (js* "import.meta.url"))
  (defconst default-workload-url (js* "new URL(\"./version-comparison-workloads.mjs\", import.meta.url)"))
  ;; One identical timing artifact invokes every version's separately compiled
  ;; workloads. Loop/compiler overhead must not masquerade as library cost.
  ;; Minimal batch sizes live in one Git-declared input shared with the native
  ;; driver and report validation.
  (defconst minimumIterations
    (JSON/parse
      (readFileSync
        (new globalThis.URL "./version-comparison-minima.json" (js* "import.meta.url"))
        "utf8")))
  (js-call (Object/keys minimumIterations) :forEach (lambda (id)
    (let ((value (get minimumIterations id)))
      (unless (and (Number/isSafeInteger value) (> value 0))
        (throw (new globalThis.TypeError (str "invalid benchmark minimum for " id)))))))
  (defconst maximumIterations 16777216)
  (defun or-null (value fallback) (if (nullish? value) fallback value))
  ;; One workload normally finishes well under 2s; a 10s ceiling keeps a
  ;; runaway worker bounded while all nine (90s worst case) stay inside the
  ;; caller's 120s capture timeout. SIGKILL is required because a tight
  ;; JavaScript loop cannot be relied on to honour SIGTERM.
  (defconst workerTimeout 10000)
  (defconst workerKillSignal "SIGKILL")
  (defun workload-ids () (Object/keys minimumIterations))

  (defun timed-batch (iterations function)
    (let ((index 0) (start (js-call performance :now)))
      (while (< index iterations) (funcall function) (setq index (1+ index)))
      (- (js-call performance :now) start)))

  (defun calibrate-batch (minimum function)
    ;; Aggregate sample duration cannot repair sub-microsecond batch clocks.
    ;; Increase calls until three consecutive batches each span at least 1ms.
    (let ((iterations minimum) (batches (js-array)))
      (while (< (js-length batches) 3)
        (let ((elapsed (timed-batch iterations function)))
          (if (>= elapsed 1)
            (js-call batches :push elapsed)
            (progn
              (when (>= iterations maximumIterations)
                (throw (new globalThis.Error "benchmark batch calibration did not reach 1ms")))
              (setq iterations (Math/min (* iterations 2) maximumIterations)
                    batches (js-array))))))
      (js-object :minimumIterations minimum :iterationsPerBatch iterations :batchMs batches)))

  (defun bench (iterations function)
    ;; Fixed tiny samples mostly measured JIT tiering and timer resolution.
    ;; Both drivers warm for 20ms, calibrate, then take three >=100ms samples.
    ;; Original iteration counts are the minimum batch size, never reduced.
    (let ((warmup 0) (samples (js-array)) (sample 0) (calibration nil))
      (while (< warmup 20)
        (setq warmup (+ warmup (timed-batch iterations function))))
      (setq calibration (calibrate-batch iterations function))
      (setq iterations (get calibration :iterationsPerBatch))
      (while (< sample 3)
        (js-call globalThis.Bun :gc t)
        (let ((elapsed 0) (calls 0))
          (while (< elapsed 100)
            (setq elapsed (+ elapsed (timed-batch iterations function)))
            (setq calls (+ calls iterations)))
          (js-call samples :push (/ elapsed calls)))
        (setq sample (1+ sample)))
      (let ((ordered (js-call (js-call samples :slice) :sort (lambda (a b) (- a b)))))
        (js-object :medianMs (aref ordered 1) :samplesMs samples :calibration calibration))))

  ;; Each workload is measured in its own process with exactly one callee, so
  ;; a shared timing call site cannot leak another workload's shape into the
  ;; measurement. Only the validated single measurement crosses this boundary.
  (defun worker-samples-valid (samples)
    (and (Array/isArray samples)
         (= (js-length samples) 3)
         (js-call (Array/from samples) :every
           (lambda (value) (and (= (value-type value) "number")
                                (Number/isFinite value)
                                (> value 0))))))
  (defun worker-calibration-valid (calibration minimum)
    (and (not (nullish? calibration))
         (= (value-type calibration) "object")
         (Number/isSafeInteger (get calibration :minimumIterations))
         (= (get calibration :minimumIterations) minimum)
         (Number/isSafeInteger (get calibration :iterationsPerBatch))
         (>= (get calibration :iterationsPerBatch) minimum)
         (<= (get calibration :iterationsPerBatch) maximumIterations)
         (Array/isArray (get calibration :batchMs))
         (= (js-length (get calibration :batchMs)) 3)
         (js-call (Array/from (get calibration :batchMs)) :every
           (lambda (value) (and (= (value-type value) "number")
                                (Number/isFinite value)
                                (>= value 1))))))
  (defun validate-worker-measurement (id measurement)
    (let ((minimum (get minimumIterations id)))
      (unless (and (not (nullish? measurement))
                   (= (value-type measurement) "object")
                   (= (get measurement :id) id)
                   (= (value-type (get measurement :medianMs)) "number")
                   (Number/isFinite (get measurement :medianMs))
                   (> (get measurement :medianMs) 0))
        (throw (new globalThis.TypeError (str "invalid worker measurement for " id))))
      (let ((samples (get measurement :samplesMs)))
        (unless (worker-samples-valid samples)
          (throw (new globalThis.TypeError (str "invalid worker samples for " id))))
        (let ((ordered (js-call (js-call samples :slice) :sort (lambda (left right) (- left right)))))
          (unless (= (get measurement :medianMs) (aref ordered 1))
            (throw (new globalThis.TypeError
                     (str "worker median is not the sample median for " id))))))
      (unless (worker-calibration-valid (get measurement :calibration) minimum)
        (throw (new globalThis.TypeError (str "invalid worker calibration for " id))))
      measurement))

  (defun worker-failure (id detail)
    (new globalThis.Error
      (str "benchmark worker failed for " id
        (if (> (js-length detail) 0) (str ": " detail) ""))))
  (defun run-single-worker (workloadPath id)
    (let* ((self (fileURLToPath module-url))
           (child (spawnSync (get process :execPath)
                    (js-array self "--single" workloadPath id)
                    (js-object :encoding "utf8" :timeout workerTimeout
                      :killSignal workerKillSignal
                      :maxBuffer (* 4 1024 1024))))
           (failure (get child :error))
           (stderr (or-null (get child :stderr) "")))
      (when (not (undefined? failure))
        (throw (worker-failure id (globalThis.String (get failure :message)))))
      (unless (= (get child :status) 0)
        (throw (worker-failure id (js-call (js-call stderr :trim) :slice 0 400))))
      (let ((text (js-call (or-null (get child :stdout) "") :trim)))
        (when (= (js-length text) 0)
          (throw (worker-failure id "no measurement")))
        (validate-worker-measurement id (JSON/parse text)))))

  (defasync run-single-workload (workloadPath id)
    (let* ((entries (workload-ids)))
      (unless (js-call entries :includes id)
        (throw (new globalThis.TypeError (str "unknown benchmark workload id: " (globalThis.String id)))))
      (let* ((module (await (load (get (pathToFileURL workloadPath) :href))))
             (workloads (js-call module :createVersionComparisonWorkloads))
             (workload (get workloads id)))
        (js-call assert :deepStrictEqual (Object/keys workloads) entries)
        (unless (= (value-type workload) "function")
          (throw (new globalThis.TypeError (str "missing benchmark workload: " id))))
        (let ((measurement (bench (get minimumIterations id) workload)))
          (Object/assign (js-object :id id) measurement)))))

  (defasync collect-isolated-measurements (workloadPath)
    (let ((metrics (js-object)) (samples (js-object)) (calibrations (js-object))
          (failures (js-array)) (ids (workload-ids)) (index 0))
      (while (< index (js-length ids))
        (let ((id (aref ids index)))
          (try
            (let ((measurement (funcall run-single-worker workloadPath id)))
              (put metrics id (get measurement :medianMs))
              (put samples id (get measurement :samplesMs))
              (put calibrations id (get measurement :calibration)))
            (catch error
              (js-call failures :push (js-object :id id :error error)))))
        (setq index (1+ index)))
      (when (> (js-length failures) 0)
        (let ((error (new globalThis.AggregateError
                       (js-call failures :map (lambda (failure) (get failure :error)))
                       (str "benchmark workers failed: "
                         (js-call (js-call failures :map (lambda (failure) (get failure :id))) :join ", ")))))
          (put error :failures failures)
          (throw error)))
      (js-object :metricsMs metrics :samplesMs samples :calibration calibrations)))

  (defasync runVectorSliceDiagnostics (workloadPath)
    (let* ((module (await (load (get (pathToFileURL workloadPath) :href))))
           (workloads (js-call module :createVectorSliceDiagnostics))
           (measurements (js-array)) (index 0))
      (while (< index (js-length workloads))
        (let ((workload (aref workloads index)))
          (try
            (unless (undefined? (get workload :before)) (js-call workload :before))
            (js-call workload :run)
            (js-call workload :verify)
            (let ((measurement (bench 200 (get workload :run))))
              (js-call workload :verify)
              (js-call measurements :push (Object/assign (js-object :id (get workload :id)) measurement)))
            (finally (unless (undefined? (get workload :after)) (js-call workload :after)))))
        (setq index (1+ index)))
      (let ((result (js-object :scope "diagnostic-not-release-acceptance" :measurements measurements)))
        (js-call (get process :stdout) :write (str (JSON/stringify result) "\n")) result)))

  (defasync runVersionComparisonWorkloads (&optional workloadPath)
    (let* ((specifier (if (nullish? workloadPath)
                        (get (new globalThis.URL "./version-comparison-workloads.mjs" (js* "import.meta.url")) :href)
                        (get (pathToFileURL workloadPath) :href)))
           (target (if (nullish? workloadPath)
                     (fileURLToPath default-workload-url)
                     workloadPath))
           (result (await (collect-isolated-measurements target))))
      (js-call (get process :stdout) :write (str (JSON/stringify result) "\n"))
      result))

  (defasync runSingleWorkloadToStdout (workloadPath id)
    (let ((measurement (await (run-single-workload workloadPath id))))
      (js-call (get process :stdout) :write (str (JSON/stringify measurement) "\n")) measurement))

  (defasync runnerMain ()
    (let ((mode (aref (get process :argv) 2)))
      (if (= mode "--vector-diagnostics")
        (await (runVectorSliceDiagnostics (aref (get process :argv) 3)))
        (if (= mode "--single")
          (await (runSingleWorkloadToStdout (aref (get process :argv) 3) (aref (get process :argv) 4)))
          (await (runVersionComparisonWorkloads (aref (get process :argv) 2)))))))

  (defun self-path () (fileURLToPath module-url))
  (when (= (aref (get process :argv) 1) (self-path)) (runnerMain))
  (export runVersionComparisonWorkloads runVectorSliceDiagnostics run-single-workload))
