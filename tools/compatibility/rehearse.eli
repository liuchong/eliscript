(module tools.compatibility.rehearse
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve)
  (import "../backends/build.mjs" root)
  (import "./rehearse-ground.mjs" :as ground)
  (defconst CompatibilityRehearsalError (get ground :CompatibilityRehearsalError))
  (defconst checkCompatibilityRehearsal (get ground :checkCompatibilityRehearsal))
  (defconst runCompatibilityRehearsal (get ground :runCompatibilityRehearsal))
  (defun humanCompatibilityReport (report)
    ;; Version 1's recorded format used this historical category name. A
    ;; vocabulary cleanup must not rewrite an authenticated measurement or
    ;; make its exact original Markdown fail verification.
    (let ((text (js-call ground :humanCompatibilityReport report)))
      (js-call (get report :cases) :forEach (lambda (entry)
        (when (and (= (get entry :kind) "source-rewrite") (nullish? (get entry :error)))
          (let ((prefix (str "| " (get entry :id) " | " (get entry :kind) " | " (get entry :status)
                    " | " (get entry :durationMs) " | " (js-length (get entry :diagnostics))))
                (suffix (str " diagnostics; " (js-length (get entry :executions)) " migrated executions |")))
            (setq text (js-call text :replace (str prefix " ground" suffix) (str prefix " legacy" suffix))))))) text))
  (defasync verifyCompatibilityRun (options)
    (let* ((report (await (js-call ground :verifyCompatibilityRun
                    (Object/assign (js-object) options (js-object :markdownFile undefined)))))
           (file (get options :markdownFile)))
      ;; All original commit/tree/ancestor, contract, artifact and measurement
      ;; checks above stay strict. Only the versioned text projection lives here.
      (when file
        (unless (= (await (readFile (resolve (get options :root root) file) "utf8")) (humanCompatibilityReport report))
          (throw (new CompatibilityRehearsalError (js-array "run Markdown does not match generated report"))))) report))
  (defasync main (arguments)
    (let ((options (js-object)) (index 0))
      (while (< index (js-length arguments))
        (let ((argument (aref arguments index)))
          (if (= argument "--run") (put options :run t)
            (let ((key (get (js-object "--json-output" "jsonOutput" "--markdown-output" "markdownOutput"
                       "--verify-run" "verifyRun" "--verify-markdown" "verifyMarkdown") argument)))
              (unless key (throw (new globalThis.Error (str "unknown argument: " argument))))
              (setq index (1+ index)) (put options key (aref arguments index)))))
        (setq index (1+ index)))
      (cond
        ((get options :run)
          (unless (and (get options :jsonOutput) (get options :markdownOutput))
            (throw (new globalThis.Error "--run requires --json-output and --markdown-output")))
          (let ((report (await (runCompatibilityRehearsal (js-object :root root)))))
            (await (writeFile (resolve root (get options :jsonOutput)) (str (JSON/stringify report nil 2) "\n")))
            (await (writeFile (resolve root (get options :markdownOutput)) (humanCompatibilityReport report)))
            (console/log (js-call (humanCompatibilityReport report) :trimEnd))
            (unless (get (get report :summary) :validationPass) (put globalThis.process :exitCode 1))))
        ((get options :verifyRun)
          (let* ((report (await (verifyCompatibilityRun (js-object :root root :runFile (get options :verifyRun)
                            :markdownFile (get options :verifyMarkdown))))) (summary (get report :summary)))
            (console/log (str "Compatibility rehearsal verified: " (get summary :passed) "/" (get summary :required)
              " cases passed locally; AC-02 remains open."))))
        (t (console/log (JSON/stringify (await (checkCompatibilityRehearsal (js-object :root root))) nil 2))))))
  (when (= (resolve (or (aref (get globalThis.process :argv) 1) ".")) (resolve root "tools/compatibility/rehearse.mjs"))
    (js-call (main (js-call (get globalThis.process :argv) :slice 2)) :catch (lambda (error)
      (console/error (get error :message)) (put globalThis.process :exitCode 1))))
  (export CompatibilityRehearsalError checkCompatibilityRehearsal runCompatibilityRehearsal humanCompatibilityReport verifyCompatibilityRun))
