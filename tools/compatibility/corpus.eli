(module tools.compatibility.corpus
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)
  (import "../conformance/check.mjs" checkContracts)
  (import "./rehearse.mjs" checkCompatibilityRehearsal)

  (defconst module-directory (js-call path :dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst DEFAULT_ROOT (js-call path :resolve module-directory "../.."))
  (defconst CONTRACT_FILE "contracts/stable-compatibility-corpus.json")
  (defconst execution
    (js-call globalThis.Object :freeze
      (js-object :provider "local" :command "make test-core" :applicationEvidence false)))
  (defconst deferred-fixtures (js-call globalThis.Object :freeze (js-array)))
  (defconst identity-sources
    (js-call globalThis.Object :freeze
      (js-array "Makefile" "contracts/compatibility-baseline.json" "contracts/compatibility-rehearsal.json"
        "contracts/maturity-progress.json" "specs/0147-complete-stable-compatibility-corpus.md" "specs/index.json"
        "tests/conformance/manifest.json" "tests/stable-compatibility-corpus.test.mjs" "tools/compatibility/corpus.mjs")))

  (defun corpus-error-message (errors)
    (str "stable compatibility corpus validation failed:\n- " (js-call errors :join "\n- ")))

  (defun corpus-error-fields (self errors)
    (put self :name "StableCompatibilityCorpusError")
    (put self :errors errors)
    self)

  (defconst StableCompatibilityCorpusError
    (funcall
      (js* "(message, fields) => class StableCompatibilityCorpusError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      corpus-error-message corpus-error-fields))

  (defun host-type (value) (funcall (js* "(value) => typeof value") value))
  (defun host-truthy (value) (funcall (js* "(value) => !!value") value))
  (defun host-get (value key) (if (nullish? value) undefined (get value key)))
  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-object) (aref supplied 0)))
  (defun present (value key)
    (let ((item (host-get value key))) (if (nullish? item) (js-array) item)))
  (defun json-equal (left right) (= (JSON/stringify left) (JSON/stringify right)))
  (defun plain-object? (value)
    (and (not (nil? value)) (= (host-type value) "object") (not (Array/isArray value))))
  (defun sha256 (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))

  (defasync read-json (root relative)
    (JSON/parse (await (readFile (js-call path :join root relative) "utf8"))))

  (defun safe-source-path (root relative)
    (let ((absolute (js-call path :resolve root relative))
          (prefix (str (js-call path :resolve root) (get path :sep))))
      (unless (js-call absolute :startsWith prefix)
        (throw (new globalThis.Error (str "source escapes repository root: " relative))))
      absolute))

  (defasync tracked-fixture-files (root)
    (let* ((child (globalThis.Bun.spawn (js-array "git" "ls-files" "-z" "--" "tests/fixtures")
                    (js-object :cwd root :stdin "ignore" :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                  (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (trimmed (js-call (aref result 2) :trim)))
      (unless (= (aref result 0) 0)
        (throw (new globalThis.Error (if (host-truthy trimmed) trimmed "git ls-files tests/fixtures failed"))))
      (js-call (Array/from (new globalThis.Set
                            (js-call (js-call (aref result 1) :split "\u0000") :filter host-truthy)))
        :sort)))

  (defasync source-digests (root files errors)
    (let ((result (js-array)) (index 0))
      (while (< index (js-length files))
        (let ((relative (aref files index)))
          (try
            (js-call result :push (js-object :file relative
                                     :sha256 (sha256 (await (readFile (safe-source-path root relative))))))
            (catch error
              (js-call errors :push (str "identity source " relative " could not be read: " (get error :message))))))
        (setq index (1+ index)))
      result))

  (defun add-all (target values)
    (let ((index 0))
      (while (< index (js-length values))
        (js-call target :add (aref values index))
        (setq index (1+ index)))))

  (defasync derive-corpus (root)
    (let ((errors (js-array)))
      (try (await (checkContracts (js-object :root root)))
        (catch error (js-call errors :push (str "conformance contracts must pass: " (get error :message)))))
      (try (await (checkCompatibilityRehearsal (js-object :root root)))
        (catch error (js-call errors :push (str "compatibility rehearsal contract must pass: " (get error :message)))))
      (let* ((baseline (await (read-json root "contracts/compatibility-baseline.json")))
             (rehearsal (await (read-json root "contracts/compatibility-rehearsal.json")))
             (maturity (await (read-json root "contracts/maturity-progress.json")))
             (manifest (await (read-json root "tests/conformance/manifest.json")))
             (specification-index (await (read-json root "specs/index.json")))
             (excluded-ids (Array/from (present (host-get maturity "stabilization") "excludedFeatureIds")))
             (excluded (new globalThis.Set excluded-ids))
             (stable-features (js-call (present (host-get baseline "features") "stable") :filter
                                (lambda (id) (not (js-call excluded :has id)))))
             (provisional-features (js-call (present (host-get baseline "features") "provisional") :filter
                                     (lambda (id) (not (js-call excluded :has id)))))
             (features (new globalThis.Map (js-call (Array/from (present manifest "features")) :map
                                              (lambda (feature) (js-array (get feature :id) feature)))))
             (specifications (new globalThis.Map (js-call (Array/from (present specification-index "specifications")) :map
                                                    (lambda (specification) (js-array (get specification :id) (get specification :file))))))
             (stable-specs (js-array))
             (evidence (js-array))
             (index 0))
        (while (< index (js-length stable-features))
          (let* ((feature-id (aref stable-features index))
                 (feature (js-call features :get feature-id)))
            (if (or (not feature) (not (= (get feature :status) "stable")))
              (js-call errors :push (str "stable core feature " feature-id " must be stable in conformance data"))
              (progn
                (js-call stable-specs :push (get feature :spec))
                (let ((locators (present feature "evidence")) (cursor 0))
                  (while (< cursor (js-length locators))
                    (js-call evidence :push (js-call globalThis.Object :assign
                                              (js-object :featureId feature-id) (aref locators cursor)))
                    (setq cursor (1+ cursor)))))))
          (setq index (1+ index)))
        (js-call stable-specs :sort)
        (unless (= (get (new globalThis.Set stable-specs) :size) (js-length stable-specs))
          (js-call errors :push "stable core features must have one distinct specification owner each"))
        (let ((stable-baseline (present (host-get baseline "specifications") "stable")))
          (setq index 0)
          (while (< index (js-length stable-specs))
            (unless (js-call stable-baseline :includes (aref stable-specs index))
              (js-call errors :push (str "core specification " (aref stable-specs index) " must be stable in the baseline")))
            (setq index (1+ index))))
        (setq index 0)
        (while (< index (js-length deferred-fixtures))
          (let ((deferred (aref deferred-fixtures index)))
            (unless (js-call provisional-features :includes (get deferred :featureId))
              (js-call errors :push (str "deferred fixture feature " (get deferred :featureId) " must remain provisional"))))
          (setq index (1+ index)))
        (let* ((tracked (await (tracked-fixture-files root)))
               (fixture-files (js-call tracked :filter
                                (lambda (file)
                                  (let ((cursor 0) (blocked nil))
                                    (while (and (not blocked) (< cursor (js-length deferred-fixtures)))
                                      (when (js-call file :startsWith (get (aref deferred-fixtures cursor) :prefix))
                                        (setq blocked t))
                                      (setq cursor (1+ cursor)))
                                    (not blocked)))))
               (migrations (present rehearsal "migrations"))
               (migration-ids (js-call (Array/from migrations) :map (lambda (migration) (get migration :id))))
               (migrated (new globalThis.Set (js-call (Array/from migrations) :map (lambda (migration) (get migration :fromSpec)))))
               (superseded (present (host-get baseline "specifications") "superseded")))
          (setq index 0)
          (while (< index (js-length deferred-fixtures))
            (let ((prefix (get (aref deferred-fixtures index) :prefix)) (cursor 0) (found nil))
              (while (and (not found) (< cursor (js-length tracked)))
                (when (js-call (aref tracked cursor) :startsWith prefix) (setq found t))
                (setq cursor (1+ cursor)))
              (unless found
                (js-call errors :push (str "deferred fixture prefix " prefix " must contain tracked files"))))
            (setq index (1+ index)))
          (setq index 0)
          (while (< index (js-length superseded))
            (unless (js-call migrated :has (aref superseded index))
              (js-call errors :push (str "superseded specification " (aref superseded index) " needs migration evidence")))
            (setq index (1+ index)))
          (let ((evidence-files (js-call (Array/from (new globalThis.Set (js-call evidence :map (lambda (locator) (get locator :file))))) :sort))
                (source-files (new globalThis.Set)))
            (add-all source-files identity-sources)
            (add-all source-files (present rehearsal "sourceFiles"))
            (add-all source-files fixture-files)
            (add-all source-files evidence-files)
            (setq index 0)
            (while (< index (js-length stable-specs))
              (let ((filename (js-call specifications :get (aref stable-specs index))))
                (if (not (= (host-type filename) "string"))
                  (js-call errors :push (str "stable core specification " (aref stable-specs index) " has no indexed file"))
                  (js-call source-files :add filename)))
              (setq index (1+ index)))
            (let* ((ordered (js-call (Array/from source-files) :sort))
                   (sources (await (source-digests root ordered errors)))
                   (ready (= (js-length provisional-features) 0))
                   (derived (js-object :baselineVersion (get baseline :version)
                              :stableCoreSpecificationIds stable-specs
                              :stableCoreFeatureIds stable-features
                              :provisionalCoreFeatureIds provisional-features
                              :excludedApplicationFeatureIds excluded-ids
                              :migrationIds migration-ids
                              :fixtureFiles fixture-files
                              :evidenceLocatorCount (js-length evidence)
                              :evidenceFileCount (js-length evidence-files)
                              :readyForAc02 ready)))
              (js-object :errors errors :derived derived
                :identity (sha256 (JSON/stringify
                                    (js-call globalThis.Object :assign (js-object) derived
                                      (js-object :execution execution :deferredFixtures deferred-fixtures
                                        :evidence evidence :sources sources))))
                :sourceFiles (js-length ordered))))))))

  (defasync inspect-corpus (contract root)
    (let* ((state (await (derive-corpus root)))
           (errors (Array/from (get state :errors)))
           (derived (get state :derived)))
      (when (or (not (plain-object? contract)) (not (= (get contract :schemaVersion) 1))
                (not (= (get contract :format) "eliscript-stable-compatibility-corpus"))
                (not (= (get contract :version) 1)))
        (js-call errors :push "contract must use eliscript-stable-compatibility-corpus version 1"))
      (unless (json-equal (get contract :execution) execution)
        (js-call errors :push "execution must remain direct local make test-core without application evidence"))
      (unless (json-equal (get contract :deferredFixtures) deferred-fixtures)
        (js-call errors :push "deferredFixtures must match the exact provisional fixture boundary"))
      (let ((fields (js-call globalThis.Object :entries derived)) (index 0))
        (while (< index (js-length fields))
          (let ((field (aref (aref fields index) 0)) (expected (aref (aref fields index) 1)))
            (unless (json-equal (get contract field) expected)
              (js-call errors :push (str field " must match the complete derived stable core inventory"))))
          (setq index (1+ index))))
      (unless (and (js-call (new globalThis.RegExp "^[0-9a-f]{64}$" "u") :test (get contract :identity ""))
                   (= (get contract :identity) (get state :identity)))
        (js-call errors :push "identity must bind the complete stable compatibility corpus"))
      (js-object :errors errors :identity (get state :identity)
        :report (js-object :schemaVersion 1
                  :stableSpecifications (js-length (get derived :stableCoreSpecificationIds))
                  :stableFeatures (js-length (get derived :stableCoreFeatureIds))
                  :provisionalFeatures (js-length (get derived :provisionalCoreFeatureIds))
                  :excludedApplicationFeatures (js-length (get derived :excludedApplicationFeatureIds))
                  :migrations (js-length (get derived :migrationIds))
                  :fixtures (js-length (get derived :fixtureFiles))
                  :evidenceLocators (get derived :evidenceLocatorCount)
                  :evidenceFiles (get derived :evidenceFileCount)
                  :sourceFiles (get state :sourceFiles)
                  :readyForAc02 (get derived :readyForAc02)
                  :identity (get state :identity)))))

  (defasync validateStableCompatibilityCorpus (contract &rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (inspected (await (inspect-corpus contract root))))
      (when (> (js-length (get inspected :errors)) 0)
        (throw (new StableCompatibilityCorpusError (get inspected :errors))))
      (get inspected :report)))

  (defasync checkStableCompatibilityCorpus (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract))
                       (await (read-json root CONTRACT_FILE))
                       (get options :contract))))
      (await (validateStableCompatibilityCorpus contract (js-object :root root)))))

  (defasync generateStableCompatibilityCorpus (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (state (await (derive-corpus root))))
      (when (> (js-length (get state :errors)) 0)
        (throw (new StableCompatibilityCorpusError (get state :errors))))
      (let ((contract (js-call globalThis.Object :assign
                        (js-object :schemaVersion 1 :format "eliscript-stable-compatibility-corpus" :version 1
                          :execution execution :deferredFixtures deferred-fixtures)
                        (get state :derived)
                        (js-object :identity (get state :identity)))))
        (await (writeFile (js-call path :join root CONTRACT_FILE) (str (JSON/stringify contract nil 2) "\n")))
        (await (validateStableCompatibilityCorpus contract (js-object :root root))))))

  (defun print-report (report)
    (js-call (get globalThis.process :stdout) :write
      (str "Stable compatibility corpus: " (get report :stableFeatures) " features / "
           (get report :stableSpecifications) " specifications\n"
           "Evidence: " (get report :evidenceLocators) " locators in "
           (get report :evidenceFiles) " files; " (get report :fixtures) " fixtures\n"
           "Migrations: " (get report :migrations) "; provisional: "
           (get report :provisionalFeatures) "; applications excluded: "
           (get report :excludedApplicationFeatures) "\n"
           "AC-02 ready: " (if (host-truthy (get report :readyForAc02)) "yes" "no") "; "
           (get report :sourceFiles) " bound files; identity " (get report :identity) "\n")))

  (when (js* "import.meta.main")
    (let ((generate (js-call (js-call (get globalThis.process :argv) :slice 2) :includes "--generate")))
      (js-call
        (js-call (if generate (generateStableCompatibilityCorpus) (checkStableCompatibilityCorpus))
          :then print-report)
        :catch (lambda (error)
                 (js-call (get globalThis.process :stderr) :write (str (get error :message) "\n"))
                 (put globalThis.process :exitCode 1)))))

  (export DEFAULT_ROOT CONTRACT_FILE StableCompatibilityCorpusError
    validateStableCompatibilityCorpus checkStableCompatibilityCorpus generateStableCompatibilityCorpus))
