(module capsules.tools.integrity.check-legacy
  (js* "import { createHash } from \"node:crypto\";\nimport { mkdtemp, readFile, rm } from \"node:fs/promises\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport process from \"node:process\";\nimport { fileURLToPath, pathToFileURL } from \"node:url\";\n\nimport { checkCompatibilityWorkflow } from \"../ci/render-workflow.mjs\";\nimport { checkBrowserCompatibilityWorkflow } from \"../ci/render-browser-workflow.mjs\";\nimport { generateApiArtifacts } from \"../surface/generate-api.mjs\";\n\nconst moduleDirectory = path.dirname(fileURLToPath(import.meta.url));\nexport const DEFAULT_ROOT = path.resolve(moduleDirectory, \"../..\");\nconst CONTRACT_FILE = \"contracts/repository-integrity.json\";\nconst PACKAGE_SECTIONS = Object.freeze([\n  \"dependencies\",\n  \"devDependencies\",\n  \"optionalDependencies\",\n  \"peerDependencies\",\n]);\n\nexport class RepositoryIntegrityError extends Error {\n  constructor(errors) {\n    super(`repository integrity validation failed:\\n- ${errors.join(\"\\n- \")}`);\n    this.name = \"RepositoryIntegrityError\";\n    this.errors = errors;\n  }\n}\n\nfunction isPlainObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction safeRelativePath(value) {\n  return typeof value === \"string\" && value.length > 0 &&\n    !path.isAbsolute(value) &&\n    !value.split(\"/\").includes(\"..\") &&\n    path.posix.normalize(value) === value;\n}\n\nfunction sortedUnique(values) {\n  return [...new Set(values)].sort();\n}\n\nfunction validRoots(roots) {\n  return Array.isArray(roots) && roots.length > 0 &&\n    roots.every((root) => safeRelativePath(root)) &&\n    JSON.stringify(roots) === JSON.stringify(sortedUnique(roots));\n}\n\nexport function validateIntegrityContract(contract) {\n  const errors = [];\n  if (!isPlainObject(contract) || contract.schemaVersion !== 1 ||\n      contract.format !== \"eliscript-repository-integrity\" ||\n      contract.version !== 1) {\n    throw new RepositoryIntegrityError([\n      \"contract must use eliscript-repository-integrity version 1\",\n    ]);\n  }\n  if (!safeRelativePath(contract.packageManifest) ||\n      !safeRelativePath(contract.lockfile)) {\n    errors.push(\"package manifest and lockfile must be safe relative paths\");\n  }\n\n  const packages = Array.isArray(contract.packages) ? contract.packages : [];\n  if (!Array.isArray(contract.packages) || packages.length === 0) {\n    errors.push(\"packages must be a non-empty array\");\n  }\n  const packageNames = [];\n  for (const [index, entry] of packages.entries()) {\n    const label = `package ${index}`;\n    if (!isPlainObject(entry)) {\n      errors.push(`${label} must be an object`);\n      continue;\n    }\n    packageNames.push(entry.name);\n    if (typeof entry.name !== \"string\" || entry.name.length === 0) {\n      errors.push(`${label} must declare a name`);\n    }\n    if (!/^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$/.test(entry.version ?? \"\")) {\n      errors.push(`${label} must pin an exact semantic version`);\n    }\n    if (!PACKAGE_SECTIONS.includes(entry.section)) {\n      errors.push(`${label} has unsupported package section ${entry.section}`);\n    }\n    if (!validRoots(entry.allowedRoots)) {\n      errors.push(`${label} allowedRoots must be unique sorted path prefixes`);\n    }\n  }\n  if (JSON.stringify(packageNames) !== JSON.stringify(sortedUnique(packageNames))) {\n    errors.push(\"package names must be unique and sorted\");\n  }\n\n  if (!isPlainObject(contract.imports) ||\n      !validRoots(contract.imports.eliscriptSourceRoots) ||\n      !validRoots(contract.imports.coreRoots) ||\n      !validRoots(contract.imports.localPackageRoots)) {\n    errors.push(\n      \"import source, core, and local package roots must be unique sorted path prefixes\",\n    );\n  }\n  const special = Array.isArray(contract.imports?.specialSpecifiers)\n    ? contract.imports.specialSpecifiers\n    : [];\n  const selectors = [];\n  for (const [index, entry] of special.entries()) {\n    const selectorCount = Number(typeof entry?.specifier === \"string\") +\n      Number(typeof entry?.prefix === \"string\");\n    if (!isPlainObject(entry) || selectorCount !== 1 ||\n        !validRoots(entry.allowedRoots)) {\n      errors.push(\n        `special import ${index} must have one selector and sorted allowed roots`,\n      );\n      continue;\n    }\n    const selector = entry.specifier ?? entry.prefix;\n    if (selector.length === 0) {\n      errors.push(`special import ${index} selector must not be empty`);\n    }\n    selectors.push(`${entry.specifier ? \"=\" : \"^\"}${selector}`);\n  }\n  if (selectors.length === 0 ||\n      JSON.stringify(selectors) !== JSON.stringify(sortedUnique(selectors))) {\n    errors.push(\"special import selectors must be non-empty unique and sorted\");\n  }\n\n  const artifacts = contract.artifacts;\n  if (!isPlainObject(artifacts) ||\n      artifacts.generatedMarker !== \"// Generated by Eliscript. Do not edit.\" ||\n      artifacts.benchmarkDirectory !== \"benchmarks/\") {\n    errors.push(\"artifact roots and generated marker do not match the contract\");\n  }\n  if (!Array.isArray(artifacts?.benchmarkReports) ||\n      artifacts.benchmarkReports.length === 0 ||\n      artifacts.benchmarkReports.some((file) =>\n        !safeRelativePath(file) ||\n        !file.startsWith(artifacts.benchmarkDirectory) ||\n        !file.endsWith(\".json\")) ||\n      JSON.stringify(artifacts.benchmarkReports) !==\n        JSON.stringify(sortedUnique(artifacts.benchmarkReports))) {\n    errors.push(\"benchmark reports must be non-empty safe unique and sorted\");\n  }\n  const deterministic = Array.isArray(artifacts?.deterministic)\n    ? artifacts.deterministic\n    : [];\n  const outputs = [];\n  for (const [index, artifact] of deterministic.entries()) {\n    if (!isPlainObject(artifact) || !safeRelativePath(artifact.source) ||\n        !safeRelativePath(artifact.output) ||\n        (artifact.sourceMap !== undefined &&\n         (!safeRelativePath(artifact.sourceMap) ||\n          artifact.sourceMap !== `${artifact.output}.map`))) {\n      errors.push(`deterministic artifact ${index} is invalid`);\n      continue;\n    }\n    outputs.push(artifact.output);\n    if (artifact.sourceMap) outputs.push(artifact.sourceMap);\n  }\n  if (deterministic.length === 0 ||\n      new Set(outputs).size !== outputs.length ||\n      JSON.stringify(deterministic.map((entry) => entry.output)) !==\n        JSON.stringify(sortedUnique(deterministic.map((entry) => entry.output)))) {\n    errors.push(\"deterministic artifact outputs must be non-empty unique and sorted\");\n  }\n\n  const derived = Array.isArray(artifacts?.derived) ? artifacts.derived : [];\n  const derivedIds = derived.map((entry) => entry?.id);\n  if (JSON.stringify(derivedIds) !== JSON.stringify([\n    \"browser-compatibility-workflow\",\n    \"compatibility-workflow\",\n    \"library-api\",\n  ]) || derived.some((entry) => !isPlainObject(entry) ||\n    !Array.isArray(entry.outputs) || entry.outputs.length === 0 ||\n    entry.outputs.some((output) => !safeRelativePath(output)) ||\n    JSON.stringify(entry.outputs) !== JSON.stringify(sortedUnique(entry.outputs)))) {\n    errors.push(\"derived artifacts must declare the complete sorted generator set\");\n  }\n\n  if (errors.length > 0) throw new RepositoryIntegrityError(errors);\n  return contract;\n}\n\nasync function capture(command, root, timeoutMs = 120_000, environment) {\n  const child = Bun.spawn(command, {\n    cwd: root,\n    ...(environment ? {env: {...process.env, ...environment}} : {}),\n    stdout: \"pipe\",\n    stderr: \"pipe\",\n  });\n  let timedOut = false;\n  let forceKillTimer;\n  const timer = setTimeout(() => {\n    timedOut = true;\n    child.kill(\"SIGTERM\");\n    forceKillTimer = setTimeout(() => child.kill(\"SIGKILL\"), 2_000);\n  }, timeoutMs);\n  try {\n    const [exitCode, stdout, stderr] = await Promise.all([\n      child.exited,\n      new Response(child.stdout).text(),\n      new Response(child.stderr).text(),\n    ]);\n    if (timedOut || exitCode !== 0) {\n      throw new RepositoryIntegrityError([\n        timedOut\n          ? `${command[0]} exceeded ${timeoutMs}ms`\n          : stderr.trim() || stdout.trim() ||\n            `${command[0]} exited with ${exitCode}`,\n      ]);\n    }\n    return stdout;\n  } finally {\n    clearTimeout(timer);\n    clearTimeout(forceKillTimer);\n  }\n}\n\nexport async function repositoryTrackedFiles(root = DEFAULT_ROOT) {\n  const output = await capture([\"git\", \"ls-files\", \"-z\"], root);\n  return output.split(\"\\0\").filter(Boolean).sort();\n}\n\nasync function loadCompiler(root) {\n  const directory = await mkdtemp(path.join(tmpdir(), \"eliscript-integrity-compiler-\"));\n  try {\n    await capture([path.join(root, \"bin/eliscript-bootstrap\")], root, 120_000,\n      {ELISCRIPT_BOOTSTRAP_OUT_DIR: directory});\n    const url = pathToFileURL(path.join(directory, \"compiler.mjs\"));\n    return await import(url.href);\n  } finally {await rm(directory, {recursive: true, force: true});}\n}\n\nfunction walkImports(node, file, records) {\n  if (Array.isArray(node)) {\n    for (const item of node) walkImports(item, file, records);\n    return;\n  }\n  if (!isPlainObject(node)) return;\n  if (node.kind === \"import-declaration\" && typeof node.value === \"string\") {\n    records.push({\n      file,\n      specifier: node.value,\n      kind: \"import-declaration\",\n      language: \"eliscript\",\n    });\n  }\n  walkImports(node.body, file, records);\n  walkImports(node.children, file, records);\n}\n\nasync function scanImportRecords(root, trackedFiles, contract, compiler) {\n  const records = [];\n  const scanner = new Bun.Transpiler({ loader: \"js\" });\n  for (const file of trackedFiles) {\n    if (file.endsWith(\".mjs\") || file.endsWith(\".js\")) {\n      const source = (await readFile(path.join(root, file), \"utf8\"))\n        .replace(/^#![^\\n]*\\n/u, \"\");\n      for (const imported of scanner.scanImports(source)) {\n        records.push({\n          file,\n          specifier: imported.path,\n          kind: imported.kind,\n          language: \"javascript\",\n        });\n      }\n    }\n  }\n  for (const file of trackedFiles) {\n    if (!file.endsWith(\".eli\") ||\n        !contract.imports.eliscriptSourceRoots.some((rootPrefix) =>\n          file.startsWith(rootPrefix))) continue;\n    const source = await readFile(path.join(root, file), \"utf8\");\n    const program = compiler.compile_ir_string(source, path.join(root, file));\n    walkImports(program, file, records);\n  }\n  return records;\n}\n\nfunction packageName(specifier) {\n  if (specifier.startsWith(\"@\")) {\n    return specifier.split(\"/\").slice(0, 2).join(\"/\");\n  }\n  return specifier.split(\"/\", 1)[0];\n}\n\nfunction underAllowedRoot(file, roots) {\n  return roots.some((root) => file.startsWith(root));\n}\n\nfunction underPackageDirectory(file, directory) {\n  return file === directory || file.startsWith(`${directory}/`);\n}\n\nfunction specialPolicy(specifier, policies) {\n  return policies.find((policy) =>\n    policy.specifier === specifier ||\n    (policy.prefix !== undefined && specifier.startsWith(policy.prefix)));\n}\n\nexport function validateImportRecords(records, contract, localPackageScopes = []) {\n  const errors = [];\n  const packages = new Map(contract.packages.map((entry) => [entry.name, entry]));\n  let externalImports = 0;\n  let coreExternalImports = 0;\n  for (const record of records) {\n    const specifier = record.specifier;\n    if (specifier.startsWith(\".\") || specifier.startsWith(\"/\")) continue;\n    const special = specialPolicy(\n      specifier,\n      contract.imports.specialSpecifiers,\n    );\n    if (special) {\n      if (!underAllowedRoot(record.file, special.allowedRoots)) {\n        errors.push(\n          `${record.file} imports ${specifier} outside its allowed boundary`,\n        );\n      }\n      continue;\n    }\n    externalImports += 1;\n    if (contract.imports.coreRoots.some((root) => record.file.startsWith(root))) {\n      coreExternalImports += 1;\n    }\n    const name = packageName(specifier);\n    const localScope = localPackageScopes\n      .filter((scope) => underPackageDirectory(record.file, scope.directory))\n      .sort((left, right) => right.directory.length - left.directory.length)[0];\n    if (localScope) {\n      if (!localScope.packages.includes(name)) {\n        errors.push(\n          `${record.file} imports undeclared package ${specifier} in ` +\n          `${localScope.manifest}`,\n        );\n      }\n      continue;\n    }\n    const dependency = packages.get(name);\n    if (!dependency) {\n      errors.push(`${record.file} imports undeclared package ${specifier}`);\n    } else if (!underAllowedRoot(record.file, dependency.allowedRoots)) {\n      errors.push(`${record.file} imports ${specifier} outside its allowed boundary`);\n    }\n  }\n  if (errors.length > 0) throw new RepositoryIntegrityError(errors);\n  return { totalImports: records.length, externalImports, coreExternalImports };\n}\n\nasync function readLocalPackageScopes(root, trackedFiles, contract) {\n  const roots = contract.imports.localPackageRoots;\n  const manifests = trackedFiles.filter((file) =>\n    file.endsWith(\"/package.json\") && underAllowedRoot(file, roots));\n  const scopes = [];\n  const errors = [];\n  for (const filename of manifests) {\n    let manifest;\n    try {\n      manifest = JSON.parse(await readFile(path.join(root, filename), \"utf8\"));\n    } catch (error) {\n      errors.push(`${filename} is not valid JSON: ${error.message}`);\n      continue;\n    }\n    if (!isPlainObject(manifest) || manifest.private !== true ||\n        typeof manifest.name !== \"string\" || manifest.name.length === 0) {\n      errors.push(`${filename} must describe one named private package`);\n      continue;\n    }\n    const packages = [];\n    for (const section of PACKAGE_SECTIONS) {\n      const dependencies = manifest[section];\n      if (dependencies === undefined) continue;\n      if (!isPlainObject(dependencies) ||\n          Object.values(dependencies).some((value) =>\n            typeof value !== \"string\" || value.length === 0)) {\n        errors.push(`${filename} ${section} must map package names to versions`);\n        continue;\n      }\n      packages.push(...Object.keys(dependencies));\n    }\n    scopes.push({\n      directory: path.posix.dirname(filename),\n      manifest: filename,\n      name: manifest.name,\n      packages: sortedUnique([manifest.name, ...packages]),\n    });\n  }\n  if (errors.length > 0) throw new RepositoryIntegrityError(errors);\n  return scopes;\n}\n\nfunction exactObject(value) {\n  return Object.fromEntries(Object.entries(value ?? {}).sort(([left], [right]) =>\n    left.localeCompare(right)));\n}\n\nexport async function checkDependencyBoundaries(options = {}) {\n  const root = path.resolve(options.root ?? DEFAULT_ROOT);\n  const contract = validateIntegrityContract(options.contract ?? JSON.parse(\n    await readFile(path.join(root, CONTRACT_FILE), \"utf8\"),\n  ));\n  const trackedFiles = options.trackedFiles ?? await repositoryTrackedFiles(root);\n  const packageManifest = options.packageManifest ?? JSON.parse(\n    await readFile(path.join(root, contract.packageManifest), \"utf8\"),\n  );\n  const errors = [];\n  for (const section of PACKAGE_SECTIONS) {\n    const expected = Object.fromEntries(contract.packages\n      .filter((entry) => entry.section === section)\n      .map((entry) => [entry.name, entry.version]));\n    if (JSON.stringify(exactObject(packageManifest[section])) !==\n        JSON.stringify(exactObject(expected))) {\n      errors.push(`${contract.packageManifest} ${section} differs from the integrity contract`);\n    }\n  }\n  if (errors.length > 0) throw new RepositoryIntegrityError(errors);\n\n  if (!options.skipLockfile) {\n    await capture([\n      process.execPath,\n      \"install\",\n      \"--frozen-lockfile\",\n      \"--dry-run\",\n      \"--ignore-scripts\",\n      \"--silent\",\n    ], root);\n  }\n  const localPackageScopes = options.localPackageScopes ??\n    await readLocalPackageScopes(root, trackedFiles, contract);\n  const compiler = options.compiler ?? await loadCompiler(root);\n  const records = options.importRecords ?? await scanImportRecords(\n    root,\n    trackedFiles,\n    contract,\n    compiler,\n  );\n  const imports = validateImportRecords(records, contract, localPackageScopes);\n  return {\n    packages: contract.packages.length,\n    localPackages: localPackageScopes.length,\n    lockfile: options.skipLockfile ? \"skipped\" : \"frozen\",\n    scannedJavaScript: trackedFiles.filter((file) =>\n      file.endsWith(\".mjs\") || file.endsWith(\".js\")).length,\n    scannedEliscript: trackedFiles.filter((file) => file.endsWith(\".eli\") &&\n      contract.imports.eliscriptSourceRoots.some((rootPrefix) =>\n        file.startsWith(rootPrefix))).length,\n    ...imports,\n  };\n}\n\nfunction sha256(bytes) {\n  return createHash(\"sha256\").update(bytes).digest(\"hex\");\n}\n\nasync function checkedSource(root, trackedSet, file) {\n  if (!safeRelativePath(file) || !trackedSet.has(file)) {\n    throw new RepositoryIntegrityError([\n      `benchmark source is not a tracked safe path: ${file}`,\n    ]);\n  }\n  return readFile(path.join(root, file));\n}\n\nexport async function validateBenchmarkSource(\n  root,\n  trackedFiles,\n  filename,\n  report,\n) {\n  const trackedSet = new Set(trackedFiles);\n  if (typeof report?.format !== \"string\" ||\n      !report.format.startsWith(\"eliscript-\") ||\n      !Number.isSafeInteger(report.version)) {\n    throw new RepositoryIntegrityError([`${filename} has invalid report identity`]);\n  }\n\n  if (isPlainObject(report.sourceDigest)) {\n    const binding = report.sourceDigest;\n    if (binding.algorithm !== \"sha256\" ||\n        !Array.isArray(binding.files) || binding.files.length === 0 ||\n        !/^[0-9a-f]{64}$/.test(binding.value ?? \"\") ||\n        new Set(binding.files).size !== binding.files.length) {\n      throw new RepositoryIntegrityError([`${filename} has invalid sourceDigest`]);\n    }\n    const aggregate = createHash(\"sha256\");\n    for (const file of binding.files) {\n      const bytes = await checkedSource(root, trackedSet, file);\n      aggregate.update(file);\n      aggregate.update(\"\\0\");\n      aggregate.update(bytes);\n      aggregate.update(\"\\0\");\n    }\n    if (aggregate.digest(\"hex\") !== binding.value) {\n      throw new RepositoryIntegrityError([`${filename} sourceDigest is stale`]);\n    }\n    return binding.files.length;\n  }\n\n  const binding = report.source;\n  if (!isPlainObject(binding) || !Array.isArray(binding.files) ||\n      binding.files.length === 0 ||\n      !/^[0-9a-f]{64}$/.test(binding.digest ?? \"\")) {\n    throw new RepositoryIntegrityError([`${filename} has no valid source binding`]);\n  }\n  const pathBytes = createHash(\"sha256\");\n  const digestManifest = createHash(\"sha256\");\n  const names = [];\n  for (const entry of binding.files) {\n    if (!isPlainObject(entry) || typeof entry.file !== \"string\" ||\n        !/^[0-9a-f]{64}$/.test(entry.sha256 ?? \"\")) {\n      throw new RepositoryIntegrityError([`${filename} has invalid source entries`]);\n    }\n    names.push(entry.file);\n    const bytes = await checkedSource(root, trackedSet, entry.file);\n    const digest = sha256(bytes);\n    if (digest !== entry.sha256) {\n      throw new RepositoryIntegrityError([\n        `${filename} source entry is stale: ${entry.file}`,\n      ]);\n    }\n    pathBytes.update(entry.file);\n    pathBytes.update(\"\\0\");\n    pathBytes.update(bytes);\n    pathBytes.update(\"\\0\");\n    digestManifest.update(`${entry.file}:${digest}\\n`);\n  }\n  if (new Set(names).size !== names.length ||\n      ![pathBytes.digest(\"hex\"), digestManifest.digest(\"hex\")]\n        .includes(binding.digest)) {\n    throw new RepositoryIntegrityError([`${filename} aggregate source digest is stale`]);\n  }\n  return names.length;\n}\n\nexport async function checkGeneratedMarkerCoverage(\n  root,\n  trackedFiles,\n  contract,\n) {\n  const marked = [];\n  for (const file of trackedFiles.filter((candidate) =>\n    candidate.endsWith(\".mjs\"))) {\n    const source = await readFile(path.join(root, file), \"utf8\");\n    if (source.startsWith(contract.artifacts.generatedMarker)) marked.push(file);\n  }\n  const declared = contract.artifacts.deterministic\n    .map((artifact) => artifact.output)\n    .sort();\n  if (JSON.stringify(marked.sort()) !== JSON.stringify(declared)) {\n    throw new RepositoryIntegrityError([\n      \"generated Eliscript module markers differ from the artifact registry\",\n    ]);\n  }\n  return marked;\n}\n\nexport function validateBenchmarkInventory(trackedFiles, contract) {\n  const actual = trackedFiles.filter((file) =>\n    file.startsWith(contract.artifacts.benchmarkDirectory) &&\n    file.endsWith(\".json\"));\n  const expected = contract.artifacts.benchmarkReports;\n  if (JSON.stringify(actual) !== JSON.stringify(expected)) {\n    throw new RepositoryIntegrityError([\n      \"tracked benchmark reports differ from the artifact registry\",\n    ]);\n  }\n  return actual;\n}\n\nasync function checkDeterministicArtifacts(root, contract, compiler) {\n  const errors = [];\n  for (const artifact of contract.artifacts.deterministic) {\n    const sourcePath = path.join(root, artifact.source);\n    const outputPath = path.join(root, artifact.output);\n    const source = await readFile(sourcePath, \"utf8\");\n    if (!artifact.sourceMap) {\n      const expected = compiler.compile_string(source, sourcePath);\n      const actual = await readFile(outputPath, \"utf8\");\n      if (actual !== expected) errors.push(`${artifact.output} is stale`);\n      continue;\n    }\n    const mapPath = path.join(root, artifact.sourceMap);\n    const emission = compiler.compile_string_with_source_map(\n      source,\n      sourcePath,\n      path.relative(path.dirname(mapPath), outputPath),\n      path.relative(path.dirname(mapPath), sourcePath),\n    );\n    const mapUrl = path.relative(path.dirname(outputPath), mapPath);\n    const expectedOutput =\n      `${emission.javascript}//# sourceMappingURL=${mapUrl}\\n`;\n    const [actualOutput, actualMap] = await Promise.all([\n      readFile(outputPath, \"utf8\"),\n      readFile(mapPath, \"utf8\"),\n    ]);\n    if (actualOutput !== expectedOutput) errors.push(`${artifact.output} is stale`);\n    if (actualMap !== emission.sourceMap) errors.push(`${artifact.sourceMap} is stale`);\n  }\n  if (errors.length > 0) throw new RepositoryIntegrityError(errors);\n}\n\nasync function checkDerivedArtifacts(root, contract) {\n  const expected = new Map(contract.artifacts.derived.map((entry) =>\n    [entry.id, entry.outputs]));\n  const browser = await checkBrowserCompatibilityWorkflow({ root });\n  if (JSON.stringify(expected.get(\"browser-compatibility-workflow\")) !==\n      JSON.stringify([browser.workflow])) {\n    throw new RepositoryIntegrityError([\n      \"browser workflow outputs differ from the artifact registry\",\n    ]);\n  }\n  const workflow = await checkCompatibilityWorkflow({ root });\n  if (JSON.stringify(expected.get(\"compatibility-workflow\")) !==\n      JSON.stringify([workflow.workflow])) {\n    throw new RepositoryIntegrityError([\n      \"compatibility workflow outputs differ from the artifact registry\",\n    ]);\n  }\n  const api = await generateApiArtifacts({ root, check: true });\n  if (JSON.stringify(expected.get(\"library-api\")) !==\n      JSON.stringify([...api.files].sort())) {\n    throw new RepositoryIntegrityError([\n      \"library API outputs differ from the artifact registry\",\n    ]);\n  }\n  return 2 + api.files.length;\n}\n\nexport async function checkGeneratedArtifacts(options = {}) {\n  const root = path.resolve(options.root ?? DEFAULT_ROOT);\n  const contract = validateIntegrityContract(options.contract ?? JSON.parse(\n    await readFile(path.join(root, CONTRACT_FILE), \"utf8\"),\n  ));\n  const trackedFiles = options.trackedFiles ?? await repositoryTrackedFiles(root);\n  const compiler = options.compiler ?? await loadCompiler(root);\n  await checkGeneratedMarkerCoverage(root, trackedFiles, contract);\n  await checkDeterministicArtifacts(root, contract, compiler);\n  const derivedArtifacts = await checkDerivedArtifacts(root, contract);\n\n  const benchmarkFiles = validateBenchmarkInventory(trackedFiles, contract);\n  let benchmarkSources = 0;\n  const deferPerformanceAcceptance = options.deferPerformanceAcceptance === true;\n  for (const file of deferPerformanceAcceptance ? [] : benchmarkFiles) {\n    const report = JSON.parse(await readFile(path.join(root, file), \"utf8\"));\n    benchmarkSources += await validateBenchmarkSource(\n      root,\n      trackedFiles,\n      file,\n      report,\n    );\n  }\n  return {\n    deterministicArtifacts: contract.artifacts.deterministic.length,\n    deterministicOutputs: contract.artifacts.deterministic.reduce(\n      (count, artifact) => count + 1 + Number(Boolean(artifact.sourceMap)),\n      0,\n    ),\n    derivedArtifacts,\n    benchmarkArtifacts: benchmarkFiles.length,\n    benchmarkSources,\n    ...(deferPerformanceAcceptance ? { deferredBenchmarkSources: benchmarkFiles } : {}),\n  };\n}\n\nexport async function checkRepositoryIntegrity(options = {}) {\n  const root = path.resolve(options.root ?? DEFAULT_ROOT);\n  const contract = validateIntegrityContract(options.contract ?? JSON.parse(\n    await readFile(path.join(root, CONTRACT_FILE), \"utf8\"),\n  ));\n  const trackedFiles = options.trackedFiles ?? await repositoryTrackedFiles(root);\n  const compiler = options.compiler ?? await loadCompiler(root);\n  const dependency = options.artifactsOnly ? undefined :\n    await checkDependencyBoundaries({\n      ...options,\n      root,\n      contract,\n      trackedFiles,\n      compiler,\n    });\n  const artifacts = options.dependenciesOnly ? undefined :\n    await checkGeneratedArtifacts({\n      ...options,\n      root,\n      contract,\n      trackedFiles,\n      compiler,\n    });\n  return {\n    schemaVersion: 1,\n    format: \"eliscript-repository-integrity-report\",\n    version: 1,\n    dependency,\n    artifacts,\n  };\n}\n\nexport function humanIntegrityReport(report) {\n  const lines = [\"Repository integrity:\"];\n  if (report.dependency) {\n    lines.push(\n      `  Dependencies  ${report.dependency.packages} declared packages, ` +\n        `${report.dependency.coreExternalImports} core package imports`,\n      `  Sources       ${report.dependency.scannedJavaScript} JavaScript, ` +\n        `${report.dependency.scannedEliscript} Eliscript`,\n      `  Lockfile      ${report.dependency.lockfile}`,\n    );\n  }\n  if (report.artifacts) {\n    lines.push(\n      `  Generated     ${report.artifacts.deterministicOutputs} deterministic outputs, ` +\n        `${report.artifacts.derivedArtifacts} derived outputs`,\n      `  Benchmarks    ${report.artifacts.benchmarkArtifacts} reports, ` +\n        `${report.artifacts.benchmarkSources} source bindings`,\n    );\n    if (report.artifacts.deferredBenchmarkSources) lines.push(\n      `  Performance   DEFERRED / NOT ACCEPTED: ${report.artifacts.deferredBenchmarkSources.length} current-source bindings`,\n    );\n  }\n  return lines.join(\"\\n\");\n}\n\nconst invokedFilename = process.argv[1] ? path.resolve(process.argv[1]) : undefined;\nif (invokedFilename === fileURLToPath(import.meta.url)) {\n  const args = process.argv.slice(2);\n  const dependenciesOnly = args.includes(\"--dependencies\");\n  const artifactsOnly = args.includes(\"--artifacts\");\n  const unknown = args.filter((argument) =>\n    argument !== \"--dependencies\" && argument !== \"--artifacts\");\n  if (unknown.length > 0 || (dependenciesOnly && artifactsOnly)) {\n    console.error(\n      \"Usage: bun tools/integrity/check.mjs [--dependencies|--artifacts]\",\n    );\n    process.exitCode = 2;\n  } else {\n    try {\n      const report = await checkRepositoryIntegrity({\n        dependenciesOnly,\n        artifactsOnly,\n        deferPerformanceAcceptance: process.env.ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE === \"1\",\n      });\n      console.log(humanIntegrityReport(report));\n    } catch (error) {\n      console.error(error.message);\n      process.exitCode = 1;\n    }\n  }\n}\n"))
