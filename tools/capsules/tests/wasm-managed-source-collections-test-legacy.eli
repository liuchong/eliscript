onst roots=[],referenceMap=new Map([['key',7]]),referenceSet=new Set(['key']),key=a.string('key'),value=a.number(7),other=a.invoke('empty-map');roots.push(key,value,other);\n const assigned=a.invoke('set-value',[m,key,value]);a.release(assigned);const added=a.invoke('add-value',[s,key]);a.release(added);\n try{\n  for(const[target,reference,names]of[[m,referenceMap,['get','set','has','delete','clear','entries','keys','values','forEach']],[s,referenceSet,['add','has','delete','clear','entries','keys','values','forEach']],[it,referenceMap.entries(),['next']]])for(const name of names){const k=a.string(name);let first,again;try{first=a.invoke('read-value',[target,k]);again=a.invoke('read-value',[target,k]);assert.equal(first.kind,18,name);assert(a.keyEqual(first,again),name);const label=a.string('name'),length=a.string('length');try{assert.equal(call(a,'read-value',[first,label]),reference[name].name);assert.equal(call(a,'read-value',[first,length]),reference[name].length);}finally{a.release(label);a.release(length);}}finally{a.release(k);a.release(first);a.release(again);}}\n  for(const[target,reference,name,args,hostArgs]of[[m,referenceMap,'get',[key],['key']],[m,referenceMap,'has',[key],['key']],[s,referenceSet,'has',[key],['key']],[it,referenceMap.entries(),'next',[],[]]]){const k=a.string(name),fn=a.invoke('read-value',[target,k]);try{assert.deepEqual(call(a,'captured-call',[fn,target,...args]),Reflect.apply(reference[name],reference,hostArgs));const trace=a.sourceArray([]),expected=[];try{assert.throws(()=>js.detached_call(reference[name],hostArgs[0],expected),TypeError);assert.throws(()=>a.invoke('detached-call',[fn,key,trace]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.deepEqual(read(a,trace),expected);}finally{a.release(trace);}}finally{a.release(k);a.release(fn);}}\n  const getKey=a.string('get'),first=a.invoke('read-value',[m,getKey]),second=a.invoke('read-value',[other,getKey]);try{assert(a.keyEqual(first,second));const trace=a.sourceArray([]),expected=[];try{assert.equal(call(a,'captured-get',[m,trace]),js.captured_get(referenceMap,expected));assert.deepEqual(read(a,trace),expected);assert.equal(call(a,'read-value',[m,getKey]),false);}finally{a.release(trace);}}finally{a.release(getKey);a.release(first);a.release(second);}\n }finally{for(const v of[...roots,m,s,it])a.release(v);a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);}\n});\ntest('Node executes the same source-collection artifact and generated JS through constructors, live iterators and exact cleanup',async()=>{\n const wasm=resolve(directory,'source-collections.wasm'),javascript=resolve(directory,'source-collections.mjs');await writeFile(wasm,bytes);await writeFile(javascript,b.compiler.emit_ir_string(program));\n const child=spawnSync('node',['--input-type=module','-e',`\n import assert from 'node:assert/strict';import{readFileSync}from'node:fs';import{pathToFileURL}from'node:url';import{instantiateManagedRuntime}from ${JSON.stringify(resolve('tools/backends/managed-runtime.mjs'))};\n const js=await import(pathToFileURL(${JSON.stringify(javascript)}).href),a=instantiateManagedRuntime(readFileSync(${JSON.stringify(wasm)}));a.auto(1);const m=a.invoke('empty-map'),ref=js.empty_map(),key=a.number(-0),value=a.string('中😀');const assigned=a.invoke('set-value',[m,key,value]);a.release(assigned);js.set_value(ref,-0,'中😀');const found=a.invoke('lookup',[m,key]);assert.equal(a.readString(found),js.lookup(ref,-0));a.release(found);\n const it=a.invoke('entries',[m]),reference=js.entries(ref),vk=a.string('value'),dk=a.string('done');let step=a.invoke('next',[it]),pair=a.objectGet(step,vk),first=a.get(pair,0),second=a.get(pair,1),expected=js.next(reference);assert(Object.is(a.readNumber(first),expected.value[0]));assert.equal(a.readString(second),expected.value[1]);for(const x of[first,second,pair,step])a.release(x);\n a.invoke('clear',[m]);ref.clear();const late=a.string('late'),updated=a.invoke('set-value',[m,late,true]);a.release(updated);ref.set('late',true);step=a.invoke('next',[it]);pair=a.objectGet(step,vk);first=a.get(pair,0);second=a.get(pair,1);expected=reference.next();assert.equal(a.readString(first),expected.value[0]);assert.equal(second,true);for(const x of[first,pair,step])a.release(x);step=a.invoke('next',[it]);assert.equal(a.objectGet(step,dk),true);a.release(step);\n const text=a.string('a😀a\\\\ud800'),set=a.invoke('from-set',[text]),size=a.invoke('size',[set]);assert.equal(a.readNumber(size),js.size(js.from_set('a😀a\\\\ud800')));a.release(size);for(const x of[m,key,value,it,vk,dk,late,text,set])a.release(x);a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);\n `],{encoding:'utf8',timeout:30000});assert.equal(child.status,0,child.stderr);\n});\n"))
