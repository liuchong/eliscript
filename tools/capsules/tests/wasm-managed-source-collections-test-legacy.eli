(module capsules.tests.wasm-managed-source-collections-test-legacy
  (js* "import {beforeAll,afterAll,test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {readFile,mkdtemp,rm,writeFile} from 'node:fs/promises';\nimport {resolve} from 'node:path';import {tmpdir} from 'node:os';import {spawnSync} from 'node:child_process';\nimport {buildBackends} from '../tools/backends/build.mjs';import {instantiateManagedRuntime} from '../tools/backends/managed-runtime.mjs';\nlet directory,b,runtime,program,bytes,js;\nconst supportedCollectionSource=`\n  (defun captured-call (fn receiver &rest args) (js-call fn :apply receiver args))\n  (defun detached-call (fn key trace) (funcall fn (progn (js-call trace :push \"argument\") key)))\n  (defun captured-get (m trace) (js-call (get m :get) :call m (progn (put m :get false) (js-call trace :push \"key\") \"key\")))\n  (defun shadow-map (Map trace) (new (js* \"Map\") (progn (js-call trace :push \"argument\") nil)))\n  (defun shadow-global (globalThis trace) (new globalThis.Map (progn (js-call trace :push \"argument\") nil)))\n  (defun local-map-shadow (trace) (let ((Map nil)) (new (js* \"Map\") (progn (js-call trace :push \"argument\") nil))))\n  (defun local-global-shadow (trace) (let ((globalThis nil)) (new globalThis.Set (progn (js-call trace :push \"argument\") nil))))\n  (defun supported-operands (trace)\n    (let ((map (new globalThis.Map nil (progn (js-call trace :push \"ignored\") (async (x) x)))))\n      (js-array (get map :size) (if false (new globalThis.Array (js-call trace :push \"unreachable\")) nil) trace)))\n  (defun shadow-constructor (ignored) nil)\n  (defun successful-shadows (trace)\n    (let ((a (shadow-map (js* \"Set\") trace)) (b (shadow-global (js-object :Map (js* \"Set\")) trace))\n          (c (let ((Map shadow-constructor)) (new (js* \"Map\") nil))))\n      (js-array (get a :size) (get b :size)\n        (Object/is (Object/getPrototypeOf a) (get (js* \"Set\") :prototype))\n        (Object/is (Object/getPrototypeOf b) (get (js* \"Set\") :prototype))\n        (Object/is (Object/getPrototypeOf c) (get shadow-constructor :prototype)) trace)))\n  (export captured-call detached-call captured-get shadow-map shadow-global local-map-shadow local-global-shadow supported-operands successful-shadows)\n`;\nbeforeAll(async()=>{directory=await mkdtemp(resolve(tmpdir(),'eliscript-source-collections-'));b=await buildBackends({outputRoot:directory});runtime=b.compiler.compile_ir_string(await readFile('bootstrap/runtime/memory.eli','utf8'),'runtime.eli');program=b.compiler.compile_ir_string((await readFile('tests/fixtures/wasm-managed-source-collections.eli','utf8')).replace('  (export ',supportedCollectionSource+'  (export '),'source-collections.eli');bytes=Uint8Array.from(b.managed.emit_managed_wasm(program,runtime));assert(WebAssembly.validate(bytes));assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(bytes)),[]);js=await import('data:text/javascript;base64,'+Buffer.from(b.compiler.emit_ir_string(program)).toString('base64'));},120000);\nafterAll(async()=>{if(directory)await rm(directory,{recursive:true,force:true});});\nconst box=(a,x)=>typeof x==='number'?a.number(x):typeof x==='string'?a.string(x):x;\nfunction read(a,x){if(!x||typeof x!=='object')return x;if(x.kind===4)return a.readNumber(x);if(x.kind===5)return a.readString(x);if(x.kind===14)return Array.from({length:a.length(x)},(_,i)=>{const y=a.get(x,i);try{return read(a,y);}finally{a.release(y);}});if(x.kind===13){const out={},keys=a.objectKeys(x);try{for(let i=0;i<a.length(keys);i++){const k=a.get(keys,i),v=a.objectGet(x,k);try{Object.defineProperty(out,a.readString(k),{value:read(a,v),enumerable:true,writable:true,configurable:true});}finally{a.release(k);a.release(v);}}}finally{a.release(keys);}return out;}return x;}\nfunction call(a,name,args=[]){const x=a.invoke(name,args);try{return read(a,x);}finally{a.release(x);}}\nfunction entries(a,m,method='entries'){const it=a.invoke(method,[m]),out=[];try{for(;;){const step=call(a,'next',[it]);if(step.done)break;out.push(step.value);}}finally{a.release(it);}return out;}\nfunction put(a,m,k,v){const key=box(a,k),value=box(a,v),out=a.invoke('set-value',[m,key,value]);assert(a.keyEqual(out,m));a.release(out);a.release(key);a.release(value);}\nfunction add(a,m,k){const key=box(a,k),out=a.invoke('add-value',[m,key]);assert(a.keyEqual(out,m));a.release(out);a.release(key);}\nfunction own(a,m,k){const key=box(a,k);try{return call(a,'own',[m,key]);}finally{a.release(key);}}\ntest('ordinary Map and Set constructors, queries, mutations and defaults match JS without host imports',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);for(const name of['empty-map','raw-map','empty-set','raw-set']){const m=a.invoke(name);assert.equal(call(a,'size',[m]),0);assert.equal(call(a,'length',[m]),undefined);assert.deepEqual(call(a,'own-keys',[m]),[]);a.release(m);a.collect();assert.equal(a.live(),0);}\n const m=a.invoke('empty-map'),s=a.invoke('empty-set'),ref=new Map(),set=new Set();\n for(const[k,v]of[[null,undefined],[false,null],[true,false],[undefined,true],[-0,-0],[NaN,Infinity],['中😀\\ud800','text']]){put(a,m,k,v);ref.set(k,v);add(a,s,k);set.add(k);const key=box(a,k);assert.equal(call(a,'has',[m,key]),ref.has(k));assert.deepEqual(call(a,'lookup',[m,key]),ref.get(k));a.release(key);}\n assert.deepEqual(entries(a,m),[...ref]);assert.deepEqual(entries(a,s),[...set].map(x=>[x,x]));assert.deepEqual(entries(a,s,'keys'),[...set]);assert.deepEqual(entries(a,s,'values'),[...set]);assert.deepEqual(call(a,'lookup-none',[m]),ref.get());\n const out=a.invoke('set-none',[m]);assert(a.keyEqual(out,m));a.release(out);ref.set();const added=a.invoke('add-none',[s]);a.release(added);set.add();assert.deepEqual(entries(a,m),[...ref]);\n for(const k of[NaN,'absent',undefined]){const key=box(a,k);assert.equal(call(a,'delete-value',[m,key]),ref.delete(k));a.release(key);}assert.deepEqual(entries(a,m),[...ref]);assert.equal(call(a,'clear',[m]),ref.clear());assert.equal(call(a,'size',[m]),0);a.release(m);a.release(s);a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);\n});\ntest('constructors consume arrays, source collections, live iterators and Unicode code points with JS entry rules',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const one=a.number(1),two=a.number(2),pair=a.sourceArray([one,two]),tuple=a.sourceObject({'0':true,'1':false}),input=a.sourceArray([pair,tuple]),map=a.invoke('from-map',[input]);assert.deepEqual(entries(a,map),[[1,2],[true,false]]);\n const copy=a.invoke('from-map',[map]);assert.deepEqual(entries(a,copy),entries(a,map));const set=a.invoke('from-set',[map]);assert.equal(call(a,'size',[set]),2);assert.deepEqual(entries(a,set,'values'),[[1,2],[true,false]]);\n const it=a.invoke('entries',[map]),fromIterator=a.invoke('from-map',[it]);assert.deepEqual(entries(a,fromIterator),entries(a,map));assert.deepEqual(call(a,'next',[it]),{value:undefined,done:true});\n const word=a.string('a😀a\\ud800'),unicode=a.invoke('from-set',[word]);assert.deepEqual(entries(a,unicode,'values'),[...new Set('a😀a\\ud800')]);const sparse=a.sourceArray([true,,undefined]),holes=a.invoke('from-set',[sparse]);assert.deepEqual(entries(a,holes,'values'),[true,undefined]);\n for(const value of[false,true,0,'x']){const boxed=box(a,value);assert.throws(()=>a.invoke('from-map',[boxed]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');a.release(boxed);}\n for(const nil of[null,undefined]){const empty=a.invoke('from-map',[nil]);assert.equal(call(a,'size',[empty]),0);a.release(empty);}const emptyText=a.string(''),emptyMap=a.invoke('from-map',[emptyText]);assert.equal(call(a,'size',[emptyMap]),0);\n for(const v of[one,two,pair,tuple,input,map,copy,set,it,fromIterator,word,unicode,sparse,holes,emptyText,emptyMap])a.release(v);a.collect();assert.equal(a.live(),0);\n});\ntest('source iterators preserve live mutations, result shapes, sticky done and array holes',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const m=a.invoke('empty-map'),ref=new Map([[1,'one'],[2,'two']]);put(a,m,1,'one');put(a,m,2,'two');const it=a.invoke('entries',[m]),rit=ref.entries();assert.deepEqual(call(a,'next',[it]),rit.next());const two=a.number(2);call(a,'delete-value',[m,two]);ref.delete(2);put(a,m,3,'three');ref.set(3,'three');assert.deepEqual(call(a,'next',[it]),rit.next());call(a,'clear',[m]);ref.clear();put(a,m,4,'four');ref.set(4,'four');assert.deepEqual(call(a,'next',[it]),rit.next());assert.deepEqual(call(a,'next',[it]),rit.next());put(a,m,5,'late');assert.deepEqual(call(a,'next',[it]),{value:undefined,done:true});\n const array=a.sourceArray([true,,undefined]),arrayIt=a.invoke('entries',[array]);assert.deepEqual(call(a,'next',[arrayIt]),{value:[0,true],done:false});assert.deepEqual(call(a,'next',[arrayIt]),{value:[1,undefined],done:false});const shortened=a.number(1),length=a.string('length');call(a,'write',[array,length,shortened]);assert.deepEqual(call(a,'next',[arrayIt]),{value:undefined,done:true});const extended=a.number(8);call(a,'write',[array,length,extended]);assert.deepEqual(call(a,'next',[arrayIt]),{value:undefined,done:true});\n const result=a.invoke('next',[arrayIt]);assert.deepEqual(call(a,'own-keys',[result]),['value','done']);a.release(result);for(const v of[m,it,two,array,arrayIt,shortened,length,extended])a.release(v);a.collect();assert.equal(a.live(),0);\n});\ntest('ordinary collection properties, size accessors, shallow copies and method shadows remain separate from entries',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const m=a.invoke('empty-map');put(a,m,'name',1);assert.equal(own(a,m,'size'),false);assert.equal(own(a,m,'name'),false);const name=a.string('name'),two=a.number(2);call(a,'write',[m,name,two]);assert.equal(own(a,m,'name'),true);assert.deepEqual(call(a,'own-keys',[m]),['name']);assert.equal(call(a,'lookup',[m,name]),1);assert.equal(call(a,'read-value',[m,name]),2);\n const size=a.string('size');assert.throws(()=>a.invoke('write',[m,size,two]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.equal(call(a,'size',[m]),1);const copy=a.invoke('assoc',[m,name,false]);assert.deepEqual(read(a,copy),{name:false});\n const get=a.string('get'),marker=a.sourceArray([false]);call(a,'write',[m,get,false]);assert.throws(()=>a.invoke('method-shadow',[m,marker]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.deepEqual(read(a,marker),[9]);const fresh=a.invoke('empty-map'),result=a.invoke('method-replace',[fresh,name,two]);assert(a.keyEqual(fresh,result));a.release(result);assert.equal(call(a,'lookup',[fresh,name]),2);\n for(const v of[m,name,two,size,copy,get,marker,fresh])a.release(v);a.collect();assert.equal(a.live(),0);\n});\ntest('constructors and methods evaluate ignored arguments in order and retain original receivers',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const marker=a.sourceArray([false]),referenceMarker=[false],reference=js.map_extra(undefined,referenceMarker),m=a.invoke('map-extra',[undefined,marker]);assert.deepEqual(read(a,marker),referenceMarker);assert.throws(()=>a.invoke('map-extra',[true,marker]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.throws(()=>js.map_extra(true,referenceMarker));assert.deepEqual(read(a,marker),referenceMarker);const assigned=a.invoke('set-order',[m,marker]);a.release(assigned);js.set_order(reference,referenceMarker);assert.deepEqual(entries(a,m),[...reference]);assert.deepEqual(read(a,marker),referenceMarker);const key=a.number(1);assert.equal(call(a,'has-extra',[m,key,marker]),js.has_extra(reference,1,referenceMarker));assert.deepEqual(read(a,marker),referenceMarker);assert.equal(call(a,'clear-extra',[m,marker]),js.clear_extra(reference,referenceMarker));assert.deepEqual(read(a,marker),referenceMarker);for(const v of[marker,m,key])a.release(v);a.collect();assert.equal(a.live(),0);\n});\ntest('random ordinary Map and Set operations agree with independent JS through GC, deletion and reinsertion',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const m=a.invoke('empty-map'),s=a.invoke('empty-set'),ref=new Map(),set=new Set(),values=[undefined,null,false,true,-0,NaN,Infinity,'中😀\\ud800'];let state=0x327fa19;const next=()=>{state^=state<<13;state^=state>>>17;state^=state<<5;return state>>>0;};\n for(let i=0;i<512;i++){const key=values[next()%values.length],value=values[next()%values.length],op=next()%5,k=box(a,key);if(op<2){put(a,m,key,value);add(a,s,key);ref.set(key,value);set.add(key);}else if(op===2){assert.equal(call(a,'delete-value',[m,k]),ref.delete(key));assert.equal(call(a,'delete-value',[s,k]),set.delete(key));}else if(op===3){assert.equal(call(a,'has',[m,k]),ref.has(key));assert.deepEqual(call(a,'lookup',[m,k]),ref.get(key));}else{call(a,'clear',[m]);call(a,'clear',[s]);ref.clear();set.clear();}a.release(k);assert.equal(call(a,'size',[m]),ref.size);assert.deepEqual(entries(a,m),[...ref]);assert.deepEqual(entries(a,s,'values'),[...set]);a.collect();assert.equal(a.stats().frameDepth,0);}\n a.release(m);a.release(s);a.collect();assert.equal(a.live(),0);\n});\ntest('arbitrary JS and unsupported callback bodies remain source-bound refusals, including shadowed and dead branches',()=>{\n for(const source of['(defun f () (new (js* \"Map()\")))','(defun f (Map) (new (js* \"Map()\")))','(defun f (globalThis) (new globalThis.Map (js* \"unsupported()\")))','(defun f (m) (if false (js-call m :forEach (lambda (x) (js* \"x\"))) m))']){const ir=b.compiler.compile_ir_string(source+' (export f)','unsupported-source-map.eli'),before=JSON.stringify(ir);assert.throws(()=>b.managed.emit_managed_wasm(ir,runtime),e=>e.eliscriptDiagnostic?.code==='ELI-B0001'&&e.eliscriptDiagnostic.location.file==='unsupported-source-map.eli');assert.equal(JSON.stringify(ir),before);}\n});\ntest('lexical constructor shadows retain their actual values and supported ignored operands preserve JS effects',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);\n try{\n  for(const name of['supported-operands','successful-shadows']){const trace=a.sourceArray([]),expectedTrace=[];try{assert.deepEqual(call(a,name,[trace]),js[name.replaceAll('-','_')](expectedTrace));assert.deepEqual(read(a,trace),expectedTrace);}finally{a.release(trace);}}\n  for(const[name,receiver,hostReceiver]of[['shadow-map',null,null],['shadow-global',null,null],['shadow-global',a.sourceObject({Map:null}),{Map:null}],['local-map-shadow',undefined,undefined],['local-global-shadow',undefined,undefined]]){\n   const trace=a.sourceArray([]),expected=[];try{const args=name.startsWith('local-')?[trace]:[receiver,trace],hostArgs=name.startsWith('local-')?[expected]:[hostReceiver,expected];assert.throws(()=>js[name.replaceAll('-','_')](...hostArgs),TypeError);assert.throws(()=>a.invoke(name,args),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.deepEqual(read(a,trace),expected);assert.equal(a.stats().frameDepth,0);}finally{a.release(trace);a.release(receiver);}\n  }\n }finally{a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);}\n});\ntest('source collection identities, self keys and named cycles survive GC without changing raw Map and Set brands',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const m=a.invoke('empty-map'),s=a.invoke('empty-set'),out=a.invoke('set-value',[m,m,s]);assert(a.keyEqual(out,m));a.release(out);const added=a.invoke('add-value',[s,m]);a.release(added);const name=a.string('self');call(a,'write',[m,name,m]);a.collect();const found=a.invoke('lookup',[m,m]);assert(a.keyEqual(found,s));a.release(found);assert.equal(call(a,'has',[s,m]),true);const alias=a.invoke('read-value',[m,name]);assert(a.keyEqual(alias,m));a.release(alias);for(const v of[m,s,name])a.release(v);a.collect();assert.equal(a.live(),0);\n const rawMap=a.map(),rawSet=a.setTable();assert.equal(rawMap.kind,10);assert.equal(rawSet.kind,11);a.tableSet(rawMap,true,false);a.tableAdd(rawSet,true);assert.equal(a.tableGet(rawMap,true),false);assert.equal(a.tableHas(rawSet,true),true);a.release(rawMap);a.release(rawSet);a.collect();assert.equal(a.live(),0);\n});\ntest('source table capacity failures leave committed entries intact and unwind only private roots',()=>{\n const a=instantiateManagedRuntime(bytes,{maxSlots:256,initialBytes:16384,maxBytes:16384});a.auto(1);const m=a.invoke('empty-map');let count=0,failed=false;\n for(let i=0;i<512;i++){let key;try{key=a.number(i);const result=a.invoke('set-value',[m,key,true]);a.release(result);count++;}catch(e){assert.equal(e.eliscriptDiagnostic?.code,'ELI-RT0002');failed=true;}finally{a.release(key);}if(failed)break;}\n assert(failed&&count>0);assert.equal(a.stats().frameDepth,0);a.collect();assert.equal(call(a,'size',[m]),count);for(let i=0;i<count;i++){const key=a.number(i);assert.equal(call(a,'lookup',[m,key]),true);a.release(key);}a.release(m);a.collect();assert.equal(a.live(),0);\n const bad=a.sourceArray([undefined]);assert.throws(()=>a.invoke('from-map',[bad]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.equal(a.stats().frameDepth,0);a.release(bad);a.collect();assert.equal(a.live(),0);\n});\ntest('real lookup, call and iterator traps preserve argument order, caller frames and owned graph cleanup',async()=>{\n const source=await readFile('bootstrap/runtime/memory.eli','utf8');\n for(const[name,parameters,entry,expected]of[['value-source-method-check','heap value method','has-extra',false],['value-source-method','heap value method a b','has-extra',9],['value-source-iterator-advance','heap iterator','next-extra',9],['value-source-method-check','heap value method','lookup',false],['value-source-method','heap value method a b','lookup',false]]){\n  const start=source.indexOf('  (defun '+name+' '),end=source.indexOf('  (defun ',start+3);assert(start>=0&&end>start);const injected=b.compiler.compile_ir_string(source.slice(0,start)+`  (defun ${name} (${parameters}) (load-u32 4294967295))\\n`+source.slice(end),'source-map-trap.eli');const a=instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_wasm(program,injected)));a.auto(1);const map=a.invoke('empty-map'),marker=a.sourceArray([false]),key=a.number(1),it=name==='value-source-iterator-advance'?a.invoke('entries',[map]):null,frame=a.frame(1);a.frameSet(frame,0,map);\n  assert.throws(()=>a.invoke(entry,it?[it,marker]:entry==='lookup'?[map,key]:[map,key,marker]),e=>e instanceof WebAssembly.RuntimeError);assert.equal(a.stats().frameDepth,1);assert.deepEqual(read(a,marker),[expected]);a.leaveFrame(frame);for(const value of[map,marker,key,it])a.release(value);a.collect();assert.equal(a.live(),0);\n }\n});\ntest('source APIs preserve invalid-handle errors and earlier constructor failures without overwriting their codes',()=>{\n const e=new WebAssembly.Instance(new WebAssembly.Module(bytes)).exports,h=e['heap-new'](64,4096,65536);\n for(const[name,args]of[['value-source-collection-get',[4,0]],['value-source-collection-put',[4,0,0]],['value-source-collection-has',[4,0]],['value-source-collection-own',[4,0]],['value-source-iterator-new',[4,0]],['value-source-iterator-advance',[4]],['value-source-iterator-next',[4]],['value-source-method-check',[4,0]],['value-source-method',[4,0,0,0]],['value-source-collection-new',[15,4]]]){e[name](h,...args);assert.equal(e['last-error'](),1,name);}\n const m=e['value-source-collection-new'](h,15,3);e['heap-pin'](h,m);for(const[name,args]of[['value-source-collection-own',[m,2]],['value-source-iterator-new',[m,3]],['value-source-method-check',[m,10]],['value-source-method',[m,10,0,0]],['value-source-collection-new',[17,3]]]){e[name](h,...args);assert.equal(e['last-error'](),3,name);}e['heap-release'](h,m);e['heap-collect'](h);assert.equal(e['heap-live'](h),0);\n});\ntest('ordinary get and has leaves preserve allocation-free table queries without installing private frames',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const m=a.invoke('empty-map'),s=a.invoke('empty-set'),key=a.string('key');const out=a.invoke('set-value',[m,key,true]);a.release(out);const added=a.invoke('add-value',[s,key]);a.release(added);a.collect();const before=a.stats();\n for(let i=0;i<256;i++){assert.equal(call(a,'lookup',[m,key]),true);assert.equal(call(a,'has',[m,key]),true);assert.equal(call(a,'has',[s,key]),true);}\n const after=a.stats();assert.equal(after.usedBytes,before.usedBytes);assert.equal(after.collections,before.collections);assert.equal(after.frameDepth,0);for(const v of[m,s,key])a.release(v);a.collect();assert.equal(a.live(),0);\n});\ntest('failed Map construction consumes only the invalid step and does not close a live native iterator',()=>{\n const a=instantiateManagedRuntime(bytes);a.auto(1);const pair=a.sourceArray([true,false]),input=a.sourceArray([true,pair]),it=a.invoke('values',[input]),reference=[true,[true,false]].values();assert.throws(()=>new Map(reference));assert.throws(()=>a.invoke('from-map',[it]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.deepEqual(call(a,'next',[it]),reference.next());assert.deepEqual(call(a,'next',[it]),reference.next());\n const other=a.invoke('values',[input]),next=a.string('next');call(a,'write',[other,next,false]);assert.throws(()=>a.invoke('from-set',[other]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');for(const v of[pair,input,it,other,next])a.release(v);a.collect();assert.equal(a.live(),0);\n});\ntest('malformed collection IR and ignored unsupported raw operands are source-bound refusals',()=>{\n for(const source of['(defun f () (let ((Map nil)) (new (js* \"Map\") (js* \"unsupported()\"))))','(defun f () (let ((globalThis nil)) (new globalThis.Set (js* \"unsupported()\"))))','(defun f () (new globalThis.Map nil (js* \"unsupported()\")))','(defun f () (if false (new globalThis.Array (js* \"unsupported()\")) nil))']){const ir=b.compiler.compile_ir_string(source+' (export f)','bad-collection.eli');assert.throws(()=>b.managed.emit_managed_wasm(ir,runtime),e=>e.eliscriptDiagnostic?.code==='ELI-B0001'&&e.eliscriptDiagnostic.location.file==='bad-collection.eli');}\n const ir=b.compiler.compile_ir_string('(defun f () (new globalThis.Map)) (expor