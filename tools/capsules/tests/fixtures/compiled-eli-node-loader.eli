(module capsules.tests.fixtures.compiled-eli-node-loader
  (js* "import { readFile } from \"node:fs/promises\";\n\nexport async function load(url, context, nextLoad) {\n  if (url.endsWith(\".eli\")) {\n    return {\n      format: \"module\",\n      shortCircuit: true,\n      source: await readFile(new URL(url), \"utf8\"),\n    };\n  }\n  return nextLoad(url, context);\n}\n"))
