(module capsules.tests.js-array-text-fast-path.test
  (js* "import {test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {readFile,writeFile,mkdtemp,rm,mkdir,readdir} from 'node:fs/promises';\nimport {resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nimport {pathToFileURL} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nconst runtimeSource=await readFile(new URL('../runtime/array-text.mjs',import.meta.url),'utf8');\nconst {c}=await import(new URL('../runtime/array-text.mjs',import.meta.url));\n\nfunction observe(capture){const events=[],values=[null,'old',null],item={toString(){events.push('item.toString');values[1]='changed';return{};},valueOf(){events.push('item.valueOf');return 'first';}},separator={toString(){events.push('separator');values.push('ignored');return '|';}};values[0]=item;Object.defineProperty(values,2,{get(){events.push('get2');return new String('boxed');},configurable:true});const array=new Proxy(values,{get(target,key,receiver){events.push('get:'+String(key));return Reflect.get(target,key,receiver);}});return{result:capture(array,'join')(separator),events};}\nfunction checkSemantics(capture){assert.deepEqual(observe(capture),observe((values,key)=>(...args)=>Reflect.apply(values[key],values,args)));for(const values of[[],Array(4),['','中😀','\\ud800'],[null,undefined,true,false,NaN,-0,Infinity,1n],[[1,null],['x']],['first',new String('boxed')]])assert.equal(capture(values,'join')('|'),values.join('|'));assert.throws(()=>capture([Symbol('x')],'join')(),TypeError);let calls=0;const object={[Symbol.toPrimitive](hint){calls++;assert.equal(hint,'string');return 'opaque';}};assert.equal(capture(['a',object,'b'],'join')(':'),'a:opaque:b');assert.equal(calls,1);const cyclic=['a'];cyclic.push(cyclic);assert.throws(()=>capture(cyclic,'join')(),e=>e instanceof TypeError&&e.eliscriptDiagnostic?.code==='ELI-RT0009');cyclic.length=1;assert.equal(capture(cyclic,'join')(),'a');const reentrant=[];Object.defineProperty(reentrant,0,{get(){return capture(reentrant,'join')();},configurable:true});assert.throws(()=>capture(reentrant,'join')(),e=>e.eliscriptDiagnostic?.code==='ELI-RT0009');delete reentrant[0];assert.equal(capture(reentrant,'join')(),'');const bad=['a',{toString(){throw object;}}];assert.throws(()=>capture(bad,'join')(),e=>e===object);bad.pop();assert.equal(capture(bad,'join')(),'a');const mutable=['a','b'];let effects=0;const original=capture(mutable,'join');mutable.join=()=>{throw Error('must use captured method');};assert.equal(original((effects++,'|'),effects++),'a|b');assert.equal(effects,2);}\ntest('boxed values, hooks, mutations, getter cycles, captured methods and cleanup retain independent native semantics',()=>{checkSemantics(c);});\n\ntest('captured intrinsics survive later global and prototype replacement while captured source methods retain identity',()=>{const script=`import assert from 'node:assert/strict';const{c}=await import(process.argv[1]);const saved={String,apply:Reflect.apply,has:WeakSet.prototype.has,add:WeakSet.prototype.add,delete:WeakSet.prototype.delete,join:Array.prototype.join,toString:Array.prototype.toString,objectString:Object.prototype.toString};const values=['a','中😀'],captured=c(values,'join'),fail=()=>{throw Error('mutated intrinsic');};let result,error;try{globalThis.String=fail;Reflect.apply=fail;WeakSet.prototype.has=fail;WeakSet.prototype.add=fail;WeakSet.prototype.delete=fail;Array.prototype.join=fail;Array.prototype.toString=fail;Object.prototype.toString=fail;result=captured('|');}catch(e){error=e;}finally{globalThis.String=saved.String;Reflect.apply=saved.apply;WeakSet.prototype.has=saved.has;WeakSet.prototype.add=saved.add;WeakSet.prototype.delete=saved.delete;Array.prototype.join=saved.join;Array.prototype.toString=saved.toString;Object.prototype.toString=saved.objectString;}assert.equal(error,undefined);assert.equal(result,'a|中😀');`;\n for(const host of['node','bun']){const child=spawnSync(host,['--input-type=module','-e',script,pathToFileURL(resolve('runtime/array-text.mjs')).href],{encoding:'utf8',timeout:30000});assert.equal(child.status,0,host+': '+child.stderr);}\n});\n\ntest('public Seed and all thirteen compiler modules retain three-generation String join artifacts, Source Maps and executable semantics',async()=>{const directory=await mkdtemp(resolve(tmpdir(),'eliscript-string-fast-seed-'));try{const bootstrap=resolve(directory,'bootstrap'),built=spawnSync(resolve('bin/eliscript-bootstrap'),[],{encoding:'utf8',timeout:30000,env:{...process.env,ELISCRIPT_BOOTSTRAP_OUT_DIR:bootstrap}});assert.equal(built.status,0,built.stderr);let compiler=await import(pathToFileURL(resolve(bootstrap,'compiler.mjs')).href);const source='(defun join (values separator) (js-call values :join separator)) (defun text (values) (js-call values :toString)) (export join text)',input=resolve(directory,'join.eli'),output=resolve(directory,'join.mjs');await writeFile(input,source);const seeded=spawnSync(resolve('bin/eliscript-seed'),['--output',output,input],{encoding:'utf8',timeout:30000});assert.equal(seeded.status,0,seeded.stderr);const canonical=compiler.compile_string(source,input);assert.equal(await readFile(output,'utf8'),canonical);const files=(await readdir('bootstrap/compiler')).filter(file=>file.endsWith('.eli')).sort();assert.equal(files.length,13);let originals;for(let generation=0;generation<3;generation++){assert.equal(compiler.compile_string(source,input),canonical);const m=await import('data:text/javascript;base64,'+Buffer.from(canonical).toString('base64'));for(const value of[[],['a','','中😀','\\ud800'],[null,-0,1n,new String('boxed')]])assert.equal(m.join(value,'|'),value.join('|'));const cycle=[];cycle.push(cycle);assert.throws(()=>m.join(cycle,','),e=>e.eliscriptDiagnostic?.code==='ELI-RT0009');const out=resolve(directory,'g'+generation);await mkdir(out);const artifacts=[];for(const file of files){const filename=resolve('bootstrap/compiler',file),source=await readFile(filename,'utf8'),target=file.replace(/\\.eli$/,'.mjs'),emission=compiler.compile_string_with_source_map(source,filename,target,file);artifacts.push([file,emission.javascript,emission.sourceMap]);await writeFile(resolve(out,target),emission.javascript);}if(originals)assert.deepEqual(artifacts,originals);else originals=artifacts;compiler=await import(pathToFileURL(resolve(out,'compiler.mjs')).href);}const child=spawnSync('node',['--input-type=module','-e',`import assert from 'node:assert/strict';const m=await import(process.argv[1]);assert.equal(m.join(['a','','中😀'],'|'),'a||中😀');const cycle=[];cycle.push(cycle);assert.throws(()=>m.join(cycle),e=>e.eliscriptDiagnostic?.code==='ELI-RT0009');`,pathToFileURL(output).href],{encoding:'utf8',timeout:30000});assert.equal(child.status,0,child.stderr);}finally{await rm(directory,{recursive:true,force:true});}},30000);\n\nconst weakMeasuredSource=runtimeSource.replace('const weakHas = WeakSet.prototype.has, weakAdd = WeakSet.prototype.add, weakDelete = WeakSet.prototype.delete;',`const primitiveWeakHas = WeakSet.prototype.has, primitiveWeakAdd = WeakSet.prototype.add, primitiveWeakDelete = WeakSet.prototype.delete;\nconst weakCounts = {has:0,add:0,delete:0};\nconst weakHas = function(value) {weakCounts.has++;return apply(primitiveWeakHas,this,[value]);};\nconst weakAdd = function(value) {weakCounts.add++;return apply(primitiveWeakAdd,this,[value]);};\nconst weakDelete = function(value) {weakCounts.delete++;return apply(primitiveWeakDelete,this,[value]);};`)+`\\nexport function weakOperations() {return {...weakCounts};}`;\nconst weakMeasured=await import('data:text/javascript;base64,'+Buffer.from(weakMeasuredSource).toString('base64'));\ntest('outermost joins avoid all three WeakSet calls while every nested array retains its original membership checks and cleanup',()=>{assert.equal(weakMeasured.c(['a','b'],'join')(),'a,b');assert.deepEqual(weakMeasured.weakOperations(),{has:0,add:0,delete:0});const shared=['x'];assert.equal(weakMeasured.c([shared,shared],'join')('|'),'x|x');assert.deepEqual(weakMeasured.weakOperations(),{has:2,add:2,delete:2});});\ntest('root registration follows length and separator conversion and nested failures restore each independent active frame',()=>{const events=[],values=['a','b'],separator={toString(){events.push('separator');events.push(c(values,'join')(''));return '|';}};assert.equal(c(values,'join')(separator),'a|b');assert.deepEqual(events,['separator','ab']);const shared=['x'],outer=[shared,shared];assert.equal(c(outer,'join')(),'x,x');assert.equal(c(shared,'join')(),'x');const first=['safe'],second=[Symbol('bad')],root=[{toString(){return c(second,'join')();}}];assert.throws(()=>c(root,'join')(),TypeError);second[0]='fixed';assert.equal(c(root,'join')(),'fixed');assert.equal(c(first,'join')(),'safe');const recursive=[{toString(){return c(second,'join')({toString(){return c(recursive,'join')();}});}}];assert.throws(()=>c(recursive,'join')(),e=>e.eliscriptDiagnostic?.code==='ELI-RT0009');recursive[0]='recovered';assert.equal(c(recursive,'join')(),'recovered');assert.equal(c(second,'join')(),'fixed');});\n"))
