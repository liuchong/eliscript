(module capsules.tests.wasm-managed-replacement.test
  (js* "import {beforeAll, afterAll, test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {readFile, writeFile, mkdtemp, rm} from 'node:fs/promises';\nimport {resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nimport {pathToFileURL} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nimport {buildBackends} from '../tools/backends/build.mjs';\nimport {instantiateManagedRuntime} from '../tools/backends/managed-runtime.mjs';\nlet b, runtime, directory;\nbeforeAll(async () => {\n  directory = await mkdtemp(resolve(tmpdir(), 'eliscript-managed-replacement-'));\n  b = await buildBackends({outputRoot: directory});\n  runtime = b.compiler.compile_ir_string(await readFile('bootstrap/runtime/memory.eli', 'utf8'), 'runtime.eli');\n}, 120000);\nafterAll(async () => {if (directory) await rm(directory, {recursive: true, force: true});});\nasync function compile(source) {\n  const p = b.compiler.compile_ir_string(source, 'replacement.eli'), javascript = b.compiler.emit_ir_string(p);\n  return {p, javascript, js: await import('data:text/javascript;base64,' + Buffer.from(javascript).toString('base64')), emit() {\n    const before = JSON.stringify(p), bytes = Uint8Array.from(b.managed.emit_managed_wasm(p, runtime));\n    assert.equal(JSON.stringify(p), before); assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(bytes)), []);\n    return bytes;\n  }};\n}\nconst moduleInstances = new WeakSet();\nfunction instance(c, options) {\n  const bytes = c.emit(), module = new WebAssembly.Module(bytes), a = instantiateManagedRuntime(bytes, options);\n  if (WebAssembly.Module.exports(module).some(item => item.name === '__eliscript_module_close')) moduleInstances.add(a);\n  return a;\n}\nconst box = (a, x) => typeof x === 'string' ? a.string(x) : typeof x === 'number' ? a.number(x) : x;\nfunction check(a, c, name, inputs) {\n  const args = inputs.map(x => box(a, x)), expected = c.js[name.replaceAll('-', '_')](...inputs), out = a.invoke(name, args);\n  assert.equal(a.readString(out), expected, JSON.stringify(inputs));\n  for (const value of [...args, out]) a.release(value); a.collect(); assert.equal(a.stats().frameDepth, 0);\n}\nfunction finish(a, values = []) {for (const value of values) a.release(value); if (moduleInstances.has(a)) a.closeModule(); a.collect(); assert.equal(a.live(), 0); assert.equal(a.stats().frameDepth, 0);}\nconst ordinary = '(defun f (text search replacement) (js-call text :replace search replacement)) (export f)';\ntest('independent Node executes the original ordinary replacement and formatter-style regular expression', async () => {\n  const c = await compile(ordinary + ' (defun trim-comment (text) (js-call text :replace (js* \"/[ \\\\t]+$/u\") \"\")) (export trim-comment)');\n  const file = resolve(directory, 'reference.mjs'); await writeFile(file, c.javascript);\n  const child = spawnSync('node', ['--input-type=module', '-e', `import assert from 'node:assert/strict';const m=await import(process.argv[1]);assert.equal(m.f('aba','a',\"[$&][$\\x60][$']$$$1\"),\"[a][][ba]$$1ba\");assert.equal(m.trim_comment(';中文😀 \\t'),';中文😀');`, pathToFileURL(file).href], {encoding: 'utf8', timeout: 30000});\n  assert.equal(child.status, 0, child.stderr);\n});\ntest('ordinary replacement preserves first occurrence, empty matches, exact primitive conversions and template literals', async () => {\n  const c = await compile(ordinary), a = instance(c); a.auto(1);\n  for (const text of ['', 'ababa', '中😀\\ud800x\\udfff', 'undefinednulltruefalse0NaNInfinity'])\n    for (const search of ['', 'a', 'missing', '😀', '\\ud800', undefined, null, true, false, -0, .5, NaN, Infinity])\n      for (const replacement of ['', 'X', \"$$:$&:$`:$':$0:$1:$01:$99:$<name>\", undefined, null, true, .5, -0, NaN]) check(a, c, 'f', [text, search, replacement]);\n  finish(a);\n});\ntest('existing regular expressions replace exact captures including absent groups and two-digit template fallback', async () => {\n  for (const pattern of ['/[ \\\\t]+$/u', '/(a)|(b)/', '/(a)(b)?/', '/(?:)/u', '/😀/u', '/(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)/']) {\n    const c = await compile(`(defconst pattern (js* ${JSON.stringify(pattern)})) (defun f (text replacement) (js-call text :replace pattern replacement)) (export f)`), a = instance(c); a.auto(1);\n    for (const text of ['', 'zzab', 'a', 'b', ';中😀 \\t', '😀\\ud800', 'x\\n', 'zzabcdefghij!']) for (const replacement of ['', \"$&:$1:$2:$01:$02:$10:$20:$99:$`:$':$$\", undefined, -0]) check(a, c, 'f', [text, replacement]);\n    finish(a);\n  }\n});\ntest('replacement callbacks receive captured text, absent values, exact UTF16 offsets and original input through the ordinary ABI', async () => {\n  const c = await compile('(defun f (text search) (js-call text :replace search (lambda (match index original) (str \"<\" match \":\" index \":\" original \">\")))) (defun g (text) (js-call text :replace (js* \"/(a)|(b)/\") (lambda (match one two index original) (str \"<\" match \":\" one \":\" two \":\" index \":\" original \">\")))) (export f g)'), a = instance(c); a.auto(1);\n  for (const text of ['', 'ababa', '😀b', '中a\\ud800']) {for (const search of ['', 'a', 'missing', '😀']) check(a, c, 'f', [text, search]); check(a, c, 'g', [text]);}\n  finish(a);\n});\n\ntest('callback replacements execute exactly once only after a match, preserve closures and stringify results without interpreting templates', async () => {\n  const c = await compile('(defun f (text search replacement trace) (js-call text :replace search replacement (put trace :extra 7))) (defun factory (trace value) (lambda (match index original) (put trace :calls (1+ (get trace :calls 0))) (put trace :match match) (put trace :index index) (put trace :original original) value)) (export f factory)'), a = instance(c); a.auto(1);\n  for (const returned of [undefined, null, true, -0, .5, NaN, Infinity, \"$&$1$`$'\"]) {\n    const trace = a.sourceObject({}), value = box(a, returned), fn = a.invoke('factory', [trace, value]), input = a.string('😀aba'), search = a.string('a');\n    const out = a.invoke('f', [input, search, fn, trace]); assert.equal(a.readString(out), '😀aba'.replace('a', () => returned));\n    for (const [key, expected] of [['extra', 7], ['calls', 1], ['match', 'a'], ['index', 2], ['original', '😀aba']]) {\n      const k = a.string(key), got = a.objectGet(trace, k); assert.equal(got.kind === 4 ? a.readNumber(got) : a.readString(got), expected); a.release(k); a.release(got);\n    }\n    const absent = a.string('missing'), unchanged = a.invoke('f', [input, absent, fn, trace]); assert.equal(a.readString(unchanged), '😀aba');\n    const key = a.string('calls'), count = a.objectGet(trace, key); assert.equal(a.readNumber(count), 1);\n    for (const x of [trace, value, fn, input, search, out, absent, unchanged, key, count]) a.release(x); a.collect(); assert.equal(a.stats().frameDepth, 0);\n  }\n  finish(a);\n});\n\ntest('same-named object methods are captured before all argument effects and missing noncallable methods fail afterwards', async () => {\n  const c = await compile('(defun factory () (js-object :replace (lambda (one two) two))) (defun f (object trace) (js-call object :replace (put object :replace (lambda (one two) 99)) (put trace :visited 11))) (defun g (object trace) (js-call object :replace (put trace :visited 17) \"x\")) (export factory f g)'), a = instance(c); a.auto(1);\n  const ref = {}, object = c.js.factory(); assert.equal(c.js.f(object, ref), 11); assert.equal(ref.visited, 11);\n  const o = a.invoke('factory'), trace = a.sourceObject({}), out = a.invoke('f', [o, trace]); assert.equal(a.readNumber(out), 11);\n  for (const value of [null, undefined, true, false, 1, {}]) {\n    const v = value && typeof value === 'object' ? a.sourceObject({}) : box(a, value), seen = a.sourceObject({});\n    assert.throws(() => a.invoke('g', [v, seen]), e => e.eliscriptDiagnostic?.code === 'ELI-RT0003');\n    const key = a.string('visited'), got = a.objectGet(seen, key); assert.equal(got === undefined ? undefined : a.readNumber(got), value === null || value === undefined ? undefined : 17);\n    for (const x of [v, seen, key, got]) a.release(x); assert.equal(a.stats().frameDepth, 0);\n  }\n  finish(a, [o, trace, out]);\n});\n\ntest('deterministic UTF16 replacement inputs agree with the unchanged JS source under collecting GC', async () => {\n  const c = await compile(ordinary), a = instance(c); a.auto(1); let state = 0x49a61e23;\n  const next = () => state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n  for (let i = 0; i < 512; i++) {\n    const text = String.fromCharCode(...Array.from({length: next() % 64}, () => next() >>> 16));\n    const first = next() % (text.length + 1), search = i % 3 ? text.slice(first, first + next() % 9) : String.fromCharCode(next() >>> 16);\n    const replacement = ['$$', '$&', \"$`\", \"$'\", '$0$01$10$99$<x>', '\\ud800😀', String.fromCharCode(next() >>> 16)][next() % 7]; check(a, c, 'f', [text, search, replacement]);\n  }\n  finish(a);\n});\n\ntest('replacement grows actual memory and capacity failures retain exact text and caller-owned roots', async () => {\n  const c = await compile(ordinary), a = instance(c, {maxSlots: 4096, initialBytes: 131072, maxBytes: 4194304}); a.auto(1);\n  const original = '中😀\\ud800'.repeat(10000), text = a.string(original), search = a.string('😀'), replacement = a.string(\"$`$&$'\"), before = a.stats().capacityBytes;\n  const out = a.invoke('f', [text, search, replacement]); assert.equal(a.readString(out), original.replace('😀', \"$`$&$'\")); assert(a.stats().capacityBytes > before); assert(a.stats().collections > 0);\n  finish(a, [text, search, replacement, out]);\n  const small = instance(c, {maxSlots: 64, initialBytes: 8192, maxBytes: 8192}); small.auto(1);\n  const s = small.string('held😀\\ud800'), needle = small.string('held'), insert = small.string('x'.repeat(1024)), held = small.number(-0), outer = small.frame(1); small.frameSet(outer, 0, held);\n  assert.throws(() => small.invoke('f', [s, needle, insert]), e => e.eliscriptDiagnostic?.code === 'ELI-RT0002'); assert.equal(small.stats().frameDepth, 1); assert.equal(small.readString(s), 'held😀\\ud800'); assert(Object.is(small.readNumber(held), -0)); small.leaveFrame(outer); finish(small, [s, needle, insert, held]);\n});\n\ntest('actual matching and output WASM traps unwind private frames and retain preceding conversion failures', async () => {\n  const source = await readFile('bootstrap/runtime/memory.eli', 'utf8'), c = await compile(ordinary);\n  for (const [name, formals] of [['heap-text-search-unit', 'data length index reverse'], ['heap-replacement-write-range', 'heap builder text first last']]) {\n    const start = source.indexOf('  (defun ' + name + ' '), end = source.indexOf('  (defun ', start + 3); assert(start >= 0 && end > start);\n    const ir = b.compiler.compile_ir_string(source.slice(0, start) + `(defun ${name} (${formals}) (load-u16 4294967295))\\n` + source.slice(end), 'replacement-trap.eli');\n    const a = instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_wasm(c.p, ir))); a.auto(1);\n    const text = a.string('xxx'), search = a.string('x'), insert = a.string('y'), bad = a.sourceObject({}), held = a.number(-0), outer = a.frame(1); a.frameSet(outer, 0, held);\n    for (const args of [[text, bad, insert], [text, search, bad]]) {assert.throws(() => a.invoke('f', args), e => e.eliscriptDiagnostic?.code === 'ELI-RT0003'); assert.equal(a.stats().frameDepth, 1);}\n    assert.throws(() => a.invoke('f', [text, search, insert]), WebAssembly.RuntimeError); assert.equal(a.stats().frameDepth, 1); assert.equal(a.readString(text), 'xxx'); assert(Object.is(a.readNumber(held), -0)); a.leaveFrame(outer); finish(a, [text, search, insert, bad, held]);\n  }\n});\n\ntest('Node independently executes the identical zero-import replacement WASM including closure callback captures', async () => {\n  const c = await compile('(defconst pattern (js* \"/(a)|(b)/\")) (defun f (s r) (js-call s :replace pattern r)) (defun g (s) (js-call s :replace pattern (lambda (match one two index original) (str match \":\" one \":\" two \":\" index \":\" original)))) (export f g)'), wasm = resolve(directory, 'replacement.wasm'); await writeFile(wasm, c.emit());\n  const child = spawnSync('node', ['--input-type=module', '-e', `import assert from 'node:assert/strict';import{readFileSync}from'node:fs';const{instantiateManagedRuntime}=await import(process.argv[1]),a=instantiateManagedRuntime(readFileSync(process.argv[2]));a.auto(1);const s=a.string('😀b'),r=a.string(\"$1:$2:$01:$20:$&\");const out=a.invoke('f',[s,r]);assert.equal(a.readString(out),'😀b'.replace(/(a)|(b)/,\"$1:$2:$01:$20:$&\"));const callback=a.invoke('g',[s]);assert.equal(a.readString(callback),'😀b'.replace(/(a)|(b)/,(m,a,b,i,s)=>m+':'+a+':'+b+':'+i+':'+s));for(const x of[s,r,out,callback])a.release(x);a.closeModule();a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);`, pathToFileURL(resolve('tools/backends/managed-runtime.mjs')).href, wasm], {encoding: 'utf8', timeout: 30000}); assert.equal(child.status, 0, child.stderr);\n});\n"))
