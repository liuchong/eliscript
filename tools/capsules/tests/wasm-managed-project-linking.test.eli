(module capsules.tests.wasm-managed-project-linking.test
  (js* "import {beforeAll,afterAll,test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {mkdtemp,readFile,writeFile,mkdir,rm} from 'node:fs/promises';\nimport {resolve,dirname} from 'node:path';\nimport {tmpdir} from 'node:os';\nimport {pathToFileURL} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nimport {buildBackends,root} from '../tools/backends/build.mjs';\nimport {instantiateManagedRuntime} from '../tools/backends/managed-runtime.mjs';\nlet directory,b,runtime,sequence=0;\nbeforeAll(async()=>{directory=await mkdtemp(resolve(tmpdir(),'eliscript-project-links-'));b=await buildBackends({outputRoot:directory});runtime=b.compiler.compile_ir_string(await readFile(resolve(root,'bootstrap/runtime/memory.eli'),'utf8'),'runtime.eli')},120000);\nafterAll(async()=>{if(directory)await rm(directory,{recursive:true,force:true})});\nasync function project(sources,entry='main.mjs'){\n const base=resolve(directory,'project-'+sequence++);await mkdir(base);\n const modules=[];for(const[id,source]of Object.entries(sources)){const program=b.compiler.compile_ir_string(source,id.replace(/\\.mjs$/,'.eli'));modules.push({id,program});const file=resolve(base,id);await mkdir(dirname(file),{recursive:true});await writeFile(file,b.compiler.emit_ir_string(program));}\n return{modules,entry,base,reference:()=>import(pathToFileURL(resolve(base,entry)).href)};\n}\nfunction emit(p){const saved=p.modules.map(({id,program})=>[id,b.compiler.serialize_ir_program(program)]),bytes=Uint8Array.from(b.managed.emit_managed_project_wasm(p.modules,p.entry,runtime));assert.deepEqual(p.modules.map(({id,program})=>[id,b.compiler.serialize_ir_program(program)]),saved);assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(bytes)),[]);return bytes}\nfunction number(a,name,args=[]){const out=a.invoke(name,args);try{return a.readNumber(out)}finally{a.release(out)}}\nfunction finish(a,values=[],module=true){for(const x of values)a.release(x);if(module)a.closeModule();a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0)}\nconst liveSources={\n 'lib.mjs':'(defvar counter 0) (defun tick () (setq counter (1+ counter))) (defun current () counter) (export counter tick current)',\n 'main.mjs':'(import \"./lib.mjs\" counter tick current) (defun read () counter) (defun advance () (tick) (current)) (export counter tick read advance)'\n};\ntest('named imports and reexports share the original live binding and execute entirely in WASM',async()=>{\n const p=await project(liveSources),ref=await p.reference();assert.equal(ref.advance(),1);const a=instantiateManagedRuntime(emit(p));a.auto(1);assert.equal(number(a,'advance'),1);const value=a.getExport('counter');assert.equal(a.readNumber(value),ref.counter);a.release(value);for(let i=0;i<24;i++){assert.equal(number(a,'advance'),ref.advance());a.collect();assert.equal(number(a,'read'),ref.read())}finish(a)\n});\ntest('module evaluation follows import source order through diamonds and executes each body once',async()=>{\n const p=await project({\n 'state.mjs':'(defconst log (js-array)) (defun mark (x) (js-call log :push x)) (export log mark)',\n 'left.mjs':'(import \"./state.mjs\" mark) (mark 1) (defconst left 11) (export left)',\n 'right.mjs':'(import \"./state.mjs\" mark) (mark 2) (defconst right 22) (export right)',\n 'main.mjs':'(import \"./left.mjs\" left) (import \"./right.mjs\" right) (import \"./state.mjs\" log mark) (mark 3) (defun sum () (+ left right)) (export log sum)'\n });const ref=await p.reference();assert.deepEqual(ref.log,[1,2,3]);const bytes=emit(p),a=instantiateManagedRuntime(bytes);a.initializeModule();a.initializeModule();assert.equal(number(a,'sum'),ref.sum());const log=a.getExport('log');assert.equal(a.length(log),3);for(let i=0;i<3;i++){const v=a.get(log,i);assert.equal(a.readNumber(v),ref.log[i]);a.release(v)}finish(a,[log]);assert.deepEqual(emit({...p,modules:[...p.modules].reverse()}),bytes)\n});\ntest('distinct module globals and functions preserve lexical and closure shadowing',async()=>{\n const p=await project({\n 'other.mjs':'(defvar value 9) (defun read-other () value) (export read-other)',\n 'main.mjs':'(import \"./other.mjs\" read-other) (defvar value 3) (defun read () value) (defun local (value) (let ((value (+ value 1))) ((lambda () (+ value (read-other)))))) (defun parallel () (let ((value 7) (copy value)) copy)) (defun sequential () (let* ((value 7) (copy value)) copy)) (export read read-other local parallel sequential)'\n });const ref=await p.reference(),a=instantiateManagedRuntime(emit(p));a.auto(1);const x=a.number(2);for(const[name,args,expected]of[['read',[],ref.read()],['read_other',[],ref.read_other()],['local',[x],ref.local(2)],['parallel',[],ref.parallel()],['sequential',[],ref.sequential()]])assert.equal(number(a,name,args),expected);finish(a,[x])\n});\ntest('cyclic modules instantiate hoisted functions before source-ordered evaluation',async()=>{\n const p=await project({\n 'main.mjs':'(import \"./other.mjs\" read-other) (defconst value (+ (read-other) 1)) (defun read () value) (export read value)',\n 'other.mjs':'(import \"./main.mjs\" read) (defconst value 7) (defun read-other () value) (export read-other)'\n });const ref=await p.reference(),a=instantiateManagedRuntime(emit(p));assert.equal(number(a,'read'),ref.read());finish(a)\n});\ntest('cyclic early reads preserve TDZ with independent Node control and cached cleanup',async()=>{\n const p=await project({\n 'main.mjs':'(import \"./other.mjs\" other) (defconst value other) (defun read () value) (export value read)',\n 'other.mjs':'(import \"./main.mjs\" read) (defconst other (read)) (export other)'\n });const control=spawnSync('node',[resolve(p.base,p.entry)],{encoding:'utf8',timeout:30000});assert.equal(control.status,1);assert.match(control.stderr,/ReferenceError/);const a=instantiateManagedRuntime(emit(p),{initializeModule:false});a.auto(1);const keep=a.number(-0),frame=a.frame(1);a.frameSet(frame,0,keep);for(let i=0;i<2;i++){assert.throws(()=>a.initializeModule(),e=>e.eliscriptDiagnostic?.code==='ELI-RT0008');a.collect();assert.equal(a.stats().frameDepth,1);assert.equal(a.live(),2)}a.leaveFrame(frame);finish(a,[keep])\n});\ntest('default imports preserve export-default snapshot evaluation and original function identity',async()=>{\n const p=await project({\n 'lib.mjs':'(defvar value -0.0) (defun change (x) (setq value x)) (export-default value) (export value change)',\n 'main.mjs':'(import \"./lib.mjs\" :default initial value change) (defun before () initial) (defun current () value) (export before current change)'\n });const ref=await p.reference(),a=instantiateManagedRuntime(emit(p));assert(Object.is(number(a,'before'),ref.before()));const n=a.number(7),out=a.invoke('change',[n]);ref.change(7);assert.equal(number(a,'current'),ref.current());assert(Object.is(number(a,'before'),ref.before()));finish(a,[n,out])\n});\n\ntest('two reexport names may retain the same original binding and object identity',async()=>{\n const p=await project({\n 'leaf.mjs':'(defconst value (js-array -0.0)) (export-default value)',\n 'left.mjs':'(import \"./leaf.mjs\" :default left) (export left)',\n 'right.mjs':'(import \"./leaf.mjs\" :default right) (export right)',\n 'main.mjs':'(import \"./left.mjs\" left) (import \"./right.mjs\" right) (export left right)'\n });const ref=await p.reference();assert.equal(ref.left,ref.right);const a=instantiateManagedRuntime(emit(p)),left=a.getExport('left'),right=a.getExport('right');assert(a.keyEqual(left,right));finish(a,[left,right])\n});\ntest('hygienic project names cannot capture source locals or enable shadowed constructors',async()=>{\n const p=await project({'main.mjs':'(defvar value 3) (defun f ($eliscript_link_0_0) (+ value $eliscript_link_0_0)) (export f)'}),ref=await p.reference(),a=instantiateManagedRuntime(emit(p)),x=a.number(4);assert.equal(number(a,'f',[x]),ref.f(4));finish(a,[x]);\n const shadow=await project({'main.mjs':'(defvar globalThis nil) (defun f () (if false (new globalThis.Map) nil)) (export f)'});assert.throws(()=>emit(shadow),e=>e.eliscriptDiagnostic?.code==='ELI-B0001'&&e.eliscriptDiagnostic.phase==='managed-link'&&e.eliscriptDiagnostic.location.file==='main.eli')\n});\ntest('link validation preserves input IR and reports missing modules exports and forged import assignments',async()=>{\n for(const sources of[{'main.mjs':'(import \"./absent.mjs\" value) (export value)'},{'other.mjs':'(defconst other 7) (export other)','main.mjs':'(import \"./other.mjs\" value) (export value)'},{'main.mjs':'(import \"../escape.mjs\" value) (export value)'}]){const p=await project(sources);assert.throws(()=>emit(p),e=>e.eliscriptDiagnostic?.code==='ELI-B0001'&&e.eliscriptDiagnostic.phase==='managed-link'&&e.eliscriptDiagnostic.location.file==='main.eli')}\n const p=await project({'lib.mjs':'(defvar value 1) (export value)','main.mjs':'(import \"./lib.mjs\" value) (defvar local 0) (defun write () (setq local 7)) (export write)'}),program=p.modules.find(x=>x.id==='main.mjs').program;program.body.find(x=>x.kind==='function-declaration').children[0].children[0].value='value';assert.throws(()=>emit(p),e=>e.eliscriptDiagnostic?.code==='ELI-B0001'&&/assign.*import/.test(e.eliscriptDiagnostic.message))\n});\ntest('cyclic and malformed program records retain structured schema diagnostics',async()=>{\n const p=await project({'main.mjs':'(defun f () 7) (export f)'}),cyclic=structuredClone(p.modules);cyclic[0].program.body[0].children.push(cyclic[0].program.body[0]);assert.throws(()=>b.managed.emit_managed_project_wasm(cyclic,p.entry,runtime),e=>typeof e.eliscriptDiagnostic?.code==='string');\n for(const modules of[[],[null],[p.modules[0],p.modules[0]],[{id:'./main.mjs',program:p.modules[0].program}]])assert.throws(()=>b.managed.emit_managed_project_wasm(modules,p.entry,runtime),e=>e.eliscriptDiagnostic?.code==='ELI-B0001')\n});\n\ntest('namespace imports share identity live properties readonly writes and snapshot copies',async()=>{\n const p=await project({\n 'lib.mjs':'(defvar counter 0) (defun tick () (setq counter (1+ counter))) (defun read-value () counter) (export counter tick read-value) (export-default (js-array -0.0))',\n 'main.mjs':'(import \"./lib.mjs\" :as ns) (import \"./lib.mjs\" :as again) (defun read () (get ns :counter)) (defun advance () (funcall (get ns :tick))) (defun keys () (object-keys ns)) (defun copy () (object-assoc ns :extra 7)) (defun write () (put ns :counter 9)) (export ns again read advance keys copy write)'\n });const ref=await p.reference();assert.equal(ref.ns,ref.again);assert.throws(()=>ref.write(),TypeError);const a=instantiateManagedRuntime(emit(p));a.auto(1);const ns=a.getExport('ns'),again=a.getExport('again');assert(a.keyEqual(ns,again));assert.equal(number(a,'advance'),ref.advance());assert.equal(number(a,'read'),ref.read());\n const keys=a.invoke('keys'),names=[];for(let i=0;i<a.length(keys);i++){const key=a.get(keys,i);names.push(a.readString(key));a.release(key)}assert.deepEqual(names,ref.keys());\n const copy=a.invoke('copy'),refCopy=ref.copy(),counter=a.string('counter'),original=a.objectGet(copy,counter);assert.equal(a.readNumber(original),refCopy.counter);assert.equal(number(a,'advance'),ref.advance());const live=a.objectGet(ns,counter),snapshot=a.objectGet(copy,counter);assert.equal(a.readNumber(live),ref.ns.counter);assert.equal(a.readNumber(snapshot),refCopy.counter);assert.throws(()=>a.invoke('write'),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');finish(a,[ns,again,keys,copy,counter,original,live,snapshot])\n});\ntest('namespace qualified references and calls use existing symbol munging and respect local shadowing',async()=>{\n const p=await project({'lib.mjs':'(defvar value 3) (defun read-value () value) (export value read-value)','main.mjs':'(import \"./lib.mjs\" :as ns) (defun qualified () (ns/read-value)) (defun method () (js-call ns :read_value)) (defun shadow () (let ((ns (js-object :value 9))) ns/value)) (export qualified method shadow)'}),ref=await p.reference(),a=instantiateManagedRuntime(emit(p));for(const name of['qualified','method','shadow'])assert.equal(number(a,name),ref[name]());finish(a)\n});\ntest('namespace own checks and enumeration retain early-binding TDZ with independent Node control',async()=>{\n for(const operation of['(object-has? ns :value)','(object-keys ns)','(object-assoc ns :extra 7)']){\n  const p=await project({'main.mjs':'(import \"./other.mjs\" result) (defconst value 7) (export value)','other.mjs':`(import \"./main.mjs\" :as ns) (defconst result ${operation}) (export result)`});const control=spawnSync('node',[resolve(p.base,p.entry)],{encoding:'utf8',timeout:30000});assert.equal(control.status,1);assert.match(control.stderr,/ReferenceError/);assert.throws(()=>instantiateManagedRuntime(emit(p)),e=>e.eliscriptDiagnostic?.code==='ELI-RT0008')\n }\n});\n\ntest('self-referential and reexported namespaces preserve cycles and survive caller-owned lifetimes',async()=>{\n const p=await project({'main.mjs':'(import \"./main.mjs\" :as ns) (defvar counter -0.0) (defun same () (eq ns (get ns :ns))) (defun read () ns/counter) (export ns counter same read)'}),ref=await p.reference();assert.equal(ref.ns.ns,ref.ns);const a=instantiateManagedRuntime(emit(p));a.auto(1);assert.equal(a.invoke('same'),ref.same());assert(Object.is(number(a,'read'),ref.read()));const ns=a.getExport('ns'),key=a.string('ns'),again=a.objectGet(ns,key);assert(a.keyEqual(ns,again));a.closeModule();a.collect();const counter=a.string('counter'),value=a.objectGet(ns,counter);assert(Object.is(a.readNumber(value),-0));for(const x of[ns,key,again,counter,value])a.release(x);a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0)\n});\ntest('namespace initialization capacity failures and actual traps discard module graphs but retain caller frames',async()=>{\n const p=await project({'lib.mjs':'(defconst value (js-array 1 2 3)) (export value)','main.mjs':'(import \"./lib.mjs\" :as ns) (export ns)'}),bytes=emit(p),small=instantiateManagedRuntime(bytes,{maxSlots:8,initialBytes:4096,maxBytes:8192,initializeModule:false});small.auto(1);const keep=small.number(7),frame=small.frame(1);small.frameSet(frame,0,keep);assert.throws(()=>small.initializeModule(),e=>e.eliscriptDiagnostic?.code==='ELI-RT0002');small.collect();assert.equal(small.stats().frameDepth,1);assert.equal(small.live(),2);small.leaveFrame(frame);finish(small,[keep]);\n const source=await readFile(resolve(root,'bootstrap/runtime/memory.eli'),'utf8'),start=source.indexOf('  (defun value-module-namespace-bind (heap object key kind index)'),end=source.indexOf('  (defun ',start+10);assert(start>=0&&end>start);const faulty=source.slice(0,start)+'  (defun value-module-namespace-bind (heap object key kind index) (load-u32 4294967295))\\n'+source.slice(end),rt=b.compiler.compile_ir_string(faulty,'namespace-trap.eli'),a=instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_project_wasm(p.modules,p.entry,rt)),{initializeModule:false});a.auto(1);const saved=a.number(-0),caller=a.frame(1);a.frameSet(caller,0,saved);assert.throws(()=>a.initializeModule(),WebAssembly.RuntimeError);a.collect();assert.equal(a.stats().frameDepth,1);assert.equal(a.live(),2);const out=a.frameGet(caller,0);assert(Object.is(a.readNumber(out),-0));a.leaveFrame(caller);finish(a,[saved,out])\n});\ntest('ordinary IR cannot forge a project namespace initializer or malformed alias options',async()=>{\n const p=await project({'main.mjs':'(defconst value 7) (export value)'}),program=p.modules[0].program;program.body[0].children[0]={kind:'managed-module-namespace',value:null,children:[],span:program.body[0].span,properties:null,entries:[]};assert.throws(()=>b.managed.emit_managed_wasm(program,runtime),e=>e.eliscriptDiagnostic?.code==='ELI-B0001');\n const ordinary=b.compiler.compile_ir_string('(defun f () 7) (export f)','aliases.eli');for(const aliases of[{},false,['f','f'],[null]])assert.throws(()=>b.managed.lower_managed_program(ordinary,runtime,true,aliases),e=>e.eliscriptDiagnostic?.code==='ELI-B0001')\n});\n\ntest('default exports remain distinct from a named binding whose source name is default',async()=>{\n const p=await project({'lib.mjs':'(defconst default 7) (export default) (export-default 9)','main.mjs':'(import \"./lib.mjs\" :default initial default) (defun values () (js-array initial default)) (export default) (export-default initial) (export values)'}),ref=await p.reference();assert.equal(ref.default,9);assert.equal(ref.default$,7);const a=instantiateManagedRuntime(emit(p)),plain=a.getExport('default'),named=a.getExport('default$');assert.equal(a.readNumber(plain),ref.default);assert.equal(a.readNumber(named),ref.default$);finish(a,[plain,named])\n});\n\ntest('a reexported namespace retains method calls and aliases instead of becoming a snapshot',async()=>{\n const p=await project({'lib.mjs':'(defvar value 3) (defun read-value () value) (export value read-value)','facade.mjs':'(import \"./lib.mjs\" :as ns) (export ns)','main.mjs':'(import \"./facade.mjs\" ns) (defun read () (js-call ns :read_value)) (export ns read)'}),ref=await p.reference(),a=instantiateManagedRuntime(emit(p));assert.equal(number(a,'read'),ref.read());const ns=a.getExport('ns');finish(a,[ns])\n});\n\ntest('the explicit project CLI consumes the existing virtual-project request shape without executing JS modules',async()=>{\n const request=resolve(directory,'virtual-project.json'),output=resolve(directory,'virtual-project.wasm'),command=resolve(root,'tools/backends/compile.mjs');await writeFile(request,JSON.stringify({mode:'project',entry:'main.mjs',files:liveSources}));const result=spawnSync('bun',[command,'--abi','managed-module-v1','--target','wasm','--project','-o',output,request],{cwd:root,encoding:'utf8',timeout:30000});assert.equal(result.status,0,result.stderr);const a=instantiateManagedRuntime(await readFile(output));assert.equal(number(a,'advance'),1);finish(a);\n for(const[abi,target]of[['managed-control-v1','wasm'],['numeric-f64','wasm'],['managed-module-v1','js']]){const rejected=resolve(directory,'rejected-project-'+abi+'-'+target);const child=spawnSync('bun',[command,'--abi',abi,'--target',target,'--project','-o',rejected,request],{cwd:root,encoding:'utf8',timeout:30000});assert.notEqual(child.status,0);assert.equal(await Bun.file(rejected).exists(),false)}\n},60000);\n\ntest('fixed random module graphs agree with independent binding models and fresh JS projects',async()=>{\n let random=0x51a37c28;const next=()=>random=(Math.imul(random,1664525)+1013904223)>>>0;\n for(let trial=0;trial<32;trial++){\n  const sources={},expected=[];for(let i=0;i<5;i++){const dependency=i===0?-1:next()%i,base=(next()%17)-8;expected[i]=base+(dependency<0?0:expected[dependency]);sources['m'+i+'.mjs']=(dependency<0?'':`(import \"./m${dependency}.mjs\" :as previous) `)+`(defvar value ${dependency<0?base:`(+ previous/value ${base})`}) (defun write (x) (setq value x)) (export value write)`}\n  sources['main.mjs']=Array.from({length:5},(_,i)=>`(import \"./m${i}.mjs\" :as n${i}) (defun read${i} () n${i}/value) (defun write${i} (x) (funcall (get n${i} :write) x))`).join(' ')+' (export '+Array.from({length:5},(_,i)=>`read${i} write${i}`).join(' ')+')';\n  const p=await project(sources),reference=await p.reference(),bytes=emit(p);assert.deepEqual(emit({...p,modules:[...p.modules].reverse()}),bytes);const a=instantiateManagedRuntime(bytes);a.auto(1);\n  for(let i=0;i<5;i++){assert(Object.is(number(a,'read'+i),expected[i]));assert(Object.is(number(a,'read'+i),reference['read'+i]()))}\n  for(let change=0;change<12;change++){const i=next()%5,edges=[-0,NaN,Infinity,-Infinity,Number.MIN_VALUE,0],value=change<edges.length?edges[change]:(next()%100)-50,x=a.number(value),out=a.invoke('write'+i,[x]);assert(Object.is(a.readNumber(out),reference['write'+i](value)));a.release(x);a.release(out);expected[i]=value;a.collect();for(let j=0;j<5;j++)assert(Object.is(number(a,'read'+j),expected[j]))}\n  finish(a)\n }\n},30000);\ntest('nested Unicode module identities and frozen source IR retain exact source values and diagnostics',async()=>{\n const p=await project({'项目/数值.mjs':'(defconst value \"中😀\") (export value)','main.mjs':'(import \"./项目/数值.mjs\" value) (export value)'}),reference=await p.reference(),freeze=x=>{if(x&&typeof x==='object'){Object.freeze(x);for(const value of Object.values(x))freeze(value)}};freeze(p.modules);const a=instantiateManagedRuntime(emit(p)),value=a.getExport('value');assert.equal(a.readString(value),reference.value);finish(a,[value]);\n for(const id of['main\\u0000.mjs','main\\\\bad.mjs','main.mjs?query','main.mjs#hash',':scheme','../main.mjs'])assert.throws(()=>b.managed.emit_managed_project_wasm([{id,program:p.modules[0].program}],id,runtime),e=>e.eliscriptDiagnostic?.code==='ELI-B0001')\n});\n\ntest('an actual namespace copy trap releases its temporary object and every manually protected value',async()=>{\n const p=await project({'lib.mjs':'(defconst value (js-array 1 2 3)) (export value)','main.mjs':'(import \"./lib.mjs\" :as ns) (defun copy () (object-assoc ns :extra 7)) (export copy)'}),source=await readFile(resolve(root,'bootstrap/runtime/memory.eli'),'utf8'),start=source.indexOf('  (defun heap-module-cell-read (heap cell)'),end=source.indexOf('  (defun ',start+10);assert(start>=0&&end>start);const faulty=source.slice(0,start)+'  (defun heap-module-cell-read (heap cell) (load-u32 4294967295))\\n'+source.slice(end),rt=b.compiler.compile_ir_string(faulty,'namespace-copy-trap.eli'),a=instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_project_wasm(p.modules,p.entry,rt)));a.auto(1);const keep=a.number(-0),frame=a.frame(1);a.frameSet(frame,0,keep);assert.throws(()=>a.invoke('copy'),WebAssembly.RuntimeError);assert.equal(a.stats().frameDepth,1);const saved=a.frameGet(frame,0);assert(Object.is(a.readNumber(saved),-0));a.leaveFrame(frame);finish(a,[keep,saved])\n});\n\ntest('namespace prototypes keep ordinary own writes but reject inherited writes after RHS effects',async()=>{\n const p=await project({'lib.mjs':'(defconst value 7) (export value)','main.mjs':'(import \"./lib.mjs\" :as ns) (defconst child (js-object :__proto__ ns :own 5)) (defvar effect 0) (defun read () child/value) (defun own () (object-has? child :value)) (defun write-own () (put child :own 9)) (defun write-known () (put child :value 9)) (defun write-new () (put child :extra (setq effect (1+ effect)))) (defun effects () effect) (export child read own write-own write-known write-new effects)'}),ref=await p.reference();assert.equal(ref.read(),7);assert.equal(ref.own(),false);assert.equal(ref.write_own(),9);assert.throws(()=>ref.write_known(),TypeError);assert.throws(()=>ref.write_new(),TypeError);assert.equal(ref.effects(),1);const a=instantiateManagedRuntime(emit(p));assert.equal(number(a,'read'),7);assert.equal(a.invoke('own'),false);assert.equal(number(a,'write_own'),9);for(const name of['write_known','write_new'])assert.throws(()=>a.invoke(name),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.equal(number(a,'effects'),1);finish(a)\n});\n\ntest('standalone and linked bindings preserve the existing JS emitted-name shadowing across scopes',async()=>{\n const cases=[\n  '(defvar value-name 3) (defun f (value_name) value-name) (export f)',\n  '(defvar value-name 3) (defun f (value_name) ((lambda () value-name))) (export f)',\n  '(defvar value-name 3) (defun f (value_name) (setq value-name 7) (+ (* value-name 10) value_name)) (defun global () value-name) (export f global)',\n  '(defun f (value-name) (let ((value_name (+ value-name 1))) ((lambda () value-name)))) (export f)',\n  '(defun f (value-name) (let ((value_name (+ value-name 1))) (let ((value-name (+ value_name 1))) ((lambda () value_name))))) (export f)',\n  '(defvar default 3) (defun f (default$) default) (export f)',\n  '(defvar 值 3) (defun f (_U503C_) 值) (export f)',\n  '(defvar value 3) (defun f ($eliscript-link-0-0) value) (export f)',\n ];\n for(const source of cases){const p=await project({'main.mjs':source}),reference=await p.reference(),expected=reference.f(5);const control=spawnSync('node',['--input-type=module','--eval',\"import assert from 'node:assert/strict';const m=await import(process.argv[1]);assert(Object.is(m.f(5),Number(process.argv[2])));if(m.global)assert.equal(m.global(),3);\",pathToFileURL(resolve(p.base,p.entry)).href,String(expected)],{encoding:'utf8',timeout:30000});assert.equal(control.status,0,control.stderr);for(const bytes of[Uint8Array.from(b.managed.emit_managed_wasm(p.modules[0].program,runtime)),emit(p)]){const a=instantiateManagedRuntime(bytes);a.auto(1);const input=a.number(5);assert(Object.is(number(a,'f',[input]),expected),source);if(reference.global)assert.equal(number(a,'global'),reference.global());finish(a,[input],WebAssembly.Module.exports(new WebAssembly.Module(bytes)).some(e=>e.name==='__eliscript_module_init'))}}\n});\ntest('an emitted-name alias may shadow a namespace in qualified reads and builtin method calls',async()=>{\n for(const[source,input]of[\n  ['(import \"./lib.mjs\" :as value-name) (defun f (value_name) value-name/x) (export f)','object'],\n  ['(import \"./lib.mjs\" :as array-name) (defun f (array_name) (js-call array-name :push 7)) (export f)','array']]){\n  const p=await project({'lib.mjs':'(defconst x 3) (export x)','main.mjs':source}),reference=await p.reference(),expected=reference.f(input==='object'?{x:7}:[]),a=instantiateManagedRuntime(emit(p));a.auto(1);const seven=a.number(7),value=input==='object'?a.sourceObject({x:seven}):a.sourceArray([]);assert.equal(number(a,'f',[value]),expected);finish(a,[seven,value])\n }\n});\n"))
