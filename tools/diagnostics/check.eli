(module tools.diagnostics.check
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst DEFAULT_ROOT (js-call path :resolve (js-call path :dirname module-file) "../.."))
  (defconst CONTRACT_FILE "contracts/diagnostic-corpus.json")
  (defconst suites
    (js-array
      (js-object :id "reader" :fixture "tests/fixtures/bootstrap-reader.json"
        :oracle "tests/bootstrap-reader-oracle.el" :environment "ELISCRIPT_READER_FIXTURE"
        :validCaseCount 23 :negativeCaseCount 17)
      (js-object :id "expander" :fixture "tests/fixtures/bootstrap-expander.json"
        :oracle "tests/bootstrap-expander-oracle.el" :environment "ELISCRIPT_EXPANDER_FIXTURE"
        :validCaseCount 40 :negativeCaseCount 36)
      (js-object :id "analyzer" :fixture "tests/fixtures/bootstrap-analyzer.json"
        :oracle "tests/bootstrap-analyzer-oracle.el" :environment "ELISCRIPT_ANALYZER_FIXTURE"
        :validCaseCount 30 :negativeCaseCount 57)))
  (defconst diagnostic-code-pattern "^ELI-[A-Z][0-9]{4}$")
  (defconst identity-pattern "^[0-9a-f]{64}$")

  (defun diagnostic-error-message (errors)
    (str "diagnostic corpus validation failed:\n- " (js-call errors :join "\n- ")))

  (defun diagnostic-error-fields (self errors)
    (put self :name "DiagnosticCorpusError")
    (put self :errors errors)
    self)

  (defconst DiagnosticCorpusError
    (funcall
      (js* "(message, fields) => class DiagnosticCorpusError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      diagnostic-error-message
      diagnostic-error-fields))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun plain-object? (value)
    (and (not (nil? value))
         (= (host-type value) "object")
         (not (Array/isArray value))))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object)
      (aref supplied 0)))

  (defun optional-index (value index)
    (if (nullish? value) undefined (aref value index)))

  (defun json-equal (left right)
    (= (JSON/stringify left) (JSON/stringify right)))

  (defun regexp-test (source text flags)
    (js-call (new globalThis.RegExp source flags) :test text))

  (defun digest (value)
    (js-call (js-call (createHash "sha256") :update (JSON/stringify value)) :digest "hex"))

  (defasync read-json (filename)
    (JSON/parse (await (readFile filename "utf8"))))

  (defun expected-suite-header (suite)
    (js-object :id (get suite :id) :fixture (get suite :fixture) :oracle (get suite :oracle)
      :validCaseCount (get suite :validCaseCount) :negativeCaseCount (get suite :negativeCaseCount)))

  (defun validate-position (position label errors)
    (when (or (not (plain-object? position))
              (not (Number/isInteger (get position :offset)))
              (< (get position :offset) 0)
              (not (Number/isInteger (get position :line)))
              (< (get position :line) 1)
              (not (Number/isInteger (get position :column)))
              (< (get position :column) 1))
      (js-call errors :push (str label " must contain non-negative offset and one-based line and column"))))

  (defun validate-case (test-case suite label errors)
    (if (or (not (plain-object? test-case))
            (not (= (host-type (get test-case :name)) "string"))
            (= (js-length (get test-case :name)) 0)
            (not (= (host-type (get test-case :human)) "string"))
            (not (plain-object? (get test-case :diagnostic))))
      (js-call errors :push (str label " must contain name human and diagnostic fields"))
      (let ((diagnostic (get test-case :diagnostic)))
        (if (or (not (= (get diagnostic :format) "eliscript-diagnostic"))
                (not (= (get diagnostic :version) 1))
                (not (= (host-type (get diagnostic :code)) "string"))
                (not (regexp-test diagnostic-code-pattern (get diagnostic :code) "u"))
                (not (= (get diagnostic :severity) "error"))
                (not (= (host-type (get diagnostic :phase)) "string"))
                (not (= (host-type (get diagnostic :message)) "string"))
                (not (plain-object? (get diagnostic :location)))
                (not (= (host-type (get (get diagnostic :location) :file)) "string")))
          (js-call errors :push (str label " must contain one complete version 1 error diagnostic"))
          (let ((location (get diagnostic :location)))
            (validate-position (get location :start) (str label " start") errors)
            (validate-position (get location :end) (str label " end") errors)
            (let ((rendered (str (get location :file) ":" (get (get location :start) :line) ":"
                                 (get (get location :start) :column) ": " (get diagnostic :message))))
              (unless (= (get test-case :human) rendered)
                (js-call errors :push (str label " human text must render from its structured diagnostic"))))
            (when (and (= (get suite :id) "reader") (not (= (get diagnostic :code) "ELI-R0001")))
              (js-call errors :push (str label " reader diagnostic must use ELI-R0001")))
            (when (and (= (get suite :id) "expander") (not (= (get diagnostic :code) "ELI-X0001")))
              (js-call errors :push (str label " expander diagnostic must use ELI-X0001")))
            (when (and (= (get suite :id) "analyzer")
                       (not (js-call (js-array "ELI-A0001" "ELI-P0001") :includes (get diagnostic :code))))
              (js-call errors :push (str label " analyzer diagnostic must use ELI-A0001 or ELI-P0001"))))))))

  (defun pair-name-human (entry)
    (js-array (host-get entry "name") (host-get entry "human")))

  (defun pair-name-error (entry)
    (js-array (host-get entry "name") (host-get entry "error")))

  (defun map-pairs (values mapper)
    (let ((pairs (js-array)) (index 0))
      (while (< index (js-length values))
        (js-call pairs :push (funcall mapper (aref values index)))
        (setq index (1+ index)))
      pairs))

  (defasync validateDiagnosticCorpus (contract &rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (errors (js-array)))
      (unless (and (plain-object? contract)
                   (= (get contract :schemaVersion) 1)
                   (= (get contract :format) "eliscript-diagnostic-corpus")
                   (= (get contract :version) 1))
        (throw (new DiagnosticCorpusError
                 (js-array "contract must use eliscript-diagnostic-corpus version 1"))))
      (when (or (not (Array/isArray (get contract :suites)))
                (not (= (js-length (get contract :suites)) (js-length suites))))
        (js-call errors :push "suites must contain the exact reader expander and analyzer inventory"))
      (let ((seen (new globalThis.Set)) (index 0) (declared (get contract :suites)))
        (while (< index (js-length suites))
          (let* ((definition (aref suites index))
                 (suite (optional-index declared index))
                 (label (str "suite " (get definition :id))))
            (if (not (plain-object? suite))
              (js-call errors :push (str label " must be an object"))
              (let ((header (js-object :id (get suite :id) :fixture (get suite :fixture)
                               :oracle (get suite :oracle)
                               :validCaseCount (get suite :validCaseCount)
                               :negativeCaseCount (get suite :negativeCaseCount)))
                    (fixture (js-object)))
                (unless (json-equal header (expected-suite-header definition))
                  (js-call errors :push (str label " metadata must match the maintained suite inventory")))
                (try
                  (setq fixture (await (read-json (js-call path :join root (get definition :fixture)))))
                  (catch error
                    (js-call errors :push (str label " fixture could not be read: " (get error :message)))))
                (when (or (not (Array/isArray (get fixture :valid)))
                          (not (= (js-length (get fixture :valid)) (get definition :validCaseCount))))
                  (js-call errors :push (str label " valid fixture count must be " (get definition :validCaseCount))))
                (let ((fixture-invalid (if (Array/isArray (get fixture :invalid)) (get fixture :invalid) (js-array)))
                      (cases (if (Array/isArray (get suite :cases)) (get suite :cases) (js-array))))
                  (when (or (not (= (js-length fixture-invalid) (get definition :negativeCaseCount)))
                            (not (= (js-length cases) (get definition :negativeCaseCount))))
                    (js-call errors :push (str label " must contain exactly " (get definition :negativeCaseCount) " negative cases")))
                  (unless (json-equal (map-pairs cases pair-name-human) (map-pairs fixture-invalid pair-name-error))
                    (js-call errors :push (str label " cases must exactly match the ordered invalid fixture cases")))
                  (let ((case-index 0))
                    (while (< case-index (js-length cases))
                      (let* ((test-case (aref cases case-index))
                             (case-label (str label " case " case-index))
                             (qualified (str (get definition :id) "/" (host-get test-case "name"))))
                        (validate-case test-case definition case-label errors)
                        (when (js-call seen :has qualified)
                          (js-call errors :push (str case-label " duplicates " qualified)))
                        (js-call seen :add qualified))
                      (setq case-index (1+ case-index))))))))
          (setq index (1+ index)))
        (unless (= (get seen :size) 110)
          (js-call errors :push "corpus must contain exactly 110 uniquely named negative cases"))
        (when (or (not (regexp-test identity-pattern (get contract :identity "") "u"))
                  (not (= (get contract :identity) (digest (get contract :suites)))))
          (js-call errors :push "identity must be the SHA-256 digest of the complete ordered suite payload"))
        (when (> (js-length errors) 0)
          (throw (new DiagnosticCorpusError errors)))
        contract)))

  (defasync run-oracle (root suite)
    (let* ((fixture (js-call path :join root (get suite :fixture)))
           (child (js-call globalThis.Bun :spawn
                    (js-array (get (get globalThis.process :env) :EMACS "emacs")
                      "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script" (get suite :oracle))
                    (js-object :cwd root
                      :env (funcall (js* "(base, key, value) => ({...base, [key]: value})")
                             (get globalThis.process :env) (get suite :environment) fixture)
                      :stdout "pipe" :stderr "pipe")))
           (state (js-object :forceKill undefined))
           (timer (globalThis.setTimeout
                    (lambda ()
                      (js-call child :kill "SIGTERM")
                      (put state :forceKill
                        (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 2000)))
                    30000))
           (parts (await (js-call globalThis.Promise :all
                           (js-array (get child :exited)
                             (js-call (new globalThis.Response (get child :stdout)) :text)
                             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exit-code (aref parts 0))
           (stdout (aref parts 1))
           (stderr (aref parts 2)))
      (globalThis.clearTimeout timer)
      (globalThis.clearTimeout (get state :forceKill))
      (unless (= exit-code 0)
        (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
          (throw (new globalThis.Error
                   (str (get suite :id) " oracle failed: " (if (host-truthy err) err out))))))
      (JSON/parse stdout)))

  (defasync generateDiagnosticCorpus (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (generated (js-array))
           (index 0))
      (while (< index (js-length suites))
        (let* ((suite (aref suites index))
               (parts (await (js-call globalThis.Promise :all
                               (js-array (read-json (js-call path :join root (get suite :fixture)))
                                 (run-oracle root suite)))))
               (fixture (aref parts 0))
               (results (aref parts 1))
               (by-name (new globalThis.Map
                          (js-call results :map (lambda (result)
                                                  (js-array (get result :name) result)))))
               (cases (js-call (get fixture :invalid) :map
                        (lambda (entry)
                          (let ((result (js-call by-name :get (get entry :name))))
                            (unless (= (host-get result "status") "error")
                              (throw (new globalThis.Error
                                       (str (get suite :id) "/" (get entry :name) " did not produce an oracle error"))))
                            (js-object :name (get entry :name) :human (get result :message)
                              :diagnostic (get result :diagnostic)))))))
          (js-call generated :push
            (js-object :id (get suite :id) :fixture (get suite :fixture) :oracle (get suite :oracle)
              :validCaseCount (get suite :validCaseCount)
              :negativeCaseCount (get suite :negativeCaseCount)
              :cases cases)))
        (setq index (1+ index)))
      (let ((contract (js-object :schemaVersion 1 :format "eliscript-diagnostic-corpus" :version 1
                        :identity (digest generated) :suites generated)))
        (await (validateDiagnosticCorpus contract (js-object :root root)))
        contract)))

  (defasync checkDiagnosticCorpus (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract))
                       (await (read-json (js-call path :join root CONTRACT_FILE)))
                       (get options :contract))))
      (await (validateDiagnosticCorpus contract (js-object :root root)))))

  (defun diagnosticCorpusSuite (contract id)
    (let ((suite (js-call (get contract :suites) :find
                   (lambda (entry) (= (get entry :id) id)))))
      (unless suite
        (throw (new globalThis.Error (str "unknown diagnostic corpus suite: " id))))
      suite))

  (defun case-total (declared)
    (let ((sum 0) (index 0))
      (while (< index (js-length declared))
        (setq sum (+ sum (js-length (get (aref declared index) :cases))))
        (setq index (1+ index)))
      sum))

  (defasync main ()
    (if (js-call (js-call (get globalThis.process :argv) :slice 2) :includes "--generate")
      (let ((contract (await (generateDiagnosticCorpus))))
        (await (writeFile (js-call path :join DEFAULT_ROOT CONTRACT_FILE)
                 (str (JSON/stringify contract nil 2) "\n") "utf8"))
        (js-call (get globalThis.process :stdout) :write
          (str "Generated " CONTRACT_FILE " (" (case-total (get contract :suites)) " cases)\n")))
      (let ((contract (await (checkDiagnosticCorpus))))
        (js-call (get globalThis.process :stdout) :write
          (str "Diagnostic corpus verified (" (case-total (get contract :suites))
               " cases, " (get contract :identity) ")\n")))))

  (when (js* "import.meta.main")
    (js-call (main) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write (str (get error :message) "\n"))
        (put globalThis.process :exitCode 1))))

  (export DEFAULT_ROOT CONTRACT_FILE DiagnosticCorpusError validateDiagnosticCorpus
    generateDiagnosticCorpus checkDiagnosticCorpus diagnosticCorpusSuite))
