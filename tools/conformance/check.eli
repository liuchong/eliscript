(module tools.conformance.check
  (import "node:fs/promises" readFile readdir)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst DEFAULT_ROOT (js-call path :resolve (js-call path :dirname module-file) "../.."))
  (defconst spec-statuses (new globalThis.Set (js-array "draft" "accepted" "stable" "superseded")))
  (defconst implementation-statuses
    (new globalThis.Set (js-array "pending" "in-progress" "implemented" "superseded")))
  (defconst feature-statuses (new globalThis.Set (js-array "accepted" "stable")))
  (defconst evidence-kinds (new globalThis.Set (js-array "ert" "bun-test" "shell" "fixture")))
  (defconst target-pattern "^[A-Za-z0-9_.-]+:")
  (defconst heading-pattern "^# (\\d{4}): (.+)$")
  (defconst status-pattern "^- Status: (.+)$")
  (defconst implementation-pattern "^- Implementation: (.+)$")
  (defconst spec-id-pattern "^\\d{4}$")
  (defconst spec-file-pattern "^\\d{4}-.+\\.md$")
  (defconst feature-id-pattern "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$")
  (defconst path-separator-pattern "[\\\\/]")

  (defun contract-error-message (errors)
    (str "Contract validation failed:\n"
         (js-call (js-call errors :map (lambda (error) (str "- " error))) :join "\n")))

  (defun contract-error-fields (self errors)
    (put self :name "ContractValidationError")
    (put self :errors errors)
    self)

  (defconst ContractValidationError
    (funcall
      (js* "(message, fields) => class ContractValidationError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      contract-error-message
      contract-error-fields))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun plain-object? (value)
    (and (not (nil? value))
         (= (host-type value) "object")
         (not (Array/isArray value))))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object)
      (aref supplied 0)))

  (defun nonempty-text? (value)
    (and (= (host-type value) "string") (> (js-length value) 0)))

  (defun regexp-test (source text flags)
    (js-call (new globalThis.RegExp source flags) :test text))

  (defun match-group (text source flags group)
    (let ((match (js-call text :match (new globalThis.RegExp source flags))))
      (if (nullish? match) undefined (aref match group))))

  (defun normalized-status (value)
    (js-call (js-call (js-call value :trim) :toLowerCase) :replaceAll " " "-"))

  (defun some-bad-text (values)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length values)))
        (unless (nonempty-text? (aref values index))
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun validate-sorted-strings (values label errors)
    (if (or (not (Array/isArray values)) (some-bad-text values))
      (progn
        (js-call errors :push (str label " must be an array of non-empty strings"))
        (js-array))
      (let ((expected (js-call (Array/from (new globalThis.Set values)) :sort)))
        (unless (= (JSON/stringify values) (JSON/stringify expected))
          (js-call errors :push (str label " must be unique and lexicographically sorted")))
        values)))

  (defun compare-classification (actual expected label errors)
    (unless (= (JSON/stringify actual) (JSON/stringify expected))
      (let ((missing (js-array)) (extra (js-array)) (index 0))
        (while (< index (js-length expected))
          (let ((value (aref expected index)))
            (unless (js-call actual :includes value)
              (js-call missing :push value)))
          (setq index (1+ index)))
        (setq index 0)
        (while (< index (js-length actual))
          (let ((value (aref actual index)))
            (unless (js-call expected :includes value)
              (js-call extra :push value)))
          (setq index (1+ index)))
        (when (> (js-length missing) 0)
          (js-call errors :push (str label " is missing: " (js-call missing :join ", "))))
        (when (> (js-length extra) 0)
          (js-call errors :push (str label " has unexpected entries: " (js-call extra :join ", ")))))))

  (defun safe-relative-path (relative-path)
    (and (= (host-type relative-path) "string")
         (> (js-length relative-path) 0)
         (not (js-call path :isAbsolute relative-path))
         (not (js-call (js-call relative-path :split (new globalThis.RegExp path-separator-pattern "u"))
                :includes ".."))))

  (defasync read-json (filename)
    (JSON/parse (await (readFile filename "utf8"))))

  (defun make-target-source (makefile name)
    (let ((lines (js-call makefile :split "\n")) (start -1) (index 0))
      (while (and (< start 0) (< index (js-length lines)))
        (when (js-call (aref lines index) :startsWith (str name ":"))
          (setq start index))
        (setq index (1+ index)))
      (if (< start 0)
        ""
        (let ((body (js-array)) (cursor (1+ start)))
          (while (< cursor (js-length lines))
            (let ((line (aref lines cursor)))
              (if (regexp-test target-pattern line "u")
                (setq cursor (js-length lines))
                (progn
                  (js-call body :push line)
                  (setq cursor (1+ cursor))))))
          (str (aref lines start) "\n" (js-call body :join "\n"))))))

  (defasync read-spec-metadata (filename)
    (let* ((source (await (readFile filename "utf8")))
           (heading (js-call source :match (new globalThis.RegExp heading-pattern "mu")))
           (status (js-call source :match (new globalThis.RegExp status-pattern "mu")))
           (implementation (js-call source :match (new globalThis.RegExp implementation-pattern "mu"))))
      (js-object
        :id (if (nullish? heading) undefined (aref heading 1))
        :title (if (nullish? heading) undefined (aref heading 2))
        :status (if status (normalized-status (aref status 1)) undefined)
        :implementation (if implementation (normalized-status (aref implementation 1)) undefined))))

  (defun validate-spec-entry-shape (entry index errors)
    (let ((label (str "spec index entry " index)))
      (if (not (plain-object? entry))
        (js-call errors :push (str label " must be an object"))
        (progn
          (unless (regexp-test spec-id-pattern (get entry :id "") "u")
            (js-call errors :push (str label " has invalid id " (JSON/stringify (get entry :id)))))
          (unless (nonempty-text? (get entry :title))
            (js-call errors :push (str label " must have a title")))
          (unless (safe-relative-path (get entry :file))
            (js-call errors :push (str label " has unsafe file " (JSON/stringify (get entry :file)))))
          (unless (js-call spec-statuses :has (get entry :status))
            (js-call errors :push (str label " has invalid status " (JSON/stringify (get entry :status)))))
          (unless (js-call implementation-statuses :has (get entry :implementation))
            (js-call errors :push (str label " has invalid implementation " (JSON/stringify (get entry :implementation)))))
          (when (and (= (get entry :status) "stable") (not (= (get entry :implementation) "implemented")))
            (js-call errors :push (str label " cannot be stable before it is implemented")))))))

  (defasync validate-spec-index (root spec-index errors)
    (if (or (not (plain-object? spec-index)) (not (= (get spec-index :schemaVersion) 1)))
      (progn
        (js-call errors :push "spec index must use schemaVersion 1")
        (new globalThis.Map))
      (if (not (Array/isArray (get spec-index :specifications)))
        (progn
          (js-call errors :push "spec index specifications must be an array")
          (new globalThis.Map))
        (let ((by-id (new globalThis.Map))
              (indexed-files (new globalThis.Set))
              (previous-id "")
              (index 0)
              (entries (get spec-index :specifications)))
          (while (< index (js-length entries))
            (let ((entry (aref entries index)))
              (validate-spec-entry-shape entry index errors)
              (when (plain-object? entry)
                (when (< (get entry :id) previous-id)
                  (js-call errors :push (str "spec index is not sorted at " (get entry :id))))
                (setq previous-id (get entry :id))
                (when (js-call by-id :has (get entry :id))
                  (js-call errors :push (str "duplicate spec id " (get entry :id))))
                (when (js-call indexed-files :has (get entry :file))
                  (js-call errors :push (str "duplicate spec file " (get entry :file))))
                (js-call by-id :set (get entry :id) entry)
                (js-call indexed-files :add (get entry :file))
                (when (safe-relative-path (get entry :file))
                  (try
                    (let ((metadata (await (read-spec-metadata (js-call path :resolve root (get entry :file)))))
                          (fields (js-array "id" "title" "status" "implementation"))
                          (field-index 0))
                      (while (< field-index (js-length fields))
                        (let ((field (aref fields field-index)))
                          (unless (= (get metadata field) (get entry field))
                            (js-call errors :push
                              (str (get entry :file) " " field " is " (JSON/stringify (get metadata field))
                                   ", index declares " (JSON/stringify (get entry field))))))
                        (setq field-index (1+ field-index))))
                    (catch error
                      (js-call errors :push (str (get entry :file) " cannot be read: " (get error :message))))))))
            (setq index (1+ index)))
          (let ((disk-files (js-call
                              (js-call (js-call (await (readdir (js-call path :join root "specs"))) :filter
                                         (lambda (file) (regexp-test spec-file-pattern file "u")))
                                :map (lambda (file) (str "specs/" file)))
                              :sort))
                (file-index 0))
            (while (< file-index (js-length disk-files))
              (let ((file (aref disk-files file-index)))
                (unless (js-call indexed-files :has file)
                  (js-call errors :push (str file " is missing from specs/index.json"))))
              (setq file-index (1+ file-index)))
            (js-call indexed-files :forEach
              (lambda (file)
                (unless (js-call disk-files :includes file)
                  (js-call errors :push (str file " is indexed but is not a spec file"))))))
          by-id))))

  (defun bad-contract-name (contract)
    (or (not (= (host-type contract) "string")) (not (host-truthy contract))))

  (defun some-bad-contract (contracts)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length contracts)))
        (when (bad-contract-name (aref contracts index))
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun validate-feature-shape (feature index errors)
    (let ((label (str "feature entry " index)))
      (if (not (plain-object? feature))
        (js-call errors :push (str label " must be an object"))
        (progn
          (unless (regexp-test feature-id-pattern (get feature :id "") "u")
            (js-call errors :push (str label " has invalid id " (JSON/stringify (get feature :id)))))
          (unless (nonempty-text? (get feature :title))
            (js-call errors :push (str label " must have a title")))
          (unless (js-call feature-statuses :has (get feature :status))
            (js-call errors :push (str label " has invalid status " (JSON/stringify (get feature :status)))))
          (unless (regexp-test spec-id-pattern (get feature :spec "") "u")
            (js-call errors :push (str label " has invalid spec " (JSON/stringify (get feature :spec)))))
          (when (or (not (Array/isArray (get feature :contracts)))
                    (= (js-length (get feature :contracts)) 0)
                    (some-bad-contract (get feature :contracts)))
            (js-call errors :push (str label " must declare at least one contract")))
          (when (or (not (Array/isArray (get feature :evidence)))
                    (= (js-length (get feature :evidence)) 0))
            (js-call errors :push (str label " must declare at least one evidence item")))))))

  (defasync validate-manifest (root manifest specs-by-id application-feature-ids errors)
    (if (or (not (plain-object? manifest)) (not (= (get manifest :schemaVersion) 1)))
      (progn
        (js-call errors :push "conformance manifest must use schemaVersion 1")
        (js-object :features 0 :evidence 0 :coveredSpecs (new globalThis.Set)))
      (if (not (Array/isArray (get manifest :features)))
        (progn
          (js-call errors :push "conformance manifest features must be an array")
          (js-object :features 0 :evidence 0 :coveredSpecs (new globalThis.Set)))
        (let ((feature-ids (new globalThis.Set))
              (covered-specs (new globalThis.Set))
              (source-cache (new globalThis.Map))
              (domains (new globalThis.Map))
              (test-driver (await (readFile (js-call path :join root "Makefile") "utf8")))
              (evidence-count 0)
              (previous-spec "")
              (index 0)
              (features (get manifest :features)))
          (let ((core-test-driver (make-target-source test-driver "test-core"))
                (application-test-driver (make-target-source test-driver "test-applications")))
            (unless (host-truthy core-test-driver)
              (js-call errors :push "Makefile must define test-core"))
            (unless (host-truthy application-test-driver)
              (js-call errors :push "Makefile must define test-applications"))
            (while (< index (js-length features))
              (let ((feature (aref features index)))
                (validate-feature-shape feature index errors)
                (when (plain-object? feature)
                  (when (js-call feature-ids :has (get feature :id))
                    (js-call errors :push (str "duplicate feature id " (get feature :id))))
                  (js-call feature-ids :add (get feature :id))
                  (let* ((domain-name (aref (js-call (get feature :id) :split ".") 0))
                         (domain (js-call domains :get domain-name)))
                    (unless domain
                      (setq domain (js-object :features 0 :evidence 0))
                      (js-call domains :set domain-name domain))
                    (put domain :features (1+ (get domain :features)))
                    (when (< (get feature :spec) previous-spec)
                      (js-call errors :push (str "features are not sorted by spec at " (get feature :id))))
                    (setq previous-spec (get feature :spec))
                    (let ((spec (js-call specs-by-id :get (get feature :spec))))
                      (if (not spec)
                        (js-call errors :push (str (get feature :id) " references unknown spec " (get feature :spec)))
                        (progn
                          (js-call covered-specs :add (get spec :id))
                          (unless (js-call (new globalThis.Set (js-array "accepted" "stable")) :has (get spec :status))
                            (js-call errors :push (str (get feature :id) " references non-accepted spec " (get spec :id))))
                          (unless (= (get spec :implementation) "implemented")
                            (js-call errors :push (str (get feature :id) " references non-implemented spec " (get spec :id))))
                          (when (and (= (get feature :status) "stable") (not (= (get spec :status) "stable")))
                            (js-call errors :push (str (get feature :id) " cannot be stable while spec " (get spec :id) " is not stable")))
                          (when (and (= (get spec :status) "stable") (not (= (get feature :status) "stable")))
                            (js-call errors :push (str (get feature :id) " must be stable because spec " (get spec :id) " is stable"))))))
                    (let ((evidence (if (nullish? (get feature :evidence)) (js-array) (get feature :evidence)))
                          (evidence-index 0))
                      (while (< evidence-index (js-length evidence))
                        (let ((item (aref evidence evidence-index))
                              (label (str (get feature :id) " evidence " evidence-index)))
                          (setq evidence-count (1+ evidence-count))
                          (put domain :evidence (1+ (get domain :evidence)))
                          (if (not (plain-object? item))
                            (js-call errors :push (str label " must be an object"))
                            (progn
                              (unless (js-call evidence-kinds :has (get item :kind))
                                (js-call errors :push (str label " has invalid kind " (JSON/stringify (get item :kind)))))
                              (if (not (safe-relative-path (get item :file)))
                                (js-call errors :push (str label " has unsafe file " (JSON/stringify (get item :file))))
                                (if (or (not (= (host-type (get item :contains)) "string"))
                                        (= (js-length (get item :contains)) 0))
                                  (js-call errors :push (str label " must declare a non-empty contains locator"))
                                  (try
                                    (let* ((filename (js-call path :resolve root (get item :file)))
                                           (source (js-call source-cache :get filename)))
                                      (when (undefined? source)
                                        (setq source (await (readFile filename "utf8")))
                                        (js-call source-cache :set filename source))
                                      (unless (js-call source :includes (get item :contains))
                                        (js-call errors :push
                                          (str label " locator " (JSON/stringify (get item :contains))
                                               " is absent from " (get item :file))))
                                      (when (and (not (= (get item :kind) "fixture"))
                                                 (not (js-call test-driver :includes (get item :file))))
                                        (js-call errors :push
                                          (str label " file " (get item :file) " is not executed by the default test target")))
                                      (when (not (= (get item :kind) "fixture"))
                                        (let* ((application-evidence (js-call application-feature-ids :has (get feature :id)))
                                               (partition (if application-evidence application-test-driver core-test-driver))
                                               (target (if application-evidence "test-applications" "test-core")))
                                          (unless (js-call partition :includes (get item :file))
                                            (js-call errors :push
                                              (str label " file " (get item :file) " is not executed by " target))))))
                                    (catch error
                                      (js-call errors :push
                                        (str label " cannot read " (get item :file) ": " (get error :message))))))))))
                        (setq evidence-index (1+ evidence-index))))))
              (setq index (1+ index))))
            (js-call specs-by-id :forEach
              (lambda (spec)
                (when (and (= (get spec :implementation) "implemented")
                           (not (js-call covered-specs :has (get spec :id))))
                  (js-call errors :push (str "implemented spec " (get spec :id) " has no conformance feature")))))
            (js-object :features (js-length features) :evidence evidence-count :coveredSpecs covered-specs
              :domains (js-call globalThis.Object :fromEntries
                         (js-call (Array/from (js-call domains :entries)) :sort))))))))

  (defun validate-compatibility-baseline (baseline specs-by-id manifest errors)
    (let ((empty (js-object :stableSpecifications 0 :provisionalSpecifications 0 :planningSpecifications 0
                   :supersededSpecifications 0 :stableFeatures 0 :provisionalFeatures 0)))
      (if (or (not (plain-object? baseline))
              (not (= (get baseline :schemaVersion) 1))
              (not (= (get baseline :format) "eliscript-compatibility-baseline"))
              (not (= (get baseline :version) 2)))
        (progn
          (js-call errors :push "compatibility baseline must use eliscript-compatibility-baseline version 2")
          empty)
        (if (or (not (plain-object? (get baseline :specifications)))
                (not (plain-object? (get baseline :features))))
          (progn
            (js-call errors :push "compatibility baseline must classify specifications and features")
            empty)
          (let ((stable-specifications (validate-sorted-strings (get (get baseline :specifications) :stable)
                                         "stable specification baseline" errors))
                (provisional-specifications (validate-sorted-strings (get (get baseline :specifications) :provisional)
                                              "provisional specification baseline" errors))
                (planning-specifications (validate-sorted-strings (get (get baseline :specifications) :planning)
                                           "planning specification baseline" errors))
                (superseded-specifications (validate-sorted-strings (get (get baseline :specifications) :superseded)
                                             "superseded specification baseline" errors))
                (stable-features (validate-sorted-strings (get (get baseline :features) :stable)
                                   "stable feature baseline" errors))
                (provisional-features (validate-sorted-strings (get (get baseline :features) :provisional)
                                        "provisional feature baseline" errors))
                (specs (Array/from (js-call specs-by-id :values)))
                (features (if (Array/isArray (get manifest :features)) (get manifest :features) (js-array))))
            (compare-classification stable-specifications
              (js-call (js-call (js-call specs :filter (lambda (spec) (= (get spec :status) "stable")))
                         :map (lambda (spec) (get spec :id))) :sort)
              "stable specification baseline" errors)
            (compare-classification provisional-specifications
              (js-call (js-call (js-call specs :filter
                                  (lambda (spec)
                                    (and (= (get spec :status) "accepted")
                                         (= (get spec :implementation) "implemented"))))
                         :map (lambda (spec) (get spec :id))) :sort)
              "provisional specification baseline" errors)
            (compare-classification planning-specifications
              (js-call (js-call (js-call specs :filter
                                  (lambda (spec)
                                    (and (not (= (get spec :implementation) "implemented"))
                                         (not (= (get spec :implementation) "superseded")))))
                         :map (lambda (spec) (get spec :id))) :sort)
              "planning specification baseline" errors)
            (compare-classification superseded-specifications
              (js-call (js-call (js-call specs :filter (lambda (spec) (= (get spec :status) "superseded")))
                         :map (lambda (spec) (get spec :id))) :sort)
              "superseded specification baseline" errors)
            (compare-classification stable-features
              (js-call (js-call (js-call features :filter (lambda (feature) (= (get feature :status) "stable")))
                         :map (lambda (feature) (get feature :id))) :sort)
              "stable feature baseline" errors)
            (compare-classification provisional-features
              (js-call (js-call (js-call features :filter (lambda (feature) (= (get feature :status) "accepted")))
                         :map (lambda (feature) (get feature :id))) :sort)
              "provisional feature baseline" errors)
            (let ((all-specifications (js-call (js-array) :concat stable-specifications provisional-specifications
                                        planning-specifications superseded-specifications))
                  (all-features (js-call (js-array) :concat stable-features provisional-features)))
              (unless (= (get (new globalThis.Set all-specifications) :size) (js-length all-specifications))
                (js-call errors :push "compatibility baseline classifies a specification more than once"))
              (unless (= (get (new globalThis.Set all-features) :size) (js-length all-features))
                (js-call errors :push "compatibility baseline classifies a feature more than once")))
            (js-object :stableSpecifications (js-length stable-specifications)
              :provisionalSpecifications (js-length provisional-specifications)
              :planningSpecifications (js-length planning-specifications)
              :supersededSpecifications (js-length superseded-specifications)
              :stableFeatures (js-length stable-features)
              :provisionalFeatures (js-length provisional-features)))))))

  (defun bump-count (record key)
    (let ((current (get record key)))
      (put record key (+ (if (nullish? current) 0 current) 1))))

  (defasync checkContracts (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (errors (js-array))
           (spec-index (if (nullish? (get options :specIndex))
                         (await (read-json (js-call path :join root "specs/index.json")))
                         (get options :specIndex)))
           (manifest (if (nullish? (get options :manifest))
                       (await (read-json (js-call path :join root "tests/conformance/manifest.json")))
                       (get options :manifest)))
           (baseline (if (nullish? (get options :baseline))
                       (await (read-json (js-call path :join root "contracts/compatibility-baseline.json")))
                       (get options :baseline)))
           (maturity (if (nullish? (get options :maturity))
                       (await (read-json (js-call path :join root "contracts/maturity-progress.json")))
                       (get options :maturity)))
           (application-feature-ids (new globalThis.Set
                                      (validate-sorted-strings
                                        (host-get (host-get maturity "stabilization") "excludedFeatureIds")
                                        "core conformance application exclusions" errors)))
           (specs-by-id (await (validate-spec-index root spec-index errors)))
           (manifest-report (await (validate-manifest root manifest specs-by-id application-feature-ids errors)))
           (baseline-report (validate-compatibility-baseline baseline specs-by-id manifest errors)))
      (when (> (js-length errors) 0)
        (throw (new ContractValidationError errors)))
      (let ((specification-statuses (js-object)) (implementation-statuses (js-object)))
        (js-call specs-by-id :forEach
          (lambda (spec)
            (bump-count specification-statuses (get spec :status))
            (bump-count implementation-statuses (get spec :implementation))))
        (js-object :schemaVersion 1
          :specifications (js-object :total (get specs-by-id :size)
                            :statuses specification-statuses
                            :implementations implementation-statuses
                            :coveredImplemented (js-length
                                                  (js-call (Array/from (js-call specs-by-id :values)) :filter
                                                    (lambda (spec)
                                                      (and (= (get spec :implementation) "implemented")
                                                           (js-call (get manifest-report :coveredSpecs) :has (get spec :id)))))))
          :features (js-object :total (get manifest-report :features)
                      :evidence (get manifest-report :evidence)
                      :domains (get manifest-report :domains))
          :baseline baseline-report))))

  (defun human-report (report)
    (let ((matrix (js-call (js-call globalThis.Object :entries (get (get report :features) :domains)) :map
                    (lambda (entry)
                      (let ((domain (aref entry 0)) (counts (aref entry 1)))
                        (str "  " (js-call domain :padEnd 14) " "
                             (js-call (funcall globalThis.String (get counts :features)) :padStart 2)
                             " features / "
                             (js-call (funcall globalThis.String (get counts :evidence)) :padStart 2)
                             " evidence")))))
          (implemented (get (get (get report :specifications) :implementations) :implemented)))
      (js-call (js-array
                 (str "Contract index: " (get (get report :specifications) :total) " specifications")
                 (str "Implemented coverage: " (get (get report :specifications) :coveredImplemented) "/"
                      (if (nullish? implemented) 0 implemented))
                 (str "Conformance features: " (get (get report :features) :total))
                 (str "Evidence links: " (get (get report :features) :evidence))
                 (str "Stable baseline: " (get (get report :baseline) :stableSpecifications) " specs / "
                      (get (get report :baseline) :stableFeatures) " features")
                 (str "Provisional: " (get (get report :baseline) :provisionalSpecifications) " specs / "
                      (get (get report :baseline) :provisionalFeatures) " features")
                 "Conformance matrix:")
        :concat matrix)))

  (defasync main ()
    (let ((unknown (js-call (js-call (get globalThis.process :argv) :slice 2) :filter
                     (lambda (argument) (not (= argument "--json"))))))
      (if (> (js-length unknown) 0)
        (progn
          (console/error (str "Unknown argument: " (aref unknown 0)))
          (put globalThis.process :exitCode 2))
        (try
          (let ((report (await (checkContracts))))
            (console/log (if (js-call (get globalThis.process :argv) :includes "--json")
                           (JSON/stringify report)
                           (js-call (human-report report) :join "\n"))))
          (catch error
            (console/error (get error :message))
            (put globalThis.process :exitCode 1))))))

  (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (funcall (js* "(value) => !!value") entry)
               (= (js-call path :resolve entry) module-file))
      (main)))

  (export DEFAULT_ROOT ContractValidationError checkContracts))
