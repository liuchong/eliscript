(module tools.onboarding.check
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile stat writeFile)
  (import "node:os" :as os)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst module-root (js-call path :resolve (js-call path :dirname module-file) "../.."))
  (defconst contract-file "contracts/local-onboarding.json")
  (defconst guide-file "docs/getting-started.md")
  (defconst expected-steps
    (js-array
      (js-array "locked-dependencies" (js-array "bun" "install" "--frozen-lockfile") 300000 false)
      (js-array "command-discovery" (js-array "./bin/eliscript" "--help") 60000 t)
      (js-array "compiler-build" (js-array "bun" "run" "build:bootstrap") 300000 t)
      (js-array "documented-project" (js-array "bun" "test" "tests/onboarding-docs.test.mjs") 120000 t)
      (js-array "strict-byte-compile" (js-array "make" "byte-compile") 300000 t)
      (js-array "core-suite" (js-array "make" "test-core") 900000 t)))
  (defconst expected-documentation
    (js-array
      "sudo apt-get install -y git emacs unzip curl"
      "brew install git emacs"
      "curl -fsSL https://bun.com/install | bash"
      "bun install --frozen-lockfile"
      "./bin/eliscript --help"
      "bun run build:bootstrap"
      "bun test tests/onboarding-docs.test.mjs"
      "make byte-compile"
      "make test-core"))
  (defconst expected-source-files
    (js-array
      "Makefile"
      "bun.lock"
      "contracts/local-onboarding.json"
      "docs/getting-started.md"
      "examples/getting-started/eliscript.json"
      "examples/getting-started/src/main.eli"
      "examples/getting-started/src/math.eli"
      "package.json"
      "specs/0135-local-onboarding.md"
      "tests/onboarding-docs.test.mjs"
      "tests/test-partition.test.mjs"
      "tools/onboarding/check.mjs"))
  (defconst expected-environment
    (js-object :provider "local" :requiredCommands (js-array "git" "bun" "emacs" "make")))
  (defconst application-tests
    (js-array
      "tests/eliscript-org-tests.el"
      "tests/vite-plugin.test.mjs"
      "tests/org-vite-plugin.test.mjs"
      "tests/application-cli-test.sh"))
  (defconst target-pattern "^[A-Za-z0-9_.-]+:")
  (defconst option-names
    (js-object "--json-output" "jsonOutput" "--markdown-output" "markdownOutput"
      "--verify-run" "verifyRun" "--verify-markdown" "verifyMarkdown"))
  (defconst valued-options
    (js-array "--json-output" "--markdown-output" "--verify-run" "--verify-markdown"))
  (defconst environment-keys
    (js-array "operatingSystem" "architecture" "cpu" "gitVersion" "bunVersion" "nodeVersion" "emacsVersion"))

  (defun onboarding-error-message (errors)
    (str "local onboarding validation failed:\n- " (js-call errors :join "\n- ")))

  (defun onboarding-error-fields (self errors)
    (put self :name "OnboardingValidationError")
    (put self :errors errors)
    self)

  (defconst OnboardingValidationError
    (funcall
      (js* "(message, fields) => class OnboardingValidationError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      onboarding-error-message
      onboarding-error-fields))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun plain-object? (value)
    (and (not (nil? value))
         (= (host-type value) "object")
         (not (Array/isArray value))))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object)
      (aref supplied 0)))

  (defun sha256 (value)
    (js-call (js-call (createHash "sha256") :update value) :digest "hex"))

  (defun milliseconds-since (started)
    (/ (funcall globalThis.Number
         (- (js-call (get globalThis.process :hrtime) :bigint) started))
       1000000))

  (defun rounded-milliseconds-since (started)
    (/ (js-call globalThis.Math :round
         (/ (funcall globalThis.Number
              (- (js-call (get globalThis.process :hrtime) :bigint) started))
            1000))
       1000))

  (defun safe-relative-path (value)
    (and (= (host-type value) "string")
         (> (js-length value) 0)
         (not (js-call path :isAbsolute value))
         (not (js-call (js-call value :split "/") :includes ".."))
         (= value (js-call value :replaceAll "\\" "/"))))

  (defasync read-json (filename)
    (JSON/parse (await (readFile filename "utf8"))))

  (defasync git (root args &rest supplied)
    (let* ((options (call-options supplied))
           (child (globalThis.Bun.spawn (js-call (js-array "git") :concat args)
                    (js-object :cwd root :stdin "ignore" :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                  (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exit-code (aref result 0))
           (stderr (aref result 2))
           (trimmed (js-call stderr :trim)))
      (when (and (not (= exit-code 0)) (not (host-truthy (get options :allowFailure))))
        (throw (new globalThis.Error
                 (if (host-truthy trimmed)
                   trimmed
                   (str "git " (js-call args :join " ") " exited with " exit-code)))))
      (js-object :exitCode exit-code :stdout (aref result 1) :stderr stderr)))

  (defun target-source (makefile name)
    (let ((lines (js-call makefile :split "\n")) (start -1) (index 0))
      (while (and (< start 0) (< index (js-length lines)))
        (when (js-call (aref lines index) :startsWith (str name ":"))
          (setq start index))
        (setq index (1+ index)))
      (if (< start 0)
        nil
        (let ((body (js-array)) (cursor (1+ start)))
          (while (< cursor (js-length lines))
            (let ((line (aref lines cursor)))
              (if (js-call (new globalThis.RegExp target-pattern) :test line)
                (setq cursor (js-length lines))
                (progn
                  (js-call body :push line)
                  (setq cursor (1+ cursor))))))
          (str (aref lines start) "\n" (js-call body :join "\n"))))))

  (defun validate-environment (contract errors)
    (unless (= (JSON/stringify (get contract :environment)) (JSON/stringify expected-environment))
      (js-call errors :push "environment must match the version 1 local inventory"))
    (unless (= (get contract :maximumActiveDurationMs) 900000)
      (js-call errors :push "maximumActiveDurationMs must be 900000")))

  (defun expected-step-ids ()
    (let ((ids (js-array)) (index 0))
      (while (< index (js-length expected-steps))
        (js-call ids :push (aref (aref expected-steps index) 0))
        (setq index (1+ index)))
      ids))

  (defun step-ids (steps)
    (let ((ids (js-array)) (index 0))
      (while (< index (js-length steps))
        (js-call ids :push (host-get (aref steps index) "id"))
        (setq index (1+ index)))
      ids))

  (defun command-leaks-applications (command)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length application-tests)))
        (when (js-call command :includes (aref application-tests index))
          (setq found t))
        (setq index (1+ index)))
      (or found (js-call command :includes "test-applications"))))

  (defun validate-steps (steps errors)
    (if (not (Array/isArray steps))
      (js-call errors :push "steps must be an array")
      (progn
        (let ((expected-ids (expected-step-ids)))
          (unless (= (JSON/stringify (step-ids steps)) (JSON/stringify expected-ids))
            (js-call errors :push (str "step ids must be exactly: " (js-call expected-ids :join ", ")))))
        (let ((index 0))
          (while (< index (js-length steps))
            (let ((step (aref steps index)) (label (str "steps[" index "]")))
              (if (not (plain-object? step))
                (js-call errors :push (str label " must be an object"))
                (progn
                  (when (or (not (Array/isArray (get step :argv)))
                            (= (js-length (get step :argv)) 0)
                            (let ((cursor 0) (bad nil))
                              (while (and (not bad) (< cursor (js-length (get step :argv))))
                                (let ((argument (aref (get step :argv) cursor)))
                                  (unless (and (= (host-type argument) "string") (> (js-length argument) 0))
                                    (setq bad t)))
                                (setq cursor (1+ cursor)))
                              bad))
                    (js-call errors :push (str label ".argv must be a non-empty string array")))
                  (when (or (not (js-call globalThis.Number :isInteger (get step :timeoutMs)))
                            (< (get step :timeoutMs) 1000)
                            (> (get step :timeoutMs) 900000))
                    (js-call errors :push (str label ".timeoutMs must be between 1000 and 900000")))
                  (unless (= (host-type (get step :countsTowardActiveDuration)) "boolean")
                    (js-call errors :push (str label ".countsTowardActiveDuration must be boolean")))
                  (let ((expected (aref expected-steps index)))
                    (when (and expected
                               (or (not (= (get step :id) (aref expected 0)))
                                   (not (= (JSON/stringify (get step :argv)) (JSON/stringify (aref expected 1))))
                                   (not (= (get step :timeoutMs) (aref expected 2)))
                                   (not (= (get step :countsTowardActiveDuration) (aref expected 3)))))
                      (js-call errors :push (str label " must match the version 1 " (aref expected 0) " step"))))
                  (let ((command (if (Array/isArray (get step :argv)) (js-call (get step :argv) :join " ") "")))
                    (when (command-leaks-applications command)
                      (js-call errors :push (str label " leaks application validation into onboarding")))))))
            (setq index (1+ index))))
        (unless (= (host-get (aref steps 0) "countsTowardActiveDuration") false)
          (js-call errors :push "locked-dependencies must be excluded from active duration"))
        (let ((rest (js-call steps :slice 1)) (index 0))
          (while (< index (js-length rest))
            (let ((step (aref rest index)))
              (unless (= (host-get step "countsTowardActiveDuration") t)
                (let ((step-id (host-get step "id")))
                  (js-call errors :push
                    (str (if (nullish? step-id) "unknown step" step-id) " must count toward active duration")))))
            (setq index (1+ index))))
        (let ((core nil) (index 0))
          (while (and (nullish? core) (< index (js-length steps)))
            (when (= (host-get (aref steps index) "id") "core-suite")
              (setq core (aref steps index)))
            (setq index (1+ index)))
          (unless (= (JSON/stringify (host-get core "argv"))
                     (JSON/stringify (js-array "make" "test-core")))
            (js-call errors :push "core-suite must execute make test-core"))))))

  (defasync tracked-file (root filename errors)
    (let ((tracked (await (git root (js-array "ls-files" "--error-unmatch" "--" filename)
                           (js-object :allowFailure t)))))
      (when (and (not (= (get tracked :exitCode) 0)) (js-call filename :endsWith ".mjs"))
        (setq tracked (await (git root
                              (js-array "ls-files" "--error-unmatch" "--"
                                (str (js-call filename :slice 0 -4) ".eli"))
                              (js-object :allowFailure t)))))
      (if (not (= (get tracked :exitCode) 0))
        (js-call errors :push (str filename " must be tracked"))
        (try
          (unless (js-call (await (stat (js-call path :join root filename))) :isFile)
            (js-call errors :push (str filename " must be a regular file")))
          (catch error
            (js-call errors :push (str filename " cannot be read: " (get error :message))))))))

  (defun some-blank-text (values)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length values)))
        (let ((value (aref values index)))
          (unless (and (= (host-type value) "string") (> (js-length value) 0))
            (setq found t)))
        (setq index (1+ index)))
      found))

  (defun some-unsafe-path (values)
    (let ((index 0) (found nil))
      (while (and (not found) (< index (js-length values)))
        (unless (safe-relative-path (aref values index))
          (setq found t))
        (setq index (1+ index)))
      found))

  (defasync checkOnboarding (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root module-root)))
           (contract (if (nullish? (get options :contract))
                       (await (read-json (js-call path :join root contract-file)))
                       (get options :contract)))
           (errors (js-array)))
      (when (or (not (plain-object? contract))
                (not (= (get contract :schemaVersion) 1))
                (not (= (get contract :format) "eliscript-local-onboarding"))
                (not (= (get contract :version) 1)))
        (js-call errors :push "contract must use eliscript-local-onboarding version 1"))
      (validate-environment contract errors)
      (validate-steps (get contract :steps) errors)
      (when (or (not (Array/isArray (get contract :requiredDocumentation)))
                (= (js-length (get contract :requiredDocumentation)) 0)
                (some-blank-text (get contract :requiredDocumentation)))
        (js-call errors :push "requiredDocumentation must be a non-empty string array"))
      (unless (= (JSON/stringify (get contract :requiredDocumentation))
                 (JSON/stringify expected-documentation))
        (js-call errors :push "requiredDocumentation must match the version 1 inventory"))
      (if (or (not (Array/isArray (get contract :sourceFiles)))
              (= (js-length (get contract :sourceFiles)) 0)
              (some-unsafe-path (get contract :sourceFiles)))
        (js-call errors :push "sourceFiles must be non-empty safe relative paths")
        (let ((files (get contract :sourceFiles))
              (sorted (js-call (Array/from (get contract :sourceFiles)) :sort)))
          (unless (and (= (get (new globalThis.Set files) :size) (js-length files))
                       (= (JSON/stringify sorted) (JSON/stringify files)))
            (js-call errors :push "sourceFiles must be unique and sorted"))
          (let ((index 0))
            (while (< index (js-length files))
              (await (tracked-file root (aref files index) errors))
              (setq index (1+ index))))))
      (unless (= (JSON/stringify (get contract :sourceFiles)) (JSON/stringify expected-source-files))
        (js-call errors :push "sourceFiles must match the version 1 inventory"))
      (let ((loaded (await (Promise/all (js-array
                            (readFile (js-call path :join root guide-file) "utf8")
                            (readFile (js-call path :join root "Makefile") "utf8")))))
            (guide nil)
            (makefile nil))
        (setq guide (aref loaded 0))
        (setq makefile (aref loaded 1))
        (let ((literals (get contract :requiredDocumentation)) (index 0))
          (setq literals (if (nullish? literals) (js-array) (Array/from literals)))
          (while (< index (js-length literals))
            (unless (js-call guide :includes (aref literals index))
              (js-call errors :push (str guide-file " is missing required text: " (aref literals index))))
            (setq index (1+ index))))
        (let ((aggregate (target-source makefile "test"))
              (core (target-source makefile "test-core"))
              (application (target-source makefile "test-applications")))
          (unless (and aggregate (js-call aggregate :startsWith "test: test-core test-applications"))
            (js-call errors :push "test target must aggregate test-core and test-applications"))
          (if (or (not (host-truthy core)) (not (host-truthy application)))
            (js-call errors :push "Makefile must define test-core and test-applications")
            (let ((index 0))
              (while (< index (js-length application-tests))
                (let ((filename (aref application-tests index)))
                  (when (js-call core :includes filename)
                    (js-call errors :push (str "test-core contains application evidence: " filename)))
                  (unless (js-call application :includes filename)
                    (js-call errors :push (str "test-applications is missing: " filename))))
                (setq index (1+ index)))))))
      (when (> (js-length errors) 0)
        (throw (new OnboardingValidationError errors)))
      (js-object :schemaVersion 1
        :format "eliscript-local-onboarding-contract-report"
        :version 1
        :steps (js-length (get contract :steps))
        :activeSteps (js-length (js-call (get contract :steps) :filter
                                 (lambda (step) (get step :countsTowardActiveDuration))))
        :sourceFiles (js-length (get contract :sourceFiles))
        :maximumActiveDurationMs (get contract :maximumActiveDurationMs)
        :environment (get contract :environment)
        :contract contract)))

  (defun bounded-summary (stdout stderr)
    (let ((lines (js-call (js-call (js-call (str stdout "\n" stderr) :split (new globalThis.RegExp "\\r?\\n"))
                             :map (lambda (line) (js-call line :trim)))
                    :filter (lambda (line) (host-truthy line)))))
      (js-call (js-call (js-call lines :slice -3) :join " | ") :slice 0 600)))

  (defun step-failure (step started error)
    (let ((message (funcall globalThis.String (get error :message))))
      (js-object :id (get step :id) :argv (get step :argv) :timeoutMs (get step :timeoutMs)
        :countsTowardActiveDuration (get step :countsTowardActiveDuration)
        :status "fail" :exitCode nil :timedOut false
        :durationMs (milliseconds-since started)
        :stdoutSha256 (sha256 "") :stderrSha256 (sha256 message)
        :summary (js-call message :slice 0 600))))

  (defasync run-step (root step)
    (let ((started (js-call (get globalThis.process :hrtime) :bigint))
          (spawn-error nil)
          (child nil))
      (try
        (setq child (globalThis.Bun.spawn (get step :argv)
                      (js-object :cwd root
                        :env (Object/assign (js-object) (get globalThis.process :env)
                               (js-object :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE "1"))
                        :stdin "ignore" :stdout "pipe" :stderr "pipe")))
        (catch error (setq spawn-error error)))
      (if spawn-error
        (step-failure step started spawn-error)
        (let ((timed-out false) (force-kill nil))
          (let ((timer (funcall globalThis.setTimeout
                         (lambda ()
                           (setq timed-out t)
                           (js-call child :kill "SIGTERM")
                           (setq force-kill (funcall globalThis.setTimeout
                                              (lambda () (js-call child :kill "SIGKILL"))
                                              2000)))
                         (get step :timeoutMs))))
            (let ((result (await (Promise/all (js-array (get child :exited)
                                         (js-call (new globalThis.Response (get child :stdout)) :text)
                                         (js-call (new globalThis.Response (get child :stderr)) :text))))))
              (funcall globalThis.clearTimeout timer)
              (funcall globalThis.clearTimeout force-kill)
              (let ((exit-code (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
                (when (> (js-length stdout) 0)
                  (js-call (get globalThis.process :stdout) :write stdout))
                (when (> (js-length stderr) 0)
                  (js-call (get globalThis.process :stderr) :write stderr))
                (js-object :id (get step :id) :argv (get step :argv) :timeoutMs (get step :timeoutMs)
                  :countsTowardActiveDuration (get step :countsTowardActiveDuration)
                  :status (if (and (= exit-code 0) (not timed-out)) "pass" "fail")
                  :exitCode exit-code :timedOut timed-out
                  :durationMs (rounded-milliseconds-since started)
                  :stdoutSha256 (sha256 stdout) :stderrSha256 (sha256 stderr)
                  :summary (bounded-summary stdout stderr)))))))))

  (defasync command-text (root argv)
    (let* ((child (globalThis.Bun.spawn argv
                    (js-object :cwd root :stdin "ignore" :stdout "pipe" :stderr "pipe")))
           (force-kill nil)
           (timer (funcall globalThis.setTimeout
                   (lambda ()
                     (js-call child :kill "SIGTERM")
                     (setq force-kill (funcall globalThis.setTimeout
                                        (lambda () (js-call child :kill "SIGKILL"))
                                        2000)))
                   30000)))
      (let ((result (await (Promise/all (js-array (get child :exited)
                                   (js-call (new globalThis.Response (get child :stdout)) :text)
                                   (js-call (new globalThis.Response (get child :stderr)) :text))))))
        (funcall globalThis.clearTimeout timer)
        (funcall globalThis.clearTimeout force-kill)
        (if (not (= (aref result 0) 0))
          (let ((trimmed (js-call (aref result 2) :trim)))
            (throw (new globalThis.Error (if (host-truthy trimmed) trimmed (js-call argv :join " ")))))
          (js-call (aref result 1) :trim)))))

  (defasync environment-report (root)
    (let ((emacs (await (command-text root (js-array "emacs" "--version"))))
          (git-version (await (command-text root (js-array "git" "--version"))))
          (cpus (js-call os :cpus))
          (first nil))
      (setq first (aref cpus 0))
      (js-object :provider "local"
        :operatingSystem (str (js-call os :type) " " (js-call os :release))
        :architecture (js-call os :arch)
        :cpu (if (nullish? first) "unknown" (get first :model "unknown"))
        :gitVersion git-version
        :bunVersion (get globalThis.Bun :version)
        :nodeVersion (get globalThis.process :version)
        :emacsVersion (js-call (aref (js-call emacs :split "\n" 1) 0)
                        :replace (new globalThis.RegExp "^GNU Emacs ") ""))))

  (defun validate-live-environment (environment contract errors)
    (unless (= (get environment :provider) (get (get contract :environment) :provider))
      (js-call errors :push "run must use the local provider"))
    (let ((index 0))
      (while (< index (js-length environment-keys))
        (let* ((key (aref environment-keys index)) (value (get environment key)))
          (unless (and (= (host-type value) "string") (> (js-length value) 0))
            (js-call errors :push (str "local environment is missing " key))))
        (setq index (1+ index)))))

  (defasync clean-tracked-state (root)
    (= (js-call (get (await (git root (js-array "status" "--porcelain=v1" "--untracked-files=no"))) :stdout) :trim) ""))

  (defasync artifact-record (root file)
    (js-object :file file :sha256 (sha256 (await (readFile (js-call path :join root file))))))

  (defun count-status (steps status)
    (js-length (js-call steps :filter (lambda (step) (= (get step :status) status)))))

  (defun active-duration (steps)
    (/ (js-call globalThis.Math :round
         (* (js-call (js-call steps :filter (lambda (step) (get step :countsTowardActiveDuration)))
              :reduce (lambda (sum step) (+ sum (get step :durationMs))) 0)
            1000))
       1000))

  (defun install-duration (steps)
    (let ((found nil) (index 0))
      (while (and (nullish? found) (< index (js-length steps)))
        (when (= (get (aref steps index) :id) "locked-dependencies")
          (setq found (aref steps index)))
        (setq index (1+ index)))
      (if (nullish? found) 0 (get found :durationMs 0))))

  (defun skipped-step (step)
    (js-object :id (get step :id) :argv (get step :argv) :timeoutMs (get step :timeoutMs)
      :countsTowardActiveDuration (get step :countsTowardActiveDuration)
      :status "not-run" :exitCode nil :timedOut false :durationMs 0
      :stdoutSha256 (sha256 "") :stderrSha256 (sha256 "")
      :summary "stopped after an earlier failure"))

  (defasync runOnboarding (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root module-root)))
           (checked (await (checkOnboarding (js-object :root root))))
           (errors (js-array))
           (clean-before (await (clean-tracked-state root))))
      (unless clean-before
        (js-call errors :push "tracked checkout must be clean before the run"))
      (let ((source (js-object
                      :commit (js-call (get (await (git root (js-array "rev-parse" "HEAD"))) :stdout) :trim)
                      :tree (js-call (get (await (git root (js-array "rev-parse" "HEAD^{tree}"))) :stdout) :trim)))
            (environment (await (environment-report root))))
        (validate-live-environment environment (get checked :contract) errors)
        (when (> (js-length errors) 0)
          (throw (new OnboardingValidationError errors)))
        (let ((steps (js-array)) (stopped nil) (index 0) (planned (get (get checked :contract) :steps)))
          (while (< index (js-length planned))
            (let ((step (aref planned index)))
              (if stopped
                (js-call steps :push (skipped-step step))
                (let ((result (await (run-step root step))))
                  (js-call steps :push result)
                  (unless (= (get result :status) "pass")
                    (setq stopped t)))))
            (setq index (1+ index)))
          (let* ((clean-after (await (clean-tracked-state root)))
                 (active (active-duration steps))
                 (passed (count-status steps "pass"))
                 (failed (count-status steps "fail"))
                 (not-run (count-status steps "not-run"))
                 (within (<= active (get (get checked :contract) :maximumActiveDurationMs)))
                 (validation (and (= passed (js-length steps)) (= failed 0) (= not-run 0)
                                  clean-before clean-after within))
                 (generated (js-call (new globalThis.Date) :toISOString))
                 (contract-hash (sha256 (await (readFile (js-call path :join root contract-file)))))
                 (artifacts (await (Promise/all (js-call (get (get checked :contract) :sourceFiles) :map
                                                  (lambda (file) (artifact-record root file)))))))
            (js-object :schemaVersion 1 :format "eliscript-local-onboarding-run" :version 1
              :generatedAt generated :contractSha256 contract-hash :source source
              :execution (js-object :provider "local" :sourceCommit (get source :commit))
              :environment environment :steps steps :artifacts artifacts
              :summary (js-object :required (js-length steps) :passed passed :failed failed :notRun not-run
                         :installDurationMs (install-duration steps) :activeDurationMs active
                         :maximumActiveDurationMs (get (get checked :contract) :maximumActiveDurationMs)
                         :withinActiveBudget within :cleanBefore clean-before :cleanAfter clean-after
                         :applicationsExecuted false :validationPass validation)))))))

  (defun markdown-cell (value)
    (js-call (js-call (funcall globalThis.String value) :replaceAll "|" "\\|") :replaceAll "\n" " "))

  (defun yes-no (value)
    (if (host-truthy value) "yes" "no"))

  (defun humanRunReport (report)
    (let ((lines (js-array
                   "# Local Onboarding Run"
                   ""
                   (str "- Source commit: `" (get (get report :source) :commit) "`")
                   (str "- Source tree: `" (get (get report :source) :tree) "`")
                   (str "- Execution: " (get (get report :execution) :provider))
                   (str "- Generated: " (get report :generatedAt))
                   (str "- Environment: " (get (get report :environment) :operatingSystem) "; "
                        (get (get report :environment) :architecture) "; Bun "
                        (get (get report :environment) :bunVersion) "; Node "
                        (get (get report :environment) :nodeVersion) "; Emacs "
                        (get (get report :environment) :emacsVersion))
                   (str "- Tracked checkout clean: "
                        (if (and (host-truthy (get (get report :summary) :cleanBefore))
                                 (host-truthy (get (get report :summary) :cleanAfter)))
                          "yes" "no"))
                   (str "- Active duration: " (get (get report :summary) :activeDurationMs) " / "
                        (get (get report :summary) :maximumActiveDurationMs) " ms")
                   (str "- Application validation executed: " (yes-no (get (get report :summary) :applicationsExecuted)))
                   (str "- Local validation: " (if (host-truthy (get (get report :summary) :validationPass)) "pass" "fail"))
                   ""
                   "Dependency installation is measured separately and excluded from the active"
                   "duration. Application validations cannot contribute to this result."
                   ""
                   "## Steps"
                   ""
                   "| Step | Command | Result | Exit | Active | Duration (ms) | stdout SHA-256 | stderr SHA-256 | Summary |"
                   "| --- | --- | --- | ---: | --- | ---: | --- | --- | --- |"))
          (index 0)
          (steps (get report :steps)))
      (while (< index (js-length steps))
        (let ((step (aref steps index)))
          (js-call lines :push
            (str "| " (get step :id) " | `" (markdown-cell (js-call (get step :argv) :join " ")) "` | "
                 (get step :status) " | " (get step :exitCode "-") " | "
                 (yes-no (get step :countsTowardActiveDuration)) " | " (get step :durationMs) " | `"
                 (get step :stdoutSha256) "` | `" (get step :stderrSha256) "` | "
                 (markdown-cell (if (host-truthy (get step :summary)) (get step :summary) "-")) " |")))
        (setq index (1+ index)))
      (js-call lines :push "")
      (js-call lines :push "## Source Artifacts")
      (js-call lines :push "")
      (js-call lines :push "| File | SHA-256 |")
      (js-call lines :push "| --- | --- |")
      (setq index 0)
      (let ((artifacts (get report :artifacts)))
        (while (< index (js-length artifacts))
          (let ((artifact (aref artifacts index)))
            (js-call lines :push (str "| `" (get artifact :file) "` | `" (get artifact :sha256) "` |")))
          (setq index (1+ index))))
      (str (js-call lines :join "\n") "\n")))

  (defasync source-at-commit (root commit filename)
    (get (await (git root (js-array "show" (str commit ":" filename)))) :stdout))

  (defun full-identity (value)
    (js-call (new globalThis.RegExp "^[0-9a-f]{40}$") :test (if (nullish? value) "" value)))

  (defun digest-identity (value)
    (js-call (new globalThis.RegExp "^[0-9a-f]{64}$") :test (if (nullish? value) "" value)))

  (defun missing-text (value key)
    (let ((text (get value key)))
      (or (not (= (host-type text) "string")) (= (js-length text) 0))))

  (defasync verifyRun (options)
    (let* ((root (js-call path :resolve (get options :root module-root)))
           (checked (await (checkOnboarding (js-object :root root))))
           (report (if (nullish? (get options :report))
                     (await (read-json (js-call path :resolve root (get options :runFile))))
                     (get options :report)))
           (errors (js-array))
           (source (host-get report "source")))
      (when (or (not (plain-object? report))
                (not (= (get report :schemaVersion) 1))
                (not (= (get report :format) "eliscript-local-onboarding-run"))
                (not (= (get report :version) 1)))
        (js-call errors :push "run must use eliscript-local-onboarding-run version 1"))
      (when (or (not (full-identity (host-get source "commit")))
                (not (full-identity (host-get source "tree"))))
        (js-call errors :push "run source must contain full commit and tree identities"))
      (let ((ancestor (await (git root (js-array "merge-base" "--is-ancestor"
                                           (if (nullish? source) "missing" (get source :commit "missing"))
                                           "HEAD")
                              (js-object :allowFailure t)))))
        (unless (= (get ancestor :exitCode) 0)
          (js-call errors :push "run source commit must be an ancestor of HEAD")))
      (let ((tree (await (git root (js-array "rev-parse" (str (host-get source "commit") "^{tree}"))
                          (js-object :allowFailure t)))))
        (when (or (not (= (get tree :exitCode) 0))
                  (not (= (js-call (get tree :stdout) :trim) (host-get source "tree"))))
          (js-call errors :push "run source tree does not match its commit")))
      (unless (= (JSON/stringify (get report :execution))
                 (JSON/stringify (js-object :provider "local" :sourceCommit (host-get source "commit"))))
        (js-call errors :push "run must identify local execution at its source commit"))
      (unless (= (host-get (host-get report "environment") "provider") "local")
        (js-call errors :push "run environment must use the local provider"))
      (let ((environment (host-get report "environment")) (index 0))
        (while (< index (js-length environment-keys))
          (let ((key (aref environment-keys index)))
            (when (or (nullish? environment) (missing-text environment key))
              (js-call errors :push (str "run environment is missing " key))))
          (setq index (1+ index))))
      (if (or (not (Array/isArray (get report :steps)))
              (not (= (js-length (get report :steps)) (get checked :steps))))
        (js-call errors :push "run must contain every contracted step")
        (let ((index 0) (planned (get (get checked :contract) :steps)))
          (while (< index (js-length planned))
            (let ((expected (aref planned index)) (actual (aref (get report :steps) index)))
              (when (or (not (= (host-get actual "id") (get expected :id)))
                        (not (= (JSON/stringify (host-get actual "argv")) (JSON/stringify (get expected :argv))))
                        (not (= (host-get actual "timeoutMs") (get expected :timeoutMs)))
                        (not (= (host-get actual "countsTowardActiveDuration")
                                (get expected :countsTowardActiveDuration))))
                (js-call errors :push (str "run step " index " does not match " (get expected :id))))
              (when (or (not (= (host-get actual "status") "pass"))
                        (not (= (host-get actual "exitCode") 0))
                        (not (= (host-get actual "timedOut") false)))
                (js-call errors :push (str "run step " (get expected :id) " did not pass")))
              (let ((field-index 0) (fields (js-array "stdoutSha256" "stderrSha256")))
                (while (< field-index (js-length fields))
                  (let ((field (aref fields field-index)))
                    (unless (digest-identity (if (nullish? actual) "" (get actual field "")))
                      (js-call errors :push (str "run step " (get expected :id) " has invalid " field))))
                  (setq field-index (1+ field-index))))
              (when (or (nullish? actual)
                        (not (= (host-type (get actual :durationMs)) "number"))
                        (< (get actual :durationMs) 0))
                (js-call errors :push (str "run step " (get expected :id) " has invalid durationMs"))))
            (setq index (1+ index)))))
      (let* ((artifacts (host-get report "artifacts"))
             (artifact-files (if (nullish? artifacts)
                               (js-array)
                               (let ((mapped (js-call artifacts :map (lambda (artifact) (get artifact :file)))))
                                 (if (nullish? mapped) (js-array) mapped)))))
        (if (not (= (JSON/stringify artifact-files) (JSON/stringify (get (get checked :contract) :sourceFiles))))
          (js-call errors :push "run artifact inventory does not match sourceFiles")
          (let ((index 0))
            (while (< index (js-length artifacts))
              (let ((artifact (aref artifacts index)))
                (try
                  (unless (= (sha256 (await (source-at-commit root (get source :commit) (get artifact :file))))
                             (get artifact :sha256))
                    (js-call errors :push (str "run artifact digest differs from source commit: " (get artifact :file))))
                  (catch error
                    (js-call errors :push (str "cannot verify run artifact " (get artifact :file) ": " (get error :message))))))
              (setq index (1+ index))))))
      (try
        (unless (= (sha256 (await (source-at-commit root (get source :commit) contract-file)))
                   (get report :contractSha256))
          (js-call errors :push "run contract digest differs from source commit"))
        (catch error
          (js-call errors :push (str "cannot verify run contract: " (get error :message)))))
      (let* ((steps (if (Array/isArray (get report :steps)) (get report :steps) (js-array)))
             (active (active-duration steps))
             (expected-summary (js-object :required (get checked :steps)
                                 :passed (count-status steps "pass")
                                 :failed (count-status steps "fail")
                                 :notRun (count-status steps "not-run")
                                 :installDurationMs (install-duration steps)
                                 :activeDurationMs active
                                 :maximumActiveDurationMs (get checked :maximumActiveDurationMs)
                                 :withinActiveBudget (<= active (get checked :maximumActiveDurationMs))
                                 :cleanBefore t :cleanAfter t :applicationsExecuted false :validationPass t)))
        (unless (= (JSON/stringify (get report :summary)) (JSON/stringify expected-summary))
          (js-call errors :push "run summary is not the derived passing result")))
      (when (> (js-length errors) 0)
        (throw (new OnboardingValidationError errors)))
      (when (host-truthy (get options :markdownFile))
        (let ((markdown (await (readFile (js-call path :resolve root (get options :markdownFile)) "utf8"))))
          (unless (= markdown (humanRunReport report))
            (throw (new OnboardingValidationError
                     (js-array (str (get options :markdownFile) " is not the exact generated report")))))))
      report))

  (defun contract-summary (checked)
    (js-call (js-array
               "Local onboarding contract:"
               (str "  Provider     " (get (get checked :environment) :provider))
               (str "  Commands     " (js-call (get (get checked :environment) :requiredCommands) :join ", "))
               (str "  Steps        " (get checked :steps) " total, " (get checked :activeSteps) " active")
               (str "  Active limit " (get checked :maximumActiveDurationMs) " ms")
               (str "  Sources      " (get checked :sourceFiles)))
      :join "\n"))

  (defun run-summary (report)
    (js-call (js-array
               (str "Local onboarding run: " (get (get report :source) :commit))
               (str "Provider: " (get (get report :execution) :provider))
               (str "Steps: " (get (get report :summary) :passed) "/" (get (get report :summary) :required) " pass")
               (str "Active duration: " (get (get report :summary) :activeDurationMs) "/"
                    (get (get report :summary) :maximumActiveDurationMs) " ms")
               (str "Tracked checkout clean: "
                    (if (and (host-truthy (get (get report :summary) :cleanBefore))
                             (host-truthy (get (get report :summary) :cleanAfter)))
                      "yes" "no"))
               (str "Application validation executed: " (yes-no (get (get report :summary) :applicationsExecuted)))
               (str "Validation: " (if (host-truthy (get (get report :summary) :validationPass)) "pass" "fail")))
      :join "\n"))

  (defun parse-arguments (argv)
    (let ((options (js-object)) (index 0))
      (while (< index (js-length argv))
        (let ((argument (aref argv index)))
          (if (= argument "--run")
            (put options :run t)
            (if (js-call valued-options :includes argument)
              (let ((value (aref argv (1+ index))))
                (unless (host-truthy value)
                  (throw (new globalThis.Error (str argument " requires a path"))))
                (setq index (1+ index))
                (put options (get option-names argument) value))
              (throw (new globalThis.Error (str "unknown option: " argument))))))
        (setq index (1+ index)))
      options))

  (defasync main (&rest supplied)
    (let ((argv (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
                  (js-call (get globalThis.process :argv) :slice 2)
                  (aref supplied 0)))
          (options nil))
      (setq options (parse-arguments argv))
      (if (host-truthy (get options :run))
        (progn
          (when (or (not (host-truthy (get options :jsonOutput)))
                    (not (host-truthy (get options :markdownOutput)))
                    (host-truthy (get options :verifyRun)))
            (throw (new globalThis.Error "--run requires --json-output and --markdown-output only")))
          (let ((report (await (runOnboarding (js-object :root module-root)))))
            (await (writeFile (js-call path :resolve module-root (get options :jsonOutput))
                     (str (JSON/stringify report nil 2) "\n")))
            (await (writeFile (js-call path :resolve module-root (get options :markdownOutput))
                     (humanRunReport report)))
            (js-call (get globalThis.process :stdout) :write (str (run-summary report) "\n"))
            (unless (host-truthy (get (get report :summary) :validationPass))
              (put globalThis.process :exitCode 1))
            report))
        (if (host-truthy (get options :verifyRun))
          (let ((report (await (verifyRun (js-object :root module-root
                                            :runFile (get options :verifyRun)
                                            :markdownFile (get options :verifyMarkdown))))))
            (js-call (get globalThis.process :stdout) :write (str (run-summary report) "\n"))
            report)
          (if (host-truthy (get options :verifyMarkdown))
            (throw (new globalThis.Error "--verify-markdown requires --verify-run"))
            (let ((checked (await (checkOnboarding (js-object :root module-root)))))
              (js-call (get globalThis.process :stdout) :write (str (contract-summary checked) "\n"))
              checked))))))

  (when (js* "import.meta.main")
    (js-call (main) :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write (str (get error :message) "\n"))
        (put globalThis.process :exitCode 1))))

  (export OnboardingValidationError checkOnboarding runOnboarding humanRunReport verifyRun main))
