(module tools.fuzz.reader-program-acceptance
  (import "node:assert/strict" :default assert)
  (import "node:path" resolve)
  (import "node:fs/promises" mkdtemp rm writeFile realpath)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../backends/build.mjs" root)
  (import "./reader-program-fuzz.mjs" fuzzCases)
  (import "./program-emission-proof.mjs" runFuzzProofCommand)

  (defconst scalar-pattern (new globalThis.RegExp
    "^\\(module fuzz\\.case-([a-z0-9]+)\\n  \\(defconst base-\\1 ([0-9]+)\\)\\n  \\(defun compute-\\1 \\(value\\)\\n    \\(\\+ value base-\\1\\)\\)\\n  \\(export compute-\\1\\)\\)$"))
  (defconst vector-pattern (new globalThis.RegExp
    "^\\(module fuzz\\.case-([a-z0-9]+)\\n  \\(defconst base-\\1 \\[([0-9]+) :ok\\]\\)\\n  \\(defun compute-\\1 \\(value\\) value\\)\\n  \\(export compute-\\1\\)\\)$"))
  (defasync proveFuzzProgramEmission (&rest arguments)
    (let* ((selected-directory (if (= (js-length arguments) 0) undefined (aref arguments 0)))
           (selected (new globalThis.Map))
           (iterator (js-call (fuzzCases 100000 1162627377) (get globalThis.Symbol :iterator)))
           (done false))
      (while (and (not done) (< (get selected :size) 2))
        (let ((next (js-call iterator :next)))
          (if (get next :done) (setq done t)
            (let ((item (get next :value)))
              (when (= (get item :kind) "program")
                (let* ((scalar (js-call scalar-pattern :exec (get item :source)))
                       (vector (js-call vector-pattern :exec (get item :source)))
                       (shape (cond (scalar "scalar") (vector "vector") (t nil)))
                       (matched (or scalar vector)))
                  (when (and shape (not (js-call selected :has shape)))
                    (js-call selected :set shape (Object/assign (js-object) item
                      (js-object :name (+ "fuzz-proof-" shape) :shape shape :suffix (aref matched 1)
                        :value (funcall globalThis.Number (aref matched 2)) :exportName (+ "compute_" (aref matched 1))))))))))))
      (js-call assert :deepStrictEqual (js-call (Array/from (js-call selected :keys)) :sort) (js-array "scalar" "vector"))
      (let* ((scalar (js-call selected :get "scalar")) (constant (+ "base-" (get scalar :suffix)))
             (early (Object/assign (js-object) scalar (js-object :name "fuzz-proof-tdz" :filename "fuzz-proof-tdz.eli"
               :shape "tdz" :source (js-call (get scalar :source) :replace (+ "  (defconst " constant)
                 (+ "  (defconst before " constant ")\n  (defconst " constant)))))
             (assignment (Object/assign (js-object) scalar (js-object :name "fuzz-proof-const-write"
               :filename "fuzz-proof-const-write.eli" :shape "const-write"
               :source (js-call (js-call (get scalar :source) :replace (+ "(+ value " constant ")") (+ "(setq " constant " value)"))
                 :replace (+ "  (export compute-" (get scalar :suffix) "))")
                 (+ "  (defun current () " constant ")\n  (export compute-" (get scalar :suffix) " current))")))))
             (mutable (Object/assign (js-object) scalar (js-object :name "fuzz-proof-mutable-value"
               :filename "fuzz-proof-mutable-value.eli" :shape "mutable-value"
               :source (js-call (js-call (js-call (get scalar :source)
                  :replace (+ "(defconst " constant " " (get scalar :value) ")")
                  "(import \"node:path\" basename)\n  (defvar value -0.0)")
                  :replace (+ "(value)\n    (+ value " constant "))") "(next)\n    (setq value next))")
                  :replace (+ "  (export compute-" (get scalar :suffix) "))")
                  (+ "  (defun current () value)\n  (export value compute-" (get scalar :suffix) " current))")))))
             (cases (js-call (Array/from (js-call selected :values)) :concat (js-array early mutable)))
             (offset (+ (js-call (get assignment :source) :indexOf (+ "(setq " constant " value)")) 6))
             (preceding (js-call (get assignment :source) :slice 0 offset))
             (line (js-length (js-call preceding :split "\n")))
             (column (- offset (js-call preceding :lastIndexOf "\n")))
             (message (+ "cannot assign to immutable binding: " constant))
             (diagnostic (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-A0001" :severity "error"
               :phase "analysis" :message message :location (js-object :file (get assignment :filename)
                 :start (js-object :offset offset :line line :column column)
                 :end (js-object :offset (+ offset (js-length constant)) :line line :column (+ column (js-length constant))))))
             (rendered (str (get assignment :filename) ":" line ":" column ": " message))
             (directory (await (mkdtemp (resolve root ".eliscript-fuzz-semantic-proof-")))))
        (js-call assert :ok (>= offset 6))
        (try
          (when (and (not (undefined? selected-directory))
                 (or (/= (value-type selected-directory) "string") (= (js-length selected-directory) 0)))
            (throw (new globalThis.TypeError "fuzz proof requires an explicit selected compiler module directory")))
          (let ((compiler-directory (if (undefined? selected-directory) (resolve directory "compiler") selected-directory)))
            (when (undefined? selected-directory)
              (await (runFuzzProofCommand (js-array (resolve root "bin/eliscript-bootstrap"))
                (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compiler-directory) 30000)))
            (let* ((compiler-path (await (realpath (resolve compiler-directory "compiler.mjs"))))
                   (compiler (funcall (createRequire compiler-path) compiler-path))
                   (fixture (resolve directory "emitter-proof.json")))
              (await (writeFile fixture (JSON/stringify (js-object
                :valid (js-call cases :map (lambda (item) (js-object :name (get item :name) :source (get item :source) :filename (get item :filename))))
                :invalid (js-array (js-object :name (get assignment :name) :source (get assignment :source) :filename (get assignment :filename)))))))
              (let* ((emacs (get (get globalThis.process :env) :EMACS "emacs"))
                     (seeded (JSON/parse (await (runFuzzProofCommand
                       (js-array emacs "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script" (resolve root "tests/bootstrap-emitter-oracle.el"))
                       (js-object :ELISCRIPT_EMITTER_FIXTURE fixture) 30000))))
                     (analyzed (JSON/parse (await (runFuzzProofCommand
                       (js-array emacs "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script" (resolve root "tests/bootstrap-analyzer-oracle.el"))
                       (js-object :ELISCRIPT_ANALYZER_FIXTURE fixture) 30000)))))
                (js-call assert :deepStrictEqual (js-call seeded :map (lambda (item) (get item :name)))
                  (js-call cases :map (lambda (item) (get item :name))))
                (js-call assert :deepStrictEqual (js-call analyzed :map (lambda (item) (get item :name)))
                  (js-call (js-call cases :concat (js-array assignment)) :map (lambda (item) (get item :name))))
                (js-call assert :deepStrictEqual (js-call (js-call analyzed :slice 0 (js-length cases)) :map (lambda (item) (get item :status)))
                  (js-call cases :map (lambda (item) "ok")))
                (js-call assert :deepStrictEqual (js-call analyzed :at -1)
                  (js-object :name (get assignment :name) :status "error" :message rendered :diagnostic diagnostic))
                (js-call (js-array
                  (lambda () (js-call compiler :compile_string (get assignment :source) (get assignment :filename)))
                  (lambda () (js-call compiler :compile_string_with_source_map (get assignment :source) (get assignment :filename) "fixture.mjs" (get assignment :filename))))
                  :forEach (lambda (compile)
                    (let ((rejected false))
                      (try (funcall compile) (catch error
                        (setq rejected t) (js-call assert :strictEqual (get error :message) rendered)
                        (js-call assert :deepStrictEqual (get error :eliscriptDiagnostic) diagnostic)))
                      (js-call assert :strictEqual rejected t))))
                (let ((observations (js-array)) (index 0))
                  (while (< index (js-length cases))
                    (let* ((item (aref cases index)) (oracle (aref seeded index))
                           (javascript (js-call compiler :compile_string (get item :source) (get item :filename)))
                           (mapped (js-call compiler :compile_string_with_source_map (get item :source) (get item :filename) "fixture.mjs" (get item :filename)))
                           (seed-path (resolve directory (+ (get item :name) "-seed.mjs")))
                           (self-path (resolve directory (+ (get item :name) "-self.mjs"))))
                      (js-call assert :strictEqual (get oracle :status) "ok")
                      (js-call assert :strictEqual javascript (get oracle :javascript))
                      (js-call assert :strictEqual (get mapped :javascript) (get oracle :javascript))
                      (js-call assert :deepStrictEqual (JSON/parse (get mapped :sourceMap)) (get oracle :sourceMap))
                      ;; Only an access that can run before its declaration is guarded.
                      (js-call assert :strictEqual (js-call javascript :includes "__eliscript_tdz_")
                        (or (= (get item :shape) "tdz") (= (get item :shape) "mutable-value")))
                      (js-call assert :ok (not (js-call javascript :includes "function __eliscript_tdz_write_0(value)")))
                      (when (= (get item :shape) "tdz")
                        ;; Record 0 is the unguarded early reader; only its read of the later constant is guarded.
                        (js-call assert :ok (not (js-call javascript :includes "function __eliscript_tdz_read_0()")))
                        (js-call assert :ok (js-call javascript :includes "function __eliscript_tdz_read_1()"))
                        (js-call assert :ok (js-call javascript :includes "const before = (__eliscript_tdz_read_1());"))
                        (js-call assert :ok (js-call javascript :includes (+ "return (value + base_" (get item :suffix) ");"))))
                      (when (= (get item :shape) "mutable-value")
                        (js-call assert :ok (js-call javascript :includes "function __eliscript_tdz_read_0()"))
                        (js-call assert :ok (js-call javascript :includes "function __eliscript_tdz_write_0(__eliscript_tdz_value_0)"))
                        (js-call assert :ok (js-call javascript :includes "return (value = __eliscript_tdz_value_0);")))
                      (await (writeFile seed-path (get oracle :javascript))) (await (writeFile self-path javascript))
                      (js-call observations :push (js-object :shape (get item :shape) :value (get item :value) :exportName (get item :exportName)
                        :artifacts (js-array (get (pathToFileURL seed-path) :href) (get (pathToFileURL self-path) :href)))))
                    (setq index (1+ index)))
                  (let ((data (resolve directory "observations.json")))
                    (await (writeFile data (JSON/stringify observations)))
                    (await (runFuzzProofCommand
                      (js-array (get (get globalThis.process :env) :NODE "node") (resolve root "tools/fuzz/program-emission-node.mjs") data)
                      (js-object) 30000)))))))
          (finally (await (rm directory (js-object :recursive t :force t))))))))

  (defasync runReaderProgramFuzzAcceptance (&rest arguments)
    (let* ((directory (if (= (js-length arguments) 0) undefined (aref arguments 0)))
           (report undefined))
      (await (proveFuzzProgramEmission directory))
      (setq report (JSON/parse (await (runFuzzProofCommand
        (js-call (js-array (get globalThis.process :execPath) (resolve root "tools/fuzz/reader-program-host.mjs"))
          :concat (if (undefined? directory) (js-array) (js-array directory))) (js-object) 300000))))
      (js-call (js-array (js-array "schemaVersion" 1) (js-array "format" "eliscript-reader-program-fuzz")
        (js-array "version" 1) (js-array "verified" t) (js-array "seed" "0x454c4931") (js-array "inputs" 100000)
        (js-array "readerInputs" 50000) (js-array "programInputs" 50000) (js-array "maximumSourceCharacters" 4096)
        (js-array "maximumCorpusBytes" 67108864) (js-array "corpusReplayed" t)
        (js-array "corpusDigest" "4b49f0e21a825e41344fc29387b5298462d17cd1140b2f1f06076a18fe1f8cab"))
        :forEach (lambda (row) (js-call assert :strictEqual (get report (aref row 0)) (aref row 1))))
      (js-call assert :deepStrictEqual (get report :reader) (js-object
        :accepted 46889 :rejected 53111 :deterministicResults 100000 :structuredDiagnostics 53111
        :spanValidated 46889 :roundTrips 46889 :seedAgreements 100000
        :resultDigest "31961b6ffb8ce276a67db1b7cce2b723cf512b6c1518f8023985606535c69e7e"))
      (let* ((reader (get report :reader)) (compiler (get report :compiler)) (proof (get compiler :independentEmission)))
        (js-call assert :strictEqual (get compiler :accepted) 10171)
        (js-call assert :strictEqual (get compiler :rejected) 39829)
        (js-call assert :strictEqual (get compiler :structuredDiagnostics) 39829)
        (js-call assert :strictEqual (get proof :programs) 50000)
        (js-call assert :strictEqual (get proof :fullByteAgreements) 10171)
        (js-call assert :strictEqual (get proof :structuredDiagnosticAgreements) 39829)
        (js-call assert :strictEqual (get proof :resultDigest) (get compiler :resultDigest))
        (js-call assert :strictEqual (get proof :independentEmacsResultDigest) (get compiler :resultDigest))
        (js-call assert :strictEqual (get proof :historicalUnicodeCompatibilityDigest)
          "4fb6c781f78ad6237a8d7c3fae85841bf717fe6b2e938eaf24e5e6501a530130")
        (js-call assert :ok (> (get report :corpusBytes) 1000000))
        (js-call assert :ok (<= (get report :corpusBytes) (get report :maximumCorpusBytes)))
        (js-call assert :strictEqual (+ (get reader :accepted) (get reader :rejected)) 100000)
        (js-call assert :ok (> (get reader :accepted) 10000)) (js-call assert :ok (> (get reader :rejected) 10000))
        (js-call assert :strictEqual (get reader :spanValidated) (get reader :accepted))
        (js-call assert :strictEqual (get reader :roundTrips) (get reader :accepted))
        (js-call assert :strictEqual (get reader :structuredDiagnostics) (get reader :rejected))
        (js-call assert :strictEqual (+ (get compiler :accepted) (get compiler :rejected)) 50000)
        (js-call assert :ok (> (get compiler :accepted) 5000)) (js-call assert :ok (> (get compiler :rejected) 20000))
        (js-call assert :strictEqual (get compiler :structuredDiagnostics) (get compiler :rejected))
        (js-call (js-array (get report :corpusDigest) (get reader :resultDigest) (get compiler :resultDigest))
          :forEach (lambda (value) (js-call assert :match value (new globalThis.RegExp "^[0-9a-f]{64}$" "u")))))
      report))
  (export proveFuzzProgramEmission runReaderProgramFuzzAcceptance))
