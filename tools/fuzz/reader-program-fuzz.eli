(module tools.fuzz.reader-program-fuzz
  (import "node:child_process" spawn)
  (import "node:fs/promises" mkdtemp mkdir symlink rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../backends/build.mjs" root)
  (import "./reader-program-fuzz-legacy.mjs" :as legacy)

  ;; Keep the deterministic generator, complete verifier, independent Emacs
  ;; oracle and all original limits. Only the default compiler's package
  ;; dependency preparation moves here; supplied selected compilers stay real.
  (defconst parseArguments (get legacy :parseArguments))
  (defconst fuzzCases (get legacy :fuzzCases))
  (defconst children (new globalThis.Set))
  (defun fail (message)
    (let ((error (new globalThis.Error message))) (put error :eliscriptFuzzInvariant t) (throw error)))
  (defun stopReaderProgramFuzz (signal)
    (js-call children :forEach (lambda (child) (js-call child :kill "SIGTERM")))
    (js-call legacy :stopReaderProgramFuzz signal))
  (defun build-compiler (directory)
    (new globalThis.Promise (lambda (accept reject)
      (let* ((command (resolve root "bin/eliscript-bootstrap"))
             (child (spawn command (js-array)
               (js-object :cwd root :env (Object/assign (js-object) (get globalThis.process :env)
                 (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory)) :stdio (js-array "ignore" "pipe" "pipe"))))
             (stdout "") (stderr "") (expired false) (failure undefined)
             (timer (js-call globalThis.globalThis :setTimeout
                      (lambda () (setq expired t) (js-call child :kill "SIGTERM")) 120000)))
        (js-call children :add child)
        (js-call (get child :stdout) :on "data" (lambda (chunk)
          (setq stdout (js-call (+ stdout chunk) :slice 0 1048576))))
        (js-call (get child :stderr) :on "data" (lambda (chunk)
          (setq stderr (js-call (+ stderr chunk) :slice 0 1048576))))
        (js-call child :once "error" (lambda (error) (setq failure error)))
        (js-call child :once "close" (lambda (status signal)
          (js-call globalThis.globalThis :clearTimeout timer) (js-call children :delete child)
          (try
            (when expired (fail (str command " exceeded 120000 ms")))
            (unless (and (undefined? failure) (= status 0))
              (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
                (fail (cond ((/= err "") err) ((/= out "") out)
                            ((not (undefined? failure)) (get failure :message))
                            (t (str command " exited with " (if (nullish? status) signal status)))))))
            (funcall accept undefined)
            (catch error (funcall reject error)))))))))
  (defasync runReaderProgramFuzz (&rest arguments)
    (let* ((provided (if (= (js-length arguments) 0) undefined (aref arguments 0)))
           (options (if (undefined? provided) (js-object) provided))
           (input-total (get options :cases)) (input-seed (get options :seed))
           (total (if (nullish? input-total) 100000 input-total))
           (seed (if (nullish? input-seed) 1162627377 input-seed)))
      (unless (and (Number/isSafeInteger total) (> total 0) (<= total 1000000))
        (fail "cases must be between 1 and 1000000"))
      (unless (and (Number/isSafeInteger seed) (>= seed 0) (<= seed 4294967295))
        (fail "seed must be an unsigned 32-bit integer"))
      (let ((supplied (not (undefined? (get options :compilerDirectory)))))
        (when supplied
          (unless (and (= (value-type (get options :compilerDirectory)) "string")
                       (> (js-length (get options :compilerDirectory)) 0))
            (fail "compilerDirectory must select an actual compiler module directory")))
        (if supplied
          (let ((selected (resolve (get options :compilerDirectory))))
            (await (js-call legacy :runReaderProgramFuzz (js-object :cases total :seed seed :compilerDirectory selected))))
          (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-fuzz-compiler-"))))
                 (compiler (resolve directory "compiler")) (failed false))
            (try
              (await (build-compiler compiler))
              ;; The actual emitted project/emitter now import the public Math
              ;; runtime. A temporary compiler needs the same real package
              ;; resolution as an installed compiler; no compiler is substituted.
              (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
              (await (symlink root (resolve directory "node_modules/eliscript")))
              (await (js-call legacy :runReaderProgramFuzz (js-object :cases total :seed seed :compilerDirectory compiler)))
              (catch error (setq failed t) (throw error))
              (finally
                (try (await (rm directory (js-object :recursive t :force t)))
                  (catch error (unless failed (throw error)))))))))))
  (defasync main ()
    (js-call globalThis.process :once "SIGINT" (lambda () (stopReaderProgramFuzz "SIGINT")))
    (js-call globalThis.process :once "SIGTERM" (lambda () (stopReaderProgramFuzz "SIGTERM")))
    (try
      (let ((report (await (runReaderProgramFuzz (parseArguments (js-call (get globalThis.process :argv) :slice 2))))))
        (js-call (get globalThis.process :stdout) :write (+ (JSON/stringify report nil 2) "\n")))
      (catch error
        (js-call (get globalThis.process :stderr) :write (str (get error :stack error) "\n"))
        (put globalThis.process :exitCode 1))))
  (export parseArguments fuzzCases runReaderProgramFuzz stopReaderProgramFuzz)
  (when (= (resolve (or (aref (get globalThis.process :argv) 1) "")) (resolve root "tools/fuzz/reader-program-fuzz.mjs"))
    (main)))
