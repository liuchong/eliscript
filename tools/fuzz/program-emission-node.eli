(module tools.fuzz.program-emission-node
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile realpath)
  (import "node:url" fileURLToPath)
  (import "node:module" createRequire)
  (defasync main ()
    (let* ((path (aref (get globalThis.process :argv) 2))
           (observations (JSON/parse (await (readFile path "utf8")))) (index 0))
      (while (< index (js-length observations))
        (let ((item (aref observations index)) (at 0))
          (while (< at (js-length (get item :artifacts)))
            (let* ((artifact (await (realpath (fileURLToPath (aref (get item :artifacts) at)))))
                   (load (lambda () (funcall (createRequire artifact) artifact))))
              (if (= (get item :shape) "tdz")
                (js-call assert :throws load globalThis.ReferenceError)
                (let* ((module (funcall load)) (call (get module (get item :exportName))))
                  (js-call assert :strictEqual (value-type call) "function")
                  (cond
                    ((= (get item :shape) "scalar")
                      (js-call (js-array -3 0 -0 2 42 globalThis.NaN globalThis.Infinity) :forEach
                        (lambda (input) (js-call assert :ok (Object/is (funcall call input) (+ input (get item :value)))))))
                    ((= (get item :shape) "vector")
                      (js-call (js-array undefined nil false 0 -0 globalThis.NaN "" (js-array) (js-object)) :forEach
                        (lambda (input) (js-call assert :ok (Object/is (funcall call input) input)))))
                    ((= (get item :shape) "mutable-value")
                      (js-call assert :ok (Object/is (get module :value) -0))
                      (js-call assert :ok (Object/is (js-call module :current) -0))
                      (let ((object (js-object :marker 7)))
                        (js-call (js-array undefined nil false t -0 0 globalThis.NaN globalThis.Infinity "updated" object)
                          :forEach (lambda (input)
                            (js-call assert :ok (Object/is (funcall call input) input))
                            (js-call assert :ok (Object/is (get module :value) input))
                            (js-call assert :ok (Object/is (js-call module :current) input))))))
                    (t (js-call assert :fail "unrecognized original fuzz structure"))))))
            (setq at (1+ at))))
        (setq index (1+ index)))))
  (main))
