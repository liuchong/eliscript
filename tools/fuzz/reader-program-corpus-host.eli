(module tools.fuzz.reader-program-corpus-host
  (import "node:path" resolve)
  (import "./reader-program-acceptance.mjs" runReaderProgramFuzzAcceptance)
  (defasync main ()
    (let* ((root (get (get globalThis.process :env) :ELISCRIPT_ORIGINAL_SOURCE_ROOT))
           (product (aref (get globalThis.process :argv) 2)))
      (unless (and (= (value-type root) "string") (= (value-type product) "string"))
        (throw (new globalThis.TypeError "original fuzz host requires its actual selected compiler product and source root")))
      (await (runReaderProgramFuzzAcceptance (resolve product "bootstrap/compiler")))))
  (defconst completion (main))
  (js-call completion :catch (lambda (error)
    (console/error (get error :stack error)) (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
