(module tools.org.vite-plugin
  (import "node:child_process" spawn)
  (import "node:fs/promises" readdir)
  (import "node:path" dirname extname relative resolve sep)
  (import "node:url" fileURLToPath)

  (defconst orgModuleId "virtual:eliscript-org")
  (defconst resolved-org-module-id (str (js-call globalThis.String :fromCharCode 0) orgModuleId))
  (defconst plugin-directory (dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst default-publisher (resolve plugin-directory "../../bin/eliscript-org"))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun input-or (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object) (aref supplied 0)))

  (defun method (implementation)
    (funcall (js* "(implementation) => function (...args) { return implementation(this, ...args); }") implementation))

  (defun run-publisher (command arguments options)
    (new globalThis.Promise
      (lambda (resolve-promise reject-promise)
        (let ((child (spawn command arguments
                       (js-object :cwd (get options :cwd) :env (get options :env)
                         :stdio (js-array "ignore" "pipe" "pipe"))))
              (stdout "")
              (stderr ""))
          (js-call (get child :stdout) :setEncoding "utf8")
          (js-call (get child :stderr) :setEncoding "utf8")
          (js-call (get child :stdout) :on "data" (lambda (chunk) (setq stdout (str stdout chunk))))
          (js-call (get child :stderr) :on "data" (lambda (chunk) (setq stderr (str stderr chunk))))
          (js-call child :on "error" reject-promise)
          (js-call child :on "close"
            (lambda (code signal)
              (if (= code 0)
                (funcall resolve-promise stdout)
                (let* ((trimmed-error (js-call stderr :trim))
                       (trimmed-output (js-call stdout :trim))
                       (reason (if (host-truthy trimmed-error) trimmed-error
                                 (if (host-truthy trimmed-output) trimmed-output
                                   (str "publisher exited with "
                                        (if signal (str "signal " signal) (str "code " code)))))))
                  (funcall reject-promise (new globalThis.Error reason))))))))))

  (defasync visit-org-files (directory files)
    (let ((entries (js-call (await (readdir directory (js-object :withFileTypes t))) :sort
                     (lambda (left right) (js-call (get left :name) :localeCompare (get right :name)))))
          (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index))
               (path (resolve directory (get entry :name))))
          (if (js-call entry :isDirectory)
            (await (visit-org-files path files))
            (when (and (js-call entry :isFile) (= (extname (get entry :name)) ".org"))
              (js-call files :push path))))
        (setq index (1+ index)))
      files))

  (defasync list-org-files (directory)
    (await (visit-org-files directory (js-array))))

  (defun content-file? (file content-directory)
    (let ((path (relative content-directory (resolve file))))
      (and (not (= path ""))
           (not (= path ".."))
           (not (js-call path :startsWith (str ".." sep)))
           (= (extname path) ".org"))))

  (defasync compileOrgDirectory (content-directory &rest supplied)
    (let* ((options (input-or supplied))
           (directory (resolve content-directory))
           (publisher (resolve (get options :publisher default-publisher)))
           (arguments (js-array directory))
           (environment (js-call globalThis.Object :assign (js-object) (get globalThis.process :env)
                          (if (host-truthy (get options :emacs)) (js-object :EMACS (get options :emacs)) (js-object)))))
      (when (host-truthy (get options :includeDrafts))
        (js-call arguments :unshift "--include-drafts"))
      (await (run-publisher publisher arguments (js-object :cwd directory :env environment)))))

  (defun eliscriptOrg (&rest supplied)
    (let ((options (input-or supplied)))
      (unless (host-truthy (get options :contentDirectory))
        (throw (new globalThis.Error "eliscriptOrg requires contentDirectory")))
      (let ((content-directory (resolve (get options :contentDirectory))))
        (js-object :name "eliscript-org"
          :configureServer (lambda (server)
                             (js-call (get server :watcher) :add content-directory))
          :buildStart (method (async (self)
                                (js-call self :addWatchFile content-directory)
                                (let ((files (await (list-org-files content-directory))) (index 0))
                                  (while (< index (js-length files))
                                    (js-call self :addWatchFile (aref files index))
                                    (setq index (1+ index))))))
          :resolveId (lambda (id)
                       (if (= id orgModuleId) resolved-org-module-id nil))
          :load (method (async (self id)
                          (if (not (= id resolved-org-module-id))
                            nil
                            (let ((files (await (list-org-files content-directory))) (index 0))
                              (while (< index (js-length files))
                                (js-call self :addWatchFile (aref files index))
                                (setq index (1+ index)))
                              (await (compileOrgDirectory content-directory options))))))
          :handleHotUpdate (lambda (context)
                             (if (not (content-file? (get context :file) content-directory))
                               undefined
                               (let ((module (js-call (get (get context :server) :moduleGraph) :getModuleById
                                               resolved-org-module-id)))
                                 (if (not module)
                                   (js-array)
                                   (progn
                                     (js-call (get (get context :server) :moduleGraph) :invalidateModule module)
                                     (js-array module))))))))))

  (export orgModuleId compileOrgDirectory eliscriptOrg)
  (export-default eliscriptOrg))
