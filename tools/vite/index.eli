(module tools.vite.index
  (import "node:child_process" spawn)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" basename dirname join resolve)
  (import "node:url" fileURLToPath)

  (defconst plugin-directory (dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst default-compiler (resolve plugin-directory "../../bin/eliscript"))
  (defconst query-pattern "[?#]")
  (defconst eli-pattern "\\.eli$")
  (defconst mapping-pattern "\\n?//# sourceMappingURL=[^\\n]*\\n?$")

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun defined-or (object key default)
    (let ((value (get object key)))
      (if (undefined? value) default value)))

  (defun input-or (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object) (aref supplied 0)))

  (defun method (implementation)
    (funcall (js* "(implementation) => function (...args) { return implementation(this, ...args); }") implementation))

  (defun clean-module-id (id)
    (let ((query-index (js-call id :search (new globalThis.RegExp query-pattern))))
      (if (= query-index -1) id (js-call id :slice 0 query-index))))

  (defun matches-include (id include)
    (if (= (host-type include) "function")
      (funcall include id)
      (progn
        (put include :lastIndex 0)
        (js-call include :test id))))

  (defun run-compiler (command arguments options)
    (new globalThis.Promise
      (lambda (resolve-promise reject-promise)
        (let ((child (spawn command arguments
                       (js-object :cwd (get options :cwd) :env (get options :env)
                         :stdio (js-array "ignore" "pipe" "pipe"))))
              (stdout "")
              (stderr ""))
          (js-call (get child :stdout) :setEncoding "utf8")
          (js-call (get child :stderr) :setEncoding "utf8")
          (js-call (get child :stdout) :on "data" (lambda (chunk) (setq stdout (str stdout chunk))))
          (js-call (get child :stderr) :on "data" (lambda (chunk) (setq stderr (str stderr chunk))))
          (js-call child :on "error" reject-promise)
          (js-call child :on "close"
            (lambda (code signal)
              (if (= code 0)
                (funcall resolve-promise (js-object :stdout stdout :stderr stderr))
                (let* ((trimmed-error (js-call stderr :trim))
                       (trimmed-output (js-call stdout :trim))
                       (reason (if (host-truthy trimmed-error) trimmed-error
                                 (if (host-truthy trimmed-output) trimmed-output
                                   (str "compiler exited with "
                                        (if signal (str "signal " signal) (str "code " code)))))))
                  (funcall reject-promise (new globalThis.Error reason))))))))))

  (defasync compileEliscript (input-file &rest supplied)
    (let* ((options (input-or supplied))
           (source-file (resolve input-file))
           (compiler (resolve (get options :compiler default-compiler)))
           (temporary-directory (await (mkdtemp (join (tmpdir) "eliscript-vite-"))))
           (output-file (join temporary-directory (str (basename source-file) ".mjs")))
           (environment (js-call globalThis.Object :assign (js-object) (get globalThis.process :env)
                          (if (host-truthy (get options :emacs)) (js-object :EMACS (get options :emacs)) (js-object)))))
      (try
        (await (run-compiler compiler (js-array "--source-map" "--output" output-file source-file)
                 (js-object :cwd (dirname source-file) :env environment)))
        (let* ((loaded (await (Promise/all (js-array
                              (readFile source-file "utf8")
                              (readFile output-file "utf8")
                              (readFile (str output-file ".map") "utf8")))))
               (map (JSON/parse (aref loaded 2))))
          (put map :file (basename source-file))
          (put map :sources (js-array source-file))
          (put map :sourcesContent (js-array (aref loaded 0)))
          (js-object :code (js-call (aref loaded 1) :replace (new globalThis.RegExp mapping-pattern) "\n")
            :map map))
        (finally (await (rm temporary-directory (js-object :recursive t :force t)))))))

  (defun eliscript (&rest supplied)
    (let* ((options (input-or supplied))
           (include (get options :include (new globalThis.RegExp eli-pattern))))
      (js-object :name "eliscript" :enforce "pre"
        :transform (method (async (self source id)
                             (let ((source-file (clean-module-id id)))
                               (if (not (matches-include source-file include))
                                 nil
                                 (progn
                                   (js-call self :addWatchFile source-file)
                                   (await (compileEliscript source-file options))))))))))

  (export compileEliscript eliscript)
  (export-default eliscript))
