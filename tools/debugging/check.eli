(module tools.debugging.check
  (import "node:fs/promises" readFile)
  (import "node:path" :as path)
  (import "node:url" fileURLToPath)

  (defconst module-file (fileURLToPath (js* "import.meta.url")))
  (defconst DEFAULT_ROOT (js-call path :resolve (js-call path :dirname module-file) "../.."))
  (defconst CONTRACT_FILE "contracts/source-debugging-corpus.json")
  (defconst expected-cases
    (js-array "compiler" "runtime" "browser-event" "async-rejection" "worker"))

  (defun source-debugging-error-message (errors)
    (str "source debugging corpus validation failed:\n- " (js-call errors :join "\n- ")))

  (defun source-debugging-error-fields (self errors)
    (put self :name "SourceDebuggingCorpusError")
    (put self :errors errors)
    self)

  (defconst SourceDebuggingCorpusError
    (funcall
      (js* "(message, fields) => class SourceDebuggingCorpusError extends Error { constructor(errors) { const self = super(message(errors)); return fields(self, errors); } }")
      source-debugging-error-message
      source-debugging-error-fields))

  (defun host-type (value)
    (funcall (js* "(value) => typeof value") value))

  (defun host-truthy (value)
    (funcall (js* "(value) => !!value") value))

  (defun plain-object? (value)
    (and (not (nil? value))
         (= (host-type value) "object")
         (not (Array/isArray value))))

  (defun host-get (value key)
    (if (nullish? value) undefined (get value key)))

  (defun call-options (supplied)
    (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0)))
      (js-object)
      (aref supplied 0)))

  (defun json-equal (left right)
    (= (JSON/stringify left) (JSON/stringify right)))

  (defun safe-path (value)
    (and (= (host-type value) "string")
         (> (js-length value) 0)
         (not (js-call path :isAbsolute value))
         (not (js-call (js-call value :split "/") :includes ".."))
         (= (js-call (get path :posix) :normalize value) value)))

  (defun valid-point (value offset-required)
    (and (plain-object? value)
         (Number/isInteger (get value :line))
         (> (get value :line) 0)
         (Number/isInteger (get value :column))
         (> (get value :column) 0)
         (or (not offset-required)
             (and (Number/isInteger (get value :offset))
                  (>= (get value :offset) 0)))))

  (defasync tracked-files (root)
    (let* ((child (js-call globalThis.Bun :spawn (js-array "git" "ls-files" "-z")
                    (js-object :cwd root :stdout "pipe" :stderr "pipe")))
           (parts (await (js-call globalThis.Promise :all
                           (js-array (get child :exited)
                             (js-call (new globalThis.Response (get child :stdout)) :text)
                             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exit-code (aref parts 0))
           (stdout (aref parts 1))
           (stderr (aref parts 2)))
      (unless (= exit-code 0)
        (let ((text (js-call stderr :trim)))
          (throw (new globalThis.Error (if (> (js-length text) 0) text "git ls-files failed")))))
      (new globalThis.Set (js-call (js-call stdout :split "\u0000") :filter host-truthy))))

  (defun case-ids (cases)
    (let ((ids (js-array)) (index 0))
      (while (< index (js-length cases))
        (js-call ids :push (host-get (aref cases index) "id"))
        (setq index (1+ index)))
      ids))

  (defun tracked-file? (tracked file)
    (let ((capsule (if (js-call file :endsWith ".mjs")
                     (str (js-call file :slice 0 -4) ".eli")
                     nil)))
      (or (js-call tracked :has file)
          (and capsule (js-call tracked :has capsule)))))

  (defasync validateSourceDebuggingCorpus (contract &rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (errors (js-array)))
      (unless (and (plain-object? contract)
                   (= (get contract :schemaVersion) 1)
                   (= (get contract :format) "eliscript-source-debugging-corpus")
                   (= (get contract :version) 1))
        (throw (new SourceDebuggingCorpusError
                 (js-array "contract must use eliscript-source-debugging-corpus version 1"))))
      (let ((cases (if (Array/isArray (get contract :cases)) (get contract :cases) (js-array)))
            (tracked (new globalThis.Set)))
        (unless (json-equal (case-ids cases) expected-cases)
          (js-call errors :push "cases must be exactly compiler runtime browser-event async-rejection worker"))
        (try
          (setq tracked (await (tracked-files root)))
          (catch error
            (js-call errors :push (get error :message))))
        (let ((index 0))
          (while (< index (js-length cases))
            (let* ((entry (aref cases index))
                   (label (let ((id (host-get entry "id")))
                            (if (nullish? id) (str "case " index) id))))
              (if (or (not (plain-object? entry))
                      (not (safe-path (get entry :source)))
                      (not (js-call (get entry :source) :endsWith ".eli"))
                      (not (plain-object? (get entry :location)))
                      (not (plain-object? (get entry :evidence)))
                      (not (safe-path (get (get entry :evidence) :file)))
                      (not (= (host-type (get (get entry :evidence) :contains)) "string"))
                      (= (js-length (get (get entry :evidence) :contains)) 0))
                (js-call errors :push (str label " must declare source location and evidence"))
                (progn
                  (if (= (get entry :id) "compiler")
                    (unless (and (valid-point (get (get entry :location) :start) t)
                                 (valid-point (get (get entry :location) :end) t))
                      (js-call errors :push "compiler must declare a complete start and end source span"))
                    (unless (valid-point (get entry :location) nil)
                      (js-call errors :push (str label " must declare an exact source point"))))
                  (let ((files (js-array (get entry :source) (get (get entry :evidence) :file)))
                        (file-index 0))
                    (while (< file-index (js-length files))
                      (let ((file (aref files file-index)))
                        (unless (tracked-file? tracked file)
                          (js-call errors :push (str label " file is not tracked: " file))))
                      (setq file-index (1+ file-index))))
                  (try
                    (let ((evidence (await (readFile (js-call path :join root (get (get entry :evidence) :file)) "utf8"))))
                      (unless (js-call evidence :includes (get (get entry :evidence) :contains))
                        (js-call errors :push (str label " evidence locator is absent: " (get (get entry :evidence) :contains)))))
                    (catch error
                      (js-call errors :push (str label " evidence could not be read: " (get error :message))))))))
            (setq index (1+ index))))
        (when (> (js-length errors) 0)
          (throw (new SourceDebuggingCorpusError errors)))
        contract)))

  (defasync checkSourceDebuggingCorpus (&rest supplied)
    (let* ((options (call-options supplied))
           (root (js-call path :resolve (get options :root DEFAULT_ROOT)))
           (contract (if (nullish? (get options :contract))
                       (JSON/parse (await (readFile (js-call path :join root CONTRACT_FILE) "utf8")))
                       (get options :contract))))
      (await (validateSourceDebuggingCorpus contract (js-object :root root)))))

  (when (js* "import.meta.main")
    (js-call
      (js-call (checkSourceDebuggingCorpus) :then
        (lambda (contract)
          (js-call (get globalThis.process :stdout) :write
            (str "Source debugging corpus verified (" (js-length (get contract :cases)) " workflows)\n"))))
      :catch
      (lambda (error)
        (js-call (get globalThis.process :stderr) :write (str (get error :message) "\n"))
        (put globalThis.process :exitCode 1))))

  (export DEFAULT_ROOT CONTRACT_FILE SourceDebuggingCorpusError
    validateSourceDebuggingCorpus checkSourceDebuggingCorpus))
