;; The documentation site's own script.
;;
;; The site is published from `docs/`, and this file replaces the JavaScript
;; that used to sit beside it. The behaviours are the ones the pages already
;; declare through data attributes: the landing page's example switcher, the
;; language page's tabs, the API index's filter, and the footer's year.
;;
;; It compiles to a classic script, because the site loads it with `defer` and
;; the pages keep working when a reader opens them from disk without a build.
;; Nothing here imports the portable collection runtime: the values involved
;; are host objects on purpose, and pulling that runtime in would multiply the
;; size of a script that only moves data between the DOM and a table.

(module docs.site
  (import "eliscript/platform/browser"
          browserCapabilities browserDocument)

  ;; The document capability is a grant, not an ambient permission: the script
  ;; names what it reaches through the host before it reaches it.
  (defconst capabilities
    (browserCapabilities globalThis.globalThis (js-array "document")))
  (defconst page (browserDocument capabilities))

  ;; ------------------------------------------------------------- host helpers

  ;; A method call describes a receiver, a property read describes a value.
  ;; Mixing the two is how a property becomes `undefined` in the generated
  ;; script, so the helpers below name which one they are.
  (defun field (object name) (get object name))

  (defun set-field (object name value)
    (Reflect/set object name value))

  (defun text-of (element) (field element "textContent"))

  (defun set-text (element value) (set-field element "textContent" (str value)))

  (defun array-from (values)
    (Array/from values))

  (defun nodes (selector) (array-from (js-call page :querySelectorAll selector)))

  (defun node (selector) (js-call page :querySelector selector))

  (defun present? (value) (not (nil? value)))

  (defun same? (left right)
    (Object/is left right))

  (defun each (values handler)
    (let ((index 0)
          (total (js-length values)))
      (while (< index total)
        (funcall handler (js-nth index values))
        (setq index (1+ index)))))

  (defun watch (element event handler)
    (js-call element :addEventListener event handler))

  (defun set-selected (element selected)
    (js-call element :setAttribute "aria-selected"
             (if selected "true" "false")))

  (defun set-hidden (element hidden)
    (set-field element "hidden" (if hidden t false)))

  ;; The examples the landing page's buttons name.
  (defun example-table ()
    (js-object
      "recur" (js-object
                "source" "(defun sum-to (n total)\n  (if (= n 0)\n      total\n    (recur (1- n) (+ total n))))"
                "output" "tail position verified\narguments evaluated once, left to right\nfunction frame reused as a loop\nconstant JavaScript stack")
      "data" (js-object
               "source" "(import \"eliscript/runtime/core/collection\" assoc get)\n\n(defconst before {:name \"Eliscript\" :version \"0.1.3\"})\n(defconst after (assoc before :status :stable))\n\n(print (get before :status :unchanged))\n(print (equal before {:name \"Eliscript\" :version \"0.1.3\"}))"
               "output" "before remains unchanged (:unchanged)\nafter shares the unchanged 32-way HAMT path\nkeys use Eliscript structural value equality\nreference-identity (===) short-circuits shared roots")
      "interop" (js-object
                  "source" "(js-call (js-array 1 2 3)\n  :map\n  (lambda (value)\n    (* value 2)))"
                  "output" "native container requested explicitly\nreceiver-preserving method call\nlossless js-false / js-null / js-undefined sentinels\nstandard ESM host behavior on Node 24+ and Bun 1.4+")
      "compat" (js-object
                 "source" "(require 'eliscript-runtime)\n\n(defun-case scale\n  ((x) (scale x 2))\n  ((x factor)\n   (let-bind (((:keys a b :or ((b 10))) x))\n     (* (+ a b) factor))))"
                 "output" "100% Emacs Lisp compatible core (.el + .eli)\nmulti-arity dispatch + pcase destructuring\nnil-only falsiness in Emacs compat mode\nsame source across GNU Emacs and standard ESM")
      "async" (js-object
                "source" "(defun-async load-all (items)\n  (with-async-scope\n    (let ((ch (async-channel 4)))\n      (async-put! ch (await (fetch-item (first items))))\n      (await (async-take! ch)))))"
                "output" "lexical task scope owns child tasks\nsibling tasks cancel automatically on failure\nbounded async-channel backpressure\ndynamic bindings preserved across await")))

  ;; ---------------------------------------------------------- example switcher

  (defun bind-examples ()
    (let ((buttons (nodes "[data-example]"))
          (source (node "[data-source-code]"))
          (output (node "[data-output-code]"))
          (table (example-table)))
      (when (and (present? source) (present? output))
        (each buttons
              (lambda (button)
                (watch button "click"
                       (lambda (event)
                         (let ((example (field table (js-call button :getAttribute "data-example"))))
                           (when (present? example)
                             (each buttons
                                   (lambda (candidate)
                                     (set-selected candidate (same? candidate button))))
                             (set-text source (field example "source"))
                             (set-text output (field example "output")))))))))))

  ;; ---------------------------------------------------------------- tabs

  (defun bind-language-tabs ()
    (let ((tabs (nodes "[data-language-tab]"))
          (panels (nodes "[data-language-panel]")))
      (each tabs
            (lambda (button)
              (watch button "click"
                     (lambda (event)
                       (let ((target (js-call button :getAttribute "data-language-tab")))
                         (each tabs
                               (lambda (candidate)
                                 (set-selected candidate (same? candidate button))))
                         (each panels
                               (lambda (panel)
                                 (set-hidden panel
                                             (not (same? (js-call panel :getAttribute "data-language-panel")
                                                         target))))))))))))

  ;; ------------------------------------------------------------ api index

  (defun lowered (value) (js-call (str value) :toLowerCase))

  (defun apply-filter (modules query)
    (let ((visible 0))
      (each modules
            (lambda (module)
              (let ((matches (js-call
                               (lowered (get (field module "dataset") "apiSearchable"))
                               :includes query)))
                (set-hidden module (not matches))
                (when matches (setq visible (1+ visible))))))
      visible))

  (defun visible-module? (section)
    (present? (js-call section :querySelector "[data-api-module]:not([hidden])")))

  (defun bind-api-search ()
    (let ((input (node "[data-api-search]")))
      (when (present? input)
        (let ((modules (nodes "[data-api-module]"))
              (sections (nodes "[data-api-section]"))
              (count (node "[data-api-count]"))
              (empty (node "[data-api-empty]")))
          (watch input "input"
                 (lambda (event)
                   (let ((visible (apply-filter modules (lowered (field input "value")))))
                     (each sections
                           (lambda (section)
                             (set-hidden section (not (visible-module? section)))))
                     (when (present? count)
                       (set-text count (str visible " "
                                            (if (= visible 1) "module" "modules"))))
                     (when (present? empty)
                       (set-hidden empty (not (= visible 0)))))))))))

  ;; ---------------------------------------------------------- copy command bar

  (defun bind-copy-commands ()
    (each (nodes "[data-copy-command]")
          (lambda (button)
            (watch button "click"
                   (lambda (event)
                     (let ((command (js-call button :getAttribute "data-copy-command")))
                       (when (present? command)
                         (let ((clipboard (field globalThis.navigator "clipboard")))
                           (when (and (present? clipboard)
                                      (present? (field clipboard "writeText")))
                             (try
                               (let ((pending (js-call clipboard :writeText command)))
                                 (when (and (present? pending)
                                            (present? (field pending "catch")))
                                   (js-call pending :catch (lambda (err) nil))))
                               (catch err nil))))
                         (set-text button "Copied")
                         (globalThis.setTimeout
                           (lambda () (set-text button "Copy"))
                           1400))))))))

  ;; ---------------------------------------------------------- header scroll FX

  (defun clamp-unit (value)
    (if (< value 0)
        0
      (if (> value 1) 1 value)))

  (defun smooth-range (edge0 edge1 x)
    (let ((u (clamp-unit (/ (- x edge0) (- edge1 edge0)))))
      (* u u (- 3 (* 2 u)))))

  (defun lerp (a b t-val)
    (+ a (* (- b a) t-val)))

  (defun mix-channel (a b t-val)
    (Math/round (lerp a b t-val)))

  (defun bind-header-scroll ()
    (let ((header (node ".site-header"))
          (win globalThis.globalThis))
      (when (present? header)
        (let* ((header-style (field header "style"))
               (ticking false)
               (apply-scroll
                 (lambda ()
                   (let* ((y-raw (field win "scrollY"))
                          (y (if (= (value-type y-raw) "number") y-raw 0))
                          (vh-raw (field win "innerHeight"))
                          (span (if (and (= (value-type vh-raw) "number") (> vh-raw 560)) vh-raw 560))
                          (p (clamp-unit (/ y span)))
                          (halo (if (<= p 0.48)
                                    (lerp 0.36 0.94 (smooth-range 0 0.48 p))
                                  (lerp 0.94 0 (smooth-range 0.48 0.96 p))))
                          (peak (* 4 p (- 1 p)))
                          (bg-r 10)
                          (bg-g 11)
                          (bg-b 9)
                          (bg-a 1)
                          (blur 0)
                          (el-r 255)
                          (el-g 254)
                          (el-b 250))
                     (if (<= p 0.50)
                         (let ((u (smooth-range 0 0.50 p)))
                           (setq bg-r (mix-channel 10 46 u))
                           (setq bg-g (mix-channel 11 48 u))
                           (setq bg-b (mix-channel 9 42 u))
                           (setq bg-a (lerp 1.00 0.72 u))
                           (setq blur (lerp 0 16 u))
                           (setq el-r (mix-channel 255 239 u))
                           (setq el-g (mix-channel 254 96 u))
                           (setq el-b (mix-channel 250 73 u)))
                       (let ((v (smooth-range 0.50 1.00 p)))
                         (setq bg-r (mix-channel 46 246 v))
                         (setq bg-g (mix-channel 48 244 v))
                         (setq bg-b (mix-channel 42 236 v))
                         (setq bg-a (lerp 0.72 0.90 v))
                         (setq blur (lerp 16 12 v))
                         (setq el-r (mix-channel 239 210 v))
                         (setq el-g (mix-channel 96 72 v))
                         (setq el-b (mix-channel 73 50 v))))
                     (js-call header-style :setProperty "--header-scroll"
                              (js-call p :toFixed 3))
                     (js-call header-style :setProperty "--header-bg"
                              (str "rgba(" bg-r ", " bg-g ", " bg-b ", " (js-call bg-a :toFixed 3) ")"))
                     (js-call header-style :setProperty "--header-halo"
                              (js-call halo :toFixed 3))
                     (js-call header-style :setProperty "--header-halo-peak"
                              (js-call peak :toFixed 3))
                     (js-call header-style :setProperty "--header-blur"
                              (str (js-call blur :toFixed 1) "px"))
                     (js-call header-style :setProperty "--header-elisp-color"
                              (str "rgb(" el-r ", " el-g ", " el-b ")"))
                     (js-call header :setAttribute "data-scrolled"
                              (if (> p 0.03) "true" "false"))
                     (js-call header :setAttribute "data-header-tone"
                              (if (>= p 0.66) "light" "dark")))))
               (schedule-scroll
                 (lambda (event)
                   (let ((raf (field win "requestAnimationFrame")))
                     (if (present? raf)
                         (unless ticking
                           (setq ticking t)
                           (funcall raf
                                    (lambda ()
                                      (setq ticking false)
                                      (funcall apply-scroll))))
                       (funcall apply-scroll))))))
          (funcall apply-scroll)
          (js-call win :addEventListener "scroll" schedule-scroll (js-object :passive t))
          (js-call win :addEventListener "resize" schedule-scroll (js-object :passive t))))))

  ;; ---------------------------------------------------------------- footer

  (defconst site-semver "0.1.3")
  (defconst site-version (str "v" site-semver))

  (defun bind-version ()
    (each (nodes "[data-version]")
          (lambda (element) (set-text element site-version)))
    (each (nodes "[data-version-github]")
          (lambda (element)
            (js-call element :setAttribute "href"
                     (str "https://github.com/liuchong/eliscript/releases/tag/" site-version))))
    (each (nodes "[data-version-npm]")
          (lambda (element)
            (js-call element :setAttribute "href"
                     (str "https://www.npmjs.com/package/eliscript/v/" site-semver)))))

  (defun bind-year ()
    (let ((year (js-call (new globalThis.Date) :getFullYear)))
      (each (nodes "[data-year]")
            (lambda (element) (set-text element year)))))

  ;; ------------------------------------------------------------- bootstrap

  (defun start ()
    (bind-examples)
    (bind-language-tabs)
    (bind-api-search)
    (bind-copy-commands)
    (bind-header-scroll)
    (bind-version)
    (bind-year))

  (if (= (get page "readyState") "loading")
      (js-call page :addEventListener
               "DOMContentLoaded" (lambda (event) (start)))
    (start)))
