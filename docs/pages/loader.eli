;; The documentation site's loader.
;;
;; The site's behaviours are an Eliscript program, and this page compiles them
;; in the browser at run time instead of shipping them compiled. The loader is
;; itself compiled ahead of time and kept deliberately small: it fetches the
;; source, hands it to the module worker the playground already uses, and runs
;; the module that comes back.
;;
;; Running the compiled module from a blob URL is why the request names a
;; runtime base: the worker rewrites `eliscript/...` specifiers to served URLs,
;; so the output has no directory of its own to resolve them from. Nothing here
;; touches the document; the compiled program does that, and it reaches the DOM
;; through the platform package's document grant.

(module docs.loader
  (defconst load (js* "(url) => import(url)"))

  (defun field (object name) (get object name))

  ;; This script is classic, so it has no `import.meta`: it is loaded with
  ;; `defer`, and the script element is available while it runs. Its own URL is
  ;; the base for everything else it asks the server for.
  (defconst current-script
    (let ((doc (field globalThis.globalThis "document")))
      (if doc (field doc "currentScript") nil)))

  (defconst script-url
    (funcall globalThis.String
      (or (and current-script (field current-script "src"))
          (field (field globalThis.globalThis "location") "href"))))

  (defun relative-to (url path)
    (field (new globalThis.URL path url) "href"))

  (defconst package-base (relative-to script-url "../../"))
  (defconst worker-url (relative-to script-url "../../dist/browser/worker.mjs"))

  ;; The page names the source it wants compiled, relative to itself; the file
  ;; beside the loader is the fallback for a page that does not.
  (defun declared-source (script)
    (let ((dataset (and script (field script "dataset"))))
      (or (and dataset (field dataset "eliscript")) "")))

  (defun has-inline-tags ()
    (let ((doc (field globalThis.globalThis "document")))
      (funcall globalThis.Boolean
        (and doc (js-call doc :querySelector "script[type=\"text/eliscript\"]")))))

  (defconst current-declared (declared-source current-script))

  (defconst base-uri
    (field (field globalThis.globalThis "document") "baseURI"))

  (defconst source-url
    (if (= current-declared "")
        (if (has-inline-tags) ""
          (relative-to base-uri "site.eli"))
      (relative-to base-uri current-declared)))

  (defun start-worker (url)
    (new globalThis.Worker url (js-object "type" "module")))

  (defun blob-url-of (code)
    (js-call globalThis.URL :createObjectURL
      (new globalThis.Blob (js-array code)
           (js-object "type" "text/javascript"))))

  (defun release-blob-url (url)
    (js-call globalThis.URL :revokeObjectURL url))

  (defasync fetch-text (url)
    (let ((response (await (funcall globalThis.fetch url))))
      (unless (field response "ok")
        (throw (new globalThis.Error (funcall globalThis.String (field response "status")))))
      (await (js-call response :text))))

  (defun compile-once (worker request)
    (new globalThis.Promise
      (lambda (resolve reject)
        (let* ((id (str "docs-site-"
                        (funcall globalThis.String
                          (js-call globalThis.Math :floor (* (js-call globalThis.Math :random) 1000000000)))))
               (on-message nil))
          (setq on-message
            (lambda (event)
              (let ((data (field event "data")))
                (when (and data (= (field data "id") id))
                  (js-call worker :removeEventListener "message" on-message)
                  (if (field data "ok")
                      (funcall resolve data)
                    (funcall reject
                      (new globalThis.Error
                        (or (field data "message") "compilation failed"))))))))
          (js-call worker :addEventListener "message" on-message)
          (js-call worker :postMessage (js-object "id" id "request" request))))))

  (defun inline-scripts ()
    (let ((doc (field globalThis.globalThis "document")))
      (js-call globalThis.Array :from
        (or (and doc (js-call doc :querySelectorAll "script[type=\"text/eliscript\"]"))
            (js-array)))))

  ;; The failure is reported where a developer looks for it, and nowhere a
  ;; reader would mistake for page content.
  (defun report (message)
    (js-call (field globalThis.globalThis "console") :error message))

  (defasync run-compiled-source (worker source filename output-name)
    (let* ((reply (await (compile-once
                           worker
                           (js-object
                             "mode" "single"
                             "source" source
                             "filename" filename
                             "runtimeBase" package-base))))
           (module (field (field reply "modules") output-name))
           (url (blob-url-of (field module "javascript"))))
      (try
        (await (funcall load url))
        (catch error
          (report (str "site script failed at run time: "
                       (field error "message"))))
        (finally (release-blob-url url)))))

  ;; A page whose script cannot be compiled stays readable: the failure is
  ;; reported where the playground reports its own, and nothing else changes.
  (defasync start ()
    (try
      (let ((worker (start-worker worker-url)))
        (when (not (= source-url ""))
          (let ((source (await (fetch-text source-url))))
            (await (run-compiled-source worker source "site.eli" "site.mjs"))))
        (let ((scripts (inline-scripts))
              (index 0))
          (while (< index (js-length scripts))
            (let* ((tag (aref scripts index))
                   (src (field tag "src"))
                   (source (if (and (= (value-type src) "string") (> (js-length src) 0))
                               (await (fetch-text src))
                             (field tag "textContent"))))
              (await (run-compiled-source worker source "site.eli" "site.mjs")))
            (setq index (1+ index)))))
      (catch error
        (report (str "site script did not compile: " (field error "message"))))))

  (defun boot ()
    (let ((doc (field globalThis.globalThis "document")))
      (if (= (field doc "readyState") "loading")
          (js-call doc :addEventListener "DOMContentLoaded" (lambda (event) (start)))
        (start))))

  (boot))
