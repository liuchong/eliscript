(module browser.host
  (import "../dist/browser/compiler.js"
    compile_ir_string emit_ir_string_with_source_map project_plan)

  (defconst host-error-class
    (js* "(init, name, arity, messageOf) => { const C = ({ [name]: class extends Error { constructor(...args) { super(messageOf(...args)); init(this, ...args); } } })[name]; Object.defineProperty(C, 'length', { value: arity, configurable: true }); return C; }"))
  (defconst host-import (js* "(url) => import(url)"))
  (defun host-typeof (value) (js* "typeof value"))

  (defconst SOURCE_EXTENSION ".eli")
  (defconst OUTPUT_EXTENSION ".mjs")
  (defconst package-subpath-pattern
    (new globalThis.RegExp "^eliscript\\/(?:runtime|platform|dist\\/stdlib|stdlib)\\/" "u"))
  (defconst extension-pattern
    (new globalThis.RegExp "\\.[a-z0-9]+$" "iu"))
  (defconst from-specifier-pattern
    (new globalThis.RegExp "(\\bfrom\\s+)(\"[^\"]+\")" "gu"))
  (defconst import-specifier-pattern
    (new globalThis.RegExp "(\\bimport\\s+)(\"[^\"]+\")" "gu"))

  (defun splitPath (path)
    (js-call (js-call path :split "/") :filter
      (lambda (part) (and (not (= part "")) (not (= part "."))))))

  (defun normalizePath (path)
    (let ((parts (js-array))
          (items (splitPath path))
          (index 0))
      (while (< index (js-length items))
        (let ((part (aref items index)))
          (if (= part "..")
            (progn
              (when (= (js-length parts) 0)
                (throw (new globalThis.Error (str "path escapes the project root: " path))))
              (js-call parts :pop))
            (js-call parts :push part)))
        (setq index (1+ index)))
      (js-call parts :join "/")))

  (defun dirname (path)
    (let ((parts (splitPath path)))
      (js-call parts :pop)
      (js-call parts :join "/")))

  (defun resolvePath (importer specifier)
    (let ((base (dirname importer)))
      (normalizePath (if (= base "") specifier (str base "/" specifier)))))

  (defun outputPathFor (source)
    (unless (js-call source :endsWith SOURCE_EXTENSION)
      (throw (new globalThis.Error (str "source module must end with " SOURCE_EXTENSION ": " source))))
    (str (js-call source :slice 0 (- (js-length SOURCE_EXTENSION))) OUTPUT_EXTENSION))

  (defun relativePath (from to)
    (let ((fromParts (splitPath (dirname from)))
          (toParts (splitPath to))
          (common 0))
      (while (and (< common (js-length fromParts))
                  (< common (js-length toParts))
                  (= (aref fromParts common) (aref toParts common)))
        (setq common (1+ common)))
      (let* ((upParts (js-call (js-call fromParts :slice common) :map (lambda (item) "..")))
             (downParts (js-call toParts :slice common))
             (parts (js-call upParts :concat downParts))
             (joined (js-call parts :join "/")))
        (if (js-call joined :startsWith ".")
          joined
          (str "./" joined)))))

  (defun dependencyOrder (modules)
    (let ((byId (new globalThis.Map
                  (js-call modules :map (lambda (module) (js-array (get module :id) module)))))
          (order (js-array))
          (state (new globalThis.Map))
          (visit nil))
      (setq visit
        (lambda (id)
          (let ((seen (js-call state :get id)))
            (cond
              ((= seen "done") nil)
              ((= seen "visiting")
                (throw (new globalThis.Error (str "import cycle through " id))))
              (t
                (js-call state :set id "visiting")
                (let* ((module (js-call byId :get id))
                       (dependencies (if (or (nullish? module) (nullish? (get module :dependencies)))
                                       (js-array)
                                       (get module :dependencies)))
                       (index 0))
                  (while (< index (js-length dependencies))
                    (funcall visit (aref dependencies index))
                    (setq index (1+ index))))
                (js-call state :set id "done")
                (js-call order :push id))))))
      (let ((index 0))
        (while (< index (js-length modules))
          (funcall visit (get (aref modules index) :id))
          (setq index (1+ index))))
      order))

  (defun walkProgram (program visit)
    (let ((pending (Array/from (get program :body))))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :pop))
               (children (get node :children)))
          (funcall visit node)
          (unless (nullish? children)
            (let ((index (1- (js-length children))))
              (while (>= index 0)
                (js-call pending :push (aref children index))
                (setq index (1- index)))))))))

  (defun isPlainLiteralNode (node)
    (and (not (nil? node))
         (= (host-typeof node) "object")
         (= (get node :kind) "literal")
         (let ((properties (get node :properties)))
           (or (nullish? properties) (undefined? (get properties :literalKind))))))

  (defun isConstantLiteralNode (node)
    (if (or (nil? node)
            (not (= (host-typeof node) "object"))
            (not (= (get node :kind) "literal")))
      false
      (let* ((properties (get node :properties))
             (literalKind (if (nullish? properties) undefined (get properties :literalKind))))
        (or (undefined? literalKind)
            (= literalKind "undefined")
            (= literalKind "keyword")))))

  (defun cloneLiteralNode (literal &optional span)
    (let ((cloned (js-object :kind "literal"
                    :span (if (nullish? span) (get literal :span) span)
                    :value (get literal :value)
                    :children (js-array))))
      (when (get literal :properties)
        (put cloned :properties (Object/assign (js-object) (get literal :properties))))
      cloned))

  (defun literalRuntimeValue (node)
    (let* ((properties (get node :properties))
           (literalKind (if (nullish? properties) undefined (get properties :literalKind))))
      (cond
        ((= literalKind "undefined") undefined)
        ((= literalKind "keyword") (str ":" (get node :value)))
        (t (get node :value)))))

  (defun literalTruthiness (node)
    (if (not (isConstantLiteralNode node))
      nil
      (let* ((properties (get node :properties))
             (literalKind (if (nullish? properties) undefined (get properties :literalKind))))
        (cond
          ((= literalKind "undefined") false)
          ((= literalKind "keyword") t)
          (t (let ((value (get node :value)))
               (and (not (= value false))
                    (not (nil? value))
                    (not (undefined? value)))))))))

  (defun collectMutatedNames (program)
    (let ((mutated (new globalThis.Set)))
      (walkProgram program
        (lambda (node)
          (cond
            ((= (get node :kind) "assignment")
              (let ((children (if (nullish? (get node :children)) (js-array) (get node :children)))
                    (index 0))
                (while (< index (js-length children))
                  (let ((pair (aref children index)))
                    (when (and (not (nullish? pair)) (= (host-typeof (get pair :value)) "string"))
                      (js-call mutated :add (get pair :value))))
                  (setq index (1+ index)))))
            ((and (= (get node :kind) "variable-declaration")
                  (not (nullish? (get node :properties)))
                  (= (get (get node :properties) :mutable) t)
                  (= (host-typeof (get node :value)) "string"))
              (js-call mutated :add (get node :value))))))
      mutated))

  (defun copy-node-with-children (node children)
    (Object/assign (js-object) node (js-object :children children)))

  (defun foldIrNode (node &rest __opt)
    (let* ((env (aref __opt 0))
           (mutated (aref __opt 1))
           (actual-env (if (undefined? env) (new globalThis.Map) env))
           (actual-mutated (if (undefined? mutated) (new globalThis.Set) mutated)))
      (if (or (nil? node) (not (= (host-typeof node) "object")))
        node
        (if (or (= (get node :kind) "export-declaration")
                (= (get node :kind) "import-declaration"))
          node
          (if (and (= (get node :kind) "reference") (= (host-typeof (get node :value)) "string"))
            (if (and (not (js-call actual-mutated :has (get node :value)))
                     (js-call actual-env :has (get node :value)))
              (cloneLiteralNode (js-call actual-env :get (get node :value)) (get node :span))
              node)
            (if (and (= (get node :kind) "module-declaration") (Array/isArray (get node :children)))
              (let ((scope (new globalThis.Map actual-env))
                    (changed false)
                    (nextChildren (js-array))
                    (children (get node :children))
                    (index 0))
                (while (< index (js-length children))
                  (let* ((child (aref children index))
                         (next (foldIrNode child scope actual-mutated))
                         (props (get next :properties)))
                    (unless (eq next child) (setq changed t))
                    (when (and (= (get next :kind) "variable-declaration")
                               (or (nullish? props) (not (= (get props :mutable) t)))
                               (= (host-typeof (get next :value)) "string")
                               (not (js-call actual-mutated :has (get next :value)))
                               (Array/isArray (get next :children))
                               (= (js-length (get next :children)) 1)
                               (isConstantLiteralNode (aref (get next :children) 0)))
                      (js-call scope :set (get next :value) (aref (get next :children) 0)))
                    (js-call nextChildren :push next))
                  (setq index (1+ index)))
                (if changed (copy-node-with-children node nextChildren) node))
              (if (and (or (= (get node :kind) "function-declaration")
                           (= (get node :kind) "function-expression"))
                       (Array/isArray (get node :children)))
                (let* ((props (get node :properties))
                       (paramCount (if (or (nullish? props) (nullish? (get props :parameterCount)))
                                     0
                                     (get props :parameterCount)))
                       (scope (new globalThis.Map actual-env))
                       (children (get node :children))
                       (index 0))
                  (while (< index paramCount)
                    (let ((param (aref children index)))
                      (when (and (not (nullish? param)) (= (host-typeof (get param :value)) "string"))
                        (js-call scope :delete (get param :value))))
                    (setq index (1+ index)))
                  (let ((changed false)
                        (nextChildren (js-array)))
                    (setq index 0)
                    (while (< index (js-length children))
                      (let ((child (aref children index)))
                        (if (< index paramCount)
                          (js-call nextChildren :push child)
                          (let ((next (foldIrNode child scope actual-mutated)))
                            (unless (eq next child) (setq changed t))
                            (js-call nextChildren :push next))))
                      (setq index (1+ index)))
                    (if changed (copy-node-with-children node nextChildren) node)))
                (if (and (= (get node :kind) "lexical-bindings") (Array/isArray (get node :children)))
                  (let* ((props (get node :properties))
                         (bindingCount (if (or (nullish? props) (nullish? (get props :bindingCount)))
                                         0
                                         (get props :bindingCount)))
                         (sequential (and (not (nullish? props)) (= (get props :sequential) t)))
                         (outerScope (new globalThis.Map actual-env))
                         (bodyScope (new globalThis.Map actual-env))
                         (changed false)
                         (nextChildren (js-array))
                         (children (get node :children))
                         (index 0))
                    (while (< index (js-length children))
                      (let ((child (aref children index)))
                        (if (and (< index bindingCount) (= (get child :kind) "lexical-binding"))
                          (let ((initScope (if sequential bodyScope outerScope))
                                (nextBinding child))
                            (when (and (Array/isArray (get child :children))
                                       (> (js-length (get child :children)) 0))
                              (let ((bindingChanged false)
                                    (nextBindingChildren (js-array))
                                    (exprs (get child :children))
                                    (exprIndex 0))
                                (while (< exprIndex (js-length exprs))
                                  (let* ((expr (aref exprs exprIndex))
                                         (folded (foldIrNode expr initScope actual-mutated)))
                                    (unless (eq folded expr) (setq bindingChanged t))
                                  (js-call nextBindingChildren :push folded))
                                  (setq exprIndex (1+ exprIndex)))
                                (when bindingChanged
                                  (setq changed t)
                                  (setq nextBinding (copy-node-with-children child nextBindingChildren)))))
                            (let ((bprops (get nextBinding :properties)))
                              (when (and (= (host-typeof (get nextBinding :value)) "string")
                                         (or (nullish? bprops) (not (= (get bprops :pattern) t))))
                                (if (and (not (js-call actual-mutated :has (get nextBinding :value)))
                                         (Array/isArray (get nextBinding :children))
                                         (= (js-length (get nextBinding :children)) 1)
                                         (isConstantLiteralNode (aref (get nextBinding :children) 0)))
                                  (js-call bodyScope :set (get nextBinding :value) (aref (get nextBinding :children) 0))
                                  (js-call bodyScope :delete (get nextBinding :value)))))
                            (js-call nextChildren :push nextBinding))
                          (let ((next (foldIrNode child bodyScope actual-mutated)))
                            (unless (eq next child) (setq changed t))
                            (js-call nextChildren :push next))))
                      (setq index (1+ index)))
                    (let* ((updated (if changed (copy-node-with-children node nextChildren) node))
                           (bodyNodes (js-call (get updated :children) :slice bindingCount)))
                      (if (and (= (js-length bodyNodes) 1)
                               (isConstantLiteralNode (aref bodyNodes 0))
                               (js-call (js-call (get updated :children) :slice 0 bindingCount) :every
                                 (lambda (binding)
                                   (let ((bprops (get binding :properties)))
                                     (and (= (get binding :kind) "lexical-binding")
                                          (or (nullish? bprops) (not (= (get bprops :pattern) t)))
                                          (Array/isArray (get binding :children))
                                          (= (js-length (get binding :children)) 1)
                                          (isConstantLiteralNode (aref (get binding :children) 0)))))))
                        (aref bodyNodes 0)
                        updated)))
                  (foldIrNodePost node actual-env actual-mutated)))))))))

  (defun foldIrNodePost (initialNode env mutated)
    (let ((node initialNode))
      (when (and (Array/isArray (get node :children)) (> (js-length (get node :children)) 0))
        (let ((changed false)
              (optimizedChildren (js-array))
              (children (get node :children))
              (index 0))
          (while (< index (js-length children))
            (let* ((child (aref children index))
                   (next (foldIrNode child env mutated)))
              (unless (eq next child) (setq changed t))
              (js-call optimizedChildren :push next))
            (setq index (1+ index)))
          (when changed
            (setq node (copy-node-with-children node optimizedChildren)))))
      (let ((children (if (nullish? (get node :children)) (js-array) (get node :children))))
        (cond
          ((and (= (get node :kind) "conditional") (>= (js-length children) 2))
            (let ((truthy (literalTruthiness (aref children 0))))
              (cond
                ((= truthy t) (aref children 1))
                ((= truthy false)
                  (if (nullish? (aref children 2))
                    (js-object :kind "literal" :span (get node :span) :value nil :children (js-array))
                    (aref children 2)))
                (t node))))
          ((and (= (get node :kind) "short-circuit") (> (js-length children) 0))
            (foldShortCircuit node children))
          ((= (get node :kind) "intrinsic")
            (foldIntrinsic node children))
          ((and (= (get node :kind) "string-concat")
                (js-call children :every
                  (lambda (child)
                    (and (isPlainLiteralNode child)
                         (let ((val (get child :value)))
                           (or (= (host-typeof val) "string")
                               (= (host-typeof val) "number")
                               (= (host-typeof val) "boolean")
                               (nil? val)))))))
            (js-object :kind "literal"
              :span (get node :span)
              :value (js-call
                       (js-call children :map
                         (lambda (child)
                           (if (nil? (get child :value)) "" (funcall globalThis.String (get child :value)))))
                       :join "")
              :children (js-array)))
          (t node)))))

  (defun foldShortCircuit (node children)
    (cond
      ((= (get node :value) "and")
        (let ((remaining (js-array))
              (index 0)
              (early nil)
              (hasEarly false))
          (while (and (not hasEarly) (< index (js-length children)))
            (let* ((child (aref children index))
                   (truthy (literalTruthiness child)))
              (cond
                ((and (= truthy false) (= (js-length remaining) 0))
                  (setq early child hasEarly t))
                ((and (= truthy t) (< index (1- (js-length children))))
                  nil)
                (t (js-call remaining :push child))))
            (setq index (1+ index)))
          (cond
            (hasEarly early)
            ((= (js-length remaining) 1) (aref remaining 0))
            ((not (= (js-length remaining) (js-length children)))
              (copy-node-with-children node remaining))
            (t node))))
      ((= (get node :value) "or")
        (let ((remaining (js-array))
              (index 0)
              (early nil)
              (hasEarly false))
          (while (and (not hasEarly) (< index (js-length children)))
            (let* ((child (aref children index))
                   (truthy (literalTruthiness child)))
              (cond
                ((and (= truthy t) (= (js-length remaining) 0))
                  (setq early child hasEarly t))
                ((and (= truthy false) (< index (1- (js-length children))))
                  nil)
                (t (js-call remaining :push child))))
            (setq index (1+ index)))
          (cond
            (hasEarly early)
            ((= (js-length remaining) 1) (aref remaining 0))
            ((not (= (js-length remaining) (js-length children)))
              (copy-node-with-children node remaining))
            (t node))))
      (t node)))

  (defun foldIntrinsic (node children)
    (let ((op (get node :value))
          (result nil)
          (done false))
      (when (and (= op "not") (= (js-length children) 1))
        (let ((truthy (literalTruthiness (aref children 0))))
          (unless (nil? truthy)
            (setq result (js-object :kind "literal" :span (get node :span) :value (not truthy) :children (js-array))
                  done t))))
      (when (and (not done)
                 (or (= op "null") (= op "nil?") (= op "undefined?") (= op "nullish?"))
                 (= (js-length children) 1)
                 (isConstantLiteralNode (aref children 0)))
        (let* ((raw (literalRuntimeValue (aref children 0)))
               (val (cond
                      ((= op "undefined?") (undefined? raw))
                      ((= op "nullish?") (or (nil? raw) (undefined? raw)))
                      (t (nil? raw)))))
          (setq result (js-object :kind "literal" :span (get node :span) :value val :children (js-array))
                done t)))
      (when (and (not done)
                 (or (= op "=") (= op "/=") (= op "not=") (= op "eq") (= op "equal"))
                 (= (js-length children) 2)
                 (isConstantLiteralNode (aref children 0))
                 (isConstantLiteralNode (aref children 1)))
        (let* ((left (literalRuntimeValue (aref children 0)))
               (right (literalRuntimeValue (aref children 1)))
               (same (eq left right)))
          (setq result (js-object :kind "literal"
                         :span (get node :span)
                         :value (if (or (= op "/=") (= op "not=")) (not same) same)
                         :children (js-array))
                done t)))
      (when (and (not done)
                 (or (= op "<") (= op "<=") (= op ">") (= op ">="))
                 (= (js-length children) 2)
                 (isPlainLiteralNode (aref children 0))
                 (isPlainLiteralNode (aref children 1))
                 (= (host-typeof (get (aref children 0) :value)) "number")
                 (= (host-typeof (get (aref children 1) :value)) "number"))
        (let* ((left (get (aref children 0) :value))
               (right (get (aref children 1) :value))
               (compared (cond
                           ((= op "<") (< left right))
                           ((= op "<=") (<= left right))
                           ((= op ">") (> left right))
                           (t (>= left right)))))
          (setq result (js-object :kind "literal" :span (get node :span) :value compared :children (js-array))
                done t)))
      (when (and (not done)
                 (js-call children :every
                   (lambda (child)
                     (and (isPlainLiteralNode child) (= (host-typeof (get child :value)) "number")))))
        (let ((values (js-call children :map (lambda (child) (get child :value))))
              (folded undefined))
          (cond
            ((= op "+")
              (setq folded (js-call values :reduce (lambda (sum item) (+ sum item)) 0)))
            ((= op "*")
              (setq folded (js-call values :reduce (lambda (product item) (* product item)) 1)))
            ((= op "-")
              (cond
                ((= (js-length values) 1) (setq folded (- (aref values 0))))
                ((>= (js-length values) 2)
                  (setq folded (js-call (js-call values :slice 1) :reduce
                                 (lambda (acc item) (- acc item))
                                 (aref values 0))))))
            ((= op "/")
              (when (and (= (js-length values) 2) (not (= (aref values 1) 0)))
                (setq folded (/ (aref values 0) (aref values 1)))))
            ((= op "%")
              (when (and (= (js-length values) 2) (not (= (aref values 1) 0)))
                (setq folded (% (aref values 0) (aref values 1)))))
            ((= op "1+")
              (when (= (js-length values) 1) (setq folded (1+ (aref values 0)))))
            ((= op "1-")
              (when (= (js-length values) 1) (setq folded (1- (aref values 0))))))
          (when (and (= (host-typeof folded) "number") (Number/isFinite folded))
            (setq result (js-object :kind "literal" :span (get node :span) :value folded :children (js-array))
                  done t))))
      (when (and (not done) (= op "+") (>= (js-length children) 2))
        (let ((nonZero (js-call children :filter
                         (lambda (child)
                           (not (and (isPlainLiteralNode child) (= (get child :value) 0)))))))
          (when (and (> (js-length nonZero) 0) (< (js-length nonZero) (js-length children)))
            (setq result (if (= (js-length nonZero) 1)
                           (aref nonZero 0)
                           (copy-node-with-children node nonZero))
                  done t))))
      (when (and (not done) (= op "*") (>= (js-length children) 2))
        (let ((nonOne (js-call children :filter
                        (lambda (child)
                          (not (and (isPlainLiteralNode child) (= (get child :value) 1)))))))
          (when (and (> (js-length nonOne) 0) (< (js-length nonOne) (js-length children)))
            (setq result (if (= (js-length nonOne) 1)
                           (aref nonOne 0)
                           (copy-node-with-children node nonOne))
                  done t))))
      (if done result node)))

  (defun optimizeProgramIr (program)
    (if (or (nil? program)
            (not (= (host-typeof program) "object"))
            (not (Array/isArray (get program :body))))
      program
      (let ((mutated (collectMutatedNames program))
            (topScope (new globalThis.Map)))
        (put program :body
          (js-call (get program :body) :map
            (lambda (node)
              (let* ((next (foldIrNode node topScope mutated))
                     (props (get next :properties)))
                (when (and (= (get next :kind) "variable-declaration")
                           (or (nullish? props) (not (= (get props :mutable) t)))
                           (= (host-typeof (get next :value)) "string")
                           (not (js-call mutated :has (get next :value)))
                           (Array/isArray (get next :children))
                           (= (js-length (get next :children)) 1)
                           (isConstantLiteralNode (aref (get next :children) 0)))
                  (js-call topScope :set (get next :value) (aref (get next :children) 0)))
                next))))
        program)))

  (defun isIdentifierChar (ch)
    (if (or (nullish? ch) (= ch ""))
      false
      (let ((code (js-call ch :charCodeAt 0)))
        (or (and (>= code 48) (<= code 57))
            (and (>= code 65) (<= code 90))
            (and (>= code 97) (<= code 122))
            (= code 36)
            (= code 95)
            (> code 127)))))

  (defun compactLineWhitespace (line)
    (if (js-call line :startsWith "//# sourceMappingURL=")
      line
      (let ((result "")
            (index 0)
            (length (js-length line)))
        (while (< index length)
          (let ((ch (aref line index)))
            (cond
              ((or (= ch "\"") (= ch "'") (= ch "`"))
                (let ((quote-char ch)
                      (in-quote t))
                  (setq result (str result ch))
                  (setq index (1+ index))
                  (while (and in-quote (< index length))
                    (let ((cur (aref line index)))
                      (setq result (str result cur))
                      (setq index (1+ index))
                      (if (and (= cur "\\") (< index length))
                        (progn
                          (setq result (str result (aref line index)))
                          (setq index (1+ index)))
                        (when (= cur quote-char)
                          (setq in-quote false)))))))
              ((or (= ch " ") (= ch "\t"))
                (while (and (< index length)
                            (or (= (aref line index) " ") (= (aref line index) "\t")))
                  (setq index (1+ index)))
                (let ((prev (if (> (js-length result) 0) (aref result (1- (js-length result))) ""))
                      (next (if (< index length) (aref line index) "")))
                  (when (or (and (isIdentifierChar prev) (isIdentifierChar next))
                            (and (= prev "+") (= next "+"))
                            (and (= prev "-") (= next "-"))
                            (and (= prev "/") (or (= next "/") (= next "*"))))
                    (setq result (str result " ")))))
              (t
                (setq result (str result ch))
                (setq index (1+ index))))))
        result)))

  (defun optimizeJavaScript (code)
    (if (or (not (= (host-typeof code) "string")) (= (js-length code) 0))
      code
      (let ((out "")
            (index 0)
            (length (js-length code))
            (aborted false))
        (while (and (not aborted) (< index length))
          (let ((ch (aref code index))
                (next (aref code (1+ index))))
            (cond
              ((or (= ch "\"") (= ch "'") (= ch "`"))
                (let ((quote-char ch)
                      (in-quote t))
                  (setq out (str out ch))
                  (setq index (1+ index))
                  (while (and in-quote (< index length))
                    (let ((current (aref code index)))
                      (setq out (str out current))
                      (setq index (1+ index))
                      (if (and (= current "\\") (< index length))
                        (progn
                          (setq out (str out (aref code index)))
                          (setq index (1+ index)))
                        (when (= current quote-char)
                          (setq in-quote false)))))))
              ((and (= ch "/") (= next "/"))
                (let* ((lineEnd (js-call code :indexOf "\n" (+ index 2)))
                       (comment (if (< lineEnd 0)
                                  (js-call code :slice index)
                                  (js-call code :slice index lineEnd))))
                  (when (js-call comment :startsWith "//# sourceMappingURL=")
                    (setq out (str out comment)))
                  (setq index (if (< lineEnd 0) length lineEnd))))
              ((and (= ch "/") (= next "*"))
                (let ((closeIndex (js-call code :indexOf "*/" (+ index 2))))
                  (if (< closeIndex 0)
                    (setq aborted t)
                    (let ((block (js-call code :slice (+ index 2) closeIndex)))
                      (setq out (str out (if (js-call block :includes "\n") "\n" " ")))
                      (setq index (+ closeIndex 2))))))
              (t
                (setq out (str out ch))
                (setq index (1+ index))))))
        (let ((lines (js-call
                       (js-call (js-call out :split "\n") :map
                         (lambda (line) (compactLineWhitespace (js-call line :trim))))
                       :filter (lambda (line) (> (js-length line) 0)))))
          (if (= (js-length lines) 0)
            ""
            (str (js-call lines :join "\n") "\n"))))))

  (defun applyPostCompileOptimization (javascript sourceMap meta &rest __opt)
    (let* ((options (aref __opt 0))
           (actual-options (if (undefined? options) (js-object) options))
           (code (if (or (= (get actual-options :minify) t)
                         (= (get actual-options :optimize) "compact"))
                   (optimizeJavaScript javascript)
                   javascript))
           (map sourceMap))
      (when (= (host-typeof (get actual-options :closureCompiler)) "function")
        (let ((transformed (funcall (get actual-options :closureCompiler) code
                             (Object/assign (js-object) meta (js-object :sourceMap map)))))
          (cond
            ((= (host-typeof transformed) "string")
              (setq code transformed))
            ((and (not (nil? transformed)) (= (host-typeof transformed) "object"))
              (when (= (host-typeof (get transformed :javascript)) "string")
                (setq code (get transformed :javascript)))
              (when (= (host-typeof (get transformed :sourceMap)) "string")
                (setq map (get transformed :sourceMap)))))))
      (js-object :javascript code :sourceMap map)))

  (defun localSourceSpecifier (specifier)
    (and (js-call specifier :startsWith ".") (js-call specifier :endsWith SOURCE_EXTENSION)))

  (defun importSpecifiers (program)
    (let ((specifiers (js-array)))
      (walkProgram program
        (lambda (node)
          (when (= (get node :kind) "import-declaration")
            (js-call specifiers :push node))))
      specifiers))

  (defun mapSourcePath (output source)
    (let ((path (relativePath (str output ".map") source)))
      (if (js-call path :startsWith "./") (js-call path :slice 2) path)))

  (defun rewriteEmittedExternals (code source resolveExternal)
    (if (undefined? resolveExternal)
      code
      (let ((rewrite (lambda (whole prefix quoted)
                       (let ((specifier (js-call quoted :slice 1 -1)))
                         (if (or (js-call specifier :startsWith ".")
                                 (js-call specifier :startsWith "/")
                                 (js-call specifier :includes "://"))
                           whole
                           (let ((external (funcall resolveExternal specifier source)))
                             (if (and (= (host-typeof external) "string") (> (js-length external) 0))
                               (str prefix "\"" external "\"")
                               whole)))))))
        (js-call
          (js-call code :replace from-specifier-pattern rewrite)
          :replace import-specifier-pattern rewrite))))

  (defun diagnosticOf (error filename)
    (if (and (not (nullish? error)) (not (nullish? (get error :eliscriptDiagnostic))))
      (get error :eliscriptDiagnostic)
      (js-object :format "eliscript-diagnostic"
        :version 1
        :code "ELI-BROWSER-0001"
        :severity "error"
        :phase "browser-host"
        :message (if (or (nullish? error) (nullish? (get error :message)))
                   (funcall globalThis.String error)
                   (get error :message))
        :location (js-object :file filename))))

  (defconst BrowserCompileError
    (funcall host-error-class
      (lambda (self diagnostics)
        (put self :name "BrowserCompileError")
        (put self :diagnostics diagnostics))
      "BrowserCompileError"
      1
      (lambda (diagnostics)
        (js-call (js-call diagnostics :map (lambda (diagnostic) (get diagnostic :message))) :join "; "))))

  (defun failure (code message filename)
    (new BrowserCompileError
      (js-array
        (js-object :format "eliscript-diagnostic"
          :version 1
          :code code
          :severity "error"
          :phase "browser-host"
          :message message
          :location (js-object :file filename)))))

  (defun normalizePackageSubpath (specifier)
    (if (and (js-call package-subpath-pattern :test specifier)
             (not (js-call extension-pattern :test specifier)))
      (str specifier OUTPUT_EXTENSION)
      specifier))

  (defun rewriteSpecifiers (program source resolveExternal)
    (let ((nodes (importSpecifiers program))
          (index 0))
      (while (< index (js-length nodes))
        (let* ((node (aref nodes index))
               (specifier (get node :value)))
          (if (localSourceSpecifier specifier)
            (put node :value
              (relativePath (outputPathFor source) (outputPathFor (resolvePath source specifier))))
            (unless (or (js-call specifier :startsWith ".") (js-call specifier :startsWith "/"))
              (let ((normalized (normalizePackageSubpath specifier)))
                (put node :value normalized)
                (when (not (nullish? resolveExternal))
                  (let ((external (funcall resolveExternal normalized source)))
                    (when (and (= (host-typeof external) "string") (> (js-length external) 0))
                      (put node :value external))))))))
        (setq index (1+ index)))))

  (defun compileSource (source &rest __opt)
    (let* ((filename (aref __opt 0))
           (options (aref __opt 1))
           (actual-filename (if (undefined? filename) (str "module" SOURCE_EXTENSION) filename))
           (actual-options (if (undefined? options) (js-object) options))
           (macroContext (if (nullish? (get actual-options :macroContext))
                           nil
                           (get actual-options :macroContext)))
           (program (compile_ir_string source actual-filename macroContext)))
      (unless (= (get actual-options :optimize) false)
        (optimizeProgramIr program))
      (rewriteSpecifiers program actual-filename (get actual-options :resolveExternal))
      (let* ((output (outputPathFor actual-filename))
             (emission (emit_ir_string_with_source_map
                         program source output (mapSourcePath output actual-filename)))
             (rewritten (rewriteEmittedExternals
                          (get emission :javascript)
                          actual-filename
                          (get actual-options :resolveExternal))))
        (applyPostCompileOptimization
          rewritten
          (get emission :sourceMap)
          (js-object :filename actual-filename :output output)
          actual-options))))

  (defun compileProject (request)
    (let* ((files (get request :files))
           (entry (get request :entry))
           (macroContext (if (nullish? (get request :macroContext)) nil (get request :macroContext)))
           (resolveExternal (get request :resolveExternal))
           (optimize (if (undefined? (get request :optimize)) t (get request :optimize)))
           (minify (if (undefined? (get request :minify)) false (get request :minify)))
           (closureCompiler (get request :closureCompiler))
           (filePaths (Object/keys files))
           (pathIndex 0))
      (while (< pathIndex (js-length filePaths))
        (outputPathFor (aref filePaths pathIndex))
        (setq pathIndex (1+ pathIndex)))
      (when (undefined? (aref files entry))
        (throw (failure "ELI-BROWSER-0002" (str "entry is not in the project: " entry) entry)))
      (let* ((programs (new globalThis.Map))
             (programFor
               (lambda (id)
                 (if (js-call programs :has id)
                   (js-call programs :get id)
                   (progn
                     (when (undefined? (aref files id))
                       (throw (failure "ELI-BROWSER-0003" (str "missing source for import: " id) id)))
                     (let ((program nil))
                       (try
                         (progn
                           (setq program (compile_ir_string (aref files id) id macroContext))
                           (unless (= optimize false)
                             (optimizeProgramIr program)))
                         (catch error
                           (throw (new BrowserCompileError (js-array (diagnosticOf error id))))))
                       (js-call programs :set id program)
                       program)))))
             (plan (project_plan (js-array entry)
                     (lambda (id)
                       (js-call
                         (js-call (importSpecifiers (funcall programFor id)) :filter
                           (lambda (node) (localSourceSpecifier (get node :value))))
                         :map (lambda (node) (resolvePath id (get node :value)))))))
             (modules (js-object))
             (ordered (dependencyOrder (get plan :modules)))
             (index 0))
        (while (< index (js-length ordered))
          (let* ((id (aref ordered index))
                 (output (outputPathFor id))
                 (program (funcall programFor id)))
            (rewriteSpecifiers program id resolveExternal)
            (let* ((emission (emit_ir_string_with_source_map
                               program (aref files id) output (mapSourcePath output id)))
                   (rewritten (rewriteEmittedExternals (get emission :javascript) id resolveExternal))
                   (optimized (applyPostCompileOptimization
                                rewritten
                                (get emission :sourceMap)
                                (js-object :filename id :output output)
                                (js-object :optimize optimize
                                  :minify minify
                                  :closureCompiler closureCompiler))))
              (put modules output
                (js-object :id id
                  :source (aref files id)
                  :javascript (get optimized :javascript)
                  :sourceMap (get optimized :sourceMap)))))
          (setq index (1+ index)))
        (js-object :plan plan :modules modules))))

  (defun moduleGraphUrls (modules entry)
    (let* ((urls (js-object))
           (created (js-array))
           (outputs (Object/keys modules))
           (targetOf
             (lambda (from specifier)
               (let ((parts (splitPath (dirname from)))
                     (segments (js-call specifier :split "/"))
                     (index 0))
                 (while (< index (js-length segments))
                   (let ((part (aref segments index)))
                     (cond
                       ((or (= part "") (= part ".")) nil)
                       ((= part "..") (js-call parts :pop))
                       (t (js-call parts :push part))))
                   (setq index (1+ index)))
                 (js-call parts :join "/"))))
           (rewritePattern
             (lambda (code from pattern)
               (js-call code :replace pattern
                 (lambda (whole prefix quoted)
                   (let ((specifier (js-call quoted :slice 1 -1)))
                     (if (not (js-call specifier :startsWith "."))
                       whole
                       (let ((url (aref urls (funcall targetOf from specifier))))
                         (if (undefined? url)
                           whole
                           (str prefix "\"" url "\"")))))))))
           (index 0))
      (while (< index (js-length outputs))
        (let* ((outputPath (aref outputs index))
               (code (get (aref modules outputPath) :javascript)))
          (setq code (funcall rewritePattern code outputPath from-specifier-pattern))
          (setq code (funcall rewritePattern code outputPath import-specifier-pattern))
          (let ((blobUrl (js-call globalThis.URL :createObjectURL
                           (new globalThis.Blob (js-array code) (js-object :type "text/javascript")))))
            (put urls outputPath blobUrl)
            (js-call created :push blobUrl)))
        (setq index (1+ index)))
      (let ((entryUrl (aref urls (outputPathFor entry))))
        (when (undefined? entryUrl)
          (let ((revokeIndex 0))
            (while (< revokeIndex (js-length created))
              (js-call globalThis.URL :revokeObjectURL (aref created revokeIndex))
              (setq revokeIndex (1+ revokeIndex))))
          (throw (failure "ELI-BROWSER-0004" (str "compiled entry is missing: " entry) entry)))
        (js-object :entryUrl entryUrl
          :urls urls
          :release (lambda ()
                     (let ((revokeIndex 0))
                       (while (< revokeIndex (js-length created))
                         (js-call globalThis.URL :revokeObjectURL (aref created revokeIndex))
                         (setq revokeIndex (1+ revokeIndex)))))))))

  (defasync runSource (source &rest __opt)
    (let* ((filename (aref __opt 0))
           (options (aref __opt 1))
           (actual-filename (if (undefined? filename) (str "module" SOURCE_EXTENSION) filename))
           (actual-options (if (undefined? options) (js-object) options))
           (compiled (compileSource source actual-filename actual-options))
           (url (js-call globalThis.URL :createObjectURL
                  (new globalThis.Blob (js-array (get compiled :javascript))
                    (js-object :type "text/javascript")))))
      (try
        (let ((mod (await (funcall host-import url))))
          (js-object :module mod
            :javascript (get compiled :javascript)
            :sourceMap (get compiled :sourceMap)))
        (finally
          (js-call globalThis.URL :revokeObjectURL url)))))

  (defun scriptFilename (script index)
    (let* ((get-attr (if (nullish? script) undefined (get script :getAttribute)))
           (dataset (if (nullish? script) undefined (get script :dataset)))
           (explicit (or (if (= (host-typeof get-attr) "function")
                           (js-call script :getAttribute "data-filename")
                           nil)
                         (if (nullish? dataset) undefined (get dataset :filename)))))
      (if (and (= (host-typeof explicit) "string") (> (js-length (js-call explicit :trim)) 0))
        (let ((name (js-call explicit :trim)))
          (if (js-call name :endsWith SOURCE_EXTENSION)
            name
            (str name SOURCE_EXTENSION)))
        (let ((found nil))
          (when (and (not (nullish? script))
                     (= (host-typeof (get script :src)) "string")
                     (> (js-length (get script :src)) 0))
            (try
              (let* ((loc globalThis.location)
                     (base (if (or (nullish? loc) (nullish? (get loc :href)))
                             "http://localhost/"
                             (get loc :href)))
                     (url (new globalThis.URL (get script :src) base))
                     (segments (js-call (js-call (get url :pathname) :split "/") :filter
                                 (lambda (part) (> (js-length part) 0))))
                     (tail (js-call segments :pop)))
                (when (and tail (js-call tail :endsWith SOURCE_EXTENSION))
                  (setq found tail)))
              (catch err nil)))
          (if found
            found
            (str "inline-" (1+ index) SOURCE_EXTENSION))))))

  (defasync mountEliscriptScripts (&rest __opt)
    (let* ((root (aref __opt 0))
           (options (aref __opt 1))
           (actual-root (if (undefined? root) globalThis.document root))
           (actual-options (if (undefined? options) (js-object) options)))
      (if (or (nullish? actual-root)
              (not (= (host-typeof (get actual-root :querySelectorAll)) "function")))
        (js-array)
        (let* ((fetchImpl (if (nullish? (get actual-options :fetch))
                            globalThis.fetch
                            (get actual-options :fetch)))
               (scripts (Array/from (js-call actual-root :querySelectorAll "script[type=\"text/eliscript\"]")))
               (mounted (js-array))
               (index 0))
          (while (< index (js-length scripts))
            (let* ((script (aref scripts index))
                   (dataset (get script :dataset)))
              (unless (and (not (nullish? dataset)) (= (get dataset :eliscriptMounted) "true"))
                (when dataset (put dataset :eliscriptMounted "true"))
                (let ((filename (scriptFilename script index))
                      (source (if (nullish? (get script :textContent)) "" (get script :textContent))))
                  (when (and (= (host-typeof (get script :src)) "string")
                             (> (js-length (get script :src)) 0))
                    (let ((response (await (funcall fetchImpl (get script :src)))))
                      (unless (get response :ok)
                        (throw (failure "ELI-BROWSER-0005"
                                 (str "failed to fetch " (get script :src) ": " (get response :status))
                                 filename)))
                      (setq source (await (js-call response :text)))))
                  (let ((executed (await (runSource source filename actual-options))))
                    (js-call mounted :push
                      (Object/assign (js-object :script script :filename filename) executed))))))
            (setq index (1+ index)))
          mounted))))

  (defconst browserHostSurface
    (Object/freeze
      (js-object :sourceExtension SOURCE_EXTENSION
        :outputExtension OUTPUT_EXTENSION)))

  (export BrowserCompileError browserHostSurface compileProject compileSource
    dependencyOrder dirname moduleGraphUrls mountEliscriptScripts normalizePath
    optimizeJavaScript optimizeProgramIr outputPathFor relativePath resolvePath
    runSource))
