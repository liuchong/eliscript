;; Article source dispatch.
;;
;; A build reads whichever sources the configuration enables, and the rest of
;; the builder never learns where a record came from beyond its provenance. This
;; module is a library rather than part of the entry, so the source matrix can
;; be exercised directly with a substituted transport instead of over the
;; network.

(module dogfood.builder.sources
  (import "eliscript/runtime/core/collection.mjs" :as Collection)
  (import "eliscript/runtime/core/sequence.mjs" :as Sequence)
  (import "./content.eli" read-posts)
  (import "./discussions.eli" collect-discussions)
  (import "./issues.eli" collect-issues)
  (import "../support/diagnostics.eli" fail)

  (defun enabled-sources (config)
    (Sequence/filter (lambda (source) (Collection/get source :enabled false))
                     (Collection/get config :sources [])))

  ;; Carrier bindings name a canonical post, so every identity already known
  ;; in this build is offered to the classifier before article filters run.
  (defun identity-list (posts)
    (let ((result [])
          (index 0))
      (while (< index (Collection/count posts))
        (let* ((post (Collection/nth posts index))
               (aliases (get post :aliases))
               (alias-index 0))
          (setq result (Collection/conj result (get post :id)))
          (while (< alias-index (Collection/count aliases))
            (setq result (Collection/conj result
                                         (Collection/nth aliases alias-index)))
            (setq alias-index (1+ alias-index))))
        (setq index (1+ index)))
      result))

  (defasync source-posts (root config source transport identities)
    (let ((kind (Collection/get source :kind :markdown)))
      (cond
        ((= kind :markdown)
         {:posts (read-posts root (Collection/get source :directory "content/posts"))
          :carriers 0
          :unauthorized 0})
        ((= kind :issues)
         (await (collect-issues {:source source
                                 :publishing (Collection/get config :publishing)
                                 :adapters (Collection/get config :adapters [])
                                 :identities identities
                                 :comments (Collection/get config :comments {})
                                 :transport transport})))
        ((= kind :discussions)
         (await (collect-discussions {:source source
                                      :publishing (Collection/get config :publishing)
                                      :adapters (Collection/get config :adapters [])
                                      :identities identities
                                      :comments (Collection/get config :comments {})
                                      :transport transport})))
        (t (fail "DOGFOOD-SOURCE-001"
                 (str "unsupported source kind: " kind))))))

  (export enabled-sources identity-list source-posts))
