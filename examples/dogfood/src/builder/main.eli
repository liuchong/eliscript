;; Builder entry point.
;;
;; The builder owns host effects: it loads configuration, reads Markdown,
;; normalizes the canonical post model, calls the renderer, writes a staging
;; tree, and replaces the published output only after every document exists.
;; The renderer is imported as a library and has no host authority of its own.
;;
;; The same entry serves two callers. Locally it takes `--root`, `--config`,
;; and `--output`. Under GitHub Actions it reads the declared action inputs and
;; writes the declared action outputs.

(module dogfood.builder.main
  (import "eliscript/runtime/core/collection.mjs" :as Collection)
  (import "eliscript/runtime/core/sequence.mjs" :as Sequence)
  (import "node:crypto" createHash)
  (import "node:fs"
          appendFileSync existsSync mkdirSync readFileSync renameSync rmSync
          writeFileSync)
  (import "node:path" :as Path)
  (import "../renderer/server.eli" render-site sort-posts)
  (import "./content.eli" check-identity read-posts)
  (import "./issues.eli" collect-issues)
  (import "./discussions.eli" collect-discussions)
  (import "./events.eli" build-decision classify-event requested-event)
  (import "./identity.eli" resolve-identity)
  (import "./sources.eli" enabled-sources identity-list source-posts)
  (import "../support/config.eli" load-config)
  (import "../support/diagnostics.eli" fail)
  (import "../support/text.eli" join slice string-value? text-length)

  (defconst program-arguments (js* "process.argv"))
  (defconst environment (js* "process.env"))
  (defconst fetch-implementation (js* "globalThis.fetch"))
  (defconst set-exit-code (js* "(code) => { process.exitCode = code; }"))
  (defconst to-native-array (js* "(value) => Array.from(value)"))

  (defun env-value (name)
    (let ((value (get environment name nil)))
      (if (or (nil? value) (= value "")) nil value)))

  (defun truthy-input? (value)
    (or (= value "true") (= value "1") (= value "yes")))

  ;; GitHub upper-cases action inputs and preserves dashes, while many runners
  ;; export the underscored spelling, so both are accepted.
  (defun action-input (name)
    (cond
      ((= name "config-file")
       (first-value (env-value "INPUT_CONFIG-FILE") (env-value "INPUT_CONFIG_FILE")))
      ((= name "output-directory")
       (first-value (env-value "INPUT_OUTPUT-DIRECTORY")
                    (env-value "INPUT_OUTPUT_DIRECTORY")))
      ((= name "force") (env-value "INPUT_FORCE"))
      ((= name "preview") (env-value "INPUT_PREVIEW"))
      ((= name "event-file")
       (first-value (env-value "INPUT_EVENT-FILE") (env-value "INPUT_EVENT_FILE")))
      ((= name "previous-manifest")
       (first-value (env-value "INPUT_PREVIOUS-MANIFEST")
                    (env-value "INPUT_PREVIOUS_MANIFEST")))
      ((= name "github-token")
       (first-value (env-value "INPUT_GITHUB-TOKEN") (env-value "INPUT_GITHUB_TOKEN")))
      (t nil)))

  (defun first-value (first second)
    (if (nil? first) second first))

  ;; `--force` and `--preview` are flags. Reading them as options made a
  ;; trailing `--force` read the next argument as its value, so the flag did
  ;; nothing exactly when it was written last.
  (defun flag-present? (arguments name)
    (let ((index 0)
          (found nil)
          (total (Collection/count arguments)))
      (while (< index total)
        (when (= (Collection/nth arguments index) name) (setq found t))
        (setq index (1+ index)))
      found))

  (defun option-value (arguments name fallback)
    (let ((index 2)
          (found fallback)
          (total (Collection/count arguments)))
      (while (< index total)
        (when (and (= (Collection/nth arguments index) name)
                   (< (+ index 1) total))
          (setq found (Collection/nth arguments (+ index 1))))
        (setq index (1+ index)))
      found))

  (defun absolute-path (root value)
    (if (= (slice 0 1 value) "/") value (Path/join root value)))

  ;; ------------------------------------------------------------ output writing

  (defun prepare-staging (staging)
    (when (existsSync staging)
      (rmSync staging (js-object :recursive t :force t)))
    (mkdirSync staging (js-object :recursive t)))

  (defun write-document (staging document)
    (let* ((relative (Collection/get document :path))
           (target (Path/join staging relative)))
      (mkdirSync (Path/dirname target) (js-object :recursive t))
      (writeFileSync target (Collection/get document :content))))

  (defun fingerprint (documents)
    (let ((hash (createHash "sha256"))
          (index 0))
      (while (< index (Collection/count documents))
        (let ((document (Collection/nth documents index)))
          (js-call hash :update (Collection/get document :path))
          (js-call hash :update "\n")
          (js-call hash :update (Collection/get document :content))
          (js-call hash :update "\n"))
        (setq index (1+ index)))
      (js-call hash :digest "hex")))

  (defun public-post (post)
    (js-object
      :id (get post :id)
      :slug (get post :slug)
      :title (get post :title)
      :summary (get post :summary)
      :publishedAt (get post :published-at)
      :updatedAt (get post :updated-at)
      :tags (funcall to-native-array (get post :tags))
      :source (Collection/get (get post :provenance) :path "")))

  (defun public-posts (posts)
    (funcall to-native-array (Sequence/map public-post posts)))

  (defun write-manifests (staging documents posts config carriers unauthorized)
    (mkdirSync (Path/join staging "_dogfood") (js-object :recursive t))
    (writeFileSync
      (Path/join staging "_dogfood/build.json")
      (str (JSON/stringify
             (js-object :format "dogfood-build"
                        :version 1
                        :configSchemaVersion (Collection/get config :schema-version 1)
                        :postCount (Collection/count posts)
                        :routeCount (Collection/count documents)
                        :contentFingerprint (fingerprint documents)
                        :commentCarriers (str carriers)
                        :unauthorizedRecords (str unauthorized)))
           "\n"))
    (writeFileSync
      (Path/join staging "_dogfood/posts.json")
      (str (JSON/stringify (js-object :format "dogfood-posts"
                                      :version 1
                                      :posts (public-posts posts)))
           "\n")))

  (defun manifest-fingerprint (path)
    (Collection/get (JSON/parse (readFileSync path "utf8")) "contentFingerprint" nil))

  ;; The tree this run replaces must be the one the recorded build produced.
  ;; Without this check a stale, hand-edited, or foreign output directory is
  ;; deleted without anyone noticing.
  (defun verify-previous-manifest (previous-manifest output)
    (when (not (nil? previous-manifest))
      (let* ((expected-path (absolute-path "." previous-manifest))
             (current-path (Path/join output "_dogfood/build.json"))
             (current (if (existsSync current-path)
                          (manifest-fingerprint current-path) nil))
             (expected (if (existsSync expected-path)
                           (manifest-fingerprint expected-path) nil)))
        (cond
          ((nil? current) nil)
          ((nil? expected)
           (fail "DOGFOOD-BUILD-005"
                 (str "previous manifest is missing or unreadable: " expected-path)))
          ((not (= current expected))
           (fail "DOGFOOD-BUILD-004"
                 (str "output " output " was not produced by the recorded build: "
                      (str current) " does not match " (str expected))))
          (t nil)))))

  (defun publish (staging output)
    (let ((backup (str output ".backup")))
      (when (existsSync backup)
        (rmSync backup (js-object :recursive t :force t)))
      (when (existsSync output)
        (renameSync output backup))
      (try
        (renameSync staging output)
        (catch error
          (when (existsSync backup)
            (renameSync backup output))
          (throw error)))
      (when (existsSync backup)
        (rmSync backup (js-object :recursive t :force t)))))

  (defun publishable? (post preview)
    (or preview (not (get post :draft))))

  ;; A preview tree is reachable from a pull request, so it must not be indexed
  ;; and must say what it is.
  (defun preview-site (site)
    (Collection/assoc site :preview t))

  ;; ------------------------------------------------------------ browser asset

  ;; The browser bundle is generated beside the package rather than in the
  ;; consumer's repository, so it is looked for in the development layout and
  ;; then beside the running entry, which is the packaged layout.
  (defun defined-values (values)
    (let ((result [])
          (index 0))
      (while (< index (Collection/count values))
        (let ((value (Collection/nth values index)))
          (when (not (nil? value))
            (setq result (Collection/conj result value))))
        (setq index (1+ index)))
      result))

  (defun browser-bundle-candidates (root override)
    (let ((from-entry (str (Path/dirname (get program-arguments 1 "."))
                           "/../site/browser.js")))
      (defined-values [override
                       (env-value "DOGFOOD_BROWSER_BUNDLE")
                       (str root "/dist/site/browser.js")
                       from-entry])))

  (defun browser-bundle (root override)
    (let ((candidates (browser-bundle-candidates root override))
          (index 0)
          (found nil))
      (while (and (< index (Collection/count candidates)) (nil? found))
        (let ((candidate (Collection/nth candidates index)))
          (when (and (not (nil? candidate)) (existsSync candidate))
            (setq found candidate)))
        (setq index (1+ index)))
      (if (nil? found)
          (fail "DOGFOOD-BUILD-003"
                (str "browser bundle not found; looked in "
                     (join ", " candidates)))
        (readFileSync found "utf8"))))

  (defun append-all (target values)
    (Collection/reduce values
                       (lambda (accumulator value)
                         (Collection/conj accumulator value))
                       target))

  ;; ------------------------------------------------------------------ sources





  (defun request-headers (token)
    (if (nil? token)
        (js-object :accept "application/vnd.github+json" :user-agent "dogfood")
      (js-object :accept "application/vnd.github+json" :user-agent "dogfood"
                 :authorization (str "Bearer " token))))

  ;; The only network boundary in the builder. A token never reaches the
  ;; renderer, the site output, or the build manifest.
  ;;
  ;; The transport accepts either a URL string, which the shared pagination
  ;; layer uses for REST, or a request map with a method and body, which the
  ;; Discussion provider uses for GraphQL.
  (defasync github-transport (request)
    (let* ((token (first-value (env-value "GITHUB_TOKEN")
                               (action-input "github-token")))
           (plain (string-value? request))
           (url (if plain request (Collection/get request :url "")))
           (method (if plain "GET" (Collection/get request :method "GET")))
           (body (if plain nil (Collection/get request :body nil)))
           (init (js-object :method method :headers (request-headers token))))
      (when (not (nil? body))
        (put init "body" body))
      (let ((response (await (funcall fetch-implementation url init))))
        {:status (get response "status")
         :headers (js-object :link (js-call (get response "headers") :get "link"))
         :body (await (js-call response :json))})))



  ;; --------------------------------------------------------------- action glue

  (defun set-output (name value)
    (let ((destination (env-value "GITHUB_OUTPUT")))
      (when (not (nil? destination))
        (appendFileSync destination (str name "=" value "\n")))))

  (defun report (output documents posts reason fingerprint-value)
    (let ((post-count (Collection/count posts)))
      (print (str "dogfood: wrote " (Collection/count documents)
                  " routes from " post-count " published posts"))
      (print (str "dogfood: output " output))
      (print (str "dogfood: fingerprint " fingerprint-value))
      (set-output "built" "true")
      (set-output "reason" reason)
      (set-output "content-fingerprint" fingerprint-value)
      (set-output "cache-key" (str "dogfood-" fingerprint-value))
      (set-output "output-directory" output)
      (set-output "post-count" (str post-count))
      (set-output "comment-snapshot-count" "0")
      (set-output "manifest" (Path/join output "_dogfood/build.json"))))

  ;; ------------------------------------------------------------------- build

  (defun output-directory-of (root config override)
    (Path/join root (if (nil? override)
                        (Collection/get (Collection/get config :output) :directory "_site")
                      override)))

  (defasync build-site (root config-path output-override browser-override preview reason)
    (let* ((config (load-config config-path))
           (site (if preview
                     (preview-site (Collection/get config :site))
                   (Collection/get config :site)))
           (sources (enabled-sources config))
           (output (output-directory-of root config output-override))
           (staging (str output ".staging"))
           (collected [])
           (carriers 0)
           (unauthorized 0))
      (let ((index 0))
        (while (< index (Collection/count sources))
          (let* ((source (Collection/nth sources index))
                 (result (await (source-posts root config source github-transport
                                              (identity-list collected)))))
            (setq collected (append-all collected (Collection/get result :posts []))
                  carriers (+ carriers (Collection/get result :carriers 0))
                  unauthorized (+ unauthorized (Collection/get result :unauthorized 0))))
          (setq index (1+ index))))
      (let* ((posts (sort-posts
                      (Sequence/filter (lambda (post) (publishable? post preview))
                                       (resolve-identity config collected))))
             (documents (Collection/conj (render-site site posts)
                                       {:path "assets/browser.js"
                                        :content (browser-bundle root browser-override)}))
             (digest (fingerprint documents)))
        (check-identity posts)
        (prepare-staging staging)
        (let ((index 0))
          (while (< index (Collection/count documents))
            (write-document staging (Collection/nth documents index))
            (setq index (1+ index))))
        (write-manifests staging documents posts config carriers unauthorized)
        (publish staging output)
        (report output documents posts reason digest)
        digest)))

  ;; Keywords print with their leading colon, which reads as noise in a log.
  (defun keyword-name (value)
    (let* ((text (str value))
           (size (text-length text)))
      (if (and (> size 0) (= (string-code-unit-at text 0) 58))
          (slice 1 size text)
        text)))

  ;; An event that cannot change the site ends the run without writing output.
  (defun defer (decision)
    (let ((subject (keyword-name (Collection/get decision :subject :unknown)))
          (event (str (Collection/get decision :event ""))))
      (print (str "dogfood: deferred; " subject " event "
                  (if (= event "") "(none)" event)
                  " cannot change the site"))
      (set-output "built" "false")
      (set-output "reason" "deferred")
      (set-output "subject" subject)))

  (defasync main ()
    (let* ((arguments program-arguments)
           (root (option-value arguments "--root"
                               (first-value (env-value "GITHUB_WORKSPACE") ".")))
           (config-input (first-value (option-value arguments "--config" nil)
                                      (action-input "config-file")))
           (config-file (if (nil? config-input) "dogfood.config.eli" config-input))
           (config-path (absolute-path root config-file))
           (output-override (first-value (option-value arguments "--output" nil)
                                         (action-input "output-directory")))
           (forced (or (flag-present? arguments "--force")
                       (truthy-input? (action-input "force"))))
           (browser-override (option-value arguments "--browser-bundle" nil))
           (preview (or (flag-present? arguments "--preview")
                        (truthy-input? (action-input "preview"))))
           (event-file (first-value (option-value arguments "--event-file" nil)
                                    (first-value (action-input "event-file")
                                                 (env-value "GITHUB_EVENT_PATH"))))
           (previous-manifest
            (first-value (option-value arguments "--previous-manifest" nil)
                         (action-input "previous-manifest"))))
      (try
        (let* ((classification (if (nil? event-file)
                                   (requested-event)
                                 (classify-event
                                   (first-value (env-value "GITHUB_EVENT_NAME")
                                                "workflow_dispatch")
                                   (JSON/parse (readFileSync
                                                 (absolute-path root event-file)
                                                 "utf8")))))
               (config (load-config config-path))
               (decision (build-decision config classification forced)))
          (if (not (Collection/get decision :build nil))
              (defer decision)
            (progn
              ;; Verification is a precondition: it runs before any rendering,
              ;; so a rejected run leaves no staging tree behind.
              (verify-previous-manifest
                previous-manifest
                (output-directory-of root config output-override))
              (await (build-site root config-path output-override browser-override
                                 preview (Collection/get decision :reason "changed"))))))
        (catch error
          (print (str "dogfood: " (get error :code "DOGFOOD") ": "
                      (get error :message)))
          (set-output "built" "false")
          (set-output "reason" "failed")
          (funcall set-exit-code 1)))))

  (main))
