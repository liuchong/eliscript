;; GitHub Issues article provider.
;;
;; Specification 0010 puts authorization and carrier classification ahead of
;; article selection, so this module resolves the publisher set and identifies
;; comment carriers before it reads any article metadata. Specification 0003
;; defines the canonical post the provider must produce.
;;
;; Every effect arrives through an injected transport: one function from a URL
;; to `{ status, headers, body }`. The builder supplies a `fetch` transport and
;; the tests supply recorded fixtures, so provider policy is verifiable without
;; a network and without a token.

(module dogfood.builder.issues
  (import "eliscript/runtime/core/collection.mjs" :as Collection)
  (import "eliscript/runtime/core/sequence.mjs" :as Sequence)
  (import "../support/diagnostics.eli" fail)
  (import "../support/fields.eli" field parse-fields parse-list require-field)
  (import "../support/markdown.eli" render-markdown)
  (import "../support/text.eli"
          index-of join parse-integer slice slugify split-lines split-on
          startsWith text-length to-lowercase trim)
  (import "./content.eli" ->Post date-value)

  (defconst default-page-size 100)
  (defconst maximum-pages 100)

  ;; ------------------------------------------------------- publisher set

  (defun normalize-login (login)
    (to-lowercase (trim (str login))))

  ;; Bot, application, and deleted identities never publish an article.
  (defun denied-identity? (author)
    (or (not (= (get author "type" "User") "User"))
        (= (normalize-login (get author "login" "")) "ghost")))

  ;; A pinned immutable id must agree with the fetched account. Without a pin,
  ;; the case-insensitive login is the identity.
  (defun publisher-matches? (publisher author)
    (let ((pinned (Collection/get publisher :id nil)))
      (and (= (normalize-login (Collection/get publisher :login ""))
              (normalize-login (get author "login" "")))
           (or (nil? pinned) (= pinned (get author "id" nil))))))

  (defun publisher-set (publishing)
    (let ((owner (Collection/get publishing :owner nil))
          (coauthors (Collection/get publishing :coauthors []))
          (result []))
      (when (not (nil? owner))
        (setq result (Collection/conj result owner)))
      (let ((index 0))
        (while (< index (Collection/count coauthors))
          (setq result (Collection/conj result (Collection/nth coauthors index)))
          (setq index (1+ index))))
      result))

  (defun authorized-author? (publishers author)
    (and (not (denied-identity? author))
         (let ((index 0)
               (found false))
           (while (< index (Collection/count publishers))
             (when (publisher-matches? (Collection/nth publishers index) author)
               (setq found t))
             (setq index (1+ index)))
           found)))

  ;; --------------------------------------------------- carrier classification

  (defun identity-after (marker body)
    (let* ((lines (split-lines body))
           (index 0)
           (found nil))
      (while (and (< index (Collection/count lines)) (nil? found))
        (let ((line (trim (Collection/nth lines index))))
          (when (startsWith marker line)
            (setq found (trim (slice (text-length marker) (text-length line) line)))))
        (setq index (1+ index)))
      found))

  (defun known-identity? (identities value)
    (let ((index 0)
          (found false))
      (while (and (< index (Collection/count identities)) (not found))
        (when (= (Collection/nth identities index) value)
          (setq found t))
        (setq index (1+ index)))
      found))

  ;; A carrier is verified, never inferred: the adapter principal, the carrier
  ;; kind, and an explicit identity that exists in this build must all agree.
  ;; A marker alone, a label, or an article-shaped body never binds.
  (defun carrier-adapter (adapters author body identities)
    (let ((index 0)
          (found nil))
      (while (and (< index (Collection/count adapters)) (nil? found))
        (let* ((adapter (Collection/nth adapters index))
               (principal (Collection/get adapter :principal nil))
               (marker (Collection/get adapter :marker nil)))
          (when (and (= (Collection/get adapter :carrier-kind :none) :issue)
                     (not (nil? principal))
                     (not (nil? marker))
                     (= (normalize-login principal)
                        (normalize-login (get author "login" ""))))
            (let ((identity (identity-after marker body)))
              (when (and (not (nil? identity)) (known-identity? identities identity))
                (setq found (Collection/get adapter :id nil))))))
        (setq index (1+ index)))
      found))

  ;; ------------------------------------------------------------- metadata

  (defun metadata-block (lines)
    (let ((index 0)
          (start -1)
          (end -1)
          (total (Collection/count lines)))
      (while (and (< index total) (< end 0))
        (let ((trimmed (trim (Collection/nth lines index))))
          (cond
            ((and (< start 0) (= trimmed "```dogfood")) (setq start index))
            ((and (>= start 0) (= trimmed "```")) (setq end index))))
        (setq index (1+ index)))
      (if (or (< start 0) (< end 0)) nil [start end])))

  (defun issue-fields (body path)
    (let* ((lines (split-lines body))
           (block (metadata-block lines)))
      (if (nil? block)
          (fail "DOGFOOD-ISSUES-001"
                (str path ": issue body has no ```dogfood metadata block"))
        (parse-fields lines (+ (nth 0 block) 1) (nth 1 block)))))

  (defun issue-markdown (body)
    (let* ((lines (split-lines body))
           (block (metadata-block lines))
           (start (if (nil? block) 0 (1+ (nth 1 block))))
           (parts [])
           (index start)
           (total (Collection/count lines)))
      (while (< index total)
        (setq parts (Collection/conj parts (Collection/nth lines index)))
        (setq index (1+ index)))
      (join "\n" parts)))

  ;; ---------------------------------------------------------- pagination

  (defun link-target (link)
    (let ((start (index-of "<" link)))
      (if (< start 0)
          nil
        (let ((end (index-of ">" link)))
          (if (< end 0) nil (slice (1+ start) end link))))))

  ;; Only the entry whose relation is `next` continues the traversal.
  (defun next-link (headers)
    (let* ((link (get headers "link" nil))
           (parts (if (nil? link) [] (split-on "," link)))
           (index 0)
           (found nil))
      (while (< index (Collection/count parts))
        (let ((part (Collection/nth parts index)))
          (when (and (nil? found) (>= (index-of "rel=\"next\"" part) 0))
            (setq found (link-target part))))
        (setq index (1+ index)))
      found))

  (defun page-size (source)
    (Collection/get source :page-size default-page-size))

  (defun issue-list-url (source)
    (let ((repository (Collection/get source :repository ""))
          (label (Collection/get source :label nil)))
      (str "https://api.github.com/repos/" repository "/issues?state=all&per_page="
           (page-size source)
           (if (nil? label) "" (str "&labels=" label)))))

  ;; Complete pagination or a hard failure: a partial page set is never a
  ;; successful provider result.
  (defasync fetch-issues (transport url)
    (let ((records [])
          (pages 0)
          (next url))
      (while (and (not (nil? next)) (< pages maximum-pages))
        (let ((response (await (funcall transport next))))
          (unless (= (get response "status" 0) 200)
            (fail "DOGFOOD-ISSUES-002"
                  (str "GitHub issue listing failed with status "
                       (get response "status" "unknown"))))
          (setq records (append-all records (get response "body" [])))
          (setq next (next-link (get response "headers" (js-object))))
          (setq pages (1+ pages))))
      (when (not (nil? next))
        (fail "DOGFOOD-ISSUES-003"
              (str "issue listing exceeded " maximum-pages " pages")))
      records))

  (defun append-all (target values)
    (Collection/reduce values
                       (lambda (accumulator value)
                         (Collection/conj accumulator value))
                       target))

  ;; --------------------------------------------------------- normalization

  (defun issue-url (source record)
    (let ((explicit (get record "html_url" nil)))
      (if (nil? explicit)
          (str "https://github.com/" (Collection/get source :repository "")
               "/issues/" (get record "number"))
        explicit)))

  (defun normalize-issue (source record identity-urls)
    (let* ((number (get record "number"))
           (repository (Collection/get source :repository ""))
           (path (str repository "#" number))
           (body (get record "body" ""))
           (fields (issue-fields body path))
           (title (require-field fields "title" path))
           (slug-field (field fields "slug" nil))
           (published (date-value (field fields "date" (get record "created_at" ""))))
           (updated-raw (field fields "updated" nil)))
      (->Post (require-field fields "id" path)
              (if (nil? slug-field) (slugify title) slug-field)
              title
              (field fields "description" "")
              (render-markdown (issue-markdown body))
              published
              (if (nil? updated-raw) published (date-value updated-raw))
              [(get (get record "user") "login" "unknown")]
              (parse-list (field fields "tags" ""))
              nil
              (= (field fields "draft" "false") "true")
              (parse-integer (field fields "pinned" "0") 0)
              {:provider "issues"
               :path path
               :url (issue-url source record)
               :revision (get record "updated_at" "")}
              (parse-list (field fields "aliases" ""))
              [])))

  ;; -------------------------------------------------------------- provider

  ;; The provider result separates what published, what was rejected, and how
  ;; many carriers were recognised, so the build report can account for every
  ;; remote record without exposing a rejected body.
  (defasync collect-issues (options)
    (let* ((source (Collection/get options :source))
           (publishing (Collection/get options :publishing))
           (adapters (Collection/get options :adapters []))
           (identities (Collection/get options :identities []))
           (transport (Collection/get options :transport))
           (publishers (publisher-set publishing))
           (records (await (fetch-issues transport (issue-list-url source))))
           (posts [])
           (carriers 0)
           (unauthorized 0)
           (index 0))
      (while (< index (Collection/count records))
        (let* ((record (Collection/nth records index))
               (body (get record "body" ""))
               (author (get record "user" (js-object))))
          (cond
            ;; Pull requests share the issue endpoint and are never articles.
            ((get record "pull_request" nil) nil)
            ;; Carrier classification precedes every article filter.
            ((not (nil? (carrier-adapter adapters author body identities)))
             (setq carriers (1+ carriers)))
            ;; Repository association and labels never grant authority.
            ((authorized-author? publishers author)
             (setq posts (Collection/conj posts (normalize-issue source record identities))))
            (t (setq unauthorized (1+ unauthorized)))))
        (setq index (1+ index)))
      {:posts posts
       :carriers carriers
       :unauthorized unauthorized
       :records (Collection/count records)}))

  (export authorized-author? carrier-adapter collect-issues fetch-issues
          identity-after issue-fields issue-markdown next-link normalize-issue
          normalize-login publisher-matches? publisher-set))
