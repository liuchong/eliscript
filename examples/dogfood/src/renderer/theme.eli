;; Theme and document shell.
;;
;; Specification 0006 asks for an editorial surface rather than a landing page:
;; near-black and paper-white structure, restrained green for source and
;; success states, amber for freshness, red only for errors, a modern sans
;; interface face, a serif article face, monospace metadata, zero letter
;; spacing, and an 8px maximum corner radius. The shell is written here so the
;; renderer owns presentation and the builder never emits a page fragment.

(module dogfood.renderer.theme
  (import "eliscript/runtime/core/collection.mjs" :as Collection)
  (import "../support/sanitize.eli" escape-html)

  (defconst site-css
    (str
     ":root{--ink:#16181d;--paper:#fbfaf7;--muted:#5f646e;"
     "--line:#e2ded6;--accent:#2f6f4f;--fresh:#9a6b12;--error:#a32c22;"
     "--sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",sans-serif;"
     "--serif:Georgia,\"Songti SC\",\"Noto Serif\",serif;"
     "--mono:ui-monospace,SFMono-Regular,Menlo,monospace}\n"
     "@media (prefers-color-scheme:dark){:root:not([data-theme=light]){--ink:#eceae5;--paper:#14161a;"
     "--muted:#9aa0ab;--line:#2c3037;--accent:#7fb495;--fresh:#d3a44c;--error:#e0796c}}\n"
     ":root[data-theme=dark]{--ink:#eceae5;--paper:#14161a;--muted:#9aa0ab;--line:#2c3037;--accent:#7fb495;--fresh:#d3a44c;--error:#e0796c}\n"
     ".theme-toggle{font:inherit;font-size:14px;color:var(--muted);background:none;border:1px solid var(--line);border-radius:8px;padding:3px 10px;cursor:pointer}\n"
     ".theme-toggle:hover{color:var(--ink);border-color:var(--ink)}\n"
     ".search-form{display:flex;gap:8px;align-items:center}\n"
     ".preview-banner{margin:0;padding:8px 24px;background:var(--fresh);color:#1b1d22;font-size:14px;text-align:center}\n"
     ".search-form input{font:inherit;font-size:15px;padding:6px 12px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink);min-width:220px}\n"
     "*{box-sizing:border-box}\n"
     "html{-webkit-text-size-adjust:100%}\n"
     "body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);"
     "font-size:17px;line-height:1.6;letter-spacing:0}\n"
     "a{color:var(--accent);text-decoration:none}\n"
     "a:hover{text-decoration:underline}\n"
     ".skip{position:absolute;left:-9999px}\n"
     ".skip:focus{left:12px;top:12px;background:var(--paper);padding:8px 12px;"
     "border:1px solid var(--line);border-radius:8px;z-index:5}\n"
     ".masthead{display:flex;flex-wrap:wrap;gap:16px;align-items:baseline;"
     "justify-content:space-between;max-width:1040px;margin:0 auto;"
     "padding:28px 24px 18px;border-bottom:1px solid var(--line)}\n"
     ".wordmark{font-weight:650;font-size:19px;color:var(--ink)}\n"
     ".masthead nav{display:flex;flex-wrap:wrap;gap:18px;font-size:15px;color:var(--muted)}\n"
     "main{max-width:1040px;margin:0 auto;padding:36px 24px 72px}\n"
     ".article{max-width:44rem}\n"
     ".article h1{font-family:var(--serif);font-size:34px;line-height:1.25;margin:0 0 12px}\n"
     ".article h2{font-family:var(--serif);font-size:24px;margin:36px 0 10px}\n"
     ".article h3{font-family:var(--serif);font-size:20px;margin:28px 0 8px}\n"
     ".lede{font-size:18px;color:var(--muted);margin:0 0 18px}\n"
     ".meta{font-family:var(--mono);font-size:13px;color:var(--muted);"
     "display:flex;flex-wrap:wrap;gap:6px 14px;margin:0 0 26px}\n"
     ".meta .tag{border:1px solid var(--line);border-radius:8px;padding:1px 7px}\n"
     ".provenance{font-family:var(--mono);font-size:12.5px;color:var(--fresh)}\n"
     ".article p{margin:0 0 18px}\n"
     ".article ul,.article ol{margin:0 0 18px;padding-left:22px}\n"
     ".article li{margin:4px 0}\n"
     ".article blockquote{margin:0 0 18px;padding:2px 0 2px 16px;"
     "border-left:3px solid var(--line);color:var(--muted)}\n"
     ".article pre{background:#1c1f24;color:#e8e6e1;padding:14px 16px;"
     "border-radius:8px;overflow-x:auto;font-family:var(--mono);font-size:14px}\n"
     ".article code{font-family:var(--mono);font-size:0.92em}\n"
     ".article :not(pre) > code{background:var(--line);padding:1px 5px;border-radius:5px}\n"
     ".article hr{border:0;border-top:1px solid var(--line);margin:32px 0}\n"
     ".list{list-style:none;padding:0;margin:0;display:grid;gap:14px}\n"
     ".list li{border:1px solid var(--line);border-radius:8px;padding:16px 18px;"
     "max-width:44rem}\n"
     ".list a.title{font-family:var(--serif);font-size:20px}\n"
     ".list .summary{margin:6px 0 0;color:var(--muted)}\n"
     ".crumbs{font-size:14px;color:var(--muted);margin:0 0 20px}\n"
     ".empty{color:var(--muted)}\n"
     "footer{max-width:1040px;margin:0 auto;padding:24px;border-top:1px solid var(--line);"
     "color:var(--muted);font-family:var(--mono);font-size:13px}\n"
     ".comments{margin-top:34px;border-top:1px solid var(--line);padding-top:20px}\n"
     ".comments h2{font-family:var(--serif);font-size:20px;margin:0 0 4px}\n"
     ".comments-list{list-style:none;padding:0;margin:14px 0 0;display:grid;gap:12px}\n"
     ".comment{border:1px solid var(--line);border-radius:8px;padding:12px 14px;"
     "max-width:44rem}\n"
     ".comment .meta{display:flex;flex-wrap:wrap;gap:4px 12px;margin-bottom:8px;"
     "font-family:var(--mono);font-size:12px;color:var(--muted)}\n"
     ".comment-author{font-weight:600;color:var(--ink)}\n"
     ".comment-body p{margin:0 0 10px}\n"
     ".comment-body p:last-child{margin-bottom:0}\n"
     ".comment-note{color:var(--muted);font-size:14px}\n"
     ".comment-replies{margin-top:12px;border-left:2px solid var(--line);padding-left:12px;gap:10px}\n"
     ".embed-region{min-height:180px;height:auto;contain:layout style;border:1px dashed var(--line);border-radius:8px;padding:14px;color:var(--muted);font-size:14px;overflow-wrap:anywhere}\n"
     ;; A long source name or a control label must never widen its container.
     ".meta,.meta .tag,.provenance,.crumbs,.comment .meta{overflow-wrap:anywhere;min-width:0}\n"
     ".masthead>*{min-width:0}\n"
     "a:focus-visible,button:focus-visible,summary:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}\n"
     "@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:0.01ms !important;animation-iteration-count:1 !important;transition-duration:0.01ms !important;scroll-behavior:auto !important}}\n"
     ;; Wide screens keep the navigation inline; the disclosure is not rendered
     ;; at all there, so the markup never adds a control it does not need.
     ;; The disclosure ships open, so a browser that hides a closed one cannot
     ;; hide the navigation from a wide layout. Below the breakpoint the browser
     ;; bundle closes it before the first paint, and a reader without JavaScript
     ;; gets the links expanded rather than missing.
     "@media (min-width:601px){.menu{display:contents}.menu>summary{display:none}"
     ".menu>nav{display:flex}}\n"
     "@media (max-width:600px){.article h1{font-size:28px}main{padding:28px 18px 56px}"
     ".masthead{padding:20px 18px 14px}.menu{width:100%}"
     ".menu>summary{display:block;font-size:15px;color:var(--muted);cursor:pointer;padding:6px 0}"
     ".menu>nav{flex-direction:column;gap:12px;padding:10px 0 2px}"
     "html[data-menu=collapsed] .menu>nav{display:none}}\n"))

  (defun home-href (root)
    (if (= root "") "./" root))

  ;; Below the breakpoint the secondary navigation becomes a disclosure, so the
  ;; links stay reachable on a narrow screen without pushing the wordmark out of
  ;; the header. Above it the same markup renders inline.
  (defun nav-links (root)
    (str "<details class=\"menu\" open><summary>Menu</summary>"
         "<nav aria-label=\"site\">"
         "<a href=\"" root "archive/\">Archive</a>"
         "<a href=\"" root "tags/\">Tags</a>"
         "<a href=\"" root "search/\">Search</a>"
         "<a href=\"" root "feed.xml\">Feed</a>"
         "<a href=\"https://github.com/\">GitHub</a>"
         ;; The browser bundle labels this control once it has run; the label
         ;; here keeps the page usable with JavaScript disabled.
         "<button id=\"theme-toggle\" class=\"theme-toggle\" type=\"button\""
         " title=\"Switch the colour theme\">Theme</button>"
         "</nav></details>"))

  (defun document (site root title description content)
    (let ((site-title (Collection/get site :title "dogfood"))
          (language (Collection/get site :language "en"))
          (preview (Collection/get site :preview false)))
      (str
       "<!doctype html>\n"
       "<html lang=\"" (escape-html language) "\">\n"
       "<head>\n"
       "<meta charset=\"utf-8\">\n"
       "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
       "<title>" (escape-html title) "</title>\n"
       "<meta name=\"description\" content=\"" (escape-html description) "\">\n"
       ;; The browser bundle reads its own configuration from these, and the
       ;; search index it fetches is a site-relative URL.
       (if preview "<meta name=\"robots\" content=\"noindex\">\n" "")
       "<meta name=\"dogfood-search-index\" content=\"" root "search.json\">\n"
       "<meta name=\"dogfood-root\" content=\"" root "\">\n"
       ;; A classic head script applies the stored theme before the first
       ;; paint; a module script would flash the wrong theme.
       "<script src=\"" root "assets/browser.js\"></script>\n"
       "<link rel=\"stylesheet\" href=\"" root "assets/site.css\">\n"
       "<link rel=\"alternate\" type=\"application/atom+xml\" href=\"" root
       "feed.xml\" title=\"" (escape-html site-title) "\">\n"
       "</head>\n<body>\n"
       "<a class=\"skip\" href=\"#main\">Skip to content</a>\n"
       "<header class=\"masthead\">\n"
       "<a class=\"wordmark\" href=\"" (home-href root) "\">"
       (escape-html site-title) "</a>\n"
       (nav-links root) "\n"
       "</header>\n"
       (if preview
           (str "<p class=\"preview-banner\">Preview build: drafts are included and"
                " this page must not be indexed.</p>\n")
         "")
       "<main id=\"main\">\n" content "\n</main>\n"
       "<footer>Built with Eliscript from the repository and its published Markdown.</footer>\n"
       "</body>\n</html>\n")))

  (export site-css document nav-links home-href))
