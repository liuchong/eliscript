;; Site browser entry.
;;
;; Specification 0006 asks for a local search index, light/dark/system themes
;; with no flash of the wrong theme, and islands that never block first content
;; paint. This module owns all three.
;;
;; It is compiled and bundled into one classic script that the shell loads from
;; the document head, before the first paint, so the stored theme is applied
;; before anything renders. A module script would run after parse and flash the
;; wrong theme, so the bundle is deliberately not a module.
;;
;; The bundle reads its configuration from meta elements the renderer emits,
;; because a bundled script has no module URL to resolve against. It needs no
;; import map: the package specifiers below are bundled away.

(module dogfood.renderer.browser
  (import "eliscript/platform/browser.mjs"
          browserCapabilities browserDocument browserSetTimeout)

  ;; Text operations on native strings. The portable text library reaches the
  ;; collection runtime through its facade, which would pull the whole protocol
  ;; stack into a bundle that only searches a JSON index.
  (defun to-lowercase (text) (js-call text :toLowerCase))

  (defun trim-text (text) (js-call text :trim))

  (defun contains? (needle text) (js-call text :includes needle))

  (defun blank? (text) (= (js-length (trim-text text)) 0))

  (defun split-on (separator text) (js-call text :split separator))

  (defconst theme-key "dogfood-theme")
  (defconst result-limit 25)
  (defconst search-delay 80)

  ;; Storage is not one of the grants in specification 0126, so it is reached
  ;; through explicit interop rather than through a capability token.
  (defconst storage
    (js* "(typeof localStorage === 'undefined' ? null : localStorage)"))

  (defconst capabilities
    (browserCapabilities (js* "globalThis") (js-array "document" "network" "timers")))
  (defconst page (browserDocument capabilities))

  (defvar index-value nil)

  (defun node (id) (js-call page :getElementById id))

  (defun root () (get page "documentElement"))

  (defun meta-content (name)
    (let ((element (js-call page :querySelector (str "meta[name=\"" name "\"]"))))
      (if (nil? element) "" (get element "content" ""))))

  ;; ------------------------------------------------------------------ theme

  (defun stored-theme ()
    (if (nil? storage)
        "system"
      (let ((value (js-call storage :getItem theme-key)))
        (if (or (nil? value) (= value "")) "system" value))))

  (defun apply-theme (name)
    (if (= name "system")
        (js-call (root) :removeAttribute "data-theme")
      (js-call (root) :setAttribute "data-theme" name)))

  (defun next-theme (name)
    (cond
      ((= name "system") "light")
      ((= name "light") "dark")
      (t "system")))

  (defun remember-theme (name)
    (when (not (nil? storage)) (js-call storage :setItem theme-key name)))

  (defun label-theme (name)
    (let ((button (node "theme-toggle")))
      (when (not (nil? button))
        (put button "textContent" (str "Theme: " name))
        (js-call button :setAttribute "aria-label"
                 (str "Theme " name ", switch to " (next-theme name))))))

  (defun toggle-theme ()
    (let ((next (next-theme (stored-theme))))
      (remember-theme next)
      (apply-theme next)
      (label-theme next)))

  ;; ----------------------------------------------------------------- search

  (defasync load-index ()
    (when (nil? index-value)
      (let* ((url (meta-content "dogfood-search-index"))
             (response (await (js-call (js* "globalThis") :fetch url))))
        (unless (get response "ok" false)
          (throw (new (js* "globalThis.Error")
                      (str "search index unavailable: " url))))
        (setq index-value (await (js-call response :json)))))
    index-value)

  (defun entry-haystack (entry)
    (to-lowercase
      (str (get entry "title" "") " " (get entry "summary" "") " "
           (get entry "text" "") " "
           (js-call (js-array) :concat (get entry "tags" (js-array))))))

  (defun matches? (entry query)
    (let ((haystack (entry-haystack entry))
          (terms (split-on " " query))
          (index 0)
          (found t))
      (while (< index (js-length terms))
        (let ((term (trim-text (js-nth index terms))))
          (when (and (not (blank? term)) (not (contains? term haystack)))
            (setq found false)))
        (setq index (1+ index)))
      found))

  (defun matching-entries (entries query)
    (let ((results (js-array))
          (index 0))
      (while (and (< index (js-length entries))
                  (< (js-length results) result-limit))
        (let ((entry (js-nth index entries)))
          (when (matches? entry query)
            (js-call results :push entry)))
        (setq index (1+ index)))
      results))

  ;; Text from the index and from the query reaches the document, so it is
  ;; escaped by construction rather than by filtering.
  (defun escape-text (text)
    (let ((element (js-call page :createElement "span")))
      (put element "textContent" text)
      (get element "innerHTML" "")))

  (defun render-entry (entry)
    (str "<li><a class=\"title\" href=\"" (escape-text (get entry "url" "")) "\">"
         (escape-text (get entry "title" "")) "</a>"
         "<p class=\"summary\">" (escape-text (get entry "summary" "")) "</p></li>"))

  (defun render-results (entries query)
    (let ((container (node "search-results")))
      (when (not (nil? container))
        (if (blank? query)
            (put container "innerHTML" "")
          (let ((count-value (js-length entries)))
            (put container "innerHTML"
                 (str "<p class=\"comment-note\">" count-value
                      (if (= count-value 1) " result" " results")
                      " for \"" (escape-text query) "\"</p>"
                      (if (= count-value 0)
                          "<p class=\"empty\">No article matches.</p>"
                        (let ((markup "<ul class=\"list\">")
                              (index 0))
                          (while (< index count-value)
                            (setq markup (str markup
                                              (render-entry (js-nth index entries))))
                            (setq index (1+ index)))
                          (str markup "</ul>"))))))))))

  (defun read-query ()
    (let ((parameters (new (js* "globalThis.URLSearchParams")
                           (get (js* "globalThis.location") "search"))))
      (js-call parameters :get "q")))

  (defun query-value ()
    (let ((element (node "search-input")))
      (if (nil? element)
          ""
        (let ((value (get element "value" nil)))
          (if (nil? value) (or (read-query) "") value)))))

  (defun search-once ()
    (js-call (run-search) :catch
             (lambda (error)
               (let ((container (node "search-results")))
                 (when (not (nil? container))
                   (put container "innerHTML"
                        (str "<p class=\"empty\">" (escape-text (get error "message" ""))
                             "</p>")))))))

  (defasync run-search ()
    (let ((input (node "search-input")))
      (when (not (nil? input))
        (put input "value" (query-value))
        (let* ((index (await (load-index)))
               (entries (get index "entries" (js-array))))
          (render-results (matching-entries entries (query-value)) (query-value))
          (js-call input :addEventListener
                   "input"
                   (lambda (event)
                     (funcall browserSetTimeout
                              capabilities
                              (lambda ()
                                (render-results
                                  (matching-entries entries (query-value))
                                  (query-value)))
                              search-delay))))))))

  ;; ------------------------------------------------------------ navigation

  ;; The header's secondary navigation is a disclosure that ships open, so a
  ;; wide layout always shows the links. Below the breakpoint it is closed
  ;; before the first paint; without this script the links stay expanded, which
  ;; is readable rather than missing.
  (defconst menu-breakpoint 600)
  ;; A function value is called with `funcall`: `js-call` with a receiver path
  ;; is method invocation, and a two-argument call through it lowers to a
  ;; property lookup on the function itself.
  (defconst set-menu-marker
    (js* "((value) => { document.documentElement.setAttribute('data-menu', value); })"))
  (defconst clear-menu-marker
    (js* "(() => { document.documentElement.removeAttribute('data-menu'); })"))

  (defun narrow? () (not (> (js* "globalThis.innerWidth") menu-breakpoint)))

  ;; The header is not parsed yet when this runs, so the decision is recorded on
  ;; the document element, where the stylesheet applies it as the header
  ;; arrives. That keeps a narrow screen from showing the links and then hiding
  ;; them, and it leaves the wide layout alone.
  (defun mark-menu-state ()
    (if (narrow?) (funcall set-menu-marker "collapsed") (funcall clear-menu-marker)))

  ;; Once the header exists, the element's own state has to agree with what is
  ;; on screen: a narrow screen closes the disclosure so the first press opens
  ;; it, and a wide one opens it so the links are present even after a resize
  ;; from narrow. The disclosure's state is then the source of truth.
  (defconst set-open (js* "((element, value) => { element.open = value; })"))

  (defun bind-menu ()
    (let ((menu (js* "document.querySelector('.menu')")))
      (when (not (nil? menu))
        (funcall set-open menu (not (narrow?)))
        (js-call menu :addEventListener
                 "toggle"
                 (lambda (event)
                   (if (and (narrow?) (not (get menu "open")))
                       (funcall set-menu-marker "collapsed")
                     (funcall clear-menu-marker)))))))

  ;; ------------------------------------------------------- comment freshness

  ;; A hybrid channel ships a snapshot and asks the reader's browser how much
  ;; has changed since it was captured. Only the count and the newest date are
  ;; read: the snapshot body stays the server's markup, and the provider link
  ;; is one click away.

  (defconst comment-endpoint
    (js* "((kind, binding) => { const [repository, number] = binding.split('#'); const path = kind === 'discussion' ? 'discussions' : 'issues'; return `https://api.github.com/repos/${repository}/${path}/${number}/comments?per_page=100`; })"))

  (defconst set-text
    (js* "((element, value) => { element.textContent = value; })"))

  (defun refresh-notes ()
    (js* "Array.from(document.querySelectorAll('[data-comment-refresh]'))"))

  (defun verdict-element (note) (js-call note :querySelector ".refresh-verdict"))

  (defasync report-freshness (note url)
    (let ((verdict (verdict-element note)))
      (when (not (nil? verdict))
        (try
          (let* ((response (await (js-call (js* "globalThis")
                                          :fetch
                                          url
                                          (js-object
                                            :headers (js-object
                                                       :accept "application/vnd.github+json")))))
                 ;; `ok` is a property of the response, not a method on it.
                 (payload (if (get response "ok")
                              (await (js-call response :json))
                            (js-array))))
            (if (js-call (js* "Array") :isArray payload)
                (let ((before (js-call note :getAttribute "data-comment-count"))
                      (now (js-length payload)))
                  (funcall set-text
                           verdict
                           (if (> now (parse-count before))
                               (str " " now " comments now; " before
                                    " when this snapshot was taken.")
                             (str " " now " comments; this snapshot is current."))))
              (funcall set-text verdict " Newer comments could not be checked.")))
          (catch error
            (funcall set-text verdict " Newer comments could not be checked."))))))

  (defun parse-count (value)
    (let ((parsed (js* "Number.parseInt")))
      (if (nil? value) 0 (funcall parsed value 10))))

  (defasync refresh-comment-freshness ()
    (let* ((notes (refresh-notes))
           (index 0))
      (while (< index (js-length notes))
        (let* ((note (js-nth index notes))
               (binding (js-call note :getAttribute "data-comment-binding"))
               (kind (js-call note :getAttribute "data-comment-kind")))
          (when (not (blank? binding))
            (await (report-freshness
                     note
                     (funcall comment-endpoint kind binding)))))
        (setq index (1+ index)))))

  ;; --------------------------------------------------------------- bootstrap

  ;; Applied before the first paint: this script is classic and in the head.
  (apply-theme (stored-theme))
  (mark-menu-state)

  (defun on-ready ()
    (let ((button (node "theme-toggle")))
      (when (not (nil? button))
        (label-theme (stored-theme))
        (js-call button :addEventListener
                 "click"
                 (lambda (event)
                   (js-call event :preventDefault)
                   (toggle-theme)))))
    ;; A reader who rotates a tablet or resizes a window crosses the
    ;; breakpoint without a reload.
    (bind-menu)
    ;; Freshness is checked after the article is on screen and never blocks it.
    (js-call (js* "globalThis") :addEventListener
             "load" (lambda (event) (refresh-comment-freshness)))
    (js-call (js* "globalThis") :addEventListener
             "resize" (lambda (event) (bind-menu)))
    (search-once))

  (if (= (get (js* "globalThis.document") "readyState") "loading")
      (js-call (js* "globalThis.document") :addEventListener
               "DOMContentLoaded" (lambda (event) (on-ready)))
    (on-ready))
