;; Static document renderer.
;;
;; The renderer accepts only the canonical model from specification 0003 and
;; owns every public presentation decision. It cannot read the filesystem,
;; environment, or network, and it never emits an ad hoc fragment: the builder
;; writes the documents this module returns.

(module dogfood.renderer.server
  (import "eliscript/runtime/core/collection.mjs" :as Collection)
  (import "eliscript/runtime/core/sequence.mjs" :as Sequence)
  (import "eliscript/runtime/core/order.mjs" :as Order)
  (import "eliscript/runtime/core/text.mjs" blank)
  (import "../support/text.eli" index-of slice slugify strip-tags text-length)
  (import "../support/sanitize.eli" escape-html)
  (import "./theme.eli" site-css document)

  (defconst recent-limit 12)
  (defconst to-native-array (js* "(value) => Array.from(value)"))

  ;; ------------------------------------------------------------- model reads

  (defun compare-posts (left right)
    (let ((left-pinned (get left :pinned-weight))
          (right-pinned (get right :pinned-weight)))
      (cond
        ((not (= left-pinned right-pinned))
         (if (> left-pinned right-pinned) -1 1))
        ((not (= (get left :published-at) (get right :published-at)))
         (if (> (get left :published-at) (get right :published-at)) -1 1))
        ((= (get left :id) (get right :id)) 0)
        ((< (get left :id) (get right :id)) -1)
        (t 1))))

  (defun sort-posts (posts) (Order/sort compare-posts posts))

  (defun site-value (site key fallback)
    (Collection/get site key fallback))

  (defun absolute-url (site path)
    (str (site-value site :base-url "/") path))

  (defun append-all (target values)
    (Collection/reduce values
                       (lambda (accumulator value)
                         (Collection/conj accumulator value))
                       target))

  ;; ------------------------------------------------------------------ pieces

  (defun render-tag-links (root post)
    (let ((tags (get post :tags))
          (result "")
          (index 0))
      (while (< index (Collection/count tags))
        (let ((tag (Collection/nth tags index)))
          (setq result
                (str result "<a class=\"tag\" href=\"" root "tags/"
                     (slugify tag) "/\">" (escape-html tag) "</a>")))
        (setq index (1+ index)))
      result))

  (defun render-card (root post)
    (let ((summary (get post :summary)))
      (str "<li><a class=\"title\" href=\"" root "posts/" (get post :slug) "/\">"
           (escape-html (get post :title)) "</a>"
           (if (blank summary)
               ""
             (str "<p class=\"summary\">" (escape-html summary) "</p>"))
           "<div class=\"meta\"><span>" (escape-html (get post :published-at)) "</span>"
           (render-tag-links root post)
           "</div></li>")))

  (defun render-post-list (root posts)
    (let ((items "")
          (index 0))
      (while (< index (Collection/count posts))
        (setq items (str items (render-card root (Collection/nth posts index)))
              index (1+ index)))
      (str "<ul class=\"list\">" items "</ul>")))

  (defun section (heading content)
    (if (blank content)
        ""
      (str "<h2>" (escape-html heading) "</h2>" content)))

  (defun tagged? (post tag)
    (let ((tags (get post :tags))
          (index 0)
          (found false))
      (while (and (< index (Collection/count tags)) (not found))
        (when (= (Collection/nth tags index) tag)
          (setq found t))
        (setq index (1+ index)))
      found))

  (defun posts-with-tag (tag posts)
    (Sequence/filter (lambda (post) (tagged? post tag)) posts))

  (defun collect-tags (posts)
    (let ((seen {})
          (tags [])
          (index 0))
      (while (< index (Collection/count posts))
        (let* ((post-tags (get (Collection/nth posts index) :tags))
               (tag-index 0))
          (while (< tag-index (Collection/count post-tags))
            (let ((tag (Collection/nth post-tags tag-index)))
              (unless (Collection/get seen tag false)
                (setq seen (Collection/assoc seen tag t)
                      tags (Collection/conj tags tag))))
            (setq tag-index (1+ tag-index))))
        (setq index (1+ index)))
      (Order/sort tags)))

  ;; ------------------------------------------------------------------- pages

  (defun render-home (site posts)
    (let* ((recent (Sequence/take recent-limit posts))
           (description (site-value site :description "")))
      {:path "index.html"
       :content
       (document site ""
                 (site-value site :title "dogfood")
                 description
                 (str "<div class=\"article\">"
                      "<h1>" (escape-html (site-value site :title "dogfood")) "</h1>"
                      (if (blank description)
                          ""
                        (str "<p class=\"lede\">" (escape-html description) "</p>"))
                      "</div>"
                      (section "Recent writing" (render-post-list "" recent))))}))

  (defun render-archive (site posts)
    {:path "archive/index.html"
     :content
     (document site "../" "Archive"
               "Every published article in date order."
               (str "<div class=\"article\"><h1>Archive</h1>"
                    "<p class=\"crumbs\"><a href=\"../\">Home</a></p></div>"
                    (render-post-list "../" posts)))})

  (defun neighbour-link (root label post)
    (if (nil? post)
        ""
      (str "<a href=\"" root "posts/" (get post :slug) "/\">" (escape-html label)
           ": " (escape-html (get post :title)) "</a>")))

  (defun render-neighbours (root posts position)
    (let ((newer (if (> position 0) (Collection/nth posts (- position 1)) nil))
          (older (if (< position (- (Collection/count posts) 1))
                     (Collection/nth posts (+ position 1))
                   nil)))
      (if (and (nil? newer) (nil? older))
          ""
        (str "<nav class=\"crumbs\" aria-label=\"article\">"
             (neighbour-link root "Newer" newer)
             (if (and (not (nil? newer)) (not (nil? older))) " · " "")
             (neighbour-link root "Older" older)
             "</nav>"))))

  (defun render-post-page (site post posts position)
    (let* ((root "../../")
           (slug (get post :slug))
           (updated (get post :updated-at))
           (summary (get post :summary))
           (source-path (Collection/get (get post :provenance) :path "")))
      {:path (str "posts/" slug "/index.html")
       :content
       (document site root
                 (get post :title)
                 summary
                 (str "<article class=\"article\">"
                      (render-neighbours root posts position)
                      "<h1>" (escape-html (get post :title)) "</h1>"
                      (if (blank summary)
                          ""
                        (str "<p class=\"lede\">" (escape-html summary) "</p>"))
                      "<div class=\"meta\"><span>" (escape-html (get post :published-at))
                      "</span>"
                      (if (= updated (get post :published-at))
                          ""
                        (str "<span>updated " (escape-html updated) "</span>"))
                      (render-tag-links root post) "</div>"
                      (get post :body)
                      "<hr>"
                      "<p class=\"provenance\">Markdown · " (escape-html source-path)
                      " · <a href=\"" root "archive/\">archive</a></p>"
                      (render-comment-channels post)
                      "</article>"))}))

  ;; Specification 0003: a changed slug keeps the previous route as an alias,
  ;; and the generator emits a redirect document that needs no JavaScript.
  (defun render-alias-page (site post alias)
    (let ((slug (get post :slug))
          (title (get post :title)))
      {:path (str "posts/" alias "/index.html")
       :content
       (str "<!doctype html>\n"
            "<html lang=\"" (escape-html (site-value site :language "en")) "\">\n"
            "<head>\n<meta charset=\"utf-8\">\n"
            "<meta http-equiv=\"refresh\" content=\"0; url=../" (escape-html slug) "/\">\n"
            "<meta name=\"robots\" content=\"noindex\">\n"
            "<link rel=\"canonical\" href=\""
            (escape-html (absolute-url site (str "posts/" slug "/"))) "\">\n"
            "<title>" (escape-html title) "</title>\n"
            "</head>\n<body>\n<p>This page moved to "
            "<a href=\"../" (escape-html slug) "/\">" (escape-html title) "</a>.</p>\n"
            "</body>\n</html>\n")}))

  (defun alias-documents (site posts)
    (let ((documents [])
          (index 0))
      (while (< index (Collection/count posts))
        (let* ((post (Collection/nth posts index))
               (aliases (get post :aliases))
               (alias-index 0))
          (while (< alias-index (Collection/count aliases))
            (setq documents
                  (Collection/conj documents
                                   (render-alias-page
                                     site post (Collection/nth aliases alias-index)))
                  alias-index (1+ alias-index))))
        (setq index (1+ index)))
      documents))

  ;; ------------------------------------------------------------- comments

  ;; A keyword prints with its leading colon, which belongs in source and not
  ;; in a page.
  (defun display-name (value)
    (let ((text (str value)))
      (if (= (slice 0 1 text) ":") (slice 1 (text-length text) text) text)))

  ;; A native channel is served by GitHub, and the page says so rather than
  ;; printing the declaration's kind.
  (defun provider-label (kind)
    (cond
      ((= kind :issue) "GitHub Issues")
      ((= kind :discussion) "GitHub Discussions")
      (t (display-name kind))))

  (defun channel-binding (channel)
    (let ((binding (Collection/get channel :binding nil)))
      (if (nil? binding)
          ""
        (let ((repository (Collection/get binding :repository ""))
              (number (Collection/get binding :number nil)))
          (if (nil? number) repository (str repository "#" number))))))

  ;; The reader is told how old the snapshot is and is given the provider link;
  ;; the browser bundle replaces the second half of this sentence once it has
  ;; asked the provider how much has changed.
  (defun render-refresh-note (channel binding)
    (let* ((kind-name (display-name (Collection/get channel :kind :issue)))
           (snapshot (Collection/get channel :updated-at nil))
           (count-value (Collection/get channel :count 0))
           (posting (provider-thread-url binding)))
      (str "<p class=\"comment-note refresh-note\""
           " data-comment-refresh=\"1\""
           " data-comment-kind=\"" (escape-html kind-name) "\""
           " data-comment-count=\"" (str count-value) "\""
           " data-comment-binding=\"" (escape-html binding) "\""
           (if (blank snapshot)
               ""
             (str " data-comment-snapshot=\"" (escape-html (str snapshot)) "\""))
           ">Snapshot"
           (if (blank snapshot) "" (str " from " (escape-html (str snapshot))))
           (if (> count-value 0) (str " with " count-value " comments") "")
           "."
           (if (blank posting)
               ""
             (str " <a href=\"" (escape-html posting) "\">Read or reply at "
                  (escape-html posting) "</a>."))
           ;; The browser fills this once it has asked the provider how much has
           ;; changed; an empty span claims nothing on its own.
           "<span class=\"refresh-verdict\"></span>"
           "</p>")))

  ;; A binding is `owner/repository#number`; the provider thread is the issue or
  ;; the discussion that number names.
  (defun provider-thread-url (binding)
    (if (blank binding)
        ""
      (let* ((hash (index-of "#" binding))
             (path (if (< hash 0) binding (slice 0 hash binding)))
             (number (if (< hash 0) "" (slice (+ hash 1) (text-length binding) binding))))
        (if (blank number)
            (str "https://github.com/" path)
          (str "https://github.com/" path "/issues/" number)))))

  (defun render-comment-item (comment)
    (let* ((author (Collection/get comment :author {}))
           (login (str (Collection/get author :login "unknown")))
           (url (Collection/get comment :url nil))
           (created (str (Collection/get comment :created-at "")))
           (updated (str (Collection/get comment :updated-at ""))))
      (str "<li class=\"comment\">"
           "<div class=\"meta\"><span class=\"comment-author\">"
           (escape-html login) "</span>"
           "<span>" (escape-html created) "</span>"
           (if (= updated created)
               ""
             (str "<span>updated " (escape-html updated) "</span>"))
           (if (nil? url)
               ""
             (str "<a href=\"" (escape-html url) "\">on GitHub</a>"))
           "</div>"
           "<div class=\"comment-body\">" (Collection/get comment :body "") "</div>"
           ;; A reply tree stays a tree: a reply is nested under its parent
           ;; rather than appended to the parent's stream.
           (let ((replies (Collection/get comment :replies [])))
             (if (= (Collection/count replies) 0)
                 ""
               (str "<ol class=\"comments-list comment-replies\">"
                    (render-reply-items replies) "</ol>")))
           "</li>")))

  (defun render-reply-items (items)
    (let ((markup "")
          (index 0))
      (while (< index (Collection/count items))
        (setq markup (str markup (render-comment-item (Collection/nth items index)))
              index (1+ index)))
      markup))

  (defun render-comment-items (items)
    (let ((markup "")
          (index 0))
      (while (< index (Collection/count items))
        (setq markup (str markup (render-comment-item (Collection/nth items index)))
              index (1+ index)))
      (str "<ol class=\"comments-list\">" markup "</ol>")))

  (defun render-channel-heading (channel)
    (let ((count-value (Collection/get channel :count nil))
          (freshness (Collection/get channel :updated-at nil)))
      (str "<h2>Comments"
           (if (and (not (nil? count-value)) (> count-value 0))
               (str " (" count-value ")")
             "")
           "</h2>"
           (if (blank freshness)
               ""
             (str "<p class=\"comment-note\">Snapshot from "
                  (escape-html (str freshness)) ".</p>")))))

  (defun render-channel (channel)
    (let* ((mode (Collection/get channel :mode :snapshot))
           (kind (Collection/get channel :kind :issue))
           (provider (provider-label kind))
           (binding (channel-binding channel))
           (items (Collection/get channel :items [])))
      (str "<section class=\"comments\" data-comment-provider=\""
           (escape-html provider) "\""
           (if (blank binding)
               ""
             (str " data-comments-binding=\"" (escape-html binding) "\""))
           ">"
           (render-channel-heading channel)
           (cond
             ;; An external adapter owns its own content and its own script.
             ;; The build reserves one isolated region for it and says what to
             ;; do when that provider never arrives, so an embed that fails
             ;; leaves a readable page rather than a shifting one.
             ((or (= mode :embed) (= mode :external))
              (str "<div class=\"embed-region\" data-comment-mount=\""
                   (escape-html provider) "\">"
                   "<p class=\"comment-note\">Comments are provided by "
                   (escape-html provider)
                   ". The browser loads that provider; this build does not"
                   " script it.</p>"
                   (let ((fallback (if (blank binding)
                                       (or (Collection/get channel :provider-url nil) "")
                                     binding)))
                     (if (blank fallback)
                         ""
                       (str "<p class=\"comment-note\">If it does not load, read"
                            " the thread at <a href=\"" (escape-html fallback) "\">"
                            (escape-html fallback) "</a>.</p>")))
                   "</div>"))
             ;; A live channel is deliberately not fetched during a build, so
             ;; the reader is sent to the provider for freshness.
             ((= mode :live)
              (str "<p class=\"comment-note\">"
                   (if (blank binding)
                       "This channel is served live."
                     (str "This thread is served live for " (escape-html binding) "."))
                   " A comment never triggers a build; open the provider to"
                   " read or reply.</p>"))
             ;; A hybrid channel serves its snapshot and asks the browser to
             ;; find out how much has changed since it was captured. The
             ;; snapshot body is not re-rendered there: one renderer owns the
             ;; markup contract, so the browser reports freshness and links to
             ;; the provider rather than producing a second dialect of markup.
             ((= mode :hybrid)
              (str (if (= (Collection/count items) 0)
                       "<p class=\"comment-note\">No comments in this snapshot yet.</p>"
                     (render-comment-items items))
                   (render-refresh-note channel binding)))
             ((= (Collection/count items) 0)
              "<p class=\"comment-note\">No comments in this snapshot.</p>")
             (t (render-comment-items items)))
           "</section>")))

  (defun render-comment-channels (post)
    (let ((channels (Collection/get post :comment-channels)))
      (let ((markup "")
            (index 0))
        (while (< index (Collection/count channels))
          (setq markup (str markup (render-channel (Collection/nth channels index)))
                index (1+ index)))
        markup)))

  (defun render-tag-index (site tags posts)
    (let ((items "")
          (index 0))
      (while (< index (Collection/count tags))
        (let ((tag (Collection/nth tags index)))
          (setq items
                (str items "<li><a class=\"title\" href=\"" (slugify tag) "/\">"
                     (escape-html tag) "</a>"
                     "<div class=\"meta\"><span>"
                     (Collection/count (posts-with-tag tag posts))
                     " articles</span></div></li>")))
        (setq index (1+ index)))
      {:path "tags/index.html"
       :content
       (document site "../" "Tags" "Articles grouped by tag."
                 (str "<div class=\"article\"><h1>Tags</h1>"
                      "<p class=\"crumbs\"><a href=\"../\">Home</a></p></div>"
                      "<ul class=\"list\">" items "</ul>"))}))

  (defun render-tag-page (site tag posts)
    (let ((matching (Sequence/filter (lambda (post) (tagged? post tag)) posts)))
      {:path (str "tags/" (slugify tag) "/index.html")
       :content
       (document site "../../" (str "Tag: " tag)
                 (str "Articles tagged " tag ".")
                 (str "<div class=\"article\"><h1>" (escape-html tag) "</h1>"
                      "<p class=\"crumbs\"><a href=\"../../\">Home</a> · "
                      "<a href=\"../\">Tags</a></p></div>"
                      (render-post-list "../../" matching)))}))

  (defun render-search-page (site)
    {:path "search/index.html"
     :content
     (document site "../" "Search" "Search every published article locally."
               (str "<div class=\"article\"><h1>Search</h1>"
                    "<p class=\"crumbs\"><a href=\"../\">Home</a></p>"
                    "<div class=\"search-form\">"
                    "<label class=\"skip\" for=\"search-input\">Search articles</label>"
                    "<input id=\"search-input\" type=\"search\" autocomplete=\"off\""
                    " placeholder=\"Search title, summary, tags, or text\">"
                    "</div>"
                    "<div id=\"search-results\" aria-live=\"polite\"></div>"
                    "<noscript><p class=\"comment-note\">Search needs JavaScript."
                    " Every article is still reachable from the"
                    " <a href=\"../archive/\">archive</a>.</p></noscript>"
                    "</div>"))})

  (defun render-not-found (site)
    {:path "404.html"
     :content
     (document site "" "Not found" "The requested page does not exist."
               (str "<div class=\"article\"><h1>Not found</h1>"
                    "<p class=\"empty\">That page does not exist. "
                    "<a href=\"./\">Return home</a>.</p></div>"))})

  ;; ---------------------------------------------------------------- metadata

  (defun render-feed (site posts)
    (let ((base (site-value site :base-url "/"))
          (title (site-value site :title "dogfood"))
          (entries "")
          (index 0))
      (while (< index (Collection/count posts))
        (let* ((post (Collection/nth posts index))
               (url (str base "posts/" (get post :slug) "/")))
          (setq entries
                (str entries
                     "<entry><title>" (escape-html (get post :title)) "</title>"
                     "<link href=\"" (escape-html url) "\"/>"
                     "<id>" (escape-html url) "</id>"
                     "<updated>" (escape-html (get post :updated-at))
                     "T00:00:00Z</updated>"
                     "<summary>" (escape-html (get post :summary)) "</summary>"
                     "</entry>"))
          (setq index (1+ index))))
      {:path "feed.xml"
       :content
       (str "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
            "<feed xmlns=\"http://www.w3.org/2005/Atom\">"
            "<title>" (escape-html title) "</title>"
            "<link href=\"" (escape-html base) "\"/>"
            "<id>" (escape-html base) "</id>"
            entries "</feed>\n")}))

  (defun render-sitemap (site posts)
    (let ((urls (str "<url><loc>" (escape-html (absolute-url site "")) "</loc></url>"
                     "<url><loc>" (escape-html (absolute-url site "archive/")) "</loc></url>"
                     "<url><loc>" (escape-html (absolute-url site "tags/")) "</loc></url>"))
          (index 0))
      (while (< index (Collection/count posts))
        (setq urls
              (str urls "<url><loc>"
                   (escape-html
                     (absolute-url site
                                   (str "posts/"
                                        (get (Collection/nth posts index) :slug) "/")))
                   "</loc></url>"))
        (setq index (1+ index)))
      {:path "sitemap.xml"
       :content (str "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n"
                     "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">"
                     urls "</urlset>\n")}))

  ;; Specification 0006: a compact local index of canonical public fields only.
  (defun search-entry (post)
    (js-object :id (get post :id)
               :slug (get post :slug)
               :title (get post :title)
               :summary (get post :summary)
               :tags (funcall to-native-array (get post :tags))
               :authors (funcall to-native-array (get post :authors))
               :url (str "posts/" (get post :slug) "/")
               :text (strip-tags (get post :body))))

  (defun render-search-index (site posts)
    {:path "search.json"
     :content (str (JSON/stringify
                     (js-object :format "dogfood-search"
                                :version 1
                                :entries (funcall to-native-array
                                                  (Sequence/map search-entry posts))))
                   "\n")})

  (defun preview? (site)
    (truthy? (Collection/get site :preview false)))

  ;; The site model carries the flag as `t`, `false`, or nothing at all.
  (defun truthy? (value) (if value t nil))

  ;; A preview tree is reachable from a pull request, so it asks not to be
  ;; crawled at all rather than publishing a sitemap.
  (defun render-preview-robots ()
    {:path "robots.txt"
     :content "User-agent: *\nDisallow: /\n"})

  (defun render-robots (site)
    {:path "robots.txt"
     :content (str "User-agent: *\nAllow: /\nSitemap: "
                   (absolute-url site "sitemap.xml") "\n")})

  ;; ------------------------------------------------------------------- entry

  (defun render-site (site posts)
    (let* ((sorted (sort-posts posts))
           (tags (collect-tags sorted))
           (post-pages [])
           (tag-pages [])
           (documents []))
      (let ((index 0))
        (while (< index (Collection/count sorted))
          (setq post-pages
                (Collection/conj post-pages
                                 (render-post-page site (Collection/nth sorted index)
                                                   sorted index))
                index (1+ index))))
      (let ((index 0))
        (while (< index (Collection/count tags))
          (setq tag-pages
                (Collection/conj tag-pages
                                 (render-tag-page site (Collection/nth tags index) sorted))
                index (1+ index))))
      (setq documents (Collection/conj documents (render-home site sorted)))
      (setq documents (Collection/conj documents (render-archive site sorted)))
      (setq documents (Collection/conj documents (render-tag-index site tags sorted)))
      (setq documents (Collection/conj documents (render-search-page site)))
      (setq documents (Collection/conj documents (render-not-found site)))
      ;; A preview tree carries no feed and no sitemap: it is a review
      ;; surface, not a publication.
      (unless (preview? site)
        (setq documents (Collection/conj documents (render-feed site sorted)))
        (setq documents (Collection/conj documents (render-sitemap site sorted))))
      (setq documents (Collection/conj documents (render-search-index site sorted)))
      (setq documents (Collection/conj documents
                                       (if (preview? site)
                                           (render-preview-robots)
                                         (render-robots site))))
      (setq documents (Collection/conj documents
                                       {:path "assets/site.css" :content site-css}))
      (append-all (append-all (append-all documents post-pages) tag-pages)
                  (alias-documents site sorted))))

  (export render-comment-channels render-site sort-posts))
