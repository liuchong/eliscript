(module example.emacs-index
  (defportable score-document (id terms query-terms)
    (let ((term-index 0)
          (matches 0))
      (while (< term-index (length terms))
        (let ((query-index 0))
          (while (< query-index (length query-terms))
            (when (equal (nth term-index terms)
                         (nth query-index query-terms))
              (setq matches (1+ matches)))
            (setq query-index (1+ query-index))))
        (setq term-index (1+ term-index)))
      (object :id id
              :matches matches
              :terms (length terms)))))
