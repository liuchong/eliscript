(module example.emacs-index
  (import-portable "../../stdlib/data.eli" count-by)

  (defportable score-document (id terms query-terms)
    (let ((frequencies (count-by (lambda (term) term) terms))
          (query-index 0)
          (matches 0))
      (while (< query-index (length query-terms))
        (setq matches
              (+ matches
                 (get frequencies (nth query-index query-terms) 0))
              query-index (1+ query-index)))
      (object :id id
              :matches matches
              :terms (length terms)))))
