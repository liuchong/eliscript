(module example.emacs-analysis
  (import "eliscript/runtime/core/collection.mjs" count)
  (import "eliscript/runtime/core/data.mjs" frequencies)
  (import "eliscript/runtime/core/transducer.mjs"
          composeTransducers filtering into mapping)
  (import "eliscript/runtime/core/vector.mjs" EMPTY_VECTOR)

  (defun iterable-to-array (value)
    (Array/from value))

  (defun map-to-object (value)
    (Object/fromEntries value))

  (defconst token-pattern (new globalThis.RegExp "[A-Za-z0-9_]+" "g"))

  (defun tokenize-text (text)
    (let ((matched (js-call (js-call text :toLowerCase) :match token-pattern)))
      (if (nullish? matched) (js-array) matched)))

  (defun native-frequencies (values)
    (let ((result (new globalThis.Map))
          (index 0))
      (while (< index (js-length values))
        (let* ((value (aref values index))
               (existing (js-call result :get value)))
          (js-call result :set value (+ (if (nullish? existing) 0 existing) 1)))
        (setq index (1+ index)))
      result))

  (defun frequency-count (counts value)
    (let ((existing (js-call counts :get value)))
      (if (nullish? existing) 0 existing)))

  (defconst analysis-index
    (js-object :revision nil :documents (js-array)))

  (defun replace-analysis-index (state documents revision)
    (put state :documents documents)
    (put state :revision revision)
    (js-object :revision revision :documents (js-length documents)))

  (defun indexed-documents (state revision)
    (unless (= (get state :revision) revision)
      (throw (new globalThis.Error
                  (str "analysis index revision mismatch: expected "
                       revision ", found " (get state :revision)))))
    (get state :documents))

  (defun score-document (document query-terms)
    (let* ((terms (tokenize-text (get document "text" "")))
           (counts (native-frequencies terms))
           (query-index 0)
           (matches 0))
      (while (< query-index (js-length query-terms))
        (setq matches
              (+ matches
                 (frequency-count
                  counts
                  (js-nth query-index query-terms)))
              query-index (1+ query-index)))
      (js-object :id (get document "id" nil)
                 :matches matches
                 :terms (js-length terms))))

  (defun search-documents (documents query)
    (let ((query-terms (tokenize-text query)))
      (iterable-to-array
       (into
        EMPTY_VECTOR
        (composeTransducers
         (mapping (lambda (document)
                    (score-document document query-terms)))
         (filtering (lambda (result) (> (get result "matches" 0) 0))))
        documents))))

  (defun document-statistics (documents)
    (iterable-to-array
     (into
      EMPTY_VECTOR
      (mapping
       (lambda (document)
         (let* ((terms (tokenize-text (get document "text" "")))
                (counts (native-frequencies terms)))
           (js-object :id (get document "id" nil)
                      :terms (js-length terms)
                      :uniqueTerms (count counts)))))
      documents)))

  (defun term-frequencies (documents)
    (let ((terms (js-array))
          (document-index 0))
      (while (< document-index (js-length documents))
        (let ((document-terms
               (tokenize-text
                (get (js-nth document-index documents) "text" "")))
              (term-index 0))
          (while (< term-index (js-length document-terms))
            (js-call terms :push (js-nth term-index document-terms))
            (setq term-index (1+ term-index))))
        (setq document-index (1+ document-index)))
      (map-to-object (frequencies terms))))

  (defun cache-documents (documents revision)
    (replace-analysis-index analysis-index documents revision))

  (defun search-index (query revision)
    (search-documents
     (indexed-documents analysis-index revision)
     query))

  (defun statistics-index (revision)
    (document-statistics
     (indexed-documents analysis-index revision)))

  (defun frequencies-index (revision)
    (term-frequencies
     (indexed-documents analysis-index revision)))

  (export cache-documents document-statistics frequencies-index
          search-documents search-index statistics-index term-frequencies))
