(module example.react-counter.browser
  (import "react" StrictMode)
  (import "react-dom/client" createRoot)
  (import "./main.eli" :default Counter)
  (import "../../stdlib/sequence.eli" map)
  (import "./counter.css")
  (import "../../docs/pages/assets/eliscript-logo.png" :default logo-url)

(defconst mount-node (document/getElementById "app"))
(defconst root
  (or (get mount-node :eliscriptRoot)
      (createRoot mount-node)))
(put mount-node :eliscriptRoot root)

(js-call root :render
    (jsx StrictMode nil
      (jsx :main (js-object :className "demo-shell")
        (jsx :header (js-object :className "demo-header")
          (jsx :span (js-object :className "logo-light")
            (jsx :img
              (js-object :className "demo-logo"
                      :src logo-url
                      :alt "Eliscript")))
          (jsx :span (js-object :className "wordmark") "Eliscript")
          (jsx :a
            (js-object :className "source-link"
                    :href "https://github.com/liuchong/eliscript")
            "Source"))
        (jsx :section (js-object :className "intro")
          (jsx :p (js-object :className "eyebrow") "ELISCRIPT / REACT")
          (jsx :h1 nil "A Lisp component, alive in the browser.")
          (jsx :p (js-object :className "lede")
            "Compiled by Emacs, mounted by Vite, rendered by React."))
        (jsx Counter
          (js-object :title "Interactive counter")
          (jsx :p (js-object :className "status")
            "Edit the .eli source and Vite will refresh this module."))
        (jsx :footer (js-object :className "demo-footer")
          (map
            (lambda (label)
              (jsx :span (js-object :key label) label))
            (js-array
              "Automatic JSX runtime"
              "Source Map v3"
              "Portable sequence library")))))))
