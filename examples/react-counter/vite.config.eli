(module examples.react-counter.vite.config
  (import "@vitejs/plugin-react" :default react)
  (import "vite" defineConfig)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath)
  (import "../../tools/vite/index.mjs" eliscript)

  (defconst exampleDirectory (dirname (fileURLToPath (js* "import.meta.url"))))
  (defconst repositoryDirectory (resolve exampleDirectory "../.."))
  (defconst outputDirectory
    (let ((configured (get (get globalThis.process :env) :ELISCRIPT_BUILD_OUT_DIR)))
      (if configured
          (resolve configured)
        (resolve repositoryDirectory "dist/react-counter-browser"))))

  (export-default
    (defineConfig
      (js-object
        :root exampleDirectory
        :plugins (js-array
                   (eliscript)
                   (react (js-object :include (new globalThis.RegExp "\\.(?:[jt]sx?|eli)$"))))
        :server (js-object
                  :port 5173
                  :strictPort t
                  :fs (js-object :allow (js-array repositoryDirectory)))
        :preview (js-object
                   :port 4173
                   :strictPort t)
        :build (js-object
                 :outDir outputDirectory
                 :emptyOutDir t
                 :sourcemap t)))))
