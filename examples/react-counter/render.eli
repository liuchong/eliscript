(module examples.react-counter.render
  (import "react" :default React)
  (import "react-dom/server" renderToStaticMarkup)
  (import "../../dist/react-counter.mjs" :default Counter)

  (defconst markup
    (renderToStaticMarkup
      (js-call React :createElement
               Counter
               (js-object :title "Eliscript counter")
               (js-call React :createElement
                        "span"
                        (js-object :className "status")
                        "Ready"))))

  (js-call globalThis.console :log markup))
