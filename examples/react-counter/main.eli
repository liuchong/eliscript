(module example.react-counter
  (import "react" useState StrictMode)

  (defcomponent Counter (props)
    (let* ((state (useState 0))
           (count (nth 0 state))
           (set-count (nth 1 state)))
      (jsx StrictMode nil
        (jsx :section
          (object :className "counter" :data-count count)
          (jsx :h1 nil (get props :title "Counter"))
          (fragment
            (jsx :button
              (object
                :type "button"
                :onClick (lambda () (set-count (1+ count))))
              "Increment")
            (when (> count 0)
              (jsx :strong nil (str "Count: " count)))
            (get props :children))))))

  (export Counter)
  (export-default Counter))
