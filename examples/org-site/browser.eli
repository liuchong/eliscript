(module example.org-site.browser
  (import "react" useEffect useState StrictMode)
  (import "react-dom/client" createRoot)
  (import "virtual:eliscript-org" articles)
  (import "../../stdlib/sequence.eli" map)
  (import "../../stdlib/text.eli" strip-prefix)
  (import "../../stdlib/object.eli" assoc)
  (import "../../stdlib/data.eli" index-by)
  (import "./site.css")
  (import "../../docs/pages/assets/eliscript-logo.png" :default logo-url)

  (defconst browser-window (js* "window"))
  (defconst articles-by-slug
    (index-by (lambda (article) (get article :slug)) articles))

  (defun article-from-location ()
    (let* ((hash (get window/location :hash ""))
           (slug (strip-prefix "#" hash)))
      (or (get articles-by-slug slug nil)
          (js-nth 0 articles))))

  (defcomponent OrgSite ()
    (let* ((selection-state (useState (article-from-location)))
           (selected (js-nth 0 selection-state))
           (set-selected (js-nth 1 selection-state))
           (sync-selection
            (lambda ()
              (progn
                (set-selected (article-from-location))
                (js-call browser-window :scrollTo
                  (assoc (js-object :top 0) "behavior" "auto")))))
           (effect
            (useEffect
              (lambda ()
                (js-call browser-window :addEventListener
                  "hashchange" sync-selection)
                (lambda ()
                  (js-call browser-window :removeEventListener
                    "hashchange" sync-selection)))
              (js-array))))
      (jsx :main (js-object :className "site-shell")
        (jsx :header (js-object :className "site-header")
          (jsx :a (js-object :className "brand" :href "#")
            (jsx :span (js-object :className "logo-light")
              (jsx :img
                (js-object :className "brand-logo"
                        :src logo-url
                        :alt "Eliscript")))
            (jsx :span (js-object :className "brand-name") "Eliscript"))
          (jsx :span (js-object :className "edition") "ORG EDITION / 2026"))
        (jsx :div (js-object :className "publication")
          (jsx :aside (js-object :className "article-index")
            (jsx :p (js-object :className "index-label") "PUBLISHED NOTES")
            (jsx :ol nil
              (map
                (lambda (article)
                  (let* ((slug (get article :slug))
                         (active
                          (and selected
                               (= slug (get selected :slug)))))
                    (jsx :li (js-object :key slug)
                      (jsx :a
                        (js-object :href (str "#" slug)
                                :className (if active "active" ""))
                        (jsx :time
                          (js-object :dateTime (get article :date))
                          (get article :date))
                      (jsx :span nil (get article :title))))))
                articles))
            (jsx :p (js-object :className "index-note")
              (str (get articles :length) " articles, authored in Org Mode.")))
          (if selected
              (jsx :article (js-object :className "article")
                (jsx :header (js-object :className "article-header")
                  (jsx :div (js-object :className "article-meta")
                    (jsx :time
                      (js-object :dateTime (get selected :date))
                      (get selected :date))
                    (map
                      (lambda (tag)
                        (jsx :span (js-object :key tag :className "tag") tag))
                      (get selected :tags)))
                  (jsx :h1 nil (get selected :title))
                  (jsx :p (js-object :className "description")
                    (get selected :description)))
                (jsx :div
                  (js-object
                    :className "article-body"
                    :dangerouslySetInnerHTML
                    (js-object :__html (get selected :html)))))
            (jsx :p (js-object :className "empty-state")
              "No published articles.")))
        (jsx :footer (js-object :className "site-footer")
          (jsx :span nil "Org Mode source")
          (jsx :span nil "Pure Emacs export")
          (jsx :span nil "Eliscript + React")))))

  (defconst mount-node (document/getElementById "app"))
  (defconst root
    (or (get mount-node :eliscriptRoot)
        (createRoot mount-node)))
  (put mount-node :eliscriptRoot root)
  (js-call root :render
    (jsx StrictMode nil (jsx OrgSite nil))))
