(module example.stdlib-cli
  (import "../../stdlib/sequence.eli" map filter reduce range)
  (import "../../stdlib/text.eli" join strip-prefix trim)
  (import "../../stdlib/object.eli" assoc merge pick)

  (defconst values (range 1 8))
  (defconst profile (js-object :language "Eliscript" :host "Emacs"))
  (defconst result
    (js-object
     :values values
     :squares (map (lambda (value) (* value value)) values)
     :even (filter (lambda (value) (= (% value 2) 0)) values)
     :sum (reduce (lambda (total value) (+ total value)) 0 values)
     :summary (join ", " (map (lambda (value) (str value)) values))
     :slug (strip-prefix "#" "#eliscript")
     :title (trim "  Emacs + JavaScript \n")
     :profile (assoc profile "runtime" "JavaScript")
     :selected (pick (merge profile (js-object :runtime "JavaScript"))
                     (js-array "language" "runtime"))))

  (print (JSON/stringify result))
  (export result))
