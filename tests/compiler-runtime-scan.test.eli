(module tests.compiler-runtime-scan
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (defconst compilerSources (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))

  (import "../tools/compiler/runtime-scan-benchmark.mjs" compilerRuntimeScanSourceDigest validateCompilerRuntimeScanReport)
  (defconst reportPath (resolve projectDirectory "benchmarks/compiler-runtime-scan-macos-arm64.json"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (defun irNode (kind value children properties)
    (let ((node (js-object :kind kind :span nil :value (if (= value undefined) nil value) :children (if (= children undefined) (js-array) children))))
      (unless (= properties undefined) (put node :properties properties)) node))
  (defun expression (node) (irNode "expression-statement" nil (js-array node)))
  (defun literal (value literalKind)
    (irNode "literal" value (js-array) (if (= literalKind undefined) undefined (js-object :literalKind literalKind))))
  (test "optimized compiler runtime scan matches its readable reference" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-runtime-scan-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((modules (await (Promise/all (js-array (loadModule directory "compiler" "runtime-scan") (loadModule directory "emitter" "runtime-scan")))))
               (compiler (aref modules 0)) (emitter (aref modules 1)) (programs (js-array)) (index 0))
          (while (< index (js-length compilerSources))
            (let* ((relative (str "bootstrap/compiler/" (aref compilerSources index) ".eli")) (source (await (readFile (resolve projectDirectory relative) "utf8"))))
              (js-call programs :push (js-call compiler :compile_ir_string source relative)))
            (setq index (1+ index)))
          (let ((allRequirements (js-object :filename "all-runtime-requirements.eli" :body (js-array
            (expression (irNode "persistent-vector-literal" nil (js-array (literal 1))))
            (expression (irNode "intrinsic" "string-to-number" (js-array (literal "0xff"))))
            (expression (irNode "intrinsic" "-" (js-array (literal "0xff") (literal 1))))
            (expression (irNode "intrinsic" "imul32" (js-array (literal 1) (literal 2))))
            (expression (irNode "intrinsic" "host-identity-token" (js-array (irNode "object-literal" nil))))
            (expression (irNode "intrinsic" "length" (js-array (irNode "array-literal" nil))))
            (expression (irNode "intrinsic" "car" (js-array (irNode "persistent-list-literal" nil))))
            (expression (irNode "intrinsic" "equal" (js-array (literal 1) (literal 1))))
            (expression (irNode "method-call" "js-call" (js-array (irNode "reference" "values") (literal "join")))))))
                (staticKeywordProperty (js-object :filename "static-keyword-property.eli" :body (js-array
                  (expression (irNode "property-read" "get" (js-array (irNode "reference" "value")
                    (irNode "literal" "static-key" (js-array (irNode "persistent-vector-literal" nil (js-array (literal 1)))) (js-object :literalKind "keyword")))))))))
            (js-call programs :push allRequirements staticKeywordProperty)
            (js-call programs :forEach (lambda (program) (same (js-call emitter :runtime_requirements program) (js-call emitter :reference_runtime_requirements program))))
            (same (js-call emitter :runtime_requirements allRequirements) (js-object :numericCoercion t :imul t :arrayText t :numberConversion t :hostIdentityToken t :literal t :collection t :list t :value t :binding false :math false :valueType false :primitiveRuntime false))
            (same (js-call emitter :runtime_requirements staticKeywordProperty) (js-object :numericCoercion false :imul false :arrayText false :numberConversion false :hostIdentityToken false :literal false :collection false :list false :value false :binding false :math false :valueType false :primitiveRuntime false))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "committed compiler runtime scan report preserves historical measurements and decisions" (async ()
    (let ((report (validateCompilerRuntimeScanReport (await (readReport)))))
      (js-call (expect (get (get report :corpus) :files)) :toHaveLength (js-length compilerSources))
      (js-call (expect (get (get report :corpus) :sourceBytes)) :toBeGreaterThan 200000)
      (js-call (expect (get (get report :corpus) :irNodes)) :toBeGreaterThan 10000)
      (js-call (expect (get (get report :measurements) :speedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumSpeedup)))))
  (funcall (currentPerformanceTest test) "committed compiler runtime scan report matches measured sources" (async ()
    (same (get (await (readReport)) :sourceDigest) (await (compilerRuntimeScanSourceDigest)))))
)
