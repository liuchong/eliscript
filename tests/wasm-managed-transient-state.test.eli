(module tests.wasm-managed-transient-state.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve posix)
  (import "node:os" tmpdir)
  (import "node:process" :default process)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  ;; Match the complete portable stdlib graph's existing resource contract.
  (defconst options (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
  (defconst memory (js-object :initialPages 4 :maximumPages 1024))
  (defconst counts (js-array 0 1 31 32 33 63 64 1023 1024 1055 1056 1057))
  (defconst node-helper (resolve "tests/helpers/wasm-managed-transient-state-node.mjs"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar modules nil)
  (defvar lowered nil)
  (defvar bytes nil)
  (defvar nativePath nil)
  (defvar expected nil)

  (defasync load-module (id seen out-modules &rest __host_forwarded_arguments_1)
    (let* ((source (aref __host_forwarded_arguments_1 0)))
    (when (not (js-call seen :has id))
      (js-call seen :add id)
      (let* ((filename (if (= id "entry.mjs")
                           "tests/fixtures/wasm-managed-transient-state.eli"
                           id))
             (src-text (if (nullish? source)
                           (await (readFile filename "utf8"))
                           source))
             (program (js-call (get backend :compiler) :compile_ir_string src-text filename)))
        (js-call out-modules :push (js-object :id id :program program))
        ;; Only module containers may contain declarations at this boundary. Walk
        ;; every nested container in source order without dropping its real imports.
        (let ((declarations (js-call (Array/from (get program :body)) :reverse)))
          (while (> (get declarations :length) 0)
            (let ((node (js-call declarations :pop)))
              (cond
                ((= (get node :kind) "module-declaration")
                 (let ((children (get node :children))
                       (index (- (get (get node :children) :length) 1)))
                   (while (>= index 0)
                     (js-call declarations :push (aref children index))
                     (setq index (- index 1)))))
                ((= (get node :kind) "import-declaration")
                 (let ((target (js-call posix :normalize
                                 (js-call posix :join (js-call posix :dirname id) (get node :value)))))
                   (funcall assert
                     (js-call target :startsWith "stdlib/")
                     (str "real portable module dependency: " target))
                   (await (load-module target seen out-modules))))))))))))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-transient-state-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let ((runtime (js-call (get backend :compiler) :compile_ir_string
                       (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                       "runtime.eli"))
            (seen (new globalThis.Set)))
        (setq modules (js-array))
        (await (load-module "entry.mjs" seen modules
                 (await (readFile "tests/fixtures/wasm-managed-transient-state.eli" "utf8"))))
        (funcall assert
          (js-call modules :some (lambda (m) (= (get m :id) "stdlib/managed-transient-state.eli"))))
        (js-call (js-array "persistent-vector" "persistent-map" "persistent-set" "value") :forEach
          (lambda (name)
            (funcall assert
              (js-call modules :some (lambda (m) (= (get m :id) (str "stdlib/" name ".eli")))))))
        (let ((saved (JSON/stringify modules)))
          (setq lowered (js-call (get backend :managed) :lower_managed_project
                          modules "entry.mjs" runtime memory))
          (setq bytes
            (Uint8Array/from
              (js-call (get backend :wasm) :append_metadata_section
                (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
                "eliscript-managed-control"
                (JSON/stringify (get lowered :descriptor)))))
          (js-call assert :equal (JSON/stringify modules) saved)
          (js-call assert :deepEqual
            (WebAssembly.Module/imports (new WebAssembly.Module bytes))
            (js-array))
          (when (and (= (get process :platform) "darwin")
                     (= (get process :arch) "arm64"))
            (setq nativePath (resolve directory "transient-state.dylib"))
            (await (writeFile nativePath
                     (Uint8Array/from
                       (js-call (get backend :native) :emit_typed_native_memory_library
                         (get lowered :typed) "arm64-macos")))))
          (let* ((env-node (get (get process :env) :NODE))
                 (node-bin (if (nullish? env-node) "node" env-node))
                 (oracle (spawnSync node-bin (js-array node-helper)
                           (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get oracle :status) 0 (get oracle :stderr))
            (setq expected (JSON/parse (get oracle :stdout)))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun read-val (rt value)
    (let ((kind (if (nullish? value) undefined (get value :kind))))
      (cond
        ((= kind 4) (js-call rt :readNumber value))
        ((= kind 5) (js-call rt :readString value))
        ((= kind 14)
         (Array/from (js-object :length (js-call rt :length value))
           (lambda (_ index)
             (let ((item (js-call rt :get value index)))
               (try
                 (read-val rt item)
                 (finally
                   (js-call rt :release item)))))))
        (t value))))

  (defun invoke (rt name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (let ((result (js-call rt :invoke name (if (undefined? args) (js-array) args))))
      (try
        (read-val rt result)
        (finally
          (js-call rt :release result))))))

  (defun finish (rt)
    (js-call rt :closeModule)
    (js-call rt :collect)
    (js-call assert :equal (js-call rt :live) 0)
    (js-call assert :equal (get (js-call rt :stats) :frameDepth) 0))

  (defun check-all (rt)
    (js-call counts :forEach
      (lambda (count index)
        (let ((number (js-call rt :number count)))
          (try
            (js-call assert :deepEqual
              (invoke rt "vector-case" (js-array number))
              (aref (get expected :vectors) index)
              (str "vector count " count))
            (finally
              (js-call rt :release number)))
          (js-call rt :collect)
          (js-call assert :equal (get (js-call rt :stats) :frameDepth) 0))))
    (js-call (js-array
               (js-array "vector-ownership" "vectorOwnership")
               (js-array "map-branches" "mapBranches")
               (js-array "collisions" "collisions")
               (js-array "real-collision" "realCollision")
               (js-array "set-case" "setCase")
               (js-array "index-errors" "indexErrors")
               (js-array "vector-limit" "vectorLimit")
               (js-array "invalid-sources" "invalidSources"))
      :forEach
      (lambda (pair)
        (let ((name (aref pair 0))
              (key (aref pair 1)))
          (js-call assert :deepEqual (invoke rt name) (get expected key) name)
          (js-call rt :collect)
          (js-call assert :equal (get (js-call rt :stats) :frameDepth) 0))))
    (js-call (js-array 0 1 2 3) :forEach
      (lambda (mode)
        (let ((value (js-call rt :number mode)))
          (try
            (js-call assert :deepEqual
              (invoke rt "callback-order" (js-array value))
              (aref (get expected :callbacks) mode)
              (str "callback mode " mode))
            (finally
              (js-call rt :release value)))
          (js-call rt :collect)
          (js-call assert :equal (get (js-call rt :stats) :frameDepth) 0)))))

  (test "Given the complete transient state dependency graph when vector trie boundaries and HAMT branches execute then zero-import WASM matches the original JS runtime"
    (lambda ()
      (let ((rt (instantiateManagedRuntime bytes options)))
        (js-call rt :auto 65536)
        (try
          (check-all rt)
          (finally
            (finish rt)))))
    30000)

  (test "Given collection at every allocation when owners mutate collision and branch nodes then old values metadata callbacks and sealed states match the original JS runtime"
    (lambda ()
      (let ((rt (instantiateManagedRuntime bytes options)))
        (js-call rt :auto 1)
        (try
          (check-all rt)
          (finally
            (finish rt)))))
    30000)

  (funcall (js-call test :skipIf
             (or (/= (get process :platform) "darwin")
                 (/= (get process :arch) "arm64")))
    "Given native machine code from the same typed complete graph when all transient state cases execute then the original JS observations and root cleanup agree"
    (async ()
      (let ((rt (await (instantiateNativeManagedRuntime nativePath lowered
                         (Object/assign (js-object) options memory)))))
        (js-call rt :auto 1)
        (try
          (check-all rt)
          (finally
            (try
              (finish rt)
              (finally
                (js-call rt :close)))))))
    120000)

  (test "Given a live edit state retained between exported calls when GC runs repeatedly then owner paths and source values remain rooted until persistent sealing"
    (lambda ()
      (let* ((rt (instantiateManagedRuntime bytes options))
             (state (progn (js-call rt :auto 1) (js-call rt :invoke "held-state")))
             (source (Array/from (js-object :length 65) (lambda (_ index) index)))
             (result (Array/from source)))
        (try
          (js-call (js-array
                     (js-array 0 100)
                     (js-array 1 101)
                     (js-array 32 132)
                     (js-array 64 164))
            :forEach
            (lambda (pair)
              (let ((index (aref pair 0))
                    (value (aref pair 1)))
                (js-call rt :collect)
                (let ((key (js-call rt :number index))
                      (item (js-call rt :number value)))
                  (try
                    (let ((returned (js-call rt :invoke "held-step" (js-array state key item))))
                      (try
                        (funcall assert (js-call rt :keyEqual returned state))
                        (finally
                          (js-call rt :release returned))))
                    (finally
                      (js-call rt :release key)
                      (js-call rt :release item))))
                (put result index value)
                (js-call assert :equal (get (js-call rt :stats) :frameDepth) 0))))
          (js-call rt :collect)
          (js-call assert :deepEqual
            (invoke rt "held-finish" (js-array state))
            (js-array source result 17))
          (finally
            (js-call rt :release state)
            (finish rt)))))
    30000))
