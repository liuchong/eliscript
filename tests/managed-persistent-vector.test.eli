(module tests.managed-persistent-vector.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "./helpers/managed-vector-contract.mjs" vectorCounts options memory check finish)
  (defvar b undefined) (defvar rt undefined) (defvar modules undefined) (defvar lowered undefined)
  (defvar bytes undefined) (defvar js undefined) (defvar directory undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-vector-"))) b (await (buildBackends (js-object :outputRoot directory))))
    (setq rt (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (let ((source (await (readFile "stdlib/persistent-vector.eli" "utf8"))) (entry (await (readFile "tests/fixtures/wasm-managed-persistent-vector.eli" "utf8"))))
      (setq modules (js-array (js-object :id "persistent-vector.mjs" :program (js-call (get b :compiler) :compile_ir_string source "persistent-vector.eli"))
        (js-object :id "entry.mjs" :program (js-call (get b :compiler) :compile_ir_string entry "vector-entry.eli"))))
      (await (writeFile (resolve directory "persistent-vector.mjs") (js-call (get b :compiler) :compile_string source "persistent-vector.eli")))
      (await (writeFile (resolve directory "entry.mjs") (js-call (get b :compiler) :compile_string entry "vector-entry.eli")))
      (let ((oracle (spawnSync "node" (js-array "tests/fixtures/managed-vector-host.mjs" "observe" (get (pathToFileURL (resolve directory "entry.mjs")) :href))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get oracle :status) 0 (get oracle :stderr))
        (let ((observations (new globalThis.Map (JSON/parse (get oracle :stdout)))))
          (setq js (js-object :vector_case (lambda (n) (funcall assert (js-call observations :has n)) (js-call observations :get n))))))
      (let ((saved (JSON/stringify modules)))
        (setq lowered (js-call (get b :managed) :lower_managed_project modules "entry.mjs" rt))
        (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "entry.mjs" rt memory)))
        (js-call assert :equal (JSON/stringify modules) saved)
        (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array))))) 120000)
  (afterAll (async () (unless (nullish? directory) (await (rm directory (js-object :recursive t :force t))))))
  (test "Given the entire original persistent Vector module when WASM crosses tail and root boundaries then versions metadata and reductions match JS" (lambda ()
    (let ((a (instantiateManagedRuntime bytes options))) (js-call a :auto 65536)
      (try (js-call vectorCounts :forEach (lambda (n) (check a n js))) (finally (finish a))))) 120000)
  (test "Given each allocation collects when real persistent Vector callbacks run then original versions and opaque roots stay valid" (lambda ()
    (let ((a (instantiateManagedRuntime bytes options))) (js-call a :auto 1) (try (check a 33 js) (finally (finish a))))) 30000)
  (funcall (js-call test :skipIf (or (not (= (get globalThis.process :platform) "darwin")) (not (= (get globalThis.process :arch) "arm64"))))
    "Given a true native library of the complete Vector module when the same cases run then persistent behavior matches the same JS reference" (async ()
      (let ((path (resolve directory "vector.dylib")))
        (await (writeFile path (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
        (let ((a (await (instantiateNativeManagedRuntime path lowered (copyHostRecord options memory)))))
          (js-call a :auto 65536) (try (js-call vectorCounts :forEach (lambda (n) (check a n js))) (finally (finish a)))))) 120000)
  (test "Given the same zero-import Vector bytes when Node executes them then the original independent JS module remains the oracle" (async ()
    (let ((path (resolve directory "vector.wasm")))
      (await (writeFile path bytes))
      (let ((child (spawnSync "node" (js-array "tests/fixtures/managed-vector-host.mjs" "execute" (get (pathToFileURL (resolve directory "entry.mjs")) :href) path)
                     (js-object :encoding "utf8" :timeout 120000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))) 130000)
)
