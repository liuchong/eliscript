(module tests.stdlib-bit
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (test "portable 32-bit operations and algorithms agree under Bun and Node" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-bit-"))))
           (seed (resolve directory "seed")) (self (resolve directory "self-hosted")) (bootstrap (resolve directory "bootstrap"))
           (bitSource (resolve ROOT "stdlib/bit.eli")) (bitModule (resolve seed "bit.mjs")) (selfModule (resolve self "bit.mjs"))
           (usage (resolve seed "bit-usage.mjs")) (hostFixture (resolve ROOT "tests/fixtures/bit-host.mjs")))
      (try
        (await (Promise/all (js-array (mkdir seed (js-object :recursive t)) (mkdir self (js-object :recursive t)))))
        (await (compile bitSource bitModule)) (await (compile (resolve ROOT "tests/fixtures/bit-usage.eli") usage))
        (await (seedCompilerFixture bootstrap))
        (await (runSuccessful (js-array (resolve ROOT "bin/eliscript-portable") "--source-map" "--output" selfModule bitSource)
          (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
        (be (await (readFile selfModule "utf8")) (await (readFile bitModule "utf8")))
        (be (await (readFile (str selfModule ".map") "utf8")) (await (readFile (str bitModule ".map") "utf8")))
        (let ((hosts (js-array "bun" "node")) (modules (js-array bitModule selfModule)) (hostIndex 0))
          (while (< hostIndex 2)
            (let ((moduleIndex 0))
              (while (< moduleIndex 2)
                (same (JSON/parse (await (runSuccessful (js-array (aref hosts hostIndex) hostFixture usage (aref modules moduleIndex)) (js-object)))) (js-object "intrinsics" (js-object "int32" (- 1) "int32-fraction" 3 "int32-negative-fraction" (- 3) "int32-nan" 0 "uint32" 4294967295 "uint32-infinity" 0 "uint32-wrap" 1 "imul32" (- 5) "bit-and" 15 "bit-or" 3855 "bit-xor" 85 "bit-not" (- 1) "shift-left" (- 2147483648) "shift-mask" 3 "shift-right" (- 1) "unsigned-shift-right" 1) "evaluation" (js-object "result" 3 "order" (js-array "left" "right")) "library" (js-object "zero" 0 "all" 32 "alternating" 16 "high" 1 "rotateLeft" 878082066 "rotateRight" 2014458966 "rotateIdentity" 305419896 "rotateMasked" 878082066)))
                (setq moduleIndex (1+ moduleIndex))))
            (setq hostIndex (1+ hostIndex))))
        (await (checkMap bitModule (js-array "(defportable bit-count")))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
