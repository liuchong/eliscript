(module tests.macro-generated-names.test
  (import "node:process" :default process)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (defconst projectDirectory (resolve (js* "import.meta.dir") ".."))
  (defconst buildPath (resolve projectDirectory "bin/eliscript-bootstrap"))
  (defconst seedCliPath (resolve projectDirectory "bin/eliscript"))
  (defconst portableCliPath (resolve projectDirectory "bin/eliscript-portable"))
  (defconst emacs (let ((value (get (get process :env) :EMACS))) (if (nullish? value) "emacs" value)))
  (defconst source "(defvar calls 0)\n\n(defun reset-calls () (setq calls 0))\n\n(defun counted (value)\n  (setq calls (1+ calls))\n  value)\n\n(defmacro once (form)\n  `(let ((value$ ,form)) value$))\n\n(defun source-collision (value$G1)\n  [(once (counted (+ value$G1 1))) calls])\n\n(defmacro duplicate-once (form)\n  `(let ((result$ ,form)) [result$ result$]))\n\n(defun duplicate-value (value)\n  (duplicate-once (counted value)))\n\n(defmacro names-after-intern ()\n  (let ((reserved (intern (concat \"slot\" \"$G4\")))\n        (generated (gensym \"slot\")))\n    `(list ',reserved ',generated)))\n\n(defconst generated-names (names-after-intern))\n\n(defmacro safe-pair (left right)\n  (let ((left-name (gensym \"slot\"))\n        (right-name (gensym 'slot)))\n    `(let ((,left-name ,left)\n            (,right-name ,right))\n       [,left-name ,right-name])))\n\n(defun explicit-pair (slot$G6 slot$G7)\n  (safe-pair slot$G6 slot$G7))\n\n(defmacro default-generated-name ()\n  (let ((name (gensym))) `(quote ,name)))\n\n(defconst default-name (default-generated-name))\n\n(defmacro capture-target (value)\n  `(setq target ,value))\n\n(defun deliberate-capture (target)\n  (capture-target (+ target 1))\n  target)\n\n(defconst quoted-marker 'value$)\n\n(export reset-calls source-collision duplicate-value generated-names\n        explicit-pair default-name deliberate-capture quoted-marker)\n")

  (defun env (extra) (Object/assign (js-object) (get process :env) extra))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync run (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((child (Bun/spawn command (Object/assign (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe") options)))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (when (not (= exitCode 0))
        (throw (new globalThis.Error (or (js-call stderr :trim) (js-call stdout :trim) (str (aref command 0) " exited with " exitCode)))))
      stdout)))

  (test "macro-generated names are deterministic and capture-safe" (async ()
    (let ((directory (await (mkdtemp (resolve projectDirectory ".eliscript-gensym-")))))
      (try
        (let* ((compilerDirectory (resolve directory "compiler")) (sourcePath (resolve directory "generated-names.eli"))
               (outputPath (resolve directory "generated-names.mjs")) (mapPath (str outputPath ".map")))
          (await (writeFile sourcePath source))
          (await (run (js-array buildPath) (js-object :env (env (js-object :EMACS emacs :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDirectory)))))
          (await (run (js-array seedCliPath "--output" outputPath "--source-map" sourcePath) (js-object :env (env (js-object :EMACS emacs)))))
          (let ((seedJavaScript (await (readFile outputPath "utf8"))) (seedSourceMap (await (readFile mapPath "utf8"))))
            (await (run (js-array portableCliPath "--output" outputPath "--source-map" sourcePath)
              (js-object :env (env (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory)))))
            (be (await (readFile outputPath "utf8")) seedJavaScript) (be (await (readFile mapPath "utf8")) seedSourceMap)
            (js-call (expect seedJavaScript) :toContain "((value$G2) =>")
            (js-call (expect seedJavaScript) :toContain "let result$G3 = __eliscript_value_1;")
            (js-call (expect seedJavaScript) :toContain "__eliscript_symbol(\"slot$G4\"), __eliscript_symbol(\"slot$G5\")")
            (js-call (get (expect seedJavaScript) :not) :toContain "((value$G1) =>"))
          (let ((module (await (funcall (js* "(url) => import(url)") (str (get (pathToFileURL outputPath) :href) "?bun")))))
            (same (Array/from (js-call module :source_collision 7)) (js-array 8 1))
            (js-call module :reset_calls)
            (same (Array/from (js-call module :duplicate_value 9)) (js-array 9 9))
            (same (js-call (Array/from (get module :generated_names)) :map globalThis.String) (js-array "slot$G4" "slot$G5"))
            (same (Array/from (js-call module :explicit_pair 10 20)) (js-array 10 20))
            (be (funcall globalThis.String (get module :default_name)) "G$G10")
            (be (js-call module :deliberate_capture 4) 5)
            (be (funcall globalThis.String (get module :quoted_marker)) "value$"))
          (await (run (js-array "node" (resolve projectDirectory "tests/fixtures/macro-generated-names-host.mjs") (get (pathToFileURL outputPath) :href)))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
