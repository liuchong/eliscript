(module tests.bootstrap-symbol
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst projectDirectory (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defasync compileBootstrapModule (outputPath)
    (let* ((child (Bun/spawn (js-array (resolve projectDirectory "bin/eliscript") "--source-map" "--output" outputPath (resolve projectDirectory "bootstrap/compiler/symbol.eli"))
             (js-object :cwd projectDirectory :env (get globalThis.process :env) :stdout "ignore" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stderr (aref result 1)))
      (unless (= exitCode 0) (let ((text (js-call stderr :trim))) (throw (new globalThis.Error (if (funcall host-truth text) text (str "compiler exited with " exitCode))))))))
  (defun runCase (operation implementation testCase)
    (try (js-object :input (get testCase :input) :output (funcall implementation (get testCase :input)))
      (catch error (js-object :input (get testCase :input) :error (get error :message)))))
  (test "bootstrapped symbol mapping matches the seed conformance fixture" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-bootstrap-")))))
      (try
        (let ((outputPath (resolve directory "symbol.mjs")))
          (await (compileBootstrapModule outputPath))
          (let ((firstCode (await (readFile outputPath "utf8"))) (firstMap (await (readFile (str outputPath ".map") "utf8"))))
            (await (compileBootstrapModule outputPath))
            (js-call (expect (await (readFile outputPath "utf8"))) :toBe firstCode)
            (js-call (expect (await (readFile (str outputPath ".map") "utf8"))) :toBe firstMap))
          (let* ((generated (await (funcall load-module (get (pathToFileURL outputPath) :href))))
                 (fixture (JSON/parse (await (readFile (resolve projectDirectory "tests/fixtures/bootstrap-symbols.json") "utf8"))))
                 (implementations (js-object :segment (get generated :munge_segment) :binding (get generated :binding_name) :reference (get generated :reference_name))))
            (js-call (Object/entries fixture) :forEach (lambda (entry)
              (let ((operation (aref entry 0)))
                (js-call (aref entry 1) :forEach (lambda (testCase) (js-call (expect (runCase operation (get implementations operation) testCase)) :toEqual testCase))))))))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
)
