(module tests.native-memory-debug-options.test
  (import "node:process" :default process)
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)
  (import "../tools/backends/compiler-debug.mjs" createCompilerDebugMap)
  (defconst hostInstanceof (js* "(value, constructor) => value instanceof constructor"))
  (defconst target (if (= (get process :arch) "arm64") (if (= (get process :platform) "darwin") "arm64-macos" (if (= (get process :platform) "linux") "arm64-linux" undefined)) undefined))
  (defconst nativeTest (js-call test :skipIf (not target)))
  (defconst signatures (js-object :safe 0 :crash 0))
  (defconst filename "loader/原生输入😀.eli")
  (defvar directory undefined) (defvar library undefined) (defvar bytes undefined) (defvar debug undefined) (defvar machineFrames undefined)
  (beforeAll (async ()
    (when target
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-debug-options-"))))
      (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
             (memory (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve (get backend :directory) "memory.mjs")) :href))))
             (source "(import \"eliscript:memory32\" load-u32)\n    (defun safe () 42)\n    (defun crash () (load-u32 65536) 3)\n    (export safe crash)")
             (typed (js-call memory :lower_memory_program (js-call (get backend :compiler) :compile_ir_string source filename)))
             (artifact (js-call (get backend :native) :emit_typed_native_memory_artifact typed target (js-object :format "library"))))
        (setq debug (get artifact :debug)) (put debug :sources (js-array (js-object :id filename :filename filename :macroOrigins (js-array))))
        (let* ((crashed (js-call (get typed :functions) :find (lambda (fn) (= (get fn :name) "crash"))))
               (sites (progn (assert crashed) (js-call (get debug :trapSites) :filter (lambda (site) (and (= (get site :functionIndex) (get crashed :index)) (= (get site :code) 1)))))))
          (js-call assert :equal (get sites :length) 1 "the emitted bounds guard identifies the actual native load")
          (js-call assert :equal (get (aref sites 0) :offsetBase) "code-section")
          (js-call assert :equal (get (aref sites 0) :returnAddress) false)
          (setq machineFrames (js-array (js-object :address (get (aref sites 0) :address) :offsetBase "code-section" :functionIndex (get crashed :index) :returnAddress false))))
        (setq bytes (Uint8Array/from (get artifact :bytes)))
        (setq library (resolve directory (if (= target "arm64-linux") "debug-options.so" "debug-options.dylib")))
        (await (writeFile library bytes))))) 120000)
  (afterAll (async ()
    (setq bytes undefined) (setq debug undefined) (setq machineFrames undefined)
    (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun configuration () (js-object :initialPages 1 :maximumPages 1 :nativeTarget target :trapSites (get debug :trapSites)))
  (defun trap (runtime)
    (let ((thrown undefined))
      (try (js-call runtime :invoke "crash") (catch error (setq thrown error)))
      (assert (funcall hostInstanceof thrown WebAssembly.RuntimeError) "the actual native bounds trap must cross the loader")
      (js-call assert :equal (get thrown :message) "memory access out of bounds")
      (js-call assert :deepEqual (get thrown :eliscriptFrames) machineFrames)
      (assert (Object/isFrozen (get thrown :eliscriptFrames))) (assert (js-call (get thrown :eliscriptFrames) :every (get globalThis.Object :isFrozen)))
      thrown))
  (nativeTest "native omitted undefined and false debug options retain exact traps without source mapping" (async ()
    (let ((options (js-array (js-object) (js-object :debug undefined) (js-object :debug false))) (index 0))
      (while (< index (get options :length))
        (let ((runtime (await (openNativeMemory library signatures (Object/assign (js-object) (configuration) (aref options index))))))
          (try
            (js-call assert :equal (get runtime :byteLength) 65536) (js-call assert :equal (js-call runtime :invoke "safe") 42)
            (let ((repeat 0))
              (while (< repeat 2)
                (js-call assert :equal (Object/hasOwn (trap runtime) "eliscriptSourceFrames") false)
                (js-call assert :equal (js-call runtime :invoke "safe") 42 "the native context recovers after each exact trap") (setq repeat (1+ repeat))))
            (finally (js-call runtime :close)))
          (js-call assert :throws (lambda () (js-call runtime :invoke "safe")) (new globalThis.RegExp "closed")))
        (setq index (1+ index))))
    (js-call assert :deepEqual (new globalThis.Uint8Array (await (readFile library))) bytes "debug options do not rewrite the library")))
  (nativeTest "native valid debug documents map exact traps using independent snapshots" (async ()
    (let* ((supplied (funcall globalThis.structuredClone debug)) (saved (funcall globalThis.structuredClone supplied))
           (expected (js-call (createCompilerDebugMap saved) :mapFrames machineFrames)))
      (js-call assert :equal (get expected :length) 1) (js-call assert :equal (get (get (aref expected 0) :source) :function) "crash")
      (js-call assert :equal (get (get (get (aref expected 0) :source) :span) :filename) filename)
      (js-call assert :equal (get (get (aref expected 0) :source) :source) filename)
      (let* ((options (Object/assign (js-object) (configuration) (js-object :debug supplied))) (runtime (await (openNativeMemory library signatures options))))
        (js-call assert :deepEqual supplied saved)
        (put (get supplied :functions) :length 0) (put (get supplied :ranges) :length 0) (put (get supplied :sources) :length 0)
        (put (get supplied :codeSection) :size 0) (put options :debug false)
        (try (let ((repeat 0)) (while (< repeat 2)
          (js-call assert :deepEqual (get (trap runtime) :eliscriptSourceFrames) expected)
          (js-call assert :equal (js-call runtime :invoke "safe") 42) (setq repeat (1+ repeat))))
          (finally (js-call runtime :close))))
      (js-call assert :deepEqual debug saved))))
  (nativeTest "native false debug support preserves rejection of all other unsupported documents" (async ()
    (let ((values (js-array nil t 0 "false" (js-array) (js-object))) (index 0))
      (while (< index (get values :length))
        (await (js-call assert :rejects (openNativeMemory library signatures (Object/assign (js-object) (configuration) (js-object :debug (aref values index))))
          (lambda (error) (assert (funcall hostInstanceof error globalThis.TypeError)) (js-call assert :equal (get error :message) "unsupported compiler instruction map") t)))
        (setq index (1+ index))))
    (let ((runtime (await (openNativeMemory library signatures (Object/assign (js-object) (configuration) (js-object :debug false))))))
      (try (js-call assert :equal (Object/hasOwn (trap runtime) "eliscriptSourceFrames") false) (js-call assert :equal (js-call runtime :invoke "safe") 42)
        (finally (js-call runtime :close))))))
  (nativeTest "real Node to Bun native transport preserves false debug exact frames mapping snapshots and recovery" (async ()
    (let ((parameters (resolve directory "node-debug-options.json")))
      (await (writeFile parameters (JSON/stringify (js-object :library library :signatures signatures :original debug :machineFrames machineFrames :target target :bunExecutable (get process :execPath) :filename filename))))
      (let* ((node (get (get process :env) :NODE))
             (result (spawnSync (if (nullish? node) "node" node) (js-array (resolve (js* "import.meta.dir") "fixtures/native-debug-options-host.mjs") parameters)
               (js-object :cwd directory :encoding "utf8" :timeout 30000 :env (Object/assign (js-object) (get process :env) (js-object :NODE_OPTIONS "" :BUN_OPTIONS ""))))))
        (js-call assert :equal (get result :error) undefined (get result :stderr))
        (js-call assert :equal (get result :signal) nil)
        (js-call assert :equal (get result :status) 0 (str (get result :stderr) (get result :stdout)))
        (js-call assert :equal (get result :stdout) "native-debug-options-node-verified\n")))) 30000)
)
