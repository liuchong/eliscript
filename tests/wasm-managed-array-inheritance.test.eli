(module tests.wasm-managed-array-inheritance.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-heap-diagnostic.mjs" invokeWithHeapDiagnostic)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst typeof-str (js* "(value) => typeof value"))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar bytes undefined)
  (defvar reference undefined)
  (defvar source undefined)

  (defconst methods
    (js-array "map" "filter" "forEach" "every" "some" "reduce" "reduceRight"
              "indexOf" "lastIndexOf" "sort" "slice" "concat"))

  (defconst described-methods
    (js-array "map" "filter" "forEach" "every" "some" "sort" "slice" "concat"))

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-array-inheritance-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime
      (js-call (get backend :compiler) :compile_ir_string
        (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
        "runtime.eli"))
    (let* ((operations
             (js-object
               :map "(js-call value :map (lambda (item) item))"
               :filter "(js-call value :filter (lambda () t))"
               :forEach "(let ((seen (js-array))) (js-call value :forEach (lambda (item index) (js-call seen :push (js-array index item)))) seen)"
               :every "(let ((seen (js-array))) (js-call value :every (lambda (item index) (js-call seen :push index) false)) seen)"
               :some "(let ((seen (js-array))) (js-call value :some (lambda (item index) (js-call seen :push index) t)) seen)"
               :reduce "(js-call value :reduce (lambda (sum item index) (+ sum index)) 0)"
               :reduceRight "(js-call value :reduceRight (lambda (sum item index) (+ sum index)) 0)"
               :indexOf "(js-call value :indexOf inherited)"
               :lastIndexOf "(js-call value :lastIndexOf inherited)"
               :sort "(js-call value :sort)"
               :slice "(js-call value :slice 0)"
               :concat "(js-call (js-array) :concat value)"))
           (test-fns
             (js-call
               (js-call methods :map
                 (lambda (method)
                   (str "(defun test-" method " (inherited) (let ((value (sparse inherited))) (let ((out "
                        (get operations method) ")) (JSON/stringify (js-array "
                        (if (js-call described-methods :includes method) "(describe out)" "out")
                        " (describe value))))))")))
               :join "\n"))
           (raw-fns
             (js-call
               (js-call methods :map
                 (lambda (method)
                   (str "(defun raw-" method " (value inherited) (JSON/stringify "
                        (if (js-call described-methods :includes method)
                          (str "(describe " (get operations method) ")")
                          (get operations method))
                        "))")))
               :join "\n")))
      (setq source
        (str
          "(defun sparse (inherited) (let ((prototype globalThis.Array.prototype) (value (js-array))) (put prototype :length 0) (put prototype \"1\" inherited) (put value :length 4) (put value \"3\" 3) value))\n"
          " (defun describe (value) (js-array (JSON/stringify value) (JSON/stringify (Object/keys value)) (Object/hasOwn value \"1\") (undefined? (Object/getOwnPropertyDescriptor value \"1\"))))\n "
          test-fns "\n"
          " (defun dynamic (mode)\n"
          "  (let ((value (sparse 7)) (prototype globalThis.Array.prototype) (trace (js-array)))\n"
          "   (put value \"0\" 1) (when (= mode 1) (put prototype :length 0))\n"
          "   (let ((out (js-call value :map (lambda (item index)\n"
          "     (js-call trace :push index)\n"
          "     (when (= index 0) (cond ((= mode 0) (put prototype :length 0)) ((= mode 1) (put prototype \"1\" 7)) (t (put value :length 1)))) item))))\n"
          "    (JSON/stringify (js-array (describe out) trace (describe value))))))\n"
          " (defun sort-effect () (let ((value (sparse 7)) (prototype globalThis.Array.prototype) (trace (js-array)))\n"
          "  (js-call value :sort (lambda (a b) (js-call trace :push 1) (put prototype :length 0) (- a b)))\n"
          "  (JSON/stringify (js-array (describe value) trace))))\n"
          " (defun argument-effect (concat) (let ((value (sparse 7)) (prototype globalThis.Array.prototype) (trace (js-array)))\n"
          "  (let ((out (if concat (js-call (js-array) :concat (progn (js-call trace :push 1) (put prototype :length 0) value))\n"
          "   (js-call value :slice (progn (js-call trace :push 1) (put prototype :length 0) 0)))))\n"
          "   (JSON/stringify (js-array (describe out) trace)))))\n"
          " (defun prototype () globalThis.Array.prototype)\n"
          " (defun object-prototype () globalThis.Object.prototype)\n"
          " (defun range-copy (concat) (let ((value (sparse 7))) (JSON/stringify (describe (if concat (js-call (js-array 9) :concat value) (js-call value :slice 1 4))))))\n"
          " (defun throw-callback (value) (js-call value :map (lambda (item) (throw item))))\n"
          " (defconst iterate (js* \"(iterable, visit) => { for (const item of iterable) visit(item); }\"))\n"
          " (defun iterator-inherited (inherited mode)\n"
          "  (let ((value (sparse inherited)))\n"
          "   (JSON/stringify\n"
          "    (cond ((= mode 0) (let ((out (js-array))) (funcall iterate value (lambda (item) (js-call out :push item))) out))\n"
          "     ((= mode 1) (apply (lambda (&rest items) items) value))\n"
          "     ((= mode 2) (Array/from value))\n"
          "     ((= mode 3) (try (throw value) (catch [a b c &rest tail] (js-array a b c tail))))\n"
          "     ((= mode 4) (Array/from (js-call value :entries)))\n"
          "     (t (Array/from (js-call value :keys)))))))\n"
          " (defun native ()\n"
          "  (let ((method (aref globalThis.Array.prototype \"push\")) (value (js-array 1)))\n"
          "   (JSON/stringify (js-array (js-call method :call value 2 3) value (get method :name) (get method :length)))))\n "
          raw-fns "\n"
          " (export iterator-inherited dynamic sort-effect argument-effect prototype object-prototype range-copy throw-callback native "
          (js-call (js-call methods :map (lambda (m) (str "test-" m))) :join " ")
          " "
          (js-call (js-call methods :map (lambda (m) (str "raw-" m))) :join " ")
          ")")))
    (setq program (js-call (get backend :compiler) :compile_ir_string source "array-inheritance.eli"))
    (let ((javascript (js-call (get backend :compiler) :emit_ir_string program)))
      (setq reference
        (await (funcall dynamic-import
                 (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64")))))
      (await (writeFile (resolve directory "reference.mjs") javascript)))
    (let ((frozen (JSON/stringify program)))
      (setq bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
      (js-call assert :equal (JSON/stringify program) frozen)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun withPrototype (fn)
    (let ((saved (Object/getOwnPropertyDescriptors globalThis.Array.prototype)))
      (try
        (funcall fn)
        (finally
          (let ((keys (Reflect/ownKeys globalThis.Array.prototype)) (i 0))
            (while (< i (js-length keys))
              (let ((key (aref keys i)))
                (when (not (Object/hasOwn saved key))
                  (Reflect/deleteProperty globalThis.Array.prototype key)))
              (setq i (1+ i))))
          (let ((skeys (Reflect/ownKeys saved)) (si 0))
            (while (< si (js-length skeys))
              (let ((key (aref skeys si)))
                (when (/= key "length")
                  (Object/defineProperty globalThis.Array.prototype key (get saved key))))
              (setq si (1+ si))))
          (Object/defineProperty globalThis.Array.prototype "length" (get saved :length))))))

  (defun finish (a &rest __host_default_arguments_1)
    (let* ((values (aref __host_default_arguments_1 0)))
    (let ((items (if (undefined? values) (js-array) values)))
      (js-call items :forEach (lambda (value) (js-call a :release value))))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (js-call methods :forEach
    (lambda (method)
      (test (str "Array " method " observes inherited numeric data while own keys and descriptors remain own-only") (lambda ()
        (js-call (js-array 7 undefined) :forEach
          (lambda (inherited)
            (let* ((a (instantiateManagedRuntime bytes))
                   (_ (js-call a :auto 1))
                   (input (if (undefined? inherited) undefined (js-call a :number inherited)))
                   (expected (withPrototype (lambda () (js-call reference (str "test_" method) inherited))))
                   (out (js-call a :invoke (str "test-" method) (js-array input))))
              (js-call assert :equal (js-call a :readString out) expected (str method ": " (funcall globalThis.String inherited)))
              (finish a (js-array input out)))))))))

  (test "independent Node native JS and identical WASM bytes exercise the full inherited-array HasProperty family" (async ()
    (let ((artifact (resolve directory "inheritance.wasm")))
      (await (writeFile artifact bytes))
      (let ((child (spawnSync "node"
                     (js-array
                       (resolve "tests/helpers/wasm-managed-array-inheritance-node.mjs")
                       (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                       (get (pathToFileURL (resolve directory "reference.mjs")) :href)
                       artifact)
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "live HasProperty observes prototype addition, deletion and inherited indices beyond a shrunken receiver" (lambda ()
    (js-call (js-array 0 1 2) :forEach
      (lambda (mode)
        (let* ((a (instantiateManagedRuntime bytes))
               (_ (js-call a :auto 1))
               (input (js-call a :number mode))
               (expected (withPrototype (lambda () (js-call reference :dynamic mode))))
               (out (js-call a :invoke "dynamic" (js-array input))))
          (js-call assert :equal (js-call a :readString out) expected (str "dynamic mode " mode))
          (finish a (js-array input out)))))))

  (test "sorting snapshots inherited data before comparator mutation and copy methods observe argument effects first" (lambda ()
    (js-call
      (js-array
        (js-array "sort-effect" (js-array))
        (js-array "argument-effect" (js-array false))
        (js-array "argument-effect" (js-array t)))
      :forEach
      (lambda (pair)
        (let* ((name (aref pair 0))
               (args (aref pair 1))
               (a (instantiateManagedRuntime bytes))
               (_ (js-call a :auto 1))
               (expected (withPrototype (lambda () (Reflect/apply (get reference (js-call name :replaceAll "-" "_")) reference args))))
               (out (js-call a :invoke name args)))
          (js-call assert :equal (js-call a :readString out) expected name)
          (finish a (js-array out)))))))

  (test "deterministic sparse arrays preserve inherited undefined, holes and every implemented HasProperty algorithm" (lambda ()
    (let* ((state 127249440)
           (next (lambda () (setq state (uint32 (+ (Math/imul state 1664525) 1013904223)))))
           (trial 0))
      (while (< trial 12)
        (let* ((length (+ 2 (% (funcall next) 6)))
               (own (new globalThis.Array length))
               (inherited (new globalThis.Array length))
               (index 0))
          (while (< index length)
            (when (= (% (funcall next) 3) 0)
              (put own index (if (= (% (funcall next) 4) 0) undefined (% (funcall next) 16))))
            (when (= (% (funcall next) 3) 0)
              (put inherited index (if (= (% (funcall next) 4) 0) undefined (% (funcall next) 16))))
            (setq index (1+ index)))
          (js-call methods :forEach
            (lambda (method)
              (let* ((copy (Object/assign (new globalThis.Array length) own))
                     (expected
                       (withPrototype
                         (lambda ()
                           (put globalThis.Array.prototype :length 0)
                           (js-call (Object/keys inherited) :forEach
                             (lambda (key) (put globalThis.Array.prototype key (get inherited key))))
                           (js-call reference (str "raw_" method) copy undefined))))
                     (a (instantiateManagedRuntime bytes))
                     (_ (js-call a :auto 1))
                     (prototype (js-call a :invoke "prototype"))
                     (boxed (js-array))
                     (items (new globalThis.Array length)))
                (js-call a :resize prototype length)
                (js-call (Object/keys inherited) :forEach
                  (lambda (key)
                    (let ((value (if (undefined? (get inherited key))
                                   undefined
                                   (js-call a :number (get inherited key)))))
                      (js-call boxed :push value)
                      (js-call a :set prototype (funcall globalThis.Number key) value))))
                (js-call (Object/keys own) :forEach
                  (lambda (key)
                    (let ((value (if (undefined? (get own key))
                                   undefined
                                   (js-call a :number (get own key)))))
                      (js-call boxed :push value)
                      (put items key value))))
                (let* ((input (js-call a :sourceArray items))
                       (out (js-call a :invoke (str "raw-" method) (js-array input undefined))))
                  (js-call assert :equal (js-call a :readString out) expected (str method " trial " trial))
                  (finish a (js-call (js-array prototype input out) :concat boxed)))))))
        (setq trial (1+ trial))))))

  (test "inherited thrown values retain exact identity including undefined and unwind only callback-owned frames" (lambda ()
    (js-call (js-array undefined false (js-object :marker t)) :forEach
      (lambda (inherited)
        (let ((expected
                (withPrototype
                  (lambda ()
                    (put globalThis.Array.prototype 1 inherited)
                    (let ((caught false))
                      (try
                        (js-call reference :throw_callback (new globalThis.Array 4))
                        (catch error
                          (setq caught t)
                          (js-call assert :equal error inherited)))
                      (assert caught))
                    undefined))))
          (js-call assert :equal expected undefined)
          (let* ((a (instantiateManagedRuntime bytes))
                 (_ (js-call a :auto 1))
                 (prototype (js-call a :invoke "prototype"))
                 (input (js-call a :sourceArray (new globalThis.Array 4)))
                 (marker (if (and inherited (= (funcall typeof-str inherited) "object"))
                           (js-call a :sourceObject (js-object :marker t))
                           inherited))
                 (caller (js-call a :frame 1))
                 (caught false)
                 (thrown undefined))
            (js-call a :frameSet caller 0 input)
            (js-call a :resize prototype 2)
            (js-call a :set prototype 1 marker)
            (try
              (js-call a :invoke "throw-callback" (js-array input))
              (catch error
                (setq caught t)
                (setq thrown error)))
            (assert caught)
            (if (and marker (= (funcall typeof-str marker) "object"))
              (progn
                (assert (js-call a :keyEqual thrown marker))
                (js-call a :release thrown))
              (js-call assert :equal thrown marker))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :equal (js-call a :length input) 4)
            (js-call a :resize prototype 0)
            (js-call a :leaveFrame caller)
            (finish a (js-array prototype input marker))))))))

  (test "HasProperty does not execute the inherited Get while actual Get traps, preserving raw caller frames and roots" (async ()
    (let* ((mem-src (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (first (js-call mem-src :indexOf "  (defun heap-object-read-data "))
           (last (js-call mem-src :indexOf "  (defun heap-object-read " first)))
      (assert (and (>= first 0) (> last first)))
      (let* ((trapped (str (js-call mem-src :slice 0 first)
                           "  (defun heap-object-read-data (heap object key) (load-u32 4294967295))\n"
                           (js-call mem-src :slice last)))
             (exposed (str (js-call (js-call trapped :trimEnd) :slice 0 -1)
                           "\n (defun test-array-has-inherited (heap value index) (heap-source-array-index-read heap value index 2))\n (export test-array-has-inherited))"))
             (injected (js-call (get backend :compiler) :compile_ir_string exposed "inheritance-get-trap.eli"))
             (artifact (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program injected))))
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module artifact)) (js-array))
        (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module artifact)) :exports))
               (h (js-call e "heap-new" 128 32768 65536))
               (prototype (js-call e "value-standard-prototype" h 0))
               (key (js-call e "value-string" h 1)))
          (js-call (new globalThis.DataView (get (get e :memory) :buffer))
            :setUint16 (js-call e "value-data" h key 5) 49 t)
          (js-call e "value-seal" h key)
          (js-call e "value-object-put" h prototype key 3 2)
          (let ((input (js-call e "value-array-new" h 2))
                (caller (js-call e "frame-new" h 1)))
            (js-call e "frame-set" h caller 0 input)
            (js-call assert :equal (js-call e "value-array-has" h input key) 0)
            (js-call assert :equal (js-call e "last-error") 0)
            (js-call assert :equal (js-call e "test-array-has-inherited" h input 1) 1)
            (js-call assert :equal (js-call e "last-error") 0)
            (js-call assert :equal (js-call e "frame-depth" h) 1)
            (js-call assert :throws (lambda () (js-call e "value-array-get" h input key 0)) globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (js-call e "frame-depth" h) 1)
            (js-call assert :equal (js-call e "test-array-has-inherited" h input 1) 1)
            (js-call e "frame-pop" h caller)
            (js-call e "value-standard-prototypes-close" h)
            (js-call e "heap-collect" h)
            (js-call assert :equal (js-call e "heap-live" h) 0)))))))

  (test "inherited-array allocation failure keeps caller frames and live prototype edges, then copying recovers" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 16384 :maxBytes 65536)))
           (_ (js-call a :auto 1))
           (prototype (js-call a :invoke "prototype"))
           (input (js-call a :sourceArray (new globalThis.Array 4)))
           (caller (js-call a :frame 1))
           (padding (js-array))
           (exhausted false))
      (js-call a :frameSet caller 0 input)
      (js-call a :resize prototype 2)
      (js-call a :set prototype 1 undefined)
      (try
        (let ((i 0))
          (while (< i 128)
            (js-call padding :push (js-call a :number i))
            (setq i (1+ i))))
        (catch error
          (js-call assert :equal
            (and (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code))
            "ELI-RT0002")
          (setq exhausted t)))
      (assert exhausted)
      (js-call assert :throws
        (lambda () (js-call a :invoke "raw-map" (js-array input undefined)))
        (lambda (error)
          (and (get error :eliscriptDiagnostic)
               (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002"))))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (js-call assert :equal (js-call a :length input) 4)
      (js-call padding :forEach (lambda (value) (js-call a :release value)))
      (js-call a :collect)
      (let ((out (invokeWithHeapDiagnostic a "raw-slice" (js-array input undefined))))
        (js-call assert :equal
          (js-call a :readString out)
          (withPrototype
            (lambda ()
              (put globalThis.Array.prototype 1 undefined)
              (js-call reference :raw_slice (new globalThis.Array 4) undefined))))
        (js-call a :leaveFrame caller)
        (finish a (js-array prototype input out))))))

  (test "native Array prototype callables preserve their real invocation receiver name and arity" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes))
           (_ (js-call a :auto 1))
           (out (js-call a :invoke "native")))
      (js-call assert :equal (js-call a :readString out) (withPrototype (lambda () (js-call reference :native))))
      (finish a (js-array out)))))

  (test "slice offsets and concat receiver prefixes preserve holes even when the result inherits a different index" (lambda ()
    (js-call (js-array false t) :forEach
      (lambda (concat)
        (let* ((a (instantiateManagedRuntime bytes))
               (_ (js-call a :auto 1))
               (expected (withPrototype (lambda () (js-call reference :range_copy concat))))
               (out (js-call a :invoke "range-copy" (js-array concat))))
          (js-call assert :equal (js-call a :readString out) expected)
          (finish a (js-array out)))))))

  (test "all HasProperty families walk beyond Array prototype to actual Object prototype numeric data" (lambda ()
    (js-call (js-array 7 undefined) :forEach
      (lambda (inherited)
        (js-call methods :forEach
          (lambda (method)
            (let ((saved (Object/getOwnPropertyDescriptor globalThis.Object.prototype "1"))
                  (expected undefined))
              (try
                (setq expected
                  (withPrototype
                    (lambda ()
                      (put globalThis.Array.prototype :length 0)
                      (put globalThis.Object.prototype 1 inherited)
                      (let ((value (new globalThis.Array 4)))
                        (put value 3 3)
                        (js-call reference (str "raw_" method) value inherited)))))
                (finally
                  (if saved
                    (Object/defineProperty globalThis.Object.prototype "1" saved)
                    (Reflect/deleteProperty globalThis.Object.prototype "1"))))
              (let* ((a (instantiateManagedRuntime bytes))
                     (_ (js-call a :auto 1))
                     (arrayPrototype (js-call a :invoke "prototype"))
                     (objectPrototype (js-call a :invoke "object-prototype"))
                     (key (js-call a :string "1"))
                     (number (if (undefined? inherited) undefined (js-call a :number inherited)))
                     (three (js-call a :number 3))
                     (items (new globalThis.Array 4)))
                (js-call a :objectSet objectPrototype key number)
                (put items 3 three)
                (let* ((input (js-call a :sourceArray items))
                       (out (js-call a :invoke (str "raw-" method) (js-array input number))))
                  (js-call assert :equal (js-call a :readString out) expected method)
                  (finish a (js-array arrayPrototype objectPrototype key number three input out)))))))))))

  (test "source Array iterators perform inherited Get for for-of, argument spread, Array.from, catch binding and entries" (lambda ()
    (js-call (js-array 7 undefined) :forEach
      (lambda (inherited)
        (let ((mode 0))
          (while (< mode 6)
            (let* ((expected (withPrototype (lambda () (js-call reference :iterator_inherited inherited mode))))
                   (a (instantiateManagedRuntime bytes))
                   (_ (js-call a :auto 1))
                   (input (if (undefined? inherited) undefined (js-call a :number inherited)))
                   (m (js-call a :number mode))
                   (out (js-call a :invoke "iterator-inherited" (js-array input m))))
              (js-call assert :equal (js-call a :readString out) expected (str "iterator mode " mode))
              (finish a (js-array input m out)))
            (setq mode (1+ mode))))))))

  (test "keys iterator does not Get inherited numeric values while entries and values execute the real inherited read" (async ()
    (let* ((mem-src (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (first (js-call mem-src :indexOf "  (defun heap-object-read-data "))
           (last (js-call mem-src :indexOf "  (defun heap-object-read " first)))
      (assert (and (>= first 0) (> last first)))
      (let* ((trapped (str (js-call mem-src :slice 0 first)
                           "  (defun heap-object-read-data (heap object key) (load-u32 4294967295))\n"
                           (js-call mem-src :slice last)))
             (exposed (str (js-call (js-call trapped :trimEnd) :slice 0 -1)
                           "\n (defun test-iterator-step (heap iterator) (heap-source-iterator-step heap iterator))\n (export test-iterator-step))"))
             (injected (js-call (get backend :compiler) :compile_ir_string exposed "iterator-inherited-get-trap.eli"))
             (artifact (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program injected))))
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module artifact)) (js-array))
        (js-call (js-array 6 7 8) :forEach
          (lambda (method)
            (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module artifact)) :exports))
                   (h (js-call e "heap-new" 128 32768 65536))
                   (prototype (js-call e "value-standard-prototype" h 0))
                   (key (js-call e "value-string" h 1)))
              (js-call (new globalThis.DataView (get (get e :memory) :buffer))
                :setUint16 (js-call e "value-data" h key 5) 49 t)
              (js-call e "value-seal" h key)
