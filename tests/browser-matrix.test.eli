(module tests.browser-matrix.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp readFile rm stat)
  (import "node:path" join resolve)
  (import "../tools/browser/matrix.mjs" ENGINES VIEWPORTS contrastRatio parseColor runMatrix)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst SITE (resolve ROOT "examples/dogfood/_site"))
  (defvar staging undefined) (defvar report undefined)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync ensureSite ()
    (let ((exists false))
      (try (await (stat (join SITE "index.html"))) (setq exists t) (catch error nil))
      (unless exists
        (let* ((child (Bun/spawn (js-array "bun" "run" "dogfood") (js-object :cwd ROOT :stdout "pipe" :stderr "pipe")))
               (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
          (when (not (= (aref result 0) 0))
            (let ((error (js-call (aref result 2) :trim))) (throw (new globalThis.Error (if (= error "") "the demo site build failed" error)))))))))
  (beforeAll (async ()
    (await (ensureSite)) (setq staging (await (mkdtemp (resolve ROOT ".eliscript-browser-matrix-"))))
    (let ((result (await (runMatrix (js-object :site SITE :engines (js-array "chromium") :port 8901)))))
      (setq report (get result :report)) (put report :failures (get result :failures)))))
  (afterAll (async () (when staging (await (rm staging (js-object :recursive t :force t))))))
  (test "the matrix names the engines and viewports it requires" (lambda ()
    (same (Array/from ENGINES) (js-array "chromium" "firefox" "webkit"))
    (same (js-call VIEWPORTS :map (lambda (entry) (get entry :name))) (js-array "narrow" "mobile" "desktop"))
    (be (get (get (aref VIEWPORTS 0) :viewport) :width) 320)))
  (test "colour parsing and contrast follow the WCAG definition" (lambda ()
    (same (parseColor "rgb(22, 24, 29)") (js-array 22 24 29))
    (same (parseColor "rgba(0, 0, 0, 0.5)") (js-array 0 0 0))
    (js-call (expect (parseColor "currentColor")) :toBeNull)
    (js-call (expect (contrastRatio (js-array 0 0 0) (js-array 255 255 255))) :toBeCloseTo 21 5)
    (js-call (expect (contrastRatio (js-array 90 90 90) (js-array 90 90 90))) :toBeCloseTo 1 5)))
  (test "a real engine passes every viewport" (async ()
    (same (get report :failures) (js-array)) (be (get (get report :engines) :length) 1)
    (let ((engine (aref (get report :engines) 0)))
      (js-call (expect (get engine :error)) :toBeUndefined)
      (same (js-call (get engine :viewports) :map (lambda (entry) (get entry :name))) (js-array "narrow" "mobile" "desktop")))))
  (test "every viewport stays inside its width and keeps its text legible" (async ()
    (js-call (get (aref (get report :engines) 0) :viewports) :forEach (lambda (viewport)
      (let ((measured (get viewport :measured)) (failures (get viewport :failures)))
        (same failures (js-array))
        (js-call (expect (get (get measured :overflow) :scrollWidth)) :toBeLessThanOrEqual (1+ (get (get measured :overflow) :innerWidth)))
        (js-call (expect (get measured :contrast)) :toBeGreaterThanOrEqual 4.5)
        (js-call (expect (get measured :title)) :toBeTruthy)
        (if (= (get viewport :name) "desktop") (be (get (get measured :navigation) :linksVisible) t)
          (progn (be (get (get measured :navigation) :summaryVisible) t) (be (get (get measured :navigation) :linksVisible) false))))))))
  (test "the article is complete without scripts" (async ()
    (js-call (get (aref (get report :engines) 0) :viewports) :forEach (lambda (viewport)
      (js-call (expect (get (get (get viewport :measured) :withoutScripts) :articleCharacters)) :toBeGreaterThan 200)))))
  (test "the report binds the tree it describes" (async ()
    (be (get report :format) "dogfood-browser-matrix") (be (get report :version) 1)
    (js-call (expect (get report :siteFingerprint)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))
    (let* ((child (Bun/spawn (js-array "bun" "tools/browser/matrix.mjs" "--site" "examples/dogfood/_site" "--engines" "chromium" "--port" "8902" "--out" (join staging "report.json"))
             (js-object :cwd ROOT :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (be (aref result 0) 0) (be (aref result 2) "")
      (js-call (expect (aref result 1)) :toContain "narrow 320px: ok")
      (let ((written (JSON/parse (await (readFile (join staging "report.json") "utf8")))))
        (be (get written :siteFingerprint) (get report :siteFingerprint)) (same (get written :failures) (js-array))))))
  (test "the matrix rejects empty, duplicate and unknown engine selections" (async ()
    (let ((selections (js-array (js-array) (js-array "chromium" "chromium") (js-array "unknown") (js-array "toString") (js-array nil) (js-array 1))) (index 0))
      (while (< index (get selections :length))
        (await (js-call (get (expect (runMatrix (js-object :site SITE :engines (aref selections index) :port 0))) :rejects) :toThrow (new globalThis.RegExp "nonempty, unique known engines")))
        (setq index (1+ index))))))
  (test "a fingerprint failure releases the loopback listener" (async ()
    (let* ((probe (Bun/serve (js-object :hostname "127.0.0.1" :port 0 :fetch (lambda () (new globalThis.Response "probe"))))) (port (get probe :port)))
      (js-call probe :stop t)
      (await (js-call (get (expect (runMatrix (js-object :site (join staging "missing-tree") :engines (js-array "chromium") :port port))) :rejects) :toThrow (new globalThis.RegExp "ENOENT")))
      (let ((rebound (Bun/serve (js-object :hostname "127.0.0.1" :port port :fetch (lambda () (new globalThis.Response "rebound"))))))
        (try (be (get rebound :port) port) (finally (js-call rebound :stop t)))))))
)
