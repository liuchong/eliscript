(module
  tests.dogfood-identity.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:path" resolve)
  (import "../runtime/core/collection.mjs" :as collection-mod)
  (import "../runtime/literals.mjs" hashMap keyword vector)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    state
    (js-object :staging nil :identity nil :content nil))
  (defun
    k
    (name)
    (keyword name))
  (defun
    mapOf
    (entries)
    (let*
      ((flat (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((pair (aref entries (get idx :i))))
          (js-call flat :push (k (aref pair 0)))
          (js-call flat :push (aref pair 1)))
        (put idx :i (+ (get idx :i) 1)))
      (apply hashMap flat)))
  (defun
    getOf
    (value name &rest __host_default_arguments_1)
    (let* ((fallback (aref __host_default_arguments_1 0)))
    (js-call collection-mod :get value (k name) (if
        (= fallback undefined)
        nil
        fallback))))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (defun
    post
    (&rest __host_forwarded_arguments_1)
    (let* ((overrides (aref __host_forwarded_arguments_1 0)))
    (let*
      ((base (js-call globalThis.Object :assign (js-object :id "notes/shared" :slug "shared" :title "Shared" :summary "" :body "<p>body</p>" :publishedAt "2026-09-12" :updatedAt "2026-09-12" :authors (js-array "owner") :tags (js-array) :cover nil :draft false :pinnedWeight 0 :provenance (mapOf (js-array (js-array "provider" "markdown") (js-array "path" "content/posts/shared.md"))) :aliases (js-array) :commentChannels (js-array)) (or overrides (js-object)))))
      (js-call (get state :content) :__GT_Post (get base :id) (get base :slug) (get base :title) (get base :summary) (get base :body) (get base :publishedAt) (get base :updatedAt) (apply vector (get base :authors)) (apply vector (get base :tags)) (get base :cover) (get base :draft) (get base :pinnedWeight) (get base :provenance) (apply vector (get base :aliases)) (apply vector (get base :commentChannels))))))
  (defun
    issuePost
    (&rest __host_forwarded_arguments_2)
    (let* ((overrides (aref __host_forwarded_arguments_2 0)))
    (post (js-call globalThis.Object :assign (js-object :slug "shared" :provenance (mapOf (js-array (js-array "provider" "issues") (js-array "path" "owner/repository#42")))) (or overrides (js-object))))))
  (defun
    config
    (projections)
    (mapOf (js-array (js-array "identity" (mapOf (js-array (js-array "conflict" (k "fail")) (js-array "projections" (apply vector projections))))))))
  (defun
    projection
    (entries)
    (mapOf (js-call (js-array (js-array "id" "notes/shared")) :concat entries)))
  (defun
    thrownBy
    (operation)
    (try
      (progn
        (operation)
        nil)
      (catch
        error
        error)))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-identity-")))) (__ign_11 (put state :staging staging)) (built (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" staging "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get built :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get built :stderr) :trim) (js-call (get built :stdout) :trim)))))
        (put state :identity (await (funcall (js* "(u) => import(u)") (resolve staging "src/builder/identity.mjs"))))
        (put state :content (await (funcall (js* "(u) => import(u)") (resolve staging "src/builder/content.mjs")))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "distinct ids pass through unchanged" (lambda () (let*
        ((resolved (js-call (get state :identity) :resolve_identity (config (js-array)) (js-array (post (js-object :id "notes/a")) (post (js-object :id "notes/b"))))))
        (js-call (expect (js-call (js-call globalThis.Array :from resolved) :map (lambda (entry) (getOf entry "id")))) :toEqual (js-array "notes/a" "notes/b")))))
  (test "a repeated id without a declaration fails" (lambda () (let*
        ((error (thrownBy (lambda () (js-call (get state :identity) :resolve_identity (config (js-array)) (js-array (post) (issuePost)))))))
        (js-call (expect (get error :code)) :toBe "DOGFOOD-IDENTITY-001")
        (js-call (expect (get error :message)) :toContain "notes/shared"))))
  (test "a declaration resolves the conflict with the authority's article fields" (lambda () (let*
        ((resolved (js-call globalThis.Array :from (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "markdown")) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 42))))))))) (js-array (post) (issuePost (js-object :title "Shared")))))))
        (js-call (expect (get resolved :length)) :toBe 1)
        (js-call (expect (getOf (aref resolved 0) "title")) :toBe "Shared")
        (js-call (expect (getOf (aref resolved 0) "slug")) :toBe "shared"))))
  (test "a projection contributes its comment channels and aliases" (lambda () (let*
        ((ch (mapOf (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue"))))) (resolved (js-call globalThis.Array :from (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "markdown")) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 42))))))))) (js-array (post) (issuePost (js-object :commentChannels (js-array ch) :aliases (js-array "old-shared"))))))) (merged (aref resolved 0)))
        (js-call (expect (get (js-call globalThis.Array :from (getOf merged "comment-channels")) :length)) :toBe 1)
        (js-call (expect (js-call globalThis.Array :from (getOf merged "aliases"))) :toEqual (js-array "old-shared")))))
  (test "an undeclared disagreement fails" (lambda () (let*
        ((error (thrownBy (lambda () (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "markdown")) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 42))))))))) (js-array (post) (issuePost (js-object :title "Different title"))))))))
        (js-call (expect (get error :code)) :toBe "DOGFOOD-IDENTITY-004")
        (js-call (expect (get error :message)) :toContain "title"))))
  (test "a declared field is allowed to differ" (lambda () (let*
        ((resolved (js-call globalThis.Array :from (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "markdown")) (js-array "fields" (vector (k "title"))) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 42))))))))) (js-array (post) (issuePost (js-object :title "Issued title")))))))
        (js-call (expect (getOf (aref resolved 0) "title")) :toBe "Issued title"))))
  (test "a differing slug needs an alias or a declaration" (lambda () (let*
        ((error (thrownBy (lambda () (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "markdown")) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 42))))))))) (js-array (post) (issuePost (js-object :slug "renamed"))))))))
        (js-call (expect (get error :code)) :toBe "DOGFOOD-IDENTITY-005")) (let*
        ((withAlias (js-call globalThis.Array :from (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "markdown")) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 42))))))))) (js-array (post) (issuePost (js-object :slug "renamed" :aliases (js-array "renamed"))))))))
        (js-call (expect (getOf (aref withAlias 0) "slug")) :toBe "shared"))))
  (test "a projection that names an uncollected record fails" (lambda () (let*
        ((error (thrownBy (lambda () (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "markdown")) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 99))))))))) (js-array (post) (issuePost)))))))
        (js-call (expect (get error :code)) :toBe "DOGFOOD-IDENTITY-007"))))
  (test "an authority that does not carry the id fails" (lambda () (let*
        ((error (thrownBy (lambda () (js-call (get state :identity) :resolve_identity (config (js-array (projection (js-array (js-array "authority" (k "discussion")) (js-array "projections" (vector (mapOf (js-array (js-array "source" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 42))))))))) (js-array (post) (issuePost)))))))
        (js-call (expect (get error :code)) :toBe "DOGFOOD-IDENTITY-006")))))
