(module tests.persistent-zipper
  (import "bun:test" test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst root (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst units (js-array (js-array "stdlib/core/zipper.eli" "stdlib/core/zipper.eli") (js-array "tests/fixtures/persistent-zipper.eli" "tests/fixtures/persistent-zipper.mjs")))
  (defconst hostFixture (resolve root "tests/fixtures/persistent-zipper-host.mjs"))
  (defasync compileFamily (command outputRoot environment)
    (await (mkdir outputRoot (js-object :recursive t)))
    (await (symlink (resolve root "runtime") (resolve outputRoot "runtime") "dir"))
    (let ((index 0))
      (while (< index (js-length units))
        (let* ((unit (aref units index)) (target (resolve outputRoot (aref unit 1))))
          (await (mkdir (dirname target) (js-object :recursive t)))
          (await (runSuccessful (js-array command "--source-map" "--output" target (resolve root (aref unit 0))) environment)))
        (setq index (1+ index)))))
  (test "persistent zippers navigate edit and rebuild stack-safe trees" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-zipper-"))))
           (bootstrapDirectory (resolve directory "bootstrap")) (seedDirectory (resolve directory "seed")) (selfHostedDirectory (resolve directory "self-hosted")))
      (try
        (await (Promise/all (js-array (compileFamily (resolve root "bin/eliscript-seed") seedDirectory (js-object)) (seedCompilerFixture bootstrapDirectory))))
        (await (compileFamily (resolve root "bin/eliscript-portable") selfHostedDirectory (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))
        (let ((index 0))
          (while (< index (js-length units))
            (let* ((relative (aref (aref units index) 1)) (seed (resolve seedDirectory relative)) (selfHosted (resolve selfHostedDirectory relative)))
              (be (await (readFile selfHosted "utf8")) (await (readFile seed "utf8")))
              (be (await (readFile (str selfHosted ".map") "utf8")) (await (readFile (str seed ".map") "utf8"))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (directories (js-array seedDirectory selfHostedDirectory)) (index 0))
          (while (< index 2)
            (let* ((modulePath (resolve (aref directories index) "tests/fixtures/persistent-zipper.mjs"))
                   (argument modulePath))
              (js-call reports :push (runSuccessful (js-array "bun" "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs") hostFixture argument) (js-object)))
              (js-call reports :push (runSuccessful (js-array (get (get globalThis.process :env) :NODE "node") "--experimental-loader" (resolve root "tests/fixtures/compiled-eli-node-loader.mjs") hostFixture argument) (js-object))))
            (setq index (1+ index)))
          (setq reports (js-call (await (Promise/all reports)) :map (lambda (output) (JSON/parse output))))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (get (aref reports 0) :recognition) (js-array t false t))
          (same (get (aref reports 0) :navigation) (js-array 1 "vector" 2 3 2 4 1 3 2 1 1))
          (same (get (aref reports 0) :enumeration) (js-array "vector" 1 "vector" 2 3 4))
          (same (get (aref reports 0) :end) (js-array t t 4 3 t))
          (same (get (aref reports 0) :identity) (js-array t t 3 "zipper-test"))
          (same (get (aref reports 0) :edited) (js-array 1 2 20 30 40 50 4))
          (same (get (aref reports 0) :prepended) (js-array 0 2 3))
          (same (get (aref reports 0) :removed) (js-array 2 1 t 3))
          (same (get (aref reports 0) :generic) (js-array 7 10))
          (same (get (aref reports 0) :list) (js-array t t 5 6 8 "list-zipper"))
          (same (get (aref reports 0) :nullish) (js-array t t t t))
          (be (get (aref reports 0) :deep) 1)
          (same (get (aref reports 0) :errors) (js-array "zipper branch predicate must be a function" "node requires a zipper location" "children requires a branch location" "insert-left cannot insert at the root" "insert-right cannot insert at the root" "remove cannot remove the root" "replace cannot modify the end location")))

        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)

  (test "deep zipper ascent reads indexed ancestor slots without reducing wide parent vectors" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-zipper-indexed-")))) (seedDirectory (resolve directory "seed")))
      (try
        (await (compileFamily (resolve root "bin/eliscript-seed") seedDirectory (js-object)))
        (await (runSuccessful (js-array "bun" "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs")
          (resolve root "tests/fixtures/persistent-zipper-indexed-host.mjs") (resolve seedDirectory "stdlib/core/zipper.eli")) (js-object)))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
