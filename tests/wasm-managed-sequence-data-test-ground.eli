(module tests.wasm-managed-sequence-data-test-ground
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:os" tmpdir)
  (import "node:path" dirname posix resolve)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-module-graph.mjs" createManagedProjectFacades)

  (defconst root (resolve (get (js* "import.meta") :dir) ".."))
  (defconst ground-helper (resolve root "tests/helpers/wasm-managed-sequence-data-ground-node.mjs"))
  (defconst native-supported
    (and (= (get process :arch) "arm64")
         (js-call (js-array "darwin" "linux") :includes (get process :platform))))
  (defconst native-target
    (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos"))
  (defconst memory (Object/freeze (js-object :initialPages 128 :maximumPages 4096)))
  (defconst budget (Object/freeze (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)))
  (defconst entry "sequence-data.mjs")
  (defconst observations
    (js-array "bounded_consumption" "cached_realization" "successful_cache" "early_stop_and_partitions"
              "paths_aliases_and_collisions" "shared_hash_state" "ieee_arithmetic" "rejection_order"))
  (defconst original-hosts (js-array "transducer" "core-stdlib" "data-text" "value-hash"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar lowered nil)
  (defvar nativePath nil)
  (defvar wasmPath nil)
  (defvar oracleDirectory nil)
  (defconst original-sources (new globalThis.Map))
  (defconst public-modules (new globalThis.Map))

  (defun successful (engine script &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)) (timeout (aref __host_default_arguments_1 1)))
    (let* ((extra (if (undefined? args) (js-array) args))
           (limit (if (undefined? timeout) 60000 timeout))
           (env-node (get (get process :env) :NODE_BINARY))
           (command (if (= engine "bun")
                        (get process :execPath)
                        (if (nullish? env-node) "node" env-node)))
           (flags (if (= engine "bun")
                      (js-array "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
                      (js-array "--experimental-loader" (resolve root "tests/fixtures/compiled-eli-node-loader.mjs"))))
           (child (spawnSync command
                    (js-call flags :concat (js-array script) extra)
                    (js-object
                      :cwd root
                      :encoding "utf8"
                      :timeout limit
                      :env (Object/assign (js-object) (get process :env)
                             (js-object :BUN (get process :execPath)))))))
      (js-call assert :equal (get child :error) undefined)
      (js-call assert :equal (get child :status) 0
        (str (get child :stderr) "\n" (get child :stdout)))
      (js-call (get child :stdout) :trim))))

  (defun walk-dependencies (nodes result)
    (js-call nodes :forEach
      (lambda (node)
        (when (= (get node :kind) "import-declaration")
          (js-call result :push (get node :value)))
        (let ((children (get node :children)))
          (when children
            (walk-dependencies children result))))))

  (defun dependencies (program)
    (let ((result (js-array)))
      (walk-dependencies (get program :body) result)
      result))

  (defun walk-exported-names (nodes names)
    (js-call nodes :forEach
      (lambda (node)
        (cond
          ((= (get node :kind) "module-declaration")
           (walk-exported-names (get node :children) names))
          ((= (get node :kind) "export-declaration")
           (js-call (get node :children) :forEach
             (lambda (child) (js-call names :push (get child :value)))))))))

  (defun exported-names (program)
    (let ((names (js-array)))
      (walk-exported-names (get program :body) names)
      names))

  (defasync write-out (path source)
    (await (mkdir (dirname path) (js-object :recursive t)))
    (await (writeFile path source)))

  (defasync add-module (modules id filename &rest __host_forwarded_arguments_1)
    (let* ((source (aref __host_forwarded_arguments_1 0)))
    (when (not (js-call modules :has id))
      (let* ((src-text (if (nullish? source)
                           (await (readFile (resolve root filename) "utf8"))
                           source))
             (program (js-call (get backend :compiler) :compile_ir_string src-text filename))
             (deps (dependencies program))
             (idx 0))
        (js-call modules :set id (js-object :id id :program program))
        (await (write-out (resolve oracleDirectory id)
                 (js-call (get backend :compiler) :emit_ir_string program)))
        (while (< idx (get deps :length))
          (let ((specifier (aref deps idx)))
            (when (js-call specifier :startsWith ".")
              (let ((target (js-call posix :normalize
                              (js-call posix :join (js-call posix :dirname id) specifier))))
                (when (not (js-call target :startsWith "runtime/"))
                  (funcall assert
                    (not (js-call target :startsWith "../"))
                    (str "fixture dependency escapes its source root: " target))
                  (let ((source-path (if (js-call target :endsWith ".mjs")
                                         (str (js-call target :slice 0 -4) ".eli")
                                         target)))
                    (await (add-module modules target source-path)))))))
          (setq idx (+ idx 1)))))))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-sequence-data-"))))
      (setq backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
      (let* ((loaded (await (js-call backend :loadLiteralModules)))
             (literal-sources (get loaded :literalSources))
             (literal-modules (get loaded :literalModules))
             (idx 0))
        (js-call assert :equal (get literal-sources :length) (get literal-modules :length))
        (while (< idx (get literal-sources :length))
          (js-call assert :equal
            (get (aref literal-sources idx) :id)
            (get (aref literal-modules idx) :id))
          (js-call assert :equal
            (get (aref literal-sources idx) :source)
            (await (readFile (resolve root (get (aref literal-sources idx) :filename)) "utf8")))
          (setq idx (+ idx 1)))
        (let ((modules (new globalThis.Map)))
          (setq oracleDirectory (resolve directory "oracle"))
          (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
          (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
          (let ((filtered (js-call literal-modules :filter
                            (lambda (item)
                              (js-call (new globalThis.RegExp "^runtime\\/(?:core|testing)\\/.+\\.mjs$")
                                :test (get item :id)))))
                (r-idx 0))
            (while (< r-idx (get filtered :length))
              (let* ((record (aref filtered r-idx))
                     (names (exported-names (get record :program)))
                     (specifier (str "eliscript/" (get record :id)))
                     (id (str "public/" (get record :id))))
                (funcall assert (> (get names :length) 0)
                  (str (get record :id) " must expose its actual public contract"))
                (await (add-module modules id (str "sequence-data-public/" (get record :id))
                         (str "(import " (JSON/stringify specifier) " " (js-call names :join " ") ")\n"
                              "(export " (js-call names :join " ") ")\n")))
                (js-call public-modules :set (get record :id) id))
              (setq r-idx (+ r-idx 1))))
          (await (add-module modules entry "tests/fixtures/wasm-managed-sequence-data.eli"))
          (await (add-module modules "tests/fixtures/lazy-sequence.mjs" "tests/fixtures/lazy-sequence.eli"))
          (await (add-module modules "core-set-usage.mjs" "tests/fixtures/core-set-usage.eli"))
          (let ((families (js-array "sequence" "text" "object"))
                (f-idx 0))
            (while (< f-idx (get families :length))
              (let ((family (aref families f-idx)))
                (await (add-module modules (str family ".mjs") (str "stdlib/" family ".eli")))
                (when (= family "object")
                  (await (add-module modules "data.mjs" "stdlib/data.eli")))
                (await (add-module modules (str family "-usage.mjs") (str "tests/fixtures/" family "-usage.eli"))))
              (setq f-idx (+ f-idx 1))))
          (let ((host-names (js-call original-hosts :concat
                              (js-array "lazy-sequence" "core-text-object" "core-set-usage")))
                (h-idx 0))
            (while (< h-idx (get host-names :length))
              (let ((name (aref host-names h-idx)))
                (js-call original-sources :set name
                  (await (readFile (resolve root (str "tests/fixtures/" name "-host.mjs")) "utf8"))))
              (setq h-idx (+ h-idx 1))))
          (let* ((runtime (js-call (get backend :compiler) :compile_ir_string
                            (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8"))
                            "runtime.eli"))
                 (input (Array/from (js-call modules :values)))
                 (saved (globalThis.structuredClone input))
                 (library (globalThis.structuredClone literal-modules)))
            (setq lowered
              (js-call (get backend :managed) :lower_managed_project
                input entry runtime
                (js-object :literalModules literal-modules :phased t)))
            (js-call assert :deepEqual input saved)
            (js-call assert :deepEqual literal-modules library)
            (let ((bytes (Uint8Array/from
                           (js-call (get backend :wasm) :append_metadata_section
                             (js-call (get backend :wasm) :emit_typed_memory_wasm
                               (get lowered :typed) memory)
                             "eliscript-managed-control"
                             (JSON/stringify (get lowered :descriptor))))))
              (js-call assert :deepEqual
                (WebAssembly.Module/imports (new WebAssembly.Module bytes))
                (js-array))
              (setq wasmPath (resolve directory "sequence-data.wasm"))
              (await (writeFile wasmPath bytes))
              (await (writeFile (resolve directory "lowered.json") (JSON/stringify lowered)))
              (when native-supported
                (setq nativePath
                  (resolve directory
                    (if (= (get process :platform) "linux") "sequence-data.so" "sequence-data.dylib")))
                (await (writeFile nativePath
                         (Uint8Array/from
                           (js-call (get backend :native) :emit_typed_native_memory_library
                             (get lowered :typed) native-target))))))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun selected-imports (source deployment)
    (js-call source :replace
      (new globalThis.RegExp "from ([\"'])(?:\\.\\.\\/)+runtime\\/(core|testing)\\/([^\"']+)\\1" "g")
      (lambda (_all _quote family filename)
        (let ((id (js-call public-modules :get (str "runtime/" family "/" filename))))
          (funcall assert id (str "the complete original host requires an actual target module: " filename))
          (str "from " (JSON/stringify (get (pathToFileURL (resolve deployment id)) :href)))))))

  (defasync prepare (host label)
    (let* ((deployment (resolve directory (str host "-" label)))
           (files (get (createManagedProjectFacades (get lowered :descriptor) (js-object :entry entry)) :files))
           (idx 0))
      (await (mkdir deployment (js-object :recursive t)))
      (while (< idx (get files :length))
        (let ((file (aref files idx)))
          (await (write-out (resolve deployment (get file :id)) (get file :source))))
        (setq idx (+ idx 1)))
      deployment))

  (defasync run-selected-config (host engine deployment submode &rest __host_default_arguments_2)
    (let* ((target-url (aref __host_default_arguments_2 0)) (args (aref __host_default_arguments_2 1)))
    (let ((config-path (resolve deployment "run-config.json"))
          (resolved-args (if (undefined? args)
                             (js-array)
                             (js-call args :map (lambda (id) (resolve deployment id))))))
      (await (writeFile config-path
               (JSON/stringify
                 (js-object
                   :host host
                   :submode submode
                   :targetUrl target-url
                   :args resolved-args
                   :observations observations
                   :loweredPath (resolve directory "lowered.json")
                   :wasmPath wasmPath
                   :nativePath nativePath
                   :entry entry
                   :projectModuleBaseURL (get (pathToFileURL (str deployment "/")) :href)
                   :runtimeOptions (Object/assign (js-object) memory budget
                                     (js-object :initializeModule false :nativeTarget native-target))))))
      (successful engine ground-helper (js-array "selected" config-path)))))

  (defasync run-selected (host engine label source &rest __host_forwarded_arguments_2)
    (let* ((args (aref __host_forwarded_arguments_2 0)))
    (let* ((deployment (await (prepare host (str label "-" engine))))
           (body-path (resolve deployment "original-host.mjs")))
      (await (writeFile body-path (selected-imports source deployment)))
      (await (run-selected-config host engine deployment "import"
               (get (pathToFileURL body-path) :href) args)))))

  (defasync run-reference (engine label source &rest __host_default_arguments_3)
    (let* ((args (aref __host_default_arguments_3 0)))
    (let* ((script (resolve directory (str "reference-" label "-" engine ".mjs")))
           (rewritten (js-call source :replace
                        (new globalThis.RegExp "from ([\"'])(\\.\\.\\/\\.\\.\\/runtime\\/[^\"']+)\\1" "g")
                        (lambda (_all _quote relative)
                          (str "from "
                               (JSON/stringify
                                 (get (pathToFileURL (resolve root "tests/fixtures" relative)) :href))))))
           (resolved-args (if (undefined? args)
                              (js-array)
                              (js-call args :map (lambda (id) (resolve oracleDirectory id))))))
      (await (writeFile script rewritten))
      (successful engine script resolved-args))))

  (js-call (js-array "wasm" "native") :forEach
    (lambda (host)
      (let ((actualTest (js-call test :skipIf (and (= host "native") (not native-supported)))))
        (js-call (js-array "bun" "node") :forEach
          (lambda (engine)
            (js-call original-hosts :forEach
              (lambda (name)
                (funcall actualTest (str host "/" engine ": complete original " name " host corpus")
                  (async ()
                    (let* ((source (js-call original-sources :get name))
                           (reference (await (run-reference engine name source)))
                           (actual (await (run-selected host engine name source))))
                      (js-call assert :deepEqual (JSON/parse actual) (JSON/parse reference))
                      (when (= name "value-hash")
                        (js-call assert :deepEqual
                          (JSON/parse actual)
                          (JSON/parse (await (readFile (resolve root "tests/fixtures/value-hashes.json") "utf8")))))))
                  60000)))
            (funcall actualTest (str host "/" engine ": complete original compiled lazy-sequence fixture")
              (async ()
                (let ((source (js-call original-sources :get "lazy-sequence"))
                      (args (js-array "tests/fixtures/lazy-sequence.mjs")))
                  (js-call assert :deepEqual
                    (JSON/parse (await (run-selected host engine "lazy" source args)))
                    (JSON/parse (await (run-reference engine "lazy" source args))))))
              60000)
            (funcall actualTest (str host "/" engine ": complete original core text/object host corpus")
              (async ()
                (let ((source (js-call original-sources :get "core-text-object"))
                      (args (js-array "public/runtime/core/text.mjs" "public/runtime/core/object.mjs")))
                  (js-call assert :deepEqual
                    (JSON/parse (await (run-selected host engine "text-object" source args)))
                    (JSON/parse (await (run-reference engine "text-object" source args))))))
              60000)
            (js-call (js-array "sequence" "text" "object") :forEach
              (lambda (family)
                (funcall actualTest (str host "/" engine ": entire original portable " family " usage")
                  (async ()
                    (let* ((id (str family "-usage.mjs"))
                           (reference (successful engine (resolve oracleDirectory id)))
                           (deployment (await (prepare host (str "portable-" family "-" engine))))
                           (actual (await (run-selected-config host engine deployment "import"
                                            (get (pathToFileURL (resolve deployment id)) :href)))))
                      (js-call assert :deepEqual (JSON/parse actual) (JSON/parse reference))))
                  60000)))
            (funcall actualTest (str host "/" engine ": original relational set complete usage and host observations")
              (async ()
                (let ((source (js-call original-sources :get "core-set-usage"))
                      (args (js-array "core-set-usage.mjs")))
                  (js-call assert :deepEqual
                    (JSON/parse (await (run-selected host engine "set" source args)))
                    (JSON/parse (await (run-reference engine "set" source args))))))
              60000)
            (funcall actualTest (str host "/" engine ": internal infinite, cache, close, metadata, paths, metrics and IEEE observations")
              (async ()
                (let* ((reference
                         (JSON/parse
                           (successful engine ground-helper
                             (js-array "reference-boundaries"
                               (resolve oracleDirectory entry)
                               (JSON/stringify observations)))))
                       (deployment (await (prepare host (str "boundaries-" engine))))
                       (actual
                         (JSON/parse
                           (await (run-selected-config host engine deployment "boundaries"
                                    undefined (js-array entry))))))
                  (js-call assert :deepEqual actual reference)
                  (js-call assert :deepEqual (get actual :bounded_consumption)
                    (js-array (js-array 1 2 3) (js-object :pulls 3 :closes 1) 7 (js-object :pulls 0 :closes 0) (js-array 0 1 2 3 4)))
                  (js-call assert :deepEqual (get actual :cached_realization)
                    (js-array 1 2 (js-array 1 2) 1 (js-object :pulls 3 :closes 1) t t t 2))
                  (js-call assert :deepEqual (get actual :successful_cache)
                    (js-array (js-array false 0) (js-array 20 40 60) (js-array 20 40 60) 1 3 t t 3))
                  (js-call assert :equal (aref (get actual :rejection_order) 0) t)
                  (js-call assert :deepEqual (aref (get actual :rejection_order) 1) (js-array 1))
                  (js-call assert :deepEqual (aref (get actual :rejection_order) 2) (js-object :pulls 1 :closes 1))
                  (js-call assert :deepEqual
                    (js-call (get actual :ieee_arithmetic) :slice 0 5)
                    (js-array
                      (js-object :$number "-0")
                      (js-object :$number "-Infinity")
                      (js-object :$number "NaN")
                      (js-object :$number "+Infinity")
                      (js-object :$number "NaN")))))
              60000)
            (funcall actualTest (str host "/" engine ": standard print/compare slots keep identity in both boundary directions")
              (async ()
                (let* ((deployment (await (prepare host (str "standard-protocols-" engine))))
                       (actual (await (run-selected-config host engine deployment "standard-protocols"
                                        undefined (js-array entry)))))
                  (js-call assert :equal actual "standard identities preserved")))
              60000)))))))
