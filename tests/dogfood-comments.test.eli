(module
  tests.dogfood-comments.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:path" resolve)
  (import "../runtime/core/collection.mjs" :as collection-mod)
  (import "../runtime/literals.mjs" hashMap keyword vector)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    state
    (js-object :staging nil :comments nil :issuesModule nil :renderer nil))
  (defun
    k
    (name)
    (keyword name))
  (defun
    mapOf
    (entries)
    (let*
      ((flat (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((pair (aref entries (get idx :i))))
          (js-call flat :push (k (aref pair 0)))
          (js-call flat :push (aref pair 1)))
        (put idx :i (+ (get idx :i) 1)))
      (apply hashMap flat)))
  (defun
    getOf
    (value name &rest __host_default_arguments_1)
    (let* ((fallback (aref __host_default_arguments_1 0)))
    (js-call collection-mod :get value (k name) (if
        (= fallback undefined)
        nil
        fallback))))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (defasync
    build
    (entry outDir)
    (let*
      ((result (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" outDir entry)))))
      (when
        (not= (get result :exitCode) 0)
        (throw (new globalThis.Error (or (js-call (get result :stderr) :trim) (js-call (get result :stdout) :trim)))))))
  (defun
    commentRecord
    (id &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (js-call globalThis.Object :assign (js-object :id id :body "A **bold** comment." :created_at "2026-09-13T10:00:00Z" :updated_at "2026-09-13T10:00:00Z" :html_url (str "https://github.com/owner/repository/issues/12#issuecomment-" id) :user (js-object :login "reader" :html_url "https://github.com/reader")) (or options (js-object)))))
  (defun
    transportOf
    (pages)
    (let*
      ((requested (js-array)))
      (js-object :requested requested :transport (lambda (url) (js-call requested :push url) (let*
            ((page-param (or (js-call (get (new globalThis.URL url) :searchParams) :get "page") "1")) (page (aref pages (- (globalThis.Number page-param) 1))))
            (if
              (= page undefined)
              (js-object :status 404 :headers (js-object) :body (js-array))
              (js-object :status 200 :headers (if
                  (get page :next)
                  (js-object :link (str "<" (get page :next) ">; rel=\"next\""))
                  (js-object)) :body (get page :records))))))))
  (defun
    declaration
    (entries)
    (mapOf entries))
  (defun
    channel
    (entries)
    (mapOf entries))
  (defun
    post
    (channels)
    (mapOf (js-array (js-array "comment-channels" (apply vector channels)))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-comments-")))))
        (put state :staging staging)
        (await (build "examples/dogfood/src/builder/main.eli" staging))
        (put state :comments (await (funcall (js* "(u) => import(u)") (resolve staging "src/builder/comments.mjs"))))
        (put state :issuesModule (await (funcall (js* "(u) => import(u)") (resolve staging "src/builder/issues.mjs"))))
        (put state :renderer (await (funcall (js* "(u) => import(u)") (resolve staging "src/renderer/server.mjs")))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "a comment normalizes to the canonical flat shape" (lambda () (let*
        ((comments (get state :comments)) (normalized (js-call comments :normalize_comment (commentRecord 1 (js-object :body "A **bold** comment with <script>alert(1)</script> markup.")))))
        (js-call (expect (getOf normalized "id")) :toBe 1)
        (js-call (expect (getOf (getOf normalized "author") "login")) :toBe "reader")
        (js-call (expect (getOf normalized "body")) :toContain "<strong>bold</strong>")
        (js-call (get (expect (getOf normalized "body")) :not) :toContain "<script>")
        (js-call (expect (js-call globalThis.Array :from (getOf normalized "replies"))) :toEqual (js-array)))))
  (test "an enabled declaration is found and a disabled one is not" (lambda () (let*
        ((comments (get state :comments)) (config (mapOf (js-array (js-array "channels" (vector (declaration (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "enabled" false) (js-array "mode" (k "snapshot")))) (declaration (js-array (js-array "id" (k "utterances")) (js-array "kind" (k "utterances")) (js-array "enabled" t) (js-array "mode" (k "embed"))))))))))
        (js-call (get (expect (js-call comments :channel_declaration config (k "utterances"))) :not) :toBeNull)
        (js-call (expect (js-call comments :channel_declaration config (k "issue"))) :toBeNull)
        (js-call (expect (js-call comments :channel_declaration config (k "giscus"))) :toBeNull))))
  (test "a live channel is declared but never fetched" (async () (let*
        ((comments (get state :comments)) (tp (transportOf (js-array))) (ch (await (js-call comments :native_channel (mapOf (js-array (js-array "comments" (mapOf (js-array (js-array "channels" (vector (declaration (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "enabled" t) (js-array "mode" (k "live"))))))))) (js-array "kind" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 12) (js-array "transport" (get tp :transport))))))))
        (js-call (expect (getOf ch "mode")) :toBe (k "live"))
        (js-call (expect (js-call globalThis.Array :from (getOf ch "items"))) :toEqual (js-array))
        (js-call (expect (get (get tp :requested) :length)) :toBe 0))))
  (test "a snapshot channel fetches, normalizes, and reports freshness" (async () (let*
        ((comments (get state :comments)) (tp (transportOf (js-array (js-object :records (js-array (commentRecord 1) (commentRecord 2 (js-object :updated_at "2026-09-14T08:30:00Z"))))))) (ch (await (js-call comments :native_channel (mapOf (js-array (js-array "comments" (mapOf (js-array (js-array "channels" (vector (declaration (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "enabled" t) (js-array "mode" (k "snapshot"))))))))) (js-array "kind" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 12) (js-array "transport" (get tp :transport))))))))
        (js-call (expect (getOf ch "mode")) :toBe (k "snapshot"))
        (js-call (expect (getOf ch "count")) :toBe 2)
        (js-call (expect (getOf ch "updated-at")) :toBe "2026-09-14T08:30:00Z")
        (js-call (expect (aref (get tp :requested) 0)) :toContain "/issues/12/comments")
        (let*
          ((items (js-call globalThis.Array :from (getOf ch "items"))))
          (js-call (expect (js-call items :map (lambda (item) (getOf item "id")))) :toEqual (js-array 1 2))))))
  (test "comment pagination completes or fails" (async () (let*
        ((comments (get state :comments)) (twoPages (transportOf (js-array (js-object :records (js-array (commentRecord 1)) :next "https://api.github.com/x?page=2") (js-object :records (js-array (commentRecord 2)))))) (ch (await (js-call comments :native_channel (mapOf (js-array (js-array "comments" (mapOf (js-array (js-array "channels" (vector (declaration (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "enabled" t) (js-array "mode" (k "snapshot"))))))))) (js-array "kind" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 12) (js-array "transport" (get twoPages :transport))))))))
        (js-call (expect (getOf ch "count")) :toBe 2)
        (let*
          ((failing (transportOf (js-array (js-object :records (js-array (commentRecord 1)) :next "https://api.github.com/x?page=2")))) (error (try
                (progn
                  (await (js-call comments :native_channel (mapOf (js-array (js-array "comments" (mapOf (js-array (js-array "channels" (vector (declaration (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "enabled" t) (js-array "mode" (k "snapshot"))))))))) (js-array "kind" (k "issue")) (js-array "repository" "owner/repository") (js-array "number" 12) (js-array "transport" (get failing :transport))))))
                  nil)
                (catch
                  thrown
                  thrown))))
          (js-call (expect (get error :code)) :toBe "DOGFOOD-GITHUB-001")))))
  (test "a collected issue carries its comment channel" (async () (let*
        ((issuesModule (get state :issuesModule)) (metadata (js-call (js-array "```dogfood" "id: notes/issued" "title: Issued" "date: 2026-09-12" "```" "" "Body." "") :join "\n")) (listing (js-array (js-object :number 12 :html_url "https://github.com/owner/repository/issues/12" :created_at "2026-09-12T00:00:00Z" :updated_at "2026-09-12T00:00:00Z" :user (js-object :login "owner" :id "U_owner" :type "User") :body metadata))) (commentTransport (transportOf (js-array (js-object :records (js-array (commentRecord 1)))))) (routed (lambda (url) (if
                (js-call url :includes "/comments")
                (js-call commentTransport :transport url)
                (js-object :status 200 :headers (js-object) :body listing)))) (result (await (js-call issuesModule :collect_issues (mapOf (js-array (js-array "source" (mapOf (js-array (js-array "repository" "owner/repository") (js-array "label" "blog")))) (js-array "publishing" (mapOf (js-array (js-array "owner" (mapOf (js-array (js-array "login" "owner") (js-array "id" "U_owner")))) (js-array "coauthors" (vector))))) (js-array "adapters" (vector)) (js-array "identities" (vector)) (js-array "comments" (mapOf (js-array (js-array "channels" (vector (declaration (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "enabled" t) (js-array "mode" (k "snapshot"))))))))) (js-array "transport" routed)))))) (posts (js-call globalThis.Array :from (getOf result "posts"))))
        (js-call (expect (get posts :length)) :toBe 1)
        (let*
          ((channels (js-call globalThis.Array :from (getOf (aref posts 0) "comment-channels"))))
          (js-call (expect (get channels :length)) :toBe 1)
          (js-call (expect (getOf (aref channels 0) "mode")) :toBe (k "snapshot"))
          (js-call (expect (getOf (aref channels 0) "count")) :toBe 1)))))
  (test "a snapshot renders its comments" (lambda () (let*
        ((renderer (get state :renderer)) (markup (js-call renderer :render_comment_channels (post (js-array (channel (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "mode" (k "snapshot")) (js-array "count" 2) (js-array "updated-at" "2026-09-14T08:30:00Z") (js-array "items" (vector (channel (js-array (js-array "id" 1) (js-array "body" "<p>First</p>") (js-array "author" (mapOf (js-array (js-array "login" "reader")))) (js-array "created-at" "2026-09-13T10:00:00Z") (js-array "updated-at" "2026-09-13T10:00:00Z") (js-array "url" "https://github.com/owner/repository/issues/12#issuecomment-1"))) (channel (js-array (js-array "id" 2) (js-array "body" "<p>Second</p>") (js-array "author" (mapOf (js-array (js-array "login" "owner")))) (js-array "created-at" "2026-09-14T08:30:00Z") (js-array "updated-at" "2026-09-14T08:30:00Z") (js-array "url" nil))))))))))))
        (js-call (expect markup) :toContain "data-comment-provider=\"GitHub Issues\"")
        (js-call (expect markup) :toContain "Comments (2)")
        (js-call (expect markup) :toContain "Snapshot from 2026-09-14T08:30:00Z")
        (js-call (expect markup) :toContain "<p>First</p>")
        (js-call (expect markup) :toContain "reader")
        (js-call (get (expect markup) :not) :toContain "<ul"))))
  (test "a live channel explains itself without pretending to have comments" (lambda () (let*
        ((renderer (get state :renderer)) (markup (js-call renderer :render_comment_channels (post (js-array (channel (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "mode" (k "live")) (js-array "binding" (mapOf (js-array (js-array "repository" "owner/repository") (js-array "number" 12)))) (js-array "count" nil) (js-array "updated-at" nil) (js-array "items" (vector)))))))))
        (js-call (expect markup) :toContain "data-comments-binding=\"owner/repository#12\"")
        (js-call (expect markup) :toContain "served live")
        (js-call (expect markup) :toContain "never triggers a build")
        (js-call (get (expect markup) :not) :toContain "comments-list"))))
  (test "an external adapter declares its mount region and nothing else" (lambda () (let*
        ((renderer (get state :renderer)) (markup (js-call renderer :render_comment_channels (post (js-array (channel (js-array (js-array "id" (k "utterances")) (js-array "kind" (k "utterances")) (js-array "mode" (k "embed")) (js-array "binding" (mapOf (js-array (js-array "repository" "owner/repository") (js-array "number" 12)))) (js-array "items" (vector)))))))))
        (js-call (expect markup) :toContain "data-comment-provider=\"utterances\"")
        (js-call (expect markup) :toContain "browser loads that provider")
        (js-call (get (expect markup) :not) :toContain "<script"))))
  (test "a channel with no comments says so" (lambda () (let*
        ((renderer (get state :renderer)) (markup (js-call renderer :render_comment_channels (post (js-array (channel (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "mode" (k "snapshot")) (js-array "count" 0) (js-array "updated-at" "") (js-array "items" (vector)))))))))
        (js-call (expect markup) :toContain "No comments in this snapshot."))))
  (test "a post without channels renders nothing" (lambda () (let*
        ((renderer (get state :renderer)))
        (js-call (expect (js-call renderer :render_comment_channels (post (js-array)))) :toBe "")))))
