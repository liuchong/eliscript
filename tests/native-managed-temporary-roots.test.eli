(module tests.native-managed-temporary-roots.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "./helpers/managed-temporary-roots.mjs" temporaryRootSource temporaryRootOptions initializeTemporaryRootRuntime
    exerciseTemporaryRootPressure exerciseTemporaryRootValues closeTemporaryRootRuntime)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst native-function (js* "(implementation) => function() { return implementation(); }"))
  (defconst target (if (= (get globalThis.process :arch) "arm64")
    (if (= (get globalThis.process :platform) "darwin") "arm64-macos" (if (= (get globalThis.process :platform) "linux") "arm64-linux" undefined)) undefined))
  (defconst nativeTest (js-call test :skipIf (= target undefined)))
  (defvar directory undefined) (defvar path undefined) (defvar lowered undefined) (defvar reference undefined)
  (beforeAll (async ()
    (unless (= target undefined)
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-temporary-roots-"))))
      (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
             (runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
             (program (js-call (get backend :compiler) :compile_ir_string temporaryRootSource "temporary-roots.eli")))
        (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime))
        (let ((bytes (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) target)))
          (setq path (resolve directory (if (= target "arm64-linux") "temporary-roots.so" "temporary-roots.dylib")))
          (await (writeFile path (Uint8Array/from bytes))))
        (setq reference (await (funcall load-module (str "data:text/javascript;base64,"
          (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program)) :toString "base64")))))))) 120000)
  (afterAll (async () (unless (nullish? directory) (await (rm directory (js-object :recursive t :force t))))))
  (defasync instance ()
    (let ((Module (get globalThis.WebAssembly :Module)) (Instance (get globalThis.WebAssembly :Instance)))
      (try
        (put globalThis.WebAssembly :Module (funcall native-function (lambda () (throw (new globalThis.Error "native temporary-root test substituted WASM")))))
        (put globalThis.WebAssembly :Instance (funcall native-function (lambda () (throw (new globalThis.Error "native temporary-root test substituted WASM")))))
        (await (instantiateNativeManagedRuntime path lowered (copyHostRecord temporaryRootOptions (js-object :initialPages 1 :maximumPages 8 :nativeTarget target))))
        (finally (put globalThis.WebAssembly :Module Module) (put globalThis.WebAssembly :Instance Instance)))))
  (funcall nativeTest "native clears completed initializer and assignment temporaries under the original small capacity and recovers" (async ()
    (let ((a (await (instance)))) (try (initializeTemporaryRootRuntime a) (exerciseTemporaryRootPressure a reference) (finally (closeTemporaryRootRuntime a))))) 30000)
  (funcall nativeTest "native keeps returned assignment aliases captured cells user temporary bindings and first errors alive through GC" (async ()
    (let ((a (await (instance)))) (try (initializeTemporaryRootRuntime a) (exerciseTemporaryRootValues a reference) (finally (closeTemporaryRootRuntime a))))) 30000)
)
