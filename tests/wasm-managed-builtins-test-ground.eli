(module tests.wasm-managed-builtins-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst node-helper (resolve "tests/helpers/wasm-managed-builtins-node.mjs"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar program nil)
  (defvar js nil)
  (defvar javascript nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-builtins-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get b :compiler) :compile_ir_string
                      (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                      "runtime.eli"))
      (setq program (js-call (get b :compiler) :compile_ir_string
                      (await (readFile "tests/fixtures/wasm-managed-builtins.eli" "utf8"))
                      "builtins.eli"))
      (setq javascript (js-call (get b :compiler) :emit_ir_string program))
      (setq js (await (funcall dyn-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from javascript) :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun box (a value)
    (let ((ty (funcall js-typeof value)))
      (cond
        ((= ty "number") (js-call a :number value))
        ((= ty "string") (js-call a :string value))
        (t value))))

  (defun read-val (a value)
    (let ((kind (if (nullish? value) undefined (get value :kind))))
      (cond
        ((= kind 4) (js-call a :readNumber value))
        ((= kind 5) (js-call a :readString value))
        (t value))))

  (defun instance (&rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((before (JSON/stringify program))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program runtime)))
           (a (instantiateManagedRuntime bytes options)))
      (js-call assert :equal (JSON/stringify program) before)
      (js-call assert :deepEqual
        (WebAssembly.Module/imports (new WebAssembly.Module bytes))
        (js-array))
      (js-call a :auto 1)
      (js-object :a a :bytes bytes))))

  (defun finish (a &rest __host_default_arguments_1)
    (let* ((values (aref __host_default_arguments_1 0)) (close-mod (aref __host_default_arguments_1 1)))
    (let ((vals (if (undefined? values) (js-array) values))
          (do-close (if (undefined? close-mod) t close-mod)))
      (js-call vals :forEach (lambda (value) (js-call a :release value)))
      (when do-close
        (js-call a :closeModule))
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defun check (a name value expected)
    (let* ((input (box a value))
           (out (js-call a :invoke name (js-array input))))
      (funcall assert
        (Object/is (read-val a out) expected)
        (str name ": " (globalThis.String value)))
      (js-call a :release input)
      (js-call a :release out)
      (js-call a :collect)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (defconst primitives
    (js-array
      undefined nil false t "" " " "-0" "0x10" "1.e2" "x"
      (String/fromCharCode 55296)
      (str (String/fromCharCode 8232) ".5" (String/fromCharCode 65279))
      globalThis.NaN globalThis.Infinity (- globalThis.Infinity) -0 0
      (get globalThis.Number :MIN_VALUE)
      (- (get globalThis.Number :MIN_VALUE))
      (get globalThis.Number :MAX_VALUE)
      (get globalThis.Number :MAX_SAFE_INTEGER)
      (+ (get globalThis.Number :MAX_SAFE_INTEGER) 1)
      1.5 -1.5))

  (test "independent Node confirms the original global calls before WASM lowering"
    (async ()
      (let ((file (resolve directory "source.mjs")))
        (await (writeFile file javascript))
        (let ((child (spawnSync "node"
                       (js-array node-helper "js" (get (pathToFileURL file) :href))
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "raw Number and primitive constructors retain missing arguments, ignored effects and exact conversions"
    (lambda ()
      (let* ((inst (instance))
             (a (get inst :a)))
        (js-call primitives :forEach
          (lambda (x)
            (check a "number-call" x (js-call js :number_call x))
            (check a "string-call" x (js-call js :string_call x))
            (check a "boolean-call" x (js-call js :boolean_call x))))
        (js-call (js-array "number-empty" "string-empty" "boolean-empty") :forEach
          (lambda (name)
            (let ((out (js-call a :invoke name))
                  (js-fn (get js (js-call name :replaceAll "-" "_"))))
              (funcall assert (Object/is (read-val a out) (funcall js-fn)))
              (js-call a :release out))))
        (let* ((text (js-call a :string "42"))
               (trace (js-call a :sourceObject (js-object)))
               (out (js-call a :invoke "number-extra" (js-array text trace)))
               (key (js-call a :string "visited"))
               (visited (js-call a :objectGet trace key)))
          (js-call assert :equal (js-call a :readNumber out) 42)
          (js-call assert :equal (js-call a :readNumber visited) 7)
          (finish a (js-array text trace out key visited))))))

  (test "Number predicates never coerce while global isFinite and isNaN do, including IEEE boundaries"
    (lambda ()
      (let* ((inst (instance))
             (a (get inst :a))
             (methods (js-array "finite-call" "nan-call" "integer-call" "safe-call" "coercive-finite" "coercive-nan"))
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (seed 2081555365)
             (next-u32 (lambda ()
                         (setq seed (unsigned-bit-shift-right (+ (Math/imul seed 1664525) 1013904223) 0))
                         seed))
             (inputs (js-call primitives :concat
                       (js-array
                         (Math/pow 2 31)
                         (Math/pow 2 32)
                         (Math/pow 2 52)
                         (Math/pow 2 53)
                         (- (Math/pow 2 53))
                         (- 1 (Math/pow 2 -53))
                         (Math/pow 2 -52))))
             (i 0))
        (while (< i 2048)
          (js-call bits :setUint32 0 (funcall next-u32) t)
          (js-call bits :setUint32 4 (funcall next-u32) t)
          (js-call inputs :push (js-call bits :getFloat64 0 t))
          (setq i (+ i 1)))
        (js-call inputs :forEach
          (lambda (x)
            (js-call methods :forEach
              (lambda (name)
                (let ((js-fn (get js (js-call name :replaceAll "-" "_"))))
                  (check a name x (funcall js-fn x)))))))
        (let ((array (js-call a :sourceArray (js-array)))
              (object (js-call a :sourceObject (js-object)))
              (f (js-call a :getExport "number-value")))
          (js-call (js-array array object f) :forEach
            (lambda (value)
              (js-call (js-array "finite-call" "nan-call" "integer-call" "safe-call") :forEach
                (lambda (name)
                  (js-call assert :equal (js-call a :invoke name (js-array value)) false)))
              (js-call assert :equal (js-call a :invoke "boolean-call" (js-array value)) t)))
          (finish a (js-array array object f))))))

  (test "first-class builtins preserve identity, captures, apply and callback extra arguments through GC"
    (lambda ()
      (let* ((inst (instance))
             (a (get inst :a))
             (closure (js-call a :invoke "held-number"))
             (text (js-call a :string "-0")))
        (js-call assert :equal (js-call a :invoke "same-number") t)
        (js-call assert :equal (js-call a :invoke "same-finite") t)
        (js-call a :collect)
        (let* ((converted (js-call a :invoke "invoke-one" (js-array closure text)))
               (values (js-call a :sourceArray (js-array text t nil)))
               (mapped (js-call a :invoke "number-map" (js-array values)))
               (expected-nums (js-array -0 1 0))
               (finite (js-call a :invoke "finite-map" (js-array values)))
               (empty (js-call a :sourceArray (js-array)))
               (zero (js-call a :invoke "number-apply" (js-array empty)))
               (args (js-call a :sourceArray (js-array undefined)))
               (nan (js-call a :invoke "number-apply" (js-array args))))
          (funcall assert (Object/is (js-call a :readNumber converted) -0))
          (js-call expected-nums :forEach
            (lambda (expected index)
              (let ((x (js-call a :get mapped index)))
                (funcall assert (Object/is (js-call a :readNumber x) expected))
                (js-call a :release x))))
          (let ((i 0))
            (while (< i 3)
              (js-call assert :equal (js-call a :get finite i) false)
              (setq i (+ i 1))))
          (js-call assert :equal (js-call a :readNumber zero) 0)
          (funcall assert (Number/isNaN (js-call a :readNumber nan)))
          (js-call assert :equal (js-call a :invoke "array-call" (js-array values)) t)
          (js-call assert :equal (js-call a :invoke "array-call" (js-array text)) false)
          (finish a (js-array closure text converted values mapped finite empty zero args nan))))))

  (test "lexical and project shadows retain the original bindings instead of invoking global builtins"
    (async ()
      (let* ((source "(defconst Number (lambda (x) 17)) (defun f (x) (funcall (js* \"Number\") x)) (defun local (x) (let ((Number (lambda (x) 23))) (funcall (js* \"Number\") x))) (defun predicate (Number x) (funcall (js* \"Number.isFinite\") x)) (export f local predicate)")
             (p (js-call (get b :compiler) :compile_ir_string source "shadow.eli"))
             (reference (await (funcall dyn-import
                                 (str "data:text/javascript;base64,"
                                      (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64")))))
             (entry (js-call (get b :compiler) :compile_ir_string
                      "(module main (import \"./shadow.mjs\" f local predicate) (export f local predicate))"
                      "entry.eli"))
             (candidates (js-array
                           (js-call (get b :managed) :emit_managed_wasm p runtime)
                           (js-call (get b :managed) :emit_managed_project_wasm
                             (js-array
                               (js-object :id "shadow.mjs" :program p)
                               (js-object :id "entry.mjs" :program entry))
                             "entry.mjs" runtime))))
        (js-call assert :equal (js-call reference :f "x") 17)
        (js-call assert :equal (js-call reference :local "x") 23)
        (js-call assert :equal (js-call reference :predicate (js-object :isFinite (lambda () 31)) "x") 31)
        (js-call candidates :forEach
          (lambda (bytes)
            (let* ((a (instantiateManagedRuntime (Uint8Array/from bytes)))
                   (x (progn (js-call a :auto 1) (js-call a :string "x"))))
              (js-call (js-array (js-array "f" 17) (js-array "local" 23)) :forEach
                (lambda (pair)
                  (let* ((name (aref pair 0))
                         (expected (aref pair 1))
                         (out (js-call a :invoke name (js-array x))))
                    (js-call assert :equal (js-call a :readNumber out) expected)
                    (js-call a :release out))))
              (finish a (js-array x))))))))

  (test "shadowed static methods capture lookup before argument effects and preserve nullish failure order"
    (async ()
      (let* ((source "(defun factory () (lambda (x extra) extra)) (defun method (Number x trace) (js-call Number :isFinite x (progn (put trace :visited 7) (put Number :isFinite false)))) (defun missing (Number trace) (js-call Number :isFinite (put trace :visited 9))) (defun raw (Number trace) (funcall (js* \"Number.isFinite\") (put trace :visited 11))) (export factory method missing raw)")
             (p (js-call (get b :compiler) :compile_ir_string source "order.eli"))
             (ref (await (funcall dyn-import
                           (str "data:text/javascript;base64,"
                                (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64")))))
             (target (js-object :isFinite (js-call ref :factory)))
             (effects (js-object)))
        (js-call assert :equal (js-call ref :method target 0 effects) false)
        (js-call (js-array "missing" "raw") :forEach
          (lambda (name)
            (js-call (js-array false nil) :forEach
              (lambda (receiver)
                (let ((trace (js-object))
                      (fn (get ref name)))
                  (js-call assert :throws (lambda () (funcall fn receiver trace)) globalThis.TypeError)
                  (js-call assert :equal (get trace :visited)
                    (if (nil? receiver) undefined (if (= name "missing") 9 11))))))))
        (let* ((entry (js-call (get b :compiler) :compile_ir_string
                        "(module entry (import \"./order.mjs\" factory method missing raw) (export factory method missing raw))"
                        "entry.eli"))
               (candidates (js-array
                             (js-call (get b :managed) :emit_managed_wasm p runtime)
                             (js-call (get b :managed) :emit_managed_project_wasm
                               (js-array
                                 (js-object :id "order.mjs" :program p)
                                 (js-object :id "entry.mjs" :program entry))
                               "entry.mjs" runtime))))
          (js-call candidates :forEach
            (lambda (bytes index)
              (let* ((a (instantiateManagedRuntime (Uint8Array/from bytes)))
                     (f (progn (js-call a :auto 1) (js-call a :invoke "factory")))
                     (object (js-call a :sourceObject (js-object :isFinite f)))
                     (x (js-call a :number 0))
                     (trace (js-call a :sourceObject (js-object)))
                     (key (js-call a :string "visited")))
                (js-call assert :equal (js-call a :invoke "method" (js-array object x trace)) false)
                (js-call (js-array "missing" "raw") :forEach
                  (lambda (name)
                    (js-call (js-array false nil) :forEach
                      (lambda (receiver)
                        (let ((seen (js-call a :sourceObject (js-object))))
                          (js-call assert :throws
                            (lambda () (js-call a :invoke name (js-array receiver seen)))
                            (lambda (e)
                              (let ((diag (get e :eliscriptDiagnostic)))
                                (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
                          (let ((out (js-call a :objectGet seen key)))
                            (js-call assert :equal (read-val a out)
                              (if (nil? receiver) undefined (if (= name "missing") 9 11)))
                            (js-call a :release seen)
                            (js-call a :release out)))))))
                (finish a (js-array f object x trace key) (= index 1)))))))))

  (test "boxed primitive tests do not confuse source arrays, objects, functions and the Lisp truth rule"
    (lambda ()
      (let* ((inst (instance))
             (a (get inst :a))
             (object (js-call a :sourceObject (js-object)))
             (array (js-call a :sourceArray (js-array)))
             (f (js-call a :getExport "number-value"))
             (zero (js-call a :number 0))
             (text (js-call a :string "")))
        (js-call (js-array nil undefined t false object f) :forEach
          (lambda (value)
            (js-call assert :equal (js-call a :invoke "array-call" (js-array value)) false)))
        (js-call assert :equal (js-call a :invoke "array-call" (js-array array)) t)
        (js-call assert :equal (js-call a :truth zero) t)
        (js-call assert :equal (js-call a :truth text) t)
        (js-call assert :equal (js-call a :invoke "boolean-call" (js-array zero)) false)
        (js-call assert :equal (js-call a :invoke "boolean-call" (js-array text)) false)
        (js-call (js-array array object f) :forEach
          (lambda (value)
            (js-call assert :equal (js-call a :invoke "boolean-call" (js-array value)) t)))
        (finish a (js-array object array f zero text)))))

  (test "unsupported object conversion and actual builtin traps preserve effects, caller roots and original failures"
    (async ()
      (let* ((inst (instance))
             (a (get inst :a))
             (object (js-call a :sourceObject (js-object :toString false :valueOf false)))
             (trace (js-call a :sourceObject (js-object)))
             (held (js-call a :number -0))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 held)
        (let* ((plain (js-call a :sourceObject (js-object)))
               (plain-trace (js-call a :sourceObject (js-object)))
               (ordinary (js-call a :invoke "number-extra" (js-array plain plain-trace)))
               (control (js-object))
               (ordinary-key (js-call a :string "visited"))
               (ordinary-seen (js-call a :objectGet plain-trace ordinary-key)))
          (funcall assert (Object/is (js-call a :readNumber ordinary) (js-call js :number_extra (js-object) control)))
          (js-call assert :equal (get control :visited) 7)
          (js-call assert :equal (js-call a :readNumber ordinary-seen) (get control :visited))
          (js-call (js-array ordinary plain plain-trace ordinary-key ordinary-seen) :forEach
            (lambda (value) (js-call a :release value))))
        (js-call assert :throws
          (lambda () (js-call js :number_extra (js-object :toString false :valueOf false) (js-object)))
          globalThis.TypeError)
        (js-call assert :throws
          (lambda () (js-call a :invoke "number-extra" (js-array object trace)))
          (lambda (e)
            (let ((diag (get e :eliscriptDiagnostic)))
              (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (funcall assert (Object/is (js-call a :readNumber held) -0))
        (let* ((key (js-call a :string "visited"))
               (seen (js-call a :objectGet trace key)))
          (js-call assert :equal (js-call a :readNumber seen) 7)
          (js-call a :leaveFrame frame)
          (finish a (js-array object trace held key seen))))
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun value-builtin-primitive "))
             (end (js-call source :indexOf "  ;; Shortest decimal generation" start)))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((injected (js-call (get b :compiler) :compile_ir_string
                           (str (js-call source :slice 0 start)
                                "  (defun value-builtin-primitive (heap input count operation) (load-u32 4294967295))\n"
                                (js-call source :slice end))
                           "trap.eli"))
               (trap-rt (instantiateManagedRuntime
                          (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program injected))))
               (x (progn (js-call trap-rt :auto 1) (js-call trap-rt :string "42")))
               (saved (js-call trap-rt :number -0))
               (outer (js-call trap-rt :frame 1)))
          (js-call trap-rt :frameSet outer 0 saved)
          (js-call assert :throws
            (lambda () (js-call trap-rt :invoke "number-call" (js-array x)))
            WebAssembly.RuntimeError)
          (js-call assert :equal (get (js-call trap-rt :stats) :frameDepth) 1)
          (js-call assert :equal (js-call trap-rt :readString x) "42")
          (funcall assert (Object/is (js-call trap-rt :readNumber saved) -0))
          (js-call trap-rt :leaveFrame outer)
          (finish trap-rt (js-array x saved))))))

  (test "capacity failures during builtin conversion leave the module and caller frame usable"
    (lambda ()
      (let* ((inst (instance (js-object :maxSlots 128 :initialBytes 4096 :maxBytes 16384)))
             (a (get inst :a))
             (input (str "1." (js-call "0" :repeat 2000) "1"))
             (text (js-call a :string input))
             (saved (js-call a :number -0))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 saved)
        (let ((remaining (- 16384 (get (js-call a :stats) :usedBytes) 512)))
          (funcall assert (> remaining 0))
          (let ((pressure (js-call a :bytes (new globalThis.Uint8Array remaining))))
            (js-call assert :throws
              (lambda () (js-call a :invoke "number-call" (js-array text)))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :equal (js-call a :readString text) input)
            (funcall assert (Object/is (js-call a :readNumber saved) -0))
            (js-call a :leaveFrame frame)
            (js-call a :release text)
            (js-call a :release pressure)
            (js-call a :collect)
            (let ((out (js-call a :invoke "number-empty")))
              (js-call assert :equal (js-call a :readNumber out) 0)
              (finish a (js-array saved out))))))))

  (test "Node executes the identical independent builtin WASM including aliases and predicate boundaries"
    (async ()
      (let* ((inst (instance))
             (a (get inst :a))
             (bytes (get inst :bytes))
             (file (resolve directory "builtins.wasm")))
        (finish a)
        (await (writeFile file bytes))
        (let ((child (spawnSync "node"
                       (js-array node-helper "wasm"
                         (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                         file)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "unimplemented constructors, mutable builtin properties and malformed raw IR stay explicitly refused"
    (lambda ()
      (js-call (js-array
                 "(defun f (x) (new (js* \"Number\") x))"
                 "(defun f () (js* \"Number.parseInt\"))"
                 "(defun f () (put (js* \"Number\") :isFinite false))"
                 "(defun f () (js* \"Number /* comment */\"))")
        :forEach
        (lambda (source)
          (let ((p (js-call (get b :compiler) :compile_ir_string source "unsupported-builtins.eli")))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (= (if diag (get diag :code) undefined) "ELI-B0001")))))))
      (let ((p (js-call (get b :compiler) :compile_ir_string "(defun f () (js* \"Number\"))" "bad-builtins.eli")))
        (put (aref (get (aref (get p :body) 0) :children) 0) :children (js-array nil))
        (js-call assert :throws
          (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
          (lambda (e)
            (let ((diag (get e :eliscriptDiagnostic)))
              (= (if diag (get diag :code) undefined) "ELI-B0001")))))))

  (test "explicit globalThis paths respect shadowed host objects in standalone and linked projects"
    (async ()
      (let* ((source "(defun factory () (lambda (x) 37)) (defun f (globalThis x) (funcall (js* \"globalThis.Number\") x)) (defun g (globalThis x) (js-call globalThis.Number :isFinite x)) (export factory f g)")
             (p (js-call (get b :compiler) :compile_ir_string source "host-shadow.eli"))
             (reference (await (funcall dyn-import
                                 (str "data:text/javascript;base64,"
                                      (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64")))))
             (entry (js-call (get b :compiler) :compile_ir_string
                      "(module main (import \"./host.mjs\" factory f g) (export factory f g))"
                      "entry.eli"))
             (candidates (js-array
                           (js-call (get b :managed) :emit_managed_wasm p runtime)
                           (js-call (get b :managed) :emit_managed_project_wasm
                             (js-array
                               (js-object :id "host.mjs" :program p)
                               (js-object :id "entry.mjs" :program entry))
                             "entry.mjs" runtime))))
        (js-call assert :equal (js-call reference :f (js-object :Number (js-call reference :factory)) "x") 37)
        (js-call assert :equal (js-call reference :g (js-object :Number (js-object :isFinite (js-call reference :factory))) "x") 37)
        (js-call candidates :forEach
          (lambda (bytes index)
            (let* ((a (instantiateManagedRuntime (Uint8Array/from bytes)))
                   (f (progn (js-call a :auto 1) (js-call a :invoke "factory")))
                   (num-obj (js-call a :sourceObject (js-object :isFinite f)))
                   (host (js-call a :sourceObject (js-object :Number f)))
                   (nested (js-call a :sourceObject (js-object :Number num-obj)))
                   (x (js-call a :string "x")))
              (js-call (js-array (js-array "f" host) (js-array "g" nested)) :forEach
                (lambda (pair)
                  (let* ((name (aref pair 0))
                         (receiver (aref pair 1))
                         (out (js-call a :invoke name (js-array receiver x))))
                    (js-call assert :equal (js-call a :readNumber out) 37)
                    (js-call a :release out))))
              (finish a (js-array f num-obj host nested x) (= index 1)))))))))
