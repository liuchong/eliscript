(module tests.portable-result
  (import "bun:test" test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries pruneLibrary assertSourceMap be same contains excludes)
  (test "portable Result values are byte-identical and short-circuit at scale"
    (async () (await (withPortableLibraries
      (js-object :module "result" :sources (js-array "bit" "identifier" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value" "metadata" "data-text" "result") :fixture "tests/fixtures/portable-result-host.mjs" :loader t :parallelHosts t)
      (async (context)
        (let ((report (get context :report)))
      (same report (js-object "constructors" (js-object "ok" t "error" t "result" t "ordinaryMap" false "crossStatus" t) "payloads" (js-object "false" t "nil" t "undefined" t "error" "failed") "combinators" (js-object "mappedOk" 42 "mappedError" "failed!" "untouchedError" t "untouchedOk" t "okCalls" 1 "errorCalls" 1 "andThen" 10 "andThenErrorIdentity" t "orElse" 6 "orElseOkIdentity" t "foldOk" 5 "foldError" 6 "unwrapOk" t "unwrapError" 9 "unwrapElse" 6) "collection" (js-object "values" (js-array 1 2 3) "failureIdentity" t "invalidSource" nil) "traversal" (js-object "ok" t "count" 50000 "first" 0 "last" 99998 "calls" 50000 "earlyIdentity" t "earlyCalls" 12346 "invalidResult" t "invalidCalls" 6) "valueSemantics" (js-object "equal" t "hashEqual" t "mapLookup" "present" "generatedInvariant" t) "dataText" (js-object "decodedResult" t "equal" t "stable" t)))
      (await (pruneLibrary context "unwrap-or" (js-array "function unwrap_or(" "function ok_QMARK_(") (js-array "function collect_results(" "function traverse_results(" "function map_err(")))
      (await (assertSourceMap (get context :seedDirectory) "result" (js-array "(defportable collect-results" "(defportable traverse-results")))
        ))))) 180000)
)
