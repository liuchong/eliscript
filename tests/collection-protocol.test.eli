  ; Only the native class/constructor brand is supplied by JS; initialization and algorithms remain Eli.
  (defconst makeClass (js* "(initialize) => class { constructor(...args) { initialize(this, ...args); } }"))
  (defconst blankClass (js* "() => class {}"))
  (defconst generatorBridge (js* "(source) => (function* values() { yield* source; })()"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))
  (defun raises (run error) (js-call (expect run) :toThrow error))
  (defun different (a b) (js-call (get (expect a) :not) :toBe b))
  (defun instance (value constructor) (js-call (expect value) :toBeInstanceOf constructor))
  (defun iterable (factory)
    (let ((value (js-object))) (put value (get globalThis.Symbol :iterator) factory) value))
  (defun iterator (values) (js-call values (get globalThis.Symbol :iterator)))
  (defun slot (value protocol operation &rest args) (Reflect/apply (get value (protocolSlot protocol operation)) value args))
  (defun frozen (value) (be (Object/isFrozen value) t))
  (defun frozenClass (property &rest __host_forwarded_arguments_1)
    (let* ((entries (aref __host_forwarded_arguments_1 0)))
    (funcall makeClass (lambda (self values)
      (put self property (Object/freeze (if entries (js-call values :map (lambda (entry) (Object/freeze entry))) values))) (Object/freeze self)))))
  (defasync runHost (command fixture)
    (let* ((child (Bun/spawn (js-array command fixture) (js-object :stdout "pipe" :stderr "pipe")))
           (values (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (code (aref values 0)) (stdout (aref values 1)) (stderr (aref values 2)))
      (unless (= code 0) (throw (new globalThis.Error (if (> (js-length (js-call stderr :trim)) 0) (js-call stderr :trim) (str command " exited with " code)))))
      (JSON/parse stdout)))
