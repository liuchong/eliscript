(module tests.collection-transient-subvec.test
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp rm symlink)
  (import "node:path" dirname resolve)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "../runtime/core/collection.mjs" :as C)
  (import "../runtime/core/collection.mjs"
    assoc
    conj
    contains
    count
    get
    mapEntry
    peek
    pop
    reduced
    rseq
    seq)
  (import "../runtime/core/data.mjs" frequencies groupBy mergeWith)
  (import "../runtime/core/map.mjs" EMPTY_MAP isPersistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/protocol.mjs" implementsProtocol)
  (import "../runtime/core/sequence.mjs" filter map range)
  (import "../runtime/core/set.mjs" EMPTY_SET PersistentHashSet isPersistentHashSet persistentHashSet)
  (import "../runtime/core/transducer.mjs" into)
  (import "../runtime/core/transient.mjs" :as TR)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (import "../runtime/core/vector.mjs"
    EMPTY_VECTOR
    isPersistentVector
    persistentVector
    readPersistentVectorView
    subvec)
  (import "../runtime/testing/map.mjs" persistentMapMetrics resetPersistentMapMetrics resetTransientMapMetrics transientMapMetrics)
  (import "../runtime/testing/set.mjs"
    persistentSetMetrics
    resetPersistentSetMetrics
    resetTransientSetMetrics
    transientSetMetrics)

  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst EMACS (let ((v (get (get process :env) :EMACS))) (if (nullish? v) "emacs" v)))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defun callable-p (v) (= (js* "typeof v") "function"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun less-than (actual limit) (js-call (expect actual) :toBeLessThan limit))
  (defun raises (fn &optional msg)
    (if (nullish? msg)
        (js-call (expect fn) :toThrow)
        (js-call (expect fn) :toThrow msg)))
  (defasync compile-module (source output)
    (await (mkdir (dirname output) (js-object :recursive t)))
    (let* ((child (Bun/spawn (js-array COMPILER "--source-map" "--output" output source)
                    (js-object :cwd ROOT :env (Object/assign (js-object) (get process :env) (js-object :EMACS EMACS))
                               :stdout "pipe" :stderr "pipe")))
           (res (await (Promise/all (js-array (get child :exited)
                                      (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (code (aref res 0))
           (stderr (aref res 1)))
      (unless (= code 0)
        (throw (new globalThis.Error (str "compile failed for " source ": " stderr))))))
  (defasync load-module (filename)
    (funcall (js* "(url) => import(url)") (get (pathToFileURL filename) :href)))

  (test "nested subvec flattens root reference and supports direct zero-iterator reduce" (lambda ()
    (let* ((root (into EMPTY_VECTOR (range 100)))
           (s1 (subvec root 10 90))
           (s2 (subvec s1 5 25))
           (s3 (subvec s2 2 4))
           (view (readPersistentVectorView s3)))
      (be (get view :vector) root)
      (be (get view :start) 17)
      (be (get view :end) 19)
      (be (count s3) 2)
      (be (C/nth s3 0) 17)
      (be (C/nth s3 1) 18)
      (let ((eq2 (persistentVector 17 18))
            (me2 (mapEntry 17 18)))
        (be (equalValues s3 eq2) t)
        (be (equalValues eq2 s3) t)
        (be (hashValue s3) (hashValue eq2))
        (be (equalValues s3 me2) t)
        (be (equalValues me2 s3) t)
        (be (hashValue s3) (hashValue me2)))
      ;; Direct indexed COLLECTION_REDUCE without consulting Symbol.iterator
      (let ((custom-iter (aref s2 (get globalThis.Symbol :iterator))))
        (be (C/reduce s2 (lambda (a b) (+ a b))) 490)
        (be (C/reduce s2 (lambda (acc v) (+ acc v)) 0) 490)
        (let ((stopped (C/reduce s2 (lambda (acc v) (if (= v 18) (reduced acc) (+ acc v))) 0)))
          (be stopped (+ 15 16 17)))
        (be (callable-p custom-iter) t))
      (let ((empty-sv (subvec root 5 5)))
        (raises (lambda () (C/reduce empty-sv (lambda (a b) (+ a b)))) "cannot reduce an empty collection")))))

  (test "TransientHashSet supports disj!, has, count, rejects persistent protocols and sealing reuse" (lambda ()
    (let* ((source (into EMPTY_SET (range 64)))
           (tr-transient (get TR :transient))
           (tr-conj (get TR :conjBang))
           (tr-disj (get TR :disjBang))
           (tr-persistent (get TR :persistentBang))
           (ts (funcall tr-transient source)))
      (be (get ts :count) 64)
      (be (implementsProtocol (get TR :ITransientSet) ts) t)
      (be (js-call ts :has 10) t)
      (be (js-call ts :has 99) false)
      (raises (lambda () (count ts)))
      (funcall tr-disj ts 0 1 2 999)
      (funcall tr-conj ts 100 101)
      (be (get ts :count) 63)
      (be (js-call ts :has 0) false)
      (be (js-call ts :has 100) t)
      (let ((res (funcall tr-persistent ts)))
        (be (isPersistentHashSet res) t)
        (be (count res) 63)
        (be (js-call res :has 0) false)
        (be (js-call res :has 100) t)
        (be (js-call source :has 0) t)
        (be (js-call source :has 100) false))
      (raises (lambda () (funcall tr-disj ts 5)) "transient hash set is no longer editable"))))

  (test "Set algebra and collection combinators execute through transient pipelines" (lambda ()
    (let* ((a (into EMPTY_SET (range 200)))
           (b (into EMPTY_SET (range 100 300))))
      (resetTransientSetMetrics)
      (resetPersistentMapMetrics)
      (let ((u (js-call a :union b)))
        (be (count u) 300)
        (be (get (transientSetMetrics) :setPersistentCalls) 1)
        (less-than (get (persistentMapMetrics) :nodeAllocations) 120))
      (resetTransientSetMetrics)
      (let ((inter (js-call a :intersection b)))
        (be (count inter) 100)
        (be (get (transientSetMetrics) :setPersistentCalls) 1))
      (resetTransientSetMetrics)
      (let ((diff (js-call a :difference b)))
        (be (count diff) 100)
        (be (get (transientSetMetrics) :setPersistentCalls) 1)))
    ;; core sequence map / filter return persistent vectors
    (let ((mapped (map (lambda (x) (* x 3)) (range 10)))
          (filtered (filter (lambda (x) (= (% x 2) 0)) (range 10))))
      (be (isPersistentVector mapped) t)
      (be (isPersistentVector filtered) t)
      (same (Array/from mapped) (js-array 0 3 6 9 12 15 18 21 24 27))
      (same (Array/from filtered) (js-array 0 2 4 6 8)))
    ;; mergeWith uses transient map builder
    (resetTransientMapMetrics)
    (let ((m1 (into EMPTY_MAP (map (lambda (i) (persistentVector (str "k" i) i)) (range 30))))
          (m2 (into EMPTY_MAP (map (lambda (i) (persistentVector (str "k" i) (* i 10))) (range 15 45)))))
      (resetTransientMapMetrics)
      (let ((merged (mergeWith (lambda (x y) (+ x y)) m1 m2)))
        (be (isPersistentHashMap merged) t)
        (be (count merged) 45)
        (be (C/get merged "k20") 220)
        (be (C/get merged "k0") 0)
        (be (C/get merged "k40") 400)
        (be (get (transientMapMetrics) :persistentCalls) 1)))
    ;; groupBy & frequencies use transient builders
    (let ((grp (groupBy (lambda (n) (% n 3)) (range 30)))
          (freq (frequencies (map (lambda (n) (% n 4)) (range 40)))))
      (be (count grp) 3)
      (be (count (C/get grp 0)) 10)
      (be (count freq) 4)
      (be (C/get freq 2) 10))))

  (test "compiled stdlib seq/data/transient exports (mapv, filterv, group-by, frequencies, merge-with, disj!) execute cleanly" (async ()
    (let ((directory (await (mkdtemp (resolve ROOT ".eliscript-s2-stdlib-")))))
      (try
        (await (symlink (resolve ROOT "runtime") (resolve directory "runtime") "dir"))
        (await (compile-module (resolve ROOT "stdlib/seq.eli") (resolve directory "stdlib/seq.mjs")))
        (await (compile-module (resolve ROOT "stdlib/data.eli") (resolve directory "stdlib/data.mjs")))
        (await (compile-module (resolve ROOT "stdlib/transient.eli") (resolve directory "stdlib/transient.mjs")))
        (let* ((S (await (load-module (resolve directory "stdlib/seq.mjs"))))
               (D (await (load-module (resolve directory "stdlib/data.mjs"))))
               (T (await (load-module (resolve directory "stdlib/transient.mjs"))))
               (mv (js-call S :mapv (lambda (x) (* x 2)) (js-call S :range 5)))
               (fv (js-call S :filterv (lambda (x) (> x 1)) (js-call S :range 5)))
               (ts (js-call T :transient (into EMPTY_SET (js-array 1 2 3 4)))))
          (be (isPersistentVector mv) t)
          (same (Array/from mv) (js-array 0 2 4 6 8))
          (same (Array/from fv) (js-array 2 3 4))
          (js-call T :disj_BANG_ ts 2 4)
          (let ((ps (js-call T :persistent_BANG_ ts)))
            (be (count ps) 2)
            (be (js-call ps :has 1) t)
            (be (js-call ps :has 2) false))
          (let* ((buckets (js-call D :group_by (lambda (x) (% x 2)) (js-call S :range 10)))
                 (freqs (js-call D :frequencies (js-array "a" "b" "a" "c" "a")))
                 (mw (js-call D :merge_with (lambda (x y) (+ x y))
                       (into EMPTY_MAP (js-array (js-array "k" 3)))
                       (into EMPTY_MAP (js-array (js-array "k" 7) (js-array "m" 9))))))
            (be (count (C/get buckets 0)) 5)
            (be (C/get freqs "a") 3)
            (be (C/get mw "k") 10)
            (be (C/get mw "m") 9)))
        (finally
          (await (rm directory (js-object :recursive t :force t))))))))

  (test "Edge cases: empty/1-elem nested subvec, disj! missing & sealed throws, TransientHashMap get/has/sealed" (lambda ()
    (let* ((root (into EMPTY_VECTOR (range 10)))
           (empty-sub (subvec (subvec root 2 5) 1 1))
           (one-sub (subvec (subvec root 2 5) 1 2)))
      (be (count empty-sub) 0)
      (raises (lambda () (pop empty-sub)) globalThis.RangeError)
      (raises (lambda () (C/nth empty-sub 0)) globalThis.RangeError)
      (be (equalValues (assoc empty-sub 0 :x) (persistentVector :x)) t)
      (raises (lambda () (assoc empty-sub 1 :x)) globalThis.RangeError)
      (be (equalValues (pop one-sub) EMPTY_VECTOR) t)
      (be (equalValues (assoc one-sub 0 99) (persistentVector 99)) t)
      (be (equalValues (assoc one-sub 1 77) (persistentVector 3 77)) t)
      (raises (lambda () (assoc one-sub 2 88)) globalThis.RangeError))
    (let* ((tr-transient (get TR :transient))
           (tr-assoc (get TR :assocBang))
           (tr-disj (get TR :disjBang))
           (tr-persistent (get TR :persistentBang))
           (ts (funcall tr-transient (into EMPTY_SET (js-array "a" "b"))))
           (tm-small (funcall tr-transient (into EMPTY_MAP (js-array (js-array "k" 1)))))
           (tm-big (funcall tr-transient (into EMPTY_MAP (map (lambda (i) (persistentVector (str "k" i) i)) (range 12))))))
      (funcall tr-disj ts "not-present")
      (be (get ts :count) 2)
      (let ((sealed-set (funcall tr-persistent ts)))
        (be (count sealed-set) 2)
        (raises (lambda () (funcall tr-disj ts "a")) "transient hash set is no longer editable"))
      (be (js-call tm-small :has "k") t)
      (be (js-call tm-small :get "k") 1)
      (be (js-call tm-small :get "missing" :nf) :nf)
      (be (js-call tm-big :has "k9") t)
      (be (js-call tm-big :get "k9") 9)
      (funcall tr-assoc tm-small "m" 2)
      (let ((sealed-small (funcall tr-persistent tm-small))
            (sealed-big (funcall tr-persistent tm-big)))
        (be (C/get sealed-small "m") 2)
        (be (C/get sealed-big "k9") 9)
        (raises (lambda () (js-call tm-small :get "k")) "transient hash map is no longer editable")
        (raises (lambda () (js-call tm-big :has "k9")) "transient hash map is no longer editable")))))
)
