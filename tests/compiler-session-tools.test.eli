  (ae (get preview :ok) t) (same (get preview :sourceIdentity) (get original :sourceIdentity))
  (let ((next (analyze session (get preview :source) (js-object :expectedSourceIdentity (get preview :sourceIdentity)))))
    (ae (js-length (get next :macroExpansions)) 1)
    (ae (js-length (js-call (get next :references) :filter (lambda (item) (and (get item :generated) (= (get item :name) "a"))))) 2)
    (same (sendRequest session cached) before) (ae (get (sendRequest session request) :revision) (get compiled :revision))
    (let ((control (new globalThis.AbortController)) (reason (new globalThis.Error "cancel edit preview")))
      (js-call control :abort reason)
      (js-call assert :throws (lambda () (js-call session :request (js-object :operation "edit-preview" :filename "tools.eli" :source source :offsetUnit "unicode-scalar"
        :expectedSourceIdentity (get original :sourceIdentity) :edits (js-array)) (js-object :signal (get control :signal)))) (lambda (error) (= error reason))))
    (same (analyze session source) original) (js-call session :close)
    (await (withSession (lambda (fresh) (same next (analyze fresh source)))))))))))
