      (js-object :encoding "utf8" :timeout 10000)))
  (defun stream (metadata parts)
    (spawnSync "node" (js-array (fileURLToPath (new globalThis.URL "./fixtures/session-tools-cli-stream-host.mjs" (js* "import.meta.url")))
      (get (pathToFileURL cliPath) :href) (JSON/stringify (js-call parts :map (lambda (part) (js-call part :toString "hex"))))
