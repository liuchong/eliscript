  (beforeAll (async ()
    (setq directory (get (get process :env) :ELISCRIPT_TEST_COMPILER_SESSION_DIRECTORY))
    (unless (funcall globalThis.Boolean directory)
      (setq owned (await (mkdtemp (resolve (tmpdir) "eliscript-session-tools-"))))
      ; The independent child ends the seed compiler module cache before loading its driver.
      (let ((args (js-array)))
        (when (funcall globalThis.Boolean (get (get process :versions) :bun)) (js-call args :push "--smol"))
        (js-call args :push (fileURLToPath (new globalThis.URL "./fixtures/session-tools-build-host.mjs" (js* "import.meta.url"))) owned)
        (let ((child (spawnSync (get process :execPath) args (js-object :encoding "utf8" :timeout 120000 :maxBuffer 1048576))))
          (childClean child) (setq directory owned) (ae (get (JSON/parse (get child :stdout)) :host) "javascript"))))
    (let ((manifest (JSON/parse (await (readFile (resolve directory "compiler-artifact.json") "utf8")))))
      (ae (get manifest :host) "javascript") (setq driver (await (funcall dynamicImport (get (pathToFileURL (resolve directory (get manifest :path))) :href)))))) 120000)
  (afterAll (async () (when (funcall globalThis.Boolean owned) (await (rm owned (js-object :recursive t :force t))))))
