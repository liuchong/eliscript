  (defun slice (source span) (js-call (js-call (Array/from source) :slice (get span :start) (get span :end)) :join ""))
  (defun records (report) (js-call (get report :definitions) :concat (get report :references)))
  (defun named (items name) (js-call items :filter (lambda (item) (= (get item :name) name))))
  (defun declaration (report name) (js-call (get report :definitions) :find (lambda (item) (= (get item :name) name))))
  (defun parameter (report name) (js-call (get report :definitions) :find (lambda (item) (and (= (get item :kind) "parameter") (= (get item :name) name)))))
  (defun roles (items) (js-call items :map (lambda (item) (get item :role))))
  (defun bindings (items) (js-call items :map (lambda (item) (get item :bindingId))))
  (defun roleBindings (items) (js-call items :map (lambda (item) (js-array (get item :role) (get item :bindingId)))))
