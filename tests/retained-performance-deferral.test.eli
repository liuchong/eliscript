(module tests.retained-performance-deferral
  (import "bun:test" :as framework)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile mkdir symlink rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve dirname)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/acceptance/retained-transient.mjs" validateRefreshedTransientBuilder)
  (import "../tools/acceptance/retained-soak.mjs" validateRefreshedWorkerSoak)
  (import "../tools/acceptance/retained-performance-snapshot.mjs" retainedGitSnapshotBytes retainedPerformanceSnapshot)
  (import "../tools/acceptance/finalize.mjs" validateFinalAcceptanceContract verifyFinalAcceptance)
  (import "node:child_process" spawnSync)
  (defvar directory undefined) (defvar run undefined) (defvar contract undefined) (defvar cases (js-array))
  (defun hash (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun git (arguments) (retainedGitSnapshotBytes root arguments))
  (defun beforeAll (body &optional timeout) (js-call framework :beforeAll body (if (nullish? timeout) 30000 timeout)))
  (defun afterAll (body &optional timeout) (js-call framework :afterAll body (if (nullish? timeout) 30000 timeout)))
  (defun test (title body &optional timeout)
    (js-call framework :test title body (if (nullish? timeout) 30000 timeout)))
  (defun canonical-test (title body &optional timeout)
    (let ((runner (if (= (get (get globalThis.process :env) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE) "1") (get (get framework :test) :skip) (get framework :test))))
      (funcall runner title body (if (nullish? timeout) 30000 timeout))))
  (defasync each (items body)
    (let ((index 0)) (while (< index (js-length items)) (await (funcall body (aref items index))) (setq index (1+ index)))))
  (defun stale-pattern () (new globalThis.RegExp "fresh source (aggregate|entry) is stale"))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-retained-deferral-"))))
    (setq run (JSON/parse (await (readFile (resolve root "acceptance/runs/m13-01.json") "utf8"))))
    (setq contract (JSON/parse (await (readFile (resolve root "contracts/final-acceptance.json") "utf8"))))
    (let ((git-directory (js-call (js-call (new globalThis.TextDecoder) :decode (git (js-array "rev-parse" "--absolute-git-dir"))) :trim)))
      (await (each (js-array
        (js-array "transient" "benchmarks/transient-builder-macos-arm64.json" validateRefreshedTransientBuilder)
        (js-array "soak" "benchmarks/worker-lifecycle-soak-macos-arm64.json" validateRefreshedWorkerSoak))
        (async (entry)
          (let* ((name (aref entry 0)) (file (aref entry 1)) (workspace (resolve directory name))
                 (bytes (await (readFile (resolve root file))))
                 (revision (get (retainedPerformanceSnapshot root file bytes) :commit))
                 (report (JSON/parse (js-call (new globalThis.TextDecoder) :decode bytes)))
                 (files (if (= name "transient") (get (get report :sourceDigest) :files)
                          (js-call (get (get report :source) :files) :map (lambda (item) (get item :file))))))
            (await (mkdir workspace)) (await (symlink git-directory (resolve workspace ".git") "dir"))
            (await (each files (async (source)
              (let ((path (resolve workspace source))) (await (mkdir (dirname path) (js-object :recursive t)))
                (await (writeFile path (git (js-array "show" (str revision ":" source)))))))))
            (await (writeFile (resolve workspace (aref files 0)) "// deliberately changed working source\n" (js-object :flag "a")))
            (js-call cases :push (js-object :name name :file file :validate (aref entry 2) :workspace workspace :bytes bytes :revision revision :report report)))))))) 30000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "default and explicit false still reject stale working sources even when the outer environment opts in" (async ()
    (await (each cases (async (c)
      (await (each (js-array undefined (js-object :deferPerformanceAcceptance false)) (async (options)
        (await (js-call assert :rejects (js-call c :validate (get c :workspace) (get c :file) (get c :bytes) run options) (stale-pattern)))))))))))
  (test "strict checks accept genuinely matching sources and reread later working changes while immutable Git cache bytes cannot be poisoned" (async ()
    (await (each cases (async (c)
      (let* ((source (if (= (get c :name) "transient") (aref (get (get (get c :report) :sourceDigest) :files) 0)
                       (get (aref (get (get (get c :report) :source) :files) 0) :file)))
             (path (resolve (get c :workspace) source)) (before (await (readFile path)))
             (measured (git (js-array "show" (str (get c :revision) ":" source)))))
        (try
          (progn (await (writeFile path measured))
            (js-call assert :strictEqual (await (js-call c :validate (get c :workspace) (get c :file) (get c :bytes) run)) t)
            (await (writeFile path "\n// changed again\n" (js-object :flag "a")))
            (await (js-call assert :rejects (js-call c :validate (get c :workspace) (get c :file) (get c :bytes) run) (stale-pattern))))
          (finally (await (writeFile path before))))
        (let* ((args (js-array "show" (str (get c :revision) ":" (get c :file))))
               (original (retainedGitSnapshotBytes (get c :workspace) args)))
          (js-call original :fill 0)
          (js-call assert :strictEqual (hash (retainedGitSnapshotBytes (get c :workspace) args)) (hash (get c :bytes))))))))))
  (test "explicit deferral verifies the measured Git source snapshot and reports current performance as unaccepted without mutating evidence" (async ()
    (let ((saved (JSON/stringify run)))
      (await (each cases (async (c)
        (let* ((before (hash (get c :bytes)))
               (result (await (js-call c :validate (get c :workspace) (get c :file) (get c :bytes) run (js-object :deferPerformanceAcceptance t)))))
          (js-call assert :strictEqual (get result :historicalSourcesVerified) t)
          (js-call assert :strictEqual (get result :performanceAccepted) false)
          (js-call assert :strictEqual (get result :currentSourceAcceptance) "deferred")
          (js-call assert :strictEqual (get result :report) (get c :file))
          (js-call assert :strictEqual (get (get result :measuredSource) :commit) (get c :revision))
          (js-call assert :strictEqual (get (get result :measuredSource) :artifactSha256) before)
          (js-call assert :match (get (get result :currentSourceFailure) :message) (stale-pattern))
          (js-call assert :strictEqual (hash (get c :bytes)) before)))))
      (js-call assert :strictEqual (JSON/stringify run) saved))))
  (test "deferral rejects substituted reports, source identities, measurements and accepted-run provenance" (async ()
    (await (each cases (async (c)
      (let ((mutations (if (= (get c :name) "transient")
        (js-array (lambda (r) (put (get r :parameters) :timingSamples 10))
          (lambda (r) (put (get (get (get r :results) :vector) :timing) :speedup (+ (get (get (get (get r :results) :vector) :timing) :speedup) 1)))
          (lambda (r) (put (get r :sourceDigest) :value (js-call "0" :repeat 64))))
        (js-array (lambda (r) (put (get r :limits) :runTimeoutSeconds (+ (get (get r :limits) :runTimeoutSeconds) 1)))
          (lambda (r) (put (get r :workload) :successfulRequests (- (get (get r :workload) :successfulRequests) 1)))
          (lambda (r) (put (aref (get (get r :source) :files) 0) :sha256 (js-call "0" :repeat 64)))
          (lambda (r) (put (get r :source) :digest (js-call "0" :repeat 64)))))))
        (await (each mutations (async (mutate)
          (let ((report (globalThis.structuredClone (get c :report)))) (funcall mutate report)
            (await (js-call assert :rejects (js-call c :validate (get c :workspace) (get c :file)
              (globalThis.Buffer.from (JSON/stringify report)) run (js-object :deferPerformanceAcceptance t))))))))
      (await (js-call assert :rejects (js-call c :validate (get c :workspace) (get c :file)
        (globalThis.Buffer.concat (js-array (get c :bytes) (globalThis.Buffer.from "\n"))) run (js-object :deferPerformanceAcceptance t))
        (lambda (error) (and (js-call (new globalThis.RegExp "report bytes differ from their measured Git snapshot") :test (get error :message))
          (js-call (stale-pattern) :test (get (get error :cause) :message))))))
      (await (each (js-array
        (lambda (r) (put (get r :source) :tree (js-call "0" :repeat 40)))
        (lambda (r) (put (js-call (get r :artifacts) :find (lambda (a) (= (get a :file) (get c :file)))) :sha256 (js-call "0" :repeat 64)))
        (lambda (r) (js-call (get r :artifacts) :push (globalThis.structuredClone (js-call (get r :artifacts) :find (lambda (a) (= (get a :file) (get c :file))))))))
        (async (mutate) (let ((changed (globalThis.structuredClone run))) (funcall mutate changed)
          (await (js-call assert :rejects (js-call c :validate (get c :workspace) (get c :file) (get c :bytes) changed (js-object :deferPerformanceAcceptance t))))))))))))))
  (canonical-test "the complete final contract and canonical manifest remain verified while deferred source checks are listed separately" (async ()
    (let ((deferred (js-array)) (expected (js-array)))
      (js-call assert :strictEqual (await (validateFinalAcceptanceContract contract run (js-object :root root :deferPerformanceAcceptance t :deferredPerformanceAcceptance deferred))) contract)
      (await (each cases (async (c)
        (try (await (js-call c :validate root (get c :file) (await (readFile (resolve root (get c :file)))) run))
          (catch error (js-call expected :push (get c :file)))))))
      (js-call assert :deepStrictEqual (js-call (js-call deferred :map (lambda (item) (get item :report))) :sort) (js-call expected :sort))
      (js-call assert :ok (js-call deferred :every (lambda (item) (eq (get item :performanceAccepted) false))))
      (js-call assert :deepStrictEqual (await (verifyFinalAcceptance (js-object :root root :deferPerformanceAcceptance t)))
        (JSON/parse (await (readFile (resolve root "acceptance/manifest.json") "utf8")))))))
  (canonical-test "CLI deferral verifies historical artifacts, prints NOT ACCEPTED, refuses promotion and generation and never rewrites canonical files" (async ()
    (let* ((files (js-array "acceptance/manifest.json" "acceptance/report.md"))
           (before (await (Promise/all (js-call files :map (lambda (file) (readFile (resolve root file)))))))
           (options (js-object :cwd root :encoding "utf8" :timeout 30000
             :env (Object/assign (js-object) (get globalThis.process :env) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"))))
           (command (resolve root "tools/acceptance/finalize.mjs"))
           (child (spawnSync (get globalThis.process :execPath) (js-array command "--verify") options)))
      (js-call assert :strictEqual (get child :status) 0 (get child :stderr))
      (js-call assert :match (get child :stdout) (new globalThis.RegExp "DEFERRED / NOT ACCEPTED"))
      (js-call assert :match (get child :stdout) (new globalThis.RegExp "Historical final acceptance:"))
      (await (each (js-array (js-array "--verify" "--require-pass") (js-array "--generate")) (async (args)
        (let ((blocked (spawnSync (get globalThis.process :execPath) (js-call (js-array command) :concat args) options)))
          (js-call assert :strictEqual (get blocked :status) 1 (get blocked :stderr))
          (js-call assert :match (get blocked :stderr) (new globalThis.RegExp "performance acceptance is deferred"))))))
      (let ((index 0)) (while (< index (js-length files))
        (js-call assert :deepStrictEqual (await (readFile (resolve root (aref files index)))) (aref before index)) (setq index (1+ index)))))) 30000))
