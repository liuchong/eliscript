(module capsules.tests.retained-performance-deferral.test
  (js* "import {beforeAll,afterAll,test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {mkdtemp,readFile,writeFile,mkdir,symlink,rm} from 'node:fs/promises';\nimport {tmpdir} from 'node:os';\nimport {resolve,dirname} from 'node:path';\nimport {spawnSync} from 'node:child_process';\nimport {createHash} from 'node:crypto';\nimport {validateRefreshedTransientBuilder} from '../tools/acceptance/retained-transient.mjs';\nimport {validateRefreshedWorkerSoak} from '../tools/acceptance/retained-soak.mjs';\nimport {retainedGitSnapshotBytes} from '../tools/acceptance/retained-performance-snapshot.mjs';\nimport {validateFinalAcceptanceContract,verifyFinalAcceptance} from '../tools/acceptance/finalize.mjs';\nconst root=resolve(import.meta.dir,'..'),hash=b=>createHash('sha256').update(b).digest('hex');\n// These two canonical integrations consume the final projection of a source\n// run. The source probe cannot require that projection before producing the\n// run itself; all independent strict/deferral/forgery validators stay active.\nconst officialSourceProbe=process.env.ELISCRIPT_SKIP_RETAINED_ACCEPTANCE==='1';\nconst canonicalFinalTest=officialSourceProbe?test.skip:test;\nconst git=(cwd,args)=>{const child=spawnSync('git',args,{cwd});assert.equal(child.status,0,String(child.stderr));return child.stdout;};\nlet directory,run,contract,cases;\nbeforeAll(async()=>{\n directory=await mkdtemp(resolve(tmpdir(),'eliscript-retained-deferral-'));\n run=JSON.parse(await readFile(resolve(root,'acceptance/runs/m13-01.json'),'utf8'));\n contract=JSON.parse(await readFile(resolve(root,'contracts/final-acceptance.json'),'utf8'));\n const gitDirectory=String(git(root,['rev-parse','--absolute-git-dir'])).trim();\n cases=[];\n for(const [name,file,validate]of[['transient','benchmarks/transient-builder-macos-arm64.json',validateRefreshedTransientBuilder],['soak','benchmarks/worker-lifecycle-soak-macos-arm64.json',validateRefreshedWorkerSoak]]){\n  const workspace=resolve(directory,name);await mkdir(workspace);await symlink(gitDirectory,resolve(workspace,'.git'),'dir');\n  const revision=String(git(root,['log','-1','--format=%H','--',file])).trim(),bytes=git(root,['show',revision+':'+file]),report=JSON.parse(bytes),files=name==='transient'?report.sourceDigest.files:report.source.files.map(entry=>entry.file);\n  for(const source of files){const path=resolve(workspace,source);await mkdir(dirname(path),{recursive:true});await writeFile(path,git(root,['show',revision+':'+source]));}\n  await writeFile(resolve(workspace,files[0]),'// deliberately changed working source\\n',{flag:'a'});\n  cases.push({name,file,validate,workspace,bytes,revision,report});\n }\n},30000);\nafterAll(async()=>{await rm(directory,{recursive:true,force:true});});\ntest('default and explicit false still reject stale working sources even when the outer environment opts in',async()=>{for(const c of cases)for(const options of[undefined,{deferPerformanceAcceptance:false}])await assert.rejects(c.validate(c.workspace,c.file,c.bytes,run,options),/fresh source (aggregate|entry) is stale/);});\ntest('strict checks accept genuinely matching sources and reread later working changes while immutable Git cache bytes cannot be poisoned',async()=>{for(const c of cases){const source=c.name==='transient'?c.report.sourceDigest.files[0]:c.report.source.files[0].file,path=resolve(c.workspace,source),before=await readFile(path),measured=git(root,['show',c.revision+':'+source]);try{await writeFile(path,measured);assert.equal(await c.validate(c.workspace,c.file,c.bytes,run),true);await writeFile(path,'\\n// changed again\\n',{flag:'a'});await assert.rejects(c.validate(c.workspace,c.file,c.bytes,run),/fresh source (aggregate|entry) is stale/);}finally{await writeFile(path,before);}const args=['show',c.revision+':'+c.file],original=retainedGitSnapshotBytes(c.workspace,args);original.fill(0);assert.equal(hash(retainedGitSnapshotBytes(c.workspace,args)),hash(c.bytes));}});\ntest('explicit deferral verifies the measured Git source snapshot and reports current performance as unaccepted without mutating evidence',async()=>{const savedRun=JSON.stringify(run);for(const c of cases){const before=hash(c.bytes),result=await c.validate(c.workspace,c.file,c.bytes,run,{deferPerformanceAcceptance:true});assert.equal(result.historicalSourcesVerified,true);assert.equal(result.performanceAccepted,false);assert.equal(result.currentSourceAcceptance,'deferred');assert.equal(result.report,c.file);assert.equal(result.measuredSource.commit,c.revision);assert.equal(result.measuredSource.artifactSha256,before);assert.match(result.currentSourceFailure.message,/fresh source (aggregate|entry) is stale/);assert.equal(hash(c.bytes),before);}assert.equal(JSON.stringify(run),savedRun);});\ntest('deferral rejects substituted reports, source identities, measurements and accepted-run provenance',async()=>{for(const c of cases){const mutations=c.name==='transient'?[r=>{r.parameters.timingSamples=10;},r=>{r.results.vector.timing.speedup++;},r=>{r.sourceDigest.value='0'.repeat(64);}]:[r=>{r.limits.runTimeoutSeconds++;},r=>{r.workload.successfulRequests--;},r=>{r.source.files[0].sha256='0'.repeat(64);},r=>{r.source.digest='0'.repeat(64);}];for(const mutate of mutations){const report=structuredClone(c.report);mutate(report);await assert.rejects(c.validate(c.workspace,c.file,Buffer.from(JSON.stringify(report)),run,{deferPerformanceAcceptance:true}));}await assert.rejects(c.validate(c.workspace,c.file,Buffer.concat([c.bytes,Buffer.from('\\n')]),run,{deferPerformanceAcceptance:true}),error=>/report bytes differ from their measured Git snapshot/.test(error.message)&&/fresh source (aggregate|entry) is stale/.test(error.cause?.message));for(const mutate of[r=>{r.source.tree='0'.repeat(40);},r=>{r.artifacts.find(a=>a.file===c.file).sha256='0'.repeat(64);},r=>{r.artifacts.push({...r.artifacts.find(a=>a.file===c.file)});}]){const changed=structuredClone(run);mutate(changed);await assert.rejects(c.validate(c.workspace,c.file,c.bytes,changed,{deferPerformanceAcceptance:true}));}}});\ncanonicalFinalTest('the complete final contract and canonical manifest remain verified while deferred source checks are listed separately',async()=>{const deferred=[];const result=await validateFinalAcceptanceContract(contract,run,{root,deferPerformanceAcceptance:true,deferredPerformanceAcceptance:deferred});assert.equal(result,contract);const expected=[];for(const c of cases){const bytes=await readFile(resolve(root,c.file));try{await c.validate(root,c.file,bytes,run);}catch{expected.push(c.file);}}assert.deepEqual(deferred.map(item=>item.report).sort(),expected.sort());assert(deferred.every(item=>item.performanceAccepted===false));const manifest=await verifyFinalAcceptance({root,deferPerformanceAcceptance:true});assert.deepEqual(manifest,JSON.parse(await readFile(resolve(root,'acceptance/manifest.json'),'utf8')));});\ncanonicalFinalTest('CLI deferral verifies historical artifacts, prints NOT ACCEPTED, refuses promotion and generation and never rewrites canonical files',async()=>{const files=['acceptance/manifest.json','acceptance/report.md'],before=await Promise.all(files.map(file=>readFile(resolve(root,file))));const options={cwd:root,encoding:'utf8',env:{...process.env,ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE:'1'},timeout:30000},command=resolve(root,'tools/acceptance/finalize.mjs');const child=spawnSync(process.execPath,[command,'--verify'],options);assert.equal(child.status,0,child.stderr);assert.match(child.stdout,/DEFERRED \\/ NOT ACCEPTED/);assert.match(child.stdout,/Historical final acceptance:/);for(const args of[['--verify','--require-pass'],['--generate']]){const blocked=spawnSync(process.execPath,[command,...args],options);assert.equal(blocked.status,1,blocked.stderr);assert.match(blocked.stderr,/performance acceptance is deferred/);}for(let i=0;i<files.length;i++)assert.deepEqual(await readFile(resolve(root,files[i])),before[i]);},30000);\n"))
