(module tests.bootstrap-reader
  (import "node:fs" readFileSync)
  (import "bun:test" beforeAll afterAll expect test)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/diagnostics/check.mjs" diagnosticCorpusSuite)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory caseSource buildBootstrap seedResults loadModule)
  (defconst fixturePath (resolve projectDirectory "tests/fixtures/bootstrap-reader.json"))
  (defconst diagnosticCases (get (diagnosticCorpusSuite (JSON/parse (readFileSync (resolve projectDirectory "contracts/diagnostic-corpus.json") "utf8")) "reader") :cases))
  (defconst artifactNames (js-array "symbol.mjs" "symbol.mjs.map" "syntax.mjs" "syntax.mjs.map" "reader.mjs" "reader.mjs.map" "formatter.mjs" "formatter.mjs.map" "expander.mjs" "expander.mjs.map" "transient-analysis.mjs" "transient-analysis.mjs.map" "analyzer.mjs" "analyzer.mjs.map" "ir.mjs" "ir.mjs.map" "lower.mjs" "lower.mjs.map" "source-map.mjs" "source-map.mjs.map" "emitter.mjs" "emitter.mjs.map" "compiler.mjs" "compiler.mjs.map"))
  (defconst host-truth (js* "(value) => !!value"))
  (defun generatedResult (readString testCase source)
    (try (js-object :name (get testCase :name) :status "ok" :forms (funcall readString source (get testCase :filename)))
      (catch error (js-object :name (get testCase :name) :status "error" :message (get error :message) :diagnostic (get error :eliscriptDiagnostic)))))
  (defvar directory undefined) (defvar firstArtifacts undefined) (defvar secondArtifacts undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-reader-"))))
    (await (buildBootstrap directory)) (setq firstArtifacts (new globalThis.Map))
    (let ((index 0))
      (while (< index (js-length artifactNames))
        (let ((name (aref artifactNames index))) (js-call firstArtifacts :set name (await (readFile (resolve directory name) "utf8"))))
        (setq index (1+ index))))
    (await (buildBootstrap directory)) (setq secondArtifacts (new globalThis.Map))
    (let ((index 0))
      (while (< index (js-length artifactNames))
        (let ((name (aref artifactNames index))) (js-call secondArtifacts :set name (await (readFile (resolve directory name) "utf8"))))
        (setq index (1+ index))))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (test "bootstrapped reader matches normalized seed syntax and diagnostics" (async ()
    (js-call artifactNames :forEach (lambda (name) (js-call (expect (js-call secondArtifacts :get name)) :toBe (js-call firstArtifacts :get name))))
    (let* ((reader (await (loadModule directory "reader" "test"))) (fixture (JSON/parse (await (readFile fixturePath "utf8"))))
           (cases (js-call (get fixture :valid) :concat (get fixture :invalid))) (generated (js-array)) (index 0))
      (while (< index (js-length cases))
        (let ((testCase (aref cases index))) (js-call generated :push (generatedResult (get reader :read_string) testCase (await (caseSource testCase)))))
        (setq index (1+ index)))
      (js-call (expect generated) :toEqual (await (seedResults "reader" fixturePath)))
      (js-call (expect (js-call generated :slice (get (get fixture :valid) :length))) :toEqual
        (js-call diagnosticCases :map (lambda (entry) (js-object :name (get entry :name) :status "error" :message (get entry :human) :diagnostic (get entry :diagnostic)))))
      (js-call (expect (js-call firstArtifacts :get "reader.mjs.map")) :toContain "bootstrap/compiler/reader.eli"))) 30000)
)
