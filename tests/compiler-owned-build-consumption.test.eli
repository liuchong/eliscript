  (test "owned transport consumption preserves decode failure cancellation and original producer errors" (async ()
    (let* ((decoding (product)) (phases (js-array)) (observerFailure (js-object :observer "must not replace the original failure")))
      (put decoding :bytes (js-array 256))
      (let ((session (await (createCompilerSession (js-object :host "javascript" :compiler (driverFor (lambda () decoding)))))))
        (try
          (await (js-call assert :rejects (buildIndependentCompiler (buildNoDebug session "decode-failure" (js-object :onPhase (lambda (name) (js-call phases :push name) (throw observerFailure)))))
            (lambda (error) (and (funcall hostInstanceof error globalThis.TypeError) (= (get error :message) "compiler binary contains an invalid byte")))))
          (same (get decoding :bytes) (js-array 256)) (assert (js-call phases :includes "binary-decode-start")) (ae (js-call phases :includes "binary-decode-complete") false)
          (finally (js-call session :close))))
      (let* ((original (js-object :producer "first failure")) (session (await (createCompilerSession (js-object :host "javascript" :compiler (driverFor (lambda () (throw original))))))))
        (try (await (js-call assert :rejects (buildIndependentCompiler (buildNoDebug session "producer-failure" (js-object :onPhase (lambda () (throw observerFailure))))) (lambda (error) (= error original)))) (finally (js-call session :close))))
      (let* ((controller (new globalThis.AbortController)) (reason (js-object :cancelled "owned project")) (cancelled (product))
             (session (await (createCompilerSession (js-object :host "javascript" :compiler (driverFor (lambda () cancelled) (lambda () (js-call controller :abort reason))))))))
        (try
          (await (js-call assert :rejects (buildIndependentCompiler (buildNoDebug session "cancelled" (js-object :signal (get controller :signal)))) (lambda (error) (= error reason))))
          (same (get cancelled :bytes) (get (product) :bytes)) (same (get cancelled :debug) (get (product) :debug))
          (ae (get (js-call session :request (js-object :operation "capabilities")) :format) (get capabilities :format))
          (finally (js-call session :close)))))))
