  (defasync moduleAt (path) (await (funcall dynamicImport (get (pathToFileURL path) :href))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-owned-consumption-"))))
    (setq driverTemplate (await (readFile (new globalThis.URL "./fixtures/owned-declared-driver.mjs" (js* "import.meta.url")) "utf8"))
      managedTemplate (await (readFile (new globalThis.URL "./fixtures/owned-seed-managed.mjs" (js* "import.meta.url")) "utf8"))
      nativeTemplate (await (readFile (new globalThis.URL "./fixtures/owned-seed-native.mjs" (js* "import.meta.url")) "utf8"))
      emptyTemplate (await (readFile (new globalThis.URL "./fixtures/owned-seed-empty.mjs" (js* "import.meta.url")) "utf8")))))
  (afterAll (async () (unless (= directory undefined) (await (rm directory (js-object :recursive t :force t))))))
  ; These small fixtures exercise transport, writer and ownership protocols, not executable compiler correctness.
  (defun driverFor (factory &rest __host_default_arguments_1)
    (let* ((onProject (aref __host_default_arguments_1 0)))
    (when (= onProject undefined) (setq onProject (lambda () nil)))
    (js-object :compiler_session_new (lambda () (js-object)) :compiler_session_close (lambda () t)
      :compiler_session_request (lambda (state text)
        (let ((r (JSON/parse text)))
          (cond ((= (get r :operation) "runtime") (encodeCompilerIR (js-object :revision 1)))
            ((= (get r :operation) "capabilities") (encodeCompilerIR (js-object :format (get capabilities :format) :version 1)))
            ((= (get r :operation) "project") (funcall onProject r) (encodeCompilerIR (funcall factory)))
            (t (throw (new globalThis.Error "unexpected fixture request"))))))
      :compiler_session_project_owned (lambda (wire state text)
        (let ((r (JSON/parse text))) (ae (get r :operation) "project") (ae (get r :target) "native") (funcall onProject r)
          (js-object :format "eliscript-compiler-owned-project" :version 1 :value (funcall factory)))))))
  (defasync declaredDriverFixture (name)
    (let* ((output (resolve directory name)) (path (resolve output "compiler.mjs"))
           (sessionURL (get (pathToFileURL (resolve "tools/backends/compiler-session.mjs")) :href))
           (source (js-call (js-call driverTemplate :replace (JSON/stringify "__OWNED_SESSION_MODULE__") (JSON/stringify sessionURL))
             :replace (JSON/stringify "__OWNED_PRODUCT_DATA__") (JSON/stringify (encodeCompilerIR (product))))))
      (await (mkdir output (js-object :recursive t))) (await (writeFile path source))
      (js-object :path path :source source :artifact (js-object :host "javascript" :directory output :path "compiler.mjs" :modules (js-array (js-object :id "compiler.mjs" :path "compiler.mjs"))
        :artifactIdentity (js-object :algorithm "sha256" :files (js-array (js-object :path "compiler.mjs" :bytes (Buffer/byteLength source) :sha256 (js-call (js-call (createHash "sha256") :update source) :digest "hex"))))))))
  (defun seedFrontend (&rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)))
    (when (= options undefined) (setq options (js-object)))
    (let* ((programs (js-array)) (calls (js-array)) (data (encodeCompilerIR (product))) (frontend (js-object)))
      (put frontend :compile_ir_string (lambda (source filename)
        (js-call calls :push (js-array source filename))
        (when (= source (get options :failSource)) (throw (get options :failure)))
        (let ((program (Object/freeze (js-object :kind "program" :filename filename :source source
          :children (Object/freeze (js-array (js-object :kind "literal" :value zero :children (js-array))))))))
          (js-call programs :push program) program)))
      (put frontend :compile_string_with_source_map (lambda (source filename)
        (let ((javascript emptyTemplate))
          (when (js-call filename :endsWith "/managed.eli")
            (setq javascript (js-call managedTemplate :replace (JSON/stringify "__OWNED_PRODUCT_DATA__") (JSON/stringify data))))
          (when (js-call filename :endsWith "/native.eli")
            (setq javascript (js-call (js-call nativeTemplate :replace (JSON/stringify "__OWNED_PRODUCT_DATA__") (JSON/stringify data))
              :replace (JSON/stringify "__OWNED_THROW_DEBUG__") (if (= (get options :throwDebug) t) "true" "false"))))
          (js-object :javascript javascript :sourceMap "{\"version\":3}"))))
      (put frontend :compile_ir_string_with_origins (lambda (source filename) (Object/freeze (js-object :program (js-call frontend :compile_ir_string source filename) :macroOrigins (js-array (js-object :source source :filename filename))))))
      (put frontend :serialize_ir_program (lambda (program) (str "canonical:" (encodeCompilerIR program))))
      (js-object :frontend frontend :programs programs :calls calls))))
  (defun publicProducer (value &rest __host_forwarded_arguments_7)
    (let* ((fullCapabilities (aref __host_forwarded_arguments_7 0)))
    (js-object :host "javascript" :request (lambda (r)
      (cond ((= (get r :operation) "runtime") (js-object :revision 1))
        ((= (get r :operation) "capabilities") (if fullCapabilities capabilities (js-object :format (get capabilities :format) :version 1)))
        (t (ae (get r :operation) "project") value))))))
  (test "verified declared JavaScript artifacts transfer fresh native builds while public snapshots and later requests stay independent" (async ()
    (let* ((fixture (await (declaredDriverFixture "verified-native-driver"))) (session (await (openCompilerArtifact (get fixture :artifact)))) (driver (await (moduleAt (get fixture :path))))
           (r (copy (request) (js-object :debug t))) (observations (get driver :observations)))
      (try
        (let* ((retained (js-call session :request r)) (original (clone retained))
               (built undefined))
          (ae (get observations :wire) 1) (ae (get observations :owned) 0)
          (setq built (await (buildIndependentCompiler (buildOptions session "verified-native-product"))))
          (ae (get observations :wire) 1 "the graph-capable verified producer must not serialize a second complete result") (ae (get observations :owned) 1)
          (same (get built :bytes) (decodeCompilerBinary (get original :bytes))) (same (get built :typed) (get original :typed))
          (ae (await (readFile (get built :debugPath) "utf8")) (str (encodeCompilerIR (get original :debug)) "\n"))
          (same (get (JSON/parse (await (readFile (get built :metadataPath) "utf8"))) :typed) (plain (get original :typed)))
          (identical (aref (get (get (funcall fn built) :source) :children) 0) (aref (get (get (funcall fn built) :source) :children) 1))
          (assert (Object/is (get (get (funcall fn built) :body) :value) zero))
          (put (aref (get (get (funcall fn retained) :source) :children) 0) :value 91) (put (firstRange retained) :kind "public mutation")
          (assert (Object/is (get (aref (get (get (funcall fn built) :source) :children) 0) :value) zero))
          (let* ((later (js-call session :request r)) (next undefined))
            (ae (get observations :wire) 2) (ae (get observations :owned) 1)
            (different (get (funcall fn later) :source) (get (funcall fn built) :source)) (assert (Object/is (get (aref (get (get (funcall fn later) :source) :children) 0) :value) zero))
            (setq next (await (requestCompilerBuildConsumption session r (js-object :responseMode "graph-events-v1"))))
            (ae (get next :owned) t) (ae (isOwnedCompilerBuildProduct (get next :product)) t)
            (ae (get observations :owned) 2) (ae (get observations :wire) 2)
            (different (get (funcall fn (get next :product)) :source) (get (funcall fn built) :source))
            (identical (get (get (funcall fn (get next :product)) :source) :span) (get (firstRange (get next :product)) :span))
            (put (get (get (funcall fn later) :source) :span) :start 123) (ae (get (get (get (funcall fn (get next :product)) :source) :span) :start) 0)))
        (finally (js-call session :close))))))
  (test "verified consumption cannot be claimed by an injected driver an undeclared artifact or a public wrapper" (async ()
    (let* ((external (product)) (injected (await (createCompilerSession (js-object :host "javascript" :compiler (driverFor (lambda () external)))))))
      (try
        (await (js-call assert :rejects (registerVerifiedCompilerBuildConsumption injected) (new globalThis.RegExp "requires a verified JavaScript artifact session")))
        (let ((captured (await (requestCompilerBuildConsumption injected (js-object :operation "project" :target "native" :nativeTarget "arm64-linux")))))
          (different (get (get captured :product) :debug) (get external :debug)) (ae (isOwnedCompilerBuildProduct (get captured :product)) false))
        (finally (js-call injected :close))))
    (let* ((fixture (await (declaredDriverFixture "undeclared-driver"))) (undeclared (copy (get fixture :artifact) (js-object))))
      (Reflect/deleteProperty undeclared "artifactIdentity")
      (let ((session (await (openCompilerArtifact undeclared))) (driver (await (moduleAt (get fixture :path)))))
        (try
          (await (js-call assert :rejects (registerVerifiedCompilerBuildConsumption session) (new globalThis.RegExp "requires a verified JavaScript artifact session")))
          (let ((value (await (requestCompilerBuildConsumption session (js-object :operation "project" :target "native" :nativeTarget "arm64-linux")))))
            (ae (get (get driver :observations) :wire) 1) (ae (get (get driver :observations) :owned) 0) (ae (isOwnedCompilerBuildProduct (get value :product)) false))
          (finally (js-call session :close)))))
    (let* ((trusted (await (declaredDriverFixture "verified-wrapper-driver"))) (actual (await (openCompilerArtifact (get trusted :artifact)))) (observed (await (moduleAt (get trusted :path)))))
      (try
        (let ((wrapper (js-object :host (get actual :host) :request (lambda (&rest args) (Reflect/apply (get actual :request) actual args)))))
          (await (js-call assert :rejects (registerVerifiedCompilerBuildConsumption wrapper) (new globalThis.RegExp "requires a verified JavaScript artifact session")))
          (let ((value (await (requestCompilerBuildConsumption wrapper (js-object :operation "project" :target "wasm" :debug t)))))
            (ae (get value :owned) false) (ae (isOwnedCompilerBuildProduct (get value :product)) false)
            (ae (get (get observed :observations) :wire) 1) (ae (get (get observed :observations) :owned) 0)))
        (finally (js-call actual :close))))))
  (test "declared JavaScript driver hash failures precede import and exclusive consumption registration" (async ()
    (let ((fixture (await (declaredDriverFixture "tampered-verified-driver"))))
      ; Changed bytes must be rejected before the declared module can be imported.
      (await (writeFile (get fixture :path) (str (get fixture :source) "\nthrow new Error(\"must not import changed driver\");\n")))
      (await (js-call assert :rejects (openCompilerArtifact (get fixture :artifact)) (new globalThis.RegExp "compiler resource SHA-256 or byte length identity changed after emission"))))))
