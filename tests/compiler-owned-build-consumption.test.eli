              (different (get f :body) shared) (assert (Object/is (get (get f :body) :value) zero))
              (let ((metadata (JSON/parse (await (readFile (get artifact :metadataPath) "utf8")))))
                (same (get metadata :typed) (plain (get external :typed))) (same (get metadata :descriptor) (get external :descriptor)))
              (ae (await (readFile (get artifact :debugPath) "utf8")) (str (encodeCompilerIR (get external :debug)) "\n"))
              (let* ((r (request)) (thirdParty (js-call session :request r (js-object :responseMode "graph-events-v1"))))
                (identical (get (funcall fn thirdParty) :body) (aref (get (get (funcall fn thirdParty) :source) :children) 1)) (different (get (funcall fn thirdParty) :body) (get f :body))
                (put (get (funcall fn thirdParty) :body) :value 99) (assert (Object/is (get (get f :body) :value) zero)) (assert (Object/is (get shared :value) zero))
                (put (aref (get (aref retained 0) :events) 0) 0 "caller packet mutation")
                (ae (get (get artifact :typed) :abi) "memory-u32" "decoded containers never alias producer event packets")
                (let ((again (js-call session :request r (js-object :responseMode "graph-events-v1"))))
                  (assert (Object/is (get (get (funcall fn again) :body) :value) zero)) (different (get (funcall fn again) :body) (get f :body)))))
            (finally (js-call session :close))))))))
)
