(module capsules.tests.emacs-compatible-syntax.test
  (js* "import { expect, test } from \"bun:test\";\nimport { spawnSync } from \"node:child_process\";\nimport { readFileSync } from \"node:fs\";\nimport path from \"node:path\";\nimport { performance } from \"node:perf_hooks\";\nimport { fileURLToPath } from \"node:url\";\n\nimport {\n  compileCompatAbiWasm,\n  compileCompatProgram,\n  createCompatSession,\n  evalCompatProgram,\n  evalCompatProgramAsync,\n  getCompatTimingReport,\n  resetCompatState,\n  runCompatAbiNative,\n  runCompatAbiWasm,\n  serializeCompatValue,\n} from \"../runtime/emacs-compat.mjs\";\n\nconst testFilePath = fileURLToPath(import.meta.url);\nconst projectRoot = path.resolve(path.dirname(testFilePath), \"..\");\nconst testTimings = [];\n\nfunction runIsolatedSync(id, domain, fn) {\n  resetCompatState();\n  const t0 = performance.now();\n  let status = \"passed\";\n  try {\n    return fn();\n  } catch (err) {\n    status = \"failed\";\n    throw err;\n  } finally {\n    const elapsedMs = +(performance.now() - t0).toFixed(4);\n    testTimings.push({ id, domain, elapsedMs, status });\n    resetCompatState();\n  }\n}\n\nasync function runIsolatedAsync(id, domain, fn) {\n  resetCompatState();\n  const t0 = performance.now();\n  let status = \"passed\";\n  try {\n    return await fn();\n  } catch (err) {\n    status = \"failed\";\n    throw err;\n  } finally {\n    const elapsedMs = +(performance.now() - t0).toFixed(4);\n    testTimings.push({ id, domain, elapsedMs, status });\n    resetCompatState();\n  }\n}\n\n// ============================================================================\n// T01: 100% Emacs Lisp Default Kernel Semantics\n// ============================================================================\n\ntest(\"T01-01: Lisp-2 separate function/value slots, symbol-plist, and void-function on lexical var call\", () => {\n  runIsolatedSync(\"T01-01\", \"T01\", () => {\n    const res = evalCompatProgram(`\n      (progn\n        (defvar dual-sym 21)\n        (defun dual-sym (x) (* x 2))\n        (put 'dual-sym :meta-tag 'kernel-ok)\n        (list (dual-sym dual-sym)\n              (funcall #'dual-sym 9)\n              (apply #'dual-sym '(15))\n              (symbol-value 'dual-sym)\n              (get 'dual-sym :meta-tag)))\n    `);\n    expect(serializeCompatValue(res)).toEqual([42, 18, 30, 21, \"kernel-ok\"]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (let ((local-fn (lambda (x) (+ x 1))))\n          (local-fn 10))\n      `),\n    ).toThrow(/void-function/i);\n  });\n});\n\ntest(\"T01-02: unique nil falsiness and truthiness of 0, empty string, [], and extension sentinels\", () => {\n  runIsolatedSync(\"T01-02\", \"T01\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (require 'eliscript-js)\n      (list\n        (eq nil '())\n        (eq 'nil '())\n        (eq nil (list))\n        (if nil 'yes 'no)\n        (if '() 'yes 'no)\n        (if 0 't-zero 'f-zero)\n        (if 0.0 't-float 'f-float)\n        (if -0.0 't-negzero 'f-negzero)\n        (if \"\" 't-empty-str 'f-empty-str)\n        (if [] 't-empty-vec 'f-empty-vec)\n        (if (persistent-list) 't-plist 'f-plist)\n        (if (persistent-vector) 't-pvec 'f-pvec)\n        (if (result-error \"boom\") 't-err 'f-err)\n        (if option-none 't-none 'f-none)\n        (if js-false 't-js-false 'f-js-false)\n        (if js-null 't-js-null 'f-js-null)\n        (if js-undefined 't-js-undef 'f-js-undef))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      true,\n      true,\n      true,\n      \"no\",\n      \"no\",\n      \"t-zero\",\n      \"t-float\",\n      \"t-negzero\",\n      \"t-empty-str\",\n      \"t-empty-vec\",\n      \"t-plist\",\n      \"t-pvec\",\n      \"t-err\",\n      \"t-none\",\n      \"t-js-false\",\n      \"t-js-null\",\n      \"t-js-undef\",\n    ]);\n  });\n});\n\ntest(\"T01-03: lexical closures coexist with dynamic defvar special variables\", () => {\n  runIsolatedSync(\"T01-03\", \"T01\", () => {\n    const res = evalCompatProgram(`\n      (progn\n        (defvar *dyn-rate* 10)\n        (defvar *dyn-rate* 999)\n        (defconst *const-advisory* 5)\n        (defun read-dyn () *dyn-rate*)\n        (let ((adder (let ((lex-offset 3))\n                       (lambda (v) (+ v lex-offset (read-dyn))))))\n          (list\n            (funcall adder 2)\n            (let ((*dyn-rate* 20))\n              (funcall adder 2))\n            *dyn-rate*\n            (progn (setq *const-advisory* 6) *const-advisory*))))\n    `);\n    expect(serializeCompatValue(res)).toEqual([15, 25, 10, 6]);\n  });\n});\n\ntest(\"T01-04: mutable native collections and Emacs integer division/modulo/Unicode char semantics\", () => {\n  runIsolatedSync(\"T01-04\", \"T01\", () => {\n    const res = evalCompatProgram(`\n      (let ((pair (cons 1 2))\n            (vec [10 20 30])\n            (ht (make-hash-table :test 'equal)))\n        (setcar pair 11)\n        (setcdr pair 22)\n        (aset vec 1 99)\n        (puthash \"k\" 42 ht)\n        (list (car pair) (cdr pair)\n              (vectorp vec) (aref vec 1)\n              (gethash \"k\" ht) (hash-table-count ht)\n              (/ 7 2) (/ -7 2) (/ 7.0 2) (/ 24 2 3)\n              (mod -7 3) (% -7 3)\n              (length \"a😀b\")\n              (substring \"a😀b\" 1 2)))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      11,\n      22,\n      true,\n      99,\n      42,\n      1,\n      3,\n      -3,\n      3.5,\n      4,\n      2,\n      -1,\n      3,\n      \"😀\",\n    ]);\n    expect(() => evalCompatProgram(\"(/ 10 0)\")).toThrow(/arith-error/i);\n  });\n});\n\ntest(\"T01-05: catch/throw, condition-case, unwind-protect, and unrestricted defmacro\", () => {\n  runIsolatedSync(\"T01-05\", \"T01\", () => {\n    const res = evalCompatProgram(`\n      (progn\n        (defmacro with-double-add (a b)\n          \\`(+ (* 2 ,a) (* 2 ,b)))\n        (let ((log nil))\n          (let ((caught\n                 (catch 'done\n                   (unwind-protect\n                       (progn\n                         (push 'entered log)\n                         (throw 'done (with-double-add 10 11)))\n                     (push 'cleaned log)))))\n            (let ((handled\n                   (condition-case err\n                       (/ 1 0)\n                     (arith-error (list 'caught-arith (car err))))))\n              (list caught (nreverse log) handled)))))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      42,\n      [\"entered\", \"cleaned\"],\n      [\"caught-arith\", \"arith-error\"],\n    ]);\n  });\n});\n\n// ============================================================================\n// T02: Extension Activation by Definition Identity & Conflict Protection\n// ============================================================================\n\ntest(\"T02-01: unimported extension names remain user-definable and atom stays native\", () => {\n  runIsolatedSync(\"T02-01\", \"T02\", () => {\n    const res1 = evalCompatProgram(`\n      (progn\n        (defun await (x) (+ x 100))\n        (await 23))\n    `);\n    expect(serializeCompatValue(res1)).toBe(123);\n\n    resetCompatState();\n    const res2 = evalCompatProgram(`\n      (require 'eliscript)\n      (list (atom 'sym)\n            (atom 42)\n            (atom nil)\n            (atom '(1 . 2))\n            (cell-value (state-cell 77)))\n    `);\n    expect(serializeCompatValue(res2)).toEqual([true, true, true, null, 77]);\n  });\n});\n\ntest(\"T02-02: loading an extension over a conflicting user definition signals compile error\", () => {\n  runIsolatedSync(\"T02-02\", \"T02\", () => {\n    expect(() =>\n      evalCompatProgram(`\n        (progn\n          (defun persistent-vector (x) x)\n          (require 'eliscript-data))\n      `),\n    ).toThrow(/conflict|ELI-M0001|eliscript-compile-error/i);\n  });\n});\n\n// ============================================================================\n// T03: Unified pcase Superset & Destructuring (eliscript-bind)\n// ============================================================================\n\ntest(\"T03-01: unified destructuring patterns across vector, list, map (nil vs missing), record, result, option\", () => {\n  runIsolatedSync(\"T03-01\", \"T03\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (cl-defstruct-persistent account\n        (owner :type string)\n        (balance :type integer :default 0))\n      (let-bind (([a b &rest vtail] (persistent-vector 10 20 30 40))\n                 ([na nb &rest nvtail] [1 2 3])\n                 ((:list l1 l2 &rest ltail) (persistent-list 'x 'y 'z))\n                 ((:map (:present-nil (default pn 'fallback))\n                        (:missing-key (default mk 'used-default)))\n                  (persistent-map :present-nil nil))\n                 ((:record account (:owner acc-owner) (:balance acc-bal))\n                  (make-account :owner \"Ada\" :balance 500))\n                 ((:ok ok-val) (result-ok 99))\n                 ((:some some-val) (option-some \"hi\")))\n        (list a b (persistent-vector-p vtail) (value-count vtail)\n              na nb (vectorp nvtail) (length nvtail)\n              l1 l2 (persistent-list-p ltail) (value-count ltail)\n              pn mk\n              acc-owner acc-bal\n              ok-val some-val))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      10,\n      20,\n      true,\n      2,\n      1,\n      2,\n      true,\n      1,\n      \"x\",\n      \"y\",\n      true,\n      1,\n      null,\n      \"used-default\",\n      \"Ada\",\n      500,\n      99,\n      \"hi\",\n    ]);\n  });\n});\n\ntest(\"T03-02: defun-bind optional defaults, pcase-value structural matching, and cond-predicate\", () => {\n  runIsolatedSync(\"T03-02\", \"T03\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (defun-bind format-pair ([x y] &optional ((:map (:sep sep)) (persistent-map :sep \":\")))\n        (format \"%s%s%s\" x sep y))\n      (let ((target (persistent-vector 1 2)))\n        (list\n          (format-pair (persistent-vector \"a\" \"b\"))\n          (format-pair [\"a\" \"b\"] (persistent-map :sep \"-\"))\n          (pcase-value target\n            ((persistent-vector 1 2) 'matched-vec)\n            (_ 'no-match))\n          (cond-predicate #'equal \"beta\"\n            \"alpha\" 'first\n            \"beta\" :>> (lambda (matched) (list 'got matched))\n            'fallback)))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      \"a:b\",\n      \"a-b\",\n      \"matched-vec\",\n      [\"got\", true],\n    ]);\n  });\n});\n\ntest(\"T03-03: destructuring negative diagnostics (missing key, explicit nil to optional, duplicate vars, length mismatch)\", () => {\n  runIsolatedSync(\"T03-03\", \"T03\", () => {\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (let-bind (((:map (:required-key k)) (persistent-map :other 1)))\n          k)\n      `),\n    ).toThrow(/missing|destructure|match/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun-bind take-opt (&optional ([a b] [1 2])) (+ a b))\n        (take-opt nil)\n      `),\n    ).toThrow(/destructure|vector|match/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (let-bind (([dup dup] [1 2])) dup)\n      `),\n    ).toThrow(/duplicate|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (let-bind (([a b c] [1 2])) a)\n      `),\n    ).toThrow(/length|destructure|match/i);\n  });\n});\n\n// ============================================================================\n// T04: Multi-Arity, let-const, 50k Tail Recursion (recur), Threading & fn-*\n// ============================================================================\n\ntest(\"T04-01: defun-case and lambda-case dispatch and arity validation\", () => {\n  runIsolatedSync(\"T04-01\", \"T04\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (defun-case calc\n        (() 0)\n        ((x) (* x 10))\n        ((x y) (+ x y))\n        ((x y z &rest more) (+ x y z (apply #'+ more))))\n      (let ((anon (lambda-case\n                    ((a) (list 'one a))\n                    ((a b) (list 'two a b)))))\n        (list (calc) (calc 5) (calc 3 4) (calc 1 2 3 4 5)\n              (funcall anon 'p) (funcall anon 'p 'q)))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      0,\n      50,\n      7,\n      15,\n      [\"one\", \"p\"],\n      [\"two\", \"p\", \"q\"],\n    ]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun-case bad-dup ((x) x) ((y) y))\n      `),\n    ).toThrow(/duplicate|arity|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun-case bad-opt ((x &optional y) x))\n      `),\n    ).toThrow(/optional|arity|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun-case bad-overlap ((x &rest r) x) ((a b) a))\n      `),\n    ).toThrow(/overlap|arity|eliscript-compile-error/i);\n  });\n});\n\ntest(\"T04-02: let-const protection and 50,000-depth stack-safe recur\", () => {\n  runIsolatedSync(\"T04-02\", \"T04\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (defun-tail sum-to (n acc)\n        (if (<= n 0)\n            acc\n          (recur (1- n) (+ acc n))))\n      (let-const ((box (make-hash-table :test 'equal))\n                  (limit 50000))\n        (puthash \"ok\" t box)\n        (list (gethash \"ok\" box)\n              (sum-to limit 0)\n              (let-loop ((i 0) (a 1) (b 2))\n                (if (>= i 1)\n                    (list a b)\n                  (recur (1+ i) b a)))))\n    `);\n    expect(serializeCompatValue(res)).toEqual([true, 1250025000, [2, 1]]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (let-const ((x 10))\n          (setq x 20))\n      `),\n    ).toThrow(/const|setq|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun-tail bad-recur (n)\n          (if (<= n 0) 0 (+ 1 (recur (1- n)))))\n      `),\n    ).toThrow(/tail|recur|eliscript-compile-error/i);\n  });\n});\n\ntest(\"T04-03: threading macros (including thread-some-* nil short-circuit) and fn-* combinators\", () => {\n  runIsolatedSync(\"T04-03\", \"T04\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (let ((side-effects 0))\n        (let ((res-some-nil\n               (thread-some-first (persistent-map :a nil)\n                 (value-get :a)\n                 (prog1 (setq side-effects (1+ side-effects)))))\n              (res-some-ok\n               (thread-some-last 5\n                 (+ 10)\n                 (* 2)))\n              (res-as\n               (thread-as 3 v\n                 (* v v)\n                 (+ v 1)))\n              (res-cond\n               (thread-cond-first 10\n                 t (+ 5)\n                 nil (* 100)\n                 t (- 3)))\n              (comb (fn-compose #'1+ (fn-partial #'* 3)))\n              (juxt-fn (fn-juxt #'1- #'1+))\n              (odd-fn (fn-complement #'cl-evenp)))\n          (list res-some-nil side-effects res-some-ok res-as res-cond\n                (funcall comb 4)\n                (funcall juxt-fn 10)\n                (funcall odd-fn 7)\n                (funcall odd-fn 8))))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      null,\n      0,\n      30,\n      10,\n      12,\n      13,\n      [9, 11],\n      true,\n      null,\n    ]);\n  });\n});\n\n// ============================================================================\n// T05: Persistent Collections, seq/map Generics, Struct Schema, Protocols, Cells\n// ============================================================================\n\ntest(\"T05-01: 7 persistent collections, value-* APIs, and Emacs seq.el/map.el generics\", () => {\n  runIsolatedSync(\"T05-01\", \"T05\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (let* ((pl (persistent-list 1 2 3))\n             (pv (persistent-vector 10 20 30))\n             (pm (persistent-map :a 1 :b 2))\n             (pm2 (value-put pm :b 22))\n             (pm3 (value-remove pm2 :a))\n             (ps (persistent-set 'x 'y 'x))\n             (pq (value-conj (persistent-queue 1) 2))\n             (psm (persistent-sorted-map #'value-compare :z 9 :a 1 :m 5))\n             (pss (persistent-sorted-set #'value-compare 30 10 20))\n             (empty-with-meta (value-with-meta (persistent-list) (persistent-map :tag 'meta-ok))))\n        (list\n          (persistent-list-p pl) (persistent-vector-p pv) (persistent-map-p pm)\n          (persistent-set-p ps) (persistent-queue-p pq)\n          (persistent-sorted-map-p psm) (persistent-sorted-set-p pss)\n          (value-get pm :b) (value-get pm2 :b) (value-get pm3 :a 'gone)\n          (value-count ps)\n          (seq-length pv) (seq-elt pv 1)\n          (seq-map #'1+ pl)\n          (seq-filter #'cl-evenp pv)\n          (map-elt pm2 :b)\n          (map-contains-key pm2 :a)\n          (persistent-vector-p (seq-into '(7 8) 'persistent-vector))\n          (map-keys psm)\n          (seq-into pss 'list)\n          (value-empty-p empty-with-meta)\n          (if empty-with-meta 'truthy 'falsy)\n          (value-get (value-meta empty-with-meta) :tag)))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      true,\n      true,\n      true,\n      true,\n      true,\n      true,\n      true,\n      2,\n      22,\n      \"gone\",\n      2,\n      3,\n      20,\n      [2, 3, 4],\n      [10, 20, 30],\n      22,\n      true,\n      true,\n      [\":a\", \":m\", \":z\"],\n      [10, 20, 30],\n      true,\n      \"truthy\",\n      \"meta-ok\",\n    ]);\n  });\n});\n\ntest(\"T05-02: cl-defstruct-persistent field contracts and JSON Schema roundtrip\", () => {\n  runIsolatedSync(\"T05-02\", \"T05\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (cl-defstruct-persistent tool-spec\n        \"Tool invocation record.\"\n        (name :type string :doc \"Tool name\")\n        (retries :type integer :min 0 :max 5 :default 1 :doc \"Retry count\")\n        payload)\n      (let* ((t1 (make-tool-spec :name \"search\" :payload (persistent-map :q \"lisp\")))\n             (t2 (tool-spec-with t1 :retries 3))\n             (schema (struct-json-schema 'tool-spec))\n             (json-str (struct-to-json 'tool-spec t2))\n             (t3 (struct-from-json 'tool-spec json-str)))\n        (list (tool-spec-p t1)\n              (tool-spec-name t1)\n              (tool-spec-retries t1)\n              (tool-spec-retries t2)\n              (struct-validate 'tool-spec t2)\n              (value-get schema :type)\n              (value-equal-p t2 t3)))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      true,\n      \"search\",\n      1,\n      3,\n      true,\n      \"object\",\n      true,\n    ]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (cl-defstruct-persistent item (score :type integer :min 0 :max 10))\n        (make-item :score -1)\n      `),\n    ).toThrow(/min|schema|validate|type/i);\n  });\n});\n\ntest(\"T05-03: protocols, cl-defgeneric-value, state-cell, delay, lazy-seq, transducers, and with-transient\", () => {\n  runIsolatedSync(\"T05-03\", \"T05\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (defprotocol IDescribe\n        (describe-val (self)))\n      (cl-defstruct-persistent point (x :type integer) (y :type integer))\n      (extend-protocol IDescribe point\n        (describe-val (self)\n          (format \"pt(%d,%d)\" (point-x self) (point-y self))))\n      (cl-defgeneric-value dispatch-tag (kind val) kind)\n      (cl-defmethod-value dispatch-tag :double (_kind val) (* val 2))\n      (let* ((cell (state-cell 10 :validator (lambda (v) (>= v 0))))\n             (watched nil)\n             (_ (cell-watch cell :logger (lambda (_k _r old new) (push (list old new) watched))))\n             (_ (cell-update! cell (lambda (v) (+ v 5))))\n             (d (let ((x 20)) (delay (+ x 22))))\n             (lseq (lazy-take 4 (lazy-filter #'cl-evenp (lazy-map #'1+ (lazy-range 1)))))\n             (xform (fn-compose (map-transducer (lambda (x) (* x 2)))\n                                (filter-transducer (lambda (x) (> x 4)))))\n             (transduced (seq-transduce xform #'+ 0 '(1 2 3 4)))\n             (built (with-transient (b (persistent-vector))\n                      (dolist (n '(1 2 3))\n                        (conj! b (* n 10))))))\n        (list (describe-val (make-point :x 3 :y 4))\n              (dispatch-tag :double 21)\n              (cell-value cell)\n              watched\n              (realized-p d) (force d) (realized-p d)\n              (seq-into lseq 'list)\n              transduced\n              (persistent-vector-p built)\n              (seq-into built 'list)))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      \"pt(3,4)\",\n      42,\n      15,\n      [[10, 15]],\n      null,\n      42,\n      true,\n      [2, 4, 6, 8],\n      14,\n      true,\n      [10, 20, 30],\n    ]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (let ((escaped nil))\n          (with-transient (b (persistent-vector))\n            (setq escaped b)\n            (conj! b 1))\n          (conj! escaped 2))\n      `),\n    ).toThrow(/transient|sealed|expired/i);\n  });\n});\n\n// ============================================================================\n// T06: Module System (defmodule), Lexical Privacy, Live Exports & Checked Macros\n// ============================================================================\n\ntest(\"T06-01: defmodule lexical privacy against global fset/set and live value exports\", () => {\n  runIsolatedSync(\"T06-01\", \"T06\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (defmodule sample.counter\n        (defconst-lexical step 5)\n        (defvar-lexical count 0)\n        (defun-lexical add-step (v) (+ v step))\n        (defun bump! ()\n          (setq count (add-step count))\n          count)\n        (export-functions bump!)\n        (export-values count))\n      (fset 'add-step (lambda (_v) 9999))\n      (set 'step 9999)\n      (import-functions sample.counter :only (bump!))\n      (import-values sample.counter :only (count))\n      (let ((c0 count)\n            (c1 (bump!))\n            (c2 count))\n        (list c0 c1 c2))\n    `);\n    expect(serializeCompatValue(res)).toEqual([0, 5, 5]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defmodule bad.const\n          (defconst-lexical fixed 1)\n          (defun mutate () (setq fixed 2)))\n      `),\n    ).toThrow(/const|setq|eliscript-compile-error/i);\n  });\n});\n\ntest(\"T06-02: defmacro-checked deterministic macro-gensym and declared file input enforcement\", () => {\n  runIsolatedSync(\"T06-02\", \"T06\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (defmacro-checked eval-once-double (form)\n        (declare (eliscript :pure t :portable t))\n        (let ((tmp (macro-gensym \"val\")))\n          \\`(let ((,tmp ,form))\n             (+ ,tmp ,tmp))))\n      (let ((counter 0))\n        (list (eval-once-double (setq counter (1+ counter)))\n              counter))\n    `);\n    expect(serializeCompatValue(res)).toEqual([2, 1]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defmacro-checked bad-reader ()\n          (macro-read-file \"package.json\"))\n        (bad-reader)\n      `),\n    ).toThrow(/inputs|undeclared|eliscript-compile-error/i);\n  });\n});\n\n// ============================================================================\n// T07: Static Contracts & AI Pre/Post-Conditions (eliscript-contract)\n// ============================================================================\n\ntest(\"T07-01: declare static checks (:pure, :portable, :checked, :async/:destructure on defun) and runtime pre/post assertions\", () => {\n  runIsolatedSync(\"T07-01\", \"T07\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (defun clamp-pct (x)\n        (declare (eliscript :pure t :portable t\n                            :params ((x numberp))\n                            :returns numberp\n                            :requires ((>= x -1000))\n                            :ensures ((and (>= result 0) (<= result 100)))))\n        (min 100 (max 0 x)))\n      (list (clamp-pct -20) (clamp-pct 45) (clamp-pct 250))\n    `);\n    expect(serializeCompatValue(res)).toEqual([0, 45, 100]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun sneaky-async (x)\n          (declare (eliscript :async t))\n          x)\n      `),\n    ).toThrow(/defun-async|async|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun sneaky-bind ([x y])\n          (declare (eliscript :destructure t))\n          (+ x y))\n      `),\n    ).toThrow(/defun-bind|destructure|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun non-portable-fn ()\n          (declare (eliscript :portable t))\n          (current-buffer))\n      `),\n    ).toThrow(/portable|current-buffer|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun positive-only (x)\n          (declare (eliscript :requires ((> x 0)) :ensures ((> result 0))))\n          x)\n        (positive-only -5)\n      `),\n    ).toThrow(/requires|contract/i);\n  });\n});\n\n// ============================================================================\n// T08: Async Functions, Structured Concurrency, Timeouts, Channels & Engine RPC\n// ============================================================================\n\ntest(\"T08-01: defun-async/await, with-async-scope, async-channel, and engine-bind handle revocation\", async () => {\n  await runIsolatedAsync(\"T08-01\", \"T08\", async () => {\n    const res = await evalCompatProgramAsync(`\n      (require 'eliscript)\n      (defun-async compute-step (x)\n        (+ x 10))\n      (defun-async pipeline-demo ()\n        (let ((ch (make-async-channel 2))\n              (cleaned nil))\n          (await (channel-put! ch (await (compute-step 5))))\n          (await (channel-put! ch 27))\n          (channel-close! ch)\n          (let ((v1 (option-value (await (channel-take! ch))))\n                (v2 (option-value (await (channel-take! ch))))\n                (v3 (await (channel-take! ch))))\n            (let ((stale-handle nil))\n              (with-async-scope (scope)\n                (setq stale-handle (engine-bind (lambda (n) (* n 2)) scope))\n                (unwind-protect\n                    (+ v1 v2)\n                  (setq cleaned t)))\n              (list (+ v1 v2) (option-none-p v3) cleaned (engine-handle-p stale-handle))))))\n      (eliscript-async-wait (pipeline-demo))\n    `);\n    expect(serializeCompatValue(res)).toEqual([42, true, true, true]);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (defun sync-caller (f)\n          (await f))\n      `),\n    ).toThrow(/await|async|eliscript-compile-error/i);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (let ((h (engine-bind (lambda (x) x))))\n          (engine-revoke! h)\n          (eliscript-async-wait (engine-call 'local h 10)))\n      `),\n    ).toThrow(/eliscript-engine-handle-error|revoked/i);\n  });\n});\n\n// ============================================================================\n// T09: Explicit JS Interop, Raw Sentinels & js-regexp (eliscript-js)\n// ============================================================================\n\ntest(\"T09-01: js-false/js-null/js-undefined sentinels, UTF-16 helpers, and js-regexp\", () => {\n  runIsolatedSync(\"T09-01\", \"T09\", () => {\n    const res = evalCompatProgram(`\n      (require 'eliscript)\n      (require 'eliscript-js)\n      (let ((obj (js-object :flag js-false :empty js-undefined :num 42)))\n        (string-match \"\\\\([a-z]+\\\\)\" \"hello123\")\n        (let ((before-match (match-string 1 \"hello123\"))\n              (rx-res (js-regexp-find (js-regexp \"([0-9]+)\") \"hello123\"))\n              (after-match (match-string 1 \"hello123\")))\n          (list\n            (js-get obj :flag)\n            (js-get obj :empty)\n            (js-get obj :num)\n            (js-false-p (js-get-raw obj :flag))\n            (js-undefined-p (js-get-raw obj :empty))\n            (js-nullish-p js-null)\n            (js-nullish-p js-undefined)\n            (js-nullish-p js-false)\n            (/ 5 2)\n            (js-divide 5 2)\n            (length \"😀\")\n            (js-length \"😀\")\n            (value-get rx-res :match)\n            (equal before-match after-match))))\n    `);\n    expect(serializeCompatValue(res)).toEqual([\n      null,\n      null,\n      42,\n      true,\n      true,\n      true,\n      true,\n      null,\n      2,\n      2.5,\n      1,\n      2,\n      \"123\",\n      true,\n    ]);\n  });\n});\n\n// ============================================================================\n// T10: Multi-Target WASM & ARM64 Native Zero-Allocation Kernel ABI (eliscript-abi)\n// ============================================================================\n\ntest(\"T10-01: :abi :numeric-f64 and :abi :memory-u32 across JS, WebAssembly, and ARM64 Native\", async () => {\n  await runIsolatedAsync(\"T10-01\", \"T10\", async () => {\n    const source = `\n      (require 'eliscript)\n      (require 'eliscript-abi)\n      (defun hyp-sq (a b)\n        (declare (eliscript :abi :numeric-f64\n                            :export \"hyp_sq\"\n                            :params ((a :f64) (b :f64))\n                            :returns :f64))\n        (+ (* a a) (* b b)))\n      (defun mem-checksum (offset)\n        (declare (eliscript :abi :memory-u32\n                            :export \"mem_checksum\"\n                            :params ((offset :u32))\n                            :returns :u32))\n        (mem-store-u32 offset 305419896)\n        (word-add (mem-load-u32 offset) 1))\n      (with-abi-memory (:initial-pages 1 :max-pages 4)\n        (list (hyp-sq 3.0 4.0)\n              (mem-checksum 64)\n              (word-add #xffffffff 1)))\n    `;\n    const jsRes = evalCompatProgram(source);\n    expect(serializeCompatValue(jsRes)).toEqual([25.0, 305419897, 0]);\n\n    const wasmRes = await runCompatAbiWasm(source, \"hyp_sq\", [3.0, 4.0]);\n    expect(wasmRes).toBe(25.0);\n\n    const wasmMemRes = await runCompatAbiWasm(source, \"mem_checksum\", [64]);\n    expect(wasmMemRes >>> 0).toBe(305419897);\n\n    const nativeRes = await runCompatAbiNative(source, \"hyp_sq\", [3.0, 4.0]);\n    expect(nativeRes).toBe(25.0);\n\n    expect(() =>\n      evalCompatProgram(`\n        (require 'eliscript)\n        (require 'eliscript-abi)\n        (defun bad-abi (x)\n          (declare (eliscript :abi :numeric-f64))\n          (list x))\n      `),\n    ).toThrow(/ELI-B0001|numeric-f64|eliscript-compile-error/i);\n  });\n});\n\n// ============================================================================\n// T11: 50+ Corpus Differential Oracle (Native Emacs vs. JS 0.1.0 Compiler/Runtime)\n// ============================================================================\n\nconst DIFFERENTIAL_CORPUS = [\n  { id: \"D01\", code: \"(+ 1 2 3 4)\" },\n  { id: \"D02\", code: \"(list (/ 7 2) (/ -7 2) (mod -7 3) (% -7 3))\" },\n  { id: \"D03\", code: \"(list (eq nil '()) (if 0 'yes 'no) (if \\\"\\\" 'yes 'no) (if [] 'yes 'no))\" },\n  { id: \"D04\", code: \"(progn (defvar v-d04 7) (defun v-d04 (x) (+ x 10)) (v-d04 v-d04))\" },\n  { id: \"D05\", code: \"(let ((p (cons 'a 'b))) (setcar p 'x) (setcdr p 'y) (list (car p) (cdr p)))\" },\n  { id: \"D06\", code: \"(let ((v [1 2 3])) (aset v 1 99) (list (aref v 0) (aref v 1) (aref v 2)))\" },\n  { id: \"D07\", code: \"(let ((h (make-hash-table :test 'equal))) (puthash \\\"a\\\" 11 h) (list (gethash \\\"a\\\" h) (hash-table-count h)))\" },\n  { id: \"D08\", code: \"(progn (defvar *d08* 5) (defun r-d08 () *d08*) (list (r-d08) (let ((*d08* 9)) (r-d08)) (r-d08)))\" },\n  { id: \"D09\", code: \"(catch 'tag (progn (throw 'tag 'escaped) 'unreachable))\" },\n  { id: \"D10\", code: \"(condition-case e (/ 1 0) (arith-error (car e)))\" },\n  { id: \"D11\", code: \"(let ((x 0)) (unwind-protect (setq x 1) (setq x (+ x 10))) x)\" },\n  { id: \"D12\", code: \"(progn (defmacro m-d12 (x) \\`(* ,x 3)) (m-d12 7))\" },\n  { id: \"D13\", code: \"(progn (defun await (x) (+ x 5)) (await 10))\" },\n  { id: \"D14\", code: \"(require 'eliscript) (list (atom 'a) (atom '(1 2)) (cell-value (state-cell 19)))\" },\n  { id: \"D15\", code: \"(require 'eliscript) (let ((pl (persistent-list 1 2))) (list (persistent-list-p pl) (value-count pl) (seq-into pl 'list)))\" },\n  { id: \"D16\", code: \"(require 'eliscript) (let ((pv (persistent-vector 4 5 6))) (list (persistent-vector-p pv) (value-nth pv 1) (seq-elt pv 2)))\" },\n  { id: \"D17\", code: \"(require 'eliscript) (let* ((m1 (persistent-map :a 1)) (m2 (value-put m1 :b 2))) (list (value-get m1 :b 'none) (value-get m2 :b)))\" },\n  { id: \"D18\", code: \"(require 'eliscript) (let ((s (persistent-set 1 2 1))) (value-count s))\" },\n  { id: \"D19\", code: \"(require 'eliscript) (let ((q (value-conj (persistent-queue 10) 20))) (seq-into q 'list))\" },\n  { id: \"D20\", code: \"(require 'eliscript) (map-keys (persistent-sorted-map #'value-compare :c 3 :a 1 :b 2))\" },\n  { id: \"D21\", code: \"(require 'eliscript) (seq-into (persistent-sorted-set #'value-compare 9 3 6) 'list)\" },\n  { id: \"D22\", code: \"(require 'eliscript) (let ((e (value-with-meta (persistent-list) (persistent-map :k 7)))) (list (if e 't 'f) (value-empty-p e) (value-get (value-meta e) :k)))\" },\n  { id: \"D23\", code: \"(require 'eliscript) (let-bind (([x y &rest r] (persistent-vector 1 2 3 4))) (list x y (value-count r)))\" },\n  { id: \"D24\", code: \"(require 'eliscript) (let-bind (((:list a &rest b) (persistent-list 7 8 9))) (list a (value-count b)))\" },\n  { id: \"D25\", code: \"(require 'eliscript) (let-bind (((:map (:k1 (default v1 99)) (:k2 (default v2 88))) (persistent-map :k1 nil))) (list v1 v2))\" },\n  { id: \"D26\", code: \"(require 'eliscript) (let-bind (((:ok x) (result-ok 42)) ((:some y) (option-some 8))) (+ x y))\" },\n  { id: \"D27\", code: \"(require 'eliscript) (defun-bind db-d27 ([a b] &optional ([c d] [3 4])) (+ a b c d)) (list (db-d27 [1 2]) (db-d27 [1 2] [10 20]))\" },\n  { id: \"D28\", code: \"(require 'eliscript) (pcase-value (persistent-vector 'a 'b) ((persistent-vector 'a 'b) 'hit) (_ 'miss))\" },\n  { id: \"D29\", code: \"(require 'eliscript) (cond-predicate #'< 5 10 'lt 3 'gt 'other)\" },\n  { id: \"D30\", code: \"(require 'eliscript) (defun-case dc-d30 (() 'zero) ((x) (list 'one x)) ((x y &rest r) (list 'many x y (length r)))) (list (dc-d30) (dc-d30 9) (dc-d30 1 2 3 4))\" },\n  { id: \"D31\", code: \"(require 'eliscript) (let-const ((x 10) (y 20)) (+ x y))\" },\n  { id: \"D32\", code: \"(require 'eliscript) (let-loop ((n 100) (acc 0)) (if (<= n 0) acc (recur (1- n) (+ acc n))))\" },\n  { id: \"D33\", code: \"(require 'eliscript) (defun-tail dt-d33 (n acc) (if (<= n 0) acc (recur (1- n) (+ acc 2)))) (dt-d33 200 0)\" },\n  { id: \"D34\", code: \"(require 'eliscript) (thread-as 4 x (* x x) (+ x 1))\" },\n  { id: \"D35\", code: \"(require 'eliscript) (thread-cond-first 10 t (+ 5) nil (* 99) t (- 2))\" },\n  { id: \"D36\", code: \"(require 'eliscript) (list (thread-some-first (persistent-map :a nil) (value-get :a) (1+)) (thread-some-first (persistent-map :a 4) (value-get :a) (1+)))\" },\n  { id: \"D37\", code: \"(require 'eliscript) (let ((f (fn-compose #'1+ (fn-partial #'+ 10))) (j (fn-juxt #'1- #'1+))) (list (funcall f 5) (funcall j 5)))\" },\n  { id: \"D38\", code: \"(require 'eliscript) (cl-defstruct-persistent u-d38 (name :type string) (age :type integer :min 0 :default 18)) (let* ((u1 (make-u-d38 :name \\\"Bob\\\")) (u2 (u-d38-with u1 :age 30))) (list (u-d38-p u2) (u-d38-name u2) (u-d38-age u1) (u-d38-age u2)))\" },\n  { id: \"D39\", code: \"(require 'eliscript) (defprotocol P-D39 (p-act (x))) (cl-defstruct-persistent box-d39 (v :type integer)) (extend-protocol P-D39 box-d39 (p-act (x) (* (box-d39-v x) 3))) (p-act (make-box-d39 :v 14))\" },\n  { id: \"D40\", code: \"(require 'eliscript) (cl-defgeneric-value gv-d40 (k v) k) (cl-defmethod-value gv-d40 :inc (_k v) (1+ v)) (gv-d40 :inc 41)\" },\n  { id: \"D41\", code: \"(require 'eliscript) (let ((c (state-cell 5))) (cell-update! c #'1+) (cell-value c))\" },\n  { id: \"D42\", code: \"(require 'eliscript) (let ((d (delay (* 6 7)))) (list (realized-p d) (force d) (realized-p d)))\" },\n  { id: \"D43\", code: \"(require 'eliscript) (seq-into (lazy-take 3 (lazy-map (lambda (x) (* x 10)) (lazy-range 1))) 'list)\" },\n  { id: \"D44\", code: \"(require 'eliscript) (seq-transduce (map-transducer #'1+) #'+ 0 '(1 2 3 4))\" },\n  { id: \"D45\", code: \"(require 'eliscript) (seq-into (with-transient (t-vec (persistent-vector)) (conj! t-vec 'a) (conj! t-vec 'b)) 'list)\" },\n  { id: \"D46\", code: \"(require 'eliscript) (defmodule m.d46 (defconst-lexical k 10) (defun-lexical helper (x) (+ x k)) (defun pub-d46 (x) (helper x)) (export-functions pub-d46)) (fset 'helper (lambda (_x) 0)) (import-functions m.d46 :only (pub-d46)) (pub-d46 5)\" },\n  { id: \"D47\", code: \"(require 'eliscript) (defmacro-checked mc-d47 (v) (declare (eliscript :pure t)) (let ((g (macro-gensym \\\"x\\\"))) \\`(let ((,g ,v)) (* ,g 2)))) (mc-d47 21)\" },\n  { id: \"D48\", code: \"(require 'eliscript) (defun c-d48 (x) (declare (eliscript :pure t :portable t :requires ((> x 0)) :ensures ((> result x)))) (+ x 1)) (c-d48 10)\" },\n  { id: \"D49\", code: \"(require 'eliscript) (require 'eliscript-js) (list (if js-false 't 'f) (if js-null 't 'f) (if js-undefined 't 'f) (js-false-p js-false) (js-divide 7 2) (js-length \\\"😀\\\"))\" },\n  { id: \"D50\", code: \"(require 'eliscript) (require 'eliscript-abi) (with-abi-memory (:initial-pages 1) (mem-store-u32 0 12345) (word-add (mem-load-u32 0) 5))\" },\n  { id: \"D51\", code: \"(require 'eliscript) (defun bad-d51 (x) (declare (eliscript :async t)) x)\", expectError: true },\n  { id: \"D52\", code: \"(require 'eliscript) (let-const ((x 1)) (setq x 2))\", expectError: true },\n];\n\ntest(\"T11-01: 52-program Differential Oracle between native Emacs and JS 0.1.0 compiler/runtime\", () => {\n  runIsolatedSync(\"T11-01\", \"T11\", () => {\n    const emacsBin = process.env.EMACS ?? \"emacs\";\n    const elispBatchDriver = `\n      (progn\n        (require 'json)\n        (require 'eliscript-compat)\n        (defun normalize-for-oracle (v)\n          (cond\n            ((null v) nil)\n            ((eq v t) t)\n            ((numberp v) v)\n            ((stringp v) v)\n            ((keywordp v) (symbol-name v))\n            ((symbolp v) (symbol-name v))\n            ((vectorp v) (vconcat (mapcar #'normalize-for-oracle (append v nil))))\n            ((consp v) (vconcat (mapcar #'normalize-for-oracle v)))\n            (t (format \"%s\" v))))\n        (let* ((cases (json-parse-string (getenv \"ELISCRIPT_ORACLE_CASES\") :object-type 'alist :array-type 'list))\n               (results nil))\n          (dolist (c cases)\n            (eliscript-compat-reset-state!)\n            (let ((id (alist-get 'id c))\n                  (code (alist-get 'code c)))\n              (condition-case err\n                  (let ((val (eliscript-compat-eval-string code)))\n                    (push (list (cons 'id id) (cons 'ok t) (cons 'value (normalize-for-oracle val))) results))\n                (error\n                  (push (list (cons 'id id) (cons 'ok :false) (cons 'error (symbol-name (car err)))) results)))))\n          (princ (json-serialize (vconcat (nreverse results)) :null-object nil :false-object :false))))\n    `;\n\n    const child = spawnSync(\n      emacsBin,\n      [\"--batch\", \"-Q\", \"-L\", \"editor\", \"--eval\", elispBatchDriver],\n      {\n        cwd: projectRoot,\n        env: {\n          ...process.env,\n          ELISCRIPT_ORACLE_CASES: JSON.stringify(DIFFERENTIAL_CORPUS),\n        },\n        encoding: \"utf8\",\n      },\n    );\n    if (child.status !== 0) {\n      throw new Error(`Emacs differential oracle failed: ${child.stderr || child.stdout}`);\n    }\n    const emacsResults = JSON.parse(child.stdout.trim());\n    expect(emacsResults.length).toBe(DIFFERENTIAL_CORPUS.length);\n\n    for (let i = 0; i < DIFFERENTIAL_CORPUS.length; i += 1) {\n      const entry = DIFFERENTIAL_CORPUS[i];\n      const emacsOut = emacsResults[i];\n      resetCompatState();\n      if (entry.expectError) {\n        expect(emacsOut.ok).toBe(false);\n        expect(() => evalCompatProgram(entry.code)).toThrow();\n      } else {\n        expect(emacsOut.ok).toBe(true);\n        const jsVal = serializeCompatValue(evalCompatProgram(entry.code));\n        expect(jsVal).toEqual(emacsOut.value);\n      }\n    }\n  });\n});\n\n// ============================================================================\n// T12: Package Surface & Per-Test Timing Telemetry Verification\n// ============================================================================\n\ntest(\"T12-01: package.json exports ./runtime/emacs-compat and per-test timings are recorded\", () => {\n  runIsolatedSync(\"T12-01\", \"T12\", () => {\n    const pkg = JSON.parse(readFileSync(path.join(projectRoot, \"package.json\"), \"utf8\"));\n    expect(pkg.exports[\"./runtime/emacs-compat\"]).toBe(\"./runtime/emacs-compat.mjs\");\n    expect(pkg.exports[\"./runtime/emacs-compat.mjs\"]).toBe(\"./runtime/emacs-compat.mjs\");\n    expect(testTimings.length).toBeGreaterThanOrEqual(18);\n    for (const entry of testTimings) {\n      expect(typeof entry.elapsedMs).toBe(\"number\");\n      expect(entry.elapsedMs).toBeGreaterThanOrEqual(0);\n      expect(entry.status).toBe(\"passed\");\n    }\n    const report = getCompatTimingReport(testTimings);\n    expect(report.totalTests).toBeGreaterThanOrEqual(18);\n  });\n});\n"))
