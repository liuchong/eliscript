(module tests.wasm-memory-static-data-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar snapshot nil)
  (defvar actual-runtime nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-wasm-static-data-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((source (await (readFile (resolve "bootstrap/backends/wasm.eli") "utf8")))
             (helpers
               (js-array
                 "require-memory-data-copy"
                 "require-wasm-expression-node"
                 "copy-wasm-expression-node"
                 "same-wasm-expression-snapshot"
                 "intern-wasm-expression"
                 "copy-wasm-expression"
                 "make-wasm-validation-workspace"
                 "validate-fresh-wasm-expression"
                 "validate-fresh-typed-wasm-program"))
             (helper-source
               (str "(module wasm.snapshot\n(import "
                    (JSON/stringify (get (pathToFileURL (resolve directory "backends/numeric.mjs")) :href))
                    " backend-fail)\n"
                    (js-call (js-call helpers :map (lambda (name) (definition source (str name " ")))) :join "\n")
                    "\n(export copy-wasm-expression make-wasm-validation-workspace validate-fresh-wasm-expression validate-fresh-typed-wasm-program))"))
             (compiled (js-call (get backend :compiler) :compile_string helper-source "wasm-snapshot.eli")))
        (setq snapshot
          (await (funcall dyn-import
                   (str "data:text/javascript;base64,"
                        (js-call (Buffer/from compiled) :toString "base64")))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun make-node (kind value &rest __host_default_arguments_1)
    (let* ((children (aref __host_default_arguments_1 0)) (extra (aref __host_default_arguments_1 1)))
    (let ((ch (if (undefined? children) (js-array) children))
          (ex (if (undefined? extra) (js-object) extra)))
      (Object/assign (js-object :kind kind :type "u32" :value value :children ch) ex))))

  (defun constant (value)
    (make-node "literal" value))

  (defun local (index)
    (make-node "local" index))

  (defun copy-node (text &rest __host_default_arguments_2)
    (let* ((address (aref __host_default_arguments_2 0)))
    (let ((addr (if (undefined? address) (local 0) address)))
      (make-node "memory-data-copy" text (js-array addr)))))

  (defun make-program (entries)
    (js-object
      :abi "memory-u32"
      :filename "static-data.eli"
      :functions
      (js-call entries :map
        (lambda (entry index)
          (js-object
            :name (aref entry 0)
            :index index
            :arity 1
            :locals (js-array (js-object :name "address" :type "u32" :index 0))
            :body (aref entry 1))))
      :exports (js-call entries :map (lambda (entry) (aref entry 0)))))

  (defun emit (input &rest __host_default_arguments_3)
    (let* ((options (aref __host_default_arguments_3 0)))
    (let* ((opts (if (undefined? options) (js-object :initialPages 1 :maximumPages 2) options))
           (bytes (Uint8Array/from (js-call (get backend :wasm) :emit_typed_memory_wasm input opts)))
           (mod (new WebAssembly.Module bytes)))
      (js-call assert :deepEqual (WebAssembly.Module/imports mod) (js-array))
      (js-object :bytes bytes :e (get (new WebAssembly.Instance mod) :exports)))))

  (defun units (e address text)
    (let ((view (new globalThis.DataView (get (get e :memory) :buffer))))
      (Array/from (js-object :length (get text :length))
        (lambda (_unused index)
          (js-call view :getUint16 (+ address (* index 2)) t)))))

  (defun expected (text)
    (Array/from (js-object :length (get text :length))
      (lambda (_unused index)
        (js-call text :charCodeAt index))))

  (defun rejection (error)
    (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
      (= (if diag (get diag :code) undefined) "ELI-B0001")))

  (defun static-source (text &rest __host_default_arguments_4)
    (let* ((destination (aref __host_default_arguments_4 0)))
    (let ((dest (if (undefined? destination) "address" destination)))
      (str "(import \"eliscript:memory32\" copy-static-u16 load-u32 store-u32)\n"
           "(defun run (address) (copy-static-u16 " dest " " (JSON/stringify text) "))\n(export run)"))))

  (defun freeze-tree (value)
    (when (and (not (nullish? value))
               (= (funcall js-typeof value) "object")
               (not (Object/isFrozen value)))
      (js-call (Object/values value) :forEach (lambda (child) (freeze-tree child)))
      (Object/freeze value))
    value)

  (test "Given a memory kernel static literal When lowered from actual source Then it copies exact units with one address evaluation and bounded code"
    (lambda ()
      (let* ((unit (str "table" (String/fromCharCode 0) "😀"
                        (String/fromCharCode 55296) (String/fromCharCode 57343) (String/fromCharCode 65535)))
             (text (js-call unit :repeat 4096))
             (source (static-source text "(progn (store-u32 0 (+ (load-u32 0) 1)) address)"))
             (ir (js-call (get backend :compiler) :compile_ir_string source "static-kernel-source.eli"))
             (saved (JSON/stringify ir))
             (bytes (Uint8Array/from
                      (js-call (get backend :wasm) :emit_memory_wasm ir (js-object :initialPages 4 :maximumPages 4)))))
        (funcall assert (< (get bytes :length) (+ (* (get text :length) 2) 512))
          "the source capability lowers to data, not per-unit stores")
        (js-call assert :equal (JSON/stringify ir) saved)
        (let ((mod (new WebAssembly.Module bytes)))
          (js-call assert :deepEqual (WebAssembly.Module/imports mod) (js-array))
          (let ((e (get (new WebAssembly.Instance mod) :exports)))
            (js-call assert :equal (js-call e :run 16) 0)
            (js-call assert :deepEqual (units e 16 text) (expected text))
            (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getUint32 0 t) 1)
            (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) 16 (* (get text :length) 2)) :fill 151)
            (js-call assert :equal (js-call e :run 16) 0)
            (js-call assert :deepEqual (units e 16 text) (expected text))
            (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getUint32 0 t) 2)
            (let ((end (- (get (get (get e :memory) :buffer) :byteLength) 4)))
              (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) end 4) :fill 145)
              (js-call assert :throws (lambda () (js-call e :run end)) globalThis.WebAssembly.RuntimeError)
              (js-call assert :deepEqual
                (Array/from (new globalThis.Uint8Array (get (get e :memory) :buffer) end 4))
                (js-array 145 145 145 145))
              (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getUint32 0 t) 3)))))))

  (test "Given dynamic or malformed static-copy arguments When lowering Then source diagnostics reject them before execution"
    (lambda ()
      (js-call
        (js-array
          "(copy-static-u16 address address)"
          "(copy-static-u16 address 42)"
          "(copy-static-u16 address)"
          "(copy-static-u16 address \"a\" \"b\")"
          "(let ((copy-static-u16 address)) (copy-static-u16 address \"a\"))")
        :forEach
        (lambda (body)
          (let* ((source (str "(import \"eliscript:memory32\" copy-static-u16)\n(defun run (address) " body ")\n(export run)"))
                 (ir (js-call (get backend :compiler) :compile_ir_string source "bad-static-kernel.eli")))
            (js-call assert :throws
              (lambda () (js-call (get backend :wasm) :emit_memory_wasm ir))
              rejection)
            (js-call (js-array "arm64-macos" "arm64-linux") :forEach
              (lambda (target)
                (js-call assert :throws
                  (lambda () (js-call (get backend :native) :emit_native_memory_library ir target))
                  rejection))))))
      (let ((source "(defun run (address) (copy-static-u16 address \"a\"))\n(export run)"))
        (js-call assert :throws
          (lambda ()
            (js-call (get backend :wasm) :emit_memory_wasm
              (js-call (get backend :compiler) :compile_ir_string source "unimported.eli")))
          rejection))))

  (test "Given exact UTF16 static data When copied repeatedly Then isolated surrogates zero units and immutable source survive ordinary heap mutations"
    (lambda ()
      (let* ((text (str (String/fromCharCode 0) "\"\\" (String/fromCharCode 13) "\n中😀"
                        (String/fromCharCode 55296) "x" (String/fromCharCode 57343)))
             (input (make-program
                      (js-array
                        (js-array "first" (copy-node text))
                        (js-array "second" (copy-node text))
                        (js-array "empty" (copy-node "")))))
             (before (JSON/stringify input))
             (e (get (emit input) :e)))
        (js-call assert :equal (JSON/stringify input) before "passive data allocation must not mutate public typed nodes")
        (js-call (js-array "first" "second") :forEach
          (lambda (name)
            (js-call assert :equal (funcall (get e name) 16) 0)
            (js-call assert :deepEqual (units e 16 text) (expected text))
            (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) 16 (* (get text :length) 2)) :fill 165)))
        (js-call assert :equal (js-call e :first 32) 0)
        (js-call assert :deepEqual (units e 32 text) (expected text))
        (js-call assert :equal (js-call e :empty 65536) 0)
        (js-call assert :throws (lambda () (js-call e :empty 65537)) globalThis.WebAssembly.RuntimeError))))

  (test "Given a destination with effects When copying Then it executes once and out-of-bounds copies leave every byte unchanged"
    (lambda ()
      (let* ((counter
               (make-node "memory-op" "store-u32"
                 (js-array
                   (constant 0)
                   (make-node "word-arithmetic" "+"
                     (js-array
                       (make-node "memory-op" "load-u32" (js-array (constant 0)))
                       (constant 1))))))
             (address (make-node "sequence" nil (js-array counter (local 0))))
             (text "copy😀")
             (e (get (emit (make-program (js-array (js-array "run" (copy-node text address))))) :e)))
        (js-call assert :equal (js-call e :run 16) 0)
        (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getUint32 0 t) 1)
        (let* ((byte-length (* (get text :length) 2))
               (last (- 65536 byte-length)))
          (js-call assert :equal (js-call e :run last) 0)
          (js-call assert :deepEqual (units e last text) (expected text))
          (js-call (new globalThis.Uint8Array (get (get e :memory) :buffer) last byte-length) :fill 145)
          (let ((before (Uint8Array/from (new globalThis.Uint8Array (get (get e :memory) :buffer) last byte-length))))
            (js-call assert :throws (lambda () (js-call e :run (+ last 1))) globalThis.WebAssembly.RuntimeError)
            (js-call assert :deepEqual
              (new globalThis.Uint8Array (get (get e :memory) :buffer) last byte-length)
              before)
            (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getUint32 0 t) 3)
            (js-call assert :throws (lambda () (js-call e :run -1)) globalThis.WebAssembly.RuntimeError))))))

  (test "Given a long ordinary source string When emitted Then code size remains bounded while every UTF16 unit remains exact"
    (lambda ()
      (let* ((unit (str "source😀" (String/fromCharCode 55296) (String/fromCharCode 13) "\n"))
             (text (js-call unit :repeat 1024))
             (emitted (emit (make-program (js-array (js-array "run" (copy-node text))))))
             (bytes (get emitted :bytes))
             (e (get emitted :e)))
        (funcall assert (< (get bytes :length) (+ (* (get text :length) 2) 256))
          "source units belong to static data, not per-unit instructions")
        (js-call assert :equal (js-call e :run 8) 0)
        (js-call assert :deepEqual (units e 8 text) (expected text))
        (js-call assert :equal (js-call e :run 32768) 0)
        (js-call assert :deepEqual (units e 32768 text) (expected text)))))

  (test "Given debug emission When static copying traps Then the original source range and real instruction address remain recorded"
    (lambda ()
      (let* ((span (js-object :filename "静态😀.eli" :start 2 :end 9 :line 1 :column 3 :endLine 1 :endColumn 10))
             (input (make-program (js-array (js-array "run" (Object/assign (js-object) (copy-node "😀") (js-object :span span))))))
             (artifact (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact input (js-object :initialPages 1 :maximumPages 1)))
             (mod (new WebAssembly.Module (Uint8Array/from (get artifact :bytes)))))
        (js-call assert :deepEqual (WebAssembly.Module/imports mod) (js-array))
        (let ((e (get (new WebAssembly.Instance mod) :exports)))
          (js-call assert :throws (lambda () (js-call e :run 65535)) globalThis.WebAssembly.RuntimeError)
          (funcall assert
            (js-call (get (get artifact :debug) :ranges) :some
              (lambda (range)
                (and (= (get range :kind) "memory-data-copy")
                     (let ((rspan (get range :span)))
                       (= (if (nullish? rspan) undefined (get rspan :filename)) (get span :filename)))))))
          (funcall assert
            (js-call (get (get artifact :debug) :trapSites) :some
              (lambda (site) (> (get site :address) 0))))))))

  (test "Given malformed internal data nodes When emitted Then the existing backend refusal precedes module construction"
    (lambda ()
      (js-call
        (js-array
          (copy-node nil)
          (copy-node (js-array 1 2))
          (make-node "memory-data-copy" "x" (js-array))
          (make-node "memory-data-copy" "x" (js-array (constant 0) (constant 1)))
          (make-node "memory-data-copy" "x" (js-array nil))
          (make-node "memory-data-copy" "x" (js-array (Object/assign (js-object) (constant 0) (js-object :type "f64"))))
          (Object/assign (js-object) (copy-node "x") (js-object :type "f64")))
        :forEach
        (lambda (bad)
          (js-call assert :throws
            (lambda () (emit (make-program (js-array (js-array "bad" bad)))))
            rejection)))
      (let ((numeric (make-program (js-array (js-array "bad" (copy-node "x"))))))
        (put numeric :abi "numeric-f64")
        (js-call assert :throws
          (lambda () (js-call (get backend :wasm) :emit_typed_numeric_wasm numeric))
          rejection))))

  (test "Given frozen reusable typed input When ordinary and debug emitters allocate scratch Then later consumers retain the original locals and indirect calls"
    (lambda ()
      (let* ((text (str "source" (String/fromCharCode 0) "😀" (String/fromCharCode 55296)))
             (counter
               (make-node "memory-op" "store-u32"
                 (js-array
                   (constant 0)
                   (make-node "word-arithmetic" "+"
                     (js-array
                       (make-node "memory-op" "load-u32" (js-array (constant 0)))
                       (constant 1))))))
             (input
               (make-program
                 (js-array
                   (js-array "copy" (copy-node text (make-node "sequence" nil (js-array counter (local 0)))))
                   (js-array "indirect" (make-node "call-indirect" 1 (js-array (local 0) (constant 0))))))))
        (put input :table (js-array 0))
        (put input :indirectArities (js-array 1))
        (put input :metadata
          (js-object
            :filename "保留😀.eli"
            :zero -0.0
            :values (js-array globalThis.NaN globalThis.Infinity (- globalThis.Infinity))))
        (let ((before (globalThis.structuredClone input)))
          (freeze-tree input)
          (let ((first (emit input))
                (second (emit input)))
            (js-call assert :deepEqual input before)
            (js-call assert :deepEqual (get first :bytes) (get second :bytes)
              "repeated emission must not accumulate scratch locals or signature metadata")
            (js-call assert :equal (js-call (get first :e) :indirect 32) 0)
            (js-call assert :deepEqual (units (get first :e) 32 text) (expected text))
            (js-call assert :equal
              (js-call (new globalThis.DataView (get (get (get first :e) :memory) :buffer)) :getUint32 0 t)
              1)
            (let* ((options (freeze-tree (js-object :initialPages 1 :maximumPages 2)))
                   (debug (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact input options))
                   (debug-again (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact input options)))
              (js-call assert :deepEqual (get debug :bytes) (get debug-again :bytes))
              (js-call assert :deepEqual input before)
              (js-call assert :deepEqual options (js-object :initialPages 1 :maximumPages 2))
              (let ((e (get (new WebAssembly.Instance (new WebAssembly.Module (Uint8Array/from (get debug :bytes)))) :exports)))
                (js-call assert :equal (js-call e :indirect 64) 0)
                (js-call assert :deepEqual (units e 64 text) (expected text))
                (js-call (get input :functions) :forEach
                  (lambda (fn)
                    (js-call assert :equal (get (get fn :locals) :length) 1)
                    (funcall assert (not (Object/hasOwn (get fn :body) "signatureIndex")))))
                (let ((store (aref (get (aref (get (get (aref (get input :functions) 0) :body) :children) 0) :children) 0)))
                  (funcall assert (not (Object/hasOwn store "addressLocal")))
                  (funcall assert (not (Object/hasOwn store "valueLocal")))))))))))

  (test "Given frozen numeric input When the public typed emitter copies its working tree Then IEEE literals and all original metadata remain exact"
    (lambda ()
      (let* ((values (js-array -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)))
             (input
               (make-program
                 (js-call values :map
                   (lambda (value index)
                     (js-array
                       (str "number" index)
                       (Object/assign (js-object) (constant value) (js-object :type "f64"))))))))
        (put input :abi "numeric-f64")
        (js-call (get input :functions) :forEach
          (lambda (fn) (put (aref (get fn :locals) 0) :type "f64")))
        (put input :metadata
          (js-object
            :source (str (String/fromCharCode 0) "😀" (String/fromCharCode 55296))
            :negativeZero -0.0
            :nonFinite (js-array globalThis.NaN globalThis.Infinity (- globalThis.Infinity))))
        (let ((before (globalThis.structuredClone input)))
          (freeze-tree input)
          (let ((first (Uint8Array/from (js-call (get backend :wasm) :emit_typed_numeric_wasm input)))
                (second (Uint8Array/from (js-call (get backend :wasm) :emit_typed_numeric_wasm input))))
            (js-call assert :deepEqual first second)
            (js-call assert :deepEqual input before)
            (let ((e (get (new WebAssembly.Instance (new WebAssembly.Module first)) :exports))
                  (idx 0))
              (while (< idx (get values :length))
                (funcall assert (Object/is (funcall (get e (str "number" idx)) 0) (aref values idx)))
                (setq idx (+ idx 1)))))))))

  (test "Given malformed static-copy destinations When either public memory emitter refuses Then the original parent span and unchanged input survive the failure"
    (lambda ()
      (let ((span (js-object :filename "坏目标😀.eli" :start 4 :end 12 :line 3 :column 5 :endLine 3 :endColumn 13)))
        (js-call
          (js-array
            (js-array nil)
            (js-array undefined)
            (js-array 3)
            (js-array (js-array))
            (js-array (js-object :type "u32"))
            (js-array (Object/assign (js-object) (constant 0) (js-object :children nil)))
            (js-array (Object/assign (js-object) (constant 0) (js-object :type "f64")))
            (js-array)
            (js-array (constant 0) (constant 1)))
          :forEach
          (lambda (children)
            (let* ((input (make-program
                            (js-array
                              (js-array "bad"
                                (Object/assign (js-object) (make-node "memory-data-copy" "x" children) (js-object :span span))))))
                   (before (globalThis.structuredClone input)))
              (freeze-tree input)
              (js-call (js-array "emit_typed_memory_wasm" "emit_typed_memory_wasm_artifact") :forEach
                (lambda (method)
                  (js-call assert :throws
                    (lambda ()
                      (js-call (get backend :wasm) method input (js-object :initialPages 1 :maximumPages 1)))
                    (lambda (error)
                      (let ((diag (get error :eliscriptDiagnostic)))
                        (js-call assert :equal (if diag (get diag :code) undefined) "ELI-B0001")
                        (js-call assert :equal (get (get diag :location) :file) (get span :filename))
                        (js-call assert :deepEqual
                          (get (get diag :location) :start)
                          (js-object :line (get span :line) :column (get span :column)))
                        t)))
                  (js-call assert :deepEqual input before))))))
        (let ((valid (emit (make-program (js-array (js-array "recovered" (copy-node "恢复😀")))))))
          (js-call assert :equal (js-call (get valid :e) :recovered 16) 0)
          (js-call assert :deepEqual (units (get valid :e) 16 "恢复😀") (expected "恢复😀"))))))

  (test "Given a shared typed DAG When private snapshots complete Then equivalent occurrences share within the function without expanding retained trees"
    (lambda ()
      (let ((root (constant 7))
            (depth 0))
        (while (< depth 12)
          (setq root (make-node "sequence" nil (js-array root root)))
          (setq depth (+ depth 1)))
        (freeze-tree root)
        (let ((output (js-call snapshot :copy_wasm_expression root nil t))
              (seen (new globalThis.Set))
              (pending (js-array)))
          (js-call pending :push output)
          (js-call assert :notEqual output root)
          (js-call assert :notEqual (get output :children) (get root :children))
          (while (> (get pending :length) 0)
            (let ((current (js-call pending :pop)))
              (unless (js-call seen :has current)
                (js-call seen :add current)
                (let ((children (get current :children)))
                  (when (> (get children :length) 0)
                    (js-call assert :equal (aref children 0) (aref children 1))
                    (js-call children :forEach (lambda (c) (js-call pending :push c))))))))
          (js-call assert :equal (get seen :size) 13
            "the private result retains the original DAG size, not one node per traversal path")
          (js-call assert :equal
            (= (aref (get (js-call snapshot :copy_wasm_expression root nil t) :children) 0)
               (aref (get output :children) 0))
            false
            "independent function snapshots never share private scratch-bearing nodes")))))

  (test "Given repeated getter-bearing nodes When each occurrence is snapshotted Then reads IEEE values symbols and thrown identities retain their original order"
    (lambda ()
      (let ((values (js-array -0.0 0 globalThis.NaN globalThis.NaN))
            (reads (js-array))
            (source (js-object :kind "literal" :type "f64")))
        (Object/defineProperty source "value"
          (js-object :enumerable t :configurable t
            :get (lambda ()
                   (let ((index (get reads :length)))
                     (js-call reads :push index)
                     (aref values index)))))
        (put source :children (js-array))
        (let ((output (js-call snapshot :copy_wasm_expression
                        (make-node "sequence" nil (js-array source source source source)) nil false)))
          (js-call assert :deepEqual reads (js-array 0 1 2 3))
          (funcall assert (Object/is (get (aref (get output :children) 0) :value) -0.0))
          (funcall assert (Object/is (get (aref (get output :children) 1) :value) 0))
          (js-call assert :notEqual (aref (get output :children) 0) (aref (get output :children) 1))
          (js-call assert :equal (aref (get output :children) 2) (aref (get output :children) 3)
            "identical private NaN snapshots may share after both getters ran")))

      (let ((symbol (globalThis.Symbol "original metadata"))
            (symbol-values (js-array -0.0 0))
            (symbol-reads 0)
            (symbol-source (constant 1)))
        (Object/defineProperty symbol-source symbol
          (js-object :enumerable t :configurable t
            :get (lambda ()
                   (let ((idx symbol-reads))
                     (setq symbol-reads (+ symbol-reads 1))
                     (aref symbol-values idx)))))
        (let ((symbolic (js-call snapshot :copy_wasm_expression
                          (make-node "sequence" nil (js-array symbol-source symbol-source)) nil t)))
          (js-call assert :equal symbol-reads 2)
          (js-call assert :notEqual (aref (get symbolic :children) 0) (aref (get symbolic :children) 1))
          (funcall assert (Object/is (get (aref (get symbolic :children) 0) symbol) -0.0))
          (funcall assert (Object/is (get (aref (get symbolic :children) 1) symbol) 0))))

      (let ((marker (new globalThis.Error "original second occurrence getter failure"))
            (calls 0)
            (failing (js-object :kind "literal" :type "u32")))
        (Object/defineProperty failing "value"
          (js-object :enumerable t :configurable t
            :get (lambda ()
                   (setq calls (+ calls 1))
                   (when (= calls 2)
                     (throw marker))
                   0)))
        (put failing :children (js-array))
        (let ((invalid (make-program (js-array (js-array "run" (make-node "sequence" nil (js-array failing failing)))))))
          (js-call assert :throws
            (lambda () (js-call (get backend :wasm) :emit_typed_memory_wasm invalid (js-object :initialPages 0)))
            (lambda (error) (= error marker)))
          (js-call assert :equal calls 2 "upfront snapshot failure still precedes later memory option validation")
          (js-call assert :equal
            (js-call (get (emit (make-program (js-array (js-array "recovered" (constant 17))))) :e) :recovered 0)
            17)))))

  (test "Given shared nodes across functions with distinct locals When memory and indirect scratch is prepared Then exact bytes debug and frozen inputs match expanded input"
    (lambda ()
      (let* ((span (js-object :filename "共享😀.eli" :start 0 :end 1 :line 1 :column 1 :endLine 1 :endColumn 2))
             (shared-load (make-node "memory-op" "load-u32" (js-array (local 0)) (js-object :span span)))
             (shared-indirect (make-node "call-indirect" 1 (js-array (local 0) (constant 0)) (js-object :span span)))
             (text (str "原" (String/fromCharCode 0) "😀"))
             (input
               (make-program
                 (js-array
                   (js-array "load" (make-node "sequence" nil (js-array shared-load shared-load)))
                   (js-array "other" (make-node "sequence" nil (js-array (copy-node text (constant 128)) shared-load)))
                   (js-array "indirect" shared-indirect)
                   (js-array "otherIndirect" shared-indirect)))))
        (js-call (get (aref (get input :functions) 1) :locals) :push
          (js-object :name "existing-word" :index 1 :type "u32")
          (js-object :name "existing-float" :index 2 :type "f64"))
        (js-call (get (aref (get input :functions) 3) :locals) :push
          (js-object :name "existing-word" :index 1 :type "u32"))
        (put input :table (js-array 0))
        (put input :indirectArities (js-array 1))
        (let ((expand nil))
          (setq expand
            (lambda (value)
              (cond
                ((Array/isArray value) (js-call value :map expand))
                ((and (not (nullish? value)) (= (funcall js-typeof value) "object"))
                 (Object/fromEntries
                   (js-call (Reflect/ownKeys value) :map
                     (lambda (key) (js-array key (funcall expand (get value key)))))))
                (t value))))
          (let ((expanded (funcall expand input))
                (before (globalThis.structuredClone input)))
            (freeze-tree input)
            (let ((actual (emit input))
                  (reference (emit expanded)))
              (js-call assert :deepEqual (get actual :bytes) (get reference :bytes))
              (let ((left (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact input (js-object :initialPages 1 :maximumPages 2)))
                    (right (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact expanded (js-object :initialPages 1 :maximumPages 2))))
                (js-call assert :deepEqual (get left :bytes) (get right :bytes))
                (js-call assert :deepEqual (get left :debug) (get right :debug))
                (js-call (new globalThis.DataView (get (get (get actual :e) :memory) :buffer)) :setUint32 16 305419896 t)
                (js-call (js-array "load" "other" "indirect" "otherIndirect") :forEach
                  (lambda (name)
                    (js-call assert :equal (funcall (get (get actual :e) name) 16) 305419896)))
                (js-call assert :deepEqual (units (get actual :e) 128 text) (expected text))
                (js-call assert :deepEqual input before)
                (js-call assert :deepEqual (get (emit input) :bytes) (get actual :bytes)))))))))

  (test "Given later malformed typed input When upfront snapshotting fails Then the exact later source error precedes earlier body and memory option failures"
    (lambda ()
      (let* ((span (js-object :filename "后续😀.eli" :start 2 :end 3 :line 4 :column 3 :endLine 4 :endColumn 4))
             (input (make-program
                      (js-array
                        (js-array "first" (make-node "unknown-kind" nil))
                        (js-array "later" (copy-node "bad" nil))))))
        (put (get (aref (get input :functions) 1) :body) :span span)
        (freeze-tree input)
        (js-call (js-array "emit_typed_memory_wasm" "emit_typed_memory_wasm_artifact") :forEach
          (lambda (method)
            (js-call assert :throws
              (lambda () (js-call (get backend :wasm) method input (js-object :initialPages 0)))
              (lambda (error)
                (let ((diag (get error :eliscriptDiagnostic)))
                  (js-call assert :equal (if diag (get diag :code) undefined) "ELI-B0001")
                  (js-call assert :equal (get (get diag :location) :file) (get span :filename))
                  (js-call assert :match (get error :message) (new globalThis.RegExp "static UTF16 copy"))
                  t))))))))

  (defun make-tracked-set ()
    (let* ((s (new globalThis.Set))
           (proto (get globalThis.Set :prototype))
           (set-add (get proto :add))
           (set-delete (get proto :delete))
           (set-clear (get proto :clear)))
      (put s :peak 0)
      (put s :clears 0)
      (put s :deleted 0)
      (put s :peakDeleted 0)
      (put s :add
        (lambda (value)
          (js-call set-add :call s value)
          (put s :peak (Math/max (get s :peak) (get s :size)))
          s))
      (put s :delete
        (lambda (value)
          (let ((removed (js-call set-delete :call s value)))
            (when removed
              (put s :deleted (+ (get s :deleted) 1))
              (put s :peakDeleted (Math/max (get s :peakDeleted) (get s :deleted))))
            removed)))
      (put s :clear
        (lambda ()
          (js-call set-clear :call s)
          (put s :clears (+ (get s :clears) 1))
          (put s :deleted 0)))
      s))

  (defun tracked-validation-workspace ()
    (let ((work (js-call snapshot :make_wasm_validation_workspace)))
      (put work :seen (make-tracked-set))
      (put work :active (make-tracked-set))
      work))

  (test "Given a wide shared fresh graph When the validation memo fills Then every edge remains checked and forgotten subtrees are revisited within bounded caches"
    (lambda ()
      (let* ((work (tracked-validation-workspace))
             (empty (Object/freeze (js-array)))
             (kinds 0)
             (child-reads 0)
             (shared (js-object)))
        (Object/defineProperty shared "kind"
          (js-object :enumerable t :configurable t
            :get (lambda () (setq kinds (+ kinds 1)) "literal")))
        (put shared :type "u32")
        (put shared :value 7)
        (Object/defineProperty shared "children"
          (js-object :enumerable t :configurable t
            :get (lambda () (setq child-reads (+ child-reads 1)) empty)))
        (Object/freeze shared)
        (let* ((unique (Array/from (js-object :length 65543)
                         (lambda (_u index)
                           (Object/freeze (Object/assign (js-object) (constant index) (js-object :children empty))))))
               (children (Object/freeze (js-call (js-array shared shared) :concat unique (js-array shared))))
               (root (Object/freeze (make-node "sequence" nil children))))
          (js-call assert :equal (js-call snapshot :validate_fresh_wasm_expression root nil t work) root)
          (js-call assert :equal kinds 3 "each repeated incoming edge retains its node contract check")
          (js-call assert :equal child-reads 5 "the late shared leaf is fully revisited after the finite memo forgets it")
          (funcall assert (<= (get (get work :seen) :peak) 65536))
          (funcall assert (>= (get (get work :seen) :clears) 2))
          (funcall assert (<= (get (get work :active) :peak) 2))
          (funcall assert (> (get (get work :active) :clears) 10))
          (funcall assert (<= (get (get work :active) :peakDeleted) 4096)
            "wide traversal cannot retain unbounded active-set tombstones")
          (js-call assert :equal (get (get work :active) :size) 0)
          (js-call assert :equal (get (get work :nodes) :length) 2)
          (js-call assert :equal (get (get work :positions) :length) 2)
          (funcall assert (js-call (get work :nodes) :every (lambda (value) (= value nil)))
            "the reusable depth storage releases completed source nodes")
          (js-call assert :equal (get root :children) children)
          (js-call assert :equal (js-call (get root :children) :at -1) shared)))))

  (test "Given deep fresh graphs When active membership is rebuilt Then all current ancestors remain protected and the same workspace recovers from a cycle"
    (lambda ()
      (let ((work (tracked-validation-workspace))
            (deep (Object/freeze (Object/assign (js-object) (constant 9) (js-object :children (Object/freeze (js-array))))))
            (depth 0))
        (while (< depth 12000)
          (setq deep (Object/freeze (make-node "sequence" nil (Object/freeze (js-array deep)))))
          (setq depth (+ depth 1)))
        (js-call assert :equal (js-call snapshot :validate_fresh_wasm_expression deep nil t work) deep)
        (js-call assert :equal (get (get work :nodes) :length) 12001)
        (js-call assert :equal (get (get work :positions) :length) 12001)
        (js-call assert :equal (get (get work :active) :peak) 12001)
        (funcall assert (> (get (get work :active) :clears) 2))
        (js-call assert :equal (get (get work :active) :size) 0)
        (funcall assert (js-call (get work :nodes) :every (lambda (value) (= value nil))))
        (let ((path (Array/from (js-object :length 6500) (lambda () (make-node "sequence" nil))))
              (idx 0))
          (while (< idx (- (get path :length) 1))
            (put (aref path idx) :children (js-array (aref path (+ idx 1))))
            (setq idx (+ idx 1)))
          (put (js-call path :at -1) :children (js-array (aref path 2500)))
          (put (aref path 2500) :span
            (js-object :filename "cycle-after-rebuild.eli" :start 1 :end 2 :line 3 :column 2 :endLine 3 :endColumn 3))
          (js-call path :forEach
            (lambda (current)
              (Object/freeze (get current :children))
              (Object/freeze current)))
          (js-call assert :throws
            (lambda () (js-call snapshot :validate_fresh_wasm_expression (aref path 0) nil t work))
            (lambda (error)
              (let ((diag (get error :eliscriptDiagnostic)))
                (js-call assert :equal (if diag (get diag :code) undefined) "ELI-B0001")
                (js-call assert :equal (get (get diag :location) :file) "cycle-after-rebuild.eli")
                (js-call assert :match (get error :message) (new globalThis.RegExp "cyclic child graph"))
                t)))
          (let ((valid (constant 11)))
            (js-call assert :equal (js-call snapshot :validate_fresh_wasm_expression valid nil t work) valid)
            (js-call assert :equal (get (get work :active) :size) 0)
            (funcall assert (js-call (get work :nodes) :every (lambda (value) (= value nil)))))))))

  (test "Given malformed fresh input after a full memo When DFS reaches its original first edge Then exact source ownership and later-function refusal remain unchanged"
    (lambda ()
      (let* ((work (tracked-validation-workspace))
             (first (copy-node "bad" nil))
             (second
               (Object/assign (js-object) (constant 1)
                 (js-object
                   :children nil
                   :span (js-object :filename "later.eli" :start 0 :end 1 :line 1 :column 1 :endLine 1 :endColumn 2)))))
        (put first :span
          (js-object :filename "first-after-flush.eli" :start 1 :end 2 :line 4 :column 2 :endLine 4 :endColumn 3))
        (let* ((prefix (Array/from (js-object :length 65540) (lambda (_u index) (constant index))))
               (root (make-node "sequence" nil (js-call prefix :concat (js-array first second))))
               (refuse
                 (lambda (error)
                   (let ((diag (get error :eliscriptDiagnostic)))
                     (js-call assert :equal (if diag (get diag :code) undefined) "ELI-B0001")
                     (js-call assert :equal (get (get diag :location) :file) "first-after-flush.eli")
                     (js-call assert :match (get error :message) (new globalThis.RegExp "static UTF16 copy"))
                     t))))
          (js-call assert :throws
            (lambda () (js-call snapshot :validate_fresh_wasm_expression root nil t work))
            refuse)
          (funcall assert (<= (get (get work :seen) :peak) 65536))
          (funcall assert (>= (get (get work :seen) :clears) 2))
          (let ((input (make-program (js-array (js-array "earlier" (constant 1)) (js-array "later" root)))))
            (js-call assert :throws
              (lambda () (js-call snapshot :validate_fresh_typed_wasm_program input))
              refuse))
          (let ((recovered (make-program (js-array (js-array "one" (constant 1)) (js-array "two" (constant 2))))))
            (js-call assert :equal (js-call snapshot :validate_fresh_typed_wasm_program recovered) recovered))))))

  (defasync complete-runtime ()
    (when (nullish? actual-runtime)
      (setq actual-runtime
        (js-call (get backend :compiler) :compile_ir_string
          (await (readFile (resolve "bootstrap/runtime/memory.eli") "utf8"))
          "bootstrap/runtime/memory.eli"))
      (freeze-tree actual-runtime))
    actual-runtime)

  (defun canonical-hash (input)
    (js-call
      (js-call (createHash "sha256") :update
        (js-call (get backend :compiler) :serialize_ir_program input))
      :digest "hex"))

  (defconst product-memory (js-object :initialPages 64 :maximumPages 256))

  (defun original-managed-product (input runtime project debug)
    (let* ((lowered
             (if project
                 (js-call (get backend :managed) :lower_managed_project input "first.mjs" runtime (js-object))
                 (js-call (get backend :managed) :lower_managed_program input runtime)))
           (artifact
             (if debug
                 (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact (get lowered :typed) product-memory)
                 nil))
           (raw-bytes
             (if artifact
                 (get artifact :bytes)
                 (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) product-memory)))
           (bytes
             (js-call (get backend :wasm) :append_metadata_section
               raw-bytes
               "eliscript-managed-control"
               (JSON/stringify (get lowered :descriptor)))))
      (when artifact
        (put (get artifact :debug) :moduleByteLength (get bytes :length)))
      (Object/assign
        (js-object :bytes (Uint8Array/from bytes) :descriptor (get lowered :descriptor))
        (if artifact (js-object :debug (get artifact :debug)) (js-object)))))

  (test "Given complete original runtime IR When source IR and cyclic projects emit owned WASM products Then exact ground bytes debug and immutable sources survive"
    (async ()
      (let* ((runtime (await (complete-runtime)))
             (runtime-before (canonical-hash runtime))
             (single (js-call (get backend :compiler) :compile_ir_string "(defun work (x) (+ x 2)) (export work)" "first.eli"))
             (modules
               (js-array
                 (js-object
                   :id "first.mjs"
                   :program (js-call (get backend :compiler) :compile_ir_string
                              "(import \"./second.mjs\" offset) (defun work (x) (+ x (offset))) (export work)"
                              "first.eli"))
                 (js-object
                   :id "second.mjs"
                   :program (js-call (get backend :compiler) :compile_ir_string
                              "(import \"./first.mjs\" work) (defun offset () 2) (defun relay (x) (work x)) (export offset relay)"
                              "second.eli")))))
        (freeze-tree single)
        (freeze-tree modules)
        (let ((single-before (canonical-hash single))
              (modules-before (js-call modules :map (lambda (record) (canonical-hash (get record :program))))))
          (js-call (js-array false t) :forEach
            (lambda (project)
              (js-call (js-array false t) :forEach
                (lambda (debug)
                  (let* ((input (if project modules single))
                         (expected (original-managed-product input runtime project debug))
                         (calls 0)
                         (configure
                           (lambda (&rest args)
                             (setq calls (+ calls 1))
                             (js-call assert :equal (get args :length) 0 "configuration cannot observe or replace private typed IR")
                             (js-object :memory product-memory :debug debug)))
                         (actual
                           (if project
                               (js-call (get backend :wasm) :emit_managed_project_wasm_product
                                 input "first.mjs" runtime (js-object) configure)
                               (js-call (get backend :wasm) :emit_managed_ir_wasm_product
                                 input runtime (js-object) configure))))
                    (js-call assert :equal calls 1)
                    (js-call assert :equal (Object/hasOwn actual "typed") false)
                    (js-call assert :deepEqual
                      (js-call (Object/keys actual) :sort)
                      (if debug (js-array "bytes" "debug" "descriptor") (js-array "bytes" "descriptor")))
                    (js-call assert :deepEqual (Uint8Array/from (get actual :bytes)) (get expected :bytes))
                    (js-call assert :deepEqual (get actual :descriptor) (get expected :descriptor))
                    (when debug
                      (js-call assert :deepEqual (get actual :debug) (get expected :debug)))
                    (let ((inst (instantiateManagedRuntime (Uint8Array/from (get actual :bytes)))))
                      (try
                        (let ((argument (js-call inst :number 40))
                              (result undefined))
                          (try
                            (setq result (js-call inst :invoke "work" (js-array argument)))
                            (js-call assert :equal (js-call inst :readNumber result) 42)
                            (finally
                              (unless (undefined? result)
                                (js-call inst :release result))
                              (js-call inst :release argument))))
                        (finally
                          (js-call inst :closeModule)
                          (js-call inst :collect)
                          (js-call assert :equal (js-call inst :live) 0)
                          (js-call assert :equal (get (js-call inst :stats) :frameDepth) 0)))))))))
          (js-call assert :equal (canonical-hash single) single-before)
          (js-call assert :deepEqual
            (js-call modules :map (lambda (record) (canonical-hash (get record :program))))
            modules-before)
          (js-call assert :equal (canonical-hash runtime) runtime-before))))
    120000)

  (test "Given owned managed products When lowering or output configuration throws Then original phase order primitive identity and recovery remain intact"
    (async ()
      (let* ((runtime (await (complete-runtime)))
             (source (js-call (get backend :compiler) :compile_ir_string "(defun work (x) (+ x 2)) (export work)" "first.eli")))
        (js-call (js-array (js-array false undefined) (js-array t false)) :forEach
          (lambda (pair)
            (let* ((project (aref pair 0))
                   (marker (aref pair 1))
                   (calls 0)
                   (caught false)
                   (configure
                     (lambda (&rest args)
                       (setq calls (+ calls 1))
                       (js-call assert :equal (get args :length) 0)
                       (throw marker))))
              (try
                (if project
                    (js-call (get backend :wasm) :emit_managed_project_wasm_product
                      (js-array (js-object :id "first.mjs" :program source)) "first.mjs" runtime (js-object) configure)
                    (js-call (get backend :wasm) :emit_managed_ir_wasm_product
                      source runtime (js-object) configure))
                (catch error
                  (setq caught t)
                  (js-call assert :equal error marker)))
              (js-call assert :equal caught t)
              (js-call assert :equal calls 1)
              (let ((invalid (globalThis.structuredClone source))
                    (expected undefined))
                (put (aref (get invalid :body) 0) :kind "unknown-source-IR")
                (try
                  (if project
                      (js-call (get backend :managed) :lower_managed_project
                        (js-array (js-object :id "first.mjs" :program invalid)) "first.mjs" runtime (js-object))
                      (js-call (get backend :managed) :lower_managed_program invalid runtime))
                  (catch error
                    (setq expected error)))
                (funcall assert (funcall js-instanceof expected globalThis.Error))
                (setq calls 0)
                (let ((forbidden
                        (lambda ()
                          (setq calls (+ calls 1))
                          (throw (new globalThis.Error "configuration cannot precede lowering")))))
                  (js-call assert :throws
                    (lambda ()
                      (if project
                          (js-call (get backend :wasm) :emit_managed_project_wasm_product
                            (js-array (js-object :id "first.mjs" :program invalid))
                            "first.mjs" runtime (js-object :abi "unknown") forbidden)
                          (js-call (get backend :wasm) :emit_managed_ir_wasm_product
                            invalid runtime (js-object :abi "unknown") forbidden)))
                    (lambda (error)
                      (js-call assert :equal (get error :message) (get expected :message))
                      (js-call assert :deepEqual (get error :eliscriptDiagnostic) (get expected :eliscriptDiagnostic))
                      t))
                  (js-call assert :equal calls 0))))))
        (let ((with-binding
                (js-call (get backend :compiler) :compile_ir_string
                  "(defconst increment 2) (defun work (x) (+ x increment)) (export work)"
                  "first.eli")))
          (js-call
            (js-array
              (js-array false source "unknown")
              (js-array false with-binding "managed-control-v1")
              (js-array t source "managed-control-v1"))
            :forEach
            (lambda (triple)
              (let ((project (aref triple 0))
                    (program (aref triple 1))
                    (abi (aref triple 2))
                    (expected undefined)
                    (calls 0))
                (try
                  (if project
                      (js-call (get backend :managed) :emit_managed_project_wasm
                        (js-array (js-object :id "first.mjs" :program program)) "first.mjs" runtime (js-object :abi abi))
                      (js-call (get backend :managed) :emit_managed_wasm
                        program runtime (js-object :abi abi)))
                  (catch error
                    (setq expected error)))
                (js-call assert :equal (Object/getPrototypeOf expected) (get globalThis.Object :prototype))
                (js-call assert :equal (funcall js-typeof (get expected :message)) "string")
                (let ((diag (get expected :eliscriptDiagnostic)))
                  (js-call assert :equal (if diag (get diag :code) undefined) "ELI-B0001")
                  (js-call assert :equal (get diag :phase) (if project "managed-link" "managed-backend")))
                (let ((configure
                        (lambda ()
                          (setq calls (+ calls 1))
                          (js-object :memory product-memory :debug false))))
                  (js-call assert :throws
                    (lambda ()
                      (if project
                          (js-call (get backend :wasm) :emit_managed_project_wasm_product
                            (js-array (js-object :id "first.mjs" :program program)) "first.mjs" runtime (js-object :abi abi) configure)
                          (js-call (get backend :wasm) :emit_managed_ir_wasm_product
                            program runtime (js-object :abi abi) configure)))
                    (lambda (error)
                      (js-call assert :equal (Object/getPrototypeOf error) (Object/getPrototypeOf expected))
                      (js-call assert :equal (get error :message) (get expected :message))
                      (js-call assert :deepEqual (get error :eliscriptDiagnostic) (get expected :eliscriptDiagnostic))
                      t))
                  (js-call assert :equal calls 0
                    "ground ABI refusal remains after lowering and before output configuration")))))
          (let ((recovered
                  (js-call (get backend :wasm) :emit_managed_ir_wasm_product
                    source runtime (js-object) (lambda () (js-object :memory product-memory :debug false)))))
            (funcall assert (WebAssembly/validate (Uint8Array/from (get recovered :bytes))))))))
    120000))
