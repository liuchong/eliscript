(module tests.stdlib-string-regex
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp rm symlink)
  (import "node:path" resolve)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "../runtime/core/collection.mjs" count)
  (import "../runtime/core/map.mjs" persistentHashMap)

  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst EMACS (let ((v (get (get process :env) :EMACS))) (if (nullish? v) "emacs" v)))
  (defconst dynamic-import (js* "(url) => import(url)"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))

  (defasync compile-stdlib (modules)
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-s3-string-regex-"))))
           (out-root (resolve directory "stdlib")))
      (try
        (await (symlink (resolve ROOT "runtime") (resolve directory "runtime") "dir"))
        (let* ((cmd (js-call (js-array (resolve ROOT "bin/eliscript-build") "--json" "--root" (resolve ROOT "stdlib") "--out-dir" out-root "--no-cache")
                      :concat (js-call modules :map (lambda (m) (resolve ROOT (str "stdlib/" m ".eli"))))))
               (child (Bun/spawn cmd (js-object :cwd ROOT :env (Object/assign (js-object) (get process :env) (js-object :EMACS EMACS)) :stdout "pipe" :stderr "pipe")))
               (res (await (Promise/all (js-array (get child :exited)
                                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                                  (js-call (new globalThis.Response (get child :stderr)) :text))))))
          (unless (= (aref res 0) 0)
            (throw (new globalThis.Error (str "build failed: " (aref res 2) "\n" (aref res 1))))))
        (let ((loaded (js-object))
              (idx 0))
          (while (< idx (js-length modules))
            (let* ((m (aref modules idx))
                   (ns (await (funcall dynamic-import (get (pathToFileURL (resolve out-root (str m ".mjs"))) :href)))))
              (put loaded m ns))
            (setq idx (1+ idx)))
          (js-object :directory directory :mods loaded))
        (catch err
          (await (rm directory (js-object :recursive t :force t)))
          (throw err)))))

  (test "stdlib/string covers casing, trimming, indexing, splitting, escape, and replacement"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "string" "regex"))))
             (directory (get built :directory))
             (mods (get built :mods))
             (STR (get mods :string))
             (RE (get mods :regex)))
        (try
          ;; Casing & trimming & reverse
          (be (js-call STR :upper_case "hello") "HELLO")
          (be (js-call STR :lower_case "HeLLo") "hello")
          (be (js-call STR :capitalize "eLiScRiPt") "Eliscript")
          (be (js-call STR :capitalize "") "")
          (be (js-call STR :triml " \t\nabc ") "abc ")
          (be (js-call STR :trimr " abc \n\t") " abc")
          (be (js-call STR :trim_newline "abc\r\n\n\r") "abc")
          (be (js-call STR :trim_newline "abc") "abc")
          (be (js-call STR :reverse "abc😀") "😀cba")

          ;; Substring search & predicates
          (be (js-call STR :includes_QMARK_ "eliscript" "script") t)
          (be (js-call STR :includes_QMARK_ "eliscript" "xyz") false)
          (be (js-call STR :index_of "ababa" "ba") 1)
          (be (js-call STR :index_of "ababa" "ba" 2) 3)
          (be (js-call STR :index_of "ababa" "zz") nil)
          (be (js-call STR :last_index_of "ababa" "ba") 3)
          (be (js-call STR :last_index_of "ababa" "ba" 2) 1)
          (be (js-call STR :last_index_of "ababa" "zz") nil)

          ;; split & split-lines
          (same (Array/from (js-call STR :split "a,b,,c,," ",")) (js-array "a" "b" "" "c"))
          (same (Array/from (js-call STR :split "a,b,c,d" "," 2)) (js-array "a" "b,c,d"))
          (same (Array/from (js-call STR :split "a:b::" (js-call RE :regex ":") -1)) (js-array "a" "b" "" ""))
          (same (Array/from (js-call STR :split "a1b22c" (js-call RE :regex "\\d+"))) (js-array "a" "b" "c"))
          (same (Array/from (js-call STR :split_lines "one\ntwo\r\nthree\n\n")) (js-array "one" "two" "three"))
          (same (Array/from (js-call STR :split_lines "")) (js-array ""))

          ;; replace & replace-first (literal strings AND regex backrefs/quotes + callbacks)
          (be (js-call STR :replace "a.b.c" "." "-") "a-b-c")
          (be (js-call STR :replace_first "a.b.c" "." "-") "a-b.c")
          (let ((re-pair (js-call RE :regex "([a-z]+)=(\\d+)")))
            (be (js-call STR :replace "x=1 y=2" re-pair "$2:$1($$&=$&)") "1:x($&=x=1) 2:y($&=y=2)")
            (be (js-call STR :replace "x=1" re-pair (js-call STR :re_quote_replacement "$100")) "$100")
            (be (js-call STR :replace_first "x=1 y=2" re-pair "[$1]->$2") "[x]->1 y=2")
            (be (js-call STR :replace "x=1 y=2" re-pair (lambda (m _i _s) (str (aref (Array/from m) 1) ":" (* (funcall globalThis/Number (aref (Array/from m) 2)) 2))))
              "x:2 y:4"))

          ;; escape with persistent map and plain object
          (let ((cmap (persistentHashMap (js-array "<" "&lt;") (js-array ">" "&gt;") (js-array "&" "&amp;"))))
            (be (js-call STR :escape "<a&b>" cmap) "&lt;a&amp;b&gt;")
            (be (js-call STR :escape "hi!" (js-object "!" "?")) "hi?"))

          ;; regex additions
          (let ((pat (js-call RE :regex "a.b" "i")))
            (be (js-call RE :re_pattern_QMARK_ pat) t)
            (be (js-call RE :re_pattern_QMARK_ "a.b") false)
            (let ((quoted (js-call RE :re_quote "a+b*(c)?[0]$")))
              (be (js-call RE :re_matches (js-call RE :regex quoted) "a+b*(c)?[0]$") "a+b*(c)?[0]$"))
            (be (js-call RE :re_quote_replacement "$1\\a") "$$1\\a")
            (let ((parts (js-call RE :re_split (js-call RE :regex "[,;\\s]+") "a, b; c")))
              (be (count parts) 3)
              (same (Array/from parts) (js-array "a" "b" "c"))))

          ;; Edge cases & error validation
          (same (Array/from (js-call STR :split "" ",")) (js-array ""))
          (same (Array/from (js-call STR :split "a,b,c" "," 1)) (js-array "a,b,c"))
          (same (Array/from (js-call STR :split "abc" "" 2)) (js-array "a" "bc"))
          (be (js-call STR :replace "hello" "zzz" "x") "hello")
          (be (js-call STR :replace_first "hello" (js-call RE :regex "zzz") "x") "hello")
          (be (js-call STR :replace "x=1" (js-call RE :regex "x=(\\d+)") "$9") "$9")
          (same (Array/from (js-call RE :re_split (js-call RE :regex ",") "a,b,c" 1)) (js-array "a,b,c"))
          (js-call (expect (lambda () (js-call STR :upper_case 123))) :toThrow "string/upper-case text must be a string")
          (js-call (expect (lambda () (js-call RE :re_split "not-re" "a,b"))) :toThrow "re-split requires a regex pattern")
          (finally
            (await (rm directory (js-object :recursive t :force t)))))))
    60000)
)
