(module tests.wasm-managed-wire.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp mkdir rm writeFile symlink)
  (import "node:http" createServer)
  (import "node:child_process" spawn)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntimeWithHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../platform/http.mjs" :as http-platform)
  (import "./helpers/wasm-managed-wire-oracle.mjs" roundtrips parse-cases original-error-codes cases httpContracts)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst root (resolve (get (js* "import.meta") :dir) ".."))
  (defconst options (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
  (defconst memory (js-object :initialPages 4 :maximumPages 1024))
  (defconst entry "tests/fixtures/wasm-managed-wire.mjs")
  (defconst sources
    (js-array
      (js-array "stdlib/mdp.eli" "stdlib/mdp.eli")
      (js-array "stdlib/mds.eli" "stdlib/mds.eli")
      (js-array "stdlib/gepo.eli" "stdlib/gepo.eli")
      (js-array "tests/fixtures/wire.mjs" "tests/fixtures/wire.eli")
      (js-array entry "tests/fixtures/wasm-managed-wire.eli")))
  (defconst native-target
    (if (= (get globalThis.process :arch) "arm64")
      (cond
        ((= (get globalThis.process :platform) "darwin") "arm64-macos")
        ((= (get globalThis.process :platform) "linux") "arm64-linux")
        (t nil))
      nil))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar lowered undefined)
  (defvar bytes undefined)
  (defvar native-path undefined)
  (defvar reference-path undefined)
  (defvar expected undefined)
  (defvar runtime-ir undefined)
  (defvar literal-modules undefined)
  (defvar original-modules undefined)

  (defasync run-cmd (command)
    (let* ((child (spawn (aref command 0) (js-call command :slice 1)
                    (js-object :cwd root :env (get globalThis.process :env)
                               :stdio (js-array "ignore" "pipe" "pipe"))))
           (stdout "")
           (stderr ""))
      (js-call (get child :stdout) :setEncoding "utf8")
      (js-call (get child :stderr) :setEncoding "utf8")
      (js-call (get child :stdout) :on "data" (lambda (chunk) (setq stdout (str stdout chunk))))
      (js-call (get child :stderr) :on "data" (lambda (chunk) (setq stderr (str stderr chunk))))
      (await (new globalThis.Promise
               (lambda (resolve-promise reject-promise)
                 (let ((timer (globalThis.setTimeout
                                (lambda ()
                                  (js-call child :kill "SIGKILL")
                                  (funcall reject-promise
                                    (new globalThis.Error (str "wire reference subprocess timeout: " (aref command 0) "\n" stderr))))
                                30000)))
                   (js-call child :once "error"
                     (lambda (error)
                       (globalThis.clearTimeout timer)
                       (funcall reject-promise error)))
                   (js-call child :once "close"
                     (lambda (code signal)
                       (globalThis.clearTimeout timer)
                       (if (/= code 0)
                         (funcall reject-promise
                           (new globalThis.Error (str "wire reference failed " code "/" signal "\n" stderr "\n" stdout)))
                         (funcall resolve-promise (js-call stdout :trim)))))))))))

  (defconst host-commands
    (let ((node-bin (get (get globalThis.process :env) :NODE)))
      (js-array
        (js-array (if (nullish? node-bin) "node" node-bin)
                  "--experimental-loader"
                  (resolve root "tests/fixtures/compiled-eli-node-loader.mjs"))
        (js-array (get globalThis.process :execPath)
                  "--preload"
                  (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs")))))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-wire-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime-ir (js-call (get backend :compiler) :compile_ir_string
                         (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8"))
                         "runtime.eli"))
      (let ((loaded (await (js-call backend :loadLiteralModules))))
        (setq literal-modules (get loaded :literalModules)))
      (let ((modules (js-array))
            (src-idx 0))
        (while (< src-idx (js-length sources))
          (let* ((pair (aref sources src-idx))
                 (id (aref pair 0))
                 (filename (aref pair 1))
                 (src-text (await (readFile (resolve root filename) "utf8"))))
            (js-call modules :push
              (js-object :id id :program (js-call (get backend :compiler) :compile_ir_string src-text filename))))
          (setq src-idx (1+ src-idx)))
        (let ((original-ir (JSON/stringify modules))
              (library-ir (JSON/stringify literal-modules)))
          (setq original-modules modules)
          (setq lowered (js-call (get backend :managed) :lower_managed_project
                          modules entry runtime-ir
                          (Object/assign (js-object) memory (js-object :literalModules literal-modules))))
          (setq bytes (globalThis.Uint8Array.from
                        (js-call (get backend :wasm) :append_metadata_section
                          (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
                          "eliscript-managed-control"
                          (JSON/stringify (get lowered :descriptor)))))
          (js-call assert :equal (JSON/stringify modules) original-ir)
          (js-call assert :equal (JSON/stringify literal-modules) library-ir)
          (js-call (js-array "runtime/wire/markdown.mjs" "runtime/wire/schema.mjs" "runtime/wire/http-rpc.mjs") :forEach
            (lambda (id)
              (funcall assert
                (js-call (get lowered :privateModules) :some (lambda (path) (js-call path :endsWith (str "/" id))))
                (str id " must execute its actual pure module"))))
          (funcall assert
            (js-call (get (get lowered :descriptor) :hostModules) :some
              (lambda (item) (= (get item :specifier) "eliscript/platform/http.mjs"))))
          (let ((actual-imports (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))))
            (js-call assert :deepEqual
              (js-call actual-imports :map (lambda (item) (js-array (get item :module) (get item :name) (get item :kind))))
              (js-call (get (get lowered :descriptor) :hostCapabilities) :map
                (lambda (item) (js-array (get item :module) (get item :name) "function"))))
            (js-call actual-imports :forEach
              (lambda (item) (js-call assert :equal (get item :module) "eliscript.host"))))
          (when native-target
            (setq native-path (resolve directory (if (= native-target "arm64-linux") "wire.so" "wire.dylib")))
            (await (writeFile native-path
                     (globalThis.Uint8Array.from
                       (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) native-target)))))
          (let ((reference (resolve directory "reference"))
                (mod-idx 0))
            (setq reference-path (resolve reference entry))
            (await (mkdir (resolve reference "node_modules") (js-object :recursive t)))
            (await (symlink (resolve root "runtime") (resolve reference "runtime") "dir"))
            (await (symlink root (resolve reference "node_modules/eliscript") "dir"))
            (while (< mod-idx (js-length modules))
              (let* ((mod (aref modules mod-idx))
                     (output (resolve reference (get mod :id))))
                (await (mkdir (dirname output) (js-object :recursive t)))
                (await (writeFile output (js-call (get backend :compiler) :emit_ir_string (get mod :program)))))
              (setq mod-idx (1+ mod-idx)))
            (let ((oracle-helper (resolve root "tests/helpers/wasm-managed-wire-oracle.mjs"))
                  (ref-url (get (pathToFileURL reference-path) :href))
                  (http-url (get (pathToFileURL (resolve root "runtime/wire/http-rpc.mjs")) :href))
                  (cmd-idx 0))
              (while (< cmd-idx (js-length host-commands))
                (let* ((command (aref host-commands cmd-idx))
                       (observation (JSON/parse
                                      (await (run-cmd (js-call command :concat
                                                        (js-array oracle-helper "--run-oracle" ref-url http-url))))))
                       (original (JSON/parse
                                   (await (run-cmd (js-call command :concat
                                                     (js-array (resolve root "tests/fixtures/wire-host.mjs")
                                                               (resolve reference "tests/fixtures/wire.mjs"))))))))
                  (if (undefined? expected)
                    (setq expected observation)
                    (js-call assert :deepEqual observation expected "independent Node and Bun original wire implementations"))
                  (js-call assert :deepEqual original (js-object :codec t :discovery t :usageSafe t :post t)))
                (setq cmd-idx (1+ cmd-idx)))
              (js-call assert :equal (js-length roundtrips) 130)
              (let ((rt-idx 0))
                (while (< rt-idx (js-length roundtrips))
                  (js-call assert :deepEqual
                    (get (aref (get expected :results) (1+ rt-idx)) :value)
                    (aref roundtrips rt-idx))
                  (setq rt-idx (1+ rt-idx))))
              (let ((parse-offset (+ 1 (js-length roundtrips)))
                    (err-idx 0))
                (js-call assert :deepEqual
                  (get (aref (get expected :results) (+ parse-offset 3)) :value)
                  (JSON/parse "{\"__proto__\":{\"polluted\":true}}"))
                (js-call assert :equal (get (js-object) :polluted) undefined)
                (while (< err-idx (js-length original-error-codes))
                  (let ((actual (aref (get expected :results) (+ parse-offset 8 err-idx))))
                    (js-call assert :equal (get actual :ok) false)
                    (js-call assert :equal (get (get actual :error) :code) (aref original-error-codes err-idx))
                    (funcall assert (> (get (get actual :error) :line) 0)))
                  (setq err-idx (1+ err-idx)))
                (let ((schema-offset (+ parse-offset (js-length parse-cases) 10)))
                  (js-call assert :deepEqual
                    (get (aref (get expected :results) schema-offset) :value)
                    (js-object :valid t :errors (js-array)))
                  (js-call assert :equal (get (get (aref (get expected :results) (+ schema-offset 1)) :value) :valid) false)
                  (js-call (js-array "min_len" "type" "additional" "pattern") :forEach
                    (lambda (rule)
                      (funcall assert
                        (js-call (get (get (aref (get expected :results) (+ schema-offset 1)) :value) :errors) :some
                          (lambda (error) (= (get error :rule) rule))))))
                  (js-call assert :equal
                    (get (aref (get (get (aref (get expected :results) (+ schema-offset 2)) :value) :errors) 0) :rule)
                    "required")
                  (js-call assert :equal (get (get (aref (get expected :results) (+ schema-offset 6)) :value) :valid) false)
                  (js-call assert :equal (get expected :negativeZero) t)))
              (let ((payload (js-object :User (js-object :name "小明😀" :tags (js-array "中文" "a|b") :nested (js-object :ok t))))
                    (rt-cmd-idx 0))
                (while (< rt-cmd-idx (js-length host-commands))
                  (let ((command (aref host-commands rt-cmd-idx)))
                    (js-call assert :deepEqual
                      (JSON/parse (await (run-cmd (js-call command :concat
                                                    (js-array oracle-helper "--run-roundtrip" ref-url (JSON/stringify payload))))))
                      payload))
                  (setq rt-cmd-idx (1+ rt-cmd-idx)))))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun finish (runtime)
    (js-call runtime :closeModule)
    (js-call runtime :collect)
    (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
    (js-call assert :equal (js-call runtime :live) 0))

  (defun pin-arguments (runtime values)
    (js-call values :map
      (lambda (value)
        (if (= (value-type value) "string")
          (js-call runtime :string value)
          (js-call runtime :fromHostValue value)))))

  (defun call-sync (runtime name &rest __host_default_arguments_1)
    (let* ((values (aref __host_default_arguments_1 0)))
    (let* ((vals (if (undefined? values) (js-array) values))
           (arguments- (pin-arguments runtime vals))
           (result undefined))
      (try
        (progn
          (setq result (js-call runtime :invoke name arguments-))
          (js-call runtime :readString result))
        (finally
          (when (not (nullish? result)) (js-call runtime :release result))
          (js-call arguments- :forEach (lambda (value) (js-call runtime :release value))))))))

  (defasync call-async (runtime name &rest __host_default_arguments_2)
    (let* ((values (aref __host_default_arguments_2 0)))
    (let* ((vals (if (undefined? values) (js-array) values))
           (arguments- (pin-arguments runtime vals))
           (result undefined))
      (try
        (progn
          (setq result (await (js-call runtime :invokeAsync name arguments-)))
          (js-call runtime :readString result))
        (finally
          (when (not (nullish? result)) (js-call runtime :release result))
          (js-call arguments- :forEach (lambda (value) (js-call runtime :release value))))))))

  (defun host-call (runtime name values)
    (let ((arguments- (pin-arguments runtime values))
          (result undefined))
      (try
        (progn
          (setq result (js-call runtime :invoke name arguments-))
          (js-call runtime :toHostValue result))
        (finally
          (when (not (nullish? result)) (js-call runtime :release result))
          (js-call arguments- :forEach (lambda (value) (js-call runtime :release value)))))))

  (defun target-http (runtime)
    (js-object
      :createService (lambda (settings) (host-call runtime "http-service" (js-array settings)))
      :createClient (lambda (settings) (host-call runtime "http-client" (js-array settings)))
      :discoveryCandidates (lambda (url) (host-call runtime "http-candidates" (js-array url)))
      :pathIndexMarkdown (lambda (title operations &rest __host_default_arguments_3)
    (let* ((location (aref __host_default_arguments_3 0)))
                           (host-call runtime "http-index"
                             (js-array title operations (if (undefined? location) "/" location)))))))

  (defasync check-corpus (runtime)
    (let ((index 0))
      (while (< index (js-length cases))
        (let ((record (aref cases index)))
          (try
            (js-call assert :deepEqual
              (JSON/parse (call-sync runtime (get record :fn) (get record :args)))
              (aref (get expected :results) index)
              (get record :name))
            (catch error
              (when (and (not (nullish? error)) (= (value-type error) "object"))
                (put error :wireCase
                  (js-object :index index :name (get record :name)
                             :filename (aref (aref sources (1- (js-length sources))) 1))))
              (throw error)))
          (js-call runtime :collect)
          (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0 (str (get record :name) " frames")))
        (setq index (1+ index))))
    (let ((negative (js-call runtime :invoke "parse-negative-zero")))
      (try
        (js-call assert :equal (js-call runtime :toHostValue negative) t)
        (finally (js-call runtime :release negative))))
    (js-call assert :equal (get (js-object) :polluted) undefined)
    (js-call assert :deepEqual (await (httpContracts (target-http runtime))) (get expected :http))
    (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0))

  (defun platform-options ()
    (Object/assign (js-object) options
      (js-object
        :hostModules (new globalThis.Map (js-array (js-array "eliscript/platform/http.mjs" http-platform)))
        :importModule (lambda (specifier)
                        (js-call assert :equal specifier "eliscript/platform/http.mjs")
                        http-platform))))

  (defasync check-network (runtime)
    (let ((original-payload (js-object :User (js-object :name "小明😀" :tags (js-array "中文" "a|b") :nested (js-object :ok t)))))
      (js-call assert :deepEqual
        (JSON/parse (call-sync runtime "original-roundtrip" (js-array (JSON/stringify original-payload))))
        original-payload))
    (let* ((api (target-http runtime))
           (calls 0)
           (serve (js-call api :createService
                    (js-object
                      :title "Example"
                      :operations (js-array
                                    (js-object
                                      :path "/rpc/echo" :title "Echo"
                                      :execute (async (request)
                                                 (setq calls (1+ calls))
                                                 (new globalThis.Response (await (js-call request :text))
                                                   (js-object :headers (js-object "Content-Type" "text/markdown; variant=mdp")))))))))
           (server nil))
      (setq server
        (createServer
          (async (request response)
            (try
              (let ((chunks (js-array)))
                (await (new globalThis.Promise
                         (lambda (resolve-body reject-body)
                           (js-call request :on "data" (lambda (chunk) (js-call chunks :push chunk)))
                           (js-call request :once "end" resolve-body)
                           (js-call request :once "error" reject-body))))
                (let* ((port (get (js-call server :address) :port))
                       (req-init (Object/assign
                                   (js-object :method (get request :method) :headers (get request :headers))
                                   (if (= (get request :method) "POST")
                                     (js-object :body (Buffer/concat chunks))
                                     (js-object))))
                       (result (await (funcall serve
                                        (new globalThis.Request (str "http://127.0.0.1:" port (get request :url)) req-init)))))
                  (js-call response :writeHead (get result :status) (Object/fromEntries (get result :headers)))
                  (js-call response :end (await (js-call result :text)))))
              (catch error
                (js-call response :writeHead 500)
                (js-call response :end "Server error")
                (put server :lastWireError error))))))
      (await (new globalThis.Promise (lambda (res) (js-call server :listen 0 "127.0.0.1" res))))
      (try
        (let* ((origin (str "http://127.0.0.1:" (get (js-call server :address) :port)))
               (client (js-call api :createClient (js-object :timeoutMs 3000))))
          (js-call assert :equal (get (await (js-call client :discover origin)) :state) "found")
          (js-call assert :match (get (await (js-call client :index (str origin "/rpc"))) :body)
            (new globalThis.RegExp "`/rpc/echo`" "u"))
          (await (js-call client :usage (str origin "/rpc/echo")))
          (js-call assert :equal calls 0)
          (js-call assert :equal
            (get (await (js-call client :invoke (str origin "/rpc/echo") "- value: 42\n"
                          (js-object :allowPost t :contentType "text/markdown; variant=mdp"))) :body)
            "- value: 42\n")
          (js-call assert :equal calls 1)
          (let ((payload (js-object :User (js-object :name "中文😀" :nested (js-array 1 (js-object :ok t))))))
            (js-call assert :deepEqual
              (JSON/parse (await (call-async runtime "original-echo" (js-array (str origin "/rpc/echo") (JSON/stringify payload)))))
              payload)
            (js-call assert :equal calls 2))
          (when (get server :lastWireError)
            (throw (get server :lastWireError))))
        (finally
          (js-call server :closeAllConnections)
          (await (new globalThis.Promise (lambda (res) (js-call server :close res))))))
      (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)))

  (js-call (js-array 65536 1) :forEach
    (lambda (auto)
      (test (str "Given complete original wire corpus and actual HTTP capabilities when WASM executes MDP MDS and GEPO at auto("
                 auto
                 ") then independent Node and Bun observations and cleanup agree")
        (async ()
          (let ((runtime (await (instantiateManagedRuntimeWithHostModules bytes (platform-options)))))
            (js-call runtime :auto auto)
            (try
              (progn
                (await (check-corpus runtime))
                (await (check-network runtime)))
              (finally (finish runtime)))))
        120000)))

  (funcall (js-call test :skipIf (not native-target))
    "Given the identical complete wire graph when actual native code executes original codecs schema discovery and real HTTP then Node and Bun expectations and roots agree"
    (async ()
      (let ((runtime (await (instantiateNativeManagedRuntime native-path lowered
                              (Object/assign (js-object) (platform-options) memory (js-object :nativeTarget native-target))))))
        (js-call runtime :auto 1)
        (try
          (progn
            (await (check-corpus runtime))
            (await (check-network runtime)))
          (finally
            (try (finish runtime)
              (finally (js-call runtime :close)))))))
    120000)

  (defun visit-nodes (program visit)
    (let ((pending (js-call (get program :body) :slice)))
      (while (> (js-length pending) 0)
        (let ((node (js-call pending :pop)))
          (funcall visit node)
          (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))))

  (test "Given the actual wire library relative transport dependency When the private literal graph links Then only its exact HTTP edge becomes the existing canonical host capability"
    (lambda ()
      (let* ((library (js-call literal-modules :find (lambda (item) (= (get item :id) "runtime/wire/http-rpc.mjs"))))
             (dependency (js-call (js-call (get (get library :program) :body) :flatMap
                                    (lambda (node)
                                      (if (= (get node :kind) "module-declaration")
                                        (get node :children)
                                        (js-array node))))
                                  :find (lambda (node)
                                          (and (= (get node :kind) "import-declaration")
                                               (= (get node :value) "../../platform/http.mjs"))))))
        (funcall assert dependency "the source retains its relative repository dependency")
        (funcall assert
          (js-call (get (get lowered :descriptor) :hostModules) :some
            (lambda (item) (= (get item :specifier) "eliscript/platform/http.mjs"))))
        (funcall assert
          (not (js-call (get (get lowered :descriptor) :hostModules) :some
                 (lambda (item) (= (get item :specifier) "../../platform/http.mjs")))))
        (js-call (js-array "../../platform/worker.mjs" "../../platform/http.mjs?changed" "../platform/http.mjs") :forEach
          (lambda (replacement)
            (let* ((changed (globalThis.structuredClone literal-modules))
                   (copy (js-call changed :find (lambda (item) (= (get item :id) (get library :id))))))
              (visit-nodes (get copy :program)
                (lambda (node)
                  (when (and (= (get node :kind) "import-declaration")
                             (= (get node :value) (get dependency :value)))
                    (put node :value replacement))))
              (let ((before (globalThis.structuredClone changed)))
                (js-call assert :throws
                  (lambda ()
                    (js-call (get backend :managed) :link_managed_project
                      original-modules entry (js-object :literalModules changed)))
                  (lambda (error)
                    (= (and (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code)) "ELI-B0001")))
                (js-call assert :deepEqual changed before "failed host linking preserves all input nodes")))))
        (let* ((wrong-owner (globalThis.structuredClone literal-modules))
               (markdown (js-call wrong-owner :find (lambda (item) (= (get item :id) "runtime/wire/markdown.mjs"))))
               (declaration (globalThis.structuredClone dependency))
               (first-node (aref (get (get markdown :program) :body) 0))
               (body (if (and first-node (= (get first-node :kind) "module-declaration"))
                       (get first-node :children)
                       (get (get markdown :program) :body))))
          ;; This relative spelling normalizes to the same path from the sibling ID,
          ;; which must still not inherit the HTTP library's declared host authority.
          (js-call body :unshift declaration)
          (js-call assert :throws
            (lambda ()
              (js-call (get backend :managed) :link_managed_project
                original-modules entry (js-object :literalModules wrong-owner)))
            (lambda (error)
              (= (and (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code)) "ELI-B0001"))))))
    120000)

  (test "Given ordinary IR literals with omitted or empty optional metadata When linked and executed Then input nodes signed zero NaN and explicit undefined flags stay distinct"
    (async ()
      (let* ((source "(defun flags ()\n    (JSON/stringify (js-array (Object/is -0.0 0.0) (Object/is -0.0 -0.0)\n      (Number/isNaN (get globalThis/Number :NaN)) (undefined? undefined)\n      (nil? nil) (eq false nil) (get (js-object :alpha -0.0) :alpha)\n      (Object/is (get (js-object :alpha -0.0) :alpha) -0.0))))\n    (export flags)")
             (original (js-call (get backend :compiler) :compile_ir_string source "optional-literal-metadata.eli"))
             (javascript (js-call (get backend :compiler) :emit_ir_string original))
             (reference (await (funcall dynamic-import
                                 (str "data:text/javascript;base64,"
                                      (js-call (Buffer/from javascript) :toString "base64")))))
             (expected-flags (js-call reference :flags)))
        (js-call assert :deepEqual (JSON/parse expected-flags) (js-array false t t t t false 0 t))
        (let ((empty-modes (js-array false t))
              (em-idx 0))
          (while (< em-idx (js-length empty-modes))
            (let ((empty (aref empty-modes em-idx))
                  (program (globalThis.structuredClone original))
                  (ordinary 0)
                  (undefined-count 0))
              (visit-nodes program
                (lambda (node)
                  (when (= (get node :kind) "literal")
                    (let* ((props (get node :properties))
                           (lk (if (nullish? props) undefined (get props :literalKind))))
                      (cond
                        ((= lk "undefined") (setq undefined-count (1+ undefined-count)))
                        ((undefined? lk)
                         (setq ordinary (1+ ordinary))
                         (if empty
                           (put node :properties (js-object))
                           (Reflect/deleteProperty node "properties"))))))))
              (funcall assert (> ordinary 0))
              (funcall assert (> undefined-count 0))
              (let* ((modules (js-array (js-object :id "optional.mjs" :program program)))
                     (before (globalThis.structuredClone modules))
                     (result (js-call (get backend :managed) :lower_managed_project
                               modules "optional.mjs" runtime-ir
                               (Object/assign (js-object) memory (js-object :literalModules literal-modules))))
                     (emitted (globalThis.Uint8Array.from
                                (js-call (get backend :wasm) :append_metadata_section
                                  (js-call (get backend :wasm) :emit_typed_memory_wasm (get result :typed) memory)
                                  "eliscript-managed-control"
                                  (JSON/stringify (get result :descriptor)))))
                     (runtime (await (instantiateManagedRuntimeWithHostModules emitted (platform-options)))))
                (js-call assert :deepEqual modules before "lowering never adds metadata or rewrites original literal values")
                (js-call runtime :auto 1)
                (try
                  (progn
                    (js-call assert :equal (call-sync runtime "flags") expected-flags)
                    (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0))
                  (finally (finish runtime)))))
            (setq em-idx (1+ em-idx))))
        (js-call (js-array nil false (js-array) 42) :forEach
          (lambda (properties)
            (let ((program (globalThis.structuredClone original))
                  (changed false))
              (visit-nodes program
                (lambda (node)
                  (when (and (not changed) (= (get node :kind) "literal") (= (value-type (get node :value)) "number"))
                    (put node :properties properties)
                    (setq changed t))))
              (funcall assert changed)
              (let ((before (globalThis.structuredClone program)))
                (js-call assert :throws
                  (lambda ()
                    (js-call (get backend :managed) :link_managed_project
                      (js-array (js-object :id "invalid.mjs" :program program))
                      "invalid.mjs"
                      (js-object :literalModules literal-modules)))
                  (lambda (error)
                    (= (and (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code)) "ELI-I0001"))
                  "explicit malformed metadata is not an absent optional field")
                (js-call assert :deepEqual program before)))))
        (js-call (js-array "unknown" nil) :forEach
          (lambda (literal-kind)
            (let ((program (globalThis.structuredClone original))
                  (changed false))
              (visit-nodes program
                (lambda (node)
                  (when (and (not changed) (= (get node :kind) "literal") (= (value-type (get node :value)) "number"))
                    (put node :properties (js-object :literalKind literal-kind))
                    (setq changed t))))
              (let ((before (globalThis.structuredClone program)))
                (js-call assert :throws
                  (lambda ()
                    (js-call (get backend :managed) :lower_managed_project
                      (js-array (js-object :id "tagged.mjs" :program program))
                      "tagged.mjs"
                      runtime-ir
                      (Object/assign (js-object) memory (js-object :literalModules literal-modules))))
                  (lambda (error)
                    (= (and (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code)) "ELI-B0001"))
                  "an explicit unsupported literal tag cannot become an ordinary literal")
                (js-call assert :deepEqual program before)))))))
    120000))
