(module tests.wasm-managed-json-atoms.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defvar b undefined)
  (defvar rt undefined)
  (defvar p undefined)
  (defvar bytes undefined)
  (defvar directory undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-json-atoms-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq rt (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq p (js-call (get b :compiler) :compile_ir_string "(defun parse (text) (js-call (js* \"JSON\") :parse text)) (defun encode (value) (JSON/stringify value)) (export parse encode)" "atoms.eli"))
    (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p rt)))
    (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array)))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun finish (a values)
    (js-call values :forEach (lambda (x) (js-call a :release x)))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (test "fixed-slot parsing shares repeated immutable atoms while retaining each independently mutable container" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 512 :initialBytes 65536 :maxBytes 1048576)))
           (_ (js-call a :auto 1))
           (text (str "[" (js-call (Array/from (js-object :length 100) (lambda () "{\"label\":\"same\",\"value\":42,\"items\":[]}")) :join ",") "]"))
           (input (js-call a :string text))
           (out (js-call a :invoke "parse" (js-array input))))
      (js-call a :collect)
      (funcall assert (< (js-call a :live) 360) (JSON/stringify (js-call a :stats)))
      (let ((label (js-call a :string "label"))
            (value (js-call a :string "value"))
            (items (js-call a :string "items"))
            (previous undefined)
            (i 0))
        (while (< i 100)
          (let* ((object (js-call a :get out i))
                 (s (js-call a :objectGet object label))
                 (n (js-call a :objectGet object value))
                 (array (js-call a :objectGet object items)))
            (js-call assert :equal (js-call a :readString s) "same")
            (js-call assert :equal (js-call a :readNumber n) 42)
            (when previous
              (js-call assert :equal (js-call a :keyEqual object (get previous :object)) false)
              (js-call assert :equal (js-call a :keyEqual array (get previous :array)) false)
              (js-call a :release (get previous :object))
              (js-call a :release (get previous :array)))
            (setq previous (js-object :object object :array array))
            (js-call a :release s)
            (js-call a :release n))
          (setq i (1+ i)))
        (js-call a :release (get previous :object))
        (js-call a :release (get previous :array))
        (finish a (js-array input out label value items))))))

  (test "equivalent decoded strings and numeric spellings preserve UTF16, field order, __proto__, signed zero and overflow" (lambda ()
    (let ((a (instantiateManagedRuntime bytes))
          (texts (js-array
                   "[0,-0,-0.0,-1e-9999,1,1.0,1e0,1e9999,-1e9999,5e-324,2.2250738585072014e-308,9007199254740993]"
                   "[\"a\",\"\\u0061\",\"中😀\",\"\\ud83d\\ude00\",\"\\ud800\",\"\\udfff\",\"\"]"
                   "{\"b\":1,\"2\":2,\"1\":3,\"a\":4,\"b\":5,\"__proto__\":{\"x\":1},\"constructor\":7,\"prototype\":8}")))
      (js-call a :auto 1)
      (js-call texts :forEach
        (lambda (text)
          (let* ((input (js-call a :string text))
                 (out (js-call a :invoke "parse" (js-array input)))
                 (encoded (js-call a :invoke "encode" (js-array out)))
                 (parsed (JSON/parse text)))
            (js-call assert :equal (js-call a :readString encoded) (JSON/stringify parsed))
            (when (Array/isArray parsed)
              (let ((i 0))
                (while (< i (js-length parsed))
                  (let ((item (js-call a :get out i))
                        (expected (aref parsed i)))
                    (if (= (value-type expected) "number")
                      (funcall assert (Object/is (js-call a :readNumber item) expected))
                      (js-call assert :equal (js-call a :readString item) expected))
                    (js-call a :release item))
                  (setq i (1+ i)))))
            (js-call (js-array input out encoded) :forEach (lambda (x) (js-call a :release x)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))
      (finish a (js-array)))))

  (test "containers remain independently mutable and the parse cache does not survive the call or cross parse boundaries" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes))
           (_ (js-call a :auto 1))
           (input (js-call a :string "[{\"x\":\"same\",\"a\":[]},{\"x\":\"same\",\"a\":[]}]"))
           (out (js-call a :invoke "parse" (js-array input)))
           (other (js-call a :invoke "parse" (js-array input)))
           (left (js-call a :get out 0))
           (right (js-call a :get out 1))
           (key (js-call a :string "a"))
           (x (js-call a :string "x"))
           (first (js-call a :objectGet left key))
           (second (js-call a :objectGet right key))
           (n (js-call a :number 7)))
      (js-call assert :equal (js-call a :keyEqual out other) false)
      (js-call a :resize first 1)
      (js-call a :set first 0 n)
      (js-call assert :equal (js-call a :length second) 0)
      (js-call a :objectSet left x n)
      (let ((unchanged (js-call a :objectGet right x)))
        (js-call assert :equal (js-call a :readString unchanged) "same")
        (finish a (js-array input out other left right key x first second n unchanged)))
      (let* ((duplicate (js-call a :string "{\"x\":\"discarded\",\"x\":\"kept\"}"))
             (object (js-call a :invoke "parse" (js-array duplicate))))
        (js-call a :release duplicate)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 4 "only object, property table, live key and final value remain")
        (js-call a :release object)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))
      (let ((i 0))
        (while (< i 12)
          (let* ((text (js-call a :string "[\"repeat\",\"repeat\",42,42]"))
                 (value (js-call a :invoke "parse" (js-array text))))
            (js-call a :release text)
            (js-call a :release value)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
          (setq i (1+ i)))))))

  (test "unique atoms still exhaust the fixed budget honestly and grammar errors release all cache roots before a valid retry" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 65536)))
           (_ (js-call a :auto 1))
           (held (js-call a :number -0.0))
           (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 held)
      (js-call
        (js-array
          (str "[" (js-call (Array/from (js-object :length 200) (lambda (_ i) (JSON/stringify (str "unique" i)))) :join ",") "]")
          "[\"cached\",\"cached\",42,42,]")
        :forEach
        (lambda (text)
          (let ((input (js-call a :string text)))
            (js-call assert :throws
              (lambda () (js-call a :invoke "parse" (js-array input)))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (and diag (= (get diag :code) (if (js-call text :endsWith ",]") "ELI-RT0003" "ELI-RT0002"))))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (funcall assert (Object/is (js-call a :readNumber held) -0.0))
            (js-call a :release input)
            (js-call a :collect))))
      (let* ((valid (js-call a :string "[\"retry\",\"retry\",0,-0]"))
             (out (js-call a :invoke "parse" (js-array valid)))
             (minus (js-call a :get out 3)))
        (funcall assert (Object/is (js-call a :readNumber minus) -0.0))
        (js-call a :leaveFrame frame)
        (finish a (js-array held valid out minus))))))

  (test "a real atom-cache growth trap preserves caller roots and does not replace an earlier JSON grammar error" (async ()
    (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call source :indexOf "  (defun heap-table-grow "))
           (end (js-call source :indexOf "  (defun " (+ start 3))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call source :slice 0 start)
                              "  (defun heap-table-grow (heap table) (load-u32 4294967295))\n"
                              (js-call source :slice end))
                         "atom-trap.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p injected))))
             (_ (js-call a :auto 1))
             (held (js-call a :number -0.0))
             (frame (js-call a :frame 1))
             (bad (js-call a :string "[\"\\x\"]"))
             (input (js-call a :string "[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\"]")))
        (js-call a :frameSet frame 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "parse" (js-array bad)))
          (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call assert :throws
          (lambda () (js-call a :invoke "parse" (js-array input)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (funcall assert (Object/is (js-call a :readNumber held) -0.0))
        (js-call a :release input)
        (js-call a :release bad)
        (js-call a :collect)
        (let* ((retry (js-call a :string "[\"ok\",\"ok\"]"))
               (out (js-call a :invoke "parse" (js-array retry))))
          (js-call assert :equal (js-call a :length out) 2)
          (js-call a :leaveFrame frame)
          (finish a (js-array held retry out)))))))

  (test "Node executes the same zero-import bytes with exact primitive bits and the fixed repeated-atom budget" (async ()
    (let ((file (resolve directory "atoms.wasm")))
      (await (writeFile file bytes))
      (let ((result (spawnSync "node"
                      (js-array (resolve "tests/helpers/wasm-managed-json-atoms-node.mjs")
                                (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                file)
                      (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get result :status) 0 (get result :stderr)))))))
