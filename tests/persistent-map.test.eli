(module tests.persistent-map
  (import "bun:test" expect test)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/map.mjs" EMPTY_MAP PersistentHashMap isPersistentHashMap persistentHashMap)
  (import "../runtime/testing/map.mjs" inspectPersistentMap persistentMapMetrics resetPersistentMapMetrics sharedPersistentMapNodes)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (import "../runtime/core/vector.mjs" persistentVector)
  (import "../runtime/testing/value.mjs" clearValueHashCaches resetValueHashMetrics valueHashMetrics)
  (defun host-type (value) (js* "typeof value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same-values (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (thunk expected) (js-call (expect thunk) :toThrow expected))
  (defun at-most (actual expected) (js-call (expect actual) :toBeLessThanOrEqual expected))
  (defun mapRange (count)
    (let ((result EMPTY_MAP) (key 0))
      (while (< key count) (setq result (js-call result :assoc key (* key 2)) key (1+ key))) result))
  (defun nextRandom (state)
    (let ((value (get state :value)))
      (setq value (bit-xor value (bit-shift-left value 13)))
      (setq value (bit-xor value (unsigned-bit-shift-right value 17)))
      (setq value (bit-xor value (bit-shift-left value 5)))
      (put state :value (uint32 value)) (get state :value)))
  (defun distinctRootKeys (count)
    (let ((keys (new globalThis.Map)) (candidate 0))
      (while (< (get keys :size) count)
        (let ((branch (bit-and (hashValue candidate) 31)))
          (unless (js-call keys :has branch) (js-call keys :set branch candidate)))
        (setq candidate (1+ candidate))) (Array/from (js-call keys :values))))
  (defasync runHost (command source)
    (let* ((child (js-call globalThis.Bun :spawn (js-array command source) (js-object :stdout "pipe" :stderr "pipe")))
           (parts (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref parts 0)) (stdout (aref parts 1)) (stderr (aref parts 2)))
      (unless (= exitCode 0)
        (let ((message (js-call stderr :trim)))
          (throw (new globalThis.Error (if (> (js-length message) 0) message (str command " exited with " exitCode))))))
      (JSON/parse stdout)))

  (test "persistent hash map preserves old values and value-equal keys" (lambda ()
    (be (js-call PersistentHashMap :empty) EMPTY_MAP) (be (get EMPTY_MAP :count) 0) (be (get EMPTY_MAP :size) 0)
    (js-call (expect (js-call EMPTY_MAP :get "missing")) :toBeNull)
    (be (js-call EMPTY_MAP :get "missing" "fallback") "fallback") (be (js-call EMPTY_MAP :has "missing") false)
    (raises (lambda () (new PersistentHashMap)) globalThis.TypeError)
    (let* ((key (persistentVector 1 2 3)) (equalKey (persistentVector 1 2 3))
           (original (persistentHashMap (js-array "name" "Eliscript") (js-array key 1)))
           (updated (js-call (js-call original :assoc equalKey 2) :assoc "new" undefined)))
      (be (isPersistentHashMap original) t) (be (Object/isFrozen original) t) (be (get original :count) 2)
      (be (js-call original :get equalKey) 1) (be (get updated :count) 3) (be (js-call updated :get key) 2)
      (be (js-call updated :has "new") t) (js-call (expect (js-call updated :get "new" "fallback")) :toBeUndefined)
      (be (js-call updated :assoc equalKey 2) updated) (be (js-call updated :dissoc "missing") updated)
      (be (get (js-call updated :dissoc "new") :count) 2) (be (js-call original :has "new") false)
      (be (js-call (Array/from (js-call updated :keys)) :some (lambda (stored) (eq stored key))) t))
    (raises (lambda () (js-call PersistentHashMap :from (js-array (js-array 1)))) globalThis.TypeError)
    (raises (lambda () (js-call PersistentHashMap :from (js-array nil))) globalThis.TypeError)
    (let* ((hostKey (js-object :identity t))
           (scalarKeys (persistentHashMap (js-array nil "null") (js-array undefined "undefined")
             (js-array Number/NaN "nan") (js-array (js* "-0") "zero") (js-array hostKey "host"))))
      (be (get scalarKeys :count) 5) (be (js-call scalarKeys :get Number/NaN) "nan")
      (be (js-call scalarKeys :get 0) "zero") (be (js-call scalarKeys :get hostKey) "host")
      (be (js-call scalarKeys :has (js-object :identity t)) false))))

  (test "persistent hash map handles full 32-bit hash collisions" (lambda ()
    (let ((left "key-50691") (right "key-194634"))
      (be (hashValue left) (hashValue right))
      (let ((map (persistentHashMap (js-array left 1) (js-array right 2))))
        (be (get map :count) 2) (be (js-call map :get left) 1) (be (js-call map :get right) 2)
        (be (get (inspectPersistentMap map) :collisionNodes) 1)
        (let ((updated (js-call map :assoc right 3)))
          (be (get updated :count) 2) (be (js-call updated :get left) 1) (be (js-call updated :get right) 3)
          (be (js-call map :get right) 2) (be (js-call (js-call updated :dissoc left) :get right) 3)
          (be (js-call (js-call updated :dissoc right) :get left) 1))
        (let ((third "") (candidate 0) (found false))
          (while (not found)
            (let ((key (str "third-" candidate)))
              (when (and (not (eq (hashValue key) (hashValue left)))
                         (eq (bit-and (hashValue key) 31) (bit-and (hashValue left) 31)))
                (setq third key found t)))
            (setq candidate (1+ candidate)))
          (let ((branched (js-call map :assoc third 4)))
            (be (js-call branched :get left) 1) (be (js-call branched :get right) 2)
            (be (js-call branched :get third) 4) (be (js-call (js-call branched :dissoc third) :get right) 2)))))))

  (test "persistent hash map promotes and demotes measured branch thresholds" (lambda ()
    (let ((keys (distinctRootKeys 32)) (map EMPTY_MAP))
      (js-call (js-call keys :slice 0 31) :forEach (lambda (key) (setq map (js-call map :assoc key key))))
      (be (get (inspectPersistentMap map) :arrayNodes) 0) (resetPersistentMapMetrics)
      (setq map (js-call map :assoc (aref keys 31) (aref keys 31)))
      (be (get (persistentMapMetrics) :promotions) 1) (be (get (inspectPersistentMap map) :arrayNodes) 1)
      (js-call (js-call keys :slice 0 7) :forEach (lambda (key) (setq map (js-call map :dissoc key))))
      (be (get map :count) 25) (be (get (inspectPersistentMap map) :arrayNodes) 1)
      (resetPersistentMapMetrics) (setq map (js-call map :dissoc (aref keys 7)))
      (be (get map :count) 24) (be (get (persistentMapMetrics) :demotions) 1)
      (be (get (inspectPersistentMap map) :arrayNodes) 0)
      (js-call (js-call keys :slice 8) :forEach (lambda (key) (be (js-call map :get key) key))))))

  (test "dense map leaf updates retain structural equality, original keys and snapshots" (lambda ()
    (let ((branches (new globalThis.Map)) (candidate 0))
      (while (< (get branches :size) 32)
        (let* ((key (persistentVector candidate)) (branch (bit-and (hashValue key) 31)))
          (unless (js-call branches :has branch) (js-call branches :set branch key)))
        (setq candidate (1+ candidate)))
      (let ((keys (Array/from (js-call branches :values))) (original EMPTY_MAP))
        (js-call keys :forEach (lambda (key) (setq original (js-call original :assoc key (persistentVector (js-call key :nth 0) 1)))))
        (be (get (inspectPersistentMap original) :arrayNodes) 1)
        (let ((equivalent (persistentVector (js-call (aref keys 0) :nth 0))))
          (be (js-call original :assoc equivalent (persistentVector (js-call (aref keys 0) :nth 0) 1)) original)
          (resetPersistentMapMetrics)
          (let ((updated (js-call original :assoc equivalent (persistentVector (js-call (aref keys 0) :nth 0) 2))))
            (be (get updated :count) 32) (be (js-call (js-call updated :get equivalent) :nth 1) 2)
            (be (js-call (js-call original :get equivalent) :nth 1) 1)
            (be (js-call (Array/from (js-call updated :keys)) :find (lambda (key) (equalValues key equivalent))) (aref keys 0))
            (be (get (persistentMapMetrics) :nodeAllocations) 1) (be (get (persistentMapMetrics) :entryAllocations) 1)
            (let ((extra undefined) (candidate 10000))
              (while (undefined? extra)
                (let ((key (persistentVector candidate)))
                  (when (and (eq (bit-and (hashValue key) 31) (bit-and (hashValue (aref keys 0)) 31)) (not (js-call original :has key)))
                    (setq extra key)))
                (setq candidate (1+ candidate)))
              (let ((branched (js-call updated :assoc extra 99)))
                (be (get branched :count) 33) (be (js-call branched :get extra) 99)
                (be (js-call updated :has extra) false) (be (equalValues (js-call branched :dissoc extra) updated) t)))))))))

  (test "array map demotion allocates the final bitmap node without a temporary array node" (lambda ()
    (let ((keys (distinctRootKeys 32)) (map EMPTY_MAP))
      (js-call keys :forEach (lambda (key) (setq map (js-call map :assoc key key))))
      (js-call (js-call keys :slice 0 7) :forEach (lambda (key) (setq map (js-call map :dissoc key))))
      (let ((before map))
        (resetPersistentMapMetrics) (setq map (js-call map :dissoc (aref keys 7)))
        (be (get (persistentMapMetrics) :nodeAllocations) 1) (be (get (persistentMapMetrics) :demotions) 1)
        (be (get map :count) 24) (be (get (inspectPersistentMap map) :arrayNodes) 0)
        (be (get before :count) 25) (be (js-call before :has (aref keys 7)) t)
        (js-call (js-call keys :slice 8) :forEach (lambda (key) (be (js-call map :get key) key)))))))

  (test "persistent hash map equality and hash ignore insertion order" (lambda ()
    (let ((left (persistentHashMap (js-array "alpha" (persistentVector 1 2)) (js-array (persistentVector "key") "value") (js-array "omega" Number/NaN)))
          (right (persistentHashMap (js-array "omega" Number/NaN) (js-array (persistentVector "key") "value") (js-array "alpha" (persistentVector 1 2)))))
      (be (equalValues left right) t) (be (hashValue left) (hashValue right))
      (be (equalValues left (js-call right :assoc "alpha" (persistentVector 2 1))) false)
      (be (equalValues left (js-call right :dissoc "omega")) false) (be (equalValues left (new globalThis.Map left)) false)
      (be (js-call left :reduce (lambda (total value) (+ total (if (= (host-type value) "string") 1 0))) 0) 1)
      (raises (lambda () (js-call left :reduce (lambda () 0))) globalThis.TypeError))))

  (test "persistent hash map hashes each key/value pair once and caches the result" (lambda ()
    (clearValueHashCaches)
    (let ((map (mapRange 100000)))
      (resetValueHashMetrics)
      (let ((first (hashValue map)))
        (same-values (valueHashMetrics) (js-object :hashValueCalls 200001 :protocolHashComputations 1 :protocolHashCacheHits 0 :hostIdentityAssignments 0))
        (resetValueHashMetrics) (be (hashValue map) first)
        (same-values (valueHashMetrics) (js-object :hashValueCalls 1 :protocolHashComputations 0 :protocolHashCacheHits 1 :hostIdentityAssignments 0))))))

  (test "persistent hash map agrees with a mutable reference model" (lambda ()
    (let ((random (js-object :value 1592594996)) (map EMPTY_MAP) (model (new globalThis.Map)) (step 0))
      (while (< step 20000)
        (let* ((key (% (nextRandom random) 4096)) (choice (% (nextRandom random) 10))
               (previous map) (previousHadKey (js-call model :has key)) (previousValue (js-call model :get key)))
          (if (< choice 7)
            (let ((value (nextRandom random))) (setq map (js-call map :assoc key value)) (js-call model :set key value))
            (progn (setq map (js-call map :dissoc key)) (js-call model :delete key)))
          (be (get map :count) (get model :size)) (be (js-call map :has key) (js-call model :has key))
          (be (js-call map :get key "missing") (if (js-call model :has key) (js-call model :get key) "missing"))
          (be (js-call previous :has key) previousHadKey) (be (js-call previous :get key "missing") (if previousHadKey previousValue "missing"))
          (when (= (% step 250) 0)
            (js-call model :forEach (lambda (modelValue modelKey) (be (js-call map :get modelKey "missing") modelValue)))))
        (setq step (1+ step))))))

  (test "persistent hash map updates copy only the selected node path" (lambda ()
    (let* ((map (mapRange 100000)) (shape (inspectPersistentMap map)))
      (resetPersistentMapMetrics)
      (let* ((updated (js-call map :assoc 54321 -1)) (metrics (persistentMapMetrics)))
        (at-most (get metrics :nodeVisits) 9) (be (get metrics :nodeAllocations) (get metrics :nodeVisits))
        (be (get metrics :entryAllocations) 1) (be (sharedPersistentMapNodes map updated) (- (get shape :nodeCount) (get metrics :nodeVisits)))
        (be (js-call map :get 54321) 108642) (be (js-call updated :get 54321) -1)))))

  (test "persistent hash map stays within HAMT bounds at one million keys" (lambda ()
    (let* ((map (mapRange 1000000)) (shape (inspectPersistentMap map)))
      (be (get shape :count) 1000000) (be (get shape :entries) 1000000) (at-most (get shape :maxDepth) 9)
      (js-call (js-array 0 31 32 1024 32768 500000 999999 "missing") :forEach (lambda (key)
        (resetPersistentMapMetrics)
        (let ((expected (if (= (host-type key) "number") (* key 2) "not-found")))
          (be (js-call map :get key "not-found") expected) (at-most (get (persistentMapMetrics) :nodeVisits) 9))))
      (resetPersistentMapMetrics)
      (let ((updated (js-call map :assoc 500000 -1)))
        (at-most (get (persistentMapMetrics) :nodeVisits) 9) (be (js-call map :get 500000) 1000000) (be (js-call updated :get 500000) -1))
      (resetPersistentMapMetrics)
      (let ((removed (js-call map :dissoc 500000)))
        (at-most (get (persistentMapMetrics) :nodeVisits) 9) (be (js-call removed :has 500000) false) (be (js-call map :has 500000) t)))) 60000)

  (test "persistent hash map has equivalent behavior under Bun and Node" (async ()
    (let* ((fixture (fileURLToPath (new globalThis.URL "fixtures/persistent-map-host.mjs" (js* "import.meta.url"))))
           (results (await (Promise/all (js-array (runHost "bun" fixture) (runHost (get (get globalThis.process :env) :NODE "node") fixture)))))
           (bunResult (aref results 0)) (nodeResult (aref results 1)))
      (same-values nodeResult bunResult)
      (js-call (expect bunResult) :toMatchObject (js-object :probes (js-array 0 62 64 2048 65536 199998) :missing "not-found"
        :original 108642 :updated "updated" :sum 9999900000 :collision (js-object :count 2 :left "left" :right "right")
        :unordered (js-object :equal t)))
      (be (get (get bunResult :unordered) :leftHash) (get (get bunResult :unordered) :rightHash))
      (be (get (get bunResult :metrics) :nodeAllocations) (get (get bunResult :metrics) :nodeVisits))
      (be (get bunResult :sharedNodes) (- (get (get bunResult :shape) :nodeCount) (get (get bunResult :metrics) :nodeVisits))))))
)
