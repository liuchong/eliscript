(module tests.portable-value-semantics
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" projectDirectory stdlibDirectory runSuccessful withPortableLibraries assertSourceMap be same excludes)
  (import "./helpers/portable-structure.mjs" nextRandom)
  (import "../runtime/core/list.mjs" :as runtimeList)
  (import "../runtime/core/value.mjs" :as runtimeValue)
  (defconst sources (js-array "bit" "identifier" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value"))
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar generatedModuleBuild undefined)
  (defasync generatedModules (label)
    (when (nullish? generatedModuleBuild)
      (setq generatedModuleBuild (runSuccessful (js-array (resolve projectDirectory "bin/eliscript-build")
        "--root" stdlibDirectory "--out-dir" (resolve projectDirectory "dist/stdlib") (resolve stdlibDirectory "value.eli")) (js-object))))
    (await generatedModuleBuild)
    (let ((suffix (str "?" label "=" (Date/now))) (modules (js-object)) (index 0))
      (while (< index (js-length sources))
        (let ((name (aref sources index)))
          (unless (= name "identifier")
            (put modules name (await (funcall load-module (str (get (pathToFileURL (resolve projectDirectory (str "dist/stdlib/" name ".mjs"))) :href) suffix))))))
        (setq index (1+ index))) modules))
  (test "Eliscript-authored value semantics compile and agree across hosts"
    (async () (await (withPortableLibraries
      (js-object :module "value" :sources sources :fixture "tests/fixtures/portable-value-host.mjs" :loader t
        :extraSources (js-object "host-identity-token" (resolve projectDirectory "tests/fixtures/host-identity-token.eli")))
      (async (context)
        (same (get context :report) (js-object "scalars" (js-object "null" 1108378657 "undefined" 2135587861 "false" 1624342457 "true" 148223603 "zero" 2484920505 "negativeZero" 2484920505 "one" 1472727704 "negativeOne" 1598749574 "fraction" 3192910077 "nan" 1490037359 "positiveInfinity" 232236935 "negativeInfinity" 3719278766 "maxSafeInteger" 566274744 "emptyString" 439960318 "ascii" 1222682721 "unicode" 2785882074) "collections" (js-object "vector" 3898133958 "list" 3277370209 "map" 3379452415 "set" 3887479341) "identifiers" (js-object "keyword" 889022832 "unqualifiedKeyword" 1981314640 "symbol" 1771029623 "unqualifiedSymbol" 3731567423 "portableKeyword" 889022832 "portableSymbol" 1771029623) "invariants" (js-object "nanEqual" t "zerosEqual" t "nestedEqual" t "nestedHashesEqual" t "listsEqual" t "listVectorDistinct" false "mapsEqual" t "mapHashesEqual" t "setsEqual" t "setHashesEqual" t "hostIdentity" t "hostDistinct" false "hostDistinctHashes" t "hostFunctionStable" t "nativeSymbolStable" t "nativeSymbolsDistinct" t "nativeSymbolIdentityEqual" t "nativeSymbolValuesDistinct" t "symbolsEqual" t "identifierCategoriesDistinct" t "portableKeywordEqual" t "portableSymbolEqual" t "portableKeywordValid" t "portableSymbolValid" t "concretePortableOnly" t "invalidPortableIdentifier" t) "collision" (js-object "leftHash" 2357254775 "rightHash" 2357254775 "keysEqual" false "count" 2 "left" "left" "right" "right") "lookup" (js-object "vectorKey" t "vectorValueHash" 2519951401 "setCount" 3 "equalVectorMember" t "keywordValue" "keyword" "symbolValue" "symbol" "identifierSetCount" 2 "equalSymbolMember" t "portableKeywordValue" "keyword" "portableSymbolValue" "symbol" "portableIdentifierSetCount" 2 "nativeSymbolMapCount" 2 "nativeSymbolLeft" "left" "nativeSymbolRight" "right") "hostIdentityScale" (js-object "count" 20000 "uniqueHashes" 20000 "stable" t "mapCount" 20000 "mapLast" 19999 "setCount" 20000 "setLast" t) "identityToken" (js-object "objectStable" t "objectsDistinct" t "functionStable" t "symbolStable" t "symbolsDistinct" t "invalidScalar" (js-object "name" "TypeError" "message" "host-identity-token expects an object, function, or symbol"))))
        (excludes (await (readFile (resolve (get context :seedDirectory) "persistent-vector.eli") "utf8")) "__eliscript_host_identity_token")
        (await (assertSourceMap (get context :seedDirectory) "value" (js-array "(defportable value-equal?" "(defportable value-hash"))))))) 90000)
  (test "portable persistent collections preserve nested undefined values"
    (async ()
      (let* ((modules (await (generatedModules "undefined"))) (valueModule (get modules :value)) (listModule (get modules "persistent-list"))
             (vectorModule (get modules "persistent-vector")) (mapModule (get modules "persistent-map")) (setModule (get modules "persistent-set"))
             (valueEqual (get valueModule :value_equal_QMARK_)) (valueHash (get valueModule :value_hash))
             (fromList (get listModule :persistent_list_from_array)) (fromVector (get vectorModule :persistent_vector_from_array))
             (list (funcall fromList (js-array undefined nil false))) (vector (funcall fromVector (js-array undefined nil false)))
             (map (funcall (get valueModule :value_map_from_entries) (js-array (js-array undefined "undefined-key") (js-array nil "null-key") (js-array "undefined-value" undefined))))
             (set (funcall (get valueModule :value_set_from_array) (js-array undefined nil undefined))))
        (be (funcall (get listModule :persistent_list_first) list "missing") undefined)
        (be (funcall (get listModule :persistent_list_nth) list 0 "missing") undefined)
        (be (funcall (get vectorModule :persistent_vector_nth) vector 0 "missing") undefined)
        (be (funcall (get mapModule :persistent_map_count) map) 3)
        (be (funcall (get mapModule :persistent_map_get) map undefined "missing") "undefined-key")
        (be (funcall (get mapModule :persistent_map_get) map nil "missing") "null-key")
        (be (funcall (get mapModule :persistent_map_get) map "undefined-value" "missing") undefined)
        (be (funcall (get setModule :persistent_set_count) set) 2) (be (funcall (get setModule :persistent_set_has_QMARK_) set undefined) t)
        (be (funcall (get setModule :persistent_set_has_QMARK_) set nil) t)
        (be (valueEqual list (funcall fromList (js-array undefined nil false))) t) (be (valueEqual vector (funcall fromVector (js-array undefined nil false))) t)
        (be (valueHash vector) (valueHash (funcall fromVector (js-array undefined nil false)))))) 30000)
  (test "optimized and portable persistent Lists share frozen hash semantics"
    (async ()
      (let* ((modules (await (generatedModules "runtime-list"))) (valueHash (get (get modules :value) :value_hash))
             (fromList (get (get modules "persistent-list") :persistent_list_from_array))
             (portable (funcall fromList (js-array 1 "two" (funcall fromList (js-array 3 4)))))
             (runtime (funcall runtimeList.persistentList 1 "two" (funcall runtimeList.persistentList 3 4))))
        (be (funcall runtimeValue.hashValue runtime) (valueHash portable)))) 30000)
  (test "Eliscript-authored value semantics preserve generated cross-family invariants"
    (async ()
      (let* ((modules (await (generatedModules "generated"))) (valueModule (get modules :value))
             (valueEqual (get valueModule :value_equal_QMARK_)) (valueHash (get valueModule :value_hash))
             (valueMapFromEntries (get valueModule :value_map_from_entries)) (valueSetFromArray (get valueModule :value_set_from_array))
             (persistentListFromArray (get (get modules "persistent-list") :persistent_list_from_array))
             (persistentVectorFromArray (get (get modules "persistent-vector") :persistent_vector_from_array))
             (random (js-object :value 1447119921)) (step 0))
        (while (< step 2000)
          (let* ((id (% (nextRandom random) 10000)) (number (- (% (nextRandom random) 20000) 10000))
                 (scalar (if (= (% step 7) 0) globalThis.Number.NaN (/ number 10)))
                 (nestedLeft (persistentVectorFromArray (js-array id (str "key-" id) scalar)))
                 (nestedRight (persistentVectorFromArray (js-array id (str "key-" id) scalar)))
                 (vectorLeft (persistentVectorFromArray (js-array nil (if (= (% step 5) 0) undefined false) nestedLeft)))
                 (vectorRight (persistentVectorFromArray (js-array nil (if (= (% step 5) 0) undefined false) nestedRight)))
                 (listLeft (persistentListFromArray (js-array id scalar nestedLeft))) (listRight (persistentListFromArray (js-array id scalar nestedRight)))
                 (mapLeft (valueMapFromEntries (js-array (js-array nestedLeft listLeft) (js-array "id" id))))
                 (mapRight (valueMapFromEntries (js-array (js-array "id" id) (js-array nestedRight listRight))))
                 (setLeft (valueSetFromArray (js-array nestedLeft (str "id-" id) scalar)))
                 (setRight (valueSetFromArray (js-array scalar (str "id-" id) nestedRight)))
                 (pairs (js-array (js-array nestedLeft nestedRight) (js-array vectorLeft vectorRight) (js-array listLeft listRight) (js-array mapLeft mapRight) (js-array setLeft setRight))) (index 0))
            (while (< index (js-length pairs))
              (let* ((pair (aref pairs index)) (left (aref pair 0)) (right (aref pair 1)))
                (be (valueEqual left right) t) (be (valueHash left) (valueHash right))) (setq index (1+ index)))
            (be (valueEqual vectorLeft listLeft) false)) (setq step (1+ step))))) 60000)
  (test "Eliscript-authored value hashing traverses one million persistent values"
    (async ()
      (let* ((modules (await (generatedModules "million"))) (valueHash (get (get modules :value) :value_hash))
             (vectorModule (get modules "persistent-vector")) (vector (funcall (get vectorModule :empty_persistent_vector))) (value 0))
        (while (< value 1000000) (setq vector (funcall (get vectorModule :persistent_vector_conj) vector value) value (1+ value)))
        (let* ((hash (valueHash vector)) (updated (funcall (get vectorModule :persistent_vector_assoc) vector 500000 -1)))
          (be (funcall (get vectorModule :persistent_vector_count) vector) 1000000)
          (be (funcall (get vectorModule :persistent_vector_nth) vector 500000 "missing") 500000)
          (be (funcall (get vectorModule :persistent_vector_nth) updated 500000 "missing") -1)
          (be (Number/isInteger hash) t) (js-call (expect hash) :toBeGreaterThanOrEqual 0) (js-call (expect hash) :toBeLessThanOrEqual 4294967295)
          (be (valueHash vector) hash) (js-call (get (expect (valueHash updated)) :not) :toBe hash)))) 60000))
