(module tests.compiler-response-events-test-ground
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile open mkdir)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "node:process" :default process)
  (import "../tools/backends/compiler-session.mjs" createCompilerSession decodeCompilerSourceAsset encodeCompilerIR requestCompilerBuildProduct isOwnedCompilerBuildProduct)
  (import "../tools/backends/compiler-build.mjs" buildIndependentCompiler decodeCompilerBinary)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../tools/backends/compiler-bootstrap.mjs" openCompilerArtifact)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/response-events-contract.mjs" responseMode graphResponseMode packet graphPacket fakeDriver collectResponseEvents reconstructBatches getters eventList sameError diagnosticCode)
  (import "./helpers/response-events-private.mjs" ownedNormalizerUnit)
  (import "./helpers/response-product-contract.mjs" :as productContract)
  (defconst load (js* "(specifier) => import(specifier)"))
  (defconst instance-of (js* "(value, constructor) => value instanceof constructor"))
  (defconst type-of (js* "(value) => typeof value"))
  (defconst root (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defun copy (value &rest records) (funcall (js* "(base, records) => Object.assign(base, ...records)") (Object/assign (js-object) value) records))
  (defvar directory undefined) (defvar artifact undefined) (defvar serializer undefined)
  (beforeAll (async ()
    (let ((started (Date/now)))
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-response-events-"))))
      (try
        (let* ((remaining (- 120000 (- (Date/now) started)))
          (args (js-call (if (get (get process :versions) :bun) (js-array "--smol") (js-array)) :concat (js-array (fileURLToPath (new globalThis.URL "./fixtures/response-events-setup-host.mjs" (js* "import.meta.url"))) directory)))
          (child undefined))
          (assert (> remaining 0) "the original response fixture setup deadline must remain available")
          (setq child (spawnSync (get process :execPath) args (js-object :cwd (js-call process :cwd) :encoding "utf8" :timeout remaining :killSignal "SIGKILL" :maxBuffer 65536 :stdio (js-array "ignore" "pipe" "inherit"))))
          (js-call assert :equal (get child :error) undefined "owned response fixture child") (js-call assert :equal (get child :signal) nil "owned response fixture child signal")
          (js-call assert :equal (get child :status) 0 "owned response fixture child exit; see inherited stderr")
          (let ((result (JSON/parse (js-call (get child :stdout) :trim))))
            (js-call assert :deepEqual (Object/keys result) (js-array "host" "metadataPath")) (js-call assert :equal (get result :host) "javascript")
            (js-call assert :equal (get result :metadataPath) (resolve directory "compiler-artifact.json"))
            (let ((metadata (await (readCompilerMetadata (get result :metadataPath)))))
              (js-call assert :equal (get metadata :host) "javascript")
              (setq artifact (copy metadata (js-object :directory directory :metadataPath (get result :metadataPath) :path (resolve directory (get metadata :path)) :runtimePath (resolve directory (get metadata :runtimePath))
                :load (lambda () (funcall load (get (pathToFileURL (resolve directory (get metadata :path))) :href)))))))
            (assert (<= (- (Date/now) started) 120000) "the original complete response fixture deadline remains 120 seconds")))
        (catch error (try (await (rm directory (js-object :recursive t :force t))) (setq directory undefined) (catch cleanup nil)) (throw error))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defasync serializerUnit ()
    (if serializer serializer (progn (setq serializer (await (funcall load (get (pathToFileURL (resolve (get artifact :directory) "host/response-events-serializer-unit.mjs")) :href)))) serializer)))

  (defasync producerGraph () (await (js-call productContract :producerGraph artifact)))
  (defasync observedProducer () (await (js-call productContract :observedProducer artifact)))
  (defun nativeProductDirectory (ground) (js-call productContract :nativeProductDirectory directory ground))
  (defasync withOwnedProductCleanup (paths operation) (await (js-call productContract :withOwnedProductCleanup directory paths operation)))
  (defun fixturePath (name) (fileURLToPath (new globalThis.URL (str "./fixtures/" name ".mjs") (js* "import.meta.url"))))
  (defun runOwnedProductChild (name args started label &rest __host_forwarded_arguments_1)
    (let* ((maxBuffer (aref __host_forwarded_arguments_1 0)))
    (when (nullish? maxBuffer) (setq maxBuffer 65536))
    (let* ((remaining (- 120000 (- (Date/now) started)))
      (arguments (js-call (if (get (get process :versions) :bun) (js-array "--smol") (js-array)) :concat (js-array (fixturePath name)) args)) (child undefined))
      (assert (> remaining 0) (str label ": the original complete product deadline must remain available"))
      (setq child (spawnSync (get process :execPath) arguments (js-object :cwd (js-call process :cwd) :encoding "utf8" :timeout remaining :killSignal "SIGKILL" :maxBuffer maxBuffer :stdio (js-array "ignore" "pipe" "inherit"))))
      (js-call assert :equal (get child :error) undefined (str label ": owned child error")) (js-call assert :equal (get child :signal) nil (str label ": owned child signal"))
      (js-call assert :equal (get child :status) 0 (str label ": owned child exit; see inherited stderr")) (JSON/parse (js-call (get child :stdout) :trim)))))
  (defasync negotiatedProductInChild (ground nativeTarget started)
    (when (and (not (nullish? globalThis.Bun)) (get globalThis.Bun :gc)) (js-call globalThis.Bun :gc t))
    (let* ((mode (if (= ground false) "modern" (if (= ground t) "ground" ground))) (productDirectory (nativeProductDirectory ground)) (cleanupPaths (js-array productDirectory)))
      (when (= ground t) (js-call cleanupPaths :push (resolve directory "ordinary-javascript-product") (resolve directory "ordinary-wasm-product")))
      (await (withOwnedProductCleanup cleanupPaths (async ()
        (let ((result (runOwnedProductChild "response-negotiation-host" (js-array (get artifact :metadataPath) (JSON/stringify ground) nativeTarget) started (str "owned producer " mode) 262144)))
          (js-call assert :equal (get result :ground) ground (str "owned producer " mode " protocol identity"))
          (js-call assert :equal (get result :nativeTarget) nativeTarget (str "owned producer " mode " native target"))
          (js-call assert :equal (get result :path) (resolve productDirectory (if (= nativeTarget "arm64-linux") "compiler.so" "compiler.dylib")) (str "owned producer " mode " exact owned product path"))
          (let ((bytes (new globalThis.Uint8Array (await (readFile (get result :path))))))
            (js-call assert :equal (get bytes :byteLength) (get result :byteLength) (str "owned producer " mode " emitted byte length")) bytes)))))))
  (defasync childOnlyBinaryNegotiation ()
    (let* ((started (Date/now)) (nativeTarget (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos"))
      (modernBytes (await (negotiatedProductInChild false nativeTarget started)))
      (eventsBytes (await (negotiatedProductInChild "events-only" nativeTarget started))))
      (js-call assert :deepEqual eventsBytes modernBytes "events-only producers keep the exact native image")
      (js-call assert :deepEqual (await (negotiatedProductInChild "graph-only" nativeTarget started)) modernBytes "graph-only producers keep the exact native image")
      (js-call assert :deepEqual (await (negotiatedProductInChild t nativeTarget started)) modernBytes "negotiation does not change a single native product byte")))

  (defasync childOnlyOwnedWasmProducts ()
    (let* ((started (Date/now)) (input (resolve directory "owned-wasm-child-input.json"))
      (run (async (stage reference label)
        (await (writeFile input (encodeCompilerIR reference)))
        (runOwnedProductChild "response-owned-wasm-host" (js-array (get artifact :metadataPath) stage input) started label))))
      (await (withOwnedProductCleanup (js-array (resolve directory "owned-debug-wasm-product") (resolve directory "owned-debug-public-writer.json") input) (async ()
        (let* ((expected (await (funcall run "snapshot" nil "owned WASM snapshot"))) (built undefined))
          (js-call assert :equal (get expected :host) "wasm") (js-call assert :equal (get expected :complete) t)
          (setq built (await (funcall run "build" expected "owned WASM build"))) (js-call assert :equal (get built :host) "wasm") (js-call assert :equal (get built :complete) t)
          (js-call assert :deepEqual (await (funcall run "debug" (copy built (js-object :debugDigest (get expected :debugDigest))) "owned WASM complete debug files")) (js-object :host "wasm" :complete t))))))))
  (defasync childOnlyOwnedNativeProducts ()
    (let* ((started (Date/now)) (input (resolve directory "owned-native-child-input.json"))
      (run (async (stage reference label)
        (await (writeFile input (encodeCompilerIR reference)))
        (runOwnedProductChild "response-owned-native-host" (js-array (get artifact :metadataPath) stage input) started label))))
      (await (withOwnedProductCleanup (js-array (resolve directory "wire-native-debug-product") (resolve directory "owned-native-debug-product") input) (async ()
        (let ((reference (await (funcall run "reference" nil "real native wire reference"))))
          (js-call assert :deepEqual (await (funcall run "owned" reference "real native owned product")) (js-object :host "native" :complete t))))))))

  (test "literal cache preserves exact source filenames ordering revisions and atomic recovery across project reuse" (async ()
    (let* ((compiler (await (js-call artifact :load))) (state (js-call compiler :compiler_session_new))
      (send (lambda (value) (JSON/parse (js-call compiler :compiler_session_request state (JSON/stringify value)))))
      (runtime (js-object :operation "runtime" :source "(defun memory-probe () 0) (export memory-probe)" :filename "memory.eli"))
      (libraries (js-array (js-object :id "one.mjs" :filename "one.eli" :source "; 中文😀\ud800\n(defun one () -0.0) (export one)")
        (js-object :id "two.mjs" :filename "two.eli" :source "(defun two () 2) (export two)")))
      (project (js-object :operation "project" :target "javascript" :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :filename "entry.eli" :source "(defun answer () 42) (export answer)")))))
      (try
        (let* ((first (funcall send (copy runtime (js-object :literalSources libraries))))
          (one (get (js-call (get state :literalCache) :get "one.mjs") :program)) (two (get (js-call (get state :literalCache) :get "two.mjs") :program))
          (originalCache (get state :literalCache)) (originalModules (get state :literalModules))
          (oneEntry (js-call originalCache :get "one.mjs")) (twoEntry (js-call originalCache :get "two.mjs"))
          (originalEntries (js-array (globalThis.structuredClone oneEntry) (globalThis.structuredClone twoEntry)))
          (originalIR (funcall send (js-object :operation "cached-ir" :kind "literal" :id "one.mjs" :revision (get first :literalRevision))))
          (initialProject (funcall send project))
          (repeated (funcall send (copy runtime (js-object :literalSources (js-call libraries :map (lambda (value) (copy value))))))))
          (js-call assert :equal (get repeated :revision) (get first :revision)) (js-call assert :equal (get repeated :literalRevision) (get first :literalRevision))
          (js-call assert :strictEqual (get state :literalCache) originalCache "a whole-graph hit retains the existing cache")
          (js-call assert :strictEqual (get state :literalModules) originalModules "a hit does not build a second module list")
          (js-call assert :equal (get (funcall send project) :revision) (get initialProject :revision))
          (js-call assert :equal (get (js-call (get state :literalCache) :get "one.mjs") :program) one) (js-call assert :equal (get (js-call (get state :literalCache) :get "two.mjs") :program) two)
          (js-call assert :deepEqual (funcall send (js-object :operation "cached-ir" :kind "literal" :id "one.mjs" :revision (get first :literalRevision))) originalIR)
          (let* ((reversed (funcall send (copy runtime (js-object :literalSources (js-call (js-call libraries :slice) :reverse))))) (reorderedProject undefined))
            (js-call assert :equal (get reversed :literalRevision) (+ (get first :literalRevision) 1))
            (js-call assert :deepEqual (js-call (get state :literalModules) :map (lambda (value) (get value :id))) (js-array "two.mjs" "one.mjs"))
            (js-call assert :notStrictEqual (get state :literalCache) originalCache "a changed graph owns a private replacement transaction")
            (js-call assert :strictEqual (js-call (get state :literalCache) :get "one.mjs") oneEntry "unchanged immutable entries need no copy")
            (js-call assert :strictEqual (js-call (get state :literalCache) :get "two.mjs") twoEntry) (js-call assert :deepEqual (js-array oneEntry twoEntry) originalEntries)
            (js-call assert :equal (get (js-call (get state :literalCache) :get "one.mjs") :program) one) (js-call assert :equal (get (js-call (get state :literalCache) :get "two.mjs") :program) two)
            (setq reorderedProject (funcall send project)) (js-call assert :equal (get reorderedProject :revision) (+ (get initialProject :revision) 1)) (js-call assert :equal (get (funcall send project) :revision) (get reorderedProject :revision))
            (js-call assert :throws (lambda () (funcall send (js-object :operation "cached-ir" :kind "literal" :id "one.mjs" :revision (get first :literalRevision)))) (lambda (error) (= (diagnosticCode error) "ELI-H0001")))
            (js-call assert :throws (lambda () (funcall send (copy project (js-object :entry "missing.mjs" :literalSources (js-array (copy (aref libraries 0) (js-object :filename "unpublished.eli"))))))) (lambda (error) (= (diagnosticCode error) "ELI-H0001")))
            (js-call assert :equal (get state :literalRevision) (get reversed :literalRevision))
            (js-call assert :deepEqual (js-call (get state :literalModules) :map (lambda (value) (get value :id))) (js-array "two.mjs" "one.mjs"))
            (js-call assert :equal (get (js-call (get state :literalCache) :get "one.mjs") :program) one) (js-call assert :equal (get (js-call (get state :literalCache) :get "two.mjs") :program) two)
            (js-call assert :equal (get (funcall send project) :revision) (get reorderedProject :revision))
            (let ((invalid (js-array (copy (aref libraries 0) (js-object :source "(defun broken (")) (aref libraries 1))))
              (js-call assert :throws (lambda () (funcall send (copy runtime (js-object :literalSources invalid))))))
            (js-call assert :equal (get state :literalRevision) (get reversed :literalRevision)) (js-call assert :equal (get (js-call (get state :literalCache) :get "one.mjs") :program) one)
            (js-call assert :equal (get (funcall send project) :revision) (get reorderedProject :revision))
            (let ((published (js-object :cache (get state :literalCache) :modules (get state :literalModules) :sources (get state :literalSources) :key (get state :literalKey) :runtime (get state :runtime))))
              (let* ((__eli_iteration_1_sequence (js-array (copy runtime (js-object :literalSources (js-array (copy (aref libraries 0) (js-object :source "(defun one () 9) (export one)")) (copy (aref libraries 1) (js-object :source "(defun broken (")))))
                (copy runtime (js-object :source "(defun broken (" :literalSources libraries))))
       (__eli_iteration_1_iterator (let ((result (Reflect/apply (get __eli_iteration_1_sequence Symbol.iterator) __eli_iteration_1_sequence (js-array)))) (unless (and (not (nullish? result)) (= (funcall globalThis.Object result) result)) (throw (new globalThis.TypeError "iterator must return an object"))) result))
       (__eli_iteration_1_next (get __eli_iteration_1_iterator :next)) (__eli_iteration_1_step undefined)
       (__eli_iteration_1_active false) (__eli_iteration_1_done false) (__eli_iteration_1_failed false))
  (try
    (while (not __eli_iteration_1_done)
      (setq __eli_iteration_1_active false)
      (setq __eli_iteration_1_step (Reflect/apply __eli_iteration_1_next __eli_iteration_1_iterator (js-array)))
      (unless (and (not (nullish? __eli_iteration_1_step)) (= (funcall globalThis.Object __eli_iteration_1_step) __eli_iteration_1_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_1_step :done))
        (setq __eli_iteration_1_done t)
        (let ((replacement (get __eli_iteration_1_step :value)))
          (setq __eli_iteration_1_active t)
          (js-call assert :throws (lambda () (funcall send replacement)))
(js-call assert :strictEqual (get state :literalCache) (get published :cache))
(js-call assert :strictEqual (get state :literalModules) (get published :modules))
(js-call assert :strictEqual (get state :literalSources) (get published :sources))
(js-call assert :strictEqual (get state :runtime) (get published :runtime))
(js-call assert :equal (get state :literalKey) (get published :key))
(js-call assert :equal (get state :literalRevision) (get reversed :literalRevision))
(js-call assert :deepEqual (js-array oneEntry twoEntry) originalEntries)
(js-call assert :equal (get (funcall send project) :revision) (get reorderedProject :revision)))))
    nil
    (catch __eli_iteration_1_error (setq __eli_iteration_1_failed t) (throw __eli_iteration_1_error))
    (finally
      (when (and __eli_iteration_1_active (not __eli_iteration_1_done))
        (try
          (let ((__eli_iteration_1_return (get __eli_iteration_1_iterator :return)))
            (unless (nullish? __eli_iteration_1_return) (Reflect/apply __eli_iteration_1_return __eli_iteration_1_iterator (js-array))))
          (catch __eli_iteration_1_close_error (unless __eli_iteration_1_failed (throw __eli_iteration_1_close_error))))))))
              (let ((omitted (funcall send runtime)))
                (js-call assert :equal (get omitted :revision) (get reversed :revision)) (js-call assert :equal (get omitted :literalRevision) (get reversed :literalRevision))
                (js-call assert :strictEqual (get state :literalCache) (get published :cache)) (js-call assert :strictEqual (get state :literalModules) (get published :modules))))
            (let ((renamed (funcall send (copy runtime (js-object :literalSources (js-array (copy (aref libraries 0) (js-object :filename "renamed😀.eli")) (aref libraries 1)))))))
              (js-call assert :equal (get renamed :literalRevision) (+ (get reversed :literalRevision) 1))
              (js-call assert :notEqual (get (js-call (get state :literalCache) :get "one.mjs") :program) one) (js-call assert :equal (get (js-call (get state :literalCache) :get "two.mjs") :program) two)
              (js-call assert :equal (get (funcall send (js-object :operation "cached-ir" :kind "literal" :id "one.mjs" :revision (get renamed :literalRevision))) :filename) "renamed😀.eli")
              (let* ((edited (funcall send (copy runtime (js-object :literalSources (js-array (copy (aref libraries 0) (js-object :source (js-call (get (aref libraries 0) :source) :replace "-0.0" "3"))))))))
                (empty undefined))
                (js-call assert :equal (get edited :literalRevision) (+ (get renamed :literalRevision) 1)) (js-call assert :deepEqual (js-call (get state :literalModules) :map (lambda (value) (get value :id))) (js-array "one.mjs"))
                (js-call assert :equal (js-call (get state :literalCache) :has "two.mjs") false)
                (setq empty (funcall send (copy runtime (js-object :literalSources (js-array)))))
                (js-call assert :equal (Object/hasOwn empty "literalRevision") false) (js-call assert :equal (get state :literalRevision) (+ (get edited :literalRevision) 1)) (js-call assert :equal (get (get state :literalCache) :size) 0)
                (js-call assert :equal (Object/hasOwn (funcall send (copy runtime (js-object :literalSources (js-array)))) "literalRevision") false)
                (js-call assert :equal (get state :literalRevision) (+ (get edited :literalRevision) 1))))))
        (finally (js-call compiler :compiler_session_close state))))) 30000)

  ; Child-only complete products execute before this VM imports the compiler.
  (test "independent binary builds negotiate actual event responses while ground and JavaScript producers retain their original mode" childOnlyBinaryNegotiation 120000)
  (test "authenticated JS artifact owned WASM projects retain complete bytes debug files and public cache isolation" childOnlyOwnedWasmProducts 120000)
  (test "real owned native builds preserve complete wire metadata identities cache isolation and native execution" childOnlyOwnedNativeProducts 120000)

  (test "declared string events bound UTF16 values and retain complete snapshot getters and graph identities" (async ()
    (let* ((unit (await (serializerUnit))) (text (str (js-call "x" :repeat 8191) "😀\ud800\udfff" (js-call "\"\\\u0000\r\n中" :repeat 12000))))
