      (unless (and (not (nullish? __eli_iteration_2_step)) (= (funcall globalThis.Object __eli_iteration_2_step) __eli_iteration_2_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_2_step :done))
        (setq __eli_iteration_2_done t)
        (let ((mode (get __eli_iteration_2_step :value)))
          (setq __eli_iteration_2_active t)
          (let* ((log (js-array)) (shared (js-object :zero (js* "-0")))
          (value undefined)
          (batches undefined) (events undefined))
          ; Preserve the original getter traversal insertion order.
          (setq value (getters (js-object) (js-array (js-array "ir" (lambda () (js-call log :push "ir") text))
            (js-array "canonicalIR" (lambda () (js-call log :push "canonicalIR") (str "\udfff" text "😀"))))))
          (Object/assign value (js-object :empty "" :first shared :second shared))
          (setq batches (collectResponseEvents unit value mode t)) (setq events (eventList batches))
          (js-call assert :deepEqual log (js-array "ir" "canonicalIR")) (assert (> (js-length batches) 2))
          (js-call assert :deepEqual (js-call (js-call events :filter (lambda (event) (= (aref event 0) "string"))) :map (lambda (event) (aref event 1))) (js-array (js-length text) (+ (js-length text) 3)))
