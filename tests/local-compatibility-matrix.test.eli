(module tests.local-compatibility-matrix.test
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile mkdtemp mkdir writeFile rm)
  (import "node:os" tmpdir)
  (import "node:path" :default path)
  (import "node:url" fileURLToPath)
  (import "bun:test" beforeAll expect test)
  (import "../tools/compatibility/matrix.mjs" checkLocalMatrixEvidence commandEnvironment currentCell expectedMatrixCells LocalCompatibilityMatrixError requiredMatrixCells validateLocalMatrixReport)
  (defconst ROOT (js-call path :resolve (js-call path :dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defun sha (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defconst EMPTY_SHA256 (sha ""))
  (defvar matrixBytes undefined) (defvar makefile undefined) (defvar matrix undefined) (defvar matrixSha256 undefined)
  (defvar validationOptions undefined)
  (defconst deferredEnvironment (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))
  (defun matches (a b) (js-call (expect a) :toMatchObject b))
  (defun contains (a b) (js-call (expect a) :toContain b))
  (defun rx (pattern) (new globalThis.RegExp pattern "u"))
  (beforeAll (async ()
    (setq matrixBytes (await (readFile (js-call path :join ROOT "contracts/compatibility-matrix.json")))
          makefile (await (readFile (js-call path :join ROOT "Makefile") "utf8"))
          matrix (JSON/parse (js-call matrixBytes :toString "utf8")) matrixSha256 (sha matrixBytes)
          validationOptions (js-object :root ROOT :matrix matrix :matrixSha256 matrixSha256
            :resolveTree (async () (js-call "2" :repeat 40)) :resolveCodeIdentity (async () (js-call "3" :repeat 64))))))
  (defun report (&rest __host_default_arguments_1)
    (let* ((cell (aref __host_default_arguments_1 0)))
    (when (= cell undefined) (setq cell (aref (expectedMatrixCells matrix) 0)))
    (let ((commands (js-call (get matrix :commands) :map (lambda (command)
      (js-object :id (js-call (js-call command :replaceAll (new globalThis.RegExp "[^a-z0-9]+" "giu") "-") :replaceAll (new globalThis.RegExp "^-|-$" "gu") "")
        :command command :timeoutMs (get (get (get matrix :localEvidence) :timeoutsMs) command) :status "pass" :exitCode 0 :timedOut false :durationMs 1
        :stdoutSha256 EMPTY_SHA256 :stderrSha256 EMPTY_SHA256 :summary "passed")))))
      (js-object :schemaVersion 1 :format "eliscript-local-compatibility-cell" :version 1 :generatedAt "2026-09-09T00:00:00.000Z" :matrixSha256 matrixSha256
        :source (js-object :commit (js-call "1" :repeat 40) :tree (js-call "2" :repeat 40) :cleanBefore t :cleanAfter t)
        :execution (js-object :provider "local" :cell (get cell :id)) :cell cell
        :environment (js-object :provider "local" :operatingSystem (get cell :operatingSystem) :operatingSystemRelease "test" :architecture (get cell :architecture)
          :emacsVersion (get cell :emacsVersion) :bunVersion (get (get matrix :javascriptHost) :version) :nodeVersion (get (get (get matrix :localEvidence) :nodeHost) :version))
        :commands commands :summary (js-object :required (get commands :length) :passed (get commands :length) :failed 0 :notRun 0 :complete t)))))
  (defun git (&rest args)
    (let ((child (Bun/spawnSync (js-call (js-array "git") :concat args) (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))))
      (be (get child :exitCode) 0) (Buffer/from (get child :stdout))))
  (defasync historicalFixture (run)
    (let ((directory (await (mkdtemp (js-call path :join (tmpdir) "eliscript-matrix-history-")))))
      (try
        (await (writeFile (js-call path :join directory ".git") (str "gitdir: " (js-call (js-call (git "rev-parse" "--absolute-git-dir") :toString) :trim) "\n")))
        (let* ((filename "acceptance/matrix/macos-arm64-emacs-29.4.json") (bytes (await (readFile (js-call path :join ROOT filename))))
               (value (JSON/parse bytes)) (oldBytes (git "show" (str (get (get value :source) :commit) ":contracts/compatibility-matrix.json")))
               (measured (JSON/parse oldBytes)) (current (Object/assign (js-object) measured (js-object :performanceAcceptance "deferred")))
               (save (async (&rest __host_default_arguments_2)
    (let* ((contract (aref __host_default_arguments_2 0)) (reportBytes (aref __host_default_arguments_2 1)))
                 (when (= contract undefined) (setq contract current)) (when (= reportBytes undefined) (setq reportBytes bytes))
                 (await (mkdir (js-call path :join directory "contracts") (js-object :recursive t)))
                 (await (mkdir (js-call path :join directory "acceptance/matrix") (js-object :recursive t)))
                 (await (writeFile (js-call path :join directory "contracts/compatibility-matrix.json") (JSON/stringify contract)))
                 (await (writeFile (js-call path :join directory filename) reportBytes))))))
          (be (sha oldBytes) (get value :matrixSha256)) (await (save))
          (await (run (js-object :directory directory :filename filename :bytes bytes :value value :measured measured :current current :save save :git git)))
          (same (await (readFile (js-call path :join ROOT filename))) bytes))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defun historicalOptions (directory) (js-object :root directory :env deferredEnvironment))
  (defasync historicalReject (value directory pattern)
    (await (js-call (get (expect (validateLocalMatrixReport value (historicalOptions directory))) :rejects) :toThrow (rx pattern))))

  (defun linuxIds () (js-array "linux-x64-emacs-29.4" "linux-x64-emacs-30.2" "linux-arm64-emacs-29.4" "linux-arm64-emacs-30.2"))
  (defun expectedCells ()
    (let ((result (js-array)))
      (js-call (js-array (js-array "linux" "x64") (js-array "linux" "arm64") (js-array "macos" "arm64")) :forEach (lambda (system)
        (js-call (js-array "29.4" "30.2") :forEach (lambda (version)
          (js-call result :push (js-object :id (str (aref system 0) "-" (aref system 1) "-emacs-" version)
            :operatingSystem (aref system 0) :architecture (aref system 1) :emacsVersion version))))))
      result))
  (test "matrix command environment breaks retained-evidence recursion" (lambda ()
    (let ((binaries (Object/fromEntries (js-call (js-array "bun" "node" "emacs") :map (lambda (name) (js-array name (js-call path :resolve ROOT "test-binaries" name)))))))
      (matches (commandEnvironment (js-object :bun (get binaries :bun) :node (get binaries :node) :emacs (get binaries :emacs)))
        (js-object :BUN (get binaries :bun) :NODE (get binaries :node) :EMACS (get binaries :emacs) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE "1"))
      (contains makefile "ifneq ($(ELISCRIPT_SKIP_RETAINED_ACCEPTANCE),1)\n\t$(SUITE_STEP) test check-contracts/acceptance-m13-01 \"\" -- $(BUN) tools/acceptance/check.mjs")
      (js-call (expect makefile) :toMatch (rx "ifneq \\(\\$\\(ELISCRIPT_SKIP_RETAINED_ACCEPTANCE\\),1\\)[\\s\\S]*?tools/compatibility/matrix\\.mjs --verify-all\\nendif"))
      (js-call (expect (js-call makefile :match (new globalThis.RegExp "tools/compatibility/matrix\\.mjs --verify-all" "gu"))) :toHaveLength 1))))
  (test "local compatibility evidence derives all real machine cells" (lambda ()
    (same (expectedMatrixCells matrix) (expectedCells)) (same (requiredMatrixCells matrix) (js-call (expectedCells) :slice 4))))
  (test "actual Linux ARM environments select their machine cell without duplicating the architecture in its id" (lambda ()
    (js-call (expectedMatrixCells matrix) :forEach (lambda (cell)
      (same (currentCell matrix (js-object :operatingSystem (get cell :operatingSystem) :architecture (get cell :architecture) :emacsVersion (get cell :emacsVersion))) cell)))
    (js-call (expect (lambda () (currentCell matrix (js-object :operatingSystem "linux-arm64" :architecture "arm64" :emacsVersion "29.4")))) :toThrow (rx "not a supported matrix system"))))
  (test "one required local report remains an explicitly incomplete acceptance matrix" (async ()
    (let ((value (report (aref (requiredMatrixCells matrix) 0))))
      (same (await (validateLocalMatrixReport value validationOptions)) (js-object :cell (get value :cell) :source (get value :source) :commands 3))
      (same (await (checkLocalMatrixEvidence (Object/assign (js-object) validationOptions (js-object :reports (js-array value) :sourceMatches (async () t)))))
        (js-object :schemaVersion 1 :targeted 6 :required 2 :retained 1 :completed 1 :missing (js-array "macos-arm64-emacs-30.2")
          :optionalMissing (linuxIds) :stale (js-array) :currentSource t :complete false :sourceIdentity (js-call "3" :repeat 64))))))
  (test "historical reports do not count for changed source" (async ()
    (let ((value (report (aref (requiredMatrixCells matrix) 0))))
      (matches (await (checkLocalMatrixEvidence (Object/assign (js-object) validationOptions (js-object :reports (js-array value) :sourceMatches (async () false)))))
        (js-object :targeted 6 :required 2 :retained 1 :completed 0 :stale (js-array (get (get value :cell) :id)) :currentSource false :complete false)))))
  (test "optional Linux reports are validated but do not block acceptance" (async ()
    (let* ((requiredReports (js-call (requiredMatrixCells matrix) :map (lambda (cell) (report cell)))) (optionalReport (report (aref (expectedMatrixCells matrix) 0))))
      (matches (await (checkLocalMatrixEvidence (Object/assign (js-object) validationOptions (js-object :reports (js-call requiredReports :concat (js-array optionalReport)) :sourceMatches (async () t)))))
        (js-object :targeted 6 :required 2 :retained 3 :completed 2 :missing (js-array) :optionalMissing (js-call (linuxIds) :slice 1) :complete t)))))
  (test "local matrix evidence rejects host drift and forged completion" (async ()
    (let ((value (report)))
      (put (get value :environment) :nodeVersion "99.0.0") (put (aref (get value :commands) 1) :status "fail") (put (aref (get value :commands) 1) :exitCode 1)
      (try (await (validateLocalMatrixReport value validationOptions)) (throw (new globalThis.Error "expected local matrix validation to fail"))
        (catch error
          (js-call (expect error) :toBeInstanceOf LocalCompatibilityMatrixError)
          (contains (get error :errors) "environment must match the cell and exact Bun/Node hosts")
          (contains (get error :errors) "summary must be derived from command and checkout results")
          (contains (get error :errors) (str "matrix report " (get (get value :cell) :id) " did not pass")))))))
  (test "local matrix aggregation rejects duplicate cells" (async ()
    (let ((value (report)))
      (await (js-call (get (expect (checkLocalMatrixEvidence (Object/assign (js-object) validationOptions
        (js-object :reports (js-array value (globalThis.structuredClone value)) :sourceMatches (async () t))))) :rejects) :toThrow (rx "duplicate matrix cell"))))))
  (test "local matrix aggregation rejects mixed source content" (async ()
    (let ((first (report (aref (expectedMatrixCells matrix) 0))) (second (report (aref (expectedMatrixCells matrix) 1))))
      (put (get second :source) :commit (js-call "4" :repeat 40))
      (await (js-call (get (expect (checkLocalMatrixEvidence (Object/assign (js-object) validationOptions
        (js-object :reports (js-array first second) :sourceMatches (async () t) :resolveCodeIdentity (async (commit) (js-call (if (= commit (get (get first :source) :commit)) "5" "6") :repeat 64)))))) :rejects)
        :toThrow (rx "one identical source content identity"))))))
  (test "matrix historical policy mismatch stays strict without the exact explicit environment value" (async ()
    (await (historicalFixture (async (context)
      (let ((directory (get context :directory)) (value (get context :value)))
        (let ((settings (js-array undefined "0" "true" "01")) (i 0))
          (while (< i (get settings :length))
            (await (js-call (get (expect (validateLocalMatrixReport value (js-object :root directory :env (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE (aref settings i))))) :rejects)
              :toThrow (rx "matrixSha256 must bind the current compatibility contract"))) (setq i (1+ i))))))))))
  (test "explicit deferral authenticates the original report bytes, measured contract and prior passing judgement" (async ()
    (await (historicalFixture (async (context)
      (let* ((directory (get context :directory)) (value (get context :value)) (result (await (validateLocalMatrixReport value (historicalOptions directory))))
             (aggregate (await (checkLocalMatrixEvidence (Object/assign (historicalOptions directory) (js-object :sourceMatches (async () false)))))))
        (same (get result :cell) (get value :cell))
        (matches (get result :historicalContract) (js-object :matrixSha256 (get value :matrixSha256) :sourceCommit (get (get value :source) :commit) :sourceTree (get (get value :source) :tree)
          :historicalResult "pass" :currentPerformanceAcceptance "deferred" :performanceAccepted false))
        (matches aggregate (js-object :retained 1 :completed 0 :currentSource false :complete false))
        (js-call (expect (get aggregate :historicalContracts)) :toHaveLength 1)))))))
  (test "historical matrix acceptance rejects every non-policy contract change" (async ()
    (await (historicalFixture (async (context)
      (let ((mutations (js-array
          (lambda (m) (let ((timeouts (get (get m :localEvidence) :timeoutsMs))) (put timeouts "bun run test" (1+ (get timeouts "bun run test")))))
          (lambda (m) (put (get m :javascriptHost) :version "9.9.9"))
          (lambda (m) (put (aref (get m :operatingSystems) 0) :runner "ubuntu-22.04"))
          (lambda (m) (put (aref (get m :actions) 0) :revision (js-call "f" :repeat 40)))
          (lambda (m) (put m :acceptanceOperatingSystems (js-array "linux" "macos")))
          (lambda (m) (put m :extraPolicy "invented"))
          (lambda (m) (Reflect/deleteProperty m "performanceAcceptance")))) (i 0))
        (while (< i (get mutations :length))
          (let ((changed (globalThis.structuredClone (get context :current))))
            (funcall (aref mutations i) changed) (await (funcall (get context :save) changed))
            (await (historicalReject (get context :value) (get context :directory)
              "historical matrix contract differs beyond performanceAcceptance|matrixSha256 must bind the current compatibility contract")))
          (setq i (1+ i)))))))))
  (test "adding optional ARM Linux cells preserves authentic old evidence without accepting the new machines" (async ()
    (await (historicalFixture (async (context)
      (let* ((directory (get context :directory)) (value (get context :value)) (extended (globalThis.structuredClone (get context :current)))
             (added (globalThis.structuredClone (js-call (get matrix :operatingSystems) :find (lambda (system) (= (get system :id) "linux-arm64"))))))
        (js-call (get extended :operatingSystems) :push added)
        (js-call (get extended :operatingSystems) :sort (lambda (a b) (if (< (get a :id) (get b :id)) -1 (if (> (get a :id) (get b :id)) 1 0))))
        (await (funcall (get context :save) extended))
        (let* ((authenticated (await (validateLocalMatrixReport value (historicalOptions directory))))
               (aggregate (await (checkLocalMatrixEvidence (Object/assign (historicalOptions directory) (js-object :sourceMatches (async () false)))))))
          (same (get authenticated :cell) (get value :cell))
          (be (get (get authenticated :historicalContract) :matrixSha256) (get value :matrixSha256))
          (same (get (get authenticated :historicalContract) :additionalUnmeasuredCells) (js-array "linux-arm64-emacs-29.4" "linux-arm64-emacs-30.2"))
          (matches aggregate (js-object :targeted 6 :required 2 :retained 1 :completed 0 :currentSource false :complete false :optionalMissing (linuxIds))))
        (same (await (readFile (js-call path :join directory (get context :filename)))) (get context :bytes))
        (let ((mutations (js-array
          (lambda (m) (put m :operatingSystems (js-call (get m :operatingSystems) :filter (lambda (system) (not (= (get system :id) "linux"))))))
          (lambda (m) (put (js-call (get m :operatingSystems) :find (lambda (system) (= (get system :id) "linux"))) :runner "ubuntu-22.04"))
          (lambda (m) (put (js-call (get m :operatingSystems) :find (lambda (system) (= (get system :id) "linux"))) :operatingSystem "linux"))
          (lambda (m) (put m :acceptanceOperatingSystems (js-array "linux-arm64" "macos")))
          (lambda (m) (put m :emacsVersions (js-array "29.4" "30.3")))
          (lambda (m) (let ((timeouts (get (get m :localEvidence) :timeoutsMs))) (put timeouts "bun run test" (1+ (get timeouts "bun run test"))))))) (i 0))
          (while (< i (get mutations :length))
            (let ((changed (globalThis.structuredClone extended))) (funcall (aref mutations i) changed) (await (funcall (get context :save) changed))
              (await (historicalReject value directory "historical matrix contract differs beyond performanceAcceptance|must include linux and macos")))
            (setq i (1+ i))))))))))
  (test "historical matrix acceptance rejects replaced report bytes and fabricated measured source" (async ()
    (await (historicalFixture (async (context)
      (let* ((value (get context :value)) (directory (get context :directory)) (save (get context :save)) (current (get context :current)) (forged (globalThis.structuredClone value)))
        (put forged :generatedAt "2026-01-01T00:00:00.000Z") (await (save current (JSON/stringify forged)))
        (await (historicalReject forged directory "report bytes differ from their retained Git snapshot"))
        (await (save current (Buffer/concat (js-array (get context :bytes) (Buffer/from "\n")))))
        (await (historicalReject value directory "report bytes differ from their retained Git snapshot"))
        (await (save))
        (let ((changed (globalThis.structuredClone value))) (put (get changed :source) :commit (js-call "0" :repeat 40))
          (await (historicalReject changed directory "report value differs from retained file|source commit cannot be resolved")))))))))
  (test "both real Emacs cells authenticate while retaining stale-source and incomplete-current acceptance" (async ()
    (await (historicalFixture (async (context)
      (let* ((directory (get context :directory)) (secondFile "acceptance/matrix/macos-arm64-emacs-30.2.json") (secondBytes (await (readFile (js-call path :join ROOT secondFile)))))
        (await (writeFile (js-call path :join directory secondFile) secondBytes))
        (let ((result (await (checkLocalMatrixEvidence (Object/assign (historicalOptions directory) (js-object :sourceMatches (async () false)))))))
          (matches result (js-object :retained 2 :completed 0 :missing (js-array) :currentSource false :complete false))
          (same (js-call (get result :historicalContracts) :map (lambda (item) (get item :report))) (js-array (get context :filename) secondFile))
          (be (js-call (get result :historicalContracts) :every (lambda (item) (and (= (get item :historicalResult) "pass") (= (get item :performanceAccepted) false)))) t))
        (same (await (readFile (js-call path :join directory (get context :filename)))) (get context :bytes))
        (same (await (readFile (js-call path :join ROOT secondFile))) secondBytes)))))))
  (test "explicit matrix deferral fails closed when retained Git history is absent" (async ()
    (await (historicalFixture (async (context)
      (let ((directory (get context :directory)))
        (await (rm (js-call path :join directory ".git")))
        (let ((initialized (Bun/spawnSync (js-array "git" "init" "--quiet" directory) (js-object :stdout "pipe" :stderr "pipe")))) (be (get initialized :exitCode) 0))
        (await (historicalReject (get context :value) directory "measured Git snapshot is unavailable|source commit cannot be resolved"))))))))
)
