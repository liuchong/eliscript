(module tests.persistent-queue
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/collection.mjs" :as collection)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/queue.mjs" EMPTY_QUEUE PersistentQueue isPersistentQueue persistentQueue)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (import "../runtime/testing/queue.mjs" inspectPersistentQueue persistentQueueMetrics resetPersistentQueueMetrics sharedPersistentQueueParts)
  (import "../runtime/testing/vector.mjs" persistentVectorMetrics resetPersistentVectorMetrics)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defconst HOST_FIXTURE (fileURLToPath (new globalThis.URL "./fixtures/persistent-queue-host.mjs" (js* "import.meta.url"))))
  (defconst LIBRARY_HOST_FIXTURE (fileURLToPath (new globalThis.URL "./fixtures/persistent-queue-library-host.mjs" (js* "import.meta.url"))))
  (defun host-type (value) (js* "typeof value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same-values (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (thunk expected) (js-call (expect thunk) :toThrow expected))
  (defasync runSuccessful (command)
    (let* ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT
                    :env (Object/assign (js-object) (get globalThis.process :env)
                           (js-object :EMACS (get (get globalThis.process :env) :EMACS "emacs")))
                    :stdout "pipe" :stderr "pipe")))
           (parts (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref parts 0)) (stdout (aref parts 1)) (stderr (aref parts 2)))
      (unless (= exitCode 0)
        (let ((message (js-call stderr :trim)))
          (when (= (js-length message) 0) (setq message (js-call stdout :trim)))
          (throw (new globalThis.Error (if (> (js-length message) 0) message
            (str (aref command 0) " exited with " exitCode)))))) stdout))
  (defun nextRandom (state)
    (let ((value (get state :value)))
      (setq value (bit-xor value (bit-shift-left value 13)))
      (setq value (bit-xor value (unsigned-bit-shift-right value 17)))
      (setq value (bit-xor value (bit-shift-left value 5)))
      (put state :value (uint32 value)) (get state :value)))

  (test "persistent queue preserves FIFO order and immutable front operations" (lambda ()
    (be (js-call PersistentQueue :empty) EMPTY_QUEUE) (be (js-call PersistentQueue :from EMPTY_QUEUE) EMPTY_QUEUE)
    (be (get EMPTY_QUEUE :count) 0) (be (get EMPTY_QUEUE :size) 0) (be (get EMPTY_QUEUE :isEmpty) t)
    (js-call (expect (js-call EMPTY_QUEUE :peek)) :toBeNull) (be (js-call EMPTY_QUEUE :peek "empty") "empty")
    (raises (lambda () (js-call EMPTY_QUEUE :pop)) "cannot pop an empty persistent queue")
    (raises (lambda () (new PersistentQueue)) globalThis.TypeError)
    (let* ((source (persistentQueue "a" "b" "c")) (appended (js-call source :conj "d")) (popped (js-call appended :pop)))
      (be (isPersistentQueue source) t) (be (Array/isArray source) false) (be (Object/isFrozen source) t)
      (same-values (js-call source :toArray) (js-array "a" "b" "c"))
      (same-values (js-call appended :toArray) (js-array "a" "b" "c" "d"))
      (same-values (js-call popped :toArray) (js-array "b" "c" "d"))
      (same-values (js-call source :toArray) (js-array "a" "b" "c")) (be (js-call popped :peek) "b")
      (be (js-call popped :reduce (lambda (left right) (+ left right))) "bcd")
      (be (js-call EMPTY_QUEUE :reduce (lambda (value) value) "initial") "initial")
      (raises (lambda () (js-call EMPTY_QUEUE :reduce (lambda (left right) (+ left right)))) globalThis.TypeError))))

  (test "persistent queue implements collection value and metadata protocols" (lambda ()
    (let* ((source (persistentQueue 1 (persistentQueue 2 3) 4)) (equal (persistentQueue 1 (persistentQueue 2 3) 4))
           (metadata (persistentHashMap (js-array "kind" "work"))) (annotated (withMeta source metadata)))
      (be (js-call collection :isCollection source) t) (be (js-call collection :isQueue source) t)
      (be (js-call collection :isSequential source) t) (be (js-call collection :isSequence source) false)
      (be (js-call collection :count source) 3) (be (js-call collection :peek source) 1)
      (same-values (js-call (js-call collection :conj source 5) :toArray) (js-array 1 (persistentQueue 2 3) 4 5))
      (same-values (js-call (js-call collection :pop source) :toArray) (js-array (persistentQueue 2 3) 4))
      (same-values (Array/from (js-call collection :seq source)) (js-call source :toArray))
      (be (js-call collection :reduce source (lambda (total value) (+ total (if (= (host-type value) "number") value 0))) 0) 5)
      (be (js-call collection :empty source) EMPTY_QUEUE) (be (equalValues source equal) t) (be (hashValue source) (hashValue equal))
      (be (meta annotated) metadata) (be (meta (js-call collection :conj annotated 5)) metadata)
      (be (meta (js-call collection :pop annotated)) metadata) (be (meta (js-call collection :empty annotated)) metadata)
      (be (equalValues annotated source) t))))

  (test "persistent queue promotes its rear without traversal or node allocation" (lambda ()
    (let ((source (js-call PersistentQueue :from (Array/from (js-object :length 4096) (lambda (ignored index) index)))))
      (same-values (inspectPersistentQueue source) (js-object :count 4096 :frontCount 1 :rearCount 4095))
      (resetPersistentQueueMetrics)
      (let ((appended (js-call source :conj 4096)))
        (same-values (persistentQueueMetrics) (js-object :queueAllocations 1 :frontPromotions 0 :promotedValues 0))
        (let ((sharing (sharedPersistentQueueParts source appended)))
          (be (get sharing :frontIdentity) t) (be (get sharing :sharedFrontNodes) 1)
          (js-call (expect (get sharing :sharedRearNodes)) :toBeGreaterThan 0)))
      (resetPersistentQueueMetrics) (resetPersistentVectorMetrics)
      (let ((promoted (js-call source :pop)))
        (same-values (persistentQueueMetrics) (js-object :queueAllocations 1 :frontPromotions 1 :promotedValues 4095))
        (same-values (persistentVectorMetrics) (js-object :nodeAllocations 0 :nodeVisits 0 :tailAllocations 0 :rootGrowths 0))
        (be (js-call promoted :peek) 1)
        (same-values (inspectPersistentQueue promoted) (js-object :count 4095 :frontCount 4095 :rearCount 0))
        (be (get (sharedPersistentQueueParts source promoted) :rearPromotedToFront) t)
        (resetPersistentQueueMetrics) (resetPersistentVectorMetrics)
        (let ((advanced (js-call promoted :pop)))
          (same-values (persistentQueueMetrics) (js-object :queueAllocations 1 :frontPromotions 0 :promotedValues 0))
          (same-values (persistentVectorMetrics) (js-object :nodeAllocations 0 :nodeVisits 0 :tailAllocations 0 :rootGrowths 0))
          (be (js-call advanced :peek) 2))))))

  (test "persistent queue agrees with a mutable FIFO reference model" (lambda ()
    (let ((random (js-object :value 1369907238)) (retained (js-array)) (queue EMPTY_QUEUE) (model (js-array)) (step 0))
      (while (< step 20000)
        (if (or (= (js-length model) 0) (not (= (bit-and (nextRandom random) 3) 0)))
          (let ((value (% (nextRandom random) 10000)))
            (setq queue (js-call queue :conj value)) (js-call model :push value))
          (progn (setq queue (js-call queue :pop)) (js-call model :shift)))
        (when (= (% step 997) 0) (js-call retained :push (js-array queue (js-call model :slice))))
        (be (get queue :count) (js-length model)) (be (js-call queue :peek "empty") (get model 0 "empty"))
        (setq step (1+ step)))
      (same-values (js-call queue :toArray) model)
      (js-call retained :forEach (lambda (pair) (same-values (js-call (aref pair 0) :toArray) (aref pair 1)))))))

  (test "persistent queue stays iterative at one million values" (lambda ()
    (let ((size 1000000) (queue EMPTY_QUEUE) (value 0))
      (while (< value size) (setq queue (js-call queue :conj value) value (1+ value)))
      (resetPersistentQueueMetrics)
      (let ((rotated (js-call queue :pop)))
        (be (get rotated :count) (1- size)) (be (js-call rotated :peek) 1)
        (be (js-call rotated :reduce (lambda (sum value) (+ sum value)) 0) 499999500000)
        (same-values (persistentQueueMetrics) (js-object :queueAllocations 1 :frontPromotions 1 :promotedValues (1- size)))))) 30000)

  (test "persistent queue runtime agrees under Bun and Node" (async ()
    (let ((reports (js-array)) (hosts (js-array (get globalThis.process :execPath) (get (get globalThis.process :env) :NODE_BINARY "node"))) (index 0))
      (while (< index (js-length hosts))
        (js-call reports :push (JSON/parse (await (runSuccessful (js-array (aref hosts index) HOST_FIXTURE)))))
        (setq index (1+ index)))
      (same-values (aref reports 1) (aref reports 0))
      (js-call (expect (aref reports 0)) :toMatchObject (js-object :values (js-array ":two" "3" "4")
        :count 3 :front ":two" :hash (js-call expect :any globalThis.Number) :equal t :source "host")))))

  (test "Eliscript persistent queue API compiles and runs on both hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-queue-")))) (output (resolve directory "persistent-queue.mjs")))
      (try
        (await (runSuccessful (js-array COMPILER "--source-map" "--output" output (resolve ROOT "stdlib/persistent-queue.eli"))))
        (let ((reports (js-array)) (hosts (js-array (get globalThis.process :execPath) (get (get globalThis.process :env) :NODE_BINARY "node"))) (index 0))
          (while (< index (js-length hosts))
            (js-call reports :push (JSON/parse (await (runSuccessful (js-array (aref hosts index) LIBRARY_HOST_FIXTURE output)))))
            (setq index (1+ index)))
          (same-values (aref reports 1) (aref reports 0))
          (same-values (aref reports 0) (js-object :persistent t :empty false :count 3 :front 2 :values (js-array 2 3 4) :sum 9)))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
