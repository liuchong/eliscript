(module tests.compiler-matrix-snapshot
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:url" fileURLToPath)
  (import "../tools/backends/compiler-matrix.mjs" loadCompilerMatrixCorpus loadOriginalCompilerManifests)
  (defconst sourceRoot (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (test "Given caller-owned corpus data When loading crosses I/O Then cases document and identity remain separate snapshots with exact source bytes" (async ()
    (let* ((originals (await (loadOriginalCompilerManifests (js-object :sourceRoot sourceRoot))))
           (id "snapshot-case") (coverage (Array/from (get originals :requiredCoverage)))
           (source "; \uFEFF中😀\ud800\n(defconst value -0)") (shared (js-object :value (js* "-0")))
           (input (js-object :format "eliscript-compiler-matrix-corpus" :version 1
             :manifests (Object/fromEntries (js-call (get originals :manifests) :map (lambda (item) (js-array (get item :id) (js-object :sha256 (get item :sha256) :identity (get item :identity))))))
             :coverageIds coverage :expectedIds (js-array id)
             :records (js-array (js-object :id id :kind "project" :coverage (Array/from coverage) :entry "entry.mjs"
               :modules (js-array (js-object :id "entry.mjs" :filename "snapshot.eli" :source source))
               :request (js-object :operation "project" :shared shared) :expected (js-object :value (js* "-0") :shared shared)))
             :originalGateEvidence (js-object :coverageIds (js-array) :details (js-object :value (js* "-0")))
             :missingCaseAdapters (js-array (js-object :coverageId (aref coverage 0) :reason "retained snapshot"))))
           (pending (loadCompilerMatrixCorpus (js-object :sourceRoot sourceRoot :records input))))
      (put (aref (get (aref (get input :records) 0) :modules) 0) :source "changed after dispatch") (put shared :value 1)
      (put (get (get input :originalGateEvidence) :details) :value 1) (put (aref (get input :missingCaseAdapters) 0) :reason "changed")
      (let* ((result (await pending)) (record (aref (get result :records) 0)) (document (get result :document)) (documentRecord (aref (get document :records) 0)) (identity (get result :identity)))
        (js-call assert :equal (get (aref (get record :modules) 0) :source) source)
        (js-call assert :equal (get (aref (get documentRecord :modules) 0) :source) source)
        (funcall assert (Object/is (get (get record :expected) :value) (js* "-0")))
        (funcall assert (Object/is (get (get (get record :expected) :shared) :value) (js* "-0")))
        (js-call assert :equal (get (get record :request) :shared) (get (get record :expected) :shared))
        (js-call assert :equal (get (get documentRecord :request) :shared) (get (get documentRecord :expected) :shared))
        (js-call assert :notEqual (get (get record :request) :shared) (get (get documentRecord :request) :shared))
        (funcall assert (Object/is (get (get (get identity :originalGateEvidence) :details) :value) (js* "-0")))
        (js-call assert :equal (get (aref (get identity :missingCaseAdapters) 0) :reason) "retained snapshot")
        (js-call assert :notEqual document input) (js-call assert :notEqual record documentRecord)
        (js-call assert :notEqual (get identity :originalGateEvidence) (get document :originalGateEvidence))
        (js-call assert :notEqual (get identity :missingCaseAdapters) (get document :missingCaseAdapters))
        (let* ((retained (JSON/parse (js-call (Buffer/from (get result :recordsBytes)) :toString "utf8"))) (retainedRecord (aref (get retained :records) 0)))
          (js-call assert :equal (get (aref (get retainedRecord :modules) 0) :source) source)
          (funcall assert (Object/is (get (get retainedRecord :expected) :value) (js* "-0"))))
        (put (aref (get record :modules) 0) :source "case edited")
        (put (get (get identity :originalGateEvidence) :details) :value 2)
        (put (aref (get document :missingCaseAdapters) 0) :reason "document edited")
        (js-call assert :equal (get (aref (get documentRecord :modules) 0) :source) source)
        (funcall assert (Object/is (get (get (get document :originalGateEvidence) :details) :value) (js* "-0")))
        (js-call assert :equal (get (aref (get identity :missingCaseAdapters) 0) :reason) "retained snapshot")
        (js-call assert :equal (get (aref (get (aref (get (JSON/parse (js-call (Buffer/from (get result :recordsBytes)) :toString "utf8")) :records) 0) :modules) 0) :source) source)))))
)
