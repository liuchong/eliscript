      (same (get stored :sourceIdentity) (get artifact :sourceIdentity)) (ae (Object/hasOwn stored "onPhase") false) (ae (Object/hasOwn stored "phaseObserver") false))
(let ((fresh (await (loadCompilerSources (js-object :sourceRoot root)))))
      (different (get fresh :modules) (get (aref requests 1) :modules)) (different (aref (get fresh :modules) 0) (aref (get (aref requests 1) :modules) 0))
