(module tests.compiler-artifact-archive-test-ground
  (import "bun:test" test spyOn afterAll)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:child_process" spawnSync)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm symlink access open)
  (import "node:fs/promises" :as fileIO)
  (import "node:process" :default process)
  (import "node:os" tmpdir)
  (import "node:path" resolve join dirname)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:util" isDeepStrictEqual)
  (import "../tools/backends/compiler-metadata.mjs" :as metadataCodec)
  (import "../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../tools/backends/compiler-bootstrap.mjs" archiveCompilerArtifact archiveCompilerSources readArchivedCompilerSources compilerSourceIdentity compilerFailure bootstrapCompilerChain openCompilerArtifact)
  (import "../tools/backends/compiler-build.mjs" buildIndependentCompiler independentCompilerProductIdentity loadCompilerSources)
  (import "../tools/backends/compiler-session.mjs" decodeCompilerSourceAsset encodeCompilerIR)
  (import "../tools/backends/compiler-package.mjs" packageIndependentCompiler)
  (import "./helpers/archive-record-contract.mjs" assertCompleteReferenceIR assertCompleteCompilerRecord compilerRecordMetadata storeCompilerRecord assertStoredCompilerRecord)
  (import "./helpers/archive-resource-contract.mjs" bind observeBoundedArtifactResources fixture sessionResourceFixture literalResourceFixture)
  (import "./helpers/metadata-private-units.mjs" privateSeedJavaScriptProduct closeMetadataPrivateUnits)
  (defconst root (resolve (dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defconst zero (js* "-0"))
  (defconst dynamicImport (js* "(specifier) => import(specifier)"))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defconst instanceOf (js* "(value, type) => value instanceof type"))
  (defconst receiverFunction (js* "(implementation) => function(...args) { return implementation(this, args); }"))
  (defconst decoderClass (js* "(Base, implementation) => class extends Base { decode(...args) { return implementation(args, (...values) => super.decode(...values)); } }"))
  (defun ae (a b &rest __host_forwarded_arguments_1)
    (let* ((message (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b message)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((message (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b message)))
  (defun different (a b &rest __host_forwarded_arguments_3)
    (let* ((message (aref __host_forwarded_arguments_3 0))) (js-call assert :notEqual a b message)))
  (defun sha256 (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun utf16 (source) (sha256 (Buffer/from source "utf16le")))
  (defun copy (a b) (Object/assign (js-object) a b))
  (defun getter (object key run) (Object/defineProperty object key (js-object :enumerable t :get run)))
  (defun identity (record) (js-object :id (get record :id) :filename (get record :filename) :sha256 (utf16 (get record :source))))
  (defun items (record) (get (get record :artifactIdentity) :files))
  (defun appendFile (artifact file) (bind artifact (js-call (items artifact) :concat (js-array file))))
  (defun fileIdentity (path bytes) (js-object :path path :bytes (js-length bytes) :sha256 (sha256 bytes)))
  (defun zeros (value) (assert (Object/is value zero)))
  (defasync withDirectory (prefix run)
    (let ((directory (await (mkdtemp (join (tmpdir) prefix)))))
      (try (await (funcall run directory)) (finally (await (rm directory (js-object :recursive t :force t)))))))
  (afterAll closeMetadataPrivateUnits)
  (defun sourceGraph ()
    (js-object :entry "bootstrap/compiler.mjs" :modules (js-array (js-object :id "bootstrap/compiler.mjs" :filename "compiler.eli" :source "(defun run () 42) (export run)"))
      :runtime (js-object :filename "runtime.eli" :source "(module runtime)")))
  (defun hostGraph ()
    (copy (sourceGraph) (js-object
      :hostModules (js-array (js-object :id "providers/actual.mjs" :specifier "../providers/actual.mjs" :referrer "bootstrap/compiler.mjs"
        :allowedExports (js-array "run" "value") :namespace t
        :edges (js-array (js-object :specifier "../providers/actual.mjs" :referrer "bootstrap/compiler.mjs" :allowedExports (js-array "run" "value") :namespace t))))
      ; These are actual external JS provider inputs being authenticated.
      :hostSources (js-array (js-object :id "providers/actual.mjs" :filename "does-not-exist/provider-source.mjs" :source "export const value=\"中😀\"; export function run(){return value;}\n")
        (js-object :id "providers/second.mjs" :filename "second.mjs" :source "export const second=2;\n")) :phased false)))
  (defasync defaultSourceArtifactInChild (sources directory started)
    (let* ((outputRoot (join directory "compiler")) (referenceDirectory (join directory "references"))
      (runChild (lambda (mode label)
        (let* ((remaining (- 120000 (- (Date/now) started))) (args (js-array)))
          (assert (> remaining 0) "the original complete source-assets deadline must remain available")
          (when (funcall globalThis.Boolean (get (get process :versions) :bun)) (js-call args :push "--smol"))
          (js-call args :push (fileURLToPath (new globalThis.URL "./fixtures/archive-source-assets-host.mjs" (js* "import.meta.url"))) mode outputRoot referenceDirectory)
          (let ((child (spawnSync (get process :execPath) args (js-object :cwd (js-call process :cwd) :encoding "utf8" :input (JSON/stringify sources)
            :timeout remaining :killSignal "SIGKILL" :maxBuffer 65536 :stdio (js-array "pipe" "pipe" "inherit")))))
            (ae (get child :error) undefined (str label ": child execution"))
            (ae (get child :signal) nil (str label " signal: " (get child :signal))) (ae (get child :status) 0 (str label " exit: " (get child :status) "; see inherited stderr"))
            (JSON/parse (js-call (get child :stdout) :trim)))))))
      (let ((built (funcall runChild "build" "owned complete source seed fixture")))
        (same (Object/keys built) (js-array "host" "metadataPath")) (ae (get built :host) "javascript") (ae (get built :metadataPath) (join outputRoot "compiler-artifact.json")))
      (let ((result (funcall runChild "reference" "owned complete source reference fixture")))
        (same (Object/keys result) (js-array "host" "metadataPath" "runtimeUnits" "literalUnits")) (ae (get result :host) "javascript")
        (ae (get result :metadataPath) (join outputRoot "compiler-artifact.json"))
        (assert (and (Number/isSafeInteger (get result :runtimeUnits)) (> (get result :runtimeUnits) 0)))
        (assert (Array/isArray (get result :literalUnits))) (ae (js-length (get result :literalUnits)) (js-length (get sources :literalSources)))
        (assert (js-call (get result :literalUnits) :every (lambda (units) (and (Number/isSafeInteger units) (> units 0)))))
        (let* ((metadata (await (readCompilerMetadata (get result :metadataPath)))) (literal (get metadata :literalSources)))
          (ae (get metadata :host) "javascript")
          (js-object :artifact (copy metadata (js-object :directory outputRoot :metadataPath (get result :metadataPath) :path (resolve outputRoot (get metadata :path))
            :runtimePath (resolve outputRoot (get metadata :runtimePath))
            :literalSources (if (nullish? literal) undefined (js-call literal :map (lambda (item) (copy item (js-object :path (resolve outputRoot (get item :path)))))))))
            :references (js-object :directory referenceDirectory :runtimeUnits (get result :runtimeUnits) :literalUnits (get result :literalUnits)))))))
