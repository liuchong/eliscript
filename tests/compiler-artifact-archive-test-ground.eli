      (js-call requests :push request)
      (if (= (get request :operation) "runtime")
        (progn (ae (get request :source) (get (get expected :runtime) :source)) (ae (get request :filename) (get (get expected :runtime) :filename))
          (same (get request :literalSources) (get expected :literalSources)) (js-object :ready t :revision 1))
        (progn (ae (get request :operation) "project") (same (get request :modules) (get expected :modules)) (ae (get request :entry) (get expected :entry))
          ; A constant empty-module byte fixture tests build I/O ownership, not compilation.
          (js-object :target "javascript" :revision 1 :modules (js-call (get request :modules) :map (lambda (module) (js-object :id (get module :id) :javascript "export {};\n"))))))))) (artifact (await (buildIndependentCompiler (js-object :host "javascript" :outputRoot directory :sourceRoot root :session producer :onPhase onPhase)))))

(same (js-call requests :map (lambda (request) (get request :operation))) (js-array "runtime" "project"))
