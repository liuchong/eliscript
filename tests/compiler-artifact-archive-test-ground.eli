  (test "phase observer failures preserve the original producer thrown values without starting later build phases" (async ()
(await (withDirectory "eliscript-phase-first-throw-" (async (directory)
  (let ((sources (js-object :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :filename "entry.eli" :source "(module entry)")) :runtime (js-object :filename "runtime.eli" :source "(module runtime)")))
    (observerFailure (js-object :observer t)) (reasons (js-array undefined false (js-object :original t) (new globalThis.Error "original producer"))))
    (let ((__eli_iteration_3_index 0) (__eli_iteration_3_limit (js-length reasons)))
  (while (< __eli_iteration_3_index __eli_iteration_3_limit)
    (let ((index __eli_iteration_3_index))
      (let* ((reason (aref reasons index)) (phases (js-array)) (requests (js-array)) (threw false)
        (producer (js-object :host "javascript" :request (lambda (request) (js-call requests :push request) (throw reason)))))
        (try (await (buildIndependentCompiler (js-object :host "wasm" :sources sources :session producer :outputRoot (resolve directory (funcall globalThis.String index))
          :onPhase (lambda (phase scalars) (js-call phases :push (js-object :phase phase :scalars scalars)) (throw observerFailure)))))
          (catch error (setq threw t) (js-call assert :strictEqual error reason)))
        (assert threw) (same (js-call requests :map (lambda (request) (get request :operation))) (js-array "runtime"))
        (same (js-call phases :map (lambda (record) (get record :phase))) (js-array "sources-start" "sources-complete" "runtime-start")) (assert (<= (js-length phases) 32))
        (let* ((__eli_iteration_4_sequence phases)
       (__eli_iteration_4_iterator (let ((result (Reflect/apply (get __eli_iteration_4_sequence Symbol.iterator) __eli_iteration_4_sequence (js-array)))) (unless (and (not (nullish? result)) (= (funcall globalThis.Object result) result)) (throw (new globalThis.TypeError "iterator must return an object"))) result))
       (__eli_iteration_4_next (get __eli_iteration_4_iterator :next)) (__eli_iteration_4_step undefined)
       (__eli_iteration_4_active false) (__eli_iteration_4_done false) (__eli_iteration_4_failed false))
  (try
    (while (not __eli_iteration_4_done)
      (setq __eli_iteration_4_active false)
      (setq __eli_iteration_4_step (Reflect/apply __eli_iteration_4_next __eli_iteration_4_iterator (js-array)))
      (unless (and (not (nullish? __eli_iteration_4_step)) (= (funcall globalThis.Object __eli_iteration_4_step) __eli_iteration_4_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_4_step :done))
        (setq __eli_iteration_4_done t)
        (let ((record (get __eli_iteration_4_step :value)))
          (setq __eli_iteration_4_active t)
          (assert (Object/isFrozen (get record :scalars)))
(same (get record :scalars) (js-object :host "wasm")))))
    nil
    (catch __eli_iteration_4_error (setq __eli_iteration_4_failed t) (throw __eli_iteration_4_error))
    (finally
      (when (and __eli_iteration_4_active (not __eli_iteration_4_done))
        (try
          (let ((__eli_iteration_4_return (get __eli_iteration_4_iterator :return)))
            (unless (nullish? __eli_iteration_4_return) (Reflect/apply __eli_iteration_4_return __eli_iteration_4_iterator (js-array))))
          (catch __eli_iteration_4_close_error (unless __eli_iteration_4_failed (throw __eli_iteration_4_close_error))))))))
        (assert (js-call requests :every (lambda (request) (and (not (Object/hasOwn request "onPhase")) (not (Object/hasOwn request "phaseObserver")))))))
      (setq __eli_iteration_3_index (+ index 1)))))))))))
  (test "explicit compiler source graphs keep their original getter snapshot and asynchronous caller isolation" (async ()
(await (withDirectory "eliscript-supplied-source-graph-" (async (directory)
  (let* ((reads 0) (requests 0) (original "(module original)") (runtime "(module runtime)") (literal "(module literal)") (record (js-object :id "entry.mjs" :filename "entry.eli"))
    (unused (getter record "source" (lambda () (setq reads (+ reads 1)) original)))
    (supplied (js-object :entry "entry.mjs" :modules (js-array record) :runtime (js-object :filename "runtime.eli" :source runtime)
      :literalSources (js-array (js-object :id "stdlib/literal.mjs" :filename "literal.eli" :source literal))))
    (producer (js-object :host "javascript" :request (async (request)
      (setq requests (+ requests 1))
      (if (= (get request :operation) "runtime")
        (progn (ae reads 1 "structuredClone reads the supplied source getter once") (ae (get request :source) runtime) (ae (get (aref (get request :literalSources) 0) :source) literal)
          (js-call (get supplied :modules) :splice 0 1 (js-object :id "changed.mjs" :filename "changed.eli" :source "(module changed)"))
          (put (get supplied :runtime) :source "changed") (put (aref (get supplied :literalSources) 0) :source "changed")
          (await (Promise/resolve)) (js-object :ready t :revision 1))
        (progn (ae (get request :operation) "project") (ae (get request :entry) "entry.mjs")
          (same (get request :modules) (js-array (js-object :id "entry.mjs" :filename "entry.eli" :source original)))
          (js-object :target "javascript" :revision 1 :modules (js-array (js-object :id "entry.mjs" :javascript "export {};\n"))))))))
    (artifact (await (buildIndependentCompiler (js-object :host "javascript" :outputRoot directory :sourceRoot (join directory "must-not-load") :sources supplied :session producer)))))
    (ae reads 1) (ae requests 2) (ae (get artifact :entry) "entry.mjs")
    (ae (get (aref (get (get artifact :sourceIdentity) :modules) 0) :sha256) (utf16 original))
    (ae (get (get (get artifact :sourceIdentity) :runtime) :sha256) (utf16 runtime))
    (ae (get (aref (get (get artifact :sourceIdentity) :literalSources) 0) :sha256) (utf16 literal))
    (ae (await (readFile (get artifact :path) "utf8")) "export {};\n") (ae (await (readFile (get artifact :runtimePath) "utf8")) runtime)
    (ae (get (aref (get artifact :literalSources) 0) :id) "stdlib/literal.mjs")
    (ae (await (readFile (get (aref (get artifact :literalSources) 0) :path) "utf8")) literal)
    (same (get (JSON/parse (await (readFile (join directory "compiler-artifact.json") "utf8"))) :sourceIdentity) (get artifact :sourceIdentity))))))))
  (test "built and relocated compiler source assets retain isolated surrogate code units through the actual loaders" (async ()
(await (withDirectory "eliscript-source-codeunits-" (async (directory)
  (let* ((runtime "\ufeff; original runtime \ud800😀\n(module runtime)") (literal "\ufeff; original library \udc00中\n(module library)") (entry "host/compiler-session.mjs")
    (driver (await (readFile (new globalThis.URL "./fixtures/archive-transport-driver.mjs" (js* "import.meta.url")) "utf8")))
    (sources (js-object :entry entry :modules (js-array (js-object :id entry :filename "host/compiler-session.eli" :source "(module transport)"))
      :runtime (js-object :filename "bootstrap/runtime/memory.eli" :source runtime) :literalSources (js-array (js-object :id "stdlib/bit.mjs" :filename "stdlib/bit.eli" :source literal))))
    (producer (js-object :host "javascript" :request (async (request)
      (if (= (get request :operation) "runtime") (js-object :ready t :revision 1)
        (progn (ae (get request :operation) "project") (js-object :target "javascript" :revision 1 :modules (js-array (js-object :id entry :javascript driver))))))))
    (artifact (await (buildIndependentCompiler (js-object :host "javascript" :outputRoot (join directory "artifact") :sources sources :session producer)))))
    (ae (get artifact :runtimeEncoding) "json-utf16") (assert (js-call (get artifact :runtimePath) :endsWith ".eli.json"))
    (ae (get (aref (get artifact :literalSources) 0) :encoding) "json-utf16") (assert (js-call (get (aref (get artifact :literalSources) 0) :path) :endsWith ".eli.json"))
    (ae (decodeCompilerSourceAsset (await (readFile (get artifact :runtimePath))) (get artifact :runtimeEncoding)) runtime)
    (ae (decodeCompilerSourceAsset (await (readFile (get (aref (get artifact :literalSources) 0) :path))) (get (aref (get artifact :literalSources) 0) :encoding)) literal)
    (let ((session (await (openCompilerArtifact artifact))))
      (try (let ((observed (await (js-call session :request (js-object :operation "runtime")))))
        (ae (get observed :source) runtime) (ae (get observed :filename) (get (get sources :runtime) :filename)) (same (get observed :literalSources) (get sources :literalSources)))
        (finally (await (js-call session :close)))))
    (let* ((packaged (await (packageIndependentCompiler (js-object :artifact artifact :outputRoot (join directory "package")))))
      (loader (await (funcall dynamicImport (get (pathToFileURL (join (get packaged :directory) "compiler-loader.mjs")) :href))))
      (installed (await (js-call loader :openCompilerPackage))))
      (try (await (js-call installed :loadRuntime))
        (let ((observed (await (js-call installed :request (js-object :operation "capabilities")))))
          (ae (get (get observed :runtime) :source) runtime) (same (get (get observed :runtime) :literalSources) (get sources :literalSources)))
        (ae (get (get installed :artifact) :runtimeEncoding) "json-utf16") (ae (get (aref (get (get installed :artifact) :literalSources) 0) :encoding) "json-utf16")
        (finally (await (js-call installed :close)))))))))))
  (test "complete compiler record failures remain bounded without weakening strict Unicode or numeric equality" (lambda ()
(let* ((text (js-call "private IR body 😀\ud800中" :repeat 2048))
  (expected (js-object :id "runtime" :filename "原😀\udc00.eli" :revision 1 :stage "frontend" :ir text :canonicalIR (str text "\udfff") :nested (js-object :zero zero :optional undefined)))
  (variants (js-array (copy expected (js-object :ir (str (js-call text :slice 0 -1) "文"))) (copy expected (js-object :canonicalIR (str text "\udffe")))
    (copy expected (js-object :revision "1")) (copy expected (js-object :nested (js-object :zero 0 :optional undefined)))
    (copy expected (js-object :nested (js-object :zero zero))) (copy expected (js-object :extra undefined)) (Object/assign (Object/create nil) expected))))
