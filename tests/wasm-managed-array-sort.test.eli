(module tests.wasm-managed-array-sort
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-array-sort-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string
                    (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defasync compiled (source &rest opts)
    (let* ((options (aref opts 0))
           (p (js-call (get b :compiler) :compile_ir_string
                (str "(defconst marker 1) (defun own (a i) (object-has? a i)) " source " (export own)")
                "array-sort.eli"))
           (before (JSON/stringify p))
           (js (await (funcall dynamic-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64")))))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))))
      (js-call assert :equal (JSON/stringify p) before)
      (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        (js-object :a a :js js :bytes bytes))))

  (defun box (a v)
    (cond
      ((= (value-type v) "number") (js-call a :number v))
      ((= (value-type v) "string") (js-call a :string v))
      (t v)))

  (defun array (a values)
    (let ((items (Array/from values (lambda (v i) (if (Object/hasOwn values i) (box a v) undefined))))
          (sparse (new globalThis.Array (js-length values)))
          (i 0))
      (while (< i (js-length values))
        (when (Object/hasOwn values i)
          (put sparse i (aref items i)))
        (setq i (1+ i)))
      (let ((out (js-call a :sourceArray sparse)))
        (js-call items :forEach (lambda (v) (js-call a :release v)))
        out)))

  (defun read (a v)
    (if (or (= v nil) (/= (value-type v) "object"))
      v
      (cond
        ((= (get v :kind) 4) (js-call a :readNumber v))
        ((= (get v :kind) 5) (js-call a :readString v))
        (t
         (js-call assert :equal (get v :kind) 14)
         (let ((out (new globalThis.Array (js-call a :length v)))
               (i 0))
           (while (< i (js-length out))
             (let* ((n (js-call a :number i))
                    (own (js-call a :invoke "own" (js-array v n))))
               (js-call a :release n)
               (when own
                 (let ((child (js-call a :get v i)))
                   (try (put out i (read a child))
                     (finally (js-call a :release child))))))
             (setq i (1+ i)))
           out)))))

  (defun finish (a)
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun rt-diag-p (code)
    (lambda (e) (and e (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) code))))

  (test "Given primitive values and sparse arrays, when default sort runs, then UTF16 ordering, undefined, holes and receiver identity match JS" (async ()
    (let* ((c (await (compiled "(defun f (items) (js-call items :sort)) (export f)")))
           (a (get c :a))
           (js (get c :js))
           (sparse (new globalThis.Array 8)))
      (put sparse 1 undefined)
      (put sparse 3 "2")
      (put sparse 6 "10")
      (js-call (js-array (js-array) (js-array 3 20 100 -1)
                         (js-array undefined false nil "" "😀" "\ud800" "中" globalThis.NaN globalThis.Infinity)
                         sparse)
        :forEach
        (lambda (values)
          (let* ((input (array a values))
                 (expected (js-call values :slice))
                 (out (js-call a :invoke "f" (js-array input))))
            (funcall assert (js-call a :keyEqual out input))
            (js-call assert :equal (js-call js :f expected) expected)
            (js-call assert :deepEqual (read a input) expected)
            (js-call a :release out)
            (js-call a :release input))))
      (finish a))))

  (test "Given finite numbers and comparator closures, when ascending and descending sorts run, then exact values and stable duplicates agree" (async ()
    (let* ((c (await (compiled "(defun f (items reverse) (js-call items :sort (lambda (a b) (if reverse (- b a) (- a b))))) (export f)")))
           (a (get c :a))
           (js (get c :js))
           (state 661304625)
           (k 0))
      (while (< k 64)
        (let ((values (Array/from (js-object :length 37)
                        (lambda ()
                          (setq state (uint32 (+ (Math/imul state 1664525) 1013904223)))
                          (- (% state 31) 15)))))
          (js-call values :push -0.0 0 globalThis.Number.MIN_VALUE)
          (js-call (js-array false t) :forEach
            (lambda (reverse)
              (let* ((input (array a values))
                     (out (js-call a :invoke "f" (js-array input reverse))))
                (js-call assert :deepEqual (read a out) (js-call js :f (js-call values :slice) reverse))
                (js-call a :release out)
                (js-call a :release input)))))
        (setq k (1+ k)))
      (finish a))))

  (test "Given objects with equal comparison keys, when sort returns ties or NaN, then original relative order remains stable" (async ()
    (let* ((c (await (compiled "(defun f (tie) (let ((items (js-array (js-object :rank 2 :id \"a\") (js-object :rank 1 :id \"b\") (js-object :rank 2 :id \"c\") (js-object :rank 1 :id \"d\")))) (js-call items :sort (lambda (a b) (if tie (/ 0 0) (- (get a :rank) (get b :rank))))) (js-call items :map (lambda (x) (get x :id))))) (export f)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array false t) :forEach
        (lambda (tie)
          (let ((out (js-call a :invoke "f" (js-array tie))))
            (js-call assert :deepEqual (read a out) (js-call js :f tie))
            (js-call a :release out))))
      (finish a))))

  (test "Given invalid comparators, when sort validates even an empty array, then errors preserve the receiver and later calls recover" (async ()
    (let* ((c (await (compiled "(defun f (items compare) (js-call items :sort compare)) (export f)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array (js-array) (js-array 3 1)) :forEach
        (lambda (values)
          (js-call (js-array nil false 0 "wrong") :forEach
            (lambda (bad)
              (let ((input (array a values))
                    (compare (box a bad)))
                (js-call assert :throws (lambda () (js-call js :f (js-call values :slice) bad)) globalThis.TypeError)
                (js-call assert :throws (lambda () (js-call a :invoke "f" (js-array input compare))) (rt-diag-p "ELI-RT0003"))
                (js-call assert :deepEqual (read a input) values)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                (let ((out (js-call a :invoke "f" (js-array input undefined))))
                  (js-call assert :deepEqual (read a out) (js-call js :f (js-call values :slice) undefined))
                  (js-call (js-array input compare out) :forEach (lambda (v) (js-call a :release v)))))))))
      (finish a))))

  (test "Given mutations from a comparator, when sorting writes its collected values back, then the original length snapshot and appended elements survive" (async ()
    (let* ((c (await (compiled "(defun f (items) (let ((trace (js-object :called false))) (js-call items :sort (lambda (a b) (unless (get trace :called) (put trace :called t) (put items :length 1) (put items 0 99) (js-call items :push 77 88 99 111)) (- a b))))) (export f)")))
           (a (get c :a))
           (js (get c :js))
           (values (js-array 4 3 2 1))
           (input (array a values))
           (out (js-call a :invoke "f" (js-array input))))
      (js-call assert :deepEqual (read a out) (js-call js :f (js-call values :slice)))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (js-call a :release out)
      (js-call a :release input)
      (finish a))))

  (test "Given an own sort function, when argument evaluation replaces it, then the captured function executes and extra arguments retain effects" (async ()
    (let* ((c (await (compiled "(defun f () (let ((items (js-array)) (trace (js-object :calls 0))) (put items :sort (lambda (x &rest tail) (str \"captured:\" x \":\" (js-length tail)))) (js-array (js-call items :sort (progn (put items :sort (lambda () \"wrong\")) \"key\") (progn (put trace :calls 1) \"extra\")) (get trace :calls)))) (export f)")))
           (a (get c :a))
           (js (get c :js))
           (out (js-call a :invoke "f")))
      (js-call assert :deepEqual (read a out) (js-call js :f))
      (js-call a :release out)
      (finish a))))

  (test "Given a failing comparison after source mutation, when sorting aborts, then collected values are not prematurely written back and caller roots survive" (async ()
    (let* ((c (await (compiled "(defun f (items) (js-call items :sort (lambda (a b) (put items 0 99) (js-call nil :charAt 0)))) (defun recover (items) (js-call items :sort)) (export f recover)")))
           (a (get c :a))
           (js (get c :js))
           (values (js-array 3 2 1))
           (input (array a values))
           (caller (js-call a :frame 1)))
      (js-call a :frameSet caller 0 input)
      (js-call assert :throws (lambda () (js-call js :f values)) globalThis.TypeError)
      (js-call assert :throws (lambda () (js-call a :invoke "f" (js-array input))) (rt-diag-p "ELI-RT0003"))
      (js-call assert :deepEqual (read a input) values)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (let ((out (js-call a :invoke "recover" (js-array input))))
        (js-call assert :deepEqual (read a out) (js-call js :recover values))
        (js-call a :release out)
        (js-call a :leaveFrame caller)
        (js-call a :release input)
        (finish a)))))

  (test "Given an invalid raw comparator handle, when sort validates it, then the original handle error and caller frame remain intact" (async ()
    (let* ((c (await (compiled "(defun f (items) (js-call items :sort)) (export f)")))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (js-call e "heap-new" 32 1024 65536))
             (items (js-call e "value-array-new" heap 0))
             (frame (js-call e "frame-new" heap 1)))
        (js-call e "frame-set" heap frame 0 items)
        (js-call assert :equal (js-call e "value-source-array-sort" heap items 4294967295 0) 0)
        (js-call assert :equal (js-call e "last-error") 1)
        (js-call assert :equal (js-call e "frame-depth" heap) 1)
        (js-call e "frame-pop" heap frame)
        (js-call e "heap-collect" heap)
        (js-call assert :equal (js-call e "heap-live" heap) 0)))))

  (test "Given thousands of duplicate keys, when collecting stable sort runs, then all values agree and comparisons stay within the merge bound" (async ()
    (let* ((c (await (compiled "(defun f (items) (let ((trace (js-object :calls 0))) (js-call items :sort (lambda (a b) (put trace :calls (1+ (get trace :calls))) (- a b))) (js-array items (get trace :calls)))) (export f)"
                       (js-object :maxSlots 5120 :initialBytes 1048576))))
           (a (get c :a))
           (js (get c :js))
           (state 1210149009)
           (values (Array/from (js-object :length 4096)
                     (lambda ()
                       (setq state (uint32 (+ (Math/imul state 1664525) 1013904223)))
                       (- (% state 257) 128))))
           (input (array a values))
           (out (js-call a :invoke "f" (js-array input)))
           (sorted (js-call a :get out 0))
           (calls (js-call a :get out 1)))
      (js-call assert :deepEqual (read a sorted) (aref (js-call js :f (js-call values :slice)) 0))
      (funcall assert (<= (js-call a :readNumber calls) (* (js-length values) 12)))
      (funcall assert (> (js-call a :readNumber calls) 0))
      (funcall assert (> (get (js-call a :stats) :collections) 0))
      (js-call (js-array input out sorted calls) :forEach (lambda (v) (js-call a :release v)))
      (finish a))))

  (test "Given a comparator returning numeric text or a convertible object, when its result is consumed, then ordinary numeric conversion decides ordering" (async ()
    (let* ((c (await (compiled "(defun f (items object) (js-call items :sort (lambda (a b) (let ((difference (- a b))) (if object (js-object :valueOf (lambda () difference)) (str difference)))))) (export f)")))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array false t) :forEach
        (lambda (object)
          (let* ((values (js-array 8 -3 11 0 -0.0 8))
                 (input (array a values))
                 (out (js-call a :invoke "f" (js-array input object))))
            (js-call assert :deepEqual (read a out) (js-call js :f (js-call values :slice) object))
            (js-call a :release input)
            (js-call a :release out))))
      (finish a))))

  (test "Given a sparse source array, when toSorted runs, then a distinct dense result owns undefined entries and the source remains unchanged" (async ()
    (let* ((c (await (compiled "(defun f (items) (js-call items :toSorted)) (export f)")))
           (a (get c :a))
           (js (get c :js))
           (values (new globalThis.Array 6)))
      (put values 1 "b")
      (put values 3 undefined)
      (put values 5 "a")
      (let* ((input (array a values))
             (out (js-call a :invoke "f" (js-array input)))
             (decoded (read a out))
             (i 0))
        (js-call assert :equal (js-call a :keyEqual input out) false)
        (js-call assert :deepEqual decoded (js-call js :f values))
        (js-call assert :deepEqual (read a input) values)
        (while (< i (js-length values))
          (funcall assert (Object/hasOwn decoded i))
          (setq i (1+ i)))
        (js-call a :release out)
        (js-call a :release input)
        (finish a)))))

  (test "Given a copying comparator that mutates its source, when toSorted completes, then the sorted snapshot and the source mutation are separately retained" (async ()
    (let* ((c (await (compiled "(defun f (items) (js-call items :toSorted (lambda (a b) (put items 0 99) (- a b)))) (export f)")))
           (a (get c :a))
           (js (get c :js))
           (values (js-array 3 1 2))
           (input (array a values))
           (expected (js-call js :f values))
           (out (js-call a :invoke "f" (js-array input))))
      (js-call assert :deepEqual (read a out) expected)
      (js-call assert :deepEqual (read a input) values)
      (js-call a :release out)
      (js-call a :release input)
      (finish a))))

  (test "Given nested sorts from a comparator, when both comparators allocate and collect, then independent workspaces retain every captured value" (async ()
    (let* ((c (await (compiled "(defun f (items) (let ((nested (js-array 9 3 6)) (trace (js-object :called false))) (js-call items :sort (lambda (a b) (put trace :called t) (js-call nested :sort (lambda (x y) (- x y))) (- a b))) (js-array items nested (get trace :called)))) (export f)")))
           (a (get c :a))
           (js (get c :js))
           (values (js-array 7 2 5 2 -0.0 0))
           (input (array a values))
           (out (js-call a :invoke "f" (js-array input))))
      (js-call assert :deepEqual (read a out) (js-call js :f (js-call values :slice)))
      (funcall assert (> (get (js-call a :stats) :collections) 0))
      (js-call a :release out)
      (js-call a :release input)
      (finish a))))

  (test "Given a real WASM trap inside a comparator, when invocation unwinds, then the caller frame and source snapshot remain usable" (async ()
    (let* ((source "(defconst marker 1) (defun own (a i) (object-has? a i)) (defun f (items) (js-call items :sort (lambda (a b) (- a b)))) (defun recover (items) (js-call items :sort)) (export own f recover)")
           (p (js-call (get b :compiler) :compile_ir_string source "sort-trap.eli"))
           (text (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call text :indexOf "  (defun value-number-binary "))
           (end (js-call text :indexOf "  (defun heap-number-word " start)))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call text :slice 0 start)
                              "  (defun value-number-binary (heap left right operation) (load-u32 4294967295))\n"
                              (js-call text :slice end))
                         "trap-runtime.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p injected))))
             (_ (js-call a :auto 1))
             (input (array a (js-array 3 1 2)))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 input)
        (js-call assert :throws
          (lambda () (js-call a :invoke "f" (js-array input)))
          (lambda (e) (funcall (js* "(a, b) => a instanceof b") e globalThis.WebAssembly.RuntimeError)))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call assert :deepEqual (read a input) (js-array 3 1 2))
        (let ((out (js-call a :invoke "recover" (js-array input))))
          (js-call assert :deepEqual (read a out) (js-array 1 2 3))
          (js-call a :release out)
          (js-call a :leaveFrame caller)
          (js-call a :release input)
          (finish a))))))

  (test "Given exhausted capacity, when sort cannot create its workspace, then it preserves inputs and recovers after roots are released" (async ()
    (let* ((c (await (compiled "(defun f (items) (js-call items :sort)) (export f)"
                       (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 8192))))
           (a (get c :a))
           (input (array a (js-array 4 1 3 2)))
           (held (js-array)))
      (js-call assert :throws
        (lambda () (while t (js-call held :push (js-call a :number 19))))
        (rt-diag-p "ELI-RT0002"))
      (js-call assert :throws
        (lambda () (js-call a :invoke "f" (js-array input)))
        (rt-diag-p "ELI-RT0002"))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (js-call held :forEach (lambda (v) (js-call a :release v)))
      (js-call a :collect)
      (js-call assert :deepEqual (read a input) (js-array 4 1 3 2))
      (let ((out (js-call a :invoke "f" (js-array input))))
        (js-call assert :deepEqual (read a out) (js-array 1 2 3 4))
        (js-call a :release out)
        (js-call a :release input)
        (finish a))))))
