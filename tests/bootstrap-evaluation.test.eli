(module tests.bootstrap-evaluation.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs" existsSync mkdtempSync readFileSync rmSync writeFileSync)
  (import "node:os" tmpdir)
  (import "node:path" join resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../bootstrap/host/evaluation.mjs" EvaluationSession)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst projectDirectory (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst bootstrapPath (resolve projectDirectory "bin/eliscript-bootstrap"))
  (defconst evaluationPath (resolve projectDirectory "bin/eliscript-eval"))
  (defconst evaluationOracle (resolve projectDirectory "tests/bootstrap-evaluation-oracle.el"))
  (defconst fixture (resolve projectDirectory "tests/fixtures/evaluation-session/main.eli"))
  (defconst node (let ((value (get (get globalThis.process :env) :NODE))) (if (nullish? value) "node" value)))
  (defconst bun (get globalThis.process :execPath))
  (defconst emacs (let ((value (get (get globalThis.process :env) :EMACS))) (if (nullish? value) "emacs" value)))
  (defconst moduleSource "\n    (module sample\n      (import \"./value.mjs\" imported)\n      (defmacro twice (value) `(+ ,value ,value))\n      (defvar private-value 1)\n      (defun public-value () private-value)\n      (export public-value))\n  ")
  (defconst macroSource "(defmacro twice (value) `(+ ,value ,value))")
  (defvar directory undefined) (defvar compilerDirectory undefined) (defvar compiler undefined)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun matches (actual expected) (js-call (expect actual) :toMatchObject expected))
  (defun contains (actual expected) (js-call (expect actual) :toContain expected))
  (defasync run (command &rest __host_default_arguments_1)
    (let* ((options (aref __host_default_arguments_1 0)))
    (setq options (if (= options undefined) (js-object) options))
    (let* ((input (get options :stdin)) (env (get options :env))
           (child (Bun/spawn command (js-object :cwd projectDirectory :stdin (if (= input undefined) "ignore" "pipe")
             :stdout "pipe" :stderr "pipe" :env (if (nullish? env) (get globalThis.process :env) env)))))
      (when (not (= input undefined)) (js-call (get child :stdin) :write input) (js-call (get child :stdin) :end))
      (let ((result (await (Promise/all (js-array (get child :exited)
        (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
        (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2))))))
  (defun runtimeEnv (runtime)
    (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory :ELISCRIPT_JS_RUNTIME runtime)))
  (defasync protocol (runtime lines)
    (let ((result (await (run (js-array evaluationPath "--stdio") (js-object :env (runtimeEnv runtime) :stdin (str (js-call lines :join "\n") "\n"))))))
      (be (get result :exitCode) 0) (be (get result :stderr) "")
      (js-call (js-call (js-call (get result :stdout) :trim) :split "\n") :map (lambda (line) (JSON/parse line)))))
  (defasync terminal (runtime lines &rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)))
    (setq options (if (= options undefined) (js-array "--repl" "--no-prompt" "--root" projectDirectory) options))
    (await (run (js-call (js-array evaluationPath) :concat options) (js-object :env (runtimeEnv runtime) :stdin (js-call lines :join "\n"))))))
  (beforeAll (async ()
    (setq directory (mkdtempSync (join (tmpdir) "eliscript-evaluation-test-")) compilerDirectory (resolve directory "compiler"))
    (let ((built (await (run (js-array bootstrapPath) (js-object :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDirectory)))))))
      (be (get built :exitCode) 0))
    (setq compiler (await (funcall load-module (str (get (pathToFileURL (resolve compilerDirectory "compiler.mjs")) :href) "?evaluation"))))) 30000)
  (afterAll (lambda () (rmSync directory (js-object :recursive t :force t))))
  (test "self-hosted evaluation descriptors are closed and framework neutral" (lambda ()
    (be (get compiler :evaluation_operation_format) "eliscript-evaluation-operation")
    (be (get compiler :evaluation_operation_version) 1)
    (same (js-call compiler :evaluation_operation_request (js-object :id 7 :operation "evaluate" :source "(+ 1 2)" :filename "repl.eli"))
      (js-object :format "eliscript-evaluation-operation" :version 1 :id 7 :operation "evaluate" :source "(+ 1 2)" :filename "repl.eli" :root nil :line 1 :column 1))
    (js-call (expect (lambda () (js-call compiler :evaluation_operation_request (js-object :operation "reset" :source "(+ 1 2)")))) :toThrow "reset evaluation operation does not accept source fields")
    (js-call (expect (lambda () (js-call compiler :evaluation_operation_request (js-object :operation "describe" :framework "anything")))) :toThrow "unknown evaluation operation key: framework")
    (be (get compiler :evaluation_input_format) "eliscript-evaluation-input")
    (be (get compiler :evaluation_input_version) 1)
    (same (js-call compiler :evaluation_input_description "(+ 1" "repl.eli") (js-object :format "eliscript-evaluation-input" :version 1 :status "incomplete" :filename "repl.eli"))
    (same (js-call compiler :evaluation_form_description "(defun value () 42)" "repl.eli")
      (js-object :format "eliscript-evaluation-form" :version 1 :kind "definition" :head "defun" :name "value" :runtimeBinding t :filename "repl.eli"))
    (js-call (expect (get (js-call compiler :evaluation_form_description macroSource "repl.eli") :runtimeBinding)) :toBeFalse)
    (matches (js-call compiler :evaluation_form_description "(defmulti render (lambda (value) value))" "repl.eli") (js-object :kind "definition" :name "render" :runtimeBinding t))
    (be (get (js-call compiler :evaluation_form_description "(defmethod render :text (value) value)" "repl.eli") :kind) "expression")
    (matches (js-call compiler :evaluation_form_description "(defprotocol IDescribe describe)" "repl.eli") (js-object :kind "definition" :name "IDescribe" :runtimeBinding t))
    (js-call (js-array "(extend-type Box IDescribe (describe (value) value))" "(extend-category \"number\" IDescribe (describe (value) value))" "(extend-default IDescribe (describe (value) value))")
      :forEach (lambda (source) (be (get (js-call compiler :evaluation_form_description source "repl.eli") :kind) "expression")))
    (js-call (js-array "jsx" "fragment" "defcomponent") :forEach (lambda (name) (be (get (js-call compiler :evaluation_form_description (str "(" name " 1)") "repl.eli") :kind) "expression")))
    (be (get (js-call compiler :evaluation_form_description "(import \"./value.mjs\" value)" "repl.eli") :kind) "module")
    (let ((description (js-call compiler :evaluation_module_description moduleSource "sample.eli")))
      (same description (js-object :format "eliscript-evaluation-module" :version 1 :filename "sample.eli" :bindings (js-array "imported" "private-value" "public-value") :exports (js-array "public-value") :macroSources (js-array macroSource)))
      (js-call (expect (Object/isFrozen description)) :toBeTrue) (js-call (expect (Object/isFrozen (get description :bindings))) :toBeTrue))))
  (test "seed and self-hosted evaluation descriptors agree" (async ()
    (let* ((cases (js-array (js-object "kind" "operation" "input" (js-object "id" "request-1" "operation" "evaluate" "source" "(+ 1 2)" "filename" "repl.eli" "root" "/project" "line" 9 "column" 4)) (js-object "kind" "operation" "input" (js-object "id" 2 "operation" "reset")) (js-object "kind" "operation" "input" (js-object "id" 9007199254740992 "operation" "describe")) (js-object "kind" "input" "source" "" "filename" "repl.eli") (js-object "kind" "input" "source" "; comment\n" "filename" "repl.eli") (js-object "kind" "input" "source" "(+ 1" "filename" "repl.eli") (js-object "kind" "input" "source" "\"unfinished" "filename" "repl.eli") (js-object "kind" "input" "source" "'" "filename" "repl.eli") (js-object "kind" "input" "source" "#{1 2}" "filename" "repl.eli") (js-object "kind" "input" "source" "(+ 1 ])" "filename" "repl.eli") (js-object "kind" "input" "source" "1 2" "filename" "repl.eli") (js-object "kind" "operation" "input" (js-object "operation" "describe" "unknown" t)) (js-object "kind" "form" "source" "(defmacro twice (value) `(+ ,value ,value))" "filename" "repl.eli") (js-object "kind" "form" "source" "(defmulti render (lambda (value) value))" "filename" "repl.eli") (js-object "kind" "form" "source" "(defmethod render :text (value) value)" "filename" "repl.eli") (js-object "kind" "form" "source" "(defprotocol IDescribe describe)" "filename" "repl.eli") (js-object "kind" "form" "source" "(extend-category \"number\" IDescribe (describe (value) value))" "filename" "repl.eli") (js-object "kind" "form" "source" "(+ 1 2) (+ 3 4)" "filename" "repl.eli") (js-object "kind" "module" "source" moduleSource "filename" "sample.eli"))) (oracleInput (join directory "evaluation-oracle-input.json")))
      (writeFileSync oracleInput (JSON/stringify cases))
      (let ((seed (await (run (js-array emacs "--batch" "-Q" "-L" (resolve projectDirectory "compiler") "--script" evaluationOracle)
        (js-object :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_EVALUATION_ORACLE_INPUT oracleInput)))))))
        (be (get seed :exitCode) 0) (be (get seed :stderr) "")
        (let ((selfHosted (js-call cases :map (lambda (entry)
          (try
            (let* ((kind (get entry :kind))
                   (value (cond ((= kind "operation") (js-call compiler :evaluation_operation_request (get entry :input)))
                     ((= kind "input") (js-call compiler :evaluation_input_description (get entry :source) (get entry :filename)))
                     ((= kind "form") (js-call compiler :evaluation_form_description (get entry :source) (get entry :filename)))
                     (t (js-call compiler :evaluation_module_description (get entry :source) (get entry :filename))))))
              (js-object :status "ok" :value value))
            (catch error (js-object :status "error" :diagnostic (get error :eliscriptDiagnostic))))))))
          (same (JSON/parse (get seed :stdout)) selfHosted))))))
  (defasync evaluate (session id source &rest __host_default_arguments_3)
    (let* ((filename (aref __host_default_arguments_3 0)))
    (await (js-call session :execute (js-object :id id :operation "evaluate" :source source :filename (if (= filename undefined) "repl.eli" filename))))))
  (test "persistent evaluation commits atomically and preserves live state" (async ()
    (let* ((session (await (js-call EvaluationSession :create (js-object :compiler compiler)))) (ownedDirectory (get session :directory)))
      (try
        (same (get (await (js-call session :execute (js-object :id 1 :operation "describe"))) :capabilities)
          (js-object :operations (js-array "describe" "evaluate" "load" "reset") :persistentSession t :sourceMaps t :valuePrinter "eliscript-data-text"))
        (matches (await (evaluate session 2 "(defvar x 40)")) (js-object :status "ok" :revision 1 :kind "definition" :binding "x" :value "40"))
        (be (get (await (evaluate session 3 "(+ x 2)")) :value) "42")
        (let ((failedReplacement (await (evaluate session 4 "(defvar x missing)"))))
          (be (get failedReplacement :status) "error") (be (get failedReplacement :revision) 1))
        (be (get (await (evaluate session 5 "x")) :value) "40")
        (await (evaluate session 6 "(defvar x 41)")) (await (evaluate session 7 macroSource))
        (be (get (await (evaluate session 8 "(twice x)")) :value) "82")
        (let* ((source (readFileSync fixture "utf8"))
               (loaded (await (js-call session :execute (js-object :id 9 :operation "load" :source source :filename fixture :root projectDirectory)))))
          (matches loaded (js-object :status "ok" :revision 4 :kind "module" :stdout "evaluation fixture loaded\n"))
          (be (get (await (evaluate session 10 "(current)" fixture)) :value) "[1 1]")
          (be (get (await (evaluate session 11 "(bump)" fixture)) :value) "2")
          (be (get (await (evaluate session 12 "(current)" fixture)) :value) "[2 1]")
          (let* ((runtimeFailure (await (evaluate session 13 "(explode)" fixture))) (diagnostic (get runtimeFailure :diagnostic)) (location (get diagnostic :location)))
            (be (get runtimeFailure :status) "error") (be (get diagnostic :phase) "evaluation-runtime")
            (be (get location :file) fixture) (be (get location :line) 8) (be (get location :column) 30))
          (be (get (await (evaluate session 14 "(current)" fixture)) :value) "[2 1]")
          (let ((reloaded (await (js-call session :execute (js-object :id 15 :operation "load" :source source :filename fixture :root projectDirectory)))))
            (be (get reloaded :revision) 5))
          (be (get (await (evaluate session 16 "(current)" fixture)) :value) "[1 1]"))
        (finally (js-call session :close)))
      (js-call (expect (existsSync ownedDirectory)) :toBeFalse))))
  (test "Node and Bun preserve NDJSON framing and source locations" (async ()
    (let* ((records (js-array
               (JSON/stringify (js-object :id 1 :operation "evaluate" :source "(defvar x 40)" :filename "repl.eli")) "{ malformed"
               (JSON/stringify (js-object :id 2 :operation "evaluate" :source "(+ x 2)" :filename "repl.eli"))
               (JSON/stringify (js-object :id 3 :operation "evaluate" :source "(js-call nil :missing)" :filename "/tmp/evaluation-source.eli" :line 7 :column 3))
               (JSON/stringify (js-object :id 4 :operation "evaluate" :source "(+ x 3)" :filename "repl.eli"))))
           (all (await (Promise/all (js-array (protocol node records) (protocol bun records))))))
      (js-call all :forEach (lambda (results)
        (js-call (expect results) :toHaveLength 5)
        (same (js-call results :map (lambda (value) (get value :status))) (js-array "ok" "error" "ok" "error" "ok"))
        (matches (aref results 0) (js-object :id 1 :revision 1 :value "40"))
        (be (get (get (aref results 1) :diagnostic) :phase) "evaluation-request") (be (get (aref results 1) :revision) 1)
        (matches (aref results 2) (js-object :id 2 :revision 1 :value "42"))
        (same (get (get (aref results 3) :diagnostic) :location) (js-object :file "/tmp/evaluation-source.eli" :line 7 :column 12))
        (matches (aref results 4) (js-object :id 4 :revision 1 :value "43")))))))
  (test "Node and Bun terminal REPLs preserve multiline state and recover" (async ()
    (let* ((lines (js-array ":reload" ":unknown" "; an empty submission" "(defvar x 40)" "(+" " x" " 2)" "(defmacro twice (value) `(+ ,value ,value))" "(twice 21)" "(+ x ]" "(+ x 3)" ":load tests/fixtures/evaluation-session/main.eli" "(explode)" "(current)" ":load tests/fixtures/evaluation-session/missing.eli" ":reload" "(current)" ":reset" "(defvar done 7)" "done" ":quit" "(+ 1 1000)")) (all (await (Promise/all (js-array (terminal node lines) (terminal bun lines)))))
           (nodeResult (aref all 0)) (bunResult (aref all 1)) (runtimePrefix (str "eliscript-eval: " fixture ":8:30: "))
           (normalizeRuntimeMessage (lambda (output)
             (js-call (js-call (js-call output :split "\n") :map (lambda (line)
               (if (js-call line :startsWith runtimePrefix) (str runtimePrefix "<host-runtime-message>") line))) :join "\n"))))
      (js-call all :forEach (lambda (result) (be (get result :exitCode) 0) (be (get result :stderr) "")))
      (be (funcall normalizeRuntimeMessage (get nodeResult :stdout)) (funcall normalizeRuntimeMessage (get bunResult :stdout)))
      (contains (get nodeResult :stdout) "eliscript-eval: :reload requires a prior successful :load\n")
      (contains (get nodeResult :stdout) "eliscript-eval: unknown REPL command: :unknown\n")
      (contains (get nodeResult :stdout) "40\n42\ntwice\n42\n")
      (contains (get nodeResult :stdout) "eliscript-eval: <repl>.eli:1:1: Invalid read syntax: \"]\"\n43\n")
      (js-call (expect (js-call (get nodeResult :stdout) :match (new globalThis.RegExp "evaluation fixture loaded\\n" "g"))) :toHaveLength 2)
      (js-call all :forEach (lambda (result) (contains (get result :stdout) runtimePrefix) (contains (get result :stdout) "\n[1 1]\n")))
      (contains (get nodeResult :stdout) "missing.eli")
      (js-call (expect (get nodeResult :stdout)) :toEndWith "session reset\n7\n7\n")
      (js-call (get (expect (get nodeResult :stdout)) :not) :toContain "1001"))))
  (test "terminal prompt policy and incomplete EOF are deterministic" (async ()
    (let* ((promptedLines (js-array "(+" " 20" " 22)" ":help" ":quit"))
           (prompted (await (Promise/all (js-array (terminal node promptedLines (js-array "--repl" "--prompt")) (terminal bun promptedLines (js-array "--repl" "--prompt"))))))
           (nodePrompted (aref prompted 0)) (bunPrompted (aref prompted 1)))
      (same nodePrompted bunPrompted) (be (get nodePrompted :exitCode) 0)
      (js-call (expect (get nodePrompted :stdout)) :toStartWith "Eliscript REPL. Type :help for commands.\neliscript=> ")
      (contains (get nodePrompted :stdout) "      ...       ... 42\n") (contains (get nodePrompted :stdout) "Commands:\n"))
    (let ((defaults (await (Promise/all (js-array (terminal node (js-array "(+ 20 22)" ":quit") (js-array "--no-prompt")) (terminal bun (js-array "(+ 20 22)" ":quit") (js-array "--no-prompt")))))))
      (be (get (aref defaults 0) :stdout) "42\n") (be (get (aref defaults 1) :stdout) (get (aref defaults 0) :stdout)))
    (let ((incomplete (await (Promise/all (js-array (terminal node (js-array "(+" " 1")) (terminal bun (js-array "(+" " 1")))))))
      (be (get (aref incomplete 0) :stdout) (get (aref incomplete 1) :stdout))
      (contains (get (aref incomplete 0) :stdout) "eliscript-eval: <repl>.eli:1:1: unexpected end of input\n")
      (be (get (aref incomplete 0) :exitCode) 0))))
)
