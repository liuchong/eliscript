(module tests.compiler-source-map-vlq.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "./helpers/source-map-vlq-contract.mjs" check checkMethods)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar directory undefined) (defvar compiler undefined) (defvar source undefined)
  (defvar code undefined) (defvar m undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-source-map-vlq-"))))
    (let* ((out (resolve directory "compiler"))
           (child (spawnSync (resolve "bin/eliscript-bootstrap") (js-array)
             (js-object :encoding "utf8" :timeout 30000 :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR out))))))
      (js-call assert :equal (get child :status) 0 (get child :stderr))
      (setq compiler (await (funcall load-module (get (pathToFileURL (resolve out "compiler.mjs")) :href)))))
    (let ((text (await (readFile "bootstrap/compiler/source-map.eli" "utf8"))))
      (setq source (str "(module source.map.vlq (defconst base64 \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\")\n"
        (js-call (js-call (js-array "signed-vlq" "encode-vlq") :map (lambda (name) (definition text (str name " ")))) :join "\n")
        "\n(export encode-vlq))")))
    (setq code (js-call compiler :compile_string source "vlq.eli"))
    (setq m (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from code) :toString "base64")))))) 30000)
  (afterAll (async () (await (rm directory (js-object :recursive t :force t)))))
  (test "single and multiple characters, signed and fractional boundaries, missing inputs and coercion effects match the original JS oracle" (lambda () (check m)))
  (test "push, charAt, join and floor getters, custom returns, mutations and failures keep exact method and conversion order" (lambda () (checkMethods m)))
  (test "public Seed produces identical helper code and Node and Bun independently verify values and mutable method contracts"
    (async ()
      (let ((input (resolve directory "vlq.eli")) (output (resolve directory "vlq.mjs")))
        (await (writeFile input source))
        (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get seed :status) 0 (get seed :stderr)))
        (js-call assert :equal (await (readFile output "utf8")) (js-call compiler :compile_string source input))
        (js-call (js-array "node" "bun") :forEach (lambda (host)
          (let ((child (spawnSync host (js-array "tests/fixtures/compiler-vlq-host.mjs" (get (pathToFileURL output) :href)) (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (str host ": " (get child :stderr)))))))))
)
