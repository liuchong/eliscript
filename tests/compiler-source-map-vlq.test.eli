(module capsules.tests.compiler-source-map-vlq.test
  (js* "import {beforeAll,afterAll,test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {mkdtemp,readFile,rm,writeFile} from 'node:fs/promises';\nimport {tmpdir} from 'node:os';\nimport {resolve} from 'node:path';\nimport {pathToFileURL} from 'node:url';\nimport {spawnSync} from 'node:child_process';\nimport {definition} from '../tools/compiler/controlled-baseline.mjs';\nlet directory,compiler,source,code,m;\nfunction oracle(value){const base64='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';let remaining=value<0?-value*2+1:value*2;const characters=[];while(remaining>=32){characters.push(base64.charAt(remaining%32+32));remaining=Math.floor(remaining/32);}characters.push(base64.charAt(remaining));return characters.join('');}\nbeforeAll(async()=>{directory=await mkdtemp(resolve(tmpdir(),'eliscript-source-map-vlq-'));const out=resolve(directory,'compiler'),child=spawnSync(resolve('bin/eliscript-bootstrap'),[],{encoding:'utf8',timeout:30000,env:{...process.env,ELISCRIPT_BOOTSTRAP_OUT_DIR:out}});assert.equal(child.status,0,child.stderr);compiler=await import(pathToFileURL(resolve(out,'compiler.mjs')).href);const text=await readFile('bootstrap/compiler/source-map.eli','utf8');source='(module source.map.vlq (defconst base64 \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\")\\n'+['signed-vlq','encode-vlq'].map(name=>definition(text,name+' ')).join('\\n')+'\\n(export encode-vlq))';code=compiler.compile_string(source,'vlq.eli');m=await import('data:text/javascript;base64,'+Buffer.from(code).toString('base64'));},30000);\nafterAll(async()=>{await rm(directory,{recursive:true,force:true});});\nfunction check(m){for(const value of[undefined,null,false,true,NaN,0,-0,1,-1,15,-15,16,-16,31,32,1024,-1024,2147483647,-2147483648,2**40,-(2**40),.1,-.1,15.75,-15.75,'',' 3 ','0x10','not-a-number'])assert.equal(m.encode_vlq(value),oracle(value));for(const value of[1n,-1n,Symbol('x')]){assert.throws(()=>oracle(value),TypeError);assert.throws(()=>m.encode_vlq(value),TypeError);}assert.equal(m.encode_vlq(),oracle());\n const build=()=>{const events=[];let n=0;return{events,value:{get [Symbol.toPrimitive](){events[events.length]='primitive';return hint=>{events[events.length]=hint;return n++===0?-2:3;};}}};};const left=build(),right=build();assert.equal(m.encode_vlq(left.value),oracle(right.value));assert.deepEqual(left.events,right.events);const marker={};assert.throws(()=>m.encode_vlq({valueOf(){throw marker;}}),e=>e===marker);assert.equal(m.encode_vlq(1),'C');let state=0xb4263f91;for(let i=0;i<2048;i++){state=(Math.imul(state,1664525)+1013904223)>>>0;const value=(state|0)/[1,2,8][i%3];assert.equal(m.encode_vlq(value),oracle(value));}}\ntest('single and multiple characters, signed and fractional boundaries, missing inputs and coercion effects match the original JS oracle',()=>{check(m);});\nfunction observe(fn,mode,value){const events=[],saved={push:Object.getOwnPropertyDescriptor(Array.prototype,'push'),join:Object.getOwnPropertyDescriptor(Array.prototype,'join'),charAt:Object.getOwnPropertyDescriptor(String.prototype,'charAt'),floor:Object.getOwnPropertyDescriptor(Math,'floor')},identity={};let result,error,receiver;\n const log=x=>{events[events.length]=x;};\n try{\n  Object.defineProperty(Array.prototype,'push',{configurable:true,get(){log('push:get');if(mode==='bad-push')return null;return function(item){log('push:call');receiver=this;return Reflect.apply(saved.push.value,this,[mode==='mutate'?'replacement':item]);};}});\n  Object.defineProperty(String.prototype,'charAt',{configurable:true,get(){log('charAt:get');return function(index){log('charAt:'+index);if(mode==='char-throws')throw identity;if(mode==='char-object')return{toString(){log('character:string');return'x';}};return Reflect.apply(saved.charAt.value,this,[index]);};}});\n  Object.defineProperty(Array.prototype,'join',{configurable:true,get(){log('join:get');if(mode==='join-throws')throw identity;return function(separator){log('join:call:'+separator);assert.equal(this,receiver);return mode==='custom-join'?identity:Reflect.apply(saved.join.value,this,[separator]);};}});\n  Object.defineProperty(Math,'floor',{configurable:true,get(){log('floor:get');return function(x){log('floor:call');if(mode==='infinite-trap')throw identity;return Reflect.apply(saved.floor.value,this,[x]);};}});\n  result=fn(value);\n }catch(e){error=e===identity?'marker':e instanceof TypeError?'TypeError':String(e);}\n finally{for(const[key,target]of[['push',Array.prototype],['join',Array.prototype],['charAt',String.prototype],['floor',Math]])Object.defineProperty(target,key,saved[key]);}\n return{events,result:result===identity?'identity':result,error};}\nfunction checkMethods(m){for(const mode of['normal','mutate','bad-push','char-throws','char-object','custom-join','join-throws'])for(const value of[0,1,-1,16,1024])assert.deepEqual(observe(m.encode_vlq,mode,value),observe(oracle,mode,value));assert.deepEqual(observe(m.encode_vlq,'infinite-trap',Infinity),observe(oracle,'infinite-trap',Infinity));assert.equal(m.encode_vlq(0),'A');}\ntest('push, charAt, join and floor getters, custom returns, mutations and failures keep exact method and conversion order',()=>{checkMethods(m);});\ntest('public Seed produces identical helper code and Node and Bun independently verify values and mutable method contracts',async()=>{const input=resolve(directory,'vlq.eli'),output=resolve(directory,'vlq.mjs');await writeFile(input,source);const seed=spawnSync(resolve('bin/eliscript-seed'),['--output',output,input],{encoding:'utf8',timeout:30000});assert.equal(seed.status,0,seed.stderr);assert.equal(await readFile(output,'utf8'),compiler.compile_string(source,input));for(const host of['node','bun']){const child=spawnSync(host,['--input-type=module','-e',`import assert from 'node:assert/strict';const m=await import(process.argv[1]);${oracle.toString()}\\n${observe.toString()}\\n(${check.toString()})(m);(${checkMethods.toString()})(m);`,pathToFileURL(output).href],{encoding:'utf8',timeout:30000});assert.equal(child.status,0,host+': '+child.stderr);}});\n"))
