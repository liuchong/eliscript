(module tests.compiler-seed-negative-zero
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp mkdir rm readdir)
  (import "node:path" resolve relative)
  (import "node:os" tmpdir)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst root (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst sourceRoot (resolve (get (get globalThis.process :env) :ELISCRIPT_COMPILER_SOURCE_ROOT root)))
  (defconst emacs (get (get globalThis.process :env) :EMACS "emacs"))
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst loadReader (str "(progn (set-language-environment \"UTF-8\") (prefer-coding-system 'utf-8-unix) (setq coding-system-for-write 'utf-8-unix) (set-terminal-coding-system 'utf-8-unix) (load-file " (JSON/stringify (resolve root "compiler/eliscript-reader.el")) "))"))
  (defconst tokens (js-array "-0" "-00" "-000" "-0." "-00." "-0.0" "-00.000" "-.0" "-.00" "-0e0" "-00e-00" "-0E+2" "-0.00e-20" "-1e-9999"))
  (defvar directory undefined) (defvar compiler undefined) (defvar reader undefined) (defvar seed undefined) (defvar source undefined) (defvar filename undefined)
  (defun runEmacs (arguments_ env)
    (let ((child (spawnSync emacs (js-call (js-array "--batch" "-Q" "-L" (resolve sourceRoot "compiler") "--eval" loadReader) :concat
      (js-call arguments_ :map (lambda (argument) (if (= argument "--script") "--load" argument))))
      (js-object :cwd sourceRoot :env (copyHostRecord (get globalThis.process :env) (if (= env undefined) (js-object) env)) :encoding "utf8" :timeout 120000))))
      (js-call assert :equal (get child :status) 0 (get child :stderr)) (get child :stdout)))
  (defun resolveRuntime (javascript)
    (js-call javascript :replace (new globalThis.RegExp "from \"eliscript/([^\"]+)\"" "g")
      (lambda (_ path) (str "from " (JSON/stringify (get (pathToFileURL (resolve sourceRoot path)) :href))))))
  (defasync importCode (javascript)
    (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from (resolveRuntime javascript)) :toString "base64")))))
  (defasync seedCompile (text name)
    (let ((input (resolve directory (str name ".eli"))) (output (resolve directory (str name ".mjs"))))
      (await (writeFile input text))
      (runEmacs (js-array "--script" (resolve sourceRoot "compiler/eliscript-cli.el") "--" "--output" output input))
      (js-object :input input :javascript (await (readFile output "utf8")))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-negative-zero-"))))
    (let ((bootstrap (resolve directory "bootstrap")))
      (await (mkdir bootstrap))
      (let ((files (js-call (js-call (js-call (await (readdir (resolve sourceRoot "bootstrap/compiler"))) :filter (lambda (name) (js-call name :endsWith ".eli"))) :map (lambda (name) (js-call name :slice 0 -4))) :sort)))
        (runEmacs (js-call (js-array "--script" (resolve sourceRoot "tools/bootstrap-seed.el") "--" sourceRoot bootstrap) :concat files)))
      (setq compiler (await (funcall load-module (get (pathToFileURL (resolve bootstrap "compiler.mjs")) :href))))
      (setq reader (await (funcall load-module (get (pathToFileURL (resolve bootstrap "reader.mjs")) :href)))))
    (setq source (str ";😀 negative numeric tokens keep their original spans\n"
      "(defconst top -0)\n(defconst quoted '-0)\n(defconst values (js-array " (js-call tokens :join " ") "))\n"
      "(defconst nested (js-array (js-array -0 -00) [-0 -00] '(-0 -00) {:negative -0 :another -00}))\n"
      "(defun observed () (js-array (Object/is top -0) (/ 1 top) (Object/is quoted -0)))\n"
      "(export top quoted values nested observed)"))
    (let ((compiled (await (seedCompile source "negative-zero")))) (setq filename (get compiled :input) seed (get compiled :javascript)))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (test "Seed keeps integer negative zero as an observable numeric value" (async ()
    (let ((a (await (importCode seed))) (b (await (importCode (js-call compiler :compile_string source filename)))))
      (funcall assert (Object/is (get a :top) (js* "-0"))) (js-call assert :equal (/ 1 (get a :top)) (- globalThis.Infinity))
      (funcall assert (Object/is (get a :quoted) (js* "-0")))
      (js-call assert :deepEqual (js-call a :observed) (js-array t (- globalThis.Infinity) t))
      (js-call assert :deepEqual (js-call a :observed) (js-call b :observed)))))
  (test "all existing negative-zero token spellings survive nested vector list and Map contexts" (async ()
    (let ((a (await (importCode seed))) (b (await (importCode (js-call compiler :compile_string source filename)))))
      (js-call (js-array a b) :forEach (lambda (module)
        (js-call assert :equal (get (get module :values) :length) (js-length tokens))
        (js-call (get module :values) :forEach (lambda (value) (funcall assert (Object/is value (js* "-0"))) (js-call assert :equal (/ 1 value) (- globalThis.Infinity))))
        (js-call (Array/from (get module :nested)) :forEach (lambda (container)
          (js-call (Array/from container) :forEach (lambda (item) (let ((value (if (Array/isArray item) (aref item 1) item)))
            (funcall assert (Object/is value (js* "-0"))) (js-call assert :equal (/ 1 value) (- globalThis.Infinity))))))))))))
  (test "Seed and JS retain complete IR values spans emitted JavaScript and source map bytes" (async ()
    (let ((fixture (resolve directory "ir.json")))
      (await (writeFile fixture (JSON/stringify (js-object :valid (js-array (js-object :name "negative-zero" :filename filename :source source))))))
      (let ((ir (JSON/parse (runEmacs (js-array "--script" (resolve sourceRoot "tests/bootstrap-ir-oracle.el")) (js-object :ELISCRIPT_IR_FIXTURE fixture)))))
        (js-call assert :equal (get (aref ir 0) :status) "ok")
        (js-call assert :deepEqual (get (aref ir 0) :program) (js-call compiler :compile_ir_string source filename))
        (js-call assert :equal seed (js-call compiler :compile_string source filename)))
      (let ((mapped (resolve directory "negative-zero-mapped.mjs")))
        (runEmacs (js-array "--script" (resolve sourceRoot "compiler/eliscript-cli.el") "--" "--source-map" "--output" mapped filename))
        (let ((emission (js-call compiler :compile_string_with_source_map source filename "negative-zero-mapped.mjs" "negative-zero.eli")))
          (js-call assert :equal (await (readFile mapped "utf8")) (str (get emission :javascript) "//# sourceMappingURL=negative-zero-mapped.mjs.map\n"))
          (js-call assert :equal (await (readFile (str mapped ".map") "utf8")) (get emission :sourceMap)))))))
  (test "numeric-looking strings comments and symbols stay unchanged and nonzero values retain their signs" (async ()
    (let ((sources (js-array ";\ud83d\ude00 -0 -00 and -0e0 are comments\n0 +0 00 +00 0.0 +0.0 0e0 1 -1 +1 1.25 -1.25 2e3 -2e3" "\"-0 -00 -0.0\" :negative-zero -0tail --0 -0.0tail zero-0 -0/foo" "'(-0 (inner -00) [-0. -0e0] {:negative -0 :positive 0})" "#{-0} #queue [-0 -00] {:negative -0 :nested [-00]}")) (fixture (resolve directory "reader.json")))
      (await (writeFile fixture (JSON/stringify (js-object :valid (js-call sources :map (lambda (source index) (js-object :name (str "boundary-" index) :filename (str "boundary-" index ".eli") :source source))) :invalid (js-array)))))
      (let ((values (JSON/parse (runEmacs (js-array "--script" (resolve sourceRoot "tests/bootstrap-reader-oracle.el")) (js-object :ELISCRIPT_READER_FIXTURE fixture)))))
        (js-call assert :equal (js-length values) (js-length sources))
        (js-call values :forEach (lambda (value index)
          (js-call assert :equal (get value :status) "ok") (js-call assert :deepEqual (get value :forms) (js-call reader :read_string (aref sources index) (str "boundary-" index ".eli")))))))))
  (test "negative zero keeps complete Seed and three self-hosted compiler JS IR and map fixed points" (async ()
    (let* ((files (js-call (js-call (await (readdir (resolve sourceRoot "bootstrap/compiler"))) :filter (lambda (name) (js-call name :endsWith ".eli"))) :sort))
           (all (js-array compiler)) (previous compiler) (generations (js-array 2 3)) (generationIndex 0))
      (while (< generationIndex 2)
        (let* ((generation (aref generations generationIndex)) (output (resolve directory (str "g" generation))) (index 0))
          (await (mkdir output))
          (while (< index (js-length files))
            (let* ((file (aref files index)) (input (resolve sourceRoot "bootstrap/compiler" file))
                   (name (js-call file :replace (new globalThis.RegExp "[.]eli$") ".mjs")) (text (await (readFile input "utf8")))
                   (emission (js-call previous :compile_string_with_source_map text input name (relative output input))))
              (await (writeFile (resolve output name) (str (get emission :javascript) "//# sourceMappingURL=" name ".map\n")))
              (await (writeFile (resolve output (str name ".map")) (get emission :sourceMap))))
            (setq index (1+ index)))
          (let ((current (await (funcall load-module (get (pathToFileURL (resolve output "compiler.mjs")) :href))))) (js-call all :push current) (setq previous current)))
        (setq generationIndex (1+ generationIndex)))
      (let ((index 0))
        (while (< index (js-length all))
          (let ((current (aref all index)))
            (js-call assert :equal (js-call current :compile_string source filename) seed)
            (js-call assert :deepEqual (js-call current :compile_ir_string source filename) (js-call compiler :compile_ir_string source filename))
            (js-call assert :deepEqual (js-call current :compile_string_with_source_map source filename "negative-zero.mjs" "negative-zero.eli") (js-call compiler :compile_string_with_source_map source filename "negative-zero.mjs" "negative-zero.eli"))
            (let ((module (await (importCode (js-call current :compile_string source filename)))))
              (funcall assert (Object/is (get module :top) (js* "-0"))) (js-call assert :equal (/ 1 (get module :top)) (- globalThis.Infinity))))
          (setq index (1+ index))))
      (let ((index 0))
        (while (< index (js-length files))
          (let* ((file (aref files index)) (input (resolve sourceRoot "bootstrap/compiler" file)) (text (await (readFile input "utf8")))
                 (name (js-call file :replace (new globalThis.RegExp "[.]eli$") ".mjs")) (expected (js-call compiler :compile_string_with_source_map text input name (str "../compiler/" file))))
            (js-call (js-call all :slice 1) :forEach (lambda (current) (js-call assert :deepEqual (js-call current :compile_string_with_source_map text input name (str "../compiler/" file)) expected))))
          (setq index (1+ index)))))) 120000)
)
