(module tests.persistent-set
  (import "bun:test" expect test)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/set.mjs" EMPTY_SET PersistentHashSet isPersistentHashSet persistentHashSet)
  (import "../runtime/testing/set.mjs" inspectPersistentSet persistentSetMetrics resetPersistentSetMetrics sharedPersistentSetNodes)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (import "../runtime/core/vector.mjs" persistentVector)
  (import "../runtime/testing/value.mjs" clearValueHashCaches resetValueHashMetrics valueHashMetrics)
  (import "./helpers/portable-structure.mjs" nextRandom)
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst host-truth (js* "(value) => !!value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun setRange (count)
    (let ((result EMPTY_SET) (value 0)) (while (< value count) (setq result (js-call result :conj value) value (1+ value))) result))
  (defun distinctRootValues (count)
    (let ((values (new globalThis.Map)) (candidate 0))
      (while (< (get values :size) count)
        (let ((branch (bit-and (hashValue candidate) 31))) (unless (js-call values :has branch) (js-call values :set branch candidate)))
        (setq candidate (1+ candidate))) (Array/from (js-call values :values))))
  (defasync runHost (command source)
    (let* ((child (Bun/spawn (js-array command source) (js-object :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (unless (= (aref result 0) 0) (let ((err (js-call (aref result 2) :trim))) (throw (new globalThis.Error (if (funcall host-truth err) err (str command " exited with " (aref result 0)))))))
      (JSON/parse (aref result 1))))
  (test "persistent hash set preserves old values and value-equal members" (lambda ()
    (be (js-call PersistentHashSet :empty) EMPTY_SET) (be (get EMPTY_SET :count) 0) (be (get EMPTY_SET :size) 0)
    (js-call (expect (lambda () (new PersistentHashSet))) :toThrow globalThis.TypeError)
    (let* ((member (persistentVector 1 2 3)) (equalMember (persistentVector 1 2 3))
           (original (persistentHashSet "alpha" member undefined)) (duplicate (js-call original :conj equalMember)) (updated (js-call duplicate :conj "omega")))
      (be (isPersistentHashSet original) t) (be (Object/isFrozen original) t) (be (js-call PersistentHashSet :from original) original)
      (be duplicate original) (be (get original :count) 3) (be (js-call original :has equalMember) t)
      (be (get updated :count) 4) (be (js-call updated :has "omega") t) (be (js-call updated :disj "missing") updated)
      (be (js-call original :has "omega") false) (be (js-call (persistentHashSet "only") :disj "only") EMPTY_SET)
      (let* ((hostMember (js-object :identity t)) (scalarMembers (persistentHashSet nil undefined globalThis.Number.NaN (js* "-0") hostMember)))
        (be (get scalarMembers :count) 5) (be (js-call scalarMembers :has globalThis.Number.NaN) t) (be (js-call scalarMembers :has 0) t)
        (be (js-call scalarMembers :has hostMember) t) (be (js-call scalarMembers :has (js-object :identity t)) false))
      (let ((entries (Array/from (js-call (persistentHashSet "a") :entries))))
        (same entries (js-array (js-array "a" "a"))) (be (Object/isFrozen (aref entries 0)) t))
      (same (Array/from (js-call updated :keys)) (Array/from (js-call updated :values)))
      (same (js-call updated :toSet) (new globalThis.Set updated))
      (be (js-call updated :reduce (lambda (count) (1+ count)) 0) 4)
      (js-call (expect (lambda () (js-call updated :reduce (lambda () 0)))) :toThrow globalThis.TypeError)
      (js-call (expect (lambda () (js-call updated :reduce nil 0))) :toThrow globalThis.TypeError))))
  (test "persistent hash set handles complete hash collisions" (lambda ()
    (let* ((left "key-50691") (right "key-194634") (set (persistentHashSet left right)))
      (be (hashValue left) (hashValue right)) (be (get set :count) 2) (be (js-call set :has left) t) (be (js-call set :has right) t)
      (be (get (inspectPersistentSet set) :collisionNodes) 1) (be (js-call set :conj left) set)
      (be (js-call (js-call set :disj left) :has right) t) (be (js-call (js-call set :disj right) :has left) t))))
  (test "persistent hash set inherits sparse and dense HAMT transitions" (lambda ()
    (let ((values (distinctRootValues 32)) (set EMPTY_SET))
      (js-call (js-call values :slice 0 31) :forEach (lambda (value) (setq set (js-call set :conj value))))
      (be (get (inspectPersistentSet set) :arrayNodes) 0) (resetPersistentSetMetrics) (setq set (js-call set :conj (aref values 31)))
      (be (get (persistentSetMetrics) :promotions) 1) (be (get (inspectPersistentSet set) :arrayNodes) 1)
      (js-call (js-call values :slice 0 7) :forEach (lambda (value) (setq set (js-call set :disj value))))
      (be (get (inspectPersistentSet set) :arrayNodes) 1) (resetPersistentSetMetrics) (setq set (js-call set :disj (aref values 7)))
      (be (get (persistentSetMetrics) :demotions) 1) (be (get (inspectPersistentSet set) :arrayNodes) 0))))
  (test "persistent hash set equality and hash ignore insertion order" (lambda ()
    (let ((left (persistentHashSet "alpha" (persistentVector 1 2) globalThis.Number.NaN)) (right (persistentHashSet globalThis.Number.NaN (persistentVector 1 2) "alpha")))
      (be (equalValues left right) t) (be (hashValue left) (hashValue right))
      (be (equalValues left (js-call right :conj "changed")) false) (be (equalValues left (js-call right :disj "alpha")) false)
      (be (equalValues left (new globalThis.Set left)) false) (be (js-call (persistentHashSet left) :has right) t))))
  (test "persistent hash set implements value-semantic set algebra" (lambda ()
    (let* ((vector (persistentVector "value")) (equalVector (persistentVector "value")) (base (persistentHashSet 1 2 vector))
           (union (js-call base :union (js-array 2 3) (persistentHashSet 4))))
      (be (get union :count) 5)
      (js-call (js-array 1 2 3 4 equalVector) :forEach (lambda (value) (be (js-call union :has value) t)))
      (be (equalValues (js-call base :union (js-array 2 equalVector)) base) t) (be (js-call base :union (js-array 2 equalVector)) base)
      (let ((intersection (js-call base :intersection (js-array 2 equalVector 9))))
        (be (get intersection :count) 2) (be (js-call intersection :has 2) t) (be (js-call intersection :has vector) t) (be (js-call base :intersection base) base))
      (let ((difference (js-call base :difference (js-array 2) (persistentHashSet equalVector))))
        (same (Array/from difference) (js-array 1)) (be (js-call base :difference (js-array 9)) base)
        (be (js-call (persistentHashSet 1 vector) :isSubsetOf base) t) (be (js-call base :isSupersetOf (js-array 1 equalVector)) t)
        (be (js-call base :isDisjointFrom (js-array 8 9)) t) (be (js-call base :isDisjointFrom (js-array 8 equalVector)) false)))))
  (test "persistent hash set hashes every member once and caches the result" (lambda ()
    (clearValueHashCaches)
    (let ((set (setRange 100000)))
      (resetValueHashMetrics)
      (let ((first (hashValue set)))
        (same (valueHashMetrics) (js-object :hashValueCalls 100001 :protocolHashComputations 1 :protocolHashCacheHits 0 :hostIdentityAssignments 0))
        (resetValueHashMetrics) (be (hashValue set) first)
        (same (valueHashMetrics) (js-object :hashValueCalls 1 :protocolHashComputations 0 :protocolHashCacheHits 1 :hostIdentityAssignments 0))))))
  (test "persistent hash set agrees with a mutable reference model" (lambda ()
    (let ((random (js-object :value 1374117613)) (set EMPTY_SET) (model (new globalThis.Set)) (step 0))
      (while (< step 20000)
        (let* ((value (% (nextRandom random) 4096)) (insert (< (% (nextRandom random) 10) 7)) (previous set) (previouslyPresent (js-call model :has value)))
          (if insert (progn (setq set (js-call set :conj value)) (js-call model :add value))
            (progn (setq set (js-call set :disj value)) (js-call model :delete value)))
          (be (get set :count) (get model :size)) (be (js-call set :has value) (js-call model :has value)) (be (js-call previous :has value) previouslyPresent)
          (when (= (% step 250) 0) (js-call model :forEach (lambda (modelValue) (be (js-call set :has modelValue) t)))))
        (setq step (1+ step))))))
  (test "persistent hash set removal copies only the selected node path" (lambda ()
    (let* ((set (setRange 100000)) (shape (inspectPersistentSet set)))
      (resetPersistentSetMetrics)
      (let* ((updated (js-call set :disj 54321)) (metrics (persistentSetMetrics)))
        (js-call (expect (get metrics :nodeVisits)) :toBeLessThanOrEqual 9) (be (get metrics :nodeAllocations) (get metrics :nodeVisits))
        (be (sharedPersistentSetNodes set updated) (- (get shape :nodeCount) (get metrics :nodeVisits)))
        (be (js-call set :has 54321) t) (be (js-call updated :has 54321) false)))))
  (test "persistent hash set stays within HAMT bounds at one million members" (lambda ()
    (let* ((set (setRange 1000000)) (shape (inspectPersistentSet set)))
      (be (get shape :count) 1000000) (be (get shape :entries) 1000000) (js-call (expect (get shape :maxDepth)) :toBeLessThanOrEqual 9)
      (js-call (js-array 0 31 32 1024 32768 500000 999999 "missing") :forEach (lambda (value)
        (resetPersistentSetMetrics) (be (js-call set :has value) (= (funcall host-typeof value) "number"))
        (js-call (expect (get (persistentSetMetrics) :nodeVisits)) :toBeLessThanOrEqual 9)))
      (resetPersistentSetMetrics)
      (let ((added (js-call set :conj 1000000)))
        (js-call (expect (get (persistentSetMetrics) :nodeVisits)) :toBeLessThanOrEqual 9) (be (js-call set :has 1000000) false) (be (js-call added :has 1000000) t))
      (resetPersistentSetMetrics)
      (let ((removed (js-call set :disj 500000)))
        (js-call (expect (get (persistentSetMetrics) :nodeVisits)) :toBeLessThanOrEqual 9) (be (js-call removed :has 500000) false) (be (js-call set :has 500000) t)))) 60000)
  (test "persistent hash set has equivalent behavior under Bun and Node" (async ()
    (let* ((fixture (fileURLToPath (new globalThis.URL "fixtures/persistent-set-host.mjs" (js* "import.meta.url"))))
           (reports (await (Promise/all (js-array (runHost "bun" fixture) (runHost (get (get globalThis.process :env) :NODE "node") fixture)))))
           (bunResult (aref reports 0)))
      (same (aref reports 1) bunResult) (js-call (expect bunResult) :toMatchObject (js-object "probes" (js-array t t t t t t) "missing" false "original" t "updated" false "sum" 4999950000 "collision" (js-object "count" 2 "left" t "right" t) "algebra" (js-object "union" (js-array 1 2 3) "intersection" (js-array 2 3) "difference" (js-array 1 3)) "unordered" (js-object "equal" t)))
      (be (get (get bunResult :unordered) :leftHash) (get (get bunResult :unordered) :rightHash))
      (be (get (get bunResult :metrics) :nodeAllocations) (get (get bunResult :metrics) :nodeVisits))
      (be (get bunResult :sharedNodes) (- (get (get bunResult :shape) :nodeCount) (get (get bunResult :metrics) :nodeVisits))))))
)
