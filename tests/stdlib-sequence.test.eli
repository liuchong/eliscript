(module tests.stdlib-sequence
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (test "portable sequence library compiles and executes as an ESM module" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-sequence-"))))
           (library (resolve directory "sequence.mjs")) (usage (resolve directory "sequence-usage.mjs")))
      (try
        (await (compile (resolve ROOT "stdlib/sequence.eli") library))
        (let ((output (await (compile (resolve ROOT "tests/fixtures/sequence-usage.eli") usage))))
          (be output "")
          (same (JSON/parse (await (runSuccessful (js-array "bun" "run" usage) (js-object)))) (js-object "values" (js-array 1 2 3 4 5) "reversed" (js-array 5 4 3 2 1) "mapped" (js-array 2 4 6 8 10) "filtered" (js-array 2 4) "reduced" 15 "concatenated" (js-array 1 2 3 4) "descending" (js-array 5 3 1) "zero-step" (js-array ) "taken" (js-array 1 2 3) "dropped" (js-array 4 5) "take-many" (js-array 1 2 3 4 5) "take-negative" (js-array ) "drop-negative" (js-array 1 2 3 4 5) "some" t "every" t "found" 4 "empty-map" (js-array ) "empty-filter" (js-array ) "empty-reduce" 7 "empty-some" false "empty-every" t "missing" nil)))
        (await (checkMap library (js-array "(defportable map")))
        (finally (await (rm directory (js-object :recursive t :force t)))))))))
