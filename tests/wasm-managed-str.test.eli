(module tests.wasm-managed-str.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdir mkdtemp readdir readFile rm writeFile)
  (import "node:path" relative resolve)
  (import "node:os" tmpdir)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/managed-browser-transport.mjs" writeManagedReference)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defconst native-test
    (js-call test :skipIf (or (/= (get process :platform) "darwin") (/= (get process :arch) "arm64"))))

  (defconst root (resolve (get (js* "import.meta") :dir) ".."))
  (defconst source-root
    (let ((env-root (get (get process :env) :ELISCRIPT_NATIVE_MANAGED_SOURCE_ROOT)))
      (resolve (if (nullish? env-root) root env-root))))

  (defconst family
    (str "\n"
         "(defun convert (value) (str value))\n"
         "(defun zero () (str))\n"
         "(defun simple () (js-array (str (js-array 1 2)) (str undefined nil false t (- 0)) (str \"中😀\" \"尾\") (str (js-object))))\n"
         "(defun sparse () (let ((a (js-array 1))) (put a :length 4) (put a 2 nil) (str a)))\n"
         "(defun ordered (mode)\n"
         " (let* ((events (js-array)) (cause (js-object :token 7))\n"
         "  (make (lambda (label) (js-call events :push label)\n"
         "   (js-object :toString (lambda () (js-call events :push (+ \"convert\" label))\n"
         "    (if (and (= mode 1) (= label \"first\")) (throw cause) label))))))\n"
         "  (try (js-array (str (funcall make \"first\") (funcall make \"second\") (funcall make \"third\")) events)\n"
         "   (catch error (js-array (Object/is error cause) events)))))\n"
         "(defun protocol (mode)\n"
         " (let* ((events (js-array)) (v (js-object)))\n"
         "  (when (/= mode 0)\n"
         "   (put v :toString (lambda () (js-call events :push \"toString\") (if (= mode 2) (js-object) \"ordinary\")))\n"
         "   (put v :valueOf (lambda () (js-call events :push \"valueOf\") 7)))\n"
         "  (when (or (= mode 3) (= mode 4))\n"
         "   (put v (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call events :push hint) (if (= mode 4) (funcall (js* \"Symbol\") \"returned\") \"special\"))))\n"
         "  (when (= mode 5) (put v (js* \"Symbol.toPrimitive\") 7))\n"
         "  (when (= mode 6) (put v (js* \"Symbol.toPrimitive\") nil))\n"
         "  (try (js-array (str v) events) (catch error (js-array (aref error \"name\") events)))))\n"
         "(defun symbols () (js-array (str (funcall (js* \"Symbol\"))) (str (funcall (js* \"Symbol\") \"中😀\")) (str (funcall (js* \"Symbol.for\") \"registered\"))))\n"
         "(defun template (value) (js* \"\\u0060\\u0024{value}\\u0060\"))\n"
         "(defun symbol-template () (template (funcall (js* \"Symbol\") \"x\")))\n"
         "(defun cycle () (let ((a (js-array 1))) (js-call a :push a) (str a)))\n"
         "(defun custom-join () (let* ((events (js-array)) (a (js-array 1 2))) (put a :join (lambda () (js-call events :push \"join\") \"custom\")) (js-array (str a) events)))\n"
         "(defun identity (cause) (let ((v (js-object))) (put v (js* \"Symbol.toPrimitive\") (lambda (hint) (throw cause))) (try (str v) (catch error (Object/is error cause)))))\n"
         "(defun allocate (text) (str text text text text text text text text))\n"
         "(export convert zero simple sparse ordered protocol symbols template symbol-template cycle custom-join identity allocate)"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar runtime-source nil)
  (defvar managed-source nil)
  (defvar js nil)

  (defasync managed-for (current label)
    (let ((path (resolve (get current :directory) (str "str-" label ".mjs"))))
      (await (writeFile path (js-call (get current :compiler) :compile_string managed-source "managed.eli")))
      (funcall dynamic-import (get (pathToFileURL path) :href))))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-str-"))))
      (let* ((build-mod (await (funcall dynamic-import (get (pathToFileURL (resolve source-root "tools/backends/build.mjs")) :href))))
             (build-fn (get build-mod :buildBackends)))
        (setq b (await (funcall build-fn (js-object :outputRoot directory))))
        (let ((source (await (readFile (resolve source-root "bootstrap/backends/managed.eli") "utf8")))
              (local (await (readFile (resolve root "bootstrap/backends/managed.eli") "utf8"))))
          (setq managed-source
            (js-call source :replace
              (definition source "lower-managed-text-conversion")
              (definition local "lower-managed-text-conversion")))
          (put b :managed (await (managed-for b "current")))
          (setq runtime-source (await (readFile (resolve source-root "bootstrap/runtime/memory.eli") "utf8")))
          (setq runtime (js-call (get b :compiler) :compile_ir_string runtime-source "runtime.eli"))
          (setq js
            (await (funcall dynamic-import
                     (str "data:text/javascript;base64,"
                          (js-call (Buffer/from (js-call (get b :compiler) :compile_string family "str.eli")) :toString "base64"))))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun make-artifact (&rest __host_default_arguments_1)
    (let* ((source (aref __host_default_arguments_1 0)) (r (aref __host_default_arguments_1 1)) (current (aref __host_default_arguments_1 2)))
    (let* ((src (if (undefined? source) family source))
           (rt (if (undefined? r) runtime r))
           (cur (if (undefined? current) b current))
           (p (js-call (get cur :compiler) :compile_ir_string src "str.eli"))
           (before (JSON/stringify p))
           (bytes (Uint8Array/from (js-call (get cur :managed) :emit_managed_wasm p rt (js-object :abi "managed-module-v1")))))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-call assert :equal (JSON/stringify p) before)
      (js-object :p p :bytes bytes :r rt))))

  (defun read-val (a v)
    (if (and (not (nullish? v)) (= (funcall js-typeof v) "object"))
      (let ((k (get v :kind)))
        (cond
          ((= k 4) (js-call a :readNumber v))
          ((= k 5) (js-call a :readString v))
          ((= k 14)
           (Array/from (js-object :length (js-call a :length v))
             (lambda (_ i)
               (let ((item (js-call a :get v i)))
                 (try
                   (read-val a item)
                   (finally (js-call a :release item)))))))
          (t v)))
      v))

  (defun call-result (a name &rest __host_default_arguments_2)
    (let* ((args (aref __host_default_arguments_2 0)))
    (let ((out (js-call a :invoke name (if (undefined? args) (js-array) args))))
      (try
        (read-val a out)
        (finally (js-call a :release out))))))

  (defun finish (a)
    (try
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (finally
        (let ((close-fn (get a :close)))
          (when (= (funcall js-typeof close-fn) "function")
            (js-call a :close))))))

  (defun opened ()
    (instantiateManagedRuntime (get (make-artifact) :bytes)))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (test "str arrays use the existing full String conversion rather than primitive-only conversion"
    (lambda ()
      (let ((a (opened)))
        (js-call a :auto 1)
        (try
          (js-call assert :deepEqual (call-result a "simple") (js-call js :simple))
          (js-call assert :equal (call-result a "sparse") (js-call js :sparse))
          (finally (finish a))))))

  (test "str zero arguments and all primitive conversions preserve JavaScript exact text"
    (lambda ()
      (let ((a (opened)))
        (js-call a :auto 1)
        (try
          (js-call assert :equal (call-result a "zero") "")
          (js-call (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) 1e-7 1e21 "" "中😀\ud800") :forEach
            (lambda (value)
              (let* ((ty (funcall js-typeof value))
                     (input (cond
                              ((= ty "number") (js-call a :number value))
                              ((= ty "string") (js-call a :string value))
                              (t value))))
                (try
                  (js-call assert :equal (call-result a "convert" (js-array input)) (js-call js :convert value))
                  (finally (js-call a :release input))))))
          (finally (finish a))))))

  (test "str interleaves each operand evaluation with conversion and keeps the original thrown identity"
    (lambda ()
      (let ((a (opened)))
        (js-call a :auto 1)
        (try
          (js-call (js-array 0 1) :forEach
            (lambda (mode)
              (let ((input (js-call a :number mode)))
                (try
                  (js-call assert :deepEqual (call-result a "ordered" (js-array input)) (js-call js :ordered mode))
                  (finally (js-call a :release input))))))
          (js-call (js-array undefined nil false (js-call a :sourceObject (js-object))) :forEach
            (lambda (cause)
              (js-call assert :equal (js-call a :invoke "identity" (js-array cause)) t)
              (js-call a :release cause)))
          (finally (finish a))))))

  (test "str ordinary string-hint fallback and custom ToPrimitive retain the full existing protocol"
    (lambda ()
      (let ((a (opened)))
        (js-call a :auto 1)
        (try
          (let ((mode 0))
            (while (< mode 7)
              (let ((input (js-call a :number mode)))
                (try
                  (js-call assert :deepEqual (call-result a "protocol" (js-array input)) (js-call js :protocol mode))
                  (finally (js-call a :release input))))
              (setq mode (+ mode 1))))
          (js-call assert :deepEqual (call-result a "custom-join") (js-call js :custom_join))
          (finally (finish a))))))

  (test "str allows direct Symbol descriptions while template and Symbol-returning object conversion still reject"
    (lambda ()
      (let ((a (opened)))
        (js-call a :auto 1)
        (try
          (js-call assert :deepEqual (call-result a "symbols") (js-call js :symbols))
          (js-call assert :throws
            (lambda () (js-call a :invoke "symbol-template"))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (finally (finish a))))))

  (test "str retains the established cyclic array error contract and recovers after clearing all private roots"
    (lambda ()
      (let ((a (opened)))
        (js-call a :auto 1)
        (try
          (js-call assert :throws
            (lambda () (js-call a :invoke "cycle"))
            (lambda (e) (diag-code? e "ELI-RT0009")))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
          (js-call assert :equal (call-result a "sparse") (js-call js :sparse))
          (finally (finish a))))))

  (test "str capacity failure preserves caller roots and permits a later conversion"
    (lambda ()
      (let ((a (instantiateManagedRuntime (get (make-artifact) :bytes) (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 16384))))
        (js-call a :auto 1)
        (let* ((input (js-call a :string (js-call "x" :repeat 1800)))
               (held (js-call a :number -0.0))
               (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 held)
          (try
            (js-call assert :throws
              (lambda () (js-call a :invoke "allocate" (js-array input)))
              (lambda (e) (diag-code? e "ELI-RT0002")))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (funcall assert (Object/is (js-call a :readNumber held) -0.0))
            (js-call a :release input)
            (js-call a :collect)
            (js-call assert :equal (call-result a "convert" (js-array held)) "0")
            (finally
              (js-call a :leaveFrame frame)
              (js-call a :release held)
              (finish a)))))))

  (test "str actual runtime memory traps unwind private roots and preserve a caller frame"
    (lambda ()
      (let* ((source (js-call runtime-source :replace
                       (definition runtime-source "heap-join-text")
                       "(defun heap-join-text (heap value) (load-u32 4294967295))"))
             (r (js-call (get b :compiler) :compile_ir_string source "trap-runtime.eli"))
             (a (instantiateManagedRuntime (get (make-artifact family r) :bytes))))
        (js-call a :auto 1)
        (let* ((input (js-call a :number 7))
               (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 input)
          (try
            (js-call assert :throws
              (lambda () (js-call a :invoke "convert" (js-array input)))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :equal (js-call a :readNumber input) 7)
            (js-call assert :equal (call-result a "zero") "")
            (finally
              (js-call a :leaveFrame frame)
              (js-call a :release input)
              (finish a)))))))

  (defasync native-of (code label &rest __host_default_arguments_3)
    (let* ((options (aref __host_default_arguments_3 0)))
    (let* ((opts (if (undefined? options) (js-object) options))
           (lowered (js-call (get b :managed) :lower_managed_program (get code :p) (get code :r) t))
           (before (JSON/stringify (get lowered :typed)))
           (path (resolve directory (str label ".dylib"))))
      (await (writeFile path (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
      (js-call assert :equal (JSON/stringify (get lowered :typed)) before)
      (instantiateNativeManagedRuntime path lowered opts))))

  (funcall native-test "the same str IR executes the complete conversion family in real native memory code"
    (async ()
      (let ((a (await (native-of (make-artifact) "native"))))
        (js-call a :auto 1)
        (try
          (js-call (js-array "zero" "simple" "sparse" "symbols" "custom-join") :forEach
            (lambda (name)
              (js-call assert :deepEqual
                (call-result a name)
                (funcall (aref js (js-call name :replaceAll "-" "_"))))))
          (js-call (js-array 0 1) :forEach
            (lambda (mode)
              (let ((n (js-call a :number mode)))
                (try
                  (js-call assert :deepEqual (call-result a "ordered" (js-array n)) (js-call js :ordered mode))
                  (finally (js-call a :release n))))))
          (let ((mode 0))
            (while (< mode 7)
              (let ((n (js-call a :number mode)))
                (try
                  (js-call assert :deepEqual (call-result a "protocol" (js-array n)) (js-call js :protocol mode))
                  (finally (js-call a :release n))))
              (setq mode (+ mode 1))))
          (js-call (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Infinity "中😀\ud800") :forEach
            (lambda (value)
              (let* ((ty (funcall js-typeof value))
                     (input (cond
                              ((= ty "number") (js-call a :number value))
                              ((= ty "string") (js-call a :string value))
                              (t value))))
                (try
                  (js-call assert :equal (call-result a "convert" (js-array input)) (js-call js :convert value))
                  (finally (js-call a :release input))))))
          (js-call (js-array undefined nil false (js-call a :sourceObject (js-object))) :forEach
            (lambda (cause)
              (js-call assert :equal (js-call a :invoke "identity" (js-array cause)) t)
              (js-call a :release cause)))
          (js-call assert :throws
            (lambda () (js-call a :invoke "symbol-template"))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call assert :throws
            (lambda () (js-call a :invoke "cycle"))
            (lambda (e) (diag-code? e "ELI-RT0009")))
          (js-call assert :equal (call-result a "zero") "")
          (finally (finish a))))))

  (funcall native-test "native str OOM and actual machine memory bounds traps preserve caller roots"
    (async ()
      (let ((small (await (native-of (make-artifact) "native-small" (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 16384)))))
        (js-call small :auto 1)
        (let* ((text (js-call small :string (js-call "x" :repeat 1800)))
               (held (js-call small :number -0.0))
               (frame (js-call small :frame 1)))
          (js-call small :frameSet frame 0 held)
          (try
            (js-call assert :throws
              (lambda () (js-call small :invoke "allocate" (js-array text)))
              (lambda (e) (diag-code? e "ELI-RT0002")))
            (js-call assert :equal (get (js-call small :stats) :frameDepth) 1)
            (js-call small :release text)
            (js-call small :collect)
            (js-call assert :equal (call-result small "convert" (js-array held)) "0")
            (funcall assert (Object/is (js-call small :readNumber held) -0.0))
            (finally
              (js-call small :leaveFrame frame)
              (js-call small :release held)
              (finish small)))))
      (let* ((r (js-call (get b :compiler) :compile_ir_string
                  (js-call runtime-source :replace
                    (definition runtime-source "heap-join-text")
                    "(defun heap-join-text (heap value) (load-u32 4294967295))")
                  "trap-runtime.eli"))
             (a (await (native-of (make-artifact family r) "native-trap")))
             (input (js-call a :number 7))
               (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 input)
        (try
          (js-call assert :throws
            (lambda () (js-call a :invoke "convert" (js-array input)))
            globalThis.WebAssembly.RuntimeError)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :equal (js-call a :readNumber input) 7)
          (js-call assert :equal (call-result a "zero") "")
          (finally
            (js-call a :leaveFrame caller)
            (js-call a :release input)
            (finish a))))))

  (test "Node independently executes the original JS oracle and identical collecting WASM str artifact"
    (async ()
      (let ((code (make-artifact))
            (wasm-path (resolve directory "str-node.wasm"))
            (runner (resolve "tests/helpers/wasm-managed-str-node.mjs"))
            (rt-href (get (pathToFileURL (resolve root "tools/backends/managed-runtime.mjs")) :href))
            (js-code (js-call (get b :compiler) :compile_string family "str.eli")))
        (await (writeFile wasm-path (get code :bytes)))
        (let* ((reference (await (writeManagedReference directory js-code "str-node-reference")))
               (child (spawnSync "node"
                       (js-array runner rt-href (get (pathToFileURL reference) :href) wasm-path)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "str keeps independent Seed and three complete compiler generations at identical JS maps WASM and native bytes"
    (async ()
      (let* ((build-mod (await (funcall dynamic-import (get (pathToFileURL (resolve source-root "tools/backends/build.mjs")) :href))))
             (build-fn (get build-mod :buildBackends))
             (files (js-call (js-call (await (readdir (resolve source-root "bootstrap/compiler")))
                               :filter (lambda (name) (js-call name :endsWith ".eli")))
                      :sort))
             (all (js-array b))
             (previous b)
             (generations (js-array 2 3))
             (gi 0))
        (while (< gi (length generations))
          (let* ((generation (aref generations gi))
                 (output (resolve directory (str "g" generation)))
                 (bootstrap (resolve output "bootstrap"))
                 (fi 0))
            (await (mkdir bootstrap (js-object :recursive t)))
            (while (< fi (length files))
              (let* ((file (aref files fi))
                     (path (resolve source-root "bootstrap/compiler" file))
                     (name (js-call file :replace (js* "/\\.eli$/") ".mjs"))
                     (source (await (readFile path "utf8")))
                     (emission (js-call (get previous :compiler) :compile_string_with_source_map source path name (relative bootstrap path))))
                (await (writeFile (resolve bootstrap name) (str (get emission :javascript) "//# sourceMappingURL=" name ".map\n")))
                (await (writeFile (resolve bootstrap (str name ".map")) (get emission :sourceMap))))
              (setq fi (+ fi 1)))
            (let ((current (await (funcall build-fn (js-object :outputRoot output :frontend (get previous :compiler))))))
              (put current :compiler (await (funcall dynamic-import (get (pathToFileURL (resolve bootstrap "compiler.mjs")) :href))))
              (put current :managed (await (managed-for current (str "g" generation))))
              (js-call all :push current)
              (setq previous current)))
          (setq gi (+ gi 1)))
        (let ((fi 0))
          (while (< fi (length files))
            (let* ((file (aref files fi))
                   (path (resolve source-root "bootstrap/compiler" file))
                   (source (await (readFile path "utf8")))
                   (name (js-call file :replace (js* "/\\.eli$/") ".mjs"))
                   (reference (js-call (get b :compiler) :compile_string_with_source_map source path name (str "../compiler/" file))))
              (js-call (js-call all :slice 1) :forEach
                (lambda (current)
                  (js-call assert :deepEqual
                    (js-call (get current :compiler) :compile_string_with_source_map source path name (str "../compiler/" file))
                    reference))))
            (setq fi (+ fi 1))))
        (let ((filename (resolve directory "str.eli"))
              (seed-output (resolve directory "str-seed.mjs")))
          (await (writeFile filename family))
          (let ((child (spawnSync (resolve source-root "bin/eliscript-seed")
                         (js-array "--output" seed-output filename)
                         (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (get child :stderr)))
          (let* ((javascript (await (readFile seed-output "utf8")))
                 (seed (await (funcall build-fn (js-object :outputRoot (resolve directory "seed") :seed t))))
                 (managed-input (resolve directory "managed-str.eli"))
                 (managed-output (resolve (get seed :directory) "str-seed-managed.mjs")))
            (await (writeFile managed-input managed-source))
            (let ((managed-child (spawnSync (resolve source-root "bin/eliscript-seed")
                                   (js-array "--output" managed-output managed-input)
                                   (js-object :encoding "utf8" :timeout 30000))))
              (js-call assert :equal (get managed-child :status) 0 (get managed-child :stderr)))
            (put seed :managed (await (funcall dynamic-import (get (pathToFileURL managed-output) :href))))
            (js-call all :push seed)
            (let ((outputs (js-array))
                  (native-outputs (js-array)))
              (js-call all :forEach
                (lambda (current)
                  (let* ((p (js-call (get current :compiler) :compile_ir_string family filename))
                         (r (js-call (get current :compiler) :compile_ir_string runtime-source "runtime.eli")))
                    (js-call assert :equal (js-call (get current :compiler) :emit_ir_string p) javascript)
                    (let ((before (JSON/stringify p)))
                      (js-call outputs :push
                        (Uint8Array/from (js-call (get current :managed) :emit_managed_wasm p r (js-object :abi "managed-module-v1"))))
                      (let ((lowered (js-call (get current :managed) :lower_managed_program p r t)))
                        (js-call native-outputs :push
                          (Uint8Array/from (js-call (get current :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
                      (js-call assert :equal (JSON/stringify p) before)))))
              (js-call (js-call outputs :slice 1) :forEach
                (lambda (output) (js-call assert :deepEqual output (aref outputs 0))))
              (js-call (js-call native-outputs :slice 1) :forEach
                (lambda (output) (js-call assert :deepEqual output (aref native-outputs 0))))
              (let ((a (instantiateManagedRuntime (aref outputs 2))))
                (js-call a :auto 1)
                (try
                  (js-call (js-array "simple" "sparse" "symbols" "custom-join") :forEach
                    (lambda (name)
                      (js-call assert :deepEqual
                        (call-result a name)
                        (funcall (aref js (js-call name :replaceAll "-" "_"))))))
                  (finally (finish a)))))))))
    120000))
