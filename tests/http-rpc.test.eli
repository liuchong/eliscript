(module tests.http-rpc.test
  (import "bun:test" expect test)
  (import "../runtime/wire/http-rpc.mjs" createService createClient discoveryCandidates pathIndexMarkdown)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync reject (promise &rest __host_default_arguments_1)
    (let* ((message (aref __host_default_arguments_1 0))) (if (= message undefined) (await (js-call (get (expect promise) :rejects) :toThrow)) (await (js-call (get (expect promise) :rejects) :toThrow message)))))
  (test "hierarchical HTTP discovery and usage never execute operations; invocation uses POST" (async ()
    (let* ((calls 0)
           (service (createService (js-object :title "Example" :operations (js-array
             (js-object :path "/math/add" :title "Add" :request "JSON a,b" :success "200 JSON sum" :effect "Read only"
               :execute (async (req) (setq calls (1+ calls)) (let ((data (await (js-call req :json)))) (Response/json (js-object :sum (+ (get data :a) (get data :b)))))))
             (js-object :path "/math" :title "Math" :execute (lambda () (new globalThis.Response "math")))))))
           (fetch (lambda (url options) (service (new globalThis.Request url options))))
           (client (createClient (js-object :fetch fetch)))
           (discovery (await (js-call client :discover "https://example.test/"))))
      (be (get discovery :state) "found") (same (get discovery :paths) (js-array "/math"))
      (let ((index (await (js-call client :index "https://example.test/math?secret=removed"))))
        (js-call (expect (get index :body)) :toContain "operation and directory")
        (js-call (expect (get index :body)) :toContain "`/math/add`"))
      (js-call (expect (get (await (js-call client :usage "https://example.test/math/add?.gepo&x=1")) :body)) :toContain "POST `/math/add`")
      (be calls 0) (await (reject (js-call client :invoke "https://example.test/math/add" "{}"))) (be calls 0)
      (let ((reply (await (js-call client :invoke "https://example.test/math/add" "{\"a\":2,\"b\":3}" (js-object :allowPost t :contentType "application/json")))))
        (same (JSON/parse (get reply :body)) (js-object :sum 5)))
      (be calls 1)
      (be (get (await (service (new globalThis.Request "https://example.test/math/add?.gepo=false"))) :status) 200)
      (js-call (expect (get (await (service (new globalThis.Request "https://example.test/math/add" (js-object :method "HEAD")))) :body)) :toBeNull)
      (let ((headIndex (await (service (new globalThis.Request "https://example.test/.gepo" (js-object :method "HEAD"))))))
        (be (get headIndex :status) 200) (js-call (expect (get headIndex :body)) :toBeNull))
      (be (js-call (get (await (service (new globalThis.Request "https://example.test/.gepo" (js-object :method "OPTIONS")))) :headers) :get "Allow") "GET, HEAD, OPTIONS")
      (be (get (await (service (new globalThis.Request "https://example.test/.gepo" (js-object :method "POST")))) :status) 405)
      (be (get (await (service (new globalThis.Request "https://example.test/math" (js-object :method "DELETE")))) :status) 405))))
  (test "fallback validates response content, distinguishes empty, and strips unrelated queries" (async ()
    (let* ((urls (js-array))
           (client (createClient (js-object :fetch (async (url options)
             (js-call urls :push (funcall globalThis.String url)) (be (get options :redirect) "manual")
             (if (= (get urls :length) 1)
               (new globalThis.Response "<html>GEPO</html>" (js-object :headers (js-object "Content-Type" "text/html")))
               (new globalThis.Response (pathIndexMarkdown "Empty" (js-array) "/") (js-object :headers (js-object "Content-Type" "text/markdown")))))))))
      (be (get (await (js-call client :discover "https://example.test/?secret=x#fragment")) :state) "empty")
      (same urls (js-array "https://example.test/?.gepo" "https://example.test/.gepo"))
      (be (aref (discoveryCandidates "https://example.test/a?secret=x") 0) "https://example.test/a?.gepo")
      (let* ((rootService (createService (js-object :operations (js-array (js-object :path "/" :execute (lambda () (new globalThis.Response "root")))))))
             (rootClient (createClient (js-object :fetch (lambda (url options) (rootService (new globalThis.Request url options)))))))
        (be (get (await (js-call rootClient :discover "https://example.test")) :state) "found"))
      (js-call (expect (lambda () (createService (js-object :operations (js-array (js-object :path "/a/../b" :execute (lambda () undefined))))))) :toThrow)
      (await (reject (js-call client :discover "https://user:password@example.test"))))))
  (test "HTTP authorization, bounded bodies, redirects and lost POST responses retain their boundaries" (async ()
    (let* ((calls 0) (service (createService (js-object :operations (js-array (js-object :path "/private" :execute (lambda () (setq calls (1+ calls)) (new globalThis.Response "done")))) :authorize (lambda () false)))))
      (be (get (await (service (new globalThis.Request "https://example.test/private" (js-object :method "POST")))) :status) 403) (be calls 0))
    (let ((client (createClient (js-object :fetch (async () (new globalThis.Response "12345")) :maxBytes 4))))
      (await (reject (js-call client :usage "https://example.test/a") "limit")))
    (let ((redirect (createClient (js-object :fetch (async () (new globalThis.Response nil (js-object :status 302 :headers (js-object :Location "https://elsewhere.test/"))))))))
      (await (reject (js-call redirect :usage "https://example.test/a") "Redirect")))
    (let* ((posts 0) (loss (createClient (js-object :fetch (async (url opts)
      (if (= (get opts :method) "POST") (progn (setq posts (1+ posts)) (throw (new globalThis.Error "lost"))) (new globalThis.Response "usage")))))))
      (await (reject (js-call loss :invoke "https://example.test/a" "" (js-object :allowPost t)) "lost")) (be posts 1))
    (let ((timeout (createClient (js-object :fetch (lambda () (new globalThis.Promise (lambda () undefined))) :timeoutMs 10))))
      (await (reject (js-call timeout :usage "https://example.test/a") "timeout")))
    (let ((stalledBody (createClient (js-object :fetch (async () (new globalThis.Response (new globalThis.ReadableStream (js-object :pull (lambda () undefined))))) :timeoutMs 10))))
      (await (reject (js-call stalledBody :usage "https://example.test/a") "timeout")))
    (let ((aborted (new globalThis.AbortController)) (requests 0))
      (js-call aborted :abort (new globalThis.Error "cancelled"))
      (let ((cancelled (createClient (js-object :fetch (async () (setq requests (1+ requests)) (new globalThis.Response "bad"))))))
        (await (reject (js-call cancelled :usage "https://example.test/a" (js-object :signal (get aborted :signal))) "cancelled")) (be requests 0)))))
  (test "identity visibility and application representations remain service-defined" (async ()
    (let* ((service (createService (js-object :operations (js-array
              (js-object :path "/public/read" :execute (lambda () (Response/json (js-object :ok t))))
              (js-object :path "/private/read" :execute (lambda () (new globalThis.Response "secret"))))
             :visible (lambda (request operation) (or (not (js-call (get operation :path) :startsWith "/private")) (= (js-call (get request :headers) :get "Authorization") "example-user")))
             :authorize (lambda (request) (if (not (= (get request :method) "POST")) t (new globalThis.Response "Sign in" (js-object :status 401)))))))
           (publicIndex (await (js-call (await (service (new globalThis.Request "https://example.test/?.gepo"))) :text))))
      (js-call (expect publicIndex) :toContain "`/public`") (js-call (get (expect publicIndex) :not) :toContain "/private")
      (let ((privateIndex (await (js-call (await (service (new globalThis.Request "https://example.test/?.gepo" (js-object :headers (js-object :Authorization "example-user"))))) :text))))
        (js-call (expect privateIndex) :toContain "`/private`"))
      (be (get (await (service (new globalThis.Request "https://example.test/public/read" (js-object :method "POST")))) :status) 401))
    (let* ((notFound (createClient (js-object :fetch (async () (new globalThis.Response "ordinary site"))))) (failure (await (js-call notFound :discover "https://example.test"))))
      (be (get failure :state) "not-found") (js-call (expect (get failure :attempts)) :toHaveLength 3))
    (let ((json (createClient (js-object :fetch (async () (Response/json (js-object :protocol "GEPO" :children (js-array "/api"))))
        :classify (lambda (response) (let ((body (JSON/parse (get response :body)))) (js-object :accepted (= (get body :protocol) "GEPO") :paths (get body :children) :empty (= (get (get body :children) :length) 0))))))))
      (same (get (await (js-call json :discover "https://example.test")) :paths) (js-array "/api")))))
)
