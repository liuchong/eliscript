(module tests.wasm-managed-function-properties.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp mkdir rm writeFile symlink realpath)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/testing/managed-function-properties-repairs.mjs" currentHostBuiltinShape runFunctionMissingDisposal)
  (import "./helpers/wasm-managed-function-properties-node.mjs"
          standard-error-own-names error-stack-extensions standard-restricted-descriptors
          well-known-symbol-names reflection-keys constant-names integer-cases float-cases)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst standard-error-shape
    (JSON/stringify (js-array (js-array) standard-error-own-names (js-array) t (js-array "function" "" 0 false t))))

  (defconst reflection-source
    (str
      "\n  (defun reflection-normalize (value owner)\n"
      "    (cond\n"
      "      ((= value undefined) (js-array \"undefined\"))\n"
      "      ((= value nil) (js-array \"null\"))\n"
      "      ((= (value-type value) \"function\")\n"
      "        (js-array \"function\" (get value :name) (get value :length)\n"
      "          (Object/hasOwn value \"prototype\") (Object/is value (get globalThis/Function :prototype))))\n"
      "      ((= (value-type value) \"object\") (js-array \"object\" (Object/is value (get owner :prototype))))\n"
      "      ((= (value-type value) \"symbol\") (js-array \"symbol\" (globalThis/String value)))\n"
      "      (t (js-array \"value\" value))))\n"
      "  (defun reflection-snapshot (mode key)\n"
      "    (let* ((owner (choose mode)) (descriptor (Object/getOwnPropertyDescriptor owner key)))\n"
      "      (JSON/stringify (js-array\n"
      "        (try (js-array \"value\" (reflection-normalize (aref owner key) owner))\n"
      "          (catch error (js-array \"throw\" (get error :name))))\n"
      "        (object-has? owner key) (Object/hasOwn owner key)\n"
      "        (if (= descriptor undefined) (js-array \"undefined\")\n"
      "          (js-array \"descriptor\" (Object/hasOwn descriptor \"value\")\n"
      "            (reflection-normalize (get descriptor :value) owner)\n"
      "            (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable)\n"
      "            (reflection-normalize (get descriptor :get) owner)\n"
      "            (reflection-normalize (get descriptor :set) owner)))))))\n"
      "  (defun reflection-shape (mode)\n"
      "    (let ((symbol-names (js-array)) (symbol-keys (symbols mode)) (symbol-index 0))\n"
      "      (while (< symbol-index (js-length symbol-keys))\n"
      "        (js-call symbol-names :push (globalThis/String (aref symbol-keys symbol-index)))\n"
      "        (setq symbol-index (1+ symbol-index)))\n"
      "      (JSON/stringify (js-array (keys mode) (names mode) symbol-names\n"
      "        (Object/is (prototype mode) (get globalThis/Function :prototype))\n"
      "        (reflection-normalize (prototype mode) (choose mode))))))\n"
      "  (defvar reflection-trace nil)\n"
      "  (defun reflection-method (argument)\n"
      "    (js-call reflection-trace :push (js-array \"call\" (Object/is (js* \"this\") ordinary))) argument)\n"
      "  (defun reflection-effects (mode)\n"
      "    (let* ((trace (js-array)) (sentinel (js-object :reason \"getter\")))\n"
      "      (setq reflection-trace trace)\n"
      "      (Object/defineProperty ordinary \"probe\"\n"
      "        (js-object :configurable t :get (lambda ()\n"
      "          (js-call trace :push \"get\")\n"
      "          (cond ((= mode 1) (throw sentinel)) ((= mode 2) 7) (t reflection-method)))))\n"
      "      (try\n"
      "        (JSON/stringify (js-array\n"
      "          (try (js-call ordinary :probe (progn (js-call trace :push \"argument\") 12))\n"
      "            (catch error (if (Object/is error sentinel) \"same getter error\" (get error :name)))) trace))\n"
      "        (finally (Reflect/deleteProperty ordinary \"probe\") (setq reflection-trace nil)))))\n"
      "  (defun static-number (mode input radix)\n"
      "    (if (= mode 0) (js-call globalThis/Number :parseInt input radix)\n"
      "      (js-call globalThis/Number :parseFloat input)))\n"
      "  (defun detached-number (mode input radix)\n"
      "    (funcall (get globalThis/Number (if (= mode 0) \"parseInt\" \"parseFloat\")) input radix))\n"
      "  (defun static-string (mode arguments)\n"
      "    (js-call (get globalThis/String (if (= mode 0) \"fromCharCode\" \"fromCodePoint\")) :apply undefined arguments))\n"
      "  (defun static-constant (key) (get globalThis/Number key))\n"
      "  (defun code-effects (mode)\n"
      "    (let* ((trace (js-array)) (first (js-object)) (second (js-object)) (sentinel (js-object)))\n"
      "      (put first (get globalThis/Symbol :toPrimitive) (lambda (hint)\n"
      "        (js-call trace :push (str \"first:\" hint)) (if (= mode 1) (throw sentinel) 65)))\n"
      "      (put second (get globalThis/Symbol :toPrimitive) (lambda (hint)\n"
      "        (js-call trace :push (str \"second:\" hint)) 128512))\n"
      "      (JSON/stringify (js-array\n"
      "        (try (js-call globalThis/String :fromCodePoint first second) (catch error (Object/is error sentinel))) trace))))\n"
      "  (defun static-order (mode)\n"
      "    (let* ((trace (js-array)) (sentinel (js-object)) (input (js-object)) (radix (js-object)))\n"
      "      (put input (get globalThis/Symbol :toPrimitive) (lambda (hint)\n"
      "        (js-call trace :push (str \"input:\" hint))\n"
      "        (if (= mode 1) (throw sentinel) \"  -fftail\")))\n"
      "      (put radix (get globalThis/Symbol :toPrimitive) (lambda (hint)\n"
      "        (js-call trace :push (str \"radix:\" hint))\n"
      "        (if (= mode 2) (throw sentinel) 16)))\n"
      "      (JSON/stringify (js-array\n"
      "        (try (js-call globalThis/Number :parseInt input radix (progn (js-call trace :push \"extra\") 9))\n"
      "          (catch error (Object/is error sentinel))) trace))))\n"
      "  (defun raw-order (mode)\n"
      "    (let* ((trace (js-array)) (raw (js-object)) (template (js-object))\n"
      "           (first (js-object)) (second (js-object)) (sentinel (js-object)))\n"
      "      (Object/defineProperty template \"raw\" (js-object :get (lambda ()\n"
      "        (js-call trace :push \"raw\") (if (= mode 1) (throw sentinel) raw))))\n"
      "      (Object/defineProperty raw \"length\" (js-object :get (lambda () (js-call trace :push \"length\") (if (= mode 2) 0 3))))\n"
      "      (Object/defineProperty raw \"0\" (js-object :get (lambda () (js-call trace :push \"0\") \"A\")))\n"
      "      (Object/defineProperty raw \"1\" (js-object :get (lambda () (js-call trace :push \"1\") \"B\")))\n"
      "      (Object/defineProperty raw \"2\" (js-object :get (lambda () (js-call trace :push \"2\") \"C\")))\n"
      "      (put first (get globalThis/Symbol :toPrimitive) (lambda (hint)\n"
      "        (js-call trace :push (str \"first:\" hint)) (if (= mode 3) (throw sentinel) \"X\")))\n"
      "      (put second (get globalThis/Symbol :toPrimitive) (lambda (hint) (js-call trace :push (str \"second:\" hint)) \"Y\"))\n"
      "      (JSON/stringify (js-array\n"
      "        (try (js-call globalThis/String :raw template first second) (catch error (Object/is error sentinel))) trace))))\n"
      "  (defun restricted-descriptors ()\n"
      "    (let* ((prototype (get globalThis/Function :prototype))\n"
      "           (a (Object/getOwnPropertyDescriptor prototype \"caller\"))\n"
      "           (b (Object/getOwnPropertyDescriptor prototype \"arguments\")) (getter (get a :get))\n"
      "           (trace (js-array)))\n"
      "      (JSON/stringify (js-array (Object/is getter (get a :set))\n"
      "        (Object/is getter (get b :get)) (Object/is getter (get b :set))\n"
      "        (get a :enumerable) (get a :configurable) (get getter :name) (get getter :length)\n"
      "        (Object/isExtensible getter) (Object/hasOwn getter \"prototype\")\n"
      "        (get (Object/getOwnPropertyDescriptor getter \"name\") :configurable)\n"
      "        (get (Object/getOwnPropertyDescriptor getter \"length\") :configurable)\n"
      "        (try (funcall getter (progn (js-call trace :push \"argument\") 9)) (catch error (get error :name))) trace))))\n"
      "  (defun parser-aliases ()\n"
      "    (let* ((constructor globalThis/Number) (integer (get constructor :parseInt)) (floating (get constructor :parseFloat))\n"
      "           (global-integer (js* \"parseInt\")) (global-floating (js* \"globalThis.parseFloat\"))\n"
      "           (before (js-array (Object/is integer global-integer) (Object/is floating global-floating))))\n"
      "      (try\n"
      "        (put constructor :parseInt (lambda (input radix) 77))\n"
      "        (Reflect/deleteProperty constructor \"parseFloat\")\n"
      "        (JSON/stringify (js-array before\n"
      "          (Object/is (js* \"parseInt\") integer) (Object/is (js* \"globalThis.parseInt\") integer)\n"
      "          (Object/is (js* \"parseFloat\") floating) (Object/is (js* \"globalThis.parseFloat\") floating)\n"
      "          (js-call constructor :parseInt \"10\" 10) (funcall (js* \"globalThis.parseInt\") \"10\" 10)\n"
      "          (funcall (js* \"parseFloat\") \"1.5tail\") (get constructor :parseFloat)))\n"
      "        (finally (put constructor :parseInt integer) (put constructor :parseFloat floating)))))\n"
      "  (defun static-shadow ()\n"
      "    (let ((parseInt (lambda (input radix) 88))\n"
      "          (String (js-object :fromCharCode (lambda (input) \"shadow\"))))\n"
      "      (JSON/stringify (js-array (funcall (js* \"parseInt\") \"1\" 10)\n"
      "        (funcall (js* \"globalThis.parseInt\") \"1\" 10) (js-call String :fromCharCode 65)\n"
      "        (js-call globalThis/String :fromCharCode 65)))))\n"
      "  (defun descriptor-field (descriptor key) (get descriptor key))\n"
      "  (defun symbol-static (index)\n"
      "    (aref (js-array "
      (js-call (js-call well-known-symbol-names :map (lambda (name) (str "(js* \"Symbol." name "\")"))) :join " ")
      ") index))\n"
      "  (defun symbol-dynamic (key) (get globalThis/Symbol key))\n"
      "  (defun symbol-alias (key)\n"
      "    (let ((constructor globalThis/Symbol)) (get constructor key)))\n"
      "  (defun symbol-same (left right) (Object/is left right))\n"
      "  (defun symbol-description (value) (get value :description))\n"
      "  (defun symbol-text (value) (globalThis/String value))\n"
      "  (defun symbol-key (object key value) (put object key value) (get object key))\n"
      "  (defun symbol-own-keys (object) (Object/getOwnPropertySymbols object))\n"
      "  (defun symbol-key-for (value) (Symbol/keyFor value))\n"
      "  (defun error-stack-observation ()\n"
      "    (let ((error (funcall (choose 3) \"stack boundary\")))\n"
      "      (try (js-array \"value\" (value-type (get error :stack)))\n"
      "        (catch failure (js-array \"unsupported\" (get (get failure :eliscriptDiagnostic) :code))))))\n"
      "  (export descriptor-field error-stack-observation reflection-snapshot reflection-shape reflection-effects static-number detached-number static-string static-constant code-effects static-order raw-order restricted-descriptors parser-aliases static-shadow symbol-static symbol-dynamic symbol-alias symbol-same symbol-description symbol-text symbol-key symbol-own-keys symbol-key-for)\n"))

  (defconst string-cases
    (js-array
      (js-array)
      (js-array 0 -0.0 65 65535 65536 -1 (get globalThis.Number :NaN) (get globalThis.Number :POSITIVE_INFINITY))
      (js-array 65 128512 55296 1114111)))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar bytes undefined)
  (defvar lowered undefined)
  (defvar js undefined)
  (defvar oracle undefined)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-function-builtin-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get b :compiler) :compile_ir_string
                      (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                      "runtime.eli"))
      (let* ((original (await (readFile "tests/fixtures/wasm-managed-function-properties.eli" "utf8")))
             (end (js-call original :lastIndexOf ")"))
             (source (str (js-call original :slice 0 end) reflection-source (js-call original :slice end))))
        (setq program (js-call (get b :compiler) :compile_ir_string source "function-builtin.eli"))
        (let* ((saved (JSON/stringify program))
               (javascript (js-call (get b :compiler) :emit_ir_string program))
               (reference (resolve directory "function-builtin.mjs")))
          (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
          (try (await (symlink (resolve ".") (resolve directory "node_modules/eliscript") "dir"))
          (catch error
            (unless (= (get error :code) "EEXIST") (throw error))
            (js-call assert :strictEqual (await (realpath (resolve directory "node_modules/eliscript")))
              (await (realpath (resolve "."))))))
          (await (writeFile reference javascript))
          (setq js (await (funcall dynamic-import
                            (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64")))))
          (setq lowered (js-call (get b :managed) :lower_managed_program program runtime))
          (setq bytes (globalThis.Uint8Array.from (js-call (get b :managed) :emit_managed_wasm program runtime)))
          (js-call assert :equal (JSON/stringify program) saved)
          (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (let ((child (spawnSync "node"
                         (js-array (resolve "tests/helpers/wasm-managed-function-properties-node.mjs")
                                   "--run-oracle"
                                   (get (pathToFileURL reference) :href))
                         (js-object :encoding "utf8" :timeout 30000))))
            (when (and (get child :stderr) (> (js-length (get child :stderr)) 0))
              (js-call (get globalThis.process :stderr) :write (get child :stderr)))
            (js-call assert :equal (get child :error) undefined)
            (js-call assert :equal (get child :signal) nil)
            (js-call assert :equal (get child :status) 0
              (let ((se (get child :stderr)))
                (if (and se (> (js-length se) 0)) se (get child :stdout))))
            (setq oracle (JSON/parse (get child :stdout)))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (test "independent Node restricted accessors satisfy the complete standard ThrowTypeError descriptor contract"
    (lambda ()
      ;; Deliberately retain the original strict comparison as its own gate. A host
      ;; ground-accessor difference is a failure, never a skipped or accepted result.
      (js-call assert :equal (get oracle :restricted) (get oracle :restrictedStandard))))

  (defun read-val (a v)
    (let ((kind (if (nullish? v) undefined (get v :kind))))
      (cond
        ((= kind 4) (js-call a :readNumber v))
        ((= kind 5) (js-call a :readString v))
        ((= kind 14)
         (let ((out (js-array))
               (len (js-call a :length v))
               (i 0))
           (while (< i len)
             (let ((x (js-call a :get v i)))
               (try
                 (js-call out :push (read-val a x))
                 (finally (js-call a :release x))))
             (setq i (1+ i)))
           out))
        (t v))))

  (defun call-value (a name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (let ((result (js-call a :invoke name (if (undefined? args) (js-array) args))))
      (try
        (read-val a result)
        (finally (js-call a :release result))))))

  (defun finish (a)
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun check-well-known-symbols (a)
    (js-call a :auto 1)
    (let* ((object (js-call a :sourceObject (js-object)))
           (held (js-call a :number -0.0))
           (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 held)
      (try
        (progn
          (let ((index 0))
            (while (< index (js-length well-known-symbol-names))
              (let* ((name (aref well-known-symbol-names index))
                     (position (js-call a :number index))
                     (key (js-call a :string name))
                     (symbol (js-call a :invoke "symbol-static" (js-array position)))
                     (dynamic undefined)
                     (alias undefined)
                     (incoming undefined)
                     (out undefined))
                (try
                  (progn
                    (setq dynamic (js-call a :invoke "symbol-dynamic" (js-array key)))
                    (setq alias (js-call a :invoke "symbol-alias" (js-array key)))
                    (js-call assert :equal (js-call a :invoke "symbol-same" (js-array symbol dynamic)) t name)
                    (js-call assert :equal (js-call a :invoke "symbol-same" (js-array symbol alias)) t name)
                    (js-call assert :equal (call-value a "symbol-description" (js-array symbol)) (str "Symbol." name))
                    (js-call assert :equal (call-value a "symbol-text" (js-array symbol)) (str "Symbol(Symbol." name ")"))
                    (js-call assert :equal (js-call a :invoke "symbol-key-for" (js-array symbol)) undefined)
                    (js-call assert :equal (js-call a :toHostValue symbol) (get globalThis.Symbol name) name)
                    (setq incoming (js-call a :fromHostValue (get globalThis.Symbol name)))
                    (js-call assert :equal (js-call a :invoke "symbol-same" (js-array symbol incoming)) t name)
                    (setq out (js-call a :invoke "symbol-key" (js-array object incoming held)))
                    (funcall assert (Object/is (js-call a :readNumber out) -0.0)))
                  (finally
                    (js-call (js-array position key symbol dynamic alias incoming out) :forEach
                      (lambda (root) (unless (undefined? root) (js-call a :release root))))))
                (js-call a :collect)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                (funcall assert (Object/is (js-call a :readNumber held) -0.0)))
              (setq index (1+ index))))
          (let ((keys (js-call a :invoke "symbol-own-keys" (js-array object))))
            (try
              (progn
                (js-call assert :equal (js-call a :length keys) (js-length well-known-symbol-names))
                (let ((index 0))
                  (while (< index (js-length well-known-symbol-names))
                    (let* ((name (aref well-known-symbol-names index))
                           (symbol (js-call a :get keys index))
                           (key (js-call a :string name))
                           (again (js-call a :invoke "symbol-alias" (js-array key))))
                      (try
                        (progn
                          (js-call assert :equal (js-call a :invoke "symbol-same" (js-array symbol again)) t name)
                          (js-call assert :equal (js-call a :toHostValue symbol) (get globalThis.Symbol name) name))
                        (finally
                          (js-call a :release symbol)
                          (js-call a :release key)
                          (js-call a :release again))))
                    (setq index (1+ index)))))
              (finally (js-call a :release keys)))))
        (finally
          (js-call a :leaveFrame frame)
          (js-call a :release object)
          (js-call a :release held)))))

  (defun check-builtins (a)
    (js-call a :auto 1)
    (let ((mode 0))
      (while (< mode 5)
        (let ((n (js-call a :number mode)))
          (try
            (progn
              (js-call reflection-keys :forEach
                (lambda (name)
                  (let ((key (js-call a :string name)))
                    (try
                      (js-call assert :equal
                        (call-value a "reflection-snapshot" (js-array n key))
                        (get (get (aref (get oracle :builtins) mode) :fields) name)
                        (str mode "/" name))
                      (finally (js-call a :release key))))))
              (js-call assert :equal
                (call-value a "reflection-shape" (js-array n))
                (if (= mode 3) standard-error-shape (currentHostBuiltinShape mode))
                (str "standard own keys/names/symbols/prototype " mode)))
            (finally (js-call a :release n)))
          (js-call a :collect)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
        (setq mode (1+ mode))))
    (check-well-known-symbols a))

  (defun check-ordinary (a)
    (let ((mode (js-call a :number 5)))
      (js-call a :auto 1)
      (try
        (js-call (js-array "kind" "isFinite") :forEach
          (lambda (name)
            (let ((key (js-call a :string name)))
              (try
                (progn
                  (js-call assert :equal (call-value a "read" (js-array mode key)) (js-call js :read 5 name))
                  (js-call assert :equal (call-value a "has" (js-array mode key)) (js-call js :has 5 name))
                  (let ((descriptor (js-call a :invoke "descriptor" (js-array mode key))))
                    (try
                      (progn
                        (js-call assert :equal descriptor (js-call js :descriptor 5 name))
                        (js-call assert :equal descriptor undefined))
                      (finally (js-call a :release descriptor)))))
                (finally (js-call a :release key))))))
        (finally (js-call a :release mode)))))

  (defun check-calls (a)
    (js-call a :auto 1)
    (let ((str-val (js-call a :string "12"))
          (num-val (js-call a :number 2))
          (mode (js-call a :number 0))
          (key (js-call a :string "isFinite"))
          (i 0))
      (try
        (while (< i 4)
          (js-call assert :equal (call-value a "has" (js-array mode key)) t)
          (js-call assert :deepEqual (call-value a "cached") (js-call js :cached))
          (js-call assert :equal (call-value a "call-number" (js-array str-val)) (js-call js :call_number "12"))
          (js-call assert :equal (call-value a "call-string" (js-array num-val)) (js-call js :call_string 2))
          (js-call assert :equal (call-value a "call-finite" (js-array num-val)) (js-call js :call_finite 2))
          (js-call assert :equal (call-value a "static-finite" (js-array num-val)) (js-call js :static_finite 2))
          (js-call assert :equal (call-value a "call-symbol") (js-call js :call_symbol))
          (js-call assert :equal (call-value a "call-error") (js-call js :call_error))
          (js-call assert :deepEqual (call-value a "effects") (js-call js :effects))
          (let ((effect 0))
            (while (< effect 3)
              (let ((n (js-call a :number effect)))
                (try
                  (js-call assert :equal (call-value a "reflection-effects" (js-array n)) (aref (get oracle :effects) effect))
                  (finally (js-call a :release n))))
              (setq effect (1+ effect))))
          (js-call a :collect)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
          (setq i (1+ i)))
        (finally
          (js-call a :release str-val)
          (js-call a :release num-val)
          (js-call a :release mode)
          (js-call a :release key)))))

  (defun number-from-record (rec)
    (if (get rec :nan)
      (get globalThis.Number :NaN)
      (let* ((buf (new globalThis.ArrayBuffer 8))
             (view (new globalThis.DataView buf))
             (words (get rec :words)))
        (js-call view :setUint32 0 (aref words 0) t)
        (js-call view :setUint32 4 (aref words 1) t)
        (js-call view :getFloat64 0 t))))

  (defun source-primitive (a value)
    (cond
      ((= (value-type value) "string") (js-call a :string value))
      ((= (value-type value) "number") (js-call a :number value))
      (t value)))

  (defun check-standard-statics (a)
    (js-call a :auto 1)
    (let ((index 0))
      (while (< index (js-length constant-names))
        (let ((key (js-call a :string (aref constant-names index)))
              (mode (js-call a :number 0))
              (output undefined)
              (snapshot undefined))
          (try
            (progn
              (setq output (js-call a :invoke "static-constant" (js-array key)))
              (funcall assert (Object/is (js-call a :readNumber output) (number-from-record (aref (get oracle :constants) index))))
              (setq snapshot (js-call a :invoke "reflection-snapshot" (js-array mode key)))
              (let ((descriptor (aref (JSON/parse (js-call a :readString snapshot)) 3)))
                (js-call assert :equal (aref descriptor 0) "descriptor")
                (js-call assert :equal (aref descriptor 1) t)
                (js-call assert :deepEqual (js-call descriptor :slice 3 6) (js-array false false false))))
            (finally
              (js-call a :release key)
              (js-call a :release mode)
              (unless (undefined? output) (js-call a :release output))
              (unless (undefined? snapshot) (js-call a :release snapshot)))))
        (setq index (1+ index))))
    (let ((mode 0))
      (while (< mode 2)
        (let ((n (js-call a :number mode))
              (cases (if (= mode 0)
                       integer-cases
                       (js-call float-cases :map (lambda (input) (js-array input undefined)))))
              (index 0))
          (try
            (while (< index (js-length cases))
              (let* ((pair (aref cases index))
                     (input (source-primitive a (aref pair 0)))
                     (radix (source-primitive a (aref pair 1)))
                     (output undefined))
                (try
                  (progn
                    (setq output (js-call a :invoke
                                   (if (= (% index 2) 0) "static-number" "detached-number")
                                   (js-array n input radix)))
                    (funcall assert
                      (Object/is (js-call a :readNumber output)
                                 (number-from-record (aref (if (= mode 0) (get oracle :ints) (get oracle :floats)) index)))
                      (str mode "/" index)))
                  (finally
                    (js-call a :release input)
                    (js-call a :release radix)
                    (unless (undefined? output) (js-call a :release output)))))
              (setq index (1+ index)))
            (finally (js-call a :release n))))
        (setq mode (1+ mode))))
    (let ((code-point (js-call a :number 1)))
      (try
        (js-call (js-array -1 0.5 1114112 (get globalThis.Number :NaN) (get globalThis.Number :POSITIVE_INFINITY)) :forEach
          (lambda (invalid)
            (let* ((item (js-call a :number invalid))
                   (argv (js-call a :sourceArray (js-array item))))
              (try
                (progn
                  (js-call assert :throws
                    (lambda () (js-call a :invoke "static-string" (js-array code-point argv)))
                    globalThis.RangeError)
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
                (finally
                  (js-call a :release item)
                  (js-call a :release argv))))))
        (finally (js-call a :release code-point))))
    (let ((mode 0))
      (while (< mode (js-length (get oracle :codeEffects)))
        (let ((n (js-call a :number mode)))
          (try
            (js-call assert :equal (call-value a "code-effects" (js-array n)) (aref (get oracle :codeEffects) mode))
            (finally (js-call a :release n))))
        (setq mode (1+ mode))))
    (let ((mode 0))
      (while (< mode 2)
        (let ((n (js-call a :number mode))
              (cases (if (= mode 0)
                       string-cases
                       (js-call string-cases :filter (lambda (unused index) (/= index 1))))))
          (try
            (js-call cases :forEach
              (lambda (values)
                (let* ((parts (js-call values :map (lambda (v) (js-call a :number v))))
                       (input (js-call a :sourceArray parts))
                       (output undefined))
                  (try
                    (progn
                      (setq output (js-call a :invoke "static-string" (js-array n input)))
                      (js-call assert :equal
                        (js-call a :readString output)
                        (Reflect/apply (if (= mode 0) String/fromCharCode String/fromCodePoint) globalThis.String values)))
                    (finally
                      (js-call parts :forEach (lambda (part) (js-call a :release part)))
                      (js-call a :release input)
                      (unless (undefined? output) (js-call a :release output)))))))
            (finally (js-call a :release n))))
        (setq mode (1+ mode))))
    (js-call (js-array (js-array "static-order" (get oracle :staticOrder))
                       (js-array "raw-order" (get oracle :rawOrder)))
             :forEach
             (lambda (pair)
               (let ((name (aref pair 0))
                     (expected-arr (aref pair 1))
                     (mode 0))
                 (while (< mode (js-length expected-arr))
                   (let ((n (js-call a :number mode)))
                     (try
                       (js-call assert :equal (call-value a name (js-array n)) (aref expected-arr mode))
                       (finally (js-call a :release n))))
                   (setq mode (1+ mode))))))
    (js-call assert :equal (call-value a "restricted-descriptors") standard-restricted-descriptors)
    (js-call assert :equal (call-value a "static-shadow") (get oracle :shadow))
    (js-call assert :equal (call-value a "parser-aliases") (get oracle :aliases))
    (js-call a :collect)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun check-error-profile (a)
    (js-call assert :deepEqual
      (get (get lowered :descriptor) :errorReflection)
      (js-object :standardOwnPropertyNames standard-error-own-names
                 :stack "unsupported"
                 :hostExtensions (js-array)))
    (let ((mode (js-call a :number 3)))
      (js-call a :auto 1)
      (try
        (progn
          ;; The independent runtime exposes its complete standard shape, not a filtered
          ;; copy of Node's host-specific key list. Node's full original shape is retained.
          (js-call assert :equal (call-value a "reflection-shape" (js-array mode)) standard-error-shape)
          (let ((names (js-call a :invoke "names" (js-array mode))))
            (try
              (js-call assert :deepEqual (read-val a names) standard-error-own-names)
              (finally (js-call a :release names))))
          (js-call standard-error-own-names :forEach
            (lambda (key)
              (let ((field (js-call a :string key)))
                (try
                  (let ((descriptor (js-call a :invoke "descriptor" (js-array mode field))))
                    (try
                      (let ((writable (js-call a :string "writable"))
                            (enumerable (js-call a :string "enumerable"))
                            (configurable (js-call a :string "configurable")))
                        (try
                          (progn
                            (js-call assert :equal (js-call a :invoke "descriptor-field" (js-array descriptor writable)) false)
                            (js-call assert :equal (js-call a :invoke "descriptor-field" (js-array descriptor enumerable)) false)
                            (js-call assert :equal (js-call a :invoke "descriptor-field" (js-array descriptor configurable)) (/= key "prototype")))
                          (finally
                            (js-call a :release writable)
                            (js-call a :release enumerable)
                            (js-call a :release configurable))))
                      (finally (js-call a :release descriptor))))
                  (finally (js-call a :release field))))))
          (let ((absent (JSON/stringify (js-array (js-array "value" (js-array "undefined")) false false (js-array "undefined")))))
            (js-call error-stack-extensions :forEach
              (lambda (key)
                (let ((field (js-call a :string key)))
                  (try
                    (progn
                      (js-call assert :equal (call-value a "reflection-snapshot" (js-array mode field)) absent
                        (str "independent runtime does not claim " key))
                      (js-call assert :equal (value-type (get (get (get oracle :errorExtensions) :fields) key)) "string"))
                    (finally (js-call a :release field)))))))
          (let ((stack (js-call a :invoke "error-stack-observation")))
            (try
              (js-call assert :deepEqual (read-val a stack) (js-array "unsupported" "ELI-RT0003"))
              (finally (js-call a :release stack))))
          (js-call assert :deepEqual
            (get (get oracle :errorExtensions) :completeOwnNames)
            (aref (JSON/parse (get (aref (get oracle :builtins) 3) :shape)) 1)))
        (finally (js-call a :release mode)))
      (js-call a :collect)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (defun check-wasm (check-fn)
    (let ((a (instantiateManagedRuntime bytes (js-object :initializeModule false))))
      (try
        (progn
          (js-call a :auto 1)
          (js-call a :initializeModule)
          (funcall check-fn a))
        (finally (finish a)))))

  (test "manual initialization retains its capacity refusal and complete cleanup while the same bytes initialize under collecting GC"
    (lambda ()
      (let ((unpressured (instantiateManagedRuntime bytes (js-object :initializeModule false))))
        (try
          (progn
            (js-call unpressured :initializeModule)
            (js-call assert :equal (get (js-call unpressured :stats) :collections) 0)
            (funcall assert (> (js-call unpressured :live) 0))
            (js-call assert :equal (get (js-call unpressured :stats) :frameDepth) 0)
            (js-call unpressured :collect)
            (js-call assert :deepEqual (call-value unpressured "cached") (js-call js :cached)))
          (finally (finish unpressured))))
      ;; Released handles remain garbage until manual collection. Make the negative
      ;; premise actual slot pressure rather than depending on eager realm waste.
      (let ((fill-garbage (lambda (a)
                            (let ((i 0))
                              (while (< i 1024)
                                (let ((item (js-call a :number 7)))
                                  (js-call a :release item))
                                (setq i (1+ i))))
                            (js-call assert :equal (js-call a :live) 1024)
                            (js-call assert :equal (get (js-call a :stats) :collections) 0))))
        (let ((manual (instantiateManagedRuntime bytes (js-object :initializeModule false))))
          (try
            (progn
              (funcall fill-garbage manual)
              (js-call assert :throws
                (lambda () (js-call manual :initializeModule))
                (lambda (error) (= (and (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code)) "ELI-RT0002")))
              (js-call assert :equal (js-call manual :live) 1024)
              (js-call assert :equal (get (js-call manual :stats) :collections) 0)
              (js-call assert :equal (get (js-call manual :stats) :frameDepth) 0)
              (js-call manual :collect)
              (js-call assert :equal (js-call manual :live) 0)
              (js-call assert :equal (get (js-call manual :stats) :frameDepth) 0))
            (finally (finish manual))))
        (let ((collecting (instantiateManagedRuntime bytes (js-object :initializeModule false))))
          (try
            (progn
              (funcall fill-garbage collecting)
              (js-call collecting :auto 1)
              (js-call collecting :initializeModule)
              (js-call assert :deepEqual (call-value collecting "cached") (js-call js :cached))
              (js-call assert :equal (get (js-call collecting :stats) :frameDepth) 0)
              (js-call collecting :collect)
              (funcall assert (> (js-call collecting :live) 0))
              (funcall assert (< (js-call collecting :live) 1024)))
            (finally (finish collecting)))))))

  (test "a host missing a represented disposal symbol rejects transfer and preserves caller roots and supported identities"
    (async ()
      (await (runFunctionMissingDisposal b runtime program))))

  (test "Given first-class standard constructors when reflected then native reads descriptors key order and prototypes match with an explicit standard Error profile"
    (lambda () (check-wasm check-builtins)))

  (test "Given a standard Error profile when host stack extensions are observed then Node observations stay complete and independent absence and stack refusal remain explicit"
    (lambda () (check-wasm check-error-profile)))

  (test "Given an ordinary source function when missing own properties are read then absence remains exact and no builtin flag leaks"
    (lambda () (check-wasm check-ordinary)))

  (test "Given cached first-class builtins when reflected and called then identities actual receivers argument effects and getter error order remain intact"
    (lambda () (check-wasm check-calls)))

  (test "Given standard Number and String static methods when borrowed and converted then exact native numbers UTF16 raw getter order and restricted accessors match"
    (lambda () (check-wasm check-standard-statics)))

  (funcall (js-call test :skipIf (or (/= (get globalThis.process :platform) "darwin")
                                     (/= (get globalThis.process :arch) "arm64")))
    "Given the identical source fixture in a true native library when all three property and call contracts run then every WASM check is retained"
    (async ()
      (let ((path (resolve directory "function-properties.dylib")))
        (await (writeFile path (globalThis.Uint8Array.from
                                 (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
        (let ((a (await (instantiateNativeManagedRuntime path lowered (js-object :initializeModule false)))))
          (try
            (progn
              (js-call a :auto 1)
              (js-call a :initializeModule)
              (check-builtins a)
              (check-error-profile a)
              (check-ordinary a)
              (check-calls a)
              (check-standard-statics a))
            (finally
              (try (finish a)
                (finally (js-call a :close))))))))
    120000))
