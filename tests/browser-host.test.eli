(module tests.browser-host.test
  (import "bun:test" expect test)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:module" createRequire)
  (import "../browser/host.mjs" BrowserCompileError compileProject compileSource dependencyOrder dirname moduleGraphUrls mountEliscriptScripts normalizePath optimizeJavaScript optimizeProgramIr outputPathFor relativePath resolvePath runSource)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst RUNTIME_BASE "http://127.0.0.1:8787/")
  (defconst PROJECT (js-object "main.eli" "(module app.main\n  (import \"./lib/math.eli\" map-square)\n  (import \"eliscript/runtime/core/order.mjs\" sort)\n  (print \"squares\" (sort (map-square [3 1 2]))))" "lib/math.eli" "(module app.lib.math\n  (import \"eliscript/runtime/core/sequence.mjs\" map)\n  (export map-square)\n  (defun map-square (values) (map (lambda (v) (* v v)) values)))"))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defun resolveExternal (specifier) (if (js-call specifier :startsWith "eliscript/") (get (new globalThis.URL (js-call specifier :slice (get "eliscript/" :length)) RUNTIME_BASE) :href) undefined))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun contains (actual expected) (js-call (expect actual) :toContain expected))
  (defun excludes (actual expected) (js-call (get (expect actual) :not) :toContain expected))
  (defun refuses (operation regex) (js-call (expect operation) :toThrow (new globalThis.RegExp regex)))
  (defun captureError (operation) (try (funcall operation) nil (catch error error)))
  (defasync assert-browser-imports (filename)
    (let* ((path (resolve ROOT filename)) (source (await (js-call (Bun/file path) :text)))
           (require (createRequire (pathToFileURL path)))
           (manifest (JSON/parse (await (js-call (Bun/file (resolve ROOT "package.json")) :text))))
           (imports (Array/from (js-call source :matchAll
             (new globalThis.RegExp "(?:from\\s+|\\bimport\\s*)\"([^\"]+)\"" "gu"))))
           (index 0))
      (while (< index (js-length imports))
        (let* ((specifier (aref (aref imports index) 1))
               (resolved (js-call require :resolve specifier)))
          (unless (js-call specifier :startsWith ".")
            (be (js-call specifier :startsWith "eliscript/runtime/") t)
            (let ((target (get (get manifest :exports) (str "./" (js-call specifier :slice (js-length "eliscript/"))))))
              (be (funcall hostTypeof target) "string")
              (be resolved (resolve ROOT target))))
          (be (await (js-call (Bun/file resolved) :exists)) t))
        (setq index (1+ index)))))
  (test "virtual paths normalize and resolve like a project tree" (lambda ()
    (be (normalizePath "a/./b/../c.eli") "a/c.eli") (refuses (lambda () (normalizePath "../outside.eli")) "escapes the project root")
    (be (dirname "lib/deep/text.eli") "lib/deep") (be (dirname "main.eli") "")
    (be (resolvePath "lib/deep/text.eli" "../shared/value.eli") "lib/shared/value.eli")
    (be (outputPathFor "lib/text.eli") "lib/text.mjs") (refuses (lambda () (outputPathFor "lib/text.mjs")) "must end with .eli")
    (be (relativePath "a/main.mjs" "a/lib/text.mjs") "./lib/text.mjs") (be (relativePath "a/b/main.mjs" "a/lib/text.mjs") "../lib/text.mjs")))
  (test "modules execute after their dependencies" (lambda ()
    (same (dependencyOrder (js-array (js-object :id "a" :dependencies (js-array "b")) (js-object :id "b" :dependencies (js-array "c")) (js-object :id "c" :dependencies (js-array)))) (js-array "c" "b" "a"))
    (refuses (lambda () (dependencyOrder (js-array (js-object :id "a" :dependencies (js-array "b")) (js-object :id "b" :dependencies (js-array "a"))))) "import cycle")))
  (test "single-module compilation resolves the runtime without an import map" (lambda ()
    (let ((result (compileSource "(module m (import \"eliscript/runtime/core/order.mjs\" sort) (print (sort [2 1])))" "m.eli" (js-object :resolveExternal resolveExternal))))
      (contains (get result :javascript) (str "from \"" RUNTIME_BASE "runtime/core/order.mjs\"")) (excludes (get result :javascript) "eliscript/runtime/") (be (funcall hostTypeof (get result :sourceMap)) "string"))))
  (test "an unclaimed external specifier is left for an import map" (lambda ()
    (let ((result (compileSource "(module m (import \"some-package\" thing) (print thing))" "m.eli" (js-object :resolveExternal resolveExternal))))
      (contains (get result :javascript) "from \"some-package\""))))
  (test "a project compiles in dependency order with rewritten local imports" (lambda ()
    (let* ((result (compileProject (js-object :files PROJECT :entry "main.eli" :resolveExternal resolveExternal))) (plan (get result :plan)) (modules (get result :modules)))
      (same (get plan :entries) (js-array "main.eli")) (same (Object/keys modules) (js-array "lib/math.mjs" "main.mjs"))
      (contains (get (get modules "main.mjs") :javascript) "from \"./lib/math.mjs\"")
      (contains (get (get modules "main.mjs") :javascript) (str RUNTIME_BASE "runtime/core/order.mjs"))
      (contains (get (get modules "lib/math.mjs") :javascript) (str RUNTIME_BASE "runtime/core/sequence.mjs"))
      (let ((map (JSON/parse (get (get modules "lib/math.mjs") :sourceMap)))) (same (get map :sources) (js-array "math.eli"))))))
  (test "a project failure is reported as a structured diagnostic" (lambda ()
    (let ((error (captureError (lambda () (compileProject (js-object :files (js-object "main.eli" "(module m (print missing-binding))") :entry "main.eli"))))))
      (js-call (expect error) :toBeInstanceOf BrowserCompileError)
      (js-call (expect (get (aref (get error :diagnostics) 0) :code)) :toMatch (new globalThis.RegExp "^ELI-" "u"))
      (be (get (get (aref (get error :diagnostics) 0) :location) :file) "main.eli"))))
  (test "a missing entry or import fails with its own code" (lambda ()
    (let ((missingEntry (captureError (lambda () (compileProject (js-object :files (js-object) :entry "main.eli"))))))
      (be (get (aref (get missingEntry :diagnostics) 0) :code) "ELI-BROWSER-0002"))
    (let ((missingImport (captureError (lambda () (compileProject (js-object :files (js-object "main.eli" "(module m (import \"./absent.eli\" thing))") :entry "main.eli"))))))
      (be (get (aref (get missingImport :diagnostics) 0) :code) "ELI-BROWSER-0003"))))
  (test "compiled modules become an importable blob graph" (async ()
    (let* ((modules (get (compileProject (js-object :files PROJECT :entry "main.eli" :resolveExternal resolveExternal)) :modules)) (graph (moduleGraphUrls modules "main.eli")))
      (try (be (js-call (get graph :entryUrl) :startsWith "blob:") t)
        (same (Object/keys (get graph :urls)) (js-array "lib/math.mjs" "main.mjs"))
        (let ((main (await (js-call (await (js-call (js* "globalThis") :fetch (get (get graph :urls) "main.mjs"))) :text))))
          (contains main (get (get graph :urls) "lib/math.mjs")) (excludes main "./lib/math.mjs"))
        (finally (js-call graph :release))))))
  (test "the host stays importable without a document" (async ()
    (await (assert-browser-imports "browser/host.mjs"))
    (await (assert-browser-imports "browser/worker.mjs"))
    (let ((worker (await (funcall (js* "(url) => import(url)")
                    (get (pathToFileURL (resolve ROOT "browser/worker.mjs")) :href)))))
      (be (funcall hostTypeof worker) "object"))))
  (test "runSource compiles and executes an in-memory Eliscript module via a Blob URL" (async ()
    (let ((result (await (runSource "(module live.demo (defun double (x) (* x 2)) (export double))" "live-demo.eli"))))
      (be (funcall hostTypeof (get result :javascript)) "string") (be (funcall hostTypeof (get result :sourceMap)) "string")
      (be (js-call (get result :module) :double 21) 42))))
  (test "mountEliscriptScripts compiles and executes inline and external text/eliscript scripts in order" (async ()
    (let* ((inlineScript (js-object :src "" :textContent "(module inline.demo (defun greet () \"inline-ok\") (export greet))" :dataset (js-object)
             :getAttribute (lambda (name) (if (= name "data-filename") "inline-demo.eli" nil))))
           (externalScript (js-object :src "https://example.test/scripts/remote.eli" :textContent "" :dataset (js-object) :getAttribute (lambda () nil)))
           (root (js-object :querySelectorAll (lambda (selector) (be selector "script[type=\"text/eliscript\"]") (js-array inlineScript externalScript))))
           (mounted (await (mountEliscriptScripts root (js-object :fetch (async (url)
             (be url "https://example.test/scripts/remote.eli")
             (js-object :ok t :status 200 :text (async () "(module remote.demo (defun compute () (+ 40 2)) (export compute))"))))))))
      (be (get mounted :length) 2) (be (get (aref mounted 0) :filename) "inline-demo.eli") (be (js-call (get (aref mounted 0) :module) :greet) "inline-ok")
      (be (get (get inlineScript :dataset) :eliscriptMounted) "true") (be (get (aref mounted 1) :filename) "remote.eli")
      (be (js-call (get (aref mounted 1) :module) :compute) 42) (be (get (get externalScript :dataset) :eliscriptMounted) "true")
      (let ((secondPass (await (mountEliscriptScripts root)))) (same secondPass (js-array))))))
  (test "optimizeProgramIr folds constant expressions and eliminates dead conditional branches" (lambda ()
    (let ((optimized (compileSource "(module opt.demo (defun calc () (if t (+ 20 22) (throw \"dead\"))) (export calc))" "opt-demo.eli"))
          (unoptimized (compileSource "(module opt.demo (defun calc () (if t (+ 20 22) (throw \"dead\"))) (export calc))" "opt-demo.eli" (js-object :optimize false))))
      (contains (get optimized :javascript) "42") (excludes (get optimized :javascript) "dead") (contains (get unoptimized :javascript) "dead")
      (be (funcall hostTypeof optimizeProgramIr) "function"))))
  (test "optimizeProgramIr propagates immutable let and defconst constants and folds comparisons, predicates, and algebraic identities" (async ()
    (let* ((source "(module opt.advanced\n    (defconst base-factor 6)\n    (defun compute (x)\n      (let ((step (+ base-factor 1))\n            (enabled (and (< 2 3) (not (nil? :ready)))))\n        (if enabled\n          (+ (* x 1) (* base-factor step) 0)\n          (throw \"unreachable-branch\"))))\n    (export compute))") (compiled (compileSource source "opt-advanced.eli")) (executed (await (runSource source "opt-advanced.eli"))))
      (contains (get compiled :javascript) "42") (excludes (get compiled :javascript) "unreachable-branch") (be (js-call (get executed :module) :compute 8) 50))))
  (test "optimizeJavaScript and compileSource minify option strip comments and compact whitespace while preserving string literals" (async ()
    (let* ((sample "// leading comment\nexport const greeting = \"hello // not a comment /* either */\";\n/* block comment */\nexport const answer = 40 + 2;\n") (compacted (optimizeJavaScript sample)))
      (excludes compacted "leading comment") (excludes compacted "block comment") (contains compacted "\"hello // not a comment /* either */\"")
      (contains compacted "export const answer=40+2;") (js-call (expect (get compacted :length)) :toBeLessThan (get sample :length))
      (let ((executed (await (runSource "(module compact.demo (defun message () (str \"url: https://example.test/a//b \" (+ 19 23))) (export message))" "compact-demo.eli" (js-object :minify t)))))
        (be (js-call (get executed :module) :message) "url: https://example.test/a//b 42")))))
  (test "compileSource and compileProject support an external or custom closureCompiler hook" (lambda ()
    (let* ((calls (js-array)) (closureCompiler (lambda (javascript meta) (js-call calls :push (get meta :filename)) (str (optimizeJavaScript javascript) "// closure-optimized:" (get meta :filename) "\n")))
           (single (compileSource "(module hook.demo (defun value () (+ 20 22)) (export value))" "hook-demo.eli" (js-object :closureCompiler closureCompiler))))
      (same calls (js-array "hook-demo.eli")) (contains (get single :javascript) "// closure-optimized:hook-demo.eli")
      (let ((project (compileProject (js-object :files (js-object "main.eli" "(module p.main (import \"./sub.eli\" v) (export v))" "sub.eli" "(module p.sub (defconst v (+ 10 32)) (export v))")
        :entry "main.eli" :closureCompiler closureCompiler))))
        (contains (get (get (get project :modules) "sub.mjs") :javascript) "// closure-optimized:sub.eli") (contains (get (get (get project :modules) "main.mjs") :javascript) "// closure-optimized:main.eli")))))
  (test "compileSource and runSource support both extensionless and .mjs eliscript package imports" (async ()
    (let ((withoutExtension (compileSource "(module ext.demo (import \"eliscript/runtime/core/order\" sort) (import \"eliscript/runtime/core/sequence\" map) (export sort map))" "ext-demo.eli" (js-object :resolveExternal resolveExternal))))
      (contains (get withoutExtension :javascript) (str "from \"" RUNTIME_BASE "runtime/core/order.mjs\""))
      (contains (get withoutExtension :javascript) (str "from \"" RUNTIME_BASE "runtime/core/sequence.mjs\""))
      (let ((executed (await (runSource "(module ext.run (import \"eliscript/runtime/core/order\" sort) (defun ordered () (sort [3 1 2])) (export ordered))" "ext-run.eli"))))
        (same (Array/from (js-call (get executed :module) :ordered)) (js-array 1 2 3))))))
)
