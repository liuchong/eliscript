(module tests.metadata
  (import "bun:test" expect test)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/collection.mjs" :as collection)
  (import "../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../runtime/core/metadata.mjs" IMeta IWithMeta meta supportsMetadata varyMeta withMeta)
  (import "../runtime/core/map.mjs" EMPTY_MAP persistentHashMap)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/transient.mjs" assocBang conjBang persistentBang transient)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (import "../runtime/core/vector.mjs" PersistentVector persistentVector subvec)
  (import "../runtime/core/vector-internals.mjs" VECTOR_STATE)
  (import "../runtime/core/metadata-internals.mjs" METADATA_READ)
  (import "../runtime/testing/map.mjs" inspectPersistentMap sharedPersistentMapNodes)
  (import "../runtime/testing/set.mjs" inspectPersistentSet sharedPersistentSetNodes)
  (import "../runtime/testing/vector.mjs" inspectPersistentVector sharedPersistentVectorNodes)
  (defconst HOST_FIXTURE (fileURLToPath (new globalThis.URL "./fixtures/metadata-host.mjs" (js* "import.meta.url"))))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same-values (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (thunk expected) (js-call (expect thunk) :toThrow expected))

  (test "vector metadata specialization preserves proxy state reads and live metadata getters" (lambda ()
    (let* ((first (persistentHashMap (js-array "v" 1)))
           (second (persistentHashMap (js-array "v" 2)))
           (value (withMeta (persistentVector 1 2) first))
           (state (aref value VECTOR_STATE)) (reads 0) (next first)
           (proxy (new globalThis.Proxy value (js-object :get
             (lambda (target key receiver)
               (when (eq key VECTOR_STATE) (setq reads (1+ reads)))
               (Reflect/get target key receiver))))))
      (be (meta proxy) first) (be reads 1)
      (Object/defineProperty state "metadata" (js-object :get (lambda () next) :configurable t))
      (be (meta value) first) (setq next second) (be (meta value) second)
      (be (meta (withMeta (subvec (persistentVector 1 2 3) 1 2) first)) first))))

  (test "vector metadata specialization observes method and call overrides exactly once" (lambda ()
    (let* ((value (persistentVector 1)) (proto (get PersistentVector :prototype))
           (method (aref proto METADATA_READ)) (reads 0) (calls 0))
      (try
        (progn
          (Object/defineProperty method "call" (js-object :configurable t :get (lambda ()
            (setq reads (1+ reads))
            (lambda (receiver) (be receiver value) (setq calls (1+ calls)) "overridden-call"))))
          (be (meta value) "overridden-call") (be reads 1) (be calls 1)
          (Reflect/deleteProperty method "call")
          (put proto METADATA_READ (lambda () "overridden-method"))
          (be (meta value) "overridden-method"))
        (finally
          (Reflect/deleteProperty method "call")
          (put proto METADATA_READ method))))))
  (defasync runHost (command)
    (let* ((child (js-call globalThis.Bun :spawn (js-array command HOST_FIXTURE) (js-object :stdout "pipe" :stderr "pipe")))
           (parts (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref parts 0)) (stdout (aref parts 1)) (stderr (aref parts 2)))
      (unless (= exitCode 0)
        (let ((message (js-call stderr :trim)))
          (throw (new globalThis.Error (if (> (js-length message) 0) message (str command " exited with " exitCode))))))
      (JSON/parse stdout)))
  (defun mapRange (size)
    (let ((result EMPTY_MAP) (key 0))
      (while (< key size) (setq result (js-call result :assoc key (* key 2)) key (1+ key))) result))

  (test "metadata protocols cover symbols and persistent runtime collections" (lambda ()
    (let ((metadata (persistentHashMap (js-array "doc" "root") (js-array "line" 7)))
          (values (js-array (eliscriptSymbol "blog/post") (persistentVector "a" "b")
                    (persistentHashMap (js-array "a" 1)) (persistentHashSet "a" "b"))))
      (be (get IMeta :name) "IMeta") (be (get IWithMeta :name) "IWithMeta")
      (js-call values :forEach (lambda (value)
        (be (supportsMetadata value) t) (js-call (expect (meta value)) :toBeNull)
        (let ((annotated (withMeta value metadata)))
          (js-call (get (expect annotated) :not) :toBe value)
          (be (meta annotated) metadata) (be (withMeta annotated metadata) annotated)
          (be (equalValues annotated value) t) (be (hashValue annotated) (hashValue value)))))
      (be (supportsMetadata (keyword "blog/post")) false) (be (supportsMetadata (js-object)) false)
      (js-call (expect (meta (keyword "blog/post"))) :toBeNull) (js-call (expect (meta nil)) :toBeNull)
      (raises (lambda () (withMeta (keyword "blog/post") metadata)) "value does not support metadata")
      (raises (lambda () (withMeta (aref values 0) (new globalThis.Map))) "metadata must be null or a persistent hash map"))))

  (test "metadata changes only collection roots and stays out of host values" (lambda ()
    (let* ((metadata (persistentHashMap (js-array "source" "metadata.test.mjs")))
           (vector (Reflect/apply persistentVector undefined (Array/from (js-object :length 96) (lambda (ignored index) index))))
           (map (mapRange 96))
           (set (Reflect/apply persistentHashSet undefined (Array/from (js-object :length 96) (lambda (ignored index) index))))
           (annotatedVector (withMeta vector metadata)) (annotatedMap (withMeta map metadata)) (annotatedSet (withMeta set metadata)))
      (be (sharedPersistentVectorNodes vector annotatedVector) (get (inspectPersistentVector vector) :nodeCount))
      (be (sharedPersistentMapNodes map annotatedMap) (get (inspectPersistentMap map) :nodeCount))
      (be (sharedPersistentSetNodes set annotatedSet) (get (inspectPersistentSet set) :nodeCount))
      (same-values (js-call annotatedVector :toArray) (js-call vector :toArray))
      (same-values (Array/from (js-call annotatedMap :toMap)) (Array/from (js-call map :toMap)))
      (same-values (Array/from (js-call annotatedSet :toSet)) (Array/from (js-call set :toSet)))
      (be (JSON/stringify annotatedVector) (JSON/stringify vector))
      (be (JSON/stringify annotatedMap) (JSON/stringify map)) (be (JSON/stringify annotatedSet) (JSON/stringify set)))))

  (test "persistent updates, empty values, and transients preserve root metadata" (lambda ()
    (let* ((metadata (persistentHashMap (js-array "owner" "compiler")))
           (vector (withMeta (persistentVector 1 2 3) metadata))
           (map (withMeta (persistentHashMap (js-array "a" 1) (js-array "b" 2)) metadata))
           (set (withMeta (persistentHashSet "a" "b") metadata)))
      (js-call (js-array (js-call vector :assoc 1 20) (js-call vector :conj 4) (js-call vector :pop)
                 (js-call collection :empty vector) (js-call map :assoc "c" 3) (js-call map :dissoc "a")
                 (js-call collection :empty map) (js-call set :conj "c") (js-call set :disj "a") (js-call collection :empty set))
        :forEach (lambda (value) (be (meta value) metadata)))
      (let ((editableVector (transient vector)))
        (conjBang editableVector 4) (be (meta (persistentBang editableVector)) metadata))
      (let ((editableMap (transient map)))
        (assocBang editableMap "c" 3) (be (meta (persistentBang editableMap)) metadata))
      (let ((editableSet (transient set)))
        (conjBang editableSet "c") (be (meta (persistentBang editableSet)) metadata)))))

  (test "varyMeta computes a validated replacement map" (lambda ()
    (let* ((original (persistentHashMap (js-array "line" 7))) (value (withMeta (eliscriptSymbol "blog/post") original))
           (changed (varyMeta value (lambda (current key next) (js-call current :assoc key next)) "line" 9)))
      (be (js-call (meta changed) :get "line") 9) (be (meta value) original)
      (raises (lambda () (varyMeta value nil)) "metadata transform must be a function")
      (raises (lambda () (varyMeta value (lambda () (js-object :line 10)))) "metadata must be null or a persistent hash map"))))

  (test "metadata behavior agrees under Bun and Node" (async ()
    (let* ((reports (await (Promise/all (js-array (runHost "bun") (runHost (get (get globalThis.process :env) :NODE "node"))))))
           (bunReport (aref reports 0)) (nodeReport (aref reports 1)))
      (same-values nodeReport bunReport)
      (same-values bunReport (js-object :symbol (js-object :equal t :hashEqual t :source "host")
        :vector (js-object :count 4 :source "host") :map (js-object :count 2 :source "host") :set (js-object :count 3 :source "host"))))))
)
