(module tests.data-text
  (import "bun:test" expect test)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/data-text.mjs" DataTextError IPrint printValue readValue readValues)
  (import "../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../runtime/core/list.mjs" persistentList)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/protocol.mjs" extendProtocolType)
  (import "../runtime/core/queue.mjs" isPersistentQueue persistentQueue)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/value.mjs" equalValues)
  (import "../runtime/core/vector.mjs" persistentVector)
  (defconst HOST_FIXTURE (fileURLToPath (new globalThis.URL "./fixtures/data-text-host.mjs" (js* "import.meta.url"))))
  (defconst host-truth (js* "(value) => !!value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (operation message) (js-call (expect operation) :toThrow message))
  (defasync runHost (command)
    (let* ((child (Bun/spawn (js-array command HOST_FIXTURE) (js-object :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (unless (= (aref result 0) 0)
        (let ((err (js-call (aref result 2) :trim))) (throw (new globalThis.Error (if (funcall host-truth err) err (str command " exited with " (aref result 0)))))))
      (JSON/parse (aref result 1))))
  (defun roundTrip (value)
    (let* ((printed (printValue value)) (restored (readValue printed)))
      (be (equalValues restored value) t) (be (printValue restored) printed) restored))
  (test "canonical data text prints scalar and identifier values" (lambda ()
    (be (get IPrint :name) "IPrint")
    (same (js-call (js-array nil undefined t false 0 (js* "-0") 1.5 globalThis.Number.NaN globalThis.Number.POSITIVE_INFINITY globalThis.Number.NEGATIVE_INFINITY
      (js* "12345678901234567890n") "line\n\"quoted\"" (keyword "article/title") (eliscriptSymbol "article/title")) :map (lambda (value) (printValue value)))
      (js-array "nil" "undefined" "true" "false" "0" "0" "1.5" "##NaN" "##Inf" "##-Inf" "12345678901234567890N" "\"line\\n\\\"quoted\\\"\"" ":article/title" "article/title"))
    (js-call (js-array nil undefined t false 0 (js* "-0") 1.5 globalThis.Number.NaN globalThis.Number.POSITIVE_INFINITY globalThis.Number.NEGATIVE_INFINITY
      (js* "12345678901234567890n") "Unicode 值" (keyword "article/title") (eliscriptSymbol "article/title")) :forEach roundTrip)))
  (test "collections print in deterministic logical order" (lambda ()
    (let ((value (persistentHashMap (js-array (keyword "z") (persistentHashSet 3 (persistentList 1 2) 2)) (js-array (keyword "a") (persistentVector "x" (eliscriptSymbol "article/title")))))
          (reordered (persistentHashMap (js-array (keyword "a") (persistentVector "x" (eliscriptSymbol "article/title"))) (js-array (keyword "z") (persistentHashSet 2 3 (persistentList 1 2))))))
      (be (printValue value) "{:a [\"x\" article/title] :z #{(1 2) 2 3}}") (be (printValue reordered) (printValue value)) (roundTrip value))
    (let ((queue (persistentQueue 1 (keyword "ready") (persistentVector 2 3))))
      (be (printValue queue) "#queue [1 :ready [2 3]]")
      (let ((restoredQueue (roundTrip queue))) (be (isPersistentQueue restoredQueue) t) (same (Array/from restoredQueue) (Array/from queue))))))
  (test "metadata and unsafe identifiers have lossless explicit forms" (lambda ()
    (let* ((metadata (persistentHashMap (js-array (keyword "source") "data-text.test.mjs") (js-array (keyword "line") 7)))
           (annotated (withMeta (persistentVector (eliscriptSymbol "space name") (keyword "namespace with space" "name]")) metadata))
           (printed (printValue annotated)))
      (be printed (str "^{:line 7 :source \"data-text.test.mjs\"} " "[#eliscript/symbol [nil \"space name\"] " "#eliscript/keyword [\"namespace with space\" \"name]\"]]"))
      (let ((restored (roundTrip annotated)))
        (be (js-call (meta restored) :get (keyword "line")) 7)
        (be (get (js-call restored :nth 0) :name) "space name")
        (be (get (js-call restored :nth 1) :namespace) "namespace with space")))))
  (test "reader accepts ignored separators and reads multiple values" (lambda ()
    (same (js-call (readValue "; header\n[1, 2 ; item\n 3]") :toArray) (js-array 1 2 3))
    (let ((values (readValues "1 :two\n(3 [4])")))
      (be (Object/isFrozen values) t) (be (aref values 0) 1) (be (funcall globalThis.String (aref values 1)) ":two")
      (same (js-call (aref values 2) :toArray) (js-array 3 (persistentVector 4)))
      (be (equalValues (js-call (aref values 2) :nth 1) (persistentVector 4)) t))))
  (test "IPrint is open while unregistered host containers stay explicit" (lambda ()
    (let* ((construct (js* "(initialize) => class Point { constructor(x, y) { initialize(this, x, y); } }"))
           (Point (funcall construct (lambda (self x y) (put self :x x) (put self :y y) (Object/freeze self)))))
      (extendProtocolType IPrint Point (js-object :print (lambda (point context) (str "#point [" (js-call context :print (get point :x)) " " (js-call context :print (get point :y)) "]"))))
      (be (printValue (new Point 2 3)) "#point [2 3]")
      (raises (lambda () (printValue (js-array))) "protocol IPrint/print has no implementation for object:Array")
      (raises (lambda () (printValue (new globalThis.Map))) "protocol IPrint/print has no implementation for object:Map"))))
  (test "reader rejects malformed, duplicate, and unsupported data" (lambda ()
    (js-call (js-array (js-array "" "unexpected end of input") (js-array "[1 2" "unexpected end of vector") (js-array "{:a 1 :b}" "map requires a value for every key") (js-array "{:a 1 :a 2}" "duplicate map key") (js-array "#{1 1}" "duplicate set value") (js-array "#queue (1 2)" "queue tag requires a vector") (js-array "^[] [1]" "metadata prefix requires a persistent map") (js-array "^{} :keyword" "value does not support metadata") (js-array "#unknown 1" "unknown dispatch #unknown") (js-array "(1 2" "unexpected end of list") (js-array "[1] trailing" "trailing data after value")) :forEach (lambda (entry)
      (let ((source (aref entry 0)) (message (aref entry 1)))
        (try (readValue source) (throw (new globalThis.Error (str "expected " source " to fail")))
          (catch error (js-call (expect error) :toBeInstanceOf DataTextError) (be (get error :code) "ELI-DATA-TEXT") (js-call (expect (get error :message)) :toContain message))))))
    (try (readValue "[\n  1\n}") (catch error (be (get error :offset) 6) (be (get error :line) 3) (be (get error :column) 1) (be (get error :sourceLength) 7)))))
  (test "printer and reader enforce explicit resource limits" (lambda ()
    (let ((nested (persistentVector (persistentVector (persistentVector 0)))))
      (raises (lambda () (printValue nested (js-object :maxDepth 2))) "data text exceeds maxDepth 2"))
    (raises (lambda () (printValue (persistentVector 1 2) (js-object :maxValues 2))) "data text exceeds maxValues 2")
    (raises (lambda () (printValue "long" (js-object :maxLength 3))) "data text exceeds maxLength 3")
    (raises (lambda () (readValue "[[[0]]]" (js-object :maxDepth 2))) "data text exceeds maxDepth 2")
    (raises (lambda () (readValue "[1 2]" (js-object :maxValues 2))) "data text exceeds maxValues 2")
    (raises (lambda () (readValue "[123]" (js-object :maxLength 4))) "data text exceeds maxLength 4")
    (raises (lambda () (readValue "1" (js-object :maxDepth 0))) globalThis.TypeError)
    (raises (lambda () (readValue 1)) globalThis.TypeError)))
  (test "generated nested values retain equality and canonical text" (lambda ()
    (let ((value (persistentVector)) (index 0))
      (while (< index 2000)
        (let ((leaf (persistentVector index (str "value-" (% index 17)))))
          (setq value (js-call value :conj (cond
            ((= (% index 5) 0) (persistentHashMap (js-array (keyword "index") index) (js-array leaf t)))
            ((= (% index 5) 1) (persistentHashSet index leaf))
            ((= (% index 5) 2) (eliscriptSymbol "generated" (str "value-" index)))
            ((= (% index 5) 3) (persistentList index leaf))
            (t leaf)))))
        (setq index (1+ index)))
      (roundTrip value))))
  (test "canonical data text agrees under Bun and Node" (async ()
    (let ((reports (await (Promise/all (js-array (runHost "bun") (runHost (get (get globalThis.process :env) :NODE "node")))))))
      (same (aref reports 1) (aref reports 0)) (same (aref reports 0) (js-object "text" (str "^{:source \"host\"} {:list (1 :two) :map {:a 1 :b 2} " ":queue #queue [1 :two [3]] :set #{1 2 3} :vector [1 two]}") "stable" t "equal" t "source" "host")))))
)
