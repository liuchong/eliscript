(module tests.managed-stdlib-value-json.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" readFile mkdtemp mkdir rm writeFile)
  (import "node:path" resolve dirname posix)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/managed-stdlib-corpus.mjs" inputs parseBoundaryCases encodeBoundaryCases parseCases encodeInputs)
  (import "./helpers/managed-json-contract.mjs" read value finish box checkAll)
  (defvar b undefined) (defvar rt undefined) (defvar modules undefined) (defvar bytes undefined) (defvar lowered undefined) (defvar directory undefined) (defvar expected undefined)
  (defconst options (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
  (defconst memory (js-object :initialPages 4 :maximumPages 1024))
  (defun imports (nodes &rest __host_default_arguments_1)
    (let* ((out (aref __host_default_arguments_1 0)))
    (when (= out undefined) (setq out (js-array)))
    (js-call nodes :forEach (lambda (node) (when (= (get node :kind) "import-declaration") (js-call out :push (get node :value))) (imports (get node :children) out))) out))
  (defasync loadOriginal (id source loaded base)
    (unless (js-call loaded :has id)
      (js-call loaded :add id)
      (when (nullish? source) (setq source (await (readFile id "utf8"))))
      (let* ((program (js-call (get b :compiler) :compile_ir_string source id)) (path (resolve base id)))
        (js-call modules :push (js-object :id id :program program))
        (await (mkdir (dirname path) (js-object :recursive t))) (await (writeFile path (js-call (get b :compiler) :emit_ir_string program)))
        (let ((specifiers (imports (get program :body))) (index 0))
          (while (< index (get specifiers :length))
            (let ((target (js-call posix :normalize (js-call posix :join (js-call posix :dirname id) (aref specifiers index)))))
              (assert (js-call target :startsWith "stdlib/")) (await (loadOriginal target undefined loaded base)))
            (setq index (1+ index)))))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-stdlib-value-json-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq rt (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq modules (js-array))
    (let ((loaded (new globalThis.Set)) (base (resolve directory "reference")))
      (await (mkdir base)) (await (loadOriginal "entry.mjs" (await (readFile "tests/fixtures/managed-stdlib-value-json.eli" "utf8")) loaded base))
      (console/log "original stdlib modules" (js-call (js-call modules :map (lambda (m) (get m :id))) :join ","))
      (let ((saved (JSON/stringify modules)))
        (setq lowered (js-call (get b :managed) :lower_managed_project modules "entry.mjs" rt))
        (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "entry.mjs" rt memory)))
        (js-call assert :equal (JSON/stringify modules) saved)
        (js-call assert :deepEqual (WebAssembly.Module/imports (new WebAssembly.Module bytes)) (js-array)))
      (let ((child (spawnSync "node" (js-array "--experimental-loader" (resolve "tests/fixtures/compiled-eli-node-loader.mjs")
               (resolve "tests/fixtures/managed-stdlib-json-host.mjs") "observe" (get (pathToFileURL (resolve base "entry.mjs")) :href))
               (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr)) (setq expected (JSON/parse (get child :stdout))))
      (js-call assert :deepEqual (aref (get expected :errors) 0) (js-array t t "ELI-JSON-DUPLICATE" "duplicate object key" 7 "$[\"a\"]"))
      (js-call assert :equal (aref (aref (get expected :errors) 1) 4) 12) (js-call assert :equal (aref (aref (get expected :errors) 1) 5) "$[\"z\"][\"a\"]")
      (js-call assert :equal (aref (aref (get expected :errors) 2) 4) 10) (js-call assert :equal (aref (aref (get expected :errors) 2) 5) "$[\"\\ud83d\\ude00\"]")
      (js-call assert :deepEqual (js-call (js-call (get expected :errors) :slice 3) :map (lambda (row) (aref row 2)))
        (js-array "ELI-JSON-TYPE" "ELI-JSON-NUMBER" "ELI-JSON-OPTIONS" "ELI-JSON-OPTIONS" "ELI-JSON-OPTIONS" "ELI-JSON-OPTIONS" "ELI-JSON-LENGTH" "ELI-JSON-DEPTH" "ELI-JSON-VALUES"))
      (js-call assert :deepEqual (js-call (get expected :boundaries) :slice 0 10) (js-array t t "0" 2 55357 56832 "\"\\ud83d\\ude00\"" 55296 "\"\\ud800\"" "[[1],[1]]"))
      (js-call assert :equal (aref (aref (get expected :boundaries) 10) 2) "ELI-JSON-CYCLE") (js-call assert :equal (aref (aref (get expected :boundaries) 10) 5) "$[0]")
      (js-call assert :deepEqual (get expected :order) (js-array t t t t 2 t t 2 "left" "right" false false false t t t 6 6 1 2 3 4 5 6))
      (js-call assert :deepEqual (js-call (get expected :encoded) :slice 0 3) (js-array (js-array t "\"中\\ud83d\\ude00\"") (js-array t "\"\\ud800\"") (js-array t "\"\\udfff\"")))
      (js-call assert :deepEqual (aref (get expected :encoded) 4) (js-array t "0")))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "Given complete original Value and JSON dependency modules when fixed and seeded scalar persistent and JSON cases execute then zero-import WASM agrees with independent Node JavaScript" (lambda ()
    (let ((a (instantiateManagedRuntime bytes options))) (js-call a :auto 65536) (try (checkAll a inputs expected) (finally (finish a))))) 30000)
  (test "Given collection at every allocation when complete original stdlib modules execute then persistent callbacks identities and error recovery retain their roots" (lambda ()
    (let ((a (instantiateManagedRuntime bytes options))) (js-call a :auto 1) (try (checkAll a inputs expected) (finally (finish a))))) 30000)
  (funcall (js-call test :skipIf (or (not (= (get process :platform) "darwin")) (not (= (get process :arch) "arm64"))))
    "Given a true native library of the same original stdlib graph when the fixed and seeded semantic corpus runs then every result matches original Node JavaScript" (async ()
      (let ((path (resolve directory "stdlib-value-json.dylib")))
        (await (writeFile path (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
        (let ((a (await (instantiateNativeManagedRuntime path lowered (Object/assign (js-object) options memory)))))
          (js-call a :auto 65536) (try (checkAll a inputs expected) (finally (try (finish a) (finally (js-call a :close)))))))) 120000)
  (test "Given identical zero-import stdlib bytes when Node executes the semantic corpus then the independent original JS observations agree" (async ()
    (let ((path (resolve directory "stdlib-value-json.wasm")) (parameters (resolve directory "stdlib-value-json-expected.json")))
      (await (writeFile path bytes)) (await (writeFile parameters (JSON/stringify (js-object :inputs inputs :expected expected :options options))))
      (let ((child (spawnSync "node" (js-array (resolve "tests/fixtures/managed-stdlib-json-host.mjs") "execute" path parameters) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))) 40000)
  (test "Given an ordinary source function when existing own-property predicates and actual Value hash are used then opaque function semantics agree with JavaScript" (lambda ()
    (let ((a (instantiateManagedRuntime bytes options)) (results (js-array)) (errors (js-array)))
      (js-call a :auto 1)
      (try
        (let ((mode 0)) (while (< mode 5)
          (let ((n (js-call a :number mode)))
            (try
              (let ((out (value a "opaque_probe" (js-array n))))
                (js-call results :push out) (when (< mode 3) (js-call assert :deepEqual out (aref (js-array "function" false nil) mode)))
                (when (= mode 3) (js-call assert :equal (funcall (js* "(value) => typeof value") out) "number"))
                (when (= mode 4) (js-call assert :equal out false)))
              (catch error (let* ((info (get error :eliscriptDiagnostic)) (code (if (nullish? info) undefined (get info :code))))
                (console/error "opaque function probe:" mode (if (nullish? code) (get error :message) code))) (js-call errors :push error))
              (finally (js-call a :release n))))
          (setq mode (1+ mode))))
        (when (> (get errors :length) 0) (throw (new globalThis.AggregateError errors "function property/hash failures")))
        (finally (finish a))))) 30000)
)
