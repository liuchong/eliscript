(module tests.wasm-managed-number-conversion.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/wasm-managed-number-conversion-node.mjs" longHex)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst instance-of? (js* "(a, b) => a instanceof b"))
  (defconst js-pow (js* "(a, b) => a ** b"))
  (defconst bi-shl (js* "(a, b) => a << b"))
  (defconst bi-shr (js* "(a, b) => a >> b"))
  (defconst bi-and (js* "(a, b) => a & b"))
  (defconst bi-add (js* "(a, b) => a + b"))
  (defconst bi-sub (js* "(a, b) => a - b"))
  (defconst bi-mul (js* "(a, b) => a * b"))
  (defconst bi-pow (js* "(a, b) => a ** b"))
  (defconst bi-lt (js* "(a, b) => a < b"))

  (defconst node-helper (resolve "tests/helpers/wasm-managed-number-conversion-node.mjs"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar runtime-program nil)
  (defconst compiled (new globalThis.Map))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-number-conversion-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime-program
        (js-call (get backend :compiler) :compile_ir_string
          (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
          "runtime.eli")))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun open-runtime (name source &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (unless (js-call compiled :has name)
      (let* ((compiler (get backend :compiler))
             (managed (get backend :managed))
             (ir (js-call compiler :compile_ir_string source (str name ".eli")))
             (snapshot (JSON/stringify ir))
             (emission undefined))
        (try
          (setq emission (js-call managed :emit_managed_wasm ir runtime-program))
          (catch err
            (console/error (JSON/stringify (get err :eliscriptDiagnostic)))
            (throw err)))
        (let ((bytes (Uint8Array/from emission)))
          (js-call assert :equal (JSON/stringify ir) snapshot)
          (funcall assert (WebAssembly/validate bytes))
          (js-call assert :deepEqual
            (WebAssembly.Module/imports (new WebAssembly.Module bytes))
            (js-array))
          (js-call compiled :set name bytes))))
    (let ((api (instantiateManagedRuntime (js-call compiled :get name) options)))
      (js-call api :auto 1)
      api)))

  (defconst parse-source "(defun parse (value) (string-to-number value)) (export parse)")
  (defconst text-source "(defun text (value) (str value)) (export text)")

  (defun box-value (api value)
    (let ((ty (funcall js-typeof value)))
      (cond
        ((= ty "string") (js-call api :string value))
        ((= ty "number") (js-call api :number value))
        (t value))))

  (defun check-conversion (api name input expected)
    (let ((value (box-value api input))
          (result undefined))
      (try
        (setq result (js-call api :invoke name (js-array value)))
        (let ((actual (if (= (get result :kind) 4)
                          (js-call api :readNumber result)
                          (js-call api :readString result))))
          (funcall assert (Object/is actual expected)
            (str name "(" (JSON/stringify input) "): " (globalThis.String actual) " versus " (globalThis.String expected))))
        (finally
          (when result
            (js-call api :release result))
          (js-call api :release value)))
      (js-call api :collect)
      (js-call assert :equal (js-call api :live) 0)
      (js-call assert :equal (get (js-call api :stats) :frameDepth) 0)))

  (defconst whitespace
    (String/fromCharCode
      9 10 11 12 13 32 160 5760
      8192 8193 8194 8195 8196 8197 8198 8199 8200 8201 8202
      8232 8233 8239 8287 12288 65279))

  (defconst tokens
    (js-array
      "" " " whitespace "-0" "+0" "-0.0e999999" "0e-999999" ".5" "1." "+1.25e-3" "-1E+3"
      "Infinity" "+Infinity" "-Infinity" "NaN" "inf" "infinity" "1e" "1e+" "+" "-" "."
      "1_000" "1n" "0x" "-0x1" "+0x1" "0x10" "0Xffffffffffffffff"
      "0b101" "0B1" "0o377" "0O1" "0b2" "0o8" "00" "08" "0123" "1 2"
      (str "1" (String/fromCharCode 0))
      (str (String/fromCharCode 133) "1")
      (str (String/fromCharCode 6158) "1")
      (String/fromCharCode 55296)
      "１" "١"
      "1e999999" "-1e999999" "1e-999999" "-1e-999999"
      "9007199254740991" "9007199254740992" "9007199254740993" "9007199254740995"
      "1.7976931348623157e308" "1.7976931348623159e308"
      "2.2250738585072014e-308" "2.2250738585072012e-308"
      "5e-324" "2e-324" "3e-324"))

  (defun scaled-decimal (integer scale)
    (let ((digits (js-call (js-call integer :toString) :padStart (+ scale 1) "0")))
      (if (/= scale 0)
          (str (js-call digits :slice 0 (- scale)) "." (js-call digits :slice (- scale)))
          digits)))

  ;; Exact decimal spelling of a binary rational and its adjacent decimal units.
  (defun binary-decimal (integer exponent &rest __host_default_arguments_1)
    (let* ((delta-arg (aref __host_default_arguments_1 0)))
    (let ((delta (if (undefined? delta-arg) (globalThis.BigInt 0) delta-arg)))
      (if (>= exponent 0)
          (js-call (funcall bi-add (funcall bi-shl integer (globalThis.BigInt exponent)) delta) :toString)
          (scaled-decimal
            (funcall bi-add
              (funcall bi-mul integer (funcall bi-pow (globalThis.BigInt 5) (globalThis.BigInt (- exponent))))
              delta)
            (- exponent))))))

  (defun make-random (initial-seed)
    (let ((seed initial-seed))
      (lambda ()
        (setq seed (bit-xor seed (bit-shift-left seed 13)))
        (setq seed (bit-xor seed (unsigned-bit-shift-right seed 17)))
        (setq seed (bit-xor seed (bit-shift-left seed 5)))
        (unsigned-bit-shift-right seed 0))))

  (test "primitive Number conversion preserves complete string grammar, whitespace, IEEE values and exact zero signs under GC"
    (lambda ()
      (let ((api (open-runtime "number-parse" parse-source))
            (non-strings (js-array
                           nil false t undefined globalThis.NaN globalThis.Infinity
                           (- globalThis.Infinity) -0.0 Number.MIN_VALUE Number.MAX_VALUE)))
        (js-call non-strings :forEach
          (lambda (input) (check-conversion api "parse" input (globalThis.Number input))))
        (js-call tokens :forEach
          (lambda (input) (check-conversion api "parse" input (globalThis.Number input))))
        (js-call tokens :forEach
          (lambda (input)
            (let ((wrapped (str whitespace input whitespace)))
              (check-conversion api "parse" wrapped (globalThis.Number wrapped))))))))

  (test "decimal-to-binary rounding handles exact ties and adjacent decimals across the binary64 exponent range"
    (lambda ()
      (let* ((api (open-runtime "number-parse" parse-source))
             (exponents (new globalThis.Set (js-array -1075 -1074 -1023 -1022 -53 -52 -1 0 1 52 53 969 970)))
             (exp -1075)
             (b0 (globalThis.BigInt 0))
             (b1 (globalThis.BigInt 1))
             (bn1 (globalThis.BigInt -1))
             (b3 (globalThis.BigInt 3))
             (two53 (funcall bi-shl b1 (globalThis.BigInt 53)))
             (significands (js-array b1 (funcall bi-sub two53 b1) (funcall bi-add two53 b1)))
             (deltas (js-array bn1 b0 b1)))
        (while (<= exp 970)
          (js-call exponents :add exp)
          (setq exp (+ exp 17)))
        (js-call (Array/from exponents) :forEach
          (lambda (exponent)
            (js-call significands :forEach
              (lambda (significand)
                (js-call deltas :forEach
                  (lambda (delta)
                    (let ((input (binary-decimal significand exponent delta)))
                      (check-conversion api "parse" input (globalThis.Number input))
                      (check-conversion api "parse" (str "-" input) (globalThis.Number (str "-" input))))))))))
        (let ((tie (binary-decimal b1 -1075)))
          (check-conversion api "parse" tie 0)
          (check-conversion api "parse" (str "-" tie) -0.0)
          (check-conversion api "parse" (binary-decimal b1 -1075 b1) Number.MIN_VALUE)
          (check-conversion api "parse" (binary-decimal b3 -1075) (* 2 Number.MIN_VALUE))))))

  (test "long coefficients, balanced exponents and nondecimal integers retain every rounding digit and reject trailing invalid data"
    (lambda ()
      (let ((api (open-runtime "number-parse" parse-source
                   (js-object :maxSlots 256 :initialBytes 65536 :maxBytes 4194304)))
            (inputs (js-array
                      (str (js-call "0" :repeat 4096) "1")
                      (str "1" (js-call "0" :repeat 4096) "e-4096")
                      (str "0." (js-call "0" :repeat 4096) "1e4097")
                      (str "1." (js-call "0" :repeat 4096) "1")
                      (str "0x" (js-call "f" :repeat 512))
                      (str "0b1" (js-call "0" :repeat 1075))
                      (str "0o" (js-call "7" :repeat 400))
                      (str "1e" (js-call "0" :repeat 4096) "2"))))
        (js-call inputs :forEach
          (lambda (input)
            (check-conversion api "parse" input (globalThis.Number input))
            (check-conversion api "parse" (str input "x") globalThis.NaN))))))

  (test "random decimal grammar and radix strings agree exactly with independent Number conversion"
    (lambda ()
      (let ((api (open-runtime "number-parse" parse-source))
            (next (make-random 2889578965))
            (radices (js-array 2 8 16))
            (i 0))
        (while (< i 1024)
          (let* ((digits (js-call
                           (Array/from (js-object :length (+ 1 (% (funcall next) 96)))
                             (lambda () (globalThis.String (% (funcall next) 10))))
                           :join ""))
                 (point (% (funcall next) (+ (get digits :length) 1)))
                 (sign (if (/= (bit-and (funcall next) 1) 0) "-" ""))
                 (exp-val (- (% (funcall next) 1201) 600))
                 (input (str sign (js-call digits :slice 0 point) "." (js-call digits :slice point) "e" exp-val)))
            (check-conversion api "parse" input (globalThis.Number input))
            (let* ((radix (aref radices (% (funcall next) 3)))
                   (prefix (if (= radix 2) "0b" (if (= radix 8) "0o" "0x")))
                   (text (str prefix
                              (js-call
                                (Array/from (js-object :length (+ 1 (% (funcall next) 128)))
                                  (lambda () (js-call (% (funcall next) radix) :toString radix)))
                                :join ""))))
              ;; Direct Number(string) on some hosts loses a carry in long radix tokens.
              ;; BigInt parses the integer exactly before the independent f64 conversion.
              (check-conversion api "parse" text (globalThis.Number (globalThis.BigInt text)))))
          (setq i (+ i 1))))))

  (test "Number text is shortest roundtripping ECMAScript spelling with exact exponent cutoffs and primitive identities"
    (lambda ()
      (let ((api (open-runtime "number-text" text-source))
            (samples (js-array
                       nil false t undefined ""
                       (str "中😀" (String/fromCharCode 55296))
                       globalThis.NaN globalThis.Infinity (- globalThis.Infinity) -0.0
                       Number.MIN_VALUE Number.MAX_VALUE
                       1e-7 1e-6 1e20 1e21 0.1 0.5 1000000000000000100
                       (- (funcall js-pow 2 53) 1)
                       (funcall js-pow 2 53)
                       (+ (funcall js-pow 2 53) 2)))
            (next (make-random 2672016241))
            (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
            (i 0))
        (js-call samples :forEach
          (lambda (input) (check-conversion api "text" input (globalThis.String input))))
        (while (< i 2048)
          (js-call view :setUint32 0 (funcall next) t)
          (js-call view :setUint32 4 (funcall next) t)
          (let ((value (js-call view :getFloat64 0 t)))
            (check-conversion api "text" value (globalThis.String value)))
          (setq i (+ i 1))))))

  (test "existing concat and numeric object property keys use complete finite Number text rather than rejecting fractional or large values"
    (lambda ()
      (let ((api (open-runtime "number-property-text"
                   "(defun concat (value) (js-call \"n=\" :concat value)) (defun key (value) (let ((object (js-object))) (put object value \"ok\") (get object value))) (export concat key)")))
        (js-call (js-array 0.5 -0.5 1e-7 1e-6 1e20 1e21 Number.MIN_VALUE Number.MAX_VALUE globalThis.NaN globalThis.Infinity (- globalThis.Infinity) -0.0)
          :forEach
          (lambda (value)
            (check-conversion api "concat" value (str "n=" (globalThis.String value)))
            (check-conversion api "key" value "ok"))))))

  (test "source string positions convert decimal/radix/invalid text with each method exact clamp and NaN defaults"
    (lambda ()
      (let ((api (open-runtime "number-positions"
                   "(defun at (position) (js-call \"abcdef\" :at position)) (defun code (position) (js-call \"abcdef\" :charCodeAt position)) (defun last (position) (js-call \"ababa\" :lastIndexOf \"a\" position)) (defun slice (position) (js-call \"abcdef\" :slice position)) (export at code last slice)"))
            (positions (js-array
                         "" "1" "-1" "1.9" "-1.9" "0x2" "0b10"
                         (str whitespace "2" whitespace)
                         "NaN" "Infinity" "-Infinity" "invalid" "5e-324")))
        (js-call positions :forEach
          (lambda (position)
            (check-conversion api "code" position (js-call "abcdef" :charCodeAt position))
            (check-conversion api "last" position (js-call "ababa" :lastIndexOf "a" position))
            (check-conversion api "slice" position (js-call "abcdef" :slice position))
            (let ((value (box-value api position))
                  (result undefined))
              (try
                (setq result (js-call api :invoke "at" (js-array value)))
                (js-call assert :equal
                  (if (undefined? result) result (js-call api :readString result))
                  (js-call "abcdef" :at position))
                (finally
                  (unless (undefined? result)
                    (js-call api :release result))
                  (js-call api :release value)))
              (js-call api :collect)
              (js-call assert :equal (js-call api :live) 0)
              (js-call assert :equal (get (js-call api :stats) :frameDepth) 0)))))))

  (test "generated JS primitive conversion agrees with exact nondecimal integer rounding under Bun"
    (async ()
      (let* ((compiler (get backend :compiler))
             (program (js-call compiler :compile_ir_string parse-source "js-number-parse.eli"))
             (js-source (js-call compiler :emit_ir_string program))
             (mod (await (funcall dyn-import (str "data:text/javascript;base64," (js-call (Buffer/from js-source) :toString "base64"))))))
        (js-call assert :equal (js-call mod :parse longHex) (globalThis.Number (globalThis.BigInt longHex))))))

  (test "conversion captures each operand once, converts str arguments before later effects and keeps empty str and borrowed string identity"
    (lambda ()
      (let ((api (open-runtime "number-conversion-order"
                   "(defun order (a b) (str a (setq a b) a)) (defun empty () (str)) (defun identity (a) (str a)) (defun capture (a b) (let ((first (string-to-number a))) (setq a b) (+ first (string-to-number a)))) (export order empty identity capture)")))
        (js-call (js-array
                   (js-array 0.5 1e21)
                   (js-array "中😀" "-0")
                   (js-array nil undefined)
                   (js-array t false))
          :forEach
          (lambda (pair)
            (let* ((first (aref pair 0))
                   (second (aref pair 1))
                   (a (box-value api first))
                   (b (box-value api second))
                   (out (js-call api :invoke "order" (js-array a b))))
              (js-call assert :equal
                (js-call api :readString out)
                (str (globalThis.String first) (globalThis.String second) (globalThis.String second)))
              (js-call api :release out)
              (js-call api :release a)
              (js-call api :release b)
              (js-call api :collect)
              (js-call assert :equal (js-call api :live) 0))))
        (let ((empty (js-call api :invoke "empty")))
          (js-call assert :equal (js-call api :readString empty) "")
          (js-call api :release empty))
        (let* ((surr (str "中😀" (String/fromCharCode 55296)))
               (input (js-call api :string surr))
               (output (js-call api :invoke "identity" (js-array input))))
          (funcall assert (js-call api :keyEqual input output))
          (js-call api :release input)
          (js-call assert :equal (js-call api :readString output) surr)
          (js-call api :release output))
        (let* ((a (js-call api :string "1.5"))
               (b (js-call api :string "2.5"))
               (sum (js-call api :invoke "capture" (js-array a b))))
          (js-call assert :equal (js-call api :readNumber sum) 4)
          (js-call (js-array a b sum) :forEach (lambda (v) (js-call api :release v)))
          (js-call api :collect)
          (js-call assert :equal (js-call api :live) 0)
          (js-call assert :equal (get (js-call api :stats) :frameDepth) 0)))))

  (test "raw Number and text conversions reject unfinished strings and private frames while retaining borrowed arguments through allocating GC"
    (lambda ()
      (open-runtime "number-parse" parse-source)
      (let* ((inst (new WebAssembly.Instance (new WebAssembly.Module (js-call compiled :get "number-parse"))))
             (e (get inst :exports))
             (heap (funcall (get e "heap-new") 64 4096 65536))
             (call-raw (lambda (name &rest args)
                         (let ((value (unsigned-bit-shift-right (apply (get e name) heap args) 0)))
                           (js-call assert :equal (funcall (get e "last-error")) 0 name)
                           value)))
             (source (funcall call-raw "value-string" 3))
             (sample "1.5")
             (i 0))
        (while (< i (get sample :length))
          (funcall call-raw "value-unit-set" source i (js-call sample :charCodeAt i))
          (setq i (+ i 1)))
        (funcall (get e "value-to-number") heap source)
        (js-call assert :equal (funcall (get e "last-error")) 6)
        (funcall call-raw "value-seal" source)
        (funcall call-raw "heap-auto" 1)
        (let ((num (funcall call-raw "value-to-number" source)))
          (funcall call-raw "heap-pin" source)
          (funcall call-raw "heap-pin" num)
          (js-call assert :equal
            (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64
              (funcall call-raw "value-data" num 4) t)
            1.5)
          (let ((text (funcall call-raw "value-to-text" num)))
            (funcall call-raw "heap-pin" text)
            (let ((p (funcall call-raw "value-data" text 5)))
              (js-call assert :equal
                (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getUint16 (+ p 2) t)
                46))
            (let ((frame (funcall call-raw "frame-new" 1)))
              (funcall call-raw "frame-set" frame 0 source)
              (funcall (get e "value-to-number") heap frame)
              (js-call assert :equal (funcall (get e "last-error")) 3)
              (js-call assert :equal (funcall call-raw "frame-depth") 1)
              (funcall call-raw "frame-pop" frame)
              (js-call (js-array source num text) :forEach
                (lambda (v) (funcall call-raw "heap-release" v)))
              (funcall call-raw "heap-collect")
              (js-call assert :equal (funcall call-raw "heap-live") 0)))))))

  (test "conversion capacity failures preserve exact input bits and caller roots, while successful growth reloads all pool addresses"
    (lambda ()
      (let* ((options (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096))
             (parse (open-runtime "number-parse" parse-source options))
             (input (str "1." (js-call "0" :repeat 400) "1"))
             (source (js-call parse :string input))
             (frame (js-call parse :frame 1)))
        (js-call parse :frameSet frame 0 source)
        (js-call assert :throws
          (lambda () (js-call parse :invoke "parse" (js-array source)))
          (lambda (err) (= (get (get err :eliscriptDiagnostic) :code) "ELI-RT0002")))
        (js-call assert :equal (js-call parse :readString source) input)
        (js-call assert :equal (get (js-call parse :stats) :frameDepth) 1)
        (js-call parse :leaveFrame frame)
        (js-call parse :release source)
        (js-call parse :collect)
        (js-call assert :equal (js-call parse :live) 0)
        (let* ((fmt (open-runtime "number-text" text-source options))
               (num (js-call fmt :number Number.MIN_VALUE))
               (fill (js-call fmt :bytes (new globalThis.Uint8Array 800)))
               (outer (js-call fmt :frame 1)))
          (js-call fmt :frameSet outer 0 num)
          (js-call assert :throws
            (lambda () (js-call fmt :invoke "text" (js-array num)))
            (lambda (err) (= (get (get err :eliscriptDiagnostic) :code) "ELI-RT0002")))
          (js-call assert :equal (js-call fmt :readNumber num) Number.MIN_VALUE)
          (js-call assert :equal (get (js-call fmt :stats) :frameDepth) 1)
          (js-call fmt :leaveFrame outer)
          (js-call fmt :release num)
          (js-call fmt :release fill)
          (js-call fmt :collect)
          (js-call assert :equal (js-call fmt :live) 0))
        (let* ((growing (open-runtime "number-parse" parse-source
                          (Object/assign (js-object) options (js-object :maxBytes 65536))))
               (original (js-call growing :string input))
               (result (js-call growing :invoke "parse" (js-array original))))
          (js-call assert :equal (js-call growing :readNumber result) (globalThis.Number input))
          (js-call assert :equal (js-call growing :readString original) input)
          (funcall assert (> (get (js-call growing :stats) :capacityBytes) 4096))
          (js-call growing :release original)
          (js-call growing :release result)
          (js-call growing :collect)
          (js-call assert :equal (js-call growing :live) 0)))))

  (test "earlier conversion errors suppress later genuine traps and true WASM conversion traps unwind only their private frames"
    (async ()
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun number-big-round "))
             (end (js-call source :indexOf "  (defun number-text-digit " start)))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((compiler (get backend :compiler))
               (managed (get backend :managed))
               (injected (js-call compiler :compile_ir_string
                           (str (js-call source :slice 0 start)
                                "  (defun number-big-round (a b temporary output sign) (load-u32 4294967295))\n"
                                (js-call source :slice end))
                           "trap-runtime.eli"))
               (program (js-call compiler :compile_ir_string
                          "(defun fault (value) (str (string-to-number value) (string-to-number \"1\"))) (export fault)"
                          "conversion-trap.eli"))
               (api (instantiateManagedRuntime (Uint8Array/from (js-call managed :emit_managed_wasm program injected)))))
          (js-call api :auto 1)
          (let ((input (js-call api :string "1"))
                (invalid (js-call api :sourceObject (js-object)))
                (outer (js-call api :frame 1)))
            (js-call api :frameSet outer 0 input)
            (js-call assert :throws
              (lambda () (js-call api :invoke "fault" (js-array invalid)))
              (lambda (err) (= (get (get err :eliscriptDiagnostic) :code) "ELI-RT0003")))
            (js-call assert :equal (get (js-call api :stats) :frameDepth) 1)
            (js-call assert :throws
              (lambda () (js-call api :invoke "fault" (js-array input)))
              (lambda (err) (funcall instance-of? err WebAssembly.RuntimeError)))
            (js-call assert :equal (get (js-call api :stats) :frameDepth) 1)
            (js-call assert :equal (js-call api :readString input) "1")
            (js-call api :leaveFrame outer)
            (js-call api :release input)
            (js-call api :release invalid)
            (js-call api :collect)
            (js-call assert :equal (js-call api :live) 0))))))

  (test "unsupported coercions, malformed conversion IR, stale handles and cross-instance values are refused with unchanged input IR"
    (lambda ()
      (let* ((api (open-runtime "number-parse" parse-source))
             (other (open-runtime "number-parse" parse-source))
             (object (js-call api :sourceObject (js-object)))
             (foreign (js-call other :string "1")))
        (js-call assert :throws
          (lambda () (js-call api :invoke "parse" (js-array object)))
          (lambda (err) (= (get (get err :eliscriptDiagnostic) :code) "ELI-RT0003")))
        (js-call assert :throws
          (lambda () (js-call api :invoke "parse" (js-array foreign)))
          (lambda (err) (= (get (get err :eliscriptDiagnostic) :code) "ELI-RT0001")))
        (js-call other :release foreign)
        (js-call other :collect)
        (js-call api :release object)
        (js-call api :collect)
        (js-call assert :equal (js-call api :live) 0)
        (let ((stale (js-call api :string "1")))
          (js-call api :release stale)
          (js-call api :collect)
          (js-call assert :throws
            (lambda () (js-call api :invoke "parse" (js-array stale)))
            (lambda (err) (= (get (get err :eliscriptDiagnostic) :code) "ELI-RT0001"))))
        (let* ((ir (js-call (get backend :compiler) :compile_ir_string parse-source "invalid-conversion.eli"))
               (pending (js-array ir))
               (call-node undefined))
          (while (and (> (get pending :length) 0) (undefined? call-node))
            (let ((val (js-call pending :pop)))
              (when (and (not (nullish? val)) (= (funcall js-typeof val) "object"))
                (if (and (= (get val :kind) "intrinsic") (= (get val :value) "string-to-number"))
                    (setq call-node val)
                    (js-call (Object/values val) :forEach
                      (lambda (child) (js-call pending :push child)))))))
          (funcall assert call-node)
          (put call-node :children (js-array))
          (let ((saved (JSON/stringify ir)))
            (js-call assert :throws
              (lambda () (js-call (get backend :managed) :emit_managed_wasm ir runtime-program))
              (lambda (err)
                (let ((diag (get err :eliscriptDiagnostic)))
                  (and (not (nullish? diag))
                       (= (get diag :code) "ELI-B0001")
                       (= (get (get diag :location) :file) "invalid-conversion.eli")))))
            (js-call assert :equal (JSON/stringify ir) saved))))))

  (test "Node independently executes the same zero-import Number conversions with exact radix rounding, negative zero, formatting and complete root cleanup"
    (async ()
      (open-runtime "number-parse" parse-source)
      (open-runtime "number-text" text-source)
      (let ((parse-path (resolve directory "parse.wasm"))
            (text-path (resolve directory "text.wasm"))
            (managed-url (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)))
        (await (writeFile parse-path (js-call compiled :get "number-parse")))
        (await (writeFile text-path (js-call compiled :get "number-text")))
        (let ((result (spawnSync "node"
                        (js-array node-helper "--run-node-wasm" managed-url parse-path text-path)
                        (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get result :status) 0 (get result :stderr))))))

  (test "private integer precision kernels match an independent BigInt model across wide carries, shifts, subtraction and binary64 rounding"
    (async ()
      (let* ((kernel-names (js-array
                             "number-big-init" "number-big-copy" "number-big-shift"
                             "number-big-multiply" "number-big-subtract" "number-big-compare"
                             "number-big-bits" "number-big-add" "number-big-round"))
             (source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (ir (js-call (get backend :compiler) :compile_ir_string
                   (str source "\n(export " (js-call kernel-names :join " ") ")\n")
                   "integer-model.eli"))
             (bytes (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm ir))))
        (js-call assert :deepEqual
          (WebAssembly.Module/imports (new WebAssembly.Module bytes))
          (js-array))
        (let* ((inst (new WebAssembly.Instance (new WebAssembly.Module bytes)))
               (e (get inst :exports))
               (view (new globalThis.DataView (get (get e :memory) :buffer)))
               (a 10000)
               (b 11000)
               (temporary 12000)
               (output 13000)
               (capacity 128)
               (b0 (globalThis.BigInt 0))
               (b1 (globalThis.BigInt 1))
               (b16 (globalThis.BigInt 16))
               (b32 (globalThis.BigInt 32))
               (b65535 (globalThis.BigInt 65535))
               (call-raw (lambda (name &rest args)
                           (let ((out (unsigned-bit-shift-right (apply (get e name) args) 0)))
                             (js-call assert :equal (funcall (get e "last-error")) 0 name)
                             out)))
               (write-big (lambda (p initial-val)
                            (funcall call-raw "number-big-init" p capacity 0 0)
                            (let ((val initial-val)
                                  (i 0))
                              (while (/= val b0)
                                (js-call view :setUint16
                                  (+ p 8 (* i 2))
                                  (globalThis.Number (funcall bi-and val b65535))
                                  t)
                                (setq val (funcall bi-shr val b16))
                                (setq i (+ i 1)))
                              (js-call view :setUint32 p i t))))
               (read-big (lambda (p)
                           (let ((result b0)
                                 (i (- (js-call view :getUint32 p t) 1)))
                             (while (>= i 0)
                               (setq result
                                 (funcall bi-add
                                   (funcall bi-shl result b16)
                                   (globalThis.BigInt (js-call view :getUint16 (+ p 8 (* i 2)) t))))
                               (setq i (- i 1)))
                             result)))
               (next (make-random 968842961))
               (i 0))
          (while (< i 512)
            (let ((value b0)
                  (j 0)
                  (cnt (% (funcall next) 48)))
              (while (< j cnt)
                (setq value (funcall bi-add (funcall bi-shl value b32) (globalThis.BigInt (funcall next))))
                (setq j (+ j 1)))
              (let ((operand (globalThis.BigInt (funcall next)))
                    (factor (+ 1 (% (funcall next) 32768)))
                    (carry (% (funcall next) 65536))
                    (shift (% (funcall next) 128)))
                (funcall write-big a value)
                (funcall write-big b operand)
                (funcall write-big temporary b0)
                (js-call assert :equal
                  (funcall call-raw "number-big-bits" a)
                  (if (= value b0) 0 (get (js-call value :toString 2) :length)))
                (js-call assert :equal
                  (funcall call-raw "number-big-compare" a b)
                  (if (funcall bi-lt value operand) 0 (if (= value operand) 1 2)))
                (funcall call-raw "number-big-copy" temporary a)
                (js-call assert :equal (funcall read-big temporary) value)
                (funcall call-raw "number-big-multiply" a factor carry)
                (js-call assert :equal
                  (funcall read-big a)
                  (funcall bi-add (funcall bi-mul value (globalThis.BigInt factor)) (globalThis.BigInt carry)))
                (funcall write-big a value)
                (funcall call-raw "number-big-shift" a shift)
                (js-call assert :equal (funcall read-big a) (funcall bi-shl value (globalThis.BigInt shift)))
                (funcall write-big a value)
                (funcall call-raw "number-big-add" a b)
                (js-call assert :equal (funcall read-big a) (funcall bi-add value operand))
                (funcall call-raw "number-big-subtract" a b)
                (js-call assert :equal (funcall read-big a) value)
                (funcall write-big a value)
                (funcall write-big b b1)
                (funcall write-big temporary b0)
                (when (/= value b0)
                  (funcall call-raw "number-big-round" a b temporary output 0)
                  (funcall assert (Object/is (js-call view :getFloat64 output t) (globalThis.Number value))))))
            (setq i (+ i 1)))))))

  (test "seed and self-hosted JS conversion bytes match, ignore local constructor shadowing, evaluate once and retain object and Symbol conversion behavior"
    (async ()
      (let* ((source (str parse-source
                          "\n(defun shadow (Number BigInt value) (string-to-number value)) (defun once (counter value) (string-to-number (progn (put counter :calls (1+ (get counter :calls))) value))) (export shadow once)"))
             (input-path (resolve directory "js-number-input.eli"))
             (output-path (resolve directory "js-number-seed.mjs")))
        (await (writeFile input-path source))
        (let ((child (spawnSync (resolve "bin/eliscript-seed")
                       (js-array "--output" output-path input-path)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))
        (let* ((compiler (get backend :compiler))
               (seed (await (readFile output-path "utf8")))
               (ir (js-call compiler :compile_ir_string source input-path)))
          (js-call assert :equal (js-call compiler :emit_ir_string ir) seed)
          (let* ((js (await (funcall dyn-import (str "data:text/javascript;base64," (js-call (Buffer/from seed) :toString "base64")))))
                 (unexpected (lambda () (throw (new globalThis.Error "constructor parameter shadowed primitive"))))
                 (expected (globalThis.Number (globalThis.BigInt longHex)))
                 (counter (js-object :calls 0))
                 (trace (js-array))
                 (object (js-object)))
            (js-call assert :equal (js-call js :shadow unexpected unexpected longHex) expected)
            (js-call assert :equal (js-call js :once counter longHex) expected)
            (js-call assert :equal (get counter :calls) 1)
            (put object (get globalThis.Symbol :toPrimitive)
              (lambda (hint) (js-call trace :push hint) "-0"))
            (funcall assert (Object/is (js-call js :parse object) -0.0))
            (js-call assert :deepEqual trace (js-array "number"))
            (js-call assert :throws
              (lambda () (js-call js :parse (globalThis.Symbol "number")))
              globalThis.TypeError)
            (js-call (js-array "0x" "+0xff" "-0xff" "0b2" "0o8" "0xffn" "0x1_0" "0xffz") :forEach
              (lambda (value) (funcall assert (Number/isNaN (js-call js :parse value)))))
            (let ((plain (js-call compiler :emit_ir_string
                           (js-call compiler :compile_ir_string "(defun identity (value) value) (export identity)" "plain.eli"))))
              (funcall assert (not (js-call plain :includes "__eliscript_to_number"))))
            (let ((node-res (spawnSync "node"
                              (js-array node-helper "--run-node-seed" (get (pathToFileURL output-path) :href))
                              (js-object :encoding "utf8" :timeout 30000))))
              (js-call assert :equal (get node-res :status) 0 (get node-res :stderr)))))))))
