(module tests.compiler-source-map-cursor
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (defconst compilerSources (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))

  (import "../tools/compiler/source-map-cursor-benchmark.mjs" compilerSourceMapCursorSourceDigest validateCompilerSourceMapCursorReport)
  (defconst reportPath (resolve projectDirectory "benchmarks/compiler-source-map-cursor-macos-arm64.json"))
  (defconst compilerNames (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "compiler"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (defun identity (generatedMarks locations)
    (JSON/stringify (js-object :generatedMarks generatedMarks :locations (Array/from (js-call locations :entries)))))
  (test "ordered Source Map cursors match their complete scan references" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-source-map-cursor-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((modules (await (Promise/all (js-array (loadModule directory "compiler" "cursor") (loadModule directory "emitter" "cursor") (loadModule directory "source-map" "cursor")))))
               (compiler (aref modules 0)) (emitter (aref modules 1)) (sourceMap (aref modules 2)) (artifactMarks 0) (index 0))
          (while (< index (js-length compilerNames))
            (let* ((relative (str "bootstrap/compiler/" (aref compilerNames index) ".eli")) (source (await (readFile (resolve projectDirectory relative) "utf8")))
                   (program (js-call compiler :compile_ir_string source relative)) (artifact (js-call emitter :emit_module_artifact program))
                   (referenceMarks (js-call sourceMap :reference_collect_generated_marks (get artifact :text) (get artifact :marks)))
                   (optimizedMarks (js-call sourceMap :collect_generated_marks (get artifact :text) (get artifact :marks)))
                   (referenceLocations (js-call sourceMap :reference_source_locations source referenceMarks))
                   (optimizedLocations (js-call sourceMap :source_locations source optimizedMarks)))
              (be (identity optimizedMarks optimizedLocations) (identity referenceMarks referenceLocations))
              (setq artifactMarks (+ artifactMarks (get (get artifact :marks) :length))))
            (setq index (1+ index)))
          (js-call (expect artifactMarks) :toBeGreaterThan 20000)
          (let* ((source "a\n😀b\tc") (generated "x\nyz")
                 (marks (js-array (js-object :offset 0 :span (js-object :start 0)) (js-object :offset 0 :span (js-object :start 1))
                   (js-object :offset 1 :span (js-object :start 2)) (js-object :offset 2 :span (js-object :start 3)) (js-object :offset (get generated :length) :span (js-object :start 6))))
                 (referenceMarks (js-call sourceMap :reference_collect_generated_marks generated marks))
                 (optimizedMarks (js-call sourceMap :collect_generated_marks generated marks))
                 (referenceLocations (js-call sourceMap :reference_source_locations source referenceMarks))
                 (optimizedLocations (js-call sourceMap :source_locations source optimizedMarks)))
            (be (identity optimizedMarks optimizedLocations) (identity referenceMarks referenceLocations))
            (js-call (expect optimizedMarks) :toHaveLength 4)
            (be (aref (aref optimizedMarks 0) 0) 0) (be (aref (aref optimizedMarks 1) 0) 0)
            (same (js-call optimizedLocations :get 2) (js-array 1 0)) (be (js-call optimizedLocations :has 6) false))
          (let ((emptyMarks (js-array (js-object :offset 0 :span (js-object :start 0)))))
            (same (js-call sourceMap :collect_generated_marks "" emptyMarks) (js-array))
            (same (js-call (js-call sourceMap :source_locations "" (js-array (js-array 0 0 (js-object :start 0)))) :get 0) (js-array 0 0))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "committed Source Map cursor report preserves historical measurements and decisions" (async ()
    (let ((report (validateCompilerSourceMapCursorReport (await (readReport)))))
      (js-call (expect (get (get report :corpus) :files)) :toHaveLength 13)
      (js-call (expect (get (get report :corpus) :files)) :toContain "bootstrap/compiler/project.eli")
      (js-call (expect (get (get report :corpus) :artifactMarks)) :toBeGreaterThan 20000)
      (be (get (get report :validation) :identicalCompilerOutputs) 13)
      (js-call (expect (get (get report :measurements) :pipelineSpeedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumPipelineSpeedup))
      (js-call (expect (get (get report :measurements) :completeCompilerSpeedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumCompleteCompilerSpeedup)))))
  (test "failed Source Map gates retain complete measurement evidence" (async ()
    (let ((report (await (readReport))) (failure undefined))
      (put (get report :decision) :passed false)
      (try (validateCompilerSourceMapCursorReport report) (catch error (setq failure error)))
      (js-call (expect failure) :toBeInstanceOf globalThis.TypeError) (be (get failure :report) report))))
  (test "Source Map reacceptance rejects weaker speed and provenance claims" (async ()
    (let ((report (await (readReport))))
      (js-call (js-array "minimumPipelineSpeedup" "minimumCompleteCompilerSpeedup") :forEach (lambda (field)
        (let ((weakened (globalThis/structuredClone report)))
          (put (get weakened :decision) field 1.01)
          (js-call (expect (lambda () (validateCompilerSourceMapCursorReport weakened))) :toThrow "speedup decision failed"))))
      (let ((altered (globalThis/structuredClone report)))
        (put (aref (get (get (get altered :baseline) :control) :artifacts) 0) :control (js-call "0" :repeat 64))
        (js-call (expect (lambda () (validateCompilerSourceMapCursorReport altered))) :toThrow "controlled compiler baseline")))))
  (funcall (currentPerformanceTest test) "committed Source Map cursor report matches measured sources" (async ()
    (same (get (await (readReport)) :sourceDigest) (await (compilerSourceMapCursorSourceDigest)))))
)
