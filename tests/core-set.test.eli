(module tests.core-set.test
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/collection.mjs" IReduce isReduced unreduced)
  (import "../runtime/core/set-algebra.mjs" difference disjoint index intersection join mapInvert project rename renameKeys select set subset superset union)
  (import "../runtime/core/map.mjs" EMPTY_MAP persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/protocol.mjs" extendProtocolType)
  (import "../runtime/core/set.mjs" EMPTY_SET PersistentHashSet persistentHashSet)
  (import "../runtime/core/vector.mjs" persistentVector)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst EMACS (let ((value (get (get globalThis.process :env) :EMACS))) (if (nullish? value) "emacs" value)))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defconst USAGE_SOURCE (resolve ROOT "tests/fixtures/core-set-usage.eli"))
  (defconst Values (funcall (js* "(initialize) => class Values { constructor(values) { initialize(this, values); } }")
    (lambda (this values) (put this :values (Object/freeze (Array/from values))) (Object/freeze this))))
  (extendProtocolType IReduce Values (js-object :reduce (lambda (source reducer initial)
    (let ((result initial) (index 0) (done false) (items (get source :values)))
      (while (and (not done) (< index (get items :length)))
        (setq result (funcall reducer result (aref items index)))
        (when (isReduced result) (setq result (unreduced result) done t))
        (setq index (1+ index)))
      result))))
  (defun values (&rest items) (new Values items))
  (defun ordered (collection) (js-call (Array/from collection) :sort (lambda (left right) (- left right))))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun rejects (operation message) (js-call (expect operation) :toThrow message))
  (defasync runSuccessful (command)
    (let* ((child (Bun/spawn command (js-object :cwd ROOT :env (copyHostRecord (get globalThis.process :env) (js-object :EMACS EMACS)) :stdout "pipe" :stderr "pipe")))
           (results (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref results 0)) (stdout (aref results 1)) (stderr (aref results 2)))
      (unless (= exitCode 0)
        (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
          (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str (aref command 0) " exited with " exitCode)))))))
      stdout))
  (defasync compile (source output)
    (await (mkdir (dirname output) (js-object :recursive t)))
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source))))
  (defasync runUsageHost (command module)
    (JSON/parse (await (runSuccessful (js-array command (resolve ROOT "tests/fixtures/core-set-usage-host.mjs") module)))))
  (test "set conversion and union accept protocol sources with value semantics" (lambda ()
    (let* ((firstKey (persistentVector "same")) (equalKey (persistentVector "same"))
           (converted (set (values 1 2 2 firstKey equalKey))))
      (js-call (expect converted) :toBeInstanceOf PersistentHashSet)
      (be (get converted :count) 3) (be (js-call converted :has (persistentVector "same")) t)
      (be (set converted) converted) (be (set nil) EMPTY_SET)
      (let* ((native (new globalThis.Set (js-array 2 3))) (combined (union converted native (values 4 4))))
        (be (get combined :count) 5) (be (js-call combined :has 1) t) (be (js-call combined :has 4) t)
        (same native (new globalThis.Set (js-array 2 3))))
      (be (union converted) converted) (be (union) EMPTY_SET))))
  (test "intersection and difference preserve left metadata and immutable inputs" (lambda ()
    (let* ((metadata (js-call EMPTY_MAP :assoc "owner" "left"))
           (left (withMeta (persistentHashSet 1 2 3 4) metadata)) (native (new globalThis.Set (js-array 3 4 5)))
           (common (intersection left native (values 4 5))) (remaining (difference left (js-array 2) (values 4 9))))
      (same (ordered common) (js-array 4)) (be (meta common) metadata)
      (same (ordered remaining) (js-array 1 3)) (be (meta remaining) metadata)
      (same (ordered left) (js-array 1 2 3 4)) (same native (new globalThis.Set (js-array 3 4 5))))))
  (test "set relations are value-semantic and enforce complete arity" (lambda ()
    (be (subset (js-array 1 2) (values 3 2 1)) t) (be (subset (js-array 1 4) (js-array 1 2 3)) false)
    (be (subset (js-array) nil) t) (be (superset (new globalThis.Set (js-array 1 2 3)) (js-array 2 3)) t)
    (be (superset (js-array 1) (js-array 1 2)) false)
    (be (disjoint (values 1 2) (new globalThis.Set (js-array 3 4))) t)
    (be (disjoint (js-array 1 2) (js-array 2 3)) false)
    (rejects (lambda () (set)) "set expects 1 collection")
    (rejects (lambda () (set (js-array) (js-array))) "set expects 1 collection")
    (rejects (lambda () (intersection)) "intersection expects at least one collection")
    (rejects (lambda () (difference)) "difference expects at least one collection")
    (rejects (lambda () (subset (js-array 1))) "subset expects 2 collections")
    (rejects (lambda () (superset (js-array 1) (js-array 2) (js-array 3))) "superset expects 2 collections")
    (rejects (lambda () (disjoint)) "disjoint expects 2 collections")))
  (test "relational projection and selection preserve value semantics and metadata" (lambda ()
    (let* ((metadata (js-call EMPTY_MAP :assoc "source" "people"))
           (ada (persistentHashMap (js-array "id" 1) (js-array "name" "Ada") (js-array "team" "compiler")))
           (lin (persistentHashMap (js-array "id" 2) (js-array "name" "Lin") (js-array "team" "runtime")))
           (source (withMeta (persistentHashSet ada lin) metadata))
           (selected (select (lambda (row) (= (js-call row :get "team") "compiler")) source)))
      (be (get selected :count) 1) (be (js-call selected :has ada) t) (be (meta selected) metadata)
      (be (select (lambda () t) source) source)
      (let ((projected (project source (values "team"))))
        (be (get projected :count) 2)
        (be (js-call projected :has (persistentHashMap (js-array "team" "compiler"))) t)
        (be (js-call projected :has (persistentHashMap (js-array "team" "runtime"))) t)
        (be (meta projected) metadata)))))
  (test "relational rename and inversion handle swaps and traversal collisions" (lambda ()
    (let* ((metadata (js-call EMPTY_MAP :assoc "source" "mapping"))
           (source (withMeta (persistentHashMap (js-array "left" 1) (js-array "right" 2) (js-array "stable" 3)) metadata))
           (swapped (renameKeys source (persistentHashMap (js-array "left" "right") (js-array "right" "left") (js-array "missing" "new")))))
      (be (js-call swapped :get "left") 2) (be (js-call swapped :get "right") 1) (be (js-call swapped :get "stable") 3)
      (be (js-call swapped :has "missing") false) (be (meta swapped) metadata)
      (let* ((relation (persistentHashSet source)) (renamed (rename relation (persistentHashMap (js-array "stable" "kept")))))
        (be (js-call renamed :has (persistentHashMap (js-array "left" 1) (js-array "right" 2) (js-array "kept" 3))) t))
      (let* ((collisionSource (persistentHashMap (js-array "first" "shared") (js-array "second" "shared")))
             (entries (Array/from collisionSource)) (lastKey undefined) (index 0))
        (while (< index (get entries :length)) (setq lastKey (aref (aref entries index) 0) index (1+ index)))
        (let ((inverted (mapInvert collisionSource)))
          (be (get inverted :count) 1) (be (js-call inverted :get "shared") lastKey))))))
  (test "relational indexing drives natural and mapped joins" (lambda ()
    (let* ((ada (persistentHashMap (js-array "id" 1) (js-array "name" "Ada") (js-array "team" "compiler")))
           (lin (persistentHashMap (js-array "id" 2) (js-array "name" "Lin") (js-array "team" "runtime")))
           (people (persistentHashSet ada lin)) (grouped (index people (js-array "team"))))
      (be (get grouped :count) 2) (be (js-call (js-call grouped :get (persistentHashMap (js-array "team" "compiler"))) :has ada) t)
      (let* ((roles (persistentHashSet (persistentHashMap (js-array "id" 1) (js-array "role" "admin"))
                      (persistentHashMap (js-array "id" 4) (js-array "role" "guest"))))
             (natural (join people roles)))
        (be (get natural :count) 1)
        (be (js-call natural :has (persistentHashMap (js-array "id" 1) (js-array "name" "Ada") (js-array "team" "compiler") (js-array "role" "admin"))) t))
      (let* ((memberships (persistentHashSet (persistentHashMap (js-array "user-id" 2) (js-array "role" "maintainer"))))
             (mapped (join people memberships (persistentHashMap (js-array "id" "user-id")))))
        (be (get mapped :count) 1)
        (be (js-call (aref (Array/from mapped) 0) :get "name") "Lin")
        (be (js-call (aref (Array/from mapped) 0) :get "role") "maintainer")
        (let ((leftSmaller (join (persistentHashSet lin)
                (apply persistentHashSet (js-call (Array/from memberships) :concat (js-array (persistentHashMap (js-array "user-id" 9) (js-array "role" "observer")))))
                (persistentHashMap (js-array "id" "user-id")))))
          (be (get leftSmaller :count) 1) (be (js-call (aref (Array/from leftSmaller) 0) :get "role") "maintainer")))
      (be (get (join people EMPTY_SET) :count) 0))))
  (test "relational set operations enforce arity and predicate contracts" (lambda ()
    (rejects (lambda () (select nil (js-array))) "select predicate must be a function")
    (rejects (lambda () (project (js-array))) "project expects 2 collections")
    (rejects (lambda () (renameKeys (js-object))) "renameKeys expects 2 collections")
    (rejects (lambda () (rename (js-array))) "rename expects 2 collections")
    (rejects (lambda () (index (js-array))) "index expects 2 collections")
    (rejects (lambda () (mapInvert (js-object) (js-object))) "mapInvert expects 1 collection")
    (rejects (lambda () (join)) "join expects 2 or 3 relations")
    (rejects (lambda () (join (js-array) (js-array) (js-object) (js-object))) "join expects 2 or 3 relations")))
  (test "Eliscript-authored set algebra compiles and agrees across local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-core-set-"))))
           (runtimeLink (resolve directory "runtime")) (setModule (resolve directory "stdlib/core/set.mjs"))
           (usageModule (resolve directory "core-set-usage.mjs")))
      (try
        (await (symlink (resolve ROOT "runtime") runtimeLink "dir"))
        (await (compile (resolve ROOT "stdlib/core/set.eli") setModule))
        (await (compile USAGE_SOURCE usageModule))
        (let ((expected (js-object "converted" (js-array 1 2 3) "united" (js-array 1 2 3 4 5) "intersected" (js-array 2 3) "subtracted" (js-array 1 3) "subset" t "superset" t "disjoint" t "selected" (js-array (js-object "id" 1 "name" "Ada" "team" "compiler") (js-object "id" 3 "name" "Mira" "team" "compiler")) "projected" (js-array (js-object "team" "compiler") (js-object "team" "runtime")) "renamed" (js-array (js-object "id" 1 "display" "Ada" "team" "compiler") (js-object "id" 2 "display" "Lin" "team" "runtime") (js-object "id" 3 "display" "Mira" "team" "compiler")) "renamedKeys" (js-object "left" 2 "right" 1) "indexSizes" (js-array 1 2) "inverted" (js-array (js-array 1 "left") (js-array 2 "right")) "joined" (js-array (js-object "id" 1 "name" "Ada" "role" "admin" "team" "compiler")) "mappedJoined" (js-array (js-object "id" 2 "name" "Lin" "role" "maintainer" "team" "runtime" "user-id" 2)))))
          (same (await (runUsageHost (get globalThis.process :execPath) usageModule)) expected)
          (same (await (runUsageHost (let ((node (get (get globalThis.process :env) :NODE))) (if (nullish? node) "node" node)) usageModule)) expected))
        (let ((sourceMap (JSON/parse (await (readFile (str setModule ".map") "utf8")))))
          (js-call (expect (aref (get sourceMap :sourcesContent) 0)) :toContain "(defun union")
          (js-call (expect (aref (get sourceMap :sourcesContent) 0)) :toContain "(defun subset?")
          (js-call (expect (aref (get sourceMap :sourcesContent) 0)) :toContain "(defun join")
          (js-call (get (expect (aref (get sourceMap :sourcesContent) 0)) :not) :toContain "runtime/core/set-algebra.mjs"))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
)
