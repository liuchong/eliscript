(module tests.js-array-text-fast-path.test
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" readFile writeFile mkdtemp rm mkdir readdir)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../runtime/array-text.mjs" c)
  (import "./helpers/array-text-contract.mjs" checkSemantics checkActiveFrames)
  (defconst host (resolve (js* "import.meta.dir") "fixtures/array-text-host.mjs"))
  (defun hostResult (command mode &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (spawnSync command (js-call (js-array host mode) :concat (if (= args undefined) (js-array) args)) (js-object :encoding "utf8" :timeout 30000))))
  (test "boxed values, hooks, mutations, getter cycles, captured methods and cleanup retain independent native semantics" (lambda () (checkSemantics c)))
  (test "captured intrinsics survive later global and prototype replacement while captured source methods retain identity" (lambda ()
    (js-call (js-array "node" "bun") :forEach (lambda (command) (let ((child (hostResult command "intrinsics"))) (js-call assert :equal (get child :status) 0 (str command ": " (get child :stderr))))))))
  (test "public Seed and all thirteen compiler modules retain three-generation String join artifacts, Source Maps and executable semantics" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-string-fast-seed-")))))
      (try
        (let* ((bootstrap (resolve directory "bootstrap"))
               (built (spawnSync (resolve "bin/eliscript-bootstrap") (js-array) (js-object :encoding "utf8" :timeout 30000 :env (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR bootstrap))))))
          (js-call assert :equal (get built :status) 0 (get built :stderr))
          (let* ((compiler (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve bootstrap "compiler.mjs")) :href))))
                 (source "(defun join (values separator) (js-call values :join separator)) (defun text (values) (js-call values :toString)) (export join text)")
                 (input (resolve directory "join.eli")) (output (resolve directory "join.mjs")))
            (await (writeFile input source))
            (let ((seeded (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
              (js-call assert :equal (get seeded :status) 0 (get seeded :stderr)))
            (let* ((canonical (js-call compiler :compile_string source input))
                   (files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort))
                   (originals undefined) (generation 0))
              (js-call assert :equal (await (readFile output "utf8")) canonical) (js-call assert :equal (get files :length) 13)
              (while (< generation 3)
                (js-call assert :equal (js-call compiler :compile_string source input) canonical)
                (let ((m (await (funcall (js* "(url) => import(url)") (str "data:text/javascript;base64," (js-call (Buffer/from canonical) :toString "base64"))))))
                  (js-call (js-array (js-array) (js-array "a" "" "中😀" "\ud800") (js-array nil (js* "-0") (js* "1n") (new globalThis.String "boxed"))) :forEach
                    (lambda (value) (js-call assert :equal (js-call m :join value "|") (js-call value :join "|"))))
                  (let ((cycle (js-array))) (js-call cycle :push cycle)
                    (js-call assert :throws (lambda () (js-call m :join cycle ",")) (lambda (error) (let ((diagnostic (get error :eliscriptDiagnostic))) (= (if (nullish? diagnostic) undefined (get diagnostic :code)) "ELI-RT0009"))))))
                (let ((out (resolve directory (str "g" generation))) (artifacts (js-array)) (index 0))
                  (await (mkdir out))
                  (while (< index (get files :length))
                    (let* ((file (aref files index)) (filename (resolve "bootstrap/compiler" file)) (source (await (readFile filename "utf8")))
                           (target (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                           (emission (js-call compiler :compile_string_with_source_map source filename target file)))
                      (js-call artifacts :push (js-array file (get emission :javascript) (get emission :sourceMap))) (await (writeFile (resolve out target) (get emission :javascript))))
                    (setq index (1+ index)))
                  (if originals (js-call assert :deepEqual artifacts originals) (setq originals artifacts))
                  (setq compiler (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve out "compiler.mjs")) :href)))))
                (setq generation (1+ generation)))
              (let ((child (hostResult "node" "compiled" (js-array (get (pathToFileURL output) :href))))) (js-call assert :equal (get child :status) 0 (get child :stderr))))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "outermost joins avoid all three WeakSet calls while every nested array retains its original membership checks and cleanup" (lambda ()
    ;; Isolate prototype instrumentation in one Bun child. The actual runtime captures
    ;; the counted native methods; no source spelling or generated JS rewrite is used.
    (let ((child (hostResult (get process :execPath) "weak-counts"))) (js-call assert :equal (get child :status) 0 (get child :stderr)))))
  (test "root registration follows length and separator conversion and nested failures restore each independent active frame" (lambda () (checkActiveFrames c)))
)
