(module tests.helpers.fragment-combine-contract
  (import "node:assert/strict" :default assert)
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst host-add (js* "(left, right) => left + right"))
  (defconst unsigned32 (js* "(value) => value >>> 0"))
  ;; Native indexed reads and + coercion distinguish the old JS oracle from the implementation.
  (defun oracle (parts)
    (let ((text "") (marks (js-array)) (partIndex 0))
      (while (< partIndex (get parts :length))
        (let* ((value (aref parts partIndex)) (part (if (nullish? value) nil value))
               (fragment (if (= (funcall host-typeof part) "string") (js-object :text part :marks (js-array)) part))
               (offset (get text :length)) (fragmentMarks (get fragment :marks)) (markIndex 0))
          (while (< markIndex (get fragmentMarks :length))
            (let* ((value (aref fragmentMarks markIndex)) (mark (if (nullish? value) nil value)))
              (js-call marks :push (js-object :offset (funcall host-add offset (get mark :offset)) :span (get mark :span))))
            (setq markIndex (1+ markIndex)))
          (setq text (str (funcall globalThis.String text) (funcall globalThis.String (get fragment :text)))))
        (setq partIndex (1+ partIndex)))
      (js-object :text text :marks marks)))
  (defun effectful-parts ()
    (let ((trace (js-array)) (parts (js-array "prefix" nil "old")) (markRead 0) (mark (js-object)))
      (Object/defineProperty mark "offset" (js-object :enumerable t :configurable t :get (lambda ()
        (js-call trace :push "offset") (let ((old markRead)) (setq markRead (1+ markRead)) (if (= old 0) 0 "1")))))
      (Object/defineProperty mark "span" (js-object :enumerable t :configurable t :get (lambda ()
        (js-call trace :push "span") (put parts 2 "changed") (js-object :start 1))))
      (let ((fragment (js-object)))
        (Object/defineProperty fragment "marks" (js-object :enumerable t :configurable t :get (lambda ()
          (js-call trace :push "marks")
          (new globalThis.Proxy (js-array mark) (js-object :get (lambda (target key receiver)
            (js-call trace :push (str "mark:" (funcall globalThis.String key))) (Reflect/get target key receiver)))))))
        (Object/defineProperty fragment "text" (js-object :enumerable t :configurable t :get (lambda ()
          (js-call trace :push "text")
          (js-object :toString (lambda () (js-call trace :push "string") (js-call parts :push "tail") "body")))))
        (put parts 1 fragment))
      (js-object :trace trace :parts (new globalThis.Proxy parts (js-object :get (lambda (target key receiver)
        (js-call trace :push (str "part:" (funcall globalThis.String key))) (Reflect/get target key receiver)))))))
  (defun check (m)
    (let* ((span (js-object)) (mark (js-object :offset 0 :span span))
           (fragment (js-object :text "x" :marks (js-array mark))) (out (js-call m :combine (js-array "before" fragment))))
      (js-call assert :equal (get (aref (get out :marks) 0) :span) span)
      (js-call assert :notEqual (get out :marks) (get fragment :marks))
      (js-call assert :notEqual (aref (get out :marks) 0) mark)
      (js-call assert :equal (get mark :offset) 0))
    (js-call (js-array (js-array) (js-array "") (js-array "a" "😀" "\ud800")
      (js-array (js-object :text "a" :marks (js-array (js-object :offset 0 :span (js-object :start 3))))
        "|" (js-object :text "😀\nb" :marks (js-array (js-object :offset 0 :span false) (js-object :offset 2 :span nil))))
      (js-array "" (js-object :text "" :marks (js-array (js-object :offset "0" :span undefined)))))
      :forEach (lambda (parts) (js-call assert :deepEqual (js-call m :combine parts) (oracle parts))))
    (let ((left (effectful-parts)) (right (effectful-parts)))
      (js-call assert :deepEqual (js-call m :combine (get left :parts)) (oracle (get right :parts)))
      (js-call assert :deepEqual (get left :trace) (get right :trace)))
    (js-call (js-array (js-array nil) (js-array undefined) (js-array 4) (js-array (js-object))
      (js-array (js-object :text "bad" :marks (js-array nil)))) :forEach (lambda (parts)
        (js-call assert :throws (lambda () (oracle parts)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call m :combine parts)) globalThis.TypeError)))
    (let ((marker (js-object)) (bad (js-object)))
      (Object/defineProperty bad "marks" (js-object :enumerable t :configurable t :get (lambda () (throw marker))))
      (js-call assert :throws (lambda () (js-call m :combine (js-array "ok" bad))) (lambda (error) (= error marker))))
    (js-call assert :deepEqual (js-call m :combine (js-array "recovered")) (js-object :text "recovered" :marks (js-array)))
    (let ((state 1992890915) (n 0))
      (letfn ((random () (setq state (funcall unsigned32 (+ (Math/imul state 1664525) 1013904223))) state))
        (while (< n 256)
          (let ((parts (Array/from (js-object :length (% (random) 12)) (lambda ()
            (let ((text (str (String/fromCharCode (% (random) 65536)) (if (= (% (random) 2) 0) "" "😀"))))
              (if (not (= (% (random) 2) 0)) text
                (js-object :text text :marks (Array/from (js-object :length (% (random) 4))
                  (lambda () (js-object :offset (% (random) 7) :span (js-object :start (% (random) 17))))))))))))
            (js-call assert :deepEqual (js-call m :combine parts) (oracle parts)))
          (setq n (1+ n))))))
  (export oracle check)
)
