(module tests.helpers.wasm-managed-objects-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:process" :default process)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defasync run-main ()
    (let* ((rt-mod (await (funcall dynamic-import (aref (get process :argv) 2))))
           (instantiate (get rt-mod :instantiateManagedRuntime))
           (a (funcall instantiate (readFileSync (aref (get process :argv) 3)))))
      (js-call a :auto 1)
      (let* ((x (js-call a :number -0.0))
             (o (js-call a :invoke "make" (js-array x t)))
             (child (js-call a :invoke "inherit" (js-array o false)))
             (key (js-call a :string "x"))
             (read-h (js-call a :invoke "read-value" (js-array child key))))
        (funcall assert (Object/is (js-call a :readNumber read-h) -0.0))
        (js-call a :release read-h)
        (let ((has-v (js-call a :invoke "has" (js-array child key))))
          (js-call assert :equal has-v false))
        (let* ((n (js-call a :number 128))
               (grown (js-call a :invoke "grow-loop" (js-array n)))
               (keys (js-call a :invoke "keys" (js-array grown))))
          (js-call assert :equal (js-call a :length keys) 128)
          (let ((first (js-call a :get keys 0))
                (last (js-call a :get keys 127)))
            (js-call assert :equal (js-call a :readString first) "0")
            (js-call assert :equal (js-call a :readString last) "127")
            (js-call (js-array first last keys grown n key child o x) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))

  (run-main))
