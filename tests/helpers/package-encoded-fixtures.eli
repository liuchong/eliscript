                            (await (rm lock-dir (js-object :recursive t :force t)))))
                        (catch _ nil))
                      (unless (existsSync ready-file)
                        (when (>= (Date/now) deadline)
                          (throw error))
                        (await (new globalThis.Promise (lambda (done) (globalThis.setTimeout done 100))))))
                    (throw error)))))
            acquired))))
      (encodedCompiler (lambda (host)
        (unless (js-call encodedCompilers :has host)
          (js-call encodedCompilers :set host (funcall (async ()
            (let* ((sources (await (loadCompilerSources)))
              (cache-key undefined) (cache-dir undefined) (cached undefined)
              (lock-held false)
              (producer undefined)
              (emitted undefined))
              (try
              (put (get sources :runtime) :source (str "; runtime code units \ufeff\ud800😀\r\n" (get (get sources :runtime) :source)))
              (assert (> (js-length (get sources :literalSources)) 0))
              (put (aref (get sources :literalSources) 0) :source (str "; library code units \ufeff\udc00中\r\n" (get (aref (get sources :literalSources) 0) :source)))
              (when (= host "javascript")
                (setq cache-key (await (encodedCompilerCacheKey sources manifest artifact)))
                (when cache-key
                  (setq cache-dir (resolve encodedRepoRoot ".eliscript-cache/encoded-compiler" cache-key))
                  (when (not (existsSync (resolve cache-dir "READY")))
                    (setq lock-held (await (funcall acquireEncodedCacheLock cache-dir))))
                  (when (existsSync (resolve cache-dir "READY"))
                    (try
                      (let* ((emittedDir (resolve directory "encoded-javascript"))
                             (relocated (resolve directory "relocated/javascript"))
                             (expected (resolve directory "encoded-javascript-sources.json")))
                        (await (cp (resolve cache-dir "emitted") emittedDir (js-object :recursive t :dereference false)))
                        (await (mkdir (dirname relocated) (js-object :recursive t)))
                        (await (cp (resolve cache-dir "relocated") relocated (js-object :recursive t :dereference false)))
                        (await (writeFile expected (await (readFile (resolve cache-dir "expected.json")))))
                        (let* ((emittedRestored (await (restoreJavascriptEmitted emittedDir)))
