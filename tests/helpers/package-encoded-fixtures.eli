                               (movedArtifact (await (readCompilerMetadata (resolve relocated (get movedManifest :artifact))))))
                          (setq cached (js-object :emitted emittedRestored :relocated relocated :movedManifest movedManifest :movedArtifact movedArtifact :expected expected))))
                      (catch _ (setq cached undefined))))))
              (if cached
