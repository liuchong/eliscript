(module tests.helpers.package-encoded-fixtures
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" cp mkdir readFile rm writeFile)
  (import "node:path" dirname resolve)
  (import "../../tools/backends/compiler-build.mjs" buildIndependentCompiler loadCompilerSources)
