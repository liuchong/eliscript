      (setq __eli_iteration_1_step (Reflect/apply __eli_iteration_1_next __eli_iteration_1_iterator (js-array)))
      (unless (and (not (nullish? __eli_iteration_1_step)) (= (funcall globalThis.Object __eli_iteration_1_step) __eli_iteration_1_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_1_step :done))
        (setq __eli_iteration_1_done t)
        (let ((key (get __eli_iteration_1_step :value)))
          (setq __eli_iteration_1_active t)
          (js-call assert :deepEqual (get movedArtifact key) (get emitted key) key))))
    nil
    (catch __eli_iteration_1_error (setq __eli_iteration_1_failed t) (throw __eli_iteration_1_error))
    (finally
      (when (and __eli_iteration_1_active (not __eli_iteration_1_done))
        (try
          (let ((__eli_iteration_1_return (get __eli_iteration_1_iterator :return)))
            (unless (nullish? __eli_iteration_1_return) (Reflect/apply __eli_iteration_1_return __eli_iteration_1_iterator (js-array))))
          (catch __eli_iteration_1_close_error (unless __eli_iteration_1_failed (throw __eli_iteration_1_close_error))))))))
                  (await (writeFile expected (JSON/stringify (js-object :runtime (get sources :runtime) :literal (aref (get sources :literalSources) 0)))))
                  (js-object :emitted emitted :relocated relocated :movedManifest movedManifest :movedArtifact movedArtifact :expected expected))))))))
        (js-call encodedCompilers :get host)))
      (requestIRInput (lambda (host)
        (unless (js-call requestIRInputs :has host)
          (js-call requestIRInputs :set host (funcall (async ()
            (let* ((prepared (await (funcall encodedCompiler host))) (session (await (openCompilerArtifact (get prepared :emitted)))))
              (try
                (let* ((source "; request code units \ufeff\ud800中😀\r\n(defun run () -0) (export run)") (filename "request-single.eli")
                  (ir (get (await (js-call session :request (js-object :operation "compile-ir" :source source :filename filename))) :ir))
                  (modules (js-array (js-object :id "library.mjs" :filename "library.eli" :source "(defun value () -0) (export value)")
                    (js-object :id "entry.mjs" :filename "entry.eli" :source "(import \"./library.eli\" value) (defun run () (value)) (export run)")))
                  (rawSource (str "(import \"eliscript:memory32\" load-u32 store-u32 memory-size memory-grow f64-literal store-f64) "
                    "(defun read32 (p) (load-u32 p)) (defun set32 (p v) (store-u32 p v) (load-u32 p)) "
                    "(defun grow (n) (memory-grow n)) (defun size () (memory-size)) "
                    "(defun zero64 (p) (store-f64 p (f64-literal -0.0))) (export read32 set32 grow size zero64)")))
                  (let* ((__eli_iteration_2_sequence modules)
       (__eli_iteration_2_iterator (let ((result (Reflect/apply (get __eli_iteration_2_sequence Symbol.iterator) __eli_iteration_2_sequence (js-array)))) (unless (and (not (nullish? result)) (= (funcall globalThis.Object result) result)) (throw (new globalThis.TypeError "iterator must return an object"))) result))
       (__eli_iteration_2_next (get __eli_iteration_2_iterator :next)) (__eli_iteration_2_step undefined)
       (__eli_iteration_2_active false) (__eli_iteration_2_done false) (__eli_iteration_2_failed false))
  (try
    (while (not __eli_iteration_2_done)
      (setq __eli_iteration_2_active false)
      (setq __eli_iteration_2_step (Reflect/apply __eli_iteration_2_next __eli_iteration_2_iterator (js-array)))
      (unless (and (not (nullish? __eli_iteration_2_step)) (= (funcall globalThis.Object __eli_iteration_2_step) __eli_iteration_2_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_2_step :done))
        (setq __eli_iteration_2_done t)
        (let ((module (get __eli_iteration_2_step :value)))
          (setq __eli_iteration_2_active t)
          (put module :ir (get (await (js-call session :request (js-object :operation "compile-ir" :source (get module :source) :filename (get module :filename)))) :ir)))))
    nil
    (catch __eli_iteration_2_error (setq __eli_iteration_2_failed t) (throw __eli_iteration_2_error))
    (finally
      (when (and __eli_iteration_2_active (not __eli_iteration_2_done))
        (try
          (let ((__eli_iteration_2_return (get __eli_iteration_2_iterator :return)))
            (unless (nullish? __eli_iteration_2_return) (Reflect/apply __eli_iteration_2_return __eli_iteration_2_iterator (js-array))))
          (catch __eli_iteration_2_close_error (unless __eli_iteration_2_failed (throw __eli_iteration_2_close_error))))))))
                  (let* ((rawIR (get (await (js-call session :request (js-object :operation "compile-ir" :source rawSource :filename "request-memory.eli"))) :ir))
                    (raw (await (js-call session :request (js-object :operation "emit-memory-ir" :ir rawIR :target "wasm" :memory (js-object :initialPages 1 :maximumPages 2) :debug t))))
                    (typedIR (encodeCompilerIR (get raw :typed))) (capabilities (await (js-call session :request (js-object :operation "capabilities")))))
                    (js-call assert :notEqual typedIR (JSON/stringify (get raw :typed)) "the actual typed request must carry an IEEE negative zero that JSON.stringify would lose")
                    (js-call assert :equal (get raw :abi) "memory-u32") (js-call assert :equal (get raw :descriptor) undefined)
                    (js-call assert :deepEqual (get capabilities :memoryIRTargets) (js-array "wasm" "native"))
                    (js-object :prepared prepared :source source :filename filename :ir ir :modules modules :rawIR rawIR :typedIR typedIR)))
                (finally (await (js-call session :close)))))))))
        (js-call requestIRInputs :get host))))
      (js-object :encodedCompiler encodedCompiler :requestIRInput requestIRInput)))
  (export createEncodedCompilerFixtures))
