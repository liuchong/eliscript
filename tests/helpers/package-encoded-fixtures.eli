  (defun createEncodedCompilerFixtures (context)
    (let* ((directory (get context :directory)) (installed (get context :installed)) (manifest (get context :manifest)) (artifact (get context :artifact))
      (encodedCompilers (new globalThis.Map)) (requestIRInputs (new globalThis.Map))
      (encodedCompiler (lambda (host)
