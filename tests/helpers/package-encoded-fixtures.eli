  (defconst encodedRepoRoot
    (let ((envRoot (get (get globalThis.process :env) :ELISCRIPT_TEST_FIXTURE_ROOT nil)))
      (if (and (not (nullish? envRoot)) (not (= envRoot "")))
        (resolve envRoot)
        (resolve (dirname (fileURLToPath (js* "import.meta.url"))) "../.."))))
  (defconst encodedRequire (createRequire (resolve encodedRepoRoot "tools/backends/compiler-build.mjs")))
  (defun encodedCacheEligible ()
    (let ((env (get globalThis.process :env)))
      (and (not (= (get env :ELISCRIPT_DISABLE_BACKEND_CACHE nil) "1"))
           (or (nullish? (get env :EMACS nil)) (= (get env :EMACS nil) "") (= (get env :EMACS nil) "emacs"))
           (existsSync (resolve encodedRepoRoot "dist/stage3-release.json")))))
  (defasync encodedCompilerCacheKey (sources manifest artifact)
    (when (encodedCacheEligible)
      (let* ((hash (createHash "sha256"))
             (backendsDir (resolve encodedRepoRoot "tools/backends"))
             (entries (js-call (await (readdir backendsDir)) :filter (lambda (name) (or (js-call name :endsWith ".eli") (js-call name :endsWith ".mjs")))))
             (index 0))
        (js-call entries :sort)
        (js-call hash :update "encoded-compiler-v1\n")
        (js-call hash :update (await (readFile (resolve encodedRepoRoot "dist/stage3-release.json"))))
        (js-call hash :update (await (readFile (resolve encodedRepoRoot "tests/helpers/package-encoded-fixtures.eli"))))
        (while (< index (js-length entries))
          (let ((name (aref entries index)))
            (js-call hash :update (str name "\0"))
            (js-call hash :update (await (readFile (resolve backendsDir name))))
            (js-call hash :update "\0"))
          (setq index (1+ index)))
        (js-call hash :update (JSON/stringify (js-object :manifest manifest
          :productIdentity (get artifact :productIdentity)
          :sourceIdentity (get artifact :sourceIdentity))))
        (js-call hash :update "\0")
        (js-call hash :update (JSON/stringify sources))
        (js-call hash :digest "hex"))))
  (defasync restoreJavascriptEmitted (emittedDir)
    (let* ((metadataPath (resolve emittedDir "compiler-artifact.json"))
           (metadata (await (readCompilerMetadata metadataPath)))
           (entryPath (resolve emittedDir (get metadata :path)))
           (emitted (Object/assign (js-object) metadata
             (js-object :directory emittedDir :metadataPath metadataPath :path entryPath
                        :url (get (pathToFileURL entryPath) :href)
                        :runtimePath (resolve emittedDir (get metadata :runtimePath))))))
      (when (get metadata :debugPath)
        (put emitted :debugPath (resolve emittedDir (get metadata :debugPath))))
      (when (Array/isArray (get metadata :modules))
        (put emitted :modules (js-call (get metadata :modules) :map (lambda (record)
          (let ((out (js-object :id (get record :id) :path (resolve emittedDir (get record :path)))))
            (when (get record :sourceMapPath) (put out :sourceMapPath (resolve emittedDir (get record :sourceMapPath))))
            (when (get record :macroOriginsPath) (put out :macroOriginsPath (resolve emittedDir (get record :macroOriginsPath))))
            out)))))
      (when (Array/isArray (get metadata :hostSources))
        (put emitted :hostSources (js-call (get metadata :hostSources) :map (lambda (record)
          (js-object :id (get record :id) :path (resolve emittedDir (get record :path)))))))
      (when (Array/isArray (get metadata :literalSources))
        (put emitted :literalSources (js-call (get metadata :literalSources) :map (lambda (record)
          (Object/assign (js-object) record (js-object :path (resolve emittedDir (get record :path))))))))
      (put emitted :load (async () (funcall encodedRequire entryPath)))
      emitted))
  (defun createEncodedCompilerFixtures (context)
