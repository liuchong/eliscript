          (js-call encodedCompilers :set host (funcall (async ()
            (let* ((sources (await (loadCompilerSources)))
              (producer undefined)
              (emitted undefined))
              (put (get sources :runtime) :source (str "; runtime code units \ufeff\ud800😀\r\n" (get (get sources :runtime) :source)))
              (assert (> (js-length (get sources :literalSources)) 0))
              (put (aref (get sources :literalSources) 0) :source (str "; library code units \ufeff\udc00中\r\n" (get (aref (get sources :literalSources) 0) :source)))
              (setq producer (await (openCompilerArtifact (Object/assign (js-object) artifact (js-object :directory (resolve installed (dirname (get manifest :artifact))))))))
              (try (setq emitted (await (buildIndependentCompiler (js-object :host host :session producer :sources sources :outputRoot (resolve directory (str "encoded-" host))
                :profile "full-runtime" :retainIR false :debug t)))) (finally (await (js-call producer :close))))
              (js-call assert :equal (get (get emitted :provenance) :mode) "session") (js-call assert :equal (get (get emitted :provenance) :producerHost) "javascript")
              (js-call assert :equal (get emitted :runtimeEncoding) "json-utf16") (js-call assert :equal (get (aref (get emitted :literalSources) 0) :encoding) "json-utf16")
              (js-call assert :deepEqual (js-call (js-call (get (get emitted :provenance) :compiledModuleIds) :slice) :sort) (js-call (js-call (get sources :modules) :map (lambda (item) (get item :id))) :sort))
              (js-call assert :equal (get (get emitted :provenance) :runtimeCompiled) t)
              (let* ((packaged (await (packageIndependentCompiler (js-object :artifact emitted :outputRoot (resolve directory (str "encoded-package-" host))))))
                (relocated (resolve directory "relocated" host)))
                (await (mkdir (dirname relocated) (js-object :recursive t))) (await (cp (get packaged :directory) relocated (js-object :recursive t :dereference false)))
                (await (rm (get packaged :directory) (js-object :recursive t :force t)))
                (let* ((movedManifest (JSON/parse (await (readFile (resolve relocated "compiler-package.json") "utf8"))))
                  (movedArtifact (await (readCompilerMetadata (resolve relocated (get movedManifest :artifact)))))
                  (expected (resolve directory (str "encoded-" host "-sources.json"))))
                  (let* ((__eli_iteration_1_sequence (js-array "sourceIdentity" "artifactIdentity" "productIdentity" "provenance"))
       (__eli_iteration_1_iterator (let ((result (Reflect/apply (get __eli_iteration_1_sequence Symbol.iterator) __eli_iteration_1_sequence (js-array)))) (unless (and (not (nullish? result)) (= (funcall globalThis.Object result) result)) (throw (new globalThis.TypeError "iterator must return an object"))) result))
       (__eli_iteration_1_next (get __eli_iteration_1_iterator :next)) (__eli_iteration_1_step undefined)
       (__eli_iteration_1_active false) (__eli_iteration_1_done false) (__eli_iteration_1_failed false))
  (try
