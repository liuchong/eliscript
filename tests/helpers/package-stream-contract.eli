(module tests.helpers.package-stream-contract
  (import "node:assert/strict" :default assert)
  (defun deferredResource ()
    (let* ((resolveReady undefined) (release undefined)
      (ready (new globalThis.Promise (lambda (resolve) (setq resolveReady resolve))))
      (waiting (new globalThis.Promise (lambda (resolve) (setq release resolve)))))
      (js-object :ready ready :release release :wait (async () (funcall resolveReady) (await waiting)))))
  (defun metadataBodyResponse (bytes trace &rest __host_forwarded_arguments_1)
    (let* ((configuration (aref __host_forwarded_arguments_1 0)))
    (when (nullish? configuration) (setq configuration (js-object)))
    (let* ((position 0)
      (stream (new globalThis.ReadableStream (js-object :pull (lambda (controller)
        (if (= position (js-length bytes)) (js-call controller :close)
          (let ((end (Math/min (+ position (if (= position 0) 1 4093)) (js-length bytes))))
            (js-call controller :enqueue (js-call bytes :subarray position end)) (setq position end))))))))
      (js-object :ok t :status 200
        :arrayBuffer (lambda () (put trace :arrayBuffers (+ (get trace :arrayBuffers) 1)) (throw (new globalThis.Error "metadata must use its actual streaming body")))
        :body (js-object :getReader (lambda ()
          (put trace :readers (+ (get trace :readers) 1))
          (let ((reader (js-call stream :getReader)))
            (js-object
              :read (lambda () (put trace :reads (+ (get trace :reads) 1))
                (if (and (get configuration :failRead) (= (get trace :reads) 2)) (Promise/reject (get configuration :reason)) (js-call reader :read)))
              :cancel (async (error) (put trace :cancelled (+ (get trace :cancelled) 1)) (put trace :reason error)
                (await (js-call reader :cancel error)) (when (get configuration :failCancel) (throw (get configuration :cleanup))))
              :releaseLock (lambda () (put trace :released (+ (get trace :released) 1)) (js-call reader :releaseLock)
                (when (get configuration :failRelease) (throw (get configuration :cleanup))))))))))))
  (defun sourceResponse (bytes trace &rest __host_forwarded_arguments_2)
    (let* ((configuration (aref __host_forwarded_arguments_2 0))) (metadataBodyResponse bytes trace configuration)))
  (defun exactSourceRecords (actual expected)
    (js-call assert :equal (js-length actual) (js-length expected))
    (let ((__eli_iteration_1_index 0) (__eli_iteration_1_limit (js-length expected)))
  (while (< __eli_iteration_1_index __eli_iteration_1_limit)
    (let ((index __eli_iteration_1_index))
      (let* ((source (get (aref actual index) :source)) (wanted (get (aref expected index) :source))
        (record (Object/assign (js-object) (aref actual index))) (declaration (Object/assign (js-object) (aref expected index))))
        (Reflect/deleteProperty record "source") (Reflect/deleteProperty declaration "source")
        (js-call assert :deepEqual record declaration) (js-call assert :equal (funcall (js* "(value) => typeof value") source) "string")
        (unless (= source wanted)
          (let ((at 0))
            (while (and (< at (js-length source)) (< at (js-length wanted)) (= (js-call source :charCodeAt at) (js-call wanted :charCodeAt at))) (setq at (+ at 1)))
            (js-call assert :fail (str "source " index ": firstMismatch UTF16=" at "; lengths=" (js-length source) "/" (js-length wanted)
              "; actual=" (JSON/stringify (js-call source :slice (Math/max 0 (- at 20)) (+ at 40))) "; expected=" (JSON/stringify (js-call wanted :slice (Math/max 0 (- at 20)) (+ at 40))))))))
      (setq __eli_iteration_1_index (+ index 1))))))
  (export deferredResource metadataBodyResponse sourceResponse exactSourceRecords))
