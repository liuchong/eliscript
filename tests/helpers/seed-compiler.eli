(module tests.helpers.seed-compiler
  (import "node:fs/promises" mkdir readdir)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath)
  (import "../../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst root (resolve (dirname (fileURLToPath (js* "import.meta.url"))) "../.."))
  (defconst host-truth (js* "(value) => !!value"))
  ;; Every fixture receives a fresh Emacs seed and every compiler module.
  ;; This helper deliberately does not retain a compiler-product cache.
  (defasync seedCompilerFixture (directory options)
    (setq options (if (= options undefined) (js-object) options))
    (let* ((emacs (get options :emacs))
           (modules (js-call (js-call (js-call (await (readdir (resolve root "bootstrap/compiler"))) :filter
                       (lambda (name) (js-call (new globalThis.RegExp "^[a-z][a-z-]*[.]eli$") :test name))) :sort)
                       :map (lambda (name) (js-call name :slice 0 -4))))
           (output (resolve directory)))
      (when (= emacs undefined)
        (setq emacs (get (get globalThis.process :env) :EMACS))
        (when (nullish? emacs) (setq emacs "emacs")))
      (unless (js-call modules :includes "compiler") (throw (new globalThis.Error "bootstrap compiler module is missing")))
      (await (mkdir output (js-object :recursive t)))
      (let* ((command (js-call (js-array emacs "--batch" "-Q" "--script" (resolve root "tools/bootstrap-seed.el") "--" root output) :concat modules))
             (child (Bun/spawn command (js-object :cwd root :env (copyHostRecord (get globalThis.process :env)) :stdout "pipe" :stderr "pipe")))
             (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text)
                                                   (js-call (new globalThis.Response (get child :stderr)) :text)))))
             (status (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
        (unless (= status 0)
          (let* ((err (js-call stderr :trim)) (out (js-call stdout :trim))
                 (error (new globalThis.Error (if (funcall host-truth err) err (if (funcall host-truth out) out (str "Emacs seed exited with " status))))))
            (put error :exitCode status) (throw error)))) output))
  (export seedCompilerFixture))
