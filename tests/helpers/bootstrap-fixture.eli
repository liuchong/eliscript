(module tests.helpers.bootstrap-fixture
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst projectDirectory (fileURLToPath (new globalThis.URL "../.." (js* "import.meta.url"))))
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-truth (js* "(value) => !!value"))
  (defasync run (command options)
    (let* ((child (Bun/spawn command (copyHostRecord (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe") (if (= options undefined) (js-object) options))))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (unless (= exitCode 0)
        (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
          (throw (new globalThis.Error (if (funcall host-truth err) err (if (funcall host-truth out) out (str (aref command 0) " exited with " exitCode))))))) stdout))
  (defasync caseSource (testCase)
    (if (Object/hasOwn testCase "source") (get testCase :source) (await (readFile (resolve projectDirectory (get testCase :file)) "utf8"))))
  (defasync buildBootstrap (directory)
    (await (run (js-array (resolve projectDirectory "bin/eliscript-bootstrap"))
      (js-object :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory))))))
  (defasync seedResults (phase fixturePath)
    (let ((environment (copyHostRecord (get globalThis.process :env))))
      (put environment (str "ELISCRIPT_" (js-call phase :toUpperCase) "_FIXTURE") fixturePath)
      (JSON/parse (await (run (js-array (get (get globalThis.process :env) :EMACS "emacs") "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script" (resolve projectDirectory (str "tests/bootstrap-" phase "-oracle.el"))) (js-object :env environment))))))
  (defasync loadModule (directory name tag)
    (await (funcall load-module (str (get (pathToFileURL (resolve directory (str name ".mjs"))) :href) "?" tag))))
  (export projectDirectory run caseSource buildBootstrap seedResults loadModule))
