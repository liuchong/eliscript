(module tests.helpers.portable-structure
  (defun nextRandom (state)
    (let ((value (get state :value)))
      (setq value (bit-xor value (bit-shift-left value 13)) value (bit-xor value (unsigned-bit-shift-right value 17)) value (bit-xor value (bit-shift-left value 5)))
      (put state :value (uint32 value)) (get state :value)))
  (defun nodeCount (node level)
    (if (nullish? node) 0
      (let ((count 1) (index 0))
        (when (> level 0)
          (while (< index (js-length (get node :slots)))
            (setq count (+ count (nodeCount (aref (get node :slots) index) (- level 5))) index (1+ index)))) count)))
  (defun sharedNodeCount (left right level)
    (cond ((or (nullish? left) (nullish? right)) 0) ((= left right) (nodeCount left level)) ((= level 0) 0)
      (t (let ((count 0) (index 0) (width (Math/max (js-length (get left :slots)) (js-length (get right :slots)))))
        (while (< index width)
          (setq count (+ count (sharedNodeCount (aref (get left :slots) index) (aref (get right :slots) index) (- level 5))) index (1+ index))) count))))
  (defun integerHash (value)
    (let ((word (uint32 value)))
      (setq word (imul32 (bit-xor word (unsigned-bit-shift-right word 16)) 73244475)
            word (imul32 (bit-xor word (unsigned-bit-shift-right word 16)) 73244475))
      (uint32 (bit-xor word (unsigned-bit-shift-right word 16)))))
  (defun children (item) (cond ((= (get item :kind) "bitmap") (get item :items)) ((= (get item :kind) "array") (get item :children)) (t (get item :entries))))
  (defun countItems (item)
    (cond ((nullish? item) 0) ((= (get item :kind) "entry") 1)
      (t (let ((items (children item)) (count 1) (index 0))
        (while (< index (js-length items)) (setq count (+ count (countItems (aref items index))) index (1+ index))) count))))
  (defun sharedItems (left right)
    (cond ((or (nullish? left) (nullish? right)) 0) ((= left right) (countItems left))
          ((or (not (= (get left :kind) (get right :kind))) (= (get left :kind) "entry")) 0)
          (t (let* ((leftChildren (children left)) (rightChildren (children right)) (count 0) (index 0)
                    (width (Math/max (js-length leftChildren) (js-length rightChildren))))
               (while (< index width) (setq count (+ count (sharedItems (aref leftChildren index) (aref rightChildren index))) index (1+ index))) count))))
  (defun lookupPathLength (item hash shift)
    (setq shift (if (= shift undefined) 0 shift))
    (let ((current item) (currentShift shift) (length 0) (done false))
      (while (and (not done) (not (nullish? current)))
        (setq length (1+ length))
        (if (or (= (get current :kind) "entry") (= (get current :kind) "collision")) (setq done t)
          (let ((index (bit-and (unsigned-bit-shift-right hash currentShift) 31)))
            (if (= (get current :kind) "array") (setq current (aref (get current :children) index))
              (let ((bit (uint32 (bit-shift-left 1 index))) (packed 0) (branch 0))
                (while (< branch index)
                  (when (not (= (bit-and (get current :bitmap) (uint32 (bit-shift-left 1 branch))) 0)) (setq packed (1+ packed)))
                  (setq branch (1+ branch)))
                (setq current (if (= (bit-and (get current :bitmap) bit) 0) nil (aref (get current :items) packed)))))
            (setq currentShift (+ currentShift 5))))) length))
  (export nextRandom nodeCount sharedNodeCount integerHash countItems sharedItems lookupPathLength))
