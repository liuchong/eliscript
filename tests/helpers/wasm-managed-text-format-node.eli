(module tests.helpers.wasm-managed-text-format-node
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs" readFileSync)
  (import "node:process" :default process)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../../tools/runtime/unicode-case-profiles.mjs" hostUnicodeCaseVersion)

  (defconst js-typeof (js* "(v) => typeof v"))

  (let ((mode (aref (get process :argv) 2)))
    (cond
      ((= mode "scalars")
       (let* ((wasm-path (aref (get process :argv) 3))
              (expected-sha (aref (get process :argv) 4))
              (bytes (readFileSync wasm-path)))
         (js-call assert :equal (js-call (js-call (createHash "sha256") :update bytes) :digest "hex") expected-sha)
         (let ((a (instantiateManagedRuntime bytes))
               (checked 0)
               (start 0))
           (js-call a :auto 1)
           (while (< start 1114112)
             (let ((points (js-array))
                   (p start)
                   (lim (Math/min (+ start 512) 1114112)))
               (while (< p lim)
                 (when (or (< p 55296) (> p 57343))
                   (js-call points :push p))
                 (setq p (+ p 1)))
               (setq checked (+ checked (get points :length)))
               (let* ((text (apply String/fromCodePoint points))
                      (input (js-call a :string text)))
                 (js-call (js-array (js-array "upper" "toUpperCase")
                                    (js-array "lower" "toLowerCase")) :forEach
                   (lambda (pair)
                     (let* ((name (aref pair 0))
                            (method (aref pair 1))
                            (out (js-call a :invoke name (js-array input))))
                       (js-call assert :equal (js-call a :readString out) (js-call text method) (str name " block " start))
                       (js-call a :release out))))
                 (js-call a :release input)))
             (setq start (+ start 512)))
           (js-call assert :equal checked 1112064)
           (js-call a :closeModule)
           (js-call a :collect)
           (js-call assert :equal (js-call a :live) 0)
           (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
      ((= mode "ground-case")
       (let ((wasm-path (aref (get process :argv) 3)))
         (put (get globalThis.String :prototype) "toUpperCase"
              (lambda () (throw (globalThis.Error "injected unavailable case data"))))
         (js-call assert :throws
           (lambda () (hostUnicodeCaseVersion))
           (new globalThis.RegExp "injected unavailable case data"))
         (let* ((a (instantiateManagedRuntime (readFileSync wasm-path)))
                (out (js-call a :invoke "f")))
           (js-call assert :equal (get a :unicodeVersion) 17)
           (js-call assert :equal (js-call a :readNumber out) 7)
           (js-call a :release out)
           (js-call a :collect)
           (js-call assert :equal (js-call a :live) 0)
           (js-call assert :throws
             (lambda () (instantiateManagedRuntime (readFileSync wasm-path) (js-object :unicodeVersion 16)))
             (lambda (e)
               (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                             (get e :eliscriptDiagnostic)
                             nil)))
                 (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0003"))))))))
      (t
       (throw (globalThis.Error (str "unknown mode: " mode)))))))
