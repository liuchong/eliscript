(module tests.helpers.package-close-contract
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:child_process" spawnSync)
  ; Re-export the actual delegate's complete public binding inventory in Eli.
  ; Only the close operation is replaced; no compiler is simulated here.
  (defasync writeCloseFailureDriver (entry)
    (let* ((driver (await (funcall (js* "(specifier) => import(specifier)") (get (new globalThis.URL "./real-session-delegate.mjs" (pathToFileURL entry)) :href))))
      (template (await (readFile (new globalThis.URL "../fixtures/package-close-failure.eli" (js* "import.meta.url")) "utf8")))
      (at (js-call template :lastIndexOf "(export ")) (bindings (js-array)) (names (js-array)))
      (assert (> at 0))
      (let* ((__eli_iteration_1_sequence (Object/keys driver))
       (__eli_iteration_1_iterator (let ((result (Reflect/apply (get __eli_iteration_1_sequence Symbol.iterator) __eli_iteration_1_sequence (js-array)))) (unless (and (not (nullish? result)) (= (funcall globalThis.Object result) result)) (throw (new globalThis.TypeError "iterator must return an object"))) result))
       (__eli_iteration_1_next (get __eli_iteration_1_iterator :next)) (__eli_iteration_1_step undefined)
       (__eli_iteration_1_active false) (__eli_iteration_1_done false) (__eli_iteration_1_failed false))
  (try
    (while (not __eli_iteration_1_done)
      (setq __eli_iteration_1_active false)
      (setq __eli_iteration_1_step (Reflect/apply __eli_iteration_1_next __eli_iteration_1_iterator (js-array)))
      (unless (and (not (nullish? __eli_iteration_1_step)) (= (funcall globalThis.Object __eli_iteration_1_step) __eli_iteration_1_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_1_step :done))
        (setq __eli_iteration_1_done t)
        (let ((name (get __eli_iteration_1_step :value)))
          (setq __eli_iteration_1_active t)
          (assert (js-call (new globalThis.RegExp "^[A-Za-z_$][A-Za-z0-9_$]*$") :test name) "a public binding must remain an expressible ESM identifier")
(unless (= name "compiler_session_close")
          (js-call bindings :push (str "(defconst " name " (get driver " (JSON/stringify name) "))"))
          (js-call names :push name)))))
    nil
    (catch __eli_iteration_1_error (setq __eli_iteration_1_failed t) (throw __eli_iteration_1_error))
    (finally
      (when (and __eli_iteration_1_active (not __eli_iteration_1_done))
        (try
          (let ((__eli_iteration_1_return (get __eli_iteration_1_iterator :return)))
            (unless (nullish? __eli_iteration_1_return) (Reflect/apply __eli_iteration_1_return __eli_iteration_1_iterator (js-array))))
          (catch __eli_iteration_1_close_error (unless __eli_iteration_1_failed (throw __eli_iteration_1_close_error))))))))
      (assert (js-call (Object/keys driver) :includes "compiler_session_close"))
      (let* ((source (str (js-call template :slice 0 at) (js-call bindings :join "\n") "\n(export " (js-call names :join " ") " closeFailure closedCount compiler_session_close))"))
        (input (str entry ".eli")) (seed (fileURLToPath (new globalThis.URL "../../bin/eliscript-seed" (js* "import.meta.url")))))
        (await (writeFile input source))
        (let ((child (spawnSync seed (js-array "--output" entry input) (js-object :encoding "utf8" :timeout 30000 :maxBuffer 1048576))))
          (js-call assert :equal (get child :error) undefined) (js-call assert :equal (get child :signal) nil)
          (js-call assert :equal (get child :status) 0 (get child :stderr)))
        (await (readFile entry)))))
  (export writeCloseFailureDriver))
