(module tests.helpers.generator-step
  (defconst generator-brand (js* "(source) => (function* values() { yield* source; })()"))
  (defun generator (next &rest __host_default_arguments_1)
    (let* ((onClose (aref __host_default_arguments_1 0)))
    (let ((done false) (started false) (closed false) (source (js-object)))
      (letfn ((close ()
        (when (and started (not closed)) (setq closed t) (when (not (= onClose undefined)) (funcall onClose)))))
        (put source :next (lambda ()
          (if done (js-object :value undefined :done t)
            (progn (setq started t)
              (try
                (let ((step (funcall next))) (when (get step :done) (setq done t) (close)) step)
                (catch error (setq done t) (close) (throw error)))))))
        (put source :return (lambda (value) (setq done t) (close) (js-object :value value :done t)))
        (put source (get globalThis.Symbol :iterator) (lambda () source))
        (funcall generator-brand source)))))
  (defun fromValues (items onPull &rest __host_forwarded_arguments_1)
    (let* ((onClose (aref __host_forwarded_arguments_1 0)))
    (let ((index 0))
      (generator (lambda ()
        (if (>= index (get items :length)) (js-object :value undefined :done t)
          (let ((value (aref items index))) (setq index (1+ index)) (funcall onPull value) (js-object :value value :done false)))) onClose))))
  (export generator fromValues)
)
