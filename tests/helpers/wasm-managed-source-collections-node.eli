(module tests.helpers.wasm-managed-source-collections-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:process" :default process)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defasync run-main ()
    (let* ((rt-mod (await (funcall dynamic-import (aref (get process :argv) 2))))
           (instantiate (get rt-mod :instantiateManagedRuntime))
           (js (await (funcall dynamic-import (aref (get process :argv) 3))))
           (a (funcall instantiate (readFileSync (aref (get process :argv) 4)))))
      (js-call a :auto 1)
      (let* ((m (js-call a :invoke "empty-map"))
             (ref (js-call js :empty_map))
             (key (js-call a :number -0.0))
             (value (js-call a :string "中😀"))
             (assigned (js-call a :invoke "set-value" (js-array m key value))))
        (js-call a :release assigned)
        (js-call js :set_value ref -0.0 "中😀")
        (let ((found (js-call a :invoke "lookup" (js-array m key))))
          (js-call assert :equal (js-call a :readString found) (js-call js :lookup ref -0.0))
          (js-call a :release found))
        (let* ((it (js-call a :invoke "entries" (js-array m)))
               (reference (js-call js :entries ref))
               (vk (js-call a :string "value"))
               (dk (js-call a :string "done"))
               (step (js-call a :invoke "next" (js-array it)))
               (pair (js-call a :objectGet step vk))
               (first (js-call a :get pair 0))
               (second (js-call a :get pair 1))
               (expected (js-call js :next reference)))
          (funcall assert (Object/is (js-call a :readNumber first) (aref (get expected :value) 0)))
          (js-call assert :equal (js-call a :readString second) (aref (get expected :value) 1))
          (js-call (js-array first second pair step) :forEach (lambda (x) (js-call a :release x)))
          (js-call a :invoke "clear" (js-array m))
          (js-call ref :clear)
          (let* ((late (js-call a :string "late"))
                 (updated (js-call a :invoke "set-value" (js-array m late t))))
            (js-call a :release updated)
            (js-call ref :set "late" t)
            (setq step (js-call a :invoke "next" (js-array it)))
            (setq pair (js-call a :objectGet step vk))
            (setq first (js-call a :get pair 0))
            (setq second (js-call a :get pair 1))
            (setq expected (js-call reference :next))
            (js-call assert :equal (js-call a :readString first) (aref (get expected :value) 0))
            (js-call assert :equal second t)
            (js-call (js-array first pair step) :forEach (lambda (x) (js-call a :release x)))
            (setq step (js-call a :invoke "next" (js-array it)))
            (js-call assert :equal (js-call a :objectGet step dk) t)
            (js-call a :release step)
            (let* ((text (js-call a :string "a😀a\ud800"))
                   (set-v (js-call a :invoke "from-set" (js-array text)))
                   (size-v (js-call a :invoke "size" (js-array set-v))))
              (js-call assert :equal (js-call a :readNumber size-v) (js-call js :size (js-call js :from_set "a😀a\ud800")))
              (js-call a :release size-v)
              (js-call (js-array m key value it vk dk late text set-v) :forEach (lambda (x) (js-call a :release x)))
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))

  (run-main))
