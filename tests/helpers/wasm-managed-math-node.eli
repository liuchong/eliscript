                    (lambda (a) (check-sqrt-access a sqrt-reference 0))
                    (lambda (a) (check-sqrt-access a sqrt-reference 1))
                    (lambda (a) (check-sqrt-access a sqrt-reference 2))
                    (lambda (a) (check-sqrt-semantics a sqrt-reference))
                    check-sqrt-pressure)
           :forEach
           (lambda (check-fn)
             (let ((a (instantiateManagedRuntime bytes)))
               (try
                 (funcall check-fn a)
                 (finally (finish a))))))
         (js-call (get globalThis.process :stdout) :write
           (JSON/stringify (js-object :sqrt t)))))))

  (let* ((argv (get globalThis.process :argv))
         (mode (aref argv 2)))
    (when (js-call (js-array "--freeze-namespace" "--cold-number" "--math-composite" "--sqrt") :includes mode)
