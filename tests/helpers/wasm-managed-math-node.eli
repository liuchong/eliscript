                   (globalThis.Array.from (js-object :length 3)
                     (lambda (_ kind)
                       (globalThis.Array.from (js-object :length 3)
                         (lambda (_ wmode) (js-call m :cold_number_descriptor_cycle kind wmode))))))
                 (order (js-call (js-array false t) :map
                          (lambda (abrupt) (js-call m :cold_number_order ctor abrupt))))
                 (mutation-trace (js-array)))
             (let ((mutations (js-call m :cold_number_mutations ctor mutation-trace)))
               (js-call (get globalThis.process :stdout) :write
                 (JSON/stringify
                   (js-object :first first :snapshot snapshot :newTarget new-target
                              :descriptorCycles descriptor-cycles :order order
                              :mutations mutations :mutationTrace mutation-trace)
                   (lambda (_ v) (if (undefined? v) (js-object :undefined t) v)))))))))
      ((= mode "--math-composite")
       (let* ((reference (await (funcall dynamic-import arg1)))
              (bytes (readFileSync arg2))
              (frozen-reference (JSON/parse arg3)))
         (js-call assert :deepEqual
           (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
           (js-array))
         (let ((a (instantiateManagedRuntime bytes)))
           (js-call a :auto 1)
