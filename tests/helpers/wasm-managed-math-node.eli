  (defasync run-cli (mode arg1 arg2 arg3)
    (await (funcall dynamic-import
             (get (new globalThis.URL "./managed-reference-node.mjs" (get (js* "import.meta") :url)) :href)))
    (cond
      ((= mode "--freeze-namespace")
       (let ((reference (await (funcall dynamic-import arg1))))
