(module tests.helpers.wasm-managed-math-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:fs/promises" readFile)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst receiver-fn (js* "(impl) => function (...args) { return impl(this, args); }"))
  (defconst to-uint32 (js* "(x) => x >>> 0"))
  (defconst bit-and-u32 (js* "(a, b) => (a & b) >>> 0"))
  (defconst bit-or-u32 (js* "(a, b) => ((a | b) >>> 0)"))
  (defconst bit-shl-u32 (js* "(a, b) => ((a << b) >>> 0)"))
  (defconst js-to-number (js* "(x) => +x"))
  (defconst bi (js* "(x) => BigInt(x)"))
  (defconst bi-add (js* "(a, b) => a + b"))
  (defconst bi-sub (js* "(a, b) => a - b"))
  (defconst bi-neg (js* "(a) => -a"))
  (defconst bi-shl (js* "(a, b) => a << b"))
  (defconst bi-shr (js* "(a, b) => a >> b"))
  (defconst bi-and (js* "(a, b) => a & b"))
  (defconst bi-or (js* "(a, b) => a | b"))
  (defconst bi-eq (js* "(a, b) => a === b"))
  (defconst bi-lt (js* "(a, b) => a < b"))
  (defconst bi-gt (js* "(a, b) => a > b"))
  (defconst bi-ge (js* "(a, b) => a >= b"))

  (defconst unary-names (js-array "abs" "sign" "clz32" "fround"))
  (defconst constants (js-array "E" "LN10" "LN2" "LOG10E" "LOG2E" "PI" "SQRT1_2" "SQRT2"))
  (defconst method-lengths
    (js-object :abs 1 :sign 1 :clz32 1 :fround 1 :imul 2
               :round 1 :floor 1 :ceil 1 :trunc 1 :min 2 :max 2))
  (defconst primitives
    (js-array undefined nil false t "" " " "-0" "0x10" "0b11" "0o17"
              (str (String/fromCharCode 8232) "-1.5" (String/fromCharCode 65279))
              "not a number"
              (String/fromCharCode 55296)
              (get globalThis.Number :NaN)
              (get globalThis.Number :POSITIVE_INFINITY)
              (get globalThis.Number :NEGATIVE_INFINITY)
              0 -0.0
              (get globalThis.Number :MIN_VALUE)
              (- 0 (get globalThis.Number :MIN_VALUE))
              (get globalThis.Number :MAX_VALUE)
              (- 0 (get globalThis.Number :MAX_VALUE))
              0.49999999999999994 0.5 -0.5 1.5 -1.5
              (- (Math/pow 2 31) 1) (Math/pow 2 31)
              (- (Math/pow 2 32) 1) (Math/pow 2 32) (+ (Math/pow 2 32) 1)
              (- (- 0 (Math/pow 2 32)) 1)
              (- (Math/pow 2 53) 1) (+ (Math/pow 2 53) 2)))

  (defun read-val (a v)
    (if (and (not (nullish? v)) (= (value-type v) "object"))
      (let ((k (get v :kind)))
        (cond
          ((= k 4) (js-call a :readNumber v))
          ((= k 5) (js-call a :readString v))
          ((= k 14)
           (let ((output (js-array))
                 (len (js-call a :length v))
                 (index 0))
             (while (< index len)
               (let ((child (js-call a :get v index)))
                 (try
                   (js-call output :push (read-val a child))
                   (finally (js-call a :release child))))
               (setq index (1+ index)))
             output))
          (t v)))
      v))

  (defun value (a name &rest __host_default_arguments_1)
    (let* ((arguments-list (aref __host_default_arguments_1 0)))
    (let ((result (js-call a :invoke name (if (undefined? arguments-list) (js-array) arguments-list))))
      (try
        (read-val a result)
        (finally (js-call a :release result))))))

  (defun box (a input)
    (cond
      ((= (value-type input) "number") (js-call a :number input))
      ((= (value-type input) "string") (js-call a :string input))
      (t input)))

  (defun invoke-val (a name &rest __host_default_arguments_2)
    (let* ((inputs (aref __host_default_arguments_2 0)))
    (let ((roots (js-array))
          (list-in (if (undefined? inputs) (js-array) inputs)))
      (try
        (js-call list-in :forEach (lambda (input) (js-call roots :push (box a input))))
        (value a name roots)
        (finally
          (js-call roots :forEach (lambda (r) (js-call a :release r))))))))

  (defun exact (actual expected label)
    (funcall assert (Object/is actual expected)
      (str label ": got " (globalThis.String actual) ", expected " (globalThis.String expected))))

  (defun finish (a)
    (try
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (js-call assert :equal (js-call a :live) 0)
      (finally
        (let ((cl (get a :close)))
          (when (= (value-type cl) "function")
            (js-call a :close))))))

  (defun compare-fixture (a reference name &rest __host_default_arguments_3)
    (let* ((inputs (aref __host_default_arguments_3 0)))
    (let* ((args (if (undefined? inputs) (js-array) inputs))
           (js-name (js-call name :replaceAll "-" "_")))
      (js-call assert :deepEqual
        (invoke-val a name args)
        (Reflect/apply (get reference js-name) reference args)
        (str name "/" (js-call args :join ",")))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0
        (str name " must restore all frames")))))

  (defun check-namespace (a reference)
    (compare-fixture a reference "namespace-summary")
    (compare-fixture a reference "namespace-tag-description")
    (compare-fixture a reference "lexical-shadow")
    (js-call assert :deepEqual (js-call reference :lexical_shadow) (js-array 10 11 23))
    (let* ((ns (js-call a :invoke "namespace-value"))
           (glob (js-call a :invoke "namespace-via-global"))
           (raw (js-call a :invoke "namespace-via-raw"))
           (abs-key (js-call a :string "abs"))
           (abs-fn (js-call a :invoke "namespace-pass" (js-array ns abs-key)))
           (qualified (js-call a :invoke "qualified-abs-value")))
      (try
        (js-call assert :equal (get ns :kind) 13 "Math is an ordinary namespace object")
        (funcall assert (js-call a :keyEqual ns glob))
        (funcall assert (js-call a :keyEqual ns raw))
        (funcall assert (js-call a :keyEqual abs-fn qualified))
        (js-call (Object/keys method-lengths) :forEach
          (lambda (name) (compare-fixture a reference "method-description" (js-array name))))
        (js-call constants :forEach
          (lambda (name) (compare-fixture a reference "constant-description" (js-array name))))
        (compare-fixture a reference "method-description" (js-array "sqrt"))
        (js-call (js-array 1 -0.0 (get globalThis.Number :MIN_VALUE) (get globalThis.Number :MAX_VALUE) -1)
          :forEach
          (lambda (input)
            (exact (invoke-val a "math-invoke" (js-array "sqrt" input))
                   (Math/sqrt input) "namespace sqrt receiver")))
        (js-call (js-array "acos" "random") :forEach
          (lambda (name)
            (compare-fixture a reference "method-description" (js-array name))
            (let ((actual (invoke-val a "math-invoke" (js-array name 1))))
              (if (= name "acos")
                (exact actual (Math/acos 1) "the original acos input now executes exactly")
                (funcall assert (and (>= actual 0) (< actual 1))
                  "the original random input executes while its extra argument remains ignored")))))
        (let ((names (value a "namespace-names"))
              (expected-keys (js-call (js-call constants :concat (Object/keys method-lengths))
                               :concat (js-array "acos" "sqrt" "random"))))
          (js-call expected-keys :forEach
            (lambda (key) (funcall assert (js-call names :includes key))))
          (funcall assert
            (js-call names :every
              (lambda (key) (and (= (value-type key) "string") (not (js-call key :startsWith "__eliscript")))))
            "private holder and cache keys must not become visible own properties"))
        (js-call a :collect)
        (let ((again (js-call a :invoke "namespace-value"))
              (again-abs (js-call a :invoke "qualified-abs-value")))
          (try
            (funcall assert (js-call a :keyEqual ns again))
            (funcall assert (js-call a :keyEqual abs-fn again-abs))
            (finally
              (js-call a :release again)
              (js-call a :release again-abs))))
        (finally
          (js-call (js-array ns glob raw abs-key abs-fn qualified)
            :forEach (lambda (r) (js-call a :release r)))))))

  (defun check-mutations (a reference)
    (js-call (js-array "namespace-mutation" "namespace-extension" "namespace-constant-errors") :forEach
      (lambda (name) (compare-fixture a reference name)))
    (js-call assert :deepEqual (js-call reference :namespace_mutation)
      (js-array 17 t 7 false undefined undefined))
    (js-call (js-array false t) :forEach
      (lambda (dynamic)
        (js-call (js-array false t) :forEach
          (lambda (abrupt)
            (compare-fixture a reference "callee-order" (js-array dynamic abrupt))
            (js-call assert :deepEqual
              (js-call reference :callee_order dynamic abrupt)
              (if abrupt (js-array t (js-array "get")) (js-array 107 (js-array "get" "arg"))))))))
    (js-call (js-array false t) :forEach
      (lambda (abrupt)
        (compare-fixture a reference "key-order" (js-array abrupt))
        (js-call assert :deepEqual
          (js-call reference :key_order abrupt)
          (if abrupt (js-array t (js-array "string")) (js-array 3 (js-array "string" "arg"))))))
    ;; A source mutation must survive after every temporary namespace handle dies.
    ;; The default realm cache itself must not be mistaken for a permanent root.
    (let* ((negative-zero (js-call a :number -0.0))
           (ns (js-call a :invoke "namespace-value"))
           (fround-key (js-call a :string "fround"))
           (fround-fn (js-call a :invoke "namespace-pass" (js-array ns fround-key))))
      (try
        (exact (value a "set-namespace-state" (js-array negative-zero)) -0.0 "namespace mutation")
        (js-call a :collect)
        (exact (value a "read-namespace-state") -0.0 "namespace mutation after GC")
        (let ((captured (value a "invoke-held" (js-array fround-fn negative-zero))))
          (exact captured (Math/fround -0.0) "method held through namespace back-edge"))
        (finally
          (js-call a :release negative-zero)
          (js-call a :release ns)
          (js-call a :release fround-key)
          (js-call a :release fround-fn))))
    (js-call a :collect)
    (exact (value a "read-namespace-state") -0.0 "public mutation without caller roots")
    (js-call assert :equal (value a "delete-namespace-state") t))

  (defun check-unary (a)
    (js-call unary-names :forEach
      (lambda (name)
        (js-call primitives :forEach
          (lambda (input)
            (let ((expected (Reflect/apply (get globalThis.Math name) globalThis.Math (js-array input))))
              (exact (invoke-val a (str "direct-" name) (js-array input)) expected
                (str "direct " name "/" (globalThis.String input)))
              (exact (invoke-val a "math-invoke" (js-array name input)) expected
                (str "dynamic " name "/" (globalThis.String input))))))
        (js-call (js-array (js-array) (js-array undefined) (js-array nil) (js-array -0.0 99 "ignored"))
          :forEach
          (lambda (args)
            (exact (invoke-val a "math-invoke" (js-call (js-array name) :concat args))
                   (Reflect/apply (get globalThis.Math name) globalThis.Math args)
                   (str name " logical arity"))))))
    (let ((bit 0))
      (while (< bit 32)
        (let ((p (Math/pow 2 bit)))
          (js-call (js-array p (- p 1) (+ p 1) (- 0 p)) :forEach
            (lambda (input)
              (exact (invoke-val a "direct-clz32" (js-array input))
                     (Math/clz32 input) (str "clz32 bit " bit)))))
        (setq bit (1+ bit)))))

  (defun check-imul (a)
    (let* ((pairs (js-array
                    (js-array 0 -0.0)
                    (js-array (get globalThis.Number :NaN) 7)
                    (js-array (get globalThis.Number :POSITIVE_INFINITY) (get globalThis.Number :NEGATIVE_INFINITY))
                    (js-array -1 5)
                    (js-array 4294967295 5)
                    (js-array 2147483648 2)
                    (js-array 2147483647 2147483647)
                    (js-array 4294967295 4294967295)
                    (js-array (- (Math/pow 2 53) 1) (- (- 0 (Math/pow 2 32)) 1))
                    (js-array "0xffffffff" "-1")
                    (js-array undefined t)
                    (js-array nil "3")))
           (seed 477785657)
           (next-u32 (lambda ()
                       (setq seed (funcall to-uint32 (+ (Math/imul seed 1664525) 1013904223)))
                       seed))
           (index 0))
      (while (< index 64)
        (js-call pairs :push (js-array (funcall next-u32) (funcall next-u32)))
        (setq index (1+ index)))
      (js-call pairs :forEach
        (lambda (pair)
          (let ((left (aref pair 0))
                (right (aref pair 1)))
            (exact (invoke-val a "direct-imul" (js-array left right))
                   (Math/imul left right) "direct imul")
            (exact (invoke-val a "math-invoke" (js-array "imul" left right))
                   (Math/imul left right) "dynamic imul"))))
      (js-call (js-array (js-array) (js-array 7) (js-array undefined 7) (js-array 7 undefined) (js-array 3 5 99))
        :forEach
        (lambda (args)
          (exact (invoke-val a "math-invoke" (js-call (js-array "imul") :concat args))
                 (Reflect/apply (get globalThis.Math :imul) globalThis.Math args)
                 "imul logical arity")))))

  (defun check-conversions (a reference)
    (js-call (js-call unary-names :concat (js-array "imul")) :forEach
      (lambda (name)
        (compare-fixture a reference "conversion-order" (js-array name))
        (let ((expected-trace (js-array "arg-a" "arg-b" "arg-extra" "a.valueOf" "a.toString")))
          (when (= name "imul")
            (js-call expected-trace :push "b.valueOf"))
          (js-call assert :deepEqual (aref (js-call reference :conversion_order name) 1) expected-trace))
        (compare-fixture a reference "conversion-hint" (js-array name))
        (js-call assert :deepEqual (aref (js-call reference :conversion_hint name) 1) (js-array "number" t))
        (compare-fixture a reference "primitive-rejections" (js-array name))
        (js-call assert :deepEqual (js-call reference :primitive_rejections name)
          (js-array "TypeError" "TypeError" "TypeError"))
        (js-call (js-array 0 1 2) :forEach
          (lambda (mode) (compare-fixture a reference "conversion-abrupt" (js-array name mode))))
        (js-call assert :deepEqual (js-call reference :conversion_abrupt name 0)
          (js-array "marker" (js-array "arg-a" "arg-b" "a.valueOf") 9))
        (js-call assert :deepEqual (js-call reference :conversion_abrupt name 2)
          (js-array "TypeError" (js-array "arg-a" "arg-b" "a.valueOf" "a.toString") 9))
        (js-call assert :equal (aref (js-call reference :conversion_abrupt name 1) 0)
          (cond
            ((= name "imul") "marker")
            ((= name "clz32") 32)
            (t (get globalThis.Number :NaN))))))
    (js-call (js-array "min" "max") :forEach
      (lambda (name)
        (compare-fixture a reference "extreme-order" (js-array name))
        (js-call assert :deepEqual (js-call reference :extreme_order name)
          (js-array t (js-array "arg-a" "arg-b" "arg-c" "arg-d" "a" "b" "c")))
        (js-call (js-array (js-array) (js-array -0.0) (js-array 0 -0.0) (js-array -0.0 0)
                           (js-array (get globalThis.Number :NaN) 4)
                           (js-array 4 (get globalThis.Number :NaN))
                           (js-array undefined)
                           (js-array 1 9 -7 2))
          :forEach
          (lambda (args)
            (exact (invoke-val a "math-invoke" (js-call (js-array name) :concat args))
                   (Reflect/apply (get globalThis.Math name) globalThis.Math args)
                   (str name " extremes")))))))

  ;; Neighboring binary64 values make midpoint tests distinguish ties-to-even from
  ;; truncation, ties-away, and an inaccurate intermediate decimal conversion.
  (defun adjacent (val upward)
    (cond
      ((Number/isNaN val) val)
      ((= val 0) (if upward (get globalThis.Number :MIN_VALUE) (- 0 (get globalThis.Number :MIN_VALUE))))
      (t (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
               (same-dir (= (> val 0) (globalThis.Boolean upward))))
           (js-call bits :setFloat64 0 val t)
           (let* ((w (js-call bits :getBigUint64 0 t))
                  (delta (if same-dir (funcall bi 1) (funcall bi -1)))
                  (next-w (funcall bi-add w delta)))
             (js-call bits :setBigUint64 0 next-w t)
             (js-call bits :getFloat64 0 t))))))

  (defun fround-boundaries ()
    (let ((midpoints (js-array (+ 1 (Math/pow 2 -24))
                               (+ 1 (* 3 (Math/pow 2 -24)))
                               (Math/pow 2 -150)
                               (* 3 (Math/pow 2 -150))
                               (- (Math/pow 2 -126) (Math/pow 2 -150))
                               (+ (Math/pow 2 -126) (Math/pow 2 -150))
                               (- (Math/pow 2 128) (Math/pow 2 103))))
          (out (js-array 0 -0.0
                         (get globalThis.Number :NaN)
                         (get globalThis.Number :POSITIVE_INFINITY)
                         (get globalThis.Number :NEGATIVE_INFINITY)
                         (get globalThis.Number :MIN_VALUE)
                         (- 0 (get globalThis.Number :MIN_VALUE))
                         (get globalThis.Number :MAX_VALUE)
                         (- 0 (get globalThis.Number :MAX_VALUE))
                         (Math/pow 2 -149)
                         (Math/pow 2 -126)
                         (* (- 2 (Math/pow 2 -23)) (Math/pow 2 127))
                         (Math/pow 2 128))))
      (js-call midpoints :forEach
        (lambda (midpoint)
          (js-call (js-array (adjacent midpoint false) midpoint (adjacent midpoint t)) :forEach
            (lambda (v)
              (js-call out :push v (- 0 v))))))
      out))

  (defun fround-random ()
    (let* ((out (js-array))
           (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
           (seed 1831565813)
           (next-u32 (lambda ()
                       (setq seed (funcall to-uint32 (+ (Math/imul seed 1664525) 1013904223)))
                       seed))
           (index 0))
      (while (< index 128)
        (js-call bits :setUint32 0 (funcall next-u32) t)
        (js-call bits :setUint32 4 (funcall next-u32) t)
        (js-call out :push (js-call bits :getFloat64 0 t))
        (setq index (1+ index)))
      ;; Include representative binary32 exponent classes and both signs as exact f64 inputs.
      (let ((exponent 0))
        (while (< exponent 256)
          (let ((fraction (funcall bit-and-u32 (funcall next-u32) 8388607)))
            (js-call bits :setUint32 0 (funcall bit-or-u32 (funcall bit-shl-u32 exponent 23) fraction) t)
            (let ((v (js-call bits :getFloat32 0 t)))
              (js-call out :push v (- 0 v))))
          (setq exponent (+ exponent 7))))
      (js-call (js-array (js-array 1 2146435072)
                         (js-array 4294967295 2147483647)
                         (js-array 17 4294443008))
        :forEach
        (lambda (pair)
          (js-call bits :setUint32 0 (aref pair 0) t)
          (js-call bits :setUint32 4 (aref pair 1) t)
          (js-call out :push (js-call bits :getFloat64 0 t))))
      out))

  (defun check-fround (a inputs)
    (let* ((key (js-call a :string "fround"))
           (method (js-call a :invoke "namespace-get" (js-array key))))
      (try
        (let ((index 0))
          (while (< index (get inputs :length))
            (let* ((input (aref inputs index))
                   (expected (Math/fround input)))
              (exact (invoke-val a "direct-fround" (js-array input)) expected (str "direct fround case " index))
              (exact (invoke-val a "math-invoke" (js-array "fround" input)) expected (str "dynamic fround case " index))
              (let ((argument (js-call a :number input)))
                (try
                  (exact (value a "invoke-held" (js-array method argument)) expected (str "held fround case " index))
                  (finally (js-call a :release argument)))))
            (setq index (1+ index))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (finally
          (js-call a :release key)
          (js-call a :release method)))))

  ;; Independent integer model. Every finite binary64 value is an integer
  ;; multiple of 2^-1074; no intermediate floating addition is used here.
  (defun number-word (num)
    (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call bits :setFloat64 0 num t)
      (js-call bits :getBigUint64 0 t)))

  (defun word-number (w)
    (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call bits :setBigUint64 0 w t)
      (js-call bits :getFloat64 0 t)))

  (defun finite-units (num)
    (let* ((b0 (funcall bi 0))
           (b1 (funcall bi 1))
           (b52 (funcall bi 52))
           (b63 (funcall bi 63))
           (b2047 (funcall bi 2047))
           (w (number-word num))
           (exponent (globalThis.Number (funcall bi-and (funcall bi-shr w b52) b2047)))
           (fraction (funcall bi-and w (funcall bi-sub (funcall bi-shl b1 b52) b1)))
           (magnitude (if (= exponent 0)
                        fraction
                        (funcall bi-shl (funcall bi-or (funcall bi-shl b1 b52) fraction)
                                 (funcall bi (- exponent 1))))))
      (if (funcall bi-eq (funcall bi-shr w b63) b0)
        magnitude
        (funcall bi-neg magnitude))))

  (defun round-integer-even (magnitude shift)
    (if (= shift 0)
      magnitude
      (let* ((b0 (funcall bi 0))
             (b1 (funcall bi 1))
             (distance (funcall bi shift))
             (quotient (funcall bi-shr magnitude distance))
             (remainder (funcall bi-sub magnitude (funcall bi-shl quotient distance)))
             (half (funcall bi-shl b1 (funcall bi-sub distance b1)))
             (inc (if (or (funcall bi-gt remainder half)
                          (and (funcall bi-eq remainder half)
                               (not (funcall bi-eq (funcall bi-and quotient b1) b0))))
                    b1
                    b0)))
        (funcall bi-add quotient inc))))

  (defun units-number (units &rest __host_forwarded_arguments_1)
    (let* ((negative-zero (aref __host_forwarded_arguments_1 0)))
    (let ((b0 (funcall bi 0))
          (b1 (funcall bi 1))
          (b52 (funcall bi 52))
          (b53 (funcall bi 53))
          (b63 (funcall bi 63)))
      (if (funcall bi-eq units b0)
        (if negative-zero -0.0 0)
        (let* ((is-neg (funcall bi-lt units b0))
               (sign (if is-neg (funcall bi-shl b1 b63) b0))
               (magnitude (if is-neg (funcall bi-neg units) units))
               (two52 (funcall bi-shl b1 b52)))
          (if (funcall bi-lt magnitude two52)
            (word-number (funcall bi-or sign magnitude))
            (let* ((shift (Math/max 0 (- (get (js-call magnitude :toString 2) :length) 53)))
                   (significand (round-integer-even magnitude shift)))
              (when (funcall bi-eq significand (funcall bi-shl b1 b53))
                (setq significand (funcall bi-shr significand b1))
                (setq shift (1+ shift)))
              (let ((exponent (1+ shift)))
                (if (>= exponent 2047)
                  (if (funcall bi-eq sign b0)
                    (get globalThis.Number :POSITIVE_INFINITY)
                    (get globalThis.Number :NEGATIVE_INFINITY))
                  (word-number
                    (funcall bi-or
                      (funcall bi-or sign (funcall bi-shl (funcall bi exponent) b52))
                      (funcall bi-sub significand two52))))))))))))

  (defun f16-model (input)
    (let ((num (funcall js-to-number input)))
      (if (or (not (Number/isFinite num)) (= num 0))
        num
        (let* ((b0 (funcall bi 0))
               (b1 (funcall bi 1))
               (units (finite-units num))
               (is-neg (funcall bi-lt units b0))
               (magnitude (if is-neg (funcall bi-neg units) units))
               ;; binary16 has ten fraction bits and the subnormal quantum is 2^-24.
               (shift (Math/max 1050 (- (get (js-call magnitude :toString 2) :length) 11)))
               (rounded (funcall bi-shl (round-integer-even magnitude shift) (funcall bi shift))))
