           (js-call m :cold_number_key_error ctor trace)
           (catch error
             (setq thrown t)
             (js-call assert :strictEqual error false)))
         (funcall assert thrown)
         (js-call assert :deepEqual trace (js-array "string"))
         (let ((new-target (js-call m :cold_number_newtarget -0.0)))
           (js-call assert :deepEqual new-target (js-array t t))
