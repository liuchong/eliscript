(module tests.helpers.portable-stdlib
  (import "bun:test" expect)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./seed-compiler.mjs" seedCompilerFixture)
  (import "../../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst projectDirectory (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) "../.."))
  (defconst stdlibDirectory (resolve projectDirectory "stdlib"))
  (defconst emacs (get (get globalThis.process :env) :EMACS "emacs"))
  (defconst host-truth (js* "(value) => !!value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun contains (actual expected) (js-call (expect actual) :toContain expected))
  (defun excludes (actual expected) (js-call (get (expect actual) :not) :toContain expected))
  (defasync runSuccessful (command extraEnvironment)
    (let* ((started (performance/now)) (env (get globalThis.process :env)))
      (when (funcall host-truth (get env :CI)) (js-call globalThis.console :error "host check starting:" (js-call command :join " ")))
      (let* ((child (Bun/spawn command (js-object :cwd projectDirectory :env (copyHostRecord env (js-object :EMACS emacs) extraEnvironment) :stdout "pipe" :stderr "pipe")))
             (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text)
                                                   (js-call (new globalThis.Response (get child :stderr)) :text)))))
             (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
        (when (funcall host-truth (get env :CI))
          (js-call globalThis.console :error "host check completed:" (js-call command :join " ") (str "(" (Math/round (- (performance/now) started)) "ms; exit " exitCode ")")))
        (unless (= exitCode 0)
          (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
            (throw (new globalThis.Error (if (funcall host-truth err) err (if (funcall host-truth out) out (str (aref command 0) " exited with " exitCode))))))) stdout)))
  (defasync sourceMap (directory module)
    (JSON/parse (await (readFile (resolve directory (str module ".mjs.map")) "utf8"))))
  (defasync assertSourceMap (directory module declarations)
    (let ((map (await (sourceMap directory module))) (index 0))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (while (< index (js-length declarations))
        (contains (aref (get map :sourcesContent) 0) (aref declarations index)) (setq index (1+ index)))))
  (defasync pruneLibrary (context exported include exclude)
    (let* ((module (get context :module)) (out (resolve (get context :directory) "pruned")))
      (await (runSuccessful (js-array (resolve projectDirectory "bin/eliscript-build") "--root" stdlibDirectory "--portable" exported
                                      "--out-dir" out (resolve stdlibDirectory (str module ".eli"))) (js-object)))
      (let ((source (await (readFile (resolve out (str module ".mjs")) "utf8"))) (index 0))
        (while (< index (js-length include)) (contains source (aref include index)) (setq index (1+ index)))
        (setq index 0) (while (< index (js-length exclude)) (excludes source (aref exclude index)) (setq index (1+ index))))))
  (defasync withPortableLibraries (options check)
    (let* ((module (get options :module))
           (extraSources (if (nullish? (get options :extraSources)) (js-object) (get options :extraSources)))
           (sources (js-call (get options :sources) :concat (Object/keys extraSources)))
           (sourcePath (lambda (name) (if (Object/hasOwn extraSources name) (get extraSources name) (resolve stdlibDirectory (str name ".eli")))))
           (directory (await (mkdtemp (resolve (tmpdir) (str "eliscript-" module "-")))))
           (bootstrapDirectory (resolve directory "bootstrap")) (seedDirectory (resolve directory "seed"))
           (selfHostedDirectory (resolve directory "self-hosted")) (hostFixture (resolve projectDirectory (get options :fixture)))
           (extension (lambda (name) (if (or (= name module) (Object/hasOwn extraSources name)) "mjs" "eli"))))
      (try
        (progn
          (await (Promise/all (js-array (mkdir seedDirectory (js-object :recursive t)) (mkdir selfHostedDirectory (js-object :recursive t)))))
          (let ((index 0))
            (while (< index (js-length sources))
              (let ((name (aref sources index)))
                (await (runSuccessful (js-array (resolve projectDirectory "bin/eliscript") "--source-map" "--output"
                  (resolve seedDirectory (str name "." (funcall extension name))) (funcall sourcePath name)) (js-object))))
              (setq index (1+ index))))
          (await (seedCompilerFixture bootstrapDirectory))
          (let ((index 0))
            (while (< index (js-length sources))
              (let ((name (aref sources index)))
                (await (runSuccessful (js-array (resolve projectDirectory "bin/eliscript-portable") "--source-map" "--output"
                  (resolve selfHostedDirectory (str name "." (funcall extension name))) (funcall sourcePath name))
                  (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory))))
              (setq index (1+ index))))
          (let ((index 0))
            (while (< index (js-length sources))
              (let* ((name (aref sources index)) (filename (str name "." (funcall extension name)))
                     (seed (resolve seedDirectory filename)) (selfHosted (resolve selfHostedDirectory filename)))
                (be (await (readFile selfHosted "utf8")) (await (readFile seed "utf8")))
                (be (await (readFile (str selfHosted ".map") "utf8")) (await (readFile (str seed ".map") "utf8"))))
              (setq index (1+ index))))
          (let ((commands (js-array)) (reports (js-array)) (errors (js-array)) (directories (js-array seedDirectory selfHostedDirectory)) (index 0))
            (while (< index 2)
              (let* ((modulePath (resolve (aref directories index) (str module ".mjs")))
                     (bunCommand (js-array (get (get globalThis.process :env) :BUN (get globalThis.process :execPath))))
                     (nodeCommand (js-array (get (get globalThis.process :env) :NODE "node"))))
                (when (get options :loader)
                  (js-call bunCommand :push "--preload" (resolve projectDirectory "tests/fixtures/compiled-eli-bun-preload.mjs"))
                  (js-call nodeCommand :push "--experimental-loader" (resolve projectDirectory "tests/fixtures/compiled-eli-node-loader.mjs")))
                (js-call bunCommand :push hostFixture modulePath) (js-call nodeCommand :push hostFixture modulePath)
                (js-call commands :push bunCommand nodeCommand)) (setq index (1+ index)))
            (let ((run (async (command)
                    (try (js-object :report (JSON/parse (await (runSuccessful command (js-object)))))
                      (catch error (js-object :error error))))) (results undefined))
              (if (get options :parallelHosts)
                (setq results (await (Promise/all (js-call commands :map run))))
                (progn (setq results (js-array) index 0)
                  (while (< index (js-length commands)) (js-call results :push (await (funcall run (aref commands index)))) (setq index (1+ index)))))
              (setq index 0)
              (while (< index (js-length results))
                (let ((result (aref results index)))
                  (if (Object/hasOwn result "error") (js-call errors :push (get result :error)) (js-call reports :push (get result :report))))
                (setq index (1+ index))))
            (when (> (js-length errors) 0) (throw (new globalThis.AggregateError errors "portable fixture host execution failed")))
            (setq index 0)
            (while (< index (js-length reports)) (same (aref reports index) (aref reports 0)) (setq index (1+ index)))
            (await (funcall check (js-object :module module :directory directory :seedDirectory seedDirectory
              :selfHostedDirectory selfHostedDirectory :reports reports :report (aref reports 0))))))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defun generatedModuleLoader (name projectBuild)
    (let ((build undefined) (modulePath (resolve projectDirectory "dist/stdlib" (str name ".mjs"))))
      (async (label)
        (when (nullish? build)
          (setq build (runSuccessful
            (if projectBuild (js-array (resolve projectDirectory "bin/eliscript-build") "--root" stdlibDirectory "--out-dir" (resolve projectDirectory "dist/stdlib") (resolve stdlibDirectory (str name ".eli")))
              (js-array (resolve projectDirectory "bin/eliscript") "--output" modulePath (resolve stdlibDirectory (str name ".eli")))) (js-object))))
        (await build)
        (await (funcall load-module (str (get (pathToFileURL modulePath) :href) "?" label "=" (Date/now)))))))
  (export projectDirectory stdlibDirectory runSuccessful sourceMap assertSourceMap pruneLibrary withPortableLibraries generatedModuleLoader be same contains excludes))
