(module tests.helpers.managed-vector-contract
  (import "node:assert/strict" :default assert)
  (defconst vectorCounts (Object/freeze (js-array 0 1 31 32 33 63 64 65 1023 1024 1025 1056 1057)))
  (defconst options (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
  (defconst memory (js-object :initialPages 4 :maximumPages 1024))
  (defun kind (value) (if (nullish? value) undefined (get value :kind)))
  (defun read (a v)
    (cond ((= (kind v) 4) (js-call a :readNumber v)) ((= (kind v) 5) (js-call a :readString v))
      ((= (kind v) 14) (let ((values (js-array)) (index 0))
        (while (< index (js-call a :length v))
          (let ((child (js-call a :get v index))) (try (js-call values :push (read a child)) (finally (js-call a :release child))))
          (setq index (1+ index))) values)) (t v)))
  (defun finish (a)
    (try (js-call a :closeModule) (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (finally (let ((close (get a :close))) (unless (nullish? close) (Reflect/apply close a (js-array)))))))
  (defun check (a count js)
    (let ((n (js-call a :number count)))
      (try (let ((out (js-call a :invoke "vector_case" (js-array n))))
        (try (js-call assert :deepEqual (read a out) (js-call js :vector_case count) (str "count " count)) (finally (js-call a :release out))))
        (finally (js-call a :release n))))
    (js-call a :collect) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
  (export vectorCounts options memory read finish check)
)
