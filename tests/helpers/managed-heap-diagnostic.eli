(module tests.helpers.managed-heap-diagnostic
  ;; Preserve the original exception. Sample before cleanup changes the heap.
  (defun invokeWithHeapDiagnostic (runtime name args)
    (setq args (if (= args undefined) (js-array) args))
    (let ((before (js-call runtime :stats)))
      (try (js-call runtime :invoke name args)
        (catch error
          (js-call globalThis.console :error (JSON/stringify (js-object :managedInvocation name :before before :after (js-call runtime :stats))))
          (throw error)))))
  (export invokeWithHeapDiagnostic))
