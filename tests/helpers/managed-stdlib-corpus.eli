(module tests.helpers.managed-stdlib-corpus
  (defconst initialInputs (js-array "null" "true" "-0" "1e-3" "\"\u4e2d\ud83d\ude00\\uD800\"" "[1,null,true]" "{\"b\":2,\"a\":[1,false]}" "" "{\"a\":}" "[1,]" "01"))
  (defconst fixedInputs (js-array " " "1." "1e" "1e+" "{\"a\":1,}" "'x'" "{\"a\" 1}" "{a:1}" "\"\\x20\"" "\"line\nfeed\"" "true false" "{\"a\":1,\"a\":2}" "1e400" "{\"z\":{\"a\":1,\"a\":2}}" "{\"a\":[1,]}" "{\"\ud83d\ude00\": [1,]}" "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0041\"" "{\"z\":[true,null,\"x\\n\\u263a\"],\"a\":{\"n\":-1.25e3}}"))
  (defun randomInputs ()
    (let* ((state 99539473)
           (next (lambda () (setq state (uint32 (+ (imul32 state 1664525) 1013904223))) state))
           (pick (lambda (xs) (aref xs (% (funcall next) (js-length xs)))))
           (strings (js-array "" "a" "中😀" "\ud800" "\udfff" "a\u0000b" "\"\\\n" "__proto__"))
           (source undefined))
      (setq source (lambda (depth)
        (let ((kind (% (funcall next) (if (> depth 0) 7 5))))
          (cond ((= kind 0) "null") ((= kind 1) (if (not (= (bit-and (funcall next) 1) 0)) "true" "false"))
                ((= kind 2) (funcall globalThis.String (/ (- (% (funcall next) 20001) 10000) (funcall pick (js-array 1 4 1000)))))
                ((= kind 3) (JSON/stringify (funcall pick strings)))
                ((= kind 4) (funcall pick (js-array "-0" "5e-324" "1e-7" "9007199254740991")))
                ((= kind 5) (str "[" (js-call (Array/from (js-object :length (% (funcall next) 4)) (lambda () (funcall source (- depth 1)))) :join ",") "]"))
                (t (str "{" (js-call (Array/from (js-object :length (% (funcall next) 4))
                    (lambda (ignored index) (str (JSON/stringify (str index "-" (funcall pick strings))) ":" (funcall source (- depth 1))))) :join ",") "}"))))))
      (let ((valid (Array/from (js-object :length 32) (lambda () (funcall source 2)))))
        (js-call valid :concat (js-call (js-call valid :slice 0 16) :map (lambda (x) (str x " x")))))))
  (defconst inputs (js-call initialInputs :concat fixedInputs (randomInputs)))
  (defun parseBoundaryCases () (js-array (js-array "{\"a\":1,\"a\":2}" nil) (js-array "{\"z\":{\"a\":1,\"a\":2}}" nil) (js-array "{\"\ud83d\ude00\": [1,]}" nil) (js-array nil nil) (js-array "1e400" nil) (js-array "null" (js-object "unknown" t)) (js-array "null" (js-object "maxDepth" nil)) (js-array "null" (js-object "maxLength" 1.5)) (js-array "null" (js-object "maxValues" undefined)) (js-array "null" (js-object "maxLength" 3)) (js-array "[[0]]" (js-object "maxDepth" 1)) (js-array "[1,2]" (js-object "maxValues" 2))))
  (defun encodeBoundaryCases () (js-array "\u4e2d\ud83d\ude00" "\ud800" "\udfff" "\u0000\b\f\n\r\t\"\\" (js* "-0") globalThis.NaN globalThis.Infinity (- globalThis.Infinity) undefined (js-object ) (js-array )))
  (defconst parseCases (parseBoundaryCases)) (defconst encodeInputs (encodeBoundaryCases))
  (export inputs parseBoundaryCases encodeBoundaryCases parseCases encodeInputs))
