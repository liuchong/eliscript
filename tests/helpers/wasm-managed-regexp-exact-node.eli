(module tests.helpers.wasm-managed-regexp-exact-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defasync main ()
    (let ((records (JSON/parse (readFileSync (aref (get globalThis.process :argv) 2) "utf8"))))
      (js-call records :forEach
        (lambda (r)
          (let* ((out (js-call (new globalThis.RegExp (get r :pattern) (get r :flags)) :exec (get r :text)))
                 (actual (if (nil? out)
                           nil
                           (js-object
                             :values (js-call (Array/from out) :map (lambda (v) (if (undefined? v) (js-object :missing t) v)))
                             :index (get out :index)
                             :input (get out :input)))))
            (js-call assert :deepEqual actual (get r :expected))))))
    (let* ((rt-mod (await (dynamic-import (aref (get globalThis.process :argv) 3))))
           (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
           (a (funcall instantiateManagedRuntime (readFileSync (aref (get globalThis.process :argv) 4)))))
      (js-call a :auto 1)
      (let* ((input (js-call a :string "ab"))
             (out (js-call a :invoke "run" (js-array input))))
        (js-call assert :equal (js-call a :length out) 3)
        (js-call (js-array "ab" "b" "b") :forEach
          (lambda (expected i)
            (let ((value (js-call a :get out i)))
              (js-call assert :equal (js-call a :readString value) expected)
              (js-call a :release value))))
        (js-call a :release out)
        (js-call a :release input)
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (main))
