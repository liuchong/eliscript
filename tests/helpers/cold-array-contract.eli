(module tests.helpers.cold-array-contract
  (import "node:assert/strict" :default assert)
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defun assertEqual (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun readColdArrayValue (a value)
    (if (or (eq value nil) (not (= (funcall hostTypeof value) "object"))) value
      (if (= (get value :kind) 4) (js-call a :readNumber value)
        (progn (assertEqual (get value :kind) 14)
          (Array/from (js-object :length (js-call a :length value)) (lambda (unused index)
            (let ((child (js-call a :get value index))) (try (readColdArrayValue a child) (finally (js-call a :release child))))))))))
  (defun numeric (a name args)
    (let ((value (js-call a :invoke name args))) (try (js-call a :readNumber value) (finally (js-call a :release value)))))
  (defun checkColdArray (a reference name &rest __host_default_arguments_1)
    (let* ((runtime (aref __host_default_arguments_1 0)))
    (when (= runtime undefined) (setq runtime "wasm"))
    (js-call a :auto 1) (js-call a :initializeModule)
    (let* ((keep (js-call a :number (js* "-0"))) (caller (js-call a :frame 1)) (held (js-array keep)))
      (js-call a :frameSet caller 0 keep)
      (try
        (cond ((js-call name :startsWith "cold-boxed-")
          (let* ((pieces (js-call name :split ":")) (base (aref pieces 0)) (phase (aref pieces 1)) (parts (js-call base :split "-"))
                 (label (aref parts 2)) (first (aref parts 3)) (labels (js-array "number" "string" "boolean" "symbol" "bigint"))
                 (phases (js-array "first" "pair" "proto" "valueof-read")) (phaseIndex (js-call phases :indexOf phase))
                 (brand (js-call a :number (js-call labels :indexOf label))) (objectFirst (= first "object"))
                 (expectedInput (cond ((= label "number") (js* "-0")) ((= label "string") "ab") ((= label "boolean") false) (t (js* "1n"))))
                 (input (cond ((= label "number") keep) ((= label "string") (js-call a :string expectedInput)) ((= label "boolean") false)
                              ((= label "bigint") (js-call a :bigint expectedInput)) (t undefined))))
            (js-call held :push brand) (unless (= input keep) (js-call held :push input))
            (when (= label "bigint") (assertEqual (if (nullish? input) undefined (get input :kind)) 34 "BigInt input must be an actual managed primitive") (assertEqual (js-call a :readBigInt input) expectedInput))
            (let* ((hasPhase (not (= phase undefined))) (operation (if hasPhase (str "cold-boxed-" phase) "cold-boxed"))
                   (boxedPrefix (or (= phase "length") (= phase "slice")))
                   (ordinary (if boxedPrefix (js-array expectedInput) (if (or (= phaseIndex 0) (= phaseIndex 1)) (js-array expectedInput objectFirst) (js-array expectedInput (js-call labels :indexOf label) objectFirst))))
                   (expected (if (= label "symbol")
                     (if hasPhase (js-call reference :cold_boxed_symbol_stage 3 objectFirst phaseIndex) (js-call reference :cold_boxed_symbol 3 objectFirst))
                     (Reflect/apply (get reference (js-call operation :replaceAll "-" "_")) undefined ordinary)))
                   (complete (js-array (if (= label "string") 2 0) t t t t))
                   (stage (if hasPhase (js-call a :number phaseIndex) undefined)) (result undefined))
              (same expected (cond ((= phase "length") undefined) ((= phase "slice") (js-array)) ((= phaseIndex 0) 1) ((= phaseIndex 1) 2)
                                   ((= phaseIndex 2) (js-call complete :slice 0 3)) ((= phaseIndex 3) (js-call complete :slice 0 4)) (t complete)))
              (when hasPhase (js-call held :push stage))
              (setq result (if (= label "symbol")
                (js-call a :invoke (if hasPhase "cold-boxed-symbol-stage" "cold-boxed-symbol") (if hasPhase (js-array brand objectFirst stage) (js-array brand objectFirst)))
                (js-call a :invoke operation (if boxedPrefix (js-array input) (if (or (= phaseIndex 0) (= phaseIndex 1)) (js-array input objectFirst) (js-array input brand objectFirst))))))
              (js-call held :push result) (same (readColdArrayValue a result) expected) (js-call a :collect))))
          ((or (= name "cold-key-error") (= name "cold-key-primitive-error"))
            (let* ((zero (js-call a :number 0)) (trace (js-call a :sourceArray (js-array zero))) (expected (js-array 0)) (expectedThrew false) (actualThrew false))
              (js-call held :push zero trace)
              (try (Reflect/apply (get reference (js-call name :replaceAll "-" "_")) undefined (js-array expected)) (catch error (setq expectedThrew t) (js-call assert :strictEqual error false)))
              (try (js-call a :invoke name (js-array trace))
                (catch error
                  (setq actualThrew t)
                  (unless (eq error false)
                    (let ((observation undefined))
                      (try (let ((first (js-call a :get trace 0)))
                        (try (setq observation (js-object :length (js-call a :length trace) :first (js-call a :readNumber first) :frameDepth (get (js-call a :stats) :frameDepth)))
                          (finally (js-call a :release first))))
                        (catch inspectionError (setq observation (js-object :unavailable (funcall globalThis.String inspectionError)))))
                      (js-call globalThis.console :error "[cold-array-key-failure]" (JSON/stringify (js-object :name name :runtime runtime :observation observation)))))
                  (js-call assert :strictEqual error false)))
              (assert expectedThrew) (assert actualThrew) (same expected (js-array 1)) (same (readColdArrayValue a trace) expected) (js-call a :collect)
              (let ((input (js-call a :number 7))) (js-call held :push input) (assertEqual (numeric a "cold-recover" (js-array input)) (js-call reference :cold_recover 7)))))
          (t
            (let ((args (js-array)))
              (when (or (= name "cold-host") (= name "argv-lifetime"))
                (let* ((seven (js-call a :number 7)) (input (js-call a :sourceArray (js-array keep seven))))
                  (js-call held :push seven input) (js-call args :push input)))
              (let* ((expected (Reflect/apply (get reference (js-call name :replaceAll "-" "_")) undefined
                                (if (js-call (js-array "cold-host" "argv-lifetime") :includes name) (js-array (js-array (js* "-0") 7)) (js-array))))
                     (result (js-call a :invoke name args)))
                (js-call held :push result) (same (readColdArrayValue a result) expected) (js-call a :collect)))))
        (assertEqual (get (js-call a :stats) :frameDepth) 1)
        (let ((saved (js-call a :frameGet caller 0))) (try (assert (Object/is (js-call a :readNumber saved) (js* "-0"))) (finally (js-call a :release saved))))
        (catch error (js-call globalThis.console :error "[cold-array-case-failure]" (JSON/stringify (js-object :name name :runtime runtime :stats (js-call a :stats)))) (throw error))
        (finally (js-call a :leaveFrame caller) (js-call held :forEach (lambda (value) (js-call a :release value))))))))
  (export readColdArrayValue checkColdArray))
