(module tests.helpers.source-map-vlq-contract
  (import "node:assert/strict" :default assert)
  ;; Native operators are the independent JS-coercion oracle under test.
  (defconst native-lt (js* "(left, right) => left < right"))
  (defconst native-ge (js* "(left, right) => left >= right"))
  (defconst native-mul (js* "(left, right) => left * right"))
  (defconst native-negate (js* "(value) => -value"))
  (defconst native-mod (js* "(left, right) => left % right"))
  (defconst native-add (js* "(left, right) => left + right"))
  (defconst native-divide (js* "(left, right) => left / right"))
  (defconst unsigned32 (js* "(value) => value >>> 0"))
  (defconst signed32 (js* "(value) => value | 0"))
  (defconst native-function (js* "(implementation) => function(...args) { return implementation(this, args); }"))
  (defun oracle (value)
    (let ((base64 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
          (remaining (if (funcall native-lt value 0)
                       (funcall native-add (funcall native-mul (funcall native-negate value) 2) 1)
                     (funcall native-mul value 2)))
          (characters (js-array)))
      (while (funcall native-ge remaining 32)
        (js-call characters :push (js-call base64 :charAt (funcall native-add (funcall native-mod remaining 32) 32)))
        (setq remaining (Math/floor (funcall native-divide remaining 32))))
      (js-call characters :push (js-call base64 :charAt remaining))
      (js-call characters :join "")))
  (defun coercion-fixture ()
    (let ((events (js-array)) (n 0) (value (js-object)))
      (Object/defineProperty value (get globalThis.Symbol :toPrimitive)
        (js-object :enumerable t :configurable t :get (lambda ()
          (put events (get events :length) "primitive")
          (lambda (hint)
            (put events (get events :length) hint)
            (let ((old n)) (setq n (1+ n)) (if (= old 0) -2 3))))))
      (js-object :events events :value value)))
  (defun check (m)
    (js-call (js-array undefined nil false t globalThis.NaN 0 (js* "-0") 1 -1 15 -15 16 -16 31 32 1024 -1024
       2147483647 -2147483648 1099511627776 -1099511627776 0.1 -0.1 15.75 -15.75 "" " 3 " "0x10" "not-a-number")
      :forEach (lambda (value) (js-call assert :equal (js-call m :encode_vlq value) (oracle value))))
    (js-call (js-array (js* "1n") (js* "-1n") (funcall globalThis.Symbol "x")) :forEach (lambda (value)
      (js-call assert :throws (lambda () (oracle value)) globalThis.TypeError)
      (js-call assert :throws (lambda () (js-call m :encode_vlq value)) globalThis.TypeError)))
    (js-call assert :equal (js-call m :encode_vlq) (oracle undefined))
    (let ((left (coercion-fixture)) (right (coercion-fixture)) (marker (js-object)))
      (js-call assert :equal (js-call m :encode_vlq (get left :value)) (oracle (get right :value)))
      (js-call assert :deepEqual (get left :events) (get right :events))
      (js-call assert :throws (lambda () (js-call m :encode_vlq (js-object :valueOf (lambda () (throw marker))))) (lambda (error) (= error marker))))
    (js-call assert :equal (js-call m :encode_vlq 1) "C")
    (let ((state 3022405521) (index 0) (divisors (js-array 1 2 8)))
      (while (< index 2048)
        (setq state (funcall unsigned32 (+ (Math/imul state 1664525) 1013904223)))
        (let ((value (/ (funcall signed32 state) (aref divisors (% index 3)))))
          (js-call assert :equal (js-call m :encode_vlq value) (oracle value)))
        (setq index (1+ index)))))
  (defun observe (fn mode value)
    (let* ((events (js-array))
           (saved (js-object
             :push (Object/getOwnPropertyDescriptor (get globalThis.Array :prototype) "push")
             :join (Object/getOwnPropertyDescriptor (get globalThis.Array :prototype) "join")
             :charAt (Object/getOwnPropertyDescriptor (get globalThis.String :prototype) "charAt")
             :floor (Object/getOwnPropertyDescriptor globalThis.Math "floor")))
           (identity (js-object)) (result undefined) (error undefined) (receiver undefined))
      (letfn ((log (x) (put events (get events :length) x)))
        (try
          (Object/defineProperty (get globalThis.Array :prototype) "push" (js-object :configurable t :get (lambda ()
            (log "push:get")
            (if (= mode "bad-push") nil
              (funcall native-function (lambda (this args)
                (log "push:call") (setq receiver this)
                (Reflect/apply (get (get saved :push) :value) this (js-array (if (= mode "mutate") "replacement" (aref args 0))))))))))
          (Object/defineProperty (get globalThis.String :prototype) "charAt" (js-object :configurable t :get (lambda ()
            (log "charAt:get")
            (funcall native-function (lambda (this args)
              (let ((index (aref args 0)))
                (log (str "charAt:" index))
                (when (= mode "char-throws") (throw identity))
                (if (= mode "char-object") (js-object :toString (lambda () (log "character:string") "x"))
                  (Reflect/apply (get (get saved :charAt) :value) this (js-array index)))))))))
          (Object/defineProperty (get globalThis.Array :prototype) "join" (js-object :configurable t :get (lambda ()
            (log "join:get")
            (when (= mode "join-throws") (throw identity))
            (funcall native-function (lambda (this args)
              (let ((separator (aref args 0)))
                (log (str "join:call:" separator))
                (js-call assert :equal this receiver)
                (if (= mode "custom-join") identity
                  (Reflect/apply (get (get saved :join) :value) this (js-array separator)))))))))
          (Object/defineProperty globalThis.Math "floor" (js-object :configurable t :get (lambda ()
            (log "floor:get")
            (funcall native-function (lambda (this args)
              (log "floor:call") (when (= mode "infinite-trap") (throw identity))
              (Reflect/apply (get (get saved :floor) :value) this args))))))
          (setq result (funcall fn value))
          (catch failure (setq error (if (= failure identity) "marker"
            (if (funcall (js* "(a, b) => a instanceof b") failure globalThis.TypeError) "TypeError" (funcall globalThis.String failure)))))
          (finally
            ;; Restore without push/join or an iterator whose implementation can observe the patched methods.
            (Object/defineProperty (get globalThis.Array :prototype) "push" (get saved :push))
            (Object/defineProperty (get globalThis.Array :prototype) "join" (get saved :join))
            (Object/defineProperty (get globalThis.String :prototype) "charAt" (get saved :charAt))
            (Object/defineProperty globalThis.Math "floor" (get saved :floor)))))
      (js-object :events events :result (if (= result identity) "identity" result) :error error)))
  (defun checkMethods (m)
    (js-call (js-array "normal" "mutate" "bad-push" "char-throws" "char-object" "custom-join" "join-throws") :forEach (lambda (mode)
      (js-call (js-array 0 1 -1 16 1024) :forEach (lambda (value)
        (js-call assert :deepEqual (observe (get m :encode_vlq) mode value) (observe oracle mode value))))))
    (js-call assert :deepEqual (observe (get m :encode_vlq) "infinite-trap" globalThis.Infinity) (observe oracle "infinite-trap" globalThis.Infinity))
    (js-call assert :equal (js-call m :encode_vlq 0) "A"))
  (export oracle check observe checkMethods)
)
