(module tests.helpers.wasm-managed-primitive-operators-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:process" :default process)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defasync run-main ()
    (let ((mode (aref (get process :argv) 2)))
      (cond
        ((= mode "seed")
         (let* ((module-url (aref (get process :argv) 3))
                (hex (aref (get process :argv) 4))
                (m (await (funcall dyn-import module-url))))
           (when (/= (js-call m :subtract hex (globalThis.Number (globalThis.BigInt hex))) 0)
             (throw (globalThis.Error "seed file conversion")))))
        ((= mode "global")
         (let* ((module-url (aref (get process :argv) 3))
                (hex (aref (get process :argv) 4))
                (m (await (funcall dyn-import module-url))))
           (js-call assert :equal (js-call m :value) 7)
           (js-call assert :equal (js-call m :raw) 7)
           (js-call assert :equal (js-call m :subtract hex (globalThis.Number (globalThis.BigInt hex))) 0)
           (js-call m :change 9)
           (js-call assert :equal (get m :globalThis) 9)
           (js-call assert :equal (js-call m :raw) 9)))
        ((= mode "wasm")
         (let* ((wasm-path (aref (get process :argv) 3))
                (module-url (aref (get process :argv) 4))
                (js (await (funcall dyn-import module-url)))
                (a (instantiateManagedRuntime (readFileSync wasm-path))))
           (js-call a :auto 1)
           (let* ((text (js-call a :string "1.5"))
                  (two (js-call a :number 2))
                  (sum (js-call a :invoke "add" (js-array text two)))
                  (product (js-call a :invoke "multiply" (js-array text two))))
             (js-call assert :equal (js-call a :readString sum) "1.52")
             (js-call assert :equal (js-call a :readNumber product) 3)
             (js-call assert :equal (js-call js :multiply "1.5" 2) 3)
             (js-call (js-array text two sum product) :forEach
               (lambda (x) (js-call a :release x)))
             (js-call a :collect)
             (js-call assert :equal (js-call a :live) 0)
             (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
        (t
         (throw (globalThis.Error (str "unknown mode: " mode)))))))

  (js-call (run-main) :catch
    (lambda (err)
      (js-call globalThis.console :error err)
      (js-call process :exit 1))))
