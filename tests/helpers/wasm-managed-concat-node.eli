(module tests.helpers.wasm-managed-concat-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (let ((a (instantiateManagedRuntime (readFileSync 0))))
    (js-call a :auto 1)
    (let* ((input (js-call a :string "中😀"))
           (value (js-call a :number -0.0))
           (out (js-call a :invoke "f" (js-array input value))))
      (js-call assert :equal (js-call a :readString out) "中😀0")
      (js-call (js-array input value out) :forEach (lambda (x) (js-call a :release x))))
    (let ((sparse (new globalThis.Array 3)))
      (put sparse 0 t)
      (put sparse 2 undefined)
      (let* ((items (js-call a :sourceArray sparse))
             (other (js-call a :sourceArray (js-array false)))
             (copy (js-call a :invoke "f" (js-array items other))))
        (js-call assert :equal (js-call a :keyEqual copy items) false)
        (js-call assert :equal (js-call a :length copy) 4)
        (let ((i 0))
          (while (< i 4)
            (let ((key (js-call a :number i)))
              (js-call assert :equal (js-call a :invoke "own" (js-array copy key)) (/= i 1))
              (js-call a :release key))
            (setq i (1+ i))))
        (js-call assert :equal (js-call a :get copy 0) t)
        (js-call assert :equal (js-call a :get copy 2) undefined)
        (js-call assert :equal (js-call a :get copy 3) false)
        (js-call (js-array items other copy) :forEach (lambda (x) (js-call a :release x)))
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
