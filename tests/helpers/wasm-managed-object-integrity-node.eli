(module tests.helpers.wasm-managed-object-integrity-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defasync main ()
    (let* ((rt-mod (await (dynamic-import (aref (get globalThis.process :argv) 2))))
           (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
           (bytes (readFileSync (aref (get globalThis.process :argv) 3))))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let* ((a (funcall instantiateManagedRuntime bytes))
             (_ (js-call a :auto 1))
             (x (js-call a :number -0.0))
             (object (js-call a :sourceObject (js-object :x x)))
             (frozen (js-call a :invoke "freeze" (js-array object)))
             (key (js-call a :string "x")))
        (funcall assert (js-call a :keyEqual object frozen))
        (js-call assert :equal (js-call a :invoke "frozen" (js-array object)) t)
        (js-call assert :throws
          (lambda () (js-call a :invoke "write" (js-array object key x)))
          (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
        (let ((raw (Object/freeze (js-object :x -0.0))))
          (js-call assert :throws (lambda () (put raw :x -0.0)) globalThis.TypeError))
        (js-call (js-array (js-array) (js-array t) (globalThis.Array 3)) :forEach
          (lambda (values)
            (let* ((arr (js-call a :sourceArray values))
                   (locked (js-call a :invoke "freeze" (js-array arr)))
                   (sorted (js-call a :invoke "sort" (js-array arr))))
              (funcall assert (js-call a :keyEqual arr sorted))
              (js-call (Object/freeze values) :sort)
              (js-call a :release arr)
              (js-call a :release locked)
              (js-call a :release sorted))))
        (js-call (js-array x object frozen key) :forEach (lambda (v) (js-call a :release v)))
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (main))
