(module tests.helpers.wasm-managed-identity-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defasync main ()
    (let* ((rt-mod (await (dynamic-import (aref (get globalThis.process :argv) 2))))
           (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
           (a (funcall instantiateManagedRuntime (readFileSync (aref (get globalThis.process :argv) 3))))
           (seed 1913968979)
           (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (i 0))
      (js-call a :auto 1)
      (while (< i 1024)
        (js-call bits :setUint32 0 (funcall next) t)
        (js-call bits :setUint32 4 (funcall next) t)
        (let* ((x (js-call bits :getFloat64 0 t))
               (y (if (not (= (% i 2) 0)) x (- x)))
               (l (js-call a :number x))
               (r (js-call a :number y)))
          (js-call assert :equal (js-call a :invoke "same" (js-array l r)) (Object/is x y))
          (js-call a :release l)
          (js-call a :release r))
        (setq i (1+ i)))
      (let ((arr (js-call a :sourceArray (js-array)))
            (raw (js-call a :array (js-array))))
        (js-call assert :equal (js-call a :invoke "array" (js-array arr)) t)
        (js-call assert :equal (js-call a :invoke "array" (js-array raw)) false)
        (js-call a :release arr)
        (js-call a :release raw)
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (main))
