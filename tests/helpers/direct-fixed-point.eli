(module tests.helpers.direct-fixed-point
  (import "node:assert/strict" :default assert)
  (defun managedOutputs (generations source runtime filename &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)) (snapshots (aref __host_forwarded_arguments_1 1)))
    (let* ((programs (js-call generations :map (lambda (g) (js-call (get g :compiler) :compile_ir_string source filename))))
      (runtimes (js-call generations :map (lambda (g) (js-call (get g :compiler) :compile_ir_string runtime "runtime.eli"))))
      (saved (when snapshots (js-call programs :map (lambda (program) (JSON/stringify program)))))
      (savedRuntime (when snapshots (js-call runtimes :map (lambda (program) (JSON/stringify program)))))
      (lowered (js-call generations :map (lambda (g i) (js-call (get g :managed) :lower_managed_program (aref programs i) (aref runtimes i)))))
      (bytes (js-call generations :map (lambda (g i)
        (if (nullish? options) (js-call (get g :managed) :emit_managed_wasm (aref programs i) (aref runtimes i))
          (js-call (get g :managed) :emit_managed_wasm (aref programs i) (aref runtimes i) options))))))
      (js-object :programs programs :runtimes runtimes :lowered lowered :bytes bytes :saved saved :savedRuntime savedRuntime))))
  (defun equalAll (values) (js-call assert :deepEqual (aref values 0) (aref values 1)) (js-call assert :deepEqual (aref values 1) (aref values 2)))
  (defun fixedValues (records)
    (js-call assert :deepEqual (aref (get records :programs) 0) (aref (get records :programs) 2)) (equalAll (get records :lowered)) (equalAll (get records :bytes)))
  (defun readValue (runtime value)
    (if (or (nullish? value) (not (= (funcall (js* "(value) => typeof value") value) "object"))) value
      (cond ((= (get value :kind) 4) (js-call runtime :readNumber value)) ((= (get value :kind) 5) (js-call runtime :readString value))
        (t (Array/from (js-object :length (js-call runtime :length value)) (lambda (_ index)
          (let ((child (js-call runtime :get value index))) (try (readValue runtime child) (finally (js-call runtime :release child))))))))))
  (defun assertSeedGeneration (generations records i seed)
    (js-call assert :equal (js-call (get (aref generations i) :compiler) :emit_ir_string (aref (get records :programs) i)) seed)
    (js-call assert :deepEqual (aref (get records :programs) i) (aref (get records :programs) 0))
    (js-call assert :deepEqual (aref (get records :lowered) i) (aref (get records :lowered) 0))
    (js-call assert :deepEqual (aref (get records :bytes) i) (aref (get records :bytes) 0)))
  (defun numberResult (a name &rest __host_forwarded_arguments_2)
    (let* ((args (aref __host_forwarded_arguments_2 0)))
    (when (nullish? args) (setq args (js-array)))
    (let ((out (js-call a :invoke name args))) (try (js-call a :readNumber out) (finally (js-call a :release out))))))
  (defun readSparseValue (a x)
    (if (or (nullish? x) (not (= (funcall (js* "(value) => typeof value") x) "object"))) x
      (cond ((= (get x :kind) 4) (js-call a :readNumber x)) ((= (get x :kind) 5) (js-call a :readString x))
        (t (let ((result (new globalThis.Array (js-call a :length x))))
          (let ((__eli_iteration_1_index 0) (__eli_iteration_1_limit (js-length result)))
  (while (< __eli_iteration_1_index __eli_iteration_1_limit)
    (let ((index __eli_iteration_1_index))
      (let* ((key (js-call a :number index)) (own (js-call a :invoke "has-index" (js-array x key))))
              (js-call a :release key)
              (when own (let ((child (js-call a :get x index))) (try (put result index (readSparseValue a child)) (finally (js-call a :release child))))))
      (setq __eli_iteration_1_index (+ index 1))))) result)))))
  (export readSparseValue assertSeedGeneration numberResult managedOutputs equalAll fixedValues readValue))
