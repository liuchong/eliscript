(module tests.helpers.wasm-managed-catch-destructuring-node
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:process" :default process)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defasync run-main ()
    (let* ((rt-mod (await (funcall dynamic-import (aref (get process :argv) 2))))
           (instantiate (get rt-mod :instantiateManagedRuntime))
           (bytes (await (readFile (aref (get process :argv) 3)))))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let* ((a (funcall instantiate bytes))
             (_ (js-call a :auto 1))
             (sp (let ((arr (globalThis.Array 4)))
                   (put arr 0 false)
                   (put arr 2 t)
                   (put arr 3 undefined)
                   arr))
             (source (js-call a :sourceArray sp))
             (out (js-call a :invoke "array" (js-array source)))
             (first (js-call a :get out 0))
             (third (js-call a :get out 1))
             (tail (js-call a :get out 2)))
        (js-call assert :equal first false)
        (js-call assert :equal third t)
        (js-call assert :equal (js-call a :length tail) 1)
        (js-call assert :equal (js-call a :get tail 0) undefined)
        (let* ((object (js-call a :sourceObject (js-object)))
               (value (js-call a :invoke "captured" (js-array object)))
               (tdz (js-call a :invoke "tdz" (js-array object)))
               (invalid (js-call a :invoke "invalid" (js-array nil))))
          (js-call assert :equal (js-call a :readNumber value) 7)
          (js-call assert :equal (js-call a :readString tdz) "ReferenceError")
          (js-call assert :equal (js-call a :readString invalid) "TypeError")
          (let* ((protocol (js-call a :invoke "protocol"))
                 (protocolName (js-call a :get protocol 0))
                 (protocolCode (js-call a :get protocol 1)))
            (js-call assert :equal (js-call a :readString protocolName) "ProtocolDispatchError")
            (js-call assert :equal (js-call a :readString protocolCode) "ELI-RUNTIME-PROTOCOL")
            (js-call (js-array source out tail object value tdz invalid protocol protocolName protocolCode)
              :forEach (lambda (v) (js-call a :release v)))
            (js-call a :closeModule)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))

  (run-main))
