(module tests.helpers.wasm-managed-callables-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:fs/promises" readFile)
  (import "node:buffer" Buffer)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst to-uint32 (js* "(x) => x >>> 0"))

  (defasync run-cli (mode arg1 arg2)
    (cond
      ((= mode "--check-raw")
       (let ((instances (js-array)))
         (let ((paths (js-array arg1 arg2))
               (idx 0))
           (while (< idx (get paths :length))
             (let* ((buf (await (readFile (aref paths idx))))
                    (m (new globalThis.WebAssembly.Module buf)))
               (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports m) (js-array))
               (js-call instances :push (get (new globalThis.WebAssembly.Instance m) :exports)))
             (setq idx (1+ idx))))
         (let* ((e (aref instances 0))
                (tbl (aref instances 1)))
           (js-call assert :equal (js-call tbl :dispatch 0 41) 42)
           (js-call assert :equal (js-call tbl :dispatch 1 41) 41)
           (js-call assert :throws (lambda () (js-call tbl :dispatch 2 0)) globalThis.WebAssembly.RuntimeError)
           (js-call assert :throws (lambda () (js-call tbl :mismatch 0)) globalThis.WebAssembly.RuntimeError)
           (let* ((h (funcall (get e "heap-new") 128 4096 32768))
                  (c (lambda (name &rest args)
                       (let ((r (funcall to-uint32
                                  (Reflect/apply (get e name) e (js-call (js-array h) :concat args)))))
                         (js-call assert :equal (funcall (get e "last-error")) 0 name)
                         r))))
             (funcall c "heap-auto" 1)
             (let* ((cell (funcall c "value-cell-new" 2))
                        (_cell-root (funcall c "heap-pin" cell))
                   (f (funcall c "value-function-new" 7 1))
                   (keep (js-array))
                   (i 0))
               (funcall c "heap-pin" f)
               (funcall c "value-function-capture-set" f 0 cell)
               (funcall c "value-cell-set" cell f)
               (funcall c "heap-release" cell)
               (while (< i 50)
                 (let ((n (funcall c "value-number" i 0)))
                   (funcall c "heap-pin" n)
                   (js-call keep :push n))
                 (setq i (1+ i)))
               (funcall c "heap-collect")
               (funcall assert (> (funcall c "heap-capacity") 4096))
               (js-call assert :equal (funcall c "value-function-code" f) 7)
               (js-call assert :equal
                 (funcall c "value-cell-get" (funcall c "value-function-capture-get" f 0))
                 f)
               (js-call keep :forEach (lambda (n) (funcall c "heap-release" n)))
               (funcall c "heap-release" f)
               (funcall c "heap-collect")
               (js-call assert :equal (funcall c "heap-live") 0)
               (js-call assert :equal (funcall c "frame-depth") 0))))))
      ((= mode "--check-shadowed")
       (await (funcall dynamic-import
                (get (new globalThis.URL "./managed-reference-node.mjs" (get (js* "import.meta") :url)) :href)))
       (let* ((source (readFileSync 0 "utf8"))
              (reference (await (funcall dynamic-import
                                  (str "data:text/javascript;base64,"
                                       (js-call (Buffer/from source) :toString "base64"))))))
         (js-call assert :throws
           (lambda () (js-call reference :call_closure (js-call reference :f)))
           globalThis.TypeError)))
      ((= mode "--check-source")
       (await (funcall dynamic-import
                (get (new globalThis.URL "./managed-reference-node.mjs" (get (js* "import.meta") :url)) :href)))
       (let* ((ref (await (funcall dynamic-import arg2)))
              (bytes (await (readFile arg1))))
         (js-call assert :deepEqual
           (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
           (js-array))
         (let* ((a (instantiateManagedRuntime bytes))
                (_ (js-call a :auto 1))
                (num (lambda (name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
                       (let ((r (js-call a :invoke name (if (undefined? args) (js-array) args))))
                         (try
                           (js-call a :readNumber r)
                           (finally (js-call a :release r)))))))
                (four (js-call a :number 4))
                (five (js-call a :number 5))
                (adder (js-call a :invoke "make-adder" (js-array four))))
           (js-call assert :equal
             (funcall num "apply-one" (js-array adder five))
             (funcall (js-call ref :make_adder 4) 5))
           (let* ((pair (js-call a :invoke "make-box" (js-array four)))
                  (write (js-call a :get pair 0))
                  (read (js-call a :get pair 1))
                  (reference (js-call ref :make_box 4))
                  (samples (js-array -0.0
                                     (get globalThis.Number :NaN)
                                     (get globalThis.Number :POSITIVE_INFINITY)
                                     (get globalThis.Number :NEGATIVE_INFINITY)
                                     (get globalThis.Number :MIN_VALUE)
                                     (- 0 (get globalThis.Number :MIN_VALUE))
                                     (get globalThis.Number :MAX_VALUE))))
             (js-call samples :forEach
               (lambda (value)
                 (let* ((n (js-call a :number value))
                        (out (js-call a :invoke "apply-one" (js-array write n))))
                   (funcall assert (Object/is (js-call a :readNumber out) (funcall (aref reference 0) value)))
                   (js-call a :release n)
                   (js-call a :release out)
                   (js-call a :collect)
                   (funcall assert (Object/is (funcall num "apply-zero" (js-array read)) (funcall (aref reference 1)))))))
             (let* ((nested (js-call a :invoke "nested" (js-array four)))
                    (inner (js-call a :invoke "apply-one" (js-array nested five))))
               (js-call assert :equal
                 (funcall num "apply-one" (js-array inner four))
                 (funcall (funcall (js-call ref :nested 4) 5) 4))
               (let* ((rec (js-call a :invoke "recursive" (js-array)))
                      (cnt (js-call a :number 24)))
                 (js-call assert :equal
                   (funcall num "apply-one" (js-array rec cnt))
                   (funcall (js-call ref :recursive) 24))
                 (let ((marker (js-call a :sourceArray (js-array false)))
                       (identity (js-call a :invoke "named-value" (js-array))))
                   (js-call assert :throws
                     (lambda () (js-call a :invoke "invoke-order" (js-array false marker)))
                     (lambda (e)
                       (let ((diag (get e :eliscriptDiagnostic)))
                         (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0003")))))
                   (let ((changed (js-call a :get marker 0)))
                     (js-call assert :equal (js-call a :readNumber changed) 2)
                     (js-call a :release changed))
                   (js-call assert :equal (js-call a :invoke "apply-zero" (js-array identity)) undefined)
                   (js-call assert :equal (js-call a :invoke "named-same" (js-array)) t)
                   (js-call assert :equal (js-call a :invoke "fresh-same" (js-array)) false)
                   (js-call assert :equal (js-call a :invoke "repeated-same" (js-array)) false)
                   (js-call assert :equal (funcall num "callee-order") 1)
                   (js-call assert :equal (funcall num "funcall-one" (js-array adder five)) 9)
                   (js-call assert :equal (js-call a :invoke "funcall-zero" (js-array identity)) undefined)
                   (let ((items (js-call a :invoke "capture-each" (js-array four)))
                         (i 0))
                     (while (< i 4)
                       (let ((f (js-call a :get items i)))
                         (js-call assert :equal (funcall num "apply-zero" (js-array f)) i)
                         (js-call a :release f))
                       (setq i (1+ i)))
                     (js-call (js-array four five adder pair write read nested inner rec cnt marker identity items)
                       :forEach (lambda (v) (js-call a :release v)))
                     (js-call a :collect)
                     (js-call assert :equal (js-call a :live) 0)
                     (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))))))

  (let* ((argv (get globalThis.process :argv))
         (mode (aref argv 2))
         (arg1 (aref argv 3))
         (arg2 (aref argv 4)))
    (when (js-call (js-array "--check-raw" "--check-shadowed" "--check-source") :includes mode)
      (run-cli mode arg1 arg2))))
