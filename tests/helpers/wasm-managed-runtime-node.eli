(module tests.helpers.wasm-managed-runtime-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun ok (cond &rest msgs)
    (Reflect/apply (get assert :ok) assert (js-call (js-array cond) :concat msgs)))

  (defun run-arithmetic (wasm-path)
    (let* ((a (instantiateManagedRuntime (readFileSync wasm-path)))
           (inputs (js-array 0 -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                             Number/MIN_VALUE (- Number/MIN_VALUE) Number/MAX_VALUE))
           (xi 0))
      (while (< xi (js-length inputs))
        (let ((x (aref inputs xi))
              (yi 0))
          (while (< yi (js-length inputs))
            (let* ((y (aref inputs yi))
                   (l (js-call a :number x))
                   (r (js-call a :number y))
                   (ops (js-array (js-array 0 (+ x y))
                                  (js-array 1 (- x y))
                                  (js-array 2 (* x y))
                                  (js-array 3 (/ x y))))
                   (oi 0))
              (while (< oi (js-length ops))
                (let* ((pair (aref ops oi))
                       (z (js-call a :binary l r (aref pair 0))))
                  (ok (Object/is (js-call a :readNumber z) (aref pair 1)))
                  (js-call a :release z))
                (setq oi (1+ oi)))
              (js-call a :release l)
              (js-call a :release r)
              (js-call assert :equal (js-call a :collect) 6))
            (setq yi (1+ yi))))
        (setq xi (1+ xi)))
      (let ((prefix (get (js-call a :stats) :usedBytes))
            (i 0))
        (while (< i 1000)
          (let* ((x (js-call a :array (js-array nil)))
                 (y (js-call a :record (js-array x))))
            (js-call a :set x 0 y)
            (js-call a :release x)
            (js-call a :release y)
            (js-call assert :equal (js-call a :collect) 2)
            (js-call assert :equal (get (js-call a :stats) :usedBytes) prefix))
          (setq i (1+ i))))))

  (defun run-roots (wasm-path)
    (let ((wasm-mod (new globalThis.WebAssembly.Module (readFileSync wasm-path))))
      (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports wasm-mod) (js-array))
      (let* ((e (get (new globalThis.WebAssembly.Instance wasm-mod) :exports))
             (h (funcall (get e "heap-new") 12 768 768)))
        (funcall (get e "heap-auto") h 1)
        (let ((p (uint32 (funcall (get e "root-loop") h 1000))))
          (ok (> p 0))
          (js-call assert :equal
            (js-call (new globalThis.DataView (get (get e :memory) :buffer))
                     :getFloat64 (uint32 (funcall (get e "value-data") h p 4)) t)
            2001)
          (js-call assert :equal (funcall (get e "frame-depth") h) 0)
          (ok (> (funcall (get e "heap-collections") h) 3000))
          (funcall (get e "heap-release") h p)
          (funcall (get e "heap-collect") h)
          (js-call assert :equal (funcall (get e "heap-live") h) 0))
        (js-call assert :throws
          (lambda () (funcall (get e "root-trap") h))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (funcall (get e "frame-unwind") h 0) 1)
        (js-call assert :equal (funcall (get e "heap-collect") h) 2)
        (let ((h2 (funcall (get e "heap-new") 192 8192 32768)))
          (funcall (get e "heap-auto") h2 1)
          (let ((p2 (uint32 (funcall (get e "root-recursive") h2 64))))
            (ok (> p2 0))
            (js-call assert :equal
              (js-call (new globalThis.DataView (get (get e :memory) :buffer))
                       :getFloat64 (uint32 (funcall (get e "value-data") h2 p2 4)) t)
              65)
            (js-call assert :equal (funcall (get e "frame-depth") h2) 0)
            (funcall (get e "heap-release") h2 p2)
            (funcall (get e "heap-collect") h2)
            (js-call assert :equal (funcall (get e "heap-live") h2) 0))))))

  (defun run-text-pipeline (wasm-path)
    (let ((wasm-mod (new globalThis.WebAssembly.Module (readFileSync wasm-path))))
      (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports wasm-mod) (js-array))
      (let* ((e (get (new globalThis.WebAssembly.Instance wasm-mod) :exports))
             (h (funcall (get e "heap-new") 24 2048 2048))
             (units (js-array 65279 20013 55357 56832 0 55296 97))
             (input (uint32 (funcall (get e "value-string") h (js-length units))))
             (i 0))
        (while (< i (js-length units))
          (js-call assert :equal (funcall (get e "value-unit-set") h input i (aref units i)) 1)
          (setq i (1+ i)))
        (funcall (get e "value-seal") h input)
        (funcall (get e "heap-auto") h 1)
        (let ((output (uint32 (funcall (get e "text-pipeline") h input 1000))))
          (ok (> output 0))
          (js-call assert :equal (funcall (get e "value-length") h output) 7)
          (js-call assert :deepEqual
            (Array/from (js-object :length 7)
              (lambda (_v idx) (funcall (get e "value-unit-get") h output idx)))
            (js-array 65279 20013 55357 56832 0 65533 97))
          (js-call assert :equal (funcall (get e "frame-depth") h) 0)
          (ok (> (funcall (get e "heap-collections") h) 5000))
          (funcall (get e "heap-release") h output)
          (funcall (get e "heap-collect") h)
          (js-call assert :equal (funcall (get e "heap-live") h) 0)))))

  (defun run-key-pipeline (wasm-path)
    (let ((wasm-mod (new globalThis.WebAssembly.Module (readFileSync wasm-path))))
      (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports wasm-mod) (js-array))
      (let* ((e (get (new globalThis.WebAssembly.Instance wasm-mod) :exports))
             (h (funcall (get e "heap-new") 12 768 768)))
        (funcall (get e "heap-auto") h 1)
        (let ((value (uint32 (funcall (get e "key-pressure") h 1000))))
          (ok (> value 0))
          (js-call assert :equal (uint32 (funcall (get e "value-key-hash") h value)) 1490037359)
          (let ((point (uint32 (funcall (get e "value-data") h value 4)))
                (view (new globalThis.DataView (get (get e :memory) :buffer))))
            (js-call assert :equal (js-call view :getUint32 point t) 999)
            (js-call assert :equal (js-call view :getUint32 (+ point 4) t) 2146959360))
          (js-call assert :equal (funcall (get e "frame-depth") h) 0)
          (ok (>= (funcall (get e "heap-collections") h) 2000))
          (funcall (get e "heap-release") h value)
          (funcall (get e "heap-collect") h)
          (js-call assert :equal (funcall (get e "heap-live") h) 0)))))

  (defun run-cli ()
    (let ((mode (aref globalThis.process.argv 2))
          (wasm-path (aref globalThis.process.argv 3)))
      (cond
        ((= mode "--arithmetic") (run-arithmetic wasm-path))
        ((= mode "--roots") (run-roots wasm-path))
        ((= mode "--text-pipeline") (run-text-pipeline wasm-path))
        ((= mode "--key-pipeline") (run-key-pipeline wasm-path))
        (t (throw (new globalThis.Error (+ "unknown wasm-managed-runtime-node mode: " (globalThis.String mode))))))))

  (run-cli))
