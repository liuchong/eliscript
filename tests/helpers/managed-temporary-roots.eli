(module tests.helpers.managed-temporary-roots
  (import "node:assert/strict" :default assert)
  (defconst temporaryRootOptions (Object/freeze (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 16384 :initializeModule false)))
  (defconst temporaryRootSource "\n(defconst marker 0)\n(defvar saved nil)\n(defun make-large () (js-call \"abcdefgh\" :repeat 512))\n(defun initializer-release ()\n (let* ((garbage (make-large)) (size (get garbage :length)))\n  (setq garbage nil)\n  (let ((survivor (make-large))) (+ size (get survivor :length)))))\n(defun assignment-release ()\n (let ((garbage nil) (size 0))\n  (setq garbage (make-large)) (setq size (get garbage :length)) (setq garbage nil)\n  (let ((survivor (make-large))) (+ size (get survivor :length)))))\n(defun both-live ()\n (let* ((first (make-large)) (second (make-large)))\n  (+ (get first :length) (get second :length))))\n(defun assignment-value () (let ((temporary nil)) (setq temporary (make-large))))\n(defun assignment-survives ()\n (let ((temporary nil))\n  (let* ((result (setq temporary (js-object :zero -0.0))) (stress (make-large)))\n   (js-array result temporary (get stress :length)))))\n(defun store-global () (setq saved (js-object :zero -0.0)))\n(defun read-global () saved)\n(defun capture-owner (value)\n (lambda ()\n  (let* ((first value) (read (lambda () value)))\n   (setq value (+ value 1)) (js-array first (funcall read) value))))\n(defun named-temporary ()\n (let* ((temporary (js-object :zero 7)) (read (lambda () temporary))\n        (outer (lambda () (lambda () (js-array temporary (funcall read))))))\n  (setq temporary (js-object :zero -0.0)) (funcall outer)))\n(defun invoke-callback (callback) (funcall callback))\n(defun parallel-order ()\n (let ((temporary 7) (trace (js-array nil nil)))\n  (let ((temporary (progn (put trace 0 1) 11))\n        (outer (progn (put trace 1 temporary) temporary)))\n   (js-array temporary outer (aref trace 0) (aref trace 1)))))\n(defun assignment-first-error ()\n (let ((value 7))\n  (try (setq value (throw false)) (catch error (js-array error value)))))\n(defun initializer-first-error ()\n (let ((value 7))\n  (try (let* ((first (progn (setq value 8) (throw false))) (second (throw \"later\"))) second)\n   (catch error (js-array error value)))))\n(export marker initializer-release assignment-release both-live assignment-value assignment-survives\n store-global read-global capture-owner named-temporary invoke-callback parallel-order assignment-first-error initializer-first-error)\n")
  (defun diagnostic-code (error)
    (let ((diagnostic (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
      (if (nullish? diagnostic) undefined (get diagnostic :code))))
  (defun initializeTemporaryRootRuntime (a)
    (js-call a :auto 1)
    (js-call assert :throws (lambda () (js-call a :getExport "marker")) (lambda (error) (= (diagnostic-code error) "ELI-RT0008")))
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0) (js-call a :initializeModule))
  (defun primitive (a value) (if (and (not (nullish? value)) (= (get value :kind) 4)) (js-call a :readNumber value) value))
  (defun values (a array)
    (Array/from (js-object :length (js-call a :length array)) (lambda (ignored index)
      (let ((value (js-call a :get array index))) (try (primitive a value) (finally (js-call a :release value)))))))
  (defun numeric (a name)
    (let ((result (js-call a :invoke name))) (try (js-call a :readNumber result) (finally (js-call a :release result)))))
  (defun releaseValues (a items)
    (let ((index 0)) (while (< index (js-length items)) (js-call a :release (aref items index)) (setq index (1+ index)))))
  (defun exerciseTemporaryRootPressure (a reference)
    (let ((names (js-array "initializer-release" "assignment-release")) (index 0))
      (while (< index (js-length names))
        (let ((name (aref names index)) (round 0))
          (while (< round 3)
            (js-call assert :equal (numeric a name) (js-call reference (js-call name :replaceAll "-" "_")))
            (js-call a :collect) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0) (setq round (1+ round))))
        (setq index (1+ index))))
    (js-call assert :equal (js-call reference :both_live) 8192)
    (js-call assert :throws (lambda () (js-call a :invoke "both-live")) (lambda (error) (= (diagnostic-code error) "ELI-RT0002")))
    (js-call a :collect) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
    (js-call assert :equal (numeric a "initializer-release") 8192)
    (let ((text (js-call a :invoke "assignment-value")))
      (try (progn (js-call assert :equal (js-call a :readString text) (js-call reference :assignment_value))
             (js-call a :collect) (js-call assert :equal (js-call a :readString text) (js-call "abcdefgh" :repeat 512)))
        (finally (js-call a :release text))))
    (js-call a :collect) (js-call assert :equal (numeric a "assignment-release") 8192))
  (defun assertZeroProperty (a object)
    (let ((key (js-call a :string "zero")) (zero undefined))
      (try (progn (setq zero (js-call a :objectGet object key)) (funcall assert (Object/is (js-call a :readNumber zero) (js* "-0"))))
        (finally (js-call a :release zero) (js-call a :release key)))))
  (defun exerciseTemporaryRootValues (a reference)
    (let ((assigned (js-call a :invoke "assignment-survives")) (first undefined) (alias undefined) (size undefined))
      (try
        (let ((expected (js-call reference :assignment_survives)))
          (js-call assert :strictEqual (aref expected 0) (aref expected 1)) (funcall assert (Object/is (get (aref expected 0) :zero) (js* "-0")))
          (setq first (js-call a :get assigned 0) alias (js-call a :get assigned 1) size (js-call a :get assigned 2))
          (funcall assert (js-call a :keyEqual first alias)) (js-call assert :equal (js-call a :readNumber size) (aref expected 2))
          (js-call a :collect) (assertZeroProperty a first))
        (finally (releaseValues a (js-array first alias size assigned)))))
    (let ((stored (js-call a :invoke "store-global")) (again undefined))
      (try (progn (js-call a :collect) (setq again (js-call a :invoke "read-global")) (funcall assert (js-call a :keyEqual stored again)) (assertZeroProperty a again))
        (finally (js-call a :release again) (js-call a :release stored))))
    (let* ((input (js-call a :number (js* "-0"))) (closure (js-call a :invoke "capture-owner" (js-array input))) (expected (js-call reference :capture_owner (js* "-0"))))
      (js-call a :release input)
      (try (let ((index 0))
        (while (< index 3)
          (js-call a :collect)
          (let ((result (js-call a :invoke "invoke-callback" (js-array closure))))
            (try (js-call assert :deepEqual (values a result) (funcall expected)) (finally (js-call a :release result))))
          (setq index (1+ index))))
        (finally (js-call a :release closure))))
    (let ((nested (js-call a :invoke "named-temporary")))
      (try
        (let* ((js (js-call reference :named_temporary)) (expectedPair (funcall js)))
          (js-call assert :strictEqual (aref expectedPair 0) (aref expectedPair 1))
          (js-call a :collect)
          (let ((pair (js-call a :invoke "invoke-callback" (js-array nested))) (left undefined) (right undefined))
            (try (progn (setq left (js-call a :get pair 0) right (js-call a :get pair 1)) (funcall assert (js-call a :keyEqual left right)) (js-call a :collect) (assertZeroProperty a left))
              (finally (releaseValues a (js-array left right pair))))))
        (finally (js-call a :release nested))))
    (let ((names (js-array "parallel-order" "assignment-first-error" "initializer-first-error")) (index 0))
      (while (< index (js-length names))
        (let* ((name (aref names index)) (result (js-call a :invoke name)))
          (try (js-call assert :deepEqual (values a result) (js-call reference (js-call name :replaceAll "-" "_"))) (finally (js-call a :release result)))
          (js-call a :collect) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
        (setq index (1+ index))))
    (js-call assert :equal (numeric a "initializer-release") 8192))
  (defun closeTemporaryRootRuntime (a)
    (try (progn (js-call a :closeModule) (js-call a :collect) (js-call assert :equal (js-call a :live) 0) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
      (finally (unless (nullish? (get a :close)) (js-call a :close)))))
  (export temporaryRootOptions temporaryRootSource initializeTemporaryRootRuntime exerciseTemporaryRootPressure exerciseTemporaryRootValues closeTemporaryRootRuntime))
