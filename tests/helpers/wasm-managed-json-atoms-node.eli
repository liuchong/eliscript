(module tests.helpers.wasm-managed-json-atoms-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defasync main ()
    (let* ((rt-mod (await (dynamic-import (aref (get globalThis.process :argv) 2))))
           (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
           (a (funcall instantiateManagedRuntime
                (readFileSync (aref (get globalThis.process :argv) 3))
                (js-object :maxSlots 512 :initialBytes 65536 :maxBytes 1048576))))
      (js-call a :auto 1)
      (let* ((source (JSON/stringify (Array/from (js-object :length 100) (lambda () (js-object :label "same" :value 42 :items (js-array))))))
             (input (js-call a :string source))
             (out (js-call a :invoke "parse" (js-array input))))
        (js-call assert :equal (js-call a :length out) 100)
        (js-call a :release input)
        (js-call a :release out)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))
      (let* ((text "[0,-0,-1e-9999,1e9999,-1e9999,5e-324,9007199254740993]")
             (s (js-call a :string text))
             (value (js-call a :invoke "parse" (js-array s)))
             (parsed (JSON/parse text)))
        (js-call parsed :forEach
          (lambda (n i)
            (let ((item (js-call a :get value i)))
              (funcall assert (Object/is (js-call a :readNumber item) n))
              (js-call a :release item))))
        (js-call a :release s)
        (js-call a :release value)
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (main))
