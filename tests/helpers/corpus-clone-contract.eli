(module tests.helpers.corpus-clone-contract
  (import "node:assert/strict" :default assert)
  (import "../../tools/backends/compiler-corpus.mjs" cloneCompilerCorpusData)
  (defun plainCloneGraph ()
    (let* ((shared (js-object :source "\uFEFF; 中😀\ud800\r\n(defconst value -0)" :number (js* "-0") :huge (js* "2n")
        :undefinedValue undefined :nan globalThis.NaN :infinity globalThis.Infinity))
           (array (new globalThis.Array 5)) (dictionary (Object/create nil)) (graph undefined))
      (put array 1 shared) (put array 3 shared) (put array :label "retained enumerable array property")
      (put dictionary "9" "nine") (put dictionary "2" "two") (put dictionary :after shared)
      (Object/defineProperty dictionary "__proto__" (js-object :value shared :enumerable t))
      (Object/defineProperty dictionary "hidden" (js-object :value (js-object :ignored t) :enumerable false))
      (Object/defineProperty dictionary (funcall globalThis.Symbol "ignored getter") (js-object :get (lambda () (throw (new globalThis.Error "symbol getter must not run"))) :enumerable t))
      (setq graph (js-object :array array :shared shared :dictionary dictionary)) (put graph :self graph) (put array 4 graph) graph))
  (defun checkPlain ()
    (let* ((source (plainCloneGraph)) (expected (globalThis.structuredClone source)) (actual (cloneCompilerCorpusData source)))
      (js-call assert :deepEqual actual expected)
      (js-call assert :deepEqual (Object/keys (get actual :dictionary)) (Object/keys (get expected :dictionary)))
      (js-call assert :deepEqual (Object/keys (get actual :array)) (Object/keys (get expected :array)))
      (js-call assert :equal (get actual :self) actual) (js-call assert :equal (aref (get actual :array) 4) actual)
      (js-call assert :equal (aref (get actual :array) 1) (aref (get actual :array) 3))
      (js-call assert :equal (get actual :shared) (get (get actual :dictionary) :__proto__)) (js-call assert :equal (get actual :shared) (aref (get actual :array) 1))
      (assert (not (Object/hasOwn (get actual :array) 0))) (assert (not (Object/hasOwn (get actual :array) 2)))
      (assert (not (Object/hasOwn (get actual :dictionary) "hidden")))
      (js-call assert :equal (Object/getPrototypeOf (get actual :dictionary)) (get globalThis.Object :prototype))
      (assert (Object/is (get (get actual :shared) :number) (js* "-0"))) (js-call assert :equal (get (get actual :shared) :huge) (js* "2n"))
      (assert (Object/hasOwn (get actual :shared) "undefinedValue")) (js-call assert :equal (get (get actual :shared) :undefinedValue) undefined)
      (put (get actual :shared) :source "changed") (put (get actual :dictionary) :extra 1) (js-call (get actual :array) :push "new")
      (js-call assert :equal (get (get source :shared) :source) "\uFEFF; 中😀\ud800\r\n(defconst value -0)")
      (assert (not (Object/hasOwn (get source :dictionary) "extra"))) (js-call assert :equal (get (get source :array) :length) 5)))
  (defun checkNodeFallback ()
    (let* ((value (plainCloneGraph)) (copy (cloneCompilerCorpusData value)))
      (js-call assert :deepEqual copy (globalThis.structuredClone value))
      (js-call assert :equal (get copy :self) copy) (js-call assert :equal (aref (get copy :array) 4) copy)
      (js-call assert :equal (get copy :shared) (get (get copy :dictionary) :__proto__))
      (js-call assert :equal (get copy :shared) (aref (get copy :array) 1))
      (js-call assert :equal (aref (get copy :array) 1) (aref (get copy :array) 3))
      (assert (Object/is (get (get copy :shared) :number) (js* "-0")))
      (put (get copy :shared) :source "changed") (js-call assert :notEqual (get (get copy :shared) :source) (get (get value :shared) :source)))
    (let ((visits 0) (getter (js-object)))
      (Object/defineProperty getter "source" (js-object :enumerable t :get (lambda () (setq visits (1+ visits)) "source")))
      (js-call assert :deepEqual (cloneCompilerCorpusData getter) (js-object :source "source")) (js-call assert :equal visits 1))
    (let* ((shared (js-object :text "source")) (special (js-object :shared shared :map (new globalThis.Map (js-array (js-array "same" shared)))))
           (fallback (cloneCompilerCorpusData special)))
      (js-call assert :deepEqual fallback (globalThis.structuredClone special)) (js-call assert :equal (get fallback :shared) (js-call (get fallback :map) :get "same"))))
  (export plainCloneGraph checkPlain checkNodeFallback))
