(module tests.helpers.compiler-source-archive-bounded-host
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:fs" createReadStream)
  (import "node:os" tmpdir)
  (import "node:path" join)
  (import "node:crypto" createHash)
  (import "node:buffer" Buffer)
  (import "node:process" :default process)
  (import "../../tools/backends/compiler-corpus-source-archive.mjs" archiveCompilerCorpusSources)

  ;; Keep only one quoted source and the current module's few JSON fragments.
  ;; The independently expected recipe is never joined into an aggregate copy.
  (defun expected-parts (modules quoted)
    (let ((pending (js-array "{\"id\":\"bounded\",\"kind\":\"project\",\"modules\":["))
          (position 0) (index 0) (suffix false))
      (js-object :next
        (lambda ()
          (when (= position (js-length pending))
            (cond
              ((< index (js-length modules))
                (let ((module (aref modules index)))
                  (setq pending (js-array
                    (str "{\"id\":" (JSON/stringify (get module :id)) ",\"filename\":"
                      (JSON/stringify (get module :filename)) ",\"source\":") quoted "}"))
                  (when (> index 0) (js-call pending :unshift ",")))
                (setq position 0 index (1+ index)))
              ((not suffix)
                (setq suffix t position 0 pending (js-array "],\"expected\":{\"kind\":\"value\",\"value\":-0}}\n")))))
          (if (= position (js-length pending)) (js-object :done t :value undefined)
            (let ((value (aref pending position)))
              (setq position (1+ position)) (js-object :done false :value value)))))))

  (defasync runBoundedCompilerSourceArchive ()
    (let ((directory (await (mkdtemp (join (tmpdir) "eliscript-bounded-source-")))))
      (try
        (let* ((source (js-call "; complete source\n" :repeat 131072)) (count 24)
               (modules (Array/from (js-object :length count)
                          (lambda (_ index) (js-object :id (str "m" index ".mjs") :filename (str "f" index ".eli") :source source))))
               (record (js-object :id "bounded" :kind "project" :modules modules :expected (js-object :kind "value" :value -0)))
               (identity (await (archiveCompilerCorpusSources record directory)))
               (quoted (JSON/stringify source)) (parts (expected-parts modules quoted))
               (part (js-call parts :next)) (offset 0) (total 0) (hash (createHash "sha256"))
               (stream (createReadStream (join directory "record.json") (js-object :highWaterMark 65536)))
               (iterator (Reflect/apply (get stream globalThis.Symbol.asyncIterator) stream (js-array)))
               (next (get iterator :next)) (done false) (body-active false))
          (try
            (while (not done)
              (setq body-active false)
              (let ((step (await (Reflect/apply next iterator (js-array)))))
                (setq done (get step :done))
                (unless done
                  (setq body-active t)
                  (let ((bytes (get step :value)) (at 0))
                    (js-call hash :update bytes)
                    (setq total (+ total (js-length bytes)))
                    (while (< at (js-length bytes))
                      (while (and (not (get part :done)) (= offset (js-length (get part :value))))
                        (setq part (js-call parts :next) offset 0))
                      (funcall assert (not (get part :done)) "record has unexpected trailing bytes")
                      (let ((size (Math/min (- (js-length bytes) at) (- (js-length (get part :value)) offset))))
                        (js-call assert :equal (js-call (js-call bytes :subarray at (+ at size)) :toString "utf8")
                          (js-call (get part :value) :slice offset (+ offset size)))
                        (setq offset (+ offset size) at (+ at size)))))
                  (setq body-active false))))
            (catch error
              (when body-active
                (try
                  (let ((close (get iterator :return)))
                    (unless (nullish? close) (await (Reflect/apply close iterator (js-array)))))
                  (catch ignored nil)))
              (throw error)))
          (while (and (not (get part :done)) (= offset (js-length (get part :value))))
            (setq part (js-call parts :next) offset 0))
          (funcall assert (get part :done) "record was truncated")
          (js-call assert :equal (get (get identity :record) :bytes) total)
          (js-call assert :equal (get (get identity :record) :sha256) (js-call hash :digest "hex"))
          (let ((index 0))
            (while (< index count)
              (let* ((entry (aref (get identity :modules) index))
                     (bytes (await (readFile (join directory (get (get entry :asset) :path))))))
                (js-call assert :equal (get entry :id) (get (aref modules index) :id))
                (js-call assert :equal (get entry :filename) (get (aref modules index) :filename))
                (js-call assert :equal (js-call bytes :toString "utf8") source)
                (js-call assert :equal (get (get entry :asset) :bytes) (js-length bytes))
                (js-call assert :equal (get (get entry :asset) :sha256)
                  (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
                (js-call assert :equal (get entry :bytes) (* (js-length source) 2))
                (js-call assert :equal (get entry :sha256)
                  (js-call (js-call (createHash "sha256") :update (Buffer/from source "utf16le")) :digest "hex")))
              (setq index (1+ index))))
          (js-call assert :equal (js-length modules) count)
          (funcall assert (Object/is (get (get record :expected) :value) -0))
          (js-call (get process :stdout) :write "all source recipe and asset bytes preserved"))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (export runBoundedCompilerSourceArchive))
