(module tests.helpers.wasm-managed-json-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:process" :default process)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defun observe-ref (trace)
    (let ((reads (get trace :reads))
          (calls (get trace :calls))
          (getter-this (get trace :getterThis))
          (call-this (get trace :callThis))
          (extra (get trace :extra)))
      (js-object
        :order (get trace :order)
        :reads (if (nullish? reads) 0 reads)
        :calls (if (nullish? calls) 0 calls)
        :getterThis (if (nullish? getter-this) false getter-this)
        :callThis (if (nullish? call-this) false call-this)
        :extra (if (nullish? extra) nil extra))))

  (defun check-namespace-reference (mod)
    (js-call assert :equal (js-call mod :namespace_cold_identities) t)
    (js-call assert :equal (js-call mod :namespace_escaped_identities) t)
    (let ((records (js-array))
          (keys (js-array "parse" "stringify" "rawJSON" "isRawJSON"))
          (idx 0))
      (while (< idx (get keys :length))
        (let* ((key (aref keys idx))
               (descriptor (js-call mod :namespace_descriptor key))
               (callable (get descriptor :value))
               (expected-len (cond ((= key "parse") 2) ((= key "stringify") 3) (t 1))))
          (js-call assert :equal (js-call mod :namespace_metadata_valid key descriptor) t)
          (js-call assert :equal (get callable :name) key)
          (js-call assert :equal (get callable :length) expected-len)
          (js-call assert :deepEqual
            (js-array (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable))
            (js-array t false t))
          (try
            (let ((captured (js-object :mutate t))
                  (noncallable (js-object))
                  (deleted (js-object)))
              (js-call mod :namespace_install key captured t)
              (js-call assert :equal (js-call mod :namespace_call key captured "payload") "payload")
              (js-call assert :equal (js-call mod :namespace_read key) nil)
              (js-call assert :deepEqual
                (observe-ref captured)
                (js-object :order "gaec" :reads 1 :calls 1 :getterThis t :callThis t :extra 37))
              (js-call mod :namespace_restore key descriptor)
              (js-call assert :equal (js-call mod :namespace_escaped_identities) t)
              (js-call mod :namespace_install key noncallable false)
              (js-call assert :throws
                (lambda () (js-call mod :namespace_call key noncallable "payload"))
                globalThis.TypeError)
              (js-call assert :deepEqual
                (observe-ref noncallable)
                (js-object :order "gae" :reads 1 :calls 0 :getterThis t :callThis false :extra nil))
              (js-call mod :namespace_restore key descriptor)
              (js-call assert :equal (js-call mod :namespace_delete key) t)
              (js-call assert :equal (js-call mod :namespace_own key) false)
              (js-call assert :equal (js-call mod :namespace_read key) undefined)
              (js-call assert :throws
                (lambda () (js-call mod :namespace_call key deleted "payload"))
                globalThis.TypeError)
              (js-call assert :equal (js-call mod :namespace_own key) false)
              (js-call assert :equal (js-call mod :namespace_read key) undefined)
              (js-call assert :deepEqual
                (observe-ref deleted)
                (js-object :order "ae" :reads 0 :calls 0 :getterThis false :callThis false :extra nil))
              (js-call records :push
                (js-object
                  :key key
                  :captured (observe-ref captured)
                  :noncallable (observe-ref noncallable)
                  :deleted (observe-ref deleted))))
            (finally
              (js-call mod :namespace_restore key descriptor)))
          (js-call assert :equal (js-call mod :namespace_escaped_identities) t))
        (setq idx (+ idx 1)))
      records))

  (defasync run-cli ()
    (let* ((argv (get process :argv))
           (mode (aref argv 2)))
      (cond
        ((= mode "--check-source")
         (let ((m (await (funcall dyn-import (aref argv 3)))))
           (funcall assert (Object/is (js-call m :parse_value "-0") -0.0))
           (js-call assert :equal
             (js-call m :canonical_value "{\"b\":1,\"1\":2,\"b\":3}")
             "{\"1\":2,\"b\":3}")
           (js-call assert :equal
             (Object/hasOwn (js-call m :parse_value "{\"__proto__\":7}") "__proto__")
             t)
           (js-call assert :equal (js-call m :stringify_value undefined) undefined)))
        ((= mode "--check-models")
         (let ((records (JSON/parse (readFileSync (aref argv 3) "utf8"))))
           (js-call records :forEach
             (lambda (r)
               (let ((text (get r :text)))
                 (js-call assert :equal (JSON/stringify (JSON/parse text)) (get r :expected))
                 (js-call assert :throws
                   (lambda () (JSON/parse (str text "#")))
                   globalThis.SyntaxError))))))
        ((= mode "--check-wasm")
         (let* ((rt-mod (await (funcall dyn-import (aref argv 3))))
                (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
                (a (funcall instantiateManagedRuntime (readFileSync (aref argv 4))))
                (cases (JSON/parse (readFileSync (aref argv 5) "utf8"))))
           (js-call a :auto 1)
           (js-call (get cases :valid) :forEach
             (lambda (text)
               (let* ((input (js-call a :string text))
                      (out (js-call a :invoke "canonical-value" (js-array input))))
                 (js-call assert :equal
                   (js-call a :readString out)
                   (JSON/stringify (JSON/parse text))
                   text)
                 (js-call a :release input)
                 (js-call a :release out)
                 (js-call a :collect)
                 (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
           (js-call (get cases :invalid) :forEach
             (lambda (text)
               (js-call assert :throws (lambda () (JSON/parse text)) globalThis.SyntaxError)
               (let ((input (js-call a :string text)))
                 (js-call assert :throws
                   (lambda () (js-call a :invoke "parse-value" (js-array input)))
                   (lambda (e)
                     (let ((diag (if (nullish? e) undefined (get e :eliscriptDiagnostic))))
                       (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
                 (js-call a :release input))))
           (let* ((x (js-call a :string "-0"))
                  (out (js-call a :invoke "parse-value" (js-array x))))
             (funcall assert (Object/is (js-call a :readNumber out) -0.0))
             (js-call a :release x)
             (js-call a :release out)
             (js-call a :closeModule)
             (js-call a :collect)
             (js-call assert :equal (js-call a :live) 0)
             (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
        ((= mode "--check-namespace")
         (let* ((mod (await (funcall dyn-import (aref argv 3))))
                (records (check-namespace-reference mod)))
           (console/log (JSON/stringify records)))))))

  (let ((mode (aref (get process :argv) 2)))
    (when (or (= mode "--check-source")
              (= mode "--check-models")
              (= mode "--check-wasm")
              (= mode "--check-namespace"))
      (js-call (run-cli) :catch
        (lambda (err)
          (console/error err)
          (js-call process :exit 1)))))

  (export check-namespace-reference))
