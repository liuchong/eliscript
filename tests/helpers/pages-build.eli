(module tests.helpers.pages-build
  (import "node:path" resolve dirname)
  (import "node:url" fileURLToPath)
  (defconst ROOT (resolve (dirname (fileURLToPath (js* "import.meta.url"))) "../.."))
  (defconst host-truth (js* "(value) => !!value"))
  (defvar build undefined)
  ;; Retain one complete fresh Pages build per suite; no old checkout products.
  (defun buildPagesInputs ()
    (when (nullish? build)
      (setq build (funcall (async ()
        (let ((scripts (js-array "build:browser-playground" "build:browser" "build:docs-site" "dogfood")) (index 0))
          (while (< index (js-length scripts))
            (let* ((script (aref scripts index)) (child (Bun/spawn (js-array "bun" "run" script) (js-object :cwd ROOT :stdout "pipe" :stderr "pipe")))
                   (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text)
                                                       (js-call (new globalThis.Response (get child :stderr)) :text))))))
              (unless (= (aref result 0) 0)
                (let ((stderr (js-call (aref result 2) :trim)) (stdout (js-call (aref result 1) :trim)))
                  (throw (new globalThis.Error (str script " failed: " (if (funcall host-truth stderr) stderr stdout)))))))
            (setq index (1+ index)))) undefined)))) build)
  (export buildPagesInputs))
