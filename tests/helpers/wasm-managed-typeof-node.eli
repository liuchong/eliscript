(module tests.helpers.wasm-managed-typeof-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:process" :default process)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defasync run-main ()
    (let ((mode (aref (get process :argv) 2)))
      (cond
        ((= mode "js")
         (let ((m (await (funcall dynamic-import (aref (get process :argv) 3)))))
           (js-call
             (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Infinity globalThis.Number.MIN_VALUE "中😀\ud800" (js-object) (js-array) (lambda () 1))
             :forEach
             (lambda (x)
               (let ((expected (funcall js-typeof x)))
                 (js-call assert :equal (js-call m :type_value x) expected)
                 (js-call assert :equal (js-call m :type_member (js-object :item x)) expected)
                 (js-call assert :equal (js-call m :invoke (js-call m :capture x)) expected)
                 (js-call assert :equal (js-call m :type_underscore x) expected))))
           (js-call assert :equal (js-call m :type_member (js-object)) "undefined")
           (js-call assert :throws (lambda () (js-call m :type_member nil)) globalThis.TypeError)
           (js-call assert :throws (lambda () (js-call m :type_deep (js-object))) globalThis.TypeError)))
        ((= mode "wasm")
         (let* ((rt-mod (await (funcall dynamic-import (aref (get process :argv) 3))))
                (instantiate (get rt-mod :instantiateManagedRuntime))
                (a (funcall instantiate (readFileSync (aref (get process :argv) 4)))))
           (js-call a :auto 1)
           (let* ((n (js-call a :number -0.0))
                  (box (js-call a :invoke "make-box" (js-array n)))
                  (label (js-call a :invoke "type-member" (js-array box)))
                  (fn (js-call a :getExport "type-value"))
                  (callable (js-call a :invoke "type-value" (js-array fn)))
                  (captured (js-call a :invoke "capture" (js-array n)))
                  (result (js-call a :invoke "invoke" (js-array captured))))
             (js-call assert :equal (js-call a :readString label) "number")
             (js-call assert :equal (js-call a :readString callable) "function")
             (js-call assert :equal (js-call a :readString result) "number")
             (funcall assert (Object/is (js-call a :readNumber n) -0.0))
             (js-call (js-array n box label fn callable captured result) :forEach (lambda (x) (js-call a :release x)))
             (js-call a :closeModule)
             (js-call a :collect)
             (js-call assert :equal (js-call a :live) 0)
             (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
        (t (throw (new globalThis.Error (str "unknown mode: " mode)))))))

  (run-main))
