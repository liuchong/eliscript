(module tests.helpers.wasm-managed-native-prototype-callables-node
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defasync run-node-oracle (module-url)
    (let* ((m (await (funcall dyn-import module-url)))
           (bigint (globalThis.BigInt "12345678901234567890"))
           (dec (js-call bigint :toString))
           (hex (js-call bigint :toString 16))
           (bin (js-call bigint :toString 2))
           (b36 (js-call bigint :toString 36))
           (expected
             (js-array
               (js-array t t dec dec bin b36 "toString" 1)
               (js-array dec hex)
               (js-array "TypeError" (js-array))
               (js-array hex (js-array "radix"))
               (js-array t (js-array "throw"))
               (js-array hex (js-array "receiver" "argument" "extra" "radix"))
               (js-array hex "replacement")
               (js-array "TypeError" (js-array))
               (js-array "RangeError" "RangeError" "RangeError" "RangeError" "TypeError"))))
      (js-call assert :deepEqual
        (js-call (JSON/parse (js-call m :collections)) :slice 0 4)
        (js-array t 2 2 (js-array (js-array 1 "a" t) (js-array 2 "b" t))))
      (js-call assert :deepEqual
        (js-call (JSON/parse (js-call m :iterators)) :slice 0 4)
        (js-array
          (js-object :value (js-array "a" 1) :done false)
          (js-object :value (js-array "b" 2) :done false)
          (js-object :done t)
          (js-object :done t)))
      (js-call assert :equal (await (js-call m :promise_suite 0)) "[1,2,3]")
      (js-call assert :equal (await (js-call m :promise_suite 2)) "[\"AggregateError\",[]]")
      (js-call assert :equal (await (js-call m :promise_suite 4)) "[true,7]")
      (js-call assert :equal (await (js-call m :foreign_then (Promise/resolve 8))) 11)
      (let ((mode 0))
        (while (< mode (get expected :length))
          (js-call assert :deepEqual
            (JSON/parse (js-call m :bigint_call_path mode))
            (aref expected mode)
            (str "independent BigInt borrowed call mode " mode))
          (setq mode (+ mode 1))))))

  (when (= (aref (get process :argv) 2) "--run-node-check")
    (js-call (run-node-oracle (aref (get process :argv) 3)) :catch
      (lambda (err)
        (console/error err)
        (js-call process :exit 1))))

  (export run-node-oracle))
