(module tests.helpers.reader-host-oracle
  (import "node:assert/strict" :default assert)
  ;; Original reader host semantics deliberately use JavaScript primitive
  ;; operators for strict predicates, JS callback truth, and += coercion.
  ;; The scanning, state snapshots and writeback algorithms are Eli.
  (defconst add (js* "(left, right) => left + right"))
  (defconst less (js* "(left, right) => left < right"))
  (defconst greater (js* "(left, right) => left > right"))
  (defconst truth (js* "(value) => !!value"))
  (defconst receiverFunction (js* "(implementation) => function(...args) { return implementation(this,args); }"))
  (defun whitespace (code) (or (eq code 32) (eq code 9) (eq code 10) (eq code 13) (eq code 12)))
  (defun delimiter (code) (or (eq code undefined) (whitespace code) (js-call (js-array 40 41 91 93 123 125 34 39 44 59 96) :includes code)))
  (defun skip (state whitespace)
    (let* ((source (get state :source)) (index (get state :index)) (offset (get state :offset)) (line (get state :line)) (column (get state :column)) (done false))
      (while (and (not done) (funcall less index (get source :length)))
        (let ((code (js-call source :codePointAt index)))
          (cond ((funcall truth (funcall whitespace code))
            (setq index (funcall add index 1) offset (funcall add offset 1))
            (if (eq code 10) (setq line (funcall add line 1) column 1) (setq column (funcall add column 1))))
            ((eq code 59)
              (while (and (funcall less index (get source :length)) (not (eq (js-call source :charCodeAt index) 10)))
                (setq index (funcall add index (if (funcall greater (js-call source :codePointAt index) 65535) 2 1))
                  offset (funcall add offset 1) column (funcall add column 1))))
            (t (setq done t)))))
      (put state :index index) (put state :offset offset) (put state :line line) (put state :column column) nil))
  (defun token (state start delimiter)
    (let* ((source (get state :source)) (index (get state :index)) (consumed 0) (done false))
      (while (not done)
        (let ((code (js-call source :codePointAt index)))
          (if (funcall truth (funcall delimiter code)) (setq done t)
            (setq index (funcall add index (if (funcall greater code 65535) 2 1)) consumed (1+ consumed)))))
      (put state :index index) (put state :offset (funcall add (get state :offset) consumed)) (put state :column (funcall add (get state :column) consumed))
      (js-call source :slice (get start :index) index)))
  (defun traced (mode &rest __host_default_arguments_1)
    (let* ((options (aref __host_default_arguments_1 0)))
    (let* ((options (if (= options undefined) (js-object) options))
           (text (if (= (get options :text) undefined) " ;😀comment\n\tx" (get options :text)))
           (failure (if (= (get options :failure) undefined) nil (get options :failure)))
           (answer (if (= (get options :answer) undefined) nil (get options :answer)))
           (changes (if (= (get options :changes) undefined) false (get options :changes)))
           (events (js-array)) (data (js-object :index 0 :offset 11 :line 3 :column 7)) (source undefined) (calls 0))
      (setq source (new globalThis.Proxy (js-object) (js-object :get (lambda (unused key)
        (js-call events :push (str "source.get:" (funcall globalThis.String key)))
        (when (= failure (str "source." (funcall globalThis.String key))) (throw (new globalThis.Error failure)))
        (cond ((= key "length") (get text :length))
          ((js-call (js-array "codePointAt" "charCodeAt" "slice") :includes key)
            (funcall receiverFunction (lambda (self args)
              (js-call assert :equal self source)
              (js-call events :push (str "source.call:" (funcall globalThis.String key) ":" (js-call (js-call args :map (lambda (value) (funcall globalThis.String value))) :join ",")))
              (Reflect/apply (get (get globalThis.String :prototype) key) text args))))
          (t undefined))))))
      (put data :source source)
      (let* ((state (new globalThis.Proxy data (js-object
               :get (lambda (target key)
                 (js-call events :push (str "state.get:" (funcall globalThis.String key)))
                 (when (= failure (str "get." (funcall globalThis.String key))) (throw (new globalThis.Error failure))) (get target key))
               :set (lambda (target key value)
                 (js-call events :push (str "state.set:" (funcall globalThis.String key) ":" (funcall globalThis.String value)))
                 (when (= failure (str "set." (funcall globalThis.String key))) (throw (new globalThis.Error failure))) (put target key value) t))))
             (begin (new globalThis.Proxy (js-object :index 0) (js-object :get (lambda (target key)
               (js-call events :push (str "start.get:" (funcall globalThis.String key)))
               (when (= failure (str "start." (funcall globalThis.String key))) (throw (new globalThis.Error failure)))
               (when changes (put data :index 999)) (get target key)))))
             (callback (funcall receiverFunction (lambda (self args)
               (js-call assert :equal self undefined)
               (let ((code (aref args 0)))
                 (js-call events :push (str "callback:" (funcall globalThis.String code))) (setq calls (1+ calls))
                 (when (= failure "callback") (throw (new globalThis.Error failure)))
                 (when changes (put data :offset 100) (put data :column 200) (put data :source "changed"))
                 (if (eq code undefined) t (if (eq answer nil) (if (= mode "skip") (whitespace code) (delimiter code)) answer)))))))
        (js-object :state state :begin begin :callback callback :events events :observe (lambda ()
          (js-object :index (get data :index) :offset (get data :offset) :line (get data :line) :column (get data :column)
            :source (if (= (get data :source) source) "original" (get data :source)) :calls calls)))))))
  (defun observeTrace (fn mode options)
    (let ((trace (traced mode options)) (result undefined) (error undefined))
      (try (setq result (if (= mode "skip") (funcall fn (get trace :state) (get trace :callback)) (funcall fn (get trace :state) (get trace :begin) (get trace :callback))))
        (catch e (setq error (js-array (get (get e :constructor) :name) (get e :message)))))
      (js-object :result result :error error :events (get trace :events) :state (funcall (get trace :observe)))))
  (export whitespace delimiter skip token observeTrace))
