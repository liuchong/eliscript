(module tests.helpers.wasm-managed-float64-words-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defun box (a value)
    (cond
      ((= (value-type value) "number") (js-call a :number value))
      ((= (value-type value) "string") (js-call a :string value))
      (t value)))

  (defun read (a v)
    (cond
      ((and v (= (get v :kind) 4)) (js-call a :readNumber v))
      ((and v (= (get v :kind) 5)) (js-call a :readString v))
      ((and v (= (get v :kind) 14))
       (let ((out (js-array))
             (i 0))
         (while (< i (js-call a :length v))
           (let ((child (js-call a :get v i)))
             (try (js-call out :push (read a child)) (finally (js-call a :release child))))
           (setq i (1+ i)))
         out))
      (t v)))

  (defun run (a name &rest __host_default_arguments_1)
    (let* ((args-list (aref __host_default_arguments_1 0)))
    (let* ((args (if (undefined? args-list) (js-array) args-list))
           (out (js-call a :invoke name args)))
      (try (read a out) (finally (js-call a :release out))))))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((roots-list (aref __host_default_arguments_2 0)))
    (let ((roots (if (undefined? roots-list) (js-array) roots-list)))
      (js-call roots :forEach (lambda (v) (js-call a :release v)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defun oracle (value)
    (let ((bytes (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call bytes :setFloat64 0 (if (= value 0) 0 value) t)
      (js-array (js-call bytes :getUint32 0 t) (js-call bytes :getUint32 4 t))))

  (defasync main ()
    (let* ((rt-mod (await (dynamic-import (aref (get globalThis.process :argv) 2))))
           (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
           (bytes (readFileSync (aref (get globalThis.process :argv) 3))))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let* ((a (funcall instantiateManagedRuntime bytes))
             (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (seed 325236553)
             (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223))))))
        (js-call a :auto 1)
        (let ((i 0))
          (while (< i 128)
            (js-call view :setUint32 0 (funcall next) t)
            (js-call view :setUint32 4 (funcall next) t)
            (let* ((value (js-call view :getFloat64 0 t))
                   (input (js-call a :number value)))
              (js-call assert :deepEqual (run a "words" (js-array input)) (oracle value))
              (js-call a :release input))
            (setq i (1+ i))))
        (js-call (js-array -0.0 "-0" undefined nil t globalThis.NaN globalThis.Infinity) :forEach
          (lambda (value)
            (let ((input (box a value)))
              (js-call assert :deepEqual (run a "words" (js-array input)) (oracle value))
              (js-call a :release input))))
        (let ((trace (js-call a :sourceArray (js-array))))
          (js-call assert :deepEqual (run a "primitive" (js-array trace)) (oracle (js-object :valueOf (lambda () -0.0))))
          (js-call assert :deepEqual (read a trace) (js-array "number"))
          (js-call a :release trace))
        (js-call assert :deepEqual (run a "missing") (oracle undefined))
        (finish a))))

  (main))
