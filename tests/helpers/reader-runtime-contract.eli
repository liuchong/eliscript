(module tests.helpers.reader-runtime-contract
  (import "node:assert/strict" :default assert)
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defun box (a v) (cond ((= (funcall hostTypeof v) "number") (js-call a :number v)) ((= (funcall hostTypeof v) "string") (js-call a :string v)) (t v)))
  (defun decode (a v) (cond ((and (not (nullish? v)) (= (get v :kind) 4)) (js-call a :readNumber v)) ((and (not (nullish? v)) (= (get v :kind) 5)) (js-call a :readString v)) (t v)))
  (defun state (a source &rest __host_default_arguments_1)
    (let* ((index (aref __host_default_arguments_1 0)) (offset (aref __host_default_arguments_1 1)) (line (aref __host_default_arguments_1 2)) (column (aref __host_default_arguments_1 3)))
    (when (= index undefined) (setq index 0)) (when (= offset undefined) (setq offset 11)) (when (= line undefined) (setq line 3)) (when (= column undefined) (setq column 7))
    (let* ((roots (js-array (js-call a :string source) (box a index) (box a offset) (box a line) (box a column)))
           (keys (js-array "source" "index" "offset" "line" "column"))
           (object (js-call a :sourceObject (Object/fromEntries (js-call keys :map (lambda (key i) (js-array key (aref roots i))))))))
      (js-call roots :forEach (lambda (v) (js-call a :release v))) object)))
  (defun readState (a object)
    (let ((out (js-object)))
      (js-call (js-array "source" "index" "offset" "line" "column") :forEach (lambda (key)
        (let* ((name (js-call a :string key)) (value (js-call a :objectGet object name)))
          (put out key (decode a value)) (js-call a :release name) (js-call a :release value))))
      out))
  (defun start (a index)
    (let* ((value (box a index)) (object (js-call a :sourceObject (js-object :index value)))) (js-call a :release value) object))
  (defun finish (a &rest __host_default_arguments_2)
    (let* ((values (aref __host_default_arguments_2 0)) (module (aref __host_default_arguments_2 1)))
    (when (= values undefined) (setq values (js-array))) (when (= module undefined) (setq module t))
    (js-call values :forEach (lambda (v) (js-call a :release v))) (when module (js-call a :closeModule)) (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
  (export box decode state readState start finish))
