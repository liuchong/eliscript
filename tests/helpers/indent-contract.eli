(module tests.helpers.indent-contract
  (import "node:assert/strict" :default assert)
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst native-add (js* "(left, right) => left + right"))
  (defconst native-ge (js* "(left, right) => left >= right"))
  (defconst native-lt (js* "(left, right) => left < right"))
  (defconst native-method (js* "(implementation) => function(...args) { return implementation(this, args); }"))
  (defun oracle (input)
    (let* ((source (get input :text)) (sourceMarks (get input :marks)) (parts (js-call source :split "\n"))
           (marks (js-array)) (start 0) (added 0) (markIndex 0) (mark (aref sourceMarks 0)) (index 0))
      (while (< index (get parts :length))
        (let* ((line (aref parts index)) (end (funcall native-add (funcall native-add start (get line :length)) (if (< (+ index 1) (get parts :length)) 1 0))))
          (when (> (get line :length) 0) (put parts index (funcall native-add "  " line)) (setq added (+ added 2)))
          (while (and (not (= mark undefined)) (funcall native-ge (get mark :offset) start) (funcall native-lt (get mark :offset) end))
            (js-call marks :push (js-object :offset (funcall native-add (get mark :offset) added) :span (get mark :span)))
            (setq markIndex (1+ markIndex) mark (aref sourceMarks markIndex)))
          (setq start end))
        (setq index (1+ index)))
      (js-object :text (js-call parts :join "\n") :marks marks)))
  (defun box (a value)
    (cond ((= (funcall host-typeof value) "number") (js-call a :number value))
      ((= (funcall host-typeof value) "string") (js-call a :string value))
      ((or (= value nil) (= value undefined) (= (funcall host-typeof value) "boolean")) value)
      (t
        (let* ((children (if (Array/isArray value) (js-call value :map (lambda (v) (box a v)))
          (Object/fromEntries (js-call (Object/entries value) :map (lambda (entry) (js-array (aref entry 0) (box a (aref entry 1))))))))
               (result (if (Array/isArray value) (js-call a :sourceArray children) (js-call a :sourceObject children))))
          (js-call (Object/values children) :forEach (lambda (v) (js-call a :release v))) result))))
  (defun read (a value)
    (cond ((or (= value nil) (= value undefined) (= (funcall host-typeof value) "boolean")) value)
      ((= (get value :kind) 4) (js-call a :readNumber value)) ((= (get value :kind) 5) (js-call a :readString value))
      ((js-call (js-array 7 14) :includes (get value :kind))
        (Array/from (js-object :length (js-call a :length value)) (lambda (unused index)
          (let ((x (js-call a :get value index))) (try (read a x) (finally (js-call a :release x)))))))
      (t
        (let ((keys (js-call a :objectKeys value)) (result (js-object)) (index 0))
          (try
            (while (< index (js-call a :length keys))
              (let ((key (js-call a :get keys index)))
                (try (let ((x (js-call a :objectGet value key)))
                  (try (put result (js-call a :readString key) (read a x)) (finally (js-call a :release x))))
                  (finally (js-call a :release key))))
              (setq index (1+ index)))
            (finally (js-call a :release keys)))
          result))))
  (defun invoke (a input)
    (let ((argument (box a input)))
      (try (let ((out (js-call a :invoke "native-indent" (js-array argument))))
        (try (read a out) (finally (js-call a :release out))))
        (finally (js-call a :release argument)))))
  (defun finish (a) (js-call a :closeModule) (js-call a :collect) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0) (js-call assert :equal (js-call a :live) 0))
  (defun field (object key getter)
    (Object/defineProperty object key (js-object :enumerable t :configurable t :get getter)))
  (defun changingInput ()
    (let ((trace (js-array)) (calls 0) (mark (js-object)) (source (js-object)) (input (js-object)))
      (field mark "offset" (lambda () (js-call trace :push "offset") (let ((old calls)) (setq calls (1+ calls)) (if (< old 2) 0 "0"))))
      (field mark "span" (lambda () (js-call trace :push "span") "value"))
      (let ((marks (new globalThis.Proxy (js-array mark) (js-object :get (lambda (target key receiver)
        (js-call trace :push (str "marks:" (funcall globalThis.String key))) (Reflect/get target key receiver))))))
        (put source :split (lambda (separator)
          (js-call trace :push (str "split:" separator))
          (new globalThis.Proxy (js-array "a" "b") (js-object
            :get (lambda (target key receiver) (js-call trace :push (str "parts:" (funcall globalThis.String key))) (Reflect/get target key receiver))
            :set (lambda (target key value receiver) (js-call trace :push (str "set:" (funcall globalThis.String key))) (Reflect/set target key value receiver))))))
        (field input "text" (lambda () (js-call trace :push "text") source))
        (field input "marks" (lambda () (js-call trace :push "marks") marks)))
      (js-object :trace trace :input input)))
  (defun observed (fn failure)
    (let ((events (js-array)) (reads 0) (mark (js-object)) (line (js-object)) (text (js-object)) (input (js-object))
          (out undefined) (error undefined))
      (letfn ((hit (key &optional value)
        (js-call events :push key) (when (= key failure) (throw (new globalThis.RangeError key))) value))
        (field mark "offset" (lambda () (setq reads (1+ reads)) (hit (str "offset" reads) 0)))
        (field mark "span" (lambda () (hit "span" "kept")))
        (let ((marks (new globalThis.Proxy (js-array mark) (js-object :get (lambda (target key receiver)
          (hit (str "marks:" (funcall globalThis.String key))) (Reflect/get target key receiver))))))
          (field line "length" (lambda () (hit "line.length" 1)))
          (put line :valueOf (lambda () (hit "line.valueOf" "a")))
          (put line :toString (lambda () (hit "line.toString" "a")))
          (let ((parts (new globalThis.Proxy (js-array line "b") (js-object
            :get (lambda (target key receiver) (hit (str "parts:" (funcall globalThis.String key))) (Reflect/get target key receiver))
            :set (lambda (target key value receiver) (hit (str "parts.set:" (funcall globalThis.String key))) (Reflect/set target key value receiver))))))
            (field text "split" (lambda () (hit "split.get")
              (funcall native-method (lambda (this args) (let ((separator (aref args 0)))
                (js-call assert :equal this text) (hit (str "split.call:" separator)) parts)))))
            (field input "text" (lambda () (hit "text" text)))
            (field input "marks" (lambda () (hit "marks" marks)))
            (try (setq out (funcall fn input)) (catch e (setq error (js-array (get (get e :constructor) :name) (get e :message)))))))
        (js-object :out out :error error :events events))))
  (export oracle box read invoke finish changingInput observed)
)
