(module tests.helpers.array-text-contract
  (import "node:assert/strict" :default assert)
  (defconst hostInstanceof (js* "(value, constructor) => value instanceof constructor"))
  (defun call (capture values key &rest args) (Reflect/apply (funcall capture values key) undefined args))
  (defun diagnostic (error) (let ((info (get error :eliscriptDiagnostic))) (if (nullish? info) undefined (get info :code))))
  (defun observe (capture)
    (let* ((events (js-array)) (values (js-array nil "old" nil))
           (item (js-object :toString (lambda () (js-call events :push "item.toString") (put values 1 "changed") (js-object))
             :valueOf (lambda () (js-call events :push "item.valueOf") "first")))
           (separator (js-object :toString (lambda () (js-call events :push "separator") (js-call values :push "ignored") "|"))))
      (put values 0 item)
      (Object/defineProperty values 2 (js-object :get (lambda () (js-call events :push "get2") (new globalThis.String "boxed")) :configurable t))
      (let ((array (new globalThis.Proxy values (js-object :get (lambda (target key receiver) (js-call events :push (str "get:" (funcall globalThis.String key))) (Reflect/get target key receiver))))))
        (js-object :result (call capture array "join" separator) :events events))))
  (defun nativeCapture (values key) (lambda (&rest args) (Reflect/apply (get values key) values args)))
  (defun checkSemantics (capture)
    (js-call assert :deepEqual (observe capture) (observe nativeCapture))
    (js-call (js-array (js-array) (new globalThis.Array 4) (js-array "" "中😀" "\ud800")
      (js-array nil undefined t false globalThis.NaN (js* "-0") globalThis.Infinity (js* "1n"))
      (js-array (js-array 1 nil) (js-array "x")) (js-array "first" (new globalThis.String "boxed")))
      :forEach (lambda (values) (js-call assert :equal (call capture values "join" "|") (js-call values :join "|"))))
    (js-call assert :throws (lambda () (call capture (js-array (funcall globalThis.Symbol "x")) "join")) globalThis.TypeError)
    (let* ((calls 0) (object (js-object (get globalThis.Symbol :toPrimitive) (lambda (hint) (setq calls (1+ calls)) (js-call assert :equal hint "string") "opaque"))))
      (js-call assert :equal (call capture (js-array "a" object "b") "join" ":") "a:opaque:b") (js-call assert :equal calls 1)
      (let ((cyclic (js-array "a"))) (js-call cyclic :push cyclic)
        (js-call assert :throws (lambda () (call capture cyclic "join")) (lambda (error) (and (funcall hostInstanceof error globalThis.TypeError) (= (diagnostic error) "ELI-RT0009"))))
        (put cyclic :length 1) (js-call assert :equal (call capture cyclic "join") "a"))
      (let ((reentrant (js-array)))
        (Object/defineProperty reentrant 0 (js-object :get (lambda () (call capture reentrant "join")) :configurable t))
        (js-call assert :throws (lambda () (call capture reentrant "join")) (lambda (error) (= (diagnostic error) "ELI-RT0009")))
        (Reflect/deleteProperty reentrant 0) (js-call assert :equal (call capture reentrant "join") ""))
      (let ((bad (js-array "a" (js-object :toString (lambda () (throw object))))))
        (js-call assert :throws (lambda () (call capture bad "join")) (lambda (error) (= error object)))
        (js-call bad :pop) (js-call assert :equal (call capture bad "join") "a"))
      (let* ((mutable (js-array "a" "b")) (effects 0) (original (funcall capture mutable "join")))
        (put mutable :join (lambda () (throw (new globalThis.Error "must use captured method"))))
        (js-call assert :equal (funcall original (progn (setq effects (1+ effects)) "|") (let ((before effects)) (setq effects (1+ effects)) before)) "a|b")
        (js-call assert :equal effects 2))))
  (defun checkActiveFrames (capture)
    (let* ((events (js-array)) (values (js-array "a" "b"))
           (separator (js-object :toString (lambda () (js-call events :push "separator") (js-call events :push (call capture values "join" "")) "|"))))
      (js-call assert :equal (call capture values "join" separator) "a|b") (js-call assert :deepEqual events (js-array "separator" "ab")))
    (let* ((shared (js-array "x")) (outer (js-array shared shared)))
      (js-call assert :equal (call capture outer "join") "x,x") (js-call assert :equal (call capture shared "join") "x"))
    (let* ((first (js-array "safe")) (second (js-array (funcall globalThis.Symbol "bad")))
           (root (js-array (js-object :toString (lambda () (call capture second "join"))))))
      (js-call assert :throws (lambda () (call capture root "join")) globalThis.TypeError)
      (put second 0 "fixed") (js-call assert :equal (call capture root "join") "fixed") (js-call assert :equal (call capture first "join") "safe")
      (let ((recursive (js-array)))
        (js-call recursive :push (js-object :toString (lambda () (call capture second "join" (js-object :toString (lambda () (call capture recursive "join")))))))
        (js-call assert :throws (lambda () (call capture recursive "join")) (lambda (error) (= (diagnostic error) "ELI-RT0009")))
        (put recursive 0 "recovered") (js-call assert :equal (call capture recursive "join") "recovered") (js-call assert :equal (call capture second "join") "fixed"))))
  (export observe checkSemantics checkActiveFrames))
