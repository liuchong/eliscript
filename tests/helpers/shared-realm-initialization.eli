(module tests.helpers.shared-realm-initialization
  (import "node:assert/strict" :default assert)
  (defconst sharedRealmDeclarations "\n (defun realm-read (kind)\n  (cond ((= kind 0) (js* \"Object\")) ((= kind 1) (js* \"Number\")) (t (js* \"Array\"))))\n (defun realm-shared-observation ()\n  (let* ((object (realm-read 0)) (number (realm-read 1)) (array (realm-read 2))\n         (object-prototype (get object :prototype)) (number-prototype (get number :prototype))\n         (array-prototype (get array :prototype)) (keys (get object :keys))\n         (finite (get number :isFinite)) (is-array (get array :isArray)))\n   (try\n    (put object-prototype \"eliscript-shared-realm-probe\" -0.0)\n    (put number-prototype \"eliscript-shared-realm-probe\" 7)\n    (put array-prototype \"eliscript-shared-realm-probe\" 9)\n    (let ((again-object (realm-read 0)) (again-number (realm-read 1)) (again-array (realm-read 2)))\n     (JSON/stringify (js-array\n      (Object/is again-object object) (Object/is again-number number) (Object/is again-array array)\n      (Object/is (get again-object :prototype) object-prototype)\n      (Object/is (get again-number :prototype) number-prototype)\n      (Object/is (get again-array :prototype) array-prototype)\n      (Object/is (get (get again-object :prototype) \"eliscript-shared-realm-probe\") -0.0)\n      (get (get again-number :prototype) \"eliscript-shared-realm-probe\")\n      (get (get again-array :prototype) \"eliscript-shared-realm-probe\")\n      (Object/is (get again-object :keys) keys) (Object/is (get again-number :isFinite) finite)\n      (Object/is (get again-array :isArray) is-array)\n      (Object/is (get object-prototype :constructor) object)\n      (Object/is (get number-prototype :constructor) number)\n      (Object/is (get array-prototype :constructor) array))))\n    (finally\n     (Reflect/deleteProperty object-prototype \"eliscript-shared-realm-probe\")\n     (Reflect/deleteProperty number-prototype \"eliscript-shared-realm-probe\")\n     (Reflect/deleteProperty array-prototype \"eliscript-shared-realm-probe\")))))\n (defun realm-clean ()\n  (JSON/stringify (js-array\n   (Object/hasOwn (get (realm-read 0) :prototype) \"eliscript-shared-realm-probe\")\n   (Object/hasOwn (get (realm-read 1) :prototype) \"eliscript-shared-realm-probe\")\n   (Object/hasOwn (get (realm-read 2) :prototype) \"eliscript-shared-realm-probe\"))))\n (defun realm-first-error () (realm-read 0) (throw false) (realm-read 1))")
  (defun visitNodes (body visit)
    (let ((pending (js-array body)))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :pop)) (children (get node :children)) (index undefined))
          (funcall visit node) (setq index (- (js-length children) 1))
          (while (>= index 0) (js-call pending :push (aref children index)) (setq index (1- index)))))))
  (defun assertSharedRealmOutlining (lowered)
    (let* ((functions (get (get lowered :typed) :functions))
           (byIndex (new globalThis.Map (js-call functions :map (lambda (fn) (js-array (get fn :index) fn)))))
           (byName (new globalThis.Map (js-call functions :map (lambda (fn) (js-array (get fn :name) fn)))))
           (registration (js-call functions :find (lambda (fn) (= (get fn :name) "value-function-prototype-register"))))
           (symbolQuery (js-call functions :find (lambda (fn) (= (get fn :name) "value-function-symbol-initialization"))))
           (memberPublication (js-call functions :find (lambda (fn) (= (get fn :name) "value-function-initialize-members"))))
           (names (new globalThis.Set (js-array "is" "freeze" "isFrozen" "keys" "hasOwn" "assign" "getOwnPropertySymbols" "getPrototypeOf"
             "getOwnPropertyNames" "getOwnPropertyDescriptor" "defineProperty" "defineProperties" "create" "setPrototypeOf" "preventExtensions"
             "isExtensible" "fromEntries" "getOwnPropertyDescriptors" "seal" "isSealed")))
           (calls (new globalThis.Map)) (strings (new globalThis.Map)) (index 0))
      (funcall assert registration) (funcall assert symbolQuery) (funcall assert memberPublication)
      (while (< index (js-length functions))
        (let ((fn (aref functions index)) (targets (new globalThis.Set)) (literals (new globalThis.Set)))
          (visitNodes (get fn :body) (lambda (node)
            (when (= (get node :kind) "call") (js-call targets :add (get node :value)))
            (when (and (= (get node :kind) "memory-data-copy") (js-call names :has (get node :value))) (js-call literals :add (get node :value)))))
          (js-call calls :set (get fn :index) targets) (js-call strings :set (get fn :index) literals)) (setq index (1+ index)))
      (let* ((owners (js-call functions :filter (lambda (fn) (js-call (js-call calls :get (get fn :index)) :has (get registration :index)))))
             (owner (aref owners 0)) (table (new globalThis.Set (get (get lowered :typed) :table)))
             (publicEntries (new globalThis.Set)) (exported (new globalThis.Map)))
        (js-call assert :equal (js-length owners) 1 "all Function.prototype publication belongs to one shared body, regardless of read count")
        (js-call assert :equal (get owner :arity) 4 "shared initialization keeps the existing realm callback ABI")
        (funcall assert (js-call (js-call calls :get (get owner :index)) :has (get symbolQuery :index))
          "the real deferred Symbol handshake identifies the shared body independently of its generated name")
        (funcall assert (js-call table :has (get owner :index)) "the shared entry uses the actual managed callable table")
        (funcall assert (not (js-call table :has (get registration :index))) "runtime declarations are not private managed initializer entries")
        (let ((descriptors (get (get lowered :descriptor) :functions)) (cursor 0))
          (while (< cursor (js-length descriptors))
            (let* ((descriptor (aref descriptors cursor))
                   (alias (js-call (get (get lowered :typed) :aliases) :find (lambda (entry)
                     (= (get entry :name) (if (nullish? (get descriptor :wireName)) (get descriptor :name) (get descriptor :wireName))))))
                   (fn undefined))
              (funcall assert alias "every public source binding has a real typed export alias")
              (setq fn (js-call byName :get (get alias :function))) (funcall assert fn)
              (js-call publicEntries :add (get fn :index)) (js-call exported :set (get descriptor :name) (get fn :index))) (setq cursor (1+ cursor))))
(let* ((privateEntries (new globalThis.Set (js-call (Array/from table) :filter (lambda (id) (not (js-call publicEntries :has id))))))
               (closure undefined) (assembly undefined))
          (funcall assert (js-call privateEntries :has (get owner :index)))
          ;; Only actual calls to private callable table entries extend scope.
          (setq closure (lambda (start excluded)
            (setq excluded (if (= excluded undefined) (new globalThis.Set) excluded))
            (let ((found (new globalThis.Set)) (pending (js-array start)))
              (while (> (js-length pending) 0)
                (let ((id (js-call pending :pop)))
                  (unless (or (js-call found :has id) (js-call excluded :has id))
                    (funcall assert (js-call byIndex :has id)) (js-call found :add id)
                    (let ((targets (Array/from (js-call calls :get id))) (cursor 0))
                      (while (< cursor (js-length targets))
                        (let ((target (aref targets cursor)))
                          (when (and (js-call privateEntries :has target) (not (js-call excluded :has target))) (js-call pending :push target)))
                        (setq cursor (1+ cursor))))))) found)))
          (setq assembly (lambda (scope)
            (let ((emitted (new globalThis.Set)) (publishes false) (ids (Array/from scope)) (cursor 0))
              (while (< cursor (js-length ids))
                (let* ((id (aref ids cursor)) (literals (Array/from (js-call strings :get id))) (inner 0))
                  (while (< inner (js-length literals)) (js-call emitted :add (aref literals inner)) (setq inner (1+ inner)))
                  (when (js-call (js-call calls :get id) :has (get memberPublication :index)) (setq publishes t)))
                (setq cursor (1+ cursor))) (and publishes (= (get emitted :size) (get names :size))))))
          (let* ((shared (funcall closure (get owner :index)))
                 (scopes (new globalThis.Map (js-call (Array/from shared) :map (lambda (id)
                   (js-array id (funcall closure id (if (= id (get owner :index)) (new globalThis.Set) (new globalThis.Set (js-array (get owner :index))))))))))
                 (candidates (js-call (js-call (Array/from scopes) :filter (lambda (entry) (funcall assembly (aref entry 1)))) :map (lambda (entry) (aref entry 0))))
                 (locations (js-call candidates :filter (lambda (id) (not (js-call candidates :some (lambda (other)
                   (and (not (= other id)) (js-call (js-call scopes :get id) :has other))))))))
                 (directLocations (js-call (Array/from shared) :filter (lambda (id) (funcall assembly (new globalThis.Set (js-array id)))))))
            (funcall assert (js-call (Array/from shared) :every (lambda (id) (not (js-call publicEntries :has id)))))
            (funcall assert (funcall assembly shared) "the actual shared call closure must assemble and publish all twenty Object members")
            (js-call assert :equal (js-length locations) 1 "Object member assembly has one private location even when its work is outlined further")
            (funcall assert (<= (js-length directLocations) 1) "the complete Object assembly cannot also remain copied in a parent helper")
            (when (> (js-length directLocations) 0) (js-call assert :equal (aref directLocations 0) (aref locations 0)
              "an outlined child cannot coexist with a second complete inline Object assembly"))
            (setq index 0)
            (while (< index (js-length functions))
              (let ((fn (aref functions index)))
                (unless (js-call shared :has (get fn :index))
                  (funcall assert (not (funcall assembly (funcall closure (get fn :index) shared)))
                    "an ordinary read point or unrelated private helper must not duplicate the complete Object assembly"))) (setq index (1+ index)))
            (let ((reader (js-call exported :get "realm-read")))
              (js-call assert :notEqual reader undefined) (funcall assert (not (js-call shared :has reader)) "the source reader cannot become part of private realm assembly")
              (funcall assert (js-call (funcall closure reader) :has (get owner :index)) "the real dynamic Object/Number/Array reader must reach the shared entry through actual calls"))
            (let ((sharedCallers (js-call functions :filter (lambda (fn)
                    (and (not (= (get fn :index) (get owner :index))) (js-call (js-call calls :get (get fn :index)) :has (get owner :index)))))))
              (funcall assert (> (js-length sharedCallers) 1) "multiple genuine builtin read points must call the shared entry")))))
        ))
  (defun exerciseSharedRealm (a reference)
    (let* ((expected (js-call reference :realm_shared_observation)) (oracleThrew false))
      (js-call assert :deepEqual (JSON/parse expected) (js-array t t t t t t t 7 9 t t t t t t))
      (js-call assert :equal (js-call reference :realm_clean) "[false,false,false]")
      (try (js-call reference :realm_first_error) (catch error (setq oracleThrew t) (js-call assert :strictEqual error false)))
      (funcall assert oracleThrew)
      (let* ((callerDepth (get (js-call a :stats) :frameDepth)) (keep (js-call a :number (js* "-0"))) (frame (js-call a :frame 1))
             (held (js-array)) (report (lambda (name) (let ((result (js-call a :invoke name))) (try (js-call a :readString result) (finally (js-call a :release result)))))))
        (js-call a :frameSet frame 0 keep)
        (try
          (let ((round 0))
            (while (< round 3)
              (let ((kind 0))
                (while (< kind 3)
                  (let ((input (js-call a :number kind)) (current undefined))
                    (try (setq current (js-call a :invoke "realm-read" (js-array input))) (finally (js-call a :release input)))
                    (if (= round 0) (js-call held :push current)
                      (try (funcall assert (js-call a :keyEqual current (aref held kind))) (finally (js-call a :release current))))) (setq kind (1+ kind))))
              (js-call assert :equal (funcall report "realm-shared-observation") expected) (js-call assert :equal (funcall report "realm-clean") "[false,false,false]")
              (let ((didThrow false))
                (try (js-call a :invoke "realm-first-error") (catch error (setq didThrow t) (js-call assert :strictEqual error false)))
                (funcall assert didThrow "later native initialization cannot replace the first source throw"))
              (js-call a :collect) (js-call a :initializeModule)
              (js-call assert :equal (funcall report "realm-shared-observation") expected "a later request recovers with the same realm")
              (js-call assert :equal (funcall report "realm-clean") "[false,false,false]")
              (js-call assert :equal (get (js-call a :stats) :frameDepth) (+ callerDepth 1)) (funcall assert (Object/is (js-call a :readNumber keep) (js* "-0")))
              (let ((retained (js-call a :frameGet frame 0)))
                (try (funcall assert (Object/is (js-call a :readNumber retained) (js* "-0"))) (finally (js-call a :release retained)))) (setq round (1+ round))))
          (finally (let ((index 0)) (while (< index (js-length held)) (js-call a :release (aref held index)) (setq index (1+ index))))
            (js-call a :leaveFrame frame) (js-call a :release keep))))))
  (export sharedRealmDeclarations assertSharedRealmOutlining exerciseSharedRealm))
