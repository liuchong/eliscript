(module tests.helpers.wasm-managed-transient-state-node
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "../../runtime/core/vector.mjs" PersistentVector)
  (import "../../runtime/core/map.mjs" PersistentHashMap)
  (import "../../runtime/core/set.mjs" PersistentHashSet)
  (import "../../runtime/core/transient.mjs" :as transientRuntime)
  (import "../../runtime/core/metadata.mjs" withMeta meta)
  (import "../../runtime/core/value.mjs" extendValueType hashValue)
  (import "../../runtime/core/vector-internals.mjs" VECTOR_STATE TRANSIENT_VECTOR_STATE)
  (import "../../runtime/core/map-internals.mjs" MAP_STATE TRANSIENT_MAP_STATE ArrayNode BitmapIndexedNode)

  (defconst make-class (js* "(initialize) => class { constructor(...args) { initialize(this, ...args); } }"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))

  (defconst counts (js-array 0 1 31 32 33 63 64 1023 1024 1055 1056 1057))

  (defun metadata-value ()
    (PersistentHashMap/from (js-array (js-array "tag" 17))))

  (defun caught-report (callback)
    (try
      (funcall callback)
      (catch error
        (js-array (get error :name) (get error :message)))))

  (defconst Key
    (funcall make-class
      (lambda (self id hash)
        (put self :id id)
        (put self :hash hash))))

  (extendValueType Key
    (js-object
      :hash (lambda (key) (get key :hash))
      :equal (lambda (a b)
               (and (funcall js-instanceof b Key)
                    (= (get a :id) (get b :id))))))

  (defun vector-case (count)
    (let* ((metadata (metadata-value))
           (source (withMeta
                     (PersistentVector/from
                       (Array/from (js-object :length count) (lambda (_ i) i)))
                     metadata))
           (builder (js-call transientRuntime :transient source))
           (noop (js-call transientRuntime :transient source))
           (state (get builder TRANSIENT_VECTOR_STATE))
           (original (get source VECTOR_STATE))
           (shared (and (= (get state :root) (get original :root))
                        (= (get state :tail) (get original :tail)))))
      (js-call transientRuntime :conjBang builder count)
      (js-call transientRuntime :conjBang builder (+ count 1))
      (js-call transientRuntime :assocBang builder (+ count 2) (+ count 2))
      (js-call transientRuntime :assocBang builder 0 -2)
      (let ((result (js-call transientRuntime :persistentBang builder)))
        (js-array
          (Array/from source)
          (Array/from result)
          shared
          (= (js-call transientRuntime :persistentBang noop) source)
          (= (meta result) metadata)
          (js-call (meta result) :get "tag")
          (get state :active)
          (nil? (get state :owner))
          (caught-report (lambda () (js-call transientRuntime :conjBang builder 9)))
          (caught-report (lambda () (js-call transientRuntime :assocBang builder 0 9)))
          (caught-report (lambda () (js-call transientRuntime :persistentBang builder)))))))

  (defun vector-ownership ()
    (let* ((source (PersistentVector/from
                     (Array/from (js-object :length 97) (lambda (_ i) i))))
           (builder (js-call transientRuntime :transient source))
           (state (get builder TRANSIENT_VECTOR_STATE))
           (original (get source VECTOR_STATE))
           (tail (get original :tail))
           (root (get original :root))
           (sibling (aref (get root :slots) 1)))
      (js-call transientRuntime :conjBang builder 97)
      (let ((owned-tail (get state :tail)))
        (js-call transientRuntime :conjBang builder 98)
        (let ((tail-reused (= owned-tail (get state :tail))))
          (js-call transientRuntime :assocBang builder 0 100)
          (let* ((owned-root (get state :root))
                 (owned-leaf (aref (get owned-root :slots) 0)))
            (js-call transientRuntime :assocBang builder 1 101)
            (let* ((root-reused (= owned-root (get state :root)))
                   (leaf-reused (= owned-leaf (aref (get (get state :root) :slots) 0)))
                   (result (js-call transientRuntime :persistentBang builder))
                   (second (js-call transientRuntime :transient result)))
              (js-call transientRuntime :assocBang second 0 200)
              (let ((next-vec (js-call transientRuntime :persistentBang second)))
                (js-array
                  (/= tail owned-tail)
                  tail-reused
                  (/= root owned-root)
                  root-reused
                  leaf-reused
                  (= sibling (aref (get owned-root :slots) 1))
                  (/= (get (get next-vec VECTOR_STATE) :root)
                      (get (get result VECTOR_STATE) :root))
                  (js-call source :nth 0)
                  (js-call source :nth 1)
                  (js-call result :nth 0)
                  (js-call result :nth 1)
                  (js-call next-vec :nth 0)
                  (get tail :length)
                  (js-call source :nth 96)
                  (js-call result :nth 98)))))))))

  (defun map-branches ()
    (let* ((metadata (metadata-value))
           (empty (PersistentHashMap/empty))
           (source empty)
           (i 0))
      (while (< i 32)
        (setq source (js-call source :assoc (new Key i i) i))
        (setq i (+ i 1)))
      (setq source (withMeta source metadata))
      (let* ((builder (js-call transientRuntime :transient source))
             (state (get builder TRANSIENT_MAP_STATE))
             (root (get (get source MAP_STATE) :root))
             (noop (js-call transientRuntime :transient source)))
        (js-call transientRuntime :assocBang noop (new Key 0 0) 0)
        (js-call transientRuntime :dissocBang noop (new Key 100 100))
        (js-call transientRuntime :assocBang builder (new Key 0 0) 100)
        (let ((owned (get state :root)))
          (js-call transientRuntime :assocBang builder (new Key 1 1) 101)
          (let* ((reused (= owned (get state :root)))
                 (snapshot (js-call transientRuntime :persistentBang builder))
                 (grow (js-call transientRuntime :transient empty))
                 (growing (get grow TRANSIENT_MAP_STATE)))
            (js-call transientRuntime :dissocBang grow (new Key 0 0))
            (setq i 0)
            (while (< i 32)
              (js-call transientRuntime :assocBang grow (new Key i i) i)
              (setq i (+ i 1)))
            (let ((promoted (funcall js-instanceof (get growing :root) ArrayNode)))
              (setq i 31)
              (while (>= i 24)
                (js-call transientRuntime :dissocBang grow (new Key i i))
                (setq i (- i 1)))
              (let* ((packed (get growing :root))
                     (demoted (funcall js-instanceof packed BitmapIndexedNode)))
                (js-call transientRuntime :dissocBang grow (new Key 23 23))
                (let ((packed-reused (= packed (get growing :root))))
                  (setq i 22)
                  (while (>= i 0)
                    (js-call transientRuntime :dissocBang grow (new Key i i))
                    (setq i (- i 1)))
                  (let ((cleared (js-call transientRuntime :persistentBang grow)))
                    (js-array
                      promoted
                      demoted
                      packed-reused
                      reused
                      (/= root owned)
                      (= (js-call transientRuntime :persistentBang noop) source)
                      (get source :count)
                      (js-call source :get (new Key 0 0))
                      (get snapshot :count)
                      (js-call snapshot :get (new Key 0 0))
                      (js-call snapshot :get (new Key 1 1))
                      (= (meta snapshot) metadata)
                      (js-call (meta snapshot) :get "tag")
                      (get cleared :count)
                      (js-call cleared :has (new Key 0 0))
                      (caught-report (lambda () (js-call transientRuntime :assocBang builder (new Key 9 9) 9)))
                      (caught-report (lambda () (js-call transientRuntime :dissocBang builder (new Key 9 9))))
                      (caught-report (lambda () (js-call transientRuntime :persistentBang builder)))))))))))))

  (defun collisions ()
    (let ((source (PersistentHashMap/empty))
          (i 0))
      (while (< i 4)
        (setq source (js-call source :assoc (new Key i 42) i))
        (setq i (+ i 1)))
      (let* ((builder (js-call transientRuntime :transient source))
             (state (get builder TRANSIENT_MAP_STATE))
             (root (get (get source MAP_STATE) :root)))
        (js-call transientRuntime :assocBang builder (new Key 0 42) 100)
        (let ((owned (get state :root)))
          (js-call transientRuntime :assocBang builder (new Key 1 42) 101)
          (js-call transientRuntime :assocBang builder (new Key 4 42) 104)
          (let ((reused (= owned (get state :root))))
            (js-call transientRuntime :dissocBang builder (new Key 2 42))
            (js-call transientRuntime :dissocBang builder (new Key 99 42))
            (js-call transientRuntime :dissocBang builder (new Key 99 7))
            (js-call transientRuntime :assocBang builder (new Key 9 1066) 109)
            (js-call transientRuntime :dissocBang builder (new Key 9 1066))
            (js-call transientRuntime :dissocBang builder (new Key 4 42))
            (js-call transientRuntime :dissocBang builder (new Key 3 42))
            (js-call transientRuntime :dissocBang builder (new Key 1 42))
            (let ((result (js-call transientRuntime :persistentBang builder)))
              (js-array
                (/= root owned)
                reused
                (get source :count)
                (js-call source :get (new Key 0 42))
                (get result :count)
                (js-call result :get (new Key 0 42))
                (js-call result :get (new Key 1 42))
                (js-call result :has (new Key 2 42)))))))))

  (defun real-collision ()
    (let* ((left "key-50691")
           (right "key-194634")
           (source (PersistentHashMap/from
                     (js-array (js-array left "left") (js-array right "right"))))
           (builder (js-call transientRuntime :transient source)))
      (js-call transientRuntime :assocBang builder left "changed")
      (js-call transientRuntime :dissocBang builder right)
      (js-call transientRuntime :assocBang builder right "again")
      (let ((result (js-call transientRuntime :persistentBang builder)))
        (js-array
          (= (hashValue left) (hashValue right))
          (get source :count)
          (js-call source :get left)
          (js-call source :get right)
          (get result :count)
          (js-call result :get left)
          (js-call result :get right)))))

  (defun set-case ()
    (let* ((left (PersistentVector/from (js-array 1 2)))
           (right (PersistentVector/from (js-array 1 2)))
           (metadata (metadata-value))
           (source (withMeta (PersistentHashSet/from (js-array left globalThis.NaN -0)) metadata))
           (noop (js-call transientRuntime :transient source))
           (builder (js-call transientRuntime :transient source)))
      (js-call transientRuntime :conjBang noop right)
      (js-call transientRuntime :conjBang noop globalThis.NaN)
      (js-call transientRuntime :conjBang noop 0)
      (js-call transientRuntime :dissocBang noop "absent")
      (js-call transientRuntime :conjBang builder "new")
      (js-call transientRuntime :dissocBang builder right)
      (let ((result (js-call transientRuntime :persistentBang builder)))
        (js-array
          (= (js-call transientRuntime :persistentBang noop) source)
          (get source :count)
          (js-call source :has right)
          (get result :count)
          (js-call result :has left)
          (js-call result :has "new")
          (js-call result :has globalThis.NaN)
          (js-call result :has 0)
          (= (meta result) metadata)
          (js-call (meta result) :get "tag")
          (caught-report (lambda () (js-call transientRuntime :conjBang builder 9)))
          (caught-report (lambda () (js-call transientRuntime :dissocBang builder 9)))
          (caught-report (lambda () (js-call transientRuntime :persistentBang builder)))))))

  (defun callback-order (mode)
    (let* ((trace (js-array))
           (marker (js-object))
           (armed false)
           (CheckedKey (funcall make-class (lambda (self id) (put self :id id))))
           (CheckedValue (funcall make-class (lambda (self label) (put self :label label)))))
      (extendValueType CheckedKey
        (js-object
          :hash (lambda (_self)
                  (when armed
                    (js-call trace :push "hash")
                    (when (= mode 0) (throw marker)))
                  13)
          :equal (lambda (left right)
                   (when armed
                     (js-call trace :push "key")
                     (when (= mode 1) (throw marker)))
                   (= (get left :id) (get right :id)))))
      (extendValueType CheckedValue
        (js-object
          :hash (lambda (_self) 0)
          :equal (lambda (left right)
                   (when armed
                     (js-call trace :push "value")
                     (when (= mode 2) (throw marker)))
                   (= (get left :label) (get right :label)))))
      (let* ((source (PersistentHashMap/from
                       (js-array (js-array (new CheckedKey 1) (new CheckedValue "old")))))
             (builder (js-call transientRuntime :transient source))
             (caught false))
        (setq armed t)
        (try
          (js-call transientRuntime :assocBang builder (new CheckedKey 1) (new CheckedValue "new"))
          (catch error
            (setq caught (= error marker))))
        (setq armed false)
        (let ((result (js-call transientRuntime :persistentBang builder)))
          (js-array
            trace
            caught
            (= result source)
            (get result :count)
            (get (js-call result :get (new CheckedKey 1)) :label))))))

  (defun index-errors ()
    (let* ((builder (js-call transientRuntime :transient (PersistentVector/from (js-array 1))))
           (trace (js-array))
           (index (js-object :toString (lambda ()
                                         (js-call trace :push "string")
                                         (throw "format"))))
           (out (js-array)))
      (js-call (js-array -1 0.5 globalThis.NaN globalThis.Infinity "0" 2 undefined nil) :forEach
        (lambda (key)
          (js-call out :push (caught-report (lambda () (js-call transientRuntime :assocBang builder key 9))))))
      (try
        (js-call transientRuntime :assocBang builder index 9)
        (catch error
          (js-call out :push error)))
      (js-call transientRuntime :persistentBang builder)
      (js-call out :push (caught-report (lambda () (js-call transientRuntime :assocBang builder index 9))) trace)
      out))

  (defun vector-limit ()
    (let* ((builder (js-call transientRuntime :transient (PersistentVector/from (js-array 7))))
           (state (get builder TRANSIENT_VECTOR_STATE)))
      (put state :count 2147483647)
      (js-array
        (caught-report (lambda () (js-call transientRuntime :conjBang builder 9)))
        (get state :count)
        (get state :changed)
        (get state :active)
        (js-call (get state :source) :nth 0))))

  (defun invalid-sources ()
    (js-call (js-array
               (PersistentVector/empty)
               (PersistentHashMap/empty)
               (PersistentHashSet/empty))
      :map
      (lambda (value)
        (let ((Ctor (get (js-call transientRuntime :transient value) :constructor)))
          (caught-report (lambda () (Reflect/construct Ctor (js-array nil nil))))))))

  (defun main ()
    (let ((output (js-object
                    :vectors (js-call counts :map (lambda (c) (vector-case c)))
                    :vectorOwnership (vector-ownership)
                    :mapBranches (map-branches)
                    :collisions (collisions)
                    :realCollision (real-collision)
                    :setCase (set-case)
                    :callbacks (js-call (js-array 0 1 2 3) :map (lambda (m) (callback-order m)))
                    :indexErrors (index-errors)
                    :vectorLimit (vector-limit)
                    :invalidSources (invalid-sources))))
      (funcall assert
        (js-call (js-call (get output :vectorOwnership) :slice 0 7) :every
          (lambda (v) (globalThis.Boolean v))))
      (funcall assert
        (js-call (js-call (get output :mapBranches) :slice 0 6) :every
          (lambda (v) (globalThis.Boolean v))))
      (js-call assert :equal (aref (get output :realCollision) 0) t)
      (console/log (JSON/stringify output))))

  (try
    (main)
    (catch err
      (console/error err)
      (js-call process :exit 1))))
