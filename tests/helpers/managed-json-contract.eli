(module tests.helpers.managed-json-contract
  (import "node:assert/strict" :default assert)
  (import "./managed-stdlib-corpus.mjs" parseCases encodeInputs)
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defun kind (value) (if (nullish? value) undefined (get value :kind)))
  (defun read (a v)
    (cond ((= (kind v) 4) (js-call a :readNumber v)) ((= (kind v) 5) (js-call a :readString v))
      ((= (kind v) 14) (let ((out (js-array)) (index 0))
        (while (< index (js-call a :length v))
          (let ((child (js-call a :get v index))) (try (js-call out :push (read a child)) (finally (js-call a :release child))))
          (setq index (1+ index))) out))
      (t v)))
  (defun value (a name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (let ((out (js-call a :invoke name (if (= args undefined) (js-array) args)))) (try (read a out) (finally (js-call a :release out))))))
  (defun finish (a)
    (js-call a :closeModule) (js-call a :collect) (js-call assert :equal (js-call a :live) 0) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
  (defun box (a x)
    (cond ((= (funcall hostTypeof x) "string") (js-call a :string x)) ((= (funcall hostTypeof x) "number") (js-call a :number x))
      ((and (funcall (js* "(value) => !!value") x) (= (funcall hostTypeof x) "object"))
        (if (Array/isArray x) (js-call a :sourceArray (js-array))
          (let ((entries (Object/fromEntries (js-call (Object/entries x) :map (lambda (entry) (js-array (aref entry 0) (box a (aref entry 1))))))))
            (try (js-call a :sourceObject entries) (finally (js-call (Object/values entries) :forEach (lambda (v) (js-call a :release v))))))))
      (t x)))
  (defun checkAll (a inputs expected)
    (let ((errors (js-array)))
      (letfn ((verify (label operation)
        (try (funcall operation) (catch error
          (let* ((info (get error :eliscriptDiagnostic)) (code (if (nullish? info) undefined (get info :code))))
            (console/error "stdlib failure:" label (if (nullish? code) (get error :message) code)))
          (js-call errors :push error)))))
        (js-call (js-array (js-array "values" "values") (js-array "identities" "identities") (js-array "json_boundaries" "boundaries") (js-array "order_and_identity" "order"))
          :forEach (lambda (entry) (let ((name (aref entry 0)) (key (aref entry 1))) (verify name (lambda () (js-call assert :deepEqual (value a name) (get expected key)))))))
        (js-call inputs :forEach (lambda (text i)
          (verify (str "JSON " i " " (JSON/stringify text)) (lambda ()
            (let ((source (js-call a :string text)))
              (try (js-call assert :deepEqual (value a "json_case" (js-array source)) (aref (get expected :json) i) (JSON/stringify text))
                (finally (js-call a :release source))))))))
        (js-call parseCases :forEach (lambda (pair i)
          (verify (str "error " i) (lambda ()
            (let ((args (js-call pair :map (lambda (x) (box a x)))))
              (try (js-call assert :deepEqual (value a "parse_report" args) (aref (get expected :errors) i) (str "error " i))
                (finally (js-call args :forEach (lambda (v) (js-call a :release v))))))))))
        (js-call encodeInputs :forEach (lambda (x i)
          (verify (str "encode " i) (lambda ()
            (let ((input (box a x))) (try (js-call assert :deepEqual (value a "encode_report" (js-array input)) (aref (get expected :encoded) i) (str "encode " i))
              (finally (js-call a :release input)))))))))
      (when (> (get errors :length) 0) (throw (new globalThis.AggregateError errors (str "stdlib differential failures: " (get errors :length)))))))
  (export read value finish box checkAll))
