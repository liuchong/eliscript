(module tests.helpers.archive-resource-contract
  (import "bun:test" spyOn)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" :as fileIO)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm)
  (import "node:path" join resolve)
  (import "node:os" tmpdir)
  (import "node:url" fileURLToPath)
  (import "node:crypto" createHash)
  (import "../../tools/backends/compiler-build.mjs" independentCompilerProductIdentity)
  (defconst root (fileURLToPath (new globalThis.URL "../.." (js* "import.meta.url"))))
  (defconst receiverFunction (js* "(implementation) => function(...args) { return implementation(this, args); }"))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defun sha256 (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun bind (artifact files)
    (put artifact :artifactIdentity (js-object :algorithm "sha256" :files files))
    (put artifact :productIdentity (independentCompilerProductIdentity (js-object :host (get artifact :host) :files files :descriptor (get artifact :descriptor) :typed (get artifact :typed)))) artifact)
  (defun observeBoundedArtifactResources (paths)
    (let* ((owned (new globalThis.Set (js-call paths :map (lambda (path) (resolve path))))) (original (get fileIO :readFile)) (wholeReads 0)
      (observer (js-call (spyOn fileIO "readFile") :mockImplementation (funcall receiverFunction (lambda (self args)
        (let* ((path (aref args 0)) (local
          (cond ((= (funcall hostTypeof path) "string") path) ((Buffer/isBuffer path) (js-call path :toString "utf8"))
            ((and (funcall (js* "(value) => value instanceof URL") path) (= (get path :protocol) "file:")) (fileURLToPath path)) (t undefined))))
          (when (and (not (= local undefined)) (js-call owned :has (resolve local)))
            (setq wholeReads (+ wholeReads 1)) (throw (new globalThis.Error "authenticated artifact resources must use bounded reads instead of whole-file readFile")))
          (Reflect/apply original self args)))))))
      (js-object :assertBounded (lambda () (js-call assert :equal wholeReads 0 "all original resource identities and source values must use the bounded production path"))
        :restore (lambda () (js-call observer :mockRestore)))))
  (defasync fixture (operation)
    (let ((directory (await (mkdtemp (join (tmpdir) "eliscript-artifact-archive-")))))
      (try
        (let* ((product (join directory "product")) (archive (join directory "archive")))
          (await (mkdir (join product "bootstrap") (js-object :recursive t)))
          ; Real emitted frontend bytes test transport; no compiler execution is claimed.
          (let* ((payload (await (readFile (join root "dist/bootstrap/compiler.mjs"))))
            (runtime (await (readFile (join root "bootstrap/runtime/memory.eli")))) (path (join product "bootstrap/compiler.mjs"))
            (files (js-array (js-object :path "bootstrap/compiler.mjs" :bytes (js-length payload) :sha256 (sha256 payload))
              (js-object :path "runtime.eli" :bytes (js-length runtime) :sha256 (sha256 runtime))))
            (artifact (bind (js-object :host "javascript" :entry "bootstrap/compiler.mjs" :path path :directory product
              :provenance (js-object :mode "seed" :producerHost "javascript" :runtimeCompiled t :compiledModuleIds (js-array "bootstrap/compiler.mjs"))) files)))
            (await (writeFile path payload)) (await (writeFile (join product "runtime.eli") runtime))
            (await (funcall operation (js-object :directory directory :product product :archive archive :artifact artifact :payload payload :runtime runtime :files files)))))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync sessionResourceFixture (operation)
    (let* ((directory (await (mkdtemp (join (tmpdir) "eliscript-artifact-session-resource-"))))
      (source (await (readFile (new globalThis.URL "../fixtures/archive-resource-driver.mjs" (js* "import.meta.url")) "utf8")))
      (bytes (Buffer/from source)) (path (join directory "compiler.mjs")))
      (try
        (await (writeFile path bytes))
        (let ((artifact (bind (js-object :host "javascript" :entry "compiler.mjs" :directory directory :path "compiler.mjs" :modules (js-array (js-object :id "compiler.mjs" :path "compiler.mjs")))
          (js-array (js-object :path "compiler.mjs" :bytes (js-length bytes) :sha256 (sha256 bytes))))))
          (await (funcall operation (js-object :directory directory :artifact artifact :path path :source source :bytes bytes))))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync literalResourceFixture (operation)
    (await (sessionResourceFixture (async (context)
      (let* ((literal "\ufeff; 中😀é\n(module source)") (bytes (Buffer/from literal "utf8")) (path (join (get context :directory) "literal.eli")) (artifact (get context :artifact)))
        (await (writeFile path bytes))
        (put artifact :literalSources (js-array (js-object :id "runtime/core/value.mjs" :filename "stdlib/managed-runtime-value.eli" :path "literal.eli")))
        (put artifact :sourceIdentity (js-object :algorithm "sha256" :encoding "utf16le"
          :modules (js-array (js-object :id "compiler.mjs" :filename "compiler.eli" :sha256 (sha256 (Buffer/from "(module compiler)" "utf16le"))))
          :literalSources (js-array (js-object :id "runtime/core/value.mjs" :filename "stdlib/managed-runtime-value.eli" :sha256 (sha256 (Buffer/from literal "utf16le"))))))
        (bind artifact (js-call (get (get artifact :artifactIdentity) :files) :concat (js-array (js-object :path "literal.eli" :bytes (js-length bytes) :sha256 (sha256 bytes)))))
        (await (funcall operation (Object/assign (js-object) context (js-object :literal literal :literalBytes bytes :literalPath path)))))))))
  (export bind observeBoundedArtifactResources fixture sessionResourceFixture literalResourceFixture))
