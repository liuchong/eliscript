(module tests.helpers.wasm-managed-module-bindings-node
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:process" :default process)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defasync run-main ()
    (let* ((wasm-path (aref (get process :argv) 2))
           (js-url (aref (get process :argv) 3))
           (ref (await (funcall dyn-import js-url)))
           (bytes (await (readFile wasm-path))))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes))
            (i 0))
        (js-call a :auto 1)
        (let ((negative (js-call a :getExport "negative-zero")))
          (funcall assert (Object/is (js-call a :readNumber negative) (get ref :negative_zero)))
          (js-call a :release negative))
        (while (< i 64)
          (let ((res (js-call a :invoke "tick")))
            (js-call assert :equal (js-call a :readNumber res) (js-call ref :tick))
            (js-call a :release res)
            (js-call a :collect))
          (setq i (+ i 1)))
        (let* ((identity (js-call a :getExport "identity"))
               (direct (js-call a :invoke "identity-value"))
               (changed nil)
               (tiny nil)
               (out nil))
          (funcall assert (js-call a :keyEqual identity direct))
          (setq changed (js-call a :invoke "set-current" (js-array identity)))
          (js-call a :release changed)
          (js-call ref :set_current (get ref :identity))
          (setq tiny (js-call a :number globalThis.Number.MIN_VALUE))
          (setq out (js-call a :invoke "current" (js-array tiny)))
          (funcall assert (Object/is (js-call a :readNumber out) (js-call ref :current globalThis.Number.MIN_VALUE)))
          (js-call (js-array identity direct tiny out) :forEach (lambda (x) (js-call a :release x))))
        (let* ((other (instantiateManagedRuntime bytes))
               (first-val (js-call other :invoke "tick")))
          (js-call assert :equal (js-call other :readNumber first-val) 1)
          (js-call other :release first-val)
          (js-call other :closeModule)
          (js-call other :collect)
          (js-call assert :equal (js-call other :live) 0))
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (js-call globalThis.console :log "independent Node module execution passed"))))

  (js-call (run-main) :catch
    (lambda (err)
      (js-call globalThis.console :error err)
      (js-call process :exit 1))))
