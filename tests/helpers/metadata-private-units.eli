(module tests.helpers.metadata-private-units
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve join)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:process" :default process)
  (import "../../tools/compiler/controlled-baseline.mjs" definition)
  (defconst root (fileURLToPath (new globalThis.URL "../.." (js* "import.meta.url"))))
  (defconst dynamicImport (js* "(specifier) => import(specifier)"))
  (defvar output undefined)
  (defvar ioPromise undefined)
  (defvar readerPromise undefined)
  ; Extract the maintained Eli function body and bind it in a private lexical factory.
  ; The resulting module is compiled through the official Emacs seed CLI.
  (defun functionBinding (source name)
    (let* ((async (>= (js-call source :indexOf (str "(defasync " name " ")) 0))
           (form (definition (js-call source :replaceAll "(defasync " "(defun ") (str name " ")))
           (tail (js-call form :replace (new globalThis.RegExp "^\\((?:defun|defasync)\\s+[^\\s]+\\s+") "")))
      (str "(" name " (" (if async "async-lambda" "lambda") " " tail ")")))
  (defasync compileUnit (name source)
    (when (= output undefined) (setq output (await (mkdtemp (join (tmpdir) "eliscript-metadata-private-units-")))))
    (let* ((input (join output (str name ".eli"))) (path (join output (str name ".mjs"))))
      (await (writeFile input source))
      (let ((child (spawnSync (resolve root "bin/eliscript-seed") (js-array "--output" path input) (js-object :encoding "utf8" :timeout 30000 :maxBuffer 1048576))))
        (js-call assert :equal (get child :error) undefined) (js-call assert :equal (get child :signal) nil)
        (js-call assert :equal (get child :status) 0 (get child :stderr)))
      (await (funcall dynamicImport (get (pathToFileURL path) :href)))))
  (defun quoted (value) (JSON/stringify value))
  (defasync buildMetadataIOUnit ()
    (let* ((source (await (readFile (resolve root "tools/backends/compiler-build.eli") "utf8")))
           (names (js-array "build-optional-get" "build-nullish" "compiler-metadata-utf8-block" "compilerMetadataDigest" "compiler-file-identity" "writeCompilerMetadata" "write-owned-compiler-metadata"))
           (bindings (js-call (js-call names :map (lambda (name) (functionBinding source name))) :join "\n"))
           (sessionURL (get (pathToFileURL (resolve root "tools/backends/compiler-session.mjs")) :href))
           (unit (str "(module tests.private.metadata-io\n"
             "(import \"node:fs/promises\" :as fs) (import \"node:fs\" :as sync) (import \"node:crypto\" createHash)\n"
             "(import " (quoted sessionURL) " forEachCompilerMetadataChunk)\n"
             "(defun makeUnit (&optional open writeSync)\n"
             "(when (nullish? open) (setq open (get fs :open))) (when (nullish? writeSync) (setq writeSync (get sync :writeSync)))\n"
             "(let* (" bindings ") (js-object :compilerMetadataUtf8Block compiler-metadata-utf8-block :compilerMetadataDigest compilerMetadataDigest"
             " :compilerFileIdentity compiler-file-identity :writeCompilerMetadata writeCompilerMetadata :writeOwnedCompilerMetadata write-owned-compiler-metadata)))\n"
             "(defconst real (makeUnit)) (export makeUnit real))")))
      (await (compileUnit "metadata-io" unit))))
  (defasync metadataIOUnit ()
    (when (= ioPromise undefined) (setq ioPromise (buildMetadataIOUnit))) (await ioPromise))
  (defasync buildMetadataReaderUnit ()
    (let* ((source (await (readFile (resolve root "tools/backends/compiler-metadata.eli") "utf8")))
           (binding (functionBinding source "readCompilerMetadata"))
           (decoderURL (get (pathToFileURL (resolve root "tools/backends/compiler-metadata.mjs")) :href))
           (unit (str "(module tests.private.metadata-reader (import " (quoted decoderURL) " createCompilerMetadataDecoder)\n"
             "(defun make (openFile) (let* ((open openFile) " binding ") readCompilerMetadata)) (export make))")))
      (await (compileUnit "metadata-reader" unit))))
  (defasync metadataReaderUnit ()
    (when (= readerPromise undefined) (setq readerPromise (buildMetadataReaderUnit))) (await readerPromise))
  (defasync closeMetadataPrivateUnits ()
    (unless (= output undefined) (await (rm output (js-object :recursive t :force t))) (setq output undefined)))
  (defasync privateSeedJavaScriptProduct ()
    (let* ((source (await (readFile (resolve root "tools/backends/compiler-build.eli") "utf8")))
      (names (js-array "build-truth" "build-nullish" "build-copy-properties" "seed-javascript-product"))
      (bindings (js-call (js-call names :map (lambda (name) (functionBinding source name))) :join "\n"))
      (unit (str "(module tests.private.seed-schedule (defun makeUnit () (let* (" bindings ") seed-javascript-product)) (export makeUnit))"))
      (module (await (compileUnit "seed-javascript-schedule" unit))))
      (js-call module :makeUnit)))
  (export privateSeedJavaScriptProduct metadataIOUnit metadataReaderUnit closeMetadataPrivateUnits))
