(module tests.helpers.wasm-managed-array-callbacks-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun main ()
    (let* ((wasm-path (aref (get globalThis.process :argv) 2))
           (a (instantiateManagedRuntime (readFileSync wasm-path)))
           (_ (js-call a :auto 1))
           (f (js-call a :invoke "identity"))
           (zero (js-call a :number -0.0))
           (nan (js-call a :number globalThis.NaN))
           (tiny (js-call a :number globalThis.Number.MIN_VALUE))
           (empty (js-call a :string ""))
           (values (js-call a :sourceArray (js-array zero nan tiny empty t)))
           (out (js-call a :invoke "filter-with" (js-array values f)))
           (first nil)
           (sparse (new globalThis.Array 5))
           (input nil)
           (mapped nil))
      (js-call assert :equal (js-call a :length out) 2)
      (setq first (js-call a :get out 0))
      (js-call assert :equal (js-call a :readNumber first) globalThis.Number.MIN_VALUE)
      (js-call assert :equal (js-call a :get out 1) t)
      (js-call a :release first)
      (put sparse 2 tiny)
      (setq input (js-call a :sourceArray sparse))
      (setq mapped (js-call a :invoke "map-with" (js-array input f)))
      (js-call assert :equal (js-call a :length mapped) 5)
      (js-call (js-array 0 1 3 4) :forEach
        (lambda (i)
          (let ((key (js-call a :number i)))
            (js-call assert :equal (js-call a :invoke "has-index" (js-array mapped key)) false)
            (js-call a :release key))))
      (let ((key (js-call a :number 2)))
        (js-call assert :equal (js-call a :invoke "has-index" (js-array mapped key)) t)
        (js-call a :release key))
      (js-call (js-array f zero nan tiny empty values out input mapped) :forEach
        (lambda (x) (js-call a :release x)))
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (console/log "independent Node callback semantics passed")))

  (main))
