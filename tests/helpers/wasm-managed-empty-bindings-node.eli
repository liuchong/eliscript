(module tests.helpers.wasm-managed-empty-bindings-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defasync main ()
    (let ((mode (aref (get globalThis.process :argv) 2)))
      (if (= mode "js")
        (let* ((m (await (dynamic-import (aref (get globalThis.process :argv) 3))))
               (f (js-call m :escape_value))
               (trace (js-object)))
          (js-call assert :equal (js-call m :default_value) nil)
          (assert (Object/is (js-call m :parallel_value -0.0) -0.0))
          (js-call assert :equal (js-call m :sequential_value 9) 7)
          (assert (Object/is (js-call m :capture_value globalThis.NaN) globalThis.NaN))
          (js-call assert :equal (funcall f nil) nil)
          (js-call assert :equal (funcall f "😀") "😀")
          (js-call assert :equal (funcall f nil) "😀")
          (js-call assert :deepEqual (js-call m :effect_value trace) (js-array nil 1 2))
          (js-call assert :deepEqual trace (js-object :first 1 :second 2)))
        (let* ((rt-mod (await (dynamic-import (aref (get globalThis.process :argv) 3))))
               (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
               (a (funcall instantiateManagedRuntime (readFileSync (aref (get globalThis.process :argv) 4)))))
          (js-call a :auto 1)
          (js-call assert :equal (js-call a :invoke "default-value") nil)
          (js-call
            (js-array -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE)
            :forEach
            (lambda (x)
              (let ((n (js-call a :number x)))
                (js-call (js-array "parallel-value" "capture-value") :forEach
                  (lambda (name)
                    (let ((out (js-call a :invoke name (js-array n))))
                      (assert (Object/is (js-call a :readNumber out) x))
                      (js-call a :release out))))
                (let ((sequential (js-call a :invoke "sequential-value" (js-array n))))
                  (js-call assert :equal (js-call a :readNumber sequential) 7)
                  (js-call a :release n)
                  (js-call a :release sequential)))))
          (js-call a :closeModule)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))

  (main))
