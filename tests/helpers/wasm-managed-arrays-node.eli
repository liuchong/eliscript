(module tests.helpers.wasm-managed-arrays-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "node:process" :default process)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (let* ((wasm-path (aref (get process :argv) 2))
         (a (instantiateManagedRuntime (readFileSync wasm-path))))
    (js-call a :auto 1)
    (let* ((x (js-call a :number -0.0))
           (y (js-call a :string "中😀"))
           (arr (js-call a :invoke "make" (js-array x nil y)))
           (first-val (js-call a :get arr 0)))
      (funcall assert (Object/is (js-call a :readNumber first-val) -0.0))
      (js-call a :release first-val)
      (let* ((idx (js-call a :number 9))
             (assigned (js-call a :invoke "write" (js-array arr idx y))))
        (funcall assert (js-call a :keyEqual assigned y))
        (js-call a :release assigned)
        (js-call assert :equal (js-call a :length arr) 10)
        (js-call assert :equal (js-call a :get arr 5) undefined)
        (let ((popped (js-call a :invoke "remove-last" (js-array arr))))
          (js-call assert :equal (js-call a :readString popped) "中😀")
          (js-call a :release popped))
        (let* ((cnt (js-call a :number 128))
               (grown (js-call a :invoke "grow-loop" (js-array cnt)))
               (key (js-call a :string "01"))
               (set-res (js-call a :invoke "write" (js-array grown key y))))
          (js-call assert :equal (js-call a :length grown) 128)
          (js-call a :release set-res)
          (js-call assert :equal (js-call a :invoke "has" (js-array grown key)) t)
          (let* ((names (js-call a :invoke "keys" (js-array grown)))
                 (last-name (js-call a :get names 128))
                 (copied (js-call a :invoke "copy" (js-array grown))))
            (js-call assert :equal (js-call a :readString last-name) "01")
            (js-call a :release last-name)
            (js-call assert :equal (js-call a :invoke "has" (js-array copied key)) false)
            (js-call (js-array x y arr idx cnt grown key names copied) :forEach
              (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))
