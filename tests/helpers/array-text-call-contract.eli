(module tests.helpers.array-text-call-contract
  (import "node:assert/strict" :default assert)
  (defconst receiverFunction (js* "(implementation) => function(...args) { return implementation(this,args); }"))
  (defconst instance (js* "(value, type) => value instanceof type"))
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun throws (action expected &rest __host_forwarded_arguments_3)
    (let* ((label (aref __host_forwarded_arguments_3 0))) (js-call assert :throws action expected label)))
  (defun getter (object key read) (Object/defineProperty object key (js-object :configurable t :get read)) object)
  (defun cyclic (error)
    (and (not (nullish? error)) (not (nullish? (get error :eliscriptDiagnostic))) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0009")))
  (defun routes (m)
    (js-array
      (js-array "call" (lambda (method array separator) (js-call m :method_call method array separator)))
      (js-array "apply" (lambda (method array separator) (js-call m :method_apply method array (js-array separator))))
      (js-array "nested call" (lambda (method array separator) (js-call m :nested_call method array separator)))
      (js-array "apply.call" (lambda (method array separator) (js-call m :nested_apply_call method array (js-array separator))))
      (js-array "call.apply" (lambda (method array separator) (js-call m :nested_call_apply method array separator)))
      (js-array "apply.apply" (lambda (method array separator) (js-call m :nested_apply method array (js-array separator))))
      (js-array "Reflect.apply" (lambda (method array separator) (js-call m :reflected method array (js-array separator))))
      (js-array "bound funcall" (lambda (method array separator) (js-call m :invoke_bound (js-call m :method_bind method array separator) "ignored")))
      (js-array "bound call" (lambda (method array separator) (js-call m :method_call (js-call m :method_bind method array separator) nil "ignored")))
      (js-array "bound apply" (lambda (method array separator) (js-call m :method_apply (js-call m :method_bind method array separator) nil (js-array "ignored"))))
      (js-array "bound Reflect.apply" (lambda (method array separator) (js-call m :reflected (js-call m :method_bind method array separator) nil (js-array "ignored"))))
      (js-array "bound again" (lambda (method array separator) (js-call m :invoke_bound (js-call m :bind_again (js-call m :bind_receiver method array) nil separator) "ignored")))
      (js-array "external callback" (lambda (method array separator) (js-call m :external_bound (lambda (bound) (bound)) (js-call m :method_bind method array separator))))))
  (defun applyRoutes (m)
    (js-array (js-array "apply" (lambda (method array args) (js-call m :method_apply method array args)))
      (js-array "apply.call" (lambda (method array args) (js-call m :nested_apply_call method array args)))
      (js-array "apply.apply" (lambda (method array args) (js-call m :nested_apply method array args)))
      (js-array "Reflect.apply" (lambda (method array args) (js-call m :reflected method array args)))))
  (defun observed (run join name throwIndex)
    (let* ((trace (js-array)) (failure (js-object)) (separator (js-object :toString (lambda () (js-call trace :push "separator") "|")))
           (receiver (new globalThis.Proxy (js-array "a" "b") (js-object :get (lambda (target key owner)
             (js-call trace :push (str "receiver." (funcall globalThis.String key))) (Reflect/get target key owner)))))
           (args (js-object)))
      (getter args "length" (lambda () (js-call trace :push "arguments.length") 3))
      (getter args 0 (lambda () (js-call trace :push "arguments.0") separator))
      (getter args 1 (lambda () (js-call trace :push "arguments.1") "ignored"))
      (getter args 2 (lambda () (js-call trace :push "arguments.2") (when throwIndex (throw failure)) 42))
      (if throwIndex
        (progn (throws (lambda () (run join receiver args)) (lambda (error) (= error failure)) (str name " argument error"))
          (same trace (js-array "arguments.length" "arguments.0" "arguments.1" "arguments.2") (str name " first error")))
        (progn (eqv (run join receiver args) "a|b")
          (same trace (js-array "arguments.length" "arguments.0" "arguments.1" "arguments.2" "receiver.length" "separator" "receiver.0" "receiver.1") (str name " ordered reads"))))))
  (defasync check (m)
    (let* ((events (js-array)) (identity (js-object)) (value (js-object)) (effects 0) (gets 0))
      (getter value "join" (lambda () (js-call events :push "method") (funcall receiverFunction (lambda (receiver args) (js-call events :push (js-array "call" (= receiver value) args)) identity))))
      (eqv (js-call m :literals value) identity) (eqv (aref events 0) "method") (eqv (aref (aref events 1) 1) t)
      (eqv (get (aref (aref events 1) 2) :length) 7) (same (aref (aref events 1) 2) (js-array "|" 0 (js* "-0") nil t false undefined))
      (let ((target (js-array "a" "b")) (order (js-array)))
        (eqv (js-call m :computed (lambda () (js-call order :push "receiver") target)
          (lambda () (js-call order :push "key") (let ((key (js-object))) (put key (get globalThis.Symbol :toPrimitive) (lambda () (js-call order :push "coerce") "join")) key))) "a|b")
        (same order (js-array "receiver" "key" "coerce")))
      (let ((own (js-object)))
        (getter own "join" (lambda () (setq gets (1+ gets)) (funcall receiverFunction (lambda (receiver args) (eqv receiver own) (js-array "original" (aref args 0))))))
        (same (js-call m :effect own (lambda () (setq effects (1+ effects)) (Object/defineProperty own "join" (js-object :value (lambda () (js-array "replacement")) :configurable t)) "|")) (js-array "original" "|"))
        (eqv gets 1) (eqv effects 1))
      (let ((extraArray (js-array "a" "b")))
        (eqv (js-call m :extra extraArray (lambda () (put extraArray :join (lambda () (throw (new globalThis.Error "replaced after capture")))) (setq effects (1+ effects)))) "a|b") (eqv effects 2))
      (js-call (js-array nil undefined) :forEach (lambda (missing)
        (throws (lambda () (js-call m :effect missing (lambda () (setq effects (1+ effects)) "|"))) globalThis.TypeError) (eqv effects 2)
        (throws (lambda () (js-call m :empty missing)) globalThis.TypeError)
        (throws (lambda () (js-call m :computed (lambda () missing) (lambda () (js-object :toString (lambda () (throw (new globalThis.Error "must not coerce key for nullish receiver"))))))) globalThis.TypeError)))
      (throws (lambda () (js-call m :extra (getter (js-object) "join" (lambda () (throw identity))) (lambda () (throw (new globalThis.Error "argument after throwing getter"))))) (lambda (error) (= error identity)))
      (let ((marker (js-object)))
        (throws (lambda () (js-call m :thrown (getter (js-object) "join" (lambda () (js-call events :push "before-throw") (lambda () undefined))) marker)) (lambda (error) (= error marker)))
        (eqv (js-call events :at -1) "before-throw"))
      (let* ((logs (js-array)) (p (getter (js-object) "join" (lambda () (js-call logs :push "method") (lambda (separator) (js-call logs :push "call") separator))))
             (separator (js-object :then (lambda (accept) (js-call logs :push "await") (accept "|")))))
        (eqv (await (js-call m :pending p separator)) "|") (same logs (js-array "method" "await" "call")))
      (eqv (js-call m :empty (js-object :join (lambda () identity))) identity) (eqv (js-call m :text (js-object :toString (lambda () identity))) identity)
      (eqv (js-call m :empty (js-array "a" "b")) "a,b") (eqv (js-call m :text (js-array "a" "b")) "a,b")
      (let ((cycle (js-array))) (js-call cycle :push cycle) (throws (lambda () (js-call m :empty cycle)) cyclic) (put cycle 0 "ok") (eqv (js-call m :empty cycle) "ok"))
      (let ((nested (js-array "x"))) (eqv (js-call m :empty (js-array nested nested)) "x,x") (eqv (js-call m :empty nested) "x"))
      (let* ((arrayPrototype (get globalThis.Array :prototype)) (functionPrototype (get globalThis.Function :prototype))
             (intrinsics (js-object :join (get arrayPrototype :join) :text (get arrayPrototype :toString) :call (get functionPrototype :call)
               :apply (get functionPrototype :apply) :bind (get functionPrototype :bind) :reflect (get globalThis.Reflect :apply))))
        (eqv (js-call m :borrowed_join) (get intrinsics :join)) (eqv (js-call m :borrowed_text) (get intrinsics :text))
        (js-call (js-array (get intrinsics :join) (get intrinsics :text)) :forEach (lambda (method)
          (js-call (routes m) :forEach (lambda (route)
            (let* ((name (aref route 0)) (run (aref route 1)) (ordinary (js-array "a" nil (js* "-0") "😀")) (shared (js-array "shared"))
                   (recursive (js-array)) (reentrant (js-array)) (failure (js-object)) (bad (js-array (js-object :toString (lambda () (throw failure))))))
              (eqv (run method ordinary "|") (Reflect/apply method ordinary (js-array "|")) (str name " ordinary"))
              (eqv (run method (js-array shared shared) "|") (Reflect/apply method (js-array shared shared) (js-array "|")) (str name " shared noncycle"))
              (js-call recursive :push recursive)
              (throws (lambda () (run method recursive "|")) (lambda (error) (and (funcall instance error globalThis.TypeError) (cyclic error))) (str name " cycle"))
              (put recursive 0 "recovered") (eqv (run method recursive "|") "recovered" (str name " recovery"))
              (getter reentrant 0 (lambda () (run method reentrant "|")))
              (throws (lambda () (run method reentrant "|")) cyclic (str name " getter reentry"))
              (Reflect/deleteProperty reentrant 0) (put reentrant 0 "recovered") (eqv (run method reentrant "|") "recovered" (str name " getter recovery"))
              (throws (lambda () (run method bad "|")) (lambda (error) (= error failure)) (str name " element first error"))
              (put bad 0 "after") (eqv (run method bad "|") "after" (str name " element recovery"))
              (when (= method (get intrinsics :text))
                (let ((result (js-object)) (custom (js-array))) (js-call custom :push custom) (put custom :join (lambda () result)) (eqv (run method custom "|") result (str name " custom join identity"))))
              (eqv (run method (js-array "next") "|") "next" (str name " independent next call")))))))
        (js-call (applyRoutes m) :forEach (lambda (route)
          (let* ((name (aref route 0)) (run (aref route 1)) (join (get intrinsics :join)) (species 0) (slices 0)
                 (Arguments (funcall (js* "(readSpecies) => class Arguments extends Array { static get [Symbol.species]() { return readSpecies(); } }")
                   (lambda () (setq species (1+ species)) (throw (new globalThis.Error "apply must not observe species")))))
                 (args (new Arguments "|" "ignored")))
            (observed run join name false) (observed run join name t) (eqv (run join (js-array "after" "throw") (js-array "|")) "after|throw")
            (getter args "slice" (lambda () (setq slices (1+ slices)) (throw (new globalThis.Error "apply must not read slice"))))
            (eqv (run join (js-array "a" "b") args) "a|b") (eqv species 0 (str name " species")) (eqv slices 0 (str name " slice")))))
        (js-call (js-array
          (js-array "call" (lambda (method value args) (js-call m :method_call method value args)) "|")
          (js-array "apply" (lambda (method value args) (js-call m :method_apply method value args)) (new globalThis.Proxy (js-object) (js-object :get (lambda () (throw (new globalThis.Error "custom apply must receive the original list"))))))
          (js-array "bind" (lambda (method value args) (js-call m :method_bind method value args)) "|")) :forEach (lambda (route)
            (let* ((name (aref route 0)) (run (aref route 1)) (args (aref route 2)) (replacement (js-object)) (receiver (js-array)) (trace (js-array))
                   (method (lambda () (throw (new globalThis.Error "custom method must win")))))
              (getter method name (lambda () (js-call trace :push "get") (funcall receiverFunction (lambda (self values)
                (js-call trace :push "call") (eqv self method) (eqv (aref values 0) receiver) (eqv (aref values 1) args) replacement))))
              (eqv (run method receiver args) replacement (str name " replacement identity")) (same trace (js-array "get" "call")))))
        (eqv (get arrayPrototype :join) (get intrinsics :join)) (eqv (get arrayPrototype :toString) (get intrinsics :text))
        (eqv (get functionPrototype :call) (get intrinsics :call)) (eqv (get functionPrototype :apply) (get intrinsics :apply))
        (eqv (get functionPrototype :bind) (get intrinsics :bind)) (eqv (get globalThis.Reflect :apply) (get intrinsics :reflect))
        (eqv (js-call m :borrowed_join) (get intrinsics :join)) (eqv (js-call m :borrowed_text) (get intrinsics :text)))))
  (defun checkQualifiedApply (m)
    (let* ((join (get (get globalThis.Array :prototype) :join)) (applyFn (get globalThis.Reflect :apply))
           (routes (js-array (js-array "direct" (lambda (method value args) (js-call m :reflected_only method value args)))
             (js-array "funcall" (lambda (method value args) (js-call m :reflected_funcall method value args)))
             (js-array "spread" (lambda (method value args) (js-call m :reflected_spread (js-array method value args))))
             (js-array "namespace" (lambda (method value args) (js-call m :namespace_apply globalThis.Reflect method value args)))
             (js-array "dot" (lambda (method value args) (js-call m :dotted_apply globalThis.Reflect method value args)))
             (js-array "shadow" (lambda (method value args) (js-call m :shadowed_apply globalThis.Reflect method value args))))))
      (eqv (js-call m :apply_reference) applyFn)
      (js-call routes :forEach (lambda (route)
        (let* ((name (aref route 0)) (run (aref route 1)) (cycle (js-array)) (reads 0) (args (getter (js-object) "length" (lambda () (setq reads (1+ reads)) (throw (new globalThis.Error "target must be checked first"))))))
          (eqv (run join (js-array "a" "b") (js-array "|")) "a|b" name)
          (js-call cycle :push cycle) (throws (lambda () (run join cycle (js-array "|"))) (lambda (error) (and (funcall instance error globalThis.TypeError) (cyclic error))) name)
          (put cycle 0 "recovered") (eqv (run join cycle (js-array "|")) "recovered" name)
          (throws (lambda () (run false (js-array) args)) globalThis.TypeError) (eqv reads 0 (str name " noncallable target precedes argument-list reads")))))
      (let* ((trace (js-array)) (result (js-object)) (method (js-object)) (value (js-object)) (args (js-object)) (owner (js-object))
             (original (funcall receiverFunction (lambda (self actual) (eqv self owner) (same actual (js-array method value args)) (js-call trace :push "call") result))))
        (getter owner "apply" (lambda () (js-call trace :push "get") original))
        (eqv (js-call m :namespace_reference owner) original "a first-class qualified reference keeps exact identity") (put trace :length 0)
        (eqv (js-call m :captured_apply owner (lambda () (js-call trace :push "method") (Object/defineProperty owner "apply" (js-object :value false :configurable t)) method)
          (lambda () (js-call trace :push "value") value) (lambda () (js-call trace :push "args") args)) result)
        (same trace (js-array "get" "method" "value" "args" "call"))
        (js-call (js-array (get m :namespace_apply) (get m :dotted_apply) (get m :shadowed_apply)) :forEach (lambda (run)
          (Object/defineProperty owner "apply" (js-object :value original :writable t :configurable t)) (eqv (run owner method value args) result "custom namespace apply retains its receiver")))
        (let* ((thrown (js-object)) (failure (getter (js-object) "apply" (lambda () (js-call trace :push "throw") (throw thrown))))
               (later (lambda () (throw (new globalThis.Error "arguments must not run")))))
          (throws (lambda () (js-call m :captured_apply failure later later later)) (lambda (error) (= error thrown)))
          (js-call (js-array nil undefined) :forEach (lambda (nullish) (throws (lambda () (js-call m :captured_apply nullish later later later)) globalThis.TypeError)))))))
  (export check checkQualifiedApply))
