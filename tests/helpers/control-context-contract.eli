(module tests.helpers.control-context-contract
  (import "node:assert/strict" :default assert)
  (defun truth (value) (and (not (= value false)) (not (nullish? value))))
  (defun oracle (n)
    (let ((index 0) (total 0) (trace (js-array)))
      (while (< index n)
        (if (= (% index 2) 0) (progn (js-call trace :push "even") (setq total (+ total index))) (progn (js-call trace :push "odd") (setq total (- total index))))
        (when (= index 1) (js-call trace :push "when") (setq total (+ total 4)))
        (unless (= index 2) (js-call trace :push "unless") (setq total (1+ total)))
        (cond ((= index 0) (js-call trace :push "zero") (setq total (+ total 2))) ((= index 3) (js-call trace :push "three") (setq total (+ total 3))) (t (setq total (+ total 0))))
        (setq index (1+ index)))
      (js-call trace :push (if (> n 2) "large" "small")) (js-array total trace)))
  (defun checkBoundary (m)
    (js-call assert :deepEqual (js-call m :scopes) (js-array 9 (js-array (js-array 2 9) 11 7 4)))
    (js-call (js-array false nil undefined t 0 "" globalThis.NaN 1 (js-object) (js-array)) :forEach (lambda (v)
      (let* ((log (js-array)) (yes (truth v)) (out (js-call m :values v log)) (thrown (js-array)))
        (js-call assert :deepEqual out (js-array (if yes 4 5) (if yes 6 nil) (if yes nil 7) (if (= v 1) 8 9)))
        (js-call assert :deepEqual log (js-array (if yes "yes" "no") (if yes "when" "unless") (if (= v 1) "one" "other")))
        (let ((value (js-call m :thrown v thrown)))
          (assert (Object/is value (if yes v 17))) (js-call assert :deepEqual thrown (if yes (js-array "before" "caught" "finally") (js-array "fallback" "after" "finally")))))))
    (js-call (js-array 0 1 2) :forEach (lambda (v)
      (let ((log (js-array))) (js-call assert :equal (js-call m :branches v log) (if (< v 2) v nil))
        (js-call assert :deepEqual log (if (= v 0) (js-array "first" "zero") (if (= v 1) (js-array "first" "second" "one") (js-array "first" "second"))))))))
  ;; These are explicit native JavaScript scheduling reference inputs. Their
  ;; await/IIFE boundaries are the subject of differential compiler tests.
  (defconst asyncOracle (funcall (js* "(truth) => async function asyncOracle(flag, log) { log.push('outer'); return truth(flag) ? await (async () => { log.push('branch'); await Promise.resolve(3); log.push('resume'); return 7; })() : (() => { log.push('else'); return 8; })(); }") truth))
  (defconst discardedOracle (funcall (js* "(truth) => async function discardedOracle(flag, log) { if (truth(flag)) await (async () => { log.push('branch'); await Promise.resolve(3); log.push('resume'); return 7; })(); log.push('after'); return 9; }") truth))
  (defconst sequentialAsyncOracle (js* "(async function sequentialAsyncOracle(_, log) { return await (async (first) => ((second) => { log.push('body'); return [first, second]; })(await Promise.resolve(2)))(await Promise.resolve(1)); })"))
  (defasync timeline (fn flag)
    (let* ((log (js-array)) (pending (js-call (funcall fn flag log) :then (lambda (value) (js-call log :push (str "done:" value)) value))))
      (js-call (js* "globalThis") :queueMicrotask (lambda () (js-call log :push "queued")))
      (js-call (Promise/resolve) :then (lambda () (js-call log :push "promise")))
      (let ((value (await pending))) (await (Promise/resolve)) (js-object :value value :log log))))
  (defun checkSequential (m)
    (js-call assert :deepEqual (js-call m :forward) (js-array 9 2)) (js-call assert :deepEqual (js-call m :self) (js-array 5 6))
    (js-call assert :equal (js-call m :closure_forward) 9) (js-call assert :equal (js-call m :closure_self) "outer")
    (js-call assert :deepEqual (js-call m :raw_forward) (js-array 9 2)) (js-call assert :deepEqual (js-call m :write_forward) (js-array 3 2))
    (js-call assert :deepEqual (js-call m :reserved) (js-array 7 8)) (js-call assert :deepEqual (js-call m :captures) (js-array (js-array 0 1) (js-array 1 2) (js-array 2 3)))
    (let ((events (js-array)) (state (js-object)))
      (Object/defineProperty state "source" (js-object :get (lambda () (js-call events :push "source") "a😀") :enumerable t :configurable t))
      (Object/defineProperty state "index" (js-object :get (lambda () (js-call events :push "index") 1) :enumerable t :configurable t))
      (js-call assert :deepEqual (js-call m :compact state (lambda (code) (js-call events :push (str "callback:" code)) globalThis.NaN)) (js-array "a😀" 1 2 128512 false))
      (js-call assert :deepEqual events (js-array "source" "index" "callback:128512")))
    (let ((thrown (js-object :identity 1)))
      (js-call (js-array "source" "index" "callback") :forEach (lambda (stage)
        (let ((trace (js-array)) (object (js-object)))
          (Object/defineProperty object "source" (js-object :get (lambda () (js-call trace :push "source") (when (= stage "source") (throw thrown)) "a😀") :enumerable t :configurable t))
          (Object/defineProperty object "index" (js-object :get (lambda () (js-call trace :push "index") (when (= stage "index") (throw thrown)) 1) :enumerable t :configurable t))
          (js-call assert :throws (lambda () (js-call m :compact object (lambda () (js-call trace :push "callback") (throw thrown)))) (lambda (error) (= error thrown)))
          (js-call assert :deepEqual trace (if (= stage "source") (js-array "source") (if (= stage "index") (js-array "source" "index") (js-array "source" "index" "callback")))))))))
  (defconst tryAsyncOracle
    (funcall (js* "(truth) => async function tryAsyncOracle(flag, log) { return await (async () => { try { log.push('begin'); await Promise.resolve(1); return truth(flag) ? 7 : 8; } finally { log.push('cleanup'); } })(); }") truth))
  (defun checkTry (m)
    (js-call (js-array false nil undefined 0 "" (js-object :marker 1)) :forEach
      (lambda (value)
        (let ((log (js-array)))
          (assert (Object/is (js-call m :try_tail value log) value))
          (js-call assert :deepEqual log (js-array "body" "catch" "finally")))
        (let ((log (js-array)))
          (js-call assert :equal (js-call m :try_discard value log) 9)
          (js-call assert :deepEqual log (js-array value "finally" "after")))
        (js-call assert :equal (js-call m :try_empty_catch value) nil)
        (assert (Object/is (js-call m :try_vector_catch value) value))
        (assert (Object/is (js-call m :try_map_catch value) value))
        (js-call assert :deepEqual (js-call m :try_operands value) (js-array 7 value))
        (let ((log (js-array)))
          (assert (Object/is (js-call m :try_nested_finally value log) value))
          (js-call assert :deepEqual log (js-array "inner")))
        (js-call (js-array false nil undefined (js-object :finally 1)) :forEach
          (lambda (marker)
            (let ((log (js-array)))
              (js-call assert :throws (lambda () (js-call m :try_override value marker log))
                (lambda (error) (Object/is error marker)))
              (js-call assert :deepEqual log (js-array "finally")))))))
    (js-call assert :equal (js-call m :try_empty) nil)
    (js-call assert :deepEqual (js-call m :try_scopes) (js-array 9 2))
    (js-call assert :equal (js-call m :try_local_recur) 3)
    (js-call assert :equal (js-call m :try_raw_var) "undefined")
    (let* ((receiver (js-object))
           (result (Reflect/apply (get m :try_raw) receiver (js-array 7))))
      (js-call assert :equal (get result :receiver) receiver)
      (js-call assert :equal (get result :value) 7)))
  (export truth oracle checkBoundary asyncOracle discardedOracle timeline checkSequential sequentialAsyncOracle checkTry tryAsyncOracle))
