  (defconst sourceRoot (fileURLToPath (new globalThis.URL "../.." (js* "import.meta.url"))))
  (defconst suite "tests/compiler-session-tools.test.mjs")
  (defconst eliSuite "tests/compiler-session-tools.test.eli")
  (defconst workerSuite "tests/worker-runtime.test.mjs")
  (defconst workerEli "tests/worker-runtime.test.eli")
  (defconst workerTitle "long-lived worker implements the versioned NDJSON protocol and maps failures through project source maps")
  (defconst titles (js-array
    "a complete real managed compiler driver transports AggregateError graphs with shared errors and cause identity"
    "the real compiler CLI emits structured source failures and preserves successful output with the same built artifact"
    "real CLI streaming UTF8 preserves split astral scalars BOM diagnostics and strict malformed-tail failures"))
  (defconst semanticFixtures (js-array "tests/fixtures/core-expression-forms.eli" "tests/fixtures/core-language-api-usage.eli" "tests/fixtures/core-stdlib-usage.eli" "tests/fixtures/wasm-managed-source-collections.eli" "tests/fixtures/managed-stdlib-value-json.eli"))
  (defconst semanticLocators (js-array "real JavaScript compiler sessions expose compile, format and read-only semantic tools" "tool definitions and references preserve shadowing, initializer scope and assignment roles" "parallel and sequential local bindings retain their distinct actual scopes" "Unicode scalar queries preserve exact source spans and reject invalid units or offsets" "macro invocation links to its definition while generated references retain truthful expansion origins" "read and analysis failures return the actual stable diagnostics and leave the session usable" "tool requests preserve cached runtime and project revision state" "production tools analyze complete existing fixture " "abort boundaries and close use the actual production compiler session lifecycle" "optional parameter defaults resolve in the enclosing scope before any required optional or rest parameter enters the function scope" "nested optional vector and map bindings preserve qualified local suffix spans rest bindings and actual write targets" "macros in unexpanded parameter patterns retain the original compiler refusal without invented semantic references" "parameter default queries preserve existing analyzer refusals and never invent references or new optional syntax" "Given nested empty and unrelated scopes When semantic tools resolve captures Then outer reads writes shadowing and unknown globals remain exact" "Given exact UTF16 source When semantic tools identify it Then SHA256 includes BOM astral and unmatched surrogate units" "Given an older semantic result When source or filename changes Then queries and edit previews reject its identity before parsing" "Given Unicode source and disjoint original scalar ranges When previewing a complete edit batch Then text and subsequent full analysis are exact" "Given insertion deletion EOF and unmatched UTF16 units When previewing edits Then scalar addressing never splits an original surrogate pair" "Given malformed ambiguous or overlapping edit batches When previewing Then the whole request refuses without publishing partial text" "Given macro and lexical tools results When previewing without publishing Then compiler caches and full-analysis origins stay isolated"))

  (defun sha256 (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun emitSuite (source filename) (emit-ir-string (compile-ir-string source filename)))
  (defasync services (&rest __host_forwarded_arguments_1)
    (let* ((transform (aref __host_forwarded_arguments_1 0)) (maintainedFile (aref __host_forwarded_arguments_1 1)))
    (let* ((records (js-array)) (files (new globalThis.Map)) (file undefined) (target (or maintainedFile eliSuite))
      (generated (if (= target workerEli) workerSuite suite)))
      (setq file (async (filename)
        (unless (js-call files :has filename)
          (let ((bytes (await (readFile (resolve sourceRoot filename)))))
            (cond ((and transform (= filename target)) (setq bytes (Buffer/from (funcall transform (js-call bytes :toString "utf8")))))
              ((and transform (= filename generated))
                (let* ((maintained (await (funcall file target))) (source (js-call (Buffer/from (get maintained :content) "base64") :toString "utf8")))
                  (setq bytes (Buffer/from (emitSuite source target))))))
            (js-call files :set filename (js-object :file filename :sha256 (sha256 bytes) :bytes (js-length bytes) :content (js-call bytes :toString "base64"))))) (js-call files :get filename)))
      (js-object :records records :sourceRoot sourceRoot :file file
        :text (async (filename) (js-call (Buffer/from (get (await (funcall file filename)) :content) "base64") :toString "utf8"))
        :add (lambda (record) (js-call records :push record))
        :locators (js-call titles :map (lambda (contains index) (js-object :file suite :id (str "original-tools-" index) :contains contains)))))))
  (defasync workerServices (&rest __host_forwarded_arguments_2)
    (let* ((transform (aref __host_forwarded_arguments_2 0)))
    (let ((fixture (await (services transform workerEli)))) (put fixture :locators (js-array (js-object :file workerSuite :id "original-worker-source-map" :contains workerTitle))) fixture)))
  (defasync semanticServices (&rest __host_forwarded_arguments_3)
    (let* ((transform (aref __host_forwarded_arguments_3 0)))
    (let ((fixture (await (services transform)))) (put fixture :locators (js-call semanticLocators :map (lambda (contains index) (js-object :file suite :id (str "semantic-tools-" index) :contains contains)))) fixture)))
  (defun region (source start end)
    (js-object :start start :end end :byteStart (Buffer/byteLength (js-call source :slice 0 start)) :byteEnd (Buffer/byteLength (js-call source :slice 0 end)) :sha256 (sha256 (js-call source :slice start end))))
  (defun verifyRegion (source r)
    (js-call assert :deepEqual r (region source (get r :start) (get r :end))))
  (defun astHead (node name) (and node (= (get node :kind) "list") (> (js-length (get node :items)) 0) (= (get (aref (get node :items) 0) :name) name)))
  (defun members (source &rest __host_forwarded_arguments_4)
    (let* ((filename (aref __host_forwarded_arguments_4 0)))
      (js-call (get (aref (read-string source (or filename eliSuite)) 0) :items) :slice 2)))
  (defun unitOffset (source point) (js-length (js-call (js-call (Array/from source) :slice 0 point) :join "")))
  (defun astRegion (source node) (region source (unitOffset source (get (get node :span) :start)) (unitOffset source (get (get node :span) :end))))
  (defun astText (source node) (let ((r (astRegion source node))) (js-call source :slice (get r :start) (get r :end))))
  (defun syntaxCases (source)
    (js-call (members source) :filter (lambda (n) (astHead n "test"))))
  (defun namedCase (source title)
    (let ((node (js-call (syntaxCases source) :find (lambda (n) (= (get (aref (get n :items) 1) :value) title))))) (assert node title) node))
  (defun maintainedRanges (source kind)
    (let* ((items (members source)) (first (namedCase source (aref titles 0))) (last (namedCase source (aref titles 2)))
      ;; namedCase parses a distinct AST. Match immutable source coordinates,
      ;; not object identity across those separate reader invocations.
      (a (js-call items :findIndex (lambda (node) (= (get (get node :span) :start) (get (get first :span) :start)))))
      (z (js-call items :findIndex (lambda (node) (= (get (get node :span) :start) (get (get last :span) :start))))))
      (if (= kind "artifact") (js-array (region source (get (astRegion source first) :start) (get (astRegion source last) :end)))
        (let* ((early (js-call items :find (lambda (n) (> (js-length (walk n (lambda (child) (astHead child "test")))) 0))))
          (tail (aref items (+ z 1))) (end (js-call items :at -1)))
          (js-array (region source (get (astRegion source early) :start) (get (astRegion source (aref items (- a 1))) :end))
            (region source (get (astRegion source tail) :start) (get (astRegion source end) :end)))))))
  (defun generatedCases (source &rest __host_forwarded_arguments_5)
    (let* ((filename (aref __host_forwarded_arguments_5 0))) (originalSourceCaseLocators (or filename suite) source)))
  (defun selectedCase (source title &rest __host_forwarded_arguments_6)
    (let* ((filename (aref __host_forwarded_arguments_6 0)))
    (let ((found (js-call (generatedCases source filename) :find (lambda (item) (= (get item :contains) title))))) (assert found title) (get found :originalCase))))
  (defun generatedRanges (source kind)
    (let* ((cases (generatedCases source)) (a (selectedCase source (aref titles 0))) (z (selectedCase source (aref titles 2))))
      (if (= kind "artifact") (js-array (region source (get (get a :span) :start) (get (get z :span) :end)))
        (let ((early (js-call cases :filter (lambda (item) (< (get (get (get item :originalCase) :span) :start) (get (get a :span) :start)))))
          (tail (js-call cases :filter (lambda (item) (> (get (get (get item :originalCase) :span) :start) (get (get z :span) :end))))))
          (js-array (region source (get (get (get (aref early 0) :originalCase) :span) :start) (get (get (get (js-call early :at -1) :originalCase) :span) :end))
            (region source (get (get (get (aref tail 0) :originalCase) :span) :start) (js-length source)))))))
  (defun verifyMaintained (record source kind)
    (let ((m (get (get record :original) :maintainedSource)))
      (js-call assert :equal (get m :sourceFile) eliSuite) (js-call assert :equal (get m :sourceSha256) (sha256 source))
      (js-call assert :deepEqual (get m :regions) (maintainedRanges source kind))
      (let* ((__eli_iteration_1_sequence (get m :regions))
       (__eli_iteration_1_iterator (let ((result (Reflect/apply (get __eli_iteration_1_sequence Symbol.iterator) __eli_iteration_1_sequence (js-array)))) (unless (and (not (nullish? result)) (= (funcall globalThis.Object result) result)) (throw (new globalThis.TypeError "iterator must return an object"))) result))
       (__eli_iteration_1_next (get __eli_iteration_1_iterator :next)) (__eli_iteration_1_step undefined)
       (__eli_iteration_1_active false) (__eli_iteration_1_done false) (__eli_iteration_1_failed false))
  (try
    (while (not __eli_iteration_1_done)
      (setq __eli_iteration_1_active false)
      (setq __eli_iteration_1_step (Reflect/apply __eli_iteration_1_next __eli_iteration_1_iterator (js-array)))
      (unless (and (not (nullish? __eli_iteration_1_step)) (= (funcall globalThis.Object __eli_iteration_1_step) __eli_iteration_1_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_1_step :done))
        (setq __eli_iteration_1_done t)
        (let ((r (get __eli_iteration_1_step :value)))
          (setq __eli_iteration_1_active t)
          (verifyRegion source r))))
    nil
    (catch __eli_iteration_1_error (setq __eli_iteration_1_failed t) (throw __eli_iteration_1_error))
    (finally
      (when (and __eli_iteration_1_active (not __eli_iteration_1_done))
        (try
          (let ((__eli_iteration_1_return (get __eli_iteration_1_iterator :return)))
            (unless (nullish? __eli_iteration_1_return) (Reflect/apply __eli_iteration_1_return __eli_iteration_1_iterator (js-array))))
          (catch __eli_iteration_1_close_error (unless __eli_iteration_1_failed (throw __eli_iteration_1_close_error)))))))) m))
  (defun replaceOnce (source before after)
    (js-call assert :equal (js-length (js-call source :split before)) 2 before) (js-call source :replace before after))
  (defun walk (node predicate)
    (let ((found (js-array)) (pending (js-array node)))
      (while (> (js-length pending) 0) (let ((n (js-call pending :pop))) (when (funcall predicate n) (js-call found :push n))
        (when (Array/isArray (get n :items)) (let* ((__eli_iteration_2_sequence (get n :items))
       (__eli_iteration_2_iterator (let ((result (Reflect/apply (get __eli_iteration_2_sequence Symbol.iterator) __eli_iteration_2_sequence (js-array)))) (unless (and (not (nullish? result)) (= (funcall globalThis.Object result) result)) (throw (new globalThis.TypeError "iterator must return an object"))) result))
       (__eli_iteration_2_next (get __eli_iteration_2_iterator :next)) (__eli_iteration_2_step undefined)
       (__eli_iteration_2_active false) (__eli_iteration_2_done false) (__eli_iteration_2_failed false))
  (try
    (while (not __eli_iteration_2_done)
      (setq __eli_iteration_2_active false)
      (setq __eli_iteration_2_step (Reflect/apply __eli_iteration_2_next __eli_iteration_2_iterator (js-array)))
      (unless (and (not (nullish? __eli_iteration_2_step)) (= (funcall globalThis.Object __eli_iteration_2_step) __eli_iteration_2_step))
        (throw (new globalThis.TypeError "iterator result is not an object")))
      (if (funcall (js* "(value) => !!value") (get __eli_iteration_2_step :done))
