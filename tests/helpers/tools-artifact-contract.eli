          (setq __eli_iteration_2_active t)
          (js-call pending :push child))))
    nil
    (catch __eli_iteration_2_error (setq __eli_iteration_2_failed t) (throw __eli_iteration_2_error))
    (finally
      (when (and __eli_iteration_2_active (not __eli_iteration_2_done))
        (try
          (let ((__eli_iteration_2_return (get __eli_iteration_2_iterator :return)))
            (unless (nullish? __eli_iteration_2_return) (Reflect/apply __eli_iteration_2_return __eli_iteration_2_iterator (js-array))))
          (catch __eli_iteration_2_close_error (unless __eli_iteration_2_failed (throw __eli_iteration_2_close_error))))))))))) found))
  (defun artifactChanges (source)
    (let* ((body (namedCase source (aref titles 0)))
      (trace (aref (walk body (lambda (n) (astHead n "withBackendPhaseTrace"))) 0))
      (check (aref (walk body (lambda (n) (and (astHead n "same") (js-call (astText source n) :startsWith "(same (js-call globalThis.WebAssembly.Module :imports")))) 0))
      (set (aref (walk body (lambda (n) (and (astHead n "setq") (= (get (aref (get n :items) 1) :name) "managed")))) 0))
      (wasmCheck (astText source check)))
      (js-array
        (js-array "(createCompilerSession (js-object :host \"javascript\" :compiler driver))" "(openSelected)")
        (js-array "(loadCompilerSources)" "(globalThis.structuredClone completeSources)")
        (js-array "(oracleSource (aggregateSource (get (pathToFileURL (resolve directory \"host/compiler-session.mjs\")) :href)))"
          "(oracleArtifact (await (buildSelectedArtifact producer \"aggregate-reference\" \"javascript\" (globalThis.structuredClone completeSources))))\n        (oracleSource (aggregateSource (get (pathToFileURL (get oracleArtifact :path)) :href)))")
        (js-array (astText source trace) "(buildSelectedArtifact producer \"aggregate-selected\" (get configuration :target) sources)")
        (js-array wasmCheck (str "(progn (ae (get artifact :host) (get configuration :target))\n            (when (= (get configuration :target) \"wasm\") " wasmCheck "))"))
        (js-array (astText source set) "(progn (setq managed (await (openArtifact artifact resources))) (ae (get managed :host) (get configuration :target)))"))))
  (defun changeHashes (changes) (js-call changes :map (lambda (pair) (js-object :role "selected-complete-compiler-transport" :beforeSha256 (sha256 (aref pair 0)) :afterSha256 (sha256 (aref pair 1))))))
  (defun assertCompilation (host receipt filename)
    ;; Recompile the exact projected Eli module independently. An AST match by
    ;; itself is insufficient: the emitted, executed host must be these bytes.
    (assert receipt "the replay binds its complete maintained compilation")
    (js-call assert :equal (get receipt :filename) filename)
    (js-call assert :equal (value-type (get receipt :source)) "string")
    (let* ((source (get receipt :source)) (compiled (emitSuite source filename))
           (names (js-array "array-text" "binding" "errors" "math" "number-radix" "prelude" "primitives" "unicode-case" "unicode-case-data"))
           (index 0))
      (js-call assert :equal (get receipt :sourceSha256) (sha256 source))
      (js-call assert :equal (get receipt :hostSha256) (sha256 host))
      (while (< index (js-length names))
        (let* ((name (aref names index))
               (before (JSON/stringify (str "eliscript/runtime/" name ".mjs")))
               (after (JSON/stringify (get (pathToFileURL (resolve sourceRoot (str "runtime/" name ".mjs"))) :href))))
          (setq compiled (js-call compiled :replaceAll before after)))
        (setq index (1+ index)))
      (js-call assert :equal host compiled "the complete host is the official compilation of the authenticated projected Eli")
      source))

  (defun assertSourceForms (projection source ranges filename)
    ;; Match complete actual forms, including nested assertion bodies. Text in
    ;; comments or literals cannot satisfy a form, and private emitter counters
    ;; are irrelevant to source identity.
    (let* ((projected (members projection filename))
           (available (new globalThis.Map)) (original (members source filename))
           (count 0) (index 0))
      (while (< index (js-length projected))
        (let* ((text (astText projection (aref projected index)))
               (old (js-call available :get text)))
          (js-call available :set text (1+ (if (undefined? old) 0 old))))
        (setq index (1+ index)))
      (setq index 0)
      (while (< index (js-length original))
        (let* ((node (aref original index)) (r (astRegion source node))
               (selected (js-call ranges :some (lambda (range)
                 (and (>= (get r :start) (get range :start)) (<= (get r :end) (get range :end)))))))
          (when selected
            (let* ((text (astText source node)) (remaining (js-call available :get text)))
              (assert (and (not (undefined? remaining)) (> remaining 0))
                (str "complete original Eli assertion form is retained: " text))
              (js-call available :set text (1- remaining))
              (setq count (1+ count)))))
        (setq index (1+ index)))
      (assert (> count 0) "the selected range must contain executable original forms")))

  (defun assertCompiledReplay (host maintained changes kind receipt)
    (let ((modified maintained) (index 0)
          (projection (assertCompilation host receipt
            (if (= kind "artifact") "original-tools-artifact-host.eli" "original-semantic-tools-host.eli"))))
      (while (< index (js-length changes))
        (let* ((ranges (maintainedRanges modified kind)) (r (aref ranges 0))
               (body (js-call modified :slice (get r :start) (get r :end)))
               (pair (aref changes index)))
          (setq body (replaceOnce body (aref pair 0) (aref pair 1)))
          (setq modified (str (js-call modified :slice 0 (get r :start)) body (js-call modified :slice (get r :end)))))
        (setq index (1+ index)))
      (assertSourceForms projection modified (maintainedRanges modified kind) eliSuite)))

  (defun assertRetainedFunctions (host source names receipt &rest supplied)
    (let* ((filename (if (undefined? (aref supplied 0)) eliSuite (aref supplied 0)))
           (original (members source filename)) (projection (get receipt :source))
           (selected (members projection (get receipt :filename))) (index 0))
      (js-call assert :equal (get receipt :hostSha256) (sha256 host))
      (while (< index (js-length names))
        (let* ((name (aref names index))
               (matches (lambda (node)
                 (and (or (astHead node "defun") (astHead node "defasync"))
                   (= (get (aref (get node :items) 1) :name) name))))
               (before (js-call original :filter matches)) (after (js-call selected :filter matches)))
          (js-call assert :equal (js-length before) 1 name)
          (js-call assert :equal (js-length after) 1 name)
          (js-call assert :equal (astText projection (aref after 0)) (astText source (aref before 0))
            (str "the complete maintained helper remains in the compiled replay: " name)))
        (setq index (1+ index)))))

  (defun assertWorkerReplay (host maintained receipt)
    (let* ((case (namedCase maintained workerTitle))
           (calls (walk case (lambda (n) (and (astHead n "await") (astHead (aref (get n :items) 1) "runSuccessful")))))
           (projection (assertCompilation host receipt "original-worker-source-mapping-host.eli")))
      (js-call assert :equal (js-length calls) 1)
      (let* ((before (astText maintained (aref calls 0)))
             (replacement
        "(let ((compiler (await (openSelected))))\n            (try\n              (await (compileSelectedWorker\n                       (js-object :input fixturePath :output modulePath :sourceMap t\n                         :compiler (js-object\n                                     :build_operation_request\n                                     (lambda (input)\n                                       (js-call compiler :request\n                                         (js-object :operation \"protocol\" :name \"build-operation-request\" :input input)))\n                                     :compile_string_with_source_map\n                                     (lambda (source filename generatedFile sourceName)\n                                       (js-call compiler :request\n                                         (js-object :operation \"compile\" :source source :filename filename\n                                           :sourceMap (js-object :generatedFile generatedFile :sourceName sourceName))))))))\n              (finally (js-call compiler :close))))")
             (modified (replaceOnce maintained before replacement))
             (node (namedCase modified workerTitle)))
        (assertSourceForms projection modified (js-array (astRegion modified node)) workerEli))
      (assertRetainedFunctions host maintained
        (js-array "runSuccessful" "createWorkerClient" "scoreValues" "sendChunkedRequest" "receiveChunkedValue") receipt workerEli)))

  (export sourceRoot suite eliSuite workerSuite workerEli workerTitle titles semanticFixtures semanticLocators sha256 services workerServices semanticServices region verifyRegion members astHead astRegion astText syntaxCases namedCase maintainedRanges generatedCases selectedCase generatedRanges verifyMaintained replaceOnce artifactChanges changeHashes assertCompiledReplay assertRetainedFunctions assertWorkerReplay))
