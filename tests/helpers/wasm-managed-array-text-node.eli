(module tests.helpers.wasm-managed-array-text-node
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defun is-type-error (err)
    (funcall (js* "(a, b) => a instanceof b") err globalThis.TypeError))

  (defasync main ()
    (let ((mode (aref (get globalThis.process :argv) 2)))
      (if (= mode "js")
        (let* ((m (await (dynamic-import (aref (get globalThis.process :argv) 3))))
               (cycle (js-array 1))
               (a (js-array "x"))
               (trace (js-object))
               (live (js-array nil "old")))
          (js-call assert :equal (js-call m :join_value (new globalThis.Array 3) undefined) ",,")
          (js-call assert :equal
            (js-call m :join_value (js-array nil undefined -0.0 globalThis.NaN "😀") "|")
            "||0|NaN|😀")
          (js-call cycle :push cycle 3)
          (js-call assert :throws
            (lambda () (js-call m :join_value cycle ":"))
            (lambda (e)
              (and (is-type-error e)
                   (get e :eliscriptDiagnostic)
                   (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0009"))))
          (js-call assert :equal (js-call m :join_value a (js-call m :growing_separator a trace)) "x")
          (js-call assert :deepEqual a (js-array "x" "late"))
          (put live 0 (js-call m :live_element live))
          (js-call assert :equal (js-call m :join_value live "|") "first|changed"))
        (let* ((rt-mod (await (dynamic-import (aref (get globalThis.process :argv) 3))))
               (instantiateManagedRuntime (get rt-mod :instantiateManagedRuntime))
               (a (funcall instantiateManagedRuntime (readFileSync (aref (get globalThis.process :argv) 4)))))
          (js-call a :auto 1)
          (let* ((text (js-call a :string "中😀\ud800"))
                 (trace (js-call a :sourceObject (js-object)))
                 (object (js-call a :invoke "fallback-value" (js-array trace text)))
                 (values (js-call a :sourceArray (js-array object nil undefined)))
                 (bar (js-call a :string "|"))
                 (out (js-call a :invoke "join-value" (js-array values bar))))
            (js-call assert :equal (js-call a :readString out) "中😀\ud800||")
            (js-call a :resize values 5)
            (let* ((sparse (js-call a :invoke "default-value" (js-array values)))
                   (_ (js-call assert :equal (js-call a :readString sparse) "中😀\ud800,,,,"))
                   (custom (js-call a :invoke "own-join" (js-array values text)))
                   (direct (js-call a :invoke "text-value" (js-array values))))
              (js-call assert :equal (js-call a :readString direct) "中😀\ud800")
              (js-call (js-array text trace object values bar out sparse custom direct) :forEach
                (lambda (v) (js-call a :release v)))
              (js-call a :closeModule)
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))

  (main))
