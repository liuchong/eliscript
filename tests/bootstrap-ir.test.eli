(module tests.bootstrap-ir
  (import "bun:test" expect test beforeAll afterAll)
  (import "node:fs/promises" mkdtemp rm readFile mkdir symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../bootstrap/host/bun.mjs" loadCompiler)
  (import "../tools/testing/compiler-fixture-process.mjs" runCompilerFixture)
  (defvar directory undefined)
  (defvar compiler undefined)
  (defvar node-kinds undefined)
  (defvar expected undefined)
  (defvar fixture undefined)
  (defconst fixture-path (resolve root "tests/fixtures/bootstrap-ir.json"))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-ir-"))))
    (await (runCompilerFixture (js-array (resolve root "bin/eliscript-bootstrap"))
      (js-object :cwd root :env (Object/assign (js-object) (get globalThis.process :env)
        (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory))) 110000))
    (setq compiler (await (loadCompiler directory)))
    (let ((alias (resolve directory "ir-loader")))
      (await (mkdir alias))
      (await (symlink (resolve directory "ir.mjs") (resolve alias "compiler.mjs") "file"))
      (setq node-kinds (get (await (loadCompiler alias)) :node_kinds)))
    (setq fixture (JSON/parse (await (readFile fixture-path "utf8"))))
    (setq expected (JSON/parse (await (runCompilerFixture
      (js-array (get (get globalThis.process :env) :EMACS "emacs") "--batch" "-Q" "-L" "compiler"
        "-L" "tests" "--script" (resolve root "tests/bootstrap-ir-oracle.el"))
      (js-object :cwd root :env (Object/assign (js-object) (get globalThis.process :env)
        (js-object :ELISCRIPT_IR_FIXTURE fixture-path))) 20000))))) 150000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "bootstrapped lowerer matches complete seed IR trees and spans"
    (async ()
      (let ((generated (js-array)) (index 0) (kinds (new globalThis.Set)))
        (while (< index (js-length (get fixture :valid)))
          (let* ((entry (aref (get fixture :valid) index))
                 (source (if (Object/hasOwn entry "source") (get entry :source)
                           (await (readFile (resolve root (get entry :file)) "utf8"))))
                 (program (js-call compiler :compile_ir_string source (get entry :filename))))
            (js-call generated :push (js-object :name (get entry :name) :status "ok" :program program))
            (letfn ((visit (node)
              (js-call kinds :add (get node :kind)) (js-call (get node :children) :forEach visit)))
              (js-call (get program :body) :forEach visit)))
          (setq index (1+ index)))
        (js-call (expect generated) :toEqual expected)
        (js-call (expect (js-call (Array/from kinds) :sort)) :toEqual (js-call (js-call node-kinds :slice) :sort))
        (js-call (expect (await (readFile (resolve directory "lower.mjs.map") "utf8")))
          :toContain "bootstrap/compiler/lower.eli"))) 30000))
