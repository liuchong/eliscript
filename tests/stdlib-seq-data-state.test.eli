(module tests.stdlib-seq-data-state
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp rm symlink)
  (import "node:path" resolve)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "../runtime/core/array-map.mjs" EMPTY_ARRAY_MAP persistentArrayMap)
  (import "../runtime/core/collection.mjs" count)
  (import "../runtime/core/identifier.mjs" eliscriptSymbol keyword qualifiedIdentifierName)
  (import "../runtime/core/list.mjs" persistentList)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/vector.mjs" EMPTY_VECTOR persistentVector)

  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst EMACS (let ((v (get (get process :env) :EMACS))) (if (nullish? v) "emacs" v)))
  (defconst dynamic-import (js* "(url) => import(url)"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))

  (defasync compile-stdlib (modules)
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-s3-seq-data-state-"))))
           (out-root (resolve directory "stdlib")))
      (try
        (await (symlink (resolve ROOT "runtime") (resolve directory "runtime") "dir"))
        (let* ((cmd (js-call (js-array (resolve ROOT "bin/eliscript-build") "--json" "--root" (resolve ROOT "stdlib") "--out-dir" out-root "--no-cache")
                      :concat (js-call modules :map (lambda (m) (resolve ROOT (str "stdlib/" m ".eli"))))))
               (child (Bun/spawn cmd (js-object :cwd ROOT :env (Object/assign (js-object) (get process :env) (js-object :EMACS EMACS)) :stdout "pipe" :stderr "pipe")))
               (res (await (Promise/all (js-array (get child :exited)
                                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                                  (js-call (new globalThis.Response (get child :stderr)) :text))))))
          (unless (= (aref res 0) 0)
            (throw (new globalThis.Error (str "build failed: " (aref res 2) "\n" (aref res 1))))))
        (let ((loaded (js-object))
              (idx 0))
          (while (< idx (js-length modules))
            (let* ((m (aref modules idx))
                   (ns (await (funcall dynamic-import (get (pathToFileURL (resolve out-root (str m ".mjs"))) :href)))))
              (put loaded m ns))
            (setq idx (1+ idx)))
          (js-object :directory directory :mods loaded))
        (catch err
          (await (rm directory (js-object :recursive t :force t)))
          (throw err)))))

  (test "seq vector variants, random sampling, collection/array-map?, and transducer halt-when"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "collection" "seq" "transducer" "data" "state" "tap"))))
             (directory (get built :directory))
             (mods (get built :mods))
             (C (get mods :collection))
             (S (get mods :seq))
             (T (get mods :transducer))
             (D (get mods :data)))
        (try
          ;; collection/array-map?
          (be (js-call C :array_map_QMARK_ EMPTY_ARRAY_MAP) t)
          (be (js-call C :array_map_QMARK_ (persistentArrayMap (js-array (keyword "a") 1))) t)
          (be (js-call C :array_map_QMARK_ (persistentHashMap (js-array (keyword "a") 1))) false)
          (be (js-call C :array_map_QMARK_ EMPTY_VECTOR) false)

          ;; seq/vec, removev, keepv, partitionv, partitionv-all, splitv-at, shuffle, random-sample
          (same (Array/from (js-call S :vec nil)) (js-array))
          (same (Array/from (js-call S :vec (persistentList 10 20 30))) (js-array 10 20 30))
          (be (js-call C :vector_QMARK_ (js-call S :vec (persistentHashSet 1 2))) t)
          (let ((items (persistentVector 1 2 3 4 5)))
            (same (Array/from (js-call S :removev (lambda (x) (= (% x 2) 0)) items)) (js-array 1 3 5))
            (same (Array/from (js-call S :keepv (lambda (x) (if (> x 2) (* x 10) nil)) items)) (js-array 30 40 50))
            (same (js-call (Array/from (js-call S :partitionv 2 items)) :map (lambda (v) (Array/from v))) (js-array (js-array 1 2) (js-array 3 4)))
            (same (js-call (Array/from (js-call S :partitionv_all 2 items)) :map (lambda (v) (Array/from v))) (js-array (js-array 1 2) (js-array 3 4) (js-array 5)))
            (same (js-call (Array/from (js-call S :partitionv 2 1 (persistentVector 9) items)) :map (lambda (v) (Array/from v)))
              (js-array (js-array 1 2) (js-array 2 3) (js-array 3 4) (js-array 4 5) (js-array 5 9)))
            (let ((split (js-call S :splitv_at 2 items)))
              (be (js-call C :vector_QMARK_ split) t)
              (same (Array/from (js-call split :nth 0)) (js-array 1 2))
              (same (Array/from (js-call split :nth 1)) (js-array 3 4 5))))
          ;; shuffle preserves multiset & returns persistent vector without mutating input
          (let* ((orig (persistentVector 1 2 2 3 4 5))
                 (shuffled (js-call S :shuffle orig)))
            (be (js-call C :vector_QMARK_ shuffled) t)
            (be (count shuffled) 6)
            (same (js-call (Array/from shuffled) :sort (lambda (a b) (- a b))) (js-array 1 2 2 3 4 5))
            (same (Array/from orig) (js-array 1 2 2 3 4 5)))
          ;; random-sample boundaries 0.0 and 1.0
          (same (Array/from (js-call S :random_sample 0 (persistentVector 1 2 3 4))) (js-array))
          (same (Array/from (js-call S :random_sample 1 (persistentVector 1 2 3 4))) (js-array 1 2 3 4))

          ;; transducer halt-when (short-circuits and skips downstream completing cleanup corruption)
          (let ((halted-into (js-call T :into EMPTY_VECTOR
                               (js-call T :halt_when (lambda (x) (> x 3)) (lambda (acc input) (js-call C :conj acc (str "halted:" input))))
                               (persistentVector 1 2 3 4 5 6)))
                (halted-retf (js-call T :transduce
                               (js-call T :compose_transducers
                                 (js-call T :mapping (lambda (x) (* x 10)))
                                 (js-call T :halt_when (lambda (x) (>= x 30)) (lambda (acc input) (js-object :acc acc :stopped input))))
                               (lambda (&rest args) (if (= (js-length args) 1) (aref args 0) (if (= (js-length args) 0) EMPTY_VECTOR (js-call C :conj (aref args 0) (aref args 1)))))
                               EMPTY_VECTOR
                               (persistentVector 1 2 3 4))))
            (same (Array/from halted-into) (js-array 1 2 3 "halted:4"))
            (be (get halted-retf :stopped) 30)
            (same (Array/from (get halted-retf :acc)) (js-array 10 20)))

          ;; data deep-merge, deep-merge-with, keywordize-keys, stringify-keys, parsers
          (let* ((m1 (persistentHashMap
                       (js-array (keyword "a") (persistentHashMap (js-array (keyword "x") 1) (js-array (keyword "y") 2)))
                       (js-array (keyword "b") 10)))
                 (m2 (persistentHashMap
                       (js-array (keyword "a") (persistentHashMap (js-array (keyword "y") 20) (js-array (keyword "z") 30)))
                       (js-array (keyword "b") 99)))
                 (merged (js-call D :deep_merge m1 m2))
                 (summed (js-call D :deep_merge_with (lambda (l r) (+ l r)) m1 m2)))
            (be (js-call D :get_in merged (persistentVector (keyword "a") (keyword "x"))) 1)
            (be (js-call D :get_in merged (persistentVector (keyword "a") (keyword "y"))) 20)
            (be (js-call D :get_in merged (persistentVector (keyword "a") (keyword "z"))) 30)
            (be (js-call D :get_in merged (persistentVector (keyword "b"))) 99)
            (be (js-call D :get_in summed (persistentVector (keyword "a") (keyword "y"))) 22)
            (be (js-call D :get_in summed (persistentVector (keyword "b"))) 109))
          (let* ((raw (withMeta
                        (persistentHashMap
                          (js-array "outer" (persistentVector (persistentHashMap (js-array "ns/inner" 42)))))
                        (persistentHashMap (js-array (keyword "tag") "keep"))))
                 (kw (js-call D :keywordize_keys raw))
                 (back (js-call D :stringify_keys kw)))
            (be (js-call C :lookup (meta kw) (keyword "tag")) "keep")
            (be (js-call D :get_in kw (persistentVector (keyword "outer") 0 (keyword "ns/inner"))) 42)
            (be (js-call D :get_in back (persistentVector "outer" 0 "ns/inner")) 42))
          (be (js-call D :parse_long "42") 42)
          (be (js-call D :parse_long "-0") 0)
          (be (js-call D :parse_long "42.5") nil)
          (be (js-call D :parse_long "9007199254740993") nil)
          (be (js-call D :parse_double " -3.5e2 ") -350)
          (be (Number/isNaN (js-call D :parse_double "NaN")) t)
          (be (js-call D :parse_double "Infinity") (get globalThis/Number :POSITIVE_INFINITY))
          (be (js-call D :parse_double "nope") nil)
          (be (js-call D :parse_boolean "true") t)
          (be (js-call D :parse_boolean "false") false)
          (be (js-call D :parse_boolean "1") nil)
          (be (js-call D :parse_long "") nil)
          (be (js-call D :parse_double "") nil)
          (same (Array/from (js-call S :removev (lambda () t) EMPTY_VECTOR)) (js-array))
          (js-call (expect (lambda () (js-call D :parse_long 42))) :toThrow "parse-long expects a string")
          (js-call (expect (lambda () (js-call D :parse_double 42))) :toThrow "parse-double expects a string")
          (js-call (expect (lambda () (js-call D :parse_boolean 42))) :toThrow "parse-boolean expects a string")
          (finally
            (await (rm directory (js-object :recursive t :force t)))))))
    60000)

  (test "state volatile!, bound-fn, and error-isolated bounded tap> channel"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "persistent-vector" "state" "tap"))))
             (directory (get built :directory))
             (mods (get built :mods))
             (PV (get mods :persistent-vector))
             (ST (get mods :state))
             (TP (get mods :tap)))
        (try
          ;; volatile! & deref
          (let ((v (js-call ST :volatile_BANG_ 10))
                (a (js-call ST :atom 5))
                (d (js-call ST :delay (lambda () 77))))
            (be (js-call ST :volatile_QMARK_ v) t)
            (be (js-call ST :volatile_QMARK_ a) false)
            (be (js-call ST :vderef v) 10)
            (be (js-call ST :deref v) 10)
            (be (js-call ST :deref a) 5)
            (be (js-call ST :deref d) 77)
            (be (js-call ST :vreset_BANG_ v 20) 20)
            (be (js-call ST :vswap_BANG_ v (lambda (cur delta) (+ cur delta)) 5) 25)
            (same (js-call PV :persistent_vector_to_array (js-call ST :vswap_vals_BANG_ v (lambda (cur) (* cur 2)))) (js-array 25 50))
            (be (js-call ST :deref v) 50)
            (js-call (expect (lambda () (js-call ST :deref 42))) :toThrow "operation requires an Atom")
            (js-call (expect (lambda () (js-call ST :vderef 42))) :toThrow "operation requires a Volatile reference")
            (js-call (expect (lambda () (JSON/stringify v))) :toThrow "Volatile reference cannot be serialized")
            (js-call (expect (lambda () (js-call ST :bound_fn "bad"))) :toThrow "bound-fn requires a function")
            (let ((bf (js-call ST :bound_fn (lambda (x y) (+ x y)))))
              (be (funcall bf 3 4) 7)))

          ;; tap> error isolation, queue bound, flush-taps!, remove-tap, clear-taps!
          (js-call TP :clear_taps_BANG_)
          (let* ((seen (js-array))
                 (good (lambda (v) (js-call seen :push v)))
                 (bad (lambda () (throw (new globalThis.Error "boom"))))
                 (dropped 0))
            (js-call TP :add_tap good)
            (js-call TP :add_tap good)
            (be (get (js-call TP :tap_stats) :listeners) 1)
            (js-call TP :add_tap bad)
            (be (js-call TP :tap_GT_ nil) false)
            (js-call (expect (lambda () (js-call TP :add_tap "not-fn"))) :toThrow "tap listener must be a function")
            (be (js-call TP :tap_GT_ "first") t)
            (be (js-call TP :tap_GT_ "second") t)
            (be (js-call TP :flush_taps_BANG_) 2)
            (same seen (js-array "first" "second"))
            (let ((stats (js-call TP :tap_stats)))
              (be (get stats :delivered) 2)
              (be (get stats :errors) 2)
              (be (get stats :dropped) 0))
            ;; Bounded capacity (MAX_TAP_QUEUE = 1024): pushing 1030 before flush drops extras cleanly
            (js-call TP :remove_tap bad)
            (let ((i 0))
              (while (< i 1030)
                (unless (js-call TP :tap_GT_ i)
                  (setq dropped (1+ dropped)))
                (setq i (1+ i))))
            (be (> dropped 0) t)
            (be (js-call TP :flush_taps_BANG_) 1024)
            (js-call TP :remove_tap good)
            (js-call TP :clear_taps_BANG_))
          (finally
            (await (rm directory (js-object :recursive t :force t)))))))
    60000)
)
