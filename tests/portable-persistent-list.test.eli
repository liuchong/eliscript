(module tests.portable-persistent-list
  (import "bun:test" expect test)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries assertSourceMap sourceMap generatedModuleLoader be same)
  (import "./helpers/portable-structure.mjs" nextRandom)
  (defconst importGeneratedModule (generatedModuleLoader "persistent-list"))
  (test "Eliscript-authored persistent list compiles and agrees across hosts"
    (async () (await (withPortableLibraries
      (js-object :module "persistent-list" :sources (js-array "persistent-list") :fixture "tests/fixtures/portable-list-host.mjs" :loader false)
      (async (context)
        (same (get context :report) (js-object :persistent t :empty t :count 1000000 :first 999999 :probes (js-array 999999 999968 999967 998975 967231 0)
          :sum 499999500000 :restShared t :popShared t :reversedFirst 0 :reversedLast 999999 :sample (js-array "a" "b" "c")))
        (await (assertSourceMap (get context :seedDirectory) "persistent-list" (js-array "(defportable persistent-list-cons")))
        (js-call (expect (js-length (get (await (sourceMap (get context :seedDirectory) "persistent-list")) :mappings))) :toBeGreaterThan 0))))) 30000)
  (test "Eliscript-authored persistent list preserves generated history"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "history")))
             (emptyPersistentList (get module :empty_persistent_list)) (persistentListCount (get module :persistent_list_count))
             (persistentListCons (get module :persistent_list_cons)) (persistentListConj (get module :persistent_list_conj))
             (persistentListFirst (get module :persistent_list_first)) (persistentListRest (get module :persistent_list_rest))
             (persistentListPeek (get module :persistent_list_peek)) (persistentListPop (get module :persistent_list_pop))
             (persistentListNth (get module :persistent_list_nth)) (persistentListToArray (get module :persistent_list_to_array))
             (persistentListFromArray (get module :persistent_list_from_array)) (random (js-object :value 290963678))
             (list (emptyPersistentList)) (model (js-array)) (step 0))
        (be (persistentListFirst list "empty") "empty") (be (persistentListRest list "empty") "empty") (be (persistentListPeek list "empty") "empty")
        (be (persistentListPop list) nil) (be (persistentListNth list 0 "missing") "missing") (be (persistentListNth list 1.5 "missing") "missing")
        (while (< step 20000)
          (let* ((previousList list) (previousModel model) (choice (% (nextRandom random) 10)))
            (if (or (< choice 6) (= (js-length model) 0))
              (let ((value (nextRandom random)))
                (setq list (if (= (% choice 2) 0) (persistentListCons list value) (persistentListConj list value))
                      model (js-call model :concat (js-array value)))
                (be (persistentListRest list nil) previousList))
              (progn (setq list (persistentListPop list) model (js-call model :slice 0 -1)) (be list (persistentListRest previousList nil))))
            (be (persistentListCount list) (js-length model)) (be (persistentListCount previousList) (js-length previousModel))
            (when (> (js-length model) 0)
              (let ((probe (% (nextRandom random) (js-length model))))
                (be (persistentListNth list probe "missing") (aref model (- (js-length model) 1 probe)))
                (be (persistentListPeek list "empty") (aref model (- (js-length model) 1)))))
            (when (> (js-length previousModel) 0)
              (let ((probe (% (nextRandom random) (js-length previousModel))))
                (be (persistentListNth previousList probe "missing") (aref previousModel (- (js-length previousModel) 1 probe))))))
          (setq step (1+ step)))
        (let ((orderedModel (js-call model :toReversed)))
          (same (persistentListToArray list) orderedModel) (same (persistentListToArray (persistentListFromArray orderedModel)) orderedModel)))) 30000)
  (test "Eliscript-authored persistent list shares a million-node suffix"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "million"))) (list (funcall (get module :empty_persistent_list))) (value 0))
        (while (< value 1000000) (setq list (funcall (get module :persistent_list_cons) list value) value (1+ value)))
        (let ((extended (funcall (get module :persistent_list_cons) list -1)))
          (be (funcall (get module :persistent_list_count) list) 1000000) (be (funcall (get module :persistent_list_count) extended) 1000001)
          (be (funcall (get module :persistent_list_first) list "empty") 999999) (be (funcall (get module :persistent_list_nth) list 999999 "missing") 0)
          (be (funcall (get module :persistent_list_reduce) (lambda (sum value) (+ sum value)) 0 list) 499999500000)
          (be (funcall (get module :persistent_list_rest) extended nil) list) (be (funcall (get module :persistent_list_pop) extended) list)))) 30000))
