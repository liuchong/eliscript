      (let ((kind (% (unsigned-bit-shift-right (funcall random) 16) 5)))
        (cond ((= kind 0) (str "(progn (setq x " (expressionEffects random (- depth 1)) ") " (expressionEffects random (- depth 1)) ")"))
          ((= kind 1) (str "(let ((x " (expressionEffects random (- depth 1)) ")) (+ x (progn (setq y " (expressionEffects random (- depth 1)) ") y)))"))
          ((= kind 2) (str "(if (< x y) " (expressionEffects random (- depth 1)) " " (expressionEffects random (- depth 1)) ")"))
          (t (let ((operator (aref (js-array "+" "-" "*" "/") (% (unsigned-bit-shift-right (funcall random) 16) 4))))
