(module tests.esm-imports
  (import "bun:test" expect test beforeAll afterAll)
  (import "node:fs/promises" mkdtemp mkdir rm readFile writeFile symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" root)
  (import "../bootstrap/host/bun.mjs" loadCompiler)
  (import "../tools/testing/compiler-fixture-process.mjs" runCompilerFixture)
  (defvar directory undefined)
  (defvar compiler-directory undefined)
  (defvar compiler undefined)
  (defun environment (&rest extra)
    (Object/assign (js-object) (get globalThis.process :env) (aref extra 0)))
  (defasync run (command options)
    (await (runCompilerFixture command (Object/assign (js-object :cwd root) options) 20000)))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-esm-imports-"))))
    (setq compiler-directory (resolve directory "compiler"))
    (await (mkdir (resolve directory "node_modules")))
    (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
    (await (runCompilerFixture (js-array (resolve root "bin/eliscript-bootstrap"))
      (js-object :cwd root :env (environment (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compiler-directory))) 110000))
    (setq compiler (await (loadCompiler compiler-directory)))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "complete ESM imports are identical and executable across compilers and hosts"
    (async ()
      (let* ((input (resolve directory "imports.eli"))
             (seed-directory (resolve directory "seed")) (self-directory (resolve directory "self-hosted"))
             (seed-output (resolve seed-directory "imports.mjs")) (self-output (resolve self-directory "imports.mjs"))
             (source (str "(import \"./provider.mjs\")\n"
               "(import \"./provider.mjs\" :default default-value effect-count named-value)\n"
               "(import \"./provider.mjs\" :default namespace-default :as Provider)\n"
               "(defun report ()\n"
               "  (js-array default-value\n"
               "            named-value\n"
               "            namespace-default\n"
               "            (get Provider \"namespace_value\")\n"
               "            (effect-count)))\n"
               "(export report)\n"))
             (provider (js-call compiler :compile_string
               (str "(put globalThis.globalThis \"__eliscript_import_effects\" (1+ (if (nullish? (get globalThis.globalThis \"__eliscript_import_effects\")) 0 (get globalThis.globalThis \"__eliscript_import_effects\"))))\n"
                 "(defconst named-value 22) (defconst namespace-value 33)"
                 "(defun effect-count () (get globalThis.globalThis \"__eliscript_import_effects\"))"
                 "(export named-value namespace-value effect-count) (export-default 11)") "provider.eli")))
        (await (mkdir seed-directory (js-object :recursive t)))
        (await (mkdir self-directory (js-object :recursive t)))
        (await (writeFile input source))
        (await (run (js-array (resolve root "bin/eliscript-seed") "--source-map" "--output" seed-output input)
          (js-object :env (environment))))
        (await (run (js-array (resolve root "bin/eliscript-portable") "--source-map" "--output" self-output input)
          (js-object :env (environment (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR compiler-directory)))))
        (await (writeFile (resolve seed-directory "provider.mjs") provider))
        (await (writeFile (resolve self-directory "provider.mjs") provider))
        (let ((javascript (await (readFile seed-output "utf8"))))
          (js-call (expect (await (readFile self-output "utf8"))) :toBe javascript)
          (js-call (expect (await (readFile (str self-output ".map") "utf8"))) :toBe (await (readFile (str seed-output ".map") "utf8")))
          (js-call (expect javascript) :toContain "import \"./provider.mjs\";")
          (js-call (expect javascript) :toContain "import default_value, {effect_count, named_value} from \"./provider.mjs\";")
          (js-call (expect javascript) :toContain "import namespace_default, * as Provider from \"./provider.mjs\";"))
        (let ((outputs (js-array seed-directory self-directory)) (hosts (js-array (get globalThis.process :execPath) "node")) (index 0))
          (while (< index (js-length outputs))
            (let* ((output (aref outputs index)) (runner (resolve output "runner.mjs")))
              (await (writeFile runner (js-call compiler :compile_string
                "(import \"./imports.mjs\" report) (console/log (JSON/stringify (report)))" "runner.eli")))
              (let ((position 0))
                (while (< position (js-length hosts))
                  (let* ((stdout (await (run (js-array (aref hosts position) runner) (js-object))))
                         (actual (JSON/parse (js-call (js-call (js-call stdout :trim) :split "\n") :at -1))))
                    (js-call (expect actual) :toEqual (js-array 11 22 11 33 1)))
                  (setq position (1+ position)))))
            (setq index (1+ index)))))) 30000))
