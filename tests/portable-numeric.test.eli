(module tests.portable-numeric
  (import "bun:test" test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries pruneLibrary assertSourceMap be same contains excludes)
  (test "portable numeric functions preserve exact Number and safe-integer contracts"
    (async () (await (withPortableLibraries
      (js-object :module "numeric" :sources (js-array "numeric") :fixture "tests/fixtures/portable-numeric-host.mjs" :loader false :parallelHosts false)
      (async (context)
        (let ((report (get context :report)))
      (same (get report :classification) (js-object "number" (js-array t t false false) "finite" (js-array t t false false) "nan" (js-array t false false) "infinite" (js-array t t false) "integer" (js-array t t false false) "safeInteger" (js-array t t false false) "zero" (js-array t t false) "positive" (js-array t t false false) "negative" (js-array t t false false) "parity" (js-array t t t t false false)))
      (same (get report :scalar) (js-object "abs" (js-array 9 4 t nil) "absNan" t "absInfinity" t "sign" (js-array (- 1) (- 1) 0 1 1 nil) "signNan" t "compare" (js-array (- 1) 0 1 nil nil) "minimum" (- 3) "maximum" 12 "minInfinity" t "maxInfinity" t "minNan" t "maxNan" t "minInvalid" nil "maxInvalid" nil "clamp" (js-array 5 0 10 nil nil) "clampNan" t))
      (same (get report :checked) (js-object "add" (js-array 42 globalThis.Number.MAX_SAFE_INTEGER nil) "subtract" (js-array (- 2) (- globalThis.Number.MAX_SAFE_INTEGER) nil) "multiply" (js-array 42 0 nil) "invalid" (js-array nil nil nil) "normalizedZeros" (js-array t t t)))
      (same (get report :division) (js-object "cases" (js-array (js-object "dividend" 5 "divisor" 3 "quot" 1 "rem" 2 "modulo" 2) (js-object "dividend" (- 5) "divisor" 3 "quot" (- 1) "rem" (- 2) "modulo" 1) (js-object "dividend" 5 "divisor" (- 3) "quot" (- 1) "rem" 2 "modulo" (- 1)) (js-object "dividend" (- 5) "divisor" (- 3) "quot" 1 "rem" (- 2) "modulo" (- 2)) (js-object "dividend" 6 "divisor" (- 3) "quot" (- 2) "rem" 0 "modulo" 0)) "invalid" (js-array nil nil nil) "normalizedZeros" (js-array t t t)))
      (same (get report :integerAlgorithms) (js-object "gcd" (js-array 6 6 0 globalThis.Number.MAX_SAFE_INTEGER) "lcm" (js-array 42 42 0 globalThis.Number.MAX_SAFE_INTEGER) "invalid" (js-array nil nil nil) "fibonacciGcd" 2))
      (same (get report :properties) (js-object "generatedInvariant" t "cases" 50000))
      (await (pruneLibrary context "gcd" (js-array "function gcd(" "function rem(" "function safe_integer_QMARK_(") (js-array "function lcm(" "function checked_add(" "function min_number(" "function clamp(" "Math.")))
      (await (assertSourceMap (get context :seedDirectory) "numeric" (js-array "(defportable gcd" "(defportable lcm")))
        ))))) 90000)
)
