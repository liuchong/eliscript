(module tests.bootstrap-tools-driver
  (import "bun:test" expect test)
  (import "node:child_process" spawnSync)
  (import "node:fs" existsSync)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (defconst root (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst driver (resolve root "tools/testing/bootstrap-tools-driver.mjs"))
  (defconst host-import (js* "(url) => import(url)"))
  (defconst hosts (js-array
    (js-array "Bun" (get globalThis.process :execPath))
    (js-array "Node" (get (get globalThis.process :env) :NODE_BINARY "node"))))

  (defun run-driver (host requests)
    (spawnSync host (js-array driver)
      (js-object :cwd root :input (JSON/stringify requests) :encoding "utf8"
        :timeout 10000 :killSignal "SIGKILL" :maxBuffer (* 4 1024 1024))))

  (js-call hosts :forEach (lambda (host)
    (test (str "bootstrap batch collects independent errors and isolates module macros under " (aref host 0))
      (async ()
        (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-bootstrap-batch-")))))
          (try
            (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
            (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
            (let* ((first (resolve directory "first-λ.eli")) (bad (resolve directory "bad.eli"))
                   (last (resolve directory "last.eli")) (blocked (resolve directory "blocked"))
                   (first-source "(module first (defmacro private-helper (value) `(+ ,value 1)) (defun answer () (private-helper 6)) (export answer))")
                   (last-source "(module last (defun private-helper (value) (- value 1)) (defun answer () (private-helper 6)) (export answer))")
                   (first-output (resolve directory "first-λ.mjs")) (bad-output (resolve directory "bad.mjs"))
                   (last-output (resolve directory "last.mjs")) (again-output (resolve directory "again.mjs")))
              (await (writeFile first first-source))
              (await (writeFile bad "(module bad (defun incomplete ()"))
              (await (writeFile last last-source))
              (await (writeFile blocked "ordinary file"))
              (let* ((requests (js-array (js-array first first-output) (js-array bad bad-output)
                                  (js-array last last-output) (js-array last (resolve blocked "out.mjs"))
                                  (js-array last again-output)))
                     (child (run-driver (aref host 1) requests)))
                (js-call (expect (get child :error)) :toBe undefined)
                (js-call (expect (get child :status)) :toBe 1)
                (let ((rows (JSON/parse (get child :stdout))))
                  (js-call (expect (js-call rows :map (lambda (row) (get row :status)))) :toEqual (js-array 0 1 0 1 0))
                  (js-call rows :forEach (lambda (row index)
                    (js-call (expect (get row :input)) :toBe (aref (aref requests index) 0))
                    (js-call (expect (get row :output)) :toBe (aref (aref requests index) 1))))
                  (js-call (js-array 1 3) :forEach (lambda (index)
                    (let ((diagnostic (JSON/parse (get (aref rows index) :error))))
                      (js-call (expect (get diagnostic :format)) :toBe "eliscript-diagnostic")
                      (js-call (expect (get diagnostic :severity)) :toBe "error")
                      (js-call (expect (js-length (get diagnostic :message))) :toBeGreaterThan 0)))))
                (js-call (expect (existsSync bad-output)) :toBe false)
                (js-call (expect (await (readFile blocked "utf8"))) :toBe "ordinary file")
                (let ((outputs (js-array first-output last-output again-output))
                      (sources (js-array first-source last-source last-source))
                      (answers (js-array 7 5 5)) (index 0))
                  (while (< index (js-length outputs))
                    (let* ((output (aref outputs index))
                           (module (await (funcall host-import (get (pathToFileURL output) :href))))
                           (map (JSON/parse (await (readFile (str output ".map") "utf8")))))
                      (js-call (expect (js-call module :answer)) :toBe (aref answers index))
                      (js-call (expect (aref (get map :sourcesContent) 0)) :toBe (aref sources index)))
                    (setq index (1+ index))))))
            (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)

    (test (str "bootstrap batch validates the complete request list before writing under " (aref host 0))
      (async ()
        (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-bootstrap-invalid-")))))
          (try
            (let ((source (resolve directory "valid.eli")) (output (resolve directory "valid.mjs")))
              (await (writeFile source "(module valid (defun answer () 1) (export answer))"))
              (let ((child (run-driver (aref host 1) (js-array (js-array source output) (js-array source)))))
                (js-call (expect (get child :error)) :toBe undefined)
                (js-call (expect (get child :status)) :toBe 1)
                (js-call (expect (js-call (get child :stdout) :trim)) :toBe "")
                (js-call (expect (get child :stderr)) :toContain "bootstrap request requires source and output paths")
                (js-call (expect (existsSync output)) :toBe false)))
            (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)))
  (test "the Emacs parent transports Unicode paths and collects a later successful output" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-bootstrap-parent-")))))
      (try
        (let* ((good (resolve directory "λ.eli")) (bad (resolve directory "坏.eli"))
               (first-output (resolve directory "目录/λ.mjs")) (last-output (resolve directory "after.mjs"))
               (requests (js-array (js-array good first-output)
                           (js-array bad (resolve directory "bad.mjs")) (js-array good last-output))))
          (await (writeFile good "(module unicode-path (defun answer () 1) (export answer))"))
          (await (writeFile bad "(module unfinished"))
          (let* ((environment (Object/assign (js-object) (get globalThis.process :env)
                                (js-object :ELISCRIPT_BOOTSTRAP_REQUESTS (JSON/stringify requests))))
                 (child (spawnSync (get environment :EMACS "emacs")
                          (js-array "-Q" "--batch" "--eval"
                            "(let ((noninteractive nil)) (load-file \"tools/backends/bootstrap.el\"))"
                            "--eval"
                            "(let* ((requests (json-parse-string (getenv \"ELISCRIPT_BOOTSTRAP_REQUESTS\") :array-type 'list)) (tools (mapcar (lambda (pair) (cons (car pair) (cadr pair))) requests)) (failures (eliscript-backend-compile-tool-batch (or (getenv \"NODE_BINARY\") \"node\") \"tools/testing/bootstrap-tools-driver.mjs\" tools))) (princ (json-encode (vconcat failures))) (when failures (kill-emacs 1)))")
                          (js-object :cwd root :env environment :encoding "utf8" :timeout 15000
                            :killSignal "SIGKILL" :maxBuffer (* 4 1024 1024)))))
            (js-call (expect (get child :error)) :toBe undefined)
            (js-call (expect (get child :status)) :toBe 1)
            (let ((failures (JSON/parse (get child :stdout))))
              (js-call (expect (js-length failures)) :toBe 1)
              (js-call (expect (aref failures 0)) :toContain bad))
            (js-call (expect (existsSync first-output)) :toBe t)
            (js-call (expect (existsSync last-output)) :toBe t)
            (js-call (expect (existsSync (str first-output ".map"))) :toBe t)
            (js-call (expect (existsSync (str last-output ".map"))) :toBe t)))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
