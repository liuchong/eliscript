        (let ((used (funcall (aref e "heap-used") heap))
              (live (funcall (aref e "heap-live") heap)))
          (js-call (js-array (js-array 4294967295 0 1) (js-array frame 0 3) (js-array obj 21 3)) :forEach
            (lambda (entry)
              (js-call assert :equal (funcall invoke-lit (aref entry 0) (aref entry 1)) 0)
              (js-call assert :equal (funcall (aref e "last-error")) (aref entry 2))
              (js-call assert :equal (funcall (aref e "heap-used") heap) used)
              (js-call assert :equal (funcall (aref e "heap-live") heap) live)
              (js-call assert :equal (funcall (aref e "frame-depth") heap) 1))))
        (js-call (js-array 0 1 2 3) :forEach
          (lambda (receiver)
            (js-call assert :equal (funcall invoke-lit receiver 0) 0)
            (js-call assert :equal (funcall (aref e "last-error")) 0)))
        (js-call assert :equal (funcall invoke-lit obj 0) 0)
        (js-call assert :equal (funcall (aref e "last-error")) 0)
        (funcall (aref e "frame-pop") heap frame)
        (funcall (aref e "heap-collect") heap)
        (js-call assert :equal (funcall (aref e "heap-live") heap) 0))))

  (test "large property tables keep the ordinary hashed fallback for literal keys and preserve reads and writes under collection"
    (async ()
      (let* ((ir (js-call (get backend :compiler) :compile_ir_string "(defun read (o) (get o :x)) (defun write (o v) (put o :x v)) (export read write)" "large-key.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm ir runtime-program)))))
        (js-call a :auto 1)
        (let ((fields (Object/fromEntries (Array/from (js-object :length 32) (lambda (_ i) (js-array (str "k" i) t))))))
          (put fields :x false)
          (let* ((obj (js-call a :sourceObject fields))
                 (before (get (js-call a :stats) :collections)))
            (js-call assert :equal (js-call a :invoke "read" (js-array obj)) false)
            (funcall assert (>= (- (get (js-call a :stats) :collections) before) 2) "large tables fall back to constructing the lookup key")
            (let ((updated (js-call a :invoke "write" (js-array obj t))))
              (js-call a :release updated))
            (js-call assert :equal (js-call a :invoke "read" (js-array obj)) t)
            (js-call a :release obj)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))
