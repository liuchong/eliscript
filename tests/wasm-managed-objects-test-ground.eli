  (test "direct readers retain allocating runtime operands and caller roots, while effectful key readers keep automatic frames"
    (async ()
      (let* ((text "(defun direct (o k) (get o k)) (defun aref-direct (o k) (aref o k)) (defun nth-direct (o k) (js-nth k o)) (defun literal (o) (get o :x)) (defun assigned (o k p) (get o (progn (setq o p) k))) (defun caller (o k) (let ((v (direct o k))) (js-array v (js-object :saved v)))) (export direct aref-direct nth-direct literal assigned caller)")
             (ir (js-call (get backend :compiler) :compile_ir_string text "readers.eli"))
             (artifact (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm ir runtime-program)))
             (a (instantiateManagedRuntime artifact)))
        (js-call a :auto 1)
        (let* ((child (js-call a :string "held"))
               (obj (js-call a :sourceObject (js-object "0" child :x child)))
               (zero (js-call a :number 0))
               (x (js-call a :string "x")))
          (js-call (js-array "direct" "aref-direct" "nth-direct") :forEach
            (lambda (name)
              (let ((v (js-call a :invoke name (js-array obj zero))))
                (funcall assert (js-call a :keyEqual v child))
                (js-call a :release v))))
          (let ((before (get (js-call a :stats) :collections))
                (result (js-call a :invoke "literal" (js-array obj))))
            (funcall assert (js-call a :keyEqual result child))
            (js-call a :release result)
            (funcall assert (> (get (js-call a :stats) :collections) before) "literal access retains its entry frame for the allocating missing-key fallback"))
          (let* ((other (js-call a :sourceObject (js-object :x false)))
                 (collections (get (js-call a :stats) :collections))
                 (assigned (js-call a :invoke "assigned" (js-array obj x other))))
            (funcall assert (js-call a :keyEqual assigned child))
            (js-call a :release assigned)
            (funcall assert (> (get (js-call a :stats) :collections) collections))
            (js-call a :release other))
          (let* ((arr (js-call a :invoke "caller" (js-array obj x)))
                 (first (js-call a :get arr 0))
                 (record (js-call a :get arr 1))
                 (saved (js-call a :string "saved"))
                 (nested (js-call a :objectGet record saved)))
            (funcall assert (js-call a :keyEqual first child))
            (funcall assert (js-call a :keyEqual nested child))
            (js-call (js-array first record saved nested arr child obj zero x) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
        (let* ((held (js-call a :string "getter-held"))
               (receiver (js-call a :sourceObject (js-object :x held)))
               (getter-key (js-call a :string "x"))
               (args (js-array receiver)))
          (js-call a :release held)
          (Object/defineProperty args 1
            (js-object :get (lambda () (js-call a :release receiver) (js-call a :collect) getter-key)))
          (let ((transferred (js-call a :invoke "direct" args)))
            (js-call assert :equal (js-call a :readString transferred) "getter-held")
            (js-call a :release transferred)
            (js-call a :release getter-key)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))

