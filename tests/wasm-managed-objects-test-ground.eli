(module tests.wasm-managed-objects-test-ground
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst is-instance (js* "(a, b) => a instanceof b"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar runtime-program nil)
  (defvar program nil)
  (defvar bytes nil)
  (defvar js nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-objects-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime-program (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
      (setq program (js-call (get backend :compiler) :compile_ir_string (await (readFile "tests/fixtures/wasm-managed-objects.eli" "utf8")) "objects.eli"))
      (setq bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime-program)))
      (funcall assert (WebAssembly/validate bytes))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (setq js (await (funcall dynamic-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program)) :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun box-val (a x)
    (let ((ty (funcall js-typeof x)))
      (cond
        ((= ty "number") (js-call a :number x))
        ((= ty "string") (js-call a :string x))
        (t x))))

  (defun read-val (a x)
    (if (or (nullish? x) (/= (funcall js-typeof x) "object"))
      x
      (let ((k (get x :kind)))
        (cond
          ((= k 4) (js-call a :readNumber x))
          ((= k 5) (js-call a :readString x))
          ((= k 14)
           (Array/from (js-object :length (js-call a :length x))
             (lambda (_ i)
               (let ((v (js-call a :get x i)))
                 (try
                   (read-val a v)
                   (finally (js-call a :release v)))))))
          (t (throw (new globalThis.Error "opaque value requires explicit ownership")))))))

  (defun invoke-val (a name args)
    (let ((v (js-call a :invoke name args)))
      (try
        (read-val a v)
        (finally (js-call a :release v)))))

  (defun field-val (a o k)
    (let ((key (box-val a k)))
      (try
        (invoke-val a "read-value" (js-array o key))
        (finally (js-call a :release key)))))

  (defun inspect-obj (a o)
    (Object/fromEntries
      (js-call (invoke-val a "keys" (js-array o)) :map
        (lambda (k) (js-array k (field-val a o k))))))

  (defun inspect-rooted-keys (a o)
    (let ((keys (js-call a :invoke "keys" (js-array o)))
          (fields (js-array)))
      (try
        (let ((len (js-call a :length keys))
              (i 0))
          (while (< i len)
            (let ((key (js-call a :get keys i)))
              (try
                (js-call fields :push (js-array (js-call a :readString key) (invoke-val a "read-value" (js-array o key))))
                (finally (js-call a :release key))))
            (setq i (+ i 1))))
        (Object/fromEntries fields)
        (finally (js-call a :release keys)))))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (defun find-nonempty-object-literal (node)
    (if (or (nullish? node) (/= (funcall js-typeof node) "object"))
      nil
      (if (and (= (get node :kind) "object-literal") (> (length (get node :children)) 0))
        node
        (let ((vals (Object/values node))
              (found nil)
              (i 0))
          (while (and (< i (length vals)) (nil? found))
            (setq found (find-nonempty-object-literal (aref vals i)))
            (setq i (+ i 1)))
          found))))

  (test "named source objects preserve own values, missing/nullish defaults, duplicate keys, Unicode and identity through GC"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call (js-array nil false t undefined 0 -0.0 globalThis.NaN globalThis.Infinity globalThis.Number.MIN_VALUE "" "中😀\ud800") :forEach
          (lambda (value)
            (let* ((x (box-val a value))
                   (o (js-call a :invoke "make" (js-array x false)))
                   (ref (js-call js :make value false)))
              (js-call assert :equal (get o :kind) 13)
              (js-call assert :deepEqual (inspect-obj a o) ref)
              (js-call (js-array "x" "y" "missing" "" "absent" "中😀\ud800") :forEach
                (lambda (k)
                  (let ((key (js-call a :string k))
                        (fallback (js-call a :number 9)))
                    (js-call assert :deepEqual (invoke-val a "read-value" (js-array o key)) (js-call js :read_value ref k))
                    (js-call assert :deepEqual (invoke-val a "nth-value" (js-array key o)) (js-call js :nth_value k ref))
                    (js-call assert :deepEqual (invoke-val a "default-value" (js-array o key fallback)) (js-call js :default_value ref k 9))
                    (js-call assert :equal (invoke-val a "has" (js-array o key)) (js-call js :has ref k))
                    (js-call assert :equal (invoke-val a "default-order" (js-array o key)) (js-call js :default_order ref k))
                    (js-call a :release key)
                    (js-call a :release fallback))))
              (let ((duplicate (js-call a :invoke "duplicate" (js-array x t))))
                (js-call assert :deepEqual (inspect-obj a duplicate) (js-call js :duplicate value t))
                (js-call a :release duplicate))
              (js-call a :release x)
              (js-call a :release o)
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))

  (test "own property order is numeric-first and stable for strings, updates and computed dangerous names"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let ((o (js-call a :invoke "empty" (js-array)))
              (ref (js-call js :empty))
              (keys (js-array "z" "10" "2" "01" "0" "4294967294" "4294967295" "a" "constructor" "toString" "hasOwnProperty" "中😀" "" 1 -0.0)))
          (js-call keys :forEach
            (lambda (k)
              (let ((key (box-val a k))
                    (idx (js-call keys :indexOf k))
                    (value nil))
                (setq value (js-call a :number idx))
                (js-call assert :equal (invoke-val a "write" (js-array o key value)) (js-call js :write ref k idx))
                (js-call assert :deepEqual (invoke-val a "keys" (js-array o)) (js-call js :keys ref))
                (js-call assert :deepEqual (inspect-obj a o) ref)
                (js-call a :release key)
                (js-call a :release value))))
          (let* ((n (js-call a :number 7))
                 (data (js-call a :invoke "proto-data" (js-array n))))
            (js-call assert :deepEqual (inspect-obj a data) (js-call js :proto_data 7))
            (let ((proto (js-call a :invoke "proto" (js-array data))))
              (js-call assert :equal (js-call a :readNumber proto) 7)
              (js-call a :release proto))
            (js-call (js-array data n o) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))))

  (test "object assoc copies before key and RHS effects, defines own proto keys and returns independent shallow objects"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((zero (js-call a :number 0))
               (old (js-call a :string "old"))
               (o (js-call a :invoke "computed" (js-array old zero)))
               (ref (js-call js :computed "old" 0))
               (key (js-call a :string "new"))
               (copy (js-call a :invoke "assoc-order" (js-array o key)))
               (expected (js-call js :assoc_order ref "new")))
          (js-call assert :deepEqual (inspect-obj a copy) expected)
          (js-call assert :deepEqual (inspect-obj a o) ref)
          (funcall assert (not (js-call a :keyEqual copy o)))
          (let* ((pkey (js-call a :string "__proto__"))
                 (p (js-call a :invoke "assoc" (js-array o pkey t))))
            (js-call assert :deepEqual (inspect-obj a p) (js-call js :assoc ref "__proto__" t))
            (js-call assert :equal (invoke-val a "has" (js-array p pkey)) t)
            (let ((returned (js-call a :invoke "write-order" (js-array o p))))
              (funcall assert (js-call a :keyEqual returned p))
              (js-call a :release returned))
            (let* ((saved (js-call a :string "saved"))
                   (alias (js-call a :invoke "read-value" (js-array o saved))))
              (funcall assert (js-call a :keyEqual alias p))
              (js-call a :release alias)
              (js-call (js-array zero old o key copy pkey p saved) :forEach (lambda (v) (js-call a :release v)))
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)))))))

  (test "source object prototype inheritance, null prototypes, own shadows and cycle rejection retain actual semantics"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((x (js-call a :number -0.0))
               (parent (js-call a :invoke "make" (js-array x t)))
               (child (js-call a :invoke "inherit" (js-array parent false))))
          (funcall assert (Object/is (field-val a child "x") -0.0))
          (js-call assert :equal (field-val a child "own") false)
          (let ((key (js-call a :string "x")))
            (js-call assert :equal (invoke-val a "has" (js-array child key)) false)
            (js-call assert :deepEqual (invoke-val a "keys" (js-array child)) (js-array "own"))
            (let ((proto (js-call a :invoke "proto" (js-array child))))
              (funcall assert (js-call a :keyEqual proto parent))
              (js-call a :release proto))
            (js-call assert :throws
              (lambda () (js-call a :invoke "set-proto" (js-array parent child)))
              (lambda (e) (diag-code? e "ELI-RT0003")))
            (funcall assert (Object/is (field-val a child "x") -0.0))
            (let ((nil-obj (js-call a :invoke "null-proto" (js-array)))
                  (nil-ref (js-call js :null_proto)))
              (js-call (js-array "constructor" "toString" "__proto__") :forEach
                (lambda (k)
                  (js-call assert :deepEqual (field-val a nil-obj k) (js-call js :read_value nil-ref k))))
              (let ((set-h (js-call a :invoke "set-proto" (js-array nil-obj parent))))
                (funcall assert (js-call a :keyEqual set-h parent))
                (js-call a :release set-h))
              (let ((own-proto (js-call a :invoke "proto" (js-array nil-obj))))
                (funcall assert (js-call a :keyEqual own-proto parent))
                (js-call a :release own-proto))
              (let ((proto-key (js-call a :string "__proto__")))
                (js-call assert :equal (invoke-val a "has" (js-array nil-obj proto-key)) t)
                (js-call (js-array x parent child key nil-obj proto-key) :forEach (lambda (v) (js-call a :release v)))
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))))

  (test "objects retain cycles and array/table children, grow under GC and release all property edges"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 512 :initialBytes 32768 :maxBytes 1048576))))
        (js-call a :auto 1)
        (let* ((text (js-call a :string "x"))
               (arr (js-call a :sourceArray (js-array text)))
               (mp (js-call a :map)))
          (js-call a :tableSet mp t text)
          (let* ((cycle (js-call a :invoke "self-cycle" (js-array arr)))
                 (table-key (js-call a :string "table"))
                 (stored (js-call a :invoke "write" (js-array cycle table-key mp))))
            (js-call a :release stored)
            (js-call a :release mp)
            (let* ((self-key (js-call a :string "self"))
                   (self-h (js-call a :invoke "read-value" (js-array cycle self-key))))
              (funcall assert (js-call a :keyEqual cycle self-h))
              (js-call a :release self-h)
              (js-call a :release text)
              (js-call a :release arr)
              (js-call a :release self-key)
              (js-call a :collect)
              (js-call assert :deepEqual (field-val a cycle "v") (js-array "x"))
              (let* ((table (js-call a :invoke "read-value" (js-array cycle table-key)))
                     (value (js-call a :tableGet table t)))
                (js-call assert :equal (js-call a :readString value) "x")
                (js-call (js-array value table table-key cycle) :forEach (lambda (v) (js-call a :release v)))
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0)))))
        (let* ((n (js-call a :number 128))
               (o (js-call a :invoke "grow-loop" (js-array n))))
          (js-call assert :deepEqual
            (invoke-val a "keys" (js-array o))
            (Array/from (js-object :length 128) (lambda (_ i) (globalThis.String i))))
          (let ((i 0))
            (while (< i 128)
              (js-call assert :equal (field-val a o i) i)
              (setq i (+ i 1))))
          (funcall assert (> (get (js-call a :stats) :collections) 128))
          (js-call a :release n)
          (js-call a :release o)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "property-key conversions preserve complete finite Number and nonfinite names; object length is an ordinary property read"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let ((o (js-call a :invoke "empty" (js-array)))
              (ref (js-object)))
          (js-call
            (js-array nil false t undefined 0 -0.0 1 -1 2147483648 4294967295 -4294967295
                      globalThis.NaN globalThis.Infinity (- globalThis.Infinity) 0.5
                      globalThis.Number.MIN_VALUE 4294967296 globalThis.Number.MAX_VALUE
                      "0.5" "constructor" "valueOf" "__proto__\u0000" "中😀\ud800")
            :forEach
            (lambda (key)
              (let ((k (box-val a key))
                    (v (js-call a :number 7)))
                (js-call assert :equal (invoke-val a "write" (js-array o k v)) (js-call js :write ref key 7))
                (js-call assert :deepEqual (inspect-obj a o) ref)
                (js-call assert :equal (invoke-val a "has" (js-array o k)) (js-call js :has ref key))
                (js-call a :release k)
                (js-call a :release v))))
          (let ((len-key (js-call a :string "length"))
                (v (js-call a :string "len")))
            (invoke-val a "write" (js-array o len-key v))
            (js-call assert :equal (invoke-val a "size" (js-array o)) (js-call js :size (Object/assign (js-object) ref (js-object :length "len"))))
            (let ((inherited (js-call a :invoke "inherit" (js-array o false))))
              (js-call assert :equal (invoke-val a "size" (js-array inherited)) "len")
              (js-call a :release inherited))
            (put ref :length "len")
            (let ((ordinary (js-call a :sourceObject (js-object))))
              (js-call assert :equal (invoke-val a "write" (js-array o ordinary t)) (js-call js :write ref (js-object) t))
              (js-call assert :deepEqual (inspect-obj a o) ref)
              (js-call a :release ordinary))
            (let ((unconvertible (js-call a :sourceObject (js-object :toString false :valueOf false))))
              (js-call assert :throws
                (lambda () (js-call a :invoke "write" (js-array o unconvertible t)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call a :release unconvertible))
            (js-call (js-array o len-key v) :forEach (lambda (x) (js-call a :release x)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))))

  (test "radix key order and shallow assoc agree with deterministic random JS updates under collection"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (state 36968365)
             (next (lambda ()
                     (setq state (bit-xor state (bit-shift-left state 13)))
                     (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                     (setq state (bit-xor state (bit-shift-left state 5)))
                     (unsigned-bit-shift-right state 0)))
             (o (js-call a :invoke "empty" (js-array)))
             (ref (js-object))
             (values (js-array nil false t undefined globalThis.NaN -0.0 globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE "中😀\ud800"))
             (i 0))
        (js-call a :auto 1)
        (while (< i 1024)
          (let* ((name (if (/= (% (funcall next) 2) 0)
                         (globalThis.String (% (funcall next) 256))
                         (str "k" (% (funcall next) 128))))
                 (key (js-call a :string name))
                 (value (aref values (% (funcall next) (length values))))
                 (v (box-val a value)))
            (js-call assert :deepEqual (invoke-val a "write" (js-array o key v)) (js-call js :write ref name value))
            (js-call assert :deepEqual (invoke-val a "keys" (js-array o)) (js-call js :keys ref))
            (js-call assert :deepEqual (inspect-rooted-keys a o) ref)
            (when (= (% i 16) 0)
              (let ((copy (js-call a :invoke "assoc" (js-array o key false))))
                (js-call assert :deepEqual (inspect-rooted-keys a copy) (js-call js :assoc ref name false))
                (js-call a :release copy)))
            (js-call a :release key)
            (js-call a :release v)
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
          (setq i (+ i 1)))
        (js-call a :release o)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "object failures and real traps preserve original codes, caller frames, input properties and private-root cleanup"
    (async ()
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun heap-object-key-index "))
             (end (js-call source :indexOf "  (defun heap-object-sort-keys " start)))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((injected (js-call (get backend :compiler) :compile_ir_string
                           (str (js-call source :slice 0 start) "  (defun heap-object-key-index (heap key) (load-u32 4294967295))\n" (js-call source :slice end))
                           "trap-runtime.eli"))
               (a (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program injected)))))
          (js-call a :auto 1)
          (let* ((o (js-call a :invoke "make" (js-array t false)))
                 (bad (js-call a :sourceObject (js-object :toString false :valueOf false)))
                 (good (js-call a :string "x"))
                 (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 o)
            (js-call assert :throws
              (lambda () (js-call a :invoke "fault" (js-array o bad)))
              (lambda (e) (diag-code? e "ELI-RT0003")))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :throws
              (lambda () (js-call a :invoke "fault" (js-array o good)))
              (lambda (e) (funcall is-instance e globalThis.WebAssembly.RuntimeError)))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :throws
              (lambda () (js-call a :objectKeys o))
              (lambda (e) (funcall is-instance e globalThis.WebAssembly.RuntimeError)))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :equal (field-val a o "x") t)
            (js-call assert :equal (field-val a o "y") false)
            (let ((retained (js-call a :frameGet frame 0)))
              (funcall assert (js-call a :keyEqual retained o))
              (js-call a :release retained))
            (js-call a :leaveFrame frame)
            (js-call (js-array o bad good) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))
      (let ((bounded (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096))))
        (js-call bounded :auto 1)
        (let ((original (js-call bounded :invoke "empty" (js-array)))
              (keys (js-array))
              (failed false)
              (i 0))
          (while (and (< i 128) (not failed))
            (let ((key (js-call bounded :string (str "k" i))))
              (try
                (invoke-val bounded "write" (js-array original key t))
                (js-call keys :push (str "k" i))
                (catch e
                  (js-call assert :equal (get (get e :eliscriptDiagnostic) :code) "ELI-RT0002")
                  (setq failed t)
                  (js-call assert :equal (js-call bounded :objectHas original key) false))
                (finally (js-call bounded :release key))))
            (setq i (+ i 1)))
          (funcall assert failed)
          (js-call assert :throws
            (lambda () (js-call bounded :objectCopy original))
            (lambda (e) (diag-code? e "ELI-RT0002")))
          (js-call assert :equal (get (js-call bounded :stats) :frameDepth) 0)
          (js-call keys :forEach
            (lambda (name)
              (let ((key (js-call bounded :string name)))
                (js-call assert :equal (js-call bounded :objectGet original key) t)
                (js-call bounded :release key))))
          (js-call bounded :release original)
          (js-call bounded :collect)
          (js-call assert :equal (js-call bounded :live) 0)
          (js-call assert :equal (get (js-call bounded :stats) :frameDepth) 0)))))

  (test "unimplemented capabilities are source-bound refusals, supported IR is immutable, and foreign or retired handles cannot cross instances"
    (lambda ()
      (let ((before (JSON/stringify program)))
        (js-call (get backend :managed) :emit_managed_wasm program runtime-program)
        (js-call assert :equal (JSON/stringify program) before))
      (js-call
        (js-array
          "(new globalThis.Object)"
          "(js-call o :hasOwnProperty k)"
          "(object-keys)"
          "(object-has? o)"
          "(object-assoc o k)"
          "(js-object :__proto__ nil :__proto__ o)")
        :forEach
        (lambda (expression)
          (let ((ir (js-call (get backend :compiler) :compile_ir_string
                      (str "(defun f (o k) (if false " expression " o)) (export f)")
                      "unsupported-objects.eli")))
            (js-call assert :throws
              (lambda () (js-call (get backend :managed) :emit_managed_wasm ir runtime-program))
              (lambda (e)
                (and (diag-code? e "ELI-B0001")
                     (= (get (get (get e :eliscriptDiagnostic) :location) :file) "unsupported-objects.eli")))))))
      (let* ((a (instantiateManagedRuntime bytes))
             (other (instantiateManagedRuntime bytes))
             (o (js-call a :invoke "empty" (js-array)))
             (foreign (js-call other :string "key")))
        (js-call assert :throws
          (lambda () (js-call a :invoke "write" (js-array o foreign t)))
          (lambda (e) (diag-code? e "ELI-RT0001")))
        (js-call other :release foreign)
        (js-call other :collect)
        (js-call (js-array "constructor" "valueOf" "hasOwnProperty" "__proto__") :forEach
          (lambda (key)
            (let ((k (js-call a :string key)))
              (js-call assert :throws
                (lambda () (js-call a :invoke "read-value" (js-array o k)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call a :release k))))
