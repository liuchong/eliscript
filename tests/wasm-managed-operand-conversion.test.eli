(module tests.wasm-managed-operand-conversion.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))

  (defconst binary
    (js-array
      (js-array "add" "+" (js* "(a, b) => a + b"))
      (js-array "subtract" "-" (js* "(a, b) => a - b"))
      (js-array "multiply" "*" (js* "(a, b) => a * b"))
      (js-array "divide" "/" (js* "(a, b) => a / b"))
      (js-array "remainder" "%" (js* "(a, b) => a % b"))
      (js-array "less" "<" (js* "(a, b) => a < b"))
      (js-array "less-equal" "<=" (js* "(a, b) => a <= b"))
      (js-array "greater" ">" (js* "(a, b) => a > b"))
      (js-array "greater-equal" ">=" (js* "(a, b) => a >= b"))
      (js-array "bits-and" "bit-and" (js* "(a, b) => a & b"))
      (js-array "bits-or" "bit-or" (js* "(a, b) => a | b"))
      (js-array "bits-xor" "bit-xor" (js* "(a, b) => a ^ b"))
      (js-array "shift-left" "bit-shift-left" (js* "(a, b) => a << b"))
      (js-array "shift-right" "bit-shift-right" (js* "(a, b) => a >> b"))
      (js-array "shift-unsigned" "unsigned-bit-shift-right" (js* "(a, b) => a >>> b"))
      (js-array "same" "eq" (js* "(a, b) => a === b"))
      (js-array "different" "/=" (js* "(a, b) => a !== b"))))

  (defconst unary
    (js-array
      (js-array "negate" "-" (js* "(x) => -x"))
      (js-array "signed" "int32" (js* "(x) => x | 0"))
      (js-array "unsigned" "uint32" (js* "(x) => x >>> 0"))
      (js-array "bits-not" "bit-not" (js* "(x) => ~x"))))

  (defconst methods
    (js-array
      "at" "charAt" "charCodeAt" "codePointAt" "substring" "startsWith" "endsWith"
      "repeat" "trim" "trimStart" "trimEnd" "isWellFormed" "toWellFormed" "valueOf"
      "substr" "toUpperCase" "toLowerCase" "padStart" "padEnd" "split"))

  (defconst fixture
    (let* ((bin-defs (js-call (js-call binary :map (lambda (entry) (str "(defun " (aref entry 0) " (a b) (" (aref entry 1) " a b))"))) :join "\n"))
           (un-defs (js-call (js-call unary :map (lambda (entry) (str "(defun " (aref entry 0) " (a) (" (aref entry 1) " a))"))) :join "\n"))
           (ord-defs
             (js-call
               (js-call methods :map
                 (lambda (method i)
                   (str "(defun ordinary-" i " (receiver trace)\n"
                        " (js-call receiver :" method "\n"
                        "  (progn (put trace :events (+ (aref trace \"events\") \"a\"))\n"
                        "   (put receiver \"" method "\" (lambda (&rest args) (put trace :events (+ (aref trace \"events\") \"n\")) args)) \"/\")\n"
                        "  (progn (put trace :events (+ (aref trace \"events\") \"b\")) 2)\n"
                        "  (progn (put trace :events (+ (aref trace \"events\") \"c\")) t)))")))
               :join "\n"))
           (exports-list (js-array)))
      (js-call binary :forEach (lambda (x) (js-call exports-list :push (aref x 0))))
      (js-call unary :forEach (lambda (x) (js-call exports-list :push (aref x 0))))
      (js-call methods :forEach (lambda (_ i) (js-call exports-list :push (str "ordinary-" i))))
      (js-call (js-array "hook" "inherited" "receiver" "split" "numeric-after" "overwrite-right")
               :forEach (lambda (x) (js-call exports-list :push x)))
      (str "(defconst marker 1)\n"
           bin-defs "\n"
           un-defs "\n"
           " (defun hook (trace label first second mode)\n"
           "  (js-object :valueOf (if (= mode 3) 7 (lambda () (put trace :events (+ (aref trace \"events\") label \"v\")) (if (or (= mode 0) (= mode 5)) first (js-object))))\n"
           "   :toString (if (= mode 4) 7 (lambda () (put trace :events (+ (aref trace \"events\") label \"s\")) (if (or (= mode 2) (= mode 5)) (js-object) second)))))\n"
           " (defun inherited (prototype) (let ((item (js-object))) (put item :__proto__ prototype) item))\n"
           " (defun receiver (trace name)\n"
           "  (let ((item (js-object)))\n"
           "   (put item name (lambda (&rest args) (put trace :events (+ (aref trace \"events\") \"o\")) args)) item))\n"
           " (defun split (text separator limit) (js-call text :split separator limit))\n"
           " (defun numeric-after (a b trace) (+ (- a b) (put trace :later t)))\n"
           " (defun overwrite-right (trace right answer)\n"
           "  (js-object :valueOf (lambda () (put trace :events (+ (aref trace \"events\") \"l\"))\n"
           "    (put right :valueOf (lambda () (put trace :events (+ (aref trace \"events\") \"n\")) 9)) answer)))\n"
           ord-defs "\n"
           "(export " (js-call exports-list :join " ") ")")))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar program nil)
  (defvar bytes nil)

  (defun emit-bytes (&rest __host_default_arguments_1)
    (let* ((rt (aref __host_default_arguments_1 0)))
    (let* ((actual-rt (if (undefined? rt) runtime rt))
           (saved (JSON/stringify program))
           (out (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program actual-rt))))
      (js-call assert :equal (JSON/stringify program) saved)
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module out)) (js-array))
      out)))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-operands-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
      (setq program (js-call (get b :compiler) :compile_ir_string fixture "operand-conversion.eli"))
      (setq bytes (emit-bytes)))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun box-val (a x)
    (let ((ty (funcall js-typeof x)))
      (cond
        ((= ty "number") (js-call a :number x))
        ((= ty "string") (js-call a :string x))
        (t x))))

  (defun read-val (a x)
    (if (and (not (nullish? x)) (= (funcall js-typeof x) "object"))
      (let ((k (get x :kind)))
        (cond
          ((= k 4) (js-call a :readNumber x))
          ((= k 5) (js-call a :readString x))
          ((= k 14)
           (let ((out (js-array))
                 (len (js-call a :length x))
                 (i 0))
             (while (< i len)
               (let ((v (js-call a :get x i)))
                 (try
                   (js-call out :push (read-val a v))
                   (finally (js-call a :release v))))
               (setq i (+ i 1)))
             out))
          (t x)))
      x))

  (defun obj-get (a o key)
    (let ((k (js-call a :string key)))
      (try
        (let ((v (js-call a :objectGet o k)))
          (try
            (read-val a v)
            (finally (js-call a :release v))))
        (finally (js-call a :release k)))))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((values (aref __host_default_arguments_2 0)))
    (let ((owned (if (undefined? values) (js-array) values)))
      (js-call owned :forEach (lambda (v) (js-call a :release v)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defun make-hook (a trace label first second &rest __host_default_arguments_3)
    (let* ((mode (aref __host_default_arguments_3 0)))
    (let* ((m (if (undefined? mode) 0 mode))
           (values (js-call (js-array label first second m) :map (lambda (v) (box-val a v)))))
      (try
        (js-call a :invoke "hook" (js-array trace (aref values 0) (aref values 1) (aref values 2) (aref values 3)))
        (finally
          (js-call values :forEach (lambda (v) (js-call a :release v))))))))

  (defun reference-hook (trace label first second &rest __host_default_arguments_4)
    (let* ((mode (aref __host_default_arguments_4 0)))
    (let ((m (if (undefined? mode) 0 mode)))
      (js-object
        :valueOf (if (= m 3)
                   7
                   (lambda ()
                     (js-call trace :push (str label "v"))
                     (if (or (= m 0) (= m 5)) first (js-object))))
        :toString (if (= m 4)
                    7
                    (lambda ()
                      (js-call trace :push (str label "s"))
                      (if (or (= m 2) (= m 5)) (js-object) second)))))))

  (defun make-instance (&rest __host_default_arguments_5)
    (let* ((options (aref __host_default_arguments_5 0)) (rt (aref __host_default_arguments_5 1)))
    (let* ((actual-rt (if (undefined? rt) runtime rt))
           (wasm-bytes (if (eq actual-rt runtime) bytes (emit-bytes actual-rt)))
           (a (instantiateManagedRuntime wasm-bytes options)))
      (js-call a :auto 1)
      a)))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (defun build-source-array (a value)
    (let* ((children (js-call value :map
                       (lambda (v)
                         (if (Array/isArray v)
                           (build-source-array a v)
                           (box-val a v)))))
           (out (js-call a :sourceArray children)))
      (js-call (Object/values children) :forEach (lambda (v) (js-call a :release v)))
      out))

  (test "ordinary objects retain default and Number hint order across the complete supported arithmetic bitwise and relation family"
    (lambda ()
      (let ((a (make-instance))
            (values (js-array undefined nil false t 0 -0.0 1 -1 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE "" "2" "10" "x" "中\ud800"))
            (modes (js-array 0 1 3))
            (i 0))
        (while (< i (length values))
          (let ((idx i))
            (js-call modes :forEach
              (lambda (mode)
                (js-call binary :forEach
                  (lambda (entry)
                    (let* ((name (aref entry 0))
                           (oracle (aref entry 2))
                           (events (js-array))
                           (empty (js-call a :string ""))
                           (trace (js-call a :sourceObject (js-object :events empty)))
                           (len (length values))
                           (left (make-hook a trace "l" (aref values idx) (aref values (% (+ idx 3) len)) mode))
                           (right (make-hook a trace "r" (aref values (% (+ idx 1) len)) (aref values (% (+ idx 5) len)) mode))
                           (out undefined))
                      (js-call a :release empty)
                      (try
                        (let ((expected (funcall oracle
                                          (reference-hook events "l" (aref values idx) (aref values (% (+ idx 3) len)) mode)
                                          (reference-hook events "r" (aref values (% (+ idx 1) len)) (aref values (% (+ idx 5) len)) mode))))
                          (setq out (js-call a :invoke name (js-array left right)))
                          (js-call assert :deepEqual (read-val a out) expected name)
                          (js-call assert :equal (obj-get a trace "events") (js-call events :join "") name))
                        (finally
                          (js-call (js-array trace left right out) :forEach (lambda (v) (js-call a :release v)))))
                      (js-call a :collect)))))))
          (setq i (+ i 1)))
        (finish a))))

  (test "unary conversion and inherited source hooks agree with native JS without numeric conversion during strict equality"
    (lambda ()
      (let ((a (make-instance))
            (values (js-array undefined nil false t -0.0 globalThis.NaN "2" "-0" "x"))
            (modes (js-array 0 1 3)))
        (js-call values :forEach
          (lambda (value)
            (js-call modes :forEach
              (lambda (mode)
                (js-call unary :forEach
                  (lambda (entry)
                    (let* ((name (aref entry 0))
                           (oracle (aref entry 2))
                           (events (js-array))
                           (empty (js-call a :string ""))
                           (trace (js-call a :sourceObject (js-object :events empty)))
                           (base (make-hook a trace "v" value value mode))
                           (input (js-call a :invoke "inherited" (js-array base))))
                      (js-call a :release empty)
                      (let ((out (js-call a :invoke name (js-array input))))
                        (js-call assert :deepEqual (read-val a out) (funcall oracle (reference-hook events "v" value value mode)))
                        (js-call assert :equal (obj-get a trace "events") (js-call events :join ""))
                        (js-call (js-array trace base input out) :forEach (lambda (v) (js-call a :release v)))
                        (js-call a :collect)))))))))
        (finish a))))

  (test "each conversion resolves the next operand after earlier hook effects and a failed first operand suppresses all later conversions"
    (lambda ()
      (let ((a (make-instance))
            (non-identity (js-call binary :filter (lambda (x) (not (js-call (js-array "same" "different") :includes (aref x 0)))))))
        (js-call non-identity :forEach
          (lambda (entry)
            (let* ((name (aref entry 0))
                   (oracle (aref entry 2))
                   (empty (js-call a :string ""))
                   (trace (js-call a :sourceObject (js-object :events empty :later false)))
                   (right (make-hook a trace "r" 4 4))
                   (answer (js-call a :string "2"))
                   (left (js-call a :invoke "overwrite-right" (js-array trace right answer))))
              (js-call a :release empty)
              (let ((out (js-call a :invoke name (js-array left right))))
                (js-call assert :deepEqual (read-val a out) (funcall oracle "2" 9))
                (js-call assert :equal (obj-get a trace "events") "ln")
                (js-call (js-array trace right answer left out) :forEach (lambda (v) (js-call a :release v)))
                (js-call a :collect)))))
        (js-call (js-array 2 4) :forEach
          (lambda (mode)
            (let* ((empty (js-call a :string ""))
                   (trace (js-call a :sourceObject (js-object :events empty :later false)))
                   (left (make-hook a trace "l" 1 2 mode))
                   (right (make-hook a trace "r" 1 2)))
              (js-call a :release empty)
              (js-call assert :throws
                (lambda () (js-call a :invoke "numeric-after" (js-array left right trace)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call assert :equal (obj-get a trace "events") (if (= mode 2) "lvls" "lv"))
              (js-call assert :equal (obj-get a trace "later") false)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
              (js-call (js-array trace left right) :forEach (lambda (v) (js-call a :release v)))
              (js-call a :collect))))
        (finish a))))

  (test "ordinary text method values are captured before arguments and ignored extras complete before noncallable failure"
    (lambda ()
      (let ((a (make-instance))
            (i 0))
        (while (< i (length methods))
          (let* ((empty (js-call a :string ""))
                 (trace (js-call a :sourceObject (js-object :events empty)))
                 (name (js-call a :string (aref methods i)))
                 (receiver (js-call a :invoke "receiver" (js-array trace name))))
            (js-call a :release empty)
            (let ((out (js-call a :invoke (str "ordinary-" i) (js-array receiver trace))))
              (js-call assert :deepEqual (read-val a out) (js-array "/" 2 t))
              (js-call assert :equal (obj-get a trace "events") "abco")
              (js-call (js-array trace name receiver out) :forEach (lambda (v) (js-call a :release v)))
              (js-call a :collect)))
          (setq i (+ i 1)))
        (js-call (js-array (js-object) (js-object :split nil) (js-object :split false) (js-object :split 7)) :forEach
          (lambda (receiver-value)
            (let* ((roots (Object/fromEntries
                            (js-call (Object/entries receiver-value) :map
                              (lambda (pair) (js-array (aref pair 0) (box-val a (aref pair 1)))))))
                   (receiver (js-call a :sourceObject roots))
                   (empty (js-call a :string ""))
                   (trace (js-call a :sourceObject (js-object :events empty))))
              (js-call (Object/values roots) :forEach (lambda (v) (js-call a :release v)))
              (js-call a :release empty)
              (js-call assert :throws
                (lambda () (js-call a :invoke "ordinary-19" (js-array receiver trace)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call assert :equal (obj-get a trace "events") "abc")
              (js-call (js-array receiver trace) :forEach (lambda (v) (js-call a :release v)))
              (js-call a :collect))))
        (js-call (js-array nil undefined) :forEach
          (lambda (receiver)
            (let* ((empty (js-call a :string ""))
                   (trace (js-call a :sourceObject (js-object :events empty))))
              (js-call a :release empty)
              (js-call assert :throws
                (lambda () (js-call a :invoke "ordinary-19" (js-array receiver trace)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call assert :equal (obj-get a trace "events") "")
              (js-call a :release trace)
              (js-call a :collect))))
        (finish a))))

  (test "split preserves limit-before-separator conversion including zero and skips later conversions after a first error"
    (lambda ()
      (let ((a (make-instance))
            (values (js-array undefined nil false t 0 -0.0 1 2 -1 4294967296 4294967297 globalThis.NaN globalThis.Infinity "2"))
            (modes (js-array 0 1 3))
            (sep-modes (js-array 0 5)))
        (js-call values :forEach
          (lambda (value)
            (js-call modes :forEach
              (lambda (mode)
                (js-call sep-modes :forEach
                  (lambda (sep-mode)
                    (let* ((events (js-array))
                           (empty (js-call a :string ""))
                           (trace (js-call a :sourceObject (js-object :events empty)))
                           (limit (make-hook a trace "l" value value mode))
                           (separator (make-hook a trace "s" (if (= sep-mode 5) "/" "ignored") "/" sep-mode))
                           (text (js-call a :string "a/b/c")))
                      (js-call a :release empty)
                      (let ((out (js-call a :invoke "split" (js-array text separator limit)))
                            (expected (js-call "a/b/c" :split
                                        (reference-hook events "s" (if (= sep-mode 5) "/" "ignored") "/" sep-mode)
                                        (reference-hook events "l" value value mode))))
                        (js-call assert :deepEqual (read-val a out) expected)
                        (js-call assert :equal (obj-get a trace "events") (js-call events :join ""))
                        (js-call (js-array trace limit separator text out) :forEach (lambda (v) (js-call a :release v)))
                        (js-call a :collect)))))))))
        (js-call (js-array "limit" "separator") :forEach
          (lambda (failing)
            (let* ((empty (js-call a :string ""))
                   (trace (js-call a :sourceObject (js-object :events empty)))
                   (limit (make-hook a trace "l" 1 1 (if (= failing "limit") 2 0)))
                   (separator (make-hook a trace "s" "x" "/" (if (= failing "separator") 2 0)))
                   (text (js-call a :string "a/b")))
              (js-call a :release empty)
              (js-call assert :throws
                (lambda () (js-call a :invoke "split" (js-array text separator limit)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call assert :equal (obj-get a trace "events") (if (= failing "limit") "lvls" "lvsssv"))
              (js-call (js-array trace limit separator text) :forEach (lambda (v) (js-call a :release v)))
              (js-call a :collect))))
        (finish a))))

  (test "fixed random binary64 primitives returned by source hooks retain exact signed zero NaN and string comparison results"
    (lambda ()
      (let* ((a (make-instance))
             (seed 88177714)
             (next (lambda ()
                     (setq seed (unsigned-bit-shift-right (+ (Math/imul seed 1664525) 1013904223) 0))
                     seed))
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (random (lambda ()
                       (js-call bits :setUint32 0 (funcall next) t)
                       (js-call bits :setUint32 4 (funcall next) t)
                       (js-call bits :getFloat64 0 t)))
             (i 0))
        (while (< i 128)
          (let* ((l (if (/= (% i 3) 0) (funcall random) (String/fromCharCode (% (funcall next) 65536))))
                 (r (if (/= (% i 3) 0) (funcall random) (String/fromCharCode (% (funcall next) 65536))))
                 (empty (js-call a :string ""))
                 (trace (js-call a :sourceObject (js-object :events empty)))
                 (left (make-hook a trace "l" l l))
                 (right (make-hook a trace "r" r r)))
            (js-call a :release empty)
            (js-call binary :forEach
              (lambda (entry)
                (let* ((name (aref entry 0))
                       (oracle (aref entry 2))
                       (out (js-call a :invoke name (js-array left right))))
                  (js-call assert :deepEqual
                    (read-val a out)
                    (funcall oracle (reference-hook (js-array) "l" l l) (reference-hook (js-array) "r" r r))
                    name)
                  (js-call a :release out))))
            (js-call (js-array trace left right) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect))
          (setq i (+ i 1)))
        (funcall assert (> (get (js-call a :stats) :collections) 1000))
        (finish a))))

  (test "capacity failure and a real comparison trap preserve caller roots and earlier conversion effects without retaining private frames"
    (async ()
      (let* ((a (make-instance (js-object :maxSlots 128 :initialBytes 8192 :maxBytes 8192)))
             (empty (js-call a :string ""))
             (trace (js-call a :sourceObject (js-object :events empty)))
             (left (make-hook a trace "l" 2 2))
             (right (make-hook a trace "r" 3 3))
             (saved (js-call a :number -0.0))
             (frame (js-call a :frame 1))
             (held (js-array))
             (i 0)
             (stopped false))
        (js-call a :release empty)
        (js-call a :frameSet frame 0 saved)
        (while (and (< i 256) (not stopped))
          (try
            (js-call held :push (js-call a :number i))
            (catch error
              (js-call assert :equal (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002")
              (setq stopped t)))
          (setq i (+ i 1)))
        (funcall assert (and (> (length held) 0) (< (length held) 256)))
        (js-call assert :throws
          (lambda () (js-call a :invoke "add" (js-array left right)))
          (lambda (e) (diag-code? e "ELI-RT0002")))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
        (js-call held :forEach (lambda (v) (js-call a :release v)))
        (js-call a :collect)
        (let ((output (js-call a :invoke "add" (js-array left right))))
          (js-call assert :equal (read-val a output) 5)
          (js-call assert :equal (obj-get a trace "events") "lvrv")
          (js-call a :leaveFrame frame)
          (finish a (js-array trace left right saved output))))
      (let* ((text (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call text :indexOf "  (defun heap-source-relational "))
             (end (js-call text :indexOf "\n  (defun " (+ start 1))))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((original (js-call text :slice start end))
               (tail (js-call original :lastIndexOf "result))")))
          (funcall assert (> tail 0))
          (let* ((injected (str (js-call original :slice 0 tail) "(load-u32 4294967295)))" (js-call original :slice (+ tail 8))))
                 (rt (js-call (get b :compiler) :compile_ir_string
                       (str (js-call text :slice 0 start) injected (js-call text :slice end))
                       "operand-trap.eli"))
                 (trapped (make-instance undefined rt))
                 (blank (js-call trapped :string ""))
                 (log (js-call trapped :sourceObject (js-object :events blank)))
                 (l (make-hook trapped log "l" 2 2))
                 (r (make-hook trapped log "r" 3 3))
                 (caller (js-call trapped :frame 1)))
            (js-call trapped :release blank)
            (js-call trapped :frameSet caller 0 log)
            (js-call assert :throws
              (lambda () (js-call trapped :invoke "less" (js-array l r)))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call trapped :stats) :frameDepth) 1)
            (js-call assert :equal (obj-get trapped log "events") "lvrv")
            (let* ((two (js-call trapped :number 2))
                   (three (js-call trapped :number 3))
                   (sum (js-call trapped :invoke "add" (js-array two three))))
              (js-call assert :equal (read-val trapped sum) 5)
              (js-call trapped :leaveFrame caller)
              (finish trapped (js-array log l r two three sum))))))))

  (test "malformed raw operands modes unfinished strings and private frames fail before allocation and preserve heap lifetime"
    (lambda ()
      (let* ((inst (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)))
             (e (get inst :exports))
             (h (funcall (aref e "heap-new") 64 8192 8192))
             (num (funcall (aref e "value-number") h 0 1072693248))
             (unfinished (funcall (aref e "value-string") h 1))
             (frame (funcall (aref e "frame-new") h 1)))
        (funcall (aref e "frame-set") h frame 0 num)
        (let ((before (funcall (aref e "heap-live") h))
              (used (funcall (aref e "heap-used") h))
              (cases (js-array
                       (js-array "value-primitive-binary" (js-array num 4294967295 0) 1)
                       (js-array "value-primitive-binary" (js-array frame num 0) 3)
                       (js-array "value-primitive-binary" (js-array num num 5) 3)
                       (js-array "value-primitive-compare" (js-array num num 6) 3)
                       (js-array "value-primitive-word" (js-array num 3) 3)
                       (js-array "value-primitive-bitwise" (js-array num num 7) 3))))
          (js-call cases :forEach
            (lambda (entry)
              (let ((fn (aref e (aref entry 0)))
                    (args (aref entry 1))
                    (code (aref entry 2)))
                (js-call assert :equal (js-call fn :apply nil (js-call (js-array h) :concat args)) 0)
                (js-call assert :equal (funcall (aref e "last-error")) code)
                (js-call assert :equal (funcall (aref e "heap-live") h) before)
                (js-call assert :equal (funcall (aref e "heap-used") h) used)
                (js-call assert :equal (funcall (aref e "frame-depth") h) 1)))))
        (funcall (aref e "heap-pin") h unfinished)
        (funcall (aref e "heap-auto") h 1)
        (js-call assert :equal (funcall (aref e "value-primitive-binary") h unfinished num 0) 0)
        (js-call assert :equal (funcall (aref e "last-error")) 6)
        (js-call assert :equal (funcall (aref e "frame-depth") h) 1)
        (funcall (aref e "heap-release") h unfinished)
        (funcall (aref e "frame-pop") h frame)
        (funcall (aref e "heap-collect") h)
        (js-call assert :equal (funcall (aref e "heap-live") h) 0)
        (js-call assert :equal (funcall (aref e "value-primitive-negate") h num) 0)
        (js-call assert :equal (funcall (aref e "last-error")) 1))))

  (test "independent Node executes identical operand and ordinary split bytes with native operator oracles under collecting GC"
    (async ()
      (let ((file (resolve directory "operand-conversion.wasm"))
            (runner (resolve "tests/helpers/wasm-managed-operand-conversion-node.mjs"))
            (rt-href (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)))
        (await (writeFile file bytes))
        (let ((result (spawnSync "node" (js-array runner rt-href file) (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get result :status) 0 (get result :stderr))))))

  (test "acyclic nested and sparse source arrays use ordinary join conversion for all operators while strict identity never converts"
    (lambda ()
      (let* ((a (make-instance))
             (sparse (let ((s (new globalThis.Array 4))) (put s 1 3) s))
             (samples (js-array
                        (js-array)
                        (js-array nil)
                        (js-array undefined)
                        (js-array 1)
                        (js-array 1 2)
                        sparse
                        (js-array (js-array 1) (js-array nil "2"))
                        (js-array "\ud800" "😀"))))
        (js-call samples :forEach
          (lambda (value)
            (let ((input (build-source-array a value))
                  (right (js-call a :string "3")))
              (js-call binary :forEach
                (lambda (entry)
                  (let* ((name (aref entry 0))
                         (oracle (aref entry 2))
                         (out (js-call a :invoke name (js-array input right))))
                    (js-call assert :deepEqual (read-val a out) (funcall oracle value "3") name)
                    (js-call a :release out))))
              (js-call assert :equal (js-call a :invoke "same" (js-array input input)) t)
              (js-call unary :forEach
                (lambda (entry)
                  (let* ((name (aref entry 0))
                         (oracle (aref entry 2))
                         (out (js-call a :invoke name (js-array input))))
                    (js-call assert :deepEqual (read-val a out) (funcall oracle value) name)
                    (js-call a :release out))))
              (js-call a :release input)
              (js-call a :release right)
              (js-call a :collect))))
        (finish a))))

  (test "raw internal containers and the unrepresented Symbol.split protocol remain explicit capability errors"
    (lambda ()
      (let* ((a (make-instance))
             (internal (js-call a :array))
             (num (js-call a :number 1)))
        (js-call (js-array "add" "subtract" "less") :forEach
          (lambda (name)
            (js-call assert :throws
              (lambda () (js-call a :invoke name (js-array internal num)))
              (lambda (e) (diag-code? e "ELI-RT0003")))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (finish a (js-array internal num)))
      (js-call (js-array "Symbol.split") :forEach
        (lambda (glob)
          (let ((p (js-call (get b :compiler) :compile_ir_string
                     (str "(defun unsupported () (js* " (JSON/stringify glob) ")) (export unsupported)")
                     "conversion-protocol.eli")))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
              (lambda (e)
                (and (diag-code? e "ELI-B0001")
                     (= (get (get (get e :eliscriptDiagnostic) :location) :file) "conversion-protocol.eli"))))))))))
