(module tests.maturity-progress.test
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve join)
  (import "../tools/progress/check.mjs" checkMaturityProgress humanReport MaturityProgressValidationError)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defasync readJson (path) (JSON/parse (await (readFile (join ROOT path) "utf8"))))
  (defasync validationErrors (contract)
    (let ((failed false) (errors undefined))
      (try (await (checkMaturityProgress (js-object :root ROOT :contract contract)))
        (catch error (js-call (expect error) :toBeInstanceOf MaturityProgressValidationError) (setq failed t) (setq errors (get error :errors))))
      (if failed errors (throw (new globalThis.Error "expected maturity progress validation to fail")))))
  (test "maturity progress is derived from explicit core acceptance units" (async ()
    (let ((report (await (checkMaturityProgress (js-object :root ROOT)))))
      (js-call (expect report) :toEqual (js-object "schemaVersion" 1 "format" "eliscript-maturity-progress-report" "version" 1 "implementation" (js-object "completed" 42 "total" 42 "completedPercent" 100 "remaining" 0 "remainingPercent" 0 "milestones" (js-object "M7" (js-object "completed" 6 "total" 6 "completedPercent" 100 "remaining" 0 "remainingPercent" 0) "M8" (js-object "completed" 7 "total" 7 "completedPercent" 100 "remaining" 0 "remainingPercent" 0) "M9" (js-object "completed" 6 "total" 6 "completedPercent" 100 "remaining" 0 "remainingPercent" 0) "M10" (js-object "completed" 6 "total" 6 "completedPercent" 100 "remaining" 0 "remainingPercent" 0) "M11" (js-object "completed" 6 "total" 6 "completedPercent" 100 "remaining" 0 "remainingPercent" 0) "M12" (js-object "completed" 6 "total" 6 "completedPercent" 100 "remaining" 0 "remainingPercent" 0) "M13" (js-object "completed" 5 "total" 5 "completedPercent" 100 "remaining" 0 "remainingPercent" 0)) "incomplete" (js-array ) "blocked" (js-array )) "verification" (js-object "completed" 35 "total" 35 "completedPercent" 100 "remaining" 0 "remainingPercent" 0 "incomplete" (js-array ) "blocked" (js-array )) "stabilization" (js-object "completed" 173 "total" 174 "completedPercent" 99.4 "remaining" 1 "remainingPercent" 0.6 "provisional" 1 "excludedFeatureIds" (js-array "publishing.org-adapter" "tooling.vite-adapter")) "applications" (js-object "contributesToCore" false "excludedCriteria" (js-array "AV-01" "AV-02") "excludedFeatureIds" (js-array "publishing.org-adapter" "tooling.vite-adapter"))))
      (js-call (expect (humanReport report)) :toContain "Verification: 35/35 (100% complete, 0% remaining)")
      (js-call (get (expect (humanReport report)) :not) :toContain "overall"))))
  (test "maturity progress rejects a missing mandatory criterion" (async ()
    (let ((contract (await (readJson "contracts/maturity-progress.json"))))
      (js-call (get (get contract :verification) :criteria) :pop)
      (js-call (expect (await (validationErrors contract))) :toContain "verification criteria must be exactly AC-01..AC-24 then PD-01..PD-11"))))
  (test "maturity progress rejects completion without feature evidence" (async ()
    (let ((contract (await (readJson "contracts/maturity-progress.json"))))
      (put (js-call (get (get contract :verification) :criteria) :find (lambda (candidate) (= (get candidate :id) "AC-22"))) :features (js-array))
      (js-call (expect (await (validationErrors contract))) :toContain "verification criterion AC-22 complete status requires core feature evidence"))))
  (test "maturity progress rejects unknown evidence" (async ()
    (let ((contract (await (readJson "contracts/maturity-progress.json"))))
      (put (aref (get (aref (get (get contract :implementation) :milestones) 0) :units) 0) :features (js-array "quality.missing"))
      (js-call (expect (await (validationErrors contract))) :toContain "implementation unit M7-01 references unknown conformance feature quality.missing"))))
  (test "maturity progress rejects application evidence in core units" (async ()
    (let ((contract (await (readJson "contracts/maturity-progress.json"))))
      (put (aref (get (aref (get (get contract :implementation) :milestones) 0) :units) 0) :features (js-array "tooling.vite-adapter"))
      (js-call (expect (await (validationErrors contract))) :toContain "implementation unit M7-01 uses excluded application feature tooling.vite-adapter"))))
  (test "maturity progress rejects milestone denominator drift" (async ()
    (let ((contract (await (readJson "contracts/maturity-progress.json"))))
      (js-call (get (aref (get (get contract :implementation) :milestones) 6) :units) :pop)
      (js-call (expect (await (validationErrors contract))) :toContain "milestone M13 must contain 5 units"))))
)
