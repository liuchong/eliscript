(module tests.compiler-module-candidate-rig
  (import "node:fs/promises" readFile mkdir symlink)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defasync buildCompilerCandidate (directory sourceRoot overrides)
    (let* ((module (await (funcall load-module (get (pathToFileURL (resolve sourceRoot "tools/backends/build.mjs")) :href))))
           (buildBackends (get module :buildBackends))
           (baseline (await (funcall buildBackends (js-object :outputRoot (resolve directory "baseline")))))
           (entries (await (Promise/all (js-call (Object/entries (if (= overrides undefined) (js-object) overrides)) :map
             (async (entry) (js-array (resolve sourceRoot (aref entry 0)) (await (readFile (aref entry 1) "utf8"))))))))
           (same (await (Promise/all (js-call entries :map (async (entry) (= (await (readFile (aref entry 0) "utf8")) (aref entry 1))))))))
      (if (js-call same :every (js* "(value) => !!value")) baseline
        (progn
          (await (mkdir (resolve directory "candidate") (js-object :recursive t)))
          (await (symlink (resolve directory "baseline/bootstrap") (resolve directory "candidate/bootstrap") "dir"))
          (let* ((replacements (new globalThis.Map entries))
                 (frontend (copyHostRecord (get baseline :compiler) (js-object :compile_string_with_source_map
                   (lambda (source path &rest args)
                     (let ((replacement (js-call replacements :get (resolve path))))
                       (Reflect/apply (get (get baseline :compiler) :compile_string_with_source_map) (get baseline :compiler)
                         (js-call (js-array (if (nullish? replacement) source replacement) path) :concat (Array/from args)))))))))
            (await (funcall buildBackends (js-object :outputRoot (resolve directory "candidate") :frontend frontend))))))))
  (export buildCompilerCandidate))
