(module tests.core-text-object
  (import "../runtime/core/transient.mjs" :as transientRuntime)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/object.mjs" :as objects)
  (import "../runtime/core/text.mjs" :as text)
  (import "../runtime/core/collection.mjs" :as collection)
  (import "../runtime/core/value.mjs" equalValues)
  (import "../runtime/core/map.mjs" EMPTY_MAP)

  (import "../runtime/testing/map.mjs" persistentMapMetrics resetPersistentMapMetrics resetTransientMapMetrics transientMapMetrics)
  (import "../runtime/core/protocol.mjs" extendProtocolType)
  (import "./helpers/portable-stdlib.mjs" runSuccessful)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst ROOT (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst BUN (get globalThis.process :execPath))
  (defconst NODE (get (get globalThis.process :env) :NODE_BINARY "node"))
  (defconst MODULES (Object/freeze (js-call (js-array "text" "object") :map (lambda (name)
    (js-object :name name :source (resolve ROOT (str "stdlib/core/" name ".eli"))
      :committed (resolve ROOT (str "runtime/core/" name "-impl.mjs")) :facade (resolve ROOT (str "runtime/core/" name ".mjs")))))))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync run (command environment) (await (runSuccessful command (copyHostRecord (js-object :BUN BUN) (if (= environment undefined) (js-object) environment)))))
  (defasync compile (compiler source output environment)
    (await (mkdir (dirname output) (js-object :recursive t)))
    (await (run (js-array compiler "--source-map" "--output" output source) environment)))
  (defasync execute (host textModule objectModule)
    (JSON/parse (await (run (js-array host (resolve ROOT "tests/fixtures/core-text-object-host.mjs") textModule objectModule)))))
  (defun canonicalSourceMap (sourceMap name) (copyHostRecord (JSON/parse sourceMap) (js-object :sources (js-array (str "<" name "-source>")))))
  (test "protocol-driven text and object algorithms preserve value boundaries" (lambda ()
    (be (js-call text :slice 0 3 "A😀") "A😀")
    (be (js-call text :join "/" (new globalThis.Set (js-array "a" 2 false))) "a/2/false")
    (let ((plain (js-object :zero 0 :right 2 :absent undefined)))
      (same (Array/from (js-call objects :keys plain)) (js-array "zero" "right" "absent"))
      (same (js-call objects :mapValues (lambda (value) (if (nullish? value) "nil" value)) plain) (js-object :zero 0 :right 2 :absent "nil"))
      (same (js-call objects :filterValues (lambda (value) (if (= value 0) 0 false)) plain) (js-object :zero 0))
      (same plain (js-object :zero 0 :right 2 :absent undefined)))
    (let* ((bridge (js* "(initialize) => class RecordLike { constructor() { initialize(this); } }"))
           (RecordLike (funcall bridge (lambda (self) (put self :value 1)))))
      (js-call (expect (lambda () (js-call objects :keys (new RecordLike)))) :toThrow "IReduce/reduce"))))
  (test "external protocol values reuse text and keyed algorithms" (lambda ()
    (let* ((textBridge (js* "(initialize) => class TextView { constructor(value) { initialize(this, value); } }"))
           (TextView (funcall textBridge (lambda (self value) (put self :value value) (Object/freeze self))))
           (keyedBridge (js* "(initialize) => class KeyedValue { constructor(entries) { initialize(this, entries); } }"))
           (KeyedValue (funcall keyedBridge (lambda (self entries)
             (put self :entries (Object/freeze (js-call entries :map (lambda (entry) (Object/freeze (js-array (aref entry 0) (aref entry 1))))))) (Object/freeze self)))))
      (extendProtocolType (get collection :ICounted) TextView (js-object :count (lambda (value) (get (get value :value) :length))))
      (extendProtocolType (get collection :IIndexed) TextView (js-object :nth (lambda (value index &rest notFound)
        (cond ((and (Number/isInteger index) (>= index 0) (< index (get (get value :value) :length))) (aref (get value :value) index))
              ((> (js-length notFound) 0) (aref notFound 0))
              (t (throw (new globalThis.RangeError "text view index outside bounds")))))))
      (be (js-call text :slice 1 4 (new TextView "Eliscript")) "lis")
      (let ((keyedAssoc (lambda (value key next)
        (let ((entries (js-call (get value :entries) :filter (lambda (entry) (not (= (aref entry 0) key))))))
          (js-call entries :push (js-array key next)) (new KeyedValue entries)))))
        (extendProtocolType (get collection :IEmptyable) KeyedValue (js-object :empty (lambda () (new KeyedValue (js-array)))))
        (extendProtocolType (get collection :IConj) KeyedValue (js-object :conj (lambda (value entry) (funcall keyedAssoc value (aref entry 0) (aref entry 1)))))
        (extendProtocolType (get collection :ILookup) KeyedValue (js-object :get (lambda (value key notFound)
          (let* ((entry (js-call (get value :entries) :find (lambda (item) (= (aref item 0) key))))
                 (found (if (nullish? entry) undefined (aref entry 1))))
            (if (nullish? found) (if (= notFound undefined) nil notFound) found)))))
        (extendProtocolType (get collection :IAssociative) KeyedValue (js-object :assoc keyedAssoc :contains (lambda (value key) (js-call (get value :entries) :some (lambda (entry) (= (aref entry 0) key))))))
        (extendProtocolType (get collection :IReduce) KeyedValue (js-object :reduce (lambda (value reducer &rest initial)
          (Reflect/apply (get collection :reduce) undefined (js-call (js-array (get value :entries) reducer) :concat (Array/from initial))))))
        (let ((value (new KeyedValue (js-array (js-array "left" 1) (js-array "right" 2)))))
          (same (get (js-call objects :mapValues (lambda (current) (* current 10)) value) :entries) (js-array (js-array "left" 10) (js-array "right" 20)))
          (same (get (js-call objects :pick value (js-array "right")) :entries) (js-array (js-array "right" 2)))
          (same (get (js-call objects :merge value (new KeyedValue (js-array (js-array "right" 9) (js-array "next" 3)))) :entries) (js-array (js-array "left" 1) (js-array "right" 9) (js-array "next" 3))))))))
  (test "core object transforms use transient persistent-map construction" (lambda ()
    (let ((builder (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_MAP))) (value 0))
      (while (< value 50000) (setq builder (Reflect/apply (get transientRuntime :assocBang) undefined (js-array builder value value)) value (1+ value)))
      (let* ((source (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array builder))) (reference EMPTY_MAP))
        (resetPersistentMapMetrics)
        (js-call (Array/from source) :forEach (lambda (entry) (setq reference (js-call reference :assoc (aref entry 0) (1+ (aref entry 1))))))
        (let ((persistentAllocations (get (persistentMapMetrics) :nodeAllocations)))
          (resetPersistentMapMetrics) (resetTransientMapMetrics)
          (let ((mapped (js-call objects :mapValues (lambda (value) (1+ value)) source)))
            (be (get mapped :count) 50000) (be (js-call mapped :get 0) 1) (be (js-call mapped :get 49999) 50000)
            (be (equalValues mapped reference) t)
            (js-call (expect (get (persistentMapMetrics) :nodeAllocations)) :toBeLessThan (/ persistentAllocations 3))
            (js-call (expect (transientMapMetrics)) :toMatchObject (js-object :persistentCalls 1 :invalidCalls 0))))))) 30000)
  (test "core text/object production artifacts are fixed-point and cross-host" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-core-values-")))) (bootstrapDirectory (resolve directory "bootstrap"))
           (seedRoot (resolve directory "seed")) (selfHostedRoot (resolve directory "self-hosted")))
      (try
        (await (Promise/all (js-array (mkdir seedRoot (js-object :recursive t)) (mkdir selfHostedRoot (js-object :recursive t)))))
        (await (Promise/all (js-array (symlink (resolve ROOT "runtime") (resolve seedRoot "runtime") "dir") (symlink (resolve ROOT "runtime") (resolve selfHostedRoot "runtime") "dir"))))
        (await (run (js-array (resolve ROOT "bin/eliscript-bootstrap")) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR bootstrapDirectory)))
        (let ((artifacts (js-array)) (index 0))
          (while (< index (js-length MODULES))
            (let* ((module (aref MODULES index)) (name (get module :name))
                   (seed (resolve seedRoot (str "stdlib/core/" name "-impl.mjs"))) (selfHosted (resolve selfHostedRoot (str "stdlib/core/" name "-impl.mjs"))))
              (await (compile (resolve ROOT "bin/eliscript") (get module :source) seed (js-object)))
              (await (compile (resolve ROOT "bin/eliscript-portable") (get module :source) selfHosted (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))
              (be (await (readFile selfHosted "utf8")) (await (readFile seed "utf8")))
              (be (await (readFile (str selfHosted ".map") "utf8")) (await (readFile (str seed ".map") "utf8")))
              (be (await (readFile seed "utf8")) (await (readFile (get module :committed) "utf8")))
              (same (canonicalSourceMap (await (readFile (str seed ".map") "utf8")) name) (canonicalSourceMap (await (readFile (str (get module :committed) ".map") "utf8")) name))
              (let ((facade (await (readFile (get module :facade) "utf8"))))
                (js-call (expect facade) :toContain (str "from \"" "./" name "-impl.mjs" "\""))
                (js-call (get (expect facade) :not) :toContain "vite") (js-call (get (expect facade) :not) :toContain "react"))
              (js-call artifacts :push (js-object :seed seed :selfHosted selfHosted :committed (get module :committed))))
            (setq index (1+ index)))
          (let ((reports (js-array)) (texts (Object/values (aref artifacts 0))) (objects (Object/values (aref artifacts 1))) (textIndex 0))
            (while (< textIndex (js-length texts))
              (let ((objectIndex 0))
                (while (< objectIndex (js-length objects))
                  (js-call reports :push (await (execute BUN (aref texts textIndex) (aref objects objectIndex))))
                  (js-call reports :push (await (execute NODE (aref texts textIndex) (aref objects objectIndex))))
                  (setq objectIndex (1+ objectIndex))))
              (setq textIndex (1+ textIndex)))
            (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
            (js-call (expect (aref reports 0)) :toMatchObject (js-object "text" (js-object "empty" t "slice" "A\ud83d\ude00" "surrogate" 55357 "starts" t "ends" t "contains" t "stripped" "article" "trimmed" "Eliscript" "blank" t "joined" "a/2/false" "repeated" "ababab") "object" (js-object "keys" (js-array "zero" "right" "absent") "sourceUnchanged" t "associated" (js-array 0 2 3) "safePrototype" t "missingPreserved" t "absentIdentity" t "valueKey" t)))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 90000)
)
