(module tests.wasm-managed-arrays-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst is-instance (js* "(a, b) => a instanceof b"))
  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar runtimeProgram nil)
  (defvar program nil)
  (defvar bytes nil)
  (defvar js nil)

  (defconst mixed-surrogate (str "中😀" (String/fromCharCode 55296)))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-arrays-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq runtimeProgram
        (js-call (get backend :compiler) :compile_ir_string
                 (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                 "runtime.eli"))
      (setq program
        (js-call (get backend :compiler) :compile_ir_string
                 (await (readFile "tests/fixtures/wasm-managed-arrays.eli" "utf8"))
                 "arrays.eli"))
      (setq bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtimeProgram)))
      (funcall assert (WebAssembly/validate bytes))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (setq js
        (await (funcall dyn-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program))
                                      :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun box-val (a x)
    (let ((ty (funcall js-typeof x)))
      (cond
        ((= ty "number") (js-call a :number x))
        ((= ty "string") (js-call a :string x))
        (t x))))

  (defun read-val (a x)
    (if (or (nullish? x) (/= (funcall js-typeof x) "object"))
      x
      (let ((k (get x :kind)))
        (cond
          ((= k 4) (js-call a :readNumber x))
          ((= k 5) (js-call a :readString x))
          ((= k 14)
           (Array/from (js-object :length (js-call a :length x))
             (lambda (_ i)
               (let ((v (js-call a :get x i)))
                 (try
                   (read-val a v)
                   (finally (js-call a :release v)))))))
          (t x)))))

  (defun invoke-val (a name args)
    (let ((res (js-call a :invoke name args)))
      (try
        (read-val a res)
        (finally (js-call a :release res)))))

  (defun keys-of (a value)
    (invoke-val a "keys" (js-array value)))

  (defun has-own (a value key)
    (let ((k (box-val a key)))
      (try
        (invoke-val a "has" (js-array value k))
        (finally (js-call a :release k)))))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (defun make-sparse-6 ()
    (let ((r (globalThis.Array 6)))
      (put r 0 t)
      (put r 2 undefined)
      (put r 3 false)
      (put r 5 t)
      r))

  (defun make-sparse-3 ()
    (let ((r (globalThis.Array 3)))
      (put r 0 t)
      (put r 2 undefined)
      r))

  (test "ordinary source arrays construct and access exact values, nullish nth and defaults with JS-equivalent evaluation order"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes))
            (inputs (js-array nil false t undefined 0 -0.0 globalThis.NaN globalThis.Infinity "" mixed-surrogate)))
        (js-call a :auto 1)
        (js-call inputs :forEach
          (lambda (value)
            (let* ((v (box-val a value))
                   (arr (js-call a :invoke "make" (js-array v nil undefined)))
                   (ref (js-call js :make value nil undefined)))
              (js-call assert :deepEqual (read-val a arr) ref)
              (js-call (js-array 0 1 2 3 -0.0 -1 1.5 globalThis.NaN globalThis.Infinity "0" "01" "3" "length") :forEach
                (lambda (i)
                  (let ((key (box-val a i)))
                    (js-call assert :deepEqual (invoke-val a "nth-value" (js-array key arr)) (js-call js :nth_value i ref))
                    (js-call assert :deepEqual (invoke-val a "at" (js-array arr key)) (js-call js :at ref i))
                    (js-call a :release key))))
              (let ((zero (js-call a :number 0))
                    (fallback (js-call a :string "fallback")))
                (js-call assert :deepEqual (invoke-val a "get-value" (js-array arr zero fallback)) (js-call js :get_value ref 0 "fallback"))
                (js-call assert :equal (invoke-val a "fallback-order" (js-array arr)) (js-call js :fallback_order ref))
                (js-call assert :deepEqual (invoke-val a "key-order" (js-array arr)) (js-call js :key_order ref))
                (js-call (js-array v arr zero fallback) :forEach (lambda (x) (js-call a :release x)))
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
        (let ((empty (js-call a :invoke "empty" (js-array))))
          (js-call assert :equal (invoke-val a "size" (js-array empty)) 0)
          (js-call a :release empty)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "array index assignment, length changes, append/pop and slices preserve identity and every stored value"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (x (js-call a :number -0.0))
             (y (js-call a :string "😀"))
             (arr (js-call a :invoke "make" (js-array x nil y)))
             (ref (js-call js :make -0.0 nil "😀")))
        (js-call a :auto 1)
        (js-call (js-array (js-array 5 false) (js-array 1 undefined) (js-array 0 globalThis.NaN)) :forEach
          (lambda (pair)
            (let* ((i (aref pair 0))
                   (value (aref pair 1))
                   (key (box-val a i))
                   (v (box-val a value)))
              (js-call assert :deepEqual (invoke-val a "write" (js-array arr key v)) (js-call js :write ref i value))
              (js-call assert :deepEqual (read-val a arr) (Array/from ref))
              (js-call a :release key)
              (js-call a :release v))))
        (js-call (js-array 8 2 0 3 -0.0 4) :forEach
          (lambda (len)
            (let ((n (js-call a :number len)))
              (funcall assert (Object/is (invoke-val a "truncate" (js-array arr n)) (js-call js :truncate ref len)))
              (js-call assert :deepEqual (read-val a arr) (Array/from ref))
              (js-call a :release n))))
        (js-call assert :equal (invoke-val a "append" (js-array arr x y)) (js-call js :append ref -0.0 "😀"))
        (js-call assert :equal (invoke-val a "append-none" (js-array arr)) (js-call js :append_none ref))
        (js-call assert :deepEqual (read-val a arr) (Array/from ref))
        (js-call (js-array (js-array 0 undefined)
                           (js-array -2 undefined)
                           (js-array 1 3)
                           (js-array 1.5 3.8)
                           (js-array (- globalThis.Infinity) globalThis.Infinity)
                           (js-array globalThis.NaN globalThis.NaN)
                           (js-array 0 -0.0)
                           (js-array 1099511627776 2199023255552)) :forEach
          (lambda (bounds)
            (let* ((s (aref bounds 0))
                   (e (aref bounds 1))
                   (start (box-val a s))
                   (end (box-val a e)))
              (js-call assert :deepEqual (invoke-val a "interval" (js-array arr start end)) (Array/from (js-call js :interval ref s e)))
              (js-call a :release start)
              (js-call a :release end))))
        (js-call assert :deepEqual (invoke-val a "copy" (js-array arr)) (Array/from (js-call js :copy ref)))
        (let ((i 0))
          (while (< i 8)
            (js-call assert :deepEqual (invoke-val a "remove-last" (js-array arr)) (js-call js :remove_last ref))
            (js-call assert :deepEqual (read-val a arr) (Array/from ref))
            (setq i (+ i 1))))
        (js-call (js-array arr x y) :forEach (lambda (v) (js-call a :release v)))
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "cyclic arrays, assignment references and growing arrays retain edges through GC and release them on shrink"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 512 :initialBytes 32768 :maxBytes 1048576)))
             (x (js-call a :string "x"))
             (y (js-call a :map)))
        (js-call a :auto 1)
        (let* ((cycle (js-call a :invoke "nested" (js-array x y)))
               (self (js-call a :get cycle 0)))
          (funcall assert (js-call a :keyEqual cycle self))
          (js-call a :release self)
          (js-call a :release x)
          (js-call a :release y)
          (js-call a :collect)
          (js-call assert :equal (js-call a :length cycle) 2)
          (js-call a :release cycle)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0))
        (let* ((cnt (js-call a :number 128))
               (arr (js-call a :invoke "grow-loop" (js-array cnt))))
          (js-call assert :deepEqual (read-val a arr) (Array/from (js-object :length 128) (lambda (_ i) i)))
          (funcall assert (> (get (js-call a :stats) :collections) 128))
          (let* ((other (js-call a :invoke "empty" (js-array)))
                 (returned (js-call a :invoke "write-order" (js-array arr other)))
                 (alias (js-call a :get arr 0)))
            (funcall assert (js-call a :keyEqual returned other))
            (funcall assert (js-call a :keyEqual alias other))
            (js-call a :release alias)
            (js-call a :release returned)
            (js-call a :release other))
          (let ((zero (js-call a :number 0)))
            (invoke-val a "truncate" (js-array arr zero))
            (js-call a :release zero)
            (js-call a :release arr)
            (js-call a :release cnt)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))

  (test "array operations refuse invalid lengths, missing capabilities and stale/foreign handles without weakening input identity"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (foreign (js-call b :number 1)))
        (js-call (js-array -1 0.5 globalThis.NaN globalThis.Infinity 4294967296) :forEach
          (lambda (value)
            (let ((n (js-call a :number value)))
              (js-call assert :throws (lambda () (js-call a :invoke "truncate" (js-array arr n))))
              (js-call assert :equal (js-call a :length arr) 0)
              (js-call a :release n))))
        (js-call assert :throws
          (lambda () (js-call a :invoke "append" (js-array arr foreign false)))
          (lambda (e) (diag-code? e "ELI-RT0001")))
        (js-call b :release foreign)
        (js-call b :collect)
        (let ((before (JSON/stringify program)))
          (js-call (get backend :managed) :emit_managed_wasm program runtimeProgram)
          (js-call assert :equal (JSON/stringify program) before))
        (js-call (js-array "(js-call x :flatMap (lambda (a) a))"
                           "(js-call x k)"
                           "(new globalThis.Object)"
                           "(js-nth :length x)") :forEach
          (lambda (expr)
            (let ((ir (js-call (get backend :compiler) :compile_ir_string
                               (str "(defun f (x k) (if false " expr " x)) (export f)")
                               "unsupported-container.eli")))
              (js-call assert :throws
                (lambda () (js-call (get backend :managed) :emit_managed_wasm ir runtimeProgram))
                (lambda (e)
                  (and (diag-code? e "ELI-B0001")
                       (= (get (get (get e :eliscriptDiagnostic) :location) :file) "unsupported-container.eli")))))))
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :throws
          (lambda () (js-call a :invoke "size" (js-array arr)))
          (lambda (e) (diag-code? e "ELI-RT0001")))
        (js-call assert :equal (js-call a :live) 0))))

  (test "deterministic random array edits and slices match the independent JS control through collection and geometric growth"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (ref (js-array))
             (state 34818615)
             (next-u32 (lambda ()
                         (setq state (bit-xor state (bit-shift-left state 13)))
                         (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                         (setq state (bit-xor state (bit-shift-left state 5)))
                         (unsigned-bit-shift-right state 0)))
             (values (js-array nil false t undefined globalThis.NaN globalThis.Infinity (- globalThis.Infinity) -0.0 mixed-surrogate globalThis.Number.MIN_VALUE))
             (i 0))
        (js-call a :auto 1)
        (while (< i 1024)
          (let* ((op (% (funcall next-u32) 5))
                 (x (aref values (% (funcall next-u32) (get values :length))))
                 (y (aref values (% (funcall next-u32) (get values :length))))
                 (b (box-val a x))
                 (c (box-val a y))
                 (n (js-call a :number (% (funcall next-u32) 80))))
            (cond
              ((= op 0)
               (js-call assert :equal (invoke-val a "append" (js-array arr b c)) (js-call js :append ref x y)))
              ((= op 1)
               (js-call assert :deepEqual (invoke-val a "remove-last" (js-array arr)) (js-call js :remove_last ref)))
              ((= op 2)
               (js-call assert :deepEqual (invoke-val a "write" (js-array arr n b)) (js-call js :write ref (js-call a :readNumber n) x)))
              ((= op 3)
               (js-call assert :equal (invoke-val a "truncate" (js-array arr n)) (js-call js :truncate ref (js-call a :readNumber n))))
              (t
               (let ((start (js-call a :number (+ (- (% (funcall next-u32) 160) 80) 0.5)))
                     (end (js-call a :number (+ (- (% (funcall next-u32) 160) 80) 0.5))))
                 (js-call assert :deepEqual
                   (invoke-val a "interval" (js-array arr start end))
                   (Array/from (js-call js :interval ref (js-call a :readNumber start) (js-call a :readNumber end))))
                 (js-call a :release start)
                 (js-call a :release end))))
            (js-call assert :deepEqual (read-val a arr) (Array/from ref))
            (js-call (js-array b c n) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
          (setq i (+ i 1)))
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "array calls capture their receiver and operands once, observe argument mutation, and still evaluate ignored method arguments"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (other (js-call a :invoke "empty" (js-array)))
             (ref (js-array))
             (ref-other (js-array)))
        (js-call a :auto 1)
        (js-call assert :equal (invoke-val a "append-order" (js-array arr other)) (js-call js :append_order ref ref-other))
        (let ((first-el (js-call a :get arr 0)))
          (funcall assert (js-call a :keyEqual first-el other))
          (js-call a :release first-el))
        (let ((saved (js-call a :get arr 1)))
          (js-call assert :equal (js-call a :readNumber saved) (aref ref 1))
          (js-call a :release saved))
        (let* ((zero (js-call a :number 0))
               (marker (js-call a :invoke "make" (js-array zero nil undefined)))
               (ref-marker (js-call js :make 0 nil undefined))
               (n (js-call a :number 0)))
          ;; Avoid recursively reading the alias-containing array; pop removes its last scalar.
          (js-call assert :equal (invoke-val a "pop-extra" (js-array arr marker)) (js-call js :pop_extra ref ref-marker))
          (js-call assert :deepEqual (read-val a marker) ref-marker)
          (js-call assert :deepEqual (invoke-val a "slice-extra" (js-array other n undefined marker)) (js-call js :slice_extra ref-other 0 undefined ref-marker))
          (js-call assert :deepEqual (read-val a marker) ref-marker)
          (js-call (js-array nil undefined) :forEach
            (lambda (receiver)
              (js-call assert :throws (lambda () (js-call a :invoke "null-write" (js-array receiver marker))))
              (js-call assert :throws (lambda () (js-call js :null_write receiver ref-marker)))
              (js-call assert :deepEqual (read-val a marker) ref-marker)
              (js-call assert :equal (invoke-val a "nth-value" (js-array n receiver)) (js-call js :nth_value 0 receiver))
              (js-call assert :equal (invoke-val a "size" (js-array receiver)) (js-call js :size receiver))))
          (js-call (js-array arr other zero marker n) :forEach (lambda (v) (js-call a :release v)))
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "exact index boundaries, absent numeric keys and primitive length semantics agree without truncating or wrapping"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "make" (js-array t false undefined)))
             (ref (js-call js :make t false undefined)))
        (js-call a :auto 1)
        (js-call (js-array globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE)
                           2147483648 4294967294 4294967295 4294967296 globalThis.Number.MAX_VALUE
                           -1 0.9999999999999999 1.0000000000000002 "" "00" "00000000000"
                           "4294967294" "4294967295" "99999999999999") :forEach
          (lambda (i)
            (let ((key (box-val a i)))
              (js-call assert :deepEqual (invoke-val a "at" (js-array arr key)) (js-call js :at ref i))
              (js-call assert :deepEqual (invoke-val a "nth-value" (js-array key arr)) (js-call js :nth_value i ref))
              (js-call a :release key))))
        (js-call (js-array nil undefined false t 0 -0.0 globalThis.NaN mixed-surrogate) :forEach
          (lambda (value)
            (let ((v (box-val a value)))
              (js-call assert :deepEqual (invoke-val a "size" (js-array v)) (js-call js :size value))
              (js-call a :release v))))
        (js-call (js-array "push" "toLocaleString" "constructor" "__proto__") :forEach
          (lambda (key)
            (let ((k (js-call a :string key)))
              (js-call assert :throws
                (lambda () (js-call a :invoke "at" (js-array arr k)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (if (= key "__proto__")
                (js-call assert :throws
                  (lambda () (js-call a :invoke "write" (js-array arr k t)))
                  (lambda (e) (diag-code? e "ELI-RT0003")))
                (progn
                  (js-call assert :equal (invoke-val a "write" (js-array arr k t)) t)
                  (js-call assert :equal (invoke-val a "at" (js-array arr k)) t)))
              (js-call a :release k))))
        (let ((absent (js-call a :string "foo")))
          (js-call assert :equal (invoke-val a "at" (js-array arr absent)) (js-call js :at ref "foo"))
          (js-call assert :equal (invoke-val a "write" (js-array arr absent t)) (js-call js :write ref "foo" t))
          (js-call a :release absent))
        (let ((raw (js-call a :array (js-array t))))
          (js-call a :resize raw 3)
          (js-call assert :equal (js-call a :get raw 1) nil)
          (js-call assert :throws
            (lambda () (js-call a :get raw 3))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call a :release raw)
          (js-call a :release arr)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "capacity failure and original errors leave arrays unchanged, suppress later traps and unwind only owned frames"
    (async ()
      (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096)))
             (arr (js-call a :invoke "make" (js-array t false undefined)))
             (n (js-call a :number 2000))
             (huge (js-call a :number 4294967295))
             (ref (js-array t false undefined)))
        (js-call a :auto 1)
        (js-call (js-array n huge) :forEach
          (lambda (value)
            (js-call assert :throws
              (lambda () (js-call a :invoke "truncate" (js-array arr value)))
              (lambda (e) (diag-code? e "ELI-RT0002")))))
        (js-call assert :deepEqual (read-val a arr) ref)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (js-call a :resize arr 500)
        (let ((saved (read-val a arr)))
          (js-call assert :throws
            (lambda () (js-call a :invoke "append" (js-array arr t false)))
            (lambda (e) (diag-code? e "ELI-RT0002")))
          (js-call assert :deepEqual (read-val a arr) saved))
        (js-call a :release n)
        (js-call a :release huge)
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun value-truth (heap value)"))
             (end (js-call source :indexOf "  (defun " (+ start 3))))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((injected (js-call (get backend :compiler) :compile_ir_string
                                  (str (js-call source :slice 0 start)
                                       "  (defun value-truth (heap value) (load-u32 4294967295))\n"
                                       (js-call source :slice end))
                                  "trap-runtime.eli"))
               (rt (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program injected))))
               (target (js-call rt :invoke "make" (js-array t false undefined)))
               (marker (js-call rt :invoke "make" (js-array false nil undefined)))
               (bad (js-call rt :number 0.5))
               (good (js-call rt :number 3))
               (frame (js-call rt :frame 1)))
          (js-call rt :frameSet frame 0 target)
          (js-call assert :throws
            (lambda () (js-call rt :invoke "error-then-truth" (js-array target bad marker)))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call assert :equal (js-call rt :get marker 0) false)
          (js-call assert :equal (get (js-call rt :stats) :frameDepth) 1)
          (js-call assert :equal (js-call rt :length target) 3)
          (js-call assert :throws
            (lambda () (js-call rt :invoke "error-then-truth" (js-array target good marker)))
            (lambda (e) (funcall is-instance e globalThis.WebAssembly.RuntimeError)))
          (js-call assert :equal (get (js-call rt :stats) :frameDepth) 1)
          (let ((changed (js-call rt :get marker 0)))
            (js-call assert :equal (js-call rt :readNumber changed) 9)
            (js-call rt :release changed))
          (js-call rt :leaveFrame frame)
          (js-call (js-array target marker bad good) :forEach (lambda (v) (js-call rt :release v)))
          (js-call rt :collect)
          (js-call assert :equal (js-call rt :live) 0)))))

  (test "Node executes the identical zero-import source-array artifact with growth, Unicode and exact cleanup"
    (async ()
      (let ((wasm-path (resolve directory "arrays.wasm"))
            (runner (resolve "tests/helpers/wasm-managed-arrays-node.mjs")))
        (await (writeFile wasm-path bytes))
        (let ((child (spawnSync "node"
                                (js-array runner wasm-path)
                                (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "the exported array setter protects a borrowed child across allocating growth without relying on generated frames"
    (lambda ()
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (funcall (aref e "heap-new") 64 4096 65536)))
        (funcall (aref e "heap-auto") heap 1)
        (let* ((arr (funcall (aref e "value-array-new") heap 1))
               (_arr-root (funcall (aref e "heap-pin") heap arr))
               (key (funcall (aref e "value-number") heap 0 1075052544)))
          (funcall (aref e "heap-pin") heap key)
          (let ((child (funcall (aref e "value-number") heap 0 1078263808)))
            (js-call assert :equal (funcall (aref e "value-array-put") heap arr key child) 1)
            (js-call assert :equal (funcall (aref e "last-error")) 0)
            (js-call assert :equal (funcall (aref e "value-get") heap arr 5) child)
            (funcall (aref e "heap-collect") heap)
            (js-call assert :equal (funcall (aref e "value-get") heap arr 5) child)
            (funcall (aref e "heap-release") heap arr)
            (funcall (aref e "heap-release") heap key)
            (funcall (aref e "heap-collect") heap)
            (js-call assert :equal (funcall (aref e "heap-live") heap) 0))))))

  (test "bulk source-array construction keeps earlier getter operands alive and refuses foreign operands without changing the raw-array ABI"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes))
             (x (js-call a :number -0.0))
             (y (js-call a :string "中😀"))
             (input (js-array x)))
        (js-call a :auto 1)
        (Object/defineProperty input 1
          (js-object :get (lambda ()
                            (js-call a :release x)
                            (js-call a :collect)
                            y)
                     :enumerable t))
        (put input 2 undefined)
        (let ((arr (js-call a :sourceArray input)))
          (js-call assert :equal (get arr :kind) 14)
          (js-call assert :deepEqual (read-val a arr) (js-array -0.0 "中😀" undefined))
          (let* ((zero (js-call a :number 0))
                 (copied nil))
            (js-call assert :equal (invoke-val a "append" (js-array arr zero t)) 5)
            (setq copied (js-call a :invoke "copy" (js-array arr)))
            (js-call assert :deepEqual (read-val a copied) (js-array -0.0 "中😀" undefined 0 t))
            (js-call a :release copied)
            (js-call a :release zero)
            (js-call a :release y)
            (js-call a :release arr)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)))
        (let ((foreign (js-call b :number 1)))
          (js-call assert :throws
            (lambda () (js-call a :sourceArray (js-array foreign)))
            (lambda (e) (diag-code? e "ELI-RT0001")))
          (js-call b :release foreign)
          (js-call b :collect)
          (js-call assert :equal (js-call a :live) 0))
        (js-call assert :throws
          (lambda () (js-call a :sourceArray (js-object)))
          (lambda (e) (diag-code? e "ELI-RT0003")))
        (let ((raw (js-call a :array (js-array t))))
          (js-call assert :equal (get raw :kind) 7)
          (js-call a :release raw)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "nullish nth receivers preserve empty-array length and reject unsupported object key conversions"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (len-key (js-call a :string "length"))
             (zero (js-call a :number 0))
             (array-key (js-call a :sourceArray (js-array len-key)))
             (map-key (js-call a :map)))
        (js-call a :auto 1)
        (js-call (js-array nil undefined) :forEach
          (lambda (receiver)
            (js-call assert :equal (invoke-val a "nth-value" (js-array len-key receiver)) (js-call js :nth_value "length" receiver))
            (js-call assert :equal (invoke-val a "nth-value" (js-array zero receiver)) (js-call js :nth_value 0 receiver))
            (js-call (js-array array-key map-key) :forEach
              (lambda (key)
                (js-call assert :throws
                  (lambda () (js-call a :invoke "nth-value" (js-array key receiver)))
                  (lambda (e) (diag-code? e "ELI-RT0001")))))))
        (js-call (js-array len-key zero array-key map-key) :forEach (lambda (x) (js-call a :release x)))
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (test "sparse array presence distinguishes holes from undefined and survives slices, truncation, regrowth and pop"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (ref (js-array))
             (resize-fn (lambda (n)
                          (let ((v (js-call a :number n)))
                            (try
                              (invoke-val a "truncate" (js-array arr v))
                              (js-call js :truncate ref n)
                              (finally (js-call a :release v)))))))
        (js-call a :auto 1)
        (funcall resize-fn 6)
        (let ((key (js-call a :number 3)))
          (invoke-val a "write" (js-array arr key undefined))
          (js-call js :write ref 3 undefined)
          (js-call a :release key))
        (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
        (let ((i 0))
          (while (< i 8)
            (js-call assert :equal (has-own a arr i) (Object/hasOwn ref i))
            (setq i (+ i 1))))
        (js-call assert :equal (has-own a arr "length") t)
        (let ((copied (js-call a :invoke "copy" (js-array arr))))
          (js-call assert :deepEqual (keys-of a copied) (Object/keys (js-call ref :slice)))
          (js-call assert :equal (js-call a :length copied) 6)
          (js-call a :release copied))
        (let* ((start (js-call a :number 2))
               (end (js-call a :number 6))
               (sliced (js-call a :invoke "interval" (js-array arr start end))))
          (js-call assert :deepEqual (keys-of a sliced) (Object/keys (js-call ref :slice 2 6)))
          (js-call a :release start)
          (js-call a :release end)
          (js-call a :release sliced))
        (js-call assert :equal (invoke-val a "remove-last" (js-array arr)) (js-call ref :pop))
        (funcall resize-fn 2)
        (funcall resize-fn 6)
        (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
        (let ((again (js-call a :number 3)))
          (invoke-val a "write" (js-array arr again undefined))
          (put ref 3 undefined)
          (js-call a :release again)
          (js-call assert :deepEqual (keys-of a arr) (Object/keys ref)))
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (test "array named properties use exact primitive property keys, preserve insertion order and remain separate from length"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (ref (js-array))
             (pairs (js-array (js-array "z" "中😀")
                              (js-array "01" undefined)
                              (js-array -1 t)
                              (js-array 1.5 false)
                              (js-array globalThis.NaN "nan")
                              (js-array globalThis.Infinity "inf")
                              (js-array nil "nil")
                              (js-array false "bool")
                              (js-array undefined "missing")
                              (js-array "4294967295" "named")
                              (js-array 2 "two")
                              (js-array -0.0 "zero")
                              (js-array "a" "last")
                              (js-array "z" "updated"))))
        (js-call a :auto 1)
        (js-call pairs :forEach
          (lambda (pair)
            (let* ((k (aref pair 0))
                   (v (aref pair 1))
                   (key (box-val a k))
                   (value (box-val a v)))
              (js-call assert :deepEqual (invoke-val a "write" (js-array arr key value)) (js-call js :write ref k v))
              (js-call assert :deepEqual (invoke-val a "at" (js-array arr key)) (js-call js :at ref k))
              (js-call assert :equal (has-own a arr k) (Object/hasOwn ref k))
              (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
              (js-call a :release key)
              (js-call a :release value)
              (js-call a :collect))))
        (js-call assert :equal (js-call a :length arr) (get ref :length))
        (let ((n (js-call a :number 1)))
          (invoke-val a "truncate" (js-array arr n))
          (put ref "length" 1)
          (js-call a :release n)
          (js-call assert :deepEqual (keys-of a arr) (Object/keys ref)))
        (let ((sparse-copy (js-call a :invoke "copy" (js-array arr))))
          (js-call assert :deepEqual (keys-of a sparse-copy) (Object/keys (js-call ref :slice)))
          (js-call a :release sparse-copy))
        (js-call (js-array "not-present" "00" globalThis.Number.MAX_VALUE globalThis.Number.MIN_VALUE) :forEach
          (lambda (k)
            (let ((key (box-val a k)))
              (js-call assert :deepEqual (invoke-val a "at" (js-array arr key)) (js-call js :at ref k))
              (js-call a :release key))))
        (let ((grow (js-call a :number 128)))
          (invoke-val a "truncate" (js-array arr grow))
          (put ref "length" 128)
          (js-call a :release grow)
          (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
          (js-call a :collect)
          (js-call assert :deepEqual (keys-of a arr) (Object/keys ref)))
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "array object-assoc copies enumerable present slots and names into an ordinary object in JS order"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (ref (js-array)))
        (js-call a :auto 1)
        (js-call (js-array (js-array 4 undefined) (js-array "name" "😀") (js-array 1 t)) :forEach
          (lambda (pair)
            (let* ((k (aref pair 0))
                   (v (aref pair 1))
                   (key (box-val a k))
                   (value (box-val a v)))
              (invoke-val a "write" (js-array arr key value))
              (put ref k v)
              (js-call a :release key)
              (js-call a :release value))))
        (let* ((key (js-call a :string "__proto__"))
               (value (js-call a :number -0.0))
               (copied (js-call a :invoke "assoc" (js-array arr key value)))
               (expected (js-call js :assoc ref "__proto__" -0.0)))
          (js-call assert :equal (get copied :kind) 13)
          (js-call assert :deepEqual (keys-of a copied) (Object/keys expected))
          (js-call (Object/keys expected) :forEach
            (lambda (k)
              (let ((name (js-call a :string k)))
                (js-call assert :deepEqual (invoke-val a "at" (js-array copied name)) (aref expected k))
                (js-call a :release name))))
          (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
          (js-call assert :equal (has-own a copied "length") false)
          (js-call (js-array copied key value arr) :forEach (lambda (x) (js-call a :release x)))
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "primitive array length conversion matches exact JS values and rejects invalid lengths without mutation"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "make" (js-array t false undefined)))
             (ref (js-array t false undefined)))
        (js-call a :auto 1)
        (js-call (js-array "6" "0x4" t false nil undefined "1.5" "4294967296" -1 globalThis.NaN globalThis.Infinity) :forEach
          (lambda (n)
            (let ((v (box-val a n))
                  (err undefined))
              (try
                (js-call js :truncate ref n)
                (catch e (setq err e)))
              (if (not (undefined? err))
                (js-call assert :throws
                  (lambda () (js-call a :invoke "truncate" (js-array arr v)))
                  (lambda (e) (diag-code? e "ELI-RT0003")))
                (js-call assert :deepEqual (invoke-val a "truncate" (js-array arr v)) n))
              (js-call assert :equal (js-call a :length arr) (get ref :length))
              (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
              (js-call a :release v))))
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "shadowed array methods evaluate arguments before noncallable failure and capture the original builtin before mutation"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call (js-array "push" "pop" "slice") :forEach
          (lambda (method)
            (let* ((arr (js-call a :invoke "empty" (js-array)))
                   (marker (js-call a :invoke "make" (js-array false nil undefined)))
                   (ref (js-array))
                   (ref-marker (js-array false nil undefined))
                   (key (js-call a :string method))
                   (entry (if (= method "push") "append" method)))
              (invoke-val a "write" (js-array arr key false))
              (put ref method false)
              (js-call assert :equal (invoke-val a "at" (js-array arr key)) false)
              (js-call assert :throws (lambda () (funcall (aref js (str entry "_shadow")) ref ref-marker)))
              (js-call assert :throws
                (lambda () (js-call a :invoke (str entry "-shadow") (js-array arr marker)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call assert :deepEqual (read-val a marker) ref-marker)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
              (js-call (js-array arr marker key) :forEach (lambda (x) (js-call a :release x)))
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0))))
        (let ((arr (js-call a :invoke "empty" (js-array)))
              (ref (js-array)))
          (js-call assert :equal (invoke-val a "append-replace" (js-array arr)) (js-call js :append_replace ref))
          (js-call assert :deepEqual (read-val a arr) (Array/from ref))
          (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
          (js-call a :release arr)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "bulk source-array bridging preserves own holes, named values and getter roots without invoking an overridden iterator"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (input (js-array))
             (x (js-call a :string "x"))
             (y (js-call a :string "中😀")))
        (js-call a :auto 1)
        (put input "length" 5)
        (put input 1 x)
        (Object/defineProperty input 3
          (js-object :get (lambda ()
                            (js-call a :release x)
                            (js-call a :collect)
                            y)
                     :enumerable t))
        (put input "label" y)
        (Object/defineProperty input "__proto__"
          (js-object :value false :writable t :enumerable t))
        (put input globalThis.Symbol.iterator
             (lambda () (throw (globalThis.Error "iterator must not control a source array snapshot"))))
        (let ((arr (js-call a :sourceArray input)))
          (js-call assert :deepEqual (keys-of a arr) (Object/keys input))
          (js-call assert :equal (js-call a :length arr) 5)
          (js-call assert :equal (has-own a arr 0) false)
          (js-call assert :equal (has-own a arr 1) t)
          (let ((first-el (js-call a :get arr 1)))
            (js-call assert :equal (js-call a :readString first-el) "x")
            (js-call a :release first-el))
          (let ((key (js-call a :string "label")))
            (js-call assert :equal (invoke-val a "at" (js-array arr key)) "中😀")
            (js-call a :release key)
            (js-call a :release y)
            (js-call a :release arr)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))))

  (test "random sparse and named array edits preserve exact own keys, independent slices and shallow objects through GC"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (ref (js-array))
             (seed 119222953)
             (next-u32 (lambda ()
                         (setq seed (bit-xor seed (bit-shift-left seed 13)))
                         (setq seed (bit-xor seed (unsigned-bit-shift-right seed 17)))
                         (setq seed (bit-xor seed (bit-shift-left seed 5)))
                         (unsigned-bit-shift-right seed 0)))
             (keys (js-array "a" "z" "00" "-0" "4294967295" nil false undefined globalThis.NaN -1 0.5))
             (values (js-array undefined nil t false -0.0 globalThis.NaN globalThis.Infinity mixed-surrogate))
             (i 0))
        (js-call a :auto 1)
        (while (< i 512)
          (let ((op (% (funcall next-u32) 5)))
            (cond
              ((< op 2)
               (let* ((key (if (= op 0) (% (funcall next-u32) 80) (aref keys (% (funcall next-u32) (get keys :length)))))
                      (value (aref values (% (funcall next-u32) (get values :length))))
                      (k (box-val a key))
                      (v (box-val a value)))
                 (js-call assert :deepEqual (invoke-val a "write" (js-array arr k v)) (js-call js :write ref key value))
                 (js-call a :release k)
                 (js-call a :release v)))
              ((= op 2)
               (let* ((n (% (funcall next-u32) 96))
                      (v (js-call a :number n)))
                 (invoke-val a "truncate" (js-array arr v))
                 (put ref "length" n)
                 (js-call a :release v)))
              ((= op 3)
               (js-call assert :deepEqual (invoke-val a "remove-last" (js-array arr)) (js-call ref :pop)))
              (t
               (let* ((start (- (% (funcall next-u32) 160) 80))
                      (end (- (% (funcall next-u32) 160) 80))
                      (s (js-call a :number start))
                      (e (js-call a :number end))
                      (copied (js-call a :invoke "interval" (js-array arr s e)))
                      (expected (js-call ref :slice start end)))
                 (js-call assert :deepEqual (keys-of a copied) (Object/keys expected))
                 (js-call assert :deepEqual (read-val a copied) (Array/from expected))
                 (js-call a :release copied)
                 (js-call a :release s)
                 (js-call a :release e))))
            (js-call assert :deepEqual (keys-of a arr) (Object/keys ref))
            (js-call assert :deepEqual (read-val a arr) (Array/from ref))
            (js-call (js-array 0 1 79 "length" "00" "a" "not-present") :forEach
              (lambda (k)
                (js-call assert :equal (has-own a arr k) (Object/hasOwn ref k))))
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
          (setq i (+ i 1)))
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "named array references survive resize and cycles while holes never retain an unrelated heap slot"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :invoke "empty" (js-array)))
             (key (js-call a :string "saved"))
             (value (js-call a :string "retained")))
        (js-call a :auto 1)
        (invoke-val a "write" (js-array arr key value))
        (js-call a :release value)
        (let ((n (js-call a :number 256)))
          (invoke-val a "truncate" (js-array arr n))
          (js-call a :release n))
        (js-call a :collect)
        (js-call assert :equal (invoke-val a "at" (js-array arr key)) "retained")
        (let* ((self-key (js-call a :string "self"))
               (returned (js-call a :invoke "write" (js-array arr self-key arr))))
          (funcall assert (js-call a :keyEqual returned arr))
          (js-call (js-array returned self-key key arr) :forEach (lambda (x) (js-call a :release x)))
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (h (funcall (aref e "heap-new") 32 4096 16384))
             (sparse (funcall (aref e "value-array-new") h 16))
             (i 0))
        (funcall (aref e "heap-pin") h sparse)
        (while (< i 5)
          (funcall (aref e "value-number") h 0 (+ 1072693248 i))
          (setq i (+ i 1)))
        (js-call assert :equal (funcall (aref e "heap-live") h) 6)
        (funcall (aref e "heap-collect") h)
        (js-call assert :equal (funcall (aref e "heap-live") h) 1)
        (js-call assert :equal (funcall (aref e "value-get") h sparse 0) 3)
        (js-call assert :equal (funcall (aref e "heap-pin") h 4) 0)
        (js-call assert :equal (funcall (aref e "last-error")) 1)
        (funcall (aref e "heap-release") h sparse)
        (funcall (aref e "heap-collect") h)
        (js-call assert :equal (funcall (aref e "heap-live") h) 0))))

  (test "array named-property capacity failure is atomic and raw allocating setters protect all borrowed operands"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 4096)))
             (arr (js-call a :sourceArray (new globalThis.Array 550)))
             (key (js-call a :string "new"))
             (value (js-call a :number 7)))
        (js-call assert :throws
          (lambda () (js-call a :invoke "write" (js-array arr key value)))
          (lambda (e) (diag-code? e "ELI-RT0002")))
        (js-call assert :equal (invoke-val a "has" (js-array arr key)) false)
        (js-call assert :equal (js-call a :length arr) 550)
        (js-call assert :equal (js-call a :get arr 0) undefined)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (js-call (js-array arr key value) :forEach (lambda (x) (js-call a :release x)))
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (h (funcall (aref e "heap-new") 64 4096 65536))
             (target (funcall (aref e "value-array-new") h 0))
             (name (funcall (aref e "value-string") h 1)))
        (funcall (aref e "value-unit-set") h name 0 120)
        (funcall (aref e "value-seal") h name)
        (let ((child (funcall (aref e "value-number") h 0 1078263808)))
          (funcall (aref e "heap-auto") h 1)
          (js-call assert :equal (funcall (aref e "value-array-put") h target name child) 1)
          (js-call assert :equal (funcall (aref e "last-error")) 0)
          (funcall (aref e "heap-pin") h target)
          (funcall (aref e "heap-pin") h name)
          (funcall (aref e "heap-collect") h)
          (js-call assert :equal (funcall (aref e "value-array-get") h target name 0) child)
          (js-call (js-array target name) :forEach (lambda (v) (funcall (aref e "heap-release") h v)))
          (funcall (aref e "heap-collect") h)
          (js-call assert :equal (funcall (aref e "heap-live") h) 0)))))

  (test "source-array slice converts primitive positions before exact clamping and preserves holes"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (ref (make-sparse-6))
             (arr (js-call a :sourceArray (make-sparse-6))))
        (js-call a :auto 1)
        (js-call (js-array (js-array "1" "5")
                           (js-array "0x2" "Infinity")
                           (js-array "-2" undefined)
                           (js-array "not-number" "4")
                           (js-array t false)
                           (js-array nil "3.5")
                           (js-array "0xbcf8f9bdba22840724d028768a8a77b3e6b0f283670085477910eccc4e9d6b278a11db79c280d4e9c237774812029ac7ce82daaafca38" undefined)) :forEach
          (lambda (bounds)
            (let* ((start (aref bounds 0))
                   (end (aref bounds 1))
                   (s (box-val a start))
                   (e (box-val a end))
                   (copied (js-call a :invoke "interval" (js-array arr s e)))
                   (expected (js-call ref :slice start end)))
              (js-call assert :deepEqual (keys-of a copied) (Object/keys expected))
              (js-call assert :deepEqual (read-val a copied) (Array/from expected))
              (js-call a :release copied)
              (js-call a :release s)
              (js-call a :release e))))
        (js-call a :release arr)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "indexed source-array reads and existing string-key presence queries allocate no frames, text or collections"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (arr (js-call a :sourceArray (make-sparse-3)))
             (num (js-call a :number 0))
             (txt (js-call a :string "0"))
             (missing (js-call a :string "absent"))
             (len-str (js-call a :string "length")))
        (js-call a :auto 1)
        (let ((before (js-call a :stats))
              (i 0))
          (while (< i 128)
            (js-call assert :equal (invoke-val a "at" (js-array arr num)) t)
            (js-call assert :equal (invoke-val a "at" (js-array arr txt)) t)
            (js-call assert :equal (invoke-val a "at" (js-array arr missing)) undefined)
            (js-call assert :equal (invoke-val a "has" (js-array arr num)) t)
            (js-call assert :equal (invoke-val a "has" (js-array arr len-str)) t)
            (js-call assert :equal (invoke-val a "has" (js-array arr missing)) false)
            (setq i (+ i 1)))
          (let ((after (js-call a :stats)))
            (js-call assert :equal (get after :usedBytes) (get before :usedBytes))
            (js-call assert :equal (get after :collections) (get before :collections))
            (js-call assert :equal (get after :frameDepth) 0)))
        (js-call (js-array arr num txt missing len-str) :forEach (lambda (v) (js-call a :release v)))
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "real array lookup and argument traps retain caller frames and precede shadowed-method callability failure"
    (async ()
      (let ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
            (specs (js-array (js-array "value-array-method-check" "heap value method")
                             (js-array "value-property-put" "heap object key child")))
            (idx 0))
        (while (< idx (get specs :length))
          (let* ((spec (aref specs idx))
                 (name (aref spec 0))
                 (parameters (aref spec 1))
                 (start (js-call source :indexOf (str "  (defun " name " ")))
                 (end (js-call source :indexOf "  (defun " (+ start 3))))
            (funcall assert (and (>= start 0) (> end start)))
            (let* ((injected (js-call (get backend :compiler) :compile_ir_string
                                      (str (js-call source :slice 0 start)
                                           "  (defun " name " (" parameters ") (load-u32 4294967295))\n"
                                           (js-call source :slice end))
                                      "array-trap-runtime.eli"))
                   (a (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program injected))))
                   (input (js-array)))
              (js-call a :auto 1)
              (put input "push" false)
              (let* ((target (js-call a :sourceArray input))
                     (marker (js-call a :sourceArray (js-array false)))
                     (frame (js-call a :frame 1)))
                (js-call a :frameSet frame 0 target)
                (js-call assert :throws
                  (lambda () (js-call a :invoke "append-shadow" (js-array target marker)))
                  (lambda (e) (funcall is-instance e globalThis.WebAssembly.RuntimeError)))
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                (js-call assert :equal (js-call a :get marker 0) false)
                (js-call a :leaveFrame frame)
                (js-call a :release target)
                (js-call a :release marker)
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0))))
          (setq idx (+ idx 1)))))))
