(module tests.multimethod
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (defconst dependencies (js-array "bit" "identifier" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value" "hierarchy"))
  (defasync compileFamily (command output environment)
    (await (mkdir output (js-object :recursive t)))
    (let ((index 0))
      (while (< index (js-length dependencies))
        (let ((name (aref dependencies index)))
          (await (runSuccessful (js-array command "--source-map" "--output" (resolve output (str name ".eli")) (resolve ROOT "stdlib" (str name ".eli"))) environment)))
        (setq index (1+ index))))
    (await (runSuccessful (js-array command "--source-map" "--output" (resolve output "multimethod.eli") (resolve ROOT "stdlib/multimethod.eli")) environment))
    (await (runSuccessful (js-array command "--source-map" "--output" (resolve output "declarative-multimethod.mjs") (resolve ROOT "tests/fixtures/declarative-multimethod.eli")) environment)))
  (test "Eliscript multimethods dispatch on values with persistent method snapshots" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-multimethod-"))))
           (bootstrap (resolve directory "bootstrap")) (seed (resolve directory "seed")) (self (resolve directory "self-hosted")))
      (try
        (await (compileFamily COMPILER seed (js-object))) (await (seedCompilerFixture bootstrap))
        (await (compileFamily (resolve ROOT "bin/eliscript-portable") self (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
        (let ((files (js-call (js-call dependencies :map (lambda (name) (str name ".eli"))) :concat (js-array "multimethod.eli" "declarative-multimethod.mjs"))) (index 0))
          (while (< index (js-length files))
            (let* ((relative (aref files index)) (seedPath (resolve seed relative)) (selfPath (resolve self relative)))
              (be (await (readFile selfPath "utf8")) (await (readFile seedPath "utf8")))
              (be (await (readFile (str selfPath ".map") "utf8")) (await (readFile (str seedPath ".map") "utf8"))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (directories (js-array seed self)) (index 0) (fixture (resolve ROOT "tests/fixtures/multimethod-host.mjs")))
          (while (< index 2)
            (let ((modulePath (resolve (aref directories index) "multimethod.eli")))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array "bun" "--preload" (resolve ROOT "tests/fixtures/compiled-eli-bun-preload.mjs") fixture modulePath (resolve (aref directories index) "declarative-multimethod.mjs")) (js-object)))))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array (get (get globalThis.process :env) :NODE "node") "--experimental-loader" (resolve ROOT "tests/fixtures/compiled-eli-node-loader.mjs") fixture modulePath (resolve (aref directories index) "declarative-multimethod.mjs")) (js-object))))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (aref reports 0) (js-object "identity" (js-object "multiFn" t "ordinaryFunction" false "forged" false "callable" t "name" "render" "dispatchFunction" "number" "customDefault" "fallback") "dispatch" (js-object "textResult" "text:hello" "numberResult" 42 "fallbackResult" "unknown:9" "dispatchOnly" "text" "calls" 8 "textLookup" t "fallbackLookup" t "hasText" t "hasAbsentThroughDefault" t) "mutation" (js-object "addReturnsIdentity" t "removeReturnsIdentity" t "clearReturnsIdentity" t "initialCount" 0 "populatedCount" 3 "snapshotRetainsText" t "replacementResult" "replacement:hello" "removedFallsBack" "text:hello" "beforeClearCount" 2 "afterClearCount" 0) "valueDispatch" (js-object "compositeResult" "number/2" "customDefaultResult" "default:missing" "nilDefaultResult" "nil:missing" "undefinedDefaultResult" "undefined:missing" "identityMatch" "identity-match" "identityMiss" (js-object "code" "ELI-MULTI-FN-NO-METHOD" "name" "identity" "dispatchValue" (js-object ))) "callbacks" (js-object "dispatchMarkerPreserved" t "methodMarkerPreserved" t "firstSelfReplacement" "first" "secondSelfReplacement" "second") "errors" (js-object "noMethod" (js-object "code" "ELI-MULTI-FN-NO-METHOD" "name" "empty" "dispatchValue" "missing") "invalidDispatch" (js-object "code" "ELI-MULTI-FN-INVALID-DISPATCH" "name" "bad" "dispatchValue" nil) "invalidArity" (js-object "code" "ELI-MULTI-FN-INVALID-ARITY" "name" "bad" "dispatchValue" nil) "invalidMethod" (js-object "code" "ELI-MULTI-FN-INVALID-METHOD" "name" "empty" "dispatchValue" "bad") "invalidReference" (js-object "code" "ELI-MULTI-FN-INVALID-REFERENCE" "name" nil "dispatchValue" nil) "clearedError" (js-object "code" "ELI-MULTI-FN-NO-METHOD" "name" "render" "dispatchValue" "text")) "scale" (js-object "calls" 100000 "total" (- 50000)) "hierarchy" (js-object "identity" t "forged" false "duplicateRetainsIdentity" t "directParentCount" 1 "transitiveAncestorCount" 2 "transitiveDescendantCount" 3 "catIsAnimal" t "vectorIsA" t "oldSnapshotRetainsRelation" t "underiveRemovesTransitiveRelation" t "underiveRetainsDirectRelation" t "diamondRetainsAlternatePath" t "lateAncestorReachesGrandchild" t "lateAncestorDescendantCount" 3 "wideDescendantCount" 10000 "wideLastLeafMatches" t "wideBaseRemainsEmpty" t) "hierarchyErrors" (js-object "invalid" (js-object "code" "ELI-HIERARCHY-INVALID" "child" nil "parent" nil) "self" (js-object "code" "ELI-HIERARCHY-SELF-DERIVATION" "child" "animal" "parent" "animal") "cycle" (js-object "code" "ELI-HIERARCHY-CYCLE" "child" "animal" "parent" "cat")) "hierarchicalDispatch" (js-object "deriveReturnsIdentity" t "mammalResult" "mammal:cat" "specificResult" "mammal:cat" "cacheInvalidatedByRemoval" "animal:cat" "cacheInvalidatedByAddition" "mammal:cat" "exactOverridesAncestor" "exact:cat" "removingExactRestoresAncestor" "mammal:cat" "fallbackResult" "default:mineral" "externalHierarchyIdentity" t "underiveReturnsIdentity" t "underivedFallback" "default:cat") "preferences" (js-object "ambiguous" "ELI-MULTI-FN-AMBIGUOUS-METHOD" "preferReturnsIdentity" t "preferredResult" "mammal:chimera" "directPreference" t "transitivePreference" t "snapshotCount" 2 "removeReturnsIdentity" t "removedIsAmbiguous" "ELI-MULTI-FN-AMBIGUOUS-METHOD" "clearReturnsIdentity" t "clearedCount" 0) "preferenceErrors" (js-object "self" "ELI-MULTI-FN-SELF-PREFERENCE" "conflict" "ELI-MULTI-FN-PREFERENCE-CONFLICT" "invalidHierarchy" "ELI-MULTI-FN-INVALID-HIERARCHY" "hierarchyConflict" "ELI-MULTI-FN-PREFERENCE-CONFLICT" "externalHierarchyConflict" "ELI-MULTI-FN-PREFERENCE-CONFLICT") "hierarchicalScale" (js-object "calls" 100000 "total" 4999950000) "declarations" (js-object "identity" t "text" "text:hello" "number" 42 "fallback" "fallback:other:9"))))
        (let ((sourceMap (JSON/parse (await (readFile (resolve seed "multimethod.eli.map") "utf8")))))
          (js-call (expect (get sourceMap :sourcesContent)) :toHaveLength 1)
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun multi-fn\n")
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun add-method!\n"))
        (let ((declarativeSourceMap (JSON/parse (await (readFile (resolve seed "declarative-multimethod.mjs.map") "utf8")))))
          (contains (aref (get declarativeSourceMap :sourcesContent) 0) "(defmulti render")
          (contains (aref (get declarativeSourceMap :sourcesContent) 0) "(defmethod render \"text\""))
        (let ((hierarchySourceMap (JSON/parse (await (readFile (resolve seed "hierarchy.eli.map") "utf8")))))
          (contains (aref (get hierarchySourceMap :sourcesContent) 0) "(defun derive\n"))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 120000)
)
