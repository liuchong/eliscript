(module tests.stdlib-function
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (defasync build (output json)
    (await (runSuccessful (js-call (js-array BUILD) :concat (if json (js-array "--json") (js-array))
      (js-array "--root" (resolve ROOT "stdlib") "--out-dir" output "--no-cache" (resolve ROOT "stdlib/function.eli"))) (js-object))))
  (test "portable function combinators compile and agree across local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-function-")))) (outputRoot (resolve directory "stdlib")) (usageModule (resolve directory "function-usage.mjs")))
      (try
        (let ((report (JSON/parse (await (build outputRoot t)))))
          (js-call (expect report) :toMatchObject (js-object :format "eliscript-build-report" :version 1 :counts (js-object :modules 2 :compiled 2 :reused 0) :entry "function.eli" :entryOutput "function.mjs")))
        (await (compile (resolve ROOT "tests/fixtures/function-usage.eli") usageModule))
        (let ((hosts (js-array (get globalThis.process :execPath) (get (get globalThis.process :env) :NODE_BINARY "node"))) (index 0))
          (while (< index (js-length hosts))
            (same (JSON/parse (await (runSuccessful (js-array (aref hosts index) usageModule) (js-object)))) (js-object "identity" 7 "constant" "fixed" "complement" t "composition" 14 "partial" 10 "juxt" (js-array 6 4) "fnil" (js-array 10 t 3) "every" t "some" 0 "trampoline" 100000))
            (setq index (1+ index))))
        (let* ((library (await (funcall load-module (str (get (pathToFileURL (resolve outputRoot "function.mjs")) :href) "?direct"))))
               (function_ (lambda (&rest values) (Array/from values))))
          (be (js-call library :comp) (get library :identity))
          (be (js-call library :comp function_) function_)
          (be (js-call library :partial function_) function_)
          (same (funcall (js-call library :fnil function_ 10 20) nil undefined 3) (js-array 10 undefined 3)))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 60000)
  (test "predicate combinators preserve Lisp truth and short-circuit order" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-function-")))) (outputRoot (resolve directory "stdlib")))
      (try
        (await (build outputRoot false))
        (let* ((library (await (funcall load-module (str (get (pathToFileURL (resolve outputRoot "function.mjs")) :href) "?predicates"))))
               (calls (js-array))
               (all (js-call library :every_pred
                 (lambda (value) (js-call calls :push (str "first:" value)) (if (< value 3) 0 false))
                 (lambda (value) (js-call calls :push (str "second:" value)) t))))
          (be (funcall all 1 2 3 4) false) (same calls (js-array "first:1" "first:2" "first:3"))
          (put calls :length 0)
          (let ((any (js-call library :some_fn
            (lambda (value) (js-call calls :push (str "first:" value)) (if (= value 2) "" nil))
            (lambda (value) (js-call calls :push (str "second:" value)) "late"))))
            (be (funcall any 1 2 3) "") (same calls (js-array "first:1" "first:2")))
          (be (funcall (js-call library :every_pred)) t)
          (js-call (expect (funcall (js-call library :some_fn))) :toBeNull))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 60000)
)
