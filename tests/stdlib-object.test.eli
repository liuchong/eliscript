(module tests.stdlib-object
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (test "portable object and data libraries preserve immutable own-property semantics" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-object-"))))
           (objectModule (resolve directory "object.mjs")) (dataModule (resolve directory "data.mjs")) (usage (resolve directory "object-usage.mjs")))
      (try
        (await (runSuccessful (js-array BUILD "--root" (resolve ROOT "stdlib") "--out-dir" directory (resolve ROOT "stdlib/data.eli")) (js-object)))
        (await (compile (resolve ROOT "tests/fixtures/object-usage.eli") usage))
        (same (JSON/parse (await (runSuccessful (js-array "bun" "run" usage) (js-object)))) (js-object "keys" (js-array "name" "count" "ready" "empty") "nil-keys" (js-array ) "has-name" t "has-missing" false "nil-has" false "from-nil" (js-object "created" t) "associated" (js-object "name" "Eliscript" "count" 3 "ready" false "empty" nil) "dissociated" (js-object "count" 2 "ready" false "empty" nil) "dissociated-empty" (js-object ) "merged" (js-object "name" "Eliscript" "count" 7 "ready" false "empty" nil "extra" "new") "merged-empty" (js-object ) "mapped" (js-object "first" 4 "second" 8) "filtered" (js-object "name" "Eliscript" "count" 2 "ready" false) "picked" (js-object "ready" false "name" "Eliscript") "picked-empty" (js-object ) "omitted" (js-object "name" "Eliscript" "ready" false) "updated" (js-object "name" "Eliscript" "count" 7 "ready" false "empty" nil) "indexed" (js-object "intro" (js-object "slug" "intro" "kind" "guide" "order" 3) "compiler" (js-object "slug" "compiler" "kind" "guide" "order" 2)) "grouped" (js-object "note" (js-array (js-object "slug" "intro" "kind" "note" "order" 1)) "guide" (js-array (js-object "slug" "compiler" "kind" "guide" "order" 2) (js-object "slug" "intro" "kind" "guide" "order" 3))) "counted" (js-object "note" 1 "guide" 2) "indexed-empty" (js-object ) "grouped-empty" (js-object ) "counted-empty" (js-object ) "source-unchanged" t "source-has-no-extra" t))
        (let* ((objectLibrary (await (funcall load-module (get (pathToFileURL objectModule) :href)))) (portable (get objectLibrary :__eliscript_portable__))
               (dataLibrary (await (funcall load-module (get (pathToFileURL dataModule) :href)))) (portableData (get dataLibrary :__eliscript_portable__))
               (inherited (Object/create (js-object :inherited 1))))
          (put inherited :own 2)
          (be (js-call portable "has?" inherited "inherited") false) (be (js-call portable "has?" inherited "own") t)
          (same (js-call portable :keys inherited) (js-array "own"))
          (let ((changed (js-call portable :assoc inherited "own" 3)))
            (be (get inherited :own) 2) (be (get changed :own) 3))
          (let ((prototypeGroup (js-call portableData "group-by" (lambda () "__proto__") (js-array 1 2))))
            (be (Object/hasOwn prototypeGroup "__proto__") t) (same (get prototypeGroup :__proto__) (js-array 1 2)))
          (be (get (js-call portableData "count-by" (lambda () "__proto__") (js-array 1 2 3)) :__proto__) 3)
          (let* ((input (js-array (js-object :key "left") (js-object :key "right"))) (inputBefore (JSON/stringify input))
                 (names (js-array "index-by" "group-by" "count-by")) (index 0))
            (while (< index (js-length names))
              (let ((calls (js-array)))
                (js-call portableData (aref names index) (lambda (value) (js-call calls :push (get value :key)) (get value :key)) input)
                (same calls (js-array "left" "right")) (be (JSON/stringify input) inputBefore))
              (setq index (1+ index)))))
        (await (checkMap objectModule (js-array "(defportable assoc")))
        (await (checkMap dataModule (js-array "(import-portable" "(defportable index-by")))
        (finally (await (rm directory (js-object :recursive t :force t)))))))))
