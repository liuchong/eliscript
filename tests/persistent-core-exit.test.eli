(module tests.persistent-core-exit
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "./helpers/portable-stdlib.mjs" projectDirectory runSuccessful be same)
  (defun coalesce (left right) (if (nullish? left) right left))
  (test "persistent collection core closes its all-host million-value exit gate" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-p1-exit-")))))
      (try
        (await (runSuccessful (js-array (resolve projectDirectory "bin/eliscript-build") "--root" (resolve projectDirectory "stdlib") "--out-dir" directory (resolve projectDirectory "stdlib/value.eli")) (js-object)))
        (let ((collections (js-array "vector" "map" "set")) (collectionIndex 0))
          (while (< collectionIndex 3)
            (let ((collection (aref collections collectionIndex)) (reports (js-array))
                  (hosts (js-array (get globalThis.process :execPath) (get (get globalThis.process :env) :NODE "node"))) (hostIndex 0))
              (while (< hostIndex 2)
                (js-call reports :push (JSON/parse (await (runSuccessful (js-array (aref hosts hostIndex) (resolve projectDirectory "tests/fixtures/persistent-core-exit-host.mjs") directory collection) (js-object)))))
                (setq hostIndex (1+ hostIndex)))
              (same (aref reports 1) (aref reports 0))
              (let ((report (aref reports 0)))
                (be (get report :count) 1000000)
                (same (get report :probes) (if (= collection "set") (js-array t t t t t t t) (js-array 0 31 32 1024 32768 500000 999999)))
                (js-call (expect (get report :changedPath)) :toBeLessThanOrEqual 8)
                (be (coalesce (get report :sharedNodes) (get report :sharedItems)) (- (coalesce (get report :nodeCount) (get report :itemCount)) (get report :changedPath)))
                (js-call (expect report) :toMatchObject (cond
                  ((= collection "vector") (js-object "shift" 15 "tailLength" 32 "changedPath" 4 "original" 500000 "updated" (- 1)))
                  ((= collection "map") (js-object "rootKind" "array" "original" 500000 "updated" (- 1) "removedCount" 999999 "removed" "missing" "originalRetained" 750000))
                  (t (js-object "rootKind" "array" "noopConj" t "addedCount" 1000001 "originalCollisionAbsent" t "collisionPresent" t "removedCount" 1000000 "collisionRemoved" t "originalRetained" t))))))
            (setq collectionIndex (1+ collectionIndex))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 180000)
)
