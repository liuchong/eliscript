(module tests.wasm-managed-variadic-calls.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defvar directory nil)
  (defvar backends nil)
  (defvar runtime nil)
  (defvar program nil)
  (defvar reference nil)
  (defvar bytes nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-variadic-"))))
      (setq backends (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime
        (js-call (get backends :compiler) :compile_ir_string
                 (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                 "runtime.eli"))
      (setq program
        (js-call (get backends :compiler) :compile_ir_string
                 (await (readFile "tests/fixtures/wasm-managed-variadic-calls.eli" "utf8"))
                 "variadic.eli"))
      (setq reference
        (await (funcall dyn-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from
                                        (js-call (get backends :compiler) :emit_ir_string program))
                                      :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun make-instance (&rest __host_default_arguments_1)
    (let* ((options (aref __host_default_arguments_1 0)))
    (when (nullish? bytes)
      (setq bytes (Uint8Array/from (js-call (get backends :managed) :emit_managed_wasm program runtime))))
    (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
    (let ((a (instantiateManagedRuntime bytes (if (undefined? options) (js-object) options))))
      (js-call a :auto 1)
      a)))

  (defun decode-value (a x)
    (cond
      ((or (= x nil) (= (funcall js-typeof x) "boolean") (undefined? x)) x)
      ((= (get x :kind) 4) (js-call a :readNumber x))
      ((= (get x :kind) 5) (js-call a :readString x))
      (t
       (js-call assert :equal (get x :kind) 14)
       (let ((res (js-array))
             (len (js-call a :length x))
             (i 0))
         (while (< i len)
           (let ((c (js-call a :get x i)))
             (try
               (js-call res :push (decode-value a c))
               (finally
                 (js-call a :release c))))
           (setq i (+ i 1)))
         res))))

  (defun invoke-result (a name &rest __host_default_arguments_2)
    (let* ((args (aref __host_default_arguments_2 0)))
    (let ((out (js-call a :invoke name (if (undefined? args) (js-array) args))))
      (try
        (decode-value a out)
        (finally
          (js-call a :release out))))))

  (defun finish-heap (a &rest __host_default_arguments_3)
    (let* ((values (aref __host_default_arguments_3 0)))
    (when (not (undefined? values))
      (js-call values :forEach (lambda (x)
        (js-call a :release x))))
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (test "optional and rest exports preserve omitted, undefined, nil and exact IEEE values"
    (lambda ()
      (let ((a (make-instance))
            (cases (js-array (js-array)
                             (js-array undefined)
                             (js-array nil)
                             (js-array false)
                             (js-array 1)
                             (js-array 1 undefined)
                             (js-array 1 nil 2 false undefined)
                             (js-array -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE))))
        (js-call cases :forEach (lambda (xs)
          (let ((args (js-call xs :map (lambda (x) (if (= (funcall js-typeof x) "number") (js-call a :number x) x)))))
            (js-call assert :deepEqual (invoke-result a "mixed" args) (apply (get reference :mixed) xs))
            (js-call args :forEach (lambda (x)
              (js-call a :release x))))))
        (js-call assert :equal (js-call a :invoke "optional-one") nil)
        (js-call assert :equal (js-call a :invoke "optional-one" (js-array undefined)) nil)
        (js-call assert :equal (js-call a :invoke "optional-one" (js-array false)) false)
        (js-call assert :deepEqual (invoke-result a "pack") (js-array))
        (js-call assert :equal (js-call a :invoke "fresh-rest") false)
        (finish-heap a))))

  (test "named and lifted variadic functions retain source call and dynamic function semantics"
    (lambda ()
      (let* ((a (make-instance))
             (f (js-call a :invoke "mixed-value"))
             (one (js-call a :number 1))
             (two (js-call a :number 2)))
        (js-call assert :deepEqual (invoke-result a "source-calls") (js-call reference :source_calls))
        (js-call assert :deepEqual (invoke-result a "call-none" (js-array f))
                 (js-call reference :call_none (js-call reference :mixed_value)))
        (js-call assert :deepEqual (invoke-result a "call-three" (js-array f one undefined two))
                 (js-call reference :call_three (js-call reference :mixed_value) 1 undefined 2))
        (let ((capture (js-call a :invoke "make-capture" (js-array one two)))
              (ref-fn (js-call reference :make_capture 1 2)))
          (js-call (js-array undefined nil two false) :forEach (lambda (x)
            (js-call assert :deepEqual
              (invoke-result a "call-capture" (js-array capture x one))
              (js-call reference :call_capture ref-fn (if (eq x two) 2 x) 1))
            (js-call a :collect)))
          (finish-heap a (js-array f one two capture))))))

  (test "rest arrays are fresh and argument snapshots survive captured writes"
    (lambda ()
      (let* ((a (make-instance))
             (one (js-call a :number 1))
             (items (js-call a :sourceArray (js-array one))))
        (js-call assert :deepEqual (invoke-result a "rest-snapshots" (js-array items))
                 (js-call reference :rest_snapshots (js-array 1)))
        (let ((last (js-call a :get items 0)))
          (js-call assert :equal (js-call a :readNumber last) 99)
          (finish-heap a (js-array one items last))))))

  (test "apply-call is executable on its own and snapshots the callee before its iterable"
    (lambda ()
      (let* ((ir (js-call (get backends :compiler) :compile_ir_string
                          "(defun id (x) x) (defun run (values) (apply id values)) (export run)"
                          "apply-only.eli"))
             (a (instantiateManagedRuntime
                  (Uint8Array/from (js-call (get backends :managed) :emit_managed_wasm ir runtime)))))
        (js-call a :auto 1)
        (let* ((n (js-call a :number -0.0))
               (args (js-call a :sourceArray (js-array n))))
          (funcall assert (Object/is (invoke-result a "run" (js-array args)) -0.0))
          (finish-heap a (js-array n args))))
      (let* ((b (make-instance))
             (items (js-call b :sourceArray (js-array))))
        (js-call assert :equal (invoke-result b "apply-callee-order" (js-array items))
                 (js-call reference :apply_callee_order (js-array)))
        (finish-heap b (js-array items)))))

  (test "apply exhausts arrays, holes and Unicode strings with ordinary spread semantics"
    (lambda ()
      (let* ((a (make-instance))
             (f (js-call a :invoke "pack-value"))
             (raw-str (str "A" (String/fromCharCode 55357 56832 55296) "Z"))
             (text (js-call a :string raw-str))
             (sparse (js-array)))
        (put sparse "length" 4)
        (let ((holes (js-call a :sourceArray sparse)))
          (js-call assert :deepEqual (invoke-result a "apply-values" (js-array f holes))
                   (js-call reference :apply_values (js-call reference :pack_value) sparse))
          (js-call assert :deepEqual (invoke-result a "apply-values" (js-array f text))
                   (js-call reference :apply_values (js-call reference :pack_value) raw-str))
          (js-call (js-array nil undefined) :forEach (lambda (x)
            (js-call assert :deepEqual (invoke-result a "apply-values" (js-array f x))
              (js-call reference :apply_values (js-call reference :pack_value) x))))
          (js-call (js-array false t (js-call a :number 1) (js-call a :sourceObject (js-object))) :forEach (lambda (x)
            (js-call assert :throws
              (lambda () (js-call a :invoke "apply-values" (js-array f x)))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (and (not (nullish? diag))
                       (= (get diag :code) "ELI-RT0003")))))
            (when (and (not (nullish? x)) (= (funcall js-typeof x) "object"))
              (js-call a :release x))))
          (finish-heap a (js-array f text holes))))))

  (test "apply supports owned Set, Map and partially consumed iterators and consumes before noncallable failure"
    (lambda ()
      (let* ((a (make-instance))
             (f (js-call a :invoke "pack-value"))
             (one (js-call a :number 1))
             (two (js-call a :number 2))
             (items (js-call a :sourceArray (js-array one two)))
             (s (js-call a :invoke "as-set" (js-array items)))
             (pair (js-call a :sourceArray (js-array one two)))
             (pairs (js-call a :sourceArray (js-array pair)))
             (m (js-call a :invoke "as-map" (js-array pairs)))
             (iter (js-call a :invoke "values-iterator" (js-array items)))
             (consumed (js-call a :invoke "values-iterator" (js-array items))))
        (js-call assert :deepEqual (invoke-result a "apply-values" (js-array f s)) (js-array 1 2))
        (js-call assert :deepEqual (invoke-result a "apply-values" (js-array f m)) (js-array (js-array 1 2)))
        (js-call assert :equal (js-call a :invoke "iterator-done" (js-array iter)) false)
        (js-call assert :deepEqual (invoke-result a "apply-values" (js-array f iter)) (js-array 2))
        (js-call assert :equal (js-call a :invoke "iterator-done" (js-array iter)) t)
        (js-call assert :throws
          (lambda () (js-call a :invoke "apply-values" (js-array false consumed)))
          (lambda (e)
            (let ((diag (get e :eliscriptDiagnostic)))
              (and (not (nullish? diag))
                   (= (get diag :code) "ELI-RT0003")))))
        (js-call assert :equal (js-call a :invoke "iterator-done" (js-array consumed)) t)
        (finish-heap a (js-array f one two items s pair pairs m iter consumed)))))

  (test "variadic host entry protects arguments before later getters and keeps caller frames on failure"
    (lambda ()
      (let* ((a (make-instance))
             (n (js-call a :number 7))
             (keep (js-call a :number 9))
             (frame (js-call a :frame 1))
             (args (js-array n undefined)))
        (js-call a :frameSet frame 0 keep)
        (Object/defineProperty args 1
          (js-object :get (lambda ()
                            (js-call a :release n)
                            (js-call a :collect)
                            t)))
        (js-call assert :deepEqual (invoke-result a "pack" args) (js-array 7 t))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (let ((marker (js-call a :sourceArray (js-array false)))
              (broken (js-array t)))
          (js-call assert :throws
            (lambda () (js-call a :invoke "first-error" (js-array false marker)))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and (not (nullish? diag))
                     (= (get diag :code) "ELI-RT0003")))))
          (js-call assert :equal (js-call a :get marker 0) false)
          (Object/defineProperty broken 1
            (js-object :get (lambda () (throw (globalThis.Error "variadic getter")))))
          (js-call assert :throws
            (lambda () (js-call a :invoke "pack" broken))
            (new globalThis.RegExp "variadic getter"))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call a :leaveFrame frame)
          (finish-heap a (js-array keep marker))))))

  (test "rest and spread capacity failures release temporary argument lists and preserve existing roots"
    (lambda ()
      (let* ((a (make-instance (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 8192)))
             (n (js-call a :number 7))
             (frame (js-call a :frame 1))
             (failed false)
             (passed false))
        (js-call a :frameSet frame 0 n)
        (js-call (js-array 0 8 64 256 512 1024 2048) :forEach (lambda (cnt)
          (try
            (let ((out (js-call a :invoke "pack" (js-call (globalThis.Array cnt) :fill t))))
              (js-call assert :equal (js-call a :length out) cnt)
              (js-call a :release out)
              (setq passed t))
            (catch e
              (js-call assert :equal (get (get e :eliscriptDiagnostic) :code) "ELI-RT0002")
              (setq failed t)))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call a :collect)
          (let ((saved (js-call a :frameGet frame 0)))
            (js-call assert :equal (js-call a :readNumber saved) 7)
            (js-call a :release saved))))
        (funcall assert (and passed failed))
        (js-call a :leaveFrame frame)
        (finish-heap a (js-array n)))))

  (test "variadic lowering refuses invalid parameter modes, hidden children and malformed apply shapes immutably"
    (lambda ()
      (js-call (js-array
                        (lambda (p) (put (get (aref (get (aref (get p :body) 0) :children) 0) :properties) "parameterKind" "unknown"))
                        (lambda (p) (put (get (aref (get (aref (get p :body) 0) :children) 1) :properties) "parameterKind" "required"))
                        (lambda (p) (put (get (aref (get (aref (get p :body) 0) :children) 0) :properties) "parameterKind" "rest"))
                        (lambda (p) (js-call (get (aref (get (aref (get p :body) 0) :children) 0) :children) :push
                                             (js-object :kind "raw-javascript" :children (js-array) :value "hidden")))) :forEach (lambda (mutate)
        (let ((ir (js-call (get backends :compiler) :compile_ir_string
                           "(defun f (&optional a b) (js-array a b)) (export f)"
                           "bad-variadic.eli")))
          (funcall mutate ir)
          (let ((saved (JSON/stringify ir)))
            (js-call assert :throws
              (lambda () (js-call (get backends :managed) :emit_managed_wasm ir runtime))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (and (not (nullish? diag))
                       (= (get diag :code) "ELI-B0001")))))
            (js-call assert :equal (JSON/stringify ir) saved)))))
      (let* ((ir (js-call (get backends :compiler) :compile_ir_string
                          "(defun f (g values) (apply g values)) (export f)"
                          "bad-apply.eli"))
             (fn-children (get (aref (get ir :body) 0) :children))
             (last-node (js-call fn-children :at -1)))
        (js-call (get last-node :children) :push (js-object :kind "literal" :value 7 :children (js-array)))
        (let ((saved (JSON/stringify ir)))
          (js-call assert :throws
            (lambda () (js-call (get backends :managed) :emit_managed_wasm ir runtime))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and (not (nullish? diag))
                     (= (get diag :code) "ELI-B0001")))))
          (js-call assert :equal (JSON/stringify ir) saved)))))

  (test "argument-list descriptors validate parameter modes and the actual exported ABI"
    (lambda ()
      (let* ((lowered (js-call (get backends :managed) :lower_managed_program program runtime))
             (raw (js-call (get backends :wasm) :emit_typed_memory_wasm (get lowered :typed)))
             (saved (Array/from raw))
             (positive (Uint8Array/from
                         (js-call (get backends :wasm) :append_metadata_section
                                  (Array/from raw)
                                  "eliscript-managed-control"
                                  (JSON/stringify (get lowered :descriptor))))))
        (js-call assert :equal (get (WebAssembly.Module/customSections
                                      (new globalThis.WebAssembly.Module positive)
                                      "eliscript-managed-control") :length)
                 1)
        (finish-heap (instantiateManagedRuntime positive))
        (let ((mixed (js-call (get (get lowered :descriptor) :functions) :find (lambda (f) (= (get f :name) "mixed")))))
          (js-call assert :deepEqual mixed
                   (js-object :name "mixed"
                              :arity nil
                              :callingConvention "argument-list"
                              :parameterKinds (js-array "required" "optional" "rest"))))
        (let ((find-fn (lambda (d name)
                         (js-call (get d :functions) :find (lambda (f) (= (get f :name) name))))))
          (js-call (js-array
                            (lambda (d) (Reflect/deleteProperty (funcall find-fn d "mixed") "parameterKinds"))
                            (lambda (d) (let ((m (funcall find-fn d "mixed")))
                                          (put m "arity" (+ (globalThis.Number (get m :arity)) 1))))
                            (lambda (d) (put (funcall find-fn d "mixed") "callingConvention" "other"))
                            (lambda (d) (Reflect/deleteProperty (funcall find-fn d "mixed") "callingConvention"))
                            (lambda (d) (put (funcall find-fn d "mixed") "parameterKinds" (js-array "required" "rest" "optional")))
                            (lambda (d) (put (funcall find-fn d "mixed") "parameterKinds" (js-array "required" "optional" "unknown")))
                            (lambda (d) (put (funcall find-fn d "mixed") "parameterKinds" (js-array)))
                            (lambda (d) (put (funcall find-fn d "call-none") "arity" 3))) :forEach (lambda (mutate)
            (let ((d (globalThis.structuredClone (get lowered :descriptor))))
              (funcall mutate d)
              (let ((invalid (Uint8Array/from
                               (js-call (get backends :wasm) :append_metadata_section
                                        (Array/from raw)
                                        "eliscript-managed-control"
                                        (JSON/stringify d)))))
                (js-call assert :equal (get (WebAssembly.Module/customSections
                                              (new globalThis.WebAssembly.Module invalid)
                                              "eliscript-managed-control") :length)
                         1
                         "each argument-list mutant needs its own metadata section")
                (js-call assert :throws
                  (lambda () (instantiateManagedRuntime invalid))
                  (lambda (e)
                    (let ((diag (get e :eliscriptDiagnostic)))
                      (and (not (nullish? diag))
                           (= (get diag :code) "ELI-RT0003"))))))))))
        (js-call assert :deepEqual raw saved)
        (let ((a (make-instance)))
          (js-call assert :throws
            (lambda () (js-call a :invoke "call-none"))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and (not (nullish? diag))
                     (= (get diag :code) "ELI-RT0003")))))
          (finish-heap a)))))

  (test "required parameter patterns declare and execute the real argument-list ABI without optional or rest parameters"
    (lambda ()
      (let* ((ir (js-call (get backends :compiler) :compile_ir_string
                          "(defun required-pattern ([value]) value) (export required-pattern)"
                          "required-pattern.eli"))
             (lowered (js-call (get backends :managed) :lower_managed_program ir runtime)))
        (js-call assert :deepEqual (get (get lowered :descriptor) :functions)
                 (js-array (js-object :name "required-pattern"
                                      :arity nil
                                      :callingConvention "argument-list"
                                      :parameterKinds (js-array "required"))))
        (let* ((raw (js-call (get backends :wasm) :emit_typed_memory_wasm (get lowered :typed)))
               (artifact (Uint8Array/from
                           (js-call (get backends :wasm) :append_metadata_section
                                    (Array/from raw)
                                    "eliscript-managed-control"
                                    (JSON/stringify (get lowered :descriptor)))))
               (a (instantiateManagedRuntime artifact)))
          (js-call a :auto 1)
          (let* ((zero (js-call a :number -0.0))
                 (input (js-call a :sourceArray (js-array zero))))
            (try
              (let ((output (js-call a :invoke "required-pattern" (js-array input))))
                (try
                  (funcall assert (Object/is (js-call a :readNumber output) -0.0))
                  (finally
                    (js-call a :release output))))
              (finally
                (js-call a :release input)
                (js-call a :release zero)
                (js-call a :closeModule)
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))))

  (defun raw-heap ()
    (let ((ir (globalThis.structuredClone runtime)))
      (js-call (get ir :body) :push
               (js-object
                 :kind "export-declaration"
                 :value nil
                 :children (js-call (js-array "value-call-arguments-check" "value-call-rest" "value-call-expand")
                                    :map (lambda (v) (js-object :kind "reference" :value v :children (js-array))))))
      (let ((raw (Uint8Array/from (js-call (get backends :wasm) :emit_memory_wasm ir))))
        (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module raw)) (js-array))
        (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module raw)) :exports))
               (heap (funcall (aref e "heap-new") 128 4096 32768))
               (call-fn (lambda (name &rest args)
                          (let ((res (unsigned-bit-shift-right (apply (aref e name) (js-call (js-array heap) :concat args)) 0)))
                            (js-call assert :equal (funcall (aref e "last-error")) 0 name)
                            res))))
          (funcall call-fn "heap-auto" 1)
          (js-object :e e :heap heap :call call-fn)))))

  (test "raw argument helpers borrow unrooted inputs and preserve exact tail bits through GC"
    (lambda ()
      (let* ((ctx (raw-heap))
             (e (get ctx :e))
             (call-fn (get ctx :call))
             (args (funcall call-fn "value-refs" 7 5))
             (patterns (js-array (js-array 0 2147483648)
                                 (js-array 1 0)
                                 (js-array 2882400001 2146959360)
                                 (js-array 0 2146435072)
                                 (js-array 4294967295 2146435071)))
             (i 0))
        (funcall call-fn "heap-pin" args)
        (while (< i (get patterns :length))
          (let* ((pat (aref patterns i))
                 (n (funcall call-fn "value-number" (aref pat 0) (aref pat 1))))
            (funcall call-fn "value-set" args i n))
          (setq i (+ i 1)))
        (funcall call-fn "heap-release" args)
        (let ((tail (funcall call-fn "value-call-rest" args 1 5)))
          (funcall call-fn "heap-pin" tail)
          (setq i 0)
          (while (< i 60)
            (funcall call-fn "value-number" i 0)
            (setq i (+ i 1)))
          (funcall call-fn "heap-collect")
          (js-call assert :equal (funcall call-fn "value-length" tail) 4)
          (setq i 0)
          (while (< i 4)
            (let* ((child (funcall call-fn "value-get" tail i))
                   (offset (funcall call-fn "value-data" child 4))
                   (view (new globalThis.DataView (get (get e :memory) :buffer))))
              (js-call assert :deepEqual
                (js-array (js-call view :getUint32 offset t)
                          (js-call view :getUint32 (+ offset 4) t))
                (aref patterns (+ i 1))))
            (setq i (+ i 1)))
          (funcall call-fn "heap-release" tail)
          (funcall call-fn "heap-collect")
          (js-call assert :equal (funcall call-fn "heap-live") 0)
          (js-call assert :equal (funcall call-fn "frame-depth") 0)))))

  (test "raw spread growth fills holes and rejects malformed argument words or counts"
    (lambda ()
      (let* ((ctx (raw-heap))
             (e (get ctx :e))
             (heap (get ctx :heap))
             (call-fn (get ctx :call))
             (items (funcall call-fn "value-array-new" 513))
             (i 0))
        (funcall call-fn "heap-pin" items)
        (while (< i 513)
          (funcall call-fn "value-set" items i 2)
          (setq i (+ i 3)))
        (let ((expanded (funcall call-fn "value-call-expand" items)))
          (funcall call-fn "heap-pin" expanded)
          (js-call assert :equal (funcall call-fn "value-length" expanded) 513)
          (setq i 0)
          (while (< i 513)
            (js-call assert :equal (funcall call-fn "value-get" expanded i)
                     (if (= (% i 3) 0) 2 3))
            (setq i (+ i 1)))
          (js-call assert :equal (funcall call-fn "value-call-arguments-check" expanded 513) 1)
          (funcall (aref e "value-call-arguments-check") heap expanded 512)
          (js-call assert :equal (funcall (aref e "last-error")) 3)
          (let ((data (funcall call-fn "value-data" expanded 7)))
            (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setUint32 (+ data 4) 4 t))
          (funcall (aref e "value-call-arguments-check") heap expanded 513)
          (js-call assert :equal (funcall (aref e "last-error")) 1)
          (funcall call-fn "heap-release" expanded)
          (funcall call-fn "heap-release" items)
          (funcall call-fn "heap-collect")
          (js-call assert :equal (funcall call-fn "heap-live") 0)
          (js-call assert :equal (funcall call-fn "frame-depth") 0)))))

  (test "a real trap in rest allocation or spread expansion unwinds host and source callers"
    (async ()
      (let ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8"))))
        (js-call (js-array (js-array "value-call-rest" "heap arguments start count" "pack" (js-array t))
                                (js-array "value-call-expand" "heap input" "apply-values" (js-array false undefined))) :forEach (lambda (spec)
          (let* ((helper (aref spec 0))
                 (signature (aref spec 1))
                 (entry (aref spec 2))
                 (args (aref spec 3))
                 (start (js-call source :indexOf (str "  (defun " helper " (")))
                 (end (js-call source :indexOf "  (defun " (+ start 10))))
            (funcall assert (and (>= start 0) (> end start)))
            (let* ((faulty (str (js-call source :slice 0 start)
                                "  (defun " helper " (" signature ") (load-u32 4294967295))\n"
                                (js-call source :slice end)))
                   (ir (js-call (get backends :compiler) :compile_ir_string faulty "trap-arguments.eli"))
                   (a (instantiateManagedRuntime
                        (Uint8Array/from (js-call (get backends :managed) :emit_managed_wasm program ir)))))
              (js-call a :auto 1)
              (let* ((n (js-call a :number 7))
                     (frame (js-call a :frame 1))
                     (spread (if (= helper "value-call-expand") (js-call a :sourceArray (js-array)) undefined))
                     (actual-args (if (undefined? spread) args (js-array false spread))))
                (js-call a :frameSet frame 0 n)
                (js-call assert :throws
                  (lambda () (js-call a :invoke entry actual-args))
                  globalThis.WebAssembly.RuntimeError)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                (let ((saved (js-call a :frameGet frame 0)))
                  (js-call assert :equal (js-call a :readNumber saved) 7)
                  (js-call a :release saved))
                (js-call a :leaveFrame frame)
                (unless (undefined? spread) (js-call a :release spread))
                (finish-heap a (js-array n))))))))))

  (test "generated argument shapes match an independent optional and rest model with exact Number bits"
    (lambda ()
      (let* ((a (make-instance))
             (f (js-call a :invoke "mixed-value"))
             (seed 523545729)
             (random (lambda ()
                       (setq seed (unsigned-bit-shift-right (+ (Math/imul seed 1664525) 1013904223) 0))
                       seed))
             (i 0))
        (while (< i 96)
          (let ((cnt (% (funcall random) 13))
                (values (js-array))
                (args (js-array))
                (j 0))
            (while (< j cnt)
              (let ((tag (% (funcall random) 7))
                    (x undefined))
                (cond
                  ((= tag 0) (setq x undefined))
                  ((= tag 1) (setq x nil))
                  ((= tag 2) (setq x false))
                  (t
                   (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
                     (js-call bits :setUint32 0 (funcall random) t)
                     (js-call bits :setUint32 4 (funcall random) t)
                     (setq x (js-call bits :getFloat64 0 t)))))
                (js-call values :push x)
                (js-call args :push (if (= (funcall js-typeof x) "number") (js-call a :number x) x)))
              (setq j (+ j 1)))
            (let* ((exp (js-array (aref values 0)
                                  (if (undefined? (aref values 1)) nil (aref values 1))
                                  (js-call values :slice 2)))
                   (lst (js-call a :sourceArray args)))
              (js-call assert :deepEqual (invoke-result a "mixed" args) exp)
              (js-call assert :deepEqual (invoke-result a "apply-values" (js-array f lst)) exp)
              (js-call a :release lst)
              (js-call args :forEach (lambda (x)
                (js-call a :release x)))
              (js-call a :collect)))
          (setq i (+ i 1)))
        (finish-heap a (js-array f)))))

  (test "large argument lists preserve every operand while required-only public ABI stays exact"
    (lambda ()
      (let ((a (make-instance)))
        (js-call (js-array 127 128 255 256 1025) :forEach (lambda (cnt)
          (let ((out (js-call a :invoke "pack" (js-call (globalThis.Array cnt) :fill t)))
                (i 0))
            (js-call assert :equal (js-call a :length out) cnt)
            (while (< i cnt)
              (js-call assert :equal (js-call a :get out i) t)
              (setq i (+ i 1)))
            (js-call a :release out)
            (js-call a :collect))))
        (js-call assert :equal (js-call a :invoke "optional-one" (js-call (globalThis.Array 1025) :fill false)) false)
        (js-call assert :throws
          (lambda () (js-call a :invoke "call-none" (js-array)))
          (lambda (e)
            (let ((diag (get e :eliscriptDiagnostic)))
              (and (not (nullish? diag))
                   (= (get diag :code) "ELI-RT0003")))))
        (finish-heap a))))

  (test "Node executes the same variadic and iterable artifact against standalone generated JavaScript"
    (async ()
      (let ((artifact (resolve directory "variadic.wasm"))
            (js-path (resolve directory "reference.mjs"))
            (runner (resolve "tests/helpers/wasm-managed-variadic-calls-node.mjs")))
        (await (writeFile artifact (Uint8Array/from (js-call (get backends :managed) :emit_managed_wasm program runtime))))
        (await (writeFile js-path (js-call (get backends :compiler) :emit_ir_string program)))
        (let ((res (spawnSync "node"
                              (js-array runner artifact (get (pathToFileURL js-path) :href))
                              (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get res :status) 0 (get res :stderr))
          (js-call assert :match (get res :stdout) (new globalThis.RegExp "independent Node variadic source semantics passed")))))))
