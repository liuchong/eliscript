(module tests.linter-parity.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" join resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../bootstrap/host/project.mjs" checkProject)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)

  (defconst dynamicImport (js* "(specifier) => import(specifier)"))
  (defconst root (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst bootstrapPath (resolve root "bin/eliscript-bootstrap"))
  (defconst checkPath (resolve root "bin/eliscript-check"))
  (defconst bunBin (get globalThis.process :execPath))
  (defconst emacsBin (let ((v (get (get globalThis.process :env) :EMACS))) (if (nullish? v) "emacs" v)))
  (defconst nodeBin (let ((v (get (get globalThis.process :env) :NODE))) (if (nullish? v) "node" v)))

  (defvar workDir undefined)
  (defvar compilerDir undefined)
  (defvar compiler undefined)

  (defasync runCmd (cmd &rest __opt)
    (let* ((opts (if (undefined? (aref __opt 0)) (js-object) (aref __opt 0)))
           (child (Bun/spawn cmd (js-object :cwd (if (get opts :cwd) (get opts :cwd) root)
                                   :stdin (if (undefined? (get opts :stdin)) "ignore" "pipe")
                                   :stdout "pipe" :stderr "pipe"
                                   :env (if (get opts :env) (get opts :env) (get globalThis.process :env))))))
      (when (not (undefined? (get opts :stdin)))
        (js-call (get child :stdin) :write (get opts :stdin))
        (js-call (get child :stdin) :end))
      (let ((parts (await (Promise/all (js-array (get child :exited)
                                         (js-call (new globalThis.Response (get child :stdout)) :text)
                                         (js-call (new globalThis.Response (get child :stderr)) :text))))))
        (js-object :exitCode (aref parts 0) :stdout (aref parts 1) :stderr (aref parts 2)))))

  (defun runtimeEnv (rt)
    (copyHostRecord (get globalThis.process :env)
      (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDir :ELISCRIPT_JS_RUNTIME rt)))

  (defasync seedLintBatch (cases)
    (let ((inputFile (join workDir "seed-lint-cases.json")))
      (await (writeFile inputFile (JSON/stringify cases) "utf8"))
      (let* ((elisp "(progn
  (require 'json)
  (require 'eliscript)
  (let* ((raw (with-temp-buffer
                (insert-file-contents (getenv \"ELISCRIPT_LINT_CASES\"))
                (buffer-string)))
         (cases (json-parse-string raw :object-type 'alist :array-type 'list :null-object nil :false-object nil))
         (results
          (mapcar
           (lambda (item)
             (let* ((src (alist-get 'source item))
                    (file (alist-get 'filename item))
                    (opts (alist-get 'options item))
                    (diags (eliscript-lint-string src file opts)))
               (apply #'vector (mapcar #'eliscript-diagnostic-to-alist diags))))
           cases)))
    (princ (json-encode (apply #'vector results)))))")
             (res (await (runCmd (js-array emacsBin "--batch" "-Q" "-L" (resolve root "compiler") "--eval" elisp)
                           (js-object :env (copyHostRecord (get globalThis.process :env)
                                             (js-object :LC_ALL "C" :LANG "C" :ELISCRIPT_LINT_CASES inputFile)))))))
        (when (/= (get res :exitCode) 0)
          (throw (new globalThis.Error (str "emacs seedLintBatch exited " (get res :exitCode) ": " (get res :stderr)))))
        (js-call (expect (get res :stderr)) :toBe "")
        (JSON/parse (get res :stdout)))))

  (defun normalizeDiag (diag)
    (js-object
      :code (get diag :code)
      :severity (get diag :severity)
      :phase (get diag :phase)
      :message (get diag :message)
      :file (get (get diag :location) :file)
      :startLine (get (get (get diag :location) :start) :line)
      :startColumn (get (get (get diag :location) :start) :column)))

  (beforeAll (async ()
    (setq workDir (await (mkdtemp (join (tmpdir) "eliscript-linter-test-"))))
    (setq compilerDir (resolve workDir "compiler"))
    (let ((built (await (runCmd (js-array bootstrapPath)
                          (js-object :env (copyHostRecord (get globalThis.process :env)
                                            (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDir)))))))
      (js-call (expect (get built :exitCode)) :toBe 0))
    (setq compiler (await (funcall dynamicImport (str (get (pathToFileURL (resolve compilerDir "compiler.mjs")) :href) "?linter"))))) 30000)

  (afterAll (async ()
    (when workDir
      (await (rm workDir (js-object :recursive t :force t))))))

  (test "Seed and Self-hosted linters emit identical ELI-L0001..L0009 diagnostics and honor CLI flags"
    (async ()
      (let* ((cases (js-array
                      (js-object :filename "l0001.eli" :source "(module l1 (defun f (x) (let ((unused 1) (_ok 2)) x)) (export f))")
                      (js-object :filename "l0002.eli" :source "(module l2 (import \"./dep.mjs\" usedVal unusedVal _ignoredImp) (defun f () usedVal) (export f))")
                      (js-object :filename "l0003.eli" :source "(module l3 (defun f (x) (let ((x 2)) x)) (export f))")
                      (js-object :filename "l0004.eli" :source "(module l4 (defun pair (a b) (+ a b)) (defun bad () (pair 1)) (export pair bad))")
                      (js-object :filename "l0005.eli" :source "(module l5 (defun f () (if t 1 2)) (export f))")
                      (js-object :filename "l0006.eli" :source "(module l6 (defun f (x) (setq x 10) x) (export f))")
                      (js-object :filename "l0007.eli" :source "(module l7 (defconst m {:a 1 :a 2}) (defconst s #{1 1}) (export m s))")
                      (js-object :filename "l0008.eli" :source "(module l8 (defun f () (progn) (progn 42 99)) (export f))")
                      (js-object :filename "l0009.eli" :source "(module l9 (import \"./t.mjs\" transient conj! persistent!) (defun leak () (let ((t1 (transient []))) t1)) (defun good () (let ((t2 (transient []))) (persistent! (conj! t2 1)))) (export leak good))")))
             (seedResults (await (seedLintBatch cases)))
             (expectedCodes (js-array "ELI-L0001" "ELI-L0002" "ELI-L0003" "ELI-L0004" "ELI-L0005" "ELI-L0006" "ELI-L0007" "ELI-L0008" "ELI-L0009"))
             (idx 0))
        (while (< idx (js-length cases))
          (let* ((entry (aref cases idx))
                 (selfDiags (js-call compiler :lint_string (get entry :source) (get entry :filename)))
                 (seedDiags (aref seedResults idx))
                 (normSelf (js-call selfDiags :map normalizeDiag))
                 (normSeed (js-call seedDiags :map normalizeDiag)))
            (js-call (expect normSelf) :toEqual normSeed)
            (let ((codes (js-call normSelf :map (lambda (d) (get d :code)))))
              (js-call (expect codes) :toContain (aref expectedCodes idx))))
          (setq idx (1+ idx)))

        ;; Verify _-prefixed names never emit L0001/L0002 and options.rules controls severity
        (let* ((cleanSrc "(module suppressed (import \"./d.mjs\" _skipImp) (defun f (_unused) (let ((_tmp 1)) 10)) (export f))")
               (cleanSelf (js-call compiler :lint_string cleanSrc "suppressed.eli"))
               (cleanSeed (aref (await (seedLintBatch (js-array (js-object :filename "suppressed.eli" :source cleanSrc)))) 0)))
          (js-call (expect cleanSelf) :toEqual (js-array))
          (js-call (expect cleanSeed) :toEqual (js-array)))

        (let* ((ruleSrc "(module cfg (defun f (x) (if t x 0)) (export f))")
               (opts (js-object :rules (js-object "ELI-L0005" "error" "ELI-L0001" "off")))
               (selfOffErr (js-call compiler :lint_string ruleSrc "cfg.eli" opts))
               (seedOffErr (aref (await (seedLintBatch (js-array (js-object :filename "cfg.eli" :source ruleSrc :options opts)))) 0)))
          (js-call (expect (js-call selfOffErr :map normalizeDiag)) :toEqual (js-call seedOffErr :map normalizeDiag))
          (js-call (expect (js-length selfOffErr)) :toBe 1)
          (js-call (expect (get (aref selfOffErr 0) :code)) :toBe "ELI-L0005")
          (js-call (expect (get (aref selfOffErr 0) :severity)) :toBe "error"))

        ;; Verify CLI --lint vs --strict on real project config in Bun and Node
        (let* ((projDir (resolve workDir "proj"))
               (srcDir (resolve projDir "src"))
               (entryFile (resolve srcDir "main.eli"))
               (cfgFile (resolve projDir "eliscript.json")))
          (await (mkdir srcDir (js-object :recursive t)))
          (await (writeFile entryFile "(module proj.main\n  (defun demo (x) (let ((unused 1)) x))\n  (export demo))\n" "utf8"))
          (await (writeFile cfgFile (JSON/stringify (js-object :sourceRoot "src" :entries (js-array "main.eli") :outDir "dist")) "utf8"))
          (let ((plainCheck (await (checkProject (js-object :entries (js-array entryFile) :root projDir :moduleDirectory compilerDir :compiler compiler)))))
            (js-call (expect (get plainCheck :diagnostics)) :toBe undefined))
          (let ((lintCheck (await (checkProject (js-object :entries (js-array entryFile) :root projDir :moduleDirectory compilerDir :compiler compiler :lint t)))))
            (js-call (expect (js-length (get lintCheck :diagnostics))) :toBeGreaterThanOrEqual 1)
            (js-call (expect (get (aref (get lintCheck :diagnostics) 0) :code)) :toBe "ELI-L0001"))

          (let ((bunLint (await (runCmd (js-array checkPath "--config" cfgFile "--lint" "--diagnostic-format" "json")
                                  (js-object :env (runtimeEnv "bun")))))
                (nodeLint (await (runCmd (js-array checkPath "--config" cfgFile "--lint" "--diagnostic-format" "json")
                                   (js-object :env (runtimeEnv "node")))))
                (strictRes (await (runCmd (js-array checkPath "--config" cfgFile "--strict" "--json")
                                    (js-object :env (runtimeEnv "bun"))))))
            (js-call (expect (get bunLint :exitCode)) :toBe 0)
            (js-call (expect (get bunLint :stdout)) :toBe (get nodeLint :stdout))
            (let ((parsed (JSON/parse (get bunLint :stdout))))
              (js-call (expect (aref parsed 0)) :toMatchObject (js-object :code "ELI-L0001" :severity "warning" :phase "lint")))
            (js-call (expect (get strictRes :exitCode)) :toBe 1)
            (let ((strictReport (JSON/parse (get strictRes :stdout))))
              (js-call (expect (get (aref (get strictReport :diagnostics) 0) :code)) :toBe "ELI-L0001")))))))
)
