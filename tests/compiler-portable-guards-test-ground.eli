(module tests.compiler-portable-guards-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst call-bridge (js* "(implementation) => function(...args) { return implementation(this, args); }"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst original (lambda (operation onError) (try (funcall operation) (catch error (funcall onError (get error :message))))))
  (defun flatten (nodes) (js-call nodes :flatMap (lambda (node) (if (= (get node :kind) "module-declaration") (flatten (get node :children)) (js-array node)))))
  (defvar directory undefined) (defvar backend undefined) (defvar runtime undefined)
  (defconst programs (js-array))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-portable-guards-"))) backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (let ((files (js-array "analyzer" "expander")) (index 0))
      (while (< index 2)
        (let* ((file (aref files index)) (ir (js-call (get backend :compiler) :compile_ir_string (await (readFile (str "bootstrap/compiler/" file ".eli") "utf8")) (str file ".eli")))
               (helper (js-call (flatten (get ir :body)) :find (lambda (node) (and (= (get node :kind) "variable-declaration") (= (get node :value) "guard"))))))
          (funcall assert helper)
          (let* ((support (flatten (get (js-call (get backend :compiler) :compile_ir_string "\n      (defconst guard nil)\n      (defun guard-value (value) (lambda () value))\n      (defun guard-throw (value) (lambda () (throw value)))\n      (defun guard-handler (trace answer throws)\n        (lambda (message) (js-call trace :push message) (if throws (throw answer) answer)))\n      (export guard guard-value guard-throw guard-handler)" "guard-adapter.eli") :body)))
                 (program (copyHostRecord ir (js-object :body (js-call (js-array (globalThis/structuredClone helper)) :concat (js-call support :filter (lambda (node) (not (= (get node :value) "guard"))))))))
                 (reference (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program)) :toString "base64"))))))
            (js-call programs :push (js-object :file file :program program :reference reference))))
        (setq index (1+ index))))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (test "compiler guards retain arrow identity, call this, exact values and synchronous return behavior" (async ()
    (let ((index 0))
      (while (< index (js-length programs))
        (let ((guard (get (get (aref programs index) :reference) :guard)))
          (js-call assert :equal (get guard :length) 2) (js-call assert :equal (Object/hasOwn guard "prototype") false)
          (js-call assert :throws (lambda () (Reflect/construct globalThis.String (js-array) guard)) globalThis.TypeError)
          (js-call (js-array undefined nil false t (js* "-0") globalThis.NaN "" (js-object) (js-array) (funcall globalThis.Symbol "value")) :forEach (lambda (value)
            (let ((calls 0))
              (funcall assert (Object/is (funcall guard
                (funcall call-bridge (lambda (receiver args) (js-call assert :equal receiver undefined) (setq calls (1+ calls)) value))
                (lambda () (js-call assert :fail "handler must not run"))) value)) (js-call assert :equal calls 1))))
          (let ((promise (Promise/resolve "value"))) (js-call assert :equal (funcall guard (lambda () promise) (lambda () (js-call assert :fail))) promise))
          (let* ((rejection (js-object)) (pending (Promise/reject rejection)))
            (js-call assert :equal (funcall guard (lambda () pending) (lambda () (js-call assert :fail "async rejection stays asynchronous"))) pending)
            (await (js-call assert :rejects pending (lambda (error) (= error rejection))))))
        (setq index (1+ index))))))
  (defun observe (guard mode)
    (let ((trace (js-array)) (sentinel (js-object)) (answer (js-object)) (error (js-object)) (result undefined) (thrown undefined))
      (Object/defineProperty error "message" (js-object :enumerable t :configurable t :get (lambda () (js-call trace :push "message") (when (= mode "getter") (throw sentinel)) answer)))
      (try (setq result (funcall guard
        (funcall call-bridge (lambda (receiver args) (js-call trace :push "operation") (js-call assert :equal receiver undefined) (throw error)))
        (funcall call-bridge (lambda (receiver args) (js-call trace :push "handler") (js-call assert :equal receiver undefined) (js-call assert :equal (aref args 0) answer) (when (= mode "handler") (throw sentinel)) answer))))
        (catch value (setq thrown (if (= value sentinel) "sentinel" "unexpected"))))
      (js-object :trace trace :returnedAnswer (= result answer) :thrown thrown)))
  (test "compiler guards preserve one message read and do not recatch handler or getter failures" (lambda ()
    (js-call programs :forEach (lambda (item)
      (let ((guard (get (get item :reference) :guard)))
        (js-call (js-array "normal" "getter" "handler") :forEach (lambda (mode) (js-call assert :deepEqual (observe guard mode) (observe original mode))))
        (js-call (js-array nil undefined) :forEach (lambda (value) (js-call assert :throws (lambda () (funcall guard (lambda () (throw value)) (lambda () (js-call assert :fail)))) globalThis.TypeError)))
        (js-call (js-array false t 3 "" (funcall globalThis.Symbol "x")) :forEach (lambda (value) (js-call assert :equal (funcall guard (lambda () (throw value)) (lambda (message) message)) undefined))))))))
  (test "compiler guards catch source exceptions inside zero-import WASM while preserving returned and thrown identity" (lambda ()
    (js-call programs :forEach (lambda (item)
      (let* ((file (get item :file)) (program (get item :program)) (saved (JSON/stringify program)) (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
        (js-call assert :equal (JSON/stringify program) saved)
        (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (let ((a (instantiateManagedRuntime bytes)))
          (js-call a :auto 1)
          (let* ((trace (js-call a :sourceArray (js-array))) (answer (js-call a :sourceObject (js-object))) (message (js-call a :string "text")) (error (js-call a :sourceObject (js-object :message message)))
                 (returns (js-call a :invoke "guard-value" (js-array answer))) (throws (js-call a :invoke "guard-throw" (js-array error))) (handles (js-array trace answer message error returns throws)))
            (js-call (js-array false t) :forEach (lambda (throwsAgain)
              (let* ((handler (js-call a :invoke "guard-handler" (js-array trace answer throwsAgain))) (normal undefined) (result undefined))
                (js-call handles :push handler) (setq normal (js-call a :invoke "guard" (js-array returns handler))) (js-call handles :push normal)
                (funcall assert (js-call a :keyEqual normal answer)) (js-call assert :equal (js-call a :length trace) (if throwsAgain 1 0) file)
                (try (setq result (js-call a :invoke "guard" (js-array throws handler))) (js-call assert :equal throwsAgain false)
                  (catch value (js-call assert :equal throwsAgain t) (setq result value)))
                (js-call handles :push result) (funcall assert (js-call a :keyEqual result answer))
                (let ((recorded (js-call a :get trace (if throwsAgain 1 0)))) (js-call handles :push recorded) (funcall assert (js-call a :keyEqual recorded message)))
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
            (js-call handles :forEach (lambda (value) (js-call a :release value))) (js-call a :closeModule) (js-call a :collect) (js-call assert :equal (js-call a :live) 0 file))))))))
)
