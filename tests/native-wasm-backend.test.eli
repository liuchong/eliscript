(module tests.native-wasm-backend.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:child_process" spawnSync)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "../tools/experiments/native-wasm/emit-c.mjs" emitNumericC)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst root (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defvar directory undefined) (defvar compiler undefined)
  (defun run (command args &rest __host_default_arguments_1)
    (let* ((extra (aref __host_default_arguments_1 0)))
    (let ((result (spawnSync command args (copyHostRecord (js-object :cwd root :encoding "utf8" :timeout 120000) (if (= extra undefined) (js-object) extra)))))
      (js-call assert :equal (get result :status) 0 (funcall globalThis.String (let ((error (get result :error))) (if (nullish? error) (get result :stderr) error))))
      (get result :stdout))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-numeric-backend-test-"))))
    (run (resolve root "bin/eliscript-bootstrap") (js-array) (js-object :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory))))
    (setq compiler (await (funcall load-module (get (pathToFileURL (resolve directory "compiler.mjs")) :href))))) 120000)
  (afterAll (async () (unless (nullish? directory) (await (rm directory (js-object :recursive t :force t))))))
  (test "numeric IR backend preserves binding, assignment, branch, and IEEE f64 behavior" (async ()
    (let* ((source "\n    (defun shadow (x) (let ((x 2) (y x)) (+ x y)))\n    (defun sequential (x) (let* ((x 2) (y x)) (+ x y)))\n    (defun assignment (x) (let ((a x) (b 3)) (setq a (+ a b) b (* a b)) (+ a b)))\n    (defun bounded (x) (let ((i 0) (sum x)) (while (< i 20) (setq sum (/ (+ sum i) 2) i (1+ i))) sum))\n    (defun signed-zero (x) (* x 0))\n    (defun division (x) (/ x 0))\n    (defun branch (x) (if (< x 0) (- 0 x) x))\n    (defun large-constant (x) (+ x 100000000000000000000))\n    (export shadow sequential assignment bounded signed-zero division branch large-constant)") (ir (js-call compiler :compile_ir_string source "numeric-test.eli")) (emitted (emitNumericC ir))
           (code (get emitted :code)) (functions (get emitted :functions)))
      (await (writeFile (resolve directory "test.c") code))
      (await (writeFile (resolve directory "compiled-numeric.mjs") (js-call compiler :compile_string source "numeric-test.eli")))
      (let ((zig (get (get globalThis.process :env) :ZIG)))
        (run (if (nullish? zig) "zig" zig)
          (js-call (js-array "cc" "-target" "wasm32-freestanding" "-O3" "-ffp-contract=off" "-fno-fast-math" "-nostdlib" "-Wl,--no-entry")
            :concat (js-call functions :map (lambda (fn) (str "-Wl,--export=" (get fn :symbol))))
              (js-array (resolve directory "test.c") "-o" (resolve directory "test.wasm")))))
      (let* ((wasm (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (await (readFile (resolve directory "test.wasm"))))))
             (compiledPath (resolve directory "compiled-numeric.mjs")) (node (get (get globalThis.process :env) :NODE))
             (oracle (JSON/parse (run (if (nullish? node) "node" node)
               (js-array "tests/fixtures/numeric-c-oracle-host.mjs" (get (pathToFileURL compiledPath) :href)))))
             (values (js-array (- globalThis.Infinity) -7 (js* "-0") 0 0.123 9 globalThis.Infinity globalThis.NaN)))
        (js-call functions :forEach (lambda (fn)
          (js-call values :forEach (lambda (value index)
            (let* ((result (Reflect/apply (get (get wasm :exports) (get fn :symbol)) (get wasm :exports) (js-array value)))
                   (encoded (if (Object/is result (js* "-0")) "-0" (funcall globalThis.String result))))
              (js-call assert :equal encoded (aref (get oracle (js-call (get fn :name) :replaceAll "-" "_")) index) (str (get fn :name) "(" (funcall globalThis.String value) ")")))))))
        (js-call assert :equal (Reflect/apply (get (get wasm :exports) (get (aref functions 0) :symbol)) (get wasm :exports) (js-array 9)) 11)
        (js-call assert :equal (Reflect/apply (get (get wasm :exports) (get (aref functions 1) :symbol)) (get wasm :exports) (js-array 9)) 4)))))
  (test "probe rejects unsupported language features and unsafe scalar assumptions" (lambda ()
    (js-call (js-array "(defun f (x) \"text\")" "(defun f (x) [x])" "(defun f (x) (js* \"x\"))" "(defun f (x) (lambda (y) y))" "(defun f (x) (g x))" "(defun f (x) missing)" "(defasync f (x) x)" "(defun f (&optional x) x)" "(defun f (x) (if 0 x x))" "(defun f (x) (while 0 (setq x 1)) x)" "(defun f (x) (let ((a t)) (setq a x) x))" "(defun f (x) (+ x x x))" "(import \"host\" g) (defun f (x) x)" "(defun f (x) (= x 1))") :forEach (lambda (source) (js-call assert :throws (lambda () (emitNumericC (js-call compiler :compile_ir_string source "rejected.eli"))) undefined source)))))
)
