(module tests.stdlib-diff-pprint
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp rm symlink)
  (import "node:path" resolve)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../runtime/core/list.mjs" persistentList)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" withMeta)
  (import "../runtime/core/queue.mjs" persistentQueue)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/value.mjs" equalValues)
  (import "../runtime/core/vector.mjs" persistentVector)

  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst EMACS (let ((v (get (get process :env) :EMACS))) (if (nullish? v) "emacs" v)))
  (defconst dynamic-import (js* "(url) => import(url)"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))

  (defasync compile-stdlib (modules)
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-s3-diff-pprint-"))))
           (out-root (resolve directory "stdlib")))
      (try
        (await (symlink (resolve ROOT "runtime") (resolve directory "runtime") "dir"))
        (let* ((cmd (js-call (js-array (resolve ROOT "bin/eliscript-build") "--json" "--root" (resolve ROOT "stdlib") "--out-dir" out-root "--no-cache")
                      :concat (js-call modules :map (lambda (m) (resolve ROOT (str "stdlib/" m ".eli"))))))
               (child (Bun/spawn cmd (js-object :cwd ROOT :env (Object/assign (js-object) (get process :env) (js-object :EMACS EMACS)) :stdout "pipe" :stderr "pipe")))
               (res (await (Promise/all (js-array (get child :exited)
                                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                                  (js-call (new globalThis.Response (get child :stderr)) :text))))))
          (unless (= (aref res 0) 0)
            (throw (new globalThis.Error (str "build failed: " (aref res 2) "\n" (aref res 1))))))
        (let ((loaded (js-object))
              (idx 0))
          (while (< idx (js-length modules))
            (let* ((m (aref modules idx))
                   (ns (await (funcall dynamic-import (get (pathToFileURL (resolve out-root (str m ".mjs"))) :href)))))
              (put loaded m ns))
            (setq idx (1+ idx)))
          (js-object :directory directory :mods loaded))
        (catch err
          (await (rm directory (js-object :recursive t :force t)))
          (throw err)))))

  (defun max-line-length (text)
    (let ((lines (js-call text :split "\n"))
          (best 0)
          (i 0))
      (while (< i (js-length lines))
        (let ((len (js-length (aref lines i))))
          (when (> len best) (setq best len)))
        (setq i (1+ i)))
      best))

  (test "stdlib/diff computes recursive only-a, only-b, and both tuples across collections"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "diff" "pprint" "uuid" "time" "data-text"))))
             (directory (get built :directory))
             (DF (get (get built :mods) :diff)))
        (try
          ;; Equal scalars & structures
          (let ((d-eq (js-call DF :diff 42 42)))
            (be (js-call d-eq :nth 0) nil)
            (be (js-call d-eq :nth 1) nil)
            (be (js-call d-eq :nth 2) 42))
          (let ((d-diff (js-call DF :diff 1 2)))
            (be (js-call d-diff :nth 0) 1)
            (be (js-call d-diff :nth 1) 2)
            (be (js-call d-diff :nth 2) nil))

          ;; Nested maps + vectors + sets
          (let* ((left (persistentHashMap
                         (js-array (keyword "a") 1)
                         (js-array (keyword "onlyA") "x")
                         (js-array (keyword "nested") (persistentHashMap (js-array (keyword "same") 10) (js-array (keyword "diff") 20)))
                         (js-array (keyword "vec") (persistentVector 1 2 3))
                         (js-array (keyword "tags") (persistentHashSet (keyword "r") (keyword "w")))))
                 (right (persistentHashMap
                          (js-array (keyword "a") 1)
                          (js-array (keyword "onlyB") "y")
                          (js-array (keyword "nested") (persistentHashMap (js-array (keyword "same") 10) (js-array (keyword "diff") 99)))
                          (js-array (keyword "vec") (persistentVector 1 8))
                          (js-array (keyword "tags") (persistentHashSet (keyword "w") (keyword "x")))))
                 (tuple (js-call DF :diff left right))
                 (only-a (js-call tuple :nth 0))
                 (only-b (js-call tuple :nth 1))
                 (both (js-call tuple :nth 2)))
            (be (js-call only-a :get (keyword "onlyA")) "x")
            (be (js-call (js-call only-a :get (keyword "nested")) :get (keyword "diff")) 20)
            (be (js-call only-b :get (keyword "onlyB")) "y")
            (be (js-call (js-call only-b :get (keyword "nested")) :get (keyword "diff")) 99)
            (be (js-call both :get (keyword "a")) 1)
            (be (js-call (js-call both :get (keyword "nested")) :get (keyword "same")) 10)
            (be (equalValues (js-call only-a :get (keyword "tags")) (persistentHashSet (keyword "r"))) t)
            (be (equalValues (js-call only-b :get (keyword "tags")) (persistentHashSet (keyword "x"))) t)
            (be (equalValues (js-call both :get (keyword "tags")) (persistentHashSet (keyword "w"))) t)
            (be (equalValues (js-call only-a :get (keyword "vec")) (persistentVector nil 2 3)) t)
            (be (equalValues (js-call only-b :get (keyword "vec")) (persistentVector nil 8)) t)
            (be (equalValues (js-call both :get (keyword "vec")) (persistentVector 1)) t))

          ;; Edge cases: nil, mismatched container types, list vs vector
          (same (js-call (js-call DF :diff nil nil) :toArray) (js-array nil nil nil))
          (let ((nv (js-call DF :diff nil (persistentVector 1))))
            (be (js-call nv :nth 0) nil)
            (be (equalValues (js-call nv :nth 1) (persistentVector 1)) t)
            (be (js-call nv :nth 2) nil))
          (let ((mm (js-call DF :diff (persistentHashMap (js-array (keyword "a") 1)) (persistentVector 1))))
            (be (equalValues (js-call mm :nth 0) (persistentHashMap (js-array (keyword "a") 1))) t)
            (be (equalValues (js-call mm :nth 1) (persistentVector 1)) t)
            (be (js-call mm :nth 2) nil))
          (let ((lv (js-call DF :diff (persistentList 1 2) (persistentVector 1 2 3))))
            (be (js-call lv :nth 0) nil)
            (be (equalValues (js-call lv :nth 1) (persistentVector nil nil 3)) t)
            (be (equalValues (js-call lv :nth 2) (persistentVector 1 2)) t))
          (finally
            (await (rm directory (js-object :recursive t :force t)))))))
    60000)

  (test "stdlib/pprint respects line widths, round-trips data-text, guards cycles, and formats tables"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "diff" "pprint" "uuid" "time" "data-text"))))
             (directory (get built :directory))
             (mods (get built :mods))
             (PP (get mods :pprint))
             (DT (get mods :data-text)))
        (try
          ;; Width-aware wrapping across both JS object options and PersistentMap options + round-trip via read-value
          (let* ((nested (persistentHashMap
                           (js-array (keyword "alpha-key") (persistentVector "item-one" "item-two" "item-three"))
                           (js-array (keyword "beta-key") (persistentList (keyword "first") (keyword "second") (keyword "third")))
                           (js-array (keyword "gamma-set") (persistentHashSet "s1" "s2"))
                           (js-array (keyword "delta-queue") (persistentQueue 10 20 30))))
                 (w40 (js-call PP :pprint_str nested (js-object :width 40)))
                 (w24-map (js-call PP :pprint_str nested (persistentHashMap (js-array (keyword "width") 24))))
                 (restored (js-call DT :read_value w40)))
            (be (<= (max-line-length w40) 40) t)
            (be (<= (max-line-length w24-map) 24) t)
            (be (equalValues restored nested) t))

          ;; DAG sharing (non-circular) must expand both copies; JS cycle must emit #circular
          (let* ((leaf (persistentVector 1 2 3))
                 (dag (persistentVector leaf leaf))
                 (dag-text (js-call PP :pprint_str dag))
                 (cyc (js-object :name "loop")))
            (put cyc :self cyc)
            (be dag-text "[[1 2 3] [1 2 3]]")
            (js-call (expect (js-call PP :pprint_str cyc)) :toContain "#circular"))

          ;; max-depth, max-length, print-meta, TaggedLiteral formatting
          (let* ((deep (persistentVector (persistentVector (persistentVector 99))))
                 (annotated (withMeta (persistentVector 1 2 3 4) (persistentHashMap (js-array (keyword "role") "num"))))
                 (tl (js-call DT :tagged_literal "user/payload" (persistentHashMap (js-array (keyword "alpha") 1) (js-array (keyword "beta") 2)))))
            (be (js-call PP :pprint_str deep (js-object :maxDepth 2)) "[[#]]")
            (be (js-call PP :pprint_str (persistentVector 1 2 3 4) (persistentHashMap (js-array (keyword "max-length") 2))) "[1 2 ...]")
            (be (js-call PP :pprint_str annotated (persistentHashMap (js-array (keyword "print-meta") t))) "^{:role \"num\"} [1 2 3 4]")
            (js-call (expect (js-call PP :pprint_str tl (js-object :width 20))) :toContain "#user/payload"))

          ;; pp, pprint, print-table, table-str
          (let ((written (js-array))
                (rows (persistentVector
                        (persistentHashMap (js-array (keyword "name") "Ada") (js-array (keyword "score") 100))
                        (persistentHashMap (js-array (keyword "name") "Lin") (js-array (keyword "score") 9)))))
            (let ((ret (js-call PP :pp (persistentVector 1 2) (js-object :writer (lambda (s) (js-call written :push s))))))
              (be (equalValues ret (persistentVector 1 2)) t)
              (same written (js-array "[1 2]")))
            (be (js-call PP :table_str rows)
              "| :name | :score |\n|-------+--------|\n|   Ada |    100 |\n|   Lin |      9 |")
            (let ((tbl-out (js-array)))
              (be (js-call PP :print_table (persistentVector (keyword "score") (keyword "name")) rows (js-object :writer (lambda (s) (js-call tbl-out :push s)))) nil)
              (same tbl-out (js-array "| :score | :name |\n|--------+-------|\n|    100 |   Ada |\n|      9 |   Lin |"))))

          ;; Edge limits & option validation
          (be (js-call PP :pprint_str (persistentVector 1 2) (js-object :maxDepth 0)) "#")
          (be (js-call PP :pprint_str (persistentVector 1 2) (js-object :maxLength 0)) "[...]")
          (be (js-call PP :pprint_str (persistentHashMap)) "{}")
          (be (js-call PP :pprint_str (persistentList)) "()")
          (be (js-call PP :pprint_str (persistentHashSet)) "#{}")
          (be (js-call PP :table_str (persistentVector)) "")
          (js-call (expect (lambda () (js-call PP :pprint_str 1 (js-object :width 0)))) :toThrow "pprint :width must be a positive safe integer")
          (js-call (expect (lambda () (js-call PP :pprint_str 1 (js-array)))) :toThrow "pprint options must be a map or plain object")
          (finally
            (await (rm directory (js-object :recursive t :force t)))))))
    60000)
)
