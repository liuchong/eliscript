(module tests.local-onboarding.test
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve join)
  (import "../tools/onboarding/check.mjs" checkOnboarding OnboardingValidationError verifyRun)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defasync contract () (JSON/parse (await (readFile (join ROOT "contracts/local-onboarding.json") "utf8"))))
  (defasync validationErrors (candidate)
    (let ((failed false) (errors undefined))
      (try (await (checkOnboarding (js-object :root ROOT :contract candidate)))
        (catch error (js-call (expect error) :toBeInstanceOf OnboardingValidationError) (setq failed t) (setq errors (get error :errors))))
      (if failed errors (throw (new globalThis.Error "expected onboarding validation to fail")))))
  (test "local onboarding contract binds the core-only validation run" (async ()
    (let ((report (await (checkOnboarding (js-object :root ROOT))))) (js-call (expect report) :toMatchObject (js-object "schemaVersion" 1 "format" "eliscript-local-onboarding-contract-report" "version" 1 "steps" 6 "activeSteps" 5 "sourceFiles" 12 "maximumActiveDurationMs" 900000 "environment" (js-object "provider" "local" "requiredCommands" (js-array "git" "bun" "emacs" "make")))))))
  (test "local onboarding contract rejects missing prerequisite documentation" (async ()
    (let ((candidate (await (contract))))
      (put (get candidate :requiredDocumentation) 0 "missing prerequisite command")
      (js-call (expect (await (validationErrors candidate))) :toContain "docs/getting-started.md is missing required text: missing prerequisite command"))))
  (test "local onboarding contract rejects application tests in the core exercise" (async ()
    (let ((candidate (await (contract))))
      (put (js-call (get candidate :steps) :at -1) :argv (js-array "make" "test-applications"))
      (let ((errors (await (validationErrors candidate))))
        (js-call (expect errors) :toContain "steps[5] leaks application validation into onboarding")
        (js-call (expect errors) :toContain "core-suite must execute make test-core")))))
  (test "local onboarding contract rejects a weakened compiler-build step" (async ()
    (let ((candidate (await (contract))))
      (put (aref (get candidate :steps) 2) :argv (js-array "true"))
      (js-call (expect (await (validationErrors candidate))) :toContain "steps[2] must match the version 1 compiler-build step"))))
  (test "local onboarding contract rejects an unsupported provider" (async ()
    (let ((candidate (await (contract))))
      (put (get candidate :environment) :provider "remote")
      (js-call (expect (await (validationErrors candidate))) :toContain "environment must match the version 1 local inventory"))))
  (test "retained local onboarding run is complete and source-bound" (async ()
    (let ((report (await (verifyRun (js-object :root ROOT :runFile "acceptance/runs/m13-02.json" :markdownFile "acceptance/runs/m13-02.md")))))
      (js-call (expect (get report :execution)) :toEqual (js-object :provider "local" :sourceCommit (get (get report :source) :commit)))
      (js-call (expect (get report :summary)) :toMatchObject (js-object "required" 6 "passed" 6 "failed" 0 "notRun" 0 "withinActiveBudget" t "cleanBefore" t "cleanAfter" t "applicationsExecuted" false "validationPass" t)))))
  (test "retained local onboarding run rejects forged provenance" (async ()
    (let ((report (JSON/parse (await (readFile (join ROOT "acceptance/runs/m13-02.json") "utf8")))))
      (put (get report :execution) :provider "remote") (put (get report :environment) :provider "remote")
      (await (js-call (get (expect (verifyRun (js-object :root ROOT :report report))) :rejects) :toMatchObject (js-object "errors" (js-array "run must identify local execution at its source commit" "run environment must use the local provider")))))))
)
