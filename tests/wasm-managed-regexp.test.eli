(module tests.wasm-managed-regexp.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:child_process" spawnSync)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst uint32 (js* "(v) => v >>> 0"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defvar b nil)
  (defvar runtime nil)
  (defvar dir nil)

  (beforeAll (async ()
    (setq dir (await (mkdtemp (resolve (tmpdir) "eliscript-managed-regexp-"))))
    (setq b (await (buildBackends (js-object :outputRoot dir))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string
                    (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                    "runtime.eli")))
    120000)

  (afterAll (async ()
    (when dir
      (await (rm dir (js-object :recursive t :force t))))))

  (defasync compile (pattern &rest __host_default_arguments_1)
    (let* ((flags (aref __host_default_arguments_1 0)) (extra-source (aref __host_default_arguments_1 1)))
    (let* ((fl (if (undefined? flags) "" flags))
           (ex (if (undefined? extra-source) "" extra-source))
           (source (str "(defconst pattern (js* " (JSON/stringify (str "/" pattern "/" fl)) ")) "
                        "(defun test-value (x) (js-call pattern :test x)) "
                        "(defun match-value (x) (js-call pattern :exec x)) "
                        "(defun meta-value (x key) (get x key)) "
                        "(export test-value match-value meta-value)"
                        ex))
           (p (js-call (get b :compiler) :compile_ir_string source "regexp.eli"))
           (javascript (js-call (get b :compiler) :emit_ir_string p))
           (js (await (funcall dynamic-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from javascript) :toString "base64"))))))
      (js-object
        :p p
        :js js
        :javascript javascript
        :pattern pattern
        :flags fl
        :emit (lambda () (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime)))))))

  (defun box (a x)
    (let ((ty (funcall js-typeof x)))
      (cond
        ((= ty "number") (js-call a :number x))
        ((= ty "string") (js-call a :string x))
        (t x))))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((values (aref __host_default_arguments_2 0)))
    (let ((items (if (undefined? values) (js-array) values)))
      (js-call items :forEach (lambda (x) (js-call a :release x))))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (defasync check (pattern flags inputs)
    (let ((c (await (compile pattern flags))))
      (js-call inputs :forEach
        (lambda (x)
          (js-call assert :equal (js-call (get c :js) :test_value x) (js-call (new globalThis.RegExp pattern flags) :test x))))
      (let ((bytes (js-call c :emit)))
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (let ((a (instantiateManagedRuntime bytes)))
          (js-call a :auto 1)
          (js-call inputs :forEach
            (lambda (x)
              (let ((value (box a x)))
                (js-call assert :equal (js-call a :invoke "test-value" (js-array value)) (js-call (get c :js) :test_value x) (str pattern ": " (globalThis.String x)))
                (js-call a :release value))))
          (finish a)
          c))))

  (test "compiler numeric and gensym patterns execute from original source in WASM" (async ()
    (await (check "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$" ""
             (js-array "0" "-0" "+1" ".5" "1." "1.e2" "1e-2" "+1e" "0x10" "x" "" "1\n" nil t 65 globalThis.NaN globalThis.Infinity)))
    (await (check "^[A-Za-z_$][A-Za-z0-9_$?!*+=<>-]*$" ""
             (js-array "x" "$x" "_ok" "a?!" "a-b" "0bad" "" "中文" "x\n")))))

  (test "literal classes alternatives anchors and multiline or dotAll modes use the same matcher" (async ()
    (let ((cases (js-array
                   (js-array "a|bc" "")
                   (js-array "^[^0-9]*$" "")
                   (js-array "^[]]$" "")
                   (js-array "^[^]*$" "")
                   (js-array "^a.b$" "s")
                   (js-array "^b$" "m")
                   (js-array "\\bword\\B" "")
                   (js-array "a*?a" "")
                   (js-array "(?:|a)*" "")))
          (i 0))
      (while (< i (js-length cases))
        (let ((pair (aref cases i)))
          (await (check (aref pair 0) (aref pair 1)
                   (js-array "" "a" "aa" "bc" "abc" "ab" "1" "a\nb" "a\nb\nc" "wordx" "words" "\x00" "😀" "\ud800"))))
        (setq i (1+ i))))))

  (test "UTF16 and Unicode mode retain surrogate boundaries and escaped supplementary points" (async ()
    (let ((cases (js-array
                   (js-array "^.$" "")
                   (js-array "^.$" "u")
                   (js-array "^😀+$" "u")
                   (js-array "^\\uD83D\\uDE00$" "u")
                   (js-array "^[\\u{1F600}-\\u{1F601}]+$" "u")
                   (js-array "^\\uD800$" "u")))
          (i 0))
      (while (< i (js-length cases))
        (let ((pair (aref cases i)))
          (await (check (aref pair 0) (aref pair 1)
                   (js-array "" "a" "😀" "😀😀" "😁" "\ud800" "\ud83d" "\ude00" "a😀"))))
        (setq i (1+ i))))))

  (test "exec captures preserve missing groups, ordered greediness and UTF16 index/input metadata" (async ()
    (let* ((c (await (compile "(a|(b))+")))
           (bytes (js-call c :emit))
           (a (instantiateManagedRuntime bytes)))
      (js-call a :auto 1)
      (js-call (js-array "zzab" "aa" "b" "x") :forEach
        (lambda (text)
          (let* ((input (js-call a :string text))
                 (out (js-call a :invoke "match-value" (js-array input)))
                 (expected (js-call (get c :js) :match_value text)))
            (if (nil? expected)
              (js-call assert :equal out nil)
              (let ((i 0))
                (js-call assert :equal (js-call a :length out) (js-length expected))
                (while (< i (js-length expected))
                  (let ((v (js-call a :get out i)))
                    (js-call assert :equal (if (undefined? v) undefined (js-call a :readString v)) (aref expected i))
                    (js-call a :release v))
                  (setq i (1+ i)))
                (js-call (js-array "index" "input" "groups") :forEach
                  (lambda (key)
                    (let* ((k (js-call a :string key))
                           (v (js-call a :invoke "meta-value" (js-array out k))))
                      (js-call assert :equal
                        (cond
                          ((undefined? v) undefined)
                          ((= (get v :kind) 4) (js-call a :readNumber v))
                          (t (js-call a :readString v)))
                        (get expected key))
                      (js-call a :release k)
                      (js-call a :release v))))))
            (js-call a :release input)
            (js-call a :release out))))
      (finish a))))

  (test "independent Node establishes source behavior before its identical WASM artifact executes" (async ()
    (let* ((c (await (compile "^(?:a|bc)+?$" "u")))
           (path (resolve dir "reference.mjs")))
      (await (writeFile path (get c :javascript)))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-regexp-node.mjs")
                               "ref"
                               (get (pathToFileURL path) :href))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr)))
      (let* ((bytes (js-call c :emit))
             (wasm (resolve dir "node-regexp.wasm")))
        (await (writeFile wasm bytes))
        (let ((node (spawnSync "node"
                      (js-array (resolve "tests/helpers/wasm-managed-regexp-node.mjs")
                                "wasm"
                                (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                wasm)
                      (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get node :status) 0 (get node :stderr)))
        (let* ((a (instantiateManagedRuntime bytes))
               (text (js-call a :string "abca")))
          (js-call assert :equal (js-call a :invoke "test-value" (js-array text)) t)
          (finish a (js-array text)))))))

  (test "ordinary test and exec callables are captured before arguments while missing methods fail after effects" (async ()
    (let* ((source "(defconst held nil) (defun factory () (lambda (x extra) extra)) (defun call-test (receiver x trace) (js-call receiver :test x (put trace :visited 7))) (defun call-exec (receiver x trace) (js-call receiver :exec x (progn (put receiver :exec false) (put trace :visited 9)))) (export factory call-test call-exec)")
           (p (js-call (get b :compiler) :compile_ir_string source "method-order.eli"))
           (js (await (funcall dynamic-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64")))))
           (trace (js-object)))
      (js-call assert :throws (lambda () (js-call js :call_test false 65 trace)) globalThis.TypeError)
      (js-call assert :equal (get trace :visited) 7)
      (let ((object (js-object :exec (js-call js :factory)))
            (effects (js-object)))
        (js-call assert :equal (js-call js :call_exec object 65 effects) 9)
        (js-call assert :equal (get object :exec) false))
      (let ((a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime)))))
        (js-call a :auto 1)
        (let ((value (js-call a :number 65))
              (seen (js-call a :sourceObject (js-object))))
          (js-call assert :throws
            (lambda () (js-call a :invoke "call-test" (js-array false value seen)))
            (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0003")))))
          (let ((untouched (js-call a :sourceObject (js-object))))
            (js-call assert :throws
              (lambda () (js-call a :invoke "call-test" (js-array nil value untouched)))
              (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0003")))))
            (let ((missing (js-call a :string "visited")))
              (js-call assert :equal (js-call a :objectHas untouched missing) false)
              (js-call a :release untouched)
              (js-call a :release missing)))
          (let* ((key (js-call a :string "visited"))
                 (visited (js-call a :objectGet seen key)))
            (js-call assert :equal (js-call a :readNumber visited) 7)
            (js-call a :release visited)
            (let* ((f (js-call a :invoke "factory"))
                   (receiver (js-call a :sourceObject (js-object :exec f)))
                   (out (js-call a :invoke "call-exec" (js-array receiver value seen)))
                   (exec-key (js-call a :string "exec")))
              (js-call assert :equal (js-call a :readNumber out) 9)
              (js-call assert :equal (js-call a :objectGet receiver exec-key) false)
              (finish a (js-array value seen key f receiver out exec-key)))))))))

  (defun complete (a c text)
    (let* ((x (js-call a :string text))
           (out (js-call a :invoke "match-value" (js-array x)))
           (expected (js-call (get c :js) :match_value text)))
      (if (nil? expected)
        (js-call assert :equal out nil)
        (let ((i 0))
          (js-call assert :equal (js-call a :length out) (js-length expected))
          (while (< i (js-length expected))
            (let ((v (js-call a :get out i)))
              (js-call assert :equal
                (if (undefined? v) undefined (js-call a :readString v))
                (aref expected i)
                (str (get c :pattern) "/" (get c :flags) ": " text))
              (js-call a :release v))
            (setq i (1+ i)))
          (js-call (js-array "index" "input" "groups") :forEach
            (lambda (name)
              (let* ((key (js-call a :string name))
                     (value (js-call a :invoke "meta-value" (js-array out key))))
                (js-call assert :equal
                  (cond
                    ((undefined? value) undefined)
                    ((= (get value :kind) 4) (js-call a :readNumber value))
                    (t (js-call a :readString value)))
                  (get expected name))
                (js-call a :release key)
                (js-call a :release value))))))
      (js-call a :release x)
      (js-call a :release out)
      (js-call a :collect)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (if (nil? expected)
        nil
        (js-object
          :values (js-call (Array/from expected) :map (lambda (v) (if (undefined? v) (js-object :missing t) v)))
          :index (get expected :index)
          :input (get expected :input)))))

  (test "deterministic pattern/text models preserve captures and priorities including nullable repeated groups" (async ()
    (let* ((seed 2035165203)
           (next (lambda ()
                   (setq seed (funcall uint32 (+ (Math/imul seed 1664525) 1013904223)))
                   seed))
           (atoms (js-array "a" "b" "." "[ab]" "[^a]" "\\d" "\\w" "😀")))
      (let ((node nil))
        (setq node (lambda (depth)
                     (if (= depth 0)
                       (aref atoms (% (funcall next) (js-length atoms)))
                       (let ((tag (% (funcall next) 5)))
                         (cond
                           ((= tag 0) (str "(?:" (funcall node (- depth 1)) "|" (funcall node (- depth 1)) ")"))
                           ((= tag 1) (str "(" (funcall node (- depth 1)) ")"))
                           ((= tag 2) (str "(?:" (funcall node (- depth 1)) ")" (aref (js-array "*" "+" "?" "*?" "+?" "??") (% (funcall next) 6))))
                           (t (str (funcall node (- depth 1)) (funcall node (- depth 1)))))))))
        (let* ((records (js-array))
               (generated (Array/from (js-object :length 48)
                            (lambda () (js-array (funcall node 2) (aref (js-array "" "u" "m" "s" "su") (% (funcall next) 5))))))
               (fixed (js-call
                        (js-array "(a*)*" "(a*?)+" "(a|(b))+" "((a)|(b))*" "(?:|a)*" "((?:a?|b)*)" "(a)?(b)?" "(a|ab)*?b" "(?:a|)*a" "((a)?)*")
                        :map (lambda (x) (js-array x ""))))
               (cases (js-call generated :concat fixed))
               (ci 0))
          (while (< ci (js-length cases))
            (let* ((pair (aref cases ci))
                   (pattern (aref pair 0))
                   (flags (aref pair 1))
                   (c (await (compile pattern flags)))
                   (a (instantiateManagedRuntime (js-call c :emit))))
              (js-call a :auto 1)
              (js-call a :collect)
              (let ((baseline (js-call a :live))
                    (ti 0))
                (while (< ti 24)
                  (let* ((chars (js-array "a" "b" "1" "_" "\n" "😀" "\ud800"))
                         (text (js-call
                                 (Array/from (js-object :length (% (funcall next) 7))
                                   (lambda () (aref chars (% (funcall next) (js-length chars)))))
                                 :join ""))
                         (expected (complete a c text)))
                    (js-call assert :equal (js-call a :live) baseline (str "roots after " pattern))
                    (js-call records :push (js-object :pattern pattern :flags flags :text text :expected expected)))
                  (setq ti (1+ ti))))
              (finish a))
            (setq ci (1+ ci)))
          (let ((path (resolve dir "random-models.json")))
            (await (writeFile path (JSON/stringify records)))
            (let ((child (spawnSync "node"
                           (js-array (resolve "tests/helpers/wasm-managed-regexp-node.mjs")
                                     "models"
                                     path)
                           (js-object :encoding "utf8" :timeout 30000))))
              (js-call assert :equal (get child :status) 0 (get child :stderr))))))))
    30000)

  (test "invalid raw literal grammar and malformed IR are rejected with the original source identity" (async ()
    (let ((raws (js-array "/a\nb/" "/a\rb/" "/a\u2028b/" "/a\u2029b/"))
          (i 0))
      (while (< i (js-length raws))
        (let* ((raw (aref raws i))
               (p (js-call (get b :compiler) :compile_ir_string
                    (str "(defun f () (js* " (JSON/stringify raw) ")) (export f)")
                    "bad-literal.eli"))
               (reference (resolve dir "invalid-literal.mjs")))
          (await (writeFile reference (js-call (get b :compiler) :emit_ir_string p)))
          (let ((child (spawnSync "node" (js-array "--check" reference) (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 1)
            (js-call assert :match (get child :stderr) (new globalThis.RegExp "SyntaxError"))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
              (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-B0001")))))))
        (setq i (1+ i))))
    (let ((p (js-call (get b :compiler) :compile_ir_string "(defun f () (js* \"/a/\")) (export f)" "bad-ir.eli")))
      (put (aref (get (aref (get p :body) 0) :children) 0) :children (js-array nil))
      (js-call assert :throws
        (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
        (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-B0001"))))))))

  (test "the original quantified lookaround backreference and g y i d literals execute with exact captures indices and state" (async ()
    (let ((read-val nil))
      (setq read-val (lambda (a value)
                       (cond
                         ((or (nullish? value) (= (funcall js-typeof value) "boolean")) value)
                         ((= (get value :kind) 4) (js-call a :readNumber value))
                         ((= (get value :kind) 5) (js-call a :readString value))
                         (t
                          (js-call assert :equal (get value :kind) 14)
                          (Array/from (js-object :length (js-call a :length value))
                            (lambda (_ index)
                              (let ((child (js-call a :get value index)))
                                (try (funcall read-val a child) (finally (js-call a :release child))))))))))
      (let ((property (lambda (a target name)
                        (let ((key (js-call a :string name))
                              (result undefined))
                          (try
                            (progn
                              (setq result (js-call a :invoke "meta-value" (js-array target key)))
                              (funcall read-val a result))
                            (finally
                              (js-call a :release result)
                              (js-call a :release key))))))
            (cases (js-array
                     (js-array "a{2,3}" "")
                     (js-array "(?=a)a" "")
                     (js-array "(?<=a)b" "")
                     (js-array "(a)\\1" "")
                     (js-array "a" "g")
                     (js-array "a" "y")
                     (js-array "a" "i")
                     (js-array "a" "d")))
            (ci 0))
        (while (< ci (js-length cases))
          (let* ((pair (aref cases ci))
                 (pattern (aref pair 0))
                 (flags (aref pair 1))
                 (c (await (compile pattern flags
                             " (defun pattern-state () (js-array (get pattern :source) (get pattern :flags) (get pattern :lastIndex) (get pattern :hasIndices))) (export pattern-state)")))
                 (oracle (new globalThis.RegExp pattern flags))
                 (bytes (js-call c :emit)))
            (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
            (let* ((a (instantiateManagedRuntime bytes))
                   (_ (js-call a :auto 1))
                   (state (lambda ()
                            (let ((res (js-call a :invoke "pattern-state")))
                              (try (funcall read-val a res) (finally (js-call a :release res)))))))
              (try
                (let ((initial (js-array (get oracle :source) (get oracle :flags) (get oracle :lastIndex) (get oracle :hasIndices))))
                  (js-call assert :deepEqual (js-call (get c :js) :pattern_state) initial)
                  (js-call assert :deepEqual (funcall state) initial)
                  (js-call (js-array "" "a" "A" "aa" "aaa" "ab" "aab" "ba" "a" "none" "😀a" "aa" "a" "a") :forEach
                    (lambda (text)
                      (let ((expected (js-call oracle :exec text))
                            (javascript (js-call (get c :js) :match_value text)))
                        (js-call assert :deepEqual javascript expected (str pattern "/" flags ": JS " text))
                        (let ((input (js-call a :string text))
                              (out undefined))
                          (try
                            (progn
                              (setq out (js-call a :invoke "match-value" (js-array input)))
                              (if (nil? expected)
                                (js-call assert :equal out nil)
                                (progn
                                  (js-call assert :deepEqual (funcall read-val a out) (Array/from expected) (str pattern "/" flags ": captures " text))
                                  (js-call (js-array "index" "input" "groups") :forEach
                                    (lambda (name)
                                      (js-call assert :deepEqual (funcall property a out name) (get expected name))))
                                  (js-call assert :deepEqual (funcall property a out "indices")
                                    (if (undefined? (get expected :indices)) undefined (Array/from (get expected :indices))))
                                  (when (not (undefined? (get expected :indices)))
                                    (let ((key (js-call a :string "indices"))
                                          (indices undefined))
                                      (try
                                        (progn
                                          (setq indices (js-call a :invoke "meta-value" (js-array out key)))
                                          (js-call assert :equal (get indices :kind) 14)
                                          (js-call assert :deepEqual (funcall property a indices "groups") (get (get expected :indices) :groups)))
                                        (finally
                                          (js-call a :release indices)
                                          (js-call a :release key)))))))
                              (let ((after (js-array (get oracle :source) (get oracle :flags) (get oracle :lastIndex) (get oracle :hasIndices))))
                                (js-call assert :deepEqual (js-call (get c :js) :pattern_state) after)
                                (js-call assert :deepEqual (funcall state) after (str pattern "/" flags ": state " text))))
                            (finally
                              (js-call a :release out)
                              (js-call a :release input))))
                        (js-call a :collect)
                        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
                (finally (finish a)))))
          (setq ci (1+ ci)))))
    30000)

  (test "backtracking capacity failure and actual matching traps preserve caller frames and live source text" (async ()
    (let* ((c (await (compile "(a|aa)*b")))
           (a (instantiateManagedRuntime (js-call c :emit) (js-object :maxSlots 128 :initialBytes 4096 :maxBytes 16384))))
      (js-call a :auto 1)
      (let* ((text (str (js-call "a" :repeat 4096) "b"))
             (input (js-call a :string text))
             (held (js-call a :number -0.0))
             (outer (js-call a :frame 1)))
        (js-call a :frameSet outer 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "match-value" (js-array input)))
          (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0002")))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call assert :equal (js-call a :readString input) text)
        (js-call a :leaveFrame outer)
        (finish a (js-array input held)))
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun heap-regexp-point "))
             (end (js-call source :indexOf "  (defun heap-regexp-line " start)))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((rt (js-call (get b :compiler) :compile_ir_string
                     (str (js-call source :slice 0 start)
                          "  (defun heap-regexp-point (heap text position flags) (load-u32 4294967295))\n"
                          (js-call source :slice end))
                     "regexp-trap.eli"))
               (tr (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm (get c :p) rt)))))
          (js-call tr :auto 1)
          (let ((original (js-call tr :string "ab"))
                (saved (js-call tr :number -0.0))
                (frame (js-call tr :frame 1))
                (object (js-call tr :sourceObject (js-object))))
            (js-call tr :frameSet frame 0 saved)
            (js-call assert :throws
              (lambda () (js-call tr :invoke "test-value" (js-array object)))
              (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0003")))))
            (js-call assert :equal (get (js-call tr :stats) :frameDepth) 1)
            (js-call assert :throws
              (lambda () (js-call tr :invoke "test-value" (js-array original)))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call tr :stats) :frameDepth) 1)
            (funcall assert (Object/is (js-call tr :readNumber saved) -0.0))
            (js-call assert :equal (js-call tr :readString original) "ab")
            (js-call tr :leaveFrame frame)
            (finish tr (js-array original saved object))))))))

  (test "raw programs are privately copied, rooted and structurally checked before VM execution" (async ()
    (let* ((c (await (compile "^a$")))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (js-call c :emit))) :exports))
           (h (funcall uint32 (js-call e "heap-new" 128 4096 1048576)))
           (call (lambda (name &rest args)
                   (let ((v (funcall uint32 (Reflect/apply (get e name) e (js-call (js-array h) :concat args)))))
                     (js-call assert :equal (js-call e "last-error") 0 name)
                     v)))
           (mk-string (lambda (txt)
                        (let ((v (funcall call "value-string" (js-length txt)))
                              (i 0))
                          (funcall call "heap-pin" v)
                          (while (< i (js-length txt))
                            (funcall call "value-unit-set" v i (js-call txt :charCodeAt i))
                            (setq i (1+ i)))
                          (funcall call "value-seal" v)
                          v)))
           (source (funcall mk-string "^a$"))
           (text (funcall mk-string "a"))
           (prepare (lambda (code)
                      (let ((value (funcall call "value-bytes" (* (js-length code) 16))))
                        (funcall call "heap-pin" value)
                        (js-call (js-call code :flat) :forEach
                          (lambda (word index)
                            (funcall call "value-regexp-code-word" value index word)))
                        value)))
           (found-node nil))
      (let ((visit nil))
        (setq visit (lambda (x)
                      (when (and (not found-node) (not (nullish? x)) (= (funcall js-typeof x) "object"))
                        (if (= (get x :kind) "raw-javascript")
                          (setq found-node x)
                          (js-call (Object/values x) :forEach visit)))))
        (funcall visit (get c :p)))
      (let* ((compiled (js-call (get b :regexp) :compile_regexp_literal found-node))
             (code (funcall prepare (get compiled :code)))
             (regex (funcall call "value-regexp-new" code source 0 (get compiled :groups) (get compiled :guards)))
             (i 0))
        (funcall call "heap-pin" regex)
        (funcall call "heap-auto" 1)
        (while (< i (* (js-length (get compiled :code)) 16))
          (funcall call "value-byte-set" code i 255)
          (setq i (1+ i)))
        (funcall call "heap-release" code)
        (funcall call "heap-release" source)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "value-regexp-run" regex text 0) 2)
        (js-call
          (js-array
            (js-array (js-array 14 0 0 0))
            (js-array (js-array 6 0 0 0) (js-array 0 0 0 0))
            (js-array (js-array 6 2 0 0) (js-array 3 0 1 3) (js-array 4 97 97 0) (js-array 0 0 0 0))
            (js-array (js-array 3 0 1 2) (js-array 4 98 97 0) (js-array 0 0 0 0))
            (js-array (js-array 5 1 99 0) (js-array 0 0 0 0))
            (js-array (js-array 7 99 0 0) (js-array 0 0 0 0))
            (js-array (js-array 10 1 0 0) (js-array 0 0 0 0)))
          :forEach
          (lambda (malformed)
            (let ((input (funcall prepare malformed)))
              (js-call e "value-regexp-new" h input text 0 0 0)
              (js-call assert :equal (js-call e "last-error") 3 "independent malformed bytecode must be refused")
              (funcall call "heap-release" input))))
        (funcall call "heap-release" regex)
        (funcall call "heap-release" text)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)
        (js-call assert :equal (funcall call "frame-depth") 0)))))

  (test "more than one-byte capture indices and instruction offsets preserve all result cells under collecting GC" (async ()
    (let* ((count 140)
           (c (await (compile (str (js-call "(" :repeat count) "a" (js-call ")" :repeat count)))))
           (a (instantiateManagedRuntime (js-call c :emit) (js-object :maxSlots 512 :initialBytes 16384 :maxBytes 1048576))))
      (js-call a :auto 1)
      (let* ((input (js-call a :string "😀a"))
             (out (js-call a :invoke "match-value" (js-array input)))
             (i 0))
        (js-call assert :equal (js-call a :length out) (+ count 1))
        (while (<= i count)
          (let ((value (js-call a :get out i)))
            (js-call assert :equal (js-call a :readString value) "a")
            (js-call a :release value))
          (setq i (1+ i)))
        (let* ((key (js-call a :string "index"))
               (index (js-call a :invoke "meta-value" (js-array out key))))
          (js-call assert :equal (js-call a :readNumber index) 2)
          (finish a (js-array input out key index)))))))

  (test "raw comments are not reinterpreted as empty RegExp literals and invalid Unicode grammar stays refused" (async ()
    (let ((comments (js-array "//" "//u" "//msu"))
          (i 0))
      (while (< i (js-length comments))
        (let* ((raw (aref comments i))
               (p (js-call (get b :compiler) :compile_ir_string
                    (str "(defun f () (js* " (JSON/stringify raw) ")) (export f)")
                    "raw-comment.eli"))
               (js (await (funcall dynamic-import
                            (str "data:text/javascript;base64,"
                                 (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
          (js-call assert :equal (js-call js :f) undefined)
          (js-call assert :throws
            (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
            (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-B0001"))))))
        (setq i (1+ i))))
    (let ((grammars (js-array "/]/u" "/[\\d-a]/u"))
          (j 0))
      (while (< j (js-length grammars))
        (let* ((raw (aref grammars j))
               (p (js-call (get b :compiler) :compile_ir_string
                    (str "(defun f () (js* " (JSON/stringify raw) ")) (export f)")
                    "unicode-grammar.eli"))
               (path (resolve dir "unicode-grammar.mjs")))
          (await (writeFile path (js-call (get b :compiler) :emit_ir_string p)))
          (let ((node (spawnSync "node" (js-array "--check" path) (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get node :status) 1)
            (js-call assert :match (get node :stderr) (new globalThis.RegExp "SyntaxError"))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
              (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-B0001")))))))
        (setq j (1+ j))))))))
