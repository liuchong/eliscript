(module tests.bootstrap-formatter
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile readdir rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defasync sourceFiles (directory)
    (let ((files (js-array)) (entries (await (readdir directory (js-object :withFileTypes t)))) (index 0))
      (while (< index (js-length entries))
        (let* ((entry (aref entries index)) (filename (resolve directory (get entry :name))))
          (if (js-call entry :isDirectory) (setq files (js-call files :concat (await (sourceFiles filename))))
            (when (js-call (get entry :name) :endsWith ".eli") (js-call files :push filename))))
        (setq index (1+ index))) (js-call files :sort)))
  (test "self-hosted formatter preserves concrete syntax and core semantics" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-formatter-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((compilerUrl (get (pathToFileURL (resolve directory "compiler.mjs")) :href))
               (compiler (await (loadModule directory "compiler" "formatter-test")))
               (source "; heading   \n(module   demo.format\n(import \"./x.mjs\"   x) ; import   \n(defun  choose (x) (if (> x 0) #{:a :b} {:x [1 2]}))\n(defprotocol   IDescribe   describe)\n(extend-category \"number\"   IDescribe (describe (value) (str value)))\n(defun pipeline (value) (-> value (1+) (* 2)))\n(defun conditional (value enabled) (cond-> value enabled (1+) t (* 2)))\n(defun dispatch (value) (case value (1 2) :small :other))\n(defun predicate-dispatch (predicate value) (condp predicate value 1 :one :other))\n(defun choose-many\n(() :none)\n((value) value)\n((left right &rest remaining) (+ left right (length remaining))))\n(defun local-choice (value)\n(letfn ((walk (current) (if (= current 0) value (recur (1- current)))))\n(walk 10)))\n(defun present-pipeline (value) (some-> value (1+) (* 2)))\n(defun present (value) (if-some (item value) item :missing))\n`(a ,x ,@xs))\n") (expected "; heading\n(module demo.format\n  (import \"./x.mjs\" x)\n  ; import\n  (defun choose (x) (if (> x 0) #{:a :b} {:x [1 2]}))\n  (defprotocol IDescribe describe)\n  (extend-category \"number\" IDescribe (describe (value) (str value)))\n  (defun pipeline (value) (-> value (1+) (* 2)))\n  (defun conditional (value enabled) (cond-> value enabled (1+) t (* 2)))\n  (defun dispatch (value) (case value (1 2) :small :other))\n  (defun predicate-dispatch (predicate value) (condp predicate value 1 :one :other))\n  (defun choose-many\n    (() :none)\n    ((value) value)\n    ((left right &rest remaining) (+ left right (length remaining))))\n  (defun local-choice\n    (value)\n    (letfn ((walk (current) (if (= current 0) value (recur (1- current))))) (walk 10)))\n  (defun present-pipeline (value) (some-> value (1+) (* 2)))\n  (defun present (value) (if-some (item value) item :missing))\n  `(a ,x ,@xs))\n")
               (formatted (js-call compiler :format_source source "formatter-case.eli")))
          (js-call (expect (js-object :format (get compiler :formatter_format) :version (get compiler :formatter_version) :width (get compiler :formatter_width) :indent (get compiler :formatter_indent))) :toEqual
            (js-object :format "eliscript-formatter" :version 1 :width 88 :indent 2))
          (js-call (expect formatted) :toBe expected)
          (js-call (expect (js-call compiler :format_source formatted "formatter-case.eli")) :toBe formatted)
          (let* ((semanticSource "(module demo.semantic\n  (defun choose (x) (if (> x 0) #{:a :b} {:x [1 2]})))\n") (semanticFormatted (js-call compiler :format_source semanticSource "formatter-semantic.eli")))
            (js-call (expect (js-call compiler :compile_string semanticSource "formatter-semantic.eli")) :toBe (js-call compiler :compile_string semanticFormatted "formatter-semantic.eli")))
          (let ((nodeOutput (await (run (js-array (get (get globalThis.process :env) :NODE "node") (resolve projectDirectory "tests/fixtures/bootstrap-formatter-host.mjs"))
            (js-object :env (copyHostRecord (get globalThis.process :env) (js-object :COMPILER_URL compilerUrl :SOURCE source)))))))
            (js-call (expect nodeOutput) :toBe formatted))
          (let ((corpus (js-call (js-call (await (sourceFiles (resolve projectDirectory "bootstrap/compiler"))) :concat (await (sourceFiles (resolve projectDirectory "stdlib")))) :sort)) (index 0))
            (js-call (expect (get corpus :length)) :toBeGreaterThanOrEqual 40)
            (while (< index (js-length corpus))
              (let* ((filename (aref corpus index)) (original (await (readFile filename "utf8"))) (canonical (js-call compiler :format_source original filename)))
                (js-call (expect (js-call compiler :format_source canonical filename)) :toBe canonical)
                (js-call (expect (js-call compiler :compile_string canonical filename)) :toBe (js-call compiler :compile_string original filename)))
              (setq index (1+ index)))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 60000)
  (test "formatter returns stable reader and formatter diagnostics" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-formatter-error-")))))
      (try
        (await (buildBootstrap directory))
        (let ((compiler (await (loadModule directory "compiler" "errors"))))
          (try (js-call compiler :format_source "(module broken" "broken.eli") (throw (new globalThis.Error "expected invalid source rejection"))
            (catch error (js-call (expect (get error :eliscriptDiagnostic)) :toMatchObject (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-R0001" :phase "reader" :location (js-object :file "broken.eli")))))
          (try (js-call compiler :format_source 42 "broken.eli") (throw (new globalThis.Error "expected source type rejection"))
            (catch error (js-call (expect (get error :eliscriptDiagnostic)) :toMatchObject (js-object :code "ELI-F0001" :phase "formatter" :message "formatter source must be a string")))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
