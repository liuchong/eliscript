(module tests.wasm-managed-callables.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:child_process" spawnSync)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst to-uint32 (js* "(x) => x >>> 0"))
  (defconst bit-and (js* "(a, b) => a & b"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))
  (defconst callables-node-helper-path
    (fileURLToPath (new globalThis.URL "./helpers/wasm-managed-callables-node.mjs" (get (js* "import.meta") :url))))

  (defvar directory undefined)
  (defvar backends undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar javascript undefined)
  (defvar generated-closure-cases undefined)

  (defun prepare-generated-closure-cases ()
    (let* ((names (js-array "x" "heap" "frame" "error" "arguments" "function"))
           (operators (js-array "+" "-" "*" "/"))
           (seed 1071161687)
           (next-random (lambda ()
                          (setq seed (funcall to-uint32 (+ (Math/imul seed 1664525) 1013904223)))
                          seed))
           (cases (js-array)))
      (js-call names :forEach
        (lambda (name)
          (js-call (js-array false t) :forEach
            (lambda (sequential)
              (js-call operators :forEach
                (lambda (op)
                  (let* ((salt (/ (- (% (funcall next-random) 2001) 1000) 16))
                         (idx (get cases :length))
                         (outer (cond
                                  ((= (% idx 3) 0) -0.0)
                                  ((= (% idx 3) 1) (get globalThis.Number :NaN))
                                  (t 7.25)))
                         (bindings (if sequential
                                     (str "((" name " " salt ") (before (lambda () " name ")))")
                                     (str "((before (lambda () " name ")) (" name " " salt "))")))
                         (source (str "(defun make (" name ") (" (if sequential "let*" "let") " " bindings "\n"
                                      "      (js-array (lambda (delta) (setq " name " (" op " " name " delta)) " name ") (lambda () " name ") before)))\n"
                                      "      (defun update (f delta) (funcall f delta)) (defun read (f) (funcall f)) (export make update read)"))
                         (ir (js-call (get backends :compiler) :compile_ir_string source
                               (str "generated-capture-" idx ".eli")))
                         (before (JSON/stringify ir))
                         (bytes (globalThis.Uint8Array.from
                                  (js-call (get backends :managed) :emit_managed_wasm ir runtime))))
                    (js-call assert :equal (JSON/stringify ir) before)
                    (js-call cases :push
                      (js-object :name name :sequential sequential :op op
                                 :salt salt :outer outer :bytes bytes)))))))))
      (js-call assert :equal (get cases :length) 48)
      cases))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-callables-"))))
      (setq backends (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get backends :compiler) :compile_ir_string
                      (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                      "runtime.eli"))
      (setq program (js-call (get backends :compiler) :compile_ir_string
                      (await (readFile "tests/fixtures/wasm-managed-callables.eli" "utf8"))
                      "callables.eli"))
      (setq javascript
        (await (funcall dynamic-import
                 (str "data:text/javascript;base64,"
                      (js-call (Buffer/from (js-call (get backends :compiler) :emit_ir_string program))
                               :toString "base64")))))
      (let ((prepared-at (js-call globalThis.performance :now)))
        (setq generated-closure-cases (prepare-generated-closure-cases))
        (js-call globalThis.console :info
          (str "[managed-callables] prepared " (get generated-closure-cases :length)
               " full-runtime artifacts in "
               (js-call (- (js-call globalThis.performance :now) prepared-at) :toFixed 2)
               "ms"))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun instance ()
    (let* ((bytes (globalThis.Uint8Array.from
                    (js-call (get backends :managed) :emit_managed_wasm program runtime)))
           (_1 (funcall assert (js-call globalThis.WebAssembly :validate bytes)))
           (_2 (js-call assert :deepEqual
                 (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
                 (js-array)))
           (heap (instantiateManagedRuntime bytes)))
      (js-call heap :auto 1)
      heap))

  (defun read-num (heap name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (let ((result (js-call heap :invoke name (if (undefined? args) (js-array) args))))
      (try
        (js-call heap :readNumber result)
        (finally (js-call heap :release result))))))

  (defun finish (heap values)
    (js-call values :forEach (lambda (value) (js-call heap :release value)))
    (js-call heap :collect)
    (js-call assert :equal (js-call heap :live) 0)
    (js-call assert :equal (get (js-call heap :stats) :frameDepth) 0))

  (test "escaping, nested and recursive closures execute inside WASM with exact shared captures"
    (lambda ()
      (js-call assert :equal (funcall (js-call javascript :make_adder 4) 5) 9)
      (js-call assert :equal (funcall (funcall (js-call javascript :nested 4) 5) 6) 15)
      (js-call assert :equal (funcall (js-call javascript :recursive) 24) 24)
      (let* ((heap (instance))
             (four (js-call heap :number 4))
             (five (js-call heap :number 5))
             (six (js-call heap :number 6))
             (cnt (js-call heap :number 24))
             (adder (js-call heap :invoke "make-adder" (js-array four))))
        (js-call heap :collect)
        (js-call assert :equal
          (read-num heap "apply-one" (js-array adder five))
          (funcall (js-call javascript :make_adder 4) 5))
        (let* ((first (js-call heap :invoke "nested" (js-array four)))
               (second (js-call heap :invoke "apply-one" (js-array first five))))
          (js-call assert :equal
            (read-num heap "apply-one" (js-array second six))
            (funcall (funcall (js-call javascript :nested 4) 5) 6))
          (let ((rec (js-call heap :invoke "recursive" (js-array))))
            (js-call assert :equal
              (read-num heap "apply-one" (js-array rec cnt))
              (funcall (js-call javascript :recursive) 24))
            (let ((written (js-call heap :invoke "outer-write" (js-array four)))
                  (shadow (js-call heap :invoke "shadow" (js-array four))))
              (js-call assert :equal
                (read-num heap "apply-zero" (js-array written))
                (funcall (js-call javascript :outer_write 4)))
              (js-call assert :equal
                (read-num heap "apply-zero" (js-array shadow))
                (funcall (js-call javascript :shadow 4)))
              (finish heap (js-array four five six cnt adder first second rec written shadow))))))))

  (test "sibling closures share mutable cells while loop bindings and function identities stay distinct"
    (lambda ()
      (let ((reference (js-call javascript :make_pair 4)))
        (js-call assert :equal (funcall (aref reference 0)) 5)
        (js-call assert :equal (funcall (aref reference 1)) 5))
      (js-call assert :deepEqual
        (js-call (js-call javascript :capture_each 4) :map (lambda (f) (funcall f)))
        (js-array 0 1 2 3))
      (js-call assert :equal (js-call javascript :named_same) t)
      (js-call assert :equal (js-call javascript :fresh_same) false)
      (let* ((heap (instance))
             (four (js-call heap :number 4))
             (pair (js-call heap :invoke "make-pair" (js-array four)))
             (increment (js-call heap :get pair 0))
             (current (js-call heap :get pair 1))
             (i 0))
        (while (< i 32)
          (js-call assert :equal (read-num heap "apply-zero" (js-array increment)) (+ 5 i))
          (js-call heap :collect)
          (js-call assert :equal (read-num heap "apply-zero" (js-array current)) (+ 5 i))
          (setq i (1+ i)))
        (let ((items (js-call heap :invoke "capture-each" (js-array four)))
              (j 0))
          (while (< j 4)
            (let ((f (js-call heap :get items j)))
              (try
                (js-call assert :equal (read-num heap "apply-zero" (js-array f)) j)
                (finally (js-call heap :release f))))
            (setq j (1+ j)))
          (js-call assert :equal (js-call heap :invoke "named-same") t)
          (js-call assert :equal (js-call heap :invoke "fresh-same") false)
          (js-call assert :equal (js-call heap :invoke "repeated-same") false)
          (let ((fresh-a (js-call heap :invoke "fresh-function"))
                (fresh-b (js-call heap :invoke "fresh-function")))
            (funcall assert (not (js-call heap :keyEqual fresh-a fresh-b)))
            (js-call heap :release fresh-a)
            (js-call heap :release fresh-b))
          (let ((named (js-call heap :invoke "named-value"))
                (another (js-call heap :invoke "named-value")))
            (funcall assert (js-call heap :keyEqual named another))
            (js-call assert :equal (read-num heap "apply-one" (js-array named four)) 4)
            (js-call assert :equal (read-num heap "from-slot" (js-array pair)) 37)
            (finish heap (js-array four pair increment current items named another)))))))

  (test "dynamic calls capture callees before arguments and evaluate extras before noncallable failure"
    (lambda ()
      (js-call assert :equal (js-call javascript :callee_order) 1)
      (let ((reference-marker (js-array false)))
        (js-call assert :throws
          (lambda () (js-call javascript :invoke_order false reference-marker))
          globalThis.TypeError)
        (js-call assert :deepEqual reference-marker (js-array 2)))
      (let* ((heap (instance))
             (identity (js-call heap :invoke "named-value"))
             (marker (js-call heap :sourceArray (js-array false))))
        (js-call assert :equal (read-num heap "callee-order") 1)
        (js-call assert :equal (read-num heap "apply-extra" (js-array identity marker)) 7)
        (let ((effect (js-call heap :get marker 0)))
          (try
            (js-call assert :equal (js-call heap :readNumber effect) 9)
            (finally (js-call heap :release effect))))
        (let ((missing (js-call heap :invoke "apply-zero" (js-array identity))))
          (js-call assert :equal missing undefined))
        (let ((rejected (js-array nil undefined false t -0.0 0
                                  (get globalThis.Number :NaN)
                                  (get globalThis.Number :POSITIVE_INFINITY)
                                  "" "中😀" (js-array) (js-object))))
          (js-call rejected :forEach
            (lambda (value)
              (let ((reference-trace (js-array false)))
                (js-call assert :throws
                  (lambda () (js-call javascript :invoke_order value reference-trace))
                  globalThis.TypeError)
                (js-call assert :deepEqual reference-trace (js-array 2)))
              (let ((input (cond
                             ((= (value-type value) "number") (js-call heap :number value))
                             ((= (value-type value) "string") (js-call heap :string value))
                             ((Array/isArray value) (js-call heap :sourceArray (js-array)))
                             ((and (not (nil? value)) (= (value-type value) "object"))
                              (js-call heap :sourceObject (js-object)))
                             (t value))))
                (try
                  (js-call assert :throws
                    (lambda () (js-call heap :invoke "invoke-order" (js-array input marker)))
                    (lambda (error)
                      (let ((diag (get error :eliscriptDiagnostic)))
                        (and (funcall js-instanceof error globalThis.TypeError)
                             (not (nullish? diag))
                             (= (get diag :code) "ELI-RT0003")))))
                  (let ((failed-effect (js-call heap :get marker 0)))
                    (try
                      (js-call assert :equal (js-call heap :readNumber failed-effect) 2)
                      (finally (js-call heap :release failed-effect))))
                  (js-call heap :collect)
                  (js-call assert :equal (get (js-call heap :stats) :frameDepth) 0)
                  (js-call assert :equal (js-call heap :invoke "apply-zero" (js-array identity)) undefined)
                  (finally (js-call heap :release input)))))))
        (finish heap (js-array identity marker)))))

  (defun indirect-program ()
    (let* ((mk-local (lambda (index) (js-object :kind "local" :type "u32" :children (js-array) :value index)))
           (mk-lit (lambda (value) (js-object :kind "literal" :type "u32" :children (js-array) :value value)))
           (mk-fn (lambda (name index arity body)
                    (js-object
                      :name name :index index :arity arity
                      :locals (globalThis.Array.from (js-object :length arity)
                                (lambda (_ idx) (js-object :name (str "p" idx) :index idx :type "u32")))
                      :body body))))
      (js-object
        :abi "memory-u32"
        :filename "indirect.eli"
        :exports (js-array "dispatch" "mismatch")
        :table (js-array 1 0)
        :functions (js-array
                     (funcall mk-fn "identity" 0 1 (funcall mk-local 0))
                     (funcall mk-fn "increment" 1 1
                       (js-object :kind "int-add" :type "u32" :value nil
                                  :children (js-array (funcall mk-local 0) (funcall mk-lit 1))))
                     (funcall mk-fn "dispatch" 2 2
                       (js-object :kind "call-indirect" :type "u32" :value 1
                                  :children (js-array (funcall mk-local 1) (funcall mk-local 0))))
                     (funcall mk-fn "mismatch" 3 1
                       (js-object :kind "call-indirect" :type "u32" :value 2
                                  :children (js-array (funcall mk-lit 11) (funcall mk-lit 22) (funcall mk-local 0))))))))

  (test "typed WASM indirect calls select actual table entries and retain engine type and bounds traps"
    (lambda ()
      (let* ((prog (indirect-program))
             (bytes (globalThis.Uint8Array.from (js-call (get backends :wasm) :emit_typed_memory_wasm prog)))
             (_ (funcall assert (js-call globalThis.WebAssembly :validate bytes)))
             (mod (new globalThis.WebAssembly.Module bytes)))
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports mod) (js-array))
        (let ((e (get (new globalThis.WebAssembly.Instance mod) :exports)))
          (js-call assert :equal (js-call e :dispatch 0 41) 42)
          (js-call assert :equal (js-call e :dispatch 1 41) 41)
          (js-call assert :equal (js-call e :dispatch 0 4294967295) 0)
          (js-call assert :throws (lambda () (js-call e :dispatch 2 0)) globalThis.WebAssembly.RuntimeError)
          (js-call assert :throws (lambda () (js-call e :dispatch 4294967295 0)) globalThis.WebAssembly.RuntimeError)
          (js-call assert :throws (lambda () (js-call e :mismatch 0)) globalThis.WebAssembly.RuntimeError)))))

  (test "typed WASM indirect calls reject missing tables, invalid entries and inconsistent call shapes"
    (lambda ()
      (js-call (js-array
                 (lambda (p) (Reflect/deleteProperty p "table"))
                 (lambda (p) (put p :table (js-array -1)))
                 (lambda (p) (put p :table (js-array 999)))
                 (lambda (p) (js-call (get (get (aref (get p :functions) 2) :body) :children) :pop))
                 (lambda (p) (put (get (aref (get p :functions) 2) :body) :value 7)))
        :forEach
        (lambda (mutate)
          (let ((prog (indirect-program)))
            (funcall mutate prog)
            (js-call assert :throws
              (lambda () (js-call (get backends :wasm) :emit_typed_memory_wasm prog))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (and (not (nullish? diag)) (= (get diag :code) "ELI-B0001"))))))))))

  (defun raw-callable-heap (&rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)))
    (let* ((opts (if (undefined? options) (js-object) options))
           (max-bytes (let ((mb (get opts :maxBytes))) (if (nullish? mb) 32768 mb)))
           (names (js-array "value-cell-new" "value-cell-get" "value-cell-set"
                            "value-function-new" "value-function-named" "value-function-code"
                            "value-function-capture-get" "value-function-capture-set"))
           (prog (globalThis.structuredClone runtime)))
      (js-call (get prog :body) :push
        (js-object :kind "export-declaration" :value nil
                   :children (js-call names :map
                               (lambda (value) (js-object :kind "reference" :value value :children (js-array))))))
      (let* ((bytes (globalThis.Uint8Array.from (js-call (get backends :wasm) :emit_memory_wasm prog)))
             (mod (new globalThis.WebAssembly.Module bytes))
             (_ (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports mod) (js-array)))
             (e (get (new globalThis.WebAssembly.Instance mod) :exports))
             (heap (funcall (get e "heap-new") 128 4096 max-bytes))
             (call (lambda (name &rest args)
                     (let ((result (funcall to-uint32
                                     (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)))))
                       (js-call assert :equal (funcall (get e "last-error")) 0 name)
                       result))))
        (funcall call "heap-auto" 1)
        (js-object :e e :heap heap :call call :bytes bytes)))))

  (test "callable heap cells retain cycles and exact captures through forced GC and pool growth"
    (lambda ()
      (let* ((raw (raw-callable-heap))
             (e (get raw :e))
             (heap (get raw :heap))
             (call (get raw :call))
             (cell (funcall call "value-cell-new" 2))
             (_cell-root (funcall call "heap-pin" cell))
             (closure (funcall call "value-function-new" 7 1))
             (keep (js-array))
             (i 0))
        (funcall call "heap-pin" closure)
        (funcall call "value-function-capture-set" closure 0 cell)
        (funcall call "value-cell-set" cell closure)
        (funcall call "heap-release" cell)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "value-function-code" closure) 7)
        (while (< i 50)
          (let ((n (funcall call "value-number" i 0)))
            (funcall call "heap-pin" n)
            (js-call keep :push n))
          (setq i (1+ i)))
        (funcall assert (> (funcall call "heap-capacity") 4096))
        (js-call assert :equal (funcall call "value-function-capture-get" closure 0) cell)
        (js-call assert :equal (funcall call "value-cell-get" cell) closure)
        (funcall call "value-cell-set" cell 1)
        (js-call assert :equal (funcall call "value-cell-get" cell) 1)
        (js-call keep :forEach (lambda (n) (funcall call "heap-release" n)))
        (funcall call "heap-release" closure)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)
        (js-call assert :equal (funcall call "frame-depth") 0)
        (funcall (get e "value-function-code") heap closure)
        (js-call assert :equal (funcall (get e "last-error")) 1)
        (funcall (get e "value-cell-get") heap cell)
        (js-call assert :equal (funcall (get e "last-error")) 1)
        (funcall (get e "value-function-code") heap 1)
        (js-call assert :equal (funcall (get e "last-error")) 3))))

  (test "named callable identities are shared only while alive and fresh functions stay distinct"
    (lambda ()
      (let* ((raw (raw-callable-heap))
             (call (get raw :call))
             (a (funcall call "value-function-named" 11)))
        (funcall call "heap-pin" a)
        (js-call assert :equal (funcall call "value-function-named" 11) a)
        (let ((b (funcall call "value-function-new" 11 0)))
          (funcall call "heap-pin" b)
          (js-call assert :notEqual a b)
          (js-call assert :equal (funcall call "value-key-equal" a b) 0)
          (js-call assert :equal (funcall call "value-key-equal" a a) 1)
          (let ((h (funcall call "value-key-hash" a)))
            (funcall call "heap-collect")
            (js-call assert :equal (funcall call "value-key-hash" a) h))
          (funcall call "heap-release" a)
          (funcall call "heap-release" b)
          (funcall call "heap-collect")
          (js-call assert :equal (funcall call "heap-live") 0)
          (let ((c (funcall call "value-function-named" 11)))
            (funcall call "heap-pin" c)
            (js-call assert :notEqual c a)
            (funcall call "heap-release" c)
            (funcall call "heap-collect")
            (js-call assert :equal (funcall call "heap-live") 0))))))

  (test "callable heap capacity failure preserves captures and returns temporary borrowed roots"
    (lambda ()
      (let* ((raw (raw-callable-heap (js-object :maxBytes 4096)))
             (e (get raw :e))
             (heap (get raw :heap))
             (call (get raw :call))
             (cell (funcall call "value-cell-new" 0))
             (_cell-root (funcall call "heap-pin" cell))
             (closure (funcall call "value-function-new" 3 1))
             (keep (js-array))
             (exhausted false)
             (i 0))
        (funcall call "heap-pin" closure)
        (funcall call "value-function-capture-set" closure 0 cell)
        (funcall call "value-cell-set" cell closure)
        (funcall call "heap-release" cell)
        (while (and (< i 128) (not exhausted))
          (let ((n (funcall to-uint32 (funcall (get e "value-number") heap i 0))))
            (if (= n 0)
              (progn
                (js-call assert :equal (funcall (get e "last-error")) 2)
                (setq exhausted t))
              (progn
                (funcall call "heap-pin" n)
                (js-call keep :push n))))
          (setq i (1+ i)))
        (funcall assert exhausted)
        (js-call assert :equal (funcall (get e "value-cell-new") heap closure) 0)
        (js-call assert :equal (funcall (get e "last-error")) 2)
        (js-call assert :equal (funcall call "value-function-capture-get" closure 0) cell)
        (js-call assert :equal (funcall call "value-cell-get" cell) closure)
        (funcall (get e "value-function-capture-get") heap closure 1)
        (js-call assert :equal (funcall (get e "last-error")) 3)
        (funcall (get e "value-function-capture-set") heap closure 0 closure)
        (js-call assert :equal (funcall (get e "last-error")) 1)
        (js-call assert :equal (funcall call "value-function-capture-get" closure 0) cell)
        (js-call keep :forEach (lambda (n) (funcall call "heap-release" n)))
        (funcall call "heap-release" closure)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)
        (js-call assert :equal (funcall call "frame-depth") 0))))

  (test "Node executes the same indirect-call and callable-heap artifacts with exact cleanup"
    (async ()
      (let* ((raw (raw-callable-heap))
             (bytes (get raw :bytes))
             (heap-file (resolve directory "callable-heap.wasm"))
             (table-file (resolve directory "callable-table.wasm"))
             (node-cmd (let ((nv (get (get globalThis.process :env) :NODE)))
                         (if (nullish? nv) "node" nv))))
        (await (writeFile heap-file bytes))
        (await (writeFile table-file
                 (globalThis.Uint8Array.from
                   (js-call (get backends :wasm) :emit_typed_memory_wasm (indirect-program)))))
        (let ((node (spawnSync node-cmd
                      (js-array callables-node-helper-path "--check-raw" heap-file table-file)
                      (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get node :status) 0
            (let ((err-txt (get node :stderr)))
              (if (> (get err-txt :length) 0) err-txt (globalThis.String (get node :error)))))))))

  (test "discarded indirect results retain call traps and programs without indirect calls need no table"
    (lambda ()
      (let* ((prog (indirect-program))
             (original (get (aref (get prog :functions) 2) :body)))
        (put (aref (get prog :functions) 2) :body
          (js-object :kind "sequence" :type "u32" :value nil
                     :children (js-array original
                                         (js-object :kind "literal" :type "u32" :children (js-array) :value 99))))
        (let ((e (get (new globalThis.WebAssembly.Instance
                        (new globalThis.WebAssembly.Module
                          (globalThis.Uint8Array.from
                            (js-call (get backends :wasm) :emit_typed_memory_wasm prog))))
                      :exports)))
          (js-call assert :equal (js-call e :dispatch 0 41) 99)
          (js-call assert :throws (lambda () (js-call e :dispatch 2 41)) globalThis.WebAssembly.RuntimeError)))
      (let ((plain (indirect-program)))
        (Reflect/deleteProperty plain "table")
        (js-call (get plain :functions) :splice 2)
        (put plain :exports (js-array "identity"))
        (let ((bytes (globalThis.Uint8Array.from (js-call (get backends :wasm) :emit_typed_memory_wasm plain)))
              (sections (js-array))
              (cursor 8))
          (while (< cursor (get bytes :length))
            (let ((id (aref bytes cursor))
                  (len 0)
                  (shift 0)
                  (more t))
              (setq cursor (1+ cursor))
              (while more
                (let ((b (aref bytes cursor)))
                  (setq cursor (1+ cursor))
                  (setq len (+ len (* (funcall bit-and b 127) (Math/pow 2 shift))))
                  (setq shift (+ shift 7))
                  (when (= (funcall bit-and b 128) 0)
                    (setq more false))))
              (js-call sections :push id)
              (setq cursor (+ cursor len))))
          (funcall assert (not (js-call sections :includes 4)))
          (funcall assert (not (js-call sections :includes 9)))
          (js-call assert :equal
            (js-call (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports)
                     :identity 17)
            17)))))

  (test "captured unrooted Numbers preserve IEEE words across allocation safepoints and pool movement"
    (lambda ()
      (let* ((raw (raw-callable-heap))
             (e (get raw :e))
             (call (get raw :call))
             (patterns (js-array (js-array 0 0) (js-array 0 2147483648) (js-array 0 2146435072)
                                 (js-array 0 4293918720) (js-array 1 2146959360) (js-array 1 0)
                                 (js-array 4294967295 1048575) (js-array 0 1048576)
                                 (js-array 4294967295 2146435071)))
             (seed 1671926255)
             (next-word (lambda ()
                          (setq seed (funcall to-uint32 (+ (Math/imul seed 1664525) 1013904223)))
                          seed))
             (i 0))
        (while (< i 32)
          (js-call patterns :push (js-array (funcall next-word) (funcall next-word)))
          (setq i (1+ i)))
        (let ((cells (js-array)))
          (js-call patterns :forEach
            (lambda (pair)
              (let ((value (funcall call "value-number" (aref pair 0) (aref pair 1))))
                ;; The Number has no host pin. Cell construction must protect this borrowed
                ;; operand before its own allocation triggers collection.
                (let ((cell (funcall call "value-cell-new" value)))
                  (funcall call "heap-pin" cell)
                  (js-call cells :push cell)))))
          (funcall assert (> (funcall call "heap-capacity") 4096))
          (funcall call "heap-collect")
          (let ((j 0))
            (while (< j (get cells :length))
              (let* ((value (funcall call "value-cell-get" (aref cells j)))
                     (offset (funcall call "value-data" value 4))
                     (view (new globalThis.DataView (get (get e :memory) :buffer)))
                     (pat (aref patterns j)))
                (js-call assert :equal (js-call view :getUint32 offset t) (aref pat 0))
                (js-call assert :equal (js-call view :getUint32 (+ offset 4) t) (aref pat 1)))
              (setq j (1+ j))))
          (js-call cells :forEach (lambda (cell) (funcall call "heap-release" cell)))
          (funcall call "heap-collect")
          (js-call assert :equal (funcall call "heap-live") 0)
          (js-call assert :equal (funcall call "frame-depth") 0)))))

  (test "source shared cells preserve exact Numbers under repeated writes, alias reads and collection"
    (lambda ()
      (let* ((heap (instance))
             (initial (js-call heap :number 4))
             (pair (js-call heap :invoke "make-box" (js-array initial)))
             (write (js-call heap :get pair 0))
             (read (js-call heap :get pair 1))
             (reference (js-call javascript :make_box 4))
             (values (js-array -0.0 0
                               (get globalThis.Number :NaN)
                               (get globalThis.Number :POSITIVE_INFINITY)
                               (get globalThis.Number :NEGATIVE_INFINITY)
                               (get globalThis.Number :MIN_VALUE)
                               (- 0 (get globalThis.Number :MIN_VALUE))
                               (get globalThis.Number :MAX_VALUE)))
             (seed 1096782605)
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (i 0))
        (while (< i 192)
          (setq seed (funcall to-uint32 (+ (Math/imul seed 1664525) 1013904223)))
          (js-call bits :setUint32 0 seed t)
          (setq seed (funcall to-uint32 (+ (Math/imul seed 1664525) 1013904223)))
          (js-call bits :setUint32 4 seed t)
          (js-call values :push (js-call bits :getFloat64 0 t))
          (setq i (1+ i)))
        (js-call values :forEach
          (lambda (value)
            (let* ((input (js-call heap :number value))
                   (output (js-call heap :invoke "apply-one" (js-array write input))))
              (funcall assert (Object/is (js-call heap :readNumber output) (funcall (aref reference 0) value)))
              (funcall assert (js-call heap :keyEqual input output))
              (js-call heap :release input)
              (js-call heap :release output)
              (js-call heap :collect)
              (funcall assert (Object/is (read-num heap "apply-zero" (js-array read)) (funcall (aref reference 1)))))))
        (finish heap (js-array initial pair write read)))))

  (test "failed closure calls preserve shared state, first-error order and caller-owned frames"
    (lambda ()
      (let ((marker-reference (js-array false))
            (reference (js-call javascript :guarded_box 4)))
        (js-call assert :throws (lambda () (funcall (aref reference 0) false marker-reference)) globalThis.TypeError)
        (js-call assert :equal (funcall (aref reference 1)) 4)
        (js-call assert :equal (aref marker-reference 0) 7))
      (let* ((heap (instance))
             (four (js-call heap :number 4))
             (pair (js-call heap :invoke "guarded-box" (js-array four)))
             (write (js-call heap :get pair 0))
             (read (js-call heap :get pair 1))
             (marker (js-call heap :sourceArray (js-array false)))
             (frame (js-call heap :frame 1)))
        (js-call heap :frameSet frame 0 marker)
        (js-call assert :throws
          (lambda () (js-call heap :invoke "apply-two" (js-array write false marker)))
          (lambda (e)
            (let ((diag (get e :eliscriptDiagnostic)))
              (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0003")))))
        (js-call assert :equal (get (js-call heap :stats) :frameDepth) 1)
        (js-call assert :equal (read-num heap "apply-zero" (js-array read)) 4)
        (let ((changed (js-call heap :get marker 0)))
          (js-call assert :equal (js-call heap :readNumber changed) 7)
          (js-call heap :release changed))
        (let ((identity (js-call heap :invoke "named-value"))
              (untouched (js-call heap :sourceArray (js-array false))))
          (js-call assert :throws
            (lambda () (js-call javascript :earlier_failure (lambda (x) x) (js-array false)))
            globalThis.TypeError)
          (js-call assert :throws
            (lambda () (js-call heap :invoke "earlier-failure" (js-array identity untouched)))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0003")))))
          (js-call assert :equal (js-call heap :get untouched 0) false)
          (js-call assert :equal (get (js-call heap :stats) :frameDepth) 1)
          (let ((alias (js-call heap :frameGet frame 0)))
            (funcall assert (js-call heap :keyEqual alias marker))
            (js-call heap :release alias))
          (js-call heap :leaveFrame frame)
          (finish heap (js-array four pair write read marker identity untouched))))))

