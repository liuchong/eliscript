          (funcall assert (< (js-call heap :readNumber last) 10000))
          (js-call heap :release last))
        (js-call assert :equal (read-num heap "apply-one" (js-array adder five)) 9)
        (js-call heap :leaveFrame frame)
        (finish heap (js-array marker n four five adder)))))

  (test "a real trap inside a captured read unwinds dynamic callers and retains preexisting roots"
    (async ()
