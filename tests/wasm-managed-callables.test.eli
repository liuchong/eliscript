          (let ((alias (js-call heap :frameGet frame 0)))
            (js-call assert :equal (js-call heap :readNumber alias) 4)
            (js-call heap :release alias))
          (js-call heap :leaveFrame frame)
          (finish heap (js-array four five f))))))

  (test "unsupported callable forms are source-bound refusals even in dead code and leave input IR untouched"
    (async ()
      (let* ((before (JSON/stringify program))
             (runtime-before (JSON/stringify runtime))
             (dead (js-call (get backends :compiler) :compile_ir_string
                     "(defun f (x) (if false (lambda () x) x)) (export f)" "dead-supported-lambda.eli"))
             (heap (instantiateManagedRuntime
                     (globalThis.Uint8Array.from
                       (js-call (get backends :managed) :emit_managed_wasm dead runtime))))
             (input (js-call heap :number 4))
             (output (js-call heap :invoke "f" (js-array input))))
        (js-call assert :equal (js-call heap :readNumber output) 4)
        (finish heap (js-array input output))
        (js-call (get backends :managed) :emit_managed_wasm program runtime)
        (js-call assert :equal (JSON/stringify program) before)
        (js-call assert :equal (JSON/stringify runtime) runtime-before)
        (let* ((supported (js-call (get backends :compiler) :compile_ir_string
                            "(defun f () (if false (async () 1) 0)) (export f)" "supported-async-callable.eli"))
               (supported-before (JSON/stringify supported))
               (supported-bytes (globalThis.Uint8Array.from
                                  (js-call (get backends :managed) :emit_managed_wasm supported runtime))))
          (js-call assert :deepEqual
            (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module supported-bytes))
            (js-array))
          (let ((supported-heap (instantiateManagedRuntime supported-bytes)))
            (js-call supported-heap :auto 1)
            (let ((supported-result (js-call supported-heap :invoke "f" (js-array))))
              (js-call assert :equal (js-call supported-heap :readNumber supported-result) 0)
              (js-call supported-heap :release supported-result)
              (js-call supported-heap :collect)
              (js-call assert :equal (js-call supported-heap :live) 0)))
          (js-call assert :equal (JSON/stringify supported) supported-before))
        (let* ((shadowed-source "(defun f () (let ((globalThis nil)) (lambda () (new globalThis.Map)))) (defun call-closure (fn) (funcall fn)) (export f call-closure)")
               (shadowed (js-call (get backends :compiler) :compile_ir_string shadowed-source "shadowed-constructor.eli"))
               (shadowed-before (JSON/stringify shadowed))
               (shadowed-reference (js-call (get backends :compiler) :emit_ir_string shadowed))
               (shadowed-bytes (globalThis.Uint8Array.from
                                 (js-call (get backends :managed) :emit_managed_wasm shadowed runtime))))
          (js-call assert :deepEqual
            (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module shadowed-bytes))
            (js-array))
          (let ((shadowed-heap (instantiateManagedRuntime shadowed-bytes)))
            (js-call shadowed-heap :auto 1)
            (let ((closure (js-call shadowed-heap :invoke "f" (js-array))))
              (js-call assert :throws
                (lambda () (js-call shadowed-heap :invoke "call-closure" (js-array closure)))
                (lambda (error)
                  (let ((diag (get error :eliscriptDiagnostic)))
                    (and (funcall js-instanceof error globalThis.TypeError)
                         (not (nullish? diag))
                         (= (get diag :code) "ELI-RT0001")))))
              (js-call shadowed-heap :release closure)
              (js-call shadowed-heap :collect)
              (js-call assert :equal (js-call shadowed-heap :live) 0)))
          (js-call assert :equal (JSON/stringify shadowed) shadowed-before)
          (let ((reference (spawnSync "node"
                             (js-array callables-node-helper-path "--check-shadowed")
                             (js-object :input shadowed-reference :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get reference :status) 0 (get reference :stderr))))
        (let ((pattern-sources (js-array "(defun f () (lambda ([x]) x))"
                                         "(defun f () (lambda (&optional [x]) x))"))
              (ps-idx 0))
          (while (< ps-idx (get pattern-sources :length))
            ;; These original inputs now belong to the implemented parameter-pattern
            ;; profile. Preserve both sources and prove their real callable behavior.
            (let* ((src (aref pattern-sources ps-idx))
                   (ir (js-call (get backends :compiler) :compile_ir_string
                         (str src " (defun call-pattern (fn value) (funcall fn value)) (export f call-pattern)")
                         "supported-callable-pattern.eli"))
                   (saved (JSON/stringify ir))
                   (bytes (globalThis.Uint8Array.from
                            (js-call (get backends :managed) :emit_managed_wasm ir runtime))))
              (js-call assert :deepEqual
                (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
                (js-array))
              (js-call assert :equal (JSON/stringify ir) saved)
              (let* ((js (await (funcall dynamic-import
                                  (str "data:text/javascript;base64,"
                                       (js-call (Buffer/from (js-call (get backends :compiler) :emit_ir_string ir))
                                                :toString "base64")))))
                     (a (instantiateManagedRuntime bytes))
                     (_ (js-call a :auto 1))
                     (fn (js-call a :invoke "f"))
                     (expected (js-call js :f)))
                (try
                  (js-call (js-array -0.0 37 undefined nil false) :forEach
                    (lambda (value)
                      (let ((element (if (= (value-type value) "number") (js-call a :number value) value))
                            (result undefined))
                        (let ((input (js-call a :sourceArray (js-array element))))
                          (try
                            (js-call a :collect)
                            (setq result (js-call a :invoke "call-pattern" (js-array fn input)))
                            (let ((actual (if (and (not (nullish? result)) (= (get result :kind) 4))
                                            (js-call a :readNumber result)
                                            result)))
                              (funcall assert (Object/is actual (funcall expected (js-array value)))
                                "the original pattern source retains the exact JS value under GC"))
                            (finally
                              (js-call a :release result)
                              (js-call a :release input)
                              (js-call a :release element))))
                        (js-call a :collect)
                        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
                  (finally
                    (js-call a :release fn)
                    (js-call a :closeModule)
                    (finish a (js-array)))))
              (js-call assert :equal (JSON/stringify ir) saved))
            (setq ps-idx (1+ ps-idx))))
        (js-call (js-array "(defun f (g) (apply g (js* \"[]\")))") :forEach
          (lambda (src)
            (let* ((ir (js-call (get backends :compiler) :compile_ir_string
                         (str src " (export f)") "unsupported-callable.eli"))
                   (saved (JSON/stringify ir)))
              (js-call assert :throws
                (lambda () (js-call (get backends :managed) :emit_managed_wasm ir runtime))
                (lambda (e)
                  (let ((diag (get e :eliscriptDiagnostic)))
                    (and (not (nullish? diag))
                         (= (get diag :code) "ELI-B0001")
                         (= (get (get diag :location) :file) "unsupported-callable.eli"))))
                src)
              (js-call assert :equal (JSON/stringify ir) saved)))))))

  (test "local and captured host constructors preserve real lookup argument order and GC in standalone and linked WASM"
    (async ()
      (let* ((body (str "(new globalThis.Map\n"
                        "    (progn (put trace 1 (aref trace 0))\n"
                        "      (Object/defineProperty globalThis \"Map\" (js-object :value false :configurable t)) undefined)\n"
                        "    (put trace 2 (1+ (aref trace 2))))"))
             (source (str "(defun makehost (trace)\n"
                          "    (let ((host (js-object)) (constructor (js* \"Map\")))\n"
                          "      (Object/defineProperty host \"Map\" (js-object :configurable t\n"
                          "        :get (lambda () (put trace 0 (1+ (aref trace 0))) constructor))) host))\n"
                          "    (defun throwhost (trace)\n"
                          "      (Object/defineProperty (js-object) \"Map\" (js-object :configurable t\n"
                          "        :get (lambda () (put trace 0 1) (throw false)))))\n"
                          "    (defun localnew (globalThis trace) " body ")\n"
                          "    (defun capturenew (globalThis trace) (lambda () " body "))\n"
                          "    (defun invokeclosure (closure) (funcall closure))\n"
                          "    (defun mapsize (map) (get map :size))\n"
                          "    (export makehost throwhost localnew capturenew invokeclosure mapsize)"))
             (ir (js-call (get backends :compiler) :compile_ir_string source "local-constructors.eli"))
             (saved (JSON/stringify ir))
             (reference (await (funcall dynamic-import
                                 (str "data:text/javascript;base64,"
                                      (js-call (Buffer/from (js-call (get backends :compiler) :emit_ir_string ir))
                                               :toString "base64"))))))
        (js-call (js-array false t) :forEach
          (lambda (linked)
            (let* ((bytes (globalThis.Uint8Array.from
                            (if linked
                              (js-call (get backends :managed) :emit_managed_project_wasm
                                (js-array (js-object :id "constructors.mjs" :program ir))
                                "constructors.mjs" runtime)
                              (js-call (get backends :managed) :emit_managed_wasm ir runtime))))
                   (_1 (js-call assert :deepEqual
                         (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
                         (js-array)))
                   (_2 (js-call assert :equal (JSON/stringify ir) saved))
                   (heap (instantiateManagedRuntime bytes))
                   (_3 (js-call heap :auto 1))
                   (held (js-array))
                   (own (lambda (value) (js-call held :push value) value))
                   (make-trace (lambda ()
                                 (let ((zero (js-call heap :number 0)))
                                   (try
                                     (funcall own (js-call heap :sourceArray (js-array zero zero zero)))
                                     (finally (js-call heap :release zero))))))
                   (trace-values (lambda (tr)
                                   (globalThis.Array.from (js-object :length (js-call heap :length tr))
                                     (lambda (_ index)
                                       (let ((value (js-call heap :get tr index)))
                                         (try
                                           (js-call heap :readNumber value)
                                           (finally (js-call heap :release value)))))))))
              (try
                (js-call (js-array false t) :forEach
                  (lambda (captured)
                    (let* ((trace (funcall make-trace))
                           (host (funcall own (js-call heap :invoke "makehost" (js-array trace))))
                           (expected-trace (js-array 0 0 0))
                           (expected-host (js-call reference :makehost expected-trace))
                           (closure (if captured
                                      (funcall own (js-call heap :invoke "capturenew" (js-array host trace)))
                                      undefined))
                           (expected-call (if captured
                                            (js-call reference :capturenew expected-host expected-trace)
                                            (lambda () (js-call reference :localnew expected-host expected-trace))))
                           (call (lambda ()
                                   (if captured
                                     (js-call heap :invoke "invokeclosure" (js-array closure))
                                     (js-call heap :invoke "localnew" (js-array host trace))))))
                      (js-call heap :collect)
                      (let ((expected (funcall expected-call))
                            (mp (funcall own (funcall call))))
                        (js-call assert :equal (read-num heap "mapsize" (js-array mp)) (get expected :size))
                        (js-call assert :deepEqual (funcall trace-values trace) expected-trace)
                        (js-call assert :deepEqual expected-trace (js-array 1 1 1))
                        ;; The callee was captured before the first argument replaced its
                        ;; property. A later call observes false, after evaluating both args.
                        (js-call assert :throws expected-call globalThis.TypeError)
                        (js-call assert :throws call globalThis.TypeError)
                        (js-call assert :deepEqual (funcall trace-values trace) expected-trace)
                        (js-call assert :deepEqual expected-trace (js-array 1 1 2))
                        (js-call heap :collect)
                        (js-call assert :equal (read-num heap "mapsize" (js-array mp)) 0))
                      (let* ((empty (funcall make-trace))
                             (expected-empty (js-array 0 0 0))
                             (missing (if captured
                                        (funcall own (js-call heap :invoke "capturenew" (js-array nil empty)))
                                        undefined)))
                        (js-call heap :collect)
                        (js-call assert :throws
                          (lambda ()
                            (if captured
                              (js-call heap :invoke "invokeclosure" (js-array missing))
                              (js-call heap :invoke "localnew" (js-array nil empty))))
                          (lambda (error)
                            (let ((diag (get error :eliscriptDiagnostic)))
                              (and (funcall js-instanceof error globalThis.TypeError)
                                   (not (nullish? diag))
                                   (= (get diag :code) "ELI-RT0001")))))
                        (js-call assert :throws
                          (lambda ()
                            (if captured
                              (funcall (js-call reference :capturenew nil expected-empty))
                              (js-call reference :localnew nil expected-empty)))
                          globalThis.TypeError)
                        (js-call assert :deepEqual (funcall trace-values empty) expected-empty)
                        (js-call assert :deepEqual expected-empty (js-array 0 0 0)))
                      (let* ((thrown-trace (funcall make-trace))
                             (throwing (funcall own (js-call heap :invoke "throwhost" (js-array thrown-trace))))
                             (throwing-closure (if captured
                                                 (funcall own (js-call heap :invoke "capturenew"
                                                                (js-array throwing thrown-trace)))
                                                 undefined))
                             (threw false))
                        (try
                          (if captured
                            (js-call heap :invoke "invokeclosure" (js-array throwing-closure))
                            (js-call heap :invoke "localnew" (js-array throwing thrown-trace)))
                          (catch error
                            (setq threw t)
                            (js-call assert :strictEqual error false)))
                        (funcall assert threw)
                        (js-call assert :deepEqual (funcall trace-values thrown-trace) (js-array 1 0 0))
                        (let ((js-trace (js-array 0 0 0))
                              (js-threw false))
                          (let ((js-host (js-call reference :throwhost js-trace)))
                            (try
                              (if captured
                                (funcall (js-call reference :capturenew js-host js-trace))
                                (js-call reference :localnew js-host js-trace))
                              (catch error
                                (setq js-threw t)
                                (js-call assert :strictEqual error false))))
                          (funcall assert js-threw)
                          (js-call assert :deepEqual (funcall trace-values thrown-trace) js-trace))
                        (js-call heap :collect)
                        (js-call assert :equal (get (js-call heap :stats) :frameDepth) 0)))))
                (finally
                  (js-call held :forEach (lambda (value) (js-call heap :release value)))
                  (js-call heap :closeModule)
                  (finish heap (js-array)))))))))
    30000)

  (test "parallel and sequential captures preserve shadowing and hygiene of internal ABI names"
    (lambda ()
      (let* ((heap (instance))
             (four (js-call heap :number 4))
             (five (js-call heap :number 5))
             (f (js-call heap :invoke "parallel-capture" (js-array four))))
        (js-call assert :equal (read-num heap "apply-zero" (js-array f)) (funcall (js-call javascript :parallel_capture 4)))
        (let* ((pair (js-call heap :invoke "sequential-captures" (js-array four)))
               (old (js-call heap :get pair 0))
               (next (js-call heap :get pair 1))
               (reference (js-call javascript :sequential_captures 4)))
          (js-call assert :equal (read-num heap "apply-zero" (js-array old)) (funcall (aref reference 0)))
          (js-call assert :equal (read-num heap "apply-zero" (js-array next)) (funcall (aref reference 1)))
          (let ((hygienic (js-call heap :invoke "hygienic-capture" (js-array four five four five four))))
            (js-call assert :equal
              (read-num heap "apply-zero" (js-array hygienic))
              (funcall (js-call javascript :hygienic_capture 4 5 4 5 4)))
            (finish heap (js-array four five f pair old next hygienic)))))))

  (test "uniform dynamic ABI preserves many required parameters for both named and lifted functions"
    (lambda ()
      (let* ((heap (instance))
             (named (js-call heap :invoke "many-value"))
             (lam (js-call heap :invoke "many-lambda"))
             (marker (js-call heap :sourceArray (js-array false))))
        (js-call (js-array named lam) :forEach
          (lambda (f)
            (js-call assert :equal
              (read-num heap "many-extra" (js-array f marker))
              (js-call javascript :many_extra (get javascript :many) (js-array false)))
            (funcall assert (Number/isNaN (read-num heap "apply-zero" (js-array f))))
            (let ((effect (js-call heap :get marker 0)))
              (js-call assert :equal (js-call heap :readNumber effect) 123)
              (js-call heap :release effect)
              (js-call heap :collect))))
        (finish heap (js-array named lam marker)))))

  (test "Node executes source closures, shared writes and failure cleanup against independent generated JS"
    (async ()
      (let* ((wasm (resolve directory "source-callables.wasm"))
             (js (resolve directory "source-callables.mjs"))
             (node-cmd (let ((nv (get (get globalThis.process :env) :NODE)))
                         (if (nullish? nv) "node" nv))))
        (await (writeFile wasm
                 (globalThis.Uint8Array.from
                   (js-call (get backends :managed) :emit_managed_wasm program runtime))))
        (await (writeFile js (js-call (get backends :compiler) :emit_ir_string program)))
        (let ((result (spawnSync node-cmd
                        (js-array callables-node-helper-path "--check-source"
                                  wasm (get (pathToFileURL js) :href))
                        (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get result :status) 0
            (let ((err-txt (get result :stderr)))
              (if (> (get err-txt :length) 0) err-txt (globalThis.String (get result :error)))))))))

  (test "captured opaque values retain alias identity and source cycles collect without permanent roots"
    (lambda ()
      (let* ((heap (instance))
             (pair (js-call heap :invoke "make-box" (js-array false)))
             (write (js-call heap :get pair 0))
             (read (js-call heap :get pair 1))
             (text (js-call heap :string (str "中😀" (String/fromCharCode 55296))))
             (bytes (js-call heap :bytes (new globalThis.Uint8Array (js-array 0 255))))
             (arr (js-call heap :sourceArray (js-array text)))
             (obj (js-call heap :sourceObject (js-object :value arr)))
             (fn (js-call heap :invoke "named-value")))
        (js-call (js-array nil false t undefined text bytes arr obj fn pair) :forEach
          (lambda (value)
            (let ((out (js-call heap :invoke "apply-one" (js-array write value))))
              (funcall assert (js-call heap :keyEqual out value))
              (js-call heap :release out)
              (js-call heap :collect))
            (let ((alias (js-call heap :invoke "apply-zero" (js-array read))))
              (funcall assert (js-call heap :keyEqual alias value))
              (js-call heap :release alias))))
        (finish heap (js-array pair write read text bytes arr obj fn)))))

  (test "foreign, forged and collected function handles cannot enter a dynamic call or disturb caller roots"
    (lambda ()
      (let* ((heap (instance))
             (other (instance))
             (foreign (js-call other :invoke "named-value"))
             (four (js-call heap :number 4))
             (frame (js-call heap :frame 1)))
        (js-call heap :frameSet frame 0 four)
        (js-call (js-array foreign (Object/freeze (js-object :kind 18))) :forEach
          (lambda (f)
            (js-call assert :throws
              (lambda () (js-call heap :invoke "apply-one" (js-array f four)))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0001")))))))
        (let ((stale (js-call heap :invoke "named-value")))
          (js-call heap :release stale)
          (js-call heap :collect)
          (js-call assert :throws
            (lambda () (js-call heap :invoke "apply-one" (js-array stale four)))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0001"))))))
        (js-call assert :equal (get (js-call heap :stats) :frameDepth) 1)
        (let ((alias (js-call heap :frameGet frame 0)))
          (js-call assert :equal (js-call heap :readNumber alias) 4)
          (js-call heap :release alias))
        (js-call heap :leaveFrame frame)
        (finish heap (js-array four))
        (finish other (js-array foreign)))))

  (test "funcall shares dynamic callee ordering, omitted arguments and required ABI with ordinary calls"
    (lambda ()
      (let* ((heap (instance))
             (four (js-call heap :number 4))
             (five (js-call heap :number 5))
             (adder (js-call heap :invoke "make-adder" (js-array four))))
        (js-call assert :equal
          (read-num heap "funcall-one" (js-array adder five))
          (js-call javascript :funcall_one (js-call javascript :make_adder 4) 5))
        (let ((identity (js-call heap :invoke "named-value"))
              (marker (js-call heap :sourceArray (js-array false))))
          (js-call assert :equal (js-call heap :invoke "funcall-zero" (js-array identity)) undefined)
          (js-call assert :throws
            (lambda () (js-call heap :invoke "funcall-order" (js-array false marker)))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0003")))))
          (let ((last (js-call heap :get marker 0)))
            (js-call assert :equal (js-call heap :readNumber last) 2)
            (js-call heap :release last))
          (finish heap (js-array four five adder identity marker))))))

  (test "malformed callable parameters cannot hide unsupported IR, duplicate bindings or invalid counts"
    (lambda ()
      (letfn ((find-fn (nodes-list)
                (let ((idx 0)
                      (found undefined))
                  (while (and (< idx (get nodes-list :length)) (undefined? found))
                    (let ((n (aref nodes-list idx)))
                      (if (= (get n :kind) "function-expression")
                        (setq found n)
                        (let* ((ch (get n :children))
                               (sub (find-fn (if (nullish? ch) (js-array) ch))))
                          (when (not (undefined? sub))
                            (setq found sub)))))
                    (setq idx (1+ idx)))
                  found)))
        (js-call (js-array
                   (lambda (n) (put (get n :properties) :parameterCount -1))
                   (lambda (n) (put (get n :properties) :parameterCount "2"))
                   (lambda (n)
                     (put (aref (get n :children) 0) :children
                       (js-array (js-object :kind "raw-javascript" :value "js*" :children (js-array)
                                            :span (Object/assign (js-object) (get (aref (get n :children) 0) :span))))))
                   (lambda (n)
                     (put (aref (get n :children) 1) :value (get (aref (get n :children) 0) :value)))
                   (lambda (n)
                     (put (aref (get n :children) 0) :value "")))
          :forEach
          (lambda (mutate)
            (let ((ir (js-call (get backends :compiler) :compile_ir_string
                        "(defun f () (lambda (x y) 7)) (export f)" "malformed-callable.eli")))
              (funcall mutate (find-fn (get ir :body)))
              (let ((saved (JSON/stringify ir)))
                (js-call assert :throws
                  (lambda () (js-call (get backends :managed) :emit_managed_wasm ir runtime))
                  (lambda (e)
                    (let ((diag (get e :eliscriptDiagnostic)))
                      (and (not (nullish? diag))
                           (= (get diag :code) "ELI-B0001")
                           (= (get (get diag :location) :file) "malformed-callable.eli")))))
                (js-call assert :equal (JSON/stringify ir) saved))))))))

  (test "a callable child without its required source span is rejected by the IR schema before backend lowering"
    (lambda ()
      (let* ((ir (js-call (get backends :compiler) :compile_ir_string
                   "(defun f () (lambda (x y) 7)) (export f)" "missing-callable-span.eli"))
             (pending (globalThis.Array.from (get ir :body)))
             (callable undefined))
        (while (and (> (get pending :length) 0) (undefined? callable))
          (let ((node (js-call pending :pop)))
            (if (= (get node :kind) "function-expression")
              (setq callable node)
              (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child))))))
        (funcall assert callable)
        (put (aref (get callable :children) 0) :children
          (js-array (js-object :kind "raw-javascript" :value "js*" :children (js-array))))
        (let ((saved (JSON/stringify ir)))
          (js-call assert :throws
            (lambda () (js-call (get backends :managed) :emit_managed_wasm ir runtime))
            (lambda (error)
              (let ((diag (get error :eliscriptDiagnostic)))
                (js-call assert :equal (if (nullish? diag) undefined (get diag :code)) "ELI-I0001")
                (js-call assert :equal (if (nullish? diag) undefined (get diag :phase)) "ir-schema")
                (js-call assert :equal (get error :message) "IR node has unknown or missing fields")
                (js-call assert :equal (get diag :message) (get error :message))
                t)))
          (js-call assert :equal (JSON/stringify ir) saved)))))

  (test "captured arguments are snapshotted before later writes replace their shared cell"
    (lambda ()
      (let* ((heap (instance))
             (four (js-call heap :number 4))
             (result (js-call heap :invoke "captured-arguments" (js-array four)))
             (first (js-call heap :get result 0))
             (second (js-call heap :get result 1))
             (reference (js-call javascript :captured_arguments 4)))
        (js-call assert :equal (js-call heap :readNumber first) (aref reference 0))
        (js-call assert :equal (js-call heap :readNumber first) 45)
        (js-call assert :equal (js-call heap :readNumber second) (aref reference 1))
        (js-call assert :equal (js-call heap :readNumber second) 5)
        (finish heap (js-array four result first second)))))

  (test "generated closure programs match an independent lexical and IEEE model across shadowing and updates"
    (lambda ()
      (let ((update (let ((u (js-object)))
                      (put u "+" (lambda (a b) (+ a b)))
                      (put u "-" (lambda (a b) (- a b)))
                      (put u "*" (lambda (a b) (* a b)))
                      (put u "/" (lambda (a b) (/ a b)))
                      u))
            (deltas (js-array 0.5 -0.0 3.25 -2
                              (get globalThis.Number :POSITIVE_INFINITY)
                              (get globalThis.Number :MIN_VALUE)
                              (get globalThis.Number :NaN)))
            (cnt 0))
        (js-call generated-closure-cases :forEach
          (lambda (item)
            (let* ((name (get item :name))
                   (sequential (get item :sequential))
                   (op (get item :op))
                   (salt (get item :salt))
                   (outer (get item :outer))
                   (bytes (get item :bytes))
                   (heap (instantiateManagedRuntime bytes))
                   (_ (js-call heap :auto 1))
                   (input (js-call heap :number outer))
                   (pair (js-call heap :invoke "make" (js-array input)))
                   (writer (js-call heap :get pair 0))
                   (reader (js-call heap :get pair 1))
                   (before (js-call heap :get pair 2))
                   (expected salt))
              (js-call deltas :forEach
                (lambda (delta)
                  (let* ((argument (js-call heap :number delta))
                         (result (js-call heap :invoke "update" (js-array writer argument))))
                    (setq expected (funcall (get update op) expected delta))
                    (funcall assert (Object/is (js-call heap :readNumber result) expected)
                      (str name " " sequential " " op " write"))
                    (js-call heap :release result)
                    (js-call heap :release argument)
                    (js-call heap :collect)
                    (js-call (js-array (js-array reader expected)
                                       (js-array before (if sequential expected outer)))
                      :forEach
                      (lambda (check-pair)
                        (let ((f (aref check-pair 0))
                              (val (aref check-pair 1))
                              (out (js-call heap :invoke "read" (js-array (aref check-pair 0)))))
                          (funcall assert (Object/is (js-call heap :readNumber out) val)
                            (str name " " sequential " " op " read"))
                          (js-call heap :release out)))))))
              (finish heap (js-array input pair writer reader before))
              (setq cnt (1+ cnt)))))
        (js-call assert :equal cnt 48)))))
