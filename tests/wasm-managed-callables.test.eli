  (test "mutually recursive local functions and source Map function keys retain identity through GC"
    (lambda ()
      (let* ((heap (instance))
             (pair (js-call heap :invoke "parity-functions"))
             (even (js-call heap :get pair 0))
             (odd (js-call heap :get pair 1))
