(module tests.wasm-managed-source-collections-test-ground
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst is-instance (js* "(a, b) => a instanceof b"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar program nil)
  (defvar bytes nil)
  (defvar js nil)

  (defconst supported-collection-source
    (str "\n"
         "  (defun captured-call (fn receiver &rest args) (js-call fn :apply receiver args))\n"
         "  (defun detached-call (fn key trace) (funcall fn (progn (js-call trace :push \"argument\") key)))\n"
         "  (defun captured-get (m trace) (js-call (get m :get) :call m (progn (put m :get false) (js-call trace :push \"key\") \"key\")))\n"
         "  (defun shadow-map (Map trace) (new (js* \"Map\") (progn (js-call trace :push \"argument\") nil)))\n"
         "  (defun shadow-global (globalThis trace) (new globalThis.Map (progn (js-call trace :push \"argument\") nil)))\n"
         "  (defun local-map-shadow (trace) (let ((Map nil)) (new (js* \"Map\") (progn (js-call trace :push \"argument\") nil))))\n"
         "  (defun local-global-shadow (trace) (let ((globalThis nil)) (new globalThis.Set (progn (js-call trace :push \"argument\") nil))))\n"
         "  (defun supported-operands (trace)\n"
         "    (let ((map (new globalThis.Map nil (progn (js-call trace :push \"ignored\") (async (x) x)))))\n"
         "      (js-array (get map :size) (if false (new globalThis.Array (js-call trace :push \"unreachable\")) nil) trace)))\n"
         "  (defun shadow-constructor (ignored) nil)\n"
         "  (defun successful-shadows (trace)\n"
         "    (let ((a (shadow-map (js* \"Set\") trace)) (b (shadow-global (js-object :Map (js* \"Set\")) trace))\n"
         "          (c (let ((Map shadow-constructor)) (new (js* \"Map\") nil))))\n"
         "      (js-array (get a :size) (get b :size)\n"
         "        (Object/is (Object/getPrototypeOf a) (get (js* \"Set\") :prototype))\n"
         "        (Object/is (Object/getPrototypeOf b) (get (js* \"Set\") :prototype))\n"
         "        (Object/is (Object/getPrototypeOf c) (get shadow-constructor :prototype)) trace)))\n"
         "  (export captured-call detached-call captured-get shadow-map shadow-global local-map-shadow local-global-shadow supported-operands successful-shadows)\n"))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-source-collections-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
      (let ((fixture (await (readFile "tests/fixtures/wasm-managed-source-collections.eli" "utf8"))))
        (setq program (js-call (get b :compiler) :compile_ir_string
                        (js-call fixture :replace "  (export " (str supported-collection-source "  (export "))
                        "source-collections.eli")))
      (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program runtime)))
      (funcall assert (WebAssembly/validate bytes))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (setq js (await (funcall dynamic-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string program)) :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun box-val (a x)
    (let ((ty (funcall js-typeof x)))
      (cond
        ((= ty "number") (js-call a :number x))
        ((= ty "string") (js-call a :string x))
        (t x))))

  (defun read-val (a x)
    (if (or (nullish? x) (/= (funcall js-typeof x) "object"))
      x
      (let ((k (get x :kind)))
        (cond
          ((= k 4) (js-call a :readNumber x))
          ((= k 5) (js-call a :readString x))
          ((= k 14)
           (Array/from (js-object :length (js-call a :length x))
             (lambda (_ i)
               (let ((y (js-call a :get x i)))
                 (try
                   (read-val a y)
                   (finally (js-call a :release y)))))))
          ((= k 13)
           (let ((out (js-object))
                 (keys (js-call a :objectKeys x)))
             (try
               (let ((len (js-call a :length keys))
                     (i 0))
                 (while (< i len)
                   (let* ((key-h (js-call a :get keys i))
                          (val-h (js-call a :objectGet x key-h)))
                     (try
                       (Object/defineProperty out (js-call a :readString key-h)
                         (js-object :value (read-val a val-h) :enumerable t :writable t :configurable t))
                       (finally
                         (js-call a :release key-h)
                         (js-call a :release val-h))))
                   (setq i (+ i 1))))
               (finally (js-call a :release keys)))
             out))
          (t x)))))

  (defun call-val (a name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (let ((x (js-call a :invoke name (if (undefined? args) (js-array) args))))
      (try
        (read-val a x)
        (finally (js-call a :release x))))))

  (defun collect-entries (a m &rest __host_default_arguments_2)
    (let* ((method (aref __host_default_arguments_2 0)))
    (let* ((meth (if (undefined? method) "entries" method))
           (it (js-call a :invoke meth (js-array m)))
           (out (js-array))
           (done false))
      (try
        (while (not done)
          (let ((step (call-val a "next" (js-array it))))
            (if (get step :done)
              (setq done t)
              (js-call out :push (get step :value)))))
        (finally (js-call a :release it)))
      out)))

  (defun map-put (a m k v)
    (let* ((key (box-val a k))
           (value (box-val a v))
           (out (js-call a :invoke "set-value" (js-array m key value))))
      (funcall assert (js-call a :keyEqual out m))
      (js-call a :release out)
      (js-call a :release key)
      (js-call a :release value)))

  (defun set-add (a m k)
    (let* ((key (box-val a k))
           (out (js-call a :invoke "add-value" (js-array m key))))
      (funcall assert (js-call a :keyEqual out m))
      (js-call a :release out)
      (js-call a :release key)))

  (defun check-own (a m k)
    (let ((key (box-val a k)))
      (try
        (call-val a "own" (js-array m key))
        (finally (js-call a :release key)))))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (test "ordinary Map and Set constructors, queries, mutations and defaults match JS without host imports"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call (js-array "empty-map" "raw-map" "empty-set" "raw-set") :forEach
          (lambda (name)
            (let ((m (js-call a :invoke name)))
              (js-call assert :equal (call-val a "size" (js-array m)) 0)
              (js-call assert :equal (call-val a "length" (js-array m)) undefined)
              (js-call assert :deepEqual (call-val a "own-keys" (js-array m)) (js-array))
              (js-call a :release m)
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0))))
        (let ((m (js-call a :invoke "empty-map"))
              (s (js-call a :invoke "empty-set"))
              (ref (new globalThis.Map))
              (set-ref (new globalThis.Set)))
          (js-call
            (js-array
              (js-array nil undefined)
              (js-array false nil)
              (js-array t false)
              (js-array undefined t)
              (js-array -0.0 -0.0)
              (js-array globalThis.NaN globalThis.Infinity)
              (js-array "中😀\ud800" "text"))
            :forEach
            (lambda (pair)
              (let ((k (aref pair 0))
                    (v (aref pair 1)))
                (map-put a m k v)
                (js-call ref :set k v)
                (set-add a s k)
                (js-call set-ref :add k)
                (let ((key (box-val a k)))
                  (js-call assert :equal (call-val a "has" (js-array m key)) (js-call ref :has k))
                  (js-call assert :deepEqual (call-val a "lookup" (js-array m key)) (js-call ref :get k))
                  (js-call a :release key)))))
          (js-call assert :deepEqual (collect-entries a m) (Array/from ref))
          (js-call assert :deepEqual (collect-entries a s) (js-call (Array/from set-ref) :map (lambda (x) (js-array x x))))
          (js-call assert :deepEqual (collect-entries a s "keys") (Array/from set-ref))
          (js-call assert :deepEqual (collect-entries a s "values") (Array/from set-ref))
          (js-call assert :deepEqual (call-val a "lookup-none" (js-array m)) (js-call ref :get))
          (let ((out (js-call a :invoke "set-none" (js-array m))))
            (funcall assert (js-call a :keyEqual out m))
            (js-call a :release out))
          (js-call ref :set)
          (let ((added (js-call a :invoke "add-none" (js-array s))))
            (js-call a :release added))
          (js-call set-ref :add)
          (js-call assert :deepEqual (collect-entries a m) (Array/from ref))
          (js-call (js-array globalThis.NaN "absent" undefined) :forEach
            (lambda (k)
              (let ((key (box-val a k)))
                (js-call assert :equal (call-val a "delete-value" (js-array m key)) (js-call ref :delete k))
                (js-call a :release key))))
          (js-call assert :deepEqual (collect-entries a m) (Array/from ref))
          (js-call assert :equal (call-val a "clear" (js-array m)) (js-call ref :clear))
          (js-call assert :equal (call-val a "size" (js-array m)) 0)
          (js-call a :release m)
          (js-call a :release s)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))

  (test "constructors consume arrays, source collections, live iterators and Unicode code points with JS entry rules"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((one (js-call a :number 1))
               (two (js-call a :number 2))
               (pair (js-call a :sourceArray (js-array one two)))
               (tuple (js-call a :sourceObject (js-object "0" t "1" false)))
               (input (js-call a :sourceArray (js-array pair tuple)))
               (mp (js-call a :invoke "from-map" (js-array input))))
          (js-call assert :deepEqual (collect-entries a mp) (js-array (js-array 1 2) (js-array t false)))
          (let* ((copy (js-call a :invoke "from-map" (js-array mp)))
                 (st (js-call a :invoke "from-set" (js-array mp))))
            (js-call assert :deepEqual (collect-entries a copy) (collect-entries a mp))
            (js-call assert :equal (call-val a "size" (js-array st)) 2)
            (js-call assert :deepEqual (collect-entries a st "values") (js-array (js-array 1 2) (js-array t false)))
            (let* ((it (js-call a :invoke "entries" (js-array mp)))
                   (from-it (js-call a :invoke "from-map" (js-array it))))
              (js-call assert :deepEqual (collect-entries a from-it) (collect-entries a mp))
              (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-object :value undefined :done t))
              (let* ((word (js-call a :string "a😀a\ud800"))
                     (unicode (js-call a :invoke "from-set" (js-array word)))
                     (sparse-arr (let ((s (new globalThis.Array 3))) (put s 0 t) (put s 2 undefined) s))
                     (sparse (js-call a :sourceArray sparse-arr))
                     (holes (js-call a :invoke "from-set" (js-array sparse))))
                (js-call assert :deepEqual (collect-entries a unicode "values") (Array/from (new globalThis.Set "a😀a\ud800")))
                (js-call assert :deepEqual (collect-entries a holes "values") (js-array t undefined))
                (js-call (js-array false t 0 "x") :forEach
                  (lambda (value)
                    (let ((boxed (box-val a value)))
                      (js-call assert :throws
                        (lambda () (js-call a :invoke "from-map" (js-array boxed)))
                        (lambda (e) (diag-code? e "ELI-RT0003")))
                      (js-call a :release boxed))))
                (js-call (js-array nil undefined) :forEach
                  (lambda (nil-val)
                    (let ((empty (js-call a :invoke "from-map" (js-array nil-val))))
                      (js-call assert :equal (call-val a "size" (js-array empty)) 0)
                      (js-call a :release empty))))
                (let* ((empty-text (js-call a :string ""))
                       (empty-map (js-call a :invoke "from-map" (js-array empty-text))))
                  (js-call assert :equal (call-val a "size" (js-array empty-map)) 0)
                  (js-call
                    (js-array one two pair tuple input mp copy st it from-it word unicode sparse holes empty-text empty-map)
                    :forEach (lambda (v) (js-call a :release v)))
                  (js-call a :collect)
                  (js-call assert :equal (js-call a :live) 0)))))))))

  (test "source iterators preserve live mutations, result shapes, sticky done and array holes"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let ((m (js-call a :invoke "empty-map"))
              (ref (new globalThis.Map (js-array (js-array 1 "one") (js-array 2 "two")))))
          (map-put a m 1 "one")
          (map-put a m 2 "two")
          (let* ((it (js-call a :invoke "entries" (js-array m)))
                 (rit (js-call ref :entries)))
            (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-call rit :next))
            (let ((two (js-call a :number 2)))
              (call-val a "delete-value" (js-array m two))
              (js-call ref :delete 2)
              (map-put a m 3 "three")
              (js-call ref :set 3 "three")
              (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-call rit :next))
              (call-val a "clear" (js-array m))
              (js-call ref :clear)
              (map-put a m 4 "four")
              (js-call ref :set 4 "four")
              (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-call rit :next))
              (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-call rit :next))
              (map-put a m 5 "late")
              (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-object :value undefined :done t))
              (let* ((sparse-arr (let ((s (new globalThis.Array 3))) (put s 0 t) (put s 2 undefined) s))
                     (arr (js-call a :sourceArray sparse-arr))
                     (arr-it (js-call a :invoke "entries" (js-array arr))))
                (js-call assert :deepEqual (call-val a "next" (js-array arr-it)) (js-object :value (js-array 0 t) :done false))
                (js-call assert :deepEqual (call-val a "next" (js-array arr-it)) (js-object :value (js-array 1 undefined) :done false))
                (let ((shortened (js-call a :number 1))
                      (len-key (js-call a :string "length")))
                  (call-val a "write" (js-array arr len-key shortened))
                  (js-call assert :deepEqual (call-val a "next" (js-array arr-it)) (js-object :value undefined :done t))
                  (let ((extended (js-call a :number 8)))
                    (call-val a "write" (js-array arr len-key extended))
                    (js-call assert :deepEqual (call-val a "next" (js-array arr-it)) (js-object :value undefined :done t))
                    (let ((result (js-call a :invoke "next" (js-array arr-it))))
                      (js-call assert :deepEqual (call-val a "own-keys" (js-array result)) (js-array "value" "done"))
                      (js-call a :release result))
                    (js-call (js-array m it two arr arr-it shortened len-key extended) :forEach (lambda (v) (js-call a :release v)))
                    (js-call a :collect)
                    (js-call assert :equal (js-call a :live) 0))))))))))

  (test "ordinary collection properties, size accessors, shallow copies and method shadows remain separate from entries"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let ((m (js-call a :invoke "empty-map")))
          (map-put a m "name" 1)
          (js-call assert :equal (check-own a m "size") false)
          (js-call assert :equal (check-own a m "name") false)
          (let ((name (js-call a :string "name"))
                (two (js-call a :number 2)))
            (call-val a "write" (js-array m name two))
            (js-call assert :equal (check-own a m "name") t)
            (js-call assert :deepEqual (call-val a "own-keys" (js-array m)) (js-array "name"))
            (js-call assert :equal (call-val a "lookup" (js-array m name)) 1)
            (js-call assert :equal (call-val a "read-value" (js-array m name)) 2)
            (let ((size-key (js-call a :string "size")))
              (js-call assert :throws
                (lambda () (js-call a :invoke "write" (js-array m size-key two)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (js-call assert :equal (call-val a "size" (js-array m)) 1)
              (let ((copy (js-call a :invoke "assoc" (js-array m name false))))
                (js-call assert :deepEqual (read-val a copy) (js-object :name false))
                (let ((get-key (js-call a :string "get"))
                      (marker (js-call a :sourceArray (js-array false))))
                  (call-val a "write" (js-array m get-key false))
                  (js-call assert :throws
                    (lambda () (js-call a :invoke "method-shadow" (js-array m marker)))
                    (lambda (e) (diag-code? e "ELI-RT0003")))
                  (js-call assert :deepEqual (read-val a marker) (js-array 9))
                  (let* ((fresh (js-call a :invoke "empty-map"))
                         (result (js-call a :invoke "method-replace" (js-array fresh name two))))
                    (funcall assert (js-call a :keyEqual fresh result))
                    (js-call a :release result)
                    (js-call assert :equal (call-val a "lookup" (js-array fresh name)) 2)
                    (js-call (js-array m name two size-key copy get-key marker fresh) :forEach (lambda (v) (js-call a :release v)))
                    (js-call a :collect)
                    (js-call assert :equal (js-call a :live) 0))))))))))

  (test "constructors and methods evaluate ignored arguments in order and retain original receivers"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((marker (js-call a :sourceArray (js-array false)))
               (reference-marker (js-array false))
               (reference (js-call js :map_extra undefined reference-marker))
               (m (js-call a :invoke "map-extra" (js-array undefined marker))))
          (js-call assert :deepEqual (read-val a marker) reference-marker)
          (js-call assert :throws
            (lambda () (js-call a :invoke "map-extra" (js-array t marker)))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call assert :throws (lambda () (js-call js :map_extra t reference-marker)))
          (js-call assert :deepEqual (read-val a marker) reference-marker)
          (let ((assigned (js-call a :invoke "set-order" (js-array m marker))))
            (js-call a :release assigned))
          (js-call js :set_order reference reference-marker)
          (js-call assert :deepEqual (collect-entries a m) (Array/from reference))
          (js-call assert :deepEqual (read-val a marker) reference-marker)
          (let ((key (js-call a :number 1)))
            (js-call assert :equal (call-val a "has-extra" (js-array m key marker)) (js-call js :has_extra reference 1 reference-marker))
            (js-call assert :deepEqual (read-val a marker) reference-marker)
            (js-call assert :equal (call-val a "clear-extra" (js-array m marker)) (js-call js :clear_extra reference reference-marker))
            (js-call assert :deepEqual (read-val a marker) reference-marker)
            (js-call (js-array marker m key) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))))

  (test "random ordinary Map and Set operations agree with independent JS through GC, deletion and reinsertion"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((m (js-call a :invoke "empty-map"))
               (s (js-call a :invoke "empty-set"))
               (ref (new globalThis.Map))
               (set-ref (new globalThis.Set))
               (values (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Infinity "中😀\ud800"))
               (state 52951577)
               (next (lambda ()
                       (setq state (bit-xor state (bit-shift-left state 13)))
                       (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                       (setq state (bit-xor state (bit-shift-left state 5)))
                       (unsigned-bit-shift-right state 0)))
               (i 0))
          (while (< i 512)
            (let* ((key (aref values (% (funcall next) (length values))))
                   (value (aref values (% (funcall next) (length values))))
                   (op (% (funcall next) 5))
                   (k (box-val a key)))
              (cond
                ((< op 2)
                 (map-put a m key value)
                 (set-add a s key)
                 (js-call ref :set key value)
                 (js-call set-ref :add key))
                ((= op 2)
                 (js-call assert :equal (call-val a "delete-value" (js-array m k)) (js-call ref :delete key))
                 (js-call assert :equal (call-val a "delete-value" (js-array s k)) (js-call set-ref :delete key)))
                ((= op 3)
                 (js-call assert :equal (call-val a "has" (js-array m k)) (js-call ref :has key))
                 (js-call assert :deepEqual (call-val a "lookup" (js-array m k)) (js-call ref :get key)))
                (t
                 (call-val a "clear" (js-array m))
                 (call-val a "clear" (js-array s))
                 (js-call ref :clear)
                 (js-call set-ref :clear)))
              (js-call a :release k)
              (js-call assert :equal (call-val a "size" (js-array m)) (get ref :size))
              (js-call assert :deepEqual (collect-entries a m) (Array/from ref))
              (js-call assert :deepEqual (collect-entries a s "values") (Array/from set-ref))
              (js-call a :collect)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
            (setq i (+ i 1)))
          (js-call a :release m)
          (js-call a :release s)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "arbitrary JS and unsupported callback bodies remain source-bound refusals, including shadowed and dead branches"
    (lambda ()
      (js-call
        (js-array
          "(defun f () (new (js* \"Map()\")))"
          "(defun f (Map) (new (js* \"Map()\")))"
          "(defun f (globalThis) (new globalThis.Map (js* \"unsupported()\")))"
          "(defun f (m) (if false (js-call m :forEach (lambda (x) (js* \"x\"))) m))")
        :forEach
        (lambda (source)
          (let* ((ir (js-call (get b :compiler) :compile_ir_string (str source " (export f)") "unsupported-source-map.eli"))
                 (before (JSON/stringify ir)))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime))
              (lambda (e)
                (and (diag-code? e "ELI-B0001")
                     (= (get (get (get e :eliscriptDiagnostic) :location) :file) "unsupported-source-map.eli"))))
            (js-call assert :equal (JSON/stringify ir) before))))))

  (test "lexical constructor shadows retain their actual values and supported ignored operands preserve JS effects"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (try
          (js-call (js-array "supported-operands" "successful-shadows") :forEach
            (lambda (name)
              (let ((trace (js-call a :sourceArray (js-array)))
                    (expected-trace (js-array)))
                (try
                  (js-call assert :deepEqual
                    (call-val a name (js-array trace))
                    (funcall (aref js (js-call name :replaceAll "-" "_")) expected-trace))
                  (js-call assert :deepEqual (read-val a trace) expected-trace)
                  (finally (js-call a :release trace))))))
          (js-call
            (js-array
              (js-array "shadow-map" nil nil)
              (js-array "shadow-global" nil nil)
              (js-array "shadow-global" (js-call a :sourceObject (js-object :Map nil)) (js-object :Map nil))
              (js-array "local-map-shadow" undefined undefined)
              (js-array "local-global-shadow" undefined undefined))
            :forEach
            (lambda (entry)
              (let ((name (aref entry 0))
                    (receiver (aref entry 1))
                    (host-receiver (aref entry 2))
                    (trace (js-call a :sourceArray (js-array)))
                    (expected (js-array)))
                (try
                  (let ((args (if (js-call name :startsWith "local-") (js-array trace) (js-array receiver trace)))
                        (host-args (if (js-call name :startsWith "local-") (js-array expected) (js-array host-receiver expected)))
                        (js-fn (aref js (js-call name :replaceAll "-" "_"))))
                    (js-call assert :throws (lambda () (js-call js-fn :apply nil host-args)) globalThis.TypeError)
                    (js-call assert :throws
                      (lambda () (js-call a :invoke name args))
                      (lambda (e) (diag-code? e "ELI-RT0003")))
                    (js-call assert :deepEqual (read-val a trace) expected)
                    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
                  (finally
                    (js-call a :release trace)
                    (js-call a :release receiver))))))
          (finally
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))

  (test "source collection identities, self keys and named cycles survive GC without changing raw Map and Set brands"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((m (js-call a :invoke "empty-map"))
               (s (js-call a :invoke "empty-set"))
               (out (js-call a :invoke "set-value" (js-array m m s))))
          (funcall assert (js-call a :keyEqual out m))
          (js-call a :release out)
          (let ((added (js-call a :invoke "add-value" (js-array s m))))
            (js-call a :release added))
          (let ((name (js-call a :string "self")))
            (call-val a "write" (js-array m name m))
            (js-call a :collect)
            (let ((found (js-call a :invoke "lookup" (js-array m m))))
              (funcall assert (js-call a :keyEqual found s))
              (js-call a :release found))
            (js-call assert :equal (call-val a "has" (js-array s m)) t)
            (let ((alias (js-call a :invoke "read-value" (js-array m name))))
              (funcall assert (js-call a :keyEqual alias m))
              (js-call a :release alias))
            (js-call (js-array m s name) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)))
        (let ((raw-map (js-call a :map))
              (raw-set (js-call a :setTable)))
          (js-call assert :equal (get raw-map :kind) 10)
          (js-call assert :equal (get raw-set :kind) 11)
          (js-call a :tableSet raw-map t false)
          (js-call a :tableAdd raw-set t)
          (js-call assert :equal (js-call a :tableGet raw-map t) false)
          (js-call assert :equal (js-call a :tableHas raw-set t) t)
          (js-call a :release raw-map)
          (js-call a :release raw-set)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "source table capacity failures leave committed entries intact and unwind only private roots"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 16384))))
        (js-call a :auto 1)
        (let ((m (js-call a :invoke "empty-map"))
              (count 0)
              (failed false)
              (i 0))
          (while (and (< i 512) (not failed))
            (let ((key undefined))
              (try
                (setq key (js-call a :number i))
                (let ((result (js-call a :invoke "set-value" (js-array m key t))))
                  (js-call a :release result)
                  (setq count (+ count 1)))
                (catch e
                  (js-call assert :equal (get (get e :eliscriptDiagnostic) :code) "ELI-RT0002")
                  (setq failed t))
                (finally (js-call a :release key))))
            (setq i (+ i 1)))
          (funcall assert (and failed (> count 0)))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
          (js-call a :collect)
          (js-call assert :equal (call-val a "size" (js-array m)) count)
          (let ((j 0))
            (while (< j count)
              (let ((key (js-call a :number j)))
                (js-call assert :equal (call-val a "lookup" (js-array m key)) t)
                (js-call a :release key))
              (setq j (+ j 1))))
          (js-call a :release m)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0))
        (let ((bad (js-call a :sourceArray (js-array undefined))))
          (js-call assert :throws
            (lambda () (js-call a :invoke "from-map" (js-array bad)))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
          (js-call a :release bad)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "real lookup, call and iterator traps preserve argument order, caller frames and owned graph cleanup"
    (async ()
      (let ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8"))))
        (js-call
          (js-array
            (js-array "value-source-method-check" "heap value method" "has-extra" false)
            (js-array "value-source-method" "heap value method a b" "has-extra" 9)
            (js-array "value-source-iterator-advance" "heap iterator" "next-extra" 9)
            (js-array "value-source-method-check" "heap value method" "lookup" false)
            (js-array "value-source-method" "heap value method a b" "lookup" false))
          :forEach
          (lambda (item)
            (let* ((name (aref item 0))
                   (parameters (aref item 1))
                   (entry (aref item 2))
                   (expected (aref item 3))
                   (start (js-call source :indexOf (str "  (defun " name " ")))
                   (end (js-call source :indexOf "  (defun " (+ start 3))))
              (funcall assert (and (>= start 0) (> end start)))
              (let* ((injected (js-call (get b :compiler) :compile_ir_string
                                 (str (js-call source :slice 0 start) "  (defun " name " (" parameters ") (load-u32 4294967295))\n" (js-call source :slice end))
                                 "source-map-trap.eli"))
                     (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program injected)))))
                (js-call a :auto 1)
                (let* ((mp (js-call a :invoke "empty-map"))
                       (marker (js-call a :sourceArray (js-array false)))
                       (key (js-call a :number 1))
                       (it (if (= name "value-source-iterator-advance")
                             (js-call a :invoke "entries" (js-array mp))
                             nil))
                       (frame (js-call a :frame 1)))
                  (js-call a :frameSet frame 0 mp)
                  (js-call assert :throws
                    (lambda ()
                      (js-call a :invoke entry
                        (if (not (nil? it))
                          (js-array it marker)
                          (if (= entry "lookup")
                            (js-array mp key)
                            (js-array mp key marker)))))
                    (lambda (e) (funcall is-instance e globalThis.WebAssembly.RuntimeError)))
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                  (js-call assert :deepEqual (read-val a marker) (js-array expected))
                  (js-call a :leaveFrame frame)
                  (js-call (js-array mp marker key it) :forEach (lambda (value) (js-call a :release value)))
                  (js-call a :collect)
                  (js-call assert :equal (js-call a :live) 0)))))))))

  (test "source APIs preserve invalid-handle errors and earlier constructor failures without overwriting their codes"
    (lambda ()
      (let* ((inst (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)))
             (e (get inst :exports))
             (h (funcall (aref e "heap-new") 64 4096 65536)))
        (js-call
          (js-array
            (js-array "value-source-collection-get" (js-array 4 0))
            (js-array "value-source-collection-put" (js-array 4 0 0))
            (js-array "value-source-collection-has" (js-array 4 0))
            (js-array "value-source-collection-own" (js-array 4 0))
            (js-array "value-source-iterator-new" (js-array 4 0))
            (js-array "value-source-iterator-advance" (js-array 4))
            (js-array "value-source-iterator-next" (js-array 4))
            (js-array "value-source-method-check" (js-array 4 0))
            (js-array "value-source-method" (js-array 4 0 0 0))
            (js-array "value-source-collection-new" (js-array 15 4)))
          :forEach
          (lambda (pair)
            (let ((name (aref pair 0))
                  (args (aref pair 1)))
              (js-call (aref e name) :apply nil (js-call (js-array h) :concat args))
              (js-call assert :equal (funcall (aref e "last-error")) 1 name))))
        (let ((m (funcall (aref e "value-source-collection-new") h 15 3)))
          (funcall (aref e "heap-pin") h m)
          (js-call
            (js-array
              (js-array "value-source-collection-own" (js-array m 2))
              (js-array "value-source-iterator-new" (js-array m 3))
              (js-array "value-source-method-check" (js-array m 10))
              (js-array "value-source-method" (js-array m 10 0 0))
              (js-array "value-source-collection-new" (js-array 17 3)))
            :forEach
            (lambda (pair)
              (let ((name (aref pair 0))
                    (args (aref pair 1)))
                (js-call (aref e name) :apply nil (js-call (js-array h) :concat args))
                (js-call assert :equal (funcall (aref e "last-error")) 3 name))))
          (funcall (aref e "heap-release") h m)
          (funcall (aref e "heap-collect") h)
          (js-call assert :equal (funcall (aref e "heap-live") h) 0)))))

  (test "ordinary get and has leaves preserve allocation-free table queries without installing private frames"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((m (js-call a :invoke "empty-map"))
               (s (js-call a :invoke "empty-set"))
               (key (js-call a :string "key"))
               (out (js-call a :invoke "set-value" (js-array m key t)))
               (added (js-call a :invoke "add-value" (js-array s key))))
          (js-call a :release out)
          (js-call a :release added)
          (js-call a :collect)
          (let ((before (js-call a :stats))
                (i 0))
            (while (< i 256)
              (js-call assert :equal (call-val a "lookup" (js-array m key)) t)
              (js-call assert :equal (call-val a "has" (js-array m key)) t)
              (js-call assert :equal (call-val a "has" (js-array s key)) t)
              (setq i (+ i 1)))
            (let ((after (js-call a :stats)))
              (js-call assert :equal (get after :usedBytes) (get before :usedBytes))
              (js-call assert :equal (get after :collections) (get before :collections))
              (js-call assert :equal (get after :frameDepth) 0)))
          (js-call (js-array m s key) :forEach (lambda (v) (js-call a :release v)))
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "failed Map construction consumes only the invalid step and does not close a live native iterator"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((pair (js-call a :sourceArray (js-array t false)))
               (input (js-call a :sourceArray (js-array t pair)))
               (it (js-call a :invoke "values" (js-array input)))
               (reference (js-call (js-array t (js-array t false)) :values)))
          (js-call assert :throws (lambda () (new globalThis.Map reference)))
          (js-call assert :throws
            (lambda () (js-call a :invoke "from-map" (js-array it)))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-call reference :next))
          (js-call assert :deepEqual (call-val a "next" (js-array it)) (js-call reference :next))
          (let ((other (js-call a :invoke "values" (js-array input)))
                (next-key (js-call a :string "next")))
            (call-val a "write" (js-array other next-key false))
            (js-call assert :throws
              (lambda () (js-call a :invoke "from-set" (js-array other)))
              (lambda (e) (diag-code? e "ELI-RT0003")))
            (js-call (js-array pair input it other next-key) :forEach (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))))

  (test "malformed collection IR and ignored unsupported raw operands are source-bound refusals"
    (lambda ()
      (js-call
        (js-array
          "(defun f () (let ((Map nil)) (new (js* \"Map\") (js* \"unsupported()\"))))"
          "(defun f () (let ((globalThis nil)) (new globalThis.Set (js* \"unsupported()\"))))"
          "(defun f () (new globalThis.Map nil (js* \"unsupported()\")))"
          "(defun f () (if false (new globalThis.Array (js* \"unsupported()\")) nil))")
        :forEach
        (lambda (source)
          (let ((ir (js-call (get b :compiler) :compile_ir_string (str source " (export f)") "bad-collection.eli")))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime))
              (lambda (e)
                (and (diag-code? e "ELI-B0001")
                     (= (get (get (get e :eliscriptDiagnostic) :location) :file) "bad-collection.eli")))))))
      (let ((ir (js-call (get b :compiler) :compile_ir_string "(defun f () (new globalThis.Map)) (export f)" "bad-constructor.eli")))
        (put (aref (get (aref (get ir :body) 0) :children) 0) :children (js-array))
        (let ((before (JSON/stringify ir)))
          (js-call assert :throws
            (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime))
            (lambda (e)
              (and (diag-code? e "ELI-B0001")
                   (= (get (get (get e :eliscriptDiagnostic) :location) :file) "bad-constructor.eli"))))
          (js-call assert :equal (JSON/stringify ir) before)))
      (js-call
        (js-array
          (js-array "(defun f () (new globalThis.Map))"
            (lambda (p)
              (put (aref (get (aref (get (aref (get p :body) 0) :children) 0) :children) 0)
                :children (js-array (js-object :kind "raw-javascript" :value "js*" :children (js-array))))))
          (js-array "(defun f (m k) (js-call m :get k))"
            (lambda (p)
              (put (aref (get (aref (get (aref (get p :body) 0) :children) 2) :children) 1)
                :children (js-array (js-object :kind "raw-javascript" :value "js*" :children (js-array))))))
          (js-array "(defun f () (new (js* \"Map\")))"
            (lambda (p)
              (put (aref (get (aref (get (aref (get (aref (get p :body) 0) :children) 0) :children) 0) :children) 0)
                :properties (js-object :literalKind "symbol"))))
          (js-array "(defun f () (new (js* \"Map\")))"
            (lambda (p)
              (put (aref (get (aref (get (aref (get p :body) 0) :children) 0) :children) 0)
                :children (js-array nil)))))
        :forEach
        (lambda (pair)
          (let ((p (js-call (get b :compiler) :compile_ir_string (str (aref pair 0) " (export f)") "hidden-collection-ir.eli")))
            (funcall (aref pair 1) p)
            (let ((saved (JSON/stringify p)))
              (js-call assert :throws
                (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
                (lambda (e)
                  (and (diag-code? e "ELI-B0001")
                       (= (get (get (get e :eliscriptDiagnostic) :location) :file) "hidden-collection-ir.eli"))))
              (js-call assert :equal (JSON/stringify p) saved)))))))

  (test "missing members stay undefined, supported methods are canonical callable values and unimplemented methods remain refused"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let ((m (js-call a :invoke "empty-map"))
              (s (js-call a :invoke "empty-set"))
              (it (js-call a :invoke "entries" (js-array nil))))
          (js-call a :release it)
          (setq it (js-call a :invoke "entries" (js-array m)))
          (js-call
            (js-array
              (js-array m (js-array "next" "add" "map" "unknown"))
              (js-array s (js-array "get" "set" "next" "map"))
              (js-array it (js-array "get" "set" "has" "entries" "size")))
            :forEach
            (lambda (pair)
              (let ((target (aref pair 0)))
                (js-call (aref pair 1) :forEach
                  (lambda (name)
                    (let ((key (js-call a :string name)))
                      (js-call assert :equal (call-val a "read-value" (js-array target key)) undefined name)
                      (js-call a :release key)))))))
          (js-call
            (js-array
              (js-array m (js-array "getOrInsert" "getOrInsertComputed"))
              (js-array s (js-array "union" "intersection"))
              (js-array it (js-array "map" "toArray")))
            :forEach
            (lambda (pair)
              (let ((target (aref pair 0)))
                (js-call (aref pair 1) :forEach
                  (lambda (name)
                    (let ((key (js-call a :string name)))
                      (js-call assert :throws
                        (lambda () (js-call a :invoke "read-value" (js-array target key)))
                        (lambda (e) (diag-code? e "ELI-RT0003"))
                        name)
                      (js-call a :release key)))))))
          (let* ((reference-map (new globalThis.Map (js-array (js-array "key" 7))))
                 (reference-set (new globalThis.Set (js-array "key")))
                 (key (js-call a :string "key"))
                 (value (js-call a :number 7))
                 (other (js-call a :invoke "empty-map"))
                 (roots (js-array key value other))
                 (assigned (js-call a :invoke "set-value" (js-array m key value)))
                 (added (js-call a :invoke "add-value" (js-array s key))))
            (js-call a :release assigned)
            (js-call a :release added)
            (try
              (js-call
                (js-array
                  (js-array m reference-map (js-array "get" "set" "has" "delete" "clear" "entries" "keys" "values" "forEach"))
                  (js-array s reference-set (js-array "add" "has" "delete" "clear" "entries" "keys" "values" "forEach"))
                  (js-array it (js-call reference-map :entries) (js-array "next")))
                :forEach
                (lambda (group)
                  (let ((target (aref group 0))
                        (reference (aref group 1)))
                    (js-call (aref group 2) :forEach
                      (lambda (name)
                        (let ((k (js-call a :string name))
                              (first undefined)
                              (again undefined))
                          (try
                            (setq first (js-call a :invoke "read-value" (js-array target k)))
                            (setq again (js-call a :invoke "read-value" (js-array target k)))
                            (js-call assert :equal (get first :kind) 18 name)
                            (funcall assert (js-call a :keyEqual first again) name)
                            (let ((label (js-call a :string "name"))
                                  (len-k (js-call a :string "length")))
                              (try
                                (js-call assert :equal (call-val a "read-value" (js-array first label)) (get (aref reference name) :name))
                                (js-call assert :equal (call-val a "read-value" (js-array first len-k)) (get (aref reference name) :length))
                                (finally
                                  (js-call a :release label)
                                  (js-call a :release len-k))))
                            (finally
                              (js-call a :release k)
                              (js-call a :release first)
                              (js-call a :release again)))))))))
              (js-call
                (js-array
                  (js-array m reference-map "get" (js-array key) (js-array "key"))
                  (js-array m reference-map "has" (js-array key) (js-array "key"))
                  (js-array s reference-set "has" (js-array key) (js-array "key"))
                  (js-array it (js-call reference-map :entries) "next" (js-array) (js-array)))
                :forEach
                (lambda (item)
                  (let* ((target (aref item 0))
                         (reference (aref item 1))
                         (name (aref item 2))
                         (args (aref item 3))
                         (host-args (aref item 4))
                         (k (js-call a :string name))
                         (fn (js-call a :invoke "read-value" (js-array target k))))
                    (try
                      (js-call assert :deepEqual
                        (call-val a "captured-call" (js-call (js-array fn target) :concat args))
                        (Reflect/apply (aref reference name) reference host-args))
                      (let ((trace (js-call a :sourceArray (js-array)))
                            (expected (js-array)))
                        (try
                          (js-call assert :throws
                            (lambda () (js-call js :detached_call (aref reference name) (aref host-args 0) expected))
                            globalThis.TypeError)
                          (js-call assert :throws
                            (lambda () (js-call a :invoke "detached-call" (js-array fn key trace)))
                            (lambda (e) (diag-code? e "ELI-RT0003")))
                          (js-call assert :deepEqual (read-val a trace) expected)
                          (finally (js-call a :release trace))))
                      (finally
                        (js-call a :release k)
                        (js-call a :release fn))))))
              (let ((get-key (js-call a :string "get"))
                    (first undefined)
                    (second undefined))
                (try
                  (setq first (js-call a :invoke "read-value" (js-array m get-key)))
                  (setq second (js-call a :invoke "read-value" (js-array other get-key)))
                  (funcall assert (js-call a :keyEqual first second))
                  (let ((trace (js-call a :sourceArray (js-array)))
                        (expected (js-array)))
                    (try
                      (js-call assert :equal (call-val a "captured-get" (js-array m trace)) (js-call js :captured_get reference-map expected))
                      (js-call assert :deepEqual (read-val a trace) expected)
                      (js-call assert :equal (call-val a "read-value" (js-array m get-key)) false)
                      (finally (js-call a :release trace))))
                  (finally
                    (js-call a :release get-key)
                    (js-call a :release first)
                    (js-call a :release second))))
              (finally
                (js-call (js-call roots :concat (js-array m s it)) :forEach (lambda (v) (js-call a :release v)))
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))))

  (test "Node executes the same source-collection artifact and generated JS through constructors, live iterators and exact cleanup"
    (async ()
      (let ((wasm (resolve directory "source-collections.wasm"))
            (javascript (resolve directory "source-collections.mjs"))
            (runner (resolve "tests/helpers/wasm-managed-source-collections-node.mjs"))
            (rt-href (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)))
        (await (writeFile wasm bytes))
        (await (writeFile javascript (js-call (get b :compiler) :emit_ir_string program)))
        (let ((child (spawnSync "node"
                       (js-array runner rt-href (get (pathToFileURL javascript) :href) wasm)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))))))
