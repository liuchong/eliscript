(module tests.compiler-indent
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (defconst compilerSources (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))

  (import "../tools/compiler/indent-benchmark.mjs" compilerIndentSourceDigest validateCompilerIndentReport)
  (defconst reportPath (resolve projectDirectory "benchmarks/compiler-indent-macos-arm64.json"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (defun artifactFragments (artifact)
    (let ((fragments (js-array)) (blockStart 0) (text (get artifact :text)))
      (while (< blockStart (get text :length))
        (let* ((separator (js-call text :indexOf "\n\n" blockStart)) (blockEnd (if (= separator -1) (get text :length) separator)))
          (when (> blockEnd blockStart)
            (js-call fragments :push (js-object :text (js-call text :slice blockStart blockEnd)
              :marks (js-call (js-call (get artifact :marks) :filter (lambda (mark) (and (>= (get mark :offset) blockStart) (< (get mark :offset) blockEnd)))) :map
                (lambda (mark) (js-object :offset (- (get mark :offset) blockStart) :span (get mark :span)))))))
          (if (= separator -1) (setq blockStart (get text :length)) (setq blockStart (+ blockEnd 2)))))
      fragments))
  (test "chunked compiler indentation matches its character reference" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-indent-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((modules (await (Promise/all (js-array (loadModule directory "compiler" "indent") (loadModule directory "emitter" "indent")))))
               (compiler (aref modules 0)) (emitter (aref modules 1)) (fragmentCount 0) (index 0))
          (while (< index (js-length compilerSources))
            (let* ((relative (str "bootstrap/compiler/" (aref compilerSources index) ".eli")) (source (await (readFile (resolve projectDirectory relative) "utf8")))
                   (program (js-call compiler :compile_ir_string source relative)) (artifact (js-call emitter :emit_module_artifact program)))
              (js-call (artifactFragments artifact) :forEach (lambda (fragment)
                (same (js-call emitter :indent fragment) (js-call emitter :reference_indent fragment)) (setq fragmentCount (1+ fragmentCount)))))
            (setq index (1+ index)))
          (js-call (expect fragmentCount) :toBeGreaterThan (js-length compilerSources))
          (let* ((spans (js-array "first" "newline" "blank" "last" "tail"))
                 (boundary (js-object :text "a\n\nb" :marks (js-call (js-array 0 1 2 3 4) :map (lambda (offset index) (js-object :offset offset :span (aref spans index)))))))
            (same (js-call emitter :indent boundary) (js-object :text "  a\n\n  b" :marks (js-array (js-object :offset 2 :span "first") (js-object :offset 3 :span "newline") (js-object :offset 4 :span "blank") (js-object :offset 7 :span "last"))))
            (same (js-call emitter :indent boundary) (js-call emitter :reference_indent boundary)))
          (same (js-call emitter :indent "\n\n") (js-object :text "\n\n" :marks (js-array)))
          (same (js-call emitter :indent "🙂\nλ") (js-object :text "  🙂\n  λ" :marks (js-array)))
          (same (js-call emitter :indent (js-object :text "x" :marks (js-array (js-object :offset 0 :span "one") (js-object :offset 0 :span "two"))))
            (js-object :text "  x" :marks (js-array (js-object :offset 2 :span "one") (js-object :offset 2 :span "two")))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "committed compiler indentation report preserves historical measurements and decisions" (async ()
    (let ((report (validateCompilerIndentReport (await (readReport)))))
      (js-call (expect (get (get report :corpus) :files)) :toHaveLength (js-length compilerSources))
      (js-call (expect (get (get report :corpus) :sourceBytes)) :toBeGreaterThan 200000)
      (js-call (expect (get (get report :corpus) :generatedBytes)) :toBeGreaterThan 300000)
      (js-call (expect (get (get report :corpus) :marks)) :toBeGreaterThan 3000)
      (be (get (get report :validation) :fragments) (+ (get (get report :corpus) :fragments) (get (get report :corpus) :boundaryFragments)))
      (js-call (expect (get (get report :measurements) :speedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumSpeedup)))))
  (test "indentation reacceptance rejects a weaker decision threshold" (async ()
    (let ((report (await (readReport))))
      (put (get report :decision) :minimumSpeedup 9)
      (js-call (expect (lambda () (validateCompilerIndentReport report))) :toThrow "speedup decision did not pass"))))
  (funcall (currentPerformanceTest test) "committed compiler indentation report matches measured sources" (async ()
    (same (get (await (readReport)) :sourceDigest) (await (compilerIndentSourceDigest)))))
)
