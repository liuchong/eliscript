(module tests.worker-value-codec
  (import "bun:test" expect test)
  (import "../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../runtime/core/list.mjs" persistentList)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/protocol.mjs" defineProtocol defineProtocolFromDefinition protocolDefinition protocolSlot)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/transient.mjs" :as transient-mod)
  (import "../runtime/core/value.mjs" equalValues)
  (import "../runtime/core/vector.mjs" persistentVector)
  (import "../runtime/worker-value-codec.mjs"
    WorkerValueCodecError decodeWorkerValue decodeWorkerValues
    encodeWorkerValue encodeWorkerValues workerValueEncoding)

  (test "worker value codec preserves persistent categories and metadata"
    (lambda ()
      (let* ((metadata (persistentHashMap (js-array (keyword "source") "emacs")))
             (value (withMeta
                      (persistentList
                        (keyword "app" "ready")
                        (withMeta (eliscriptSymbol "model" "item") metadata)
                        (persistentVector undefined -0 globalThis.Number.NaN globalThis.Number.POSITIVE_INFINITY)
                        (persistentHashMap
                          (js-array (keyword "enabled") t)
                          (js-array (eliscriptSymbol "count") 3))
                        (persistentHashSet "alpha" (keyword "beta")))
                      metadata))
             (encoded (encodeWorkerValue value))
             (decoded (decodeWorkerValue encoded)))
        (js-call (expect workerValueEncoding) :toBe "eliscript-value-v1")
        (js-call (expect (equalValues decoded value)) :toBe t)
        (js-call (expect (equalValues (meta decoded) metadata)) :toBe t)
        (js-call (expect (equalValues (meta (js-call decoded :nth 1)) metadata)) :toBe t)
        (js-call (expect (js-call (js-call decoded :nth 2) :nth 0)) :toBeUndefined)
        (js-call (expect (Object/is (js-call (js-call decoded :nth 2) :nth 1) -0)) :toBe t)
        (js-call (expect (Number/isNaN (js-call (js-call decoded :nth 2) :nth 2))) :toBe t)
        (js-call (expect (js-call (js-call decoded :nth 2) :nth 3)) :toBe globalThis.Number.POSITIVE_INFINITY)
        (js-call (expect (encodeWorkerValue decoded)) :toEqual encoded)
        (let ((hostValue (js-array 1 (js-object :ready false))))
          (js-call (expect (decodeWorkerValue (encodeWorkerValue hostValue))) :toEqual hostValue))
        (let* ((sparse (globalThis.Array 1))
               (sparseWire (encodeWorkerValue sparse)))
          (js-call (expect sparseWire) :toEqual (js-array "array" (js-array (js-array "undefined"))))
          (js-call (expect (decodeWorkerValue (JSON/parse (JSON/stringify sparseWire))))
            :toEqual (js-array undefined))))))

  (test "worker value codec emits deterministic Map, Set, and object order"
    (lambda ()
      (let ((left (persistentHashMap (js-array (keyword "z") 1) (js-array (keyword "a") 2)))
            (right (persistentHashMap (js-array (keyword "a") 2) (js-array (keyword "z") 1))))
        (js-call (expect (encodeWorkerValue left)) :toEqual (encodeWorkerValue right))
        (js-call (expect (encodeWorkerValue (persistentHashSet "z" "a")))
          :toEqual (encodeWorkerValue (persistentHashSet "a" "z")))
        (js-call (expect (encodeWorkerValue (js-object :z 1 :a 2)))
          :toEqual (encodeWorkerValue (js-object :a 2 :z 1)))
        (js-call (expect (encodeWorkerValue (persistentHashSet "😀" "\uE000")))
          :toEqual (js-array "set" (js-array "\uE000" "😀") nil)))))

  (test "worker value codec transports protocol definitions without runtime identity"
    (lambda ()
      (let* ((original (defineProtocol "WorkerReadable" (js-array "read" "close")))
             (originalDefinition (protocolDefinition original))
             (transported (decodeWorkerValue (encodeWorkerValue originalDefinition)))
             (restored (defineProtocolFromDefinition transported)))
        (js-call (expect transported) :toEqual originalDefinition)
        (js-call (expect (protocolDefinition restored)) :toEqual originalDefinition)
        (js-call (get (expect (protocolSlot restored "read")) :not)
          :toBe (protocolSlot original "read"))
        (js-call (expect (lambda () (encodeWorkerValue original)))
          :toThrow (new globalThis.RegExp "unsupported function value")))))

  (test "worker value codec rejects unsupported, cyclic, duplicate, and oversized values"
    (lambda ()
      (let ((cycle (js-array)))
        (js-call cycle :push cycle)
        (js-call (expect (lambda () (encodeWorkerValue cycle))) :toThrow WorkerValueCodecError)
        (js-call (expect (lambda () (encodeWorkerValue (lambda () 1))))
          :toThrow (new globalThis.RegExp "unsupported function value at \\$"))
        (js-call (expect (lambda () (encodeWorkerValue (js-call transient-mod :transient (persistentVector 1)))))
          :toThrow (new globalThis.RegExp "unsupported object"))
        (js-call (expect (lambda () (encodeWorkerValue (js-array 1 2 3) (js-object :maxCollectionLength 2))))
          :toThrow (new globalThis.RegExp "collection exceeds 2 values"))
        (js-call (expect (lambda ()
                           (decodeWorkerValue
                             (js-array "map"
                               (js-array
                                 (js-array (js-array "keyword" nil "x") 1)
                                 (js-array (js-array "keyword" nil "x") 2))
                               nil))))
          :toThrow (new globalThis.RegExp "equivalent duplicate key"))
        (js-call (expect (lambda () (decodeWorkerValue (js-array "unknown"))))
          :toThrow (new globalThis.RegExp "unknown value tag"))
        (js-call (expect (lambda ()
                           (decodeWorkerValue
                             (js-array "array" (js-array (js-array "array" (js-array 1))))
                             (js-object :maxDepth 1))))
          :toThrow (new globalThis.RegExp "value exceeds depth 1")))))

  (test "worker value codec shares one resource budget across argument vectors"
    (lambda ()
      (let* ((encoded (encodeWorkerValues (js-array (persistentVector 1 2) (persistentList 3 4))))
             (decoded (decodeWorkerValues encoded)))
        (js-call (expect (equalValues (aref decoded 0) (persistentVector 1 2))) :toBe t)
        (js-call (expect (equalValues (aref decoded 1) (persistentList 3 4))) :toBe t)
        (js-call (expect (lambda () (decodeWorkerValues encoded (js-object :maxNodes 3))))
          :toThrow (new globalThis.RegExp "value exceeds 3 nodes"))))))
