(module tests.retained-transient-refresh-test-ground
  (import "node:process" :default process)
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "../tools/acceptance/finalize.mjs" validateFinalAcceptanceContract)
  (import "../tools/acceptance/retained-transient.mjs" validateRefreshedTransientBuilder)
  (defconst root (resolve (js* "import.meta.dir") ".."))
  (defasync read (path) (JSON/parse (await (readFile (resolve root path) "utf8"))))
  (defconst officialSourceProbe (= (get (get process :env) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE) "1"))
  (defconst canonicalFinalTest (if officialSourceProbe (get test :skip) test))
  (canonicalFinalTest "a remeasured transient benchmark preserves the original accepted run and final manifest" (async ()
    (let ((run (await (read "acceptance/runs/m13-01.json"))))
      (let ((before (JSON/stringify run)))
        (await (validateFinalAcceptanceContract (await (read "contracts/final-acceptance.json")) run (js-object :root root :deferPerformanceAcceptance (= (get (get process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))))
        (js-call assert :equal (JSON/stringify run) before)))))
  (test "fresh transient replacement rejects weaker policy, forged derived data, incomplete work and stale source identities" (async ()
    (let ((run (await (read "acceptance/runs/m13-01.json"))) (report (await (read "benchmarks/transient-builder-macos-arm64.json"))) (mutations (js-array (lambda (r) (put (get r :parameters) :warmupRounds 1))
        (lambda (r) (put (get r :parameters) :vectorSize (+ (get (get r :parameters) :vectorSize) -1)))
        (lambda (r) (put (get r :decision) :minimumSpeedup 1.49))
        (lambda (r) (put (get r :decision) :maximumAllocationRatio 0.34))
        (lambda (r) (put (get r :decision) :passed false))
        (lambda (r) (js-call (get (get (get (get r :results) :vector) :timing) :persistentSamplesMs) :pop))
        (lambda (r) (put (get (get (get r :results) :map) :timing) :transientMedianMs (+ (get (get (get (get r :results) :map) :timing) :transientMedianMs) 1)))
        (lambda (r) (put (get (get (get r :results) :set) :timing) :speedup (+ (get (get (get (get r :results) :set) :timing) :speedup) 1)))
        (lambda (r) (put (get (get (get r :results) :vector) :allocation) :allocationRatio 0))
        (lambda (r) (put (get (get (get r :results) :map) :allocation) :persistentNodeAllocations (+ (get (get (get (get r :results) :map) :allocation) :persistentNodeAllocations) 0.5)))
        (lambda (r) (put (get (get (get (get r :results) :set) :allocation) :transientMetrics) :setPersistentCalls 0))
        (lambda (r) (put (get (get (get r :results) :set) :correctness) :transientHash (+ (get (get (get (get r :results) :set) :correctness) :transientHash) 1)))
        (lambda (r) (put (get (get (get (get r :results) :vector) :correctness) :persistentObservation) :last (+ (get (get (get (get (get r :results) :vector) :correctness) :persistentObservation) :last) -1)))
        (lambda (r) (js-call (get (get r :sourceDigest) :files) :pop))
        (lambda (r) (put (get r :sourceDigest) :value (js-call "0" :repeat 64)))
        (lambda (r) (put (get r :sourceDigest) :algorithm "sha512"))
        (lambda (r) (put (get r :results) :extra (get (get r :results) :vector))))) (index 0))
      (while (< index (get mutations :length))
        (let ((copy (funcall globalThis.structuredClone report)))
          (funcall (aref mutations index) copy)
          (await (js-call assert :rejects (validateRefreshedTransientBuilder root "benchmarks/transient-builder-macos-arm64.json" (Buffer/from (JSON/stringify copy)) run))))
        (setq index (1+ index))))))
  (test "transient refresh refuses substituted accepted commits, trees, artifact hashes, duplicate bindings and unrelated reports" (async ()
    (let* ((run (await (read "acceptance/runs/m13-01.json"))) (file "benchmarks/transient-builder-macos-arm64.json") (bytes (await (readFile (resolve root file))))
           (mutations (js-array (lambda (r) (put (get r :source) :commit (js-call "0" :repeat 40)))
        (lambda (r) (put (get r :source) :tree (js-call "0" :repeat 40)))
        (lambda (r) (put (js-call (get r :artifacts) :find (lambda (item) (= (get item :file) file))) :sha256 (js-call "0" :repeat 64)))
        (lambda (r) (js-call (get r :artifacts) :push (Object/assign (js-object) (js-call (get r :artifacts) :find (lambda (item) (= (get item :file) file)))))))) (index 0))
      (while (< index (get mutations :length))
        (let ((copy (funcall globalThis.structuredClone run)))
          (funcall (aref mutations index) copy)
          (await (js-call assert :rejects (validateRefreshedTransientBuilder root file bytes copy))))
        (setq index (1+ index)))
      (await (js-call assert :rejects (validateRefreshedTransientBuilder root "benchmarks/core-performance-macos-arm64.json" bytes run))))))
  (test "fresh strict transient acceptance remains accepted when deferral is explicitly enabled" (async ()
    (let* ((run (await (read "acceptance/runs/m13-01.json"))) (file "benchmarks/transient-builder-macos-arm64.json") (bytes (await (readFile (resolve root file)))))
      (js-call assert :equal (await (validateRefreshedTransientBuilder root file bytes run)) t)
      (js-call assert :equal (await (validateRefreshedTransientBuilder root file bytes run (js-object :deferPerformanceAcceptance t))) t))))
  (test "failed fresh transient measurements cannot be accepted through deferral without historical proof" (async ()
    (let* ((run (await (read "acceptance/runs/m13-01.json"))) (file "benchmarks/transient-builder-macos-arm64.json") (report (await (read file))))
      (let ((timing (get (get (get report :results) :vector) :timing)))
        (put timing :transientSamplesMs (js-call (get timing :persistentSamplesMs) :map (lambda (value) (* value 2))))
        (put timing :transientMedianMs (* (get timing :persistentMedianMs) 2)) (put timing :speedup 0.5) (put (get report :decision) :passed false))
      (let ((bytes (Buffer/from (JSON/stringify report))))
        (await (js-call assert :rejects (validateRefreshedTransientBuilder root file bytes run)))
        (await (js-call assert :rejects (validateRefreshedTransientBuilder root file bytes run (js-object :deferPerformanceAcceptance t))))))))
)
