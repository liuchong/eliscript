(module tests.wasm-managed-template-string.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst uint32 (js* "(v) => v >>> 0"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar runtime nil)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-template-string-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string
                    (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                    "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun artifact (src)
    (let* ((program (js-call (get backend :compiler) :compile_ir_string src "template.eli"))
           (saved (JSON/stringify program))
           (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
      (js-call assert :equal (JSON/stringify program) saved)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      bytes))

  (defconst source "(defun convert (value) (js* \"`${value}`\")) (export convert)")

  (defun finish (a)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (test "an exact single lexical template substitution implements implicit ToString in zero-import WASM" (lambda ()
    (let ((a (instantiateManagedRuntime (artifact source))))
      (js-call a :auto 1)
      (js-call
        (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) 1e-7 1e21 "" "😀\ud800")
        :forEach
        (lambda (value)
          (let* ((ty (funcall js-typeof value))
                 (input (cond
                          ((= ty "number") (js-call a :number value))
                          ((= ty "string") (js-call a :string value))
                          (t value)))
                 (result (js-call a :invoke "convert" (js-array input))))
            (js-call assert :equal (js-call a :readString result) (globalThis.String value))
            (js-call a :release input)
            (js-call a :release result))))
      (finish a))))

  (test "template lowering refuses unbound names and expressions beyond its represented lexical substitution" (lambda ()
    (js-call
      (js-array "`${missing}`" "`${value.x}`" "`${value + 1}`" "`${value}${value}`" "`prefix${value}`")
      :forEach
      (lambda (expression)
        (js-call assert :throws
          (lambda () (artifact (str "(defun convert (value) (js* " (JSON/stringify expression) ")) (export convert)"))))))))

  (defun read (a value)
    (cond
      ((nullish? value) value)
      ((= (get value :kind) 4) (js-call a :readNumber value))
      ((= (get value :kind) 5) (js-call a :readString value))
      ((= (get value :kind) 14)
       (Array/from (js-object :length (js-call a :length value))
         (lambda (_ i)
           (let ((child (js-call a :get value i)))
             (try (read a child) (finally (js-call a :release child)))))))
      (t value)))

  (defconst family "
  (defun hooked (mode)
    (let* ((events (js-array)) (value (js-object)))
      (put value :toString (lambda () (js-call events :push \"toString\") (if (= mode 1) (js-object) \"ordinary\")))
      (put value :valueOf (lambda () (js-call events :push \"valueOf\") 7))
      (when (= mode 0)
        (put value (js* \"Symbol.toPrimitive\")
          (lambda (hint) (js-call events :push hint) \"special\")))
      (let ((text (js* \"`${value}`\"))) (js-array text events))))
  (defun array-text ()
    (let* ((events (js-array)) (value (js-array undefined nil 1)))
      (put value :join (lambda () (js-call events :push \"join\") \"custom\"))
      (js-array (js* \"`${value}`\") events)))
  (defun symbol-value () (funcall (js* \"Symbol\") \"x\"))
  (defun fail-convert (value trace)
    (put value (js* \"Symbol.toPrimitive\")
      (lambda (hint) (put trace :visited t) (throw trace)))
    (try (js* \"`${value}`\") (catch error (Object/is error trace))))
  (defun shadow (value)
    (let ((value \"inner\")) (js* \"`${value}`\")))
  (export hooked array-text symbol-value fail-convert shadow)")

  (test "template conversion preserves string-hint protocol callbacks ordinary fallback custom array join and lexical shadowing under per-allocation GC" (lambda ()
    (let ((a (instantiateManagedRuntime (artifact (str (js-call source :replace "(export convert)" "") family)))))
      (js-call a :auto 1)
      (js-call
        (js-array
          (js-array 0 (js-array "special" (js-array "string")))
          (js-array 1 (js-array "7" (js-array "toString" "valueOf")))
          (js-array 2 (js-array "ordinary" (js-array "toString"))))
        :forEach
        (lambda (pair)
          (let* ((mode (aref pair 0))
                 (expected (aref pair 1))
                 (input (js-call a :number mode))
                 (out (js-call a :invoke "hooked" (js-array input))))
            (js-call assert :deepEqual (read a out) expected)
            (js-call a :release input)
            (js-call a :release out))))
      (let ((joined (js-call a :invoke "array-text")))
        (js-call assert :deepEqual (read a joined) (js-array "custom" (js-array "join")))
        (js-call a :release joined))
      (let ((shadowed (js-call a :invoke "shadow" (js-array undefined))))
        (js-call assert :equal (js-call a :readString shadowed) "inner")
        (js-call a :release shadowed))
      (let* ((trace (js-call a :sourceObject (js-object)))
             (object (js-call a :sourceObject (js-object))))
        (js-call assert :equal (js-call a :invoke "fail-convert" (js-array object trace)) t)
        (let* ((key (js-call a :string "visited"))
               (_ (js-call assert :equal (js-call a :objectGet trace key) t))
               (sym (js-call a :invoke "symbol-value")))
          (js-call assert :throws
            (lambda () (js-call a :invoke "convert" (js-array sym)))
            (lambda (err) (let ((d (get err :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0003")))))
          (js-call (js-array trace object key sym) :forEach (lambda (v) (js-call a :release v)))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
          (finish a))))))

  (test "template ToString ABI rejects invalid heaps and handles before allocation and recovers after collection" (lambda ()
    (let* ((bytes (artifact source))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
           (heap (funcall uint32 (js-call e "heap-new" 64 4096 16384))))
      (js-call assert :equal (js-call e "last-error") 0)
      (js-call assert :equal (js-call e "value-source-to-string" 0 3) 0)
      (js-call assert :equal (js-call e "last-error") 1)
      (js-call assert :equal (js-call e "value-source-to-string" heap 4294967295) 0)
      (js-call assert :equal (js-call e "last-error") 1)
      (let ((output (funcall uint32 (js-call e "value-source-to-string" heap 3))))
        (funcall assert (> output 3))
        (js-call assert :equal (js-call e "last-error") 0)
        (js-call assert :equal (js-call e "value-length" heap output) 9)
        (js-call e "heap-collect" heap)
        (js-call assert :equal (js-call e "last-error") 0)
        (js-call assert :equal (js-call e "heap-live" heap) 0))))))
