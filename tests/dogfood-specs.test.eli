(module
  tests.dogfood-specs.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" cp mkdtemp readFile readdir rm writeFile)
  (import "node:path" join resolve)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript"))
  (defconst
    SOURCE
    (resolve ROOT "examples/dogfood/tools/spec-check.eli"))
  (defconst
    PROJECT
    (resolve ROOT "examples/dogfood"))
  (defconst
    state
    (js-object :staging nil :program nil))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (defasync
    fixture
    (&rest __host_forwarded_arguments_1)
    (let* ((mutate (aref __host_forwarded_arguments_1 0)))
    (let*
      ((parent (await (mkdtemp (resolve (get state :staging) "case-")))) (directory (join parent "dogfood")))
      (await (cp PROJECT directory (js-object :recursive t)))
      (when
        mutate
        (await (mutate (js-object :read (lambda (relative) (readFile (join directory relative) "utf8")) :write (lambda (relative text) (writeFile (join directory relative) text)) :copy (lambda (from to) (cp (join directory from) (join directory to)))))))
      directory)))
  (defasync
    check
    (directory &rest __host_forwarded_arguments_2)
    (let* ((extra (aref __host_forwarded_arguments_2 0)))
    (let*
      ((ext (or extra (js-array))) (cmd (js-call (js-array (get globalThis.process :execPath) (get state :program) "--root" directory "--json") :concat ext)) (res (await (run cmd))) (stdout (get res :stdout)) (stderr (get res :stderr)))
      (when
        (and (not= (js-call stderr :trim) "") (= (js-call stdout :trim) ""))
        (throw (new globalThis.Error (js-call stderr :trim))))
      (js-object :exitCode (get res :exitCode) :report (js-call globalThis.JSON :parse stdout)))))
  (defun
    codes
    (report)
    (js-call (get report :issues) :map (lambda (issue) (get issue :code))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-specs-")))) (program (resolve staging "spec-check.mjs")) (__ign_17 (put state :staging staging)) (__ign_18 (put state :program program)) (build (await (run (js-array COMPILER "--output" program SOURCE)))))
        (when
          (not= (get build :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get build :stderr) :trim) (js-call (get build :stdout) :trim))))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "the maintained dogfood design passes every rule" (async () (let*
        ((directory (await (fixture))) (res (await (check directory))) (report (get res :report)) (specCount (get (js-call (await (readdir (join PROJECT "specs"))) :filter (lambda (name) (js-call (new globalThis.RegExp "^\\d{4}-.+[.]md$") :test name))) :length)))
        (js-call (expect (get report :ok)) :toBe t)
        (js-call (expect (get report :issueCount)) :toBe 0)
        (js-call (expect (get report :specCount)) :toBe specCount)
        (js-call (expect (get res :exitCode)) :toBe 0))))
  (test "a missing metadata field is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "specs/0001-product-contract.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (js-call text :replace "- Status: Accepted design\n" "")))))))) (res (await (check directory))))
        (js-call (expect (codes (get res :report))) :toContain "DF-METADATA")
        (js-call (expect (get res :exitCode)) :toBe 1))))
  (test "a heading identifier that disagrees with the file name is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "specs/0001-product-contract.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (js-call text :replace "# 0001: Product Contract" "# 0099: Product Contract")))))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-ID"))))
  (test "a prose criterion count that disagrees with the table is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "specs/0009-delivery-and-acceptance.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (js-call text :replace "All 13 criteria must pass" "All twelve criteria must pass")))))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-CRITERIA-PROSE"))))
  (test "a README acceptance denominator that disagrees with the table is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "README.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (js-call text :replace "| Final application acceptance | 0/13 (0%)" "| Final application acceptance | 0/12 (0%)")))))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-README"))))
  (test "a relative link that escapes the project root is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "README.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (str text "\n[Parent](../README.md)\n")))))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-LINK-ESCAPE"))))
  (test "a relative link with no target is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "specs/README.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (str text "\n[Missing](0099-absent.md)\n")))))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-LINK-MISSING"))))
  (test "a specification absent from the index is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "specs/README.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (js-call text :replace "| [0001](0001-product-contract.md) | Product Contract | Accepted design |\n" "")))))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-INDEX-MISSING"))))
  (test "an index entry for an absent specification is reported" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "specs/README.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (str text "\n| [0099](0099-absent.md) | Absent | Accepted design |\n")))))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-INDEX-STALE"))))
  (test "a duplicated specification identifier is reported" (async () (let*
        ((directory (await (fixture (async (ops) (await (js-call ops :copy "specs/0001-product-contract.md" "specs/0001-duplicate.md")))))))
        (js-call (expect (codes (get (await (check directory)) :report))) :toContain "DF-DUPLICATE"))))
  (test "a root that is not a directory fails without a stack trace" (async () (let*
        ((res (await (check (join PROJECT "absent")))) (report (get res :report)))
        (js-call (expect (get res :exitCode)) :toBe 1)
        (js-call (expect (get report :ok)) :toBe false)
        (js-call (expect (get report :error)) :toBe "root is not a directory"))))
  (test "the human report and exit status agree with the JSON report" (async () (let*
        ((directory (await (fixture (async (ops) (let*
                    ((relative "specs/0001-product-contract.md") (text (await (js-call ops :read relative))))
                    (await (js-call ops :write relative (js-call text :replace "- Status: Accepted design\n" "")))))))) (res (await (run (js-array (get globalThis.process :execPath) (get state :program) "--root" directory)))))
        (js-call (expect (get res :exitCode)) :toBe 1)
        (js-call (expect (get res :stdout)) :toContain "DF-METADATA")
        (js-call (expect (get res :stdout)) :toContain "issues: 1")))))
