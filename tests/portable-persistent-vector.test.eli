(module tests.portable-persistent-vector
  (import "bun:test" expect test)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries assertSourceMap sourceMap generatedModuleLoader be same)
  (import "./helpers/portable-structure.mjs" nextRandom nodeCount sharedNodeCount)
  (defconst importGeneratedModule (generatedModuleLoader "persistent-vector"))
  (test "Eliscript-authored persistent vector compiles and agrees across hosts"
    (async () (await (withPortableLibraries
      (js-object :module "persistent-vector" :sources (js-array "persistent-vector") :fixture "tests/fixtures/portable-vector-host.mjs" :loader false)
      (async (context)
        (let ((report (get context :report)))
          (js-call (expect report) :toMatchObject (js-object :persistent t :count 100000 :probes (js-array 0 31 32 1024 32768 99999)
            :original 54321 :updated "updated" :popped 99999 :sum 4999950000))
          (be (get report :sharedNodes) (get report :expectedSharedNodes)))
        (await (assertSourceMap (get context :seedDirectory) "persistent-vector" (js-array "(defportable persistent-vector-conj")))
        (js-call (expect (js-length (get (await (sourceMap (get context :seedDirectory) "persistent-vector")) :mappings))) :toBeGreaterThan 0))))) 30000)
  (test "Eliscript-authored persistent vector preserves generated history"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "generated-history")))
             (emptyPersistentVector (get module :empty_persistent_vector)) (persistentVectorCount (get module :persistent_vector_count))
             (persistentVectorNth (get module :persistent_vector_nth)) (persistentVectorConj (get module :persistent_vector_conj))
             (persistentVectorAssoc (get module :persistent_vector_assoc)) (persistentVectorPop (get module :persistent_vector_pop))
             (persistentVectorPeek (get module :persistent_vector_peek)) (persistentVectorToArray (get module :persistent_vector_to_array))
             (persistentVectorFromArray (get module :persistent_vector_from_array)) (random (js-object :value 5370206))
             (vector (emptyPersistentVector)) (model (js-array)) (step 0))
        (be (persistentVectorNth vector 0 "missing") "missing") (be (persistentVectorPeek vector "empty") "empty")
        (be (persistentVectorPop vector) nil) (be (persistentVectorAssoc vector -1 "invalid") nil) (be (persistentVectorAssoc vector 1.5 "invalid") nil)
        (while (< step 20000)
          (let* ((previousVector vector) (previousModel model) (choice (% (nextRandom random) 10)))
            (cond ((or (< choice 5) (= (js-length model) 0))
                     (let ((value (nextRandom random))) (setq vector (persistentVectorConj vector value) model (js-call model :concat (js-array value)))))
                  ((< choice 8) (let ((index (% (nextRandom random) (js-length model))) (value (nextRandom random)))
                                  (setq vector (persistentVectorAssoc vector index value) model (js-call model :slice)) (put model index value)))
                  ((= choice 8) (let ((value (nextRandom random))) (setq vector (persistentVectorAssoc vector (js-length model) value) model (js-call model :concat (js-array value)))))
                  (t (setq vector (persistentVectorPop vector) model (js-call model :slice 0 -1))))
            (be (persistentVectorCount vector) (js-length model)) (be (persistentVectorCount previousVector) (js-length previousModel))
            (when (> (js-length model) 0) (let ((probe (% (nextRandom random) (js-length model)))) (be (persistentVectorNth vector probe "missing") (aref model probe))))
            (when (> (js-length previousModel) 0) (let ((probe (% (nextRandom random) (js-length previousModel)))) (be (persistentVectorNth previousVector probe "missing") (aref previousModel probe)))))
          (setq step (1+ step)))
        (same (persistentVectorToArray vector) model) (same (persistentVectorToArray (persistentVectorFromArray model)) model))) 30000)
  (test "Eliscript-authored persistent vector keeps million-value trie bounds"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "million"))) (vector (funcall (get module :empty_persistent_vector))) (value 0))
        (while (< value 1000000) (setq vector (funcall (get module :persistent_vector_conj) vector value) value (1+ value)))
        (js-call (expect vector) :toMatchObject (js-object :count 1000000 :shift 15))
        (js-call (expect (get vector :tail)) :toHaveLength 32)
        (let ((probes (js-array 0 31 32 1024 32768 500000 999999)) (index 0))
          (while (< index (js-length probes))
            (let ((probe (aref probes index))) (be (funcall (get module :persistent_vector_nth) vector probe "missing") probe)) (setq index (1+ index))))
        (let* ((updated (funcall (get module :persistent_vector_assoc) vector 500000 -1)) (depth (+ 1 (/ (get vector :shift) 5))) (nodes (nodeCount (get vector :root) (get vector :shift))))
          (be (sharedNodeCount (get vector :root) (get updated :root) (get vector :shift)) (- nodes depth))
          (be (funcall (get module :persistent_vector_nth) vector 500000 "missing") 500000) (be (funcall (get module :persistent_vector_nth) updated 500000 "missing") -1)))) 30000))
