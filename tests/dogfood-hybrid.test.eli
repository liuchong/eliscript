(module
  tests.dogfood-hybrid.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "playwright-core" chromium)
  (import "node:fs/promises" cp mkdtemp readFile rm writeFile)
  (import "node:path" join resolve)
  (import "../runtime/literals.mjs" hashMap keyword vector)
  (import "../tools/browser/matrix.mjs" serveTree)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    SITE
    (resolve ROOT "examples/dogfood/_site"))
  (defconst
    state
    (js-object :staging nil :server nil :origin nil :renderer nil :channels nil :chromiumAvailable t))
  (defun
    k
    (name)
    (keyword name))
  (defun
    mapOf
    (entries)
    (let*
      ((flat (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((pair (aref entries (get idx :i))))
          (js-call flat :push (k (aref pair 0)))
          (js-call flat :push (aref pair 1)))
        (put idx :i (+ (get idx :i) 1)))
      (apply hashMap flat)))
  (defun
    comment
    (id login body createdAt)
    (mapOf (js-array (js-array "id" id) (js-array "author" (mapOf (js-array (js-array "login" login) (js-array "url" nil)))) (js-array "body" body) (js-array "created-at" createdAt) (js-array "updated-at" createdAt) (js-array "url" (str "https://github.com/owner/repository/issues/42#issuecomment-" id)) (js-array "replies" (vector)))))
  (defun
    hybridChannel
    (&rest __host_forwarded_arguments_1)
    (let* ((overrides (aref __host_forwarded_arguments_1 0)))
    (mapOf (js-call (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "mode" (k "hybrid")) (js-array "count" 2) (js-array "updated-at" "2026-09-10T00:00:00Z") (js-array "binding" (mapOf (js-array (js-array "repository" "owner/repository") (js-array "number" 42)))) (js-array "items" (vector (comment 1 "writer" "<p>First.</p>" "2026-09-09T00:00:00Z") (comment 2 "writer" "<p>Second.</p>" "2026-09-10T00:00:00Z")))) :concat (or overrides (js-array))))))
  (defun
    snapshotChannel
    ()
    (mapOf (js-array (js-array "id" (k "issue-native")) (js-array "kind" (k "issue")) (js-array "mode" (k "snapshot")) (js-array "count" 1) (js-array "updated-at" "2026-09-10T00:00:00Z") (js-array "binding" (mapOf (js-array (js-array "repository" "owner/repository") (js-array "number" 42)))) (js-array "items" (vector (comment 1 "writer" "<p>Only.</p>" "2026-09-09T00:00:00Z"))))))
  (defun
    externalChannel
    ()
    (mapOf (js-array (js-array "id" (k "giscus")) (js-array "kind" (k "giscus")) (js-array "mode" (k "embed")) (js-array "items" (vector)) (js-array "count" 0) (js-array "provider-url" "https://giscus.app/"))))
  (defun
    markupFor
    (channel)
    (js-call (get state :renderer) :render_comment_channels (mapOf (js-array (js-array "id" "notes/x") (js-array "comment-channels" (vector channel))))))
  (defasync
    pageWith
    (name body)
    (let*
      ((source (await (readFile (join SITE "index.html") "utf8"))) (page (js-call source :replace "</main>" (str "<article class=\"article\">" body "</article></main>"))))
      (await (writeFile (join (get state :staging) "site" name) page "utf8"))
      (str (get state :origin) name)))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-hybrid-")))) (__ign_10 (put state :staging staging)) (built (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (join staging "build") "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get built :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get built :stderr) :trim) (js-call (get built :stdout) :trim)))))
        (put state :renderer (await (funcall (js* "(u) => import(u)") (join staging "build/src/renderer/server.mjs"))))
        (put state :channels (await (funcall (js* "(u) => import(u)") (join staging "build/src/builder/channels.mjs"))))
        (try
          (await (cp SITE (join staging "site") (js-object :recursive t)))
          (catch
            _
            (let*
              ((demo (await (run (js-array "bun" "run" "dogfood")))))
              (when
                (not= (get demo :exitCode) 0)
                (throw (new globalThis.Error (or (js-call (get demo :stderr) :trim) "the demo build failed"))))
              (await (cp SITE (join staging "site") (js-object :recursive t))))))
        (let*
          ((server (await (serveTree (join staging "site") 8903))))
          (put state :server server)
          (put state :origin (get server :origin)))
        (try
          (let*
            ((probe (await (js-call chromium :launch))))
            (await (js-call probe :close)))
          (catch
            _
            (put state :chromiumAvailable false))))))
  (afterAll (async () (when
        (get state :server)
        (js-call (get state :server) :stop)) (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "a hybrid channel serves its snapshot and asks for freshness" (lambda () (let*
        ((markup (markupFor (hybridChannel))))
        (js-call (expect markup) :toContain "data-comment-provider=\"GitHub Issues\"")
        (js-call (expect markup) :toContain "First.")
        (js-call (expect markup) :toContain "Second.")
        (js-call (expect markup) :toContain "data-comment-refresh=\"1\"")
        (js-call (expect markup) :toContain "data-comment-binding=\"owner/repository#42\"")
        (js-call (expect markup) :toContain "data-comment-count=\"2\"")
        (js-call (expect markup) :toContain "data-comment-kind=\"issue\"")
        (js-call (expect markup) :toContain "Snapshot")
        (js-call (expect markup) :toContain "2026-09-10T00:00:00Z")
        (js-call (expect markup) :toContain "https://github.com/owner/repository/issues/42")
        (js-call (expect markup) :toContain "<span class=\"refresh-verdict\"></span>"))))
  (test "a snapshot-only channel makes no freshness claim" (lambda () (let*
        ((markup (markupFor (snapshotChannel))))
        (js-call (expect markup) :toContain "Only.")
        (js-call (get (expect markup) :not) :toContain "data-comment-refresh")
        (js-call (get (expect markup) :not) :toContain "refresh-verdict"))))
  (test "an empty hybrid snapshot still offers the check" (lambda () (let*
        ((markup (markupFor (hybridChannel (js-array (js-array "items" (vector)) (js-array "count" 0))))))
        (js-call (expect markup) :toContain "No comments in this snapshot yet.")
        (js-call (expect markup) :toContain "data-comment-refresh=\"1\""))))
  (test "the browser reports how much has changed since the snapshot" (async () (when
        (get state :chromiumAvailable)
        (let*
          ((url (await (pageWith "hybrid-more.html" (markupFor (hybridChannel))))) (browser (await (js-call chromium :launch))))
          (try
            (let*
              ((page (await (js-call browser :newPage))))
              (await (js-call page :route "https://api.github.com/**" (lambda (route) (js-call route :fulfill (js-object :status 200 :contentType "application/json" :body (js-call globalThis.JSON :stringify (js-array (js-object :id 1 :body "First." :user (js-object :login "writer") :created_at "2026-09-09T00:00:00Z") (js-object :id 2 :body "Second." :user (js-object :login "writer") :created_at "2026-09-10T00:00:00Z") (js-object :id 3 :body "Third." :user (js-object :login "writer") :created_at "2026-09-11T00:00:00Z"))))))))
              (await (js-call page :goto url (js-object :waitUntil "networkidle")))
              (let*
                ((verdict (await (js-call (js-call (js-call page :locator ".refresh-verdict") :first) :innerText))))
                (js-call (expect verdict) :toContain "3 comments now")
                (js-call (expect verdict) :toContain "2 when this snapshot was taken")))
            (finally
              (await (js-call browser :close))))))))
  (test "a snapshot that is still current says so" (async () (when
        (get state :chromiumAvailable)
        (let*
          ((url (await (pageWith "hybrid-same.html" (markupFor (hybridChannel))))) (browser (await (js-call chromium :launch))))
          (try
            (let*
              ((page (await (js-call browser :newPage))))
              (await (js-call page :route "https://api.github.com/**" (lambda (route) (js-call route :fulfill (js-object :status 200 :contentType "application/json" :body (js-call globalThis.JSON :stringify (js-array (js-object :id 1 :body "First." :user (js-object :login "writer") :created_at "2026-09-09T00:00:00Z") (js-object :id 2 :body "Second." :user (js-object :login "writer") :created_at "2026-09-10T00:00:00Z"))))))))
              (await (js-call page :goto url (js-object :waitUntil "networkidle")))
              (js-call (expect (await (js-call (js-call (js-call page :locator ".refresh-verdict") :first) :innerText))) :toContain "this snapshot is current"))
            (finally
              (await (js-call browser :close))))))))
  (test "a provider that cannot be reached leaves the snapshot standing" (async () (when
        (get state :chromiumAvailable)
        (let*
          ((url (await (pageWith "hybrid-fail.html" (markupFor (hybridChannel))))) (browser (await (js-call chromium :launch))))
          (try
            (let*
              ((page (await (js-call browser :newPage))))
              (await (js-call page :route "https://api.github.com/**" (lambda (route) (js-call route :abort))))
              (await (js-call page :goto url (js-object :waitUntil "networkidle")))
              (js-call (expect (await (js-call (js-call (js-call page :locator ".refresh-verdict") :first) :innerText))) :toContain "could not be checked")
              (js-call (expect (await (js-call (js-call (js-call page :locator ".comments") :first) :innerText))) :toContain "First."))
            (finally
              (await (js-call browser :close))))))))
  (test "a native channel and an external channel render together, in order" (lambda () (let*
        ((markup (js-call (get state :renderer) :render_comment_channels (mapOf (js-array (js-array "id" "notes/x") (js-array "comment-channels" (vector (snapshotChannel) (externalChannel))))))) (native-pos (js-call markup :indexOf "data-comment-provider=\"GitHub Issues\"")) (external-pos (js-call markup :indexOf "data-comment-mount=\"giscus\"")))
        (js-call (expect native-pos) :toBeGreaterThan -1)
        (js-call (expect external-pos) :toBeGreaterThan native-pos)
        (js-call (expect markup) :toContain "comments-list")
        (js-call (expect markup) :toContain "embed-region")
        (js-call (expect markup) :toContain "https://giscus.app/"))))
  (test "the reported snapshot count is the build's, not a constant" (lambda () (let*
        ((channels (get state :channels)) (mk-post (lambda (list) (mapOf (js-array (js-array "id" "notes/x") (js-array "comment-channels" (apply vector list)))))))
        (js-call (expect (js-call channels :snapshot_count (vector))) :toBe 0)
        (js-call (expect (js-call channels :snapshot_count (vector (mk-post (js-array (snapshotChannel))) (mk-post (js-array (hybridChannel) (externalChannel)))))) :toBe 2)
        (js-call (expect (js-call channels :snapshot_count (vector (mk-post (js-array (externalChannel)))))) :toBe 0))))
  (test "an old snapshot is still labelled with its date" (lambda () (let*
        ((stale (snapshotChannel)) (markup (markupFor stale)) (hybrid (markupFor (hybridChannel (js-array (js-array "updated-at" "2020-01-01T00:00:00Z"))))))
        (js-call (expect markup) :toContain "2026-09-10T00:00:00Z")
        (js-call (expect markup) :toContain "Snapshot from")
        (js-call (expect hybrid) :toContain "2020-01-01T00:00:00Z")
        (js-call (expect hybrid) :toContain "data-comment-refresh=\"1\""))))
  (test "the configured mode must be one the specification names" (async () (let*
        ((config (resolve ROOT "examples/dogfood/src/support/config.eli")) (source (await (readFile config "utf8"))))
        (js-call (expect source) :toContain "DOGFOOD-CONFIG-014")
        (js-call (expect source) :toContain "must be snapshot, live, hybrid, or embed")))))
