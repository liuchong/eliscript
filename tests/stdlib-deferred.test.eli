(module tests.stdlib-deferred
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (defasync build (output json)
    (await (runSuccessful (js-call (js-array BUILD) :concat (if json (js-array "--json") (js-array))
      (js-array "--root" (resolve ROOT "stdlib") "--out-dir" output "--no-cache" (resolve ROOT "stdlib/deferred.eli"))) (js-object))))
  (test "deferred computations compile and agree across local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-deferred-")))) (outputRoot (resolve directory "stdlib")) (usageModule (resolve directory "deferred-usage.mjs")))
      (try
        (let ((report (JSON/parse (await (build outputRoot t)))))
          (js-call (expect report) :toMatchObject (js-object :format "eliscript-build-report" :version 1 :counts (js-object :modules 7 :compiled 7 :reused 0) :entry "deferred.eli" :entryOutput "deferred.mjs")))
        (await (compile (resolve ROOT "tests/fixtures/deferred-usage.eli") usageModule))
        (let ((hosts (js-array (get globalThis.process :execPath) (get (get globalThis.process :env) :NODE_BINARY "node"))) (index 0))
          (while (< index (js-length hosts))
            (same (JSON/parse (await (runSuccessful (js-array (aref hosts index) usageModule) (js-object)))) (js-object "delay" (js-object "recognized" t "before" false "after" t "same" t "value" (js-array 20 22) "calls" 1 "passthrough" 9) "memo" (js-object "first" 42 "second" 42 "undefined" t "calls" 2)))
            (setq index (1+ index))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 60000)
  (test "delay and memoize retry failures without caching partial state" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-deferred-")))) (outputRoot (resolve directory "stdlib")))
      (try
        (await (build outputRoot false))
        (let* ((library (await (funcall load-module (str (get (pathToFileURL (resolve outputRoot "deferred.mjs")) :href) "?failures"))))
               (forged (js-object :kind "eliscript/delay" :realized (lambda () t) :force (lambda () 42))))
          (be (js-call library :delay_QMARK_ forged) false) (be (js-call library :realized_QMARK_ forged) false)
          (be (js-call library :realized_QMARK_ 9) false) (be (js-call library :force forged) forged)
          (let* ((attempts 0) (retried (js-call library :delay (lambda () (setq attempts (1+ attempts)) (when (= attempts 1) (throw (new globalThis.Error "retry"))) false))))
            (be (Object/isFrozen retried) t) (js-call (expect (lambda () (js-call library :force retried))) :toThrow "retry")
            (be (js-call library :realized_QMARK_ retried) false)
            (be (js-call library :force retried) false) (be (js-call library :force retried) false) (be attempts 2))
          (let* ((undefinedCalls 0) (undefinedDelay (js-call library :delay (lambda () (setq undefinedCalls (1+ undefinedCalls)) undefined))))
            (js-call (expect (js-call library :force undefinedDelay)) :toBeUndefined)
            (js-call (expect (js-call library :force undefinedDelay)) :toBeUndefined)
            (be (js-call library :realized_QMARK_ undefinedDelay) t) (be undefinedCalls 1))
          (let ((recursive undefined))
            (setq recursive (js-call library :delay (lambda () (js-call library :force recursive))))
            (try (js-call library :force recursive) (throw (new globalThis.Error "expected recursive force to fail"))
              (catch error (be (get error :code) "ELI-DEFERRED-REENTRANT-FORCE")))
            (be (js-call library :realized_QMARK_ recursive) false))
          (let* ((memoAttempts 0) (cached (js-call library :memoize (lambda (value) (setq memoAttempts (1+ memoAttempts)) (when (= memoAttempts 1) (throw (new globalThis.Error "memo retry"))) value))))
            (js-call (expect (lambda () (funcall cached nil))) :toThrow "memo retry")
            (js-call (expect (funcall cached nil)) :toBeNull) (js-call (expect (funcall cached nil)) :toBeNull) (be memoAttempts 2))
          (let ((operations (js-array
            (js-array (lambda () (js-call library :delay 1)) "ELI-DEFERRED-INVALID-PRODUCER")
            (js-array (lambda () (js-call library :memoize nil)) "ELI-DEFERRED-INVALID-FUNCTION"))) (index 0))
            (while (< index (js-length operations))
              (let ((pair (aref operations index)))
                (try (funcall (aref pair 0)) (throw (new globalThis.Error "expected invalid deferred operation to fail"))
                  (catch error (be (get error :code) (aref pair 1)))))
              (setq index (1+ index)))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 60000)
)
