(module tests.compiler-js-array-text-call.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" mkdtemp writeFile readFile rm mkdir)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "./helpers/array-text-call-contract.mjs" check checkQualifiedApply)
  (defvar directory undefined) (defvar compiler undefined)
  (defconst source "\n(defun empty (value) (js-call value :join))\n(defun literals (value) (js-call value :join \"|\" 0 -0.0 nil t false undefined))\n(defun computed (receiver key) (js-call (funcall receiver) (funcall key) \"|\"))\n(defun reference (value separator) (js-call value :join separator))\n(defun effect (value next) (js-call value :join (funcall next)))\n(defun extra (value next) (js-call value :join \"|\" (funcall next)))\n(defun getter (value options) (js-call value :join (get options :separator)))\n(defun raw (value) (js-call value :join (js* \"'|'\")))\n(defun tagged (value) (js-call value :join :separator))\n(defun allocated (value) (js-call value :join (js-array)))\n(defun quoted (value) (js-call value :join '(1 2)))\n(defun thrown (value marker) (js-call value :join (throw marker)))\n(defasync pending (value separator) (js-call value :join (await separator)))\n(defun text (value) (js-call value :toString))\n(defun borrowed-join () (get (js* \"Array.prototype\") :join))\n(defun borrowed-text () (get (js* \"Array.prototype\") :toString))\n(defun method-call (method value separator) (js-call method :call value separator))\n(defun method-apply (method value args) (js-call method :apply value args))\n(defun method-bind (method value separator) (js-call method :bind value separator))\n(defun bind-receiver (method value) (js-call method :bind value))\n(defun bind-again (bound value separator) (js-call bound :bind value separator))\n(defun invoke-bound (bound separator) (funcall bound separator))\n(defun external-bound (callback bound) (funcall callback bound))\n(defun nested-call (method value separator)\n  (js-call (get (js* \"Function.prototype\") :call) :call method value separator))\n(defun nested-apply-call (method value args)\n  (js-call (get (js* \"Function.prototype\") :apply) :call method value args))\n(defun nested-call-apply (method value separator)\n  (js-call (get (js* \"Function.prototype\") :call) :apply method (js-array value separator)))\n(defun nested-apply (method value args)\n  (js-call (get (js* \"Function.prototype\") :apply) :apply method (js-array value args)))\n(defun reflected (method value args) (Reflect/apply method value args))\n(export empty literals computed reference effect extra getter raw tagged allocated quoted thrown pending text\n  borrowed-join borrowed-text method-call method-apply method-bind bind-receiver bind-again invoke-bound\n  external-bound nested-call nested-apply-call nested-call-apply nested-apply reflected)")
  (defconst qualifiedApplySource "\n(defun reflected-only (method value args) (Reflect/apply method value args))\n(defun reflected-funcall (method value args) (funcall Reflect/apply method value args))\n(defun reflected-spread (args) (apply Reflect/apply args))\n(defun namespace-apply (receiver method value args) (receiver/apply method value args))\n(defun dotted-apply (receiver method value args) (receiver.apply method value args))\n(defun shadowed-apply (Reflect method value args) (Reflect/apply method value args))\n(defun captured-apply (receiver method value args)\n  (receiver/apply (funcall method) (funcall value) (funcall args)))\n(defun apply-reference () Reflect/apply)\n(defun namespace-reference (receiver) receiver/apply)\n(export reflected-only reflected-funcall reflected-spread namespace-apply dotted-apply\n  shadowed-apply captured-apply apply-reference namespace-reference)")
  (defconst load (js* "(specifier) => import(specifier)"))
  (defconst capsuleConsumers (js-array "runtime/core/protocol-impl.mjs" "tests/snapshots/core.mjs"))
  (defconst driver (fileURLToPath (new globalThis.URL "./fixtures/array-text-call-host.mjs" (js* "import.meta.url"))))
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun contains (text token &rest __host_forwarded_arguments_3)
    (let* ((label (aref __host_forwarded_arguments_3 0))) (assert (js-call text :includes token) label)))
  (defun rx (source &rest __host_forwarded_arguments_4)
    (let* ((flags (aref __host_forwarded_arguments_4 0))) (new globalThis.RegExp source flags)))
  (defasync loadCode (code) (load (str "data:text/javascript;base64," (js-call (Buffer/from code) :toString "base64"))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-literal-method-"))))
    (let* ((out (resolve directory "compiler")) (build (spawnSync (resolve "bin/eliscript-bootstrap") (js-array)
      (js-object :encoding "utf8" :timeout 30000 :env (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR out))))))
      (eqv (get build :status) 0 (get build :stderr)) (setq compiler (await (load (get (pathToFileURL (resolve out "compiler.mjs")) :href)))))) 30000)
  (afterAll (async () (await (rm directory (js-object :recursive t :force t)))))
  (defasync capsuleMaintenanceFixture (name)
    (let* ((root (resolve directory name)) (parts (js-array "tools/compiler" "runtime" "compiler" "bootstrap/compiler" "contracts")) (i 0)
           (old (js-array "data:text/javascript;base64,b2xkLWNhcHN1bGUtMQ==" "data:text/javascript;base64,b2xkLWNhcHN1bGUtMg=="))
           (declarations (js-array (js-array "compiler/eliscript-emitter.el" "eliscript-emitter--array-text-import") (js-array "bootstrap/compiler/emitter.eli" "array-text-import")))
           (contract (js-object :schemaVersion 1 :preserved (js-object :value "original contract field") :imports (js-object :specialSpecifiers
             (js-array (js-object :prefix "node:" :allowedRoots (js-array "tools/")) (js-object :specifier "z-last" :allowedRoots (js-array "tests/"))
               (js-object :specifier (aref old 0) :allowedRoots capsuleConsumers) (js-object :prefix "aaa:" :allowedRoots (js-array "runtime/"))
               (js-object :specifier "a-first" :allowedRoots (js-array "runtime/")) (js-object :specifier (aref old 1) :allowedRoots capsuleConsumers))))))
      (while (< i (get parts :length)) (await (mkdir (resolve root (aref parts i)) (js-object :recursive t))) (setq i (1+ i)))
      (await (writeFile (resolve root "tools/compiler/array-text-capsule.mjs") (await (readFile "tools/compiler/array-text-capsule.mjs" "utf8"))))
      (await (writeFile (resolve root "runtime/array-text.mjs")
        (await (readFile (fileURLToPath (new globalThis.URL "./fixtures/array-text-maintenance-runtime.mjs" (js* "import.meta.url"))) "utf8"))))
      (setq i 0)
      (while (< i (get declarations :length))
        (let* ((pair (aref declarations i)) (prelude (str "import { c as __eliscript_at, d as __eliscript_at_direct } from " (JSON/stringify (aref old i)) ";\n")))
          (await (writeFile (resolve root (aref pair 0)) (str "(defconst " (aref pair 1) " " (JSON/stringify prelude) ")\n"))))
        (setq i (1+ i)))
      (await (writeFile (resolve root "contracts/repository-integrity.json") (str (JSON/stringify contract nil 2) "\n")))
      (js-object :root root :api (await (load (get (pathToFileURL (resolve root "tools/compiler/array-text-capsule.mjs")) :href))) :old old :contract contract :declarations declarations)))
  (defun declarationFiles (fixture) (js-call (get fixture :declarations) :map (lambda (pair) (aref pair 0))))
  (defasync fixtureFiles (fixture files) (Promise/all (js-call files :map (lambda (file) (readFile (resolve (get fixture :root) file) "utf8")))))
  (defun preludeSpecifier (prelude)
    (let ((match (js-call (rx "from (\"(?:[^\"\\\\]|\\\\.)*\");\\n$") :exec prelude))) (assert match) (JSON/parse (aref match 1))))
  (defun body (code name)
    (let* ((start (js-call code :indexOf (str "function " name "("))) (next (js-call code :indexOf "\nfunction " (1+ start))))
      (assert (>= start 0) name) (js-call code :slice start (if (< next 0) undefined next))))
  (defun runHost (host output mode)
    (let ((child (spawnSync host (js-array driver (get (pathToFileURL output) :href) mode) (js-object :encoding "utf8" :timeout 30000))))
      (eqv (get child :status) 0 (str host ": " (get child :stderr)))))
  (test "array text capsule maintenance pins the exact generated URL at two actual consumers and orders exact selectors before prefixes" (async ()
    (let* ((fixture (await (capsuleMaintenanceFixture "capsule-integrity-order"))) (api (get fixture :api))
           (files (js-call (declarationFiles fixture) :concat (js-array "contracts/repository-integrity.json"))) (before (await (fixtureFiles fixture files))))
      (await (js-call assert :rejects (lambda () (js-call api :checkArrayTextCapsule)) (lambda (error)
        (js-call assert :match (get error :message) (rx "array text capsule is stale"))
        (js-call files :forEach (lambda (file) (contains (get error :message) file file))) t)))
      (same (await (fixtureFiles fixture files)) before "check mode never writes a partially refreshed contract")
      (let* ((result (await (js-call api :checkArrayTextCapsule (js-object :write t)))) (preludes (js-array)) (pairs (get fixture :declarations)) (i 0))
        (same (get result :changed) files) (assert (> (get result :bytes) 0))
        (while (< i (get pairs :length))
          (let* ((text (await (readFile (resolve (get fixture :root) (aref (aref pairs i) 0)) "utf8")))
                 (match (js-call (rx "\\(defconst [^\\s]+ (\"(?:[^\"\\\\]|\\\\.)*\")\\)") :exec text)))
            (assert match) (js-call preludes :push (JSON/parse (aref match 1))))
          (setq i (1+ i)))
        (eqv (aref preludes 0) (aref preludes 1)) (eqv (Buffer/byteLength (aref preludes 0)) (get result :bytes))
        (let* ((specifier (preludeSpecifier (aref preludes 0))) (saved (JSON/parse (await (readFile (resolve (get fixture :root) "contracts/repository-integrity.json") "utf8")))))
          (js-call assert :match specifier (rx "^data:text/javascript;base64,")) (assert (not (js-call (get fixture :old) :includes specifier)))
          (same (get saved :preserved) (get (get fixture :contract) :preserved))
          (same (get (get saved :imports) :specialSpecifiers) (js-array
            (js-object :specifier "a-first" :allowedRoots (js-array "runtime/")) (js-object :specifier specifier :allowedRoots capsuleConsumers)
            (js-object :specifier "z-last" :allowedRoots (js-array "tests/")) (js-object :prefix "aaa:" :allowedRoots (js-array "runtime/")) (js-object :prefix "node:" :allowedRoots (js-array "tools/"))))
          (eqv (get (js-call (get (get saved :imports) :specialSpecifiers) :filter (lambda (record) (= (get record :specifier) specifier))) :length) 1)
          (eqv (js-call (get (get saved :imports) :specialSpecifiers) :some (lambda (record) (and (not (nullish? (get record :prefix))) (js-call (get record :prefix) :startsWith "data:")))) false "no broad data-import permission is generated")
          (same (get (await (js-call api :checkArrayTextCapsule)) :changed) (js-array) "an actual second generation is deterministic and already pinned"))))) 30000)
  (test "array text capsule maintenance rejects broadened reordered or incomplete consumer roots before publishing either compiler declaration" (async ()
    (let* ((fixture (await (capsuleMaintenanceFixture "capsule-integrity-roots"))) (api (get fixture :api)) (specifier (preludeSpecifier (await (js-call api :renderArrayTextImport))))
           (before (await (fixtureFiles fixture (declarationFiles fixture))))
           (variants (js-array (js-array) (js-array "runtime/" "tests/") (js-call (js-call capsuleConsumers :slice) :reverse) (js-call capsuleConsumers :slice 0 1) (js-call capsuleConsumers :concat (js-array "other.mjs")))) (i 0))
      (while (< i (get variants :length))
        (let* ((allowedRoots (aref variants i)) (contract (globalThis.structuredClone (get fixture :contract))) (path (resolve (get fixture :root) "contracts/repository-integrity.json")))
          (js-call (get (get contract :imports) :specialSpecifiers) :push (js-object :specifier specifier :allowedRoots allowedRoots))
          (let ((text (str (JSON/stringify contract nil 2) "\n")))
            (await (writeFile path text))
            (await (js-call assert :rejects (lambda () (js-call api :checkArrayTextCapsule (js-object :write t))) (rx "array text capsule integrity roots differ")))
            (eqv (await (readFile path "utf8")) text)
            (same (await (fixtureFiles fixture (declarationFiles fixture))) before)))
        (setq i (1+ i))))) 30000)
  (test "only primitive literal arguments and zero arguments use the closure-free array text entry" (lambda ()
    (let ((code (js-call compiler :compile_string source "literal-method.eli")))
      (js-call (js-array "empty" "literals" "computed" "text") :forEach (lambda (name)
        (contains (body code name) "__eliscript_at_direct(" (body code name)) (assert (not (js-call (body code name) :includes "__eliscript_at(")))))
      (js-call (js-array "reference" "effect" "extra" "getter" "raw" "tagged" "allocated" "quoted" "thrown" "pending") :forEach (lambda (name) (contains (body code name) "__eliscript_at(" (body code name)))))))
  (test "literal direct calls and effectful captured calls preserve independent native lookup, this, identity, error and await order" (async ()
    (await (check (await (loadCode (js-call compiler :compile_string source "literal-method.eli")))))))
  (test "qualified apply calls capture the actual namespace property without changing first-class identity or argument order" (async ()
    (let* ((input (resolve directory "qualified-apply.eli")) (output (resolve directory "qualified-apply.mjs")) (javascript (js-call compiler :compile_string qualifiedApplySource input)))
      (await (writeFile input qualifiedApplySource))
      (contains javascript "c as __eliscript_at" "qualified calls alone require the shared dispatch import")
      (await (checkQualifiedApply (await (loadCode javascript))))
      (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
        (eqv (get seed :status) 0 (get seed :stderr)) (eqv (await (readFile output "utf8")) javascript))
      (js-call (js-array "node" "bun") :forEach (lambda (host) (runHost host output "qualified"))))) 30000)
  (test "public Seed IR output matches bootstrap and Node and Bun execute the same method-order oracles" (async ()
    (let* ((input (resolve directory "source.eli")) (output (resolve directory "source.mjs")))
      (await (writeFile input source))
      (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
        (eqv (get seed :status) 0 (get seed :stderr)) (eqv (await (readFile output "utf8")) (js-call compiler :compile_string source input)))
      (await (writeFile output (js-call (await (readFile output "utf8")) :replaceAll "from \"eliscript/runtime/literals.mjs\"" (str "from " (JSON/stringify (get (pathToFileURL (resolve "runtime/literals.mjs")) :href))))))
      (js-call (js-array "node" "bun") :forEach (lambda (host) (runHost host output "ordinary"))))))
  (test "ground Seed emits direct calls for scalar literals and keeps raw, keyword, identifiers and calls on the capture path" (lambda ()
    (let* ((forms (js-array "(js-call value :join)" "(js-call value :join \"|\" 0 -0.0 nil t false undefined)" "(js-call (funcall receiver) (funcall key) \"|\")" "(js-call value :join separator)" "(js-call value :join :separator)" "(js-call value :join (js* \"'|'\"))" "(js-call value :join (funcall next))")) (script "(progn (require 'json) (require 'eliscript-emitter) (princ (json-serialize (vconcat (mapcar (lambda (text) (eliscript-emitter-emit-expression (car (read-from-string text)))) (json-parse-string (getenv \"ELISCRIPT_LITERAL_FORMS\") :array-type 'list))))))")
           (child (spawnSync (if (nullish? (get (get process :env) :EMACS)) "emacs" (get (get process :env) :EMACS))
             (js-array "--batch" "-Q" "-L" "compiler" "--eval" script)
             (js-object :encoding "utf8" :timeout 30000 :env (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_LITERAL_FORMS (JSON/stringify forms)))))))
      (eqv (get child :status) 0 (get child :stderr))
      (js-call (JSON/parse (get child :stdout)) :forEach (lambda (code index) (contains code (if (< index 3) "__eliscript_at_direct(" "__eliscript_at(") code))))))
  (test "the new direct alias remains reserved in bindings and references" (lambda ()
    (js-call (js-array "(defconst __eliscript_at_direct 1)" "(defun alias () __eliscript_at_direct)") :forEach (lambda (input)
      (js-call assert :throws (lambda () (js-call compiler :compile_string input "reserved.eli")) (rx "reserved compiler prefix|unbound symbol"))))))
)
