(module tests.compatibility-rehearsal.test
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve join)
  (import "../tools/compatibility/rehearse.mjs" checkCompatibilityRehearsal CompatibilityRehearsalError humanCompatibilityReport verifyCompatibilityRun)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defasync readJson (file) (JSON/parse (await (readFile (join ROOT file) "utf8"))))
  (defasync contract () (readJson "contracts/compatibility-rehearsal.json"))
  (defasync errorsFor (value)
    (let ((failed false) (errors undefined))
      (try (await (checkCompatibilityRehearsal (js-object :root ROOT :contract value)))
        (catch error (js-call (expect error) :toBeInstanceOf CompatibilityRehearsalError) (setq failed t) (setq errors (get error :errors))))
      (if failed errors (throw (new globalThis.Error "expected compatibility rehearsal validation to fail")))))
  (defasync verificationErrors (report)
    (let ((failed false) (errors undefined))
      (try (await (verifyCompatibilityRun (js-object :root ROOT :report report)))
        (catch error (js-call (expect error) :toBeInstanceOf CompatibilityRehearsalError) (setq failed t) (setq errors (get error :errors))))
      (if failed errors (throw (new globalThis.Error "expected compatibility rehearsal verification to fail")))))
  (test "compatibility rehearsal contract freezes local core transitions" (async ()
    (let ((report (await (checkCompatibilityRehearsal (js-object :root ROOT)))))
      (js-call (expect (get report :stablePrograms)) :toBe 1) (js-call (expect (get report :migrations)) :toBe 3)
      (js-call (expect (get report :scope)) :toEqual (js-object "kind" "migration-rehearsal" "completesAc02" false "applicationEvidence" false)))))
  (test "compatibility rehearsal rejects missing migration history" (async ()
    (let ((value (await (contract))))
      (js-call (get value :migrations) :pop)
      (js-call (expect (await (errorsFor value))) :toContain "migrations must contain the complete version 1 transition inventory"))))
  (test "compatibility rehearsal rejects application evidence and AC-02 promotion" (async ()
    (let ((value (await (contract))))
      (put (get value :scope) :applicationEvidence t) (put (get value :scope) :completesAc02 t)
      (js-call (expect (await (errorsFor value))) :toContain "scope must remain a non-application rehearsal that does not complete AC-02"))))
  (test "compatibility rehearsal human report preserves evidence boundaries" (lambda ()
    (let ((output (humanCompatibilityReport (js-object "source" (js-object "commit" "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "tree" "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb") "generatedAt" "2026-09-08T00:00:00.000Z" "environment" (js-object "operatingSystem" "Darwin test" "architecture" "arm64" "bunVersion" "1.4.0" "nodeVersion" "26.0.0" "emacsVersion" "31.1") "cases" (js-array (js-object "id" "framework-neutral-core" "kind" "contract-replacement" "status" "pass" "durationMs" 0 "fromSpec" "0010" "toSpec" "0118")) "artifacts" (js-array ) "summary" (js-object "cleanBefore" t "cleanAfter" t "applicationEvidence" false "completesAc02" false "validationPass" t)))))
      (js-call (expect output) :toContain "Application evidence: no")
      (js-call (expect output) :toContain "Completes AC-02: no")
      (js-call (expect output) :toContain "Local rehearsal: pass"))))
  (test "retained compatibility rehearsal is source-bound local evidence" (async ()
    (let ((report (await (verifyCompatibilityRun (js-object :root ROOT :runFile "acceptance/runs/m13-03.json" :markdownFile "acceptance/runs/m13-03.md")))))
      (js-call (expect (get report :summary)) :toMatchObject (js-object "required" 4 "passed" 4 "failed" 0 "cleanBefore" t "cleanAfter" t "applicationEvidence" false "completesAc02" false "validationPass" t)))))
  (test "retained compatibility rehearsal rejects a forged AC-02 claim" (async ()
    (let ((report (await (readJson "acceptance/runs/m13-03.json"))))
      (put (get report :summary) :completesAc02 t)
      (js-call (expect (await (verificationErrors report))) :toContain "run summary must be a passing non-application rehearsal without AC-02 completion"))))
)
