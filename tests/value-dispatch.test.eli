(module tests.value-dispatch
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (defconst root (resolve (js* "import.meta.dir") ".."))
  (defconst seedCompiler (resolve root "bin/eliscript-seed"))
  (defconst portableCompiler (resolve root "bin/eliscript-portable"))
  (defconst source (resolve root "tests/fixtures/value-dispatch.eli"))
  (defconst output "tests/fixtures/value-dispatch.mjs")
  (defconst hostFixture (resolve root "tests/fixtures/value-dispatch-host.mjs"))
  (defconst bunPreload (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
  (defconst nodeLoader (resolve root "tests/fixtures/compiled-eli-node-loader.mjs"))
  (defconst emacs (get (get globalThis.process :env) :EMACS "emacs"))
  (defasync runSuccessful (command extraEnvironment)
    (when (undefined? extraEnvironment) (setq extraEnvironment (js-object)))
    (let* ((child (js-call globalThis.Bun :spawn command (js-object :cwd root
                    :env (Object/assign (js-object) (get globalThis.process :env) (js-object :EMACS emacs) extraEnvironment)
                    :stdout "pipe" :stderr "pipe")))
           (parts (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref parts 0)) (stdout (aref parts 1)) (stderr (aref parts 2)))
      (unless (= exitCode 0)
        (let ((message (js-call stderr :trim)))
          (when (= (js-length message) 0) (setq message (js-call stdout :trim)))
          (throw (new globalThis.Error (if (> (js-length message) 0) message
            (str (aref command 0) " exited with " exitCode)))))) stdout))
  (Object/defineProperty runSuccessful "length" (js-object :value 1 :configurable t))
  (defasync compile (command outputRoot environment)
    (when (undefined? environment) (setq environment (js-object)))
    (let ((outputPath (resolve outputRoot output)))
      (await (mkdir (dirname outputPath) (js-object :recursive t)))
      (await (mkdir (resolve outputRoot "node_modules") (js-object :recursive t)))
      (await (symlink root (resolve outputRoot "node_modules/eliscript") "dir"))
      (await (symlink (resolve root "runtime") (resolve outputRoot "runtime") "dir"))
      (await (runSuccessful (js-array command "--source-map" "--output" outputPath source) environment)) outputPath))
  (Object/defineProperty compile "length" (js-object :value 2 :configurable t))

  (test "case and condp agree across compilers and local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-dispatch-"))))
           (bootstrapDirectory (resolve directory "bootstrap")) (seedDirectory (resolve directory "seed"))
           (selfHostedDirectory (resolve directory "self-hosted")))
      (try
        (let ((seedOutput (await (compile seedCompiler seedDirectory))))
          (await (seedCompilerFixture bootstrapDirectory))
          (let ((selfHostedOutput (await (compile portableCompiler selfHostedDirectory
                                    (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))))
            (js-call (expect (await (js-call (js-call globalThis.Bun :file selfHostedOutput) :text)))
              :toBe (await (js-call (js-call globalThis.Bun :file seedOutput) :text)))
            (js-call (expect (await (js-call (js-call globalThis.Bun :file (str selfHostedOutput ".map")) :text)))
              :toBe (await (js-call (js-call globalThis.Bun :file (str seedOutput ".map")) :text)))
            (let ((reports (js-array)) (modules (js-array seedOutput selfHostedOutput)) (index 0))
              (while (< index (js-length modules))
                (let ((modulePath (aref modules index)))
                  (js-call reports :push (JSON/parse (await (runSuccessful
                    (js-array "bun" "--preload" bunPreload hostFixture modulePath)))))
                  (js-call reports :push (JSON/parse (await (runSuccessful
                    (js-array (get (get globalThis.process :env) :NODE "node") "--experimental-loader" nodeLoader hostFixture modulePath))))))
                (setq index (1+ index)))
              (js-call reports :forEach (lambda (report) (js-call (expect report) :toEqual (aref reports 0))))
              (js-call (expect (aref reports 0)) :toEqual (js-object
                :report (js-object :grouped "small" :symbol "symbol" :vector "vector" :caseDefault "fallback"
                  :caseNil nil :caseObservations 2 :redirected "matched:hit-3" :condpDefault "fallback"
                  :condpObservations 1 :predicateCreations 1 :predicateCalls 2)
                :failure (js-object :name "TypeError" :message "condp found no matching clause"))))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
