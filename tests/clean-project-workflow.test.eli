(module tests.clean-project-workflow.test
  (import "node:process" :default process)
  (import "bun:test" expect test)
  (import "node:fs/promises" cp mkdir mkdtemp readFile realpath rm stat writeFile)
  (import "node:os" tmpdir)
  (import "node:path" :default path)
  (defconst ROOT (js-call path :resolve (js* "import.meta.dir") ".."))
  (defconst EXAMPLE (js-call path :join ROOT "examples/getting-started"))
  (defun nullishDefault (value fallback) (if (nullish? value) fallback value))
  (defun command (name) (js-call path :join ROOT "bin" name))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun matches (actual expected) (js-call (expect actual) :toMatchObject expected))
  (defasync exists (filename)
    (try (await (stat filename)) t
      (catch error (if (= (if (nullish? error) undefined (get error :code)) "ENOENT") false (throw error)))))
  (defasync run (command &rest __host_default_arguments_1)
    (let* ((options (aref __host_default_arguments_1 0)))
    (when (= options undefined) (setq options (js-object)))
    (let* ((child (Bun/spawn command (js-object :cwd (get options :cwd) :env (nullishDefault (get options :env) (get process :env))
             :stdin "ignore" :stdout "pipe" :stderr "pipe")))
           (timedOut false) (forceKillTimer undefined)
           (timer (globalThis.setTimeout (lambda () (setq timedOut t) (js-call child :kill "SIGTERM")
             (setq forceKillTimer (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 2000)))
             (nullishDefault (get options :timeoutMs) 20000))))
      (try
        (let* ((result (await (Promise/all (js-array (get child :exited)
                 (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
               (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
          (when timedOut (throw (new globalThis.Error (str (aref command 0) " exceeded its deadline"))))
          (when (not (= exitCode 0))
            (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
              (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str (aref command 0) " exited with " exitCode)))))))
          (js-object :exitCode exitCode :stdout stdout :stderr stderr))
        (finally (globalThis.clearTimeout timer) (globalThis.clearTimeout forceKillTimer))))))
  (defun lineReader (stream)
    (let ((reader (js-call stream :getReader)) (decoder (new globalThis.TextDecoder)) (buffered ""))
      (async ()
        (while (not (js-call buffered :includes "\n"))
          (let ((timer undefined))
            (let* ((deadline (new globalThis.Promise (lambda (_ reject)
                     (setq timer (globalThis.setTimeout (lambda () (reject (new globalThis.Error "configured watch event timed out"))) 10000)))))
                   (result (await (js-call (Promise/race (js-array (js-call reader :read) deadline)) :finally (lambda () (globalThis.clearTimeout timer))))))
              (when (get result :done) (throw (new globalThis.Error "configured watch event stream closed")))
              (setq buffered (str buffered (js-call decoder :decode (get result :value) (js-object :stream t)))))))
        (let* ((end (js-call buffered :indexOf "\n")) (line (js-call buffered :slice 0 end)))
          (setq buffered (js-call buffered :slice (1+ end))) line))))
  (defasync stopWatch (child)
    (js-call child :kill "SIGTERM")
    (let ((forceKillTimer (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 2000)))
      (try (await (get child :exited)) (finally (globalThis.clearTimeout forceKillTimer)))))
  (test "clean configured project runs the complete public workflow" (async ()
    (let* ((temporaryRoot (await (realpath (await (mkdtemp (js-call path :join (tmpdir) "eliscript-clean-workflow-"))))))
           (project (js-call path :join temporaryRoot "project")) (sourceRoot (js-call path :join project "src")) (configFile (js-call path :join project "eliscript.json")))
      (try
        (await (cp EXAMPLE project (js-object :recursive t)))
        (let ((originals (new globalThis.Map (await (Promise/all (js-call (js-array "eliscript.json" "src/main.eli" "src/math.eli") :map
                (async (filename) (js-array filename (await (readFile (js-call path :join project filename) "utf8"))))))))))
          (let ((sources (js-array "src/math.eli" "src/main.eli")) (index 0))
            (while (< index (get sources :length))
              (let ((formatted (await (run (js-array (command "eliscript-format") "--check" (aref sources index)) (js-object :cwd project)))))
                (matches formatted (js-object :exitCode 0 :stdout "" :stderr "")))
              (setq index (1+ index))))
          (let ((checked (JSON/parse (get (await (run (js-array (command "eliscript-check") "--json" "--config" "eliscript.json") (js-object :cwd project))) :stdout))))
            (matches checked (js-object :format "eliscript-check-report" :version 1 :status "ok" :counts (js-object :modules 2)))
            (same (js-call (get checked :modules) :map (lambda (module) (get module :source))) (js-array "main.eli" "math.eli")))
          (be (await (exists (js-call path :join project "dist"))) false)
          (let ((built (JSON/parse (get (await (run (js-array (command "eliscript-build") "--json" "--config" "eliscript.json") (js-object :cwd project))) :stdout))))
            (matches built (js-object :format "eliscript-build-report" :mode "standard" :root (await (realpath sourceRoot)) :outDir (js-call path :join project "dist")
              :entry "main.eli" :entryOutput "main.mjs" :counts (js-object :modules 2 :compiled 2 :reused 0))))
          (be (get (await (run (js-array (get process :execPath) "run" "dist/main.mjs") (js-object :cwd project))) :stdout) "42\n")
          (let* ((watcher (Bun/spawn (js-array (command "eliscript-watch") "--config" configFile "--interval" "25" "--json")
                   (js-object :cwd project :stdin "ignore" :stdout "pipe" :stderr "pipe")))
                 (watcherStderr (js-call (new globalThis.Response (get watcher :stderr)) :text)) (watchExit undefined))
            (try
              (let ((nextLine (lineReader (get watcher :stdout))))
                (matches (JSON/parse (await (nextLine))) (js-object :format "eliscript-watch-event" :version 1 :sequence 0 :event "ready" :root (await (realpath sourceRoot)) :changes (js-array)))
                (await (writeFile (js-call path :join sourceRoot "math.eli") "(module hello.math (defconst answer (+ 20 23)) (export answer))\n"))
                (matches (JSON/parse (await (nextLine))) (js-object :sequence 1 :event "change" :changes (js-array (js-object :path "math.eli" :kind "modify"))))
                (await (writeFile (js-call path :join sourceRoot "math.eli") (js-call originals :get "src/math.eli"))))
              (finally (setq watchExit (await (stopWatch watcher)))))
            (be watchExit 0) (be (await watcherStderr) ""))
          (await (writeFile (js-call path :join sourceRoot "override.eli") "(module hello.override (print 84))\n"))
          (await (mkdir (js-call path :join project "configured-src")))
          (await (writeFile (js-call path :join project "configured-src/configured.eli") "(module hello.configured (print 7))\n"))
          (await (writeFile configFile (str (JSON/stringify (js-object :schemaVersion 2 :sourceRoot "configured-src" :entries (js-array "configured.eli")
            :outDir "configured-dist" :portableEntries (js-array) :cache t)) "\n")))
          (let ((overrideCheck (JSON/parse (get (await (run (js-array (command "eliscript-check") "--json" "--config" "eliscript.json" "--root" "src" "src/override.eli") (js-object :cwd project))) :stdout))))
            (matches overrideCheck (js-object :root (await (realpath sourceRoot)) :counts (js-object :modules 1)))
            (same (js-call (get overrideCheck :modules) :map (lambda (module) (get module :source))) (js-array "override.eli")))
          (let ((overrideBuild (JSON/parse (get (await (run (js-array (command "eliscript-build") "--json" "--config" "eliscript.json" "--root" "src" "--out-dir" "cli-dist" "--no-cache" "src/override.eli") (js-object :cwd project))) :stdout))))
            (matches overrideBuild (js-object :root (await (realpath sourceRoot)) :outDir (js-call path :join project "cli-dist") :entry "override.eli" :entryOutput "override.mjs"
              :cache (js-object :enabled false :status "disabled" :reason "cache-disabled") :counts (js-object :modules 1 :compiled 1 :reused 0))))
          (be (await (exists (js-call path :join project "configured-dist"))) false)
          (be (get (await (run (js-array (get process :execPath) "run" "cli-dist/override.mjs") (js-object :cwd project))) :stdout) "84\n")
          (await (writeFile configFile (js-call originals :get "eliscript.json")))
          (let ((entries (Array/from originals)) (index 0))
            (while (< index (get entries :length))
              (let ((entry (aref entries index))) (be (await (readFile (js-call path :join project (aref entry 0)) "utf8")) (aref entry 1)))
              (setq index (1+ index)))))
        (finally (await (rm temporaryRoot (js-object :recursive t :force t))))))) 60000)
)
