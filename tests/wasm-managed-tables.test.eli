(module tests.wasm-managed-tables.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../runtime/core/value.mjs" hashValue)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst node-helper (resolve "tests/helpers/wasm-managed-tables-node.mjs"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar bytes nil)
  (defvar program nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-tables-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let ((source (await (readFile (resolve "bootstrap/runtime/memory.eli") "utf8"))))
        (setq program (js-call (get backend :compiler) :compile_ir_string source "tables-runtime.eli"))
        (setq bytes (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm program (js-object :maximumPages 256))))
        (funcall assert (WebAssembly/validate bytes))
        (js-call assert :deepEqual
          (WebAssembly.Module/imports (new WebAssembly.Module bytes))
          (js-array))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun wrap-exports (wasm-bytes)
    (let* ((inst (new WebAssembly.Instance (new WebAssembly.Module wasm-bytes)))
           (e (get inst :exports)))
      (Object/fromEntries
        (js-call (Object/entries e) :map
          (lambda (entry)
            (let ((k (aref entry 0))
                  (v (aref entry 1)))
              (js-array
                (js-call k :replaceAll "-" "_")
                (if (= (funcall js-typeof v) "function")
                    (lambda (&rest args) (unsigned-bit-shift-right (apply v args) 0))
                    v))))))))

  (defun open-raw (&rest __host_default_arguments_1)
    (let* ((slots-arg (aref __host_default_arguments_1 0)) (initial-arg (aref __host_default_arguments_1 1)) (max-arg (aref __host_default_arguments_1 2)))
    (let* ((slots (if (undefined? slots-arg) 256 slots-arg))
           (initial (if (undefined? initial-arg) 16384 initial-arg))
           (max-bytes (if (undefined? max-arg) 1048576 max-arg))
           (r (wrap-exports bytes))
           (h (js-call r :heap_new slots initial max-bytes)))
      (funcall assert (> h 0))
      (js-object :r r :h h))))

  (defun raw-number (r h value)
    (let ((v (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call v :setFloat64 0 value t)
      (js-call r :value_number h (js-call v :getUint32 0 t) (js-call v :getUint32 4 t))))

  (defun raw-text (r h value)
    (let ((id (js-call r :value_string h (get value :length)))
          (i 0))
      (funcall assert (> id 0))
      (while (< i (get value :length))
        (js-call r :value_unit_set h id i (js-call value :charCodeAt i))
        (setq i (+ i 1)))
      (js-call r :value_seal h id)
      id))

  (defun raw-entries (r h table)
    (let ((iterator (js-call r :value_table_iterator h table))
          (out (js-array)))
      (funcall assert (> iterator 0))
      (js-call r :heap_pin h iterator)
      (while (/= (js-call r :value_iterator_next h iterator) 0)
        (js-call out :push
          (js-array
            (js-call r :value_iterator_key h iterator)
            (js-call r :value_iterator_value h iterator))))
      (js-call assert :equal (js-call r :last_error) 0)
      (js-call r :heap_release h iterator)
      out))

  (defun bridge-entries (a table)
    (let ((iterator (js-call a :tableIterator table))
          (out (js-array))
          (keep-going t))
      (try
        (while keep-going
          (let ((step (js-call a :iteratorNext iterator)))
            (if (get step :done)
                (setq keep-going false)
                (js-call out :push (js-array (get step :key) (get step :value))))))
        (finally
          (js-call a :closeIterator iterator)
          (js-call a :release iterator)))
      out))

  (defun drop-entries (a values)
    (js-call values :forEach
      (lambda (pair)
        (js-call a :release (aref pair 0))
        (js-call a :release (aref pair 1)))))

  (test "managed Map distinguishes missing undefined and nil, preserves order and makes reads allocation-free"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4)))
        (funcall assert (> m 0))
        (js-call r :heap_pin h m)
        (js-call (js-array (js-array 0 3) (js-array 1 0) (js-array 2 1) (js-array 3 2)) :forEach
          (lambda (pair)
            (js-call assert :equal (js-call r :value_table_put h m (aref pair 0) (aref pair 1)) 1)))
        (js-call assert :equal (js-call r :value_table_size h m) 4)
        (js-call assert :equal (js-call r :value_table_get h m 0) 3)
        (js-call assert :equal (js-call r :value_table_has h m 0) 1)
        (let ((key (raw-text r h "absent")))
          (js-call r :heap_pin h key)
          (let ((before (js-array (js-call r :heap_used h) (js-call r :heap_live h) (js-call r :heap_collections h)))
                (i 0))
            (while (< i 1000)
              (js-call assert :equal (js-call r :value_table_get h m key) 3)
              (js-call assert :equal (js-call r :value_table_has h m key) 0)
              (js-call assert :equal (js-call r :value_table_get h m 1) 0)
              (setq i (+ i 1)))
            (js-call assert :deepEqual
              (js-array (js-call r :heap_used h) (js-call r :heap_live h) (js-call r :heap_collections h))
              before))
          (js-call assert :deepEqual
            (raw-entries r h m)
            (js-array (js-array 0 3) (js-array 1 0) (js-array 2 1) (js-array 3 2)))
          (js-call assert :equal (js-call r :value_table_put h m 1 2) 1)
          (js-call assert :deepEqual
            (raw-entries r h m)
            (js-array (js-array 0 3) (js-array 1 2) (js-array 2 1) (js-array 3 2)))
          (js-call assert :equal (js-call r :value_table_delete h m 1) 1)
          (js-call assert :equal (js-call r :value_table_delete h m 1) 0)
          (js-call r :value_table_put h m 1 0)
          (js-call assert :deepEqual
            (raw-entries r h m)
            (js-array (js-array 0 3) (js-array 2 1) (js-array 3 2) (js-array 1 0)))
          (js-call r :heap_release h key)
          (js-call r :heap_release h m)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)))))

  (test "managed Map and Set canonicalize negative-zero keys, retain IEEE values and merge NaN payload keys"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (minus (raw-number r h -0.0))
             (zero (raw-number r h 0))
             (nan (js-call r :value_number h 1 2146435072))
             (other (js-call r :value_number h 99 4294443008))
             (m (js-call r :value_table_new h 10 4))
             (s (js-call r :value_table_new h 11 4)))
        (js-call r :heap_pin h m)
        (js-call r :heap_pin h s)
        (js-call r :value_table_put h m minus minus)
        (js-call r :value_table_put h m zero minus)
        (js-call r :value_table_put h m nan 1)
        (js-call r :value_table_put h m other 2)
        (js-call r :value_table_add h s minus)
        (js-call r :value_table_add h s zero)
        (js-call r :value_table_add h s nan)
        (js-call r :value_table_add h s other)
        (js-call assert :equal (js-call r :value_table_size h m) 2)
        (js-call assert :equal (js-call r :value_table_size h s) 2)
        (js-call (js-array m s) :forEach
          (lambda (table)
            (let* ((items (raw-entries r h table))
                   (view (new globalThis.DataView (get (get r :memory) :buffer)))
                   (p (js-call r :value_data h (aref (aref items 0) 0) 4)))
              (js-call assert :equal (js-call view :getUint32 p t) 0)
              (js-call assert :equal (js-call view :getUint32 (+ p 4) t) 0)
              (js-call assert :equal (js-call r :value_key_equal h (aref (aref items 1) 0) nan) 1))))
        (let ((p (js-call r :value_data h (js-call r :value_table_get h m zero) 4)))
          (funcall assert (Object/is (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getFloat64 p t) -0.0)))
        (js-call assert :equal (js-call r :value_table_get h m nan) 2)
        (js-call assert :equal (js-call r :value_table_has h s other) 1)
        (let ((used (js-call r :heap_used h))
              (i 0))
          (while (< i 100)
            (js-call r :value_table_put h m minus minus)
            (js-call r :value_table_add h s minus)
            (setq i (+ i 1)))
          (js-call assert :equal (js-call r :heap_used h) used))
        (js-call r :heap_release h m)
        (js-call r :heap_release h s)
        (js-call r :heap_collect h)
        (js-call assert :equal (js-call r :heap_live h) 0))))

  (test "managed hash tables distinguish complete hash collisions and allow a zero hash"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4)))
        (js-call r :heap_pin h m)
        (let ((left (raw-text r h "collision-69051"))
              (right (raw-text r h "collision-123577")))
          (js-call assert :equal (hashValue "collision-69051") 919441390)
          (js-call assert :equal (hashValue "collision-123577") 919441390)
          (js-call assert :equal (js-call r :value_key_hash h left) (js-call r :value_key_hash h right))
          (js-call assert :equal (js-call r :value_key_equal h left right) 0)
          (js-call r :value_table_put h m left 1)
          (js-call r :value_table_put h m right 2)
          (js-call assert :equal (js-call r :value_table_get h m left) 1)
          (js-call assert :equal (js-call r :value_table_get h m right) 2)
          (js-call assert :equal (js-call r :value_table_delete h m left) 1)
          (js-call assert :equal (js-call r :value_table_get h m right) 2)
          (js-call r :value_table_put h m left 3)
          (js-call assert :deepEqual
            (raw-entries r h m)
            (js-array (js-array right 2) (js-array left 3)))
          (let ((zero-hash (js-call r :value_number h 0 4229770793)))
            (js-call assert :equal (js-call r :value_key_hash h zero-hash) 0)
            (js-call assert :equal (js-call r :last_error) 0)
            (js-call assert :equal (js-call r :value_table_put h m zero-hash 0) 1)
            (js-call assert :equal (js-call r :value_table_has h m zero-hash) 1)
            (js-call assert :equal (js-call r :value_table_get h m zero-hash) 0)
            (js-call assert :equal (js-call r :value_table_get h m right) 2)
            (js-call assert :equal (js-call r :value_table_delete h m zero-hash) 1))))))

  (test "managed Map and Set retain opaque identities and collect cyclic table references"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4))
             (s (js-call r :value_table_new h 11 4))
             (a (js-call r :value_refs h 7 0))
             (b (js-call r :value_refs h 7 0)))
        (js-call r :heap_pin h m)
        (let ((identity (js-call r :value_key_hash h m)))
          (js-call r :value_table_put h m a m)
          (js-call r :value_table_put h m b s)
          (js-call r :value_table_put h m s s)
          (js-call r :value_table_add h s m)
          (js-call r :value_table_add h s s)
          (js-call assert :equal (js-call r :heap_collect h) 0)
          (js-call assert :equal (js-call r :value_table_size h m) 3)
          (js-call assert :equal (js-call r :value_table_has h s m) 1)
          (js-call assert :equal (js-call r :value_key_hash h m) identity)
          (js-call assert :equal (js-call r :value_table_get h m a) m)
          (js-call assert :equal (js-call r :value_table_get h m b) s)
          (js-call r :value_table_delete h m b)
          (js-call assert :equal (js-call r :heap_collect h) 1)
          (js-call assert :equal (js-call r :value_table_has h m a) 1)
          (js-call r :heap_release h m)
          (js-call assert :equal (js-call r :heap_collect h) 3)
          (js-call assert :equal (js-call r :heap_live h) 0)
          (js-call assert :equal (js-call r :value_table_size h m) 0)
          (js-call assert :equal (js-call r :last_error) 1)))))

  (test "managed table iterators observe mutations, compaction and growth, then remain done"
    (lambda ()
      (let* ((opened (open-raw 512 32768))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4))
             (keys (Array/from (js-object :length 80) (lambda (_u i) (raw-text r h (str "k" i))))))
        (js-call r :heap_pin h m)
        (js-call keys :forEach (lambda (key) (js-call r :heap_pin h key)))
        (let ((i 0))
          (while (< i 4)
            (js-call r :value_table_put h m (aref keys i) (% i 4))
            (setq i (+ i 1))))
        (let ((it (js-call r :value_table_iterator h m)))
          (js-call r :heap_pin h it)
          (js-call assert :equal (js-call r :value_iterator_next h it) 1)
          (js-call assert :equal (js-call r :value_iterator_key h it) (aref keys 0))
          (js-call r :value_table_delete h m (aref keys 1))
          (js-call r :value_table_delete h m (aref keys 0))
          (js-call r :value_table_put h m (aref keys 0) 2)
          (let ((i 4))
            (while (< i 80)
              (js-call r :value_table_put h m (aref keys i) (% i 4))
              (setq i (+ i 1))))
          (let ((seen (js-array))
                (expected-seen (js-call (js-array (aref keys 2) (aref keys 3) (aref keys 0)) :concat (js-call keys :slice 4))))
            (while (/= (js-call r :value_iterator_next h it) 0)
              (js-call seen :push (js-call r :value_iterator_key h it)))
            (js-call assert :deepEqual seen expected-seen)
            (js-call assert :equal (js-call r :value_table_size h m) 79))
          (js-call r :value_table_clear h m)
          (js-call r :value_table_put h m (aref keys 1) 3)
          (js-call assert :equal (js-call r :value_iterator_next h it) 0)
          (let ((live (js-call r :value_table_iterator h m)))
            (js-call r :heap_pin h live)
            (js-call assert :equal (js-call r :value_iterator_next h live) 1)
            (js-call r :value_table_clear h m)
            (js-call r :value_table_put h m (aref keys 2) 0)
            (js-call assert :equal (js-call r :value_iterator_next h live) 1)
            (js-call assert :equal (js-call r :value_iterator_key h live) (aref keys 2))
            (js-call assert :equal (js-call r :value_iterator_close h live) 1)
            (js-call r :value_table_put h m (aref keys 3) 0)
            (js-call assert :equal (js-call r :value_iterator_next h live) 0)
            (js-call keys :forEach (lambda (key) (js-call r :heap_release h key)))
            (js-call r :heap_release h m)
            (js-call r :heap_release h it)
            (js-call r :heap_release h live)
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0))))))

  (test "managed iterator roots the table and current values until advance or close without allocating"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4))
             (key (raw-text r h "key"))
             (value (raw-number r h 42)))
        (js-call r :heap_pin h m)
        (js-call r :value_table_put h m key value)
        (let ((it (js-call r :value_table_iterator h m)))
          (js-call r :heap_pin h it)
          (js-call r :heap_release h m)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :value_iterator_next h it) 1)
          (js-call r :value_table_clear h m)
          (js-call assert :equal (js-call r :heap_collect h) 0)
          (js-call assert :equal (js-call r :value_iterator_key h it) key)
          (js-call assert :equal (js-call r :value_iterator_value h it) value)
          (let ((before (js-array (js-call r :heap_used h) (js-call r :heap_live h) (js-call r :heap_collections h))))
            (js-call assert :equal (js-call r :value_iterator_close h it) 1)
            (js-call assert :equal (js-call r :value_iterator_next h it) 0)
            (js-call assert :deepEqual
              (js-array (js-call r :heap_used h) (js-call r :heap_live h) (js-call r :heap_collections h))
              before))
          (js-call assert :equal (js-call r :heap_collect h) 3)
          (js-call assert :equal (js-call r :heap_live h) 1)
          (js-call r :heap_release h it)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)))))

  (test "managed table allocation failure preserves entries, order, identity and roots"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 32 :initialBytes 2048 :maxBytes 2048)))
             (_auto (js-call a :auto 1))
             (m (js-call a :map))
             (inputs (js-array))
             (failed false)
             (i 0))
        (while (and (< i 40) (not failed))
          (let ((key undefined)
                (value undefined))
            (try
              (setq key (js-call a :number i))
              (setq value (js-call a :number (+ i 100)))
              (js-call a :tableSet m key value)
              (js-call inputs :push (js-array key value))
              (catch err
                (js-call assert :equal (get (get err :eliscriptDiagnostic) :code) "ELI-RT0002")
                (when key (js-call a :release key))
                (when value (js-call a :release value))
                (setq failed t))))
          (setq i (+ i 1)))
        (funcall assert failed)
        (funcall assert (>= (get inputs :length) 4))
        (js-call assert :equal (js-call a :tableSize m) (get inputs :length))
        (let ((items (bridge-entries a m)))
          (js-call assert :deepEqual
            (js-call items :map (lambda (pair) (js-array (js-call a :readNumber (aref pair 0)) (js-call a :readNumber (aref pair 1)))))
            (js-call inputs :map (lambda (pair) (js-array (js-call a :readNumber (aref pair 0)) (js-call a :readNumber (aref pair 1))))))
          (drop-entries a items))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (js-call inputs :forEach
          (lambda (pair)
            (js-call a :release (aref pair 0))
            (js-call a :release (aref pair 1))))
        (js-call a :release m)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "managed table bridge validates brands and kinds and returns individually owned iterator values"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes))
             (m (js-call a :map))
             (s (js-call a :setTable))
             (surr (str "😀" (String/fromCharCode 55296)))
             (key (js-call a :string surr))
             (copy (js-call a :string surr))
             (value (js-call a :array)))
        (js-call assert :equal (js-call a :tableSet m key value) m)
        (js-call assert :equal (js-call a :tableAdd s key) s)
        (funcall assert (js-call a :tableHas m copy))
        (funcall assert (js-call a :tableHas s copy))
        (let ((alias (js-call a :tableGet m copy)))
          (funcall assert (js-call a :keyEqual alias value))
          (js-call a :release alias))
        (js-call assert :throws
          (lambda () (js-call b :tableHas m key))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
        (js-call assert :throws
          (lambda () (js-call a :tableSet s key value))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
        (js-call assert :throws
          (lambda () (js-call a :tableAdd m key))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
        (js-call assert :throws
          (lambda () (js-call a :tableGet s key))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
        (js-call assert :throws
          (lambda () (js-call a :tableHas m 0))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003")))
        (let ((items (bridge-entries a s)))
          (js-call assert :equal (get items :length) 1)
          (funcall assert (js-call a :keyEqual (aref (aref items 0) 0) (aref (aref items 0) 1)))
          (drop-entries a items))
        (js-call (js-array m s key copy value) :forEach (lambda (x) (js-call a :release x)))
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "managed Map and Set agree with independent JS models through randomized mutation and GC"
    (lambda ()
      (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576)))
             (_auto (js-call a :auto 1))
             (m (js-call a :map))
             (s (js-call a :setTable))
             (objects (js-array (js-call a :array) (js-call a :array) (js-call a :record) (js-call a :bytes (js-array 1))))
             (values (js-call
                       (js-array nil false t undefined 0 -0.0 globalThis.NaN globalThis.Infinity
                                 (- globalThis.Infinity) Number.MIN_VALUE "" "中😀" (String/fromCharCode 55296))
                       :concat objects))
             (handles (js-call values :map
                        (lambda (v)
                          (let ((ty (funcall js-typeof v)))
                            (cond
                              ((= ty "number") (js-call a :number v))
                              ((= ty "string") (js-call a :string v))
                              (t v))))))
             (ref (new globalThis.Map))
             (set-model (new globalThis.Set))
             (state 60279473)
             (next (lambda ()
                     (setq state (bit-xor state (bit-shift-left state 13)))
                     (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                     (setq state (bit-xor state (bit-shift-left state 5)))
                     (unsigned-bit-shift-right state 0)))
             (decode (lambda (handle)
                       (if (and (not (nullish? handle)) (= (funcall js-typeof handle) "object"))
                           (let ((kind (get handle :kind)))
                             (cond
                               ((= kind 4) (js-call a :readNumber handle))
                               ((= kind 5) (js-call a :readString handle))
                               (t (js-call objects :find (lambda (obj) (js-call a :keyEqual handle obj))))))
                           handle)))
             (i 0))
        (while (< i 4096)
          (let ((k (% (funcall next) (get handles :length)))
                (v (% (funcall next) (get handles :length)))
                (operation (% (funcall next) 8)))
            (cond
              ((< operation 4)
               (js-call a :tableSet m (aref handles k) (aref handles v))
               (js-call a :tableAdd s (aref handles k))
               (js-call ref :set (aref values k) (aref values v))
               (js-call set-model :add (aref values k)))
              ((< operation 6)
               (js-call assert :equal (js-call a :tableDelete m (aref handles k)) (js-call ref :delete (aref values k)))
               (js-call assert :equal (js-call a :tableDelete s (aref handles k)) (js-call set-model :delete (aref values k))))
              ((= operation 6)
               (js-call a :tableClear m)
               (js-call a :tableClear s)
               (js-call ref :clear)
               (js-call set-model :clear))
              (t
               (js-call assert :equal (js-call a :tableHas m (aref handles k)) (js-call ref :has (aref values k)))
               (let ((result (js-call a :tableGet m (aref handles k))))
                 (funcall assert (Object/is (funcall decode result) (js-call ref :get (aref values k))))
                 (js-call a :release result)))))
          (js-call a :collect)
          (js-call assert :equal (js-call a :tableSize m) (get ref :size))
          (js-call assert :equal (js-call a :tableSize s) (get set-model :size))
          (when (= (% i 16) 0)
            (let ((map-entries (bridge-entries a m))
                  (set-entries (bridge-entries a s)))
              (js-call assert :deepEqual
                (js-call map-entries :map (lambda (pair) (js-array (funcall decode (aref pair 0)) (funcall decode (aref pair 1)))))
                (Array/from ref))
              (js-call assert :deepEqual
                (js-call set-entries :map (lambda (pair) (funcall decode (aref pair 0))))
                (Array/from set-model))
              (drop-entries a map-entries)
              (drop-entries a set-entries)))
          (setq i (+ i 1)))
        (js-call handles :forEach (lambda (handle) (js-call a :release handle)))
        (js-call a :release m)
        (js-call a :release s)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "managed table tickets carry between words, reject exhaustion and still permit existing-key updates"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4)))
        (js-call r :heap_pin h m)
        (let ((p (- (js-call r :value_data h m 10) 32))
              (view (new globalThis.DataView (get (get r :memory) :buffer))))
          (js-call view :setUint32 (+ p 16) 4294967294 t)
          (js-call view :setUint32 (+ p 20) 123 t)
          (js-call r :value_table_put h m 0 1)
          (let ((it (js-call r :value_table_iterator h m)))
            (js-call r :heap_pin h it)
            (js-call assert :equal (js-call r :value_iterator_next h it) 1)
            (js-call assert :equal (js-call r :value_iterator_key h it) 0)
            (js-call r :value_table_put h m 1 2)
            (js-call r :value_table_put h m 2 3)
            (js-call assert :equal (js-call r :value_iterator_next h it) 1)
            (js-call assert :equal (js-call r :value_iterator_key h it) 1)
            (js-call assert :equal (js-call r :value_iterator_next h it) 1)
            (js-call assert :equal (js-call r :value_iterator_key h it) 2)
            (js-call assert :equal (js-call view :getUint32 (+ p 20) t) 124)
            (js-call assert :equal (js-call view :getUint32 (+ p 16) t) 1)
            (js-call view :setUint32 (+ p 16) 4294967295 t)
            (js-call view :setUint32 (+ p 20) 4294967295 t)
            (let ((before (raw-entries r h m)))
              (js-call assert :equal (js-call r :value_table_put h m 3 0) 0)
              (js-call assert :equal (js-call r :last_error) 2)
              (js-call assert :deepEqual (raw-entries r h m) before))
            (js-call assert :equal (js-call r :value_table_put h m 0 3) 1)
            (js-call assert :equal (js-call r :value_table_get h m 0) 3)
            (js-call assert :equal (js-call r :value_iterator_next h it) 0)
            (js-call r :heap_release h it)
            (js-call r :heap_release h m)
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0))))))

  (test "managed table compaction bounds long delete/reinsert logs and matches an active JS iterator without allocation"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4))
             (values (js-array nil false t undefined))
             (ref (new globalThis.Map))
             (i 0))
        (js-call r :heap_pin h m)
        (while (< i 4)
          (js-call r :value_table_put h m i i)
          (js-call ref :set (aref values i) (aref values i))
          (setq i (+ i 1)))
        (let ((it (js-call r :value_table_iterator h m))
              (iterator (js-call ref :entries))
              (before (js-array (js-call r :heap_used h) (js-call r :heap_live h) (js-call r :heap_collections h)))
              (step 0))
          (js-call r :heap_pin h it)
          (while (< step 10000)
            (when (= (% step 17) 0)
              (js-call r :value_table_clear h m)
              (js-call ref :clear))
            (let ((key (% step 4))
                  (val (% (+ step 1) 4)))
              (js-call r :value_table_delete h m key)
              (js-call ref :delete (aref values key))
              (js-call r :value_table_put h m key val)
              (js-call ref :set (aref values key) (aref values val)))
            (let ((expected (js-call iterator :next))
                  (actual (js-call r :value_iterator_next h it)))
              (js-call assert :equal actual (if (get expected :done) 0 1))
              (when (/= actual 0)
                (js-call assert :deepEqual
                  (js-array
                    (aref values (js-call r :value_iterator_key h it))
                    (aref values (js-call r :value_iterator_value h it)))
                  (get expected :value))))
            (setq step (+ step 1)))
          (js-call assert :deepEqual
            (js-array (js-call r :heap_used h) (js-call r :heap_live h) (js-call r :heap_collections h))
            before)
          (js-call assert :equal (js-call r :value_table_size h m) (get ref :size))
          (js-call r :value_iterator_close h it)
          (js-call r :heap_release h it)
          (js-call r :heap_release h m)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)))))

  (test "managed table growth fails at the actual WASM page limit without losing the old table or borrowed roots"
    (lambda ()
      (let* ((limited (Uint8Array/from
                        (js-call (get backend :wasm) :emit_memory_wasm program (js-object :initialPages 1 :maximumPages 1))))
             (r (wrap-exports limited))
             (h (js-call r :heap_new 1024 32768 262144)))
        (funcall assert (> h 0))
        (js-call r :heap_auto h 1)
        (let ((m (js-call r :value_table_new h 10 4))
              (cnt 0)
              (failed false)
              (i 1))
          (js-call r :heap_pin h m)
          (while (and (< i 512) (not failed))
            (let ((key (raw-number r h i)))
              (if (= key 0)
                  (progn
                    (js-call assert :equal (js-call r :last_error) 2)
                    (setq failed t))
                  (let ((result (js-call r :value_table_put h m key 2)))
                    (if (= result 0)
                        (progn
                          (js-call assert :equal (js-call r :last_error) 2)
                          (setq failed t))
                        (setq cnt (+ cnt 1))))))
            (setq i (+ i 1)))
          (funcall assert failed)
          (funcall assert (>= cnt 4))
          (js-call assert :equal (get (get (get r :memory) :buffer) :byteLength) 65536)
          (js-call assert :equal (js-call r :value_table_size h m) cnt)
          (let ((items (raw-entries r h m))
                (idx 0))
            (js-call assert :equal (get items :length) cnt)
            (while (< idx cnt)
              (let ((point (js-call r :value_data h (aref (aref items idx) 0) 4)))
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getFloat64 point t)
                  (+ idx 1))
                (js-call assert :equal (aref (aref items idx) 1) 2))
              (setq idx (+ idx 1))))
          (js-call r :heap_release h m)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)
          (js-call assert :equal (js-call r :frame_depth h) 0)))))

  (test "managed table refusal paths leave the table untouched and validate builders, frames, kinds and iterators"
    (lambda ()
      (let* ((opened (open-raw))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4))
             (s (js-call r :value_table_new h 11 4))
             (builder (js-call r :value_string h 1))
             (frame (js-call r :frame_new h 0)))
        (js-call (js-array
                   (js-array "value_table_put" (js-array m builder 0) 6)
                   (js-array "value_table_has" (js-array m builder) 6)
                   (js-array "value_table_delete" (js-array m builder) 6)
                   (js-array "value_table_put" (js-array m 0 frame) 3)
                   (js-array "value_table_add" (js-array s frame) 3)
                   (js-array "value_table_get" (js-array m frame) 3)
                   (js-array "value_table_put" (js-array s 0 0) 1)
                   (js-array "value_table_add" (js-array m 0) 1)
                   (js-array "value_table_get" (js-array s 0) 1)
                   (js-array "value_table_clear" (js-array builder) 1)
                   (js-array "value_table_new" (js-array 9 4) 3)
                   (js-array "value_table_new" (js-array 10 4194305) 2))
          :forEach
          (lambda (triple)
            (let ((fn-name (aref triple 0))
                  (args (aref triple 1))
                  (code (aref triple 2))
                  (used (js-call r :heap_used h)))
              (js-call assert :equal (apply (get r fn-name) h args) 0)
              (js-call assert :equal (js-call r :last_error) code)
              (js-call assert :equal (js-call r :heap_used h) used)
              (js-call assert :equal (js-call r :value_table_size h m) 0)
              (js-call assert :equal (js-call r :value_table_size h s) 0))))
        (let ((it (js-call r :value_table_iterator h m)))
          (funcall assert (> it 0))
          (js-call assert :equal (js-call r :value_iterator_key h it) 0)
          (js-call assert :equal (js-call r :last_error) 3)
          (js-call assert :equal (js-call r :value_iterator_next h it) 0)
          (js-call assert :equal (js-call r :value_iterator_value h it) 0)
          (js-call assert :equal (js-call r :last_error) 3))
        (js-call r :frame_pop h frame)
        (js-call r :heap_collect h)
        (js-call assert :equal (js-call r :heap_live h) 0)
        (js-call assert :equal (js-call r :value_table_has h m 0) 0)
        (js-call assert :equal (js-call r :last_error) 1))))

  (test "managed table negative-zero normalization failure preserves bits, tickets and every borrowed root"
    (lambda ()
      (let* ((opened (open-raw 4 512 512))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4))
             (minus (raw-number r h -0.0))
             (a (js-call r :value_refs h 7 0))
             (b (js-call r :value_refs h 8 0)))
        (js-call (js-array m minus a b) :forEach (lambda (x) (js-call r :heap_pin h x)))
        (js-call r :heap_auto h 1)
        (let* ((p (- (js-call r :value_data h m 10) 32))
               (view (new globalThis.DataView (get (get r :memory) :buffer)))
               (low (js-call view :getUint32 (+ p 16) t))
               (high (js-call view :getUint32 (+ p 20) t)))
          (js-call assert :equal (js-call r :value_table_put h m minus minus) 0)
          (js-call assert :equal (js-call r :last_error) 2)
          (js-call assert :equal (js-call r :value_table_size h m) 0)
          (let ((current (- (js-call r :value_data h m 10) 32)))
            (js-call assert :equal (js-call view :getUint32 (+ current 16) t) low)
            (js-call assert :equal (js-call view :getUint32 (+ current 20) t) high))
          (funcall assert (Object/is (js-call view :getFloat64 (js-call r :value_data h minus 4) t) -0.0))
          (js-call assert :equal (js-call r :frame_depth h) 0)
          (js-call (js-array m minus a b) :forEach (lambda (x) (js-call r :heap_release h x)))
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)))))

  (test "managed table growth defragments out-of-order live blocks without changing roots, aliases or IEEE payloads"
    (lambda ()
      (let* ((opened (open-raw 128 8192 8192))
             (r (get opened :r))
             (h (get opened :h))
             (m (js-call r :value_table_new h 10 4)))
        (js-call r :value_bytes h 160)
        (let* ((nan (js-call r :value_number h 305419896 2146509637))
               (minus (raw-number r h -0.0))
               (str-val (raw-text r h (str (String/fromCharCode 55296) "中😀")))
               (data (js-call r :value_bytes h 8))
               (arr (js-call r :value_refs h 7 3))
               (record (js-call r :value_refs h 8 3))
               (pinned (js-array m nan minus str-val data arr record)))
          (js-call pinned :forEach (lambda (x) (js-call r :heap_pin h x)))
          (js-call r :value_set h arr 0 m)
          (js-call r :value_set h arr 1 nan)
          (js-call r :value_set h arr 2 str-val)
          (js-call r :value_set h record 0 arr)
          (js-call r :value_set h record 1 minus)
          (js-call r :value_set h record 2 data)
          (let ((values (js-array 0 255 17 32 64 128 1 254))
                (point (js-call r :value_data h data 6)))
            (js-call (new globalThis.Uint8Array (get (get r :memory) :buffer) point 8) :set values)
            (let ((i 0))
              (while (< i 4)
                (js-call r :value_table_put h m i nan)
                (setq i (+ i 1))))
            (let ((frame (js-call r :frame_new h 2))
                  (it (js-call r :value_table_iterator h m)))
              (js-call r :frame_set h frame 0 arr)
              (js-call r :frame_set h frame 1 record)
              (js-call r :heap_pin h it)
              (js-call pinned :push it)
              (js-call assert :equal (js-call r :value_iterator_next h it) 1)
              (let ((index 0)
                    (keep-blocks t))
                (while keep-blocks
                  (let ((block (js-call r :value_bytes h 160)))
                    (if (= block 0)
                        (progn
                          (js-call assert :equal (js-call r :last_error) 2)
                          (setq keep-blocks false))
                        (let ((odd (/= (% index 2) 0)))
                          (setq index (+ index 1))
                          (when odd
                            (js-call r :heap_pin h block)
                            (js-call pinned :push block)))))))
              (let ((keep-empty t))
                (while keep-empty
                  (let ((block (js-call r :value_bytes h 0)))
                    (if (= block 0)
                        (progn
                          (js-call assert :equal (js-call r :last_error) 2)
                          (setq keep-empty false))
                        (progn
                          (js-call r :heap_pin h block)
                          (js-call pinned :push block))))))
              (js-call r :heap_collect h)
              (let ((out-of-order (raw-number r h 123)))
                (js-call r :heap_pin h out-of-order)
                (js-call pinned :push out-of-order)
                (let ((old-point (js-call r :value_data h nan 4))
                      (before (js-array (js-call r :heap_used h) (js-call r :heap_live h) (js-call r :heap_collections h)))
                      (identity (js-call r :value_key_hash h m)))
                  (js-call assert :equal (js-call r :value_table_put h m nan record) 1)
                  (js-call assert :equal (js-call r :value_table_size h m) 5)
                  (funcall assert (< (js-call r :heap_used h) (aref before 0)))
                  (js-call assert :equal (js-call r :heap_live h) (aref before 1))
                  (js-call assert :equal (js-call r :heap_collections h) (aref before 2))
                  (js-call assert :equal (js-call r :value_key_hash h m) identity)
                  (let ((fresh (js-call r :value_data h nan 4))
                        (view (new globalThis.DataView (get (get r :memory) :buffer))))
                    (funcall assert (/= fresh old-point))
                    (js-call assert :equal (js-call view :getUint32 fresh t) 305419896)
                    (js-call assert :equal (js-call view :getUint32 (+ fresh 4) t) 2146509637)
                    (funcall assert (Object/is (js-call view :getFloat64 (js-call r :value_data h minus 4) t) -0.0))
                    (js-call assert :equal (js-call view :getFloat64 (js-call r :value_data h out-of-order 4) t) 123)
                    (js-call assert :deepEqual
                      (Array/from (new globalThis.Uint8Array (get (get r :memory) :buffer) (js-call r :value_data h data 6) 8))
                      values)
                    (js-call assert :deepEqual
                      (Array/from (js-object :length 4) (lambda (_u idx) (js-call r :value_unit_get h str-val idx)))
                      (js-array 55296 20013 55357 56832))
                    (js-call assert :equal (js-call r :value_get h arr 0) m)
                    (js-call assert :equal (js-call r :value_get h arr 1) nan)
                    (js-call assert :equal (js-call r :value_get h record 0) arr)
                    (js-call assert :equal (js-call r :frame_get h frame 1) record)
                    (js-call assert :equal (js-call r :value_iterator_value h it) nan)
                    (js-call assert :equal (js-call r :value_table_get h m nan) record)
                    (js-call assert :equal (js-call r :frame_depth h) 1)
                    (let ((cycle 0))
                      (while (< cycle 8)
                        (js-call assert :equal (js-call r :heap_collect h) 0)
                        (js-call assert :equal (js-call r :heap_live h) (aref before 1))
                        (js-call pinned :forEach
                          (lambda (x)
                            (funcall assert (> (js-call r :value_kind h x) 0))
                            (js-call r :heap_release h x)
                            (js-call r :heap_pin h x)))
                        (js-call assert :equal (js-call r :value_get h record 0) arr)
                        (js-call assert :equal (js-call r :value_iterator_value h it) nan)
                        (js-call assert :equal
                          (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32
                            (js-call r :value_data h nan 4) t)
                          305419896)
                        (setq cycle (+ cycle 1))))))
                (js-call r :value_iterator_close h it)
                (js-call r :frame_pop h frame)
                (js-call pinned :forEach (lambda (x) (js-call r :heap_release h x)))
                (js-call r :heap_collect h)
                (js-call assert :equal (js-call r :heap_live h) 0))))))))

  (test "Node and Bun execute the whole bounded Map/Set pipeline inside zero-import WASM across allocation safepoints"
    (async ()
      (let* ((source (str (await (readFile (resolve "bootstrap/runtime/memory.eli") "utf8"))
                          (await (readFile (resolve "tests/fixtures/wasm-managed-tables.eli") "utf8"))))
             (artifact (Uint8Array/from
                         (js-call (get backend :wasm) :emit_memory_wasm
                           (js-call (get backend :compiler) :compile_ir_string source "table-pipeline.eli")
                           (js-object :maximumPages 8))))
             (mod (new WebAssembly.Module artifact))
             (wasm-path (resolve directory "table-pipeline.wasm")))
        (js-call assert :deepEqual (WebAssembly.Module/imports mod) (js-array))
        (await (writeFile wasm-path artifact))
        (let* ((inst (new WebAssembly.Instance mod))
               (e (get inst :exports))
               (h (funcall (get e "heap-new") 96 8192 8192)))
          (funcall (get e "heap-auto") h 1)
          (let ((out (unsigned-bit-shift-right (funcall (get e "table-pressure") h 1000) 0)))
            (funcall assert (> out 0))
            (js-call assert :equal (funcall (get e "value-table-size") h out) 32)
            (js-call assert :equal (funcall (get e "frame-depth") h) 0)
            (funcall assert (>= (funcall (get e "heap-collections") h) 1000))
            (funcall (get e "heap-release") h out)
            (funcall (get e "heap-collect") h)
            (js-call assert :equal (funcall (get e "heap-live") h) 0)))
        (let ((result (spawnSync "node"
                        (js-array node-helper "--run-node-check" wasm-path)
                        (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get result :status) 0 (get result :stderr)))))))
