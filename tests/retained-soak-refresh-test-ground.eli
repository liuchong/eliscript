(module tests.retained-soak-refresh-test-ground
  (import "node:process" :default process)
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "../tools/acceptance/finalize.mjs" validateFinalAcceptanceContract)
  (import "../tools/acceptance/retained-soak.mjs" validateRefreshedWorkerSoak)
  (defconst root (resolve (js* "import.meta.dir") ".."))
  (defasync read (path) (JSON/parse (await (readFile (resolve root path) "utf8"))))
  (defconst officialSourceProbe (= (get (get process :env) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE) "1"))
  (defconst canonicalFinalTest (if officialSourceProbe (get test :skip) test))
  (canonicalFinalTest "a fully remeasured current soak retains the original accepted snapshot and final source-run hashes" (async ()
    (let ((contract (await (read "contracts/final-acceptance.json"))) (run (await (read "acceptance/runs/m13-01.json"))))
      (let ((before (JSON/stringify run)))
        (await (validateFinalAcceptanceContract contract run (js-object :root root :deferPerformanceAcceptance (= (get (get process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))))
        (js-call assert :equal (JSON/stringify run) before)))))
  (test "fresh soak replacement refuses changed thresholds, incomplete recovery, forged trends and stale source hashes" (async ()
    (let ((run (await (read "acceptance/runs/m13-01.json"))) (report (await (read "benchmarks/worker-lifecycle-soak-macos-arm64.json"))) (mutations (js-array (lambda (r) (put (get r :limits) :runTimeoutSeconds 181))
        (lambda (r) (put (get r :workload) :successfulRequests 99999))
        (lambda (r) (js-call (get (get r :recovery) :events) :pop))
        (lambda (r) (put (get (get r :memory) :budgetKiB) :emacs (+ (get (get (get r :memory) :budgetKiB) :emacs) 1)))
        (lambda (r) (put (get (get r :memory) :peakKiB) :worker (1+ (get (get (get r :memory) :budgetKiB) :worker))))
        (lambda (r) (put (get (get (get r :memory) :steadyState) :deltaKiB) :worker (+ (get (get (get (get r :memory) :steadyState) :deltaKiB) :worker) 1)))
        (lambda (r) (put (get (get (aref (get (get r :memory) :generations) 0) :steadyState) :initialMedianKiB) :worker (+ (get (get (get (aref (get (get r :memory) :generations) 0) :steadyState) :initialMedianKiB) :worker) 1)))
        (lambda (r) (js-call (get (get r :memory) :checkpoints) :pop))
        (lambda (r) (put (get r :lifecycle) :reclaimedProcessCount 4))
        (lambda (r) (put (aref (get (get r :source) :files) 0) :sha256 (js-call "0" :repeat 64)))
        (lambda (r) (put (get r :source) :digest (js-call "0" :repeat 64))))) (index 0))
      (while (< index (get mutations :length))
        (let ((copy (funcall globalThis.structuredClone report)))
          (funcall (aref mutations index) copy)
          (await (js-call assert :rejects (validateRefreshedWorkerSoak root "benchmarks/worker-lifecycle-soak-macos-arm64.json" (Buffer/from (JSON/stringify copy)) run))))
        (setq index (1+ index))))))
  (test "accepted snapshot identities and artifact hashes cannot be repaired by substituting another commit or report" (async ()
    (let* ((run (await (read "acceptance/runs/m13-01.json"))) (file "benchmarks/worker-lifecycle-soak-macos-arm64.json") (bytes (await (readFile (resolve root file))))
           (mutations (js-array (lambda (r) (put (get r :source) :commit (js-call "0" :repeat 40)))
        (lambda (r) (put (get r :source) :tree (js-call "0" :repeat 40)))
        (lambda (r) (put (js-call (get r :artifacts) :find (lambda (item) (= (get item :file) "benchmarks/worker-lifecycle-soak-macos-arm64.json"))) :sha256 (js-call "0" :repeat 64))))) (index 0))
      (while (< index (get mutations :length))
        (let ((copy (funcall globalThis.structuredClone run)))
          (funcall (aref mutations index) copy)
          (await (js-call assert :rejects (validateRefreshedWorkerSoak root file bytes copy))))
        (setq index (1+ index)))
      (await (js-call assert :rejects (validateRefreshedWorkerSoak root "benchmarks/core-performance-macos-arm64.json" bytes run))))))
  (test "fresh strict soak acceptance remains accepted when deferral is explicitly enabled" (async ()
    (let* ((run (await (read "acceptance/runs/m13-01.json"))) (file "benchmarks/worker-lifecycle-soak-macos-arm64.json") (bytes (await (readFile (resolve root file)))))
      (js-call assert :equal (await (validateRefreshedWorkerSoak root file bytes run)) t)
      (js-call assert :equal (await (validateRefreshedWorkerSoak root file bytes run (js-object :deferPerformanceAcceptance t))) t))))
  (test "failed fresh soak measurements cannot be accepted through deferral without historical proof" (async ()
    (let* ((run (await (read "acceptance/runs/m13-01.json"))) (file "benchmarks/worker-lifecycle-soak-macos-arm64.json") (report (await (read file))))
      (put report :elapsedMs 180001) (put report :acceptanceQualified false)
      (let ((bytes (Buffer/from (JSON/stringify report))))
        (await (js-call assert :rejects (validateRefreshedWorkerSoak root file bytes run)))
        (await (js-call assert :rejects (validateRefreshedWorkerSoak root file bytes run (js-object :deferPerformanceAcceptance t))))))))
)
