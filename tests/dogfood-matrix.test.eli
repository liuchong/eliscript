(module
  tests.dogfood-matrix.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdir mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "../runtime/core/collection.mjs" :as collection-mod)
  (import "../runtime/literals.mjs" hashMap keyword vector)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    state
    (js-object :staging nil :project nil :sources nil))
  (defun
    k
    (name)
    (keyword name))
  (defun
    mapOf
    (entries)
    (let*
      ((flat (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((pair (aref entries (get idx :i))))
          (js-call flat :push (k (aref pair 0)))
          (js-call flat :push (aref pair 1)))
        (put idx :i (+ (get idx :i) 1)))
      (apply hashMap flat)))
  (defun
    getOf
    (value name &rest __host_default_arguments_1)
    (let* ((fallback (aref __host_default_arguments_1 0)))
    (js-call collection-mod :get value (k name) (if
        (= fallback undefined)
        nil
        fallback))))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (defconst
    REPOSITORY
    (js-object :markdown "owner/markdown-repository" :issues "owner/issues-repository" :discussions "owner/discussions-repository"))
  (defconst
    SUBJECT
    (js-array "markdown" "issues" "discussions"))
  (defconst
    SUBSETS
    (js-array (js-array "markdown") (js-array "issues") (js-array "markdown" "issues") (js-array "discussions") (js-array "markdown" "discussions") (js-array "issues" "discussions") (js-array "markdown" "issues" "discussions")))
  (defun
    markdownBody
    (id)
    (js-call (js-array "---" (str "id: " id) "title: From Markdown" "date: 2026-09-12" "description: A markdown record." "tags: [design]" "slug: from-markdown" "---" "" "Body text." "") :join "\n"))
  (defun
    metadata
    (fields)
    (let*
      ((entries (js-call globalThis.Object :entries fields)) (lines (js-call entries :map (lambda (pair) (str (aref pair 0) ": " (aref pair 1))))) (all (js-call (js-array "```dogfood") :concat lines (js-array "```" "" "Body text." ""))))
      (js-call all :join "\n")))
  (defun
    issue
    (number id)
    (js-object :number number :html_url (str "https://github.com/owner/issues-repository/issues/" number) :created_at "2026-09-10T00:00:00Z" :updated_at "2026-09-11T00:00:00Z" :labels (js-array) :user (js-object :login "owner" :id "U_owner" :type "User") :body (metadata (js-object :id id :title "From Issues" :slug "from-issues"))))
  (defun
    discussion
    (number id)
    (js-object :number number :id (str "D_" number) :title "Discussion carrier" :url (str "https://github.com/owner/discussions-repository/discussions/" number) :createdAt "2026-09-10T00:00:00Z" :updatedAt "2026-09-11T00:00:00Z" :category (js-object :name "Blog") :labels (js-object :nodes (js-array)) :author (js-object :login "owner" :databaseId "U_owner" :__typename "User") :body (metadata (js-object :id id :title "From Discussions" :slug "from-discussions")) :answer nil :comments (js-object :nodes (js-array) :pageInfo (js-object :hasNextPage false :endCursor nil)) :commentsCount (js-object :totalCount 0)))
  (defun
    recordingTransport
    (calls)
    (lambda (request) (let*
        ((is-str (= (value-type request) "string")) (url (if
              is-str
              request
              (get request :url))) (recorded (if
              is-str
              request
              (str (get request :url) " " (js-call globalThis.JSON :stringify (or (get request :body) ""))))))
        (js-call calls :push recorded)
        (if
          (js-call url :includes "/graphql")
          (js-object :status 200 :headers (js-object) :body (js-object :data (js-object :repository (js-object :discussions (js-object :nodes (js-array (discussion 17 "notes/from-discussions")) :pageInfo (js-object :hasNextPage false :endCursor nil))))))
          (js-object :status 200 :headers (js-object) :body (js-array (issue 42 "notes/from-issues")))))))
  (defun
    sourceOf
    (subject enabled)
    (cond
      ((= subject "markdown") (mapOf (js-array (js-array "id" (k "markdown-posts")) (js-array "kind" (k "markdown")) (js-array "enabled" enabled) (js-array "directory" "content/posts"))))
      ((= subject "issues") (mapOf (js-array (js-array "id" (k "issues")) (js-array "kind" (k "issues")) (js-array "enabled" enabled) (js-array "repository" (get REPOSITORY :issues)) (js-array "label" "published"))))
      (t (mapOf (js-array (js-array "id" (k "discussions")) (js-array "kind" (k "discussions")) (js-array "enabled" enabled) (js-array "repository" (get REPOSITORY :discussions)) (js-array "category" "Blog"))))))
  (defun
    configFor
    (subset)
    (mapOf (js-array (js-array "sources" (apply vector (js-call SUBJECT :map (lambda (subject) (sourceOf subject (js-call subset :includes subject)))))) (js-array "publishing" (mapOf (js-array (js-array "owner" (mapOf (js-array (js-array "login" "owner") (js-array "id" "U_owner")))) (js-array "coauthors" (vector))))) (js-array "adapters" (vector)) (js-array "comments" (mapOf (js-array (js-array "presentation" (k "tabs")) (js-array "channels" (vector))))) (js-array "identity" (mapOf (js-array (js-array "conflict" (k "fail")) (js-array "projections" (vector))))) (js-array "output" (mapOf (js-array (js-array "directory" "_site")))))))
  (defasync
    collect
    (subset)
    (let*
      ((sources (get state :sources)) (config (configFor subset)) (enabled (js-call globalThis.Array :from (js-call sources :enabled_sources config))) (ids (js-call enabled :map (lambda (src) (get (getOf src "id") :name)))) (calls (js-array)) (transport (recordingTransport calls)) (posts (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get enabled :length))
        (let*
          ((src (aref enabled (get idx :i))) (result (await (js-call sources :source_posts (get state :project) config src transport (vector)))) (src-posts (js-call globalThis.Array :from (getOf result "posts"))) (pidx (js-object :j 0)))
          (while
            (< (get pidx :j) (get src-posts :length))
            (js-call posts :push (aref src-posts (get pidx :j)))
            (put pidx :j (+ (get pidx :j) 1))))
        (put idx :i (+ (get idx :i) 1)))
      (js-object :ids ids :calls calls :posts (js-call posts :map (lambda (post) (getOf post "id"))))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-matrix-")))) (project (resolve staging "project")) (__ign_2 (put state :staging staging)) (__ign_3 (put state :project project)) (__ign_4 (await (mkdir (resolve project "content/posts") (js-object :recursive t)))) (__ign_5 (await (writeFile (resolve project "content/posts/0001-from-markdown.md") (markdownBody "notes/from-markdown") "utf8"))) (built (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (resolve staging "build") "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get built :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get built :stderr) :trim) (js-call (get built :stdout) :trim)))))
        (put state :sources (await (funcall (js* "(u) => import(u)") (resolve staging "build/src/builder/sources.mjs")))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "the matrix enumerates all seven non-empty subsets" (lambda () (js-call (expect (get SUBSETS :length)) :toBe 7)))
  (let*
    ((sidx (js-object :i 0)) (id-map (js-object :markdown "markdown-posts" :issues "issues" :discussions "discussions")))
    (while
      (< (get sidx :i) (get SUBSETS :length))
      (let*
        ((subset (aref SUBSETS (get sidx :i))) (label (js-call subset :join "+")))
        (test (str "the " label " subset reads exactly its providers") (async () (let*
              ((result (await (collect subset))) (expected-ids (js-call subset :map (lambda (subject) (get id-map subject)))) (expected-posts (js-call subset :map (lambda (subject) (str "notes/from-" subject)))))
              (js-call (expect (get result :ids)) :toEqual expected-ids)
              (js-call (expect (js-call (js-call globalThis.Array :from (get result :posts)) :sort)) :toEqual (js-call (js-call globalThis.Array :from expected-posts) :sort))
              (let*
                ((net-subjects (js-array "issues" "discussions")) (nidx (js-object :j 0)))
                (while
                  (< (get nidx :j) (get net-subjects :length))
                  (let*
                    ((subject (aref net-subjects (get nidx :j))) (name (aref (js-call (get REPOSITORY subject) :split "/") 1)) (touched (js-call (get result :calls) :some (lambda (call) (js-call call :includes name)))))
                    (js-call (expect touched) :toBe (js-call subset :includes subject)))
                  (put nidx :j (+ (get nidx :j) 1))))
              (when
                (not (js-call subset :includes "markdown"))
                (js-call (get (expect (get result :posts)) :not) :toContain "notes/from-markdown"))))))
      (put sidx :i (+ (get sidx :i) 1))))
  (test "all three providers together keep every record distinct" (async () (let*
        ((result (await (collect (js-array "markdown" "issues" "discussions")))))
        (js-call (expect (js-call (js-call globalThis.Array :from (get result :posts)) :sort)) :toEqual (js-array "notes/from-discussions" "notes/from-issues" "notes/from-markdown"))
        (js-call (expect (get (get result :calls) :length)) :toBeGreaterThanOrEqual 2))))
  (test "a configuration with nothing enabled dispatches nothing" (async () (let*
        ((result (await (collect (js-array)))))
        (js-call (expect (get result :ids)) :toEqual (js-array))
        (js-call (expect (get result :posts)) :toEqual (js-array))
        (js-call (expect (get result :calls)) :toEqual (js-array))))))
