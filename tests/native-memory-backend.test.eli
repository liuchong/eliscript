(module tests.native-memory-backend.test
  (import "node:process" :default process)
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm writeFile readFile readdir mkdir)
  (import "node:path" resolve relative)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (defvar directory undefined) (defvar backend undefined) (defvar pairSerial 0)
  (defconst nativeTest (js-call test :skipIf (or (not (= (get process :platform) "darwin")) (not (= (get process :arch) "arm64")))))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (beforeAll (async () (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-memory-")))) (setq backend (await (buildBackends (js-object :outputRoot directory))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defconst source "(import \"eliscript:memory32\" load-u8 load-u16 load-u32 load-f64 store-u8 store-u16 store-u32 store-f64 memory-size memory-grow word-div word-shr word-shl word-and word-or word-xor)\n(defun read8 (p) (load-u8 p)) (defun read16 (p) (load-u16 p)) (defun read32 (p) (load-u32 p))\n(defun write8 (p v) (store-u8 p v)) (defun write16 (p v) (store-u16 p v)) (defun write32 (p v) (store-u32 p v))\n(defun copy64 (to from) (store-f64 to (load-f64 from)))\n(defun grow (n) (memory-grow n)) (defun size () (memory-size))\n(defun add (a b) (+ a b)) (defun sub (a b) (- a b)) (defun mul (a b) (* a b))\n(defun div (a b) (word-div a b)) (defun shr (a b) (word-shr a b)) (defun shl (a b) (word-shl a b))\n(defun bits (a b) (word-xor (word-or a b) (word-and a b)))\n(defun less (a b) (if (< a b) 1 0))\n(defun equal (a b) (if (= a b) 1 0)) (defun unequal (a b) (if (/= a b) 1 0))\n(defun le (a b) (if (<= a b) 1 0)) (defun gt (a b) (if (> a b) 1 0)) (defun ge (a b) (if (>= a b) 1 0))\n(defun negate (x) (- x)) (defun dec (x) (1- x))\n(defun truth (n) (if n 7 8))\n(defun either (n) (or n (progn (store-u8 0 99) 7)))\n(defun both (n) (and n (progn (store-u8 0 77) 8)))\n(defun effects (p) (store-u32 p (progn (store-u8 16 7) 42)))\n(defun growth-effects (p) (store-u32 p (progn (memory-grow 1) 123)))\n(defun internal (p v) (write32 p v) (read32 p))\n(defun sum (a b c d e f g h i) (+ (+ (+ (+ (+ (+ (+ (+ a b) c) d) e) f) g) h) i))\n(defun nested (p) (sum (read8 p) 2 3 4 5 6 7 8 9))\n(defun trap-inner (p) (read32 p) (store-u8 0 99))\n(defun trap-outer (p) (trap-inner p) (store-u8 1 88))\n(defun loop (n) (let ((i 0) (s 0)) (while (< i n) (setq s (+ s (load-u8 i))) (setq i (1+ i))) s))\n(export read8 read16 read32 write8 write16 write32 copy64 grow size add sub mul div shr shl bits less equal unequal le gt ge negate dec truth either both effects growth-effects internal sum nested trap-outer loop)")
  (defconst arities (js-object "read8" 1 "read16" 1 "read32" 1 "write8" 2 "write16" 2 "write32" 2 "copy64" 2 "grow" 1 "size" 0 "add" 2 "sub" 2 "mul" 2 "div" 2 "shr" 2 "shl" 2 "bits" 2 "less" 2 "equal" 2 "unequal" 2 "le" 2 "gt" 2 "ge" 2 "negate" 1 "dec" 1 "truth" 1 "either" 1 "both" 1 "effects" 1 "growth-effects" 1 "internal" 2 "sum" 9 "nested" 1 "trap-outer" 1 "loop" 1))
  (defun each (items callback) (js-call items :forEach callback))
  (defasync eachAsync (items callback) (let ((index 0)) (while (< index (get items :length)) (await (funcall callback (aref items index))) (setq index (1+ index)))))
  (defun invoke (n name &rest args) (Reflect/apply (get n :invoke) n (js-call (js-array name) :concat args)))
  (defun wasmCall (w name &rest args) (uint32 (Reflect/apply (get w name) w args)))
  (defun diagnostic (error) (let ((info (get error :eliscriptDiagnostic))) (if (nullish? info) undefined (get info :code))))
  (defasync pair (&rest __host_default_arguments_1)
    (let* ((text (aref __host_default_arguments_1 0)) (signatures (aref __host_default_arguments_1 1)) (options (aref __host_default_arguments_1 2)) (nativeOnly (aref __host_default_arguments_1 3)))
    (when (= text undefined) (setq text source)) (when (= signatures undefined) (setq signatures arities))
    (when (= options undefined) (setq options (js-object :initialPages 1 :maximumPages 2)))
    (when (= nativeOnly undefined) (setq nativeOnly false))
    (let* ((ir (js-call (get backend :compiler) :compile_ir_string text "native-memory.eli"))
           (wasm (if nativeOnly undefined (get (new WebAssembly.Instance (new WebAssembly.Module (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm ir options)))) :exports)))
           (file (resolve directory (str "memory-" pairSerial ".dylib"))))
      (setq pairSerial (1+ pairSerial))
      (await (writeFile file (Uint8Array/from (js-call (get backend :native) :emit_native_memory_library ir "arm64-macos"))))
      (let* ((loader (await (funcall (js* "(url) => import(url)") "../tools/backends/native-memory.mjs")))
             (native (await (js-call loader :openNativeMemory file signatures options))))
        (js-object :native native :wasm wasm)))))
  (test "native memory32 emits deterministic direct Mach-O without mutating canonical IR" (lambda ()
    (js-call assert :equal (funcall hostTypeof (get (get backend :native) :emit_native_memory_object)) "function")
    (let* ((ir (js-call (get backend :compiler) :compile_ir_string source "native-memory.eli")) (saved (JSON/stringify ir))
           (bytes (Uint8Array/from (js-call (get backend :native) :emit_native_memory_object ir "arm64-macos"))))
      (js-call assert :deepEqual bytes (Uint8Array/from (js-call (get backend :native) :emit_native_memory_object ir "arm64-macos")))
      (js-call assert :equal (js-call (new globalThis.DataView (get bytes :buffer)) :getUint32 0 t) 4277009103)
      (js-call assert :equal (JSON/stringify ir) saved)
      (each (js-array undefined "x64-linux" "auto") (lambda (target) (js-call assert :throws
        (lambda () (js-call (get backend :native) :emit_native_memory_object ir target)) (lambda (error) (= (diagnostic error) "ELI-B0001"))))))))
  (nativeTest "native memory32 loads and stores little endian, unaligned and truncated values against WASM and DataView" (async ()
    (let* ((result (await (pair))) (n (get result :native)) (w (get result :wasm)))
      (try
        (each (js-array (js-array 1 "read8" "write8") (js-array 2 "read16" "write16") (js-array 4 "read32" "write32")) (lambda (entry)
          (let ((width (aref entry 0)) (read (aref entry 1)) (write (aref entry 2)))
            (each (js-array 0 1 3 7 (- 65536 width)) (lambda (p) (each (js-array 0 1 255 256 65535 2147483648 4294967295) (lambda (value)
              (js-call assert :equal (invoke n write p value) (wasmCall w write p value))
              (js-call assert :equal (invoke n read p) (wasmCall w read p))
              (let* ((data (new globalThis.Uint8Array width)) (v (new globalThis.DataView (get data :buffer))))
                (Reflect/apply (get v (str "setUint" (* width 8))) v (js-array 0 value t)) (js-call assert :deepEqual (js-call n :read p width) data)))))))))
        (js-call assert :equal (invoke n "internal" 1 4275878552) 4275878552) (js-call assert :equal (invoke n "sum" 1 2 3 4 5 6 7 8 9) 45)
        (js-call n :write (Uint8Array/of 1 2 3 4)) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :set (js-array 1 2 3 4))
        (js-call assert :equal (invoke n "nested" 0) 45) (js-call assert :equal (invoke n "loop" 4) (wasmCall w "loop" 4))
        (finally (js-call n :close))))))
  (nativeTest "native memory32 preserves IEEE payload bytes including NaN and negative zero" (async ()
    (let* ((result (await (pair))) (n (get result :native)) (w (get result :wasm)))
      (try (each (js-array (js* "0n") (js* "0x8000000000000000n") (js* "0x7ff0000000000000n") (js* "0xfff0000000000000n") (js* "0x7ff8000012345678n") (js* "0x7ff0000012345678n") (js* "1n")) (lambda (bits)
        (let ((bytes (new globalThis.Uint8Array 8)))
          (js-call (new globalThis.DataView (get bytes :buffer)) :setBigUint64 0 bits t)
          (js-call n :write bytes 3) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :set bytes 3)
          (js-call assert :equal (invoke n "copy64" 17 3) 0) (js-call w :copy64 17 3)
          (js-call assert :deepEqual (js-call n :read 17 8) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice 17 25))
          (js-call assert :deepEqual (js-call n :read 17 8) bytes))))
        (finally (js-call n :close))))))
  (nativeTest "native bounds checks retain operand effects, propagate nested errors and do not wrap u32 addresses" (async ()
    (let* ((result (await (pair))) (n (get result :native)) (w (get result :wasm)))
      (try
        (each (js-array (js-array 1 "read8" "write8") (js-array 2 "read16" "write16") (js-array 4 "read32" "write32") (js-array 8 "copy64" "copy64")) (lambda (entry)
          (let ((width (aref entry 0)) (read (aref entry 1)) (write (aref entry 2)))
            (each (js-array (- 65537 width) 65536 4294967288 4294967292 4294967295) (lambda (p)
              (js-call assert :throws (lambda () (Reflect/apply (get n :invoke) n (js-call (js-array read) :concat (if (= width 8) (js-array p 3) (js-array p))))) WebAssembly.RuntimeError)
              (js-call assert :throws (lambda () (Reflect/apply (get w read) w (js-array p 3))) WebAssembly.RuntimeError)
              (when (= width 8) (js-call assert :throws (lambda () (invoke n "copy64" 0 p)) WebAssembly.RuntimeError))
              (js-call assert :throws (lambda () (invoke n write p 42)) WebAssembly.RuntimeError) (js-call assert :throws (lambda () (Reflect/apply (get w write) w (js-array p 42))) WebAssembly.RuntimeError))))))
        (js-call assert :throws (lambda () (invoke n "effects" 65535)) WebAssembly.RuntimeError)
        (js-call assert :throws (lambda () (js-call w :effects 65535)) WebAssembly.RuntimeError) (js-call assert :equal (invoke n "read8" 16) 7)
        (js-call n :write (Uint8Array/of 0 0)) (js-call assert :throws (lambda () (invoke n "trap-outer" 65535)) WebAssembly.RuntimeError)
        (js-call assert :deepEqual (js-call n :read 0 2) (Uint8Array/of 0 0))
        (js-call assert :equal (invoke n "growth-effects" 65536) 0) (js-call assert :equal (Reflect/apply (get w "growth-effects") w (js-array 65536)) 0)
        (js-call assert :equal (invoke n "read32" 65536) 123)
        (finally (js-call n :close))))))
  (nativeTest "native memory32 unsigned word arithmetic and numeric truth match WASM and independent JS" (async ()
    (let* ((result (await (pair))) (n (get result :native)) (w (get result :wasm))
           (js (js-object :add (lambda (a b) (uint32 (+ a b))) :sub (lambda (a b) (uint32 (- a b))) :mul (lambda (a b) (uint32 (Math/imul a b)))
             :div (lambda (a b) (uint32 (Math/trunc (/ a b)))) :shr (lambda (a b) (unsigned-bit-shift-right a b)) :shl (lambda (a b) (uint32 (bit-shift-left a b))) :bits (lambda (a b) (uint32 (bit-xor a b)))
             :less (lambda (a b) (if (< a b) 1 0)) :equal (lambda (a b) (if (= a b) 1 0)) :unequal (lambda (a b) (if (not (= a b)) 1 0))
             :le (lambda (a b) (if (<= a b) 1 0)) :gt (lambda (a b) (if (> a b) 1 0)) :ge (lambda (a b) (if (>= a b) 1 0)))))
      (try (let ((seed 595425) (index 0))
        (letfn ((next () (setq seed (bit-xor seed (bit-shift-left seed 13))) (setq seed (bit-xor seed (unsigned-bit-shift-right seed 17))) (setq seed (bit-xor seed (bit-shift-left seed 5))) (uint32 seed)))
          (while (< index 256) (let ((a (next)) (b (next)))
            (each (Object/keys js) (lambda (name) (js-call assert :equal (invoke n name a b) (wasmCall w name a b) (str name "/" a "/" b))
              (js-call assert :equal (invoke n name a b) (Reflect/apply (get js name) js (js-array a b))))))
            (setq index (1+ index)))))
        (each (js-array 0 1 2147483648 4294967295) (lambda (v)
          (js-call assert :equal (invoke n "negate" v) (uint32 (- v))) (js-call assert :equal (invoke n "dec" v) (uint32 (1- v)))
          (js-call assert :equal (invoke n "truth" v) 7) (js-call assert :equal (invoke n "either" v) v) (js-call assert :equal (invoke n "both" v) 8)))
        (js-call assert :throws (lambda () (invoke n "div" 1 0)) WebAssembly.RuntimeError) (js-call assert :throws (lambda () (js-call w :div 1 0)) WebAssembly.RuntimeError)
        (finally (js-call n :close))))))
  (nativeTest "native memory mappings own their lifetime, isolate instances and zero growth" (async ()
    (let ((a (get (await (pair)) :native)) (b (get (await (pair)) :native)))
      (try (js-call a :write (Uint8Array/of 77)) (js-call assert :equal (invoke b "read8" 0) 0)
        (let ((copy (js-call a :read 0 1))) (put copy 0 33) (js-call assert :equal (invoke a "read8" 0) 77))
        (Bun/gc t) (js-call assert :equal (invoke a "read8" 0) 77) (js-call assert :equal (invoke a "grow" 0) 1) (js-call assert :equal (invoke a "grow" 1) 1)
        (js-call assert :equal (invoke a "size") 2) (js-call assert :deepEqual (js-call a :read 65536 16) (new globalThis.Uint8Array 16))
        (js-call assert :equal (invoke a "grow" 1) 4294967295)
        (each (js-array -1 1.5 globalThis.NaN globalThis.Infinity 4294967296) (lambda (bad) (js-call assert :throws (lambda () (invoke a "read8" bad)) globalThis.RangeError)))
        (js-call a :close) (js-call assert :throws (lambda () (invoke a "read8" 0)) (new globalThis.RegExp "closed"))
        (js-call assert :throws (lambda () (js-call a :read 0 1)) (new globalThis.RegExp "closed")) (js-call assert :equal (invoke b "read8" 0) 0)
        (finally (js-call a :close) (js-call b :close))))))
  (nativeTest "native memory f64 arithmetic and all ordered comparisons preserve IEEE behavior" (async ()
    (let* ((operators (js-object :fadd "+" :fsub "-" :fmul "*" :fdiv "/" :feq "=" :fne "/=" :flt "<" :fle "<=" :fgt ">" :fge ">="))
           (names (Object/keys operators)) (arities (Object/fromEntries (js-call names :map (lambda (name) (js-array name (if (and (js-call name :startsWith "f") (js-call (js-array "fadd" "fsub" "fmul" "fdiv") :includes name)) 3 2))))))
           (text (str "(import \"eliscript:memory32\" load-f64 store-f64) " (js-call (js-call (Object/entries operators) :map (lambda (entry)
             (let ((name (aref entry 0)) (op (aref entry 1))) (if (= (get arities name) 3)
               (str "(defun " name " (to a b) (store-f64 to (" op " (load-f64 a) (load-f64 b))))")
               (str "(defun " name " (a b) (if (" op " (load-f64 a) (load-f64 b)) 1 0))"))))) :join "\n") " (export " (js-call names :join " ") ")"))
           (result (await (pair text arities))) (n (get result :native)) (w (get result :wasm))
           (compare (js-object :feq (js* "(a,b) => a === b") :fne (js* "(a,b) => a !== b")
             :flt (lambda (a b) (< a b)) :fle (lambda (a b) (<= a b)) :fgt (lambda (a b) (> a b)) :fge (lambda (a b) (>= a b))))
           (calc (js-object :fadd (lambda (a b) (+ a b)) :fsub (lambda (a b) (- a b)) :fmul (lambda (a b) (* a b)) :fdiv (lambda (a b) (/ a b)))))
      (try (each (js-array (- globalThis.Infinity) -7 (js* "-0") 0 (get globalThis.Number :MIN_VALUE) 1.2 globalThis.Infinity globalThis.NaN) (lambda (a)
        (each (js-array (- globalThis.Infinity) -2 (js* "-0") 0 3 globalThis.Infinity globalThis.NaN) (lambda (b)
          (let* ((bytes (new globalThis.Uint8Array 16)) (dv (new globalThis.DataView (get bytes :buffer))))
            (js-call dv :setFloat64 0 a t) (js-call dv :setFloat64 8 b t) (js-call n :write bytes) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :set bytes)
            (each (Object/keys compare) (lambda (name) (js-call assert :equal (invoke n name 0 8) (wasmCall w name 0 8) (str name "/" a "/" b))
              (js-call assert :equal (invoke n name 0 8) (if (Reflect/apply (get compare name) compare (js-array a b)) 1 0))))
            (each (Object/keys calc) (lambda (name) (js-call assert :equal (invoke n name 32 0 8) 0) (Reflect/apply (get w name) w (js-array 32 0 8))
              (let ((got (js-call (new globalThis.DataView (get (js-call n :read 32 8) :buffer)) :getFloat64 0 t)))
                (assert (Object/is got (Reflect/apply (get calc name) calc (js-array a b))) (str name "/" a "/" b))
                (assert (Object/is got (js-call (new globalThis.DataView (get (get w :memory) :buffer)) :getFloat64 32 t)))))))))))
        (finally (js-call n :close))))))
  (nativeTest "native memory zero-page mappings, growth limits and invalid ABI inputs fail safely" (async ()
    (let ((n (get (await (pair source arities (js-object :initialPages 0 :maximumPages 1) t)) :native)))
      (try
        (js-call assert :equal (get n :byteLength) 0) (js-call assert :equal (invoke n "size") 0) (js-call assert :equal (invoke n "grow" 0) 0)
        (js-call assert :throws (lambda () (invoke n "read8" 0)) WebAssembly.RuntimeError)
        (js-call assert :equal (invoke n "grow" 4294967295) 4294967295) (js-call assert :equal (invoke n "size") 0)
        (js-call assert :equal (invoke n "grow" 1) 0) (js-call assert :equal (invoke n "write32" 65532 4294967295) 0) (js-call assert :equal (invoke n "read32" 65532) 4294967295)
        (js-call assert :throws (lambda () (invoke n "missing")) globalThis.TypeError)
        (js-call assert :throws (lambda () (invoke n "read8")) globalThis.TypeError) (js-call assert :throws (lambda () (invoke n "read8" 0 1)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call n :write (Uint8Array/of 1) 65536)) globalThis.RangeError)
        (js-call assert :throws (lambda () (js-call n :read 65535 2)) globalThis.RangeError) (js-call assert :throws (lambda () (js-call n :write (js-array))) globalThis.TypeError)
        (let ((loader (await (funcall (js* "(url) => import(url)") "../tools/backends/native-memory.mjs"))))
          (await (eachAsync (js-array (js-object :initialPages -1) (js-object :initialPages 2 :maximumPages 1) (js-object :initialPages 1.5) (js-object :maximumPages 65537))
            (async (options) (await (js-call assert :rejects (js-call loader :openNativeMemory "unused" (js-object) options) globalThis.RangeError))))))
        (finally (js-call n :close))))))
  (test "native memory rejects unsupported input even in unselected branches" (lambda ()
    (each (js-array "(defun f (x) (if false (js* \"x\") x))" "(import \"eliscript:memory32\" store-u32 load-f64) (defun f (p) (store-u32 p (load-f64 p)))" "(defun f (x) -0.0)") (lambda (text) (js-call assert :throws (lambda () (js-call (get backend :native) :emit_native_memory_object
      (js-call (get backend :compiler) :compile_ir_string text "memory-rejected.eli") "arm64-macos")) (lambda (error) (= (diagnostic error) "ELI-B0001")))))))
  (nativeTest "native memory result bytes and unsigned arithmetic agree with an independent Node oracle" (async ()
    (let* ((node (get (get process :env) :NODE))
           (oracle (spawnSync (if (nullish? node) "node" node) (js-array (resolve (js* "import.meta.dir") "fixtures/native-word-oracle-host.mjs")) (js-object :encoding "utf8" :timeout 30000))))
      (js-call assert :equal (get oracle :status) 0 (get oracle :stderr))
      (let ((n (get (await (pair)) :native)))
        (try (each (JSON/parse (get oracle :stdout)) (lambda (entry) (let ((a (aref entry 0)) (b (aref entry 1)))
          (js-call assert :equal (invoke n "add" a b) (aref entry 2)) (js-call assert :equal (invoke n "mul" a b) (aref entry 3)) (js-call assert :equal (invoke n "bits" a b) (aref entry 4)))))
          (finally (js-call n :close)))))))
  (test "native memory direct emission reaches a public Seed and three-generation byte fixed point" (async ()
    (let* ((root (resolve (js* "import.meta.dir") "..")) (generations (js-array (await (buildBackends (js-object :outputRoot (resolve directory "g1") :seed t)))))
           (modules (js-call (js-call (await (readdir (resolve root "bootstrap/compiler"))) :filter (lambda (name) (js-call name :endsWith ".eli"))) :sort)))
      (await (eachAsync (js-array "g2" "g3") (async (name)
        (let* ((outputRoot (resolve directory name)) (output (resolve outputRoot "bootstrap")) (previous (get (js-call generations :at -1) :compiler)))
          (await (mkdir output (js-object :recursive t)))
          (await (eachAsync modules (async (file)
            (let* ((input (resolve root "bootstrap/compiler" file)) (generated (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                   (emission (js-call previous :compile_string_with_source_map (await (readFile input "utf8")) input generated (relative output input))))
              (await (writeFile (resolve output generated) (str (get emission :javascript) "//# sourceMappingURL=" generated ".map\n")))
              (await (writeFile (resolve output (str generated ".map")) (get emission :sourceMap)))))))
          (let ((b (await (buildBackends (js-object :outputRoot outputRoot :frontend previous)))))
            (put b :compiler (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve output "compiler.mjs")) :href))))
            (js-call generations :push b))))))
      (let ((artifacts (js-call generations :map (lambda (g) (let ((ir (js-call (get g :compiler) :compile_ir_string source "native-memory.eli")))
        (js-object :object (Uint8Array/from (js-call (get g :native) :emit_native_memory_object ir "arm64-macos")) :library (Uint8Array/from (js-call (get g :native) :emit_native_memory_library ir "arm64-macos"))))))))
        (each (js-call artifacts :slice 1) (lambda (artifact) (js-call assert :deepEqual artifact (aref artifacts 0)))))
      (let ((indirect (await (Promise/all (js-call generations :map (async (g)
        (let* ((memory (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve (get g :directory) "memory.mjs")) :href))))
               (program (js-call memory :lower_memory_program (js-call (get g :compiler) :compile_ir_string "(import \"eliscript:memory32\" call-source) (defun target (a b c d) (+ (+ a b) (+ c d))) (defun invoke (slot) (call-source 1 2 3 4 slot)) (export invoke)" "native-indirect-fixedpoint.eli"))))
          (put program :table (js-array (get (js-call (get program :functions) :find (lambda (f) (= (get f :name) "target"))) :index)))
          (put program :aliases (js-array (js-object :name "invoke-alias" :function "invoke")))
          (js-object :object (Uint8Array/from (js-call (get g :native) :emit_typed_native_memory_object program "arm64-macos")) :library (Uint8Array/from (js-call (get g :native) :emit_typed_native_memory_library program "arm64-macos"))))))))))
        (each (js-call indirect :slice 1) (lambda (artifact) (js-call assert :deepEqual artifact (aref indirect 0))))))) 120000)
)
