(module tests.native-node-signed-zero.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (defconst target (if (= (get process :arch) "arm64")
    (if (= (get process :platform) "darwin") "arm64-macos" (if (= (get process :platform) "linux") "arm64-linux" undefined)) undefined))
  (defconst nativeTest (js-call test :skipIf (not target)))
  (defvar directory undefined) (defvar library undefined)
  (defconst signatures (js-object
    :sign-u32 (js-object :arity 1 :parameterTypes (js-array "f64") :resultType "u32")
    :negzero-f64 (js-object :arity 0 :parameterTypes (js-array) :resultType "f64")))
  (defconst source
    "\n    (import \"eliscript:memory32\" load-u32 store-f64 f64-from-bits64 bits64-literal)\n    (defun sign-u32 (value) (memory-sig u32 f64) (store-f64 0 value) (load-u32 4))\n    (defun negzero-f64 () (memory-sig f64) (f64-from-bits64 (bits64-literal 0 2147483648)))\n    (export sign-u32 negzero-f64)")
  (defconst host (fileURLToPath (new globalThis.URL "./fixtures/native-node-memory-host.mjs" (js* "import.meta.url"))))
  (defun node () (if (nullish? (get (get process :env) :NODE)) "node" (get (get process :env) :NODE)))
  (defun env () (Object/assign (js-object) (get process :env) (js-object :NODE_OPTIONS "" :BUN_OPTIONS "")))
  (beforeAll (async ()
    (when target
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-signed-zero-"))))
      (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
             (ir (js-call (get backend :compiler) :compile_ir_string source "native-node-signed-zero.eli")))
        (setq library (resolve directory (if (= target "arm64-macos") "memory.dylib" "memory.so")))
        (await (writeFile library (Uint8Array/from (js-call (get backend :native) :emit_native_memory_library ir target))))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (nativeTest "parameter -0 is observed as the f64 sign word and a parameterless f64 result stays -0" (async ()
    (let ((parameters (resolve directory "signed-zero.json")))
      (await (writeFile parameters (JSON/stringify (js-object :mode "signed-zero" :library library :signatures signatures
        :configuration (js-object :initialPages 1 :maximumPages 2 :nativeTarget target :bunExecutable (get process :execPath))))))
      (let ((result (spawnSync (node) (js-array host parameters) (js-object :cwd directory :encoding "utf8" :timeout 30000 :env (env)))))
        (js-call assert :equal (get result :status) 0 (str (get result :stderr) (get result :stdout)))
        (js-call assert :equal (get result :stdout) "native-node-verified\n")))) 30000)
)
