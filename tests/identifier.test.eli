(module tests.identifier.test
  (import "bun:test" expect test)
  (import "../runtime/core/identifier.mjs" EliscriptSymbol Keyword eliscriptSymbol identifierName identifierNamespace isEliscriptSymbol isIdentifier isKeyword keyword qualifiedIdentifierName)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun rejects (operation &rest __host_default_arguments_1)
    (let* ((message (aref __host_default_arguments_1 0))) (if (= message undefined) (js-call (expect operation) :toThrow) (js-call (expect operation) :toThrow message))))
  (defun objectTag (value) (Reflect/apply (get (get globalThis.Object :prototype) :toString) value (js-array)))
  (test "keywords are immutable, interned qualified identifiers" (lambda ()
    (let ((title (keyword "article/title")))
      (be title (keyword "article" "title")) (be (keyword title) title) (js-call (expect title) :toBeInstanceOf Keyword)
      (be (Object/isFrozen title) t) (be (objectTag title) "[object EliscriptKeyword]") (be (funcall globalThis.String title) ":article/title")
      (be (identifierNamespace title) "article") (be (identifierName title) "title") (be (qualifiedIdentifierName title) "article/title")
      (be (isKeyword title) t) (be (isEliscriptSymbol title) false) (be (isIdentifier title) t)
      (js-call (expect (Object/getOwnPropertyDescriptor title (js-call globalThis.Symbol :for "eliscript.value.type"))) :toMatchObject (js-object :value "keyword" :enumerable false))
      (rejects (lambda () (JSON/stringify title)) "Keyword values require an explicit serialization codec")
      (rejects (lambda () (new Keyword)) "Keyword values must be created with keyword()"))))
  (test "symbols have value identity without interning" (lambda ()
    (let ((left (eliscriptSymbol "article/title")) (right (eliscriptSymbol "article" "title")))
      (js-call (get (expect left) :not) :toBe right) (be (eliscriptSymbol left) left) (js-call (expect left) :toBeInstanceOf EliscriptSymbol)
      (be (Object/isFrozen left) t) (be (objectTag left) "[object EliscriptSymbol]") (be (funcall globalThis.String left) "article/title")
      (be (isKeyword left) false) (be (isEliscriptSymbol left) t) (be (isIdentifier left) t)
      (be (equalValues left right) t) (be (hashValue left) (hashValue right)) (be (equalValues left (keyword "article/title")) false)
      (js-call (get (expect (hashValue left)) :not) :toBe (hashValue (keyword "article/title")))
      (rejects (lambda () (JSON/stringify left)) "EliscriptSymbol values require an explicit serialization codec")
      (rejects (lambda () (new EliscriptSymbol)) "EliscriptSymbol values must be created with eliscriptSymbol()"))))
  (test "identifier constructors validate their canonical shape" (lambda ()
    (js-call (js-array "" "/name" "namespace/" "a/b/c") :forEach (lambda (invalid) (rejects (lambda () (keyword invalid))) (rejects (lambda () (eliscriptSymbol invalid)))))
    (rejects (lambda () (keyword)) "keyword expects one qualified name or namespace and name")
    (js-call (get (expect (lambda () (keyword nil "name"))) :not) :toThrow)
    (rejects (lambda () (keyword "" "name")) "keyword namespace must be a non-empty string")
    (rejects (lambda () (keyword "namespace" "a/b")) "keyword name cannot contain /")
    (rejects (lambda () (identifierName (js-object :name "plain"))) "expected an Eliscript keyword or symbol")
    (let ((hostile (new globalThis.Proxy (js-object) (js-object :getOwnPropertyDescriptor (lambda () (throw (new globalThis.Error "host trap")))))))
      (be (isIdentifier hostile) false) (be (equalValues (keyword "safe") hostile) false))))
  (test "persistent maps and sets use identifier value semantics" (lambda ()
    (let ((map (persistentHashMap (js-array (keyword "article/title") "keyword") (js-array (eliscriptSymbol "article/title") "symbol"))))
      (be (get map :count) 2) (be (js-call map :get (keyword "article" "title")) "keyword") (be (js-call map :get (eliscriptSymbol "article" "title")) "symbol"))
    (let ((set (persistentHashSet (eliscriptSymbol "article/title") (eliscriptSymbol "article" "title") (keyword "article/title"))))
      (be (get set :count) 2) (be (js-call set :has (eliscriptSymbol "article/title")) t) (be (js-call set :has (keyword "article/title")) t))))
)
