(module tests.platform-capabilities.test
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" :default path)
  (import "node:url" fileURLToPath)
  (import "../platform/browser.mjs" BrowserCapabilityError browserCapabilities browserCapabilityDescriptor browserClearTimeout
    browserDocument browserFetch browserNow browserRandomValues browserSetTimeout hasBrowserCapability isBrowserCapabilities)
  (import "../platform/worker.mjs" WorkerCapabilityError decodeWorkerValue encodeWorkerValue hasWorkerCapability isWorkerCapabilities
    throwIfWorkerCancelled workerCapabilities workerCancelled workerCapabilityDescriptor workerProgress workerSignal)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst ROOT (js-call path :resolve (js-call path :dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defconst HOST_FIXTURE (js-call path :join ROOT "tests/fixtures/platform-capabilities.mjs"))
  (defconst native-method (js* "(implementation) => function(...args) { return implementation(this, args); }"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun rejects (operation expected) (js-call (expect operation) :toThrow expected))
  (defasync runHost (command)
    (let* ((child (Bun/spawn (js-array command HOST_FIXTURE) (js-object :cwd ROOT :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (unless (= exitCode 0) (let ((error (js-call stderr :trim))) (throw (new globalThis.Error (if (= error "") (str command " exited with " exitCode) error)))))
      (JSON/parse stdout)))
  (test "browser capabilities expose only explicitly granted host authority" (async ()
    (let* ((document (js-object :title "Eliscript")) (calls (js-array)) (scope (js-object :document document))
           (performance (js-object)) (crypto (js-object)))
      (put scope :fetch (funcall native-method (lambda (this args)
        (let ((input (aref args 0)) (init (aref args 1)))
          (js-call calls :push (js-array "fetch" (= this scope) input init)) (Promise/resolve (js-object :ok t :input input))))))
      (put performance :now (funcall native-method (lambda (this args) (js-call calls :push (js-array "now" (= this (get scope :performance)))) 17.25)))
      (put crypto :getRandomValues (funcall native-method (lambda (this args)
        (let ((values (aref args 0))) (js-call calls :push (js-array "random" (= this (get scope :crypto)))) (js-call values :fill 7) values))))
      (put scope :performance performance) (put scope :crypto crypto)
      (put scope :setTimeout (funcall native-method (lambda (this args)
        (let ((callback (aref args 0)) (delay (aref args 1)) (arguments_ (js-call args :slice 2)))
          (js-call calls :push (js-array "set-timeout" (= this scope) delay)) (apply callback arguments_) 41))))
      (put scope :clearTimeout (funcall native-method (lambda (this args) (js-call calls :push (js-array "clear-timeout" (= this scope) (aref args 0))) undefined)))
      (let* ((capabilities (browserCapabilities scope (js-array "timers" "network" "document" "randomness" "clock")))
             (descriptor (browserCapabilityDescriptor capabilities)))
        (be (isBrowserCapabilities capabilities) t) (be (Object/isFrozen capabilities) t)
        (be (Object/isFrozen descriptor) t) (be (Object/isFrozen (get descriptor :grants)) t)
        (same descriptor (js-object :format "eliscript-browser-capabilities" :version 1 :grants (js-array "clock" "document" "network" "randomness" "timers")))
        (be (hasBrowserCapability capabilities "network") t)
        (put scope :document (js-object :title "replacement")) (put scope :fetch (lambda () (js-object :ok false)))
        (be (browserDocument capabilities) document)
        (same (await (browserFetch capabilities "/index" (js-object :method "GET"))) (js-object :ok t :input "/index"))
        (be (browserNow capabilities) 17.25)
        (let ((values (new globalThis.Uint8Array 3)))
          (be (browserRandomValues capabilities values) values) (same (Array/from values) (js-array 7 7 7)))
        (let* ((delivered undefined) (handle (browserSetTimeout capabilities (lambda (value) (setq delivered value)) 25 "ready")))
          (be handle 41) (browserClearTimeout capabilities handle) (be delivered "ready"))
        (same calls (js-array (js-array "fetch" t "/index" (js-object :method "GET")) (js-array "now" t)
          (js-array "random" t) (js-array "set-timeout" t 25) (js-array "clear-timeout" t 41)))))))
  (test "browser capabilities reject ambient unavailable and forged authority" (lambda ()
    (let ((empty (browserCapabilities (js-object) (js-array))))
      (same (get (browserCapabilityDescriptor empty) :grants) (js-array)) (be (hasBrowserCapability empty "network") false)
      (rejects (lambda () (browserFetch empty "/hidden")) BrowserCapabilityError)
      (try (browserFetch empty "/hidden") (catch error (js-call (expect error) :toMatchObject (js-object :code "missing-capability" :capability "network"))))
      (rejects (lambda () (browserCapabilities (js-object) (js-array "network"))) "browser host does not provide network")
      (rejects (lambda () (browserCapabilities (js-object :setTimeout (lambda () nil)) (js-array "timers"))) "browser host does not provide timers")
      (rejects (lambda () (browserCapabilities (js-object) (js-array "unknown"))) "unknown browser capability unknown")
      (rejects (lambda () (browserCapabilities (js-object) (js-array "clock" "clock"))) "browser grants must not contain duplicates")
      (rejects (lambda () (browserCapabilityDescriptor (js-object :format "eliscript-browser-capabilities" :version 1 :grants (js-array)))) "expected Eliscript browser capabilities")
      (rejects (lambda () (browserFetch (copyHostRecord (browserCapabilityDescriptor empty)) "/copied")) "expected Eliscript browser capabilities"))))
  (test "worker capabilities preserve progress cancellation and codec boundaries" (lambda ()
    (let* ((controller (new globalThis.AbortController)) (progress (js-array)) (context (js-object :signal (get controller :signal))))
      (put context :progress (funcall native-method (lambda (this args)
        (js-call progress :push (js-array (= this context) (aref args 0))) (get progress :length))))
      (let* ((capabilities (workerCapabilities context (js-array "progress" "cancellation"))) (descriptor (workerCapabilityDescriptor capabilities)))
        (be (isWorkerCapabilities capabilities) t) (be (Object/isFrozen capabilities) t) (be (Object/isFrozen descriptor) t) (be (Object/isFrozen (get descriptor :grants)) t)
        (same descriptor (js-object :format "eliscript-worker-capabilities" :version 1 :grants (js-array "cancellation" "progress")))
        (be (hasWorkerCapability capabilities "progress") t) (be (workerSignal capabilities) (get controller :signal)) (be (workerCancelled capabilities) false)
        (be (workerProgress capabilities (js-object :stage "scan")) 1) (same progress (js-array (js-array t (js-object :stage "scan"))))
        (same (decodeWorkerValue (encodeWorkerValue (js-array 1 undefined (js* "-0")))) (js-array 1 undefined (js* "-0")))
        (js-call controller :abort) (be (workerCancelled capabilities) t)
        (rejects (lambda () (throwIfWorkerCancelled capabilities)) WorkerCapabilityError)
        (try (throwIfWorkerCancelled capabilities) (catch error (js-call (expect error) :toMatchObject (js-object :code "worker-cancelled" :capability "cancellation"))))))))
  (test "worker capabilities reject undeclared unavailable and forged operations" (lambda ()
    (let ((progressOnly (workerCapabilities (js-object :progress (lambda () nil)) (js-array "progress"))))
      (same (get (workerCapabilityDescriptor progressOnly) :grants) (js-array "progress")) (be (hasWorkerCapability progressOnly "cancellation") false)
      (rejects (lambda () (workerSignal progressOnly)) "was not granted")
      (rejects (lambda () (workerCapabilities (js-object) (js-array "progress"))) "worker context does not provide progress")
      (rejects (lambda () (workerCapabilities (js-object) (js-array "cancellation"))) "worker context does not provide an AbortSignal")
      (rejects (lambda () (workerCapabilities (js-object) (js-array "process"))) "unknown worker capability process")
      (rejects (lambda () (workerCapabilities (js-object) (js-array "progress" "progress"))) "worker grants must not contain duplicates")
      (rejects (lambda () (workerCapabilityDescriptor (js-object :format "eliscript-worker-capabilities" :version 1 :grants (js-array)))) "expected Eliscript worker capabilities")
      (rejects (lambda () (workerProgress (copyHostRecord (workerCapabilityDescriptor progressOnly)))) "expected Eliscript worker capabilities"))))
  (test "platform capability behavior is identical under Bun and Node" (async ()
    (let* ((result (await (Promise/all (js-array (runHost (get globalThis.process :execPath)) (runHost "node"))))) (bun (aref result 0)) (node (aref result 1)))
      (same node bun) (same bun (js-object "browser" (js-object "format" "eliscript-browser-capabilities" "version" 1 "grants" (js-array "clock" "network")) "fetch" (js-object "ok" t "input" "/articles") "now" 42.5 "worker" (js-object "format" "eliscript-worker-capabilities" "version" 1 "grants" (js-array "cancellation" "progress")) "progress" (js-array "indexed"))))))
  (test "platform packages have no ambient global or application dependency" (async ()
    (let ((files (js-array "platform/browser.mjs" "platform/worker.mjs")) (index 0))
      (while (< index 2)
        (let ((source (await (readFile (js-call path :join ROOT (aref files index)) "utf8"))))
          ;; Qualified language primitives grant no ambient browser or worker authority.
          (js-call (get (expect source) :not) :toMatch
            (new globalThis.RegExp "\\b(?:window|self)\\b|\\bglobalThis\\b(?!\\.(?:Object|Array|String|Number|Boolean|Error|TypeError|RangeError|Promise|Symbol|WeakMap|WeakSet|Map|Set|RegExp|Uint8Array|AbortSignal)\\b)" "u"))
          (js-call (get (expect source) :not) :toMatch (new globalThis.RegExp "\\b(?:react|vite)\\b" "iu")))
        (setq index (1+ index))))))
)
