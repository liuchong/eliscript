(module tests.worker-value-stream-probe
  (import "bun:test" expect test)
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve dirname)
  (import "node:url" fileURLToPath pathToFileURL)

  (defconst projectDirectory (resolve (dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defconst probePath (resolve projectDirectory "tools/worker/value-stream-probe.el"))
  (defconst emacs (or (get (get globalThis.process :env) :EMACS) "emacs"))
  (defconst loadModule (js* "(specifier) => import(specifier)"))
  (defconst preparedRuntimeCapsules
    (js-array "runtime/array-text.mjs" "runtime/errors.mjs" "runtime/math.mjs"
              "runtime/number-radix.mjs" "runtime/prelude.mjs" "runtime/primitives.mjs"
              "runtime/unicode-case.mjs" "runtime/unicode-case-data.mjs"))
  (defconst preparedRuntimeSources
    (js-array "runtime/array-text.eli" "runtime/errors.eli" "runtime/math.eli"
              "runtime/number-radix.eli" "runtime/prelude.eli" "runtime/primitives.eli"
              "runtime/unicode-case.eli" "bootstrap/runtime/memory.eli"
              "tools/runtime/unicode-case-runtime.el"))

  (defasync readJson (relativePath)
    (JSON/parse (await (readFile (resolve projectDirectory relativePath) "utf8"))))

  (defasync sha256 (relativePath)
    (js-call (js-call (createHash "sha256")
               :update (await (readFile (resolve projectDirectory relativePath))))
      :digest "hex"))

  (defasync freshPreparedIdentity ()
    (let* ((module (await (funcall loadModule
                            (get (pathToFileURL (resolve projectDirectory "tools/backends/dist/release-cli.mjs")) :href))))
           (prepared (await (js-call module :requirePreparedStage3))))
      (get prepared :reportIdentity)))

  (defun preparedIdentityP (identity)
    (and identity
         (= (get identity :format) "eliscript-prepared-stage3")
         (= (js-length (Object/keys identity)) 5)
         (Number/isInteger (get identity :version))
         (Number/isInteger (get identity :fixedPointFileCount))
         (= (value-type (get identity :sourceSha256)) "string")
         (= (value-type (get identity :productSha256)) "string")))

  (defun ensurePreparedIdentity (identity)
    (unless (preparedIdentityP identity)
      (throw (new globalThis.Error "prepared stage3 portable identity is missing or invalid")))
    identity)

  (defun ensureCurrentPreparedIdentity (identity fresh)
    (ensurePreparedIdentity identity)
    (unless (and (= (get identity :format) (get fresh :format))
                 (= (get identity :version) (get fresh :version))
                 (= (get identity :fixedPointFileCount) (get fresh :fixedPointFileCount))
                 (= (get identity :sourceSha256) (get fresh :sourceSha256))
                 (= (get identity :productSha256) (get fresh :productSha256)))
      (throw (new globalThis.Error "prepared stage3 identity does not match current final products")))
    identity)

  (defun ensurePreparedRuntimeInventory (source)
    (let ((files (js-array)) (entries (get source :files)) (index 0))
      (while (< index (js-length entries))
        (js-call files :push (get (aref entries index) :file))
        (setq index (1+ index)))
      (js-call preparedRuntimeCapsules :forEach
        (lambda (file)
          (unless (js-call files :includes file)
            (throw (new globalThis.Error (str "missing prepared runtime capsule " file))))))
      (js-call preparedRuntimeSources :forEach
        (lambda (file)
          (unless (js-call files :includes file)
            (throw (new globalThis.Error (str "missing prepared runtime source " file))))))))

  (defun verifyRetainedPreparedIdentity (identity)
    ;; Retained measurements may predate the prepared-stage3 certificate.
    ;; When present, only the portable shape is checked; no historical
    ;; measurement is retroactively certified by the current gate.
    (when identity
      (js-call (expect (get identity :format)) :toBe "eliscript-prepared-stage3")
      (js-call (expect (js-call (Object/keys identity) :sort))
        :toEqual (js-array "fixedPointFileCount" "format" "productSha256" "sourceSha256" "version"))
      (js-call (expect (Number/isInteger (get identity :version))) :toBe t)
      (js-call (expect (Number/isInteger (get identity :fixedPointFileCount))) :toBe t)
      (js-call (expect (get identity :sourceSha256)) :toHaveLength 64)
      (js-call (expect (get identity :productSha256)) :toHaveLength 64)))

  (defasync verifySourceFiles (source)
    (let ((measuredFiles (js-array))
          (files (get source :files))
          (i 0))
      (while (< i (js-length files))
        (let* ((entry (aref files i))
               (digest (await (sha256 (get entry :file)))))
          (js-call (expect digest) :toBe (get entry :sha256))
          (js-call measuredFiles :push (str (get entry :file) ":" digest "\n")))
        (setq i (1+ i)))
      (js-call (expect (js-call (js-call (createHash "sha256")
                                  :update (js-call measuredFiles :join ""))
                         :digest "hex"))
        :toBe (get source :digest))))

  (defasync verifyCurrentSourceContract (source)
    (ensureCurrentPreparedIdentity (get source :preparedCompiler)
      (await (freshPreparedIdentity)))
    (ensurePreparedRuntimeInventory source)
    (await (verifySourceFiles source)))

  (defasync runProbe (environment)
    (let* ((env (Object/assign (js-object) (get globalThis.process :env)
                  (js-object :BUN (get globalThis.process :execPath))
                  environment))
           (child (js-call globalThis.Bun :spawn
                    (js-array emacs "--batch" "-Q" "--script" probePath)
                    (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe" :env env)))
           (parts (await (Promise/all
                           (js-array (get child :exited)
                             (js-call (new globalThis.Response (get child :stdout)) :text)
                             (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref parts 0) :stdout (aref parts 1) :stderr (aref parts 2))))

  (test "real Emacs and Bun processes report bounded chunked value memory"
    (async ()
      (let* ((res (await (runProbe (js-object
                                     :ELISCRIPT_VALUE_STREAM_PROBE_MIB "1"
                                     :ELISCRIPT_VALUE_STREAM_PROBE_TIMEOUT_SECONDS "30"))))
             (exitCode (get res :exitCode))
             (stdout (get res :stdout))
             (stderr (get res :stderr)))
        (unless (= exitCode 0)
          (throw (new globalThis.Error
                   (if (> (js-length (js-call stderr :trim)) 0)
                     (js-call stderr :trim)
                     (js-call stdout :trim)))))
        (let ((report (JSON/parse stdout)))
          (js-call (expect report) :toMatchObject
            (js-object
              :schemaVersion 1
              :format "eliscript-worker-value-stream-probe"
              :version 1
              :verified t
              :withinBudget t
              :dataset (js-object
                         :kind "ascii-string-round-trip"
                         :logicalMiB 1
                         :logicalBytes (* 1024 1024))
              :transport (js-object
                           :encoding "eliscript-value-v1"
                           :framing "eliscript-value-chunks-v1"
                           :maxChunkBytes (* 256 1024)
                           :maxEventsPerChunk 512
                           :maxTextPartUnits 8192)
              :memory (js-object :unit "KiB")))
          (js-call (expect (> (get (get report :transport) :argumentChunks) 1)) :toBe t)
          (js-call (expect (> (get (get report :transport) :responseChunks) 1)) :toBe t)
          (js-call (expect (>= (get (get (get report :memory) :emacs) :peak)
                               (get (get (get report :memory) :emacs) :baseline))) :toBe t)
          (js-call (expect (>= (get (get (get report :memory) :worker) :peak)
                               (get (get (get report :memory) :worker) :baseline))) :toBe t)
          (js-call (expect (> (get (get report :memory) :combinedPeak) 0)) :toBe t)
          (js-call (expect (get (get report :source) :digest)) :toHaveLength 64)
          (await (verifyCurrentSourceContract (get report :source))))))
    40000)

  (test "value-stream probe cancels and fails when a memory budget is exceeded"
    (async ()
      (let* ((res (await (runProbe (js-object
                                     :ELISCRIPT_VALUE_STREAM_PROBE_MIB "1"
                                     :ELISCRIPT_VALUE_STREAM_PROBE_EMACS_BUDGET_MIB "1"
                                     :ELISCRIPT_VALUE_STREAM_PROBE_TIMEOUT_SECONDS "30"))))
             (exitCode (get res :exitCode))
             (stdout (get res :stdout)))
        (js-call (get (expect exitCode) :not) :toBe 0)
        (let ((report (JSON/parse stdout)))
          (js-call (expect (get report :verified)) :toBe false)
          (js-call (expect (get report :withinBudget)) :toBe false)
          (js-call (expect (> (get (get (get report :memory) :emacs) :peak) 1024)) :toBe t)
          (js-call (expect (get (get report :error) :code)) :toBe "cancelled"))))
    40000)

  (test "committed 256 MiB value-stream report matches its measured sources"
    (async ()
      (let ((report (await (readJson "benchmarks/worker-value-stream-macos-arm64.json"))))
        (js-call (expect report) :toMatchObject
          (js-object
            :schemaVersion 1
            :format "eliscript-worker-value-stream-probe"
            :version 1
            :verified t
            :withinBudget t
            :dataset (js-object
                       :kind "ascii-string-round-trip"
                       :logicalMiB 256
                       :logicalBytes (* 256 1024 1024)
                       :sha256 "8531f9720e3f5ce15fde831a4c677c501b3ef320d4f156c1248299cd9955392d")
            :transport (js-object
                         :encoding "eliscript-value-v1"
                         :framing "eliscript-value-chunks-v1"
                         :maxChunkBytes (* 256 1024)
                         :maxEventsPerChunk 512
                         :maxTextPartUnits 8192)
            :budgetsMiB (js-object
                          :emacsPeak 2048
                          :workerPeak 1024
                          :combinedPeak 2560)))
        (js-call (expect (> (get (get report :transport) :argumentChunks) 1000)) :toBe t)
        (js-call (expect (> (get (get report :transport) :responseChunks) 1000)) :toBe t)
        (js-call (expect (<= (get (get (get report :memory) :emacs) :peak)
                             (* (get (get report :budgetsMiB) :emacsPeak) 1024))) :toBe t)
        (js-call (expect (<= (get (get (get report :memory) :worker) :peak)
                             (* (get (get report :budgetsMiB) :workerPeak) 1024))) :toBe t)
        (js-call (expect (<= (get (get report :memory) :combinedPeak)
                             (* (get (get report :budgetsMiB) :combinedPeak) 1024))) :toBe t)
        (verifyRetainedPreparedIdentity (get (get report :source) :preparedCompiler))
        (await (verifySourceFiles (get report :source)))))))
