(module tests.portable-json
  (import "bun:test" test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries pruneLibrary assertSourceMap be same contains excludes)
  (test "portable JSON values are strict, canonical, bounded, and self-hosted"
    (async () (await (withPortableLibraries
      (js-object :module "json" :sources (js-array "bit" "identifier" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value" "result" "json") :fixture "tests/fixtures/portable-json-host.mjs" :loader t :parallelHosts false)
      (async (context)
        (let ((report (get context :report)))
      (same (get report :parsing) (js-object "ok" t "map" t "vector" t "vectorCount" 3 "trueValue" t "nilValue" t "stringValue" "x\n\u263a" "numberValue" (- 1250)))
      (same (get report :strings) (js-object "escapedCodes" (js-array 34 92 47 8 12 10 13 9 65) "emojiText" "\"\\ud83d\\ude00\"" "emojiRoundTrip" t "loneSurrogateText" "\"\\ud800\"" "loneSurrogateRoundTrip" t))
      (same (get report :canonical) (js-object "first" "{\"a\":1,\"b\":2}" "sameAcrossInsertionOrder" t "nested" "{\"a\":{\"n\":-1250},\"z\":[true,null,\"x\\n\u263a\"]}" "negativeZero" "0"))
      (be (get (get report :strictness) :malformed) t)
      (be (get (get report :strictness) :malformedCount) 14)
      (same (get (get report :strictness) :duplicate) (js-object "result" t "jsonError" t "code" "ELI-JSON-DUPLICATE" "message" "duplicate object key" "offset" 7 "path" "$[\"a\"]"))
      (be (get (get (get report :strictness) :overflow) :code) "ELI-JSON-NUMBER")
      (be (get (get (get report :strictness) :sourceType) :code) "ELI-JSON-TYPE")
      (same (get (get report :domain) :unsupported) (js-call (new globalThis.Array 8) :fill "ELI-JSON-UNSUPPORTED"))
      (same (get (get report :domain) :badNumberCodes) (js-call (new globalThis.Array 3) :fill "ELI-JSON-NUMBER"))
      (be (get (get (get report :domain) :badKey) :code) "ELI-JSON-KEY")
      (be (get (get report :domain) :sharedText) "[[1],[1]]")
      (be (get (get (get report :domain) :cycle) :code) "ELI-JSON-CYCLE")
      (be (get (get (get report :domain) :cycle) :path) "$[0]")
      (be (get (get report :domain) :malformedErrorRejected) t)
      (same (get (get (get report :limits) :parse) :optionValues) (js-call (new globalThis.Array 3) :fill "ELI-JSON-OPTIONS"))
      (be (get (get (get report :limits) :parse) :nullOptionsUseDefaults) t)
      (be (get (get report :properties) :generatedRoundTrips) t)
      (same (get report :scale) (js-object "ok" t "count" 20000 "first" 0 "last" 19999 "stable" t))
      (let ((phases (js-array (get (get report :limits) :parse) (get (get report :limits) :stringify))) (index 0))
        (while (< index 2)
          (let ((phase (aref phases index)))
            (be (get (get phase :options) :code) "ELI-JSON-OPTIONS")
            (be (get (get phase :length) :code) "ELI-JSON-LENGTH")
            (be (get (get phase :depth) :code) "ELI-JSON-DEPTH")
            (be (get (get phase :values) :code) "ELI-JSON-VALUES"))
          (setq index (1+ index))))
      (await (pruneLibrary context "parse-json" (js-array "function parse_json(") (js-array "function stringify_json(" "function json_encode_node(" "function json_sort_entries(" "JSON.parse" "JSON.stringify")))
      (await (assertSourceMap (get context :seedDirectory) "json" (js-array "(defportable parse-json" "(defportable stringify-json")))
      (let ((complete (await (readFile (resolve (get context :seedDirectory) "json.mjs") "utf8"))))
        (excludes complete "JSON.parse") (excludes complete "JSON.stringify"))
        ))))) 120000)
)
