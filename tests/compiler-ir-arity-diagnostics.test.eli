(module tests.compiler-ir-arity-diagnostics
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/compiler-build.mjs" buildIndependentCompiler loadCompilerSources)
  (import "../tools/backends/compiler-bootstrap.mjs" openCompilerArtifact)
  (import "../tools/backends/compiler-session.mjs" encodeCompilerIR)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst filename "虚拟😀/arity.eli")
  (defconst source "; 😀中\r\n(defun token (x)\r\n  (host-identity-token x))\r\n(export token)")
  (defvar directory undefined) (defvar sources undefined) (defvar artifact undefined) (defvar compiler undefined) (defvar emitter undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-ir-arity-"))) sources (await (loadCompilerSources)))
    (setq artifact (await (buildIndependentCompiler (js-object :host "javascript" :sources sources :profile "full-runtime" :outputRoot directory :retainIR false :debug false))))
    (setq compiler (await (funcall load-module (get (pathToFileURL (resolve directory "bootstrap/compiler.mjs")) :href))))
    (setq emitter (await (funcall load-module (get (pathToFileURL (resolve directory "bootstrap/emitter.mjs")) :href))))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (defun intrinsics (program)
    (let ((pending (js-call (Array/from (get program :body)) :reverse)) (found (js-array)))
      (while (> (js-length pending) 0)
        (let* ((node (js-call pending :pop)) (children (get node :children)) (index (1- (if (nullish? children) 0 (get children :length)))))
          (when (and (= (get node :kind) "intrinsic") (= (get node :value) "host-identity-token")) (js-call found :push node))
          (while (>= index 0) (js-call pending :push (aref children index)) (setq index (1- index))))) found))
  (defun expectedSpan (text fragment at)
    (setq at (if (= at undefined) (js-call text :indexOf fragment) at)) (funcall assert (>= at 0))
    (let ((position (lambda (offset)
      (let* ((prefix (js-call text :slice 0 offset)) (lines (js-call prefix :split "\n")))
        (js-object :offset (get (Array/from prefix) :length) :line (get lines :length) :column (1+ (get (Array/from (js-call lines :at -1)) :length)))))))
      (let ((start (funcall position at)) (end (funcall position (+ at (get fragment :length)))))
        (js-object :filename filename :start (get start :offset) :end (get end :offset) :line (get start :line) :column (get start :column) :endLine (get end :line) :endColumn (get end :column)))))
  (defun captured (action)
    (let ((caught false) (result undefined))
      (try (funcall action) (catch error (setq caught t result error)))
      (funcall assert caught "the malformed original IR must actually fail") result))
  (defun malformed (original count)
    (let* ((program (globalThis/structuredClone original)) (node (aref (intrinsics program) 0)) (operand (aref (get node :children) 0)))
      (put node :children (if (= count 0) (js-array) (js-array operand (globalThis/structuredClone operand))))
      (js-object :program program :node node)))
  (defun childrenProxy (operand failure)
    (new globalThis.Proxy (js-array operand) (js-object :get (lambda (target key receiver)
      (if (= key "length") (throw failure) (Reflect/get target key receiver))))))
  (test "Given original Unicode IR When intrinsic arity is corrupted Then the real emitter preserves its Error and exact owning span" (lambda ()
    (let* ((original (js-call compiler :compile_ir_string source filename)) (before (encodeCompilerIR original)) (span (expectedSpan source "(host-identity-token x)")))
      (js-call assert :deepEqual (get (aref (intrinsics original) 0) :span) span)
      (js-call (js-array 0 2) :forEach (lambda (count)
        (let* ((broken (malformed original count)) (program (get broken :program)) (node (get broken :node)) (snapshot (encodeCompilerIR program)) (error (captured (lambda () (js-call compiler :emit_ir_string program)))))
          (funcall assert (funcall (js* "(a, b) => a instanceof b") error globalThis.Error)) (js-call assert :equal (get error :message) (str "host-identity-token expects 1 argument, got " count))
          (js-call assert :equal (get error :eliscriptIRSpan) (get node :span)) (js-call assert :deepEqual (get error :eliscriptIRSpan) span)
          (js-call assert :equal (Object/hasOwn error "eliscriptDiagnostic") false) (js-call assert :equal (encodeCompilerIR program) snapshot))))
      (js-call assert :equal (encodeCompilerIR original) before) (js-call assert :equal (funcall host-typeof (js-call compiler :emit_ir_string original)) "string"))))
  (test "Given an existing Error at the real arity boundary When metadata is attached Then identity message and existing diagnostics remain intact" (lambda ()
    (let* ((program (js-call compiler :compile_ir_string source filename)) (node (aref (intrinsics program) 0)) (operand (aref (get node :children) 0)))
      (js-call (js-array false t) :forEach (lambda (frozen)
        (let* ((diagnostic (js-object :format "eliscript-diagnostic" :version 1 :code "ORIGINAL" :phase "original" :message "original diagnostic"))
               (original (Object/assign (new globalThis.Error "original arity-boundary error") (js-object :eliscriptDiagnostic diagnostic))))
          (when frozen (Object/freeze original))
          (let ((corrupted (copyHostRecord node (js-object :children (childrenProxy operand original)))))
            (js-call assert :equal (captured (lambda () (js-call emitter :emit_expression corrupted))) original))
          (js-call assert :equal (get original :message) "original arity-boundary error") (js-call assert :equal (get original :eliscriptDiagnostic) diagnostic)
          (if frozen (js-call assert :equal (Object/hasOwn original "eliscriptIRSpan") false) (js-call assert :equal (get original :eliscriptIRSpan) (get node :span))))))
      (let* ((innerSpan (copyHostRecord (get node :span) (js-object :start (1+ (get (get node :span) :start)))))
             (inner (Object/assign (new globalThis.Error "inner arity failure") (js-object :eliscriptIRSpan innerSpan)))
             (nested (copyHostRecord node (js-object :children (childrenProxy operand inner)))))
        (js-call assert :equal (captured (lambda () (js-call emitter :emit_expression nested))) inner)
        (js-call assert :equal (get inner :eliscriptIRSpan) innerSpan "an outer boundary cannot replace an already precise inner span")))))
  (test "Given two nested corrupt intrinsics When real emission walks source order Then only the first exact node owns the failure" (lambda ()
    (let* ((nested "; 😀\n(defun token (x) (js-array (host-identity-token x) (host-identity-token x))) (export token)")
           (program (js-call compiler :compile_ir_string nested filename)) (nodes (intrinsics program)))
      (js-call assert :equal (get nodes :length) 2)
      (put (aref nodes 0) :children (js-array))
      (js-call (get (aref nodes 1) :children) :push (globalThis/structuredClone (aref (get (aref nodes 1) :children) 0)))
      (let ((error (captured (lambda () (js-call compiler :emit_ir_string program)))))
        (js-call assert :equal (get error :message) "host-identity-token expects 1 argument, got 0")
        (js-call assert :equal (get error :eliscriptIRSpan) (get (aref nodes 0) :span))
        (js-call assert :notDeepEqual (get error :eliscriptIRSpan) (get (aref nodes 1) :span))
        (js-call assert :deepEqual (get error :eliscriptIRSpan) (expectedSpan nested "(host-identity-token x)"))))))
  (test "Given initialized real compiler sessions When binary IR emission rejects arity Then exact structured locations survive and valid WASM still executes" (async ()
    (let ((session (await (openCompilerArtifact artifact))))
      (try
        (await (js-call session :request (js-object :operation "runtime" :source (get (get sources :runtime) :source) :filename (get (get sources :runtime) :filename) :literalSources (globalThis/structuredClone (get sources :literalSources)))))
        (let* ((original (js-call compiler :compile_ir_string source filename)) (span (expectedSpan source "(host-identity-token x)")) (originalWire (encodeCompilerIR original)) (targets (js-array "wasm" "native")) (targetIndex 0))
          (while (< targetIndex 2)
            (let ((target (aref targets targetIndex)) (counts (js-array 0 2)) (countIndex 0))
              (while (< countIndex 2)
                (let* ((count (aref counts countIndex)) (program (get (malformed original count) :program)) (message (str "host-identity-token expects 1 argument, got " count)))
                  (await (js-call assert :rejects (async () (js-call session :request (js-object :operation "emit-ir" :target target :ir (encodeCompilerIR program)
                    :nativeTarget (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos") :nativeFormat "library")))
                    (lambda (error)
                      (js-call assert :equal (get error :message) message)
                      (js-call assert :deepEqual (get error :eliscriptDiagnostic) (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-B0001" :severity "error" :phase "managed-backend" :message message
                        :location (js-object :file filename :start (js-object :offset (get span :start) :line (get span :line) :column (get span :column)) :end (js-object :offset (get span :end) :line (get span :endLine) :column (get span :endColumn))))) t))))
                (setq countIndex (1+ countIndex))))
            (setq targetIndex (1+ targetIndex)))
          (let* ((product (await (js-call session :request (js-object :operation "emit-ir" :target "wasm" :ir originalWire))))
                 (bytes (Uint8Array/from (get product :bytes))) (module (new globalThis.WebAssembly.Module bytes)) (runtime (instantiateManagedRuntime bytes)))
            (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports module) (js-array))
            (try
              (js-call runtime :auto 1)
              (let* ((object (js-call runtime :sourceObject (js-object))) (first (js-call runtime :invoke "token" (js-array object))))
                (try
                  (let ((second (js-call runtime :invoke "token" (js-array object))))
                    (try (js-call assert :equal (js-call runtime :readNumber first) (js-call runtime :readNumber second)) (funcall assert (> (js-call runtime :readNumber first) 0))
                      (finally (js-call runtime :release second))))
                  (finally (js-call runtime :release first) (js-call runtime :release object))))
              (finally (js-call runtime :closeModule) (js-call runtime :collect) (js-call assert :equal (js-call runtime :live) 0) (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0))))
          (js-call assert :equal (encodeCompilerIR original) originalWire))
        (finally (await (js-call session :close)))))) 120000)
)
