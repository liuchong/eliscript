(module tests.transient
  (import "../runtime/core/transient.mjs" :as transientRuntime)
  (import "bun:test" expect test)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/collection.mjs" assoc conj count sequenceView)
  (import "../runtime/core/map.mjs" EMPTY_MAP persistentHashMap)
  (import "../runtime/core/set.mjs" EMPTY_SET persistentHashSet)
  (import "../runtime/core/transient.mjs" IEditable ITransientCollection     )
  (import "../runtime/core/transducer.mjs" into)
  (import "../runtime/core/vector.mjs" EMPTY_VECTOR PersistentVector persistentVector)
  (import "../runtime/core/protocol.mjs" implementsProtocolOperation)
  (import "../runtime/core/value.mjs" hashValue)
  (import "../runtime/testing/map.mjs" inspectPersistentMap inspectTransientMap persistentMapMetrics resetPersistentMapMetrics resetTransientMapMetrics transientMapMetrics)
  (import "../runtime/testing/set.mjs" inspectTransientSet resetPersistentSetMetrics resetTransientSetMetrics transientSetMetrics)
  (import "../runtime/testing/vector.mjs" inspectTransientVector persistentVectorMetrics resetPersistentVectorMetrics resetTransientVectorMetrics transientVectorMetrics)
  (import "./helpers/portable-structure.mjs" nextRandom)
  (defconst HOST_FIXTURE (fileURLToPath (new globalThis.URL "./fixtures/transient-host.mjs" (js* "import.meta.url"))))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst generator-bridge (js* "(source) => (function* values() { yield* source; })()"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun match (actual expected) (js-call (expect actual) :toMatchObject expected))
  (defun raises (operation message) (js-call (expect operation) :toThrow message))
  (defun vectorRange (size)
    (let ((result EMPTY_VECTOR) (value 0)) (while (< value size) (setq result (js-call result :conj value) value (1+ value))) result))
  (defun mapRange (size)
    (let ((result EMPTY_MAP) (key 0)) (while (< key size) (setq result (js-call result :assoc key (* key 2)) key (1+ key))) result))
  (defun rangeSequence (size transform)
    (setq transform (if (= transform undefined) (lambda (value) value) transform))
    (sequenceView (lambda ()
      (let ((source (js-object)))
        (put source (get globalThis.Symbol :iterator) (lambda ()
          (let ((value 0))
            (js-object :next (lambda ()
              (if (>= value size) (js-object :done t :value undefined)
                (let ((item (funcall transform value))) (setq value (1+ value)) (js-object :done false :value item))))))))
        (funcall generator-bridge source))) size))
  (defun distinctRootKeys (size)
    (let ((keys (new globalThis.Map)) (candidate 0))
      (while (< (get keys :size) size)
        (let ((branch (bit-and (hashValue candidate) 31))) (unless (js-call keys :has branch) (js-call keys :set branch candidate)))
        (setq candidate (1+ candidate))) (Array/from (js-call keys :values))))
  (defasync runHost (command)
    (let* ((child (Bun/spawn (js-array command HOST_FIXTURE) (js-object :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (unless (= (aref result 0) 0) (let ((err (js-call (aref result 2) :trim))) (throw (new globalThis.Error (if (funcall host-truth err) err (str command " exited with " (aref result 0)))))))
      (JSON/parse (aref result 1))))
  (test "transient protocols expose only each collection's editable capabilities" (lambda ()
    (be (Object/isFrozen IEditable) t) (be (Object/isFrozen ITransientCollection) t) (raises (lambda () (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array (js-array)))))
    (let ((vector (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_VECTOR))) (map (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_MAP))) (set (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_SET))))
      (js-call (js-array EMPTY_VECTOR EMPTY_MAP EMPTY_SET) :forEach (lambda (value) (be (implementsProtocolOperation IEditable "transient" value) t)))
      (be (implementsProtocolOperation ITransientCollection "conj!" vector) t) (be (implementsProtocolOperation ITransientCollection "assoc!" vector) t)
      (be (implementsProtocolOperation ITransientCollection "dissoc!" vector) false)
      (be (implementsProtocolOperation ITransientCollection "assoc!" map) t) (be (implementsProtocolOperation ITransientCollection "dissoc!" map) t)
      (be (implementsProtocolOperation ITransientCollection "assoc!" set) false) (be (implementsProtocolOperation ITransientCollection "dissoc!" set) t)
      (raises (lambda () (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array vector 0)))) (raises (lambda () (Reflect/apply (get transientRuntime :assocBang) undefined (js-array set "value" t))))
      (raises (lambda () (Reflect/apply (get transientRuntime :assocBang) undefined (js-array map "safe" 1 "dangling"))) "assocBang requires a transient collection followed by one or more key/value pairs")
      (same (Array/from (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array map))) (js-array)) (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array vector)) (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array set)))))
  (test "transient vectors convert in O(1), own touched paths, and invalidate exactly" (lambda ()
    (let ((source (vectorRange 4096)))
      (resetPersistentVectorMetrics) (resetTransientVectorMetrics)
      (let ((editable (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array source))))
        (match (inspectTransientVector editable) (js-object :active t :count 4096 :ownedNodeCount 0 :sharesSourceRoot t :sharesSourceTail t))
        (match (persistentVectorMetrics) (js-object :nodeAllocations 0 :tailAllocations 0))
        (Reflect/apply (get transientRuntime :assocBang) undefined (js-array editable 1000 "first"))
        (let ((first (transientVectorMetrics)))
          (js-call (expect (get first :nodeClones)) :toBeGreaterThan 0)
          (be (get (inspectTransientVector editable) :ownedNodeCount) (get first :nodeClones))
          (Reflect/apply (get transientRuntime :assocBang) undefined (js-array editable 1000 "second")) (be (get (transientVectorMetrics) :nodeClones) (get first :nodeClones)))
        (Reflect/apply (get transientRuntime :conjBang) undefined (js-array editable "tail-a" "tail-b")) (be (get (transientVectorMetrics) :tailCopies) 1)
        (be (js-call source :nth 1000) 1000) (be (get source :count) 4096)
        (let ((result (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array editable))))
          (js-call (expect result) :toBeInstanceOf PersistentVector) (be (js-call result :nth 1000) "second")
          (be (js-call result :nth 4096) "tail-a") (be (js-call result :nth 4097) "tail-b")
          (be (get (transientVectorMetrics) :persistentCalls) 1))
        (js-call (js-array (lambda () (Reflect/apply (get transientRuntime :conjBang) undefined (js-array editable 1))) (lambda () (Reflect/apply (get transientRuntime :assocBang) undefined (js-array editable 0 1))) (lambda () (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array editable)))) :forEach
          (lambda (operation) (raises operation "transient vector is no longer editable")))
        (be (get (transientVectorMetrics) :invalidCalls) 3)
        (let ((unchanged (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array source)))) (be (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array unchanged)) source))))))
  (test "transient maps preserve HAMT collisions and dense/sparse transitions" (lambda ()
    (let ((source (mapRange 4096)))
      (resetPersistentMapMetrics) (resetTransientMapMetrics)
      (let ((editable (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array source))))
        (match (inspectTransientMap editable) (js-object :active t :count 4096 :ownedNodeCount 0 :sharesSourceRoot t))
        (be (get (persistentMapMetrics) :nodeAllocations) 0)
        (Reflect/apply (get transientRuntime :assocBang) undefined (js-array editable 1000 2000)) (be (get (transientMapMetrics) :nodeClones) 0)
        (Reflect/apply (get transientRuntime :assocBang) undefined (js-array editable 1000 "first"))
        (let ((clones (get (transientMapMetrics) :nodeClones)))
          (js-call (expect clones) :toBeGreaterThan 0) (Reflect/apply (get transientRuntime :assocBang) undefined (js-array editable 1000 "second")) (be (get (transientMapMetrics) :nodeClones) clones))
        (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array editable 2000 "missing")) (be (js-call source :get 1000) 2000) (be (js-call source :has 2000) t)
        (let ((result (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array editable)))) (be (js-call result :get 1000) "second") (be (js-call result :has 2000) false))))
    (let* ((left "key-50691") (right "key-194634"))
      (be (hashValue left) (hashValue right))
      (let ((collision (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array (persistentHashMap (js-array left 1) (js-array right 2))))))
        (Reflect/apply (get transientRuntime :assocBang) undefined (js-array collision right 3)) (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array collision left))
        (let ((collisionResult (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array collision)))) (be (get collisionResult :count) 1) (be (js-call collisionResult :get right) 3))))
    (let ((keys (distinctRootKeys 32)) (dense (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_MAP))))
      (js-call keys :forEach (lambda (key) (Reflect/apply (get transientRuntime :assocBang) undefined (js-array dense key key))))
      (js-call (js-call keys :slice 0 8) :forEach (lambda (key) (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array dense key))))
      (let ((sparse (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array dense)))) (be (get sparse :count) 24) (match (inspectPersistentMap sparse) (js-object :arrayNodes 0 :bitmapNodes 1))))
    (let ((emptied (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array (persistentHashMap (js-array "only" 1)))))) (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array emptied "only")) (be (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array emptied)) EMPTY_MAP))))
  (test "transient sets reuse the map owner path and retain source values" (lambda ()
    (let ((source (apply persistentHashSet (Array/from (js-object :length 2048) (lambda (_ value) value)))))
      (resetPersistentSetMetrics) (resetTransientSetMetrics)
      (let ((editable (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array source))))
        (match (inspectTransientSet editable) (js-object :active t :count 2048 :ownedNodeCount 0 :sharesSourceRoot t))
        (Reflect/apply (get transientRuntime :conjBang) undefined (js-array editable 2048 2049 1000)) (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array editable 0 "missing"))
        (be (js-call source :has 0) t) (be (js-call source :has 2048) false)
        (let ((result (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array editable)))) (be (get result :count) 2049) (be (js-call result :has 0) false) (be (js-call result :has 2049) t))
        (match (transientSetMetrics) (js-object :persistentCalls 1 :setPersistentCalls 1))
        (raises (lambda () (Reflect/apply (get transientRuntime :conjBang) undefined (js-array editable 1))) "transient hash set is no longer editable") (be (get (transientSetMetrics) :setInvalidCalls) 1))
      (let ((unchanged (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array source)))) (Reflect/apply (get transientRuntime :conjBang) undefined (js-array unchanged 1000)) (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array unchanged "missing")) (be (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array unchanged)) source))
      (let ((emptied (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array (persistentHashSet "only"))))) (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array emptied "only")) (be (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array emptied)) EMPTY_SET)))))
  (test "successive transient owners preserve every committed generation" (lambda ()
    (let ((random (js-object :value 615289335)) (map EMPTY_MAP) (set EMPTY_SET) (referenceMap (new globalThis.Map)) (referenceSet (new globalThis.Set)) (generations (js-array)) (batch 0))
      (while (< batch 20)
        (let ((editableMap (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array map))) (editableSet (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array set))) (operation 0))
          (while (< operation 1000)
            (let ((key (% (nextRandom random) 4096)))
              (if (= (bit-and (nextRandom random) 3) 0)
                (progn (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array editableMap key)) (Reflect/apply (get transientRuntime :dissocBang) undefined (js-array editableSet key)) (js-call referenceMap :delete key) (js-call referenceSet :delete key))
                (let ((value (uint32 (nextRandom random))))
                  (Reflect/apply (get transientRuntime :assocBang) undefined (js-array editableMap key value)) (Reflect/apply (get transientRuntime :conjBang) undefined (js-array editableSet key)) (js-call referenceMap :set key value) (js-call referenceSet :add key))))
            (setq operation (1+ operation)))
          (let ((previousMap map) (previousSet set))
            (setq map (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array editableMap)) set (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array editableSet)))
            (js-call generations :push (js-object :map previousMap :mapEntries (Array/from previousMap) :set previousSet :setValues (Array/from previousSet)))))
        (setq batch (1+ batch)))
      (same (new globalThis.Map map) referenceMap) (same (new globalThis.Set set) referenceSet)
      (js-call generations :forEach (lambda (generation)
        (same (Array/from (get generation :map)) (get generation :mapEntries))
        (same (Array/from (get generation :set)) (get generation :setValues)))))))
  (test "transients reject persistent APIs, serialization, and use after completion" (lambda ()
    (js-call (js-array (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_VECTOR)) (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_MAP)) (Reflect/apply (get transientRuntime :transient) transientRuntime (js-array EMPTY_SET))) :forEach (lambda (editable)
      (raises (lambda () (count editable))) (raises (lambda () (conj editable 1))) (raises (lambda () (assoc editable 0 1)))
      (raises (lambda () (JSON/stringify editable)) "cannot be serialized") (raises (lambda () (globalThis/structuredClone editable))) (Reflect/apply (get transientRuntime :persistentBang) undefined (js-array editable))))))
  (test "into selects transient builders and reduces persistent allocation volume" (lambda ()
    (let ((vectorSize 100000))
      (resetPersistentVectorMetrics) (vectorRange vectorSize)
      (let ((persistentVectorAllocations (get (persistentVectorMetrics) :nodeAllocations)))
        (resetPersistentVectorMetrics) (resetTransientVectorMetrics)
        (let ((vector (into EMPTY_VECTOR (rangeSequence vectorSize))))
          (be (get vector :count) vectorSize) (be (js-call vector :nth (1- vectorSize)) (1- vectorSize))
          (js-call (expect (get (persistentVectorMetrics) :nodeAllocations)) :toBeLessThan (/ persistentVectorAllocations 3))
          (be (get (transientVectorMetrics) :persistentCalls) 1))))
    (let ((associativeSize 50000))
      (resetPersistentMapMetrics) (mapRange associativeSize)
      (let ((persistentMapAllocations (get (persistentMapMetrics) :nodeAllocations)))
        (resetPersistentMapMetrics) (resetTransientMapMetrics)
        (let ((map (into EMPTY_MAP (rangeSequence associativeSize (lambda (key) (js-array key (* key 2)))))))
          (be (get map :count) associativeSize) (be (js-call map :get (1- associativeSize)) (* (1- associativeSize) 2))
          (js-call (expect (get (persistentMapMetrics) :nodeAllocations)) :toBeLessThan (/ persistentMapAllocations 3)) (be (get (transientMapMetrics) :persistentCalls) 1)))
      (resetPersistentSetMetrics)
      (let ((value 0) (set EMPTY_SET)) (while (< value associativeSize) (setq set (js-call set :conj value) value (1+ value))))
      (let ((persistentSetAllocations (get (persistentMapMetrics) :nodeAllocations)))
        (resetPersistentSetMetrics) (resetTransientSetMetrics)
        (let ((set (into EMPTY_SET (rangeSequence associativeSize))))
          (be (get set :count) associativeSize) (be (js-call set :has (1- associativeSize)) t)
          (js-call (expect (get (persistentMapMetrics) :nodeAllocations)) :toBeLessThan (/ persistentSetAllocations 3)) (be (get (transientSetMetrics) :setPersistentCalls) 1))))))
  (test "transient vector construction remains bounded at one million values" (lambda ()
    (resetPersistentVectorMetrics) (resetTransientVectorMetrics)
    (let* ((size 1000000) (vector (into EMPTY_VECTOR (rangeSequence size))))
      (be (get vector :count) size) (be (js-call vector :nth 0) 0) (be (js-call vector :nth (1- size)) (1- size))
      (js-call (expect (get (persistentVectorMetrics) :nodeAllocations)) :toBeLessThan 40000)
      (be (get (transientVectorMetrics) :nodeClones) 1) (be (get (transientVectorMetrics) :persistentCalls) 1))))
  (test "transient behavior agrees under Bun and Node" (async ()
    (let ((expected (js-object :vector (js-array 9 2 3 4) :map (js-array (js-array "left" 3) (js-array "right" 2)) :set (js-array "right"))))
      (same (await (runHost (get globalThis.process :execPath))) expected)
      (same (await (runHost (get (get globalThis.process :env) :NODE_BINARY "node"))) expected))))
)
