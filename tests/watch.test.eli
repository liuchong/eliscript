(module tests.watch
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdir mkdtemp realpath rm symlink writeFile)
  (import "node:os" tmpdir)
  (import "node:path" join resolve dirname)
  (import "node:url" fileURLToPath)
  (import "../bootstrap/host/watch.mjs" ProjectWatcher watchEventFormat watchEventVersion)
  (import "../bootstrap/host/watch-cli.mjs" parseArguments)

  (defconst projectDirectory (resolve (dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defconst bootstrapPath (resolve projectDirectory "bin/eliscript-bootstrap"))
  (defconst watchPath (resolve projectDirectory "bin/eliscript-watch"))
  (defconst node (or (get (get globalThis.process :env) :NODE) "node"))
  (defconst bun (get globalThis.process :execPath))

  (defvar directory undefined)
  (defvar compilerDirectory undefined)

  (defasync run (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((opts (or options (js-object)))
           (child (js-call globalThis.Bun :spawn command
                    (js-object
                      :cwd projectDirectory
                      :stdout "pipe"
                      :stderr "pipe"
                      :env (or (get opts :env) (get globalThis.process :env)))))
           (parts (await (Promise/all
                           (js-array (get child :exited)
                             (js-call (new globalThis.Response (get child :stdout)) :text)
                             (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref parts 0) :stdout (aref parts 1) :stderr (aref parts 2)))))

  (defun lineReader (stream)
    (let ((reader (js-call stream :getReader))
          (decoder (new globalThis.TextDecoder))
          (buffered ""))
      (async ()
        (while (not (js-call buffered :includes "\n"))
          (let* ((timer undefined)
                 (result (try
                           (await (Promise/race
                                    (js-array
                                      (js-call reader :read)
                                      (new globalThis.Promise
                                        (lambda (_ign reject)
                                          (setq timer (globalThis.setTimeout
                                                        (lambda () (reject (new globalThis.Error "watch event timed out")))
                                                        10000)))))))
                           (finally (globalThis.clearTimeout timer)))))
            (when (get result :done)
              (throw (new globalThis.Error "watch event stream closed")))
            (setq buffered (str buffered (js-call decoder :decode (get result :value) (js-object :stream t))))))
        (let* ((end (js-call buffered :indexOf "\n"))
               (line (js-call buffered :slice 0 end)))
          (setq buffered (js-call buffered :slice (1+ end)))
          line))))

  (defasync cliTranscript (runtime root signal)
    (let* ((env (Object/assign (js-object) (get globalThis.process :env)
                  (js-object
                    :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory
                    :ELISCRIPT_JS_RUNTIME runtime)))
           (child (js-call globalThis.Bun :spawn
                    (js-array watchPath "--root" root "--interval" "25" "--json")
                    (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe" :env env)))
           (stderrPromise (js-call (new globalThis.Response (get child :stderr)) :text))
           (ready undefined)
           (change undefined)
           (exitCode undefined)
           (stderr undefined))
      (try
        (let ((nextLine (lineReader (get child :stdout))))
          (setq ready (JSON/parse (await (nextLine))))
          (await (writeFile (resolve root "main.eli") "(print 2)\n"))
          (setq change (JSON/parse (await (nextLine)))))
        (finally
          (js-call child :kill signal)
          (let ((parts (await (Promise/all (js-array (get child :exited) stderrPromise)))))
            (setq exitCode (aref parts 0))
            (setq stderr (aref parts 1)))))
      (js-object :ready ready :change change :exitCode exitCode :stderr stderr)))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (join (tmpdir) "eliscript-watch-test-"))))
      (setq compilerDirectory (resolve directory "compiler"))
      (let ((built (await (run (js-array bootstrapPath)
                            (js-object :env (Object/assign (js-object) (get globalThis.process :env)
                                              (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDirectory)))))))
        (js-call (expect (get built :exitCode)) :toBe 0)
        (js-call (expect (get built :stderr)) :toBe "")))
    30000)

  (afterAll
    (async ()
      (await (rm directory (js-object :recursive t :force t)))))

  (test "project snapshots normalize source creation modification and deletion"
    (async ()
      (let ((root (resolve directory "snapshot")))
        (await (mkdir (resolve root "nested") (js-object :recursive t)))
        (await (writeFile (resolve root "main.eli") "(print 1)\n"))
        (await (writeFile (resolve root "ignored.txt") "one\n"))
        (await (symlink (resolve root "main.eli") (resolve root "linked.eli")))
        (await (symlink (resolve root "nested") (resolve root "linked-directory")))
        (let ((watcher (await (js-call ProjectWatcher :create (js-object :root root :interval 25)))))
          (try
            (let ((canonicalRoot (await (realpath root))))
              (js-call (expect (js-call watcher :ready)) :toMatchObject
                (js-object
                  :format watchEventFormat
                  :version watchEventVersion
                  :sequence 0
                  :event "ready"
                  :root canonicalRoot
                  :changes (js-array)))
              (await (writeFile (resolve root "main.eli") "(print 2)\n"))
              (await (writeFile (resolve root "nested/new.eli") "(print 3)\n"))
              (await (writeFile (resolve root "ignored.txt") "two\n"))
              (let ((changed (await (js-call watcher :scan))))
                (js-call (expect (get changed :sequence)) :toBe 1)
                (js-call (expect (get changed :changes)) :toEqual
                  (js-array
                    (js-object :file (resolve canonicalRoot "main.eli") :path "main.eli" :kind "modify")
                    (js-object :file (resolve canonicalRoot "nested/new.eli") :path "nested/new.eli" :kind "create"))))
              (await (rm (resolve root "main.eli")))
              (let ((removed (await (js-call watcher :scan))))
                (js-call (expect removed) :toMatchObject (js-object :sequence 2 :event "change"))
                (js-call (expect (get removed :changes)) :toEqual
                  (js-array (js-object :file (resolve canonicalRoot "main.eli") :path "main.eli" :kind "delete"))))
              (js-call (expect (await (js-call watcher :scan))) :toBeNull))
            (finally
              (await (js-call watcher :close))))))))

  (test "configured snapshots retain configuration identity outside the source root"
    (async ()
      (let* ((project (resolve directory "configured"))
             (root (resolve project "src"))
             (configuration (resolve project "eliscript.json")))
        (await (mkdir root (js-object :recursive t)))
        (await (writeFile (resolve root "main.eli") "(print 1)\n"))
        (await (writeFile configuration "{\"version\":1}\n"))
        (let ((watcher (await (js-call ProjectWatcher :create (js-object :root root :configuration configuration)))))
          (try
            (let ((canonicalConfiguration (await (realpath configuration))))
              (await (writeFile configuration "{\"version\":2}\n"))
              (let ((event (await (js-call watcher :scan))))
                (js-call (expect (get event :changes)) :toEqual
                  (js-array (js-object :file canonicalConfiguration :kind "modify")))))
            (finally
              (await (js-call watcher :close))))))))

  (test "watch sessions frame recoverable scan errors and reject use after close"
    (async ()
      (let ((root (resolve directory "error-event")))
        (await (mkdir root (js-object :recursive t)))
        (let* ((watcher (await (js-call ProjectWatcher :create (js-object :root root))))
               (event (js-call watcher :error (new globalThis.Error "scan failed"))))
          (js-call (expect event) :toMatchObject
            (js-object
              :format watchEventFormat
              :version watchEventVersion
              :sequence 1
              :event "error"
              :root (await (realpath root))
              :diagnostic (js-object
                            :code "ELI-W0002"
                            :phase "project-watch"
                            :message "scan failed")))
          (await (js-call watcher :close))
          (await (js-call (get (expect (js-call watcher :scan)) :rejects) :toThrow "watch session is closed"))))))

  (test "Node and Bun emit equivalent project watch events and stop cleanly"
    (async ()
      (let ((root (resolve directory "cross-host")))
        (await (mkdir root (js-object :recursive t)))
        (await (writeFile (resolve root "main.eli") "(print 1)\n"))
        (let ((nodeResult (await (cliTranscript node root "SIGINT"))))
          (await (writeFile (resolve root "main.eli") "(print 1)\n"))
          (let ((bunResult (await (cliTranscript bun root "SIGTERM"))))
            (js-call (expect bunResult) :toEqual nodeResult)
            (js-call (expect (get nodeResult :exitCode)) :toBe 0)
            (js-call (expect (get nodeResult :stderr)) :toBe "")
            (js-call (expect (get nodeResult :change)) :toMatchObject
              (js-object
                :sequence 1
                :event "change"
                :changes (js-array (js-object :path "main.eli" :kind "modify")))))))))

  (test "configured command resolves the project request and watches its file"
    (async ()
      (let* ((project (resolve directory "configured-cli"))
             (root (resolve project "src"))
             (configuration (resolve project "eliscript.json"))
             (config (lambda (cache)
                       (JSON/stringify
                         (js-object
                           :schemaVersion 1
                           :sourceRoot "src"
                           :entry "main.eli"
                           :outDir "build"
                           :portableEntries (js-array)
                           :cache cache)))))
        (await (mkdir root (js-object :recursive t)))
        (await (writeFile (resolve root "main.eli") "(print 1)\n"))
        (await (writeFile configuration (str (funcall config t) "\n")))
        (let* ((env (Object/assign (js-object) (get globalThis.process :env)
                      (js-object
                        :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory
                        :ELISCRIPT_JS_RUNTIME bun)))
               (child (js-call globalThis.Bun :spawn
                        (js-array watchPath "--config" configuration "--interval" "25" "--json")
                        (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe" :env env)))
               (stderrPromise (js-call (new globalThis.Response (get child :stderr)) :text))
               (exitCode undefined)
               (stderr undefined))
          (try
            (let* ((nextLine (lineReader (get child :stdout)))
                   (ready (JSON/parse (await (nextLine)))))
              (js-call (expect (get ready :root)) :toBe (await (realpath root)))
              (await (writeFile configuration (str (funcall config false) "\n")))
              (let ((change (JSON/parse (await (nextLine)))))
                (js-call (expect (get change :changes)) :toEqual
                  (js-array (js-object :file (await (realpath configuration)) :kind "modify")))))
            (finally
              (js-call child :kill "SIGTERM")
              (let ((parts (await (Promise/all (js-array (get child :exited) stderrPromise)))))
                (setq exitCode (aref parts 0))
                (setq stderr (aref parts 1)))))
          (js-call (expect exitCode) :toBe 0)
          (js-call (expect stderr) :toBe "")))))

  (test "watch command rejects ambiguous selectors and unsafe intervals"
    (async ()
      (js-call (expect (lambda () (parseArguments (js-array))))
        :toThrow "choose exactly one of --root or --config")
      (js-call (expect (lambda () (parseArguments (js-array "--root" "." "--config" "eliscript.json"))))
        :toThrow "choose exactly one of --root or --config")
      (let ((result (await (run (js-array watchPath "--root" projectDirectory "--interval" "1" "--json")
                             (js-object
                               :env (Object/assign (js-object) (get globalThis.process :env)
                                      (js-object
                                        :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory
                                        :ELISCRIPT_JS_RUNTIME bun)))))))
        (js-call (expect (get result :exitCode)) :toBe 1)
        (js-call (expect (get result :stderr)) :toContain "watch interval must be an integer between 25"))
      (let ((missing (await (run (js-array watchPath "--root" (resolve directory "missing-root") "--json")
                              (js-object
                                :env (Object/assign (js-object) (get globalThis.process :env)
                                       (js-object
                                         :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory
                                         :ELISCRIPT_JS_RUNTIME node)))))))
        (js-call (expect (get missing :exitCode)) :toBe 1)
        (js-call (expect (get missing :stderr)) :toContain "watch root does not exist")))))
