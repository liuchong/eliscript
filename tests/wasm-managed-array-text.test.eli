(module tests.wasm-managed-array-text.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/compiler/array-text-capsule.mjs" renderArrayTextImport)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defun is-instance (value ctor)
    (funcall (js* "(a, b) => a instanceof b") value ctor))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar memoryBackend undefined)
  (defvar runtime undefined)
  (defvar p undefined)
  (defvar js undefined)
  (defvar javascript undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-array-text-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq memoryBackend (await (dynamic-import (get (pathToFileURL (resolve (get b :directory) "memory.mjs")) :href))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq p (js-call (get b :compiler) :compile_ir_string (await (readFile "tests/fixtures/wasm-managed-array-text.eli" "utf8")) "array-text.eli"))
    (setq javascript (js-call (get b :compiler) :emit_ir_string p))
    (setq js (await (dynamic-import (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun artifact (&rest __host_default_arguments_1)
    (let* ((program (aref __host_default_arguments_1 0)) (rt (aref __host_default_arguments_1 1)))
    (let* ((prog (if (undefined? program) p program))
           (runtime-ir (if (undefined? rt) runtime rt))
           (before (JSON/stringify prog))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm prog runtime-ir))))
      (js-call assert :equal (JSON/stringify prog) before)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      bytes)))

  (defun box (a x owned)
    (let ((value (cond
                   ((= (value-type x) "number") (js-call a :number x))
                   ((= (value-type x) "string") (js-call a :string x))
                   (t x))))
      (when (and value (= (value-type value) "object"))
        (js-call owned :push value))
      value))

  (defun graph (a value owned &rest __host_default_arguments_2)
    (let* ((seen-map (aref __host_default_arguments_2 0)))
    (let ((seen (if (undefined? seen-map) (new globalThis.Map) seen-map)))
      (cond
        ((or (not value) (/= (value-type value) "object"))
         (box a value owned))
        ((js-call seen :has value)
         (js-call seen :get value))
        (t
         (let ((out (if (Array/isArray value)
                      (js-call a :sourceArray (js-array))
                      (js-call a :sourceObject (js-object)))))
           (js-call owned :push out)
           (js-call seen :set value out)
           (when (Array/isArray value)
             (js-call a :resize out (js-length value))
             (let ((i 0))
               (while (< i (js-length value))
                 (when (Object/hasOwn value i)
                   (js-call a :set out i (graph a (aref value i) owned seen)))
                 (setq i (1+ i)))))
           out))))))

  (defun read (a value)
    (if (and value (= (value-type value) "object"))
      (cond
        ((= (get value :kind) 4) (js-call a :readNumber value))
        ((= (get value :kind) 5) (js-call a :readString value))
        (t value))
      value))

  (defun release (a owned)
    (js-call owned :forEach (lambda (value) (js-call a :release value)))
    (js-call a :collect)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun finish (a &rest __host_default_arguments_3)
    (let* ((owned-list (aref __host_default_arguments_3 0)))
    (let ((owned (if (undefined? owned-list) (js-array) owned-list)))
      (release a owned)
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defasync compileCase (source)
    (let* ((prog (js-call (get b :compiler) :compile_ir_string (str "(defconst marker 1) " source) "array-conversion.eli"))
           (mod (await (dynamic-import (str "data:text/javascript;base64,"
                                            (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string prog)) :toString "base64"))))))
      (js-object :p prog :js mod)))

  (test "independent Node confirms ordinary join, the selected cycle error and conversion callback mutation" (async ()
    (let ((file (resolve directory "source.mjs")))
      (await (writeFile file javascript))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-array-text-node.mjs") "js" (get (pathToFileURL file) :href))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "arrays join exact primitives, holes, nested shared values and path cycles inside collecting WASM" (lambda ()
    (let* ((a (instantiateManagedRuntime (artifact)))
           (_ (js-call a :auto 1))
           (shared (js-array 1 nil "中😀\ud800"))
           (cycle (js-array 1))
           (mutual (js-array 2))
           (child (js-array mutual)))
      (js-call cycle :push cycle 3)
      (js-call mutual :push child)
      (js-call
        (js-array
          (js-array)
          (new globalThis.Array 4)
          (js-array nil undefined false t -0.0 0.5 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE "中😀\ud800")
          (js-array shared shared))
        :forEach
        (lambda (value)
          (js-call (js-array undefined nil false -0.0 0.5 "" "," "😀\ud800") :forEach
            (lambda (sep)
              (let* ((owned (js-array))
                     (input (graph a value owned))
                     (separator (box a sep owned))
                     (out (js-call a :invoke "join-value" (js-array input separator)))
                     (expected (js-call value :join sep)))
                (js-call assert :equal (js-call js :join_value value sep) expected)
                (js-call assert :equal (js-call a :readString out) expected)
                (js-call owned :push out)
                (release a owned))))))
      (js-call (js-array cycle mutual) :forEach
        (lambda (value)
          (let* ((owned (js-array))
                 (input (graph a value owned))
                 (separator (box a ":" owned)))
            (js-call assert :throws
              (lambda () (js-call js :join_value value ":"))
              (lambda (e) (and (is-instance e globalThis.TypeError)
                               (get e :eliscriptDiagnostic)
                               (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0009"))))
            (js-call assert :throws
              (lambda () (js-call a :invoke "join-value" (js-array input separator)))
              (lambda (e) (and (is-instance e globalThis.TypeError)
                               (get e :eliscriptDiagnostic)
                               (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0009"))))
            (release a owned))))
      (finish a))))

  (test "source conversion callbacks execute through WASM tables with exact return coercion and fallback order" (lambda ()
    (let ((a (instantiateManagedRuntime (artifact))))
      (js-call a :auto 1)
      (js-call (js-array undefined nil false -0.0 globalThis.NaN globalThis.Number.MIN_VALUE "中😀\ud800") :forEach
        (lambda (value)
          (js-call (js-array "custom-value" "fallback-value") :forEach
            (lambda (factory)
              (let* ((owned (js-array))
                     (trace (js-call a :sourceObject (js-object))))
                (js-call owned :push trace)
                (let* ((input (box a value owned))
                       (object (js-call a :invoke factory (js-array trace input))))
                  (js-call owned :push object)
                  (let ((values (js-call a :sourceArray (js-array object))))
                    (js-call owned :push values)
                    (let ((out (js-call a :invoke "default-value" (js-array values))))
                      (js-call owned :push out)
                      (js-call assert :equal
                        (js-call a :readString out)
                        (js-call (js-array (js-call js (js-call factory :replaceAll "-" "_") (js-object) value)) :join))
                      (js-call
                        (if (= factory "custom-value")
                          (js-array (js-array "calls" 1))
                          (js-array (js-array "to" 1) (js-array "value" 2)))
                        :forEach
                        (lambda (pair)
                          (let* ((key (aref pair 0))
                                 (expected (aref pair 1))
                                 (name (js-call a :string key))
                                 (got (js-call a :objectGet trace name)))
                            (js-call assert :equal (js-call a :readNumber got) expected)
                            (js-call owned :push name got))))
                      (release a owned)))))))))
      (finish a))))

  (test "join snapshots length before separator conversion but reads later elements after earlier conversion effects" (lambda ()
    (let* ((a (instantiateManagedRuntime (artifact)))
           (_ (js-call a :auto 1))
           (owned (js-array))
           (text (box a "x" owned))
           (values (js-call a :sourceArray (js-array text)))
           (trace (js-call a :sourceObject (js-object))))
      (js-call owned :push values trace)
      (let* ((separator (js-call a :invoke "growing-separator" (js-array values trace))))
        (js-call owned :push separator)
        (let ((out (js-call a :invoke "join-value" (js-array values separator))))
          (js-call owned :push out)
          (js-call assert :equal (js-call a :readString out) "x")
          (js-call assert :equal (js-call a :length values) 2)))
      (let ((live (js-call a :sourceArray (js-array nil text))))
        (js-call owned :push live)
        (let ((element (js-call a :invoke "live-element" (js-array live))))
          (js-call owned :push element)
          (js-call a :set live 0 element)
          (let* ((bar (box a "|" owned))
                 (joined (js-call a :invoke "join-value" (js-array live bar))))
            (js-call owned :push joined)
            (js-call assert :equal (js-call a :readString joined) "first|changed")
            (finish a owned)))))))

  (test "empty joins still convert separators and shrinking element callbacks leave captured-length separators in place" (lambda ()
    (let* ((a (instantiateManagedRuntime (artifact)))
           (_ (js-call a :auto 1))
           (owned (js-array))
           (values (js-call a :sourceArray (js-array)))
           (trace (js-call a :sourceObject (js-object))))
      (js-call owned :push values trace)
      (let ((separator (js-call a :invoke "growing-separator" (js-array values trace))))
        (js-call owned :push separator)
        (let ((out (js-call a :invoke "join-value" (js-array values separator))))
          (js-call owned :push out)
          (js-call assert :equal (js-call a :readString out) "")
          (js-call assert :equal (js-call a :length values) 1)))
      (let* ((k (js-call a :string "separator"))
             (calls (js-call a :objectGet trace k)))
        (js-call owned :push k calls)
        (js-call assert :equal (js-call a :readNumber calls) 1))
      (let* ((input (js-call a :sourceArray (js-array nil nil nil)))
             (element (js-call a :invoke "shrinking-element" (js-array input)))
             (bar (js-call a :string "|")))
        (js-call owned :push input element bar)
        (js-call a :set input 0 element)
        (let ((joined (js-call a :invoke "join-value" (js-array input bar)))
              (ref (js-array nil nil nil)))
          (js-call owned :push joined)
          (put ref 0 (js-call js :shrinking_element ref))
          (js-call assert :equal (js-call a :readString joined) (js-call js :join_value ref "|"))
          (js-call assert :equal (js-call a :readString joined) "first||")
          (js-call assert :equal (js-call a :length input) 0)
          (finish a owned))))))

  (test "array toString looks up join after ignored argument effects and preserves custom nonprimitive return identity" (lambda ()
    (let* ((a (instantiateManagedRuntime (artifact)))
           (_ (js-call a :auto 1))
           (input (js-call a :sourceArray (js-array)))
           (returned (js-call a :sourceObject (js-object)))
           (trace (js-call a :sourceObject (js-object)))
           (out (js-call a :invoke "text-order" (js-array input returned trace))))
      (assert (js-call a :keyEqual out returned))
      (let ((ref (js-object))
            (refTrace (js-object))
            (owned (js-array input returned trace out)))
        (js-call assert :equal (js-call js :text_order (js-array) ref refTrace) ref)
        (js-call assert :deepEqual refTrace (js-object :argument 1 :body 2))
        (js-call (Object/entries refTrace) :forEach
          (lambda (entry)
            (let* ((key (aref entry 0))
                   (expected (aref entry 1))
                   (k (js-call a :string key))
                   (v (js-call a :objectGet trace k)))
              (js-call owned :push k v)
              (js-call assert :equal (js-call a :readNumber v) expected))))
        (finish a owned)))))

  (test "reentrant joins reject cycles and clear owned active-array guards after errors" (lambda ()
    (let* ((a (instantiateManagedRuntime (artifact)))
           (_ (js-call a :auto 1))
           (values (js-call a :sourceArray (js-array nil)))
           (trace (js-call a :sourceObject (js-object)))
           (element (js-call a :invoke "reentrant-element" (js-array values trace))))
      (js-call a :set values 0 element)
      (js-call assert :throws
        (lambda () (js-call a :invoke "default-value" (js-array values)))
        (lambda (e) (and (is-instance e globalThis.TypeError)
                         (get e :eliscriptDiagnostic)
                         (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0009"))))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (js-call a :resize values 0)
      (let ((again (js-call a :invoke "default-value" (js-array values))))
        (js-call assert :equal (js-call a :readString again) "")
        (finish a (js-array values trace element again))))))

  (test "the internal memory32 source-call capability emits checked zero-import four-word indirect calls" (lambda ()
    (let* ((source "(module calls (import \"eliscript:memory32\" call-source) (defun target (heap function args count) (+ heap 7)) (defun invoke (heap) (call-source heap 0 0 0 0)) (export invoke))")
           (program (js-call (get b :compiler) :compile_ir_string source "source-call.eli"))
           (before (JSON/stringify program))
           (typed (js-call memoryBackend :lower_memory_program program)))
      (put typed :table (js-array (js-call (get typed :functions) :findIndex (lambda (x) (= (get x :name) "target")))))
      (let ((bytes (Uint8Array/from (js-call (get b :wasm) :emit_typed_memory_wasm typed))))
        (js-call assert :equal (JSON/stringify program) before)
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (js-call assert :equal (js-call (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports) :invoke 3) 10)))))

  (test "a source-call capability with an empty table emits independently and traps on a missing target" (lambda ()
    (let* ((program (js-call (get b :compiler) :compile_ir_string
                      "(module calls (import \"eliscript:memory32\" call-source) (defun invoke (heap) (call-source heap 0 0 0 0)) (export invoke))"
                      "empty-source-table.eli"))
           (before (JSON/stringify program))
           (typed (js-call memoryBackend :lower_memory_program program))
           (module (new globalThis.WebAssembly.Module (Uint8Array/from (js-call (get b :wasm) :emit_typed_memory_wasm typed)))))
      (js-call assert :equal (JSON/stringify program) before)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array))
      (let ((e (get (new globalThis.WebAssembly.Instance module) :exports)))
        (js-call assert :throws (lambda () (js-call e :invoke 3)) globalThis.WebAssembly.RuntimeError)))))

  (test "source-call signatures reject malformed declarations and wrong source arities without changing canonical input" (lambda ()
    (let ((source "(module calls (import \"eliscript:memory32\" call-source) (defun invoke (heap) (call-source heap 0 0 0 0)) (export invoke))"))
      (js-call
        (js-array nil (js-object) "4" (js-array -1) (js-array 1.5) (js-array globalThis.NaN)
                  (js-array globalThis.Infinity) (js-array 65536) (js-array "4"))
        :forEach
        (lambda (declaration)
          (let* ((prog (js-call (get b :compiler) :compile_ir_string source "source-signatures.eli"))
                 (typed (js-call memoryBackend :lower_memory_program prog)))
            (put typed :indirectArities declaration)
            (js-call assert :throws
              (lambda () (js-call (get b :wasm) :emit_typed_memory_wasm typed))
              (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-B0001")))))))
      (let* ((prog (js-call (get b :compiler) :compile_ir_string source "source-signatures.eli"))
             (typed (js-call memoryBackend :lower_memory_program prog)))
        (Reflect/deleteProperty typed "table")
        (js-call assert :throws
          (lambda () (js-call (get b :wasm) :emit_typed_memory_wasm typed))
          (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-B0001")))))
      (js-call (js-array "heap 0 0 0" "heap 0 0 0 0 0") :forEach
        (lambda (args)
          (let* ((ir (js-call (get b :compiler) :compile_ir_string
                       (js-call source :replace "(call-source heap 0 0 0 0)" (str "(call-source " args ")"))
                       "source-arity.eli"))
                 (before (JSON/stringify ir)))
            (js-call assert :throws
              (lambda () (js-call memoryBackend :lower_memory_program ir))
              (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-B0001"))))
            (js-call assert :equal (JSON/stringify ir) before)))))))

  (test "the shared source invoker preserves omitted optional and rest arguments exact numbers and checked argument counts" (async ()
    (let* ((c (await (compileCase "(defun fixed (x y) y) (defun optional (x &optional y) y) (defun rest-value (x &rest values) (js-length values)) (export fixed optional rest-value)")))
           (lowered (js-call (get b :managed) :lower_managed_program (get c :p) runtime))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (artifact (get c :p)))) :exports))
           (heap (js-call e "heap-new" 512 32768 1048576))
           (call (lambda (name &rest args)
                   (let ((out (uint32 (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)))))
                     (js-call assert :equal (js-call e "last-error") 0 name)
                     out))))
      (funcall call "heap-auto" 1)
      (funcall call "__eliscript_module_init")
      (let* ((negativeZero (funcall call "value-number" 0 2147483648))
             (_ (funcall call "heap-pin" negativeZero))
             (args (funcall call "value-refs" 7 3)))
        (funcall call "heap-pin" args)
        (funcall call "value-set" args 0 2)
        (funcall call "value-set" args 1 negativeZero)
        (funcall call "value-set" args 2 1)
        (let ((entries (get (get (get lowered :descriptor) :module) :exports)))
          (js-call (js-array "fixed" "optional" "rest-value") :forEach
            (lambda (name)
              (let* ((entry (js-call entries :find (lambda (x) (= (get x :name) name))))
                     (fn (funcall call "__eliscript_module_get" (get entry :kind) (get entry :index))))
                (funcall call "heap-pin" fn)
                (js-call (js-array 0 1 2 3) :forEach
                  (lambda (count)
                    (let ((packet (funcall call "value-refs" 7 count)))
                      (funcall call "heap-pin" packet)
                      (let ((i 0))
                        (while (< i count)
                          (funcall call "value-set" packet i (funcall call "value-get" args i))
                          (setq i (1+ i))))
                      (let ((out (funcall call "value-source-invoke" fn packet count))
                            (expected (Reflect/apply (get (get c :js) (js-call name :replaceAll "-" "_")) (get c :js)
                                        (js-call (js-array t -0.0 false) :slice 0 count))))
                        (cond
                          ((undefined? expected) (js-call assert :equal out 3))
                          ((= expected nil) (js-call assert :equal out 0))
                          (t (assert (Object/is (js-call (new globalThis.DataView (get (get e :memory) :buffer))
                                                  :getFloat64 (funcall call "value-data" out 4) t)
                                                expected))))
                        (js-call assert :equal (funcall call "frame-depth") 0)
                        (funcall call "heap-release" packet)))))
                (js-call assert :equal (js-call e "value-source-invoke" heap fn args 4) 0)
                (js-call assert :equal (js-call e "last-error") 3)
                (js-call assert :equal (funcall call "frame-depth") 0)
                (funcall call "heap-release" fn))))
          (js-call assert :equal (js-call e "value-source-invoke" heap 1 args 0) 0)
          (js-call assert :equal (js-call e "last-error") 3)
          (js-call assert :equal (funcall call "frame-depth") 0)
          (funcall call "heap-release" args)
          (funcall call "heap-release" negativeZero)
          (funcall call "__eliscript_module_close")
          (funcall call "heap-collect")
          (js-call assert :equal (funcall call "heap-live") 0))))))

  (test "array text methods capture the original method before argument mutations and evaluate ignored arguments exactly once" (async ()
    (let* ((c (await (compileCase "(defun factory () (js-object :join (lambda (separator ignored) separator))) (defun f (object trace) (js-call object :join (progn (put object :join (lambda (a b) 99)) (put trace :first 1) \"captured\") (put trace :second 2))) (defun g (object trace) (js-call object :join (put trace :visited 7))) (export factory f g)")))
           (a (instantiateManagedRuntime (artifact (get c :p)))))
      (js-call a :auto 1)
      (let* ((object (js-call a :invoke "factory"))
             (trace (js-call a :sourceObject (js-object)))
             (out (js-call a :invoke "f" (js-array object trace)))
             (reference (js-object))
             (owned (js-array object trace out)))
        (js-call assert :equal (js-call a :readString out) (js-call (get c :js) :f (js-call (get c :js) :factory) reference))
        (js-call assert :deepEqual reference (js-object :first 1 :second 2))
        (js-call (Object/entries reference) :forEach
          (lambda (entry)
            (let* ((k (js-call a :string (aref entry 0)))
                   (v (js-call a :objectGet trace k)))
              (js-call owned :push k v)
              (js-call assert :equal (js-call a :readNumber v) (aref entry 1)))))
        (js-call (js-array nil undefined t false 1 (js-object)) :forEach
          (lambda (input)
            (let* ((is-obj (and input (= (value-type input) "object")))
                   (x (if is-obj (js-call a :sourceObject (js-object)) (box a input owned)))
                   (seen (js-call a :sourceObject (js-object))))
              (when is-obj (js-call owned :push x))
              (js-call owned :push seen)
              (js-call assert :throws (lambda () (js-call (get c :js) :g input (js-object))) globalThis.TypeError)
              (js-call assert :throws
                (lambda () (js-call a :invoke "g" (js-array x seen)))
                (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
              (let* ((k (js-call a :string "visited"))
                     (v (js-call a :objectGet seen k)))
                (js-call owned :push k v)
                (js-call assert :equal (read a v) (if (or (= input nil) (undefined? input)) undefined 7))
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
        (finish a owned)))))

  (test "array toString observes own join methods and ordinary object conversion preserves defaults inheritance and fallback failures" (async ()
    (let* ((c (await (compileCase "(defun own-join (values value) (put values :join (lambda () value)) values) (defun set-join (values value) (put values :join value)) (defun custom-value (trace value) (js-object :toString (lambda () value))) (defun default-value (values) (js-call values :join)) (defun text-value (value) (js-call value :toString)) (defun text (x) (js-call x :toString)) (defun plain () (js-object)) (defun null-proto () (js-object :__proto__ nil)) (defun inherit (p) (js-object :__proto__ p)) (defun fallback (trace value) (js-object :toString 7 :valueOf (lambda () (put trace :called 1) value))) (defun failed (trace) (js-object :toString (lambda () (put trace :first 1) (js-object)) :valueOf (lambda () (put trace :second 2) (js-object)))) (export text plain null-proto inherit fallback failed own-join set-join custom-value default-value text-value)")))
           (a (instantiateManagedRuntime (artifact (get c :p))))
           (owned (js-array)))
      (js-call a :auto 1)
      (js-call (js-array undefined nil false -0.0 globalThis.NaN "中😀\ud800") :forEach
        (lambda (value)
          (let* ((trace (js-call a :sourceObject (js-object)))
                 (x (box a value owned))
                 (array (js-call a :sourceArray (js-array))))
            (js-call owned :push trace array)
            (let* ((custom (js-call a :invoke "own-join" (js-array array x)))
                   (out (js-call a :invoke "text-value" (js-array array))))
              (js-call owned :push custom out)
              (assert (Object/is (read a out) (js-call js :text_value (js-call js :own_join (js-array) value)))))
            (let* ((fallback (js-call a :invoke "fallback" (js-array trace x)))
                   (values (js-call a :sourceArray (js-array fallback)))
                   (joined (js-call a :invoke "default-value" (js-array values))))
              (js-call owned :push fallback values joined)
              (js-call assert :equal (js-call a :readString joined) (js-call (js-array (js-call (get c :js) :fallback (js-object) value)) :join))))))
      (let* ((parentTrace (js-call a :sourceObject (js-object)))
             (parentText (js-call a :string "inherited"))
             (plain (js-call a :invoke "plain"))
             (parent (js-call a :invoke "custom-value" (js-array parentTrace parentText)))
             (inherited (js-call a :invoke "inherit" (js-array parent)))
             (nullProto (js-call a :invoke "null-proto"))
             (trace (js-call a :sourceObject (js-object)))
             (failed (js-call a :invoke "failed" (js-array trace))))
        (js-call owned :push parentTrace parentText plain parent inherited nullProto trace failed)
        (js-call (js-array (js-array plain "[object Object]") (js-array inherited "inherited")) :forEach
          (lambda (pair)
            (let* ((array (js-call a :sourceArray (js-array (aref pair 0))))
                   (out (js-call a :invoke "default-value" (js-array array))))
              (js-call owned :push array out)
              (js-call assert :equal (js-call a :readString out) (aref pair 1)))))
        (js-call (js-array nullProto failed) :forEach
          (lambda (value)
            (let ((array (js-call a :sourceArray (js-array value))))
              (js-call owned :push array)
              (js-call assert :throws
                (lambda () (js-call a :invoke "default-value" (js-array array)))
                (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
        (js-call (js-array (js-array "first" 1) (js-array "second" 2)) :forEach
          (lambda (pair)
            (let* ((k (js-call a :string (aref pair 0)))
                   (v (js-call a :objectGet trace k)))
              (js-call owned :push k v)
              (js-call assert :equal (js-call a :readNumber v) (aref pair 1)))))
        (let ((array (js-call a :sourceArray (js-array))))
          (js-call owned :push array)
          (js-call assert :equal (js-call a :invoke "set-join" (js-array array false)) false)
          (let ((label (js-call a :invoke "text" (js-array array))))
            (js-call owned :push label)
            (js-call assert :equal (js-call a :readString label) "[object Array]")
            (finish a owned)))))))

  (test "deterministic acyclic sparse nested arrays and arbitrary binary64 values match unchanged JavaScript under collecting GC" (lambda ()
    (let* ((a (instantiateManagedRuntime (artifact)))
           (_ (js-call a :auto 1))
           (state 737597203)
           (next (lambda () (setq state (uint32 (+ (Math/imul state 1664525) 1013904223)))))
           (data (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (letfn ((gen-value (depth)
                (let ((kind (% (funcall next) (if (> depth 0) 8 7))))
                  (cond
                    ((< kind 4) (aref (js-array nil undefined false t) kind))
                    ((= kind 4)
                     (js-call data :setUint32 0 (funcall next))
                     (js-call data :setUint32 4 (funcall next))
                     (js-call data :getFloat64 0))
                    ((= kind 5)
                     (Reflect/apply globalThis.String.fromCharCode globalThis.String
                       (Array/from (js-object :length (% (funcall next) 13))
                         (lambda () (unsigned-bit-shift-right (funcall next) 16)))))
                    ((= kind 6)
                     (aref (js-array -0.0 globalThis.Infinity (- globalThis.Infinity) globalThis.NaN
                                     globalThis.Number.MIN_VALUE globalThis.Number.MAX_VALUE)
                           (% (funcall next) 6)))
                    (t (gen-array (- depth 1))))))
              (gen-array (depth)
                (let ((out (new globalThis.Array (% (funcall next) 17)))
                      (i 0))
                  (while (< i (js-length out))
                    (when (/= (% (funcall next) 4) 0)
                      (put out i (gen-value depth)))
                    (setq i (1+ i)))
                  out)))
        (let ((i 0))
          (while (< i 512)
            (let* ((input (gen-array 3))
                   (separator (gen-value 0))
                   (owned (js-array))
                   (values (graph a input owned))
                   (sep (box a separator owned))
                   (out (js-call a :invoke "join-value" (js-array values sep)))
                   (expected (js-call input :join separator)))
              (js-call owned :push out)
              (js-call assert :equal (js-call js :join_value input separator) expected)
              (js-call assert :equal (js-call a :readString out) expected)
              (release a owned))
            (setq i (1+ i)))))
      (finish a))))

  (test "join grows owned memory and reports capacity failures without losing the caller frame or active-array cleanup" (lambda ()
    (let* ((a (instantiateManagedRuntime (artifact) (js-object :maxSlots 4096 :initialBytes 131072 :maxBytes 4194304)))
           (_ (js-call a :auto 1))
           (long-str (js-call "中😀\ud800" :repeat 10000))
           (text (js-call a :string long-str))
           (values (js-call a :sourceArray (js-array text text text)))
           (before (get (js-call a :stats) :capacityBytes))
           (out (js-call a :invoke "default-value" (js-array values))))
      (js-call assert :equal (js-call a :readString out) (js-call (js-call (new globalThis.Array 3) :fill long-str) :join))
      (assert (> (get (js-call a :stats) :capacityBytes) before))
      (assert (> (get (js-call a :stats) :collections) 0))
      (finish a (js-array text values out)))
    (let* ((small (instantiateManagedRuntime (artifact) (js-object :maxSlots 256 :initialBytes 32768 :maxBytes 32768)))
           (_ (js-call small :auto 1))
           (held (js-call small :number -0.0))
           (s (js-call small :string (js-call "x" :repeat 10000)))
           (input (js-call small :sourceArray (js-call (new globalThis.Array 8) :fill s)))
           (outer (js-call small :frame 1)))
      (js-call small :frameSet outer 0 held)
      (js-call assert :throws
        (lambda () (js-call small :invoke "default-value" (js-array input)))
        (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0002"))))
      (js-call assert :equal (get (js-call small :stats) :frameDepth) 1)
      (assert (Object/is (js-call small :readNumber held) -0.0))
      (js-call small :resize input 0)
      (let ((again (js-call small :invoke "default-value" (js-array input))))
        (js-call assert :equal (js-call small :readString again) "")
        (js-call small :leaveFrame outer)
        (finish small (js-array held s input again))))))

  (test "real WASM output traps unwind join guards and preserve preceding conversion errors and outer roots" (async ()
    (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call source :indexOf "  (defun heap-join-result "))
           (end (js-call source :indexOf "  (defun " (+ start 3))))
      (assert (and (>= start 0) (> end start)))
      (let* ((rt (js-call (get b :compiler) :compile_ir_string
                   (str (js-call source :slice 0 start)
                        "  (defun heap-join-result (heap builder) (load-u32 4294967295))\n"
                        (js-call source :slice end))
                   "array-text-trap.eli"))
             (a (instantiateManagedRuntime (artifact p rt)))
             (_ (js-call a :auto 1))
             (trace (js-call a :sourceObject (js-object)))
             (returned (js-call a :sourceObject (js-object)))
             (bad (js-call a :invoke "fallback-value" (js-array trace returned)))
             (input (js-call a :sourceArray (js-array nil)))
             (held (js-call a :number -0.0))
             (outer (js-call a :frame 1)))
        (js-call a :frameSet outer 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "join-value" (js-array input bad)))
          (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (let ((i 0))
          (while (< i 2)
            (js-call assert :throws
              (lambda () (js-call a :invoke "default-value" (js-array input)))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (assert (Object/is (js-call a :readNumber held) -0.0))
            (setq i (1+ i))))
        (js-call a :leaveFrame outer)
        (finish a (js-array trace returned bad input held))))))

  (test "Node executes the identical zero-import array text WASM with closure conversions sparse arrays exact text and root cleanup" (async ()
    (let ((file (resolve directory "array-text.wasm")))
      (await (writeFile file (artifact)))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-array-text-node.mjs")
                               "wasm"
                               (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                               file)
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "native Emacs string joining rejects the selected self-containing list and vector instead of skipping an item" (lambda ()
    (let* ((form "(progn (require (quote subr-x)) (let ((items (vector \"apple\" nil \"banana\")) (listed (list \"apple\" nil \"banana\"))) (aset items 1 items) (setcar (cdr listed) listed) (dolist (value (list items listed)) (let ((caught nil)) (condition-case nil (string-join value \",\") (wrong-type-argument (setq caught t))) (unless caught (kill-emacs 1)))) (princ \"native cycle rejection verified\")))")
           (emacs-bin (or (get (get globalThis.process :env) :EMACS) "emacs"))
           (child (spawnSync emacs-bin (js-array "--batch" "-Q" "--eval" form) (js-object :encoding "utf8" :timeout 30000))))
      (js-call assert :equal (get child :status) 0 (get child :stderr))
      (js-call assert :match (get child :stdout) (new globalThis.RegExp "native cycle rejection verified")))))

  (test "JS array text modules share cycle guards and preserve primitive hooks getters and cleanup without prototype changes" (async ()
    (let* ((c (await (compileCase "(defun second (values) (js-call values :join)) (export second)")))
           (nativeJoin globalThis.Array.prototype.join)
           (nativeText globalThis.Array.prototype.toString)
           (values (js-array nil))
           (entered 0))
      (put values 0 (js-object :toString (lambda () (setq entered (1+ entered)) (js-call (get c :js) :second values))))
      (js-call assert :throws
        (lambda () (js-call js :default_value values))
        (lambda (e) (and (is-instance e globalThis.TypeError)
                         (get e :eliscriptDiagnostic)
                         (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0009"))))
      (js-call assert :equal entered 1)
      (put values :length 0)
      (js-call assert :equal (js-call js :default_value values) "")
      (js-call assert :equal (js-call (get c :js) :second values) "")
      (js-call assert :equal globalThis.Array.prototype.join nativeJoin)
      (js-call assert :equal globalThis.Array.prototype.toString nativeText)
      (let* ((source "(defun f (values key separator trace) (js-call values key separator (put trace :argument 1))) (export f)")
             (prog (js-call (get b :compiler) :compile_ir_string source "computed-join.eli"))
             (mod (await (dynamic-import (str "data:text/javascript;base64,"
                                              (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string prog)) :toString "base64")))))
             (observe (lambda (operation)
                        (let* ((trace (js-array))
                               (base (js-array nil "old"))
                               (value (new globalThis.Proxy base
                                        (js-object :get (lambda (target key receiver)
                                                          (js-call trace :push (funcall globalThis.String key))
                                                          (Reflect/get target key receiver)))))
                               (elem0 (js-object))
                               (separator (js-object)))
                          (put elem0 globalThis.Symbol.toPrimitive
                            (lambda (hint) (js-call trace :push hint) (put base 1 "changed") "first"))
                          (put base 0 elem0)
                          (put separator globalThis.Symbol.toPrimitive
                            (lambda (hint) (js-call trace :push (str "separator:" hint)) "|"))
                          (js-object :value (funcall operation value separator) :trace trace)))))
        (js-call assert :deepEqual
          (funcall observe (lambda (value sep) (js-call js :join_value value sep)))
          (funcall observe (lambda (value sep) (js-call value :join sep))))
        (let ((trace (js-object))
              (array (js-array "a" "b")))
          (js-call assert :equal (js-call mod :f array "join" "|" trace) "a|b")
          (js-call assert :deepEqual trace (js-object :argument 1)))
        (js-call (js-array (funcall (js* "() => [1n, -1n, null]")) (js-array (globalThis.Symbol "x"))) :forEach
          (lambda (value)
            (if (= (value-type (aref value 0)) "symbol")
              (js-call assert :throws (lambda () (js-call js :default_value value)) globalThis.TypeError)
              (js-call assert :equal (js-call js :default_value value) (js-call nativeJoin :call value)))))))))

  (test "the emitted shared capsule matches its maintained source and literal method keys retain public Seed parity" (async ()
    (assert (js-call javascript :includes (await (renderArrayTextImport))))
    (let* ((source "(defun f (object key) (js-call object :join) (js-call object \"toString\") (js-call object false) (js-call object t) (js-call object nil) (js-call object undefined) (js-call object 7) (js-call object key)) (export f)")
           (input (resolve directory "literal-keys.eli"))
           (output (resolve directory "literal-keys.mjs")))
      (await (writeFile input source))
      (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get seed :status) 0 (get seed :stderr))
        (js-call assert :equal (await (readFile output "utf8")) (js-call (get b :compiler) :compile_string source input)))))))
