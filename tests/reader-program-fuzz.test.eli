(module tests.reader-program-fuzz.test
  (import "bun:test" expect test)
  (import "node:process" :default process)
  (import "node:path" resolve)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:url" pathToFileURL)
  (import "../tools/fuzz/reader-program-fuzz.mjs" fuzzCases)
  (defconst root (resolve (js* "import.meta.dir") ".."))
  (defconst fuzzPath (resolve root "tools/fuzz/reader-program-fuzz.mjs"))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync runAcceptanceFuzz ()
    (let* ((child (Bun/spawn (js-array (get process :execPath) fuzzPath "--cases" "100000" "--seed" "0x454c4931") (js-object :cwd root :stdout "pipe" :stderr "pipe")))
           (timedOut false) (timer (globalThis.setTimeout (lambda () (setq timedOut t) (js-call child :kill)) 300000))
           (items (await (js-call (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))
             :finally (lambda () (globalThis.clearTimeout timer)))))
           (exitCode (aref items 0)) (stdout (aref items 1)) (stderr (aref items 2)))
      (when timedOut (throw (new globalThis.Error "reader/program fuzz exceeded 300000 ms")))
      (unless (= exitCode 0)
        (let ((err (js-call stderr :trim)) (out (js-call stdout :trim))) (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str "fuzz exited with " exitCode)))))))
      (JSON/parse stdout)))
  (defasync runFuzzProofCommand (command &rest __host_forwarded_arguments_1)
    (let* ((environment (aref __host_forwarded_arguments_1 0)))
    (let* ((child (Bun/spawn command (js-object :cwd root :env (Object/assign (js-object) (get process :env) environment) :stdout "pipe" :stderr "pipe")))
           (expired false) (forceKill undefined)
           (timer (globalThis.setTimeout (lambda () (setq expired t) (js-call child :kill "SIGTERM") (setq forceKill (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 1000))) 30000))
           (items (await (js-call (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))
             :finally (lambda () (globalThis.clearTimeout timer) (globalThis.clearTimeout forceKill)))))
           (status (aref items 0)) (stdout (aref items 1)) (stderr (aref items 2)))
      (when expired (throw (new globalThis.Error "fuzz semantic proof command exceeded 30000 ms")))
      (unless (= status 0)
        (let ((err (js-call stderr :trim)) (out (js-call stdout :trim))) (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str "fuzz proof command exited with " status)))))))
      stdout)))
  (defun selectProofCases ()
    (let* ((selected (new globalThis.Map)) (cases (fuzzCases 100000 1162627377))
           (iterator (Reflect/apply (get cases (get globalThis.Symbol :iterator)) cases (js-array))) (done false))
      (try
        (while (and (not done) (< (get selected :size) 2))
          (let ((step (js-call iterator :next)))
            (if (get step :done) (setq done t)
              (let ((item (get step :value)))
                (when (= (get item :kind) "program")
                  (let* ((scalar (js-call (new globalThis.RegExp "^\\(module fuzz\\.case-([a-z0-9]+)\\n  \\(defconst base-\\1 ([0-9]+)\\)\\n  \\(defun compute-\\1 \\(value\\)\\n    \\(\\+ value base-\\1\\)\\)\\n  \\(export compute-\\1\\)\\)$") :exec (get item :source)))
                         (vector (js-call (new globalThis.RegExp "^\\(module fuzz\\.case-([a-z0-9]+)\\n  \\(defconst base-\\1 \\[([0-9]+) :ok\\]\\)\\n  \\(defun compute-\\1 \\(value\\) value\\)\\n  \\(export compute-\\1\\)\\)$") :exec (get item :source)))
                         (kind (if scalar "scalar" (if vector "vector" nil))) (matched (if (nullish? scalar) vector scalar)))
                    (when (and (not (= kind nil)) (not (js-call selected :has kind)))
                      (js-call selected :set kind (Object/assign (js-object) item (js-object :name (str "fuzz-proof-" kind) :shape kind :suffix (aref matched 1)
                        :value (funcall globalThis.Number (aref matched 2)) :exportName (str "compute_" (aref matched 1))))))))))))
        (finally (when (and (not done) (not (nullish? (get iterator :return)))) (js-call iterator :return))))
      selected))
  (defun proofMutations (scalar selected)
    (let* ((constant (str "base-" (get scalar :suffix))) (suffix (get scalar :suffix))
           (tdz (Object/assign (js-object) scalar (js-object :name "fuzz-proof-tdz" :filename "fuzz-proof-tdz.eli" :shape "tdz")))
           (constantWrite (Object/assign (js-object) scalar (js-object :name "fuzz-proof-const-write" :filename "fuzz-proof-const-write.eli" :shape "const-write")))
           (mutableValue (Object/assign (js-object) scalar (js-object :name "fuzz-proof-mutable-value" :filename "fuzz-proof-mutable-value.eli" :shape "mutable-value"))))
      (put tdz :source (js-call (get scalar :source) :replace (str "  (defconst " constant) (str "  (defconst before " constant ")\n  (defconst " constant)))
      (let ((source (get scalar :source)))
        (setq source (js-call source :replace (str "(+ value " constant ")") (str "(setq " constant " value)")))
        (setq source (js-call source :replace (str "  (export compute-" suffix "))") (str "  (defun current () " constant ")\n  (export compute-" suffix " current))")))
        (put constantWrite :source source))
      (let ((source (get scalar :source)))
        (setq source (js-call source :replace (str "(defconst " constant " " (get scalar :value) ")") "(defvar value -0.0)"))
        (setq source (js-call source :replace (str "(value)\n    (+ value " constant "))") "(next)\n    (setq value next))"))
        (setq source (js-call source :replace (str "  (export compute-" suffix "))") (str "  (defun current () value)\n  (export value compute-" suffix " current))")))
        (put mutableValue :source source))
      (js-object :constantWrite constantWrite :cases (js-call (Array/from (js-call selected :values)) :concat (js-array tdz mutableValue)))))
  (defasync proveFuzzProgramEmission (&rest __host_default_arguments_1)
    (let* ((selectedCompilerDirectory (aref __host_default_arguments_1 0)))
    (let ((selected (selectProofCases)))
      (same (js-call (Array/from (js-call selected :keys)) :sort) (js-array "scalar" "vector"))
      (let* ((scalar (js-call selected :get "scalar")) (constant (str "base-" (get scalar :suffix))) (mutations (proofMutations scalar selected))
             (constantWrite (get mutations :constantWrite)) (cases (get mutations :cases))
             (assignmentOffset (+ (js-call (get constantWrite :source) :indexOf (str "(setq " constant " value)")) (get "(setq " :length))))
        (js-call (expect assignmentOffset) :toBeGreaterThanOrEqual (get "(setq " :length))
        (let* ((preceding (js-call (get constantWrite :source) :slice 0 assignmentOffset)) (assignmentLine (get (js-call preceding :split "\n") :length))
               (assignmentColumn (- assignmentOffset (js-call preceding :lastIndexOf "\n"))) (assignmentMessage (str "cannot assign to immutable binding: " constant))
               (assignmentDiagnostic (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-A0001" :severity "error" :phase "analysis" :message assignmentMessage
                 :location (js-object :file (get constantWrite :filename) :start (js-object :offset assignmentOffset :line assignmentLine :column assignmentColumn)
                   :end (js-object :offset (+ assignmentOffset (get constant :length)) :line assignmentLine :column (+ assignmentColumn (get constant :length))))))
               (renderedAssignmentMessage (str (get constantWrite :filename) ":" assignmentLine ":" assignmentColumn ": " assignmentMessage))
               (directory (await (mkdtemp (resolve root ".eliscript-fuzz-semantic-proof-")))))
          (try
            (when (and (not (= selectedCompilerDirectory undefined)) (or (not (= (funcall hostTypeof selectedCompilerDirectory) "string")) (= (get selectedCompilerDirectory :length) 0)))
              (throw (new globalThis.TypeError "fuzz proof requires an explicit selected compiler module directory")))
            (let* ((compilerDirectory (if (nullish? selectedCompilerDirectory) (resolve directory "compiler") selectedCompilerDirectory)))
              (when (= selectedCompilerDirectory undefined)
                (await (runFuzzProofCommand (js-array (resolve root "bin/eliscript-bootstrap")) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDirectory))))
              (let* ((compiler (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve compilerDirectory "compiler.mjs")) :href))))
                     (fixture (resolve directory "emitter-proof.json")) (emacs (get (get process :env) :EMACS)))
                (await (writeFile fixture (JSON/stringify (js-object :valid (js-call cases :map (lambda (item) (js-object :name (get item :name) :source (get item :source) :filename (get item :filename))))
                  :invalid (js-array (js-object :name (get constantWrite :name) :source (get constantWrite :source) :filename (get constantWrite :filename)))))))
                (let* ((seeded (JSON/parse (await (runFuzzProofCommand (js-array (if (nullish? emacs) "emacs" emacs) "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script" (resolve root "tests/bootstrap-emitter-oracle.el")) (js-object :ELISCRIPT_EMITTER_FIXTURE fixture)))))
                       (analyzed (JSON/parse (await (runFuzzProofCommand (js-array (if (nullish? emacs) "emacs" emacs) "--batch" "-Q" "-L" "compiler" "-L" "tests" "--script" (resolve root "tests/bootstrap-analyzer-oracle.el")) (js-object :ELISCRIPT_ANALYZER_FIXTURE fixture)))))
                       (observations (js-array)) (index 0))
                  (same (js-call seeded :map (lambda (item) (get item :name))) (js-call cases :map (lambda (item) (get item :name))))
                  (same (js-call analyzed :map (lambda (item) (get item :name))) (js-call (js-call cases :concat (js-array constantWrite)) :map (lambda (item) (get item :name))))
                  (same (js-call (js-call analyzed :slice 0 (get cases :length)) :map (lambda (item) (get item :status))) (js-call cases :map (lambda () "ok")))
                  (same (js-call analyzed :at -1) (js-object :name (get constantWrite :name) :status "error" :message renderedAssignmentMessage :diagnostic assignmentDiagnostic))
                  (js-call (js-array (lambda () (js-call compiler :compile_string (get constantWrite :source) (get constantWrite :filename)))
                    (lambda () (js-call compiler :compile_string_with_source_map (get constantWrite :source) (get constantWrite :filename) "fixture.mjs" (get constantWrite :filename)))) :forEach (lambda (compile)
                      (let ((rejected false))
                        (try (funcall compile) (catch error (setq rejected t) (be (get error :message) renderedAssignmentMessage) (same (get error :eliscriptDiagnostic) assignmentDiagnostic)))
                        (be rejected t))))
                  (while (< index (get cases :length))
                    (let* ((item (aref cases index)) (oracle (aref seeded index)) (javascript (progn (be (get oracle :status) "ok") (js-call compiler :compile_string (get item :source) (get item :filename))))
                           (mapped (js-call compiler :compile_string_with_source_map (get item :source) (get item :filename) "fixture.mjs" (get item :filename)))
                           (seedPath (resolve directory (str (get item :name) "-seed.mjs"))) (selfPath (resolve directory (str (get item :name) "-self.mjs"))))
                      (be javascript (get oracle :javascript)) (be (get mapped :javascript) (get oracle :javascript)) (same (JSON/parse (get mapped :sourceMap)) (get oracle :sourceMap))
                      (js-call (expect javascript) :toContain "function __eliscript_tdz_write_0(__eliscript_tdz_value_0)")
                      (js-call (get (expect javascript) :not) :toContain "function __eliscript_tdz_write_0(value)")
                      (when (= (get item :shape) "mutable-value") (js-call (expect javascript) :toContain "return (value = __eliscript_tdz_value_0);"))
                      (await (writeFile seedPath (get oracle :javascript))) (await (writeFile selfPath javascript))
                      (js-call observations :push (js-object :shape (get item :shape) :value (get item :value) :exportName (get item :exportName) :artifacts (js-array (get (pathToFileURL seedPath) :href) (get (pathToFileURL selfPath) :href)))))
                    (setq index (1+ index)))
                  (let ((observationsPath (resolve directory "execute-proof.json")) (node (get (get process :env) :NODE)))
                    (await (writeFile observationsPath (JSON/stringify observations)))
                    (await (runFuzzProofCommand (js-array (if (nullish? node) "node" node) (resolve root "tests/fixtures/reader-fuzz-proof-host.mjs") observationsPath)))))))
            (finally (await (rm directory (js-object :recursive t :force t))))))))))
  (test "100000 deterministic reader and program mutations preserve every invariant" (async ()
    (await (proveFuzzProgramEmission))
    (let ((report (await (runAcceptanceFuzz))))
      (js-call (expect report) :toMatchObject (js-object "schemaVersion" 1 "format" "eliscript-reader-program-fuzz" "version" 1 "verified" t "seed" "0x454c4931" "inputs" 100000 "readerInputs" 50000 "programInputs" 50000 "maximumSourceCharacters" 4096 "maximumCorpusBytes" 67108864 "corpusReplayed" t "reader" (js-object "accepted" 46889 "rejected" 53111 "deterministicResults" 100000 "structuredDiagnostics" 53111 "spanValidated" 46889 "roundTrips" 46889 "seedAgreements" 100000 "resultDigest" "31961b6ffb8ce276a67db1b7cce2b723cf512b6c1518f8023985606535c69e7e") "compiler" (js-object "accepted" 10171 "rejected" 39829 "structuredDiagnostics" 39829 "resultDigest" "b31c1f4546e42b3501fcc8a97403b171a6d3bb0ba8976bbe8bf305a235db7024") "corpusDigest" "4b49f0e21a825e41344fc29387b5298462d17cd1140b2f1f06076a18fe1f8cab"))
      (js-call (expect (get report :corpusBytes)) :toBeGreaterThan 1000000) (js-call (expect (get report :corpusBytes)) :toBeLessThanOrEqual (get report :maximumCorpusBytes))
      (be (+ (get (get report :reader) :accepted) (get (get report :reader) :rejected)) 100000)
      (js-call (expect (get (get report :reader) :accepted)) :toBeGreaterThan 10000) (js-call (expect (get (get report :reader) :rejected)) :toBeGreaterThan 10000)
      (be (get (get report :reader) :spanValidated) (get (get report :reader) :accepted)) (be (get (get report :reader) :roundTrips) (get (get report :reader) :accepted))
      (be (get (get report :reader) :structuredDiagnostics) (get (get report :reader) :rejected))
      (be (+ (get (get report :compiler) :accepted) (get (get report :compiler) :rejected)) 50000)
      (js-call (expect (get (get report :compiler) :accepted)) :toBeGreaterThan 5000) (js-call (expect (get (get report :compiler) :rejected)) :toBeGreaterThan 20000)
      (be (get (get report :compiler) :structuredDiagnostics) (get (get report :compiler) :rejected))
      (js-call (js-array (get report :corpusDigest) (get (get report :reader) :resultDigest) (get (get report :compiler) :resultDigest)) :forEach
        (lambda (digest) (js-call (expect digest) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u")))))) 320000)
)
