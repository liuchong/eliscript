(module tests.compiler-portable-errors
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "./helpers/compiler-error-contract.mjs" helpers original capture)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst error-constructor-bridge (js* "(observe, value) => function(...args) { observe(new.target, args); return value; }"))
  (defvar directory undefined) (defvar backend undefined) (defvar runtime undefined)
  (defconst programs (js-array))
  (defun flatten (nodes)
    (js-call nodes :flatMap (lambda (node) (if (= (get node :kind) "module-declaration") (flatten (get node :children)) (js-array node)))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-portable-errors-"))) backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (let ((index 0))
      (while (< index (js-length helpers))
        (let* ((pair (aref helpers index)) (file (aref pair 0)) (name (aref pair 1))
               (ir (js-call (get backend :compiler) :compile_ir_string (await (readFile (str "bootstrap/compiler/" file ".eli") "utf8")) (str file ".eli")))
               (helper (js-call (flatten (get ir :body)) :find (lambda (node) (and (= (get node :kind) "variable-declaration") (= (get node :value) name))))))
          (funcall assert helper file)
          (let* ((support (flatten (get (js-call (get backend :compiler) :compile_ir_string
                    (str "(defconst " name " nil) " "(defun invoke-error (&rest args) (apply " name " args)) " "(export " name " invoke-error)") "error-adapter.eli") :body)))
                 (program (copyHostRecord ir (js-object :body (js-call (js-array (globalThis/structuredClone helper)) :concat (js-call support :filter (lambda (node) (not (= (get node :value) name))))))))
                 (javascript (js-call (get backend :compiler) :emit_ir_string program))
                 (reference (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
            (await (writeFile (resolve directory (str file ".mjs")) javascript))
            (js-call programs :push (js-object :file file :name name :program program :javascript javascript :reference reference))))
        (setq index (1+ index))))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (test "compiler error helpers retain the original arrow function identity and Error message contract" (lambda ()
    (js-call programs :forEach (lambda (item)
      (let ((fn (get (get item :reference) (js-call (get item :name) :replaceAll "-" "_"))))
        (js-call assert :equal (get fn :length) 1) (js-call assert :equal (Object/hasOwn fn "prototype") false)
        (js-call assert :throws (lambda () (Reflect/construct globalThis.String (js-array) fn)) globalThis.TypeError)
        (js-call (js-array (js-array) (js-array undefined) (js-array nil) (js-array false) (js-array 0) (js-array (js* "-0"))
          (js-array globalThis.NaN) (js-array globalThis.Infinity) (js-array "") (js-array "中😀\ud800") (js-array (js* "1n")) (js-array (funcall globalThis.Symbol "x")) (js-array "message" "ignored")) :forEach
          (lambda (args) (let ((expected (capture original args)) (actual (capture fn args)))
            (js-call assert :equal (Object/getPrototypeOf actual) (Object/getPrototypeOf expected))
            (js-call assert :equal (get actual :message) (get expected :message))
            (js-call assert :equal (Object/hasOwn actual "message") (Object/hasOwn expected "message"))
            (js-call assert :deepEqual (Object/keys actual) (Object/keys expected))
            (js-call assert :deepEqual (Object/getOwnPropertyDescriptor actual "message") (Object/getOwnPropertyDescriptor expected "message"))))))))))
  (test "compiler error helpers preserve string-hint conversion, abrupt completion, and live constructor lookup" (lambda ()
    (js-call programs :forEach (lambda (item)
      (let ((fn (get (get item :reference) (js-call (get item :name) :replaceAll "-" "_"))))
        (js-call (js-array "primitive" "ordinary" "throws" "invalid") :forEach (lambda (mode)
          (let ((observe (lambda (operation)
            (let* ((events (js-array)) (sentinel (js-object))
                   (value (if (= mode "ordinary")
                     (js-object :toString (lambda () (js-call events :push "toString") "text") :valueOf (lambda () (js-call events :push "valueOf") 7)) (js-object))))
              (unless (= mode "ordinary")
                (put value (get globalThis.Symbol :toPrimitive) (lambda (hint)
                  (js-call events :push hint) (when (= mode "throws") (throw sentinel)) (if (= mode "invalid") (js-object) "text"))))
              (let ((result (capture operation (js-array value))))
                (js-object :events events :thrown (if (= result sentinel) "sentinel" (get (get result :constructor) :name)) :message (get result :message)))))))
            (js-call assert :deepEqual (funcall observe fn) (funcall observe original)))))
        (let ((saved (get (js* "globalThis") :Error)) (value (js-object)) (calls (js-array)))
          (try
            (put (js* "globalThis") :Error (funcall error-constructor-bridge (lambda (target args) (js-call calls :push (js-object :target target :args args))) value))
            (js-call assert :equal (capture original (js-array "message" "ignored")) value)
            (let ((expected (js-call calls :splice 0)))
              (js-call assert :equal (capture fn (js-array "message" "ignored")) value)
              (js-call assert :deepEqual calls expected) (js-call assert :equal (get calls :length) 1))
            (finally (put (js* "globalThis") :Error saved)))))))))
  (test "compiler error helpers lower as existing Eliscript functions instead of host JavaScript algorithms" (lambda ()
    (js-call programs :forEach (lambda (item)
      (let* ((file (get item :file)) (program (get item :program)) (saved (JSON/stringify program))
             (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime))))
        (js-call assert :equal (JSON/stringify program) saved file)
        (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array) file)
        (let ((a (instantiateManagedRuntime bytes)))
          (js-call a :auto 1)
          (js-call (js-array undefined nil false 0 (js* "-0") globalThis.NaN globalThis.Infinity "" "中😀\ud800") :forEach (lambda (input)
            (let ((value (cond ((= (funcall host-typeof input) "number") (js-call a :number input)) ((= (funcall host-typeof input) "string") (js-call a :string input)) (t input))) (error undefined))
              (try (js-call a :invoke "invoke-error" (js-array value)) (js-call assert :fail "must throw") (catch caught (setq error caught)))
              (let* ((expected (capture original (js-array input))) (message (js-call a :string "message")) (actual (js-call a :objectGet error message)))
                (js-call assert :equal (if (= actual undefined) "" (js-call a :readString actual)) (get expected :message) file)
                (let* ((name (js-call a :string "name")) (actualName (js-call a :objectGet error name)) (keys (js-call a :objectKeys error)))
                  (js-call assert :equal (js-call a :readString actualName) "Error") (js-call assert :equal (js-call a :length keys) 0 "Error message stays nonenumerable")
                  (js-call a :collect) (unless (= actual undefined) (js-call assert :equal (js-call a :readString actual) (get expected :message)))
                  (js-call (js-array value error message actual name actualName keys) :forEach (lambda (root) (js-call a :release root)))
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))
          (js-call a :closeModule) (js-call a :collect) (js-call assert :equal (js-call a :live) 0 file)))))))
  (test "an independent Node engine executes the same compiler error helpers with original message conversion" (lambda ()
    (let* ((fixture (fileURLToPath (new globalThis.URL "./fixtures/compiler-portable-errors-host.mjs" (js* "import.meta.url"))))
           (child (spawnSync "node" (js-array fixture (get (pathToFileURL (str directory "/")) :href)) (js-object :encoding "utf8" :timeout 30000))))
      (js-call assert :equal (get child :status) 0 (get child :stderr)))))
)
