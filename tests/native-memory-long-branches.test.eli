(module tests.native-memory-long-branches.test
  (import "node:process" :default process)
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" buildBackends)
  (defconst nativeTest (js-call test :skipIf (or (not (= (get process :platform) "darwin")) (not (= (get process :arch) "arm64")))))
  (defvar directory undefined) (defvar b undefined) (defvar memory undefined) (defvar assembly undefined)
  (defun each (items callback) (js-call items :forEach callback))
  (defun findNode (node predicate)
    (if (funcall predicate node) node
      (let ((children (get node :children)) (index 0) (found undefined))
        (while (and (= found undefined) (< index (get children :length))) (setq found (findNode (aref children index) predicate)) (setq index (1+ index))) found)))
  (defun signed (value bits) (let ((sign (Math/pow 2 (1- bits)))) (if (>= value sign) (- value (Math/pow 2 bits)) value)))
  (defun diagnostic (error) (let ((info (get error :eliscriptDiagnostic))) (if (nullish? info) undefined (get info :code))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-long-branches-")))) (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq memory (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve (get b :directory) "memory.mjs")) :href))))
    (let* ((text (await (readFile "bootstrap/backends/native.eli" "utf8")))
           (privateSource (str (js-call text :slice 0 (js-call text :lastIndexOf ")")) " (export branch-word patch-jump finish-branches long-jump typed-code memory-code macho-library))"))
           (file (resolve (get b :directory) "native-assembly-unit.mjs")))
      (await (writeFile file (js-call (get b :compiler) :compile_string privateSource "native-assembly-unit.eli")))
      (setq assembly (await (funcall (js* "(url) => import(url)") (get (pathToFileURL file) :href)))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun memoryPadding ()
    (let* ((ir (js-call (get b :compiler) :compile_ir_string "(import \"eliscript:memory32\" load-u8) (defun padding () (load-u8 0)) (export padding)" "branch-padding.eli"))
           (lowered (js-call memory :lower_memory_program ir))
           (access (findNode (get (aref (get lowered :functions) 0) :body) (lambda (node) (and (= (get node :kind) "memory-op") (= (get node :value) "load-u8"))))))
      (assert access "padding must be an actual lowered memory read, including its trap semantics")
      (Array/from (js-object :length 65536) (lambda () (funcall globalThis.structuredClone access)))))
  (defun assertLongMemoryBranches (bytes &rest __host_default_arguments_1)
    (let* ((options (aref __host_default_arguments_1 0)))
    (when (= options undefined) (setq options (js-object :backward false)))
    (let* ((view (new globalThis.DataView (get bytes :buffer) (get bytes :byteOffset) (get bytes :byteLength)))
           (commands (js-call view :getUint32 16 t)) (command 32) (start -1) (count 0) (i 0))
      (while (< i commands)
        (let ((kind (js-call view :getUint32 command t)) (size (js-call view :getUint32 (+ command 4) t)))
          (when (= kind 25)
            (let ((section 0)) (while (< section (js-call view :getUint32 (+ command 64) t))
              (let ((at (+ command 72 (* section 80))) (name "") (j 0))
                (while (and (< j 16) (not (= (js-call view :getUint8 (+ at j)) 0))) (setq name (str name (String/fromCharCode (js-call view :getUint8 (+ at j))))) (setq j (1+ j)))
                (when (= name "__text") (setq start (js-call view :getUint32 (+ at 48) t)) (setq count (/ (funcall globalThis.Number (js-call view :getBigUint64 (+ at 40) t)) 4))))
              (setq section (1+ section)))))
          (setq command (+ command size)))
        (setq i (1+ i)))
      (assert (and (>= start 0) (Number/isSafeInteger count) (> count 0)) "actual image must declare its code section")
      (assert (<= (+ start (* count 4)) (get bytes :byteLength)))
      (let ((relaxedForward false) (longBackward false) (i 0))
        (while (< i count)
          (let* ((word (js-call view :getUint32 (+ start (* i 4)) t))
                 (conditional (or (= (uint32 (bit-and word 4278190096)) 1409286144) (= (uint32 (bit-and word 2113929216)) 872415232))))
            (when (and (= (uint32 (bit-and word 4227858432)) 335544320) (< (signed (bit-and word 67108863) 26) -262144)) (setq longBackward t))
            (when (and conditional (= (signed (bit-and (unsigned-bit-shift-right word 5) 524287) 19) 2) (< (1+ i) count))
              (let* ((next (js-call view :getUint32 (+ start (* (1+ i) 4)) t)) (distance (signed (bit-and next 67108863) 26)))
                (when (and (= (uint32 (bit-and next 4227858432)) 335544320) (>= distance 262143))
                  (assert (< (+ i 1 distance) count) "relaxed conditional must reach a real code label") (setq relaxedForward t)))))
          (setq i (1+ i)))
        (assert relaxedForward "actual machine code must invert a conditional and branch beyond imm19 range")
        (when (get options :backward) (assert longBackward "actual machine code must retain the long backward loop branch"))))))
  (defun largeProgram ()
    (let* ((ir (js-call (get b :compiler) :compile_ir_string "(defun branch (n) (if (< n 1) 7 9)) (export branch)" "long-branch.eli"))
           (program (js-call memory :lower_memory_program ir)) (node (findNode (get (aref (get program :functions) 0) :body) (lambda (node) (= (get node :kind) "if")))))
      (put (get node :children) 1 (js-object :kind "sequence" :type "u32" :value nil :children (js-call (memoryPadding) :concat (js-array (aref (get node :children) 1)))))
      program))
  (test "generic memory IR branches over more than one MiB without changing its typed input" (lambda ()
    (let* ((program (largeProgram)) (saved (JSON/stringify program)) (bytes (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_object program "arm64-macos"))))
      (js-call assert :equal (JSON/stringify program) saved) (js-call assert :equal (js-call (new globalThis.DataView (get bytes :buffer)) :getUint32 0 t) 4277009103) (assertLongMemoryBranches bytes))))
  (test "unchanged short branch images" (async ()
    (let* ((p (js-call (get b :compiler) :compile_ir_string "(defun f (x) (if (< x 0) (- x) x)) (export f)" "short.eli"))
           (m (js-call memory :lower_memory_program p)) (saved (funcall globalThis.structuredClone m))
           (hashes (js-call (js-array (js-call (get b :native) :emit_native_numeric_object p "arm64-macos") (js-call (get b :native) :emit_typed_native_memory_object m "arm64-macos")
             (js-call (get b :native) :emit_native_numeric_executable (js-call (get b :compiler) :compile_ir_string "(defun main () 42) (export main)" "entry.eli") "arm64-macos" "main"))
             :map (lambda (bytes) (js-call (js-call (createHash "sha256") :update (Uint8Array/from bytes)) :digest "hex")))))
      (js-call assert :deepEqual hashes (js-array "f66f8684c86bf732f03e9824055eeb74e2fe95b3c57c94702f6004f3bc6b606a" "9afa4a6dda8d5dd44bc9b980eb06df94b273be985e358dcdfd3579d5b5e3a1d9" "6dc7091ec3074b05abadb38a3832eba658e76cb90615a0b674e8cf4216afe8c2"))
      (let ((code (js-call assembly :memory_code m)))
        (assert (js-call (get code :words) :some (lambda (word) (= (uint32 word) 3089073056))) "parameter store uses STUR W0,[FP,#-8]")
        (assert (js-call (get code :words) :some (lambda (word) (= (uint32 word) 3093267360))) "parameter read uses LDUR W0,[FP,#-8]")
        (assert (js-call (get code :words) :some (lambda (word) (= (uint32 word) 1384120320))) "word zero uses the short W-register immediate"))
      (let* ((module (new WebAssembly.Module (Uint8Array/from (js-call (get b :wasm) :emit_typed_memory_wasm m))))
             (w (get (new WebAssembly.Instance module) :exports)) (values (js-array 0 1 2147483647 2147483648 4294967295)))
        (js-call assert :deepEqual (WebAssembly.Module/imports module) (js-array))
        (each values (lambda (value) (js-call assert :equal (uint32 (js-call w :f value)) value)))
        (when (and (= (get process :arch) "arm64") (or (= (get process :platform) "darwin") (= (get process :platform) "linux")))
          (let* ((target (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos"))
                 (file (resolve directory (str "short-memory." (if (= (get process :platform) "linux") "so" "dylib")))))
            (await (writeFile file (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library m target))))
            (let* ((loader (await (funcall (js* "(url) => import(url)") "../tools/backends/native-memory.mjs")))
                   (n (await (js-call loader :openNativeMemory file (js-object :f 1) (js-object :nativeTarget target)))))
              (try (each values (lambda (value) (js-call assert :equal (js-call n :invoke "f" value) value) (js-call assert :equal (js-call n :invoke "f" value) (uint32 (js-call w :f value)))))
                (finally (js-call n :close)))))))
      (js-call assert :deepEqual m saved))))
  (test "all emitted branch kinds retain their real signed displacement widths and original condition/register bits" (lambda ()
    (each (js-array (js-array 335544320 26) (js-array 2483027968 26) (js-array 1409286155 19) (js-array 872415241 19) (js-array 3036676108 19) (js-array 906493965 14)) (lambda (entry)
      (let* ((opcode (aref entry 0)) (bits (aref entry 1)) (limit (Math/pow 2 (1- bits))))
        (each (js-array (- limit) -1 0 1 (1- limit)) (lambda (distance)
          (let* ((word (uint32 (js-call assembly :branch_word opcode distance))) (immediate (if (= bits 26) (bit-and word 67108863) (bit-and (unsigned-bit-shift-right word 5) (1- (Math/pow 2 bits)))))
                 (mask (if (= bits 26) 4227858432 (if (= bits 14) 4294443039 4278190111))))
            (js-call assert :equal (signed immediate bits) distance) (js-call assert :equal (bit-and word mask) (bit-and opcode mask)))))
        (each (js-array (- (- limit) 1) limit) (lambda (distance) (js-call assert :throws (lambda () (js-call assembly :branch_word opcode distance)) (lambda (error) (= (diagnostic error) "ELI-B0001"))))))))))
  (test "layout reaches a fixed point when a newly long forward branch pushes another forward or backward branch out of range" (lambda ()
    (let ((NOP 3573751839))
      (each (js-array false t) (lambda (backward)
        (let* ((words (js-call (new globalThis.Array 262147) :fill NOP)) (originalLength (get words :length))
               (state (js-object :words words :constants (js-array (js-object :uses (js-array 262143))) :tableUses (js-array 2))) (offsets (js-array 0 (* 262143 4))))
          (if backward
            (progn (put words 1 872415232) (put words 262144 1409286155) (js-call assembly :patch_jump state 1 262146) (js-call assembly :patch_jump state 262144 0))
            (progn (put words 0 1409286144) (put words 1 872415241) (js-call assembly :patch_jump state 0 262143) (js-call assembly :patch_jump state 1 262145)))
          (js-call assembly :finish_branches state offsets)
          (js-call assert :equal (get (get state :words) :length) (+ originalLength 2))
          (js-call assert :deepEqual offsets (js-array 0 (* (+ 262143 (if backward 1 2)) 4)))
          (js-call assert :deepEqual (get state :tableUses) (js-array (if backward 3 4)))
          (js-call assert :deepEqual (get (aref (get state :constants) 0) :uses) (js-array (+ 262143 (if backward 1 2))))
          (if backward
            (js-call assert :equal (signed (bit-and (aref (get state :words) 262146) 67108863) 26) -262146)
            (progn (js-call assert :equal (uint32 (aref (get state :words) 0)) 1409286209) (js-call assert :equal (uint32 (aref (get state :words) 2)) 889192521)
              (js-call assert :equal (signed (bit-and (aref (get state :words) 1) 67108863) 26) 262144) (js-call assert :equal (signed (bit-and (aref (get state :words) 3) 67108863) 26) 262144)))))))))
  (defun longDelta (words &rest __host_default_arguments_2)
    (let* ((start (aref __host_default_arguments_2 0)))
    (when (= start undefined) (setq start 0))
    (js-call assert :equal (uint32 (aref words start)) 268435472)
    (let ((result (js* "0n")) (i 0))
      (while (< i 4)
        (let* ((word (uint32 (aref words (+ start 1 i))))
               (piece (funcall globalThis.BigInt (bit-and (unsigned-bit-shift-right word 5) 65535)))
               (scale (funcall globalThis.BigInt (Math/pow 2 (* i 16)))))
          (js-call assert :equal (bit-and word 31) 17)
          (setq result (+ result (* piece scale))))
        (setq i (1+ i)))
      (BigInt/asIntN 64 result))))
  (test "in-place layout retains zero-growth words and all function, literal, table and debug positions" (lambda ()
    (let ((NOP 3573751839))
      (each (js-array false t) (lambda (patched)
        (let* ((words (if patched (js-array 335544320 2483027968 1409286144 906493965 NOP) (js-array NOP NOP NOP NOP NOP)))
               (ranges (js-array (js-object :kind "function" :start 0 :end 20) (js-object :kind "trap-site" :start 12 :end 16)))
               (state (js-object :words words :constants (js-array (js-object :uses (js-array 0 3 5))) :tableUses (js-array 1 4) :debugRanges ranges))
               (offsets (js-array 0 4 12 20)) (expected (if patched (js-array 335544324 2550136831 1409286208 907018157 NOP) (js-array NOP NOP NOP NOP NOP))))
          (when patched (js-call assembly :patch_jump state 3 0) (js-call assembly :patch_jump state 1 0) (js-call assembly :patch_jump state 2 4) (js-call assembly :patch_jump state 0 4))
          (js-call assembly :finish_branches state offsets)
          (js-call assert :strictEqual (get state :words) words "layout must not retain a second image array")
          (js-call assert :deepEqual (js-call words :map (lambda (word) (uint32 word))) expected)
          (js-call assert :deepEqual offsets (js-array 0 4 12 20)) (js-call assert :deepEqual (get (aref (get state :constants) 0) :uses) (js-array 0 3 5))
          (js-call assert :deepEqual (get state :tableUses) (js-array 1 4))
          (js-call assert :deepEqual ranges (js-array (js-object :kind "function" :start 0 :end 20) (js-object :kind "trap-site" :start 12 :end 16)))
          (js-call assert :deepEqual (get state :branches) (js-array))
          (js-call assembly :finish_branches state offsets) (js-call assert :strictEqual (get state :words) words)
          (js-call assert :deepEqual (js-call words :map (lambda (word) (uint32 word))) expected)))))))
  (test "in-place mixed relaxation preserves old tail words and exact shared metadata labels" (lambda ()
    (let* ((NOP 3573751839) (words (js-array 906493965 NOP 2483027968 NOP 889192457 NOP NOP))
           (trap (js-object :kind "trap-site" :start 16 :end 20)) (functionRange (js-object :kind "function" :start 0 :end 12))
           (state (js-object :words words :constants (js-array (js-object :uses (js-array 1 2 3 4 7))) :tableUses (js-array 0 2 5 7)
             :debugRanges (js-array functionRange (js-object :kind "expression" :start 4 :end 20) trap) :trapSites (js-array trap) :debugFunctionRange functionRange))
           (offsets (js-array 0 4 8 12 16 20 28)))
      (js-call assembly :patch_jump state 4 0) (js-call assembly :patch_jump state 2 -33554431) (js-call assembly :patch_jump state 0 8192)
      (js-call assembly :finish_branches state offsets) (js-call assert :strictEqual (get state :words) words) (js-call assert :equal (get words :length) 14)
      (js-call assert :equal (uint32 (aref words 0)) 923271245)
      (js-call assert :equal (1+ (signed (bit-and (aref words 1) 67108863) 26)) 8199)
      (js-call assert :equal (longDelta words 3) (funcall globalThis.BigInt (* (- -33554431 3) 4)))
      (js-call assert :equal (uint32 (aref words 9)) 3594453504 "BL returns after the complete long sequence")
      (js-call assert :equal (+ (signed (bit-and (unsigned-bit-shift-right (aref words 11) 5) 524287) 19) 11) 0)
      (js-call assert :equal (uint32 (bit-and (aref words 11) 4278190111)) 889192457)
      (js-call assert :deepEqual (js-call (js-array (aref words 2) (aref words 10) (aref words 12) (aref words 13)) :map (lambda (word) (uint32 word))) (js-array NOP NOP NOP NOP))
      (js-call assert :deepEqual offsets (js-array 0 8 12 40 44 48 56))
      (js-call assert :deepEqual (get (aref (get state :constants) 0) :uses) (js-array 2 3 10 11 14))
      (js-call assert :deepEqual (get state :tableUses) (js-array 0 3 12 14))
      (js-call assert :deepEqual (get state :debugRanges) (js-array (js-object :kind "function" :start 0 :end 40) (js-object :kind "expression" :start 8 :end 48) (js-object :kind "trap-site" :start 44 :end 48)))
      (js-call assert :strictEqual (aref (get state :trapSites) 0) trap) (js-call assert :strictEqual (get state :debugFunctionRange) functionRange)
      (js-call assert :deepEqual (get state :branches) (js-array)))))
  (test "far B BL and conditional encodings use a relocatable signed delta without needing enormous test images" (lambda ()
    (each (js-array (js-array 335544320 33554432 7) (js-array 2483027968 -33554433 7) (js-array 1409286155 33554432 8) (js-array 889192457 -33554433 8)) (lambda (entry)
      (let* ((opcode (aref entry 0)) (target (aref entry 1)) (size (aref entry 2)) (state (js-object :words (js-array opcode))))
        (js-call assembly :patch_jump state 0 target) (js-call assembly :finish_branches state (js-array))
        (js-call assert :equal (get (get state :words) :length) size)
        (let ((start (if (= size 8) 1 0)) (mapped (if (> target 0) (+ target size -1) target)))
          (js-call assert :equal (longDelta (get state :words) start) (funcall globalThis.BigInt (* (- mapped start) 4))))
        (js-call assert :equal (uint32 (aref (get state :words) (1- size))) (if (= opcode 2483027968) 3594453504 3592356352))
        (when (= size 8) (js-call assert :equal (signed (bit-and (unsigned-bit-shift-right (aref (get state :words) 0) 5) 524287) 19) 8)))))))
  (nativeTest "real ARM64 long B and BLR sequences preserve execution and the normal memory call ABI" (async ()
    (let* ((loader (await (funcall (js* "(url) => import(url)") "../tools/backends/native-memory.mjs")))
           (branchState (js-object :words (js-array) :compact false)))
      (js-call assembly :long_jump branchState 8 false) (js-call (get branchState :words) :push 1384123488 1384120544 3596551104)
      (let ((branchProgram (js-object :functions (js-array (js-object :name "run" :arity 0 :index 0 :locals (js-array))) :exports (js-array "run"))) (branchFile (resolve directory "long-b.dylib")))
        (await (writeFile branchFile (Uint8Array/from (js-call assembly :macho_library branchProgram (js-object :words (get branchState :words) :offsets (js-array 0))))))
        (let ((branch (await (js-call loader :openNativeMemory branchFile (js-object :run 0)))))
          (try (js-call assert :equal (js-call branch :invoke "run") 7) (finally (js-call branch :close)))))
      (let* ((p (js-call memory :lower_memory_program (js-call (get b :compiler) :compile_ir_string "(defun target (n) (+ n 3)) (defun run (n) (target n)) (export run)" "long-blr.eli")))
             (code (js-call assembly :memory_code p)) (at (js-call (get code :words) :findIndex (lambda (word i) (and (>= i (/ (aref (get code :offsets) 1) 4)) (= (unsigned-bit-shift-right word 26) 37)))))
             (replacement (js-object :words (js-array) :compact false)) (file (resolve directory "long-blr.dylib")))
        (assert (>= at 0)) (js-call assembly :long_jump replacement (- (/ (aref (get code :offsets) 0) 4) at) t)
        (Reflect/apply (get (get code :words) :splice) (get code :words) (js-call (js-array at 1) :concat (get replacement :words)))
        (await (writeFile file (Uint8Array/from (js-call assembly :macho_library p code))))
        (let ((n (await (js-call loader :openNativeMemory file (js-object :run 1))))) (try (js-call assert :equal (js-call n :invoke "run" 10) 13) (finally (js-call n :close))))))))
  (nativeTest "relaxed forward backward calls indirect table and real traps execute against identical WASM typed IR" (async ()
    (let* ((text "(import \"eliscript:memory32\" load-u8 call-source) (defun table-target (a b c d) (+ (+ a b) (+ c d))) (defun target (n) (+ n 3)) (defun trap (n) (load-u8 n)) (defun forward (n) (if (< n 1) (progn (target n) 7) 9)) (defun backward (n) (while (> n 0) (setq n (- n 1))) n) (defun trapped (n) (trap n) 7) (defun dispatch (n) (call-source n 1 2 3 0)) (export forward backward trapped dispatch)")
           (p (js-call memory :lower_memory_program (js-call (get b :compiler) :compile_ir_string text "long-execute.eli")))
           (forward (findNode (get (js-call (get p :functions) :find (lambda (f) (= (get f :name) "forward"))) :body) (lambda (n) (= (get n :kind) "if"))))
           (loop (findNode (get (js-call (get p :functions) :find (lambda (f) (= (get f :name) "backward"))) :body) (lambda (n) (= (get n :kind) "while"))))
           (trapped (get (js-call (get p :functions) :find (lambda (f) (= (get f :name) "trapped"))) :body)))
      (let ((children (get (aref (get forward :children) 1) :children))) (Reflect/apply (get children :splice) children (js-call (js-array 1 0) :concat (memoryPadding))))
      (let ((children (get (aref (get loop :children) 1) :children))) (Reflect/apply (get children :unshift) children (memoryPadding)))
      (Reflect/apply (get (get trapped :children) :splice) (get trapped :children) (js-call (js-array 1 0) :concat (memoryPadding)))
      (put p :table (js-array (get (js-call (get p :functions) :find (lambda (f) (= (get f :name) "table-target"))) :index)))
      (let* ((snapshot (JSON/stringify p)) (wasm (Uint8Array/from (js-call (get b :wasm) :emit_typed_memory_wasm (funcall globalThis.structuredClone p))))
             (w (get (new WebAssembly.Instance (new WebAssembly.Module wasm)) :exports)) (file (resolve directory "relaxed.dylib"))
             (nativeBytes (progn (js-call assert :deepEqual (WebAssembly.Module/imports (new WebAssembly.Module wasm)) (js-array)) (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library p "arm64-macos")))))
        (assertLongMemoryBranches nativeBytes (js-object :backward t)) (await (writeFile file nativeBytes)) (js-call assert :equal (JSON/stringify p) snapshot)
        (let* ((loader (await (funcall (js* "(url) => import(url)") "../tools/backends/native-memory.mjs"))) (n (await (js-call loader :openNativeMemory file (js-object :forward 1 :backward 1 :trapped 1 :dispatch 1)))))
          (try
            (each (js-array 0 1 2 4294967295) (lambda (value) (js-call assert :equal (js-call n :invoke "forward" value) (uint32 (js-call w :forward value)))))
            (each (js-array 0 1 2) (lambda (value) (js-call assert :equal (js-call n :invoke "backward" value) (uint32 (js-call w :backward value)))))
            (each (js-array 0 10 4294967295) (lambda (value) (js-call assert :equal (js-call n :invoke "dispatch" value) (uint32 (js-call w :dispatch value)))))
            (js-call assert :throws (lambda () (js-call n :invoke "trapped" 65536)) WebAssembly.RuntimeError) (js-call assert :throws (lambda () (js-call w :trapped 65536)) WebAssembly.RuntimeError)
            (js-call assert :equal (js-call n :invoke "trapped" 0) (uint32 (js-call w :trapped 0)))
            (finally (js-call n :close))))))))
  (nativeTest "long floating-point conditionals retain ordered NaN comparisons and signed-zero results against JavaScript and WASM" (async ()
    (let* ((source "(defun choose (x) (if (< x 0) -0.0 x)) (export choose)") (ir (js-call (get b :compiler) :compile_ir_string source "long-float.eli"))
           (program (js-call (get b :numeric) :lower_numeric_program ir)) (node (findNode (get (aref (get program :functions) 0) :body) (lambda (n) (= (get n :kind) "if")))))
      (put (get node :children) 1 (js-object :kind "sequence" :type "f64" :value nil :children
        (js-call (Array/from (js-object :length 65536) (lambda () (js-object :kind "literal" :type "f64" :value 0 :children (js-array)))) :concat (js-array (aref (get node :children) 1)))))
      (let* ((snapshot (JSON/stringify program)) (code (js-call assembly :typed_code program (js-object :registerAllocation false)))
             (wasm (get (new WebAssembly.Instance (new WebAssembly.Module (Uint8Array/from (js-call (get b :wasm) :emit_typed_numeric_wasm program)))) :exports))
             (js (await (funcall (js* "(url) => import(url)") (str "data:text/javascript;base64," (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string ir)) :toString "base64")))))
             (file (resolve directory "long-float.dylib")))
        (await (writeFile file (Uint8Array/from (js-call assembly :macho_library program code)))) (js-call assert :equal (JSON/stringify program) snapshot)
        (let* ((ffi (await (funcall (js* "(url) => import(url)") "bun:ffi")))
               (native (js-call ffi :dlopen file (js-object :choose (js-object :args (js-array "f64") :returns "f64")))))
          (try (each (js-array globalThis.NaN globalThis.Infinity (- globalThis.Infinity) -1 (- (get globalThis.Number :MIN_VALUE)) (js* "-0") 0 (get globalThis.Number :MIN_VALUE) 1) (lambda (value)
            (assert (Object/is (js-call (get native :symbols) :choose value) (js-call js :choose value))) (assert (Object/is (js-call wasm :choose value) (js-call js :choose value)))))
            (finally (js-call native :close))))))))
)
