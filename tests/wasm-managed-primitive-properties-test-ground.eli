(module tests.wasm-managed-primitive-properties-test-ground
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  ;; Number/Boolean boxes expose missing ordinary fields and represented inherited
  ;; data. Their own unrepresented native prototype functions remain rejected.
  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defconst source
    (str "\n"
         " (defconst marker 1)\n"
         " (defun member (receiver key) (aref receiver key))\n"
         " (defun fallback (receiver key trace)\n"
         "   (get receiver key (progn (js-call trace :push \"default\") 7)))\n"
         " (defun converted (receiver trace)\n"
         "   (let ((key (js-object)))\n"
         "     (put key (js* \"Symbol.toPrimitive\")\n"
         "       (lambda (hint) (js-call trace :push hint) \"absent\"))\n"
         "     (aref receiver key)))\n"
         " (defun abrupt (receiver trace)\n"
         "   (let ((key (js-object)))\n"
         "     (put key (js* \"Symbol.toPrimitive\") (lambda (hint) (throw trace)))\n"
         "     (try (aref receiver key) (catch error (Object/is error trace)))))\n"
         " (defun expression (receiver trace)\n"
         "   (let ((key (js-object)))\n"
         "     (put key (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call trace :push hint) \"absent\"))\n"
         "     (aref receiver (progn (js-call trace :push \"key-expression\") key))))\n"
         " (export member fallback converted abrupt expression)"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar program nil)
  (defvar js nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-primitive-properties-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
      (setq program (js-call (get b :compiler) :compile_ir_string source "primitive-properties.eli"))
      (setq js (await (funcall dynamic-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string program)) :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun make-artifact (&rest __host_default_arguments_1)
    (let* ((rt (aref __host_default_arguments_1 0)))
    (let* ((actual-rt (if (undefined? rt) runtime rt))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program actual-rt))))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      bytes)))

  (defun read-val (a value)
    (if (and (not (nullish? value)) (= (funcall js-typeof value) "object"))
      (let ((k (get value :kind)))
        (cond
          ((= k 4) (js-call a :readNumber value))
          ((= k 5) (js-call a :readString value))
          ((= k 14)
           (Array/from (js-object :length (js-call a :length value))
             (lambda (_ i)
               (let ((item (js-call a :get value i)))
                 (try
                   (read-val a item)
                   (finally (js-call a :release item)))))))
          (t value)))
      value))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((roots (aref __host_default_arguments_2 0)))
    (let ((owned (if (undefined? roots) (js-array) roots)))
      (js-call owned :forEach (lambda (root) (js-call a :release root)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (test "represented Boolean and Number primitives retain ordinary missing property results default effects and string-hint key conversion"
    (lambda ()
      (let ((a (instantiateManagedRuntime (make-artifact))))
        (js-call a :auto 1)
        (js-call (js-array false t 0 -0.0 1 globalThis.NaN globalThis.Infinity) :forEach
          (lambda (value)
            (let* ((input (if (= (funcall js-typeof value) "number") (js-call a :number value) value))
                   (key (js-call a :string "absent"))
                   (trace (js-call a :sourceArray (js-array))))
              (js-call assert :equal (js-call a :invoke "member" (js-array input key)) (get value :absent))
              (js-call assert :equal (js-call a :invoke "converted" (js-array input trace)) undefined)
              (js-call assert :deepEqual (read-val a trace) (js-array "string"))
              (let ((result (js-call a :invoke "fallback" (js-array input key trace))))
                (js-call assert :equal (js-call a :readNumber result) 7)
                (js-call assert :deepEqual (read-val a trace) (js-array "string" "default"))
                (js-call assert :equal (js-call a :invoke "abrupt" (js-array input trace)) t)
                (js-call (js-array input key trace result) :forEach (lambda (root) (js-call a :release root)))
                (js-call a :collect)))))
        (finish a))))

  (test "nullish reads retain their source errors and unrepresented primitive prototype methods are explicitly rejected"
    (lambda ()
      (let ((a (instantiateManagedRuntime (make-artifact))))
        (js-call a :auto 1)
        (let ((key (js-call a :string "absent"))
              (trace (js-call a :sourceArray (js-array))))
          (js-call (js-array nil undefined) :forEach
            (lambda (value)
              (js-call assert :throws
                (lambda () (js-call a :invoke "member" (js-array value key)))
                (lambda (err) (diag-code? err "ELI-RT0001")))
              (js-call assert :throws
                (lambda () (js-call a :invoke "converted" (js-array value trace)))
                (lambda (err) (diag-code? err "ELI-RT0001")))
              (js-call assert :deepEqual (read-val a trace) (js-array))))
          (let ((num (js-call a :number 1)))
            (js-call (js-array false t num) :forEach
              (lambda (value)
                (js-call (js-array "constructor" "toString" "valueOf" "toLocaleString" "__proto__") :forEach
                  (lambda (name)
                    (let ((prop (js-call a :string name)))
                      (js-call assert :throws
                        (lambda () (js-call a :invoke "member" (js-array value prop)))
                        (lambda (err) (diag-code? err "ELI-RT0003")))
                      (js-call a :release prop))))))
            (finish a (js-array key trace num)))))))

  (test "computed nullish reads execute the key expression but suppress ToPropertyKey just as independent native JavaScript"
    (lambda ()
      (let ((a (instantiateManagedRuntime (make-artifact))))
        (js-call a :auto 1)
        (js-call (js-array nil undefined) :forEach
          (lambda (receiver)
            (let ((trace (js-call a :sourceArray (js-array)))
                  (expected (js-array)))
              (js-call assert :throws (lambda () (js-call js :expression receiver expected)) globalThis.TypeError)
              (js-call assert :deepEqual expected (js-array "key-expression"))
              (js-call assert :throws
                (lambda () (js-call a :invoke "expression" (js-array receiver trace)))
                (lambda (err) (diag-code? err "ELI-RT0001")))
              (js-call assert :deepEqual (read-val a trace) expected)
              (js-call a :release trace))))
        (finish a))))

  (test "primitive property reads preserve invalid stale and foreign handle rejection and private array ABI admission"
    (lambda ()
      (let* ((bytes (make-artifact))
             (a (instantiateManagedRuntime bytes))
             (other (instantiateManagedRuntime bytes))
             (key (js-call a :string "missing"))
             (foreign (js-call other :number 3))
             (stale (js-call a :number 9)))
        (js-call assert :throws
          (lambda () (js-call a :invoke "member" (js-array foreign key)))
          (lambda (err) (diag-code? err "ELI-RT0001")))
        (js-call a :release stale)
        (js-call a :collect)
        (js-call assert :throws
          (lambda () (js-call a :invoke "member" (js-array stale key)))
          (lambda (err) (diag-code? err "ELI-RT0001")))
        (let* ((inst (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)))
               (e (get inst :exports))
               (heap (funcall (aref e "heap-new") 64 8192 65536))
               (num (funcall (aref e "value-number") heap 0 0)))
          (funcall (aref e "value-property-get") heap 4294967295 3 0)
          (js-call assert :equal (funcall (aref e "last-error")) 1)
          (funcall (aref e "value-array-get") heap num 3 0)
          (js-call assert :equal (funcall (aref e "last-error")) 1)
          (finish a (js-array key))
          (finish other (js-array foreign))))))

  (test "primitive read allocation failures retain caller roots and later missing-property reads recover"
    (lambda ()
      (let ((a (instantiateManagedRuntime (make-artifact) (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 65536))))
        (js-call a :auto 1)
        (let ((key (js-call a :string "missing"))
              (held (js-call a :number -0.0))
              (frame (js-call a :frame 1))
              (fillers (js-array)))
          (js-call a :frameSet frame 0 held)
          (while (< (js-call a :live) 64)
            (js-call fillers :push (js-call a :number 7)))
          (js-call assert :throws
            (lambda () (js-call a :invoke "member" (js-array t key)))
            (lambda (err) (diag-code? err "ELI-RT0002")))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (funcall assert (Object/is (js-call a :readNumber held) -0.0))
          (js-call fillers :forEach (lambda (value) (js-call a :release value)))
          (js-call a :collect)
          (js-call assert :equal (js-call a :invoke "member" (js-array t key)) undefined)
          (js-call a :leaveFrame frame)
          (finish a (js-array key held))))))

  (test "primitive reads observe represented Object prototype data across collection and realm close without inventing native methods"
    (lambda ()
      (let* ((inst (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (make-artifact))))
             (e (get inst :exports))
             (h (funcall (aref e "heap-new") 128 16384 131072)))
        (funcall (aref e "heap-auto") h 1)
        (let* ((raw-call (lambda (name &rest args)
                           (let ((result (unsigned-bit-shift-right (js-call (aref e name) :apply nil (js-call (js-array h) :concat args)) 0)))
                             (js-call assert :equal (funcall (aref e "last-error")) 0 name)
                             result)))
               (make-text (lambda (value)
                            (let ((result (funcall raw-call "value-string" (length value)))
                                  (i 0))
                              (funcall raw-call "heap-pin" result)
                              (while (< i (length value))
                                (funcall raw-call "value-unit-set" result i (js-call value :charCodeAt i))
                                (setq i (+ i 1)))
                              (funcall raw-call "value-seal" result)
                              result)))
               (key (funcall make-text "visible"))
               (missing (funcall make-text "missing"))
               (standard (funcall make-text "hasOwnProperty"))
               (num (funcall raw-call "value-number" 0 0)))
          (funcall raw-call "heap-pin" num)
          (js-call assert :equal (funcall raw-call "value-standard-prototype-existing" 0) 0)
          (let ((root (funcall raw-call "value-standard-prototype" 0))
                (obj (funcall raw-call "value-object-new" 3)))
            (funcall raw-call "heap-pin" obj)
            (funcall raw-call "value-object-put" root key 2 2)
            (js-call assert :equal (funcall raw-call "value-property-get" 1 key 0) 2)
            (js-call assert :equal (funcall raw-call "value-property-get" num key 0) 2)
            (js-call assert :equal (funcall raw-call "value-property-get" 2 missing 0) 3)
            (funcall raw-call "value-object-put" root standard 1 2)
            (js-call assert :equal (funcall raw-call "value-property-get" 2 standard 0) 1)
            (funcall raw-call "heap-collect")
            (js-call assert :equal (funcall raw-call "value-property-get" 1 key 0) 2)
            (funcall raw-call "value-standard-prototypes-close")
            (funcall raw-call "heap-collect")
            (js-call assert :equal (funcall raw-call "value-standard-prototype-existing" 0) root)
            (js-call assert :equal (funcall raw-call "value-property-get" num key 0) 2)
            (funcall raw-call "heap-release" obj)
            (funcall raw-call "heap-collect")
            (js-call assert :equal (funcall raw-call "value-standard-prototype-existing" 0) 0)
            (js-call assert :equal (funcall raw-call "value-property-get" 1 key 0) 3)
            (js-call (js-array key missing standard num) :forEach (lambda (value) (funcall raw-call "heap-release" value)))
            (funcall raw-call "heap-collect")
            (js-call assert :equal (funcall raw-call "heap-live") 0)
            (js-call assert :equal (funcall raw-call "frame-depth") 0))))))

  (test "real WASM primitive-read traps propagate and unwind private frames while preserving caller roots"
    (async ()
      (let* ((text (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call text :indexOf "  (defun heap-primitive-property-get "))
             (end (js-call text :indexOf "  (defun value-property-get " start)))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((rt (js-call (get b :compiler) :compile_ir_string
                     (str (js-call text :slice 0 start)
                          "  (defun heap-primitive-property-get (heap receiver key nullish) (load-u32 4294967295))\n"
                          (js-call text :slice end))
                     "primitive-trap.eli"))
               (a (instantiateManagedRuntime (make-artifact rt))))
          (js-call a :auto 1)
          (let ((key (js-call a :string "absent"))
                (held (js-call a :number -0.0))
                (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 held)
            (js-call assert :throws
              (lambda () (js-call a :invoke "member" (js-array t key)))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (funcall assert (Object/is (js-call a :readNumber held) -0.0))
            (js-call a :leaveFrame frame)
            (finish a (js-array key held)))))))

  (defconst inherited-iterator-source
    (str "\n"
         " (defconst iterate (js* \"(iterable, visit) => { for (const item of iterable) visit(item); }\"))\n"
         " (defun install (method) (put (js* \"Object.prototype\") (js* \"Symbol.iterator\") method))\n"
         " (defun install-good (trace)\n"
         "   (install (lambda ()\n"
         "     (js-call trace :push \"iterator\")\n"
         "     (let ((index 0) (iterator (js-object)))\n"
         "       (put iterator :next (lambda ()\n"
         "         (js-call trace :push \"next\")\n"
         "         (if (= index 0) (progn (setq index 1) (js-object :done false :value 7))\n"
         "           (js-object :done t))))\n"
         "       iterator))))\n"
         " (defun run (value trace) (funcall iterate value (lambda (item) (js-call trace :push item))))\n"
         " (defun spread (value) (funcall (js* \"(iterable) => [...iterable]\") value))\n"
         " (defun from (value) (Array/from value))\n"
         " (defun member (value) (aref value (js* \"Symbol.iterator\")))\n"
         " (defun primitive-key (value)\n"
         "   (put (js* \"Object.prototype\") (js* \"Symbol.toPrimitive\") (lambda (hint) (throw \"unexpected-boxing\")))\n"
         "   (aref value 1))\n"
         " (export install install-good run spread from member primitive-key)"))

  (defasync inherited-iterator-family ()
    (let* ((p (js-call (get b :compiler) :compile_ir_string inherited-iterator-source "primitive-inherited-iterator.eli"))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((reference (await (funcall dynamic-import
                                (str "data:text/javascript;base64,"
                                     (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
        (js-object :a (instantiateManagedRuntime bytes) :reference reference))))

  (defun restore-prototype (key descriptor)
    (if (not (nullish? descriptor))
      (Object/defineProperty globalThis.Object.prototype key descriptor)
      (Reflect/deleteProperty globalThis.Object.prototype key)))

  (defun primitive-input (a value)
    (if (Array/isArray value)
      (let ((items (js-call value :map (lambda (item) (primitive-input a item)))))
        (try
          (js-call a :sourceArray items)
          (finally
            (js-call items :forEach (lambda (item) (js-call a :release item))))))
      (let ((ty (funcall js-typeof value)))
        (cond
          ((= ty "number") (js-call a :number value))
          ((= ty "string") (js-call a :string value))
          (t value)))))

  (test "Boolean and Number inherited Symbol.iterator is shared by property Get required for-of spread and optional Array.from"
    (async ()
      (let* ((fam (await (inherited-iterator-family)))
             (a (get fam :a))
             (reference (get fam :reference))
             (sym-iter globalThis.Symbol.iterator)
             (old (Object/getOwnPropertyDescriptor globalThis.Object.prototype sym-iter))
             (native-run (lambda (expected work)
                           (try
                             (js-call reference :install_good expected)
                             (funcall work)
                             (finally (restore-prototype sym-iter old))))))
        (js-call a :auto 1)
        (try
          (js-call (js-array false t 0 -0.0 3 globalThis.NaN globalThis.Infinity) :forEach
            (lambda (value)
              (let ((input (primitive-input a value))
                    (trace (js-call a :sourceArray (js-array)))
                    (expected (js-array)))
                (try
                  (js-call a :release (js-call a :invoke "install-good" (js-array trace)))
                  (let ((member (js-call a :invoke "member" (js-array input))))
                    (js-call assert :equal (get member :kind) 18)
                    (js-call a :release member))
                  (let ((result (funcall native-run expected (lambda () (js-call reference :run value expected)))))
                    (js-call assert :equal (js-call a :invoke "run" (js-array input trace)) result)
                    (js-call assert :deepEqual (read-val a trace) expected))
                  (js-call (js-array "spread" "from") :forEach
                    (lambda (name)
                      (let ((wanted (funcall native-run expected (lambda () (funcall (aref reference name) value))))
                            (out (js-call a :invoke name (js-array input))))
                        (try
                          (js-call assert :deepEqual (read-val a out) wanted)
                          (js-call assert :deepEqual (read-val a trace) expected)
                          (finally (js-call a :release out))))))
                  (finally
                    (js-call a :release input)
                    (js-call a :release trace)
                    (js-call a :collect))))))
          (finally
            (restore-prototype sym-iter old)
            (finish a))))))

  (test "primitive inherited iteration keeps native String Array precedence nullish and noncallable errors and primitive conversion boundaries"
    (async ()
      (let* ((fam (await (inherited-iterator-family)))
             (a (get fam :a))
             (reference (get fam :reference))
             (sym-iter globalThis.Symbol.iterator)
             (sym-prim globalThis.Symbol.toPrimitive)
             (old (Object/getOwnPropertyDescriptor globalThis.Object.prototype sym-iter))
             (old-prim (Object/getOwnPropertyDescriptor globalThis.Object.prototype sym-prim))
             (native-with (lambda (method work)
                            (try
                              (js-call reference :install method)
                              (funcall work)
                              (finally (restore-prototype sym-iter old))))))
        (js-call a :auto 1)
        (try
          (js-call (js-array false nil undefined) :forEach
            (lambda (method)
              (js-call a :release (js-call a :invoke "install" (js-array method)))
              (js-call (js-array false 3 nil undefined) :forEach
                (lambda (value)
                  (let ((input (primitive-input a value))
                        (trace (js-call a :sourceArray (js-array))))
                    (try
                      (js-call (js-array "run" "spread" "from") :forEach
                        (lambda (name)
                          (if (and (= name "from") (not (nullish? value)) (not (eq method false)))
                            (let ((wanted (funcall native-with method (lambda () (js-call reference :from value))))
                                  (out (js-call a :invoke name (js-array input))))
                              (try
                                (js-call assert :deepEqual (read-val a out) wanted)
                                (finally (js-call a :release out))))
                            (progn
                              (js-call assert :throws
                                (lambda () (funcall native-with method (lambda () (funcall (aref reference name) value (js-array)))))
                                globalThis.TypeError)
                              (js-call assert :throws
                                (lambda () (js-call a :invoke name (if (= name "run") (js-array input trace) (js-array input))))
                                (lambda (e) (diag-code? e "ELI-RT0003")))))))
                      (finally
                        (js-call a :release input)
                        (js-call a :release trace))))))))
          (let ((trace (js-call a :sourceArray (js-array)))
                (expected (js-array)))
            (js-call a :release (js-call a :invoke "install-good" (js-array trace)))
            (try
              (js-call (js-array "A😀" (js-array 1 2)) :forEach
                (lambda (value)
                  (let ((input (primitive-input a value)))
                    (try
                      (let ((result (try
                                      (js-call reference :install_good expected)
                                      (js-call reference :run value expected)
                                      (finally (restore-prototype sym-iter old)))))
                        (js-call assert :equal (js-call a :invoke "run" (js-array input trace)) result))
                      (js-call (js-array "spread" "from") :forEach
                        (lambda (name)
                          (let ((wanted (try
                                          (js-call reference :install_good expected)
                                          (funcall (aref reference name) value)
                                          (finally (restore-prototype sym-iter old))))
                                (out (js-call a :invoke name (js-array input))))
                            (try
                              (js-call assert :deepEqual (read-val a out) wanted)
                              (finally (js-call a :release out))))))
                      (finally (js-call a :release input))))))
              (js-call assert :deepEqual (read-val a trace) expected)
              (js-call assert :deepEqual expected (js-array "A" "😀" 1 2))
              (let ((num (js-call a :number 3)))
                (try
                  (js-call assert :equal (js-call a :invoke "primitive-key" (js-array num)) undefined)
                  (let ((result (try
                                  (js-call reference :primitive_key 3)
                                  (finally (restore-prototype sym-prim old-prim)))))
                    (js-call assert :equal result undefined))
                  (finally (js-call a :release num))))
              (finally (js-call a :release trace))))
          (finally
            (restore-prototype sym-iter old)
            (restore-prototype sym-prim old-prim)
            (finish a))))))

  (test "sealed String and Symbol access keys return without allocation even when every heap slot is occupied"
    (lambda ()
      (let* ((inst (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (make-artifact))))
             (e (get inst :exports))
             (h (funcall (aref e "heap-new") 64 16384 131072))
             (raw-call (lambda (name &rest args)
                         (let ((value (unsigned-bit-shift-right (js-call (aref e name) :apply nil (js-call (js-array h) :concat args)) 0)))
                           (js-call assert :equal (funcall (aref e "last-error")) 0 name)
                           value)))
             (receiver (funcall raw-call "value-object-new" 0))
             (text (funcall raw-call "value-string" 21))
             (sym (funcall raw-call "value-symbol-well-known" 0))
             (held (funcall raw-call "value-number" 0 2147483648))
             (frame (funcall raw-call "frame-new" 1)))
        (funcall raw-call "heap-pin" receiver)
        (funcall raw-call "heap-pin" text)
        (let ((i 0))
          (while (< i 21)
            (funcall raw-call "value-unit-set" text i 120)
            (setq i (+ i 1))))
        (funcall raw-call "value-seal" text)
        (funcall raw-call "heap-pin" sym)
        (funcall raw-call "frame-set" frame 0 held)
        (funcall raw-call "heap-auto" 1)
        (let* ((snapshot (lambda ()
                           (js-array
                             (funcall raw-call "heap-used")
                             (funcall raw-call "heap-live")
                             (funcall raw-call "heap-collections")
                             (funcall raw-call "frame-depth"))))
               (check (lambda ()
                        (let ((before (funcall snapshot)))
                          (js-call (js-array 1 2 receiver held) :forEach
                            (lambda (owner)
                              (js-call (js-array text sym) :forEach
                                (lambda (key)
                                  (js-call assert :equal (funcall raw-call "value-source-access-key" owner key) key)))))
                          (js-call assert :deepEqual (funcall snapshot) before)
                          (js-call assert :equal (funcall raw-call "frame-get" frame 0) held))))
               (fillers (js-array)))
          (funcall check)
          (while (< (funcall raw-call "heap-live") 64)
            (let ((value (funcall raw-call "value-number" 0 0)))
              (funcall raw-call "heap-pin" value)
              (js-call fillers :push value)))
          (funcall check)
          (js-call (js-call (js-array text sym receiver) :concat fillers) :forEach
            (lambda (value) (funcall raw-call "heap-release" value)))
          (funcall raw-call "frame-pop" frame)
          (funcall raw-call "heap-collect")
          (js-call assert :equal (funcall raw-call "heap-live") 0)
          (js-call assert :equal (funcall raw-call "frame-depth") 0)))))

  (test "allocation-free access-key validation rejects unsealed stale invalid and private handles without disturbing caller roots"
    (lambda ()
      (let* ((inst (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (make-artifact))))
             (e (get inst :exports))
             (h (funcall (aref e "heap-new") 64 16384 131072))
             (raw-call (lambda (name &rest args)
                         (let ((value (unsigned-bit-shift-right (js-call (aref e name) :apply nil (js-call (js-array h) :concat args)) 0)))
                           (js-call assert :equal (funcall (aref e "last-error")) 0 name)
                           value)))
             (receiver (funcall raw-call "value-object-new" 0))
             (good (funcall raw-call "value-string" 1))
             (unsealed (funcall raw-call "value-string" 1))
             (stale (funcall raw-call "value-string" 1))
             (frame (funcall raw-call "frame-new" 1))
             (fillers (js-array)))
        (funcall raw-call "heap-pin" receiver)
        (funcall raw-call "heap-pin" good)
        (funcall raw-call "heap-pin" unsealed)
        (funcall raw-call "value-unit-set" good 0 120)
        (funcall raw-call "value-seal" good)
        (funcall raw-call "heap-collect")
        (funcall raw-call "frame-set" frame 0 receiver)
        (funcall raw-call "heap-auto" 1)
        (while (< (funcall raw-call "heap-live") 64)
          (let ((value (funcall raw-call "value-number" 0 0)))
            (funcall raw-call "heap-pin" value)
            (js-call fillers :push value)))
        (let ((before (js-array (funcall raw-call "heap-used") (funcall raw-call "heap-live") (funcall raw-call "heap-collections"))))
          (js-call
            (js-array
              (js-array receiver unsealed 6)
              (js-array receiver stale 1)
              (js-array receiver 4294967295 1)
              (js-array receiver frame 3)
              (js-array 4294967295 good 1)
              (js-array frame good 3))
            :forEach
            (lambda (item)
              (js-call assert :equal (funcall (aref e "value-source-access-key") h (aref item 0) (aref item 1)) 0)
              (js-call assert :equal (funcall (aref e "last-error")) (aref item 2))
              (js-call assert :deepEqual
                (js-array (funcall raw-call "heap-used") (funcall raw-call "heap-live") (funcall raw-call "heap-collections"))
                before)
              (js-call assert :equal (funcall raw-call "frame-depth") 1)
              (js-call assert :equal (funcall raw-call "frame-get" frame 0) receiver)))
          (js-call (js-call (js-array good unsealed receiver) :concat fillers) :forEach
            (lambda (value) (funcall raw-call "heap-release" value)))
          (funcall raw-call "frame-pop" frame)
          (funcall raw-call "heap-collect")
          (js-call assert :equal (funcall raw-call "heap-live") 0)
          (js-call assert :equal (funcall raw-call "frame-depth") 0))))))
