(module tests.pages-runtime.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "playwright-core" chromium)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../tools/pages/assemble.mjs" assemblePages)
  (import "./helpers/pages-build.mjs" buildPagesInputs)
  (import "../tools/browser/matrix.mjs" serveTree)
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst PORT 8902)
  (defvar staging undefined) (defvar artifact undefined) (defvar server undefined) (defvar available t)
  (defasync browserAvailable ()
    (try (let ((browser (await (js-call chromium :launch)))) (await (js-call browser :close)) t)
      (catch ignored false)))
  (beforeAll (async ()
    (await (buildPagesInputs))
    (setq staging (await (mkdtemp (resolve ROOT ".eliscript-pages-runtime-"))))
    (setq artifact (resolve staging "site"))
    (await (assemblePages (js-object :root ROOT :outDir artifact)))
    (setq server (await (serveTree artifact PORT)))
    (setq available (await (browserAvailable)))))
  (afterAll (async ()
    (unless (nullish? server) (js-call server :stop))
    (unless (nullish? staging) (await (rm staging (js-object :recursive t :force t))))))
  ;; These callbacks are native DOM reads executed by Playwright in its browser realm.
  (defconst has-browser-output (js* "() => { const stdout = document.querySelector('#stdout'); const diagnostics = document.querySelector('#diagnostics'); return (stdout?.textContent.trim().length ?? 0) > 0 || (diagnostics?.textContent.trim().length ?? 0) > 0; }"))
  (defconst read-browser-output (js* "() => ({ stdout: document.querySelector('#stdout')?.textContent.trim() ?? '', diagnostics: document.querySelector('#diagnostics')?.textContent.trim() ?? '' })"))
  (test "the deployed playground compiles and runs in a real browser" (async ()
    (when available
      (let ((browser (await (js-call chromium :launch))))
        (try
          (let ((page (await (js-call browser :newPage))) (failed (js-array)))
            (js-call page :on "response" (lambda (response)
              (when (>= (js-call response :status) 400) (js-call failed :push (str (js-call response :status) " " (js-call response :url))))))
            (js-call page :on "pageerror" (lambda (error) (js-call failed :push (js-call (funcall globalThis.String error) :slice 0 160))))
            (await (js-call page :goto (str (get server :origin) "pages/playground.html") (js-object :waitUntil "networkidle")))
            (await (js-call (js-call page :locator "#run") :click))
            (await (js-call (js-call page :waitForFunction has-browser-output (js-object :timeout 20000)) :catch (lambda () nil)))
            (let ((output (await (js-call page :evaluate read-browser-output))))
              (js-call (expect failed) :toEqual (js-array))
              (js-call (get (expect (get output :diagnostics)) :not) :toContain "is not built")
              (js-call (expect (get output :diagnostics)) :toBe "")
              (js-call (expect (get (get output :stdout) :length)) :toBeGreaterThan 0)))
          (finally (await (js-call browser :close))))))))
  (test "the deployed documentation index is the site root" (async ()
    (let* ((response (await (globalThis/fetch (str (get server :origin))))) (html (await (js-call response :text))))
      (js-call (expect (get response :status)) :toBe 200)
      (js-call (expect html) :toContain "<!doctype html>")
      (js-call (expect html) :toContain "pages/"))))
)
