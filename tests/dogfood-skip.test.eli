(module
  tests.dogfood-skip.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" cp mkdtemp readFile readdir rm stat writeFile)
  (import "node:path" join resolve)
  (import "../runtime/literals.mjs" hashMap keyword vector)
  (import "../runtime/core/collection.mjs" :as collection-mod)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    DEMO
    (resolve ROOT "examples/dogfood/_demo"))
  (defconst
    state
    (js-object :staging nil :program nil :preflight nil :events nil :project nil :bundle nil))
  (defun
    k
    (name)
    (keyword name))
  (defun
    mapOf
    (entries)
    (let*
      ((flat (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((pair (aref entries (get idx :i))))
          (js-call flat :push (k (aref pair 0)))
          (js-call flat :push (aref pair 1)))
        (put idx :i (+ (get idx :i) 1)))
      (apply hashMap flat)))
  (defasync
    run
    (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let*
      ((opts (or options (js-object))) (env (js-call globalThis.Object :assign (js-object) (get globalThis.process :env) (or (get opts :env) (js-object)))) (child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe" :env env))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2)))))
  (defasync
    react
    (eventName payload &rest __host_forwarded_arguments_2)
    (let* ((extra (aref __host_forwarded_arguments_2 0)))
    (let*
      ((ext (or extra (js-array))) (suffix (js-call ext :join "")) (staging (get state :staging)) (eventFile (join staging (str "event-" eventName "-" suffix ".json"))) (outputFile (join staging (str "outputs-" eventName "-" suffix ".txt"))) (__ign_13 (await (writeFile eventFile (js-call globalThis.JSON :stringify payload) "utf8"))) (__ign_14 (await (writeFile outputFile "" "utf8"))) (cmd (js-call (js-array (get globalThis.process :execPath) (get state :program) "--root" (get state :project) "--output" "site" "--browser-bundle" (get state :bundle) "--event-file" eventFile) :concat ext)) (result (await (run cmd (js-object :env (js-object :GITHUB_EVENT_NAME eventName :GITHUB_OUTPUT outputFile))))))
      (js-call globalThis.Object :assign (js-object) result (js-object :outputs (await (readFile outputFile "utf8")))))))
  (defasync
    exists
    (path)
    (try
      (progn
        (await (stat path))
        t)
      (catch
        _
        false)))
  (defasync
    mtime
    (path)
    (get (await (stat path)) :mtimeMs))
  (defconst
    MARKDOWN_SOURCE
    "{:id :posts :kind :markdown :enabled t :directory \"content/posts\"}")
  (defconst
    REMOTE_SOURCE
    "{:id :notes :kind :issues :enabled t :repository \"owner/repository\" :label \"published\"}")
  (defun
    config
    (&rest __host_forwarded_arguments_3)
    (let* ((sources (aref __host_forwarded_arguments_3 0)))
    (let*
      ((srcs (or sources (str "[" MARKDOWN_SOURCE " " REMOTE_SOURCE "]"))))
      (str "(module dogfood.config\n  (defconst config\n    {:schema-version 1\n     :site {:title \"T\" :base-url \"https://example.github.io/t/\" :language \"en\"}\n     :sources " srcs "\n     :publishing {:owner {:login \"owner\" :id \"U_owner\"} :coauthors []}\n     :adapters\n     [{:id :utterances :carrier-kind :issue\n       :principal \"utterances-bot\" :marker \"Canonical post: \"}]\n     :identity {:conflict :fail :projections []}\n     :comments {:presentation :tabs :channels []}\n     :refresh {:articles :hybrid :comments :runtime :no-change :skip}\n     :output {:directory \"site\"}})\n  (export config))\n"))))
  (defasync
    useSources
    (sources)
    (await (writeFile (join (get state :project) "dogfood.config.eli") (config sources) "utf8")))
  (defun
    issuePayload
    (&rest __host_forwarded_arguments_4)
    (let* ((over (aref __host_forwarded_arguments_4 0)))
    (js-object :repository (js-object :full_name "owner/repository") :issue (js-call globalThis.Object :assign (js-object :number 42 :labels (js-array (js-object :name "published")) :user (js-object :login "owner" :id "U_owner" :type "User") :body "An article body.") (or over (js-object))))))
  (defconst
    configForDecision
    (mapOf (js-array (js-array "sources" (vector (mapOf (js-array (js-array "id" (k "notes")) (js-array "kind" (k "issues")) (js-array "enabled" t) (js-array "repository" "owner/repository") (js-array "label" "published"))))) (js-array "publishing" (mapOf (js-array (js-array "owner" (mapOf (js-array (js-array "login" "owner") (js-array "id" "U_owner")))) (js-array "coauthors" (vector (mapOf (js-array (js-array "login" "writer")))))))) (js-array "adapters" (vector (mapOf (js-array (js-array "id" (k "utterances")) (js-array "carrier-kind" (k "issue")) (js-array "principal" "utterances-bot") (js-array "marker" "Canonical post: "))))))))
  (defun
    decide
    (eventName payload)
    (let*
      ((decision (js-call (get state :preflight) :skip_decision configForDecision (js-call (get state :events) :classify_event eventName payload))))
      (js-object :skip (js-call collection-mod :get decision (k "skip") nil) :detail (js-call collection-mod :get decision (k "detail") ""))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-skip-")))) (__ign_15 (put state :staging staging)) (built (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (join staging "build") "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get built :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get built :stderr) :trim) (js-call (get built :stdout) :trim)))))
        (put state :program (join staging "build/src/builder/main.mjs"))
        (put state :preflight (await (funcall (js* "(u) => import(u)") (join staging "build/src/builder/preflight.mjs"))))
        (put state :events (await (funcall (js* "(u) => import(u)") (join staging "build/src/builder/events.mjs"))))
        (let*
          ((bundle (join staging "browser.js")) (project (join staging "project")))
          (put state :bundle bundle)
          (put state :project project)
          (await (writeFile bundle "(() => {})();\n" "utf8"))
          (await (cp DEMO project (js-object :recursive t)))
          (await (useSources (str "[" MARKDOWN_SOURCE " " REMOTE_SOURCE "]")))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "a publishable record is not skipped" (lambda () (js-call (expect (get (decide "issues" (issuePayload)) :skip)) :toBe false) (js-call (expect (get (decide "issues" (issuePayload (js-object :user (js-object :login "writer" :id 7)))) :skip)) :toBe false) (js-call (expect (get (decide "push" (js-object :repository (js-object :full_name "owner/repository"))) :skip)) :toBe false) (js-call (expect (get (decide "schedule" (js-object)) :skip)) :toBe false)))
  (test "a record that cannot be published is skipped with its reason" (lambda () (let*
        ((cases (js-array (js-array (issuePayload (js-object :pull_request (js-object))) "pull request") (js-array (issuePayload (js-object :labels (js-array))) "not labelled") (js-array (issuePayload (js-object :user (js-object :login "stranger" :id 9))) "not a publisher") (js-array (issuePayload (js-object :user (js-object :login "owner" :id "U_other"))) "not a publisher") (js-array (issuePayload (js-object :user (js-object :login "utterances-bot" :id 5) :body "Canonical post: notes/x")) "comment carrier"))) (idx (js-object :i 0)))
        (while
          (< (get idx :i) (get cases :length))
          (let*
            ((pair (aref cases (get idx :i))) (payload (aref pair 0)) (expected (aref pair 1)) (decision (decide "issues" payload)))
            (js-call (expect (get decision :skip)) :toBe t)
            (js-call (expect (get decision :detail)) :toContain expected))
          (put idx :i (+ (get idx :i) 1)))
        (let*
          ((other (decide "issues" (js-object :repository (js-object :full_name "other/repo") :issue (get (issuePayload) :issue)))))
          (js-call (expect (get other :skip)) :toBe t)
          (js-call (expect (get other :detail)) :toContain "no enabled issues source")))))
  (test "an unauthorized article event ends the run without building" (async () (let*
        ((project (get state :project)) (result (await (react "issues" (issuePayload (js-object :user (js-object :login "stranger" :id 9)))))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (js-call (expect (get result :outputs)) :toContain "built=false")
        (js-call (expect (get result :outputs)) :toContain "reason=skipped")
        (js-call (expect (get result :stdout)) :toContain "skipped")
        (js-call (expect (await (exists (join project "site")))) :toBe false)
        (js-call (expect (await (exists (join project "site.staging")))) :toBe false))))
  (test "a pull request event ends the run the same way" (async () (let*
        ((result (await (react "issues" (issuePayload (js-object :pull_request (js-object :url "x")))))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (js-call (expect (get result :outputs)) :toContain "reason=skipped")
        (js-call (expect (await (exists (join (get state :project) "site")))) :toBe false))))
  (test "an unchanged build is reported without rendering or writing" (async () (await (useSources (str "[" MARKDOWN_SOURCE "]"))) (let*
        ((project (get state :project)) (first (await (react "push" (js-object :repository (js-object :full_name "owner/repository"))))))
        (js-call (expect (get first :exitCode)) :toBe 0)
        (js-call (expect (get first :outputs)) :toContain "built=true")
        (let*
          ((page (join project "site/index.html")) (manifest (join project "site/_dogfood/build.json")) (pageTime (await (mtime page))) (manifestTime (await (mtime manifest))))
          (await (new globalThis.Promise (lambda (res) (globalThis.setTimeout res 1100))))
          (let*
            ((second (await (react "push" (js-object :repository (js-object :full_name "owner/repository"))))))
            (js-call (expect (get second :exitCode)) :toBe 0)
            (js-call (expect (get second :outputs)) :toContain "built=false")
            (js-call (expect (get second :outputs)) :toContain "reason=no-change")
            (js-call (expect (get second :stdout)) :toContain "no change")
            (js-call (expect (await (mtime page))) :toBe pageTime)
            (js-call (expect (await (mtime manifest))) :toBe manifestTime))))))
  (test "a forced run renders even when the inputs are unchanged" (async () (await (useSources (str "[" MARKDOWN_SOURCE "]"))) (let*
        ((forced (await (react "push" (js-object :repository (js-object :full_name "owner/repository")) (js-array "--force")))))
        (js-call (expect (get forced :exitCode)) :toBe 0)
        (js-call (expect (get forced :outputs)) :toContain "built=true")
        (js-call (expect (get forced :outputs)) :toContain "reason=forced"))))
  (test "a changed input is rendered" (async () (await (useSources (str "[" MARKDOWN_SOURCE "]"))) (let*
        ((project (get state :project)) (before (await (readFile (join project "site/_dogfood/build.json") "utf8"))) (welcome-path (join project "content/posts/0001-welcome.md")) (__ign_16 (await (writeFile welcome-path (str (await (readFile welcome-path "utf8")) "\nA new line.\n") "utf8"))) (result (await (react "push" (js-object :repository (js-object :full_name "owner/repository"))))) (after (await (readFile (join project "site/_dogfood/build.json") "utf8"))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (js-call (expect (get result :outputs)) :toContain "built=true")
        (js-call (expect (get result :outputs)) :toContain "reason=changed")
        (js-call (get (expect after) :not) :toBe before))))
  (test "the fingerprint decides, not the clock" (async () (await (useSources (str "[" MARKDOWN_SOURCE "]"))) (let*
        ((runs (js-array)) (idx (js-object :i 0)))
        (while
          (< (get idx :i) 3)
          (let*
            ((result (await (react "push" (js-object :repository (js-object :full_name "owner/repository"))))))
            (js-call (expect (get result :exitCode)) :toBe 0)
            (js-call runs :push (get result :outputs)))
          (put idx :i (+ (get idx :i) 1)))
        (js-call (expect (aref runs 1)) :toContain "reason=no-change")
        (js-call (expect (aref runs 2)) :toContain "reason=no-change")
        (let*
          ((fingerprints (js-call runs :map (lambda (outputs) (aref (js-call (new globalThis.RegExp "content-fingerprint=([0-9a-f]{64})" "u") :exec outputs) 1)))))
          (js-call (expect (get (new globalThis.Set fingerprints) :size)) :toBe 1)))))
  (test "the manifest records the digest that decided the run" (async () (await (useSources (str "[" MARKDOWN_SOURCE "]"))) (let*
        ((manifest (js-call globalThis.JSON :parse (await (readFile (join (get state :project) "site/_dogfood/build.json") "utf8")))))
        (js-call (expect (get manifest :inputDigest)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))
        (js-call (expect (get manifest :contentFingerprint)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))
        (js-call (get (expect (get manifest :inputDigest)) :not) :toBe undefined))))
  (test "the files a build publishes are the ones it listed" (async () (await (useSources (str "[" MARKDOWN_SOURCE "]"))) (let*
        ((entries (await (readdir (join (get state :project) "site")))))
        (js-call (expect entries) :toContain "index.html")
        (js-call (expect entries) :toContain "_dogfood")
        (js-call (get (expect entries) :not) :toContain "site.staging")))))
