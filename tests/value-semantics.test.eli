(module tests.value-semantics
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (import "../runtime/core/vector.mjs" EMPTY_VECTOR persistentVector)
  (import "../runtime/testing/value.mjs" clearValueHashCaches resetValueHashMetrics valueHashMetrics)
  (import "./helpers/portable-structure.mjs" nextRandom)
  (defconst host-truth (js* "(value) => !!value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun vectorRange (count)
    (let ((result EMPTY_VECTOR) (value 0))
      (while (< value count) (setq result (js-call result :conj value) value (1+ value))) result))
  (defasync runHost (command source)
    (let* ((child (Bun/spawn (js-array command source) (js-object :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (unless (= (aref result 0) 0)
        (let ((err (js-call (aref result 2) :trim))) (throw (new globalThis.Error (if (funcall host-truth err) err (str command " exited with " (aref result 0)))))))
      (JSON/parse (aref result 1))))
  (test "value equality and hashing freeze scalar edge semantics" (lambda ()
    (js-call (js-array (js-array nil nil) (js-array undefined undefined) (js-array false false) (js-array 0 (js* "-0"))
      (js-array globalThis.Number.NaN globalThis.Number.NaN) (js-array globalThis.Number.POSITIVE_INFINITY globalThis.Number.POSITIVE_INFINITY)
      (js-array "值语义🙂" "值语义🙂") (js-array (js* "12345678901234567890n") (js* "12345678901234567890n"))
      (js-array (js-call globalThis.Symbol :for "eliscript/value") (js-call globalThis.Symbol :for "eliscript/value"))) :forEach (lambda (pair)
        (let ((left (aref pair 0)) (right (aref pair 1)))
          (be (equalValues left right) t) (be (hashValue left) (hashValue right))
          (js-call (expect (hashValue left)) :toBeGreaterThanOrEqual 0)
          (js-call (expect (hashValue left)) :toBeLessThanOrEqual 4294967295))))
    (js-call (js-array (js-array nil undefined) (js-array false 0) (js-array 1 (js* "1n")) (js-array "1" 1)
      (js-array globalThis.Number.NaN 0) (js-array (funcall globalThis.Symbol "same") (funcall globalThis.Symbol "same"))) :forEach
      (lambda (pair) (be (equalValues (aref pair 0) (aref pair 1)) false)))))
  (test "hash collisions never imply value equality" (lambda ()
    (let ((left "key-50691") (right "key-194634"))
      (be (hashValue left) 2357254775) (be (hashValue right) 2357254775) (be (equalValues left right) false))))
  (test "host objects retain identity equality and process-local hashes" (lambda ()
    (clearValueHashCaches)
    (let ((left (js-object :value 1)) (right (js-object :value 1)) (array (js-array 1 2 3)) (localSymbol (funcall globalThis.Symbol "local")) (callable (lambda () 1)))
      (be (equalValues left left) t) (be (equalValues left right) false) (be (equalValues array (js-array 1 2 3)) false)
      (be (hashValue left) (hashValue left)) (js-call (get (expect (hashValue left)) :not) :toBe (hashValue right))
      (be (hashValue localSymbol) (hashValue localSymbol)) (be (hashValue callable) (hashValue callable))
      (be (get (valueHashMetrics) :hostIdentityAssignments) 4))))
  (test "persistent vectors use recursive value equality and ordered hashes" (lambda ()
    (let* ((sharedHost (js-object :opaque t))
           (left (persistentVector 1 "two" globalThis.Number.NaN (persistentVector nil undefined (js* "-0")) sharedHost))
           (right (persistentVector 1 "two" globalThis.Number.NaN (persistentVector nil undefined 0) sharedHost)))
      (be (equalValues left right) t) (be (hashValue left) (hashValue right))
      (be (equalValues left (js-call right :assoc 1 "changed")) false) (be (equalValues left (js-call left :pop)) false)
      (be (equalValues left (js-call left :toArray)) false) (be (equalValues left (js-call right :assoc 4 (js-object :opaque t))) false))))
  (test "equal generated vectors always have equal hashes" (lambda ()
    (let ((random (js-object :value 12648430)) (sample 0))
      (while (< sample 1000)
        (let ((count (% (nextRandom random) 96)) (values (js-array)) (index 0))
          (while (< index count)
            (let ((value (nextRandom random)))
              (js-call values :push (if (= (% index 11) 0) (persistentVector value (% value 17) (str "v" (% value 31))) value)))
            (setq index (1+ index)))
          (let ((left (apply persistentVector values))
                (right (apply persistentVector (js-call values :map (lambda (value)
                  (if (= (if (nullish? value) undefined (get value :toArray)) undefined) value (apply persistentVector (js-call value :toArray))))))))
            (be (equalValues left right) t) (be (hashValue left) (hashValue right))))
        (setq sample (1+ sample))))))
  (test "persistent vector hashes are cached without changing values" (lambda ()
    (clearValueHashCaches)
    (let* ((values (vectorRange 10000)) (first (hashValue values)))
      (same (valueHashMetrics) (js-object :hashValueCalls 10001 :protocolHashComputations 1 :protocolHashCacheHits 0 :hostIdentityAssignments 0))
      (resetValueHashMetrics) (be (hashValue values) first)
      (same (valueHashMetrics) (js-object :hashValueCalls 1 :protocolHashComputations 0 :protocolHashCacheHits 1 :hostIdentityAssignments 0))
      (let ((updated (js-call values :assoc 5000 -1)))
        (js-call (get (expect (hashValue updated)) :not) :toBe first) (be (js-call values :nth 5000) 5000)))))
  (test "persistent vector hashing remains linear and cached at one million values" (lambda ()
    (clearValueHashCaches)
    (let* ((values (vectorRange 1000000)) (first (hashValue values)))
      (be (Number/isInteger first) t) (be (get (valueHashMetrics) :hashValueCalls) 1000001) (be (get (valueHashMetrics) :protocolHashComputations) 1)
      (resetValueHashMetrics) (be (hashValue values) first)
      (same (valueHashMetrics) (js-object :hashValueCalls 1 :protocolHashComputations 0 :protocolHashCacheHits 1 :hostIdentityAssignments 0)))) 30000)
  (test "value hashes match the frozen Bun and Node fixture" (async ()
    (let* ((source (fileURLToPath (new globalThis.URL "fixtures/value-hash-host.mjs" (js* "import.meta.url"))))
           (expectedFile (fileURLToPath (new globalThis.URL "fixtures/value-hashes.json" (js* "import.meta.url"))))
           (expected (JSON/parse (await (readFile expectedFile "utf8"))))
           (reports (await (Promise/all (js-array (runHost "bun" source) (runHost (get (get globalThis.process :env) :NODE "node") source))))))
      (same (aref reports 0) expected) (same (aref reports 1) expected))))
)
