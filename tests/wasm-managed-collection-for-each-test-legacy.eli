(module capsules.tests.wasm-managed-collection-for-each-test-legacy
  (js* "import {beforeAll, afterAll, test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {readFile, mkdtemp, rm} from 'node:fs/promises';\nimport {resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nimport {readFileSync} from 'node:fs';\nimport {spawnSync} from 'node:child_process';\nimport {buildBackends} from '../tools/backends/build.mjs';\nimport {instantiateManagedRuntime} from '../tools/backends/managed-runtime.mjs';\nlet directory, b, runtime, program, bytes, js;\nbeforeAll(async () => {\n  directory = await mkdtemp(resolve(tmpdir(), 'eliscript-collection-foreach-'));\n  b = await buildBackends({outputRoot: directory});\n  runtime = b.compiler.compile_ir_string(await readFile('bootstrap/runtime/memory.eli', 'utf8'), 'runtime.eli');\n  program = b.compiler.compile_ir_string(await readFile('tests/fixtures/wasm-managed-source-collections.eli', 'utf8'), 'source-collections.eli');\n  const before = JSON.stringify(program);bytes = Uint8Array.from(b.managed.emit_managed_wasm(program, runtime));assert.equal(JSON.stringify(program), before);\n  assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(bytes)), []);\n  js = await import('data:text/javascript;base64,' + Buffer.from(b.compiler.emit_ir_string(program)).toString('base64'));\n}, 120000);\nafterAll(async () => {if (directory) await rm(directory, {recursive: true, force: true});});\nfunction instance(options) {const a = instantiateManagedRuntime(bytes, options);a.auto(1);return a;}\nfunction read(a, value) {\n  if (value === null || typeof value !== 'object') return value;\n  if (value.kind === 4) return a.readNumber(value);if (value.kind === 5) return a.readString(value);\n  assert.equal(value.kind, 14);return Array.from({length: a.length(value)}, (_, i) => {const x = a.get(value, i);try {return read(a, x);} finally {a.release(x);}});\n}\nfunction call(a, name, args = []) {const out = a.invoke(name, args);try {return read(a, out);} finally {a.release(out);}}\nfunction finish(a, values = []) {values.forEach(x => a.release(x));a.collect();assert.equal(a.live(), 0);assert.equal(a.stats().frameDepth, 0);}\nfunction populate(a, set, values) {\n  const items = a.invoke(set ? 'empty-set' : 'empty-map');\n  values.forEach((v, i) => {const value = typeof v === 'number' ? a.number(v) : typeof v === 'string' ? a.string(v) : v, key = a.number(i), out = a.invoke(set ? 'add-value' : 'set-value', set ? [items, value] : [items, key, value]);for (const x of [value, key, out]) a.release(x);});return items;\n}\ntest('Given Map and Set values, when forEach executes, then exactly value key receiver are supplied and return values are ignored', () => {\n  for (const set of [false, true]) {const a = instance(), values = [undefined, null, false, true, -0, NaN, Number.MIN_VALUE, '中😀'], items = populate(a, set, values), log = a.sourceArray([]), control = set ? new Set(values) : new Map(values.map((v, i) => [i, v])), expected = [];\n    assert.equal(control.forEach((v, k, receiver) => {expected.push([v, k, receiver === control]);return 123;}), undefined);\n    assert.equal(call(a, 'visit', [items, log]), undefined);assert.deepEqual(read(a, log), expected);assert(a.stats().collections > 0);finish(a, [items, log]);}\n});\ntest('Given deletion reinsert clear append and value replacement, when collection forEach iterates, then each live mutation matches JS', () => {\n  const a = instance();for (const set of [false, true]) for (const mode of [0, 1, 2, 3]) {const n = a.number(mode);assert.deepEqual(call(a, 'for-each-mutate', [set, n]), js.for_each_mutate(set, mode));a.release(n);}finish(a);\n});\ntest('Given empty Map and Set receivers, when callbacks are missing or noncallable, then validation fails before iteration and later calls recover', () => {\n  const a = instance();for (const set of [false, true]) {const items = populate(a, set, []), log = a.sourceArray([]), callback = a.invoke('record-callback', [log]);for (const value of [undefined, null, false, true, a.number(0), a.string('bad')]) {assert.throws(() => a.invoke('for-each-with', [items, value]), e => e.eliscriptDiagnostic?.code === 'ELI-RT0003');a.release(value);assert.equal(a.stats().frameDepth, 0);}assert.equal(call(a, 'for-each-with', [items, callback]), undefined);assert.deepEqual(read(a, log), []);for (const x of [items, log, callback]) a.release(x);}finish(a);\n});\ntest('Given own and inherited forEach methods, when arguments replace them, then captured methods run after every argument effect', () => {\n  const a = instance();for (const set of [false, true]) {const items = populate(a, set, [true, false]), trace = a.sourceArray([false]), log = a.sourceArray([]);assert.equal(call(a, 'for-each-builtin-capture', [items, log, trace]), undefined);assert.deepEqual(read(a, log), [[true, set ? true : 0, true], [false, set ? false : 1, true]]);assert.deepEqual(read(a, trace), [9]);assert.throws(() => a.invoke('visit', [items, log]), e => e.eliscriptDiagnostic?.code === 'ELI-RT0003');assert.deepEqual(call(a, 'for-each-own-capture', [items, trace]), ['captured', 1]);for (const x of [items, trace, log]) a.release(x);}finish(a);\n});\ntest('Given reentrant iteration on one collection, when a callback enters forEach again, then independent cursors retain outer order', () => {\n  const a = instance();for (const set of [false, true]) {const values = [3, 1, 2], items = populate(a, set, values), control = set ? new Set(values) : new Map(values.map((v, i) => [i, v]));assert.deepEqual(call(a, 'for-each-reentrant', [items]), js.for_each_reentrant(control));a.release(items);}finish(a);\n});\ntest('Given a failing callback, when a collection iteration aborts, then preceding effects and caller frames survive and later callbacks recover', () => {\n  const a = instance();for (const set of [false, true]) {const items = populate(a, set, [7, 8]), marker = a.sourceArray([false]), frame = a.frame(1);a.frameSet(frame, 0, items);assert.throws(() => a.invoke('for-each-fail', [items, marker]), e => e.eliscriptDiagnostic?.code === 'ELI-RT0003');assert.deepEqual(read(a, marker), [7]);assert.equal(a.stats().frameDepth, 1);const kept = a.frameGet(frame, 0);assert(a.keyEqual(kept, items));a.release(kept);a.leaveFrame(frame);const log = a.sourceArray([]);assert.equal(call(a, 'visit', [items, log]), undefined);assert.equal(a.length(log), 2);for (const x of [items, marker, log]) a.release(x);}finish(a);\n});\n\ntest('Given callback allocation pressure, when live iteration exhausts capacity, then prior effects remain and only private roots unwind', () => {\n  for (const set of [false, true]) {const a = instance({maxSlots: 192, initialBytes: 65536, maxBytes: 262144}), values = set ? Array.from({length: 128}, (_, i) => i) : Array(128).fill(true), items = populate(a, set, values), log = a.sourceArray([]), callback = a.invoke('record-callback', [log]), caller = a.frame(1);a.frameSet(caller, 0, items);\n    assert.throws(() => a.invoke('for-each-with', [items, callback]), e => e.eliscriptDiagnostic?.code === 'ELI-RT0002');assert(a.length(log) > 0 && a.length(log) < 128);assert.equal(a.stats().frameDepth, 1);const held = a.frameGet(caller, 0);assert(a.keyEqual(held, items));a.release(held);a.leaveFrame(caller);finish(a, [items, log, callback]);}\n});\ntest('Given a real iterator trap, when collection forEach aborts, then outer roots remain valid and the original failure is preserved', () => {\n  const source = readFileSync('bootstrap/runtime/memory.eli', 'utf8'), start = source.indexOf('  (defun value-iterator-value (heap iterator)'), end = source.indexOf('  (defun ', start + 10);assert(start >= 0 && end > start);\n  const injected = b.compiler.compile_ir_string(source.slice(0, start) + '  (defun value-iterator-value (heap iterator) (load-u32 4294967295))\\n' + source.slice(end), 'collection-foreach-trap.eli');\n  const a = instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_wasm(program, injected)));a.auto(1);const items = populate(a, false, [true]), log = a.sourceArray([]), callback = a.invoke('record-callback', [log]), caller = a.frame(1);a.frameSet(caller, 0, items);\n  assert.throws(() => a.invoke('for-each-with', [items, callback]), WebAssembly.RuntimeError);assert.equal(a.stats().frameDepth, 1);const held = a.frameGet(caller, 0);assert(a.keyEqual(held, items));a.release(held);assert.deepEqual(read(a, log), []);assert.throws(() => a.invoke('for-each-with', [items, false]), e => e.eliscriptDiagnostic?.code === 'ELI-RT0003');assert.equal(a.stats().frameDepth, 1);a.leaveFrame(caller);finish(a, [items, log, callback]);\n});\ntest('Given malformed raw references, when collection forEach validates them, then invalid-handle errors do not become WASM traps', () => {\n  const e = new WebAssembly.Instance(new WebAssembly.Module(bytes)).exports, heap = e['heap-new'](32, 4096, 65536), items = e['value-source-collection-new'](heap, 15, 3), caller = e['frame-new'](heap, 1);assert(items);e['frame-set'](heap, caller, 0, items);\n  assert.equal(e['value-source-collection-for-each'](heap, items, 0xffffffff), 0);assert.equal(e['last-error'](), 1);assert.equal(e['frame-depth'](heap), 1);\n  assert.equal(e['value-source-collection-for-each'](heap, 0xffffffff, 3), 0);assert.equal(e['last-error'](), 1);assert.equal(e['frame-depth'](heap), 1);e['frame-pop'](heap, caller);e['heap-collect'](heap);assert.equal(e['heap-live'](heap), 0);\n});\ntest('Given fixed random mutation scripts, when Map and Set callbacks mutate their live tables, then independent JS and WASM traces agree exactly', () => {\n  const a = instance();let state = 0x2d7e3f91;const next = () => state = (Math.imul(state, 1664525) + 1013904223) >>> 0;\n  const box = value => {if (Array.isArray(value)) {const children = value.map(box), result = a.sourceArray(children);children.forEach(x => a.release(x));return result;}return a.number(value);};\n  for (let trial = 0; trial < 64; trial++) {const actions = Array.from({length: 8}, () => Array.from({length: next() % 4}, () => [next() % 4, next() % 7, (next() % 129) - 64])), input = box(actions);\n    for (const set of [false, true]) assert.deepEqual(call(a, 'for-each-actions', [set, input]), js.for_each_actions(set, actions));a.release(input);a.collect();assert.equal(a.live(), 0);assert.equal(a.stats().frameDepth, 0);}\n  finish(a);\n});\ntest('Given Node and the identical zero-import artifact, when both collection callback families run, then argument identity and live mutations match that engine', () => {\n  const result = spawnSync('node', ['--input-type=module', '-e', `\n    import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {instantiateManagedRuntime} from ${JSON.stringify(resolve('tools/backends/managed-runtime.mjs'))};\n    const a=instantiateManagedRuntime(readFileSync(0));a.auto(1);\n    const read=x=>{if(x===null||typeof x!=='object')return x;if(x.kind===4)return a.readNumber(x);if(x.kind===5)return a.readString(x);return Array.from({length:a.length(x)},(_,i)=>{const child=a.get(x,i);try{return read(child)}finally{a.release(child)}})};\n    for(const set of[false,true]){const values=[-0,NaN,Number.MIN_VALUE],control=set?new Set(values):new Map(values.map((v,i)=>[i,v])),items=a.invoke(set?'empty-set':'empty-map');for(let i=0;i<values.length;i++){const key=a.number(i),value=a.number(values[i]),out=a.invoke(set?'add-value':'set-value',set?[items,value]:[items,key,value]);for(const x of[key,value,out])a.release(x)}const log=a.sourceArray([]),out=a.invoke('visit',[items,log]),expected=[];control.forEach((v,k,c)=>expected.push([v,k,c===control]));assert.equal(out,undefined);assert.deepEqual(read(log),expected);a.release(log);a.release(items);a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0)}\n  `], {input: Buffer.from(bytes), encoding: 'utf8', timeout: 30000});assert.equal(result.status, 0, result.stderr);\n});\n"))
