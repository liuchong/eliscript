(module tests.compiler-corpus-arguments.test
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" mkdtemp writeFile rm readFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "node:crypto" createHash)
  (import "../tools/backends/compiler-corpus-execution.mjs" originalProgramArguments executeCompilerCorpusRecord)
  (import "../tools/backends/compiler-session.mjs" encodeCompilerIR encodeCompilerSourceAsset decodeCompilerSourceAsset)
  (import "../tools/backends/compiler-matrix.mjs" archiveProduct)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerSourceIdentity compilerDigest assertCompilerArtifactSources archiveCompilerSources readArchivedCompilerSources openCompilerArtifact)
  (defconst base (get (pathToFileURL (str (resolve "dist/unit-corpus-artifact") "/")) :href))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defconst hostImport (js* "(specifier) => import(specifier)"))
  (defconst fields (js-array "modules" "runtime" "literalSources" "hostSources"))
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun different (a b &rest __host_forwarded_arguments_3)
    (let* ((label (aref __host_forwarded_arguments_3 0))) (js-call assert :notEqual a b label)))
  (defun each (values action) (js-call values :forEach action))
  (defun rx (pattern) (new globalThis.RegExp pattern))
  (defun throws (action &rest __host_forwarded_arguments_4)
    (let* ((kind (aref __host_forwarded_arguments_4 0))) (js-call assert :throws action kind)))
  (defun sha (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun exactSourceBytes (source)
    (let* ((bytes (new globalThis.Uint8Array (* (get source :length) 2))) (view (new globalThis.DataView (get bytes :buffer))) (index 0))
      (while (< index (get source :length)) (js-call view :setUint16 (* index 2) (js-call source :charCodeAt index) t) (setq index (1+ index))) bytes))
  (defun exactSourceHash (source) (sha (exactSourceBytes source)))
  (defun identitySources ()
    (js-object :entry "entry.mjs"
      :modules (js-array (js-object :id "other.mjs" :filename "lib/other.eli" :source "(module other)") (js-object :id "entry.mjs" :filename "src/entry.eli" :source "(module entry)"))
      :runtime (js-object :filename "bootstrap/runtime/memory.eli" :source "(module runtime)")
      ;; Independent source-identity input, not an implementation body.
      :hostSources (js-array (js-object :id "provider.mjs" :filename "host/provider.mjs" :source "export const value = \"中😀\";"))
      :literalSources (js-array (js-object :id "runtime/core/value.mjs" :filename "stdlib/managed-runtime-value.eli" :source "(module values)"))
      :hostModules (js-array (js-object :id "provider.mjs" :specifier "./provider.mjs" :referrer "entry.mjs" :allowedExports (js-array "value") :namespace false))))
  (defun fieldRecord (sources field) (if (= field "runtime") (get sources :runtime) (aref (get sources field) 0)))
  (defun sourceArtifact (sources)
    (let* ((record (lambda (value) (js-object :id (get value :id) :filename (get value :filename) :sha256 (exactSourceHash (get value :source)))))
           (identity (js-object :algorithm "sha256" :encoding "utf16le" :modules (js-call (get sources :modules) :map record)
             :runtime (js-object :filename (get (get sources :runtime) :filename) :sha256 (exactSourceHash (get (get sources :runtime) :source))))))
      (each (js-array "literalSources" "hostSources") (lambda (field) (when (Object/hasOwn sources field) (put identity field (js-call (get sources field) :map record)))))
      (js-object :entry (get sources :entry) :sourceIdentity identity)))
  (defasync fixtureText (name) (readFile (fileURLToPath (new globalThis.URL (str "./fixtures/corpus-arguments-" name ".mjs") (js* "import.meta.url"))) "utf8"))
  (defasync archivedSourceFixture (sources operation)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-exact-source-archive-")))))
      (try
        (let* ((identity (await (archiveCompilerSources sources directory)))
               (manifest (JSON/parse (await (readFile (resolve directory "source-archive.json") "utf8")))))
          (await (operation (js-object :directory directory :identity identity :manifest manifest))))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync runtimeAssetFixture (source encoding operation)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-default-runtime-asset-")))))
      (try
        (let* ((compilerBytes (Buffer/from (await (fixtureText "asset-driver")) "utf8"))
               (bytes (Buffer/from (if (= encoding "json-utf16") (JSON/stringify source) source) "utf8"))
               (runtimePath (if (= encoding "json-utf16") "runtime.eli.json" "runtime.eli"))
               (artifact (js-object :host "javascript" :directory directory :path "compiler.mjs" :entry "compiler.mjs" :modules (js-array (js-object :id "compiler.mjs" :path "compiler.mjs"))
                 :runtimePath runtimePath :runtimeEncoding encoding :sourceIdentity (js-object :algorithm "sha256" :encoding "utf16le"
                   :modules (js-array (js-object :id "compiler.mjs" :filename "compiler.eli" :sha256 (exactSourceHash "(module compiler)")))
                   :runtime (js-object :filename "bootstrap/runtime/original😀.eli" :sha256 (exactSourceHash source)))
                 :artifactIdentity (js-object :algorithm "sha256" :files (js-array
                   (js-object :path "compiler.mjs" :bytes (get compilerBytes :length) :sha256 (sha compilerBytes))
                   (js-object :path runtimePath :bytes (get bytes :length) :sha256 (sha bytes)))))))
          (await (writeFile (resolve directory "compiler.mjs") compilerBytes)) (await (writeFile (resolve directory runtimePath) bytes))
          (await (operation (js-object :directory directory :artifact artifact :source source :bytes bytes :path (resolve directory runtimePath)))))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (test "source asset transport preserves every UTF16 unit while ordinary files retain their original UTF8 form" (lambda ()
    (let ((encoder (new globalThis.TextEncoder)))
      (each (js-array "" "\uFEFF; 中😀e\u0301\n(module source)" "(defconst value \"\ud800\")" "(defconst value \"\udc00\")" "(defconst value \"�\")" "\ud800\ud800\udc00\udc00" "\uFEFF\ud800😀\udc00")
        (lambda (source)
          (let ((asset (encodeCompilerSourceAsset source)))
            (eqv (decodeCompilerSourceAsset (js-call encoder :encode (get asset :text)) (get asset :encoding)) source)
            (eqv (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode (js-call encoder :encode (get asset :text))) (get asset :text))
            (if (or (= source "") (js-call source :includes "�") (js-call source :startsWith "\uFEFF;"))
              (progn (eqv (get asset :encoding) "utf8") (eqv (get asset :text) source)) (eqv (get asset :encoding) "json-utf16")))))
      (eqv (decodeCompilerSourceAsset (js-call encoder :encode "\uFEFFsource")) "\uFEFFsource")
      (each (js-array undefined nil false 1 (js-object) (js-array)) (lambda (value) (throws (lambda () (encodeCompilerSourceAsset value)) globalThis.TypeError))))))
  (test "source asset decoding rejects malformed encoding and non-string payloads without substituting source text" (lambda ()
    (let ((encoder (new globalThis.TextEncoder)))
      (each (js-array (js-array 192 175) (js-array 237 160 128) (js-array 240 159 152) (js-array 226 40 161)) (lambda (bytes)
        (each (js-array "utf8" "json-utf16") (lambda (encoding) (throws (lambda () (decodeCompilerSourceAsset (Uint8Array/from bytes) encoding)) globalThis.TypeError)))))
      (each (js-array nil "utf16" "utf-8" 1 (js-object)) (lambda (encoding) (throws (lambda () (decodeCompilerSourceAsset (js-call encoder :encode "source") encoding)) globalThis.TypeError)))
      (each (js-array "null" "{}" "[]" "true" "42") (lambda (payload) (throws (lambda () (decodeCompilerSourceAsset (js-call encoder :encode payload) "json-utf16")) globalThis.TypeError)))
      (throws (lambda () (decodeCompilerSourceAsset (js-call encoder :encode "\"unterminated") "json-utf16")) globalThis.SyntaxError)
      (eqv (decodeCompilerSourceAsset (js-call encoder :encode "\"\\ud800\\udc00\\ud800\"") "json-utf16") "𐀀\ud800"))))
  (test "complete compiler IR transport preserves deep trees without a recursive host traversal" (lambda ()
    (let ((depth 20000) (object (js* "-0")) (array (js* "-0")) (index 0))
      (while (< index depth) (setq object (js-object :child object) array (js-array array) index (1+ index)))
      (eqv (encodeCompilerIR object) (str (js-call "{\"child\":" :repeat depth) "-0" (js-call "}" :repeat depth)))
      (eqv (encodeCompilerIR array) (str (js-call "[" :repeat depth) "-0" (js-call "]" :repeat depth))))))
  (test "IR transport preserves shared subtrees, IEEE text, Unicode and JSON omission rules" (lambda ()
    (let* ((child (js-object :value (js* "-0") :text "😀\ud800" :absent undefined)) (values (new globalThis.Array 5))
           (input (js-object :left child :right child :nan globalThis.NaN :positive globalThis.Infinity :negative (- globalThis.Infinity) :values values :ignored (lambda () 0))))
      (put values 0 undefined) (put values 1 (funcall globalThis.Symbol "ignored")) (put values 2 (lambda () 1)) (put values 4 (js* "-0"))
      (eqv (encodeCompilerIR input) "{\"left\":{\"value\":-0,\"text\":\"😀\\ud800\"},\"right\":{\"value\":-0,\"text\":\"😀\\ud800\"},\"nan\":null,\"positive\":null,\"negative\":null,\"values\":[null,null,null,null,-0]}")
      (each (js-array undefined (funcall globalThis.Symbol "unsupported") (lambda () 0)) (lambda (value) (throws (lambda () (encodeCompilerIR value)) globalThis.TypeError)))
      (throws (lambda () (encodeCompilerIR (js-object :value (js* "1n")))) (rx "BigInt"))
      (let ((cycle (js-object :child child))) (put cycle :self cycle) (throws (lambda () (encodeCompilerIR cycle)) (rx "cycles")))
      (eqv (encodeCompilerIR child) "{\"value\":-0,\"text\":\"😀\\ud800\"}"))))
  (test "IR transport reads properties once in source order and preserves the original thrown value" (lambda ()
    (let ((reads (js-array)) (reason (js-object :message "original property failure")) (value (js-object)))
      (Object/defineProperty value "first" (js-object :enumerable t :get (lambda () (js-call reads :push "first")
        (let ((inner (js-object))) (Object/defineProperty inner "inner" (js-object :enumerable t :get (lambda () (js-call reads :push "inner") (js* "-0")))) inner))))
      (Object/defineProperty value "omitted" (js-object :enumerable t :get (lambda () (js-call reads :push "omitted") undefined)))
      (Object/defineProperty value "last" (js-object :enumerable t :get (lambda () (js-call reads :push "last") (throw reason))))
      (throws (lambda () (encodeCompilerIR value)) (lambda (error) (= error reason))) (same reads (js-array "first" "inner" "omitted" "last"))
      (let ((growing (js-array 0)))
        (Object/defineProperty growing 0 (js-object :enumerable t :get (lambda () (js-call growing :push (js* "-0")) 1)))
        (eqv (encodeCompilerIR growing) "[1,-0]")))))
  (test "original host arguments retain module order, URLs, artifact directory and literal values" (lambda ()
    (let ((entry "stdlib/core/vector.mjs"))
      (same (originalProgramArguments (js-object) entry base) (js-array (resolve "dist/unit-corpus-artifact" entry)))
      (same (originalProgramArguments (js-object :argument "url" :argumentModules (js-array entry "lib/dependency.mjs")) entry base)
        (js-array (get (new globalThis.URL entry base) :href) (get (new globalThis.URL "lib/dependency.mjs" base) :href)))
      (same (originalProgramArguments (js-object :argumentModules (js-array "%2e%2e/file#?.mjs")) entry base) (js-array (resolve "dist/unit-corpus-artifact" "%2e%2e/file#?.mjs")))
      (same (originalProgramArguments (js-object :arguments (js-array (js-object :directory t) (js-object :literal "vector") (js-object :literal "1_000_000") (js-object :module entry))) entry base)
        (js-array (str (resolve "dist/unit-corpus-artifact") "/") "vector" "1_000_000" (resolve "dist/unit-corpus-artifact" entry)))
      (each (js-array nil "vector" (js-object) (js-object :directory false) (js-object :literal 1000000) (js-object :module "../outside.mjs") (js-object :module "/absolute.mjs")
        (js-object :module "file:outside.mjs") (js-object :module "a\\b.mjs") (js-object :literal "vector" :directory t))
        (lambda (value) (throws (lambda () (originalProgramArguments (js-object :arguments (js-array value)) entry base)) globalThis.TypeError))))))
  (test "the actual original-program executor passes directory and literal arguments unchanged to the original host process" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-original-arguments-")))))
      (try
        (await (writeFile (resolve directory "entry.mjs") (await (fixtureText "entry"))))
        (let* ((hostSource (await (fixtureText "program-host"))) (record (js-object :request (js-object :hostSources (js-array)) :execution
                 (js-object :kind "original-program" :host "original-host.mjs" :hostSource hostSource :arguments (js-array (js-object :directory t) (js-object :literal "vector") (js-object :literal "1000000")))))
               (artifact (js-object :target "javascript" :entry "entry.mjs" :path (resolve directory "entry.mjs") :directory directory :modules (js-array (js-object :id "entry.mjs"))))
               (result (await (executeCompilerCorpusRecord (js-object :record record :artifact artifact :target "javascript" :sourceRoot (resolve ".") :options (js-object))))))
          (same result (js-object :kind "original-program" :stdout "[\"vector\",\"1000000\",42]\n")))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "isolated original export calls retain negative-zero arguments expectations and observations across the actual Node boundary" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-isolated-ieee-")))))
      (try
        (let* ((calls (js-array (js-object :name "report" :args (js-array (js* "-0")) :expected (js-array (js* "-0") t (get globalThis.Number :MIN_VALUE)))
                    (js-object :name "report" :args (js-array 0) :expected (js-array 0 false (get globalThis.Number :MIN_VALUE)))))
               (record (js-object :id "transport:isolated-ieee" :kind "sequence" :expected (js-object :kind "sequence")
                  :steps (js-array (js-object :id "original" :request (js-object :operation "project" :entry "entry.mjs") :artifact (js-object :kind "exports" :isolated t :calls calls)))))
               (javascript (await (fixtureText "ieee-host")))
               (result (await (executeCompilerCorpusRecord (js-object :record record :target "javascript" :sourceRoot (resolve ".") :directory directory :options (js-object)
                 :session (js-object :request (async (request) (eqv (get request :operation) "project") (js-object :target "javascript" :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :javascript javascript)))))
                 :archiveProduct (lambda (response name target) (archiveProduct response target (resolve directory name))))))))
          (eqv (get result :kind) "sequence") (eqv (get result :expectedSatisfied) t)
          (same (get result :identity) (js-array (js-object :id "original" :result (js-array
            (js-object :name "report" :value (js-array (js-object :$eliscriptObservation "-0") t (get globalThis.Number :MIN_VALUE)))
            (js-object :name "report" :value (js-array 0 false (get globalThis.Number :MIN_VALUE)))))))
          (assert (Object/is (aref (get (aref calls 0) :args) 0) (js* "-0"))) (assert (Object/is (aref (get (aref calls 0) :expected) 0) (js* "-0"))))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "original sequence failures retain falsy thrown values instead of recording successful requests" (async ()
    (let ((values (js-array undefined nil false 0 (js* "-0") "")) (i 0))
      (while (< i (get values :length))
        (let* ((thrown (aref values i)) (direct (await (executeCompilerCorpusRecord (js-object :record (js-object :kind "stage" :request (js-object :stage "ir")) :failure thrown))))
               (request (js-object :operation "capabilities"))
               (context (js-object :target "javascript" :sourceRoot (resolve ".") :options (js-object) :session (js-object :request (async () (throw thrown))))))
          (eqv (get direct :kind) "diagnostic") (eqv (get direct :message) (funcall globalThis.String thrown))
          (let ((unexpected (await (executeCompilerCorpusRecord (Object/assign (js-object) context (js-object :record (js-object :kind "sequence" :steps (js-array (js-object :id "reject" :request request)))))))))
            (eqv (get unexpected :expectedSatisfied) false) (eqv (get (aref (get unexpected :identity) 0) :status) "failed")
            (eqv (get (get (aref (get unexpected :identity) 0) :error) :message) (funcall globalThis.String thrown)))
          (let ((expected (await (executeCompilerCorpusRecord (Object/assign (js-object) context (js-object :record (js-object :kind "sequence" :steps (js-array (js-object :id "reject" :request request :error (js-object))))))))))
            (eqv (get expected :expectedSatisfied) t) (eqv (get (get (aref (get expected :identity) 0) :error) :message) (funcall globalThis.String thrown)))
          (let ((notThrown (await (executeCompilerCorpusRecord (Object/assign (js-object) context (js-object :session (js-object :request (async () undefined))
            :record (js-object :kind "sequence" :steps (js-array (js-object :id "required rejection" :request request :error (js-object))))))))))
            (eqv (get notThrown :expectedSatisfied) false)))
        (setq i (1+ i))))))
  (test "cancelled original sequences preserve explicit falsy abort reasons over the in-flight failure" (async ()
    (let ((reasons (js-array nil false 0 (js* "-0") "")) (i 0))
      (while (< i (get reasons :length))
        (let ((reason (aref reasons i)) (controller (new globalThis.AbortController)) (caught false))
          (try (await (executeCompilerCorpusRecord (js-object :target "javascript" :options (js-object) :signal (get controller :signal)
            :record (js-object :kind "sequence" :steps (js-array (js-object :id "cancelled" :request (js-object :operation "capabilities"))))
            :session (js-object :request (async () (js-call controller :abort reason) (throw (new globalThis.Error "in-flight request failure")))))))
            (catch error (setq caught t) (assert (Object/is error reason) "original cancellation reason must survive")))
          (eqv caught t))
        (setq i (1+ i))))))
  (test "real original export execution cannot accept falsy exceptions as an undefined result in either process mode" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-original-falsy-throw-")))))
      (try
        (let ((javascript (await (fixtureText "falsy-host"))) (settings (js-array false t)) (i 0))
          (while (< i (get settings :length))
            (let ((isolated (aref settings i)) (mode 0))
              (while (< mode 6)
                (let* ((record (js-object :kind "sequence" :steps (js-array (js-object :id "original" :request (js-object :operation "project" :entry "entry.mjs")
                  :artifact (js-object :kind "exports" :isolated isolated :calls (js-array (js-object :name "fail" :args (js-array mode) :expected undefined)))))))
                       (result (await (executeCompilerCorpusRecord (js-object :record record :target "javascript" :sourceRoot (resolve ".") :directory directory :options (js-object)
                         :session (js-object :request (async () (js-object :target "javascript" :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :javascript javascript)))))
                         :archiveProduct (lambda (response name target) (archiveProduct response target (resolve directory (str (funcall globalThis.String isolated) "-" mode) name))))))))
                  (eqv (get result :expectedSatisfied) false (str "throw must fail: " isolated "/" mode)) (eqv (get (aref (get result :identity) 0) :status) "failed"))
                (setq mode (1+ mode))))
            (setq i (1+ i))))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "the independent compiler CLI reports actual argument and file failures as one structured error in Node and Bun" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-cli-errors-")))) (cli (fileURLToPath (new globalThis.URL "../tools/backends/compiler-cli.mjs" (js* "import.meta.url"))))
           (executables (js-array (get process :execPath) (if (nullish? (get (get process :env) :NODE)) "node" (get (get process :env) :NODE)))) (i 0))
      (try
        (while (< i (get executables :length))
          (let* ((executable (aref executables i)) (cases (js-array (js-object :args (js-array "compile" "--unknown-option" "--json-errors") :code "ERR_PARSE_ARGS_UNKNOWN_OPTION")
               (js-object :args (js-array "compile" "--compiler-artifact" (resolve directory "不存在😀.json") "--input" "-" "--target" "javascript" "--json-errors") :code "ENOENT"))) (j 0)
               (env (Object/assign (js-object) (get process :env) (js-object :NODE_OPTIONS "" :BUN_OPTIONS ""))))
            (while (< j (get cases :length))
              (let* ((item (aref cases j)) (child (spawnSync executable (js-call (js-array cli) :concat (get item :args))
                (js-object :cwd directory :input "(defun value () 42) (export value)" :encoding "utf8" :timeout 10000 :env env))))
                (eqv (get child :error) undefined (get child :stderr)) (eqv (get child :status) 1 (get child :stderr)) (eqv (get child :stdout) "")
                (let ((record (JSON/parse (get child :stderr))))
                  (eqv (get record :format) "eliscript-compiler-cli-error") (eqv (get record :version) 1) (eqv (get (get record :error) :code) (get item :code))
                  (each (js-array "name" "message" "stack") (lambda (key) (eqv (funcall hostTypeof (get (get record :error) key)) "string")))
                  (when (= (get item :code) "ENOENT") (assert (js-call (get (get record :error) :message) :includes "不存在😀.json")))))
              (setq j (1+ j)))
            (let ((help (spawnSync executable (js-array cli "--help" "--json-errors") (js-object :cwd directory :encoding "utf8" :timeout 10000 :env env))))
              (eqv (get help :error) undefined (get help :stderr)) (eqv (get help :status) 0 (get help :stderr)) (eqv (get help :stderr) "") (assert (js-call (get help :stdout) :startsWith "Usage:"))))
          (setq i (1+ i)))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "compiler source identities bind exact UTF16LE code units for module runtime literal and host source records" (lambda ()
    (each fields (lambda (field)
      (let ((identities (js-array)))
        (each (js-array "\ud800" "\udc00" "\ufffd") (lambda (character)
          (let* ((sources (identitySources)) (source (str "; exact " character "\n(module input)")) (record (fieldRecord sources field)))
            (put record :source source)
            (let* ((before (JSON/stringify sources)) (identity (compilerSourceIdentity sources))
                   (actual (if (= field "runtime") (get identity :runtime) (js-call (get identity field) :find (lambda (item) (= (get item :id) (get record :id))))))
                   (body (Object/assign (js-object) identity)))
              (eqv (get identity :encoding) "utf16le") (eqv (get actual :encoding) "utf16le") (eqv (get actual :bytes) (* (get source :length) 2)) (eqv (get actual :sha256) (exactSourceHash source))
              (Reflect/deleteProperty body "sha256") (eqv (get identity :sha256) (exactSourceHash (JSON/stringify body)))
              (eqv (JSON/stringify sources) before) (eqv (get (assertCompilerArtifactSources (sourceArtifact sources) sources) :entry) (get sources :entry)) (js-call identities :push identity)))))
        (eqv (get (new globalThis.Set (js-call identities :map (lambda (item) (get item :sha256)))) :size) 3 (str field " must not collapse lone high/low surrogates or U+FFFD"))
        (eqv (get (new globalThis.Set (js-call identities :map (lambda (item)
          (get (if (= field "runtime") (get item :runtime) (js-call (get item field) :find (lambda (value) (= (get value :id) (get (aref (get (identitySources) field) 0) :id))))) :sha256)))) :size) 3))))))
  (test "compiler source metadata preserves BOM Unicode normalization filenames IDs ordering and explicit source inventory absence" (lambda ()
    (let* ((base (identitySources)) (before (JSON/stringify base)) (original (compilerSourceIdentity base)))
      (same (js-call (get original :modules) :map (lambda (item) (get item :id))) (js-array "entry.mjs" "other.mjs"))
      (eqv (get (compilerSourceIdentity (Object/assign (js-object) base (js-object :modules (js-call (js-call (get base :modules) :slice) :reverse)))) :sha256) (get original :sha256))
      (each fields (lambda (field)
        (let ((observations (js-array)))
          (each (js-array "(module 😀 \"é\")" "\uFEFF(module 😀 \"é\")" "(module 😀 \"e\u0301\")" "(module 😁 \"é\")") (lambda (source)
            (let ((changed (globalThis.structuredClone base))) (put (fieldRecord changed field) :source source) (js-call observations :push (get (compilerSourceIdentity changed) :sha256)))))
          (eqv (get (new globalThis.Set observations) :size) 4 (str field " must preserve BOM, exact combining code units and supplementary characters"))
          (let ((renamed (globalThis.structuredClone base))) (put (fieldRecord renamed field) :filename "renamed/中文😀.eli")
            (different (get (compilerSourceIdentity renamed) :sha256) (get original :sha256) (str field " filename")))
          (unless (= field "runtime") (let ((changed (globalThis.structuredClone base))) (put (aref (get changed field) 0) :id (str "renamed/" field ".mjs"))
            (different (get (compilerSourceIdentity changed) :sha256) (get original :sha256) (str field " module ID")))))))
      (each (js-array "literalSources" "hostSources" "hostModules") (lambda (field)
        (let* ((absent (globalThis.structuredClone base)) (empty undefined))
          (Reflect/deleteProperty absent field) (setq empty (Object/assign (js-object) absent)) (put empty field (js-array))
          (different (get (compilerSourceIdentity absent) :sha256) (get (compilerSourceIdentity empty) :sha256) (str field " omission and [] are distinct")))))
      (let ((absent (globalThis.structuredClone base)))
        (Reflect/deleteProperty absent "phased")
        (different (get (compilerSourceIdentity absent) :sha256) (get (compilerSourceIdentity (Object/assign (js-object) absent (js-object :phased false))) :sha256)))
      (different (get (compilerSourceIdentity (Object/assign (js-object) base (js-object :phased false))) :sha256) (get (compilerSourceIdentity (Object/assign (js-object) base (js-object :phased t))) :sha256))
      (let ((reordered (globalThis.structuredClone base)))
        (put reordered :hostModules (js-call (get reordered :hostModules) :map (lambda (item) (Object/fromEntries (js-call (Object/entries item) :reverse)))))
        (eqv (get (compilerSourceIdentity reordered) :sha256) (get original :sha256) "host declaration object key ordering remains canonical"))
      (each (js-array (Object/assign (js-object) (aref (get base :hostModules) 0) (js-object :allowedExports (js-array)))
        (Object/assign (js-object) (aref (get base :hostModules) 0) (js-object :namespace t))
        (Object/assign (js-object) (aref (get base :hostModules) 0) (js-object :specifier "./different.mjs"))) (lambda (declaration)
          (different (get (compilerSourceIdentity (Object/assign (js-object) base (js-object :hostModules (js-array declaration)))) :sha256) (get original :sha256))))
      (eqv (JSON/stringify base) before))))
  (test "exact compiler source digests retain strict source inventory validation without changing generic byte digests" (lambda ()
    (let ((base (identitySources)))
      (each (js-array
        (lambda (value) (js-call (get value :modules) :push (Object/assign (js-object) (aref (get value :modules) 0))))
        (lambda (value) (put (aref (get value :modules) 0) :filename undefined))
        (lambda (value) (put (get value :runtime) :filename undefined))
        (lambda (value) (js-call (get value :literalSources) :push (Object/assign (js-object) (aref (get value :literalSources) 0))))
        (lambda (value) (put (aref (get value :hostSources) 0) :id (get (aref (get value :modules) 0) :id)))
        (lambda (value) (put (aref (get value :literalSources) 0) :id "../escape.mjs"))
        (lambda (value) (put (aref (get value :hostModules) 0) :extra undefined))) (lambda (mutate)
          (let ((sources (globalThis.structuredClone base))) (mutate sources) (throws (lambda () (compilerSourceIdentity sources)) globalThis.TypeError))))
      (let ((artifact (sourceArtifact base)) (mutated (globalThis.structuredClone base)))
        (put (get mutated :runtime) :source (str (get (get mutated :runtime) :source) "\ud800"))
        (throws (lambda () (assertCompilerArtifactSources artifact mutated)) (rx "runtime source is stale"))
        (each (js-array "modules" "literalSources" "hostSources") (lambda (field)
          (let* ((changed (globalThis.structuredClone base)) (record (aref (get changed field) 0)))
            (put record :source (str (get record :source) "\udc00"))
            (throws (lambda () (assertCompilerArtifactSources artifact changed)) (rx "source graph|source graph is stale|source graph is stale or incomplete"))))))
      (let ((bytes (Uint8Array/from (js-array 0 255 216 0 220 0 239 187 191))))
        (eqv (compilerDigest bytes) (sha bytes)) (eqv (compilerDigest "ordinary UTF8 😀") (sha "ordinary UTF8 😀"))))))
  (test "source archives restore exact high low replacement BOM and combining code units for every source category" (async ()
    (let ((i 0))
      (while (< i (get fields :length))
        (let ((field (aref fields i)) (identities (js-array)) (texts (js-array "\ud800" "\udc00" "\ufffd" "\uFEFF中😀é" "中😀e\u0301")) (j 0))
          (while (< j (get texts :length))
            (let* ((text (aref texts j)) (sources (identitySources)) (source (str "; " text "\n(module exact)")) (original (fieldRecord sources field)))
              (put original :source source)
              (let ((before (JSON/stringify sources)))
                (await (archivedSourceFixture sources (async (context)
                  (let* ((directory (get context :directory)) (identity (get context :identity)) (manifest (get context :manifest))
                         (restored (await (readArchivedCompilerSources directory (js-object :expectedIdentity identity))))
                         (record (js-call (get manifest :records) :find (lambda (item) (if (= field "runtime") (= (get item :kind) "runtime") (= (get item :id) (get original :id)))))))
                    (same restored sources) (eqv (JSON/stringify sources) before) (same (compilerSourceIdentity restored) identity)
                    (assert record) (eqv (get record :encoding) "utf16le") (eqv (get record :filename) (get original :filename))
                    (let* ((raw (await (readFile (resolve directory (get record :path)))))
                           (tool (await (readFile (resolve directory (get (get record :tool) :path)))))
                           (projected (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode tool)))
                      (same raw (Buffer/from (exactSourceBytes source))) (eqv (get raw :length) (* (get source :length) 2)) (eqv (sha raw) (get record :sha256)) (eqv (get record :bytes) (get raw :length))
                      (eqv (js-call raw :toString "utf16le") source) (same tool (Buffer/from source "utf8"))
                      (eqv (get (get record :tool) :encoding) "utf8") (eqv (get (get record :tool) :role) "tool-projection")
                      (eqv (get (get record :tool) :lossless) (= projected source))
                      (if (or (= text "\ud800") (= text "\udc00")) (progn (eqv (get (get record :tool) :lossless) false) (different projected source)) (eqv (get (get record :tool) :lossless) t)))
                    (js-call identities :push (get identity :sha256))))))))
            (setq j (1+ j)))
          (eqv (get (new globalThis.Set identities) :size) 5 (str field " archives must not collapse distinct source code units")))
        (setq i (1+ i))))))
  (test "source archive identities distinguish shared filenames from colliding logical module IDs" (async ()
    (let ((sources (identitySources)))
      (put (aref (get sources :modules) 0) :filename "same.eli") (put (aref (get sources :modules) 1) :filename "same.eli")
      (put (aref (get sources :hostSources) 0) :filename "same.eli") (put (aref (get sources :literalSources) 0) :filename "same.eli")
      (put (aref (get sources :modules) 0) :source "; high \ud800") (put (aref (get sources :modules) 1) :source "; low \udc00")
      (await (archivedSourceFixture sources (async (context)
        (let* ((identity (get context :identity)) (manifest (get context :manifest)) (records (get manifest :records))
               (restored (await (readArchivedCompilerSources (get context :directory) (js-object :expectedIdentity (get identity :sha256))))))
          (same restored sources)
          (eqv (get (new globalThis.Set (js-call records :map (lambda (record) (get record :path)))) :size) (get records :length))
          (eqv (get (new globalThis.Set (js-call records :map (lambda (record) (get (get record :tool) :path)))) :size) (get records :length))))))
      (let ((collisions (js-array "module" "host" "literal")) (i 0))
        (while (< i (get collisions :length))
          (let* ((collision (aref collisions i)) (invalid (identitySources)) (directory (await (mkdtemp (resolve (tmpdir) "eliscript-source-archive-collision-")))))
            (cond ((= collision "module") (js-call (get invalid :modules) :push (Object/assign (js-object) (aref (get invalid :modules) 0) (js-object :source "different"))))
              ((= collision "host") (put (aref (get invalid :hostSources) 0) :id (get (aref (get invalid :modules) 0) :id)))
              (t (put (aref (get invalid :literalSources) 0) :id (get (aref (get invalid :hostSources) 0) :id))))
            (try (await (js-call assert :rejects (lambda () (archiveCompilerSources invalid directory)) globalThis.TypeError)) (finally (await (rm directory (js-object :recursive t :force t))))))
          (setq i (1+ i)))))))
  (test "restoring source archives rejects damaged raw bytes tool bytes identities encodings and incomplete mappings" (async ()
    (let ((mutations (js-array "raw-byte" "raw-truncated" "tool-byte" "encoding" "size" "hash" "filename" "id" "duplicate-id" "duplicate-path" "missing-record" "tool-lossless" "expected-identity" "escape")) (i 0))
      (while (< i (get mutations :length))
        (let ((mutation (aref mutations i)) (sources (identitySources)))
          (put (aref (get sources :modules) 0) :source "; \uFEFF😀\ud800 exact")
          (await (archivedSourceFixture sources (async (context)
            (let* ((directory (get context :directory)) (identity (get context :identity)) (manifest (get context :manifest)) (record (aref (get manifest :records) 0))
                   (manifestPath (resolve directory "source-archive.json")) (rawPath (resolve directory (get record :path))) (toolPath (resolve directory (get (get record :tool) :path))))
              (cond ((= mutation "raw-byte") (let ((bytes (await (readFile rawPath)))) (put bytes 0 (bit-xor (aref bytes 0) 1)) (await (writeFile rawPath bytes))))
                ((= mutation "raw-truncated") (let ((bytes (await (readFile rawPath)))) (await (writeFile rawPath (js-call bytes :subarray 0 (1- (get bytes :length)))))))
                ((= mutation "tool-byte") (await (writeFile toolPath "altered tool projection")))
                ((= mutation "encoding") (put record :encoding "utf8")) ((= mutation "size") (put record :bytes (+ (get record :bytes) 2)))
                ((= mutation "hash") (put record :sha256 (js-call "0" :repeat 64))) ((= mutation "filename") (put record :filename "forged.eli"))
                ((= mutation "id") (put record :id "forged.mjs")) ((= mutation "duplicate-id") (js-call (get manifest :records) :push (Object/assign (js-object) record)))
                ((= mutation "duplicate-path") (put (aref (get manifest :records) 1) :path (get record :path)))
                ((= mutation "missing-record") (js-call (get manifest :records) :pop)) ((= mutation "tool-lossless") (put (get record :tool) :lossless t))
                ((= mutation "escape") (put record :path "../outside.utf16le")))
              (unless (js-call (js-array "raw-byte" "raw-truncated" "tool-byte" "expected-identity") :includes mutation) (await (writeFile manifestPath (JSON/stringify manifest))))
              (await (js-call assert :rejects (lambda () (readArchivedCompilerSources directory (js-object :expectedIdentity (if (= mutation "expected-identity") (js-call "0" :repeat 64) identity)))))))))))
        (setq i (1+ i))))))
  (test "a failed source archive read does not cache corrupted bytes or erase explicit empty source inventories" (async ()
    (let ((sources (identitySources)))
      (put (aref (get sources :modules) 0) :source "\uFEFF; \ud800\udc00 \ud800 \udc00 \ufffd 😀")
      (put sources :hostSources (js-array)) (put sources :literalSources (js-array)) (put sources :hostModules (js-array)) (put sources :phased false)
      (await (archivedSourceFixture sources (async (context)
        (let* ((directory (get context :directory)) (identity (get context :identity)) (record (aref (get (get context :manifest) :records) 0))
               (path (resolve directory (get record :path))) (original (await (readFile path))) (changed (Buffer/from original)))
          (put changed (1- (get changed :length)) (bit-xor (aref changed (1- (get changed :length))) 1)) (await (writeFile path changed))
          (await (js-call assert :rejects (lambda () (readArchivedCompilerSources directory (js-object :expectedIdentity identity)))))
          (await (writeFile path original))
          (let ((restored (await (readArchivedCompilerSources directory (js-object :expectedIdentity identity)))))
            (same restored sources) (eqv (Object/hasOwn restored "hostSources") t) (eqv (Object/hasOwn restored "literalSources") t)
            (same (get restored :hostSources) (js-array)) (same (get restored :literalSources) (js-array)) (same (get restored :hostModules) (js-array)) (eqv (get restored :phased) false))))))
      (let ((absent (identitySources))) (Reflect/deleteProperty absent "hostSources") (Reflect/deleteProperty absent "literalSources") (Reflect/deleteProperty absent "hostModules")
        (await (archivedSourceFixture absent (async (context)
          (let ((restored (await (readArchivedCompilerSources (get context :directory) (js-object :expectedIdentity (get context :identity))))))
            (same restored absent) (each (js-array "hostSources" "literalSources" "hostModules" "phased") (lambda (field) (eqv (Object/hasOwn restored field) false)))))))))))
  (test "default runtime assets use declared byte and exact UTF16 identities including BOM and JSON-transported lone surrogates" (async ()
    (let ((pairs (js-array (js-array "\uFEFF; runtime 中😀é" "utf8") (js-array "\uFEFF; runtime \ud800 \udc00 \ufffd" "json-utf16"))) (i 0))
      (while (< i (get pairs :length))
        (let* ((pair (aref pairs i)) (source (aref pair 0)) (encoding (aref pair 1)))
          (await (runtimeAssetFixture source encoding (async (context)
            (let ((session (await (openCompilerArtifact (get context :artifact)))))
              (try
                (let ((first (await (js-call session :request (js-object :operation "runtime")))))
                  (eqv (get first :source) source) (eqv (get first :filename) "bootstrap/runtime/original😀.eli") (eqv (get first :calls) 1))
                (let ((second (await (js-call session :request (js-object :operation "runtime" :filename "caller.eli")))))
                  (eqv (get second :source) source) (eqv (get second :filename) "caller.eli") (eqv (get second :calls) 2))
                (finally (await (js-call session :close)))))))))
        (setq i (1+ i))))))
  (test "failed default runtime asset reads can retry against the original declaration without dispatching failed source" (async ()
    (await (runtimeAssetFixture "\uFEFF; exact 中😀" "utf8" (async (context)
      (await (writeFile (get context :path) (Buffer/from (js-array 239 187 191 192 175))))
      (let ((session (await (openCompilerArtifact (get context :artifact)))))
        (try
          (await (js-call assert :rejects (lambda () (js-call session :request (js-object :operation "runtime"))) (rx "changed after emission")))
          (await (writeFile (get context :path) (get context :bytes)))
          (let ((result (await (js-call session :request (js-object :operation "runtime"))))) (eqv (get result :calls) 1) (eqv (get result :source) "\uFEFF; exact 中😀"))
          (finally (await (js-call session :close))))))))))
  (test "explicit runtime source and explicit undefined are never replaced with a default asset and cancellation or close prevents late dispatch" (async ()
    (await (runtimeAssetFixture "asset source" "utf8" (async (context)
      (await (rm (get context :path)))
      (let ((session (await (openCompilerArtifact (get context :artifact)))))
        (try
          (let ((result (await (js-call session :request (js-object :operation "runtime" :source "caller source" :filename "caller.eli")))))
            (eqv (get result :source) "caller source") (eqv (get result :filename) "caller.eli") (eqv (get result :calls) 1))
          (let ((explicitUndefined (await (js-call session :request (js-object :operation "runtime" :source undefined)))))
            (eqv (get explicitUndefined :source) undefined) (eqv (get explicitUndefined :calls) 2))
          (let ((control (new globalThis.AbortController)) (reason (new globalThis.Error "cancel default asset")))
            (js-call control :abort reason) (throws (lambda () (js-call session :request (js-object :operation "runtime") (js-object :signal (get control :signal)))) (lambda (error) (= error reason))))
          (finally (await (js-call session :close))))
        (throws (lambda () (js-call session :request (js-object :operation "runtime"))) (rx "closed"))))))
    (await (runtimeAssetFixture "pending source" "utf8" (async (context)
      (let* ((session (await (openCompilerArtifact (get context :artifact)))) (pending (js-call session :request (js-object :operation "runtime"))))
        (await (js-call session :close)) (await (js-call assert :rejects pending (rx "closed")))))))))
  (test "default runtime loading refuses a missing byte binding or mismatched exact source identity" (async ()
    (let ((mutations (js-array "file" "source" "filename" "encoding" "hash")) (i 0))
      (while (< i (get mutations :length))
        (let ((mutation (aref mutations i)))
          (await (runtimeAssetFixture "original runtime" "utf8" (async (context)
            (let ((artifact (get context :artifact)))
              (cond ((= mutation "file") (put (get artifact :artifactIdentity) :files (js-call (get (get artifact :artifactIdentity) :files) :filter (lambda (file) (not (= (get file :path) (get artifact :runtimePath)))))))
                ((= mutation "source") (Reflect/deleteProperty (get artifact :sourceIdentity) "runtime"))
                ((= mutation "filename") (Reflect/deleteProperty (get (get artifact :sourceIdentity) :runtime) "filename"))
                ((= mutation "encoding") (put (get artifact :sourceIdentity) :encoding "utf8"))
                (t (put (get (get artifact :sourceIdentity) :runtime) :sha256 (js-call "0" :repeat 64))))
              (let ((session (await (openCompilerArtifact artifact))))
                (try (await (js-call assert :rejects (lambda () (js-call session :request (js-object :operation "runtime"))) (rx "identity"))) (finally (await (js-call session :close))))))))))
        (setq i (1+ i))))))
)
