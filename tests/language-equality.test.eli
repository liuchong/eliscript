(module tests.language-equality
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains excludes)
  (defconst ROOT (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst BUN (get globalThis.process :execPath))
  (defconst NODE (get (get globalThis.process :env) :NODE_BINARY "node"))
  (defasync run (command environment)
    (await (runSuccessful command (Object/assign (js-object :BUN BUN) (if (= environment undefined) (js-object) environment)))))
  (defasync compile (compiler source output environment)
    (await (mkdir (resolve output "..") (js-object :recursive t)))
    (await (run (js-array compiler "--source-map" "--output" output source) environment)))
  (defasync execute (host modulePath)
    (JSON/parse (await (run (js-array host (resolve ROOT "tests/fixtures/language-equality-host.mjs") modulePath) (js-object)))))
  (test "language equal uses value semantics across compilers and local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-equality-")))) (bootstrap (resolve directory "bootstrap"))
           (seedOutput (resolve directory "seed/module.mjs")) (selfOutput (resolve directory "self/module.mjs"))
           (source (resolve ROOT "tests/fixtures/language-equality.eli"))
           (SEED (resolve ROOT "bin/eliscript")) (SELF (resolve ROOT "bin/eliscript-portable")))
      (try
        (await (run (js-array (resolve ROOT "bin/eliscript-bootstrap")) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR bootstrap)))
        (await (compile SEED source seedOutput (js-object)))
        (await (compile SELF source selfOutput (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
        (let ((seed (await (readFile seedOutput "utf8"))))
          (be (await (readFile selfOutput "utf8")) seed)
          (be (await (readFile (str selfOutput ".map") "utf8")) (await (readFile (str seedOutput ".map") "utf8")))
          (js-call (expect (js-call seed :match (new globalThis.RegExp "runtime/core/value\\.mjs" "g"))) :toHaveLength 1)
          (contains seed "__eliscript_equal(") (contains seed "left === right"))
        (let ((expected (js-object "persistent" t "persistentIdentity" false "sameIdentity" t "nativeDistinct" false "nativeSame" t "nan" t "signedZero" t "mapOrder" t "setOrder" t)))
          (same (await (execute BUN seedOutput)) expected) (same (await (execute NODE selfOutput)) expected))
        (let ((identitySource (resolve directory "identity-only.eli")) (identitySeed (resolve directory "seed/identity.mjs")) (identitySelf (resolve directory "self/identity.mjs")))
          (await (Bun/write identitySource "(defun same-object (left right) (eq left right))\n(export same-object)\n"))
          (await (compile SEED identitySource identitySeed (js-object)))
          (await (compile SELF identitySource identitySelf (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
          (let ((identity (await (readFile identitySeed "utf8"))))
            (be (await (readFile identitySelf "utf8")) identity) (excludes identity "runtime/core/value.mjs") (contains identity "left === right")))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 60000)
)
