(module tests.pages-assembly.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp readFile readdir rm stat)
  (import "node:path" posix resolve)
  (import "node:url" pathToFileURL)
  (import "node:crypto" createHash)
  (import "../tools/pages/assemble.mjs" PUBLISHED_TREES PUBLISHED_FILES assemblePages)
  (import "./helpers/pages-build.mjs" buildPagesInputs)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst SITE_PAGE "pages/playground.html")
  (defvar staging undefined) (defvar artifact undefined)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync eachAsync (items operation) (let ((index 0)) (while (< index (get items :length)) (await (funcall operation (aref items index))) (setq index (1+ index)))))
  (beforeAll (async () (await (buildPagesInputs)) (setq staging (await (mkdtemp (resolve ROOT ".eliscript-pages-")))) (setq artifact (resolve staging "pages")) (await (assemblePages (js-object :root ROOT :outDir artifact)))))
  (afterAll (async () (when staging (await (rm staging (js-object :recursive t :force t))))))
  (defasync exists (path) (try (await (stat (resolve artifact path))) t (catch error false)))
  (test "the artifact carries the site and every tree it loads" (async ()
    (await (eachAsync (js-call (Array/from PUBLISHED_TREES) :concat (js-array "LICENSE")) (async (tree) (be (await (exists tree)) t))))
    (be (await (exists "index.html")) t) (be (await (exists "pages/playground.html")) t)
    (be (await (exists "examples/dogfood/_site/index.html")) t) (be (await (exists "examples/dogfood/_site/assets/browser.js")) t)))
  (test "the published root is the documentation site" (async ()
    (let ((index (await (readFile (resolve artifact "index.html") "utf8"))))
      (js-call (expect index) :toContain "<!doctype html>") (js-call (expect index) :toContain "pages/")
      (be (await (exists "pages/api.html")) t) (be (await (exists "pages/language.html")) t)
      (await (eachAsync (js-array "pages/playground.html" "pages/language.html") (async (page)
        (let ((source (await (readFile (resolve artifact page) "utf8"))))
          (js-call (get (expect source) :not) :toContain "src=\"../../") (js-call (get (expect source) :not) :toContain "href=\"../../"))))))))
  (test "the published compiler Worker loads its exact integrity dependency and preserves UTF16 request identities" (async ()
    (await (eachAsync (Array/from PUBLISHED_FILES) (async (name) (same (await (readFile (resolve artifact name))) (await (readFile (resolve ROOT name)))))))
    (let* ((worker (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve artifact "tools/backends/compiler-worker.mjs")) :href))))
           (request (js-object :operation "analyze" :filename "😀.eli" :source "; 😀\ud800\n(defun run () 42) (export run)"))
           (expected (js-call (js-call (createHash "sha256") :update (Buffer/from (JSON/stringify request) "utf16le")) :digest "hex")))
      (be (await (js-call worker :compilerRequestIdentity request)) expected))))
  (test "the addresses the site used to have still lead somewhere" (async ()
    (await (eachAsync (js-array (js-array "docs/index.html" "/") (js-array "docs/pages/language.html" "/pages/language.html") (js-array "docs/pages/playground.html" "/pages/playground.html")) (async (entry)
      (let* ((previous (aref entry 0)) (target (aref entry 1)) (stub (await (readFile (resolve artifact previous) "utf8"))))
        (js-call (expect stub) :toContain (str "url=" target)) (js-call (expect stub) :toContain (str "<link rel=\"canonical\" href=\"" target "\">"))
        (js-call (get (expect stub) :not) :toContain "<script")))))))
  (defasync walkPages (directory pages)
    (await (eachAsync (await (readdir directory (js-object :withFileTypes t))) (async (entry)
      (let ((path (resolve directory (get entry :name))))
        (if (js-call entry :isDirectory) (await (walkPages path pages)) (when (js-call (get entry :name) :endsWith ".html") (js-call pages :push path))))))))
  (test "every local reference in every published page resolves" (async ()
    (let ((pages (js-array)) (unresolved (js-array)))
      (await (walkPages artifact pages))
      (js-call (expect (get pages :length)) :toBeGreaterThan 5)
      (await (eachAsync pages (async (path)
        (let* ((source (await (readFile path "utf8"))) (directory (js-call posix :dirname (js-call path :replace (str artifact "/") "")))
               (references (Array/from (js-call source :matchAll (new globalThis.RegExp "(?:href|src)=\"([^\"]+)\"" "gu")))))
          (await (eachAsync references (async (match)
            (let ((reference (aref match 1)))
              (unless (or (js-call (new globalThis.RegExp "^[a-z]+:" "iu") :test reference) (js-call reference :startsWith "#"))
                (let* ((withoutFragment (aref (js-call reference :split "#") 0)) (path_ (aref (js-call withoutFragment :split "?") 0)))
                  (unless (= path_ "")
                    (let* ((target (if (js-call path_ :startsWith "/") (js-call path_ :slice 1) (js-call posix :normalize (js-call posix :join directory path_))))
                           (candidate (if (js-call target :endsWith "/") (str target "index.html") target)))
                      (unless (await (exists candidate)) (js-call unresolved :push (str (js-call posix :dirname (js-call path :replace (str artifact "/") "")) " -> " reference)))))))))))))))
      (same unresolved (js-array)))))
  (test "every reference the playground page carries resolves in the artifact" (async ()
    (let* ((page (await (readFile (resolve artifact SITE_PAGE) "utf8")))
           (match (js-call page :match (new globalThis.RegExp "<script type=\"importmap\">\\s*(\\{[\\s\\S]*?\\})\\s*<\\/script>" "u")))
           (importMap (JSON/parse (aref match 1))) (prefix (get (get importMap :imports) "eliscript/")) (base (js-call posix :resolve "/" (js-call posix :dirname SITE_PAGE) prefix)))
      (be prefix "../") (be base "/")
      (await (eachAsync (js-array "platform/browser.mjs" "runtime/core/data-text.mjs") (async (specifier) (be (await (exists specifier)) t))))
      (be (await (exists "browser/worker.mjs")) t) (be (await (exists "browser/host.mjs")) t) (be (await (exists "dist/browser/compiler.js")) t)
      (let* ((host (await (readFile (resolve artifact "browser/host.mjs") "utf8")))
             (compilerImport (js-call (js-call (js-call host :match (new globalThis.RegExp "from\\s+\"([^\"]+)\"" "gu")) :map
               (lambda (match) (js-call match :replace (new globalThis.RegExp "from\\s+\"|\"" "gu") ""))) :find (lambda (specifier) (js-call specifier :includes "compiler")))))
        (be (await (exists (js-call posix :join "browser" compilerImport))) t))
      (js-call (expect page) :toContain "../dist/browser-playground/playground.mjs")
      (be (await (exists "dist/browser-playground/playground.mjs")) t) (be (await (exists "dist/browser-playground/highlight.mjs")) t))))
  (test "the compiled playground loads its runtime from the published root" (async ()
    (let ((app (await (readFile (resolve artifact "dist/browser-playground/playground.mjs") "utf8"))))
      (js-call (expect app) :toMatch (new globalThis.RegExp "new\\s+(?:\\(globalThis\\.URL\\)|(?:globalThis\\.)?URL)\\(\\s*(['\"])\\.\\./\\.\\./\\1,\\s*import\\.meta\\.url\\s*\\)"))
      (js-call (expect app) :toContain "browser/worker.mjs")
      (be (await (exists "runtime/core/data-text.mjs")) t) (be (await (exists "runtime/core/sequence.mjs")) t) (be (await (exists "runtime/literals.mjs")) t))))
  (test "the assembler refuses to write into its own source tree" (async ()
    (await (js-call (get (expect (assemblePages (js-object :root ROOT :outDir ROOT))) :rejects) :toThrow (new globalThis.RegExp "refusing to assemble into the source tree" "u")))))
)
