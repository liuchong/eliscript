(module tests.wasm-managed-empty-bindings.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar js undefined)
  (defvar javascript undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-empty-bindings-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq program (js-call (get b :compiler) :compile_ir_string (await (readFile "tests/fixtures/wasm-managed-empty-bindings.eli" "utf8")) "empty-bindings.eli"))
    (setq javascript (js-call (get b :compiler) :emit_ir_string program))
    (setq js (await (dynamic-import (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun bytes (&rest __host_default_arguments_1)
    (let* ((prog (aref __host_default_arguments_1 0)) (rt (aref __host_default_arguments_1 1)))
    (let* ((p (if (undefined? prog) program prog))
           (runtime-ir (if (undefined? rt) runtime rt))
           (before (JSON/stringify p))
           (out (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime-ir))))
      (js-call assert :equal (JSON/stringify p) before)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module out)) (js-array))
      out)))

  (defun box (a x)
    (cond
      ((= (value-type x) "number") (js-call a :number x))
      ((= (value-type x) "string") (js-call a :string x))
      (t x)))

  (defun read (a x)
    (if (and x (= (value-type x) "object"))
      (cond
        ((= (get x :kind) 4) (js-call a :readNumber x))
        ((= (get x :kind) 5) (js-call a :readString x))
        (t x))
      x))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((values-list (aref __host_default_arguments_2 0)))
    (let ((values (if (undefined? values-list) (js-array) values-list)))
      (js-call values :forEach (lambda (value) (js-call a :release value)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (test "independent Node proves existing nil defaults, parallel and sequential scope, closure mutation and initializer effects" (async ()
    (let* ((file (resolve directory "source.mjs"))
           (seed (spawnSync (resolve "bin/eliscript-seed")
                   (js-array "--output" file (resolve "tests/fixtures/wasm-managed-empty-bindings.eli"))
                   (js-object :encoding "utf8" :timeout 30000))))
      (js-call assert :equal (get seed :status) 0 (get seed :stderr))
      (js-call assert :equal (await (readFile file "utf8")) javascript)
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-empty-bindings-node.mjs") "js" (get (pathToFileURL file) :href))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "zero-initializer bindings retain nil and scope while exact primitive values survive shared closure cells and collecting GC" (lambda ()
    (let ((a (instantiateManagedRuntime (bytes))))
      (js-call a :auto 1)
      (js-call assert :equal (js-call a :invoke "default-value") nil)
      (js-call
        (js-array nil undefined false t 0 -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                  globalThis.Number.MIN_VALUE globalThis.Number.MAX_VALUE "" "中😀\ud800")
        :forEach
        (lambda (value)
          (let ((input (box a value)))
            (js-call (js-array "parallel-value" "sequential-value" "capture-value") :forEach
              (lambda (name)
                (let ((out (js-call a :invoke name (js-array input))))
                  (assert (Object/is (read a out) (js-call js (js-call name :replaceAll "-" "_") value)) name)
                  (js-call a :release out))))
            (js-call a :release input)
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
      (js-call (js-array -1 -0.0 0 1 2 17 31.5) :forEach
        (lambda (limit)
          (let* ((input (js-call a :number limit))
                 (out (js-call a :invoke "loop-value" (js-array input))))
            (assert (Object/is (read a out) (js-call js :loop_value limit)))
            (js-call a :release input)
            (js-call a :release out))))
      (finish a))))

  (test "escaped uninitialized cells are fresh per invocation, preserve aliases and outlive their declaring frames" (lambda ()
    (let* ((c (js-call (get b :compiler) :compile_ir_string
                "(defconst marker 1) (defun factory () (let (x) (lambda (v) (if (eq v nil) x (progn (setq x v) x))))) (defun invoke (f v) (funcall f v)) (export factory invoke)"
                "escaped-bindings.eli"))
           (a (instantiateManagedRuntime (bytes c)))
           (_ (js-call a :auto 1))
           (first (js-call a :invoke "factory"))
           (second (js-call a :invoke "factory"))
           (text (js-call a :string "中😀\ud800")))
      (js-call assert :equal (js-call a :invoke "invoke" (js-array first nil)) nil)
      (js-call assert :equal (js-call a :invoke "invoke" (js-array second nil)) nil)
      (let ((written (js-call a :invoke "invoke" (js-array first text))))
        (js-call a :release written)
        (js-call a :release text)
        (js-call a :collect))
      (let ((out (js-call a :invoke "invoke" (js-array first nil))))
        (js-call assert :equal (js-call a :readString out) "中😀\ud800")
        (js-call assert :equal (js-call a :invoke "invoke" (js-array second nil)) nil)
        (finish a (js-array first second out))))))

  (test "empty bindings do not skip, duplicate or reorder initialized siblings" (lambda ()
    (let* ((a (instantiateManagedRuntime (bytes)))
           (_ (js-call a :auto 1))
           (trace (js-call a :sourceObject (js-object)))
           (out (js-call a :invoke "effect-value" (js-array trace))))
      (js-call assert :equal (js-call a :length out) 3)
      (js-call assert :equal (js-call a :get out 0) nil)
      (js-call (js-array (js-array 1 "first" 1) (js-array 2 "second" 2)) :forEach
        (lambda (row)
          (let* ((index (aref row 0))
                 (key (aref row 1))
                 (expected (aref row 2))
                 (item (js-call a :get out index))
                 (name (js-call a :string key))
                 (value (js-call a :objectGet trace name)))
            (js-call assert :equal (js-call a :readNumber item) expected)
            (js-call assert :equal (js-call a :readNumber value) expected)
            (js-call (js-array item name value) :forEach (lambda (x) (js-call a :release x))))))
      (finish a (js-array trace out)))))

  (test "malformed binding shape is refused before child lowering with exact Unicode source position and immutable input IR" (lambda ()
    (js-call
      (js-array
        (lambda (n) (put n :children (js-array nil)))
        (lambda (n) (js-call (get n :children) :push (aref (get n :children) 0)))
        (lambda (n) (put n :value nil))
        (lambda (n) (put n :properties (js-object :pattern (js-object :kind "unsupported"))))
        (lambda (n) (put n :kind "literal")))
      :forEach
      (lambda (change)
        (let* ((prog (js-call (get b :compiler) :compile_ir_string ";中😀\n(defun f () (let ((x 1)) x)) (export f)" "unicode-bindings.eli"))
               (binding undefined))
          (letfn ((walk (n)
                    (when (and n (= (value-type n) "object"))
                      (when (= (get n :kind) "lexical-binding")
                        (setq binding n))
                      (js-call (Object/values n) :forEach walk))))
            (walk prog))
          (assert binding)
          (let ((span (get binding :span)))
            (funcall change binding)
            (let ((before (JSON/stringify prog)))
              (js-call assert :throws
                (lambda () (js-call (get b :managed) :emit_managed_wasm prog runtime))
                (lambda (e)
                  (and (get e :eliscriptDiagnostic)
                       (= (get (get e :eliscriptDiagnostic) :code) "ELI-B0001")
                       (= (get (get e :eliscriptDiagnostic) :phase) "managed-backend")
                       (= (get (get (get e :eliscriptDiagnostic) :location) :file) "unicode-bindings.eli")
                       (= (get (get (get (get e :eliscriptDiagnostic) :location) :start) :line) (get span :line))
                       (= (get (get (get (get e :eliscriptDiagnostic) :location) :start) :column) (get span :column)))))
              (js-call assert :equal (JSON/stringify prog) before))))))))

  (test "deterministic nested empty bindings preserve observable control and closure semantics during collecting GC" (async ()
    (let* ((state 1846194487)
           (next (lambda () (setq state (uint32 (+ (Math/imul state 1664525) 1013904223)))))
           (leaf (js-array "a" "b" "nil" "false" "t" "0" "-0.0" "\"中😀\\ud800\"")))
      (letfn ((expr (depth)
                (if (= depth 0)
                  (aref leaf (% (funcall next) (js-length leaf)))
                  (let ((tag (% (funcall next) 7)))
                    (cond
                      ((= tag 0) (str "(if " (expr (- depth 1)) " " (expr (- depth 1)) " " (expr (- depth 1)) ")"))
                      ((= tag 1) (str "(and " (expr (- depth 1)) " " (expr (- depth 1)) ")"))
                      ((= tag 2) (str "(or " (expr (- depth 1)) " " (expr (- depth 1)) ")"))
                      ((= tag 3) (str "(let (a (b a)) " (expr (- depth 1)) ")"))
                      ((= tag 4) (str "(let* (a (b a)) " (expr (- depth 1)) ")"))
                      ((= tag 5) (str "(let (unused) " (expr (- depth 1)) ")"))
                      (t (str "(let* (slot (read (lambda () slot))) (setq slot " (expr (- depth 1)) ") (funcall read))")))))))
        (let* ((names (Array/from (js-object :length 64) (lambda (_ i) (str "random-" i))))
               (source (str (js-call (js-call names :map (lambda (name) (str "(defun " name " (a b) " (expr 3) ")"))) :join "\n")
                            " (export " (js-call names :join " ") ")"))
               (prog (js-call (get b :compiler) :compile_ir_string source "random-empty-bindings.eli"))
               (ref (await (dynamic-import (str "data:text/javascript;base64,"
                                                (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string prog)) :toString "base64")))))
               (a (instantiateManagedRuntime (bytes prog)))
               (values (js-array nil undefined false t -0.0 0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE "" "中😀\ud800")))
          (js-call a :auto 1)
          (let ((i 0))
            (while (< i 128)
              (let* ((x (aref values (% (funcall next) (js-length values))))
                     (y (aref values (% (funcall next) (js-length values))))
                     (args (js-array (box a x) (box a y))))
                (js-call names :forEach
                  (lambda (name)
                    (let ((out (js-call a :invoke name args)))
                      (assert (Object/is (read a out) (js-call ref (js-call name :replaceAll "-" "_") x y)) name)
                      (js-call a :release out)
                      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
                (js-call args :forEach (lambda (value) (js-call a :release value)))
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0))
              (setq i (1+ i))))
          (finish a))))))

  (test "closure capacity failure preserves outer frames, exact retained values and earlier escaping cells" (lambda ()
    (let* ((prog (js-call (get b :compiler) :compile_ir_string
                   "(defconst marker 1) (defun factory () (let (x) (lambda (v) (if (eq v nil) x (progn (setq x v) x))))) (defun invoke (f v) (funcall f v)) (export factory invoke)"
                   "capacity-bindings.eli"))
           (a (instantiateManagedRuntime (bytes prog) (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 8192)))
           (_ (js-call a :auto 1))
           (held (js-call a :number -0.0))
           (outer (js-call a :frame 1))
           (closures (js-array))
           (exhausted false))
      (js-call a :frameSet outer 0 held)
      (let ((i 0))
        (while (and (< i 64) (not exhausted))
          (try
            (js-call closures :push (js-call a :invoke "factory"))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (catch e
              (js-call assert :equal (and (get e :eliscriptDiagnostic) (get (get e :eliscriptDiagnostic) :code)) "ELI-RT0002")
              (setq exhausted t)))
          (setq i (1+ i))))
      (assert exhausted)
      (assert (> (js-length closures) 1))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (assert (Object/is (js-call a :readNumber held) -0.0))
      (js-call (js-call closures :slice 1) :forEach (lambda (value) (js-call a :release value)))
      (js-call a :collect)
      (js-call assert :equal (js-call a :invoke "invoke" (js-array (aref closures 0) nil)) nil)
      (js-call a :leaveFrame outer)
      (finish a (js-array held (aref closures 0))))))

  (test "a true captured-cell allocation trap unwinds only private binding frames and keeps an earlier conversion failure" (async ()
    (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call source :indexOf "  (defun value-cell-new "))
           (end (js-call source :indexOf "  (defun " (+ start 3))))
      (assert (and (>= start 0) (> end start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call source :slice 0 start)
                              "  (defun value-cell-new (heap value) (load-u32 4294967295))\n"
                              (js-call source :slice end))
                         "binding-trap.eli"))
             (prog (js-call (get b :compiler) :compile_ir_string
                     "(defun f (x) (+ x 1) (let* (next (read (lambda () next))) (setq next x) (funcall read))) (export f)"
                     "captured-bindings.eli"))
             (a (instantiateManagedRuntime (bytes prog injected)))
             (_ (js-call a :auto 1))
             (held (js-call a :number -0.0))
             (bad (js-call a :sourceObject (js-object :valueOf false :toString false)))
             (outer (js-call a :frame 1)))
        (js-call a :frameSet outer 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "f" (js-array bad)))
          (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call assert :throws
          (lambda () (js-call a :invoke "f" (js-array held)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (assert (Object/is (js-call a :readNumber held) -0.0))
        (js-call a :leaveFrame outer)
        (js-call a :release held)
        (js-call a :release bad)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)))))

  (test "Node executes the identical zero-import empty-binding WASM with nil, scope, closures and exact number bits" (async ()
    (let ((file (resolve directory "empty-bindings.wasm")))
      (await (writeFile file (bytes)))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-empty-bindings-node.mjs")
                               "wasm"
                               (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                               file)
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr)))))))
