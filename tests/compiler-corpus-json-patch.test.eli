(module tests.compiler-corpus-json-patch
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "../tools/backends/compiler-corpus-execution.mjs" resolveOriginalCorpusRequest)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst operand (js-object :kind "reference" :value "x" :children (js-array) :properties (js-object :scope "original")
    :span (js-object :start (js-object :offset 39 :line 2 :column 7) :end (js-object :offset 40 :line 2 :column 8))))
  (defun recipe (index extra)
    (js-object :$compilerCorpusJsonPatch (js-array (js-object :$compilerCorpusRef "source.ir")
      (js-array (copyHostRecord (js-object :path (js-array "body" 0 "children") :duplicateIndex index) (if (= extra undefined) (js-object) extra))))))
  (defun results (children)
    (new globalThis.Map (js-array (js-array "source" (js-object :ir (JSON/stringify (js-object :body (js-array
      (js-object :kind "intrinsic" :value "host-identity-token" :children (if (= children undefined) (js-array operand) children))))))))))
  (test "original corpus duplicateIndex clones the actual operand including all source fields without modifying the retained source" (lambda ()
    (let* ((retained (results)) (original (get (js-call retained :get "source") :ir))
           (changed (JSON/parse (resolveOriginalCorpusRequest (recipe 0) retained)))
           (children (get (aref (get changed :body) 0) :children)))
      (js-call assert :deepEqual children (js-array operand operand))
      (js-call assert :equal (get (js-call retained :get "source") :ir) original)
      (js-call assert :notEqual (aref children 0) (aref children 1))
      (put (get (get (aref children 1) :span) :start) :column 100)
      (js-call assert :equal (get (get (get (aref children 0) :span) :start) :column) 7)
      (js-call assert :equal (get (get (get (aref (get (aref (get (JSON/parse original) :body) 0) :children) 0) :span) :start) :column) 7))))
  (test "original corpus duplicateIndex resolves an index reference and retains prior ordinary patch behavior" (lambda ()
    (let ((retained (results)))
      (js-call retained :set "index" (js-object :value 0))
      (let ((value (JSON/parse (resolveOriginalCorpusRequest (recipe (js-object :$compilerCorpusRef "index.value")) retained))))
        (js-call assert :deepEqual (get (aref (get value :body) 0) :children) (js-array operand operand)))
      (let* ((patched (resolveOriginalCorpusRequest (js-object :$compilerCorpusJsonPatch (js-array (js-object :$compilerCorpusRef "source.ir") (js-array
        (js-object :path (js-array "body" 0 "children") :append operand)
        (js-object :path (js-array "body" 0 "value") :value "unchanged-transport") (js-object :path (js-array "zero") :negativeZero t)))) retained))
             (output (JSON/parse patched)))
        (js-call assert :deepEqual (get (aref (get output :body) 0) :children) (js-array operand operand))
        (js-call assert :equal (get (aref (get output :body) 0) :value) "unchanged-transport") (funcall assert (Object/is (get output :zero) (js* "-0")))))))
  (test "original corpus duplicateIndex refuses non-array targets invalid indices and ambiguous patch operations" (lambda ()
    (let ((indices (js-array -1 1 2 1.5 globalThis.Infinity globalThis.NaN "0" nil undefined false (js-object) (js-array))))
      (js-call indices :forEach (lambda (index) (js-call assert :throws (lambda () (resolveOriginalCorpusRequest (recipe index) (results))) globalThis.TypeError (funcall globalThis.String index)))))
    (js-call (js-array (js-array) (js-object) nil "not-an-array" 0) :forEach
      (lambda (children) (js-call assert :throws (lambda () (resolveOriginalCorpusRequest (recipe 0) (results children))) globalThis.TypeError)))
    (js-call (js-array (js-object :append operand) (js-object :value (js-array)) (js-object :negativeZero t) (js-object :negativeZero false)) :forEach
      (lambda (extra) (js-call assert :throws (lambda () (resolveOriginalCorpusRequest (recipe 0 extra) (results))) globalThis.TypeError)))
    (js-call assert :throws (lambda () (resolveOriginalCorpusRequest (recipe "length") (results))) globalThis.TypeError)
    (js-call assert :throws (lambda () (resolveOriginalCorpusRequest (recipe "__proto__") (results))) globalThis.TypeError)))
)
