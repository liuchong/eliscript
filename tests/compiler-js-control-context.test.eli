(module tests.compiler-js-control-context.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" readFile readdir mkdtemp mkdir writeFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "./helpers/control-context-contract.mjs" truth oracle checkBoundary asyncOracle discardedOracle timeline checkSequential sequentialAsyncOracle)
  (defvar directory undefined) (defvar compiler undefined)
  (defconst source "\n(defun control (n)\n  (let ((index 0) (total 0) (trace (js-array)))\n    (while (< index n)\n      (if (= (% index 2) 0)\n          (progn (js-call trace :push \"even\") (setq total (+ total index)))\n        (progn (js-call trace :push \"odd\") (setq total (- total index))))\n      (when (= index 1) (js-call trace :push \"when\") (setq total (+ total 4)))\n      (unless (= index 2) (js-call trace :push \"unless\") (setq total (+ total 1)))\n      (cond ((= index 0) (js-call trace :push \"zero\") (setq total (+ total 2)))\n            ((= index 3) (js-call trace :push \"three\") (setq total (+ total 3)))\n            (t (setq total (+ total 0))))\n      (setq index (1+ index)))\n    (if (> n 2) (progn (js-call trace :push \"large\") (js-array total trace))\n      (progn (js-call trace :push \"small\") (js-array total trace)))))\n(defun sugar (value) (when value (progn 1 value)))\n(defun inverse (value) (unless value (progn 2 value)))\n(defun choose (value) (cond ((= value 1) (progn 2 \"one\")) ((= value 2)) (t \"other\")))\n(defun absent (value) (if value 7))\n(export control sugar inverse choose absent)")
  (defconst boundarySource "\n(defun scopes ()\n  (let ((x 9) (functions (js-array)))\n    (if t (let ((x 2) (outer x)) (js-call functions :push (lambda () (js-array x outer)))))\n    (when t (let* ((x (1+ x)) (next (1+ x))) (js-call functions :push (lambda () next))))\n    (unless false (let ((x 7)) (js-call functions :push (lambda () x))))\n    (cond (t (let ((x 4)) (js-call functions :push (lambda () x))))\n          (t (js-call functions :push (lambda () 99))))\n    (js-array x (js-call functions :map (lambda (function) (funcall function))))))\n(defun values (v log)\n  (js-array (if v (progn (js-call log :push \"yes\") 4) (progn (js-call log :push \"no\") 5))\n            (when v (js-call log :push \"when\") 6)\n            (unless v (js-call log :push \"unless\") 7)\n            (cond ((= v 1) (js-call log :push \"one\") 8) (t (js-call log :push \"other\") 9))))\n(defun thrown (v log)\n  (try\n    (progn (if v (progn (js-call log :push \"before\") (throw v))\n               (progn (js-call log :push \"fallback\") 9))\n           (js-call log :push \"after\") 17)\n    (catch error (js-call log :push \"caught\") error)\n    (finally (js-call log :push \"finally\"))))\n(defun branches (value log)\n  (cond ((progn (js-call log :push \"first\") (= value 0)) (js-call log :push \"zero\") 0)\n        ((progn (js-call log :push \"second\") (= value 1)) (js-call log :push \"one\") 1)))\n(defasync asynchronous (flag log)\n  (js-call log :push \"outer\")\n  (if flag (progn (js-call log :push \"branch\") (await (Promise/resolve 3))\n                  (js-call log :push \"resume\") 7)\n    (progn (js-call log :push \"else\") 8)))\n(defasync discarded-async (flag log)\n  (if flag (progn (js-call log :push \"branch\") (await (Promise/resolve 3))\n                  (js-call log :push \"resume\") 7))\n  (js-call log :push \"after\") 9)\n(export scopes values thrown branches asynchronous discarded-async)")
  (defconst sequentialSource "\n(defun compact (state callback)\n  (let* ((source (aref state \"source\")) (index (aref state \"index\"))\n         (next (+ index 1)) (code (js-call source :codePointAt index))\n         (answer (funcall callback code)))\n    (js-array source index next code (js* \"!!answer\"))))\n(defun forward () (let ((later 9)) (let* ((first later) (later 2)) (js-array first later))))\n(defun self () (let ((x 4)) (let* ((x (1+ x)) (y (1+ x))) (js-array x y))))\n(defun closure-forward () (let ((later 9)) (let* ((read (lambda () later)) (later 2)) (funcall read))))\n(defun closure-self () (let ((read (lambda () \"outer\"))) (let* ((read (lambda () (funcall read))) (value (funcall read))) value)))\n(defun raw-forward () (let ((later 9)) (let* ((first (js* \"later\")) (later 2)) (js-array first later))))\n(defun write-forward () (let ((later 9)) (let* ((first (setq later 3)) (later 2)) (js-array first later))))\n(defun reserved () (let* ((class 7) (next (+ class 1))) (js-array class next)))\n(defun captures ()\n  (let ((index 0) (callbacks (js-array)))\n    (while (< index 3)\n      (let* ((snapshot index) (next (+ snapshot 1))) (js-call callbacks :push (lambda () (js-array snapshot next))))\n      (setq index (1+ index)))\n    (js-call callbacks :map (lambda (callback) (funcall callback)))))\n(export compact forward self closure-forward closure-self raw-forward write-forward reserved captures)")
  (defconst sequentialAsyncSource "\n(defasync ordered (log)\n  (let* ((first (await (Promise/resolve 1))) (second (await (Promise/resolve 2))))\n    (js-call log :push \"body\") (js-array first second)))\n(export ordered)")
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-control-context-"))))
    (let* ((out (resolve directory "bootstrap")) (child (spawnSync (resolve "bin/eliscript-bootstrap") (js-array)
      (js-object :encoding "utf8" :timeout 30000 :env (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR out))))))
      (js-call assert :equal (get child :status) 0 (get child :stderr)) (setq compiler (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve out "compiler.mjs")) :href)))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defasync load (code) (funcall (js* "(url) => import(url)") (str "data:text/javascript;base64," (js-call (Buffer/from code) :toString "base64"))))
  (defun bodies (code) (js-call code :slice (js-call code :indexOf "\nfunction control(")))
  (defun each (items callback) (js-call items :forEach callback))
  (defasync hostChecks (mode output)
    (each (js-array "node" "bun") (lambda (host)
      (let ((child (spawnSync host (js-array (resolve "tests/fixtures/control-context-host.mjs") mode (get (pathToFileURL output) :href)) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (str host ": " (get child :stderr)))))))
  (test "discarded and returning if, when, unless and cond emit statement blocks without branch IIFEs" (lambda ()
    (let* ((code (js-call compiler :compile_string source "control.eli")) (body (bodies code)))
      (assert (js-call body :includes "if (")) (assert (not (js-call body :includes "=>")) body)
      (assert (not (js-call body :includes " ? ")) body) (assert (js-call body :includes "return null;")))))
  (test "all control contexts agree with independent effects, null and Lisp truth semantics" (async ()
    (let ((m (await (load (js-call compiler :compile_string source "control.eli")))))
      (each (js-array -1 0 1 2 3 4 10 3.5 globalThis.NaN "3") (lambda (n) (js-call assert :deepEqual (js-call m :control n) (oracle n))))
      (each (js-array false nil undefined t 0 (js* "-0") "" globalThis.NaN (js-array) (js-object)) (lambda (value)
        (assert (Object/is (js-call m :sugar value) (if (truth value) value nil))) (assert (Object/is (js-call m :inverse value) (if (truth value) nil value)))
        (js-call assert :equal (js-call m :absent value) (if (truth value) 7 nil))))
      (each (js-array 1 2 0 nil) (lambda (value) (js-call assert :equal (js-call m :choose value) (if (= value 1) "one" (if (= value 2) nil "other"))))))))
  (test "statement branches retain nested lexical scopes, sequential bindings, captured closures, operand values, throws and clause effects" (async ()
    (let* ((code (js-call compiler :compile_string boundarySource "boundary.eli")) (m (await (load code))))
      (checkBoundary m) (assert (js-call code :includes " ? ") "branches in Array operands must retain value expressions")
      (js-call assert :throws (lambda () (js-call compiler :compile_string "(defun bad () (let* ((x 1) (x 2)) x))" "duplicate.eli")) (new globalThis.RegExp "duplicate local binding")))))
  (test "async conditional branches retain their original await IIFE and promise scheduling boundaries" (async ()
    (let* ((code (js-call compiler :compile_string boundarySource "boundary.eli")) (m (await (load code))) (flags (js-array t false 0 "" nil)) (index 0))
      (assert (js-call code :includes "await (async () =>") "async sequence boundary must remain")
      (while (< index (get flags :length))
        (let ((flag (aref flags index))) (js-call assert :deepEqual (await (timeline (get m :asynchronous) flag)) (await (timeline asyncOracle flag)))
          (js-call assert :deepEqual (await (timeline (get m :discarded_async) flag)) (await (timeline discardedOracle flag)))) (setq index (1+ index))))))
  (test "Node and Bun independently verify conditional effects, closures and async microtask scheduling" (async ()
    (let ((file (resolve directory "boundary.mjs")))
      (await (writeFile file (js-call compiler :compile_string boundarySource "boundary.eli"))) (await (hostChecks "boundary" file)))))
  (test "public Seed and all thirteen compiler modules retain three-generation JS and Source Map fixed points" (async ()
    (let ((input (resolve directory "control.eli")) (output (resolve directory "control.mjs")))
      (await (writeFile input source))
      (let ((seeded (spawnSync (resolve "bin/eliscript-seed") (js-array "--source-map" "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get seeded :status) 0 (get seeded :stderr)))
      (let* ((first (js-call compiler :compile_string_with_source_map source input "control.mjs" "control.eli"))
             (files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort))
             (current compiler) (canonical undefined) (generation 0))
        (js-call assert :equal (await (readFile output "utf8")) (str (get first :javascript) "//# sourceMappingURL=control.mjs.map\n"))
        (js-call assert :deepEqual (JSON/parse (await (readFile (str output ".map") "utf8"))) (JSON/parse (get first :sourceMap)))
        (js-call assert :equal (get files :length) 13)
        (while (< generation 3)
          (let ((out (resolve directory (str "g" generation))) (artifacts (js-array)) (index 0))
            (await (mkdir out))
            (while (< index (get files :length))
              (let* ((file (aref files index)) (filename (resolve "bootstrap/compiler" file)) (text (await (readFile filename "utf8")))
                     (target (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs")) (program (js-call current :compile_ir_string text filename))
                     (saved (JSON/stringify program)) (emission (js-call current :emit_ir_string_with_source_map program text target file)))
                (js-call assert :equal (JSON/stringify program) saved) (js-call artifacts :push (js-array file (get emission :javascript) (get emission :sourceMap)))
                (await (writeFile (resolve out target) (get emission :javascript)))) (setq index (1+ index)))
            (if canonical (js-call assert :deepEqual artifacts canonical) (setq canonical artifacts))
            (let ((emitted (js-call current :compile_string_with_source_map source input "control.mjs" "control.eli")))
              (js-call assert :deepEqual emitted first) (checkBoundary (await (load (js-call current :compile_string boundarySource "boundary.eli")))))
            (setq current (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve out "compiler.mjs")) :href)))))
          (setq generation (1+ generation)))))) 30000)
  (test "safe sequential initializers share a direct declaration block without temporary copies or nested per-binding scopes" (lambda ()
    (let* ((code (js-call compiler :compile_string sequentialSource "sequential.eli")) (body (js-call code :slice (js-call code :indexOf "\nfunction compact(") (js-call code :indexOf "\nfunction forward("))))
      (assert (js-call body :includes "let source = (state)[\"source\"];") body) (assert (js-call body :includes "let answer = callback(code);") body)
      (assert (not (js-call body :includes "const __eliscript_value_")) body))))
  (test "sequential grouping preserves outer self and forward references, closure captures, raw initializers, writes, reserved names, per-iteration scopes and failures" (async ()
    (let ((code (js-call compiler :compile_string sequentialSource "sequential.eli")))
      (checkSequential (await (load code)))
      (each (js-array "forward" "self" "closure_forward" "closure_self" "raw_forward" "write_forward") (lambda (name)
        (let* ((start (js-call code :indexOf (str "\nfunction " name "("))) (next (js-call code :indexOf "\nfunction " (1+ start))) (body (js-call code :slice start (if (< next 0) undefined next))))
          (assert (js-call body :includes "const __eliscript_value_") (str name " requires its original scope boundary"))))))))
  (test "sequential await scopes retain the original async IIFE boundaries and microtask order" (async ()
    (let* ((code (js-call compiler :compile_string sequentialAsyncSource "sequential-async.eli")) (m (await (load code))))
      (assert (js-call code :includes "return (await (async (first) =>"))
      (js-call assert :deepEqual (await (timeline (lambda (_ log) (js-call m :ordered log)) t)) (await (timeline sequentialAsyncOracle t))))))
  (test "public Seed, Node, Bun and three compiler generations agree on safe and unsafe sequential scope cases" (async ()
    (let* ((text (str sequentialSource "\n" sequentialAsyncSource)) (input (resolve directory "sequential.eli")) (output (resolve directory "sequential.mjs")))
      (await (writeFile input text))
      (let ((child (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000)))) (js-call assert :equal (get child :status) 0 (get child :stderr)))
      (let* ((code (js-call compiler :compile_string text input)) (current compiler)
             (files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort)) (generation 0))
        (js-call assert :equal (await (readFile output "utf8")) code) (await (hostChecks "sequential" output))
        (while (< generation 3)
          (js-call assert :equal (js-call current :compile_string text input) code) (checkSequential (await (load (js-call current :compile_string sequentialSource "sequential.eli"))))
          (let ((out (resolve directory (str "sequential-g" generation))) (index 0))
            (await (mkdir out))
            (while (< index (get files :length))
              (let* ((file (aref files index)) (filename (resolve "bootstrap/compiler" file)))
                (await (writeFile (resolve out (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs")) (js-call current :compile_string (await (readFile filename "utf8")) filename)))) (setq index (1+ index)))
            (setq current (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve out "compiler.mjs")) :href)))))
          (setq generation (1+ generation)))))) 30000)
)
