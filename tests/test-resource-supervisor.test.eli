(module tests.test-resource-supervisor.test
  (import "bun:test" expect test)
  (import "node:process" :default process)
  (import "node:child_process" execFileSync spawn)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" join resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/testing/resource-supervisor.mjs" collectOwnedProcesses evaluateResourceUsage parseProcessSnapshot resourceLimits startResourceSupervisor TREE_RSS_LIMIT TOTAL_RSS_LIMIT SAMPLE_MS)
  (import "../tools/testing/file-workers.mjs" isExclusiveTestFile scheduleTestFiles)
  (import "../tools/testing/guarded-command.mjs" parseProtectedCommandArgs)
  (defconst birth "Fri Oct 16 08:00:00 2026")
  (defconst blocked (resolve (js* "import.meta.dir") "fixtures/resource-guard-blocked.mjs"))
  (defconst driverHost (get (pathToFileURL (resolve (js* "import.meta.dir") "fixtures/resource-guard-runner-host.mjs")) :href))
  (defun row (pid ppid pgid rss command &rest __host_default_arguments_1)
    (let* ((born (aref __host_default_arguments_1 0))) (str pid " " ppid " " pgid " " rss " " (if (= born undefined) birth born) " " command)))
  (defun root (pid token &rest __host_default_arguments_2)
    (let* ((id (aref __host_default_arguments_2 0))) (js-object :pid pid :token token :id (if (= id undefined) (funcall globalThis.String pid) id) :known (new globalThis.Map))))
  (defun pause (ms) (new globalThis.Promise (lambda (resolve) (globalThis.setTimeout resolve ms))))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun refuses (operation) (js-call (expect operation) :toThrow))
  (defun each (items callback) (js-call items :forEach callback))
  (defasync eachAsync (items callback) (let ((index 0)) (while (< index (get items :length)) (await (funcall callback (aref items index))) (setq index (1+ index)))))
  (defasync waitFor (read description)
    (let ((deadline (+ (Date/now) 4000)) (found undefined))
      (while (and (< (Date/now) deadline) (= found undefined))
        (try (let ((value (await (funcall read)))) (when (funcall (js* "(value) => !!value") value) (setq found value))) (catch error nil))
        (when (= found undefined) (await (pause 25))))
      (if (not (= found undefined)) found (throw (new globalThis.Error (str "timed out waiting for " description))))))
  (defun running (pid)
    (try (js-call process :kill pid 0)
      (not (js-call (js-call (execFileSync "ps" (js-array "-p" (funcall globalThis.String pid) "-o" "stat=") (js-object :encoding "utf8" :stdio (js-array "ignore" "pipe" "ignore"))) :trim) :startsWith "Z"))
      (catch error false)))
  (test "generic protected commands preserve arguments and cannot raise resource ceilings" (lambda ()
    (same (parseProtectedCommandArgs (js-array "--" "bun" "test" "a.test.mjs" "--" "-1") (js-object))
      (js-object :command "bun" :args (js-array "test" "a.test.mjs" "--" "-1") :limits (js-object :treeBytes TREE_RSS_LIMIT :totalBytes TOTAL_RSS_LIMIT)))
    (same (parseProtectedCommandArgs (js-array "--tree-rss-bytes" "1024" "--total-rss-bytes" "2048" "--" "make" "test") (js-object))
      (js-object :command "make" :args (js-array "test") :limits (js-object :treeBytes 1024 :totalBytes 2048)))
    (each (js-array (js-array) (js-array "bun" "test") (js-array "--") (js-array "--unguarded" "--" "node")
      (js-array "--tree-rss-bytes" "0" "--" "node") (js-array "--tree-rss-bytes" (funcall globalThis.String (1+ TREE_RSS_LIMIT)) "--" "node")
      (js-array "--tree-rss-bytes" "1" "--tree-rss-bytes" "2" "--" "node"))
      (lambda (args) (refuses (lambda () (parseProtectedCommandArgs args (js-object))))))
    (refuses (lambda () (parseProtectedCommandArgs (js-array "--tree-rss-bytes" "2048" "--" "node") (js-object :ELISCRIPT_TEST_TREE_RSS_BYTES "1024"))))
    (be (get (get (parseProtectedCommandArgs (js-array "--" "make" "test") (js-object :ELISCRIPT_TEST_TREE_RSS_BYTES "1024")) :limits) :treeBytes) 1024)))
  (test "RSS protection defaults are fixed ceilings and overrides can only lower them" (lambda ()
    (same (resourceLimits) (js-object :treeBytes 8589934592 :totalBytes 8589934592))
    (js-call (expect SAMPLE_MS) :toBeGreaterThanOrEqual 50) (js-call (expect SAMPLE_MS) :toBeLessThanOrEqual 100)
    (same (resourceLimits (js-object :treeBytes 1024 :totalBytes 2048)) (js-object :treeBytes 1024 :totalBytes 2048))
    (each (js-array (js-object :treeBytes (1+ TREE_RSS_LIMIT)) (js-object :totalBytes (1+ TOTAL_RSS_LIMIT)) (js-object :treeBytes 0) (js-object :totalBytes -1) (js-object :treeBytes 1.1) (js-object :treeBytes "invalid"))
      (lambda (options) (refuses (lambda () (resourceLimits options)))))))
  (test "process snapshots require complete valid data and retain birth identities" (lambda ()
    (same (js-call (parseProcessSnapshot (row 100 1 100 7 "node guard token")) :get 100) (js-object :pid 100 :ppid 1 :pgid 100 :rssBytes 7168 :birth birth :command "node guard token"))
    (each (js-array "" "100 1 100 not-a-number" (str (row 100 1 100 1 "node") "\n" (row 100 1 100 2 "node"))) (lambda (invalid) (refuses (lambda () (parseProcessSnapshot invalid)))))))
  (test "owned trees include detached descendants and retain them after reparenting without claiming recycled PIDs" (lambda ()
    (let* ((owned (root 100 "private-token")) (rows (parseProcessSnapshot (js-call (js-array (row 100 1 100 1 "node guard private-token") (row 101 100 100 2 "bun test") (row 102 101 102 3 "browser") (row 900 1 900 4 "unrelated developer")) :join "\n"))))
      (same (js-call (Array/from (js-call (collectOwnedProcesses rows owned (get owned :known)) :keys)) :sort) (js-array 100 101 102))
      (setq rows (parseProcessSnapshot (js-call (js-array (row 102 1 102 3 "browser") (row 100 1 100 50 "unrelated developer" "Fri Oct 16 08:00:01 2026") (row 103 100 100 50 "unrelated child") (row 900 1 900 4 "unrelated developer")) :join "\n")))
      (same (Array/from (js-call (collectOwnedProcesses rows owned (get owned :known)) :keys)) (js-array 102))
      (setq rows (parseProcessSnapshot (row 102 1 102 100 "recycled browser PID" "Fri Oct 16 08:00:02 2026")))
      (be (get (collectOwnedProcesses rows owned (get owned :known)) :size) 0))))
  (test "RSS boundaries preserve equality, enforce both budgets, and count each live PID once" (lambda ()
    (let ((roots (js-array (root 100 "one") (root 200 "two")))
          (rows (parseProcessSnapshot (js-call (js-array (row 100 1 100 0 "node guard one") (row 101 100 100 1 "bun test") (row 200 1 200 0 "node guard two") (row 201 200 200 1 "bun test")) :join "\n"))))
      (js-call (expect (get (evaluateResourceUsage rows roots (js-object :treeBytes 1024 :totalBytes 2048)) :violation)) :toBeNull)
      (js-call (expect (get (evaluateResourceUsage rows roots (js-object :treeBytes 1023 :totalBytes 2048)) :violation)) :toMatchObject (js-object :kind "tree" :id "100" :rssBytes 1024 :limitBytes 1023))
      (js-call (expect (get (evaluateResourceUsage rows roots (js-object :treeBytes 1024 :totalBytes 2047)) :violation)) :toMatchObject (js-object :kind "aggregate" :rssBytes 2048 :limitBytes 2047))
      (be (get (evaluateResourceUsage rows (js-array (aref roots 0) (aref roots 0)) (js-object :treeBytes 1024 :totalBytes 1024)) :totalBytes) 1024))))
  (test "resource failure stops queued dispatch and preserves completed original file outcomes" (async ()
    (let* ((files (js-array "a.test.mjs" "b.test.mjs" "c.test.mjs" "tests/compiler-browser-session.test.mjs")) (starts (js-array)) (complete (new globalThis.Map))
           (supervisor (js-object :failure nil :cancel (lambda () undefined) :run (lambda (request) (js-call starts :push (get request :file))
             (new globalThis.Promise (lambda (resolve) (js-call complete :set (get request :file) resolve))))))
           (pending (scheduleTestFiles files supervisor)))
      (same starts (js-call files :slice 0 2)) (put supervisor :failure (js-object :failure "resource-limit" :exitCode 1))
      (funcall (js-call complete :get (aref files 0)) (js-object :exitCode 1 :failure "resource-limit" :resource (js-object :kind "tree" :rssBytes 2 :limitBytes 1)))
      (funcall (js-call complete :get (aref files 1)) (js-object :exitCode 1 :failure "resource-limit"))
      (let ((result (await pending)))
        (be (get result :exitCode) 1) (same starts (js-call files :slice 0 2))
        (same (js-call (get result :results) :map (lambda (item) (get item :file))) (js-call files :slice 0 2))
        (js-call (expect (aref (get result :results) 0)) :toMatchObject (js-object :failure "resource-limit" :resource (js-object :limitBytes 1))))
      (each (js-array "compiler-package-session" "compiler-session-tools" "compiler-browser-session" "compiler-matrix-original-gates" "browser-matrix" "package-surface" "wasm-memory-runtime" "native-memory-data-copy" "seed-symbol-reservation" "managed-stdlib-value-json")
        (lambda (file) (be (isExclusiveTestFile (str "tests/" file ".test.mjs")) t))))))
  (test "a one-byte test ceiling kills a real small process without allocating a large buffer" (async ()
    (let ((pid undefined) (supervisor undefined))
      (try
        (setq supervisor (await (startResourceSupervisor (js-object :limits (js-object :treeBytes 1) :onStart (lambda (message) (setq pid (get message :pid)))))))
        (let ((result (await (js-call supervisor :run (js-object :id "small-limit" :file "small-limit.test.mjs" :command "node" :args (js-array blocked "small") :cwd (js-call process :cwd) :env (get process :env))))))
          (js-call (expect pid) :toBeGreaterThan 0) (js-call (get (expect (get result :exitCode)) :not) :toBe 0)
          (be (get result :failure) "resource-limit") (be (get (get result :resource) :limitBytes) 1)
          (await (waitFor (lambda () (not (running pid))) "limited process to be reclaimed")) (be (get (get supervisor :failure) :failure) "resource-limit"))
        (finally (unless (nullish? supervisor) (await (js-call supervisor :close))))))) 10000)
  (defasync markerPids (parentMarker childMarker)
    (Promise/all (js-call (js-array parentMarker childMarker) :map (async (file) (funcall globalThis.Number (await (readFile file "utf8")))))))
  (defasync cancelTreeCase (action)
    (let ((directory (await (mkdtemp (join (tmpdir) "eliscript-resource-guard-")))) (supervisor undefined) (pids (js-array)))
      (try
        (let ((parentMarker (join directory "parent")) (childMarker (join directory "child")))
          (setq supervisor (await (startResourceSupervisor)))
          (let ((pending (js-call supervisor :run (js-object :id action :file "blocked.test.mjs" :command "node" :args (js-array blocked "parent" parentMarker childMarker) :cwd (js-call process :cwd) :env (get process :env)))))
            (setq pids (await (waitFor (async () (markerPids parentMarker childMarker)) "both small blocked descendants")))
            (if (= action "guard-killed") (js-call process :kill (get supervisor :pid) "SIGKILL") (js-call supervisor :cancel action))
            (let ((result (await pending)))
              (js-call (get (expect (get result :exitCode)) :not) :toBe 0)
              (await (waitFor (lambda () (js-call pids :every (lambda (pid) (not (running pid))))) "the entire owned tree to be reclaimed"))
              (unless (= action "guard-killed") (be (get result :exitCode) (if (= action "SIGINT") 130 143)))
              (js-call (get (expect (get supervisor :failure)) :not) :toBeNull))))
        (finally
          (unless (nullish? supervisor) (await (js-call supervisor :close)))
          (await (rm directory (js-object :recursive t :force t)))))))
  (test "cancellation and guard loss reclaim blocked test processes and their owned descendants"
    (async () (await (eachAsync (js-array "SIGINT" "SIGTERM" "guard-killed") cancelTreeCase))) 20000)
  (defasync abnormalRunnerCase ()
    (let ((directory (await (mkdtemp (join (tmpdir) "eliscript-resource-parent-")))) (driver undefined) (pid undefined) (driverExit undefined) (driverError undefined) (stderr ""))
      (try
        (let ((marker (join directory "pid")))
          ;; Only this transport retains JavaScript; both algorithm bodies are Eli.
          (setq driver (spawn "node" (js-array "--input-type=module" "--eval" "import(process.argv[1]);" driverHost marker blocked) (js-object :stdio (js-array "ignore" "ignore" "pipe"))))
          (js-call (get driver :stderr) :setEncoding "utf8")
          (js-call (get driver :stderr) :on "data" (lambda (chunk) (setq stderr (js-call (str stderr chunk) :slice -65536))))
          (let* ((ended (new globalThis.Promise (lambda (resolve)
                   (js-call driver :once "exit" (lambda (code signal) (setq driverExit (js-object :code code :signal signal)) (resolve)))
                   (js-call driver :once "error" (lambda (error) (setq driverError error) (resolve))))))
                 (deadline (+ (Date/now) 4000)))
            (while (and (< (Date/now) deadline) (not (> pid 0)))
              (try (setq pid (funcall globalThis.Number (await (readFile marker "utf8")))) (catch error nil))
              (unless (> pid 0)
                (when (or driverExit driverError) (throw (new globalThis.Error "runner exited before owned child startup")))
                (await (pause 25))))
            (unless (> pid 0) (throw (new globalThis.Error "timed out waiting for owned child startup")))
            (await ended)
            (same driverExit (js-object :code nil :signal "SIGKILL"))
            (await (waitFor (lambda () (not (running pid))) "runner-disconnected test reclamation"))))
        (catch error
          (let* ((exit (if (nullish? driverExit) nil driverExit))
                 (message (if (nullish? driverError) undefined (get driverError :message)))
                 (diagnostics (str "driver status=" (JSON/stringify exit) "; spawn error=" (if (nullish? message) "none" message) "; stderr:\n" (if (= stderr "") "(empty)" stderr))))
            (throw (new globalThis.Error (str (get error :message) "\n" diagnostics) (js-object :cause error)))))
        (finally
          (unless (nullish? driver) (js-call driver :kill "SIGKILL"))
          (await (rm directory (js-object :recursive t :force t)))))))
  (test "abnormal runner exit disconnects independent guards and leaves no live test tree" (async () (await (abnormalRunnerCase))) 10000)
  (test "missing external monitor runtime fails closed before starting any test" (async ()
    (await (js-call (get (expect (startResourceSupervisor (js-object :node "eliscript-test-node-does-not-exist"))) :rejects) :toThrow))))
)
