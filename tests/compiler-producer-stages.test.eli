(module tests.compiler-producer-stages.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "./compiler-producer-rig.mjs" buildCompilerProducer)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst requestedHost (let ((value (get (get globalThis.process :env) :ELISCRIPT_STAGE_PRODUCER_HOST))) (if (nullish? value) "wasm" value)))
  (defconst addSource "(defun add (a b) (+ a b)) (export add)")
  (defconst sources (js-array "(defun add (a b) (+ a b)) (export add)" "(defmacro twice (x) `(+ ,x ,x)) (defun add (a b) (+ (twice a) b)) (export add)"))
  (defconst numericCases (js-array (js-array 20 22) (js-array -1 1) (js-array (js* "-0") (js* "-0"))
    (js-array globalThis.Infinity (- globalThis.Infinity)) (js-array globalThis.Number.MIN_VALUE 0)))
  (defvar fixture undefined) (defvar reader undefined) (defvar expander undefined) (defvar analyzer undefined) (defvar lower undefined)
  (defvar stages (js-array)) (defvar collectBetween false) (defvar rejectStage undefined)
  (beforeAll (async ()
    (funcall assert (js-call (js-array "wasm" "native") :includes requestedHost) "unknown requested compiler host")
    (setq fixture (await (buildCompilerProducer (js-object :producerHost requestedHost :onStage (lambda (event)
      (js-call stages :push event)
      (when (and collectBetween (js-call (get event :stage) :endsWith "-ready")) (js-call (get fixture :a) :collect))
      (when (= (get event :stage) rejectStage) (throw (new globalThis.Error (str "observer failure " rejectStage)))))))))
    (let ((modules (await (Promise/all (js-call (js-array "reader" "expander" "analyzer" "lower") :map
      (lambda (name) (funcall load-module (get (pathToFileURL (resolve (get fixture :directory) "bootstrap" (str name ".mjs"))) :href))))))))
      (setq reader (aref modules 0) expander (aref modules 1) analyzer (aref modules 2) lower (aref modules 3)))) 120000)
  (afterAll (async () (when (funcall host-truth fixture) (await (js-call fixture :close)))))
  (defun release (&rest values) (js-call values :forEach (lambda (value) (js-call (get fixture :a) :release value))))
  (defun kind (value) (if (nullish? value) undefined (get value :kind)))
  (defun observedError (error)
    (when (not (= (kind error) 13)) (throw error))
    (let ((out (js-object :name undefined :message undefined :eliscriptDiagnostic undefined)) (a (get fixture :a)))
      (try
        (js-call (js-array "name" "message" "eliscriptDiagnostic") :forEach (lambda (key)
          (let ((name (js-call a :string key)) (value undefined))
            (try
              (setq value (js-call a :objectGet error name))
              (cond ((= (kind value) 5) (put out key (js-call a :readString value)))
                ((= key "eliscriptDiagnostic") (put out key (if (= value undefined) undefined (readDiagnostic value)))))
              (finally (release name value))))))
        out (finally (release error)))))
  (defun readDiagnostic (value)
    (let* ((result (js-object)) (a (get fixture :a)) (keys (js-call a :objectKeys value)) (index 0))
      (try
        (while (< index (js-call a :length keys))
          (let* ((key (js-call a :get keys index)) (child (js-call a :objectGet value key)))
            (try
              (put result (js-call a :readString key) (cond ((= (kind child) 13) (readDiagnostic child))
                ((= (kind child) 5) (js-call a :readString child)) ((= (kind child) 4) (js-call a :readNumber child)) (t child)))
              (finally (release key child))))
          (setq index (1+ index)))
        (finally (release keys)))
      result))
  (defun expectedError (fn)
    (try (funcall fn) (js-call assert :fail "expected source failure")
      (catch error (js-object :name (get error :name) :message (get error :message) :eliscriptDiagnostic (get error :eliscriptDiagnostic)))))
  (defun checkFailure (fn oracle)
    (let ((error undefined))
      (try (funcall fn) (js-call assert :fail "expected managed source failure") (catch caught (setq error caught)))
      (js-call assert :deepEqual (observedError error) (expectedError oracle))))
  (test "stage harness reexports actual Reader expander analyzer lower and canonical serializer functions" (lambda ()
    (js-call assert :equal (get fixture :producerHost) requestedHost "requested compiler execution host must be real")
    (js-call (js-array "read_string" "expand_module" "analyze_module" "lower_module" "serialize_ir_program") :forEach (lambda (name)
      (let ((fn (js-call (get fixture :a) :getExport name)))
        (try (js-call assert :equal (get fn :kind) 18 name) (finally (release fn))))))))
  (test "opaque stage roots retain real macro semantics through collection and feed exact executable WASM and native products" (async ()
    (let ((a (get fixture :a)) (index 0))
      (setq collectBetween t)
      (try
        (while (< index (get sources :length))
          (setq stages (js-array))
          (let* ((source (aref sources index)) (filename "staged.eli")
                 (program (js-call fixture :compileStages source filename))
                 (backend (get fixture :backend))
                 (expected (js-call (get backend :compiler) :compile_ir_string source filename)))
            (try
              (js-call assert :equal (js-call fixture :serializeIR program) (js-call (get backend :compiler) :serialize_ir_program expected))
              (js-call assert :deepEqual (js-call (js-call stages :filter (lambda (event) (js-call (get event :stage) :endsWith "-ready"))) :map (lambda (event) (get event :stage)))
                (js-array "read-ready" "expand-ready" "analyze-ready" "lower-ready" "serialize-ready"))
              (let* ((wasm (js-call fixture :emitProductIR "wasm" program)) (module (new globalThis.WebAssembly.Module wasm))
                     (product (get (new globalThis.WebAssembly.Instance module) :exports))
                     (javascript (js-call (get backend :compiler) :emit_ir_string expected))
                     (js (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64")))))
                     (wasmPath (resolve (get fixture :directory) (str "stage-" (get source :length) ".wasm")))
                     (jsPath (resolve (get fixture :directory) (str "stage-" (get source :length) ".mjs"))))
                (js-call assert :deepEqual wasm (Uint8Array/from (js-call (get backend :wasm) :emit_numeric_wasm expected)))
                (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports module) (js-array))
                (js-call numericCases :forEach (lambda (args) (funcall assert (Object/is (Reflect/apply (get product :add) product args) (Reflect/apply (get js :add) js args)))))
                (await (writeFile wasmPath wasm)) (await (writeFile jsPath javascript))
                (let ((node (spawnSync "node" (js-array "tests/fixtures/compiler-stage-products-host.mjs" wasmPath (get (pathToFileURL jsPath) :href))
                              (js-object :encoding "utf8" :timeout 10000))))
                  (js-call assert :equal (get node :status) 0 (get node :stderr)))
                (js-call assert :deepEqual (js-call fixture :emitProductIR "native-object" program)
                  (Uint8Array/from (js-call (get backend :native) :emit_native_numeric_object expected "arm64-macos")))
                (when (and (= (get globalThis.process :platform) "darwin") (= (get globalThis.process :arch) "arm64"))
                  (let* ((bytes (js-call fixture :emitProductIR "native-library" program))
                         (path (resolve (get fixture :directory) (str "staged-" (get source :length) ".dylib")))
                         (ffi (await (funcall load-module "bun:ffi"))))
                    (js-call assert :deepEqual bytes (Uint8Array/from (js-call (get backend :native) :emit_native_numeric_library expected "arm64-macos")))
                    (await (writeFile path bytes))
                    (let ((native (js-call ffi :dlopen path (js-object :add (js-object :args (js-array "f64" "f64") :returns "f64")))))
                      (try
                        (js-call (js-call numericCases :slice 0 3) :forEach (lambda (args)
                          (funcall assert (Object/is (Reflect/apply (get (get native :symbols) :add) (get native :symbols) args) (Reflect/apply (get js :add) js args)))))
                        (finally (js-call native :close)))))))
              (finally (release program)))
            (js-call a :collect) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
          (setq index (1+ index)))
        (finally (setq collectBetween false))))) 30000)
  (test "all source stages preserve original failures caller roots and recovery without leaking syntax or IR roots" (lambda ()
    (let* ((a (get fixture :a)) (filename "stage-error.eli") (backend (get fixture :backend)))
      (checkFailure (lambda () (js-call fixture :compileStages "(" "warm.eli")) (lambda () (js-call (get backend :compiler) :compile_ir_string "(" "warm.eli")))
      (let ((warm (js-call fixture :compileStages addSource filename))) (js-call fixture :serializeIR warm) (release warm))
      (js-call a :collect)
      (let* ((held (js-call a :number (js* "-0"))) (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 held) (js-call a :collect)
        (let ((baseline (js-call a :live)))
          (try
            (js-call (js-array "(defun broken (" "(defmacro bad () missing) (bad)" "missing") :forEach (lambda (source)
              (checkFailure (lambda () (js-call fixture :compileStages source filename)) (lambda () (js-call (get backend :compiler) :compile_ir_string source filename)))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1) (funcall assert (Object/is (js-call a :readNumber held) (js* "-0")))
              (js-call a :collect) (js-call assert :equal (js-call a :live) baseline source)))
            (let* ((source "(defun f ([1]) nil)") (text (js-call a :string source)) (file (js-call a :string filename))
                   (forms (js-call a :invoke "read_string" (js-array text file))))
              (try (checkFailure (lambda () (js-call fixture :invokeStage "lower" (js-array forms file))) (lambda () (js-call lower :lower_module (js-call reader :read_string source filename) filename)))
                (finally (release text file forms))))
            (checkFailure (lambda () (js-call fixture :serializeIR nil)) (lambda () (js-call (get backend :compiler) :serialize_ir_program nil)))
            (let* ((source "(defun text () \"not numeric\") (export text)") (unsupported (js-call fixture :compileStages source filename)))
              (try (checkFailure (lambda () (js-call fixture :emitProductIR "wasm" unsupported)) (lambda () (js-call (get backend :wasm) :emit_numeric_wasm (js-call (get backend :compiler) :compile_ir_string source filename))))
                (finally (release unsupported))))
            (js-call a :collect) (js-call assert :equal (js-call a :live) baseline)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1) (funcall assert (Object/is (js-call a :readNumber held) (js* "-0")))
            (let ((recovered (js-call fixture :compileStages addSource filename)))
              (try (js-call assert :equal (js-call (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (js-call fixture :emitProductIR "wasm" recovered))) :exports) :add 20 22) 42)
                (finally (release recovered))))
            (finally (js-call a :leaveFrame caller) (release held))))))))
  (test "stage observer failures release every returned opaque root including aliased analysis results" (lambda ()
    (let ((a (get fixture :a)) (filename "observer.eli"))
      (js-call a :collect)
      (let ((baseline (js-call a :live)))
        (js-call (js-array "read-ready" "expand-ready" "analyze-ready" "lower-ready") :forEach (lambda (stage)
          (setq rejectStage stage)
          (try (js-call assert :throws (lambda () (js-call fixture :compileStages addSource filename)) (new globalThis.RegExp (str "observer failure " stage)))
            (finally (setq rejectStage undefined)))
          (js-call a :collect) (js-call assert :equal (js-call a :live) baseline stage) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))
  (test "serialization and backend observer failures release returned roots while retaining the caller IR" (lambda ()
    (let* ((a (get fixture :a)) (program (js-call fixture :compileStages addSource "observer-products.eli")))
      (try
        (js-call fixture :serializeIR program) (js-call a :collect)
        (let ((baseline (js-call a :live)))
          (js-call (js-array (js-array "serialize-ready" (lambda () (js-call fixture :serializeIR program)))
              (js-array "emit-wasm-ready" (lambda () (js-call fixture :emitProductIR "wasm" program))))
            :forEach (lambda (pair)
              (let ((stage (aref pair 0)) (invoke (aref pair 1)))
                (setq rejectStage stage)
                (try (js-call assert :throws invoke (new globalThis.RegExp (str "observer failure " stage))) (finally (setq rejectStage undefined)))
                (js-call a :collect) (js-call assert :equal (js-call a :live) baseline stage) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
          (js-call assert :equal (js-call (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (js-call fixture :emitProductIR "wasm" program))) :exports) :add 20 22) 42))
        (finally (release program))))))
  (when (and (= requestedHost "wasm") (not (= (get (get globalThis.process :env) :ELISCRIPT_STAGE_PRODUCER_CHILD) "1")))
    (funcall (js-call test :skipIf (or (not (= (get globalThis.process :platform) "darwin")) (not (= (get globalThis.process :arch) "arm64"))))
      "the same five stage tests execute in a real native compiler host" (lambda ()
        (let ((child (spawnSync (get globalThis.process :execPath) (js-array "test" (resolve "tests/compiler-producer-stages.test.mjs"))
          (js-object :cwd (resolve ".") :encoding "utf8" :timeout 180000 :maxBuffer 4194304
            :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_STAGE_PRODUCER_HOST "native" :ELISCRIPT_STAGE_PRODUCER_CHILD "1"))))))
          (when (funcall host-truth (get child :stdout)) (js-call (get globalThis.process :stdout) :write (get child :stdout)))
          (when (funcall host-truth (get child :stderr)) (js-call (get globalThis.process :stderr) :write (get child :stderr)))
          (js-call assert :equal (get child :error) undefined (str "native stage child: " (let ((error (get child :error))) (if (nullish? error) undefined (get error :message)))))
          (js-call assert :equal (get child :signal) nil)
          (js-call assert :equal (get child :status) 0 "native compiler stage suite must pass unchanged")
          (js-call assert :match (get child :stderr) (new globalThis.RegExp "5 pass")) (js-call assert :match (get child :stderr) (new globalThis.RegExp "0 fail")))) 190000))
)
