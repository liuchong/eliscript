(module tests.wasm-managed-text-format.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:child_process" spawnSync)
  (import "node:crypto" createHash)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-text-format-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime
        (js-call (get b :compiler) :compile_ir_string
                 (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                 "runtime.eli")))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (defasync compile-case (source)
    (let* ((p (js-call (get b :compiler) :compile_ir_string (str "(defconst marker 1) " source) "text-format.eli"))
           (before (JSON/stringify p))
           (js (await (funcall dyn-import
                               (str "data:text/javascript;base64,"
                                    (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p))
                                             :toString "base64")))))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))))
      (js-call assert :equal (JSON/stringify p) before)
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-object :a a :js js :bytes bytes))))

  (defun finish-heap (a)
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun box-val (a x)
    (let ((ty (funcall js-typeof x)))
      (cond
        ((= ty "number") (js-call a :number x))
        ((= ty "string") (js-call a :string x))
        (t x))))

  (defun read-strings (a array)
    (Array/from (js-object :length (js-call a :length array))
      (lambda (_ i)
        (let ((value (js-call a :get array i)))
          (try
            (if (undefined? value) undefined (js-call a :readString value))
            (finally (js-call a :release value)))))))

  (test "Given Unicode strings, when default upper and lower casing runs, then expansions, context and UTF16 agree with JS"
    (async ()
      (let* ((ctx (await (compile-case "(defun upper (value) (js-call value :toUpperCase)) (defun lower (value) (js-call value :toLowerCase)) (export upper lower)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (values (js-array "" "0123_ascii_Z" "ßﬃİıſ" "ΑΣ" "ΑΣΑ"
                               (str "AΣ" (String/fromCharCode 769))
                               (str "AΣ" (String/fromCharCode 769) "B")
                               (str "AΣ" (String/fromCharCode 837))
                               (str "A" (String/fromCharCode 837) "Σ")
                               "Σ" "ΣA" "ΣΣ"
                               (str (String/fromCharCode 837) "Σ")
                               "ᾀᾈΐῒῗ" "ქართულიႠᲐ" "𐐀𐐨😀中"
                               (str (String/fromCharCode 55296) "A" (String/fromCharCode 57343) "Σ")))
             (state 1371752999)
             (i 0))
        (while (< i 256)
          (let ((s "")
                (j 0))
            (while (< j 12)
              (setq state (unsigned-bit-shift-right (+ (Math/imul state 1664525) 1013904223) 0))
              (setq s (str s (String/fromCharCode (unsigned-bit-shift-right state 16))))
              (setq j (+ j 1)))
            (js-call values :push s))
          (setq i (+ i 1)))
        (js-call values :forEach
          (lambda (value)
            (let ((input (js-call a :string value)))
              (js-call (js-array "upper" "lower") :forEach
                (lambda (name)
                  (let ((out (js-call a :invoke name (js-array input))))
                    (js-call assert :equal (js-call a :readString out) (funcall (aref js name) value))
                    (js-call assert :equal (js-call a :readString input) value)
                    (js-call a :release out))))
              (js-call a :release input))))
        (finish-heap a))))

  (test "Given UTF16 strings and primitive arguments, when start and end padding run, then exact code units and default rules agree"
    (async ()
      (let* ((ctx (await (compile-case "(defun start (value length fill) (js-call value :padStart length fill)) (defun end (value length fill) (js-call value :padEnd length fill)) (export start end)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array "" "x" "中😀" (String/fromCharCode 55296)) :forEach
          (lambda (value)
            (js-call (js-array undefined nil false t globalThis.NaN -0.0 -5 0.9 1.9 6 " 7 ") :forEach
              (lambda (len)
                (js-call (js-array undefined nil false 0 "" "0" "ab" "😀" (String/fromCharCode 57343)) :forEach
                  (lambda (fill)
                    (let ((input (js-call a :string value))
                          (cnt (box-val a len))
                          (filler (box-val a fill)))
                      (js-call (js-array "start" "end") :forEach
                        (lambda (name)
                          (let ((out (js-call a :invoke name (js-array input cnt filler))))
                            (js-call assert :equal (js-call a :readString out) (funcall (aref js name) value len fill))
                            (js-call a :release out))))
                      (js-call (js-array input cnt filler) :forEach (lambda (x) (js-call a :release x))))))))))
        (finish-heap a))))

  (test "Given the entire Unicode scalar range, when both case mappings run in bounded chunks, then every exact JS result agrees"
    (async ()
      (let* ((ctx (await (compile-case "(defun upper (value) (js-call value :toUpperCase)) (defun lower (value) (js-call value :toLowerCase)) (export upper lower)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (checked 0)
             (start 0))
        (while (< start 1114112)
          (let ((points (js-array))
                (pt start)
                (lim (Math/min (+ start 512) 1114112)))
            (while (< pt lim)
              (when (or (< pt 55296) (> pt 57343))
                (js-call points :push pt))
              (setq pt (+ pt 1)))
            (let* ((text (apply String/fromCodePoint points))
                   (input (js-call a :string text)))
              (setq checked (+ checked (get points :length)))
              (js-call (js-array "upper" "lower") :forEach
                (lambda (name)
                  (let ((out (js-call a :invoke name (js-array input))))
                    (js-call assert :equal (js-call a :readString out) (funcall (aref js name) text) (str name " scalar block " start))
                    (js-call a :release out))))
              (js-call a :release input)))
          (setq start (+ start 512)))
        (js-call assert :equal checked 1112064)
        (finish-heap a))))

  (test "Given effectful arguments and conversion hooks, when padding is unnecessary, then arguments run but filler conversion is skipped"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (size) (let* ((trace (js-object :calls 0)) (fill (js-object :toString (lambda () (put trace :calls (+ (get trace :calls) 100)) \"ab\")))) (js-array (js-call \"x\" :padStart (progn (put trace :calls (1+ (get trace :calls))) size) (progn (put trace :calls (+ (get trace :calls) 10)) fill)) (get trace :calls)))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array 0 1 2 6) :forEach
          (lambda (sz)
            (let* ((n (js-call a :number sz))
                   (out (js-call a :invoke "f" (js-array n)))
                   (txt (js-call a :get out 0))
                   (calls (js-call a :get out 1)))
              (js-call assert :deepEqual (js-array (js-call a :readString txt) (js-call a :readNumber calls)) (js-call js :f sz))
              (js-call (js-array n out txt calls) :forEach (lambda (x) (js-call a :release x)))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
        (finish-heap a))))

  (test "Given invalid receivers, when a text method is looked up, then failure precedes argument effects and releases its frame"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (value trace) (js-call value :padStart (progn (put trace :calls 1) 7) \"0\")) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array nil undefined) :forEach
          (lambda (value)
            (let ((trace (js-call a :sourceObject (js-object))))
              (js-call assert :throws (lambda () (js-call js :f value (js-object))) globalThis.TypeError)
              (js-call assert :throws
                (lambda () (js-call a :invoke "f" (js-array value trace)))
                (lambda (e) (diag-code? e "ELI-RT0003")))
              (let* ((key (js-call a :string "calls"))
                     (calls (js-call a :objectGet trace key)))
                (js-call assert :equal calls undefined)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                (js-call (js-array trace key calls) :forEach (lambda (x) (js-call a :release x)))))))
        (finish-heap a))))

  (test "Given object length arguments, when padding converts them, then valueOf precedes toString and each hook runs once"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (fallback) (let* ((trace (js-object :calls 0)) (length (js-object :valueOf (lambda () (put trace :calls (1+ (get trace :calls))) (if fallback (js-object) 4)) :toString (lambda () (put trace :calls (+ (get trace :calls) 10)) \"5\")))) (js-array (js-call \"x\" :padEnd length \"ab\") (get trace :calls)))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array false t) :forEach
          (lambda (fallback)
            (let* ((out (js-call a :invoke "f" (js-array fallback)))
                   (txt (js-call a :get out 0))
                   (cnt (js-call a :get out 1)))
              (js-call assert :deepEqual (js-array (js-call a :readString txt) (js-call a :readNumber cnt)) (js-call js :f fallback))
              (js-call (js-array out txt cnt) :forEach (lambda (x) (js-call a :release x))))))
        (finish-heap a))))

  (test "Given noncallable or object-returning hooks, when padding converts arguments, then fallback and failure preserve source order"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (fail) (let* ((trace (js-object :calls 0)) (length (js-object :valueOf false :toString (lambda () (put trace :calls (1+ (get trace :calls))) \"4\"))) (fill (js-object :toString (lambda () (put trace :calls (+ (get trace :calls) 10)) (js-object)) :valueOf (lambda () (put trace :calls (+ (get trace :calls) 100)) (if fail (js-object) 7))))) (js-array (js-call \"x\" :padStart length fill) (get trace :calls)))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (out (js-call a :invoke "f" (js-array false)))
             (txt (js-call a :get out 0))
             (cnt (js-call a :get out 1)))
        (js-call assert :deepEqual (js-array (js-call a :readString txt) (js-call a :readNumber cnt)) (js-call js :f false))
        (js-call (js-array out txt cnt) :forEach (lambda (x) (js-call a :release x)))
        (js-call assert :throws (lambda () (js-call js :f t)) globalThis.TypeError)
        (js-call assert :throws
          (lambda () (js-call a :invoke "f" (js-array t)))
          (lambda (e) (diag-code? e "ELI-RT0003")))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (finish-heap a))))

  (test "Given case mapping with an ignored argument, when the method executes, then that argument still has its single effect"
    (async ()
      (let* ((ctx (await (compile-case "(defun f () (let ((trace (js-object :calls 0))) (js-array (js-call \"ßΣ\" :toUpperCase (progn (put trace :calls (1+ (get trace :calls))) nil)) (js-call \"AΣ\" :toLowerCase (progn (put trace :calls (1+ (get trace :calls))) nil)) (get trace :calls)))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (out (js-call a :invoke "f"))
             (upper (js-call a :get out 0))
             (lower (js-call a :get out 1))
             (cnt (js-call a :get out 2)))
        (js-call assert :deepEqual
          (js-array (js-call a :readString upper) (js-call a :readString lower) (js-call a :readNumber cnt))
          (js-call js :f))
        (js-call (js-array out upper lower cnt) :forEach (lambda (x) (js-call a :release x)))
        (finish-heap a))))

  (test "Given identical WASM bytes in independent Node, when every scalar is cased, then Node JS agrees and all roots are released"
    (async ()
      (let* ((ctx (await (compile-case "(defun upper (value) (js-call value :toUpperCase)) (defun lower (value) (js-call value :toLowerCase)) (export upper lower)")))
             (a (get ctx :a))
             (bytes (get ctx :bytes))
             (file (resolve directory "unicode-case.wasm"))
             (runner (resolve "tests/helpers/wasm-managed-text-format-node.mjs"))
             (sha (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")))
        (finish-heap a)
        (await (writeFile file bytes))
        (let ((child (spawnSync "node"
                                (js-array runner "scalars" file sha)
                                (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0
                   (if (= (get child :stderr) "")
                     (if (nullish? (get child :error)) "" (get (get child :error) :message))
                     (get child :stderr)))))))

  (test "Given exhausted case-output storage, when allocation fails, then the caller frame and original UTF16 survive recovery"
    (async ()
      (let* ((ctx (await (compile-case "(defun upper (value) (js-call value :toUpperCase)) (export upper)")))
             (a (get ctx :a))
             (bytes (get ctx :bytes)))
        (finish-heap a)
        (let* ((small (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 8192)))
               (raw-input (str "ß😀" (String/fromCharCode 55296)))
               (input nil)
               (outer nil)
               (held (js-array))
               (exhausted false)
               (i 0))
          (js-call small :auto 1)
          (setq input (js-call small :string raw-input))
          (setq outer (js-call small :frame 1))
          (js-call small :frameSet outer 0 input)
          (while (and (< i 128) (not exhausted))
            (try
              (js-call held :push (js-call small :number i))
              (catch e
                (js-call assert :equal (if (nullish? (get e :eliscriptDiagnostic)) undefined (get (get e :eliscriptDiagnostic) :code)) "ELI-RT0002")
                (setq exhausted t)))
            (setq i (+ i 1)))
          (funcall assert exhausted)
          (js-call assert :throws
            (lambda () (js-call small :invoke "upper" (js-array input)))
            (lambda (e) (diag-code? e "ELI-RT0002")))
          (js-call assert :equal (get (js-call small :stats) :frameDepth) 1)
          (js-call assert :equal (js-call small :readString input) raw-input)
          (js-call held :forEach (lambda (v) (js-call small :release v)))
          (js-call small :collect)
          (let ((out (js-call small :invoke "upper" (js-array input))))
            (js-call assert :equal (js-call small :readString out) (str "SS😀" (String/fromCharCode 55296)))
            (js-call small :release out))
          (js-call small :leaveFrame outer)
          (js-call small :release input)
          (finish-heap small)))))

  (test "Given literal search text, when replaceAll runs, then all nonoverlapping UTF16 matches and substitution tokens agree with JS"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (text search replacement) (js-call text :replaceAll search replacement)) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array "" "aaaaa" (str "a😀a" (String/fromCharCode 55296)) "a/b/c" "a.$b") :forEach
          (lambda (txt)
            (js-call (js-array "" "aa" "a" "/" (String/fromCharCode 55357) nil undefined) :forEach
              (lambda (search)
                (js-call (js-array "" "X" "$&" "$$-$1-$0" "$`|$'" "中😀") :forEach
                  (lambda (replacement)
                    (let* ((input (js-call a :string txt))
                           (key (box-val a search))
                           (ins (js-call a :string replacement))
                           (out (js-call a :invoke "f" (js-array input key ins))))
                      (js-call assert :equal (js-call a :readString out) (js-call js :f txt search replacement))
                      (js-call (js-array input key ins out) :forEach (lambda (x) (js-call a :release x))))))))))
        (finish-heap a))))

  (test "Given a replacement callback, when every literal match runs, then offsets use UTF16 and every callback sees the original text"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (text search) (let ((trace (js-object :calls 0))) (js-array (js-call text :replaceAll search (lambda (match index original) (put trace :calls (1+ (get trace :calls))) (str \"<\" match \":\" index \":\" original \">\"))) (get trace :calls)))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array "" "aaaa" "a😀a") :forEach
          (lambda (txt)
            (js-call (js-array "" "a" "aa" "no") :forEach
              (lambda (search)
                (let* ((input (js-call a :string txt))
                       (key (js-call a :string search))
                       (out (js-call a :invoke "f" (js-array input key)))
                       (res (js-call a :get out 0))
                       (calls (js-call a :get out 1)))
                  (js-call assert :deepEqual (js-array (js-call a :readString res) (js-call a :readNumber calls)) (js-call js :f txt search))
                  (js-call (js-array input key out res calls) :forEach (lambda (x) (js-call a :release x)))
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))
        (finish-heap a))))

  (test "Given effectful search and replacement conversions, when replaceAll finds no match or many matches, then each conversion runs once"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (text) (let* ((trace (js-object :calls 0)) (search (js-object :toString (lambda () (put trace :calls (1+ (get trace :calls))) \"a\"))) (replacement (js-object :toString (lambda () (put trace :calls (+ (get trace :calls) 10)) \"X\")))) (js-array (js-call text :replaceAll search replacement) (get trace :calls)))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array "" "none" "aaaa") :forEach
          (lambda (txt)
            (let* ((input (js-call a :string txt))
                   (out (js-call a :invoke "f" (js-array input)))
                   (res (js-call a :get out 0))
                   (calls (js-call a :get out 1)))
              (js-call assert :deepEqual (js-array (js-call a :readString res) (js-call a :readNumber calls)) (js-call js :f txt))
              (js-call (js-array input out res calls) :forEach (lambda (x) (js-call a :release x))))))
        (finish-heap a))))

  (test "Given literal separators and uint32 limits, when split runs, then empty boundaries and UTF16 slices match JS exactly"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (text separator limit) (js-call text :split separator limit)) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array "" "aaa" "a/b/c/" "a😀b" (str (String/fromCharCode 55296) "x" (String/fromCharCode 57343))) :forEach
          (lambda (txt)
            (js-call (js-array undefined nil "" "/" "aa" (String/fromCharCode 55357) "x") :forEach
              (lambda (separator)
                (js-call (js-array undefined nil -1 -0.0 0 1 2.9 4294967297 "2" globalThis.NaN globalThis.Infinity) :forEach
                  (lambda (lim)
                    (let* ((input (js-call a :string txt))
                           (sep (box-val a separator))
                           (cnt (box-val a lim))
                           (out (js-call a :invoke "f" (js-array input sep cnt))))
                      (js-call assert :deepEqual (read-strings a out) (js-call js :f txt separator lim))
                      (js-call (js-array input sep cnt out) :forEach (lambda (x) (js-call a :release x))))))))))
        (finish-heap a))))

  (test "Given represented regular expressions, when split runs, then captures, anchors and Unicode empty matches retain exact JS meaning"
    (async ()
      (let ((expressions (js-array "/a*/" "/(a)?b/" "/(a)|(b)/" "/(?:)/" "/(?:)/u" "/^|$/m" "/[,\\u2028]/u" "/(😀)?/u"))
            (ei 0))
        (while (< ei (get expressions :length))
          (let* ((expression (aref expressions ei))
                 (ctx (await (compile-case (str "(defun f (text limit) (js-call text :split (js* " (JSON/stringify expression) ") limit)) (export f)"))))
                 (a (get ctx :a))
                 (js (get ctx :js)))
            (js-call (js-array "" "a" "abbb" "a😀b" "x\nx" (str (String/fromCharCode 55296 57343) ",x")) :forEach
              (lambda (txt)
                (js-call (js-array undefined 0 1 2 8) :forEach
                  (lambda (lim)
                    (let* ((input (js-call a :string txt))
                           (cnt (box-val a lim))
                           (out (js-call a :invoke "f" (js-array input cnt))))
                      (js-call assert :deepEqual (read-strings a out) (js-call js :f txt lim) (str expression " " (JSON/stringify txt)))
                      (js-call (js-array input cnt out) :forEach (lambda (x) (js-call a :release x))))))))
            (finish-heap a))
          (setq ei (+ ei 1))))))

  (test "Given conversion hooks, when split has any limit including zero, then limit conversion precedes separator text conversion"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (size) (let* ((trace (js-object :calls 0)) (limit (js-object :valueOf (lambda () (put trace :calls (1+ (get trace :calls))) size))) (separator (js-object :toString (lambda () (put trace :calls (+ (get trace :calls) 10)) \"/\")))) (js-array (js-call \"a/b/c\" :split separator limit) (get trace :calls)))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js)))
        (js-call (js-array 0 1 2 -1) :forEach
          (lambda (sz)
            (let* ((cnt (js-call a :number sz))
                   (out (js-call a :invoke "f" (js-array cnt)))
                   (parts (js-call a :get out 0))
                   (calls (js-call a :get out 1)))
              (js-call assert :deepEqual (js-array (read-strings a parts) (js-call a :readNumber calls)) (js-call js :f sz))
              (js-call (js-array cnt out parts calls) :forEach (lambda (x) (js-call a :release x))))))
        (finish-heap a))))

  (test "Given an unmatched capture, when split inserts undefined, then the result owns that array position instead of creating a hole"
    (async ()
      (let* ((ctx (await (compile-case "(defun f () (let ((parts (js-call \"b\" :split (js* \"/(a)?b/\")))) (js-array (object-has? parts 1) (js* \"typeof parts[1]\")))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (out (js-call a :invoke "f"))
             (first-el (js-call a :get out 0))
             (second-el (js-call a :get out 1)))
        (js-call assert :deepEqual (js-array first-el (js-call a :readString second-el)) (js-call js :f))
        (js-call a :release second-el)
        (js-call a :release out)
        (finish-heap a))))

  (test "Given a captured own replaceAll method, when arguments replace that method, then the captured function runs with all arguments"
    (async ()
      (let* ((ctx (await (compile-case "(defun f () (let ((value (js-object :replaceAll (lambda (a b) (str a \":\" b))))) (js-call value :replaceAll (progn (put value :replaceAll (lambda () \"wrong\")) \"first\") \"second\"))) (export f)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (out (js-call a :invoke "f")))
        (js-call assert :equal (js-call a :readString out) (js-call js :f))
        (js-call a :release out)
        (finish-heap a))))

  (test "Given a nonglobal regular expression, when replaceAll rejects it, then replacement conversion never runs and later calls recover"
    (async ()
      (let* ((ctx (await (compile-case "(defun f (trace) (js-call \"a\" :replaceAll (js* \"/a/\") (js-object :toString (lambda () (put trace :called 1) \"x\")))) (defun recover () (js-call \"aaa\" :replaceAll \"a\" \"b\")) (export f recover)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (trace (js-call a :sourceObject (js-object))))
        (js-call assert :throws (lambda () (js-call js :f (js-object))) globalThis.TypeError)
        (js-call assert :throws
          (lambda () (js-call a :invoke "f" (js-array trace)))
          (lambda (e) (diag-code? e "ELI-RT0003")))
        (let ((key (js-call a :string "called")))
          (js-call assert :equal (js-call a :objectGet trace key) undefined)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
          (let ((out (js-call a :invoke "recover")))
            (js-call assert :equal (js-call a :readString out) "bbb")
            (js-call (js-array trace key out) :forEach (lambda (x) (js-call a :release x)))))
        (finish-heap a))))

  (test "Given fixed random UTF16 strings, when literal split and replacement run under GC, then every exact JS result and input survives"
    (async ()
      (let* ((ctx (await (compile-case "(defun parts (text sep limit) (js-call text :split sep limit)) (defun replace (text sep insert) (js-call text :replaceAll sep insert)) (export parts replace)")))
             (a (get ctx :a))
             (js (get ctx :js))
             (state 1114729139)
             (next-u32 (lambda ()
                         (setq state (unsigned-bit-shift-right (+ (Math/imul state 1664525) 1013904223) 0))
                         state))
             (units (js-array 97 98 0 55296 56320 20013))
             (inserts (js-array "$&" "$`-$'" "$$" "😀"))
             (i 0))
        (while (< i 256)
          (let ((txt "")
                (j 0))
            (while (< j 24)
              (setq txt (str txt (String/fromCharCode (aref units (% (funcall next-u32) 6)))))
              (setq j (+ j 1)))
            (let* ((sep (js-call txt :slice (% (funcall next-u32) 20) (% (funcall next-u32) 24)))
                   (lim (% (funcall next-u32) 12))
                   (ins (aref inserts (% (funcall next-u32) 4)))
                   (input (js-call a :string txt))
                   (key (js-call a :string sep))
                   (cnt (js-call a :number lim))
                   (value (js-call a :string ins))
                   (parts (js-call a :invoke "parts" (js-array input key cnt)))
                   (out (js-call a :invoke "replace" (js-array input key value))))
              (js-call assert :deepEqual (read-strings a parts) (js-call js :parts txt sep lim))
              (js-call assert :equal (js-call a :readString out) (js-call js :replace txt sep ins))
              (js-call assert :equal (js-call a :readString input) txt)
              (js-call (js-array input key cnt value parts out) :forEach (lambda (x) (js-call a :release x)))))
          (setq i (+ i 1)))
        (finish-heap a))))

  (test "Given explicit Unicode data versions, when new case pairs and sigma context run, then each version is exact and remains immutable after heap creation"
    (async ()
      (let* ((ctx (await (compile-case "(defun upper (value) (js-call value :toUpperCase)) (defun lower (value) (js-call value :toLowerCase)) (export upper lower)")))
             (a (get ctx :a))
             (bytes (get ctx :bytes))
             (lower-sample (String/fromCharCode 7305 42955 42959))
             (lower-v16 (String/fromCharCode 7306 612 42959))
             (upper-sample (String/fromCharCode 42959))
             (upper-v17 (String/fromCharCode 42958)))
        (finish-heap a)
        (js-call (js-array 15.1 16 17) :forEach
          (lambda (version)
            (let ((inst (instantiateManagedRuntime bytes (js-object :unicodeVersion version))))
              (js-call assert :equal (get inst :unicodeVersion) version)
              (js-call inst :auto 1)
              (let* ((input (js-call inst :string lower-sample))
                     (out (js-call inst :invoke "lower" (js-array input)))
                     (expected (if (= version 15.1) lower-sample lower-v16)))
                (js-call assert :equal (js-call inst :readString out) expected)
                (js-call inst :release out)
                (js-call inst :release input))
              (let* ((upper-input (js-call inst :string upper-sample))
                     (upper (js-call inst :invoke "upper" (js-array upper-input))))
                (js-call assert :equal (js-call inst :readString upper) (if (= version 17) upper-v17 upper-sample))
                (js-call inst :release upper)
                (js-call inst :release upper-input))
              (finish-heap inst))))
        (js-call (js-array 0 15 18 globalThis.NaN "17" nil) :forEach
          (lambda (version)
            (js-call assert :throws
              (lambda () (instantiateManagedRuntime bytes (js-object :unicodeVersion version)))
              (lambda (e) (diag-code? e "ELI-RT0003"))))))))

  (test "Given every Unicode scalar and version-dependent context, when each pinned profile executes, then normative data hashes and all exact sigma cases agree"
    (async ()
      (let* ((ctx (await (compile-case "(defun upper (value) (js-call value :toUpperCase)) (defun lower (value) (js-call value :toLowerCase)) (export upper lower)")))
             (a (get ctx :a))
             (bytes (get ctx :bytes))
             (reference (JSON/parse (await (readFile "tests/fixtures/unicode-case-profiles.json" "utf8")))))
        (finish-heap a)
        (js-call assert :equal (get reference :format) "eliscript-unicode-case-reference")
        (js-call assert :deepEqual (js-call (get reference :versions) :map (lambda (v) (get v :version))) (js-array 15.1 16 17))
        (js-call (get reference :versions) :forEach
          (lambda (profile)
            (let ((inst (instantiateManagedRuntime bytes (js-object :unicodeVersion (get profile :version))))
                  (hashes (js-object :upper (createHash "sha256") :lower (createHash "sha256")))
                  (checked 0)
                  (start 0))
              (js-call inst :auto 1)
              (while (< start 1114112)
                (let ((points (js-array))
                      (pt start)
                      (lim (Math/min (+ start 512) 1114112)))
                  (while (< pt lim)
                    (when (or (< pt 55296) (> pt 57343))
                      (js-call points :push pt))
                    (setq pt (+ pt 1)))
                  (setq checked (+ checked (get points :length)))
                  (let ((input (js-call inst :string (apply String/fromCodePoint points))))
                    (js-call (js-array "upper" "lower") :forEach
                      (lambda (name)
                        (let ((out (js-call inst :invoke name (js-array input))))
                          (js-call (aref hashes name) :update (js-call inst :readString out) "utf16le")
                          (js-call inst :release out))))
                    (js-call inst :release input)))
                (setq start (+ start 512)))
              (js-call assert :equal checked 1112064)
              (js-call (js-array "upper" "lower") :forEach
                (lambda (name)
                  (js-call assert :equal (js-call (aref hashes name) :digest "hex") (aref profile name) (str (get profile :version) " " name))))
              (js-call (get profile :sigma) :forEach
                (lambda (pair)
                  (let* ((txt (aref pair 0))
                         (expected (aref pair 1))
                         (input (js-call inst :string txt))
                         (out (js-call inst :invoke "lower" (js-array input))))
                    (js-call assert :equal (js-call inst :readString out) expected (str (get profile :version) " sigma " (JSON/stringify txt)))
                    (js-call inst :release out)
                    (js-call inst :release input))))
              (finish-heap inst)))))))

  (test "Given raw runtime configuration, when heaps exist or unsupported versions are selected, then case data cannot change and errors remain recoverable"
    (async ()
      (let* ((ctx (await (compile-case "(defun f () 1) (export f)")))
             (a (get ctx :a))
             (bytes (get ctx :bytes)))
        (finish-heap a)
        (let ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports)))
          (js-call assert :equal (funcall (aref e "runtime-case-version") 0) 170)
          (js-call assert :equal (funcall (aref e "runtime-case-version") 150) 0)
          (js-call assert :equal (funcall (aref e "last-error")) 3)
          (js-call assert :equal (funcall (aref e "runtime-case-version") 160) 160)
          (let ((heap (funcall (aref e "heap-new") 32 1024 65536)))
            (funcall assert heap)
            (js-call assert :equal (funcall (aref e "runtime-case-version") 170) 0)
            (js-call assert :equal (funcall (aref e "last-error")) 3)
            (js-call assert :equal (funcall (aref e "runtime-case-version") 0) 160)
            (js-call assert :equal (funcall (aref e "last-error")) 0)
            (js-call assert :equal (funcall (aref e "heap-live") heap) 0))))))

  (test "Given a ground WASM ABI without case configuration, when host case probing is unavailable, then existing numeric execution still works"
    (async ()
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun runtime-case-version "))
             (end (js-call source :indexOf "  (defun last-error " start)))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((without-def (str (js-call source :slice 0 start) (js-call source :slice end)))
               (ground-src (js-call without-def :replace (new globalThis.RegExp "\\bruntime-case-version(?=\\s+record-new\\b)" "u") "")))
          (js-call assert :notEqual ground-src without-def "remove the ground export independently of adjacent new exports")
          (let* ((ground (js-call (get b :compiler) :compile_ir_string ground-src "ground-runtime.eli"))
                 (prog (js-call (get b :compiler) :compile_ir_string "(defun f () 7) (export f)" "ground.eli"))
                 (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm prog ground)))
                 (file (resolve directory "ground-case.wasm"))
                 (runner (resolve "tests/helpers/wasm-managed-text-format-node.mjs")))
            (js-call assert :equal
              (js-call (WebAssembly.Module/exports (new globalThis.WebAssembly.Module bytes))
                :some (lambda (e) (= (get e :name) "runtime-case-version")))
              false)
            (await (writeFile file bytes))
            (let ((child (spawnSync "node"
                                    (js-array runner "ground-case" file)
                                    (js-object :encoding "utf8" :timeout 30000))))
              (js-call assert :equal (get child :status) 0
                       (if (= (get child :stderr) "")
                         (if (nullish? (get child :error)) "" (get (get child :error) :message))
                         (get child :stderr))))))))))
