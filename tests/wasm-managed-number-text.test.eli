(module tests.wasm-managed-number-text.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/wasm-managed-number-text-node.mjs" verifyNumberMethodBoundary verifyBorrowedNumberBoundary verifyNumberCallFamily)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst to-uint32 (js* "(x) => x >>> 0"))
  (defconst helper-path
    (fileURLToPath (new globalThis.URL "./helpers/wasm-managed-number-text-node.mjs" (get (js* "import.meta") :url))))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-number-text-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get b :compiler) :compile_ir_string
                      (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                      "runtime.eli")))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defasync compiled (source)
    (let* ((p (js-call (get b :compiler) :compile_ir_string (str "(defconst marker 1) " source) "number-text.eli"))
           (before (JSON/stringify p))
           (javascript (js-call (get b :compiler) :emit_ir_string p))
           (js (await (funcall dynamic-import
                        (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64")))))
           (bytes (globalThis.Uint8Array.from (js-call (get b :managed) :emit_managed_wasm p runtime)))
           (a (instantiateManagedRuntime bytes)))
      (js-call assert :equal (JSON/stringify p) before)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-call a :auto 1)
      (js-object :a a :js js :javascript javascript)))

  (defun finish (a)
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun box (a x)
    (cond
      ((= (value-type x) "number") (js-call a :number x))
      ((= (value-type x) "string") (js-call a :string x))
      (t x)))

  (test "Given exact integer Numbers, when toString uses every radix 2 through 36, then WASM equals the existing JS result"
    (async ()
      (let* ((bundle (await (compiled "(defun f (value radix) (js-call value :toString radix)) (export f)")))
             (a (get bundle :a))
             (js (get bundle :js))
             (values (js-array -0.0 0 -1 1 15 16 255 65535 4294967295
                               (get globalThis.Number :MAX_SAFE_INTEGER)
                               (Math/pow 2 53)
                               (- (Math/pow 2 100))
                               (Math/pow 2 1023)
                               (get globalThis.Number :MAX_VALUE))))
        (js-call values :forEach
          (lambda (value)
            (let ((input (js-call a :number value))
                  (radix 2))
              (while (<= radix 36)
                (let* ((base (js-call a :number radix))
                       (out (js-call a :invoke "f" (js-array input base))))
                  (js-call assert :equal (js-call a :readString out) (js-call js :f value radix) (str value " base " radix))
                  (funcall assert (Object/is (js-call a :readNumber input) value))
                  (js-call a :release base)
                  (js-call a :release out))
                (setq radix (1+ radix)))
              (js-call a :release input))))
        (finish a))))

  (test "Given fractional and boundary IEEE values, when radix text is produced, then exact text and input bits are preserved"
    (async ()
      (let* ((bundle (await (compiled "(defun f (value radix) (js-call value :toString radix)) (export f)")))
             (a (get bundle :a))
             (js (get bundle :js))
             (values (js-array (get globalThis.Number :MIN_VALUE)
                               (- (get globalThis.Number :MIN_VALUE))
                               (Math/pow 2 -1022)
                               0.1 -0.1 0.5 (/ 1 3)
                               1.0000000000000002 0.9999999999999999
                               1.0e-7 1.0e21
                               (get globalThis.Number :NaN)
                               (get globalThis.Number :POSITIVE_INFINITY)
                               (get globalThis.Number :NEGATIVE_INFINITY))))
        (js-call values :forEach
          (lambda (value)
            (let ((input (js-call a :number value))
                  (radix 2))
              (while (<= radix 36)
                (let* ((base (js-call a :number radix))
                       (out (js-call a :invoke "f" (js-array input base))))
                  (js-call assert :equal (js-call a :readString out) (js-call js :f value radix) (str value " base " radix))
                  (funcall assert (Object/is (js-call a :readNumber input) value))
                  (js-call a :release base)
                  (js-call a :release out))
                (setq radix (1+ radix)))
              (js-call a :release input))))
        (finish a))))

  (test "Given omitted, undefined and coercible radix values, when Number.toString executes, then existing defaults and integer conversion apply"
    (async ()
      (let* ((bundle (await (compiled "(defun f (value radix) (js-call value :toString radix)) (defun plain (value) (js-call value :toString)) (export f plain)")))
             (a (get bundle :a))
             (js (get bundle :js))
             (value 65535.5)
             (input (js-call a :number value))
             (plain (js-call a :invoke "plain" (js-array input))))
        (js-call assert :equal (js-call a :readString plain) (js-call js :plain value))
        (js-call a :release plain)
        (js-call (js-array undefined "16" " 2 " "0x10" 2.9 35.9 36.9) :forEach
          (lambda (radix)
            (let* ((base (box a radix))
                   (out (js-call a :invoke "f" (js-array input base))))
              (js-call assert :equal (js-call a :readString out) (js-call js :f value radix))
              (js-call a :release base)
              (js-call a :release out))))
        (js-call a :release input)
        (finish a))))

  (test "Given invalid radix values, when conversion fails, then RangeError and caller roots survive and a later call recovers"
    (async ()
      (let* ((bundle (await (compiled "(defun f (value radix) (js-call value :toString radix)) (export f)")))
             (a (get bundle :a))
             (js (get bundle :js))
             (input (js-call a :number -0.0))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 input)
        (js-call (js-array nil false t 0 1 37 -2
                           (get globalThis.Number :NaN)
                           (get globalThis.Number :POSITIVE_INFINITY)
                           (get globalThis.Number :NEGATIVE_INFINITY)
                           "bad")
                 :forEach
                 (lambda (radix)
                   (let ((base (box a radix)))
                     (js-call assert :throws (lambda () (js-call js :f -0.0 radix)) globalThis.RangeError)
                     (js-call assert :throws
                       (lambda () (js-call a :invoke "f" (js-array input base)))
                       (lambda (error) (= (get error :name) "RangeError")))
                     (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                     (funcall assert (Object/is (js-call a :readNumber input) -0.0))
                     (js-call a :release base))))
        (let* ((base (js-call a :number 16))
               (out (js-call a :invoke "f" (js-array input base))))
          (js-call assert :equal (js-call a :readString out) "0")
          (js-call (js-array base out) :forEach (lambda (x) (js-call a :release x))))
        (js-call a :leaveFrame frame)
        (js-call a :release input)
        (finish a))))

  (test "Given a source radix conversion with effects, when toString runs, then arguments and conversion execute exactly once in order"
    (async ()
      (let* ((bundle (await (compiled "(defun f () (let* ((trace (js-object :calls 0)) (radix (js-object :valueOf (lambda () (put trace :calls (+ (get trace :calls) 10)) 16))) (value 255)) (js-array (js-call value :toString (progn (put trace :calls (1+ (get trace :calls))) radix)) (get trace :calls)))) (export f)")))
             (a (get bundle :a))
             (js (get bundle :js))
             (out (js-call a :invoke "f"))
             (text (js-call a :get out 0))
             (count (js-call a :get out 1)))
        (js-call assert :deepEqual (js-array (js-call a :readString text) (js-call a :readNumber count)) (js-call js :f))
        (js-call (js-array out text count) :forEach (lambda (x) (js-call a :release x)))
        (finish a))))

  (test "fixed random binary64 values preserve exact radix strings and original IEEE bits through collecting GC"
    (async ()
      (let* ((bundle (await (compiled "(defun f (value radix) (js-call value :toString radix)) (export f)")))
             (a (get bundle :a))
             (js (get bundle :js))
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (state 1635598995)
             (next-u32 (lambda ()
                         (setq state (funcall to-uint32 (+ (Math/imul state 1664525) 1013904223)))
                         state))
             (i 0))
        (while (< i 256)
          (js-call bits :setUint32 0 (funcall next-u32))
          (js-call bits :setUint32 4 (funcall next-u32))
          (let* ((value (js-call bits :getFloat64 0))
                 (input (js-call a :number value))
                 (radix 2))
            (while (<= radix 36)
              (let* ((base (js-call a :number radix))
                     (out (js-call a :invoke "f" (js-array input base))))
                (js-call assert :equal (js-call a :readString out) (js-call js :f value radix)
                  (str "case " i " value " value " base " radix))
                (funcall assert (Object/is (js-call a :readNumber input) value))
                (js-call a :release base)
                (js-call a :release out))
              (setq radix (1+ radix)))
            (js-call a :release input))
          (setq i (1+ i)))
        (finish a))))

  (test "the same generated Number method calls keep managed radix text and exact input bits in Bun and independent Node"
    (async ()
      (let* ((bundle (await (compiled "(defun f (value radix) (js-call value :toString radix)) (defun dynamic (value key radix) (js-call value key radix)) (export f dynamic)")))
             (a (get bundle :a))
             (js (get bundle :js))
             (javascript (get bundle :javascript))
             (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (samples (js-array))
             (key (js-call a :string "toString"))
             (values (js-array -0.0 0 -1 1 0.1 -0.1 0.5 (/ 1 3) 1.0000000000000002 0.9999999999999999
                               (get globalThis.Number :MIN_VALUE) (- (get globalThis.Number :MIN_VALUE))
                               (Math/pow 2 -1022)
                               (get globalThis.Number :MAX_VALUE) (- (get globalThis.Number :MAX_VALUE))
                               (get globalThis.Number :NaN)
                               (get globalThis.Number :POSITIVE_INFINITY)
                               (get globalThis.Number :NEGATIVE_INFINITY)))
             (state 1897679417)
             (next-u32 (lambda ()
                         (setq state (funcall to-uint32 (+ (Math/imul state 1664525) 1013904223)))
                         state))
             (index 0))
        (while (< index 64)
          (js-call view :setUint32 0 (funcall next-u32))
          (js-call view :setUint32 4 (funcall next-u32))
          (js-call values :push (js-call view :getFloat64 0))
          (setq index (1+ index)))
        (try
          (let ((v-idx 0))
            (while (< v-idx (js-length values))
              (let* ((number (aref values v-idx))
                     (_ (js-call view :setFloat64 0 number))
                     (words (js-array (js-call view :getUint32 0) (js-call view :getUint32 4)))
                     (texts (js-array))
                     (input (js-call a :number number)))
                (try
                  (let ((radix 2))
                    (while (<= radix 36)
                      (let ((base (js-call a :number radix))
                            (result undefined))
                        (try
                          (progn
                            (setq result (js-call a :invoke "f" (js-array input base)))
                            (let ((expected (js-call a :readString result)))
                              (js-call assert :equal (js-call js :f number radix) expected)
                              (js-call assert :equal (js-call js :dynamic number "toString" radix) expected)
                              (when (Number/isInteger number)
                                (js-call assert :equal expected (js-call (globalThis.BigInt number) :toString radix)
                                  "exact integer digits have an independent BigInt oracle"))
                              (let ((dynamic (js-call a :invoke "dynamic" (js-array input key base))))
                                (try
                                  (js-call assert :equal (js-call a :readString dynamic) expected)
                                  (finally (js-call a :release dynamic))))
                              (funcall assert (Object/is (js-call a :readNumber input) number))
                              (js-call texts :push expected)))
                          (finally
                            (unless (undefined? result) (js-call a :release result))
                            (js-call a :release base))))
                      (setq radix (1+ radix))))
                  (finally (js-call a :release input)))
                (js-call samples :push (js-object :words words :texts texts)))
              (setq v-idx (1+ v-idx))))
          (finally
            (js-call a :release key)
            (finish a)))
        (let ((child (spawnSync "node" (js-array helper-path "--verify-samples")
                       (js-object :encoding "utf8" :input (JSON/stringify (js-object :javascript javascript :samples samples))
                                  :timeout 30000 :maxBuffer 65536))))
          (js-call assert :equal (get child :error) undefined)
          (js-call assert :equal (get child :signal) nil)
          (js-call assert :equal (get child :status) 0 (get child :stderr))
          (js-call assert :deepEqual (JSON/parse (get child :stdout))
            (js-object :samples (js-length values) :radices 35)))))
    120000)

  (test "Seed and self-hosted Number method helpers preserve boxed brands lookup arguments overrides and unrelated methods"
    (async ()
      (let* ((source (str "(defun f (value radix) (js-call value :toString radix)) "
                          "(defun effects (value key argument) (js-call value key (funcall argument))) "
                          "(defun extras (value key first second) (js-call value key (funcall first) (funcall second))) (export f effects extras)"))
             (input (resolve directory "number-method-boundary.eli"))
             (output (resolve directory "number-method-boundary.mjs")))
        (await (writeFile input source))
        (let ((child (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input)
                       (js-object :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
          (js-call assert :equal (get child :error) undefined)
          (js-call assert :equal (get child :signal) nil)
          (js-call assert :equal (get child :status) 0 (get child :stderr)))
        (let* ((javascript (js-call (get b :compiler) :compile_string source input))
               (m (await (funcall dynamic-import
                           (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
          (js-call assert :equal (await (readFile output "utf8")) javascript)
          (verifyNumberMethodBoundary m)
          (let ((node (spawnSync "node" (js-array helper-path "--verify-method-boundary")
                        (js-object :encoding "utf8" :input javascript :timeout 30000 :maxBuffer 65536))))
            (js-call assert :equal (get node :error) undefined)
            (js-call assert :equal (get node :signal) nil)
            (js-call assert :equal (get node :status) 0 (get node :stderr))))))
    120000)

  (test "borrowed and bound Number method families preserve native reflection complete array-like reads and exact managed text in Bun and Node"
    (async ()
      (let* ((source (str "(defun via_call (method value radix) (js-call method :call value radix)) "
                          "(defun via_apply (method value values) (js-call method :apply value values)) "
                          "(defun dynamic (method key value values) (js-call method key value values)) "
                          "(defun effects (method key receiver values) (js-call method key (funcall receiver) (funcall values))) "
                          "(defun extra_call (method receiver radix extra) (js-call method :call (funcall receiver) (funcall radix) (funcall extra))) "
                          "(defun call_saved (value radix) (let ((method (get (js* \"Number.prototype\") :toString))) (js-call method :call value radix))) "
                          "(defun apply_saved (value radix) (let ((method (get (js* \"Number.prototype\") :toString))) (js-call method :apply value (js-array radix)))) "
                          "(defun literal_call () (let ((method (get (js* \"Number.prototype\") :toString))) (js-call method :call 0.1 3))) "
                          "(defun nested_call (method value radix) (js-call (get method :call) :call method value radix)) "
                          "(defun nested_apply (method value values) (js-call (get method :apply) :call method value values)) "
                          "(defun call_via_apply (method value radix) (js-call (get method :call) :apply method (js-array value radix))) "
                          "(defun reflect_apply (method value values) (js-call (js* \"Reflect\") :apply method value values)) "
                          "(defun reflect_nested (method value values) (js-call (get (js* \"Reflect\") :apply) :call nil method value values)) "
                          "(defun reflect_dynamic (owner key method value values) (js-call owner key method value values)) "
                          "(defun make_bound (method value) (js-call method :bind value)) "
                          "(defun bind_radix (method value radix) (js-call method :bind value radix)) "
                          "(defun invoke (callback argument) (funcall callback argument)) "
                          "(export via_call via_apply dynamic effects extra_call call_saved apply_saved literal_call nested_call nested_apply call_via_apply reflect_apply reflect_nested reflect_dynamic make_bound bind_radix invoke)"))
             (bundle (await (compiled "(defun f (value radix) (js-call value :toString radix)) (export f)")))
             (a (get bundle :a))
             (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (samples (js-array))
             (values (js-array -0.0 0.1 -0.1 0.5 (/ 1 3)
                               (get globalThis.Number :MIN_VALUE)
                               (get globalThis.Number :MAX_VALUE)
                               (get globalThis.Number :NaN)
                               (get globalThis.Number :POSITIVE_INFINITY))))
        (try
          (let ((v-idx 0))
            (while (< v-idx (js-length values))
              (let* ((value (aref values v-idx))
                     (_ (js-call view :setFloat64 0 value))
                     (words (js-array (js-call view :getUint32 0) (js-call view :getUint32 4)))
                     (texts (js-array))
                     (input (js-call a :number value)))
                (try
                  (let ((radix 2))
                    (while (<= radix 36)
                      (let ((base (js-call a :number radix))
                            (result undefined))
                        (try
                          (progn
                            (setq result (js-call a :invoke "f" (js-array input base)))
                            (js-call texts :push (js-call a :readString result)))
                          (finally
                            (unless (undefined? result) (js-call a :release result))
                            (js-call a :release base))))
                      (setq radix (1+ radix))))
                  (finally (js-call a :release input)))
                (js-call samples :push (js-object :words words :texts texts)))
              (setq v-idx (1+ v-idx))))
          (finally (finish a)))
        (let ((input (resolve directory "number-borrowed-boundary.eli"))
              (output (resolve directory "number-borrowed-boundary.mjs")))
          (await (writeFile input source))
          (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input)
                        (js-object :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
            (js-call assert :equal (get seed :error) undefined)
            (js-call assert :equal (get seed :signal) nil)
            (js-call assert :equal (get seed :status) 0 (get seed :stderr)))
          (let* ((javascript (js-call (get b :compiler) :compile_string source input))
                 (m (await (funcall dynamic-import
                             (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
            (js-call assert :equal (await (readFile output "utf8")) javascript)
            (verifyBorrowedNumberBoundary m samples)
            (verifyNumberCallFamily m samples)
            (let ((node (spawnSync "node" (js-array helper-path "--verify-borrowed-family")
                          (js-object :encoding "utf8"
                                     :input (JSON/stringify (js-object :javascript javascript :samples samples))
                                     :timeout 30000 :maxBuffer 65536))))
              (js-call assert :equal (get node :error) undefined)
              (js-call assert :equal (get node :signal) nil)
              (js-call assert :equal (get node :status) 0 (get node :stderr)))))))
    120000))
