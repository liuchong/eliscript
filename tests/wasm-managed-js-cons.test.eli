(module tests.wasm-managed-js-cons.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar b undefined)
  (defvar rt undefined)
  (defvar p undefined)
  (defvar bytes undefined)
  (defvar directory undefined)
  (defvar js undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-js-cons-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq rt (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq p (js-call (get b :compiler) :compile_ir_string (await (readFile "tests/fixtures/wasm-managed-js-cons.eli" "utf8")) "js-cons.eli"))
    (setq js (await (dynamic-import (str "data:text/javascript;base64,"
                                         (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun artifact (&rest __host_default_arguments_1)
    (let* ((runtime-arg (aref __host_default_arguments_1 0)))
    (let ((runtime (if (undefined? runtime-arg) rt runtime-arg)))
      (if (not (= runtime rt))
        (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))
        (progn
          (when (not bytes)
            (let ((saved (JSON/stringify p)))
              (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p rt)))
              (js-call assert :equal (JSON/stringify p) saved)
              (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))))
          bytes)))))

  (defun instance (&rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)) (runtime-arg (aref __host_default_arguments_2 1)))
    (let* ((runtime (if (undefined? runtime-arg) rt runtime-arg))
           (a (instantiateManagedRuntime (artifact runtime) options)))
      (js-call a :auto 1)
      a)))

  (defun read (a value)
    (cond
      ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 14))
       (let ((out (js-array))
             (i 0))
         (while (< i (js-call a :length value))
           (let ((child (js-call a :get value i)))
             (try (js-call out :push (read a child)) (finally (js-call a :release child))))
           (setq i (1+ i)))
         out))
      (t value)))

  (defun finish (a &rest __host_default_arguments_3)
    (let* ((values-arg (aref __host_default_arguments_3 0)))
    (let ((values (if (undefined? values-arg) (js-array) values-arg)))
      (js-call values :forEach (lambda (v) (js-call a :release v)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defun box (a value)
    (cond
      ((= (value-type value) "number") (js-call a :number value))
      ((= (value-type value) "string") (js-call a :string value))
      ((Array/isArray value)
       (let ((children (js-call value :map (lambda (v) (box a v)))))
         (try
           (js-call a :sourceArray children)
           (finally (js-call children :forEach (lambda (v) (js-call a :release v)))))))
      (t value)))

  (test "Given explicit host prepend when its nullish tail is normalized then js-cons emits zero-import WASM and preserves identity" (lambda ()
    (let* ((a (instance))
           (head (js-call a :sourceObject (js-object :x t)))
           (tail (js-call a :sourceArray (js-array false undefined)))
           (out (js-call a :invoke "prepend" (js-array head tail)))
           (first (js-call a :get out 0)))
      (funcall assert (js-call a :keyEqual first head))
      (js-call assert :equal (js-call a :keyEqual out tail) false)
      (js-call assert :equal (js-call a :length out) 3)
      (js-call assert :equal (js-call a :get out 1) false)
      (js-call assert :equal (js-call a :get out 2) undefined)
      (js-call assert :equal (js-call a :length tail) 2)
      (js-call a :release out)
      (js-call a :release first)
      (js-call (js-array nil undefined) :forEach
        (lambda (nullish-tail)
          (let* ((result (js-call a :invoke "prepend" (js-array head nullish-tail)))
                 (child (js-call a :get result 0)))
            (js-call assert :equal (js-call a :length result) 1)
            (funcall assert (js-call a :keyEqual child head))
            (js-call a :release result)
            (js-call a :release child))
          (let ((raw (js-call a :invoke "raw-nullish" (js-array nullish-tail))))
            (js-call assert :equal (js-call a :readString raw) "TypeError")
            (js-call a :release raw))))
      (finish a (js-array head tail)))))

  (test "Given UTF16 strings sparse arrays and invalid tails when prepending then existing JavaScript values and own slots are retained" (lambda ()
    (let ((a (instance)))
      (js-call (js-array "" "中😀\ud800" (js-array) (js-array 0 -0.0 globalThis.NaN undefined) false 1) :forEach
        (lambda (tail)
          (let* ((input (box a tail))
                 (out (js-call a :invoke "safe" (js-array t input))))
            (js-call assert :equal (js-call a :readString out) (js-call js :safe t tail))
            (js-call a :release input)
            (js-call a :release out))))
      (let ((tail (js-call a :sourceArray (js-array))))
        (js-call a :resize tail 3)
        (let ((out (js-call a :invoke "prepend" (js-array undefined tail)))
              (i 0))
          (js-call assert :deepEqual (read a out) (js-array undefined undefined undefined undefined))
          (while (< i 4)
            (let ((index (js-call a :number i)))
              (js-call assert :equal (js-call a :invoke "own" (js-array out index)) t)
              (js-call a :release index))
            (setq i (1+ i)))
          (finish a (js-array tail out)))))))

  (test "Given throwing operands or custom iterators when js-cons runs then argument order cached next and abrupt-step behavior match JS" (lambda ()
    (let ((a (instance)))
      (js-call (js-array "effects" "protocol") :forEach
        (lambda (name)
          (let ((mode 0))
            (while (< mode 8)
              (let* ((input (js-call a :number mode))
                     (out (js-call a :invoke name (js-array input))))
                (js-call assert :equal (js-call a :readString out) (js-call js name mode) (str name "/" mode))
                (js-call a :release input)
                (js-call a :release out))
              (setq mode (1+ mode))))))
      (finish a))))

  (test "Given frozen inherited indices when constructing a result then own data slots shadow them without changing tail Get" (lambda ()
    (let* ((a (instance))
           (out (js-call a :invoke "frozen-prototype"))
           (node (spawnSync "node"
                   (js-array (resolve "tests/helpers/wasm-managed-js-cons-node.mjs") "vm")
                   (js-object :encoding "utf8" :timeout 10000))))
      (js-call assert :equal (get node :status) 0 (get node :stderr))
      (js-call assert :equal (js-call a :readString out) (js-call (get node :stdout) :trim))
      (finish a (js-array out)))))

  (test "Given malformed arity when the existing intrinsic is compiled then source and IR refuse dropped argument effects" (lambda ()
    (js-call (js-array "(js-cons)" "(js-cons 1)" "(js-cons 1 2 3)") :forEach
      (lambda (source)
        (js-call assert :throws (lambda () (js-call (get b :compiler) :compile_string source "arity.eli")))))
    (let* ((source (js-call (get b :compiler) :compile_ir_string "(defun run () (js-cons 1 nil))" "arity.eli"))
           (children (get (aref (get source :body) 0) :children))
           (node (aref children (- (js-length children) 1))))
      (js-call assert :equal (get node :value) "js-cons")
      (js-call (get node :children) :push (aref (get node :children) 0))
      (js-call assert :throws
        (lambda () (js-call (get b :managed) :emit_managed_wasm source rt))
        (lambda (error) (let ((diag (get error :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-B0001"))))))))

  (test "Given a changed canonical Array iterator and a shadowed Array name when the tail is nullish then its real empty array is iterated" (lambda ()
    (js-call (js-array 0 1) :forEach
      (lambda (mode)
        (let* ((a (instance))
               (input (js-call a :number mode))
               (saved (Object/getOwnPropertyDescriptor globalThis.Array.prototype globalThis.Symbol.iterator))
               (expected undefined))
          (try
            (setq expected (js-call js :nullish_protocol mode))
            (finally
              (Object/defineProperty globalThis.Array.prototype globalThis.Symbol.iterator saved)))
          (let ((out (js-call a :invoke "nullish-protocol" (js-array input))))
            (js-call assert :equal (js-call a :readString out) expected)
            (finish a (js-array input out))))))))

  (test "Given deterministic random binary64 heads and source arrays when prepended then neither IEEE values nor input arrays change" (lambda ()
    (let* ((a (instance))
           (pool (js-array undefined nil t false -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                           globalThis.Number.MIN_VALUE "中😀" "\ud800"))
           (seed 2484544954)
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (round 0))
      (while (< round 128)
        (let* ((head (aref pool (% (funcall next) (js-length pool))))
               (tail (Array/from (js-object :length (% (funcall next) 24))
                       (lambda () (aref pool (% (funcall next) (js-length pool))))))
               (h (box a head))
               (tail-handle (box a tail))
               (out (js-call a :invoke "prepend" (js-array h tail-handle))))
          (js-call assert :deepEqual (read a out) (js-call (js-array head) :concat tail))
          (js-call assert :deepEqual (read a tail-handle) tail)
          (js-call a :release h)
          (js-call a :release tail-handle)
          (js-call a :release out))
        (setq round (1+ round)))
      (finish a))))

  (test "Given raw invalid inputs and each early capacity failure when normalizing a nullish tail then caller roots survive and recovery is exact" (lambda ()
    (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module (artifact))) :exports))
           (h (js-call e "heap-new" 64 16384 131072))
           (call (lambda (name &rest args)
                   (let ((value (uint32 (Reflect/apply (get e name) e (js-call (js-array h) :concat args)))))
                     (js-call assert :equal (js-call e "last-error") 0 name)
                     value)))
           (head (funcall call "value-number" 0 2147483648))
           (unsealed (funcall call "value-string" 1))
           (caller (funcall call "frame-new" 2)))
      (funcall call "frame-set" caller 0 head)
      (funcall call "frame-set" caller 1 unsealed)
      (funcall call "heap-auto" 1)
      (js-call
        (js-array
          (js-array 4294967295 0 1) (js-array head 4294967295 1)
          (js-array caller 0 3) (js-array head caller 3)
          (js-array unsealed 0 6) (js-array head unsealed 6))
        :forEach
        (lambda (triple)
          (js-call assert :equal (js-call e "value-source-js-cons" h (aref triple 0) (aref triple 1)) 0)
          (js-call assert :equal (js-call e "last-error") (aref triple 2))
          (js-call assert :equal (funcall call "frame-depth") 1)
          (js-call assert :equal (funcall call "frame-get" caller 0) head)))
      (let ((padding (js-array)))
        (while (< (funcall call "heap-live") 64)
          (let ((value (funcall call "value-number" 0 0)))
            (funcall call "heap-pin" value)
            (js-call padding :push value)))
        (let ((available 0))
          (while (< available 5)
            (js-call assert :equal (js-call e "value-source-js-cons" h head 0) 0)
            (js-call assert :equal (js-call e "last-error") 2)
            (js-call assert :equal (funcall call "frame-depth") 1)
            (js-call assert :equal (funcall call "frame-get" caller 0) head)
            (funcall call "heap-collect")
            (funcall call "heap-release" (js-call padding :pop))
            (funcall call "heap-collect")
            (setq available (1+ available))))
        (js-call padding :forEach (lambda (value) (funcall call "heap-release" value)))
        (funcall call "heap-collect")
        (let ((result (funcall call "value-source-js-cons" head 0)))
          (funcall call "heap-pin" result)
          (js-call assert :equal (funcall call "value-length" result) 1)
          (js-call assert :equal (funcall call "value-get" result 0) head)
          (let ((pointer (funcall call "value-data" head 4)))
            (funcall assert (Object/is (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 pointer t) -0.0)))
          (funcall call "heap-release" result)
          (funcall call "frame-pop" caller)
          (funcall call "heap-collect")
          (js-call assert :equal (funcall call "heap-live") 0))))))

  (test "Given a real reused-prefix append trap when js-cons runs then source catches cannot swallow it and private frames unwind after argument effects" (async ()
    (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call source :indexOf "  (defun heap-text-array-append "))
           (end (js-call source :indexOf "  (defun " (+ start 10))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call source :slice 0 start)
                              "  (defun heap-text-array-append (heap array child) (load-u32 4294967295))\n"
                              (js-call source :slice end))
                         "js-cons-trap.eli"))
             (a (instance undefined injected))
             (trace (js-call a :sourceArray (js-array)))
             (held (js-call a :number -0.0))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "trap-effects" (js-array trace)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :deepEqual (read a trace) (js-array "head" "tail"))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (funcall assert (Object/is (js-call a :readNumber held) -0.0))
        (let ((recovered (js-call a :invoke "recover")))
          (js-call assert :equal (js-call a :readNumber recovered) 7)
          (js-call a :leaveFrame caller)
          (finish a (js-array trace held recovered)))))))

  (test "Given the same zero-import prepend bytes when Node executes them then nullish UTF16 source errors and dense result slots match its JS oracle" (async ()
    (let ((path (resolve directory "js-cons.wasm")))
      (await (writeFile path (artifact)))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-js-cons-node.mjs")
                               "wasm"
                               (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                               path)
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (funcall
    (js-call test :skipIf (or (not (= (get globalThis.process :platform) "darwin"))
                              (not (= (get globalThis.process :arch) "arm64"))))
    "Given a true native prepend library when the same operands and iterator protocols execute then it retains the original JS contract"
    (async ()
      (let* ((lowered (js-call (get b :managed) :lower_managed_program p rt))
             (path (resolve directory "js-cons.dylib")))
        (await (writeFile path (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
        (let ((a (await (instantiateNativeManagedRuntime path lowered))))
          (js-call a :auto 1)
          (try
            (progn
              (js-call (js-array nil undefined "中😀\ud800" (js-array) (js-array 0 -0.0 globalThis.NaN undefined) false 1) :forEach
                (lambda (tail)
                  (let* ((input (box a tail))
                         (out (js-call a :invoke "safe" (js-array t input))))
                    (js-call assert :equal (js-call a :readString out) (js-call js :safe t tail))
                    (js-call a :release input)
                    (js-call a :release out))))
              (js-call (js-array "effects" "protocol") :forEach
                (lambda (name)
                  (let ((mode 0))
                    (while (< mode 8)
                      (let* ((input (js-call a :number mode))
                             (out (js-call a :invoke name (js-array input))))
                        (js-call assert :equal (js-call a :readString out) (js-call js name mode))
                        (js-call a :release input)
                        (js-call a :release out))
                      (setq mode (1+ mode))))))
              (js-call (js-array 0 1) :forEach
                (lambda (mode)
                  (let* ((input (js-call a :number mode))
                         (saved (Object/getOwnPropertyDescriptor globalThis.Array.prototype globalThis.Symbol.iterator))
                         (expected undefined))
                    (try
                      (setq expected (js-call js :nullish_protocol mode))
                      (finally
                        (Object/defineProperty globalThis.Array.prototype globalThis.Symbol.iterator saved)))
                    (let ((out (js-call a :invoke "nullish-protocol" (js-array input))))
                      (js-call assert :equal (js-call a :readString out) expected)
                      (js-call a :release input)
                      (js-call a :release out))))))
            (finally
              (try (finish a) (finally (js-call a :close))))))))
    30000))
