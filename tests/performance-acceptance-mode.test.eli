(module tests.performance-acceptance-mode.test
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (defun recorder ()
    (let* ((calls (js-array)) (run (lambda (name callback &rest rest)
      (js-call calls :push (js-object :kind "run" :name name :rest rest)) (funcall callback))))
      (put run :skip (lambda (name callback &rest rest) (js-call calls :push (js-object :kind "skip" :name name :rest rest)) undefined))
      (js-object :run run :calls calls)))
  (test "default and every value except the exact opt-in keep current-source performance assertions strict" (lambda ()
    (js-call (js-array (js-object) (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "") (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "0")
      (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "true") (js-object :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE "1")) :forEach (lambda (env)
      (let* ((record (recorder)) (run (get record :run)) (calls (get record :calls)) (strict (currentPerformanceTest run env)))
        (js-call assert :equal strict run)
        (js-call assert :throws (lambda () (funcall strict "current freshness" (lambda () (throw (new globalThis.Error "stale source identity"))))) (new globalThis.RegExp "stale source identity"))
        (js-call assert :deepEqual calls (js-array (js-object :kind "run" :name "current freshness" :rest (js-array)))))))))
  (test "explicit deferral records skipped and not accepted freshness without running or swallowing its failed assertion" (lambda ()
    (let* ((record (recorder)) (run (get record :run)) (calls (get record :calls))
           (deferred (currentPerformanceTest run (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1"))) (executed false))
      (funcall deferred "current sources and measured artifact identity" (lambda () (setq executed t) (throw (new globalThis.Error "must remain pending"))) 1234)
      (js-call assert :equal executed false)
      (js-call assert :deepEqual calls (js-array (js-object :kind "skip" :name "DEFERRED / NOT ACCEPTED: current sources and measured artifact identity" :rest (js-array 1234)))))))
  (test "deferral never changes historical, failed-promotion or semantic assertions registered through the original runner" (lambda ()
    (let* ((record (recorder)) (run (get record :run)) (calls (get record :calls)))
      (funcall (currentPerformanceTest run (js-object :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE "1")) "freshness" (lambda () (throw (new globalThis.Error "deferred"))))
      (js-call (js-array "invalid sample count" "forged passed decision" "semantic mismatch") :forEach (lambda (title)
        (js-call assert :throws (lambda () (funcall run title (lambda () (throw (new globalThis.Error title))))) (new globalThis.RegExp title))))
      (js-call assert :deepEqual (js-call calls :map (lambda (c) (get c :kind))) (js-array "skip" "run" "run" "run")))))
)
