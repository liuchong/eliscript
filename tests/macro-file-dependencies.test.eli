(module tests.macro-file-dependencies.test
  (import "node:process" :default process)
  (import "bun:test" expect test)
  (import "node:crypto" createHash)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (defconst projectDirectory (resolve (js* "import.meta.dir") ".."))
  (defconst buildPath (resolve projectDirectory "bin/eliscript-bootstrap"))
  (defconst projectBuildPath (resolve projectDirectory "bin/eliscript-build"))
  (defconst seedBuildPath (resolve projectDirectory "bin/eliscript-seed-build"))
  (defconst source "(defmacro configured-value ()\n  (macro-read-file \"build-value.txt\"))\n(defconst value (configured-value))\n(export value)")

  (defun env (extra) (Object/assign (js-object) (get process :env) extra))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync run (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((child (Bun/spawn command (Object/assign (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe") options)))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (when (not (= exitCode 0))
        (throw (new globalThis.Error (or (js-call stderr :trim) (js-call stdout :trim) (str (aref command 0) " exited with " exitCode)))))
      stdout)))

  (defun digest (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))
  (defun dependencies (value) (js-array (js-object :path "build-value.txt" :digest (digest value)) (js-object :path "unused.txt" :digest (digest "declared-but-unused"))))
  (defun publicIdentity (manifest) (js-object :format (get manifest :format) :version (get manifest :version) :entry (get manifest :entry) :modules (get manifest :modules) :digest (get manifest :digest)))
  (defasync moduleValue (command output)
    (run (js-array command (resolve projectDirectory "tests/fixtures/macro-module-value-host.mjs") (get (pathToFileURL (resolve output "main.mjs")) :href))))
  (test "self-hosted macros read only declared context files" (async ()
    (let ((directory (await (mkdtemp (resolve projectDirectory ".eliscript-macro-files-")))))
      (try
        (await (run (js-array buildPath) (js-object :env (env (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory)))))
        (let* ((compiler (await (funcall (js* "(url) => import(url)") (str (get (pathToFileURL (resolve directory "compiler.mjs")) :href) "?macro-files"))))
               (context (js-object :capabilities (new globalThis.Set (js-array "read-file")) :files (new globalThis.Map (js-array (js-array "build-value.txt" "forty-two")))))
               (program (js-call compiler :compile_ir_string source "macro-context.eli" context)))
          (js-call (expect (js-call compiler :emit_ir_string program)) :toContain "const value = \"forty-two\";")
          (js-call (expect (lambda () (js-call compiler :compile_ir_string source "macro-context.eli"))) :toThrow "macro capability is not enabled: read-file")
          (js-call (expect (lambda () (js-call compiler :compile_ir_string source "macro-context.eli"
            (js-object :capabilities (new globalThis.Set (js-array "read-file")) :files (new globalThis.Map))))) :toThrow "macro file dependency is not declared: build-value.txt"))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "declared macro files drive deterministic project builds and cache invalidation" (async ()
    (let ((directory (await (mkdtemp (resolve projectDirectory ".eliscript-macro-project-")))))
      (try
        (let* ((compilerDirectory (resolve directory "compiler")) (sourceRoot (resolve directory "src")) (entry (resolve sourceRoot "main.eli"))
               (dependency (resolve sourceRoot "build-value.txt")) (unusedDependency (resolve sourceRoot "unused.txt")) (directOutput (resolve directory "direct")))
          (await (mkdir sourceRoot)) (await (writeFile entry (str source "\n")))
          (await (writeFile dependency "first-value")) (await (writeFile unusedDependency "declared-but-unused"))
          (await (run (js-array buildPath) (js-object :env (env (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDirectory)))))
          (let* ((project (await (funcall (js* "(url) => import(url)") "../bootstrap/host/project.mjs")))
                 (buildProject (get project :buildProject))
                 (options (js-object :entry entry :root sourceRoot :outDir directOutput :moduleDirectory compilerDirectory
                   :macroCapabilities (js-array "read-file") :macroFileDependencies (js-array "unused.txt" "build-value.txt")))
                 (first (await (buildProject options))))
            (same (get (get first :report) :counts) (js-object :modules 1 :compiled 1 :reused 0))
            (same (get (aref (get (get first :report) :modules) 0) :macroDependencies) (dependencies "first-value"))
            (be (js-call (await (moduleValue (get process :execPath) directOutput)) :trim) "first-value")
            (let ((second (await (buildProject options))))
              (same (get (get second :report) :counts) (js-object :modules 1 :compiled 0 :reused 1)))
            (await (writeFile dependency "second-value"))
            (let ((third (await (buildProject options))))
              (same (get (get third :report) :counts) (js-object :modules 1 :compiled 1 :reused 0))
              (be (get (aref (get (get third :report) :modules) 0) :reason) "macro-dependencies-changed"))
            (js-call (expect (await (readFile (resolve directOutput "main.mjs") "utf8"))) :toContain "const value = \"second-value\";")
            (be (js-call (await (moduleValue (get process :execPath) directOutput)) :trim) "second-value")
            (let ((outside (resolve directory "outside.txt")) (linked (resolve sourceRoot "linked.txt")))
              (await (writeFile outside "outside")) (await (symlink outside linked))
              (await (js-call (get (expect (buildProject (Object/assign (js-object) options
                (js-object :outDir (resolve directory "escape") :macroFileDependencies (js-array "linked.txt"))))) :rejects)
                :toThrow "macro file dependency escapes project root")))
            (let ((invalidUtf8 (resolve sourceRoot "invalid.txt")))
              (await (writeFile invalidUtf8 (new globalThis.Uint8Array (js-array 255))))
              (await (js-call (get (expect (buildProject (Object/assign (js-object) options
                (js-object :outDir (resolve directory "invalid-utf8") :macroFileDependencies (js-array "invalid.txt"))))) :rejects)
                :toThrow "macro file dependency is not valid UTF-8")))
            (let ((configuration (resolve directory "eliscript.json")) (selfHostedOutput (resolve directory "self-hosted")) (seedOutput (resolve directory "seed")))
              (await (writeFile configuration (str (JSON/stringify (js-object :schemaVersion 1 :sourceRoot "src" :entry "main.eli" :outDir "self-hosted"
                :portableEntries (js-array) :macroCapabilities (js-array "read-file") :macroFileDependencies (js-array "unused.txt" "build-value.txt") :cache false)) "\n")))
              (await (run (js-array projectBuildPath "--config" configuration) (js-object :env (env (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory)))))
              (await (run (js-array seedBuildPath "--config" configuration "--out-dir" seedOutput)))
              (let ((filenames (js-array "main.mjs" "main.mjs.map")) (index 0))
                (while (< index (get filenames :length))
                  (let ((filename (aref filenames index)))
                    (same (await (readFile (resolve seedOutput filename))) (await (readFile (resolve selfHostedOutput filename)))))
                  (setq index (1+ index))))
              (let ((selfManifest (JSON/parse (await (readFile (resolve selfHostedOutput "eliscript-project.json") "utf8"))))
                    (seedManifest (JSON/parse (await (readFile (resolve seedOutput "eliscript-project.json") "utf8")))))
                (same (publicIdentity seedManifest) (publicIdentity selfManifest))
                (same (get (aref (get seedManifest :modules) 0) :macroDependencies) (dependencies "second-value")))
              (be (js-call (await (moduleValue "node" seedOutput)) :trim) "second-value"))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
