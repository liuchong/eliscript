(module tests.wasm-memory-f64-literal.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" buildBackends)

  (defvar directory undefined)
  (defvar backend undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-memory-f64-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory)))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun compile (source)
    (let* ((program (js-call (get backend :compiler) :compile_ir_string source "memory-f64.eli"))
           (mod (new globalThis.WebAssembly.Module (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm program)))))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports mod) (js-array))
      (get (new globalThis.WebAssembly.Instance mod) :exports)))

  (defun backendFailure (error)
    (let ((diag (get error :eliscriptDiagnostic)))
      (and diag (= (get diag :code) "ELI-B0001") (= (get diag :phase) "memory-backend"))))

  (test "internal static f64 literals preserve exact IEEE bytes without changing the word ABI" (lambda ()
    (let* ((literals (js-array "0.0" "-0.0" "-1" "-1.25" "0.5" "4294967296" "9007199254740991" "9007199254740992"
                               "5e-324" "-5e-324" "2.2250738585072014e-308" "1.7976931348623157e308"))
           (source (str "(import \"eliscript:memory32\" f64-literal store-f64)\n"
                        (js-call (js-call literals :map (lambda (literal index)
                                   (str "(defun write" index " (address) (store-f64 address (f64-literal " literal ")))")))
                                 :join "\n")
                        "\n(export "
                        (js-call (js-call literals :map (lambda (_ index) (str "write" index))) :join " ")
                        ")"))
           (e (compile source))
           (view (new globalThis.DataView (get (get e :memory) :buffer))))
      (js-call literals :forEach
        (lambda (literal index)
          (let ((address (* index 8))
                (expected (new globalThis.ArrayBuffer 8))
                (number (globalThis.Number literal)))
            (js-call (new globalThis.DataView expected) :setFloat64 0 number t)
            (js-call assert :equal (js-call e (str "write" index) address) 0)
            (js-call assert :deepEqual
              (new globalThis.Uint8Array (get (get e :memory) :buffer) address 8)
              (new globalThis.Uint8Array expected)
              literal)
            (funcall assert (Object/is (js-call view :getFloat64 address t) number) literal))))
      (let ((locals (compile "(import \"eliscript:memory32\" f64-literal store-f64)\n    (defun write () (let ((number (f64-literal -1.25)))\n      (setq number (+ number (f64-literal 0.5))) (store-f64 0 number))) (export write)")))
        (js-call assert :equal (js-call locals :write) 0)
        (js-call assert :equal (js-call (new globalThis.DataView (get (get locals :memory) :buffer)) :getFloat64 0 t) -0.75)))))

  (test "the internal f64 capability requires exactly one plain static Number and cannot be shadowed" (lambda ()
    (js-call
      (js-array "(f64-literal)" "(f64-literal 1 2)" "(f64-literal address)" "(f64-literal (+ 1 2))"
                "(f64-literal \"1\")" "(f64-literal nil)" "(f64-literal t)" "(f64-literal :number)")
      :forEach
      (lambda (expression)
        (js-call assert :throws
          (lambda ()
            (compile (str "(import \"eliscript:memory32\" f64-literal store-f64)\n      (defun bad (address) (store-f64 0 " expression ")) (export bad)")))
          backendFailure
          expression)))
    (js-call assert :throws
      (lambda ()
        (compile "(import \"eliscript:memory32\" f64-literal store-f64)\n    (defun bad (f64-literal) (store-f64 0 (f64-literal 1))) (export bad)"))
      backendFailure)))

  (test "f64 support does not admit invalid bare word literals or change scalar result types" (lambda ()
    (js-call (js-array "-1" "-0.0" "1.5" "4294967296" "9007199254740991") :forEach
      (lambda (literal)
        (js-call assert :throws
          (lambda () (compile (str "(defun bad () " literal ") (export bad)")))
          backendFailure
          literal)))
    (js-call assert :throws
      (lambda () (compile "(import \"eliscript:memory32\" f64-literal) (defun bad () (f64-literal 1)) (export bad)"))
      backendFailure)
    (let ((e (compile "(defun high () 4294967295) (export high)")))
      (js-call assert :equal (uint32 (js-call e :high)) 4294967295)))))
