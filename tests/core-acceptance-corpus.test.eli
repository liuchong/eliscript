(module tests.core-acceptance-corpus
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../tools/acceptance/check.mjs" AcceptanceCorpusError checkAcceptanceCorpus humanCorpusReport validateAcceptanceCorpus verifyAcceptanceRun)
  (defconst ROOT (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst retainedReportTest (if (= (get (get globalThis.process :env) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE) "1") (get test :skip) test))
  (defasync contract () (JSON/parse (await (readFile (resolve ROOT "contracts/core-acceptance-corpus.json") "utf8"))))
  (defasync validationErrors (value)
    (let ((errors undefined) (failed false))
      (try (await (validateAcceptanceCorpus value (js-object :root ROOT)))
        (catch error (js-call (expect error) :toBeInstanceOf AcceptanceCorpusError) (setq errors (get error :errors) failed t)))
      (unless failed (throw (new globalThis.Error "expected acceptance corpus validation to fail"))) errors))
  (defun contains (actual expected) (js-call (expect actual) :toContain expected))
  (test "core acceptance corpus is complete and specification-derived" (async ()
    (let ((checked (await (checkAcceptanceCorpus (js-object :root ROOT)))))
      (js-call (expect (get checked :criteria)) :toHaveLength 35)
      (js-call (expect (aref (get checked :criteria) 0)) :toEqual (js-object :id "AC-01" :title "Stable specification coverage"))
      (js-call (expect (js-call (get checked :criteria) :at -1)) :toEqual (js-object :id "PD-11" :title "State Discipline"))
      (js-call (expect (get (aref (get (get checked :contract) :commands) 0) :argv)) :toEqual (js-array "make" "test-core"))
      (js-call (expect (js-call (get checked :applications) :map (lambda (entry) (get entry :id)))) :toEqual (js-array "AV-01" "AV-02"))
      (contains (humanCorpusReport checked) "35 mandatory criteria"))))
  (test "core acceptance corpus rejects a missing criterion" (async ()
    (let ((value (await (contract))))
      (js-call (get value :criteria) :pop)
      (let ((errors (await (validationErrors value))))
        (contains errors "criteria must exactly match the ordered AC and PD headings in the normative specifications")
        (contains errors "corpus and maturity progress criteria must have identical ids and order")))))
  (test "core acceptance corpus rejects title drift from the normative spec" (async ()
    (let ((value (await (contract))))
      (put (aref (get value :criteria) 0) :title "Almost stable specification coverage")
      (contains (await (validationErrors value)) "criteria must exactly match the ordered AC and PD headings in the normative specifications"))))
  (test "core acceptance corpus rejects unknown probes and untracked evidence" (async ()
    (let ((value (await (contract))))
      (put (aref (get value :criteria) 0) :probes (js-array "missing-probe"))
      (put (aref (get value :criteria) 0) :evidence (js-array "tests/fixtures/not-acceptance-evidence.txt"))
      (let ((errors (await (validationErrors value))))
        (contains errors "AC-01 references unknown command missing-probe")
        (contains errors "AC-01 evidence is not tracked: tests/fixtures/not-acceptance-evidence.txt")))))
  (test "core acceptance corpus keeps applications outside core evidence" (async ()
    (let ((value (await (contract))))
      (put (aref (get value :applications) 0) :contributesToCore t)
      (contains (await (validationErrors value)) "applications must match AV headings and contribute no core evidence"))))
  (funcall retainedReportTest "retained M13 audit is complete operational evidence without a final claim" (async ()
    (let* ((report (await (verifyAcceptanceRun "acceptance/runs/m13-01.json" (js-object :root ROOT :markdownFile "acceptance/runs/m13-01.md"))))
           (tally (js-object :pass 0 :incomplete 0 :fail 0 :total (get (get report :criteria) :length))))
      (js-call (get report :criteria) :forEach (lambda (criterion)
        (let ((key (get criterion :result))) (put tally key (1+ (get tally key))))))
      (js-call (expect (get (get report :summary) :criteria)) :toEqual tally)
      (js-call (expect (get (get report :summary) :acceptancePass)) :toBe (and (= (get tally :incomplete) 0) (= (get tally :fail) 0)))
      (js-call (expect (get (get report :summary) :corpusComplete)) :toBe t)
      (js-call (expect (get (get report :summary) :operationalSuccess)) :toBe t)
      (js-call (expect (get report :source)) :toMatchObject (js-object :cleanBefore t :cleanAfter t))
      (js-call (expect (js-call (get report :applications) :every (lambda (entry) (and (= (get entry :result) "not-run") (= (get entry :contributesToCore) false))))) :toBe t))))
  (funcall retainedReportTest "retained M13 audit rejects a forged final acceptance result" (async ()
    (let ((report (JSON/parse (await (readFile (resolve ROOT "acceptance/runs/m13-01.json") "utf8")))))
      (put (get report :summary) :acceptancePass (not (get (get report :summary) :acceptancePass)))
      (await (js-call (get (expect (verifyAcceptanceRun "unused.json" (js-object :root ROOT :report report))) :rejects) :toMatchObject
        (js-object :errors (js-array "run summary is not derived from recorded results")))))))
)
