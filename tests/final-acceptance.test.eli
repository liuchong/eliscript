(module tests.final-acceptance.test
  (import "node:process" :default process)
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve join)
  (import "../tools/acceptance/finalize.mjs" buildFinalAcceptance FinalAcceptanceError humanFinalAcceptanceReport validateFinalManifest verifyFinalAcceptance)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst verificationOptions (js-object :root ROOT :deferPerformanceAcceptance (= (get (get process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")))
  (defconst retainedFinalTest (if (= (get (get process :env) :ELISCRIPT_SKIP_RETAINED_ACCEPTANCE) "1") (get test :skip) test))
  (defasync readJson (file) (JSON/parse (await (readFile (join ROOT file) "utf8"))))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (retainedFinalTest "canonical final artifacts derive every gate from the retained local run" (async ()
    (let* ((manifest (await (buildFinalAcceptance verificationOptions))) (run (await (readJson "acceptance/runs/m13-01.json")))
           (criteria (get run :criteria)) (tally (js-object :pass 0 :incomplete 0 :fail 0 :total (get criteria :length))))
      (js-call criteria :forEach (lambda (criterion)
        (let ((key (get criterion :result))) (put tally key (1+ (get tally key))))))
      (js-call (expect manifest) :toMatchObject (js-object :schemaVersion 1 :format "eliscript-1.0-acceptance-manifest" :version 1
        :summary (js-object :criteria tally :corpusComplete t :operationalSuccess t :evidenceComplete t :blockingDefects 0
          :acceptancePass (and (= (get tally :incomplete) 0) (= (get tally :fail) 0)))))
      (same (js-call (get manifest :evidence) :map (lambda (group) (get group :id))) (js-array "benchmark" "fuzz" "scale" "soak" "test"))
      (be (js-call (get manifest :evidence) :every (lambda (group) (get group :complete))) t)
      (be (js-call (get manifest :applications) :every (lambda (application) (and (= (get application :result) "not-run") (= (get application :contributesToCore) false)))) t)
      (let ((report (humanFinalAcceptanceReport manifest)))
        (js-call (expect report) :toContain (str "Results: " (get tally :pass) " pass, " (get tally :incomplete) " incomplete, " (get tally :fail) " fail, " (get tally :total) " total."))
        (if (get (get manifest :summary) :acceptancePass)
          (progn (js-call (expect report) :toContain "Final acceptance: pass") (js-call (get (expect report) :not) :toContain "This is the canonical candidate report."))
          (progn (js-call (expect report) :toContain "This is the canonical candidate report.") (js-call (get (expect report) :not) :toContain "Final acceptance: pass")))))))
  (retainedFinalTest "blocking defects cannot be hidden by otherwise valid artifacts" (async ()
    (let ((defects (await (readJson "acceptance/defects.json"))))
      (js-call (get defects :unresolved) :push (js-object :id "DEFECT-0001" :severity 1 :class "correctness" :title "Acceptance test defect" :evidence (js-array "README.md")))
      (let ((manifest (await (buildFinalAcceptance (Object/assign (js-object) verificationOptions (js-object :defects defects))))))
        (be (get (get manifest :defects) :blockingCount) 1) (be (get (get manifest :summary) :blockingDefects) 1) (be (get (get manifest :summary) :acceptancePass) false)))))
  (retainedFinalTest "final artifact contract rejects evidence absent from the source run" (async ()
    (let ((contract (await (readJson "contracts/final-acceptance.json"))))
      (put (aref (get contract :evidenceGroups) 0) :artifacts (js-array "README.md"))
      (await (js-call (get (expect (buildFinalAcceptance (Object/assign (js-object) verificationOptions (js-object :contract contract)))) :rejects)
        :toMatchObject (js-object :errors (js-array "benchmark artifact is not bound by the source run: README.md")))))))
  (retainedFinalTest "final acceptance rejects a forged pass result" (async ()
    (let* ((expected (await (buildFinalAcceptance verificationOptions))) (forged (funcall globalThis.structuredClone expected)))
      (put (get forged :summary) :acceptancePass (not (get (get expected :summary) :acceptancePass)))
      (js-call (expect (lambda () (validateFinalManifest forged expected))) :toThrow FinalAcceptanceError))))
  (retainedFinalTest "canonical final manifest and report remain byte exact" (async ()
    (let* ((derived (await (buildFinalAcceptance verificationOptions))) (manifest (await (verifyFinalAcceptance verificationOptions)))
           (gate (verifyFinalAcceptance (Object/assign (js-object) verificationOptions (js-object :requirePass t)))))
      (same manifest derived)
      (if (and (get verificationOptions :deferPerformanceAcceptance) (get (get derived :summary) :acceptancePass))
        (await (js-call (get (expect gate) :rejects) :toMatchObject (js-object :errors (js-array "current performance acceptance is deferred and has not passed"))))
        (if (get (get derived :summary) :acceptancePass)
          (await (js-call (get (expect gate) :resolves) :toEqual derived))
          (await (js-call (get (expect gate) :rejects) :toMatchObject (js-object :errors (js-array "the canonical artifacts are valid, but final acceptance has not been reached")))))))))
)
