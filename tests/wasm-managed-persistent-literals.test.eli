(module tests.wasm-managed-persistent-literals.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:process" :default process)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-module-graph.mjs"
    createManagedModuleGraph createManagedProjectFacades loadManagedProjectGraph)
  (import "../runtime/core/list.mjs" PersistentList persistentList)
  (import "../runtime/core/vector.mjs" PersistentVector persistentVector)
  (import "../runtime/core/map.mjs" PersistentHashMap persistentHashMap)
  (import "../runtime/core/set.mjs" PersistentHashSet persistentHashSet)
  (import "../runtime/core/queue.mjs" PersistentQueue persistentQueue)
  (import "../runtime/core/identifier.mjs" EliscriptSymbol eliscriptSymbol keyword)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/regex.mjs" compileRegex isRegexPattern regexSource regexFlags)
  (import "../runtime/core/sorted.mjs"
    PersistentSortedMap PersistentSortedSet persistentSortedMap defaultSortedComparator)
  (import "../runtime/core/value.mjs" hashValue)
  (import "../runtime/core/protocol.mjs" isProtocol protocolMethod protocolSlot)
  (import "../runtime/core/type.mjs" isType isTypeValue typeFieldNames)
  (import "../runtime/core/record.mjs" isRecord isRecordType recordFieldNames)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))

  (defconst root
    (resolve (dirname (fileURLToPath (get (js* "import.meta") :url))) ".."))
  (defconst host-helper
    (resolve root "tests/helpers/wasm-managed-persistent-literals-host.mjs"))

  (defconst native-supported
    (and (= (get process :arch) "arm64")
         (or (= (get process :platform) "darwin")
             (= (get process :platform) "linux"))))
  (defconst native-target
    (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos"))

  (defconst memory (Object/freeze (js-object :initialPages 128 :maximumPages 4096)))
  (defconst budget (Object/freeze (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)))

  (defconst exported
    (js-array
      "vector-value" "map-value" "map-literal" "set-value" "set-literal" "macro-set"
      "set-evaluation-order" "queue-value" "queue-literal" "queue-evaluation-order" "keyword-value" "keyword-map"
      "macro-keyword" "quoted-keyword" "quoted-data" "quoted-map" "quoted-set" "quoted-queue"
      "list-value" "list-first" "list-rest" "list-cons" "empty-list-rest" "array-value" "prepended-array" "object-value"
      "vector-first" "vector-count" "array-second" "array-count"))

  (defconst boundary-source
    (str "(import \"./literal-runtime.mjs\" " (js-call exported :join " ") ")\n"
      "(import \"eliscript/runtime/core/regex\" compileRegex regexFind regexSource regexFlags isRegexPattern)\n"
      "(import \"eliscript/runtime/core/sorted\" persistentSortedMapBy persistentSortedSetBy isPersistentSortedCollection)\n"
      "(import \"eliscript/runtime/core/metadata\" withMeta)\n"
      "(import \"eliscript/runtime/core/value\" hashValue)\n"
      "(import \"eliscript/runtime/core/value-internals\" cachedProtocolHash resetValueMetrics clearValueCaches readValueMetrics)\n"
      "(import \"eliscript/runtime/core/protocol\" defineProtocol protocolMethod protocolSlot)\n"
      "(import \"eliscript/runtime/core/type\" defineType reifyProtocols)\n"
      "(import \"eliscript/runtime/core/record\" defineRecordType)\n"
      "(defun boundary-echo (value) value)\n"
      "(defun boundary-same (left right) (eq left right))\n"
      "(defun boundary-vector-update (value) (js-call value :assoc 0 -0.0))\n"
      "(defun boundary-map-update (value) (js-call value :assoc :updated 42))\n"
      "(defun boundary-set-update (value) (js-call value :conj 42))\n"
      "(defun boundary-queue-update (value) (js-call value :conj 42))\n"
      "(defun boundary-list-update (value) (cons 42 value))\n"
      "(defun boundary-aliases ()\n"
      "  (let ((shared [1 undefined -0.0]))\n"
      "    (js-array shared shared (hash-map :child shared) (list shared shared))))\n"
      "(defun boundary-identifiers ()\n"
      "  (let ((name 'same)) (js-array :same :same name name 'same)))\n"
      "(defun boundary-fake () (Object/freeze (js-object :kind \"vector\" :count 2 :values (js-array 1 2))))\n"
      "(defun boundary-regex-value ()\n"
      "  (let ((pattern (compileRegex \"a+\" \"ui\")))\n"
      "    (js-array pattern pattern (regexFind pattern \"BAAA\"))))\n"
      "(defun boundary-regex-observe (pattern)\n"
      "  (js-array (regexSource pattern) (regexFlags pattern) (regexFind pattern \"BAAA\")))\n"
      "(defun boundary-regex-pattern? (pattern) (isRegexPattern pattern))\n"
      "(defun boundary-sorted-values ()\n"
      "  (let* ((calls 0)\n"
      "         (comparison (lambda (left right) (setq calls (1+ calls)) (- left right)))\n"
      "         (values (persistentSortedMapBy comparison 2 \"b\" 1 \"a\"))\n"
      "         (map (withMeta values (hash-map :origin \"target\")))\n"
      "         (set (persistentSortedSetBy comparison 3 1)))\n"
      "    (js-array map (get map :comparator) map set (get set :comparator) (lambda () calls) calls)))\n"
      "(defun boundary-sorted-default-update (value) (js-call value :assoc 3 \"c\"))\n"
      "(defun boundary-sorted? (value) (isPersistentSortedCollection value))\n"
      "(defun boundary-hash-cache ()\n"
      "  (clearValueCaches)\n"
      "  (let* ((value [1 2]) (computations 0)\n"
      "         (direct (cachedProtocolHash value (lambda () (setq computations (1+ computations)) -1)))\n"
      "         (public (hashValue value)) (first (readValueMetrics)))\n"
      "    (resetValueMetrics)\n"
      "    (let* ((retained (hashValue value)) (after-reset (readValueMetrics)))\n"
      "      (clearValueCaches)\n"
      "      (let* ((empty (readValueMetrics)) (recomputed (hashValue value)) (after-clear (readValueMetrics)))\n"
      "        (js-array direct public retained computations first after-reset empty recomputed after-clear)))))\n"
      "(defun boundary-type-identities ()\n"
      "  (let* ((protocol (defineProtocol \"Boundary\" (js-array \"read\")))\n"
      "         (shared (js-object :zero -0.0))\n"
      "         (type (defineType \"Same\" (js-array \"value\")\n"
      "           (js-array (js-array protocol (js-object :read (lambda (self) (get self :value)))))))\n"
      "         (value (js-call type :create shared))\n"
      "         (record-type (defineRecordType \"Same\" (js-array \"value\")))\n"
      "         (other-record-type (defineRecordType \"Same\" (js-array \"value\")))\n"
      "         (record (js-call record-type :create shared))\n"
      "         (reified (reifyProtocols (js-array (js-array protocol (js-object :read (lambda (self) 7)))))))\n"
      "    (js-array (protocolSlot protocol \"read\") (protocolMethod protocol \"read\") (get protocol :operations) protocol\n"
      "      (get type :typeFields) type value shared (get record-type :recordFields) record-type other-record-type record reified)))\n"
      "(export " (js-call exported :join " ") " boundary-echo boundary-same boundary-vector-update boundary-map-update\n"
      " boundary-set-update boundary-queue-update boundary-list-update boundary-aliases boundary-identifiers boundary-fake\n"
      " boundary-regex-value boundary-regex-observe boundary-regex-pattern?\n"
      " boundary-sorted-values boundary-sorted-default-update boundary-sorted? boundary-hash-cache boundary-type-identities)"))

  (defun assert-original-report (bun-report)
    (js-call (expect bun-report) :toEqual
      (js-object
        :vector (js-object :persistent t :count 3 :languageCount 3 :first 1
          :values (js-array 1 2 (js-object)) :nestedPersistent t)
        :map (js-object :persistent t :count 2 :name "Eliscript" :valueKey (js-array 5 6))
        :mapLiteral (js-object :persistent t :count 4 :name "source" :valueKey (js-array 7 8)
          :nestedPersistent t :nestedReady t :duplicate 2)
        :set (js-object :explicitPersistent t :explicitCount 2 :explicitValueKey t
          :literalPersistent t :literalCount 3 :duplicate t :valueKey t :nestedMap t :nestedReady t
          :evaluationOrder "12" :macroPersistent t :macroKeyword t :macroValue t)
        :queue (js-object :explicitPersistent t :explicitValues (js-array "explicit" (js-array 5 6))
          :literalPersistent t :literalValues (js-array "source" (js-array 7 8) (js-object :ready t))
          :evaluationOrder "12" :text "#queue [\"source\" [7 8] {:ready true}]")
        :keyword (js-object :value t :interned t :qualifiedName "article/title" :printed ":article/title"
          :mapPersistent t :mapCount 2 :mapQualified "qualified" :mapReady t :stringKeyMiss nil
          :macroValue t :macroQualifiedName "macro/value"
          :quotedSyntax (js-object :value t :qualifiedName "quoted/value"))
        :quoted (js-object :persistentList t :count 5 :symbol t :symbolName "alpha" :keyword t
          :vector t :vectorValues (js-array 1 nil) :emptyList t :falseSymbol t
          :text "(alpha :beta [1 undefined] () #eliscript/symbol [nil \"false\"])"
          :mapSyntax "(hash-map :ready true)" :setSyntax "(hash-set :ready [1 undefined])"
          :queueSyntax "(queue 1 :ready)")
        :list (js-object :persistent t :values (js-array 1 2 3) :first 1 :restPersistent t
          :restValues (js-array 2 3) :consPersistent t :consValues (js-array 0 1 2 3) :emptyRest t)
        :host (js-object :array t :prependedArray (js-array 0 1 2 3) :languageCount 3 :second 2
          :object t :objectValue (js-object :name "host" :count 2)))))

  (defvar directory nil)
  (defvar backend nil)
  (defvar lowered nil)
  (defvar wasm-bytes nil)
  (defvar native-path nil)
  (defvar oracle-path nil)
  (defvar serial 0)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-persistent-literals-"))))
      (setq backend (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
      (let* ((fixture-source (await (readFile (resolve root "tests/fixtures/literal-runtime.eli") "utf8")))
             (loaded (await (js-call backend :loadLiteralModules)))
             (literal-sources (get loaded :literalSources))
             (literal-modules (get loaded :literalModules))
             (expected-ids
               (js-call
                 (js-call
                   (js-call
                     (js-array
                       "bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value" "managed-queue-state" "managed-literals"
                       "managed-transient-state" "managed-vector-view-state" "managed-literal-protocols" "managed-sorted-state"
                       "managed-value-state" "core/protocol" "core/text" "core/object" "core/set" "core/data")
                     :map (lambda (name) (str "stdlib/" name ".mjs")))
                   :concat
                   (js-call
                     (js-array
                       "protocol-error" "list" "vector" "map" "set" "queue" "identifier" "record" "value"
                       "metadata" "collection" "transient" "protocol" "type" "order" "sorted" "regex"
                       "transducer" "lazy-sequence" "text" "object" "truth" "sequence" "set-algebra"
                       "collection-internals" "metadata-internals" "persistent-kind" "data" "data-text" "value-internals")
                     :map (lambda (name) (str "runtime/core/" name ".mjs")))
                   "runtime/literals.mjs"
                   "runtime/wire/markdown.mjs" "runtime/wire/schema.mjs" "runtime/wire/http-rpc.mjs"
                   "runtime/testing/value.mjs")
                 :sort)))
        (js-call assert :deepEqual
          (js-call (js-call literal-sources :map (lambda (item) (get item :id))) :sort)
          expected-ids)
        (js-call assert :equal (get literal-modules :length) (get literal-sources :length))
        (let ((index 0))
          (while (< index (get literal-modules :length))
            (let ((mod-item (aref literal-modules index))
                  (src-item (aref literal-sources index)))
              (js-call assert :equal (get mod-item :id) (get src-item :id))
              (js-call assert :equal
                (get src-item :source)
                (await (readFile (resolve root (get src-item :filename)) "utf8"))))
            (setq index (+ index 1))))
        (let* ((modules
                 (js-array
                   (js-object
                     :id "literal-runtime.mjs"
                     :program (js-call (get backend :compiler) :compile_ir_string fixture-source "tests/fixtures/literal-runtime.eli"))
                   (js-object
                     :id "boundary.mjs"
                     :program (js-call (get backend :compiler) :compile_ir_string boundary-source "persistent-boundary.eli"))))
               (runtime
                 (js-call (get backend :compiler) :compile_ir_string
                   (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8"))
                   "runtime.eli"))
               (original-modules (globalThis.structuredClone modules))
               (original-library (globalThis.structuredClone literal-modules)))
          (setq lowered
            (js-call (get backend :managed) :lower_managed_project
              modules "boundary.mjs" runtime
              (js-object :literalModules literal-modules :phased t)))
          (js-call assert :deepEqual modules original-modules)
          (js-call assert :deepEqual literal-modules original-library)
          (let ((caps (get (get lowered :descriptor) :hostCapabilities)))
            (js-call assert :deepEqual (if (nullish? caps) (js-array) caps) (js-array)))
          (js-call assert :equal (get (get (get lowered :descriptor) :literalRuntime) :version) 1)
          (setq wasm-bytes
            (Uint8Array/from
              (js-call (get backend :wasm) :append_metadata_section
                (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
                "eliscript-managed-control"
                (JSON/stringify (get lowered :descriptor)))))
          (js-call assert :deepEqual
            (WebAssembly.Module/imports (new WebAssembly.Module wasm-bytes))
            (js-array))
          (await (writeFile (resolve directory "literal-runtime.wasm") wasm-bytes))
          (await (writeFile (resolve directory "literal-runtime.lowered.json") (JSON/stringify lowered)))
          (when native-supported
            (setq native-path
              (resolve directory
                (if (= (get process :platform) "linux")
                    "literal-runtime.so"
                    "literal-runtime.dylib")))
            (await (writeFile native-path
                     (Uint8Array/from
                       (js-call (get backend :native) :emit_typed_native_memory_library
                         (get lowered :typed)
                         native-target)))))
          (let ((oracle-directory (resolve directory "oracle")))
            (await (mkdir oracle-directory))
            (await (mkdir (resolve directory "node_modules")))
            (await (symlink root (resolve directory "node_modules/eliscript") "dir"))
            (setq oracle-path (resolve oracle-directory "literal-runtime.mjs"))
            (await (writeFile oracle-path
                     (js-call (get backend :compiler) :compile_string
                       fixture-source "tests/fixtures/literal-runtime.eli")))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defasync facades-at (path)
    (let* ((facades (createManagedProjectFacades (get lowered :descriptor) (js-object :entry "boundary.mjs")))
           (files (get facades :files))
           (idx 0))
      (while (< idx (get files :length))
        (let* ((file (aref files idx))
               (output (resolve path (get file :id))))
          (await (mkdir (dirname output) (js-object :recursive t)))
          (await (writeFile output (get file :source))))
        (setq idx (+ idx 1)))
      facades))

  (defasync open-runtime (host &rest __host_forwarded_arguments_1)
    (let* ((opts (aref __host_forwarded_arguments_1 0)))
    (setq serial (+ serial 1))
    (let ((deployment (resolve directory (str "live-" host "-" serial))))
      (await (mkdir deployment))
      (await (facades-at deployment))
      (let ((host-modules (if (nullish? opts) undefined (get opts :hostModules)))
            (module-graph (createManagedModuleGraph (get lowered :descriptor)))
            (runtime undefined))
      (try
        (if (= host "wasm")
            (setq runtime
              (instantiateManagedRuntime wasm-bytes
                (Object/assign (js-object) budget
                  (js-object :initializeModule false :moduleGraph module-graph :hostModules host-modules))))
            (setq runtime
              (await (instantiateNativeManagedRuntime native-path lowered
                       (Object/assign (js-object) memory budget
                         (js-object :initializeModule false :moduleGraph module-graph :nativeTarget native-target :hostModules host-modules))))))
        (js-call runtime :auto 65536)
        (let ((project
                (await (loadManagedProjectGraph runtime (get lowered :descriptor)
                         (js-object
                           :moduleGraph module-graph
                           :projectEntry "boundary.mjs"
                           :projectModuleBaseURL (get (pathToFileURL (str deployment "/")) :href))))))
          (js-object :runtime runtime :namespace (get project :namespace)))
        (catch error
          (try (when runtime (js-call runtime :closeModule)) (catch _e nil))
          (try (when (and runtime (get runtime :close)) (js-call runtime :close)) (catch _e nil))
          (js-call module-graph :close)
          (throw error)))))))

  (defun finish (runtime)
    (try
      (js-call runtime :closeModule)
      (js-call runtime :collect)
      (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
      (js-call assert :equal (js-call runtime :live) 0)
      (js-call runtime :closeModule)
      (js-call runtime :collect)
      (js-call assert :equal (js-call runtime :live) 0)
      (finally
        (let ((close-fn (get runtime :close)))
          (when close-fn
            (js-call runtime :close))))))

  (defun invoke-host (runtime name value)
    (let ((input (js-call runtime :fromHostValue value)))
      (try
        (let ((output (js-call runtime :invoke name (js-array input))))
          (try
            (js-call runtime :toHostValue output)
            (finally
              (js-call runtime :release output))))
        (finally
          (js-call runtime :release input)))))

  (defun host-script (engine script args &rest __host_default_arguments_1)
    (let* ((timeout (aref __host_default_arguments_1 0)))
    (let* ((limit (if (undefined? timeout) 60000 timeout))
           (env-node (get (get process :env) :NODE_BINARY))
           (bin (if (= engine "bun")
                    (get process :execPath)
                    (if (nullish? env-node) "node" env-node)))
           (child (spawnSync bin
                    (js-call (js-array script) :concat args)
                    (js-object
                      :cwd root
                      :encoding "utf8"
                      :timeout limit
                      :env (Object/assign (js-object) (get process :env) (js-object :BUN (get process :execPath)))))))
      (js-call assert :equal (get child :error) undefined)
      (js-call assert :equal (get child :status) 0 (str (get child :stderr) (get child :stdout)))
      (JSON/parse (js-call (get child :stdout) :trim)))))

  (js-call (js-array "wasm" "native") :forEach
    (lambda (host)
      (let ((host-test (js-call test :skipIf (and (= host "native") (not native-supported)))))
        (js-call (js-array "bun" "node") :forEach
          (lambda (engine)
            (funcall host-test
              (str "the complete original persistent literal host executes real " host " with " engine)
              (async ()
                (let ((deployment (resolve directory (str "original-" host "-" engine))))
                  (await (mkdir deployment))
                  (await (facades-at deployment))
                  (let* ((report
                           (host-script engine host-helper
                             (js-array "--run-host" host root directory deployment native-target (if native-path native-path ""))))
                         (oracle
                           (host-script engine (resolve root "tests/fixtures/literal-runtime-host.mjs")
                             (js-array oracle-path))))
                    (assert-original-report report)
                    (assert-original-report oracle)
                    (js-call assert :deepEqual report oracle))))
              60000)))

        (funcall host-test
          (str host " persistent boundaries preserve actual classes, immutable structure and nested aliases")
          (async ()
            (let* ((opened (await (open-runtime host)))
                   (a (get opened :runtime))
                   (m (get opened :namespace)))
              (try
                (js-call
                  (js-array
                    (js-array (get m :vector_value) PersistentVector)
                    (js-array (get m :map_value) PersistentHashMap)
                    (js-array (get m :set_value) PersistentHashSet)
                    (js-array (get m :queue_value) PersistentQueue)
                    (js-array (get m :list_value) PersistentList))
                  :forEach
                  (lambda (pair)
                    (let ((value (aref pair 0))
                          (cls (aref pair 1)))
                      (funcall assert (funcall js-instanceof value cls))
                      (js-call assert :equal (Object/isFrozen value) t)
                      (js-call assert :equal (Object/isExtensible value) false)
                      (js-call assert :equal (Reflect/set value "added" 1) false)
                      (js-call assert :throws
                        (lambda () (Object/defineProperty value "added" (js-object :value 1)))
                        globalThis.TypeError))))
                (let* ((aliases (js-call m :boundary_aliases))
                       (shared (aref aliases 0)))
                  (funcall assert (funcall js-instanceof shared PersistentVector))
                  (js-call assert :equal (aref aliases 1) shared)
                  (js-call assert :equal (js-call (aref aliases 2) :get (keyword "child")) shared)
                  (js-call assert :equal (js-call (aref aliases 3) :first) shared)
                  (js-call assert :equal (js-call (js-call (aref aliases 3) :rest) :first) shared)
                  (js-call assert :equal (js-call shared :nth 1) undefined)
                  (funcall assert (Object/is (js-call shared :nth 2) -0.0))
                  (let ((raw (js-call a :fromHostValue shared)))
                    (try
                      (js-call assert :equal (js-call a :invoke "boundary_same" (js-array raw raw)) t)
                      (let ((echoed (js-call a :invoke "boundary_echo" (js-array raw))))
                        (try
                          (js-call assert :equal (js-call a :toHostValue echoed) shared)
                          (finally
                            (js-call a :release echoed))))
                      (finally
                        (js-call a :release raw))))
                  (let ((ids (js-call m :boundary_identifiers)))
                    (js-call assert :equal (aref ids 0) (keyword "same"))
                    (js-call assert :equal (aref ids 0) (aref ids 1))
                    (funcall assert (funcall js-instanceof (aref ids 2) EliscriptSymbol))
                    (js-call assert :equal (aref ids 2) (aref ids 3))
                    (js-call assert :notEqual (aref ids 2) (aref ids 4))
                    (js-call assert :equal (get (aref ids 2) :qualifiedName) (get (aref ids 4) :qualifiedName))))
                (finally
                  (finish a)))))
          60000)

        (funcall host-test
          (str host " imported persistent metadata and updates use target algorithms and preserve the original input")
          (async ()
            (let* ((opened (await (open-runtime host)))
                   (a (get opened :runtime)))
              (try
                (let* ((metadata (persistentHashMap (js-array (keyword "source") "host")))
                       (shared (persistentVector 7 8))
                       (cases
                         (js-array
                           (js-array "boundary_vector_update" (withMeta (persistentVector shared shared) metadata) PersistentVector)
                           (js-array "boundary_map_update" (withMeta (persistentHashMap (js-array (keyword "child") shared)) metadata) PersistentHashMap)
                           (js-array "boundary_set_update" (withMeta (persistentHashSet shared) metadata) PersistentHashSet)
                           (js-array "boundary_queue_update" (withMeta (persistentQueue shared) metadata) PersistentQueue)
                           (js-array "boundary_list_update" (withMeta (persistentList shared) metadata) PersistentList)))
                       (ctors (js-array PersistentVector PersistentHashMap PersistentHashSet PersistentQueue PersistentList)))
                  (js-call cases :forEach
                    (lambda (spec)
                      (let* ((name (aref spec 0))
                             (input (aref spec 1))
                             (cls (aref spec 2))
                             (original (Array/from input))
                             (raw (js-call a :fromHostValue input))
                             (blocked
                               (js-call ctors :flatMap
                                 (lambda (ctor)
                                   (let ((proto (get ctor :prototype)))
                                     (js-call
                                       (js-call (js-array "assoc" "conj" "cons") :filter
                                         (lambda (method) (= (funcall js-typeof (get proto method)) "function")))
                                       :map
                                       (lambda (method)
                                         (js-array proto method (Object/getOwnPropertyDescriptor proto method))))))))
                             (output undefined))
                        (try
                          (js-call blocked :forEach
                            (lambda (entry)
                              (Object/defineProperty (aref entry 0) (aref entry 1)
                                (Object/assign (js-object) (aref entry 2)
                                  (js-object :value
                                    (lambda ()
                                      (throw (new globalThis.Error "target persistent algorithms cannot execute a host collection method"))))))))
                          (setq output (js-call a :invoke name (js-array raw)))
                          (finally
                            (js-call blocked :forEach
                              (lambda (entry)
                                (Object/defineProperty (aref entry 0) (aref entry 1) (aref entry 2))))
                            (js-call a :release raw)))
                        (try
                          (let ((result (js-call a :toHostValue output)))
                            (funcall assert (funcall js-instanceof result cls))
                            (js-call assert :equal (Object/isFrozen result) t)
                            (js-call assert :notEqual result input)
                            (js-call assert :equal (meta result) metadata)
                            (js-call assert :deepEqual (Array/from input) original)
                            (js-call assert :equal (invoke-host a "boundary_echo" input) input)
                            (cond
                              ((= name "boundary_vector_update")
                               (funcall assert (Object/is (js-call result :nth 0) -0.0))
                               (js-call assert :equal (js-call result :nth 1) shared))
                              ((= name "boundary_map_update")
                               (js-call assert :equal (js-call result :get (keyword "updated")) 42)
                               (js-call assert :equal (js-call result :get (keyword "child")) shared))
                              ((= name "boundary_set_update")
                               (js-call assert :equal (js-call result :has 42) t))
                              ((= name "boundary_queue_update")
                               (js-call assert :deepEqual (Array/from result) (js-array shared 42)))
                              (t
                               (js-call assert :deepEqual (Array/from result) (js-array 42 shared)))))
                          (finally
                            (js-call a :release output))))))
                  (let ((symbol (eliscriptSymbol "same")))
                    (js-call assert :equal (invoke-host a "boundary_echo" symbol) symbol)))
                (finally
                  (finish a)))))
          60000)

        (funcall host-test
          (str host " persistent branding rejects ordinary lookalikes and close releases boundary roots")
          (async ()
            (let* ((opened (await (open-runtime host)))
                   (a (get opened :runtime))
                   (m (get opened :namespace))
                   (closed false))
              (try
                (let ((fake (js-call m :boundary_fake)))
                  (js-call assert :equal (funcall js-instanceof fake PersistentVector) false)
                  (js-call assert :equal (get fake :kind) "vector")
                  (js-call (js-array PersistentList PersistentVector PersistentHashMap PersistentHashSet PersistentQueue) :forEach
                    (lambda (cls)
                      (js-call assert :equal (funcall js-instanceof fake cls) false)))
                  (let ((host-fake (Object/freeze (js-object :kind "vector" :count 2 :values (js-array 1 2)))))
                    (js-call assert :equal (invoke-host a "boundary_echo" host-fake) host-fake))
                  (let* ((retained (get m :vector_value))
                         (imported (persistentList (get m :map_value) retained)))
                    (js-call assert :equal (invoke-host a "boundary_echo" imported) imported)
                    (funcall assert (> (js-call a :live) 0))
                    (js-call a :closeModule)
                    (js-call a :collect)
                    (js-call assert :equal (js-call a :live) 0)
                    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                    (js-call assert :deepEqual (js-call (Array/from retained) :slice 0 2) (js-array 1 2))
                    (when (get a :close) (js-call a :close))
                    (when (get a :close) (js-call a :close))
                    (setq closed t)
                    (js-call assert :throws
                      (lambda () (js-call a :fromHostValue imported))
                      (new globalThis.RegExp "closed"))))
                (finally
                  (unless closed
                    (finish a))))))
          60000)

        (funcall host-test
          (str host " regex patterns keep the actual private brand and identity while matching in the target")
          (async ()
            (let* ((opened (await (open-runtime host)))
