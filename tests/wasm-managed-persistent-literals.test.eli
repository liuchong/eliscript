                  (js-call assert :equal (regexSource pattern) "a+")
                  (js-call assert :equal (regexFlags pattern) "iu")
                  (js-call assert :equal match "AAA")
                  (js-call assert :equal (invoke-host a "boundary_echo" pattern) pattern)
                  (let* ((original (compileRegex "a+" "iu"))
