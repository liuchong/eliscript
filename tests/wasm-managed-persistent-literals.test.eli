        (funcall host-test
          (str host " regex boundaries use the declared host provider private registry")
          (async ()
            (setq serial (+ serial 1))
            (let* ((alternative
                     (await (funcall dyn-import
                              (str (get (pathToFileURL (resolve root "runtime/core/regex.mjs")) :href)
                                   "?persistent-boundary=" serial))))
                   (original (js-call alternative :compileRegex "a+" "iu")))
              (js-call assert :equal (js-call alternative :isRegexPattern original) t)
              (js-call assert :equal (isRegexPattern original) false)
              (let* ((opened
                       (await (open-runtime host
                                (js-object :hostModules
                                  (new globalThis.Map (js-array (js-array "eliscript/runtime/core/regex" alternative)))))))
                     (a (get opened :runtime)))
                (try
                  (js-call assert :equal (invoke-host a "boundary_echo" original) original)
                  (let ((raw (js-call a :fromHostValue original))
                        (output undefined))
                    (try
                      (setq output (js-call a :invoke "boundary_regex_value" (js-array)))
                      (finally
                        (js-call a :release raw)))
                    (try
                      (let ((result (js-call a :toHostValue output)))
                        (js-call assert :equal (aref result 0) (aref result 1))
                        (js-call assert :equal (js-call alternative :isRegexPattern (aref result 0)) t)
                        (js-call assert :equal (isRegexPattern (aref result 0)) false)
                        (js-call assert :equal (aref result 2) "AAA"))
                      (finally
                        (js-call a :release output))))
                  (finally
                    (finish a))))))
          60000)

        (funcall host-test
          (str host " sorted boundaries keep normalized comparator identity without calling it again")
          (async ()
            (let* ((opened (await (open-runtime host)))
                   (a (get opened :runtime))
                   (m (get opened :namespace)))
              (try
                (let* ((vals (js-call m :boundary_sorted_values))
                       (map (aref vals 0))
                       (comparison (aref vals 1))
                       (alias (aref vals 2))
                       (set (aref vals 3))
                       (set-comparison (aref vals 4))
                       (calls (aref vals 5))
                       (before (aref vals 6)))
                  (funcall assert (funcall js-instanceof map PersistentSortedMap))
                  (funcall assert (funcall js-instanceof set PersistentSortedSet))
                  (js-call assert :equal alias map)
                  (js-call assert :equal (get map :comparator) comparison)
                  (js-call assert :equal (get set :comparator) set-comparison)
                  (js-call assert :equal (funcall calls) before)
                  (js-call assert :deepEqual (Array/from map) (js-array (js-array 1 "a") (js-array 2 "b")))
                  (js-call assert :deepEqual (Array/from set) (js-array 1 3))
                  (js-call assert :equal (funcall calls) before)
                  (js-call assert :equal (js-call (meta map) :get (keyword "origin")) "target")
                  (js-call assert :equal (Object/isFrozen map) t)
                  (js-call assert :equal (Object/isFrozen set) t)
                  (js-call assert :equal (funcall comparison 2 1) 1)
                  (js-call assert :equal (funcall calls) (+ before 1))
                  (js-call assert :equal (invoke-host a "boundary_echo" map) map)
                  (js-call assert :equal (invoke-host a "boundary_echo" set) set)
                  (let* ((original (persistentSortedMap 1 "a" 2 "b"))
                         (raw (js-call a :fromHostValue original))
                         (proto (get PersistentSortedMap :prototype))
                         (descriptor (Object/getOwnPropertyDescriptor proto "assoc"))
                         (result undefined))
                    (try
                      (Object/defineProperty proto "assoc"
                        (Object/assign (js-object) descriptor
                          (js-object :value
                            (lambda ()
                              (throw (new globalThis.Error "target sorted updates must not execute a host collection algorithm"))))))
                      (setq result (js-call a :invoke "boundary_sorted_default_update" (js-array raw)))
                      (finally
                        (Object/defineProperty proto "assoc" descriptor)
                        (js-call a :release raw)))
                    (try
                      (let ((updated (js-call a :toHostValue result)))
                        (funcall assert (funcall js-instanceof updated PersistentSortedMap))
                        (js-call assert :equal (get updated :comparator) (defaultSortedComparator))
                        (js-call assert :deepEqual (Array/from updated) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c")))
                        (js-call assert :deepEqual (Array/from original) (js-array (js-array 1 "a") (js-array 2 "b"))))
                      (finally
                        (js-call a :release result))))
                  (let ((fake (Object/freeze
                                (js-object
                                  :kind "sorted-map"
                                  :entries (js-array (js-array 1 "a"))
                                  :comparison (lambda (left right) (- left right))))))
                    (js-call assert :equal (invoke-host a "boundary_sorted_QMARK_" fake) false)))
                (finally
                  (finish a)))))
          60000)

        (funcall host-test
          (str host " public and internal value hashing share actual caches and resettable metrics")
