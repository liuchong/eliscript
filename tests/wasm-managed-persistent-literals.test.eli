                    (js-object :hashValueCalls 0 :protocolHashComputations 0 :protocolHashCacheHits 0 :hostIdentityAssignments 0))
                  (js-call assert :equal recomputed (hashValue (persistentVector 1 2)))
                  (js-call assert :deepEqual
