                  (js-call assert :equal (get value :value) shared)
                  (funcall assert (Object/is (get shared :zero) -0.0))
                  (js-call assert :equal (funcall method value) shared)
                  (js-call assert :equal (isRecordType record-ctor) t)
                  (js-call assert :equal (isRecordType other-record-ctor) t)
                  (js-call assert :notEqual record-ctor other-record-ctor)
                  (js-call assert :equal (get record-ctor :recordName) (get other-record-ctor :recordName))
                  (js-call assert :deepEqual (Array/from (get record-ctor :recordFields)) (Array/from (get other-record-ctor :recordFields)))
                  (js-call assert :equal (get record-ctor :recordFields) record-fields)
