  (funcall (currentPerformanceTest test) "current-source performance acceptance: direct WASM artifacts and promotion" (async ()
    (let* ((report (JSON/parse (await (readFile (resolve root "tools/backends/results/direct-wasm-macos-arm64.json") "utf8"))))
      (source (str (await (readFile (resolve root "tools/experiments/native-wasm/kernels.eli") "utf8")) "\n" (await (readFile (resolve root "tools/backends/batches.eli") "utf8"))))
      (input undefined) (javascript undefined) (wasm undefined) (digest (lambda (value) (js-call (js-call (createHash "sha256") :update value) :digest "hex"))) (promotion undefined))
      (await (validateDirectWasmReport report))
      (setq input (js-call (get (aref generations 0) :compiler) :compile_ir_string source "direct-batches.eli"))
      (setq javascript (js-call (get (aref generations 0) :numeric) :emit_numeric_javascript input))
      (setq wasm (Uint8Array/from (js-call (get (aref generations 0) :wasm) :emit_numeric_wasm input)))
      (js-call assert :deepEqual (get report :artifacts) (js-object :javascriptSha256 (funcall digest javascript) :wasmSha256 (funcall digest wasm) :wasmBytes (js-length wasm)
        :wasmImports (js-length (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module wasm))) :externalBackend false))
      (setq promotion (spawnSync "bun" (js-array (resolve root "tools/backends/benchmark.mjs") "--require-production") (js-object :encoding "utf8")))
      (js-call assert :equal (get promotion :status) (if (get (get report :decision) :productionPassed) 0 1) (get promotion :stderr)))))
