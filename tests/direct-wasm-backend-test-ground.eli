  (defvar pageBundle undefined)
(defasync evaluateBrowser (entry data)
      (let ((context (await (js-call browserProcess :newContext))))
        (try (let ((page (await (js-call context :newPage))))
          (js-call page :on "console" (lambda (message) (when (js-call (js-call message :text) :startsWith "eliscript browser phase:") (js-call globalThis.console :log (js-call message :text)))))
          (let ((result (await (js-call page :evaluate
            (js* "async (input) => { const url = URL.createObjectURL(new Blob([input.pageBundle], {type: 'text/javascript'})); try { const module = await import(url); return await module[input.entry](input.data); } finally { URL.revokeObjectURL(url); } }")
            (js-object :pageBundle pageBundle :entry entry :data (Object/assign (js-object :bundle browserBundle) data))))))
            (js-call globalThis.console :log (str "browser engine verified: " browserName " " (js-call browserProcess :version))) result)) (finally (await (js-call context :close))))))


  (defasync verifyBrowserSource (entry data options)
    (let* ((result (await (evaluateBrowser entry data))) (g (aref generations 2)) (compiler (get g :compiler)))
      (js-call assert :deepEqual result (js-call (get g :managed) :emit_managed_wasm
        (js-call compiler :compile_ir_string (get data :source) (get data :filename))
        (js-call compiler :compile_ir_string (get data :runtime) "runtime.eli") options))))
  (defasync verifyBrowserSeed (key entry)
    (let ((seed (get runtimeSeeds key)))
      (verifyBrowserSource entry (js-object :source (get seed :source) :seed (get seed :javascript) :filename (get seed :filename)
        :runtime (get (get runtimeSeeds :memory) :source) :runtimeOptions undefined) undefined)))
  (defasync verifyBrowserFixture (fixture entry)
    (let* ((filename (resolve root (str "tests/fixtures/" fixture ".eli"))) (source (await (readFile filename "utf8")))
      (seed (await (seedJavascript filename (resolve directory (str "browser-" fixture "-seed.mjs"))))))
      (verifyBrowserSource entry (js-object :source source :seed seed :filename filename :runtime (get (get runtimeSeeds :memory) :source) :runtimeOptions undefined) undefined)))

  (defasync verifyBrowserRuntimeFixture (fixture filename entry slots initialBytes)
    (let* ((source (await (readFile (resolve root (str "tests/fixtures/" fixture ".eli")) "utf8"))) (runtime (get (get runtimeSeeds :memory) :source)))
      (verifyBrowserSource entry (js-object :source source :filename filename :runtime runtime :runtimeOptions (js-object :maxSlots slots :initialBytes initialBytes :maxBytes 1048576)) (js-object :maximumPages 16))))
(describe "browser compiler backends" (lambda ()

    (beforeAll (async ()
      (let* ((entry (resolve directory "browser-entry.mjs")) (input (resolve directory "browser-entry.eli"))
        (sources (js-array
          (js-array (resolve directory "g3/bootstrap/compiler.mjs") (js-array "compile_ir_string" "emit_ir_string"))
          (js-array (resolve directory "g3/backends/wasm.mjs") (js-array "emit_numeric_wasm" "emit_memory_wasm"))
          (js-array (resolve root "tools/backends/memory-runtime.mjs") (js-array "instantiateMemoryRuntime"))
          (js-array (resolve root "tools/backends/managed-runtime.mjs") (js-array "instantiateManagedRuntime"))
          (js-array (resolve directory "g3/backends/native.mjs") (js-array "emit_native_numeric_object" "emit_native_numeric_library" "emit_native_numeric_executable"))
          (js-array (resolve directory "g3/backends/managed.mjs") (js-array "emit_managed_wasm" "emit_managed_project_wasm"))))
        (imports (js-call (js-call sources :map (lambda (item) (str "(import " (JSON/stringify (aref item 0)) " " (js-call (aref item 1) :join " ") ")"))) :join "\n"))
