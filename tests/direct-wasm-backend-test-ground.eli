  (test "seed and self-hosted JS emission preserve literal and quoted negative zero" (async ()
    (let* ((source (directSource "seed and self-hosted JS emission preserve literal and quoted negative zero")) (input (resolve directory "negative-zero.eli")) (seed undefined))
      (await (writeFile input source)) (setq seed (spawnSync (resolve root "bin/eliscript-seed") (js-array input) (js-object :encoding "utf8")))
      (js-call assert :equal (get seed :status) 0 (get seed :stderr))
      (js-call assert :equal (js-call (get (aref generations 2) :compiler) :compile_string source input) (get seed :stdout))
      (let ((module (await (funcall load (str "data:text/javascript;base64," (js-call (Buffer/from (get seed :stdout)) :toString "base64"))))))
        (sameNumber (js-call module :literal) (js* "-0") "literal") (sameNumber (js-call module :quoted) (js* "-0") "quoted")))))

