        (let ((syntax (spawnSync (nodeExecutable) (js-array "--check" output) (js-object :encoding "utf8")))) (js-call assert :equal (get syntax :status) 0 (get syntax :stderr)))
        (let* ((emacs (get (get process :env) :EMACS))
