(module tests.backend-cli-isolation-test-ground
  (import "node:process" :default process)
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" copyFile mkdir mkdtemp readFile readdir rm symlink writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawn)
  (import "node:url" pathToFileURL)
  (import "../tools/integrity/check.mjs" checkRepositoryIntegrity)
  (defvar directory undefined) (defvar root undefined) (defvar scratch undefined) (defvar input undefined) (defvar outcomes undefined) (defvar integrityFailure undefined)
  (defun cli (target output &rest __host_default_arguments_1)
    (let* ((source (aref __host_default_arguments_1 0)) (environment (aref __host_default_arguments_1 1)))
    (when (= source undefined) (setq source input))
    (when (= environment undefined) (setq environment (js-object)))
    (new globalThis.Promise (lambda (accept reject)
      (let ((child (spawn "bun" (js-array (resolve root "tools/backends/compile.mjs") "--abi" "numeric-f64" "--target" target "-o" output source)
              (js-object :cwd root :env (Object/assign (js-object) (get process :env) (js-object :TMPDIR scratch) environment)
                :stdio (js-array "ignore" "pipe" "pipe") :timeout 30000))) (stderr ""))
        (js-call (get child :stdout) :resume)
        (js-call (get child :stderr) :on "data" (lambda (chunk) (setq stderr (str stderr chunk))))
        (js-call child :on "error" reject)
        (js-call child :on "close" (lambda (code signal) (accept (js-object :code code :signal signal :stderr stderr)))))))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-cli-isolation-"))))
    (setq root (resolve directory "checkout")) (setq scratch (resolve directory "scratch"))
    (await (mkdir (resolve root "tools/backends") (js-object :recursive t)))
    (await (mkdir (resolve root "dist/bootstrap") (js-object :recursive t))) (await (mkdir scratch))
    (await (mkdir (resolve root "bin"))) (await (copyFile (resolve "bin/eliscript-bootstrap") (resolve root "bin/eliscript-bootstrap")))
    (let ((names (js-array "compile.mjs" "build.mjs")) (index 0))
      (while (< index (get names :length))
        (let ((name (aref names index))) (await (copyFile (resolve "tools/backends" name) (resolve root "tools/backends" name))))
        (setq index (1+ index))))
    (let ((names (js-array "compiler" "bootstrap" "runtime")) (index 0))
      (while (< index (get names :length))
        (let ((name (aref names index))) (await (symlink (resolve name) (resolve root name) "dir")))
        (setq index (1+ index))))
    (await (symlink (resolve "tools/bootstrap-seed.el") (resolve root "tools/bootstrap-seed.el")))
    (await (writeFile (resolve root "dist/bootstrap/compiler.mjs") "// unrelated existing build cache\n"))
    (setq input (resolve directory "input.eli")) (await (writeFile input "(defun f (value) (+ value 1)) (export f)"))
    (setq outcomes (await (Promise/all (js-array (cli "js" (resolve directory "out.mjs")) (cli "wasm" (resolve directory "out.wasm"))))))
    (let ((contract (JSON/parse (await (readFile (resolve "contracts/repository-integrity.json") "utf8")))))
      (try (await (checkRepositoryIntegrity (js-object :root root :contract contract :trackedFiles (js-array) :dependenciesOnly t)))
        (catch error (setq integrityFailure error))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "Given concurrent independent CLI requests, when JS and WASM compile, then both exact outputs execute" (async ()
    (js-call outcomes :forEach (lambda (result) (js-call assert :equal (get result :code) 0 (get result :stderr)) (js-call assert :equal (get result :signal) nil)))
    (let ((js (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve directory "out.mjs")) :href))))
          (wasm (new WebAssembly.Instance (new WebAssembly.Module (await (readFile (resolve directory "out.wasm")))))))
      (js-call (js-array (js* "-0") 0 7 globalThis.NaN globalThis.Infinity (get globalThis.Number :MIN_VALUE)) :forEach
        (lambda (value) (assert (Object/is (js-call (get wasm :exports) :f value) (js-call js :f value))))))))
  (test "Given an existing checkout cache, when the standalone CLI finishes, then unrelated cached contents remain unchanged" (async ()
    (js-call assert :equal (await (readFile (resolve root "dist/bootstrap/compiler.mjs") "utf8")) "// unrelated existing build cache\n")
    (js-call assert :deepEqual (await (readdir scratch)) (js-array))))
  (test "Given rejected source, when the standalone CLI fails, then no output or private build directory remains" (async ()
    (let ((source (resolve directory "invalid.eli")) (output (resolve directory "invalid.wasm")))
      (await (writeFile source "(defun f (value) \"unsupported\") (export f)"))
      (let ((result (await (cli "wasm" output source))))
        (js-call assert :notEqual (get result :code) 0) (js-call assert :equal (get result :signal) nil)
        (js-call assert :match (get result :stderr) (new globalThis.RegExp "ELI-B0001"))
        (js-call assert :equal (await (js-call (Bun/file output) :exists)) false)
        (js-call assert :deepEqual (await (readdir scratch)) (js-array))))) 30000)
  (test "Given an unavailable Seed executable, when preparation fails, then private build storage is still released" (async ()
    (let* ((output (resolve directory "missing-seed.wasm")) (result (await (cli "wasm" output input (js-object :EMACS "eliscript-intentionally-missing-emacs")))))
      (js-call assert :notEqual (get result :code) 0) (js-call assert :equal (get result :signal) nil)
      (js-call assert :match (get result :stderr) (new globalThis.RegExp "ENOENT|Executable not found"))
      (js-call assert :match (get result :stderr) (new globalThis.RegExp "eliscript-intentionally-missing-emacs"))
      (js-call assert :equal (await (js-call (Bun/file output) :exists)) false)
      (js-call assert :deepEqual (await (readdir scratch)) (js-array)))))
  (test "Given an existing checkout cache, when integrity inspection fails after loading its compiler, then the cache remains unchanged" (async ()
    (js-call assert :equal (if (nullish? integrityFailure) undefined (get integrityFailure :code)) "ENOENT")
    (assert (let ((path (get integrityFailure :path))) (if (nullish? path) undefined (js-call path :endsWith "package.json"))))
    (js-call assert :equal (await (readFile (resolve root "dist/bootstrap/compiler.mjs") "utf8")) "// unrelated existing build cache\n" "read-only integrity inspection must preserve unrelated build cache")))
)
