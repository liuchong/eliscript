(module tests.api-index
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" :default os)
  (import "node:path" :default path)
  (import "../tools/backends/build.mjs" root)
  (import "../tools/surface/generate-api.mjs" ApiIndexValidationError buildApiIndex generateApiArtifacts renderApiHtml renderApiJson)
  (defconst ROOT root)
  (defasync read-json (relative)
    (JSON/parse (await (readFile (js-call path :join ROOT relative) "utf8"))))
  (defasync validation-errors (metadata)
    (let ((errors undefined))
      (try (await (buildApiIndex (js-object :root ROOT :metadata metadata)))
        (catch error
          (js-call (expect error) :toBeInstanceOf ApiIndexValidationError)
          (setq errors (get error :errors))))
      (if (undefined? errors) (throw (new globalThis.Error "expected library API metadata validation to fail")) errors)))
  (defun named-module (index name)
    (js-call (get index :modules) :find (lambda (entry) (= (get entry :module) name))))
  (defun expected-module (name source spec spec-file role summary exports)
    (js-object :module name :source source :spec spec :specFile spec-file
      :stability "stable" :role role :summary summary :exports exports))
  (defun escape-html (value)
    (let ((text (funcall globalThis.String value)))
      (setq text (js-call text :replaceAll "&" "&amp;"))
      (setq text (js-call text :replaceAll "<" "&lt;"))
      (setq text (js-call text :replaceAll ">" "&gt;"))
      (setq text (js-call text :replaceAll "\"" "&quot;"))
      (js-call text :replaceAll "'" "&#39;")))
  (test "generated library API index matches every declared module and export"
    (async ()
      (let ((index (await (buildApiIndex (js-object :root ROOT)))))
        (js-call (expect (get index :moduleCount)) :toBe 46)
        (js-call (expect (get index :exportCount)) :toBe 599)
        (js-call (expect (get (named-module index "core-protocol") :exports)) :toContain "read-external-protocol-method")
        (js-call (expect (named-module index "core-regex")) :toEqual
          (expected-module "core-regex" "stdlib/core/regex.eli" "0178" "specs/0178-immutable-regex-text-processing.md" "runtime-core"
            "Immutable regular-expression patterns, capture-aware matching, memoized lazy scanning, and literal or callback replacement."
            (js-array "re-find" "re-matches" "re-replace" "re-seq" "regex" "regex-flags" "regex-source" "regex?")))
        (js-call (expect (named-module index "deferred")) :toEqual
          (expected-module "deferred" "stdlib/deferred.eli" "0161" "specs/0161-deferred-and-memoized-computation.md" "state"
            "Synchronous delayed computation and value-semantic function memoization."
            (js-array "delay" "delay?" "force" "memoize" "realized?")))
        (js-call (expect (named-module index "core-walk")) :toEqual
          (expected-module "core-walk" "stdlib/core/walk.eli" "0173" "specs/0173-persistent-tree-walk.md" "runtime-core"
            "Stack-safe pre-order and post-order traversal and rewriting of nested persistent values."
            (js-array "postwalk" "postwalk-replace" "prewalk" "prewalk-replace" "walk")))
        (js-call (expect (named-module index "core-zipper")) :toEqual
          (expected-module "core-zipper" "stdlib/core/zipper.eli" "0174" "specs/0174-persistent-zipper-navigation.md" "runtime-core"
            "Immutable tree locations for stack-safe navigation, editing, and persistent root reconstruction."
            (js-array "append-child" "branch?" "children" "down" "edit" "end?" "insert-child" "insert-left" "insert-right"
              "left" "leftmost" "lefts" "list-zipper" "make-node" "next" "node" "path" "prev" "remove" "replace"
              "right" "rightmost" "rights" "root" "up" "vector-zipper" "zipper" "zipper?")))
        (js-call (expect (named-module index "core-sorted")) :toEqual
          (expected-module "core-sorted" "stdlib/core/sorted.eli" "0175" "specs/0175-persistent-sorted-collections.md" "runtime-core"
            "Persistent AVL Maps and Sets with custom comparators, reversible traversal, and bounded range queries."
            (js-array "comparator" "empty-sorted-map" "empty-sorted-map-by" "empty-sorted-set" "empty-sorted-set-by" "rsubseq"
              "sorted-map" "sorted-map-by" "sorted-map?" "sorted-seq" "sorted-seq-from" "sorted-set" "sorted-set-by"
              "sorted-set?" "sorted?" "subseq")))
        (js-call (expect (named-module index "core-lazy-sequence")) :toEqual
          (expected-module "core-lazy-sequence" "stdlib/core/lazy-sequence.eli" "0176" "specs/0176-memoized-lazy-sequences.md" "runtime-core"
            "Demand-driven memoized sequences, deferred recursive tails, direct lazy transformations, and realization inspection."
            (js-array "lazy-cons" "lazy-dedupe" "lazy-distinct" "lazy-drop" "lazy-drop-while" "lazy-filter" "lazy-interpose"
              "lazy-keep" "lazy-keep-indexed" "lazy-map" "lazy-map-indexed" "lazy-mapcat" "lazy-partition-all" "lazy-partition-by"
              "lazy-remove" "lazy-seq" "lazy-seq?" "lazy-take" "lazy-take-nth" "lazy-take-while" "realize" "realized-count" "realized?")))
        (js-call (expect (named-module index "persistent-vector")) :toEqual
          (expected-module "persistent-vector" "stdlib/persistent-vector.eli" "0053" "specs/0053-eliscript-persistent-vector.md" "portable"
            "Persistent 32-way vectors with tail optimization and structural sharing."
            (js-array "empty-persistent-vector" "persistent-vector-assoc" "persistent-vector-conj" "persistent-vector-count"
              "persistent-vector-from-array" "persistent-vector-meta" "persistent-vector-nth" "persistent-vector-peek"
              "persistent-vector-pop" "persistent-vector-reduce" "persistent-vector-to-array" "persistent-vector-with-meta" "persistent-vector?")))
        (js-call (expect (named-module index "persistent-queue")) :toEqual
          (expected-module "persistent-queue" "stdlib/persistent-queue.eli" "0166" "specs/0166-persistent-queue.md" "runtime-core"
            "Persistent FIFO queues with shared Vector views, constant-time dequeue, and amortized constant-time enqueue."
            (js-array "empty-persistent-queue" "persistent-queue" "persistent-queue-conj" "persistent-queue-count"
              "persistent-queue-empty?" "persistent-queue-meta" "persistent-queue-peek" "persistent-queue-pop"
              "persistent-queue-reduce" "persistent-queue-to-array" "persistent-queue-with-meta" "persistent-queue?")))
        (js-call (expect (await (readFile (js-call path :join ROOT "docs/pages/api-index.json") "utf8"))) :toBe (renderApiJson index))
        (js-call (expect (await (readFile (js-call path :join ROOT "docs/pages/api.html") "utf8"))) :toBe (renderApiHtml index)))))
  (test "library API metadata must cover the exact standard-library surface"
    (async ()
      (let ((metadata (await (read-json "contracts/library-api.json"))))
        (js-call (get metadata :modules) :shift)
        (js-call (expect (await (validation-errors metadata))) :toContain
          "library API module inventory is missing current entries: bit"))))
  (test "library API metadata requires an explicit normalized module name"
    (async ()
      (let ((metadata (await (read-json "contracts/library-api.json"))))
        (put (aref (get metadata :modules) 0) :module " ")
        (js-call (expect (await (validation-errors metadata))) :toContain
          "library API module 0 must have a non-empty trimmed module name"))))
  (test "library API metadata must match specification stability"
    (async ()
      (let ((metadata (await (read-json "contracts/library-api.json"))))
        (put (named-module metadata "sequence") :stability "accepted")
        (js-call (expect (await (validation-errors metadata))) :toContain
          "sequence stability must match specification 0023 status stable"))))
  (test "library API metadata rejects an unknown owning specification"
    (async ()
      (let ((metadata (await (read-json "contracts/library-api.json"))))
        (put (named-module metadata "persistent-vector") :spec "9999")
        (let ((errors (await (validation-errors metadata))))
          (js-call (expect errors) :toContain "persistent-vector specification must match 0053")
          (js-call (expect errors) :toContain "persistent-vector references unknown specification 9999")))))
  (test "generated API page exposes deterministic search and machine-readable hooks"
    (async ()
      (let* ((index (await (buildApiIndex (js-object :root ROOT)))) (html (renderApiHtml index))
             (articles (js-call html :match (new globalThis.RegExp "<article class=\"api-module\"[\\s\\S]*?</article>" "g"))))
        (js-call (expect html) :toContain "data-api-search")
        (js-call (expect html) :toContain "data-api-module")
        (js-call (expect html) :toContain "href=\"api-index.json\"")
        (js-call (get (expect html) :not) :toContain "Generated on")
        (js-call (expect articles) :toHaveLength (get index :moduleCount))
        (let ((by-module (new globalThis.Map (js-call articles :map (lambda (article)
          (let ((match (js-call article :match (new globalThis.RegExp "<h3>(.*?)</h3>"))))
            (js-array (if match (aref match 1) undefined) article)))))))
          (js-call (expect (js-call (Array/from (js-call by-module :keys)) :sort)) :toEqual
            (js-call (js-call (get index :modules) :map (lambda (module) (escape-html (get module :module)))) :sort))
          (js-call (get index :modules) :forEach (lambda (module)
            (let ((article (js-call by-module :get (escape-html (get module :module)))))
              (js-call (expect article) :toContain (str "data-spec-link=\"" (get module :spec) "\""))
              (js-call (expect (js-call (Array/from (js-call article :matchAll
                (new globalThis.RegExp "<li><code>(.*?)</code></li>" "g"))) :map (lambda (match) (aref match 1)))) :toEqual
                (js-call (get module :exports) :map escape-html)))))))))
  (test "API artifact check rejects missing and byte-stale generated files"
    (async ()
      (let ((output-root (await (mkdtemp (js-call path :join (js-call os :tmpdir) "eliscript-api-index-")))))
        (try
          (await (js-call (get (expect (generateApiArtifacts (js-object :root ROOT :outputRoot output-root :check t))) :rejects) :toThrow
            "generated API artifacts are stale: docs/pages/api-index.json, docs/pages/api.html"))
          (await (generateApiArtifacts (js-object :root ROOT :outputRoot output-root)))
          (await (writeFile (js-call path :join output-root "docs/pages/api.html") "stale\n" "utf8"))
          (await (js-call (get (expect (generateApiArtifacts (js-object :root ROOT :outputRoot output-root :check t))) :rejects) :toThrow
            "generated API artifacts are stale: docs/pages/api.html"))
          (finally (await (rm output-root (js-object :recursive t :force t)))))))))
