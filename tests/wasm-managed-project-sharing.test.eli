             (original-entries (js-call (get fn :locals) :slice))
             (metadata (globalThis.structuredClone original-entries))
             (captured-source (js-object :index 19 :rootIndex 701)))
        (put (aref (get fn :locals) 3) :source captured-source)
        (put (aref metadata 3) :source (globalThis.structuredClone captured-source))
        (js-call assert :equal (js-call guards :compact_managed_function_locals fn) fn)
        (js-call assert :equal (get (get fn :locals) :length) 3)
        (js-call assert :deepEqual original-entries metadata)
        (js-call assert :equal (get (aref (get fn :locals) 1) :source) captured-source)
        (js-call assert :equal (get (aref (get fn :locals) 1) :rootIndex) 103)
        (js-call assert :equal (get (aref (get fn :locals) 2) :rootIndex) 101)
        (js-call assert :equal (get shared :value) 1)
        (js-call assert :equal
          (aref (get (aref (get (aref (get (js-call (get (aref (get body :children) 1) :children) :at -1) :children) 0) :children) 0) :children) 0)
          shared)
        (js-call assert :equal (get (aref (get (aref (get body :children) 0) :children) 0) :kind) "set")
        (js-call assert :equal
          (get (aref (get (aref (get (aref (get body :children) 0) :children) 0) :children) 0) :value)
          0)
        (let ((e (get (execute-typed fn) :e))
              (reference (get (execute-typed original) :e)))
          (js-call (js-array 0 1 4294967295) :forEach
            (lambda (input)
              (js-call assert :equal (js-call e :run input) (js-call reference :run input))))
          (js-call assert :equal (js-call e :run 0) 9
            "a newly reused bank must not inherit the earlier sibling value 9"))
        (let ((once (globalThis.structuredClone fn)))
          (js-call guards :compact_managed_function_locals fn)
          (js-call assert :deepEqual fn once))
        (let* ((returning (compact-function
                            (typed-sequence
                              (js-array
                                (typed-sequence (js-array (typed-set 1 (typed-literal 7)) (typed-local 1)))
                                (typed-sequence (js-array (typed-set 2 (typed-literal 9)) (typed-local 2)))))
                            (js-array "u32" "u32" "u32")))
               (returning-reference (globalThis.structuredClone returning)))
          (js-call guards :compact_managed_function_locals returning)
          (js-call assert :equal (get (get returning :locals) :length) 1)
          (js-call assert :equal (js-call (get (execute-typed returning) :e) :run) 9)
          (js-call assert :equal (js-call (get (execute-typed returning-reference) :e) :run) 9
            "reset wrappers keep the final child result rather than appending zero")))))

  (test "source steps take precedence over a wider literal expansion only when that exact sequence occurs once outside every backedge"
    (lambda ()
      (let* ((build
               (lambda ()
                 (let* ((zeros (globalThis.Array.from (js-object :length 12) (lambda () (typed-literal 0))))
                        (wide (typed-sequence (js-call zeros :concat (js-array (typed-set 1 (typed-literal 9))))))
                        (preferred (typed-sequence
                                     (js-array
                                       (typed-sequence (js-array wide (typed-set 3 (typed-local 1))))
                                       (typed-sequence (js-array (typed-set 3 (typed-add (typed-local 3) (typed-local 2)))
                                                                 (typed-set 2 (typed-literal 4))))
                                       (typed-local 3)))))
                   (js-object
                     :fn (compact-function
                           (typed-sequence (js-array (typed-literal 0) preferred))
                           (js-array "u32" "u32" "u32" "u32"))
                     :preferred preferred))))
             (reference (funcall build))
             (fallback (funcall build))
             (selected (funcall build)))
        (js-call guards :compact_managed_function_locals (get fallback :fn))
        (js-call assert :equal (get (get (get fallback :fn) :locals) :length) 3)
        (js-call assert :equal
          (js-call guards :finish_managed_bindings (get (get selected :fn) :body)
            (js-object :locals (js-array) :roots 0))
          (get (get selected :fn) :body))
        (js-call assert :equal (aref (get (get (get selected :fn) :body) :children) 1) (get selected :preferred)
          "binding finalization preserves the private source-steps identity")
        (js-call guards :compact_managed_function_locals (get selected :fn) (get selected :preferred))
        (js-call assert :equal (get (get (get selected :fn) :locals) :length) 2)
        (js-call (js-array reference fallback selected) :forEach
          (lambda (item)
            (js-call assert :equal (js-call (get (execute-typed (get item :fn)) :e) :run) 9)))
        (let* ((absent (funcall build))
               (before-absent (globalThis.structuredClone (get absent :fn))))
          (js-call guards :compact_managed_function_locals (get absent :fn)
            (typed-sequence (js-array (typed-literal 0) (typed-literal 0))))
          (js-call assert :deepEqual (get absent :fn) before-absent))
        (let ((repeated (funcall build)))
          (put (get repeated :fn) :body
            (typed-sequence (js-array (get repeated :preferred) (get repeated :preferred))))
          (let ((before-repeated (globalThis.structuredClone (get repeated :fn))))
            (js-call guards :compact_managed_function_locals (get repeated :fn) (get repeated :preferred))
            (js-call assert :deepEqual (get repeated :fn) before-repeated)))
        (js-call (js-array "while" "loop" "remainder-while" "guarded-while" "guarded-counter-while") :forEach
          (lambda (kind)
            (let ((nested (funcall build)))
              (put (get nested :fn) :body
                (typed-word kind nil (js-array (typed-literal 0) (get nested :preferred)) "i32"))
              (let ((before (globalThis.structuredClone (get nested :fn))))
                (js-call guards :compact_managed_function_locals (get nested :fn) (get nested :preferred))
                (js-call assert :deepEqual (get nested :fn) before))))))))

  (test "exclusive word and f64 banks remain separate and preserve branch effects signed zero exact NaN memory bits and trap spans"
    (lambda ()
      (let* ((store (lambda (at value)
                      (typed-word "memory-op"
                        (if (= (get value :type) "f64") "store-f64" "store-u32")
                        (js-array (typed-literal at) value))))
             (trap-span (js-object :filename "compact-trap-中😀.eli" :start 4 :end 12 :line 2 :column 3 :endLine 2 :endColumn 11))
             (body (typed-sequence
                     (js-array
                       (typed-sequence (js-array (typed-set 1 (typed-literal -0.0 "f64"))
                                                 (funcall store 0 (typed-local 1 "f64"))))
                       (typed-sequence (js-array (funcall store 8 (typed-local 2 "f64"))))
                       (typed-sequence (js-array (typed-set 3 (typed-word "memory-op" "load-f64"
                                                                (js-array (typed-literal 32)) "f64"))
                                                 (funcall store 16 (typed-local 3 "f64"))))
                       (typed-sequence
                         (js-array
                           (typed-set 4 (typed-literal 7))
                           (typed-word "if" nil
                             (js-array
                               (typed-word "word-compare" "=" (js-array (typed-local 0) (typed-literal 0)) "i32")
                               (funcall store 24 (typed-local 4))
                               (funcall store 24 (typed-literal 11))))))
                       (typed-sequence
                         (js-array
                           (funcall store 28 (typed-local 5))
                           (typed-word "if" nil
                             (js-array
                               (typed-word "word-compare" "=" (js-array (typed-local 0) (typed-literal 2)) "i32")
                               (typed-word "memory-op" "load-u32" (js-array (typed-literal 65536)) "u32"
                                 (js-object :span trap-span))
                               (typed-literal 0)))))
                       (typed-literal 0))))
             (fn (compact-function body (js-array "u32" "f64" "f64" "f64" "u32" "u32") 1))
             (original (globalThis.structuredClone fn)))
        (js-call guards :compact_managed_function_locals fn)
        (js-call assert :equal (get (get fn :locals) :length) 3)
        (js-call assert :deepEqual
          (js-call (get fn :locals) :map (lambda (entry) (get entry :type)))
          (js-array "u32" "f64" "u32"))
        (js-call (js-array false t) :forEach
          (lambda (debug)
            (let ((compiled (execute-typed fn debug))
                  (reference (execute-typed original debug)))
              (js-call (js-array compiled reference) :forEach
                (lambda (item)
                  (let* ((e (get item :e))
                         (view (new globalThis.DataView (get (get e :memory) :buffer))))
                    (js-call view :setUint32 32 305419896 t)
                    (js-call view :setUint32 36 2146959361 t)
                    (js-call assert :equal (js-call e :run 0) 0)
                    (funcall assert (Object/is (js-call view :getFloat64 0 t) -0.0))
                    (funcall assert (Object/is (js-call view :getFloat64 8 t) 0))
                    (js-call assert :equal (js-call view :getUint32 16 t) 305419896)
                    (js-call assert :equal (js-call view :getUint32 20 t) 2146959361)
                    (js-call assert :equal (js-call view :getUint32 24 t) 7)
                    (js-call assert :equal (js-call view :getUint32 28 t) 0)
                    (js-call assert :equal (js-call e :run 1) 0)
                    (js-call assert :equal (js-call view :getUint32 24 t) 11)
                    (js-call assert :throws (lambda () (js-call e :run 2)) globalThis.WebAssembly.RuntimeError)
                    (js-call assert :equal (js-call e :run 0) 0))))
              (when debug
                (funcall assert
                  (js-call (get (get (get compiled :artifact) :debug) :ranges) :some
                    (lambda (range)
                      (let ((sp (get range :span)))
                        (and (not (nullish? sp))
                             (= (get sp :filename) (get trap-span :filename))
                             (= (get sp :start) 4)
                             (= (get sp :end) 12)))))))))))))

  (test "one reset before a loop-containing sibling preserves carried state while every backedge ancestor and repeated sequence DAG stays excluded"
    (lambda ()
      (let* ((loop-body (typed-sequence
                          (js-array
                            (typed-set 1 (typed-add (typed-local 1) (typed-literal 1)))
                            (typed-set 2 (typed-add (typed-local 2) (typed-local 1)))
                            (typed-literal 0) (typed-literal 0) (typed-literal 0))))
             (loop-node (typed-word "while" nil
                          (js-array (typed-word "word-compare" "<"
                                      (js-array (typed-local 1) (typed-literal 3)) "i32")
                                    loop-body)
                          "i32"))
             (body (typed-sequence
                     (js-array
                       (typed-sequence (js-array loop-node (typed-set 3 (typed-local 2))))
                       (typed-sequence (js-array (typed-set 4 (typed-literal 9))
                                                 (typed-set 3 (typed-add (typed-local 3) (typed-local 5)))))
                       (typed-local 3))))
             (fn (compact-function body (js-array "u32" "u32" "u32" "u32" "u32" "u32" "u32")))
             (original (globalThis.structuredClone fn)))
        (js-call guards :compact_managed_function_locals fn)
        (js-call assert :equal (get (get fn :locals) :length) 3)
        (js-call assert :equal (get (get loop-body :children) :length) 5)
        (js-call assert :equal (js-call (get (execute-typed fn) :e) :run) 6)
        (js-call assert :equal (js-call (get (execute-typed original) :e) :run) 6)
        (js-call (js-array "while" "loop" "remainder-while" "guarded-while" "guarded-counter-while") :forEach
          (lambda (kind)
            (let* ((nested (compact-function
                             (typed-word kind nil
                               (js-array (typed-literal 0)
                                         (typed-sequence
                                           (js-array (typed-set 1 (typed-literal 1)) (typed-local 1)
                                                     (typed-set 2 (typed-literal 2)) (typed-local 2)
                                                     (typed-literal 0))))
                               "i32")
                             (js-array "u32" "u32" "u32")))
                   (before (globalThis.structuredClone nested)))
              (js-call assert :equal (js-call guards :compact_managed_function_locals nested) nested)
              (js-call assert :deepEqual nested before))))
        (let* ((repeated (typed-sequence
                           (js-array (typed-set 1 (typed-literal 1)) (typed-local 1)
                                     (typed-set 2 (typed-literal 2)) (typed-local 2))))
               (dag (compact-function
                      (typed-sequence (js-array repeated repeated (typed-literal 0)))
                      (js-array "u32" "u32" "u32")))
               (before (globalThis.structuredClone dag)))
          (js-call guards :compact_managed_function_locals dag)
          (js-call assert :deepEqual dag before))
        (js-call (js-array "binding" "bindings" "sources") :forEach
          (lambda (key)
            (let ((hidden (compact-function
                            (typed-sequence
                              (js-array
                                (typed-sequence (js-array (typed-set 1 (typed-literal 1)) (typed-local 1)))
                                (typed-sequence (js-array (typed-set 2 (typed-literal 2)) (typed-local 2)))
                                (typed-literal 0)))
                            (js-array "u32" "u32" "u32"))))
              (put (get hidden :body) key (js-object :index 1))
              (let ((saved (globalThis.structuredClone hidden)))
                (js-call guards :compact_managed_function_locals hidden)
                (js-call assert :deepEqual hidden saved))))))))

  (test "production managed local compaction keeps exact values live caller GC roots and capacity error cleanup in real WASM"
    (async ()
      (let* ((runtime (js-call (get backend :compiler) :compile_ir_string
                        (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                        "compact-real-runtime.eli"))
             (_ (freeze-graph runtime))
             (nils (js-call (globalThis.Array.from (js-object :length 64) (lambda () "nil")) :join " "))
             (common-source (str "(defconst wider-literal (js-array " nils "))\n"
                                 "(defun run (value) (let ((first (js-array value 7))) (get first 0)) (let ((second (js-array value 9))) (get second 0)) value) "
                                 "(defun capacity (value) (js-call value :repeat 100000)) (export run capacity)"))
             ;; Only retain the scalar count from this reference lower, not its complete
             ;; typed graph while the actual module is lowered and emitted below.
             (reference-local-count
               (let* ((reference-program (js-call (get backend :compiler) :compile_ir_string
                                           common-source "compact-real-source.eli"))
                      (reference (js-call (get backend :managed) :lower_managed_program
                                   reference-program runtime))
                      (initializer (js-call (get (get reference :typed) :functions) :find
                                     (lambda (fn) (= (get fn :name) "__eliscript_module_body")))))
                 (funcall assert initializer)
                 (get (get initializer :locals) :length)))
             (defs (js-call (globalThis.Array.from (js-object :length 32)
                              (lambda (_ index) (str "(defconst retained-" index " " index ")")))
                            :join "\n"))
             (source (str defs "\n" common-source))
             (program (js-call (get backend :compiler) :compile_ir_string source "compact-real-source.eli"))
             (lowered (js-call (get backend :managed) :lower_managed_program program runtime))
             (initializer (js-call (get (get lowered :typed) :functions) :find
                            (lambda (fn) (= (get fn :name) "__eliscript_module_body")))))
        (funcall assert initializer)
        (js-call assert :equal (get (get initializer :locals) :length) reference-local-count
          "32 independent scalar globals add no local declarations beyond the existing wider-child temporary bank")
        (funcall assert
          (js-call (get (get lowered :typed) :functions) :every
            (lambda (fn) (not (Object/hasOwn fn "localStorageSequence"))))
          "private source-steps pointers stay out of typed records")
        (let* ((bytes (globalThis.Uint8Array.from
                        (js-call (get backend :wasm) :append_metadata_section
                          (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                          "eliscript-managed-control"
                          (JSON/stringify (get lowered :descriptor)))))
               (a (instantiateManagedRuntime bytes
                    (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 65536 :initializeModule false)))
               (_1 (js-call a :auto 1))
               (_2 (js-call a :initializeModule))
               (held (js-call a :number -0.0))
               (text (js-call a :string "held"))
               (caller (js-call a :frame 2)))
          (js-call a :frameSet caller 0 held)
          (js-call a :frameSet caller 1 text)
          (try
            (let ((round 0))
              (while (< round 16)
                (js-call (js-array held text) :forEach
                  (lambda (input)
                    (let ((result (js-call a :invoke "run" (js-array input))))
                      (try
                        (funcall assert (js-call a :keyEqual result input))
                        (finally (js-call a :release result))))
                    (js-call a :collect)
                    (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                    (funcall assert (Object/is (js-call a :readNumber held) -0.0))
                    (js-call assert :equal (js-call a :readString text) "held")))
                (setq round (1+ round))))
            (js-call assert :throws
              (lambda () (js-call a :invoke "capacity" (js-array text)))
              (lambda (error)
                (let ((diag (get error :eliscriptDiagnostic)))
                  (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0002")))))
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (funcall assert (Object/is (js-call a :readNumber held) -0.0))
            (js-call assert :equal (js-call a :readString text) "held")
            (let ((recovered (js-call a :invoke "run" (js-array held))))
              (try
                (funcall assert (Object/is (js-call a :readNumber recovered) -0.0))
                (finally (js-call a :release recovered))))
            (finally
              (js-call a :leaveFrame caller)
              (js-call a :release held)
              (js-call a :release text)
              (js-call a :closeModule)
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))
    120000)

  (test "linking frozen wide literal graphs shares unchanged source leaves and retains exact executable values and function source"
    (async ()
      (let* ((nums (js-call (globalThis.Array.from (js-object :length 4096) (lambda (_ index) index)) :join " "))
             (source (str "(defun sample () (js-array -0.0 \"中😀\\ud800\" " nums ")) (export sample)"))
             (program (js-call (get backend :compiler) :compile_ir_string source "sharing-中.eli"))
             (original-leaves (js-call (nodes program) :filter (lambda (node) (= (get node :kind) "literal"))))
             (identities (new globalThis.Set original-leaves))
             (javascript (js-call (get backend :compiler) :emit_ir_string program))
             (reference (await (funcall dynamic-import
                                 (str "data:text/javascript;base64,"
                                      (js-call (Buffer/from javascript) :toString "base64")))))
             (oracle (spawnSync "node" (js-array sharing-node-helper-path)
                       (js-object :input javascript :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get oracle :error) undefined)
        (js-call assert :equal (get oracle :status) 0 (get oracle :stderr))
        (freeze-graph program)
        (let* ((modules (js-array (js-object :id "main.mjs" :program program)))
               (first (js-call (get backend :managed) :link_managed_project modules "main.mjs"))
               (linked-leaves (js-call (nodes (get first :program)) :filter
                                (lambda (node) (= (get node :kind) "literal")))))
          (js-call assert :equal (get linked-leaves :length) (get original-leaves :length))
          (funcall assert
            (js-call linked-leaves :every (lambda (node) (js-call identities :has node)))
            "unchanged literal records must not form another complete graph generation")
          (js-call assert :deepEqual
            (js-call (get backend :managed) :link_managed_project modules "main.mjs")
            first)
          (let ((declaration (js-call (get (get first :program) :body) :find
                               (lambda (node) (= (get node :kind) "function-declaration")))))
            (js-call assert :equal (get declaration :managedOriginal) (aref (get program :body) 0))
            (js-call assert :equal (get declaration :managedSourceText) (JSON/parse (get oracle :stdout))))
          (let* ((linked-js (js-call (get backend :compiler) :emit_ir_string (get first :program)))
                 (executable (await (funcall dynamic-import
                                      (str "data:text/javascript;base64,"
                                           (js-call (Buffer/from linked-js) :toString "base64")))))
                 (entry-fn (get executable (get (aref (get first :exports) 0) :internalName))))
            (js-call assert :deepEqual (funcall entry-fn) (js-call reference :sample))
            (funcall assert (Object/is (aref (funcall entry-fn) 0) -0.0)))))))

  (test "private persistent implementation imports retain the real dependency graph while unchanged literal records share their supplied source identity"
    (async ()
      (let* ((loaded (await (js-call backend :loadLiteralModules)))
             (literal-modules (get loaded :literalModules))
             (user (js-call (get backend :compiler) :compile_ir_string
                     "(defun sample () [7 \"中😀\\ud800\"]) (export sample)" "sharing-persistent.eli"))
             (original-leaves (new globalThis.Set)))
        (js-call literal-modules :forEach
          (lambda (mod)
            (js-call (nodes (get mod :program)) :forEach
              (lambda (node)
                (when (= (get node :kind) "literal")
                  (js-call original-leaves :add node))))))
        (js-call literal-modules :forEach (lambda (mod) (freeze-graph (get mod :program))))
        (freeze-graph user)
        (let* ((options (js-object :literalModules literal-modules))
               (input (js-array (js-object :id "main.mjs" :program user)))
               (linked (js-call (get backend :managed) :link_managed_project input "main.mjs" options)))
          (funcall assert (> (get (get linked :privateModules) :length) 0))
          (funcall assert
            (js-call (get linked :privateModules) :some
              (lambda (id) (js-call id :endsWith "/stdlib/managed-literals.mjs"))))
          (let ((leaves (js-call (nodes (get linked :program)) :filter
                          (lambda (node) (= (get node :kind) "literal")))))
            (funcall assert
              (js-call leaves :some (lambda (node) (js-call original-leaves :has node)))
              "private import relocation must not deep-copy unchanged implementation data"))
          (js-call assert :equal (get (aref (get linked :exports) 0) :name) "sample")
          (let ((declaration (js-call (get (get linked :program) :body) :find
                               (lambda (node)
                                 (and (= (get node :kind) "function-declaration")
                                      (= (get node :sourceFunctionName) "sample"))))))
            (funcall assert declaration)
            (js-call assert :equal (get declaration :managedOriginal) (aref (get user :body) 0))
            (funcall assert (js-call (get declaration :managedSourceText) :includes "function sample()")))
          (js-call assert :deepEqual
            (js-call (get backend :managed) :link_managed_project input "main.mjs" options)
            linked)
          ;; Both textual identities and actual normalized lexical names must keep the
          ;; generated import out of the way of user parameters and local bindings.
          (let ((collision (js-call (get backend :compiler) :compile_ir_string
                             "(defun sample ($eliscript-persistent-1) (let (($eliscript_persistent_0 \"held\")) [7 $eliscript_persistent_0 $eliscript-persistent-1])) (export sample)"
                             "persistent-alias-collision.eli")))
            (put (get (aref (get collision :body) 0) :properties)
                 "quoted\"\\\n$eliscript_persistent_2" "identity")
            (freeze-graph collision)
            (let ((salted (js-call (get backend :managed) :link_managed_project
                            (js-array (js-object :id "main.mjs" :program collision))
                            "main.mjs" options)))
              (funcall assert (> (get (get salted :privateModules) :length) 0))
              (funcall assert
                (js-call (get salted :privateModules) :every
                  (lambda (id) (js-call id :startsWith "$eliscript_persistent_3/"))))
              (js-call assert :equal (get (aref (get salted :exports) 0) :name) "sample")
              (let ((original-names
                      (js-call
                        (js-call (nodes collision) :filter
                          (lambda (node)
                            (js-call (js-array "parameter-binding" "lexical-binding") :includes (get node :kind))))
                        :map (lambda (node) (get node :value)))))
                (funcall assert (js-call original-names :includes "$eliscript-persistent-1"))
                (funcall assert (js-call original-names :includes "$eliscript_persistent_0")))))
          (js-call (js-array "__eliscript_persistent_0" "__eliscript-persistent-0") :forEach
            (lambda (name)
              (js-call assert :throws
                (lambda ()
                  (js-call (get backend :compiler) :compile_string
                    (str "(defun " name " () 1) (export " name ")") "reserved-user.eli"))
                (new globalThis.RegExp "reserved compiler prefix"))))
          (let ((invalid (globalThis.structuredClone user)))
            (put (aref (get invalid :body) 0) :value "__eliscript_persistent_0")
            (put (aref (get (js-call (get invalid :body) :at -1) :children) 0) :value "__eliscript_persistent_0")
            (freeze-graph invalid)
            (js-call assert :throws
              (lambda ()
                (js-call (get backend :managed) :link_managed_project
                  (js-array (js-object :id "main.mjs" :program invalid))
                  "main.mjs" options))
              (lambda (error)
                (let ((message "binding name uses reserved compiler prefix: __eliscript_persistent_0")
                      (span (get (aref (get invalid :body) 0) :span)))
                  (js-call assert :equal (get error :message) message)
                  (js-call assert :deepEqual (get error :eliscriptDiagnostic)
                    (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-B0001"
                               :severity "error" :phase "managed-backend" :message message
                               :location (js-object :file "sharing-persistent.eli"
                                                    :start (js-object :line (get span :line)
                                                                      :column (get span :column)))))
                  t)))))))
    120000)

  (test "frozen top-level literal expressions receive private project roots while literal data remains unchanged"
    (lambda ()
      (let* ((program (js-call (get backend :compiler) :compile_ir_string
                        "7 (defun sample () 9) (export sample)" "top-level-literal.eli"))
             (expression (aref (get program :body) 0))
             (_ (js-call assert :equal (get expression :kind) "expression-statement"))
             (lit (aref (get expression :children) 0)))
        (js-call assert :equal (get lit :kind) "literal")
        (freeze-graph program)
        (let* ((linked (js-call (get backend :managed) :link_managed_project
                         (js-array (js-object :id "main.mjs" :program program)) "main.mjs"))
               (root-node (js-call (get (get linked :program) :body) :find
                            (lambda (node) (= (get node :kind) "expression-statement")))))
          (funcall assert root-node)
          (js-call assert :notEqual root-node expression)
          (js-call assert :equal (get root-node :projectModule) "main.mjs")
          (js-call assert :equal (aref (get root-node :children) 0) lit)
          (js-call assert :equal (get lit :value) 7)
          (funcall assert (not (Object/hasOwn expression "projectModule")))
          (funcall assert (not (Object/hasOwn lit "projectModule")))
          (funcall assert (not (Object/hasOwn expression "projectPrepare")))
          (funcall assert (not (Object/hasOwn lit "projectPrepare"))))
        ;; The existing independent source prepass rejects raw literal declarations
        ;; before project wiring. Preserve that first Error rather than inventing a
        ;; backend diagnostic or writing project metadata onto a frozen node.
        (let ((raw (js-object :filename "raw-top-level-literal.eli" :body (js-array lit))))
          (freeze-graph raw)
          (js-call assert :throws
            (lambda ()
              (js-call (get backend :managed) :link_managed_project
                (js-array (js-object :id "main.mjs" :program raw)) "main.mjs"))
            (lambda (error)
              (and (funcall js-instanceof error globalThis.Error)
                   (= (get error :message) "IR node is not valid at module top level: literal")
                   (undefined? (get error :eliscriptDiagnostic)))))
          (funcall assert (not (Object/hasOwn lit "projectModule")))
          (funcall assert (not (Object/hasOwn lit "projectPrepare"))))))))
