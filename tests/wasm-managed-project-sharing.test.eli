(module tests.wasm-managed-project-sharing.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst receiver-fn (js* "(impl) => function (...args) { return impl(this, args); }"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))
  (defconst sharing-node-helper-path
    (fileURLToPath (new globalThis.URL "./helpers/wasm-managed-project-sharing-node.mjs" (get (js* "import.meta") :url))))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar guards undefined)
  (defvar literal-aliases undefined)
  (defvar ground-snapshots undefined)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-project-sharing-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((source (await (readFile "bootstrap/backends/managed.eli" "utf8")))
             (helpers (js-array "managed-fail" "word-node" "word-constant" "word-local" "word-set"
                                "word-sequence" "word-compare" "word-if" "append-managed" "new-managed-local"
                                "runtime-call" "runtime-arguments" "capture-error" "managed-guard"
                                "managed-source-root" "finish-managed-bindings-core" "finish-managed-bindings"
                                "managed-local-backedge-p" "managed-local-bank-compatible-p"
                                "compact-managed-function-locals"))
             ;; Compile the exact production helpers; the reference preserves the complete
             ;; original guard shape before per-state pure-node sharing was introduced.
             (reference "(defun managed-guard-reference (state expression)\n  (word-if\n    (word-compare (word-local (get state :error)) (word-constant 0) \"=\")\n    expression\n    (word-constant 0)))")
             (helper-source (str "(module managed.guard.sharing\n(import "
                                 (JSON/stringify (get (pathToFileURL (resolve directory "backends/numeric.mjs")) :href))
                                 " backend-fail find-function)\n"
                                 (js-call (js-call helpers :map (lambda (name) (definition source (str name " ")))) :join "\n")
                                 "\n" reference
                                 "\n(export managed-guard managed-guard-reference finish-managed-bindings compact-managed-function-locals))")))
        (setq guards
          (await (funcall dynamic-import
                   (str "data:text/javascript;base64,"
                        (js-call (Buffer/from (js-call (get backend :compiler) :compile_string helper-source "managed-guard-sharing.eli"))
                                 :toString "base64")))))
        ;; Expose the exact private production entry without replacing any of its
        ;; dependencies. Its ordinary relative imports resolve to the same backend.
        (let* ((lowering-signature "(defun lower-managed-function (function functions runtime)")
               (_ (js-call assert :equal (get (js-call source :split lowering-signature) :length) 2))
               (observed-source (js-call source :replace lowering-signature
                                  "(defun lower-managed-function-under-test (function functions runtime)"))
               (alias-source (str (js-call observed-source :slice 0 (js-call observed-source :lastIndexOf ")"))
                                  "\n (defvar observed-lowering-functions (js-array))\n"
                                  " (defun lower-managed-function (function functions runtime)\n"
                                  "   (let* ((nested (not (nil? (get function :outerState nil))))\n"
                                  "          (result (lower-managed-function-under-test function functions runtime)))\n"
                                  "     (js-call observed-lowering-functions :push (js-object :function function :nested nested)) result))\n"
                                  " (defun take-lowered-functions ()\n"
                                  "   (let ((records observed-lowering-functions))\n"
                                  "     (setq observed-lowering-functions (js-array)) records))\n"
                                  " (export managed-literal-context managed-literal-json-aliases lower-managed-function take-lowered-functions\n"
                                  "   managed-result snapshot-managed clear-managed-temporary-roots))"))
               (alias-path (resolve directory "backends/managed-alias-sharing.mjs")))
          (await (writeFile alias-path (js-call (get backend :compiler) :compile_string alias-source "managed-alias-sharing.eli")))
          (setq literal-aliases (await (funcall dynamic-import (get (pathToFileURL alias-path) :href))))
          ;; Keep the previous snapshot algorithm as an independent lowering reference.
          ;; All other production helpers, root cleanup and backend dependencies match.
          (let* ((old-snapshot "(defun snapshot-managed (lowered state)\n   (let ((snapshot (managed-result state (get lowered :result) nil)))\n     (put snapshot :steps (word-sequence (js-array (get lowered :steps) (get snapshot :steps)))) snapshot))")
                 (ground-source (js-call source :replace (definition source "snapshot-managed ") old-snapshot))
                 (ground-path (resolve directory "backends/managed-ground-snapshots.mjs")))
            (js-call assert :notEqual ground-source source)
            (await (writeFile ground-path (js-call (get backend :compiler) :compile_string ground-source "managed-ground-snapshots.eli")))
            (setq ground-snapshots (await (funcall dynamic-import (get (pathToFileURL ground-path) :href))))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun nodes (program)
    (let ((result (js-array))
          (pending (globalThis.Array.from (get program :body))))
      (while (> (get pending :length) 0)
        (let ((node (js-call pending :pop)))
          (js-call result :push node)
          (js-call (get node :children) :forEach (lambda (child) (js-call pending :push child)))))
      result))

  (defun freeze-graph (value)
    (let ((seen (new globalThis.Set))
          (pending (js-array value)))
      (while (> (get pending :length) 0)
        (let ((current (js-call pending :pop)))
          (when (and (not (nullish? current))
                     (= (value-type current) "object")
                     (not (js-call seen :has current)))
            (js-call seen :add current)
            (js-call (Object/values current) :forEach (lambda (child) (js-call pending :push child)))
            (Object/freeze current))))))

  (test "snapshot provenance reuses only unchanged same-state private roots and expires after actual RHS root cleanup"
    (lambda ()
      (let* ((make-state (lambda ()
                           (js-object
                             :locals (js-array (js-object :name "heap" :index 0 :type "u32")
                                               (js-object :name "frame" :index 1 :type "u32")
                                               (js-object :name "error" :index 2 :type "u32"))
                             :heap (js-object :index 0)
                             :frame (js-object :index 1)
                             :error (js-object :index 2)
                             :roots 0
                             :runtime (js-array (js-object :name "frame-set" :index 0)
                                                (js-object :name "last-error" :index 1)
                                                (js-object :name "frame-clear-range" :index 2)))))
             (first (funcall make-state))
             (expression (js-object :kind "literal" :type "u32" :children (js-array) :value 7))
             (stable (js-call literal-aliases :managed_result first expression t))
             (local-count (get (get first :locals) :length))
             (root-count (get first :roots)))
        (js-call assert :equal (js-call literal-aliases :snapshot_managed stable first) stable)
        (js-call assert :equal
          (js-call literal-aliases :snapshot_managed (js-call literal-aliases :snapshot_managed stable first) first)
          stable)
        (js-call assert :equal (get (get first :locals) :length) local-count)
        (js-call assert :equal (get first :roots) root-count)
        (js-call assert :equal (get (get stable :snapshotRoot) :stable) t)
        (js-call assert :deepEqual (Object/keys (get (get stable :snapshotRoot) :owner)) (js-array)
          "an empty identity token never retains its completed lowering state")
        (funcall assert (not (js-call (Object/values (get stable :snapshotRoot)) :includes first)))
        (js-call (get first :locals) :forEach
          (lambda (local-entry)
            (js-call assert :deepEqual
              (js-call (Object/keys local-entry) :sort)
              (if (undefined? (get local-entry :rootIndex))
                (js-array "index" "name" "type")
                (js-array "index" "name" "rootIndex" "type")))))
        (js-call assert :deepEqual (js-call (Object/keys (get stable :result)) :sort)
          (js-array "children" "kind" "type" "value"))
        (let ((foreign (funcall make-state)))
          (js-call assert :notEqual (js-call literal-aliases :snapshot_managed stable foreign) stable
            "another state cannot claim a private root"))
        (let ((replaced (Object/assign (js-object) stable
                          (js-object :result (Object/assign (js-object) (get stable :result))))))
          (js-call assert :notEqual (js-call literal-aliases :snapshot_managed replaced first) replaced
            "rewritten results cannot inherit provenance"))
        (let ((wrapped (js-object :steps (get stable :steps) :result (get stable :result))))
          (js-call assert :notEqual (js-call literal-aliases :snapshot_managed wrapped first) wrapped
            "rewrapped control-flow and binding results still snapshot"))
        (let ((root-idx (get first :roots)))
          (put first :roots (1+ root-idx))
          (let ((named (js-object :name "temporary" :type "u32"
                                  :index (get (get first :locals) :length)
                                  :rootIndex root-idx)))
            (js-call (get first :locals) :push named)
            (let ((binding (js-object
                             :steps (js-object :kind "literal" :type "u32" :children (js-array) :value 0)
                             :result (js-object :kind "binding-get" :type "u32" :children (js-array)
                                                :value (get named :index)))))
              (js-call assert :notEqual (js-call literal-aliases :snapshot_managed binding first) binding
                "a source binding named temporary is not private provenance"))))
        (let* ((before-clear (js-call literal-aliases :managed_result first expression false))
               (registration (- (get (get first :temporaryRoots) :length) 1)))
          (js-call literal-aliases :clear_managed_temporary_roots first registration (1+ registration))
          (js-call assert :notEqual (js-call literal-aliases :snapshot_managed before-clear first) before-clear
            "cleared roots cannot be reused"))
        (let* ((changed (js-call literal-aliases :managed_result first expression false))
               (entry (aref (get first :locals) (get (get changed :result) :value))))
          (put entry :rootIndex (1+ (get entry :rootIndex)))
          (js-call assert :notEqual (js-call literal-aliases :snapshot_managed changed first) changed
            "changed root ownership requires a fresh snapshot")))))

  (test "private result reuse reduces actual source-body IR growth while binding mutation captures first errors and collecting caller roots retain values"
    (async ()
      (let* ((runtime (js-call (get backend :compiler) :compile_ir_string
                        (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                        "snapshot-runtime.eli"))
             (measure (lambda (lowerer count)
                        (let* ((terms (globalThis.Array.from (js-object :length count)
                                        (lambda (_ index) (str "(+ " index " 1 2 3)"))))
                               (src (str "(defun wide () (js-array " (js-call terms :join " ") ")) (export wide)"))
                               (program (js-call (get backend :compiler) :compile_ir_string src "snapshot-growth.eli"))
                               (before (JSON/stringify program))
                               (lowered (js-call lowerer :lower_managed_program program runtime))
                               (descriptor (js-call (get (get lowered :descriptor) :functions) :find
                                             (lambda (fn) (= (get fn :name) "wide"))))
                               (_1 (funcall assert descriptor))
                               (wire-or-name (let ((wn (get descriptor :wireName)))
                                               (if (nullish? wn) (get descriptor :name) wn)))
                               (alias (js-call (get (get lowered :typed) :aliases) :find
                                        (lambda (entry) (= (get entry :name) wire-or-name))))
                               (_2 (funcall assert alias))
                               (fn (js-call (get (get lowered :typed) :functions) :find
                                     (lambda (entry) (= (get entry :name) (get alias :function)))))
                               (_3 (funcall assert fn))
                               (seen (new globalThis.Set))
                               (pending (js-array (get fn :body)))
                               (records 0))
                          (while (> (get pending :length) 0)
                            (let ((node (js-call pending :pop)))
                              (when (not (js-call seen :has node))
                                (js-call seen :add node)
                                (setq records (1+ records))
                                (let ((ch (get node :children)))
                                  (when (not (nullish? ch))
                                    (js-call ch :forEach (lambda (child) (js-call pending :push child))))))))
                          (js-call assert :equal (JSON/stringify program) before "source IR remains caller-owned")
                          records)))
             ;; Measure emitted semantic nodes, rather than assuming a helper call or a
             ;; particular temporary display name proves a smaller generated program.
             (old-small (funcall measure ground-snapshots 8))
             (old-large (funcall measure ground-snapshots 16))
             (small (funcall measure literal-aliases 8))
             (large (funcall measure literal-aliases 16)))
        (funcall assert (< large old-large) "the complete source function has fewer actual typed nodes")
        (funcall assert (< (- large small) (- old-large old-small))
          "doubling real arithmetic/array operands adds fewer nodes than the previous snapshot algorithm")
        (let* ((source (str "(defun select (first second third) (js-array first second third))\n"
                            "  (defun mutation (value)\n"
                            "    (let ((temporary value))\n"
                            "      (js-array temporary (setq temporary 9) temporary (select value (setq value 17) value))))\n"
                            "  (defun captures (value)\n"
                            "    (let ((write (lambda (next) (setq value next))) (read (lambda () value)))\n"
                            "      (js-array (funcall read) (funcall write 23) (funcall read))))\n"
                            "  (defun reuse (value) (let ((next (js-array value (+ 1 2)))) (js-array next next)))\n"
                            "  (defun first-error (marker) (select (throw false) (put marker 0 99) 0))\n"
                            "  (export mutation captures reuse first-error)"))
               (program (js-call (get backend :compiler) :compile_ir_string source "snapshot-values.eli"))
               (saved (JSON/stringify program))
               (reference (await (funcall dynamic-import
                                   (str "data:text/javascript;base64,"
                                        (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program))
                                                 :toString "base64")))))
               (lowered (js-call literal-aliases :lower_managed_program program runtime)))
          (js-call assert :equal (JSON/stringify program) saved)
          (let ((seen (new globalThis.Set))
                (pending (js-array (get lowered :typed) (get lowered :descriptor))))
            (while (> (get pending :length) 0)
              (let ((value (js-call pending :pop)))
                (when (and (not (nullish? value))
                           (= (value-type value) "object")
                           (not (js-call seen :has value)))
                  (js-call seen :add value)
                  (funcall assert (not (Object/hasOwn value "snapshotRoot")))
                  (funcall assert (not (Object/hasOwn value "snapshotOwnerToken")))
                  (js-call (Object/values value) :forEach (lambda (child) (js-call pending :push child)))))))
          (let* ((bytes (globalThis.Uint8Array.from
                          (js-call (get backend :wasm) :append_metadata_section
                            (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                            "eliscript-managed-control"
                            (JSON/stringify (get lowered :descriptor)))))
                 (_1 (js-call assert :deepEqual
                      (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
                      (js-array)))
                 (a (instantiateManagedRuntime bytes (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)))
                 (_2 (js-call a :auto 1))
                 (input (js-call a :number -0.0))
                 (text (js-call a :string "held"))
                 (trace-zero (js-call a :number 0))
                 (trace (js-call a :sourceArray (js-array trace-zero)))
                 (caller (js-call a :frame 2)))
            (js-call a :frameSet caller 0 input)
            (js-call a :frameSet caller 1 text)
            (letfn ((unpack (value)
                      (if (and (not (nullish? value)) (= (value-type value) "object"))
                        (cond
                          ((= (get value :kind) 4) (js-call a :readNumber value))
                          ((= (get value :kind) 5) (js-call a :readString value))
                          ((= (get value :kind) 14)
                           (globalThis.Array.from (js-object :length (js-call a :length value))
                             (lambda (_ index)
                               (let ((child (js-call a :get value index)))
                                 (try
                                   (unpack child)
                                   (finally (js-call a :release child)))))))
                          (t value))
                        value)))
              (try
                (let ((round 0))
                  (while (< round 8)
                    (js-call (js-array (js-array input -0.0) (js-array text "held")) :forEach
                      (lambda (pair)
                        (let ((value (aref pair 0))
                              (expected (aref pair 1)))
                          (js-call (js-array "mutation" "captures" "reuse") :forEach
                            (lambda (name)
                              (let ((result (js-call a :invoke name (js-array value))))
                                (try
                                  (js-call a :collect)
                                  (js-call assert :deepEqual (unpack result)
                                    (funcall (get reference name) expected))
                                  (when (= name "reuse")
                                    (let ((left (js-call a :get result 0))
                                          (right (js-call a :get result 1)))
                                      (try
                                        (funcall assert (js-call a :keyEqual left right))
                                        (finally
                                          (js-call a :release left)
                                          (js-call a :release right)))))
                                  (finally (js-call a :release result))))))
                          (let ((threw false))
                            (try
                              (js-call a :invoke "first-error" (js-array trace))
                              (catch error
                                (setq threw t)
                                (js-call assert :equal error false)))
                            (funcall assert threw))
                          (js-call assert :throws
                            (lambda () (js-call reference :first_error (js-array 0)))
                            (lambda (error) (= error false)))
                          (js-call assert :deepEqual (unpack trace) (js-array 0))
                          (js-call a :collect)
                          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                          (funcall assert (Object/is (js-call a :readNumber input) -0.0))
                          (js-call assert :equal (js-call a :readString text) "held"))))
                    (setq round (1+ round))))
                (finally
                  (js-call a :leaveFrame caller)
                  (js-call a :release input)
                  (js-call a :release text)
                  (js-call a :release trace)
                  (js-call a :release trace-zero)
                  (js-call a :closeModule)
                  (js-call a :collect)
                  (js-call assert :equal (js-call a :live) 0)
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))))
    15000)

  (test "completed nested sibling mutable and transitive captures execute after private parent lowering states are released"
    (async ()
      ;; Reuse the complete original callable fixture rather than substituting
      ;; modeled closures. Only the private JS wrapper records production returns.
      (let* ((fixture (await (readFile "tests/fixtures/wasm-managed-callables.eli" "utf8")))
             (program (js-call (get backend :compiler) :compile_ir_string fixture "callables.eli"))
             (saved (JSON/stringify program))
             (runtime (js-call (get backend :compiler) :compile_ir_string
                        (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                        "runtime.eli")))
        (js-call literal-aliases :take_lowered_functions)
        (let ((lowered (js-call literal-aliases :lower_managed_program program runtime))
              (records (js-call literal-aliases :take_lowered_functions)))
          (funcall assert
            (js-call records :some
              (lambda (record)
                (and (get record :nested)
                     (> (get (get (get record :function) :captures) :length) 0)))))
          (js-call records :forEach
            (lambda (record)
              (let ((fn (get record :function)))
                (js-call assert :equal (get fn :outerState) nil "completed function retains no parent state")
                (js-call assert :equal (get fn :outerScope) nil "completed function retains no parent scope array")
                (funcall assert (Array/isArray (get fn :locals)))
                (funcall assert (Array/isArray (get fn :captures)))
                (funcall assert (get fn :body)))))
          (js-call assert :equal (JSON/stringify program) saved)
          (let* ((reference (await (funcall dynamic-import
                                     (str "data:text/javascript;base64,"
                                          (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program))
                                                   :toString "base64")))))
                 (bytes (globalThis.Uint8Array.from
                          (js-call (get backend :wasm) :append_metadata_section
                            (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                            "eliscript-managed-control"
                            (JSON/stringify (get lowered :descriptor)))))
                 (_1 (js-call assert :deepEqual
                      (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
                      (js-array)))
                 (a (instantiateManagedRuntime bytes (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216)))
                 (_2 (js-call a :auto 1))
                 (retained (js-array))
                 (keep (lambda (value) (js-call retained :push value) value))
                 (numeric (lambda (name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
                            (let ((value (js-call a :invoke name (if (undefined? args) (js-array) args))))
                              (try
                                (js-call a :readNumber value)
                                (finally (js-call a :release value)))))))
                 (four (funcall keep (js-call a :number 4)))
                 (five (funcall keep (js-call a :number 5)))
                 (six (funcall keep (js-call a :number 6)))
                 (zero (funcall keep (js-call a :number -0.0)))
                 (caller (js-call a :frame 1)))
            (js-call a :frameSet caller 0 zero)
            (try
              (let ((adder (funcall keep (js-call a :invoke "make-adder" (js-array four)))))
                (js-call a :collect)
                (js-call assert :equal
                  (funcall numeric "apply-one" (js-array adder five))
                  (funcall (js-call reference :make_adder 4) 5)))
              (let* ((outer (funcall keep (js-call a :invoke "nested" (js-array four))))
                     (inner (funcall keep (js-call a :invoke "apply-one" (js-array outer five)))))
                (js-call a :collect)
                (js-call assert :equal
                  (funcall numeric "apply-one" (js-array inner six))
                  (funcall (funcall (js-call reference :nested 4) 5) 6)))
              (let* ((pair (funcall keep (js-call a :invoke "make-pair" (js-array four))))
                     (increment (funcall keep (js-call a :get pair 0)))
                     (current (funcall keep (js-call a :get pair 1)))
                     (oracle (js-call reference :make_pair 4))
                     (index 0))
                (while (< index 16)
                  (js-call assert :equal (funcall numeric "apply-zero" (js-array increment)) (funcall (aref oracle 0)))
                  (js-call a :collect)
                  (js-call assert :equal (funcall numeric "apply-zero" (js-array current)) (funcall (aref oracle 1)))
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                  (funcall assert (Object/is (js-call a :readNumber zero) -0.0))
                  (setq index (1+ index))))
              (js-call (js-array (js-array "outer-write" (funcall (js-call reference :outer_write 4)))
                                 (js-array "shadow" (funcall (js-call reference :shadow 4)))
                                 (js-array "parallel-capture" (funcall (js-call reference :parallel_capture 4))))
                :forEach
                (lambda (pair)
                  (let ((name (aref pair 0))
                        (expected (aref pair 1))
                        (fn (funcall keep (js-call a :invoke (aref pair 0) (js-array four)))))
                    (js-call a :collect)
                    (js-call assert :equal (funcall numeric "apply-zero" (js-array fn)) expected name))))
              (let ((sequential (funcall keep (js-call a :invoke "sequential-captures" (js-array four))))
                    (expected (js-call reference :sequential_captures 4))
                    (index 0))
                (while (< index 2)
                  (let ((fn (funcall keep (js-call a :get sequential index))))
                    (js-call a :collect)
                    (js-call assert :equal (funcall numeric "apply-zero" (js-array fn)) (funcall (aref expected index))))
                  (setq index (1+ index))))
              (let ((rec (funcall keep (js-call a :invoke "recursive" (js-array)))))
                (js-call a :collect)
                (js-call assert :equal
                  (funcall numeric "apply-one" (js-array rec six))
                  (funcall (js-call reference :recursive) 6)))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (funcall assert (Object/is (js-call a :readNumber zero) -0.0))
              (finally
                (js-call a :leaveFrame caller)
                (js-call retained :forEach (lambda (value) (js-call a :release value)))
                (js-call a :closeModule)
                (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
        ;; Successful cleanup does not become a finally action on a failed lower.
        (let* ((parent (js-object :sentinel t))
               (scope (js-array (js-object :name "held")))
               (invalid (js-object
                          :source (aref (get (js-call (get backend :compiler) :compile_ir_string
                                               "(defun invalid (value) value)" "bad-capture.eli") :body) 0)
                          :publicArity 99
                          :parameterKinds (js-array "required")
                          :outerState parent
                          :outerScope scope)))
          (js-call assert :throws
            (lambda () (js-call literal-aliases :lower_managed_function invalid (js-array) (js-array)))
            (lambda (error)
              (let ((diag (get error :eliscriptDiagnostic)))
                (and (not (nullish? diag)) (= (get diag :code) "ELI-B0001")))))
          (js-call assert :equal (get invalid :outerState) parent)
          (js-call assert :equal (get invalid :outerScope) scope))))
    15000)

  (test "persistent literal aliases scan every JSON string domain and numeric prefix without serializing a shared IR graph"
    (lambda ()
      (let* ((program (js-call (get backend :compiler) :compile_ir_string
                        "(defun run () (js-array :key \"$eliscript_persistent_30\")) (export run)" "alias.eli"))
             (adapter (js-call (get backend :compiler) :compile_ir_string
                        "(defun literal-kind (value) value) (export literal-kind)" "adapter.eli"))
             (shared (let ((s (js-object
                                :source "$eliscript_persistent_0123 and $eliscript_persistent_1234"
                                :number -0.0
                                :missing undefined)))
                       (put s "$eliscript_persistent_20-key" "ordinary")
                       s))
             (modules (js-array (js-object :id "entry.mjs" :program program)))
             (provided-item (let ((p (js-object
                                       :id "stdlib/managed-literals.mjs"
                                       :program adapter
                                       :source "$eliscript_persistent_4"
                                       :filename "$eliscript_persistent_50"
                                       :shared shared
                                       :again shared)))
                              (put p "$eliscript_persistent_6" undefined)
                              p))
             (provided (js-array provided-item))
             (text (str (JSON/stringify modules) (JSON/stringify provided)))
             (salt 0))
        (while (js-call text :includes (str "$eliscript_persistent_" salt))
          (setq salt (1+ salt)))
        (let ((expected (str "$eliscript_persistent_" salt))
              (orig-stringify (get globalThis.JSON :stringify))
              (blocked (new globalThis.Error "whole IR serialization is forbidden")))
          (try
            (put globalThis.JSON :stringify
              (lambda (value)
                (when (or (= value modules) (= value provided))
                  (throw blocked))
                (funcall orig-stringify value)))
            ;; This is the removed production operation, with the same two graph roots.
            (js-call assert :throws
              (lambda () (str (JSON/stringify modules) (JSON/stringify provided)))
              (lambda (error) (= error blocked)))
            (let ((context (js-call literal-aliases :managed_literal_context modules
                             (js-object :literalModules provided))))
              (js-call assert :equal (get context :alias) expected)
              (js-call assert :equal (get context :prefix) (str expected "/"))
              (js-call assert :equal (aref (get context :modules) 0) (aref provided 0))
              (js-call assert :equal (get context :adapter) (str expected "/stdlib/managed-literals.mjs")))
            (let ((found (new globalThis.Set))
                  (index 0))
              (js-call literal-aliases :managed_literal_json_aliases (js-array modules provided) found)
              (while (<= index 130)
                (let ((candidate (str "$eliscript_persistent_" index)))
                  (js-call assert :equal
                    (js-call found :has candidate)
                    (js-call text :includes candidate)
                    (globalThis.String index)))
                (setq index (1+ index))))
            ;; Twenty-eight shared binary edges represent over 268 million JSON paths,
            ;; but only 29 plain records; no expanded character image is necessary.
            (let ((dag (js-object :source "$eliscript_persistent_77"))
                  (depth 0))
              (while (< depth 28)
                (setq dag (js-object :left dag :right dag))
                (setq depth (1+ depth)))
              (put globalThis.JSON :stringify (lambda () (throw blocked)))
              (let ((dag-aliases (new globalThis.Set)))
                (js-call literal-aliases :managed_literal_json_aliases dag dag-aliases)
                (js-call assert :deepEqual
                  (js-call (globalThis.Array.from dag-aliases) :sort)
                  (js-array "$eliscript_persistent_7" "$eliscript_persistent_77"))))
            (finally (put globalThis.JSON :stringify orig-stringify)))
          (js-call assert :equal (str (JSON/stringify modules) (JSON/stringify provided)) text
            "source graphs remain unchanged"))))
    5000)

  (test "persistent literal alias compatibility preserves original JSON getters toJSON omissions cycles and validation first errors"
    (lambda ()
      (let* ((program (js-call (get backend :compiler) :compile_ir_string
                        "(defun run () :key) (export run)" "alias-errors.eli"))
             (adapter (js-call (get backend :compiler) :compile_ir_string
                        "(defun literal-kind (value) value) (export literal-kind)" "adapter.eli"))
             (modules (js-array (js-object :id "entry.mjs" :program program)))
             (trace (js-array))
             (shared (Object/defineProperty (js-object) "source"
                       (js-object :enumerable t :configurable t
                                  :get (lambda ()
                                         (js-call trace :push "shared")
                                         (str "$eliscript_persistent_" (get trace :length))))))
             (provided (js-array
                         (js-object
                           :id "stdlib/managed-literals.mjs"
                           :program adapter
                           :first shared
                           :second shared
                           :toJSON (funcall receiver-fn
                                     (lambda (self args)
                                       (let ((key (aref args 0))
                                             (out (js-object :first (get self :first)
                                                             :second (get self :second))))
                                         (js-call trace :push (str "toJSON:" key))
                                         (put out "$eliscript_persistent_8" undefined)
                                         (put out "$eliscript_persistent_9" (lambda () 0))
                                         (put out "$eliscript_persistent_6" (globalThis.Symbol "omitted"))
                                         out))))))
             (text (JSON/stringify provided))
             (expected-trace (globalThis.Array.from trace)))
        (put trace :length 0)
        (let ((found (new globalThis.Set))
              (index 0))
          (js-call literal-aliases :managed_literal_json_aliases provided found)
          (js-call assert :deepEqual trace expected-trace)
          (while (< index 10)
            (let ((candidate (str "$eliscript_persistent_" index)))
              (js-call assert :equal
                (js-call found :has candidate)
                (js-call text :includes candidate)
                (globalThis.String index)))
            (setq index (1+ index))))
        (let ((context (js-call literal-aliases :managed_literal_context modules
                         (js-object :literalModules provided))))
          (js-call assert :equal (get context :alias) "$eliscript_persistent_0"))
        (let* ((first-err (new globalThis.Error "module getter first"))
               (later-err (new globalThis.Error "provided getter later"))
               (bad-mod-entry (Object/defineProperty
                                (js-object :id "entry.mjs" :program program)
                                "source"
                                (js-object :enumerable t :configurable t
                                           :get (lambda ()
                                                  (js-call trace :push "module")
                                                  (throw first-err)))))
               (bad-prov-entry (Object/defineProperty
                                 (js-object :id 0 :program adapter)
                                 "source"
                                 (js-object :enumerable t :configurable t
                                            :get (lambda ()
                                                   (js-call trace :push "provided")
                                                   (throw later-err)))))
               (bad-modules (js-array bad-mod-entry))
               (bad-provided (js-array bad-prov-entry)))
          (put trace :length 0)
          (js-call assert :throws
            (lambda ()
              (js-call literal-aliases :managed_literal_context bad-modules
                (js-object :literalModules bad-provided)))
            (lambda (error) (= error first-err)))
          (js-call assert :deepEqual trace (js-array "module"))
          (put trace :length 0)
          (js-call assert :throws
            (lambda ()
              (js-call literal-aliases :managed_literal_context modules
                (js-object :literalModules bad-provided)))
            (lambda (error) (= error later-err)))
          (js-call assert :deepEqual trace (js-array "provided")
            "serialization errors still precede invalid provided-record validation"))
        (let ((cyclic (js-object)))
          (put cyclic :self cyclic)
          (js-call assert :throws
            (lambda () (js-call literal-aliases :managed_literal_json_aliases cyclic (new globalThis.Set)))
            globalThis.TypeError))
        (js-call assert :throws
          (lambda ()
            (js-call literal-aliases :managed_literal_json_aliases
              (js-object :value (globalThis.BigInt 1))
              (new globalThis.Set)))
          globalThis.TypeError)
        (let ((omitted (new globalThis.Set))
              (omitted-obj (js-object)))
          (put omitted-obj "$eliscript_persistent_0" undefined)
          (js-call literal-aliases :managed_literal_json_aliases omitted-obj omitted)
          (js-call assert :equal (get omitted :size) 0))))
    5000)

  (test "private guard states share only the pure predicate and zero while changed IEEE indices rebuild independent guards"
    (lambda ()
      (let* ((make-word (lambda (kind value &rest __host_default_arguments_2)
    (let* ((children (aref __host_default_arguments_2 0)))
                          (js-object :kind kind :type "u32"
                                     :children (if (undefined? children) (js-array) children)
                                     :value value))))
             (nan-val (get globalThis.Number :NaN))
             (inf-val (get globalThis.Number :POSITIVE_INFINITY))
             (ninf-val (get globalThis.Number :NEGATIVE_INFINITY))
             (indices (js-array 0 -0.0 1 nan-val nan-val inf-val ninf-val 4294967295 0))
             (samples (js-array 0 -0.0 nan-val inf-val ninf-val))
             (state (js-object :error (js-object :index 0) :locals (js-array) :roots 0))
             (previous undefined)
             (index 0))
        (while (< index (get indices :length))
          (let ((error-index (aref indices index)))
            (put (get state :error) :index error-index)
            (let* ((expression (funcall make-word "literal" (aref samples (% index 5))))
                   (guard (js-call guards :managed_guard state expression))
                   (reference (js-call guards :managed_guard_reference state expression)))
              (js-call assert :deepEqual guard reference)
              (js-call assert :equal (JSON/stringify guard) (JSON/stringify reference))
              (js-call assert :equal (aref (get guard :children) 1) expression)
              (funcall assert
                (Object/is (get (aref (get (aref (get guard :children) 0) :children) 0) :value) error-index))
              (js-call assert :equal
                (aref (get (aref (get guard :children) 0) :children) 1)
                (aref (get guard :children) 2))
              (let* ((next-expression (funcall make-word "set" 7 (js-array (funcall make-word "literal" index))))
                     (next (js-call guards :managed_guard state next-expression)))
                (js-call assert :notEqual next guard)
                (js-call assert :notEqual (get next :children) (get guard :children))
                (js-call assert :equal (aref (get next :children) 1) next-expression)
                (js-call assert :equal (aref (get next :children) 0) (aref (get guard :children) 0))
                (js-call assert :equal (aref (get next :children) 2) (aref (get guard :children) 2)))
              (when (not (undefined? previous))
                (let ((prev-guard (get previous :guard))
                      (prev-idx (get previous :index)))
                  (if (Object/is prev-idx error-index)
                    (js-call assert :equal (aref (get guard :children) 0) (aref (get prev-guard :children) 0))
                    (progn
                      (js-call assert :notEqual (aref (get guard :children) 0) (aref (get prev-guard :children) 0))
                      (js-call assert :notEqual (aref (get guard :children) 2) (aref (get prev-guard :children) 2))))
                  (funcall assert
                    (Object/is (get (aref (get (aref (get prev-guard :children) 0) :children) 0) :value) prev-idx)
                    "later index changes must not rewrite earlier guards")))
              (let* ((other-state (js-object :error (js-object :index error-index) :locals (js-array) :roots 0))
                     (other (js-call guards :managed_guard other-state expression)))
                (js-call assert :deepEqual other reference)
                (js-call assert :notEqual (aref (get other :children) 0) (aref (get guard :children) 0))
                (js-call assert :notEqual (aref (get other :children) 2) (aref (get guard :children) 2)))
              (let* ((copied-state (Object/assign (js-object) state
                                     (js-object :error (js-object :index error-index))))
                     (copied (js-call guards :managed_guard copied-state expression)))
                (js-call assert :deepEqual copied reference)
                (js-call assert :notEqual (aref (get copied :children) 0) (aref (get guard :children) 0))
                (js-call assert :notEqual (aref (get copied :children) 2) (aref (get guard :children) 2)))
              (setq previous (js-object :index error-index :guard guard))))
          (setq index (1+ index))))))

  (test "binding finalization is idempotent on shared guard leaves and changes only the guarded binding expression"
    (lambda ()
      (let* ((state (js-object :error (js-object :index 0) :locals (js-array) :roots 0))
             (entry (js-object :index 9 :captured false))
             (binding (js-object :kind "binding-get" :type "u32" :children (js-array) :value nil :binding entry))
             (first (js-call guards :managed_guard state binding))
             (second (js-call guards :managed_guard state
                       (js-object :kind "literal" :type "u32" :children (js-array) :value 7)))
             (condition (aref (get first :children) 0))
             (zero (aref (get first :children) 2))
             (before (globalThis.structuredClone condition))
             (iteration 0))
        (while (< iteration 3)
          (js-call assert :equal (js-call guards :finish_managed_bindings first state) first)
          (js-call assert :equal (js-call guards :finish_managed_bindings second state) second)
          (js-call assert :equal (aref (get first :children) 0) condition)
          (js-call assert :equal (aref (get second :children) 0) condition)
          (js-call assert :equal (aref (get first :children) 2) zero)
          (js-call assert :equal (aref (get second :children) 2) zero)
          (js-call assert :deepEqual condition before)
          (js-call assert :deepEqual (aref (get first :children) 1)
            (js-object :kind "local" :type "u32" :children (js-array) :value 9))
          (setq iteration (1+ iteration)))
        (js-call assert :equal (get (get state :locals) :length) 0)
        (js-call assert :equal (get state :roots) 0)
        (js-call assert :deepEqual
          (js-call (Object/keys condition) :sort)
          (js-call (Object/keys before) :sort)))))

  (test "shared guard predicates emit identical ordinary and debug bytes and reload changing errors before effects and traps"
    (lambda ()
      (let* ((w (lambda (kind value &rest __host_default_arguments_3)
    (let* ((children (aref __host_default_arguments_3 0)) (extra (aref __host_default_arguments_3 1)))
                  (Object/assign
                    (js-object :kind kind :type "u32"
                               :children (if (undefined? children) (js-array) children)
                               :value value)
                    (if (undefined? extra) (js-object) extra)))))
             (lit (lambda (value) (funcall w "literal" value)))
             (loc (lambda (index) (funcall w "local" index)))
             (wset (lambda (index value) (funcall w "set" index (js-array value))))
             (span (js-object :filename "guard-中😀.eli" :start 2 :end 9 :line 1 :column 3 :endLine 1 :endColumn 10))
             (make-program
               (lambda (guard-fn)
                 (let* ((state (js-object :error (js-object :index 0)))
                        (trap-state (js-object :error (js-object :index 0)))
                        (first (funcall guard-fn state (funcall wset 1 (funcall lit 7))))
                        (second (funcall guard-fn state (funcall wset 1 (funcall lit 99))))
                        (third (funcall guard-fn state
                                 (funcall wset 1 (funcall w "word-arithmetic" "+"
                                                   (js-array (funcall loc 1) (funcall lit 5))))))
                        (trap (funcall guard-fn trap-state
                                (funcall w "memory-op" "load-u32" (js-array (funcall lit 65536))
                                  (js-object :span span))))
                        (body (funcall w "sequence" nil
                                (js-array first (funcall wset 0 (funcall lit 1))
                                          second (funcall wset 0 (funcall lit 0))
                                          third (funcall loc 1)))))
                   (js-object
                     :input (js-object
                              :abi "memory-u32"
                              :filename "guard-sharing.eli"
                              :functions (js-array
                                           (js-object :name "run" :index 0 :arity 1
                                                      :locals (js-array (js-object :name "error" :type "u32" :index 0)
                                                                        (js-object :name "result" :type "u32" :index 1))
                                                      :body body)
                                           (js-object :name "trap" :index 1 :arity 1
                                                      :locals (js-array (js-object :name "error" :type "u32" :index 0))
                                                      :body trap))
                              :exports (js-array "run" "trap"))
                     :first first :second second :third third :trap trap))))
             (shared (funcall make-program (get guards :managed_guard)))
             (reference (funcall make-program (get guards :managed_guard_reference))))
        (js-call assert :equal
          (aref (get (get shared :first) :children) 0)
          (aref (get (get shared :second) :children) 0))
        (js-call assert :equal
          (aref (get (get shared :first) :children) 0)
          (aref (get (get shared :third) :children) 0))
        (js-call assert :notEqual
          (aref (get (get shared :first) :children) 0)
          (aref (get (get shared :trap) :children) 0))
        (js-call assert :deepEqual (get shared :input) (get reference :input))
        (let ((before (globalThis.structuredClone (get shared :input)))
              (options (js-object :initialPages 1 :maximumPages 1)))
          (freeze-graph (get shared :input))
          (let* ((bytes (globalThis.Uint8Array.from
                          (js-call (get backend :wasm) :emit_typed_memory_wasm (get shared :input) options)))
                 (_ (js-call assert :deepEqual bytes
                      (globalThis.Uint8Array.from
                        (js-call (get backend :wasm) :emit_typed_memory_wasm (get reference :input) options))))
                 (debug (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact (get shared :input) options))
                 (reference-debug (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact (get reference :input) options)))
            (js-call assert :deepEqual (get debug :bytes) (get reference-debug :bytes))
            (js-call assert :deepEqual (get debug :debug) (get reference-debug :debug))
            (js-call (js-array bytes (globalThis.Uint8Array.from (get debug :bytes))) :forEach
              (lambda (artifact)
                (let* ((mod (new globalThis.WebAssembly.Module artifact))
                       (_ (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports mod) (js-array)))
                       (e (get (new globalThis.WebAssembly.Instance mod) :exports)))
                  (js-call assert :equal (js-call e :run 0) 12)
                  (js-call assert :equal (js-call e :run 7) 5)
                  (js-call assert :equal (js-call e :run 0) 12)
                  (js-call assert :equal (js-call e :trap 1) 0)
                  (js-call assert :throws (lambda () (js-call e :trap 0)) globalThis.WebAssembly.RuntimeError)
                  (js-call assert :equal (js-call e :trap 1) 0))))
            (funcall assert
              (js-call (get (get debug :debug) :ranges) :some
                (lambda (range)
                  (let ((sp (get range :span)))
                    (and (= (get range :kind) "memory-op")
                         (not (nullish? sp))
                         (= (get sp :filename) (get span :filename)))))))
            (js-call assert :deepEqual (get shared :input) before)
            (js-call assert :equal
              (aref (get (get shared :first) :children) 0)
              (aref (get (get shared :third) :children) 0)))))))

