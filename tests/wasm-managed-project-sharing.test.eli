  (test "exclusive sibling storage resets initial zero while parameters shared DAG nodes metadata and original frame slots remain intact"
    (lambda ()
      (let* ((shared (typed-local 3))
             (body (typed-sequence
                     (js-array
                       (typed-sequence (js-array (typed-set 1 (typed-literal 9)) (typed-set 3 (typed-local 1))))
                       (typed-sequence (js-array (typed-set 3 (typed-add shared (typed-local 2)))
