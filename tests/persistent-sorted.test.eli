(module tests.persistent-sorted
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (import "../runtime/core/collection.mjs" :as collection)
  (import "../runtime/core/data-text.mjs" printValue)
  (import "../runtime/core/identifier.mjs" keyword)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/sorted.mjs" EMPTY_SORTED_MAP EMPTY_SORTED_SET PersistentSortedMap PersistentSortedSet
    emptySortedMapBy emptySortedSetBy isPersistentSortedCollection isPersistentSortedMap isPersistentSortedSet
    persistentSortedMap persistentSortedMapBy persistentSortedSet persistentSortedSetBy
    reverseSubsequence sortedComparator sortedSequence sortedSequenceFrom subsequence)
  (import "../runtime/testing/sorted.mjs" inspectPersistentSortedCollection resetSortedMetrics sharedPersistentSortedNodes sortedMetrics)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (defconst root (resolve (js* "import.meta.dir") ".."))
  (defconst seedCompiler (resolve root "bin/eliscript-seed"))
  (defconst portableCompiler (resolve root "bin/eliscript-portable"))
  (defconst hostFixture (resolve root "tests/fixtures/persistent-sorted-host.mjs"))
  (defconst bunPreload (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
  (defconst nodeLoader (resolve root "tests/fixtures/compiled-eli-node-loader.mjs"))
  (defconst emacs (get (get globalThis.process :env) :EMACS "emacs"))
  (defconst compilationUnits (js-array (js-array "stdlib/core/sorted.eli" "stdlib/core/sorted.eli")
    (js-array "tests/fixtures/persistent-sorted.eli" "tests/fixtures/persistent-sorted.mjs")))
  (defun numericOrder (left right) (- left right))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same-values (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (thunk expected) (js-call (expect thunk) :toThrow expected))
  (defun at-most (actual expected) (js-call (expect actual) :toBeLessThanOrEqual expected))
  (defun greater (actual expected) (js-call (expect actual) :toBeGreaterThan expected))
  (defun nextRandom (state)
    (let ((value (get state :value)))
      (setq value (bit-xor value (bit-shift-left value 13)))
      (setq value (bit-xor value (unsigned-bit-shift-right value 17)))
      (setq value (bit-xor value (bit-shift-left value 5)))
      (put state :value (uint32 value)) (get state :value)))
  (defasync runSuccessful (command extraEnvironment)
    (when (undefined? extraEnvironment) (setq extraEnvironment (js-object)))
    (let* ((child (js-call globalThis.Bun :spawn command (js-object :cwd root
                    :env (Object/assign (js-object) (get globalThis.process :env) (js-object :EMACS emacs) extraEnvironment)
                    :stdout "pipe" :stderr "pipe")))
           (parts (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref parts 0)) (stdout (aref parts 1)) (stderr (aref parts 2)))
      (unless (= exitCode 0)
        (let ((message (js-call stderr :trim)))
          (when (= (js-length message) 0) (setq message (js-call stdout :trim)))
          (throw (new globalThis.Error (if (> (js-length message) 0) message (str (aref command 0) " exited with " exitCode)))))) stdout))
  (Object/defineProperty runSuccessful "length" (js-object :value 1 :configurable t))
  (defasync compile (command source output environment)
    (when (undefined? environment) (setq environment (js-object)))
    (await (mkdir (dirname output) (js-object :recursive t)))
    (await (runSuccessful (js-array command "--source-map" "--output" output source) environment)) undefined)
  (Object/defineProperty compile "length" (js-object :value 3 :configurable t))
  (defasync compileFamily (command outputRoot environment)
    (when (undefined? environment) (setq environment (js-object)))
    (await (mkdir outputRoot (js-object :recursive t)))
    (await (symlink (resolve root "runtime") (resolve outputRoot "runtime") "dir"))
    (let ((index 0))
      (while (< index (js-length compilationUnits))
        (let ((unit (aref compilationUnits index)))
          (await (compile command (resolve root (aref unit 0)) (resolve outputRoot (aref unit 1)) environment)))
        (setq index (1+ index)))) undefined)
  (Object/defineProperty compileFamily "length" (js-object :value 2 :configurable t))

  (test "persistent sorted maps preserve order immutability and comparator identity" (lambda ()
    (be (js-call PersistentSortedMap :empty) EMPTY_SORTED_MAP) (be (get EMPTY_SORTED_MAP :count) 0)
    (raises (lambda () (new PersistentSortedMap)) globalThis.TypeError)
    (raises (lambda () (persistentSortedMap 1)) "persistentSortedMap expects an even number of key/value forms")
    (let* ((source (persistentSortedMap 5 "e" 1 "a" 3 "c" 2 "b" 4 "d"))
           (updated (js-call (js-call (js-call (js-call source :assoc 3 "C") :assoc 6 undefined) :assoc 7 nil) :assoc 8 false)))
      (same-values (Array/from source) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c") (js-array 4 "d") (js-array 5 "e")))
      (same-values (Array/from (js-call updated :keys)) (js-array 1 2 3 4 5 6 7 8))
      (js-call (expect (js-call updated :get 6 "missing")) :toBeUndefined)
      (js-call (expect (js-call updated :get 7 "missing")) :toBeNull)
      (be (js-call updated :get 8 "missing") false) (be (js-call updated :assoc 3 "C") updated)
      (be (js-call updated :dissoc 99) updated) (be (js-call (js-call updated :dissoc 3) :has 3) false)
      (be (js-call source :get 3) "c") (be (Object/isFrozen source) t))
    (let ((nullishSet (persistentSortedSet nil undefined)))
      (js-call (expect (js-call collection :get nullishSet nil "missing")) :toBeNull)
      (js-call (expect (js-call collection :get nullishSet undefined "missing")) :toBeUndefined))
    (let ((reverse (persistentSortedMapBy (lambda (left right) (- right left)) 1 "a" 3 "c" 2 "b")))
      (same-values (Array/from (js-call reverse :keys)) (js-array 3 2 1))
      (same-values (Array/from (js-call reverse :keys false)) (js-array 1 2 3))
      (be (get (js-call collection :empty reverse) :count) 0)
      (be (sortedComparator (js-call collection :empty reverse)) (sortedComparator reverse)))))

  (test "persistent sorted sets retain canonical comparator-equivalent values" (lambda ()
    (let* ((insensitive (lambda (left right) (js-call (js-call left :toLowerCase) :localeCompare (js-call right :toLowerCase))))
           (source (persistentSortedSetBy insensitive "Beta" "alpha" "ALPHA")))
      (be (js-call PersistentSortedSet :empty) EMPTY_SORTED_SET) (raises (lambda () (new PersistentSortedSet)) globalThis.TypeError)
      (be (get source :count) 2) (same-values (Array/from source) (js-array "alpha" "Beta"))
      (be (js-call collection :get source "ALPHA") "alpha") (be (js-call source :conj "beta") source)
      (be (js-call (js-call source :disj "BETA") :has "Beta") false)
      (same-values (Array/from (js-call collection :rseq source)) (js-array "Beta" "alpha"))
      (be (get (js-call collection :empty source) :count) 0)
      (be (sortedComparator (js-call collection :empty source)) (sortedComparator source)))))

  (test "sorted collections implement collection value metadata and text protocols" (lambda ()
    (let ((map (persistentSortedMap 2 "b" 1 "a")) (set (persistentSortedSet 2 1)))
      (be (isPersistentSortedMap map) t) (be (isPersistentSortedSet set) t) (be (isPersistentSortedCollection map) t)
      (be (js-call collection :isCollection map) t) (be (js-call collection :isCollection set) t)
      (be (js-call collection :isMap map) t) (be (js-call collection :isSet set) t) (be (js-call collection :count map) 2)
      (be (js-call collection :contains map 1) t) (be (js-call collection :get map 1) "a")
      (same-values (Array/from (js-call collection :assoc map 3 "c")) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c")))
      (same-values (Array/from (js-call collection :dissoc map 1)) (js-array (js-array 2 "b")))
      (same-values (Array/from (js-call collection :conj set 3)) (js-array 1 2 3))
      (same-values (Array/from (js-call collection :disj set 1)) (js-array 2))
      (be (js-call collection :reduceKV map (lambda (result key value) (str result key value)) "") "1a2b")
      (let* ((metadata (persistentHashMap (js-array (keyword "source") "sorted"))) (located (withMeta map metadata)))
        (be (meta located) metadata) (be (meta (js-call collection :assoc located 3 "c")) metadata)
        (be (meta (js-call collection :empty located)) metadata)
        (be (printValue located) "^{:source \"sorted\"} {1 \"a\" 2 \"b\"}") (be (printValue set) "#{1 2}")))))

  (test "hash and sorted collections share exact logical value semantics" (lambda ()
    (let ((hashMap (persistentHashMap (js-array 1 "a") (js-array 2 undefined))) (sortedMap (persistentSortedMap 2 undefined 1 "a")))
      (be (equalValues hashMap sortedMap) t) (be (equalValues sortedMap hashMap) t) (be (hashValue hashMap) (hashValue sortedMap)))
    (let ((hashSet (persistentHashSet 1 2 3)) (sortedSet (persistentSortedSet 3 1 2)))
      (be (equalValues hashSet sortedSet) t) (be (equalValues sortedSet hashSet) t) (be (hashValue hashSet) (hashValue sortedSet)))
    (let ((insensitive (js-call (emptySortedMapBy (lambda (left right)
                        (js-call (js-call left :toLowerCase) :localeCompare (js-call right :toLowerCase)))) :assoc "A" 1)))
      (be (js-call insensitive :assoc "a" 1) insensitive)
      (be (equalValues insensitive (persistentHashMap (js-array "a" 1))) false)
      (be (equalValues (persistentHashMap (js-array "a" 1)) insensitive) false))))

  (test "sorted range queries honor inclusive bounds and direction" (lambda ()
    (let ((map (persistentSortedMap 1 "a" 2 "b" 3 "c" 4 "d" 5 "e")) (set (persistentSortedSet 1 2 3 4 5)))
      (same-values (Array/from (sortedSequence map)) (Array/from map))
      (same-values (Array/from (sortedSequence map false)) (Array/from (js-call map :entries false)))
      (same-values (Array/from (sortedSequenceFrom map 3)) (js-array (js-array 3 "c") (js-array 4 "d") (js-array 5 "e")))
      (same-values (Array/from (sortedSequenceFrom map 3 t false)) (js-array (js-array 4 "d") (js-array 5 "e")))
      (same-values (Array/from (sortedSequenceFrom set 3 false)) (js-array 3 2 1))
      (same-values (Array/from (subsequence map (keyword ">=") 2 (keyword "<") 5)) (js-array (js-array 2 "b") (js-array 3 "c") (js-array 4 "d")))
      (same-values (Array/from (subsequence set ">" 2)) (js-array 3 4 5))
      (same-values (Array/from (subsequence set "<=" 3)) (js-array 1 2 3))
      (same-values (Array/from (reverseSubsequence set ">" 1 "<=" 4)) (js-array 4 3 2))
      (js-call (expect (subsequence set ">" 9)) :toBeNull)
      (raises (lambda () (subsequence set ">" 1 ">=" 2)) (new globalThis.RegExp "requires a lower" "u"))
      (raises (lambda () (subsequence set (keyword "bad") 1)) (new globalThis.RegExp "bound test" "u"))
      (raises (lambda () (sortedSequence set "yes")) (new globalThis.RegExp "boolean" "u")))))

  (test "persistent sorted trees agree with a randomized mutable model" (lambda ()
    (let ((random (js-object :value 1592594996)) (map EMPTY_SORTED_MAP) (model (new globalThis.Map)) (step 0))
      (while (< step 20000)
        (let ((key (% (nextRandom random) 4096)))
          (if (< (% (nextRandom random) 10) 7)
            (let ((value (nextRandom random))) (setq map (js-call map :assoc key value)) (js-call model :set key value))
            (progn (setq map (js-call map :dissoc key)) (js-call model :delete key)))
          (when (= (% step 251) 0)
            (let ((expected (js-call (Array/from model) :sort (lambda (left right) (- (aref left 0) (aref right 0))))))
              (same-values (Array/from map) expected)
              (at-most (get (inspectPersistentSortedCollection map) :maxBalance) 1))))
        (setq step (1+ step)))
      (same-values (Array/from map) (js-call (Array/from model) :sort (lambda (left right) (- (aref left 0) (aref right 0))))))))

  (test "persistent sorted trees keep height work and copying logarithmic" (lambda ()
    (let ((map EMPTY_SORTED_MAP) (key 0))
      (while (< key 100000) (setq map (js-call map :assoc key key) key (1+ key)))
      (let ((inspected (inspectPersistentSortedCollection map)))
        (same-values inspected (js-object :count 100000 :height (js-call expect :any globalThis.Number) :nodes 100000 :maxBalance 1))
        (at-most (get inspected :height) 24)
        (resetSortedMetrics)
        (let* ((updated (js-call map :assoc 50000 "updated")) (work (sortedMetrics)))
          (at-most (get work :comparisons) (get inspected :height)) (at-most (get work :nodeAllocations) (get inspected :height))
          (be (get work :rotations) 0) (greater (sharedPersistentSortedNodes map updated) (- 100000 (get inspected :height) 1))
          (be (js-call map :get 50000) 50000) (be (js-call updated :get 50000) "updated"))
        (resetSortedMetrics)
        (let* ((removed (js-call map :dissoc 50000)) (removalWork (sortedMetrics)))
          (at-most (get removalWork :comparisons) (get inspected :height))
          (at-most (get removalWork :nodeAllocations) (* (get inspected :height) 2))
          (at-most (get removalWork :rotations) (get inspected :height))
          (at-most (get (inspectPersistentSortedCollection removed) :maxBalance) 1)
          (greater (sharedPersistentSortedNodes map removed) (- 100000 (* (get inspected :height) 2) 1))
          (be (js-call removed :has 50000) false) (be (js-call map :has 50000) t))))))

  (test "Eliscript sorted API agrees across compilers and local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-sorted-"))))
           (bootstrapDirectory (resolve directory "bootstrap")) (seedDirectory (resolve directory "seed"))
           (selfHostedDirectory (resolve directory "self-hosted")))
      (try
        (await (compileFamily seedCompiler seedDirectory)) (await (seedCompilerFixture bootstrapDirectory))
        (await (compileFamily portableCompiler selfHostedDirectory (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))
        (let ((index 0))
          (while (< index (js-length compilationUnits))
            (let ((output (aref (aref compilationUnits index) 1)))
              (js-call (expect (await (js-call (js-call globalThis.Bun :file (resolve selfHostedDirectory output)) :text)))
                :toBe (await (js-call (js-call globalThis.Bun :file (resolve seedDirectory output)) :text)))
              (js-call (expect (await (js-call (js-call globalThis.Bun :file (resolve selfHostedDirectory (str output ".map"))) :text)))
                :toBe (await (js-call (js-call globalThis.Bun :file (resolve seedDirectory (str output ".map"))) :text))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (roots (js-array seedDirectory selfHostedDirectory)) (index 0))
          (while (< index (js-length roots))
            (let ((modulePath (resolve (aref roots index) "tests/fixtures/persistent-sorted.mjs")))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array "bun" "--preload" bunPreload hostFixture modulePath)))))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array (get (get globalThis.process :env) :NODE "node")
                "--experimental-loader" nodeLoader hostFixture modulePath))))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (same-values report (aref reports 0))))
          (same-values (get (aref reports 0) :map) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c") (js-array 4 "d")))
          (same-values (get (aref reports 0) :reverseMap) (js-array (js-array 3 "c") (js-array 2 "b") (js-array 1 "a")))
          (same-values (get (aref reports 0) :set) (js-array 1 2 3 4)) (same-values (get (aref reports 0) :reverse) (js-array 4 3 2 1))
          (same-values (get (aref reports 0) :from) (js-array (js-array 4 "d")))
          (same-values (get (aref reports 0) :subseq) (js-array (js-array 2 "b") (js-array 3 "c")))
          (same-values (get (aref reports 0) :rsubseq) (js-array 4 3 2)) (be (get (aref reports 0) :folded) "1a2b3c4d")
          (same-values (get (aref reports 0) :classification) (js-array t t t t t t))
          (same-values (get (aref reports 0) :value) (js-array t t t)) (same-values (get (aref reports 0) :empty) (js-array t t))
          (same-values (get (aref reports 0) :errors) (js-array
            "persistentSortedMap expects an even number of key/value forms"
            "two-bound subsequence requires a lower :>/:>= bound then an upper :</:<= bound"
            "sortedSequence ascending must be a boolean")))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
