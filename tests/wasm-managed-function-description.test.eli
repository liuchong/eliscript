(module tests.wasm-managed-function-description.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile realpath rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/compiler-build.mjs" decodeCompilerBinary)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  (defconst platform
    (if (and (= (get globalThis.process :arch) "arm64")
             (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform)))
      (if (= (get globalThis.process :platform) "darwin") "arm64-macos" "arm64-linux")
      nil))

  (defconst padding (js-call "description-source-\ud800-\udfff-" :repeat 256))
  (defconst source
    (str "\n (defconst marker -0)\n (defun target (x) " (JSON/stringify padding) ")\n (defun reference () target)\n (defun closure (x) (lambda (step) (+ x step)))\n (defun call (f x) (funcall f x))\n (defun text (f) (js-call (get (js* \"Function.prototype\") :toString) :call f))\n (defun native-reference () (get (js* \"Number\") :isFinite))\n (defun mutate (f mode)\n  (if mode\n   (progn (Reflect/deleteProperty f \"name\") (Reflect/deleteProperty f \"length\"))\n   (progn\n    (Object/defineProperty f \"name\" (js-object :value \"renamed\" :writable false :enumerable false :configurable t))\n    (Object/defineProperty f \"length\" (js-object :value 7 :writable false :enumerable false :configurable t))))\n  f)\n (defun change-prototype (f value) (put f :prototype value) f)\n (defun prototype-value (f) (get f :prototype))\n (defun snapshot (f)\n  (JSON/stringify (js-array (get f :name) (get f :length)\n   (Object/hasOwn f \"name\") (Object/hasOwn f \"length\") (Object/hasOwn f \"prototype\")\n   (Object/getOwnPropertyNames f))))\n (export reference closure call text native-reference mutate change-prototype prototype-value snapshot)"))

  (defvar directory undefined)
  (defvar bytes undefined)
  (defvar wasm-module undefined)
  (defvar native undefined)
  (defvar oracle undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-function-description-"))))
    (let* ((b (await (buildBackends (js-object :outputRoot directory))))
           (runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
           (program (js-call (get b :compiler) :compile_ir_string source "description.eli"))
           (lowered (js-call (get b :managed) :lower_managed_program program runtime)))
      ;; The raw state-query regression uses this same compiled runtime image.
      ;; These extra exports belong only to the fixture, not the production ABI.
      (js-call
        (js-array "heap-new" "heap-pin" "heap-release" "heap-collect" "heap-used" "heap-live"
                  "heap-auto" "heap-collections" "value-function-new" "value-function-describe"
                  "value-function-description-state" "value-function-source-text" "value-string" "value-unit-set"
                  "value-seal" "value-number" "frame-new" "frame-set" "frame-pop" "frame-get" "frame-depth" "last-error")
        :forEach
        (lambda (name)
          (unless (js-call (get (get lowered :typed) :exports) :includes name)
            (js-call (get (get lowered :typed) :exports) :push name))))
      (let ((output (js-call (get b :wasm) :emit_typed_memory_wasm (get lowered :typed) (js-object :initialPages 1 :maximumPages 32))))
        (setq bytes
          (Uint8Array/from
            (js-call (get b :wasm) :append_metadata_section output "eliscript-managed-control"
              (JSON/stringify (get lowered :descriptor)))))
        (setq wasm-module (new globalThis.WebAssembly.Module bytes))
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports wasm-module) (js-array))
        ;; Bun's .mjs loader reprints string escapes in Function#toString. The
        ;; independent Node oracle loads these exact emitted bytes without rewriting
        ;; their source spelling; every source assertion below remains exact.
        (let* ((javascript (js-call (get b :compiler) :emit_ir_string program))
               (referenceFile (resolve (await (realpath directory)) "description-reference.mjs")))
          (await (writeFile referenceFile javascript))
          (let ((child (spawnSync "node"
                         (js-array (resolve "tests/helpers/wasm-managed-function-description-node.mjs")
                                   (get (pathToFileURL referenceFile) :href))
                         (js-object :encoding "utf8" :timeout 30000 :maxBuffer (* 4 1024 1024)))))
            (js-call assert :equal (get child :error) undefined)
            (js-call assert :equal (get child :signal) nil)
            (js-call assert :equal (get child :status) 0 (or (get child :stderr) (get child :stdout)))
            (setq oracle (JSON/parse (get child :stdout)))))
        (when platform
          (let ((path (resolve directory (str "description." (if (= platform "arm64-macos") "dylib" "so")))))
            (await (writeFile path
                     (decodeCompilerBinary
                       (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) platform
                         (js-object :binaryEncoding "u16le-chunks")))))
            (setq native (js-object :path path :descriptor (js-object :typed (get lowered :typed) :descriptor (get lowered :descriptor)))))))))
    120000)

  (afterAll (async ()
    (setq wasm-module undefined)
    (setq native undefined)
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defconst options (js-object :maxSlots 256 :initialBytes 8192 :maxBytes 65536 :maximumPages 32 :initializeModule false))

  (defasync open (nativeHost &rest __host_default_arguments_1)
    (let* ((extra-opts (aref __host_default_arguments_1 0)))
    (let* ((extra (if (undefined? extra-opts) (js-object) extra-opts))
           (a (if nativeHost
                (await (instantiateNativeManagedRuntime (get native :path) (get native :descriptor)
                         (Object/assign (js-object) options extra (js-object :nativeTarget platform))))
                (instantiateManagedRuntime bytes (Object/assign (js-object) options extra)))))
      (js-call a :auto 1)
      (js-call a :initializeModule)
      a)))

  (defun finish (a values)
    (js-call values :forEach (lambda (value) (js-call a :release value)))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
    (when (= (value-type (get a :close)) "function")
      (js-call a :close)))

  (defasync pressure (nativeHost)
    (let* ((a (await (open nativeHost)))
           (f (js-call a :invoke "reference"))
           (held (js-call a :number -0.0))
           (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 held)
      (js-call a :collect)
      (let* ((room 4096)
             (count (* (Math/floor (/ (- (get options :maxBytes) (get (js-call a :stats) :usedBytes) room 32) 8)) 8)))
        (assert (> count 0))
        (let ((filler (js-call a :bytes (new globalThis.Uint8Array count))))
          (try
            (let ((before (js-call a :stats)))
              (assert (<= (- (get options :maxBytes) (get before :usedBytes)) (+ room 8))))
            (let ((index 0))
              (while (< index 128)
                (let ((again (js-call a :invoke "reference")))
                  (assert (js-call a :keyEqual again f))
                  (js-call a :release again)
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                  (assert (Object/is (js-call a :readNumber held) -0.0)))
                (setq index (1+ index))))
            (js-call assert :equal (get (js-call a :stats) :capacityBytes) (get options :maxBytes))
            (js-call assert :throws
              (lambda () (js-call a :string (js-call padding :repeat 16)))
              (lambda (error) (and (get error :eliscriptDiagnostic) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002"))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (assert (Object/is (js-call a :readNumber held) -0.0))
            (let ((recovered (js-call a :invoke "reference")))
              (assert (js-call a :keyEqual recovered f))
              (js-call a :release recovered))
            (finally
              (js-call a :leaveFrame frame)
              (finish a (js-array filler f held))))))))

  (test "WASM repeated described function references fit the original small heap with a live caller root and strict capacity recovery"
    (lambda () (pressure false)))

  (funcall (js-call test :skipIf (not platform))
    "native repeated described function references retain identity under identical collecting capacity pressure"
    (lambda () (pressure t)))

  (defasync reflection (nativeHost)
    (let* ((a (await (open nativeHost (js-object :maxSlots 1024 :initialBytes 32768 :maxBytes 262144))))
           (f (js-call a :invoke "reference"))
           (roots (js-array f))
           (text (js-call a :invoke "text" (js-array f))))
      (js-call roots :push text)
      (js-call assert :equal (js-call a :readString text) (get oracle :text))
      (js-call (js-array false t) :forEach
        (lambda (mode)
          (let ((changed (js-call a :invoke "mutate" (js-array f mode))))
            (js-call a :release changed))
          (let ((repeat 0))
            (while (< repeat 4)
              (let* ((again (js-call a :invoke "reference"))
                     (_ (assert (js-call a :keyEqual again f)))
                     (expected (aref (aref (get oracle :mutations) (if mode 1 0)) repeat))
                     (shape (js-call a :invoke "snapshot" (js-array again))))
                (js-call assert :equal (js-call a :readString shape) (get expected :snapshot))
                (js-call a :release shape)
                (let ((sourceText (js-call a :invoke "text" (js-array again))))
                  (js-call assert :equal (js-call a :readString sourceText) (get expected :text))
                  (assert (js-call a :keyEqual sourceText text))
                  (js-call a :release sourceText)
                  (js-call a :release again)
                  (js-call a :collect)))
              (setq repeat (1+ repeat))))))
      (let ((prototype (js-call a :sourceObject (js-object))))
        (js-call roots :push prototype)
        (let ((changed (js-call a :invoke "change-prototype" (js-array f prototype))))
          (js-call a :release changed))
        (let* ((again (js-call a :invoke "reference"))
               (actualPrototype (js-call a :invoke "prototype-value" (js-array again))))
          (js-call assert :equal (js-call a :keyEqual actualPrototype prototype) (get oracle :prototypeIdentity))
          (js-call a :release actualPrototype)
          (js-call a :release again)))
      (let* ((one (js-call a :number 1))
             (two (js-call a :number 2))
             (step (js-call a :number 4))
             (_ (js-call roots :push one two step))
             (first (js-call a :invoke "closure" (js-array one)))
             (second (js-call a :invoke "closure" (js-array two))))
        (js-call roots :push first second)
        (assert (not (js-call a :keyEqual first second)))
        (js-call (js-array (js-array first 5) (js-array second 6)) :forEach
          (lambda (pair)
            (let* ((closure (aref pair 0))
                   (expected (aref pair 1))
                   (result (js-call a :invoke "call" (js-array closure step))))
              (js-call assert :equal (js-call a :readNumber result) expected)
              (js-call assert :equal (js-call a :readNumber result) (get (aref (get oracle :closures) (- expected 5)) :value))
              (js-call a :release result)
              (let ((original (js-call a :invoke "text" (js-array closure))))
                (js-call assert :equal (js-call a :readString original) (get (aref (get oracle :closures) (- expected 5)) :text))
                (js-call a :release original))))))
      ;; Native names use the existing lazy native-source flag, never a false
      ;; "source installed" marker. Public name deletion must survive rereads.
      (let* ((builtin (js-call a :invoke "native-reference"))
             (_ (js-call roots :push builtin))
             (nativeText (js-call a :invoke "text" (js-array builtin))))
        (js-call roots :push nativeText)
        (js-call assert :equal (js-call a :readString nativeText) (get (get oracle :native) :text))
        (let ((mutated (js-call a :invoke "mutate" (js-array builtin t))))
          (js-call a :release mutated))
        (let ((repeated (js-call a :invoke "native-reference")))
          (assert (js-call a :keyEqual repeated builtin))
          (let ((names (js-call a :invoke "snapshot" (js-array repeated))))
            (js-call assert :equal (js-call a :readString names) (get (get oracle :native) :snapshot))
            (js-call a :release names)
            (js-call a :release repeated)))
        (let ((after (js-call a :invoke "text" (js-array builtin))))
          (js-call assert :equal (js-call a :readString after) (js-call a :readString nativeText))
          (js-call assert :equal (js-call a :readString after) (get (get oracle :native) :after))
          (js-call a :release after)
          (finish a roots)))))

  (test "WASM description guards preserve name length prototype mutation exact source native metadata and closure isolation"
    (lambda () (reflection false)))

  (funcall (js-call test :skipIf (not platform))
    "native description guards preserve the same public reflection source and independent captured functions"
    (lambda () (reflection t)))

  (test "validated description queries allocate nothing and distinguish completed info from failed or uninstalled source" (lambda ()
    (let* ((exports (get (new globalThis.WebAssembly.Instance wasm-module) :exports))
           (r (Object/fromEntries
                (js-call (Object/entries exports) :map
                  (lambda (entry)
                    (let ((name (aref entry 0))
                          (value (aref entry 1)))
                      (js-array (js-call name :replaceAll "-" "_")
                                (if (= (value-type value) "function")
                                  (lambda (&rest args) (uint32 (Reflect/apply value exports args)))
                                  value)))))))
           (heap (js-call r :heap_new 64 8192 65536))
           (f (js-call r :value_function_new heap 0 0)))
      (assert (> f 3))
      (js-call r :heap_pin heap f)
      (let ((query (lambda (mode) (js-call r :value_function_description_state heap f mode)))
            (make-string (lambda (text)
                           (let ((value (js-call r :value_string heap (js-length text)))
                                 (index 0))
                             (assert (> value 3))
                             (js-call r :heap_pin heap value)
                             (while (< index (js-length text))
                               (js-call assert :equal (js-call r :value_unit_set heap value index (js-call text :charCodeAt index)) 1)
                               (setq index (1+ index)))
                             (js-call assert :equal (js-call r :value_seal heap value) value)
                             value))))
        (js-call assert :equal (funcall query 0) 0)
        (js-call assert :equal (funcall query 1) 0)
        (let ((name (funcall make-string "named")))
          (js-call assert :equal (js-call r :value_function_describe heap f name 1 0 0 1) f)
          (js-call assert :equal (funcall query 0) 1)
          (js-call assert :equal (funcall query 1) 0)
          (js-call assert :equal (js-call r :value_string heap 65536) 0)
          (js-call assert :equal (js-call r :last_error) 2)
          (js-call assert :equal (funcall query 0) 1)
          (js-call assert :equal (funcall query 1) 0 "description success is not source success")
          (let ((text (js-call r :value_string heap 3)))
            (assert (> text 3))
            (js-call r :heap_pin heap text)
            (js-call assert :equal (js-call r :value_function_source_text heap f text) 0)
            (js-call assert :equal (js-call r :last_error) 6)
            (js-call assert :equal (funcall query 1) 0)
            (js-call r :value_unit_set heap text 0 55296)
            (js-call r :value_unit_set heap text 1 65)
            (js-call r :value_unit_set heap text 2 57343)
            (js-call r :value_seal heap text)
            (js-call assert :equal (js-call r :value_function_source_text heap f text) f)
            (js-call assert :equal (funcall query 1) 1)
            (js-call r :heap_auto heap 1)
            (let ((before (js-array (js-call r :heap_used heap) (js-call r :heap_live heap)
                                    (js-call r :heap_collections heap) (js-call r :frame_depth heap)))
                  (index 0))
              (while (< index 1024)
                (js-call assert :equal (funcall query 0) 1)
                (js-call assert :equal (funcall query 1) 1)
                (setq index (1+ index)))
              (js-call assert :deepEqual
                (js-array (js-call r :heap_used heap) (js-call r :heap_live heap)
                          (js-call r :heap_collections heap) (js-call r :frame_depth heap))
                before))
            (js-call assert :equal (funcall query 2) 0)
            (js-call assert :equal (js-call r :last_error) 3)
            (js-call assert :equal (js-call r :value_function_description_state 0 f 0) 0)
            (js-call assert :equal (js-call r :last_error) 1)
            (let ((wrong (js-call r :value_number heap 0 2147483648)))
              (assert (> wrong 3))
              (js-call r :heap_pin heap wrong)
              (js-call assert :equal (js-call r :value_function_description_state heap wrong 0) 0)
              (js-call assert :equal (js-call r :last_error) 1)
              (js-call (js-array f name text wrong) :forEach (lambda (value) (js-call r :heap_release heap value)))
              (js-call r :heap_collect heap)
              (js-call assert :equal (js-call r :value_function_description_state heap f 0) 0)
              (js-call assert :equal (js-call r :last_error) 1)
              (js-call assert :equal (js-call r :frame_depth heap) 0)
              (js-call assert :equal (js-call r :heap_live heap) 0)))))))))
