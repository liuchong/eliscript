(module
  tests.dogfood-events.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" cp mkdtemp readFile rm stat writeFile)
  (import "node:path" join resolve)
  (import "../runtime/core/collection.mjs" :as collection-mod)
  (import "../runtime/literals.mjs" hashMap keyword)
  (defun
    fieldOf
    (value name &rest __host_default_arguments_1)
    (let* ((fallback (aref __host_default_arguments_1 0)))
    (js-call collection-mod :get value (keyword name) (if
        (= fallback undefined)
        nil
        fallback))))
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    DEMO
    (resolve ROOT "examples/dogfood/_demo"))
  (defconst
    state
    (js-object :staging nil :program nil :project nil :bundle nil :events nil))
  (defasync
    run
    (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let*
      ((opts (js-call globalThis.Object :assign (js-object :cwd ROOT :stdout "pipe" :stderr "pipe") (or options (js-object)))) (child (js-call globalThis.Bun :spawn command opts)) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2)))))
  (defasync
    react
    (eventName payload &rest __host_forwarded_arguments_2)
    (let* ((extra (aref __host_forwarded_arguments_2 0)))
    (let*
      ((ext (or extra (js-array))) (staging (get state :staging)) (eventFile (join staging (str "event-" eventName ".json"))) (outputFile (join staging (str "outputs-" eventName "-" (get ext :length) ".txt"))) (__ign_3 (await (writeFile eventFile (js-call globalThis.JSON :stringify payload) "utf8"))) (__ign_4 (await (writeFile outputFile "" "utf8"))) (cmd (js-call (js-array (get globalThis.process :execPath) (get state :program) "--root" (get state :project) "--output" "site" "--browser-bundle" (get state :bundle) "--event-file" eventFile) :concat ext)) (result (await (run cmd (js-object :env (js-call globalThis.Object :assign (js-object) (get globalThis.process :env) (js-object :GITHUB_EVENT_NAME eventName :GITHUB_OUTPUT outputFile :INPUT_PREVIEW (if
                      (js-call ext :includes "--preview")
                      "true"
                      ""))))))) (outputs (await (readFile outputFile "utf8"))))
      (js-call globalThis.Object :assign (js-object) result (js-object :outputs outputs)))))
  (defasync
    exists
    (path)
    (try
      (progn
        (await (stat path))
        t)
      (catch
        _
        false)))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-events-")))) (project (join staging "project")) (__ign_5 (put state :staging staging)) (__ign_6 (put state :project project)) (__ign_7 (await (cp DEMO project (js-object :recursive t)))) (built (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (join staging "build") "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get built :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get built :stderr) :trim) (js-call (get built :stdout) :trim)))))
        (put state :program (join staging "build/src/builder/main.mjs"))
        (put state :events (await (funcall (js* "(u) => import(u)") (join staging "build/src/builder/events.mjs"))))
        (let*
          ((browserSource (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (join staging "browser-source") "examples/dogfood/src/renderer/browser.eli")))))
          (when
            (not= (get browserSource :exitCode) 0)
            (throw (new globalThis.Error (or (js-call (get browserSource :stderr) :trim) (js-call (get browserSource :stdout) :trim)))))
          (let*
            ((bundled (await (run (js-array "bun" "build" (join staging "browser-source/src/renderer/browser.mjs") "--target=browser" "--format=iife" "--outfile" (join staging "browser.js"))))))
            (when
              (not= (get bundled :exitCode) 0)
              (throw (new globalThis.Error (or (js-call (get bundled :stderr) :trim) (js-call (get bundled :stdout) :trim)))))
            (put state :bundle (join staging "browser.js")))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "events are classified by their subject" (lambda () (let*
        ((events (get state :events)) (article-names (js-array "push" "schedule" "workflow_dispatch" "issues" "release")) (aidx (js-object :i 0)))
        (while
          (< (get aidx :i) (get article-names :length))
          (let*
            ((name (aref article-names (get aidx :i))))
            (js-call (expect (fieldOf (js-call events :classify_event name (js-object :action "opened")) "subject")) :toEqual (keyword "articles")))
          (put aidx :i (+ (get aidx :i) 1)))
        (let*
          ((comment-names (js-array "issue_comment" "discussion_comment" "discussions")) (cidx (js-object :j 0)))
          (while
            (< (get cidx :j) (get comment-names :length))
            (let*
              ((name (aref comment-names (get cidx :j))))
              (js-call (expect (fieldOf (js-call events :classify_event name (js-object :action "created")) "subject")) :toEqual (keyword "comments")))
            (put cidx :j (+ (get cidx :j) 1))))
        (js-call (expect (fieldOf (js-call events :classify_event "star" (js-object)) "subject")) :toEqual (keyword "unknown"))
        (js-call (expect (fieldOf (js-call events :classify_event "star" (js-object)) "action" "")) :toBe ""))))
  (test "the article policy decides which events rebuild the site" (lambda () (let*
        ((events (get state :events)) (builds (lambda (policy event) (js-call events :article_builds_QMARK_ (keyword policy) event))))
        (js-call (expect (builds "push" "push")) :toBe t)
        (js-call (expect (builds "push" "schedule")) :toBe false)
        (js-call (expect (builds "push" "issues")) :toBe false)
        (js-call (expect (builds "event" "issues")) :toBe t)
        (js-call (expect (builds "event" "push")) :toBe false)
        (js-call (expect (builds "scheduled" "schedule")) :toBe t)
        (js-call (expect (builds "scheduled" "push")) :toBe false)
        (js-call (expect (builds "manual" "push")) :toBe false)
        (js-call (expect (builds "manual" "schedule")) :toBe false)
        (let*
          ((hybrid-events (js-array "push" "issues" "release" "schedule")) (hidx (js-object :i 0)))
          (while
            (< (get hidx :i) (get hybrid-events :length))
            (js-call (expect (builds "hybrid" (aref hybrid-events (get hidx :i)))) :toBe t)
            (put hidx :i (+ (get hidx :i) 1))))
        (let*
          ((policies (js-array "push" "event" "scheduled" "manual" "hybrid")) (pidx (js-object :j 0)))
          (while
            (< (get pidx :j) (get policies :length))
            (js-call (expect (builds (aref policies (get pidx :j)) "workflow_dispatch")) :toBe t)
            (put pidx :j (+ (get pidx :j) 1)))))))
  (test "the policy decides a real classification, not just the helper" (lambda () (let*
        ((events (get state :events)) (decide (lambda (policy eventName) (let*
                ((config (hashMap (keyword "refresh") (hashMap (keyword "articles") (keyword policy)))))
                (fieldOf (js-call events :build_decision config (js-call events :classify_event eventName (js-object)) false) "build" nil)))))
        (js-call (expect (decide "push" "push")) :toBe t)
        (js-call (expect (decide "push" "schedule")) :toBe false)
        (js-call (expect (decide "scheduled" "schedule")) :toBe t)
        (js-call (expect (decide "manual" "push")) :toBe false)
        (js-call (expect (decide "hybrid" "release")) :toBe t))))
  (test "only the opt-in comment policy builds on a comment event" (lambda () (let*
        ((events (get state :events)) (decide (lambda (policy) (let*
                ((config (hashMap (keyword "refresh") (hashMap (keyword "comments") (keyword policy)))))
                (fieldOf (js-call events :build_decision config (js-call events :classify_event "issue_comment" (js-object)) false) "build" nil)))) (non-build (js-array "runtime" "external" "scheduled" "manual" "hybrid")) (idx (js-object :i 0)))
        (while
          (< (get idx :i) (get non-build :length))
          (js-call (expect (decide (aref non-build (get idx :i)))) :toBe false)
          (put idx :i (+ (get idx :i) 1)))
        (js-call (expect (decide "event")) :toBe t))))
  (test "a comment subject defers for both runtime and snapshot channels" (lambda () (let*
        ((events (get state :events)) (classified (lambda (subject &rest __host_forwarded_arguments_3)
    (let* ((eventName (aref __host_forwarded_arguments_3 0))) (hashMap (keyword "subject") (keyword subject) (keyword "event") (or eventName "push"))))) (comments (classified "comments")) (runtime (js-call events :build_decision (js-object :refresh (js-object)) comments false)) (snapshot (js-call events :build_decision (js-object :refresh (js-object :comments "snapshot")) comments false)))
        (js-call (expect (fieldOf runtime "build" nil)) :toBe false)
        (js-call (expect (fieldOf runtime "reason")) :toBe "deferred")
        (js-call (expect (fieldOf snapshot "build" nil)) :toBe false)
        (js-call (expect (fieldOf snapshot "reason")) :toBe "deferred")
        (js-call (expect (fieldOf (js-call events :build_decision (js-object :refresh (js-object)) comments t) "reason")) :toBe "forced")
        (js-call (expect (fieldOf (js-call events :build_decision (js-object :refresh (js-object)) (classified "articles") false) "build" nil)) :toBe t)
        (js-call (expect (fieldOf (js-call events :classify_event "workflow_dispatch" (js-object)) "subject")) :toEqual (keyword "articles")))))
  (test "a comment event defers instead of building" (async () (let*
        ((result (await (react "issue_comment" (js-object :action "created")))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (js-call (expect (get result :outputs)) :toContain "built=false")
        (js-call (expect (get result :outputs)) :toContain "reason=deferred")
        (js-call (expect (get result :outputs)) :toContain "subject=comments")
        (js-call (expect (await (exists (join (get state :project) "site")))) :toBe false))))
  (test "a push builds and reports the fingerprint as its cache key" (async () (let*
        ((result (await (react "push" (js-object :ref "refs/heads/master")))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (js-call (expect (get result :outputs)) :toContain "built=true")
        (js-call (expect (get result :outputs)) :toContain "reason=changed")
        (js-call (expect (get result :outputs)) :toMatch (new globalThis.RegExp "cache-key=dogfood-[0-9a-f]{64}" "u"))
        (js-call (expect (await (exists (join (get state :project) "site/index.html")))) :toBe t))))
  (test "a forced run builds even when the event cannot change the site" (async () (let*
        ((result (await (react "issue_comment" (js-object :action "created") (js-array "--force")))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (js-call (expect (get result :outputs)) :toContain "built=true")
        (js-call (expect (get result :outputs)) :toContain "reason=forced"))))
  (test "production output excludes drafts" (async () (let*
        ((files (get (await (run (js-array "ls" (join (get state :project) "site/posts")))) :stdout)))
        (js-call (get (expect files) :not) :toContain "demo-draft")
        (js-call (expect files) :toContain "welcome"))))
  (test "preview output includes drafts, unindexable and unadvertised" (async () (let*
        ((result (await (react "workflow_dispatch" (js-object) (js-array "--preview")))) (__ign_8 (js-call (expect (get result :exitCode)) :toBe 0)) (output (join (get state :project) "site")) (draft (await (readFile (join output "posts/demo-draft/index.html") "utf8"))))
        (js-call (expect draft) :toContain "<meta name=\"robots\" content=\"noindex\">")
        (js-call (expect draft) :toContain "preview-banner")
        (js-call (expect draft) :toContain "must not be indexed")
        (js-call (expect (await (exists (join output "feed.xml")))) :toBe false)
        (js-call (expect (await (exists (join output "sitemap.xml")))) :toBe false)
        (js-call (expect (await (readFile (join output "robots.txt") "utf8"))) :toBe "User-agent: *\nDisallow: /\n")
        (let*
          ((published (await (react "workflow_dispatch" (js-object)))))
          (js-call (expect (get published :exitCode)) :toBe 0)
          (js-call (expect (await (exists (join output "feed.xml")))) :toBe t)
          (js-call (expect (await (exists (join output "sitemap.xml")))) :toBe t)
          (js-call (expect (await (readFile (join output "robots.txt") "utf8"))) :toContain "Allow: /")))))
  (test "a previous manifest that disagrees stops the run before it replaces output" (async () (let*
        ((project (get state :project)) (manifest (join project "site/_dogfood/build.json")) (recorded (js-call globalThis.JSON :parse (await (readFile manifest "utf8")))) (wrong (join (get state :staging) "wrong-manifest.json")) (__ign_9 (await (writeFile wrong (js-call globalThis.JSON :stringify (js-call globalThis.Object :assign (js-object) recorded (js-object :contentFingerprint (js-call "0" :repeat 64))))))) (result (await (react "push" (js-object :ref "refs/heads/master") (js-array "--previous-manifest" wrong)))))
        (js-call (expect (get result :exitCode)) :toBe 1)
        (js-call (expect (get result :stdout)) :toContain "DOGFOOD-BUILD-004")
        (js-call (expect (get result :outputs)) :toContain "reason=failed")
        (js-call (expect (await (readFile (join project "site/robots.txt") "utf8"))) :toContain "Allow: /")
        (js-call (expect (await (exists (join project "site.staging")))) :toBe false)
        (let*
          ((honest (await (react "push" (js-object :ref "refs/heads/master") (js-array "--previous-manifest" manifest "--force")))))
          (js-call (expect (get honest :exitCode)) :toBe 0)
          (js-call (expect (get honest :outputs)) :toContain "built=true")))))
  (test "a missing previous manifest is reported rather than ignored" (async () (let*
        ((result (await (react "push" (js-object :ref "refs/heads/master") (js-array "--previous-manifest" (join (get state :staging) "absent.json"))))))
        (js-call (expect (get result :exitCode)) :toBe 1)
        (js-call (expect (get result :stdout)) :toContain "DOGFOOD-BUILD-005")))))
