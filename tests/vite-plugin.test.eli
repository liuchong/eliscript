(module tests.vite-plugin.test
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "vite" createServer)
  (import "../tools/vite/index.mjs" eliscript)
  (defconst projectDirectory (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst componentFile (resolve projectDirectory "examples/react-counter/main.eli"))
  (defun optionalGet (value key) (if (nullish? value) undefined (get value key)))
  (defasync scanSources (glob options check)
    (let* ((stream (js-call glob :scan options)) (iterator (Reflect/apply (get stream (get globalThis.Symbol :asyncIterator)) stream (js-array))) (done false))
      (while (not done)
        (let ((step (await (js-call iterator :next))))
          (setq done (get step :done))
          (unless done
            (try (await (funcall check (get step :value)))
              (catch error
                (try (let ((close (get iterator :return))) (unless (nullish? close) (await (Reflect/apply close iterator (js-array))))) (catch ignored nil))
                (throw error))))))))
  (test "Vite remains an application adapter outside language core" (async ()
    (let ((forbiddenImport (new globalThis.RegExp "(?:from\\s*|import\\s*\\(\\s*|require\\s*\\(\\s*)[\"'](?:vite|@vitejs/|react(?:-dom)?(?:/[^\"']*)?)[\"']"))
          (forbiddenCoreSyntax (new globalThis.RegExp "\\b(?:defcomponent|jsx|react-element|react-fragment)\\b" "iu"))
          (roots (js-array "bootstrap/compiler" "compiler" "runtime" "stdlib")) (index 0))
      (while (< index 4)
        (let* ((root (aref roots index)) (glob (new globalThis.Bun.Glob "**/*.{el,eli,mjs}")))
          (await (scanSources glob (js-object :cwd (resolve projectDirectory root) :onlyFiles t) (async (file)
            (let ((source (await (readFile (resolve projectDirectory root file) "utf8"))))
              (js-call (get (expect source) :not) :toMatch forbiddenImport) (js-call (get (expect source) :not) :toMatch forbiddenCoreSyntax))))))
        (setq index (1+ index))))
    (let* ((packageJson (JSON/parse (await (readFile (resolve projectDirectory "package.json") "utf8"))))
           (dependencies (get packageJson :dependencies)) (devDependencies (get packageJson :devDependencies)))
      (js-call (expect (optionalGet dependencies "vite")) :toBeUndefined)
      (js-call (expect (optionalGet dependencies "@vitejs/plugin-react")) :toBeUndefined)
      (js-call (expect (optionalGet dependencies "react")) :toBeUndefined)
      (js-call (expect (optionalGet dependencies "react-dom")) :toBeUndefined)
      (js-call (expect (optionalGet devDependencies "react")) :toBeDefined)
      (js-call (expect (optionalGet devDependencies "react-dom")) :toBeDefined)
      (js-call (expect (optionalGet devDependencies "vite")) :toBeDefined))))
  (test "Vite adapter compiles .eli modules with source maps" (async ()
    (let* ((source (await (readFile componentFile "utf8"))) (watchedFiles (js-array)) (plugin (eliscript))
           (result (await (Reflect/apply (get plugin :transform) (js-object :addWatchFile (lambda (file) (js-call watchedFiles :push file))) (js-array source (str componentFile "?direct"))))))
      (js-call (expect (get result :code)) :toContain "from \"react/jsx-runtime\"")
      (js-call (get (expect (get result :code)) :not) :toContain "__eliscript_react")
      (js-call (expect (get result :code)) :toContain "function Counter(props)")
      (js-call (get (expect (get result :code)) :not) :toContain "sourceMappingURL")
      (js-call (expect (get (get result :map) :version)) :toBe 3)
      (js-call (expect (get (get result :map) :sources)) :toEqual (js-array componentFile))
      (js-call (expect (get (get result :map) :sourcesContent)) :toEqual (js-array source))
      (js-call (expect (get (get (get result :map) :mappings) :length)) :toBeGreaterThan 0)
      (js-call (expect watchedFiles) :toEqual (js-array componentFile)))))
  (test "Vite adapter ignores non-Eliscript modules" (async ()
    (let* ((plugin (eliscript)) (result (await (Reflect/apply (get plugin :transform) (js-object :addWatchFile (lambda () nil))
      (js-array "export const answer = 42;" (resolve projectDirectory "answer.js"))))))
      (js-call (expect result) :toBeNull))))
  (test "Vite development transform adds a React Refresh boundary" (async ()
    (let ((server (await (createServer (js-object :configFile (resolve projectDirectory "examples/react-counter/vite.config.mjs")
      :optimizeDeps (js-object :noDiscovery t :include (js-array)) :server (js-object :middlewareMode t))))))
      (try (let ((result (await (js-call server :transformRequest "/main.eli"))))
        (js-call (expect (get result :code)) :toContain "$RefreshSig$")
        (js-call (expect (get result :code)) :toContain "$RefreshReg$")
        (js-call (expect (get result :code)) :toContain "import.meta.hot.accept")
        (js-call (expect (get result :code)) :toContain "function Counter(props)"))
        (finally (await (js-call server :close)))))) 15000)
)
