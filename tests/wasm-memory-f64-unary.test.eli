(module tests.wasm-memory-f64-unary.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:process" :default process)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst bigint-sub (js* "(a, b) => a - b"))
  (defconst bigint-add (js* "(a, b) => a + b"))

  (defconst names (js-array "abs" "neg" "ceil" "floor" "trunc" "nearest" "sqrt"))

  (defconst native-target
    (if (= (get process :arch) "arm64")
      (cond
        ((= (get process :platform) "darwin") "arm64-macos")
        ((= (get process :platform) "linux") "arm64-linux")
        (t undefined))
      undefined))

  (defconst native-unary-test (js-call test :skipIf (nullish? native-target)))
  (defconst options (js-object :initialPages 1 :maximumPages 1))

  (defun increment-expr (digit)
    (str "(store-u32 0 (+ (* (load-u32 0) 10) " digit "))"))

  (defconst source
    (str "(import \"eliscript:memory32\" load-u32 store-u32 load-f64 store-f64 "
         (js-call (js-call names :map (lambda (name) (str "f64-" name))) :join " ")
         ")\n"
         "(defun write_word (address value) (store-u32 address value))\n"
         "(defun read_word (address) (load-u32 address))\n"
         (js-call
           (js-call names :map
             (lambda (name)
               (str "(defun " name " (to from) (store-f64 to (f64-" name " (load-f64 from))))\n"
                    "(defun effect_" name " (to from) (store-f64 (progn " (increment-expr 1) " to) "
                    "(f64-" name " (progn " (increment-expr 2) " (load-f64 from)))))")))
           :join "\n")
         "\n(export write_word read_word "
         (js-call (js-call names :flatMap (lambda (name) (js-array name (str "effect_" name)))) :join " ")
         ")"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar wasm-mod nil)
  (defvar wasm-file nil)
  (defvar native-rt nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-f64-unary-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((ir (js-call (get backend :compiler) :compile_ir_string source "f64-unary.eli"))
             (saved (JSON/stringify ir))
             (bytes (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm ir options))))
        (setq wasm-mod (new globalThis.WebAssembly.Module bytes))
        (js-call assert :deepEqual (WebAssembly.Module/imports wasm-mod) (js-array))
        (setq wasm-file (resolve directory "unary.wasm"))
        (await (writeFile wasm-file bytes))
        (when (not (nullish? native-target))
          (let ((library (resolve directory (if (= native-target "arm64-macos") "unary.dylib" "unary.so")))
                (arities (Object/assign
                           (js-object :write_word 2 :read_word 1)
                           (Object/fromEntries
                             (js-call names :flatMap (lambda (name) (js-array (js-array name 2) (js-array (str "effect_" name) 2))))))))
            (await (writeFile library (Uint8Array/from (js-call (get backend :native) :emit_native_memory_library ir native-target))))
            (setq native-rt
              (await (openNativeMemory library arities (Object/assign (js-object) options (js-object :nativeTarget native-target)))))))
        (js-call assert :equal (JSON/stringify ir) saved "both real emitters preserve the complete source IR")))
    120000)

  (afterAll
    (async ()
      (try
        (when (not (nullish? native-rt))
          (js-call native-rt :close))
        (finally
          (when directory
            (await (rm directory (js-object :recursive t :force t))))))))

  (defun nearest-even (value)
    (if (or (not (Number/isFinite value)) (= value 0) (>= (Math/abs value) 4503599627370496))
      value
      (let* ((magnitude (Math/abs value))
             (lower (Math/floor magnitude))
             (fraction (- magnitude lower))
             (rounded (if (or (> fraction 0.5) (and (= fraction 0.5) (/= (% lower 2) 0)))
                        (+ lower 1)
                        lower)))
        (if (< value 0) (- rounded) rounded))))

  (defun expected-unary (name value)
    (cond
      ((= name "neg") (- value))
      ((= name "nearest") (nearest-even value))
      (t (funcall (aref globalThis.Math name) value))))

  (defun make-samples ()
    (let ((words (js-array))
          (bytes (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
          (one-n (globalThis.BigInt 1))
          (raw-hex (js-array
                     "0" "0x8000000000000000" "1" "0x8000000000000001"
                     "0x000fffffffffffff" "0x800fffffffffffff" "0x0010000000000000" "0x8010000000000000"
                     "0x7fefffffffffffff" "0xffefffffffffffff" "0x7ff0000000000000" "0xfff0000000000000"
                     "0x7ff8000012345678" "0xfff80000abcdef01" "0x7ff0000012345678" "0xfff0000000000001"))
          (floats (js-array
                    -4.5 -3.5 -2.5 -1.5 -0.5 0.5 1.5 2.5 3.5 4.5
                    (- 4503599627370496 0.5) (- (- 4503599627370496 0.5))
                    4503599627370496 -4503599627370496 1 2 4 0.1)))
      (js-call raw-hex :forEach
        (lambda (h)
          (js-call bytes :setBigUint64 0 (globalThis.BigInt h) t)
          (js-call words :push (js-array (js-call bytes :getUint32 0 t) (js-call bytes :getUint32 4 t)))))
      (js-call floats :forEach
        (lambda (value)
          (js-call bytes :setFloat64 0 value t)
          (let ((bits (js-call bytes :getBigUint64 0 t)))
            (js-call (js-array (funcall bigint-sub bits one-n) bits (funcall bigint-add bits one-n)) :forEach
              (lambda (neighbor)
                (js-call bytes :setBigUint64 0 neighbor t)
                (js-call words :push (js-array (js-call bytes :getUint32 0 t) (js-call bytes :getUint32 4 t))))))))
      (let* ((state 1902788393)
             (next (lambda ()
                     (setq state (bit-xor state (bit-shift-left state 13)))
                     (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                     (setq state (bit-xor state (bit-shift-left state 5)))
                     (unsigned-bit-shift-right state 0)))
             (idx 0))
        (while (< idx 512)
          (js-call words :push (js-array (funcall next) (funcall next)))
          (setq idx (+ idx 1))))
      words))

  (defun wasm-runtime (mod)
    (let ((exports (get (new globalThis.WebAssembly.Instance mod) :exports)))
      (js-object
        :invoke (lambda (name &rest args)
                  (unsigned-bit-shift-right (js-call (aref exports name) :apply nil args) 0)))))

  (defun read-float (rt address)
    (let ((view (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call view :setUint32 0 (js-call rt :invoke "read_word" address) t)
      (js-call view :setUint32 4 (js-call rt :invoke "read_word" (+ address 4)) t)
      (js-call view :getFloat64 0 t)))

  (defun check-unary (rt cases)
    (let ((view (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call cases :forEach
        (lambda (pair)
          (let ((low (aref pair 0))
                (high (aref pair 1)))
            (js-call rt :invoke "write_word" 64 low)
            (js-call rt :invoke "write_word" 68 high)
            (js-call view :setUint32 0 low t)
            (js-call view :setUint32 4 high t)
            (let ((input (js-call view :getFloat64 0 t)))
              (js-call names :forEach
                (lambda (name)
                  (js-call assert :equal (js-call rt :invoke name 128 64) 0)
                  (let ((actual (read-float rt 128))
                        (expected (expected-unary name input)))
                    (funcall assert
                      (if (Number/isNaN expected) (Number/isNaN actual) (Object/is actual expected))
                      (str name " input words " (js-call low :toString 16) ":" (js-call high :toString 16)))
                    (js-call assert :equal (js-call rt :invoke "read_word" 64) low)
                    (js-call assert :equal (js-call rt :invoke "read_word" 68) high
                      "input NaN payloads and all IEEE bits remain untouched"))))))))))

  (defun check-effects (rt)
    ;; 1.5 is passed only as two linear-memory words, never as a host f64 ABI argument.
    (js-call rt :invoke "write_word" 64 0)
    (js-call rt :invoke "write_word" 68 1073217536)
    (js-call names :forEach
      (lambda (name)
        (js-call rt :invoke "write_word" 0 0)
        (js-call rt :invoke "write_word" 24 3405691582)
        (js-call assert :equal (js-call rt :invoke (str "effect_" name) 128 64) 0)
        (js-call assert :equal (js-call rt :invoke "read_word" 0) 12 "destination then exactly one unary operand")
        (funcall assert (Object/is (read-float rt 128) (expected-unary name 1.5)))
        (js-call assert :equal (js-call rt :invoke "read_word" 24) 3405691582)
        (js-call (js-array (js-array 128 65532) (js-array 65532 64)) :forEach
          (lambda (pair)
            (let ((to (aref pair 0))
                  (from (aref pair 1)))
              (js-call rt :invoke "write_word" 0 0)
              (js-call rt :invoke "write_word" 128 287454020)
              (js-call rt :invoke "write_word" 132 1432778632)
              (js-call assert :throws
                (lambda () (js-call rt :invoke (str "effect_" name) to from))
                globalThis.WebAssembly.RuntimeError)
              (js-call assert :equal (js-call rt :invoke "read_word" 0) 12)
              (js-call assert :equal (js-call rt :invoke "read_word" 128) 287454020)
              (js-call assert :equal (js-call rt :invoke "read_word" 132) 1432778632)
              (js-call rt :invoke "write_word" 0 0)
              (js-call assert :equal (js-call rt :invoke (str "effect_" name) 128 64) 0)
              (js-call assert :equal (js-call rt :invoke "read_word" 0) 12)
              (funcall assert (Object/is (read-float rt 128) (expected-unary name 1.5)) "the same instance recovers after a trap")))))))

  (test "all seven memory32 f64 unary operations preserve IEEE results and source words in real zero-import WASM"
    (lambda ()
      (check-unary (wasm-runtime wasm-mod) (make-samples))))

  (funcall native-unary-test "all seven f64 unary operations execute actual native code against the independent IEEE oracle"
    (lambda ()
      (check-unary native-rt (make-samples))))

  (test "unary operands execute once after the destination and preserve traps effects and recovery in both backends"
    (lambda ()
      (check-effects (wasm-runtime wasm-mod))
      (when (not (nullish? native-rt))
        (check-effects native-rt))))

  (test "every f64 unary family member rejects missing extra word operands and word destinations before emission"
    (lambda ()
      (js-call names :forEach
        (lambda (name)
          (js-call
            (js-array
              (str "(f64-" name ")")
              (str "(f64-" name " (load-f64 0) (load-f64 8))")
              (str "(f64-" name " 1)"))
            :forEach
            (lambda (expression)
              (let* ((text (str "(import \"eliscript:memory32\" load-f64 store-f64 f64-" name ") "
                                "(defun bad () (store-f64 0 " expression ")) (export bad)"))
                     (ir (js-call (get backend :compiler) :compile_ir_string text "f64-unary-invalid.eli"))
                     (saved (JSON/stringify ir)))
                (js-call
                  (js-array
                    (lambda (value) (js-call (get backend :wasm) :emit_memory_wasm value options))
                    (lambda (value) (js-call (get backend :native) :emit_native_memory_object value "arm64-macos")))
                  :forEach
                  (lambda (emit-fn)
                    (js-call assert :throws
                      (lambda () (funcall emit-fn ir))
                      (lambda (err)
                        (let ((diag (get err :eliscriptDiagnostic)))
                          (js-call assert :equal (get diag :code) "ELI-B0001")
                          (js-call assert :equal (get diag :phase) "memory-backend")
                          (js-call assert :equal (get (get diag :location) :file) "f64-unary-invalid.eli")
                          t)))
                    (js-call assert :equal (JSON/stringify ir) saved))))))))
      (js-call names :forEach
        (lambda (name)
          (let ((ir (js-call (get backend :compiler) :compile_ir_string
                      (str "(import \"eliscript:memory32\" load-f64 store-u32 f64-" name ") "
                           "(defun bad () (store-u32 0 (f64-" name " (load-f64 8)))) (export bad)")
                      "f64-unary-invalid.eli")))
            (js-call
              (js-array
                (lambda (value) (js-call (get backend :wasm) :emit_memory_wasm value options))
                (lambda (value) (js-call (get backend :native) :emit_native_memory_object value "arm64-macos")))
              :forEach
              (lambda (emit-fn)
                (js-call assert :throws
                  (lambda () (funcall emit-fn ir))
                  (lambda (err)
                    (let ((diag (if (and (not (nullish? err)) (= (funcall js-typeof err) "object"))
                                  (get err :eliscriptDiagnostic)
                                  nil)))
                      (and (not (nullish? diag))
                           (= (get diag :code) "ELI-B0001")
                           (= (get diag :phase) "memory-backend"))))))))))))

  (test "independent Node executes the same WASM bytes with ties-even IEEE random payload and trap-order assertions"
    (lambda ()
      (let* ((cases (make-samples))
             (node-bin (let ((env-node (get (get process :env) :NODE))) (if (nullish? env-node) "node" env-node)))
             (runner (resolve "tests/helpers/wasm-memory-f64-unary-node.mjs"))
             (child (spawnSync node-bin
                      (js-array runner wasm-file)
                      (js-object
                        :encoding "utf8"
                        :input (JSON/stringify (js-object :names names :cases cases))
                        :timeout 30000
                        :maxBuffer 65536))))
        (js-call assert :equal (get child :error) undefined)
        (js-call assert :equal (get child :signal) nil)
        (js-call assert :equal (get child :status) 0 (get child :stderr))
        (js-call assert :deepEqual (JSON/parse (get child :stdout))
          (js-object :cases (length cases) :operations (length names)))))
    30000))
