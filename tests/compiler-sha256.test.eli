(module tests.compiler-sha256
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs/promises" readFile)
  (import "node:child_process" spawnSync)
  (import "node:vm" runInNewContext)
  (import "node:url" fileURLToPath)
  (import "../tools/backends/compiler-sha256.mjs" :as publicApi)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst createCompilerSha256 (get publicApi :createCompilerSha256))
  (defconst encoder (new globalThis.TextEncoder))
  (defconst moduleURL (new globalThis.URL "../tools/backends/compiler-sha256.mjs" (js* "import.meta.url")))
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst bigint-high (js* "(bytes) => Number(bytes >> 32n)"))
  (defconst bigint-low (js* "(bytes) => Number(bytes & 0xffffffffn)"))
  (defconst bigint-bits (js* "(bytes) => bytes * 8n"))
  (defun cryptoHex (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun digestChunks (bytes size)
    (let ((hash (createCompilerSha256)) (offset 0))
      (js-call hash :update (new globalThis.Uint8Array 0))
      (while (< offset (get bytes :length))
        (js-call assert :equal (js-call hash :update (js-call bytes :subarray offset (+ offset size))) hash)
        (setq offset (+ offset size)))
      (js-call hash :update (new globalThis.Uint8Array 0))
      (let ((result (js-call hash :digestHex))) (js-call assert :match result (new globalThis.RegExp "^[0-9a-f]{64}$")) result)))
  (defun randomBytes (size seed)
    (let ((bytes (new globalThis.Uint8Array size)) (state (uint32 seed)) (index 0))
      (while (< index size)
        (setq state (bit-xor state (bit-shift-left state 13)) state (bit-xor state (unsigned-bit-shift-right state 17)) state (bit-xor state (bit-shift-left state 5)))
        (put bytes index (bit-and state 255)) (setq index (1+ index))) bytes))
  (test "compiler SHA-256 matches NIST empty, abc, multiblock and million-a vectors" (lambda ()
    (js-call assert :deepEqual (Object/keys publicApi) (js-array "createCompilerSha256"))
    (js-call (js-array (js-array "" "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") (js-array "abc" "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") (js-array "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq" "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1") (js-array (str "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmno" "ijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")) :forEach (lambda (pair)
      (let ((bytes (js-call encoder :encode (aref pair 0))) (expected (aref pair 1)))
        (js-call assert :equal (cryptoHex bytes) expected)
        (js-call (js-array 1 3 7 55 56 63 64 65 4096) :forEach (lambda (size) (js-call assert :equal (digestChunks bytes size) expected (str "NIST chunk size " size)))))))
    (let ((millionA (js-call (new globalThis.Uint8Array 1000000) :fill 97)) (expected "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"))
      (js-call assert :equal (cryptoHex millionA) expected) (js-call assert :equal (digestChunks millionA 4093) expected) (js-call assert :equal (digestChunks millionA (get millionA :length)) expected))))
  (test "every split around padding and compression boundaries equals node:crypto" (lambda ()
    (js-call (js-array 0 1 55 56 63 64 65 127 128 129) :forEach (lambda (size)
      (let* ((bytes (randomBytes size (+ 1162627328 size))) (expected (cryptoHex bytes)) (cut 0))
        (while (<= cut size)
          (let ((hash (createCompilerSha256)))
            (js-call hash :update (js-call bytes :subarray 0 cut)) (js-call hash :update (new globalThis.Uint8Array 0)) (js-call hash :update (js-call bytes :subarray cut))
            (js-call assert :equal (js-call hash :digestHex) expected (str "length " size ", cut " cut))) (setq cut (1+ cut))))))
    (let* ((bytes (randomBytes 257 324508639)) (expected (cryptoHex bytes)) (size 1))
      (while (<= size 65) (js-call assert :equal (digestChunks bytes size) expected) (setq size (1+ size))))))
  (test "deterministic random data from zero through one MiB matches crypto in varied chunks" (lambda ()
    (let ((lengths (js-array 0 2 3 7 31 55 56 63 64 65 255 256 1023 4097 65535 65536 1048575 1048576)) (seed 608135816) (index 0))
      (while (< index 12) (setq seed (uint32 (+ (imul32 seed 1664525) 1013904223))) (js-call lengths :push (% seed 1048577)) (setq index (1+ index)))
      (js-call lengths :forEach (lambda (size)
        (let* ((bytes (randomBytes size (bit-xor seed size))) (expected (cryptoHex bytes)) (hash (createCompilerSha256)) (offset 0) (chunks 0))
          (js-call assert :equal (digestChunks bytes (1+ size)) expected)
          (while (< offset (get bytes :length))
            (setq seed (uint32 (+ (imul32 seed 1664525) 1013904223)))
            (let ((end (Math/min (get bytes :length) (+ offset 1 (% seed 4097)))))
              (js-call hash :update (js-call bytes :subarray offset end)) (setq offset end chunks (1+ chunks)))
            (when (= (bit-and chunks 7) 0) (js-call hash :update (new globalThis.Uint8Array 0))))
          (js-call assert :equal (js-call hash :digestHex) expected (str "random chunks, length " size))))))))
  (test "updates consume caller views immediately and independent instances never share state" (lambda ()
    (js-call (js-array 1 55 64 65 129 4097) :forEach (lambda (size)
      (let* ((backing (randomBytes (+ size 19) size)) (view (js-call backing :subarray 7 (+ 7 size))) (expected (cryptoHex view)) (hash (createCompilerSha256)))
        (js-call hash :update view) (js-call backing :fill 0) (js-call assert :equal (js-call hash :digestHex) expected (str "caller mutation, length " size)))))
    (let ((first (createCompilerSha256)) (second (createCompilerSha256)))
      (js-call first :update (js-call encoder :encode "a")) (js-call second :update (js-call encoder :encode "different")) (js-call first :update (js-call encoder :encode "bc"))
      (js-call assert :equal (js-call first :digestHex) (cryptoHex (js-call encoder :encode "abc")))
      (js-call second :update (js-call encoder :encode " message")) (js-call assert :equal (js-call second :digestHex) (cryptoHex (js-call encoder :encode "different message"))))
    (let ((crossRealm (runInNewContext "new Uint8Array([97, 98, 99])")))
      (js-call assert :equal (js-call (js-call (createCompilerSha256) :update crossRealm) :digestHex) (cryptoHex (js-call encoder :encode "abc"))))
    (let ((overridden (js-call encoder :encode "abc")) (properties (js-object
      :length (js-object :get (lambda () (throw (new globalThis.Error "must not observe caller length"))))
      :subarray (js-object :get (lambda () (throw (new globalThis.Error "must not observe caller subarray"))))
      :constructor (js-object :get (lambda () (throw (new globalThis.Error "must not observe caller species")))))))
      (put properties (get globalThis.Symbol :toStringTag) (js-object :value "spoofed"))
      (Object/defineProperties overridden properties)
      (js-call assert :equal (js-call (js-call (createCompilerSha256) :update overridden) :digestHex) (cryptoHex (js-call encoder :encode "abc"))))))
  (test "invalid updates do not mutate the hash and finalization is single use" (lambda ()
    (let ((fake (new globalThis.Uint16Array (js-array 1 2))) (detached (new globalThis.Uint8Array (js-array 1 2 3))))
      (Object/defineProperty fake (get globalThis.Symbol :toStringTag) (js-object :value "Uint8Array"))
      (globalThis/structuredClone (get detached :buffer) (js-object :transfer (js-array (get detached :buffer))))
      (let ((invalid (js-array undefined nil false 17 "abc" (js-array) (js-object) (new globalThis.ArrayBuffer 3)
              (new globalThis.DataView (new globalThis.ArrayBuffer 3)) (new globalThis.Uint16Array 3) (new globalThis.Uint8ClampedArray 3)
              (new globalThis.Proxy (new globalThis.Uint8Array 3) (js-object)) fake detached)) (hash (createCompilerSha256)))
        (js-call hash :update (js-call encoder :encode "a"))
        (js-call invalid :forEach (lambda (value) (js-call assert :throws (lambda () (js-call hash :update value)) globalThis.TypeError)))
        (js-call hash :update (js-call encoder :encode "bc")) (js-call assert :equal (js-call hash :digestHex) (cryptoHex (js-call encoder :encode "abc")))
        (js-call assert :throws (lambda () (js-call hash :digestHex)) (new globalThis.RegExp "already been finalized"))
        (js-call assert :throws (lambda () (js-call hash :update (js-call encoder :encode "later"))) (new globalThis.RegExp "already been finalized"))
        (js-call assert :throws (lambda () (js-call hash :update (new globalThis.Uint8Array 0))) (new globalThis.RegExp "already been finalized"))
        (js-call assert :throws (lambda () (js-call hash :update nil)) (new globalThis.RegExp "already been finalized"))
        (let ((empty (createCompilerSha256)))
          (js-call assert :equal (js-call empty :digestHex) (cryptoHex (new globalThis.Uint8Array 0))) (js-call assert :throws (lambda () (js-call empty :digestHex)) globalThis.TypeError))))))
  (test "actual private length arithmetic and padding encode high 32 bits without a huge allocation" (async ()
    (let* ((source (await (readFile moduleURL "utf8"))) (helpers (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from (str source "\nexport {addCompilerSha256Bytes, writeCompilerSha256BitLength};\n")) :toString "base64")))))
           (add (get helpers :addCompilerSha256Bytes)) (write (get helpers :writeCompilerSha256BitLength)))
      (js-call (js-array (js* "0n") (js* "1n") (js* "55n") (js* "56n") (js* "63n") (js* "64n") (js* "65n") (js* "536870911n") (js* "536870912n") (js* "4294967295n") (js* "4294967296n") (js* "4294967297n") (js* "81985529216486895n") (js* "2305843009213693951n")) :forEach (lambda (bytes)
        (let ((length (js-object :high (funcall bigint-high bytes) :low (funcall bigint-low bytes))) (block (js-call (new globalThis.Uint8Array 64) :fill 165)))
          (funcall write block length) (js-call assert :deepEqual (Array/from (js-call block :subarray 0 56)) (js-call (new globalThis.Array 56) :fill 165))
          (js-call assert :equal (js-call (Buffer/from block) :readBigUInt64BE 56) (funcall bigint-bits bytes)))))
      (let ((carried (js-object :high 0 :low 4294967280)))
        (funcall add carried 48) (js-call assert :deepEqual carried (js-object :high 1 :low 32))
        (funcall add carried 4294967301) (js-call assert :deepEqual carried (js-object :high 2 :low 37)))
      (let ((maximum (js-object :high 536870911 :low 4294967294)))
        (funcall add maximum 1) (js-call assert :deepEqual maximum (js-object :high 536870911 :low 4294967295))
        (let ((before (copyHostRecord maximum)))
          (js-call assert :throws (lambda () (funcall add maximum 1)) (new globalThis.RegExp "fewer than 2\\^64 bits")) (js-call assert :deepEqual maximum before)
          (js-call (js-array -1 0.5 globalThis.NaN globalThis.Infinity (+ globalThis.Number.MAX_SAFE_INTEGER 1)) :forEach (lambda (amount)
            (js-call assert :throws (lambda () (funcall add maximum amount)) globalThis.RangeError) (js-call assert :deepEqual maximum before))))))))
  (test "an independent real Node process compares the portable module with node:crypto" (lambda ()
    (let ((result (spawnSync (get (get globalThis.process :env) :NODE "node")
      (js-array (fileURLToPath (new globalThis.URL "./fixtures/compiler-sha256-host.mjs" (js* "import.meta.url"))) (get moduleURL :href))
      (js-object :encoding "utf8" :timeout 30000 :maxBuffer 65536))))
      (js-call assert :equal (get result :error) undefined) (js-call assert :equal (get result :signal) nil) (js-call assert :equal (get result :status) 0 (get result :stderr)))))
)
