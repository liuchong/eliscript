(module tests.transient-builder-benchmark
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../tools/collections/transient-builder-benchmark.mjs" transientBuilderSourceDigest validateTransientBuilderReport)
  (defconst reportPath (fileURLToPath (new globalThis.URL "../benchmarks/transient-builder-macos-arm64.json" (js* "import.meta.url"))))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (test "retained transient builder report preserves measured runtime evidence" (async ()
    (let ((report (validateTransientBuilderReport (await (readReport)))))
      (js-call (expect (get report :parameters)) :toMatchObject (js-object :vectorSize 200000 :mapSize 100000 :setSize 100000 :warmupRounds 2 :timingSamples 11))
      (js-call (js-array "vector" "map" "set") :forEach (lambda (name)
        (let ((result (get (get report :results) name)))
          (js-call (expect (get (get result :correctness) :equivalent)) :toBe t)
          (js-call (expect (get (get result :correctness) :sameHash)) :toBe t)
          (js-call (expect (get (get result :allocation) :completionCalls)) :toBe 1)
          (js-call (expect (get (get result :allocation) :allocationRatio)) :toBeLessThanOrEqual (/ 1 3))
          (js-call (expect (get (get result :timing) :speedup)) :toBeGreaterThanOrEqual 1.5)))))))
  (test "transient builder report validator rejects incomplete evidence" (async ()
    (let ((report (await (readReport))))
      (js-call (get (get (get (get report :results) :vector) :timing) :transientSamplesMs) :pop)
      (js-call (expect (lambda () (validateTransientBuilderReport report))) :toThrow "transient vector builder evidence failed"))))
  (funcall (currentPerformanceTest test) "committed transient builder report matches core runtime sources" (async ()
    (js-call (expect (get (await (readReport)) :sourceDigest)) :toEqual (await (transientBuilderSourceDigest)))))
)
