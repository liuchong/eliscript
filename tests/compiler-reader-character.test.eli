(module tests.compiler-reader-character
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (defconst compilerSources (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))

  (import "node:crypto" createHash)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/compiler/reader-character-benchmark.mjs" compilerReaderCharacterSourceDigest validateCompilerReaderCharacterReport)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst reportPath (resolve projectDirectory "benchmarks/compiler-reader-character-macos-arm64.json"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (defun raises (operation message) (js-call (expect operation) :toThrow message))
  (test "reader character predicates match their Eliscript references" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-reader-character-")))))
      (try
        (await (buildBootstrap directory))
        (let ((reader (await (loadModule directory "reader" "characters")))
              (hostBoundaries (js-array undefined nil false t -1 globalThis.NaN globalThis.Infinity)) (checked 0))
          (js-call hostBoundaries :forEach (lambda (code)
            (be (js-call reader :whitespace_code_p code) (js-call reader :reference_whitespace_code_p code))
            (be (js-call reader :delimiter_code_p code) (js-call reader :reference_delimiter_code_p code))
            (setq checked (1+ checked))))
          (let ((code 0))
            (while (<= code 1114111)
              (when (or (not (= (js-call reader :whitespace_code_p code) (js-call reader :reference_whitespace_code_p code)))
                        (not (= (js-call reader :delimiter_code_p code) (js-call reader :reference_delimiter_code_p code))))
                (throw (new globalThis.Error (str "reader character decision differs for " code))))
              (setq checked (1+ checked) code (1+ code))))
          (be checked (+ 1114112 (js-length hostBoundaries)))
          (js-call (js-array "" "abc" "😀token\nnext" "a😀λ;end" "\t \r\nfoo" ";😀λ\rcomment\n\nbar" ";trailing 😀" "\f\n;comment\n  :key/value" "foo\uD800bar") :forEach
            (lambda (source)
              (js-call (js-array 0 (Math/min 1 (get source :length))) :forEach (lambda (initialIndex)
                (let* ((state (js-object :source source :filename "boundary.eli" :index initialIndex :offset 11 :line 3 :column 7))
                       (fast (copyHostRecord state)) (reference (copyHostRecord state)))
                  (be (js-call reader :skip_space_and_comments fast) (js-call reader :reference_skip_space_and_comments reference))
                  (same fast reference)
                  (let ((start (js-object :index (get fast :index))))
                    (be (js-call reader :read_token fast start) (js-call reader :reference_read_token reference start))
                    (same fast reference))))))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "a failed original Reader performance gate retains every raw sample and the failed decision" (async ()
    (let ((report (await (readReport))) (failure undefined))
      (put (get report :measurements) :completeCompilerSpeedup 1.079) (put (get report :decision) :passed false)
      (try (validateCompilerReaderCharacterReport report) (catch error (setq failure error)))
      (js-call (expect failure) :toBeInstanceOf globalThis.TypeError) (be (get failure :report) report) (be (get (get (get failure :report) :decision) :passed) false)
      (js-call (js-array "referencePredicates" "optimizedPredicates" "baselineCompiler" "optimizedCompiler") :forEach (lambda (name)
        (js-call (expect (get (get (get (get failure :report) :measurements) name) :samplesMs)) :toHaveLength (get (get report :parameters) :timingSamples)))))))
  (test "committed reader character report preserves historical measurements and decisions" (async ()
    (let ((report (validateCompilerReaderCharacterReport (await (readReport)))))
      (js-call (expect (get (get report :corpus) :files)) :toHaveLength 13)
      (js-call (expect (get (get report :corpus) :files)) :toContain "bootstrap/compiler/project.eli")
      (js-call (expect (get (get report :corpus) :sourceBytes)) :toBeGreaterThan 200000)
      (be (get (get report :validation) :identicalCompilerOutputs) 13)
      (js-call (expect (get (get report :measurements) :completeCompilerSpeedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumCompleteCompilerSpeedup)))))
  (test "reader reacceptance rejects weakened thresholds and altered controls" (async ()
    (let* ((report (await (readReport))) (failed (JSON/parse (await (readFile (resolve projectDirectory "tools/compiler/results/reader-character-arrow-first-macos-arm64.json") "utf8")))) (failure undefined))
      (same (get failed :parameters) (get report :parameters))
      (js-call (expect (get (get failed :measurements) :completeCompilerSpeedup)) :toBeLessThan (get (get failed :decision) :minimumCompleteCompilerSpeedup))
      (try (validateCompilerReaderCharacterReport failed) (catch error (setq failure error)))
      (be (if (nullish? failure) undefined (get failure :report)) failed)
      (let ((forged (globalThis/structuredClone failed)))
        (put (get forged :decision) :passed t)
        (raises (lambda () (validateCompilerReaderCharacterReport forged)) "speedup decision failed"))
      (let ((weakened (globalThis/structuredClone report)))
        (put (get weakened :decision) :minimumCompleteCompilerSpeedup 1.01)
        (raises (lambda () (validateCompilerReaderCharacterReport weakened)) "speedup decision failed"))
      (let ((altered (globalThis/structuredClone report)))
        (put (aref (get (get (get altered :baseline) :control) :artifacts) 0) :control (js-call "0" :repeat 64))
        (raises (lambda () (validateCompilerReaderCharacterReport altered)) "controlled compiler baseline"))
      (let ((missing (globalThis/structuredClone report)))
        (js-call (get (get (get missing :baseline) :control) :restored) :pop)
        (raises (lambda () (validateCompilerReaderCharacterReport missing)) "controlled compiler baseline"))
      (let ((form "(defun sample () ; ) ignored\n (js* \"(nested)\") (list 1 (list 2)))"))
        (be (definition (str form "\n(defun next () nil)") "sample") form)
        (raises (lambda () (definition "(defun unfinished ()" "unfinished")) "unterminated")))))
  (test "the first portable Reader report retains its original failed performance decision" (async ()
    (let ((report (JSON/parse (await (readFile (resolve projectDirectory "tools/compiler/results/reader-portable-first-macos-arm64.json") "utf8")))))
      (same (get report :parameters) (js-object :warmupRounds 2 :predicateIterations 20 :compilerRounds 8 :timingSamples 15))
      (be (get (get report :validation) :identicalCompilerOutputs) 13)
      (be (get (get report :decision) :minimumCompleteCompilerSpeedup) 1.08) (be (get (get report :decision) :passed) false)
      (js-call (expect (get (get report :measurements) :completeCompilerSpeedup)) :toBeLessThan 1.08)
      (raises (lambda () (validateCompilerReaderCharacterReport report)) "speedup decision failed")
      (raises (lambda () (validateCompilerReaderCharacterReport (copyHostRecord report (js-object :decision (copyHostRecord (get report :decision) (js-object :passed t)))))) "speedup decision failed"))))
  (funcall (currentPerformanceTest test) "committed reader character report matches measured sources" (async ()
    (let ((report (await (readReport))))
      (same (get report :sourceDigest) (await (compilerReaderCharacterSourceDigest)))
      (let ((entries (get (get (get report :baseline) :control) :inputs)) (index 0))
        (while (< index (js-length entries))
          (let ((entry (aref entries index)))
            (be (get entry :sha256) (js-call (js-call (createHash "sha256") :update (await (readFile (resolve projectDirectory (get entry :path))))) :digest "hex")))
          (setq index (1+ index)))))))
)
