(module tests.wasm-managed-function-properties-runtime.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defconst source
    "(defun fixed () 7) (defun function-value () fixed) (defun closure () (lambda () 9))\n (defun member (value key) (aref value key)) (defun own (value key) (object-has? value key))\n (defun fallback (value key trace) (get value key (progn (js-call trace :push \"default\") 19)))\n (defun install (key value) (put (js* \"Object.prototype\") key value))\n (defun converted (value trace own)\n  (let ((key (js-object))) (put key (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call trace :push hint) \"missing\"))\n   (if own (object-has? value key) (aref value key))))\n (defun abrupt (value trace) (let ((key (js-object))) (put key (js* \"Symbol.toPrimitive\") (lambda (hint) (throw trace)))\n  (try (aref value key) (catch error (Object/is error trace)))))\n (defun object-own (value key) (Object/hasOwn value key))\n (defun describe (value key) (Object/getOwnPropertyDescriptor value key))\n (defun names (value) (Object/getOwnPropertyNames value))\n (defun proto (value) (Object/getPrototypeOf value))\n (defun convert-install (value field replacement trace)\n  (let ((key (js-object)))\n   (put key (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call trace :push hint) (put (js* \"Object.prototype\") field replacement) field))\n   (aref value key)))\n (defun normalized (value owner)\n  (cond ((= value undefined) (js-array \"undefined\")) ((= value nil) (js-array \"null\"))\n   ((= (value-type value) \"function\") (js-array \"function\" (get value :name) (get value :length)\n     (Object/hasOwn value \"prototype\") (Object/is value (get globalThis/Function :prototype))))\n   ((= (value-type value) \"object\") (js-array \"object\" (Object/is value (get owner :prototype))))\n   ((= (value-type value) \"symbol\") (js-array \"symbol\" (globalThis/String value))) (t (js-array \"value\" value))))\n (defun reflection (value key)\n  (let ((descriptor (Object/getOwnPropertyDescriptor value key)))\n   (JSON/stringify (js-array\n    (try (js-array \"value\" (normalized (aref value key) value)) (catch error (js-array \"throw\" (get error :name))))\n    (object-has? value key) (Object/hasOwn value key)\n    (if (= descriptor undefined) (js-array \"undefined\")\n     (js-array \"descriptor\" (Object/hasOwn descriptor \"value\") (normalized (get descriptor :value) value)\n      (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable)\n      (normalized (get descriptor :get) value) (normalized (get descriptor :set) value)))))))\n (defun reflection-shape (value)\n  (let ((symbols (js-array)) (symbol-keys (Object/getOwnPropertySymbols value)) (symbol-index 0))\n   (while (< symbol-index (js-length symbol-keys))\n    (js-call symbols :push (globalThis/String (aref symbol-keys symbol-index)))\n    (setq symbol-index (1+ symbol-index)))\n   (JSON/stringify (js-array (Object/keys value) (Object/getOwnPropertyNames value) symbols\n    (Object/is (Object/getPrototypeOf value) (get globalThis/Function :prototype))\n    (normalized (Object/getPrototypeOf value) value)))))\n (defun function-constructor () globalThis/Function)\n (defun native-shadow (value)\n  (let ((method (get value :toString)))\n   (js-array (value-type method) (Object/is method (get (get globalThis/Function :prototype) :toString)))))\n (export function-value closure member own object-own describe names proto fallback install converted abrupt convert-install reflection reflection-shape function-constructor native-shadow)")

  (defvar directory undefined)
  (defvar b undefined)
  (defvar rt undefined)
  (defvar p undefined)
  (defvar bytes undefined)
  (defvar js undefined)
  (defvar oracle undefined)
  (defvar nativeLowered undefined)
  (defvar nativePath undefined)

  (defconst reflectedKeys
    (js-array "name" "length" "prototype" "caller" "arguments" "call" "apply" "bind" "constructor" "toString" "__proto__" "kind" "missing"))

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-function-properties-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq rt (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq p (js-call (get b :compiler) :compile_ir_string source "functions.eli"))
    (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p rt)))
    (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
    (let ((javascript (js-call (get b :compiler) :emit_ir_string p))
          (reference (resolve directory "functions-reference.mjs")))
      (await (writeFile reference javascript))
      (setq js (await (dynamic-import (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64")))))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-function-properties-runtime-node.mjs")
                               (get (pathToFileURL reference) :href))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :error) undefined)
        (js-call assert :equal (get child :signal) nil)
        (js-call assert :equal (get child :status) 0 (or (get child :stderr) (get child :stdout)))
        (setq oracle (JSON/parse (get child :stdout)))))
    (when (and (= (get globalThis.process :platform) "darwin") (= (get globalThis.process :arch) "arm64"))
      (setq nativeLowered (js-call (get b :managed) :lower_managed_program p rt))
      (setq nativePath (resolve directory "functions.dylib"))
      (await (writeFile nativePath
               (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get nativeLowered :typed) "arm64-macos"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun read (a value)
    (cond
      ((and value (= (get value :kind) 5)) (js-call a :readString value))
      ((and value (= (get value :kind) 4)) (js-call a :readNumber value))
      ((and value (= (get value :kind) 14))
       (Array/from (js-object :length (js-call a :length value))
         (lambda (_ i)
           (let ((v (js-call a :get value i)))
             (try (read a v) (finally (js-call a :release v)))))))
      (t value)))

  (defun finish (a roots)
    (js-call roots :forEach (lambda (v) (js-call a :release v)))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (defun family (a)
    (js-call a :auto 1)
    (let ((f (js-call a :invoke "function-value"))
          (g (js-call a :invoke "closure"))
          (trace (js-call a :sourceArray (js-array)))
          (reference (lambda () 7)))
      (js-call (js-array f g) :forEach
        (lambda (value)
          (js-call (js-array "kind" "missing" "0" "") :forEach
            (lambda (name)
              (let ((key (js-call a :string name)))
                (js-call assert :equal (js-call a :invoke "member" (js-array value key)) (js-call js :member reference name))
                (js-call assert :equal (js-call a :invoke "own" (js-array value key)) (js-call js :own reference name))
                (js-call a :release key))))
          (js-call (js-array false t) :forEach
            (lambda (own)
              (let ((expected (js-array)))
                (js-call assert :equal (js-call a :invoke "converted" (js-array value trace own)) (js-call js :converted reference expected own))
                (js-call assert :deepEqual (read a trace) expected)
                (js-call a :resize trace 0))))
          (js-call assert :equal (js-call a :invoke "abrupt" (js-array value trace)) t)
          (let* ((key (js-call a :string "absent"))
                 (out (js-call a :invoke "fallback" (js-array value key trace))))
            (js-call assert :equal (js-call a :readNumber out) 19)
            (js-call assert :deepEqual (read a trace) (js-array "default"))
            (js-call a :resize trace 0)
            (js-call a :release key)
            (js-call a :release out))))
      (finish a (js-array f g trace))))

  (test "live named and closure functions preserve ordinary missing reads own predicates key hints and defaults under collecting GC"
    (lambda () (family (instantiateManagedRuntime bytes))))

  (defun reflectionFamily (a)
    (js-call a :auto 1)
    (let ((functions (js-array (js-call a :invoke "function-value")
                               (js-call a :invoke "closure")
                               (js-call a :invoke "function-constructor"))))
      (try
        (let ((index 0))
          (while (< index (js-length functions))
            (let ((f (aref functions index)))
              (js-call reflectedKeys :forEach
                (lambda (name)
                  (let ((key (js-call a :string name))
                        (out undefined))
                    (try
                      (setq out (js-call a :invoke "reflection" (js-array f key)))
                      (js-call assert :equal (js-call a :readString out) (get (get (aref oracle index) :fields) name) (str index "/" name))
                      (finally
                        (when out (js-call a :release out))
                        (js-call a :release key))))))
              (let ((shape (js-call a :invoke "reflection-shape" (js-array f))))
                (try
                  (js-call assert :equal (js-call a :readString shape) (get (aref oracle index) :shape))
                  (finally (js-call a :release shape))))
              (let ((shadow (js-call a :invoke "native-shadow" (js-array f))))
                (try
                  (js-call assert :deepEqual (read a shadow) (js-array "function" t))
                  (finally (js-call a :release shadow))))
              (js-call a :collect)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
            (setq index (1+ index))))
        (finally
          (js-call functions :forEach (lambda (f) (js-call a :release f)))))))

  (test "source named and closure functions expose exact native reads descriptors key order prototypes and strict caller errors" (lambda ()
    (let ((a (instantiateManagedRuntime bytes)))
      (try (reflectionFamily a) (finally (finish a (js-array)))))))

  (test "real Object prototype data participates after key conversion while canonical Function methods shadow deeper data" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes))
           (_ (js-call a :auto 1))
           (f (js-call a :invoke "function-value"))
           (value (js-call a :number -0.0))
           (key (js-call a :string "__function_inherited"))
           (valueOf (js-call a :string "valueOf"))
           (toString (js-call a :string "toString")))
      (js-call (js-array key valueOf toString) :forEach
        (lambda (property)
          (let ((out (js-call a :invoke "install" (js-array property value))))
            (js-call a :release out))))
      (js-call a :collect)
      (js-call (js-array key valueOf) :forEach
        (lambda (property)
          (let ((out (js-call a :invoke "member" (js-array f property))))
            (assert (Object/is (js-call a :readNumber out) -0.0))
            (js-call a :release out))
          (js-call assert :equal (js-call a :invoke "own" (js-array f property)) false)
          (js-call assert :equal (js-call a :invoke "object-own" (js-array f property)) false)))
      (let ((native (js-call a :invoke "native-shadow" (js-array f))))
        (js-call assert :deepEqual (read a native) (js-array "function" t))
        (js-call a :release native))
      (let* ((property "__function_inherited")
             (saved (Object/getOwnPropertyDescriptor globalThis.Object.prototype property))
             (expected undefined))
        (try
          (Object/defineProperty globalThis.Object.prototype property (js-object :value -0.0 :configurable t))
          (setq expected (js-call js :member (lambda () 0) property))
          (js-call assert :equal (js-call js :own (lambda () 0) property) false)
          (finally
            (if saved
              (Object/defineProperty globalThis.Object.prototype property saved)
              (Reflect/deleteProperty globalThis.Object.prototype property))))
        (let ((result (js-call a :invoke "member" (js-array f key))))
          (assert (Object/is (js-call a :readNumber result) expected))
          (js-call a :release result)
          (finish a (js-array f value key valueOf toString)))))))

  (test "raw ABI builtin marking is allocation-free and idempotent while values with no function metadata remain explicitly invalid for reflection" (async ()
    (let* ((runtimeSource (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (raw (js-call (get b :compiler) :compile_ir_string (str runtimeSource "\n(export value-function-new)") "function-abi.eli"))
           (binary (Uint8Array/from (js-call (get b :wasm) :emit_memory_wasm raw)))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module binary)) :exports))
           (h (js-call e "heap-new" 64 8192 65536))
           (call (lambda (name &rest args)
                   (uint32 (Reflect/apply (get e name) e (js-call (js-array h) :concat args)))))
           (fn (funcall call "value-function-new" 7 0)))
      (assert fn)
      (funcall call "heap-pin" fn)
      (let ((args (funcall call "value-refs" 7 2)))
        (funcall call "heap-pin" args)
        (funcall call "value-set" args 0 fn)
        (let ((before (js-array (funcall call "heap-live") (funcall call "heap-used"))))
          (js-call assert :equal (funcall call "value-function-mark-builtin" fn) fn)
          (js-call assert :equal (funcall call "value-function-mark-builtin" fn) fn)
          (js-call assert :deepEqual (js-array (funcall call "heap-live") (funcall call "heap-used")) before))
        (funcall call "heap-auto" 1)
        (js-call (js-array "missing" "kind" "isFinite" "name") :forEach
          (lambda (text)
            (let ((key (funcall call "value-string" (js-length text)))
                  (i 0))
              (funcall call "heap-pin" key)
              (while (< i (js-length text))
                (funcall call "value-unit-set" key i (js-call text :charCodeAt i))
                (setq i (1+ i)))
              (funcall call "value-seal" key)
              (funcall call "value-set" args 1 key)
              (js-call
                (js-array
                  (js-array "value-property-get" (js-array fn key 0))
                  (js-array "value-object-has" (js-array fn key))
                  (js-array "value-object-properties" (js-array args 2 1))
                  (js-array "value-object-reflection" (js-array args 2 2)))
                :forEach
                (lambda (pair)
                  (let ((name (aref pair 0))
                        (params (aref pair 1)))
                    (js-call assert :equal (Reflect/apply call nil (js-call (js-array name) :concat params)) 0)
                    (js-call assert :equal (js-call e "last-error") 3 (str name ":" text))
                    (js-call assert :equal (funcall call "frame-depth") 0))))
              (funcall call "heap-release" key))))
        (js-call assert :equal (funcall call "value-function-mark-builtin" 4294967295) 0)
        (js-call assert :equal (js-call e "last-error") 1)
        (funcall call "heap-release" fn)
        (funcall call "heap-release" args)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)))))

  (test "capacity errors and stale handles preserve a live function and caller roots and permit a successful retry" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 65536)))
           (f (js-call a :invoke "function-value"))
           (key (js-call a :string "missing"))
           (held (js-call a :number -0.0))
           (frame (js-call a :frame 1))
           (fillers (js-array)))
      (js-call a :frameSet frame 0 held)
      (js-call a :auto 1)
      (while (< (js-call a :live) 64)
        (js-call fillers :push (js-call a :number 7)))
      (js-call assert :throws
        (lambda () (js-call a :invoke "member" (js-array f key)))
        (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0002"))))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (assert (Object/is (js-call a :readNumber held) -0.0))
      (js-call fillers :forEach (lambda (v) (js-call a :release v)))
      (js-call a :collect)
      (js-call assert :equal (js-call a :invoke "member" (js-array f key)) undefined)
      (let ((stale (js-call a :invoke "closure")))
        (js-call a :release stale)
        (js-call a :collect)
        (js-call assert :throws
          (lambda () (js-call a :invoke "member" (js-array stale key)))
          (lambda (e) (and (get e :eliscriptDiagnostic) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001"))))
        (js-call a :leaveFrame frame)
        (finish a (js-array f key held))))))

  (test "a real property-helper trap unwinds callee roots and preserves a live function for retry" (async ()
    ;; The fixture's one-shot flag uses reserved low memory, not random-seed word20.
    (let* ((original (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (signature "(defun heap-function-property (heap function key nullish own)")
           (modified (js-call original :replace signature
                       (str signature " (when (and (= own 0) (= (load-u32 64) 0)) (store-u32 64 1) (load-u32 4294967295))"))))
      (js-call assert :notEqual modified original)
      (let* ((trap (js-call (get b :compiler) :compile_ir_string modified "function-trap.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p trap))))
             (_ (js-call a :auto 1))
             (f (js-call a :invoke "function-value"))
             (key (js-call a :string "missing"))
             (held (js-call a :number -0.0))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "member" (js-array f key)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (assert (Object/is (js-call a :readNumber held) -0.0))
        (js-call assert :equal (js-call a :invoke "member" (js-array f key)) undefined)
        (js-call a :leaveFrame frame)
        (finish a (js-array f key held))))))

  (funcall
    (js-call test :skipIf (or (/= (get globalThis.process :platform) "darwin") (/= (get globalThis.process :arch) "arm64")))
    "the same ordinary-function property and complete reflection families execute through actual native machine code"
    (async ()
      (let ((a (await (instantiateNativeManagedRuntime nativePath nativeLowered
                        (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216)))))
        (try
          (reflectionFamily a)
          (family a)
          (finally (js-call a :close))))))

  (test "ToPropertyKey hooks update inherited fields before the function read observes them exactly once" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes))
           (_ (js-call a :auto 1))
           (f (js-call a :invoke "function-value"))
           (field (js-call a :string "__function_converted"))
           (replacement (js-call a :number 23))
           (trace (js-call a :sourceArray (js-array)))
           (out (js-call a :invoke "convert-install" (js-array f field replacement trace))))
      (js-call assert :equal (js-call a :readNumber out) 23)
      (js-call assert :deepEqual (read a trace) (js-array "string"))
      (let* ((property "__function_converted")
             (saved (Object/getOwnPropertyDescriptor globalThis.Object.prototype property))
             (expectedTrace (js-array))
             (expected undefined))
        (try
          (setq expected (js-call js :convert_install (lambda () 0) property 23 expectedTrace))
          (finally
            (if saved
              (Object/defineProperty globalThis.Object.prototype property saved)
              (Reflect/deleteProperty globalThis.Object.prototype property))))
        (js-call assert :equal (js-call a :readNumber out) expected)
        (js-call assert :deepEqual (read a trace) expectedTrace)
        (finish a (js-array f field replacement trace out))))))

  (test "an abrupt key conversion wins over a real inherited-read trap with caller ownership preserved" (async ()
    (let* ((original (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (signature "(defun heap-object-read-data (heap object key)")
           ;; Fault only the actual represented inherited field read, after conversion.
           ;; Installation and unrelated native metadata must retain their normal path.
           (modified (js-call original :replace signature
                       (str signature " (when (and (> object 3) (= (load-u32 (heap-block heap object)) 13) (/= (word-and (load-u32 (+ (heap-block heap object) 24)) 4096) 0) (= (heap-key-is heap key 7 6881389 7536755 7209065 103 0 0 0 0 0 0) 1) (= (load-u32 64) 0)) (store-u32 64 1) (load-u32 4294967295))"))))
      (js-call assert :notEqual modified original)
      (let* ((trap (js-call (get b :compiler) :compile_ir_string modified "function-inherited-trap.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p trap))))
             (_ (js-call a :auto 1))
             (f (js-call a :invoke "function-value"))
             (key (js-call a :string "missing"))
             (trace (js-call a :sourceArray (js-array)))
             (held (js-call a :number -0.0))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 held)
        (let ((set-res (js-call a :invoke "install" (js-array key t))))
          (js-call a :release set-res))
        (js-call assert :equal (js-call a :invoke "abrupt" (js-array f trace)) t)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call assert :throws
          (lambda () (js-call a :invoke "member" (js-array f key)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (assert (Object/is (js-call a :readNumber held) -0.0))
        (js-call assert :equal (js-call a :invoke "member" (js-array f key)) t)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call a :leaveFrame frame)
        (finish a (js-array f key trace held)))))))
