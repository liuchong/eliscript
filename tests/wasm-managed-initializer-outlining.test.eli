(module tests.wasm-managed-initializer-outlining.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile mkdir rm)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/shared-realm-initialization.mjs"
    sharedRealmDeclarations assertSharedRealmOutlining exerciseSharedRealm)
  (import "./helpers/cold-array-contract.mjs" checkColdArray)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar runtime nil)
  (defvar runtime-source nil)
  (defvar serial 0)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-initializer-outlining-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime-source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
      (setq runtime (js-call (get backend :compiler) :compile_ir_string runtime-source "runtime.eli")))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defconst resources
    (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 1048576 :initializeModule false))
  (defconst part-prefix "__eliscript_module_part_")

  (defun nodes (body)
    (let ((found (js-array))
          (pending (js-array body)))
      (while (> (get pending :length) 0)
        (let* ((node (js-call pending :pop))
               (children (get node :children))
               (index (- (get children :length) 1)))
          (js-call found :push node)
          (while (>= index 0)
            (js-call pending :push (aref children index))
            (setq index (- index 1)))))
      found))

  (defun lower (source &rest __host_default_arguments_1)
    (let* ((rt (aref __host_default_arguments_1 0)))
    (let* ((actual-rt (if (undefined? rt) runtime rt))
           (program (js-call (get backend :compiler) :compile_ir_string source "outlined-initializers.eli"))
           (saved (JSON/stringify program))
           (result (js-call (get backend :managed) :lower_managed_program program actual-rt)))
      (js-call assert :equal (JSON/stringify program) saved "outlining must not mutate caller-owned source IR")
      (js-call assert :equal (get (get result :descriptor) :project) undefined
        "ordinary initialization does not create an ESM project")
      result)))

  (defun emit-bytes (lowered)
    (let ((output
            (Uint8Array/from
              (js-call (get backend :wasm) :append_metadata_section
                (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed))
                "eliscript-managed-control"
                (JSON/stringify (get lowered :descriptor))))))
      (js-call assert :deepEqual
        (WebAssembly.Module/imports (new WebAssembly.Module output))
        (js-array))
      output))

  (defun instance (lowered &rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)))
    (let ((opts (if (undefined? options) (js-object) options)))
      (instantiateManagedRuntime
        (emit-bytes lowered)
        (Object/assign (js-object) resources opts)))))

  (defun read-number (a name &rest __host_default_arguments_3)
    (let* ((args (aref __host_default_arguments_3 0)))
    (let* ((actual-args (if (undefined? args) (js-array) args))
           (value (js-call a :invoke name actual-args)))
      (try
        (js-call a :readNumber value)
        (finally
          (js-call a :release value))))))

  (defun array-numbers (a value)
    (Array/from (js-object :length (js-call a :length value))
      (lambda (_unused index)
        (let ((item (js-call a :get value index)))
          (try
            (js-call a :readNumber item)
            (finally
              (js-call a :release item)))))))

  (defun finish (a &rest __host_default_arguments_4)
    (let* ((values (aref __host_default_arguments_4 0)))
    (let ((vals (if (undefined? values) (js-array) values)))
      (js-call vals :forEach (lambda (value) (js-call a :release value)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defasync linked (sources &rest __host_default_arguments_5)
    (let* ((entry (aref __host_default_arguments_5 0)))
    (let* ((actual-entry (if (undefined? entry) "main.mjs" entry))
           (id-num serial)
           (base (resolve directory (str "reference-" id-num)))
           (modules (js-array))
           (entries (Object/entries sources))
           (idx 0))
      (setq serial (+ serial 1))
      (while (< idx (get entries :length))
        (let* ((pair (aref entries idx))
               (id (aref pair 0))
               (source (aref pair 1))
               (eli-name (if (js-call id :endsWith ".mjs")
                             (str (js-call id :slice 0 (- (get id :length) 4)) ".eli")
                             id))
               (program (js-call (get backend :compiler) :compile_ir_string source eli-name))
               (filename (resolve base id)))
          (js-call modules :push (js-object :id id :program program))
          (await (mkdir (dirname filename) (js-object :recursive t)))
          (await (writeFile filename (js-call (get backend :compiler) :emit_ir_string program))))
        (setq idx (+ idx 1)))
      (let ((saved (JSON/stringify modules))
            (lowered (js-call (get backend :managed) :lower_managed_project modules actual-entry runtime)))
        (js-call assert :equal (JSON/stringify modules) saved)
        (js-call assert :equal (get (get lowered :descriptor) :project) undefined)
        (js-object
          :lowered lowered
          :reference (lambda () (funcall dyn-import (get (pathToFileURL (resolve base actual-entry)) :href))))))))

  (test "ordinary initialization outlines each source initializer once and keeps the coordinator independent of literal width and count"
    (lambda ()
      (let ((shape
              (lambda (count width)
                (let* ((decls
                         (Array/from (js-object :length count)
                           (lambda (_u index)
                             (str "(defconst value-" index " (js-array "
                                  (js-call
                                    (Array/from (js-object :length width) (lambda (_v item) (globalThis.String item)))
                                    :join " ")
                                  "))"))))
                       (source (str (js-call decls :join "\n") "\n(defun read () value-0) (export read)"))
                       (lowered (lower source))
                       (functions (get (get lowered :typed) :functions))
                       (parts (js-call functions :filter (lambda (fn) (js-call (get fn :name) :startsWith part-prefix))))
                       (coordinator (js-call functions :find (lambda (fn) (= (get fn :name) "__eliscript_module_body")))))
                  (funcall assert (globalThis.Boolean coordinator))
                  (js-call assert :equal (get parts :length) count)
                  (js-call assert :deepEqual
                    (js-call parts :map (lambda (fn) (get fn :name)))
                    (Array/from (js-object :length count) (lambda (_u index) (str part-prefix index))))
                  (let* ((targets (new globalThis.Set (js-call parts :map (lambda (fn) (get fn :index)))))
                         (calls (js-call (nodes (get coordinator :body)) :filter
                                  (lambda (node)
                                    (and (= (get node :kind) "call")
                                         (js-call targets :has (get node :value)))))))
                    (js-call assert :deepEqual
                      (js-call calls :map (lambda (node) (get node :value)))
                      (js-call parts :map (lambda (fn) (get fn :index)))
                      "only the original source order drives the calls")
                    (let ((module-init (js-call functions :find (lambda (fn) (= (get fn :name) "value-module-init")))))
                      (funcall assert (globalThis.Boolean module-init))
                      (js-call assert :equal
                        (get (js-call (nodes (get coordinator :body)) :filter
                               (lambda (node)
                                 (and (= (get node :kind) "call")
                                      (= (get node :value) (get module-init :index)))))
                             :length)
                        0
                        "the coordinator must not retain a duplicate complete initializer body")
                      (js-call parts :forEach
                        (lambda (part)
                          (js-call assert :equal
                            (get (js-call (nodes (get part :body)) :filter
                                   (lambda (node)
                                     (and (= (get node :kind) "call")
                                          (= (get node :value) (get module-init :index)))))
                                 :length)
                            1)))
                      (js-call assert :equal
                        (get (get (get lowered :descriptor) :module) :functionCount)
                        1
                        "private parts do not become source function slots")
                      (js-call assert :deepEqual
                        (js-call (get (get lowered :descriptor) :functions) :map (lambda (fn) (get fn :name)))
                        (js-array "read"))
                      (funcall assert
                        (not (js-call (get (get lowered :typed) :aliases) :some
                               (lambda (alias) (js-call (get alias :name) :startsWith part-prefix))))
                        "parts are not public exports")
                      (funcall assert
                        (js-call functions :every
                          (lambda (fn)
                            (and (not (Object/hasOwn fn "initializerParts"))
                                 (not (Object/hasOwn fn "localStorageSequence"))))))
                      (let ((max-part 0))
                        (js-call parts :forEach
                          (lambda (fn)
                            (setq max-part (Math/max max-part (get (get fn :locals) :length)))))
                        (js-object
                          :coordinatorLocals (get (get coordinator :locals) :length)
                          :partLocals max-part
                          :lowered lowered))))))))
        (let ((scalar (funcall shape 1 1))
              (wide (funcall shape 1 32))
              (many (funcall shape 48 32)))
          (js-call assert :equal (get scalar :coordinatorLocals) (get wide :coordinatorLocals))
          (js-call assert :equal (get wide :coordinatorLocals) (get many :coordinatorLocals))
          (js-call assert :equal (get wide :partLocals) (get many :partLocals)
            "the widest single initializer bounds each private local bank")
          (let ((a (instance (get many :lowered))))
            (js-call a :auto 1)
            (try
              (js-call a :initializeModule)
              (let ((value (js-call a :invoke "read")))
                (try
                  (js-call assert :deepEqual
                    (array-numbers a value)
                    (Array/from (js-object :length 32) (lambda (_u index) index)))
                  (finally
                    (js-call a :release value))))
              (finally
                (finish a)))))))
    120000)

  (test "outlined standalone initializers preserve later declarations closures source function identity negative zero and caller roots"
    (lambda ()
      (let* ((lowered
               (lower
                 (str "(defvar order 0)\n"
                      "  (defconst first (mark 1)) (defconst second (mark 2)) (mark 3)\n"
                      "  (defconst zero -0.0)\n"
                      "  (defconst pair (let ((value 0)) (js-array (lambda () (setq value (1+ value))) (lambda () value))))\n"
                      "  (defun mark (value) (setq order (+ (* order 10) value)))\n"
                      "  (defun current () (js-array first second order zero))\n"
                      "  (defun advance () (funcall (get pair 0))) (defun captured () (funcall (get pair 1)))\n"
                      "  (defun identity () mark) (export mark current advance captured identity)")))
             (a (instance lowered))
             (_ (js-call a :auto 1))
             (held (js-call a :number -0.0))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 held)
        (try
          (js-call a :initializeModule)
          (js-call a :initializeModule)
          (let ((values (js-call a :invoke "current"))
                (expected (js-array 1 12 123 -0.0)))
            (try
              (js-call assert :deepEqual (array-numbers a values) expected)
              (finally
                (js-call a :release values))))
          (let ((direct (js-call a :getExport "mark"))
                (indirect (js-call a :invoke "identity")))
            (try
              (funcall assert (js-call a :keyEqual direct indirect))
              (finally
                (js-call a :release direct)
                (js-call a :release indirect))))
          (let ((index 1))
            (while (<= index 12)
              (js-call assert :equal (read-number a "advance") index)
              (js-call a :collect)
              (js-call assert :equal (read-number a "captured") index)
              (js-call a :initializeModule)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (funcall assert (Object/is (js-call a :readNumber held) -0.0))
              (setq index (+ index 1))))
          (let ((saved (js-call a :frameGet caller 0)))
            (try
              (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
              (finally
                (js-call a :release saved))))
          (finally
            (js-call a :leaveFrame caller)
            (finish a (js-array held)))))))

  (test "outlined linked modules retain diamond source order live namespaces and shared function identity without host imports"
    (async ()
      (let* ((p (await (linked
                         (js-object
                           "main.mjs" "(import \"./left.mjs\" left) (import \"./right.mjs\" right) (import \"./state.mjs\" :as state) (import \"./state.mjs\" :as again) (state/mark 3) (defun sum () (+ left right)) (defun advance () (state/mark 4)) (defun identity () (= (get state :mark) (get again :mark))) (export state again sum advance identity)"
                           "right.mjs" "(import \"./state.mjs\" mark) (mark 2) (defconst right 22) (export right)"
                           "left.mjs" "(import \"./state.mjs\" mark) (mark 1) (defconst left 11) (export left)"
                           "state.mjs" "(defvar order 0) (defun mark (value) (setq order (+ (* order 10) value))) (export order mark)"))))
             (reference (await (js-call p :reference)))
             (a (instance (get p :lowered))))
        (js-call a :auto 1)
        (try
          (js-call a :initializeModule)
          (js-call a :initializeModule)
          (js-call assert :equal (read-number a "sum") (js-call reference :sum))
          (js-call assert :equal (js-call a :invoke "identity") t)
          (let ((state (js-call a :getExport "state"))
                (again (js-call a :getExport "again"))
                (key (js-call a :string "order")))
            (try
              (funcall assert (js-call a :keyEqual state again))
              (let ((before (js-call a :objectGet state key)))
                (try
                  (js-call assert :equal (js-call a :readNumber before) 123)
                  (finally
                    (js-call a :release before))))
              (js-call assert :equal (read-number a "advance") (js-call reference :advance))
              (js-call a :collect)
              (js-call a :initializeModule)
              (let ((after (js-call a :objectGet again key)))
                (try
                  (js-call assert :equal (js-call a :readNumber after) (get (get reference :state) :order))
                  (finally
                    (js-call a :release after))))
              (finally
                (js-call a :release state)
                (js-call a :release again)
                (js-call a :release key))))
          (finally
            (finish a))))))

  (test "outlined cyclic modules retain hoisted functions while early lexical reads fail and remain cached"
    (async ()
      (let* ((success
               (await (linked
                        (js-object
                          "main.mjs" "(import \"./other.mjs\" read-other) (defconst value (+ (read-other) 1)) (defun read () value) (export read)"
                          "other.mjs" "(import \"./main.mjs\" read) (defconst value 7) (defun read-other () value) (export read-other)"))))
             (reference (await (js-call success :reference)))
             (a (instance (get success :lowered))))
        (js-call a :auto 1)
        (try
          (js-call a :initializeModule)
          (js-call assert :equal (read-number a "read") (js-call reference :read))
          (finally
            (finish a))))
      (let ((failure
              (await (linked
                       (js-object
                         "main.mjs" "(import \"./other.mjs\" other) (defconst value other) (defun read () value) (export read)"
                         "other.mjs" "(import \"./main.mjs\" read) (defconst other (read)) (export other)")))))
        (await (js-call assert :rejects (js-call failure :reference) globalThis.ReferenceError))
        (let* ((failed (instance (get failure :lowered)))
               (_ (js-call failed :auto 1))
               (keep (js-call failed :number -0.0))
               (frame (js-call failed :frame 1)))
          (js-call failed :frameSet frame 0 keep)
          (try
            (let ((round 0))
              (while (< round 3)
                (js-call assert :throws
                  (lambda () (js-call failed :initializeModule))
                  (lambda (error)
                    (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
                      (= (if diag (get diag :code) undefined) "ELI-RT0008"))))
                (js-call failed :collect)
                (js-call assert :equal (get (js-call failed :stats) :frameDepth) 1)
                (js-call assert :equal (js-call failed :live) 2)
                (funcall assert (Object/is (js-call failed :readNumber keep) -0.0))
                (setq round (+ round 1))))
            (finally
              (js-call failed :leaveFrame frame)
              (finish failed (js-array keep))))))))

  (test "an outlined failure stops subsequent initializer calls and repeated initialization preserves the original thrown source value"
    (lambda ()
      (let* ((lowered
               (lower "(defconst before (js-array 1 2)) (defconst failed (throw \"first failure\")) (defconst after (false)) (export before)"))
             (later
               (js-call (get (get lowered :typed) :functions) :find
                 (lambda (fn) (= (get fn :name) (str part-prefix "2"))))))
        (funcall assert (globalThis.Boolean later))
        (put later :body
          (js-object
            :kind "memory-op"
            :type "u32"
            :value "load-u32"
            :children (js-array (js-object :kind "literal" :type "u32" :value 4294967295 :children (js-array)))))
        (let* ((a (instance lowered))
               (_ (js-call a :auto 1))
               (keep (js-call a :number -0.0))
               (frame (js-call a :frame 1))
               (failures (js-array)))
          (js-call a :frameSet frame 0 keep)
          (try
            (let ((round 0))
              (while (< round 3)
                (let ((threw false))
                  (try
                    (js-call a :initializeModule)
                    (catch error
                      (setq threw t)
                      (js-call failures :push error)
                      (js-call assert :equal (js-call a :readString error) "first failure")))
                  (funcall assert threw)
                  (when (> round 0)
                    (funcall assert (js-call a :keyEqual (aref failures 0) (aref failures round))))
                  (js-call a :collect)
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                  (funcall assert (Object/is (js-call a :readNumber keep) -0.0)))
                (setq round (+ round 1))))
            (finally
              (js-call a :leaveFrame frame)
              (finish a (js-call (js-array keep) :concat failures))))))))

  (test "capacity failure inside an outlined initializer discards partial globals without retaining roots or reentering later parts"
    (lambda ()
      (let* ((lowered
               (lower "(defconst before (js-array 1 2)) (defconst oversized (js-call \"x\" :repeat 100000)) (defconst after 9) (export before after)"))
             (a (instance lowered (js-object :maxSlots 128 :initialBytes 4096 :maxBytes 16384)))
             (_ (js-call a :auto 1))
             (keep (js-call a :number -0.0))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 keep)
        (try
          (let ((round 0))
            (while (< round 3)
              (js-call assert :throws
                (lambda () (js-call a :initializeModule))
                (lambda (error)
                  (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
                    (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
              (js-call a :collect)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (js-call assert :equal (js-call a :live) 2)
              (funcall assert (Object/is (js-call a :readNumber keep) -0.0))
              (setq round (+ round 1))))
          (js-call assert :throws
            (lambda () (js-call a :getExport "after"))
            (lambda (error)
              (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
                (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
          (finally
            (js-call a :leaveFrame frame)
            (finish a (js-array keep)))))))

  (defconst cold-array-source
    (str "(defconst marker 1) (defconst spare 2)\n"
      " (defun cold-host (array)\n"
      "  (let* ((method (get array (js* \"Symbol.iterator\"))) (iterator (js-call method :call array))\n"
      "         (first (js-call iterator :next)) (second (js-call iterator :next)) (last (js-call iterator :next)))\n"
      "   (js-array (get first :value) (get first :done) (get second :value) (get second :done) (get last :done))))\n"
      " (defun cold-literal () (cold-host (js-array -0.0 7)))\n"
      " (defun cold-own () (let* ((array (js-array)) (replacement (lambda () 9)))\n"
      "  (put array (js* \"Symbol.iterator\") replacement) (eq (get array (js* \"Symbol.iterator\")) replacement)))\n"
      " (defun cold-own-delete () (let* ((array (js-array -0.0 7)) (replacement (lambda () 9)))\n"
      "  (put array (js* \"Symbol.iterator\") replacement)\n"
      "  (let ((same (eq (get array (js* \"Symbol.iterator\")) replacement)))\n"
      "   (Reflect/deleteProperty array (js* \"Symbol.iterator\")) (js-array same (cold-host array)))))\n"
      " (defun cold-null () (let ((array (js-array)))\n"
      "  (Object/setPrototypeOf array nil) (js-array (get array (js* \"Symbol.iterator\")) (get array :map))))\n"
      " (defun cold-custom () (let ((array (js-array)) (prototype (js-object)))\n"
      "  (put prototype (js* \"Symbol.iterator\") 9) (Object/setPrototypeOf array prototype)\n"
      "  (js-array (get array (js* \"Symbol.iterator\")) (get array :map))))\n"
      " (defun cold-delete () (let* ((array (js-array)) (method (get array (js* \"Symbol.iterator\")))\n"
      "  (prototype (Object/getPrototypeOf array)) (descriptor (Object/getOwnPropertyDescriptor prototype (js* \"Symbol.iterator\"))))\n"
      "  (try (Reflect/deleteProperty prototype (js* \"Symbol.iterator\"))\n"
      "   (js-array (eq (get array (js* \"Symbol.iterator\")) undefined) (eq (get prototype (js* \"Symbol.iterator\")) undefined))\n"
      "   (finally (Object/defineProperty prototype (js* \"Symbol.iterator\") descriptor)))))\n"
      " (defun cold-key-error (trace) (let* ((array (js-array))\n"
      "  (key (js-object :toString (lambda () (put trace 0 1) (throw false)))))\n"
      "  (get array key) (put trace 0 2)))\n"
      " (defun cold-key-primitive-error (trace) (let ((array (js-array)) (key (js-object)))\n"
      "  (put key (js* \"Symbol.toPrimitive\") (lambda () (put trace 0 1) (throw false)))\n"
      "  (get array key) (put trace 0 2)))\n"
      " (defun cold-boxed (value brand object-first)\n"
      "  (let ((method (get (js-array) :slice)) (copied nil) (boxed nil))\n"
      "   (if object-first\n"
      "    (progn (setq boxed (funcall globalThis/Object value)) (setq copied (js-call method :call value)))\n"
      "    (progn (setq copied (js-call method :call value)) (setq boxed (funcall globalThis/Object value))))\n"
      "   (let ((constructor (cond ((= brand 0) globalThis/Number) ((= brand 1) globalThis/String)\n"
      "      ((= brand 2) globalThis/Boolean) ((= brand 3) globalThis/Symbol) (t globalThis/BigInt))))\n"
      "    (js-array (js-length copied) (Object/is (get boxed :constructor) constructor)\n"
      "     (Object/is (Object/getPrototypeOf boxed) (get constructor :prototype))\n"
      "     (Object/is (get boxed :valueOf) (get (get constructor :prototype) :valueOf))\n"
      "     (Object/is (js-call boxed :valueOf) value)))))\n"
      " (defun cold-boxed-symbol (brand object-first)\n"
      "  (cold-boxed (funcall globalThis/Symbol \"cold\") brand object-first))\n"
      " (defun cold-boxed-length (value)\n"
      "  (get (funcall globalThis/Object value) :length))\n"
      " (defun cold-boxed-slice (value)\n"
      "  (let ((method (get (js-array) :slice)) (boxed (funcall globalThis/Object value)))\n"
      "   (js-call method :call boxed)))\n"
      " (defun cold-boxed-first (value object-first)\n"
      "  (let ((method (get (js-array) :slice)))\n"
      "   (if object-first (funcall globalThis/Object value) (js-call method :call value)) 1))\n"
      " (defun cold-boxed-pair (value object-first)\n"
      "  (let ((method (get (js-array) :slice)) (copied nil) (boxed nil))\n"
      "   (if object-first\n"
      "    (progn (setq boxed (funcall globalThis/Object value)) (setq copied (js-call method :call value)))\n"
      "    (progn (setq copied (js-call method :call value)) (setq boxed (funcall globalThis/Object value)))) 2))\n"
      " (defun cold-boxed-proto (value brand object-first)\n"
      "  (let ((method (get (js-array) :slice)) (copied nil) (boxed nil))\n"
      "   (if object-first\n"
      "    (progn (setq boxed (funcall globalThis/Object value)) (setq copied (js-call method :call value)))\n"
      "    (progn (setq copied (js-call method :call value)) (setq boxed (funcall globalThis/Object value))))\n"
      "   (let ((constructor (cond ((= brand 0) globalThis/Number) ((= brand 1) globalThis/String)\n"
      "      ((= brand 2) globalThis/Boolean) ((= brand 3) globalThis/Symbol) (t globalThis/BigInt))))\n"
      "    (js-array (js-length copied) (Object/is (get boxed :constructor) constructor)\n"
      "     (Object/is (Object/getPrototypeOf boxed) (get constructor :prototype))))))\n"
      " (defun cold-boxed-valueof-read (value brand object-first)\n"
      "  (let ((method (get (js-array) :slice)) (copied nil) (boxed nil))\n"
      "   (if object-first\n"
      "    (progn (setq boxed (funcall globalThis/Object value)) (setq copied (js-call method :call value)))\n"
      "    (progn (setq copied (js-call method :call value)) (setq boxed (funcall globalThis/Object value))))\n"
      "   (let ((constructor (cond ((= brand 0) globalThis/Number) ((= brand 1) globalThis/String)\n"
      "      ((= brand 2) globalThis/Boolean) ((= brand 3) globalThis/Symbol) (t globalThis/BigInt))))\n"
      "    (js-array (js-length copied) (Object/is (get boxed :constructor) constructor)\n"
      "     (Object/is (Object/getPrototypeOf boxed) (get constructor :prototype))\n"
      "     (Object/is (get boxed :valueOf) (get (get constructor :prototype) :valueOf))))))\n"
      " (defun cold-boxed-symbol-stage (brand object-first stage)\n"
      "  (let ((value (funcall globalThis/Symbol \"cold\")))\n"
      "   (cond ((= stage 0) (cold-boxed-first value object-first))\n"
      "    ((= stage 1) (cold-boxed-pair value object-first))\n"
      "    ((= stage 2) (cold-boxed-proto value brand object-first))\n"
      "    (t (cold-boxed-valueof-read value brand object-first)))))\n"
      " (defun cold-recover (value) (+ value marker))\n"
      " (defun argv-lifetime (value)\n"
      "  (let* ((identity (lambda (entry) entry))\n"
      "         (capture (funcall (lambda (entry) (lambda () entry)) value))\n"
      "         (rest (funcall (lambda (&rest entries) entries) value))\n"
      "         (applied (js-call identity :apply nil (js-array value)))\n"
      "         (caught (try (funcall (lambda (entry) (throw false)) value)\n"
      "                   (catch failure (if (eq failure false) value (throw failure))))))\n"
      "   (js-array (eq (funcall identity value) value) (eq (funcall capture) value)\n"
      "     (eq (aref rest 0) value) (eq applied value) (eq caught value))))\n"
      " (export cold-host cold-literal cold-own cold-own-delete cold-null cold-custom cold-delete cold-key-error cold-key-primitive-error cold-boxed cold-boxed-symbol cold-boxed-length cold-boxed-slice cold-boxed-first cold-boxed-pair cold-boxed-proto cold-boxed-valueof-read cold-boxed-symbol-stage cold-recover argv-lifetime)"))

  (test "cold literal and host Arrays acquire native methods lazily and preserve overrides chains deletion and key conversion errors"
    (async ()
      (let* ((lowered (lower cold-array-source))
             (image (emit-bytes lowered))
             (original (js-call (get backend :compiler) :compile_ir_string cold-array-source "cold-array-reference.eli"))
             (reference
               (await (funcall dyn-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string original)) :toString "base64"))))))
        (js-call assert :deepEqual (js-call reference :cold_literal) (js-array -0.0 false 7 false t))
        (let* ((boxed
                 (js-call (js-array "number" "string" "boolean" "symbol" "bigint") :flatMap
                   (lambda (brand)
                     (js-call (js-array "array" "object") :flatMap
                       (lambda (first)
                         (let* ((name (str "cold-boxed-" brand "-" first))
                                (phases
                                  (js-call (js-array "first" "pair" "proto" "valueof-read") :concat
                                    (if (= brand "bigint") (js-array "length" "slice") (js-array)))))
                           (js-call (js-call phases :map (lambda (phase) (str name ":" phase))) :concat name)))))))
               (all-names
                 (js-call
                   (js-array "cold-literal" "cold-host" "cold-own" "cold-own-delete" "cold-null" "cold-custom" "cold-delete" "argv-lifetime")
                   :concat boxed
                   (js-array "cold-key-primitive-error" "cold-key-error")))
               (failures (js-array))
               (failed-cases (js-array)))
          (js-call all-names :forEach
            (lambda (name)
              (let* ((small? (js-call (js-array "cold-own" "cold-key-error" "cold-key-primitive-error") :includes name))
                     (configuration
                       (if small?
                           (Object/assign (js-object) resources (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 16384))
                           (Object/assign (js-object) resources (js-object :maxSlots 1024 :initialBytes 65536))))
                     (a (instantiateManagedRuntime image configuration)))
                (try
                  (checkColdArray a reference name)
                  (catch error
                    (js-call failures :push error)
                    (js-call failed-cases :push name))
                  (finally
                    (finish a))))))
          (when (> (get failures :length) 0)
            (throw (new globalThis.AggregateError failures (str "cold Array failures: " (js-call failed-cases :join ", ")))))))))

  (test "an actual trap inside an outlined initializer unwinds its private frames and retains the caller negative zero"
    (lambda ()
      (let* ((start (js-call runtime-source :indexOf "  (defun value-module-init (heap index value)"))
             (end (js-call runtime-source :indexOf "  (defun " (+ start 10))))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((faulty
                 (str (js-call runtime-source :slice 0 start)
                      "  (defun value-module-init (heap index value) (load-u32 4294967295))\n"
                      (js-call runtime-source :slice end)))
               (rt (js-call (get backend :compiler) :compile_ir_string faulty "outlined-trap-runtime.eli"))
               (a (instance (lower "(defconst first (js-array 1 2)) (defconst second 7) (export first second)" rt)))
               (_ (js-call a :auto 1))
               (keep (js-call a :number -0.0))
               (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 keep)
          (try
            (js-call assert :throws (lambda () (js-call a :initializeModule)) globalThis.WebAssembly.RuntimeError)
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :equal (js-call a :live) 2)
            (let ((saved (js-call a :frameGet frame 0)))
              (try
                (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
                (finally
                  (js-call a :release saved))))
            (js-call assert :throws
              (lambda () (js-call a :initializeModule))
              (lambda (error)
                (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
                  (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
            (finally
              (js-call a :leaveFrame frame)
              (finish a (js-array keep))))))))

  (defun assert-array-registration-advances ()
    (let* ((declarations (js-call (get runtime :body) :flatMap (lambda (node) (nodes node))))
           (register
             (js-call declarations :find
               (lambda (node)
                 (and (= (get node :kind) "function-declaration")
                      (= (get node :value) "value-array-prototype-register"))))))
      (funcall assert (globalThis.Boolean register) "the actual compiled runtime must contain Array prototype registration")
      (let* ((body (nodes register))
             (updates
               (js-call body :filter
                 (lambda (node)
                   (and (= (get node :kind) "assignment-pair")
                        (= (get node :value) "index")))))
             (loops
               (js-call body :filter
                 (lambda (node)
                   (and (= (get node :kind) "loop")
                        (let ((cond-nodes (nodes (aref (get node :children) 0))))
                          (and (js-call cond-nodes :some
                                 (lambda (child)
                                   (and (= (get child :kind) "reference")
                                        (= (get child :value) "index"))))
                               (js-call cond-nodes :some
                                 (lambda (child)
                                   (and (= (get child :kind) "literal")
                                        (= (get child :value) 27)))))))))))
        (js-call assert :equal (get updates :length) 1 "registration has one advancement of its method index")
        (js-call assert :equal (get loops :length) 1 "registration iterates over the actual 27-method table")
        (funcall assert
          (js-call (js-call (get (aref loops 0) :children) :slice 1) :some
            (lambda (child) (js-call (nodes child) :includes (aref updates 0))))
          "the method index assignment must execute inside the registration loop body, before its backedge"))))

  (test "the actual runtime IR advances Array prototype registration inside its genuine loop body"
    (lambda ()
      (assert-array-registration-advances)))

  (test "a top-level Array constructor acquisition completes all 27 registrations and preserves descriptors symbols cache identity and GC roots"
    (async ()
      (assert-array-registration-advances)
      (let* ((methods
               (js-array
                 (js-array "push" 1) (js-array "pop" 0) (js-array "slice" 2) (js-array "map" 1)
                 (js-array "filter" 1) (js-array "forEach" 1) (js-array "some" 1) (js-array "every" 1)
                 (js-array "find" 1) (js-array "findIndex" 1) (js-array "findLast" 1) (js-array "findLastIndex" 1)
                 (js-array "reduce" 1) (js-array "reduceRight" 1) (js-array "sort" 1) (js-array "toSorted" 1)
                 (js-array "splice" 2) (js-array "join" 1) (js-array "toString" 0) (js-array "concat" 1)
                 (js-array "includes" 1) (js-array "indexOf" 1) (js-array "lastIndexOf" 1)
                 (js-array "entries" 0) (js-array "keys" 0) (js-array "values" 0) (js-array "at" 1)))
             (rows
               (js-call
                 (js-call methods :map
                   (lambda (pair)
                     (let ((qname (JSON/stringify (aref pair 0))))
                       (str "(let* ((method (get array-prototype " qname "))\n"
                            "    (descriptor (Object/getOwnPropertyDescriptor array-prototype " qname ")))\n"
                            "   (js-array (value-type method) (get method :name) (get method :length)\n"
                            "    (Object/is method (get descriptor :value)) (get descriptor :writable)\n"
                            "    (get descriptor :enumerable) (get descriptor :configurable)))"))))
                 :join "\n"))
             (source
               (str "(defconst array-constructor globalThis/Array)\n"
                    "  (defconst array-prototype (get array-constructor :prototype))\n"
                    "  (defconst original-map (get array-prototype :map))\n"
                    "  (defconst original-values (get array-prototype :values))\n"
                    "  (defconst iterator-symbol (get globalThis/Symbol :iterator))\n"
                    "  (defun methods () (JSON/stringify (js-array " rows ")))\n"
                    "  (defun relationships ()\n"
                    "   (let ((constructor-descriptor (Object/getOwnPropertyDescriptor array-prototype \"constructor\"))\n"
                    "         (iterator-descriptor (Object/getOwnPropertyDescriptor array-prototype iterator-symbol)))\n"
                    "    (JSON/stringify (js-array\n"
                    "     (Object/is array-constructor globalThis/Array)\n"
                    "     (Object/is array-prototype (get globalThis/Array :prototype))\n"
                    "     (Object/is (get array-prototype :constructor) array-constructor)\n"
                    "     (Object/is (get array-prototype iterator-symbol) original-values)\n"
                    "     (Object/is (get array-prototype :map) original-map)\n"
                    "     (get constructor-descriptor :writable) (get constructor-descriptor :enumerable) (get constructor-descriptor :configurable)\n"
                    "     (get iterator-descriptor :writable) (get iterator-descriptor :enumerable) (get iterator-descriptor :configurable)))))\n"
                    "  (defun cached-registration ()\n"
                    "   (let ((replacement (lambda () 9)))\n"
                    "    (try (put array-prototype :map replacement)\n"
                    "     (let ((again (get globalThis/Array :prototype)))\n"
                    "      (JSON/stringify (js-array (Object/is again array-prototype)\n"
                    "       (Object/is (get again :map) replacement) (Object/is (get again :values) original-values))))\n"
                    "     (finally (put array-prototype :map original-map)))))\n"
                    "  (defun borrowed ()\n"
                    "   (let ((items (funcall array-constructor -0.0 9)))\n"
                    "    (js-call (get array-prototype :push) :call items 7)\n"
                    "    (JSON/stringify (js-array\n"
                    "     (Object/is (js-call (get array-prototype :pop) :call items) 7)\n"
                    "     (Object/is (get items 0) -0.0)))))\n"
                    "  " sharedRealmDeclarations "\n"
                    "  (export methods relationships cached-registration borrowed realm-read realm-shared-observation realm-clean realm-first-error)"))
             (lowered (lower source))
             (_ (assertSharedRealmOutlining lowered))
             (original (js-call (get backend :compiler) :compile_ir_string source "shared-realm-reference.eli"))
             (reference
               (await (funcall dyn-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string original)) :toString "base64")))))
             (a (instance lowered))
             (_2 (js-call a :auto 1))
             (keep (js-call a :number -0.0))
             (frame (js-call a :frame 1))
             (report
               (lambda (name)
                 (let ((result (js-call a :invoke name)))
                   (try
                     (JSON/parse (js-call a :readString result))
                     (finally
                       (js-call a :release result)))))))
        (js-call a :frameSet frame 0 keep)
        (try
          (js-call a :initializeModule)
          (let ((round 0))
            (while (< round 3)
              (js-call assert :deepEqual
                (funcall report "methods")
                (js-call methods :map
                  (lambda (pair) (js-array "function" (aref pair 0) (aref pair 1) t t false t))))
              (js-call assert :deepEqual
                (funcall report "relationships")
                (js-array t t t t t t false t t false t))
              (js-call assert :deepEqual (funcall report "cached-registration") (js-array t t t))
              (js-call assert :deepEqual (funcall report "borrowed") (js-array t t))
              (js-call a :collect)
              (js-call a :initializeModule)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (funcall assert (Object/is (js-call a :readNumber keep) -0.0))
              (setq round (+ round 1))))
          (exerciseSharedRealm a reference)
          (finally
            (js-call a :leaveFrame frame)
            (finish a (js-array keep))))))))
