(module tests.compiler-locate
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (defconst compilerSources (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))

  (import "../tools/compiler/locate-benchmark.mjs" compilerLocateSourceDigest validateCompilerLocateReport)
  (defconst reportPath (resolve projectDirectory "benchmarks/compiler-locate-macos-arm64.json"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (defun artifactFragments (artifact)
    (let ((fragments (js-array)) (blockStart 0) (text (get artifact :text)))
      (while (< blockStart (get text :length))
        (let* ((separator (js-call text :indexOf "\n\n" blockStart)) (blockEnd (if (= separator -1) (get text :length) separator)))
          (when (> blockEnd blockStart)
            (js-call fragments :push (js-object :text (js-call text :slice blockStart blockEnd)
              :marks (js-call (js-call (get artifact :marks) :filter (lambda (mark) (and (>= (get mark :offset) blockStart) (< (get mark :offset) blockEnd)))) :map
                (lambda (mark) (js-object :offset (- (get mark :offset) blockStart) :span (get mark :span)))))))
          (if (= separator -1) (setq blockStart (get text :length)) (setq blockStart (+ blockEnd 2)))))
      fragments))
  (test "ordered compiler mark location matches its scan and copy reference" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-locate-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((modules (await (Promise/all (js-array (loadModule directory "compiler" "locate") (loadModule directory "emitter" "locate")))))
               (compiler (aref modules 0)) (emitter (aref modules 1)) (cases 0) (index 0))
          (while (< index (js-length compilerSources))
            (let* ((relative (str "bootstrap/compiler/" (aref compilerSources index) ".eli")) (source (await (readFile (resolve projectDirectory relative) "utf8")))
                   (program (js-call compiler :compile_ir_string source relative)) (node (aref (get program :body) 0))
                   (previousCases cases) (fragments (artifactFragments (js-call emitter :emit_module_artifact program))) (fragmentIndex 0))
              (while (< fragmentIndex (js-length fragments))
                (let ((fragment (aref fragments fragmentIndex)))
                  (same (js-call emitter :locate node fragment) (js-call emitter :reference_locate node fragment)) (setq cases (1+ cases))
                  (when (and (> (get (get fragment :text) :length) 1) (> (get (get fragment :marks) :length) 1))
                    (let ((shifted (js-object :text (js-call (get fragment :text) :slice 1)
                      :marks (js-call (js-call (get fragment :marks) :filter (lambda (mark) (>= (get mark :offset) 1))) :map
                        (lambda (mark) (js-object :offset (1- (get mark :offset)) :span (get mark :span)))))))
                      (same (js-call emitter :locate node shifted) (js-call emitter :reference_locate node shifted)) (setq cases (1+ cases)))))
                (setq fragmentIndex (1+ fragmentIndex)))
              (js-call (expect (- cases previousCases)) :toBeGreaterThanOrEqual 3))
            (setq index (1+ index)))
          (js-call (expect cases) :toBeGreaterThanOrEqual (* (js-length compilerSources) 3))
          (let ((node (js-object :span "parent")) (empty (js-object :text "" :marks (js-array)))
                (located (js-object :text "x" :marks (js-array (js-object :offset 0 :span "child")))) (noSpan (js-object :span nil)))
            (be (js-call emitter :locate node empty) empty) (be (js-call emitter :locate node located) located) (be (js-call emitter :locate noSpan located) located)
            (let* ((marks (js-array (js-object :offset 2 :span "child-one") (js-object :offset 2 :span "child-two") (js-object :offset 4 :span "child-three")))
                   (fragment (js-object :text "value" :marks marks)) (result (js-call emitter :locate node fragment)))
              (js-call (get (expect result) :not) :toBe fragment) (be (get result :text) (get fragment :text))
              (js-call (get (expect (get result :marks)) :not) :toBe marks)
              (same (get result :marks) (js-call (js-array (js-object :offset 0 :span "parent")) :concat marks))
              (be (get fragment :marks) marks) (js-call (expect marks) :toHaveLength 3)
              (be (js-call emitter :locate (js-object :span nil) fragment) fragment)
              (be (js-call emitter :locate (js-object :span undefined) fragment) fragment)
              (be (js-call emitter :locate (js-object :span false) fragment) fragment))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "committed compiler location report preserves historical measurements and decisions" (async ()
    (let ((report (validateCompilerLocateReport (await (readReport)))))
      (js-call (expect (get (get report :corpus) :files)) :toHaveLength (js-length compilerSources))
      (js-call (expect (get (get report :corpus) :sourceBytes)) :toBeGreaterThan 200000)
      (be (get (get report :corpus) :artifactFragments) (* (js-length compilerSources) 2))
      (be (get (get report :corpus) :shiftedCases) (js-length compilerSources))
      (be (get (get report :corpus) :cases) (* (js-length compilerSources) 3))
      (js-call (expect (get (get report :corpus) :marks)) :toBeGreaterThan 30000)
      (js-call (expect (get (get report :measurements) :speedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumSpeedup)))))
  (test "failed locate gates retain complete measurement evidence" (async ()
    (let ((report (await (readReport))) (failure undefined))
      (put (get report :decision) :passed false)
      (try (validateCompilerLocateReport report) (catch error (setq failure error)))
      (js-call (expect failure) :toBeInstanceOf globalThis.TypeError) (be (get failure :report) report))))
  (funcall (currentPerformanceTest test) "committed compiler location report matches measured sources" (async ()
    (same (get (await (readReport)) :sourceDigest) (await (compilerLocateSourceDigest)))))
)
