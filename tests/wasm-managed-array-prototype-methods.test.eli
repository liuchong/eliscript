(module tests.wasm-managed-array-prototype-methods
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-heap-diagnostic.mjs" invokeWithHeapDiagnostic)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst methods
    (js-array "push" "pop" "slice" "map" "filter" "forEach" "some" "every"
              "find" "findIndex" "findLast" "findLastIndex" "reduce" "reduceRight"
              "sort" "toSorted" "join" "toString" "concat" "includes" "indexOf"
              "lastIndexOf" "keys" "values" "entries"))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar bytes undefined)
  (defvar reference undefined)
  (defvar source undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-array-methods-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string
                    (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq source
      (str
        "(defun replacement (trace label) (lambda (&rest args) (put trace :n (str (aref trace \"n\") \":\" label)) (js-array label (js-length args) (JSON/stringify args))))\n"
        (js-call
          (js-call methods :map
            (lambda (name)
              (str
                "(defun test-" name " (mode)\n"
                "  (let ((prototype (if (= mode 9) nil globalThis.Array.prototype)) (root globalThis.Object.prototype) (value (js-array 1 2)) (trace (js-object :n \"\")) (marker (js-object :tag \"marker\")))\n"
                "   (cond ((or (= mode 7) (= mode 9)) (put root \"" name "\" (replacement trace \"object\")))\n"
                "    ((= mode 1) (put prototype \"" name "\" false) (put value \"" name "\" (replacement trace \"own\")))\n"
                "    ((= mode 2) (put prototype \"" name "\" nil)) ((= mode 3) (put prototype \"" name "\" undefined))\n"
                "    ((= mode 4) (put prototype \"" name "\" false)) ((= mode 5) (put prototype \"" name "\" 42))\n"
                "    (t (put prototype \"" name "\" (replacement trace \"prototype\"))))\n"
                "   (let ((out (try (js-call value :" name "\n"
                "     (progn (put trace :n (str (aref trace \"n\") \"1\"))\n"
                "      (cond ((= mode 6) (put prototype \"" name "\" (replacement trace \"late\")))\n"
                "       ((= mode 8) (throw false)) ((= mode 10) (throw undefined)) ((= mode 11) (throw marker))) 11)\n"
                "     (progn (put trace :n (str (aref trace \"n\") \"2\")) 22)\n"
                "     (progn (put trace :n (str (aref trace \"n\") \"3\")) 33))\n"
                "    (catch error (cond ((Object/is error marker) \"thrown-object\") ((= error false) \"thrown-false\") ((undefined? error) \"thrown-undefined\") (t (aref error \"name\")))))))\n"
                "    (JSON/stringify (js-array (aref trace \"n\") out value)))))")))
          :join "\n")
        "\n(defun native () (aref globalThis.Array.prototype \"push\"))\n"
        "(defun recover () (+ 1 2))\n"
        "(export native recover " (js-call (js-call methods :map (lambda (name) (str "test-" name))) :join " ") ")"))
    (setq program (js-call (get backend :compiler) :compile_ir_string source "array-prototype-methods.eli"))
    (let* ((saved (JSON/stringify program))
           (javascript (js-call (get backend :compiler) :emit_ir_string program)))
      (setq reference (await (funcall dynamic-import
                               (str "data:text/javascript;base64,"
                                    (js-call (Buffer/from javascript) :toString "base64")))))
      (await (writeFile (resolve directory "reference.mjs") javascript))
      (setq bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtime)))
      (js-call assert :equal (JSON/stringify program) saved)
      (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun withPrototypes (fn)
    (let ((arrays (Object/getOwnPropertyDescriptors globalThis.Array.prototype))
          (objects (Object/getOwnPropertyDescriptors globalThis.Object.prototype)))
      (try (funcall fn)
        (finally
          ;; The callback deliberately replaces Array.prototype methods,
          ;; including forEach. Cleanup must not dispatch through that realm.
          (let ((pairs (js-array (js-array globalThis.Object.prototype objects)
                                  (js-array globalThis.Array.prototype arrays)))
                (pair-index 0))
            (while (< pair-index 2)
              (let* ((pair (aref pairs pair-index)) (prototype (aref pair 0))
                     (saved (aref pair 1)) (current-keys (Reflect/ownKeys prototype))
                     (saved-keys (Reflect/ownKeys saved)) (index 0))
                (while (< index (js-length current-keys))
                  (let ((key (aref current-keys index)))
                    (unless (Object/hasOwn saved key) (Reflect/deleteProperty prototype key)))
                  (setq index (1+ index)))
                (setq index 0)
                (while (< index (js-length saved-keys))
                  (let ((key (aref saved-keys index)))
                    (unless (= key "length")
                      (Object/defineProperty prototype key (get saved key))))
                  (setq index (1+ index)))
                (when (Object/hasOwn saved "length")
                  (Object/defineProperty prototype "length" (get saved :length))))
              (setq pair-index (1+ pair-index))))))))

  (defun finish (a &rest supplied)
    (let ((values (if (or (= (js-length supplied) 0) (undefined? (aref supplied 0))) (js-array) (aref supplied 0))))
      (js-call values :forEach (lambda (value) (js-call a :release value))))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))

  (js-call methods :forEach
    (lambda (name)
      (test (str "Array " name " resolves source prototype overrides, own priority, nullish callees and captured argument order")
        (lambda ()
          (let ((mode 0))
            (while (<= mode 11)
              (let* ((expected (withPrototypes (lambda () (js-call reference (str "test_" name) mode))))
                     (a (instantiateManagedRuntime bytes))
                     (_ (js-call a :auto 1))
                     (input (js-call a :number mode))
                     (out (js-call a :invoke (str "test-" name) (js-array input))))
                (js-call assert :equal (js-call a :readString out) expected (str name " mode " mode))
                (finish a (js-array input out)))
              (setq mode (1+ mode))))))))

  (test "independent Node native methods and the same zero-import bytes preserve all source Array override contracts" (async ()
    (let ((artifact (resolve directory "array-prototype-methods.wasm")))
      (await (writeFile artifact bytes))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-array-prototype-methods-node.mjs")
                               (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                               (get (pathToFileURL (resolve directory "reference.mjs")) :href)
                               artifact)
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "override dispatch capacity failure preserves caller frames and recovers without retained roots" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 256 :initialBytes 32768 :maxBytes 131072)))
           (_ (js-call a :auto 1))
           (mode (js-call a :number 6))
           (caller (js-call a :frame 1))
           (padding (js-array))
           (exhausted false))
      (js-call a :frameSet caller 0 mode)
      (try
        (let ((i 0))
          (while (< i 512)
            (js-call padding :push (js-call a :number i))
            (setq i (1+ i))))
        (catch error
          (js-call assert :equal (and error (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code)) "ELI-RT0002")
          (setq exhausted t)))
      (funcall assert exhausted)
      (js-call assert :throws
        (lambda () (js-call a :invoke "test-push" (js-array mode)))
        (lambda (error) (and error (get error :eliscriptDiagnostic) (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002"))))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (js-call padding :forEach (lambda (value) (js-call a :release value)))
      (js-call a :collect)
      (let ((out (invokeWithHeapDiagnostic a "test-push" (js-array mode))))
        (js-call assert :equal (js-call a :readString out) (withPrototypes (lambda () (js-call reference :test_push 6))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call a :leaveFrame caller)
        (finish a (js-array mode out))))))

  (test "captured prototype callee Get traps unwind private frames while a later independent source call recovers" (async ()
    (let* ((raw-source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (first (js-call raw-source :indexOf "  (defun value-array-callback-get "))
           (last (js-call raw-source :indexOf "  ;; The supported source objects" first)))
      (funcall assert (and (>= first 0) (> last first)))
      (let* ((injected (js-call (get backend :compiler) :compile_ir_string
                         (str (js-call raw-source :slice 0 first)
                              "  (defun value-array-callback-get (heap value key) (load-u32 4294967295))\n"
                              (js-call raw-source :slice last))
                         "array-method-get-trap.eli"))
             (artifact (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program injected))))
        (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module artifact)) (js-array))
        (js-call (js-array "push" "includes" "keys") :forEach
          (lambda (name)
            (let* ((a (instantiateManagedRuntime artifact))
                   (_ (js-call a :auto 1))
                   (mode (js-call a :number 0))
                   (caller (js-call a :frame 1)))
              (js-call a :frameSet caller 0 mode)
              (js-call assert :throws
                (lambda () (js-call a :invoke (str "test-" name) (js-array mode)))
                globalThis.WebAssembly.RuntimeError)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (let ((out (js-call a :invoke "recover")))
                (js-call assert :equal (js-call a :readNumber out) 3)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                (js-call a :leaveFrame caller)
                (finish a (js-array mode out))))))))))

  (test "default Array native method lookup returns a real managed callable" (lambda ()
    (let* ((a (instantiateManagedRuntime bytes))
           (_ (js-call a :auto 1))
           (method (js-call a :invoke "native")))
      (js-call assert :equal (get method :kind) 18)
      (finish a (js-array method))))))
