(module tests.persistent-semantics
  (import "bun:test" expect test)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (defconst root (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst host-truth (js* "(value) => !!value"))
  (defasync runCorpus (command &rest arguments_)
    (let* ((child (Bun/spawn (js-call (js-array command (resolve root "tools/collections/persistent-semantics.mjs")) :concat (Array/from arguments_)) (js-object :cwd root :stdout "pipe" :stderr "pipe")))
           (timedOut false) (timer (globalThis/setTimeout (lambda () (setq timedOut t) (js-call child :kill)) 300000)) (result undefined))
      (try (setq result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
        (finally (globalThis/clearTimeout timer)))
      (when timedOut (throw (new globalThis.Error "persistent semantics corpus exceeded 300000 ms")))
      (unless (= (aref result 0) 0)
        (let ((err (js-call (aref result 2) :trim)) (out (js-call (aref result 1) :trim)))
          (throw (new globalThis.Error (if (funcall host-truth err) err (if (funcall host-truth out) out (str "corpus exited with " (aref result 0))))))))
      (JSON/parse (aref result 1))))
  (test "400000 generated persistent collection sequences preserve semantics and history" (async ()
    (let* ((reports (await (Promise/all (js-array (runCorpus (get globalThis.process :execPath)) (runCorpus (get (get globalThis.process :env) :NODE_BINARY "node"))))))
           (report (aref reports 0)))
      (js-call (expect (aref reports 1)) :toEqual report)
      (js-call (expect report) :toMatchObject (js-object "schemaVersion" 1 "format" "eliscript-persistent-semantics-corpus" "version" 1 "verified" t "acceptanceEligible" t "seed" "0x50443031" "sequencesPerFamily" 100000 "updatesPerSequence" 8 "totalSequences" 400000 "totalUpdates" 3200000 "digest" "7399e57850b30051c93216d1ad85390de1ead7d86853a5c97d929f6006991bb9"))
      (js-call (expect (get report :families)) :toEqual (js-object "list" (js-object "sequences" 100000 "updates" 800000 "rejectedUpdates" 92008 "previousVersionsChecked" 3600000 "operations" (js-object "conj" 199585 "count" 800000 "size" 800000 "isEmpty" 800000 "toArray" 800000 "iterator" 800000 "first" 800000 "peek" 800000 "nth" 981679 "nth-not-found" 800000 "reduce" 800000 "cons" 199779 "pop" 200580 "rest" 200056) "digest" "d91f9122800b989707dfd75edabb2a7b69a2061d4af61d44ba33bf23aa0b7185") "vector" (js-object "sequences" 100000 "updates" 800000 "rejectedUpdates" 51611 "previousVersionsChecked" 3600000 "operations" (js-object "assoc-append" 199331 "count" 800000 "size" 800000 "toArray" 800000 "iterator" 800000 "peek" 800000 "nth" 1553719 "nth-not-found" 800000 "reduce" 800000 "assoc" 200163 "pop" 200519 "conj" 199987) "digest" "a6907f86489049e5430d4cd3f738db0a25236f81a251385d0d01c56251d5e26b") "map" (js-object "sequences" 100000 "updates" 800000 "rejectedUpdates" 0 "previousVersionsChecked" 3600000 "operations" (js-object "assoc" 533773 "count" 800000 "size" 800000 "has" 10874023 "get" 10874023 "entries" 800000 "iterator" 800000 "keys" 800000 "values" 800000 "toMap" 800000 "reduce" 800000 "dissoc" 266227) "digest" "db555364b6f8e7af72d0cb951498e189e729a273fb4224fc134e4f97b40ab911") "set" (js-object "sequences" 100000 "updates" 800000 "rejectedUpdates" 0 "previousVersionsChecked" 3600000 "operations" (js-object "union" 160199 "count" 800000 "size" 800000 "has" 13096560 "values" 800000 "keys" 800000 "iterator" 800000 "entries" 800000 "toSet" 800000 "reduce" 800000 "isSubsetOf" 800000 "isSupersetOf" 800000 "isDisjointFrom" 800000 "disj" 160186 "difference" 159763 "conj" 160029 "intersection" 159823) "digest" "7e72dc7c20e73f85daa236da70ead86f417fd7530158ce71418a70b3557e7572")))
      (js-call (Object/entries (get report :families)) :forEach (lambda (entry)
        (let ((family (aref entry 0)) (familyReport (aref entry 1)))
          (js-call (expect (get familyReport :sequences)) :toBe 100000)
          (js-call (expect (get familyReport :updates)) :toBe 800000)
          (js-call (expect (get familyReport :previousVersionsChecked)) :toBe 3600000)
          (js-call (expect (get familyReport :digest)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))
          (js-call (Object/entries (get familyReport :operations)) :forEach (lambda (operation)
            (js-call (expect (get (aref operation 0) :length)) :toBeGreaterThan 0)
            (js-call (expect (aref operation 1)) :toBeGreaterThan 0)))
          (js-call (expect (get (Object/keys (get familyReport :operations)) :length) family) :toBeGreaterThan 8)))))) 320000)
  (test "one persistent sequence can be replayed independently" (async ()
    (let* ((left (await (runCorpus (get globalThis.process :execPath) "--family" "map" "--sequence" "731" "--sequences" "1000")))
           (right (await (runCorpus (get globalThis.process :execPath) "--family" "map" "--sequence" "731" "--sequences" "1000"))))
      (js-call (expect right) :toEqual left) (js-call (expect left) :toMatchObject (js-object "verified" t "acceptanceEligible" false "sequencesPerFamily" 1000 "totalSequences" 1 "totalUpdates" 8 "families" (js-object "map" (js-object "sequences" 1 "updates" 8 "previousVersionsChecked" 36)))))))
)
