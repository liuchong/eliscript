(module tests.compiler-binary-comparison
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (defconst compilerSources (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))

  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "../tools/compiler/binary-comparison-benchmark.mjs" compilerBinaryComparisonSourceDigest validateCompilerBinaryComparisonReport)
  (defconst reportPath (resolve projectDirectory "benchmarks/compiler-binary-comparison-macos-arm64.json"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (test "binary comparison emission preserves strict argument evaluation" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-binary-comparison-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((compiler (await (loadModule directory "compiler" "comparison"))) (source "\n(defvar calls (js-array))\n(defun record (value) (progn (js-call calls :push value) value))\n(defun run ()\n  (progn\n    (put calls :length 0)\n    (let ((binary (= (record 1) (record 1)))\n          (nary (= (record 1) (record 2) (record 3))))\n      (js-object :binary binary :nary nary :calls calls))))\n(export run)")
               (javascript (js-call compiler :compile_string source "comparison.eli")) (executable (resolve directory "comparison.mjs")))
          (js-call (expect javascript) :toContain "(record(1) === record(1))")
          (await (writeFile executable javascript))
          (let ((result (JSON/parse (js-call (await (run (js-array (get globalThis.process :execPath) (resolve projectDirectory "tests/fixtures/compiler-run-host.mjs"))
            (js-object :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_TEST_MODULE (get (pathToFileURL executable) :href)))))) :trim))))
            (same result (js-object :binary t :nary false :calls (js-array 1 1 1 2 3)))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "committed binary comparison report preserves historical measurements and decisions" (async ()
    (let ((report (validateCompilerBinaryComparisonReport (await (readReport)))))
      (js-call (expect (get (get report :corpus) :files)) :toHaveLength 13)
      (js-call (expect (get (get report :corpus) :files)) :toContain "bootstrap/compiler/project.eli")
      (js-call (expect (get (get report :corpus) :sourceBytes)) :toBeGreaterThan 200000)
      (js-call (expect (get (get report :measurements) :speedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumSpeedup)))))
  (test "failed binary-comparison gates retain complete measurement evidence" (async ()
    (let ((report (await (readReport))) (failure undefined))
      (put (get report :decision) :passed false)
      (try (validateCompilerBinaryComparisonReport report) (catch error (setq failure error)))
      (js-call (expect failure) :toBeInstanceOf globalThis.TypeError) (be (get failure :report) report))))
  (test "binary-comparison size failures retain every measured sample and artifact checksum" (async ()
    (let ((report (await (readReport))) (failure undefined))
      (put (get report :validation) :optimizedBytes (1+ (get (get report :validation) :baselineBytes)))
      (try (validateCompilerBinaryComparisonReport report) (catch error (setq failure error)))
      (js-call (expect failure) :toBeInstanceOf globalThis.TypeError) (be (get failure :report) report)
      (js-call (expect (get (get (get (get failure :report) :measurements) :optimized) :samplesMs)) :toHaveLength (get (get report :parameters) :timingSamples))
      (js-call (expect (get (get (get failure :report) :validation) :optimizedChecksum)) :toBeGreaterThan 0))))
  (funcall (currentPerformanceTest test) "committed binary comparison report matches measured sources" (async ()
    (same (get (await (readReport)) :sourceDigest) (await (compilerBinaryComparisonSourceDigest)))))
)
