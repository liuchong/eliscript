(module tests.wasm-managed-string-code-unit.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)

  (defconst source
    "(defconst marker 1)\n (defun read (text index) (string-code-unit-at text index))\n (defun missing (text) (read text))\n (defun extra (trace) (read (progn (js-call trace :push \"text\") \"ab\")\n   (progn (js-call trace :push \"index\") 1) (js-call trace :push \"extra\")))\n (defun converted (trace mode)\n   (string-code-unit-at \"A😀\\uD800x\"\n     (js-object :valueOf (lambda () (js-call trace :push \"valueOf\") (if (= mode 0) 1.9 (js-object)))\n       :toString (lambda () (js-call trace :push \"toString\") \"2.9\"))))\n (defun primitive (trace)\n   (let ((index (js-object)))\n     (put index (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call trace :push hint) -0))\n     (string-code-unit-at \"xy\" index)))\n (defun abrupt (trace)\n   (let ((index (js-object)))\n     (put index (js* \"Symbol.toPrimitive\") (lambda (hint) (js-call trace :push hint) (throw trace)))\n     (try (string-code-unit-at \"xy\" index) (catch error (Object/is error trace)))))\n (defun receiver-order (text trace) (string-code-unit-at text (progn (js-call trace :push \"index\") 0)))\n (defun captured (trace)\n   (let ((receiver (js-object :charCodeAt (lambda (index) (js-array \"captured\" index)))))\n     (string-code-unit-at receiver (progn (put receiver :charCodeAt false) (js-call trace :push \"argument\") 7))))\n (defun invalid (trace)\n   (string-code-unit-at \"x\" (js-object :valueOf (lambda () (js-call trace :push \"valueOf\") (js-object))\n     :toString (lambda () (js-call trace :push \"toString\") (js-object)))))\n (defun methods (index) (js-array (js-call \"abc\" :at index) (js-call \"abc\" :charAt index)\n   (js-call \"abc\" :charCodeAt index) (js-call \"abc\" :codePointAt index)))\n (defun family-effects (trace)\n   (let ((index (js-object :valueOf (lambda () (js-call trace :push \"convert\") \"-1.9\"))))\n     (methods index)))\n (export read missing extra converted primitive abrupt receiver-order captured invalid methods family-effects)")

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-code-unit-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defasync compiled (&rest __host_default_arguments_1)
    (let* ((rt-arg (aref __host_default_arguments_1 0)) (options (aref __host_default_arguments_1 1)))
    (let* ((rt (if (undefined? rt-arg) runtime rt-arg))
           (p (js-call (get b :compiler) :compile_ir_string source "code-unit.eli"))
           (snapshot (JSON/stringify p))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p rt))))
      (js-call assert :equal (JSON/stringify p) snapshot)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let* ((a (instantiateManagedRuntime bytes options))
             (_ (js-call a :auto 1))
             (js (await (dynamic-import (str "data:text/javascript;base64,"
                                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
        (js-object :a a :p p :bytes bytes :js js)))))

  (defun box (a v)
    (cond
      ((= (value-type v) "number") (js-call a :number v))
      ((= (value-type v) "string") (js-call a :string v))
      (t v)))

  (defun decode (a v)
    (cond
      ((and v (= (get v :kind) 4)) (js-call a :readNumber v))
      ((and v (= (get v :kind) 5)) (js-call a :readString v))
      ((and v (= (get v :kind) 14))
       (let ((out (js-array))
             (i 0))
         (while (< i (js-call a :length v))
           (let ((child (js-call a :get v i)))
             (try (js-call out :push (decode a child)) (finally (js-call a :release child))))
           (setq i (1+ i)))
         out))
      (t v)))

  (defun run (a name &rest __host_default_arguments_2)
    (let* ((args-arg (aref __host_default_arguments_2 0)))
    (let* ((args (if (undefined? args-arg) (js-array) args-arg))
           (out (js-call a :invoke name args)))
      (try (decode a out) (finally (js-call a :release out))))))

  (defun finish (a &rest __host_default_arguments_3)
    (let* ((roots-arg (aref __host_default_arguments_3 0)))
    (let ((roots (if (undefined? roots-arg) (js-array) roots-arg)))
      (js-call roots :forEach (lambda (v) (js-call a :release v)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (test "UTF16 code unit intrinsic emits zero-import WASM and matches exact charCodeAt integer boundary and surrogate semantics" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array "" "x" "A😀\ud800x" "\udfff中" "\ud800\ud800") :forEach
        (lambda (text)
          (let ((value (js-call a :string text)))
            (js-call
              (js-array undefined nil false t globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                        -0.0 0 globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE)
                        -0.9 0.9 1.9 -1.9 -1 2 3 4 5 4294967296 9007199254740992 -9007199254740992
                        "" "-0" "2.9" "bad")
              :forEach
              (lambda (index)
                (let* ((input (box a index))
                       (actual (run a "read" (js-array value input))))
                  (funcall assert (Object/is actual (js-call text :charCodeAt index)))
                  (funcall assert (Object/is actual (js-call js :read text index)))
                  (js-call a :release input))))
            (js-call a :release value))))
      (finish a))))

  (test "intrinsic index conversion captures number hint once after argument effects while ordinary own methods retain their original argument and identity" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array 0 1) :forEach
        (lambda (mode)
          (let ((value (js-call a :number mode))
                (trace (js-call a :sourceArray (js-array)))
                (expected (js-array)))
            (js-call assert :deepEqual (run a "converted" (js-array trace value)) (js-call js :converted expected mode))
            (js-call assert :deepEqual (decode a trace) expected)
            (js-call a :release value)
            (js-call a :release trace))))
      (js-call (js-array "primitive" "extra" "abrupt" "captured") :forEach
        (lambda (name)
          (let ((trace (js-call a :sourceArray (js-array)))
                (expected (js-array)))
            (js-call assert :deepEqual (run a name (js-array trace)) (js-call js name expected))
            (js-call assert :deepEqual (decode a trace) expected)
            (js-call a :release trace))))
      (let ((trace (js-call a :sourceArray (js-array)))
            (expected (js-array)))
        (js-call assert :throws
          (lambda () (js-call a :invoke "invalid" (js-array trace)))
          (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
        (js-call assert :throws (lambda () (js-call js :invalid expected)) globalThis.TypeError)
        (js-call assert :deepEqual (decode a trace) expected)
        (let ((text (js-call a :string "abc")))
          (js-call assert :equal (run a "missing" (js-array text)) (js-call js :missing "abc"))
          (finish a (js-array trace text)))))))

  (test "nullish receiver lookup precedes index evaluation and other missing noncallable methods fail only after evaluating it" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array nil undefined false t 0) :forEach
        (lambda (value)
          (let ((input (box a value))
                (trace (js-call a :sourceArray (js-array)))
                (expected (js-array)))
            (js-call assert :throws
              (lambda () (js-call a :invoke "receiver-order" (js-array input trace)))
              (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
            (js-call assert :throws (lambda () (js-call js :receiver_order value expected)) globalThis.TypeError)
            (js-call assert :deepEqual (decode a trace) expected)
            (js-call a :release input)
            (js-call a :release trace))))
      (finish a))))

  (test "the existing indexed String method family applies object ToNumber once at each original call point" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js))
           (trace (js-call a :sourceArray (js-array)))
           (expected (js-array)))
      (js-call assert :deepEqual (run a "family-effects" (js-array trace)) (js-call js :family_effects expected))
      (js-call assert :deepEqual (decode a trace) expected)
      (js-call assert :deepEqual expected (js-array "convert" "convert" "convert" "convert"))
      (finish a (js-array trace)))))

  (test "random full UTF16 unit strings retain exact lone surrogate and indexed NaN results under collecting GC" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (seed 374577852)
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (i 0))
      (while (< i 128)
        (let ((text "")
              (length (% (funcall next) 32))
              (j 0))
          (while (< j length)
            (setq text (str text (String/fromCharCode (bit-and (funcall next) 65535))))
            (setq j (1+ j)))
          (let ((value (js-call a :string text)))
            (js-call
              (js-array undefined -0.9 -1.9 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                        (% (funcall next) 48) (/ (- (% (funcall next) 96) 48) 3))
              :forEach
              (lambda (index)
                (let ((input (box a index)))
                  (funcall assert (Object/is (run a "read" (js-array value input)) (js-call text :charCodeAt index)))
                  (js-call a :release input))))
            (js-call a :release value)
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
        (setq i (1+ i)))
      (finish a))))

  (test "strict intrinsic arity and malformed IR refuse extra or missing operands before lowering effects" (async ()
    (js-call (js-array "(string-code-unit-at)" "(string-code-unit-at \"x\")" "(string-code-unit-at \"x\" 0 1)") :forEach
      (lambda (input)
        (js-call assert :throws (lambda () (js-call (get b :compiler) :compile_string input "unit-arity.eli")))))
    (let* ((c (await (compiled)))
           (a (get c :a))
           (p (get c :p)))
      (finish a)
      (letfn ((find-node (nodes)
                (let ((found undefined)
                      (idx 0))
                  (while (and (< idx (js-length nodes)) (undefined? found))
                    (let ((n (aref nodes idx)))
                      (if (and (= (get n :kind) "intrinsic") (= (get n :value) "string-code-unit-at"))
                        (setq found n)
                        (let ((child (find-node (or (get n :children) (js-array)))))
                          (when child (setq found child)))))
                    (setq idx (1+ idx)))
                  found)))
        (js-call (js-array 0 1 3) :forEach
          (lambda (count)
            (let* ((copy (globalThis.structuredClone p))
                   (node (find-node (get copy :body))))
              (funcall assert node)
              (put node :children
                (if (< count 2)
                  (js-call (get node :children) :slice 0 count)
                  (js-call (get node :children) :concat (js-array (aref (get node :children) 0)))))
              (js-call assert :throws
                (lambda () (js-call (get b :managed) :emit_managed_wasm copy runtime))
                (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-B0001"))))))))))))

  (test "UTF16 raw method validation preserves unsealed stale private and illegal arguments and recovers from allocation failure without dropping caller roots" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (h (js-call e "heap-new" 64 16384 131072))
             (call (lambda (name &rest args)
                     (let ((out (uint32 (Reflect/apply (get e name) e (js-call (js-array h) :concat args)))))
                       (js-call assert :equal (js-call e "last-error") 0 name)
                       out)))
             (text (funcall call "value-string" 1)))
        (funcall call "heap-pin" text)
        (funcall call "value-unit-set" text 0 55296)
        (funcall call "value-seal" text)
        (let ((zero (funcall call "value-number" 0 2147483648))
              (unsealed (funcall call "value-string" 1))
              (stale (funcall call "value-number" 0 0))
              (caller (funcall call "frame-new" 3)))
          (funcall call "frame-set" caller 0 text)
          (funcall call "frame-set" caller 1 zero)
          (funcall call "frame-set" caller 2 unsealed)
          (funcall call "heap-collect")
          (funcall call "heap-auto" 1)
          (js-call
            (js-array
              (js-array 4294967295 zero 2 1) (js-array caller zero 2 1) (js-array unsealed zero 2 6)
              (js-array text 4294967295 2 1) (js-array text stale 2 1) (js-array text caller 2 3)
              (js-array text unsealed 2 6) (js-array text zero 24 3))
            :forEach
            (lambda (quad)
              (js-call assert :equal (js-call e "value-source-text-method" h (aref quad 0) (aref quad 1) 3 (aref quad 2)) 0)
              (js-call assert :equal (js-call e "last-error") (aref quad 3))
              (js-call assert :equal (funcall call "frame-depth") 1)
              (js-call assert :equal (funcall call "frame-get" caller 0) text)))
          (let ((held (js-array)))
            (while (< (funcall call "heap-live") 64)
              (let ((n (funcall call "value-number" 0 0)))
                (funcall call "heap-pin" n)
                (js-call held :push n)))
            (js-call assert :equal (js-call e "value-source-text-method" h text zero 3 2) 0)
            (js-call assert :equal (js-call e "last-error") 2)
            (js-call assert :equal (funcall call "frame-depth") 1)
            (js-call held :forEach (lambda (n) (funcall call "heap-release" n)))
            (funcall call "heap-collect")
            (let* ((out (funcall call "value-source-text-method" text zero 3 2))
                   (ptr (funcall call "value-data" out 4)))
              (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 ptr t) 55296))
            (let ((heldBits (funcall call "value-data" zero 4)))
              (funcall assert (Object/is (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 heldBits t) -0.0)))
            (funcall call "heap-release" text)
            (funcall call "frame-pop" caller)
            (funcall call "heap-collect")
            (js-call assert :equal (funcall call "heap-live") 0)))))))

  (test "a real UTF16 code unit load trap retains completed index conversion effects and the outer caller frame" (async ()
    (let* ((raw (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call raw :indexOf "  (defun value-source-text-method "))
           (needle "(load-u16 (+ (+ (heap-block heap value) 32) (* index 2)))")
           (point (js-call raw :indexOf needle start)))
      (funcall assert (> point start))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call raw :slice 0 point) "(load-u16 4294967295)" (js-call raw :slice (+ point (js-length needle))))
                         "unit-trap.eli"))
             (c (await (compiled injected)))
             (a (get c :a))
             (trace (js-call a :sourceArray (js-array)))
             (held (js-call a :number -0.0))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 held)
        (js-call assert :throws
          (lambda () (js-call a :invoke "primitive" (js-array trace)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :deepEqual (decode a trace) (js-array "number"))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (funcall assert (Object/is (js-call a :readNumber held) -0.0))
        (js-call a :leaveFrame caller)
        (finish a (js-array trace held))))))

  (test "Node independently executes the exact code unit WASM bytes with native UTF16 and object conversion oracles" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let ((file (resolve directory "code-unit.wasm")))
        (await (writeFile file bytes))
        (let ((child (spawnSync "node"
                       (js-array (resolve "tests/helpers/wasm-managed-string-code-unit-node.mjs")
                                 (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                 file)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))))))

  (test "public Seed and bootstrap preserve the original charCodeAt property lookup contract and JS getter order" (async ()
    (let ((input (resolve directory "unit.eli"))
          (output (resolve directory "unit.mjs")))
      (await (writeFile input "(defun read (text index) (string-code-unit-at text index)) (export read)"))
      (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get seed :status) 0 (get seed :stderr))
        (let* ((javascript (await (readFile output "utf8")))
               (_ (js-call assert :equal javascript (js-call (get b :compiler) :compile_string (await (readFile input "utf8")) input)))
               (reference (await (dynamic-import (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
          (js-call (js-array undefined -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) 1.9 2.9) :forEach
            (lambda (index)
              (funcall assert (Object/is (js-call reference :read "A😀\ud800" index) (js-call "A😀\ud800" :charCodeAt index)))))
          (let ((events (js-array))
                (receiver (js-object))
                (make-method (js* "(self, assert, events) => function(index) { assert.equal(this, self); events.push(index); return 7; }")))
            (Object/defineProperty receiver "charCodeAt"
              (js-object :enumerable t :configurable t
                         :get (lambda ()
                                (js-call events :push "get-method")
                                (funcall make-method receiver assert events))))
            (js-call assert :equal (js-call reference :read receiver 19) 7)
            (js-call assert :deepEqual events (js-array "get-method" 19)))))))))
