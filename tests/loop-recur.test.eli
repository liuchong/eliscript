(module tests.loop-recur.test
  (import "node:process" :default process)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (defconst projectDirectory (resolve (js* "import.meta.dir") ".."))
  (defconst buildPath (resolve projectDirectory "bin/eliscript-bootstrap"))
  (defconst seedCliPath (resolve projectDirectory "bin/eliscript"))
  (defconst portableCliPath (resolve projectDirectory "bin/eliscript-portable"))
  (defconst emacs (let ((value (get (get process :env) :EMACS))) (if (nullish? value) "emacs" value)))
  (defconst source "(defportable function-countdown (remaining count)\n  (if (= remaining 0)\n      count\n    (recur (1- remaining) (1+ count))))\n\n(defun loop-countdown (limit)\n  (loop ((remaining limit) (count 0))\n    (if (= remaining 0)\n        count\n      (recur (1- remaining) (1+ count)))))\n\n(defun swap-once (left right)\n  (loop ((remaining 1) (x left) (y right))\n    (if (= remaining 0)\n        [x y]\n      (recur (1- remaining) y x))))\n\n(defun pattern-loop (remaining)\n  (loop (([left right] [1 2]) (steps remaining))\n    (if (= steps 0)\n        [left right]\n      (recur [right left] (1- steps)))))\n\n(defun pattern-function ([left right] remaining)\n  (if (= remaining 0)\n      [left right]\n    (recur [right left] (1- remaining))))\n\n(defun nested-targets (limit)\n  (loop ((outer limit) (total 0))\n    (if (= outer 0)\n        total\n      (let ((increment\n             (loop ((inner 2) (subtotal 0))\n               (if (= inner 0)\n                   subtotal\n                 (recur (1- inner) (+ subtotal outer))))))\n        (recur (1- outer) (+ total increment))))))\n\n(defun conditional-tail (remaining count)\n  (cond\n    ((= remaining 0) count)\n    ((= (mod remaining 2) 0)\n     (recur (1- remaining) (1+ count)))\n    (t\n     (progn nil (recur (1- remaining) (1+ count))))))\n\n(defun short-circuit-tail (remaining)\n  (or (= remaining 0)\n      (recur (1- remaining))))\n\n(defvar evaluation-events (js-array))\n\n(defun record-evaluation (value)\n  (js-call evaluation-events :push value)\n  value)\n\n(defun evaluation-order ()\n  (loop ((left (record-evaluation 1))\n         (right (record-evaluation 2))\n         (remaining 1))\n    (if (= remaining 0)\n        evaluation-events\n      (recur (record-evaluation 3)\n             (record-evaluation 4)\n             (record-evaluation 0)))))\n\n(defun optional-rest-recur (remaining &optional value &rest tail)\n  (if (= remaining 0)\n      [value tail]\n    (recur (1- remaining) (1+ value) (js-cons value tail))))\n\n(defun combined-tail-positions (remaining)\n  (if (= remaining 0)\n      0\n    (let* ((next (1- remaining)))\n      (and t\n        (when t\n          (unless false\n            (recur next)))))))\n\n(defun loop-inside-try (remaining)\n  (try\n    (loop ((current remaining))\n      (if (= current 0)\n          current\n        (recur (1- current))))\n    (finally nil)))\n\n(defasync async-countdown (remaining count)\n  (if (= remaining 0)\n      count\n    (recur (1- remaining) (+ count (await 1)))))\n\n(export function-countdown loop-countdown swap-once pattern-loop\n        pattern-function nested-targets conditional-tail\n        short-circuit-tail evaluation-order optional-rest-recur\n        combined-tail-positions loop-inside-try async-countdown)\n")

  (defun env (extra) (Object/assign (js-object) (get process :env) extra))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defasync run (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((child (Bun/spawn command (Object/assign (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe") options)))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (when (not (= exitCode 0))
        (throw (new globalThis.Error (or (js-call stderr :trim) (js-call stdout :trim) (str (aref command 0) " exited with " exitCode)))))
      stdout)))

  (test "loop/recur is stack-safe and identical after self-hosting" (async ()
    (let ((directory (await (mkdtemp (resolve projectDirectory ".eliscript-recur-")))))
      (try
        (let* ((compilerDirectory (resolve directory "compiler")) (sourcePath (resolve directory "recur.eli"))
               (outputPath (resolve directory "recur.mjs")) (mapPath (str outputPath ".map")))
          (await (writeFile sourcePath source))
          (await (run (js-array buildPath) (js-object :env (env (js-object :EMACS emacs :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDirectory)))))
          (await (run (js-array seedCliPath "--output" outputPath "--source-map" sourcePath) (js-object :env (env (js-object :EMACS emacs)))))
          (let ((seedJavaScript (await (readFile outputPath "utf8"))) (seedSourceMap (await (readFile mapPath "utf8"))))
            (await (run (js-array portableCliPath "--output" outputPath "--source-map" sourcePath)
              (js-object :env (env (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR compilerDirectory)))))
            (be (await (readFile outputPath "utf8")) seedJavaScript) (be (await (readFile mapPath "utf8")) seedSourceMap)
            (js-call (expect seedJavaScript) :toContain ": while (true)")
            (js-call (expect seedJavaScript) :toContain "continue __eliscript_value_"))
          (let ((module (await (funcall (js* "(url) => import(url)") (str (get (pathToFileURL outputPath) :href) "?bun")))))
            (be (js-call module :function_countdown 1000000 0) 1000000)
            (be (js-call module :loop_countdown 1000000) 1000000)
            (same (Array/from (js-call module :swap_once 1 2)) (js-array 2 1))
            (same (Array/from (js-call module :pattern_loop 1)) (js-array 2 1))
            (same (Array/from (js-call module :pattern_function (js-array 1 2) 1)) (js-array 2 1))
            (be (js-call module :nested_targets 100) 10100)
            (be (js-call module :conditional_tail 100000 0) 100000)
            (be (js-call module :short_circuit_tail 100000) t)
            (same (js-call module :evaluation_order) (js-array 1 2 3 4 0))
            (let ((optionalRest (Array/from (js-call module :optional_rest_recur 2 10 99))))
              (be (aref optionalRest 0) 12) (same (aref optionalRest 1) (js-array 11 10 99)))
            (be (js-call module :combined_tail_positions 100000) 0)
            (be (js-call module :loop_inside_try 100000) 0)
            (be (await (js-call module :async_countdown 5000 0)) 5000))
          (await (run (js-array "node" (resolve projectDirectory "tests/fixtures/loop-recur-host.mjs") (get (pathToFileURL outputPath) :href)))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
