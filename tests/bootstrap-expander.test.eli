(module tests.bootstrap-expander
  (import "node:fs" readFileSync)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/diagnostics/check.mjs" diagnosticCorpusSuite)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory caseSource buildBootstrap seedResults loadModule)
  (defconst fixturePath (resolve projectDirectory "tests/fixtures/bootstrap-expander.json"))
  (defconst diagnosticCases (get (diagnosticCorpusSuite (JSON/parse (readFileSync (resolve projectDirectory "contracts/diagnostic-corpus.json") "utf8")) "expander") :cases))
  (defun generatedResult (reader expander testCase source)
    (try (js-object :name (get testCase :name) :status "ok" :forms (js-call expander :expand_module (js-call reader :read_string source (get testCase :filename)) (get testCase :filename)))
      (catch error (js-object :name (get testCase :name) :status "error" :message (get error :message) :diagnostic (get error :eliscriptDiagnostic)))))
  (test "bootstrapped expander matches seed syntax, spans, and diagnostics" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-expander-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((reader (await (loadModule directory "reader" "test"))) (expander (await (loadModule directory "expander" "test"))) (analyzer (await (loadModule directory "analyzer" "test")))
               (fixture (JSON/parse (await (readFile fixturePath "utf8"))))
               (cases (js-call (get fixture :valid) :concat (get fixture :invalid))) (generated (js-array)) (index 0))
          (while (< index (js-length cases))
            (let ((testCase (aref cases index))) (js-call generated :push (generatedResult reader expander testCase (await (caseSource testCase)))))
            (setq index (1+ index)))
          (js-call (expect generated) :toEqual (await (seedResults "expander" fixturePath)))
          (js-call (expect (js-call generated :slice (get (get fixture :valid) :length))) :toEqual
            (js-call diagnosticCases :map (lambda (entry) (js-object :name (get entry :name) :status "error" :message (get entry :human) :diagnostic (get entry :diagnostic)))))
          (js-call (js-call generated :slice 0 (get (get fixture :valid) :length)) :forEach (lambda (result)
            (js-call (get (expect (lambda () (js-call analyzer :analyze_module (get result :forms) (get result :name)))) :not) :toThrow)))
          (js-call (expect (await (readFile (resolve directory "expander.mjs.map") "utf8"))) :toContain "bootstrap/compiler/expander.eli"))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
