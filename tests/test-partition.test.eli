(module tests.test-partition.test
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" :default path)
  (import "node:url" fileURLToPath)
  (defconst ROOT (js-call path :resolve (js-call path :dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defun targetSource (makefile name)
    (let* ((lines (js-call makefile :split "\n")) (start (js-call lines :findIndex (lambda (line) (js-call line :startsWith (str name ":")))))
           (body (js-array)) (index (+ start 1)) (done false))
      (when (= start -1) (throw (new globalThis.Error (str "missing Make target: " name))))
      (while (and (< index (get lines :length)) (not done))
        (let ((line (aref lines index)))
          (if (js-call (new globalThis.RegExp "^[A-Za-z0-9_.-]+:") :test line) (setq done t) (js-call body :push line)))
        (setq index (1+ index)))
      (str (aref lines start) "\n" (js-call body :join "\n"))))
  (test "default tests retain explicit core and application partitions" (async ()
    (let* ((makefile (await (readFile (js-call path :join ROOT "Makefile") "utf8")))
           (packageJson (JSON/parse (await (readFile (js-call path :join ROOT "package.json") "utf8"))))
           (aggregate (targetSource makefile "test")) (core (targetSource makefile "test-core")) (applications (targetSource makefile "test-applications")))
      (js-call (expect (aref (js-call aggregate :split "\n" 1) 0)) :toBe "test: test-core test-applications")
      (js-call (expect (get (get packageJson :scripts) :test)) :toBe "make test")
      (js-call (expect (get (get packageJson :scripts) "test:core")) :toBe "make test-core")
      (js-call (expect (get (get packageJson :scripts) "test:applications")) :toBe "make test-applications")
      (js-call (js-array "tests/eliscript-org-tests.el" "tests/vite-plugin.test.mjs" "tests/org-vite-plugin.test.mjs" "tests/application-cli-test.sh")
        :forEach (lambda (applicationTest)
          (js-call (get (expect core) :not) :toContain applicationTest) (js-call (expect applications) :toContain applicationTest)))
      (js-call (expect core) :toContain "tests/cli-test.sh") (js-call (get (expect applications) :not) :toContain "tests/cli-test.sh"))))
)
