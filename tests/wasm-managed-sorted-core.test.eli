(module tests.wasm-managed-sorted-core
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp mkdir writeFile symlink rm)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/testing/wire-call-cases.mjs" runtimeCallShard)
  (import "../runtime/core/sorted.mjs" :as OriginalSorted)
  (import "../runtime/literals.mjs" :as OriginalLiterals)
  (import "../runtime/core/metadata.mjs" :as OriginalMetadata)
  (defconst options (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
  (defconst memory (js-object :initialPages 4 :maximumPages 1024))
  (defconst entry "tests/sorted-entry.mjs")
  (defconst units (js-array (js-array entry "tests/fixtures/wasm-managed-sorted.eli")
    (js-array "tests/fixtures/persistent-sorted.mjs" "tests/fixtures/persistent-sorted.eli")
    (js-array "stdlib/core/sorted.eli" "stdlib/core/sorted.eli")))
  (defconst cases (js-array "original-report" "original-boundaries" "rotations" "ranges" "semantics" "order-cases"
    "full-order-contracts" "comparator-failure" "transport" "lazy-iterators" "sharing"))
  (defconst partitioned (and (= (get (get globalThis.process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1")
    (= (get (get globalThis.process :env) :ELISCRIPT_SEQUENCE_FUNCTIONAL_RUNTIME_PROFILE) "small")))
  (defconst native? (and (= (get globalThis.process :platform) "darwin") (= (get globalThis.process :arch) "arm64")))
  (defconst actualTest (js-call test :skipIf (not native?)))
  (defconst testShard (runtimeCallShard (get globalThis.process :env)))
  (defconst shared-part? (or (nil? testShard) (= (get testShard :index) 1)))
  (defvar directory undefined) (defvar backend undefined) (defvar lowered undefined) (defvar bytes undefined)
  (defvar nativePath undefined) (defvar expected undefined) (defvar boundaryLowered undefined)
  (defvar boundaryBytes undefined) (defvar boundaryNativePath undefined)
  (defun operations ()
    (let ((state 1592594996))
      (letfn ((next ()
        (setq state (bit-xor state (bit-shift-left state 13)))
        (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
        (setq state (bit-xor state (bit-shift-left state 5))) (uint32 state)))
        (Array/from (js-object :length 96) (lambda ()
          (let ((key (% (next) 32)) (put? (< (% (next) 10) 7)))
            (if put? (js-array 0 key (next)) (js-array 1 key 0))))))))
  (defconst randomOperations (operations))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-sorted-core-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (let* ((compiler (get backend :compiler))
           (runtimeIR (js-call compiler :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
           (literalModules (get (await (js-call backend :loadLiteralModules)) :literalModules))
           (modules (js-array)) (index 0))
      (while (< index (js-length units))
        (let* ((unit (aref units index)) (filename (aref unit 1)))
          (js-call modules :push (js-object :id (aref unit 0) :program
            (js-call compiler :compile_ir_string (await (readFile filename "utf8")) filename))))
        (setq index (1+ index)))
      (let ((before (JSON/stringify modules)) (libraryBefore (JSON/stringify literalModules)))
        (setq lowered (js-call (get backend :managed) :lower_managed_project modules entry runtimeIR
          (Object/assign (js-object) memory (js-object :literalModules literalModules))))
        (setq bytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
          (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) memory)
          "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
        (js-call assert :strictEqual (JSON/stringify modules) before "user IR remains unchanged")
        (js-call assert :strictEqual (JSON/stringify literalModules) libraryBefore "actual library IR remains unchanged")
        (js-call assert :deepStrictEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (js-call assert :deepStrictEqual (js-call (Array/from (get lowered :modules)) :sort)
          (js-call (js-call units :map (lambda (unit) (aref unit 0))) :sort))
        (js-call (js-array "runtime/core/order.mjs" "runtime/core/sorted.mjs" "stdlib/managed-sorted-state.mjs") :forEach
          (lambda (id) (js-call assert :ok (js-call (get lowered :privateModules) :some
            (lambda (privateId) (js-call privateId :endsWith (str "/" id)))) (str "actual private source: " id))))
        (when native?
          (setq nativePath (resolve directory "sorted-core.dylib"))
          (await (writeFile nativePath (globalThis.Uint8Array.from
            (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos")))))
        (setq boundaryLowered (js-call (get backend :managed) :lower_managed_project modules entry runtimeIR
          (Object/assign (js-object) memory (js-object :literalModules literalModules :phased t))))
        (setq boundaryBytes (globalThis.Uint8Array.from (js-call (get backend :wasm) :append_metadata_section
          (js-call (get backend :wasm) :emit_typed_memory_wasm (get boundaryLowered :typed) memory)
          "eliscript-managed-control" (JSON/stringify (get boundaryLowered :descriptor)))))
        (js-call assert :strictEqual (JSON/stringify modules) before)
        (js-call assert :strictEqual (JSON/stringify literalModules) libraryBefore)
        (when native?
          (setq boundaryNativePath (resolve directory "sorted-provider.dylib"))
          (await (writeFile boundaryNativePath (globalThis.Uint8Array.from
            (js-call (get backend :native) :emit_typed_native_memory_library (get boundaryLowered :typed) "arm64-macos"))))))
      (let* ((reference (resolve directory "reference")) (script (resolve directory "original-reference.mjs"))
             (url (get (pathToFileURL (resolve reference entry)) :href))
             (caseForms (js-call (js-call cases :map JSON/stringify) :join " "))
             (operationForms (js-call (js-call randomOperations :map
               (lambda (operation) (str "(js-array " (js-call operation :join " ") ")"))) :join " "))
             (code (str "(import " (JSON/stringify url) " :as m) (import \"node:assert/strict\" :default assert)\n"
               "(let ((out (js-object))) (js-call (js-array " caseForms ") :forEach (lambda (name) (put out name (funcall (get m (js-call name :replaceAll \"-\" \"_\"))))))\n"
               "(put out :randomized (js-call m :randomized (js-array " operationForms ")))\n"
               "(let ((state (js-call m :held_state))) (put out :held (Array/from (js-object :length 5) (lambda () (js-call m :held_step state)))))\n"
               "(try (js-call m :throw_comparison) (throw (new globalThis.Error \"missing expected comparison failure\")) (catch error (js-call assert :strictEqual (get error :name) \"TypeError\") (js-call assert :strictEqual (get error :message) \"sorted comparison marker\") (put out :failure (js-array (get error :name) (get error :message)))))\n"
               "(console/log (JSON/stringify out)))")))
        (await (mkdir (resolve reference "node_modules") (js-object :recursive t)))
        (await (symlink (resolve "runtime") (resolve reference "runtime") "dir"))
        (await (symlink (resolve ".") (resolve reference "node_modules/eliscript") "dir"))
        (let ((index 0))
          (while (< index (js-length modules))
            (let* ((module (aref modules index)) (filename (resolve reference (get module :id))))
              (await (mkdir (dirname filename) (js-object :recursive t)))
              (await (writeFile filename (js-call compiler :emit_ir_string (get module :program)))))
            (setq index (1+ index))))
        (await (writeFile script (js-call compiler :compile_string code "sorted-reference.eli")))
        (let ((hosts (js-array
          (js-array (or (get (get globalThis.process :env) :NODE) "node")
            (js-array "--experimental-loader" (resolve "tests/fixtures/compiled-eli-node-loader.mjs")))
          (js-array (get globalThis.process :execPath) (js-array "--preload" (resolve "tests/fixtures/compiled-eli-bun-preload.mjs")))))
              (index 0))
          (while (< index (js-length hosts))
            (let* ((host (aref hosts index))
                   (result (spawnSync (aref host 0) (js-call (aref host 1) :concat (js-array script url))
                     (js-object :encoding "utf8" :timeout 30000)))
                   (observations (progn (js-call assert :strictEqual (get result :status) 0
                     (or (get result :stderr) (get result :stdout))) (JSON/parse (get result :stdout)))))
              (if expected (js-call assert :deepStrictEqual observations expected "independent Node and Bun original runtime")
                (setq expected observations)))
            (setq index (1+ index))))))
    (let ((original (JSON/parse (get expected "original-report"))))
      (js-call assert :deepStrictEqual (get original :map) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c") (js-array 4 "d")))
      (js-call assert :deepStrictEqual (get original :reverseMap) (js-array (js-array 3 "c") (js-array 2 "b") (js-array 1 "a")))
      (js-call assert :deepStrictEqual (get original :set) (js-array 1 2 3 4))
      (js-call assert :deepStrictEqual (get original :reverse) (js-array 4 3 2 1))
      (js-call assert :deepStrictEqual (get original :from) (js-array (js-array 4 "d")))
      (js-call assert :deepStrictEqual (get original :subseq) (js-array (js-array 2 "b") (js-array 3 "c")))
      (js-call assert :deepStrictEqual (get original :rsubseq) (js-array 4 3 2))
      (js-call assert :strictEqual (get original :folded) "1a2b3c4d")
      (js-call assert :deepStrictEqual (get original :classification) (js-array t t t t t t))
      (js-call assert :deepStrictEqual (get original :value) (js-array t t t))
      (js-call assert :deepStrictEqual (get original :empty) (js-array t t))
      (js-call assert :deepStrictEqual (get original :errors) (js-array
        "persistentSortedMap expects an even number of key/value forms"
        "two-bound subsequence requires a lower :>/:>= bound then an upper :</:<= bound"
        "sortedSequence ascending must be a boolean")))
    (js-call assert :deepStrictEqual (js-call (get expected :rotations) :slice 0 4) (Array/from (js-object :length 4) (lambda () (js-array 2 2 3 t))))
    (js-call assert :deepStrictEqual (aref (get expected :rotations) 4) (js-array t 0 96 t t t t)
      "all96 distinct keys are inserted then deleted and the original tree remains immutable")
    (js-call assert :deepStrictEqual (get expected :sharing) (js-array t t t t 0 "updated" 127 127))
    (js-call assert :deepStrictEqual (aref (get expected :transport) 2) (js-array) "bulk transport does not call comparator")
    (js-call assert :ok (js-call (js-call (get expected :transport) :slice 3) :every (lambda (value) (eq value t))))
    (let ((model (new globalThis.Map)) (snapshots (js-array)))
      (js-call randomOperations :forEach (lambda (operation index)
        (if (= (aref operation 0) 0) (js-call model :set (aref operation 1) (aref operation 2))
          (js-call model :delete (aref operation 1)))
        (when (= (% index 17) 0)
          (js-call snapshots :push (js-call (Array/from model) :sort (lambda (a b) (- (aref a 0) (aref b 0))))))))
      (js-call assert :deepStrictEqual (get expected :randomized)
        (js-array (js-call (Array/from model) :sort (lambda (a b) (- (aref a 0) (aref b 0)))) snapshots t snapshots t)))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun read-value (runtime value)
    (cond ((nullish? value) value)
      ((= (get value :kind) 4) (js-call runtime :readNumber value))
      ((= (get value :kind) 5) (js-call runtime :readString value))
      ((= (get value :kind) 14) (Array/from (js-object :length (js-call runtime :length value))
        (lambda (ignored index) (let ((child (js-call runtime :get value index)))
          (try (read-value runtime child) (finally (js-call runtime :release child)))))))
      (t value)))
  (defun invoke (runtime name &optional arguments)
    (let ((result (js-call runtime :invoke (js-call name :replaceAll "-" "_") (or arguments (js-array)))))
      (try (read-value runtime result) (finally (js-call runtime :release result)))))
  (defun boxedOperations (runtime)
    (let ((children (js-array)))
      (try
        (js-call randomOperations :forEach (lambda (operation)
          (let ((numbers (js-call operation :map (lambda (value) (js-call runtime :number value)))))
            (try (js-call children :push (js-call runtime :sourceArray numbers))
              (finally (js-call numbers :forEach (lambda (value) (js-call runtime :release value))))))))
        (js-call runtime :sourceArray children)
        (finally (js-call children :forEach (lambda (child) (js-call runtime :release child)))))))
  (defun finish (runtime)
    (js-call runtime :closeModule) (js-call runtime :collect)
    (js-call assert :strictEqual (js-call runtime :live) 0)
    (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
  (defun check-rotations (runtime &optional stepped)
    (if (not stepped) (invoke runtime "rotations")
      (let ((state (js-call runtime :invoke "rotations_state")) (index 0) (started (performance/now)))
        (try
          (while (< index 196)
            (let ((progress (invoke runtime "rotations-step" (js-array state)))
                  (expected-progress (cond ((< index 3) (js-array 0 0 (1+ index)))
                    ((< index 99) (js-array 1 (- index 3) 4))
                    ((< index 195) (js-array 2 (- index 99) 4)) (t (js-array 3 96 4)))))
              (js-call assert :deepStrictEqual progress expected-progress "all four rotations and all96 insertions/deletions execute in order")
              (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
              (when (or (< index 8) (= (% (1+ index) 8) 0) (= index 195))
                (console/error "[sorted-rotation-progress]" (JSON/stringify (js-object :completed (1+ index) :total 196
                  :phase (aref progress 0) :index (aref progress 1) :elapsedMs (Math/round (- (performance/now) started))
                  :stats (js-call runtime :stats))))))
            (setq index (1+ index)))
          (invoke runtime "rotations-result" (js-array state))
          (finally (js-call runtime :release state))))))
  (defun check-sharing (runtime &optional stepped)
    (if (not stepped) (invoke runtime "sharing")
      (let ((state (js-call runtime :invoke "sharing_state")) (index 0) (started (performance/now)))
        (try
          (while (< index 127)
            (js-call assert :strictEqual (invoke runtime "sharing-step" (js-array state)) (1+ index))
            (setq index (1+ index))
            (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)
            (when (= (% index 8) 0)
              (console/error "[sorted-sharing-progress]" (JSON/stringify
                (js-object :completed index :total 127 :elapsedMs (Math/round (- (performance/now) started)))))))
          (invoke runtime "sharing-result" (js-array state))
          (finally (js-call runtime :release state))))))
  (defun checkAll (runtime &optional part)
    (js-call cases :forEach (lambda (name)
      (when (or (nullish? part) (= part name))
        (js-call assert :deepStrictEqual (cond
          ((= name "rotations") (check-rotations runtime (and partitioned (not (nullish? part)))))
          ((= name "sharing") (check-sharing runtime (and partitioned (not (nullish? part)))))
          (t (invoke runtime name))) (get expected name) name)
        (js-call runtime :collect)
        (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0 (str name " frame cleanup")))))
    (when (or (nullish? part) (= part "randomized"))
      (let ((input (boxedOperations runtime)))
        (try (js-call assert :deepStrictEqual (invoke runtime "randomized" (js-array input)) (get expected :randomized))
          (finally (js-call runtime :release input))))
      (js-call runtime :collect) (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0))
    (when (or (nullish? part) (= part "held"))
      (let ((held (js-call runtime :invoke "held_state")))
        (try (js-call (get expected :held) :forEach (lambda (observation)
          (js-call runtime :collect)
          (js-call assert :deepStrictEqual (invoke runtime "held-step" (js-array held)) observation)
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0 "live map metadata comparator and iterator roots")))
          (finally (js-call runtime :release held)))))
    (let ((round 0))
      (while (< round 2)
        (when (or (nullish? part) (= part (str "recovery-" round)))
          (js-call assert :throws (lambda () (js-call runtime :invoke "throw_comparison"))
            (lambda (error) (and (js-call globalThis.TypeError (get globalThis.Symbol :hasInstance) error)
                                (= (get error :message) (aref (get expected :failure) 1)))))
          (js-call runtime :collect)
          (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0 "source callback exception unwinds frames")
          (js-call assert :deepStrictEqual (check-rotations runtime (and partitioned (not (nullish? part))))
            (get expected :rotations) "resource recovery after comparison failure"))
        (setq round (1+ round)))))
  ;; Give the five large independent scenarios distinct slots in the existing
  ;; eight file shards; keep every original case and normal-suite order.
  (defconst parts (js-call (js-array "rotations" "sharing" "randomized" "recovery-0" "recovery-1") :concat
    (js-call cases :filter (lambda (name) (and (/= name "rotations") (/= name "sharing"))))
    (js-array "held")))
  (defun register-parts (title native-mode)
    (console/error "[sorted-call-partitions]" (JSON/stringify (js-object :title title :parts parts
      :ordinaryDeadlineMs 120000 :rotationScenarioDeadlineMs 1800000
      :randomizedScenarioDeadlineMs 600000
      :recoveryScenarioDeadlineMs 1800000
      :originalAggregatePerformance "NOT ACCEPTED")))
    (js-call parts :forEach (lambda (part index)
      (when (or (nil? testShard) (= (% index (get testShard :count)) (1- (get testShard :index))))
      (funcall (if native-mode (js-call test :skipIf (not native?)) test) (str title " [" part "]")
        (async ()
          (let ((runtime (if native-mode
                   (await (instantiateNativeManagedRuntime nativePath lowered (Object/assign (js-object) options memory)))
                   (instantiateManagedRuntime bytes options))))
            (js-call runtime :auto 1)
            (try (checkAll runtime part)
              (finally (if native-mode (try (finish runtime) (finally (js-call runtime :close))) (finish runtime))))))
        (cond ((js-call part :startsWith "recovery-") 1800000)
              ((or (= part "rotations") (= part "sharing")) 1800000)
              ((= part "randomized") 600000)
              (t 120000)))))))
  (when shared-part? (test "Given complete original sorted and ordering source modules when the original fixture boundaries protocols metadata ranges and fixed-seed AVL updates execute then zero-import WASM matches independent Node and Bun"
    (lambda () (let ((runtime (instantiateManagedRuntime bytes options)))
      (js-call runtime :auto 65536) (try (checkAll runtime) (finally (finish runtime))))) 30000))
  (if partitioned
    (register-parts "Given collection at every allocation when old AVL versions callbacks normalized comparators metadata and lazy iterators remain observable then the original semantic corpus and resource recovery agree" false)
    (test "Given collection at every allocation when old AVL versions callbacks normalized comparators metadata and lazy iterators remain observable then the original semantic corpus and resource recovery agree"
      (lambda () (let ((runtime (instantiateManagedRuntime bytes options)))
        (js-call runtime :auto 1) (try (checkAll runtime) (finally (finish runtime))))) 30000))
  (if partitioned
    (register-parts "Given native machine code from the identical typed sorted graph when all original-reference cases run then actual native execution retains values identities errors GC roots and cleanup" t)
    (actualTest "Given native machine code from the identical typed sorted graph when all original-reference cases run then actual native execution retains values identities errors GC roots and cleanup"
      (async () (let ((runtime (await (instantiateNativeManagedRuntime nativePath lowered (Object/assign (js-object) options memory)))))
        (js-call runtime :auto 1) (try (checkAll runtime) (finally (try (finish runtime) (finally (js-call runtime :close))))))) 120000))
  (defconst providerOptions (Object/assign (js-object) options (js-object :literalHostProvider OriginalLiterals
    :hostModules (new globalThis.Map (js-array (js-array "eliscript/runtime/core/sorted.mjs" OriginalSorted)
      (js-array "eliscript/runtime/core/metadata.mjs" OriginalMetadata))))))
  (defun checkProvider (runtime)
    (js-call runtime :initializeModule)
    (let* ((module (js-call (get (get (get boundaryLowered :descriptor) :project) :modules) :find (lambda (value) (= (get value :id) entry))))
           (call (lambda (name &optional arguments)
             (let ((binding (js-call (get module :exports) :find (lambda (value) (= (get value :name) (js-call name :replaceAll "-" "_"))))))
               (js-call assert :ok binding (str "actual export " name))
               (js-call (get runtime :project) :invoke (get binding :kind) (get binding :index) undefined (or arguments (js-array)))))))
      (js-call assert :ok module "actual public entry metadata")
      (let* ((value (funcall call "provider-value"))
             (original (OriginalMetadata/withMeta (OriginalSorted/persistentSortedMap 2 "b" 1 "a" 3 "c") (OriginalLiterals/hashMap "provider" 17))))
        (js-call assert :ok (js-call (get OriginalSorted :PersistentSortedMap) (get globalThis.Symbol :hasInstance) value))
        (js-call assert :deepStrictEqual (Array/from value) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c")))
        (js-call assert :ok (Object/isFrozen value))
        (js-call assert :strictEqual (get value :comparator) (OriginalSorted/defaultSortedComparator))
        (js-call assert :strictEqual (js-call (OriginalMetadata/meta value) :get "provider") 17)
        (js-call assert :strictEqual (funcall call "provider-identity" (js-array value)) value "same provider value returns the same object")
        (js-call assert :strictEqual (funcall call "provider-identity" (js-array original)) original "incoming actual provider identity")
        (js-call assert :deepStrictEqual (Array/from (funcall call "provider-inspect" (js-array original))
          (lambda (item) (if (Array/isArray item) (Array/from item (lambda (pair) (Array/from pair))) item)))
          (js-array t false (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c")) t 17))
        (js-call runtime :collect)
        (let ((changed (funcall call "provider-change" (js-array original))))
          (js-call assert :ok (js-call (get OriginalSorted :PersistentSortedMap) (get globalThis.Symbol :hasInstance) changed))
          (js-call assert :deepStrictEqual (Array/from changed) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c") (js-array 4 "d")))
          (js-call assert :deepStrictEqual (Array/from original) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c")))
          (js-call assert :strictEqual (get changed :comparator) (get original :comparator))
          (js-call assert :strictEqual (OriginalMetadata/meta changed) (OriginalMetadata/meta original))))
      (let* ((calls 0) (custom (OriginalSorted/persistentSortedMapBy (lambda (a b) (setq calls (1+ calls)) (- a b)) 2 "b" 1 "a" 3 "c")))
        (setq calls 0)
        (js-call assert :strictEqual (funcall call "provider-identity" (js-array custom)) custom)
        (js-call assert :strictEqual calls 0 "bulk import does not repeat comparator effects")
        (let ((changed (funcall call "provider-change" (js-array custom))))
          (js-call assert :ok (> calls 0) "actual foreign custom comparator is called by target AVL operations")
          (js-call assert :deepStrictEqual (Array/from changed) (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c") (js-array 4 "d")))
          (js-call assert :strictEqual (get changed :comparator) (get custom :comparator))))
      (js-call assert :strictEqual (get (js-call runtime :stats) :frameDepth) 0)))
  (when shared-part? (test "Given actual provider sorted classes when bulk values cross the real phased WASM boundary then brands comparator metadata identity and pure target AVL updates survive GC"
    (lambda () (let ((runtime (instantiateManagedRuntime boundaryBytes providerOptions)))
      (js-call runtime :auto 1) (try (checkProvider runtime) (finally (finish runtime))))) 30000))
  (when shared-part? (actualTest "Given actual provider values when the same phased graph executes native machine code then provider identities and comparator effects are preserved without host sorting"
    (async () (let ((runtime (await (instantiateNativeManagedRuntime boundaryNativePath boundaryLowered (Object/assign (js-object) providerOptions memory)))))
      (js-call runtime :auto 1) (try (checkProvider runtime) (finally (try (finish runtime) (finally (js-call runtime :close))))))) 120000)))
