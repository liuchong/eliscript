(module tests.wasm-managed-json.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))
  (defconst u32 (js* "(x) => x >>> 0"))
  (defconst js-pow (js* "(a, b) => a ** b"))
  (defconst node-helper (resolve "tests/helpers/wasm-managed-json-node.mjs"))

  (defvar b nil)
  (defvar rt nil)
  (defvar p nil)
  (defvar js nil)
  (defvar javascript nil)
  (defvar directory nil)
  (defvar namespace-bytes nil)
  (defvar namespace-javascript nil)

  (defconst namespace-methods (js-array "parse" "stringify" "rawJSON" "isRawJSON"))
  (defconst receiver-method
    "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")

  (defconst namespace-source
    (str "\n"
      (js-call (js-call namespace-methods :map (lambda (name) (str "(defconst saved-" name " JSON/" name ")"))) :join "\n") "\n"
      "(defun namespace-cold-identities () (and "
      (js-call (js-call namespace-methods :map (lambda (name) (str "(eq saved-" name " JSON/" name ")"))) :join " ") "))\n"
      "(defun namespace-escaped-identities ()\n"
      " (let ((owner (js* \"JSON\")))\n"
      "  (and "
      (js-call
        (js-call namespace-methods :map
          (lambda (name)
            (str "(eq saved-" name " (get owner \"" name "\")) (eq saved-" name " (js* \"globalThis.JSON." name "\"))")))
        :join " ") ")))\n"
      "(defun namespace-read (key)\n"
      " (cond " (js-call (js-call namespace-methods :map (lambda (name) (str "((= key \"" name "\") JSON/" name ")"))) :join " ") "))\n"
      "(defun namespace-descriptor (key) (Object/getOwnPropertyDescriptor (js* \"JSON\") key))\n"
      "(defun namespace-metadata-valid (key descriptor)\n"
      " (let ((callable (get descriptor :value)))\n"
      "  (and (= (get callable :name) key)\n"
      "   (= (get callable :length) (cond ((= key \"parse\") 2) ((= key \"stringify\") 3) (t 1)))\n"
      "   (get descriptor :writable) (not (get descriptor :enumerable)) (get descriptor :configurable))))\n"
      "(defun namespace-restore (key descriptor) (Object/defineProperty (js* \"JSON\") key descriptor) nil)\n"
      "(defun namespace-delete (key) (Reflect/deleteProperty (js* \"JSON\") key))\n"
      "(defun namespace-own (key) (object-has? (js* \"JSON\") key))\n"
      "(defun namespace-note (trace mark) (put trace :order (+ (get trace :order \"\") mark)))\n"
      "(defun namespace-argument (key trace value)\n"
      " (namespace-note trace \"a\")\n"
      " (when (get trace :mutate false)\n"
      "  (Object/defineProperty (js* \"JSON\") key\n"
      "   (js-object :value nil :writable t :enumerable false :configurable t)))\n"
      " value)\n"
      "(defun namespace-extra (trace) (namespace-note trace \"e\") 37)\n"
      "(defun namespace-install (key trace callable)\n"
      " (Object/defineProperty (js* \"JSON\") key\n"
      "  (js-object :configurable t :enumerable false :get\n"
      "   (funcall (js* " (JSON/stringify receiver-method) ") (lambda (receiver)\n"
      "   (namespace-note trace \"g\")\n"
      "   (put trace :reads (+ (get trace :reads 0) 1))\n"
      "   (put trace :getterThis (eq receiver (js* \"JSON\")))\n"
      "   (if callable\n"
      "    (funcall (js* " (JSON/stringify receiver-method) ") (lambda (receiver value extra)\n"
      "     (namespace-note trace \"c\")\n"
      "     (put trace :calls (+ (get trace :calls 0) 1))\n"
      "     (put trace :callThis (eq receiver (js* \"JSON\")))\n"
      "     (put trace :extra extra)\n"
      "     value) key)\n"
      "    nil))\n"
      "   (+ \"get \" key)))) nil)\n"
      "(defun namespace-call (key trace value)\n"
      " (cond "
      (js-call
        (js-call namespace-methods :map
          (lambda (name)
            (str "((= key \"" name "\") (JSON/" name " (namespace-argument key trace value) (namespace-extra trace)))")))
        :join " ") "))\n"
      "(export namespace-cold-identities namespace-escaped-identities namespace-read namespace-descriptor namespace-metadata-valid\n"
      " namespace-restore namespace-delete namespace-own namespace-install namespace-call)\n"))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-json-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq rt
        (js-call (get b :compiler) :compile_ir_string
          (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
          "runtime.eli"))
      (setq p
        (js-call (get b :compiler) :compile_ir_string
          (await (readFile "tests/fixtures/wasm-managed-json.eli" "utf8"))
          "json.eli"))
      (setq javascript (js-call (get b :compiler) :emit_ir_string p))
      (setq js
        (await (funcall dyn-import
                 (str "data:text/javascript;base64,"
                      (js-call (Buffer/from javascript) :toString "base64")))))
      (let ((namespace-ir
              (js-call (get b :compiler) :compile_ir_string namespace-source "json-namespace.eli")))
        (setq namespace-javascript (js-call (get b :compiler) :emit_ir_string namespace-ir))
        (setq namespace-bytes
          (Uint8Array/from
            (js-call (get b :managed) :emit_managed_wasm namespace-ir rt)))
        (js-call assert :deepEqual
          (WebAssembly.Module/imports (new WebAssembly.Module namespace-bytes))
          (js-array))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun instance (&rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((before (JSON/stringify p))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p rt))))
      (js-call assert :equal (JSON/stringify p) before)
      (js-call assert :deepEqual
        (WebAssembly.Module/imports (new WebAssembly.Module bytes))
        (js-array))
      (let ((a (instantiateManagedRuntime bytes options)))
        (js-call a :auto 1)
        (js-object :a a :bytes bytes)))))

  (defun finish (a &rest __host_default_arguments_1)
    (let* ((values (aref __host_default_arguments_1 0)))
    (let ((vals (if (undefined? values) (js-array) values)))
      (js-call vals :forEach (lambda (x) (js-call a :release x)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defconst valid
    (js-array
      "null" "true" "false" "-0" "1.5" "5e-324" "-1e-9999" "1e9999" "9007199254740993"
      "\"\"" "\"中😀\"" "\"\\ud800\\udc00\\ud800\"" "\"\\b\\f\\n\\r\\t\\/\\\\\\\"\"" "[]" "{}"
      "[null,true,false,0,-0,1e9999,\"x\",[1,2],{}]" "{\"b\":1,\"2\":2,\"1\":3,\"a\":4,\"b\":5}"
      "{\"__proto__\":{\"x\":1},\"constructor\":7,\"prototype\":8}"
      (str " " (String/fromCharCode 13) "\n\t {\"a\":[1,{\"b\":\"😀\"}]} " (String/fromCharCode 13) "\n")))

  (defconst invalid
    (js-array
      "" " "
      (str (String/fromCharCode 65279) "null")
      (str (String/fromCharCode 160) "null")
      "+1" "01" "-01" "1." ".5" "1e" "1e+" "NaN" "Infinity"
      "undefined" "null false" "/*x*/null" "[1,]" "[,1]" "{\"a\":1,}" "{a:1}" "{\"a\" 1}"
      "\"\\x41\"" "\"\\u12\"" "\"a\nb\"" "\"unterminated"))

  (test "independent Node confirms original source JSON behavior before WASM emission"
    (async ()
      (let ((file (resolve directory "source.mjs")))
        (await (writeFile file javascript))
        (let ((child (spawnSync "node"
                       (js-array node-helper "--check-source" (get (pathToFileURL file) :href))
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "valid JSON grammar, exact numbers, duplicate keys and surrogate strings round trip inside WASM"
    (lambda ()
      (let ((a (get (instance) :a)))
        (js-call valid :forEach
          (lambda (text)
            (let* ((x (js-call a :string text))
                   (out (js-call a :invoke "canonical-value" (js-array x))))
              (js-call assert :equal (js-call a :readString out) (js-call js :canonical_value text) text)
              (js-call a :release x)
              (js-call a :release out)
              (js-call a :collect)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
        (let* ((text (js-call a :string "{\"__proto__\":7}"))
               (out (js-call a :invoke "parse-value" (js-array text)))
               (key (js-call a :string "__proto__")))
          (js-call assert :equal (js-call a :invoke "own-value" (js-array out key)) t)
          (let ((value (js-call a :invoke "key-value" (js-array out key))))
            (js-call assert :equal (js-call a :readNumber value) 7)
            (finish a (js-array text out key value)))))))

  (test "invalid JSON is rejected without leaking frames or losing an earlier argument effect"
    (lambda ()
      (let* ((a (get (instance) :a))
             (held (js-call a :number -0.0))
             (outer (js-call a :frame 1)))
        (js-call a :frameSet outer 0 held)
        (js-call invalid :forEach
          (lambda (text)
            (js-call assert :throws (lambda () (js-call js :parse_value text)) globalThis.SyntaxError)
            (let ((x (js-call a :string text))
                  (trace (js-call a :sourceObject (js-object))))
              (js-call assert :throws
                (lambda () (js-call a :invoke "parse-extra" (js-array x trace)))
                (lambda (e)
                  (let ((diag (if (nullish? e) undefined (get e :eliscriptDiagnostic))))
                    (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (let* ((key (js-call a :string "visited"))
                     (visited (js-call a :objectGet trace key)))
                (js-call assert :equal (js-call a :readNumber visited) 7)
                (js-call (js-array x trace key visited) :forEach
                  (lambda (v) (js-call a :release v)))))))
        (funcall assert (Object/is (js-call a :readNumber held) -0.0))
        (js-call a :leaveFrame outer)
        (finish a (js-array held)))))

  (test "stringify preserves omission, holes, integer key order, nonfinite numbers, indentation and property lists"
    (lambda ()
      (let* ((a (get (instance) :a))
             (raw-text (str "中😀" (String/fromCharCode 55296) (String/fromCharCode 0) "\n\"\\"))
             (text (js-call a :string raw-text))
             (nan (js-call a :number globalThis.NaN))
             (zero (js-call a :number -0.0))
             (space (js-call a :number 2))
             (array (js-call a :sourceArray (js-array undefined nan text zero)))
             (_ (js-call a :resize array 6))
             (object (js-call a :sourceObject
                       (js-object "2" text :b array :a undefined :nan nan :zero zero)))
             (ref-arr (let ((arr (js-array undefined globalThis.NaN raw-text -0.0)))
                        (put arr :length 6)
                        arr))
             (reference (js-object "2" raw-text :b ref-arr :a undefined :nan globalThis.NaN :zero -0.0)))
        (js-call
          (js-array
            (js-array "stringify-value" (js-array object) (JSON/stringify reference))
            (js-array "pretty-value" (js-array object space) (JSON/stringify reference nil 2)))
          :forEach
          (lambda (triple)
            (let ((out (js-call a :invoke (aref triple 0) (aref triple 1))))
              (js-call assert :equal (js-call a :readString out) (aref triple 2))
              (js-call a :release out))))
        (let* ((bkey (js-call a :string "b"))
               (nkey (js-call a :string "nan"))
               (keys (js-call a :sourceArray (js-array bkey nkey bkey)))
               (gap (js-call a :string "😀abcdefghijk"))
               (selected (js-call a :invoke "select-value" (js-array object keys gap))))
          (js-call assert :equal
            (js-call a :readString selected)
            (JSON/stringify reference (js-array "b" "nan" "b") "😀abcdefghijk"))
          (js-call assert :equal (js-call a :invoke "stringify-value" (js-array undefined)) undefined)
          (js-call assert :equal (js-call a :invoke "same-parser") t)
          (finish a (js-array text nan zero space array object bkey nkey keys gap selected))))))

  (test "empty String builtin results are sealed source strings and work in subsequent source methods"
    (async ()
      (let* ((source "(defun f () (js-call (funcall (js* \"String\")) :trim)) (export f)")
             (ir (js-call (get b :compiler) :compile_ir_string source "empty-string.eli"))
             (ref (await (funcall dyn-import
                           (str "data:text/javascript;base64,"
                                (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string ir)) :toString "base64"))))))
        (js-call assert :equal (js-call ref :f) "")
        (let ((a (instantiateManagedRuntime
                   (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir rt)))))
          (js-call a :auto 1)
          (let ((out (js-call a :invoke "f")))
            (js-call assert :equal (js-call a :readString out) "")
            (js-call a :release out)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))

  (test "numeric JSON values preserve exact bits and indentation uses the first ten UTF16 units or clamped integer spaces"
    (lambda ()
      (let* ((a (get (instance) :a))
             (one (js-call a :number 1))
             (object (js-call a :sourceObject (js-object :a one))))
        (js-call
          (js-array "-0" "-1e-9999" "5e-324" "2.2250738585072014e-308" "1.7976931348623157e308" "1e9999" "9007199254740993")
          :forEach
          (lambda (text)
            (let* ((x (js-call a :string text))
                   (out (js-call a :invoke "parse-value" (js-array x))))
              (funcall assert (Object/is (js-call a :readNumber out) (JSON/parse text)) text)
              (js-call a :release x)
              (js-call a :release out))))
        (js-call
          (js-array "" "x" (String/fromCharCode 55296) "123456789😀" "😀abcdefghijk"
                    -0.0 (- globalThis.Infinity) globalThis.Infinity globalThis.NaN -2 1.9 12)
          :forEach
          (lambda (space)
            (let* ((gap (if (= (funcall js-typeof space) "number")
                            (js-call a :number space)
                            (js-call a :string space)))
                   (out (js-call a :invoke "pretty-value" (js-array object gap))))
              (js-call assert :equal
                (js-call a :readString out)
                (JSON/stringify (js-object :a 1) nil space))
              (js-call a :release gap)
              (js-call a :release out))))
        (finish a (js-array one object)))))

  (test "deterministic ordinary JSON trees and grammar mutations match independent Node models under collecting GC"
    (async ()
      (let* ((a (get (instance) :a))
             (seed 1762688499)
             (strings (js-array
                        ""
                        "中😀"
                        (String/fromCharCode 55296)
                        (String/fromCharCode 56320)
                        (str (String/fromCharCode 0) (String/fromCharCode 8) "\n")
                        (str "\"\\/" (String/fromCharCode 8232))
                        "__proto__"))
             (obj-keys (js-array "a" "2" "1" "__proto__" ""))
             (next-rand
               (lambda ()
                 (setq seed (funcall u32 (+ (Math/imul seed 1664525) 1013904223)))
                 seed)))
        (let ((gen-value nil))
          (setq gen-value
            (lambda (depth)
              (let ((choice (% (funcall next-rand) (if (> depth 0) 7 5))))
                (cond
                  ((= choice 0) nil)
                  ((= choice 1) (= (% (funcall next-rand) 2) 1))
                  ((= choice 2) (aref strings (% (funcall next-rand) (get strings :length))))
                  ((< choice 5)
                   (let* ((mant (- (funcall next-rand) 2147483648))
                          (exp (- (% (funcall next-rand) 601) 300)))
                     (* mant (funcall js-pow 10 exp))))
                  ((= choice 5)
                   (let ((len (% (funcall next-rand) 4)))
                     (Array/from (js-object :length len) (lambda () (funcall gen-value (- depth 1))))))
                  (t
                   (let ((entries (js-array))
                         (i (% (funcall next-rand) 4)))
                     (while (> i 0)
                       (let* ((k (aref obj-keys (% (funcall next-rand) 5)))
                              (v (funcall gen-value (- depth 1))))
                         (js-call entries :push (js-array k v)))
                       (setq i (- i 1)))
                     (Object/fromEntries entries)))))))
          (let ((records (js-array)))
            (js-call a :collect)
            (let ((baseline (js-call a :live))
                  (i 0))
              (while (< i 256)
                (let* ((text (JSON/stringify (funcall gen-value 4)))
                       (x (js-call a :string text))
                       (out (js-call a :invoke "canonical-value" (js-array x)))
                       (expected (js-call js :canonical_value text)))
                  (js-call assert :equal (js-call a :readString out) expected text)
                  (js-call records :push (js-object :text text :expected expected))
                  (js-call a :release x)
                  (js-call a :release out)
                  (js-call a :collect)
                  (js-call assert :equal (js-call a :live) baseline)
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                  (let ((bad (js-call a :string (str text "#"))))
                    (js-call assert :throws
                      (lambda () (js-call a :invoke "parse-value" (js-array bad)))
                      (lambda (e)
                        (let ((diag (if (nullish? e) undefined (get e :eliscriptDiagnostic))))
                          (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
                    (js-call a :release bad)
                    (js-call a :collect)
                    (js-call assert :equal (js-call a :live) baseline)))
                (setq i (+ i 1))))
            (finish a)
            (let ((file (resolve directory "models.json")))
              (await (writeFile file (JSON/stringify records)))
              (let ((child (spawnSync "node"
                             (js-array node-helper "--check-models" file)
                             (js-object :encoding "utf8" :timeout 30000))))
                (js-call assert :equal (get child :status) 0 (get child :stderr))))))))
    30000)

  (test "cyclic values are rejected while repeated shared children stringify independently without retained roots"
    (lambda ()
      (let* ((a (get (instance) :a))
             (key (js-call a :string "self"))
             (cycle (js-call a :sourceObject (js-object))))
        (js-call a :objectSet cycle key cycle)
        (let ((reference (js-object)))
          (put reference :self reference)
          (js-call assert :throws (lambda () (JSON/stringify reference)) globalThis.TypeError))
        (let* ((held (js-call a :number -0.0))
               (outer (js-call a :frame 1)))
          (js-call a :frameSet outer 0 held)
          (js-call assert :throws
            (lambda () (js-call a :invoke "stringify-value" (js-array cycle)))
            (lambda (e)
              (let ((diag (if (nullish? e) undefined (get e :eliscriptDiagnostic))))
                (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (funcall assert (Object/is (js-call a :readNumber held) -0.0))
          (js-call a :leaveFrame outer)
          (let* ((child (js-call a :sourceObject (js-object :x held)))
                 (shared (js-call a :sourceArray (js-array child child)))
                 (out (js-call a :invoke "stringify-value" (js-array shared))))
            (js-call assert :equal (js-call a :readString out) "[{\"x\":0},{\"x\":0}]")
            (finish a (js-array key cycle held child shared out)))))))

  (test "the original callback JSON inputs execute their reviver replacer and toJSON transformations exactly"
    (async ()
      (let* ((source "(defconst input \"1\") (defun f () (js-call (js* \"JSON\") :parse input (lambda (key value) value))) (defun g () (JSON/stringify 1 (lambda (key value) value))) (defun factory () (lambda (key) 7)) (defun h (x) (JSON/stringify x)) (export f g factory h)")
             (ir (js-call (get b :compiler) :compile_ir_string source "json-callbacks.eli"))
             (ref (await (funcall dyn-import
                           (str "data:text/javascript;base64,"
                                (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string ir)) :toString "base64"))))))
        (js-call assert :equal (js-call ref :f) 1)
        (js-call assert :equal (js-call ref :g) "1")
        (js-call assert :equal (js-call ref :h (js-object :toJSON (js-call ref :factory))) "7")
        (let* ((a (instantiateManagedRuntime
                    (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir rt))))
               (_ (js-call a :auto 1))
               (parsed (js-call a :invoke "f"))
               (stringified (js-call a :invoke "g")))
          (js-call assert :equal (js-call a :readNumber parsed) (js-call ref :f))
          (js-call assert :equal (js-call a :readString stringified) (js-call ref :g))
          (let* ((f (js-call a :invoke "factory"))
                 (object (js-call a :sourceObject (js-object :toJSON f)))
                 (output (js-call a :invoke "h" (js-array object))))
            (js-call assert :equal
              (js-call a :readString output)
              (js-call ref :h (js-object :toJSON (js-call ref :factory))))
            (finish a (js-array parsed stringified f object output)))))))

  (test "parsed objects retain ordinary prototype assignment while parsed __proto__ stays an own data property"
    (lambda ()
      (let ((control (js-call js :parse_value "{}")))
        (js-call js :set_value control "__proto__" (js-object :inherited 7))
        (js-call assert :equal (get control :inherited) 7)
        (js-call assert :equal (Object/hasOwn control "__proto__") false))
      (let* ((a (get (instance) :a))
             (text (js-call a :string "{}"))
             (object (js-call a :invoke "parse-value" (js-array text)))
             (n (js-call a :number 7))
             (prototype (js-call a :sourceObject (js-object :inherited n)))
             (key (js-call a :string "__proto__"))
             (field (js-call a :string "inherited"))
             (assigned (js-call a :invoke "set-value" (js-array object key prototype))))
        (js-call a :release assigned)
        (js-call assert :equal (js-call a :invoke "own-value" (js-array object key)) false)
        (let ((out (js-call a :invoke "key-value" (js-array object field))))
          (js-call assert :equal (js-call a :readNumber out) 7)
          (finish a (js-array text object n prototype key field out))))))

  (test "large UTF16 JSON output grows actual memory and deep or capacity failures preserve caller roots"
    (lambda ()
      (let* ((a (get (instance (js-object :maxSlots 4096 :initialBytes 131072 :maxBytes 4194304)) :a))
             (_ (js-call a :auto 4096))
             (unit (str "中😀" (String/fromCharCode 55296) (String/fromCharCode 0) "\n\"\\"))
             (original (js-call unit :repeat 10000))
             (input (js-call a :string (JSON/stringify (js-array original))))
             (out (js-call a :invoke "canonical-value" (js-array input))))
        (js-call assert :equal (js-call a :readString out) (JSON/stringify (js-array original)))
        (funcall assert (> (get (js-call a :stats) :capacityBytes) 131072))
        (funcall assert (> (get (js-call a :stats) :collections) 0))
        (js-call a :release input)
        (js-call a :release out)
        (let* ((text (js-call a :string (str (js-call "[" :repeat 513) "0" (js-call "]" :repeat 513))))
               (held (js-call a :number -0.0))
               (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 held)
          (js-call assert :throws
            (lambda () (js-call a :invoke "parse-value" (js-array text)))
            (lambda (e)
              (let ((diag (if (nullish? e) undefined (get e :eliscriptDiagnostic))))
                (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (funcall assert (Object/is (js-call a :readNumber held) -0.0))
          (js-call a :leaveFrame frame)
          (finish a (js-array text held))))
      (let* ((small (get (instance (js-object :maxSlots 128 :initialBytes 4096 :maxBytes 16384)) :a))
             (nums (Array/from (js-object :length 1000) (lambda (_v i) i)))
             (many (js-call small :string (str "[" (js-call nums :join ",") "]")))
             (saved (js-call small :number -0.0))
             (outer (js-call small :frame 1)))
        (js-call small :frameSet outer 0 saved)
        (js-call assert :throws
          (lambda () (js-call small :invoke "parse-value" (js-array many)))
          (lambda (e)
            (let ((diag (if (nullish? e) undefined (get e :eliscriptDiagnostic))))
              (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
        (js-call assert :equal (get (js-call small :stats) :frameDepth) 1)
        (funcall assert (Object/is (js-call small :readNumber saved) -0.0))
        (js-call small :leaveFrame outer)
        (finish small (js-array many saved))))
    30000)

  (test "actual parser and writer WASM traps release private frames and preserve earlier conversion failures"
    (async ()
      (let ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8"))))
        (js-call
          (js-array
            (js-array "heap-json-take" "heap text state" "parse-value" "1")
            (js-array "heap-json-write" "heap builder unit" "stringify-value" "x"))
          :forEach
          (lambda (quad)
            (let* ((helper (aref quad 0))
                   (args (aref quad 1))
                   (entry (aref quad 2))
                   (input (aref quad 3))
                   (start (js-call source :indexOf (str "  (defun " helper " ")))
                   (end (js-call source :indexOf "  (defun " (+ start 3))))
              (funcall assert (and (>= start 0) (> end start)))
              (let* ((injected
                       (js-call (get b :compiler) :compile_ir_string
                         (str (js-call source :slice 0 start)
                              "(defun " helper " (" args ") (load-u32 4294967295))\n"
                              (js-call source :slice end))
                         "json-trap.eli"))
                     (a (instantiateManagedRuntime
                          (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p injected))))
                     (_ (js-call a :auto 1))
                     (x (js-call a :string input))
                     (held (js-call a :number -0.0))
                     (frame (js-call a :frame 1)))
                (js-call a :frameSet frame 0 held)
                (js-call assert :throws
                  (lambda () (js-call a :invoke entry (js-array x)))
                  globalThis.WebAssembly.RuntimeError)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                (js-call assert :equal (js-call a :readString x) input)
                (funcall assert (Object/is (js-call a :readNumber held) -0.0))
                (when (= entry "parse-value")
                  (js-call assert :throws
                    (lambda () (JSON/parse (js-object :toString false :valueOf false)))
                    globalThis.TypeError)
                  (let ((bad (js-call a :sourceObject (js-object :toString false :valueOf false))))
                    (js-call assert :throws
                      (lambda () (js-call a :invoke entry (js-array bad)))
                      (lambda (e)
                        (let ((diag (if (nullish? e) undefined (get e :eliscriptDiagnostic))))
                          (= (if diag (get diag :code) undefined) "ELI-RT0003"))))
                    (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                    (js-call a :release bad)))
                (js-call a :leaveFrame frame)
                (finish a (js-array x held)))))))))

  (test "standalone and linked JSON or Array namespace shadows retain ordinary callable lookup and effects"
    (async ()
      (let* ((source "(defconst JSON (js-object :parse (lambda (x extra) extra) :stringify (lambda (x) 41))) (defconst Array (js-object :isArray (lambda (x) 43))) (defun f (x trace) (js-call (js* \"JSON\") :parse x (put trace :visited 37))) (defun g (x) (JSON/stringify x)) (defun a (x) (js-call (js* \"Array\") :isArray x)) (export f g a)")
             (ir (js-call (get b :compiler) :compile_ir_string source "shadow.eli"))
             (ref (await (funcall dyn-import
                           (str "data:text/javascript;base64,"
                                (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string ir)) :toString "base64")))))
             (trace (js-object)))
        (js-call assert :equal (js-call ref :f "x" trace) 37)
        (js-call assert :equal (get trace :visited) 37)
        (js-call assert :equal (js-call ref :g "x") 41)
        (js-call assert :equal (js-call ref :a "x") 43)
        (let ((entry (js-call (get b :compiler) :compile_ir_string "(module main (import \"./shadow.mjs\" f g a) (export f g a))" "entry.eli")))
          (js-call
            (js-array
              (js-call (get b :managed) :emit_managed_wasm ir rt)
              (js-call (get b :managed) :emit_managed_project_wasm
                (js-array
                  (js-object :id "shadow.mjs" :program ir)
                  (js-object :id "entry.mjs" :program entry))
                "entry.mjs"
                rt))
            :forEach
            (lambda (raw-bytes)
              (let* ((a (instantiateManagedRuntime (Uint8Array/from raw-bytes)))
                     (_ (js-call a :auto 1))
                     (x (js-call a :string "x"))
                     (seen (js-call a :sourceObject (js-object))))
                (js-call
                  (js-array
                    (js-array "f" (js-array x seen) 37)
                    (js-array "g" (js-array x) 41)
                    (js-array "a" (js-array x) 43))
                  :forEach
                  (lambda (triple)
                    (let ((out (js-call a :invoke (aref triple 0) (aref triple 1))))
                      (js-call assert :equal (js-call a :readNumber out) (aref triple 2))
                      (js-call a :release out))))
                (let* ((key (js-call a :string "visited"))
                       (visited (js-call a :objectGet seen key)))
                  (js-call assert :equal (js-call a :readNumber visited) 37)
                  (finish a (js-array x seen key visited))))))))))

  (test "Node executes the identical zero-import JSON WASM against its own JSON grammar and exact output"
    (async ()
      (let* ((inst (instance))
             (a (get inst :a))
             (bytes (get inst :bytes)))
        (finish a)
        (let ((wasm (resolve directory "json.wasm"))
              (cases (resolve directory "cases.json")))
          (await (writeFile wasm bytes))
          (await (writeFile cases (JSON/stringify (js-object :valid valid :invalid invalid))))
          (let ((child (spawnSync "node"
                         (js-array node-helper "--check-wasm"
                           (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                           wasm
                           cases)
                         (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (get child :stderr)))))))

  (test "the original RegExp property list input preserves its implemented lastIndex reflection"
    (async ()
      (let* ((source "(defconst pattern (js* \"/a/\")) (defun f () (JSON/stringify pattern (js-array \"lastIndex\"))) (defun g () (JSON/stringify pattern)) (export f g)")
             (ir (js-call (get b :compiler) :compile_ir_string source "json-regexp.eli"))
             (ref (await (funcall dyn-import
                           (str "data:text/javascript;base64,"
                                (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string ir)) :toString "base64"))))))
        (js-call assert :equal (js-call ref :f) "{\"lastIndex\":0}")
        (js-call assert :equal (js-call ref :g) "{}")
        (let* ((a (instantiateManagedRuntime
                    (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir rt))))
               (_ (js-call a :auto 1))
               (out (js-call a :invoke "g"))
               (selected (js-call a :invoke "f")))
          (js-call assert :equal (js-call a :readString out) "{}")
          (js-call assert :equal (js-call a :readString selected) (js-call ref :f))
          (finish a (js-array out selected))))))

  (test "Given cold JSON methods When the namespace escapes and its four methods change Then identity getters receivers deletion and callee capture match independent Node"
    (async ()
      (let ((file (resolve directory "json-namespace-reference.mjs")))
        (await (writeFile file namespace-javascript))
        (let ((child (spawnSync "node"
                       (js-array node-helper "--check-namespace" (get (pathToFileURL file) :href))
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))
          (let* ((expected (JSON/parse (get child :stdout)))
                 (a (instantiateManagedRuntime namespace-bytes))
                 (_ (js-call a :auto 1))
                 (held (js-call a :number -0.0))
                 (frame (js-call a :frame 1))
                 (observe
                   (lambda (trace)
                     (let ((values (js-object)))
                       (js-call
                         (js-array
                           (js-array "order" "string" undefined)
                           (js-array "reads" "number" 0)
                           (js-array "calls" "number" 0)
                           (js-array "getterThis" "boolean" false)
                           (js-array "callThis" "boolean" false)
                           (js-array "extra" "number" nil))
                         :forEach
                         (lambda (spec)
                           (let* ((name (aref spec 0))
                                  (ty (aref spec 1))
                                  (fallback (aref spec 2))
                                  (key (js-call a :string name))
                                  (value undefined))
                             (try
                               (setq value (js-call a :objectGet trace key))
                               (put values name
                                 (cond
                                   ((undefined? value) fallback)
                                   ((= ty "string") (js-call a :readString value))
                                   ((= ty "number") (js-call a :readNumber value))
                                   (t value)))
                               (finally
                                 (js-call a :release key)
                                 (when (and (not (undefined? value)) (/= ty "boolean"))
                                   (js-call a :release value)))))))
                       values))))
            (js-call a :frameSet frame 0 held)
            (try
              (js-call assert :equal (js-call a :invoke "namespace-cold-identities") t)
              (js-call assert :equal (js-call a :invoke "namespace-escaped-identities") t)
              (js-call expected :forEach
                (lambda (record)
                  (let* ((key (js-call a :string (get record :key)))
                         (descriptor (js-call a :invoke "namespace-descriptor" (js-array key)))
                         (input (js-call a :string "payload"))
                         (captured (js-call a :sourceObject (js-object :mutate t)))
                         (noncallable (js-call a :sourceObject (js-object)))
                         (deleted (js-call a :sourceObject (js-object)))
                         (result undefined))
                    (try
                      (js-call assert :equal (js-call a :invoke "namespace-metadata-valid" (js-array key descriptor)) t)
                      (js-call a :invoke "namespace-install" (js-array key captured t))
                      (setq result (js-call a :invoke "namespace-call" (js-array key captured input)))
                      (js-call assert :equal (js-call a :readString result) "payload")
                      (js-call a :release result)
                      (setq result undefined)
                      (js-call assert :equal (js-call a :invoke "namespace-read" (js-array key)) nil)
                      (js-call assert :deepEqual
                        (funcall observe captured)
                        (get record :captured)
                        (str (get record :key) ": callee and both receivers precede argument replacement"))
                      (js-call a :invoke "namespace-restore" (js-array key descriptor))
                      (js-call assert :equal (js-call a :invoke "namespace-escaped-identities") t)
                      (js-call a :invoke "namespace-install" (js-array key noncallable false))
                      (js-call assert :throws
                        (lambda () (js-call a :invoke "namespace-call" (js-array key noncallable input)))
                        (lambda (error)
                          (and (funcall js-instanceof error globalThis.TypeError)
                               (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
                                 (= (if diag (get diag :code) undefined) "ELI-RT0003")))))
                      (js-call assert :deepEqual
                        (funcall observe noncallable)
                        (get record :noncallable)
                        (str (get record :key) ": both arguments precede noncallable refusal"))
                      (js-call a :invoke "namespace-restore" (js-array key descriptor))
                      (js-call assert :equal (js-call a :invoke "namespace-delete" (js-array key)) t)
                      (js-call assert :equal (js-call a :invoke "namespace-own" (js-array key)) false)
                      (js-call assert :equal (js-call a :invoke "namespace-read" (js-array key)) undefined)
                      (js-call assert :throws
                        (lambda () (js-call a :invoke "namespace-call" (js-array key deleted input)))
                        (lambda (error)
                          (and (funcall js-instanceof error globalThis.TypeError)
                               (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
                                 (= (if diag (get diag :code) undefined) "ELI-RT0003")))))
                      (js-call assert :equal (js-call a :invoke "namespace-own" (js-array key)) false)
                      (js-call assert :equal (js-call a :invoke "namespace-read" (js-array key)) undefined)
                      (js-call assert :deepEqual
                        (funcall observe deleted)
                        (get record :deleted)
                        (str (get record :key) ": deleted methods stay absent"))
                      (finally
                        (try
                          (js-call a :invoke "namespace-restore" (js-array key descriptor))
                          (finally
                            (js-call (js-array result key descriptor input captured noncallable deleted) :forEach
                              (lambda (v)
                                (unless (undefined? v)
                                  (js-call a :release v)))))))))
                  (js-call assert :equal (js-call a :invoke "namespace-escaped-identities") t)
                  (js-call a :collect)
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                  (funcall assert (Object/is (js-call a :readNumber held) -0.0))))
              (finally
                (js-call a :leaveFrame frame)
                (finish a (js-array held))))))))
    30000))
