(module tests.wasm-memory-cond.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" buildBackends)

  (defvar directory undefined)
  (defvar backend undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-word-cond-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory)))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun word (source)
    (let* ((ir (js-call (get backend :compiler) :compile_ir_string source "word-cond.eli"))
           (bytes (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm ir)))
           (mod (new globalThis.WebAssembly.Module bytes)))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports mod) (js-array))
      (get (new globalThis.WebAssembly.Instance mod) :exports)))

  (test "word cond preserves discarded bodies, nested statements and exhaustive values" (lambda ()
    (let ((e (word "(import \"eliscript:memory32\" load-u32 store-u32)\n    (defun run (n)\n      (store-u32 0 0)\n      (cond\n        ((= n 1) (when t (store-u32 0 7)) (store-u32 0 (+ (load-u32 0) 2)))\n        (t (unless false (store-u32 0 3))))\n      (if (= n 9) (cond (t (when t (store-u32 0 11)))) 0)\n      (load-u32 0))\n    (defun value (n) (cond ((< n 3) (+ n 1)) ((= n 3) 7) (t 9)))\n    (defun unmatched (n) (store-u32 0 5) (cond ((= n 1) (store-u32 0 8))) (load-u32 0))\n    (defun empty () (cond) 42)\n    (export run value unmatched empty)")))
      (js-call assert :equal (js-call e :run 1) 9)
      (js-call assert :equal (js-call e :run 2) 3)
      (js-call assert :equal (js-call e :run 9) 11)
      (js-call (js-array 0 1 2 3 4 4294967295) :forEach
        (lambda (n)
          (js-call assert :equal (js-call e :value n)
            (cond ((< n 3) (+ n 1)) ((= n 3) 7) (t 9)))))
      (js-call assert :equal (js-call e :unmatched 1) 8)
      (js-call assert :equal (js-call e :unmatched 2) 5)
      (js-call assert :equal (js-call e :empty) 42))))

  (test "word cond evaluates a test-only clause once and preserves its boolean value" (lambda ()
    (let ((e (word "(import \"eliscript:memory32\" load-u32 store-u32)\n    (defun run (n)\n      (store-u32 0 0)\n      (let ((result (if (cond ((progn (store-u32 0 (1+ (load-u32 0))) (= n 1))) (t false)) 7 9)))\n        (+ (* (load-u32 0) 100) result)))\n    (export run)")))
      (js-call assert :equal (js-call e :run 1) 107)
      (js-call assert :equal (js-call e :run 2) 109))))

  (test "cond keeps consumed when and implicit nil outside the numeric result ABI" (lambda ()
    (js-call
      (js-array
        "(defun bad (n) (cond ((= n 1) (when t 7)) (t 9))) (export bad)"
        "(defun bad (n) (let ((x (cond ((= n 1) (unless false 7)) (t 9)))) x)) (export bad)"
        "(defun bad (n) (cond ((= n 1) 7))) (export bad)"
        "(defun bad (n) (cond (t 7) ((= n 1) \"dead\"))) (export bad)")
      :forEach
      (lambda (source)
        (js-call assert :throws
          (lambda () (word source))
          (lambda (error)
            (let ((diag (get error :eliscriptDiagnostic)))
              (and diag (= (get diag :code) "ELI-B0001")))))))
    (let ((ir (js-call (get backend :compiler) :compile_ir_string "(defun bad (n) (cond ((< n 1) 7))) (export bad)" "numeric-cond.eli")))
      (js-call assert :throws
        (lambda () (js-call (get backend :numeric) :lower_numeric_program ir))
        (lambda (error)
          (let ((diag (get error :eliscriptDiagnostic)))
            (and diag (= (get diag :code) "ELI-B0001"))))))
    (let* ((valid (js-call (get backend :compiler) :compile_ir_string "(defun run (n) (cond ((< n 1) 7) (t (+ n 2)))) (export run)" "numeric-cond.eli"))
           (bytes (Uint8Array/from (js-call (get backend :wasm) :emit_numeric_wasm valid)))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports)))
      (js-call assert :equal (js-call e :run 0) 7)
      (js-call assert :equal (js-call e :run 3) 5)))))
