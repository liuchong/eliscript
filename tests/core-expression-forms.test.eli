(module tests.core-expression-forms
  (import "bun:test" test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst root (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst units (js-array (js-array "tests/fixtures/core-expression-forms.eli" "tests/fixtures/core-expression-forms.mjs")))
  (defconst hostFixture (resolve root "tests/fixtures/core-expression-forms-host.mjs"))
  (defasync compileFamily (command outputRoot environment)
    (await (mkdir outputRoot (js-object :recursive t)))
    (let ((index 0))
      (while (< index (js-length units))
        (let* ((unit (aref units index)) (target (resolve outputRoot (aref unit 1))))
          (await (mkdir (dirname target) (js-object :recursive t)))
          (await (runSuccessful (js-array command "--source-map" "--output" target (resolve root (aref unit 0))) environment)))
        (setq index (1+ index)))))
  (test "core expression forms preserve threading and single-evaluation semantics" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-core-forms-"))))
           (bootstrapDirectory (resolve directory "bootstrap")) (seedDirectory (resolve directory "seed")) (selfHostedDirectory (resolve directory "self-hosted")))
      (try
        (await (compileFamily (resolve root "bin/eliscript-seed") seedDirectory (js-object)))
        (await (seedCompilerFixture bootstrapDirectory))
        (await (compileFamily (resolve root "bin/eliscript-portable") selfHostedDirectory (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))
        (let ((index 0))
          (while (< index (js-length units))
            (let* ((relative (aref (aref units index) 1)) (seed (resolve seedDirectory relative)) (selfHosted (resolve selfHostedDirectory relative)))
              (be (await (readFile selfHosted "utf8")) (await (readFile seed "utf8")))
              (be (await (readFile (str selfHosted ".map") "utf8")) (await (readFile (str seed ".map") "utf8"))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (directories (js-array seedDirectory selfHostedDirectory)) (index 0))
          (while (< index 2)
            (let* ((modulePath (resolve (aref directories index) "tests/fixtures/core-expression-forms.mjs"))
                   (argument (get (pathToFileURL modulePath) :href)))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array "bun" "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs") hostFixture argument) (js-object)))))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array (get (get globalThis.process :env) :NODE "node") "--experimental-loader" (resolve root "tests/fixtures/compiled-eli-node-loader.mjs") hostFixture argument) (js-object))))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (aref reports 0) (js-object "threadFirst" 8 "threadLast" 8 "named" 8 "conditionalFirst" (js-array 3 1 2) "conditionalLast" (js-array 1 2 3) "someFirst" (js-array 3 1 2) "someLast" (js-array 1 2 3) "someNil" nil "someFalse" false "someUndefined" "continued" "captureSafe" 11 "conditionalNoop" 4 "someNoop" 5 "events" (js-array "initial" "test-false" "test-true" "selected") "ifLetFalse" "missing" "ifLetValue" 8 "ifSomeFalse" false "ifSomeUndefined" "present" "ifSomeNil" "missing" "whenLetValue" 15 "whenSomeFalse" "missing" "calls" 20)))

        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
