(module tests.markdown-wire.test
  (import "bun:test" expect test)
  (import "../runtime/wire/markdown.mjs" parse encode)
  (import "../runtime/wire/schema.mjs" validate)
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun rejects (operation &rest __host_default_arguments_1)
    (let* ((message (aref __host_default_arguments_1 0))) (if (= message undefined) (js-call (expect operation) :toThrow) (js-call (expect operation) :toThrow message))))
  (test "structured Markdown preserves nested data, comments, tables and element arrays" (lambda ()
    (let ((data (js-object "version" "001" "User" (js-object "name" "\u5c0f\u660e" "nested" (js-object "ok" t) "values" (js-array 1 nil "a|b") "rows" (js-array (js-object "a" 1 "b" "x") (js-object "b" false)) "mixed" (js-array (js-object "one" 1) (js-array 2) "x"))))) (same (parse (encode data)) data))
    (same (parse "<!--\n# hidden\n-->\n```md\n- hidden: 1\n```\n# A\n- key: \\x\n### note\n## B\n- x: \"\\q\"\n") (js-object "A" (js-object "key" "\\x" "B" (js-object "x" "\\q"))))
    (same (parse "# A\n| a | b |\n| --- | --- |\n| | null |\n") (js-object "A" (js-array (js-object "b" nil))))
    (same (parse "# A\n- a:\n  - :\n    - k: 2\n  - : false\n") (js-object "A" (js-object "a" (js-array (js-object "k" 2) false))))
    (same (parse "- __proto__:\n  - polluted: true\n") (JSON/parse "{\"__proto__\":{\"polluted\":true}}"))
    (js-call (expect (get (js-object) :polluted)) :toBeUndefined)))
  (test "structural errors carry protocol codes and one-based lines" (lambda ()
    (let ((cases (js-array (js-array "## orphan" "MDP-E001") (js-array "# A\n- x: 1\n| a | b |\n| --- | --- |" "MDP-E002") (js-array "- x: 1\n- x: 2" "MDP-E003") (js-array "# A\n| a | b |\n| --- | --- |\n| 1 |" "MDP-E004") (js-array "# A\n| a | a |\n| --- | --- |" "MDP-E005") (js-array "| a |\n| --- |" "MDP-E006") (js-array "# " "MDP-E007") (js-array "- a:\n    - b: 1" "MDP-E009") (js-array "\t- a: 1" "MDP-E009"))) (index 0))
      (while (< index (get cases :length))
        (let* ((item (aref cases index)) (source (aref item 0)) (code (aref item 1)))
          (try (parse source) (throw (new globalThis.Error "expected failure"))
            (catch error (js-call (expect (get error :code)) :toBe code) (js-call (expect (get error :line)) :toBeGreaterThan 0))))
        (setq index (1+ index))))
    (rejects (lambda () (encode (js-object :bad globalThis.NaN))))
    (rejects (lambda () (encode (js-object :bad undefined))))
    (let ((cyclic (js-object))) (put cyclic :self cyclic) (rejects (lambda () (encode cyclic))))
    (rejects (lambda () (parse "- a: 1" (js-object :maxLength 2))))
    (rejects (lambda () (parse "# ###")) "MDP-E007")
    (rejects (lambda () (parse "# A\n| value |\n| --- |\n\t| 1 |")) "MDP-E009")
    (let ((data (js-object :x "1e999" :y "\u0000\n" :z "{}" :q "[]"))) (same (parse (encode data)) data))
    (rejects (lambda () (encode (js-object :sparse (new globalThis.Array 2)))) "Sparse")
    (same (parse "<span>inline</span>\n# A\n- ok: true") (js-object :A (js-object :ok t)))))
  (test "structured wire round trips a deterministic nested value corpus" (lambda ()
    (let ((values (js-array nil t false 42 (- 1.25) "" "{}" "[]" "null" "\ud83d\ude00" "a|b" "\"quotes\"" "a\\n" "\n\t" (js-object ) (js-array ))) (index 0))
      (while (< index 128)
        (let* ((value (aref values (% index (get values :length))))
               (data (js-object :stamp index :Data (js-object :scalar value :nested (js-object :value value)
                 :records (js-array (js-object :key value :other index) (js-object :other (1+ index)))
                 :mixed (js-array value (js-object :key value) (js-array value) (js-object))))))
          (same (parse (encode data)) data))
        (setq index (1+ index))))))
  (test "schema validates open-world sections, nested paths and scalar constraints" (lambda ()
    (let ((schema (js-object "mds" "0.1" "Sections" (js-array (js-object "name" "User" "kind" "object" "required" t "additional" false)) "User" (js-array (js-object "name" "name" "type" "string" "required" t "min_len" 2) (js-object "name" "age" "type" "int" "min" 0 "max" 100)) "User.Address" (js-array (js-object "name" "zip" "type" "string" "pattern" "^\\d{5}$")))))
      (same (validate (js-object :User (js-object :name "😀中" :age 42 :Address (js-object :zip "12345")) :Extra (js-object)) schema) (js-object :valid t :errors (js-array)))
      (let ((bad (validate (js-object :User (js-object :name "x" :age "42" :unknown t :Address (js-object :zip "bad"))) schema)))
        (js-call (expect (get bad :valid)) :toBe false)
        (same (js-call (get bad :errors) :map (lambda (error) (get error :rule))) (js-call expect :arrayContaining (js-array "min_len" "type" "additional" "pattern"))))
      (js-call (expect (get (aref (get (validate (js-object) schema) :errors) 0) :rule)) :toBe "required")
      (rejects (lambda () (validate (js-object) (js-object :mds "9"))))
      (rejects (lambda () (validate (js-object) (js-object :mds "0.1" :A (js-object)))))
      (rejects (lambda () (validate (js-object) (js-object :mds "0.1" :A (js-array (js-object :name "n" :type "int" :min 5 :max 2))))) "Inverted")
      (js-call (expect (get (validate (js-object :A (js-object :d "2023-02-29")) (js-object :mds "0.1" :A (js-array (js-object :name "d" :type "date")))) :valid)) :toBe false))))
)
