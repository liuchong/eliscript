(module tests.stdlib-test-devtools
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp rm symlink)
  (import "node:path" resolve)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "../runtime/core/array-map.mjs" persistentArrayMap)
  (import "../runtime/core/collection.mjs" :as Collection)
  (import "../runtime/core/data-text.mjs" taggedLiteral)
  (import "../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../runtime/core/list.mjs" persistentList)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" withMeta)
  (import "../runtime/core/queue.mjs" persistentQueue)
  (import "../runtime/core/record.mjs" defineRecordType)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/sorted.mjs" persistentSortedMap persistentSortedSet)
  (import "../runtime/core/value.mjs" equalValues)
  (import "../runtime/core/vector.mjs" persistentVector subvec)

  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst EMACS (let ((v (get (get process :env) :EMACS))) (if (nullish? v) "emacs" v)))
  (defconst dynamic-import (js* "(url) => import(url)"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))

  (defun jsonml-flat-text (node)
    (cond
      ((nullish? node) "")
      ((= (value-type node) "string") node)
      ((Array/isArray node)
        (let ((tag (aref node 0))
              (parts (js-array)))
          (if (= tag "object")
            "<obj>"
            (let ((i 2))
              (while (< i (js-length node))
                (js-call parts :push (jsonml-flat-text (aref node i)))
                (setq i (1+ i)))
              (js-call parts :join "")))))
      (t (str node))))

  (defconst PointRecord (defineRecordType "PointRecord" (js-array "x" "y")))

  (defasync compile-stdlib (modules)
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-s4-test-devtools-"))))
           (out-root (resolve directory "stdlib")))
      (try
        (await (symlink (resolve ROOT "runtime") (resolve directory "runtime") "dir"))
        (let* ((cmd (js-call (js-array (resolve ROOT "bin/eliscript-build") "--json" "--root" (resolve ROOT "stdlib") "--out-dir" out-root "--no-cache")
                      :concat (js-call modules :map (lambda (m) (resolve ROOT (str "stdlib/" m ".eli"))))))
               (child (Bun/spawn cmd (js-object :cwd ROOT :env (Object/assign (js-object) (get process :env) (js-object :EMACS EMACS)) :stdout "pipe" :stderr "pipe")))
               (res (await (Promise/all (js-array (get child :exited)
                                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                                  (js-call (new globalThis.Response (get child :stderr)) :text))))))
          (unless (= (aref res 0) 0)
            (throw (new globalThis.Error (str "build failed: " (aref res 2) "\n" (aref res 1))))))
        (let ((loaded (js-object))
              (idx 0))
          (while (< idx (js-length modules))
            (let* ((m (aref modules idx))
                   (ns (await (funcall dynamic-import (get (pathToFileURL (resolve out-root (str m ".mjs"))) :href)))))
              (put loaded m ns))
            (setq idx (1+ idx)))
          (js-object :directory directory :mods loaded))
        (catch err
          (await (rm directory (js-object :recursive t :force t)))
          (throw err)))))

  (defasync run-test-cli (args)
    (let* ((cmd (js-call (js-array (resolve ROOT "bin/eliscript-test")) :concat args))
           (child (Bun/spawn cmd (js-object :cwd ROOT :env (Object/assign (js-object) (get process :env) (js-object :EMACS EMACS)) :stdout "pipe" :stderr "pipe")))
           (res (await (Promise/all (js-array (get child :exited)
                                              (js-call (new globalThis.Response (get child :stdout)) :text)
                                              (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :code (aref res 0) :stdout (aref res 1) :stderr (aref res 2))))

  (test "stdlib/test runs assertions, async fixtures (including on throw), and structured diff reports"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "test" "diff" "pprint" "regex"))))
             (directory (get built :directory))
             (TS (get (get built :mods) "test")))
        (try
          (let ((events (js-array)))
            (let ((rep
                    (await
                      (js-call TS :with_test_registry
                        (async ()
                          (js-call TS :use_fixtures (keyword "once")
                            (js-object
                              :before (lambda () (js-call events :push "once:before"))
                              :after (lambda () (js-call events :push "once:after"))))
                          (js-call TS :use_fixtures (keyword "each")
                            (js-object
                              :before (lambda () (js-call events :push "each:before"))
                              :after (lambda () (js-call events :push "each:after"))))
                          (js-call TS :deftest "nested diff failure"
                            (async ()
                              (js-call events :push "body:1")
                              (await (js-call TS :testing "payload"
                                       (lambda ()
                                         (js-call TS :is_equal
                                           (persistentHashMap (js-array (keyword "a") 1) (js-array (keyword "b") (persistentVector 1 2)))
                                           (persistentHashMap (js-array (keyword "a") 1) (js-array (keyword "b") (persistentVector 1 9)))))))))
                          (js-call TS :deftest "teardown runs on uncaught error"
                            (lambda ()
                              (js-call events :push "body:2")
                              (throw (new globalThis.Error "boom-in-test"))))
                          (await (js-call TS :run_all_tests (js-object :seed 909))))))))
              (be (get rep :passed) false)
              (be (get rep :seed) 909)
              (same (get rep :counts)
                (js-object :total 2 :passed 0 :failed 1 :errored 1 :skipped 0 :assertions 2 :assertionsPassed 0 :assertionsFailed 1))
              (same events (js-array "once:before" "each:before" "body:1" "each:after" "each:before" "body:2" "each:after" "once:after"))
              (let* ((f0 (aref (get (aref (get rep :results) 0) :failures) 0))
                     (human (js-call TS :test_report rep)))
                (be (get f0 :context) "payload")
                (js-call (expect (get f0 :diff)) :toContain ":b")
                (js-call (expect human) :toContain "diff [only-expected only-actual both]")
                (js-call (expect human) :toContain "boom-in-test"))))
          (finally
            (await (rm directory (js-object :recursive t :force t))))))))

  (test "bin/eliscript-test CLI discovers .test.eli files, supports --filter/--tag/--seed/--fail-fast/--json, and returns exit codes"
    (async ()
      (let* ((full (await (run-test-cli (js-array "--json" "tests/fixtures/sample.test.eli"))))
             (full-json (JSON/parse (get full :stdout))))
        (be (get full :code) 1)
        (be (get full-json :format) "eliscript-test-report")
        (be (get (get full-json :counts) :total) 3)
        (be (get (get full-json :counts) :passed) 2)
        (be (get (get full-json :counts) :failed) 1)
        (let ((fail-entry (aref (get full-json :results) 2)))
          (be (get fail-entry :status) "fail")
          (js-call (expect (get (aref (get fail-entry :failures) 0) :context)) :toBe "nested comparison")
          (js-call (expect (get (aref (get fail-entry :failures) 0) :diff)) :toContain ":roles")))
      (let* ((pass (await (run-test-cli (js-array "--json" "--filter" "passing" "--seed" "4242" "tests/fixtures/sample.test.eli"))))
             (pass-json (JSON/parse (get pass :stdout))))
        (be (get pass :code) 0)
        (be (get pass-json :seed) 4242)
        (be (get (get pass-json :counts) :total) 2)
        (be (get (get pass-json :counts) :passed) 2))
      (let* ((tagged (await (run-test-cli (js-array "--json" "--tag" "failing" "--fail-fast" "tests/fixtures/sample.test.eli"))))
             (tagged-json (JSON/parse (get tagged :stdout))))
        (be (get tagged :code) 1)
        (be (get (get tagged-json :counts) :total) 1))
      (let ((help (await (run-test-cli (js-array "--help"))))
            (bad-opt (await (run-test-cli (js-array "--seed" "abc" "tests/fixtures/sample.test.eli")))))
        (be (get help :code) 0)
        (js-call (expect (get help :stdout)) :toContain "Usage: eliscript-test")
        (be (get bad-opt :code) 1))))

  (test "stdlib/devtools renders JsonML headers/bodies across persistent types and installs idempotently"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "devtools" "state" "time" "uuid"))))
             (directory (get built :directory))
             (DT (get (get built :mods) "devtools"))
             (ST (get (get built :mods) "state"))
             (TM (get (get built :mods) "time"))
             (UU (get (get built :mods) "uuid")))
        (try
          ;; Install/uninstall idempotence on explicit mock target
          (let ((host (js-object)))
            (be (js-call DT :devtools_installed_QMARK_ host) false)
            (js-call DT :install_devtools_formatters_BANG_ host)
            (js-call DT :install_devtools_formatters_BANG_ host)
            (be (js-call DT :devtools_installed_QMARK_ host) t)
            (be (js-length (get host :devtoolsFormatters)) 1)
            (js-call DT :uninstall_devtools_formatters_BANG_ host)
            (be (js-call DT :devtools_installed_QMARK_ host) false)
            (be (js-length (get host :devtoolsFormatters)) 0))
          ;; Non-Eliscript values yield nil from format-header & false from has-body
          (be (js-call DT :format_header 42) nil)
          (be (js-call DT :format_header (js-object :plain 1)) nil)
          (be (js-call DT :has_body (js-object :plain 1)) false)
          ;; All supported persistent/value types
          (let* ((v (persistentVector 1 2 3))
                 (sv (subvec v 1 3))
                 (am (persistentArrayMap (js-array (keyword "a") 1)))
                 (hm (withMeta (persistentHashMap (js-array (keyword "a") 1) (js-array (keyword "b") 2) (js-array (keyword "c") 3)
                                 (js-array (keyword "d") 4) (js-array (keyword "e") 5) (js-array (keyword "f") 6)
                                 (js-array (keyword "g") 7) (js-array (keyword "h") 8) (js-array (keyword "i") 9))
                       (persistentHashMap (js-array (keyword "tag") "m"))))
                 (sm (persistentSortedMap (keyword "z") 2 (keyword "a") 1))
                 (ss (persistentSortedSet 3 1 2))
                 (hs (persistentHashSet 1 2))
                 (ls (persistentList 10 20))
                 (qu (persistentQueue 7 8))
                 (me (Collection/mapEntry (keyword "k") 99))
                 (rc (js-call PointRecord :create 3 4))
                 (kw (keyword "ns" "k"))
                 (sym (eliscriptSymbol "ns" "s"))
                 (tl (taggedLiteral (eliscriptSymbol "custom" "pt") (persistentVector 1 2)))
                 (u4 (js-call UU :uuid_v4))
                 (inst (js-call TM :instant 1700000000000))
                 (dur (js-call TM :duration 250))
                 (at (js-call ST :atom 12))
                 (vol (js-call ST :volatile_BANG_ 34))
                 (samples (js-array v sv am hm sm ss hs ls qu me rc tl u4 inst dur at vol)))
            (let ((i 0))
              (while (< i (js-length samples))
                (let* ((item (aref samples i))
                       (hdr (js-call DT :format_header item))
                       (hb (js-call DT :has_body item))
                       (bdy (js-call DT :format_body item)))
                  (be (Array/isArray hdr) t)
                  (be (aref hdr 0) "span")
                  (be hb t)
                  (be (Array/isArray bdy) t)
                  (be (aref bdy 0) "ol"))
                (setq i (1+ i))))
            (be (aref (js-call DT :format_header kw) 2) ":ns/k")
            (be (aref (js-call DT :format_header sym) 2) "ns/s")
            (js-call (expect (jsonml-flat-text (js-call DT :format_header v))) :toContain "PersistentVector(3)")
            (js-call (expect (jsonml-flat-text (js-call DT :format_header sv))) :toContain "SubVector(2)")
            (js-call (expect (jsonml-flat-text (js-call DT :format_header am))) :toContain "PersistentArrayMap(1)")
            (js-call (expect (jsonml-flat-text (js-call DT :format_body hm))) :toContain ":meta")
            ;; Circular atom safety
            (let ((cyc (js-call ST :atom nil)))
              (js-call ST :reset_BANG_ cyc cyc)
              (let ((hdr (js-call DT :format_header cyc (js-object :depth 1 :ancestors (js-array cyc))))
                    (bdy (js-call DT :format_body cyc)))
                (js-call (expect (jsonml-flat-text hdr)) :toContain "#circular")
                (js-call (expect (jsonml-flat-text bdy)) :toContain "@deref"))))
          (finally
            (await (rm directory (js-object :recursive t :force t))))))))

  (test "stdlib/core barrel compiles cleanly and re-exports representative core symbols across all domains"
    (async ()
      (let* ((mods (js-array "async" "collection" "core" "data" "data-text" "diff" "fn" "identifier"
                             "lazy-sequence" "meta" "pprint" "regex" "schema" "seq" "set"
                             "state" "string" "tap" "time" "transducer" "transient" "uuid" "walk"))
             (built (await (compile-stdlib mods)))
             (directory (get built :directory))
             (CR (get (get built :mods) "core")))
        (try
          (let ((mapped (js-call CR :into (persistentVector) (js-call CR :mapping (lambda (x) (* x 2))) (persistentVector 1 2 3)))
                (m (js-call CR :assoc_in (persistentHashMap) (persistentVector (keyword "a") (keyword "b")) 42))
                (v (js-call CR :volatile_BANG_ 5))
                (ch (js-call CR :chan 2)))
            (be (equalValues mapped (persistentVector 2 4 6)) t)
            (be (js-call CR :get_in m (persistentVector (keyword "a") (keyword "b"))) 42)
            (be (js-call CR :vswap_BANG_ v (lambda (x) (+ x 3))) 8)
            (be (js-call CR :valid_QMARK_ (get CR :spec_int) 10) t)
            (await (js-call CR :put_BANG_ ch "ok"))
            (be (await (js-call CR :take_BANG_ ch)) "ok")
            (be (js-call CR :uuid_QMARK_ (js-call CR :uuid_v4)) t)
            (be (js-call CR :instant_QMARK_ (js-call CR :now)) t)
            (js-call (expect (js-call CR :pprint_str m)) :toContain ":b 42")
            (be (js-call CR :capitalize "hello") "Hello"))
          (finally
            (await (rm directory (js-object :recursive t :force t))))))))
)
