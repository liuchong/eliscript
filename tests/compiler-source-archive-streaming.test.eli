(module tests.compiler-source-archive-streaming.test
  (import "bun:test" test spyOn)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs/promises" mkdtemp mkdir readFile writeFile rm access symlink)
  (import "node:fs/promises" :as fileIO)
  (import "node:os" tmpdir)
  (import "node:path" join resolve)
  (import "node:url" fileURLToPath)
  (import "../tools/backends/compiler-bootstrap.mjs" archiveCompilerSources readArchivedCompilerSources compilerSourceIdentity openCompilerArtifact)
  (defconst hostInstanceof (js* "(value, type) => value instanceof type"))
  (defun sha (bytes) (js-call (js-call (createHash "sha256") :update bytes) :digest "hex"))
  (defun assert-eq (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun rx (pattern) (new globalThis.RegExp pattern))
  (defun graph ()
    (js-object :entry "entry.mjs"
      :modules (js-array (js-object :id "entry.mjs" :filename "virtual/原😀\ud800.eli"
        :source (str "\ufeff" (js-call "x" :repeat 16382) "😀" (js-call "中é" :repeat 20000) "\ud800\0\udfff\n")))
      :runtime (js-object :filename "runtime.eli" :source (str "\ufeff" (js-call "中😀" :repeat 12000) "\n"))
      :literalSources (js-array (js-object :id "stdlib/bit.mjs" :filename "literal.eli" :source "\ufeffliteral\ud800\n"))
      ;; The archived host source is intentionally arbitrary JavaScript input,
      ;; including a lone surrogate; it is data for the exact UTF16 archive.
      :hostSources (js-array (js-object :id "provider.mjs" :filename "provider.mjs" :source "export const marker=\"\udfff\";\n"))
      :hostModules (js-array (js-object :id "provider" :referrer "entry.mjs" :specifier "./provider.mjs" :allowedExports (js-array "marker") :namespace false))
      :phased false))
  (defasync fixture (action)
    (let ((directory (await (mkdtemp (join (tmpdir) "eliscript-source-archive-stream-")))))
      (try (await (action directory)) (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defasync rewriteArchive (directory mutate)
    (let ((manifest (JSON/parse (await (readFile (join directory "source-archive.json") "utf8"))))
          (identity (JSON/parse (await (readFile (join directory "identity.json") "utf8")))))
      (await (mutate manifest identity))
      (await (writeFile (join directory "source-archive.json") (JSON/stringify manifest)))
      (await (writeFile (join directory "identity.json") (JSON/stringify identity)))))
  (defasync sourceAssetFixture (directory)
    ;; Only resource transport is synthetic. Artifact/session/source loading is
    ;; real, and the protocol stub itself is compiled from the Eli fixture.
    (let* ((javascript (await (readFile (fileURLToPath (new globalThis.URL "./fixtures/archive-session-host.mjs" (js* "import.meta.url"))))))
           (runtime (get (aref (get (graph) :modules) 0) :source)) (literal (get (get (graph) :runtime) :source))
           (files (js-array (js-array "compiler.mjs" javascript) (js-array "runtime.eli.json" (Buffer/from (JSON/stringify runtime))) (js-array "literal.eli" (Buffer/from literal))))
           (i 0))
      (while (< i (get files :length)) (let ((row (aref files i))) (await (writeFile (join directory (aref row 0)) (aref row 1)))) (setq i (1+ i)))
      (js-object :runtime runtime :literal literal :artifact
        (js-object :host "javascript" :entry "compiler.mjs" :directory directory :path "compiler.mjs" :modules (js-array (js-object :id "compiler.mjs" :path "compiler.mjs"))
          :runtimePath "runtime.eli.json" :runtimeEncoding "json-utf16" :literalSources (js-array (js-object :id "stdlib/bit.mjs" :filename "stdlib/bit.eli" :path "literal.eli"))
          :sourceIdentity (js-object :algorithm "sha256" :encoding "utf16le" :modules (js-array (js-object :id "compiler.mjs"))
            :runtime (js-object :filename "runtime.eli" :sha256 (sha (Buffer/from runtime "utf16le")))
            :literalSources (js-array (js-object :id "stdlib/bit.mjs" :filename "stdlib/bit.eli" :sha256 (sha (Buffer/from literal "utf16le")))))
          :artifactIdentity (js-object :algorithm "sha256" :files (js-call files :map (lambda (row)
            (js-object :path (aref row 0) :bytes (get (aref row 1) :length) :sha256 (sha (aref row 1))))))))))
  (test "source archives stream exact UTF16 tool bytes and metadata across bounded odd short reads and partial writes" (async ()
    (await (fixture (async (directory)
      (let* ((sources (graph)) (before (globalThis.structuredClone sources)) (originalOpen (get fileIO :open)) (originalReadFile (get fileIO :readFile))
             (reads (js-array)) (writes (js-array)) (opened 0) (closed 0))
        (put (aref (get sources :modules) 0) :filename (str "virtual/" (js-call "原😀\ud800" :repeat 6000) ".eli"))
        (put (aref (get before :modules) 0) :filename (get (aref (get sources :modules) 0) :filename))
        (let* ((openSpy (js-call (spyOn fileIO "open") :mockImplementation (async (&rest args)
                  (let ((file (await (Reflect/apply originalOpen fileIO args)))) (setq opened (1+ opened))
                    (js-object :read (async (buffer offset length position)
                        (assert (<= (get buffer :byteLength) 65536)) (assert (<= length 65536)) (js-call reads :push length)
                        (js-call file :read buffer offset (Math/min length 257) position))
                      :write (async (buffer offset length position)
                        (assert (<= (get buffer :byteLength) 65536)) (assert (<= length 65536)) (js-call writes :push length)
                        (js-call file :write buffer offset (Math/min length 997) position))
                      :close (async () (setq closed (1+ closed)) (js-call file :close)))))))
               (readSpy (js-call (spyOn fileIO "readFile") :mockImplementation (async (filename &rest args)
                  (when (js-call (resolve filename) :startsWith (str (resolve directory) "/")) (throw (new globalThis.Error "source archive must not read an entire file")))
                  (Reflect/apply originalReadFile fileIO (js-call (js-array filename) :concat args)))))
               (identity undefined) (restored undefined))
          (try (setq identity (await (archiveCompilerSources sources directory)) restored (await (readArchivedCompilerSources directory (js-object :expectedIdentity identity))))
            (finally (js-call readSpy :mockRestore) (js-call openSpy :mockRestore)))
          (same identity (compilerSourceIdentity before)) (same restored before) (same sources before "archive and read must not consume the caller graph")
          (assert (> (get reads :length) 20)) (assert (> (get writes :length) 20)) (assert-eq opened closed)
          (let* ((manifest (JSON/parse (await (readFile (join directory "source-archive.json") "utf8")))) (records (get manifest :records)) (i 0))
            (while (< i (get records :length))
              (let* ((record (aref records i)) (kind (get record :kind))
                     (source (if (= kind "runtime") (get (get before :runtime) :source)
                       (get (js-call (get before (if (= kind "module") "modules" (if (= kind "host") "hostSources" "literalSources")))
                         :find (lambda (item) (= (get item :id) (get record :id)))) :source)))
                     (raw (await (readFile (join directory (get record :path))))) (tool (await (readFile (join directory (get (get record :tool) :path))))))
                (same raw (Buffer/from source "utf16le")) (same tool (Buffer/from source "utf8"))
                (assert-eq (get record :bytes) (get raw :length)) (assert-eq (get record :sha256) (sha raw))
                (assert-eq (get (get record :tool) :bytes) (get tool :length)) (assert-eq (get (get record :tool) :sha256) (sha tool))
                (assert-eq (get (get record :tool) :lossless) (= (js-call tool :toString "utf8") source)))
              (setq i (1+ i)))))))))) 30000)
  (test "source archives synchronously snapshot only validated declaration fields and preserve first getter failures before IO" (async ()
    (await (fixture (async (directory)
      (let* ((sources (graph)) (expected (globalThis.structuredClone sources)) (reads (js-array)))
        (js-call (js-array (js-array "runtime" (get sources :runtime)) (js-array "module" (aref (get sources :modules) 0))
          (js-array "host" (aref (get sources :hostSources) 0)) (js-array "literal" (aref (get sources :literalSources) 0))) :forEach (lambda (pair)
          (let* ((kind (aref pair 0)) (record (aref pair 1)) (text (get record :source)))
            (Object/defineProperty record "source" (js-object :enumerable t :configurable t
              :get (lambda () (js-call reads :push kind) text) :set (lambda (value) (setq text value))))
            (Object/defineProperty record "unrelated" (js-object :enumerable t :get (lambda () (throw (new globalThis.Error "unused record field"))))))))
        (put sources :unrelated (lambda () 0)) (put sources :cycle sources)
        (Object/defineProperty sources "unused" (js-object :enumerable t :get (lambda () (throw (new globalThis.Error "unused root field")))))
        (let ((pending (archiveCompilerSources sources directory)))
          (same reads (js-array "runtime" "module" "host" "literal"))
          (put (aref (get sources :modules) 0) :source "next module") (put (get sources :runtime) :source "next runtime")
          (js-call (get sources :hostSources) :splice 0) (put (aref (get sources :literalSources) 0) :source "next literal")
          (js-call (get (aref (get sources :hostModules) 0) :allowedExports) :push "next") (put sources :phased t)
          (same (await pending) (compilerSourceIdentity expected)) (same (await (readArchivedCompilerSources directory)) expected)
          (same reads (js-array "runtime" "module" "host" "literal") "no source getter is reread after dispatch"))
        (let ((failure (js-object :getter "original runtime value")) (invalid (graph)) (missing (join directory "not-created")))
          (Object/defineProperty (get invalid :runtime) "source" (js-object :get (lambda () (throw failure))))
          (put (aref (get invalid :modules) 0) :id "../invalid.mjs")
          (await (js-call assert :rejects (archiveCompilerSources invalid missing) (lambda (error) (= error failure))))
          (await (js-call assert :rejects (access missing) (lambda (error) (= (get error :code) "ENOENT"))))
          (let ((badId (graph)))
            (put (aref (get badId :modules) 0) :id "../invalid.mjs")
            (Object/defineProperty (aref (get badId :modules) 0) "source" (js-object :get (lambda () (throw failure))))
            (await (js-call assert :rejects (archiveCompilerSources badId missing) (lambda (error)
              (and (funcall hostInstanceof error globalThis.TypeError) (js-call (rx "relative source identity") :test (get error :message))))))
            (await (js-call assert :rejects (access missing) (lambda (error) (= (get error :code) "ENOENT"))))))))))) 30000)
  (test "streamed source metadata retains IO then UTF8 then JSON failure priority and closes failed reads" (async ()
    (await (fixture (async (directory)
      (let ((filename (join directory "source-archive.json")))
        (await (writeFile filename (Buffer/concat (js-array (Buffer/from (str "{broken" (js-call " " :repeat 70000))) (Buffer/from (js-array 255))))))
        (await (js-call assert :rejects (readArchivedCompilerSources directory) (lambda (error) (and (funcall hostInstanceof error globalThis.TypeError) (not (funcall hostInstanceof error globalThis.SyntaxError))))))
        (let* ((originalOpen (get fileIO :open)) (first (js-object :io "read after invalid JSON")) (secondary (js-object :close "secondary")) (reads 0) (closes 0)
               (openSpy (js-call (spyOn fileIO "open") :mockImplementation (async (&rest args)
                 (let ((file (await (Reflect/apply originalOpen fileIO args))))
                   (js-object :read (async (&rest readArgs) (setq reads (1+ reads)) (when (= reads 2) (throw first)) (Reflect/apply (get file :read) file readArgs))
                     :close (async () (setq closes (1+ closes)) (await (js-call file :close)) (throw secondary))))))))
          (try (await (js-call assert :rejects (readArchivedCompilerSources directory) (lambda (error) (= error first)))) (finally (js-call openSpy :mockRestore)))
          (assert-eq closes 1) (await (writeFile filename "{broken"))
          (let ((closeSpy (js-call (spyOn fileIO "open") :mockImplementation (async (&rest args)
            (let ((file (await (Reflect/apply originalOpen fileIO args))))
              (js-object :read (lambda (&rest readArgs) (Reflect/apply (get file :read) file readArgs))
                :close (async () (await (js-call file :close)) (throw secondary))))))))
            (try (await (js-call assert :rejects (readArchivedCompilerSources directory) (lambda (error) (= error secondary)))) (finally (js-call closeSpy :mockRestore))))
          (await (js-call assert :rejects (readArchivedCompilerSources directory) globalThis.SyntaxError)))))))) 30000)
  (test "source archive streaming keeps hash odd-unit projection and path rejection order with valid recovery" (async ()
    (await (fixture (async (directory)
      (let* ((sources (graph)) (identity (await (archiveCompilerSources sources directory)))
             (manifest (JSON/parse (await (readFile (join directory "source-archive.json") "utf8")))) (first (aref (get manifest :records) 0))
             (raw (await (readFile (join directory (get first :path))))) (tool (await (readFile (join directory (get (get first :tool) :path)))))
             (odd (js-call raw :subarray 0 (1- (get raw :length)))))
        (await (writeFile (join directory (get first :path)) odd))
        (await (js-call assert :rejects (readArchivedCompilerSources directory) (rx "UTF-16 source bytes differ from their identity")))
        (await (rewriteArchive directory (lambda (manifest bound)
          (Object/assign (aref (get manifest :records) 0) (js-object :bytes (get odd :length) :sha256 (sha odd)))
          (Object/assign (aref (get bound :modules) 0) (js-object :bytes (get odd :length) :sha256 (sha odd))))))
        (await (js-call assert :rejects (readArchivedCompilerSources directory) (rx "incomplete UTF-16 code unit")))
        (await (writeFile (join directory (get first :path)) raw))
        (await (rewriteArchive directory (lambda (manifest bound)
          (Object/assign (aref (get manifest :records) 0) (js-object :bytes (get raw :length) :sha256 (sha raw)))
          (Object/assign (aref (get bound :modules) 0) (aref (get identity :modules) 0)))))
        (let ((altered (Buffer/from tool)))
          (put altered (1- (get altered :length)) (bit-xor (aref altered (1- (get altered :length))) 1))
          (await (writeFile (join directory (get (get first :tool) :path)) altered))
          (await (js-call assert :rejects (readArchivedCompilerSources directory) (rx "tool projection bytes differ from their identity")))
          (await (rewriteArchive directory (lambda (manifest) (Object/assign (get (aref (get manifest :records) 0) :tool) (js-object :bytes (get altered :length) :sha256 (sha altered))))))
          (await (js-call assert :rejects (readArchivedCompilerSources directory) (rx "tool projection differs from the exact source"))))
        (await (writeFile (join directory (get (get first :tool) :path)) tool))
        (await (rewriteArchive directory (lambda (manifest) (put (aref (get manifest :records) 0) :tool (get first :tool)))))
        (same (await (readArchivedCompilerSources directory (js-object :expectedIdentity identity))) sources)
        (let ((moved (join directory "real-codeunits")))
          (await (js-call fileIO :rename (join directory "source-codeunits") moved))
          (await (symlink moved (join directory "source-codeunits") "dir"))
          (await (js-call assert :rejects (readArchivedCompilerSources directory) (rx "unsupported file entry")))
          (await (rm (join directory "source-codeunits"))) (await (js-call fileIO :rename moved (join directory "source-codeunits"))))
        (same (await (readArchivedCompilerSources directory)) sources)
        (await (rewriteArchive directory (lambda (manifest) (put (aref (get manifest :records) 0) :path "../outside"))))
        (await (js-call assert :rejects (readArchivedCompilerSources directory) (rx "relative source identity")))))))) 30000)
  (test "source archive partial write failures keep their original value and close the owned descriptor" (async ()
    (await (fixture (async (directory)
      (let* ((originalOpen (get fileIO :open)) (first (js-object :write "original")) (secondary (js-object :close "secondary")) (writes 0) (closes 0)
             (spy (js-call (spyOn fileIO "open") :mockImplementation (async (&rest args)
               (let ((file (await (Reflect/apply originalOpen fileIO args))))
                 (js-object :write (async (buffer offset length position)
                     (setq writes (1+ writes)) (when (= writes 2) (throw first)) (js-call file :write buffer offset (Math/min length 13) position))
                   :close (async () (setq closes (1+ closes)) (await (js-call file :close)) (throw secondary))))))))
        (try (await (js-call assert :rejects (archiveCompilerSources (graph) directory) (lambda (error) (= error first)))) (finally (js-call spy :mockRestore)))
        (assert-eq closes 1)))))) 30000)
  (test "artifact source assets stream exact JSON UTF16 and UTF8 with captured public declarations and bounded module verification" (async ()
    (await (fixture (async (directory)
      (let* ((assets (await (sourceAssetFixture directory))) (artifact (get assets :artifact)) (runtime (get assets :runtime)) (literal (get assets :literal))
             (originalOpen (get fileIO :open)) (originalReadFile (get fileIO :readFile)) (observed (js-array)) (opens 0) (closes 0)
             (spy (js-call (spyOn fileIO "readFile") :mockImplementation (async (filename &rest args)
               (when (js-call (js-array "compiler.mjs" "runtime.eli.json" "literal.eli") :some (lambda (name) (= (resolve filename) (join directory name))))
                 (throw (new globalThis.Error "artifact verification/source loading must use bounded reads")))
               (Reflect/apply originalReadFile fileIO (js-call (js-array filename) :concat args)))))
             (openSpy (js-call (spyOn fileIO "open") :mockImplementation (async (&rest args)
               (let ((file (await (Reflect/apply originalOpen fileIO args)))) (setq opens (1+ opens))
                 (js-object :read (async (buffer offset length position)
                   (js-call observed :push (resolve (aref args 0))) (assert (<= (get buffer :byteLength) 65536)) (assert (<= length 65536))
                   (js-call file :read buffer offset (Math/min length 257) position))
                   :close (async () (setq closes (1+ closes)) (js-call file :close)))))))
             (session undefined))
        (try
          (setq session (await (openCompilerArtifact artifact)))
          (put artifact :runtimePath "missing") (put artifact :runtimeEncoding "unsupported")
          (put (aref (get artifact :literalSources) 0) :path "missing")
          (put (get (get artifact :sourceIdentity) :runtime) :sha256 (js-call "0" :repeat 64)) (put (get (get artifact :sourceIdentity) :literalSources) :length 0)
          (let ((actual (await (js-call session :request (js-object :operation "runtime")))))
            (assert-eq (get actual :source) runtime) (assert-eq (get actual :filename) "runtime.eli")
            (same (get actual :literalSources) (js-array (js-object :id "stdlib/bit.mjs" :filename "stdlib/bit.eli" :source literal)))
            (assert-eq (get (await (js-call session :request (js-object :operation "runtime"))) :source) runtime))
          (finally (try (when session (await (js-call session :close))) (finally (js-call openSpy :mockRestore) (js-call spy :mockRestore)))))
        (assert-eq opens closes)
        (js-call (js-array "compiler.mjs" "runtime.eli.json" "literal.eli") :forEach (lambda (name) (assert (js-call observed :includes (join directory name)))))))))) 30000)
  (test "streamed artifact source failures keep identity cancellation encoding UTF8 JSON order and allow retry" (async ()
    (await (fixture (async (directory)
      (let* ((assets (await (sourceAssetFixture directory))) (artifact (get assets :artifact)) (runtime (get assets :runtime))
             (filename (join directory "runtime.eli.json")) (bytes (Buffer/from (str "{broken" (js-call " " :repeat 70000)))) (session undefined))
        (await (writeFile filename (Buffer/concat (js-array bytes (Buffer/from (js-array 255))))))
        (setq session (await (openCompilerArtifact artifact)))
        (try (await (js-call assert :rejects (js-call session :request (js-object :operation "runtime")) (rx "SHA-256 or byte length identity changed")))
          (finally (await (js-call session :close))))
        (let ((bound (js-call (get (get artifact :artifactIdentity) :files) :find (lambda (record) (= (get record :path) "runtime.eli.json")))))
          (Object/assign bound (js-object :bytes (1+ (get bytes :length)) :sha256 (sha (Buffer/concat (js-array bytes (Buffer/from (js-array 255)))))))
          (setq session (await (openCompilerArtifact artifact)))
          (try
            (await (js-call assert :rejects (js-call session :request (js-object :operation "runtime"))
              (lambda (error) (and (funcall hostInstanceof error globalThis.TypeError) (not (funcall hostInstanceof error globalThis.SyntaxError))))))
            (let ((corrected (Buffer/from (JSON/stringify runtime))))
              (await (writeFile filename corrected))
              (await (js-call assert :rejects (js-call session :request (js-object :operation "runtime")) (rx "SHA-256 or byte length identity changed")))
              (Object/assign bound (js-object :bytes (get corrected :length) :sha256 (sha corrected))))
            (finally (await (js-call session :close))))
          (setq session (await (openCompilerArtifact artifact)))
          (try (assert-eq (get (await (js-call session :request (js-object :operation "runtime"))) :source) runtime) (finally (await (js-call session :close))))
          (put artifact :runtimeEncoding "unsupported")
          (let ((controller (new globalThis.AbortController)) (reason (js-object :cancelled "during bounded source reads")) (originalOpen (get fileIO :open)))
            (setq session (await (openCompilerArtifact artifact)))
            (let ((spy (js-call (spyOn fileIO "open") :mockImplementation (async (&rest args)
              (let ((file (await (Reflect/apply originalOpen fileIO args))))
                (if (not (= (resolve (aref args 0)) filename)) file
                  (js-object :read (async (&rest readArgs)
                    (let ((result (await (Reflect/apply (get file :read) file readArgs)))) (js-call controller :abort reason) result))
                    :close (lambda () (js-call file :close)))))))))
              (try (await (js-call assert :rejects (js-call session :request (js-object :operation "runtime") (js-object :signal (get controller :signal))) (lambda (error) (= error reason))))
                (finally (js-call spy :mockRestore) (await (js-call session :close)))))
            (setq session (await (openCompilerArtifact artifact)))
            (try (await (js-call assert :rejects (js-call session :request (js-object :operation "runtime")) (rx "unsupported compiler source asset encoding"))) (finally (await (js-call session :close)))))
          (put artifact :runtimeEncoding "json-utf16") (await (writeFile filename bytes))
          (Object/assign bound (js-object :bytes (get bytes :length) :sha256 (sha bytes)))
          (setq session (await (openCompilerArtifact artifact)))
          (try (await (js-call assert :rejects (js-call session :request (js-object :operation "runtime")) globalThis.SyntaxError)) (finally (await (js-call session :close)))))))))) 30000)
)
