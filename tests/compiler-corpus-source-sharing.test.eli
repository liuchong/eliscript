(module tests.compiler-corpus-source-sharing.test
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "node:fs/promises" readFile)
  (import "../tools/backends/compiler-corpus.mjs" cloneCompilerCorpusData cloneCompilerCorpusModules compilerCorpusRequest createOriginalCorpusSourceReader)
  (import "../tools/backends/compiler-corpus-runtime-adapters.mjs" addOriginalStdlibRuntimeAdapters originalRuntimeCaseLocators originalRuntimeOnlyCase)
  (import "./helpers/corpus-clone-contract.mjs" plainCloneGraph checkPlain)
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun different (a b &rest __host_forwarded_arguments_3)
    (let* ((label (aref __host_forwarded_arguments_3 0))) (js-call assert :notEqual a b label)))
  (defun sha (input) (js-call (js-call (createHash "sha256") :update input) :digest "hex"))
  (defun getter (object name action) (Object/defineProperty object name (js-object :enumerable t :configurable t :get action)) object)
  (defun cloneError (action) (js-call assert :throws action (lambda (error) (= (get error :name) "DataCloneError"))))
  (defun exactRegion (source begin end &rest __host_default_arguments_1)
    (let* ((from (aref __host_default_arguments_1 0)))
    (when (= from undefined) (setq from 0))
    (let* ((start (js-call source :indexOf begin from)) (finish (if (< start 0) -1 (js-call source :indexOf end (+ start (get begin :length)))))
           (text (js-call source :slice start finish)))
      (assert (and (>= start 0) (>= finish start)) begin)
      (js-object :text text :start start :end finish :byteStart (Buffer/byteLength (js-call source :slice 0 start))
        :byteEnd (Buffer/byteLength (js-call source :slice 0 finish)) :sha256 (sha text)))))
  (defun assertBoundRegion (source bound)
    (let ((text (js-call source :slice (get bound :start) (get bound :end))))
      (eqv (sha text) (get bound :sha256))
      (eqv (Buffer/byteLength (js-call source :slice 0 (get bound :start))) (get bound :byteStart))
      (eqv (Buffer/byteLength (js-call source :slice 0 (get bound :end))) (get bound :byteEnd))
      text))
  (test "complete plain corpus snapshots match this host native clone including cross-object cycles and all mutable boundaries" (lambda ()
    (checkPlain)))
  (test "complete graph fallback invokes original getters once and preserves native first-error order and special aliases" (lambda ()
    (let ((trace (js-array)) (sentinel (new globalThis.Error "original getter error")))
      (let ((earlyGetter (getter (js-object) "first" (lambda () (js-call trace :push "first") (throw sentinel)))))
        (put earlyGetter :later (lambda () 1)) (js-call assert :throws (lambda () (cloneCompilerCorpusData earlyGetter)) (lambda (error) (= error sentinel))) (same trace (js-array "first")))
      (let ((earlyUnsupported (js-object :first (lambda () 1))))
        (getter earlyUnsupported "later" (lambda () (js-call trace :push "later") (throw sentinel))) (cloneError (lambda () (cloneCompilerCorpusData earlyUnsupported))) (same trace (js-array "first")))
      (let ((getters 0) (getterGraph (js-object)))
        (getter getterGraph "read" (lambda () (setq getters (1+ getters)) (js-object :source "once")))
        (same (cloneCompilerCorpusData getterGraph) (js-object :read (js-object :source "once"))) (eqv getters 1))
      (let* ((shared (js-object :source "shared")) (graph (js-object :shared shared :map (new globalThis.Map (js-array (js-array "shared" shared)))
        :set (new globalThis.Set (js-array shared)) :date (new globalThis.Date 17) :regexp (new globalThis.RegExp "source" "giu") :bytes (new globalThis.Uint8Array (js-array 0 255))))
             (actual (cloneCompilerCorpusData graph)))
        (same actual (globalThis.structuredClone graph)) (eqv (js-call (get actual :map) :get "shared") (get actual :shared))
        (eqv (aref (Array/from (get actual :set)) 0) (get actual :shared)) (put (get actual :bytes) 0 42) (eqv (aref (get graph :bytes) 0) 0))
      (let* ((Metadata (funcall (js* "(initialize) => class Metadata { constructor() { initialize(this); } }") (lambda (self) (put self :source "class instance"))))
             (value (js-object :value (new Metadata))))
        (same (cloneCompilerCorpusData value) (globalThis.structuredClone (js-object :value (new Metadata)))))
      (js-call (js-array (funcall globalThis.Symbol "value") (js-object :nested (js-object :symbol (funcall globalThis.Symbol "value")))
        (js-object :nested (js-object :call (lambda () undefined)))) :forEach (lambda (value) (cloneError (lambda () (cloneCompilerCorpusData value))))))))
  (test "Node native structuredClone independently checks the same cyclic corpus snapshot and getter fallback" (lambda ()
    (let* ((host (fileURLToPath (new globalThis.URL "./fixtures/corpus-clone-host.mjs" (js* "import.meta.url"))))
           (child (spawnSync "node" (js-array "--max-old-space-size=64" host) (js-object :encoding "utf8" :timeout 10000 :maxBuffer 65536))))
      (js-call assert :ifError (get child :error)) (eqv (get child :status) 0 (get child :stderr)) (eqv (get child :signal) nil)
      (eqv (get child :stdout) "native Node clone oracle passed\n"))) 15000)
  (test "a shared source reused by every complete corpus record retains bytes without sharing mutable containers" (lambda ()
    (let* ((source (js-call "\uFEFF; 中😀\ud800\r\n" :repeat 4096)) (records (js-array)) (shared (js-object :id "shared.mjs" :filename "shared.eli" :source source)) (i 0))
      (while (< i 128) (js-call records :push (js-object :id (funcall globalThis.String i)
        :modules (js-array (js-object :id "entry.mjs" :filename "entry.eli" :source source) shared) :request (js-object :entries (js-array "entry.mjs" "shared.mjs")))) (setq i (1+ i)))
      (let* ((graph (js-object :records records :shared shared)) (actual (cloneCompilerCorpusData graph)) (expected (sha (Buffer/from source "utf16le"))))
        (same actual (globalThis.structuredClone graph)) (eqv (get (get actual :records) :length) 128)
        (js-call (get actual :records) :forEach (lambda (record index)
          (eqv (aref (get record :modules) 1) (get actual :shared)) (eqv (sha (Buffer/from (get (aref (get record :modules) 0) :source) "utf16le")) expected)
          (different (get record :modules) (get (aref records index) :modules)) (different (aref (get record :modules) 0) (aref (get (aref records index) :modules) 0))))
        (put (aref (get (aref (get actual :records) 0) :modules) 0) :source "edit")
        (js-call (get (get (aref (get actual :records) 1) :request) :entries) :push "new")
        (eqv (get (aref (get (aref records 0) :modules) 0) :source) source)
        (eqv (get (aref (get (aref (get actual :records) 2) :modules) 0) :source) source)
        (same (get (get (aref records 1) :request) :entries) (js-array "entry.mjs" "shared.mjs"))))))
  (test "repeated and concurrent original source edges share one read and UTF8 decode without changing archived bytes" (async ()
    (let* ((bytes (Buffer/from "\uFEFF; 中😀e\u0301\r\n(defconst value -0)\n")) (reads 0) (decodes 0) (release undefined)
           (hold (new globalThis.Promise (lambda (accept) (setq release accept))))
           (reader (createOriginalCorpusSourceReader (js-object :sourceRoot (resolve ".")
             :read (async (filename) (setq reads (1+ reads)) (eqv filename (resolve "shared.eli")) (await hold) bytes)
             :decode (lambda (input) (setq decodes (1+ decodes)) (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode input)))))
           (first (js-call reader :text "shared.eli")) (second (js-call reader :text "shared.eli")) (asset (js-call reader :file "shared.eli")))
      (release)
      (let* ((result (await (Promise/all (js-array first second asset)))) (left (aref result 0)) (right (aref result 1)) (archived (aref result 2)) (i 0))
        (eqv left (js-call bytes :toString "utf8")) (eqv right left)
        (while (< i 32) (eqv (await (js-call reader :text "shared.eli")) left) (setq i (1+ i)))
        (eqv reads 1) (eqv decodes 1)
        (same archived (js-object :file "shared.eli" :encoding "base64" :bytes (get bytes :length) :sha256 (sha bytes) :content (js-call bytes :toString "base64")))
        (same (js-call reader :evidence) (js-array archived))))))
  (test "source text caching preserves fatal UTF8 rejection, raw evidence, distinct filenames and path rejection" (async ()
    (let* ((inputs (new globalThis.Map (js-array (js-array "one.eli" (Buffer/from "same")) (js-array "two.eli" (Buffer/from "same")) (js-array "bad.eli" (Buffer/from (js-array 192 175))))))
           (reader (createOriginalCorpusSourceReader (js-object :sourceRoot (resolve ".") :read (async (filename) (js-call inputs :get (js-call (js-call filename :split "/") :at -1)))))))
      (eqv (await (js-call reader :text "one.eli")) "same") (eqv (await (js-call reader :text "two.eli")) "same")
      (await (js-call assert :rejects (js-call reader :text "bad.eli") globalThis.TypeError))
      (eqv (get (await (js-call reader :file "bad.eli")) :content) (js-call (Buffer/from (js-array 192 175)) :toString "base64"))
      (same (js-call (js-call reader :evidence) :map (lambda (item) (get item :file))) (js-array "one.eli" "two.eli" "bad.eli"))
      (let ((files (js-array "../escape.eli" "/absolute.eli" "back\\slash.eli")) (i 0))
        (while (< i (get files :length)) (await (js-call assert :rejects (js-call reader :file (aref files i)) globalThis.TypeError)) (setq i (1+ i)))))))
  (test "source graph copies retain native values key order holes aliases and independent mutable records" (lambda ()
    (let* ((record (js-object :filename "中😀.eli" :source "; \uFEFF\ud800\udc00\ud800\n(defconst value -0)" :id "entry.mjs" :sign (js* "-0") :missing undefined :large (js* "2n")))
           (modules (new globalThis.Array 3)))
      (Object/defineProperty record "__proto__" (js-object :value "own data" :enumerable t)) (put modules 0 record) (put modules 2 record)
      (let ((native (globalThis.structuredClone modules)) (actual (cloneCompilerCorpusModules modules)))
        (same actual native) (same (Object/keys (aref actual 0)) (Object/keys (aref native 0)))
        (eqv (get actual :length) 3) (assert (not (Object/hasOwn actual 1))) (eqv (aref actual 0) (aref actual 2))
        (different (aref actual 0) record) (assert (Object/is (get (aref actual 0) :sign) (js* "-0")))
        (put (aref actual 0) :source "edited") (js-call actual :push (js-object :id "other"))
        (eqv (get record :source) "; \uFEFF\ud800\udc00\ud800\n(defconst value -0)") (eqv (get modules :length) 3)))))
  (test "source graph accessors errors proxies and nested metadata retain native clone boundaries" (lambda ()
    (let ((visits 0) (module (js-object :id "entry.mjs" :filename "entry.eli")))
      (getter module "source" (lambda () (setq visits (1+ visits)) (funcall globalThis.String visits)))
      (eqv (get (aref (cloneCompilerCorpusModules (js-array module)) 0) :source) "1") (eqv visits 1))
    (let* ((failure (new globalThis.Error "source getter failed")) (bad (getter (js-object) "source" (lambda () (throw failure)))))
      (js-call assert :throws (lambda () (cloneCompilerCorpusModules (js-array bad))) (lambda (error) (= error failure))))
    (let* ((traps 0) (proxy (new globalThis.Proxy (js-object) (js-object :ownKeys (lambda () (setq traps (1+ traps)) (throw (new globalThis.Error "must not enumerate a proxy")))))))
      (cloneError (lambda () (cloneCompilerCorpusModules (js-array proxy)))) (eqv traps 0))
    (cloneError (lambda () (cloneCompilerCorpusModules (js-array (js-object :source (lambda () undefined))))))
    (let* ((metadata (js-object :shared (js-object :count 1))) (rich (js-array (js-object :id "entry.mjs" :source "(value)" :metadata metadata) metadata))
           (copy (cloneCompilerCorpusModules rich)))
      (same copy (globalThis.structuredClone rich)) (eqv (get (aref copy 0) :metadata) (aref copy 1))
      (put (get (get (aref copy 0) :metadata) :shared) :count 2) (eqv (get (get metadata :shared) :count) 1))))
  (test "public project request copies retain source graph isolation and complete request fields" (lambda ()
    (let* ((module (js-object :id "entry.mjs" :filename "entry.eli" :source "\uFEFF; 中😀\n(defconst value -0)"))
           (record (js-object :kind "project" :request (js-object :operation "project" :resolveImports t :phased t :entries (js-array "entry.mjs") :sourceMap t)
             :entry "entry.mjs" :modules (js-array module module) :memory (js-object :initialPages 4 :maximumPages 256)))
           (request (compilerCorpusRequest record "wasm")))
      (eqv (get request :target) "wasm") (eqv (get request :resolveImports) t) (eqv (get request :phased) t)
      (same (get request :entries) (js-array "entry.mjs")) (eqv (get request :sourceMap) t)
      (eqv (aref (get request :modules) 0) (aref (get request :modules) 1)) (different (aref (get request :modules) 0) module)
      (put (aref (get request :modules) 0) :source "(edited)") (eqv (get module :source) "\uFEFF; 中😀\n(defconst value -0)"))))
  (test "complete core protocol adapters execute every original assertion and map check with the selected source graph" (async ()
    (let* ((cache (new globalThis.Map))
           (text (async (filename) (unless (js-call cache :has filename) (js-call cache :set filename (await (readFile filename "utf8")))) (js-call cache :get filename)))
           (file (async (filename) (js-object :file filename :sha256 (sha (await (text filename))))))
           (manifest (JSON/parse (await (text "tests/conformance/manifest.json")))) (suites (js-array "tests/core-stdlib.test.mjs" "tests/core-set.test.mjs")) (locators (js-array))
           (coreNames (js-array "protocol" "identifier" "data-text" "metadata" "collection" "transient" "transducer" "seq" "data")) (modules (js-array))
           (pairs (js-call (js-array (js-array "core-stdlib-usage.mjs" "tests/fixtures/core-stdlib-usage.eli") (js-array "core-language-api-usage.mjs" "tests/fixtures/core-language-api-usage.eli"))
              :concat (js-call coreNames :map (lambda (name) (js-array (str "stdlib/core/" name ".mjs") (str "stdlib/core/" name ".eli")))))) (i 0))
      (js-call (get manifest :features) :forEach (lambda (feature)
        (js-call (if (nullish? (get feature :evidence)) (js-array) (get feature :evidence)) :forEach (lambda (locator index)
          (when (js-call suites :includes (get locator :file)) (js-call locators :push (Object/assign
            (js-object :id (str "stable-compatibility:evidence:" (get feature :id) ":" index)) locator)))))))
      (while (< i (get suites :length)) (setq locators (js-call locators :concat (originalRuntimeCaseLocators (aref suites i) (await (text (aref suites i)))))) (setq i (1+ i)))
      (setq i 0) (while (< i (get pairs :length))
        (let ((pair (aref pairs i))) (js-call modules :push (js-object :id (aref pair 0) :filename (aref pair 1) :source (await (text (aref pair 1)))))) (setq i (1+ i)))
      (let* ((request (js-object :operation "project" :resolveImports t :phased t :sourceMap t :entries (js-call modules :map (lambda (module) (get module :id)))))
             (records (js-array (js-object :id "stable-compatibility:program:tests/fixtures/core-stdlib-usage.eli" :modules modules :entry (get (aref modules 0) :id) :request request)
               (js-object :id "stable-compatibility:program:tests/fixtures/core-set-usage.eli" :entry "core-set-usage.mjs"
                 :modules (js-array (js-object :id "core-set-usage.mjs" :filename "tests/fixtures/core-set-usage.eli" :source (await (text "tests/fixtures/core-set-usage.eli")))
                   (js-object :id "stdlib/core/set.mjs" :filename "stdlib/core/set.eli" :source (await (text "stdlib/core/set.eli"))))
                 :request (js-object :operation "project" :resolveImports t :sourceMap t))
               (js-object :id "stable-compatibility:program:stdlib/core/text.eli" :request (js-object :operation "project" :sourceMap t))))
             (saved (globalThis.structuredClone records)) (output (js-array)) (parity (JSON/parse (await (text "contracts/compiler-parity-corpus.json")))))
        (await (addOriginalStdlibRuntimeAdapters (js-object :add (lambda (record) (js-call output :push record)) :records records :locators locators :text text :file file :region exactRegion
          :data (lambda () (js-call assert :fail "these original core bodies must not be evaluated during corpus collection")) :bootstrapSources (get parity :bootstrapSources))))
        (let* ((core (js-call output :find (lambda (record) (= (get record :id) "original-program:core-stdlib-complete-protocols"))))
               (set (js-call output :find (lambda (record) (= (get record :id) "original-program:core-set-source-map"))))
               (required (js-array (js-array "language.canonical-runtime-data-text" 3) (js-array "language.immutable-metadata" 3) (js-array "language.keyword-symbol-values" 2) (js-array "stdlib.collection-capability-predicates" 1) (js-array "stdlib.eliscript-core-protocol-algorithms" 1) (js-array "stdlib.eliscript-protocol-dispatch-policy" 1) (js-array "stdlib.key-value-reduction-protocol" 2) (js-array "stdlib.map-set-stack-capability-protocols" 2) (js-array "stdlib.persistent-collection-classification" 1) (js-array "stdlib.persistent-subvector-views" 4) (js-array "stdlib.protocol-driven-core-algorithms" 6) (js-array "stdlib.replayable-reducible-transducer-pipelines" 2) (js-array "stdlib.replayable-sequence-head-tail-views" 1) (js-array "stdlib.reversible-collection-traversal" 2))))
          (assert core) (assert set)
          (js-call required :forEach (lambda (pair) (assert (js-call (get core :coverage) :includes (str "stable-compatibility:evidence:" (aref pair 0) ":" (aref pair 1))) (aref pair 0))))
          (assert (js-call (get set :coverage) :includes "stable-compatibility:evidence:stdlib.eliscript-core-protocol-algorithms:5"))
          (let ((selected (js-array core set)) (n 0))
            (while (< n (get selected :length))
              (let* ((record (aref selected n)) (original (await (text (aref suites n)))) (execution (get record :execution)) (maintained (get (get record :original) :maintainedSource))
                     (sourceFile (js-call (aref suites n) :replace ".mjs" ".eli")) (source (await (text sourceFile))))
                (eqv (get execution :compilerSourceMaps) t) (eqv (get execution :childProcesses) "inherit-selected-artifact")
                (eqv (get (get record :expected) :oracleRequired) t) (eqv (get (get record :expected) :kind) "seed-program")
                (assert (not (js-call (get execution :hostSource) :includes "if(process.env.ELISCRIPT_ORIGINAL_TARGET")))
                (js-call (get (get record :original) :regions) :forEach (lambda (bound) (assertBoundRegion original bound)))
                (eqv (get maintained :sourceFile) sourceFile) (eqv (get maintained :sourceSha256) (sha source))
                (assert (> (get (get maintained :sourceRegions) :length) 0))
                (js-call (get maintained :sourceRegions) :forEach (lambda (bound) (eqv (assertBoundRegion source bound) (get bound :text))))
                (let* ((assets (get (get record :original) :sourceAssets)) (j 0)
                       (needed (js-array sourceFile (if (= n 0) "tests/fixtures/core-stdlib-api-host.eli" "tests/fixtures/core-set-usage-host.eli")
                         "tools/backends/eliscript/compiler-corpus-runtime-adapters.eli")))
                  (js-call needed :forEach (lambda (name) (assert (js-call assets :some (lambda (asset) (= (get asset :file) name))) name)))
                  (while (< j (get assets :length)) (let ((asset (aref assets j))) (eqv (get asset :sourceSha256) (sha (await (text (get asset :file)))))) (setq j (1+ j))))
                (let ((locator (js-call locators :find (lambda (item) (and (not (nullish? (get item :originalExecution))) (= (get (get item :originalExecution) :record) (get record :id)))))))
                  (eqv (get execution :timeoutMs) (get (get locator :originalCase) :timeoutMs))))
              (setq n (1+ n))))
          (js-call (js-array "load(usageModule)" "load(apiUsageModule)" "core-stdlib-api-host.mjs" "50000" "new (SourceRange)(0, 100" "(defun compose-transducers") :forEach
            (lambda (token) (assert (js-call (get (get core :execution) :hostSource) :includes token) token)))
          (js-call (js-array "runUsageHost(" "core-set-usage-host.mjs" "(defun union") :forEach
            (lambda (token) (assert (js-call (get (get set :execution) :hostSource) :includes token) token)))
          (same (get core :modules) modules) (same (get core :request) request) (same records saved)
          (put (aref (get core :modules) 0) :source "changed after collection")
          (eqv (get (aref (get (aref records 0) :modules) 0) :source) (get (aref (get (aref saved 0) :modules) 0) :source)))))))
  (test "core compiler cases cannot be relabelled as host-only and their exact source region fails closed" (async ()
    (let* ((file "tests/core-stdlib.test.mjs") (source (await (readFile file "utf8"))) (title "Eliscript core modules compile and execute against runtime protocols")
           (locator (js-call (originalRuntimeCaseLocators file source) :find (lambda (item) (= (get (get item :originalExecution) :record) "original-program:core-stdlib-complete-protocols")))))
      (eqv (originalRuntimeOnlyCase file source title) nil)
      (assert (<= (get (get (get locator :originalCase) :span) :start) (get (get (get locator :originalExecution) :span) :start)))
      (assert (>= (get (get (get locator :originalCase) :span) :end) (get (get (get locator :originalExecution) :span) :end)))
      (js-call (js-array "load(usageModule)" title) :forEach (lambda (removed)
        (js-call assert :throws (lambda () (originalRuntimeCaseLocators file (js-call source :replace removed "changed original boundary"))) globalThis.TypeError))))))
)
