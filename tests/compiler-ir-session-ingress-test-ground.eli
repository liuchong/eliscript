(module tests.compiler-ir-session-ingress-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/compiler-build.mjs" buildIndependentCompiler loadCompilerSources)
  (import "../tools/backends/compiler-bootstrap.mjs" openCompilerArtifact)
  (import "../tools/backends/compiler-session.mjs" encodeCompilerIR)
  (import "../tools/backends/compiler-worker.mjs" compilerSourceIdentity)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)
  (import "../tools/backends/compiler-matrix.mjs" archiveProduct)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst nativeSupported (and (= (get globalThis.process :arch) "arm64") (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform))))
  (defconst nativeTarget (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos"))
  (defvar directory undefined) (defvar sources undefined) (defvar seed undefined)
  (defconst artifacts (new globalThis.Map))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-session-ir-"))))
    (setq sources (await (loadCompilerSources)))
    (setq seed (await (buildIndependentCompiler (js-object :host "javascript" :sources sources :profile "full-runtime" :outputRoot (resolve directory "javascript") :retainIR false :debug false))))
    (js-call artifacts :set "javascript" (Promise/resolve seed))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (defun artifact (host)
    (unless (js-call artifacts :has host)
      (js-call artifacts :set host (funcall (async ()
        (let ((producer (await (openCompilerArtifact seed))))
          (try (await (buildIndependentCompiler (js-object :host host :session producer :sources sources :profile "full-runtime" :nativeTarget nativeTarget :outputRoot (resolve directory host) :retainIR false :debug false)))
            (finally (await (js-call producer :close)))))))))
    (js-call artifacts :get host))
  (defasync sessionFor (host run)
    (let ((session (await (openCompilerArtifact (await (artifact host))))))
      (try
        (await (js-call session :request (js-object :operation "runtime" :source (get (get sources :runtime) :source)
          :filename (get (get sources :runtime) :filename) :literalSources (globalThis/structuredClone (get sources :literalSources)))))
        (await (funcall run session))
        (finally (await (js-call session :close))))))
  (defasync execute (response name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (setq args (if (= args undefined) (js-array) args))
    (let ((runtime undefined))
      (if (= (get response :target) "wasm")
        (let ((bytes (Uint8Array/from (get response :bytes))))
          (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (setq runtime (instantiateManagedRuntime bytes)))
        (progn
          (js-call assert :equal (get response :target) "native")
          (let ((path (resolve directory (str name (if (= (get globalThis.process :platform) "linux") ".so" ".dylib")))))
            (await (writeFile path (Uint8Array/from (get response :bytes))))
            (setq runtime (await (instantiateNativeManagedRuntime path (js-object :typed (get response :typed) :descriptor (get response :descriptor))))))))
      (try
        (js-call runtime :auto 1)
        (let ((result (js-call runtime :invoke "run" args))) (try (js-call runtime :readNumber result) (finally (js-call runtime :release result))))
        (finally
          (try (js-call runtime :closeModule) (js-call runtime :collect)
            (js-call assert :equal (js-call runtime :live) 0) (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
            (finally (let ((close (get runtime :close))) (unless (nullish? close) (Reflect/apply close runtime (js-array)))))))))))
  (defun outputTargets () (if nativeSupported (js-array "wasm" "native") (js-array "wasm")))
  (defun diagnosticCode (error) (let ((d (get error :eliscriptDiagnostic))) (if (nullish? d) undefined (get d :code))))
  (defasync singleCase (host)
    (await (sessionFor host (async (session)
      (let* ((source "(defun run () -0) (export run)")
             (ir (get (await (js-call session :request (js-object :operation "compile-ir" :source source :filename "ieee-ir.eli"))) :ir))
             (javascript (await (js-call session :request (js-object :operation "emit-ir" :ir ir))))
             (reference (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from (get javascript :javascript)) :toString "base64"))))))
        (funcall assert (Object/is (js-call reference :run) (js* "-0")))
        (let ((targets (outputTargets)) (index 0))
          (while (< index (get targets :length))
            (let* ((target (aref targets index)) (product (await (js-call session :request (js-object :operation "emit-ir" :target target :ir ir :nativeTarget nativeTarget :nativeFormat "library")))))
              (js-call assert :equal (get product :target) target)
              (js-call assert :equal (get (get product :descriptor) :module) undefined)
              (funcall assert (Object/is (await (execute product (str host "-single-" target))) (js-call reference :run))))
            (setq index (1+ index))))
        (let ((caps (await (js-call session :request (js-object :operation "capabilities")))))
          (funcall assert (js-call (get caps :operations) :includes "project-ir"))))))))
  (defasync intrinsicCase (host)
    (await (sessionFor host (async (session)
      (let* ((source "(defun token (x) (host-identity-token x)) (export token)")
             (original (get (await (js-call session :request (js-object :operation "compile-ir" :source source :filename "arity.eli"))) :ir))
             (runtimeRequest (js-object :operation "runtime" :source (get (get sources :runtime) :source) :filename (get (get sources :runtime) :filename) :literalSources (globalThis/structuredClone (get sources :literalSources))))
             (beforeRuntime (await (js-call session :request runtimeRequest))) (counts (js-array 0 2)) (index 0))
        (while (< index 2)
          (let* ((count (aref counts index)) (program (JSON/parse original))
                 (node (js-call (get (aref (get program :body) 0) :children) :at -1)) (operand (aref (get node :children) 0))
                 (targets (outputTargets)) (j 0))
            (put node :children (if (= count 0) (js-array) (js-array operand (globalThis/structuredClone operand))))
            (while (< j (get targets :length))
              (let ((target (aref targets j)))
                (await (js-call assert :rejects (async () (await (js-call session :request
                    (js-object :operation "emit-ir" :target target :ir (encodeCompilerIR program) :nativeTarget nativeTarget :literalSources (js-array)))))
                  (lambda (error)
                    (let ((diagnostic (get error :eliscriptDiagnostic)) (span (get node :span)))
                      (js-call assert :equal (get error :name) "Error") (js-call assert :equal (diagnosticCode error) "ELI-B0001")
                      (js-call assert :equal (get diagnostic :phase) "managed-backend")
                      (js-call assert :equal (get diagnostic :message) (get error :message))
                      (js-call assert :equal (get (get diagnostic :location) :file) (get span :filename))
                      (js-call assert :deepEqual (get (get diagnostic :location) :start) (js-object :offset (get span :start) :line (get span :line) :column (get span :column)))
                      (js-call assert :deepEqual (get (get diagnostic :location) :end) (js-object :offset (get span :end) :line (get span :endLine) :column (get span :endColumn)))
                      (js-call assert :match (get error :message) (new globalThis.RegExp (str "host-identity-token expects 1 argument, got " count))) t)))))
              (setq j (1+ j))))
          (setq index (1+ index)))
        (let* ((pairSource ";; \u4e2d\ud83d\ude00 retain original span and first rejection\n(defun pair (x y)\n (host-identity-token x)\n (host-identity-token y)) (export pair)")
               (pair (JSON/parse (get (await (js-call session :request (js-object :operation "compile-ir" :source pairSource :filename "first-error-中.eli"))) :ir)))
               (tokens (js-call (get (aref (get pair :body) 0) :children) :filter (lambda (node) (and (= (get node :kind) "intrinsic") (= (get node :value) "host-identity-token"))))))
          (js-call assert :equal (get tokens :length) 2)
          (let ((operand (aref (get (aref tokens 1) :children) 0)))
            (put (aref tokens 0) :children (js-array))
            (put (aref tokens 1) :children (js-array operand (globalThis/structuredClone operand))))
          (await (js-call assert :rejects (async () (await (js-call session :request (js-object :operation "emit-ir" :target "wasm" :ir (encodeCompilerIR pair)))))
            (lambda (error)
              (js-call assert :equal (diagnosticCode error) "ELI-B0001")
              (js-call assert :match (get error :message) (new globalThis.RegExp "host-identity-token expects 1 argument, got 0"))
              (let ((span (get (aref tokens 0) :span)))
                (js-call assert :deepEqual (get (get (get error :eliscriptDiagnostic) :location) :start) (js-object :offset (get span :start) :line (get span :line) :column (get span :column))))
              (js-call assert :equal (get (get (get error :eliscriptDiagnostic) :location) :file) "first-error-中.eli") t)))
          (await (js-call assert :rejects (async () (await (js-call session :request (js-object :operation "emit-ir" :target "wasm" :ir (encodeCompilerIR pair) :literalSources (js-object)))))
            (lambda (error) (and (= (diagnosticCode error) "ELI-H0001") (js-call (get error :message) :includes "literalSources must be an array"))))))
        (js-call assert :equal (get (await (js-call session :request (js-object :operation "compile-ir" :source source :filename "arity.eli"))) :ir) original)
        (js-call assert :deepEqual (await (js-call session :request runtimeRequest)) beforeRuntime "failed raw IR must roll back the exact prior private-library revision")
        (let ((product (await (js-call session :request (js-object :operation "emit-ir" :target "wasm" :ir original)))))
          (js-call assert :equal (get product :target) "wasm")
          (js-call assert :equal (funcall host-typeof (get product :descriptor)) "object")
          (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module (Uint8Array/from (get product :bytes)))) (js-array))))))))
  (defasync compileGraphIR (session modules)
    (let ((inputs (js-array)) (index 0))
      (while (< index (get modules :length))
        (let ((module (aref modules index)))
          (js-call inputs :push (copyHostRecord module (js-object :ir (get (await (js-call session :request (js-object :operation "compile-ir" :source (get module :source) :filename (get module :filename)))) :ir)))))
        (setq index (1+ index))) inputs))
  (defasync graphCase (host)
    (await (sessionFor host (async (session)
      (let* ((modules (js-array (js-object "id" "library.mjs" "filename" "library.eli" "source" "(defun value () -0) (export value)") (js-object "id" "entry.mjs" "filename" "entry.eli" "source" "(import \"./library.eli\" value) (defun run () (value)) (export run)"))) (inputs (await (compileGraphIR session modules)))
             (targets (if nativeSupported (js-array "javascript" "wasm" "native") (js-array "javascript" "wasm"))) (index 0))
        (while (< index (get targets :length))
          (let* ((target (aref targets index)) (request (js-object :entry "entry.mjs" :target target :resolveImports t :sourceMap t :debug t :nativeTarget nativeTarget :nativeFormat "library"))
                 (direct (await (js-call session :request (copyHostRecord request (js-object :operation "project" :modules modules)))))
                 (fromIR (await (js-call session :request (copyHostRecord request (js-object :operation "project-ir" :modules inputs))))))
            (js-call assert :equal (get fromIR :target) target) (js-call assert :equal (get fromIR :entry) (get direct :entry))
            (if (= target "javascript") (js-call assert :deepEqual (get fromIR :modules) (get direct :modules))
              (progn
                (js-call assert :deepEqual (get fromIR :bytes) (get direct :bytes)) (js-call assert :deepEqual (get fromIR :descriptor) (get direct :descriptor))
                (when (= target "native") (js-call assert :deepEqual (get fromIR :typed) (get direct :typed)))
                (js-call assert :deepEqual (get fromIR :debug) (get direct :debug))
                (funcall assert (Object/is (await (execute fromIR (str host "-graph-" target))) (js* "-0")))))
            (let* ((reversedSource (await (js-call session :request (copyHostRecord request (js-object :operation "project" :modules (js-call (js-call modules :slice) :reverse))))))
                   (reversedIR (await (js-call session :request (copyHostRecord request (js-object :operation "project-ir" :modules (js-call (js-call inputs :slice) :reverse)))))))
              (js-call (js-array reversedSource reversedIR) :forEach (lambda (actual)
                (if (= target "javascript")
                  (progn (js-call assert :deepEqual (get actual :modules) (get direct :modules))
                    (js-call assert :deepEqual (js-call (get actual :modules) :map (lambda (module) (get module :id))) (js-array "entry.mjs" "library.mjs")))
                  (progn
                    (js-call assert :deepEqual (get actual :bytes) (get direct :bytes)) (js-call assert :deepEqual (get actual :descriptor) (get direct :descriptor))
                    (js-call assert :deepEqual (get actual :debug) (get direct :debug))
                    (when (= target "native") (js-call assert :deepEqual (get actual :typed) (get direct :typed)))))))))
          (setq index (1+ index)))
        (let* ((good (js-object :operation "project-ir" :entry "entry.mjs" :target "javascript" :modules inputs :resolveImports t))
               (patches (js-array (js-object :modules (js-array)) (js-object :modules (js-array (aref inputs 0) (aref inputs 0))) (js-object :entry "missing.mjs")
                 (js-object :modules (js-array (copyHostRecord (aref inputs 0) (js-object :filename "substituted.eli"))))
                 (js-object :modules (js-array (copyHostRecord (aref inputs 0) (js-object :macroOrigins false))))
                 (js-object :sourceMap t :modules (js-call inputs :map (lambda (input) (let ((module (copyHostRecord input))) (Reflect/deleteProperty module "source") module))))
                 (js-object :modules (js-array (copyHostRecord (aref inputs 0) (js-object :ir "{"))))
                 (js-object :modules (js-array (copyHostRecord (aref inputs 0) (js-object :ir "{\"body\":[],\"filename\":\"x\",\"unknown\":true}"))))))
               (index 0))
          (while (< index (get patches :length))
            (let ((patch (aref patches index))) (await (js-call assert :rejects (async () (await (js-call session :request (copyHostRecord good patch)))))))
            (setq index (1+ index)))
          (js-call assert :equal (get (await (js-call session :request good)) :target) "javascript"))
        (let* ((unicodeModules (js-array (js-object "id" "\ue000.mjs" "filename" "\ue000.eli" "source" ";; \u79c1\u6709\u533a\n(defun private-value () 1) (export private-value)") (js-object "id" "\ud800\udc00.mjs" "filename" "\ud800\udc00.eli" "source" ";; \ud83d\ude00 preserve source-map bytes\n(defun astral-value () -0) (export astral-value)") (js-object "id" "entry.mjs" "filename" "entry.eli" "source" "(import \"./\ue000.eli\" private-value) (import \"./\ud800\udc00.eli\" astral-value) (defun run () (if (= (private-value) 1) (astral-value) 1)) (export run)"))) (unicodeIR (await (compileGraphIR session unicodeModules)))
               (unicodeRequest (js-object :entry "entry.mjs" :target "javascript" :resolveImports t :sourceMap t :debug t))
               (unicodeSource (await (js-call session :request (copyHostRecord unicodeRequest (js-object :operation "project" :modules unicodeModules)))))
               (unicodeRaw (await (js-call session :request (copyHostRecord unicodeRequest (js-object :operation "project-ir" :modules (js-call (js-call unicodeIR :slice) :reverse)))))))
          (js-call assert :deepEqual (get unicodeRaw :modules) (get unicodeSource :modules))
          (js-call assert :deepEqual (js-call (get unicodeRaw :modules) :map (lambda (module) (get module :id))) (js-array "entry.mjs" "𐀀.mjs" "\ue000.mjs"))))))))
  (defun memoryChecks (e)
    (js-call assert :equal (uint32 (js-call e :set32 8 4294967295)) 4294967295)
    (js-call assert :equal (uint32 (js-call e :read32 8)) 4294967295)
    (js-call assert :throws (lambda () (js-call e :read32 65533)) (get globalThis.WebAssembly :RuntimeError))
    (js-call assert :equal (js-call e :grow 1) 1) (js-call assert :equal (js-call e :size) 2)
    (js-call assert :equal (uint32 (js-call e :grow 1)) 4294967295)
    (js-call assert :equal (js-call e :set32 65536 42) 42))
  (defasync rawMemoryCase (host)
    (await (sessionFor host (async (session)
      (let* ((source (str "(import \"eliscript:memory32\" load-u32 store-u32 memory-size memory-grow) " (str "(defun read32 (p) (load-u32 p)) (defun set32 (p v) (store-u32 p v) (load-u32 p)) " "(defun grow (n) (memory-grow n)) (defun size () (memory-size)) (export read32 set32 grow size)")))
             (ir (get (await (js-call session :request (js-object :operation "compile-ir" :source source :filename "raw-memory.eli"))) :ir))
             (memory (js-object :initialPages 1 :maximumPages 2))
             (wasm (await (js-call session :request (js-object :operation "emit-memory-ir" :ir ir :target "wasm" :memory memory))))
             (typedWire (encodeCompilerIR (get wasm :typed)))
             (same (await (js-call session :request (js-object :operation "emit-typed-memory" :ir typedWire :target "wasm" :memory memory))))
             (debugProduct (await (js-call session :request (js-object :operation "emit-typed-memory" :ir typedWire :target "wasm" :memory memory :debug t)))))
        (js-call assert :equal (get wasm :abi) "memory-u32") (js-call assert :equal (get wasm :descriptor) undefined)
        (js-call assert :deepEqual (get same :bytes) (get wasm :bytes)) (js-call assert :equal (encodeCompilerIR (get same :typed)) typedWire)
        (js-call assert :equal (encodeCompilerIR (get debugProduct :typed)) typedWire "debug scratch locals must not mutate the public typed payload")
        (let* ((binary (Uint8Array/from (get wasm :bytes))) (module (new globalThis.WebAssembly.Module binary)))
          (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports module) (js-array))
          (memoryChecks (get (new globalThis.WebAssembly.Instance module) :exports)))
        (let ((saved (await (archiveProduct wasm "wasm" (resolve directory (str host "-raw-archive"))))))
          (js-call assert :equal (get saved :abi) "memory-u32") (js-call assert :equal (get saved :descriptor) undefined)
          (js-call assert :deepEqual (JSON/parse (await (readFile (resolve (get saved :directory) "typed.json") "utf8"))) (get wasm :typed)))
        (let ((patches (js-array (js-object :abi "invalid-memory-abi") (js-object :functions nil))) (index 0))
          (while (< index 2)
            (let ((patch (aref patches index)))
              (await (js-call assert :rejects (async () (await (js-call session :request (js-object :operation "emit-typed-memory" :ir (encodeCompilerIR (copyHostRecord (get wasm :typed) patch)) :target "wasm" :memory memory)))))))
            (setq index (1+ index))))
        (await (js-call assert :rejects (async () (await (js-call session :request (js-object :operation "emit-memory-ir" :ir ir :target "javascript" :memory memory))))))
        (when nativeSupported
          (let* ((native (await (js-call session :request (js-object :operation "emit-typed-memory" :ir (encodeCompilerIR (get wasm :typed)) :target "native" :nativeTarget nativeTarget :nativeFormat "library" :memory memory))))
                 (nativeArtifact (await (archiveProduct native "native" (resolve directory (str host "-raw-native")))))
                 (runtime (await (openNativeMemory (get nativeArtifact :path) (js-object :read32 1 :set32 2 :grow 1 :size 0) (copyHostRecord memory (js-object :nativeTarget nativeTarget))))))
            (js-call assert :equal (encodeCompilerIR (get native :typed)) typedWire "target-specific emission must retain the public typed input")
            (js-call assert :equal (encodeCompilerIR (get wasm :typed)) typedWire)
            (try
              (js-call assert :equal (uint32 (js-call runtime :invoke "set32" 8 4294967295)) 4294967295)
              (js-call assert :equal (uint32 (js-call runtime :invoke "read32" 8)) 4294967295)
              (js-call assert :throws (lambda () (js-call runtime :invoke "read32" 65533)))
              (js-call assert :equal (js-call runtime :invoke "grow" 1) 1) (js-call assert :equal (js-call runtime :invoke "size") 2)
              (js-call assert :equal (uint32 (js-call runtime :invoke "grow" 1)) 4294967295)
              (js-call assert :equal (js-call runtime :invoke "set32" 65536 42) 42)
              (finally (js-call runtime :close)))))
        (let ((capabilities (await (js-call session :request (js-object :operation "capabilities")))))
          (js-call assert :deepEqual (get capabilities :memoryIRTargets) (js-array "wasm" "native"))))))))
  (js-call (js-array "javascript" "wasm" "native") :forEach (lambda (host)
    (let ((actual (js-call test :skipIf (and (= host "native") (not nativeSupported)))))
      (funcall actual (str "Given complete " host " compiler When validated single IR is emitted Then actual WASM and native output preserve IEEE values") (lambda () (singleCase host)) 120000)
      (funcall actual (str "Given complete " host " compiler When original IR intrinsic operands are corrupted Then original lowering rejects them and later IR still emits") (lambda () (intrinsicCase host)) 120000)
      (funcall actual (str "Given complete " host " compiler When a source graph and its exact IR graph are emitted Then all target bytes and JS maps agree") (lambda () (graphCase host)) 120000)
      (funcall actual (str "Given complete " host " compiler When original memory IR or typed memory IR is emitted Then the real raw ABI and refusal paths are preserved") (lambda () (rawMemoryCase host)) 120000))))
  (test "Given two IR edits When Worker identities are calculated Then exact IR source units participate independently of the output target" (async ()
    (let* ((module (js-object :id "entry.mjs" :filename "entry.eli" :ir "{\"value\":-0,\"text\":\"\\ud800\"}"))
           (request (js-object :operation "project-ir" :entry "entry.mjs" :modules (js-array module) :target "javascript"))
           (original (await (compilerSourceIdentity request)))
           (single (js-object :operation "emit-ir" :filename "entry.eli" :ir (get module :ir))))
      (js-call assert :equal (await (compilerSourceIdentity (copyHostRecord request (js-object :target "wasm")))) original)
      (js-call assert :notEqual (await (compilerSourceIdentity (copyHostRecord request (js-object :modules (js-array (copyHostRecord module (js-object :ir "{\"value\":0,\"text\":\"\\ud800\"}"))))))) original)
      (js-call assert :notEqual (await (compilerSourceIdentity (copyHostRecord request (js-object :modules (js-array (copyHostRecord module (js-object :ir "{\"value\":-0,\"text\":\"\\udc00\"}"))))))) original)
      (js-call assert :notEqual (await (compilerSourceIdentity single)) (await (compilerSourceIdentity (copyHostRecord single (js-object :ir (js-call (get module :ir) :replace "-0" "0"))))))
      (let ((inputs (js-array request single)) (index 0))
        (while (< index 2)
          (let* ((input (aref inputs index)) (empty (copyHostRecord input (js-object :literalSources (js-array))))
                 (first (copyHostRecord input (js-object :literalSources (js-array (js-object :id "runtime/value.mjs" :filename "stdlib/value.eli" :source "; original \ud800")))))
                 (edited (copyHostRecord first (js-object :literalSources (js-array (copyHostRecord (aref (get first :literalSources) 0) (js-object :source "; edited \udc00")))))))
            (js-call assert :notEqual (await (compilerSourceIdentity input)) (await (compilerSourceIdentity empty)))
            (js-call assert :notEqual (await (compilerSourceIdentity empty)) (await (compilerSourceIdentity first)))
            (js-call assert :notEqual (await (compilerSourceIdentity first)) (await (compilerSourceIdentity edited)))
            (js-call assert :equal (await (compilerSourceIdentity first)) (await (compilerSourceIdentity (copyHostRecord first (js-object :target "native" :debug t :memory (js-object :initialPages 2)))))))
          (setq index (1+ index))))
      (let ((origins (copyHostRecord request (js-object :modules (js-array (copyHostRecord module (js-object :macroOrigins (js-array (js-object :name "original" :span (js-object :start 0 :end 1))))))))))
        (js-call assert :notEqual (await (compilerSourceIdentity origins)) original)
        (js-call assert :notEqual (await (compilerSourceIdentity origins))
          (await (compilerSourceIdentity (copyHostRecord origins (js-object :modules (js-array
            (copyHostRecord (aref (get origins :modules) 0) (js-object :macroOrigins (js-array (js-object :name "edited" :span (js-object :start 0 :end 1)))))))))))))))
)
