      (js-call (expect (arr (get usage :vector_stack_rest))) :toEqual (js-array 1 2))
      (js-call (expect (get usage :list_stack_top)) :toBe 1)
      (js-call (expect (arr (get usage :list_stack_rest))) :toEqual (js-array 2 3))
      (js-call (expect (arr (get usage :reverse_sequence))) :toEqual (js-array 3 2 1)))
        (js-call (expect (await (readFile usageModule "utf8"))) :toContain "first_even")
        (let* ((seqMap (await (js-call (Bun/file (str seqModule ".map")) :json))) (dataMap (await (js-call (Bun/file (str dataModule ".map")) :json))))
          (js-call (expect (aref (get seqMap :sourcesContent) 0)) :toContain "(defun reverse\n    (collection)")
          (js-call (expect (aref (get seqMap :sourcesContent) 0)) :toContain "(implementsProtocolOperation IReversible \"rseq\" collection)")
          (js-call (expect (aref (get seqMap :sourcesContent) 0)) :toContain "(defun some\n    (predicate collection")
          (js-call (get (expect (aref (get seqMap :sourcesContent) 0)) :not) :toContain "runtime/core/sequence.mjs")
          (js-call (expect (aref (get dataMap :sourcesContent) 0)) :toContain "(defun collect-buckets")
          (js-call (expect (aref (get dataMap :sourcesContent) 0)) :toContain "(defun index-by")
          (js-call (get (expect (aref (get dataMap :sourcesContent) 0)) :not) :toContain "runtime/core/data.mjs"))
        (let ((api (await (load apiUsageModule))) (generatedCollection (await (load collectionModule))))
          (be (js-call generatedCollection :queue_QMARK_ (persistentQueue 1 2 3)) t) (be (js-call generatedCollection :queue_QMARK_ (js-array 1 2 3)) false)
          (js-call (expect (get api :report)) :toMatchObject (js-object "number-description" "number:7" "default-description" "default" "number-category" "number" "method-slot-type" "symbol" "implements-number" t "implements-operation" t "vector-count" 3 "vector-counted" t "vector-indexed" t "vector-seqable" t "vector-reducible" t "vector-reversible" t "vector-associative" t "vector-collection" t "vector-vector" t "vector-sequential" t "vector-sequence" false "list-list" t "list-sequence" t "map-map" t "set-set" t "native-array-collection" false "bounded-vector-count" 2 "distinct-scalars" t "distinct-vectors" false "empty-vector-empty" t "non-empty-vector-same" t "empty-vector-absent" t "vector-second" 2 "vector-has-two" t "vector-seq-count" 3 "map-left" 10 "map-associative" t "map-indexed" false "map-missing" "fallback" "map-has-right" t "metadata-support" t "keyword-metadata-support" false "metadata-left" 10 "metadata-varied-left" 30 "metadata-preserved" t "printed-annotated-vector" "^{\"left\" 10 \"right\" 20} [1 2 3]" "read-metadata-left" 10 "bounded-sum" 6 "observed" (js-array 1 2 3) "reduced-state" t "unreduced-value" 9 "keyword-string" ":article/title" "symbol-name" "article/title" "identifier-name" "title" "identifier-namespace" "article" "keyword-state" t "symbol-state" t "identifier-state" t))
      (js-call (expect (arr (get (get api :report) "vector-appended"))) :toEqual (js-array 1 2 3 4))
      (js-call (expect (arr (get (get api :report) "vector-slice"))) :toEqual (js-array 2 3))
      (js-call (expect (arr (get (get api :report) "vector-slice-bounded"))) :toEqual (js-array 2 3))
      (js-call (expect (arr (get (get api :report) "vector-empty"))) :toEqual (js-array ))
      (js-call (expect (arr (get (get api :report) :transformed))) :toEqual (js-array 6 8))
      (js-call (expect (rows (get (get api :report) "stateful-transformed"))) :toEqual (js-array (js-array 2 2) (js-array 3 4)))
      (js-call (expect (arr (get (get api :report) :flattened))) :toEqual (js-array 1 10 2 20))
      (js-call (expect (arr (get (get api :report) :concatenated))) :toEqual (js-array "left" "right"))
      (js-call (expect (rows (get (get api :report) :sampled))) :toEqual (js-array (js-array 0 5) (js-array 3 7)))
      (js-call (expect (arr (get (get api :report) :interposed))) :toEqual (js-array "left" "between" "right"))
      (js-call (expect (arr (get (get api :report) "unique-transformed"))) :toEqual (js-array 1 2 3))
      (js-call (expect (rows (get (get api :report) :partitioned))) :toEqual (js-array (js-array 1 2) (js-array 3)))
      (js-call (expect (rows (get (get api :report) :grouped))) :toEqual (js-array (js-array 1 2) (js-array 3 4))))
        (let* ((SourceRange (rangeType)) (generatedSeq (await (load seqModule))) (observed (js-array)))
          (extendRange SourceRange)
          (be (js-call generatedSeq :find (lambda (value) (= value 4)) (new SourceRange 0 100 (lambda (value) (js-call observed :push value))) "missing") 4)
          (same observed (js-array 0 1 2 3 4))
          (refuses (lambda () (js-call generatedSeq :some nil (js-array) "missing")) "some predicate must be a function"))
        (let ((generatedData (await (load dataModule))))
          (resetPersistentMapMetrics) (resetTransientMapMetrics)
          (let ((indexed (js-call generatedData :index_by (lambda (value) value) (Array/from (js-object :length 50000) (lambda (_ value) value)))))
            (be (get indexed :count) 50000) (js-call (expect (transientMapMetrics)) :toMatchObject (js-object :persistentCalls 1 :invalidCalls 0))))
        (await (runSuccessful (js-array "node" (resolve ROOT "tests/fixtures/core-stdlib-api-host.mjs") directory)))
        (js-call (expect (aref (get (await (js-call (Bun/file (str protocolModule ".map")) :json)) :sourcesContent) 0)) :toContain "(defun define-protocol")
        (js-call (expect (aref (get (await (js-call (Bun/file (str identifierModule ".map")) :json)) :sourcesContent) 0)) :toContain "(defun keyword")
        (js-call (expect (aref (get (await (js-call (Bun/file (str dataTextModule ".map")) :json)) :sourcesContent) 0)) :toContain "(defun print-value")
        (js-call (expect (aref (get (await (js-call (Bun/file (str metadataModule ".map")) :json)) :sourcesContent) 0)) :toContain "(defun with-meta")
        (js-call (expect (aref (get (await (js-call (Bun/file (str collectionModule ".map")) :json)) :sourcesContent) 0)) :toContain "(defun reduce")
        (js-call (expect (aref (get (await (js-call (Bun/file (str transientModule ".map")) :json)) :sourcesContent) 0)) :toContain "(defun persistent!")
        (js-call (expect (aref (get (await (js-call (Bun/file (str transducerModule ".map")) :json)) :sourcesContent) 0)) :toContain "(defun compose-transducers")
        (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "protocol standard-library algorithms agree under Bun and Node" (async ()
