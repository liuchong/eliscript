      (js-call (expect (js-call (get usage :zipped_result) :get "b")) :toBe 20)
      (js-call (expect (get usage :keyed_total)) :toBe 17)
      (js-call (expect (arr (get usage :removed_map))) :toEqual (js-array (js-array "middle" 2)))
      (js-call (expect (arr (get usage :removed_set))) :toEqual (js-array "middle"))
