      (js-call (expect (new globalThis.Set (get usage :keyed_vals))) :toEqual (new globalThis.Set (js-array 1 2)))
      (js-call (expect (js-call (get usage :renamed_result) :get "field:left")) :toBe 1)
      (js-call (expect (js-call (get usage :renamed_result) :get "field:right")) :toBe 2)
