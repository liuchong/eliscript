(module tests.protocol.test
  (import "bun:test" expect test)
  (import "node:vm" runInNewContext)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/protocol.mjs"
    ProtocolDispatchError defineProtocol defineProtocolFromDefinition extendProtocolCategory extendProtocolDefault
    extendProtocolType implementsProtocol implementsProtocolOperation protocolDefinition protocolHostCategory protocolMethod protocolSlot)
  (import "../runtime/core/value.mjs" IEquiv IHash equalValues extendValueType hashValue)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst exact-class (js* "(initialize) => class Exact { constructor(value) { initialize(this, value); } }"))
  (defconst direct-class (js* "(Base, slot, method) => class Direct extends Base { [slot]() { return method(this); } }"))
  (defconst point-class (js* "(initialize) => class Point { constructor(x, y) { initialize(this, x, y); } }"))
  (defconst native-method (js* "(implementation) => function(...args) { return implementation(this, args); }"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun rejects (operation &rest __host_default_arguments_1)
    (let* ((message (aref __host_default_arguments_1 0)))
    (if (= message undefined) (js-call (expect operation) :toThrow) (js-call (expect operation) :toThrow message))))
  (defasync runHost (command fixture)
    (let* ((child (js-call globalThis.Bun :spawn (js-array command fixture) (js-object :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (unless (= exitCode 0) (throw (new globalThis.Error (let ((message (js-call stderr :trim))) (if (= message "") (str command " exited with " exitCode) message)))))
      (JSON/parse stdout)))
  (test "protocol definitions expose frozen operation identities" (lambda ()
    (let* ((protocol (defineProtocol "Measured" (js-array "count" "reduce"))) (count (protocolMethod protocol "count")))
      (be (Object/isFrozen protocol) t) (be (Object/isFrozen (get protocol :operations)) t) (be (Object/isFrozen count) t)
      (be (get (get protocol :operations) :count) count) (be (get count :protocol) protocol)
      (be (get count :operation) "count") (be (get count :slot) (protocolSlot protocol "count"))
      (be (protocolHostCategory nil) "null") (be (protocolHostCategory undefined) "undefined")
      (be (protocolHostCategory (lambda () 1)) "function")
      (rejects (lambda () (defineProtocol "" (js-array "read"))))
      (rejects (lambda () (defineProtocol "Empty" (js-array))))
      (rejects (lambda () (defineProtocol "Duplicate" (js-array "read" "read"))))
      (rejects (lambda () (protocolMethod protocol "missing")))
      (rejects (lambda () (funcall count)) "protocol Measured/count requires a dispatch value"))))
  (test "protocol definitions round trip as isolated declarative data" (lambda ()
    (let* ((original (defineProtocol "Transported" (js-array "read" "size")))
           (originalRead (protocolMethod original "read")) (originalSlot (protocolSlot original "read")))
      (extendProtocolCategory original "string" (js-object :read (lambda (value) (str "original:" value))))
      (let* ((definition (protocolDefinition original))
             (restored (defineProtocolFromDefinition (JSON/parse (JSON/stringify definition))))
             (restoredRead (protocolMethod restored "read")))
        (same definition (js-object :format "eliscript-protocol-definition" :version 1 :name "Transported" :operations (js-array "read" "size")))
        (be (Object/isFrozen definition) t) (be (Object/isFrozen (get definition :operations)) t)
        (same (protocolDefinition restored) definition)
        (js-call (get (expect restored) :not) :toBe original)
        (js-call (get (expect restoredRead) :not) :toBe originalRead)
        (js-call (get (expect (protocolSlot restored "read")) :not) :toBe originalSlot)
        (rejects (lambda () (funcall restoredRead "value")) ProtocolDispatchError)
        (be (funcall originalRead "value") "original:value")
        (extendProtocolCategory restored "string" (js-object :read (lambda (value) (str "restored:" value))))
        (be (funcall restoredRead "value") "restored:value")
        (be (funcall originalRead "value") "original:value")))))
  (test "protocol definition validation rejects executable and ambiguous input" (lambda ()
    (let ((reads 0) (accessorOperations (js-array)))
      (Object/defineProperty accessorOperations "0" (js-object :enumerable t :get (lambda () (setq reads (1+ reads)) "read")))
      (put accessorOperations :length 1)
      (rejects (lambda () (defineProtocol "Accessor" accessorOperations)) "protocol operations must contain enumerable data values")
      (be reads 0)
      (let ((sparse (new globalThis.Array 2)) (extended (js-array "read")))
        (put sparse 1 "read")
        (rejects (lambda () (defineProtocol "Sparse" sparse)) "protocol operations must be a dense array with no extra properties")
        (put extended :extra "side-channel")
        (rejects (lambda () (defineProtocol "Extended" extended)) "protocol operations must be a dense array with no extra properties"))
      (rejects (lambda () (defineProtocol "Oversized" (Array/from (js-object :length 1025) (lambda (unused index) (str "operation-" index))))) "protocol operations exceed 1024")
      (let* ((base (js-object :format "eliscript-protocol-definition" :version 1 :name "Imported" :operations (js-array "read")))
             (nullPrototype (Object/assign (Object/create nil) base))
             (symbolExtended (copyHostRecord base))
             (accessorDefinition (js-object :version 1 :name "Accessor" :operations (js-array "read"))))
        (same (protocolDefinition (defineProtocolFromDefinition nullPrototype)) base)
        (rejects (lambda () (defineProtocolFromDefinition (copyHostRecord base (js-object :extra t)))) "protocol definition must contain exactly format, version, name, and operations")
        (rejects (lambda () (defineProtocolFromDefinition (copyHostRecord base (js-object :version 2)))) "unsupported protocol definition version 2")
        (rejects (lambda () (defineProtocolFromDefinition (copyHostRecord base (js-object :format "other")))) "unsupported protocol definition format other")
        (rejects (lambda () (defineProtocolFromDefinition (Object/assign (Object/create (js-object :inherited t)) base))) "protocol definition must be a plain object")
        (put symbolExtended (funcall globalThis.Symbol "hidden") t)
        (rejects (lambda () (defineProtocolFromDefinition symbolExtended)) "protocol definition must contain exactly format, version, name, and operations")
        (Object/defineProperty accessorDefinition "format" (js-object :enumerable t :get (lambda () (setq reads (1+ reads)) "eliscript-protocol-definition")))
        (rejects (lambda () (defineProtocolFromDefinition accessorDefinition)) "protocol definition field format must be an enumerable data property")
        (be reads 0)))))
  (test "protocol dispatch follows direct, exact, category, and default priority" (lambda ()
    (let* ((protocol (defineProtocol "Labelled" (js-array "label"))) (label (protocolMethod protocol "label"))
           (slot (protocolSlot protocol "label"))
           (Exact (funcall exact-class (lambda (this value) (put this :value value))))
           (Direct (funcall direct-class Exact slot (lambda (this) (str "direct:" (get this :value))))))
      (extendProtocolDefault protocol (js-object :label (lambda (value) (str "default:" (funcall globalThis.String value)))))
      (extendProtocolCategory protocol "object" (js-object :label (lambda () "category:object")))
      (extendProtocolType protocol Exact (js-object :label (lambda (value) (str "exact:" (get value :value)))))
      (be (funcall label (new Direct "a")) "direct:a")
      (be (funcall label (new Exact "b")) "exact:b")
      (be (funcall label (js-object :value "c")) "category:object") (be (funcall label 7) "default:7")
      (let ((invalid (new Exact "bad")))
        (Object/defineProperty invalid slot (js-object :value 42))
        (rejects (lambda () (funcall label invalid)) ProtocolDispatchError)
        (try (funcall label invalid) (catch error (be (get error :reason) "invalid-direct-slot")))))))
  (test "protocol extensions are exact, atomic, and do not modify host prototypes" (lambda ()
    (let* ((protocol (defineProtocol "Pair" (js-array "left" "right"))) (left (protocolMethod protocol "left"))
           (right (protocolMethod protocol "right")) (arrayKeys (Reflect/ownKeys (get globalThis.Array :prototype)))
           (Base (js* "class Base {}")) (Child (funcall (js* "(Base) => class Child extends Base {}") Base)))
      (rejects (lambda () (extendProtocolType protocol Base (js-object :left (lambda () "left") :right 42))) "protocol Pair/right implementation must be a function")
      (be (implementsProtocolOperation protocol "left" (new Base)) false)
      (extendProtocolType protocol Base (js-object :left (lambda () "base-left")))
      (be (funcall left (new Base)) "base-left")
      (rejects (lambda () (funcall right (new Base))) ProtocolDispatchError)
      (be (implementsProtocol protocol (new Base)) false)
      (rejects (lambda () (funcall left (new Child))) ProtocolDispatchError)
      (extendProtocolType protocol globalThis.Array (js-object :left (lambda (value) (aref value 0)) :right (lambda (value) (js-call value :at -1))))
      (same (js-array (funcall left (js-array 1 2 3)) (funcall right (js-array 1 2 3))) (js-array 1 3))
      (be (implementsProtocol protocol (js-array)) t)
      (same (Reflect/ownKeys (get globalThis.Array :prototype)) arrayKeys)
      (rejects (lambda () (extendProtocolCategory protocol "array" (js-object :left (lambda () 1)))) "unknown protocol host category array"))))
  (test "host categories provide explicit cross-realm adaptation" (lambda ()
    (let* ((protocol (defineProtocol "RealmValue" (js-array "read"))) (read (protocolMethod protocol "read"))
           (remoteObject (runInNewContext "({ value: 17 })")))
      (extendProtocolType protocol globalThis.Object (js-object :read (lambda () "local-object")))
      (extendProtocolCategory protocol "object" (js-object :read (lambda (value) (str "category:" (get value :value)))))
      (be (funcall read (js-object :value 1)) "local-object") (be (funcall read remoteObject) "category:17"))))
  (test "missing protocol diagnostics identify protocol, operation, and host type" (lambda ()
    (let* ((protocol (defineProtocol "Readable" (js-array "read"))) (read (protocolMethod protocol "read")))
      (try (funcall read (new globalThis.Date 0)) (throw (new globalThis.Error "expected protocol dispatch to fail"))
        (catch error
          (js-call (expect error) :toBeInstanceOf ProtocolDispatchError)
          (js-call (expect error) :toMatchObject (js-object :code "ELI-RUNTIME-PROTOCOL" :protocol "Readable" :operation "read" :observedType "object:Date" :reason "missing"))
          (be (get error :message) "protocol Readable/read has no implementation for object:Date"))))))
  (test "open IEquiv and IHash extensions preserve persistent key semantics" (lambda ()
    (let ((Point (funcall point-class (lambda (this x y) (put this :x x) (put this :y y) (Object/freeze this)))))
      (extendValueType Point (js-object :equal (lambda (left right equal)
          (and (funcall (js* "(a, b) => a instanceof b") right Point) (funcall equal (get left :x) (get right :x)) (funcall equal (get left :y) (get right :y))))
        :hash (lambda (point hash) (uint32 (Math/imul (bit-xor (funcall hash (get point :x)) (funcall hash (get point :y))) 2654435761)))))
      (let ((left (new Point 3 5)) (equal (new Point 3 5)) (different (new Point 3 8)))
        (be (implementsProtocol IEquiv left) t) (be (implementsProtocol IHash left) t)
        (be (equalValues left equal) t) (be (hashValue left) (hashValue equal)) (be (equalValues left different) false)
        (let ((map (persistentHashMap (js-array left "point"))))
          (be (js-call map :get equal "missing") "point") (be (js-call map :get different "missing") "missing")))
      (rejects (lambda () (extendValueType (js* "class Partial {}") (js-object :equal (lambda () t)))) "value type extension requires equal and hash functions"))))
  (test "protocol dispatch agrees under Bun and Node and remains stable at scale" (async ()
    (let* ((fixture (fileURLToPath (new globalThis.URL "./fixtures/protocol-host.mjs" (js* "import.meta.url"))))
           (bun (await (runHost (get globalThis.process :execPath) fixture))) (node (await (runHost "node" fixture))))
      (same bun node) (same bun (js-object "direct" (js-array "direct:alpha" 5 t) "exact" (js-array "exact:beta" 4 t) "category" (js-array "string:gamma" 5) "fallback" (js-array "default:null" (- 1)) "missing" (js-object "code" "ELI-RUNTIME-PROTOCOL" "protocol" "Missing" "operation" "read" "observedType" "object:Object" "reason" "missing"))))
    (let* ((protocol (defineProtocol "MillionDispatch" (js-array "increment"))) (increment (protocolMethod protocol "increment"))
           (slot (protocolSlot protocol "increment")) (receiver (js-object)) (value 0) (index 0))
      (put receiver slot (funcall native-method (lambda (this args) (+ (aref args 0) 1))))
      (while (< index 1000000) (setq value (funcall increment receiver value) index (1+ index)))
      (be value 1000000))) 30000)
)
