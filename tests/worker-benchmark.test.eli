(module tests.worker-benchmark
  (import "bun:test" expect test)
  (import "node:path" resolve dirname)
  (import "node:url" fileURLToPath)

  (defconst projectDirectory (resolve (dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defconst benchmarkPath (resolve projectDirectory "tools/worker/benchmark.el"))
  (defconst emacs (or (get (get globalThis.process :env) :EMACS) "emacs"))

  (test "worker benchmark reports equivalent cold and warm measurements"
    (async ()
      (let* ((env (Object/assign (js-object) (get globalThis.process :env)
                    (js-object
                      :BUN (get globalThis.process :execPath)
                      :ELISCRIPT_BENCHMARK_SIZE "200"
                      :ELISCRIPT_BENCHMARK_ROUNDS "2"
                      :ELISCRIPT_BENCHMARK_ITERATIONS "3")))
             (child (js-call globalThis.Bun :spawn
                      (js-array emacs "--batch" "-Q" "--script" benchmarkPath)
                      (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe" :env env)))
             (parts (await (Promise/all
                             (js-array (get child :exited)
                               (js-call (new globalThis.Response (get child :stdout)) :text)
                               (js-call (new globalThis.Response (get child :stderr)) :text)))))
             (exitCode (aref parts 0))
             (stdout (aref parts 1))
             (stderr (aref parts 2)))
        (unless (= exitCode 0)
          (throw (new globalThis.Error
                   (if (> (js-length (js-call stderr :trim)) 0)
                     (js-call stderr :trim)
                     (js-call stdout :trim)))))
        (let ((report (JSON/parse stdout)))
          (js-call (expect (get report :protocolVersion)) :toBe 1)
          (js-call (expect (get report :workload)) :toMatchObject
            (js-object :name "score-values" :size 200 :rounds 2 :iterations 3))
          (js-call (expect (get (get report :workload) :checksum)) :toBeNumber)
          (let ((values (Object/values (get report :timingsMs)))
                (i 0))
            (while (< i (js-length values))
              (js-call (expect (aref values i)) :toBeGreaterThanOrEqual 0)
              (setq i (1+ i))))
          (js-call (expect (get (get report :samples) :emacs)) :toHaveLength 3)
          (js-call (expect (get (get report :samples) :worker)) :toHaveLength 3)
          (js-call (expect (get (get (aref (get (get report :samples) :worker) 0) :timing) :executionMs))
            :toBeGreaterThanOrEqual 0))))
    20000))
