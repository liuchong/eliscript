(module tests.seed-symbol-reservation.test
  (import "bun:test" beforeAll afterAll describe test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)

  (defvar directory nil)
  (defvar memory nil)
  (defvar wide nil)
  (defvar deep nil)
  (defvar tdz nil)
  (defvar compiler nil)

  (defconst clean-env
    (Object/assign (js-object) (get globalThis.process :env)
      (js-object :LANG "en_US.UTF-8" :LC_ALL "en_US.UTF-8")))

  (defun seed (input output)
    (let ((child (spawnSync (resolve "bin/eliscript-seed")
                   (js-array "--output" output input)
                   (js-object :encoding "utf8" :timeout 30000 :env clean-env))))
      (js-call assert :equal (get child :status) 0 (get child :stderr))
      (js-call assert :equal (get child :signal) nil)
      (js-call assert :equal (get child :error) undefined)))

  (defun exact-javascript (actual expected label)
    (unless (= actual expected)
      (let ((first 0))
        (while (and (< first (get actual :length))
                    (< first (get expected :length))
                    (= (js-call actual :charCodeAt first)
                       (js-call expected :charCodeAt first)))
          (setq first (1+ first)))
        (let ((start (Math/max 0 (- first 40))))
          (js-call assert :fail
            (str label ": firstMismatch UTF16=" first
                 "; actualLength=" (get actual :length)
                 "; expectedLength=" (get expected :length)
                 "; actualContext=" (JSON/stringify (js-call actual :slice start (+ start 80)))
                 "; expectedContext=" (JSON/stringify (js-call expected :slice start (+ start 80)))))))))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-seed-reservation-"))))
      (let* ((b (await (buildBackends (js-object :outputRoot (resolve directory "backend")))))
             (input (resolve "bootstrap/runtime/memory.eli"))
             (output (resolve directory "memory.mjs"))
             (source (await (readFile input "utf8"))))
        (setq compiler (get b :compiler))
        (seed input output)
        (setq memory (js-object :output output
                                :javascript (await (readFile output "utf8"))
                                :expected (js-call compiler :compile_string source input)))
        (let ((defs (js-array))
              (index 0))
          (while (< index 1200)
            (js-call defs :push (str "(defun f" index " () " index ")"))
            (setq index (1+ index)))
          (let ((wide-source (str "(module wide\n"
                                  (js-call defs :join "\n")
                                  "\n(defmacro once (form) `(let ((value$ ,form)) value$))\n"
                                  "(defun run (value$G1) (once (+ value$G1 (f1199))))\n"
                                  "(export run))"))
                (wide-input (resolve directory "wide.eli"))
                (wide-output (resolve directory "wide.mjs")))
            (await (writeFile wide-input wide-source))
            (seed wide-input wide-output)
            (setq wide (js-object :output wide-output
                                  :javascript (await (readFile wide-output "utf8"))
                                  :expected (js-call compiler :compile_string wide-source wide-input)))))
        (let ((deep-layers 96)
              (deep-expression "(once value$G1)")
              (index 95))
          (while (>= index 0)
            (setq deep-expression
              (str "(let ((unit (progn (js-call trace :push " index ") value$G1))) (if (= unit " index ") unit " deep-expression "))"))
            (setq index (1- index)))
          (let ((deep-source (str "(module deep-ordinary\n"
                                  "(defmacro once (form) `(let ((value$ ,form)) value$))\n"
                                  "(defun run (value$G1 trace) " deep-expression ")\n(export run))"))
                (deep-input (resolve directory "deep-ordinary.eli"))
                (deep-output (resolve directory "deep-ordinary.mjs")))
            (await (writeFile deep-input deep-source))
            (seed deep-input deep-output)
            (setq deep (js-object :output deep-output
                                  :layers deep-layers
                                  :javascript (await (readFile deep-output "utf8"))
                                  :expected (js-call compiler :compile_string deep-source deep-input)))))
        (let ((tdz-source "(import \"node:path\" basename) (defvar value -0.0) (defun replace-value (next) (setq value next)) (defun read-value () value) (export value replace-value read-value)")
              (tdz-input (resolve directory "tdz-value.eli"))
              (tdz-output (resolve directory "tdz-value.mjs")))
          (await (writeFile tdz-input tdz-source))
          (seed tdz-input tdz-output)
          (setq tdz (js-object :output tdz-output
                               :javascript (await (readFile tdz-output "utf8"))
                               :expected (js-call compiler :compile_string tdz-source tdz-input)
                               :reserved (js-array)))
          (let ((names (js-array "__eliscript_tdz_value_0" "__eliscript-tdz-value-0"))
                (idx 0))
            (while (< idx (get names :length))
              (let* ((name (aref names idx))
                     (src (str "(defvar " name " 1)"))
                     (in-file (resolve directory (str "reserved-" idx ".eli")))
                     (out-file (resolve directory (str "reserved-" idx ".mjs"))))
                (await (writeFile in-file src))
                (js-call (get tdz :reserved) :push
                  (js-object :name name
                             :source src
                             :input in-file
                             :child (spawnSync (resolve "bin/eliscript-seed")
                                      (js-array "--diagnostic-format" "json" "--output" out-file in-file)
                                      (js-object :encoding "utf8" :timeout 30000 :env clean-env)))))
              (setq idx (1+ idx)))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (describe "Feature: Seed name reservation handles large modules without consuming Lisp call depth"
    (lambda ()
      (test "Given a mutable module named value, when Seed and self-hosted emit TDZ writers, then exact JS and live assignments agree without exposing the reserved temporary"
        (lambda ()
          (exact-javascript (get tdz :javascript) (get tdz :expected) "module value TDZ writer")
          (js-call assert :match (get tdz :javascript) (new globalThis.RegExp "function __eliscript_tdz_write_0\\(__eliscript_tdz_value_0\\)"))
          (assert (js-call (get tdz :javascript) :includes "return (value = __eliscript_tdz_value_0);"))
          (let ((child (spawnSync "node"
                         (js-array "--input-type=module" "-e"
                           "import assert from 'node:assert/strict'; const m=await import(process.argv[1]); assert(Object.is(m.value,-0)); const object={marker:7}; for(const value of[undefined,null,false,true,-0,0,NaN,Infinity,'updated',object]){ assert(Object.is(m.replace_value(value),value)); assert(Object.is(m.value,value)); assert(Object.is(m.read_value(),value)); }"
                           (get (pathToFileURL (get tdz :output)) :href))
                         (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (get child :stderr))
            (js-call assert :equal (get child :signal) nil)
            (js-call assert :equal (get child :error) undefined))
          (let ((reserved (get tdz :reserved))
                (idx 0))
            (while (< idx (get reserved :length))
              (let* ((entry (aref reserved idx))
                     (name (get entry :name))
                     (src (get entry :source))
                     (in-file (get entry :input))
                     (rejected (get entry :child))
                     (message (str "binding name uses reserved compiler prefix: " name))
                     (diagnostic (js-object
                                   :format "eliscript-diagnostic"
                                   :version 1
                                   :code "ELI-A0001"
                                   :severity "error"
                                   :phase "analysis"
                                   :message message
                                   :location (js-object
                                               :file in-file
                                               :start (js-object :offset 8 :line 1 :column 9)
                                               :end (js-object :offset (+ 8 (get name :length))
                                                               :line 1
                                                               :column (+ 9 (get name :length)))))))
                (js-call assert :equal (get rejected :status) 1 (get rejected :stderr))
                (js-call assert :equal (get rejected :signal) nil)
                (js-call assert :equal (get rejected :error) undefined)
                (js-call assert :match (get rejected :stderr) (new globalThis.RegExp "reserved compiler prefix"))
                (js-call assert :deepEqual (JSON/parse (get rejected :stderr)) diagnostic)
                (js-call assert :throws
                  (lambda () (js-call compiler :compile_string src in-file))
                  (lambda (error)
                    (js-call assert :equal (get error :message) (str in-file ":1:9: " message))
                    (js-call assert :deepEqual (get error :eliscriptDiagnostic) diagnostic)
                    t)))
              (setq idx (1+ idx))))))

      (test "Given the complete memory runtime, when public Seed compiles it, then its JS exactly equals the self-hosted result"
        (async ()
          (exact-javascript (get memory :javascript) (get memory :expected) "complete memory runtime")
          (let ((child (spawnSync "node" (js-array "--check" (get memory :output))
                         (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (get child :stderr)))))

      (test "Given 1200 sibling definitions and source name collisions, when Seed and self-hosted compilers expand a macro, then output and executed values agree"
        (async ()
          (exact-javascript (get wide :javascript) (get wide :expected) "1200 sibling definitions")
          (let ((child (spawnSync "node"
                         (js-array "--input-type=module" "-e"
                           "import assert from'node:assert/strict';const m=await import(process.argv[1]);for(const x of[-0,0,1,19,1e9])assert.equal(m.run(x),x+1199);"
                           (get (pathToFileURL (get wide :output)) :href))
                         (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (get child :stderr)))))

      (test "Given a deep ordinary if and let tree, when public Seed and self-hosted compilers expand it, then exact JS and ordered effects agree"
        (lambda ()
          (exact-javascript (get deep :javascript) (get deep :expected) "96 ordinary if/let levels")
          (let ((child (spawnSync "node"
                         (js-array "--input-type=module" "-e"
                           "import assert from 'node:assert/strict'; const m=await import(process.argv[1]),layers=Number(process.argv[2]); for(const value of[undefined,null,false,true,-0,0,1,47,95,96,-1,NaN,Infinity,-Infinity,Number.MIN_VALUE]){ const trace=[],result=m.run(value,trace); assert(Object.is(result,value)); const count=typeof value==='number'&&Number.isInteger(value)&&value>=0&&value<layers?value+1:layers; assert.deepEqual(trace,Array.from({length:count},(_,index)=>index)); }"
                           (get (pathToFileURL (get deep :output)) :href)
                           (str (get deep :layers)))
                         (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (get child :stderr))
            (js-call assert :equal (get child :signal) nil)
            (js-call assert :equal (get child :error) undefined)))))))
