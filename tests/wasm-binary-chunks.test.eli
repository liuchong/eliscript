(module tests.wasm-binary-chunks.test
  (import "bun:test" afterAll beforeAll spyOn test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm readFile writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/compiler-build.mjs" decodeCompilerBinary)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)
  (import "../tools/compiler/controlled-baseline.mjs" definition)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defun meta-resolve (specifier)
    (funcall (js* "(specifier) => import.meta.resolve(specifier)") specifier))

  (defun typeof-str (value)
    (funcall (js* "(value) => typeof value") value))

  (defconst encoding "u16le-chunks")
  (defconst packedOptions (js-object :binaryEncoding encoding))
  (defconst memory (js-object :initialPages 1 :maximumPages 1))
  (defconst target
    (if (= (get globalThis.process :arch) "arm64")
      (cond
        ((= (get globalThis.process :platform) "darwin") "arm64-macos")
        ((= (get globalThis.process :platform) "linux") "arm64-linux")
        (t undefined))
      undefined))
  (defconst text (str (js-call "\u0000A\ud800\ud83d\ude80\udfff" :repeat 4097) "Z"))
  (defconst span (js-object :filename "wasm-binary-chunks.eli" :start 0 :end 7 :line 1 :column 1))

  (defvar directory undefined)
  (defvar backend undefined)
  (defvar binary undefined)
  (defvar scratchHelpers undefined)
  (defvar ownedBackend undefined)
  (defvar runtimeProgram undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-wasm-binary-chunks-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq binary (await (dynamic-import (get (pathToFileURL (resolve (get backend :directory) "binary.mjs")) :href))))
    (let* ((source (await (readFile "bootstrap/backends/wasm.eli" "utf8")))
           (helpers (js-array "memory-access-width" "has-memory-access-p" "prepare-memory-scratch" "memory-scratch-entry"))
           (helperSource (str "(module wasm.scratch\n"
                              (js-call (js-call helpers :map (lambda (name) (definition source (str name " ")))) :join "\n")
                              "\n(export prepare-memory-scratch memory-scratch-entry))")))
      (setq scratchHelpers
        (await (dynamic-import
                 (str "data:text/javascript;base64,"
                      (js-call (Buffer/from (js-call (get backend :compiler) :compile_string helperSource "wasm-scratch.eli"))
                               :toString "base64"))))))
    ;; Expose the real private entry only in this isolated test module. Resolve
    ;; its original imports explicitly; production exports stay unchanged.
    (let* ((wasmURL (pathToFileURL (resolve (get backend :directory) "wasm.mjs")))
           (implementation (await (readFile wasmURL "utf8")))
           (transpiler (new globalThis.Bun.Transpiler (js-object :loader "js")))
           (imports (js-call transpiler :scanImports implementation))
           (idx 0))
      (while (< idx (js-length imports))
        (let* ((imported (aref imports idx))
               (imp-path (get imported :path)))
          (js-call assert :equal (get imported :kind) "import-statement")
          (let ((resolved
                  (cond
                    ((js-call imp-path :startsWith ".") (get (new globalThis.URL imp-path wasmURL) :href))
                    ((js-call imp-path :startsWith "data:") imp-path)
                    (t (meta-resolve imp-path)))))
            (setq implementation
              (js-call implementation :replaceAll
                (str "from " (JSON/stringify imp-path))
                (str "from " (JSON/stringify resolved))))))
        (setq idx (1+ idx)))
      (setq ownedBackend
        (await (dynamic-import
                 (str "data:text/javascript;base64,"
                      (js-call (Buffer/from (str implementation "\nexport {emit_fresh_managed_wasm_product, append_trap_site_section};\n"))
                               :toString "base64"))))))
    (setq runtimeProgram
      (js-call (get backend :compiler) :compile_ir_string
        (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
        "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun node (kind type value &rest __host_default_arguments_1)
    (let* ((children (aref __host_default_arguments_1 0)))
    (js-object
      :kind kind
      :type type
      :value value
      :children (if (undefined? children) (js-array) children)
      :span span)))

  (defun literal (value) (node "literal" "u32" value))
  (defun local (value) (node "local" "u32" value))
  (defun op (value &rest children)
    (node "memory-op" (if (= value "load-f64") "f64" "u32") value children))

  (defun program ()
    (let ((definitions
            (js-array
              (js-array "copy" 1 (node "memory-data-copy" "u32" text (js-array (local 0))))
              (js-array "zero" 1 (op "store-f64" (local 0) (node "literal" "f64" -0.0)))
              (js-array "outer" 1 (node "sequence" "u32" nil
                                    (js-array (node "call" "u32" 0 (js-array (local 0)))
                                              (op "store-u8" (literal 1) (literal 88)))))
              (js-array "read" 1 (op "load-u32" (local 0)))
              (js-array "copy64" 2 (op "store-f64" (local 0) (op "load-f64" (local 1))))
              (js-array "dispatch" 2 (node "call-indirect" "u32" 1 (js-array (local 1) (local 0)))))))
      (js-object
        :abi "memory-u32"
        :filename (get span :filename)
        :exports (js-call definitions :map (lambda (d) (aref d 0)))
        :aliases (js-array (js-object :name "copy-中😀" :function "copy"))
        :table (js-array 0 1 3)
        :functions
        (js-call definitions :map
          (lambda (d index)
            (let ((name (aref d 0))
                  (arity (aref d 1))
                  (body (aref d 2)))
              (js-object
                :name name
                :index index
                :arity arity
                :span span
                :body body
                :locals (Array/from (js-object :length arity)
                          (lambda (_ i) (js-object :name (str "arg" i) :index i :type "u32"))))))))))

  (defun utf16 (value)
    (let* ((result (new globalThis.Uint8Array (* (js-length value) 2)))
           (view (new globalThis.DataView (get result :buffer)))
           (i 0))
      (while (< i (js-length value))
        (js-call view :setUint16 (* i 2) (js-call value :charCodeAt i) t)
        (setq i (1+ i)))
      result))

  ;; Expected bytes are decoded independently of the production writer/decoder.
  (defun independentDecode (value)
    (js-call assert :equal (get value :encoding) encoding)
    (assert (and (Number/isSafeInteger (get value :byteLength)) (>= (get value :byteLength) 0)))
    (let ((chunks (get value :chunks)))
      (js-call assert :equal (js-length chunks) (Math/ceil (/ (get value :byteLength) 4096)))
      (let ((result (new globalThis.Uint8Array (get value :byteLength)))
            (index 0))
        (while (< index (js-length chunks))
          (let* ((chunk (aref chunks index))
                 (remaining (Math/min 4096 (- (get value :byteLength) (* index 4096)))))
            (js-call assert :equal (typeof-str chunk) "string")
            (js-call assert :equal (js-length chunk) (Math/ceil (/ remaining 2)))
            (let ((i 0))
              (while (< i (js-length chunk))
                (let ((word (js-call chunk :charCodeAt i))
                      (at (+ (* index 4096) (* i 2))))
                  (put result at (bit-and word 255))
                  (if (< (1+ at) (js-length result))
                    (put result (1+ at) (unsigned-bit-shift-right word 8))
                    (js-call assert :equal (unsigned-bit-shift-right word 8) 0 "odd trailing byte has canonical zero padding")))
                (setq i (1+ i)))))
          (setq index (1+ index)))
        result)))

  (defun checkPacked (actual expected)
    (js-call assert :equal (Array/isArray actual) false)
    (let ((saved (globalThis.structuredClone actual)))
      (js-call assert :deepEqual (independentDecode actual) expected)
      (js-call assert :deepEqual (decodeCompilerBinary actual) expected)
      (let ((wire (JSON/parse (JSON/stringify actual))))
        (js-call assert :deepEqual wire actual)
        (js-call assert :deepEqual (decodeCompilerBinary wire) expected))
      (js-call assert :deepEqual actual saved)))

  (defun uleb (bytes cursor)
    (let ((value 0) (factor 1) (more t))
      (while more
        (let ((at (get cursor :at)))
          (assert (< at (js-length bytes)))
          (put cursor :at (1+ at))
          (let ((byte (aref bytes at)))
            (setq value (+ value (* (bit-and byte 127) factor)))
            (setq factor (* factor 128))
            (setq more (/= (bit-and byte 128) 0)))))
      value))

  (defun sections (bytes)
    (let ((result (js-array))
          (cursor (js-object :at 8)))
      (while (< (get cursor :at) (js-length bytes))
        (let ((at0 (get cursor :at)))
          (put cursor :at (1+ at0))
          (let* ((id (aref bytes at0))
                 (size (uleb bytes cursor))
                 (start (get cursor :at)))
            (assert (<= (+ start size) (js-length bytes)))
            (js-call result :push (js-object :id id :start start :end (+ start size)))
            (put cursor :at (+ start size)))))
      (js-call assert :equal (get cursor :at) (js-length bytes))
      result))

  (test "trap metadata streams exact ground JSON and LEB boundaries without serializing a whole trap array" (lambda ()
    (let* ((record (lambda (site address functionIndex)
                     (js-object :site site :address address :offsetBase "module" :functionIndex functionIndex :returnAddress false)))
           (batches
             (js-call
               (js-array
                 (js-array)
                 (js-array (funcall record 1 0 0))
                 (js-array (funcall record 4294967295 4294967295 4294967295)))
               :concat
               (js-call (js-array 2 127 128 255) :map
                 (lambda (count)
                   (Array/from (js-object :length count)
                     (lambda (_ i) (funcall record (1+ i) (+ 127 i) (% i 7)))))))))
      (js-call batches :forEach
        (lambda (sites)
          (let* ((saved (globalThis.structuredClone sites))
                 (expected (Uint8Array/from
                             (js-call (get backend :wasm) :append_metadata_section
                               (js-array) "eliscript-trap-sites" (JSON/stringify sites))))
                 (ordinary (js-call ownedBackend :append_trap_site_section (js-array) sites)))
            (js-call assert :deepEqual (Uint8Array/from ordinary) expected)
            (let ((writer (js-call binary :binary_output packedOptions)))
              (js-call ownedBackend :append_trap_site_section writer sites)
              (checkPacked (js-call binary :binary_finish writer) expected)
              (js-call assert :deepEqual sites saved))))))
    (let* ((shared (op "load-u32" (local 0)))
           (typed (js-object
                    :abi "memory-u32"
                    :filename (get span :filename)
                    :exports (js-array "readMany")
                    :functions (js-array
                                 (js-object
                                   :name "readMany"
                                   :index 0
                                   :arity 1
                                   :span span
                                   :locals (js-array (js-object :name "address" :index 0 :type "u32"))
                                   :body (node "sequence" "u32" nil
                                           (Array/from (js-object :length 1200) (lambda () shared)))))))
           (input (globalThis.structuredClone typed))
           (plain (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact typed memory))
           (stringify globalThis.JSON.stringify)
           (records 0)
           (packed undefined))
      (try
        (put globalThis.JSON :stringify
          (lambda (value &rest options)
            (js-call assert :equal (Array/isArray value) false "debug emission must not construct the complete trap JSON string")
            (when (and value (Object/hasOwn value "offsetBase"))
              (js-call assert :deepEqual (Object/keys value)
                (js-array "site" "address" "offsetBase" "functionIndex" "returnAddress"))
              (js-call assert :equal (get value :offsetBase) "module")
              (js-call assert :equal (get value :returnAddress) false)
              (js-call (js-array "site" "address" "functionIndex") :forEach
                (lambda (name) (assert (Number/isInteger (get value name)))))
              (setq records (1+ records)))
            (Reflect/apply stringify globalThis.JSON (js-call (js-array value) :concat options))))
        (setq packed
          (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact typed
            (Object/assign (js-object) memory packedOptions)))
        (finally (put globalThis.JSON :stringify stringify)))
      (js-call assert :equal (js-length (get (get packed :debug) :trapSites)) 1200)
      (assert (>= records 1200))
      (checkPacked (get packed :bytes) (Uint8Array/from (get plain :bytes)))
      (js-call assert :deepEqual (get packed :debug) (get plain :debug))
      (js-call assert :deepEqual typed input)
      (let* ((module (new globalThis.WebAssembly.Module (decodeCompilerBinary (get packed :bytes))))
             (_ (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array)))
             (payload (new globalThis.Uint8Array
                        (aref (js-call globalThis.WebAssembly.Module :customSections module "eliscript-trap-sites") 0)))
             (cursor (js-object :at 0))
             (length (uleb payload cursor))
             (expected (js-call (new globalThis.TextEncoder) :encode
                         (JSON/stringify (get (get packed :debug) :trapSites)))))
        (assert (> length 65536))
        (js-call assert :equal length (js-length expected))
        (js-call assert :equal (+ (get cursor :at) length) (js-length payload))
        (js-call assert :deepEqual (js-call payload :subarray (get cursor :at)) expected)
        (js-call assert :deepEqual
          (JSON/parse
            (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t)) :decode
              (js-call payload :subarray (get cursor :at))))
          (get (get packed :debug) :trapSites))
        (let* ((a (get (new globalThis.WebAssembly.Instance module) :exports))
               (original (get (new globalThis.WebAssembly.Instance
                                (new globalThis.WebAssembly.Module (Uint8Array/from (get plain :bytes))))
                              :exports)))
          (js-call (js-array original a) :forEach
            (lambda (rt)
              (js-call assert :equal (js-call rt :readMany 0) 0)
              (js-call assert :throws (lambda () (js-call rt :readMany 65535)) globalThis.WebAssembly.RuntimeError)
              (js-call assert :equal (get (get rt :__eliscript_trap_site) :value) 1)
              (js-call assert :equal (js-call rt :readMany 0) 0)))
          (js-call assert :equal
            (get (get a :__eliscript_trap_site) :value)
            (get (get original :__eliscript_trap_site) :value))
          (js-call assert :equal (get (get a :__eliscript_trap_site) :value) 1))))))

  (test "function scratch retains two fixed slot records for all accesses while public snapshots preserve later getter failures" (lambda ()
    (let* ((load (op "load-u32" (local 0)))
           (floating (op "store-f64" (local 0) (node "literal" "f64" -0.0)))
           (accesses (Array/from (js-object :length 512)
                       (lambda (_ i) (if (/= (% i 2) 0) (op "store-u32" (local 0) (literal i)) load))))
           (fn (js-object
                 :arity 1
                 :locals (js-array (js-object :name "address" :index 0 :type "u32")
                                   (js-object :name "existing" :index 1 :type "f64"))
                 :body (node "sequence" "u32" nil (js-call accesses :concat (js-array floating)))))
           (scratch (js-call scratchHelpers :prepare_memory_scratch fn)))
      (js-call assert :deepEqual scratch
        (js-object :word (js-object :addressLocal 2 :valueLocal 3)
                   :floating (js-object :addressLocal 2 :valueLocal 4)))
      (js-call assert :deepEqual (js-call (get fn :locals) :slice 2)
        (js-array (js-object :name "memory-address" :index 2 :type "u32")
                  (js-object :name "memory-word" :index 3 :type "u32")
                  (js-object :name "memory-float" :index 4 :type "f64")))
      (js-call accesses :forEach
        (lambda (access)
          (js-call assert :equal
            (js-call scratchHelpers :memory_scratch_entry (js-object :wasmMemoryScratch scratch) access)
            (get scratch :word))))
      (js-call assert :equal
        (js-call scratchHelpers :memory_scratch_entry (js-object :wasmMemoryScratch scratch) floating)
        (get scratch :floating))
      (let ((other (js-object :arity 0 :locals (js-array) :body floating)))
        (js-call assert :deepEqual (js-call scratchHelpers :prepare_memory_scratch other)
          (js-object :word (js-object :addressLocal 0 :valueLocal 1)
                     :floating (js-object :addressLocal 0 :valueLocal 2))))
      (let ((noAccess (js-object :arity 0 :locals (js-array) :body (literal 0))))
        (assert (not (js-call scratchHelpers :prepare_memory_scratch noAccess)))
        (js-call assert :deepEqual (get noAccess :locals) (js-array)))
      (js-call (js-array "emit_typed_memory_wasm" "emit_typed_memory_wasm_artifact") :forEach
        (lambda (method)
          (js-call (js-array false t) :forEach
            (lambda (packed)
              (let* ((marker (new globalThis.Error "original later typed getter failure"))
                     (reads 0)
                     (repeated (Object/assign (js-object) (literal 0)))
                     (input (program)))
                (Object/defineProperty repeated "value"
                  (js-object :enumerable t :configurable t
                             :get (lambda ()
                                    (setq reads (1+ reads))
                                    (when (= reads 2) (throw marker))
                                    0)))
                (put (aref (get input :functions) 0) :body
                  (node "sequence" "u32" nil (js-array load repeated repeated)))
                (js-call assert :throws
                  (lambda ()
                    (js-call (get backend :wasm) method input
                      (Object/assign (js-object :initialPages 0) (if packed packedOptions (js-object)))))
                  (lambda (error) (= error marker)))
                (js-call assert :equal reads 2 "all public occurrences are snapshotted before memory/options/scratch preparation")
                (js-call assert :equal (js-length (get (aref (get input :functions) 0) :locals)) 1)))))))))

  (test "WASM packed intermediate writers append live and finished chunks across odd and surrogate boundaries" (lambda ()
    (js-call (js-array 0 1 2 3 4095 4096 4097 8191 8192 8193) :forEach
      (lambda (length)
        (let* ((expected (Uint8Array/from (js-object :length length)
                           (lambda (_ i) (bit-and (+ (* i 37) 216) 255))))
               (input (js-call binary :binary_output packedOptions))
               (output (js-call binary :binary_output packedOptions))
               (marker (js-object :ranges (js-array)))
               (scratch (new globalThis.Map)))
          (js-call binary :binary_append input (Array/from expected))
          (js-call assert :equal (get input :length) length)
          (put output :wasmDebug marker)
          (put output :wasmMemoryScratch scratch)
          (js-call binary :binary_push output 17)
          (js-call binary :binary_append output input)
          (let* ((finished (js-call binary :binary_finish input))
                 (saved (globalThis.structuredClone finished))
                 (ordinary (js-array)))
            (js-call binary :binary_append ordinary finished)
            (js-call assert :deepEqual (Uint8Array/from ordinary) expected)
            (js-call binary :binary_append output finished)
            (js-call binary :binary_push output 0 216 255)
            (js-call assert :equal (get output :wasmDebug) marker)
            (js-call assert :equal (get output :wasmMemoryScratch) scratch)
            (checkPacked (js-call binary :binary_finish output)
              (Uint8Array/from
                (js-call (js-array 17) :concat (Array/from expected) (Array/from expected) (js-array 0 216 255))))
            (let ((resumed (js-call binary :binary_resume finished)))
              (js-call binary :binary_push resumed 0 216 255 219 0 220 255 223 9)
              (checkPacked (js-call binary :binary_finish resumed)
                (Uint8Array/from
                  (js-call (Array/from expected) :concat (js-array 0 216 255 219 0 220 255 223 9))))
              (js-call assert :deepEqual finished saved "reopening a finished envelope preserves the original bytes"))))))))

  (test "owned packed body transfers release their private bytes across every alignment without losing debug state or reusable writers" (lambda ()
    (js-call (js-array 0 1 2 4095 4096 4097) :forEach
      (lambda (prefixLength)
        (js-call (js-array 0 1 2 4095 4096 4097 8193) :forEach
          (lambda (length)
            (let* ((prefix (Uint8Array/from (js-object :length prefixLength)
                             (lambda (_ index) (bit-and (+ (* index 13) 220) 255))))
                   (bytes (Uint8Array/from (js-object :length length)
                            (lambda (_ index) (bit-and (+ (* index 37) 216) 255))))
                   (source (js-call binary :binary_output packedOptions))
                   (output (js-call binary :binary_output packedOptions))
                   (state (js-object :span span :ranges (js-array)))
                   (scratch (js-object :word (js-object :addressLocal 2 :valueLocal 3))))
              (put source :wasmDebug state) (put source :wasmMemoryScratch scratch) (put source :span span)
              (put output :wasmDebug state) (put output :wasmMemoryScratch scratch) (put output :span span)
              (js-call binary :binary_append source (Array/from bytes))
              (js-call binary :binary_append output (Array/from prefix))
              (if (= (% prefixLength 2) 0)
                (let ((pack (spyOn globalThis.String "fromCharCode")))
                  (try
                    (js-call assert :strictEqual (js-call binary :binary_append_owned output source) output)
                    (let* ((units (Math/floor (/ length 2)))
                           (limit (if (= units 0)
                                    0
                                    (+ (if (/= (% prefixLength 4096) 0) 1 0)
                                       (if (/= (% units 2048) 0) 1 0)))))
                      (assert (<= (js-length (get (get pack :mock) :calls)) limit)
                        "any even prefix converts only the initial and source-final numeric tails, never every full block"))
                    (finally (js-call pack :mockRestore))))
                (js-call assert :strictEqual (js-call binary :binary_append_owned output source) output))
              (js-call assert :equal (js-call binary :binary_length source) 0)
              (js-call assert :equal (get source :low) -1)
              (js-call assert :deepEqual (get source :chunks) (js-array))
              (js-call assert :deepEqual (get source :pending) (js-array))
              (js-call (js-array source output) :forEach
                (lambda (writer)
                  (js-call assert :strictEqual (get writer :wasmDebug) state)
                  (js-call assert :strictEqual (get writer :wasmMemoryScratch) scratch)
                  (js-call assert :strictEqual (get writer :span) span)))
              (let ((expected (Uint8Array/from (js-call (Array/from prefix) :concat (Array/from bytes)))))
                (checkPacked (js-call binary :binary_finish output) expected)
                (js-call binary :binary_push source 255 216 0 220 9)
                (checkPacked (js-call binary :binary_finish source) (Uint8Array/of 255 216 0 220 9))
                (checkPacked (js-call binary :binary_finish output) expected)))))))))

  (test "aligned owned blocks transfer without repacking while finished snapshots and public byte inputs remain repeatable" (lambda ()
    (let* ((source (js-call binary :binary_output packedOptions))
           (output (js-call binary :binary_output packedOptions))
           (sourceBytes (Uint8Array/from (js-object :length 8192)
                          (lambda (_ index) (bit-and (+ (* index 43) 223) 255))))
           (prefix (Uint8Array/from (js-object :length 4096)
                     (lambda (_ index) (bit-and index 255)))))
      (js-call binary :binary_append source (Array/from sourceBytes))
      (js-call binary :binary_append output (Array/from prefix))
      (let* ((finishedBeforeTransfer (js-call binary :binary_finish source))
             (saved (globalThis.structuredClone finishedBeforeTransfer))
             (oldStorage (get source :chunks))
             (pack (spyOn globalThis.String "fromCharCode")))
        (try
          (js-call binary :binary_append_owned output source)
          (js-call assert :equal (js-length (get (get pack :mock) :calls)) 0
            "existing full packed strings must not be expanded and packed a second time")
          (finally (js-call pack :mockRestore)))
        (js-call assert :notStrictEqual (get source :chunks) oldStorage)
        (js-call assert :deepEqual finishedBeforeTransfer saved
          "releasing a private writer must not clear an earlier envelope chunk array")
        (checkPacked finishedBeforeTransfer sourceBytes)
        (checkPacked (js-call binary :binary_finish output)
          (Uint8Array/from (js-call (Array/from prefix) :concat (Array/from sourceBytes))))
        (let ((repeated (js-call binary :binary_output packedOptions)))
          (js-call binary :binary_append_owned repeated finishedBeforeTransfer)
          (js-call binary :binary_append_owned repeated finishedBeforeTransfer)
          (checkPacked (js-call binary :binary_finish repeated)
            (Uint8Array/from (js-call (Array/from sourceBytes) :concat (Array/from sourceBytes))))
          (js-call assert :deepEqual finishedBeforeTransfer saved))))
    (let ((events (js-array))
          (input (js-array 0 216 255))
          (ordinary (js-array)))
      (Object/defineProperty input 1
        (js-object :enumerable t :get (lambda () (js-call events :push "index1") 216)))
      (js-call binary :binary_append_owned ordinary input)
      (js-call binary :binary_append_owned ordinary input)
      (js-call assert :deepEqual ordinary (js-array 0 216 255 0 216 255))
      (js-call assert :deepEqual events (js-array "index1" "index1"))
      (js-call assert :equal (js-length input) 3)
      (js-call assert :equal (typeof-str (get (Object/getOwnPropertyDescriptor input "1") :get)) "function"))
    (let ((packed (js-call binary :binary_output packedOptions))
          (array (Object/freeze (js-array 0 216 255))))
      (js-call binary :binary_append_owned packed array)
      (js-call binary :binary_append_owned packed array)
      (checkPacked (js-call binary :binary_finish packed) (Uint8Array/of 0 216 255 0 216 255))
      (js-call assert :deepEqual array (js-array 0 216 255)))))

  (test "owned transfer rejects self append and non-writer typed objects before changing any byte storage" (lambda ()
    (let* ((writer (js-call binary :binary_output packedOptions))
           (_ (js-call binary :binary_push writer 255 216 9))
           (original (globalThis.structuredClone writer))
           (rejected (lambda (error)
                       (and (get error :eliscriptDiagnostic)
                            (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")))))
      (js-call assert :throws (lambda () (js-call binary :binary_append_owned writer writer)) rejected)
      (js-call assert :deepEqual writer original)
      (let* ((typed (program))
             (snapshot (globalThis.structuredClone typed)))
        (js-call assert :throws (lambda () (js-call binary :binary_append_owned writer typed)) rejected)
        (js-call assert :deepEqual typed snapshot)
        (js-call assert :deepEqual writer original))
      (let ((array (js-array 1 2 3)))
        (js-call assert :throws (lambda () (js-call binary :binary_append_owned array array)) rejected)
        (js-call assert :deepEqual array (js-array 1 2 3)))
      (let ((marker (js-object :original "byte getter"))
            (input (js-array 4 5))
            (reads 0))
        (Object/defineProperty input 1
          (js-object :get (lambda () (setq reads (1+ reads)) (throw marker))))
        (js-call assert :throws (lambda () (js-call binary :binary_append (js-array) input))
          (lambda (error) (= error marker)))
        (js-call assert :equal reads 1)
        (js-call assert :equal (js-length input) 2)
        (js-call assert :equal (aref input 0) 4)))))

  (test "all emitted WASM sections, debug ranges, scratch locals and trap metadata are byte-identical in packed output" (lambda ()
    (let* ((typed (program))
           (saved (globalThis.structuredClone typed))
           (plain (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact typed memory))
           (packed (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact typed
                     (Object/assign (js-object) memory packedOptions))))
      (assert (Array/isArray (get plain :bytes)))
      (let ((expected (Uint8Array/from (get plain :bytes))))
        (checkPacked (get packed :bytes) expected)
        (js-call assert :deepEqual (get packed :debug) (get plain :debug))
        (js-call assert :equal (get (get packed :debug) :moduleByteLength) (js-length expected))
        (js-call assert :deepEqual
          (js-call (sections expected) :map (lambda (item) (get item :id)))
          (js-array 1 3 4 5 6 7 9 12 10 11 0))
        (let ((module (new globalThis.WebAssembly.Module (decodeCompilerBinary (get packed :bytes)))))
          (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array))
          (js-call assert :equal
            (js-length (js-call globalThis.WebAssembly.Module :customSections module "eliscript-trap-sites")) 1)
          (assert (> (js-length (get (get packed :debug) :trapSites)) 0))
          (let ((code (js-call (sections expected) :find (lambda (item) (= (get item :id) 10)))))
            (js-call (get (get packed :debug) :trapSites) :forEach
              (lambda (site)
                (assert (and (>= (get site :address) (get code :start))
                             (< (get site :address) (get code :end)))))))
          (let* ((a (get (new globalThis.WebAssembly.Instance module) :exports))
                 (b (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module expected)) :exports))
                 (sourceBytes (utf16 text)))
            (js-call (js-array 0 3 (- 65536 (js-length sourceBytes))) :forEach
              (lambda (at)
                (js-call assert :equal (js-call a :copy at) (js-call b :copy at))
                (js-call assert :deepEqual
                  (js-call (new globalThis.Uint8Array (get (get a :memory) :buffer)) :slice at (+ at (js-length sourceBytes)))
                  sourceBytes)
                (js-call assert :equal (js-call a "copy-中😀" at) (js-call a :dispatch 0 at))))
            (js-call a :zero 3)
            (assert (Object/is (js-call (new globalThis.DataView (get (get a :memory) :buffer)) :getFloat64 3 t) -0.0))
            (js-call (new globalThis.Uint8Array (get (get a :memory) :buffer)) :fill 0 0 2)
            (js-call assert :throws
              (lambda () (js-call a :outer (- 65537 (js-length sourceBytes))))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :deepEqual
              (js-call (new globalThis.Uint8Array (get (get a :memory) :buffer)) :slice 0 2)
              (Uint8Array/of 0 0))
            (js-call assert :equal (> (get (get a :__eliscript_trap_site) :value) 0) t)
            (js-call assert :equal (js-call a :copy 3) (js-call b :copy 3))
            (js-call assert :equal (get (get a :__eliscript_trap_site) :value) 0)
            (checkPacked
              (js-call (get backend :wasm) :emit_typed_memory_wasm typed
                (Object/assign (js-object) memory packedOptions))
              (Uint8Array/from (js-call (get backend :wasm) :emit_typed_memory_wasm typed memory)))
            (js-call assert :deepEqual typed saved)))))))

  (test "packed WASM keeps real capability imports and numeric and source-memory public APIs unchanged" (lambda ()
    (let ((typed (program)))
      (put (aref (get typed :functions) 0) :body
        (node "host-call" "u32" "console-log" (js-array (literal 7) (literal 9))))
      (let* ((plain (Uint8Array/from (js-call (get backend :wasm) :emit_typed_memory_wasm typed memory)))
             (packed (js-call (get backend :wasm) :emit_typed_memory_wasm typed
                       (Object/assign (js-object) memory packedOptions))))
        (checkPacked packed plain)
        (assert (js-call (sections plain) :some (lambda (item) (= (get item :id) 2))))
        (let* ((module (new globalThis.WebAssembly.Module (decodeCompilerBinary packed)))
               (imports (js-call globalThis.WebAssembly.Module :imports module)))
          (js-call assert :deepEqual
            (js-call imports :map
              (lambda (imp) (js-object :module (get imp :module) :name (get imp :name) :kind (get imp :kind))))
            (js-array (js-object :module "eliscript.host" :name "console-log" :kind "function")))
          (js-call imports :forEach
            (lambda (imported)
              (when (Object/hasOwn imported "type")
                (js-call assert :deepEqual (get imported :type)
                  (js-object :parameters (js-array "i32" "i32") :results (js-array "i32"))))))
          (let* ((observed undefined)
                 (a (get (new globalThis.WebAssembly.Instance module
                           (js-object "eliscript.host"
                             (js-object "console-log"
                               (lambda (heap args) (setq observed (js-array heap args)) 42))))
                         :exports)))
            (js-call assert :equal (js-call a :copy 123) 42)
            (js-call assert :deepEqual observed (js-array 7 9))))))
    (let ((numeric (js-call (get backend :compiler) :compile_ir_string
                     "(defun run (value) (+ value 2)) (export run)" "numeric-chunks.eli")))
      (js-call
        (js-array
          (js-array "emit_numeric_wasm" numeric)
          (js-array "emit_typed_numeric_wasm" (js-call (get backend :numeric) :lower_numeric_program numeric)))
        :forEach
        (lambda (pair)
          (let* ((method (aref pair 0))
                 (input (aref pair 1))
                 (ordinary (js-call (get backend :wasm) method input))
                 (packed (js-call (get backend :wasm) method input packedOptions)))
            (assert (Array/isArray ordinary))
            (checkPacked packed (Uint8Array/from ordinary))
            (js-call assert :equal
              (js-call (get (new globalThis.WebAssembly.Instance
                              (new globalThis.WebAssembly.Module (decodeCompilerBinary packed)))
                            :exports)
                       :run 40)
              42)))))
    (let ((source (js-call (get backend :compiler) :compile_ir_string
                    "(import \"eliscript:memory32\" load-u32) (defun run (address) (load-u32 address)) (export run)"
                    "source-memory-chunks.eli")))
      (checkPacked
        (js-call (get backend :wasm) :emit_memory_wasm source (Object/assign (js-object) memory packedOptions))
        (Uint8Array/from (js-call (get backend :wasm) :emit_memory_wasm source memory))))))

  (test "packed managed metadata is appended before finalization and public metadata appends resume bounded tails" (lambda ()
    (let* ((source (js-call (get backend :compiler) :compile_ir_string
                     "(defconst marker -0.0) (defun run () marker) (export run)" "managed-chunks.eli"))
           (saved (globalThis.structuredClone source))
           (runtimeSaved (JSON/stringify runtimeProgram))
           (plain (js-call (get backend :wasm) :emit_managed_ir_wasm_product source runtimeProgram
                    (js-object :abi "managed-module-v1")
                    (lambda () (js-object :debug t :memory (js-object)))))
           (packed (js-call (get backend :wasm) :emit_managed_ir_wasm_product source runtimeProgram
                     (js-object :abi "managed-module-v1")
                     (lambda () (js-object :debug t :memory packedOptions)))))
      (checkPacked (get packed :bytes) (Uint8Array/from (get plain :bytes)))
      (js-call assert :deepEqual (get packed :debug) (get plain :debug))
      (js-call assert :deepEqual (get packed :descriptor) (get plain :descriptor))
      (let* ((publicLowered (js-call (get backend :managed) :lower_managed_program source runtimeProgram t))
             (publicSnapshot (globalThis.structuredClone (get publicLowered :typed)))
             (bodies (js-call (get (get publicLowered :typed) :functions) :map (lambda (fn) (get fn :body))))
             (publicArtifact (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact
                               (get publicLowered :typed)
                               (Object/assign (js-object) packedOptions (js-object :consumeOwnedBodies t))))
             (publicBytes (js-call (get backend :wasm) :append_metadata_section
                            (get publicArtifact :bytes)
                            "eliscript-managed-control"
                            (JSON/stringify (get publicLowered :descriptor)))))
        (put (get publicArtifact :debug) :moduleByteLength (get publicBytes :byteLength))
        (checkPacked publicBytes (Uint8Array/from (get plain :bytes)))
        (js-call assert :deepEqual (get publicArtifact :debug) (get packed :debug))
        (js-call assert :deepEqual (get publicLowered :descriptor) (get packed :descriptor))
        (js-call assert :deepEqual (get publicLowered :typed) publicSnapshot)
        (assert (js-call (get (get publicLowered :typed) :functions) :every
                  (lambda (fn index) (= (get fn :body) (aref bodies index)))))
        (let* ((identity (js-call (get (get publicLowered :typed) :functions) :map
                           (lambda (fn)
                             (js-object :name (get fn :name) :index (get fn :index) :arity (get fn :arity)
                                        :source (get fn :source) :locals (js-call (get fn :locals) :slice)))))
               (owned (js-call ownedBackend :emit_fresh_managed_wasm_product publicLowered
                        (lambda () (js-object :debug t :memory packedOptions)))))
          (checkPacked (get owned :bytes) (Uint8Array/from (get plain :bytes)))
          (js-call assert :deepEqual (get owned :debug) (get packed :debug))
          (js-call assert :deepEqual (get owned :descriptor) (get packed :descriptor))
          (js-call (get (get publicLowered :typed) :functions) :forEach
            (lambda (fn index)
              (let ((expected-id (aref identity index)))
                (js-call assert :equal (get fn :body) nil "only the explicitly owned private intermediate is consumed")
                (js-call assert :equal (get fn :name) (get expected-id :name))
                (js-call assert :equal (get fn :index) (get expected-id :index))
                (js-call assert :equal (get fn :arity) (get expected-id :arity))
                (js-call assert :equal (get fn :source) (get expected-id :source))
                (js-call assert :deepEqual
                  (js-call (get fn :locals) :slice 0 (js-length (get expected-id :locals)))
                  (get expected-id :locals)))))))
      (let* ((bytes (decodeCompilerBinary (get packed :bytes)))
             (module (new globalThis.WebAssembly.Module bytes)))
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array))
        (js-call assert :equal
          (js-length (js-call globalThis.WebAssembly.Module :customSections module "eliscript-managed-control")) 1)
        (js-call assert :equal (get (get packed :debug) :moduleByteLength) (js-length bytes))
        (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 64 :initialBytes 4096 :maxBytes 16384))))
          (js-call a :auto 1)
          (try
            (let ((result (js-call a :invoke "run")))
              (try
                (js-call a :collect)
                (assert (Object/is (js-call a :readNumber result) -0.0))
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                (finally (js-call a :release result))))
            (finally
              (js-call a :closeModule)
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
      (let ((ordinary (Array/from (get plain :bytes)))
            (compact (get packed :bytes)))
        (js-call (js-array "" "x" "中😀" "") :forEach
          (lambda (value)
            (let ((input compact)
                  (previous (globalThis.structuredClone compact)))
              (setq ordinary (js-call (get backend :wasm) :append_metadata_section ordinary "x" value))
              (setq compact (js-call (get backend :wasm) :append_metadata_section input "x" value))
              (checkPacked compact (Uint8Array/from ordinary))
              (js-call assert :deepEqual input previous))))
        (js-call assert :equal
          (js-length (js-call globalThis.WebAssembly.Module :customSections
                       (new globalThis.WebAssembly.Module (decodeCompilerBinary compact)) "x"))
          4))
      (js-call assert :deepEqual source saved)
      (js-call assert :equal (JSON/stringify runtimeProgram) runtimeSaved)
      (let* ((invalid (js-call (get backend :compiler) :compile_ir_string
                        "(defun broken () (js* \"unavailable\")) (export broken)" "owned-first-error.eli"))
             (invalidSnapshot (globalThis.structuredClone invalid))
             (configured 0))
        (js-call assert :throws
          (lambda ()
            (js-call (get backend :wasm) :emit_managed_ir_wasm_product invalid runtimeProgram (js-object)
              (lambda ()
                (setq configured (1+ configured))
                (throw (new globalThis.Error "output configuration must remain after source refusal")))))
          (lambda (error)
            (and (get error :eliscriptDiagnostic)
                 (= (get (get error :eliscriptDiagnostic) :code) "ELI-B0001")
                 (= (get (get (get error :eliscriptDiagnostic) :location) :file) "owned-first-error.eli"))))
        (js-call assert :equal configured 0)
        (js-call assert :deepEqual invalid invalidSnapshot))))
    30000)

  (test "owned emission releases only completed function bodies and preserves the original first emission failure" (lambda ()
    (let* ((input (program))
           (_ (put (aref (get input :functions) 1) :body (node "unknown-owned-opcode" "u32" nil)))
           (saved (globalThis.structuredClone input))
           (marker (new globalThis.Error "original configuration failure")))
      (js-call assert :throws
        (lambda ()
          (js-call ownedBackend :emit_fresh_managed_wasm_product
            (js-object :typed input :descriptor (js-object))
            (lambda () (throw marker))))
        (lambda (error) (= error marker)))
      (js-call assert :deepEqual input saved "a configuration failure happens before any intermediate is consumed")
      (let ((expected undefined))
        (try
          (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact input packedOptions)
          (catch error (setq expected error)))
        (js-call assert :equal (and expected (get expected :eliscriptDiagnostic)
                                    (get (get expected :eliscriptDiagnostic) :code))
                 "ELI-B0001")
        (js-call assert :deepEqual input saved)
        (let ((remainingBodies (js-call (get input :functions) :map (lambda (fn) (get fn :body)))))
          (js-call assert :throws
            (lambda ()
              (js-call ownedBackend :emit_fresh_managed_wasm_product
                (js-object :typed input :descriptor (js-object))
                (lambda () (js-object :debug t :memory packedOptions))))
            (lambda (error)
              (js-call assert :equal (get error :message) (get expected :message))
              (js-call assert :deepEqual (get error :eliscriptDiagnostic) (get expected :eliscriptDiagnostic))
              t))
          (js-call assert :equal (get (aref (get input :functions) 0) :body) nil)
          (let ((index 1))
            (while (< index (js-length (get input :functions)))
              (js-call assert :equal
                (get (aref (get input :functions) index) :body)
                (aref remainingBodies index))
              (setq index (1+ index)))))))))

  (test "invalid WASM encodings preserve ABI, source and memory validation error precedence" (lambda ()
    (let* ((typed (program))
           (saved (globalThis.structuredClone typed))
           (refusal (lambda (message &rest __host_default_arguments_2)
    (let* ((file (aref __host_default_arguments_2 0)))
                      (let ((target-file (if (undefined? file) "<ir>" file)))
                        (lambda (error)
                          (js-call assert :equal (Object/getPrototypeOf error) globalThis.Object.prototype)
                          (js-call assert :equal (get error :message) message)
                          (js-call assert :deepEqual (get error :eliscriptDiagnostic)
                            (js-object
                              :format "eliscript-diagnostic"
                              :version 1
                              :code "ELI-B0001"
                              :severity "error"
                              :phase "numeric-backend"
                              :message message
                              :location (js-object :file target-file
                                                   :start (js-object :line 1 :column 1))))
                          t))))))
      (js-call (js-array undefined nil false 1 "" "unknown" "base64-chunks" (js-object)) :forEach
        (lambda (binaryEncoding)
          (js-call (js-array "emit_typed_memory_wasm" "emit_typed_memory_wasm_artifact") :forEach
            (lambda (method)
              (js-call assert :throws
                (lambda ()
                  (js-call (get backend :wasm) method typed
                    (Object/assign (js-object) memory (js-object :binaryEncoding binaryEncoding))))
                (funcall refusal "unsupported binary output encoding"))))))
      (let ((reads 0)
            (options (js-object :initialPages 0 :maximumPages 1)))
        (Object/defineProperty options "binaryEncoding"
          (js-object :enumerable t :configurable t
                     :get (lambda () (setq reads (1+ reads)) (throw (new globalThis.Error "encoding observed too early")))))
        (js-call assert :throws
          (lambda () (js-call (get backend :wasm) :emit_typed_memory_wasm typed options))
          (funcall refusal "memory32 requires 1 <= initialPages <= maximumPages <= 65535" (get span :filename)))
        (js-call assert :equal reads 0)
        (js-call assert :throws
          (lambda ()
            (js-call (get backend :wasm) :emit_typed_memory_wasm
              (Object/assign (js-object) typed (js-object :abi "numeric-f64")) options))
          (funcall refusal "typed memory emitter requires memory-u32" (get span :filename)))
        (js-call assert :equal reads 0))
      (let ((malformed (globalThis.structuredClone typed)))
        (put (aref (get malformed :functions) 0) :body
          (js-object :kind "memory-data-copy" :type "u32" :value false :children (js-array (literal 0)) :span span))
        (js-call assert :throws
          (lambda ()
            (js-call (get backend :wasm) :emit_typed_memory_wasm malformed (js-object :binaryEncoding "unknown")))
          (funcall refusal "static UTF16 copy requires memory-u32, one word address and string data" (get span :filename))))
      (js-call assert :throws
        (lambda ()
          (decodeCompilerBinary
            (js-object :encoding encoding :byteLength 1 :chunks (js-array (String/fromCharCode 4660))))))
      (js-call assert :deepEqual typed saved))))

  (funcall (js-call test :skipIf (not target))
    "the same binary decoder opens genuine packed native code and executes against packed zero-import WASM"
    (async ()
      (let* ((typed (program))
             (wasm (js-call (get backend :wasm) :emit_typed_memory_wasm_artifact typed
                     (Object/assign (js-object) memory packedOptions)))
             (module (new globalThis.WebAssembly.Module (decodeCompilerBinary (get wasm :bytes))))
             (_ (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array)))
             (w (get (new globalThis.WebAssembly.Instance module) :exports))
             (native (js-call (get backend :native) :emit_typed_native_memory_artifact typed target packedOptions))
             (path (resolve directory (str "cross-decoder." (if (= target "arm64-linux") "so" "dylib")))))
        (await (writeFile path (decodeCompilerBinary (get native :bytes))))
        (let ((SavedModule globalThis.WebAssembly.Module)
              (SavedInstance globalThis.WebAssembly.Instance)
              (n undefined))
          (try
            (put globalThis.WebAssembly :Module
              (lambda () (throw (new globalThis.Error "native loader attempted WASM substitution"))))
            (put globalThis.WebAssembly :Instance
              (lambda () (throw (new globalThis.Error "native loader attempted WASM substitution"))))
            (setq n
              (await (openNativeMemory path
                       (js-object :copy 1 :zero 1 :outer 1 :read 1 :copy64 2 :dispatch 2)
                       (Object/assign (js-object) memory
                         (js-object :nativeTarget target
                                    :debug (get native :debug)
                                    :trapSites (get (get native :debug) :trapSites))))))
            (finally
              (put globalThis.WebAssembly :Module SavedModule)
              (put globalThis.WebAssembly :Instance SavedInstance)))
          (try
            (js-call assert :equal (js-call n :invoke "dispatch" 0 3) (js-call w :dispatch 0 3))
            (js-call assert :deepEqual (js-call n :read 3 (js-length (utf16 text))) (utf16 text))
            (js-call assert :deepEqual
              (js-call n :read 3 (js-length (utf16 text)))
              (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice 3 (+ 3 (js-length (utf16 text)))))
            (js-call n :invoke "zero" 3)
            (js-call w :zero 3)
            (assert (Object/is (js-call (new globalThis.DataView (get (js-call n :read 3 8) :buffer)) :getFloat64 0 t) -0.0))
            (js-call assert :deepEqual
              (js-call n :read 3 8)
              (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice 3 11))
            (js-call assert :throws (lambda () (js-call n :invoke "read" 65535)) globalThis.WebAssembly.RuntimeError)
            (js-call assert :throws (lambda () (js-call w :read 65535)) globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (js-call n :invoke "copy" 3) (js-call w :copy 3))
            (finally (js-call n :close))))))
    30000))
