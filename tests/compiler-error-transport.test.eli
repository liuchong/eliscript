(module tests.compiler-error-transport.test
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:url" fileURLToPath)
  (import "../tools/backends/compiler-worker.mjs" compilerWorkerVersion createCompilerWorkerClient errorData fromErrorData)
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defconst hostInstanceof (js* "(value, type) => value instanceof type"))
  (defconst transports (js-array
    (js-object :name "structured clone" :options (js-object) :wire (lambda (value) (globalThis.structuredClone value)))
    (js-object :name "JSON" :options (js-object :transport "json") :wire (lambda (value) (JSON/parse (JSON/stringify value))))))
  (defconst primitiveValues (js-array undefined nil false t 0 (js* "-0") globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
    "" "原因😀\ud800" 42 (js* "9007199254740993n") (js* "-9007199254740993n")))
  (defconst errorClasses (js-array globalThis.Error globalThis.TypeError globalThis.RangeError globalThis.SyntaxError globalThis.ReferenceError globalThis.URIError globalThis.EvalError
    (get globalThis.WebAssembly :CompileError) (get globalThis.WebAssembly :LinkError) (get globalThis.WebAssembly :RuntimeError)))
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun each (values action) (js-call values :forEach action))
  (defun instance (value type) (funcall hostInstanceof value type))
  (defun roundTrip (value transport) (fromErrorData (funcall (get transport :wire) (errorData value (get transport :options)))))
  (defun samePrimitive (actual expected)
    (eqv (funcall hostTypeof actual) (funcall hostTypeof expected))
    (assert (Object/is actual expected) "exception transport changed an observable primitive value"))
  (defasync rejection (promise)
    (js-call promise :then (lambda () (js-call assert :fail "expected a rejected request")) (lambda (reason) (js-object :reason reason))))
  (defun cause (value transport) (get (roundTrip (new globalThis.Error "data" (js-object :cause value)) transport) :cause))
  (defun caseClasses (transport)
    (each errorClasses (lambda (Constructor)
      (let* ((original (new Constructor "compile failure")) (actual undefined))
        (put original :code "ELI-A0001") (put original :stack (str (get Constructor :name) ": compile failure\n    at original.eli:3:7"))
        (put original :eliscriptDiagnostic (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-A0001" :severity "error" :phase "analysis" :message "unbound symbol: missing"
          :location (js-object :file "original.eli" :start (js-object :offset 12 :line 3 :column 7) :end (js-object :offset 19 :line 3 :column 14))))
        (put original :diagnostics (js-array (get original :eliscriptDiagnostic)))
        (put original :macroOrigins (js-array (js-object :macro "once" :file "macros.eli" :line 2)))
        (put original :eliscriptFrames (js-array (js-object :function "compile" :instruction 42)))
        (put original :eliscriptSourceFrames (js-array (js-object :file "original.eli" :line 3 :column 7)))
        (setq actual (roundTrip original transport))
        (assert (instance actual Constructor) (str "transport changed " (get Constructor :name) " into another Error class"))
        (each (js-array "name" "message" "stack" "code") (lambda (key) (eqv (get actual key) (get original key))))
        (same (get actual :eliscriptDiagnostic) (get original :eliscriptDiagnostic))
        (eqv (aref (get actual :diagnostics) 0) (get actual :eliscriptDiagnostic))
        (each (js-array "macroOrigins" "eliscriptFrames" "eliscriptSourceFrames") (lambda (key) (same (get actual key) (get original key))))))))
  (defun casePrimitives (transport)
    (each primitiveValues (lambda (value)
      (samePrimitive (roundTrip value transport) value)
      (let ((actual (roundTrip (new globalThis.Error "outer" (js-object :cause value)) transport)))
        (assert (instance actual globalThis.Error)) (assert (Object/hasOwn actual "cause")) (samePrimitive (get actual :cause) value))))
    (eqv (Object/hasOwn (roundTrip (new globalThis.Error "no cause") transport) "cause") false)
    (let ((present (roundTrip (new globalThis.Error "undefined cause" (js-object :cause undefined)) transport)))
      (eqv (Object/hasOwn present "cause") t) (eqv (get present :cause) undefined)))
  (defun caseAggregate (transport)
    (let* ((child (new globalThis.URIError "bad URI" (js-object :cause (js* "-0"))))
           (original (new globalThis.AggregateError (js-array child child undefined (js* "9n")) "aggregate" (js-object :cause child))))
      (js-call (get original :errors) :push original)
      (let ((actual (roundTrip original transport)))
        (assert (instance actual globalThis.AggregateError)) (eqv (get actual :message) "aggregate") (assert (instance (get actual :cause) globalThis.URIError))
        (eqv (aref (get actual :errors) 0) (get actual :cause)) (eqv (aref (get actual :errors) 1) (get actual :cause))
        (eqv (aref (get actual :errors) 2) undefined) (eqv (aref (get actual :errors) 3) (js* "9n")) (eqv (aref (get actual :errors) 4) actual)
        (assert (Object/is (get (get actual :cause) :cause) (js* "-0"))))))
  (defun caseCycles (transport)
    (let* ((original (new globalThis.TypeError "outer")) (data (js-object :name "Error" :message "ordinary data" :owner original)) (array (js-array data original)))
      (put array :length 5) (put array 4 undefined) (put data :array array)
      (put data :map (new globalThis.Map (js-array (js-array data original) (js-array original array))))
      (put data :set (new globalThis.Set (js-array data original array))) (put original :cause data) (put original :extra data)
      (let* ((actual (roundTrip original transport)) (copy (get actual :cause)))
        (assert (instance actual globalThis.TypeError)) (eqv (Object/getPrototypeOf copy) (get globalThis.Object :prototype)) (eqv (instance copy globalThis.Error) false)
        (eqv (get actual :extra) copy) (eqv (get copy :owner) actual)
        (eqv (aref (get copy :array) 0) copy) (eqv (aref (get copy :array) 1) actual) (eqv (get (get copy :array) :length) 5)
        (eqv (Object/hasOwn (get copy :array) 2) false) (eqv (Object/hasOwn (get copy :array) 3) false) (eqv (Object/hasOwn (get copy :array) 4) t)
        (eqv (js-call (get copy :map) :get copy) actual) (eqv (js-call (get copy :map) :get actual) (get copy :array))
        (each (js-array copy actual (get copy :array)) (lambda (value) (assert (js-call (get copy :set) :has value)))))
      (let ((self (new globalThis.Error "self"))) (put self :cause self) (let ((copy (roundTrip self transport))) (eqv (get copy :cause) copy)))))
  (defun caseOrdinary (transport)
    (let ((original (js-object :name "TypeError" :message "data only" :cause undefined)))
      (put original :self original) (put original :shared (js-array original original))
      (let ((actual (roundTrip original transport)))
        (eqv (instance actual globalThis.Error) false) (eqv (Object/getPrototypeOf actual) (get globalThis.Object :prototype))
        (eqv (get actual :name) "TypeError") (eqv (get actual :message) "data only") (assert (Object/hasOwn actual "cause")) (eqv (get actual :cause) undefined)
        (eqv (get actual :self) actual) (eqv (aref (get actual :shared) 0) actual) (eqv (aref (get actual :shared) 1) actual))))
  (defun caseViews (transport)
    (let* ((buffer (new globalThis.ArrayBuffer 24)) (view (new globalThis.DataView buffer 4 12))
           (bytes (new globalThis.Uint8Array buffer 6 8)) (signed (new globalThis.Int16Array buffer 8 3)))
      (js-call view :setUint32 0 305419896 t) (put buffer :owner view) (put view :owner bytes)
      (let ((actual (get (roundTrip (new globalThis.Error "bytes" (js-object :cause (js-object :buffer buffer :view view :bytes bytes :signed signed))) transport) :cause)))
        (assert (instance (get actual :buffer) globalThis.ArrayBuffer)) (assert (instance (get actual :view) globalThis.DataView))
        (assert (instance (get actual :bytes) globalThis.Uint8Array)) (assert (instance (get actual :signed) globalThis.Int16Array))
        (each (js-array "view" "bytes" "signed") (lambda (key) (eqv (get (get actual key) :buffer) (get actual :buffer))))
        (eqv (get (get actual :buffer) :owner) (get actual :view)) (eqv (get (get actual :view) :owner) (get actual :bytes))
        (eqv (get (get actual :view) :byteOffset) 4) (eqv (get (get actual :view) :byteLength) 12)
        (eqv (get (get actual :bytes) :byteOffset) 6) (eqv (get (get actual :bytes) :length) 8)
        (eqv (get (get actual :signed) :byteOffset) 8) (eqv (get (get actual :signed) :length) 3)
        (eqv (js-call (get actual :view) :getUint32 0 t) 305419896)
        (put (get actual :bytes) 0 171) (eqv (aref (new globalThis.Uint8Array (get actual :buffer)) 6) 171)
        (js-call assert :notEqual (aref (new globalThis.Uint8Array buffer) 6) 171) (eqv (get buffer :byteLength) 24))))
  (defun caseDescriptors (transport)
    (let ((data (Object/create nil)))
      (Object/defineProperty data "__proto__" (js-object :value (js-object :polluted t) :enumerable t :writable false :configurable false))
      (Object/defineProperty data "hidden" (js-object :value undefined :enumerable false :writable false :configurable t)) (put data :self data)
      (let ((actual (cause data transport)))
        (eqv (Object/getPrototypeOf actual) nil) (eqv (get actual :self) actual) (eqv (get (get actual :__proto__) :polluted) t) (eqv (get (get globalThis.Object :prototype) :polluted) undefined)
        (same (Object/getOwnPropertyDescriptor actual "hidden") (js-object :value undefined :enumerable false :writable false :configurable t))
        (same (Object/getOwnPropertyDescriptor actual "__proto__") (js-object :value (js-object :polluted t) :enumerable t :writable false :configurable false)))))
  (defun caseLazy (transport)
    (let ((reads (js-object :name 0 :message 0 :stack 0 :cause 0)) (original (new globalThis.Error)))
      (each (Object/entries (js-object :name "TypeError" :message "lazy" :stack "TypeError: lazy\n    at original.eli:2:3" :cause false)) (lambda (pair)
        (let ((key (aref pair 0)) (value (aref pair 1))) (Object/defineProperty original key (js-object :configurable t :get (lambda () (put reads key (1+ (get reads key))) value))))))
      (let ((actual (roundTrip original transport)))
        (same reads (js-object :name 1 :message 1 :stack 1 :cause 1)) (assert (instance actual globalThis.TypeError))
        (eqv (get actual :message) "lazy") (eqv (get actual :stack) "TypeError: lazy\n    at original.eli:2:3") (eqv (get actual :cause) false))))
  (defun caseStack (transport)
    (let* ((original (new globalThis.RangeError "native stack")) (actual (roundTrip original transport)) (missing (new globalThis.Error)))
      (assert (instance actual globalThis.RangeError)) (eqv (get actual :stack) (get original :stack))
      (Reflect/deleteProperty missing "stack")
      (let ((copy (roundTrip missing transport))) (eqv (Object/hasOwn copy "stack") false) (eqv (Object/hasOwn copy "message") false))))
  (defun caseBuiltins (transport)
    (let* ((regex (new globalThis.RegExp "a+" "gimu")) (data undefined))
      (put regex :lastIndex 4) (Object/defineProperty regex "global" (js-object :value false :configurable t :writable t))
      (setq data (js-object :invalid (new globalThis.Date globalThis.NaN) :date (new globalThis.Date 123456) :regex regex)) (put (get data :date) :owner data)
      (let* ((actual (get (roundTrip (new globalThis.Error "builtins" (js-object :cause data)) transport) :cause)) (prototype (get globalThis.RegExp :prototype)))
        (assert (Number/isNaN (js-call (get actual :invalid) :getTime))) (eqv (js-call (get actual :date) :getTime) 123456) (eqv (get (get actual :date) :owner) actual)
        (assert (instance (get actual :regex) globalThis.RegExp)) (eqv (get (get actual :regex) :lastIndex) 4) (put (get actual :regex) :lastIndex 0)
        (eqv (aref (Reflect/apply (get prototype :exec) (get actual :regex) (js-array "AAA")) 0) "AAA")
        (eqv (Reflect/apply (get (Object/getOwnPropertyDescriptor prototype "flags") :get) (get actual :regex) (js-array)) "imu")
        (eqv (Reflect/apply (get (Object/getOwnPropertyDescriptor prototype "global") :get) (get actual :regex) (js-array)) t) (eqv (get (get actual :regex) :global) false))))
  (defun caseIntegrity (transport)
    (each (js-array (get globalThis.Object :freeze) (get globalThis.Object :seal) (get globalThis.Object :preventExtensions)) (lambda (integrity)
      (each (js-array (new globalThis.TypeError "cause") (js-object :detail "ordinary cause")) (lambda (child)
        (let* ((value (integrity child)) (original (new globalThis.Error "integrity" (js-object :cause value))))
          (put original :eliscriptDiagnostic (Object/freeze (js-object :code "ELI-A0001" :message "frozen diagnostic" :location (Object/freeze (js-object :file "frozen.eli" :line 2 :column 3)))))
          (put original :diagnostics (Object/freeze (js-array (get original :eliscriptDiagnostic))))
          (put original :eliscriptFrames (Object/freeze (js-array (Object/freeze (js-object :function "compile" :instruction 42)))))
          (put original :eliscriptSourceFrames (Object/freeze (js-array (Object/freeze (js-object :file "frozen.eli" :line 2 :column 3)))))
          (let* ((actual (roundTrip original transport)) (copy (get actual :cause)) (error (instance value globalThis.Error)))
            (eqv (instance copy globalThis.Error) error)
            (eqv (Object/isFrozen copy) (Object/isFrozen value)) (eqv (Object/isSealed copy) (Object/isSealed value)) (eqv (Object/isExtensible copy) (Object/isExtensible value))
            (eqv (get copy (if error "message" "detail")) (get value (if error "message" "detail")))
            (assert (Object/isFrozen (get actual :eliscriptDiagnostic))) (assert (Object/isFrozen (get (get actual :eliscriptDiagnostic) :location)))
            (assert (Object/isFrozen (get actual :diagnostics))) (eqv (aref (get actual :diagnostics) 0) (get actual :eliscriptDiagnostic))
            (each (js-array "eliscriptFrames" "eliscriptSourceFrames") (lambda (name)
              (assert (Object/isFrozen (get actual name))) (assert (Object/isFrozen (aref (get actual name) 0)))
              (eqv (Object/isSealed (get actual name)) t) (eqv (Object/isExtensible (get actual name)) false) (same (get actual name) (get original name)))))))))))
  (defun caseSystem (transport)
    (let ((original (new globalThis.Error "spawn executable ENOENT" (js-object :cause nil))))
      (Object/assign original (js-object :code "ENOENT" :errno -2 :syscall "spawn executable" :path "missing-executable" :spawnargs (js-array "--flag" "argument with spaces" "" "😀")))
      (let ((actual (roundTrip original transport)))
        (assert (instance actual globalThis.Error)) (eqv (get actual :message) (get original :message))
        (eqv (get actual :code) "ENOENT") (eqv (get actual :errno) -2) (eqv (get actual :syscall) "spawn executable") (eqv (get actual :path) "missing-executable")
        (same (get actual :spawnargs) (get original :spawnargs)) (eqv (get actual :cause) nil))))
  (defun caseUnsupported (transport)
    (each (js-array (lambda () 1) (funcall globalThis.Symbol "cause") (new globalThis.WeakMap) (Object/create (js-object :inherited 1))) (lambda (causeValue)
      (let ((actual (roundTrip (new globalThis.Error "original" (js-object :cause causeValue)) transport)))
        (eqv (get actual :name) "CompilerWorkerError") (eqv (get actual :code) "uncloneable-error-cause") (js-call assert :match (get actual :message) (new globalThis.RegExp "could not transport.*exception")))))
    (let ((reads 0) (accessor (js-object)))
      (Object/defineProperty accessor "value" (js-object :enumerable t :get (lambda () (setq reads (1+ reads)) 1)))
      (let ((error (roundTrip (new globalThis.Error "accessor" (js-object :cause accessor)) transport)))
        (eqv (get error :code) "uncloneable-error-cause") (js-call assert :match (get error :message) (new globalThis.RegExp "accessor")) (eqv reads 0)))
    (let ((symbolKey (js-object))) (put symbolKey (funcall globalThis.Symbol "untransportable key") 1)
      (eqv (get (roundTrip (new globalThis.Error "key" (js-object :cause symbolKey)) transport) :code) "uncloneable-error-cause")))
  (test "structured clone preserves actual Error classes, diagnostics, stacks and source frames" (lambda () (caseClasses (aref transports 0))))
  (test "JSON preserves actual Error classes, diagnostics, stacks and source frames" (lambda () (caseClasses (aref transports 1))))
  (test "structured clone keeps primitive throws and primitive causes distinct from Error instances" (lambda () (casePrimitives (aref transports 0))))
  (test "JSON keeps primitive throws and primitive causes distinct from Error instances" (lambda () (casePrimitives (aref transports 1))))
  (test "structured clone preserves AggregateError elements and shared nested Error identity" (lambda () (caseAggregate (aref transports 0))))
  (test "JSON preserves AggregateError elements and shared nested Error identity" (lambda () (caseAggregate (aref transports 1))))
  (test "structured clone preserves cycles across Error, ordinary objects, arrays, Maps and Sets" (lambda () (caseCycles (aref transports 0))))
  (test "JSON preserves cycles across Error, ordinary objects, arrays, Maps and Sets" (lambda () (caseCycles (aref transports 1))))
  (test "structured clone keeps thrown ordinary data ordinary, including Error-shaped cyclic objects" (lambda () (caseOrdinary (aref transports 0))))
  (test "JSON keeps thrown ordinary data ordinary, including Error-shaped cyclic objects" (lambda () (caseOrdinary (aref transports 1))))
  (test "structured clone retains ArrayBuffer/view aliases and custom backreferences without transferring ownership" (lambda () (caseViews (aref transports 0))))
  (test "JSON retains ArrayBuffer/view aliases and custom backreferences without transferring ownership" (lambda () (caseViews (aref transports 1))))
  (test "structured clone retains data descriptors, null prototypes and safe __proto__ keys" (lambda () (caseDescriptors (aref transports 0))))
  (test "JSON retains data descriptors, null prototypes and safe __proto__ keys" (lambda () (caseDescriptors (aref transports 1))))
  (test "structured clone materializes public lazy Error fields exactly once" (lambda () (caseLazy (aref transports 0))))
  (test "JSON materializes public lazy Error fields exactly once" (lambda () (caseLazy (aref transports 1))))
  (test "structured clone handles a normal native Error stack and never invents removed public fields" (lambda () (caseStack (aref transports 0))))
  (test "JSON handles a normal native Error stack and never invents removed public fields" (lambda () (caseStack (aref transports 1))))
  (test "structured clone retains Date and RegExp data without executing user property overrides" (lambda () (caseBuiltins (aref transports 0))))
  (test "JSON retains Date and RegExp data without executing user property overrides" (lambda () (caseBuiltins (aref transports 1))))
  (test "structured clone preserves frozen, sealed and nonextensible causes and diagnostic frames" (lambda () (caseIntegrity (aref transports 0))))
  (test "JSON preserves frozen, sealed and nonextensible causes and diagnostic frames" (lambda () (caseIntegrity (aref transports 1))))
  (test "structured clone preserves system error fields used by native subprocess failures" (lambda () (caseSystem (aref transports 0))))
  (test "JSON preserves system error fields used by native subprocess failures" (lambda () (caseSystem (aref transports 1))))
  (test "structured clone reports untransportable causes explicitly instead of replacing their data" (lambda () (caseUnsupported (aref transports 0))))
  (test "JSON reports untransportable causes explicitly instead of replacing their data" (lambda () (caseUnsupported (aref transports 1))))

  (funcall (js-call test :skipIf (= (funcall hostTypeof (get (js* "globalThis") :SharedArrayBuffer)) "undefined"))
    "structured clone retains shared memory while JSON explicitly rejects it" (lambda ()
      (let* ((buffer (new globalThis.SharedArrayBuffer 8)) (source (new globalThis.Error "shared" (js-object :cause (js-object :buffer buffer :view (new globalThis.Uint8Array buffer)))))
             (actual (roundTrip source (aref transports 0))))
        (eqv (get (get (get actual :cause) :view) :buffer) (get (get actual :cause) :buffer))
        (put (get (get actual :cause) :view) 0 19) (eqv (aref (new globalThis.Uint8Array buffer) 0) 19)
        (let ((rejected (roundTrip source (aref transports 1))))
          (eqv (get rejected :name) "CompilerWorkerError") (eqv (get rejected :code) "uncloneable-error-cause") (js-call assert :match (get rejected :message) (new globalThis.RegExp "shared memory.*JSON"))))))
  (test "ground version-1 records retain Error cause classes, stacks and explicit primitive values" (lambda ()
    (let ((old (js-object :name "URIError" :message "outer" :stack "old stack" :code "OLD" :diagnostics (js-array (js-object :message "diagnostic")) :eliscriptFrames (js-array (js-object :function "read"))
        :cause (js-object :name "EvalError" :message "inner" :stack "old cause" :cause (js-object :name "RangeError" :message "deep" :truncatedCause t)))))
      (each transports (lambda (transport)
        (let ((actual (fromErrorData (funcall (get transport :wire) old))))
          (assert (instance actual globalThis.URIError)) (assert (instance (get actual :cause) globalThis.EvalError)) (assert (instance (get (get actual :cause) :cause) globalThis.RangeError))
          (eqv (get actual :stack) "old stack") (eqv (get (get actual :cause) :stack) "old cause") (eqv (get (get (get actual :cause) :cause) :truncatedCause) t)
          (eqv (get actual :code) "OLD") (same (get actual :diagnostics) (get old :diagnostics)) (same (get actual :eliscriptFrames) (get old :eliscriptFrames)))))
      (each primitiveValues (lambda (primitive)
        (let ((actual (fromErrorData (globalThis.structuredClone (js-object :name "Error" :message "ground" :cause primitive)))))
          (assert (Object/hasOwn actual "cause")) (samePrimitive (get actual :cause) primitive))))
      (eqv (Object/hasOwn (fromErrorData (js-object :name "Error" :message "ground absent")) "cause") false))))
  (defun mockWorker (&rest __host_forwarded_arguments_3)
    (let* ((controlled (aref __host_forwarded_arguments_3 0)))
