    (let* ((extra (aref __host_forwarded_arguments_4 0)))
        (js-call worker :emit "message" (js-object :data (Object/assign (js-object :version compilerWorkerVersion :type "result" :id (get request :id)
          :requestIdentity (get request :requestIdentity) :sourceIdentity (get request :sourceIdentity) :revision (get request :revision) :host "wasm" :ok t :result (js-object :accepted t)) extra))))))
      (put worker :postMessage (lambda (input)
        (when (and controlled (get worker :throwPost) (js-call (js-array "request" "source") :includes (get input :type)))
          (let ((error (get worker :throwPost))) (put worker :throwPost undefined) (throw error)))
        (let ((message (globalThis.structuredClone input)))
          (if controlled
            (progn (js-call (get worker :posted) :push message)
              (each (js-call (get worker :waiting) :slice) (lambda (waiter)
                (let ((found (js-call (get worker :posted) :find (lambda (item) (and (= (get item :type) (get waiter :type)) (not (js-call (get worker :claimed) :has item)))))))
                  (when found
                    (js-call (get worker :claimed) :add found) (js-call (get worker :waiting) :splice (js-call (get worker :waiting) :indexOf waiter) 1) (funcall (get waiter :resolve) found))))))
            (globalThis.queueMicrotask (lambda ()
              (unless (= (get message :type) "cancel")
                (let ((result (js-object :version compilerWorkerVersion :type "result" :id (get message :id) :requestIdentity (get message :requestIdentity)
                    :sourceIdentity (get message :sourceIdentity) :revision (get message :revision) :host "wasm")))
                  (cond ((= (get message :type) "source") (Object/assign result (js-object :ok t :result (js-object :revision (get message :revision) :sourceIdentity (get message :sourceIdentity)))))
                    ((= (get message :type) "shutdown") (put result :ok t))
                    ((> (get (get worker :failures) :length) 0) (Object/assign result (js-object :ok false :error (errorData (js-call (get worker :failures) :shift)))))
                    (t (Object/assign result (js-object :ok t :result (js-object :javascript "export const answer = 42;")))))
                  (let ((event (js-object :data (globalThis.structuredClone result))) (listeners (js-call (get worker :listeners) :get "message")))
                    (when listeners (js-call listeners :forEach (lambda (callback) (callback event)))))))))))))
      worker)))
  (defun noClientListeners (worker) (js-call (get worker :listeners) :forEach (lambda (listeners) (eqv (get listeners :size) 0))))
