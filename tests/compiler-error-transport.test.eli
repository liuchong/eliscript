        (js-call (js-call (get worker :listeners) :get name) :add callback)))
      (put worker :removeEventListener (lambda (name callback)
        (let ((listeners (js-call (get worker :listeners) :get name))) (when listeners (js-call listeners :delete callback)))))
      (put worker :terminate (lambda () (put worker :terminateCount (1+ (get worker :terminateCount)))))
      (put worker :next (lambda (type)
        (let ((found (js-call (get worker :posted) :find (lambda (item) (and (= (get item :type) type) (not (js-call (get worker :claimed) :has item)))))))
          (if found (progn (js-call (get worker :claimed) :add found) (Promise/resolve found))
            (new globalThis.Promise (lambda (accept) (js-call (get worker :waiting) :push (js-object :type type :resolve accept))))))))
      (put worker :emit (lambda (type event)
        (let ((listeners (js-call (get worker :listeners) :get type)))
          (when listeners (each (Array/from listeners) (lambda (listener) (listener event)))))))
