(module tests.wasm-managed-object-integrity-test-ground
  (import "bun:test" beforeAll afterAll describe test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile mkdir rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-object-integrity-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defconst family
    "(module integrity\n (defconst freeze-value (js* \"Object.freeze\")) (defconst frozen-value (js* \"Object.isFrozen\"))\n (defun freeze (x) (Object/freeze x)) (defun frozen (x) (js-call globalThis.Object :isFrozen x))\n (defun alias (x) (funcall freeze-value x)) (defun frozen-alias (x) (funcall frozen-value x))\n (defun freeze-empty () (Object/freeze)) (defun frozen-empty () (Object/isFrozen))\n (defun same-freeze () (and (eq freeze-value (get (js* \"Object\") :freeze)) (eq frozen-value Object/isFrozen)))\n (defun write (x key value) (put x key value))\n (defun read (x key) (get x key))\n (defun push (x value) (js-call x :push value)) (defun push-empty (x) (js-call x :push))\n (defun pop (x) (js-call x :pop)) (defun sort (x) (js-call x :sort))\n (defun sorted (x) (js-call x :toSorted)) (defun slice (x) (js-call x :slice))\n (defun make-map () (new (js* \"Map\"))) (defun make-set () (new (js* \"Set\")))\n (defun map-set (x key value) (js-call x :set key value)) (defun map-get (x key) (js-call x :get key))\n (defun set-add (x value) (js-call x :add value)) (defun has (x value) (js-call x :has value))\n (defun clear (x) (js-call x :clear)) (defun entries (x) (js-call x :entries)) (defun next (x) (js-call x :next))\n (defun function () (lambda (x) x))\n (export freeze frozen alias frozen-alias freeze-empty frozen-empty same-freeze write read push push-empty pop sort sorted slice make-map make-set map-set map-get set-add has clear entries next function))")

  (defasync compiled (&rest __host_default_arguments_1)
    (let* ((source-arg (aref __host_default_arguments_1 0)) (options (aref __host_default_arguments_1 1)))
    (let* ((source (if (undefined? source-arg) family source-arg))
           (p (js-call (get b :compiler) :compile_ir_string (str "(defconst marker 1)\n" source) "integrity.eli"))
           (saved (JSON/stringify p))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))))
      (js-call assert :equal (JSON/stringify p) saved)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let* ((a (instantiateManagedRuntime bytes options))
             (_ (js-call a :auto 1))
             (js (await (dynamic-import (str "data:text/javascript;base64,"
                                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
        (js-object :a a :bytes bytes :js js)))))

  (defun box (a x)
    (cond
      ((= (value-type x) "number") (js-call a :number x))
      ((= (value-type x) "string") (js-call a :string x))
      (t x)))

  (defun read (a x)
    (cond
      ((and x (= (get x :kind) 4)) (js-call a :readNumber x))
      ((and x (= (get x :kind) 5)) (js-call a :readString x))
      (t x)))

  (defun reject (fn &rest __host_default_arguments_2)
    (let* ((code-arg (aref __host_default_arguments_2 0)))
    (let ((code (if (undefined? code-arg) "ELI-RT0003" code-arg)))
      (js-call assert :throws fn
        (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) code))))))))

  (defun finish (a &rest __host_default_arguments_3)
    (let* ((values-arg (aref __host_default_arguments_3 0)))
    (let ((values (if (undefined? values-arg) (js-array) values-arg)))
      (js-call values :forEach (lambda (x) (js-call a :release x)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (test "freeze primitive values is identity and every primitive is already frozen, including missing arguments and exact IEEE values" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js)))
      (js-call
        (js-array undefined nil false t globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                  -0.0 0 globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) globalThis.Number.MAX_VALUE
                  "" "中😀\ud800")
        :forEach
        (lambda (value)
          (let ((input (box a value)))
            (js-call (js-array "freeze" "alias") :forEach
              (lambda (name)
                (let ((out (js-call a :invoke name (js-array input))))
                  (funcall assert (Object/is (read a out) (js-call js name value)))
                  (js-call a :release out))))
            (js-call (js-array "frozen" "frozen-alias") :forEach
              (lambda (name)
                (js-call assert :equal (js-call a :invoke name (js-array input)) t)))
            (js-call a :release input))))
      (js-call assert :equal (js-call a :invoke "freeze-empty") undefined)
      (js-call assert :equal (js-call a :invoke "frozen-empty") t)
      (js-call assert :equal (js-call a :invoke "same-freeze") t)
      (finish a))))

  (test "ordinary freeze keeps identity, is shallow and rejects additions and same-value writes after all argument effects" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (child (js-call a :sourceObject (js-object :x false)))
           (object (js-call a :sourceObject (js-object :child child :x t)))
           (x (js-call a :string "x"))
           (extra (js-call a :string "extra")))
      (js-call assert :equal (js-call a :invoke "frozen" (js-array object)) false)
      (let ((returned (js-call a :invoke "freeze" (js-array object))))
        (funcall assert (js-call a :keyEqual returned object))
        (js-call assert :equal (js-call a :invoke "frozen" (js-array object)) t)
        (js-call assert :equal (js-call a :invoke "frozen" (js-array child)) false)
        (js-call a :collect)
        (reject (lambda () (js-call a :invoke "write" (js-array object x t))))
        (reject (lambda () (js-call a :invoke "write" (js-array object extra t))))
        (js-call assert :equal (js-call a :invoke "read" (js-array object x)) t)
        (js-call assert :equal (js-call a :invoke "read" (js-array object extra)) undefined)
        (js-call assert :equal (js-call a :invoke "write" (js-array child x t)) t)
        (finish a (js-array child object x extra returned))))))

  (test "frozen source arrays reject indexed, hole, named and length writes and mutators but copies are mutable" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (one (js-call a :number 1))
           (two (js-call a :number 2))
           (sparse (let ((s (globalThis.Array 3))) (put s 0 two) (put s 2 one) s))
           (array (js-call a :sourceArray sparse))
           (frozen (js-call a :invoke "freeze" (js-array array)))
           (zero (js-call a :number 0))
           (hole (js-call a :number 1))
           (length (js-call a :string "length"))
           (name (js-call a :string "tag")))
      (js-call (js-array (js-array zero two) (js-array hole one) (js-array length zero) (js-array name t)) :forEach
        (lambda (pair)
          (reject (lambda () (js-call a :invoke "write" (js-array array (aref pair 0) (aref pair 1)))))))
      (js-call
        (js-array
          (js-array "push" (js-array array one))
          (js-array "push-empty" (js-array array))
          (js-array "pop" (js-array array))
          (js-array "sort" (js-array array)))
        :forEach
        (lambda (pair)
          (reject (lambda () (js-call a :invoke (aref pair 0) (aref pair 1))))))
      (js-call assert :equal (js-call a :length array) 3)
      (js-call assert :equal (js-call a :get array 1) undefined)
      (js-call (js-array "slice" "sorted") :forEach
        (lambda (method)
          (let ((copy (js-call a :invoke method (js-array array))))
            (js-call assert :equal (js-call a :invoke "frozen" (js-array copy)) false)
            (let ((n (js-call a :invoke "push" (js-array copy one))))
              (js-call a :release n)
              (js-call a :release copy)))))
      (finish a (js-array one two array frozen zero hole length name)))))

  (test "frozen array empty and sparse boundaries match actual writes, and comparator effects precede strict write failure" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js)))
      (js-call (js-array (js-array) (globalThis.Array 1) (globalThis.Array 4) (js-array undefined) (js-array false)) :forEach
        (lambda (values)
          (let* ((arr (js-call a :sourceArray values))
                 (frozen (js-call a :invoke "freeze" (js-array arr)))
                 (reference (Object/freeze (js-call values :slice))))
            (js-call (js-array "push_empty" "pop" "sort") :forEach
              (lambda (name)
                (let ((failed false))
                  (try
                    (js-call js name reference)
                    (catch e
                      (js-call assert :equal (get e :name) "TypeError")
                      (setq failed t)))
                  (if failed
                    (reject (lambda () (js-call a :invoke (js-call name :replaceAll "_" "-") (js-array arr))))
                    (let ((out undefined))
                      (try
                        (setq out (js-call a :invoke (js-call name :replaceAll "_" "-") (js-array arr)))
                        (catch e
                          (put e :message (str (get e :message) " case " name " length " (js-length values) " own " (Object/keys values)))
                          (throw e)))
                      (funcall assert (js-call a :keyEqual out arr))
                      (js-call a :release out))))))
            (js-call assert :equal (js-call a :length arr) (js-length values))
            (js-call a :release arr)
            (js-call a :release frozen))))
      (finish a))
    (let* ((source "(defun run (trace) (let ((a (Object/freeze (js-array 2 1)))) (js-call a :sort (lambda (x y) (put trace :compared t) (- x y))))) (defun recover () (js-call (Object/freeze (js-array 2 1)) :toSorted)) (export run recover)")
           (c2 (await (compiled source)))
           (ta (get c2 :a))
           (ref (get c2 :js))
           (trace (js-call ta :sourceObject (js-object))))
      (js-call assert :throws (lambda () (js-call ref :run (js-object))) globalThis.TypeError)
      (reject (lambda () (js-call ta :invoke "run" (js-array trace))))
      (let ((key (js-call ta :string "compared"))
            (copy (js-call ta :invoke "recover")))
        (js-call assert :equal (js-call ta :objectGet trace key) t)
        (js-call assert :equal (js-call ta :length copy) 2)
        (finish ta (js-array trace key copy))))))

  (test "frozen Map Set and iterator own properties are immutable while their internal entries and iterator position remain live" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (map (js-call a :invoke "make-map"))
           (set (js-call a :invoke "make-set"))
           (key (js-call a :string "key"))
           (tag (js-call a :string "tag"))
           (value (js-call a :number 7)))
      (js-call (js-array map set) :forEach
        (lambda (v)
          (let ((stored (js-call a :invoke "write" (js-array v tag value))))
            (js-call assert :equal (and stored (get stored :kind)) 4)
            (js-call a :release stored))
          (let ((out (js-call a :invoke "freeze" (js-array v))))
            (js-call a :release out))
          (js-call assert :equal (js-call a :invoke "frozen" (js-array v)) t)
          (reject (lambda () (js-call a :invoke "write" (js-array v tag value))))
          (let ((other (js-call a :string "new")))
            (reject (lambda () (js-call a :invoke "write" (js-array v other t))))
            (js-call a :release other))))
      (let ((inserted (js-call a :invoke "map-set" (js-array map key value))))
        (js-call a :release inserted))
      (let ((got (js-call a :invoke "map-get" (js-array map key))))
        (js-call assert :equal (js-call a :readNumber got) 7)
        (js-call a :release got))
      (let ((added (js-call a :invoke "set-add" (js-array set key))))
        (js-call a :release added))
      (js-call assert :equal (js-call a :invoke "has" (js-array set key)) t)
      (let ((iterator (js-call a :invoke "entries" (js-array map)))
            (frozen undefined))
        (setq frozen (js-call a :invoke "freeze" (js-array iterator)))
        (js-call a :release frozen)
        (js-call assert :equal (js-call a :invoke "frozen" (js-array iterator)) t)
        (let ((entry (js-call a :invoke "next" (js-array iterator)))
              (doneKey (js-call a :string "done")))
          (js-call assert :equal (js-call a :objectGet entry doneKey) false)
          (js-call a :release entry)
          (js-call a :release doneKey))
        (js-call a :invoke "clear" (js-array map))
        (js-call assert :equal (js-call a :invoke "map-get" (js-array map key)) undefined)
        (finish a (js-array map set key tag value iterator))))))

  (test "freezing own properties leaves child objects and inherited prototypes mutable but inherited frozen data cannot be shadowed by assignment" (async ()
    (let* ((source "(defun run () (let* ((parent (Object/freeze (js-object :locked 1))) (child (js-object :__proto__ parent))) (put child :free 2) child)) (defun write (x key value) (put x key value)) (defun frozen (x) (Object/isFrozen x)) (defun freeze (x) (Object/freeze x)) (export run write frozen freeze)")
           (c (await (compiled source)))
           (a (get c :a))
           (child (js-call a :invoke "run"))
           (locked (js-call a :string "locked"))
           (free (js-call a :string "free"))
           (two (js-call a :number 2)))
      (js-call assert :equal (js-call a :invoke "frozen" (js-array child)) false)
      (reject (lambda () (js-call a :invoke "write" (js-array child locked two))))
      (let ((out (js-call a :invoke "write" (js-array child free two))))
        (js-call assert :equal (js-call a :readNumber out) 2)
        (js-call a :release out))
      (let ((frozen (js-call a :invoke "freeze" (js-array child))))
        (js-call a :release frozen))
      (reject (lambda () (js-call a :invoke "write" (js-array child free two))))
      (finish a (js-array child locked free two)))))

  (test "freeze preserves __proto__ setter rules for identical, primitive and changing prototypes" (async ()
    (let* ((source "(defun run () (let* ((parent (js-object :x 1)) (o (js-object :__proto__ parent))) (Object/freeze o) (put o :__proto__ parent) (put o :__proto__ 7) (put parent :x 2) (js-array (get o :x) (Object/isFrozen o) (Object/isFrozen parent)))) (defun changed () (let ((o (Object/freeze (js-object)))) (put o :__proto__ nil))) (export run changed)")
           (c (await (compiled source)))
           (a (get c :a))
           (js (get c :js))
           (out (js-call a :invoke "run"))
           (expected (js-call js :run))
           (i 0))
      (while (< i (js-length expected))
        (let ((value (js-call a :get out i)))
          (js-call assert :equal (read a value) (aref expected i))
          (js-call a :release value))
        (setq i (1+ i)))
      (js-call assert :throws (lambda () (js-call js :changed)) globalThis.TypeError)
      (reject (lambda () (js-call a :invoke "changed")))
      (finish a (js-array out)))))

  (test "freeze aliases capture global functions before ignored argument effects and lexical methods retain ordinary lookup order" (async ()
    (let* ((source "(defun run () (let ((trace (js-object :n 0)) (o (js-object))) (let ((out (js-call globalThis.Object :freeze o (put trace :n 7)))) (js-array (eq out o) (Object/isFrozen o) (get trace :n) (Object/isFrozen o (put trace :n 9)) (get trace :n))))) (defun shadow (Object trace) (js-call Object :freeze (put trace :seen 3) (if (= (value-type Object) \"object\") (put Object :freeze false) false))) (defun factory () (lambda (&rest args) (js-length args))) (export run shadow factory)")
           (c (await (compiled source)))
           (a (get c :a))
           (js (get c :js))
           (out (js-call a :invoke "run"))
           (expected (js-call js :run))
           (i 0))
      (while (< i (js-length expected))
        (let ((value (js-call a :get out i)))
          (js-call assert :equal (read a value) (aref expected i))
          (js-call a :release value))
        (setq i (1+ i)))
      (let* ((f (js-call a :invoke "factory"))
             (object (js-call a :sourceObject (js-object :freeze f)))
             (trace (js-call a :sourceObject (js-object)))
             (result (js-call a :invoke "shadow" (js-array object trace))))
        (js-call assert :equal (js-call a :readNumber result) 2)
        (js-call (js-array nil false) :forEach
          (lambda (receiver)
            (let ((tr (js-call a :sourceObject (js-object))))
              (reject (lambda () (js-call a :invoke "shadow" (js-array receiver tr))))
              (let* ((key (js-call a :string "seen"))
                     (seen (js-call a :objectGet tr key)))
                (js-call assert :equal (read a seen) (if (nil? receiver) undefined 3))
                (js-call a :release key)
                (js-call a :release seen)
                (js-call a :release tr)))))
        (finish a (js-array out f object trace result))))))

  (test "raw integrity rejects invalid private stale and unrepresented kinds, and freezing uses no allocations even at capacity" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (js-call e "heap-new" 32 8192 8192))
             (call (lambda (n &rest args)
                     (let ((v (uint32 (Reflect/apply (get e n) e (js-call (js-array heap) :concat args)))))
                       (js-call assert :equal (js-call e "last-error") 0 n)
                       v)))
             (object (funcall call "value-object-new" 3))
             (array (funcall call "value-array-new" 0))
             (frame (funcall call "frame-new" 2)))
        (funcall call "frame-set" frame 0 object)
        (funcall call "frame-set" frame 1 array)
        (let* ((unsealed (funcall call "value-string" 1))
               (refs (funcall call "value-refs" 7 0))
               (record (funcall call "value-refs" 8 0))
               (bytesValue (funcall call "value-bytes" 0))
               (held (js-array unsealed refs record bytesValue)))
          (js-call held :forEach (lambda (x) (funcall call "heap-pin" x)))
          (js-call
            (js-array
              (js-array 4294967295 1) (js-array frame 3) (js-array unsealed 6)
              (js-array refs 3) (js-array record 3) (js-array bytesValue 3))
            :forEach
            (lambda (pair)
              (let ((op 0))
                (while (< op 2)
                  (js-call assert :equal (js-call e "value-object-integrity" heap (aref pair 0) op) 0)
                  (js-call assert :equal (js-call e "last-error") (aref pair 1))
                  (js-call assert :equal (funcall call "frame-depth") 1)
                  (js-call assert :equal (funcall call "frame-get" frame 0) object)
                  (setq op (1+ op))))))
          (js-call assert :equal (js-call e "value-object-integrity" heap object 2) 0)
          (js-call assert :equal (js-call e "last-error") 3)
          (let ((stale (funcall call "value-number" 0 0)))
            (funcall call "heap-collect")
            (js-call assert :equal (js-call e "value-object-integrity" heap stale 0) 0)
            (js-call assert :equal (js-call e "last-error") 1))
          (let ((filling t))
            (while (and filling (< (js-length held) 32))
              (let ((v (uint32 (js-call e "value-number" heap 0 0))))
                (if (= v 0)
                  (progn
                    (js-call assert :equal (js-call e "last-error") 2)
                    (setq filling false))
                  (progn
                    (funcall call "heap-pin" v)
                    (js-call held :push v))))))
          (let ((used (funcall call "heap-used")))
            (js-call (js-array object array) :forEach
              (lambda (value)
                (js-call assert :equal (funcall call "value-object-integrity" value 0) value)
                (js-call assert :equal (funcall call "value-object-integrity" value 0) value)
                (js-call assert :equal (funcall call "value-object-integrity" value 1) 2)))
            (js-call assert :equal (funcall call "heap-used") used))
          (js-call held :forEach (lambda (x) (funcall call "heap-release" x)))
          (funcall call "frame-pop" frame)
          (funcall call "heap-collect")
          (js-call assert :equal (funcall call "heap-live") 0)
          (let ((fresh (funcall call "value-array-new" 0)))
            (js-call assert :equal (funcall call "value-object-integrity" fresh 1) 1)
            (funcall call "heap-collect")
            (js-call assert :equal (funcall call "heap-live") 0)))))))

  (test "raw array and ordinary object mutation paths enforce freezing without leaking roots" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (js-call e "heap-new" 64 16384 16384))
             (call (lambda (n &rest args)
                     (let ((v (uint32 (Reflect/apply (get e n) e (js-call (js-array heap) :concat args)))))
                       (js-call assert :equal (js-call e "last-error") 0 n)
                       v)))
             (object (funcall call "value-object-new" 3))
             (array (funcall call "value-array-new" 2))
             (key (funcall call "value-string" 1))
             (frame (funcall call "frame-new" 3)))
        (js-call (js-array object array key) :forEach
          (lambda (v i) (funcall call "frame-set" frame i v)))
        (funcall call "value-unit-set" key 0 120)
        (funcall call "value-seal" key)
        (funcall call "value-object-put" object key 2 2)
        (funcall call "value-set" array 0 2)
        (funcall call "value-object-integrity" object 0)
        (funcall call "value-object-integrity" array 0)
        (js-call
          (js-array
            (js-array "value-set" (js-array array 0 2))
            (js-array "value-set" (js-array array 1 2))
            (js-array "value-array-resize" (js-array array 2))
            (js-array "value-array-resize" (js-array array 0))
            (js-array "value-array-put" (js-array array key 2))
            (js-array "value-array-define" (js-array array key 2))
            (js-array "value-object-put" (js-array object key 2 0))
            (js-array "value-object-put" (js-array object key 2 1))
            (js-array "value-object-put" (js-array object key 2 2)))
          :forEach
          (lambda (spec)
            (let ((name (aref spec 0))
                  (args (aref spec 1)))
              (js-call assert :equal (Reflect/apply (get e name) e (js-call (js-array heap) :concat args)) 0 name)
              (js-call assert :equal (js-call e "last-error") 3 name)
              (js-call assert :equal (funcall call "frame-depth") 1)
              (js-call assert :equal (funcall call "value-object-get" object key) 2)
              (js-call assert :equal (funcall call "value-get" array 0) 2))))
        (funcall call "heap-auto" 1)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "value-object-integrity" object 1) 2)
        (js-call assert :equal (funcall call "value-object-integrity" array 1) 2)
        (funcall call "frame-pop" frame)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)))))

  (test "actual freeze WASM traps retain argument effects and unwind only source-owned frames" (async ()
    (let* ((source "(defconst marker 1) (defun run (trace) (Object/freeze (progn (put trace :called t) trace))) (export run)")
           (p (js-call (get b :compiler) :compile_ir_string source "freeze-trap.eli"))
           (text (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call text :indexOf "  (defun value-object-integrity "))
           (end (js-call text :indexOf "  (defun " (+ start 3))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call text :slice 0 start)
                              "  (defun value-object-integrity (heap value operation) (load-u32 4294967295))\n"
                              (js-call text :slice end))
                         "trap-runtime.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p injected))))
             (_ (js-call a :auto 1))
               (trace (js-call a :sourceObject (js-object)))
               (saved (js-call a :number -0.0))
               (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 saved)
        (js-call assert :throws
          (lambda () (js-call a :invoke "run" (js-array trace)))
          globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
        (let ((key (js-call a :string "called")))
          (js-call assert :equal (js-call a :objectGet trace key) t)
          (js-call a :leaveFrame frame)
          (finish a (js-array trace saved key)))))))

  (test "unrepresented function and RegExp own-property models explicitly refuse integrity rather than claiming to freeze them" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (fn (js-call a :invoke "function")))
      (js-call (js-array "freeze" "frozen") :forEach
        (lambda (name) (reject (lambda () (js-call a :invoke name (js-array fn))))))
      (finish a (js-array fn)))
    (let* ((c2 (await (compiled "(defun run () (Object/freeze (js* \"/x/u\"))) (export run)")))
           (r (get c2 :a)))
      (reject (lambda () (js-call r :invoke "run")))
      (finish r))))

  (test "deterministic randomized sparse frozen arrays retain JS write failures and mutable shallow copies" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js))
           (seed 2519631133)
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (k 0))
      (while (< k 128)
        (let* ((length (% (funcall next) 12))
               (source (globalThis.Array length))
               (boxed (globalThis.Array length))
               (roots (js-array))
               (i 0))
          (while (< i length)
            (when (not (= (% (funcall next) 4) 0))
              (let* ((value (if (= (% (funcall next) 3) 0) undefined (- (% (funcall next) 19) 9)))
                     (bv (box a value)))
                (put source i value)
                (put boxed i bv)
                (js-call roots :push bv)))
            (setq i (1+ i)))
          (let ((input (js-call a :sourceArray boxed))
                (frozen undefined)
                (ref (Object/freeze source))
                (failure false))
            (setq frozen (js-call a :invoke "freeze" (js-array input)))
            (try
              (js-call js :sort ref)
              (catch e
                (js-call assert :equal (get e :name) "TypeError")
                (setq failure t)))
            (if failure
              (reject (lambda () (js-call a :invoke "sort" (js-array input))))
              (let ((out (js-call a :invoke "sort" (js-array input))))
                (funcall assert (js-call a :keyEqual out input))
                (js-call a :release out)))
            (js-call assert :equal (js-call a :length input) length)
            (let ((j 0))
              (while (< j length)
                (let ((out (js-call a :get input j)))
                  (funcall assert (Object/is (read a out) (aref source j)))
                  (js-call a :release out))
                (setq j (1+ j))))
            (js-call (js-array "slice" "sorted") :forEach
              (lambda (name)
                (let ((copy (js-call a :invoke name (js-array input)))
                      (expected (js-call js name source))
                      (m 0))
                  (js-call assert :equal (js-call a :invoke "frozen" (js-array copy)) false)
                  (while (< m (js-length expected))
                    (let ((out (js-call a :get copy m)))
                      (funcall assert (Object/is (read a out) (aref expected m)))
                      (js-call a :release out))
                    (setq m (1+ m)))
                  (js-call a :release copy))))
            (js-call (js-call (js-array input frozen) :concat roots) :forEach
              (lambda (v) (js-call a :release v)))
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
        (setq k (1+ k)))
      (finish a))))

  (test "Node independently executes the identical zero-import integrity artifact against native strict mutation rules" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let ((file (resolve directory "integrity.wasm")))
        (await (writeFile file bytes))
        (let ((child (spawnSync "node"
                       (js-array (resolve "tests/helpers/wasm-managed-object-integrity-node.mjs")
                                 (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                 file)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))))))

  (test "linked namespace objects retain existing empty and nonempty integrity rules and live bindings" (async ()
    (let ((cases (js-array t false))
          (idx 0))
      (while (< idx (js-length cases))
        (let* ((empty (aref cases idx))
               (lib-program (js-call (get b :compiler) :compile_ir_string
                              (if empty "(defconst hidden 1)" "(defvar value 1) (export value)")
                              "lib.eli"))
               (main-program (js-call (get b :compiler) :compile_ir_string
                               "(import \"./lib.mjs\" :as ns) (defun lock () (Object/freeze ns)) (defun status () (Object/isFrozen ns)) (export lock status ns)"
                               "main.eli"))
               (modules (js-array (js-object :id "lib.mjs" :program lib-program)
                                  (js-object :id "main.mjs" :program main-program)))
               (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "main.mjs" runtime))))
          (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (let ((a (instantiateManagedRuntime bytes)))
            (js-call a :auto 1)
            (js-call assert :equal (js-call a :invoke "status") empty)
            (if empty
              (let ((out (js-call a :invoke "lock"))
                    (ns (js-call a :getExport "ns")))
                (funcall assert (js-call a :keyEqual out ns))
                (js-call a :release out)
                (js-call a :release ns))
              (reject (lambda () (js-call a :invoke "lock"))))
            (js-call assert :equal (js-call a :invoke "status") empty)
            (finish a))
          (let ((native (await (dynamic-import (str "data:text/javascript;base64,"
                                                    (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string lib-program)) :toString "base64"))))))
            (js-call assert :equal (Object/isFrozen native) empty)
            (if empty
              (js-call assert :equal (Object/freeze native) native)
              (js-call assert :throws (lambda () (Object/freeze native)) globalThis.TypeError))))
        (setq idx (1+ idx))))))

  (test "namespace integrity checks preserve the first uninitialized binding error during cyclic evaluation" (async ()
    (let ((ops (js-array "Object/isFrozen" "Object/freeze"))
          (idx 0))
      (while (< idx (js-length ops))
        (let* ((operation (aref ops idx))
               (sources (js-object
                          "main.mjs" "(import \"./other.mjs\" result) (defconst value 1) (export value)"
                          "other.mjs" (str "(import \"./main.mjs\" :as ns) (defconst result (" operation " ns)) (export result)")))
               (base (resolve directory (str "namespace-" (js-call operation :replaceAll "/" "-"))))
               (modules (js-array))
               (entries (Object/entries sources))
               (j 0))
          (await (mkdir base))
          (while (< j (js-length entries))
            (let* ((pair (aref entries j))
                   (id (aref pair 0))
                   (source (aref pair 1))
                   (program (js-call (get b :compiler) :compile_ir_string source id)))
              (js-call modules :push (js-object :id id :program program))
              (await (writeFile (resolve base id) (js-call (get b :compiler) :emit_ir_string program))))
            (setq j (1+ j)))
          (let ((node (spawnSync "node" (js-array (resolve base "main.mjs")) (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get node :status) 1 (get node :stderr))
            (js-call assert :match (get node :stderr) (new globalThis.RegExp "ReferenceError")))
          (let* ((bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "main.mjs" runtime)))
                 (a (instantiateManagedRuntime bytes (js-object :initializeModule false)))
                 (_ (js-call a :auto 1))
                 (saved (js-call a :number -0.0))
                 (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 saved)
            (reject (lambda () (js-call a :initializeModule)) "ELI-RT0008")
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
            (js-call a :leaveFrame frame)
            (finish a (js-array saved))))
        (setq idx (1+ idx))))))

  (test "linked lexical and module shadows retain their own integrity methods and explicit host aliases" (async ()
    (let* ((source "(defconst Object (js-object :freeze (lambda (x extra) extra) :isFrozen (lambda (x) 23))) (defun call (x) (Object/freeze x 31)) (defun local (x) (let ((Object (js-object :freeze (lambda (x) 17)))) (funcall (js* \"Object.freeze\") x))) (defun explicit (globalThis x) (funcall (js* \"globalThis.Object.isFrozen\") x)) (defun factory () (lambda (x) 41)) (export call local explicit factory)")
           (p (js-call (get b :compiler) :compile_ir_string source "shadows.eli"))
           (entry (js-call (get b :compiler) :compile_ir_string "(import \"./shadows.mjs\" call local explicit factory) (export call local explicit factory)" "main.eli"))
           (js (await (dynamic-import (str "data:text/javascript;base64,"
                                           (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
      (js-call assert :equal (js-call js :call nil) 31)
      (js-call assert :equal (js-call js :local nil) 17)
      (js-call assert :equal (js-call js :explicit (js-object :Object (js-object :isFrozen (lambda () 41))) nil) 41)
      (js-call
        (js-array
          (js-call (get b :managed) :emit_managed_wasm p runtime)
          (js-call (get b :managed) :emit_managed_project_wasm
            (js-array (js-object :id "shadows.mjs" :program p) (js-object :id "main.mjs" :program entry))
            "main.mjs" runtime))
        :forEach
        (lambda (bytes)
          (let ((a (instantiateManagedRuntime (Uint8Array/from bytes))))
            (js-call a :auto 1)
            (js-call (js-array (js-array "call" 31) (js-array "local" 17)) :forEach
              (lambda (pair)
                (let ((out (js-call a :invoke (aref pair 0) (js-array nil))))
                  (js-call assert :equal (js-call a :readNumber out) (aref pair 1))
                  (js-call a :release out))))
            (let* ((f (js-call a :invoke "factory"))
                   (object (js-call a :sourceObject (js-object :isFrozen f)))
                   (host (js-call a :sourceObject (js-object :Object object)))
                   (out (js-call a :invoke "explicit" (js-array host nil))))
              (js-call assert :equal (js-call a :readNumber out) 41)
              (finish a (js-array f object host out)))))))))

  (defconst integrityScenarios
    (js-array
      (js-object
        :id "shallow-identity"
        :given "an object owns a mutable child"
        :when "only the parent is frozen and the child is changed"
        :then "the parent keeps identity and only its own properties are frozen"
        :source "(defun run () (let* ((child (js-object :value 1)) (parent (js-object :child child)) (result (Object/freeze parent))) (put child :value 2) (js-array (eq parent result) (Object/isFrozen parent) (Object/isFrozen child) (get child :value))))"
        :expected (js-array t t false 2))
      (js-object
        :id "strict-write-and-recovery"
        :given "a frozen object owns a data property"
        :when "a strict assignment writes the same value"
        :then "the write fails and a following independent frozen query succeeds"
        :source "(defun run () (put (Object/freeze (js-object :x 1)) :x 1)) (defun recover () (Object/isFrozen (Object/freeze (js-object))))"
        :error t
        :recover t)
      (js-object
        :id "collection-internal-slots"
        :given "a frozen Map wrapper contains no entries"
        :when "its entries are added and then cleared"
        :then "internal entries remain mutable while the wrapper stays frozen"
        :source "(defun run () (let ((m (Object/freeze (new (js* \"Map\"))))) (js-call m :set \"key\" 7) (let ((value (js-call m :get \"key\"))) (js-call m :clear) (js-array value (get m :size) (Object/isFrozen m)))))"
        :expected (js-array 7 0 t))
      (js-object
        :id "invalid-comparator-before-short-sort"
        :given "a frozen empty array has an invalid sort comparator"
        :when "sort checks that comparator"
        :then "the comparator error is preserved even though no item would be written"
        :source "(defun run () (js-call (Object/freeze (js-array)) :sort false)) (defun recover () (js-length (js-call (Object/freeze (js-array)) :toSorted)))"
        :error t
        :recover 0)))

  (describe "Feature: Shallow source object integrity" (lambda ()
    (js-call integrityScenarios :forEach
      (lambda (scenario)
        (test (str "Scenario: " (get scenario :id) "\nGiven " (get scenario :given) "\nWhen " (get scenario :when) "\nThen " (get scenario :then))
          (async ()
            (let* ((c (await (compiled (str (get scenario :source) " (export run" (if (get scenario :error) " recover" "") ")"))))
                   (a (get c :a))
                   (js (get c :js)))
              (if (get scenario :error)
                (progn
                  (js-call assert :throws (lambda () (js-call js :run)) globalThis.TypeError)
                  (reject (lambda () (js-call a :invoke "run")))
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                  (let ((out (js-call a :invoke "recover")))
                    (js-call assert :equal (read a out) (get scenario :recover))
                    (js-call assert :equal (js-call js :recover) (get scenario :recover))
                    (finish a (js-array out))))
                (let ((expected (get scenario :expected)))
                  (js-call assert :deepEqual (js-call js :run) expected)
                  (let ((out (js-call a :invoke "run"))
                        (i 0))
                    (js-call assert :equal (js-call a :length out) (js-length expected))
                    (while (< i (js-length expected))
                      (let ((value (js-call a :get out i)))
                        (js-call assert :equal (read a value) (aref expected i))
                        (js-call a :release value))
                      (setq i (1+ i)))
                    (finish a (js-array out)))))))))))))
