(module tests.native-memory-data-copy.test
  (import "node:process" :default process)
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)
  (import "../tools/backends/compiler-debug.mjs" createCompilerDebugMap)
  (defconst target (if (= (get process :arch) "arm64") (if (= (get process :platform) "darwin") "arm64-macos" (if (= (get process :platform) "linux") "arm64-linux" undefined)) undefined))
  (defconst nativeTest (js-call test :skipIf (not target)))
  (defconst span (js-object :filename "static-copy.eli" :start 12 :end 31 :line 1 :column 13))
  (defvar directory undefined) (defvar backend undefined) (defvar serial 0)
  (beforeAll (async () (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-data-copy-")))) (setq backend (await (buildBackends (js-object :outputRoot directory))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun each (items operation) (js-call items :forEach operation))
  (defasync eachAsync (items operation) (let ((index 0)) (while (< index (get items :length)) (await (funcall operation (aref items index))) (setq index (1+ index)))))
  (defun literal (value) (js-object :kind "literal" :type "u32" :value value :children (js-array)))
  (defun local () (js-object :kind "local" :type "u32" :value 0 :children (js-array)))
  (defun sequence (children) (js-object :kind "sequence" :type "u32" :value nil :children children))
  (defun operation (value &rest children) (js-object :kind "memory-op" :type "u32" :value value :children children))
  (defun program (text &rest __host_default_arguments_1)
    (let* ((address (aref __host_default_arguments_1 0)))
    (when (= address undefined) (setq address (local)))
    (js-object :abi "memory-u32" :filename (get span :filename) :exports (js-array "copy" "outer") :functions (js-array
      (js-object :name "copy" :index 0 :arity 1 :locals (js-array (js-object :name "p" :index 0 :type "u32")) :span span
        :body (js-object :kind "memory-data-copy" :type "u32" :value text :children (js-array address) :span span))
      (js-object :name "outer" :index 1 :arity 1 :locals (js-array (js-object :name "p" :index 0 :type "u32")) :span span
        :body (sequence (js-array (js-object :kind "call" :type "u32" :value 0 :children (js-array (local))) (operation "store-u8" (literal 1) (literal 88)))))))))
  (defun utf16 (text)
    (let* ((bytes (new globalThis.Uint8Array (* (get text :length) 2))) (view (new globalThis.DataView (get bytes :buffer))) (index 0))
      (while (< index (get text :length)) (js-call view :setUint16 (* index 2) (js-call text :charCodeAt index) t) (setq index (1+ index))) bytes))
  (defasync pair (typed &rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)) (extra (aref __host_default_arguments_2 1)))
    (when (= options undefined) (setq options (js-object :initialPages 1 :maximumPages 2)))
    (when (= extra undefined) (setq extra (js-object :nativeOnly false)))
    (let* ((saved (funcall globalThis.structuredClone typed))
           (emission (js-call (get backend :native) :emit_typed_native_memory_artifact typed target))
           (file (resolve directory (str "copy-" serial "." (if (= target "arm64-linux") "so" "dylib")))))
      (setq serial (1+ serial))
      (js-call assert :deepEqual typed saved "native emission preserves the public typed input")
      (await (writeFile file (Uint8Array/from (get emission :bytes))))
      (let ((n (await (openNativeMemory file (js-object :copy 1 :outer 1)
        (Object/assign (js-object) options (js-object :nativeTarget target :debug (get emission :debug) :trapSites (get (get emission :debug) :trapSites)))))))
        (try
          (let ((runtimes (js-array (js-object :invoke (lambda (name &rest args) (Reflect/apply (get n :invoke) n (js-call (js-array name) :concat args)))
            :read (lambda (at length) (js-call n :read at length))
            :write (lambda (bytes &rest __host_default_arguments_3)
    (let* ((at (aref __host_default_arguments_3 0))) (js-call n :write bytes (if (= at undefined) 0 at))))))))
            (unless (get extra :nativeOnly)
              (let* ((bytes (js-call (get backend :wasm) :emit_typed_memory_wasm typed options))
                     (module (progn (js-call assert :deepEqual typed saved "WASM emission preserves the public typed input") (new WebAssembly.Module (Uint8Array/from bytes))))
                     (w (progn (js-call assert :deepEqual (WebAssembly.Module/imports module) (js-array)) (get (new WebAssembly.Instance module) :exports))))
                (js-call runtimes :push (js-object :invoke (lambda (name &rest args) (uint32 (Reflect/apply (get w name) w args)))
                  :read (lambda (at length) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice at (+ at length)))
                  :write (lambda (bytes &rest __host_default_arguments_4)
    (let* ((at (aref __host_default_arguments_4 0))) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :set bytes (if (= at undefined) 0 at))))))))
            (js-call assert :deepEqual typed saved) (js-object :n n :debug (get emission :debug) :runtimes runtimes))
          (catch error (js-call n :close) (throw error)))))))
  (defun diagnostic (error) (let ((value (get error :eliscriptDiagnostic))) (if (nullish? value) undefined (get value :code))))
  (nativeTest "native memory kernel copies a packed literal from actual source without expanding it into stores" (async ()
    (let* ((text (js-call "table\u0000😀\ud800\udfff\uffff" :repeat 4096))
           (source (str "(import \"eliscript:memory32\" copy-static-u16 load-u32 store-u32)\n"
             "(defun copy (address) (copy-static-u16 (progn (store-u32 0 (+ (load-u32 0) 1)) address) " (JSON/stringify text) "))\n(export copy)"))
           (ir (js-call (get backend :compiler) :compile_ir_string source "native-static-kernel.eli")) (saved (JSON/stringify ir))
           (bytes (Uint8Array/from (js-call (get backend :native) :emit_native_memory_library ir target)))
           (file (resolve directory (str "kernel-" serial (if (= target "arm64-linux") ".so" ".dylib")))))
      (setq serial (1+ serial)) (js-call assert :equal (JSON/stringify ir) saved)
      (assert (< (get bytes :length) (+ (* (get text :length) 2) 65536)) "packed data remains data in a source-generated native library")
      (await (writeFile file bytes))
      (let ((runtime (await (openNativeMemory file (js-object :copy 1) (js-object :initialPages 4 :maximumPages 4 :nativeTarget target)))))
        (try
          (let* ((expected (utf16 text)) (counter (lambda () (let ((bytes (js-call runtime :read 0 4))) (js-call (new globalThis.DataView (get bytes :buffer) (get bytes :byteOffset) (get bytes :byteLength)) :getUint32 0 t)))))
            (js-call assert :equal (js-call runtime :invoke "copy" 64) 0)
            (js-call assert :deepEqual (js-call runtime :read 64 (get expected :length)) expected) (js-call assert :equal (counter) 1)
            (js-call runtime :write (js-call (new globalThis.Uint8Array (get expected :length)) :fill 151) 64)
            (js-call assert :equal (js-call runtime :invoke "copy" 64) 0)
            (js-call assert :deepEqual (js-call runtime :read 64 (get expected :length)) expected) (js-call assert :equal (counter) 2)
            (let ((end (- (* 4 65536) 4))) (js-call runtime :write (Uint8Array/of 145 145 145 145) end)
              (js-call assert :throws (lambda () (js-call runtime :invoke "copy" end)))
              (js-call assert :deepEqual (Array/from (js-call runtime :read end 4)) (js-array 145 145 145 145)) (js-call assert :equal (counter) 3))
            (js-call assert :equal (js-call runtime :invoke "copy" 64) 0)
            (js-call assert :deepEqual (js-call runtime :read 64 (get expected :length)) expected))
          (finally (js-call runtime :close)))))))
  (test "native static UTF16 data retains exact source units, deterministic images and input on both targets" (lambda ()
    (let* ((text "\u0000A\ud800B\udfff\ud83d\ude80\uffff") (typed (program text)) (saved (funcall globalThis.structuredClone typed)))
      (each (js-array "arm64-macos" "arm64-linux") (lambda (platform)
        (let* ((artifact (js-call (get backend :native) :emit_typed_native_memory_artifact typed platform (js-object :format "object")))
               (ranges (js-call (get (get artifact :debug) :ranges) :filter (lambda (range) (= (get range :kind) "static-data")))))
          (js-call assert :deepEqual (get artifact :bytes) (get (js-call (get backend :native) :emit_typed_native_memory_artifact typed platform (js-object :format "object")) :bytes))
          (js-call assert :equal (get ranges :length) 1) (js-call assert :equal (get (aref ranges 0) :dataKind) "utf16le")
          (let* ((bytes (Uint8Array/from (get artifact :bytes))) (start (+ (get (get (get artifact :debug) :codeSection) :fileOffset) (get (aref ranges 0) :start)))
                 (copy (js-call (get (get artifact :debug) :ranges) :find (lambda (range) (= (get range :kind) "memory-data-copy")))))
            (js-call assert :deepEqual (js-call bytes :slice start (+ start (* (get text :length) 2))) (utf16 text))
            (js-call assert :deepEqual (get copy :span) span)
            (assert (and (< (get copy :start) (get (aref ranges 0) :start)) (> (get copy :end) (get (aref ranges 0) :end))))
            (assert (js-call (get (get artifact :debug) :trapSites) :some (lambda (site) (and (= (get site :code) 1) (= (get site :functionIndex) 0)))))
            (let ((map (createCompilerDebugMap (get artifact :debug)))) (js-call assert :deepEqual (get (js-call map :lookup (get copy :start)) :span) span))
            (js-call assert :deepEqual typed saved))))))))
  (test "native static copy rejects malformed typed data and addresses without rewriting input" (lambda ()
    (let ((changes (js-array
      (lambda (node) (put node :value 42)) (lambda (node) (put node :type "i32"))
      (lambda (node) (put node :children (js-array))) (lambda (node) (js-call (get node :children) :push (local)))
      (lambda (node) (put (get node :children) 0 (Object/assign (js-object) (literal 0) (js-object :type "f64"))))
      (lambda (node) (put (get node :children) 0 (Object/assign (js-object) (local) (js-object :type "i32")))))))
      (each changes (lambda (change) (each (js-array "arm64-macos" "arm64-linux") (lambda (platform)
        (let ((typed (program "x"))) (funcall change (get (aref (get typed :functions) 0) :body))
          (let ((saved (funcall globalThis.structuredClone typed)))
            (js-call assert :throws (lambda () (js-call (get backend :native) :emit_typed_native_memory_object typed platform)) (lambda (error) (= (diagnostic error) "ELI-B0001")))
            (js-call assert :deepEqual typed saved))))))))))
  (nativeTest "static UTF16 copy is exact, unaligned, bounded and reusable after destination mutation" (async ()
    (await (eachAsync (js-array "" "A" "\u0000\ud800\udfff\ud83d\ude80\uffff") (async (text)
      (let* ((result (await (pair (program text)))) (n (get result :n)) (runtimes (get result :runtimes)) (bytes (utf16 text)))
        (try (each runtimes (lambda (runtime)
          (each (js-array 0 1 3 (- 65536 (get bytes :length))) (lambda (at)
            (js-call assert :equal (js-call runtime :invoke "copy" at) 0) (js-call assert :deepEqual (js-call runtime :read at (get bytes :length)) bytes)
            (js-call runtime :write (js-call (new globalThis.Uint8Array (get bytes :length)) :fill 165) at)
            (js-call assert :equal (js-call runtime :invoke "copy" at) 0) (js-call assert :deepEqual (js-call runtime :read at (get bytes :length)) bytes)))
          (js-call runtime :write (Uint8Array/of 21 22 23 24) 65532)
          (each (js-array (- 65537 (get bytes :length)) 65537 4294967294 4294967295) (lambda (at)
            (js-call assert :throws (lambda () (js-call runtime :invoke "copy" at)) WebAssembly.RuntimeError)
            (js-call assert :deepEqual (js-call runtime :read 65532 4) (Uint8Array/of 21 22 23 24))))
          (js-call runtime :write (Uint8Array/of 0) 1)
          (js-call assert :throws (lambda () (js-call runtime :invoke "outer" 65537)) WebAssembly.RuntimeError)
          (js-call assert :equal (aref (js-call runtime :read 1 1) 0) 0)))
          (finally (js-call n :close)))))))))
  (nativeTest "copy destination effects occur once and use current memory after growth, with original trap propagation" (async ()
    (let* ((address (sequence (js-array (operation "store-u32" (literal 8) (js-object :kind "word-arithmetic" :type "u32" :value "+" :children (js-array (operation "load-u32" (literal 8)) (literal 1)))) (local))))
           (single (await (pair (program "ab" address)))))
      (try (each (get single :runtimes) (lambda (runtime)
        (js-call assert :equal (js-call runtime :invoke "copy" 33) 0)
        (js-call assert :equal (js-call (new globalThis.DataView (get (js-call runtime :read 8 4) :buffer)) :getUint32 0 t) 1)
        (js-call assert :deepEqual (js-call runtime :read 33 4) (utf16 "ab"))
        (js-call assert :throws (lambda () (js-call runtime :invoke "copy" 65535)) WebAssembly.RuntimeError)
        (js-call assert :equal (js-call (new globalThis.DataView (get (js-call runtime :read 8 4) :buffer)) :getUint32 0 t) 2)))
        (finally (js-call (get single :n) :close))))
    (let ((grown (await (pair (program "grown" (sequence (js-array (operation "memory-grow" (literal 1)) (literal 65537))))))))
      (try (each (get grown :runtimes) (lambda (runtime) (js-call assert :equal (js-call runtime :invoke "copy" 0) 0) (js-call assert :deepEqual (js-call runtime :read 65537 10) (utf16 "grown"))))
        (finally (js-call (get grown :n) :close))))
    (let ((trapped (await (pair (program "ab" (sequence (js-array (operation "load-u8" (literal 65536)) (local))))))))
      (try (each (get trapped :runtimes) (lambda (runtime) (js-call runtime :write (Uint8Array/of 9 8 7 6) 33)
        (js-call assert :throws (lambda () (js-call runtime :invoke "copy" 33)) WebAssembly.RuntimeError)
        (js-call assert :deepEqual (js-call runtime :read 33 4) (Uint8Array/of 9 8 7 6))))
        (finally (js-call (get trapped :n) :close))))))
  (nativeTest "native empty static data validates zero-page bounds while WASM retains its declared page minimum" (async ()
    (let* ((typed (program "")) (options (js-object :initialPages 0 :maximumPages 0)) (saved (funcall globalThis.structuredClone typed)))
      (js-call assert :throws (lambda () (js-call (get backend :wasm) :emit_typed_memory_wasm typed options))
        (lambda (error) (and (= (diagnostic error) "ELI-B0001") (= (get error :message) "memory32 requires 1 <= initialPages <= maximumPages <= 65535"))))
      (js-call assert :deepEqual typed saved)
      (let* ((result (await (pair typed options (js-object :nativeOnly t)))) (n (get result :n)) (runtimes (get result :runtimes)) (debug (get result :debug)))
        (try
          (js-call assert :equal (get (js-call (get debug :ranges) :filter (lambda (range) (= (get range :kind) "static-data"))) :length) 0)
          (each runtimes (lambda (runtime) (js-call assert :equal (js-call runtime :invoke "copy" 0) 0)
            (each (js-array 1 65536 4294967295) (lambda (at) (js-call assert :throws (lambda () (js-call runtime :invoke "copy" at)) WebAssembly.RuntimeError)))))
          (finally (js-call n :close)))))))
  (nativeTest "large static sources cross ADR range through bounded read-only blocks without expanding typed IR" (async ()
    (let* ((text (str (js-call "ab\ud800\u0000\udfff\ud83d\ude80" :repeat 80000) "z"))
           (typed (program text)) (byteLength (* (get text :length) 2)) (pages (Math/ceil (/ (+ byteLength 8) 65536)))
           (copy (get (aref (get typed :functions) 0) :body)))
      (put (aref (get typed :functions) 0) :body (js-object :kind "if" :type "u32" :value nil :children (js-array
        (js-object :kind "word-compare" :type "i32" :value "/=" :children (js-array (local) (literal 0))) copy (literal 7))))
      (let* ((result (await (pair typed (js-object :initialPages pages :maximumPages pages)))) (n (get result :n)) (debug (get result :debug)))
        (try
          (let ((blocks (js-call (get debug :ranges) :filter (lambda (range) (= (get range :kind) "static-data")))))
            (assert (> (get blocks :length) 32)) (assert (js-call blocks :every (lambda (range) (<= (- (get range :end) (get range :start)) 32768))))
            (assert (< (get (get debug :codeSection) :size) (+ byteLength (* (get blocks :length) 128) 4096)))
            (js-call assert :equal (get (get copy :children) :length) 1)
            (let ((expected (utf16 text)))
              (each (get result :runtimes) (lambda (runtime)
                (js-call assert :equal (js-call runtime :invoke "copy" 0) 7) (js-call assert :equal (js-call runtime :invoke "copy" 3) 0)
                (js-call assert :deepEqual (js-call runtime :read 3 (get expected :length)) expected)
                (js-call runtime :write (Uint8Array/of 1 2 3 4) 3)
                (js-call assert :equal (js-call runtime :invoke "copy" 3) 0)
                (js-call assert :deepEqual (js-call runtime :read 3 (get expected :length)) expected)))))
          (finally (js-call n :close)))))) 30000)
)
