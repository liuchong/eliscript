(module tests.compiler-internal-string-order.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile readdir writeFile mkdir rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "./helpers/compiler-order-contract.mjs" names native-order transientSource nodes declarations units decode)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst expected (js-call names :toSorted))
  (defconst pairs (js-array (js-array "a" "A") (js-array "ä" "z") (js-array "阿" "中") (js-array "𐀀" "\uE000")))
  (defvar directory undefined) (defvar b undefined) (defvar project undefined)
  (defun reportInput ()
    (js-object :mode "standard" :root (resolve directory "report-root") :outDir (resolve directory "report-root/dist")
      :entry "src/main.eli" :entryOutput "src/main.mjs" :manifest "eliscript-project.json" :digest "supplied-identity-unchanged"
      :portableEntries (js-array) :cache (js-object :enabled false :reason "disabled")
      :timings (js-object :cacheReadMs 0 :workMs 0 :manifestWriteMs 0 :totalMs 0)
      :modules (js-call names :map (lambda (name)
        (js-object :source (str "src/" name ".eli") :output (str "src/" name ".mjs") :sourceMap (str "src/" name ".mjs.map")
          :status "compiled" :reason "source-changed" :dependencies (js-array) :portableEntries (js-array)
          :macroDependencies (js-call names :map (lambda (name) (js-object :path (str "macro/" name ".eli") :digest (js-call "a" :repeat 64)))))))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-internal-order-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq project (await (funcall load-module (get (pathToFileURL (resolve directory "bootstrap/project.mjs")) :href))))) 120000)
  (afterAll (async () (when (not (= directory undefined)) (await (rm directory (js-object :recursive t :force t))))))
  (defun moduleSources (report) (js-call (get report :modules) :map (lambda (module) (get module :source))))
  (defun first-diagnostic (compiler pair)
    (let ((error undefined))
      (try (js-call compiler :compile_ir_string (apply transientSource pair) "order.eli") (catch caught (setq error caught)))
      (let ((diagnostic (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
        (if (nullish? diagnostic) undefined (get diagnostic :message)))))
  (defun expected-diagnostic (pair) (str "transient binding " (aref (js-call pair :toSorted) 0) " cannot remain active across await"))
  (test "compiler build and check reports order every string by UTF16 code units without locale or canonical equivalence ties" (lambda ()
    (let* ((input (reportInput)) (report (js-call project :project_build_report input))
           (ordered (js-call (js-call names :map (lambda (name) (str "src/" name ".eli"))) :sort)))
      (js-call assert :deepEqual (moduleSources report) ordered)
      (js-call (get report :modules) :forEach (lambda (module)
        (js-call assert :deepEqual (js-call (get module :macroDependencies) :map (lambda (value) (get value :path)))
          (js-call (js-call names :map (lambda (name) (str "macro/" name ".eli"))) :sort))))
      (js-call assert :equal (get report :digest) "supplied-identity-unchanged")
      (funcall assert (Object/isFrozen (get report :modules))) (funcall assert (js-call (get report :modules) :every Object/isFrozen))
      (let ((check (js-call project :project_check_report (js-object :mode "standard" :root (resolve directory "report-root")
        :entries ordered :portableEntries (js-array) :modules (get (reportInput) :modules)))))
        (js-call assert :deepEqual (moduleSources check) ordered) (js-call assert :deepEqual (get check :entries) ordered))
      (js-call (js-array (js-array "é" "e\u0301") (js-array "e\u0301" "é")) :forEach (lambda (inputNames)
        (js-call assert :deepEqual (moduleSources (js-call project :project_check_report
          (js-object :mode "standard" :root (resolve directory "report-root") :entries (js-array "main.eli") :portableEntries (js-array)
            :modules (js-call inputNames :map (lambda (source) (js-object :source source :dependencies (js-array) :portableEntries (js-array))))))) (js-array "e\u0301" "é")))))))
  (test "multiple active transient resources choose the same UTF16 first diagnostic as the compiler Seed" (lambda ()
    (js-call pairs :forEach (lambda (pair) (js-call assert :equal (first-diagnostic (get b :compiler) pair) (expected-diagnostic pair))))))
  (test "the original public JS compiler reports and diagnostics do not depend on Node LANG or Bun host locale" (lambda ()
    (js-call (js-array "node" "bun") :forEach (lambda (runtime)
      (js-call (js-array "en_US.UTF-8" "sv_SE.UTF-8" "zh_CN.UTF-8") :forEach (lambda (lang)
        (let* ((child (spawnSync runtime (js-array "tests/fixtures/compiler-order-host.mjs"
            (get (pathToFileURL (resolve directory "bootstrap/compiler.mjs")) :href) (resolve directory "report-root"))
            (js-object :encoding "utf8" :env (copyHostRecord (get globalThis.process :env) (js-object :LANG lang :LC_ALL lang)) :timeout 30000)))
               (actual (JSON/parse (get child :stdout))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))
          (js-call assert :deepEqual (get actual :modules) expected (str runtime ":" lang))
          (js-call assert :equal (get (get actual :diagnostic) :message) "transient binding z cannot remain active across await"))))))))
  (test "Seed report output and transient comparison preserve full UTF16 order without changing manifest macro identity helpers or caller lists" (lambda ()
    (let* ((emacs (get (get globalThis.process :env) :EMACS))
           (child (spawnSync (if (nullish? emacs) "emacs" emacs)
             (js-array "--batch" "-Q" "-L" (resolve "compiler") "--load" (resolve "tests/fixtures/compiler-internal-order-oracle.el"))
             (js-object :encoding "utf8" :env (copyHostRecord (get globalThis.process :env)
               (js-object :ELISCRIPT_ORDER_ROOT (resolve directory "report-root")
                 :ELISCRIPT_ORDER_NAMES (JSON/stringify (js-call names :map (lambda (text) (Array/from text (lambda (point) (js-call point :codePointAt 0))))))))
               :timeout 30000)))
           (actual (JSON/parse (get child :stdout))))
      (js-call assert :equal (get child :status) 0 (get child :stderr))
      (js-call assert :deepEqual (get actual :modules) (js-call (js-call (js-call names :map (lambda (name) (str "src/" name ".eli"))) :sort) :map units))
      (js-call assert :deepEqual (get actual :macro) (js-call (js-call (js-call names :map (lambda (name) (str "macro/" name ".eli"))) :sort) :map units))
      (js-call assert :deepEqual (get actual :unchangedIdentityRecords) (js-call names :map (lambda (name) (units (str "macro/" name ".eli")))))
      (js-call assert :equal (get actual :digest) "supplied-identity-unchanged")
      (js-call assert :deepEqual (get actual :comparisons) (js-call names :map (lambda (left) (js-call names :map (lambda (right) (funcall native-order left right))))))
      (js-call assert :deepEqual (get actual :messages) (js-call pairs :map (lambda (pair) (units (expected-diagnostic pair))))))))
  (defun find-declaration (list name)
    (let ((node (js-call list :find (lambda (node) (and (= (get node :kind) "function-declaration") (= (get node :value) name))))))
      (funcall assert node name) (globalThis/structuredClone node)))
  (defun sort-call-p (node)
    (let ((key (aref (get node :children) 1))) (and (= (get node :kind) "method-call") (not (nullish? key)) (= (get key :value) "sort"))))
  (defun callbacks (projectNodes name)
    (js-call (js-call (nodes (find-declaration projectNodes name)) :filter (lambda (node)
      (let ((argument (aref (get node :children) 2)))
        (and (sort-call-p node) (not (nullish? argument)) (= (get argument :kind) "function-expression")))))
      :map (lambda (node) (globalThis/structuredClone (aref (get node :children) 2)))))
  (test "all four actual compiler sorting callbacks and private comparators execute the UTF16 policy in zero-import WASM with per-allocation GC" (async ()
    (let* ((rt (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
           (projectNodes (declarations (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/compiler/project.eli" "utf8")) "project.eli")))
           (transientNodes (declarations (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/compiler/transient-analysis.eli" "utf8")) "transient-analysis.eli")))
           (reportCallbacks (js-call (callbacks projectNodes "normalize-report-modules") :concat (callbacks projectNodes "normalize-check-modules")))
           (shell (js-call (get b :compiler) :compile_ir_string "(defun utf16-string-order (left right) 0) (defun sorted-macro (values) (js-call values :sort (lambda (left right) 0))) (defun sorted-build (values) (js-call values :sort (lambda (left right) 0))) (defun sorted-check (values) (js-call values :sort (lambda (left right) 0))) (export sorted-macro sorted-build sorted-check utf16-string-order)" "ordering-family.eli")))
      (js-call assert :equal (get reportCallbacks :length) 3)
      (let ((index 0))
        (while (< index 3)
          (let ((call (js-call (nodes (aref (get shell :body) (+ index 1))) :find sort-call-p)))
            (put (get call :children) 2 (aref reportCallbacks index)))
          (setq index (1+ index))))
      (put (get shell :body) 0 (find-declaration projectNodes "utf16-string-order"))
      (let ((active (js-call (get b :compiler) :compile_ir_string "(defun utf16-string-order (left right) 0) (defun visible-active-resources (context) nil) (defun active (names) (let* ((state (new (js* \"Map\"))) (context (js-object :state state :functionId 1))) (js-call names :forEach (lambda (name) (js-call state :set (js-object :name name :functionId 1) \"active\"))) (visible-active-resources context))) (export active utf16-string-order)" "transient-ordering-family.eli")))
        (put (get active :body) 0 (find-declaration transientNodes "utf16-string-order"))
        (put (get active :body) 1 (find-declaration transientNodes "visible-active-resources"))
        (js-call (js-array (js-array shell (js-array "sorted-macro" "sorted-build" "sorted-check")) (js-array active (js-array "active")))
          :forEach (lambda (pair)
            (let* ((program (aref pair 0)) (entries (aref pair 1))
                   (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program rt)))
                   (a (instantiateManagedRuntime bytes (js-object :maxSlots 4096 :initialBytes 262144))))
              (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
              (js-call a :auto 1)
              (let ((boxed (js-call names :map (lambda (name) (js-call a :string name)))) (i 0))
                (while (< i (get names :length))
                  (let ((j 0))
                    (while (< j (get names :length))
                      (let ((out (js-call a :invoke "utf16-string-order" (js-array (aref boxed i) (aref boxed j)))))
                        (js-call assert :equal (js-call a :readNumber out) (funcall native-order (aref names i) (aref names j)))
                        (js-call a :release out))
                      (setq j (1+ j))))
                  (setq i (1+ i)))
                (js-call entries :forEach (lambda (entry)
                  (let* ((records (if (= entry "active") boxed (js-call boxed :map (lambda (name) (js-call a :sourceObject (if (= entry "sorted-macro") (js-object :path name) (js-object :source name)))))))
                         (input (js-call a :sourceArray records)) (out (js-call a :invoke entry (js-array input))))
                    (js-call assert :deepEqual (js-call (decode a out) :map (lambda (value)
                      (if (= (funcall host-typeof value) "string") value
                        (if (= entry "active") (get value :name) (if (= entry "sorted-macro") (get value :path) (get value :source)))))) expected)
                    (js-call a :release out) (js-call a :release input)
                    (when (not (= entry "active")) (js-call records :forEach (lambda (value) (js-call a :release value)))))))
                (js-call boxed :forEach (lambda (value) (js-call a :release value))))
              (js-call a :collect) (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
              (funcall assert (> (get (js-call a :stats) :collections) 100)))))))) 30000)
  (test "public Seed and three complete frontend generations retain identical JavaScript and Source Maps after internal ordering changes" (async ()
    (let* ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (name) (js-call name :endsWith ".eli"))) :sort))
           (sources (await (Promise/all (js-call files :map (async (name) (js-array name (await (readFile (resolve "bootstrap/compiler" name) "utf8"))))))))
           (compiler (get b :compiler)) (previous undefined) (generation 1))
      (js-call assert :equal (get files :length) 13)
      (while (<= generation 3)
        (let ((output (resolve directory (str "generation-" generation))) (products (js-array)) (index 0))
          (await (mkdir output (js-object :recursive t)))
          (while (< index (get sources :length))
            (let* ((name (aref (aref sources index) 0)) (source (aref (aref sources index) 1))
                   (filename (js-call name :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                   (emitted (js-call compiler :compile_string_with_source_map source name filename name)))
              (js-call products :push (js-array name (get emitted :javascript) (get emitted :sourceMap)))
              (await (writeFile (resolve output filename) (get emitted :javascript))))
            (setq index (1+ index)))
          (when (not (= previous undefined)) (js-call assert :deepEqual products previous (str "complete generation " generation)))
          (setq previous products compiler (await (funcall load-module (get (pathToFileURL (resolve output "compiler.mjs")) :href))))
          (js-call pairs :forEach (lambda (pair) (js-call assert :equal (first-diagnostic compiler pair) (expected-diagnostic pair)))))
        (setq generation (1+ generation))))) 30000)
)
