(module tests.compiler-backend-frontend
  (import "bun:test" afterAll beforeAll spyOn test)
  (import "node:assert/strict" :default assert)
  (import "node:child_process" :as childProcess)
  (import "node:fs/promises" access mkdtemp readFile readdir rm)
  (import "node:os" tmpdir)
  (import "node:path" relative resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" backendModules buildBackends root)
  (import "../tools/backends/compiler-build.mjs" buildIndependentCompiler compilerMetadataDigest)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst constructor-bridge (js* "(fail) => function() { return fail(); }"))
  (defvar directory undefined) (defvar original undefined) (defvar compilerModules undefined) (defvar runtimeSource undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-supplied-frontend-"))))
    (setq original (await (buildBackends (js-object :outputRoot (resolve directory "original")))))
    (setq compilerModules (js-call (js-call (js-call (await (readdir (resolve root "bootstrap/compiler"))) :filter
      (lambda (name) (js-call (new globalThis.RegExp "^[a-z][a-z0-9-]*[.]eli$") :test name))) :sort) :map (lambda (name) (js-call name :slice 0 -4))))
    (setq runtimeSource (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (defun refuseSeed ()
    (js-call (spyOn childProcess "spawnSync") :mockImplementation (lambda () (throw (new globalThis.Error "a supplied frontend must not invoke any seed process")))))
  (defun expectedFiles ()
    (js-call (js-call compilerModules :map (lambda (name) (resolve root "bootstrap/compiler" (str name ".eli")))) :concat
      (js-call backendModules :map (lambda (name) (resolve root "bootstrap/backends" (str name ".eli"))))))
  (defasync executeAnswer (runtime)
    (js-call runtime :auto 1)
    (let* ((input (js-call runtime :number 41)) (held (js-call runtime :number (js* "-0"))) (frame (js-call runtime :frame 1)))
      (js-call runtime :frameSet frame 0 held)
      (try
        (let ((value (js-call runtime :invoke "answer" (js-array input))))
          (try (js-call assert :equal (js-call runtime :readNumber value) 42) (finally (js-call runtime :release value))))
        (let ((negative (js-call runtime :invoke "answer" (js-array false))))
          (try (funcall assert (Object/is (js-call runtime :readNumber negative) (js* "-0"))) (finally (js-call runtime :release negative))))
        (js-call runtime :collect) (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 1) (funcall assert (Object/is (js-call runtime :readNumber held) (js* "-0")))
        (finally
          (js-call runtime :leaveFrame frame) (js-call runtime :release input) (js-call runtime :release held)
          (js-call runtime :closeModule) (js-call runtime :collect)
          (try (js-call assert :equal (js-call runtime :live) 0) (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0)
            (finally (let ((close (get runtime :close))) (unless (nullish? close) (Reflect/apply close runtime (js-array))))))))))
  (test "a real supplied frontend emits its closed bootstrap graph and builds isolated out of tree WASM and native products without a seed" (async ()
    (let* ((source "(defvar base 1) (defun answer (value) (if value (+ value base) -0.0)) (export answer)")
           (sources (js-object :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :filename "virtual/原😀\ud800.eli" :source source))
             :literalSources (js-array) :runtime (js-object :filename "bootstrap/runtime/memory.eli" :source runtimeSource)))
           (inputDigest (compilerMetadataDigest sources)) (bootstrapIR (js-array)) (guard (refuseSeed)))
      (try
        (let ((hosts (js-array "wasm" "native")) (hostIndex 0))
          (while (< hostIndex 2)
            (let* ((host (aref hosts hostIndex)) (calls (js-array)) (outputRoot (resolve directory (str "product-" host))) (seedRoot (resolve outputRoot "seed"))
                   (frontend (copyHostRecord (get original :compiler) (js-object :compile_string_with_source_map (lambda (&rest arguments)
                     (let* ((args (Array/from arguments)) (emission (Reflect/apply (get (get original :compiler) :compile_string_with_source_map) (get original :compiler) args)))
                       (js-call calls :push (js-object :args args :emission emission)) emission)))))
                   (nativeTarget (if (= (get globalThis.process :platform) "linux") "arm64-linux" "arm64-macos"))
                   (built (await (buildIndependentCompiler (js-object :host host :frontend frontend :sources sources :nativeTarget nativeTarget :outputRoot outputRoot))))
                   (expected (expectedFiles)))
              (js-call assert :equal (get (get built :provenance) :mode) "seed") (js-call assert :equal (get built :host) host)
              (js-call assert :equal (compilerMetadataDigest sources) inputDigest "the original complete runtime and project stay unchanged")
              (js-call assert :deepEqual (js-call calls :map (lambda (call) (aref (get call :args) 1))) expected "every bootstrap dependency precedes every backend in stable order")
              (let ((index 0))
                (while (< index (js-length calls))
                  (let* ((call (aref calls index)) (args (get call :args)) (emission (get call :emission)) (bootstrap (< index (js-length compilerModules)))
                         (name (if bootstrap (aref compilerModules index) (aref backendModules (- index (js-length compilerModules)))))
                         (output (resolve seedRoot (if bootstrap "bootstrap" "backends"))))
                    (js-call assert :equal (aref args 0) (await (readFile (aref expected index) "utf8")))
                    (js-call assert :equal (aref args 2) (str name ".mjs")) (js-call assert :equal (aref args 3) (relative output (aref expected index)))
                    (js-call assert :equal (await (readFile (resolve output (str name ".mjs")) "utf8")) (str (get emission :javascript) "//# sourceMappingURL=" name ".mjs.map\n"))
                    (js-call assert :equal (await (readFile (resolve output (str name ".mjs.map")) "utf8")) (get emission :sourceMap)))
                  (setq index (1+ index))))
              (let ((ir (await (funcall load-module (get (pathToFileURL (resolve seedRoot "bootstrap/ir.mjs")) :href)))))
                (js-call bootstrapIR :push ir) (js-call assert :equal (funcall host-typeof (get ir :validate_serializable_program)) "function")
                (js-call assert :notStrictEqual ir (await (funcall load-module (get (pathToFileURL (resolve directory "original/bootstrap/ir.mjs")) :href)))))
              (js-call assert :deepEqual (new globalThis.Uint8Array (await (readFile (get built :path)))) (get built :bytes))
              (let ((budget (copyHostRecord (get built :budget) (js-object :initialPages (get (get built :memory) :initialPages) :maximumPages (get (get built :memory) :maximumPages)))))
                (if (= host "wasm")
                  (progn (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module (get built :bytes))) (js-array))
                    (await (executeAnswer (instantiateManagedRuntime (get built :bytes) budget))))
                  (when (and (= (get globalThis.process :arch) "arm64") (js-call (js-array "darwin" "linux") :includes (get globalThis.process :platform)))
                    (let ((Module (get globalThis.WebAssembly :Module)) (Instance (get globalThis.WebAssembly :Instance)) (runtime undefined))
                      (try
                        (put globalThis.WebAssembly :Module (funcall constructor-bridge (lambda () (throw (new globalThis.Error "native supplied frontend must not substitute WASM")))))
                        (put globalThis.WebAssembly :Instance (funcall constructor-bridge (lambda () (throw (new globalThis.Error "native supplied frontend must not substitute WASM")))))
                        (setq runtime (await (instantiateNativeManagedRuntime (get built :path) (get built :lowered) (copyHostRecord budget (js-object :nativeTarget nativeTarget)))))
                        (finally (put globalThis.WebAssembly :Module Module) (put globalThis.WebAssembly :Instance Instance)))
                      (await (executeAnswer runtime)))))))
            (setq hostIndex (1+ hostIndex))))
        (js-call assert :notStrictEqual (aref bootstrapIR 0) (aref bootstrapIR 1) "separate output roots own separate real dependency modules")
        (js-call assert :equal (get (get (get guard :mock) :calls) :length) 0)
        (finally (js-call guard :mockRestore))))) 120000)
  (test "supplied frontend failures preserve original thrown values and stop at the first ordered compiler or backend file" (async ()
    (let ((expected (expectedFiles)) (guard (refuseSeed)))
      (try
        (let ((failures (js-array (js-array 0 undefined) (js-array 2 false) (js-array (1+ (js-length compilerModules)) (new globalThis.Error "original compiler failure")))) (index 0))
          (while (< index (js-length failures))
            (let* ((pair (aref failures index)) (failureIndex (aref pair 0)) (failure (aref pair 1)) (calls (js-array)) (outputRoot (resolve directory (str "failure-" failureIndex)))
                   (frontend (js-object :compile_string_with_source_map (lambda (source filename)
                     (js-call calls :push filename) (when (= (1- (get calls :length)) failureIndex) (throw failure))
                     (js-object :javascript "export {};\n" :sourceMap "{\"version\":3}")))))
              (await (js-call assert :rejects (buildBackends (js-object :outputRoot outputRoot :frontend frontend)) (lambda (error) (= error failure))))
              (js-call assert :deepEqual calls (js-call expected :slice 0 (1+ failureIndex)))
              (let* ((failedPath (aref expected failureIndex)) (failedName (js-call failedPath :slice (1+ (js-call failedPath :lastIndexOf "/")) -4))
                     (failedOutput (resolve outputRoot (if (< failureIndex (js-length compilerModules)) "bootstrap" "backends") (str failedName ".mjs"))))
                (await (js-call assert :rejects (access failedOutput) (lambda (error) (= (get error :code) "ENOENT"))))))
            (setq index (1+ index))))
        (js-call assert :equal (get (get (get guard :mock) :calls) :length) 0)
        (finally (js-call guard :mockRestore))))))
)
