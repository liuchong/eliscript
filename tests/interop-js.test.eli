(module tests.interop-js
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (defconst dependencies (js-array "bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value"))
  (defasync compileFamily (command output environment)
    (await (mkdir (resolve output "interop") (js-object :recursive t)))
    (let ((index 0))
      (while (< index (js-length dependencies))
        (let ((name (aref dependencies index)))
          (await (runSuccessful (js-array command "--source-map" "--output" (resolve output (str name ".eli")) (resolve ROOT "stdlib" (str name ".eli"))) environment)))
        (setq index (1+ index))))
    (await (runSuccessful (js-array command "--source-map" "--output" (resolve output "interop/js.mjs") (resolve ROOT "stdlib/interop/js.eli")) environment)))
  (test "Eliscript JS interop preserves explicit host and persistent boundaries" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-interop-js-"))))
           (bootstrap (resolve directory "bootstrap")) (seed (resolve directory "seed")) (self (resolve directory "self-hosted")))
      (try
        (await (symlink (resolve ROOT "runtime") (resolve directory "runtime") "dir"))
        (await (compileFamily COMPILER seed (js-object))) (await (seedCompilerFixture bootstrap))
        (await (compileFamily (resolve ROOT "bin/eliscript-portable") self (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
        (let ((files (js-call (js-call dependencies :map (lambda (name) (str name ".eli"))) :concat (js-array "interop/js.mjs"))) (index 0))
          (while (< index (js-length files))
            (let* ((relative (aref files index)) (seedPath (resolve seed relative)) (selfPath (resolve self relative)))
              (be (await (readFile selfPath "utf8")) (await (readFile seedPath "utf8")))
              (be (await (readFile (str selfPath ".map") "utf8")) (await (readFile (str seedPath ".map") "utf8"))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (directories (js-array seed self)) (index 0) (fixture (resolve ROOT "tests/fixtures/interop-js-host.mjs")))
          (while (< index 2)
            (let ((modulePath (resolve (aref directories index) "interop/js.mjs")))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array "bun" "--preload" (resolve ROOT "tests/fixtures/compiled-eli-bun-preload.mjs") fixture modulePath) (js-object)))))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array (get (get globalThis.process :env) :NODE "node") "--experimental-loader" (resolve ROOT "tests/fixtures/compiled-eli-node-loader.mjs") fixture modulePath) (js-object))))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (aref reports 0) (js-object "predicates" (js-object "array" t "object" t "map" t "set" t "arrayNotObject" t "runtimeNotNative" t) "constructors" (js-object "array" (js-array 1 2 3) "map" (js-array (js-array "left" 1) (js-array "right" 2)) "set" (js-array 1 2) "objectName" "Eliscript" "safeProto" t) "crossRealm" (js-object "predicates" t "array" t "map" t "set" t "object" t) "toJs" (js-object "shallowArray" t "shallowNestedIdentity" t "deepFamilies" t "deepSharing" t "deepList" t "mapArrayKey" t "setArrays" t "hostShallowIdentity" t) "fromJs" (js-object "shallowRuntimeVector" t "shallowNestedIdentity" t "deepRuntimeVector" t "deepSharing" t "nestedFamilies" t "objectMap" t "mapMap" t "setSet" t "portableFamilies" t "portableNested" t "runtimeFamilies" t "plainObjectRules" t "inheritedOptionsIgnored" t "persistentShallowIdentity" t) "errors" (js-object "arrayCycle" (js-object "code" "ELI-INTEROP-CYCLE" "path" "$[0]" "origin" "$") "objectCycle" (js-object "code" "ELI-INTEROP-CYCLE" "path" "$[\"self\"]" "origin" "$") "accessor" (js-object "code" "ELI-INTEROP-ACCESSOR" "path" "$[\"secret\"]" "origin" nil) "symbolKey" (js-object "code" "ELI-INTEROP-INVALID-KEY" "path" "$" "origin" nil) "optionAccessor" (js-object "code" "ELI-INTEROP-ACCESSOR" "path" "$[\"deep\"]" "origin" nil) "symbolOption" (js-object "code" "ELI-INTEROP-INVALID-OPTIONS" "path" "$" "origin" nil) "duplicateMap" (js-object "code" "ELI-INTEROP-DUPLICATE" "path" "$<key:1>" "origin" nil) "duplicateSet" (js-object "code" "ELI-INTEROP-DUPLICATE" "path" "$<set:1>" "origin" nil) "depth" (js-object "code" "ELI-INTEROP-DEPTH-LIMIT" "path" "$[0][0]" "origin" nil) "values" (js-object "code" "ELI-INTEROP-VALUE-LIMIT" "path" "$[1]" "origin" nil) "opaque" (js-object "code" "ELI-INTEROP-UNSUPPORTED" "path" "$[\"value\"]" "origin" nil) "options" (js-object "code" "ELI-INTEROP-INVALID-OPTIONS" "path" "$" "origin" nil) "objectKey" (js-object "code" "ELI-INTEROP-INVALID-KEY" "path" "$<key:0>" "origin" nil)) "hostBoundary" (js-object "plainObject" t "childrenArray" t "className" "interop" "childCount" 2 "joinedChildren" "left|right") "generated" (js-object "count" 2000 "agreement" t "scaleCount" 100000 "scaleLast" 99999 "sourceUnchanged" t))))
        (let ((sourceMap (JSON/parse (await (readFile (resolve seed "interop/js.mjs.map") "utf8")))))
          (js-call (expect (get sourceMap :sourcesContent)) :toHaveLength 1)
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun to-js (")
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun from-js ("))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 120000)
)
