(module tests.compiler-session-error-transport.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/compiler-build.mjs" independentCompilerResources)
  (import "../tools/backends/compiler-session.mjs" createCompilerSession)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst native-function (js* "(implementation) => function(...args) { return implementation(...args); }"))
  ;; Small session-protocol fixture, not a replacement compiler.
  (defconst source "(defconst ArrayConstructor (js* \"Array\"))\n (defun compiler_session_new () (js-object :requests 0 :stackReads 0 :closed false))\n (defun compiler_session_close (state) (put state :closed t) nil)\n (defun compiler_session_request (state request-json)\n  (let* ((request (JSON/parse request-json)) (operation (get request :operation)))\n   (put state :requests (1+ (get state :requests)))\n   (cond\n    ((= operation \"aggregate\")\n     (let* ((diagnostic (js-object :code \"ELI-H0001\" :phase \"compiler-session\" :message \"aggregate boundary\"))\n            (child (new globalThis.TypeError \"shared child\" (js-object :cause -0.0)))\n            (inner (new globalThis.AggregateError (js-array child) \"inner\" (js-object :cause child)))\n            (failure (new globalThis.AggregateError (js-array child child inner undefined false) \"outer\" (js-object :cause child))))\n      (put child :stack \"TypeError: shared child\\n    at original.eli:3:7\")\n      (put child :eliscriptDiagnostic diagnostic) (put child :code \"ELI-H0001\")\n      (put child :diagnostics (js-array diagnostic))\n      (put child :macroOrigins (js-array (js-object :macroName \"twice\" :file \"macro.eli\")))\n      (put child :eliscriptFrames (js-array (js-object :function \"compile\" :instruction 7)))\n      (put child :eliscriptSourceFrames (js-array (js-object :file \"original.eli\" :line 3 :column 7)))\n      (when (= (get request :undefinedCause false) t) (put child :cause undefined))\n      (throw failure)))\n    ((= operation \"false\") (throw false))\n    ((= operation \"undefined\") (throw undefined))\n    ((= operation \"stack-getter\")\n     (let ((error (new globalThis.TypeError \"stack getter boundary\")))\n      (put error :stack \"\")\n      (Object/defineProperty error \"stack\" (js-object :configurable t :get (lambda ()\n       (put state :stackReads (1+ (get state :stackReads)))\n       (cond ((= (get request :mode) \"false\") (throw false))\n             ((= (get request :mode) \"undefined\") (throw undefined))\n             ((= (get request :mode) \"error\") (throw (new globalThis.RangeError \"secondary stack getter\")))\n             (t \"TypeError: supplied getter stack\")))))\n      (throw error)))\n    ((= operation \"recover\")\n     ;; Cross the unchanged session collection threshold with short-lived\n     ;; source arrays; the previous thrown graph already belongs to its caller.\n     (let ((index 0)) (while (< index 12) (new ArrayConstructor 2048) (setq index (1+ index))))\n     (JSON/stringify (js-object :ok t :value (+ (get request :value) 1))))\n    (t (JSON/stringify (js-object :requests (get state :requests) :stackReads (get state :stackReads)))))))\n (export compiler_session_new compiler_session_request compiler_session_close)")
  (defconst target (if (= (get globalThis.process :arch) "arm64")
    (if (= (get globalThis.process :platform) "darwin") "arm64-macos"
      (if (= (get globalThis.process :platform) "linux") "arm64-linux" undefined)) undefined))
  (defconst resources (independentCompilerResources))
  (defvar directory undefined) (defvar compiler undefined) (defvar wasm undefined)
  (defvar lowered undefined) (defvar library undefined) (defvar nativeDebug undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-session-error-transport-"))))
    (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
           (program (js-call (get backend :compiler) :compile_ir_string source "session-error-protocol.eli"))
           (runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
      (setq compiler (await (funcall load-module (str "data:text/javascript;base64,"
        (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program)) :toString "base64")))))
      (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime t))
      (let ((bytes (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) (get resources :memory))))
        (setq wasm (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section bytes "eliscript-managed-control" (JSON/stringify (get lowered :descriptor))))))
      (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module wasm)) (js-array))
      (when (not (= target undefined))
        (let ((artifact (js-call (get backend :native) :emit_typed_native_memory_artifact (get lowered :typed) target (js-object :format "library"))))
          (setq nativeDebug (get artifact :debug))
          (setq library (resolve directory (str "session-error-protocol." (if (= target "arm64-linux") "so" "dylib"))))
          (await (writeFile library (Uint8Array/from (get artifact :bytes)))))))) 120000)
  (afterAll (async () (when (not (= directory undefined)) (await (rm directory (js-object :recursive t :force t))))))
  (defasync open (host)
    (let ((options (copyHostRecord (get resources :budget) (js-object :auto (get resources :auto)))))
      (if (= host "wasm")
        (await (createCompilerSession (js-object :host host :bytes wasm :memory (get resources :memory) :options options)))
        (let ((Module (get globalThis.WebAssembly :Module)) (Instance (get globalThis.WebAssembly :Instance)))
          (try
            (put globalThis.WebAssembly :Module (funcall native-function (lambda () (throw (new globalThis.Error "native session constructed a WASM module")))))
            (put globalThis.WebAssembly :Instance (funcall native-function (lambda () (throw (new globalThis.Error "native session constructed a WASM instance")))))
            (await (createCompilerSession
              (js-object :host host :path library :descriptor (copyHostRecord lowered (js-object :debug nativeDebug))
                :memory (get resources :memory)
                :options (copyHostRecord options (js-object :nativeTarget target :debug nativeDebug :trapSites (get nativeDebug :trapSites))))))
            (finally (put globalThis.WebAssembly :Module Module) (put globalThis.WebAssembly :Instance Instance)))))))
  (defun caught (run)
    (let ((failed false) (failure undefined))
      (try (funcall run) (catch error (setq failed t failure error)))
      (if failed failure (js-call assert :fail "expected a source error from the real session driver"))))
  (defun compareGraph (actual expected)
    (funcall assert (funcall (js* "(a, b) => a instanceof b") actual globalThis.AggregateError) "aggregate transport must produce an Error graph, not a raw managed handle")
    (js-call assert :equal (get actual :name) (get expected :name))
    (js-call assert :equal (get actual :message) (get expected :message))
    (js-call assert :equal (get (get actual :errors) :length) 5)
    (funcall assert (funcall (js* "(a, b) => a instanceof b") (get actual :cause) globalThis.TypeError))
    (funcall assert (funcall (js* "(a, b) => a instanceof b") (aref (get actual :errors) 2) globalThis.AggregateError))
    (js-call assert :equal (get (aref (get actual :errors) 2) :message) "inner")
    (js-call assert :equal (aref (get actual :errors) 0) (get actual :cause))
    (js-call assert :equal (aref (get actual :errors) 1) (get actual :cause))
    (js-call assert :equal (get (aref (get actual :errors) 2) :cause) (get actual :cause))
    (js-call assert :equal (aref (get (aref (get actual :errors) 2) :errors) 0) (get actual :cause))
    (js-call assert :equal (aref (get actual :errors) 3) undefined)
    (js-call assert :equal (aref (get actual :errors) 4) false)
    (js-call (js-array "cause" "errors") :forEach (lambda (key)
      (let ((descriptor (Object/getOwnPropertyDescriptor actual key)) (reference (Object/getOwnPropertyDescriptor expected key)))
        (js-call assert :equal (get descriptor :writable) (get reference :writable))
        (js-call assert :equal (get descriptor :enumerable) (get reference :enumerable))
        (js-call assert :equal (get descriptor :configurable) (get reference :configurable)))))
    (js-call assert :equal (Object/hasOwn (get actual :cause) "cause") t)
    (funcall assert (Object/is (get (get actual :cause) :cause) (get (get expected :cause) :cause)))
    (js-call assert :equal (get (get actual :cause) :stack) (get (get expected :cause) :stack))
    (js-call (js-array "code" "eliscriptDiagnostic" "diagnostics" "macroOrigins" "eliscriptFrames" "eliscriptSourceFrames") :forEach
      (lambda (key) (js-call assert :deepEqual (get (get actual :cause) key) (get (get expected :cause) key) key)))
    (js-call assert :equal (aref (get (get actual :cause) :diagnostics) 0) (get (get actual :cause) :eliscriptDiagnostic)))
  (defasync withPair (host run)
    (let ((reference (await (createCompilerSession (js-object :host "javascript" :compiler compiler)))) (session undefined))
      (try (setq session (await (open host))) (await (funcall run session reference))
        (finally (try (when (and (not (= session undefined)) (not (= session nil))) (js-call session :close))
          (finally (js-call reference :close)))))
      (js-call assert :equal (get session :closed) t)
      (js-call session :close)
      (js-call assert :throws (lambda () (js-call session :request (js-object :operation "status"))) (new globalThis.RegExp "closed"))))
  (js-call (js-array "wasm" "native") :forEach (lambda (host)
    (let ((hostTest (js-call test :skipIf (and (= host "native") (= target undefined)))))
      (funcall hostTest (str host " real session transports original AggregateError graphs and primitive throws and recovers after collection")
        (lambda () (withPair host (lambda (session reference)
          (let ((retained (js-array)))
            (js-call (js-array false t false) :forEach (lambda (undefinedCause)
              (let* ((request (js-object :operation "aggregate" :undefinedCause undefinedCause))
                     (expected (caught (lambda () (js-call reference :request request))))
                     (actual (caught (lambda () (js-call session :request request))))
                     (recovery (js-object :operation "recover" :value 7)))
                (compareGraph actual expected)
                (js-call retained :push (js-array actual expected))
                (js-call assert :deepEqual (js-call session :request recovery) (js-call reference :request recovery))
                (js-call retained :forEach (lambda (pair) (compareGraph (aref pair 0) (aref pair 1)))))))
            (js-call assert :notEqual (aref (aref retained 0) 0) (aref (aref retained 2) 0))
            (js-call assert :notEqual (get (aref (aref retained 0) 0) :cause) (get (aref (aref retained 2) 0) :cause))
            (js-call (js-array (js-array "false" false) (js-array "undefined" undefined)) :forEach (lambda (pair)
              (let ((operation (aref pair 0)) (value (aref pair 1)) (recovery (js-object :operation "recover" :value 9)))
                (js-call assert :equal (caught (lambda () (js-call reference :request (js-object :operation operation)))) value)
                (js-call assert :equal (caught (lambda () (js-call session :request (js-object :operation operation)))) value)
                (js-call assert :deepEqual (js-call session :request recovery) (js-call reference :request recovery)))))
            (js-call assert :deepEqual (js-call session :request (js-object :operation "status")) (js-call reference :request (js-object :operation "status"))))))) 30000)
      (funcall hostTest (str host " real session observes represented stack getters without replacing the first source throw on getter failure")
        (lambda () (withPair host (lambda (session reference)
          (let* ((request (js-object :operation "stack-getter" :mode "text"))
                 (expected (caught (lambda () (js-call reference :request request))))
                 (actual (caught (lambda () (js-call session :request request)))))
            (funcall assert (funcall (js* "(a, b) => a instanceof b") expected globalThis.TypeError))
            (funcall assert (funcall (js* "(a, b) => a instanceof b") actual globalThis.TypeError))
            (js-call assert :equal (get actual :message) (get expected :message))
            (js-call assert :equal (get actual :stack) (get expected :stack))
            (js-call assert :deepEqual (js-call session :request (js-object :operation "status")) (js-call reference :request (js-object :operation "status")))
            (js-call (js-array "false" "undefined" "error") :forEach (lambda (mode)
              (let* ((expected (caught (lambda () (js-call reference :request (js-object :operation "stack-getter" :mode mode)))))
                     (secondary (caught (lambda () (get expected :stack)))))
                (if (= mode "error")
                  (progn (funcall assert (funcall (js* "(a, b) => a instanceof b") secondary globalThis.RangeError)) (js-call assert :equal (get secondary :message) "secondary stack getter"))
                  (js-call assert :equal secondary (if (= mode "false") false undefined)))
                (let ((actual (caught (lambda () (js-call session :request (js-object :operation "stack-getter" :mode mode))))))
                  ;; Do not reread a failed source stack getter.
                  (funcall assert (and (not (= actual nil)) (= (funcall host-typeof actual) "object")))
                  (when (not (= (get actual :kind) 13))
                    (js-call assert :equal (get actual :name) "TypeError")
                    (js-call assert :equal (get actual :message) (get expected :message)))
                  (js-call assert :deepEqual (js-call session :request (js-object :operation "status")) (js-call reference :request (js-object :operation "status")))
                  (let ((recovery (js-object :operation "recover" :value 11)))
                    (js-call assert :deepEqual (js-call session :request recovery) (js-call reference :request recovery))))))))))) 30000))))
)
