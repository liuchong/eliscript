(module
  tests.dogfood-workflow-test-ground
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:path" resolve)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    PROJECT
    (resolve ROOT "examples/dogfood"))
  (defconst
    TEMPLATE
    (resolve PROJECT "templates/workflows/dogfood.yml"))
  (defconst
    CONFIG
    (resolve PROJECT "dogfood.config.eli"))
  (defconst
    state
    (js-object :template nil :packaged nil :staging nil))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (beforeAll (async () (put state :template (await (readFile TEMPLATE "utf8"))) (put state :staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-workflow-")))) (let*
        ((result (await (run (js-array "bun" "run" "package:dogfood")))))
        (when
          (not= (get result :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get result :stderr) :trim) (js-call (get result :stdout) :trim)))))
        (put state :packaged (await (readFile (resolve PROJECT "dist/action/workflow.yml") "utf8"))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "the template checks out the consumer repository and invokes the action" (lambda () (let*
        ((packaged (get state :packaged)))
        (js-call (expect packaged) :toMatch (new globalThis.RegExp "uses: actions/checkout@[0-9a-f]{40}\\n" "u"))
        (js-call (expect packaged) :toMatch (new globalThis.RegExp "uses: liuchong/eliscript/examples/dogfood@[0-9a-f]{40}\\n" "u")))))
  (test "the shipped copy pins the action to a real commit digest" (lambda () (js-call (get (expect (get state :packaged)) :not) :toContain "PLACEHOLDER") (js-call (expect (get state :template)) :toContain "PLACEHOLDER_ACTION_DIGEST")))
  (test "uploads are skipped when the build produced nothing" (lambda () (let*
        ((packaged (get state :packaged)))
        (js-call (expect packaged) :toContain "if: steps.build.outputs.built == 'true'")
        (js-call (expect packaged) :toContain "needs.build.outputs.built == 'true'"))))
  (test "the artifact upload and the deployment use separate jobs" (lambda () (let*
        ((packaged (get state :packaged)) (jobs (js-call packaged :slice (js-call packaged :indexOf "\njobs:"))) (deployAt (js-call jobs :indexOf "\n  deploy:")) (buildAt (js-call jobs :indexOf "\n  build:")))
        (js-call (expect packaged) :toContain "uses: actions/upload-pages-artifact@")
        (js-call (expect packaged) :toContain "uses: actions/deploy-pages@")
        (js-call (expect buildAt) :toBeGreaterThan -1)
        (js-call (expect deployAt) :toBeGreaterThan buildAt)
        (js-call (expect (js-call jobs :slice deployAt)) :toContain "name: github-pages")
        (js-call (get (expect (js-call jobs :slice buildAt deployAt)) :not) :toContain "name: github-pages"))))
  (test "permissions are the documented minimum" (lambda () (let*
        ((packaged (get state :packaged)) (permissions (js-call packaged :slice (js-call packaged :indexOf "\npermissions:") (js-call packaged :indexOf "\nconcurrency:"))) (granted-list (js-array "contents: read" "issues: read" "discussions: read" "pages: write" "id-token: write")) (idx (js-object :i 0)))
        (while
          (< (get idx :i) (get granted-list :length))
          (js-call (expect permissions) :toContain (aref granted-list (get idx :i)))
          (put idx :i (+ (get idx :i) 1)))
        (js-call (get (expect permissions) :not) :toContain "write-all")
        (js-call (get (expect permissions) :not) :toContain "contents: write"))))
  (test "a build may be cancelled but a deployment may not" (lambda () (let*
        ((packaged (get state :packaged)) (buildGroup (new globalThis.RegExp "^      group: dogfood-build-\\$\\{\\{ github\\.ref \\}\\}\\n      cancel-in-progress: true$" "mu")) (deployGroup (new globalThis.RegExp "^      group: dogfood-pages\\n      cancel-in-progress: false$" "mu")))
        (js-call (expect packaged) :toMatch buildGroup)
        (js-call (expect packaged) :toMatch deployGroup)
        (js-call (expect (get (or (js-call packaged :match (new globalThis.RegExp "^      group: " "gmu")) (js-array)) :length)) :toBe 2)
        (js-call (expect (get (or (js-call packaged :match (new globalThis.RegExp "^    environment:" "gmu")) (js-array)) :length)) :toBe 1)
        (js-call (expect (get (or (js-call packaged :match (new globalThis.RegExp "^      name: github-pages$" "gmu")) (js-array)) :length)) :toBe 1))))
  (test "each job holds only the permissions it needs" (lambda () (let*
        ((packaged (get state :packaged)) (workflow (js-call packaged :slice (js-call packaged :indexOf "\njobs:"))) (build (js-call workflow :slice (js-call workflow :indexOf "\n  build:") (js-call workflow :indexOf "\n  deploy:"))) (deploy (js-call workflow :slice (js-call workflow :indexOf "\n  deploy:"))))
        (js-call (expect build) :toContain "contents: read")
        (js-call (expect build) :toContain "issues: read")
        (js-call (expect build) :toContain "discussions: read")
        (js-call (get (expect build) :not) :toContain "pages: write")
        (js-call (get (expect build) :not) :toContain "id-token: write")
        (js-call (expect deploy) :toContain "pages: write")
        (js-call (expect deploy) :toContain "id-token: write")
        (js-call (get (expect deploy) :not) :toContain "discussions: read"))))
  (test "the jobs are bounded and the checkout is shallow" (lambda () (let*
        ((packaged (get state :packaged)) (cache (js-call packaged :slice (js-call packaged :indexOf "- id: restore") (js-call packaged :indexOf "- id: build"))) (upload (js-call packaged :slice (js-call packaged :indexOf "upload-pages-artifact"))))
        (js-call (expect packaged) :toMatch (new globalThis.RegExp "timeout-minutes: \\d+" "u"))
        (js-call (expect (get (or (js-call packaged :match (new globalThis.RegExp "timeout-minutes: " "gu")) (js-array)) :length)) :toBe 2)
        (js-call (expect packaged) :toContain "fetch-depth: 1")
        (js-call (expect cache) :toContain "path: _site/_dogfood")
        (js-call (get (expect cache) :not) :toMatch (new globalThis.RegExp "path: _site$" "mu"))
        (js-call (expect upload) :toMatch (new globalThis.RegExp "path: _site$" "mu")))))
  (test "a dispatch can ask for a rebuild" (lambda () (let*
        ((packaged (get state :packaged)))
        (js-call (expect packaged) :toContain "force:")
        (js-call (expect packaged) :toContain "type: boolean")
        (js-call (expect packaged) :toContain "force: ${{ inputs.force || 'false' }}"))))
  (test "creation events are not in the default template" (lambda () (let*
        ((packaged (get state :packaged)) (triggers (js-call packaged :slice 0 (js-call packaged :indexOf "\npermissions:"))) (issueTypes (js-call (new globalThis.RegExp "^  issues:\\n    types: \\[([^\\]]+)\\]$" "mu") :exec triggers)) (discussionTypes (js-call (new globalThis.RegExp "^  discussion:\\n    types: \\[([^\\]]+)\\]$" "mu") :exec triggers)) (__ign_19 (js-call (get (expect issueTypes) :not) :toBeNull)) (__ign_20 (js-call (get (expect discussionTypes) :not) :toBeNull)) (issueList (js-call (js-call (aref issueTypes 1) :split ",") :map (lambda (tp) (js-call tp :trim)))) (discussionList (js-call (js-call (aref discussionTypes 1) :split ",") :map (lambda (tp) (js-call tp :trim)))))
        (js-call (get (expect issueList) :not) :toContain "opened")
        (js-call (get (expect discussionList) :not) :toContain "created")
        (js-call (expect triggers) :toContain "issues.opened")
        (js-call (expect triggers) :toContain "the schedule above picks it up")
        (let*
          ((expected-issues (js-array "labeled" "unlabeled" "edited" "closed" "reopened" "transferred")) (iidx (js-object :i 0)))
          (while
            (< (get iidx :i) (get expected-issues :length))
            (js-call (expect issueList) :toContain (aref expected-issues (get iidx :i)))
            (put iidx :i (+ (get iidx :i) 1))))
        (let*
          ((expected-disc (js-array "edited" "labeled" "unlabeled" "closed" "reopened" "answered" "unanswered")) (didx (js-object :j 0)))
          (while
            (< (get didx :j) (get expected-disc :length))
            (js-call (expect discussionList) :toContain (aref expected-disc (get didx :j)))
            (put didx :j (+ (get didx :j) 1)))))))
  (test "the default template never triggers per comment" (lambda () (let*
        ((packaged (get state :packaged)) (triggers (js-call packaged :slice 0 (js-call packaged :indexOf "\npermissions:"))))
        (js-call (get (expect triggers) :not) :toContain "issue_comment:")
        (js-call (get (expect triggers) :not) :toContain "discussion_comment:")
        (js-call (expect triggers) :toContain "no issue_comment or discussion_comment trigger"))))
  (test "the schedule is a real cron and matches any configured snapshot schedule" (async () (let*
        ((packaged (get state :packaged)) (template (get state :template)) (cron (js-call packaged :match (new globalThis.RegExp "^    - cron: \"([^\"]+)\"$" "mu"))))
        (js-call (get (expect cron) :not) :toBeNull)
        (js-call (expect (get (js-call (aref cron 1) :split " ") :length)) :toBe 5)
        (js-call (expect template) :toContain "must match `refresh.snapshot-schedule`")
        (let*
          ((config (await (readFile CONFIG "utf8"))) (configured (js-call config :match (new globalThis.RegExp ":snapshot-schedule \"([^\"]+)\"" "u"))))
          (if
            configured
            (js-call (expect packaged) :toContain (str "cron: \"" (aref configured 1) "\""))
            (js-call (expect config) :toContain ":comments :runtime")))))))
