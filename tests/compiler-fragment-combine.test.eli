(module tests.compiler-fragment-combine.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "./helpers/fragment-combine-contract.mjs" check)
  (import "./helpers/managed-browser-transport.mjs" writeManagedReference)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar directory undefined) (defvar compiler undefined) (defvar emitterModule undefined)
  (defvar source undefined) (defvar code undefined) (defvar m undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-fragment-combine-"))))
    (let* ((out (resolve directory "compiler"))
           (child (spawnSync (resolve "bin/eliscript-bootstrap") (js-array) (js-object :encoding "utf8" :timeout 30000
             :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR out))))))
      (js-call assert :equal (get child :status) 0 (get child :stderr))
      (setq compiler (await (funcall load-module (get (pathToFileURL (resolve out "compiler.mjs")) :href))))
      (setq emitterModule (await (funcall load-module (get (pathToFileURL (resolve out "emitter.mjs")) :href)))))
    (let ((emitter (await (readFile "bootstrap/compiler/emitter.eli" "utf8"))))
      (setq source (str "(module fragment.combine\n(defvar function-source-profile false)\n"
        (js-call (js-call (js-array "make-fragment" "text-fragment" "as-fragment" "combine") :map (lambda (name) (definition emitter name))) :join "\n")
        "\n(export combine))")))
    (setq code (js-call compiler :compile_string source "fragment-combine.eli"))
    (setq m (await (funcall load-module (get (pathToFileURL
      (await (writeManagedReference directory code "fragment-reference"))) :href))))) 30000)
  (afterAll (async () (await (rm directory (js-object :recursive t :force t)))))
  (test "fragment text, UTF16 offsets, mark identities, getters, mutations, exceptions and random cases retain the original algorithm" (lambda () (check m)))
  (test "public Seed preserves the extracted helper and independent Node and Bun execute its exact oracle"
    (async ()
      (let ((input (resolve directory "combine.eli")) (output (resolve directory "combine.mjs")))
        (await (writeFile input source))
        (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get seed :status) 0 (get seed :stderr)))
        (js-call assert :equal (await (readFile output "utf8")) (js-call compiler :compile_string source input))
        (js-call (js-array "node" "bun") :forEach (lambda (host)
          (let ((child (spawnSync host (js-array "tests/fixtures/compiler-fragment-host.mjs" (get (pathToFileURL output) :href)) (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get child :status) 0 (str host ": " (get child :stderr)))))))))
  (test "function text capture preserves exact Node source and ordinary Source Map marks after success and failure"
    (lambda ()
      (let* ((input "; 中😀\n(defun outer (x) (lambda (y) (+ x y))) (export outer)")
             (program (js-call compiler :compile_ir_string input "function-text.eli"))
             (original (js-call emitterModule :emit_module_artifact program))
             (mapped (js-call emitterModule :emit_module_with_source_map program input "function-text.mjs" "function-text.eli"))
             (captured (js-call emitterModule :emit_module_function_sources program))
             (pending (js-call (get program :body) :slice)) (functions (new globalThis.Set)))
        (funcall assert (> (get (get original :marks) :length) 0) "ordinary emission retains its complete source locations")
        (js-call assert :equal (get captured :javascript) (get original :text))
        (js-call assert :equal (get (get captured :functions) :length) 2)
        (while (> (get pending :length) 0)
          (let ((node (js-call pending :pop)))
            (when (js-call (js-array "function-declaration" "function-expression") :includes (get node :kind)) (js-call functions :add node))
            (Reflect/apply (get pending :push) pending (get node :children))))
        (js-call (get captured :functions) :forEach (lambda (record)
          (funcall assert (js-call functions :has (get record :node)))
          (js-call assert :equal (get record :sourceText) (js-call (get captured :javascript) :slice (get record :start) (get record :end)))))
        (let ((node (spawnSync "node" (js-array "tests/fixtures/compiler-function-source-host.mjs")
                      (js-object :input (get captured :javascript) :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get node :error) undefined)
          (js-call assert :equal (get node :status) 0 (get node :stderr))
          (js-call assert :deepEqual (js-call (js-call (get captured :functions) :map (lambda (record) (get record :sourceText))) :sort)
            (js-call (JSON/parse (get node :stdout)) :sort)))
        (js-call assert :deepEqual (js-call emitterModule :emit_module_artifact program) original)
        (js-call assert :deepEqual (js-call emitterModule :emit_module_with_source_map program input "function-text.mjs" "function-text.eli") mapped)
        (let ((invalid (globalThis/structuredClone program)))
          (put (aref (get invalid :body) 0) :kind "unsupported-function-source-node")
          (js-call assert :throws (lambda () (js-call emitterModule :emit_module_function_sources invalid))))
        (js-call assert :deepEqual (js-call emitterModule :emit_module_artifact program) original "failed capture restores ordinary location collection")
        (js-call assert :deepEqual (js-call emitterModule :emit_module_with_source_map program input "function-text.mjs" "function-text.eli") mapped))))
)
