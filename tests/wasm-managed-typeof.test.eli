(module tests.wasm-managed-typeof.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:child_process" spawnSync)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst uint32 (js* "(v) => v >>> 0"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar program nil)
  (defvar javascript nil)
  (defvar js nil)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-typeof-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string
                    (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                    "runtime.eli"))
    (setq program (js-call (get b :compiler) :compile_ir_string
                    (await (readFile "tests/fixtures/wasm-managed-typeof.eli" "utf8"))
                    "typeof.eli"))
    (setq javascript (js-call (get b :compiler) :emit_ir_string program))
    (setq js (await (funcall dynamic-import
                      (str "data:text/javascript;base64,"
                           (js-call (Buffer/from javascript) :toString "base64"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun artifact (&rest __host_default_arguments_1)
    (let* ((p (aref __host_default_arguments_1 0)) (rt (aref __host_default_arguments_1 1)))
    (let* ((prog (if (undefined? p) program p))
           (rt-ir (if (undefined? rt) runtime rt))
           (before (JSON/stringify prog))
           (out (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm prog rt-ir))))
      (js-call assert :equal (JSON/stringify prog) before)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module out)) (js-array))
      out)))

  (defun box (a v)
    (let ((ty (funcall js-typeof v)))
      (cond
        ((= ty "number") (js-call a :number v))
        ((= ty "string") (js-call a :string v))
        (t v))))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((values (aref __host_default_arguments_2 0)))
    (let ((items (if (undefined? values) (js-array) values)))
      (js-call items :forEach (lambda (v) (js-call a :release v))))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (test "independent Node confirms existing typeof primitive distinctions, captured lexical bindings and member failures" (async ()
    (let ((file (resolve directory "source.mjs")))
      (await (writeFile file javascript))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-typeof-node.mjs")
                               "js"
                               (get (pathToFileURL file) :href))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "typeof values and member paths execute in owned WASM without coercing objects or conflating null and undefined" (lambda ()
    (let ((a (instantiateManagedRuntime (artifact)))
          (owned (js-array)))
      (js-call a :auto 1)
      (js-call
        (js-array undefined nil false t 0 -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE globalThis.Number.MAX_VALUE "" "中😀\ud800")
        :forEach
        (lambda (x)
          (let* ((v (box a x))
                 (object (js-call a :invoke "make-box" (js-array v)))
                 (child (js-call a :invoke "make-child" (js-array object)))
                 (expected (funcall js-typeof x)))
            (js-call owned :push v object child)
            (js-call
              (js-array
                (js-array "type-value" v expected)
                (js-array "type-underscore" v expected)
                (js-array "type-member" object expected)
                (js-array "type-deep" child expected)
                (js-array "type-shadow" v "boolean"))
              :forEach
              (lambda (triple)
                (let ((out (js-call a :invoke (aref triple 0) (js-array (aref triple 1)))))
                  (js-call owned :push out)
                  (js-call assert :equal (js-call a :readString out) (aref triple 2)))))
            (let ((closure (js-call a :invoke "capture" (js-array v))))
              (js-call owned :push closure)
              (js-call a :collect)
              (let ((out (js-call a :invoke "invoke" (js-array closure))))
                (js-call owned :push out)
                (js-call assert :equal (js-call a :readString out) expected)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
            (when (not (nullish? x))
              (let ((member (js-call a :invoke "type-member" (js-array v))))
                (js-call owned :push member)
                (js-call assert :equal (js-call a :readString member) (funcall js-typeof (get x :item))))))))
      (let ((object (js-call a :sourceObject (js-object)))
            (array (js-call a :sourceArray (js-array)))
            (fn (js-call a :getExport "type-value")))
        (js-call owned :push object array fn)
        (js-call
          (js-array (js-array object "object") (js-array array "object") (js-array fn "function"))
          :forEach
          (lambda (pair)
            (let ((out (js-call a :invoke "type-value" (js-array (aref pair 0)))))
              (js-call owned :push out)
              (js-call assert :equal (js-call a :readString out) (aref pair 1)))))
        (let ((missing (js-call a :invoke "type-member" (js-array object))))
          (js-call owned :push missing)
          (js-call assert :equal (js-call a :readString missing) "undefined"))
        (js-call
          (js-array (js-array "type-member" nil) (js-array "type-member" undefined) (js-array "type-deep" object))
          :forEach
          (lambda (pair)
            (js-call assert :throws
              (lambda () (js-call a :invoke (aref pair 0) (js-array (aref pair 1))))
              (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0003")))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
        (finish a owned)))))

  (test "typeof lexical and imported module bindings survive project renaming and writes without changing canonical IR" (lambda ()
    (let* ((entry (js-call (get b :compiler) :compile_ir_string
                    "(module entry (import \"./typeof.mjs\" type-value type-global write-global) (defun imported-type () (js* \"typeof type_value\")) (export type-value type-global write-global imported-type))"
                    "entry.eli"))
           (modules (js-array (js-object :id "typeof.mjs" :program program) (js-object :id "entry.mjs" :program entry)))
           (before (JSON/stringify modules))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "entry.mjs" runtime))))
      (js-call assert :equal (JSON/stringify modules) before)
      (let ((a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let* ((first (js-call a :invoke "type_global"))
               (imported (js-call a :invoke "imported_type"))
               (owned (js-array first imported)))
          (js-call assert :equal (js-call a :readString first) "object")
          (js-call assert :equal (js-call a :readString imported) "function")
          (js-call (js-array undefined nil false -0.0 globalThis.NaN "中😀\ud800") :forEach
            (lambda (x)
              (let* ((v (box a x))
                     (out (js-call a :invoke "write_global" (js-array v)))
                     (rd (js-call a :invoke "type_global"))
                     (expected (funcall js-typeof x)))
                (js-call owned :push v out rd)
                (js-call assert :equal (js-call a :readString out) expected)
                (js-call assert :equal (js-call a :readString rd) expected))))
          (finish a owned))))))

  (test "type queries never stringify objects and random IEEE values retain their original bits through collecting GC" (lambda ()
    (let* ((p (js-call (get b :compiler) :compile_ir_string
                "(defconst marker 1) (defun f (value) (js* \"typeof value\")) (defun factory (trace) (js-object :toString (lambda () (put trace :called t) \"wrong\") :valueOf (lambda () (put trace :called t) 7))) (export f factory)"
                "type-hooks.eli"))
           (a (instantiateManagedRuntime (artifact p))))
      (js-call a :auto 1)
      (let* ((trace (js-call a :sourceObject (js-object)))
             (object (js-call a :invoke "factory" (js-array trace)))
             (label (js-call a :invoke "f" (js-array object)))
             (key (js-call a :string "called")))
        (js-call assert :equal (js-call a :readString label) "object")
        (js-call assert :equal (js-call a :objectGet trace key) undefined)
        (let* ((data (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
               (state 693068247)
               (next (lambda ()
                       (setq state (funcall uint32 (+ (Math/imul state 1664525) 1013904223)))
                       state))
               (i 0))
          (while (< i 1024)
            (js-call data :setUint32 0 (funcall next))
            (js-call data :setUint32 4 (funcall next))
            (let* ((x (js-call data :getFloat64 0))
                   (input (js-call a :number x))
                   (out (js-call a :invoke "f" (js-array input))))
              (js-call assert :equal (js-call a :readString out) "number")
              (funcall assert (Object/is (js-call a :readNumber input) x))
              (js-call a :release input)
              (js-call a :release out))
            (setq i (1+ i))))
        (finish a (js-array trace object label key))))))

  (test "unrepresented globals unsupported expressions and malformed typeof IR remain exact source-bound refusals even in dead code" (lambda ()
    (js-call (js-array "typeof unknown" "typeof value()" "typeof (value)" "typeof value[key]") :forEach
      (lambda (expression)
        (let* ((p (js-call (get b :compiler) :compile_ir_string
                    (str ";中😀\n(defun f (value) (if nil (js* " (JSON/stringify expression) ") 1)) (export f)")
                    "type-refusal.eli"))
               (before (JSON/stringify p)))
          (js-call assert :throws
            (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
            (lambda (e)
              (let ((d (get e :eliscriptDiagnostic)))
                (and d
                     (= (get d :code) "ELI-B0001")
                     (= (get (get d :location) :file) "type-refusal.eli")
                     (= (get (get (get d :location) :start) :line) 2)))))
          (js-call assert :equal (JSON/stringify p) before))))
    (js-call
      (js-array
        (lambda (n) (js-call (get n :children) :push (aref (get n :children) 0)))
        (lambda (n) (put (aref (get n :children) 0) :value nil))
        (lambda (n) (js-call (get (aref (get n :children) 0) :children) :push (js-object :kind "literal" :value 7 :children (js-array)))))
      :forEach
      (lambda (change)
        (let ((p (js-call (get b :compiler) :compile_ir_string "(defun f (value) (js* \"typeof value\")) (export f)" "malformed-type.eli"))
              (raw nil))
          (let ((walk nil))
            (setq walk (lambda (n)
                         (when (and (not (nullish? n)) (= (funcall js-typeof n) "object"))
                           (when (= (get n :kind) "raw-javascript")
                             (setq raw n))
                           (js-call (Object/values n) :forEach walk))))
            (funcall walk p))
          (funcall assert raw)
          (funcall change raw)
          (let ((before (JSON/stringify p)))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
              (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-B0001")))))
            (js-call assert :equal (JSON/stringify p) before)))))))

  (test "unimplemented primitive prototype values are refused rather than mislabeled as undefined" (lambda ()
    (js-call
      (js-array
        (js-array "toString" (js-array t 1 "x"))
        (js-array "toFixed" (js-array 1))
        (js-array "toExponential" (js-array 1))
        (js-array "toPrecision" (js-array 1))
        (js-array "split" (js-array "x"))
        (js-array "toUpperCase" (js-array "x")))
      :forEach
      (lambda (pair)
        (let* ((key (aref pair 0))
               (values (aref pair 1))
               (p (js-call (get b :compiler) :compile_ir_string
                    (str "(defconst marker 1) (defun f (value) (js* \"typeof value." key "\")) (export f)")
                    "type-prototype.eli"))
               (a (instantiateManagedRuntime (artifact p))))
          (js-call a :auto 1)
          (js-call values :forEach
            (lambda (x)
              (let ((v (box a x)))
                (js-call assert :throws
                  (lambda () (js-call a :invoke "f" (js-array v)))
                  (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0003")))))
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                (js-call a :release v))))
          (finish a))))))

  (test "type allocation and real WASM traps preserve outer roots and earlier member lookup errors" (async ()
    (let* ((src (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call src :indexOf "  (defun value-source-typeof "))
           (end (js-call src :indexOf "  (defun " (+ start 3))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((rt (js-call (get b :compiler) :compile_ir_string
                   (str (js-call src :slice 0 start)
                        "  (defun value-source-typeof (heap value) (load-u32 4294967295))\n"
                        (js-call src :slice end))
                   "type-trap.eli"))
             (a (instantiateManagedRuntime (artifact program rt))))
        (js-call a :auto 1)
        (let ((held (js-call a :number -0.0))
              (outer (js-call a :frame 1)))
          (js-call a :frameSet outer 0 held)
          (js-call assert :throws
            (lambda () (js-call a :invoke "type-member" (js-array nil)))
            (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0003")))))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :throws
            (lambda () (js-call a :invoke "type-value" (js-array held)))
            globalThis.WebAssembly.RuntimeError)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (funcall assert (Object/is (js-call a :readNumber held) -0.0))
          (js-call a :leaveFrame outer)
          (finish a (js-array held))))
      (let ((small (instantiateManagedRuntime (artifact) (js-object :maxSlots 64 :initialBytes 8192 :maxBytes 8192))))
        (js-call small :auto 1)
        (let ((retained (js-call small :number -0.0))
              (frame (js-call small :frame 1))
              (keep (js-array))
              (i 0)
              (exhausted false))
          (js-call small :frameSet frame 0 retained)
          (while (and (< i 128) (not exhausted))
            (try
              (js-call keep :push (js-call small :number i))
              (catch err
                (js-call assert :equal (let ((d (get err :eliscriptDiagnostic))) (and d (get d :code))) "ELI-RT0002")
                (setq exhausted t)))
            (setq i (1+ i)))
          (js-call assert :throws
            (lambda () (js-call small :invoke "type-value" (js-array retained)))
            (lambda (e) (let ((d (get e :eliscriptDiagnostic))) (and d (= (get d :code) "ELI-RT0002")))))
          (js-call assert :equal (get (js-call small :stats) :frameDepth) 1)
          (funcall assert (Object/is (js-call small :readNumber retained) -0.0))
          (js-call keep :forEach (lambda (v) (js-call small :release v)))
          (js-call small :collect)
          (let ((out (js-call small :invoke "type-value" (js-array retained))))
            (js-call assert :equal (js-call small :readString out) "number")
            (js-call small :leaveFrame frame)
            (finish small (js-array retained out))))))))

  (test "Node executes identical zero-import typeof bytes with captured functions members and module state" (async ()
    (let ((file (resolve directory "typeof.wasm")))
      (await (writeFile file (artifact)))
      (let ((child (spawnSync "node"
                     (js-array (resolve "tests/helpers/wasm-managed-typeof-node.mjs")
                               "wasm"
                               (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                               file)
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))

  (test "existing nil undefined and nullish predicates preserve distinct meanings and evaluate operands once" (async ()
    (let* ((src "(defconst marker 1) (defun is-nil (value) (nil? value)) (defun is-undefined (value) (undefined? value)) (defun is-null (value) (null value)) (defun is-nullish (value) (nullish? value)) (defun once (value trace) (null (progn (put trace :calls (1+ (get trace :calls 0))) value))) (export is-nil is-undefined is-null is-nullish once)")
           (p (js-call (get b :compiler) :compile_ir_string src "null-predicates.eli"))
           (ref (await (funcall dynamic-import
                         (str "data:text/javascript;base64,"
                              (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64")))))
           (a (instantiateManagedRuntime (artifact p))))
      (js-call a :auto 1)
      (js-call
        (js-array undefined nil false t -0.0 globalThis.NaN globalThis.Infinity globalThis.Number.MIN_VALUE "" "中😀\ud800")
        :forEach
        (lambda (x)
          (let ((v (box a x)))
            (js-call (js-array "is-nil" "is-undefined" "is-null" "is-nullish") :forEach
              (lambda (name)
                (js-call assert :equal (js-call a :invoke name (js-array v)) (js-call ref (js-call name :replaceAll "-" "_") x))))
            (let ((trace (js-call a :sourceObject (js-object))))
              (js-call assert :equal (js-call a :invoke "once" (js-array v trace)) (js-call ref :once x (js-object)))
              (let* ((key (js-call a :string "calls"))
                     (calls (js-call a :objectGet trace key)))
                (js-call assert :equal (js-call a :readNumber calls) 1)
                (js-call (js-array v trace key calls) :forEach (lambda (item) (js-call a :release item)))
                (js-call a :collect)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))
      (let ((object (js-call a :sourceObject (js-object)))
            (array (js-call a :sourceArray (js-array)))
            (fn (js-call a :getExport "is-null")))
        (js-call (js-array object array fn) :forEach
          (lambda (v)
            (js-call (js-array "is-nil" "is-undefined" "is-null" "is-nullish") :forEach
              (lambda (name)
                (js-call assert :equal (js-call a :invoke name (js-array v)) false)))))
        (finish a (js-array object array fn)))))

  (test "null predicate arity and malformed operands are diagnosed before lowering children with immutable source locations" (lambda ()
    (js-call (js-array "nil?" "undefined?" "null" "nullish?") :forEach
      (lambda (name)
        (js-call
          (js-array
            (lambda (n) (put n :children (js-array)))
            (lambda (n) (js-call (get n :children) :push (aref (get n :children) 0)))
            (lambda (n) (put n :children (js-array nil))))
          :forEach
          (lambda (change)
            (let ((p (js-call (get b :compiler) :compile_ir_string
                       (str ";中😀\n(defun f (value) (" name " value)) (export f)")
                       "null-shape.eli"))
                  (predicate nil))
              (let ((walk nil))
                (setq walk (lambda (n)
                             (when (and (not (nullish? n)) (= (funcall js-typeof n) "object"))
                               (when (and (= (get n :kind) "intrinsic") (= (get n :value) name))
                                 (setq predicate n))
                               (js-call (Object/values n) :forEach walk))))
                (funcall walk p))
              (funcall assert predicate)
              (let ((span (get predicate :span)))
                (funcall change predicate)
                (let ((before (JSON/stringify p)))
                  (js-call assert :throws
                    (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
                    (lambda (e)
                      (let ((d (get e :eliscriptDiagnostic)))
                        (and d
                             (= (get d :code) "ELI-B0001")
                             (= (get (get d :location) :file) "null-shape.eli")
                             (= (get (get (get d :location) :start) :line) (get span :line))
                             (= (get (get (get d :location) :start) :column) (get span :column))))))
                  (js-call assert :equal (JSON/stringify p) before))))))))))))
