(module tests.transducer.test
  (import "bun:test" expect test)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/collection.mjs" IConj IEmptyable IReduce count isReduced isReductionView nth reduce reduced sequenceView unreduced)
  (import "../runtime/core/transducer.mjs"
    catting completing composeTransducers deduping distincting droppingWhile eduction filtering interposing into keeping
    keepingIndexed mapcatting mapping mappingIndexed partitioningAll partitioningBy runBang taking takingNth takingWhile transduce)
  (import "../runtime/core/sequence.mjs" range take)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/vector.mjs" EMPTY_VECTOR isPersistentVector persistentVector)
  (import "../runtime/core/protocol.mjs" extendProtocolType)
  (import "../runtime/testing/vector.mjs" persistentVectorMetrics resetPersistentVectorMetrics)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (import "./helpers/generator-step.mjs" generator fromValues)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun rejects (operation &rest __host_default_arguments_1)
    (let* ((message (aref __host_default_arguments_1 0)))
    (if (= message undefined) (js-call (expect operation) :toThrow) (js-call (expect operation) :toThrow message))))
  (defun append (values value) (js-call values :concat (js-array value)))
  (defun appendGroup (values value) (append values (Array/from value)))
  (defun sum (result value) (+ result value))
  (defun numbers (size onPull &rest __host_forwarded_arguments_1)
    (let* ((transform (aref __host_forwarded_arguments_1 0)) (onClose (aref __host_forwarded_arguments_1 1)))
    (sequenceView (lambda () (let ((value 0))
      (generator (lambda ()
        (if (>= value size) (js-object :value undefined :done t)
          (let ((out value)) (setq value (1+ value)) (funcall onPull)
            (js-object :value (if (= transform undefined) out (funcall transform out)) :done false)))) onClose))) size)))
  (defun items (values onPull) (sequenceView (lambda () (fromValues values onPull)) (get values :length)))
  (defasync runHost (command fixture)
    (let* ((child (Bun/spawn (js-array command fixture) (js-object :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (unless (= exitCode 0) (let ((message (js-call stderr :trim))) (throw (new globalThis.Error (if (= message "") (str command " exited with " exitCode) message)))))
      (JSON/parse stdout)))
  (test "completing separates reduction steps from one exact completion" (lambda ()
    (let* ((completions 0) (reducer (completing sum (lambda (result) (setq completions (1+ completions)) (Object/freeze (js-object :result result))))))
      (be (Object/isFrozen reducer) t) (be (funcall reducer 2 3) 5) (same (funcall reducer 5) (js-object :result 5)) (be completions 1)
      (rejects (lambda () (funcall reducer)) "reducing functions accept one completion argument or two step arguments")
      (rejects (lambda () (funcall reducer 1 2 3)) "reducing functions accept one completion argument or two step arguments"))))
  (test "mapping and filtering compose in declared left-to-right order" (lambda ()
    (let* ((trace (js-array)) (transducer (composeTransducers
      (mapping (lambda (value) (js-call trace :push (str "map:" value)) (1+ value)))
      (filtering (lambda (value) (js-call trace :push (str "filter:" value)) (= (% value 2) 0)))
      (mapping (lambda (value) (* value 10))))))
      (be (Object/isFrozen transducer) t)
      (same (transduce transducer append (js-array) (js-array 1 2 3)) (js-array 20 40))
      (same trace (js-array "map:1" "filter:2" "map:2" "filter:3" "map:3" "filter:4"))
      (be (transduce (composeTransducers) (lambda (result value) (str result value)) "" (js-array 1 2 3)) "123"))))
  (test "eduction composes replayable reduction pipelines over unbounded sources" (lambda ()
    (let* ((mappings 0) (predicates 0) (pipeline (eduction
      (mapping (lambda (value) (setq mappings (1+ mappings)) (1+ value)))
      (filtering (lambda (value) (setq predicates (1+ predicates)) (= (% value 2) 0))) (range))))
      (be (isReductionView pipeline) t) (be (Object/isFrozen pipeline) t)
      (same (Array/from (take 5 pipeline)) (js-array 2 4 6 8 10)) (same (js-array mappings predicates) (js-array 10 10))
      (same (Array/from (take 5 pipeline)) (js-array 2 4 6 8 10)) (same (js-array mappings predicates) (js-array 20 20))
      (rejects (lambda () (count pipeline)))
      (let ((doubled (eduction (mapping (lambda (value) (* value 2))) (js-array 1 2 3))))
        (be (reduce doubled sum) 12) (be (reduce doubled sum 10) 22))
      (rejects (lambda () (reduce (eduction (filtering (lambda () false)) (js-array 1 2 3)) sum)) "cannot reduce an empty eduction without an initial value")
      (let* ((zeroInputPulls 0) (zeroInput (items (js-array 1) (lambda (value) (setq zeroInputPulls (1+ zeroInputPulls))))))
        (be (reduce (eduction (taking 0) zeroInput) sum 7) 7) (be zeroInputPulls 0))
      (let ((partitioned (into EMPTY_VECTOR (eduction (partitioningAll 2) (js-array 1 2 3)))))
        (same (js-call (Array/from partitioned) :map (lambda (part) (Array/from part))) (js-array (js-array 1 2) (js-array 3))))
      (let ((scaled (take 100000 (eduction (mapping (lambda (value) (1+ value))) (range)))))
        (be (count scaled) 100000) (be (funcall nth scaled 0) 1) (be (funcall nth scaled 99999) 100000)))))
  (test "run! consumes reduction views for ordered side effects" (lambda ()
    (let* ((visited (js-array)) (source (eduction (mapping (lambda (value) (* value 3))) (js-array 1 2 3))))
      (js-call (expect (runBang (lambda (value) (js-call visited :push value)) source)) :toBeNull)
      (same visited (js-array 3 6 9))
      (rejects (lambda () (runBang nil source)) "run! procedure must be a function")
      (rejects (lambda () (runBang (lambda () nil))) "run! requires a procedure and collection")
      (rejects (lambda () (eduction source)) "eduction requires one or more transducers and a collection"))))
  (test "taking terminates exactly and allocates fresh state for every run" (lambda ()
    (let* ((pulls 0) (closes 0)
           (source (numbers 10 (lambda () (setq pulls (1+ pulls))) undefined (lambda () (setq closes (1+ closes)))))
           (firstThree (taking 3)))
      (same (transduce firstThree append (js-array) source) (js-array 0 1 2)) (be pulls 3) (be closes 1)
      (same (transduce firstThree append (js-array) source) (js-array 0 1 2)) (be pulls 6) (be closes 2)
      (let* ((zeroPulls 0) (untouched (items (js-array "unreachable") (lambda (value) (setq zeroPulls (1+ zeroPulls)))))
             (zeroCompletions 0) (zeroReducer (completing append (lambda (values) (setq zeroCompletions (1+ zeroCompletions)) values))))
        (same (transduce (taking 0) zeroReducer (js-array) untouched) (js-array)) (be zeroPulls 0) (be zeroCompletions 1)))))
  (test "stateful transforms allocate fresh indexed keep and prefix state per run" (lambda ()
    (let* ((indexed (mappingIndexed (lambda (index value) (str index ":" value))))
           (kept (keeping (lambda (value) (cond ((= value 1) nil) ((= value 2) false) ((= value 3) undefined) (t (* value 10)))))))
      (same (transduce indexed append (js-array) (js-array "a" "b")) (js-array "0:a" "1:b"))
      (same (transduce indexed append (js-array) (js-array "c")) (js-array "0:c"))
      (same (transduce kept append (js-array) (js-array 1 2 3 4)) (js-array false undefined 40)))
    (let* ((takePulls 0) (takePredicates 0) (takeCloses 0)
           (source (numbers 10 (lambda () (setq takePulls (1+ takePulls))) undefined (lambda () (setq takeCloses (1+ takeCloses)))))
           (prefix (takingWhile (lambda (value) (setq takePredicates (1+ takePredicates)) (< value 3)))))
      (same (transduce prefix append (js-array) source) (js-array 0 1 2))
      (same (js-array takePulls takePredicates takeCloses) (js-array 4 4 1))
      (same (transduce prefix append (js-array) (js-array 0 1 4)) (js-array 0 1)))
    (let* ((dropPredicates 0) (suffix (droppingWhile (lambda (value) (setq dropPredicates (1+ dropPredicates)) (< value 3)))))
      (same (transduce suffix append (js-array) (js-array 0 1 3 2 4)) (js-array 3 2 4)) (be dropPredicates 3)
      (same (transduce suffix append (js-array) (js-array 1 5)) (js-array 5)))))
  (test "deduping uses Eliscript value equality and preserves separated repeats" (lambda ()
    (let ((left (persistentVector 1 2)) (equal (persistentVector 1 2)) (different (persistentVector 2 1)) (transducer (deduping)))
      (same (transduce transducer append (js-array) (js-array undefined undefined left equal different left)) (js-array undefined left different left))
      (same (transduce transducer append (js-array) (js-array 1 1 2)) (js-array 1 2)))))
  (test "distincting removes global duplicates with fresh value-semantic state" (lambda ()
    (let ((left (persistentVector 1 2)) (equal (persistentVector 1 2)) (different (persistentVector 2 1)) (transducer (distincting)))
      (same (transduce transducer append (js-array) (js-array undefined left 1 equal undefined different 1 left)) (js-array undefined left 1 different))
      (same (transduce transducer append (js-array) (js-array 1 1 2)) (js-array 1 2)))))
  (test "indexed keep nth and interpose allocate fresh bounded state per run" (lambda ()
    (let ((indexed (keepingIndexed (lambda (index value) (if (= value "skip") nil (str index ":" value))))) (everyThird (takingNth 3)))
      (same (transduce indexed append (js-array) (js-array "left" "skip" "right")) (js-array "0:left" "2:right"))
      (same (transduce indexed append (js-array) (js-array "again")) (js-array "0:again"))
      (same (transduce everyThird append (js-array) (js-array 0 1 2 3 4 5 6)) (js-array 0 3 6))
      (same (transduce everyThird append (js-array) (js-array 7 8)) (js-array 7)))
    (let* ((pulls 0) (source (items (js-array 1 2 3) (lambda (value) (setq pulls (1+ pulls))))))
      (same (transduce (composeTransducers (interposing "separator") (taking 2)) append (js-array) source) (js-array 1 "separator"))
      (be pulls 2)
      (same (transduce (interposing "separator") append (js-array) (js-array "only")) (js-array "only")))))
  (test "partitioning transducers emit persistent groups and flush completion once" (lambda ()
    (let* ((fixed (partitioningAll 3)) (partitions (transduce fixed append (js-array) (js-array 1 2 3 4 5 6 7 8))))
      (be (js-call partitions :every isPersistentVector) t)
      (same (js-call partitions :map (lambda (partition) (Array/from partition))) (js-array (js-array 1 2 3) (js-array 4 5 6) (js-array 7 8)))
      (same (transduce fixed appendGroup (js-array) (js-array 9 10)) (js-array (js-array 9 10))))
    (same (transduce (partitioningBy (lambda (value) (persistentVector (% value 2)))) appendGroup (js-array) (js-array 1 3 2 4 5 7))
      (js-array (js-array 1 3) (js-array 2 4) (js-array 5 7)))
    (let* ((groupedPulls 0) (groupedSource (items (js-array 1 3 2 4) (lambda (value) (setq groupedPulls (1+ groupedPulls)))))
           (completions 0) (firstGroupReducer (completing appendGroup (lambda (values) (setq completions (1+ completions)) values))))
      (same (transduce (composeTransducers (partitioningBy (lambda (value) (% value 2))) (taking 1)) firstGroupReducer (js-array) groupedSource) (js-array (js-array 1 3)))
      (same (js-array groupedPulls completions) (js-array 3 1)))
    (let* ((pulls 0) (source (numbers 100 (lambda () (setq pulls (1+ pulls))))))
      (same (transduce (composeTransducers (partitioningAll 4) (taking 1)) appendGroup (js-array) source) (js-array (js-array 0 1 2 3)))
      (be pulls 4))))
  (test "catting and mapcatting flatten reducible values and propagate termination" (lambda ()
    (same (transduce (catting) append (js-array) (js-array (js-array 1 2) (persistentVector 3 4))) (js-array 1 2 3 4))
    (let* ((outerPulls 0) (outer (items (js-array 1 2 3) (lambda (value) (setq outerPulls (1+ outerPulls))))))
      (same (transduce (composeTransducers (mapcatting (lambda (value) (persistentVector value (* value 10)))) (taking 3)) append (js-array) outer) (js-array 1 10 2))
      (be outerPulls 2))))
  (test "transduce preserves reduced termination and completion semantics" (lambda ()
    (let* ((completions 0)
           (reducer (completing (lambda (result value) (if (> value 5) (reduced (copyHostRecord result (js-object :stoppedAt value)))
             (copyHostRecord result (js-object :values (append (get result :values) value))))) (lambda (result) (setq completions (1+ completions)) (Object/freeze (copyHostRecord result (js-object :complete t)))))))
      (same (transduce (mapping (lambda (value) (* value 2))) reducer (js-object :values (js-array)) (js-array 1 2 3))
        (js-object :values (js-array 2 4) :stoppedAt 6 :complete t))
      (be completions 1))))
  (test "custom transducers can use completing and preserve downstream completion" (lambda ()
    (let* ((duplicating (lambda (downstream) (completing (lambda (result value) (let ((first (funcall downstream result value))) (if (isReduced first) first (funcall downstream first value)))) (lambda (result) (funcall downstream result)))))
           (reducer (completing append (lambda (values) (Object/freeze (js-object :values values :completed t))))))
      (same (transduce (composeTransducers (mapping (lambda (value) (1+ value))) duplicating) reducer (js-array) (js-array 1 2))
        (js-object :values (js-array 2 2 3 3) :completed t)))))
  (test "into constructs every supported target through collection protocols" (lambda ()
    (let ((vector (persistentVector "old")) (map (persistentHashMap (js-array "old" 0))) (set (persistentHashSet "old"))
          (array (js-array "old")) (nativeMap (new globalThis.Map (js-array (js-array "old" 0)))) (nativeSet (new globalThis.Set (js-array "old"))))
      (same (Array/from (into vector (js-array 1 2 3))) (js-array 1 2 3)) (same (Array/from vector) (js-array "old"))
      (same (new globalThis.Map (js-call (into map (js-array (js-array "left" 1) (js-array "right" 2))) :entries)) (new globalThis.Map (js-array (js-array "left" 1) (js-array "right" 2))))
      (same (Array/from map) (js-array (js-array "old" 0)))
      (same (js-call (into set (js-array 1 2 2)) :toSet) (new globalThis.Set (js-array 1 2))) (same (Array/from set) (js-array "old"))
      (same (into array (mapping (lambda (value) (* value 2))) (js-array 1 2 3)) (js-array 2 4 6)) (same array (js-array "old"))
      (same (into nativeMap (js-array (js-array "answer" 42))) (new globalThis.Map (js-array (js-array "answer" 42))))
      (same nativeMap (new globalThis.Map (js-array (js-array "old" 0))))
      (same (into nativeSet (js-array 1 1 2)) (new globalThis.Set (js-array 1 2))) (same nativeSet (new globalThis.Set (js-array "old"))))))
  (test "into supports external immutable source and target capabilities" (lambda ()
    (let* ((Range (funcall (js* "(initialize) => class Range { constructor(start, end) { initialize(this, start, end); } }")
                   (lambda (this start end) (put this :start start) (put this :end end) (Object/freeze this))))
           (Bag (funcall (js* "(initialize) => class Bag { constructor(values = []) { initialize(this, values); } }")
                   (lambda (this values) (put this :values (Object/freeze values)) (Object/freeze this)))))
      (extendProtocolType IReduce Range (js-object :reduce (lambda (range reducer initial)
        (let ((result initial) (value (get range :start)) (done false))
          (while (and (not done) (< value (get range :end)))
            (setq result (funcall reducer result value))
            (when (isReduced result) (setq result (unreduced result) done t))
            (setq value (1+ value))) result))))
      (extendProtocolType IEmptyable Bag (js-object :empty (lambda () (new Bag))))
      (extendProtocolType IConj Bag (js-object :conj (lambda (bag value) (new Bag (append (get bag :values) value)))))
      (let* ((target (new Bag (js-array 99))) (result (into target (composeTransducers (mapping (lambda (value) (* value 3))) (taking 4)) (new Range 1 100))))
        (same (get result :values) (js-array 3 6 9 12)) (same (get target :values) (js-array 99))))))
  (test "transducer boundaries reject malformed operations before traversal" (lambda ()
    (let* ((traversals 0) (source (sequenceView (lambda () (setq traversals (1+ traversals)) (let ((values (js-array 1 2))) (Reflect/apply (get values (get globalThis.Symbol :iterator)) values (js-array)))) 2)))
      (rejects (lambda () (completing nil)) "reducing step must be a function")
      (rejects (lambda () (completing (lambda () nil) nil)) "reducing completion must be a function")
      (rejects (lambda () (mapping nil)) "mapping transform must be a function")
      (rejects (lambda () (mappingIndexed nil)) "mapping-indexed transform must be a function")
      (rejects (lambda () (keeping nil)) "keeping transform must be a function")
      (rejects (lambda () (keepingIndexed nil)) "keeping-indexed transform must be a function")
      (rejects (lambda () (mapcatting nil)) "mapcatting transform must be a function")
      (rejects (lambda () (filtering nil)) "filtering predicate must be a function")
      (rejects (lambda () (takingWhile nil)) "taking-while predicate must be a function")
      (rejects (lambda () (droppingWhile nil)) "dropping-while predicate must be a function")
      (rejects (lambda () (takingNth 0)) "taking-nth interval must be a positive safe integer")
      (rejects (lambda () (partitioningAll -1)) "partitioning-all size must be a positive safe integer")
      (rejects (lambda () (partitioningBy nil)) "partitioning-by classifier must be a function")
      (rejects (lambda () (taking -1)) "taking limit must be a non-negative safe integer")
      (rejects (lambda () (taking 1.5)) "taking limit must be a non-negative safe integer")
      (rejects (lambda () (composeTransducers nil)) "composed transducer must be a function")
      (rejects (lambda () (transduce (lambda () nil) (lambda () nil) 0 source)) "transducer result must be a function")
      (rejects (lambda () (transduce (mapping (lambda (value) value)) (lambda () nil) 0)) "transduce requires a transducer, reducer, initial value, and collection")
      (rejects (lambda () (into (js-array) (mapping (lambda (value) value)) source "extra")) "into requires a target and source, or a target, transducer, and source")
      (be traversals 0))))
  (test "transducers agree under Bun and Node and stay single-pass at scale" (async ()
    (let* ((fixture (fileURLToPath (new globalThis.URL "./fixtures/transducer-host.mjs" (js* "import.meta.url"))))
           (bun (await (runHost (get globalThis.process :execPath) fixture))) (node (await (runHost "node" fixture))))
      (same bun node) (same bun (js-object "pipeline" (js-array 6 12 18) "sum" 36 "entries" (js-array (js-array "key-1" 10) (js-array "key-2" 20)) "eduction" (js-array 6 8) "visits" (js-array 6 8) "reused" (js-array (js-array 1 2) (js-array 1 2)) "stateful" (js-array "2:left" "3:right") "distinct" (js-array 1 2 3) "sampled" (js-array "0:left" "3:right") "interposed" (js-array "left" "between" "right") "partitions" (js-array (js-array 1 3) (js-array 2 4) (js-array 5)) "flattened" (js-array 1 10 2) "concatenated" (js-array "left" "right"))))
    (let* ((pulls 0) (mappings 0) (predicates 0) (million (numbers 1000000 (lambda () (setq pulls (1+ pulls))))))
      (resetPersistentVectorMetrics)
      (let ((total (transduce (composeTransducers (mapping (lambda (value) (setq mappings (1+ mappings)) (1+ value)))
          (filtering (lambda (value) (setq predicates (1+ predicates)) (= (% value 2) 0)))) sum 0 million)))
        (be total 250000500000))
      (same (js-array pulls mappings predicates) (js-array 1000000 1000000 1000000))
      (same (persistentVectorMetrics) (js-object :nodeAllocations 0 :nodeVisits 0 :tailAllocations 0 :rootGrowths 0))
      (let* ((distinctPulls 0) (repeated (numbers 100000 (lambda () (setq distinctPulls (1+ distinctPulls))) (lambda (value) (% value 10000)))))
        (be (transduce (distincting) (lambda (result) (1+ result)) 0 repeated) 10000) (be distinctPulls 100000))
      (let* ((partitionPulls 0) (partitionSource (numbers 1000000 (lambda () (setq partitionPulls (1+ partitionPulls)))))
             (millionPartition (transduce (partitioningAll 1000000) (lambda (result partition) partition) nil partitionSource)))
        (be partitionPulls 1000000) (be (count millionPartition) 1000000)
        (be (funcall nth millionPartition 0) 0) (be (funcall nth millionPartition 999999) 999999))
      (let ((bounded (into EMPTY_VECTOR (composeTransducers (filtering (lambda (value) (= (% value 2) 0))) (taking 1000)) million)))
        (be (count bounded) 1000) (be (js-call (Array/from bounded) :at -1) 1998)))) 30000)
)
