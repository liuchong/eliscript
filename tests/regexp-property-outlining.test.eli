(module tests.regexp-property-outlining.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst originalSHA256 "d3e11e410bbb87a5e5f3c0979aaf776e4fdd39d42c2c615c34511c7d60f562b6")
  (defconst rootName "regexp-property-id-base")
  (defconst prefix (str rootName "-part-"))
  (defvar directory undefined)
  (defvar backend undefined)
  (defvar definitions undefined)
  (defvar reconstructed undefined)
  (defvar outlined undefined)
  (defvar originalJS undefined)
  (defvar splitJS undefined)
  (defvar sourceIR undefined)
  (defvar names undefined)
  (defvar packedSource undefined)
  (defun normalize (source)
    (js-call (js-call source :replace (new globalThis.RegExp "\\s+" "g") " ") :trim))
  (defun parse (source)
    (let ((stack (js-array)) (result undefined)
          (tokens (js-call source :match (new globalThis.RegExp "\\(|\\)|[^\\s()]+" "g"))) (index 0))
      (while (< index (get tokens :length))
        (let ((token (aref tokens index)))
          (cond
            ((= token "(")
             (let ((value (js-array)))
               (when (> (get stack :length) 0) (js-call (js-call stack :at -1) :push value))
               (js-call stack :push value)))
            ((= token ")") (setq result (js-call stack :pop)))
            (t (js-call (js-call stack :at -1) :push token))))
        (setq index (1+ index)))
      (js-call assert :equal (get stack :length) 0)
      result))
  (defun inline (source &rest __host_default_arguments_1)
    (let* ((active (aref __host_default_arguments_1 0)))
    (let ((active (if (= active undefined) (new globalThis.Set) active)))
      (js-call source :replace
        (new globalThis.RegExp "\\((regexp-property-id-base-part-\\d{4}) (source start length(?: unit)?)\\)" "g")
        (lambda (unused name args)
          (funcall assert (not (js-call active :has name)) "private partitions must not introduce recursion")
          (let* ((text (js-call definitions :get name))
                 (match (js-call (new globalThis.RegExp "^\\(defun [^\\s]+ \\(([^)]*)\\) ([\\s\\S]*)\\)$") :exec text))
                 (next (new globalThis.Set active)))
            (funcall assert text "every private call resolves to its actual definition")
            (funcall assert match)
            (js-call assert :equal args (aref match 1) "the original lexical inputs are forwarded without evaluation changes")
            (js-call next :add name)
            (inline (aref match 2) next)))))))
  (defun supportedNames (tree)
    (let ((result (new globalThis.Map)))
      (letfn ((visit (value unit characters)
        (if (not (Array/isArray value))
            (when (and (js-call (new globalThis.RegExp "^\\d+$") :test value)
                       (> (funcall globalThis.Number value) 0))
              (funcall assert (and (> (get characters :length) 0)
                                  (js-call characters :every Number/isInteger)))
              (let ((name (apply String/fromCharCode characters))
                    (id (funcall globalThis.Number value)))
                (if (js-call result :has name)
                    (js-call assert :equal (js-call result :get name) id)
                  (js-call result :set name id))))
          (if (= (aref value 0) "let")
              (let* ((binding (aref (aref value 1) 0))
                     (offset (aref (aref binding 1) 2)))
                (js-call assert :equal (aref binding 0) "unit")
                (js-call assert :deepEqual (js-call (aref binding 1) :slice 0 2) (js-array "string-code-unit-at" "source"))
                (js-call assert :deepEqual (js-call offset :slice 0 2) (js-array "+" "start"))
                (visit (aref value 2) (funcall globalThis.Number (aref offset 2)) characters))
            (let ((condition (aref value 1)) (yes characters))
              (js-call assert :equal (aref value 0) "if")
              (when (and (= (aref condition 0) "=") (= (aref condition 1) "unit"))
                (setq yes (js-call characters :slice))
                (put yes unit (funcall globalThis.Number (aref condition 2))))
              (visit (aref value 2) unit yes)
              (visit (aref value 3) unit characters))))))
        (visit (aref tree 3) nil (js-array)))
      result))
  (defun observations (action)
    (try (js-object :ok t :value (funcall action))
      (catch error (js-object :ok false :name (get error :name) :message (get error :message)))))
  (defun irNodes (node)
    (let ((count 0) (pending (js-array node)))
      (while (> (get pending :length) 0)
        (let ((value (js-call pending :pop)) (index 0))
          (setq count (1+ count))
          (while (< index (get (get value :children) :length))
            (js-call pending :push (aref (get value :children) index))
            (setq index (1+ index)))))
      count))
  (defasync load-javascript (code)
    (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from code) :toString "base64")))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-regexp-outline-"))))
    (let* ((originalSource (await (readFile "tests/fixtures/regexp-property-original-trie.eli" "utf8")))
           (matches (Array/from (js-call originalSource :matchAll (new globalThis.RegExp "\\(defun (regexp-property-id-base(?:-part-\\d{4})?) " "g"))))
           (index 0))
      (setq definitions (new globalThis.Map))
      (while (< index (get matches :length))
        (let ((name (aref (aref matches index) 1)))
          (funcall assert (not (js-call definitions :has name)))
          (js-call definitions :set name (definition originalSource (str name " "))))
        (setq index (1+ index))))
    (setq reconstructed (inline (js-call definitions :get rootName)))
    (setq names (supportedNames (parse reconstructed)))
    (let* ((source (await (readFile "bootstrap/backends/regexp.eli" "utf8")))
           (start (js-call source :indexOf ";; BEGIN GENERATED UNICODE PROPERTY ALIASES"))
           (end (js-call source :indexOf ";; END GENERATED UNICODE PROPERTY ALIASES" start)))
      (funcall assert (and (>= start 0) (> end start)))
      (setq packedSource (js-call source :slice start end)))
    (setq outlined (str "(module regexp.outline\n" packedSource "\n(export " rootName "))"))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq sourceIR (js-call (get backend :compiler) :compile_ir_string outlined "regexp-outline.eli"))
    (setq splitJS (await (load-javascript (js-call (get backend :compiler) :emit_ir_string sourceIR))))
    (setq originalJS (await (load-javascript
      (js-call (get backend :compiler) :compile_string
        (str "(module regexp.original " reconstructed " (export " rootName "))") "regexp-original.eli"))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "packed property aliases retain the frozen complete original trie inventory while production lookup is bounded data code"
    (lambda ()
      (js-call assert :equal (js-call (js-call (createHash "sha256") :update (normalize reconstructed)) :digest "hex") originalSHA256)
      (js-call assert :equal (get definitions :size) 69)
      (js-call assert :equal (> (get names :size) 100) t)
      (let ((texts (Array/from (js-call definitions :values))) (index 0))
        (while (< index (get texts :length))
          (funcall assert (<= (get (aref texts index) :length) 30000) "each generated function has a bounded source body")
          (setq index (1+ index))))
      (let* ((body (get sourceIR :body))
             (root (if (= (get (aref body 0) :kind) "module-declaration") (get (aref body 0) :children) body))
             (target (js-call root :find (lambda (node) (and (= (get node :kind) "function-declaration") (= (get node :value) rootName)))))
             (originalIR (js-call (get backend :compiler) :compile_ir_string (str "(module regexp.original " reconstructed ")") "regexp-original.eli"))
             (originalBody (get originalIR :body))
             (originalRoot (if (= (get (aref originalBody 0) :kind) "module-declaration") (get (aref originalBody 0) :children) originalBody)))
        (funcall assert target)
        (funcall assert (< (irNodes target) 1000) "production lookup must not restore the original giant alias decision tree")
        (funcall assert (> (irNodes (js-call originalRoot :find (lambda (node) (and (= (get node :kind) "function-declaration") (= (get node :value) rootName))))) 1000))
        (js-call assert :equal (aref (parse (js-call definitions :get rootName)) 1) rootName))))
  (test "actual split and original JS retain every supported property alias plus case offsets trailing UTF16 and source read failures"
    (lambda ()
      (let ((actual (get splitJS :regexp_property_id_base)) (original (get originalJS :regexp_property_id_base))
            (all (Array/from (js-call names :keys))) (index 0))
        (while (< index (get all :length))
          (let* ((name (aref all index))
                 (texts (js-array name (js-call name :toLowerCase) (js-call name :toUpperCase)
                   (str name "x") (js-call name :slice 0 -1) (str "\ud800" name) (str name "\udfff")))
                 (j 0))
            (while (< j (get texts :length))
              (let ((text (aref texts j)))
                (js-call assert :deepEqual
                  (observations (lambda () (funcall actual text 0 (get text :length))))
                  (observations (lambda () (funcall original text 0 (get text :length)))) text))
              (setq j (1+ j)))
            (js-call assert :equal (funcall actual (str "!" name "?") 1 (get name :length))
              (funcall original (str "!" name "?") 1 (get name :length)) (str name " at offset"))
            (js-call assert :equal (funcall actual (str "😀" name) 2 (get name :length))
              (funcall original (str "😀" name) 2 (get name :length)) (str name " after a surrogate pair")))
          (setq index (1+ index)))
        (let ((sources (js-array "" nil undefined 17 false (js-object) "\0" "\ud800" "\udfff" "😀"))
              (ranges (js-array (js-array 0 0) (js-array 0 1) (js-array -1 3) (js-array 1 2)
                 (js-array globalThis.NaN 2) (js-array 0 globalThis.NaN) (js-array 0 -1) (js-array 0 globalThis.Infinity)))
              (i 0))
          (while (< i (get sources :length))
            (let ((source (aref sources i)) (j 0))
              (while (< j (get ranges :length))
                (let ((start (aref (aref ranges j) 0)) (length (aref (aref ranges j) 1)))
                  (js-call assert :deepEqual (observations (lambda () (funcall actual source start length)))
                    (observations (lambda () (funcall original source start length)))))
                (setq j (1+ j))))
            (setq i (1+ i))))
        (js-call assert :deepEqual (observe-source-reads actual) (observe-source-reads original)))))
  (defun observe-source-reads (fn)
    (let* ((reads (js-array)) (marker (new globalThis.Error "original source read"))
           (source (js-object :charCodeAt (lambda (index)
             (js-call reads :push index)
             (when (= (get reads :length) 3) (throw marker))
             (js-call "ASCII" :charCodeAt index))))
           (caught undefined))
      (try (funcall fn source 0 5) (catch error (setq caught error)))
      (js-object :reads reads :caught (if (= caught undefined) undefined
        (if (= caught marker) "same original error" (get caught :name))))))
  (test "real complete-runtime managed WASM keeps outlined locals bounded and executes the property trie without imports under the original small compiler budget"
    (async ()
      (let* ((runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
             (lowered (js-call (get backend :managed) :lower_managed_program sourceIR runtime))
             (owned (js-call (get (get lowered :typed) :functions) :filter
                (lambda (fn) (js-call (get fn :name) :startsWith "__eliscript_managed_"))))
             (helpers (Array/from (js-call packedSource :matchAll (new globalThis.RegExp "\\(defun " "g"))))
             (index 0))
        (funcall assert (>= (get owned :length) (get helpers :length)) "all actual lookup helpers are lowered rather than replaced with a host import")
        (while (< index (get owned :length))
          (let ((fn (aref owned index)))
            (funcall assert (<= (get (get fn :locals) :length) 20000) (str (get fn :name) " exceeds the outlined function local budget")))
          (setq index (1+ index)))
        (let* ((bytes (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section
                   (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) (js-object :initialPages 128 :maximumPages 1024))
                   "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
               (module (new globalThis.WebAssembly.Module bytes))
               (path (resolve directory "property-outlined.wasm")))
          (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports module) (js-array))
          (await (writeFile path bytes))
          (let ((node (spawnSync "node" (js-array "tests/fixtures/regexp-property-wasm-host.mjs" path)
                         (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get node :error) undefined)
            (js-call assert :equal (get node :signal) nil)
            (js-call assert :equal (get node :status) 0 (get node :stderr)))
          (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 131072 :initialBytes 8388608 :maxBytes 67108864))))
            (js-call a :auto 65536)
            (try
              (let* ((all (Array/from (js-call names :keys)))
                     (step (Math/max 1 (Math/floor (/ (get all :length) 64))))
                     (cases (js-call (js-call all :filter (lambda (unused index) (= (% index step) 0)))
                               :concat (js-array "" "unknown" "ascii" "ASCIIx" "\ud800" "😀")))
                     (index 0))
                (while (< index (get cases :length))
                  (let* ((name (aref cases index)) (text (js-call a :string name))
                         (start (js-call a :number 0)) (length (js-call a :number (get name :length)))
                         (result undefined))
                    (try
                      (setq result (js-call a :invoke rootName (js-array text start length)))
                      (js-call assert :equal (js-call a :readNumber result)
                         (js-call originalJS :regexp_property_id_base name 0 (get name :length)) name)
                      (finally
                        (when (not (= result undefined)) (js-call a :release result))
                        (js-call a :release text) (js-call a :release start) (js-call a :release length))))
                  (setq index (1+ index))))
              (finally (js-call a :closeModule) (js-call a :collect)
                (js-call assert :equal (js-call a :live) 0)
                (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))))) 120000)
)
