(module tests.stdlib-math-bit
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp rm symlink)
  (import "node:path" resolve)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "../runtime/core/collection.mjs" count)
  (import "../runtime/core/vector.mjs" EMPTY_VECTOR persistentVector)

  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst EMACS (let ((v (get (get process :env) :EMACS))) (if (nullish? v) "emacs" v)))
  (defconst dynamic-import (js* "(url) => import(url)"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))
  (defun close-to (a b) (js-call (expect a) :toBeCloseTo b 10))

  (defasync compile-stdlib (modules)
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-s3-math-bit-"))))
           (out-root (resolve directory "stdlib")))
      (try
        (await (symlink (resolve ROOT "runtime") (resolve directory "runtime") "dir"))
        (let* ((cmd (js-call (js-array (resolve ROOT "bin/eliscript-build") "--json" "--root" (resolve ROOT "stdlib") "--out-dir" out-root "--no-cache")
                      :concat (js-call modules :map (lambda (m) (resolve ROOT (str "stdlib/" m ".eli"))))))
               (child (Bun/spawn cmd (js-object :cwd ROOT :env (Object/assign (js-object) (get process :env) (js-object :EMACS EMACS)) :stdout "pipe" :stderr "pipe")))
               (res (await (Promise/all (js-array (get child :exited)
                                                  (js-call (new globalThis.Response (get child :stdout)) :text)
                                                  (js-call (new globalThis.Response (get child :stderr)) :text))))))
          (unless (= (aref res 0) 0)
            (throw (new globalThis.Error (str "build failed: " (aref res 2) "\n" (aref res 1))))))
        (let ((loaded (js-object))
              (idx 0))
          (while (< idx (js-length modules))
            (let* ((m (aref modules idx))
                   (ns (await (funcall dynamic-import (get (pathToFileURL (resolve out-root (str m ".mjs"))) :href)))))
              (put loaded m ns))
            (setq idx (1+ idx)))
          (js-object :directory directory :mods loaded))
        (catch err
          (await (rm directory (js-object :recursive t :force t)))
          (throw err)))))

  (test "stdlib/math constants, trig/hyperbolic/log, IEEE rounding/division, and sampling"
    (async ()
      (let* ((built (await (compile-stdlib (js-array "seq" "math" "bit"))))
             (directory (get built :directory))
             (mods (get built :mods))
             (M (get mods :math))
             (B (get mods :bit)))
        (try
          ;; Constants
          (be (get M :PI) Math/PI)
          (be (get M :E) Math/E)
          (be (get M :TAU) (* 2 Math/PI))

          ;; Basic / Trig / Hyperbolic / Exp & Log
          (close-to (js-call M :sin (/ (get M :PI) 2)) 1)
          (close-to (js-call M :cos 0) 1)
          (close-to (js-call M :tan 0) 0)
          (close-to (js-call M :asin 1) (/ (get M :PI) 2))
          (close-to (js-call M :acos 1) 0)
          (close-to (js-call M :atan 1) (/ (get M :PI) 4))
          (close-to (js-call M :atan2 1 1) (/ (get M :PI) 4))
          (close-to (js-call M :sinh 0) 0)
          (close-to (js-call M :cosh 0) 1)
          (close-to (js-call M :tanh 0) 0)
          (close-to (js-call M :asinh 0) 0)
          (close-to (js-call M :acosh 1) 0)
          (close-to (js-call M :atanh 0) 0)
          (close-to (js-call M :to_degrees (get M :PI)) 180)
          (close-to (js-call M :to_radians 180) (get M :PI))
          (close-to (js-call M :exp 1) (get M :E))
          (close-to (js-call M :expm1 0) 0)
          (close-to (js-call M :log (get M :E)) 1)
          (close-to (js-call M :log10 1000) 3)
          (close-to (js-call M :log2 1024) 10)
          (close-to (js-call M :log1p 0) 0)
          (be (js-call M :pow 2 10) 1024)
          (be (js-call M :sqrt 144) 12)
          (be (js-call M :cbrt 27) 3)
          (be (js-call M :hypot 3 4) 5)
          (be (js-call M :abs -7) 7)
          (be (js-call M :min 5 2 9) 2)
          (be (js-call M :max 5 2 9) 9)
          (be (js-call M :clamp 15 0 10) 10)
          (be (js-call M :clamp -3 0 10) 0)
          (be (js-call M :clamp 4 0 10) 4)
          (be (js-call M :signum -42) -1)
          (be (js-call M :signum 0) 0)
          (be (js-call M :signum 42) 1)
          (be (js-call M :copy_sign 5 -1) -5)
          (be (js-call M :copy_sign -5 1) 5)
          (be (js-call M :floor 2.9) 2)
          (be (js-call M :ceil 2.1) 3)
          (be (js-call M :trunc -2.9) -2)
          (be (js-call M :round 2.5) 3)

          ;; IEEE rint (round-half-to-even), floor-div/floor-mod, IEEE-remainder, scalb, ulp
          (be (js-call M :rint 2.5) 2)
          (be (js-call M :rint 3.5) 4)
          (be (js-call M :rint -2.5) -2)
          (be (js-call M :rint -3.5) -4)
          (be (js-call M :floor_div -7 3) -3)
          (be (js-call M :floor_mod -7 3) 2)
          (be (js-call M :floor_div -4 -2) 2)
          (be (js-call M :floor_mod -7 -3) -1)
          (be (js-call M :IEEE_remainder 5 4) 1)
          (be (js-call M :IEEE_remainder 6 4) -2)
          (be (js-call M :scalb 1.5 3) 12)
          (be (js-call M :scalb 16 -2) 4)
          (be (js-call M :ulp 1.0) 2.220446049250313e-16)
          (be (js-call M :ulp 0.0) 5e-324)

          ;; Random / sampling
          (let ((r (js-call M :random)))
            (be (and (>= r 0) (< r 1)) t))
          (let ((ri (js-call M :rand_int 5)))
            (be (and (Number/isInteger ri) (>= ri 0) (< ri 5)) t))
          (let* ((v (persistentVector "a" "b" "c"))
                 (picked (js-call M :rand_nth v)))
            (be (or (= picked "a") (= picked "b") (= picked "c")) t)
            (js-call (expect (lambda () (js-call M :rand_nth EMPTY_VECTOR))) :toThrow "math/rand-nth collection is empty")
            (be (count (js-call M :shuffle v)) 3)
            (same (Array/from (js-call M :random_sample 1 v)) (js-array "a" "b" "c"))
            (same (Array/from (js-call M :random_sample 0 v)) (js-array)))

          ;; stdlib/bit full 32-bit functional & single-bit ops
          (be (js-call B :bit_and_fn 15 9) 9)
          (be (js-call B :bit_or_fn 9 6) 15)
          (be (js-call B :bit_xor_fn 15 9) 6)
          (be (js-call B :bit_not_fn 0) -1)
          (be (js-call B :bit_and_not 15 9) 6)
          (be (js-call B :bit_shift_left_fn 1 4) 16)
          (be (js-call B :bit_shift_right_fn -16 2) -4)
          (be (js-call B :unsigned_bit_shift_right_fn -1 1) 2147483647)
          (be (js-call B :bit_test 5 0) t)
          (be (js-call B :bit_test 5 1) false)
          (be (js-call B :bit_set 5 1) 7)
          (be (js-call B :bit_clear 7 1) 5)
          (be (js-call B :bit_flip 5 1) 7)
          (be (js-call B :bit_flip 7 1) 5)
          (be (js-call B :leading_zeros 0) 32)
          (be (js-call B :leading_zeros 1) 31)
          (be (js-call B :leading_zeros -1) 0)
          (be (js-call B :trailing_zeros 0) 32)
          (be (js-call B :trailing_zeros 8) 3)
          (be (js-call B :highest_one_bit 0) 0)
          (be (js-call B :highest_one_bit 19) 16)
          (be (js-call B :lowest_one_bit 0) 0)
          (be (js-call B :lowest_one_bit 12) 4)

          ;; Protective math/bit boundaries and error validation
          (js-call (expect (lambda () (js-call M :floor_div 5 0))) :toThrow "floor-div division by zero")
          (js-call (expect (lambda () (js-call M :floor_mod 5 0))) :toThrow "floor-mod division by zero")
          (js-call (expect (lambda () (js-call M :clamp 5 10 2))) :toThrow "math/clamp requires low <= high")
          (be (Number/isNaN (js-call M :clamp globalThis/NaN 0 10)) t)
          (be (Number/isNaN (js-call M :ulp globalThis/NaN)) t)
          (be (js-call M :ulp (- globalThis/Infinity)) globalThis/Infinity)
          (be (js-call M :scalb 1 -1074) 5e-324)
          (be (Object/is (js-call M :copy_sign 5 -0.0) -5) t)
          (be (js-call B :bit_test -2147483648 31) t)
          (be (js-call B :bit_set 0 31) -2147483648)
          (be (js-call B :bit_clear -2147483648 31) 0)
          (be (js-call B :highest_one_bit -2147483648) -2147483648)
          (be (js-call B :lowest_one_bit -2147483648) -2147483648)
          (finally
            (await (rm directory (js-object :recursive t :force t)))))))
    60000)
)
