(module tests.compiler-portable-emitter.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile readdir mkdir)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/indent-contract.mjs" oracle box read invoke finish changingInput observed)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar directory undefined) (defvar backend undefined) (defvar runtime undefined) (defvar source undefined)
  (defvar program undefined) (defvar bytes undefined) (defvar js undefined)
  (defun isolate (text)
    (let* ((start (js-call text :search (new globalThis.RegExp "  \\(def(?:const|un) native-indent[\\s\\n]")))
           (end (js-call text :indexOf "  (defun indent " start)))
      (funcall assert (and (>= start 0) (> end start)))
      (str "(module portable.emitter (defconst marker 1)\n" (js-call text :slice start end) "\n(export native-indent))")))
  (defasync loadCode (code) (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from code) :toString "base64")))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-portable-emitter-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq source (isolate (await (readFile "bootstrap/compiler/emitter.eli" "utf8"))))
    (setq program (js-call (get backend :compiler) :compile_ir_string source "portable-emitter.eli"))
    (setq js (await (loadCode (js-call (get backend :compiler) :emit_ir_string program))))) 120000)
  (afterAll (async () (unless (nullish? directory) (await (rm directory (js-object :recursive t :force t))))))
  (defun emit (&rest __host_default_arguments_1)
    (let* ((p (aref __host_default_arguments_1 0)) (rt (aref __host_default_arguments_1 1)))
    (setq p (if (= p undefined) program p) rt (if (= rt undefined) runtime rt))
    (let* ((saved (JSON/stringify p)) (out (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm p rt))))
      (js-call assert :equal (JSON/stringify p) saved) (funcall assert (js-call globalThis.WebAssembly :validate out))
      (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module out)) (js-array)) out)))
  (defun currentBytes () (if (nullish? bytes) (emit) bytes))
  (defun invalidInputs () (js-array undefined nil (js-object) (js-object :text nil :marks (js-array)) (js-object :text "a" :marks nil) (js-object :text "a" :marks (js-array nil))))
  (defun diagnosticCode (error) (let ((d (get error :eliscriptDiagnostic))) (if (nullish? d) undefined (get d :code))))
  (test "native indent retains original const arrow arity and cannot be a constructor or newTarget" (lambda ()
    (js-call assert :equal (get (get js :native_indent) :length) (get oracle :length))
    (js-call assert :equal (Object/hasOwn (get js :native_indent) "prototype") false)
    (js-call assert :throws (lambda () (Reflect/construct (js* "function () {}") (js-array) (get js :native_indent))) globalThis.TypeError)))
  (test "indexed indent emits executable zero-import WASM rather than raw JavaScript" (lambda ()
    (setq bytes (emit))
    (let ((a (instantiateManagedRuntime bytes))
          (input (js-object :text "a\n😀b\n" :marks (js-array (js-object :offset 0 :span (js-object :start 0)) (js-object :offset 2 :span nil) (js-object :offset 6 :span false)))))
      (js-call a :auto 1) (js-call assert :deepEqual (invoke a input) (oracle input)) (finish a))))
  (test "indexed indent keeps UTF16, empty lines, EOF and unordered or invalid mark offsets exactly" (lambda ()
    (let ((a (instantiateManagedRuntime (currentBytes)))
          (offsets (js-array 0 (js* "-0") 1 2 3 4 5 9 -1 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) 0.5 "0" "1" nil false t undefined)))
      (js-call a :auto 1)
      (js-call (js-array "" "\n" "\n\n" "a" "a\n" "\na" "a\n\nb" "中😀\ud800\n\udfffZ") :forEach (lambda (text)
        (js-call offsets :forEach (lambda (offset)
          (js-call (js-array (js-array) (js-array (js-object :offset 0 :span "late")) (js-array (js-object :offset 99 :span undefined)))
            :forEach (lambda (tail)
              (let ((input (js-object :text text :marks (js-call (js-array (js-object :offset offset :span "first")) :concat tail))))
                (js-call assert :deepEqual (js-call js :native_indent input) (oracle input))
                (js-call assert :deepEqual (invoke a input) (oracle input)))))))
        (let* ((marks (Array/from (js-object :length (+ (get text :length) 2)) (lambda (unused offset) (js-object :offset offset :span (js-object :start offset)))))
               (input (js-object :text text :marks marks)))
          (js-call assert :deepEqual (invoke a input) (oracle input)))))
      (finish a))))
  (test "indexed indent reads getters, changing offsets and dynamic length in original order and preserves nullish errors" (lambda ()
    (let ((left (changingInput)) (right (changingInput)))
      (js-call assert :deepEqual (js-call js :native_indent (get left :input)) (oracle (get right :input)))
      (js-call assert :deepEqual (get left :trace) (get right :trace)))
    (js-call (invalidInputs) :forEach (lambda (input)
      (let ((expected undefined)) (try (oracle input) (catch e (setq expected e)))
        (funcall assert (funcall (js* "(a, b) => a instanceof b") expected globalThis.TypeError))
        (js-call assert :throws (lambda () (js-call js :native_indent input)) globalThis.TypeError))))
    (js-call assert :throws (lambda () (js-call js :native_indent)) globalThis.TypeError)))
  (test "deterministic random Unicode and mixed mark values match the raw oracle under collection at every allocation" (lambda ()
    (let ((a (instantiateManagedRuntime (currentBytes))) (state 425204139) (pool (js-array "a" "中" "😀" "\ud800" "\udfff" "\n" "\t")))
      (js-call a :auto 1)
      (letfn ((next () (setq state (uint32 (+ (Math/imul state 1664525) 1013904223))) state))
        (let ((n 0)) (while (< n 200)
          (let* ((text (js-call (Array/from (js-object :length (% (next) 40)) (lambda () (aref pool (% (next) (get pool :length))))) :join ""))
                 (marks (Array/from (js-object :length (% (next) 20)) (lambda ()
                   (js-object :offset (% (next) (+ (get text :length) 5)) :span (if (not (= (% (next) 3) 0)) (% (next) 99) nil))))))
            (when (not (= (% (next) 2) 0)) (js-call marks :sort (lambda (a b) (- (get a :offset) (get b :offset)))))
            (let ((input (js-object :text text :marks marks))) (js-call assert :deepEqual (invoke a input) (oracle input))))
          (setq n (1+ n)))))
      (funcall assert (> (get (js-call a :stats) :collections) 100)) (finish a))))
  (test "WASM indent preserves offset coercion effects, sparse mark stopping and its original string addition" (async ()
    (let* ((extra "\n  (defun effects ()\n    (let* ((trace (js-object :events \"\"))\n           (offset (js-object :valueOf (lambda () (put trace :events (+ (aref trace \"events\") \"v\")) \"0\")))\n           (mark (js-object :offset offset :span \"kept\"))\n           (fragment (js-object :text \"a\\nb\" :marks (js-array mark))))\n      (let ((out (native-indent fragment)))\n        (js-array out (aref trace \"events\")))))\n  (defun split-effects ()\n    (let* ((trace (js-object :events \"\"))\n           (parts (js-array \"a\" \"b\"))\n           (text (js-object :split (lambda (separator)\n                   (put trace :events (+ (aref trace \"events\") separator)) parts)))\n           (fragment (js-object :text text :marks (js-array (js-object :offset 0 :span 7)))))\n      (js-array (native-indent fragment) (aref trace \"events\"))))\n  ")
           (text (js-call source :replace "(export native-indent))" (str extra "(export native-indent effects split-effects))")))
           (p (js-call (get backend :compiler) :compile_ir_string text "indent-effects.eli"))
           (a (instantiateManagedRuntime (emit p))))
      (js-call a :auto 1)
      (let ((module (await (loadCode (js-call (get backend :compiler) :emit_ir_string p)))))
        (js-call (js-array "effects" "split-effects") :forEach (lambda (name)
          (let ((out undefined))
            (try (setq out (js-call a :invoke name)) (js-call assert :deepEqual (read a out) (Reflect/apply (get module (js-call name :replaceAll "-" "_")) module (js-array)))
              (catch error (put error :message (str name ": " (get error :message))) (throw error))
              (finally (js-call a :release out))))))
        (let ((traced (js-object :text "a\nb" :marks (js-array (js-object :offset (js-object :valueOf (lambda () "0")) :span "kept"))))
              (sparseMarks (new globalThis.Array 2)))
          (js-call assert :deepEqual (aref (js-call module :effects) 0) (oracle traced))
          (js-call assert :equal (aref (js-call module :effects) 1) "vvv")
          (put sparseMarks 1 (js-object :offset 2 :span "unvisited"))
          (let ((sparse (js-object :text "a\nb" :marks sparseMarks))) (js-call assert :deepEqual (invoke a sparse) (oracle sparse)))))
      (finish a))))
  (test "nullish, invalid handles and capacity failures unwind only their own frames and recover without leaking roots" (lambda ()
    (let ((a (instantiateManagedRuntime (currentBytes) (js-object :maxSlots 256))))
      (js-call a :auto 1)
      (js-call (invalidInputs) :forEach (lambda (input) (js-call assert :throws (lambda () (invoke a input)) (lambda (e) (js-call (js-array "ELI-RT0001" "ELI-RT0003") :includes (diagnosticCode e))))))
      (js-call assert :throws (lambda () (js-call a :invoke "native-indent")) (lambda (e) (= (diagnosticCode e) "ELI-RT0001")))
      (let* ((input (box a (js-object :text "a\nb" :marks (js-array (js-object :offset 0 :span "span"))))) (frame (js-call a :frame 1)) (held (js-array)))
        (js-call a :frameSet frame 0 input)
        (js-call (js-array (js-object) frame) :forEach (lambda (invalid) (js-call assert :throws (lambda () (js-call a :invoke "native-indent" (js-array invalid))) (lambda (e) (= (diagnosticCode e) "ELI-RT0001")))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (let ((index 0) (done false))
          (while (and (< index 512) (not done))
            (try (js-call held :push (js-call a :number index))
              (catch e (js-call assert :equal (diagnosticCode e) "ELI-RT0002") (setq done t)))
            (setq index (1+ index))))
        (funcall assert (and (> (get held :length) 0) (< (get held :length) 512)))
        (js-call assert :throws (lambda () (js-call a :invoke "native-indent" (js-array input))) (lambda (e) (= (diagnosticCode e) "ELI-RT0002")))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call held :forEach (lambda (v) (js-call a :release v))) (js-call a :collect)
        (let ((out (js-call a :invoke "native-indent" (js-array input))))
          (try (js-call assert :deepEqual (read a out) (oracle (js-object :text "a\nb" :marks (js-array (js-object :offset 0 :span "span"))))) (finally (js-call a :release out))))
        (let ((root (js-call a :frameGet frame 0))) (js-call a :release root))
        (js-call a :leaveFrame frame) (js-call a :release input))
      (finish a))))
  (test "an actual WASM trap in string splitting restores the caller frame and retains its source roots" (async ()
    (let* ((raw (await (readFile "bootstrap/runtime/memory.eli" "utf8"))) (start (js-call raw :indexOf "  (defun heap-text-split "))
           (end (js-call raw :indexOf "\n  (defun " (+ start 1))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((rt (js-call (get backend :compiler) :compile_ir_string (str (js-call raw :slice 0 start) "  (defun heap-text-split (heap text separator argument) (load-u32 4294967295))\n" (js-call raw :slice end)) "indent-trap-runtime.eli"))
             (a (instantiateManagedRuntime (emit program rt))) (input undefined) (frame undefined))
        (js-call a :auto 1) (setq input (box a (js-object :text "a" :marks (js-array))) frame (js-call a :frame 1))
        (js-call a :frameSet frame 0 input)
        (js-call assert :throws (lambda () (js-call a :invoke "native-indent" (js-array input))) (get globalThis.WebAssembly :RuntimeError))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (let ((root (js-call a :frameGet frame 0))) (js-call assert :deepEqual (read a root) (js-object :text "a" :marks (js-array))) (js-call a :release root))
        (js-call a :leaveFrame frame) (js-call a :release input) (finish a)))))
  (test "Node executes the same zero-import indent bytes against the independent original algorithm" (async ()
    (let ((file (resolve directory "indent.wasm")))
      (await (writeFile file (currentBytes)))
      (let ((child (spawnSync "node" (js-array "tests/fixtures/compiler-indent-wasm-host.mjs" file) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))))
  (test "public Seed plus all 13 compiler modules retain three-generation JS fixed points and identical independent WASM indent bytes" (async ()
    (let ((input (resolve directory "portable-emitter.eli")) (output (resolve directory "portable-emitter-seed.mjs")))
      (await (writeFile input source))
      (let ((child (spawnSync (resolve root "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr)))
      (js-call assert :equal (await (readFile output "utf8")) (js-call (get backend :compiler) :emit_ir_string program)))
    (let* ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort))
           (compiler (get backend :compiler)) (canonical undefined) (generation 0))
      (js-call assert :equal (get files :length) 13)
      (while (< generation 3)
        (let ((out (resolve directory (str "compiler-generation-" generation))) (emitted (js-array)) (index 0))
          (await (mkdir out (js-object :recursive t)))
          (while (< index (get files :length))
            (let* ((file (aref files index)) (filename (resolve root "bootstrap/compiler" file)) (text (await (readFile filename "utf8")))
                   (target (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs")) (javascript (js-call compiler :compile_string text filename)))
              (js-call emitted :push (js-array file javascript)) (await (writeFile (resolve out target) javascript)))
            (setq index (1+ index)))
          (if (not (= canonical undefined)) (js-call assert :deepEqual emitted canonical) (setq canonical emitted))
          (let ((p (js-call compiler :compile_ir_string source "portable-emitter.eli")))
            (js-call assert :deepEqual p program) (js-call assert :deepEqual (emit p) (currentBytes)))
          (setq compiler (await (funcall load-module (get (pathToFileURL (resolve out "compiler.mjs")) :href)))))
        (setq generation (1+ generation))))) 120000)
  (test "throwing and changing custom fragment fields preserve the raw algorithm exact property and method order" (lambda ()
    (js-call (js-array nil "text" "marks" "split.get" "split.call:\n" "marks:0" "parts:length" "parts:0" "line.length" "line.valueOf" "parts.set:0" "offset1" "offset2" "offset3" "span" "marks:1" "parts:join")
      :forEach (lambda (failure) (js-call assert :deepEqual (observed (get js :native_indent) failure) (observed oracle failure) (funcall globalThis.String failure))))))
  (test "missing and extra source arguments retain undefined and complete their effects before fragment property reads" (async ()
    (let* ((extra "(defun indent-arguments (&rest args) (apply native-indent args))\n (defun indent-extra (fragment trace) (native-indent fragment (put trace :called t) (put fragment :text \"changed\")))") (text (js-call source :replace "(export native-indent))" (str extra "(export native-indent indent-arguments indent-extra))")))
           (p (js-call (get backend :compiler) :compile_ir_string text "indent-arguments.eli")) (a (instantiateManagedRuntime (emit p))))
      (js-call a :auto 1)
      (js-call (js-array (js-array) (js-array undefined) (js-array nil)) :forEach (lambda (args)
        (js-call assert :throws (lambda () (apply oracle args)) globalThis.TypeError)
        (js-call assert :throws (lambda () (Reflect/apply (get js :native_indent) js args)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call a :invoke "indent-arguments" args)) (lambda (e) (js-call (js-array "ELI-RT0001" "ELI-RT0003") :includes (diagnosticCode e))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
      (let* ((fragment (box a (js-object :text "old" :marks (js-array)))) (trace (box a (js-object :called false))) (out (js-call a :invoke "indent-extra" (js-array fragment trace))))
        (js-call assert :deepEqual (read a out) (oracle (js-object :text "changed" :marks (js-array))))
        (js-call assert :deepEqual (read a trace) (js-object :called t))
        (js-call (js-array fragment trace out) :forEach (lambda (x) (js-call a :release x))))
      (finish a))))
  (test "source spans preserve alias identity and arbitrary cyclic span data while fragments retain their original source fields" (lambda ()
    (let ((a (instantiateManagedRuntime (currentBytes))))
      (js-call a :auto 1)
      (let* ((span (js-call a :sourceObject (js-object))) (self (js-call a :string "self")))
        (js-call a :objectSet span self span)
        (let* ((zero (js-call a :number 0)) (two (js-call a :number 2))
               (first (js-call a :sourceObject (js-object :offset zero :span span))) (second (js-call a :sourceObject (js-object :offset two :span span)))
               (marks (js-call a :sourceArray (js-array first second))) (text (js-call a :string "a\nb"))
               (fragment (js-call a :sourceObject (js-object :text text :marks marks))) (out (js-call a :invoke "native-indent" (js-array fragment)))
               (marksKey (js-call a :string "marks")) (spanKey (js-call a :string "span")) (returned (js-call a :objectGet out marksKey)) (index 0))
          (while (< index 2)
            (let* ((mark (js-call a :get returned index)) (actual (js-call a :objectGet mark spanKey)))
              (funcall assert (js-call a :keyEqual actual span))
              (let ((cycle (js-call a :objectGet actual self)))
                (funcall assert (js-call a :keyEqual cycle actual))
                (js-call (js-array mark actual cycle) :forEach (lambda (v) (js-call a :release v)))))
            (setq index (1+ index)))
          (js-call assert :equal (js-call a :readString text) "a\nb") (js-call assert :equal (js-call a :length marks) 2)
          (js-call (js-array span self zero two first second marks text fragment out marksKey spanKey returned) :forEach (lambda (v) (js-call a :release v)))))
      (finish a))))
  (test "represented primitive property reads preserve the original fragment algorithm and JS results" (lambda ()
    (let ((a (instantiateManagedRuntime (currentBytes))))
      (js-call a :auto 1)
      (js-call (js-array "" "x" "中😀\ud800" false t 0 (js* "-0") globalThis.NaN globalThis.Infinity (- globalThis.Infinity)) :forEach (lambda (marks)
        (let ((input (js-object :text "a" :marks marks)))
          (js-call assert :deepEqual (js-call js :native_indent input) (oracle input))
          (js-call assert :deepEqual (invoke a input) (oracle input))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))
      (finish a))))
)
