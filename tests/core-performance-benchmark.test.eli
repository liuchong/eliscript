(module tests.core-performance-benchmark
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:url" fileURLToPath)
  (import "../tools/performance/core-benchmark.mjs" CORE_BENCHMARK_PARAMETERS CORE_BENCHMARK_THRESHOLDS validateCoreBenchmarkReport validateCoreBenchmarkSource)
  (defconst reportPath (fileURLToPath (new globalThis.URL "../benchmarks/core-performance-macos-arm64.json" (js* "import.meta.url"))))
  (defconst host-truth (js* "(value) => !!value"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun match (actual expected) (js-call (expect actual) :toMatchObject expected))
  (defun raises (operation message) (js-call (expect operation) :toThrow message))
  (test "retained core performance report preserves measured evidence and budgets" (async ()
    (let ((report (validateCoreBenchmarkReport (await (readReport)))))
      (match (get report :host) (js-object :platform "darwin" :architecture "arm64"))
      (same (get report :parameters) CORE_BENCHMARK_PARAMETERS) (same (get report :thresholds) CORE_BENCHMARK_THRESHOLDS)
      (js-call (expect (get report :runs)) :toHaveLength 3)
      (same (Object/keys (get report :summary)) (Object/keys CORE_BENCHMARK_THRESHOLDS))
      (same (get report :decision) (js-object :baselineRuns 3 :correct t :stable t :withinRegressionBudgets t :passed t))
      (js-call (get report :runs) :forEach (lambda (run)
        (match (get run :compiler) (js-object :sourceCount 13 :deterministic t))
        (match (get run :build) (js-object :moduleCount 4 :exactDecisions t))
        (let ((worker (get run :worker)))
          (be (get worker :equivalentToEmacs) t)
          (js-call (expect (get worker :emacsSamplesMs)) :toHaveLength 7)
          (js-call (expect (get worker :warmEndToEndSamplesMs)) :toHaveLength 7)
          (js-call (expect (get worker :warmExecutionSpeedup)) :toBeGreaterThan 0)
          (js-call (expect (get worker :warmEndToEndSpeedup)) :toBeGreaterThan 0))
        (match (get run :workload) (js-object :name "persistent-frequencies" :inputCount 100000 :keyCount 1000 :countPerKey 100 :deterministic t))))
      (js-call (Object/values (get report :summary)) :forEach (lambda (metric)
        (js-call (expect (get metric :samplesMs)) :toHaveLength 3) (be (get metric :passed) t)))
      (js-call (expect (js-call (get (get report :source) :files) :map (lambda (entry) (get entry :file)))) :toContain "tools/performance/core-benchmark.mjs"))))
  (test "core performance report validator rejects incomplete or stale evidence" (async ()
    (let* ((original (await (readReport))) (incomplete (globalThis/structuredClone original))
           (changedThreshold (globalThis/structuredClone original)) (changedSummary (globalThis/structuredClone original)) (staleSource (globalThis/structuredClone original)))
      (js-call (get incomplete :runs) :pop)
      (raises (lambda () (validateCoreBenchmarkReport incomplete)) "invalid core performance benchmark runs")
      (let ((threshold (get (get changedThreshold :thresholds) "compiler.warmCorpus")))
        (put threshold :maximumMedianMs (1+ (get threshold :maximumMedianMs))))
      (raises (lambda () (validateCoreBenchmarkReport changedThreshold)) "core performance thresholds do not match the contract")
      (let ((summary (get (get changedSummary :summary) "worker.warmEndToEnd"))) (put summary :medianMs (1+ (get summary :medianMs))))
      (raises (lambda () (validateCoreBenchmarkReport changedSummary)) "core performance summary does not match its runs")
      (put (get staleSource :source) :digest (js-call "0" :repeat 64))
      (await (js-call (get (expect (validateCoreBenchmarkSource staleSource)) :rejects) :toThrow "core performance report does not match current sources")))))
  (test "failed core gates retain the complete measured report" (async ()
    (let ((report (await (readReport))) (failure undefined))
      (put (get report :decision) :passed false)
      (try (validateCoreBenchmarkReport report) (catch error (setq failure error)))
      (js-call (expect failure) :toBeInstanceOf globalThis.TypeError)
      (be (funcall host-truth (get failure :report)) t) (be (get failure :report) report))))
  (funcall (currentPerformanceTest test) "committed core performance report matches current sources and budgets" (async ()
    (await (validateCoreBenchmarkSource (await (readReport))))))
)
