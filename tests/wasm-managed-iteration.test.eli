(module capsules.tests.wasm-managed-iteration.test
  (js* "import {beforeAll,afterAll,test} from 'bun:test';\nimport assert from 'node:assert/strict';\nimport {readFile,mkdtemp,rm} from 'node:fs/promises';\nimport {resolve} from 'node:path';\nimport {tmpdir} from 'node:os';\nimport {buildBackends} from '../tools/backends/build.mjs';\nimport {instantiateManagedRuntime} from '../tools/backends/managed-runtime.mjs';\nconst intrinsic='(iterable, visit) => { for (const item of iterable) visit(item); }';\nconst source='(defconst iterate (js* '+JSON.stringify(intrinsic)+')) (defun empty () (funcall iterate (js-array) false)) (defun run (values trace) (funcall iterate values (lambda (&rest args) (js-call trace :push (js-array (js-length args) (aref args 0)))))) (defun invalid () (funcall iterate (js-array 1) false)) (export iterate empty run invalid)';\nlet directory,b,runtime,program,js;\nbeforeAll(async()=>{directory=await mkdtemp(resolve(tmpdir(),'eliscript-iteration-'));b=await buildBackends({outputRoot:directory});runtime=b.compiler.compile_ir_string(await readFile('bootstrap/runtime/memory.eli','utf8'),'runtime.eli');program=b.compiler.compile_ir_string(source,'iteration.eli');js=await import('data:text/javascript;base64,'+Buffer.from(b.compiler.emit_ir_string(program)).toString('base64'));},120000);\nafterAll(async()=>{if(directory)await rm(directory,{recursive:true,force:true});});\nfunction artifact(){const saved=JSON.stringify(program),bytes=Uint8Array.from(b.managed.emit_managed_wasm(program,runtime));assert.equal(JSON.stringify(program),saved);assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(bytes)),[]);return bytes;}\nfunction read(a,value){if(value?.kind===4)return a.readNumber(value);if(value?.kind===5)return a.readString(value);if(value?.kind===14)return Array.from({length:a.length(value)},(_,i)=>{const item=a.get(value,i);try{return read(a,item);}finally{a.release(item);}});return value;}\nfunction finish(a,roots=[]){roots.forEach(value=>a.release(value));a.closeModule();a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);}\ntest('a general existing raw for-of expression lowers to pure zero-import WASM with lazy callback validation and exactly one callback argument',()=>{\n const a=instantiateManagedRuntime(artifact());a.auto(1);assert.equal(a.invoke('empty'),undefined);const value=a.string('A😀\\ud800'),trace=a.sourceArray([]),expected=[];assert.equal(a.invoke('run',[value,trace]),undefined);js.run('A😀\\ud800',expected);assert.deepEqual(read(a,trace),expected);assert.throws(()=>a.invoke('invalid'),error=>error.eliscriptDiagnostic?.code==='ELI-RT0003');finish(a,[value,trace]);\n});\ntest('the intrinsic preserves original arrow shape native iterator next capture receiver and per-item getter ordering in JavaScript',()=>{\n assert.equal(js.iterate.length,2);assert.equal(Object.hasOwn(js.iterate,'prototype'),false);assert.throws(()=>Reflect.construct(String,[],js.iterate),TypeError);\n const events=[],iterator={i:0,get next(){events.push('get-next');return function(){assert.equal(this,iterator);events.push('next'+this.i);return this.i++<2?{value:{get tag(){events.push('value'+iterator.i);return iterator.i;}},done:0}:{done:'yes'};}},return(){events.push('close');return{};}},values={[Symbol.iterator](){events.push('iterator');assert.equal(this,values);return iterator;}};\n assert.equal(js.iterate(values,function(item){assert.equal(arguments.length,1);assert.equal(this,undefined);events.push('visit'+item.tag);}),undefined);\n assert.deepEqual(events,['iterator','get-next','next0','value1','visit1','next1','value2','visit2','next2']);\n assert.equal(js.iterate([],false),undefined);assert.throws(()=>js.iterate([1],false),TypeError);\n});\n\nconst protocolSource=`\n (defun protocol (trace mode flag)\n   (let* ((iterator (js-object)) (index 0) (iterable (js-object)))\n     (put iterator :next (lambda ()\n       (js-call trace :push (str \"next\" index))\n       (put iterator :next (lambda () (throw \"replacement-next\")))\n       (when (= mode 3) (throw trace))\n       (if (> index 0) (js-object :done t)\n         (progn (setq index (1+ index)) (js-object :done flag :value 7)))))\n     (put iterator :return (lambda () (js-call trace :push \"return\")\n       (if (= mode 1) (throw \"return-error\") (if (= mode 2) undefined (js-object)))))\n     (put iterable (js* \"Symbol.iterator\") (lambda () (js-call trace :push \"iterator\") iterator))\n     iterable))\n (defun exercise (trace mode flag)\n   (let ((input (protocol trace mode flag)))\n     (funcall iterate input (lambda (item) (js-call trace :push item)))))\n (defun abrupt (trace mode flag)\n   (let ((input (protocol trace mode flag)))\n     (try (funcall iterate input (lambda (item) (throw trace)))\n       (catch error (Object/is error trace)))))\n (defun callback-invalid (trace mode)\n   (let ((input (protocol trace mode false)))\n     (try (funcall iterate input false)\n       (catch error (get error :name)))))\n (defun extra (trace)\n   (funcall iterate (js-array) false (js-call trace :push \"extra\")))\n (defun nested (trace)\n   (funcall iterate (js-array 1 2) (lambda (item)\n     (funcall iterate (js-array 3 4) (lambda (inner) (js-call trace :push (+ item inner)))))))\n (export exercise abrupt callback-invalid extra nested)`;\nfunction family(){const program=b.compiler.compile_ir_string(source+protocolSource,'protocol-iteration.eli'),bytes=Uint8Array.from(b.managed.emit_managed_wasm(program,runtime));assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(bytes)),[]);return instantiateManagedRuntime(bytes);}\ntest('WASM iteration captures next once and observes native done truth before callbacks while nested calls retain caller roots',()=>{\n const a=family();a.auto(1);\n for(const flag of[undefined,null,false,0,-0,NaN,'',true,1,'yes',[],{}]){const trace=a.sourceArray([]),mode=a.number(0),value=Array.isArray(flag)?a.sourceArray([]):flag&&typeof flag==='object'?a.sourceObject({}):typeof flag==='number'?a.number(flag):typeof flag==='string'?a.string(flag):flag;\n  assert.equal(a.invoke('exercise',[trace,mode,value]),undefined);assert.deepEqual(read(a,trace),flag?['iterator','next0']:['iterator','next0',7,'next1']);for(const root of[trace,mode,value])a.release(root);}\n const trace=a.sourceArray([]);assert.equal(a.invoke('extra',[trace]),undefined);assert.deepEqual(read(a,trace),['extra']);assert.equal(a.invoke('nested',[trace]),undefined);assert.deepEqual(read(a,trace),['extra',4,5,5,6]);finish(a,[trace]);\n});\ntest('callback exceptions close iterators once with original-error priority while exceptions from next never call return',()=>{\n const a=family();a.auto(1);\n for(const mode of[0,1,2,3]){const trace=a.sourceArray([]),input=a.number(mode);assert.equal(a.invoke('abrupt',[trace,input,false]),true);assert.deepEqual(read(a,trace),mode===3?['iterator','next0']:['iterator','next0','return']);a.release(trace);a.release(input);}\n for(const mode of[0,1,2]){const trace=a.sourceArray([]),input=a.number(mode),out=a.invoke('callback-invalid',[trace,input]);assert.equal(a.readString(out),'TypeError');assert.deepEqual(read(a,trace),['iterator','next0','return']);for(const root of[trace,input,out])a.release(root);}\n finish(a);\n});\ntest('native JS abrupt completion closes exactly once and preserves iterator protocol getter and original exception ordering',()=>{\n for(const failure of['visit','next','done','value','return']){const events=[],sentinel={},iterator={next(){events.push('next');if(failure==='next')throw sentinel;return{get done(){events.push('done');if(failure==='done')throw sentinel;return false;},get value(){events.push('value');if(failure==='value')throw sentinel;return 7;}};},get return(){events.push('get-return');if(failure==='return')throw 'return-error';return function(){assert.equal(this,iterator);events.push('return');throw 'return-error';};}},values={[Symbol.iterator](){return iterator;}};let error;try{js.iterate(values,()=>{events.push('visit');throw sentinel;});}catch(caught){error=caught;}assert.equal(error,sentinel);assert.deepEqual(events,failure==='next'?['next']:failure==='done'?['next','done']:failure==='value'?['next','done','value']:failure==='return'?['next','done','value','visit','get-return']:['next','done','value','visit','get-return','return']);}\n});\n\ntest('each intrinsic expression evaluation creates a fresh arrow identity and spread retains holes Unicode codepoints and Map entry pairs',()=>{\n const extra='(defun fresh () (js* '+JSON.stringify(intrinsic)+')) (defun spread (value) (funcall (js* \"(iterable) => [...iterable]\") value)) (defun map-input () (let ((value (new (js* \"Map\")))) (js-call value :set \"x\" 1) value)) (export fresh spread map-input)',p=b.compiler.compile_ir_string(source+extra,'iteration-identity.eli'),a=instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_wasm(p,runtime)));a.auto(1);\n const left=a.invoke('fresh'),right=a.invoke('fresh');assert.equal(a.keyEqual(left,right),false);\n const sparse=a.sourceArray([true,,undefined]),text=a.string('A😀\\ud800'),map=a.invoke('map-input');\n for(const[input,expected]of[[sparse,[true,undefined,undefined]],[text,[...'A😀\\ud800']],[map,[['x',1]]]]){const out=a.invoke('spread',[input]);assert.deepEqual(read(a,out),expected);a.release(out);}\n finish(a,[left,right,sparse,text,map]);\n});\n\ntest('native iterable callbacks preserve ordinary property errors through abrupt close and collecting GC',()=>{\n const p=b.compiler.compile_ir_string(source+' (defun bad-prop () (funcall iterate (js-array nil) (lambda (value) (aref value \"start\")))) (defun caught-bad-prop () (try (bad-prop) (catch error (get error :name)))) (export bad-prop caught-bad-prop)','iteration-property-error.eli'),a=instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_wasm(p,runtime)));a.auto(1);assert.throws(()=>a.invoke('bad-prop'),error=>{assert.equal(error.eliscriptDiagnostic?.code,'ELI-RT0001');return true;});const kind=a.invoke('caught-bad-prop');assert.equal(a.readString(kind),'TypeError');a.release(kind);assert.equal(a.stats().frameDepth,0);finish(a);\n});\n\ntest('iteration capacity failures retain completed callback effects and caller roots and recover after collection',()=>{\n const a=instantiateManagedRuntime(artifact(),{maxSlots:64,initialBytes:8192,maxBytes:65536});a.auto(1);const input=a.sourceArray(Array(64).fill(false)),trace=a.sourceArray([]),held=a.number(-0),frame=a.frame(1);a.frameSet(frame,0,held);\n assert.throws(()=>a.invoke('run',[input,trace]),error=>error.eliscriptDiagnostic?.code==='ELI-RT0002');assert.equal(a.stats().frameDepth,1);assert(Object.is(a.readNumber(held),-0));const completed=read(a,trace);assert(completed.length>0&&completed.length<64);for(const item of completed)assert.deepEqual(item,[1,false]);a.release(input);a.release(trace);a.collect();assert.equal(a.invoke('empty'),undefined);a.leaveFrame(frame);finish(a,[held]);\n});\n\ntest('a real WASM callback trap unwinds private iteration frames without swallowing the trap or invalidating caller roots',async()=>{\n const text=await readFile('bootstrap/runtime/memory.eli','utf8'),first=text.indexOf('  (defun value-source-invoke '),last=text.indexOf('  (defun value-function-capture-set ',first);assert(first>=0&&last>first);\n const injected=b.compiler.compile_ir_string(text.slice(0,first)+'  (defun value-source-invoke (heap function arguments count) (load-u32 4294967295))\\n'+text.slice(last),'iteration-trap.eli'),bytes=Uint8Array.from(b.managed.emit_managed_wasm(program,injected)),a=instantiateManagedRuntime(bytes);a.auto(1);const input=a.sourceArray([true]),trace=a.sourceArray([]),held=a.number(-0),frame=a.frame(1);a.frameSet(frame,0,held);\n assert.throws(()=>a.invoke('run',[input,trace]),WebAssembly.RuntimeError);assert.equal(a.stats().frameDepth,1);assert(Object.is(a.readNumber(held),-0));assert.deepEqual(read(a,trace),[]);assert.equal(a.invoke('empty'),undefined);a.leaveFrame(frame);finish(a,[input,trace,held]);\n});\n\ntest('the iteration ABI rejects illegal handles counts and modes and does not accept nearby arbitrary raw functions',()=>{\n const bytes=artifact(),e=new WebAssembly.Instance(new WebAssembly.Module(bytes)).exports,heap=e['heap-new'](64,8192,65536),argv=e['value-refs'](heap,7,0);assert.equal(e['last-error'](),0);\n for(const[owner,args,count,mode,code]of[[0,argv,0,0,1],[heap,0xffffffff,0,0,1],[heap,argv,1,0,3],[heap,argv,0,99,3]]){e['value-iterate-intrinsic'](owner,args,count,mode);assert.equal(e['last-error'](),code);}\n for(const raw of['(iterable, visit) => { for (const item of iterable) visit(item, 1); }','(iterable) => Array.from(iterable)','(iterable, visit) => { visit(iterable); }']){const p=b.compiler.compile_ir_string('(defconst arbitrary (js* '+JSON.stringify(raw)+')) (export arbitrary)','iteration-rejection.eli');assert.throws(()=>b.managed.emit_managed_wasm(p,runtime),error=>error.eliscriptDiagnostic?.code==='ELI-B0001');}\n});\n"))
