(module tests.wasm-managed-identity-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile writeFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-identity-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defconst family
    "(module identity\n (defconst same-value (js* \"Object.is\")) (defconst array-value (js* \"Array.isArray\"))\n (defun same (x y) (Object/is x y))\n (defun member (x y) (js-call globalThis.Object :is x y))\n (defun raw-member (x y) (js-call (js* \"Object\") :is x y))\n (defun alias (x y) (funcall same-value x y))\n (defun held () (lambda (x y) (funcall same-value x y)))\n (defun invoke (f x y) (funcall f x y))\n (defun apply-same (args) (apply same-value args))\n (defun empty () (Object/is)) (defun one (x) (Object/is x))\n (defun array-empty () (Array/isArray)) (defun array (x) (Array/isArray x)) (defun array-alias (x) (funcall array-value x))\n (defun identities () (and (eq same-value (get (js* \"Object\") :is)) (eq same-value (js* \"globalThis.Object.is\")) (eq array-value (get (js* \"Array\") :isArray))))\n (export same member raw-member alias held invoke apply-same empty one array-empty array array-alias identities))")

  (defasync compiled (&rest __host_default_arguments_1)
    (let* ((source-arg (aref __host_default_arguments_1 0)) (options (aref __host_default_arguments_1 1)))
    (let* ((source (if (undefined? source-arg) family source-arg))
           (p (js-call (get b :compiler) :compile_ir_string (str "(defconst identity-marker 1)\n" source) "identity.eli"))
           (before (JSON/stringify p))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))))
      (js-call assert :equal (JSON/stringify p) before)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (let* ((a (instantiateManagedRuntime bytes options))
             (_ (js-call a :auto 1))
             (js (await (dynamic-import (str "data:text/javascript;base64,"
                                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string p)) :toString "base64"))))))
        (js-object :a a :js js :bytes bytes)))))

  (defun box (a x)
    (cond
      ((= (value-type x) "number") (js-call a :number x))
      ((= (value-type x) "string") (js-call a :string x))
      (t x)))

  (defun finish (a &rest __host_default_arguments_2)
    (let* ((values-arg (aref __host_default_arguments_2 0)))
    (let ((values (if (undefined? values-arg) (js-array) values-arg)))
      (js-call values :forEach (lambda (x) (js-call a :release x)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (test "Object.is directly compares exact values and first-class aliases with no host imports" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (js (get c :js))
           (inputs (js-array undefined nil false t globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                             0 -0.0 globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) globalThis.Number.MAX_VALUE
                             1 -1 "" "0" "\ud800" "😀")))
      (js-call assert :equal (js-call a :invoke "identities") t)
      (js-call inputs :forEach
        (lambda (x)
          (js-call inputs :forEach
            (lambda (y)
              (let ((l (box a x))
                    (r (box a y)))
                (js-call (js-array "same" "member" "raw-member" "alias") :forEach
                  (lambda (name)
                    (js-call assert :equal
                      (js-call a :invoke name (js-array l r))
                      (js-call js (js-call name :replaceAll "-" "_") x y)
                      (str name ":" (globalThis.String x) "," (globalThis.String y)))))
                (js-call a :release l)
                (js-call a :release r))))))
      (js-call assert :equal (js-call a :invoke "empty") t)
      (js-call assert :equal (js-call a :invoke "array-empty") false)
      (js-call inputs :forEach
        (lambda (x)
          (let ((v (box a x)))
            (js-call assert :equal (js-call a :invoke "one" (js-array v)) (Object/is x undefined))
            (js-call a :release v))))
      (finish a))))

  (test "source arrays alone satisfy Array.isArray and objects use strict identity without conversion hooks" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (array (js-call a :sourceArray (js-array)))
           (refs (js-call a :array (js-array)))
           (record (js-call a :record (js-array)))
           (object (js-call a :sourceObject (js-object)))
           (other (js-call a :sourceObject (js-object)))
           (bytes (js-call a :bytes (new globalThis.Uint8Array)))
           (fn (js-call a :invoke "held")))
      (js-call (js-array array refs record object other bytes fn nil undefined false t) :forEach
        (lambda (v)
          (js-call (js-array "array" "array-alias") :forEach
            (lambda (name)
              (js-call assert :equal (js-call a :invoke name (js-array v)) (= v array))))
          (js-call assert :equal (js-call a :invoke "same" (js-array v v)) t)
          (js-call assert :equal (js-call a :invoke "same" (js-array v object)) (= v object))))
      (js-call a :collect)
      (let ((nan (js-call a :number globalThis.NaN)))
        (js-call assert :equal (js-call a :invoke "invoke" (js-array fn nan nan)) t)
        (finish a (js-array array refs record object other bytes fn nan))))))

  (test "predicate argument effects run once in order, extra values are ignored and no conversion hooks execute" (async ()
    (let* ((source "(module effects (defun run () (let* ((trace (js-object :n 0)) (x (js-object :valueOf (lambda () (put trace :n 999)) :toString (lambda () (put trace :n 999))))) (let ((result (Object/is (progn (put trace :n (+ (* (get trace :n) 10) 1)) x) (progn (put trace :n (+ (* (get trace :n) 10) 2)) x) (put trace :n (+ (* (get trace :n) 10) 3))))) (js-array result (get trace :n) (Array/isArray x (put trace :n 1234)) (get trace :n))))) (export run))")
           (c (await (compiled source)))
           (a (get c :a))
           (js (get c :js))
           (out (js-call a :invoke "run"))
           (expected (js-call js :run))
           (i 0))
      (while (< i (js-length expected))
        (let ((v (js-call a :get out i)))
          (js-call assert :equal (if (and v (= (get v :kind) 4)) (js-call a :readNumber v) v) (aref expected i))
          (js-call a :release v))
        (setq i (1+ i)))
      (finish a (js-array out)))))

  (test "Object.is matches randomized binary64 values, signed zero, separate NaN payloads and primitive types exactly" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (view (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
           (seed 2476874773)
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (i 0))
      (while (< i 2048)
        (js-call view :setUint32 0 (funcall next) t)
        (js-call view :setUint32 4 (funcall next) t)
        (let ((x (js-call view :getFloat64 0 t)))
          (js-call view :setUint32 0 (funcall next) t)
          (js-call view :setUint32 4 (funcall next) t)
          (let* ((y (if (not (= (% i 3) 0)) (js-call view :getFloat64 0 t) x))
                 (l (js-call a :number x))
                 (r (js-call a :number y)))
            (js-call assert :equal (js-call a :invoke "same" (js-array l r)) (Object/is x y))
            (js-call a :release l)
            (js-call a :release r)))
        (setq i (1+ i)))
      (let ((args (js-call a :sourceArray (js-array))))
        (js-call assert :equal (js-call a :invoke "apply-same" (js-array args)) t)
        (finish a (js-array args))))))

  (test "shadowed globals and ordinary predicate methods retain captured lookup, all arguments and nullish failure order" (async ()
    (let* ((source "(module shadows\n (defun factory () (lambda (&rest args) (js-length args)))\n (defun method (Object trace) (js-call Object :is (put trace :visited 1) (put trace :visited 2) (put Object :is false)))\n (defun raw (Object trace) (funcall (js* \"Object.is\") (put trace :visited 3)))\n (defun array-method (Array trace) (Array/isArray (put trace :visited 4)))\n (defun nested (globalThis x) (funcall (js* \"globalThis.Object.is\") x))\n (export factory method raw array-method nested))")
           (p (js-call (get b :compiler) :compile_ir_string (str "(defconst identity-marker 1)\n" source) "shadow.eli"))
           (entry (js-call (get b :compiler) :compile_ir_string "(module entry (import \"./shadow.mjs\" factory method raw array-method nested) (export factory method raw array-method nested))" "entry.eli"))
           (artifacts (js-array
                        (js-call (get b :managed) :emit_managed_wasm p runtime)
                        (js-call (get b :managed) :emit_managed_project_wasm
                          (js-array (js-object :id "shadow.mjs" :program p) (js-object :id "entry.mjs" :program entry))
                          "entry.mjs" runtime))))
      (js-call artifacts :forEach
        (lambda (bytes index)
          (let* ((a (instantiateManagedRuntime (Uint8Array/from bytes)))
                 (_ (js-call a :auto 1))
                 (fn (js-call a :invoke "factory"))
                 (object (js-call a :sourceObject (js-object :is fn :isArray fn)))
                 (trace (js-call a :sourceObject (js-object)))
                 (key (js-call a :string "visited"))
                 (out (js-call a :invoke "method" (js-array object trace))))
            (js-call assert :equal (js-call a :readNumber out) 3)
            (js-call a :release out)
            (let ((isKey (js-call a :string "is")))
              (js-call assert :equal (js-call a :objectGet object isKey) false)
              (js-call a :release isKey))
            (let ((valid (js-call a :invoke (if (not (= index 0)) "array_method" "array-method") (js-array object trace))))
              (js-call assert :equal (js-call a :readNumber valid) 1 (str "valid:" index))
              (js-call a :release valid))
            (js-call (js-array (js-array "array-method" "isArray" 4) (js-array "raw" "is" 3)) :forEach
              (lambda (spec)
                (let ((name (aref spec 0))
                      (value (aref spec 2)))
                  (js-call (js-array nil false) :forEach
                    (lambda (receiver)
                      (let ((effects (js-call a :sourceObject (js-object))))
                        (js-call assert :throws
                          (lambda () (js-call a :invoke (if (not (= index 0)) (js-call name :replaceAll "-" "_") name) (js-array receiver effects)))
                          (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0003")))))
                        (let ((seen (js-call a :objectGet effects key)))
                          (js-call assert :equal
                            (if (and seen (= (get seen :kind) 4)) (js-call a :readNumber seen) seen)
                            (if (nil? receiver) undefined value)
                            (str name ":" (globalThis.String receiver) ":" index))
                          (js-call a :release seen)
                          (js-call a :release effects))))))))
            (let* ((inner (js-call a :sourceObject (js-object :is fn)))
                   (host (js-call a :sourceObject (js-object :Object inner)))
                   (one (js-call a :number 1))
                   (value (js-call a :invoke "nested" (js-array host one))))
              (js-call assert :equal (js-call a :readNumber value) 1)
              (finish a (js-array fn object trace key inner host one value)))))))))

  (test "raw identity rejects invalid, stale, private and unsealed values without allocating or changing caller roots" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (js-call e "heap-new" 32 8192 8192))
             (call (lambda (n &rest args)
                     (let ((value (uint32 (Reflect/apply (get e n) e (js-call (js-array heap) :concat args)))))
                       (js-call assert :equal (js-call e "last-error") 0 n)
                       value)))
             (left (funcall call "value-number" 0 0))
             (negative (funcall call "value-number" 0 2147483648))
             (nan1 (funcall call "value-number" 1 2146435072))
             (nan2 (funcall call "value-number" 2271560481 4294443008))
             (frame (funcall call "frame-new" 4)))
        (js-call (js-array left negative nan1 nan2) :forEach
          (lambda (v i) (funcall call "frame-set" frame i v)))
        (funcall call "heap-auto" 1)
        (let ((used (funcall call "heap-used"))
              (collections (funcall call "heap-collections")))
          (js-call assert :equal (funcall call "value-object-is" left negative) 1)
          (js-call assert :equal (funcall call "value-object-is" nan1 nan2) 2)
          (js-call assert :equal (funcall call "heap-used") used)
          (js-call assert :equal (funcall call "heap-collections") collections))
        (let ((unsealed (funcall call "value-string" 1)))
          (funcall call "heap-pin" unsealed)
          (js-call (js-array (js-array 4294967295 1) (js-array frame 3)) :forEach
            (lambda (pair)
              (js-call assert :equal (js-call e "value-builtin-primitive" heap (aref pair 0) 1 5) 0)
              (js-call assert :equal (js-call e "last-error") (aref pair 1))
              (js-call assert :equal (funcall call "frame-depth") 1)))
          (js-call
            (js-array
              (js-array 4294967295 left 1) (js-array left 4294967295 1)
              (js-array frame left 3) (js-array left frame 3)
              (js-array unsealed left 6) (js-array left unsealed 6))
            :forEach
            (lambda (triple)
              (js-call assert :equal (js-call e "value-object-is" heap (aref triple 0) (aref triple 1)) 0)
              (js-call assert :equal (js-call e "last-error") (aref triple 2))
              (js-call assert :equal (funcall call "frame-depth") 1)
              (js-call assert :equal (funcall call "frame-get" frame 0) left)))
          (let ((stale (funcall call "value-number" 0 1073741824)))
            (funcall call "heap-collect")
            (js-call assert :equal (js-call e "value-object-is" heap stale left) 0)
            (js-call assert :equal (js-call e "last-error") 1)
            (funcall call "heap-release" unsealed)
            (funcall call "frame-pop" frame)
            (funcall call "heap-collect")
            (js-call assert :equal (funcall call "heap-live") 0)))))))

  (test "identity remains allocation-free at capacity while later source calls recover cleanly" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (heap (js-call e "heap-new" 8 4096 4096))
             (call (lambda (n &rest args)
                     (let ((value (uint32 (Reflect/apply (get e n) e (js-call (js-array heap) :concat args)))))
                       (js-call assert :equal (js-call e "last-error") 0 n)
                       value)))
             (held (js-array))
             (i 0))
        (while (< i 8)
          (let ((n (funcall call "value-number" i 1072693248)))
            (funcall call "heap-pin" n)
            (js-call held :push n))
          (setq i (1+ i)))
        (js-call assert :equal (js-call e "value-number" heap 0 0) 0)
        (js-call assert :equal (js-call e "last-error") 2)
        (js-call held :forEach
          (lambda (v)
            (js-call assert :equal (funcall call "value-object-is" v v) 2)
            (js-call assert :equal (funcall call "value-builtin-primitive" v 1 5) 1)))
        (js-call held :forEach (lambda (v) (funcall call "heap-release" v)))
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)
        (js-call assert :notEqual (funcall call "value-number" 0 0) 0)
        (funcall call "heap-collect")
        (js-call assert :equal (funcall call "heap-live") 0)))))

  (test "Node independently executes exact predicate bytes and compares randomized IEEE inputs" (async ()
    (let* ((c (await (compiled)))
           (a (get c :a))
           (bytes (get c :bytes)))
      (finish a)
      (let ((file (resolve directory "identity.wasm")))
        (await (writeFile file bytes))
        (let ((child (spawnSync "node"
                       (js-array (resolve "tests/helpers/wasm-managed-identity-node.mjs")
                                 (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                 file)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))))))

  (test "unimplemented reflection, mutable globals and raw executable JavaScript remain refused" (async ()
    (js-call
      (js-array
        "(defun f () (js* \"Object.seal\"))"
        "(defun f () (js* \"Object.is(0,-0)\"))"
        "(defun f () (js* \"Object.is /* comment */\"))"
        "(defun f () (put (js* \"Object\") :is false))")
      :forEach
      (lambda (source)
        (let ((p (js-call (get b :compiler) :compile_ir_string source "refusal.eli")))
          (js-call assert :throws
            (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
            (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-B0001"))))))))))

  (test "actual identity traps unwind source call frames while preserving argument effects and outer roots" (async ()
    (let* ((source "(defconst marker 1) (defun run (trace) (Object/is (put trace :visited t) t)) (export run)")
           (p (js-call (get b :compiler) :compile_ir_string source "identity-trap.eli"))
           (text (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
           (start (js-call text :indexOf "  (defun value-object-is "))
           (end (js-call text :indexOf "  ;; Ordinary strict equality" start)))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((injected (js-call (get b :compiler) :compile_ir_string
                         (str (js-call text :slice 0 start)
                              "  (defun value-object-is (heap left right) (load-u32 4294967295))\n"
                              (js-call text :slice end))
                         "trap.eli"))
             (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p injected))))
        (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (let* ((a (instantiateManagedRuntime bytes))
               (_ (js-call a :auto 1))
               (trace (js-call a :sourceObject (js-object)))
               (saved (js-call a :number -0.0))
               (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 saved)
          (js-call assert :throws
            (lambda () (js-call a :invoke "run" (js-array trace)))
            globalThis.WebAssembly.RuntimeError)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
          (let ((key (js-call a :string "visited")))
            (js-call assert :equal (js-call a :objectGet trace key) t)
            (js-call a :leaveFrame frame)
            (finish a (js-array trace saved key)))))))))
