(module
  tests.dogfood-action-test-ground
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile readdir rm writeFile)
  (import "node:path" dirname join posix resolve)
  (import "node:url" pathToFileURL)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    NODE
    (or (get (get globalThis.process :env) :NODE) "node"))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript"))
  (defconst
    PROJECT
    (resolve ROOT "examples/dogfood"))
  (defconst
    PACKAGE_TOOL
    (resolve PROJECT "tools/package.eli"))
  (defconst
    ENTRY
    (resolve PROJECT "dist/action/index.js"))
  (defconst
    ACTION
    (resolve PROJECT "dist/action"))
  (defconst
    ARTIFACT
    (resolve ACTION "artifact.json"))
  (defconst
    state
    (js-object :staging nil :tool nil :artifact nil))
  (defasync
    run
    (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let*
      ((opts (or options (js-object))) (cwd (or (get opts :cwd) ROOT)) (env (js-call globalThis.Object :assign (js-object) (get globalThis.process :env) (or (get opts :env) (js-object)) (js-object :GITHUB_WORKSPACE cwd))) (spawn-opts (js-call globalThis.Object :assign (js-object :cwd ROOT :stdout "pipe" :stderr "pipe") opts (js-object :env env))) (child (js-call globalThis.Bun :spawn command spawn-opts)) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2)))))
  (defconst
    CONFIG
    "(module demo.config\n  (defconst config\n    {:schema-version 1\n     :site {:title \"Action Demo\" :description \"Packaged build.\" :base-url \"https://example.github.io/demo/\" :language \"en\"}\n     :publishing {:owner {:login \"owner\"} :coauthors []}\n     :sources [{:id :local :kind :markdown :enabled t :directory \"content/posts\"}]\n     :identity {:conflict :fail :projections []}\n     :comments {:presentation :tabs :channels []}\n     :refresh {:articles :push :comments :runtime :no-change :skip}\n     :output {:directory \"_site\"}})\n  (export config))\n")
  (defun
    post
    (id slug title &rest __host_forwarded_arguments_2)
    (let* ((extra (aref __host_forwarded_arguments_2 0)))
    (let*
      ((extra-str (or extra "")))
      (str "---\nid: " id "\ntitle: " title "\ndate: 2026-09-15\ndescription: Demo summary for " slug ".\ntags: [demo]\nslug: " slug "\n" extra-str "---\n\nBody of **" title "**.\n\n## Section\n\n- one\n- two\n"))))
  (defasync
    consumer
    (files)
    (let*
      ((directory (await (mkdtemp (resolve (get state :staging) "consumer-")))) (entries (js-call globalThis.Object :entries files)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((pair (aref entries (get idx :i))) (relative (aref pair 0)) (content (aref pair 1)) (target (join directory relative)))
          (await (mkdir (dirname target) (js-object :recursive t)))
          (await (writeFile target content)))
        (put idx :i (+ (get idx :i) 1)))
      directory))
  (defun
    demoFiles
    (&rest __host_forwarded_arguments_3)
    (let* ((overrides (aref __host_forwarded_arguments_3 0)))
    (js-call globalThis.Object :assign (js-object "dogfood.config.eli" CONFIG "content/posts/0001-alpha.md" (post "notes/alpha" "alpha" "Alpha") "content/posts/0002-beta.md" (post "notes/beta" "beta" "Beta") "content/posts/0003-draft.md" (post "notes/draft" "draft" "Draft" "draft: true\n")) (or overrides (js-object)))))
  (defasync
    tree
    (root &rest __host_forwarded_arguments_4)
    (let* ((prefix (aref __host_forwarded_arguments_4 0)))
    (let*
      ((pref (or prefix "")) (entries (await (readdir (join root pref) (js-object :withFileTypes t)))) (files (js-array)) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((entry (aref entries (get idx :i))) (name (get entry :name)) (relative (if
                (= pref "")
                name
                (join pref name))))
          (if
            (js-call entry :isDirectory)
            (let*
              ((children (await (tree root relative))) (cidx (js-object :j 0)))
              (while
                (< (get cidx :j) (get children :length))
                (js-call files :push (aref children (get cidx :j)))
                (put cidx :j (+ (get cidx :j) 1))))
            (js-call files :push (js-call (js-call relative :split "\\") :join "/"))))
        (put idx :i (+ (get idx :i) 1)))
      (js-call files :sort))))
  (defun
    defaultRequiredFiles
    (directory)
    (js-call (js-array "action/artifact.json" "action/index.eli.map" "action/index.js" "action/index.js.map" "action/workflow.yml" "site/browser.js") :map (lambda (file) (str directory "/" file))))
  (defasync
    verifyIndexedPackage
    (repository directory &rest __host_forwarded_arguments_5)
    (let* ((requiredFiles (aref __host_forwarded_arguments_5 0)))
    (let*
      ((req (or requiredFiles (defaultRequiredFiles directory))) (workflow (str directory "/action/workflow.yml")) (indexed (await (run (js-array "git" "ls-files" "-z" "--" directory) (js-object :cwd repository)))) (indexed-list (js-call (js-call (js-call (get indexed :stdout) :split "\u0000") :filter (lambda (x) (not (not x)))) :sort)) (req-sorted (js-call (js-call globalThis.Array :from req) :sort)))
      (when
        (or (not= (get indexed :exitCode) 0) (not= (js-call globalThis.JSON :stringify indexed-list) (js-call globalThis.JSON :stringify req-sorted)))
        (throw (new globalThis.Error "indexed package inventory is incomplete or changed")))
      (let*
        ((compared (await (run (js-array "git" "diff" "--exit-code" "--" directory (str ":(exclude)" workflow)) (js-object :cwd repository)))))
        (when
          (not= (get compared :exitCode) 0)
          (throw (new globalThis.Error "reproduced package differs from the indexed artifacts"))))
      (let*
        ((untracked (await (run (js-array "git" "ls-files" "--others" "--exclude-standard" "-z" "--" directory) (js-object :cwd repository)))) (has-extra (js-call (js-call (get untracked :stdout) :split "\u0000") :some (lambda (file) (and (not (not file)) (not= file workflow))))))
        (when
          (or (not= (get untracked :exitCode) 0) has-extra)
          (throw (new globalThis.Error "reproduced package contains untracked artifacts")))))))
  (defun
    extract-yaml-block
    (text key)
    (let*
      ((folded-re (new globalThis.RegExp (str "^" key ": >-\\n((?:  .*\\n)+)") "m")) (folded-match (js-call folded-re :exec text)))
      (if
        folded-match
        (js-call (js-call (js-call (js-call (aref folded-match 1) :split "\n") :map (lambda (line) (js-call line :trim))) :join " ") :trim)
        (let*
          ((line-re (new globalThis.RegExp (str "^" key ": (.+)$") "m")) (line-match (js-call line-re :exec text)))
          (if
            line-match
            (js-call (aref line-match 1) :trim)
            "")))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-action-")))) (tool (resolve staging "package.mjs")) (__ign_9 (put state :staging staging)) (__ign_10 (put state :tool tool)) (compiled (await (run (js-array COMPILER "--output" tool PACKAGE_TOOL)))))
        (when
          (not= (get compiled :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get compiled :stderr) :trim) (js-call (get compiled :stdout) :trim)))))
        (let*
          ((browser (await (run (js-array "bun" "run" "build:dogfood-browser")))))
          (when
            (not= (get browser :exitCode) 0)
            (throw (new globalThis.Error (or (js-call (get browser :stderr) :trim) (js-call (get browser :stdout) :trim)))))
          (let*
            ((packaged (await (run (js-array NODE tool "--root" ROOT)))))
            (when
              (not= (get packaged :exitCode) 0)
              (throw (new globalThis.Error (or (js-call (get packaged :stderr) :trim) (js-call (get packaged :stdout) :trim)))))
            (put state :artifact (js-call globalThis.JSON :parse (await (readFile ARTIFACT "utf8")))))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "the Action tests use a supported Node host" (async () (let*
        ((result (await (run (js-array NODE "-p" "JSON.stringify({bun:typeof Bun,major:Number(process.versions.node.split('.')[0])})")))) (__ign_11 (js-call (expect (get result :exitCode)) :toBe 0)) (host (js-call globalThis.JSON :parse (get result :stdout))))
        (js-call (expect (get host :bun)) :toBe "undefined")
        (js-call (expect (get host :major)) :toBeGreaterThanOrEqual 24))))
  (test "the packaging tool emits one CommonJS Node entry" (async () (let*
        ((bundle (await (readFile ENTRY "utf8"))))
        (js-call (expect (js-call (new globalThis.RegExp "^import\\s" "m") :test bundle)) :toBe false)
        (js-call (expect (js-call (new globalThis.RegExp "^export\\s" "m") :test bundle)) :toBe false)
        (js-call (expect bundle) :toContain "require(")
        (js-call (expect (get bundle :length)) :toBeGreaterThan 50000))))
  (test "action.yml declares the documented Action contract" (async () (let*
        ((metadata (js-call (get globalThis.Bun :YAML) :parse (await (readFile (resolve PROJECT "action.yml") "utf8")))))
        (js-call (expect (get metadata :name)) :toBe "Dogfood Site Generator")
        (js-call (expect (get metadata :runs)) :toEqual (js-object :using "node24" :main "dist/action/index.js"))
        (js-call (expect (js-call globalThis.Object :keys (get metadata :inputs))) :toEqual (js-array "config-file" "output-directory" "force" "github-token" "event-file" "preview" "previous-manifest"))
        (js-call (expect (js-call globalThis.Object :keys (get metadata :outputs))) :toEqual (js-array "built" "reason" "content-fingerprint" "output-directory" "post-count" "comment-snapshot-count" "manifest" "subject" "cache-key"))
        (let*
          ((entry-content (await (readFile (resolve PROJECT (get (get metadata :runs) :main)) "utf8"))))
          (js-call (expect entry-content) :toContain "require(")))))
  (test "the committed package reproduces from source" (async () (await (verifyIndexedPackage ROOT "examples/dogfood/dist")) (let*
        ((template (await (readFile (resolve PROJECT "dist/action/workflow.yml") "utf8"))) (match (js-call (new globalThis.RegExp "uses: liuchong/eliscript/examples/dogfood@([0-9a-f]{40})" "u") :exec template)) (pin (when
              match
              (aref match 1))))
        (js-call (expect pin) :toBeTruthy)
        (let*
          ((pinned (await (run (js-array "git" "cat-file" "-e" (str pin ":examples/dogfood/dist/action/index.js"))))))
          (js-call (expect (get pinned :exitCode)) :toBe 0)))))
  (test "package reproduction verifies staged bytes and rejects unstaged, missing and untracked artifacts" (async () (let*
        ((repository (await (mkdtemp (resolve (get state :staging) "indexed-")))) (artifact-rel "package/action/index.js") (verify (lambda () (verifyIndexedPackage repository "package" (js-array artifact-rel)))))
        (await (mkdir (join repository "package/action") (js-object :recursive t)))
        (js-call (expect (get (await (run (js-array "git" "init" "--quiet") (js-object :cwd repository))) :exitCode)) :toBe 0)
        (await (writeFile (join repository artifact-rel) "first\n"))
        (js-call (expect (get (await (run (js-array "git" "add" artifact-rel) (js-object :cwd repository))) :exitCode)) :toBe 0)
        (await (verify))
        (await (writeFile (join repository artifact-rel) "changed\n"))
        (await (js-call (get (expect (verify)) :rejects) :toThrow "reproduced package differs"))
        (js-call (expect (get (await (run (js-array "git" "add" artifact-rel) (js-object :cwd repository))) :exitCode)) :toBe 0)
        (await (verify))
        (await (rm (join repository artifact-rel)))
        (await (js-call (get (expect (verify)) :rejects) :toThrow "reproduced package differs"))
        (await (writeFile (join repository artifact-rel) "changed\n"))
        (await (writeFile (join repository "package/action/extra.js") "untracked\n"))
        (await (js-call (get (expect (verify)) :rejects) :toThrow "untracked artifacts"))
        (js-call (expect (get (await (run (js-array "git" "rm" "--cached" artifact-rel) (js-object :cwd repository))) :exitCode)) :toBe 0)
        (await (js-call (get (expect (verify)) :rejects) :toThrow "indexed package inventory")))))
  (test "the metadata satisfies the marketplace limits" (async () (let*
        ((text (await (readFile (resolve PROJECT "action.yml") "utf8"))) (name (extract-yaml-block text "name")) (description (extract-yaml-block text "description")) (icon-match (js-call (new globalThis.RegExp "icon: (\\S+)") :exec text)) (color-match (js-call (new globalThis.RegExp "color: (\\S+)") :exec text)))
        (js-call (expect (get description :length)) :toBeLessThan 125)
        (js-call (expect (get name :length)) :toBeLessThanOrEqual 50)
        (js-call (expect (when
              icon-match
              (aref icon-match 1))) :toBeTruthy)
        (js-call (expect (when
              color-match
              (aref color-match 1))) :toBeTruthy))))
  (test "the artifact manifest binds every source and the bundle" (async () (let*
        ((artifact (get state :artifact)) (sources (get artifact :sources)) (idx (js-object :i 0)))
        (js-call (expect (get artifact :format)) :toBe "dogfood-action-artifact")
        (js-call (expect (get artifact :version)) :toBe 1)
        (js-call (expect (get artifact :runtime)) :toBe "node24")
        (js-call (expect (get sources :length)) :toBeGreaterThanOrEqual 10)
        (while
          (< (get idx :i) (get sources :length))
          (let*
            ((source (aref sources (get idx :i))))
            (js-call (expect (get source :path)) :toMatch (new globalThis.RegExp "^src/.*[.]eli$" "u"))
            (js-call (expect (get source :sha256)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u")))
          (put idx :i (+ (get idx :i) 1)))
        (js-call (expect (get artifact :entrySha256)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))
        (js-call (expect (get artifact :entryBytes)) :toBeGreaterThan 50000)
        (js-call (expect (get artifact :browserEntry)) :toContain "dist/site/browser.js")
        (js-call (expect (get artifact :browserSha256)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u"))
        (js-call (expect (get artifact :browserBytes)) :toBeGreaterThan 5000)
        (js-call (expect (get artifact :workflow)) :toBe "workflow.yml")
        (js-call (expect (get artifact :sourceMap)) :toBe "index.js.map")
        (js-call (expect (get artifact :eliscriptSourceMap)) :toBe "index.eli.map")
        (let*
          ((eliMap (js-call globalThis.JSON :parse (await (readFile (join ACTION "index.eli.map") "utf8")))))
          (js-call (expect (js-call (get eliMap :sources) :some (lambda (s) (js-call s :endsWith ".eli")))) :toBe t)
          (js-call (expect (js-call (get eliMap :sources) :every (lambda (s) (not (js-call s :startsWith "/"))))) :toBe t)))))
  (test "the bundle carries no credential shape or host path" (async () (let*
        ((bundle (await (readFile ENTRY "utf8"))) (patterns (js-array "/Users/" "/home/" "ghp_" "github_pat_" "-----BEGIN")) (idx (js-object :i 0)))
        (while
          (< (get idx :i) (get patterns :length))
          (js-call (expect (js-call bundle :includes (aref patterns (get idx :i)))) :toBe false)
          (put idx :i (+ (get idx :i) 1))))))
  (test "artifact scans reject forbidden text and live tokens throughout Unicode strings" (async () (let*
        ((staging (get state :staging)) (source (resolve staging "scan.eli")) (module-path (resolve staging "scan.mjs")) (text (await (readFile PACKAGE_TOOL "utf8"))) (__ign_12 (await (writeFile source (js-call text :replace (new globalThis.RegExp "\\(main\\)\\)\\s*$" "u") "(export assert-clean))")))) (compiled (await (run (js-array COMPILER "--output" module-path source)))))
        (js-call (expect (get compiled :exitCode)) :toBe 0)
        (let*
          ((mod (await (funcall (js* "(u) => import(u)") (get (pathToFileURL module-path) :href)))) (scan (get mod :assert_clean)) (env (get globalThis.process :env)) (had-token (js-call globalThis.Object :hasOwn env "GITHUB_TOKEN")) (prev-token (get env :GITHUB_TOKEN)) (padding (js-call "😀safe𝄞" :repeat 20000)) (expect-code (lambda (val label expected-code) (let*
                  ((caught (try
                        (progn
                          (scan val label)
                          nil)
                        (catch
                          err
                          err))))
                  (js-call (expect (when
                        caught
                        (get caught :code))) :toBe expected-code)))))
          (try
            (progn
              (put env :GITHUB_TOKEN "eliscript-scan-fixture-token")
              (scan "" "empty")
              (scan "😀INPUT_GITHUB_TOKEN𝄞" "allowed")
              (let*
                ((patterns (js-array "/Users/" "/home/" "ghp_" "github_pat_" "-----BEGIN" (get env :GITHUB_TOKEN))) (pidx (js-object :i 0)))
                (while
                  (< (get pidx :i) (get patterns :length))
                  (let*
                    ((pattern (aref patterns (get pidx :i))) (expected (if
                          (= pattern (get env :GITHUB_TOKEN))
                          "DOGFOOD-PACKAGE-005"
                          "DOGFOOD-PACKAGE-002")) (variants (js-array (str pattern padding) (str padding pattern padding) (str padding pattern))) (vidx (js-object :j 0)))
                    (while
                      (< (get vidx :j) (get variants :length))
                      (expect-code (aref variants (get vidx :j)) "fixture" expected)
                      (put vidx :j (+ (get vidx :j) 1))))
                  (put pidx :i (+ (get pidx :i) 1))))
              (put env :GITHUB_TOKEN "eliscript-令牌-😀")
              (let*
                ((tok (get env :GITHUB_TOKEN)) (variants (js-array (str tok padding) (str padding tok padding) (str padding tok))) (vidx (js-object :j 0)))
                (while
                  (< (get vidx :j) (get variants :length))
                  (expect-code (aref variants (get vidx :j)) "Unicode token" "DOGFOOD-PACKAGE-005")
                  (put vidx :j (+ (get vidx :j) 1))))
              (put env :GITHUB_TOKEN "")
              (scan "😀ordinary text𝄞" "empty token")
              (js-call globalThis.Reflect :deleteProperty env :GITHUB_TOKEN)
              (scan "eliscript-scan-fixture-token" "unset token")
              (let*
                ((near-misses (js-array "/User/" "/hom/" "ghp" "github_pat" "----BEGIN")) (nidx (js-object :k 0)))
                (while
                  (< (get nidx :k) (get near-misses :length))
                  (scan (aref near-misses (get nidx :k)) "literal near miss")
                  (put nidx :k (+ (get nidx :k) 1)))))
            (finally
              (if
                had-token
                (put env :GITHUB_TOKEN prev-token)
                (js-call globalThis.Reflect :deleteProperty env :GITHUB_TOKEN))))))))
  (test "rebuilding the bundle is byte-identical" (async () (let*
        ((before (await (readFile ENTRY))) (rebuilt (await (run (js-array NODE (get state :tool) "--root" ROOT)))) (__ign_13 (js-call (expect (get rebuilt :exitCode)) :toBe 0)) (after (await (readFile ENTRY))))
        (js-call (expect (js-call after :equals before)) :toBe t))))
  (test "the packaged Action builds a consumer project on Node" (async () (let*
        ((directory (await (consumer (demoFiles)))) (outputFile (join directory "github-output.txt")) (result (await (run (js-array NODE ENTRY) (js-object :cwd directory :env (js-call globalThis.Object :assign (js-object) (get globalThis.process :env) (js-object :GITHUB_OUTPUT outputFile)))))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (js-call (expect (get result :stdout)) :toContain "routes")
        (let*
          ((files (await (tree (join directory "_site")))) (expected-list (js-array "index.html" "archive/index.html" "tags/index.html" "posts/alpha/index.html" "posts/beta/index.html" "search.json" "feed.xml" "sitemap.xml" "robots.txt" "search/index.html" "assets/site.css" "assets/browser.js" "_dogfood/build.json")) (idx (js-object :i 0)))
          (while
            (< (get idx :i) (get expected-list :length))
            (js-call (expect files) :toContain (aref expected-list (get idx :i)))
            (put idx :i (+ (get idx :i) 1)))
          (js-call (get (expect files) :not) :toContain "posts/draft/index.html")
          (let*
            ((index (await (readFile (join directory "_site/index.html") "utf8"))) (outputs (await (readFile outputFile "utf8"))))
            (js-call (expect index) :toContain "Action Demo")
            (js-call (expect outputs) :toContain "built=true")
            (js-call (expect outputs) :toContain "reason=changed")
            (js-call (expect outputs) :toContain "post-count=2")
            (js-call (expect outputs) :toContain "comment-snapshot-count=0")
            (js-call (expect outputs) :toMatch (new globalThis.RegExp "content-fingerprint=[0-9a-f]{64}" "u")))))))
  (test "every relative link in the packaged output resolves" (async () (let*
        ((directory (await (consumer (demoFiles)))) (result (await (run (js-array NODE ENTRY) (js-object :cwd directory)))))
        (js-call (expect (get result :exitCode)) :toBe 0)
        (let*
          ((root (join directory "_site")) (file-list (await (tree root))) (files (new globalThis.Set file-list)) (broken (js-array)) (idx (js-object :i 0)))
          (while
            (< (get idx :i) (get file-list :length))
            (let*
              ((relative (aref file-list (get idx :i))))
              (when
                (js-call relative :endsWith ".html")
                (let*
                  ((text (await (readFile (join root relative) "utf8"))) (matches (js-call globalThis.Array :from (js-call text :matchAll (new globalThis.RegExp "(?:href|src)=\"([^\"]+)\"" "gu")))) (midx (js-object :j 0)))
                  (while
                    (< (get midx :j) (get matches :length))
                    (let*
                      ((match (aref matches (get midx :j))) (target (aref match 1)))
                      (when
                        (not (js-call (new globalThis.RegExp "^(?:https?:|mailto:|#|data:)" "u") :test target))
                        (let*
                          ((base (js-call posix :dirname relative)) (resolved (if
                                (js-call target :endsWith "/")
                                (js-call posix :normalize (js-call posix :join base target "index.html"))
                                (js-call posix :normalize (js-call posix :join base target)))))
                          (when
                            (not (js-call files :has resolved))
                            (js-call broken :push (str relative " -> " target))))))
                    (put midx :j (+ (get midx :j) 1))))))
            (put idx :i (+ (get idx :i) 1)))
          (js-call (expect broken) :toEqual (js-array))))))
  (test "configuration that is not closed data is rejected" (async () (let*
        ((directory (await (consumer (demoFiles (js-object "dogfood.config.eli" "(module demo.config\n  (defconst config\n    {:schema-version 1\n     :site {:title \"T\" :base-url \"https://example.github.io/d/\"\n            :description (str \"not-closed-data\")}\n     :sources [{:id :local :kind :markdown :enabled t :directory \"content/posts\"}]\n     :output {:directory \"_site\"}})\n  (export config))\n"))))) (result (await (run (js-array NODE ENTRY) (js-object :cwd directory)))))
        (js-call (expect (get result :exitCode)) :toBe 1)
        (js-call (expect (get result :stdout)) :toContain "DOGFOOD-CONFIG-005"))))
  (test "an unknown configuration key is rejected" (async () (let*
        ((directory (await (consumer (demoFiles (js-object "dogfood.config.eli" (js-call CONFIG :replace ":schema-version 1" ":schema-version 1\n     :unexpected t")))))) (result (await (run (js-array NODE ENTRY) (js-object :cwd directory)))))
        (js-call (expect (get result :exitCode)) :toBe 1)
        (js-call (expect (get result :stdout)) :toContain "DOGFOOD-CONFIG-006"))))
  (test "a missing config file is reported, not crashed" (async () (let*
        ((directory (await (consumer (js-object "content/posts/0001-alpha.md" (post "notes/alpha" "alpha" "Alpha"))))) (result (await (run (js-array NODE ENTRY) (js-object :cwd directory)))))
        (js-call (expect (get result :exitCode)) :toBe 1)
        (js-call (expect (get result :stdout)) :toContain "dogfood:")))))
