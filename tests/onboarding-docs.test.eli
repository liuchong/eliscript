(module tests.onboarding-docs.test
  (import "bun:test" expect test)
  (import "node:fs/promises" cp mkdtemp readFile realpath rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve join)
  (import "node:process" :default process)
  (import "../tools/documentation/check.mjs" checkDocumentation DocumentationValidationError)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst EXAMPLE (join ROOT "examples/getting-started"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun contains (actual expected) (js-call (expect actual) :toContain expected))
  (defun nullDefault (value fallback) (if (nullish? value) fallback value))
  (defun command (name) (join ROOT "bin" name))
  (defasync eachAsync (items operation) (let ((index 0)) (while (< index (get items :length)) (await (funcall operation (aref items index))) (setq index (1+ index)))))
  (defasync readJson (relative) (JSON/parse (await (readFile (join ROOT relative) "utf8"))))
  (defasync documentationErrors (contract)
    (let ((failed false) (errors undefined))
      (try (await (checkDocumentation (js-object :root ROOT :contract contract)))
        (catch error (js-call (expect error) :toBeInstanceOf DocumentationValidationError) (setq failed t) (setq errors (get error :errors))))
      (if failed errors (throw (new globalThis.Error "expected documentation validation to fail")))))
  (defasync run (command &rest __host_default_arguments_1)
    (let* ((options (aref __host_default_arguments_1 0)))
    (when (= options undefined) (setq options (js-object)))
    (let* ((child (Bun/spawn command (js-object :cwd (nullDefault (get options :cwd) ROOT) :env (nullDefault (get options :env) (get process :env))
             :stdin (if (= (get options :stdin) undefined) "ignore" "pipe") :stdout "pipe" :stderr "pipe")))
           (forceKillTimer undefined) (timer (globalThis.setTimeout (lambda () (js-call child :kill "SIGTERM")
             (setq forceKillTimer (globalThis.setTimeout (lambda () (js-call child :kill "SIGKILL")) 2000))) (nullDefault (get options :timeoutMs) 15000))))
      (unless (= (get options :stdin) undefined) (js-call (get child :stdin) :write (get options :stdin)) (js-call (get child :stdin) :end))
      (try
        (let* ((items (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))))
               (exitCode (aref items 0)) (stdout (aref items 1)) (stderr (aref items 2)))
          (when (and (not (get options :allowFailure)) (not (= exitCode 0)))
            (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
              (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str (aref command 0) " exited with " exitCode)))))))
          (js-object :exitCode exitCode :stdout stdout :stderr stderr))
        (finally (globalThis.clearTimeout timer) (globalThis.clearTimeout forceKillTimer))))))
  (test "onboarding guide covers every maintained workflow and failure class" (async ()
    (let ((report (await (checkDocumentation (js-object :root ROOT)))) (guide (await (readFile (join ROOT "docs/getting-started.md") "utf8"))))
      (js-call (expect report) :toEqual (js-object "schemaVersion" 1 "format" "eliscript-documentation-report" "version" 2 "documents" 11 "sections" 72 "requiredLiterals" 59 "localLinks" 47 "snippets" 5 "executions" 8 "entryPoints" 12 "applicationsContribute" false))
      (await (eachAsync (js-array (js-array "eliscript.json" "json") (js-array "src/math.eli" "elisp") (js-array "src/main.eli" "elisp")) (async (entry)
        (let ((file (aref entry 0)) (language (aref entry 1)))
          (contains guide (str "```" language "\n" (await (readFile (join EXAMPLE file) "utf8")) "```")))))))
    (let* ((contract (await (readJson "contracts/documentation.json"))) (missingSection (funcall globalThis.structuredClone contract))
           (reorderedSections (funcall globalThis.structuredClone contract)) (missingText (funcall globalThis.structuredClone contract))
           (replacedDocument (funcall globalThis.structuredClone contract)) (missingEntryPoint (funcall globalThis.structuredClone contract)))
      (put (get (aref (get missingSection :documents) 0) :requiredSections) 0 "Missing installation stage")
      (contains (await (documentationErrors missingSection)) "docs/getting-started.md is missing section: Missing installation stage")
      (let* ((sections (get (aref (get reorderedSections :documents) 0) :requiredSections)) (first (aref sections 0)) (second (aref sections 1)))
        (put sections 0 second) (put sections 1 first))
      (contains (await (documentationErrors reorderedSections)) "docs/getting-started.md section is out of contract order: Supported Environment")
      (put (get (aref (get missingText :documents) 0) :requiredLiterals) 0 "missing-public-command")
      (contains (await (documentationErrors missingText)) "docs/getting-started.md is missing required text: missing-public-command")
      (put (aref (get replacedDocument :documents) 0) :file "docs/missing-guide.md")
      (contains (aref (await (documentationErrors replacedDocument)) 0) "documents must contain the exact ordered AC-23 core inventory")
      (put (aref (get missingEntryPoint :entryPoints) 0) :literal "missing-guide-link")
      (contains (await (documentationErrors missingEntryPoint)) "README.md is missing documentation entry point: missing-guide-link"))))
  (test "core documentation rejects broken links and changed executable snippets" (async ()
    (let* ((languageFile "docs/language-reference.md") (language (await (readFile (join ROOT languageFile) "utf8"))))
      (await (js-call (get (expect (checkDocumentation (js-object :root ROOT :sourceOverrides (Object/fromEntries (js-array (js-array languageFile (str language "\n[missing](missing-reference.md)\n"))))))) :rejects)
        :toThrow (str languageFile " has broken local link: missing-reference.md")))
      (await (js-call (get (expect (checkDocumentation (js-object :root ROOT :sourceOverrides (Object/fromEntries (js-array (js-array languageFile (js-call language :replace "(nth 1 values)" "(nth 0 values)"))))))) :rejects)
        :toThrow "language-values/bun failed")))))
  (test "core documentation rejects application inventory substitution" (async ()
    (let ((contract (await (readJson "contracts/documentation.json"))))
      (put (aref (get contract :documents) 1) :file "examples/README.md")
      (contains (await (documentationErrors contract)) "documents must contain the exact ordered AC-23 core inventory"))))
  (test "documented checkout project workflow and editor setup execute end to end" (async ()
    (let* ((temporaryRoot (await (realpath (await (mkdtemp (join (tmpdir) "eliscript-onboarding-"))))))
           (project (join temporaryRoot "hello-eliscript")) (sourceRoot (join project "src")))
      (try (await (cp EXAMPLE project (js-object :recursive t)))
        (let ((mathSource (await (readFile (join sourceRoot "math.eli") "utf8"))) (mainSource (await (readFile (join sourceRoot "main.eli") "utf8"))))
          (be (get (await (run (js-array (command "eliscript-format") "src/math.eli") (js-object :cwd project))) :stdout) mathSource)
          (be (get (await (run (js-array (command "eliscript-format") "src/main.eli") (js-object :cwd project))) :stdout) mainSource)
          (await (run (js-array (command "eliscript-format") "--check" "src/math.eli") (js-object :cwd project)))
          (await (run (js-array (command "eliscript-format") "--check" "src/main.eli") (js-object :cwd project))))
        (let* ((checked (await (run (js-array (command "eliscript-check") "--json" "--config" "eliscript.json") (js-object :cwd project)))) (checkReport (JSON/parse (get checked :stdout))))
          (be (get checkReport :format) "eliscript-check-report") (js-call (expect (js-call (get checkReport :modules) :map (lambda (module) (get module :source)))) :toEqual (js-array "main.eli" "math.eli")))
        (let* ((built (await (run (js-array (command "eliscript-build") "--json" "--config" "eliscript.json") (js-object :cwd project)))) (buildReport (JSON/parse (get built :stdout))))
          (be (get buildReport :format) "eliscript-build-report") (be (get buildReport :entryOutput) "main.mjs")
          (be (js-call (get (await (run (js-array "bun" "run" "dist/main.mjs") (js-object :cwd project))) :stdout) :trim) "42"))
        (let ((nodeBuild (await (run (js-array (command "eliscript-build") "--no-cache" "--config" "eliscript.json" "--out-dir" "dist-node")
          (js-object :cwd project :env (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_JS_RUNTIME "node")))))))
          (be (js-call (get nodeBuild :stdout) :trim) (join project "dist-node/main.mjs"))
          (be (js-call (get (await (run (js-array "node" "dist-node/main.mjs") (js-object :cwd project))) :stdout) :trim) "42"))
        (let ((diagnostic (await (run (js-array (command "eliscript-check") "--json" "--config" "eliscript.json" "--stdin-file" (join sourceRoot "main.eli") "--diagnostic-format" "json")
          (js-object :cwd project :stdin "(module hello.main (print missing))\n" :allowFailure t)))))
          (js-call (get (expect (get diagnostic :exitCode)) :not) :toBe 0) (be (get (JSON/parse (get diagnostic :stderr)) :code) "ELI-A0001"))
        (let ((evaluation (JSON/parse (get (await (run (js-array (command "eliscript-eval") "--eval" "(+ 20 22)" "--root" project "--json"))) :stdout))))
          (js-call (expect evaluation) :toMatchObject (js-object :format "eliscript-evaluation-result" :status "ok" :value "42")))
        (be (get (await (run (js-array (command "eliscript-eval") "--repl" "--root" project "--no-prompt")
          (js-object :stdin "(defconst answer 42)\nanswer\n:quit\n"))) :stdout) "42\n42\n")
        (let* ((editor (join ROOT "editor"))
               (expression (str "(progn (add-to-list 'load-path " (JSON/stringify editor) ") (require 'eliscript-mode)"
                 " (with-temp-buffer (setq buffer-file-name \"example.eli\") (set-auto-mode)"
                 " (unless (eq major-mode 'eliscript-mode) (error \"Eliscript auto mode is not registered\"))))")))
          (await (run (js-array "emacs" "--batch" "-Q" "--eval" expression))))
        (finally (await (rm temporaryRoot (js-object :recursive t :force t))))))) 30000)
)
