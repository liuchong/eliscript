(module tests.wasm-managed-native-prototype-callables.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst js-instanceof (js* "(a, b) => a instanceof b"))
  (defconst node-helper (resolve "tests/helpers/wasm-managed-native-prototype-callables-node.mjs"))

  (defconst boxed-steps (js-array))
  (defconst progress-exports (js-array "boxed-progress-low" "boxed-progress-middle" "boxed-progress-high"))
  (defconst immediate-source (js-array "nil" "false" "t" "undefined"))

  (defun boxed-progress (label)
    (let ((code (get boxed-steps :length)))
      (when (>= code 64)
        (throw (new globalThis.Error "boxed progress exceeds the immediate-only diagnostic code space")))
      (let ((marker (str "; boxed operation: " label)))
        (js-call boxed-steps :push (js-object :label label :marker marker))
        (str "(setq boxed-progress-low " (aref immediate-source (% code 4)) "\n"
             "    boxed-progress-middle " (aref immediate-source (% (Math/floor (/ code 4)) 4)) "\n"
             "    boxed-progress-high " (aref immediate-source (% (Math/floor (/ code 16)) 4)) ") " marker "\n"))))

  (defun boxed-step (label expression)
    (str "(progn " (boxed-progress label) expression ")"))

  (defun boxed-after (label expression)
    (str "(let ((boxed-observation " expression ")) " (boxed-progress label) "boxed-observation)"))

  (defconst boxed-final-element
    (boxed-after "allocate the original observation array"
      (boxed-step "catch the deliberate Number.valueOf wrong-brand call"
        "(try (js-call (get np :valueOf) :call string) (catch error (get error :name)))")))

  (defconst boxed-observations
    (boxed-after "call the captured JSON.stringify with the original observation array"
      (str "(js-array\n"
           "    " (boxed-step "Number.prototype.valueOf.call(number)" "(js-call (get np :valueOf) :call number)") "\n"
           "    " (boxed-step "Number.prototype.toString.call(number,16)" "(js-call (get np :toString) :call number 16)") "\n"
           "    " (boxed-step "Boolean.prototype.valueOf.call(boolean)" "(js-call (get bp :valueOf) :call boolean)") "\n"
           "    " (boxed-step "String.prototype.valueOf.call(string)" "(js-call (get sp :valueOf) :call string)") "\n"
           "    " (boxed-step "Object.keys of the boxed UTF16 string" "(Object/keys string)") "\n"
           "    " (boxed-step "read boxed string length descriptor value" "(get length :value)") "\n"
           "    " (boxed-step "read boxed string length descriptor writable" "(get length :writable)") "\n"
           "    " (boxed-step "read boxed string length descriptor configurable" "(get length :configurable)") "\n"
           "    " (boxed-step "read boxed string index descriptor value" "(get index :value)") "\n"
           "    " (boxed-step "read boxed string index descriptor writable" "(get index :writable)") "\n"
           "    " (boxed-step "read boxed string index descriptor enumerable" "(get index :enumerable)") "\n"
           "    " (boxed-step "read boxed string index descriptor configurable" "(get index :configurable)") "\n"
           "    " (boxed-step "BigInt.prototype.toString.call(bigint)" "(js-call (get ip :toString) :call bigint)") "\n"
           "    " (boxed-step "Symbol.prototype.description getter.call(symbol)" "(js-call description :call symbol)") "\n"
           "    " (boxed-step "Symbol.prototype.toString.call(symbol)" "(js-call (get yp :toString) :call symbol)") "\n"
           "    " boxed-final-element ")")))

  (defconst source
    (str "\n"
      "(defvar boxed-progress-low nil)\n"
      "(defvar boxed-progress-middle nil)\n"
      "(defvar boxed-progress-high nil)\n"
      "(defun plus-offset (value index receiver) (+ value (get (js* \"this\") :offset)))\n"
      "(defun visit-collection (value key receiver)\n"
      "  (js-call (get (js* \"this\") :trace) :push (js-array value key (Object/is receiver (get (js* \"this\") :owner)))))\n"
      "(defun array-callables ()\n"
      "  (let* ((prototype (get globalThis/Array :prototype))\n"
      "         (map (get prototype :map)) (slice (get prototype :slice))\n"
      "         (object (js-object :0 3 :2 7 :length 4))\n"
      "         (out (js-call map :call object plus-offset (js-object :offset 10)))\n"
      "         (descriptor (Object/getOwnPropertyDescriptor prototype \"map\")))\n"
      "    (JSON/stringify (js-array out (Object/hasOwn out \"1\")\n"
      "      (js-call slice :call \"A😀Z\" 1 3)\n"
      "      (Object/is (get prototype (get globalThis/Symbol :iterator)) (get prototype :values))\n"
      "      (get map :name) (get map :length) (get descriptor :writable)\n"
      "      (get descriptor :enumerable) (get descriptor :configurable)))))\n"
      "(defun collections ()\n"
      "  (let* ((map (new globalThis/Map (js-array (js-array \"a\" 1) (js-array \"b\" 2))))\n"
      "         (set (new globalThis/Set (js-array 1 2 1)))\n"
      "         (mp (get globalThis/Map :prototype)) (sp (get globalThis/Set :prototype))\n"
      "         (trace (js-array)) (context (js-object :trace trace :owner map))\n"
      "         (foreach (get mp :forEach)) (has (get mp :has))\n"
      "         (size (get (Object/getOwnPropertyDescriptor mp \"size\") :get)))\n"
      "    (js-call foreach :call map visit-collection context)\n"
      "    (JSON/stringify (js-array (js-call has :call map \"a\") (js-call size :call map)\n"
      "      (get set :size) trace (Object/is (get sp :keys) (get sp :values))\n"
      "      (Object/is (get sp (get globalThis/Symbol :iterator)) (get sp :values))\n"
      "      (try (js-call (get sp :add) :call map 9) (catch error (get error :name)))\n"
      "      (js-call (get (get globalThis/Object :prototype) :toString) :call map)))))\n"
      "(defun weak-collections ()\n"
      "  (let* ((key (js-object)) (map (new globalThis/WeakMap (js-array (js-array key 9))))\n"
      "         (set (new globalThis/WeakSet (js-array key)))\n"
      "         (get (get (get globalThis/WeakMap :prototype) :get))\n"
      "         (has (get (get globalThis/WeakSet :prototype) :has)))\n"
      "    (JSON/stringify (js-array (js-call get :call map key) (js-call has :call set key)\n"
      "      (js-call has :call set 1) (js-call (get (get globalThis/WeakMap :prototype) :delete) :call map key)\n"
      "      (js-call get :call map key)))))\n"
      "(defun iterators ()\n"
      "  (let* ((map (new globalThis/Map (js-array (js-array \"a\" 1))))\n"
      "         (iterator (js-call map :entries)) (next (get iterator :next))\n"
      "         (first (js-call next :call iterator)))\n"
      "    (js-call map :set \"b\" 2)\n"
      "    (let ((second (js-call next :call iterator)) (done (js-call next :call iterator)))\n"
      "      (js-call map :set \"c\" 3)\n"
      "      (JSON/stringify (js-array first second done (js-call next :call iterator)\n"
      "        (Object/is (js-call (get iterator (get globalThis/Symbol :iterator)) :call iterator) iterator)\n"
      "        (js-call (get (get globalThis/Object :prototype) :toString) :call iterator)\n"
      "        (try (js-call next :call (js-array)) (catch error (get error :name))))))))\n"
      "(defun boxed-primitives ()\n"
      "  (let* ((number " (boxed-step "construct new Number(255)" "(new globalThis/Number 255)") ")\n"
      "         (string " (boxed-step "construct new String with supplementary-plane text" "(new globalThis/String \"😀\")") ")\n"
      "         (boolean " (boxed-step "construct new Boolean(0)" "(new globalThis/Boolean 0)") ")\n"
      "         (bigint " (boxed-step "convert decimal text with BigInt" "(funcall globalThis/BigInt \"12345678901234567890\")") ")\n"
      "         (symbol " (boxed-step "create Symbol(label)" "(funcall globalThis/Symbol \"label\")") ")\n"
      "         (np " (boxed-step "read Number.prototype" "(get globalThis/Number :prototype)") ")\n"
      "         (sp " (boxed-step "read String.prototype" "(get globalThis/String :prototype)") ")\n"
      "         (bp " (boxed-step "read Boolean.prototype" "(get globalThis/Boolean :prototype)") ")\n"
      "         (ip " (boxed-step "read BigInt.prototype" "(get globalThis/BigInt :prototype)") ")\n"
      "         (yp " (boxed-step "read Symbol.prototype" "(get globalThis/Symbol :prototype)") ")\n"
      "         (description " (boxed-step "reflect Symbol.prototype.description and read its getter" "(get (Object/getOwnPropertyDescriptor yp \"description\") :get)") ")\n"
      "         (length " (boxed-step "reflect boxed string length descriptor" "(Object/getOwnPropertyDescriptor string \"length\")") ")\n"
      "         (index " (boxed-step "reflect boxed string UTF16 index zero descriptor" "(Object/getOwnPropertyDescriptor string \"0\")") "))\n"
      "    " (boxed-step "capture JSON.stringify before evaluating its argument" (str "(JSON/stringify " boxed-observations ")")) "))\n"
      "(defun array-string-iterators ()\n"
      "  (let* ((object (js-object :0 \"a\" :1 \"b\" :length 2))\n"
      "         (iterator (js-call (get (get globalThis/Array :prototype) :values) :call object))\n"
      "         (next (get iterator :next)) (first (js-call next :call iterator))\n"
      "         (string (js-call (get (get globalThis/String :prototype) (get globalThis/Symbol :iterator)) :call \"A😀Z\"))\n"
      "         (string-next (get string :next)))\n"
      "    (put object :1 \"changed\")\n"
      "    (let ((second (js-call next :call iterator)))\n"
      "      (put object :length 1)\n"
      "      (let ((done (js-call next :call iterator)))\n"
      "        (put object :length 3)\n"
      "        (JSON/stringify (js-array first second done (js-call next :call iterator)\n"
      "          (js-call string-next :call string) (js-call string-next :call string)\n"
      "          (js-call string-next :call string) (js-call string-next :call string)))))))\n"
      "(defun bigint-call-path (mode)\n"
      "  (let* ((value (funcall globalThis/BigInt \"12345678901234567890\"))\n"
      "         (prototype (get globalThis/BigInt :prototype))\n"
      "         (method (get prototype :toString)) (call (get method :call))\n"
      "         (trace (js-array))\n"
      "         (radix (js-object :valueOf (lambda () (js-call trace :push \"radix\") 16)))\n"
      "         (sentinel (js-object :reason \"radix\")))\n"
      "    (JSON/stringify\n"
      "      (cond\n"
      "        ((= mode 0)\n"
      "          (js-array (Object/is method (get prototype :toString))\n"
      "            (Object/is call (get (get globalThis/Function :prototype) :call))\n"
      "            (js-call method :call value) (js-call method :call value undefined)\n"
      "            (js-call method :call value 2) (js-call method :call value 36)\n"
      "            (get method :name) (get method :length)))\n"
      "        ((= mode 1)\n"
      "          (js-array (js-call method :call (funcall globalThis/Object value))\n"
      "            (js-call method :apply value (js-array 16))))\n"
      "        ((= mode 2)\n"
      "          (js-array (try (js-call method :call 7 radix) (catch error (get error :name))) trace))\n"
      "        ((= mode 3) (js-array (js-call method :call value radix) trace))\n"
      "        ((= mode 4)\n"
      "          (put radix :valueOf (lambda () (js-call trace :push \"throw\") (throw sentinel)))\n"
      "          (js-array (try (js-call method :call value radix) (catch error (Object/is error sentinel))) trace))\n"
      "        ((= mode 5)\n"
      "          (js-array (js-call method :call\n"
      "            (progn (js-call trace :push \"receiver\") value)\n"
      "            (progn (js-call trace :push \"argument\") radix)\n"
      "            (progn (js-call trace :push \"extra\") 99)) trace))\n"
      "        ((= mode 6)\n"
      "          (try\n"
      "            (js-array\n"
      "              (js-call (get prototype :toString) :call\n"
      "                (progn (put prototype :toString (lambda () \"replacement\")) value) 16)\n"
      "              (js-call (get prototype :toString) :call value))\n"
      "            (finally (put prototype :toString method))))\n"
      "        ((= mode 7)\n"
      "          (js-array (try (js-call method :call prototype radix) (catch error (get error :name))) trace))\n"
      "        (t\n"
      "          (js-array\n"
      "            (try (js-call method :call value nil) (catch error (get error :name)))\n"
      "            (try (js-call method :call value (js* \"NaN\")) (catch error (get error :name)))\n"
      "            (try (js-call method :call value 1) (catch error (get error :name)))\n"
      "            (try (js-call method :call value 37) (catch error (get error :name)))\n"
      "            (try (js-call method :call value (funcall globalThis/BigInt \"16\")) (catch error (get error :name)))))))))\n"
      "(defun Custom (executor)\n"
      "  (let ((receiver (js* \"this\")))\n"
      "    (funcall executor (lambda (value) (put receiver :value value))\n"
      "      (lambda (reason) (put receiver :reason reason)))))\n"
      "(defun InvalidCapability (executor) (funcall executor 1 2))\n"
      "(defun RetryCapability (executor)\n"
      "  (funcall executor undefined undefined)\n"
      "  (let ((receiver (js* \"this\")))\n"
      "    (funcall executor (lambda (value) (put receiver :value value))\n"
      "      (lambda (reason) (put receiver :reason reason)))))\n"
      "(defun promise-validation ()\n"
      "  (let* ((promise (Promise/resolve 7)) (constructor (js-object)) (trace (js-array)))\n"
      "    (put promise :constructor 1)\n"
      "    (js-call trace :push\n"
      "      (try (js-call (get globalThis/Promise :resolve) :call 1 promise) (catch error (get error :name)))\n"
      "      (try (js-call promise :then) (catch error (get error :name)))\n"
      "      (try (js-call (get globalThis/Promise :resolve) :call InvalidCapability 9) (catch error (get error :name))))\n"
      "    (put constructor (get globalThis/Symbol :species) (lambda (executor) (funcall executor (lambda (v) v) (lambda (v) v))))\n"
      "    (put promise :constructor constructor)\n"
      "    (js-call trace :push\n"
      "      (try (js-call promise :then) (catch error (get error :name)))\n"
      "      (get (js-call (get globalThis/Promise :resolve) :call RetryCapability 11) :value))\n"
      "    (JSON/stringify trace)))\n"
      "(defun immediate-thenable (value)\n"
      "  (js-object :then (lambda (resolve reject) (funcall resolve value))))\n"
      "(defun custom-capability (operation)\n"
      "  (put Custom :resolve immediate-thenable)\n"
      "  (let* ((method (get globalThis/Promise operation))\n"
      "         (value (if (= operation \"resolve\") 17 (js-array 3 5 8)))\n"
      "         (result (js-call method :call Custom value)))\n"
      "    (JSON/stringify (get result :value))))\n"
      "(defun promise-suite (mode)\n"
      "  (cond\n"
      "    ((= mode 0) (js-call (Promise/all (js-array 1 (Promise/resolve 2) 3)) :then JSON/stringify))\n"
      "    ((= mode 1) (js-call (Promise/allSettled (js-array (Promise/resolve 1) (Promise/reject \"bad\"))) :then JSON/stringify))\n"
      "    ((= mode 2) (js-call (Promise/any (js-array)) :catch\n"
      "      (lambda (error) (JSON/stringify (js-array (get error :name) (get error :errors))))))\n"
      "    ((= mode 3)\n"
      "      (let ((trace (js-array)))\n"
      "        (js-call (js-call (Promise/resolve 7) :finally (lambda () (js-call trace :push \"finally\") (Promise/resolve 99)))\n"
      "          :then (lambda (value) (JSON/stringify (js-array value trace))))))\n"
      "    ((= mode 4)\n"
      "      (let ((marker (js-object :identity 7)))\n"
      "        (js-call (js-call (Promise/resolve 1) :finally (lambda () (throw marker))) :catch\n"
      "          (lambda (error) (JSON/stringify (js-array (Object/is error marker) (get error :identity)))))))\n"
      "    (t (js-call (Promise/race (js-array (Promise/resolve (not t)) (Promise/resolve 9))) :then JSON/stringify))))\n"
      "(defun foreign-then (promise)\n"
      "  (js-call (get (get globalThis/Promise :prototype) :then) :call promise (lambda (value) (+ value 3))))\n"
      "(defun recover () 42)\n"
      "(export array-callables collections weak-collections iterators promise-validation boxed-primitives array-string-iterators bigint-call-path custom-capability promise-suite foreign-then recover)\n"
      "(export boxed-progress-low boxed-progress-middle boxed-progress-high)\n"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar runtime nil)
  (defvar program nil)
  (defvar bytes nil)
  (defvar host-bytes nil)
  (defvar reference nil)
  (defvar reference-path nil)
  (defvar bigint-lowered nil)
  (defvar bigint-native-path nil)

  (defconst bigint-native-target
    (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos"))
  (defconst bigint-native-supported
    (and (= (get process :arch) "arm64")
         (or (= (get process :platform) "darwin")
             (= (get process :platform) "linux"))))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-prototype-callables-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime
        (js-call (get backend :compiler) :compile_ir_string
          (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
          "runtime.eli"))
      (setq program
        (js-call (get backend :compiler) :compile_ir_string
          source
          "native-prototype-callables.eli"))
      (let* ((frozen (JSON/stringify program))
             (javascript (js-call (get backend :compiler) :emit_ir_string program)))
        (setq reference
          (await (funcall dyn-import
                   (str "data:text/javascript;base64,"
                        (js-call (Buffer/from javascript) :toString "base64")))))
        (setq reference-path (resolve directory "reference.mjs"))
        (await (writeFile reference-path javascript))
        (setq bytes
          (Uint8Array/from
            (js-call (get backend :managed) :emit_managed_wasm program runtime)))
        (js-call assert :equal (JSON/stringify program) frozen)
        (js-call assert :deepEqual
          (WebAssembly.Module/imports (new WebAssembly.Module bytes))
          (js-array))
        (when bigint-native-supported
          (setq bigint-lowered
            (js-call (get backend :managed) :lower_managed_program program runtime))
          (setq bigint-native-path
            (resolve directory
              (if (= (get process :platform) "linux")
                  "bigint-call-path.so"
                  "bigint-call-path.dylib")))
          (await (writeFile bigint-native-path
                   (Uint8Array/from
                     (js-call (get backend :native) :emit_typed_native_memory_library
                       (get bigint-lowered :typed)
                       bigint-native-target)))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun finish (a &rest __host_default_arguments_1)
    (let* ((values (aref __host_default_arguments_1 0)))
    (let ((vals (if (undefined? values) (js-array) values)))
      (try
        (js-call vals :forEach (lambda (v) (js-call a :release v)))
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
        (finally
          (let ((close-fn (get a :close)))
            (when close-fn
              (js-call a :close))))))))

  (defun immediate-code (value)
    (cond
      ((= value nil) 0)
      ((= value false) 1)
      ((= value t) 2)
      ((undefined? value) 3)
      (t -1)))

  (defun boxed-failure-context (a error)
    (try
      (let* ((parts (js-call progress-exports :map
                      (lambda (name) (immediate-code (js-call a :getExport name)))))
             (bad (js-call parts :some (lambda (part) (< part 0)))))
        (when bad
          (throw (new globalThis.Error "boxed progress must contain only immediate values")))
        (let* ((code (+ (aref parts 0) (* (aref parts 1) 4) (* (aref parts 2) 16)))
               (step (aref boxed-steps code)))
          (unless step
            (throw (new globalThis.Error "boxed progress does not name a registered source operation")))
          (let ((marker-idx (js-call source :indexOf (get step :marker))))
            (when (< marker-idx 0)
              (throw (new globalThis.Error "boxed operation has no original source marker")))
            (let* ((start (+ marker-idx (get (get step :marker) :length) 1))
                   (before (js-call source :slice 0 start))
                   (location
                     (js-object
                       :filename "native-prototype-callables.eli"
                       :line (get (js-call before :split "\n") :length)
                       :column (+ (get (Array/from (js-call before :slice (+ (js-call before :lastIndexOf "\n") 1))) :length) 1)
                       :offset (get (Array/from before) :length)
                       :offsetUnit "Unicode scalar"))
                   (context
                     (js-object
                       :operation (get step :label)
                       :location location
                       :budget (js-object :maxSlots 1024 :auto 1)
                       :stats (js-call a :stats)
                       :diagnostic (if (nullish? error) undefined (get error :eliscriptDiagnostic))
                       :frames (if (nullish? error) undefined (get error :eliscriptFrames))
                       :sourceFrames (if (nullish? error) undefined (get error :eliscriptSourceFrames))))
                   (heading
                     (str "boxed-primitives: " (get step :label)
                          " at " (get location :filename) ":" (get location :line) ":" (get location :column))))
              (console/error heading context)
              (when (and (/= error nil)
                         (let ((ty (funcall js-typeof error)))
                           (or (= ty "object") (= ty "function"))))
                (Object/defineProperty error "boxedPrimitiveContext"
                  (js-object :value context :enumerable t :configurable t))
                (when (= (funcall js-typeof (get error :message)) "string")
                  (put error :message (str heading ": " (get error :message)))))))))
      (catch context-error
        (console/error "boxed-primitives progress could not be read; original failure is retained" context-error))))

  (js-call
    (js-array "array-callables" "collections" "weak-collections" "iterators"
              "boxed-primitives" "array-string-iterators" "promise-validation")
    :forEach
    (lambda (name)
      (test (str "real native prototype " name " supports borrowed callables, descriptors, brands and live state")
        (lambda ()
          (let ((a (instantiateManagedRuntime bytes))
                (result undefined)
                (failed false))
            (js-call a :auto 1)
            (try
              (setq result (js-call a :invoke name))
              (let ((fn-name (js-call name :replaceAll "-" "_")))
                (js-call assert :equal
                  (js-call a :readString result)
                  (funcall (get reference fn-name))))
              (catch error
                (setq failed t)
                (Object/defineProperty error "managedStats"
                  (js-object :value (js-call a :stats) :enumerable t :configurable t))
                (when (= name "boxed-primitives")
                  (boxed-failure-context a error))
                (throw error))
              (finally
                (try
                  (finish a (if (globalThis.Boolean result) (js-array result) (js-array)))
                  (catch cleanup-error
                    (unless failed
                      (throw cleanup-error))
                    (console/error "native prototype cleanup also failed; the original failure is retained" cleanup-error))))))))))

  (test "Array callable oracle preserves holes, UTF16 indices and actual callback this"
    (lambda ()
      (let ((result (JSON/parse (js-call reference :array_callables))))
        (js-call assert :deepEqual
          result
          (js-array
            (js-array 13 nil 17 nil)
            false
            (js-array (String/fromCharCode 55357) (String/fromCharCode 56832))
            t
            "map"
            1
            t
            false
            t)))))

  (defun check-bigint-call-path (a mode)
    (let ((input (js-call a :number mode))
          (result undefined))
      (try
        (setq result (js-call a :invoke "bigint-call-path" (js-array input)))
        (js-call assert :equal
          (js-call a :readString result)
          (js-call reference :bigint_call_path mode)
          (str "BigInt borrowed call mode " mode))
        (finally
          (js-call a :release input)
          (when (globalThis.Boolean result)
            (js-call a :release result))))
      (js-call a :collect)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (let ((m 0))
    (while (< m 9)
      (let ((mode m))
        (test (str "Given the canonical BigInt toString when borrowed through Function.call then receiver radix effects and exceptions remain exact in mode " mode)
          (lambda ()
            (let ((a (instantiateManagedRuntime bytes)))
              (js-call a :auto 1)
              (try
                (check-bigint-call-path a mode)
                (finally
                  (finish a)))))))
      (setq m (+ m 1))))

  (funcall (js-call test :skipIf (not bigint-native-supported))
    "Given the same BigInt borrowed-call source in a true native library then every receiver and radix contract survives collection"
    (async ()
      (let ((a (await (instantiateNativeManagedRuntime
                        bigint-native-path
                        bigint-lowered
                        (js-object :nativeTarget bigint-native-target)))))
        (js-call a :auto 1)
        (try
          (let ((mode 0))
            (while (< mode 9)
              (check-bigint-call-path a mode)
              (setq mode (+ mode 1))))
          (finally
            (finish a)))))
    120000)

  (js-call (js-array "resolve" "all" "allSettled" "any") :forEach
    (lambda (operation)
      (test (str "Promise." operation " uses the actual constructor and its resolve capability")
        (lambda ()
          (let* ((a (instantiateManagedRuntime bytes))
                 (input (progn (js-call a :auto 1) (js-call a :string operation)))
                 (result undefined))
            (try
              (setq result (js-call a :invoke "custom-capability" (js-array input)))
              (js-call assert :equal
                (js-call a :readString result)
                (js-call reference :custom_capability operation))
              (finally
                (finish a (if (globalThis.Boolean result)
                              (js-array input result)
                              (js-array input))))))))))

  (let ((m 0))
    (while (< m 6)
      (let ((mode m))
        (test (str "Promise native capability, aggregate and finally jobs preserve completion " mode)
          (async ()
            (let* ((a (instantiateManagedRuntime bytes))
                   (input (progn (js-call a :auto 1) (js-call a :number mode)))
                   (result undefined))
              (try
                (setq result (await (js-call a :invokeAsync "promise-suite" (js-array input))))
                (js-call assert :equal
                  (js-call a :readString result)
                  (await (js-call reference :promise_suite mode)))
                (finally
                  (finish a (if (globalThis.Boolean result)
                                (js-array input result)
                                (js-array input)))))))))
      (setq m (+ m 1))))

  (test "foreign Promise.then uses actual host Promise internal slots without accepting an ordinary thenable"
    (async ()
      (setq host-bytes
        (Uint8Array/from
          (js-call (get backend :managed) :emit_managed_project_wasm
            (js-array (js-object :id "prototype-callables.mjs" :program program))
            "prototype-callables.mjs"
            runtime
            (js-object :phased t))))
      (js-call assert :deepEqual
        (js-call (WebAssembly.Module/imports (new WebAssembly.Module host-bytes)) :map
          (lambda (item)
            (js-object
              :module (get item :module)
              :name (get item :name)
              :kind (get item :kind))))
        (js-array
          (js-object :module "eliscript.host" :name "source-operation" :kind "function")))
      (let* ((a (instantiateManagedRuntime host-bytes))
             (_ (js-call a :auto 1))
             (input (js-call a :fromHostValue (Promise/resolve 8)))
             (wrong (js-call a :fromHostValue (js-object :then (lambda () 99))))
             (output undefined))
        (try
          (setq output (js-call a :invoke "foreign_then" (js-array input)))
          (js-call assert :equal (await (js-call a :toHostValue output)) 11)
          (js-call assert :throws
            (lambda () (js-call a :invoke "foreign_then" (js-array wrong)))
            (lambda (error)
              (cond
                ((funcall js-instanceof error globalThis.TypeError) t)
                ((and (not (nullish? error)) (= (get error :kind) 35))
                 (try
                   (funcall js-instanceof (js-call a :toHostValue error) globalThis.TypeError)
                   (finally
                     (js-call a :release error))))
                (t false))))
          (finally
            (finish a (if (globalThis.Boolean output)
                          (js-array input wrong output)
                          (js-array input wrong))))))))

  (test "Node executes the independent JavaScript prototype and Promise oracle"
    (lambda ()
      (let ((child (spawnSync "node"
                     (js-array node-helper "--run-node-check" (get (pathToFileURL reference-path) :href))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal
          (get child :status)
          0
          (let ((stderr (get child :stderr)))
            (if (and (not (nullish? stderr)) (> (get stderr :length) 0))
                stderr
                (get child :stdout))))))))
