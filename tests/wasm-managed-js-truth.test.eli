(module tests.wasm-managed-js-truth.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp mkdir writeFile rm readdir)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defun dynamic-import (specifier)
    (funcall (js* "(specifier) => import(specifier)") specifier))

  (defconst js-boolean (js* "(value) => !!value"))

  (defvar directory undefined)
  (defvar b undefined)
  (defvar runtime undefined)
  (defvar program undefined)
  (defvar bytes undefined)
  (defvar js undefined)

  (defconst source
    "(defconst marker 1)\n(defun truth (value) (js* \"!!value\"))\n(defun branch (value) (if (js* \"!!value\") 1 0))\n(defun shadow (value) (let ((answer value)) (js-array (js* \"!!answer\") (let ((answer 0)) (js* \"!!answer\")) (js* \"!!answer\"))))\n(defun once (object) (let ((answer (aref object \"answer\"))) (js* \"!!answer\")))\n(defun capture (value-name) (lambda () (js* \"!!value_name\")))\n(defun invoke (callback) (funcall callback))\n(defun opaque () (let ((answer (js-object :valueOf (lambda () (js-call nil :charAt 0)) :toString (lambda () (js-call nil :charAt 0))))) (js* \"!!answer\")))\n(export truth branch shadow once capture invoke opaque)")

  (defun emit (p)
    (let* ((saved (JSON/stringify p))
           (out (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p runtime))))
      (js-call assert :equal (JSON/stringify p) saved)
      (funcall assert (js-call globalThis.WebAssembly :validate out))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module out)) (js-array))
      out))

  (defun box (a v)
    (cond
      ((= (value-type v) "number") (js-call a :number v))
      ((= (value-type v) "string") (js-call a :string v))
      (t v)))

  (defun finish (a &rest __host_default_arguments_1)
    (let* ((owned-arg (aref __host_default_arguments_1 0)))
    (let ((owned (if (undefined? owned-arg) (js-array) owned-arg)))
      (js-call owned :forEach (lambda (v) (js-call a :release v)))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-js-truth-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (setq program (js-call (get b :compiler) :compile_ir_string source "js-truth.eli"))
    (setq bytes (emit program))
    (setq js (await (dynamic-import (str "data:text/javascript;base64,"
                                         (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string program)) :toString "base64"))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (test "exact identifier ToBoolean agrees with native JS primitives and never coerces opaque objects under per-allocation GC" (lambda ()
    (let ((a (instantiateManagedRuntime bytes)))
      (js-call a :auto 1)
      (js-call
        (js-array undefined nil false t 0 -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                  globalThis.Number.MIN_VALUE (- globalThis.Number.MIN_VALUE) 1 -1 "" "0" "中😀" "\ud800")
        :forEach
        (lambda (value)
          (let ((v (box a value))
                (expected (funcall js-boolean value)))
            (js-call assert :equal (js-call a :invoke "truth" (js-array v)) expected)
            (let ((branch (js-call a :invoke "branch" (js-array v))))
              (js-call assert :equal (js-call a :readNumber branch) (if expected 1 0))
              (js-call a :release branch))
            (let ((out (js-call a :invoke "shadow" (js-array v)))
                  (i 0))
              (while (< i 3)
                (let ((result (js-call a :get out i)))
                  (js-call assert :equal result (if (= i 1) false expected))
                  (js-call a :release result))
                (setq i (1+ i)))
              (js-call a :release out))
            (let ((fn (js-call a :invoke "capture" (js-array v))))
              (js-call assert :equal (js-call a :invoke "invoke" (js-array fn)) expected)
              (js-call a :release fn)
              (js-call a :release v)))))
      (js-call assert :equal (js-call a :invoke "opaque") t)
      (js-call
        (js-array (globalThis.BigInt 0) (globalThis.BigInt 1) (globalThis.BigInt -1)
                  (globalThis.Symbol) (lambda () 1) (js-object) (js-array)
                  (new globalThis.Proxy (js-object) (js-object :get (lambda () (throw (globalThis.Error "must not read"))))))
        :forEach
        (lambda (value)
          (js-call assert :equal (js-call js :truth value) (funcall js-boolean value))))
      (let ((object (js-call a :sourceObject (js-object)))
            (array (js-call a :sourceArray (js-array))))
        (js-call assert :equal (js-call a :invoke "truth" (js-array object)) t)
        (js-call assert :equal (js-call a :invoke "truth" (js-array array)) t)
        (finish a (js-array object array))))))

  (test "operand getters run once, Boolean shadows are ignored, and only the complete primitive bypasses Lisp truth checks" (async ()
    (js-call (js-array false 0 "" globalThis.NaN undefined nil t (js-object) (globalThis.BigInt 1)) :forEach
      (lambda (value)
        (let ((reads 0)
              (holder (js-object)))
          (Object/defineProperty holder "answer"
            (js-object :enumerable t :configurable t
                       :get (lambda () (setq reads (1+ reads)) value)))
          (js-call assert :equal (js-call js :once holder) (funcall js-boolean value))
          (js-call assert :equal reads 1))))
    (let* ((p (js-call (get b :compiler) :compile_ir_string
                "(defconst Boolean (lambda () false)) (defun f (value) (if (js* \"!!value\") 1 0)) (defun suffix (value) (if (js* \"!!value || \\\"\\\"\") 1 0)) (export f suffix)"
                "truth-shadow.eli"))
           (code (js-call (get b :compiler) :emit_ir_string p))
           (m (await (dynamic-import (str "data:text/javascript;base64," (js-call (Buffer/from code) :toString "base64"))))))
      (js-call assert :equal (js-call m :f "") 0)
      (js-call assert :equal (js-call m :f (js-object)) 1)
      (js-call assert :equal (js-call m :suffix false) 1)
      (funcall assert (js-call code :includes "if (!!value)"))
      (funcall assert (js-call code :includes "__eliscript_truthy(!!value || \"\")")))
    (let* ((a (instantiateManagedRuntime bytes))
           (_ (js-call a :auto 1))
           (answer (js-call a :string ""))
           (object (js-call a :sourceObject (js-object :answer answer))))
      (js-call assert :equal (js-call a :invoke "once" (js-array object)) false)
      (finish a (js-array answer object)))))

  (test "project binding renaming preserves module globals, imported aliases and lexical captures in exact truth primitives" (lambda ()
    (let* ((library (js-call (get b :compiler) :compile_ir_string
                      "(module lib (defvar answer 0) (defun f () (js* \"!!answer\")) (defun change () (setq answer \"x\")) (defun make (input-value) (lambda () (js* \"!!input_value\"))) (defun invoke (f) (funcall f)) (export f change make invoke))"
                      "truth-lib.eli"))
           (entry (js-call (get b :compiler) :compile_ir_string
                    "(module entry (import \"./lib.mjs\" f change make invoke) (export f change make invoke))"
                    "truth-entry.eli"))
           (modules (js-array (js-object :id "lib.mjs" :program library) (js-object :id "entry.mjs" :program entry)))
           (saved (JSON/stringify modules))
           (out (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "entry.mjs" runtime))))
      (js-call assert :equal (JSON/stringify modules) saved)
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module out)) (js-array))
      (let ((a (instantiateManagedRuntime out)))
        (js-call a :auto 1)
        (js-call assert :equal (js-call a :invoke "f") false)
        (let ((change (js-call a :invoke "change")))
          (js-call a :release change))
        (js-call assert :equal (js-call a :invoke "f") t)
        (let* ((value (js-call a :string ""))
               (callback (js-call a :invoke "make" (js-array value))))
          (js-call assert :equal (js-call a :invoke "invoke" (js-array callback)) false)
          (finish a (js-array value callback)))))))

  (test "unbound names and every unsupported raw expression remain source-bound refusals without mutable IR" (lambda ()
    (js-call
      (js-array "!!unknown" "!!globalThis" "!value" "!!!value" "!!value.x" "!!value[0]" "!!value()"
                "!!value || \"\"" "!!value; true" "!!0value" "!!value + 1" "!!value/*x*/" "!!值" "!!value\ntrue")
      :forEach
      (lambda (expression)
        (let* ((p (js-call (get b :compiler) :compile_ir_string
                    (str "(defun f (value) (js* " (JSON/stringify expression) ")) (export f)")
                    "truth-refusal.eli"))
               (saved (JSON/stringify p)))
          (js-call assert :throws
            (lambda () (js-call (get b :managed) :emit_managed_wasm p runtime))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and diag (= (get diag :code) "ELI-B0001") (= (get (get diag :location) :file) "truth-refusal.eli")))))
          (js-call assert :equal (JSON/stringify p) saved))))
    (let* ((a (instantiateManagedRuntime bytes))
           (_ (js-call a :auto 1))
           (value (js-call a :number -0.0))
           (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 value)
      (js-call assert :throws
        (lambda () (js-call a :invoke "truth" (js-array (js-object))))
        (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0001")))))
      (js-call assert :throws
        (lambda () (js-call a :invoke "truth" (js-array (globalThis.BigInt 1))))
        (lambda (e) (let ((diag (get e :eliscriptDiagnostic))) (and diag (= (get diag :code) "ELI-RT0001")))))
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
      (funcall assert (Object/is (js-call a :readNumber value) -0.0))
      (js-call a :leaveFrame frame)
      (finish a (js-array value)))))

  (test "public Seed, three compiler generations and Node retain exact code, zero-import bytes and Boolean-independent results" (async ()
    (let ((input (resolve directory "truth.eli"))
          (output (resolve directory "truth.mjs")))
      (await (writeFile input source))
      (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--output" output input) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get seed :status) 0 (get seed :stderr))
        (js-call assert :equal (await (readFile output "utf8")) (js-call (get b :compiler) :emit_ir_string program)))
      (let ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort))
            (compiler (get b :compiler))
            (generation 0))
        (js-call assert :equal (js-length files) 13)
        (while (< generation 3)
          (let ((p (js-call compiler :compile_ir_string source "js-truth.eli")))
            (js-call assert :deepEqual p program)
            (js-call assert :deepEqual (emit p) bytes)
            (let ((out (resolve directory (str "g" generation)))
                  (idx 0))
              (await (mkdir out))
              (while (< idx (js-length files))
                (let* ((file (aref files idx))
                       (filename (resolve "bootstrap/compiler" file)))
                  (await (writeFile (resolve out (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                                    (js-call compiler :compile_string (await (readFile filename "utf8")) filename))))
                (setq idx (1+ idx)))
              (setq compiler (await (dynamic-import (get (pathToFileURL (resolve out "compiler.mjs")) :href))))))
          (setq generation (1+ generation))))
      (let ((wasm (resolve directory "truth.wasm")))
        (await (writeFile wasm bytes))
        (let ((child (spawnSync "node"
                       (js-array (resolve "tests/helpers/wasm-managed-js-truth-node.mjs")
                                 (get (pathToFileURL output) :href)
                                 (get (pathToFileURL (resolve "tools/backends/managed-runtime.mjs")) :href)
                                 wasm)
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))))))
    30000))
