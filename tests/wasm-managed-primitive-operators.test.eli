(module tests.wasm-managed-primitive-operators.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:child_process" spawnSync)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:crypto" createHash)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst is-instance (js* "(a, b) => a instanceof b"))
  (defconst js-global (js* "() => globalThis"))
  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst raw-js-add (js* "(a, b) => a + b"))
  (defconst raw-js-sub (js* "(a, b) => a - b"))
  (defconst raw-js-mul (js* "(a, b) => a * b"))
  (defconst raw-js-div (js* "(a, b) => a / b"))
  (defconst raw-js-rem (js* "(a, b) => a % b"))
  (defconst raw-js-neg (js* "(a) => -a"))
  (defconst raw-js-bitor (js* "(a, b) => a | b"))
  (defconst raw-js-bitand (js* "(a, b) => a & b"))
  (defconst raw-js-bitxor (js* "(a, b) => a ^ b"))
  (defconst raw-js-bitnot (js* "(a) => ~a"))
  (defconst raw-js-shl (js* "(a, b) => a << b"))
  (defconst raw-js-shr (js* "(a, b) => a >> b"))
  (defconst raw-js-ushr (js* "(a, b) => a >>> b"))
  (defconst raw-js-lt (js* "(a, b) => a < b"))
  (defconst raw-js-le (js* "(a, b) => a <= b"))
  (defconst raw-js-gt (js* "(a, b) => a > b"))
  (defconst raw-js-ge (js* "(a, b) => a >= b"))
  (defconst raw-js-eq (js* "(a, b) => a === b"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar runtimeProgram nil)
  (defvar program nil)
  (defvar bytes nil)
  (defvar js nil)

  (defconst hex "0xbcf8f9bdba22840724d028768a8a77b3e6b0f283670085477910eccc4e9d6b278a11db79c280d4e9c237774812029ac7ce82daaafca38")
  (defconst radix-re (new globalThis.RegExp "^(?:0[xX][0-9a-fA-F]+|0[oO][0-7]+|0[bB][01]+)$"))

  (defconst b0 (globalThis.BigInt 0))
  (defconst b1 (globalThis.BigInt 1))
  (defconst b2 (globalThis.BigInt 2))
  (defconst b3 (globalThis.BigInt 3))
  (defconst b5 (globalThis.BigInt 5))
  (defconst bn5 (globalThis.BigInt -5))
  (defconst b20 (globalThis.BigInt 20))

  (defun to-num (x)
    (if (= (funcall js-typeof x) "string")
      (let ((trimmed (js-call x :trim)))
        (if (js-call radix-re :test trimmed)
          (globalThis.Number (globalThis.BigInt trimmed))
          (globalThis.Number x)))
      (globalThis.Number x)))

  (defun less-fn (a b)
    (if (and (= (funcall js-typeof a) "string") (= (funcall js-typeof b) "string"))
      (funcall raw-js-lt a b)
      (funcall raw-js-lt (to-num a) (to-num b))))

  (defconst expected
    (js-object
      "add" (lambda (a b) (funcall raw-js-add a b))
      "subtract" (lambda (a b) (funcall raw-js-sub (to-num a) (to-num b)))
      "multiply" (lambda (a b) (funcall raw-js-mul (to-num a) (to-num b)))
      "divide" (lambda (a b) (funcall raw-js-div (to-num a) (to-num b)))
      "remainder" (lambda (a b) (funcall raw-js-rem (to-num a) (to-num b)))
      "negate" (lambda (a) (funcall raw-js-neg (to-num a)))
      "reciprocal" (lambda (a) (funcall raw-js-div 1 (to-num a)))
      "increment" (lambda (a) (funcall raw-js-add a 1))
      "decrement" (lambda (a) (funcall raw-js-sub (to-num a) 1))
      "identity-add" (lambda (a) a)
      "identity-multiply" (lambda (a) a)
      "signed" (lambda (a) (funcall raw-js-bitor (to-num a) 0))
      "unsigned" (lambda (a) (funcall raw-js-ushr (to-num a) 0))
      "invert" (lambda (a) (funcall raw-js-bitnot (to-num a)))
      "mask" (lambda (a b) (funcall raw-js-bitand (to-num a) (to-num b)))
      "union" (lambda (a b) (funcall raw-js-bitor (to-num a) (to-num b)))
      "exclusive" (lambda (a b) (funcall raw-js-bitxor (to-num a) (to-num b)))
      "shift-left" (lambda (a b) (funcall raw-js-shl (to-num a) (to-num b)))
      "shift-right" (lambda (a b) (funcall raw-js-shr (to-num a) (to-num b)))
      "logical-right" (lambda (a b) (funcall raw-js-ushr (to-num a) (to-num b)))
      "product-word" (lambda (a b) (Math/imul (to-num a) (to-num b)))
      "equal" (lambda (a b) (funcall raw-js-eq a b))
      "less" less-fn
      "less-equal" (lambda (a b)
                     (if (and (= (funcall js-typeof a) "string") (= (funcall js-typeof b) "string"))
                       (funcall raw-js-le a b)
                       (funcall raw-js-le (to-num a) (to-num b))))
      "greater" (lambda (a b)
                  (if (and (= (funcall js-typeof a) "string") (= (funcall js-typeof b) "string"))
                    (funcall raw-js-gt a b)
                    (funcall raw-js-gt (to-num a) (to-num b))))
      "greater-equal" (lambda (a b)
                        (if (and (= (funcall js-typeof a) "string") (= (funcall js-typeof b) "string"))
                          (funcall raw-js-ge a b)
                          (funcall raw-js-ge (to-num a) (to-num b))))
      "ordered-add" (lambda (a b c) (funcall raw-js-add (funcall raw-js-add a b) c))
      "ordered-subtract" (lambda (a b c) (funcall raw-js-sub (funcall raw-js-sub (to-num a) (to-num b)) (to-num c)))
      "snapshot" (lambda (a b) (funcall raw-js-add a b))
      "comparison-snapshot" (lambda (a b c) (and (less-fn a b) (less-fn b c)))
      "comparison-effects" (lambda () 1)
      "scalar-loop" (lambda (n seed)
                      (let ((i 0)
                            (x seed)
                            (total 0))
                        (while (funcall raw-js-lt i n)
                          (setq x (funcall raw-js-mul
                                    (funcall raw-js-mul 3.8 (to-num x))
                                    (funcall raw-js-sub 1 (to-num x))))
                          (setq total (funcall raw-js-add total x))
                          (setq i (+ i 1)))
                        total))))

  (defun box-val (a x)
    (let ((ty (funcall js-typeof x)))
      (cond
        ((= ty "number") (js-call a :number x))
        ((= ty "string") (js-call a :string x))
        (t x))))

  (defun read-val (a x)
    (if (and (not (nullish? x)) (= (funcall js-typeof x) "object"))
      (let ((k (get x :kind)))
        (cond
          ((= k 4) (js-call a :readNumber x))
          ((= k 5) (js-call a :readString x))
          (t x)))
      x))

  (defun check-op (a name inputs)
    (let ((args (js-call inputs :map (lambda (x) (box-val a x))))
          (out undefined))
      (try
        (setq out (js-call a :invoke name args))
        (funcall assert (Object/is (read-val a out) (apply (aref expected name) inputs))
                 (str name ": " (js-call (js-call inputs :map (lambda (x) (globalThis.String x))) :join ",")))
        (finally
          (js-call a :release out)
          (js-call args :forEach (lambda (x)
            (js-call a :release x)))))
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (defasync import-js-code (code)
    (await (funcall dyn-import
                    (str "data:text/javascript;base64,"
                         (js-call (Buffer/from code) :toString "base64")))))

  (defun helper-script-path ()
    (resolve "tests/helpers/wasm-managed-primitive-operators-node.mjs"))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-primitive-operators-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq runtimeProgram
        (js-call (get backend :compiler) :compile_ir_string
                 (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                 "runtime.eli"))
      (setq program
        (js-call (get backend :compiler) :compile_ir_string
                 (await (readFile "tests/fixtures/wasm-managed-primitive-operators.eli" "utf8"))
                 "primitive-operators.eli"))
      (setq bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program runtimeProgram)))
      (funcall assert (WebAssembly/validate bytes))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (setq js (await (import-js-code (js-call (get backend :compiler) :emit_ir_string program)))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (test "ordinary mixed primitive arithmetic, word and relational operators exactly implement source conversion semantics under GC"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576)))
            (inputs (js-array nil false t undefined 0 -0.0 1 -1 globalThis.NaN globalThis.Infinity
                              globalThis.Number.MIN_VALUE 0.5 "" "0" "-0" "1.5" " 0x10 " "0b101" "0o77"
                              "invalid" (str "中😀" (String/fromCharCode 55296))))
            (unary-ops (js-array "negate" "reciprocal" "increment" "decrement" "signed" "unsigned" "invert" "identity-add" "identity-multiply"))
            (binary-ops (js-array "add" "subtract" "multiply" "divide" "remainder" "mask" "union" "exclusive"
                                  "shift-left" "shift-right" "logical-right" "product-word" "equal" "less"
                                  "less-equal" "greater" "greater-equal")))
        (js-call a :auto 1)
        (js-call inputs :forEach (lambda (x)
          (js-call unary-ops :forEach (lambda (name)
            (check-op a name (js-array x))))
          (js-call inputs :forEach (lambda (y)
            (js-call binary-ops :forEach (lambda (name)
              (check-op a name (js-array x y))))))))
        (funcall assert (> (get (js-call a :stats) :collections) 1000)))))

  (test "mixed variadic operations keep intermediate conversion order, alias snapshots and all comparison operand effects"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes))
            (cases (js-array (js-array "1" 2 3)
                             (js-array 1 2 "3")
                             (js-array nil false "x")
                             (js-array "invalid" 1 2)
                             (js-array "10" "2" 3)
                             (js-array -0.0 "0" nil)
                             (js-array undefined 1 "x"))))
        (js-call a :auto 1)
        (js-call cases :forEach (lambda (inputs)
          (js-call (js-array "ordered-add" "ordered-subtract" "comparison-snapshot") :forEach (lambda (name)
            (check-op a name inputs)))
          (check-op a "snapshot" (js-call inputs :slice 0 2))
          (check-op a "comparison-effects" (js-call inputs :slice 0 2))))
        (js-call (js-array "identity-add" "identity-multiply") :forEach (lambda (name)
          (let* ((obj (js-call a :sourceObject (js-object)))
                 (out (js-call a :invoke name (js-array obj))))
            (funcall assert (js-call a :keyEqual obj out))
            (js-call a :release out)
            (js-call a :release obj))))
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "WASM implicit numeric conversions retain exact long-radix rounding and f64 primitive results"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes))
            (hex-num (globalThis.Number (globalThis.BigInt hex)))
            (state 1470339873)
            (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
        (js-call a :auto 1)
        (js-call (js-array "subtract" "multiply" "divide" "remainder" "less" "less-equal" "greater" "greater-equal") :forEach (lambda (name)
          (check-op a name (js-array hex hex-num))))
        (check-op a "negate" (js-array hex))
        (check-op a "decrement" (js-array hex))
        (let ((next-u32 (lambda ()
                          (setq state (bit-xor state (bit-shift-left state 13)))
                          (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                          (setq state (bit-xor state (bit-shift-left state 5)))
                          (unsigned-bit-shift-right state 0)))
              (i 0))
          (while (< i 512)
            (js-call bits :setUint32 0 (funcall next-u32) t)
            (js-call bits :setUint32 4 (funcall next-u32) t)
            (let* ((n (js-call bits :getFloat64 0 t))
                   (text (globalThis.String n)))
              (js-call (js-array "add" "subtract" "multiply" "remainder" "less" "greater-equal") :forEach (lambda (name)
                (check-op a name (js-array text n)))))
            (setq i (+ i 1)))))))

  (test "generated JS primitive coercions preserve exact nondecimal rounding while retaining BigInt and object behavior"
    (lambda ()
      (let ((hex-num (globalThis.Number (globalThis.BigInt hex))))
        (js-call (js-array "subtract" "multiply" "divide" "remainder" "less" "less-equal" "greater" "greater-equal") :forEach (lambda (name)
          (let ((export-name (js-call name :replaceAll "-" "_")))
            (funcall assert (Object/is (funcall (aref js export-name) hex hex-num)
                                       (funcall (aref expected name) hex hex-num))
                     name))))
        (funcall assert (Object/is (js-call js :negate hex) (funcall (aref expected "negate") hex)))
        (js-call assert :equal (js-call js :subtract b5 b2) b3)
        (js-call assert :throws (lambda () (js-call js :subtract b5 2)) globalThis.TypeError)
        (let* ((effects (js-array))
               (left (js-object :valueOf (lambda () (js-call effects :push "left") 5)))
               (right (js-object :valueOf (lambda () (js-call effects :push "right") 2))))
          (js-call assert :equal (js-call js :subtract left right) 3)
          (js-call assert :deepEqual effects (js-array "left" "right")))
        (let ((prim10 (js-object)))
          (put prim10 globalThis.Symbol.toPrimitive (lambda () "10"))
          (js-call assert :equal (js-call js :less prim10 "2") t))
        (js-call assert :equal (js-call js :negate b5) bn5)
        (js-call assert :equal (js-call js :shift_left b5 b2) b20)
        (js-call assert :throws (lambda () (js-call js :product_word b5 b2)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call js :signed b5)) globalThis.TypeError)
        (let ((precise (js-object)))
          (put precise globalThis.Symbol.toPrimitive
               (lambda (hint)
                 (js-call assert :equal hint "number")
                 hex))
          (js-call assert :equal (js-call js :subtract precise hex-num) 0))
        (let ((suppressed (js-array)))
          (js-call assert :throws
            (lambda ()
              (js-call js :subtract
                       (globalThis.Symbol "left")
                       (js-object :valueOf (lambda () (js-call suppressed :push "right") 1))))
            globalThis.TypeError)
          (js-call assert :deepEqual suppressed (js-array))))))

  (test "typed Number-only JS emission validates every source node and preserves the accepted optimized JS control bytes"
    (async ()
      (let* ((source (str (await (readFile "tools/experiments/native-wasm/kernels.eli" "utf8"))
                          "\n"
                          (await (readFile "tools/backends/batches.eli" "utf8"))))
             (p (js-call (get backend :compiler) :compile_ir_string source "direct-batches.eli"))
             (saved (JSON/stringify p))
             (code (js-call (get backend :numeric) :emit_numeric_javascript p))
             (retained (JSON/parse (await (readFile "tools/backends/results/direct-wasm-macos-arm64.json" "utf8")))))
        (js-call assert :equal (js-call (js-call (createHash "sha256") :update code) :digest "hex")
                 (get (get retained :artifacts) :javascriptSha256))
        (js-call assert :equal (JSON/stringify p) saved)
        (js-call (js-array "\"1\"" "(js-object)" "(string-to-number x)") :forEach (lambda (expression)
          (let* ((bad (js-call (get backend :compiler) :compile_ir_string
                               (str "(defun f (x) (if false " expression " x)) (export f)")
                               "invalid-numeric-js.eli"))
                 (before (JSON/stringify bad)))
            (js-call assert :throws
              (lambda () (js-call (get backend :numeric) :emit_numeric_javascript bad))
              (lambda (err)
                (let ((diag (get err :eliscriptDiagnostic)))
                  (and (not (nullish? diag))
                       (= (get diag :code) "ELI-B0001")
                       (= (get (get diag :location) :file) "invalid-numeric-js.eli")))))
            (js-call assert :equal (JSON/stringify bad) before)))))))

  (test "subtracting the Number literal one uses a unary numeric result while preserving exact conversion and errors"
    (async ()
      (let* ((source "(defun step (x) (1- x)) (defun literal (x) (- x 1)) (export step literal)")
             (code (js-call (get backend :compiler) :compile_string source "decrement.eli")))
        (funcall assert (js-call code :includes "return __eliscript_numeric_decrement(x);"))
        (funcall assert (not (js-call code :includes "Math.")))
        (let ((m (await (import-js-code code)))
              (xs (js-array nil undefined false t -0.0 globalThis.NaN globalThis.Infinity
                            globalThis.Number.MIN_VALUE 0.25 "-0" "1.25" hex "invalid")))
          (js-call xs :forEach (lambda (x)
            (js-call (js-array (get m :step) (get m :literal)) :forEach (lambda (f)
              (funcall assert (Object/is (funcall f x) (funcall raw-js-sub (to-num x) 1)))))))
          (js-call (js-array (get m :step) (get m :literal)) :forEach (lambda (f)
            (let ((calls 0)
                  (prim (js-object)))
              (put prim globalThis.Symbol.toPrimitive
                   (lambda (hint)
                     (js-call assert :equal hint "number")
                     (setq calls (+ calls 1))
                     "2.5"))
              (js-call assert :equal (funcall f prim) 1.5)
              (js-call assert :equal calls 1)
              (js-call assert :throws (lambda () (funcall f b5)) globalThis.TypeError)
              (js-call assert :throws (lambda () (funcall f (js-object :valueOf (lambda () b5)))) globalThis.TypeError)
              (js-call assert :throws (lambda () (funcall f (globalThis.Symbol))) globalThis.TypeError))))))))

  (test "generated JS evaluates operands before conversion and preserves native hooks, BigInt and exception priority"
    (async ()
      (let* ((p (js-call (get backend :compiler) :compile_ir_string
                         "(defun observed (left right) (- (js-call left :operand) (js-call right :operand))) (export observed)"
                         "coercion-order.eli"))
             (m (await (import-js-code (js-call (get backend :compiler) :emit_ir_string p))))
             (effects (js-array))
             (operand (lambda (label n)
                        (js-object
                          :operand (lambda ()
                                     (js-call effects :push (str "evaluate-" label))
                                     (js-object
                                       :valueOf (lambda ()
                                                  (js-call effects :push (str "convert-" label))
                                                  n)))))))
        (js-call assert :equal (js-call m :observed (funcall operand "left" 5) (funcall operand "right" 2)) 3)
        (js-call assert :deepEqual effects (js-array "evaluate-left" "evaluate-right" "convert-left" "convert-right"))
        (let ((hook (lambda (hint)
                      (js-call assert :equal hint "number")
                      3))
              (hook-obj (js-object))
              (bad-prim-num (js-object :valueOf (lambda () (throw (globalThis.Error "must not fallback")))))
              (bad-prim-obj (js-object)))
          (put hook "call" (lambda () (throw (globalThis.Error "observable call property"))))
          (put hook-obj globalThis.Symbol.toPrimitive hook)
          (js-call assert :equal (js-call js :subtract hook-obj 1) 2)
          (js-call assert :equal (js-call js :subtract
                                          (js-object :valueOf (lambda () (js-object))
                                                     :toString (lambda () "2.5"))
                                          1)
                   1.5)
          (put bad-prim-num globalThis.Symbol.toPrimitive 7)
          (js-call assert :throws (lambda () (js-call js :subtract bad-prim-num 1)) globalThis.TypeError)
          (put bad-prim-obj globalThis.Symbol.toPrimitive (lambda () (js-object)))
          (js-call assert :throws (lambda () (js-call js :subtract bad-prim-obj 1)) globalThis.TypeError))
        (js-call assert :equal (js-call js :negate b5) bn5)
        (js-call assert :equal (js-call js :shift_left b5 b2) b20)
        (js-call assert :equal (js-call js :less "10" b2) false)
        (js-call assert :equal (js-call js :less "10" "2") t)
        (let* ((calls 0)
               (right (js-object :valueOf (lambda () (setq calls (+ calls 1)) 2))))
          (js-call assert :throws (lambda () (js-call js :subtract (globalThis.Symbol) right)) globalThis.TypeError)
          (js-call assert :equal calls 0)
          (js-call assert :throws (lambda () (js-call js :less (globalThis.Symbol) right)) globalThis.TypeError)
          (js-call assert :equal calls 1)
          (setq calls 0)
          (js-call assert :throws (lambda () (js-call js :product_word (js-object :valueOf (lambda () b5)) right)) globalThis.TypeError)
          (js-call assert :equal calls 0)))))

  (test "seed and self-hosted primitive operators emit identical JS and ignore constructor parameter shadowing"
    (async ()
      (let* ((source (str (await (readFile "tests/fixtures/wasm-managed-primitive-operators.eli" "utf8"))
                          "\n(defun shadow (Number BigInt Math Symbol Reflect value) (- value 0)) (export shadow)"))
             (input (resolve directory "seed-input.eli"))
             (output (resolve directory "seed-output.mjs")))
        (await (writeFile input source))
        (let ((child (spawnSync (resolve "bin/eliscript-seed")
                                (js-array "--output" output input)
                                (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))
        (let* ((seed (await (readFile output "utf8")))
               (p (js-call (get backend :compiler) :compile_ir_string source input)))
          (js-call assert :equal (js-call (get backend :compiler) :emit_ir_string p) seed)
          (let ((m (await (import-js-code seed)))
                (bad (lambda () (throw (globalThis.Error "shadowed constructor"))))
                (hex-num (globalThis.Number (globalThis.BigInt hex))))
            (js-call assert :equal (js-call m :shadow bad bad bad bad bad hex) hex-num)
            (js-call assert :equal (js-call m :subtract hex hex-num) 0)))
        (let ((executed (spawnSync (get process :execPath)
                                   (js-array (helper-script-path) "seed" (get (pathToFileURL output) :href) hex)
                                   (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get executed :status) 0 (get executed :stderr)))
        (let ((plain (js-call (get backend :compiler) :emit_ir_string
                              (js-call (get backend :compiler) :compile_ir_string
                                       "(defun identity (x) (+ x)) (export identity)"
                                       "identity.eli"))))
          (funcall assert (not (js-call plain :includes "__eliscript_numeric_sub")))
          (funcall assert (not (js-call plain :includes "__eliscript_to_number")))))))

  (test "closed scalar loops guard Number parameters once and retain complete mixed-input fallback without per-iteration boxing helpers"
    (async ()
      (let* ((source "(defun closed (n seed) (let ((i 0) (x seed) (total 0)) (while (< i n) (setq x (* (* 3.8 x) (- 1 x))) (setq total (+ total x)) (setq i (1+ i))) total)) (export closed)")
             (code (js-call (get backend :compiler) :compile_string source "closed-loop.eli")))
        (funcall assert (js-call code :includes "if (typeof n === \"number\" && typeof seed === \"number\") {"))
        (let* ((fn-text (js-call code :slice (js-call code :indexOf "\nfunction closed(")))
               (fast (js-call fn-text :slice 0 (js-call fn-text :indexOf "} else {"))))
          (funcall assert (not (js-call fast :includes "__eliscript_numeric_")))
          (funcall assert (not (js-call fn-text :includes "=>"))))
        (let ((m (await (import-js-code code)))
              (a (instantiateManagedRuntime bytes)))
          (js-call a :auto 1)
          (js-call (js-array 0 1 3 -0.0 globalThis.NaN -1 2.5 "3") :forEach (lambda (n)
            (js-call (js-array -0.0 globalThis.NaN globalThis.Infinity 0.123 "0.123" hex) :forEach (lambda (seed)
              (funcall assert (Object/is (js-call m :closed n seed)
                                         (funcall (aref expected "scalar-loop") n seed)))
              (check-op a "scalar-loop" (js-array n seed))))))
          (js-call assert :throws (lambda () (js-call m :closed 1 b1)) globalThis.TypeError)
          (let ((random 7973937)
                (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
                (sample 0))
            (let ((next-u32 (lambda ()
                              (setq random (bit-xor random (bit-shift-left random 13)))
                              (setq random (bit-xor random (unsigned-bit-shift-right random 17)))
                              (setq random (bit-xor random (bit-shift-left random 5)))
                              (unsigned-bit-shift-right random 0))))
              (while (< sample 256)
                (js-call bits :setUint32 0 (funcall next-u32) t)
                (js-call bits :setUint32 4 (funcall next-u32) t)
                (let ((seed (js-call bits :getFloat64 0 t))
                      (n (% sample 4))
                      (x 0)
                      (total 0)
                      (i 0))
                  (setq x seed)
                  (while (< i n)
                    (setq x (funcall raw-js-mul (funcall raw-js-mul 3.8 x) (funcall raw-js-sub 1 x)))
                    (setq total (funcall raw-js-add total x))
                    (setq i (+ i 1)))
                  (funcall assert (Object/is (js-call m :closed n seed) total)))
                (setq sample (+ sample 1))))))
        (let* ((input (resolve directory "closed-loop.eli"))
               (output (resolve directory "closed-loop.mjs")))
          (await (writeFile input source))
          (let ((seeded (spawnSync (resolve "bin/eliscript-seed")
                                   (js-array "--output" output input)
                                   (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get seeded :status) 0 (get seeded :stderr)))
          (js-call assert :equal (await (readFile output "utf8")) code)
          (let ((bodies (js-array "(progn (while (< n 0) (setq n (1+ n))) (* seed captured))"
                                  "(let ((x captured)) (while (< n 0) (setq n (1+ n))) (* seed x))"
                                  "(let ((captured 1) (x captured)) (while (< n 0) (setq n (1+ n))) (* seed x))"
                                  "(progn (while (< n 0) (setq captured seed)) seed)"
                                  "(progn (while (< n 0) (js-call seed :valueOf)) seed)"))
                (idx 0))
            (while (< idx (get bodies :length))
              (let* ((body (aref bodies idx))
                     (rejected (js-call (get backend :compiler) :compile_string
                                        (str "(defvar captured \"" hex "\") (defun open (n seed) " body ") (export open)")
                                        "open-loop.eli")))
                (funcall assert (not (js-call rejected :includes "if (typeof n === \"number\""))
                         "free reads, writes and callbacks cannot enter the closed Number profile")
                (when (< idx 3)
                  (let ((rejected-mod (await (import-js-code rejected))))
                    (js-call assert :equal (js-call rejected-mod :open 0 1)
                             (globalThis.Number (globalThis.BigInt hex))))))
              (setq idx (+ idx 1))))
          (let* ((variants (str "(defun flip (n seed) (let ((i 0) (x seed)) (while (< i n) (setq x (- x)) (setq i (1+ i))) x)) "
                                "(defun sequential (n seed) (let* ((x seed) (y (* x 2))) (while (< n 0) (setq n (1+ n))) y)) "
                                "(defun parallel (n seed) (let ((seed (+ seed 1)) (x seed)) (while (< n 0) (setq n (1+ n))) (+ seed x))) "
                                "(defun choices (n seed) (let ((i 0) (x seed)) (while (< i n) (when (< i 1) (setq x (- x))) (unless (< i 1) (setq x (1- x))) (setq i (1+ i))) x)) "
                                "(export flip sequential parallel choices)"))
                 (variant-code (js-call (get backend :compiler) :compile_string variants "scalar-variants.eli"))
                 (v (await (import-js-code variant-code))))
            (js-call (js-array -0.0 0.5 -3 globalThis.NaN globalThis.Infinity) :forEach (lambda (seed)
              (funcall assert (Object/is (js-call v :flip 3 seed) (funcall raw-js-neg seed)))
              (funcall assert (Object/is (js-call v :sequential 0 seed) (funcall raw-js-mul seed 2)))
              (funcall assert (Object/is (js-call v :parallel 0 seed) (funcall raw-js-add (funcall raw-js-add seed 1) seed)))
              (funcall assert (Object/is (js-call v :choices 3 seed) (funcall raw-js-sub (funcall raw-js-sub (funcall raw-js-neg seed) 1) 1)))))
            (js-call assert :equal (js-call v :flip 3 b5) bn5)
            (js-call assert :equal (js-call v :flip "3" b5) bn5)
            (await (writeFile input variants))
            (let ((variant-seed (spawnSync (resolve "bin/eliscript-seed")
                                           (js-array "--output" output input)
                                           (js-object :encoding "utf8" :timeout 30000))))
              (js-call assert :equal (get variant-seed :status) 0 (get variant-seed :stderr)))
            (js-call assert :equal (await (readFile output "utf8")) variant-code))))))

  (defun find-sub-node (node)
    (if (and (not (nullish? node)) (= (funcall js-typeof node) "object"))
      (if (and (= (get node :kind) "intrinsic") (= (get node :value) "-"))
        node
        (let ((vals (Object/values node))
              (i 0)
              (found undefined))
          (while (and (< i (get vals :length)) (undefined? found))
            (setq found (find-sub-node (aref vals i)))
            (setq i (+ i 1)))
          found))
      undefined))

  (test "typed emission restores its private profile after an actual emitter failure and never contaminates dynamic emission"
    (async ()
      (let* ((emitter (await (funcall dyn-import (get (pathToFileURL (resolve directory "bootstrap/emitter.mjs")) :href))))
             (p (js-call (get backend :compiler) :compile_ir_string "(defun f (a b) (- a b)) (export f)" "profile.eli"))
             (operation (find-sub-node p))
             (before (get (js-call emitter :emit_expression operation) :text)))
        (funcall assert (js-call before :includes "__eliscript_numeric_sub"))
        (let ((bad (globalThis.structuredClone p)))
          (put (aref (get bad :body) 0) "kind" "unsupported-module-node")
          (js-call assert :throws (lambda () (js-call emitter :emit_module_numeric bad)))
          (js-call assert :equal (get (js-call emitter :emit_expression operation) :text) before))
        (js-call (get backend :numeric) :emit_numeric_javascript p)
        (js-call assert :equal (get (js-call emitter :emit_expression operation) :text) before)
        (let ((m (await (import-js-code (js-call (get backend :compiler) :emit_ir_string p)))))
          (js-call assert :equal (js-call m :f hex (globalThis.Number (globalThis.BigInt hex))) 0)))))

  (test "conversion callbacks cannot replace the intrinsics used by later numeric conversion"
    (lambda ()
      (let* ((g (funcall js-global))
             (saved (js-object
                      :Number (get g :Number)
                      :BigInt (get g :BigInt)
                      :Symbol (get g :Symbol)
                      :TypeError (get g :TypeError)
                      :apply (get globalThis.Reflect :apply)
                      :trim (get (get globalThis.String :prototype) :trim)
                      :exec (get (get globalThis.RegExp :prototype) :exec)
                      :imul (get globalThis.Math :imul)))
             (result undefined)
             (failure undefined)
             (calls 0)
             (right (js-object))
             (left (js-object
                     :valueOf (lambda ()
                                (put g "Number" (lambda () 99))
                                (put g "BigInt" (lambda () b0))
                                (put g "Symbol" (lambda () undefined))
                                (put g "TypeError" (lambda () undefined))
                                (put globalThis.Reflect "apply" (lambda () (throw (globalThis.Error "replaced apply"))))
                                (put (get globalThis.String :prototype) "trim" (lambda () (throw (globalThis.Error "replaced trim"))))
                                (put (get globalThis.RegExp :prototype) "exec" (lambda () (throw (globalThis.Error "replaced exec"))))
                                (put globalThis.Math "imul" (lambda () 99))
                                1)))
             (sub-fn (get js :subtract)))
        (put right (get (get saved :Symbol) :toPrimitive)
             (lambda ()
               (setq calls (+ calls 1))
               "2"))
        (try
          (setq result (funcall sub-fn left right))
          (catch err
            (setq failure err))
          (finally
            (put g "Number" (get saved :Number))
            (put g "BigInt" (get saved :BigInt))
            (put g "Symbol" (get saved :Symbol))
            (put g "TypeError" (get saved :TypeError))
            (put globalThis.Reflect "apply" (get saved :apply))
            (put (get globalThis.String :prototype) "trim" (get saved :trim))
            (put (get globalThis.RegExp :prototype) "exec" (get saved :exec))
            (put globalThis.Math "imul" (get saved :imul))))
        (js-call assert :equal failure undefined)
        (js-call assert :equal result -1)
        (js-call assert :equal calls 1))))

  (test "radix conversion bounds exact integer parsing after full grammar validation instead of allocating from unbounded prefixes"
    (async ()
      (let ((g (funcall js-global))
            (original globalThis.BigInt)
            (calls 0)
            (m nil))
        (try
          (put g "BigInt"
               (lambda ()
                 (setq calls (+ calls 1))
                 (throw (globalThis.Error "integer parser called"))))
          (setq m (await (import-js-code
                           (str (js-call (get backend :compiler) :emit_ir_string program)
                                "\n// bounded-radix-instance\n"))))
          (finally
            (put g "BigInt" original)))
        (js-call (js-array (str "0x" (js-call "f" :repeat 4096))
                                (str "0b" (js-call "1" :repeat 4096))
                                (str "0o" (js-call "7" :repeat 4096))) :forEach (lambda (text)
          (js-call assert :equal (js-call m :subtract text 0) globalThis.Infinity)))
        (funcall assert (Object/is (js-call m :subtract (str "0x" (js-call "0" :repeat 10000)) 0) 0))
        (funcall assert (Number/isNaN (js-call m :subtract (str "0x" (js-call "f" :repeat 4096) "z") 0)))
        (js-call assert :equal calls 0)
        (js-call assert :throws (lambda () (js-call m :subtract "0xff" 0)) (new globalThis.RegExp "integer parser called"))
        (js-call assert :equal calls 1))))

  (test "ordinary primitive method selection does not invoke a user replacement Array iterator"
    (lambda ()
      (let* ((key globalThis.Symbol.iterator)
             (proto (get globalThis.Array :prototype))
             (original (aref proto key))
             (result undefined)
             (failure undefined)
             (sub-fn (get js :subtract)))
        (try
          (put proto key (lambda () (throw (globalThis.Error "observable Array iterator"))))
          (setq result (funcall sub-fn (js-object :valueOf (lambda () 5)) 2))
          (catch err
            (setq failure err))
          (finally
            (put proto key original)))
        (js-call assert :equal failure undefined)
        (js-call assert :equal result 3))))

  (test "a module binding named globalThis retains lexical references, raw JS and public exports without shadowing numeric intrinsics"
    (async ()
      (let* ((source "(defvar globalThis 7) (defun value () globalThis) (defun raw () (js* \"globalThis\")) (defun change (x) (setq globalThis x)) (defun subtract (x y) (- x y)) (defun word (x y) (imul32 x y)) (export globalThis value raw change subtract word)")
             (p (js-call (get backend :compiler) :compile_ir_string source "global-root-shadow.eli"))
             (code (js-call (get backend :compiler) :emit_ir_string p))
             (m (await (import-js-code code)))
             (hex-num (globalThis.Number (globalThis.BigInt hex))))
        (js-call assert :equal (get m :globalThis) 7)
        (js-call assert :equal (js-call m :value) 7)
        (js-call assert :equal (js-call m :raw) 7)
        (js-call assert :equal (js-call m :subtract hex hex-num) 0)
        (js-call m :change 8)
        (js-call assert :equal (get m :globalThis) 8)
        (js-call assert :equal (js-call m :raw) 8)
        (js-call assert :equal (js-call m :word 3 5) 15)
        (let* ((input (resolve directory "global-root-shadow.eli"))
               (output (resolve directory "global-root-shadow.mjs")))
          (await (writeFile input source))
          (let ((seed (spawnSync (resolve "bin/eliscript-seed")
                                 (js-array "--output" output input)
                                 (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get seed :status) 0 (get seed :stderr)))
          (js-call assert :equal (await (readFile output "utf8")) code)
          (let ((node-res (spawnSync "node"
                                     (js-array (helper-script-path) "global" (get (pathToFileURL output) :href) hex)
                                     (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get node-res :status) 0 (get node-res :stderr)))
          (let ((bundle (await (js-call globalThis.Bun :build
                                        (js-object :entrypoints (js-array output) :target "browser" :write false)))))
            (funcall assert (get bundle :success)
                     (js-call (js-call (get bundle :logs) :map (lambda (x) (globalThis.String x))) :join "\n"))
            (let ((bundled (await (import-js-code (await (js-call (aref (get bundle :outputs) 0) :text))))))
              (js-call assert :equal (js-call bundled :subtract hex hex-num) 0)
              (js-call assert :equal (js-call bundled :raw) 7)))))))

  (test "unconvertible objects, invalid lifetimes and real traps preserve caller roots and the earlier error"
    (async ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes))
             (bad (js-call a :sourceObject (js-object :toString false :valueOf false)))
             (one (js-call a :number 1))
             (foreign (js-call b :string "1"))
             (stale (js-call a :string "2"))
             (caller (js-call a :frame 1)))
        (js-call a :frameSet caller 0 one)
        (js-call a :release stale)
        (js-call a :collect)
        (js-call (js-array (js-array "add" (js-array bad one) "ELI-RT0003")
                                (js-array "subtract" (js-array one bad) "ELI-RT0003")
                                (js-array "signed" (js-array bad) "ELI-RT0003")
                                (js-array "less" (js-array one bad) "ELI-RT0003")
                                (js-array "add" (js-array foreign one) "ELI-RT0001")
                                (js-array "add" (js-array stale one) "ELI-RT0001")) :forEach (lambda (spec)
          (let ((name (aref spec 0))
                (args (aref spec 1))
                (code (aref spec 2)))
            (js-call assert :throws
              (lambda () (js-call a :invoke name args))
              (lambda (e)
                (let ((diag (get e :eliscriptDiagnostic)))
                  (and (not (nullish? diag))
                       (= (get diag :code) code)))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call assert :equal (js-call a :readNumber one) 1))))
        (js-call a :leaveFrame caller)
        (js-call a :release bad)
        (js-call a :release one)
        (js-call b :release foreign)
        (js-call a :collect)
        (js-call b :collect)
        (js-call assert :equal (js-call a :live) 0))
      (let* ((source (await (readFile "bootstrap/runtime/memory.eli" "utf8")))
             (start (js-call source :indexOf "  (defun value-truth (heap value)"))
             (end (js-call source :indexOf "  (defun " (+ start 3))))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((rt (js-call (get backend :compiler) :compile_ir_string
                            (str (js-call source :slice 0 start)
                                 "  (defun value-truth (heap value) (load-u32 4294967295))\n"
                                 (js-call source :slice end))
                            "later-trap.eli"))
               (ir (js-call (get backend :compiler) :compile_ir_string
                            "(defun fault (x y) (progn (- x y) (if x 1 2))) (export fault)"
                            "primitive-fault.eli"))
               (rt-inst (instantiateManagedRuntime
                          (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm ir rt))))
               (obj (js-call rt-inst :sourceObject (js-object :toString false :valueOf false)))
               (text (js-call rt-inst :string "2"))
               (n (js-call rt-inst :number 1))
               (frame (js-call rt-inst :frame 1)))
          (js-call rt-inst :frameSet frame 0 n)
          (js-call assert :throws
            (lambda () (js-call rt-inst :invoke "fault" (js-array obj n)))
            (lambda (e)
              (let ((diag (get e :eliscriptDiagnostic)))
                (and (not (nullish? diag))
                     (= (get diag :code) "ELI-RT0003")))))
          (js-call assert :throws
            (lambda () (js-call rt-inst :invoke "fault" (js-array text n)))
            (lambda (e) (funcall is-instance e globalThis.WebAssembly.RuntimeError)))
          (js-call assert :equal (get (js-call rt-inst :stats) :frameDepth) 1)
          (js-call assert :equal (js-call rt-inst :readString text) "2")
          (js-call rt-inst :leaveFrame frame)
          (js-call (js-array obj text n) :forEach (lambda (v)
            (js-call rt-inst :release v)))
          (js-call rt-inst :collect)
          (js-call assert :equal (js-call rt-inst :live) 0)))))

  (test "raw primitive conversion roots borrowed operands before its first frame allocation and survives growth and capacity failure"
    (lambda ()
      (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
             (call-exp (lambda (name &rest args)
                         (let ((out (unsigned-bit-shift-right (apply (aref e name) args) 0)))
                           (js-call assert :equal (funcall (aref e "last-error")) 0 name)
                           out)))
             (heap (funcall call-exp "heap-new" 16 1024 65536))
             (retained (funcall call-exp "value-number" heap 0 1079558144))
             (frame (funcall call-exp "frame-new" heap 1)))
        (funcall call-exp "frame-set" heap frame 0 retained)
        (let* ((make-text (lambda (s)
                            (let ((id (funcall call-exp "value-string" heap (get s :length)))
                                  (i 0))
                              (while (< i (get s :length))
                                (funcall call-exp "value-unit-set" heap id i (js-call s :charCodeAt i))
                                (setq i (+ i 1)))
                              (funcall call-exp "value-seal" heap id)
                              id)))
               (left (funcall make-text "-0"))
               (right (funcall make-text "2")))
          (funcall call-exp "heap-auto" heap 1)
          (let* ((result (funcall call-exp "value-primitive-binary" heap left right 2))
                 (data (funcall call-exp "value-data" heap result 4)))
            (funcall assert (Object/is (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 data t) -0.0))
            (js-call assert :equal (funcall call-exp "frame-depth" heap) 1)
            (js-call assert :equal (funcall call-exp "frame-get" heap frame 0) retained)
            (funcall assert (> (funcall call-exp "heap-capacity" heap) 1024))
            (funcall assert (> (funcall call-exp "heap-collections" heap) 0)))
          (funcall call-exp "frame-pop" heap frame)
          (funcall call-exp "heap-collect" heap)
          (js-call assert :equal (funcall call-exp "heap-live" heap) 0)))
      (let ((small (instantiateManagedRuntime bytes (js-object :maxSlots 32 :initialBytes 1024 :maxBytes 1024))))
        (js-call small :auto 1)
        (let* ((s (js-call small :string "1.5"))
               (n (js-call small :number -0.0))
               (caller (js-call small :frame 1)))
          (js-call small :frameSet caller 0 n)
          (js-call assert :throws
            (lambda () (js-call small :invoke "multiply" (js-array s n)))
            (lambda (x)
              (let ((diag (get x :eliscriptDiagnostic)))
                (and (not (nullish? diag))
                     (= (get diag :code) "ELI-RT0002")))))
          (js-call assert :equal (get (js-call small :stats) :frameDepth) 1)
          (js-call assert :equal (js-call small :readString s) "1.5")
          (funcall assert (Object/is (js-call small :readNumber n) -0.0))
          (js-call small :leaveFrame caller)
          (js-call small :release s)
          (js-call small :release n)
          (js-call small :collect)
          (js-call assert :equal (js-call small :live) 0)))))

  (test "Node executes the identical zero-import mixed primitive artifact and generated JS with exact Number and lifetime semantics"
    (async ()
      (let ((wasm (resolve directory "primitive.wasm"))
            (mod-path (resolve directory "primitive.mjs")))
        (await (writeFile wasm bytes))
        (await (writeFile mod-path (js-call (get backend :compiler) :emit_ir_string program)))
        (let ((child (spawnSync "node"
                                (js-array (helper-script-path) "wasm" wasm (get (pathToFileURL mod-path) :href))
                                (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))))))
