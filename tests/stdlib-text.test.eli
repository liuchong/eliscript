(module tests.stdlib-text
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (test "portable text library compiles and executes as an ESM module" (async ()
    (let* ((directory (await (mkdtemp (resolve ROOT ".eliscript-text-"))))
           (library (resolve directory "text.mjs")) (usage (resolve directory "text-usage.mjs")))
      (try
        (await (compile (resolve ROOT "stdlib/text.eli") library))
        (let ((output (await (compile (resolve ROOT "tests/fixtures/text-usage.eli") usage))))

          (same (JSON/parse (await (runSuccessful (js-array "bun" "run" usage) (js-object)))) (js-object "empty" t "not-empty" false "slice" "bcd" "slice-clamped" "abc" "slice-reversed" "" "starts-at" t "starts-at-negative" false "starts" t "starts-missing" false "ends" t "ends-too-long" false "contains" t "contains-empty" t "contains-missing" false "stripped-prefix" "article" "kept-prefix" "article" "stripped-suffix" "text" "kept-suffix" "text.mjs" "space" t "letter-space" false "trimmed" "Eliscript" "trimmed-empty" "" "blank" t "not-blank" false "joined" "a/2/false" "joined-empty" "" "repeated" "ababab" "repeat-negative" "")))
        (await (checkMap library (js-array "(defportable trim")))
        (finally (await (rm directory (js-object :recursive t :force t)))))))))
