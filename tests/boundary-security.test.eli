(module tests.boundary-security.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:process" :default process)
  (import "node:fs/promises" link mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:os" tmpdir)
  (import "node:path" dirname relative resolve)
  (import "node:url" pathToFileURL)
  (import "../bootstrap/host/project.mjs" buildProject)
  (import "../bootstrap/host/project-cli.mjs" parseConfigurationJson)
  (import "../platform/worker.mjs" workerCapabilities workerCapabilityDescriptor workerProgress)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst BOOTSTRAP (resolve ROOT "bin/eliscript-bootstrap"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defconst SEED_BUILD (resolve ROOT "bin/eliscript-seed-build"))
  (defconst PROJECT_HOST (get (pathToFileURL (resolve ROOT "bootstrap/host/project.mjs")) :href))
  (defconst PROJECT_DRIVER (resolve ROOT "tests/fixtures/boundary-project-host.mjs"))
  (defconst WORKER (resolve ROOT "runtime/worker.mjs"))
  (defconst NODE (if (nullish? (get (get process :env) :NODE)) "node" (get (get process :env) :NODE)))
  (defvar directory undefined) (defvar compilerDirectory undefined) (defvar compiler undefined)
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))
  (defun contains (a b) (js-call (expect a) :toContain b))
  (defun nonzero (code) (js-call (get (expect code) :not) :toBe 0))
  (defasync runResult (command &rest __host_forwarded_arguments_1)
    (let* ((options (aref __host_forwarded_arguments_1 0)))
    (let* ((child (Bun/spawn command (Object/assign (js-object :cwd ROOT :stdout "pipe" :stderr "pipe") options)))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2)))))
  (defasync runSuccessful (command &rest __host_forwarded_arguments_2)
    (let* ((options (aref __host_forwarded_arguments_2 0)))
    (let ((result (await (runResult command options))))
      (unless (= (get result :exitCode) 0)
        (let ((err (js-call (get result :stderr) :trim)) (out (js-call (get result :stdout) :trim)))
          (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str (aref command 0) " exited with " (get result :exitCode))))))))
      (get result :stdout))))
  (defasync nodeProjectResult (options)
    (runResult (js-array NODE PROJECT_DRIVER) (js-object :env (Object/assign (js-object) (get process :env)
      (js-object :ELISCRIPT_PROJECT_HOST PROJECT_HOST :ELISCRIPT_OPTIONS (JSON/stringify options))))))
  (defasync expectProjectRejection (options message &rest __host_forwarded_arguments_3)
    (let* ((seedArguments (aref __host_forwarded_arguments_3 0)))
    (await (js-call (get (expect (buildProject options)) :rejects) :toThrow message))
    (let ((node (await (nodeProjectResult options)))) (nonzero (get node :exitCode)) (contains (get node :stderr) message))
    (when seedArguments
      (let ((seed (await (runResult (js-call (js-array SEED_BUILD) :concat seedArguments)))))
        (nonzero (get seed :exitCode)) (contains (get seed :stderr) message)))))
  (defun createWorkerClient (command)
    (let* ((child (Bun/spawn (js-array command WORKER) (js-object :cwd ROOT :stdin "pipe" :stdout "pipe" :stderr "pipe")))
           (messages (js-array)) (waiters (js-array)) (decoder (new globalThis.TextDecoder)) (buffer "") (closed false))
      (letfn ((deliver (message)
        (let ((index (js-call waiters :findIndex (lambda (waiter) (funcall (get waiter :predicate) message)))))
          (if (= index -1) (js-call messages :push message)
            (let ((waiter (aref (js-call waiters :splice index 1) 0)))
              (globalThis.clearTimeout (get waiter :timer)) (funcall (get waiter :resolve) message)))))
        (send (message)
          (js-call (get child :stdin) :write (str (JSON/stringify message) "\n")) (js-call (get child :stdin) :flush))
        (next (predicate &rest __opt_timeout)
          (let* ((rawTimeout (aref __opt_timeout 0))
                 (timeoutMs (if (= rawTimeout undefined) 5000 rawTimeout))
                 (index (js-call messages :findIndex predicate)))
            (if (not (= index -1)) (Promise/resolve (aref (js-call messages :splice index 1) 0))
              (if closed (Promise/reject (new globalThis.Error "worker output closed"))
                (new globalThis.Promise (lambda (resolve_ reject)
                  (let ((waiter (js-object :predicate predicate :resolve resolve_ :reject reject :timer undefined)))
                    (put waiter :timer (globalThis.setTimeout (lambda ()
                      (let ((waiterIndex (js-call waiters :indexOf waiter)))
                        (unless (= waiterIndex -1) (js-call waiters :splice waiterIndex 1)))
                      (reject (new globalThis.Error "timed out waiting for worker message"))) timeoutMs))
                    (js-call waiters :push waiter)))))))))
        (let* ((outputTask (funcall (async ()
            (let* ((stream (get child :stdout)) (iterator (Reflect/apply (get stream (get globalThis.Symbol :asyncIterator)) stream (js-array))) (done false))
              (while (not done)
                (let ((step (await (js-call iterator :next))))
                  (if (get step :done) (setq done t)
                    (progn
                      (setq buffer (str buffer (js-call decoder :decode (get step :value) (js-object :stream t))))
                      (let ((newline (js-call buffer :indexOf "\n")))
                        (while (not (= newline -1))
                          (let ((line (js-call buffer :slice 0 newline)))
                            (setq buffer (js-call buffer :slice (1+ newline)))
                            (when (> (get line :length) 0) (deliver (JSON/parse line))))
                          (setq newline (js-call buffer :indexOf "\n")))))))))
            (setq closed t)
            (js-call (js-call waiters :splice 0) :forEach (lambda (waiter)
              (globalThis.clearTimeout (get waiter :timer)) (funcall (get waiter :reject) (new globalThis.Error "worker output closed")))))))
               (stderrTask (js-call (new globalThis.Response (get child :stderr)) :text)))
          (js-object :child child :send send :next next :close (async ()
            (unless closed
              (send (js-object :version 1 :type "shutdown"))
              (await (next (lambda (message) (= (get message :type) "shutdown"))))
              (js-call (get child :stdin) :end))
            (let ((exitCode (await (get child :exited)))) (await outputTask) (js-object :exitCode exitCode :stderr (await stderrTask)))))))))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-boundary-security-"))) compilerDirectory (resolve directory "compiler"))
    (await (runSuccessful (js-array BOOTSTRAP) (js-object :env (Object/assign (js-object) (get process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR compilerDirectory)))))
    (setq compiler (await (funcall (js* "(specifier) => import(specifier)") (str (get (pathToFileURL (resolve compilerDirectory "compiler.mjs")) :href) "?security"))))) 30000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defasync containmentRejection (root entry outDir)
    (expectProjectRejection (js-object :root root :entry entry :outDir outDir :moduleDirectory compilerDirectory :useCache false)
      "escapes project root" (js-array "--no-cache" "--root" root "--out-dir" outDir entry)))
  (defasync projectAttack (name setup expected)
    (let* ((parent (resolve directory (str "project-output-" name))) (root (resolve parent "source"))
           (outDir (resolve parent "output")) (entry (resolve root "main.eli"))
           (options (js-object :root root :entry entry :outDir outDir :moduleDirectory compilerDirectory :useCache false)))
      (await (mkdir root (js-object :recursive t))) (await (mkdir outDir (js-object :recursive t))) (await (writeFile entry "(print 42)\n"))
      (await (setup (js-object :parent parent :root root :outDir outDir :entry entry :options options)))
      (await (expectProjectRejection options expected (js-array "--no-cache" "--root" root "--out-dir" outDir entry)))
      (be (await (readFile entry "utf8")) "(print 42)\n")))
  (test "boundary matrix rejects direct and symbolic project-root escapes" (async ()
    (let* ((parent (resolve directory "root-containment")) (root (resolve parent "project")) (outside (resolve parent "outside.eli")) (entry (resolve root "main.eli")))
      (await (mkdir root (js-object :recursive t)))
      (await (writeFile outside "(defconst value 42)\n(export value)\n")) (await (writeFile entry "(print 1)\n"))
      (await (containmentRejection root outside (resolve parent "direct-out")))
      (let ((linkedEntry (resolve root "linked.eli")))
        (await (symlink outside linkedEntry))
        (await (containmentRejection root linkedEntry (resolve parent "linked-out"))))
      (await (writeFile entry "(import \"../outside.eli\" value)\n(print value)\n"))
      (await (containmentRejection root entry (resolve parent "import-out")))
      (await (writeFile entry "(import \"./linked.eli\" value)\n(print value)\n"))
      (await (containmentRejection root entry (resolve parent "import-link-out")))
      (let ((macroOutside (resolve parent "outside.txt")) (linkedMacro (resolve root "linked-macro.txt")))
        (await (writeFile macroOutside "outside"))
        (await (js-call (get (expect (buildProject (js-object :root root :entry entry :outDir (resolve parent "macro-direct-out") :moduleDirectory compilerDirectory
          :macroCapabilities (js-array "read-file") :macroFileDependencies (js-array "../outside.txt")))) :rejects) :toThrow "project request macro file dependencies are invalid"))
        (await (symlink macroOutside linkedMacro))
        (await (js-call (get (expect (buildProject (js-object :root root :entry entry :outDir (resolve parent "macro-link-out") :moduleDirectory compilerDirectory
          :macroCapabilities (js-array "read-file") :macroFileDependencies (js-array "linked-macro.txt")))) :rejects) :toThrow "macro file dependency escapes project root"))))))
  (test "boundary matrix denies undeclared macro and worker capabilities" (lambda ()
    (let ((source "(defmacro configured-value ()\n  (macro-read-file \"build-value.txt\"))\n(defconst value (configured-value))"))
      (js-call (expect (lambda () (js-call compiler :compile_ir_string source "capability.eli"))) :toThrow "macro capability is not enabled: read-file")
      (js-call (expect (lambda () (js-call compiler :compile_ir_string source "capability.eli"
        (js-object :capabilities (new globalThis.Set (js-array "read-file")) :files (new globalThis.Map))))) :toThrow "macro file dependency is not declared: build-value.txt")
      (js-call (expect (lambda () (js-call compiler :project_configuration (js-object :schemaVersion 1 :entry "main.eli" :outDir "dist" :macroCapabilities (js-array "network")) "eliscript.json")))
        :toThrow "unsupported macro capability: network"))
    (let ((progressOnly (workerCapabilities (js-object :progress (lambda () undefined)) (js-array "progress"))))
      (same (get (workerCapabilityDescriptor progressOnly) :grants) (js-array "progress"))
      (js-call (expect (lambda () (workerCapabilities (js-object) (js-array "process")))) :toThrow "unknown worker capability process")
      (js-call (expect (lambda () (workerProgress (Object/assign (js-object) (workerCapabilityDescriptor progressOnly))))) :toThrow "expected Eliscript worker capabilities"))))
  (test "boundary matrix rejects configuration and worker protocol mismatches" (async ()
    (js-call (js-array
      (js-object :schemaVersion 3 :entry "main.eli" :outDir "dist")
      (js-object :schemaVersion 1 :entry "../main.eli" :outDir "dist")
      (js-object :schemaVersion 1 :entry "main.eli" :outDir "dist" :extra t)
      (js-object :schemaVersion 2 :entries (js-array) :outDir "dist")) :forEach (lambda (invalid)
        (js-call (expect (lambda () (js-call compiler :project_configuration invalid "eliscript.json"))) :toThrow)))
    (js-call (expect (lambda () (parseConfigurationJson "{\"schemaVersion\":1,\"entry\":\"main.eli\",\"\\u0065ntry\":\"other.eli\",\"outDir\":\"dist\"}" "eliscript.json")))
      :toThrow "duplicate configuration key: entry")
    (let ((client (createWorkerClient (get process :execPath))))
      (try
        (await (js-call client :next (lambda (message) (= (get message :type) "ready"))))
        (js-call client :send (js-object :version 2 :type "request" :id "wrong-version"))
        (js-call (expect (await (js-call client :next (lambda (message) (= (get message :id) "wrong-version"))))) :toMatchObject (js-object :type "protocol-error" :error (js-object :code "version-mismatch")))
        (js-call client :send (js-object :version 1 :type "request" :id "ambiguous-operation" :module "/tmp/never-loaded.mjs" :export "run" :operation "run" :arguments (js-array)))
        (js-call (expect (await (js-call client :next (lambda (message) (= (get message :id) "ambiguous-operation"))))) :toMatchObject (js-object :ok false :error (js-object :code "invalid-request")))
        (js-call client :send (js-object :version 1 :type "request" :id "remote-module" :module "https://example.invalid/module.mjs" :export "run" :arguments (js-array)))
        (let ((remote (await (js-call client :next (lambda (message) (= (get message :id) "remote-module"))))))
          (js-call (expect (get remote :ok)) :toBeFalse) (contains (get (get remote :error) :message) "worker modules must use local file URLs"))
        (js-call client :send (js-object :version 1 :type "future-message" :id "unknown-type"))
        (js-call (expect (await (js-call client :next (lambda (message) (= (get message :id) "unknown-type"))))) :toMatchObject (js-object :type "protocol-error" :error (js-object :code "invalid-message")))
        (be (get (await (js-call client :close)) :exitCode) 0)
        (finally (let ((child (get client :child))) (when (= (get child :exitCode) nil) (js-call child :kill) (await (get child :exited)))))))))
  (test "boundary matrix prevents generated artifacts from overwriting inputs" (async ()
    (let* ((direct (resolve directory "direct-output")) (directSource (resolve direct "main.eli")) (sourceText "(defportable answer () 42)\n(export answer)\n"))
      (await (mkdir direct (js-object :recursive t))) (await (writeFile directSource sourceText))
      (let ((cases (js-array (js-array "--output" directSource directSource) (js-array "--portable" "answer" "--output" directSource directSource))) (i 0))
        (while (< i (get cases :length))
          (let ((result (await (runResult (js-call (js-array COMPILER) :concat (aref cases i))))))
            (nonzero (get result :exitCode)) (contains (get result :stderr) "must not overwrite input file") (be (await (readFile directSource "utf8")) sourceText))
          (setq i (1+ i))))
      (let ((linkedOutput (resolve direct "linked.mjs")))
        (await (symlink directSource linkedOutput))
        (let ((linked (await (runResult (js-array COMPILER "--output" linkedOutput directSource)))))
          (nonzero (get linked :exitCode)) (contains (get linked :stderr) "must not overwrite input file") (be (await (readFile directSource "utf8")) sourceText)))
      (let ((mappedOutput (resolve direct "mapped.mjs")))
        (await (symlink directSource (str mappedOutput ".map")))
        (let ((mapped (await (runResult (js-array COMPILER "--source-map" "--output" mappedOutput directSource)))))
          (nonzero (get mapped :exitCode)) (contains (get mapped :stderr) "must not overwrite input file") (be (await (readFile directSource "utf8")) sourceText)))
      (let ((aliasOutput (resolve direct "alias.mjs")))
        (await (writeFile aliasOutput "existing output\n")) (await (link aliasOutput (str aliasOutput ".map")))
        (let ((aliased (await (runResult (js-array COMPILER "--source-map" "--output" aliasOutput directSource)))))
          (nonzero (get aliased :exitCode)) (contains (get aliased :stderr) "must be physically distinct"))))
    (await (projectAttack "output-link" (async (context) (symlink (get context :entry) (resolve (get context :outDir) "main.mjs"))) "generated artifact escapes output directory"))
    (await (projectAttack "map-hard-link" (async (context) (link (get context :entry) (resolve (get context :outDir) "main.mjs.map"))) "generated artifact would overwrite an input"))
    (await (projectAttack "manifest-link" (async (context) (symlink (get context :entry) (resolve (get context :outDir) "eliscript-project.json"))) "generated artifact escapes output directory"))
    (let* ((escapedParent (resolve directory "project-output-directory-link")) (escapedRoot (resolve escapedParent "source")) (escapedOut (resolve escapedParent "output"))
           (outsideOut (resolve escapedParent "outside-output")) (nestedEntry (resolve escapedRoot "nested/main.eli")))
      (await (mkdir (dirname nestedEntry) (js-object :recursive t))) (await (mkdir escapedOut (js-object :recursive t))) (await (mkdir outsideOut (js-object :recursive t)))
      (await (writeFile nestedEntry "(print 42)\n")) (await (symlink outsideOut (resolve escapedOut "nested") "dir"))
      (await (expectProjectRejection (js-object :root escapedRoot :entry nestedEntry :outDir escapedOut :moduleDirectory compilerDirectory :useCache false)
        "generated artifact escapes output directory" (js-array "--no-cache" "--root" escapedRoot "--out-dir" escapedOut nestedEntry))))
    (let* ((macroParent (resolve directory "project-output-macro-input")) (macroRoot (resolve macroParent "source"))
           (macroEntry (resolve macroRoot "main.eli")) (macroInput (resolve macroRoot "main.mjs"))
           (macroOptions (js-object :root macroRoot :entry macroEntry :outDir macroRoot :moduleDirectory compilerDirectory :macroCapabilities (js-array "read-file") :macroFileDependencies (js-array "main.mjs") :useCache false)))
      (await (mkdir macroRoot (js-object :recursive t))) (await (writeFile macroEntry "(print 42)\n")) (await (writeFile macroInput "protected macro input\n"))
      (await (js-call (get (expect (buildProject macroOptions)) :rejects) :toThrow "generated artifact would overwrite an input"))
      (let ((macroNode (await (nodeProjectResult macroOptions)))) (nonzero (get macroNode :exitCode)) (contains (get macroNode :stderr) "generated artifact would overwrite an input"))
      (let ((configuration (resolve macroParent "eliscript.json")))
        (await (writeFile configuration (str (JSON/stringify (js-object :schemaVersion 1 :sourceRoot (relative macroParent macroRoot) :entry "main.eli" :outDir (relative macroParent macroRoot)
          :macroCapabilities (js-array "read-file") :macroFileDependencies (js-array "main.mjs") :cache false)) "\n")))
        (let ((macroSeed (await (runResult (js-array SEED_BUILD "--config" configuration)))))
          (nonzero (get macroSeed :exitCode)) (contains (get macroSeed :stderr) "generated artifact would overwrite an input")))
      (be (await (readFile macroInput "utf8")) "protected macro input\n"))) 60000)
)
