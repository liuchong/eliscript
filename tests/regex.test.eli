(module tests.regex
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst root (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst units (js-array (js-array "stdlib/core/regex.eli" "stdlib/core/regex.eli") (js-array "tests/fixtures/regex.eli" "tests/fixtures/regex.mjs")))
  (defconst hostFixture (resolve root "tests/fixtures/regex-host.mjs"))
  (defasync compileFamily (command outputRoot environment)
    (await (mkdir outputRoot (js-object :recursive t)))
    (await (symlink (resolve root "runtime") (resolve outputRoot "runtime") "dir"))
    (let ((index 0))
      (while (< index (js-length units))
        (let* ((unit (aref units index)) (target (resolve outputRoot (aref unit 1))))
          (await (mkdir (dirname target) (js-object :recursive t)))
          (await (runSuccessful (js-array command "--source-map" "--output" target (resolve root (aref unit 0))) environment)))
        (setq index (1+ index)))))
  (import "../runtime/core/regex.mjs" compileRegex isRegexPattern regexFind regexFlags regexMatches regexReplace regexSequence regexSource)
  (import "../runtime/core/lazy-sequence.mjs" isLazySequence realizedLazySequenceCount)
  (defun raises (operation message) (js-call (expect operation) :toThrow message))
  (test "regex patterns are immutable deterministic values" (lambda ()
    (let ((pattern (compileRegex "[a-z]+" "umi")))
      (be (Object/isFrozen pattern) t) (be (isRegexPattern pattern) t) (be (isRegexPattern (js* "/[a-z]+/u")) false)
      (be (regexSource pattern) "[a-z]+") (be (regexFlags pattern) "imu")
      (raises (lambda () (compileRegex "(")) "regex source is invalid")
      (raises (lambda () (compileRegex "x" "gg")) "unsupported flag: g")
      (raises (lambda () (compileRegex "x" "ii")) "duplicate flag: i"))))
  (test "regex matching preserves captures absence and start offsets" (lambda ()
    (let ((pattern (compileRegex "(a)(b)?")))
      (same (Array/from (regexMatches pattern "ab")) (js-array "ab" "a" "b"))
      (same (Array/from (regexMatches pattern "a")) (js-array "a" "a" nil))
      (js-call (expect (regexMatches pattern "za")) :toBeNull)
      (same (Array/from (regexFind pattern "zza yyab")) (js-array "a" "a" nil))
      (same (Array/from (regexFind pattern "zza yyab" 4)) (js-array "ab" "a" "b"))
      (js-call (expect (regexFind pattern "none")) :toBeNull))))
  (test "regex sequences are memoized and advance zero-width Unicode matches" (lambda ()
    (let ((matches (regexSequence (compileRegex "(?=.)" "u") "😀a")))
      (be (isLazySequence matches) t) (be (realizedLazySequenceCount matches) 0)
      (same (Array/from matches) (js-array "" "")) (be (realizedLazySequenceCount matches) 2)
      (same (Array/from matches) (js-array "" "")) (be (realizedLazySequenceCount matches) 2))))
  (test "regex replacement is global literal and callback driven" (lambda ()
    (let ((digits (compileRegex "(\\d+)")))
      (be (regexReplace digits "$&" "a12b3") "a$&b$&")
      (be (regexReplace digits (lambda (match index text) (be text "a12b3") (str index ":" (js-call match :nth 1))) "a12b3") "a1:12b4:3")
      (raises (lambda () (regexReplace digits (lambda () 42) "1")) "must return a string"))))
  (test "regex APIs reject mutable host patterns and malformed calls" (lambda ()
    (let ((pattern (compileRegex "x")))
      (raises (lambda () (regexFind (js* "/x/") "x")) "Eliscript regex pattern")
      (raises (lambda () (regexFind pattern)) "optional start")
      (raises (lambda () (regexFind pattern "x" -1)) "non-negative safe integer")
      (raises (lambda () (regexSequence pattern 42)) "input must be a string")
      (raises (lambda () (regexReplace pattern 42 "x")) "string or function"))))
  (test "Eliscript regex APIs agree across compilers and local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-regex-"))))
           (bootstrapDirectory (resolve directory "bootstrap")) (seedDirectory (resolve directory "seed")) (selfHostedDirectory (resolve directory "self-hosted")))
      (try
        (await (compileFamily (resolve root "bin/eliscript-seed") seedDirectory (js-object)))
        (await (seedCompilerFixture bootstrapDirectory))
        (await (compileFamily (resolve root "bin/eliscript-portable") selfHostedDirectory (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))
        (let ((index 0))
          (while (< index (js-length units))
            (let* ((relative (aref (aref units index) 1)) (seed (resolve seedDirectory relative)) (selfHosted (resolve selfHostedDirectory relative)))
              (be (await (readFile selfHosted "utf8")) (await (readFile seed "utf8")))
              (be (await (readFile (str selfHosted ".map") "utf8")) (await (readFile (str seed ".map") "utf8"))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (directories (js-array seedDirectory selfHostedDirectory)) (index 0))
          (while (< index 2)
            (let* ((modulePath (resolve (aref directories index) "tests/fixtures/regex.mjs"))
                   (argument modulePath))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array "bun" "--preload" (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs") hostFixture argument) (js-object)))))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array (get (get globalThis.process :env) :NODE "node") "--experimental-loader" (resolve root "tests/fixtures/compiled-eli-node-loader.mjs") hostFixture argument) (js-object))))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (aref reports 0) (js-object "pattern" t "source" "[a-z]+" "flags" "im" "matches" "Alpha" "find" "beta" "from" "SECOND" "sequence" (js-array "one" "THREE") "replaced" "a#b#")))

        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
