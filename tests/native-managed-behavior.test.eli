(module tests.native-managed-behavior.test
  (import "bun:test" afterAll beforeAll describe test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm)
  (import "node:fs" readFileSync)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst root (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst sourceRoot (resolve (let ((value (get (get globalThis.process :env) :ELISCRIPT_NATIVE_MANAGED_SOURCE_ROOT))) (if (nullish? value) root value))))
  (defconst catalog (JSON/parse (readFileSync (resolve sourceRoot "tests/fixtures/wasm-managed-behavior.json") "utf8")))
  (js-call assert :equal (get catalog :format) "eliscript-managed-bdd") (js-call assert :equal (get catalog :version) 1)
  (defconst scenarios (js-call (get catalog :features) :flatMap (lambda (feature) (get feature :scenarios))))
  (js-call assert :equal (get scenarios :length) 101 "reuse every accepted managed BDD scenario")
  (js-call assert :equal (get (new globalThis.Set (js-call scenarios :map (lambda (scenario) (get scenario :id)))) :size) (get scenarios :length))
  (defconst nativeTest (js-call test :skipIf (or (not (= (get globalThis.process :platform) "darwin")) (not (= (get globalThis.process :arch) "arm64")))))
  (defvar directory undefined) (defvar b undefined) (defvar runtime undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-managed-bdd-"))))
    (let ((module (await (funcall load-module (get (pathToFileURL (resolve sourceRoot "tools/backends/build.mjs")) :href)))))
      (setq b (await (js-call module :buildBackends (js-object :outputRoot directory)))))
    (let ((path (resolve (get b :directory) "native-under-test.mjs")))
      (await (writeFile path (js-call (get b :compiler) :compile_string (await (readFile (resolve root "bootstrap/backends/native.eli") "utf8")) "native.eli")))
      (put b :native (await (funcall load-module (get (pathToFileURL path) :href)))))
    (setq runtime (js-call (get b :compiler) :compile_ir_string (await (readFile (resolve sourceRoot "bootstrap/runtime/memory.eli") "utf8")) "runtime.eli"))) 120000)
  (afterAll (async () (unless (nullish? directory) (await (rm directory (js-object :recursive t :force t))))))
  (defun observe (a value)
    (if (or (= value nil) (not (= (funcall host-typeof value) "object"))) value
      (cond ((= (get value :kind) 4) (js-call a :readNumber value)) ((= (get value :kind) 5) (js-call a :readString value))
        (t (js-call assert :equal (get value :kind) 14 "BDD results use ordinary source arrays")
          (Array/from (js-object :length (js-call a :length value)) (lambda (unused index)
            (let ((item (js-call a :get value index))) (try (observe a item) (finally (js-call a :release item))))))))))
  (defun diagnosticCode (error) (let ((d (get error :eliscriptDiagnostic))) (if (nullish? d) undefined (get d :code))))
  (defasync scenarioCase (scenario)
    (let* ((filename (str "bdd-" (get scenario :id) ".eli"))
           (source (str ";中😀\n(defconst marker 1)\n" (get scenario :source) "\n(export run" (if (Object/hasOwn scenario "recover") " recover" "") ")"))
           (program (js-call (get b :compiler) :compile_ir_string source filename))
           (before (JSON/stringify program)) (runtimeBefore (JSON/stringify runtime))
           (javascript (js-call (js-call (get b :compiler) :emit_ir_string program) :replace (new globalThis.RegExp "from \"eliscript/([^\"]+)\"" "g")
             (lambda (unused path) (str "from " (JSON/stringify (get (pathToFileURL (resolve sourceRoot path)) :href))))))
           (js (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
      (if (funcall host-truth (get scenario :compileError))
        (progn
          (js-call assert :deepEqual (js-call js :run) (get scenario :expected))
          (js-call assert :throws (lambda () (js-call (get b :managed) :lower_managed_program program runtime t))
            (lambda (error) (and (= (diagnosticCode error) (get scenario :compileError))
              (= (get (get (get error :eliscriptDiagnostic) :location) :file) filename)
              (>= (get (get (get (get error :eliscriptDiagnostic) :location) :start) :line) 2))))
          (js-call assert :equal (JSON/stringify program) before) (js-call assert :equal (JSON/stringify runtime) runtimeBefore))
        (let* ((lowered (js-call (get b :managed) :lower_managed_program program runtime t))
               (typedBefore (JSON/stringify (get lowered :typed))) (path (resolve directory (str (get scenario :id) ".dylib"))))
          (await (writeFile path (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
          (js-call assert :equal (JSON/stringify (get lowered :typed)) typedBefore)
          (js-call assert :equal (JSON/stringify program) before) (js-call assert :equal (JSON/stringify runtime) runtimeBefore)
          (let ((a (await (instantiateNativeManagedRuntime path lowered))))
            (js-call a :auto 1)
            (try
              (if (funcall host-truth (get scenario :runtimeError))
                (progn
                  (js-call assert :throws (lambda () (js-call js :run)) (lambda (error) (and
                    (= (get error :name) (get scenario :jsError)) (or (not (= (get scenario :runtimeError) "ELI-RT0009")) (= (diagnosticCode error) (get scenario :runtimeError))))))
                  (js-call assert :throws (lambda () (js-call a :invoke "run")) (lambda (error) (and
                    (= (diagnosticCode error) (get scenario :runtimeError)) (or (not (funcall host-truth (get scenario :wasmError))) (= (get error :name) (get scenario :wasmError))))))
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                  (when (Object/hasOwn scenario "recover")
                    (let ((out (js-call a :invoke "recover")))
                      (try (js-call assert :deepEqual (observe a out) (get scenario :recover)) (js-call assert :deepEqual (js-call js :recover) (get scenario :recover))
                        (finally (js-call a :release out))))))
                (let ((out (js-call a :invoke "run")))
                  (try (js-call assert :deepEqual (js-call js :run) (get scenario :expected)) (js-call assert :deepEqual (observe a out) (get scenario :expected))
                    (finally (js-call a :release out)))))
              (finally
                (try (js-call a :closeModule) (js-call a :collect)
                  (js-call assert :equal (js-call a :live) 0) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                  (finally (js-call a :close) (await (rm path (js-object :force t))))))))))))
  (js-call (get catalog :features) :forEach (lambda (feature)
    (describe (str "Native feature: " (get feature :name) " — " (get feature :description)) (lambda ()
      (js-call (get feature :scenarios) :forEach (lambda (scenario)
        (js-call (js-array "given" "when" "then" "source") :forEach (lambda (field) (js-call assert :equal (funcall host-typeof (get scenario field)) "string")))
        (funcall nativeTest (str "Scenario: " (get scenario :id) "\nGiven " (get scenario :given) "\nWhen " (get scenario :when) "\nThen " (get scenario :then))
          (lambda () (scenarioCase scenario)) 30000)))))))
)
