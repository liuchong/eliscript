(module tests.core-order
  (import "bun:test" expect test)
  (import "../runtime/core/collection.mjs" IReduce)
  (import "../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../runtime/core/list.mjs" PersistentList)
  (import "../runtime/core/order.mjs" comparator compareValues IComparable maxKey minKey reverseComparator sort sortBy)
  (import "../runtime/core/protocol.mjs" extendProtocolType ProtocolDispatchError)
  (import "../runtime/core/vector.mjs" PersistentVector persistentVector)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (operation message) (js-call (expect operation) :toThrow message))
  (test "numeric sort specialization preserves infinities NaN signed-zero stability and custom comparators" (lambda ()
    (let* ((values (js-array globalThis.NaN -0.0 0 globalThis.Infinity (- globalThis.Infinity) globalThis.NaN 2 1))
           (expected (js-array (- globalThis.Infinity) -0.0 0 1 2 globalThis.Infinity globalThis.NaN globalThis.NaN)))
      (same (Array/from (sort values)) expected)
      (same (Array/from (sort compareValues values)) expected)
      (same (Array/from (sort (lambda (a b) (compareValues a b)) values)) expected)
      (be (Object/is (aref values 1) -0.0) t)
      (be (Number/isNaN (aref values 0)) t))))
  (test "natural comparison defines deterministic scalar and sequential order" (lambda ()
    (be (compareValues nil undefined) -1) (be (compareValues undefined false) -1) (be (compareValues false t) -1)
    (be (compareValues (- globalThis.Infinity) 0) -1) (be (compareValues globalThis.Infinity globalThis.NaN) -1)
    (be (compareValues globalThis.NaN globalThis.NaN) 0) (be (compareValues (js* "10n") (js* "2n")) 1)
    (be (compareValues "alpha" "beta") -1) (be (compareValues (keyword "a/item") (keyword "b/item")) -1)
    (be (compareValues (eliscriptSymbol "a/item") (eliscriptSymbol "a/item")) 0)
    (be (compareValues (persistentVector 1 2) (persistentVector 1 2 0)) -1)
    (be (compareValues (js-call PersistentList :from (js-array 1 (persistentVector 2 4))) (js-call PersistentList :from (js-array 1 (persistentVector 3)))) -1)
    (raises (lambda () (compareValues 1 "1")) "cannot compare number to string")
    (raises (lambda () (compareValues (keyword "item") (eliscriptSymbol "item"))) "cannot compare keyword to symbol")
    (raises (lambda () (compareValues (new globalThis.Map) (new globalThis.Map))) ProtocolDispatchError)))
  (test "IComparable remains open to user-defined value types" (lambda ()
    (let* ((construct (js* "(initialize) => class Ranked { constructor(rank, label) { initialize(this, rank, label); } }"))
           (Ranked (funcall construct (lambda (self rank label) (put self :rank rank) (put self :label label) (Object/freeze self))))
           (InvalidComparable (js* "(class InvalidComparable {})")))
      (extendProtocolType IComparable Ranked (js-object :compare (lambda (left right) (- (get left :rank) (get right :rank)))))
      (let ((low (new Ranked 1 "low")) (high (new Ranked 9 "high")))
        (be (compareValues low high) -1) (same (Array/from (sort (js-array high low))) (js-array low high)))
      (extendProtocolType IComparable InvalidComparable (js-object :compare (lambda () globalThis.Infinity)))
      (raises (lambda () (compareValues (new InvalidComparable) (new InvalidComparable))) "IComparable/compare must return a finite number"))))
  (test "comparator adapts numeric and truth-predicate comparisons" (lambda ()
    (be (funcall (comparator (lambda (left right) (- left right))) 1 2) -1)
    (be (funcall (comparator (lambda (left right) (< left right))) 2 1) 1)
    (same (Array/from (sort (lambda (left right) (> left right)) (js-array 1 3 2))) (js-array 3 2 1))
    (same (Array/from (sort (reverseComparator) (js-array 1 3 2))) (js-array 3 2 1))
    (same (Array/from (sort (reverseComparator (lambda (left right) (- (get left :length) (get right :length)))) (js-array "a" "bbb" "cc"))) (js-array "bbb" "cc" "a"))
    (raises (lambda () (comparator nil)) "comparator comparison must be a function")
    (raises (lambda () (funcall (comparator (lambda () globalThis.NaN)) 1 2)) "comparator comparison must return a finite number")
    (raises (lambda () (reverseComparator compareValues compareValues)) "reverseComparator expects zero or one comparator")))
  (test "sort is stable, protocol-driven, persistent, and non-mutating" (lambda ()
    (let* ((construct (js* "(initialize) => class Values { constructor(values) { initialize(this, values); } }"))
           (Values (funcall construct (lambda (self values) (put self :values values))))
           (original (js-array 3 1 2 1)))
      (extendProtocolType IReduce Values (js-object :reduce (lambda (source reducer initial)
        (let ((result initial) (values (get source :values)) (index 0))
          (while (< index (js-length values)) (setq result (funcall reducer result (aref values index))) (setq index (1+ index))) result))))
      (let ((sorted (sort (new Values original))))
        (js-call (expect sorted) :toBeInstanceOf PersistentVector) (same (Array/from sorted) (js-array 1 1 2 3)))
      (same original (js-array 3 1 2 1)) (be (sort nil) (js-call PersistentVector :empty))
      (let* ((records (js-array (js-object :group 2 :id "first") (js-object :group 1 :id "middle") (js-object :group 2 :id "last")))
             (keyCalls 0) (ordered (sortBy (lambda (value) (setq keyCalls (1+ keyCalls)) (get value :group)) records)))
        (same (js-call (Array/from ordered) :map (lambda (value) (get value :id))) (js-array "middle" "first" "last"))
        (be keyCalls (get records :length))))))
  (test "minKey and maxKey evaluate each key once and choose the last tie" (lambda ()
    (let ((values (js-array (js-object :score 2 :id "first-high") (js-object :score 1 :id "low") (js-object :score 2 :id "last-high"))) (minCalls 0) (maxCalls 0))
      (be (get (apply minKey (js-call (js-array (lambda (value) (setq minCalls (1+ minCalls)) (get value :score))) :concat values)) :id) "low")
      (be (get (apply maxKey (js-call (js-array (lambda (value) (setq maxCalls (1+ maxCalls)) (get value :score))) :concat values)) :id) "last-high")
      (be minCalls (get values :length)) (be maxCalls (get values :length))
      (raises (lambda () (minKey (lambda (value) value))) "minKey expects a key function and at least one value")
      (raises (lambda () (maxKey nil 1)) "maxKey key function must be a function"))))
  (test "sorting APIs enforce their complete arity and callback contracts" (lambda ()
    (raises (lambda () (sort)) "sort expects a collection or comparator and collection")
    (raises (lambda () (sort compareValues (js-array) (js-array))) "sort expects a collection or comparator and collection")
    (raises (lambda () (sortBy nil (js-array))) "sortBy key function must be a function")
    (raises (lambda () (sortBy (lambda (value) value))) "sortBy expects a key function, optional comparator, and collection")
    (raises (lambda () (sortBy (lambda (value) value) compareValues (js-array) (js-array))) "sortBy expects a key function, optional comparator, and collection")))
)
