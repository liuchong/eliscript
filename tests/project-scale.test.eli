(module tests.project-scale.test
  (import "node:process" :default process)
  (import "bun:test" expect test)
  (import "node:path" resolve)
  (defconst root (resolve (js* "import.meta.dir") ".."))
  (defconst scalePath (resolve root "tools/project/scale-invalidation.mjs"))
  (defasync runProjectScale ()
    (let* ((child (Bun/spawn (js-array (get process :execPath) scalePath) (js-object :cwd root :stdout "pipe" :stderr "pipe")))
           (timedOut false) (timer (globalThis.setTimeout (lambda () (setq timedOut t) (js-call child :kill "SIGTERM")) 660000))
           (result (await (js-call (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text)))
             :finally (lambda () (globalThis.clearTimeout timer)))))
           (exitCode (aref result 0)) (stdout (aref result 1)) (stderr (aref result 2)))
      (when timedOut (throw (new globalThis.Error "project scale suite exceeded 660000 ms")))
      (when (not (= exitCode 0))
        (let ((err (js-call stderr :trim)) (out (js-call stdout :trim)))
          (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str "scale suite exited with " exitCode)))))))
      (JSON/parse stdout)))
  (defun each (items operation) (js-call items :forEach operation))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun digest (actual) (js-call (expect actual) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u")))
  (test "1000-module graph has exact incremental invalidation and clean equivalence" (async ()
    (let ((report (await (runProjectScale))))
      (js-call (expect report) :toMatchObject (js-object "schemaVersion" 1 "format" "eliscript-project-scale-invalidation" "version" 1 "verified" t "graph" (js-object "modules" 1000 "edges" 1357 "rootFanout" 360 "chainModules" 399 "diamonds" 50 "diamondModules" 200 "cycles" 10 "cycleModules" 100 "sharedImporters" 299 "leaf" "m0399.eli" "sharedDependency" "m0700.eli" "topologyDigest" "1a0edcb5c8ef1d11694db02db48d1f0b04c6a56733e8defa4ceb5109813e89f4") "limits" (js-object "commandTimeoutMs" 120000 "maximumCapturedBytes" 16777216 "maximumSourceBytes" 8388608 "maximumArtifactBytes" 67108864 "maximumTemporaryBytes" 142606336 "maximumBuildRssBytes" 536870912) "phases" (js-object "initial" (js-object "counts" (js-object "modules" 1000 "compiled" 1000 "reused" 0)) "noOp" (js-object "counts" (js-object "modules" 1000 "compiled" 0 "reused" 1000)) "leaf" (js-object "counts" (js-object "modules" 1000 "compiled" 1 "reused" 999)) "leafClean" (js-object "counts" (js-object "modules" 1000 "compiled" 1000 "reused" 0)) "shared" (js-object "counts" (js-object "modules" 1000 "compiled" 1 "reused" 999)) "sharedClean" (js-object "counts" (js-object "modules" 1000 "compiled" 1000 "reused" 0))) "semantics" (js-object "baseline" (js-object "chainHead" 79800 "fanout" (js-object "count" 299 "first" 1401 "last" 1699 "digest" "61976a8ef1fc1fed44f9becbeddbbd1bef928bc9046656831fc8c898f23b7d7f")) "leaf" (js-object "chainHead" 179800 "fanout" (js-object "count" 299 "first" 1401 "last" 1699 "digest" "61976a8ef1fc1fed44f9becbeddbbd1bef928bc9046656831fc8c898f23b7d7f")) "shared" (js-object "chainHead" 179800 "fanout" (js-object "count" 299 "first" 201401 "last" 201699 "digest" "f59cf917b887cbcea791dd2803059ba4aace1768d63851d60147c64a98061627"))) "equivalence" (js-object "noOpArtifacts" t "leafArtifacts" t "leafGraph" t "leafBehavior" t "sharedArtifacts" t "sharedGraph" t "sharedBehavior" t)))
      (same (get report :sources) (js-object "initial" (js-object "files" 1000 "bytes" 136131 "digest" "9c91f6a9420046d8e54c604ed275daab11ccfe4d8a89b5fb9d18bc329a094847") "leaf" (js-object "files" 1000 "bytes" 136134 "digest" "4281fe87d15237b7084b83e95a36471b73817805ad4dfc28e3c49830513bca35") "shared" (js-object "files" 1000 "bytes" 136137 "digest" "ad25f607f9bc3ef41bccde1deaf6e79be202587f33ae90a3dad6b4da2b72a039")))
      (each (Object/values (get report :sources)) (lambda (source)
        (js-call (expect (get source :bytes)) :toBeLessThanOrEqual (get (get report :limits) :maximumSourceBytes))))
      ;; The evaluator is now a maintained module outside the owned workspace.
      ;; Retain all 1000 sources and both complete 2001-file output trees.
      (js-call (expect (get (get report :temporary) :files)) :toBe (+ 1000 (* 2 2001)))
      (js-call (expect (get (get report :temporary) :bytes)) :toBeLessThanOrEqual (get (get report :limits) :maximumTemporaryBytes))
      (digest (get (get report :temporary) :digest))
      (same (get (get (get report :phases) :noOp) :compiledSources) (js-array))
      (same (get (get (get report :phases) :leaf) :compiledSources) (js-array "m0399.eli"))
      (same (get (get (get report :phases) :shared) :compiledSources) (js-array "m0700.eli"))
      (same (get (get (get report :phases) :noOp) :reasons) (js-object :verified 1000))
      (same (get (get (get report :phases) :leaf) :reasons) (js-object "source-changed" 1 :verified 999))
      (same (get (get (get report :phases) :shared) :reasons) (js-object "source-changed" 1 :verified 999))
      (each (Object/values (get report :semantics)) (lambda (semantics) (digest (get (get semantics :fanout) :digest))))
      (each (Object/values (get report :phases)) (lambda (phase)
        (js-call (expect (get phase :wallMs)) :toBeLessThanOrEqual (get (get report :limits) :commandTimeoutMs))
        (js-call (expect (get phase :maxRssBytes)) :toBeGreaterThan 0)
        (js-call (expect (get phase :maxRssBytes)) :toBeLessThanOrEqual (get (get report :limits) :maximumBuildRssBytes))
        (digest (get phase :graphDigest))))
      (each (Object/values (get report :artifacts)) (lambda (artifact)
        (js-call (expect (get artifact :files)) :toBe 2001)
        (js-call (expect (get artifact :bytes)) :toBeLessThanOrEqual (get (get report :limits) :maximumArtifactBytes))
        (digest (get artifact :digest)))))) 680000)
)
