(module tests.repository-integrity-test-ground
  (import "node:process" :default process)
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve join)
  (import "node:url" pathToFileURL)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "../tools/integrity/check.mjs" checkGeneratedMarkerCoverage checkRepositoryIntegrity RepositoryIntegrityError repositoryTrackedFiles validateBenchmarkInventory validateBenchmarkSource validateImportRecords)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defvar compiler undefined) (defvar compilerDirectory undefined)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun refuses (operation message) (js-call (expect operation) :toThrow message))
  (defasync readJson (path) (JSON/parse (await (readFile (join ROOT path) "utf8"))))
  (beforeAll (async ()
    (setq compilerDirectory (await (mkdtemp (join (tmpdir) "eliscript-integrity-tests-")))) (await (seedCompilerFixture compilerDirectory))
    (setq compiler (await (funcall (js* "(url) => import(url)") (get (pathToFileURL (join compilerDirectory "compiler.mjs")) :href))))) 15000)
  (afterAll (async () (when compilerDirectory (await (rm compilerDirectory (js-object :recursive t :force t))))))
  (test "repository dependencies and generated artifacts satisfy declared boundaries" (async ()
    (let* ((deferred (= (get (get process :env) :ELISCRIPT_DEFER_PERFORMANCE_ACCEPTANCE) "1"))
           (report (await (checkRepositoryIntegrity (js-object :root ROOT :compiler compiler :deferPerformanceAcceptance deferred))))
           (contract (await (readJson "contracts/repository-integrity.json"))))
      (js-call (expect report) :toMatchObject (js-object :schemaVersion 1 :format "eliscript-repository-integrity-report" :version 1
        :dependency (js-object :packages (get (get contract :packages) :length) :localPackages 2 :lockfile "frozen" :coreExternalImports 0)
        :artifacts (js-object :deterministicArtifacts 4 :deterministicOutputs 7 :derivedArtifacts 4 :benchmarkArtifacts 14 :benchmarkSources (if deferred 0 291))))
      (js-call (expect (get (get report :dependency) :scannedJavaScript)) :toBe 0)
      (js-call (expect (get (get report :dependency) :scannedEliscript)) :toBeGreaterThan 0)
      (js-call (expect (get (get report :dependency) :totalImports)) :toBeGreaterThan 0)
      (when deferred (js-call (expect (get (get report :artifacts) :deferredBenchmarkSources)) :toEqual (get (get contract :artifacts) :benchmarkReports))))) 15000)
  (test "performance deferral is explicit and does not suppress dependency or artifact checks" (async ()
    (let* ((contract (await (readJson "contracts/repository-integrity.json"))) (trackedFiles (await (repositoryTrackedFiles ROOT))) (broken (funcall globalThis.structuredClone contract)) (badWorkflow (funcall globalThis.structuredClone contract)))
      (put (get broken :artifacts) :benchmarkReports (js-array))
      (await (js-call (get (expect (checkRepositoryIntegrity (js-object :root ROOT :compiler compiler :contract broken :trackedFiles trackedFiles :deferPerformanceAcceptance t))) :rejects) :toThrow "benchmark"))
      (put (js-call (get (get badWorkflow :artifacts) :derived) :find (lambda (entry) (= (get entry :id) "browser-compatibility-workflow"))) :outputs (js-array "wrong.yml"))
      (await (js-call (get (expect (checkRepositoryIntegrity (js-object :root ROOT :compiler compiler :contract badWorkflow :trackedFiles trackedFiles :deferPerformanceAcceptance t))) :rejects) :toThrow "browser workflow")))) 15000)
  (test "repository integrity rejects undeclared and boundary-crossing imports" (async ()
    (let* ((contract (await (readJson "contracts/repository-integrity.json")))
           (react (js-object :file "runtime/core/value.mjs" :specifier "react" :kind "import-statement" :language "javascript"))
           (unlisted (js-object :file "tools/example.mjs" :specifier "unlisted-package" :kind "import-statement" :language "javascript")))
      (refuses (lambda () (validateImportRecords (js-array react unlisted) contract)) RepositoryIntegrityError)
      (refuses (lambda () (validateImportRecords (js-array react) contract)) "outside its allowed boundary")
      (refuses (lambda () (validateImportRecords (js-array unlisted) contract)) "imports undeclared package"))))
  (test "repository integrity isolates declared dependencies at the nearest package boundary" (async ()
    (let* ((contract (await (readJson "contracts/repository-integrity.json")))
           (scopes (js-array (js-object :directory "tests/fixtures/packages/interop-consumer" :manifest "tests/fixtures/packages/interop-consumer/package.json" :name "@eliscript-fixtures/interop-consumer"
             :packages (js-array "@eliscript-fixtures/interop-consumer" "@eliscript-fixtures/native-container-consumer" "eliscript"))))
           (declared (js-object :file "tests/fixtures/packages/interop-consumer/index.mjs" :specifier "@eliscript-fixtures/native-container-consumer" :kind "import-statement" :language "javascript")))
      (js-call (expect (validateImportRecords (js-array declared) contract scopes)) :toMatchObject (js-object :externalImports 1))
      (refuses (lambda () (validateImportRecords (js-array (Object/assign (js-object) declared (js-object :specifier "undeclared-package"))) contract scopes)) "in tests/fixtures/packages/interop-consumer/package.json")
      (refuses (lambda () (validateImportRecords (js-array (Object/assign (js-object) declared (js-object :file "tests/outside-package.mjs"))) contract scopes)) "imports undeclared package"))))
  (test "repository integrity rejects stale benchmark source evidence" (async ()
    (let* ((trackedFiles (await (repositoryTrackedFiles ROOT))) (filename "benchmarks/compiler-runtime-scan-macos-arm64.json") (report (await (readJson filename))))
      (put (get report :sourceDigest) :value (js-call "0" :repeat 64))
      (await (js-call (get (expect (validateBenchmarkSource ROOT trackedFiles filename report)) :rejects) :toThrow "sourceDigest is stale")))))
  (test "repository integrity rejects incomplete artifact registries" (async ()
    (let* ((trackedFiles (await (repositoryTrackedFiles ROOT))) (contract (await (readJson "contracts/repository-integrity.json")))
           (missingGenerated (funcall globalThis.structuredClone contract)) (missingBenchmark (funcall globalThis.structuredClone contract)))
      (js-call (get (get missingGenerated :artifacts) :deterministic) :shift) (js-call (get (get missingBenchmark :artifacts) :benchmarkReports) :shift)
      (await (js-call (get (expect (checkGeneratedMarkerCoverage ROOT trackedFiles missingGenerated)) :rejects) :toThrow "markers differ from the artifact registry"))
      (refuses (lambda () (validateBenchmarkInventory trackedFiles missingBenchmark)) "benchmark reports differ from the artifact registry"))))
  (test "native FFI builtin is confined to its explicit measurement and test adapters" (async ()
    (let* ((contract (await (readJson "contracts/repository-integrity.json"))) (record (js-object :file "tests/native-backend.test.mjs" :specifier "bun:ffi" :kind "import-statement" :language "javascript")))
      (js-call (get (expect (lambda () (validateImportRecords (js-array record) contract))) :not) :toThrow)
      (js-call (js-array "tests/native-memory-long-branches.test.mjs" "tests/compiler-producer-rig.mjs" "tools/backends/native-benchmark.mjs") :forEach (lambda (file)
        (js-call (get (expect (lambda () (validateImportRecords (js-array (Object/assign (js-object) record (js-object :file file))) contract))) :not) :toThrow)))
      (js-call (js-array "bootstrap/backends/native.mjs" "runtime/core/value.mjs" "tools/unrelated.mjs" "tests/unrelated.test.mjs") :forEach (lambda (file)
        (refuses (lambda () (validateImportRecords (js-array (Object/assign (js-object) record (js-object :file file))) contract)) "outside its allowed boundary")))
      (refuses (lambda () (validateImportRecords (js-array (Object/assign (js-object) record (js-object :specifier "bun:unlisted"))) contract)) "imports undeclared package"))))
  (test "TDZ capsule imports require the exact canonical generated bytes and declared output boundary" (async ()
    (let* ((contract (await (readJson "contracts/repository-integrity.json")))
           (javascript (js-call compiler :compile_string
             "(defun read () value) (read) (defconst value 1) (export read)" "tdz-integrity.eli"))
           (imports (js-call (new (get globalThis.Bun :Transpiler) (js-object :loader "js")) :scanImports javascript))
           (helpers (js-call imports :filter (lambda (record) (= (get record :path) "eliscript/runtime/errors.mjs"))))
           (source (await (readFile (resolve ROOT "runtime/errors.eli") "utf8")))
           (emitted (js-call compiler :compile_string source "runtime/errors.eli"))
           (actual (await (readFile (resolve ROOT "runtime/errors.mjs") "utf8")))
           (record (js-object :file "runtime/core/protocol-impl.mjs" :specifier "eliscript/runtime/errors.mjs"
             :kind "import-statement" :language "javascript")))
      (js-call (expect helpers) :toHaveLength 1)
      (js-call (expect (js-call imports :some (lambda (item) (js-call (get item :path) :startsWith "data:")))) :toBe false)
      (js-call (expect (js-call actual :replace (new globalThis.RegExp "\\n?//# sourceMappingURL=[^\\r\\n]*\\r?\\n?$") "\n")) :toBe emitted)
      (js-call (js-array "runtime/core/protocol-impl.mjs" "tests/snapshots/core.mjs") :forEach (lambda (file)
        (js-call (expect (validateImportRecords (js-array (Object/assign (js-object) record (js-object :file file))) contract))
          :toMatchObject (js-object :externalImports 0 :coreExternalImports 0))))
      (js-call (js-array "eliscript/runtime/errors.mjs#changed" "data:text/javascript;base64,ZXhwb3J0IHt9Ow==" "data:text/javascript;base64,")
        :forEach (lambda (specifier)
          (js-call (expect (lambda () (validateImportRecords
            (js-array (Object/assign (js-object) record (js-object :specifier specifier))) contract))) :toThrow)))
      (js-call (js-array "runtime/core/unlisted.mjs" "tools/unrelated.mjs" "stdlib/core/protocol.eli") :forEach (lambda (file)
        (js-call (expect (lambda () (validateImportRecords
          (js-array (Object/assign (js-object) record (js-object :file file))) contract))) :toThrow "outside its allowed boundary")))))
))
