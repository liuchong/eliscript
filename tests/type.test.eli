(module tests.type
  (import "bun:test" expect test)
  (import "../runtime/core/protocol.mjs" defineProtocol extendProtocolType implementsProtocol protocolMethod)
  (import "../runtime/core/type.mjs" defineType isType isTypeValue reifyProtocols typeFieldNames typeName typeOf)
  (import "../runtime/core/value.mjs" equalValues)
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (operation message) (js-call (expect operation) :toThrow message))
  (test "defined types construct frozen positional identity values" (lambda ()
    (let* ((Point (defineType "Point" (js-array "x" "y"))) (left (js-call Point :create 3 4)) (right (js-call Point :create 3 4)))
      (js-call (expect (isType Point)) :toBeTrue) (js-call (expect (isTypeValue left)) :toBeTrue)
      (js-call (expect (js-call Point :isInstance left)) :toBeTrue) (be (typeOf left) Point)
      (be (typeName Point) "Point") (be (typeName left) "Point") (same (typeFieldNames left) (js-array "x" "y"))
      (js-call (expect (Object/isFrozen (typeFieldNames left))) :toBeTrue) (js-call (expect (Object/isFrozen left)) :toBeTrue)
      (be (get left :x) 3) (be (get left :y) 4) (js-call (expect (equalValues left right)) :toBeFalse)
      (raises (lambda () (js-call Point :create 3)) "->Point expects 2 values, received 1")
      (raises (lambda () (new Point)) "Point values must be created with its positional constructor"))))
  (test "defined types install complete direct protocol implementations" (lambda ()
    (let* ((IDescribe (defineProtocol "TypeDescribe" (js-array "describe" "measure")))
           (describe (protocolMethod IDescribe "describe")) (measure (protocolMethod IDescribe "measure"))
           (Box (defineType "Box" (js-array "value") (js-array (js-array IDescribe (js-object
             :describe (lambda (self prefix) (str prefix ":" (get self :value)))
             :measure (lambda (self scale) (* (get self :value) scale))))))))
      (extendProtocolType IDescribe Box (js-object :describe (lambda () "external") :measure (lambda () -1)))
      (let ((box (js-call Box :create 7)))
        (js-call (expect (implementsProtocol IDescribe box)) :toBeTrue) (be (funcall describe box "box") "box:7") (be (funcall measure box 3) 21)))))
  (test "reified values implement multiple protocols with lexical closures" (lambda ()
    (let* ((IRead (defineProtocol "ReifiedRead" (js-array "read"))) (IMeasure (defineProtocol "ReifiedMeasure" (js-array "measure")))
           (read (protocolMethod IRead "read")) (measure (protocolMethod IMeasure "measure")) (prefix "captured") (offset 10)
           (value (reifyProtocols (js-array
             (js-array IRead (js-object :read (lambda (_self suffix) (str prefix ":" suffix))))
             (js-array IMeasure (js-object :measure (lambda (_self input) (+ offset input))))))))
      (js-call (expect (Object/getPrototypeOf value)) :toBeNull) (js-call (expect (Object/isFrozen value)) :toBeTrue)
      (js-call (expect (implementsProtocol IRead value)) :toBeTrue) (js-call (expect (implementsProtocol IMeasure value)) :toBeTrue)
      (be (funcall read value "ok") "captured:ok") (be (funcall measure value 5) 15))))
  (test "type protocol plans reject incomplete and ambiguous definitions" (lambda ()
    (let ((protocol (defineProtocol "ValidatedType" (js-array "read" "write"))))
      (raises (lambda () (defineType "Incomplete" (js-array) (js-array (js-array protocol (js-object :read (lambda () nil)))))) "implementation must define every operation")
      (raises (lambda () (defineType "Unknown" (js-array) (js-array (js-array protocol (js-object :read (lambda () nil) :other (lambda () nil)))))) "implementation contains an unknown operation")
      (raises (lambda () (reifyProtocols (js-array))) "reify requires at least one protocol implementation")
      (raises (lambda () (reifyProtocols (js-array
        (js-array protocol (js-object :read (lambda () nil) :write (lambda () nil)))
        (js-array protocol (js-object :read (lambda () nil) :write (lambda () nil)))))) "protocol may be implemented only once"))))
  (test "type definitions reject ambiguous names and fields" (lambda ()
    (raises (lambda () (defineType "" (js-array))) "type name must be a non-empty string")
    (raises (lambda () (defineType "Bad" (js-array "x" "x"))) "type declares duplicate field x")
    (raises (lambda () (defineType "Bad" (js-array "constructor"))) "type field constructor conflicts with a type member")
    (raises (lambda () (typeOf (js-object))) "expected an Eliscript type value")))
  (test "type definitions reject mutable protocol-shaped objects" (lambda ()
    (let* ((protocol (defineProtocol "ExactProtocolIdentity" (js-array "read"))) (read (protocolMethod protocol "read"))
           (mutableProtocol (js-object :name (get protocol :name) :operations (js-object :read read))))
      (raises (lambda () (defineType "Forged" (js-array) (js-array (js-array mutableProtocol (js-object :read (lambda () nil)))))) "expected an Eliscript protocol"))))
)
