(module tests.wasm-managed-array-index-storage.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile realpath rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-heap-diagnostic.mjs" invokeWithHeapDiagnostic)

  ;; Use the existing receiver-forwarding method ABI rather than an implicit
  ;; receiver inside an ordinary source callback.
  (defconst receiverMethod
    "(fn, name) => { if (typeof name !== \"string\") throw new TypeError(\"method name must be a string\"); return ({ [name](...args) { return Reflect.apply(fn, undefined, [this, ...args]); } })[name]; }")

  (defconst source
    (str
      "\n (defconst marker -0)\n"
      " (defvar destination nil)\n"
      " (defun species (length) destination)\n"
      " (defun exercise (mode)\n"
      "  (let* ((object (js* \"Object\")) (trace (js-array))\n"
      "         (items (js-array -0 1 2)) (out undefined) (failure false))\n"
      "   (setq destination (js-array))\n"
      "   (when (or (= mode 1) (= mode 10))\n"
      "    (let ((parent (js-object)))\n"
      "     (js-call object :setPrototypeOf parent (get (js* \"Array\") :prototype))\n"
      "     (js-call object :defineProperty parent \"1\"\n"
      "      (js-object :get (lambda () (js-call trace :push \"getter\")\n"
      "                      (if (= mode 10) (throw false) 9)) :configurable t))\n"
      "     (Reflect/deleteProperty items \"1\") (js-call object :setPrototypeOf items parent)))\n"
      "   (when (and (>= mode 2) (<= mode 9))\n"
      "    (when (= mode 8) (setq destination (js-array 9 8 7)))\n"
      "    (let ((constructor (js-object)))\n"
      "     (put constructor (get (js* \"Symbol\") :species) species)\n"
      "     (put items :constructor constructor))\n"
      "    (cond\n"
      "     ((= mode 2)\n"
      "      (let ((parent (js-object)))\n"
      "       (js-call object :setPrototypeOf parent (get (js* \"Array\") :prototype))\n"
      "       (js-call object :defineProperty parent \"0\"\n"
      "        (js-object :set (lambda (value) (js-call trace :push \"setter\")) :configurable t))\n"
      "       (js-call object :setPrototypeOf destination parent)))\n"
      "     ((= mode 3)\n"
      "      (js-call object :defineProperty destination \"0\"\n"
      "       (js-object :get (lambda () (throw \"old getter must not run\")) :configurable t)))\n"
      "     ((= mode 4)\n"
      "      (js-call object :defineProperty destination \"0\"\n"
      "       (js-object :value 7 :writable false :enumerable t :configurable false)))\n"
      "     ((or (= mode 5) (= mode 8)) (js-call object :preventExtensions destination))\n"
      "     ((= mode 6) (js-call object :freeze destination))\n"
      "     ((= mode 7) (js-call object :defineProperty destination \"length\" (js-object :writable false)))\n"
      "     ((= mode 9) (js-call object :seal destination))))\n"
      "   (try\n"
      "    (setq out (js-call items :map\n"
      "     (lambda (value index array)\n"
      "      (js-call trace :push (js-array \"callback\" index (js-call object :is value -0))) value)))\n"
      "    (catch error (setq failure (if (eq error false) \"false\" (get error :name)))))\n"
      "   (let* ((result (if (eq out undefined) destination out))\n"
      "          (description (js-call object :getOwnPropertyDescriptor result \"0\")))\n"
      "    (JSON/stringify (js-array failure trace (js-length result)\n"
      "     (object-has? result \"0\") (object-has? result \"1\")\n"
      "     (if (eq description undefined) undefined\n"
      "      (js-array (get description :writable) (get description :enumerable)\n"
      "       (get description :configurable) (js-call object :is (get description :value) -0)))\n"
      "     (if failure undefined result))))))\n"
      " (defun map-copy (items) (js-call items :map (lambda (value) value)))\n"
      " (defun recover () (js-call (js-array -0) :map (lambda (value) value)))\n"
      " (defun this-argument (mode)\n"
      "  (let* ((items (js-array -0 1))\n"
      "         (callback (funcall (js* " (JSON/stringify receiverMethod) ")\n"
      "                     (lambda (receiver value index array) receiver) \"callback\"))\n"
      "         (receiver (cond ((= mode 0) (js-object :marker -0)) ((= mode 1) nil)\n"
      "                     ((= mode 2) undefined) ((= mode 3) false) ((= mode 4) -0)\n"
      "                     ((= mode 5) \"this中😀\") (t t)))\n"
      "         (out (js-call items :map callback receiver)))\n"
      "   (JSON/stringify (js-array (Object/is (aref out 0) receiver)\n"
      "    (Object/is (aref out 1) receiver) (Object/is (aref items 0) -0)\n"
      "    (Object/is receiver -0)))))\n"
      " (defun captured-map (replace-with-function)\n"
      "  (let* ((items (js-array -0 1 2)) (trace (js-array))\n"
      "         (replacement (if replace-with-function\n"
      "           (lambda (callback) (js-call trace :push \"replacement\") 9) false))\n"
      "         (callback (lambda (value index array)\n"
      "          (when (= index 0) (put items :map replacement))\n"
      "          (js-call trace :push index) value))\n"
      "         (out (js-call items :map (progn (js-call trace :push \"argument\") callback)))\n"
      "         (next undefined) (failure false))\n"
      "   (try\n"
      "    (setq next (js-call items :map (progn (js-call trace :push \"later argument\") callback)))\n"
      "    (catch error (setq failure (get error :name))))\n"
      "   (JSON/stringify (js-array out trace next failure (Object/is (js-nth 0 out) -0)\n"
      "    (eq (get items :map) replacement)))))\n"
      " (defun prototype () globalThis.Array.prototype)\n"
      " (defun observe-method () (aref globalThis.Array.prototype \"at\"))\n"
      " (defun call-observed-method ()\n"
      "  (js-call (aref globalThis.Array.prototype \"at\") :call (js-array -0) 0))\n"
      " (defun species-observation (mode)\n"
      "  (let* ((constructor globalThis/Array) (key Symbol/species)\n"
      "         (original (aref constructor key)) (reads 0))\n"
      "   (cond\n"
      "    ((= mode 1) (Reflect/deleteProperty constructor key))\n"
      "    ((= mode 2) (Object/defineProperty constructor key\n"
      "      (js-object :value false :writable t :configurable t)))\n"
      "    ((= mode 3) (Object/defineProperty constructor key\n"
      "      (js-object :get (lambda () (setq reads (1+ reads)) -0) :configurable t))))\n"
      "   (let ((first (aref constructor key)))\n"
      "    (Object/getOwnPropertyNames constructor)\n"
      "    (let* ((symbols (Object/getOwnPropertySymbols constructor)) (again (aref constructor key)))\n"
      "     (JSON/stringify (js-array (Object/is original constructor)\n"
      "      (Object/hasOwn constructor key) (Object/is first again)\n"
      "      (undefined? first) (eq first false) (Object/is first -0) reads\n"
      "      (js-call symbols :indexOf key)))))))\n"
      " (defun prototype-alias (mode)\n"
      "  (let* ((prototype globalThis.Array.prototype) (key (get (js* \"Symbol\") :iterator))\n"
      "         (original (if (= mode 3) (aref prototype key) (get prototype :values))))\n"
      "   (when (= mode 1) (put prototype :values (lambda () 9)))\n"
      "   (when (or (= mode 2) (= mode 4)) (Reflect/deleteProperty prototype \"values\"))\n"
      "   (when (= mode 4) (put prototype :length 64))\n"
      "   (let ((other (if (= mode 3) (get prototype :values) (aref prototype key))))\n"
      "    (JSON/stringify (js-array (eq original other) (get other :name) (get other :length)\n"
      "      (Object/hasOwn prototype \"values\"))))))\n"
      " (defun flags-after-growth ()\n"
      "  (let ((items (js-array)) (failure false))\n"
      "   (Object/preventExtensions items) (put items :length 64)\n"
      "   (try (put items \"0\" 1) (catch error (setq failure (get error :name))))\n"
      "   (JSON/stringify (js-array (Object/isExtensible items) (js-length items)\n"
      "     (Object/hasOwn items \"0\") failure))))\n"
      " (defun prototype-order (mode)\n"
      "  (let ((prototype globalThis.Array.prototype) (reads 0))\n"
      "   (cond\n"
      "    ((= mode 1) (get prototype :at) (get prototype :map) (get prototype :pop))\n"
      "    ((= mode 2)\n"
      "     (Object/defineProperty prototype \"map\"\n"
      "      (js-object :get (lambda () (setq reads (1+ reads)) 9) :configurable t)))\n"
      "    ((= mode 3)\n"
      "     (let ((method (get prototype :push)))\n"
      "      (Reflect/deleteProperty prototype \"push\") (put prototype :push method))))\n"
      "   (JSON/stringify (js-array (Object/getOwnPropertyNames prototype) reads))))\n"
      " (export exercise map-copy recover this-argument captured-map prototype observe-method call-observed-method prototype-alias prototype-order flags-after-growth species-observation)"))

  (defvar directory undefined)
  (defvar bytes undefined)
  (defvar module undefined)
  (defvar oracle undefined)
  (defvar aliasOracle undefined)
  (defvar growthOracle undefined)
  (defvar thisArgOracle undefined)
  (defvar capturedMapOracle undefined)
  (defvar speciesOracle undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-array-index-storage-"))))
    (let* ((b (await (buildBackends (js-object :outputRoot directory))))
           (runtime (js-call (get b :compiler) :compile_ir_string
                      (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                      "runtime.eli"))
           (program (js-call (get b :compiler) :compile_ir_string source "array-index-storage.eli"))
           (reference (resolve (await (realpath directory)) "reference.mjs")))
      (await (writeFile reference (js-call (get b :compiler) :emit_ir_string program)))
      (let ((child (spawnSync "node"
                     (js-array
                       (resolve "tests/helpers/wasm-managed-array-index-storage-node.mjs")
                       (get (pathToFileURL reference) :href))
                     (js-object :encoding "utf8" :timeout 10000 :maxBuffer (* 1024 1024)))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))
        (let ((observations (JSON/parse (get child :stdout))))
          (setq oracle (get observations :exercise))
          (setq aliasOracle (get observations :aliases))
          (setq growthOracle (get observations :growth))
          (setq thisArgOracle (get observations :thisArgs))
          (setq capturedMapOracle (get observations :capturedMaps))
          (setq speciesOracle (get observations :species))))
      (let* ((lowered (js-call (get b :managed) :lower_managed_program program runtime))
             (exports-list (get (get lowered :typed) :exports))
             (required-exports
               (js-array "heap-new" "heap-auto" "heap-collect" "heap-live" "heap-collections" "last-error"
                         "value-array-new" "value-number" "value-get" "frame-new" "frame-set" "frame-pop" "frame-depth"
                         "heap-source-array-prototype-index")))
        (js-call required-exports :forEach
          (lambda (name)
            (when (not (js-call exports-list :includes name))
              (js-call exports-list :push name))))
        (let ((emitted (js-call (get b :wasm) :emit_typed_memory_wasm
                         (get lowered :typed)
                         (js-object :initialPages 1 :maximumPages 32))))
          (setq bytes
            (Uint8Array/from
              (js-call (get b :wasm) :append_metadata_section
                emitted "eliscript-managed-control" (JSON/stringify (get lowered :descriptor)))))
          (setq module (new globalThis.WebAssembly.Module bytes))
          (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports module) (js-array))))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun finish (a &rest __host_default_arguments_1)
    (let* ((values (aref __host_default_arguments_1 0)))
    (let ((items (if (undefined? values) (js-array) values)))
      (js-call items :forEach (lambda (value) (js-call a :release value))))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (defun instance (&rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)))
    (let ((a (instantiateManagedRuntime bytes
               (Object/assign (js-object)
                 (if (undefined? options) (js-object) options)
                 (js-object :initializeModule false)))))
      (js-call a :auto 1)
      (js-call a :initializeModule)
      a)))

  (let ((scenarios
          (js-array
            "plain own slots"
            "inherited getter"
            "inherited setter on species result"
            "configurable accessor on species result"
            "readonly species result"
            "nonextensible species result"
            "frozen species result"
            "readonly length"
            "nonextensible existing slots"
            "sealed species result"
            "inherited getter throwing false")))
    (js-call scenarios :forEach
      (lambda (scenario mode)
        (test (str "Array internal data creation preserves " scenario " and exact first effects") (lambda ()
          (let* ((a (instance))
                 (input (js-call a :number mode))
                 (zero (js-call a :number -0.0))
                 (frame (js-call a :frame 1))
                 (result undefined))
            (js-call a :frameSet frame 0 zero)
            (try
              (setq result (js-call a :invoke "exercise" (js-array input)))
              (js-call assert :equal (js-call a :readString result) (aref oracle mode) (str "mode " mode))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (let ((saved (js-call a :frameGet frame 0)))
                (try
                  (assert (Object/is (js-call a :readNumber saved) -0.0))
                  (finally (js-call a :release saved))))
              (let ((recovered (js-call a :invoke "recover")))
                (try
                  (let ((value (js-call a :get recovered 0)))
                    (try
                      (assert (Object/is (js-call a :readNumber value) -0.0))
                      (finally (js-call a :release value))))
                  (finally (js-call a :release recovered))))
              (finally
                (js-call a :leaveFrame frame)
                (finish a (js-array input zero result))))))))))

  (test "plain mapped values remain independent and collectible under per-allocation GC" (lambda ()
    (let* ((a (instance))
           (negativeZero (js-call a :number -0.0))
           (frame (js-call a :frame 1))
           (input (js-call a :sourceArray (js-call (new globalThis.Array 96) :fill negativeZero))))
      (js-call a :frameSet frame 0 negativeZero)
      (try
        (let ((round 0))
          (while (< round 8)
            (let ((out (js-call a :invoke "map-copy" (js-array input))))
              (try
                (js-call assert :equal (js-call a :length out) 96)
                (js-call assert :equal (js-call a :keyEqual out input) false)
                (let ((index 0))
                  (while (< index 96)
                    (let ((value (js-call a :get out index)))
                      (try
                        (assert (Object/is (js-call a :readNumber value) -0.0))
                        (finally (js-call a :release value))))
                    (setq index (1+ index))))
                (finally (js-call a :release out))))
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (let ((saved (js-call a :frameGet frame 0)))
              (try
                (assert (Object/is (js-call a :readNumber saved) -0.0))
                (finally (js-call a :release saved))))
            (setq round (1+ round))))
        (finally
          (js-call a :leaveFrame frame)
          (finish a (js-array input negativeZero)))))))

  (test "captured Array callbacks receive the exact object nullish primitive and negative-zero thisArg under collection" (lambda ()
    (js-call assert :equal (js-length thisArgOracle) 7)
    (let ((mode 0))
      (while (< mode (js-length thisArgOracle))
        (js-call assert :deepEqual
          (JSON/parse (aref thisArgOracle mode))
          (js-array t t t (= mode 4))
          (str "independent thisArg mode " mode))
        (let* ((a (instance))
               (input (js-call a :number mode))
               (zero (js-call a :number -0.0))
               (frame (js-call a :frame 1))
               (out undefined))
          (js-call a :frameSet frame 0 zero)
          (try
            (setq out (js-call a :invoke "this-argument" (js-array input)))
            (js-call assert :equal (js-call a :readString out) (aref thisArgOracle mode) (str "thisArg mode " mode))
            (js-call a :collect)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (let ((saved (js-call a :frameGet frame 0)))
              (try
                (assert (Object/is (js-call a :readNumber saved) -0.0))
                (finally (js-call a :release saved))))
            (finally
              (js-call a :leaveFrame frame)
              (finish a (js-array input zero out)))))
        (setq mode (1+ mode))))))

  (test "a callback replacing map cannot change the captured call and the next lookup observes the replacement after arguments" (lambda ()
    (js-call assert :equal (js-length capturedMapOracle) 2)
    (js-call (js-array false t) :forEach
      (lambda (replaceWithFunction index)
        (js-call assert :deepEqual
          (JSON/parse (aref capturedMapOracle index))
          (js-array
            (js-array 0 1 2)
            (js-call (js-array "argument" 0 1 2 "later argument")
              :concat (if replaceWithFunction (js-array "replacement") (js-array)))
            (if replaceWithFunction 9 nil)
            (if replaceWithFunction false "TypeError")
            t
            t)
          (str "independent captured map mode " index))
        (let* ((a (instance))
               (zero (js-call a :number -0.0))
               (frame (js-call a :frame 1))
               (out undefined)
               (recovered undefined))
          (js-call a :frameSet frame 0 zero)
          (try
            (setq out (js-call a :invoke "captured-map" (js-array replaceWithFunction)))
            (js-call assert :equal (js-call a :readString out) (aref capturedMapOracle index))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call a :collect)
            (let ((saved (js-call a :frameGet frame 0)))
              (try
                (assert (Object/is (js-call a :readNumber saved) -0.0))
                (finally (js-call a :release saved))))
            (setq recovered (js-call a :invoke "recover"))
            (let ((first (js-call a :get recovered 0)))
              (try
                (assert (Object/is (js-call a :readNumber first) -0.0))
                (finally (js-call a :release first))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (finally
              (js-call a :leaveFrame frame)
              (finish a (js-array zero out recovered)))))))))

  (js-call (js-array 0 1 2 3) :forEach
    (lambda (mode)
      (test (str "observed Array species preserves deletion override and getter effects through full reflection in mode " mode) (lambda ()
        (js-call assert :deepEqual
          (JSON/parse (aref speciesOracle mode))
          (js-array t (/= mode 1) t (= mode 1) (= mode 2) (= mode 3)
                    (if (= mode 3) 2 0)
                    (if (= mode 1) -1 0)))
        (let* ((a (instance))
               (input (js-call a :number mode))
               (out undefined))
          (try
            (setq out (js-call a :invoke "species-observation" (js-array input)))
            (js-call assert :equal (js-call a :readString out) (aref speciesOracle mode))
            (finally (finish a (js-array input out)))))))))

  (js-call (js-array 0 1 2 3 4) :forEach
    (lambda (mode)
      (test (str "lazy prototype iterator alias retains the original values identity in observation mode " mode) (lambda ()
        (let* ((a (instance))
               (input (js-call a :number mode))
               (out undefined))
          (try
            (setq out (js-call a :invoke "prototype-alias" (js-array input)))
            (js-call assert :equal (js-call a :readString out) (aref aliasOracle mode))
            (finally (finish a (js-array input out)))))))))

  (test "array backing growth preserves nonextensibility and rejects new indexed properties after length growth" (lambda ()
    (let ((a (instance)) (out undefined))
      (try
        (setq out (js-call a :invoke "flags-after-growth"))
        (js-call assert :equal (js-call a :readString out) growthOracle)
        (finally (finish a (js-array out)))))))

  (test "observing and redefining native members preserves the complete represented key order while delete and readd moves the key" (lambda ()
    (let ((observations (js-array))
          (mode 0))
      (while (< mode 4)
        (let* ((a (instance))
               (input (js-call a :number mode))
               (out undefined))
          (try
            (setq out (js-call a :invoke "prototype-order" (js-array input)))
            (js-call observations :push (JSON/parse (js-call a :readString out)))
            (finally (finish a (js-array input out)))))
        (setq mode (1+ mode)))
      (js-call assert :deepEqual (aref observations 1) (aref observations 0))
      (js-call assert :deepEqual (aref observations 2) (aref observations 0))
      (js-call assert :deepEqual
        (js-call (aref (aref observations 3) 0) :slice 0 -1)
        (js-call (aref (aref observations 0) 0) :filter (lambda (key) (/= key "push"))))
      (js-call assert :equal (js-call (aref (aref observations 3) 0) :at -1) "push")
      (js-call observations :forEach
        (lambda (record)
          (js-call assert :equal (aref record 1) 0 "own key enumeration must not invoke the replacement getter"))))))

  (js-call (js-array 64 256) :forEach
    (lambda (maxSlots)
      (test (str "failed first native member materialization recovers in the original " maxSlots " slot budget") (lambda ()
        (let* ((a (instance (js-object :maxSlots maxSlots :initialBytes 16384 :maxBytes 65536)))
               (prototype (js-call a :invoke "prototype"))
               (caller (js-call a :frame 1))
               (padding (js-array))
               (exhausted false)
               (method undefined)
               (out undefined))
          (js-call a :frameSet caller 0 prototype)
          (try
            (try
              (let ((index 0))
                (while (< index (* maxSlots 2))
                  (js-call padding :push (js-call a :number index))
                  (setq index (1+ index))))
              (catch error
                (js-call assert :equal
                  (and (get error :eliscriptDiagnostic) (get (get error :eliscriptDiagnostic) :code))
                  "ELI-RT0002")
                (setq exhausted t)))
            (assert exhausted)
            (js-call assert :throws
              (lambda () (js-call a :invoke "observe-method"))
              (lambda (error)
                (and (get error :eliscriptDiagnostic)
                     (= (get (get error :eliscriptDiagnostic) :code) "ELI-RT0002"))))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call padding :forEach (lambda (value) (js-call a :release value)))
            (put padding :length 0)
            (js-call a :collect)
            (setq method (js-call a :invoke "observe-method"))
            (js-call assert :equal (get method :kind) 18)
            (setq out (invokeWithHeapDiagnostic a "call-observed-method"))
            (assert (Object/is (js-call a :readNumber out) -0.0))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (finally
              (js-call padding :forEach (lambda (value) (js-call a :release value)))
              (js-call a :leaveFrame caller)
              (finish a (js-array prototype method out)))))))))

  (test "ordinary indexed storage does not consume one permanent descriptor handle per element" (lambda ()
    (let* ((r (get (new globalThis.WebAssembly.Instance module) :exports))
           (heap (js-call r "heap-new" 64 4096 32768)))
      (js-call assert :notEqual heap 0)
      (js-call r "heap-auto" heap 1)
      (let ((frame (js-call r "frame-new" heap 2))
            (array (js-call r "value-array-new" heap 256)))
        (js-call assert :notEqual frame 0)
        (js-call assert :notEqual array 0)
        (js-call r "frame-set" heap frame 0 array)
        (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
              (index 0))
          (while (< index 256)
            (js-call bits :setFloat64 0 index t)
            (let ((number (js-call r "value-number" heap
                            (js-call bits :getUint32 0 t)
                            (js-call bits :getUint32 4 t)))
                  (val (if (/= (% index 2) 0) 1 2)))
              (js-call assert :notEqual number 0)
              (js-call r "frame-set" heap frame 1 number)
              (js-call assert :equal (js-call r "heap-source-array-prototype-index" heap array number 4 val) 2)
              (js-call assert :equal (js-call r "last-error") 0)
              (js-call assert :equal (js-call r "heap-source-array-prototype-index" heap array number 1 0) 2)
              (js-call assert :equal (js-call r "heap-source-array-prototype-index" heap array number 0 0) val)
              (js-call r "heap-collect" heap)
              (js-call assert :equal (js-call r "heap-live" heap) 3))
            (setq index (1+ index))))
        (let ((index 0))
          (while (< index 256)
            (js-call assert :equal (js-call r "value-get" heap array index)
              (if (/= (% index 2) 0) 1 2))
            (setq index (1+ index))))
        (assert (>= (js-call r "heap-collections" heap) 256))
        (js-call assert :equal (js-call r "frame-depth" heap) 1)
        (js-call r "frame-pop" heap frame)
        (js-call r "heap-collect" heap)
        (js-call assert :equal (js-call r "heap-live" heap) 0)
        (js-call assert :equal (js-call r "frame-depth" heap) 0))))))
