(module tests.wasm-managed-regexp-indices.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile mkdtemp rm realpath)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/wasm-managed-regexp-indices-node.mjs"
    text-call finish matching flags-and-accessor stateful retention failure-recovery)

  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst node-helper (resolve "tests/helpers/wasm-managed-regexp-indices-node.mjs"))
  (defconst fixture "tests/fixtures/wasm-managed-regexp-indices.eli")

  (defconst target
    (if (= (get process :arch) "arm64")
        (cond
          ((= (get process :platform) "darwin") "arm64-macos")
          ((= (get process :platform) "linux") "arm64-linux")
          (t undefined))
        undefined))

  (defconst options
    (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 1048576 :maximumPages 32))

  (defconst cases
    (js-array
      (js-array "(a)(b)?" "d" "za")
      (js-array "(a)(b)?" "" "za")
      (js-array "()" "d" "😀")
      (js-array "((a)|(b))+" "d" "zab")
      (js-array "((a)?b){2}" "d" "abb")
      (js-array "(?=(a+))a" "d" "zaaa")
      (js-array "(?!b)(a)" "d" "za")
      (js-array "(?<=(a))b" "d" "zab")
      (js-array "(?<!b)(a)" "d" "za")
      (js-array "(?<head>a)(?<tail>b)?" "d" "za")
      (js-array "(?<x>a)|(?<x>b)" "d" "b")
      (js-array "(?<__proto__>a)(?<constructor>b)?" "d" "a")
      (js-array "(😀)(.)?" "du" (str "x😀" (String/fromCharCode 55296)))
      (js-array "(.)" "d" "😀")
      (js-array "(.)" "du" "😀")
      (js-array (str "(" (String/fromCharCode 55296) ")") "du" (str "x" (String/fromCharCode 55296)))
      (js-array "(a)?" "d" "")
      (js-array "a" "d" "no match")))

  (defvar directory nil)
  (defvar backend nil)
  (defvar lowered nil)
  (defvar bytes nil)
  (defvar wasmFile nil)
  (defvar library nil)
  (defvar reference nil)
  (defvar referenceFile nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-regexp-indices-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((source (await (readFile fixture "utf8")))
             (program (js-call (get backend :compiler) :compile_ir_string source fixture))
             (saved (JSON/stringify program))
             (runtime (js-call (get backend :compiler) :compile_ir_string
                        (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                        "runtime.eli")))
        (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime t))
        (let ((raw (js-call (get backend :wasm) :emit_typed_memory_wasm
                     (get lowered :typed)
                     (js-object :initialPages 1 :maximumPages 32))))
          (setq bytes
            (Uint8Array/from
              (js-call (get backend :wasm) :append_metadata_section
                raw "eliscript-managed-control" (JSON/stringify (get lowered :descriptor))))))
        (js-call assert :deepEqual
          (WebAssembly.Module/imports (new WebAssembly.Module bytes))
          (js-array))
        (setq wasmFile (resolve directory "indices.wasm"))
        (await (writeFile wasmFile bytes))
        (when target
          (setq library (resolve directory (if (= target "arm64-linux") "indices.so" "indices.dylib")))
          (await (writeFile library
                   (Uint8Array/from
                     (js-call (get backend :native) :emit_typed_native_memory_library
                       (get lowered :typed) target)))))
        (setq referenceFile (resolve directory "indices.mjs"))
        (await (writeFile referenceFile (js-call (get backend :compiler) :emit_ir_string program)))
        (setq referenceFile (await (realpath referenceFile)))
        (setq reference (await (funcall dyn-import (get (pathToFileURL referenceFile) :href))))
        (js-call assert :equal (JSON/stringify program) saved)))
    120000)

  (afterAll
    (async ()
      (setq lowered undefined)
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defasync each-target (run &rest __host_default_arguments_1)
    (let* ((configuration (aref __host_default_arguments_1 0)))
    (let* ((cfg (if (undefined? configuration) options configuration))
           (kinds (if target (js-array "wasm" "native") (js-array "wasm")))
           (idx 0))
      (while (< idx (get kinds :length))
        (let* ((kind (aref kinds idx))
               (a (if (= kind "wasm")
                      (instantiateManagedRuntime bytes cfg)
                      (await (instantiateNativeManagedRuntime library lowered
                               (Object/assign (js-object) cfg (js-object :nativeTarget target)))))))
          (js-call a :auto 1)
          (try
            (await (funcall run a kind))
            (finally
              (finish a))))
        (setq idx (+ idx 1))))))

  (test "d literals dynamic constructors flags clones and hasIndices accessors preserve native descriptors and first errors"
    (async ()
      (await (each-target (lambda (a _kind) (flags-and-accessor a reference)))))
    30000)

  (test "exec indices preserve exact captures own undefined UTF16 offsets named aliases descriptors and property order in WASM and native"
    (async ()
      (await (each-target (lambda (a _kind) (matching a reference cases)))))
    30000)

  (test "global sticky and matchAll indices own independent result pairs and preserve lastIndex across calls and instances"
    (async ()
      (await (each-target (lambda (a _kind) (stateful a reference))))
      (await (each-target (lambda (a _kind) (stateful a reference)))))
    30000)

  (test "retained index pairs and named aliases survive collecting GC while later input and result mutations stay isolated"
    (async ()
      (await (each-target (lambda (a _kind) (retention a reference)))))
    30000)

  (test "exec defines all result and index properties without invoking inherited setters or obeying inherited readonly blockers"
    (async ()
      (await (each-target
               (lambda (a _kind)
                 (let ((mode 0))
                   (while (< mode 4)
                     (let* ((expected (js-call reference :poisoned mode))
                            (actual (text-call a "poisoned" (js-array mode))))
                       (js-call assert :equal actual expected)
                       (js-call assert :equal (aref (JSON/parse actual) 0) 0)
                       (let ((report (JSON/parse (aref (JSON/parse actual) 1))))
                         (js-call assert :deepEqual (aref report 5) (js-array t t t t))
                         (js-call (aref report 7) :forEach
                           (lambda (pair)
                             (js-call assert :deepEqual (aref pair 3) (js-array t t t t))))
                         (js-call (aref report 10) :forEach
                           (lambda (group)
                             (js-call assert :deepEqual (aref group 5) (js-array t t t t))))
                         (js-call a :collect)
                         (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))
                     (setq mode (+ mode 1))))))))
    30000)

  (test "indices allocation capacity and input-conversion throws preserve caller roots and permit later execution"
    (async ()
      (await (each-target (lambda (a _kind) (failure-recovery a reference))))
      (let ((rejected-options (js-object :maxSlots 128 :initialBytes 4096 :maxBytes 16384 :maximumPages 32)))
        (await (each-target
                 (lambda (a _kind)
                   (js-call assert :throws
                     (lambda () (text-call a "recover"))
                     (lambda (error)
                       (let ((diag (get error :eliscriptDiagnostic)))
                         (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
                   (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
                   (js-call a :collect))
                 rejected-options))
        (await (each-target
                 (lambda (a _kind)
                   (let* ((baseline (js-call a :stats))
                          (input (js-call a :string (str (js-call "a" :repeat 4096) "b")))
                          (zero (js-call a :number -0))
                          (frame (js-call a :frame 1)))
                     (js-call a :frameSet frame 0 zero)
                     (try
                       (js-call assert :throws
                         (lambda () (js-call a :invoke "capacity" (js-array input)))
                         (lambda (error)
                           (let ((diag (get error :eliscriptDiagnostic)))
                             (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
                       (js-call assert :equal (js-call a :readString input) (str (js-call "a" :repeat 4096) "b"))
                       (funcall assert (Object/is (js-call a :readNumber zero) -0))
                       (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                       (js-call a :release input)
                       (setq input undefined)
                       (js-call a :collect)
                       (js-call assert :equal (get (js-call a :stats) :usedBytes) (get baseline :usedBytes))
                       (js-call assert :equal (get (js-call a :stats) :liveValues) (get baseline :liveValues))
                       (funcall assert (Object/is (js-call a :readNumber zero) -0))
                       (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                       (finally
                         (js-call a :leaveFrame frame)
                         (js-call a :release zero)
                         (js-call a :release input)))))
                 rejected-options)))
      (let ((capacity-options options))
        (await (each-target
                 (async (a kind)
                   (let* ((baseline (js-call a :stats))
                          (stages (js-array (Object/assign (js-object :stage "initialized") baseline)))
                          (input undefined)
                          (padding undefined)
                          (zero (js-call a :number -0))
                          (frame (js-call a :frame 1)))
                     (js-call a :frameSet frame 0 zero)
                     (try
                       (setq padding (js-call a :string (js-call (String/fromCharCode 0) :repeat 450560)))
                       (setq input (js-call a :string (str (js-call "a" :repeat 4096) "b")))
                       (js-call assert :throws
                         (lambda () (js-call a :invoke "capacity" (js-array input)))
                         (lambda (error)
                           (let ((diag (get error :eliscriptDiagnostic)))
                             (= (if diag (get diag :code) undefined) "ELI-RT0002"))))
                       (js-call stages :push (Object/assign (js-object :stage "capacity-rejected") (js-call a :stats)))
                       (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                       (js-call assert :equal (js-call a :readString input) (str (js-call "a" :repeat 4096) "b"))
                       (funcall assert (Object/is (js-call a :readNumber zero) -0))
                       (js-call a :release input)
                       (setq input undefined)
                       (js-call a :release padding)
                       (setq padding undefined)
                       (js-call a :collect)
                       (js-call stages :push (Object/assign (js-object :stage "released-and-collected") (js-call a :stats)))
                       (js-call assert :equal (text-call a "recover") (js-call reference :recover))
                       (funcall assert (Object/is (js-call a :readNumber zero) -0))
                       (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                       (catch error
                         (let ((diag (if (nullish? error) undefined (get error :eliscriptDiagnostic))))
                           (js-call stages :push
                             (Object/assign
                               (js-object :stage "recovery-failed"
                                          :code (if diag (get diag :code) undefined))
                               (js-call a :stats))))
                         (let ((fresh undefined))
                           (try
                             (setq fresh
                               (if (= kind "wasm")
                                   (instantiateManagedRuntime bytes capacity-options)
                                   (await (instantiateNativeManagedRuntime library lowered
                                            (Object/assign (js-object) capacity-options (js-object :nativeTarget target))))))
                             (js-call fresh :auto 1)
                             (js-call stages :push (Object/assign (js-object :stage "fresh-initialized") (js-call fresh :stats)))
                             (js-call assert :equal (text-call fresh "recover") (js-call reference :recover))
                             (js-call stages :push (Object/assign (js-object :stage "fresh-recovered") (js-call fresh :stats)))
                             (catch control-error
                               (let ((cdiag (if (nullish? control-error) undefined (get control-error :eliscriptDiagnostic))))
                                 (js-call stages :push
                                   (Object/assign
                                     (js-object :stage "fresh-recovery-failed"
                                                :code (if cdiag (get cdiag :code) undefined)
                                                :name (if (nullish? control-error) undefined (get control-error :name)))
                                     (if fresh (js-call fresh :stats) (js-object))))))
                             (finally
                               (when fresh
                                 (try
                                   (finish fresh)
                                   (catch cleanup-error
                                     (let ((cldiag (if (nullish? cleanup-error) undefined (get cleanup-error :eliscriptDiagnostic))))
                                       (js-call stages :push
                                         (js-object :stage "fresh-cleanup-failed"
                                                    :code (if cldiag (get cldiag :code) undefined))))))))))
                         (console/error "[indices-capacity-recovery]"
                           (JSON/stringify (js-object :kind kind :options capacity-options :stages stages)))
                         (throw error))
                       (finally
                         (js-call a :leaveFrame frame)
                         (js-call a :release zero)
                         (js-call a :release input)
                         (js-call a :release padding)))))
                 capacity-options))
        (await (each-target
                 (lambda (a _kind)
                   (js-call assert :equal
                     (text-call a "recover")
                     (js-call reference :recover)
                     "the same full report succeeds in the existing full-report configuration")
                   (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
                 capacity-options))))
    30000)

  (test "independent Node executes the same generated JS and actual zero-import WASM index capture and lifecycle contracts"
    (lambda ()
      (let* ((env-node (get (get process :env) :NODE))
             (node-bin (if (nullish? env-node) "node" env-node))
             (managed-url (get (new globalThis.URL "../tools/backends/managed-runtime.mjs" (get (js* "import.meta") :url)) :href))
             (child (spawnSync node-bin
                      (js-array node-helper "--run-node-check"
                        (get (pathToFileURL referenceFile) :href)
                        managed-url
                        wasmFile)
                      (js-object
                        :encoding "utf8"
                        :input (JSON/stringify (js-object :cases cases :options options))
                        :timeout 30000
                        :maxBuffer 65536))))
        (js-call assert :equal (get child :error) undefined)
        (js-call assert :equal (get child :signal) nil)
        (js-call assert :equal (get child :status) 0 (get child :stderr))
        (js-call assert :deepEqual
          (JSON/parse (get child :stdout))
          (js-object :cases (get cases :length) :complete t))))
    30000))
