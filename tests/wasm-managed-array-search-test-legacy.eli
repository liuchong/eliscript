(module capsules.tests.wasm-managed-array-search-test-legacy
  (js* "import {beforeAll,afterAll,describe,test} from 'bun:test';import assert from 'node:assert/strict';\nimport {readFile,mkdtemp,rm,writeFile,mkdir,readdir} from 'node:fs/promises';import {resolve,relative} from 'node:path';import {tmpdir} from 'node:os';import {pathToFileURL} from 'node:url';import {spawnSync} from 'node:child_process';\nimport {buildBackends,root} from '../tools/backends/build.mjs';import {instantiateManagedRuntime} from '../tools/backends/managed-runtime.mjs';\nimport {chromium,firefox,webkit} from 'playwright-core';\nlet directory,b,runtime,source;\nbeforeAll(async()=>{directory=await mkdtemp(resolve(tmpdir(),'eliscript-array-search-'));b=await buildBackends({outputRoot:directory});runtime=b.compiler.compile_ir_string(await readFile('bootstrap/runtime/memory.eli','utf8'),'runtime.eli');source=await readFile('tests/fixtures/wasm-managed-array-search.eli','utf8');},120000);\nafterAll(async()=>{if(directory)await rm(directory,{recursive:true,force:true});});\nasync function compiled(text=source,options){const p=b.compiler.compile_ir_string(text,'array-search.eli'),saved=JSON.stringify(p),bytes=Uint8Array.from(b.managed.emit_managed_wasm(p,runtime));assert.equal(JSON.stringify(p),saved);assert(WebAssembly.validate(bytes));assert.deepEqual(WebAssembly.Module.imports(new WebAssembly.Module(bytes)),[]);const a=instantiateManagedRuntime(bytes,options);a.auto(1);const js=await import('data:text/javascript;base64,'+Buffer.from(b.compiler.emit_ir_string(p)).toString('base64'));return{a,js,bytes};}\nconst box=(a,v)=>typeof v==='number'?a.number(v):typeof v==='string'?a.string(v):v;\nfunction array(a,values){const entries=values.map(v=>box(a,v)),out=a.sourceArray(entries);entries.forEach(v=>a.release(v));return out;}\nfunction read(a,v){if(!v||typeof v!=='object')return v;if(v.kind===4)return a.readNumber(v);if(v.kind===5)return a.readString(v);return Array.from({length:a.length(v)},(_,i)=>{const x=a.get(v,i);try{return read(a,x);}finally{a.release(x);}});}\nfunction run(a,name,args=[]){const out=a.invoke(name,args);try{return read(a,out);}finally{a.release(out);}}\nfunction finish(a,values=[]){values.forEach(v=>a.release(v));a.closeModule();a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);}\n\ntest('Array includes uses SameValueZero while indexOf and lastIndexOf retain strict equality, sparse holes and exact fromIndex semantics',async()=>{\n const {a,js}=await compiled(),sparse=Array(5);sparse[1]=undefined;sparse[3]=NaN;const lists=[[],[0,-0,NaN,'中😀',false,null,undefined,0],sparse],starts=[undefined,null,false,true,NaN,Infinity,-Infinity,-0,0,.9,-.9,1.9,-1.9,4,5,9,-9,2**31,-(2**31),2**32,-(2**32),2**53,-(2**53),Number.MIN_VALUE,-Number.MIN_VALUE,'2','-2','x'];\n for(const values of lists){const items=array(a,values);for(const value of[undefined,null,false,NaN,0,-0,'中😀','missing']){const needle=box(a,value);for(const start of starts){const from=box(a,start);for(const name of['includes','index','last'])assert(Object.is(run(a,name,[items,needle,from]),js[name](values,value,start)),name+':'+String(start));a.release(from);}assert.equal(run(a,'default-last',[items,needle]),js.default_last(values,value));a.release(needle);}for(const name of['missing-includes','missing-index','missing-last'])assert.equal(run(a,name,[items]),js[name.replaceAll('-','_')](values));a.release(items);}finish(a);\n});\n\ntest('search snapshots length before fromIndex conversion and reads mutations live while ignoring growth past the snapshot',async()=>{\n const text='(defconst marker 1) (defun f (method mode needle) (let* ((items (js-array 1 2 3)) (trace (js-object :calls 0)) (from (js-object :valueOf (lambda () (put trace :calls (1+ (get trace :calls))) (cond ((= mode 0) (put items :length 1)) ((= mode 1) (js-call items :push needle)) (t (put items 1 needle))) 0)))) (let ((out (cond ((= method 0) (js-call items :includes needle from)) ((= method 1) (js-call items :indexOf needle from)) (t (js-call items :lastIndexOf needle (js-object :valueOf (lambda () (put trace :calls (1+ (get trace :calls))) (cond ((= mode 0) (put items :length 1)) ((= mode 1) (js-call items :push needle)) (t (put items 1 needle))) 9))))))) (js-array out (js-length items) (get trace :calls))))) (export f)';\n const {a,js}=await compiled(text);for(const method of[0,1,2])for(const mode of[0,1,2])for(const needle of[undefined,9]){const m=a.number(method),mood=a.number(mode),n=box(a,needle);assert.deepEqual(run(a,'f',[m,mood,n]),js.f(method,mode,needle));[m,mood,n].forEach(v=>a.release(v));}finish(a);\n});\n\ntest('empty searches skip fromIndex coercion after evaluating every argument and own methods are captured before those argument effects',async()=>{\n const text='(defconst marker 1) (defun empty () (let ((trace (js-object :events \"\")) (items (js-array))) (let ((bad (js-object :valueOf (lambda () (put trace :events \"wrong\") (js-object)) :toString (lambda () (js-object))))) (js-array (js-call items :includes nil bad (put trace :events \"extra\")) (js-call items :indexOf nil bad) (js-call items :lastIndexOf nil bad) (get trace :events))))) (defun captured () (let ((items (js-array)) (trace (js-object :events \"\"))) (put items :includes (lambda (x &rest tail) (str \"captured:\" x \":\" (js-length tail)))) (js-array (js-call items :includes (progn (put items :includes false) \"key\") (put trace :events \"from\") (put trace :events \"extra\")) (get trace :events)))) (export empty captured)';const{a,js}=await compiled(text);for(const name of['empty','captured'])assert.deepEqual(run(a,name),js[name]());finish(a);\n});\n\ntest('opaque values compare by identity without coercion and identical String search methods retain their original results',async()=>{\n const text='(defconst marker 1) (defun identities () (let ((object (js-object :valueOf (lambda () (js-call nil :charAt 0)))) (other (js-object)) (fn (lambda () 1))) (let ((items (js-array object fn \"x\"))) (js-array (js-call items :includes object) (js-call items :indexOf object) (js-call items :lastIndexOf fn) (js-call items :includes other) (js-call items :indexOf (js-object)))))) (defun ordinary () (let ((o (js-object :includes (lambda (x) (str \"own:\" x)) :indexOf (lambda (x) x) :lastIndexOf (lambda () 19)))) (js-array (js-call o :includes \"x\") (js-call o :indexOf 7) (js-call o :lastIndexOf)))) (export identities ordinary)';const{a,js}=await compiled(text);for(const name of['identities','ordinary'])assert.deepEqual(run(a,name),js[name]());finish(a);\n const family=await compiled();for(const s of['','a😀a','中\\ud800x'])for(const needle of['','a','😀','中',undefined])for(const start of[undefined,NaN,Infinity,-Infinity,-1,0,1.5,9]){const input=family.a.string(s),n=box(family.a,needle),from=box(family.a,start);for(const name of['includes','index','last'])assert(Object.is(run(family.a,name,[input,n,from]),family.js[name](s,needle,start)));[input,n,from].forEach(v=>family.a.release(v));}finish(family.a);\n});\n\ntest('random sparse numeric and Unicode searches agree exactly with JS under per-allocation collection',async()=>{\n const{a,js}=await compiled();let seed=0x831ac519;const next=()=>seed=(Math.imul(seed,1664525)+1013904223)>>>0,pool=[undefined,null,false,true,NaN,-0,0,Number.MIN_VALUE,'','中😀','\\ud800',-3,2];for(let k=0;k<128;k++){const values=Array.from({length:next()%32},()=>pool[next()%pool.length]);for(let i=0;i<values.length;i++)if(next()%4===0)delete values[i];const items=array(a,values);for(let t=0;t<8;t++){const needle=pool[next()%pool.length],start=(next()%100-50)/3,n=box(a,needle),f=a.number(start);for(const name of['includes','index','last'])assert(Object.is(run(a,name,[items,n,f]),js[name](values,needle,start)));a.release(n);a.release(f);}a.release(items);}finish(a);\n});\n\ntest('invalid receivers, conversion failures and real WASM traps preserve caller roots and evaluated argument effects',async()=>{\n const text='(defconst marker 1) (defun bad (items trace) (js-call items :indexOf (put trace :visited t) 0)) (defun convert (items trace) (js-call items :includes nil (js-object :valueOf (lambda () (put trace :visited t) (js-object)) :toString (lambda () (js-object))))) (export bad convert)';const{a,js}=await compiled(text),trace=a.sourceObject({visited:false}),key=a.string('visited');for(const receiver of[null,undefined,false,true]){a.objectSet(trace,key,false);assert.throws(()=>a.invoke('bad',[receiver,trace]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');const ref={visited:false};assert.throws(()=>js.bad(receiver,ref),TypeError);assert.equal(a.objectGet(trace,key),ref.visited);}const items=array(a,[null]),caller=a.frame(1);a.frameSet(caller,0,items);assert.throws(()=>a.invoke('convert',[items,trace]),e=>e.eliscriptDiagnostic?.code==='ELI-RT0003');assert.equal(a.stats().frameDepth,1);a.leaveFrame(caller);finish(a,[items,trace,key]);\n const raw=await readFile('bootstrap/runtime/memory.eli','utf8'),start=raw.indexOf('  (defun heap-array-search '),end=raw.indexOf('  (defun value-sequence-search ',start);assert(start>=0&&end>start);const injected=b.compiler.compile_ir_string(raw.slice(0,start)+'  (defun heap-array-search (heap items needle from present mode) (load-u32 4294967295))\\n'+raw.slice(end),'trap.eli'),p=b.compiler.compile_ir_string(text,'search-trap.eli'),trap=instantiateManagedRuntime(Uint8Array.from(b.managed.emit_managed_wasm(p,injected)));trap.auto(1);const t=trap.sourceObject({visited:false}),k=trap.string('visited'),input=array(trap,[1]),frame=trap.frame(1);trap.frameSet(frame,0,input);assert.throws(()=>trap.invoke('bad',[input,t]),WebAssembly.RuntimeError);assert.equal(trap.stats().frameDepth,1);assert.equal(trap.objectGet(t,k),true);trap.leaveFrame(frame);finish(trap,[t,k,input]);\n});\n\ntest('raw search boundaries reject invalid handles and private frames, preserve sparse shape and recover after slot exhaustion',async()=>{\n const{a,bytes}=await compiled();finish(a);const e=new WebAssembly.Instance(new WebAssembly.Module(bytes)).exports,h=e['heap-new'](32,8192,8192),call=(n,...args)=>{const out=e[n](h,...args)>>>0;assert.equal(e['last-error'](),0,n);return out;},items=call('value-array-new',2),empty=call('value-array-new',0),unsealed=call('value-string',1),frame=call('frame-new',2);call('frame-set',frame,0,items);call('frame-set',frame,1,empty);call('heap-pin',unsealed);call('heap-auto',1);\n for(const[receiver,needle,from,present,mode,code]of[[0xffffffff,3,3,0,0,1],[items,0xffffffff,3,0,0,1],[items,3,0xffffffff,1,0,1],[items,frame,3,0,0,3],[items,unsealed,3,0,0,6],[items,3,frame,1,0,3],[items,3,3,2,0,3],[items,3,3,0,3,3],[frame,3,3,0,0,3]]){assert.equal(e['value-sequence-search'](h,receiver,needle,from,present,mode),0);assert.equal(e['last-error'](),code);assert.equal(call('frame-depth'),1);assert.equal(call('frame-get',frame,0),items);}\n const held=[];for(let i=0;i<64;i++){const n=e['value-number'](h,0,0);if(!n){assert.equal(e['last-error'](),2);break;}call('heap-pin',n);held.push(n);}assert.equal(call('value-sequence-search',empty,3,unsealed,1,0),1);assert.equal(e['value-sequence-search'](h,items,3,3,0,0),0);assert.equal(e['last-error'](),2);assert.equal(call('frame-depth'),1);held.forEach(n=>call('heap-release',n));call('heap-collect');assert.equal(call('value-sequence-search',items,3,3,0,0),2);assert.equal(new DataView(e.memory.buffer).getUint32(call('value-data',items,14),true),4);call('heap-release',unsealed);call('frame-pop',frame);call('heap-collect');assert.equal(call('heap-live'),0);\n});\n\ntest('public Seed and three compiler generations retain identical search IR descriptors and executable zero-import bytes',async()=>{\n const output=resolve(directory,'search-seed.mjs'),seed=spawnSync(resolve(root,'bin/eliscript-seed'),['--output',output,resolve(root,'tests/fixtures/wasm-managed-array-search.eli')],{encoding:'utf8',timeout:30000});assert.equal(seed.status,0,seed.stderr);const seedJs=await readFile(output,'utf8'),all=[b],runtimeSource=await readFile('bootstrap/runtime/memory.eli','utf8'),files=(await readdir('bootstrap/compiler')).filter(f=>f.endsWith('.eli')).sort();\n for(const name of['g2','g3']){const previous=all.at(-1).compiler,out=resolve(directory,name),bootstrap=resolve(out,'bootstrap');await mkdir(bootstrap,{recursive:true});for(const file of files){const input=resolve(root,'bootstrap/compiler',file),target=file.replace(/\\.eli$/,'.mjs'),emission=previous.compile_string_with_source_map(await readFile(input,'utf8'),input,target,relative(bootstrap,input));await writeFile(resolve(bootstrap,target),emission.javascript);}const next=await buildBackends({outputRoot:out,frontend:previous});next.compiler=await import(pathToFileURL(resolve(bootstrap,'compiler.mjs')).href);all.push(next);}\n let canonical,lowered,bytes;for(const g of all){const p=g.compiler.compile_ir_string(source,'array-search.eli'),rt=g.compiler.compile_ir_string(runtimeSource,'runtime.eli'),lower=g.managed.lower_managed_program(p,rt),binary=g.managed.emit_managed_wasm(p,rt);assert.equal(g.compiler.emit_ir_string(p),seedJs);if(canonical){assert.deepEqual(p,canonical);assert.deepEqual(lower,lowered);assert.deepEqual(binary,bytes);}else{canonical=p;lowered=lower;bytes=binary;}const a=instantiateManagedRuntime(Uint8Array.from(binary));a.auto(1);const items=array(a,[NaN,-0,undefined]),nan=a.number(NaN);assert.equal(run(a,'includes',[items,nan,undefined]),true);a.release(nan);const zero=a.number(0);assert.equal(run(a,'default-last',[items,zero]),1);a.release(zero);a.release(items);a.closeModule();a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);}\n},120000);\n\ntest('Node independently executes identical search bytes and original sparse-array semantics',async()=>{\n const{a,bytes}=await compiled();finish(a);const file=resolve(directory,'search.wasm');await writeFile(file,bytes);const result=spawnSync('node',['--input-type=module','-e',`import assert from 'node:assert/strict';import{readFileSync}from'node:fs';const{instantiateManagedRuntime}=await import(process.argv[1]),a=instantiateManagedRuntime(readFileSync(process.argv[2]));a.auto(1);let state=0x2741ac93;const next=()=>state=(Math.imul(state,1664525)+1013904223)>>>0;for(let k=0;k<128;k++){const values=Array.from({length:next()%24},()=>next()%4?next()%7:NaN);for(let i=0;i<values.length;i++)if(next()%4===0)delete values[i];const refs=values.map(x=>a.number(x)),items=a.sourceArray(refs);refs.forEach(x=>a.release(x));for(const needle of[undefined,NaN,0,-0,3]){const n=typeof needle==='number'?a.number(needle):needle;for(const from of[undefined,-Infinity,Infinity,NaN,-1.9,-.9,0,1.9,100]){const f=typeof from==='number'?a.number(from):from;for(const[name,method]of[['includes','includes'],['index','indexOf'],['last','lastIndexOf']]){const out=a.invoke(name,[items,n,f]),actual=out?.kind===4?a.readNumber(out):out;assert(Object.is(actual,values[method](needle,from)));a.release(out);}a.release(f);}a.release(n);}a.release(items);}a.closeModule();a.collect();assert.equal(a.live(),0);assert.equal(a.stats().frameDepth,0);`,pathToFileURL(resolve('tools/backends/managed-runtime.mjs')).href,file],{encoding:'utf8',timeout:30000});assert.equal(result.status,0,result.stderr);\n});\n\ndescribe('actual browser array search',()=>{\n let browser,bundle,runtimeSource;const browserName=process.env.ELISCRIPT_TEST_BROWSER??'chromium';assert(Object.hasOwn({chromium,firefox,webkit},browserName));\n beforeAll(async()=>{runtimeSource=await readFile('bootstrap/runtime/memory.eli','utf8');const entry=resolve(directory,'search-browser.mjs');await writeFile(entry,`export{compile_ir_string,emit_ir_string}from ${JSON.stringify(resolve(directory,'bootstrap/compiler.mjs'))};export{emit_managed_wasm}from ${JSON.stringify(resolve(b.directory,'managed.mjs'))};export{instantiateManagedRuntime}from ${JSON.stringify(resolve(root,'tools/backends/managed-runtime.mjs'))};`);const build=await Bun.build({entrypoints:[entry],target:'browser',format:'esm'});assert(build.success);bundle=await build.outputs[0].text();browser=await({chromium,firefox,webkit}[browserName]).launch();const page=await browser.newPage();await page.goto('about:blank');await page.close();},120000);\n afterAll(async()=>{if(browser)await browser.close();});\n test('browser compiler emits identical search bytes and executes exact equality holes and fromIndex results against its own JS',async()=>{\n  const context=await browser.newContext();try{const page=await context.newPage();await page.goto('about:blank');const binary=await page.evaluate(async({bundle,source,runtimeSource})=>{const url=URL.createObjectURL(new Blob([bundle],{type:'text/javascript'}));let oracleUrl;try{const c=await import(url),p=c.compile_ir_string(source,'array-search.eli'),bytes=Uint8Array.from(c.emit_managed_wasm(p,c.compile_ir_string(runtimeSource,'runtime.eli')));if(WebAssembly.Module.imports(new WebAssembly.Module(bytes)).length)throw Error('imports');oracleUrl=URL.createObjectURL(new Blob([c.emit_ir_string(p)],{type:'text/javascript'}));const js=await import(oracleUrl),a=c.instantiateManagedRuntime(bytes);a.auto(1);let seed=0x4162a935;const next=()=>seed=(Math.imul(seed,1664525)+1013904223)>>>0,pool=[undefined,null,false,NaN,0,-0,'中😀','\\ud800',1,3],box=v=>typeof v==='number'?a.number(v):typeof v==='string'?a.string(v):v;for(let k=0;k<64;k++){const values=Array.from({length:next()%24},()=>pool[next()%pool.length]);for(let i=0;i<values.length;i++)if(next()%4===0)delete values[i];const refs=values.map(box),items=a.sourceArray(refs);refs.forEach(v=>a.release(v));for(const needle of[undefined,NaN,0,'中😀']){const n=box(needle);for(const start of[undefined,-Infinity,Infinity,NaN,-.9,-1.9,0,1.9,9]){const from=box(start);for(const name of['includes','index','last']){const out=a.invoke(name,[items,n,from]),actual=out?.kind===4?a.readNumber(out):out;if(!Object.is(actual,js[name](values,needle,start)))throw Error(name+':'+start);a.release(out);}a.release(from);}const out=a.invoke('default-last',[items,n]);if(!Object.is(a.readNumber(out),js.default_last(values,needle)))throw Error('missing last fromIndex');a.release(out);a.release(n);}a.release(items);}a.closeModule();a.collect();if(a.live()!==0||a.stats().frameDepth!==0)throw Error('cleanup');return [...bytes];}finally{URL.revokeObjectURL(url);if(oracleUrl)URL.revokeObjectURL(oracleUrl);}}, {bundle,source,runtimeSource});assert.deepEqual(binary,b.managed.emit_managed_wasm(b.compiler.compile_ir_string(source,'array-search.eli'),b.compiler.compile_ir_string(runtimeSource,'runtime.eli')));}finally{await context.close();}\n });\n});\n\ntest('fromIndex uses valueOf then toString after extra arguments and snapshots every converted operand through GC',async()=>{\n const text=`(defconst marker 1)\n (defun f (method)\n   (let* ((trace (js-object :events \"\")) (items (js-array 1 2 1))\n          (from (js-object :valueOf (lambda () (put trace :events (str (get trace :events) \"v\")) (js-object))\n                           :toString (lambda () (put trace :events (str (get trace :events) \"s\")) \"-1.9\"))))\n     (str (cond ((= method 0) (js-call items :includes 1 from (put trace :events \"e\")))\n                ((= method 1) (js-call items :indexOf 1 from (put trace :events \"e\")))\n                (t (js-call items :lastIndexOf 1 from (put trace :events \"e\"))))\n          \":\" (get trace :events))))\n (export f)`,{a,js}=await compiled(text);for(const method of[0,1,2]){const m=a.number(method);assert.equal(run(a,'f',[m]),js.f(method));a.release(m);}finish(a);\n});\n"))
