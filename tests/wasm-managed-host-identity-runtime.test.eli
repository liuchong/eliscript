(module tests.wasm-managed-host-identity-runtime.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/build.mjs" buildBackends)

  (defvar directory undefined)
  (defvar b undefined)
  (defvar source undefined)
  (defvar bytes undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-host-identity-"))))
    (setq b (await (buildBackends (js-object :outputRoot directory))))
    (setq source (str (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "\n(export value-function-new)"))
    (setq bytes (Uint8Array/from (js-call (get b :wasm) :emit_memory_wasm
                                   (js-call (get b :compiler) :compile_ir_string source "identity-runtime.eli")
                                   (js-object :maximumPages 256))))
    (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array)))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun runtime (&rest __host_default_arguments_1)
    (let* ((slots-arg (aref __host_default_arguments_1 0)) (initial-arg (aref __host_default_arguments_1 1)) (max-arg (aref __host_default_arguments_1 2)) (data-arg (aref __host_default_arguments_1 3)))
    (let* ((slots (if (undefined? slots-arg) 256 slots-arg))
           (initial (if (undefined? initial-arg) 16384 initial-arg))
           (max (if (undefined? max-arg) 1048576 max-arg))
           (data (if (undefined? data-arg) bytes data-arg))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module data)) :exports))
           (r (Object/fromEntries
                (js-call (Object/entries e) :map
                  (lambda (pair)
                    (let ((k (aref pair 0))
                          (v (aref pair 1)))
                      (js-array (js-call k :replaceAll "-" "_")
                                (if (= (value-type v) "function")
                                  (lambda (&rest a) (uint32 (Reflect/apply v undefined a)))
                                  v)))))))
           (h (js-call r :heap_new slots initial max)))
      (funcall assert h)
      (js-call assert :equal (value-type (get r :value_host_identity_state_new)) "function")
      (js-call assert :equal (value-type (get r :value_host_identity_token)) "function")
      (js-object :r r :h h))))

  (defun read (r h value)
    (funcall assert value)
    (js-call assert :equal (js-call r :last_error) 0)
    (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getFloat64 (js-call r :value_data h value 4) t))

  (defun token (r h state value)
    (let ((out (js-call r :value_host_identity_token h state value)))
      (read r h out)))

  (defun text (r h s)
    (let ((out (js-call r :value_string h (js-length s)))
          (i 0))
      (funcall assert out)
      (while (< i (js-length s))
        (js-call r :value_unit_set h out i (js-call s :charCodeAt i))
        (setq i (1+ i)))
      (js-call r :value_seal h out)
      out))

  (defun readText (r h value)
    (let ((p (js-call r :value_data h value 5))
          (n (js-call r :value_length h value))
          (v (new globalThis.DataView (get (get r :memory) :buffer))))
      (js-call (Array/from (js-object :length n)
                 (lambda (_ i) (String/fromCharCode (js-call v :getUint16 (+ p (* i 2)) t))))
               :join "")))

  (defun thrown (r h)
    (js-call assert :equal (js-call r :last_error) 11)
    (let ((error (js-call r :value_exception_take h)))
      (funcall assert error)
      (js-call r :heap_pin h error)
      (let ((fields (js-object)))
        (js-call (js-array "name" "message") :forEach
          (lambda (name)
            (let* ((key (text r h name))
                   (value (js-call r :value_object_get h error key)))
              (funcall assert value)
              (put fields name (readText r h value)))))
        (js-call r :heap_release h error)
        fields)))

  (defun pinned (r h handle)
    (funcall assert handle)
    (js-call assert :equal (js-call r :heap_pin h handle) 1)
    handle)

  (defun clear (r h roots)
    (js-call roots :forEach (lambda (x) (js-call r :heap_release h x)))
    (js-call r :heap_collect h)
    (js-call assert :equal (js-call r :heap_live h) 0)
    (js-call assert :equal (js-call r :frame_depth h) 0))

  (test "module-owned identity state assigns stable independent monotonic tokens rather than exposing reusable heap handles" (lambda ()
    (let* ((ctx (runtime))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (js-call r :value_host_identity_state_new h)))
      (funcall assert state)
      (js-call r :heap_pin h state)
      (let ((a (js-call r :value_array_new h 0))
            (c (js-call r :value_array_new h 0))
            (f (js-call r :value_function_new h 7 0)))
        (js-call (js-array a c f) :forEach (lambda (v) (js-call r :heap_pin h v)))
        (js-call r :heap_auto h 1)
        (js-call assert :equal (token r h state a) 1)
        (js-call assert :equal (token r h state a) 1)
        (js-call assert :equal (token r h state c) 2)
        (js-call assert :equal (token r h state f) 3)
        (let ((other (js-call r :value_host_identity_state_new h)))
          (funcall assert other)
          (js-call r :heap_pin h other)
          (js-call assert :equal (token r h other c) 1)
          (js-call assert :equal (token r h other a) 2)
          (js-call assert :equal (token r h state a) 1)
          (js-call (js-array state other a c f) :forEach (lambda (v) (js-call r :heap_release h v)))
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)
          (js-call assert :equal (js-call r :frame_depth h) 0))))))

  (test "invalid scalar types throw the exact native TypeError without losing frames, while stale and private ABI inputs stay rejected" (lambda ()
    (let* ((ctx (runtime))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (number (pinned r h (js-call r :value_number h 0 2146959360)))
           (s (pinned r h (text r h "中\ud800")))
           (held (pinned r h (js-call r :value_number h 0 2147483648)))
           (frame (js-call r :frame_new h 1)))
      (js-call r :frame_set h frame 0 held)
      (js-call r :heap_auto h 1)
      (js-call (js-array 0 1 2 3 number s) :forEach
        (lambda (value)
          (js-call assert :equal (js-call r :value_host_identity_token h state value) 0)
          (js-call assert :deepEqual (thrown r h) (js-object :name "TypeError" :message "host-identity-token expects an object, function, or symbol"))
          (js-call assert :equal (js-call r :frame_depth h) 1)
          (funcall assert (Object/is (read r h held) -0.0))))
      (js-call
        (js-array
          (js-array state frame 3)
          (js-array state 4294967295 1)
          (js-array 4294967295 s 1)
          (js-array s number 1)
          (js-array state state 3))
        :forEach
        (lambda (triple)
          (js-call assert :equal (js-call r :value_host_identity_token h (aref triple 0) (aref triple 1)) 0)
          (js-call assert :equal (js-call r :last_error) (aref triple 2))
          (js-call assert :equal (js-call r :frame_depth h) 1)))
      (let ((stale (js-call r :value_array_new h 0)))
        (js-call r :heap_collect h)
        (js-call assert :equal (js-call r :value_host_identity_token h state stale) 0)
        (js-call assert :equal (js-call r :last_error) 1)
        (js-call r :frame_pop h frame)
        (clear r h (js-array state number s held))))))

  (test "weak object and function entries release their keys and never alias a recycled slot or counter" (lambda ()
    (let* ((ctx (runtime 32 4096 65536))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (reused false)
           (previous 0)
           (i 0))
      (js-call r :heap_auto h 1)
      (while (< i 120)
        (let ((value (if (not (= (% i 2) 0)) (js-call r :value_function_new h 7 0) (js-call r :value_array_new h 0))))
          (funcall assert value)
          (js-call assert :equal (token r h state value) (+ i 1))
          (when (and (not (= previous 0)) (= (bit-and previous 1048575) (bit-and value 1048575)))
            (setq reused t))
          (setq previous value)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 4)
          (js-call assert :equal (js-call r :value_kind h value) 0)
          (js-call assert :equal (js-call r :last_error) 1))
        (setq i (1+ i)))
      (funcall assert reused "the fixture must actually recycle an earlier slot")
      (clear r h (js-array state)))))

  (test "Symbol entries hold their keys strongly for the state lifetime while weak keys remain collectable" (lambda ()
    (let* ((ctx (runtime))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (symbol (js-call r :value_symbol_well_known h 0)))
      (funcall assert symbol)
      (js-call assert :equal (token r h state symbol) 1)
      (js-call r :heap_collect h)
      (js-call assert :equal (js-call r :value_kind h symbol) 22)
      (js-call assert :equal (token r h state symbol) 1)
      (js-call r :heap_collect h)
      (js-call assert :equal (js-call r :heap_live h) 7)
      (let ((object (js-call r :value_array_new h 0)))
        (js-call assert :equal (token r h state object) 2)
        (js-call r :heap_collect h)
        (js-call assert :equal (js-call r :value_kind h object) 0)
        (js-call assert :equal (js-call r :last_error) 1)
        (clear r h (js-array state))))))

  (test "rehashing preserves all live identities, cleans stale collisions and survives actual pool growth" (lambda ()
    (let* ((ctx (runtime 1024 32768 1048576))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (kept (js-array))
           (i 0))
      (js-call r :heap_auto h 1)
      (while (< i 192)
        (let ((object (pinned r h (js-call r :value_array_new h 0))))
          (js-call assert :equal (token r h state object) (+ i 1))
          (if (= (% i 3) 0)
            (js-call kept :push (js-array object (+ i 1)))
            (js-call r :heap_release h object))
          (when (= (% i 7) 0)
            (js-call r :heap_collect h)))
        (setq i (1+ i)))
      (js-call (js-call kept :reverse) :forEach
        (lambda (pair) (js-call assert :equal (token r h state (aref pair 0)) (aref pair 1))))
      (let ((grow (pinned r h (js-call r :value_bytes h 70000))))
        (funcall assert (> (js-call r :heap_capacity h) 32768))
        (js-call kept :forEach
          (lambda (pair) (js-call assert :equal (token r h state (aref pair 0)) (aref pair 1))))
        (clear r h (js-call (js-array state grow) :concat (js-call kept :map (lambda (pair) (aref pair 0)))))))))

  (test "tokens cross 2^32 exactly, exhaust only after MAX_SAFE_INTEGER and still return older cached identities" (lambda ()
    (let* ((ctx (runtime))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (objects (Array/from (js-object :length 6) (lambda () (pinned r h (js-call r :value_array_new h 0)))))
           (counter (js-call r :value_get h state 0))
           (set (lambda (value)
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :setFloat64 (js-call r :value_data h counter 6) value t))))
      (js-call r :heap_auto h 1)
      (funcall set 4294967295)
      (let ((i 0))
        (while (< i 3)
          (js-call assert :equal (token r h state (aref objects i)) (+ 4294967295 i))
          (setq i (1+ i))))
      (funcall set (- globalThis.Number.MAX_SAFE_INTEGER 1))
      (js-call assert :equal (token r h state (aref objects 3)) (- globalThis.Number.MAX_SAFE_INTEGER 1))
      (js-call assert :equal (token r h state (aref objects 4)) globalThis.Number.MAX_SAFE_INTEGER)
      (js-call assert :equal (js-call r :value_host_identity_token h state (aref objects 5)) 0)
      (js-call assert :deepEqual (thrown r h) (js-object :name "RangeError" :message "host identity token space exhausted"))
      (let ((i 0))
        (while (< i 5)
          (js-call assert :equal
            (token r h state (aref objects i))
            (if (< i 3) (+ 4294967295 i) (+ (- globalThis.Number.MAX_SAFE_INTEGER 4) i)))
          (setq i (1+ i))))
      (clear r h (js-call (js-array state) :concat objects)))))

  (test "genuine state and result-slot OOM preserve counters, cached values and caller roots for retry" (lambda ()
    (let* ((small (runtime 4 4096 4096))
           (sr (get small :r))
           (sh (get small :h)))
      (js-call sr :heap_auto sh 1)
      (js-call assert :equal (js-call sr :value_host_identity_state_new sh) 0)
      (js-call assert :equal (js-call sr :last_error) 2)
      (js-call sr :heap_collect sh)
      (js-call assert :equal (js-call sr :heap_live sh) 0)
      (js-call assert :equal (js-call sr :frame_depth sh) 0))
    (let* ((ctx (runtime 8 4096 4096))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (object (pinned r h (js-call r :value_array_new h 0)))
           (a (pinned r h (js-call r :value_bytes h 0)))
           (c (pinned r h (js-call r :value_bytes h 0))))
      (js-call r :heap_auto h 1)
      (js-call assert :equal (js-call r :value_host_identity_token h state object) 0)
      (js-call assert :equal (js-call r :last_error) 2)
      (js-call assert :equal (js-call r :frame_depth h) 0)
      (js-call r :heap_release h a)
      (js-call r :heap_collect h)
      (js-call assert :equal (token r h state object) 1)
      (js-call assert :equal (token r h state object) 1)
      (clear r h (js-array state object c)))))

  (test "independent heaps and retained states keep identity counters and weak lifetimes isolated" (lambda ()
    (let* ((ctx (runtime))
           (r (get ctx :r))
           (h (get ctx :h))
           (other (js-call r :heap_new 256 16384 1048576))
           (peerBuffer (pinned r other (js-call r :value_bytes other 0)))
           (left (pinned r h (js-call r :value_host_identity_state_new h)))
           (right (pinned r other (js-call r :value_host_identity_state_new other)))
           (a (pinned r h (js-call r :value_array_new h 0)))
           (c (pinned r other (js-call r :value_array_new other 0))))
      (js-call assert :equal (token r h left a) 1)
      (js-call assert :equal (token r other right c) 1)
      (js-call assert :equal (js-call r :value_host_identity_token other left c) 0)
      (js-call assert :equal (js-call r :last_error) 1)
      (js-call r :heap_release h a)
      (js-call r :heap_collect h)
      (js-call assert :equal (token r other right c) 1)
      (clear r h (js-array left))
      (clear r other (js-array right c peerBuffer)))))

  (defasync injectedRuntime (from replacement)
    (let* ((start (js-call source :indexOf (str "  (defun " from " ")))
           (end (js-call source :indexOf "  (defun " (+ start 3))))
      (funcall assert (and (>= start 0) (> end start)))
      (let* ((modified (str (js-call source :slice 0 start) replacement "\n" (js-call source :slice end)))
             (ir (js-call (get b :compiler) :compile_ir_string modified "identity-trap.eli"))
             (artifact (Uint8Array/from (js-call (get b :wasm) :emit_memory_wasm ir (js-object :maximumPages 256)))))
        (runtime 256 16384 1048576 artifact))))

  (test "identity lookup never reads object fields, brands, prototypes or conversion hooks" (async ()
    (let* ((signature "(defun heap-source-primitive (heap value hint)")
           (modified (js-call source :replace signature (str signature " (load-u32 4294967295)")))
           (ir (js-call (get b :compiler) :compile_ir_string modified "identity-nohooks.eli"))
           (artifact (Uint8Array/from (js-call (get b :wasm) :emit_memory_wasm ir (js-object :maximumPages 256))))
           (ctx (runtime 256 16384 1048576 artifact))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (object (pinned r h (js-call r :value_object_new h 3))))
      (js-call r :heap_auto h 1)
      (js-call (js-array "toString" "valueOf" "kind") :forEach
        (lambda (name)
          (let ((key (text r h name)))
            (js-call r :heap_pin h key)
            (js-call assert :equal (js-call r :value_object_put h object key 1 2) 1)
            (js-call r :heap_release h key))))
      (js-call assert :equal (token r h state object) 1)
      (js-call assert :equal (token r h state object) 1)
      (let* ((trace (js-array))
             (key (new globalThis.Proxy (lambda () nil)
                    (js-object
                      :get (lambda () (js-call trace :push "get") (throw (globalThis.Error "must not read")))
                      :getPrototypeOf (lambda () (js-call trace :push "prototype") (throw (globalThis.Error "must not inspect"))))))
             (weak (new globalThis.WeakMap)))
        (js-call weak :set key 1)
        (js-call assert :equal (js-call weak :get key) 1)
        (js-call assert :deepEqual trace (js-array))
        (clear r h (js-array state object))))))

  (test "true weak-table rebuild OOM leaves the old cache valid and can recover after capacity is released" (lambda ()
    (let* ((ctx (runtime 128 8192 8192))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (objects (Array/from (js-object :length 7) (lambda () (pinned r h (js-call r :value_array_new h 0)))))
           (i 0))
      (js-call r :heap_auto h 1)
      (while (< i 6)
        (js-call assert :equal (token r h state (aref objects i)) (+ i 1))
        (setq i (1+ i)))
      (js-call r :heap_collect h)
      (let* ((available (- 8192 (js-call r :heap_used h)))
             (filler (pinned r h (js-call r :value_bytes h (- available 32)))))
        (js-call assert :equal (js-call r :value_host_identity_token h state (aref objects 6)) 0)
        (js-call assert :equal (js-call r :last_error) 2)
        (js-call assert :equal (js-call r :frame_depth h) 0)
        (js-call r :heap_release h filler)
        (js-call r :heap_collect h)
        (let ((j 0))
          (while (< j 6)
            (js-call assert :equal (token r h state (aref objects j)) (+ j 1))
            (setq j (1+ j))))
        (js-call assert :equal (token r h state (aref objects 6)) 7)
        (clear r h (js-call (js-array state) :concat objects))))))

  (test "actual weak and strong cache-growth traps need only normal frame unwind, never leaked borrowed pins" (async ()
    (let ((modes (js-array false t))
          (idx 0))
      (while (< idx (js-length modes))
        (let* ((strong (aref modes idx))
               (ctx (await (injectedRuntime
                             (if strong "heap-table-grow" "heap-host-identity-rebuild")
                             (if strong
                               "  (defun heap-table-grow (heap table) (load-u32 4294967295))"
                               "  (defun heap-host-identity-rebuild (heap state) (load-u32 4294967295))"))))
               (r (get ctx :r))
               (h (get ctx :h))
               (state (pinned r h (js-call r :value_host_identity_state_new h)))
               (args (pinned r h (js-call r :value_refs h 7 0)))
               (count (if strong 5 7))
               (keys (js-array))
               (i 0))
          (js-call r :heap_auto h 1)
          (while (< i count)
            (js-call keys :push (pinned r h (if strong (js-call r :value_symbol_builtin h args 0 0) (js-call r :value_array_new h 0))))
            (setq i (1+ i)))
          (let ((j 0))
            (while (< j (- count 1))
              (js-call assert :equal (token r h state (aref keys j)) (+ j 1))
              (setq j (1+ j))))
          (let ((caller (js-call r :frame_new h 1)))
            (js-call r :frame_set h caller 0 state)
            (js-call assert :throws
              (lambda () (js-call r :value_host_identity_token h state (aref keys (- count 1))))
              globalThis.WebAssembly.RuntimeError)
            (funcall assert (> (js-call r :frame_depth h) 1))
            (js-call r :frame_unwind h caller)
            (js-call assert :equal (js-call r :frame_depth h) 1)
            (let ((k 0))
              (while (< k (- count 1))
                (js-call assert :equal (token r h state (aref keys k)) (+ k 1))
                (setq k (1+ k))))
            (js-call r :frame_pop h caller)
            (clear r h (js-call (js-array state args) :concat keys))))
        (setq idx (1+ idx))))))

  (test "result boxing trap leaves its counter unconsumed and recovers after the documented caller unwind" (async ()
    (let* ((signature "(defun value-number (heap low high)")
           (modified (js-call source :replace signature (str signature " (when (and (= high 1072693248) (= (load-u32 20) 0)) (store-u32 20 1) (load-u32 4294967295))")))
           (artifact (Uint8Array/from (js-call (get b :wasm) :emit_memory_wasm
                                        (js-call (get b :compiler) :compile_ir_string modified "identity-result-trap.eli")
                                        (js-object :maximumPages 256))))
           (ctx (runtime 256 16384 1048576 artifact))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (value (pinned r h (js-call r :value_array_new h 0)))
           (caller (js-call r :frame_new h 1)))
      (js-call r :frame_set h caller 0 state)
      (js-call r :heap_auto h 1)
      (js-call assert :throws
        (lambda () (js-call r :value_host_identity_token h state value))
        globalThis.WebAssembly.RuntimeError)
      (js-call r :frame_unwind h caller)
      (js-call assert :equal (js-call r :frame_depth h) 1)
      (js-call assert :equal (token r h state value) 1)
      (js-call r :frame_pop h caller)
      (clear r h (js-array state value)))))

  (test "weak-cache load hysteresis amortizes cleanup with a permanently live three-quarter boundary and short-lived keys" (async ()
    (let* ((signature "(defun heap-host-identity-rebuild (heap state)")
           (modified (str (js-call source :replace signature (str signature " (store-u32 20 (1+ (load-u32 20)))"))
                          "\n(defun identity-rebuild-count () (load-u32 20)) (defun identity-rebuild-reset () (store-u32 20 0)) (export identity-rebuild-count identity-rebuild-reset)"))
           (artifact (Uint8Array/from (js-call (get b :wasm) :emit_memory_wasm
                                        (js-call (get b :compiler) :compile_ir_string modified "identity-hysteresis.eli")
                                        (js-object :maximumPages 256))))
           (ctx (runtime 512 32768 1048576 artifact))
           (r (get ctx :r))
           (h (get ctx :h))
           (state (pinned r h (js-call r :value_host_identity_state_new h)))
           (keys (js-array))
           (i 0))
      (js-call r :heap_auto h 1)
      (while (< i 95)
        (let ((key (pinned r h (js-call r :value_array_new h 0))))
          (js-call keys :push key)
          (js-call assert :equal (token r h state key) (+ i 1)))
        (setq i (1+ i)))
      (js-call r :heap_collect h)
      (js-call r :identity_rebuild_reset)
      (let ((j 0))
        (while (< j 32)
          (let ((key (js-call r :value_array_new h 0)))
            (js-call assert :equal (token r h state key) (+ 96 j))
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 99))
          (setq j (1+ j))))
      (funcall assert (<= (js-call r :identity_rebuild_count) 1)
        (str "one growth must provide linear headroom, rather than rebuilding each short-lived insertion: " (js-call r :identity_rebuild_count)))
      (let ((k 0))
        (while (< k (js-length keys))
          (js-call assert :equal (token r h state (aref keys k)) (+ k 1))
          (setq k (1+ k))))
      (clear r h (js-call (js-array state) :concat keys))))))
