(module tests.eliscript-protocol
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (import "node:path" dirname)
  (import "node:fs/promises" symlink)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst source (resolve ROOT "stdlib/core/protocol.eli"))
  (defconst committedImplementation (resolve ROOT "runtime/core/protocol-impl.mjs"))
  (defconst bun (get globalThis.process :execPath))
  (defconst node (get (get globalThis.process :env) :NODE_BINARY "node"))
  (defasync run (command environment)
    (await (runSuccessful command (copyHostRecord (js-object :BUN bun) (if (= environment undefined) (js-object) environment)))))
  (defasync compileProtocol (compiler output environment)
    (await (mkdir (dirname output) (js-object :recursive t)))
    (await (run (js-array compiler "--source-map" "--output" output source) environment)))
  (defasync execute (host modulePath)
    (JSON/parse (await (run (js-array host (resolve ROOT "tests/fixtures/eliscript-protocol-host.mjs") modulePath)))))
  (defun canonicalSourceMap (sourceMap) (copyHostRecord (JSON/parse sourceMap) (js-object :sources (js-array "<protocol-source>"))))
  (test "Eliscript-authored protocol policy preserves open dispatch semantics" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-protocol-")))) (bootstrapDirectory (resolve directory "bootstrap"))
           (seedRoot (resolve directory "seed")) (selfHostedRoot (resolve directory "self-hosted"))
           (seed (resolve seedRoot "stdlib/core/protocol-impl.mjs")) (selfHosted (resolve selfHostedRoot "stdlib/core/protocol-impl.mjs")))
      (try
        (await (Promise/all (js-array (mkdir seedRoot (js-object :recursive t)) (mkdir selfHostedRoot (js-object :recursive t)))))
        ;; Generated core modules resolve the public runtime package from any
        ;; scratch location, including the operating system's temporary root.
        (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
        (await (symlink ROOT (resolve directory "node_modules/eliscript") "dir"))
        (await (Promise/all (js-array (symlink (resolve ROOT "runtime") (resolve seedRoot "runtime") "dir") (symlink (resolve ROOT "runtime") (resolve selfHostedRoot "runtime") "dir"))))
        (await (compileProtocol COMPILER seed (js-object))) (await (seedCompilerFixture bootstrapDirectory))
        (await (compileProtocol (resolve ROOT "bin/eliscript-portable") selfHosted (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))
        (be (await (readFile selfHosted "utf8")) (await (readFile seed "utf8")))
        (be (await (readFile (str selfHosted ".map") "utf8")) (await (readFile (str seed ".map") "utf8")))
        (let ((generated (await (readFile seed "utf8"))) (committed (await (readFile committedImplementation "utf8"))))
          (be generated committed)
          (same (canonicalSourceMap (await (readFile (str seed ".map") "utf8"))) (canonicalSourceMap (await (readFile (str committedImplementation ".map") "utf8"))))
          (contains generated "function define_protocol(name, operations)")
          (contains generated "function define_protocol_from_definition(definition)")
          (contains generated "function protocol_definition(protocol)")
          (contains generated "const protocol_states = new (globalThis.WeakMap)()")
          (js-call (js-array "Runtime.defineProtocol" "Runtime.extendProtocol" "vite" "react") :forEach (lambda (text) (js-call (get (expect generated) :not) :toContain text))))
        (let ((facade (await (readFile (resolve ROOT "runtime/core/protocol.mjs") "utf8"))))
          (contains facade "from \"./protocol-impl.mjs\"") (contains facade "from \"./protocol-error.mjs\"")
          (js-call (get (expect facade) :not) :toContain "new WeakMap") (js-call (get (expect facade) :not) :toContain "function dispatch"))
        (let ((reports (await (Promise/all (js-array (execute bun seed) (execute node seed) (execute bun selfHosted) (execute node selfHosted) (execute bun committedImplementation) (execute node committedImplementation))))))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (aref reports 0) (js-object "frozen" (js-array t t t) "metadata" (js-array t "read" t) "definition" (js-object "value" (js-object "format" "eliscript-protocol-definition" "version" 1 "name" "Measured" "operations" (js-array "read" "size")) "frozen" (js-array t t) "restored" (js-object "format" "eliscript-protocol-definition" "version" 1 "name" "Measured" "operations" (js-array "read" "size")) "isolated" t "missingReason" "missing") "dispatch" (js-object "direct" (js-array "direct:alpha" 5 t) "exact" (js-array "exact:beta" 4 t) "category" (js-array "category:remote" 0) "fallback" (js-array "default:7" (- 1)) "undefined" (js-array "default:undefined" (- 1))) "categories" (js-array "null" "undefined" "number" "symbol" "function" "object") "invalidReason" "invalid-direct-slot" "childError" (js-object "code" "ELI-RUNTIME-PROTOCOL" "protocol" "Inheritance" "operation" "read" "observedType" "object:Child" "reason" "missing") "atomic" (js-object "message" "protocol Atomic/right implementation must be a function" "leftInstalled" false "accessorRead" false "accessorMessage" "protocol Atomic/left implementation must be a function") "arrays" (js-object "values" (js-array 1 3) "prototypePreserved" t) "million" 1000000)))
        (let ((sourceMap (JSON/parse (await (readFile (str seed ".map") "utf8")))))
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun external-method (state record receiver)")
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun dispatch (protocol record receiver arguments)"))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 90000)
)
