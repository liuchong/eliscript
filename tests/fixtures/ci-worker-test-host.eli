(module tests.fixtures.ci-worker-test-host
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs" readFileSync writeFileSync existsSync appendFileSync)
  (import "node:path" join)
  (import "node:url" fileURLToPath)
  ;; The scheduler tests copy this compiled fixture next to a data-only JSON
  ;; recipe for each file, instead of generating a JavaScript test algorithm.
  (defconst recipe (JSON/parse (readFileSync (str (fileURLToPath (js* "import.meta.url")) ".json") "utf8")))
  (defconst mode (get recipe :mode))
  (defconst index (get recipe :index))
  (defconst name (get recipe :name))
  (test (get recipe :title) (async ()
    (cond ((= mode "isolation")
      (js-call assert :equal (get (get process :env) :ELISCRIPT_FILE_WORKER_STATE) undefined)
      (put (get process :env) :ELISCRIPT_FILE_WORKER_STATE name)
      (writeFileSync (join (get (get process :env) :ELISCRIPT_FILE_WORKER_OUTPUT) name) "executed")
      (when (get recipe :fail) (js-call assert :fail "intentional isolated failure")))
      ((= mode "fresh")
        (let* ((dir (get (get process :env) :ELISCRIPT_FRESH_WORKERS)) (mate (bit-xor index 1)) (limit (+ (Date/now) 3000)))
          (writeFileSync (join dir (str "start-" index)) (JSON/stringify (js-object :pid (get process :pid) :start (Date/now))))
          (while (and (not (existsSync (join dir (str "start-" mate)))) (< (Date/now) limit))
            (await (new globalThis.Promise (lambda (accept) (globalThis.setTimeout accept 10)))))
          (assert (existsSync (join dir (str "start-" mate))) "both workers must start before either test finishes")
          (writeFileSync (join dir (str "end-" index)) (funcall globalThis.String (Date/now)))))
      ((= mode "cancel")
        (let ((dir (get (get process :env) (if (get recipe :shard) "ELISCRIPT_SHARD_CANCEL" "ELISCRIPT_CANCEL_WORKERS"))))
          (writeFileSync (join dir (str "pid-" index)) (funcall globalThis.String (get process :pid)))
          (await (new globalThis.Promise (lambda (accept) (globalThis.setTimeout accept 4000))))))
      ((= mode "shard")
        (appendFileSync (get (get process :env) :ELISCRIPT_SHARD_OUTPUT)
          (str (JSON/stringify (js-object :run (get (get process :env) :ELISCRIPT_SHARD_RUN) :index index)) "\n"))
        (when (= index 0) (js-call assert :fail "intentional shard failure")))
      (t (throw (new globalThis.Error (str "unknown scheduler fixture mode: " mode))))))))
