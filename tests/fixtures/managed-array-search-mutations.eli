(defconst marker 1)
(defun f (method mode needle)
  (let* ((items (js-array 1 2 3)) (trace (js-object :calls 0))
         (from (js-object :valueOf (lambda ()
           (put trace :calls (1+ (get trace :calls)))
           (cond ((= mode 0) (put items :length 1))
                 ((= mode 1) (js-call items :push needle)) (t (put items 1 needle))) 0))))
    (let ((out (cond ((= method 0) (js-call items :includes needle from))
                    ((= method 1) (js-call items :indexOf needle from))
                    (t (js-call items :lastIndexOf needle (js-object :valueOf (lambda ()
                      (put trace :calls (1+ (get trace :calls)))
                      (cond ((= mode 0) (put items :length 1))
                            ((= mode 1) (js-call items :push needle)) (t (put items 1 needle))) 9)))))))
      (js-array out (js-length items) (get trace :calls)))))
(export f)
