(module managed.array-text
  (defconst marker 1)
  (defun join-value (values separator) (js-call values :join separator))
  (defun default-value (values) (js-call values :join))
  (defun text-value (value) (js-call value :toString))
  (defun extra-value (values separator trace) (js-call values :join separator (put trace :extra 7)))
  (defun custom-value (trace value)
    (js-object :toString (lambda () (put trace :calls (1+ (get trace :calls 0))) value)))
  (defun fallback-value (trace value)
    (js-object :toString (lambda () (put trace :to 1) (js-object))
      :valueOf (lambda () (put trace :value 2) value)))
  (defun growing-separator (values trace)
    (js-object :toString (lambda () (put trace :separator 1) (js-call values :push "late") "|")))
  (defun live-element (values)
    (js-object :toString (lambda () (put values 1 "changed") "first")))
  (defun shrinking-element (values)
    (js-object :toString (lambda () (put values :length 0) "first")))
  (defun text-order (values value trace)
    (js-call values :toString
      (progn (put trace :argument 1) (put values :join (lambda () (put trace :body 2) value)))))
  (defun own-join (values value) (put values :join (lambda () value)) values)
  (defun reentrant-element (values trace)
    (js-object :toString (lambda () (put trace :nested (js-call values :join "|")) "element")))
  (export join-value default-value text-value extra-value custom-value fallback-value
    growing-separator live-element shrinking-element text-order own-join reentrant-element))
