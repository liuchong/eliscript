(module tests.fixtures.compiler-function-source-host
  (import "node:fs/promises" mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "../helpers/managed-browser-transport.mjs" writeManagedReference)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defasync run-host-main ()
    (let* ((stream (get globalThis.process :stdin))
         (iterator (Reflect/apply (get stream (get globalThis.Symbol :asyncIterator)) stream (js-array)))
         (source "") (done false))
    (while (not done)
      (let ((step (await (js-call iterator :next))))
        (setq done (get step :done))
        (unless done (setq source (str source (funcall globalThis.String (get step :value)))))))
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-function-source-")))))
      (try
        (let ((m (await (funcall load-module (get (pathToFileURL
                   (await (writeManagedReference directory source "function-source"))) :href)))))
          (js-call (get globalThis.process :stdout) :write
            (JSON/stringify (js-array (js-call (get m :outer) :toString) (js-call (js-call m :outer 3) :toString)))))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
