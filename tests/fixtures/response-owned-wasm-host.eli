(module tests.fixtures.response-owned-wasm-host
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve dirname)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (import "../../tools/backends/compiler-session.mjs" createCompilerSession encodeCompilerIR requestCompilerBuildProduct)
  (import "../../tools/backends/compiler-build.mjs" buildIndependentCompiler decodeCompilerBinary compilerMetadataDigest writeCompilerMetadata)
  (import "../../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../../tools/backends/compiler-bootstrap.mjs" openCompilerArtifact)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../helpers/response-product-contract.mjs" producerGraph assertCompleteProductFiles assertCompleteProductBytes)
  (defconst load (js* "(specifier) => import(specifier)"))
  (defvar phaseCount 0)
  (defvar stage undefined)
  (defun phaseMemory (phase &rest __host_forwarded_arguments_1)
    (let* ((byteLength (aref __host_forwarded_arguments_1 0)))
    (when (nullish? byteLength) (setq byteLength 0))
    (let ((before phaseCount)) (setq phaseCount (+ phaseCount 1))
      (when (< before 12)
        (let ((usage (js-call process :memoryUsage)))
          (js-call globalThis.console :error (JSON/stringify (js-object :phase (str "owned-wasm-" phase) :stage stage :byteLength byteLength :rss (get usage :rss) :heapUsed (get usage :heapUsed) :heapTotal (get usage :heapTotal)))))))))
  (defasync main ()
    (let* ((args (get process :argv)) (metadataPath (aref args 2)) (referencePath (aref args 4))
      (reference (JSON/parse (await (readFile referencePath "utf8"))))
      (directory (dirname metadataPath)) (publicDebugPath (resolve directory "owned-debug-public-writer.json")))
      (setq stage (aref args 3)) (phaseMemory "start")
      (if (= stage "debug")
        (progn
          (await (funcall (async ()
            (phaseMemory "debug-read-start")
            (let ((savedDebug (await (readCompilerMetadata (get reference :debugPath)))))
              (js-call assert :equal (compilerMetadataDigest savedDebug) (get reference :debugDigest) "the entire saved debug value remains exact")
              (js-call assert :equal (get savedDebug :moduleByteLength) (get reference :byteLength))
              (phaseMemory "debug-digest-complete" (get savedDebug :moduleByteLength))
              (await (writeCompilerMetadata publicDebugPath savedDebug)) (phaseMemory "public-debug-write-complete")))))
          (phaseMemory "debug-record-scope-ended")
          (let ((debugByteLength (await (assertCompleteProductFiles (get reference :debugPath) publicDebugPath t)))) (phaseMemory "debug-files-comparison-complete" debugByteLength))
          (js-call (get process :stdout) :write (str (JSON/stringify (js-object :host "wasm" :complete t)) "\n")))
        (let* ((metadata (await (readCompilerMetadata metadataPath)))
          (artifact (Object/assign (js-object) metadata (js-object :directory directory :metadataPath metadataPath :path (resolve directory (get metadata :path)) :runtimePath (resolve directory (get metadata :runtimePath)))))
          (graph (await (producerGraph artifact))) (actual undefined) (wire undefined) (producer undefined) (phaseResult undefined))
          (put (aref (get graph :modules) 0) :filename (str (js-call "a" :repeat 16382) "😀\ud800x\udc00.eli"))
          (setq actual (await (funcall load (get (pathToFileURL (get artifact :path)) :href))))
          (js-call assert :equal (funcall (js* "(value) => typeof value") (get actual :compiler_session_project_owned)) "function")
          (setq wire (lambda (&rest args) (Reflect/apply (get actual :compiler_session_request) actual args)))
          (js-call assert :equal (js-call actual :compiler_session_project_owned wire nil "") nil "wrapped wire identity opts out before inspecting state or JSON")
          (setq producer (await (openCompilerArtifact artifact)))
          (try
            (await (js-call producer :request (js-object :operation "runtime" :literalSources (js-array)))) (phaseMemory "runtime-ready")
            (let* ((memory (js-object :initialPages 128 :maximumPages 4096))
              (request (js-object :operation "project" :target "wasm" :modules (get graph :modules) :entry (get graph :entry) :memory memory
                :nativeTarget (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos") :nativeFormat "library" :binaryEncoding "u16le-chunks" :debug t))
              (compareSnapshots (async ()
                (let* ((owned (requestCompilerBuildProduct producer request)) (trap (js-call (get (get owned :debug) :ranges) :find (lambda (range) (= (get range :kind) "trap-site")))))
                  (js-call assert :equal (get owned :target) "wasm") (js-call assert :equal (get owned :typed) undefined) (assert trap)
                  (assert (js-call (get (get owned :debug) :ranges) :some (lambda (range) (and (= (get range :emission) "expression") (= (get range :span) (get trap :span))))) "the real artifact adapter forwards the fresh debug graph rather than a JSON copy")
                  (let* ((normal (await (js-call producer :request request)))
                    (cachedRequest (js-object :operation "cached-ir" :kind "module" :id (get graph :entry) :revision (get normal :revision)))
                    (before undefined))
                    (js-call assert :deepEqual (decodeCompilerBinary (get owned :bytes)) (decodeCompilerBinary (get normal :bytes)))
                    (js-call assert :deepEqual (get owned :debug) (get normal :debug)) (js-call assert :deepEqual (get owned :descriptor) (get normal :descriptor))
                    (setq before (await (js-call producer :request cachedRequest)))
                    (put (get normal :descriptor) :publicSnapshotMutation t)
                    (let ((range (js-call (get (get normal :debug) :ranges) :find (lambda (range) (get range :span))))) (assert range) (put (get range :span) :publicSnapshotMutation t))
                    (js-call assert :equal (get (get owned :descriptor) :publicSnapshotMutation) undefined)
                    (assert (js-call (get (get owned :debug) :ranges) :every (lambda (range) (or (nullish? (get range :span)) (= (get (get range :span) :publicSnapshotMutation) undefined)))))
                    (js-call assert :deepEqual (await (js-call producer :request cachedRequest)) before)
                    (js-object :bytes (decodeCompilerBinary (get owned :bytes)) :descriptor (get owned :descriptor) :debugDigest (compilerMetadataDigest (get owned :debug))))))))
              (if (= stage "snapshot")
                (progn
                  (phaseMemory "snapshot-comparison-start")
                  (let ((expected (await (funcall compareSnapshots))))
                    (phaseMemory "snapshot-comparison-complete" (get (get expected :bytes) :byteLength))
                    (await (writeFile publicDebugPath (get expected :bytes)))
                    (setq phaseResult (js-object :host "wasm" :complete t :byteLength (get (get expected :bytes) :byteLength) :descriptor (get expected :descriptor) :debugDigest (get expected :debugDigest)))))
                (progn
                  (js-call assert :equal stage "build") (phaseMemory "build-start")
                  (let ((built (await (buildIndependentCompiler (js-object :host "wasm" :sources graph :session producer :debug t :outputRoot (resolve directory "owned-debug-wasm-product"))))))
                    (phaseMemory "build-complete" (get (get built :bytes) :byteLength))
                    (js-call assert :equal (get (get built :provenance) :mode) "session") (js-call assert :equal (get (get built :provenance) :producerHost) "javascript")
                    (js-call assert :equal (get (get built :bytes) :byteLength) (get reference :byteLength)) (js-call assert :deepEqual (get built :descriptor) (get reference :descriptor))
                    (await (assertCompleteProductBytes (get built :path) (get built :bytes))) (await (assertCompleteProductFiles (get built :path) publicDebugPath))
                    (phaseMemory "binary-files-comparison-complete" (get (get built :bytes) :byteLength))
                    (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module (get built :bytes))) (js-array))
                    (phaseMemory "execution-start")
                    (let* ((runtime (instantiateManagedRuntime (get built :bytes) (get built :budget))) (input undefined) (result undefined))
                      (js-call runtime :auto (get built :auto)) (setq input (js-call runtime :number 41))
                      (try (setq result (js-call runtime :invoke "answer" (js-array input))) (js-call assert :equal (js-call runtime :readNumber result) 42)
                        (finally (unless (= result undefined) (js-call runtime :release result)) (js-call runtime :release input)
                          (js-call runtime :closeModule) (js-call runtime :collect) (js-call assert :equal (js-call runtime :live) 0) (js-call assert :equal (get (js-call runtime :stats) :frameDepth) 0))))
                    (phaseMemory "execution-complete")
                    (let* ((wrappedCalls 0)
                      (wrapped (await (createCompilerSession (js-object :host "javascript" :compiler (Object/assign (js-object) actual (js-object :compiler_session_request (lambda (&rest args)
                        (setq wrappedCalls (+ wrappedCalls 1)) (Reflect/apply (get actual :compiler_session_request) actual args))))))))
                      (invalid (Object/assign (js-object) request (js-object :modules (js-array (Object/assign (js-object) (aref (get graph :modules) 0) (js-object :source "(defun broken (")))))))
                      (try
                        (let ((original undefined) (before undefined))
                          (try (js-call wrapped :request invalid) (catch error (setq original error))) (assert original) (setq before wrappedCalls)
                          (js-call assert :throws (lambda () (requestCompilerBuildProduct wrapped invalid)) (lambda (error)
                            (js-call assert :equal (get error :message) (get original :message)) (js-call assert :deepEqual (get error :eliscriptDiagnostic) (get original :eliscriptDiagnostic)) t))
                          (js-call assert :equal wrappedCalls (+ before 1) "a wrapped real wire still observes the project failure")
                          (js-call assert :equal (get (js-call wrapped :request (js-object :operation "capabilities")) :format) "eliscript-compiler-capabilities"))
                        (finally (js-call wrapped :close))))
(phaseMemory "wrapped-failure-recovery-complete")
(js-call assert :equal (get (await (js-call producer :request (js-object :operation "capabilities"))) :format) "eliscript-compiler-capabilities")
(setq phaseResult (js-object :host "wasm" :complete t :debugPath (get built :debugPath) :byteLength (get (get built :bytes) :byteLength)))))))
            (finally (await (js-call producer :close))))
          (js-call assert :equal (get producer :closed) t)
          (js-call assert :throws (lambda () (requestCompilerBuildProduct producer (js-object :operation "project" :target "wasm"))) (new globalThis.RegExp "closed"))
          (phaseMemory "closed") (js-call (get process :stdout) :write (str (encodeCompilerIR phaseResult) "\n"))))))
  (main))
