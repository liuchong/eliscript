(module tests.fixtures.persistent-core-exit-host
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../helpers/portable-structure.mjs" nodeCount sharedNodeCount countItems sharedItems lookupPathLength)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-type (js* "(value) => typeof value"))
  (defconst moduleDirectory (aref (get globalThis.process :argv) 2))
  (defconst collection (aref (get globalThis.process :argv) 3))
  (defconst valueCount 1000000)
  (defconst probeIndexes (js-array 0 31 32 1024 32768 500000 999999))
  (when (or (nullish? moduleDirectory) (nullish? collection)) (throw (new globalThis.Error "expected MODULE_DIRECTORY and COLLECTION")))
  (defun moduleUrl (name) (get (pathToFileURL (resolve moduleDirectory (str name ".mjs"))) :href))
  (defasync auditVector ()
    (let* ((module (await (funcall load-module (moduleUrl "persistent-vector")))) (vector (js-call module :empty_persistent_vector)) (value 0))
      (while (< value valueCount) (setq vector (js-call module :persistent_vector_conj vector value) value (1+ value)))
      (let* ((updated (js-call module :persistent_vector_assoc vector 500000 -1)) (nodes (nodeCount (get vector :root) (get vector :shift)))
             (changedPath (+ 1 (/ (get vector :shift) 5))))
        (js-object :collection collection :count (js-call module :persistent_vector_count vector) :shift (get vector :shift) :tailLength (js-length (get vector :tail))
          :probes (js-call probeIndexes :map (lambda (index) (js-call module :persistent_vector_nth vector index "missing")))
          :original (js-call module :persistent_vector_nth vector 500000 "missing") :updated (js-call module :persistent_vector_nth updated 500000 "missing")
          :nodeCount nodes :changedPath changedPath :sharedNodes (sharedNodeCount (get vector :root) (get updated :root) (get vector :shift))))))
  (defasync auditMap ()
    (let* ((module (await (funcall load-module (moduleUrl "persistent-map")))) (equal (lambda (left right) (= left right)))
           (map (js-call module :empty_persistent_map (lambda (value) value) equal equal)) (key 0))
      (while (< key valueCount) (setq map (js-call module :persistent_map_assoc map key key) key (1+ key)))
      (let* ((updated (js-call module :persistent_map_assoc map 500000 -1)) (removed (js-call module :persistent_map_dissoc updated 750000))
             (itemCount (countItems (get map :root))) (changedPath (lookupPathLength (get map :root) 500000)))
        (js-object :collection collection :count (js-call module :persistent_map_count map) :rootKind (get (get map :root) :kind)
          :probes (js-call probeIndexes :map (lambda (key) (js-call module :persistent_map_get map key "missing")))
          :original (js-call module :persistent_map_get map 500000 "missing") :updated (js-call module :persistent_map_get updated 500000 "missing")
          :removedCount (js-call module :persistent_map_count removed) :removed (js-call module :persistent_map_get removed 750000 "missing")
          :originalRetained (js-call module :persistent_map_get map 750000 "missing") :itemCount itemCount :changedPath changedPath :sharedItems (sharedItems (get map :root) (get updated :root))))))
  (defasync auditSet ()
    (let* ((module (await (funcall load-module (moduleUrl "persistent-set")))) (hash (lambda (value) (if (= (funcall host-type value) "number") value (get value :id))))
           (equal (lambda (left right) (= left right))) (set (js-call module :empty_persistent_set hash equal)) (value 0))
      (while (< value valueCount) (setq set (js-call module :persistent_set_conj set value) value (1+ value)))
      (let* ((colliding (js-object :id 500000)) (added (js-call module :persistent_set_conj set colliding)) (removed (js-call module :persistent_set_disj added colliding))
             (itemCount (countItems (get (get set :map) :root))) (changedPath (lookupPathLength (get (get set :map) :root) 500000)))
        (js-object :collection collection :count (js-call module :persistent_set_count set) :rootKind (get (get (get set :map) :root) :kind)
          :probes (js-call probeIndexes :map (lambda (value) (js-call module :persistent_set_has_QMARK_ set value)))
          :noopConj (= (js-call module :persistent_set_conj set 500000) set) :addedCount (js-call module :persistent_set_count added)
          :originalCollisionAbsent (not (js-call module :persistent_set_has_QMARK_ set colliding)) :collisionPresent (js-call module :persistent_set_has_QMARK_ added colliding)
          :removedCount (js-call module :persistent_set_count removed) :collisionRemoved (not (js-call module :persistent_set_has_QMARK_ removed colliding))
          :originalRetained (js-call module :persistent_set_has_QMARK_ set 500000) :itemCount itemCount :changedPath changedPath
          :sharedItems (sharedItems (get (get set :map) :root) (get (get added :map) :root))))))
  (defconst audits (js-object :vector auditVector :map auditMap :set auditSet))
  (defconst audit (get audits collection))
  (when (nullish? audit) (throw (new globalThis.Error (str "unknown collection: " collection))))
  (defasync run-host-main ()
    (js-call (get globalThis.process :stdout) :write (str (JSON/stringify (await (funcall audit))) "\n")))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
