(module tests.fixtures.declarative-protocol-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar declarations undefined)
  (defvar box undefined)
  (defvar host-type undefined)
  (defasync run-host-main ()
    (setq declarations (await (funcall load-module (get (pathToFileURL (aref (get globalThis.process :argv) 2)) :href))))
    (setq box (new declarations.Box 7))
    (setq host-type (js* "(value) => typeof value"))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :identity (js-object :protocol (= (get (get declarations :describe) :protocol) (get declarations :IDescribe))
      :operation (get (get declarations :describe) :operation) :slot (funcall host-type (get (get declarations :describe) :slot))
      :operations (Object/keys (get (get declarations :IDescribe) :operations)))
    :type (js-object :description (js-call declarations :describe box) :measurement (js-call declarations :measure box 3))
    :category (js-object :description (js-call declarations :describe 5) :measurement (js-call declarations :measure 5 4))
    :fallback (js-object :description (js-call declarations :describe "text") :measurement (js-call declarations :measure "text" 8))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
