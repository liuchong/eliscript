(module tests.fixtures.eliscript-protocol-host
  (import "node:vm" runInNewContext)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar p undefined)
  (defvar defineProtocol undefined)
  (defvar defineProtocolFromDefinition undefined)
  (defvar extendProtocolCategory undefined)
  (defvar extendProtocolDefault undefined)
  (defvar extendProtocolType undefined)
  (defvar implementsProtocolOperation undefined)
  (defvar implementsProtocol undefined)
  (defvar protocolDefinition undefined)
  (defvar protocolHostCategory undefined)
  (defvar protocolMethod undefined)
  (defvar protocolSlot undefined)
  (defvar protocol undefined)
  (defvar read undefined)
  (defvar size undefined)
  (defvar readSlot undefined)
  (defvar sizeSlot undefined)
  (defvar class-exact undefined)
  (defvar Exact undefined)
  (defvar class-child undefined)
  (defvar Child undefined)
  (defvar class-direct undefined)
  (defvar Direct undefined)
  (defvar remoteObject undefined)
  (defvar direct undefined)
  (defvar exact undefined)
  (defvar definition undefined)
  (defvar restored undefined)
  (defvar restoredRead undefined)
  (defvar restoredReason undefined)
  (defvar invalid undefined)
  (defvar invalidReason undefined)
  (defvar atomic undefined)
  (defvar atomicMessage undefined)
  (defvar accessor undefined)
  (defvar accessorRead undefined)
  (defvar accessorMessage undefined)
  (defvar arrayPrototypeKeys undefined)
  (defvar inheritance undefined)
  (defvar inheritanceRead undefined)
  (defvar childError undefined)
  (defvar million undefined)
  (defvar increment undefined)
  (defvar incrementSlot undefined)
  (defvar method-holder undefined)
  (defvar counter undefined)
  (defvar value undefined)
  (defasync run-host-main ()
    (setq p (await (funcall load-module (get (pathToFileURL (resolve (aref (get globalThis.process :argv) 2))) :href))))
    (setq defineProtocol p.define_protocol)
    (setq defineProtocolFromDefinition p.define_protocol_from_definition)
    (setq extendProtocolCategory p.extend_protocol_category)
    (setq extendProtocolDefault p.extend_protocol_default)
    (setq extendProtocolType p.extend_protocol_type)
    (setq implementsProtocolOperation p.implements_protocol_operation_QMARK_)
    (setq implementsProtocol p.implements_protocol_QMARK_)
    (setq protocolDefinition p.protocol_definition)
    (setq protocolHostCategory p.protocol_host_category)
    (setq protocolMethod p.protocol_method)
    (setq protocolSlot p.protocol_slot)
    (setq protocol (defineProtocol "Measured" (js-array "read" "size")))
    (setq read (protocolMethod protocol "read"))
    (setq size (protocolMethod protocol "size"))
    (setq readSlot (protocolSlot protocol "read"))
    (setq sizeSlot (protocolSlot protocol "size"))
    (setq class-exact (js* "(initialize) => class Exact { constructor(value) { initialize(this, value); } }"))
    (setq Exact (funcall class-exact (lambda (self value) (put self :value value))))
    (setq class-child (js* "(Base) => class Child extends Base {}"))
    (setq Child (funcall class-child Exact))
    (setq class-direct (js* "(Base, readSlot, sizeSlot, read, size) => class Direct extends Base { [readSlot]() { return read(this); } [sizeSlot]() { return size(this); } }"))
    (setq Direct (funcall class-direct Exact readSlot sizeSlot (lambda (self) (str "direct:" (get self :value))) (lambda (self) (get (get self :value) :length))))
    (extendProtocolDefault protocol (js-object :read (lambda (value) (str "default:" (funcall globalThis.String value))) :size (lambda () -1)))
    (extendProtocolCategory protocol "object" (js-object :read (lambda (value) (str "category:" (get value :value))) :size (lambda () 0)))
    (extendProtocolType protocol Exact (js-object :read (lambda (value) (str "exact:" (get value :value))) :size (lambda (value) (get (get value :value) :length))))
    (setq remoteObject (runInNewContext "({ value: 'remote' })"))
    (setq direct (new Direct "alpha"))
    (setq exact (new Exact "beta"))
    (setq definition (protocolDefinition protocol))
    (setq restored (defineProtocolFromDefinition (JSON/parse (JSON/stringify definition))))
    (setq restoredRead (protocolMethod restored "read"))
    (setq restoredReason undefined)
    (try (restoredRead "unextended") (catch error (setq restoredReason (get error :reason))))
    (setq invalid (new Exact "invalid"))
    (Object/defineProperty invalid readSlot (js-object :value 42))
    (setq invalidReason undefined)
    (try (read invalid) (catch error (setq invalidReason (get error :reason))))
    (setq atomic (defineProtocol "Atomic" (js-array "left" "right")))
    (setq atomicMessage undefined)
    (try (extendProtocolType atomic Exact (js-object :left (lambda () "left") :right 42)) (catch error (setq atomicMessage (get error :message))))
    (setq accessor (js-object))
    (setq accessorRead false)
    (Object/defineProperty accessor "left" (js-object :get (lambda () (setq accessorRead t) (lambda () "left"))))
    (setq accessorMessage undefined)
    (try (extendProtocolDefault atomic accessor) (catch error (setq accessorMessage (get error :message))))
    (setq arrayPrototypeKeys (Reflect/ownKeys globalThis.Array.prototype))
    (extendProtocolType atomic globalThis.Array (js-object :left (lambda (value) (aref value 0)) :right (lambda (value) (js-call value :at -1))))
    (setq inheritance (defineProtocol "Inheritance" (js-array "read")))
    (setq inheritanceRead (protocolMethod inheritance "read"))
    (extendProtocolType inheritance Exact (js-object :read (lambda (value) (get value :value))))
    (setq childError undefined)
    (try (inheritanceRead (new Child "child")) (catch error (setq childError (js-object :code (get error :code) :protocol (get error :protocol)
    :operation (get error :operation) :observedType (get error :observedType) :reason (get error :reason)))))
    (setq million (defineProtocol "Million" (js-array "increment")))
    (setq increment (protocolMethod million "increment"))
    (setq incrementSlot (protocolSlot million "increment"))
    (setq method-holder (js* "(slot, implementation) => ({ [slot](value) { return implementation(value); } })"))
    (setq counter (funcall method-holder incrementSlot (lambda (value) (+ value 1))))
    (setq value 0)
    (let ((index 0)) (while (< index 1000000) (setq value (increment counter value) index (1+ index))))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :frozen (js-array (Object/isFrozen protocol) (Object/isFrozen (get protocol :operations)) (Object/isFrozen read))
    :metadata (js-array (= (get read :protocol) protocol) (get read :operation) (= (get read :slot) readSlot))
    :definition (js-object :value definition :frozen (js-array (Object/isFrozen definition) (Object/isFrozen (get definition :operations)))
      :restored (protocolDefinition restored) :isolated (not (= (protocolSlot restored "read") readSlot)) :missingReason restoredReason)
    :dispatch (js-object :direct (js-array (read direct) (size direct) (implementsProtocol protocol direct)) :exact (js-array (read exact) (size exact) (implementsProtocol protocol exact))
      :category (js-array (read remoteObject) (size remoteObject)) :fallback (js-array (read 7) (size 7)) :undefined (js-array (read undefined) (size undefined)))
    :categories (js-array (protocolHostCategory nil) (protocolHostCategory undefined) (protocolHostCategory 7)
      (protocolHostCategory (funcall globalThis.Symbol "value")) (protocolHostCategory (js* "() => 1")) (protocolHostCategory (js-object)))
    :invalidReason invalidReason :childError childError :atomic (js-object :message atomicMessage :leftInstalled (implementsProtocolOperation atomic "left" (new Exact "x"))
      :accessorRead accessorRead :accessorMessage accessorMessage)
    :arrays (js-object :values (js-array (funcall (protocolMethod atomic "left") (js-array 1 2 3)) (funcall (protocolMethod atomic "right") (js-array 1 2 3)))
      :prototypePreserved (let ((current (Reflect/ownKeys globalThis.Array.prototype))) (and (= (js-length current) (js-length arrayPrototypeKeys))
        (js-call current :every (lambda (key index) (= key (aref arrayPrototypeKeys index))))))) :million value))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
