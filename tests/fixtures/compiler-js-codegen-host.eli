(module tests.fixtures.compiler-js-codegen-host
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar generated undefined)
  (defvar results undefined)
  (defvar values undefined)
  (defvar truth undefined)
  (defasync run-host-main ()
    (setq generated (await (funcall load-module (aref (get globalThis.process :argv) 2))))
    (setq results (js-array (js-call generated :scope) (js-call generated :captures) (js-call generated :statements)
    (js-call generated :while_value) (js-call generated :value_context) (js-call generated :boolean_order)
    (await (js-call generated :async_run)) (js-call generated :cleanup) (Array/from (get generated :events))))
    (setq values (js-array nil false undefined 0 (js* "-0") "" globalThis.NaN globalThis.Infinity (js-array) (js-object)))
    (setq truth (js-call values :map (lambda (value)
    (let ((expected (and (not (= value false)) (not (nullish? value)))))
      (when (or (not (= (js-call generated :choose value) (funcall globalThis.Number expected)))
                (not (= (js-call generated :negate value) (not expected)))
                (not (Object/is (js-call generated :value_and value) (if expected "end" value)))
                (not (Object/is (js-call generated :value_or value) (if expected value "end"))))
        (throw (new globalThis.Error "truth/value parity")))
      (js-call generated :choose value)))))
    (console/log (JSON/stringify (js-object :results results :truth truth))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
