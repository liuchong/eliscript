(module managed.catch-bindings
  (defconst marker 1)
  (defun array (value)
    (try (throw value)
      (catch [first nil third &rest tail] (js-array first third tail))))
  (defun object (value)
    (try (throw value)
      (catch {:strs [left right] :or {left 7 right 8} :as original}
        (js-array left right (Object/is value original)))))
  (defun keys (value) (try (throw value) (catch {:keys [tag]} tag)))
  (defun captured (value)
    (let ((f false) (x 99))
      (try (throw value)
        (catch {:strs [f x] :or {f (lambda () x) x 7}} (funcall f)))))
  (defun invalid (value)
    (try (try (throw value) (catch [item] item))
      (catch error (aref error "name"))))
  (defun tdz (value)
    (let ((x 99))
      (try (try (throw value) (catch {:strs [x] :or {x x}} x))
        (catch error (aref error "name")))))
  (defun protocol ()
    (try (try (throw (js-object :__proto__ nil :tag 7)) (catch {:strs [tag]} tag))
      (catch error (js-array (aref error "name") (aref error "code") (aref error "observedType") (Object/keys error)))))
  (export array object keys captured invalid tdz protocol))
