(module managed.json-callbacks
  (defconst events (js-array))
  (defconst contexts (js-array))
  (defconst state (js-object :mode 0 :distinct t))
  (defun reset (mode)
    (put events :length 0) (put contexts :length 0)
    (put state :mode mode) (put state :distinct t) (put state :phase 0))
  (defun data-descriptor (object key)
    (let ((value (Object/getOwnPropertyDescriptor object key)))
      (if (Object/is value undefined) (js-array false)
        (js-array t (get value :writable) (get value :enumerable) (get value :configurable)))))
  (defun inner-revive (key value context)
    (js-call events :push (js-array "inner reviver" key
      (if (Object/is context undefined) false (object-has? context "source")))) value)
  (defun inner-replace (key value)
    (js-call events :push (js-array "inner replacer" key)) value)
  (defun revive (key value context)
    (let* ((holder (js* "this")) (type (js* "typeof value"))
           (has-source (and (not (Object/is context undefined)) (object-has? context "source")))
           (position 0))
      (if has-source
        (progn
          (while (< position (get contexts :length))
            (if (Object/is context (get contexts position)) (put state :distinct false))
            (setq position (1+ position)))
          (js-call contexts :push context)))
      (js-call events :push (js-array "reviver" key type
        (Object/is value -0.0) (Object/is (get holder key) value)
        (object-has? holder key) has-source
        (if has-source (get context :source) nil)
        (if has-source (data-descriptor context "source") nil)))
      (cond
        ((and (= (get state :mode) 1) (= key "a"))
          (put holder :b 9) (put holder :added 77) (Reflect/deleteProperty holder "gone"))
        ((and (= (get state :mode) 1) (= key "0"))
          (Reflect/deleteProperty holder "2") (put holder 3 8))
        ((and (= (get state :mode) 2) (= key "a"))
          (Object/defineProperty holder "locked" (js-object :value 3 :enumerable t :writable false :configurable false)))
        ((and (= (get state :mode) 6) (= key "a"))
          (JSON/parse "2" inner-revive) (JSON/stringify (js-object :nested 3) inner-replace)))
      (cond ((= (get state :mode) 4) (throw false))
        ((= (get state :mode) 5) (throw undefined))
        ((and (= (get state :mode) 2) (= key "locked")) undefined)
        ((and (= (get state :mode) 3) (= key "")) undefined)
        ((and (= (get state :mode) 7) (= key "")) false)
        (t value))))
  (defun parse-probe (text mode)
    (reset mode)
    (let ((value (JSON/parse text revive)))
      (JSON/stringify (js-array (Object/is value undefined) value events (get state :distinct)))))
  (defun to-json (key)
    (let ((receiver (js* "this")))
      (js-call events :push (js-array "toJSON" key (get receiver :tag)))
      (js-object :value (get receiver :value) :drop 5 :zero -0.0)))
  (defun replace (key value)
    (let ((holder (js* "this")))
      (put state :phase 20)
      (js-call events :push (js-array "replacer" key (js* "typeof value")
        (Object/is (get holder key) value) (JSON/isRawJSON value)))
      (put state :phase 21)
      (cond ((= (get state :mode) 8) (throw false))
        ((= (get state :mode) 9) (throw undefined))
        ((and (= key "") (= (get state :mode) 2)) undefined)
        ((= key "drop") undefined)
        ((and (= key "self") (= (get state :mode) 6)) undefined)
        ((and (= key "number") (= (get state :mode) 1)) (new globalThis/Number 9))
        ((and (= key "string") (= (get state :mode) 1)) (new globalThis/String "中😀"))
        ((and (= key "boolean") (= (get state :mode) 1)) (new globalThis/Boolean false))
        ((and (= key "big") (= (get state :mode) 3)) (JSON/rawJSON "9007199254740993"))
        (t value))))
  (defun stringify-probe (mode)
    (reset mode)
    (let* ((child (js-object :tag "child" :value 7 :toJSON to-json))
           (items (new globalThis/Array 4))
           (value (js-object :item child :array items
             :number 1 :string "old" :boolean t :drop 0))
           (gap (if (= mode 1) (new globalThis/Number 2) "😀abcdefghi")))
      (put value "2" 2) (put value "1" 1)
      (if (= mode 1) (put gap :valueOf (lambda () (js-call events :push "space valueOf") 2)))
      (put items 0 child) (put items 2 undefined) (put items 3 (lambda () 1))
      (Object/defineProperty value "snap" (js-object :enumerable t :get (lambda ()
        (js-call events :push "snap getter") (put value :late 99)
        (Reflect/deleteProperty value "later") 3)))
      (put value :later 4)
      (if (or (= mode 3) (= mode 4)) (put value :big (js* "7n")))
      (if (or (= mode 6) (= mode 7)) (put value :self value))
      (put state :phase 10)
      (let ((output (JSON/stringify value replace gap)))
        (put state :phase 11)
        (JSON/stringify (js-array (Object/is output undefined) output events (Object/keys value))))))
  (defun property-list-probe ()
    (reset 0)
    (let* ((inherited (js-object :inherited 6)) (value (Object/create inherited))
           (keys (js-array "inherited" (new globalThis/String "b") (new globalThis/Number 2)
             "b" t nil (funcall globalThis/Symbol "ignored")))
           (gap (new globalThis/String "123456789😀")))
      (put value :b 7) (put value "2" 8) (put value :excluded 9)
      (JSON/stringify (js-array (JSON/stringify value keys gap) (Object/keys value)))))
  (defun raw-to-json (key)
    (js-call events :push (js-array "raw toJSON" key)) (JSON/rawJSON "1.2300e+02"))
  (defun raw-replace (key value)
    (put state :phase 40)
    (js-call events :push (js-array "raw replacer" key (JSON/isRawJSON value))) value)
  (defun raw-probe (text mode)
    (reset 0)
    (put state :phase 30)
    (let* ((input (if (= mode 1) (js-object :toString (lambda ()
                      (js-call events :push "ToString") text)) text))
           (raw (JSON/rawJSON input)) (fake (js-object :rawJSON text))
           (copy (Object/assign (Object/create nil) raw)) (inherited (Object/create raw))
           (value (js-object :raw raw :also raw :hook (js-object :toJSON raw-to-json))))
      (JSON/stringify (js-array (get raw :rawJSON) (Object/is (Object/getPrototypeOf raw) nil)
        (Object/isFrozen raw) (Object/getOwnPropertyNames raw) (data-descriptor raw "rawJSON")
        (JSON/isRawJSON raw) (JSON/isRawJSON fake) (JSON/isRawJSON (Object/freeze fake))
        (JSON/isRawJSON copy) (JSON/isRawJSON inherited)
        (Reflect/set raw "rawJSON" "changed")
        (JSON/stringify value raw-replace) events))))
  (defun raw-throw (value)
    (JSON/rawJSON (js-object :toString (lambda () (throw value)))))
  (defun recover () (JSON/stringify (JSON/parse "{\"ok\":-0}")))
  ;; Only bounded scalar state is exposed when a contract assertion fails.
  (defun failure-phase () (+ (* (get state :phase) 100000) (get events :length)))
  (export parse-probe stringify-probe property-list-probe raw-probe raw-throw recover failure-phase))
