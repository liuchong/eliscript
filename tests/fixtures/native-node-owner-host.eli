(module tests.fixtures.native-node-owner-host
  (import "node:process" :default process)
  (import "node:fs/promises" readFile)
  (import "node:child_process" spawn)
  (defasync main ()
    (let* ((options (JSON/parse (await (readFile (aref (get process :argv) 2) "utf8"))))
           (child (spawn (get options :bunExecutable) (js-array (get options :runner)) (js-object :stdio (js-array "pipe" "pipe" "inherit")
              :env (Object/assign (js-object) (get process :env) (js-object :NODE_OPTIONS "" :BUN_OPTIONS "")))))
           (pending ""))
      (js-call child :on "error" (lambda (error) (js-call (get process :stderr) :write (str (get error :stack) "\n")) (js-call process :exit 1)))
      (js-call (get child :stdout) :setEncoding "utf8")
      (js-call (get child :stdout) :on "data" (lambda (chunk)
        (setq pending (str pending chunk))
        (let ((end (js-call pending :indexOf "\n")))
          (while (>= end 0)
            (let ((message (JSON/parse (js-call pending :slice 0 end))))
              (setq pending (js-call pending :slice (1+ end)))
              (cond ((get message :ready)
                (js-call (get child :stdin) :write (str (JSON/stringify (js-object :id 1 :method "open"
                  :args (js-array (get options :library) (get options :signatures)
                    (js-object :initialPages 1 :maximumPages 8 :nativeTarget (get options :target) :hostCapabilities (get options :capabilities))))) "\n")))
                ((= (get message :id) 1)
                  (when (get message :error) (throw (new globalThis.Error (JSON/stringify (get message :error)))))
                  (js-call (get child :stdin) :write (str (JSON/stringify (js-object :id 2 :method "invoke" :args (js-array "spin" 17 23))) "\n")))
                ((get message :callback)
                  ;; Readiness follows flush: owner death cannot unwind the
                  ;; still-running native frame by racing the callback response.
                  (js-call (get child :stdin) :write (str (JSON/stringify (js-object :callback (get (get message :callback) :id) :result 0)) "\n")
                    (lambda () (js-call (get process :stdout) :write (str (JSON/stringify (js-object :pid (get child :pid))) "\n")))))
                (t (throw (new globalThis.Error (str "native spin returned unexpectedly: " (JSON/stringify message)))))))
            (setq end (js-call pending :indexOf "\n"))))))))
  (main))
