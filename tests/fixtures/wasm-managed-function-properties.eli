(module managed.function-builtin-marking
  (defconst number (js* "Number"))
  (defconst string (js* "String"))
  (defconst symbol (js* "Symbol"))
  (defconst error (js* "Error"))
  (defconst finite (js* "Number.isFinite"))
  (defun ordinary () 1)
  (defun choose (mode)
    (cond ((= mode 0) number) ((= mode 1) string) ((= mode 2) symbol)
          ((= mode 3) error) ((= mode 4) finite) (t ordinary)))
  (defun read (mode key) (get (choose mode) key nil))
  (defun has (mode key) (object-has? (choose mode) key))
  (defun descriptor (mode key) (Object/getOwnPropertyDescriptor (choose mode) key))
  (defun keys (mode) (Object/keys (choose mode)))
  (defun names (mode) (Object/getOwnPropertyNames (choose mode)))
  (defun symbols (mode) (Object/getOwnPropertySymbols (choose mode)))
  (defun prototype (mode) (Object/getPrototypeOf (choose mode)))
  (defun cached ()
    (js-array (Object/is number (js* "Number")) (Object/is string (js* "String"))
      (Object/is symbol (js* "Symbol")) (Object/is error (js* "Error"))
      (Object/is finite Number/isFinite) (Object/is ordinary ordinary)))
  (defun call-number (value) (funcall number value))
  (defun call-string (value) (funcall string value))
  (defun call-finite (value) (funcall finite value))
  (defun static-finite (value) (Number/isFinite value))
  (defun call-symbol () (value-type (funcall symbol "x")))
  (defun call-error () (get (funcall error "message") :message))
  (defun effects ()
    (let ((trace (js-array)))
      (let ((result (funcall number (progn (js-call trace :push "value") "12")
                     (js-call trace :push "extra"))))
        (js-array result trace))))
  (export read has descriptor keys names symbols prototype cached call-number call-string call-finite static-finite call-symbol call-error effects))
