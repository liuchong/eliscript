(module managed.function-builtin-marking
  (defconst number globalThis.Number)
  (defconst string globalThis.String)
  (defconst symbol globalThis.Symbol)
  (defconst error globalThis.Error)
  (defconst finite Number/isFinite)
  (defun ordinary () 1)
  (defun choose (mode)
    (cond ((= mode 0) number) ((= mode 1) string) ((= mode 2) symbol)
          ((= mode 3) error) ((= mode 4) finite) (t ordinary)))
  (defun read (mode key) (get (choose mode) key nil))
  (defun has (mode key) (object-has? (choose mode) key))
  (defun descriptor (mode key) (Object/getOwnPropertyDescriptor (choose mode) key))
  (defun keys (mode) (Object/keys (choose mode)))
  (defun names (mode) (Object/getOwnPropertyNames (choose mode)))
  (defun symbols (mode) (Object/getOwnPropertySymbols (choose mode)))
  (defun prototype (mode) (Object/getPrototypeOf (choose mode)))
  (defun read-report (mode key)
    (let ((value (read mode key)))
      (js-array (value-type value)
        (Object/is value (get (choose mode) key nil))
        (if (= (value-type value) "function") (js-array (get value :name) (get value :length))
          (if (and value (= (value-type value) "object"))
            (js-array (Object/is value (get (choose mode) :prototype))) value)))))
  (defun descriptor-report (mode key)
    (let ((value (descriptor mode key)))
      (if (undefined? value) undefined
        (js-array (get value :enumerable) (get value :configurable)
          (object-has? value "writable") (get value :writable)
          (object-has? value "get") (object-has? value "set")
          (object-has? value "value") (value-type (get value :value))
          (Object/is (get value :value) (get (choose mode) key nil))))))
  (defun prototype-report (mode)
    (js-array (Object/is (prototype mode) (Object/getPrototypeOf (choose mode)))
      (Object/is (prototype mode) (get globalThis.Function :prototype))))
  (defun symbols-report (mode)
    (js-call (symbols mode) :map (lambda (value) (Symbol/keyFor value))))
  (defun cached ()
    (js-array (Object/is number globalThis.Number) (Object/is string globalThis.String)
      (Object/is symbol globalThis.Symbol) (Object/is error globalThis.Error)
      (Object/is finite Number/isFinite) (Object/is ordinary ordinary)))
  (defun call-number (value) (funcall number value))
  (defun call-string (value) (funcall string value))
  (defun call-finite (value) (funcall finite value))
  (defun static-finite (value) (Number/isFinite value))
  (defun call-symbol () (value-type (funcall symbol "x")))
  (defun call-error () (get (funcall error "message") :message))
  (defun effects ()
    (let ((trace (js-array)))
      (let ((result (funcall number (progn (js-call trace :push "value") "12")
                     (js-call trace :push "extra"))))
        (js-array result trace))))
  (export read has descriptor keys names symbols prototype read-report descriptor-report prototype-report symbols-report cached call-number call-string call-finite static-finite call-symbol call-error effects))
