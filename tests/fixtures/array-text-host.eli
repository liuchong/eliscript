(module tests.fixtures.array-text-host
  (import "node:process" :default process)
  (import "node:assert/strict" :default assert)
  (import "../../runtime/array-text.mjs" c)
  (defconst ordinaryOne (js* "(implementation) => function(value) { return implementation(this, value); }"))
  (defasync patchedIntrinsics ()
    (let* ((saved (js-object :String globalThis.String :apply (get globalThis.Reflect :apply) :has (get (get globalThis.WeakSet :prototype) :has)
             :add (get (get globalThis.WeakSet :prototype) :add) :delete (get (get globalThis.WeakSet :prototype) :delete)
             :join (get (get globalThis.Array :prototype) :join) :toString (get (get globalThis.Array :prototype) :toString) :objectString (get (get globalThis.Object :prototype) :toString)))
           (values (js-array "a" "中😀")) (captured (c values "join")) (fail (lambda () (throw (new globalThis.Error "mutated intrinsic")))) (result undefined) (error undefined))
      (try
        (put (js* "globalThis") :String fail) (put globalThis.Reflect :apply fail)
        (put (get globalThis.WeakSet :prototype) :has fail) (put (get globalThis.WeakSet :prototype) :add fail) (put (get globalThis.WeakSet :prototype) :delete fail)
        (put (get globalThis.Array :prototype) :join fail) (put (get globalThis.Array :prototype) :toString fail) (put (get globalThis.Object :prototype) :toString fail)
        (setq result (funcall captured "|"))
        (catch e (setq error e))
        (finally (put (js* "globalThis") :String (get saved :String)) (put globalThis.Reflect :apply (get saved :apply))
          (put (get globalThis.WeakSet :prototype) :has (get saved :has)) (put (get globalThis.WeakSet :prototype) :add (get saved :add)) (put (get globalThis.WeakSet :prototype) :delete (get saved :delete))
          (put (get globalThis.Array :prototype) :join (get saved :join)) (put (get globalThis.Array :prototype) :toString (get saved :toString)) (put (get globalThis.Object :prototype) :toString (get saved :objectString))))
      (js-call assert :equal error undefined) (js-call assert :equal result "a|中😀")))
  (defasync weakCounts ()
    (let* ((prototype (get globalThis.WeakSet :prototype)) (has (get prototype :has)) (add (get prototype :add)) (delete (get prototype :delete))
           (apply (get globalThis.Reflect :apply)) (counts (js-object :has 0 :add 0 :delete 0)) (capture undefined))
      (try
        (put prototype :has (funcall ordinaryOne (lambda (self value) (put counts :has (1+ (get counts :has))) (funcall apply has self (js-array value)))))
        (put prototype :add (funcall ordinaryOne (lambda (self value) (put counts :add (1+ (get counts :add))) (funcall apply add self (js-array value)))))
        (put prototype :delete (funcall ordinaryOne (lambda (self value) (put counts :delete (1+ (get counts :delete))) (funcall apply delete self (js-array value)))))
        (let ((module (await (funcall (js* "(url) => import(url)") "../../runtime/array-text.mjs?weak-counts")))) (setq capture (get module :c)))
        (finally (put prototype :has has) (put prototype :add add) (put prototype :delete delete)))
      ;; Start at the operation boundary; module initialization is not a join.
      (put counts :has 0) (put counts :add 0) (put counts :delete 0)
      (js-call assert :equal (funcall (funcall capture (js-array "a" "b") "join")) "a,b")
      (js-call assert :deepEqual counts (js-object :has 0 :add 0 :delete 0))
      (let ((shared (js-array "x"))) (js-call assert :equal (funcall (funcall capture (js-array shared shared) "join") "|") "x|x"))
      (js-call assert :deepEqual counts (js-object :has 2 :add 2 :delete 2))))
  (defasync compiledCheck (url)
    (let ((m (await (funcall (js* "(url) => import(url)") url))))
      (js-call assert :equal (js-call m :join (js-array "a" "" "中😀") "|") "a||中😀")
      (let ((cycle (js-array))) (js-call cycle :push cycle)
        (js-call assert :throws (lambda () (js-call m :join cycle)) (lambda (error) (let ((diagnostic (get error :eliscriptDiagnostic))) (= (if (nullish? diagnostic) undefined (get diagnostic :code)) "ELI-RT0009")))))))
  (defasync main ()
    (let ((mode (aref (get process :argv) 2)))
      (cond ((= mode "intrinsics") (await (patchedIntrinsics))) ((= mode "weak-counts") (await (weakCounts)))
        ((= mode "compiled") (await (compiledCheck (aref (get process :argv) 3)))))))
  (main))
