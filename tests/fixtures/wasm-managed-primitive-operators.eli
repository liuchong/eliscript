(module managed.primitive-operators
  (defun add (a b) (+ a b))
  (defun subtract (a b) (- a b))
  (defun multiply (a b) (* a b))
  (defun divide (a b) (/ a b))
  (defun remainder (a b) (% a b))
  (defun negate (a) (- a))
  (defun reciprocal (a) (/ a))
  (defun increment (a) (1+ a))
  (defun decrement (a) (1- a))
  (defun identity-add (a) (+ a))
  (defun identity-multiply (a) (* a))
  (defun signed (a) (int32 a))
  (defun unsigned (a) (uint32 a))
  (defun invert (a) (bit-not a))
  (defun mask (a b) (bit-and a b))
  (defun union (a b) (bit-or a b))
  (defun exclusive (a b) (bit-xor a b))
  (defun shift-left (a b) (bit-shift-left a b))
  (defun shift-right (a b) (bit-shift-right a b))
  (defun logical-right (a b) (unsigned-bit-shift-right a b))
  (defun product-word (a b) (imul32 a b))
  (defun equal (a b) (= a b))
  (defun less (a b) (< a b))
  (defun less-equal (a b) (<= a b))
  (defun greater (a b) (> a b))
  (defun greater-equal (a b) (>= a b))
  (defun ordered-add (a b c) (+ a b c))
  (defun ordered-subtract (a b c) (- a b c))
  (defun snapshot (a b) (+ a (setq a b)))
  (defun comparison-snapshot (a b c) (< a (setq a b) (setq a c)))
  (defun comparison-effects (a b) (let ((effect 0)) (< a b (setq effect 1)) effect))
  (defun scalar-loop (n seed)
    (let ((i 0) (x seed) (total 0))
      (while (< i n)
        (setq x (* (* 3.8 x) (- 1 x)))
        (setq total (+ total x)) (setq i (1+ i))) total))
  (export add subtract multiply divide remainder negate reciprocal increment decrement
    identity-add identity-multiply signed unsigned invert mask union exclusive shift-left
    shift-right logical-right product-word equal less less-equal greater greater-equal
    ordered-add ordered-subtract snapshot comparison-snapshot comparison-effects scalar-loop))
