(module tests.fixtures.portable-set-host
  (import "node:url" pathToFileURL)
  (import "../helpers/portable-structure.mjs" integerHash)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar setModule undefined)
  (defvar emptyPersistentSet undefined)
  (defvar persistentSet undefined)
  (defvar persistentSetCount undefined)
  (defvar persistentSetHas undefined)
  (defvar persistentSetConj undefined)
  (defvar persistentSetDisj undefined)
  (defvar persistentSetReduce undefined)
  (defvar persistentSetFromArray undefined)
  (defvar persistentSetToArray undefined)
  (defvar persistentSetUnion undefined)
  (defvar persistentSetIntersection undefined)
  (defvar persistentSetDifference undefined)
  (defvar persistentSetSubset undefined)
  (defvar persistentSetSuperset undefined)
  (defvar persistentSetDisjoint undefined)
  (defvar persistentSetEqual undefined)
  (defvar equal undefined)
  (defvar values undefined)
  (defvar original undefined)
  (defvar noopConj undefined)
  (defvar collision undefined)
  (defvar left undefined)
  (defvar right undefined)
  (defvar intersection undefined)
  (defvar difference undefined)
  (defvar union undefined)
  (defvar sample undefined)
  (defasync run-host-main ()
    (setq setModule (await (funcall load-module (get (pathToFileURL (aref (get globalThis.process :argv) 2)) :href))))
    (setq emptyPersistentSet setModule.empty_persistent_set)
    (setq persistentSet setModule.persistent_set_QMARK_)
    (setq persistentSetCount setModule.persistent_set_count)
    (setq persistentSetHas setModule.persistent_set_has_QMARK_)
    (setq persistentSetConj setModule.persistent_set_conj)
    (setq persistentSetDisj setModule.persistent_set_disj)
    (setq persistentSetReduce setModule.persistent_set_reduce)
    (setq persistentSetFromArray setModule.persistent_set_from_array)
    (setq persistentSetToArray setModule.persistent_set_to_array)
    (setq persistentSetUnion setModule.persistent_set_union)
    (setq persistentSetIntersection setModule.persistent_set_intersection)
    (setq persistentSetDifference setModule.persistent_set_difference)
    (setq persistentSetSubset setModule.persistent_set_subset_QMARK_)
    (setq persistentSetSuperset setModule.persistent_set_superset_QMARK_)
    (setq persistentSetDisjoint setModule.persistent_set_disjoint_QMARK_)
    (setq persistentSetEqual setModule.persistent_set_equal_QMARK_)
    (setq equal (lambda (left right) (= left right)))
    (setq values (emptyPersistentSet integerHash equal))
    (let ((value 0)) (while (< value 100000) (setq values (persistentSetConj values value) value (1+ value))))
    (setq original values)
    (setq noopConj (persistentSetConj values 54321))
    (setq values (persistentSetConj values 100000) values (persistentSetDisj values 75000))
    (setq collision (emptyPersistentSet (lambda () 7) equal))
    (let ((value 0)) (while (< value 100) (setq collision (persistentSetConj collision (str "key-" value)) value (1+ value))))
    (setq collision (persistentSetDisj collision "key-50"))
    (setq left (persistentSetFromArray integerHash equal (Array/from (js-object :length 1000) (lambda (ignored index) index))))
    (setq right (persistentSetFromArray integerHash equal (Array/from (js-object :length 1000) (lambda (ignored index) (+ index 500)))))
    (setq intersection (persistentSetIntersection left right))
    (setq difference (persistentSetDifference left right))
    (setq union (persistentSetUnion left right))
    (setq sample (js-call (persistentSetToArray (persistentSetFromArray integerHash equal (js-array 3 1 2 3 1))) :sort (lambda (a b) (- a b))))
    (js-call globalThis.console :log (JSON/stringify (js-object :persistent (persistentSet values) :count (persistentSetCount values)
    :rootKind (get (get (get values :map) :root) :kind)
    :probes (js-array (persistentSetHas values 0) (persistentSetHas values 75000) (persistentSetHas values 99999) (persistentSetHas values 100000))
    :originalCount (persistentSetCount original) :originalRetained (persistentSetHas original 75000) :sum (persistentSetReduce (lambda (result value) (+ result value)) 0 original)
    :noopConj (= noopConj original) :noopDisj (= (persistentSetDisj original -1) original)
    :collision (js-object :count (persistentSetCount collision) :kind (get (get (get collision :map) :root) :kind)
      :removed (persistentSetHas collision "key-50") :retained (persistentSetHas collision "key-99"))
    :algebra (js-object :union (persistentSetCount union) :intersection (persistentSetCount intersection) :difference (persistentSetCount difference)
      :subset (persistentSetSubset intersection left) :superset (persistentSetSuperset left intersection) :disjoint (persistentSetDisjoint intersection difference)
      :equal (persistentSetEqual union (persistentSetFromArray integerHash equal (Array/from (js-object :length 1500) (lambda (ignored index) index))))) :sample sample))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
