(module managed.control
  (defun identity (value) value)
  (defun choose (condition yes no) (if condition yes no))
  (defun truth (value) (if value t false))
  (defun invert (value) (not value))
  (defun both (a b) (and a b))
  (defun either (a b) (or a b))
  (defun parallel (x y) (let ((x y) (y x)) y))
  (defun sequential (x y) (let* ((x y) (y x)) y))
  (defun effects (a b) (or (setq a nil) (and (setq b "effect") b)))
  (defun once (value) (while value (setq value nil)))
  (defun clauses (a b) (cond (a a) (b b) (t "fallback")))
  (defun optional-result (value) (when value "yes"))
  (defun unless-result (value) (unless value "no"))
  (defun unicode () "\ud800中😀\u0000\udc00")
  (defun negative-zero () -0.0)
  (defun finite-number () 42.5)
  (defun undefined-result () undefined)
  (defun empty-and () (and))
  (defun empty-or () (or))
  (defun recurse (value) (if value (recurse false) "done"))
  (defun call-choose (a b) (choose a (identity b) (unicode)))
  (export identity choose truth invert both either parallel sequential effects once
    clauses optional-result unless-result unicode negative-zero finite-number undefined-result
    empty-and empty-or recurse call-choose))
