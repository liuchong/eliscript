(module tests.fixtures.worker-value-stream-probe
  (defconst host-type (js* "(value) => typeof value"))
  (defasync echo_text (value context)
    (unless (= (funcall host-type value) "string") (throw (new globalThis.TypeError "echo_text requires one string")))
    (await (js-call context :progress (get value :length)))
    (await (new globalThis.Promise (lambda (resolve) (globalThis/setTimeout resolve 100)))) value)
  (export echo_text))
