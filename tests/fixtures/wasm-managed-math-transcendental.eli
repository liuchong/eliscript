(module managed.math-transcendental
  (defun method (key) (get (js* "Math") key))
  (defun held (callback values) (apply callback values))
  (defun direct (key a b c)
    (cond ((= key "acos") (Math/acos a)) ((= key "acosh") (Math/acosh a))
      ((= key "asin") (Math/asin a)) ((= key "asinh") (Math/asinh a))
      ((= key "atan") (Math/atan a)) ((= key "atanh") (Math/atanh a))
      ((= key "atan2") (Math/atan2 a b)) ((= key "cbrt") (Math/cbrt a))
      ((= key "expm1") (Math/expm1 a)) ((= key "cos") (Math/cos a))
      ((= key "cosh") (Math/cosh a)) ((= key "exp") (Math/exp a))
      ((= key "hypot") (Math/hypot a b c)) ((= key "log") (Math/log a))
      ((= key "log1p") (Math/log1p a)) ((= key "log2") (Math/log2 a))
      ((= key "log10") (Math/log10 a)) ((= key "pow") (Math/pow a b))
      ((= key "random") (Math/random)) ((= key "sin") (Math/sin a))
      ((= key "sinh") (Math/sinh a)) ((= key "tan") (Math/tan a))
      (t (Math/tanh a))))
  (defun route (key mode values)
    (let* ((callback (method key)) (a (get values 0)) (b (get values 1)) (c (get values 2)))
      (cond ((= mode 0) (direct key a b c))
        ((= mode 1) (js-call (js* "Math") key a b c))
        ((= mode 2) (apply callback values))
        ((= mode 3) (js-call callback :call nil a b c))
        ((= mode 4) (js-call callback :apply false values))
        ((= mode 5) (apply (js-call callback :bind nil) values))
        ((= mode 6) (js-call (js* "Reflect") :apply callback nil values))
        ((= mode 7) (held callback values))
        ((= mode 8) (apply (js-call (js-call callback :bind nil) :bind false) values))
        (t (get (js-call (js-array values) :map (lambda (row) (apply callback row))) 0)))))
  (defun describe (key)
    (let* ((callback (method key)) (property (Object/getOwnPropertyDescriptor (js* "Math") key))
           (name (Object/getOwnPropertyDescriptor callback "name"))
           (length (Object/getOwnPropertyDescriptor callback "length")))
      (JSON/stringify (js-array (Object/is callback (method key))
        (Object/is callback (get globalThis/Math key))
        (get property :writable) (get property :enumerable) (get property :configurable)
        (get callback :name) (get callback :length) (Object/hasOwn callback "prototype")
        (get name :writable) (get name :enumerable) (get name :configurable)
        (get length :writable) (get length :enumerable) (get length :configurable)
        (try (new callback 0) (catch error (get error :name)))))))
  (defun tag (number)
    (js-array (Number/isNaN number) (Object/is number -0.0)
      (Object/is number (/ 1 0)) (Object/is number (/ -1 0))
      (if (Number/isFinite number) number nil)))
  (defun conversion (key mode)
    (let* ((trace (js-array)) (marker (js-object))
           (first (js-object :valueOf (lambda ()
             (js-call trace :push "first.valueOf")
             (cond ((= mode 1) (throw false)) ((= mode 2) (throw undefined))
               ((= mode 3) (funcall globalThis/Symbol "number"))
               ((= mode 4) (funcall globalThis/BigInt "0"))
               ((= mode 5) (progn (Math/exp 0) (Math/log 1) 0))
               ((= mode 8) (/ 0 0)) ((>= mode 7) (/ 1 0))
               (t 0)))))
           (second (js-object :valueOf (lambda () (js-call trace :push "second.valueOf")
             (cond ((= mode 6) (throw marker)) ((= mode 9) (funcall globalThis/Symbol "second"))
               ((or (= mode 7) (= mode 10)) (/ 0 0)) ((= mode 8) (/ 1 0)) (t 1)))))
           (extra (js-object :valueOf (lambda () (js-call trace :push "extra.valueOf")
             (if (= key "hypot") (if (= mode 10) (throw false) 0) (throw "ignored extra was converted"))))))
      (js-array
        (try
          (let ((value (js-call (js* "Math") key
                        (progn (js-call trace :push "argument first") first)
                        (progn (js-call trace :push "argument second") second)
                        (progn (js-call trace :push "argument extra") extra))))
            (if (= key "random") (js-array (>= value 0) (< value 1)) (tag value)))
          (catch error (cond ((Object/is error false) "false") ((Object/is error undefined) "undefined")
            ((Object/is error marker) "marker") (t (get error :name))))) trace)))
  (defun conversion-report (key mode) (JSON/stringify (conversion key mode)))
  (defun abrupt (key value)
    (js-call (js* "Math") key (js-object :valueOf (lambda () (throw value)))))
  (defun replacement (value) (+ value 100))
  (defun mutation (key)
    (let* ((namespace (js* "Math")) (property (Object/getOwnPropertyDescriptor namespace key))
           (callback (get property :value)) (trace (js-array)))
      (try
        (Object/defineProperty namespace key (js-object :configurable t :get (lambda ()
          (js-call trace :push "method get") callback)))
        (let ((value (js-call namespace key
                       (progn (js-call trace :push "argument first")
                         (Object/defineProperty namespace key
                           (js-object :value replacement :writable t :configurable t)) 0)
                       (progn (js-call trace :push "argument second") 1)
                       (progn (js-call trace :push "argument extra") 0))))
          (js-array (if (= key "random") (js-array (>= value 0) (< value 1)) (tag value))
            (js-call namespace key 7) (Object/is callback (method key)) trace))
        (finally (Object/defineProperty namespace key property)))))
  (defun mutation-report (key) (JSON/stringify (mutation key)))
  (defun method-mutation (key)
    (let* ((callback (method key)) (name (Object/getOwnPropertyDescriptor callback "name"))
           (length (Object/getOwnPropertyDescriptor callback "length")))
      (try
        (Object/defineProperty callback "name" (js-object :value "changed name"))
        (Object/defineProperty callback "length" (js-object :value 99))
        (let ((value (funcall callback 0 1 0)))
          (JSON/stringify (js-array (get callback :name) (get callback :length)
            (if (= key "random") (js-array (>= value 0) (< value 1)) (tag value)))))
        (finally (Object/defineProperty callback "name" name) (Object/defineProperty callback "length" length)))))
  (defun random-values (count)
    (let ((values (js-array)) (position 0))
      (while (< position count) (js-call values :push (Math/random)) (setq position (1+ position))) values))
  (defun scalar-call () (Math/pow 2 3))
  (defun reentrant-power ()
    (let* ((trace (js-array))
           (base (js-object :valueOf (lambda ()
             (js-call trace :push "base" (Math/sin 0)) 2)))
           (exponent (js-object :valueOf (lambda ()
             (js-call trace :push "exponent" (Math/exp 0) (Object/is (Math/sin -0.0) -0.0)) 3))))
      (JSON/stringify (js-array (Math/pow base exponent) trace))))
  (export method held direct route describe conversion-report abrupt mutation-report method-mutation random-values scalar-call reentrant-power))
