(module tests.fixtures.portable-vector-host
  (import "node:url" pathToFileURL)
  (import "node:path" resolve)
  (import "../helpers/portable-structure.mjs" nodeCount sharedNodeCount)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar vectorModule undefined)
  (defvar emptyPersistentVector undefined)
  (defvar isPersistentVector undefined)
  (defvar persistentVectorCount undefined)
  (defvar persistentVectorNth undefined)
  (defvar persistentVectorConj undefined)
  (defvar persistentVectorAssoc undefined)
  (defvar persistentVectorPop undefined)
  (defvar persistentVectorPeek undefined)
  (defvar persistentVectorReduce undefined)
  (defvar vector undefined)
  (defvar updated undefined)
  (defvar appended undefined)
  (defvar popped undefined)
  (defvar depth undefined)
  (defvar nodes undefined)
  (defasync run-host-main ()
    (setq vectorModule (await (funcall load-module (get (pathToFileURL (resolve (aref (get globalThis.process :argv) 2))) :href))))
    (setq emptyPersistentVector vectorModule.empty_persistent_vector)
    (setq isPersistentVector vectorModule.persistent_vector_QMARK_)
    (setq persistentVectorCount vectorModule.persistent_vector_count)
    (setq persistentVectorNth vectorModule.persistent_vector_nth)
    (setq persistentVectorConj vectorModule.persistent_vector_conj)
    (setq persistentVectorAssoc vectorModule.persistent_vector_assoc)
    (setq persistentVectorPop vectorModule.persistent_vector_pop)
    (setq persistentVectorPeek vectorModule.persistent_vector_peek)
    (setq persistentVectorReduce vectorModule.persistent_vector_reduce)
    (setq vector (emptyPersistentVector))
    (let ((value 0)) (while (< value 100000) (setq vector (persistentVectorConj vector value) value (1+ value))))
    (setq updated (persistentVectorAssoc vector 54321 "updated"))
    (setq appended (persistentVectorAssoc updated (persistentVectorCount updated) 100000))
    (setq popped (persistentVectorPop appended))
    (setq depth (+ 1 (/ (get vector :shift) 5)))
    (setq nodes (nodeCount (get vector :root) (get vector :shift)))
    (js-call (get globalThis.process :stdout) :write (str (JSON/stringify (js-object
    :persistent (isPersistentVector vector) :count (persistentVectorCount vector)
    :probes (js-call (js-array 0 31 32 1024 32768 99999) :map (lambda (index) (persistentVectorNth vector index "missing")))
    :original (persistentVectorNth vector 54321 "missing") :updated (persistentVectorNth updated 54321 "missing") :popped (persistentVectorPeek popped "empty")
    :sum (persistentVectorReduce (lambda (sum value) (+ sum value)) 0 vector)
    :shape (js-object :shift (get vector :shift) :depth depth :tailLength (js-length (get vector :tail)) :nodeCount nodes)
    :sharedNodes (sharedNodeCount (get vector :root) (get updated :root) (get vector :shift)) :expectedSharedNodes (- nodes depth))) "\n")))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
