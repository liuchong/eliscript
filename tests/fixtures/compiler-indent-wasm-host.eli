(module tests.fixtures.compiler-indent-wasm-host
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../helpers/indent-contract.mjs" invoke oracle finish)
  (defasync main ()
    (let ((a (instantiateManagedRuntime (readFileSync (aref (get globalThis.process :argv) 2)))) (state 1671729))
      (js-call a :auto 1)
      (letfn ((next () (setq state (uint32 (+ (Math/imul state 1664525) 1013904223))) state))
        (let ((n 0) (pool (js-array "a" "\ud83d\ude00" "\u4e2d" "\n" "\ud800")))
          (while (< n 100)
            (let* ((text (js-call (Array/from (js-object :length (% (next) 24)) (lambda () (aref pool (% (next) 5)))) :join ""))
                   (marks (Array/from (js-object :length (% (next) 12)) (lambda () (js-object :offset (% (next) (+ (get text :length) 3)) :span (% (next) 7))))))
              (when (not (= (% (next) 2) 0)) (js-call marks :sort (lambda (a b) (- (get a :offset) (get b :offset)))))
              (let ((input (js-object :text text :marks marks))) (js-call assert :deepEqual (invoke a input) (oracle input))))
            (setq n (1+ n)))))
      (finish a)))
  (main)
)
