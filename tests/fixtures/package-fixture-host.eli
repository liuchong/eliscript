(module tests.fixtures.package-fixture-host
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:path" dirname resolve)
  (import "node:url" pathToFileURL)
  (import "../../tools/backends/compiler-build.mjs" buildIndependentCompiler)
  (import "../../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../../tools/backends/compiler-bootstrap.mjs" openCompilerArtifact)
  (import "../../tools/backends/compiler-package.mjs" packageIndependentCompiler)
  (import "../../tools/backends/compiler-session.mjs" createCompilerSession)
  (defconst dynamicImport (js* "(specifier) => import(specifier)"))
  (defun output (kind value)
    (js-call (get process :stdout) :write (str (JSON/stringify (Object/assign (js-object :format "eliscript-package-fixture" :version 1 :kind kind) value)) "\n")))
  (defasync javascriptPackage (directory)
    (let* ((seed (await (buildIndependentCompiler (js-object :host "javascript" :outputRoot (resolve directory "seed") :profile "full-runtime" :retainIR false :debug false))))
      (producer (await (openCompilerArtifact seed))))
      (try
        (let* ((compiler (await (buildIndependentCompiler (js-object :host "javascript" :session producer :outputRoot (resolve directory "compiler") :profile "full-runtime" :retainIR false :debug false))))
          (packaged (await (packageIndependentCompiler (js-object :artifact compiler :outputRoot (resolve directory "package"))))))
          (output "javascript-package-setup" (js-object :packageDirectory (get packaged :directory) :sourceArtifactPath (get compiler :metadataPath))))
        (finally (await (js-call producer :close))))))
  (defasync wasmPackage (directory sourceArtifactPath)
    (let* ((input (Object/assign (js-object) (await (readCompilerMetadata sourceArtifactPath)) (js-object :directory (dirname sourceArtifactPath))))
      (verified (await (openCompilerArtifact input))))
      (await (js-call verified :close))
      (let* ((driver (await (funcall dynamicImport (get (pathToFileURL (resolve (get input :directory) (get input :path))) :href))))
        (observations 0) (collectionPhases (new globalThis.Set (js-array "managed-lower-complete" "wasm-emit-complete" "project-complete" "debug-file-complete")))
        (observe (lambda (phase counts)
          (let ((position observations)) (setq observations (+ observations 1))
            (when (< position 64)
              (let ((collected (js-call collectionPhases :delete phase)))
                (when collected (js-call globalThis.Bun :gc t))
                (let ((usage (js-call process :memoryUsage)))
                  (js-call globalThis.console :error "[wasm-package-build]" (JSON/stringify (Object/assign (js-object :phase phase) counts
                    (js-object :collected collected :rss (get usage :rss) :heapUsed (get usage :heapUsed) :heapTotal (get usage :heapTotal)))))))))))
        (compiler (Object/assign (js-object) driver (js-object :compiler_session_new (lambda ()
          (let ((state (js-call driver :compiler_session_new))) (put state :phaseObserver observe) state)))))
        (producer (await (createCompilerSession (js-object :host "javascript" :options (js-object :auto (get input :auto)) :compiler compiler)))))
        (try
          (let* ((emitted (await (buildIndependentCompiler (js-object :host "wasm" :session producer :outputRoot (resolve directory "wasm-compiler") :profile "full-runtime" :retainIR false :debug t :onPhase observe))))
            (packaged (await (packageIndependentCompiler (js-object :artifact emitted :outputRoot (resolve directory "wasm-package"))))))
            (output "wasm-debug-package" (js-object :packageDirectory (get packaged :directory) :artifactDirectory (get packaged :artifactDirectory) :manifestPath (get packaged :manifestPath))))
          (finally (await (js-call producer :close)))))))
  (defasync main ()
    (assert (get (get process :versions) :bun) "package fixture generation requires the actual Bun runtime")
    (let ((args (get process :argv)))
      (cond ((= (aref args 2) "javascript-package-setup") (await (javascriptPackage (aref args 3))))
        ((= (aref args 2) "wasm-debug-package") (await (wasmPackage (aref args 3) (aref args 4))))
        (t (throw (new globalThis.Error "unknown package fixture kind"))))))
  (main))
