(module tests.fixtures.portable-list-host
  (import "node:url" pathToFileURL)
  (import "node:path" resolve)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar listModule undefined)
  (defvar emptyPersistentList undefined)
  (defvar isPersistentList undefined)
  (defvar persistentListEmpty undefined)
  (defvar persistentListCount undefined)
  (defvar persistentListCons undefined)
  (defvar persistentListFirst undefined)
  (defvar persistentListRest undefined)
  (defvar persistentListPop undefined)
  (defvar persistentListNth undefined)
  (defvar persistentListReduce undefined)
  (defvar persistentListReverse undefined)
  (defvar persistentListToArray undefined)
  (defvar persistentListFromArray undefined)
  (defvar list undefined)
  (defvar previous undefined)
  (defvar reversed undefined)
  (defvar sample undefined)
  (defasync run-host-main ()
    (setq listModule (await (funcall load-module (get (pathToFileURL (resolve (aref (get globalThis.process :argv) 2))) :href))))
    (setq emptyPersistentList listModule.empty_persistent_list)
    (setq isPersistentList listModule.persistent_list_QMARK_)
    (setq persistentListEmpty listModule.persistent_list_empty_QMARK_)
    (setq persistentListCount listModule.persistent_list_count)
    (setq persistentListCons listModule.persistent_list_cons)
    (setq persistentListFirst listModule.persistent_list_first)
    (setq persistentListRest listModule.persistent_list_rest)
    (setq persistentListPop listModule.persistent_list_pop)
    (setq persistentListNth listModule.persistent_list_nth)
    (setq persistentListReduce listModule.persistent_list_reduce)
    (setq persistentListReverse listModule.persistent_list_reverse)
    (setq persistentListToArray listModule.persistent_list_to_array)
    (setq persistentListFromArray listModule.persistent_list_from_array)
    (setq list (emptyPersistentList))
    (setq previous list)
    (let ((value 0)) (while (< value 1000000) (setq previous list list (persistentListCons list value) value (1+ value))))
    (setq reversed (persistentListReverse list))
    (setq sample (persistentListFromArray (js-array "a" "b" "c")))
    (js-call (get globalThis.process :stdout) :write (str (JSON/stringify (js-object
    :persistent (isPersistentList list) :empty (persistentListEmpty (emptyPersistentList)) :count (persistentListCount list) :first (persistentListFirst list "empty")
    :probes (js-call (js-array 0 31 32 1024 32768 999999) :map (lambda (index) (persistentListNth list index "missing")))
    :sum (persistentListReduce (lambda (total value) (+ total value)) 0 list) :restShared (= (persistentListRest list nil) previous) :popShared (= (persistentListPop list) previous)
    :reversedFirst (persistentListFirst reversed "empty") :reversedLast (persistentListNth reversed 999999 "missing") :sample (persistentListToArray sample))) "\n")))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
