(module tests.fixtures.archive-source-assets-host
  (import "node:process" :default process)
  (import "node:fs" readFileSync)
  (import "node:fs/promises" mkdir open)
  (import "node:path" join)
  (defconst dynamicImport (js* "(specifier) => import(specifier)"))
  (defasync saveReference (reference input index directory sources)
    (let* ((result (await (js-call reference :request (js-object :operation "compile-ir" :source (get input :source) :filename (get input :filename)))))
      (ir (get result :ir)) (file (await (open (join directory (if (< index 0) "runtime.ir.utf16" (str (js-call (funcall globalThis.String index) :padStart 4 "0") ".ir.utf16"))) "wx")))
      (failed false) (offset 0))
      (try
        (while (< offset (js-length ir))
          (let ((bytes (Buffer/from (js-call ir :slice offset (+ offset 32768)) "utf16le")) (position 0))
            (while (< position (js-length bytes))
              (let ((count (get (await (js-call file :write bytes position (- (js-length bytes) position) nil)) :bytesWritten)))
                (unless (and (Number/isInteger count) (>= count 1) (<= count (- (js-length bytes) position))) (throw (new globalThis.Error "reference IR write did not advance")))
                (setq position (+ position count)))))
          (setq offset (+ offset 32768)))
        (catch error (setq failed t) (throw error))
        (finally (try (await (js-call file :close)) (catch error (unless failed (throw error))))))
      (when (and (= (get (get process :env) :ELISCRIPT_TEST_TRACE_IR_EXPORT) "1") (< index 128))
        (let ((usage (js-call process :memoryUsage)))
          (js-call globalThis.console :error (JSON/stringify (js-object :phase "reference-ir-complete" :index index :total (js-length (get sources :literalSources))
            :units (js-length ir) :rss (get usage :rss) :heapUsed (get usage :heapUsed))))))
      (js-length ir)))
  (defasync main ()
    (let* ((args (get process :argv)) (mode (aref args 2)) (outputRoot (aref args 3)) (referenceDirectory (aref args 4))
      (sources (JSON/parse (readFileSync 0 "utf8"))))
      (if (= mode "build")
        (let* ((builder (await (funcall dynamicImport (get (new globalThis.URL "../../tools/backends/compiler-build.mjs" (js* "import.meta.url")) :href))))
          (artifact (await (js-call builder :buildIndependentCompiler (js-object :host "javascript" :outputRoot outputRoot :sources sources :profile "full-runtime" :retainIR false :debug false)))))
          (js-call globalThis.console :log (JSON/stringify (js-object :host (get artifact :host) :metadataPath (get artifact :metadataPath)))))
        (let* ((bootstrap (await (funcall dynamicImport (get (new globalThis.URL "../../tools/backends/compiler-bootstrap.mjs" (js* "import.meta.url")) :href))))
          (codec (await (funcall dynamicImport (get (new globalThis.URL "../../tools/backends/compiler-metadata.mjs" (js* "import.meta.url")) :href))))
          (metadataPath (join outputRoot "compiler-artifact.json")) (metadata (await (js-call codec :readCompilerMetadata metadataPath)))
          (artifact (Object/assign (js-object) metadata (js-object :directory outputRoot :metadataPath metadataPath))))
          (await (mkdir referenceDirectory))
          (let ((reference (await (js-call bootstrap :openCompilerArtifact artifact))) (runtimeUnits undefined) (literalUnits (js-array)) (failed false))
            (try
              (setq runtimeUnits (await (saveReference reference (get sources :runtime) -1 referenceDirectory sources)))
              (let ((__eli_iteration_1_index 0) (__eli_iteration_1_limit (js-length (get sources :literalSources))))
  (while (< __eli_iteration_1_index __eli_iteration_1_limit)
    (let ((index __eli_iteration_1_index))
      (js-call literalUnits :push (await (saveReference reference (aref (get sources :literalSources) index) index referenceDirectory sources)))
      (setq __eli_iteration_1_index (+ index 1)))))
              (catch error (setq failed t) (throw error))
              (finally (try (await (js-call reference :close)) (catch error (unless failed (throw error))))))
            (js-call globalThis.console :log (JSON/stringify (js-object :host (get artifact :host) :metadataPath metadataPath :runtimeUnits runtimeUnits :literalUnits literalUnits))))))))
  (main))
