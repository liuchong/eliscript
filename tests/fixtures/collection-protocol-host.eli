  (defconst vector (persistentVector 2 4 6 8)) (defconst map (persistentHashMap (js-array "left" 3) (js-array "right" 5)))
  (defconst set (persistentHashSet "alpha" "beta")) (defconst list (persistentList 2 4 6 8))
  (defconst mapEntries (js-call (Array/from (js-call c :seq map)) :sort (lambda (left right) (js-call (aref left 0) :localeCompare (aref right 0)))))
  (defconst constructedMap (js-call (Array/from (js-call c :conj map (js-array "third" 7))) :sort (lambda (left right) (js-call (aref left 0) :localeCompare (aref right 0)))))
  (js-call globalThis.console :log (JSON/stringify (js-object
    :classification (js-array (js-call c :isCollection list) (js-call c :isCollection vector) (js-call c :isCollection map) (js-call c :isCollection set)
      (js-call c :isList list) (js-call c :isVector vector) (js-call c :isMap map) (js-call c :isSet set) (js-call c :isSequential vector)
      (js-call c :isSequence (js-call c :seq vector)) (js-call c :isCollection (js-array)) (js-call c :isVector (js-array)))
    :bounded (js-array (js-call c :boundedCount 2 vector) (js-call c :boundedCount 10 vector))
    :distinct (js-array (js-call c :areDistinct 1 2 3) (js-call c :areDistinct (persistentVector 1 2) (persistentVector 1 2)))
    :counts (js-array (js-call c :count vector) (js-call c :count map) (js-call c :count set) (js-call c :count (js-array 1 2)) (js-call c :count nil))
    :lookup (js-array (js-call c :get vector 2) (js-call c :get map "right") (js-call c :get set "alpha") (js-call c :nth vector 9 "missing"))
    :sequence (js-object :view (js-call c :isSequenceView (js-call c :seq vector)) :vector (Array/from (js-call c :seq vector)) :map mapEntries :empty (js-call c :seq (js-array)))
    :reductions (js-object :vector (js-call c :reduce vector (lambda (total value) (+ total value)) 0)
      :map (js-call c :reduce map (lambda (total entry) (+ total (aref entry 1))) 0)
      :set (js-call (js-call c :reduce set (lambda (values value) (js-call values :concat (js-array value))) (js-array)) :sort)
      :early (js-call c :reduce vector (lambda (total value) (if (= value 6) (js-call c :reduced (+ total value)) (+ total value))) 0)
      :indexed (js-call c :reduceKV vector (lambda (total index value) (+ total index value)) 0)
      :keyed (js-call c :reduceKV map (lambda (total key value) (+ total (get key :length) value)) 0))
    :construction (js-object :vector (Array/from (js-call c :conj vector 10)) :map constructedMap :set (js-call (Array/from (js-call c :conj set "gamma")) :sort)
      :associated (Array/from (js-call c :assoc vector 1 9)) :contains (js-array (js-call c :contains vector 3) (js-call c :contains map "missing") (js-call c :contains set "beta"))
      :emptied (js-array (js-call c :count (js-call c :empty vector)) (js-call c :count (js-call c :empty map)) (js-call c :count (js-call c :empty set))))
    :removal (js-object :map (Array/from (js-call c :dissoc map "left")) :set (Array/from (js-call c :disj set "alpha")) :object (js-call c :dissoc (js-object :left 3 :right 5) "left"))
    :stack (js-object :list (js-array (js-call c :peek list) (Array/from (js-call c :pop list))) :vector (js-array (js-call c :peek vector) (Array/from (js-call c :pop vector)))
      :array (js-array (js-call c :peek (js-array 2 4 6)) (js-call c :pop (js-array 2 4 6))) :nil (js-array (js-call c :peek nil) (js-call c :pop nil)))
    :reversible (js-object :vector (Array/from (js-call c :rseq vector)) :array (Array/from (js-call c :rseq (js-array 2 4 6)))
      :string (Array/from (js-call c :rseq "abc")) :nil (js-call c :rseq nil))))))
