(module fixture.managed-language-intrinsics
  (defportable parse-bigint (value) (string-to-bigint value))
  (defun choose (() "none") ((value) value))
  (defvar order "")
  (defun arity-order ()
    (setq order "")
    (try (choose (progn (setq order (str order "a")) 1)
                 (progn (setq order (str order "b")) 2))
      (catch error (js-array order (get error :name) (get error :message)))))
  (defun operand-first () (string-to-bigint (throw false)))
  (defun conversion-throw ()
    (string-to-bigint (js-object :valueOf (lambda () (throw false)))))
  (defun conversion-reentry ()
    (string-to-bigint (js-object :valueOf (lambda ()
      (let ((first (string-to-bigint "20")))
        (+ first (string-to-bigint "22")))))))
  (defun qualified-nullish (value) (or (eq value nil) (eq value globalThis/undefined)))
  (defun qualified-undefined () (js-array globalThis/undefined globalThis.undefined))
  (defun qualified-numbers ()
    (js-array globalThis/NaN globalThis.NaN globalThis/Infinity globalThis.Infinity))
  (defun qualified-shadow (globalThis)
    (js-array globalThis/undefined globalThis.undefined globalThis/NaN globalThis.NaN
      globalThis/Infinity globalThis.Infinity))
  (defun qualified-capture (globalThis) (funcall (lambda () globalThis/undefined)))
  (defun qualified-getters ()
    (let ((reads 0) (globalThis (js-object :NaN 17 :Infinity 23)))
      (Object/defineProperty globalThis "undefined" (js-object :get (lambda () (setq reads (1+ reads)) -0)))
      (let ((values (qualified-shadow globalThis))) (js-call values :push reads) values)))
  (defun qualified-number-shadow ()
    (let ((globalThis (js-object :Number (js-object :NaN 31 :POSITIVE_INFINITY 32 :NEGATIVE_INFINITY 33))))
      (js-array (get globalThis/Number :NaN) (get globalThis.Number :POSITIVE_INFINITY)
        (get globalThis/Number :NEGATIVE_INFINITY))))
  (defun qualified-null-root () (let ((globalThis nil)) globalThis/undefined))
  (defun qualified-callee (trace)
    (funcall globalThis/undefined (progn (put trace 0 9) 42)))
  (export parse-bigint choose arity-order operand-first conversion-throw conversion-reentry
    qualified-nullish qualified-undefined qualified-numbers qualified-shadow qualified-capture
    qualified-getters qualified-number-shadow qualified-null-root qualified-callee))
