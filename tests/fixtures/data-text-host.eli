(module tests.fixtures.data-text-host
  (import "../../runtime/core/data-text.mjs" printValue readValue)
  (import "../../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../../runtime/core/list.mjs" persistentList)
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/metadata.mjs" meta withMeta)
  (import "../../runtime/core/queue.mjs" persistentQueue)
  (import "../../runtime/core/set.mjs" persistentHashSet)
  (import "../../runtime/core/value.mjs" equalValues)
  (import "../../runtime/core/vector.mjs" persistentVector)
  (defconst metadata (persistentHashMap (js-array (keyword "source") "host")))
  (defconst value (withMeta (persistentHashMap
    (js-array (keyword "vector") (persistentVector 1 (eliscriptSymbol "two")))
    (js-array (keyword "list") (persistentList 1 (keyword "two")))
    (js-array (keyword "set") (persistentHashSet 3 1 2))
    (js-array (keyword "map") (persistentHashMap (js-array (keyword "b") 2) (js-array (keyword "a") 1)))
    (js-array (keyword "queue") (persistentQueue 1 (keyword "two") (persistentVector 3)))) metadata))
  (defconst text (printValue value)) (defconst restored (readValue text))
  (js-call globalThis.console :log (JSON/stringify (js-object :text text :stable (= (printValue restored) text)
    :equal (equalValues restored value) :source (js-call (meta restored) :get (keyword "source"))))))
