(module tests.fixtures.compiler-blocked-worker-host
  (defvar block undefined)
  (defun reply (message result)
    (js-call (js* "globalThis") :postMessage (js-object :version (get message :version) :type "result" :id (get message :id)
      :requestIdentity (get message :requestIdentity) :sourceIdentity (get message :sourceIdentity) :revision (get message :revision) :host "wasm" :ok t :result result)))
  (js-call (js* "globalThis") :addEventListener "message" (lambda (event)
    (let ((message (get event :data)))
      (cond ((= (get message :type) "arm-block") (setq block (get message :buffer)) (js-call (js* "globalThis") :postMessage (js-object :type "armed")))
            ((= (get message :type) "cancel") (js-call (js* "globalThis") :postMessage (js-object :type "cancel" :version (get message :version) :id (get message :id) :accepted t)))
            ((= (get message :type) "shutdown") (reply message (js-object :closed t)))
            (t (let ((request (JSON/parse (get message :request))))
              (when (= (get request :operation) "block-event-loop")
                (js-call (js* "globalThis") :postMessage (js-object :type "blocking-entered" :id (get message :id)))
                (Atomics/wait (new globalThis.Int32Array block) 0 0))
              (reply message (js-object :host "wasm" :operation (get request :operation))))))))))
