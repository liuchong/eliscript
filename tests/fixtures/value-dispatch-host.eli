(module tests.fixtures.value-dispatch-host
  (import "node:url" pathToFileURL)
  (defconst host-import (js* "(specifier) => import(specifier)"))
  (defconst modulePath (aref (js-call (get globalThis.process :argv) :slice 2) 0))
  (defvar declarations undefined)
  (defvar failure undefined)
  (defasync run-host-main ()
    (setq declarations (await (funcall host-import (get (pathToFileURL modulePath) :href))))
    (setq failure undefined)
    (try (js-call declarations :no_condp_match)
    (catch error (setq failure (js-object :name (get error :name) :message (get error :message)))))
    (js-call globalThis.console :log (JSON/stringify (js-object :report (js-call declarations :dispatch_report) :failure failure))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
