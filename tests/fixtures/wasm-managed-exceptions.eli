(module managed.exceptions
  (defconst marker 1)
  (defun caught (value) (try (throw value) (catch error error)))
  (defun uncaught (value) (throw value))
  (defun normal (value trace) (try value (catch error false) (finally (js-call trace :push "finally") 99)))
  (defun replaced (first second trace)
    (try (throw first) (catch error (js-call trace :push error) error)
      (finally (js-call trace :push "finally") (throw second))))
  (defun nested (value trace)
    (try (try (throw value) (finally (js-call trace :push "inner")))
      (catch error (js-call trace :push "catch") error)
      (finally (js-call trace :push "outer"))))
  (defun indirect (value) (let ((callback (lambda () (throw value)))) (try (funcall callback) (catch error error))))
  (defun recursive (depth value)
    (if (= depth 0) (throw value) (recursive (- depth 1) value)))
  (defun across (depth value) (try (recursive depth value) (catch error error)))
  (defun shadow (value) (let ((error 7)) (js-array (try (throw value) (catch error error)) error)))
  (defun handler-throw (first second) (try (try (throw first) (catch error (throw second))) (catch error error)))
  (defun handler-closure (value) (try (throw value) (catch error (lambda () error))))
  (defun call-handler (callback) (funcall callback))
  (defun make-error (kind message options)
    (cond ((= kind 0) (new (js* "Error") message options))
      ((= kind 1) (new (js* "TypeError") message options))
      ((= kind 2) (new (js* "RangeError") message options))
      (t (new (js* "SyntaxError") message options))))
  (defun error-summary (error)
    (js-array (aref error "name") (aref error "message")
      (Object/hasOwn error "name") (Object/hasOwn error "message") (Object/hasOwn error "cause")))
  (export caught uncaught normal replaced nested indirect across shadow handler-throw handler-closure call-handler make-error error-summary))
