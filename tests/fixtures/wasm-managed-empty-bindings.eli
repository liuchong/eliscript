(module managed.empty-bindings
  (defconst marker 7)
  (defun default-value () (let (next) next))
  (defun parallel-value (value)
    (let ((x value)) (let (x (saved x)) (if (eq x nil) saved -1))))
  (defun sequential-value (value)
    (let ((x value)) (let* (x (saved x)) (if (eq saved nil) marker -1))))
  (defun capture-value (value)
    (let* (next (read (lambda () next))) (setq next value) (funcall read)))
  (defun escape-value ()
    (let (next) (lambda (value) (if (eq value nil) next (progn (setq next value) next)))))
  (defun loop-value (limit)
    (let (next (index 0))
      (while (< index limit) (setq next index) (setq index (1+ index))) next))
  (defun effect-value (trace)
    (let (next (one (put trace :first 1)) (two (put trace :second 2)))
      (js-array next one two)))
  (export default-value parallel-value sequential-value capture-value escape-value loop-value effect-value))
