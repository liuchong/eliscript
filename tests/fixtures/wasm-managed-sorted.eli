            (setq map (js-call map :dissoc (% (* index 37) 97)) all-valid (and all-valid (tree-valid map)) index (1+ index)))
          (js-call out :push (js-array all-valid (get map :count) (get source :count) (tree-valid source)
            (Object/is root (get (Sorted/readSortedMapState source) :root))
            (Object/is source (js-call source :assoc 0 0)) (Object/is source (js-call source :dissoc 1000)))))) out))
