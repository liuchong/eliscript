            (let ((root (get (Sorted/readSortedMapState map) :root)))
              (js-call out :push (js-array (get root :key) (get root :height) (get root :size) (tree-valid map)))))
          (setq position (1+ position))))
      (let ((map (get Sorted :EMPTY_SORTED_MAP)) (index 0) (all-valid t))
        (while (< index 96) (setq map (js-call map :assoc (% (* index 37) 97) index) index (1+ index)))
        (let ((source map) (root (get (Sorted/readSortedMapState map) :root)))
          (setq index 0)
