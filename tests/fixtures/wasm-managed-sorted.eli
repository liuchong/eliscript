            (Object/is (Order/sort nil) (js-call (get (Object/getPrototypeOf (Order/sort nil)) :constructor) :empty)))))))
  (defun randomized (operations)
    (let ((map (get Sorted :EMPTY_SORTED_MAP)) (versions (js-array)) (out (js-array)) (index 0) (valid t))
      (while (< index (js-length operations))
        (let ((operation (get operations index)))
          (if (= (get operation 0) 0)
            (setq map (js-call map :assoc (get operation 1) (get operation 2)))
            (setq map (js-call map :dissoc (get operation 1)))))
        (setq valid (and valid (tree-valid map)))
        (when (= (% index 17) 0)
          (js-call versions :push map)
          (js-call out :push (Array/from map)))
        (setq index (1+ index)))
      (js-array (Array/from map) out valid
        (js-call versions :map (lambda (version) (Array/from version)))
        (js-call versions :every (lambda (version) (and (tree-valid version) (Object/isFrozen version)))))))
  (defun collect-nodes (node nodes)
    (unless (nil? node) (js-call nodes :add node) (collect-nodes (get node :left) nodes) (collect-nodes (get node :right) nodes)))
  (defun sharing ()
    (let* ((calls 0) (map (Sorted/emptySortedMapBy (lambda (left right) (setq calls (1+ calls)) (- left right)))) (index 0))
      (while (< index 127) (setq map (js-call map :assoc index index) index (1+ index)))
      (let* ((root (get (Sorted/readSortedMapState map) :root)) (height (get root :height)) (old-nodes (new globalThis/Set)) (new-nodes (new globalThis/Set)))
        (setq calls 0)
        (let ((updated (js-call map :assoc 0 "updated")))
          (let ((work calls) (shared 0))
            (collect-nodes root old-nodes) (collect-nodes (get (Sorted/readSortedMapState updated) :root) new-nodes)
            (js-call new-nodes :forEach (lambda (node) (when (js-call old-nodes :has node) (setq shared (1+ shared)))))
            (js-array (<= work height) (> shared (- 127 height 1)) (tree-valid map) (tree-valid updated)
              (js-call map :get 0) (js-call updated :get 0) (get map :count) (get updated :count)))))))
