        (report (lambda () (Order/sort Order/compareValues (js-array) (js-array))))
        (report (lambda () (Order/sortBy nil (js-array))))
        (report (lambda () (Order/sortBy (lambda (value) value))))
        (report (lambda () (Order/sortBy (lambda (value) value) Order/compareValues (js-array) (js-array))))
        (let ((original (js-array 3 1 2 1)))
