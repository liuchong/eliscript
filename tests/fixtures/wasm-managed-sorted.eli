        (Order/compareValues (Literal/symbol "a/item") (Literal/symbol "a/item"))
        (Order/compareValues (Literal/vector 1 2) (Literal/vector 1 2 0))
        (Order/compareValues (Literal/list 1 (Literal/vector 2 4)) (Literal/list 1 (Literal/vector 3)))
        (Order/compareValues low high)
