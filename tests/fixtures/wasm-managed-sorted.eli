                   (= height (get node :height)) (= size (get node :size))
                   (<= (Math/abs (- (get left 1) (get right 1))) 1)) height size))))
  (defun tree-valid (map) (get (valid-tree (get (Sorted/readSortedMapState map) :root)) 0))
  (defun rotations ()
    (let ((out (js-array)))
      (let ((orders (js-array (js-array 3 2 1) (js-array 1 2 3) (js-array 3 1 2) (js-array 1 3 2))) (position 0))
        (while (< position (js-length orders))
