(module tests.fixtures.compiler-stage-products-host
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defasync run-host-main ()
    (let* ((reference (await (funcall load-module (aref (get globalThis.process :argv) 3))))
         (bytes (readFileSync (aref (get globalThis.process :argv) 2)))
         (module (new globalThis.WebAssembly.Module bytes))
         (product (get (new globalThis.WebAssembly.Instance module) :exports)))
    (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports module) (js-array))
    (js-call (js-array (js-array 20 22) (js-array -1 1) (js-array (js* "-0") (js* "-0"))
      (js-array globalThis.Infinity (- globalThis.Infinity)) (js-array globalThis.Number.MIN_VALUE 0))
      :forEach (lambda (args) (funcall assert (Object/is
        (Reflect/apply (get product :add) product args) (Reflect/apply (get reference :add) reference args)))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
