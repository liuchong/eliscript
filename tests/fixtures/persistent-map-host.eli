(module tests.fixtures.persistent-map-host
  (import "../../runtime/core/map.mjs" EMPTY_MAP persistentHashMap)
  (import "../../runtime/testing/map.mjs" inspectPersistentMap persistentMapMetrics resetPersistentMapMetrics sharedPersistentMapNodes)
  (import "../../runtime/core/value.mjs" equalValues hashValue)
  (import "../../runtime/core/vector.mjs" persistentVector)
  (defvar values EMPTY_MAP)
  (let ((key 0)) (while (< key 100000) (setq values (js-call values :assoc key (* key 2)) key (1+ key))))
  (defconst shape (inspectPersistentMap values))
  (resetPersistentMapMetrics)
  (defconst updated (js-call values :assoc 54321 "updated"))
  (defconst metrics (persistentMapMetrics))
  (defconst collision (persistentHashMap (js-array "key-50691" "left") (js-array "key-194634" "right")))
  (defconst ordered (persistentHashMap (js-array "alpha" 1) (js-array (persistentVector 1 2) (persistentVector "value")) (js-array "omega" 3)))
  (defconst reversed (persistentHashMap (js-array "omega" 3) (js-array (persistentVector 1 2) (persistentVector "value")) (js-array "alpha" 1)))
  (js-call globalThis.console :log (JSON/stringify (js-object :shape shape
    :probes (js-call (js-array 0 31 32 1024 32768 99999) :map (lambda (key) (js-call values :get key)))
    :missing (js-call values :get "missing" "not-found") :original (js-call values :get 54321) :updated (js-call updated :get 54321)
    :sharedNodes (sharedPersistentMapNodes values updated) :metrics metrics
    :sum (js-call values :reduce (lambda (total value) (+ total value)) 0)
    :collision (js-object :count (get collision :count) :left (js-call collision :get "key-50691") :right (js-call collision :get "key-194634")
      :shape (inspectPersistentMap collision))
    :unordered (js-object :equal (equalValues ordered reversed) :leftHash (hashValue ordered) :rightHash (hashValue reversed))))))
