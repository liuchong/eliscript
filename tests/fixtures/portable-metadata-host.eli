(module tests.fixtures.portable-metadata-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst moduleUrl (pathToFileURL (aref (get globalThis.process :argv) 2)))
  (defvar metadataModule undefined)
  (defvar valueModule undefined)
  (defvar listModule undefined)
  (defvar vectorModule undefined)
  (defvar mapModule undefined)
  (defvar setModule undefined)
  (defvar meta undefined)
  (defvar metadataValid undefined)
  (defvar supportsMetadata undefined)
  (defvar varyMeta undefined)
  (defvar withMeta undefined)
  (defvar valueEqual undefined)
  (defvar valueHash undefined)
  (defvar valueMapFromEntries undefined)
  (defvar valueSetFromArray undefined)
  (defvar listConj undefined)
  (defvar listFromArray undefined)
  (defvar listRest undefined)
  (defvar listToArray undefined)
  (defvar vectorAssoc undefined)
  (defvar vectorFromArray undefined)
  (defvar vectorToArray undefined)
  (defvar mapAssoc undefined)
  (defvar mapCount undefined)
  (defvar mapGet undefined)
  (defvar setConj undefined)
  (defvar setCount undefined)
  (defvar metadata undefined)
  (defvar list undefined)
  (defvar vector undefined)
  (defvar map undefined)
  (defvar set undefined)
  (defvar annotatedList undefined)
  (defvar annotatedVector undefined)
  (defvar annotatedMap undefined)
  (defvar annotatedSet undefined)
  (defvar varied undefined)
  (defasync run-host-main ()
    (setq metadataModule (await (funcall load-module (get moduleUrl :href))))
    (setq valueModule (await (funcall load-module (get (new globalThis.URL "./value.eli" moduleUrl) :href))))
    (setq listModule (await (funcall load-module (get (new globalThis.URL "./persistent-list.eli" moduleUrl) :href))))
    (setq vectorModule (await (funcall load-module (get (new globalThis.URL "./persistent-vector.eli" moduleUrl) :href))))
    (setq mapModule (await (funcall load-module (get (new globalThis.URL "./persistent-map.eli" moduleUrl) :href))))
    (setq setModule (await (funcall load-module (get (new globalThis.URL "./persistent-set.eli" moduleUrl) :href))))
    (setq meta metadataModule.meta)
    (setq metadataValid metadataModule.metadata_valid_QMARK_)
    (setq supportsMetadata metadataModule.supports_metadata_QMARK_)
    (setq varyMeta metadataModule.vary_meta)
    (setq withMeta metadataModule.with_meta)
    (setq valueEqual valueModule.value_equal_QMARK_)
    (setq valueHash valueModule.value_hash)
    (setq valueMapFromEntries valueModule.value_map_from_entries)
    (setq valueSetFromArray valueModule.value_set_from_array)
    (setq listConj listModule.persistent_list_conj)
    (setq listFromArray listModule.persistent_list_from_array)
    (setq listRest listModule.persistent_list_rest)
    (setq listToArray listModule.persistent_list_to_array)
    (setq vectorAssoc vectorModule.persistent_vector_assoc)
    (setq vectorFromArray vectorModule.persistent_vector_from_array)
    (setq vectorToArray vectorModule.persistent_vector_to_array)
    (setq mapAssoc mapModule.persistent_map_assoc)
    (setq mapCount mapModule.persistent_map_count)
    (setq mapGet mapModule.persistent_map_get)
    (setq setConj setModule.persistent_set_conj)
    (setq setCount setModule.persistent_set_count)
    (setq metadata (valueMapFromEntries (js-array (js-array "source" "portable") (js-array "line" 7))))
    (setq list (listFromArray (js-array 1 2 3)))
    (setq vector (vectorFromArray (js-array 1 2 3)))
    (setq map (valueMapFromEntries (js-array (js-array "a" 1) (js-array "b" 2))))
    (setq set (valueSetFromArray (js-array 1 2 3)))
    (setq annotatedList (withMeta list metadata))
    (setq annotatedVector (withMeta vector metadata))
    (setq annotatedMap (withMeta map metadata))
    (setq annotatedSet (withMeta set metadata))
    (setq varied (varyMeta annotatedVector (lambda (current key value) (mapAssoc current key value)) "line" 9))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :support (js-object :list (supportsMetadata list) :vector (supportsMetadata vector) :map (supportsMetadata map) :set (supportsMetadata set) :host (supportsMetadata (js-object)))
    :metadata (js-object :valid (metadataValid metadata) :invalid (metadataValid (js-object)) :unsupported (withMeta (js-object) metadata)
      :invalidAttachment (withMeta vector (js-object)) :source (mapGet (meta annotatedMap) "source" nil) :variedLine (mapGet (meta varied) "line" nil))
    :semantics (js-object :equal (valueEqual vector annotatedVector) :hashEqual (= (valueHash vector) (valueHash annotatedVector)) :childMetadata (meta (listRest annotatedList)))
    :sharing (js-object :list (= (get annotatedList :rest) (get list :rest))
      :vector (and (= (get annotatedVector :root) (get vector :root)) (= (get annotatedVector :tail) (get vector :tail)))
      :map (= (get annotatedMap :root) (get map :root)) :set (= (get annotatedSet :map) (get set :map)))
    :updates (js-object :list (= (meta (listConj annotatedList 0)) metadata) :vector (= (meta (vectorAssoc annotatedVector 1 20)) metadata)
      :map (= (meta (mapAssoc annotatedMap "c" 3)) metadata) :set (= (meta (setConj annotatedSet 4)) metadata))
    :hostValues (js-object :list (listToArray annotatedList) :vector (vectorToArray annotatedVector) :mapCount (mapCount annotatedMap) :setCount (setCount annotatedSet))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
