(module tests.fixtures.portable-value-host
  (import "node:url" pathToFileURL)
  (import "../../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst moduleUrl (pathToFileURL (aref (get globalThis.process :argv) 2)))
  (defvar valueModule undefined)
  (defvar identityTokenModule undefined)
  (defvar identifierModule undefined)
  (defvar listModule undefined)
  (defvar vectorModule undefined)
  (defvar mapModule undefined)
  (defvar setModule undefined)
  (defvar valueEqual undefined)
  (defvar valueHash undefined)
  (defvar valueMapFromEntries undefined)
  (defvar valueSetFromArray undefined)
  (defvar identityToken undefined)
  (defvar portableKeyword undefined)
  (defvar portableKeywordPredicate undefined)
  (defvar concretePortableKeywordPredicate undefined)
  (defvar concretePortableSymbolPredicate undefined)
  (defvar portableQualifiedName undefined)
  (defvar portableSymbol undefined)
  (defvar portableSymbolPredicate undefined)
  (defvar persistentListFromArray undefined)
  (defvar persistentVectorFromArray undefined)
  (defvar persistentMapCount undefined)
  (defvar persistentMapGet undefined)
  (defvar persistentSetCount undefined)
  (defvar persistentSetHas undefined)
  (defvar nestedLeft undefined)
  (defvar nestedRight undefined)
  (defvar listLeft undefined)
  (defvar listRight undefined)
  (defvar orderedMap undefined)
  (defvar reversedMap undefined)
  (defvar collisionMap undefined)
  (defvar orderedSet undefined)
  (defvar reversedSet undefined)
  (defvar leftHost undefined)
  (defvar rightHost undefined)
  (defvar hostFunction undefined)
  (defvar leftNativeSymbol undefined)
  (defvar rightNativeSymbol undefined)
  (defvar leftHostHash undefined)
  (defvar rightHostHash undefined)
  (defvar hostFunctionHash undefined)
  (defvar leftNativeSymbolHash undefined)
  (defvar rightNativeSymbolHash undefined)
  (defvar identityKeys undefined)
  (defvar identityEntries undefined)
  (defvar identityHashes undefined)
  (defvar identityHashesStable undefined)
  (defvar identityMap undefined)
  (defvar identitySet undefined)
  (defvar nativeSymbolMap undefined)
  (defvar tokenLeftObject undefined)
  (defvar tokenRightObject undefined)
  (defvar tokenFunction undefined)
  (defvar tokenLeftSymbol undefined)
  (defvar tokenRightSymbol undefined)
  (defvar tokenLeftObjectValue undefined)
  (defvar tokenFunctionValue undefined)
  (defvar tokenLeftSymbolValue undefined)
  (defvar invalidTokenScalar undefined)
  (defvar vectorLookup undefined)
  (defvar keywordTitle undefined)
  (defvar symbolTitle undefined)
  (defvar portableKeywordTitle undefined)
  (defvar portableSymbolTitle undefined)
  (defvar identifierMap undefined)
  (defvar identifierSet undefined)
  (defvar portableIdentifierSet undefined)
  (defasync run-host-main ()
    (setq valueModule (await (funcall load-module (get moduleUrl :href))))
    (setq identityTokenModule (await (funcall load-module (get (new globalThis.URL "./host-identity-token.mjs" moduleUrl) :href))))
    (setq identifierModule (await (funcall load-module (get (new globalThis.URL "./identifier.eli" moduleUrl) :href))))
    (setq listModule (await (funcall load-module (get (new globalThis.URL "./persistent-list.eli" moduleUrl) :href))))
    (setq vectorModule (await (funcall load-module (get (new globalThis.URL "./persistent-vector.eli" moduleUrl) :href))))
    (setq mapModule (await (funcall load-module (get (new globalThis.URL "./persistent-map.eli" moduleUrl) :href))))
    (setq setModule (await (funcall load-module (get (new globalThis.URL "./persistent-set.eli" moduleUrl) :href))))
    (setq valueEqual valueModule.value_equal_QMARK_)
    (setq valueHash valueModule.value_hash)
    (setq valueMapFromEntries valueModule.value_map_from_entries)
    (setq valueSetFromArray valueModule.value_set_from_array)
    (setq identityToken identityTokenModule.identity_token)
    (setq portableKeyword identifierModule.keyword)
    (setq portableKeywordPredicate identifierModule.keyword_QMARK_)
    (setq concretePortableKeywordPredicate identifierModule.portable_keyword_QMARK_)
    (setq concretePortableSymbolPredicate identifierModule.portable_symbol_QMARK_)
    (setq portableQualifiedName identifierModule.qualified_name)
    (setq portableSymbol identifierModule.symbol)
    (setq portableSymbolPredicate identifierModule.symbol_QMARK_)
    (setq persistentListFromArray listModule.persistent_list_from_array)
    (setq persistentVectorFromArray vectorModule.persistent_vector_from_array)
    (setq persistentMapCount mapModule.persistent_map_count)
    (setq persistentMapGet mapModule.persistent_map_get)
    (setq persistentSetCount setModule.persistent_set_count)
    (setq persistentSetHas setModule.persistent_set_has_QMARK_)
    (setq nestedLeft (persistentVectorFromArray (js-array nil undefined t 42 "eliscript" (persistentVectorFromArray (js-array "nested" globalThis.Number.NaN (js* "-0"))))))
    (setq nestedRight (persistentVectorFromArray (js-array nil undefined t 42 "eliscript" (persistentVectorFromArray (js-array "nested" globalThis.Number.NaN 0)))))
    (setq listLeft (persistentListFromArray (js-array 1 "two" nestedLeft)))
    (setq listRight (persistentListFromArray (js-array 1 "two" nestedRight)))
    (setq orderedMap (valueMapFromEntries (js-array (js-array "alpha" 1)
    (js-array (persistentVectorFromArray (js-array "key")) (persistentVectorFromArray (js-array 2 3))) (js-array "omega" globalThis.Number.NaN))))
    (setq reversedMap (valueMapFromEntries (js-array (js-array "omega" globalThis.Number.NaN)
    (js-array (persistentVectorFromArray (js-array "key")) (persistentVectorFromArray (js-array 2 3))) (js-array "alpha" 1))))
    (setq collisionMap (valueMapFromEntries (js-array (js-array "key-50691" "left") (js-array "key-194634" "right"))))
    (setq orderedSet (valueSetFromArray (js-array "alpha" (persistentVectorFromArray (js-array "key")) "omega")))
    (setq reversedSet (valueSetFromArray (js-array "omega" (persistentVectorFromArray (js-array "key")) "alpha")))
    (setq leftHost (js-object :value 1))
    (setq rightHost (js-object :value 1))
    (setq hostFunction (js* "() => 'host'"))
    (setq leftNativeSymbol (funcall globalThis.Symbol "identity"))
    (setq rightNativeSymbol (funcall globalThis.Symbol "identity"))
    (setq leftHostHash (valueHash leftHost))
    (setq rightHostHash (valueHash rightHost))
    (setq hostFunctionHash (valueHash hostFunction))
    (setq leftNativeSymbolHash (valueHash leftNativeSymbol))
    (setq rightNativeSymbolHash (valueHash rightNativeSymbol))
    (setq identityKeys (js-array))
    (setq identityEntries (js-array))
    (setq identityHashes (new globalThis.Set))
    (setq identityHashesStable t)
    (let ((index 0))
    (while (< index 20000)
      (let* ((key (Object/freeze (js-object :index index))) (hash (valueHash key)))
        (js-call identityKeys :push key) (js-call identityEntries :push (js-array key index)) (js-call identityHashes :add hash)
        (unless (= (valueHash key) hash) (setq identityHashesStable false))) (setq index (1+ index))))
    (setq identityMap (valueMapFromEntries identityEntries))
    (setq identitySet (valueSetFromArray identityKeys))
    (setq nativeSymbolMap (valueMapFromEntries (js-array (js-array leftNativeSymbol "left") (js-array rightNativeSymbol "right"))))
    (setq tokenLeftObject (js-object))
    (setq tokenRightObject (js-object))
    (setq tokenFunction (js* "() => null"))
    (setq tokenLeftSymbol (funcall globalThis.Symbol "token"))
    (setq tokenRightSymbol (funcall globalThis.Symbol "token"))
    (setq tokenLeftObjectValue (identityToken tokenLeftObject))
    (setq tokenFunctionValue (identityToken tokenFunction))
    (setq tokenLeftSymbolValue (identityToken tokenLeftSymbol))
    (setq invalidTokenScalar undefined)
    (try (identityToken 1) (catch error (setq invalidTokenScalar (js-object :name (get error :name) :message (get error :message)))))
    (setq vectorLookup (persistentMapGet orderedMap (persistentVectorFromArray (js-array "key")) "missing"))
    (setq keywordTitle (keyword "article/title"))
    (setq symbolTitle (eliscriptSymbol "article/title"))
    (setq portableKeywordTitle (portableKeyword "article/title"))
    (setq portableSymbolTitle (portableSymbol "article" "title"))
    (setq identifierMap (valueMapFromEntries (js-array (js-array keywordTitle "keyword") (js-array symbolTitle "symbol"))))
    (setq identifierSet (valueSetFromArray (js-array symbolTitle (eliscriptSymbol "article" "title") keywordTitle)))
    (setq portableIdentifierSet (valueSetFromArray (js-array keywordTitle portableKeywordTitle symbolTitle portableSymbolTitle)))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :scalars (js-object :null (valueHash nil) :undefined (valueHash undefined) :false (valueHash false) :true (valueHash t)
      :zero (valueHash 0) :negativeZero (valueHash (js* "-0")) :one (valueHash 1) :negativeOne (valueHash -1) :fraction (valueHash 1.5)
      :nan (valueHash globalThis.Number.NaN) :positiveInfinity (valueHash globalThis.Number.POSITIVE_INFINITY) :negativeInfinity (valueHash globalThis.Number.NEGATIVE_INFINITY)
      :maxSafeInteger (valueHash globalThis.Number.MAX_SAFE_INTEGER) :emptyString (valueHash "") :ascii (valueHash "Eliscript") :unicode (valueHash "值语义🙂"))
    :collections (js-object :vector (valueHash nestedLeft) :list (valueHash listLeft) :map (valueHash orderedMap) :set (valueHash orderedSet))
    :identifiers (js-object :keyword (valueHash keywordTitle) :unqualifiedKeyword (valueHash (keyword "title")) :symbol (valueHash symbolTitle)
      :unqualifiedSymbol (valueHash (eliscriptSymbol "title")) :portableKeyword (valueHash portableKeywordTitle) :portableSymbol (valueHash portableSymbolTitle))
    :invariants (js-object :nanEqual (valueEqual globalThis.Number.NaN globalThis.Number.NaN) :zerosEqual (valueEqual 0 (js* "-0"))
      :nestedEqual (valueEqual nestedLeft nestedRight) :nestedHashesEqual (= (valueHash nestedLeft) (valueHash nestedRight)) :listsEqual (valueEqual listLeft listRight)
      :listVectorDistinct (valueEqual listLeft nestedLeft) :mapsEqual (valueEqual orderedMap reversedMap) :mapHashesEqual (= (valueHash orderedMap) (valueHash reversedMap))
      :setsEqual (valueEqual orderedSet reversedSet) :setHashesEqual (= (valueHash orderedSet) (valueHash reversedSet)) :hostIdentity (valueEqual leftHost leftHost)
      :hostDistinct (valueEqual leftHost rightHost) :hostDistinctHashes (not (= leftHostHash rightHostHash)) :hostFunctionStable (= hostFunctionHash (valueHash hostFunction))
      :nativeSymbolStable (= leftNativeSymbolHash (valueHash leftNativeSymbol)) :nativeSymbolsDistinct (not (= leftNativeSymbolHash rightNativeSymbolHash))
      :nativeSymbolIdentityEqual (valueEqual leftNativeSymbol leftNativeSymbol) :nativeSymbolValuesDistinct (not (valueEqual leftNativeSymbol rightNativeSymbol))
      :symbolsEqual (valueEqual symbolTitle (eliscriptSymbol "article" "title")) :identifierCategoriesDistinct (not (valueEqual keywordTitle symbolTitle))
      :portableKeywordEqual (valueEqual keywordTitle portableKeywordTitle) :portableSymbolEqual (valueEqual symbolTitle portableSymbolTitle)
      :portableKeywordValid (and (portableKeywordPredicate portableKeywordTitle) (concretePortableKeywordPredicate portableKeywordTitle) (= (portableQualifiedName portableKeywordTitle) "article/title"))
      :portableSymbolValid (and (portableSymbolPredicate portableSymbolTitle) (concretePortableSymbolPredicate portableSymbolTitle) (= (portableQualifiedName portableSymbolTitle) "article/title"))
      :concretePortableOnly (and (not (concretePortableKeywordPredicate keywordTitle)) (not (concretePortableSymbolPredicate symbolTitle)))
      :invalidPortableIdentifier (and (= (portableKeyword "bad/name/again") nil) (= (portableSymbol "" "name") nil)
        (not (concretePortableKeywordPredicate (js-object :kind "eliscript/keyword" :namespace "bad/namespace" :name "title")))))
    :collision (js-object :leftHash (valueHash "key-50691") :rightHash (valueHash "key-194634") :keysEqual (valueEqual "key-50691" "key-194634")
      :count (persistentMapCount collisionMap) :left (persistentMapGet collisionMap "key-50691" "missing") :right (persistentMapGet collisionMap "key-194634" "missing"))
    :lookup (js-object :vectorKey (valueEqual vectorLookup (persistentVectorFromArray (js-array 2 3))) :vectorValueHash (valueHash vectorLookup)
      :setCount (persistentSetCount orderedSet) :equalVectorMember (persistentSetHas orderedSet (persistentVectorFromArray (js-array "key")))
      :keywordValue (persistentMapGet identifierMap (keyword "article" "title") "missing") :symbolValue (persistentMapGet identifierMap (eliscriptSymbol "article" "title") "missing")
      :identifierSetCount (persistentSetCount identifierSet) :equalSymbolMember (persistentSetHas identifierSet (eliscriptSymbol "article" "title"))
      :portableKeywordValue (persistentMapGet identifierMap portableKeywordTitle "missing") :portableSymbolValue (persistentMapGet identifierMap portableSymbolTitle "missing")
      :portableIdentifierSetCount (persistentSetCount portableIdentifierSet) :nativeSymbolMapCount (persistentMapCount nativeSymbolMap)
      :nativeSymbolLeft (persistentMapGet nativeSymbolMap leftNativeSymbol "missing") :nativeSymbolRight (persistentMapGet nativeSymbolMap rightNativeSymbol "missing"))
    :hostIdentityScale (js-object :count (js-length identityKeys) :uniqueHashes (get identityHashes :size) :stable identityHashesStable
      :mapCount (persistentMapCount identityMap) :mapLast (persistentMapGet identityMap (js-call identityKeys :at -1) "missing")
      :setCount (persistentSetCount identitySet) :setLast (persistentSetHas identitySet (js-call identityKeys :at -1)))
    :identityToken (js-object :objectStable (= tokenLeftObjectValue (identityToken tokenLeftObject)) :objectsDistinct (not (= tokenLeftObjectValue (identityToken tokenRightObject)))
      :functionStable (= tokenFunctionValue (identityToken tokenFunction)) :symbolStable (= tokenLeftSymbolValue (identityToken tokenLeftSymbol))
      :symbolsDistinct (not (= tokenLeftSymbolValue (identityToken tokenRightSymbol))) :invalidScalar invalidTokenScalar)))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
