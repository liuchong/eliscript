(module tests.fixtures.platform-capabilities
  (import "../../platform/browser.mjs" browserCapabilities browserCapabilityDescriptor browserFetch browserNow)
  (import "../../platform/worker.mjs" workerCapabilities workerCapabilityDescriptor workerProgress)
  (defconst browser (browserCapabilities (js-object :fetch (lambda (input) (js-object :ok t :input input))
    :performance (js-object :now (lambda () 42.5))) (js-array "network" "clock")))
  (defconst progress (js-array))
  (defconst worker (workerCapabilities (js-object :signal (get (new globalThis.AbortController) :signal)
    :progress (lambda (value) (js-call progress :push value) (js-length progress))) (js-array "progress" "cancellation")))
  (workerProgress worker "indexed")
  (defasync run-host-main ()
    (js-call globalThis.console :log (JSON/stringify (js-object :browser (browserCapabilityDescriptor browser)
    :fetch (await (browserFetch browser "/articles")) :now (browserNow browser) :worker (workerCapabilityDescriptor worker) :progress progress))))
  (run-host-main)
)
