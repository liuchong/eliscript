(module managed.variadic.calls
  (defun mixed (a &optional b &rest tail) (js-array a b tail))
  (defun optional-one (&optional x) x)
  (defun pack (&rest values) values)
  (defun mixed-value () mixed)
  (defun pack-value () pack)
  (defun apply-values (f values) (apply f values))
  (defun call-none (f) (f))
  (defun call-three (f a b c) (funcall f a b c))
  (defun source-calls ()
    (js-array (mixed) (mixed 1) (mixed 1 undefined 2 false)
      (mixed 1 nil) (pack) (pack 1 undefined -0.0)))
  (defun make-capture (&optional initial &rest seed)
    (lambda (&optional next &rest extra)
      (let ((result (js-array initial next seed extra))) (setq initial next) result)))
  (defun call-capture (f &optional x &rest tail)
    (funcall f x tail))
  (defun fresh-rest () (eq (pack) (pack)))
  (defun rest-snapshots (items)
    (let ((f (lambda (&rest values) (put items 0 99) values)))
      (f (aref items 0) (put items 0 7))))
  (defun apply-callee-order (values)
    (let ((f (lambda (&rest ignored) 1)))
      (apply f (progn (setq f (lambda (&rest ignored) 2)) values))))
  (defun values-iterator (items) (js-call items :values))
  (defun iterator-done (iterator) (get (js-call iterator :next) :done))
  (defun as-set (items) (new globalThis.Set items))
  (defun as-map (items) (new globalThis.Map items))
  (defun first-error (f marker)
    (apply f (progn (false) (put marker 0 99) (js-array))))
  (export mixed optional-one pack mixed-value pack-value apply-values call-none call-three
    source-calls make-capture call-capture fresh-rest rest-snapshots apply-callee-order
    values-iterator iterator-done as-set as-map first-error))
