(module managed.word
  (defun remainder (a b) (% a b))
  (defun modulo (a b) (mod a b))
  (defun remainder-many (a b c) (% a b c))
  (defun signed (a) (int32 a))
  (defun unsigned (a) (uint32 a))
  (defun invert (a) (bit-not a))
  (defun mask (a b) (bit-and a b))
  (defun union (a b) (bit-or a b))
  (defun exclusive (a b) (bit-xor a b))
  (defun shift-left (a b) (bit-shift-left a b))
  (defun shift-right (a b) (bit-shift-right a b))
  (defun logical-right (a b) (unsigned-bit-shift-right a b))
  (defun multiply (a b) (imul32 a b))
  (defun snapshot (a b) (bit-xor a (setq a b)))
  (defun remainder-snapshot (a b) (% a (setq a b)))
  (defun loop-mix (n seed) (let ((i 0) (x seed))
    (while (< i n) (setq x (bit-xor (imul32 x 1664525) (uint32 i))) (setq i (1+ i))) x))
  (export remainder modulo remainder-many signed unsigned invert mask union exclusive
    shift-left shift-right logical-right multiply snapshot remainder-snapshot loop-mix))
