(module managed.transient-state-fixture
  (import "./stdlib/managed-transient-state.eli"
    managed-transient-vector-new managed-transient-vector-conj managed-transient-vector-assoc
    managed-transient-vector-persistent managed-transient-map-new managed-transient-map-assoc
    managed-transient-map-dissoc managed-transient-map-persistent managed-transient-set-new
    managed-transient-set-conj managed-transient-set-disj managed-transient-set-persistent)
  (import "./stdlib/persistent-vector.eli"
    persistent-vector-from-array persistent-vector-to-array persistent-vector-nth
    persistent-vector-count persistent-vector-with-meta)
  (import "./stdlib/persistent-map.eli"
    empty-persistent-map persistent-map-assoc persistent-map-get persistent-map-count
    persistent-map-has? persistent-map-with-meta)
  (import "./stdlib/persistent-set.eli"
    persistent-set-count persistent-set-has? persistent-set-with-meta)
  (import "./stdlib/value.eli" value-hash value-equal? value-map-from-entries value-set-from-array)

  (defun sequence-values (count)
    (let ((values (js-array)) (index 0))
      (while (< index count) (js-call values :push index) (setq index (1+ index))) values))
  (defun metadata-value () (value-map-from-entries (js-array (js-array "tag" 17))))
  (defun caught-report (callback)
    (try (funcall callback) (catch error (js-array (get error :name) (get error :message)))))

  (defun vector-case (count)
    (let* ((metadata (metadata-value))
           (source (persistent-vector-with-meta (persistent-vector-from-array (sequence-values count)) metadata))
           (state (managed-transient-vector-new source))
           (noop (managed-transient-vector-new source))
           (shared (and (Object/is (get state :root) (get source :root))
                        (Object/is (get state :tail) (get source :tail)))))
      (managed-transient-vector-conj state count)
      (managed-transient-vector-conj state (1+ count))
      (managed-transient-vector-assoc state (+ count 2) (+ count 2))
      (managed-transient-vector-assoc state 0 -2)
      (let ((result (managed-transient-vector-persistent state)))
        (js-array (persistent-vector-to-array source) (persistent-vector-to-array result)
          shared (Object/is (managed-transient-vector-persistent noop) source)
          (Object/is metadata (get result :metadata)) (persistent-map-get (get result :metadata) "tag" nil)
          (get state :active) (Object/is (get state :owner) nil)
          (caught-report (lambda () (managed-transient-vector-conj state 9)))
          (caught-report (lambda () (managed-transient-vector-assoc state 0 9)))
          (caught-report (lambda () (managed-transient-vector-persistent state)))))))

  (defun vector-ownership ()
    (let* ((source (persistent-vector-from-array (sequence-values 97)))
           (state (managed-transient-vector-new source)) (original-tail (get source :tail))
           (original-root (get source :root)) (sibling (get (get original-root :slots) 1)))
      (managed-transient-vector-conj state 97)
      (let ((owned-tail (get state :tail)))
        (managed-transient-vector-conj state 98)
        (let ((tail-reused (Object/is owned-tail (get state :tail))))
          (managed-transient-vector-assoc state 0 100)
          (let* ((owned-root (get state :root)) (owned-leaf (get (get owned-root :slots) 0)))
            (managed-transient-vector-assoc state 1 101)
            (let* ((root-reused (Object/is owned-root (get state :root)))
                   (leaf-reused (Object/is owned-leaf (get (get (get state :root) :slots) 0)))
                   (result (managed-transient-vector-persistent state))
                   (second (managed-transient-vector-new result)))
              (managed-transient-vector-assoc second 0 200)
              (let ((next (managed-transient-vector-persistent second)))
                (js-array (not (Object/is original-tail owned-tail)) tail-reused
                  (not (Object/is original-root owned-root)) root-reused leaf-reused
                  (Object/is sibling (get (get owned-root :slots) 1))
                  (not (Object/is (get next :root) (get result :root)))
                  (persistent-vector-nth source 0 nil) (persistent-vector-nth source 1 nil)
                  (persistent-vector-nth result 0 nil) (persistent-vector-nth result 1 nil)
                  (persistent-vector-nth next 0 nil) (js-length original-tail)
                  (persistent-vector-nth source 96 nil) (persistent-vector-nth result 98 nil)))))))))

  (defun key (id hash) (js-object :id id :hash hash))
  (defun key-hash (key) (get key :hash))
  (defun key-equal (left right) (= (get left :id) (get right :id)))
  (defun map-branches ()
    (let* ((metadata (metadata-value))
           (empty (empty-persistent-map key-hash key-equal value-equal?))
           (source empty) (index 0))
      (while (< index 32)
        (setq source (persistent-map-assoc source (key index index) index) index (1+ index)))
      (setq source (persistent-map-with-meta source metadata))
      (let* ((state (managed-transient-map-new source)) (original-root (get source :root))
             (noop (managed-transient-map-new source)))
        (managed-transient-map-assoc noop (key 0 0) 0)
        (managed-transient-map-dissoc noop (key 100 100))
        (managed-transient-map-assoc state (key 0 0) 100)
        (let ((owned (get state :root)))
          (managed-transient-map-assoc state (key 1 1) 101)
          (let* ((reused (Object/is owned (get state :root)))
                 (snapshot (managed-transient-map-persistent state))
                 (builder (managed-transient-map-new empty)))
            (managed-transient-map-dissoc builder (key 0 0))
            (setq index 0)
            (while (< index 32)
              (managed-transient-map-assoc builder (key index index) index) (setq index (1+ index)))
            (let ((promoted (= (get (get builder :root) :kind) "array")))
              (setq index 31)
              (while (>= index 24) (managed-transient-map-dissoc builder (key index index)) (setq index (1- index)))
              (let* ((packed (get builder :root)) (demoted (= (get packed :kind) "bitmap")))
                (managed-transient-map-dissoc builder (key 23 23))
                (let ((packed-reused (Object/is packed (get builder :root))))
                  (setq index 22)
                  (while (>= index 0) (managed-transient-map-dissoc builder (key index index)) (setq index (1- index)))
                  (let ((cleared (managed-transient-map-persistent builder)))
                    (js-array promoted demoted packed-reused reused
                      (not (Object/is original-root owned))
                      (Object/is (managed-transient-map-persistent noop) source)
                      (persistent-map-count source) (persistent-map-get source (key 0 0) nil)
                      (persistent-map-count snapshot) (persistent-map-get snapshot (key 0 0) nil)
                      (persistent-map-get snapshot (key 1 1) nil)
                      (Object/is metadata (get snapshot :metadata))
                      (persistent-map-get (get snapshot :metadata) "tag" nil)
                      (persistent-map-count cleared) (persistent-map-has? cleared (key 0 0))
                      (caught-report (lambda () (managed-transient-map-assoc state (key 9 9) 9)))
                      (caught-report (lambda () (managed-transient-map-dissoc state (key 9 9))))
                      (caught-report (lambda () (managed-transient-map-persistent state)))))))))))))

  (defun collisions ()
    (let* ((source (empty-persistent-map key-hash key-equal value-equal?)) (index 0))
      (while (< index 4)
        (setq source (persistent-map-assoc source (key index 42) index) index (1+ index)))
      (let* ((state (managed-transient-map-new source)) (original-root (get source :root)))
        (managed-transient-map-assoc state (key 0 42) 100)
        (let ((owned-root (get state :root)))
          (managed-transient-map-assoc state (key 1 42) 101)
          (managed-transient-map-assoc state (key 4 42) 104)
          (let ((reused (Object/is owned-root (get state :root))))
            (managed-transient-map-dissoc state (key 2 42))
            (managed-transient-map-dissoc state (key 99 42))
            (managed-transient-map-dissoc state (key 99 7))
            (managed-transient-map-assoc state (key 9 1066) 109)
            (managed-transient-map-dissoc state (key 9 1066))
            (managed-transient-map-dissoc state (key 4 42))
            (managed-transient-map-dissoc state (key 3 42))
            (managed-transient-map-dissoc state (key 1 42))
            (let ((result (managed-transient-map-persistent state)))
              (js-array (not (Object/is original-root owned-root)) reused
                (persistent-map-count source) (persistent-map-get source (key 0 42) nil)
                (persistent-map-count result) (persistent-map-get result (key 0 42) nil)
                (persistent-map-get result (key 1 42) nil) (persistent-map-has? result (key 2 42)))))))))
  (defun real-collision ()
    (let* ((left "key-50691") (right "key-194634")
           (source (value-map-from-entries (js-array (js-array left "left") (js-array right "right"))))
           (state (managed-transient-map-new source)))
      (managed-transient-map-assoc state left "changed")
      (managed-transient-map-dissoc state right)
      (managed-transient-map-assoc state right "again")
      (let ((result (managed-transient-map-persistent state)))
        (js-array (= (value-hash left) (value-hash right))
          (persistent-map-count source) (persistent-map-get source left nil) (persistent-map-get source right nil)
          (persistent-map-count result) (persistent-map-get result left nil) (persistent-map-get result right nil)))))

  (defun set-case ()
    (let* ((left (persistent-vector-from-array (js-array 1 2)))
           (right (persistent-vector-from-array (js-array 1 2)))
           (metadata (metadata-value))
           (source (persistent-set-with-meta (value-set-from-array (js-array left (/ 0 0) -0.0)) metadata))
           (noop (managed-transient-set-new source)) (state (managed-transient-set-new source)))
      (managed-transient-set-conj noop right) (managed-transient-set-conj noop (/ 0 0))
      (managed-transient-set-conj noop 0) (managed-transient-set-disj noop "absent")
      (managed-transient-set-conj state "new") (managed-transient-set-disj state right)
      (let ((result (managed-transient-set-persistent state)))
        (js-array (Object/is (managed-transient-set-persistent noop) source)
          (persistent-set-count source) (persistent-set-has? source right)
          (persistent-set-count result) (persistent-set-has? result left) (persistent-set-has? result "new")
          (persistent-set-has? result (/ 0 0)) (persistent-set-has? result 0)
          (Object/is (get result :metadata) metadata)
          (persistent-map-get (get result :metadata) "tag" nil)
          (caught-report (lambda () (managed-transient-set-conj state 9)))
          (caught-report (lambda () (managed-transient-set-disj state 9)))
          (caught-report (lambda () (managed-transient-set-persistent state)))))))

  (defun callback-order (mode)
    (let* ((trace (js-array)) (marker (js-object)) (armed false)
           (hash (lambda (key) (when armed (js-call trace :push "hash") (when (= mode 0) (throw marker))) 13))
           (equal-key (lambda (left right)
             (when armed (js-call trace :push "key") (when (= mode 1) (throw marker)))
             (= (get left :id) (get right :id))))
           (equal-value (lambda (left right)
             (when armed (js-call trace :push "value") (when (= mode 2) (throw marker)))
             (= (get left :label) (get right :label))))
           (source (persistent-map-assoc (empty-persistent-map hash equal-key equal-value)
                     (key 1 13) (js-object :label "old")))
           (state (managed-transient-map-new source)) (caught false))
      (setq armed t)
      (try (managed-transient-map-assoc state (key 1 13) (js-object :label "new"))
        (catch error (setq caught (Object/is error marker))))
      (setq armed false)
      (let ((result (managed-transient-map-persistent state)))
        (js-array trace caught (Object/is result source) (persistent-map-count result)
          (get (persistent-map-get result (key 1 13) nil) :label)))))
  (defun index-errors ()
    (let* ((state (managed-transient-vector-new (persistent-vector-from-array (js-array 1))))
           (trace (js-array))
           (index (js-object :toString (lambda () (js-call trace :push "string") (throw "format"))))
           (values (js-array -1 0.5 (/ 0 0) (/ 1 0) "0" 2 undefined nil)) (out (js-array)))
      (let ((position 0))
        (while (< position (js-length values))
          (let ((wanted (get values position)))
            (js-call out :push (caught-report (lambda () (managed-transient-vector-assoc state wanted 9)))))
          (setq position (1+ position))))
      (js-call out :push (try (managed-transient-vector-assoc state index 9) (catch error error)))
      (managed-transient-vector-persistent state)
      (js-call out :push (caught-report (lambda () (managed-transient-vector-assoc state index 9))) trace)
      out))
  (defun vector-limit ()
    (let ((state (managed-transient-vector-new (persistent-vector-from-array (js-array 7)))))
      ;; Internal state injection reaches the specified limit without allocating
      ;; a huge collection or changing the runtime's configured resources.
      (put state :count 2147483647)
      (js-array (caught-report (lambda () (managed-transient-vector-conj state 9)))
        (get state :count) (get state :changed) (get state :active)
        (persistent-vector-nth (get state :source) 0 nil))))
  (defun invalid-sources ()
    (js-array
      (caught-report (lambda () (managed-transient-vector-new nil)))
      (caught-report (lambda () (managed-transient-map-new nil)))
      (caught-report (lambda () (managed-transient-set-new nil)))))
  (defun held-state ()
    (managed-transient-vector-new
      (persistent-vector-with-meta (persistent-vector-from-array (sequence-values 65)) (metadata-value))))
  (defun held-step (state index value)
    (managed-transient-vector-assoc state index value) state)
  (defun held-finish (state)
    (let ((result (managed-transient-vector-persistent state)))
      (js-array (persistent-vector-to-array (get state :source)) (persistent-vector-to-array result)
        (persistent-map-get (get result :metadata) "tag" nil))))
  (export vector-case vector-ownership map-branches collisions real-collision set-case callback-order
    index-errors vector-limit invalid-sources held-state held-step held-finish))
