(module tests.fixtures.portable-map-host
  (import "node:url" pathToFileURL)
  (import "node:path" resolve)
  (import "../helpers/portable-structure.mjs" integerHash)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar mapModule undefined)
  (defvar emptyPersistentMap undefined)
  (defvar isPersistentMap undefined)
  (defvar persistentMapCount undefined)
  (defvar persistentMapHas undefined)
  (defvar persistentMapGet undefined)
  (defvar persistentMapAssoc undefined)
  (defvar persistentMapDissoc undefined)
  (defvar persistentMapReduce undefined)
  (defvar persistentMapToEntries undefined)
  (defvar persistentMapFromEntries undefined)
  (defvar equal undefined)
  (defvar map undefined)
  (defvar updated undefined)
  (defvar removed undefined)
  (defvar collision undefined)
  (defvar sample undefined)
  (defasync run-host-main ()
    (setq mapModule (await (funcall load-module (get (pathToFileURL (resolve (aref (get globalThis.process :argv) 2))) :href))))
    (setq emptyPersistentMap mapModule.empty_persistent_map)
    (setq isPersistentMap mapModule.persistent_map_QMARK_)
    (setq persistentMapCount mapModule.persistent_map_count)
    (setq persistentMapHas mapModule.persistent_map_has_QMARK_)
    (setq persistentMapGet mapModule.persistent_map_get)
    (setq persistentMapAssoc mapModule.persistent_map_assoc)
    (setq persistentMapDissoc mapModule.persistent_map_dissoc)
    (setq persistentMapReduce mapModule.persistent_map_reduce)
    (setq persistentMapToEntries mapModule.persistent_map_to_entries)
    (setq persistentMapFromEntries mapModule.persistent_map_from_entries)
    (setq equal (lambda (left right) (= left right)))
    (setq map (emptyPersistentMap integerHash equal equal))
    (let ((key 0)) (while (< key 100000) (setq map (persistentMapAssoc map key (* key 3)) key (1+ key))))
    (setq updated (persistentMapAssoc map 54321 "updated"))
    (setq removed (persistentMapDissoc updated 75000))
    (setq collision (emptyPersistentMap (lambda () 7) equal equal))
    (let ((key 0)) (while (< key 100) (setq collision (persistentMapAssoc collision (str "collision-" key) key) key (1+ key))))
    (setq collision (persistentMapDissoc collision "collision-50"))
    (setq sample (persistentMapFromEntries integerHash equal equal (js-array (js-array 3 "c") (js-array 1 "a") (js-array 2 "b"))))
    (js-call (get globalThis.process :stdout) :write (str (JSON/stringify (js-object
    :persistent (isPersistentMap map) :count (persistentMapCount map) :rootKind (get (get map :root) :kind)
    :probes (js-call (js-array 0 31 32 1024 32768 99999) :map (lambda (key) (persistentMapGet map key "missing")))
    :original (persistentMapGet map 54321 "missing") :updated (persistentMapGet updated 54321 "missing") :removed (persistentMapHas removed 75000)
    :sum (persistentMapReduce (lambda (total ignored value) (+ total value)) 0 map)
    :noopAssoc (= (persistentMapAssoc map 54321 162963) map) :noopDissoc (= (persistentMapDissoc map -1) map)
    :collision (js-object :count (persistentMapCount collision) :kind (get (get collision :root) :kind)
      :removed (persistentMapHas collision "collision-50") :retained (persistentMapGet collision "collision-99" "missing"))
    :sample (js-call (persistentMapToEntries sample) :sort (lambda (left right) (- (aref left 0) (aref right 0)))))) "\n")))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
