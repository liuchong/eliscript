(module managed.type-construction
  (import "eliscript/runtime/core/type.mjs" :as Type)
  (import "eliscript/runtime/core/protocol.mjs" :as Protocol)
  (defun typeconstruction (stage)
    (let* ((protocol (Protocol/defineProtocol "Construction" (js-array "describe" "measure")))
           (implementations (js-object :describe (lambda (self prefix) prefix)
                                      :measure (lambda (self amount) amount)))
           (plans (js-array (js-array protocol implementations))))
      (cond
        ((= stage 0) (Type/normalize-name "Box"))
        ((= stage 1) (Type/normalize-fields (js-array "value")))
        ((= stage 2)
          (let ((shape (Type/protocol-shape protocol)))
            (js-array (get shape :name) (js-length (get shape :operations)))))
        ((= stage 3)
          (let ((plan (Type/normalize-methods protocol implementations)))
            (js-array (get plan :name) (js-length (get plan :methods))
              (Object/is (get (get (get plan :methods) 0) :implementation) (get implementations :describe)))))
        ((= stage 4)
          (let ((normalized (Type/normalize-plans plans t)))
            (js-array (js-length normalized) (Object/isFrozen normalized))))
        ((= stage 5)
          (let ((type (Type/defineType "NoPlans" (js-array "value"))))
            (js-array (get type :name) (Object/isFrozen type) (Object/isFrozen (get type :prototype)))))
        ((= stage 6)
          (let ((type (Type/defineType "Box" (js-array "value") plans)))
            (js-array (get type :name) (Object/isFrozen type) (Object/isFrozen (get type :prototype)))))
        ((= stage 7)
          (let ((value (Type/reifyProtocols plans)))
            (js-array (Object/isFrozen value) (Object/is (Object/getPrototypeOf value) nil))))
        ((= stage 8)
          (let ((method (Type/method (lambda (self) self) "get" 0)))
            (js-array (get method :name) (get method :length) (Object/hasOwn method "prototype"))))
        (t
          (let* ((target (Object/create nil))
                 (normalized (Type/normalize-plans plans t))
                 (_ (Type/install-protocol-methods target normalized))
                 (slot (Protocol/protocolSlot protocol "describe"))
                 (method (get target slot))
                 (descriptor (Object/getOwnPropertyDescriptor target slot))
                 (instance (Reflect/construct method (js-array "new"))))
            (js-array (js-call method :call target "called") (Object/hasOwn method "prototype")
              (Object/is (Object/getPrototypeOf instance) (get method :prototype))
              (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable)))))))
  (defun protocolwrapper ()
    (let* ((protocol (Protocol/defineProtocol "FirstWrapper" (js-array "describe")))
           (plans (Type/normalize-plans (js-array (js-array protocol
             (js-object :describe (lambda (self prefix) prefix)))) t))
           (target (Object/create nil)))
      (Type/install-protocol-methods target plans)
      (get target (Protocol/protocolSlot protocol "describe"))))
  (defun inspectwrapper (method)
    (let ((instance (Reflect/construct method (js-array "new"))))
      (js-array (js-call method :call (js-object) "called") (Object/hasOwn method "prototype")
        (Object/is (Object/getPrototypeOf instance) (get method :prototype)))))
  (export typeconstruction protocolwrapper inspectwrapper))
