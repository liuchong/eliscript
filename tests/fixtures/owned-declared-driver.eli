(module tests.fixtures.owned-declared-driver
  (import "__OWNED_SESSION_MODULE__" encodeCompilerIR)
  (defconst observations (js-object :owned 0 :wire 0 :closed 0))
  (defconst productJSON "__OWNED_PRODUCT_DATA__")
  (defun fresh (target)
    (let* ((value (JSON/parse productJSON)) (fn (aref (get (get value :typed) :functions) 0)) (span (get (get fn :source) :span)))
      (js-call (get (get fn :source) :children) :push (aref (get (get fn :source) :children) 0))
      (put (get fn :body) :span span) (put (aref (get (get value :debug) :ranges) 0) :span span) (put (aref (get (get value :debug) :functions) 0) :span span)
      (when (= target "wasm") (put value :target "wasm") (Reflect/deleteProperty value "typed") (Reflect/deleteProperty value "nativeTarget") (Reflect/deleteProperty value "nativeFormat"))
      value))
  (defun compiler_session_new () (js-object))
  (defun compiler_session_close () (put observations :closed (+ (get observations :closed) 1)) t)
  (defun compiler_session_request (state text)
    (let ((request (JSON/parse text)))
      (cond ((= (get request :operation) "runtime") (encodeCompilerIR (js-object :revision 1)))
        ((= (get request :operation) "capabilities") (encodeCompilerIR (js-object :format "eliscript-compiler-capabilities" :version 1 :responseModes (js-array "events-v1" "graph-events-v1"))))
        ((= (get request :operation) "project")
          (put observations :wire (+ (get observations :wire) 1))
          (unless (= (get request :responseMode) undefined) (throw (new globalThis.Error "verified build incorrectly entered graph response transport")))
          (encodeCompilerIR (fresh (get request :target))))
        (t (throw (new globalThis.Error "unexpected declared fixture request"))))))
  (defun compiler_session_project_owned (wire state text)
    (if (not (= wire compiler_session_request)) nil
      (let ((request (JSON/parse text)))
        (if (or (not (= (get request :operation) "project")) (not (js-call (js-array "wasm" "native") :includes (get request :target))) (Object/hasOwn request "responseMode")) nil
          (progn (put observations :owned (+ (get observations :owned) 1))
            (js-object :format "eliscript-compiler-owned-project" :version 1 :value (fresh (get request :target))))))))
  (export observations compiler_session_new compiler_session_close compiler_session_request compiler_session_project_owned))
