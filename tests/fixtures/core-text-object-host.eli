(module tests.fixtures.core-text-object-host
  (import "node:url" pathToFileURL)
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/vector.mjs" persistentVector)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-type (js* "(value) => typeof value"))
  (defconst textModule (aref (get globalThis.process :argv) 2))
  (defconst objectModule (aref (get globalThis.process :argv) 3))
  (when (or (= textModule undefined) (= objectModule undefined)) (throw (new globalThis.TypeError "core text/object host requires two module paths")))
  (defvar Text undefined)
  (defvar ObjectCore undefined)
  (defun pick-export (module primary fallback)
    (let ((value (get module primary))) (if (nullish? value) (get module fallback) value)))
  (defvar text undefined)
  (defvar objectCore undefined)
  (defvar source undefined)
  (defvar associated undefined)
  (defvar valueKey undefined)
  (defvar persistent undefined)
  (defun sortedEntries (value) (js-call (Array/from value) :sort (lambda (left right)
    (js-call (funcall globalThis.String (aref left 0)) :localeCompare (funcall globalThis.String (aref right 0))))))
  (defasync run-host-main ()
    (setq Text (await (funcall load-module (get (pathToFileURL textModule) :href))))
    (setq ObjectCore (await (funcall load-module (get (pathToFileURL objectModule) :href))))
    (setq text (js-object :blank (pick-export Text "blank" "blank_QMARK_") :contains (pick-export Text "contains" "contains_QMARK_")
    :empty (pick-export Text "empty" "empty_QMARK_") :endsWith (pick-export Text "endsWith" "ends_with_QMARK_") :join (get Text :join)
    :repeat (get Text :repeat) :slice (get Text :slice) :startsAt (pick-export Text "startsAt" "starts_at_QMARK_") :stripPrefix (pick-export Text "stripPrefix" "strip_prefix") :trim (get Text :trim)))
    (setq objectCore (js-object :assoc (get ObjectCore :assoc) :dissoc (get ObjectCore :dissoc) :filterValues (pick-export ObjectCore "filterValues" "filter_values")
    :has (pick-export ObjectCore "has" "has_QMARK_") :keyIn (pick-export ObjectCore "keyIn" "key_in_QMARK_") :keys (get ObjectCore :keys)
    :mapValues (pick-export ObjectCore "mapValues" "map_values") :merge (get ObjectCore :merge) :omit (get ObjectCore :omit) :pick (get ObjectCore :pick) :update (get ObjectCore :update)))
    (setq source (js-object :zero 0 :right 2 :absent undefined))
    (setq associated (js-call objectCore :assoc source "next" 3 "__proto__" 7))
    (setq valueKey (persistentVector "same"))
    (setq persistent (persistentHashMap (js-array (persistentVector "same") 1) (js-array "right" 2)))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :text (js-object :empty (js-call text :empty "") :slice (js-call text :slice 0 3 "A😀") :surrogate (js-call (js-call text :slice 1 2 "A😀") :charCodeAt 0)
      :starts (js-call text :startsAt "😀" 1 "A😀") :ends (js-call text :endsWith "😀" "A😀") :contains (js-call text :contains "😀" "A😀B")
      :stripped (js-call text :stripPrefix "#" "#article") :trimmed (js-call text :trim " \tEliscript\n") :blank (js-call text :blank " \r\n")
      :joined (js-call text :join "/" (new globalThis.Set (js-array "a" 2 false))) :repeated (js-call text :repeat 3 "ab"))
    :object (js-object :keys (Array/from (js-call objectCore :keys source)) :sourceUnchanged (and (= (js-length (Object/keys source)) 3) (not (Object/hasOwn source "next")))
      :associated (js-array (get associated :zero) (get associated :right) (get associated :next))
      :safePrototype (and (= (Object/getPrototypeOf associated) globalThis.Object.prototype) (Object/hasOwn associated "__proto__") (= (get associated :__proto__) 7))
      :missingPreserved (and (js-call objectCore :has source "absent") (= (get (js-call objectCore :pick source (js-array "absent")) :absent) undefined))
      :dissociated (js-call objectCore :dissoc source "right") :absentIdentity (= (js-call objectCore :dissoc source "missing") source)
      :merged (js-call objectCore :merge source (js-object :right 9 :extra 4))
      :mapped (js-call objectCore :mapValues (lambda (value) (if (nullish? value) "nil" value)) source)
      :filtered (js-call objectCore :filterValues (lambda (value) (if (= value 0) 0 (and (= (funcall host-type value) "number") (> value 1)))) source)
      :picked (js-call objectCore :pick source (js-array "absent" "zero" "missing")) :omitted (js-call objectCore :omit source (js-array "right"))
      :updated (js-call objectCore :update source "right" (lambda (value) (+ value 5))) :valueKey (js-call objectCore :keyIn valueKey (js-array (persistentVector "same")))
      :persistent (js-call (sortedEntries (js-call objectCore :mapValues (lambda (value) (+ value 10)) persistent)) :map
        (lambda (entry) (js-array (funcall globalThis.String (aref entry 0)) (aref entry 1)))))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
