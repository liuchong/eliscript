(module tests.fixtures.core-stdlib-api-host
  (import "node:process" :default process)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "../../runtime/core/queue.mjs" persistentQueue)
  (defasync load (root relative) (funcall (js* "(url) => import(url)") (get (pathToFileURL (resolve root relative)) :href)))
  (defun check (condition) (unless condition (js-call process :exit 1)))
  (defun jsonEqual (actual text) (check (= (JSON/stringify actual) text)))
  (defun arr (value) (Array/from value))
  (defun rows (value) (js-call (arr value) :map arr))
  (defasync main ()
    (let* ((root (aref (get process :argv) 2))
           (api (await (load root "core-language-api-usage.mjs"))) (seq (await (load root "stdlib/core/seq.mjs")))
           (identifier (await (load root "stdlib/core/identifier.mjs"))) (metadata (await (load root "stdlib/core/metadata.mjs"))) (collection (await (load root "stdlib/core/collection.mjs")))
           (report (get api :report)))
      (check (js-call collection :queue_QMARK_ (persistentQueue 1 2 3))) (check (not (js-call collection :queue_QMARK_ (js-array 1 2 3))))
      (check (= (get report "number-description") "number:7"))
      (check (and (get report "vector-counted") (get report "vector-indexed")))
      (check (and (get report "vector-collection") (get report "vector-vector")))
      (check (and (get report "vector-sequential") (not (get report "vector-sequence"))))
      (check (and (get report "list-list") (get report "list-sequence")))
      (check (and (get report "map-map") (get report "set-set")))
      (check (not (get report "native-array-collection")))
      (check (= (get report "bounded-vector-count") 2))
      (check (and (get report "distinct-scalars") (not (get report "distinct-vectors"))))
      (jsonEqual (arr (get report "vector-slice")) "[2,3]") (jsonEqual (arr (get report "vector-slice-bounded")) "[2,3]")
      (check (and (get report "empty-vector-empty") (get report "non-empty-vector-same")))
      (check (and (get report "map-associative") (not (get report "map-indexed"))))
      (jsonEqual (arr (get report "vector-appended")) "[1,2,3,4]")
      (jsonEqual (arr (js-call seq :map (lambda (value) (* value 3)) (js-array 1 2 3))) "[3,6,9]")
      (jsonEqual (rows (get report "stateful-transformed")) "[[2,2],[3,4]]")
      (jsonEqual (arr (get report :flattened)) "[1,10,2,20]")
      (jsonEqual (rows (get report :sampled)) "[[0,5],[3,7]]")
      (jsonEqual (rows (get report :partitioned)) "[[1,2],[3]]")
      (check (= (funcall globalThis.String (js-call identifier :keyword "article/title")) ":article/title"))
      (check (= (js-call metadata :meta (get report "vector-appended")) nil))))
  (main))
