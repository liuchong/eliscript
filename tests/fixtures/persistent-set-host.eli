(module tests.fixtures.persistent-set-host
  (import "../../runtime/core/set.mjs" EMPTY_SET persistentHashSet)
  (import "../../runtime/testing/set.mjs" inspectPersistentSet persistentSetMetrics resetPersistentSetMetrics sharedPersistentSetNodes)
  (import "../../runtime/core/value.mjs" equalValues hashValue)
  (import "../../runtime/core/vector.mjs" persistentVector)
  (defvar values EMPTY_SET)
  (let ((value 0)) (while (< value 100000) (setq values (js-call values :conj value) value (1+ value))))
  (defconst shape (inspectPersistentSet values)) (resetPersistentSetMetrics)
  (defconst updated (js-call values :disj 54321)) (defconst metrics (persistentSetMetrics))
  (defconst collision (persistentHashSet "key-50691" "key-194634"))
  (defconst ordered (persistentHashSet "alpha" (persistentVector 1 2) "omega"))
  (defconst reversed (persistentHashSet "omega" (persistentVector 1 2) "alpha"))
  (defun sort-numbers (values) (js-call (Array/from values) :sort (lambda (left right) (- left right))))
  (js-call globalThis.console :log (JSON/stringify (js-object :shape shape
    :probes (js-call (js-array 0 31 32 1024 32768 99999) :map (lambda (value) (js-call values :has value)))
    :missing (js-call values :has "missing") :original (js-call values :has 54321) :updated (js-call updated :has 54321)
    :sharedNodes (sharedPersistentSetNodes values updated) :metrics metrics :sum (js-call values :reduce (lambda (total value) (+ total value)) 0)
    :collision (js-object :count (get collision :count) :left (js-call collision :has "key-50691") :right (js-call collision :has "key-194634") :shape (inspectPersistentSet collision))
    :algebra (js-object :union (sort-numbers (js-call (persistentHashSet 1 2) :union (js-array 2 3)))
      :intersection (sort-numbers (js-call (persistentHashSet 1 2 3) :intersection (js-array 2 3 4)))
      :difference (sort-numbers (js-call (persistentHashSet 1 2 3) :difference (js-array 2))))
    :unordered (js-object :equal (equalValues ordered reversed) :leftHash (hashValue ordered) :rightHash (hashValue reversed))))))
