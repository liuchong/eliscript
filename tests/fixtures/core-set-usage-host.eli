(module tests.fixtures.core-set-usage-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar usage undefined)
  (defun ordered (value) (js-call (Array/from value) :sort (lambda (a b) (- a b))))
  (defun rows (value)
    (js-call (js-call (Array/from value) :map Object/fromEntries) :sort (lambda (a b)
      (if (and (not (= (get a :id) undefined)) (not (= (get b :id) undefined))) (- (get a :id) (get b :id))
        (js-call (JSON/stringify a) :localeCompare (JSON/stringify b))))))
  (defun entries (value)
    (js-call (js-call (Array/from value) :map (lambda (entry) (Array/from entry))) :sort (lambda (a b)
      (js-call (funcall globalThis.String (aref a 0)) :localeCompare (funcall globalThis.String (aref b 0))))))
  (defasync run-host-main ()
    (setq usage (await (funcall load-module (get (pathToFileURL (aref (get globalThis.process :argv) 2)) :href))))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :converted (ordered (get usage :converted)) :united (ordered (get usage :united))
    :intersected (ordered (get usage :intersected)) :subtracted (ordered (get usage :subtracted))
    :subset (get usage :subset_result) :superset (get usage :superset_result) :disjoint (get usage :disjoint_result)
    :selected (rows (get usage :selected)) :projected (rows (get usage :projected)) :renamed (rows (get usage :renamed))
    :renamedKeys (Object/fromEntries (get usage :renamed_keys))
    :indexSizes (js-call (js-call (Array/from (get usage :indexed)) :map (lambda (entry) (get (aref entry 1) :count))) :sort)
    :inverted (entries (get usage :inverted)) :joined (rows (get usage :joined)) :mappedJoined (rows (get usage :mapped_joined))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
