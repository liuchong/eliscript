(module tests.fixtures.persistent-list-host
  (import "../../runtime/core/data-text.mjs" printValue readValue)
  (import "../../runtime/core/identifier.mjs" keyword)
  (import "../../runtime/core/list.mjs" EMPTY_LIST persistentList)
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/metadata.mjs" meta withMeta)
  (import "../../runtime/core/value.mjs" equalValues hashValue)
  (defun host-type (value) (js* "typeof value"))
  (defconst metadata (persistentHashMap (js-array (keyword "source") "host")))
  (defconst values (persistentList 1 (keyword "two") (persistentList 3 4)))
  (defconst annotated (withMeta values metadata))
  (defconst text (printValue annotated))
  (defconst restored (readValue text))
  (defconst keyed (persistentHashMap (js-array values "found")))
  (js-call globalThis.console :log (JSON/stringify (js-object
    :empty (get EMPTY_LIST :count)
    :values (js-call (js-call values :toArray) :map (lambda (value)
      (if (and (= (host-type value) "object") (not (nullish? value))
               (funcall globalThis.Boolean (get value :toArray)))
        (js-call value :toArray) (funcall globalThis.String value))))
    :hash (hashValue values) :equal (equalValues restored annotated) :text text
    :source (js-call (meta restored) :get (keyword "source"))
    :keyed (js-call keyed :get (persistentList 1 (keyword "two") (persistentList 3 4)))))))
