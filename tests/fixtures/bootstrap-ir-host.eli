(module tests.fixtures.bootstrap-ir-host
  (import "node:fs/promises" readFile)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar compiler undefined)
  (defvar source undefined)
  (defasync run-host-main ()
    (setq compiler (await (funcall load-module (aref (get globalThis.process :argv) 2))))
    (setq source (await (readFile (aref (get globalThis.process :argv) 3) "utf8")))
    (js-call (get globalThis.process :stdout) :write (js-call compiler :serialize_ir_program (js-call compiler :deserialize_ir_program source))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
