(module managed.js-cons-fast
  (defun prepend (head tail) (js-cons head tail))
  (defun own (items key) (Object/hasOwn items key))
  (defun dirty-unrelated ()
    (put globalThis.Object.prototype :unrelated-object t)
    (put globalThis.Array.prototype :unrelated-array t))
  (defun fallback (mode trace)
    (let* ((tail (js-array 1 2)) (key globalThis.Symbol.iterator)
           (prototype globalThis.Array.prototype) (marker (js-object :marker t)) (index 0))
      (cond
        ((= mode 0) (put tail :extra t))
        ((= mode 1) (put tail :length 3))
        ((= mode 2) (Object/setPrototypeOf tail (Object/create prototype)))
        ((or (= mode 3) (= mode 4))
          (Object/defineProperty tail key (js-object :get (lambda ()
            (js-call trace :push "get-iterator")
            (when (= mode 4) (throw marker))
            (lambda () (js-call trace :push "iterator")
              (js-object :next (lambda () (js-call trace :push "next")
                (setq index (1+ index)) (js-object :done (> index 1) :value 7))))))))
        ((= mode 5) (put tail key false))
        ((= mode 6) (put prototype :unrelated t))
        ((= mode 7)
          (let ((iterator-prototype (Object/getPrototypeOf (js-call tail :values))))
            (put iterator-prototype :next (lambda ()
              (js-call trace :push "next-override") (js-object :done t :value 9)))))
        ((= mode 8)
          (put tail :length 3)
          (let ((parent (Object/create prototype)))
            (Object/defineProperty parent "2" (js-object :get (lambda ()
              (js-call trace :push "get-index") 8)))
            (Object/setPrototypeOf tail parent))))
      (try (js-cons false tail)
        (catch error
          (if (Object/is marker error) "marker" (get error :name))))))
  (export prepend own fallback dirty-unrelated))
