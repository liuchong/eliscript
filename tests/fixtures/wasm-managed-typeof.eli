(module managed.typeof
  (defvar stored nil)
  (defun type-value (value) (js* "typeof value"))
  (defun type-member (value) (js* "typeof value.item"))
  (defun type-deep (value) (js* "typeof value.child.item"))
  (defun type-underscore (value-name) (js* "typeof value_name"))
  (defun type-shadow (value) (let ((value t)) (js* "typeof value")))
  (defun type-global () (js* "typeof stored"))
  (defun write-global (value) (setq stored value) (js* "typeof stored"))
  (defun capture (value) (lambda () (js* "typeof value")))
  (defun invoke (f) (funcall f))
  (defun make-box (value) (js-object :item value))
  (defun make-child (value) (js-object :child value))
  (defun is-nil (value) (nil? value))
  (defun is-undefined (value) (undefined? value))
  (defun is-null (value) (null value))
  (defun is-nullish (value) (nullish? value))
  (export type-value type-member type-deep type-underscore type-shadow type-global
    write-global capture invoke make-box make-child is-nil is-undefined is-null is-nullish))
