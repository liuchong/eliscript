(module managed.regexp-indices
  (defconst effects (js-array))
  (defun make (pattern flags) (new globalThis/RegExp pattern flags))
  (defun clone (pattern flags) (new globalThis/RegExp pattern flags))
  (defun literal () (js* "/(?<head>a)(b)?/d"))
  (defun plain () (js* "/(a)(b)?/"))
  (defun exec (pattern text) (js-call pattern :exec text))
  (defun last (pattern value) (put pattern :lastIndex value))
  (defun descriptor (object key)
    (let ((value (Object/getOwnPropertyDescriptor object key)))
      (if (Object/is value undefined) (js-array false)
        (js-array t (get value :writable) (get value :enumerable) (get value :configurable)))))
  (defun meta (pattern)
    (JSON/stringify (js-array (get pattern :source) (get pattern :flags)
      (get pattern :hasIndices) (get pattern :lastIndex)
      (object-has? pattern "hasIndices"))))
  (defun accessor (receiver)
    (let* ((prototype (get globalThis/RegExp :prototype))
           (property (Object/getOwnPropertyDescriptor prototype "hasIndices")))
      (js-call (get property :get) :call receiver)))
  (defun accessor-report (pattern)
    (let* ((prototype (get globalThis/RegExp :prototype))
           (property (Object/getOwnPropertyDescriptor prototype "hasIndices")))
      (Object/defineProperty pattern "exec" (js-object :configurable t
        :get (lambda () (js-call effects :push "exec getter") (throw false))))
      (JSON/stringify (js-array (get pattern :hasIndices) (accessor pattern)
        (get property :enumerable) (get property :configurable)
        (Object/is (get property :set) undefined) (get effects :length)))))
  (defun report (result)
    (if (Object/is result nil) (JSON/stringify nil)
      (let* ((captures (js-array)) (pairs (js-array)) (named (js-array))
             (indices (get result :indices)) (has (object-has? result "indices"))
             (groups (if has (get indices :groups) undefined)) (index 0))
        (while (< index (get result :length))
          (let ((value (get result index)))
            (js-call captures :push (js-array (object-has? result index)
              (Object/is value undefined) (if (Object/is value undefined) nil value)
              (descriptor result index))))
          (if has
            (let ((pair (get indices index)))
              (js-call pairs :push (js-array (object-has? indices index)
                (Object/is pair undefined) (if (Object/is pair undefined) nil pair)
                (descriptor indices index)
                (if (Object/is pair undefined) nil
                  (js-array (Object/getOwnPropertyNames pair) (descriptor pair 0)
                    (descriptor pair 1) (descriptor pair "length")))))))
          (setq index (1+ index)))
        (if (not (Object/is groups undefined))
          (let ((keys (Object/keys groups)) (position 0))
            (while (< position (get keys :length))
              (let* ((key (get keys position)) (pair (get groups key)) (aliases (js-array)) (slot 0))
                (while (< slot (get indices :length))
                  (if (Object/is pair (get indices slot)) (js-call aliases :push slot))
                  (setq slot (1+ slot)))
                (js-call named :push (js-array key (object-has? groups key)
                  (Object/is pair undefined) (if (Object/is pair undefined) nil pair)
                  aliases (descriptor groups key))))
              (setq position (1+ position)))))
        (JSON/stringify (js-array (Object/getOwnPropertyNames result) captures
          (get result :index) (get result :input) has (descriptor result "indices")
          (if has (Object/getOwnPropertyNames indices) nil) pairs
          (Object/is groups undefined)
          (if (Object/is groups undefined) false (Object/is (Object/getPrototypeOf groups) nil))
          named (if has (descriptor indices "groups") nil))))))
  (defun all (pattern text)
    (let* ((iterator (js-call text :matchAll pattern)) (out (js-array))
           (step (js-call iterator :next)))
      (while (not (get step :done))
        (js-call out :push (report (get step :value)))
        (setq step (js-call iterator :next)))
      (JSON/stringify (js-array out (get pattern :lastIndex) (get step :done)))))
  (defun independent (pattern text)
    (let* ((iterator (js-call text :matchAll pattern)) (one (get (js-call iterator :next) :value))
           (two (get (js-call iterator :next) :value)))
      (JSON/stringify (js-array (report one) (report two)
        (Object/is one two) (Object/is (get one :indices) (get two :indices))
        (Object/is (get (get one :indices) 0) (get (get two :indices) 0))
        (get pattern :lastIndex)))))
  (defun change (result value) (put (get (get result :indices) 1) 0 value))
  (defun clear () (put effects :length 0))
  (defun trace () (JSON/stringify effects))
  (defun throwing (pattern)
    (js-call pattern :exec (js-object :toString (lambda ()
      (js-call effects :push "input conversion") (throw false)))))
  (defun poisoned (mode)
    (let* ((prototype (if (or (= mode 0) (= mode 2))
                        (get globalThis/Array :prototype) (get globalThis/Object :prototype)))
           (keys (js-array "indices" "groups" "index" "input" "0" "1"))
           (saved (Object/create nil)) (seen (js-object :count 0))
           (pattern (new globalThis/RegExp "(?<head>a)(b)?" "d"))
           (result undefined) (position 0))
      (while (< position (get keys :length))
        (let ((key (get keys position)))
          (put saved key (Object/getOwnPropertyDescriptor prototype key)))
        (setq position (1+ position)))
      (setq position 0)
      (try
        (progn
          (while (< position (get keys :length))
            (let ((key (get keys position)))
              (Object/defineProperty prototype key
                (if (< mode 2)
                  (js-object :configurable t :set (lambda (value)
                    (put seen :count (1+ (get seen :count)))))
                  (js-object :configurable t :writable false :value "inherited blocker"))))
            (setq position (1+ position)))
          (setq result (js-call pattern :exec "a")))
        (finally
          (setq position 0)
          (while (< position (get keys :length))
            (let* ((key (get keys position)) (original (get saved key)))
              (if (Object/is original undefined) (Reflect/deleteProperty prototype key)
                (Object/defineProperty prototype key original)))
            (setq position (1+ position)))))
      (JSON/stringify (js-array (get seen :count) (report result)))))
  (defun capacity (text) (js-call (js* "/(a|aa)*b/d") :exec text))
  (defun recover () (report (js-call (js* "/(a)/d") :exec "a")))
  (export make clone literal plain exec last meta accessor accessor-report report all independent
    change clear trace throwing poisoned capacity recover))
