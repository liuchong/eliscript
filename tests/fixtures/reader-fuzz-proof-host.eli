(module tests.fixtures.reader-fuzz-proof-host
  (import "node:process" :default process)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (defasync eachAsync (items callback) (let ((index 0)) (while (< index (get items :length)) (await (funcall callback (aref items index))) (setq index (1+ index)))))
  (defasync main ()
    (let ((observations (JSON/parse (await (readFile (aref (get process :argv) 2) "utf8")))))
      (await (eachAsync observations (async (item)
        (await (eachAsync (get item :artifacts) (async (path)
          (if (= (get item :shape) "tdz")
            (await (js-call assert :rejects (funcall (js* "(url) => import(url)") path) globalThis.ReferenceError))
            (let* ((module (await (funcall (js* "(url) => import(url)") path))) (call (get module (get item :exportName))))
              (js-call assert :equal (funcall (js* "(value) => typeof value") call) "function")
              (cond
                ((= (get item :shape) "scalar")
                  (js-call (js-array -3 0 (js* "-0") 2 42 globalThis.NaN globalThis.Infinity) :forEach (lambda (input) (assert (Object/is (funcall call input) (+ input (get item :value)))))))
                ((= (get item :shape) "vector")
                  (js-call (js-array undefined nil false 0 (js* "-0") globalThis.NaN "" (js-array) (js-object)) :forEach (lambda (input) (assert (Object/is (funcall call input) input)))))
                ((= (get item :shape) "mutable-value")
                  (assert (Object/is (get module :value) (js* "-0"))) (assert (Object/is (js-call module :current) (js* "-0")))
                  (let ((object (js-object :marker 7)))
                    (js-call (js-array undefined nil false t (js* "-0") 0 globalThis.NaN globalThis.Infinity "updated" object) :forEach (lambda (input)
                      (assert (Object/is (funcall call input) input)) (assert (Object/is (get module :value) input)) (assert (Object/is (js-call module :current) input))))))
                (t (js-call assert :fail "unrecognized original fuzz structure")))))))))))))
  (main))
