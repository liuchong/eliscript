(module tests.fixtures.compiled-eli-node-loader
  (import "node:fs/promises" readFile)
  (defasync load (url context nextLoad)
    (if (js-call url :endsWith ".eli")
      (js-object :format "module" :shortCircuit t :source (await (readFile (new globalThis.URL url) "utf8")))
      (funcall nextLoad url context)))
  (export load))
