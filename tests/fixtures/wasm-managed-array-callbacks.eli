(module managed.array.callbacks
  (defun map-with (items callback) (js-call items :map callback))
  (defun filter-with (items callback) (js-call items :filter callback))
  (defun for-each-with (items callback) (js-call items :forEach callback))
  (defun some-with (items callback) (js-call items :some callback))
  (defun every-with (items callback) (js-call items :every callback))
  (defun find-with (items callback) (js-call items :find callback))
  (defun find-index-with (items callback) (js-call items :findIndex callback))
  (defun find-last-with (items callback) (js-call items :findLast callback))
  (defun find-last-index-with (items callback) (js-call items :findLastIndex callback))
  (defun reduce-with (items callback) (js-call items :reduce callback))
  (defun reduce-right-with (items callback) (js-call items :reduceRight callback))
  (defun reduce-initial (items callback initial) (js-call items :reduce callback initial))
  (defun reduce-right-initial (items callback initial) (js-call items :reduceRight callback initial))
  (defun identity () (lambda (x) x))
  (defun collect-arguments (log) (lambda (&rest args) (js-call log :push args) (aref args 0)))
  (defun sum-callback () (lambda (acc value) (+ acc value)))
  (defun ordered-callback (log) (lambda (acc value index array) (js-call log :push (js-array value index array)) (+ (* acc 10) value)))
  (defun map-indices (items) (js-call items :map (lambda (value index array) (js-array value index (eq array items)))))
  (defun has-index (items index) (object-has? items index))
  (defun make-array () (js-array))
  (defun mutation-callback (target) (lambda (value index array) (when (= index 0) (put target :length 1) (put target :length 4) (put target 2 99) (js-call target :push 123)) (js-array value index (eq array target))))
  (defun replace-callback (target replacement) (lambda (value index array) (when (= index 0) (put target 1 replacement)) value))
  (defun evaluation-order (items other marker) (js-call items :map (progn (setq items other) (put marker 0 1) (lambda (x) x)) (put marker 0 2) (put marker 0 3)))
  (defun nullish-order (items marker) (js-call items :map (put marker 0 1)))
  (defun first-error (items marker) (js-call items :map (lambda (x) (false) (put marker 0 99))))
  (defun map-shadow (items callback) (put items :map callback) (js-call items :map 7 8))
  (defun shadow-value () (lambda (a b) (+ a b)))
  (defun map-replaced (items callback) (js-call items :map (progn (put items :map false) callback)))
  (defun map-recursive (items) (js-call items :map (lambda (x) (if (> x 0) (js-call (js-array (1- x)) :map (lambda (y) y)) (js-array x)))))
  (defun shrink-callback (log)
    (let ((first t))
      (lambda (value index array)
        (when first (setq first false) (put array :length 0))
        (js-call log :push (js-array value index)) false)))
  (defun map-constructor (items callback constructor)
    (put items :constructor constructor) (js-call items :map callback))
  (defun filter-constructor (items callback constructor)
    (put items :constructor constructor) (js-call items :filter callback))
  (defun sort-with (items comparator) (js-call items :sort comparator))
  (defun sort-copy-with (items comparator) (js-call items :toSorted comparator))
  (defun sort-default (items) (js-call items :sort))
  (defun sort-copy (items) (js-call items :toSorted))
  (defun sort-numeric (items reverse) (js-call items :sort (lambda (a b) (if reverse (- b a) (- a b)))))
  (defun sort-stable ()
    (let ((items (js-array (js-object :rank 2 :id "a") (js-object :rank 1 :id "b") (js-object :rank 2 :id "c") (js-object :rank 1 :id "d"))))
      (js-call (js-call items :sort (lambda (a b) (- (get a :rank) (get b :rank)))) :map (lambda (item) (get item :id)))))
  (defun sort-nan-ties (items) (js-call items :sort (lambda (a b) (/ 0 0))))
  (defun sort-copy-mutation (items) (js-call items :toSorted (lambda (a b) (put items 0 99) (- a b))))
  (defun concat-copy (items other) (js-call items :concat other))
  (defun concat-summary ()
    (let ((items (js-array)) (inner (js-array 1)))
      (put items :length 4) (put items 1 undefined) (put items 3 inner)
      (let ((out (js-call items :concat items "tail")))
        (put inner 0 7)
        (js-array (eq items out) (js-length out) (object-has? out 0) (object-has? out 1)
          (eq (js-nth 3 out) (js-nth 7 out)) (js-nth 3 out) (js-nth 8 out)))))
  (export concat-copy concat-summary)
  (export sort-with sort-copy-with sort-default sort-copy sort-numeric sort-stable sort-nan-ties sort-copy-mutation)
  (export map-constructor filter-constructor shrink-callback map-with filter-with for-each-with some-with every-with find-with find-index-with find-last-with find-last-index-with reduce-with reduce-right-with reduce-initial reduce-right-initial identity collect-arguments sum-callback ordered-callback map-indices has-index make-array mutation-callback replace-callback evaluation-order nullish-order first-error map-shadow shadow-value map-replaced map-recursive))
