(module tests.fixtures.multimethod-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst modulePath (aref (get globalThis.process :argv) 2))
  (defconst declarativePath (aref (get globalThis.process :argv) 3))
  (defconst moduleUrl (pathToFileURL modulePath))
  (defvar multimethodModule undefined)
  (defvar declarativeModule undefined)
  (defvar hierarchyModule undefined)
  (defvar mapModule undefined)
  (defvar setModule undefined)
  (defvar vectorModule undefined)
  (defvar addMethod undefined)
  (defvar defaultDispatchValue undefined)
  (defvar deriveMethod undefined)
  (defvar dispatchFn undefined)
  (defvar dispatchValue undefined)
  (defvar getMethod undefined)
  (defvar hasMethod undefined)
  (defvar methods undefined)
  (defvar multiFn undefined)
  (defvar multiFnHierarchy undefined)
  (defvar multiFnName undefined)
  (defvar isMultiFn undefined)
  (defvar preferMethod undefined)
  (defvar preferences undefined)
  (defvar preferredMethod undefined)
  (defvar removeAllMethods undefined)
  (defvar removeAllPreferences undefined)
  (defvar removeMethod undefined)
  (defvar removePreference undefined)
  (defvar setHierarchy undefined)
  (defvar underiveMethod undefined)
  (defvar ancestors undefined)
  (defvar derive undefined)
  (defvar descendants undefined)
  (defvar emptyHierarchy undefined)
  (defvar isHierarchy undefined)
  (defvar isA undefined)
  (defvar parents undefined)
  (defvar underive undefined)
  (defvar mapCount undefined)
  (defvar mapGet undefined)
  (defvar setCount undefined)
  (defvar vectorFromArray undefined)
  (defun optional (value key)
    (if (nullish? value) nil (let ((item (get value key))) (if (nullish? item) nil item))))
  (defun error-code (error)
    (let ((code (optional error "code"))) (if (nullish? code) (funcall globalThis.String error) code)))
  (defun captureError (operation)
    (try (progn (funcall operation) nil)
      (catch error (js-object :code (error-code error) :name (optional error "name") :dispatchValue (optional error "dispatch-value")))))
  (defun captureHierarchyError (operation)
    (try (progn (funcall operation) nil)
      (catch error (js-object :code (error-code error) :child (optional error "child") :parent (optional error "parent")))))
  (defvar dispatchCalls undefined)
  (defvar render undefined)
  (defvar textMethod undefined)
  (defvar numberMethod undefined)
  (defvar fallbackMethod undefined)
  (defvar initialSnapshot undefined)
  (defvar addTextResult undefined)
  (defvar populatedSnapshot undefined)
  (defvar textResult undefined)
  (defvar numberResult undefined)
  (defvar fallbackResult undefined)
  (defvar dispatchOnly undefined)
  (defvar dispatchFunction undefined)
  (defvar lookedUpText undefined)
  (defvar lookedUpFallback undefined)
  (defvar hasTextBeforeRemoval undefined)
  (defvar hasAbsentThroughDefault undefined)
  (defvar replacementResult undefined)
  (defvar removeTextResult undefined)
  (defvar removedFallsBack undefined)
  (defvar oldSnapshotText undefined)
  (defvar composite undefined)
  (defvar compositeResult undefined)
  (defvar customDefault undefined)
  (defvar customDefaultResult undefined)
  (defvar nilDefault undefined)
  (defvar nilDefaultResult undefined)
  (defvar undefinedDefault undefined)
  (defvar undefinedDefaultResult undefined)
  (defvar identityKey undefined)
  (defvar identityDispatch undefined)
  (defvar identityMatch undefined)
  (defvar identityMiss undefined)
  (defvar dispatchMarker undefined)
  (defvar methodMarker undefined)
  (defvar failedDispatch undefined)
  (defvar failedMethod undefined)
  (defvar dispatchMarkerPreserved undefined)
  (defvar methodMarkerPreserved undefined)
  (defvar selfReplacing undefined)
  (defvar firstSelfReplacement undefined)
  (defvar secondSelfReplacement undefined)
  (defvar empty undefined)
  (defvar noMethod undefined)
  (defvar invalidDispatch undefined)
  (defvar invalidArity undefined)
  (defvar invalidMethod undefined)
  (defvar invalidReference undefined)
  (defvar forged undefined)
  (defvar clearedSnapshot undefined)
  (defvar clearResult undefined)
  (defvar clearedError undefined)
  (defvar scaleDispatchCalls undefined)
  (defvar parity undefined)
  (defvar scaleTotal undefined)
  (defvar hierarchy0 undefined)
  (defvar hierarchy1 undefined)
  (defvar hierarchy2 undefined)
  (defvar hierarchy3 undefined)
  (defvar duplicateHierarchy undefined)
  (defvar hierarchy4 undefined)
  (defvar diamond0 undefined)
  (defvar diamond1 undefined)
  (defvar diamond2 undefined)
  (defvar diamond3 undefined)
  (defvar diamond4 undefined)
  (defvar lateAncestor0 undefined)
  (defvar lateAncestor1 undefined)
  (defvar lateAncestor2 undefined)
  (defvar vectorChild undefined)
  (defvar vectorParent undefined)
  (defvar wideHierarchy undefined)
  (defvar taxonomy undefined)
  (defvar deriveResult undefined)
  (defvar mammalResult undefined)
  (defvar specificResult undefined)
  (defvar cacheInvalidatedByRemoval undefined)
  (defvar cacheInvalidatedByAddition undefined)
  (defvar exactOverridesAncestor undefined)
  (defvar removingExactRestoresAncestor undefined)
  (defvar hierarchicalFallbackResult undefined)
  (defvar setHierarchyResult undefined)
  (defvar externalHierarchyIdentity undefined)
  (defvar underiveResult undefined)
  (defvar underivedFallback undefined)
  (defvar chooser undefined)
  (defvar ambiguous undefined)
  (defvar preferResult undefined)
  (defvar preferredResult undefined)
  (defvar preferenceSnapshot undefined)
  (defvar directPreference undefined)
  (defvar transitivePreference undefined)
  (defvar preferenceSelf undefined)
  (defvar preferenceConflict undefined)
  (defvar invalidHierarchy undefined)
  (defvar hierarchyConflict undefined)
  (defvar conflictHierarchy undefined)
  (defvar externalHierarchyConflict undefined)
  (defvar removePreferenceResult undefined)
  (defvar removedPreferenceError undefined)
  (defvar clearPreferencesResult undefined)
  (defvar invalidHierarchyValue undefined)
  (defvar selfHierarchy undefined)
  (defvar cycleHierarchy undefined)
  (defvar hierarchicalScaleCalls undefined)
  (defvar hierarchicalScale undefined)
  (defvar hierarchicalScaleTotal undefined)
  (defasync run-host-main ()
    (setq multimethodModule (await (funcall load-module (get moduleUrl :href))))
    (setq declarativeModule (await (funcall load-module (get (pathToFileURL declarativePath) :href))))
    (setq hierarchyModule (await (funcall load-module (get (new globalThis.URL "./hierarchy.eli" moduleUrl) :href))))
    (setq mapModule (await (funcall load-module (get (new globalThis.URL "./persistent-map.eli" moduleUrl) :href))))
    (setq setModule (await (funcall load-module (get (new globalThis.URL "./persistent-set.eli" moduleUrl) :href))))
    (setq vectorModule (await (funcall load-module (get (new globalThis.URL "./persistent-vector.eli" moduleUrl) :href))))
    (setq addMethod (get multimethodModule "add_method_BANG_"))
    (setq defaultDispatchValue (get multimethodModule "default_dispatch_value"))
    (setq deriveMethod (get multimethodModule "derive_BANG_"))
    (setq dispatchFn (get multimethodModule "dispatch_fn"))
    (setq dispatchValue (get multimethodModule "dispatch_value"))
    (setq getMethod (get multimethodModule "get_method"))
    (setq hasMethod (get multimethodModule "has_method_QMARK_"))
    (setq methods (get multimethodModule "methods"))
    (setq multiFn (get multimethodModule "multi_fn"))
    (setq multiFnHierarchy (get multimethodModule "multi_fn_hierarchy"))
    (setq multiFnName (get multimethodModule "multi_fn_name"))
    (setq isMultiFn (get multimethodModule "multi_fn_QMARK_"))
    (setq preferMethod (get multimethodModule "prefer_method_BANG_"))
    (setq preferences (get multimethodModule "preferences"))
    (setq preferredMethod (get multimethodModule "preferred_method_QMARK_"))
    (setq removeAllMethods (get multimethodModule "remove_all_methods_BANG_"))
    (setq removeAllPreferences (get multimethodModule "remove_all_preferences_BANG_"))
    (setq removeMethod (get multimethodModule "remove_method_BANG_"))
    (setq removePreference (get multimethodModule "remove_preference_BANG_"))
    (setq setHierarchy (get multimethodModule "set_hierarchy_BANG_"))
    (setq underiveMethod (get multimethodModule "underive_BANG_"))
    (setq ancestors (get hierarchyModule "ancestors"))
    (setq derive (get hierarchyModule "derive"))
    (setq descendants (get hierarchyModule "descendants"))
    (setq emptyHierarchy (get hierarchyModule "empty_hierarchy"))
    (setq isHierarchy (get hierarchyModule "hierarchy_QMARK_"))
    (setq isA (get hierarchyModule "is_a_QMARK_"))
    (setq parents (get hierarchyModule "parents"))
    (setq underive (get hierarchyModule "underive"))
    (setq mapCount (get mapModule "persistent_map_count"))
    (setq mapGet (get mapModule "persistent_map_get"))
    (setq setCount (get setModule "persistent_set_count"))
    (setq vectorFromArray (get vectorModule "persistent_vector_from_array"))
    (setq dispatchCalls 0)
    (setq render (multiFn "render" (lambda (kind value) (setq dispatchCalls (1+ dispatchCalls)) kind)))
    (setq textMethod (lambda (_kind value) (str "text:" value)))
    (setq numberMethod (lambda (_kind value) (* value 2)))
    (setq fallbackMethod (lambda (kind value) (str kind ":" value)))
    (setq initialSnapshot (methods render))
    (setq addTextResult (addMethod render "text" textMethod))
    (addMethod render "number" numberMethod)
    (addMethod render (defaultDispatchValue render) fallbackMethod)
    (setq populatedSnapshot (methods render))
    (setq textResult (render "text" "hello"))
    (setq numberResult (render "number" 21))
    (setq fallbackResult (render "unknown" 9))
    (setq dispatchOnly (dispatchValue render "text" "ignored"))
    (setq dispatchFunction (dispatchFn render))
    (setq lookedUpText (getMethod render "text"))
    (setq lookedUpFallback (getMethod render "absent"))
    (setq hasTextBeforeRemoval (hasMethod render "text"))
    (setq hasAbsentThroughDefault (hasMethod render "absent"))
    (addMethod render "text" (lambda (_kind value) (str "replacement:" value)))
    (setq replacementResult (render "text" "hello"))
    (setq removeTextResult (removeMethod render "text"))
    (setq removedFallsBack (render "text" "hello"))
    (setq oldSnapshotText (mapGet populatedSnapshot "text" nil))
    (setq composite (multiFn "composite" (lambda (left right) (vectorFromArray (js-array left right)))))
    (addMethod composite (vectorFromArray (js-array "number" 2)) (lambda (left right) (str left "/" right)))
    (setq compositeResult (composite "number" 2))
    (setq customDefault (multiFn "custom-default" (lambda (value) value) "fallback"))
    (addMethod customDefault "fallback" (lambda (value) (str "default:" value)))
    (setq customDefaultResult (customDefault "missing"))
    (setq nilDefault (multiFn "nil-default" (lambda (value) value) nil))
    (addMethod nilDefault nil (lambda (value) (str "nil:" value)))
    (setq nilDefaultResult (nilDefault "missing"))
    (setq undefinedDefault (multiFn "undefined-default" (lambda (value) value) undefined))
    (addMethod undefinedDefault undefined (lambda (value) (str "undefined:" value)))
    (setq undefinedDefaultResult (undefinedDefault "missing"))
    (setq identityKey (js-object))
    (setq identityDispatch (multiFn "identity" (lambda (value) value)))
    (addMethod identityDispatch identityKey (lambda () "identity-match"))
    (setq identityMatch (identityDispatch identityKey))
    (setq identityMiss (captureError (lambda () (identityDispatch (js-object)))))
    (setq dispatchMarker (js-object :marker "dispatch"))
    (setq methodMarker (js-object :marker "method"))
    (setq failedDispatch (multiFn "failed-dispatch" (lambda () (throw dispatchMarker))))
    (setq failedMethod (multiFn "failed-method" (lambda (value) value)))
    (addMethod failedMethod "throw" (lambda () (throw methodMarker)))
    (setq dispatchMarkerPreserved false)
    (setq methodMarkerPreserved false)
    (try (failedDispatch) (catch error (setq dispatchMarkerPreserved (= error dispatchMarker))))
    (try (failedMethod "throw") (catch error (setq methodMarkerPreserved (= error methodMarker))))
    (setq selfReplacing (multiFn "self-replacing" (lambda (value) value)))
    (addMethod selfReplacing "replace" (lambda () (addMethod selfReplacing "replace" (lambda () "second")) "first"))
    (setq firstSelfReplacement (selfReplacing "replace"))
    (setq secondSelfReplacement (selfReplacing "replace"))
    (setq empty (multiFn "empty" (lambda (value) value)))
    (setq noMethod (captureError (lambda () (empty "missing"))))
    (setq invalidDispatch (captureError (lambda () (multiFn "bad" nil))))
    (setq invalidArity (captureError (lambda () (multiFn "bad" (lambda () nil) 1 2))))
    (setq invalidMethod (captureError (lambda () (addMethod empty "bad" 42))))
    (setq invalidReference (captureError (lambda () (methods (lambda () nil)))))
    (setq forged (lambda () undefined))
    (setq clearedSnapshot (methods render))
    (setq clearResult (removeAllMethods render))
    (setq clearedError (captureError (lambda () (render "text" "hello"))))
    (setq scaleDispatchCalls 0)
    (setq parity (multiFn "parity" (lambda (value) (setq scaleDispatchCalls (1+ scaleDispatchCalls)) (bit-and value 1))))
    (addMethod parity 0 (lambda (value) value))
    (addMethod parity 1 (lambda (value) (- value)))
    (setq scaleTotal 0)
    (let ((index 0)) (while (< index 100000) (setq scaleTotal (+ scaleTotal (parity index))) (setq index (1+ index))))
    (setq hierarchy0 (emptyHierarchy))
    (setq hierarchy1 (derive hierarchy0 "mammal" "animal"))
    (setq hierarchy2 (derive hierarchy1 "cat" "mammal"))
    (setq hierarchy3 (derive hierarchy2 "dog" "mammal"))
    (setq duplicateHierarchy (derive hierarchy3 "dog" "mammal"))
    (setq hierarchy4 (underive hierarchy3 "mammal" "animal"))
    (setq diamond0 (derive hierarchy0 "left" "root"))
    (setq diamond1 (derive diamond0 "right" "root"))
    (setq diamond2 (derive diamond1 "leaf" "left"))
    (setq diamond3 (derive diamond2 "leaf" "right"))
    (setq diamond4 (underive diamond3 "left" "root"))
    (setq lateAncestor0 (derive hierarchy0 "child" "parent"))
    (setq lateAncestor1 (derive lateAncestor0 "grandchild" "child"))
    (setq lateAncestor2 (derive lateAncestor1 "parent" "late-root"))
    (setq vectorChild (vectorFromArray (js-array "cat" "online")))
    (setq vectorParent (vectorFromArray (js-array "animal" "online")))
    (setq wideHierarchy hierarchy0)
    (let ((index 0)) (while (< index 10000) (setq wideHierarchy (derive wideHierarchy (str "leaf-" index) "wide-root")) (setq index (1+ index))))
    (setq taxonomy (multiFn "taxonomy" (lambda (value) value)))
    (setq deriveResult (deriveMethod taxonomy "mammal" "animal"))
    (deriveMethod taxonomy "cat" "mammal")
    (addMethod taxonomy "animal" (lambda (value) (str "animal:" value)))
    (addMethod taxonomy "mammal" (lambda (value) (str "mammal:" value)))
    (addMethod taxonomy (defaultDispatchValue taxonomy) (lambda (value) (str "default:" value)))
    (setq mammalResult (taxonomy "cat"))
    (setq specificResult (taxonomy "cat"))
    (removeMethod taxonomy "mammal")
    (setq cacheInvalidatedByRemoval (taxonomy "cat"))
    (addMethod taxonomy "mammal" (lambda (value) (str "mammal:" value)))
    (setq cacheInvalidatedByAddition (taxonomy "cat"))
    (addMethod taxonomy "cat" (lambda (value) (str "exact:" value)))
    (setq exactOverridesAncestor (taxonomy "cat"))
    (removeMethod taxonomy "cat")
    (setq removingExactRestoresAncestor (taxonomy "cat"))
    (setq hierarchicalFallbackResult (taxonomy "mineral"))
    (setq setHierarchyResult (setHierarchy taxonomy hierarchy3))
    (setq externalHierarchyIdentity (and (= setHierarchyResult taxonomy) (= (multiFnHierarchy taxonomy) hierarchy3)))
    (setq underiveResult (underiveMethod taxonomy "cat" "mammal"))
    (setq underivedFallback (taxonomy "cat"))
    (setq chooser (multiFn "chooser" (lambda (value) value)))
    (deriveMethod chooser "chimera" "mammal")
    (deriveMethod chooser "chimera" "machine")
    (addMethod chooser "mammal" (lambda (value) (str "mammal:" value)))
    (addMethod chooser "machine" (lambda (value) (str "machine:" value)))
    (setq ambiguous (captureError (lambda () (chooser "chimera"))))
    (setq preferResult (preferMethod chooser "mammal" "machine"))
    (setq preferredResult (chooser "chimera"))
    (preferMethod chooser "machine" "artifact")
    (setq preferenceSnapshot (preferences chooser))
    (setq directPreference (preferredMethod chooser "mammal" "machine"))
    (setq transitivePreference (preferredMethod chooser "mammal" "artifact"))
    (setq preferenceSelf (captureError (lambda () (preferMethod chooser "mammal" "mammal"))))
    (setq preferenceConflict (captureError (lambda () (preferMethod chooser "machine" "mammal"))))
    (setq invalidHierarchy (captureError (lambda () (setHierarchy chooser (js-object)))))
    (setq hierarchyConflict (captureError (lambda () (deriveMethod chooser "machine" "mammal"))))
    (setq conflictHierarchy (derive hierarchy0 "machine" "mammal"))
    (setq externalHierarchyConflict (captureError (lambda () (setHierarchy chooser conflictHierarchy))))
    (setq removePreferenceResult (removePreference chooser "mammal" "machine"))
    (setq removedPreferenceError (captureError (lambda () (chooser "chimera"))))
    (setq clearPreferencesResult (removeAllPreferences chooser))
    (setq invalidHierarchyValue (captureHierarchyError (lambda () (parents (js-object) "cat"))))
    (setq selfHierarchy (captureHierarchyError (lambda () (derive hierarchy0 "animal" "animal"))))
    (setq cycleHierarchy (captureHierarchyError (lambda () (derive hierarchy3 "animal" "cat"))))
    (setq hierarchicalScaleCalls 0)
    (setq hierarchicalScale (multiFn "hierarchical-scale" (lambda (value) (setq hierarchicalScaleCalls (1+ hierarchicalScaleCalls)) "leaf")))
    (deriveMethod hierarchicalScale "leaf" "root")
    (addMethod hierarchicalScale "root" (lambda (value) value))
    (setq hierarchicalScaleTotal 0)
    (let ((index 0)) (while (< index 100000) (setq hierarchicalScaleTotal (+ hierarchicalScaleTotal (hierarchicalScale index))) (setq index (1+ index))))
    (console/log (JSON/stringify (js-object
    :identity (js-object :multiFn (isMultiFn render) :ordinaryFunction (isMultiFn (lambda () nil)) :forged (isMultiFn forged) :callable (= (funcall host-typeof render) "function") :name (multiFnName render) :dispatchFunction (dispatchFunction "number" 1) :customDefault (defaultDispatchValue customDefault))
    :dispatch (js-object :textResult textResult :numberResult numberResult :fallbackResult fallbackResult :dispatchOnly dispatchOnly :calls dispatchCalls :textLookup (= lookedUpText textMethod) :fallbackLookup (= lookedUpFallback fallbackMethod) :hasText hasTextBeforeRemoval :hasAbsentThroughDefault hasAbsentThroughDefault)
    :mutation (js-object :addReturnsIdentity (= addTextResult render) :removeReturnsIdentity (= removeTextResult render) :clearReturnsIdentity (= clearResult render) :initialCount (mapCount initialSnapshot) :populatedCount (mapCount populatedSnapshot) :snapshotRetainsText (= oldSnapshotText textMethod) :replacementResult replacementResult :removedFallsBack removedFallsBack :beforeClearCount (mapCount clearedSnapshot) :afterClearCount (mapCount (methods render)))
    :valueDispatch (js-object :compositeResult compositeResult :customDefaultResult customDefaultResult :nilDefaultResult nilDefaultResult :undefinedDefaultResult undefinedDefaultResult :identityMatch identityMatch :identityMiss identityMiss)
    :callbacks (js-object :dispatchMarkerPreserved dispatchMarkerPreserved :methodMarkerPreserved methodMarkerPreserved :firstSelfReplacement firstSelfReplacement :secondSelfReplacement secondSelfReplacement)
    :errors (js-object :noMethod noMethod :invalidDispatch invalidDispatch :invalidArity invalidArity :invalidMethod invalidMethod :invalidReference invalidReference :clearedError clearedError)
    :scale (js-object :calls scaleDispatchCalls :total scaleTotal)
    :hierarchy (js-object :identity (isHierarchy hierarchy0) :forged (isHierarchy (js-object)) :duplicateRetainsIdentity (= duplicateHierarchy hierarchy3) :directParentCount (setCount (parents hierarchy3 "cat")) :transitiveAncestorCount (setCount (ancestors hierarchy3 "cat")) :transitiveDescendantCount (setCount (descendants hierarchy3 "animal"))
      :catIsAnimal (isA hierarchy3 "cat" "animal") :vectorIsA (isA hierarchy3 vectorChild vectorParent) :oldSnapshotRetainsRelation (isA hierarchy3 "cat" "animal") :underiveRemovesTransitiveRelation (not (isA hierarchy4 "cat" "animal")) :underiveRetainsDirectRelation (isA hierarchy4 "cat" "mammal") :diamondRetainsAlternatePath (isA diamond4 "leaf" "root") :lateAncestorReachesGrandchild (isA lateAncestor2 "grandchild" "late-root") :lateAncestorDescendantCount (setCount (descendants lateAncestor2 "late-root")) :wideDescendantCount (setCount (descendants wideHierarchy "wide-root")) :wideLastLeafMatches (isA wideHierarchy "leaf-9999" "wide-root") :wideBaseRemainsEmpty (= (descendants hierarchy0 "wide-root") nil))
    :hierarchyErrors (js-object :invalid invalidHierarchyValue :self selfHierarchy :cycle cycleHierarchy)
    :hierarchicalDispatch (js-object :deriveReturnsIdentity (= deriveResult taxonomy) :mammalResult mammalResult :specificResult specificResult :cacheInvalidatedByRemoval cacheInvalidatedByRemoval :cacheInvalidatedByAddition cacheInvalidatedByAddition :exactOverridesAncestor exactOverridesAncestor :removingExactRestoresAncestor removingExactRestoresAncestor :fallbackResult hierarchicalFallbackResult :externalHierarchyIdentity externalHierarchyIdentity :underiveReturnsIdentity (= underiveResult taxonomy) :underivedFallback underivedFallback)
    :preferences (js-object :ambiguous (get ambiguous :code) :preferReturnsIdentity (= preferResult chooser) :preferredResult preferredResult :directPreference directPreference :transitivePreference transitivePreference :snapshotCount (mapCount preferenceSnapshot) :removeReturnsIdentity (= removePreferenceResult chooser) :removedIsAmbiguous (get removedPreferenceError :code) :clearReturnsIdentity (= clearPreferencesResult chooser) :clearedCount (mapCount (preferences chooser)))
    :preferenceErrors (js-object :self (get preferenceSelf :code) :conflict (get preferenceConflict :code) :invalidHierarchy (get invalidHierarchy :code) :hierarchyConflict (get hierarchyConflict :code) :externalHierarchyConflict (get externalHierarchyConflict :code))
    :hierarchicalScale (js-object :calls hierarchicalScaleCalls :total hierarchicalScaleTotal)
    :declarations (js-object :identity (isMultiFn (get declarativeModule :render)) :text (js-call declarativeModule :render "text" "hello") :number (js-call declarativeModule :render "number" 21) :fallback (js-call declarativeModule :render "other" 9))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
