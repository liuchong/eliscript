(module tests.fixtures.reader-portable-host
  (import "node:process" :default process)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../helpers/reader-host-oracle.mjs" whitespace delimiter skip token)
  (import "../helpers/reader-runtime-contract.mjs" state readState start finish)
  (defun main ()
    (let* ((bytes (readFileSync (aref (get process :argv) 2))) (a (instantiateManagedRuntime bytes)) (seed 1636018557)
           (inputs (js-array "" "😀x;end" " ;😀\ud800comment\n  abc" "foo\ud800bar" "\udfff")) (i 0))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new (get globalThis.WebAssembly :Module) bytes)) (js-array))
      (js-call a :auto 1)
      (letfn ((next () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223))) seed))
        (while (< i 128)
          (let ((s "") (j 0) (n (mod (next) 32)))
            (while (< j n) (setq s (str s (String/fromCharCode (mod (next) 65536))) j (1+ j))) (js-call inputs :push (str " ;😀" s "\nend")))
          (setq i (1+ i))))
      (js-call inputs :forEach (lambda (source)
        (let* ((input (state a source)) (expected (js-object :source source :index 0 :offset 11 :line 3 :column 7)))
          (skip expected whitespace) (js-call assert :equal (js-call a :invoke "reader-skip" (js-array input)) nil)
          (let* ((begin (start a (get expected :index))) (text (token expected (js-object :index (get expected :index)) delimiter))
                 (out (js-call a :invoke "reader-token" (js-array input begin))))
            (js-call assert :equal (js-call a :readString out) text) (js-call assert :deepEqual (readState a input) expected)
            (js-call (js-array input begin out) :forEach (lambda (value) (js-call a :release value))) (js-call a :collect)))))
      (finish a (js-array))))
  (main))
