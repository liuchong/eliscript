(module tests.fixtures.native-node-memory-host
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" readFile)
  (import "node:worker_threads" Worker)
  (import "../../tools/backends/native-memory.mjs" openNativeMemory)
  (defconst hostInstanceof (js* "(value, type) => value instanceof type"))
  ;; Preserve the native method receiver while keeping packet logic in Eli.
  (defconst receiverPost (js* "(implementation) => function(message,...rest) { return implementation(this,message,rest); }"))
  (defconst receiverRest (js* "(implementation) => function(...args) { return implementation(this,args); }"))
  (defun assert-eq (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun throws (action &rest __host_forwarded_arguments_3)
    (let* ((expected (aref __host_forwarded_arguments_3 0)) (label (aref __host_forwarded_arguments_3 1))) (js-call assert :throws action expected label)))
  (defun closed (action) (throws action (new globalThis.RegExp "closed")))
  (defun config (configuration &rest __host_forwarded_arguments_4)
    (let* ((extras (aref __host_forwarded_arguments_4 0))) (Object/assign (js-object) configuration extras)))
  (defasync bulk (library signatures configuration)
    (let ((a (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda () 0))))))
          (b (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda () 0)))))))
      (try
        (assert-eq (get a :byteLength) 65536) (js-call a :invoke "write32" 3 4275878552)
        (assert-eq (js-call a :invoke "read32" 3) 4275878552) (assert-eq (js-call b :invoke "read32" 3) 0)
        (assert-eq (js-call a :invoke "grow" 2) 1) (assert-eq (get a :byteLength) 196608) (same (js-call a :read 65536 32) (new globalThis.Uint8Array 32))
        (let* ((bytes (Uint8Array/from (js-object :length 196600) (lambda (unused i) (bit-and (+ (* i 37) 11) 255))))
               (read (progn (assert-eq (js-call a :write bytes 3) undefined) (js-call a :read 3 (get bytes :length)))))
          (same read bytes) (js-call read :fill 0) (same (js-call a :read 3 32) (js-call bytes :slice 0 32)))
        (js-call a :close) (js-call a :close)
        (closed (lambda () (js-call a :invoke "read32" 3))) (closed (lambda () (js-call a :read 0 1)))
        (assert-eq (js-call b :invoke "read32" 3) 0)
        (finally (js-call a :close) (js-call b :close)))))
  (defasync boundedBulk (library signatures configuration)
    (let* ((prototype (get Worker :prototype)) (post (get prototype :postMessage)) (from (get globalThis.Buffer :from))
           (packets (js-array)) (decoded (js-array)) (onSize undefined) (shortRead false) (a undefined))
      (put prototype :postMessage (funcall receiverPost (lambda (receiver message rest)
        (let ((request (if (nullish? message) undefined (get message :request))))
          (cond
            ((and (not (nullish? request)) (= (get request :method) "size"))
              (js-call packets :push (js-object :method "size"))
              (when onSize (let ((run onSize)) (setq onSize undefined) (run))))
            ((and (not (nullish? request)) (= (get request :method) "read"))
              (js-call packets :push (js-object :method "read" :offset (aref (get request :args) 0) :length (aref (get request :args) 1)))
              (when (and shortRead (> (aref (get request :args) 1) 0))
                (setq shortRead false message (Object/assign (js-object) message (js-object :request (Object/assign (js-object) request
                  (js-object :args (js-array (aref (get request :args) 0) (1- (aref (get request :args) 1))))))))))
            ((and (not (nullish? request)) (= (get request :method) "write"))
              (let* ((text (aref (get request :args) 0)) (padding (if (js-call text :endsWith "==") 2 (if (js-call text :endsWith "=") 1 0))))
                (js-call packets :push (js-object :method "write" :offset (aref (get request :args) 1) :length (- (/ (* (get text :length) 3) 4) padding) :units (get text :length)))))))
          (Reflect/apply post receiver (js-call (js-array message) :concat rest)))))
      (put globalThis.Buffer :from (funcall receiverRest (lambda (receiver args)
        (when (= (aref args 1) "base64")
          (assert-eq (funcall (js* "(value) => typeof value") (aref args 0)) "string") (js-call decoded :push (get (aref args 0) :length))
          (assert (<= (get (aref args 0) :length) 87384)))
        (Reflect/apply from receiver args))))
      (try
        (setq a (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda () 0))))))
        (assert-eq (js-call a :invoke "grow" 3) 1)
        (js-call (js-array 0 1 65535 65536 65537 131072 196625) :forEach (lambda (length)
          (let* ((backing (Uint8Array/from (js-object :length (+ length 11)) (lambda (unused index) (bit-and (+ (* index 37) 11) 255))))
                 (input (js-call backing :subarray 7 (+ 7 length))) (expected (Uint8Array/from input)) (offset 3))
            (setq packets (js-array) onSize (lambda () (js-call backing :fill 255)))
            (assert-eq (js-call a :write input offset) undefined)
            (let ((writes (js-call packets :filter (lambda (item) (= (get item :method) "write")))) (index 0))
              (assert-eq (get (aref packets 0) :method) "size") (assert-eq (get writes :length) (Math/max 1 (Math/ceil (/ length 65536))))
              (while (< index (get writes :length))
                (assert-eq (get (aref writes index) :offset) (+ offset (* index 65536)))
                (assert-eq (get (aref writes index) :length) (Math/min 65536 (- length (* index 65536))))
                (assert (<= (get (aref writes index) :units) 87384)) (setq index (1+ index))))
            (setq packets (js-array) decoded (js-array))
            (let* ((actual (js-call a :read offset length)) (reads (js-call packets :filter (lambda (item) (= (get item :method) "read")))) (index 0))
              (assert (funcall hostInstanceof actual globalThis.Uint8Array)) (assert-eq (get actual :byteLength) length) (same actual expected)
              (assert-eq (get (aref packets 0) :method) "size") (assert-eq (get reads :length) (Math/max 1 (Math/ceil (/ length 65536))))
              (assert-eq (get decoded :length) (get reads :length))
              (while (< index (get reads :length))
                (assert-eq (get (aref reads index) :offset) (+ offset (* index 65536)))
                (assert-eq (get (aref reads index) :length) (Math/min 65536 (- length (* index 65536)))) (setq index (1+ index)))
              (js-call actual :fill 0) (same (js-call a :read offset length) expected "a returned read view never aliases native memory")))))
        (let* ((end (get a :byteLength)) (tail (js-call a :read (- end 8) 8)))
          (setq packets (js-array)) (throws (lambda () (js-call a :write (js-call (new globalThis.Uint8Array 65537) :fill 9) (- end 65536))) globalThis.RangeError)
          (same (js-call packets :map (lambda (item) (get item :method))) (js-array "size") "reject the whole range before writing its first block")
          (same (js-call a :read (- end 8) 8) tail)
          (setq packets (js-array)) (throws (lambda () (js-call a :read (- end 65536) 65537)) globalThis.RangeError)
          (same (js-call packets :map (lambda (item) (get item :method))) (js-array "size"))
          (setq packets (js-array)) (assert-eq (js-call a :write (new globalThis.Uint8Array 0) end) undefined)
          (same packets (js-array (js-object :method "size") (js-object :method "write" :offset end :length 0 :units 0)))
          (setq packets (js-array)) (same (js-call a :read end 0) (new globalThis.Uint8Array 0))
          (same packets (js-array (js-object :method "size") (js-object :method "read" :offset end :length 0)))
          (js-call (js-array (lambda () (js-call a :read (1+ end) 0)) (lambda () (js-call a :write (new globalThis.Uint8Array 0) (1+ end)))) :forEach (lambda (action)
            (setq packets (js-array)) (throws action globalThis.RangeError) (same (js-call packets :map (lambda (item) (get item :method))) (js-array "size")))))
        (let ((expected (js-call a :read 3 65535)))
          (setq shortRead t) (throws (lambda () (js-call a :read 3 65535)) (new globalThis.RegExp "native memory read returned an invalid byte count"))
          (same (js-call a :read 3 65535) expected))
        (js-call a :close) (js-call a :close) (closed (lambda () (js-call a :read 0 0))) (closed (lambda () (js-call a :write (new globalThis.Uint8Array 0))))
        (finally (when a (js-call a :close)) (put prototype :postMessage post) (put globalThis.Buffer :from from)))))
  (defasync chunkedCallbacks (library signatures configuration)
    (let* ((expected (Uint8Array/from (js-object :length 131073) (lambda (unused index) (bit-and (+ (* index 19) 3) 255))))
           (a undefined) (b undefined) (mode "normal") (reason undefined) (calls 0))
      (try
        (setq b (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda () 0))))))
        (js-call b :invoke "grow" 3)
        (setq a (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda (index heap argv)
          (assert-eq index 0) (assert-eq heap 17) (assert-eq argv 23) (setq calls (1+ calls))
          (js-call a :write expected 5)
          (let ((actual (js-call a :read 5 (get expected :length))))
            (same actual expected) (js-call actual :fill 0) (same (js-call a :read 5 (get expected :length)) expected))
          (same (js-call b :read 5 (get expected :length)) (new globalThis.Uint8Array (get expected :length)) "another context never observes partial or complete writes")
          (cond ((= mode "throw") (throw reason)) ((= mode "close") (js-call a :close) 7) (t 42))))))))
        (js-call a :invoke "grow" 3) (assert-eq (js-call a :invoke "notify" 17 23) 42)
        (js-call (js-array false (Object/freeze (js-object :original "chunked callback"))) :forEach (lambda (value)
          (setq reason value mode "throw")
          (let ((caught false)) (try (js-call a :invoke "notify" 17 23) (catch error (setq caught t) (js-call assert :strictEqual error reason))) (assert caught))
          (setq mode "normal") (assert-eq (js-call a :invoke "notify" 17 23) 42)))
        (setq mode "close") (assert-eq (js-call a :invoke "notify" 17 23) 7) (assert-eq calls 6)
        (closed (lambda () (js-call a :read 0 0))) (closed (lambda () (js-call a :write (new globalThis.Uint8Array 0))))
        (same (js-call b :read 5 (get expected :length)) (new globalThis.Uint8Array (get expected :length)))
        (finally (when a (js-call a :close)) (when b (js-call b :close))))))
  (defasync boundaries (library signatures configuration)
    (let ((a (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda () 0)))))))
      (try
        (js-call (js-array undefined nil false (js-object) "1" (js* "1n") globalThis.NaN globalThis.Infinity -1 0.5 4294967296) :forEach
          (lambda (bad) (throws (lambda () (js-call a :invoke "read32" bad)) globalThis.RangeError)))
        (throws (lambda () (js-call a :invoke (funcall globalThis.Symbol "missing"))) globalThis.TypeError)
        (throws (lambda () (js-call a :invoke "missing")) globalThis.TypeError)
        (throws (lambda () (js-call a :invoke "read32")) globalThis.TypeError)
        (throws (lambda () (js-call a :invoke "read32" 0 1)) globalThis.TypeError)
        (js-call (js-array undefined nil "0" globalThis.NaN globalThis.Infinity -1 0.5 (js* "1n")) :forEach (lambda (bad)
          (throws (lambda () (js-call a :read bad 1)) globalThis.RangeError) (throws (lambda () (js-call a :write (Uint8Array/of 1) bad)) globalThis.RangeError)))
        (throws (lambda () (js-call a :write (js-array))) globalThis.TypeError)
        (throws (lambda () (js-call a :read 65535 2)) globalThis.RangeError)
        (throws (lambda () (js-call a :invoke "read32" 65535)) (get globalThis.WebAssembly :RuntimeError))
        (js-call a :invoke "write32" 0 42) (assert-eq (js-call a :invoke "read32" 0) 42)
        (finally (js-call a :close))))
    (await (js-call assert :rejects (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda () 0) :bunExecutable (str library ".missing-runtime"))))
      (lambda (error) (= (get error :code) "ENOENT")))))
  (defasync unicodePackets (library signatures configuration debug filename)
    (let ((a (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda () 0) :debug debug :trapSites (get debug :trapSites)))))))
      (try
        (let ((trapped undefined))
          (try (js-call a :invoke "read32" 65535) (catch error (setq trapped error)))
          (assert (funcall hostInstanceof trapped (get globalThis.WebAssembly :RuntimeError)))
          (assert (Array/isArray (get trapped :eliscriptFrames))) (assert (Array/isArray (get trapped :eliscriptSourceFrames)))
          (let* ((frame (js-call (get trapped :eliscriptSourceFrames) :find (lambda (item)
                    (and (not (nullish? (get item :source))) (= (get (get item :source) :function) "read32")))))
                 (original (js-call (get debug :functions) :find (lambda (fn) (= (get fn :name) "read32")))))
            (assert frame "real native read32 trap did not retain its instruction map")
            (assert-eq (get (get (get frame :source) :span) :filename) filename) (assert-eq (get (get frame :source) :source) filename)
            (assert (and (>= (get (get (get frame :source) :span) :start) (get (get original :span) :start))
                         (<= (get (get (get frame :source) :span) :end) (get (get original :span) :end))))
            (assert (js-call (js-call (get debug :functions) :concat (get debug :ranges)) :some (lambda (item)
              (and (get item :span) (= (JSON/stringify (get item :span)) (JSON/stringify (get (get frame :source) :span)))))) "transport changed the emitted source span")))
        (js-call a :invoke "write32" 0 42) (assert-eq (js-call a :invoke "read32" 0) 42) (assert-eq (js-call a :invoke "notify" 0 0) 0)
        (finally (js-call a :close)))))
  (defasync callbacks (library signatures configuration)
    (let ((mode "reenter") (thrown undefined) (calls 0) (a undefined))
      (setq a (await (openNativeMemory library signatures (config configuration (js-object :hostCall (lambda (index heap argv)
        (assert-eq index 0) (assert-eq heap 17) (assert-eq argv 23) (setq calls (1+ calls))
        (cond ((= mode "throw") (throw thrown)) ((= mode "close") (js-call a :close) 7)
          (t (js-call a :invoke "write32" 32 2147483649) (assert-eq (js-call a :invoke "read32" 32) 2147483649)
             (same (js-call a :read 32 4) (Uint8Array/of 1 0 0 128)) (js-call a :write (Uint8Array/of 42) 32) (js-call a :invoke "read32" 32)))))))))
      (try
        (assert-eq (js-call a :invoke "notify" 17 23) 2147483690)
        (js-call (js-array undefined nil false 0 (js* "-0") globalThis.NaN (js* "1n") (Object/freeze (js-object :tag "host")) (new globalThis.URIError "host failure")) :forEach (lambda (value)
          (setq thrown value mode "throw")
          (let ((caught false)) (try (js-call a :invoke "notify" 17 23) (catch error (setq caught t) (assert (Object/is error thrown)))) (assert caught))
          (setq mode "reenter") (assert-eq (js-call a :invoke "notify" 17 23) 2147483690)))
        (setq mode "close") (assert-eq (js-call a :invoke "notify" 17 23) 7) (assert-eq calls 20)
        (closed (lambda () (js-call a :invoke "read32" 0)))
        (finally (js-call a :close)))))
  (defasync main ()
    (assert-eq (get (get process :versions) :bun) undefined)
    (let* ((input (JSON/parse (await (readFile (aref (get process :argv) 2) "utf8")))) (mode (get input :mode))
           (library (get input :library)) (signatures (get input :signatures)) (configuration (get input :configuration)))
      (cond ((= mode "bulk") (await (bulk library signatures configuration)))
            ((= mode "bounded-bulk") (await (boundedBulk library signatures configuration)))
            ((= mode "chunked-callbacks") (await (chunkedCallbacks library signatures configuration)))
            ((= mode "boundaries") (await (boundaries library signatures configuration)))
            ((= mode "unicode-packets") (await (unicodePackets library signatures configuration (get input :debug) (get input :filename))))
            ((= mode "callbacks") (await (callbacks library signatures configuration)))
            (t (throw (new globalThis.Error (str "unknown native Node test mode: " mode)))))
      (js-call (get process :stdout) :write "native-node-verified\n")))
  (main))
