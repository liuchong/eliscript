(module tests.fixtures.native-debug-options-host
  (import "node:process" :default process)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "../../tools/backends/native-memory.mjs" openNativeMemory)
  (import "../../tools/backends/compiler-debug.mjs" createCompilerDebugMap)
  (defconst hostInstanceof (js* "(value, constructor) => value instanceof constructor"))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defconst constructor (js* "(implementation) => function() { return implementation(); }"))
  (defasync main ()
    (js-call assert :equal (get (get process :versions) :bun) undefined)
    (js-call assert :equal (funcall hostTypeof (get (get process :versions) :v8)) "string")
    (let* ((parameters (JSON/parse (await (readFile (aref (get process :argv) 2) "utf8"))))
           (library (get parameters :library)) (signatures (get parameters :signatures)) (original (get parameters :original)) (machineFrames (get parameters :machineFrames))
           (configuration (js-object :initialPages 1 :maximumPages 1 :nativeTarget (get parameters :target) :trapSites (get original :trapSites) :bunExecutable (get parameters :bunExecutable)))
           (Module (get globalThis.WebAssembly :Module)) (Instance (get globalThis.WebAssembly :Instance)))
      (letfn ((trap (runtime)
        (let ((thrown undefined))
          (try (js-call runtime :invoke "crash") (catch error (setq thrown error)))
          (assert (funcall hostInstanceof thrown WebAssembly.RuntimeError)) (js-call assert :equal (get thrown :message) "memory access out of bounds")
          (js-call assert :deepEqual (get thrown :eliscriptFrames) machineFrames) thrown)))
        (put globalThis.WebAssembly :Module (funcall constructor (lambda () (throw (new globalThis.Error "native debug fixture substituted WASM")))))
        (put globalThis.WebAssembly :Instance (funcall constructor (lambda () (throw (new globalThis.Error "native debug fixture substituted WASM")))))
        (try
          (let ((options (js-array (js-object) (js-object :debug undefined) (js-object :debug false))) (index 0))
            (while (< index (get options :length))
              (let ((runtime (await (openNativeMemory library signatures (Object/assign (js-object) configuration (aref options index))))))
                (try (js-call assert :equal (get runtime :byteLength) 65536)
                  (let ((repeat 0)) (while (< repeat 2)
                    (js-call assert :equal (Object/hasOwn (trap runtime) "eliscriptSourceFrames") false)
                    (js-call assert :equal (js-call runtime :invoke "safe") 42) (setq repeat (1+ repeat))))
                  (finally (js-call runtime :close)))
                (js-call assert :throws (lambda () (js-call runtime :invoke "safe")) (new globalThis.RegExp "closed")))
              (setq index (1+ index))))
          (let* ((supplied (funcall globalThis.structuredClone original)) (saved (funcall globalThis.structuredClone supplied))
                 (expected (js-call (createCompilerDebugMap saved) :mapFrames machineFrames)))
            (js-call assert :equal (get (get (aref expected 0) :source) :function) "crash")
            (js-call assert :equal (get (get (get (aref expected 0) :source) :span) :filename) (get parameters :filename))
            (let ((runtime (await (openNativeMemory library signatures (Object/assign (js-object) configuration (js-object :debug supplied))))))
              (js-call assert :deepEqual supplied saved)
              (put (get supplied :functions) :length 0) (put (get supplied :ranges) :length 0) (put (get supplied :sources) :length 0) (put (get supplied :codeSection) :size 0)
              (try (let ((repeat 0)) (while (< repeat 2)
                (js-call assert :deepEqual (get (trap runtime) :eliscriptSourceFrames) expected)
                (js-call assert :equal (js-call runtime :invoke "safe") 42) (setq repeat (1+ repeat))))
                (finally (js-call runtime :close)))))
          (let ((values (js-array nil t 0 "false" (js-array) (js-object))) (index 0))
            (while (< index (get values :length))
              (await (js-call assert :rejects (openNativeMemory library signatures (Object/assign (js-object) configuration (js-object :debug (aref values index))))
                (lambda (error) (assert (funcall hostInstanceof error globalThis.TypeError)) (js-call assert :equal (get error :message) "unsupported compiler instruction map") t)))
              (setq index (1+ index))))
          (finally (put globalThis.WebAssembly :Module Module) (put globalThis.WebAssembly :Instance Instance))))
      (js-call (get process :stdout) :write "native-debug-options-node-verified\n")))
  (main))
