(module tests.fixtures.managed-stdlib-json-host
  (import "node:process" :default process)
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../helpers/managed-stdlib-corpus.mjs" inputs parseBoundaryCases encodeBoundaryCases)
  (import "../helpers/managed-json-contract.mjs" checkAll finish)
  (defasync main ()
    (let ((mode (aref (get process :argv) 2)))
      (if (= mode "observe")
        (let ((m (await (funcall (js* "(url) => import(url)") (aref (get process :argv) 3)))))
          (console/log (JSON/stringify (js-object :values (js-call m :values) :identities (js-call m :identities)
            :json (js-call inputs :map (lambda (x) (js-call m :json_case x))) :boundaries (js-call m :json_boundaries) :order (js-call m :order_and_identity)
            :errors (js-call (parseBoundaryCases) :map (lambda (x) (Reflect/apply (get m :parse_report) m x)))
            :encoded (js-call (encodeBoundaryCases) :map (lambda (x) (js-call m :encode_report x)))))))
        (let* ((runtime (await (funcall (js* "(url) => import(url)") "../../tools/backends/managed-runtime.mjs")))
               (bytes (readFileSync (aref (get process :argv) 3)))
               (parameters (JSON/parse (readFileSync (aref (get process :argv) 4) "utf8")))
               (a (progn (js-call assert :deepEqual (WebAssembly.Module/imports (new WebAssembly.Module bytes)) (js-array))
                 (js-call runtime :instantiateManagedRuntime bytes (get parameters :options)))))
          (js-call a :auto 65536) (try (checkAll a (get parameters :inputs) (get parameters :expected)) (finally (finish a)))))))
  (main))
