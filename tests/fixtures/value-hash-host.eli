(module tests.fixtures.value-hash-host
  (import "../../runtime/core/value.mjs" equalValues hashValue)
  (import "../../runtime/core/identifier.mjs" eliscriptSymbol keyword)
  (import "../../runtime/core/vector.mjs" persistentVector)
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/set.mjs" persistentHashSet)
  (defconst nestedLeft (persistentVector nil undefined t 42 "eliscript" (persistentVector "nested" globalThis.Number.NaN (js* "-0"))))
  (defconst nestedRight (persistentVector nil undefined t 42 "eliscript" (persistentVector "nested" globalThis.Number.NaN 0)))
  (defconst orderedMap (persistentHashMap (js-array "alpha" 1) (js-array (persistentVector "key") (persistentVector 2 3)) (js-array "omega" globalThis.Number.NaN)))
  (defconst reversedMap (persistentHashMap (js-array "omega" globalThis.Number.NaN) (js-array (persistentVector "key") (persistentVector 2 3)) (js-array "alpha" 1)))
  (defconst collisionMap (persistentHashMap (js-array "key-50691" "left") (js-array "key-194634" "right")))
  (defconst orderedSet (persistentHashSet "alpha" (persistentVector "key") "omega")) (defconst reversedSet (persistentHashSet "omega" (persistentVector "key") "alpha"))
  (defconst collisionSet (persistentHashSet "key-50691" "key-194634"))
  (js-call globalThis.console :log (JSON/stringify (js-object
    :scalars (js-object :null (hashValue nil) :undefined (hashValue undefined) :false (hashValue false) :true (hashValue t) :zero (hashValue 0) :negativeZero (hashValue (js* "-0"))
      :one (hashValue 1) :negativeOne (hashValue -1) :fraction (hashValue 1.5) :nan (hashValue globalThis.Number.NaN) :positiveInfinity (hashValue globalThis.Number.POSITIVE_INFINITY)
      :negativeInfinity (hashValue globalThis.Number.NEGATIVE_INFINITY) :maxSafeInteger (hashValue globalThis.Number.MAX_SAFE_INTEGER)
      :emptyString (hashValue "") :ascii (hashValue "Eliscript") :unicode (hashValue "值语义🙂") :zeroBigInt (hashValue (js* "0n"))
      :negativeBigInt (hashValue (js* "-12345678901234567890n")) :globalSymbol (hashValue (js-call globalThis.Symbol :for "eliscript/value")))
    :identifiers (js-object :keyword (hashValue (keyword "article/title")) :unqualifiedKeyword (hashValue (keyword "title"))
      :symbol (hashValue (eliscriptSymbol "article/title")) :unqualifiedSymbol (hashValue (eliscriptSymbol "title")))
    :vectors (js-object :empty (hashValue (persistentVector)) :flat (hashValue (persistentVector 1 2 3 4)) :nested (hashValue nestedLeft))
    :maps (js-object :ordered (hashValue orderedMap) :reversed (hashValue reversedMap) :collision (hashValue collisionMap))
    :sets (js-object :empty (hashValue (persistentHashSet)) :flat (hashValue (persistentHashSet 1 2 3 4))
      :ordered (hashValue orderedSet) :reversed (hashValue reversedSet) :collision (hashValue collisionSet))
    :invariants (js-object :nanEqual (equalValues globalThis.Number.NaN globalThis.Number.NaN) :zerosEqual (equalValues 0 (js* "-0"))
      :nestedEqual (equalValues nestedLeft nestedRight) :nestedHashesEqual (= (hashValue nestedLeft) (hashValue nestedRight))
      :mapsEqual (equalValues orderedMap reversedMap) :mapHashesEqual (= (hashValue orderedMap) (hashValue reversedMap))
      :setsEqual (equalValues orderedSet reversedSet) :setHashesEqual (= (hashValue orderedSet) (hashValue reversedSet))
      :symbolsEqual (equalValues (eliscriptSymbol "article/title") (eliscriptSymbol "article" "title"))
      :identifierCategoriesDistinct (not (equalValues (keyword "article/title") (eliscriptSymbol "article/title"))))))))
