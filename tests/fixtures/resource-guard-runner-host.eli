(module tests.fixtures.resource-guard-runner-host
  (import "node:process" :default process)
  (import "node:fs" existsSync)
  (import "../../tools/testing/resource-supervisor.mjs" startResourceSupervisor)
  (defasync main ()
    (let* ((marker (aref (get process :argv) 2)) (child (aref (get process :argv) 3))
           (s (await (startResourceSupervisor))) (outcome undefined))
      (js-call (js-call s :run (js-object :id "owned" :file "owned.test.mjs" :command "node" :args (js-array child "marker" marker) :cwd (js-call process :cwd) :env (get process :env)))
        :then (lambda (value) (setq outcome value)))
      (while (not (existsSync marker))
        (when (or (get s :failure) outcome)
          (throw (new globalThis.Error (str "owned command failed before startup: " (JSON/stringify (if (nullish? (get s :failure)) outcome (get s :failure)))))))
        (await (new globalThis.Promise (lambda (resolve) (globalThis.setTimeout resolve 10)))))
      (js-call process :kill (get process :pid) "SIGKILL")))
  (main))
