(module tests.fixtures.response-owned-native-host
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve dirname)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (import "../../tools/backends/compiler-session.mjs" createCompilerSession encodeCompilerIR requestCompilerBuildProduct)
  (import "../../tools/backends/compiler-build.mjs" buildIndependentCompiler compilerMetadataDigest)
  (import "../../tools/backends/compiler-metadata.mjs" readCompilerMetadata)
  (import "../helpers/response-product-contract.mjs" producerGraph assertCompleteProductFiles executeNativeAnswer)
  (defconst load (js* "(specifier) => import(specifier)"))
  (defvar phaseCount 0) (defvar stage undefined)
  (defun phaseMemory (phase &rest __host_forwarded_arguments_1)
    (let* ((byteLength (aref __host_forwarded_arguments_1 0)))
    (when (nullish? byteLength) (setq byteLength 0))
    (let ((before phaseCount)) (setq phaseCount (+ phaseCount 1))
      (when (< before 24)
        (try (let ((usage (js-call process :memoryUsage)))
          (js-call globalThis.console :error (JSON/stringify (js-object :phase (str "owned-native-" phase) :stage stage :byteLength byteLength :rss (get usage :rss) :heapUsed (get usage :heapUsed) :heapTotal (get usage :heapTotal)))))
          (catch ignored nil))))))
  (defasync main ()
    (let* ((args (get process :argv)) (metadataPath (aref args 2)) (directory (dirname metadataPath))
      (reference (JSON/parse (await (readFile (aref args 4) "utf8"))))
      (metadata (await (readCompilerMetadata metadataPath)))
      (artifact (Object/assign (js-object) metadata (js-object :path (resolve directory (get metadata :path)) :runtimePath (resolve directory (get metadata :runtimePath)))))
      (graph undefined) (actual undefined) (state undefined) (driver undefined) (producer undefined)
      (nativeTarget (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos")) (phaseResult undefined))
      (setq stage (aref args 3)) (phaseMemory "start")
      (setq graph (await (producerGraph artifact))) (setq actual (await (funcall load (get (pathToFileURL (get artifact :path)) :href))))
      (setq driver (Object/assign (js-object) actual (js-object :compiler_session_new (lambda (&rest args)
        (setq state (Reflect/apply (get actual :compiler_session_new) actual args))
        (let ((observed (new globalThis.Set (js-array "managed-lower-start" "managed-lower-complete" "response-events-start" "response-events-complete"))))
          (put state :phaseObserver (lambda (phase) (when (js-call observed :has phase) (phaseMemory (str "compiler-" phase)))))) state))))
      (setq producer (await (createCompilerSession (js-object :host "javascript" :compiler driver))))
      (try
        (if (= stage "reference")
          (let* ((wire (js-object :host (get producer :host) :request (lambda (&rest args)
            (let* ((input (aref args 0)) (name (if (nullish? input) undefined (get input :operation)))
              (operation (if (js-call (js-array "runtime" "capabilities" "project" "cached-ir") :includes name) name "other")))
              (phaseMemory (str "wire-" operation "-start"))
              (try (let ((result (Reflect/apply (get producer :request) producer args))) (phaseMemory (str "wire-" operation "-end")) result)
                (catch error (phaseMemory (str "wire-" operation "-throw")) (throw error)))))))
            (observedBuildPhases (new globalThis.Set (js-array "project-start" "project-complete" "retained-ir-start" "retained-ir-complete"
              "file-identities-start" "file-identities-complete" "product-identity-start" "product-identity-complete" "debug-file-start" "debug-file-complete" "artifact-metadata-start" "artifact-metadata-complete")))
            (onPhase (lambda (phase counts) (when (js-call observedBuildPhases :has phase)
              (phaseMemory (str "builder-" phase) (if (and (not (nullish? counts)) (Number/isSafeInteger (get counts :byteLength))) (get counts :byteLength) 0))))))
            (phaseMemory "reference-build-start")
            (setq phaseResult (await (funcall (async ()
              (let ((built (await (buildIndependentCompiler (js-object :host "native" :nativeTarget nativeTarget :sources graph :session wire :debug t :onPhase onPhase :outputRoot (resolve directory "wire-native-debug-product"))))))
                (phaseMemory "reference-build-complete" (get (get built :bytes) :byteLength))
                (await (executeNativeAnswer built nativeTarget t)) (phaseMemory "reference-execution-complete" (get (get built :bytes) :byteLength))
                (let ((cachedRequest (js-object :operation "cached-ir" :kind "module" :id (get graph :entry) :revision (get state :projectRevision))))
                  (js-object :path (get built :path) :metadataPath (get built :metadataPath) :debugPath (get built :debugPath)
                    :typedDigest (compilerMetadataDigest (get built :typed)) :descriptorDigest (compilerMetadataDigest (get built :descriptor))
                    :productIdentity (get built :productIdentity) :fileIdentity (get built :artifactIdentity) :functions (js-length (get (get built :typed) :functions))
                    :cached (js-call producer :request cachedRequest))))))))
            (phaseMemory "reference-identities-complete"))
          (progn
            (js-call assert :equal stage "owned") (phaseMemory "owned-build-start")
            (let* ((built (await (buildIndependentCompiler (js-object :host "native" :nativeTarget nativeTarget :sources graph :session producer :debug t :outputRoot (resolve directory "owned-native-debug-product")))))
              (cachedRequest (js-object :operation "cached-ir" :kind "module" :id (get graph :entry) :revision (get state :projectRevision)))
              (cached (get reference :cached)))
              (phaseMemory "owned-build-complete" (get (get built :bytes) :byteLength))
              (js-call assert :deepEqual (js-call producer :request cachedRequest) cached "both real complete builds publish the same cached module record")
              (js-call assert :equal (js-length (get (get built :typed) :functions)) (get reference :functions))
              (js-call assert :equal (compilerMetadataDigest (get built :typed)) (get reference :typedDigest) "all typed nodes and IEEE values")
              (js-call assert :equal (compilerMetadataDigest (get built :descriptor)) (get reference :descriptorDigest))
              (js-call assert :deepEqual (get built :productIdentity) (get reference :productIdentity)) (js-call assert :deepEqual (get built :artifactIdentity) (get reference :fileIdentity))
              (phaseMemory "complete-files-comparison-start")
              (await (assertCompleteProductFiles (get built :path) (get reference :path))) (await (assertCompleteProductFiles (get built :debugPath) (get reference :debugPath)))
              (await (assertCompleteProductFiles (get built :metadataPath) (get reference :metadataPath))) (phaseMemory "complete-files-comparison-complete")
              (await (executeNativeAnswer built nativeTarget t)) (phaseMemory "owned-execution-complete" (get (get built :bytes) :byteLength))
              (let* ((fn (js-call (get (get built :typed) :functions) :find (lambda (fn) (get fn :source))))
                (pending (js-call (get (get state :runtime) :body) :slice)) (original undefined))
                (assert fn "complete native metadata retains original source records")
                (while (and (> (js-length pending) 0) (= original undefined))
                  (let ((node (js-call pending :pop)))
                    (if (and (= (get node :kind) "function-declaration") (= (get node :value) (get (get fn :source) :value))) (setq original node)
                      (when (= (get node :kind) "module-declaration") (Reflect/apply (get pending :push) pending (get node :children))))))
                (assert original) (js-call assert :notStrictEqual (get fn :source) original)
                (let ((name (get original :value)) (line (if (nullish? (get original :span)) undefined (get (get original :span) :line))))
                  (put (get fn :source) :value "private-returned-source-mutation") (when (get (get fn :source) :span) (put (get (get fn :source) :span) :line 999))
                  (js-call assert :equal (get original :value) name) (js-call assert :equal (if (nullish? (get original :span)) undefined (get (get original :span) :line)) line))
                (js-call assert :deepEqual (js-call producer :request cachedRequest) cached))
              (phaseMemory "source-cache-isolation-complete")
              (let ((wrapped (await (createCompilerSession (js-object :host "javascript" :compiler (Object/assign (js-object) actual (js-object :compiler_session_request
                (lambda (&rest args) (Reflect/apply (get actual :compiler_session_request) actual args)))))))))
                (try
                  (let ((invalid (js-object :operation "project" :target "native" :nativeTarget nativeTarget :modules (js-array (js-object :id "broken.mjs" :source "(defun broken (")) :entry "broken.mjs")) (first undefined))
                    (try (js-call wrapped :request invalid) (catch error (setq first error))) (assert first)
                    (js-call assert :throws (lambda () (requestCompilerBuildProduct wrapped invalid)) (lambda (error)
                      (js-call assert :equal (get error :message) (get first :message)) (js-call assert :deepEqual (get error :eliscriptDiagnostic) (get first :eliscriptDiagnostic)) t)))
                  (finally (js-call wrapped :close))))
              (phaseMemory "wrapped-failure-recovery-complete") (setq phaseResult (js-object :host "native" :complete t)))))
        (finally (js-call producer :close)))
      (js-call assert :equal (get producer :closed) t) (phaseMemory "closed") (js-call (get process :stdout) :write (str (encodeCompilerIR phaseResult) "\n"))))
  (main))
