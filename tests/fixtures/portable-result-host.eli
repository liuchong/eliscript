(module tests.fixtures.portable-result-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst moduleUrl (pathToFileURL (aref (get globalThis.process :argv) 2)))
  (defvar resultModule undefined)
  (defvar vectorModule undefined)
  (defvar mapModule undefined)
  (defvar valueModule undefined)
  (defvar dataTextModule undefined)
  (defvar andThen undefined)
  (defvar collectResults undefined)
  (defvar err undefined)
  (defvar isErr undefined)
  (defvar fold undefined)
  (defvar mapErr undefined)
  (defvar mapOk undefined)
  (defvar ok undefined)
  (defvar isOk undefined)
  (defvar orElse undefined)
  (defvar resultPayload undefined)
  (defvar isResult undefined)
  (defvar traverseResults undefined)
  (defvar unwrapOr undefined)
  (defvar unwrapOrElse undefined)
  (defvar emptyVector undefined)
  (defvar vectorConj undefined)
  (defvar vectorCount undefined)
  (defvar vectorFromArray undefined)
  (defvar vectorToArray undefined)
  (defvar mapGet undefined)
  (defvar valueEqual undefined)
  (defvar valueHash undefined)
  (defvar valueMapFromEntries undefined)
  (defvar dataTextResultValue undefined)
  (defvar printValue undefined)
  (defvar readValue undefined)
  (defvar okFalse undefined)
  (defvar okNil undefined)
  (defvar okUndefined undefined)
  (defvar failed undefined)
  (defvar okCalls undefined)
  (defvar errorCalls undefined)
  (defvar mappedOk undefined)
  (defvar untouchedError undefined)
  (defvar mappedError undefined)
  (defvar untouchedOk undefined)
  (defvar collected undefined)
  (defvar collectionFailure undefined)
  (defvar failedCollection undefined)
  (defvar scaleValues undefined)
  (defvar scaleCalls undefined)
  (defvar traversed undefined)
  (defvar traversedValues undefined)
  (defvar earlyFailure undefined)
  (defvar earlyCalls undefined)
  (defvar early undefined)
  (defvar invalidCalls undefined)
  (defvar invalidTraversal undefined)
  (defvar reconstructedOk undefined)
  (defvar equivalentOk undefined)
  (defvar resultKeyMap undefined)
  (defvar canonicalText undefined)
  (defvar decodedResult undefined)
  (defvar generatedInvariant undefined)
  (defasync run-host-main ()
    (setq resultModule (await (funcall load-module (get moduleUrl :href))))
    (setq vectorModule (await (funcall load-module (get (new globalThis.URL "./persistent-vector.eli" moduleUrl) :href))))
    (setq mapModule (await (funcall load-module (get (new globalThis.URL "./persistent-map.eli" moduleUrl) :href))))
    (setq valueModule (await (funcall load-module (get (new globalThis.URL "./value.eli" moduleUrl) :href))))
    (setq dataTextModule (await (funcall load-module (get (new globalThis.URL "./data-text.eli" moduleUrl) :href))))
    (setq andThen resultModule.and_then)
    (setq collectResults resultModule.collect_results)
    (setq err resultModule.err)
    (setq isErr resultModule.err_QMARK_)
    (setq fold resultModule.fold)
    (setq mapErr resultModule.map_err)
    (setq mapOk resultModule.map_ok)
    (setq ok resultModule.ok)
    (setq isOk resultModule.ok_QMARK_)
    (setq orElse resultModule.or_else)
    (setq resultPayload resultModule.result_payload)
    (setq isResult resultModule.result_QMARK_)
    (setq traverseResults resultModule.traverse_results)
    (setq unwrapOr resultModule.unwrap_or)
    (setq unwrapOrElse resultModule.unwrap_or_else)
    (setq emptyVector vectorModule.empty_persistent_vector)
    (setq vectorConj vectorModule.persistent_vector_conj)
    (setq vectorCount vectorModule.persistent_vector_count)
    (setq vectorFromArray vectorModule.persistent_vector_from_array)
    (setq vectorToArray vectorModule.persistent_vector_to_array)
    (setq mapGet mapModule.persistent_map_get)
    (setq valueEqual valueModule.value_equal_QMARK_)
    (setq valueHash valueModule.value_hash)
    (setq valueMapFromEntries valueModule.value_map_from_entries)
    (setq dataTextResultValue dataTextModule.data_text_result_value)
    (setq printValue dataTextModule.print_value)
    (setq readValue dataTextModule.read_value)
    (setq okFalse (ok false))
    (setq okNil (ok nil))
    (setq okUndefined (ok undefined))
    (setq failed (err "failed"))
    (setq okCalls 0)
    (setq errorCalls 0)
    (setq mappedOk (mapOk (lambda (value) (setq okCalls (1+ okCalls)) (+ value 1)) (ok 41)))
    (setq untouchedError (mapOk (lambda () (setq okCalls (+ okCalls 100)) 0) failed))
    (setq mappedError (mapErr (lambda (value) (setq errorCalls (1+ errorCalls)) (str value "!")) failed))
    (setq untouchedOk (mapErr (lambda () (setq errorCalls (+ errorCalls 100)) "wrong") okFalse))
    (setq collected (collectResults (vectorFromArray (js-array (ok 1) (ok 2) (ok 3)))))
    (setq collectionFailure (err "stop"))
    (setq failedCollection (collectResults (vectorFromArray (js-array (ok 1) collectionFailure (ok 3)))))
    (setq scaleValues (emptyVector))
    (let ((index 0)) (while (< index 50000) (setq scaleValues (vectorConj scaleValues index) index (1+ index))))
    (setq scaleCalls 0)
    (setq traversed (traverseResults (lambda (value) (setq scaleCalls (1+ scaleCalls)) (ok (* value 2))) scaleValues))
    (setq traversedValues (resultPayload traversed))
    (setq earlyFailure (err "early"))
    (setq earlyCalls 0)
    (setq early (traverseResults (lambda (value) (setq earlyCalls (1+ earlyCalls)) (if (= value 12345) earlyFailure (ok value))) scaleValues))
    (setq invalidCalls 0)
    (setq invalidTraversal (traverseResults (lambda (value) (setq invalidCalls (1+ invalidCalls)) (if (= value 5) nil (ok value))) scaleValues))
    (setq reconstructedOk (ok (vectorFromArray (js-array 1 2 3))))
    (setq equivalentOk (ok (vectorFromArray (js-array 1 2 3))))
    (setq resultKeyMap (valueMapFromEntries (js-array (js-array reconstructedOk "present"))))
    (setq canonicalText (dataTextResultValue (printValue reconstructedOk)))
    (setq decodedResult (dataTextResultValue (readValue canonicalText)))
    (setq generatedInvariant t)
    (let ((index 0))
    (while (and generatedInvariant (< index 2000))
      (let ((left (if (= (% index 2) 0) (ok index) (err index))) (right (if (= (% index 2) 0) (ok index) (err index))))
        (when (or (not (valueEqual left right)) (not (= (valueHash left) (valueHash right)))) (setq generatedInvariant false)))
      (setq index (1+ index))))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :constructors (js-object :ok (isOk okFalse) :error (isErr failed) :result (and (isResult okNil) (isResult failed))
      :ordinaryMap (isResult (valueMapFromEntries (js-array (js-array "status" "ok")))) :crossStatus (and (not (isErr okFalse)) (not (isOk failed))))
    :payloads (js-object :false (= (resultPayload okFalse) false) :nil (= (resultPayload okNil) nil) :undefined (= (resultPayload okUndefined) undefined) :error (resultPayload failed))
    :combinators (js-object :mappedOk (resultPayload mappedOk) :mappedError (resultPayload mappedError) :untouchedError (= untouchedError failed) :untouchedOk (= untouchedOk okFalse)
      :okCalls okCalls :errorCalls errorCalls :andThen (resultPayload (andThen (lambda (value) (ok (+ value 1))) (ok 9)))
      :andThenErrorIdentity (= (andThen (lambda () (ok 0)) failed) failed) :orElse (resultPayload (orElse (lambda (value) (ok (get value :length))) failed))
      :orElseOkIdentity (= (orElse (lambda () (ok 0)) okFalse) okFalse) :foldOk (fold (lambda (value) (+ value 1)) (lambda () 0) (ok 4))
      :foldError (fold (lambda () 0) (lambda (value) (get value :length)) failed) :unwrapOk (= (unwrapOr 9 okFalse) false)
      :unwrapError (unwrapOr 9 failed) :unwrapElse (unwrapOrElse (lambda (value) (get value :length)) failed))
    :collection (js-object :values (vectorToArray (resultPayload collected)) :failureIdentity (= failedCollection collectionFailure) :invalidSource (collectResults (js-array)))
    :traversal (js-object :ok (isOk traversed) :count (vectorCount traversedValues) :first (aref (vectorToArray traversedValues) 0)
      :last (js-call (vectorToArray traversedValues) :at -1) :calls scaleCalls :earlyIdentity (= early earlyFailure) :earlyCalls earlyCalls :invalidResult (= invalidTraversal nil) :invalidCalls invalidCalls)
    :valueSemantics (js-object :equal (valueEqual reconstructedOk equivalentOk) :hashEqual (= (valueHash reconstructedOk) (valueHash equivalentOk))
      :mapLookup (mapGet resultKeyMap equivalentOk "missing") :generatedInvariant generatedInvariant)
    :dataText (js-object :decodedResult (isResult decodedResult) :equal (valueEqual decodedResult reconstructedOk)
      :stable (= (dataTextResultValue (printValue decodedResult)) canonicalText))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
