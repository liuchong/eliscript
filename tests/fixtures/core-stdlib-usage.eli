(module test.core-stdlib-usage
  (import "./stdlib/core/seq.mjs"
    butlast
    concat
    cycle
    dedupe
    distinct
    drop
    drop-last
    drop-while
    every?
    filter
    find
    first
    generate
    interpose
    keep
    keep-indexed
    last
    iterate
    map
    map-indexed
    mapcat
    sequence-nth
    partition-all
    partition-by
    reductions
    remove
    repeat
    repeatedly
    reverse
    range
    some
    split-at
    split-with
    take
    take-last
    take-nth
    take-while)
  (import "./stdlib/core/data.mjs"
    assoc-in
    count-by
    frequencies
    get-in
    group-by
    index-by
    merge
    merge-with
    select-keys
    update
    update-in
    zipmap)
  (import "./stdlib/core/collection.mjs" disj dissoc peek pop reduce-kv rseq)
  (import "./stdlib/core/transducer.mjs" eduction filtering mapping run!)
  (defconst values [0 1 2 3 4])
  (defvar generated-state 0)
  (defvar iteration-state 0)
  (defconst finite-range (range 1 8 2))
  (defconst open-range (take 5 (range)))
  (defconst repeated-values (take 4 (repeat "x")))
  (defconst produced-values
    (repeatedly
      3
      (lambda () (progn (setq generated-state (1+ generated-state)) generated-state))))
  (defconst iterated-values
    (take
      5
      (iterate
        (lambda (value) (progn (setq iteration-state (1+ iteration-state)) (* value 2)))
        1)))
  (defconst cycled-values (take 7 (cycle [1 2 3])))
  (defconst generated-values (generate 4 (lambda (index) (* index index))))
  (defconst pipeline-values
    (take
      5
      (eduction
        (mapping (lambda (value) (1+ value)))
        (filtering (lambda (value) (= (% value 2) 0)))
        (range))))
  (defvar pipeline-total 0)
  (defconst pipeline-run-result
    (run!
      (lambda (value) (setq pipeline-total (+ pipeline-total value)))
      (eduction (mapping (lambda (value) (* value 3))) [1 2 3])))
  (defconst mapped (map (lambda (value) (* value 2)) values))
  (defconst filtered (filter (lambda (value) (= (% value 2) 0)) values))
  (defconst removed (remove (lambda (value) (= value 2)) values))
  (defconst taken (take 3 values))
  (defconst dropped (drop 2 values))
  (defconst indexed-map (map-indexed (lambda (index value) (+ index value)) values))
  (defconst kept (keep (lambda (value) (if (= (% value 2) 0) value nil)) values))
  (defconst kept-indexed
    (keep-indexed
      (lambda (index value) (if (= (% value 2) 0) (+ index value) nil))
      values))
  (defconst taken-while (take-while (lambda (value) (< value 3)) values))
  (defconst dropped-while (drop-while (lambda (value) (< value 3)) values))
  (defconst sampled-sequence (take-nth 2 values))
  (defconst interposed-sequence (interpose "x" [1 2 3]))
  (defconst deduped (dedupe [1 1 2 1]))
  (defconst distinct-values (distinct [1 2 1 3 2]))
  (defconst flattened-values (mapcat (lambda (value) [value (* value 10)]) [1 2]))
  (defconst fixed-partitions (partition-all 2 values))
  (defconst keyed-partitions (partition-by (lambda (value) (% value 2)) [1 3 2 4 5]))
  (defconst intermediate-values
    (reductions (lambda (sum value) (+ sum value)) 0 [1 2 3]))
  (defconst reversed (reverse values))
  (defconst concatenated (concat [0 1] [2] nil [3 4]))
  (defconst first-even (find (lambda (value) (= (% value 2) 0)) [1 3 4 6]))
  (defconst zero-truth (some (lambda (value) (if (= value 2) 0 nil)) values))
  (defconst all-truth (every? (lambda (value) (if (= value 3) "" 0)) values))
  (defconst first-value (first values "missing"))
  (defconst last-value (last values "missing"))
  (defconst third-value (sequence-nth 2 values "missing"))
  (defconst tail-values (take-last 2 values))
  (defconst without-tail (drop-last 2 values))
  (defconst without-last (butlast values))
  (defconst split-position (split-at 2 values))
  (defconst split-prefix (split-with (lambda (value) (< value 3)) values))
  (defconst indexed (index-by (lambda (value) (% value 3)) values))
  (defconst grouped (group-by (lambda (value) (% value 2)) values))
  (defconst counted (count-by (lambda (value) (% value 2)) values))
  (defconst frequencies-result (frequencies [1 2 1 3 2 1]))
  (defconst nested-result (assoc-in nil ["profile" "visits"] 1))
  (defconst nested-update-result
    (update-in
      nested-result
      ["profile" "visits"]
      (lambda (value amount) (+ value amount))
      4))
  (defconst updated-result (update {"visits" 2} "visits" (lambda (value) (1+ value))))
  (defconst selected-result (select-keys {"left" 1 "right" 2} ["right" "missing"]))
  (defconst merged-result
    (merge {"left" 1 "overwritten" 1} {"right" 2 "overwritten" 3}))
  (defconst combined-result
    (merge-with (lambda (left right) (+ left right)) {"hits" 2} {"hits" 5}))
  (defconst zipped-result (zipmap ["a" "b" "unused"] [10 20]))
  (defconst keyed-total
    (reduce-kv
      {"left" 3 "right" 5}
      (lambda (total key value) (+ total (js-length key) value))
      0))
  (defconst removed-map (dissoc {"left" 1 "middle" 2 "right" 3} "left" "right"))
  (defconst removed-set (disj #{"left" "middle" "right"} "left" "right"))
  (defconst vector-stack-top (peek [1 2 3]))
  (defconst vector-stack-rest (pop [1 2 3]))
  (defconst list-stack-top (peek (list 1 2 3)))
  (defconst list-stack-rest (pop (list 1 2 3)))
  (defconst reverse-sequence (rseq [1 2 3]))
  (defconst nested-value (get-in nested-update-result ["profile" "visits"] "missing"))
  (export
    finite-range
    open-range
    repeated-values
    produced-values
    iterated-values
    iteration-state
    cycled-values
    generated-values
    pipeline-values
    pipeline-total
    pipeline-run-result
    mapped
    filtered
    removed
    taken
    dropped
    indexed-map
    kept
    kept-indexed
    taken-while
    dropped-while
    sampled-sequence
    interposed-sequence
    deduped
    distinct-values
    flattened-values
    fixed-partitions
    keyed-partitions
    intermediate-values
    reversed
    concatenated
    first-even
    zero-truth
    all-truth
    first-value
    last-value
    third-value
    tail-values
    without-tail
    without-last
    split-position
    split-prefix
    indexed
    grouped
    counted
    frequencies-result
    nested-result
    nested-update-result
    updated-result
    selected-result
    merged-result
    combined-result
    zipped-result
    keyed-total
    removed-map
    removed-set
    vector-stack-top
    vector-stack-rest
    list-stack-top
    list-stack-rest
    reverse-sequence
    nested-value))
