(module managed.regexp-unicode-sets
  (defconst effects (js-array))
  (defun make (pattern flags) (new globalThis/RegExp pattern flags))
  (defun literal () (js* "/[[a-z]--[aeiou]]+/v"))
  (defun raw-pattern () (js* "/[[[a-c]&&[a-z]][[d-f]--[e]][^g]\\d\\p{ASCII}\\q{xy|}\\p{RGI_Emoji}]/v"))
  (defun clone (pattern flags) (new globalThis/RegExp pattern flags))
  (defun exec (pattern text) (js-call pattern :exec text))
  (defun test-value (pattern text) (js-call pattern :test text))
  (defun meta (pattern)
    (JSON/stringify (js-array (get pattern :source) (get pattern :flags)
      (get pattern :unicode) (get pattern :unicodeSets) (get pattern :ignoreCase)
      (get pattern :lastIndex))))
  (defun report (value)
    (if (Object/is value nil) (JSON/stringify nil)
      (let ((captures (js-array)) (position 0))
        (while (< position (get value :length))
          (let ((capture (get value position)))
            (js-call captures :push (js-array (object-has? value position)
              (Object/is capture undefined) (if (Object/is capture undefined) nil capture))))
          (setq position (1+ position)))
        (JSON/stringify (js-array captures (get value :index) (get value :input)
          (object-has? value "indices") (get value :indices) (get value :groups))))))
  (defun last (pattern value) (put pattern :lastIndex value))
  (defun all (pattern text)
    (let* ((iterator (js-call text :matchAll pattern)) (step (js-call iterator :next)) (result (js-array)))
      (while (not (get step :done))
        (js-call result :push (report (get step :value)))
        (setq step (js-call iterator :next)))
      (JSON/stringify (js-array result (get pattern :lastIndex) (get step :done)))))
  (defun accessor (receiver)
    (let* ((prototype (get globalThis/RegExp :prototype))
           (property (Object/getOwnPropertyDescriptor prototype "unicodeSets")))
      (js-call (get property :get) :call receiver)))
  (defun override-report ()
    (let* ((pattern (new globalThis/RegExp "[\\q{ab|a}]" "v"))
           (prototype (get globalThis/RegExp :prototype))
           (property (Object/getOwnPropertyDescriptor prototype "unicodeSets")))
      (put effects :length 0)
      (Object/defineProperty pattern "unicodeSets" (js-object :configurable t :get (lambda ()
        (js-call effects :push "own unicodeSets") false)))
      (JSON/stringify (js-array (get pattern :flags) (get pattern :unicodeSets)
        (accessor pattern) (report (js-call pattern :exec "ab")) effects
        (get property :enumerable) (get property :configurable)
        (Object/is (get property :set) undefined)))))
  (defun throwing (pattern)
    (js-call pattern :exec (js-object :toString (lambda () (throw false)))))
  (defun recover () (report (js-call (js* "/[\\q{ab|a}]/v") :exec "ab")))
  (export make literal raw-pattern clone exec test-value meta report last all accessor override-report throwing recover))
