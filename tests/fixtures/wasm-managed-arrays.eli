(module managed.arrays
  (defun make (a b c) (js-array a b c))
  (defun empty () (js-array))
  (defun size (a) (js-length a))
  (defun nth-value (i a) (js-nth i a))
  (defun at (a i) (aref a i))
  (defun get-value (a i fallback) (get a i fallback))
  (defun write (a i value) (put a i value))
  (defun truncate (a n) (put a :length n))
  (defun append (a x y) (js-call a :push x y))
  (defun append-none (a) (js-call a :push))
  (defun remove-last (a) (js-call a :pop))
  (defun copy (a) (js-call a :slice))
  (defun interval (a start end) (js-call a :slice start end))
  (defun nested (a b) (let ((x (js-array a b))) (put x 0 x) x))
  (defun key-order (a) (let ((i 0)) (js-nth (setq i (1+ i)) (progn (setq i 2) a))))
  (defun fallback-order (a) (let ((i 0)) (get a 0 (setq i 9)) i))
  (defun write-order (a b) (put a 0 (setq a b)))
  (defun grow-loop (n) (let ((a (js-array)) (i 0))
    (while (< i n) (js-call a :push i) (setq i (1+ i))) a))
  (defun append-order (a b) (js-call a :push (setq a b) (js-call b :push 7)))
  (defun pop-extra (a marker) (js-call a :pop (put marker 0 9)))
  (defun slice-extra (a start end marker) (js-call a :slice start end (put marker 0 9)))
  (defun null-write (a marker) (put a 0 (put marker 0 9)))
  (defun error-then-truth (a length marker)
    (put a :length length) (put marker 0 9) (if a 1 2))
  (defun has (a k) (object-has? a k))
  (defun keys (a) (object-keys a))
  (defun assoc (a k v) (object-assoc a k v))
  (defun append-shadow (a marker) (js-call a :push (put marker 0 9)))
  (defun pop-shadow (a marker) (js-call a :pop (put marker 0 9)))
  (defun slice-shadow (a marker) (js-call a :slice (put marker 0 9)))
  (defun append-replace (a) (js-call a :push (put a :push 9)))
  (export has keys assoc append-shadow pop-shadow slice-shadow append-replace
    append-order pop-extra slice-extra null-write error-then-truth make empty size nth-value at get-value write truncate append append-none
    remove-last copy interval nested key-order fallback-order write-order grow-loop))
