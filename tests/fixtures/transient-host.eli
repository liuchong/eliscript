(module tests.fixtures.transient-host
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/set.mjs" persistentHashSet)
  (import "../../runtime/core/transient.mjs" assocBang conjBang dissocBang persistentBang transient)
  (import "../../runtime/core/vector.mjs" persistentVector)
  (defconst vector (transient (persistentVector 1 2))) (conjBang vector 3 4) (assocBang vector 0 9)
  (defconst map (transient (persistentHashMap (js-array "left" 1)))) (assocBang map "right" 2 "left" 3) (dissocBang map "missing")
  (defconst set (transient (persistentHashSet "left"))) (conjBang set "right" "left") (dissocBang set "left")
  (js-call globalThis.console :log (JSON/stringify (js-object
    :vector (Array/from (persistentBang vector))
    :map (js-call (Array/from (persistentBang map)) :sort (lambda (left right) (js-call (aref left 0) :localeCompare (aref right 0))))
    :set (js-call (Array/from (persistentBang set)) :sort)))))
