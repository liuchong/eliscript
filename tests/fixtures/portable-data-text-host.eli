(module tests.fixtures.portable-data-text-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst moduleUrl (pathToFileURL (aref (get globalThis.process :argv) 2)))
  (defvar dataText undefined)
  (defvar identifier undefined)
  (defvar list undefined)
  (defvar map undefined)
  (defvar metadata undefined)
  (defvar set undefined)
  (defvar value undefined)
  (defvar vector undefined)
  (defvar unwrap undefined)
  (defvar printValue undefined)
  (defvar readValue undefined)
  (defvar readValues undefined)
  (defvar keyword undefined)
  (defvar symbol undefined)
  (defvar listFromArray undefined)
  (defvar mapAssoc undefined)
  (defvar mapCount undefined)
  (defvar mapGet undefined)
  (defvar setCount undefined)
  (defvar withMeta undefined)
  (defvar meta undefined)
  (defvar emptyValueMap undefined)
  (defvar emptyValueSet undefined)
  (defvar valueEqual undefined)
  (defvar vectorCount undefined)
  (defvar vectorFromArray undefined)
  (defvar vectorNth undefined)
  (defun valueMap (entries)
    (let ((result (emptyValueMap)) (index 0))
      (while (< index (js-length entries)) (let ((entry (aref entries index))) (setq result (mapAssoc result (aref entry 0) (aref entry 1)))) (setq index (1+ index))) result))
  (defun valueSet (items)
    (let ((result (emptyValueSet)) (index 0))
      (while (< index (js-length items)) (setq result (funcall set.persistent_set_conj result (aref items index)) index (1+ index))) result))
  (defvar metadataValue undefined)
  (defvar nested undefined)
  (defvar orderedMap undefined)
  (defvar reorderedMap undefined)
  (defvar root undefined)
  (defvar printedRoot undefined)
  (defvar restoredRoot undefined)
  (defvar printedMap undefined)
  (defvar readMany undefined)
  (defvar duplicateMap undefined)
  (defvar duplicateSet undefined)
  (defvar located undefined)
  (defvar unsafeIdentifier undefined)
  (defvar limited undefined)
  (defvar decodedString undefined)
  (defvar taggedSymbol undefined)
  (defvar ignored undefined)
  (defvar depthLimited undefined)
  (defvar lengthLimited undefined)
  (defvar valueLimited undefined)
  (defvar invalidOptions undefined)
  (defvar invalidEscape undefined)
  (defvar oddMap undefined)
  (defvar unknownDispatch undefined)
  (defvar trailing undefined)
  (defvar common undefined)
  (defvar generated undefined)
  (defvar generatedPrinted undefined)
  (defvar generatedRestored undefined)
  (defun errorMessage (result) (get (get result :error) :message))
  (defasync run-host-main ()
    (setq dataText (await (funcall load-module (get moduleUrl :href))))
    (setq identifier (await (funcall load-module (get (new globalThis.URL "./identifier.eli" moduleUrl) :href))))
    (setq list (await (funcall load-module (get (new globalThis.URL "./persistent-list.eli" moduleUrl) :href))))
    (setq map (await (funcall load-module (get (new globalThis.URL "./persistent-map.eli" moduleUrl) :href))))
    (setq metadata (await (funcall load-module (get (new globalThis.URL "./metadata.eli" moduleUrl) :href))))
    (setq set (await (funcall load-module (get (new globalThis.URL "./persistent-set.eli" moduleUrl) :href))))
    (setq value (await (funcall load-module (get (new globalThis.URL "./value.eli" moduleUrl) :href))))
    (setq vector (await (funcall load-module (get (new globalThis.URL "./persistent-vector.eli" moduleUrl) :href))))
    (setq unwrap dataText.data_text_result_value)
    (setq printValue dataText.print_value)
    (setq readValue dataText.read_value)
    (setq readValues dataText.read_values)
    (setq keyword identifier.keyword)
    (setq symbol identifier.symbol)
    (setq listFromArray list.persistent_list_from_array)
    (setq mapAssoc map.persistent_map_assoc)
    (setq mapCount map.persistent_map_count)
    (setq mapGet map.persistent_map_get)
    (setq setCount set.persistent_set_count)
    (setq withMeta metadata.with_meta)
    (setq meta metadata.meta)
    (setq emptyValueMap value.empty_value_map)
    (setq emptyValueSet value.empty_value_set)
    (setq valueEqual value.value_equal_QMARK_)
    (setq vectorCount vector.persistent_vector_count)
    (setq vectorFromArray vector.persistent_vector_from_array)
    (setq vectorNth vector.persistent_vector_nth)
    (setq metadataValue (valueMap (js-array (js-array (keyword "source") "portable") (js-array (keyword "line") 7))))
    (setq nested (withMeta (vectorFromArray (js-array nil undefined t globalThis.Number.NaN globalThis.Number.POSITIVE_INFINITY
    (js* "42n") "Unicode 值\n" (keyword "article/title") (symbol "article" "title") (symbol "space name"))) metadataValue))
    (setq orderedMap (valueMap (js-array (js-array (keyword "z") (valueSet (js-array 3 1 2))) (js-array (keyword "a") nested))))
    (setq reorderedMap (valueMap (js-array (js-array (keyword "a") nested) (js-array (keyword "z") (valueSet (js-array 2 3 1))))))
    (setq root (listFromArray (js-array orderedMap (vectorFromArray (js-array 1 2 3)))))
    (setq printedRoot (printValue root))
    (setq restoredRoot (readValue (unwrap printedRoot)))
    (setq printedMap (printValue orderedMap))
    (setq readMany (readValues "1 :two\n(3 undefined)"))
    (setq duplicateMap (readValue "{:a 1 :a 2}"))
    (setq duplicateSet (readValue "#{1 1}"))
    (setq located (readValue "[\n  1\n}"))
    (setq unsafeIdentifier (printValue (symbol "space name")))
    (setq limited (printValue (vectorFromArray (js-array 1 2)) (js-object :maxValues 2)))
    (setq decodedString (readValue "\"Unicode \\u503c\\n\\t\\\\\\\"\""))
    (setq taggedSymbol (readValue "#eliscript/symbol [\"article\" \"title\"]"))
    (setq ignored (readValue "; header\n[1, 2 ; item\n 3]"))
    (setq depthLimited (readValue "[[[0]]]" (js-object :maxDepth 2)))
    (setq lengthLimited (readValue "[123]" (js-object :maxLength 4)))
    (setq valueLimited (readValue "[1 2]" (js-object :maxValues 2)))
    (setq invalidOptions (readValue "1" (js-object :maxDepth 0)))
    (setq invalidEscape (readValue "\"\\x\""))
    (setq oddMap (readValue "{:a 1 :b}"))
    (setq unknownDispatch (readValue "#unknown 1"))
    (setq trailing (readValue "[1] trailing"))
    (setq common (withMeta (vectorFromArray (js-array (keyword "a") (valueMap (js-array (js-array (keyword "b") 2) (js-array (keyword "a") 1)))
    (valueSet (js-array 3 1 2)))) (valueMap (js-array (js-array (keyword "source") "parity")))))
    (setq generated (vectorFromArray (js-array)))
    (let ((index 0))
    (while (< index 2000)
      (setq generated (funcall vector.persistent_vector_conj generated
        (cond ((= (% index 3) 0) (listFromArray (js-array index (str "value-" (% index 17)))))
              ((= (% index 3) 1) (valueSet (js-array index (keyword "generated" (str "value-" index)))))
              (t (valueMap (js-array (js-array (keyword "index") index)))))))
      (setq index (1+ index))))
    (setq generatedPrinted (printValue generated))
    (setq generatedRestored (readValue (unwrap generatedPrinted)))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :canonical (js-object :root (unwrap printedRoot) :map (unwrap printedMap) :insertionIndependent (= (unwrap printedMap) (unwrap (printValue reorderedMap)))
      :unsafeIdentifier (unwrap unsafeIdentifier) :common (unwrap (printValue common)))
    :roundTrip (js-object :rootEqual (valueEqual root (unwrap restoredRoot)) :fixedPoint (= (unwrap (printValue (unwrap restoredRoot))) (unwrap printedRoot))
      :metadataSource (let ((metadata (meta (funcall list.persistent_list_first (unwrap restoredRoot) nil))))
                        (when (nullish? metadata) (setq metadata (emptyValueMap))) (mapGet metadata (keyword "source") nil))
      :nestedMetadataSource (mapGet (meta (mapGet (funcall list.persistent_list_first (unwrap restoredRoot) nil) (keyword "a") nil)) (keyword "source") nil)
      :generatedEqual (valueEqual generated (unwrap generatedRestored)) :generatedFixedPoint (= (unwrap (printValue (unwrap generatedRestored))) (unwrap generatedPrinted)))
    :values (js-object :ok (get readMany :ok) :count (vectorCount (unwrap readMany)) :first (vectorNth (unwrap readMany) 0 nil)
      :keyword (funcall identifier.qualified_name (vectorNth (unwrap readMany) 1 nil)) :listCount (funcall list.persistent_list_count (vectorNth (unwrap readMany) 2 nil))
      :undefinedPreserved (= (funcall list.persistent_list_nth (vectorNth (unwrap readMany) 2 nil) 1 "missing") undefined))
    :errors (js-object :duplicateMap (errorMessage duplicateMap) :duplicateSet (errorMessage duplicateSet)
      :located (js-object :offset (get (get located :error) :offset) :line (get (get located :error) :line) :column (get (get located :error) :column) :sourceLength (get (get located :error) :sourceLength))
      :limited (errorMessage limited))
    :edges (js-object :decodedString (unwrap decodedString) :taggedSymbol (funcall identifier.qualified_name (unwrap taggedSymbol))
      :ignored (funcall vector.persistent_vector_to_array (unwrap ignored)) :depthLimited (errorMessage depthLimited) :lengthLimited (errorMessage lengthLimited)
      :valueLimited (errorMessage valueLimited) :invalidOptions (errorMessage invalidOptions) :invalidEscape (errorMessage invalidEscape) :oddMap (errorMessage oddMap)
      :unknownDispatch (errorMessage unknownDispatch) :trailing (errorMessage trailing) :emptyValues (vectorCount (unwrap (readValues " ; nothing\n")))
      :negativeZero (unwrap (printValue (unwrap (readValue "-0")))))
    :shape (js-object :mapCount (mapCount orderedMap) :setCount (setCount (valueSet (js-array 3 1 2))) :generatedCount (vectorCount generated))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
