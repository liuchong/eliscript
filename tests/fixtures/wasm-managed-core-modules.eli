(module managed.core-modules-fixture
  (import "../runtime/core/record.mjs" :as Record)
  (import "eliscript/runtime/core/type.mjs" :as Type)
  (import "../runtime/core/protocol.mjs" :as Protocol)
  (import "../runtime/core/collection.mjs" :as Collection)
  (import "../runtime/core/metadata.mjs" :as Metadata)
  (import "../runtime/core/transient.mjs" :as Transient)
  (import "../runtime/core/value.mjs" :as Value)
  (import "../runtime/core/vector.mjs" :as Vector)
  (import "../runtime/core/list.mjs" :as List)
  (import "../runtime/core/map.mjs" :as MapModule)
  (import "../runtime/core/set.mjs" :as SetModule)
  (import "../runtime/core/queue.mjs" :as Queue)
  (import "../runtime/literals.mjs" :as Literal)
  (import "eliscript/runtime/literals" :as PackageLiteral)
  (import "./core-aliases.mjs" :as Alias)

  (defun error-name (callback)
    (try (funcall callback) (catch error (get error :name))))
  (defun error-report (callback)
    (try (funcall callback) (catch error (js-array (get error :name) (get error :message)))))
  (defun aliases ()
    (js-array (Alias/vector-identity (get Vector :PersistentVector))
      (Alias/protocol-identity (get Collection :ICounted))
      (Object/is (get Literal :keyword) (get PackageLiteral :keyword))
      (Object/is (funcall (get Literal :keyword) "identity") (funcall (get PackageLiteral :keyword) "identity"))
      (Alias/record-identity (get Record :defineRecordType))
      (Alias/transient-identity (get Transient :persistentBang))))

  (defun records ()
    (let* ((Person (Record/defineRecordType "Person" (js-array "name" "age")))
           (Other (Record/defineRecordType "Person" (js-array "name" "age")))
           (left (js-call Person :create "Ada" 36)) (same (js-call Person :create "Ada" 36))
           (other (js-call Other :create "Ada" 36))
           (name (Literal/keyword "name")) (age (Literal/keyword "age")) (role (Literal/keyword "role"))
           (metadata (Literal/hashMap (Literal/keyword "source") "core-test"))
           (located (Metadata/withMeta left metadata))
           (older (Collection/assoc located age 37))
           (extra (Collection/conj older (js-array role "engineer")))
           (removed (Collection/dissoc extra name))
           (input (Literal/hashMap name "Grace" role "operator"))
           (mapped (js-call Person :fromMap input)))
      (js-array (Record/isRecordType Person) (Record/isRecord left)
        (Object/is (Record/recordType left) Person) (Record/recordTypeName left)
        (Record/recordFieldNames left) (Object/isFrozen (Record/recordFieldNames left))
        (Object/isFrozen Person) (Object/isFrozen (get Person :prototype)) (Object/isFrozen left)
        (get left :name) (get left :age) (get older :age) (Collection/count extra)
        (Value/equalValues left same) (= (Value/hashValue left) (Value/hashValue same))
        (Value/equalValues left other) (Object/is Person Other) (Value/equalValues left located)
        (Object/is (Metadata/meta extra) metadata) (Object/is (Metadata/meta removed) metadata)
        (Record/isRecord removed) (MapModule/isPersistentHashMap removed)
        (Collection/contains removed name) (Collection/get removed role)
        (get mapped :name) (get mapped :age) (Collection/get mapped role) (Collection/contains input age)
        (error-report (lambda () (js-call Person :create "one")))
        (error-report (lambda () (new Person)))
        (error-name (lambda () (funcall Person)))
        (error-report (lambda () (Record/defineRecordType "Bad" (js-array "x" "x")))))))

  (defun types ()
    (let* ((protocol (Protocol/defineProtocol "CoreDescribe" (js-array "describe" "measure")))
           (plans (js-array (js-array protocol (js-object
             :describe (lambda (self prefix) (str prefix ":" (get self :value)))
             :measure (lambda (self scale) (* (get self :value) scale))))))
           (Box (Type/defineType "Box" (js-array "value") plans))
           (Other (Type/defineType "Box" (js-array "value") plans))
           (left (js-call Box :create 7)) (right (js-call Other :create 7))
           (describe (Protocol/protocolMethod protocol "describe"))
           (measure (Protocol/protocolMethod protocol "measure"))
           (slot (Protocol/protocolSlot protocol "describe"))
           (method (get (get Box :prototype) slot)))
      (Protocol/extendProtocolType protocol Box (js-object :describe (lambda (&rest ignored) "external") :measure (lambda (&rest ignored) -1)))
      (let* ((reified (Type/reifyProtocols (js-array (js-array protocol (js-object
                :describe (lambda (self suffix) (str "captured:" suffix))
                :measure (lambda (self value) (+ 10 value)))))))
             (descriptor (Object/getOwnPropertyDescriptor reified slot))
             (constructed (Reflect/construct method (js-array "new"))))
        (js-array (Type/isType Box) (Type/isTypeValue left) (Object/is (Type/typeOf left) Box)
          (Type/typeName left) (Type/typeFieldNames Box) (get left :value)
          (Object/is Box Other) (Value/equalValues left right)
          (Protocol/implementsProtocol protocol left) (funcall describe left "box") (funcall measure left 3)
          (Object/isFrozen left) (Object/isFrozen Box) (Object/isFrozen (get Box :prototype))
          (Object/is (Object/getPrototypeOf reified) nil) (Object/isFrozen reified)
          (funcall describe reified "ok") (funcall measure reified 5)
          (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable)
          (Object/hasOwn method "prototype")
          (Object/is (Object/getPrototypeOf constructed) (get method :prototype))
          (error-report (lambda () (js-call Box :create)))
          (error-report (lambda () (new Box)))
          (error-name (lambda () (funcall Box)))
          (error-report (lambda () (Type/reifyProtocols (js-array))))
          (error-report (lambda () (Type/defineType "Incomplete" (js-array)
            (js-array (js-array protocol (js-object :describe (lambda (&rest ignored) nil)))))))))))

  (defun PlainBox (value) (put (js* "this") :value value))
  (defun direct-read (suffix) (str (get (js* "this") :value) suffix))
  (defun protocols ()
    (let* ((protocol (Protocol/defineProtocol "CoreRead" (js-array "read")))
           (other (Protocol/defineProtocol "CoreRead" (js-array "read")))
           (method (Protocol/protocolMethod protocol "read"))
           (slot (Protocol/protocolSlot protocol "read"))
           (direct (js-object :value 4)) (typed (new PlainBox 7)))
      (Protocol/extendProtocolType protocol PlainBox (js-object :read (lambda (self suffix) (str (get self :value) suffix))))
      (Protocol/extendProtocolCategory protocol "number" (js-object :read (lambda (self suffix) (str self suffix))))
      (Object/defineProperty direct slot (js-object :value direct-read))
      (let ((missing (try (funcall method (js-object) "!")
                       (catch error (js-array (get error :name) (get error :code) (get error :protocol)
                         (get error :operation) (get error :observedType) (get error :reason))))))
        (js-array (funcall method direct "!") (funcall method typed "!") (funcall method 3 "!")
          (Protocol/implementsProtocol protocol direct) (Protocol/implementsProtocol protocol typed)
          (Object/is slot (Protocol/protocolSlot other "read")) missing))))

  ;; These deliberately dynamic public namespace calls test runtime guards.
  ;; Statically tracked builders must never escape into a callback after sealing.
  (defun runtime-reseal-error (collection)
    (let ((dynamic-builder (js-call Transient :transient collection)))
      (js-call Transient :persistentBang dynamic-builder)
      (error-report (lambda () (js-call Transient :persistentBang dynamic-builder)))))
  (defun runtime-sealed-map-conj-error (collection)
    (let ((dynamic-builder (js-call Transient :transient collection)))
      (js-call Transient :persistentBang dynamic-builder)
      (error-report (lambda () (js-call Transient :conjBang dynamic-builder (js-array 1))))))

  (defun collections ()
    (let* ((metadata (Literal/hashMap (Literal/keyword "tag") 17))
           (vector (Metadata/withMeta (Literal/vector 1 2 3) metadata))
           (list (Literal/list 1 2 3)) (queue (Literal/queue 1 2))
           (map (Literal/hashMap "a" 1 "b" 2)) (set (Literal/hashSet 1 2 1))
           (trace (js-array))
           (reduction (Collection/reduce vector
             (lambda (sum item) (js-call trace :push item)
               (if (= item 2) (Collection/reduced (+ sum item)) (+ sum item))) 0))
           (builder (Transient/transient vector)))
      (Transient/conjBang builder 4 5) (Transient/assocBang builder 0 10)
      (let* ((result (Transient/persistentBang builder)) (map-builder (Transient/transient map))
             (set-builder (Transient/transient set)))
        (Transient/assocBang map-builder "c" 3) (Transient/dissocBang map-builder "a")
        (Transient/conjBang set-builder 3) (Transient/dissocBang set-builder 1)
        (let ((new-map (Transient/persistentBang map-builder)) (new-set (Transient/persistentBang set-builder)))
          (js-array (Array/from vector) (Array/from result) (Object/is (Metadata/meta result) metadata)
            (Collection/count list) (List/first list) (Array/from (List/rest list))
            (Collection/peek queue) (Array/from (Collection/conj queue 3))
            (Collection/count map) (Collection/get new-map "c") (Collection/contains new-map "a")
            (Collection/count set) (Collection/contains new-set 3) (Collection/contains new-set 1)
            reduction trace (Value/equalValues vector list)
            (Collection/isCollection vector) (Collection/isMap map) (Collection/isSet set)
            (runtime-reseal-error result)
            (runtime-sealed-map-conj-error new-map)
            (error-report (lambda () (Metadata/withMeta vector (js-object)))))))))

  (defun replacement-from (values)
    (let* ((constructor (js* "this")) (context (get constructor "__core_test_context")) (trace (get context :trace)))
      (js-call trace :push (Object/is constructor (get context :constructor)) (js-length values)) "override"))
  (defun replace-from (constructor producer)
    (let ((original (Object/getOwnPropertyDescriptor constructor "from")) (trace (js-array)))
      (Object/defineProperty constructor "__core_test_context" (js-object :value (js-object :trace trace :constructor constructor) :configurable t))
      (Object/defineProperty constructor "from" (js-object :get (lambda () (js-call trace :push "get") replacement-from) :configurable t))
      (try (js-array (funcall producer trace) trace)
        (finally (Object/defineProperty constructor "from" original) (Reflect/deleteProperty constructor "__core_test_context")))))
  (defun dynamic-from ()
    (js-array
      (replace-from (get List :PersistentList) (lambda (trace) (Literal/list (progn (js-call trace :push "arg") 1))))
      (replace-from (get Vector :PersistentVector) (lambda (trace) (Literal/vector (progn (js-call trace :push "arg") 1))))
      (replace-from (get MapModule :PersistentHashMap) (lambda (trace) (Literal/hashMap (progn (js-call trace :push "arg") "key") 1)))
      (replace-from (get SetModule :PersistentHashSet) (lambda (trace) (Literal/hashSet (progn (js-call trace :push "arg") 1))))
      (replace-from (get Queue :PersistentQueue) (lambda (trace) (Literal/queue (progn (js-call trace :push "arg") 1))))))

  (defun class-callback-order ()
    (let* ((trace (js-array))
           (Constructor (funcall
             (js* "(implementation, name) => { if (typeof name !== \"string\") throw new TypeError(\"class name must be a string\"); return ({ [name]: class { constructor(...args) { return implementation(this, ...args); } } })[name]; }")
             (lambda (self &rest args) (js-call trace :push "constructor") (put self :value (get args 0)) self) "Effects"))
           (array (js-array 1)) (broken (js-array 1)) (marker (js-object)))
      (Object/defineProperty array "0" (js-object :get (lambda () (js-call trace :push "element") 1) :configurable t))
      (Object/defineProperty broken "0" (js-object :get (lambda () (js-call trace :push "broken") (throw marker)) :configurable t))
      (let* ((empty (js-call (js-array) :map Constructor))
             (sparse (js-call (new globalThis/Array 1) :map Constructor))
             (reduced (js-call (js-array) :reduce Constructor 0))
             (ordinary (error-name (lambda () (funcall Constructor (progn (js-call trace :push "arg") 7)))))
             (callback (error-name (lambda () (js-call array :map Constructor))))
             (same-error (try (js-call broken :map Constructor) (catch error (Object/is error marker))))
             (instance (new Constructor 9))
             (descriptor (Object/getOwnPropertyDescriptor Constructor "prototype")))
        (js-array (js-length empty) (js-length sparse) (Object/hasOwn sparse "0") reduced ordinary callback
          same-error (get instance :value) (Object/is (Object/getPrototypeOf instance) (get Constructor :prototype))
          (get descriptor :writable) trace))))
  (defun held-record ()
    (let ((Person (Record/defineRecordType "Held" (js-array "value")))) (js-call Person :create 7)))
  (defun inspect-held (value)
    (js-array (Record/isRecord value) (Record/recordTypeName value) (get value :value)
      (Object/isFrozen value) (Object/is (get value :constructor) (Record/recordType value))))
  (export aliases records types protocols collections dynamic-from class-callback-order held-record inspect-held))
