(module managed.strings
  (defun read-value (s k) (get s k))
  (defun nth-value (k s) (js-nth k s))
  (defun default-value (s k d) (get s k d))
  (defun size (s) (js-length s))
  (defun at (s p) (js-call s :at p))
  (defun char-at (s p) (js-call s :charAt p))
  (defun char-code (s p) (js-call s :charCodeAt p))
  (defun code-point (s p) (js-call s :codePointAt p))
  (defun repeat (s p) (js-call s :repeat p))
  (defun identity (s) (js-call s :toString))
  (defun value (s) (js-call s :valueOf))
  (defun trim (s) (js-call s :trim))
  (defun trim-start (s) (js-call s :trimStart))
  (defun trim-end (s) (js-call s :trimEnd))
  (defun well-formed (s) (js-call s :isWellFormed))
  (defun repair (s) (js-call s :toWellFormed))
  (defun slice (s a b) (js-call s :slice a b))
  (defun substring (s a b) (js-call s :substring a b))
  (defun substr (s a b) (js-call s :substr a b))
  (defun find (s a b) (js-call s :indexOf a b))
  (defun last (s a b) (js-call s :lastIndexOf a b))
  (defun includes (s a b) (js-call s :includes a b))
  (defun starts (s a b) (js-call s :startsWith a b))
  (defun ends (s a b) (js-call s :endsWith a b))
  (defun concat (s a b c) (js-call s :concat a b c))
  (defun ignored (s trace) (js-call s :charAt (progn (put trace :first 1) 0) (progn (put trace :second 2) trace)))
  (defun capture (s p q) (js-call s :slice (progn (setq s q) p) (js-length s)))
  (defun concat-capture (s a b) (js-call s :concat a (setq a b)))
  (defun default-order (s k) (let ((i 0)) (get s k (setq i 9)) i))
  (defun scan (s) (let ((i 0) (result 0)) (while (< i (js-length s))
    (setq result (+ result (js-call s :charCodeAt i))) (setq i (1+ i))) result))
  (defun fault (s p) (js-call s :charAt p) (js-call s :indexOf "x"))
  (defun concat-empty (s) (js-call s :concat))
  (defun char-empty (s) (js-call s :charAt))
  (defun at-empty (s) (js-call s :at))
  (defun slice-empty (s) (js-call s :slice))
  (defun substring-empty (s) (js-call s :substring))
  (defun substr-empty (s) (js-call s :substr))
  (defun find-empty (s) (js-call s :indexOf))
  (defun repeat-empty (s) (js-call s :repeat))
  (defun ignored-identity (s v) (js-call s :toString v))
  (defun from-units (a b c) (js-call (js* "String") :fromCharCode a b c))
  (defun from-points (a b c) (js-call (js* "String") :fromCodePoint a b c))
  (defun from-unit (a) (string-from-code-unit a))
  (defun from-point (a) (String/fromCodePoint a))
  (defun empty-units () (js-call (js* "String") :fromCharCode))
  (defun empty-points () (js-call (js* "String") :fromCodePoint))
  (defun global-unit (a) (globalThis/String.fromCharCode a))
  (defun global-point (a) (js-call globalThis/String :fromCodePoint a))
  (defun constructor-capture (a) (js-call (js* "String") :fromCharCode a (setq a 66)))
  (defun constructor-effects (a trace) (js-call (js* "String") :fromCodePoint a (put trace :visited 66)))
  (defun format-symbol (s n)
    (js-array (js-call (js-call (js-call s :toLowerCase) :replaceAll "-" "_") :padEnd 9 ".")
      (js-call (js-call (js-call n :toString 16) :toUpperCase) :padStart 4 "0")))
  (defun split-fields (s) (js-call s :split (js* "/([,;])|\\s+/u") 8))
  (defun replace-callback (s) (js-call s :replaceAll "a" (lambda (match index original) (str match ":" index ":" original))))
  (export format-symbol split-fields replace-callback)
  (export from-units from-points from-unit from-point empty-units empty-points global-unit global-point constructor-capture constructor-effects)
  (export concat-empty char-empty at-empty slice-empty substring-empty substr-empty find-empty repeat-empty ignored-identity read-value nth-value default-value size at char-at char-code code-point repeat identity value trim trim-start trim-end well-formed repair slice substring substr find last includes starts ends concat ignored capture concat-capture default-order scan fault))
