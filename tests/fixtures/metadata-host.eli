(module tests.fixtures.metadata-host
  (import "../../runtime/core/identifier.mjs" eliscriptSymbol)
  (import "../../runtime/core/metadata.mjs" meta withMeta)
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/set.mjs" persistentHashSet)
  (import "../../runtime/core/value.mjs" equalValues hashValue)
  (import "../../runtime/core/vector.mjs" persistentVector)
  (defconst metadata (persistentHashMap (js-array "source" "host")))
  (defconst symbol (eliscriptSymbol "eliscript/metadata"))
  (defconst annotatedSymbol (withMeta symbol metadata))
  (defconst vector (js-call (withMeta (persistentVector 1 2 3) metadata) :conj 4))
  (defconst map (js-call (withMeta (persistentHashMap (js-array "a" 1)) metadata) :assoc "b" 2))
  (defconst set (js-call (withMeta (persistentHashSet "a" "b") metadata) :conj "c"))
  (js-call globalThis.console :log (JSON/stringify (js-object
    :symbol (js-object :equal (equalValues symbol annotatedSymbol) :hashEqual (eq (hashValue symbol) (hashValue annotatedSymbol))
      :source (js-call (meta annotatedSymbol) :get "source"))
    :vector (js-object :count (get vector :count) :source (js-call (meta vector) :get "source"))
    :map (js-object :count (get map :count) :source (js-call (meta map) :get "source"))
    :set (js-object :count (get set :count) :source (js-call (meta set) :get "source"))))))
