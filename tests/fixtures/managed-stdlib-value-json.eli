(module managed.stdlib.value-json
  (import "./stdlib/value.eli" value-hash value-equal? value-map-from-entries value-set-from-array)
  (import "./stdlib/persistent-list.eli" persistent-list-from-array)
  (import "./stdlib/persistent-vector.eli" persistent-vector-from-array)
  (import "./stdlib/persistent-map.eli" persistent-map-count persistent-map-get)
  (import "./stdlib/persistent-set.eli" persistent-set-count persistent-set-has?)
  (import "./stdlib/json.eli" parse-json stringify-json json-error? json-error-code json-error-message json-error-offset json-error-path)
  (import "./stdlib/result.eli" ok? err? result-payload)
  (defun values ()
    (let* ((left (persistent-vector-from-array (js-array 1 "中😀" nil)))
           (right (persistent-vector-from-array (js-array 1 "中😀" nil)))
           (list (persistent-list-from-array (js-array 1 "中😀" nil)))
           (map (value-map-from-entries (js-array (js-array "a" 1) (js-array "b" left))))
           (same (value-map-from-entries (js-array (js-array "b" right) (js-array "a" 1))))
           (set (value-set-from-array (js-array left right 1 1))))
      (js-array (value-hash nil) (value-hash undefined) (value-hash false) (value-hash t)
        (value-hash -0.0) (value-hash 0) (value-hash (/ 0 0)) (value-hash "中😀")
        (value-equal? left right) (= (value-hash left) (value-hash right))
        (value-equal? list left) (value-equal? map same) (= (value-hash map) (value-hash same))
        (persistent-map-count map) (persistent-map-get map "a" nil)
        (persistent-set-count set) (persistent-set-has? set right))))
  (defun identities ()
    (let* ((left (js-object)) (right (js-object))
           (map (value-map-from-entries (js-array (js-array left 1) (js-array right 2)))))
      (js-array (value-equal? left left) (value-equal? left right)
        (= (value-hash left) (value-hash left))
        (persistent-map-count map) (persistent-map-get map left nil) (persistent-map-get map right nil))))
  (defun json-case (source)
    (let ((parsed (parse-json source)))
      (if (err? parsed)
          (let ((error (result-payload parsed)))
            (js-array false (json-error-code error) (json-error-offset error) (json-error-path error)))
        (let* ((value (result-payload parsed)) (encoded (stringify-json value)))
          (if (ok? encoded)
              (let* ((text (result-payload encoded)) (again (parse-json text)))
                (js-array t text (ok? again) (value-equal? value (result-payload again))))
            (js-array false "encode"))))))
  (defun error-report (result)
    (let ((error (result-payload result)))
      (js-array (err? result) (json-error? error) (json-error-code error)
        (json-error-message error) (json-error-offset error) (json-error-path error))))
  (defun parse-report (source options) (error-report (parse-json source options)))
  (defun encode-report (input)
    (let ((encoded (stringify-json input)))
      (if (ok? encoded) (js-array t (result-payload encoded)) (error-report encoded))))
  (defun json-boundaries ()
    (let* ((negative (result-payload (parse-json "-0")))
           (emoji (result-payload (parse-json "\"\\ud83d\\ude00\"")))
           (lone (result-payload (parse-json "\"\\ud800\"")))
           (shared (persistent-vector-from-array (js-array 1)))
           (repeated (persistent-vector-from-array (js-array shared shared)))
           (cyclic (persistent-vector-from-array (js-array nil))))
      (put (get cyclic :tail) 0 cyclic)
      (js-array (Object/is negative -0.0) (= (value-hash negative) (value-hash 0))
        (result-payload (stringify-json negative))
        (js-length emoji) (string-code-unit-at emoji 0) (string-code-unit-at emoji 1)
        (result-payload (stringify-json emoji)) (string-code-unit-at lone 0)
        (result-payload (stringify-json lone))
        (result-payload (stringify-json repeated)) (error-report (stringify-json cyclic)))))
  (defun order-and-identity ()
    (let* ((key-left (persistent-vector-from-array (js-array "key")))
           (key-right (persistent-vector-from-array (js-array "key")))
           (left (value-map-from-entries (js-array (js-array "alpha" 1) (js-array key-left 2) (js-array "omega" (/ 0 0)))))
           (right (value-map-from-entries (js-array (js-array "omega" (/ 0 0)) (js-array key-right 2) (js-array "alpha" 1))))
           (set-left (value-set-from-array (js-array "alpha" key-left "omega")))
           (set-right (value-set-from-array (js-array "omega" key-right "alpha")))
           (collision (value-map-from-entries (js-array (js-array "key-50691" "left") (js-array "key-194634" "right"))))
           (a (js-object :value 1)) (b (js-object :value 1))
           (fn (lambda () 1)) (other-fn (lambda () 1))
           (symbol (funcall (js* "Symbol") "identity")) (other-symbol (funcall (js* "Symbol") "identity"))
           (opaque (value-map-from-entries (js-array (js-array a 1) (js-array b 2) (js-array fn 3) (js-array other-fn 4) (js-array symbol 5) (js-array other-symbol 6))))
           (opaque-set (value-set-from-array (js-array a b fn other-fn symbol other-symbol a))))
      (js-array (value-equal? left right) (= (value-hash left) (value-hash right))
        (value-equal? set-left set-right) (= (value-hash set-left) (value-hash set-right))
        (persistent-map-get left key-right nil) (persistent-set-has? set-left key-right)
        (= (value-hash "key-50691") (value-hash "key-194634"))
        (persistent-map-count collision) (persistent-map-get collision "key-50691" nil) (persistent-map-get collision "key-194634" nil)
        (value-equal? a b) (value-equal? fn other-fn) (value-equal? symbol other-symbol)
        (= (value-hash a) (value-hash a)) (= (value-hash fn) (value-hash fn)) (= (value-hash symbol) (value-hash symbol))
        (persistent-map-count opaque) (persistent-set-count opaque-set)
        (persistent-map-get opaque a nil) (persistent-map-get opaque b nil)
        (persistent-map-get opaque fn nil) (persistent-map-get opaque other-fn nil)
        (persistent-map-get opaque symbol nil) (persistent-map-get opaque other-symbol nil))))
  (defun opaque-probe (mode)
    (let ((function (lambda () 1)) (other (lambda () 1)))
      (cond ((= mode 0) (value-type function))
            ((= mode 1) (object-has? function "kind"))
            ((= mode 2) (get function "kind" nil))
            ((= mode 3) (value-hash function))
            (t (value-equal? function other)))))
  (export values identities json-case parse-report encode-report json-boundaries order-and-identity opaque-probe))
