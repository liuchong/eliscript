(module tests.fixtures.literal-runtime-host
  (import "node:url" pathToFileURL)
  (import "../../runtime/core/map.mjs" isPersistentHashMap)
  (import "../../runtime/core/identifier.mjs" isEliscriptSymbol isKeyword keyword qualifiedIdentifierName)
  (import "../../runtime/core/list.mjs" isPersistentList)
  (import "../../runtime/core/queue.mjs" isPersistentQueue)
  (import "../../runtime/core/set.mjs" isPersistentHashSet)
  (import "../../runtime/core/data-text.mjs" printValue)
  (import "../../runtime/core/vector.mjs" isPersistentVector persistentVector)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst modulePath (aref (get globalThis.process :argv) 2))
  (when (= modulePath undefined) (throw (new globalThis.TypeError "literal runtime host requires a generated module path")))
  (defvar generated undefined)
  (defvar nested undefined)
  (defvar mapKey undefined)
  (defvar mapResult undefined)
  (defvar literalMapResult undefined)
  (defvar nestedMap undefined)
  (defvar readyKeyword undefined)
  (defvar qualifiedKeyword undefined)
  (defvar quotedData undefined)
  (defvar quotedValues undefined)
  (defvar literalSetMap undefined)
  (defun reportValue (value)
    (cond ((isPersistentVector value) (Array/from value)) ((isPersistentHashMap value) (js-object :ready (js-call value :get readyKeyword))) (t value)))
  (defun coalesce (value fallback) (if (nullish? value) fallback value))
  (defasync run-host-main ()
    (setq generated (await (funcall load-module (get (pathToFileURL modulePath) :href))))
    (setq nested (js-call (get generated :vector_value) :nth 2))
    (setq mapKey (persistentVector "value-key"))
    (setq mapResult (js-call (get generated :map_value) :get mapKey))
    (setq literalMapResult (js-call (get generated :map_literal) :get mapKey))
    (setq nestedMap (js-call (get generated :map_literal) :get "nested"))
    (setq readyKeyword (keyword "ready"))
    (setq qualifiedKeyword (keyword "article/title"))
    (setq quotedData (get generated :quoted_data))
    (setq quotedValues (Array/from quotedData))
    (setq literalSetMap (js-call (Array/from (get generated :set_literal)) :find isPersistentHashMap))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :vector (js-object :persistent (isPersistentVector (get generated :vector_value)) :count (get (get generated :vector_value) :count)
      :languageCount (get generated :vector_count) :first (get generated :vector_first) :values (Array/from (get generated :vector_value)) :nestedPersistent (isPersistentVector nested))
    :map (js-object :persistent (isPersistentHashMap (get generated :map_value)) :count (get (get generated :map_value) :count) :name (js-call (get generated :map_value) :get "name")
      :valueKey (if (isPersistentVector mapResult) (Array/from mapResult) nil))
    :mapLiteral (js-object :persistent (isPersistentHashMap (get generated :map_literal)) :count (get (get generated :map_literal) :count)
      :name (js-call (get generated :map_literal) :get "name") :valueKey (if (isPersistentVector literalMapResult) (Array/from literalMapResult) nil)
      :nestedPersistent (isPersistentHashMap nestedMap) :nestedReady (js-call nestedMap :get readyKeyword) :duplicate (js-call (get generated :map_literal) :get "duplicate"))
    :set (js-object :explicitPersistent (isPersistentHashSet (get generated :set_value)) :explicitCount (get (get generated :set_value) :count)
      :explicitValueKey (js-call (get generated :set_value) :has (persistentVector 5 6)) :literalPersistent (isPersistentHashSet (get generated :set_literal)) :literalCount (get (get generated :set_literal) :count)
      :duplicate (js-call (get generated :set_literal) :has "source") :valueKey (js-call (get generated :set_literal) :has (persistentVector 7 8))
      :nestedMap (isPersistentHashMap literalSetMap) :nestedReady (coalesce (if (nullish? literalSetMap) undefined (js-call literalSetMap :get readyKeyword)) nil)
      :evaluationOrder (get generated :set_evaluation_order) :macroPersistent (isPersistentHashSet (get generated :macro_set))
      :macroKeyword (js-call (get generated :macro_set) :has (keyword "macro/value")) :macroValue (js-call (get generated :macro_set) :has (persistentVector 9)))
    :queue (js-object :explicitPersistent (isPersistentQueue (get generated :queue_value)) :explicitValues (js-call (Array/from (get generated :queue_value)) :map reportValue)
      :literalPersistent (isPersistentQueue (get generated :queue_literal)) :literalValues (js-call (Array/from (get generated :queue_literal)) :map reportValue)
      :evaluationOrder (get generated :queue_evaluation_order) :text (printValue (get generated :queue_literal)))
    :keyword (js-object :value (isKeyword (get generated :keyword_value)) :interned (= (get generated :keyword_value) qualifiedKeyword)
      :qualifiedName (qualifiedIdentifierName (get generated :keyword_value)) :printed (funcall globalThis.String (get generated :keyword_value))
      :mapPersistent (isPersistentHashMap (get generated :keyword_map)) :mapCount (get (get generated :keyword_map) :count)
      :mapQualified (js-call (get generated :keyword_map) :get qualifiedKeyword) :mapReady (js-call (get generated :keyword_map) :get readyKeyword)
      :stringKeyMiss (coalesce (js-call (get generated :keyword_map) :get "article/title") nil) :macroValue (isKeyword (get generated :macro_keyword))
      :macroQualifiedName (qualifiedIdentifierName (get generated :macro_keyword))
      :quotedSyntax (js-object :value (isKeyword (get generated :quoted_keyword)) :qualifiedName (qualifiedIdentifierName (get generated :quoted_keyword))))
    :quoted (js-object :persistentList (isPersistentList quotedData) :count (get quotedData :count) :symbol (isEliscriptSymbol (aref quotedValues 0))
      :symbolName (qualifiedIdentifierName (aref quotedValues 0)) :keyword (isKeyword (aref quotedValues 1)) :vector (isPersistentVector (aref quotedValues 2))
      :vectorValues (Array/from (aref quotedValues 2)) :emptyList (and (isPersistentList (aref quotedValues 3)) (get (aref quotedValues 3) :isEmpty))
      :falseSymbol (isEliscriptSymbol (aref quotedValues 4)) :text (printValue quotedData) :mapSyntax (printValue (get generated :quoted_map))
      :setSyntax (printValue (get generated :quoted_set)) :queueSyntax (printValue (get generated :quoted_queue)))
    :list (js-object :persistent (isPersistentList (get generated :list_value)) :values (Array/from (get generated :list_value)) :first (get generated :list_first)
      :restPersistent (isPersistentList (get generated :list_rest)) :restValues (Array/from (get generated :list_rest)) :consPersistent (isPersistentList (get generated :list_cons))
      :consValues (Array/from (get generated :list_cons)) :emptyRest (and (isPersistentList (get generated :empty_list_rest)) (get (get generated :empty_list_rest) :isEmpty)))
    :host (js-object :array (Array/isArray (get generated :array_value)) :prependedArray (get generated :prepended_array) :languageCount (get generated :array_count)
      :second (get generated :array_second) :object (= (Object/getPrototypeOf (get generated :object_value)) globalThis.Object.prototype) :objectValue (get generated :object_value))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
