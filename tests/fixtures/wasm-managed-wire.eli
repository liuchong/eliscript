(module eliscript.fixture.managed-wire
  (import "../../stdlib/mdp.eli" mdp-parse mdp-encode)
  (import "../../stdlib/mds.eli" mds-validate)
  (import "../../runtime/wire/markdown.mjs" MarkdownError)
  (import "../../stdlib/gepo.eli" gepo-operation gepo-usage gepo-index gepo-discovery-candidates
    gepo-classify-discovery gepo-service gepo-client)
  (import "eliscript/platform/http.mjs" :as Host)
  (import "./wire.mjs" codec-report roundtrip echo-data)
  (defun original-codec-report () (JSON/stringify (codec-report)))
  (defasync original-echo (url source) (JSON/stringify (await (echo-data url (JSON/parse source)))))
  (defun original-roundtrip (source) (JSON/stringify (roundtrip (JSON/parse source))))
  (defun http-service (options) (gepo-service options))
  (defun http-client (options) (gepo-client options))
  (defun http-candidates (url) (gepo-discovery-candidates url))
  (defun http-index (title operations location) (gepo-index title operations location))
  (defun error-report (error)
    (let* ((type (value-type error)) (markdown false)
           (prototype (when (and (not (nil? error))
                                  (or (= type "object") (= type "function")))
                        (Object/getPrototypeOf error)))
           (expected (get MarkdownError :prototype)))
      (while (and prototype (not markdown))
        (if (eq prototype expected) (setq markdown t)
          (setq prototype (Object/getPrototypeOf prototype))))
      ;; MarkdownError.line is a document location defined by the wire API.
      ;; Native Error.line may instead be an engine's stack location; retain
      ;; the original error but do not report that as a Markdown document line.
      (js-object :name (get error :name) :message (get error :message) :code (get error :code)
        :line (if markdown (get error :line) undefined)
        :raw (if (or (= type "object") (= type "function")) undefined error))))
  (defun parse-report (source options)
    (JSON/stringify (try (js-object :ok t :value (mdp-parse source (JSON/parse options)))
      (catch error (js-object :ok false :error (error-report error))))))
  (defun encode-report (source options)
    (JSON/stringify (try (js-object :ok t :value (mdp-encode (JSON/parse source) (JSON/parse options)))
      (catch error (js-object :ok false :error (error-report error))))))
  (defun roundtrip-report (source)
    (let* ((value (JSON/parse source)) (text (mdp-encode value)))
      (JSON/stringify (js-object :text text :value (mdp-parse text)))))
  (defun invalid-encode (mode)
    (let ((value (js-object)))
      (cond ((= mode 0) (put value :bad (get globalThis/Number :NaN)))
        ((= mode 1) (put value :bad undefined))
        ((= mode 2) (put value :self value))
        ((= mode 3) (put value :sparse (new globalThis/Array 2)))
        ((= mode 4) (put value :bad (get globalThis/Number :POSITIVE_INFINITY)))
        ((= mode 5) (put value :bad (funcall globalThis/BigInt "1")))
        ((= mode 6) (setq value (Object/create (js-object :inherited 1))))
        ((= mode 7) (put value "bad: key" 1))
        ((= mode 8) (put value :a (js-array value)))
        ((= mode 9) (put value :mixed (js-array (js-object :a 1) (js-object :b (js-object :nested 2))))))
      (JSON/stringify (try (js-object :ok t :value (mdp-encode value))
        (catch error (js-object :ok false :error (error-report error)))))))
  (defun parse-negative-zero () (Object/is (get (mdp-parse "- zero: -0\n") :zero) -0.0))
  (defun validate-report (document schema)
    (JSON/stringify (try (js-object :ok t :value (mds-validate (JSON/parse document) (JSON/parse schema)))
      (catch error (js-object :ok false :error (error-report error))))))
  (defun gepo-pure-report (mode input)
    (JSON/stringify (try
      (let ((value (JSON/parse input)))
        (js-object :ok t :value
          (cond ((= mode 0) (gepo-usage value))
            ((= mode 1) (gepo-index (get value :title) (get value :operations) (get value :location)))
            ((= mode 2) (gepo-discovery-candidates value))
            ((= mode 3) (gepo-classify-discovery value))
            ((= mode 4) (put value :execute (lambda (request) nil)) (gepo-operation value))
            ((= mode 5) (gepo-operation value)))))
      (catch error (js-object :ok false :error (error-report error))))))
  (defasync service-execute (request state mode)
    (put state :calls (1+ (get state :calls)))
    (if (= mode 4) "not a Response"
      (new (get Host/globals :Response) (await (js-call request :text))
        (js-object :headers (js-object "Content-Type" "text/markdown; variant=mdp")))))
  (defasync service-report (mode request)
    (let* ((state (js-object :calls 0))
           (options (js-object :title "Example" :operations
             (js-array (js-object :path "/rpc/echo" :title "Echo"
               :execute (lambda (request) (service-execute request state mode)))))))
      (when (= mode 1) (put options :authorize (lambda () false)))
      (when (= mode 2) (put options :authorize (lambda () (new (get Host/globals :Response) "custom" (js-object :status 401)))))
      (when (= mode 3) (put options :visible (lambda () false)))
      (JSON/stringify (try
        (let* ((serve (gepo-service options)) (response (await (funcall serve request))))
          (js-object :ok t :calls (get state :calls) :status (get response :status)
            :allow (js-call (get response :headers) :get "Allow")
            :contentType (js-call (get response :headers) :get "Content-Type") :body (await (js-call response :text))))
        (catch error (js-object :ok false :calls (get state :calls) :error (error-report error)))))))
  (defasync client-report (mode url body)
    (let* ((options (js-object :timeoutMs (if (= mode "timeout") 25 3000) :maxBytes (if (= mode "bounds") 8 2097152)))
           (client (gepo-client options)) (call-options (js-object)) (response nil))
      (when (= mode "aborted")
        (let ((controller (new (get Host/globals :AbortController))))
          (js-call controller :abort "wire-cancel") (put call-options :signal (get controller :signal))))
      (JSON/stringify (try
        (setq response
          (cond ((= mode "discover") (await (js-call client :discover url call-options)))
            ((= mode "index") (await (js-call client :index url call-options)))
            ((or (= mode "invoke") (= mode "no-post") (= mode "no-body") (= mode "reserved"))
              (unless (= mode "no-post") (put call-options :allowPost t))
              (put call-options :contentType "text/markdown; variant=mdp")
              (await (js-call client :invoke url (if (= mode "no-body") undefined body) call-options)))
            (t (await (js-call client :usage url call-options)))))
        (js-object :ok t :url (get response :url) :status (get response :status) :contentType (get response :contentType)
          :body (get response :body) :paths (get response :paths) :state (get response :state) :attempts (get response :attempts))
        (catch error (js-object :ok false :error (error-report error)))))))
  (export original-codec-report original-echo original-roundtrip http-service http-client http-candidates http-index parse-report encode-report roundtrip-report invalid-encode parse-negative-zero validate-report gepo-pure-report service-report client-report))
