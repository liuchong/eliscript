(module tests.fixtures.wire-host
  (import "node:assert/strict" :default assert)
  (import "node:http" createServer)
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar wire undefined)
  (defvar calls undefined)
  (defvar serve undefined)
  (defvar server undefined)
  (defasync run-host-main ()
    (setq wire (await (funcall load-module (pathToFileURL (aref (get globalThis.process :argv) 2)))))
    (js-call assert :deepEqual (get (js-call wire :codec_report) :data) (js-object :User (js-object :name "Ada" :age 42)))
    (js-call assert :equal (get (get (js-call wire :codec_report) :validation) :valid) t)
    (js-call assert :deepEqual (js-call wire :roundtrip (js-object :User (js-object :name "小明😀" :tags (js-array "中文" "a|b") :nested (js-object :ok t))))
    (js-object :User (js-object :name "小明😀" :tags (js-array "中文" "a|b") :nested (js-object :ok t))))
    (setq calls 0)
    (setq serve (js-call wire :make_service (js-array (js-object :path "/rpc/echo" :title "Echo" :execute (async (request)
    (setq calls (1+ calls)) (new globalThis.Response (await (js-call request :text)) (js-object :headers (js-object "Content-Type" "text/markdown; variant=mdp"))))))))
    (setq server (createServer (async (req res)
    (try
      (let* ((chunks (js-array)) (iterator (js-call req (get globalThis.Symbol :asyncIterator))) (done false))
        (try
          (while (not done)
            (let ((step (await (js-call iterator :next))))
              (if (get step :done) (setq done t) (js-call chunks :push (get step :value)))))
          (finally (when (and (not done) (not (nullish? (get iterator :return)))) (await (js-call iterator :return)))))
        (let* ((options (js-object :method (get req :method) :headers (get req :headers))) (response undefined))
          (when (= (get req :method) "POST") (put options :body (Buffer/concat chunks)))
          (setq response (await (funcall serve (new globalThis.Request (str "http://127.0.0.1:" (get (js-call server :address) :port) (get req :url)) options))))
          (js-call res :writeHead (get response :status) (Object/fromEntries (get response :headers))) (js-call res :end (await (js-call response :text)))))
      (catch error (js-call res :writeHead 500) (js-call res :end "Server error"))))))
    (await (new globalThis.Promise (lambda (resolve) (js-call server :listen 0 "127.0.0.1" resolve))))
    (try
    (let* ((origin (str "http://127.0.0.1:" (get (js-call server :address) :port))) (client (js-call wire :make_client (js-object :timeoutMs 3000))))
      (js-call assert :equal (get (await (js-call client :discover origin)) :state) "found")
      (js-call assert :match (get (await (js-call client :index (str origin "/rpc"))) :body) (new globalThis.RegExp "`/rpc/echo`" "u"))
      (await (js-call client :usage (str origin "/rpc/echo"))) (js-call assert :equal calls 0)
      (let ((response (await (js-call client :invoke (str origin "/rpc/echo") "- value: 42\n" (js-object :allowPost t :contentType "text/markdown; variant=mdp")))))
        (js-call assert :equal (get response :body) "- value: 42\n") (js-call assert :equal calls 1))
      (let ((payload (js-object :User (js-object :name "中文😀" :nested (js-array 1 (js-object :ok t))))))
        (js-call assert :deepEqual (await (js-call wire :echo_data (str origin "/rpc/echo") payload)) payload))
      (js-call assert :equal calls 2) (js-call globalThis.console :log (JSON/stringify (js-object :codec t :discovery t :usageSafe t :post t))))
    (finally (js-call server :closeAllConnections) (await (new globalThis.Promise (lambda (resolve) (js-call server :close resolve)))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
