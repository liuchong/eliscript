(module tests.fixtures.protocol-host
  (import "../../runtime/core/protocol.mjs" ProtocolDispatchError defineProtocol extendProtocolCategory extendProtocolDefault extendProtocolType implementsProtocol protocolMethod protocolSlot)
  (defconst protocol (defineProtocol "HostReport" (js-array "label" "size")))
  (defconst label (protocolMethod protocol "label")) (defconst size (protocolMethod protocol "size"))
  (defconst labelSlot (protocolSlot protocol "label")) (defconst sizeSlot (protocolSlot protocol "size"))
  (defconst host-exact-class (js* "(initialize) => class ExactValue { constructor(value) { initialize(this, value); } }"))
  (defconst ExactValue (funcall host-exact-class (lambda (self value) (put self :value value))))
  (defconst host-direct-class (js* "(Base, labelSlot, sizeSlot, label, size) => class DirectValue extends Base { [labelSlot]() { return label(this); } [sizeSlot]() { return size(this); } }"))
  (defconst DirectValue (funcall host-direct-class ExactValue labelSlot sizeSlot (lambda (self) (str "direct:" (get self :value))) (lambda (self) (get (get self :value) :length))))
  (extendProtocolType protocol ExactValue (js-object :label (lambda (value) (str "exact:" (get value :value))) :size (lambda (value) (get (get value :value) :length))))
  (extendProtocolCategory protocol "string" (js-object :label (lambda (value) (str "string:" value)) :size (lambda (value) (get value :length))))
  (extendProtocolDefault protocol (js-object :label (lambda (value) (str "default:" (funcall globalThis.String value))) :size (lambda () -1)))
  (defvar missing undefined) (defconst missingProtocol (defineProtocol "Missing" (js-array "read")))
  (try (funcall (protocolMethod missingProtocol "read") (js-object))
    (catch error
      (unless (js* "error instanceof ProtocolDispatchError") (throw error))
      (setq missing (js-object :code (get error :code) :protocol (get error :protocol) :operation (get error :operation) :observedType (get error :observedType) :reason (get error :reason)))))
  (defconst direct (new DirectValue "alpha")) (defconst exact (new ExactValue "beta"))
  (js-call globalThis.console :log (JSON/stringify (js-object :direct (js-array (label direct) (size direct) (implementsProtocol protocol direct))
    :exact (js-array (label exact) (size exact) (implementsProtocol protocol exact)) :category (js-array (label "gamma") (size "gamma"))
    :fallback (js-array (label nil) (size nil)) :missing missing))))
