(module tests.fixtures.compiler-sha256-host
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (js-call assert :equal (get (get globalThis.process :release) :name) "node")
  (js-call assert :equal (get (get globalThis.process :versions) :bun) undefined)
  (defvar createCompilerSha256 undefined)
  (defasync run-host-main ()
    (setq createCompilerSha256 (get (await (funcall load-module (aref (get globalThis.process :argv) 2))) :createCompilerSha256))
    (js-call (js-array 0 3 55 56 63 64 65 1048576) :forEach (lambda (size)
    (let ((bytes (new globalThis.Uint8Array size)) (index 0))
      (while (< index size) (put bytes index (bit-and (+ (* index 37) 11) 255)) (setq index (1+ index)))
      (let ((expected (js-call (js-call (createHash "sha256") :update bytes) :digest "hex")) (hash (funcall createCompilerSha256)) (start 0))
        (while (< start size) (js-call hash :update (js-call bytes :subarray start (+ start 131))) (setq start (+ start 131)))
        (js-call assert :equal (js-call hash :digestHex) expected))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
