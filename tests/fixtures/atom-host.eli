(module tests.fixtures.atom-host
  (import "node:url" pathToFileURL)
  (import "node:path" dirname resolve)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst modulePath (aref (get globalThis.process :argv) 2))
  (defvar atomModule undefined)
  (defvar vectorModule undefined)
  (defvar addWatch undefined)
  (defvar atom undefined)
  (defvar isAtom undefined)
  (defvar compareAndSet undefined)
  (defvar deref undefined)
  (defvar getValidator undefined)
  (defvar removeWatch undefined)
  (defvar reset undefined)
  (defvar resetVals undefined)
  (defvar setValidator undefined)
  (defvar swap undefined)
  (defvar swapVals undefined)
  (defvar vectorToArray undefined)
  (defun captureError (operation)
    (try (progn (funcall operation) nil)
      (catch error (let ((code (if (nullish? error) undefined (get error :code)))) (if (nullish? code) (funcall globalThis.String error) code)))))
  (defvar counter undefined)
  (defvar forgedAtom undefined)
  (defvar hostileAtom undefined)
  (defvar resetResult undefined)
  (defvar swapResult undefined)
  (defvar resetValues undefined)
  (defvar swapValues undefined)
  (defvar compareMismatch undefined)
  (defvar compareSuccess undefined)
  (defvar equalExpectedValue undefined)
  (defvar equalObservedValue undefined)
  (defvar equalExpected undefined)
  (defvar valueEqualCompare undefined)
  (defvar opaqueExpected undefined)
  (defvar opaqueReference undefined)
  (defvar opaqueMismatch undefined)
  (defvar opaqueSuccess undefined)
  (defvar validatorCalls undefined)
  (defvar nonnegative undefined)
  (defvar guarded undefined)
  (defvar guardedWatchCalls undefined)
  (defvar compareRejected undefined)
  (defvar compareMismatchWatchCalls undefined)
  (defvar inheritedValidatorCalls undefined)
  (defvar inheritedOptions undefined)
  (defvar inheritedGuard undefined)
  (defvar acceptedValue undefined)
  (defvar rejectedCode undefined)
  (defvar rejectedState undefined)
  (defvar rejectedReplacement undefined)
  (defvar validatorUnchanged undefined)
  (defvar clearedValidator undefined)
  (defvar unguardedValue undefined)
  (defvar thrownMarker undefined)
  (defvar throwing undefined)
  (defvar validatorMarkerPreserved undefined)
  (defvar stateAfterThrownValidator undefined)
  (defvar stateAfterRecovery undefined)
  (defvar reentrantSwap undefined)
  (defvar reentrantSwapCode undefined)
  (defvar reentrantValidator undefined)
  (defvar reentrantValidatorCode undefined)
  (defvar reentrantCompare undefined)
  (defvar reentrantCompareCode undefined)
  (defvar watched undefined)
  (defvar watchEvents undefined)
  (defvar outerResetResult undefined)
  (defvar outerEvents undefined)
  (defvar nestedEvents undefined)
  (defvar firstNestedIndex undefined)
  (defvar lastOuterIndex undefined)
  (defvar replacement undefined)
  (defvar replacementEvents undefined)
  (defvar watchFailure undefined)
  (defvar watchMarker undefined)
  (defvar healthyWatchCalls undefined)
  (defvar watchMarkerPreserved undefined)
  (defvar watchRecoveryValue undefined)
  (defvar model undefined)
  (defvar modelValue undefined)
  (defvar modelTransitions undefined)
  (defvar modelAgreement undefined)
  (defvar randomState undefined)
  (defvar scale undefined)
  (defasync run-host-main ()
    (setq atomModule (await (funcall load-module (get (pathToFileURL modulePath) :href))))
    (setq vectorModule (await (funcall load-module (get (pathToFileURL (resolve (dirname modulePath) "../persistent-vector.eli")) :href))))
    (setq addWatch atomModule.add_watch)
    (setq atom atomModule.atom)
    (setq isAtom atomModule.atom_QMARK_)
    (setq compareAndSet atomModule.compare_and_set_BANG_)
    (setq deref atomModule.deref)
    (setq getValidator atomModule.get_validator)
    (setq removeWatch atomModule.remove_watch)
    (setq reset atomModule.reset_BANG_)
    (setq resetVals atomModule.reset_vals_BANG_)
    (setq setValidator atomModule.set_validator_BANG_)
    (setq swap atomModule.swap_BANG_)
    (setq swapVals atomModule.swap_vals_BANG_)
    (setq vectorToArray vectorModule.persistent_vector_to_array)
    (setq counter (atom 1))
    (setq forgedAtom (js-object :kind "eliscript/atom" :identify (lambda () t) :read (get counter :read)))
    (setq hostileAtom (js-object))
    (Object/defineProperty hostileAtom "identify" (js-object :enumerable t :get (lambda () (throw (new globalThis.Error "hostile getter")))))
    (setq resetResult (reset counter 2))
    (setq swapResult (swap counter (lambda (value left right) (+ value left right)) 3 4))
    (setq resetValues (vectorToArray (resetVals counter 10)))
    (setq swapValues (vectorToArray (swapVals counter (lambda (value amount) (+ value amount)) 5)))
    (setq compareMismatch (compareAndSet counter 10 20))
    (setq compareSuccess (compareAndSet counter 15 20))
    (setq equalExpectedValue (resetVals (atom 0) 1))
    (setq equalObservedValue (resetVals (atom 0) 1))
    (setq equalExpected (atom equalExpectedValue))
    (setq valueEqualCompare (compareAndSet equalExpected equalObservedValue (js-array 3 4)))
    (setq opaqueExpected (js-object :value 1))
    (setq opaqueReference (atom opaqueExpected))
    (setq opaqueMismatch (compareAndSet opaqueReference (js-object :value 1) (js-object :value 2)))
    (setq opaqueSuccess (compareAndSet opaqueReference opaqueExpected (js-object :value 3)))
    (setq validatorCalls (js-array))
    (setq nonnegative (lambda (value) (js-call validatorCalls :push value) (>= value 0)))
    (setq guarded (atom 2 (js-object :validator nonnegative)))
    (setq guardedWatchCalls 0)
    (addWatch guarded "guard" (lambda () (setq guardedWatchCalls (1+ guardedWatchCalls)) undefined))
    (setq compareRejected (compareAndSet guarded 99 -1))
    (setq compareMismatchWatchCalls guardedWatchCalls)
    (setq inheritedValidatorCalls 0)
    (setq inheritedOptions (Object/create (js-object :validator (lambda () (setq inheritedValidatorCalls (1+ inheritedValidatorCalls)) false))))
    (setq inheritedGuard (atom 1 inheritedOptions))
    (setq acceptedValue (reset guarded 5))
    (setq rejectedCode (captureError (lambda () (reset guarded -1))))
    (setq rejectedState (deref guarded))
    (setq rejectedReplacement (captureError (lambda () (setValidator guarded (lambda (value) (> value 100))))))
    (setq validatorUnchanged (= (getValidator guarded) nonnegative))
    (setq clearedValidator (setValidator guarded nil))
    (setq unguardedValue (reset guarded -1))
    (setq thrownMarker (js-object :marker "validator"))
    (setq throwing (atom 1 (js-object :validator (lambda (value) (when (= value 2) (throw thrownMarker)) t))))
    (setq validatorMarkerPreserved false)
    (try (reset throwing 2) (catch error (setq validatorMarkerPreserved (= error thrownMarker))))
    (setq stateAfterThrownValidator (deref throwing))
    (setq stateAfterRecovery (reset throwing 3))
    (setq reentrantSwap (atom 1))
    (setq reentrantSwapCode (captureError (lambda () (swap reentrantSwap (lambda (value) (reset reentrantSwap (+ value 1)) (+ value 2))))))
    (setq reentrantValidator (atom 1))
    (setq reentrantValidatorCode (captureError (lambda () (setValidator reentrantValidator (lambda (value) (reset reentrantValidator value) t)))))
    (setq reentrantCompare (atom 1))
    (setq reentrantCompareCode (captureError (lambda () (swap reentrantCompare (lambda (value) (compareAndSet reentrantCompare value (+ value 1)) (+ value 2))))))
    (setq watched (atom 0))
    (setq watchEvents (js-array))
    (addWatch watched "observer" (lambda (key reference oldValue newValue) (js-call watchEvents :push (js-array key oldValue newValue)) undefined))
    (addWatch watched "control" (lambda (key reference oldValue newValue)
    (js-call watchEvents :push (js-array key oldValue newValue))
    (when (= newValue 1)
      (removeWatch reference "control") (removeWatch reference "observer")
      (addWatch reference "late" (lambda (lateKey atom lateOld lateNew) (js-call watchEvents :push (js-array lateKey lateOld lateNew)) undefined))
      (reset reference 2)) undefined))
    (setq outerResetResult (reset watched 1))
    (setq outerEvents (js-call (js-call (js-call watchEvents :filter (lambda (entry) (and (= (aref entry 1) 0) (= (aref entry 2) 1)))) :map (lambda (entry) (aref entry 0))) :sort))
    (setq nestedEvents (js-call (js-call (js-call watchEvents :filter (lambda (entry) (and (= (aref entry 1) 1) (= (aref entry 2) 2)))) :map (lambda (entry) (aref entry 0))) :sort))
    (setq firstNestedIndex (js-call watchEvents :findIndex (lambda (entry) (= (aref entry 1) 1))))
    (setq lastOuterIndex (js-call watchEvents :findLastIndex (lambda (entry) (= (aref entry 1) 0))))
    (setq replacement (atom 0))
    (setq replacementEvents (js-array))
    (addWatch replacement "same" (lambda () (js-call replacementEvents :push "old")))
    (addWatch replacement "same" (lambda () (js-call replacementEvents :push "new")))
    (reset replacement 1)
    (setq watchFailure (atom 0))
    (setq watchMarker (js-object :marker "watch"))
    (setq healthyWatchCalls 0)
    (addWatch watchFailure "bad" (lambda () (throw watchMarker)))
    (addWatch watchFailure "good" (lambda () (setq healthyWatchCalls (1+ healthyWatchCalls)) undefined))
    (setq watchMarkerPreserved false)
    (try (reset watchFailure 1) (catch error (setq watchMarkerPreserved (= error watchMarker))))
    (removeWatch watchFailure "bad")
    (setq watchRecoveryValue (reset watchFailure 2))
    (setq model (atom 0 (js-object :validator (lambda (value) (>= value 0)))))
    (setq modelValue 0)
    (setq modelTransitions 0)
    (setq modelAgreement t)
    (addWatch model "model" (lambda (key reference oldValue newValue) (setq modelTransitions (1+ modelTransitions))
    (unless (= oldValue modelValue) (setq modelAgreement false)) (setq modelValue newValue) undefined))
    (setq randomState 1831565813)
    (let ((index 0))
    (while (< index 20000)
      (setq randomState (bit-xor randomState (bit-shift-left randomState 13)) randomState (bit-xor randomState (unsigned-bit-shift-right randomState 17))
            randomState (bit-xor randomState (bit-shift-left randomState 5)) randomState (uint32 randomState))
      (cond ((= (% index 17) 0) (let ((before (deref model)))
                               (unless (= (captureError (lambda () (reset model -1))) "ELI-ATOM-VALIDATION") (setq modelAgreement false))
                               (unless (= (deref model) before) (setq modelAgreement false))))
            ((= (% index 13) 0) (let* ((before (deref model)) (candidate (% randomState 10000)) (values (vectorToArray (resetVals model candidate))))
                                 (unless (and (= (aref values 0) before) (= (aref values 1) candidate)) (setq modelAgreement false))))
            ((= (% index 11) 0) (let* ((before (deref model)) (amount (% randomState 7)) (values (vectorToArray (swapVals model (lambda (value increment) (+ value increment)) amount))))
                                 (unless (and (= (aref values 0) before) (= (aref values 1) (+ before amount))) (setq modelAgreement false))))
            ((= (% index 7) 0) (let* ((before (deref model)) (shouldMatch (= (bit-and randomState 2) 0)) (expected (if shouldMatch before (+ before 1))) (candidate (% randomState 10000)))
                                (unless (= (compareAndSet model expected candidate) shouldMatch) (setq modelAgreement false))))
            ((= (bit-and randomState 1) 0) (let ((next (% randomState 10000))) (reset model next)))
            (t (let ((amount (% randomState 7))) (swap model (lambda (value increment) (+ value increment)) amount))))
      (unless (= (deref model) modelValue) (setq modelAgreement false)) (setq index (1+ index))))
    (setq scale (atom 0))
    (let ((index 0)) (while (< index 100000) (swap scale (lambda (value) (+ value 1))) (setq index (1+ index))))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :basic (js-object :atom (isAtom counter) :hostObject (isAtom (js-object)) :forgedAtom (isAtom forgedAtom) :hostileAtom (isAtom hostileAtom)
      :resetResult resetResult :swapResult swapResult :resetValues resetValues :swapValues swapValues :compareMismatch compareMismatch :compareSuccess compareSuccess
      :value (deref counter) :valueEqualCompare valueEqualCompare :valueEqualState (deref equalExpected) :opaqueMismatch opaqueMismatch :opaqueSuccess opaqueSuccess :opaqueState (deref opaqueReference)
      :invalidReference (captureError (lambda () (deref (js-object)))) :invalidTransform (captureError (lambda () (swap counter nil))))
    :validation (js-object :calls validatorCalls :compareRejected compareRejected :compareMismatchWatchCalls compareMismatchWatchCalls :guardedWatchCalls guardedWatchCalls
      :acceptedValue acceptedValue :rejectedCode rejectedCode :rejectedState rejectedState :rejectedReplacement rejectedReplacement :validatorUnchanged validatorUnchanged
      :clearedValidator clearedValidator :unguardedValue unguardedValue :initialRejection (captureError (lambda () (atom -1 (js-object :validator (lambda (v) (>= v 0))))))
      :invalidValidator (captureError (lambda () (atom 0 (js-object :validator 1)))) :invalidOptions (captureError (lambda () (atom 0 (js-object :unknown t))))
      :inheritedValidatorCalls inheritedValidatorCalls :inheritedValue (deref inheritedGuard) :validatorMarkerPreserved validatorMarkerPreserved
      :stateAfterThrownValidator stateAfterThrownValidator :stateAfterRecovery stateAfterRecovery)
    :reentrancy (js-object :swap reentrantSwapCode :swapState (deref reentrantSwap) :validator reentrantValidatorCode :validatorState (deref reentrantValidator)
      :validatorInstalled (not (= (getValidator reentrantValidator) nil)) :compare reentrantCompareCode :compareState (deref reentrantCompare))
    :watches (js-object :outerResetResult outerResetResult :finalValue (deref watched) :outerEvents outerEvents :nestedEvents nestedEvents :ordered (< lastOuterIndex firstNestedIndex)
      :replacementEvents replacementEvents :watchMarkerPreserved watchMarkerPreserved :committedAfterFailure (deref watchFailure) :healthyWatchCalls healthyWatchCalls :watchRecoveryValue watchRecoveryValue)
    :model (js-object :agreement modelAgreement :transitions modelTransitions :value (deref model)) :scale (js-object :value (deref scale))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
