(module tests.fixtures.bit-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar usage undefined)
  (defvar bit undefined)
  (defvar intrinsic undefined)
  (defvar evaluate undefined)
  (defvar library undefined)
  (defvar sample undefined)
  (defvar order undefined)
  (defvar evaluationResult undefined)
  (defasync run-host-main ()
    (setq usage (await (funcall load-module (get (pathToFileURL (aref (get globalThis.process :argv) 2)) :href))))
    (setq bit (await (funcall load-module (get (pathToFileURL (aref (get globalThis.process :argv) 3)) :href))))
    (setq intrinsic (get (get usage :__eliscript_portable__) "intrinsic-results"))
    (setq evaluate (get (get usage :__eliscript_portable__) "bit-evaluation"))
    (setq library (get bit :__eliscript_portable__))
    (setq sample 305419896)
    (setq order (js-array))
    (setq evaluationResult (funcall evaluate (lambda () (js-call order :push "left") 1) (lambda () (js-call order :push "right") 2)))
    (js-call globalThis.console :log (JSON/stringify (js-object :intrinsics (funcall intrinsic) :evaluation (js-object :result evaluationResult :order order)
    :library (js-object :zero (js-call library "bit-count" 0) :all (js-call library "bit-count" -1) :alternating (js-call library "bit-count" 1431655765)
      :high (js-call library "bit-count" 2147483648) :rotateLeft (js-call library "rotate-left" sample 8) :rotateRight (js-call library "rotate-right" sample 8)
      :rotateIdentity (js-call library "rotate-left" sample 32) :rotateMasked (js-call library "rotate-left" sample -24))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
