(module managed.regexp
  (defconst numeric-pattern (js* "/^[+-]?(?:[0-9]+(?:[.][0-9]*)?|[.][0-9]+)(?:[eE][+-]?[0-9]+)?$/"))
  (defconst groups-pattern (js* "/([a-z]+)([0-9]*)/"))
  (defconst nullable-pattern (js* "/(?:(?:a)??)?/"))
  (defconst unicode-pattern (js* "/(😀|[a-z])+/u"))
  (defconst line-pattern (js* "/^b$/m"))
  (defun numeric (x) (js-call numeric-pattern :test x))
  (defun groups (x) (js-call groups-pattern :exec x))
  (defun nullable (x) (js-call nullable-pattern :exec x))
  (defun unicode (x) (js-call unicode-pattern :exec x))
  (defun line (x) (js-call line-pattern :test x))
  (defun meta (x key) (get x key))
  (defun own (x key) (object-has? x key))
  (defun keys (x) (object-keys x))
  (defun capture (x trace)
    (js-call numeric-pattern :test x (progn (setq x "bad") (put trace :visited 7))))
  (export numeric groups nullable unicode line meta own keys capture))
