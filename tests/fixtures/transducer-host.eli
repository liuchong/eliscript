(module tests.fixtures.transducer-host
  (import "../../runtime/core/transducer.mjs" catting composeTransducers deduping distincting droppingWhile eduction filtering interposing into keeping keepingIndexed
    mapcatting mapping mappingIndexed partitioningBy taking takingNth takingWhile runBang transduce)
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/vector.mjs" EMPTY_VECTOR)
  (defconst pipeline (composeTransducers (mapping (lambda (value) (* value 3))) (filtering (lambda (value) (= (% value 2) 0))) (taking 3)))
  (defconst values (into EMPTY_VECTOR pipeline (js-array 1 2 3 4 5 6 7 8)))
  (defconst entries (into (persistentHashMap) (mapping (lambda (value) (js-array (str "key-" value) (* value 10)))) (js-array 1 2)))
  (defconst visits (js-array))
  (defconst reduciblePipeline (eduction (mapping (lambda (value) (* value 2))) (filtering (lambda (value) (> value 4))) (js-array 1 2 3 4)))
  (runBang (lambda (value) (js-call visits :push value)) reduciblePipeline)
  (defconst append-value (lambda (result value) (js-call result :concat (js-array value))))
  (js-call globalThis.console :log (JSON/stringify (js-object
    :pipeline (Array/from values) :sum (transduce pipeline (lambda (total value) (+ total value)) 0 (js-array 1 2 3 4 5 6))
    :entries (js-call (Array/from entries) :sort (lambda (left right) (js-call (aref left 0) :localeCompare (aref right 0))))
    :eduction (Array/from (into EMPTY_VECTOR reduciblePipeline)) :visits visits
    :reused (js-array (transduce (taking 2) append-value (js-array) (js-array 1 2 3)) (transduce (taking 2) append-value (js-array) (js-array 1 2 3)))
    :stateful (transduce (composeTransducers (deduping) (mappingIndexed (lambda (index value) (js-array index value)))
        (keeping (lambda (entry) (let ((index (aref entry 0)) (value (aref entry 1))) (if (= value nil) nil (str index ":" value)))))
        (droppingWhile (lambda (value) (js-call value :endsWith ":skip"))) (takingWhile (lambda (value) (not (js-call value :endsWith ":stop")))))
      append-value (js-array) (js-array "skip" "skip" nil "left" "left" "right" "stop" "unreachable"))
    :distinct (transduce (distincting) append-value (js-array) (js-array 1 2 1 3 2))
    :sampled (transduce (composeTransducers (keepingIndexed (lambda (index value) (if (= value nil) nil (str index ":" value)))) (takingNth 2))
      append-value (js-array) (js-array "left" nil "skip" "right" "tail"))
    :interposed (transduce (interposing "between") append-value (js-array) (js-array "left" "right"))
    :partitions (transduce (partitioningBy (lambda (value) (% value 2))) (lambda (result value) (js-call result :concat (js-array (Array/from value)))) (js-array) (js-array 1 3 2 4 5))
    :flattened (transduce (composeTransducers (mapcatting (lambda (value) (js-array value (* value 10)))) (taking 3)) append-value (js-array) (js-array 1 2 3))
    :concatenated (transduce (catting) append-value (js-array) (js-array (js-array "left") (js-array "right"))))))
)
