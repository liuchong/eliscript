(module managed.host-identity
  (defun token (value) (host-identity-token value))
  (defconst alias token)
  (defun factory () (lambda (value) (host-identity-token value)))
  (defconst nested (factory))
  (defun safe (value)
    (try (host-identity-token value)
      (catch error (str (get error :name) ":" (get error :message)))))
  (defun effects ()
    (let ((trace (js-array)) (value (js-object)))
      (let ((first (host-identity-token (progn (js-call trace :push 1) value)))
            (second (host-identity-token (progn (js-call trace :push 2) value))))
        (js-array (= first second) trace))))
  (defun abrupt ()
    (let ((trace (js-array)) (marker (js-object)))
      (try (host-identity-token (progn (js-call trace :push 1) (throw marker)))
        (catch error (js-array (= error marker) trace)))))
  (defun symbol-case ()
    (let ((left (funcall (js* "Symbol") "same")) (right (funcall (js* "Symbol") "same")))
      (js-array (host-identity-token left) (host-identity-token right) (host-identity-token left))))
  (defun function-case ()
    (let ((left (lambda () 1)) (right (lambda () 1)))
      (js-array (host-identity-token left) (host-identity-token right) (host-identity-token left))))
  (defun no-conversion ()
    (let* ((trace (js-array))
           (object (js-object :toString (lambda () (js-call trace :push "string") "x")
                             :valueOf (lambda () (js-call trace :push "number") 1))))
      (host-identity-token object) trace))
  (export token alias nested safe effects abrupt symbol-case function-case no-conversion))
