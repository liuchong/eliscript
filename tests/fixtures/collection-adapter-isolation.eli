(module tests.fixtures.collection-adapter-isolation
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst prototypes (js-array globalThis.Array.prototype globalThis.Map.prototype globalThis.Set.prototype))
  (defconst before (js-call prototypes :map (lambda (prototype) (Reflect/ownKeys prototype))))
  (defvar collection undefined)
  (defvar protocol undefined)
  (defvar after undefined)
  (defvar slots undefined)
  (defasync run-host-main ()
    (setq collection (await (funcall load-module "../../runtime/core/collection.mjs")))
    (setq protocol (await (funcall load-module "../../runtime/core/protocol.mjs")))
    (setq after (js-call prototypes :map (lambda (prototype) (Reflect/ownKeys prototype))))
    (setq slots (js-call (js-array (js-array "ICounted" "count") (js-array "IEmptyable" "empty") (js-array "IConj" "conj")
      (js-array "ILookup" "get") (js-array "IIndexed" "nth") (js-array "ISeqable" "seq") (js-array "IReduce" "reduce")
      (js-array "IAssociative" "assoc") (js-array "IAssociative" "contains") (js-array "IMap" "dissoc") (js-array "ISet" "disj")
      (js-array "IStack" "peek") (js-array "IStack" "pop") (js-array "IReversible" "rseq")) :map
      (lambda (entry) (js-call protocol :protocolSlot (get collection (aref entry 0)) (aref entry 1)))))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :unchanged (js-call before :map (lambda (keys index) (and (= (js-length keys) (js-length (aref after index)))
      (js-call keys :every (lambda (key keyIndex) (= key (aref (aref after index) keyIndex)))))))
    :protocolSlotsAbsent (js-call prototypes :map (lambda (prototype)
      (js-call slots :every (lambda (slot) (not (Reflect/apply globalThis.Object.prototype.hasOwnProperty prototype (js-array slot)))))))))))
  (run-host-main)
)
