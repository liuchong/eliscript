(module managed.source.collections
  (defun empty-map () (new globalThis.Map))
  (defun empty-set () (new globalThis.Set))
  (defun raw-map () (new (js* "Map")))
  (defun raw-set () (new (js* "Set")))
  (defun from-map (input) (new globalThis.Map input))
  (defun from-set (input) (new globalThis.Set input))
  (defun map-extra (input marker) (new globalThis.Map input (put marker 0 9)))
  (defun set-extra (input marker) (new globalThis.Set input (put marker 0 9)))
  (defun size (m) (get m :size))
  (defun length (m) (js-length m))
  (defun lookup (m k) (js-call m :get k))
  (defun lookup-none (m) (js-call m :get))
  (defun set-value (m k v) (js-call m :set k v))
  (defun set-none (m) (js-call m :set))
  (defun add-value (m k) (js-call m :add k))
  (defun add-none (m) (js-call m :add))
  (defun has (m k) (js-call m :has k))
  (defun delete-value (m k) (js-call m :delete k))
  (defun clear (m) (js-call m :clear))
  (defun entries (m) (js-call m :entries))
  (defun keys (m) (js-call m :keys))
  (defun values (m) (js-call m :values))
  (defun next (it) (js-call it :next))
  (defun next-extra (it marker) (js-call it :next (put marker 0 9)))
  (defun read-value (m k) (get m k))
  (defun write (m k v) (put m k v))
  (defun own (m k) (object-has? m k))
  (defun own-keys (m) (object-keys m))
  (defun assoc (m k v) (object-assoc m k v))
  (defun set-order (m marker) (js-call m :set (put marker 0 1) (put marker 0 2) (put marker 0 3)))
  (defun has-extra (m k marker) (js-call m :has k (put marker 0 9)))
  (defun clear-extra (m marker) (js-call m :clear (put marker 0 9)))
  (defun method-shadow (m marker) (js-call m :get (put marker 0 9)))
  (defun method-replace (m k v) (js-call m :set k (progn (put m :set false) v)))
  (defun map-loop (n) (let ((m (new globalThis.Map)) (i 0))
    (while (< i n) (js-call m :set i i) (setq i (1+ i))) m))
  (defun set-loop (n) (let ((m (new globalThis.Set)) (i 0))
    (while (< i n) (js-call m :add i) (setq i (1+ i))) m))
  (defun for-each-with (items callback) (js-call items :forEach callback))
  (defun visit (items log) (js-call items :forEach (lambda (value key receiver) (js-call log :push (js-array value key (eq items receiver))))))
  (defun record-callback (log) (lambda (&rest args) (js-call log :push args)))
  (defun for-each-mutate (set mode)
    (let* ((items (if set (new globalThis.Set (js-array 1 2 3)) (new globalThis.Map (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c")))))
           (log (js-array)) (first t))
      (js-call items :forEach (lambda (value key receiver)
        (js-call log :push (js-array value key (eq items receiver)))
        (when first
          (setq first false)
          (if (= mode 0)
            (progn (js-call items :delete 2) (if set (js-call items :add 4) (js-call items :set 4 "d")))
            (if (= mode 1)
              (progn (js-call items :delete 1) (if set (js-call items :add 1) (js-call items :set 1 "again")))
              (if (= mode 2)
                (progn (js-call items :clear) (if set (js-call items :add 5) (js-call items :set 5 "after")))
                (if set (js-call items :add 3) (js-call items :set 3 "changed"))))))))
      log))
  (defun for-each-own-capture (items trace)
    (put items :forEach (lambda (first &rest extras) (js-array first (js-length extras))))
    (js-call items :forEach (progn (put items :forEach false) "captured") (progn (put trace 0 9) t)))
  (defun for-each-builtin-capture (items log trace)
    (js-call items :forEach (progn (put items :forEach false) (lambda (value key receiver) (js-call log :push (js-array value key (eq items receiver))))) (put trace 0 9)))
  (defun for-each-reentrant (items)
    (let ((log (js-array)) (nested false))
      (js-call items :forEach (lambda (value key receiver)
        (js-call log :push (js-array "outer" value key))
        (unless nested (setq nested t) (js-call items :forEach (lambda (inner index source) (js-call log :push (js-array "inner" inner index))))))) log))
  (defun for-each-fail (items marker)
    (js-call items :forEach (lambda (value key receiver) (put marker 0 value) (false) (put marker 0 99))))
  (defun for-each-actions (set actions)
    (let ((items (if set (new globalThis.Set (js-array 1 2 3))
                   (new globalThis.Map (js-array (js-array 1 10) (js-array 2 20) (js-array 3 30)))))
          (log (js-array)) (index 0))
      (js-call items :forEach (lambda (value key receiver)
        (js-call log :push (js-array value key (eq receiver items)))
        (when (< index (js-length actions))
          (let ((operations (js-nth index actions)) (position 0))
            (while (< position (js-length operations))
              (let* ((operation (js-nth position operations)) (kind (js-nth 0 operation)))
                (cond ((= kind 0) (js-call items :delete (js-nth 1 operation)))
                      ((= kind 1) (js-call items :clear))
                      (t (if set (js-call items :add (js-nth 1 operation))
                           (js-call items :set (js-nth 1 operation) (js-nth 2 operation))))))
              (setq position (1+ position))))) (setq index (1+ index)))) log))
  (export for-each-actions for-each-with visit record-callback for-each-mutate for-each-own-capture for-each-builtin-capture for-each-reentrant for-each-fail)
  (export empty-map empty-set raw-map raw-set from-map from-set map-extra set-extra size length
    lookup lookup-none set-value set-none add-value add-none has delete-value clear entries keys values next
    next-extra read-value write own own-keys assoc set-order has-extra clear-extra method-shadow method-replace map-loop set-loop))
