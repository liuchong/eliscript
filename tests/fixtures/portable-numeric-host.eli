(module tests.fixtures.portable-numeric-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar numeric undefined)
  (defvar abs undefined)
  (defvar checkedAdd undefined)
  (defvar checkedMultiply undefined)
  (defvar checkedSubtract undefined)
  (defvar clamp undefined)
  (defvar compareNumber undefined)
  (defvar isEven undefined)
  (defvar isFiniteNumber undefined)
  (defvar gcd undefined)
  (defvar isInfinite undefined)
  (defvar isInteger undefined)
  (defvar lcm undefined)
  (defvar maxNumber undefined)
  (defvar minNumber undefined)
  (defvar modulo undefined)
  (defvar isNan undefined)
  (defvar isNegative undefined)
  (defvar isNumber undefined)
  (defvar isOdd undefined)
  (defvar isPositive undefined)
  (defvar quot undefined)
  (defvar rem undefined)
  (defvar isSafeInteger undefined)
  (defvar sign undefined)
  (defvar isZero undefined)
  (defvar maxSafe undefined)
  (defvar divisionCases undefined)
  (defvar generatedInvariant undefined)
  (defasync run-host-main ()
    (setq numeric (await (funcall load-module (get (pathToFileURL (aref (get globalThis.process :argv) 2)) :href))))
    (setq abs numeric.abs)
    (setq checkedAdd numeric.checked_add)
    (setq checkedMultiply numeric.checked_multiply)
    (setq checkedSubtract numeric.checked_subtract)
    (setq clamp numeric.clamp)
    (setq compareNumber numeric.compare_number)
    (setq isEven numeric.even_QMARK_)
    (setq isFiniteNumber numeric.finite_QMARK_)
    (setq gcd numeric.gcd)
    (setq isInfinite numeric.infinite_QMARK_)
    (setq isInteger numeric.integer_QMARK_)
    (setq lcm numeric.lcm)
    (setq maxNumber numeric.max_number)
    (setq minNumber numeric.min_number)
    (setq modulo numeric.modulo)
    (setq isNan numeric.nan_QMARK_)
    (setq isNegative numeric.negative_QMARK_)
    (setq isNumber numeric.number_QMARK_)
    (setq isOdd numeric.odd_QMARK_)
    (setq isPositive numeric.positive_QMARK_)
    (setq quot numeric.quot)
    (setq rem numeric.rem)
    (setq isSafeInteger numeric.safe_integer_QMARK_)
    (setq sign numeric.sign)
    (setq isZero numeric.zero_QMARK_)
    (setq maxSafe globalThis.Number.MAX_SAFE_INTEGER)
    (setq divisionCases (js-call (js-array (js-array 5 3) (js-array -5 3) (js-array 5 -3) (js-array -5 -3) (js-array 6 -3)) :map
    (lambda (pair) (let ((dividend (aref pair 0)) (divisor (aref pair 1)))
      (js-object :dividend dividend :divisor divisor :quot (quot dividend divisor) :rem (rem dividend divisor) :modulo (modulo dividend divisor))))))
    (setq generatedInvariant t)
    (let ((index 0))
    (while (and generatedInvariant (< index 50000))
      (let* ((left (- (% (* index 104729) 2000003) 1000001)) (right (- (% (+ (* index 130363) 17) 1999999) 999999)))
        (when (= right 0) (setq right 1))
        (let* ((quotient (quot left right)) (remainder (rem left right)) (modulus (modulo left right))
               (divisor (gcd left right)) (multiple (lcm left right)) (expectedProduct (Math/abs (* left right)))
               (modulusSign (or (= modulus 0) (= (Math/sign modulus) (Math/sign right)))))
          (when (or (not (= left (+ (* quotient right) remainder))) (>= (Math/abs remainder) (Math/abs right))
                    (>= (Math/abs modulus) (Math/abs right)) (not modulusSign) (not (= divisor (gcd right left)))
                    (not (= (rem left divisor) 0)) (not (= (rem right divisor) 0)) (= multiple nil)
                    (not (= (* divisor multiple) expectedProduct)) (not (= (checkedAdd left right) (+ left right)))
                    (not (= (checkedSubtract left right) (- left right))) (not (= (checkedMultiply left right) (* left right))))
            (setq generatedInvariant false))))
      (setq index (1+ index))))
    (js-call globalThis.console :log (JSON/stringify
    (js-object
      :classification (js-object
        :number (js-array (isNumber 0) (isNumber globalThis.NaN) (isNumber (js* "1n")) (isNumber "1"))
        :finite (js-array (isFiniteNumber 0) (isFiniteNumber maxSafe) (isFiniteNumber globalThis.Infinity) (isFiniteNumber globalThis.NaN))
        :nan (js-array (isNan globalThis.NaN) (isNan globalThis.Infinity) (isNan "NaN"))
        :infinite (js-array (isInfinite globalThis.Infinity) (isInfinite (- globalThis.Infinity)) (isInfinite globalThis.NaN))
        :integer (js-array (isInteger 0) (isInteger -17) (isInteger 1.5) (isInteger globalThis.Infinity))
        :safeInteger (js-array (isSafeInteger maxSafe) (isSafeInteger (- maxSafe)) (isSafeInteger (+ maxSafe 1)) (isSafeInteger 1.5))
        :zero (js-array (isZero 0) (isZero (js* "-0")) (isZero false))
        :positive (js-array (isPositive 1) (isPositive globalThis.Infinity) (isPositive 0) (isPositive globalThis.NaN))
        :negative (js-array (isNegative -1) (isNegative (- globalThis.Infinity)) (isNegative (js* "-0")) (isNegative globalThis.NaN))
        :parity (js-array (isEven -4) (isOdd -3) (isOdd maxSafe) (isEven (- maxSafe 1)) (isEven (+ maxSafe 1)) (isOdd 1.5)))
      :scalar (js-object
        :abs (js-array (abs -9) (abs 4) (Object/is (abs (js* "-0")) 0) (abs "9"))
        :absNan (Number/isNaN (abs globalThis.NaN)) :absInfinity (= (abs (- globalThis.Infinity)) globalThis.Infinity)
        :sign (js-array (sign (- globalThis.Infinity)) (sign -2) (sign (js* "-0")) (sign 2) (sign globalThis.Infinity) (sign "2"))
        :signNan (Number/isNaN (sign globalThis.NaN))
        :compare (js-array (compareNumber -2 1) (compareNumber 1 1) (compareNumber 2 1) (compareNumber globalThis.NaN 1) (compareNumber 1 "1"))
        :minimum (minNumber 7 -3 12 0) :maximum (maxNumber 7 -3 12 0)
        :minInfinity (= (minNumber globalThis.Infinity 3 (- globalThis.Infinity)) (- globalThis.Infinity))
        :maxInfinity (= (maxNumber (- globalThis.Infinity) 3 globalThis.Infinity) globalThis.Infinity)
        :minNan (Number/isNaN (minNumber 3 globalThis.NaN 1)) :maxNan (Number/isNaN (maxNumber globalThis.NaN 3 1))
        :minInvalid (minNumber 1 "0") :maxInvalid (maxNumber 1 nil)
        :clamp (js-array (clamp 5 0 10) (clamp -1 0 10) (clamp 11 0 10) (clamp 5 10 0) (clamp "5" 0 10))
        :clampNan (Number/isNaN (clamp globalThis.NaN 0 10)))
      :checked (js-object
        :add (js-array (checkedAdd 20 22) (checkedAdd maxSafe 0) (checkedAdd maxSafe 1))
        :subtract (js-array (checkedSubtract 20 22) (checkedSubtract (- maxSafe) 0) (checkedSubtract (- maxSafe) 1))
        :multiply (js-array (checkedMultiply 6 7) (checkedMultiply maxSafe 0) (checkedMultiply maxSafe 2))
        :invalid (js-array (checkedAdd 1.5 2) (checkedSubtract 1 globalThis.Infinity) (checkedMultiply (js* "1n") 2))
        :normalizedZeros (js-array (Object/is (checkedAdd (js* "-0") (js* "-0")) 0) (Object/is (checkedSubtract (js* "-0") 0) 0) (Object/is (checkedMultiply -1 0) 0)))
      :division (js-object :cases divisionCases :invalid (js-array (quot 1 0) (rem 1.5 1) (modulo 1 (+ maxSafe 1)))
        :normalizedZeros (js-array (Object/is (quot -1 2) 0) (Object/is (rem -6 3) 0) (Object/is (modulo -6 3) 0)))
      :integerAlgorithms (js-object :gcd (js-array (gcd 54 24) (gcd -54 24) (gcd 0 0) (gcd maxSafe maxSafe))
        :lcm (js-array (lcm 21 6) (lcm -21 6) (lcm 0 maxSafe) (lcm maxSafe maxSafe))
        :invalid (js-array (gcd 1.5 2) (lcm maxSafe 2) (lcm globalThis.Infinity 1)) :fibonacciGcd (gcd 7540113804746346 4660046610375530))
      :properties (js-object :generatedInvariant generatedInvariant :cases 50000)))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
