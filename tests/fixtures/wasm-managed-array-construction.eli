(module construction
  (defconst from-value (js* "Array.from"))
  (defconst of-value (js* "Array.of"))
  (defun from (&rest args) (apply from-value args))
  (defun of (&rest args) (apply of-value args))
  (defun direct (x) (Array/from x))
  (defun member (x) (js-call globalThis.Array :from x))
  (defun map (x f) (Array/from x f))
  (defun mapper () (lambda (x i) (js-array x i)))
  (defun own (x k) (object-has? x k))
  (defun empty-of () (Array/of))
  (defun identities ()
    (and (eq from-value (get (js* "Array") :from))
         (eq of-value (js* "globalThis.Array.of"))))
  (defun collection (x kind)
    (if kind (new (js* "Map") x) (new (js* "Set") x)))
  (defun iterator (x) (js-call x :values))
  (defun exercise ()
    (let* ((items (js-array 4 5))
           (set (new (js* "Set") (js-array "a" "b")))
           (cursor (js-call (js-array 8 9) :values)) (next 0))
      (put items :length 3)
      (put cursor :next (lambda ()
        (setq next (1+ next)) (put cursor :next false)
        (js-object :done (> next 2) :value next)))
      (js-array
        (Array/from (str "A😀" (String/fromCharCode 55296)))
        (Array/of undefined false nil)
        (Array/from items)
        (Array/from (js-object :length 2.9 :0 "x"))
        (Array/from set (lambda (value index)
          (when (= index 0) (js-call set :delete "b") (js-call set :add "c"))
          (js-array value index)))
        (Array/from cursor))))
  (export from of direct member map mapper own empty-of identities collection iterator exercise))
