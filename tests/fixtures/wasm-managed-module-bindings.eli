(module managed.module.bindings
  (defvar counter 0)
  (defvar unset)
  (defconst missing)
  (defconst negative-zero -0.0)
  (defconst state (js-object :values (js-array -0.0 (/ 0 0) 5e-324) :label "中😀"))
  (defconst initialization-log (js-array))
  (defconst first (mark 1))
  (defconst second (mark 2))
  (mark 3)
  (put state :self state)
  (defvar current (lambda (&optional x &rest tail) (js-array x tail counter)))
  (defun mark (x) (js-call initialization-log :push x) x)
  (defun tick () (setq counter (1+ counter)))
  (defun read-counter () counter)
  (defun read-state () state)
  (defun write-counter (value) (setq counter value))
  (defun call-current (&rest values) (apply current values))
  (defun set-current (value) (setq current value))
  (defun identity (x) x)
  (defun identity-value () identity)
  (defun local-counter (value)
    (let ((counter value)) ((lambda () (setq counter (1+ counter)) counter))))
  (defun captured-global () (lambda (value) (setq counter (+ counter value)) counter))
  (defun allocate () (js-array 1 2 3))
  (defconst alias-name 3)
  (defun emitted-alias (alias_name) alias-name)
  (export emitted-alias counter unset missing negative-zero state initialization-log first second current
    mark tick read-counter read-state write-counter call-current set-current identity
    identity-value local-counter captured-global allocate))
