;; Managed table pressure runs wholly inside the owned-memory module.
(defun table-pressure (heap rounds)
  (let* ((frame (frame-new heap 4)) (map (value-table-new heap 10 4)) (index 0) (ok 1))
    (frame-set heap frame 0 map)
    (let ((set (value-table-new heap 11 4)))
      (frame-set heap frame 1 set) (value-table-add heap set map)
      (while (and (< index rounds) (= ok 1))
        (let ((key (value-string heap 1)))
          (frame-set heap frame 2 key)
          (value-unit-set heap key 0 (+ 65 (word-and index 31))) (value-seal heap key)
          (let ((removed (value-table-delete heap map key)))
            (when (/= removed (value-table-delete heap set key)) (setq ok 0)))
          (when (not (and (= (value-table-put heap map key set) 1)
                         (= (value-table-add heap set key) 1)
                         (= (value-table-get heap map key) set)
                         (= (value-table-has heap set key) 1))) (setq ok 0)))
        (setq index (1+ index)))
      (let ((iterator (value-table-iterator heap map)) (count 0))
        (frame-set heap frame 3 iterator)
        (while (= (value-iterator-next heap iterator) 1)
          (when (or (/= (value-iterator-value heap iterator) set)
                    (/= (value-table-has heap set (value-iterator-key heap iterator)) 1)) (setq ok 0))
          (setq count (1+ count)))
        (when (/= count (value-table-size heap map)) (setq ok 0)))
      (if (= ok 1) (frame-return heap frame map)
        (progn (frame-pop heap frame) (fail 3))))))
(export table-pressure)
