(module managed.objects
  (defun make (x y) (js-object :x x :y y :missing undefined "" nil))
  (defun empty () (js-object))
  (defun computed (k v) (js-object (progn k) v))
  (defun duplicate (x y) (js-object :x x :x y))
  (defun read-value (o k) (get o k))
  (defun nth-value (k o) (js-nth k o))
  (defun default-value (o k fallback) (get o k fallback))
  (defun write (o k v) (put o k v))
  (defun has (o k) (object-has? o k))
  (defun keys (o) (object-keys o))
  (defun size (o) (js-length o))
  (defun assoc (o k v) (object-assoc o k v))
  (defun assoc-order (o k)
    (object-assoc o (progn (put o :old 2) k) (progn (put o :old 3) 4)))
  (defun default-order (o k) (let ((i 0)) (get o k (setq i 9)) i))
  (defun write-order (o p) (put o :saved (setq o p)))
  (defun null-proto () (js-object :__proto__ nil))
  (defun inherit (p x) (js-object :__proto__ p :own x))
  (defun proto (o) (get o :__proto__))
  (defun set-proto (o p) (put o :__proto__ p))
  (defun proto-data (v) (js-object (progn "__proto__") v))
  (defun self-cycle (v) (let ((o (js-object :v v))) (put o :self o) o))
  (defun grow-loop (n) (let ((o (js-object)) (i 0))
    (while (< i n) (put o i i) (setq i (1+ i))) o))
  (defun fault (o k) (get o k) (object-keys o))
  (export fault make empty computed duplicate read-value nth-value default-value write has keys size
    assoc assoc-order default-order write-order null-proto inherit proto set-proto proto-data self-cycle grow-loop))
