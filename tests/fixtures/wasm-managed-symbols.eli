(module managed-symbols
  (defconst symbol-family-marker 1)
  (defun create (&rest values) (apply (js* "Symbol") values))
  (defun registered (&rest values) (apply (js* "Symbol.for") values))
  (defun key (value) (Symbol/keyFor value))
  (defun description (value) (get value :description))
  (defun label (value) (js* "typeof value"))
  (defun equal (left right) (Object/is left right))
  (defun text (value) (funcall (js* "String") value))
  (defun iterator () (js* "Symbol.iterator"))
  (defun primitive () (js* "Symbol.toPrimitive"))
  (defun own (value key) (Object/hasOwn value key))
  (defun member (value key) (get value key))
  (defun write (value key child) (put value key child))
  (defun keys (value) (Object/keys value))
  (defun symbols (value) (Object/getOwnPropertySymbols value))
  (defun assign (value source) (Object/assign value source))
  (defun json (value) (JSON/stringify value))
  (defun identities ()
    (and (Object/is (js* "Symbol") (js* "globalThis.Symbol"))
      (Object/is (js* "Symbol.for") (js* "globalThis.Symbol.for"))
      (Object/is (js* "Symbol.iterator") (js* "globalThis.Symbol.iterator"))
      (Object/is (js* "Symbol.toPrimitive") (js* "globalThis.Symbol.toPrimitive"))))
  (defun exercise ()
    (let* ((key (funcall (js* "Symbol") "中😀"))
           (record (js-object :visible 1)) (copy (js-object))
           (state (js-object :n 0)) (source (js-object)))
      (put record key 2)
      (Object/assign copy record)
      (put source (js* "Symbol.iterator")
        (lambda () (js-object :next (lambda ()
          (let ((n (get state :n))) (put state :n (1+ n)) (js-object :done (>= n 3) :value n))))))
      (js-array (Object/is key key) (Object/is key (funcall (js* "Symbol") "中😀"))
        (Object/is (funcall (js* "Symbol.for") "shared") (funcall (js* "Symbol.for") "shared"))
        (js* "typeof key") (get key :description) (funcall (js* "String") key)
        (Object/keys record) (js-length (Object/getOwnPropertySymbols copy))
        (get copy key) (JSON/stringify record) (Array/from source))))
  (export identities exercise create registered key description label equal text iterator primitive own member write keys symbols assign json))
