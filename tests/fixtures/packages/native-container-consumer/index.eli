(module tests.fixtures.packages.native-container-consumer
  (defconst packageName "@eliscript-fixtures/native-container-consumer")
  (defconst host-type (js* "(value) => typeof value"))
  (defun isPlainObject (value)
    (and (not (= value nil)) (= (funcall host-type value) "object")
      (let ((prototype (Object/getPrototypeOf value))) (or (= prototype nil) (= prototype globalThis.Object.prototype)))))
  (defun requireNative (condition message) (unless condition (throw (new globalThis.TypeError message))))
  (defun consumeNativeOptions (options)
    (requireNative (isPlainObject options) "options must be a plain object")
    (requireNative (Array/isArray (get options :children)) "children must be an Array")
    (requireNative (js* "options.settings instanceof Map") "settings must be a Map")
    (requireNative (js* "options.tags instanceof Set") "tags must be a Set")
    (let ((beforeMutation (js-object :title (get options :title) :children (Array/from (get options :children))
                          :ready (js-call (get options :settings) :get "ready") :tags (js-call (Array/from (get options :tags)) :sort))))
      (js-call (get options :children) :push "package-added") (js-call (get options :settings) :set "package-added" t) (js-call (get options :tags) :add "package-added")
      (js-object :packageName packageName :nativeCategories (js-object :options (isPlainObject options) :children (Array/isArray (get options :children))
        :settings (js* "options.settings instanceof Map") :tags (js* "options.tags instanceof Set")) :beforeMutation beforeMutation
        :afterMutation (js-object :children (Array/from (get options :children)) :settingAdded (js-call (get options :settings) :get "package-added")
          :tags (js-call (Array/from (get options :tags)) :sort)))))
  (export packageName consumeNativeOptions))
