(module tests.fixtures.packages.interop-consumer
  (import "eliscript/runtime/literals.mjs" hashMap hashSet vector)
  (import "eliscript/stdlib/interop/js.mjs" to_js_object)
  (import "@eliscript-fixtures/native-container-consumer" consumeNativeOptions)
  (defconst children (vector "left" "right")) (defconst settings (hashMap "ready" t)) (defconst tags (hashSet "host" "stable"))
  (defconst source (hashMap "title" "Eliscript" "children" children "settings" settings "tags" tags))
  (defconst nativeOptions (to_js_object source (js-object :deep t))) (defconst consumer (consumeNativeOptions nativeOptions))
  (js-call globalThis.console :log (JSON/stringify (js-object :consumer consumer
    :sourceUnchanged (js-object :children (js-call children :toArray) :childCount (get children :count)
      :settingAdded (js-call settings :has "package-added") :tagAdded (js-call tags :has "package-added"))))))
