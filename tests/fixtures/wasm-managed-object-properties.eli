(module properties
  (defconst keys-function (js* "Object.keys"))
  (defconst own-function (js* "Object.hasOwn"))
  (defconst assign-function (js* "Object.assign"))
  (defun keys (&rest values) (apply keys-function values))
  (defun own (&rest values) (apply own-function values))
  (defun assign (&rest values) (apply assign-function values))
  (defun direct-keys (value) (Object/keys value))
  (defun direct-own (value key) (js-call globalThis.Object :hasOwn value key))
  (defun direct-assign (target source) (Object/assign target source))
  (defun member (value key) (get value key))
  (defun identities ()
    (and (eq keys-function (get (js* "Object") :keys))
         (eq own-function (js* "globalThis.Object.hasOwn"))
         (eq assign-function (get (js* "Object") :assign))))
  (defun map () (new (js* "Map")))
  (defun set () (new (js* "Set")))
  (defun iterator () (js-call (js-array 1 2) :values))
  (defun exercise ()
    (let* ((parent (js-object :inherited 7))
           (source (js-object :__proto__ parent :z 9 :2 "two" :01 "padded" :1 "one"))
           (target (js-object :first 0))
           (result (Object/assign target source "😀"))
           (map (new (js* "Map"))))
      (put map :tag "own")
      (js-array (Object/keys result) (eq target result)
                (Object/hasOwn result "inherited")
                (Object/hasOwn "😀" "1")
                (Object/hasOwn "😀" "length")
                (Object/keys map) (get result :z))))
  (export keys own assign direct-keys direct-own direct-assign member identities map set iterator exercise))
