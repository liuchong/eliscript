(module tests.fixtures.managed-vector-host
  (import "node:assert/strict" :default assert)
  (import "node:fs" readFileSync)
  (import "../helpers/managed-vector-contract.mjs" vectorCounts options check finish)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defasync main ()
    (let* ((mode (aref (get globalThis.process :argv) 2)) (js (await (funcall load-module (aref (get globalThis.process :argv) 3)))))
      (if (= mode "observe")
        (js-call globalThis.console :log (JSON/stringify (js-call vectorCounts :map (lambda (n) (js-array n (js-call js :vector_case n))))))
        (let* ((bytes (readFileSync (aref (get globalThis.process :argv) 4))) (module (new globalThis.WebAssembly.Module bytes)))
          (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports module) (js-array))
          (let* ((host (await (funcall load-module "../../tools/backends/managed-runtime.mjs")))
                 (a (js-call host :instantiateManagedRuntime bytes options))) (js-call a :auto 65536)
            (try (js-call vectorCounts :forEach (lambda (n) (check a n js))) (finally (finish a))))))))
  (main)
)
