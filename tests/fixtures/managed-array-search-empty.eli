(defconst marker 1)
(defun empty ()
  (let ((trace (js-object :events "")) (items (js-array)))
    (let ((bad (js-object :valueOf (lambda () (put trace :events "wrong") (js-object))
                          :toString (lambda () (js-object)))))
      (js-array (js-call items :includes nil bad (put trace :events "extra"))
                (js-call items :indexOf nil bad) (js-call items :lastIndexOf nil bad) (get trace :events)))))
(defun captured ()
  (let ((items (js-array)) (trace (js-object :events "")))
    (put items :includes (lambda (x &rest tail) (str "captured:" x ":" (js-length tail))))
    (js-array (js-call items :includes (progn (put items :includes false) "key")
                (put trace :events "from") (put trace :events "extra")) (get trace :events))))
(export empty captured)
