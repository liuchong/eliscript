(import "./persistent-vector.mjs"
  empty-persistent-vector persistent-vector? persistent-vector-count persistent-vector-meta
  persistent-vector-with-meta persistent-vector-nth persistent-vector-conj persistent-vector-assoc
  persistent-vector-pop persistent-vector-peek persistent-vector-reduce persistent-vector-to-array persistent-vector-from-array)
(defun vector-case (count)
  (let* ((metadata (js-object :tag "metadata"))
         (initial (persistent-vector-with-meta (empty-persistent-vector) metadata))
         (current initial) (at32 nil) (at1024 nil) (index 0))
    (while (< index count)
      (setq current (persistent-vector-conj current index) index (1+ index))
      (when (= index 32) (setq at32 current))
      (when (= index 1024) (setq at1024 current)))
    (let* ((changed (if (> count 0) (persistent-vector-assoc current 0 -1) current))
           (popped (persistent-vector-pop current))
           (appended (persistent-vector-assoc current count "append"))
           (small (persistent-vector-from-array (js-array 3 4 5))))
      (js-array
        (persistent-vector? current) (persistent-vector-count current)
        (persistent-vector-count initial) (persistent-vector-nth current 0 "missing")
        (persistent-vector-peek current "missing") (persistent-vector-nth changed 0 "missing")
        (if popped (persistent-vector-count popped) "empty")
        (if popped (persistent-vector-peek popped "missing") "empty")
        (if popped (Object/is (persistent-vector-meta popped) metadata) t)
        (Object/is (persistent-vector-meta changed) metadata)
        (persistent-vector-count appended) (persistent-vector-peek appended "missing")
        (Object/is (persistent-vector-meta current) metadata)
        (Object/is (persistent-vector-with-meta current metadata) current)
        (if at32 (js-array (persistent-vector-count at32) (persistent-vector-peek at32 nil)) nil)
        (if at1024 (js-array (persistent-vector-count at1024) (persistent-vector-peek at1024 nil)) nil)
        (persistent-vector-reduce (lambda (sum value) (+ sum value)) 0 current)
        (persistent-vector-to-array small)
        (persistent-vector-reduce (lambda (result value) (str result ":" value)) "" small)
        (persistent-vector-assoc current -1 "bad")
        (persistent-vector-assoc current (1+ count) "bad")))))
(export vector-case)
