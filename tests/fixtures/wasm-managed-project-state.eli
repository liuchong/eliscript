(module managed.project.state
  (defvar counter -0.0)
  (defconst history (js-array))
  (defconst state (js-object :values (js-array -0.0 (/ 0 0) 5e-324) :label "中😀"))
  (put state :self state)
  (defun advance (value)
    (setq counter (+ counter value))
    (js-call history :push counter)
    counter)
  (defun read-counter () counter)
  (defun read-state () state)
  (defun identity (value) value)
  (export counter history advance read-counter read-state identity)
  (export-default state))
