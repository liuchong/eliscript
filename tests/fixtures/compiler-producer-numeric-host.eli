(module tests.fixtures.compiler-producer-numeric-host
  (import "node:assert/strict" :default assert)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defasync run-host-main ()
    (let ((m (await (funcall load-module (aref (get globalThis.process :argv) 2)))))
    (js-call assert :equal (js-call m :add 20 22) 42)
    (js-call assert :equal (js-call m :add -1 1) 0)
    (funcall assert (Object/is (js-call m :add (js* "-0") (js* "-0")) (js* "-0")))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
