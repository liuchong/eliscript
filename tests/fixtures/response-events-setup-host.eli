(module tests.fixtures.response-events-setup-host
  (import "node:fs/promises" readFile writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:process" :default process)
  (import "../../tools/backends/compiler-build.mjs" buildIndependentCompiler)
  (defasync main ()
    (let* ((directory (aref (get process :argv) 2)) (artifact (await (buildIndependentCompiler (js-object :host "javascript" :outputRoot directory))))
      (frontend (await (funcall (js* "(specifier) => import(specifier)") (get (pathToFileURL (resolve directory "bootstrap/compiler.mjs")) :href))))
      (source (await (readFile (new globalThis.URL "../../bootstrap/host/compiler-session.eli" (js* "import.meta.url")) "utf8")))
      (exported (str (js-call source :slice 0 (js-call source :lastIndexOf ")")) "\n(export session-response-start session-response-control session-response-clear session-response-identities session-ir-wire))")))
      (await (writeFile (resolve directory "host/response-events-serializer-unit.mjs") (js-call frontend :compile_string exported "response-events-serializer-unit.eli")))
      (js-call (get process :stdout) :write (str (JSON/stringify (js-object :host (get artifact :host) :metadataPath (get artifact :metadataPath))) "\n"))))
  (main))
