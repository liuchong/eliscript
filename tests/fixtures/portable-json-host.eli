(module tests.fixtures.portable-json-host
  (import "node:url" pathToFileURL)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst moduleUrl (pathToFileURL (aref (get globalThis.process :argv) 2)))
  (defvar jsonModule undefined)
  (defvar resultModule undefined)
  (defvar vectorModule undefined)
  (defvar mapModule undefined)
  (defvar valueModule undefined)
  (defvar identifierModule undefined)
  (defvar listModule undefined)
  (defvar setModule undefined)
  (defvar jsonErrorCode undefined)
  (defvar jsonErrorMessage undefined)
  (defvar jsonErrorOffset undefined)
  (defvar jsonErrorPath undefined)
  (defvar isJsonError undefined)
  (defvar parseJson undefined)
  (defvar stringifyJson undefined)
  (defvar isErr undefined)
  (defvar isOk undefined)
  (defvar resultPayload undefined)
  (defvar vectorCount undefined)
  (defvar vectorFromArray undefined)
  (defvar vectorNth undefined)
  (defvar isVector undefined)
  (defvar mapGet undefined)
  (defvar isMap undefined)
  (defvar valueEqual undefined)
  (defvar mapFromEntries undefined)
  (defvar keyword undefined)
  (defvar symbol undefined)
  (defvar listFromArray undefined)
  (defvar setFromArray undefined)
  (defvar host-truth undefined)
  (defun payload (result) (resultPayload result))
  (defun encoded (value options)
    (let ((result (stringifyJson value options)))
      (unless (isOk result) (throw (new globalThis.Error (jsonErrorMessage (payload result))))) (payload result)))
  (defun errorReport (result)
    (let ((error (payload result)))
      (js-object :result (isErr result) :jsonError (isJsonError error) :code (jsonErrorCode error)
        :message (jsonErrorMessage error) :offset (jsonErrorOffset error) :path (jsonErrorPath error))))
  (defvar nestedResult undefined)
  (defvar nested undefined)
  (defvar nestedVector undefined)
  (defvar nestedMap undefined)
  (defvar escaped undefined)
  (defvar emoji undefined)
  (defvar emojiText undefined)
  (defvar loneSurrogate undefined)
  (defvar loneSurrogateText undefined)
  (defvar firstMap undefined)
  (defvar secondMap undefined)
  (defvar firstCanonical undefined)
  (defvar secondCanonical undefined)
  (defvar malformedSources undefined)
  (defvar malformed undefined)
  (defvar duplicate undefined)
  (defvar overflow undefined)
  (defvar sourceType undefined)
  (defvar unsupportedValues undefined)
  (defvar unsupported undefined)
  (defvar badNumberCodes undefined)
  (defvar badKey undefined)
  (defvar parseLimits undefined)
  (defvar stringifyLimits undefined)
  (defvar shared undefined)
  (defvar sharedText undefined)
  (defvar cyclic undefined)
  (defvar cycle undefined)
  (defvar malformedErrorRejected undefined)
  (defvar generatedRoundTrips undefined)
  (defvar scaleCount undefined)
  (defvar scaleSource undefined)
  (defvar scaleResult undefined)
  (defvar scaleValue undefined)
  (defvar scaleText undefined)
  (defasync run-host-main ()
    (setq jsonModule (await (funcall load-module (get moduleUrl :href))))
    (setq resultModule (await (funcall load-module (get (new globalThis.URL "./result.eli" moduleUrl) :href))))
    (setq vectorModule (await (funcall load-module (get (new globalThis.URL "./persistent-vector.eli" moduleUrl) :href))))
    (setq mapModule (await (funcall load-module (get (new globalThis.URL "./persistent-map.eli" moduleUrl) :href))))
    (setq valueModule (await (funcall load-module (get (new globalThis.URL "./value.eli" moduleUrl) :href))))
    (setq identifierModule (await (funcall load-module (get (new globalThis.URL "./identifier.eli" moduleUrl) :href))))
    (setq listModule (await (funcall load-module (get (new globalThis.URL "./persistent-list.eli" moduleUrl) :href))))
    (setq setModule (await (funcall load-module (get (new globalThis.URL "./persistent-set.eli" moduleUrl) :href))))
    (setq jsonErrorCode jsonModule.json_error_code)
    (setq jsonErrorMessage jsonModule.json_error_message)
    (setq jsonErrorOffset jsonModule.json_error_offset)
    (setq jsonErrorPath jsonModule.json_error_path)
    (setq isJsonError jsonModule.json_error_QMARK_)
    (setq parseJson jsonModule.parse_json)
    (setq stringifyJson jsonModule.stringify_json)
    (setq isErr resultModule.err_QMARK_)
    (setq isOk resultModule.ok_QMARK_)
    (setq resultPayload resultModule.result_payload)
    (setq vectorCount vectorModule.persistent_vector_count)
    (setq vectorFromArray vectorModule.persistent_vector_from_array)
    (setq vectorNth vectorModule.persistent_vector_nth)
    (setq isVector vectorModule.persistent_vector_QMARK_)
    (setq mapGet mapModule.persistent_map_get)
    (setq isMap mapModule.persistent_map_QMARK_)
    (setq valueEqual valueModule.value_equal_QMARK_)
    (setq mapFromEntries valueModule.value_map_from_entries)
    (setq keyword identifierModule.keyword)
    (setq symbol identifierModule.symbol)
    (setq listFromArray listModule.persistent_list_from_array)
    (setq setFromArray setModule.persistent_set_from_array)
    (setq host-truth (js* "(value) => !!value"))
    (setq nestedResult (parseJson "{\"z\":[true,null,\"x\\n\\u263a\"],\"a\":{\"n\":-1.25e3}}"))
    (setq nested (payload nestedResult))
    (setq nestedVector (mapGet nested "z" nil))
    (setq nestedMap (mapGet nested "a" nil))
    (setq escaped (payload (parseJson "\"\\\"\\\\\\/\\b\\f\\n\\r\\t\\u0041\"")))
    (setq emoji "\ud83d\ude00")
    (setq emojiText (encoded emoji))
    (setq loneSurrogate "\ud800")
    (setq loneSurrogateText (encoded loneSurrogate))
    (setq firstMap (mapFromEntries (js-array (js-array "b" 2) (js-array "a" 1))))
    (setq secondMap (mapFromEntries (js-array (js-array "a" 1) (js-array "b" 2))))
    (setq firstCanonical (encoded firstMap))
    (setq secondCanonical (encoded secondMap))
    (setq malformedSources (js-array "" " " "01" "1." "1e" "1e+" "[1,]" "{\"a\":1,}" "'x'" "{\"a\" 1}" "{a:1}" "\"\\x20\"" "\"line\nfeed\"" "true false"))
    (setq malformed (js-call malformedSources :map (lambda (source) (let ((result (parseJson source))) (and (isErr result) (isJsonError (payload result)))))))
    (setq duplicate (errorReport (parseJson "{\"a\":1,\"a\":2}")))
    (setq overflow (errorReport (parseJson "1e400")))
    (setq sourceType (errorReport (parseJson nil)))
    (setq unsupportedValues (js-array undefined (js* "1n") (js-object) (js-array) (listFromArray (js-array 1)) (setFromArray (js-array 1)) (keyword "json") (symbol "json")))
    (setq unsupported (js-call unsupportedValues :map (lambda (value) (jsonErrorCode (payload (stringifyJson value))))))
    (setq badNumberCodes (js-call (js-array globalThis.NaN globalThis.Infinity (- globalThis.Infinity)) :map (lambda (value) (jsonErrorCode (payload (stringifyJson value))))))
    (setq badKey (errorReport (stringifyJson (mapFromEntries (js-array (js-array (keyword "key") 1))))))
    (setq parseLimits (js-object
    :options (errorReport (parseJson "null" (js-object :unknown t)))
    :optionValues (js-call (js-array (js-object :maxDepth nil) (js-object :maxLength 1.5) (js-object :maxValues undefined)) :map
                   (lambda (options) (jsonErrorCode (payload (parseJson "null" options)))))
    :nullOptionsUseDefaults (isOk (parseJson "null" nil)) :length (errorReport (parseJson "null" (js-object :maxLength 3)))
    :depth (errorReport (parseJson "[[0]]" (js-object :maxDepth 1))) :values (errorReport (parseJson "[1,2]" (js-object :maxValues 2)))))
    (setq stringifyLimits (js-object :options (errorReport (stringifyJson nil (js-object :maxDepth 513)))
    :length (errorReport (stringifyJson nil (js-object :maxLength 3)))
    :depth (errorReport (stringifyJson (vectorFromArray (js-array (vectorFromArray (js-array 0)))) (js-object :maxDepth 1)))
    :values (errorReport (stringifyJson (vectorFromArray (js-array 1 2)) (js-object :maxValues 2)))))
    (setq shared (vectorFromArray (js-array 1)))
    (setq sharedText (encoded (vectorFromArray (js-array shared shared))))
    (setq cyclic (vectorFromArray (js-array nil)))
    (put (get cyclic :tail) 0 cyclic)
    (setq cycle (errorReport (stringifyJson cyclic)))
    (setq malformedErrorRejected (not (isJsonError (mapFromEntries (js-array (js-array "kind" "eliscript/json-error")
    (js-array "code" "ELI-JSON-SYNTAX") (js-array "message" "invalid") (js-array "path" "$") (js-array "extra" nil))))))
    (setq generatedRoundTrips t)
    (let ((index 0))
    (while (and generatedRoundTrips (< index 2000))
      (let* ((value (mapFromEntries (js-array (js-array "index" index) (js-array "parity" (= (% index 2) 0))
                     (js-array "items" (vectorFromArray (js-array (% index 17) (str "v" (% index 31)) nil))))))
             (roundTrip (parseJson (encoded value))))
        (when (or (not (isOk roundTrip)) (not (valueEqual (payload roundTrip) value))) (setq generatedRoundTrips false)))
      (setq index (1+ index))))
    (setq scaleCount 20000)
    (setq scaleSource (str "[" (js-call (Array/from (js-object :length scaleCount) (lambda (ignored index) index)) :join ",") "]"))
    (setq scaleResult (parseJson scaleSource))
    (setq scaleValue (payload scaleResult))
    (setq scaleText (encoded scaleValue))
    (js-call globalThis.console :log (JSON/stringify (js-object
    :parsing (js-object :ok (isOk nestedResult) :map (isMap nested) :vector (isVector nestedVector) :vectorCount (vectorCount nestedVector)
      :trueValue (vectorNth nestedVector 0 false) :nilValue (= (vectorNth nestedVector 1 "missing") nil) :stringValue (vectorNth nestedVector 2 "missing") :numberValue (mapGet nestedMap "n" nil))
    :strings (js-object :escapedCodes (Array/from escaped (lambda (character) (js-call character :charCodeAt 0))) :emojiText emojiText
      :emojiRoundTrip (= (payload (parseJson emojiText)) emoji) :loneSurrogateText loneSurrogateText
      :loneSurrogateRoundTrip (= (js-call (payload (parseJson loneSurrogateText)) :charCodeAt 0) 55296))
    :canonical (js-object :first firstCanonical :sameAcrossInsertionOrder (= firstCanonical secondCanonical) :nested (encoded nested) :negativeZero (encoded (js* "-0")))
    :strictness (js-object :malformed (js-call malformed :every host-truth) :malformedCount (js-length malformed) :duplicate duplicate :overflow overflow :sourceType sourceType)
    :domain (js-object :unsupported unsupported :badNumberCodes badNumberCodes :badKey badKey :sharedText sharedText :cycle cycle :malformedErrorRejected malformedErrorRejected)
    :limits (js-object :parse parseLimits :stringify stringifyLimits) :properties (js-object :generatedRoundTrips generatedRoundTrips)
    :scale (js-object :ok (isOk scaleResult) :count (vectorCount scaleValue) :first (vectorNth scaleValue 0 nil)
      :last (vectorNth scaleValue (- scaleCount 1) nil) :stable (= scaleText scaleSource))))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
