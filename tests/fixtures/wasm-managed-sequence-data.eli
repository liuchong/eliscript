(module test.managed-sequence-data
  (import "eliscript/runtime/core/collection.mjs" :as C)
  (import "eliscript/runtime/core/transducer.mjs" :as T)
  (import "eliscript/runtime/core/lazy-sequence.mjs" :as L)
  (import "eliscript/runtime/core/sequence.mjs" :as S)
  (import "eliscript/runtime/core/data.mjs" :as D)
  (import "eliscript/runtime/core/text.mjs" :as Text)
  (import "eliscript/runtime/core/object.mjs" :as O)
  (import "eliscript/runtime/core/set-algebra.mjs" :as A)
  (import "eliscript/runtime/core/value.mjs" :as V)
  (import "eliscript/runtime/core/value-internals.mjs" :as H)
  (import "eliscript/runtime/core/metadata.mjs" :as M)
  (import "eliscript/runtime/core/protocol.mjs" :as P)
  (import "eliscript/runtime/core/order.mjs" :as Order)
  (import "eliscript/runtime/core/data-text.mjs" :as DataText)

  (defun array-of (value) (T/into (js-array) value))
  (defun observed-source (state failure)
    (let* ((iterator (js-object
             :next (lambda ()
               (put state :pulls (1+ (get state :pulls)))
               (when (and failure (= (get state :pulls) 3)) (throw failure))
               (js-object :value (get state :pulls) :done false))
             :return (lambda ()
               (put state :closes (1+ (get state :closes)))
               (js-object :value undefined :done t)))))
      (put iterator (get globalThis/Symbol :iterator) (lambda () iterator)) iterator))
  (defun bounded-consumption ()
    (let* ((state (js-object :pulls 0 :closes 0))
           (source (C/unboundedSequenceView (lambda () (observed-source state nil))))
           (result (T/transduce (T/taking 3)
                     (lambda (out value) (js-call out :push value) out) (js-array) source))
           (zero-state (js-object :pulls 0 :closes 0))
           (zero-source (C/unboundedSequenceView (lambda () (observed-source zero-state nil))))
           (zero (T/transduce (T/taking 0) (lambda (sum value) (+ sum value)) 7 zero-source)))
      (js-array result state zero zero-state (array-of (S/take 5 (S/range))))))
  (defun cached-realization ()
    (let* ((starts 0) (state (js-object :pulls 0 :closes 0))
           (failure (new globalThis/Error "cached realization"))
           (source (L/lazySequence (lambda () (setq starts (1+ starts))
                     (C/unboundedSequenceView (lambda () (observed-source state failure))))))
           (left (js-call source (get globalThis/Symbol :iterator)))
           (right (js-call source (get globalThis/Symbol :iterator)))
           (first (js-call left :next)) (second (js-call left :next))
           (caught-left undefined) (caught-right undefined))
      (try (js-call left :next) (catch error (setq caught-left error)))
      (let ((replay (js-array (get (js-call right :next) :value) (get (js-call right :next) :value))))
        (try (js-call right :next) (catch error (setq caught-right error)))
        (js-array (get first :value) (get second :value) replay starts state
          (eq caught-left failure) (eq caught-right failure) (eq caught-left caught-right)
          (L/realizedLazySequenceCount source)))))
  (defun successful-cache ()
    (let* ((starts 0) (effects 0)
           (source (L/lazySequence (lambda () (setq starts (1+ starts)) (js-array 10 20 30))))
           (mapped (L/lazyMap (lambda (value) (setq effects (1+ effects)) (* value 2)) source))
           (before (js-array (L/isLazySequenceRealized mapped) (L/realizedLazySequenceCount mapped)))
           (first (array-of mapped)) (second (array-of mapped)))
      (js-array before first second starts effects (eq (L/realizeLazySequence mapped) mapped)
        (L/isLazySequenceRealized mapped) (L/realizedLazySequenceCount mapped))))
  (defun early-stop-and-partitions ()
    (let* ((state (js-object :pulls 0 :closes 0))
           (source (C/unboundedSequenceView (lambda () (observed-source state nil))))
           (sum (C/reduce source (lambda (out value)
                  (if (= value 3) (C/reduced (+ out value)) (+ out value))) 0))
           (partitions (array-of (S/map array-of (S/partitionAll 2 (js-array 1 2 3 4 5)))))
           (groups (array-of (S/map array-of (S/partitionBy (lambda (value) (mod value 2)) (js-array 1 3 2 4 5))))))
      (js-array sum state partitions groups
        (array-of (T/sequence (T/partitioningAll 2) (js-array)))
        (array-of (S/take 0 (S/range)))
        (T/transduce (T/composeTransducers) (lambda (out value) (+ out value)) 11 (js-array)))))
  (defun paths-aliases-and-collisions ()
    (let* ((shared [1 2]) (metadata (hash-map "source" "target"))
           (base (M/withMeta (hash-map "left" shared "right" shared) metadata))
           (updated (D/updateIn (D/assocIn base (js-array "nested" "visits") 1)
                      (js-array "nested" "visits") (lambda (value amount) (+ value amount)) 4))
           (collisions (hash-map "key-50691" "left" "key-194634" "right"))
           (object (O/assoc (js-object :absent undefined :zero 0) "__proto__" 7)))
      (js-array (D/getIn updated (js-array "nested" "visits"))
        (D/getIn base (js-array "nested" "visits") "missing")
        (eq (C/get base "left") (C/get base "right"))
        (eq (M/meta updated) metadata)
        (C/get collisions "key-50691") (C/get collisions "key-194634")
        (V/hashValue "key-50691") (V/hashValue "key-194634")
        (O/has object "absent") (get object :absent)
        (Object/hasOwn object "__proto__") (get object "__proto__")
        (eq (Object/getPrototypeOf object) (get globalThis/Object :prototype))
        (V/equalValues (A/union #{1 2} #{2 3}) #{3 2 1})
        (Text/slice 1 2 "A😀") (Text/join "/" (js-array "a" 2 false)))))
  (defun shared-hash-state ()
    (H/clearValueCaches)
    (let* ((value [1 2]) (computations 0)
           (direct (H/cachedProtocolHash value (lambda () (setq computations (1+ computations)) 123)))
           (public (V/hashValue value)) (first (H/readValueMetrics)))
      (H/resetValueMetrics)
      (let* ((again (V/hashValue value)) (reset (H/readValueMetrics)))
        (H/clearValueCaches)
        (let* ((cleared (H/readValueMetrics)) (recomputed (V/hashValue value)) (final (H/readValueMetrics)))
          (js-array direct public again computations first reset cleared recomputed final)))))
  (defun ieee-arithmetic ()
    (let ((nan (get globalThis/Number :NaN)) (infinity (get globalThis/Number :POSITIVE_INFINITY)))
      (js-array -0.0 (/ 1 -0.0) (/ 0 0) (/ 1 0) (- infinity infinity)
        (* -0.0 1) (+ 9007199254740992 1) (+ 0.1 0.2)
        (array-of (S/take 4 (S/iterate (lambda (value) (+ value 0.1)) -0.0)))
        (V/hashValue nan) (V/hashValue infinity) (V/hashValue -0.0) (V/hashValue 0))))
  (defun rejection-order ()
    (let* ((failure (new globalThis/Error "callback failure"))
           (state (js-object :pulls 0 :closes 0))
           (trace (js-array)) (caught undefined)
           (source (C/unboundedSequenceView (lambda () (observed-source state nil)))))
      (try
        (T/transduce (T/mapping (lambda (value) (js-call trace :push value) (throw failure)))
          (lambda (out value) (+ out value)) 0 source)
        (catch error (setq caught error)))
      (let ((errors (js-array)))
        (let* ((thunks (js-array
          (lambda () (L/lazySequence nil))
          (lambda () (T/takingNth 0))
          (lambda () (T/partitioningAll 0))
          (lambda () (D/updateIn (hash-map) (js-array "a") nil))
          (lambda () (Text/repeat -1 "x")))) (thunk-index 0))
          (while (< thunk-index (js-length thunks))
            (let ((thunk (aref thunks thunk-index)))
              (setq thunk-index (1+ thunk-index))
              (try (funcall thunk) (js-call errors :push (js-array "returned"))
                (catch error (js-call errors :push (js-array (get error :name) (get error :message))))))))
        (js-array (eq caught failure) trace state errors))))
  (defun standard-protocol-identities ()
    (let ((value (Object/create nil))
          (custom (P/defineProtocol "IPrint" (js-array "print"))))
      (put value (P/protocolSlot DataText/IPrint "print") (lambda (context) "target-print"))
      (put value (P/protocolSlot Order/IComparable "compare") (lambda (other) 0))
      (js-array (P/protocolSlot DataText/IPrint "print")
        (P/protocolMethod DataText/IPrint "print") (get DataText/IPrint :operations) DataText/IPrint
        (P/protocolSlot Order/IComparable "compare") Order/IComparable value custom)))
  (defun read-standard-input (value)
    (js-array (DataText/printValue value) (Order/compareValues value value)))
  (export bounded-consumption cached-realization successful-cache early-stop-and-partitions
    paths-aliases-and-collisions shared-hash-state ieee-arithmetic rejection-order
    standard-protocol-identities read-standard-input))
