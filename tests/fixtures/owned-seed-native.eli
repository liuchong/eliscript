(module tests.fixtures.owned-seed-native
  (import "./managed.mjs" :as managed)
  (defconst state (js-object :debugReads 0 :failure (js-object :debug "original nested getter failure")))
  (defconst productJSON "__OWNED_PRODUCT_DATA__")
  (defconst throwDebug "__OWNED_THROW_DEBUG__")
  (defun emit_fresh_observed_typed_native_memory_artifact (typed target options observer)
    (unless (= (funcall (js* "(value) => typeof value") observer) "function") (throw (new globalThis.Error "seed native emitter requires its explicit private observer")))
    (unless (and (= (get options :format) "library") (= (get options :binaryEncoding) "u16le-chunks")) (throw (new globalThis.Error "seed native options changed")))
    (put state :programsAtEmission (js-call (get (get managed :state) :modules) :map (lambda (record) (get record :program))))
    (let ((value (JSON/parse productJSON)))
      (when (= throwDebug t)
        (Object/defineProperty (aref (get (get value :debug) :ranges) 0) "kind" (js-object :enumerable t :get (lambda ()
          (put state :debugReads (+ (get state :debugReads) 1)) (throw (get state :failure))))))
      (js-object :bytes (get value :bytes) :debug (get value :debug))))
  (export state emit_fresh_observed_typed_native_memory_artifact))
