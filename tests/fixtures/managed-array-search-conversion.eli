(defconst marker 1)
(defun f (method)
  (let* ((trace (js-object :events "")) (items (js-array 1 2 1))
         (from (js-object :valueOf (lambda () (put trace :events (str (get trace :events) "v")) (js-object))
                          :toString (lambda () (put trace :events (str (get trace :events) "s")) "-1.9"))))
    (str (cond ((= method 0) (js-call items :includes 1 from (put trace :events "e")))
               ((= method 1) (js-call items :indexOf 1 from (put trace :events "e")))
               (t (js-call items :lastIndexOf 1 from (put trace :events "e")))) ":" (get trace :events))))
(export f)
