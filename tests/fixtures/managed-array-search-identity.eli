(defconst marker 1)
(defun identities ()
  (let ((object (js-object :valueOf (lambda () (js-call nil :charAt 0))))
        (other (js-object)) (fn (lambda () 1)))
    (let ((items (js-array object fn "x")))
      (js-array (js-call items :includes object) (js-call items :indexOf object)
                (js-call items :lastIndexOf fn) (js-call items :includes other)
                (js-call items :indexOf (js-object))))))
(defun ordinary ()
  (let ((o (js-object :includes (lambda (x) (str "own:" x)) :indexOf (lambda (x) x) :lastIndexOf (lambda () 19))))
    (js-array (js-call o :includes "x") (js-call o :indexOf 7) (js-call o :lastIndexOf))))
(export identities ordinary)
