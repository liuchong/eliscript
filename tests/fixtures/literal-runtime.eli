(module fixture.literal-runtime
  (defmacro generated-keyword () :macro/value)
  (defmacro generated-set () '(hash-set :macro/value [9]))

  (defconst vector-value [1 2 [3 4]])
  (defconst map-value
    (hash-map
      "name" "Eliscript"
      ["value-key"] [5 6]))
  (defconst map-literal
    {"name" "source"
     ["value-key"] [7 8]
     "nested" {:ready t}
     "duplicate" 1
     "duplicate" 2})
  (defconst set-value
    (hash-set "explicit" [5 6] "explicit"))
  (defvar set-evaluation-order "")
  (defun record-set-value (label value)
    (setq set-evaluation-order (str set-evaluation-order label))
    value)
  (defconst set-literal
    #{(record-set-value "1" "source")
      (record-set-value "2" "source")
      [7 8]
      {:ready t}})
  (defconst macro-set (generated-set))
  (defconst queue-value (queue "explicit" [5 6]))
  (defvar queue-evaluation-order "")
  (defun record-queue-value (label value)
    (setq queue-evaluation-order (str queue-evaluation-order label))
    value)
  (defconst queue-literal
    #queue [(record-queue-value "1" "source")
            (record-queue-value "2" [7 8])
            {:ready t}])
  (defconst keyword-value :article/title)
  (defconst keyword-map
    {:article/title "qualified"
     :ready t})
  (defconst macro-keyword (generated-keyword))
  (defconst quoted-keyword ':quoted/value)
  (defconst quoted-data '(alpha :beta [1 undefined] nil false))
  (defconst quoted-map '{:ready t})
  (defconst quoted-set '#{:ready [1 undefined]})
  (defconst quoted-queue '#queue [1 :ready])
  (defconst list-value (list 1 2 3))
  (defconst list-first (car list-value))
  (defconst list-rest (cdr list-value))
  (defconst list-cons (cons 0 list-value))
  (defconst empty-list-rest (cdr nil))
  (defconst array-value (js-array 1 2 3))
  (defconst prepended-array (js-cons 0 array-value))
  (defconst object-value
    (js-object :name "host" :count 2))
  (defconst vector-first (nth 0 vector-value))
  (defconst vector-count (length vector-value))
  (defconst array-second (nth 1 array-value))
  (defconst array-count (length array-value))

  (defun nth-language (index collection) (nth index collection))
  (defun nth-language-values ()
    (let* ((shared (js-object :marker "nth"))
           (vector [undefined -0.0 shared])
           (array (js-array undefined -0.0 shared)))
      (js-array
        (nth 1 [10 20]) (nth 1 (js-array 10 20))
        (nth 0 "A😀B") (nth 1 "A😀B") (nth 2 "A😀B") (nth 3 "A😀B")
        (nth 99 vector) (nth 99 array) (nth 99 "A😀B")
        (nth -1 vector) (nth -1 array) (nth -1 "A😀B")
        (undefined? (nth 0 vector)) (undefined? (nth 0 array))
        (Object/is (nth 1 vector) -0.0) (Object/is (nth 1 array) -0.0)
        (eq (nth 2 vector) shared) (eq (nth 2 array) shared))))
  (defun nth-language-order (mode)
    (let ((trace "") (failure (js-object :marker "nth failure")) (collection (js-array 42)))
      (try
        (let ((result (nth
                (progn
                  (setq trace (str trace "i"))
                  (when (= mode 1) (throw false))
                  (when (= mode 3) (setq collection (js-array 99))) 0)
                (progn
                  (setq trace (str trace "c"))
                  (when (= mode 2) (throw failure)) collection))))
          (js-array trace false result))
        (catch error
          (js-array trace t (if (= mode 1) (eq error false) (eq error failure)))))))

  (export
    vector-value map-value map-literal set-value set-literal macro-set
    set-evaluation-order queue-value queue-literal queue-evaluation-order
    keyword-value keyword-map
    macro-keyword quoted-keyword quoted-data quoted-map quoted-set
    quoted-queue
    list-value list-first list-rest list-cons empty-list-rest
    array-value prepended-array object-value
    vector-first vector-count array-second array-count
    nth-language nth-language-values nth-language-order))
