(module fixture.literal-runtime
  (defmacro generated-keyword () :macro/value)
  (defmacro generated-set () '(hash-set :macro/value [9]))

  (defconst vector-value [1 2 [3 4]])
  (defconst map-value
    (hash-map
      "name" "Eliscript"
      ["value-key"] [5 6]))
  (defconst map-literal
    {"name" "source"
     ["value-key"] [7 8]
     "nested" {:ready t}
     "duplicate" 1
     "duplicate" 2})
  (defconst set-value
    (hash-set "explicit" [5 6] "explicit"))
  (defvar set-evaluation-order "")
  (defun record-set-value (label value)
    (setq set-evaluation-order (str set-evaluation-order label))
    value)
  (defconst set-literal
    #{(record-set-value "1" "source")
      (record-set-value "2" "source")
      [7 8]
      {:ready t}})
  (defconst macro-set (generated-set))
  (defconst keyword-value :article/title)
  (defconst keyword-map
    {:article/title "qualified"
     :ready t})
  (defconst macro-keyword (generated-keyword))
  (defconst quoted-keyword ':quoted/value)
  (defconst quoted-data '(alpha :beta [1 undefined] nil false))
  (defconst quoted-map '{:ready t})
  (defconst quoted-set '#{:ready [1 undefined]})
  (defconst array-value (js-array 1 2 3))
  (defconst object-value
    (js-object :name "host" :count 2))
  (defconst vector-first (nth 0 vector-value))
  (defconst vector-count (length vector-value))
  (defconst array-second (nth 1 array-value))
  (defconst array-count (length array-value))

  (export
    vector-value map-value map-literal set-value set-literal macro-set
    set-evaluation-order keyword-value keyword-map
    macro-keyword quoted-keyword quoted-data quoted-map quoted-set
    array-value object-value
    vector-first vector-count array-second array-count))
