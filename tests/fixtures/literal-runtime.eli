(module fixture.literal-runtime
  (defconst vector-value (vector 1 2 (vector 3 4)))
  (defconst map-value
    (hash-map
      "name" "Eliscript"
      (vector "value-key") (vector 5 6)))
  (defconst array-value (js-array 1 2 3))
  (defconst object-value
    (js-object :name "host" :count 2))

  (export vector-value map-value array-value object-value))
