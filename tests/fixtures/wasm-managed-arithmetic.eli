(module managed.arithmetic
  (defun add (a b) (+ a b))
  (defun subtract (a b) (- a b))
  (defun multiply (a b) (* a b))
  (defun divide (a b) (/ a b))
  (defun negate (a) (- a))
  (defun reciprocal (a) (/ a))
  (defun increment (a) (1+ a))
  (defun decrement (a) (1- a))
  (defun zero () (+))
  (defun one () (*))
  (defun unary-add (a) (+ a))
  (defun unary-multiply (a) (* a))
  (defun equal (a b) (= a b))
  (defun identical (a b) (eq a b))
  (defun distinct (a b) (/= a b))
  (defun not-equal (a b) (not= a b))
  (defun less (a b) (< a b))
  (defun less-equal (a b) (<= a b))
  (defun greater (a b) (> a b))
  (defun greater-equal (a b) (>= a b))
  (defun ordered-sum (a b c) (+ a b c))
  (defun ordered-product (a b c) (* a b c))
  (defun ordered-subtract (a b c) (- a b c))
  (defun ordered-divide (a b c) (/ a b c))
  (defun equal-three (a b c) (= a b c))
  (defun distinct-three (a b c) (/= a b c))
  (defun less-three (a b c) (< a b c))
  (defun snapshot (a b) (+ a (setq a b)))
  (defun compare-snapshot (a b c) (= a (setq a b) (setq a c)))
  (defun comparison-effects (a b) (let ((x 0)) (= a b (setq x 1)) x))
  (defun sum-to (n) (let ((i 0) (sum 0))
    (while (< i n) (setq sum (+ sum i)) (setq i (1+ i))) sum))
  (defun recursive-sum (n) (if (<= n 0) 0 (+ n (recursive-sum (1- n)))))
  (export add subtract multiply divide negate reciprocal increment decrement
    zero one unary-add unary-multiply equal identical distinct not-equal less less-equal
    greater greater-equal ordered-sum ordered-product ordered-subtract ordered-divide
    equal-three distinct-three less-three snapshot compare-snapshot comparison-effects sum-to recursive-sum))
