(module managed.js-cons
  (defconst raw-prefix (js* "(head, tail) => [head, ...tail]"))
  (defun prepend (head tail) (js-cons head tail))
  (defun safe (head tail) (try (JSON/stringify (js-cons head tail)) (catch error (get error :name))))
  (defun raw-nullish (tail) (try (JSON/stringify (raw-prefix 1 tail)) (catch error (get error :name))))
  (defun own (items key) (Object/hasOwn items key))
  (defun recover () 7)
  (defun effects (mode)
    (let ((trace (js-array)) (marker (js-object)))
      (let ((result (try (js-cons
          (progn (js-call trace :push "head") (if (= mode 0) (throw marker) t))
          (progn (js-call trace :push "tail") (if (= mode 1) (throw marker) (if (= mode 2) false nil))))
        (catch error (if (Object/is error marker) "marker" (get error :name))))))
        (JSON/stringify (js-array result trace)))))
  (defun protocol (mode)
    (let ((trace (js-array)) (marker (js-object)) (iterator nil) (source (js-object)) (n 0))
      (setq iterator (js-object :next (lambda ()
        (js-call trace :push (str "next" n))
        (when (or (= mode 1) (and (= mode 2) (= n 1))) (throw marker))
        (when (= mode 7) (put iterator :next false))
        (setq n (1+ n))
        (if (= mode 3) false (js-object :done (> n 1) :value n)))
        :return (lambda () (js-call trace :push "return") (js-object))))
      (put source (js* "Symbol.iterator") (if (= mode 5) false
        (lambda () (js-call trace :push "iterator") (if (= mode 4) false iterator))))
      (let ((out (try (js-cons (progn (js-call trace :push "head") t)
                    (progn (js-call trace :push "tail") (if (= mode 6) nil source)))
                  (catch error (if (Object/is error marker) "marker" (get error :name))))))
        (JSON/stringify (js-array out trace)))))
  (defun frozen-prototype ()
    (let ((tail (js-array false)))
      (put tail :length 2) (put (js* "Array.prototype") 1 9) (Object/freeze (js* "Array.prototype"))
      (let ((result (js-cons t tail)))
        (JSON/stringify (js-array result (Object/keys result) (Object/hasOwn result "1"))))))
  (defun nullish-protocol (mode)
    (let ((trace (js-array)))
      (put (js* "Array.prototype") (js* "Symbol.iterator")
        (lambda ()
          (js-call trace :push "iterator")
          (let ((n 0)) (js-object :next (lambda ()
            (js-call trace :push (str "next" n))
            (setq n (1+ n)) (js-object :done (> n 1) :value 7))))))
      (let ((Array false))
        (JSON/stringify (js-array (js-cons "head" (if (= mode 0) nil undefined)) trace)))))
  (defun trap-effects (trace)
    (try (js-cons (progn (js-call trace :push "head") t)
                  (progn (js-call trace :push "tail") (js-array 1)))
      (catch error "incorrectly-caught")))
  (export prepend safe raw-nullish own recover effects protocol frozen-prototype nullish-protocol trap-effects))
