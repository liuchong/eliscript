(module tests.fixtures.compiler-portable-errors-host
  (import "node:assert/strict" :default assert)
  (import "../helpers/compiler-error-contract.mjs" helpers original capture)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defasync run-host-main ()
    (let ((index 0))
    (while (< index (js-length helpers))
      (let* ((pair (aref helpers index)) (module (await (funcall load-module (get (new globalThis.URL (str (aref pair 0) ".mjs") (aref (get globalThis.process :argv) 2)) :href))))
             (fn (get module (js-call (aref pair 1) :replaceAll "-" "_"))))
        (js-call assert :equal (get fn :length) 1) (js-call assert :equal (Object/hasOwn fn "prototype") false)
        (js-call (js-array (js-array) (js-array undefined) (js-array nil) (js-array false) (js-array (js* "-0")) (js-array globalThis.NaN) (js-array "中😀")
          (js-array (funcall globalThis.Symbol "x")) (js-array (js* "1n")) (js-array "text" "ignored")) :forEach (lambda (args)
            (let ((actual (capture fn args)) (expected (capture original args)))
              (js-call assert :equal (Object/getPrototypeOf actual) (Object/getPrototypeOf expected))
              (js-call assert :deepEqual (Object/getOwnPropertyDescriptor actual "message") (Object/getOwnPropertyDescriptor expected "message")))))
        (let ((hint undefined) (value (js-object)))
          (put value (get globalThis.Symbol :toPrimitive) (lambda (value) (setq hint value) "converted"))
          (js-call assert :equal (get (capture fn (js-array value)) :message) "converted") (js-call assert :equal hint "string")))
      (setq index (1+ index)))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
