(module tests.fixtures.persistent-zipper-indexed-host
  (import "node:assert/strict" :default assert)
  (import "node:url" pathToFileURL)
  (import "../../runtime/core/vector.mjs" PersistentVector persistentVector)
  (import "../../runtime/core/collection-internals.mjs" COLLECTION_REDUCE)
  (import "../../runtime/core/list.mjs" persistentList)
  (import "../../runtime/core/metadata.mjs" meta withMeta)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defvar zipper undefined)
  (defvar original undefined)
  (defvar visits undefined)
  (defvar method-bridge undefined)
  (defasync run-host-main ()
    (setq zipper (await (funcall load-module (get (pathToFileURL (aref (get globalThis.process :argv) 2)) :href))))
    (setq original (get (get PersistentVector :prototype) COLLECTION_REDUCE))
    (setq visits 0)
    (setq method-bridge (js* "(implementation) => function(reducer, ...initial) { return implementation(this, reducer, initial); }"))
    (put (get PersistentVector :prototype) COLLECTION_REDUCE (funcall method-bridge (lambda (self reducer initial)
    (Reflect/apply original self (js-call (js-array (lambda (&rest arguments)
      (when (> (get self :count) 32) (setq visits (1+ visits)))
      (apply reducer (Array/from arguments)))) :concat initial)))))
    (try
    (let ((value nil) (index 0))
      (while (< index 512) (setq value (persistentVector value) index (1+ index)))
      (let ((location (js-call zipper :vector_zipper value)))
        (setq index 0) (while (< index 512) (setq location (js-call zipper :down location) index (1+ index)))
        (js-call assert :equal (js-call zipper :node location) nil) (js-call assert :equal (js-call zipper :root location) value)
        (let ((edited (js-call zipper :root (js-call zipper :replace location undefined))))
          (setq index 0) (while (< index 512) (setq edited (js-call edited :nth 0) index (1+ index)))
          (js-call assert :equal edited undefined))
        (js-call assert :equal visits 0 "one ancestor lookup must not scan wide parent vectors")))
    (let* ((source (persistentVector 7)) (base (js-call zipper :vector_zipper source)) (configuration (meta base))
           (listPath (persistentList (persistentVector) (persistentList) nil (persistentVector source) false)))
      (js-call (js-array undefined nil false 0) :forEach (lambda (child)
        (let ((loc (withMeta (persistentVector child listPath) configuration)))
          (js-call assert :equal (js-call zipper :node loc) child)
          (js-call assert :equal (js-call zipper :node (js-call zipper :up loc)) source))))
      (let ((malformed (withMeta (persistentVector undefined (persistentVector)) configuration)))
        (js-call assert :throws (lambda () (js-call zipper :up malformed)) (new globalThis.RegExp "invalid zipper internal slot"))))
    (finally (put (get PersistentVector :prototype) COLLECTION_REDUCE original))))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
