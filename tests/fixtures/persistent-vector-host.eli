(module tests.fixtures.persistent-vector-host
  (import "../../runtime/core/vector.mjs" EMPTY_VECTOR isPersistentVector subvec)
  (import "../../runtime/testing/vector.mjs" inspectPersistentVector persistentVectorMetrics resetPersistentVectorMetrics sharedPersistentVectorNodes)
  (defvar values EMPTY_VECTOR)
  (let ((value 0))
    (while (< value 100000) (setq values (js-call values :conj value) value (1+ value))))
  (defconst shape (inspectPersistentVector values))
  (resetPersistentVectorMetrics)
  (defconst updated (js-call values :assoc 54321 "updated"))
  (defconst metrics (persistentVectorMetrics))
  (defconst slice (subvec values 32767 32770))
  (defconst nestedSlice (subvec slice 1))
  (js-call globalThis.console :log (JSON/stringify (js-object
    :persistent (isPersistentVector values) :shape shape
    :probes (js-call (js-array 0 31 32 1024 32768 99999) :map (lambda (index) (js-call values :nth index)))
    :original (js-call values :nth 54321) :updated (js-call updated :nth 54321)
    :sharedNodes (sharedPersistentVectorNodes values updated) :metrics metrics
    :slice (js-call slice :toArray) :nestedSlice (js-call nestedSlice :toArray)
    :slicePersistent (isPersistentVector slice) :sliceSharedNodes (sharedPersistentVectorNodes values slice)
    :sum (js-call values :reduce (lambda (total value) (+ total value)) 0)))))
