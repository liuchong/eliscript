(module tests.fixtures.persistent-vector-host
  (import "node:assert/strict" :default assert)
  (import "../../runtime/core/vector.mjs" EMPTY_VECTOR PersistentVector isPersistentVector subvec)
  (import "../../runtime/testing/vector.mjs" inspectPersistentVector persistentVectorMetrics resetPersistentVectorMetrics sharedPersistentVectorNodes)
  (defvar values EMPTY_VECTOR)
  (let ((value 0))
    (while (< value 100000) (setq values (js-call values :conj value) value (1+ value))))
  (defconst shape (inspectPersistentVector values))
  (resetPersistentVectorMetrics)
  (defconst updated (js-call values :assoc 54321 "updated"))
  (defconst metrics (persistentVectorMetrics))
  (defconst slice (subvec values 32767 32770))
  (defconst nestedSlice (subvec slice 1))
  (defun verify-global-array-binding ()
    (let* ((host (js* "globalThis")) (ArrayConstructor (get host :Array))
           (descriptor (Object/getOwnPropertyDescriptor host "globalThis"))
           (namespace (Object/create host))
           (NamespaceArray (js* "(class NamespaceArray extends Array {})"))
           (factory (get PersistentVector :from))
           (input (Array/from (js-object :length 33) (lambda (_ index) index)))
           (input-slice (get input :slice)) (slices (js-array))
           (received nil) (copied nil) (converted nil))
      (put namespace :Array NamespaceArray)
      (put input :slice (lambda (&rest arguments)
        (js-call slices :push (Array/from arguments))
        (Reflect/apply input-slice input arguments)))
      (try
        (put host :globalThis namespace)
        (put PersistentVector :from (lambda (array)
          (setq received array)
          (Reflect/apply factory PersistentVector (js-array array))))
        (setq copied (js-call values :sliceVector 31 96))
        (put PersistentVector :from factory)
        (setq converted (js-call PersistentVector :from input))
        (finally
          (put PersistentVector :from factory)
          (Object/defineProperty host "globalThis" descriptor)))
      (js-call assert :strictEqual (Object/getPrototypeOf received) (get ArrayConstructor :prototype))
      (js-call assert :deepStrictEqual (Array/from copied)
        (Array/from (js-object :length 65) (lambda (_ index) (+ index 31))))
      (js-call assert :deepStrictEqual (Array/from converted) (Array/from input))
      (js-call assert :deepStrictEqual slices (js-array (js-array 0 32) (js-array 32 33)))))
  (verify-global-array-binding)
  (js-call globalThis.console :log (JSON/stringify (js-object
    :persistent (isPersistentVector values) :shape shape
    :probes (js-call (js-array 0 31 32 1024 32768 99999) :map (lambda (index) (js-call values :nth index)))
    :original (js-call values :nth 54321) :updated (js-call updated :nth 54321)
    :sharedNodes (sharedPersistentVectorNodes values updated) :metrics metrics
    :slice (js-call slice :toArray) :nestedSlice (js-call nestedSlice :toArray)
    :slicePersistent (isPersistentVector slice) :sliceSharedNodes (sharedPersistentVectorNodes values slice)
    :sum (js-call values :reduce (lambda (total value) (+ total value)) 0)))))
