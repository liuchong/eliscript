(module tests.fixtures.source-debugging-host
  (import "node:fs/promises" readFile realpath)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "../../platform/browser.mjs" browserEventBoundary)
  (import "../../runtime/source-mapping.mjs" sourceMapDescriptor)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst moduleFile (get (get globalThis.process :env) :ELISCRIPT_DEBUG_MODULE))
  (defconst sourceMapFile (get (get globalThis.process :env) :ELISCRIPT_DEBUG_SOURCE_MAP))
  (unless (js* "!!moduleFile && !!sourceMapFile") (throw (new globalThis.Error "ELISCRIPT_DEBUG_MODULE and ELISCRIPT_DEBUG_SOURCE_MAP are required")))
  (defvar moduleUrl undefined)
  (defvar sourceMapUrl undefined)
  (defvar rawMap undefined)
  (defvar sourceMap undefined)
  (defvar generated undefined)
  (defvar failures undefined)
  (defvar target undefined)
  (defun record (kind) (lambda (failure) (js-call failures :push (js-object :kind kind :failure failure))))
  (defasync run-host-main ()
    (setq moduleUrl (pathToFileURL (await (realpath moduleFile))))
    (setq sourceMapUrl (pathToFileURL sourceMapFile))
    (setq rawMap (JSON/parse (await (readFile sourceMapFile "utf8"))))
    (setq sourceMap (sourceMapDescriptor (js-object :generatedFile (get moduleUrl :href)
    :sources (js-call (get rawMap :sources) :map (lambda (source) (let ((url (new globalThis.URL source sourceMapUrl)))
      (if (= (get url :protocol) "file:") (resolve (fileURLToPath url)) (get url :href))))) :mappings (get rawMap :mappings))))
    (setq generated (await (funcall load-module (str (get moduleUrl :href) "?source-debugging"))))
    (setq failures (js-array))
    (setq target (new globalThis.EventTarget))
    (js-call target :addEventListener "sync" (browserEventBoundary (get generated :event_failure) (record "browser-event") (js-array sourceMap)))
    (js-call target :addEventListener "async" (browserEventBoundary (get generated :async_failure) (record "async-rejection") (js-array sourceMap)))
    (js-call target :dispatchEvent (new globalThis.Event "sync"))
    (js-call target :dispatchEvent (new globalThis.Event "async"))
    (await (new globalThis.Promise (lambda (resolve_) (globalThis/setTimeout resolve_ 0))))
    (unless (= (js-length failures) 2) (throw (new globalThis.Error (str "expected two mapped failures, received " (js-length failures)))))
    (js-call (get globalThis.process :stdout) :write (str (JSON/stringify failures) "\n")))
  (defconst completion (run-host-main))
  (js-call completion :catch (lambda (error)
    (console/error error)
    (put globalThis.process :exitCode 1)))
  (defun then (fulfill reject)
    (js-call completion :then (lambda (ignored) (funcall fulfill undefined)) reject))
  (export then))
