(module tests.fixtures.persistent-queue-host
  (import "../../runtime/core/identifier.mjs" keyword)
  (import "../../runtime/core/map.mjs" persistentHashMap)
  (import "../../runtime/core/metadata.mjs" meta withMeta)
  (import "../../runtime/core/queue.mjs" persistentQueue)
  (import "../../runtime/core/value.mjs" equalValues hashValue)
  (defvar values (persistentQueue 1 (keyword "two") 3))
  (setq values (js-call (js-call values :conj 4) :pop))
  (defconst annotated (withMeta values (persistentHashMap (js-array "source" "host"))))
  (js-call globalThis.console :log (JSON/stringify (js-object
    :values (js-call (js-call values :toArray) :map globalThis.String)
    :count (get values :count) :front (funcall globalThis.String (js-call values :peek))
    :hash (hashValue values) :equal (equalValues values (persistentQueue (keyword "two") 3 4))
    :source (js-call (meta annotated) :get "source")))))
