(module
  tests.dogfood-accessibility.test
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" cp mkdtemp readFile readdir rm writeFile)
  (import "node:path" join resolve)
  (defconst
    ROOT
    (resolve (get (js* "import.meta") :dir) ".."))
  (defconst
    COMPILER
    (resolve ROOT "bin/eliscript-build"))
  (defconst
    DEMO
    (resolve ROOT "examples/dogfood/_demo"))
  (defconst
    state
    (js-object :staging nil :program nil :bundle nil :output nil :css nil :page nil :article nil))
  (defasync
    run
    (command)
    (let*
      ((child (js-call globalThis.Bun :spawn command (js-object :cwd ROOT :stdout "pipe" :stderr "pipe"))) (results (await (js-call globalThis.Promise :all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref results 0) :stdout (aref results 1) :stderr (aref results 2))))
  (defasync
    walk-html
    (directory pages)
    (let*
      ((entries (await (readdir directory (js-object :withFileTypes t)))) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((entry (aref entries (get idx :i))) (path (join directory (get entry :name))))
          (if
            (js-call entry :isDirectory)
            (await (walk-html path pages))
            (when
              (js-call (get entry :name) :endsWith ".html")
              (js-call pages :push path))))
        (put idx :i (+ (get idx :i) 1)))))
  (defasync
    walk-posts
    (directory posts)
    (let*
      ((entries (await (readdir directory (js-object :withFileTypes t)))) (idx (js-object :i 0)))
      (while
        (< (get idx :i) (get entries :length))
        (let*
          ((entry (aref entries (get idx :i))) (path (join directory (get entry :name))))
          (if
            (js-call entry :isDirectory)
            (await (walk-posts path posts))
            (when
              (and (= (get entry :name) "index.html") (js-call path :includes "/posts/"))
              (js-call posts :push path))))
        (put idx :i (+ (get idx :i) 1)))))
  (beforeAll (async () (let*
        ((staging (await (mkdtemp (resolve ROOT ".eliscript-dogfood-a11y-")))) (__ign_1 (put state :staging staging)) (built (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (join staging "build") "examples/dogfood/src/builder/main.eli")))))
        (when
          (not= (get built :exitCode) 0)
          (throw (new globalThis.Error (or (js-call (get built :stderr) :trim) (js-call (get built :stdout) :trim)))))
        (let*
          ((program (join staging "build/src/builder/main.mjs")) (__ign_2 (put state :program program)) (browser (await (run (js-array COMPILER "--no-cache" "--root" "examples/dogfood" "--out-dir" (join staging "browser-source") "examples/dogfood/src/renderer/browser.eli")))))
          (when
            (not= (get browser :exitCode) 0)
            (throw (new globalThis.Error (or (js-call (get browser :stderr) :trim) (js-call (get browser :stdout) :trim)))))
          (let*
            ((bundle (join staging "browser.js")) (__ign_3 (put state :bundle bundle)) (bundled (await (run (js-array "bun" "build" (join staging "browser-source/src/renderer/browser.mjs") "--target=browser" "--format=iife" "--outfile" bundle)))))
            (when
              (not= (get bundled :exitCode) 0)
              (throw (new globalThis.Error (or (js-call (get bundled :stderr) :trim) (js-call (get bundled :stdout) :trim)))))
            (let*
              ((project (join staging "project")) (__ign_4 (await (cp DEMO project (js-object :recursive t)))) (configPath (join project "dogfood.config.eli")) (config (await (readFile configPath "utf8"))) (__ign_5 (await (writeFile configPath (js-call config :replace ":channels []" ":channels [{:id :giscus :kind :giscus :enabled t :mode :embed}]") "utf8"))) (output (join project "site")) (__ign_6 (put state :output output)) (site (await (run (js-array (get globalThis.process :execPath) program "--root" project "--output" "site" "--browser-bundle" bundle)))))
              (when
                (not= (get site :exitCode) 0)
                (throw (new globalThis.Error (or (js-call (get site :stderr) :trim) (js-call (get site :stdout) :trim)))))
              (put state :css (await (readFile (join output "assets/site.css") "utf8")))
              (put state :page (await (readFile (join output "index.html") "utf8")))
              (put state :article (await (readFile (join output "posts/welcome/index.html") "utf8")))))))))
  (afterAll (async () (when
        (get state :staging)
        (await (rm (get state :staging) (js-object :recursive t :force t))))))
  (test "every page carries the document contract" (async () (let*
        ((pages (js-array)) (__ign_7 (await (walk-html (get state :output) pages))) (idx (js-object :i 0)))
        (js-call (expect (get pages :length)) :toBeGreaterThan 5)
        (while
          (< (get idx :i) (get pages :length))
          (let*
            ((path (aref pages (get idx :i))) (source (await (readFile path "utf8"))))
            (js-call (expect source) :toContain "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
            (js-call (expect source) :toContain "<a class=\"skip\" href=\"#main\">")
            (js-call (expect source) :toContain "<header")
            (js-call (expect source) :toContain "<main id=\"main\">")
            (js-call (expect source) :toContain "<footer>")
            (js-call (expect source) :toContain "<nav aria-label=\"site\">")
            (js-call (expect (js-call source :match (new globalThis.RegExp "<h1[ >]" "gu"))) :toHaveLength 1))
          (put idx :i (+ (get idx :i) 1))))))
  (test "narrow screens get the navigation as a disclosure, wide ones inline" (lambda () (let*
        ((page (get state :page)) (css (get state :css)) (header (js-call page :slice (js-call page :indexOf "<header") (js-call page :indexOf "</header>"))))
        (js-call (expect page) :toContain "<details class=\"menu\" open><summary>Menu</summary><nav aria-label=\"site\">")
        (js-call (expect (js-call header :indexOf "wordmark")) :toBeLessThan (js-call header :indexOf "<details"))
        (js-call (expect css) :toContain "@media (min-width:601px){.menu{display:contents}.menu>summary{display:none}")
        (js-call (expect css) :toContain "@media (max-width:600px)")
        (js-call (expect css) :toContain ".menu>summary{display:block")
        (js-call (expect css) :toContain "html[data-menu=collapsed] .menu>nav{display:none}"))))
  (test "the bundle decides the menu state before the header is parsed" (async () (let*
        ((bundle (await (readFile (join (get state :staging) "browser.js") "utf8"))))
        (js-call (expect bundle) :toContain "data-menu")
        (js-call (expect bundle) :toContain "collapsed")
        (js-call (expect bundle) :toContain "mark_menu_state")
        (js-call (expect bundle) :toContain "bind_menu"))))
  (test "keyboard focus is visible and motion can be reduced" (lambda () (let*
        ((css (get state :css)))
        (js-call (expect css) :toContain ":focus-visible{outline:2px solid var(--accent);outline-offset:2px")
        (js-call (expect css) :toContain "@media (prefers-reduced-motion:reduce)")
        (js-call (expect css) :toContain "transition-duration:0.01ms !important"))))
  (test "long labels and source names cannot overflow their containers" (lambda () (let*
        ((css (get state :css)))
        (js-call (expect css) :toContain "overflow-wrap:anywhere")
        (js-call (expect css) :toContain ".masthead>*{min-width:0}"))))
  (test "article measure is constrained independently of the viewport" (lambda () (let*
        ((css (get state :css)))
        (js-call (expect css) :toContain ".article{max-width:44rem}")
        (js-call (get (expect css) :not) :toContain ".article{max-width:100%"))))
  (test "the theme control carries a name and a tooltip" (lambda () (let*
        ((page (get state :page)))
        (js-call (expect page) :toContain "title=\"Switch the colour theme\"")
        (js-call (expect page) :toContain "type=\"button\""))))
  (test "an external channel mounts in one isolated region with a fallback" (lambda () (let*
        ((article (get state :article)) (css (get state :css)))
        (js-call (expect article) :toContain "class=\"embed-region\"")
        (js-call (expect article) :toContain "data-comment-mount=\"giscus\"")
        (js-call (expect css) :toContain ".embed-region{min-height:180px")
        (js-call (expect css) :toContain "contain:layout style")
        (js-call (expect article) :toContain "The browser loads that provider")
        (js-call (expect article) :toContain "this build does not"))))
  (test "a declared channel reaches every published article once" (async () (let*
        ((posts (js-array)) (__ign_8 (await (walk-posts (get state :output) posts))) (idx (js-object :i 0)))
        (js-call (expect (get posts :length)) :toBeGreaterThan 1)
        (while
          (< (get idx :i) (get posts :length))
          (let*
            ((path (aref posts (get idx :i))) (source (await (readFile path "utf8"))))
            (js-call (expect (- (get (js-call source :split "data-comment-mount=\"giscus\"") :length) 1)) :toBe 1))
          (put idx :i (+ (get idx :i) 1)))))))
