(module tests.bootstrap-emitter
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run caseSource buildBootstrap seedResults loadModule)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst fixturePath (resolve projectDirectory "tests/fixtures/bootstrap-ir.json"))
  (test "bootstrapped emitter matches seed ESM and Source Map output" (async ()
    (let ((directory (await (mkdtemp (resolve projectDirectory ".eliscript-emitter-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((modules (await (Promise/all (js-call (js-array "reader" "expander" "analyzer" "ir" "lower" "emitter" "source-map") :map (lambda (name) (loadModule directory name "test"))))))
               (reader (aref modules 0)) (expander (aref modules 1)) (analyzer (aref modules 2)) (ir (aref modules 3)) (lower (aref modules 4)) (emitter (aref modules 5)) (sourceMap (aref modules 6))
               (fixture (JSON/parse (await (readFile fixturePath "utf8")))) (generated (js-array)) (index 0))
          (while (< index (get (get fixture :valid) :length))
            (let* ((testCase (aref (get fixture :valid) index)) (source (await (caseSource testCase)))
                   (forms (js-call expander :expand_module (js-call reader :read_string source (get testCase :filename)) (get testCase :filename))))
              (js-call analyzer :analyze_module forms (get testCase :filename))
              (let* ((program (js-call lower :lower_module forms (get testCase :filename)))
                     (emission (js-call emitter :emit_module_with_source_map program source "fixture.mjs" (get testCase :filename))))
                (js-call generated :push (js-object :name (get testCase :name) :status "ok" :javascript (get emission :javascript) :sourceMap (JSON/parse (get emission :sourceMap))))))
            (setq index (1+ index)))
          (js-call (expect generated) :toEqual (await (seedResults "emitter" fixturePath)))
          (let ((invalidImport (js-call ir :make_node "import-declaration" nil "invalid" (js-array
                  (js-call ir :make_node "import-namespace" nil "Namespace" (js-array) nil)
                  (js-call ir :make_node "import-named" nil "named" (js-array) nil)) nil)))
            (js-call (expect (lambda () (js-call emitter :emit_module (js-call ir :make_program "invalid-import.eli" (js-array invalidImport))))) :toThrow "namespace and named imports cannot be combined"))
          (let ((rawWithTwoArguments (js-call ir :make_node "raw-javascript" nil "js*" (js-array
                  (js-call ir :make_node "literal" nil "\"a\"" (js-array) "a") (js-call ir :make_node "literal" nil "\"b\"" (js-array) "b")) nil))
                (rawWithSymbol (js-call ir :make_node "raw-javascript" nil "js*" (js-array (js-call ir :make_node "reference" nil "fragment" (js-array) nil)) nil)))
            (js-call (expect (lambda () (js-call emitter :emit_module (js-call ir :make_program "raw.js" (js-array (js-call ir :make_node "expression-statement" nil "statement" (js-array rawWithTwoArguments) nil)))))) :toThrow "js* expects 1 argument, got 2")
            (js-call (expect (lambda () (js-call emitter :emit_module (js-call ir :make_program "raw.js" (js-array (js-call ir :make_node "expression-statement" nil "statement" (js-array rawWithSymbol) nil)))))) :toThrow "js* expects a string literal"))
          (js-call (expect (js-array (js-call sourceMap :encode_vlq 0) (js-call sourceMap :encode_vlq 1) (js-call sourceMap :encode_vlq -1) (js-call sourceMap :encode_vlq 16) (js-call sourceMap :encode_vlq -16))) :toEqual (js-array "A" "C" "D" "gB" "hB"))
          (let* ((basic (js-call generated :find (lambda (result) (= (get result :name) "executable-basic-module")))) (executablePath (resolve directory "executable-basic.mjs")))
            (await (writeFile executablePath (get basic :javascript)))
            (let* ((runtimeOutput (await (run (js-array (get globalThis.process :execPath) (resolve projectDirectory "tests/fixtures/bootstrap-emitter-host.mjs"))
                    (js-object :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_TEST_MODULE (get (pathToFileURL executablePath) :href)))))))
                   (runtime (JSON/parse (js-call (js-call (js-call runtimeOutput :trim) :split "\n") :at -1))))
              (js-call (expect runtime) :toEqual (js-object :factorial 120 :sum 15 :message "hello from Eliscript"))))
          (js-call (expect (await (readFile (resolve directory "emitter.mjs.map") "utf8"))) :toContain "bootstrap/compiler/emitter.eli"))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
