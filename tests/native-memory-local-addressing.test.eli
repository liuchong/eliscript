(module tests.native-memory-local-addressing.test
  (import "node:process" :default process)
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/native-memory.mjs" openNativeMemory)
  (defconst target (if (= (get process :arch) "arm64") (if (= (get process :platform) "darwin") "arm64-macos" (if (= (get process :platform) "linux") "arm64-linux" undefined)) undefined))
  (defconst slots (js-array 3 31 32 510 511))
  (defconst words (js-array 0 1 65535 65536 2147483647 2147483648 4275878552 4294967295))
  (defconst signedWords (js-array -1 -2147483648 2147483647))
  (defconst payloads (js-array (js* "0n") (js* "0x8000000000000000n") (js* "0x7ff8000012345678n") (js* "0x7ff0000012345678n") (js* "0xfff0000000000000n") (js* "1n")))
  (defconst span (js-object :filename "local-addressing.eli" :start 0 :end 1 :line 1 :column 1))
  (defconst hostTypeof (js* "(value) => typeof value"))
  (defvar directory undefined) (defvar backend undefined)
  (defun node (kind type value &rest __host_default_arguments_1)
    (let* ((children (aref __host_default_arguments_1 0))) (js-object :kind kind :type type :value value :children (if (= children undefined) (js-array) children) :span span)))
  (defun literal (value) (node "literal" "u32" value))
  (defun local (index &rest __host_default_arguments_2)
    (let* ((type (aref __host_default_arguments_2 0))) (node "local" (if (= type undefined) "u32" type) index)))
  (defun set (index type value) (node "set" type index (js-array value)))
  (defun operation (name &rest children) (node "memory-op" (if (= name "load-f64") "f64" "u32") name children))
  (defun add (left right) (node "word-arithmetic" "u32" "+" (js-array left right)))
  (defun address (parameter offset) (add (local parameter) (literal offset)))
  (defun sequence (children) (node "sequence" "u32" nil children))
  (defun each (items callback) (js-call items :forEach callback))
  (defun f64values () (js-array (js* "-0") globalThis.NaN globalThis.Infinity (- globalThis.Infinity) (get globalThis.Number :MIN_VALUE)))
  (beforeAll (async () (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-locals-")))) (setq backend (await (buildBackends (js-object :outputRoot directory))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (test "native word SHA256 hashes exact little-endian words without copying or changing input" (lambda ()
    (each (js-array 0 1 13 14 15 16 17 31 32 33 4096) (lambda (length)
      (let* ((input (Object/freeze (Array/from (js-object :length length) (lambda (_ i) (uint32 (bit-xor (aref words (% i (get words :length))) (Math/imul i 2654435769)))))))
             (saved (Array/from input)) (bytes (Buffer/alloc (* length 4))) (reads (js-array)))
        (each (Array/from (js-call input :entries)) (lambda (entry) (js-call bytes :writeUInt32LE (aref entry 1) (* (aref entry 0) 4))))
        (let* ((observed (new globalThis.Proxy input (js-object :get (lambda (target key receiver)
                 (when (or (= key "slice") (= key "map") (= key "flatMap")) (throw (new globalThis.Error "word hashing must not make a whole-input copy")))
                 (when (and (= (funcall hostTypeof key) "string") (js-call (new globalThis.RegExp "^(0|[1-9][0-9]*)$") :test key)) (js-call reads :push (funcall globalThis.Number key)))
                 (Reflect/get target key receiver)))))
               (expected (new globalThis.Uint8Array (js-call (js-call (createHash "sha256") :update bytes) :digest))))
          (js-call assert :deepEqual (Uint8Array/from (js-call (get backend :sha256) :sha256_words_le observed)) expected (str "word count " length))
          (js-call assert :deepEqual reads (Array/from (js-object :length length) (lambda (_ i) i)) "each original word is observed once in order")
          (js-call assert :deepEqual input saved)
          (let* ((originalBytes (Array/from bytes)) (byteSnapshot (Array/from originalBytes)))
            (js-call assert :deepEqual (Uint8Array/from (js-call (get backend :sha256) :sha256_bytes originalBytes)) expected)
            (js-call assert :deepEqual originalBytes byteSnapshot "existing byte hashing still owns its slice snapshot"))))))))
  (defun program ()
    (let ((functions (js-call (js-array "u32" "i32" "f64") :map (lambda (type index)
      (let* ((width (if (= type "f64") 8 4))
             (locals (Array/from (js-object :length 512) (lambda (_ slot) (js-object :name (str "slot" slot) :index slot :type (if (js-call slots :includes slot) type "u32")))))
             (call (lambda (indirect) (node (if indirect "call-indirect" "call") "u32" (if indirect 9 3)
               (js-call (js-array (local 0) (local 1)) :concat
                 (js-call (js-array 4294967295 2147483648 65536 65535 7 8 9) :map literal) (if indirect (js-array (literal 0)) (js-array))))))
             (body (js-call (js-call slots :map (lambda (slot i) (set slot type (operation (if (= type "f64") "load-f64" "load-u32") (address 0 (* i width))))))
               :concat (js-array (funcall call false) (operation (if (= type "f64") "store-f64" "store-u32") (local 1) (local 3 type))
                 (set 3 type (local 31 type)) (set 31 type (local 511 type)) (set 511 type (local 32 type)) (set 32 type (local 510 type)) (set 510 type (local 3 type)) (funcall call t))
               (js-call slots :map (lambda (slot i) (operation (if (= type "f64") "store-f64" "store-u32") (address 1 (* (1+ i) width)) (local slot type))))
               (js-array (add (operation "load-u32" (literal 64)) (operation "load-u32" (literal 64)))))))
        (js-object :name (str "transfer_" type) :index index :arity 2 :locals locals :span span :body (sequence body)))))))
      (let ((locals (Array/from (js-object :length 512) (lambda (_ index) (js-object :name (str "scratch" index) :index index :type "u32")))))
        (js-call functions :push (js-object :name "clobber" :index 3 :arity 9 :locals locals :span span :body (sequence
          (js-call (js-call slots :map (lambda (slot i) (set slot "u32" (literal (aref words (+ i 3)))))) :concat
            (js-array (operation "store-u32" (literal 64) (add (operation "load-u32" (literal 64)) (literal 1))) (add (local 7) (local 8))))))))
      (let ((constants (js-call (js-call words :map (lambda (value i) (operation "store-u32" (address 0 (* i 4)) (literal value)))) :concat
        (js-call (js-array 0 1) :flatMap (lambda (value i) (js-array (set 1 "i32" (node "literal" "i32" value)) (operation "store-u32" (address 0 (* (+ (get words :length) i) 4)) (local 1 "i32")))))
        (js-call (f64values) :map (lambda (value i) (operation "store-f64" (address 0 (+ 48 (* i 8))) (node "literal" "f64" value))))
        (js-call (js-array "literal" "int-literal") :flatMap (lambda (kind row) (js-call signedWords :flatMap (lambda (value i)
          (js-array (set 1 "i32" (node kind "i32" value)) (operation "store-u32" (address 0 (+ 88 (* row 12) (* i 4))) (local 1 "i32")))))))
        (js-array (literal 0)))))
        (js-call functions :push (js-object :name "constants" :index 4 :arity 1 :locals (js-array (js-object :name "out" :index 0 :type "u32") (js-object :name "boolean" :index 1 :type "i32")) :span span :body (sequence constants))))
      (let ((trace (lambda (digit) (node "call" "u32" 6 (js-array (literal digit))))))
        (js-call functions :push (js-object :name "effects" :index 5 :arity 2 :locals (js-array (js-object :name "address" :index 0 :type "u32")
          (js-object :name "branch" :index 1 :type "u32") (js-object :name "counter" :index 2 :type "u32")) :span span :body (sequence (js-array
            (operation "store-u32" (literal 4096) (literal 0)) (set 2 "u32" (literal 0))
            (node "if" "u32" nil (js-array (node "word-compare" "i32" "/=" (js-array (local 1) (literal 0)))
              (sequence (js-array (funcall trace 1) (literal 4294967295))) (sequence (js-array (funcall trace 2) (literal 2147483648)))))
            (add (funcall trace 3) (funcall trace 4)) (operation "load-u32" (local 0))
            (node "while" "u32" nil (js-array (node "word-compare" "i32" "<" (js-array (local 2) (literal 3)))
              (sequence (js-array (set 2 "u32" (add (local 2) (literal 1))) (funcall trace 6) (add (literal 4294967295) (literal 2))))))
            (funcall trace 7) (local 2))))))
      (js-call functions :push (js-object :name "record_trace" :index 6 :arity 1 :locals (js-array (js-object :name "digit" :index 0 :type "u32")) :span span :body (sequence (js-array
        (operation "store-u32" (literal 4096) (add (node "word-arithmetic" "u32" "*" (js-array (operation "load-u32" (literal 4096)) (literal 10))) (local 0))) (local 0)))))
      (js-object :abi "memory-u32" :filename (get span :filename) :exports (js-call functions :map (lambda (f) (get f :name))) :table (js-array 3) :indirectArities (js-array 9) :functions functions)))
  (funcall (js-call test :skipIf (not target)) "native FP-slot boundaries preserve words, IEEE payloads and caller values against real WASM" (async ()
    (let* ((typed (program)) (saved (funcall globalThis.structuredClone typed)) (options (js-object :initialPages 1 :maximumPages 1))
           (wasmBytes (js-call (get backend :wasm) :emit_typed_memory_wasm typed options)) (wasmModule (new WebAssembly.Module (Uint8Array/from wasmBytes))))
      (js-call assert :deepEqual (WebAssembly.Module/imports wasmModule) (js-array))
      (let ((w (get (new WebAssembly.Instance wasmModule) :exports)))
        (each (js-array "arm64-macos" "arm64-linux") (lambda (platform)
          (let ((first (js-call (get backend :native) :emit_typed_native_memory_artifact typed platform (js-object :format "object"))))
            (js-call assert :deepEqual (get first :bytes) (get (js-call (get backend :native) :emit_typed_native_memory_artifact typed platform (js-object :format "object")) :bytes))
            (js-call assert :deepEqual typed saved))))
        (let* ((emission (js-call (get backend :native) :emit_typed_native_memory_artifact typed target))
               (path (resolve directory (str "locals." (if (= target "arm64-linux") "so" "dylib")))))
          (await (writeFile path (Uint8Array/from (get emission :bytes))))
          (let* ((signatures (Object/fromEntries (js-call (get typed :functions) :map (lambda (f) (js-array (get f :name) (get f :arity))))))
                 (n (await (openNativeMemory path signatures (Object/assign (js-object) options (js-object :nativeTarget target :debug (get emission :debug) :trapSites (get (get emission :debug) :trapSites))))))
                 (runtimes (js-array
                   (js-object :invoke (lambda (name &rest args) (Reflect/apply (get n :invoke) n (js-call (js-array name) :concat args)))
                     :write (lambda (bytes at) (js-call n :write bytes at)) :read (lambda (at length) (js-call n :read at length)))
                   (js-object :invoke (lambda (name &rest args) (uint32 (Reflect/apply (get w name) w args)))
                     :write (lambda (bytes at) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :set bytes at))
                     :read (lambda (at length) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice at (+ at length)))))))
            (try
              (each (js-array "u32" "i32" "f64") (lambda (type)
                (let* ((width (if (= type "f64") 8 4)) (source (new globalThis.Uint8Array (* 5 width))) (view (new globalThis.DataView (get source :buffer))) (i 0)
                       (expected (new globalThis.Uint8Array (* 6 width))))
                  (while (< i 5) (if (= type "f64") (js-call view :setBigUint64 (* i width) (aref payloads (1+ i)) t) (js-call view :setUint32 (* i width) (aref words (+ i 3)) t)) (setq i (1+ i)))
                  (each (Array/from (js-call (js-array 0 1 4 3 1 2) :entries)) (lambda (entry)
                    (let ((i (aref entry 0)) (from (aref entry 1))) (js-call expected :set (js-call source :subarray (* from width) (* (1+ from) width)) (* i width)))))
                  (each (js-array (js-array 128 512) (js-array 128 (+ 128 width)) (js-array (- 65536 (get source :length)) (- 65536 (get expected :length)))) (lambda (entry)
                    (let ((from (aref entry 0)) (to (aref entry 1)))
                      (each runtimes (lambda (runtime)
                        (js-call runtime :write (js-call (new globalThis.Uint8Array 65536) :fill 165) 0)
                        (js-call runtime :write (new globalThis.Uint8Array 4) 64) (js-call runtime :write source from)
                        (let ((unrelated (js-call runtime :read 4096 32)))
                          (js-call assert :equal (js-call runtime :invoke (str "transfer_" type) from to) 4 (str type "/call count"))
                          (js-call assert :deepEqual (js-call runtime :read to (get expected :length)) expected (str type "/exact local payloads"))
                          (js-call assert :deepEqual (js-call runtime :read 4096 32) unrelated (str type "/unrelated heap survives calls"))
                          (js-call assert :equal (js-call (new globalThis.DataView (get (js-call runtime :read 64 4) :buffer)) :getUint32 0 t) 2))))
                      (js-call assert :deepEqual (js-call n :read to (get expected :length)) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice to (+ to (get expected :length)))))))
                  (each runtimes (lambda (runtime)
                    (js-call runtime :write (new globalThis.Uint8Array 4) 64)
                    (let ((before (js-call runtime :read 4096 32)))
                      (js-call assert :throws (lambda () (js-call runtime :invoke (str "transfer_" type) (1+ (- 65536 (get source :length))) 512)) WebAssembly.RuntimeError)
                      (js-call assert :equal (js-call (new globalThis.DataView (get (js-call runtime :read 64 4) :buffer)) :getUint32 0 t) 0 "invalid source traps before calls")
                      (js-call assert :deepEqual (js-call runtime :read 4096 32) before)
                      (js-call runtime :write source 128)
                      (js-call assert :throws (lambda () (js-call runtime :invoke (str "transfer_" type) 128 (1+ (- 65536 (get expected :length))))) WebAssembly.RuntimeError)
                      (js-call assert :equal (js-call (new globalThis.DataView (get (js-call runtime :read 64 4) :buffer)) :getUint32 0 t) 2 "invalid final store preserves both prior calls")
                      (js-call assert :deepEqual (js-call runtime :read 4096 32) before)
                      (js-call runtime :write (new globalThis.Uint8Array 4) 64)
                      (js-call assert :equal (js-call runtime :invoke (str "transfer_" type) 128 512) 4 "same instance recovers after trap")
                      (js-call assert :deepEqual (js-call runtime :read 512 (get expected :length)) expected)))))))
              (each runtimes (lambda (runtime)
                (js-call assert :equal (js-call runtime :invoke "constants" 1024) 0)
                (let ((view (new globalThis.DataView (get (js-call runtime :read 1024 112) :buffer))))
                  (each (Array/from (js-call (js-call words :concat (js-array 0 1)) :entries)) (lambda (entry) (js-call assert :equal (js-call view :getUint32 (* (aref entry 0) 4) t) (aref entry 1))))
                  (each (Array/from (js-call (f64values) :entries)) (lambda (entry) (assert (Object/is (js-call view :getFloat64 (+ 48 (* (aref entry 0) 8)) t) (aref entry 1)) (str "literal " (aref entry 0)))))
                  (each (js-array 88 100) (lambda (offset) (each (Array/from (js-call signedWords :entries)) (lambda (entry)
                    (let ((i (aref entry 0)) (value (aref entry 1)))
                      (js-call assert :equal (js-call view :getInt32 (+ offset (* i 4)) t) value (str "signed literal " value))
                      (js-call assert :equal (js-call view :getUint32 (+ offset (* i 4)) t) (aref (js-array 4294967295 2147483648 2147483647) i)))))))
                  (each (js-array 1112 1124) (lambda (offset) (js-call assert :deepEqual (js-call runtime :read offset 12) (Uint8Array/of 255 255 255 255 0 0 0 128 255 255 255 127)))))))
              (js-call assert :deepEqual (js-call n :read 1024 112) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice 1024 1136))
              (each runtimes (lambda (runtime)
                (let ((traceValue (lambda () (js-call (new globalThis.DataView (get (js-call runtime :read 4096 4) :buffer)) :getUint32 0 t))))
                  (each (js-array 0 1) (lambda (branch)
                    (let ((firstDigit (if (= branch 0) 2 1)))
                      (js-call assert :equal (js-call runtime :invoke "effects" 0 branch) 3 "discarded loop still updates its local")
                      (js-call assert :equal (funcall traceValue) (+ (* firstDigit 1000000) 346667) "discarded branch, both operands and each loop call retain source order")
                      (js-call assert :throws (lambda () (js-call runtime :invoke "effects" 65535 branch)) WebAssembly.RuntimeError "discarded load still checks bounds")
                      (js-call assert :equal (funcall traceValue) (+ (* firstDigit 100) 34) "trap prevents every following write")
                      (js-call assert :equal (js-call runtime :invoke "effects" 0 branch) 3 "same instance recovers after discarded-load trap")
                      (js-call assert :equal (funcall traceValue) (+ (* firstDigit 1000000) 346667))))))))
              (js-call assert :deepEqual (js-call n :read 4096 4) (js-call (new globalThis.Uint8Array (get (get w :memory) :buffer)) :slice 4096 4100))
              (js-call assert :deepEqual typed saved)
              (finally (js-call n :close)))))))))
)
