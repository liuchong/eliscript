(module tests.wasm-managed-math.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile writeFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "node:buffer" Buffer)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "./helpers/wasm-managed-math-node.mjs"
          read-val value invoke-val exact finish
          fround-boundaries fround-random
          check-host-sum-oracle check-namespace check-mutations check-unary check-imul
          check-conversions check-fround check-f16 check-sum-precise check-pressure check-freeze
          check-math-composite check-sqrt-access check-sqrt-semantics check-sqrt-pressure)

  (defconst dynamic-import (js* "(specifier) => import(specifier)"))
  (defconst math-node-helper-path
    (fileURLToPath (new globalThis.URL "./helpers/wasm-managed-math-node.mjs" (get (js* "import.meta") :url))))
  (defconst runtime-import-pattern
    (new globalThis.RegExp "^eliscript/runtime/[A-Za-z0-9_-]+\\.mjs$"))

  ;; All products, including the native library, are prepared once. Test bodies
  ;; execute the original fixture; they never rebuild a compiler or runtime.
  (defvar directory undefined)
  (defvar backend undefined)
  (defvar bytes undefined)
  (defvar lowered undefined)
  (defvar reference undefined)
  (defvar reference-path undefined)
  (defvar wasm-path undefined)
  (defvar native-path undefined)
  (defvar frozen-reference undefined)
  (defvar cold-bytes undefined)
  (defvar cold-lowered undefined)
  (defvar cold-reference undefined)
  (defvar cold-native-path undefined)
  (defvar number-bytes undefined)
  (defvar number-lowered undefined)
  (defvar number-oracle undefined)
  (defvar number-native-path undefined)
  (defvar sqrt-bytes undefined)
  (defvar sqrt-lowered undefined)
  (defvar sqrt-reference undefined)
  (defvar sqrt-reference-path undefined)
  (defvar sqrt-wasm-path undefined)
  (defvar sqrt-native-path undefined)

  (defconst native-target
    (if (= (get globalThis.process :arch) "arm64")
      (cond
        ((= (get globalThis.process :platform) "darwin") "arm64-macos")
        ((= (get globalThis.process :platform) "linux") "arm64-linux")
        (t nil))
      nil))

  (defconst sqrt-source
    (str
      "(defun original-sqrt-primitive-hook (hint)\n"
      " (let* ((receiver (js* \"this\")) (state (get receiver \"__eliscript_original_sqrt_receiver_state\")))\n"
      "  (js-call (get state :trace) :push hint (eq receiver (get state :input)))\n"
      "  (cond ((= (get state :mode) 5) (throw (get state :marker)))\n"
      "   ((= (get state :mode) 6) (js-object)) (t \"81\"))))\n"
      "(defun sqrt-method (mode)\n"
      " (cond ((= mode 0) Math/sqrt) ((= mode 1) globalThis/Math.sqrt) (t (get (js* \"Math\") \"sqrt\"))))\n"
      "(defun sqrt-callback (method value) (funcall method value))\n"
      "(defun sqrt-call (mode value)\n"
      " (cond ((= mode 0) (Math/sqrt value)) ((= mode 1) (globalThis/Math.sqrt value))\n"
      "  ((= mode 2) (js-call (js* \"Math\") \"sqrt\" value))\n"
      "  ((= mode 3) (funcall Math/sqrt value))\n"
      "  ((= mode 4) (js-call Math/sqrt :call nil value))\n"
      "  ((= mode 5) (js-call Math/sqrt :apply nil (js-array value)))\n"
      "  ((= mode 6) (funcall (js-call Math/sqrt :bind nil) value))\n"
      "  ((= mode 7) (funcall sqrt-callback Math/sqrt value))\n"
      "  ((= mode 8) (funcall (js-call (js-call Math/sqrt :bind nil) :bind (js-object)) value))\n"
      "  (t (get (js-call (js-array value) :map (js-call Math/sqrt :bind nil)) 0))))\n"
      "(defun sqrt-held (method &rest args) (apply method args))\n"
      "(defun sqrt-arity (missing)\n"
      " (let ((trace (js-array)))\n"
      "  (js-array (if missing (Math/sqrt)\n"
      "    (Math/sqrt\n"
      "     (progn (js-call trace :push \"argument\")\n"
      "      (js-object :valueOf (lambda () (js-call trace :push \"convert\") 81)))\n"
      "     (progn (js-call trace :push \"extra\")\n"
      "      (js-object :valueOf (lambda () (throw \"ignored extra converted\")))))) trace)))\n"
      "(defun sqrt-convert (mode)\n"
      " (let* ((trace (js-array)) (marker (js-object))\n"
      "        (input (cond ((= mode 0) (new globalThis/Number 81))\n"
      "          ((= mode 1) (new globalThis/String \"81\")) ((= mode 2) (new globalThis/Boolean t))\n"
      "          ((= mode 7) (funcall globalThis/Symbol \"sqrt\"))\n"
      "          ((= mode 8) (funcall globalThis/BigInt \"81\"))\n"
      "          ((= mode 9) (funcall globalThis/Object (funcall globalThis/BigInt \"81\")))\n"
      "          ((= mode 10) (funcall globalThis/Object (funcall globalThis/Symbol \"sqrt\")))\n"
      "          ((= mode 11) (new globalThis/Number -0.0)) (t (js-object)))))\n"
      "  (when (= mode 3)\n"
      "   (Object/defineProperty input \"valueOf\" (js-object :get (lambda ()\n"
      "    (js-call trace :push \"valueOf.get\")\n"
      "    (lambda () (js-call trace :push \"valueOf.call\") (js-object)))))\n"
      "   (Object/defineProperty input \"toString\" (js-object :get (lambda ()\n"
      "    (js-call trace :push \"toString.get\") (lambda () (js-call trace :push \"toString.call\") \"81\")))))\n"
      "  (when (or (= mode 4) (= mode 5) (= mode 6))\n"
      "   (Object/defineProperty input \"__eliscript_original_sqrt_receiver_state\"\n"
      "    (js-object :value (js-object :trace trace :input input :mode mode :marker marker)))\n"
      "   (Object/defineProperty input (js* \"Symbol.toPrimitive\") (js-object :get (lambda ()\n"
      "    (js-call trace :push \"primitive.get\") original-sqrt-primitive-hook))))\n"
      "  (js-array (try (Math/sqrt input)\n"
      "   (catch error (if (eq error marker) \"marker\" (get error :name)))) trace)))\n"
      "(defun sqrt-throw (marker) (Math/sqrt (js-object :valueOf (lambda () (throw marker)))))\n"
      "(defun sqrt-description (held)\n"
      " (let* ((namespace (js* \"Math\")) (method (get namespace \"sqrt\"))\n"
      "        (descriptor (Object/getOwnPropertyDescriptor namespace \"sqrt\"))\n"
      "        (name (Object/getOwnPropertyDescriptor method \"name\"))\n"
      "        (length (Object/getOwnPropertyDescriptor method \"length\")))\n"
      "  (js-array (eq held method) (eq Math/sqrt method) (eq globalThis/Math.sqrt method)\n"
      "   (get method :name) (get method :length) (Object/hasOwn method \"prototype\")\n"
      "   (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable)\n"
      "   (get name :writable) (get name :enumerable) (get name :configurable)\n"
      "   (get length :writable) (get length :enumerable) (get length :configurable))))\n"
      "(defun sqrt-mutations ()\n"
      " (let* ((namespace (js* \"Math\")) (saved (Object/getOwnPropertyDescriptor namespace \"sqrt\"))\n"
      "        (held Math/sqrt) (replacement (lambda (value) 99)))\n"
      "  (try (put namespace :sqrt replacement)\n"
      "   (let ((same (eq Math/sqrt replacement)) (called (Math/sqrt 81)))\n"
      "    (Reflect/deleteProperty namespace \"sqrt\")\n"
      "    (js-array same called (eq Math/sqrt undefined)\n"
      "     (try (globalThis/Math.sqrt 81) (catch error (get error :name)))\n"
      "     (funcall held 9)))\n"
      "   (finally (Object/defineProperty namespace \"sqrt\" saved)))))\n"
      "(defun sqrt-metadata-mutation ()\n"
      " (let* ((method Math/sqrt) (name (Object/getOwnPropertyDescriptor method \"name\"))\n"
      "        (length (Object/getOwnPropertyDescriptor method \"length\")))\n"
      "  (try\n"
      "   (Object/defineProperty method \"name\" (js-object :value \"changed\"))\n"
      "   (Object/defineProperty method \"length\" (js-object :value 4))\n"
      "   (js-array (get method :name) (get method :length) (funcall method 81))\n"
      "   (finally (Object/defineProperty method \"name\" name) (Object/defineProperty method \"length\" length)))))\n"
      "(defun sqrt-order (mode)\n"
      " (let* ((namespace (js* \"Math\")) (saved (Object/getOwnPropertyDescriptor namespace \"sqrt\"))\n"
      "        (method (get saved :value)) (trace (js-array))\n"
      "        (key (js-object)) (input (js-object :valueOf (lambda ()\n"
      "         (js-call trace :push \"number\") (if (= mode 3) (throw false) 81)))))\n"
      "  (put key (js* \"Symbol.toPrimitive\") (lambda (hint)\n"
      "   (js-call trace :push hint) (if (= mode 1) (throw false) \"sqrt\")))\n"
      "  (try\n"
      "   (Object/defineProperty namespace \"sqrt\" (js-object :configurable t :get (lambda ()\n"
      "    (js-call trace :push \"method\") (if (= mode 2) (throw false) method))))\n"
      "   (js-array (try (js-call namespace key\n"
      "      (progn (js-call trace :push \"argument\") input)\n"
      "      (progn (js-call trace :push \"extra\") (js-object :valueOf (lambda () (throw \"ignored\")))))\n"
      "     (catch error (if (eq error false) \"marker\" (throw error)))) trace)\n"
      "   (finally (Object/defineProperty namespace \"sqrt\" saved)))))\n"
      "(defun sqrt-construct (mode)\n"
      " (let ((method Math/sqrt) (trace (js-array)))\n"
      "  (js-array (try\n"
      "   (cond ((= mode 0) (new method (progn (js-call trace :push \"argument\") 81)))\n"
      "    ((= mode 1) (Reflect/construct method (js-array 81)))\n"
      "    (t (new (js-call method :bind nil) 81)))\n"
      "   (catch error (get error :name))) trace)))\n"
      "(defun sqrt-shadow ()\n"
      " (let ((Math (js-object :sqrt (lambda (value) (+ value 10))))) (Math/sqrt 2)))\n"
      "(export sqrt-method sqrt-callback sqrt-call sqrt-held sqrt-arity sqrt-convert sqrt-throw\n"
      " sqrt-description sqrt-mutations sqrt-metadata-mutation sqrt-order sqrt-construct sqrt-shadow)\n"))

  (defconst cold-integer-source
    (str
      "(defun cold-integer-key (mode) (cond ((= mode 0) \"round\") ((= mode 1) \"floor\") ((= mode 2) \"ceil\") (t \"trunc\")))\n"
      "(defun cold-integer-method (mode)\n"
      " (cond ((= mode 0) Math/round) ((= mode 1) globalThis/Math.floor)\n"
      "  ((= mode 2) (js* \"Math.ceil\")) (t Math/trunc)))\n"
      "(defun cold-integer-call (mode value)\n"
      " (cond ((= mode 0) (Math/round value)) ((= mode 1) (globalThis/Math.floor value))\n"
      "  ((= mode 2) (js-call (js* \"Math\") :ceil value)) (t (Math/trunc value))))\n"
      "(defun cold-held-call (method value) (funcall method value))\n"
      "(defun cold-integer-description (method) (js-array (get method :name) (get method :length)))\n"
      "(defun cold-integer-abrupt (mode marker)\n"
      " (cold-integer-call mode (js-object :valueOf (lambda () (throw marker)))))\n"
      "(defun cold-integer-replacement (value) (js-array (eq (js* \"this\") (js* \"Math\")) value))\n"
      "(defun cold-integer-relations (mode captured)\n"
      " (let* ((namespace (js* \"Math\")) (key (cold-integer-key mode))\n"
      "        (descriptor (Object/getOwnPropertyDescriptor namespace key)))\n"
      "  (js-array (eq captured (get namespace key)) (eq captured (cold-integer-method mode))\n"
      "   (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable)\n"
      "   (get captured :name) (get captured :length))))\n"
      "(defun cold-integer-mutations (mode)\n"
      " (let* ((namespace (js* \"Math\")) (key (cold-integer-key mode))\n"
      "        (descriptor (Object/getOwnPropertyDescriptor namespace key)) (original (get descriptor :value))\n"
      "        (replacement cold-integer-replacement))\n"
      "  (try (put namespace key replacement)\n"
      "   (let ((same (eq (cold-integer-method mode) replacement)) (called (cold-integer-call mode -0.0)))\n"
      "    (Reflect/deleteProperty namespace key)\n"
      "    (js-array same called (eq (cold-integer-method mode) undefined)\n"
      "     (try (cold-integer-call mode 1) (catch error (get error :name)))\n"
      "     (cold-held-call original -0.0)))\n"
      "   (finally (Object/defineProperty namespace key descriptor)))))\n"
      "(defun cold-integer-order (mode abrupt)\n"
      " (let* ((namespace (js* \"Math\")) (key (cold-integer-key mode))\n"
      "        (descriptor (Object/getOwnPropertyDescriptor namespace key)) (original (get descriptor :value))\n"
      "        (replacement (lambda (value) 99)) (trace (js-object :step 0 :gets 0)))\n"
      "  (try\n"
      "   (Object/defineProperty namespace key (js-object :configurable t :get (lambda ()\n"
      "    (put trace :step 1) (put trace :gets (+ (get trace :gets) 1))\n"
      "    (if abrupt (throw false) original))))\n"
      "   (let* ((argument (lambda () (put trace :step 2)\n"
      "            (Object/defineProperty namespace key (js-object :value replacement :writable t :configurable t)) 7))\n"
      "          (result (try (cond ((= mode 0) (Math/round (funcall argument)))\n"
      "                        ((= mode 1) (globalThis/Math.floor (funcall argument)))\n"
      "                        ((= mode 2) (js-call (js* \"Math\") :ceil (funcall argument)))\n"
      "                        (t (Math/trunc (funcall argument))))\n"
      "     (catch error (if (eq error false) \"marker\" (throw error))))))\n"
      "    (js-array result (get trace :step) (get trace :gets)))\n"
      "   (finally (Object/defineProperty namespace key descriptor)))))\n"
      "(defun cold-integer-shadow ()\n"
      " (let ((Math (js-object :round (lambda (value) (+ value 10))))) (Math/round 2)))\n"
      "(export cold-integer-method cold-integer-call cold-held-call cold-integer-description cold-integer-abrupt\n"
      " cold-integer-relations cold-integer-mutations cold-integer-order cold-integer-shadow)\n"))

  (defconst cold-number-source
    (str
      "(defun cold-number-value () (js* \"Number\"))\n"
      "(defun cold-number-box (value) (new (js* \"Number\") value))\n"
      "(defun cold-number-unbox (value) (js-call value :valueOf))\n"
      "(defun cold-number-normalize (value constructor)\n"
      " (cond ((= (value-type value) \"function\")\n"
      "         (js-array \"function\" (get value :name) (get value :length) (Object/hasOwn value \"prototype\")))\n"
      "       ((= (value-type value) \"object\") (js-array \"object\" (Object/is value (get constructor :prototype))))\n"
      "       ((= (value-type value) \"number\")\n"
      "        (js-array \"number\" (cond ((Object/is value (/ 0 0)) \"NaN\")\n"
      "          ((Object/is value -0.0) \"-0\") ((= value (/ 1 0)) \"+Infinity\")\n"
      "          ((= value (/ -1 0)) \"-Infinity\") (t value))))\n"
      "       (t (js-array (value-type value) value))))\n"
      "(defun cold-number-first (constructor key mode)\n"
      " (cond ((= mode 0) (cold-number-normalize (get constructor key) constructor))\n"
      "       ((= mode 1) (Object/hasOwn constructor key))\n"
      "       ((= mode 2) (Reflect/has constructor key))\n"
      "       ((= mode 3) (let ((descriptor (Object/getOwnPropertyDescriptor constructor key)))\n"
      "         (js-array (cold-number-normalize (get descriptor :value) constructor)\n"
      "          (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable))))\n"
      "       ((= mode 4) (Object/getOwnPropertyNames constructor))\n"
      "       ((= mode 5) (Object/keys constructor))\n"
      "       (t (Reflect/ownKeys constructor))))\n"
      "(defun cold-number-snapshot (constructor boxed)\n"
      " (let* ((names (Object/getOwnPropertyNames constructor)) (fields (js-array)) (index 0))\n"
      "  (while (< index (get names :length))\n"
      "   (let* ((key (aref names index)) (descriptor (Object/getOwnPropertyDescriptor constructor key)))\n"
      "    (js-call fields :push (js-array key (cold-number-normalize (get descriptor :value) constructor)\n"
      "      (get descriptor :writable) (get descriptor :enumerable) (get descriptor :configurable))))\n"
      "   (setq index (1+ index)))\n"
      "  (js-array names (Object/keys constructor) fields\n"
      "   (Object/is (Object/getPrototypeOf constructor) (get globalThis/Function :prototype))\n"
      "   (Object/is (Object/getPrototypeOf boxed) (get constructor :prototype))\n"
      "   (Object/is (get (Object/getPrototypeOf boxed) :constructor) constructor)\n"
      "   (Object/is (get constructor :parseInt) (js* \"globalThis.parseInt\"))\n"
      "   (Object/is (get constructor :parseFloat) (js* \"globalThis.parseFloat\"))\n"
      "   (Object/is (cold-number-unbox boxed) -0.0))))\n"
      "(defun cold-number-key-error (constructor trace)\n"
      " (let ((key (js-object)))\n"
      "  (put key (get globalThis/Symbol :toPrimitive) (lambda (hint) (js-call trace :push hint) (throw false)))\n"
      "  (get constructor key)))\n"
      "(defun cold-number-target () nil)\n"
      "(defun cold-number-newtarget (value)\n"
      " (let* ((target cold-number-target) (saved (get target :prototype)) (prototype (js-object :marker 7)))\n"
      "  (try\n"
      "   (put target :prototype prototype)\n"
      "   (let ((boxed (Reflect/construct (js* \"Number\") (js-array value) target)))\n"
      "    (js-array (Object/is (Object/getPrototypeOf boxed) prototype)\n"
      "     (Object/is (js-call (get (get (js* \"Number\") :prototype) :valueOf) :call boxed) -0.0)))\n"
      "   (finally (put target :prototype saved)))))\n"
      "(defun cold-number-descriptor-cycle (kind writable-mode)\n"
      " (let* ((target (cond ((= kind 0) (js-object)) ((= kind 1) (js-array)) (t cold-number-target)))\n"
      "        (key (if (= kind 1) \"0\" \"__number_descriptor_case__\")))\n"
      "  (try\n"
      "   (Object/defineProperty target key (js-object :value 1 :writable t :enumerable t :configurable t))\n"
      "   (let ((saved (Object/getOwnPropertyDescriptor target key)))\n"
      "    (Object/defineProperty target key (js-object :get (lambda () 2)))\n"
      "    (Object/defineProperty target key\n"
      "     (cond ((= writable-mode 0) (js-object :value 3 :writable t))\n"
      "           ((= writable-mode 1) (js-object :value 3 :writable false)) (t (js-object :value 3))))\n"
      "    (let* ((descriptor (Object/getOwnPropertyDescriptor target key))\n"
      "           (written (Reflect/set target key 4)) (after (get target key)))\n"
      "     (Object/defineProperty target key (js-object :get (lambda () 2)))\n"
      "     (Object/defineProperty target key saved)\n"
      "     (put target key 5)\n"
      "     (let ((restored (Object/getOwnPropertyDescriptor target key)))\n"
      "      (js-array (get descriptor :value) (get descriptor :writable) (get descriptor :enumerable)\n"
      "       (get descriptor :configurable) written after (get restored :value) (get restored :writable)\n"
      "       (get restored :enumerable) (get restored :configurable)))))\n"
      "   (finally (Reflect/deleteProperty target key)))))\n"
      "(defun cold-number-order (constructor abrupt)\n"
      " (let* ((trace (js-array)) (key (js-object))\n"
      "        (saved (Object/getOwnPropertyDescriptor constructor \"isFinite\")) (original (get saved :value)))\n"
      "  (put key (get globalThis/Symbol :toPrimitive)\n"
      "   (lambda (hint) (js-call trace :push hint) (if abrupt (throw false) \"isFinite\")))\n"
      "  (try\n"
      "   (Object/defineProperty constructor \"isFinite\" (js-object :configurable t :get\n"
      "    (lambda () (js-call trace :push \"get\") original)))\n"
      "   (js-array (try (js-call constructor key\n"
      "     (progn (js-call trace :push \"argument\")\n"
      "      (Object/defineProperty constructor \"isFinite\" (js-object :value (lambda (value) 77) :writable t :configurable t)) 7))\n"
      "     (catch error (if (Object/is error false) \"marker\" (throw error)))) trace)\n"
      "   (finally (Object/defineProperty constructor \"isFinite\" saved)))))\n"
      "(defun cold-number-mutations (constructor &optional trace)\n"
      " (let* ((saved (Object/getOwnPropertyDescriptor constructor \"isFinite\"))\n"
      "        (parser (Object/getOwnPropertyDescriptor constructor \"parseInt\"))\n"
      "        (original (get saved :value)))\n"
      "  (try\n"
      "   (when trace (js-call trace :push \"set isFinite\"))\n"
      "   (put constructor :isFinite (lambda (value) 77))\n"
      "   (when trace (js-call trace :push \"call replacement\"))\n"
      "   (let ((replacement (js-call constructor :isFinite \"input\")))\n"
      "    (when trace (js-call trace :push \"delete isFinite\"))\n"
      "    (Reflect/deleteProperty constructor \"isFinite\")\n"
      "    (when trace (js-call trace :push \"set parseInt\"))\n"
      "    (put constructor :parseInt (lambda (input radix) 88))\n"
      "    (let* ((present (progn (when trace (js-call trace :push \"has deleted isFinite\")) (Object/hasOwn constructor \"isFinite\")))\n"
      "           (missing (progn (when trace (js-call trace :push \"read deleted isFinite\")) (get constructor :isFinite)))\n"
      "           (held (progn (when trace (js-call trace :push \"call held isFinite\")) (funcall original 7)))\n"
      "           (replaced-parser (progn (when trace (js-call trace :push \"call replacement parseInt\")) (js-call constructor :parseInt \"10\" 10)))\n"
      "           (global-parser (progn (when trace (js-call trace :push \"call original parseInt\")) (funcall (js* \"globalThis.parseInt\") \"10\" 10)))\n"
      "           (reflected (progn (when trace (js-call trace :push \"Reflect.set EPSILON\")) (Reflect/set constructor \"EPSILON\" 7)))\n"
      "           (strict (progn (when trace (js-call trace :push \"strict set EPSILON\"))\n"
      "             (try (put constructor :EPSILON 7) (catch error (get error :name))))))\n"
      "     (js-array replacement present missing held replaced-parser global-parser reflected strict)))\n"
      "   (finally\n"
      "    (when trace (js-call trace :push \"restore isFinite\"))\n"
      "    (Object/defineProperty constructor \"isFinite\" saved)\n"
      "    (when trace (js-call trace :push \"restore parseInt\"))\n"
      "    (Object/defineProperty constructor \"parseInt\" parser)\n"
      "    (when trace (js-call trace :push \"restored\"))))))\n"
      "(export cold-number-value cold-number-box cold-number-unbox cold-number-first cold-number-snapshot\n"
      " cold-number-key-error cold-number-newtarget cold-number-descriptor-cycle cold-number-order cold-number-mutations)\n"))

  (defun managed-bytes (product)
    ;; This is emit-managed-wasm's exact typed emission and descriptor envelope,
    ;; reusing the lowering already needed by the native emitter.
    (globalThis.Uint8Array.from
      (js-call (get backend :wasm) :append_metadata_section
        (js-call (get backend :wasm) :emit_typed_memory_wasm (get product :typed))
        "eliscript-managed-control"
        (JSON/stringify (get product :descriptor)))))

  (defun native-binding (product)
    ;; Match the native loader's consumed ABI metadata. Executable bodies live
    ;; in the emitted library; do not retain two complete runtime typed graphs.
    (let* ((tp (get product :typed))
           (typed-summary
             (js-object
               :abi (get tp :abi)
               :functions (js-call (get tp :functions) :map
                            (lambda (fn) (js-object :name (get fn :name) :arity (get fn :arity))))
               :exports (js-call (get tp :exports) :slice)))
           (out (js-object :descriptor (get product :descriptor) :typed typed-summary)))
      (when (not (undefined? (get product :debug)))
        (put out :debug (get product :debug)))
      (when (not (undefined? (get tp :aliases)))
        (put typed-summary :aliases
          (js-call (get tp :aliases) :map
            (lambda (al) (js-object :name (get al :name) :function (get al :function))))))
      out))

  (defun verify-emitted-imports (js-source)
    (let ((scanner (new globalThis.Bun.Transpiler (js-object :loader "js"))))
      (js-call (js-call scanner :scanImports js-source) :forEach
        (lambda (dependency)
          (js-call assert :equal (get dependency :kind) "import-statement"
            "the standalone Math oracle permits only static runtime dependencies")
          (js-call assert :match (get dependency :path) runtime-import-pattern
            "the standalone Math oracle must declare only official eliscript/runtime imports")))))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-math-"))))
      (await (mkdir (resolve directory "node_modules") (js-object :recursive t)))
      (await (symlink root (resolve directory "node_modules/eliscript")))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((runtime (js-call (get backend :compiler) :compile_ir_string
                        (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
             (program (js-call (get backend :compiler) :compile_ir_string
                        (await (readFile "tests/fixtures/wasm-managed-math.eli" "utf8")) "math.eli"))
             (saved (JSON/stringify program))
             (javascript (js-call (get backend :compiler) :emit_ir_string program)))
        (setq reference-path (resolve directory "math-reference.mjs"))
        (setq wasm-path (resolve directory "math.wasm"))
        (await (writeFile reference-path javascript))
        ;; Freezing the actual JS Math object cannot be undone. Its independent oracle
        ;; therefore runs in its own process and never touches the Bun test realm.
        (let ((child (spawnSync "node"
                       (js-array math-node-helper-path "--freeze-namespace"
                                 (get (pathToFileURL reference-path) :href))
                       (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))
          (setq frozen-reference (JSON/parse (get child :stdout))))
        (let ((reference-bytes (await (readFile reference-path))))
          (js-call assert :equal (js-call reference-bytes :toString "utf8") javascript
            "the Bun oracle must execute the exact file bytes verified by Node")
          (verify-emitted-imports javascript)
          (try
            (setq reference (await (funcall dynamic-import (get (pathToFileURL reference-path) :href))))
            (catch cause
              (throw (new globalThis.Error
                       (str "Math JS oracle import failed: " reference-path
                            " (" (get reference-bytes :length) " written bytes, "
                            (Buffer/byteLength javascript) " emitted bytes): "
                            (let ((st (get cause :stack)))
                              (if (nullish? st) (globalThis.String cause) st)))
                       (js-object :cause cause))))))
        (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime))
        (setq bytes (managed-bytes lowered))
        (js-call assert :equal (JSON/stringify program) saved "lowering must not mutate source IR")
        (js-call assert :deepEqual
          (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes))
          (js-array))
        (await (writeFile wasm-path bytes))
        (if native-target
          (progn
            (setq native-path (resolve directory (if (= native-target "arm64-macos") "math.dylib" "math.so")))
            (await (writeFile native-path
                     (globalThis.Uint8Array.from
                       (js-call (get backend :native) :emit_typed_native_memory_library
                         (get lowered :typed) native-target))))
            (js-call assert :equal (JSON/stringify program) saved "native preparation must preserve source IR")
            (setq lowered (native-binding lowered)))
          (setq lowered undefined))
        ;; Cold-call regressions own a separate module and heap.
        (let* ((cold-program (js-call (get backend :compiler) :compile_ir_string cold-integer-source "cold-math.eli"))
               (saved-cold (JSON/stringify cold-program))
               (cold-javascript (js-call (get backend :compiler) :emit_ir_string cold-program))
               (cold-reference-path (resolve directory "cold-math-reference.mjs")))
          (await (writeFile cold-reference-path cold-javascript))
          (let ((cold-reference-bytes (await (readFile cold-reference-path))))
            (js-call assert :equal (js-call cold-reference-bytes :toString "utf8") cold-javascript
              "the cold Math oracle must execute the exact emitted file bytes")
            (verify-emitted-imports cold-javascript)
            (setq cold-reference (await (funcall dynamic-import (get (pathToFileURL cold-reference-path) :href)))))
          (setq cold-lowered (js-call (get backend :managed) :lower_managed_program cold-program runtime))
          (setq cold-bytes (managed-bytes cold-lowered))
          (js-call assert :equal (JSON/stringify cold-program) saved-cold "cold lowering must not mutate source IR")
          (js-call assert :deepEqual
            (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module cold-bytes))
            (js-array))
          (if native-target
            (progn
              (setq cold-native-path (resolve directory (if (= native-target "arm64-macos") "cold-math.dylib" "cold-math.so")))
              (await (writeFile cold-native-path
                       (globalThis.Uint8Array.from
                         (js-call (get backend :native) :emit_typed_native_memory_library
                           (get cold-lowered :typed) native-target))))
              (js-call assert :equal (JSON/stringify cold-program) saved-cold
                "cold native preparation must preserve source IR")
              (setq cold-lowered (native-binding cold-lowered)))
            (setq cold-lowered undefined)))
        (let* ((number-program (js-call (get backend :compiler) :compile_ir_string cold-number-source "cold-number.eli"))
               (saved-number (JSON/stringify number-program))
               (number-javascript (js-call (get backend :compiler) :emit_ir_string number-program))
               (number-reference-path (resolve directory "cold-number-reference.mjs")))
          (await (writeFile number-reference-path number-javascript))
          (let ((number-reference-bytes (await (readFile number-reference-path))))
            (js-call assert :equal (js-call number-reference-bytes :toString "utf8") number-javascript)
            (verify-emitted-imports number-javascript))
          ;; This oracle deletes/reinserts constructor properties. Run those exact
          ;; generated bytes in Node so it cannot reorder the Bun test realm's Number.
          (let ((number-child (spawnSync "node"
                                (js-array math-node-helper-path "--cold-number"
                                          (get (pathToFileURL number-reference-path) :href))
                                (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get number-child :error) undefined)
            (js-call assert :equal (get number-child :signal) nil)
            (js-call assert :equal (get number-child :status) 0 (get number-child :stderr))
            (let ((number-document (JSON/parse (get number-child :stdout))))
              (letfn ((decode-number-oracle (v)
                        (cond
                          ((Array/isArray v) (js-call v :map decode-number-oracle))
                          ((and (not (nullish? v)) (= (value-type v) "object") (= (get v :undefined) t))
                           undefined)
                          (t v))))
                (setq number-oracle
                  (Object/fromEntries
                    (js-call (Object/entries number-document) :map
                      (lambda (entry)
                        (js-array (aref entry 0) (decode-number-oracle (aref entry 1))))))))))
          (setq number-lowered (js-call (get backend :managed) :lower_managed_program number-program runtime))
          (setq number-bytes (managed-bytes number-lowered))
          (js-call assert :equal (JSON/stringify number-program) saved-number
            "cold Number lowering must preserve source IR")
          (js-call assert :deepEqual
            (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module number-bytes))
            (js-array))
          (if native-target
            (progn
              (setq number-native-path
                (resolve directory (if (= native-target "arm64-macos") "cold-number.dylib" "cold-number.so")))
              (await (writeFile number-native-path
                       (globalThis.Uint8Array.from
                         (js-call (get backend :native) :emit_typed_native_memory_library
                           (get number-lowered :typed) native-target))))
              (js-call assert :equal (JSON/stringify number-program) saved-number
                "cold Number native emission must preserve source IR")
              (setq number-lowered (native-binding number-lowered)))
            (setq number-lowered undefined)))
        (let* ((sqrt-program (js-call (get backend :compiler) :compile_ir_string sqrt-source "sqrt-math.eli"))
               (saved-sqrt (JSON/stringify sqrt-program))
               (sqrt-javascript (js-call (get backend :compiler) :emit_ir_string sqrt-program)))
          (setq sqrt-reference-path (resolve directory "sqrt-math-reference.mjs"))
          (setq sqrt-wasm-path (resolve directory "sqrt-math.wasm"))
          (await (writeFile sqrt-reference-path sqrt-javascript))
          (let ((sqrt-reference-bytes (await (readFile sqrt-reference-path))))
            (js-call assert :equal (js-call sqrt-reference-bytes :toString "utf8") sqrt-javascript)
            (verify-emitted-imports sqrt-javascript)
            (setq sqrt-reference (await (funcall dynamic-import (get (pathToFileURL sqrt-reference-path) :href)))))
          (setq sqrt-lowered (js-call (get backend :managed) :lower_managed_program sqrt-program runtime))
          (setq sqrt-bytes (managed-bytes sqrt-lowered))
          (js-call assert :equal (JSON/stringify sqrt-program) saved-sqrt "sqrt lowering must preserve source IR")
          (js-call assert :deepEqual
            (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module sqrt-bytes))
            (js-array))
          (await (writeFile sqrt-wasm-path sqrt-bytes))
          (if native-target
            (progn
              (setq sqrt-native-path
                (resolve directory (if (= native-target "arm64-macos") "sqrt-math.dylib" "sqrt-math.so")))
              (await (writeFile sqrt-native-path
                       (globalThis.Uint8Array.from
                         (js-call (get backend :native) :emit_typed_native_memory_library
                           (get sqrt-lowered :typed) native-target))))
              (js-call assert :equal (JSON/stringify sqrt-program) saved-sqrt
                "sqrt native emission must preserve source IR")
              (setq sqrt-lowered (native-binding sqrt-lowered)))
            (setq sqrt-lowered undefined)))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun with-wasm (check-fn &rest __host_default_arguments_1)
    (let* ((product (aref __host_default_arguments_1 0)))
    (let ((a (instantiateManagedRuntime (if (undefined? product) bytes product))))
      (js-call a :auto 1)
      (try
        (funcall check-fn a)
        (finally (finish a))))))

  (defun check-cold-integers (a)
    (js-call a :auto 1)
    (let* ((saved (js-call a :number -0.0))
           (frame (js-call a :frame 1))
           (methods (js-array))
           (fillers (js-array)))
      (js-call a :frameSet frame 0 saved)
      (try
        (let ((names (js-array "round" "floor" "ceil" "trunc"))
              (index 0))
          (while (< index (get names :length))
            (let ((name (aref names index))
                  (mode (js-call a :number index)))
              (try
                (let ((method (js-call a :invoke "cold-integer-method" (js-array mode))))
                  (js-call methods :push method)
                  (js-call assert :equal (get method :kind) 18)
                  (js-call assert :deepEqual (value a "cold-integer-description" (js-array method))
                    (js-call cold-reference :cold_integer_description
                      (js-call cold-reference :cold_integer_method index)))
                  (js-call (js-array -0.0 -1.5 -0.5 0.5 (get globalThis.Number :NaN)) :forEach
                    (lambda (input)
                      (let ((argument (if (Object/is input -0.0) saved (js-call a :number input))))
                        (try
                          (exact (value a "cold-held-call" (js-array method argument))
                                 (Reflect/apply (get globalThis.Math name) globalThis.Math (js-array input))
                                 (str "cold held " name))
                          (exact (value a "cold-integer-call" (js-array mode argument))
                                 (js-call cold-reference :cold_integer_call index input)
                                 (str "cold direct " name))
                          (finally
                            (when (/= argument saved)
                              (js-call a :release argument)))))))
                  (let ((thrown false))
                    (try
                      (js-call a :invoke "cold-integer-abrupt" (js-array mode false))
                      (catch error
                        (setq thrown t)
                        (js-call assert :strictEqual error false)))
                    (funcall assert thrown))
                  (js-call a :collect)
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                  (exact (js-call a :readNumber saved) -0.0 (str "cold caller root " name)))
                (finally (js-call a :release mode))))
            (setq index (1+ index))))
        (let ((exhausted false)
              (index 0))
          (while (and (<= index 256) (not exhausted))
            (try
              (js-call fillers :push (js-call a :number (+ index 0.25)))
              (catch error
                (let ((diag (get error :eliscriptDiagnostic)))
                  (js-call assert :equal (if (nullish? diag) undefined (get diag :code)) "ELI-RT0002")
                  (setq exhausted t))))
            (setq index (1+ index)))
          (funcall assert exhausted "the cold 256-slot budget must remain a hard limit"))
        (js-call assert :throws
          (lambda () (js-call a :invoke "cold-held-call" (js-array (aref methods 0) saved)))
          (lambda (error)
            (let ((diag (get error :eliscriptDiagnostic)))
              (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0002")))))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (exact (js-call a :readNumber saved) -0.0 "cold capacity failure caller root")
        (js-call fillers :forEach (lambda (r) (js-call a :release r)))
        (put fillers :length 0)
        (js-call a :collect)
        (exact (value a "cold-held-call" (js-array (aref methods 0) saved)) -0.0 "cold capacity recovery")
        (let ((again-mode (js-call a :number 0)))
          (try
            (let ((again (js-call a :invoke "cold-integer-method" (js-array again-mode))))
              (try
                (funcall assert (js-call a :keyEqual again (aref methods 0)))
                (finally (js-call a :release again))))
            (finally (js-call a :release again-mode))))
        (let ((caller (js-call a :frameGet frame 0)))
          (try
            (exact (js-call a :readNumber caller) -0.0 "retained cold caller frame")
            (finally (js-call a :release caller))))
        (finally
          (js-call fillers :forEach (lambda (r) (js-call a :release r)))
          (js-call a :leaveFrame frame)
          (js-call methods :forEach (lambda (m) (js-call a :release m)))
          (js-call a :release saved)))))

  (defun check-cold-integer-namespace (a)
    (js-call a :auto 1)
    (let ((modes (js-array))
          (methods (js-array)))
      (try
        (let ((index 0))
          (while (< index 4)
            (let ((mode (js-call a :number index)))
              (js-call modes :push mode)
              (js-call methods :push (js-call a :invoke "cold-integer-method" (js-array mode))))
            (setq index (1+ index))))
        (js-call a :collect)
        (let ((names (js-array "round" "floor" "ceil" "trunc"))
              (index 0))
          (while (< index (get names :length))
            (let* ((name (aref names index))
                   (expected (js-call cold-reference :cold_integer_relations index
                               (js-call cold-reference :cold_integer_method index))))
              (js-call assert :deepEqual expected (js-array t t t false t name 1))
              (js-call assert :deepEqual
                (value a "cold-integer-relations" (js-array (aref modes index) (aref methods index)))
                expected)
              (js-call assert :deepEqual
                (value a "cold-integer-mutations" (js-array (aref modes index)))
                (js-call cold-reference :cold_integer_mutations index))
              (js-call assert :deepEqual
                (js-call cold-reference :cold_integer_mutations index)
                (js-array t (js-array t -0.0) t "TypeError" -0.0))
              (js-call (js-array false t) :forEach
                (lambda (abrupt)
                  (let ((order (js-call cold-reference :cold_integer_order index abrupt)))
                    (js-call assert :deepEqual order
                      (if abrupt (js-array "marker" 1 1) (js-array 7 2 1)))
                    (js-call assert :deepEqual
                      (value a "cold-integer-order" (js-array (aref modes index) abrupt))
                      order))))
              (js-call a :collect)
              (let ((again (js-call a :invoke "cold-integer-method" (js-array (aref modes index)))))
                (try
                  (funcall assert (js-call a :keyEqual again (aref methods index)))
                  (finally (js-call a :release again))))
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
            (setq index (1+ index))))
        (js-call assert :equal (value a "cold-integer-shadow") (js-call cold-reference :cold_integer_shadow))
        (js-call assert :equal (js-call cold-reference :cold_integer_shadow) 12)
        (finally
          (js-call (js-call modes :concat methods) :forEach (lambda (r) (js-call a :release r)))))))

  (test "cold exact integer Math references and calls retain their metadata aliases errors and caller roots within 256 slots"
    (lambda ()
      (let ((a (instantiateManagedRuntime cold-bytes
                 (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576))))
        (try
          (check-cold-integers a)
          (finally (finish a))))))

  (test "cold integer Math callables keep identity when the same realm materializes reflects overrides deletes and restores its namespace"
    (lambda () (with-wasm check-cold-integer-namespace cold-bytes)))

  (funcall (js-call test :skipIf (not native-target))
    "actual native cold integer Math callables retain the same 256-slot and namespace mutation contracts"
    (async ()
      (let ((cases (js-array
                     (js-array (js-object :maxSlots 256 :initialBytes 16384 :maxBytes 1048576) check-cold-integers)
                     (js-array (js-object) check-cold-integer-namespace)))
            (idx 0))
        (while (< idx (get cases :length))
          (let* ((pair (aref cases idx))
                 (cfg (Object/assign (js-object :nativeTarget native-target) (aref pair 0)))
                 (check-fn (aref pair 1))
                 (a (await (instantiateNativeManagedRuntime cold-native-path cold-lowered cfg))))
            (try
              (funcall check-fn a)
              (finally (finish a))))
          (setq idx (1+ idx)))))
    30000)

  (defasync check-cold-numbers (create)
    (js-call assert :deepEqual (get number-oracle :order)
      (js-array (js-array t (js-array "string" "get" "argument"))
                (js-array "marker" (js-array "string"))))
    (js-call assert :deepEqual (get number-oracle :mutations)
      (js-array 77 false undefined t 88 10 false "TypeError"))
    (let ((mode 0))
      (while (< mode 7)
        (let* ((a (await (funcall create)))
               (_ (js-call a :auto 1))
               (roots (js-array))
               (fillers (js-array))
               (frame undefined))
          (try
            (let ((saved (js-call a :number -0.0)))
              (js-call roots :push saved)
              (setq frame (js-call a :frame 1))
              (js-call a :frameSet frame 0 saved)
              (let ((ctor (js-call a :invoke "cold-number-value"))
                    (boxed (js-call a :invoke "cold-number-box" (js-array saved))))
                (js-call roots :push ctor boxed)
                (js-call assert :equal (get ctor :kind) 18)
                (js-call assert :equal (get boxed :kind) 36)
                (exact (value a "cold-number-unbox" (js-array boxed)) -0.0
                  "cold Number boxing before static observation")
                (let ((trace (js-call a :sourceArray (js-array)))
                      (thrown false))
                  (js-call roots :push trace)
                  (try
                    (js-call a :invoke "cold-number-key-error" (js-array ctor trace))
                    (catch error
                      (setq thrown t)
                      (js-call assert :strictEqual error false)))
                  (funcall assert thrown)
                  (js-call assert :deepEqual (read-val a trace) (js-array "string"))
                  (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                  (let ((key (js-call a :string "isFinite"))
                        (mode-value (js-call a :number mode)))
                    (js-call roots :push key mode-value)
                    (when (= mode 0)
                      (let ((exhausted false)
                            (index 0))
                        (while (and (<= index 1024) (not exhausted))
                          (try
                            (js-call fillers :push (js-call a :number (+ index 0.25)))
                            (catch error
                              (let ((diag (get error :eliscriptDiagnostic)))
                                (js-call assert :equal (if (nullish? diag) undefined (get diag :code)) "ELI-RT0002")
                                (setq exhausted t))))
                          (setq index (1+ index)))
                        (funcall assert exhausted "cold Number retains the default 1024-slot hard limit"))
                      (js-call assert :throws
                        (lambda () (js-call a :invoke "cold-number-first" (js-array ctor key mode-value)))
                        (lambda (error)
                          (let ((diag (get error :eliscriptDiagnostic)))
                            (and (not (nullish? diag)) (= (get diag :code) "ELI-RT0002")))))
                      (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
                      (exact (js-call a :readNumber saved) -0.0 "Number failed observation preserves caller root")
                      (js-call fillers :forEach (lambda (r) (js-call a :release r)))
                      (put fillers :length 0)
                      (js-call a :collect)
                      (exact (value a "cold-number-unbox" (js-array boxed)) -0.0
                        "Number boxing survives capacity recovery"))
                    (js-call assert :deepEqual
                      (value a "cold-number-first" (js-array ctor key mode-value))
                      (aref (get number-oracle :first) mode)
                      (str "first Number observation " mode))
                    (js-call assert :deepEqual
                      (value a "cold-number-snapshot" (js-array ctor boxed))
                      (get number-oracle :snapshot)
                      (str "complete Number names order descriptors constants prototypes and parser aliases " mode))
                    (js-call assert :deepEqual
                      (value a "cold-number-newtarget" (js-array saved))
                      (get number-oracle :newTarget)
                      "a distinct newTarget retains its actual prototype lookup")
                    (when (= mode 0)
                      (let ((kind 0))
                        (while (< kind 3)
                          (let ((writable 0))
                            (while (< writable 3)
                              (let ((expected (js-array 3 (= writable 0) t t (= writable 0)
                                                        (if (= writable 0) 4 3) 5 t t t)))
                                (js-call assert :deepEqual
                                  (aref (aref (get number-oracle :descriptorCycles) kind) writable)
                                  expected)
                                (js-call assert :deepEqual
                                  (invoke-val a "cold-number-descriptor-cycle" (js-array kind writable))
                                  expected
                                  (str "object/array/function accessor-to-data conversion and saved-descriptor restoration "
                                       kind "/" writable)))
                              (setq writable (1+ writable))))
                          (setq kind (1+ kind)))))
                    (let ((abrupts (js-array false t))
                          (ab-idx 0))
                      (while (< ab-idx 2)
                        (let ((abrupt (aref abrupts ab-idx)))
                          (js-call assert :deepEqual
                            (value a "cold-number-order" (js-array ctor abrupt))
                            (aref (get number-oracle :order) ab-idx))
                          (js-call assert :deepEqual
                            (value a "cold-number-snapshot" (js-array ctor boxed))
                            (get number-oracle :snapshot)
                            (str "getter conversion restores all original Number attributes after abrupt=" abrupt)))
                        (setq ab-idx (1+ ab-idx))))
                    (js-call a :resize trace 0)
                    (try
                      (js-call assert :deepEqual
                        (value a "cold-number-mutations" (js-array ctor trace))
                        (get number-oracle :mutations))
                      (js-call assert :deepEqual (read-val a trace) (get number-oracle :mutationTrace))
                      (catch error
                        (let ((mut-trace "unavailable")
                              (st undefined))
                          (try
                            (setq mut-trace (read-val a trace))
                            (setq st (js-call a :stats))
                            (catch _ignored nil))
                          (try
                            (js-call (get globalThis.process :stderr) :write
                              (str "[cold-number-mutation-failure] "
                                   (JSON/stringify (js-object :mode mode :mutationTrace mut-trace :stats st))
                                   "\n"))
                            (catch _ignored nil)))
                        (throw error)))
                    (js-call a :collect)
                    (let ((again (js-call a :invoke "cold-number-value")))
                      (try
                        (funcall assert (js-call a :keyEqual again ctor))
                        (finally (js-call a :release again))))
                    (exact (value a "cold-number-unbox" (js-array boxed)) -0.0
                      "Number constructor mutation and GC preserve existing boxes")
                    (let ((caller (js-call a :frameGet frame 0)))
                      (try
                        (exact (js-call a :readNumber caller) -0.0
                          "Number first observation preserves caller frame")
                        (finally (js-call a :release caller))))
                    (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)))))
            (finally
              (js-call fillers :forEach (lambda (r) (js-call a :release r)))
              (when (not (undefined? frame))
                (js-call a :leaveFrame frame))
              (js-call roots :forEach (lambda (r) (js-call a :release r)))
              (finish a))))
        (setq mode (1+ mode)))))

  (test "cold Number boxing defers unrelated statics while every first observation publishes the complete native property contract"
    (lambda () (check-cold-numbers (lambda () (instantiateManagedRuntime number-bytes))))
    30000)

  (funcall (js-call test :skipIf (not native-target))
    "actual native cold Number boxing and first static reflection preserve descriptors aliases errors and collecting roots"
    (lambda ()
      (check-cold-numbers
        (lambda ()
          (instantiateNativeManagedRuntime number-native-path number-lowered
            (js-object :nativeTarget native-target)))))
    30000)

  (test "Given Math as an ordinary value when passed read and reflected then globals aliases descriptors and canonical methods agree"
    (lambda () (with-wasm (lambda (a) (check-namespace a reference)))))

  (test "Given a mutable Math namespace when members are overridden deleted or captured before arguments then original lookup and GC semantics remain observable"
    (lambda () (with-wasm (lambda (a) (check-mutations a reference)))))

  (test "Given primitive IEEE and string inputs when abs sign and clz32 execute then direct dynamic and missing-argument semantics match native Math"
    (lambda () (with-wasm check-unary)))

  (test "Given signed and unsigned word boundaries when imul converts two operands then exact low-32 multiplication and missing arguments match Math.imul"
    (lambda () (with-wasm check-imul)))

  (test "Given effectful conversions and throws when Math methods run then argument effects precede number-hint conversion and first errors preserve identity"
    (lambda () (with-wasm (lambda (a) (check-conversions a reference)))))

  (test "Given binary32 midpoints overflow and subnormal boundaries when fround runs then every result exactly matches Object.is with Math.fround"
    (lambda () (with-wasm (lambda (a) (check-fround a (fround-boundaries))))))

  (test "Given fixed seeded binary64 and binary32 bit samples when direct dynamic and held fround run then each result is exact through collecting GC"
    (lambda () (with-wasm (lambda (a) (check-fround a (fround-random))))))

  (test "Given binary16 ties subnormals overflow and double-rounding counterexamples when f16round executes then exact bits agree with an independent integer model without a host API fallback"
    (lambda () (with-wasm check-f16)))

  (test "Given the host Math.sumPrecise API when exact cancellation and observable iterators run then the host independently conforms to the precise integer model"
    check-host-sum-oracle)

  (test "Given precise finite cancellation and observable iterators when sumPrecise executes then single-round results Number-only rejection closing and first errors preserve the original default-budget contract"
    (lambda () (with-wasm check-sum-precise)))

  (test "Given default-budget exhaustion during a Math call when caller roots survive then frames unwind and later numeric calls recover"
    (lambda () (with-wasm check-pressure)))

  (test "Given a frozen Math namespace when reflected and called then descriptor failures and numeric results match an isolated JS realm"
    (lambda () (with-wasm (lambda (a) (check-freeze a frozen-reference)))))

  (funcall (js-call test :skipIf (not native-target))
    "Given the same complete Math fixture in actual native machine code when all semantic groups execute then the WASM contracts and original default budget remain intact"
    (async ()
      (let ((a (await (instantiateNativeManagedRuntime native-path lowered
                        (js-object :nativeTarget native-target)))))
        (js-call a :auto 1)
        (try
          (check-math-composite a reference frozen-reference (str "actual-native/" native-target))
          (finally (finish a)))))
    120000)

  (test "Given the identical zero-import WASM in independent Node when the complete Math semantic groups execute then JS and WASM agree without a compiler fallback"
    (lambda ()
      (let ((child (spawnSync "node"
                     (js-array math-node-helper-path "--math-composite"
                               (get (pathToFileURL reference-path) :href)
                               wasm-path
                               (JSON/stringify frozen-reference))
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :status) 0 (get child :stderr))))
    30000)

  (test "sqrt supports cold static global computed and held reads and exact binary64 results in real WASM"
    (lambda ()
      (let ((first 0))
        (while (< first 3)
          (let ((a (instantiateManagedRuntime sqrt-bytes)))
            (try
              (check-sqrt-access a sqrt-reference first)
              (finally (finish a))))
          (setq first (1+ first)))))
    30000)

  (test "sqrt conversions call apply bind callbacks descriptors mutations and nonconstruction match the original JS"
    (lambda ()
      (let ((a (instantiateManagedRuntime sqrt-bytes)))
        (try
          (check-sqrt-semantics a sqrt-reference)
          (finally (finish a)))))
    30000)

  (test "sqrt preserves caller roots thrown identity and exact recovery at the original default capacity"
    (lambda ()
      (let ((a (instantiateManagedRuntime sqrt-bytes)))
        (try
          (check-sqrt-pressure a)
          (finally (finish a)))))
    30000)

  (funcall (js-call test :skipIf (not native-target))
    "actual native sqrt shares exact f64 access conversion and capacity semantics"
    (async ()
      (let ((checks (js-array
                      (lambda (a) (check-sqrt-access a sqrt-reference 0))
                      (lambda (a) (check-sqrt-access a sqrt-reference 1))
                      (lambda (a) (check-sqrt-access a sqrt-reference 2))
                      (lambda (a) (check-sqrt-semantics a sqrt-reference))
                      check-sqrt-pressure))
            (idx 0))
        (while (< idx (get checks :length))
          (let ((a (await (instantiateNativeManagedRuntime sqrt-native-path sqrt-lowered
                            (js-object :nativeTarget native-target)))))
            (try
              (funcall (aref checks idx) a)
              (finally (finish a))))
          (setq idx (1+ idx)))))
    30000)

  (test "independent Node compares every sqrt family assertion with the same generated JS and real WASM bytes"
    (lambda ()
      (let ((child (spawnSync "node"
                     (js-array math-node-helper-path "--sqrt"
                               (get (pathToFileURL sqrt-reference-path) :href)
                               sqrt-wasm-path)
                     (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get child :error) undefined
          (let ((err (get child :error))) (if (nullish? err) undefined (get err :message))))
        (js-call assert :equal (get child :signal) nil (get child :stderr))
        (js-call assert :equal (get child :status) 0 (get child :stderr))
        (js-call assert :deepEqual (JSON/parse (get child :stdout)) (js-object :sqrt t))))
    30000))
