(module tests.compiler-worker-identities
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:crypto" createHash)
  (import "../tools/backends/compiler-worker.mjs" compilerRequestIdentity compilerSourceIdentity)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defun reference (text) (js-call (js-call (createHash "sha256") :update (Buffer/from text "utf16le")) :digest "hex"))
  (test "worker request identities retain exact UTF16LE bytes across fixed buffer boundaries and concurrent requests" (async ()
    (let ((texts (js-array "" "\0" "\ufeff" "\ud800" "\udfff" "😀" "中文\0😀\ud800x\udc00")))
      (js-call (js-array 32765 32766 32767 32768 32769 65535 65536 65537 131075) :forEach
        (lambda (size) (js-call texts :push (str (js-call "x" :repeat size) "😀\ud800\0\udc00中文"))))
      (let ((actual (await (Promise/all (js-call texts :map (lambda (text) (compilerRequestIdentity text)))))))
        (js-call assert :deepEqual actual (js-call texts :map reference)))
      (let* ((object (js-object :operation "compile" :source (js-call texts :at -1) :filename "原文😀\ud800.eli" :values (js-array (js* "-0") globalThis.Number.MIN_VALUE globalThis.Infinity undefined) :ignored undefined))
             (text (JSON/stringify object)))
        (js-call assert :equal (await (compilerRequestIdentity object)) (reference text))
        (js-call assert :equal (await (compilerRequestIdentity text)) (reference text)))
      (let ((reads 0) (input (js-object :operation "compile")))
        (Object/defineProperty input "source" (js-object :configurable t :enumerable t :get (lambda () (setq reads (1+ reads)) (js-call texts :at -1))))
        (let ((expected (reference (JSON/stringify input))))
          (setq reads 0)
          (let ((pending (compilerRequestIdentity input)))
            (js-call assert :equal reads 1) (put input :operation "edited-after-dispatch")
            (js-call assert :equal (await pending) expected) (js-call assert :equal reads 1)))))))
  (test "worker source identities preserve canonical field selection explicit library inputs and edit preview source rules" (async ()
    (let* ((source (str (js-call "x" :repeat 32767) "😀\ud800\0\udc00")) (filename "source/中文😀.eli")
           (macroContext (js-object :capabilities (js-array "files") :files (js-array (js-object :specifier "./macro.eli" :content source))))
           (expected (reference (JSON/stringify (js-object :filename filename :source source :macroContext macroContext))))
           (base (js-object :source source :filename filename :macroContext macroContext))
           (operations (js-array "compile" "compile-ir" "analyze" "query" "edit-preview" "format" "stage")) (index 0))
      (while (< index (js-length operations))
        (let* ((operation (aref operations index))
               (request (copyHostRecord base (js-object :operation operation :literalSources (js-array (js-object :id "unused" :filename "unused.eli" :source "ignored")) :target "native" :nativeTarget "arm64-linux" :debug t))))
          (js-call assert :equal (await (compilerSourceIdentity request)) expected operation)
          (js-call assert :equal (await (compilerSourceIdentity (JSON/stringify request))) expected (str operation " encoded")))
        (setq index (1+ index)))
      (let* ((libraries (js-array (js-object :id "runtime/a.mjs" :filename "library.eli" :source source)))
             (runtime (copyHostRecord base (js-object :operation "runtime" :literalSources libraries)))
             (runtimeExpected (reference (JSON/stringify (js-object :filename filename :source source :macroContext macroContext :literalSources libraries)))))
        (js-call assert :equal (await (compilerSourceIdentity runtime)) runtimeExpected)
        (js-call assert :notEqual runtimeExpected expected)
        (js-call assert :notEqual (await (compilerSourceIdentity (copyHostRecord runtime (js-object :literalSources (js-array))))) runtimeExpected))
      (let* ((project (js-object :operation "project" :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :source source))))
             (projectExpected (reference (JSON/stringify (js-object :entry "entry.mjs" :modules (js-array (js-object :id "entry.mjs" :filename "entry.mjs" :source source :macroContext (js-object :capabilities (js-array) :files (js-array)))) :hostSources (js-array) :hostModules (js-array))))))
        (js-call assert :equal (await (compilerSourceIdentity project)) projectExpected)))))
  (test "worker identity hashing avoids whole-message WebCrypto while retaining unavailable-host and original input error contracts" (async ()
    (let ((descriptor (Object/getOwnPropertyDescriptor (js* "globalThis") "crypto")))
      (try
        (let ((calls 0))
          (Object/defineProperty (js* "globalThis") "crypto" (js-object :configurable t :value (js-object :subtle (js-object :digest (lambda () (setq calls (1+ calls)) (throw (new globalThis.Error "worker identity must not submit a whole-message byte snapshot")))))))
          (let* ((text (js-call "中文😀\ud800" :repeat 12000)) (source (js-object :operation "compile" :source text :filename "input.eli")))
            (js-call assert :equal (await (compilerRequestIdentity text)) (reference text)) (js-call assert :equal calls 0)
            (js-call assert :equal (await (compilerSourceIdentity source)) (reference (JSON/stringify (js-object :filename "input.eli" :source text :macroContext (js-object :capabilities (js-array) :files (js-array))))))
            (js-call assert :equal calls 0)
            (let ((cryptos (js-array undefined nil (js-object) (js-object :subtle undefined) (js-object :subtle nil) (js-object :subtle false))) (index 0))
              (while (< index (js-length cryptos))
                (Object/defineProperty (js* "globalThis") "crypto" (js-object :configurable t :value (aref cryptos index)))
                (let ((requests (js-array (lambda () (compilerRequestIdentity "")) (lambda () (compilerSourceIdentity source)))) (requestIndex 0))
                  (while (< requestIndex 2)
                    (await (js-call assert :rejects (aref requests requestIndex) (lambda (error) (and (= (get error :name) "CompilerWorkerError") (= (get error :code) "unavailable-identity") (= (get error :message) "SHA-256 is unavailable in this host")))))
                    (setq requestIndex (1+ requestIndex))))
                (setq index (1+ index))))
            (let ((reasons (js-array undefined false (js-object :original t) (new globalThis.Error "original input"))) (index 0))
              (while (< index (js-length reasons))
                (let ((reason (aref reasons index)) (caught false))
                  (try (await (compilerRequestIdentity (js-object :toJSON (lambda () (throw reason))))) (catch error (setq caught t) (js-call assert :strictEqual error reason)))
                  (funcall assert caught "input encoding failures retain priority over unavailable crypto")
                  (setq caught false)
                  (let ((input (js-object)))
                    (Object/defineProperty input "source" (js-object :configurable t :enumerable t :get (lambda () (throw reason))))
                    (try (await (compilerSourceIdentity input)) (catch error (setq caught t) (js-call assert :strictEqual error reason))))
                  (funcall assert caught))
                (setq index (1+ index))))))
        (finally (if descriptor (Object/defineProperty (js* "globalThis") "crypto" descriptor) (Reflect/deleteProperty (js* "globalThis") "crypto")))))))
)
