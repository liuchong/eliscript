(module tests.wasm-managed-temporary-root-cleanup.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/compiler/controlled-baseline.mjs" definition)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/managed-temporary-roots.mjs"
    closeTemporaryRootRuntime exerciseTemporaryRootPressure exerciseTemporaryRootValues
    initializeTemporaryRootRuntime temporaryRootOptions temporaryRootSource)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defconst depths (js-array 8 16 32 64))

  (defun build-nested (depth)
    (let ((value "(js-array -0.0)")
          (idx 0))
      (while (< idx depth)
        (setq value (str "(let* ((a (js-array)) (b " value ")) b)"))
        (setq idx (+ idx 1)))
      value))

  (defconst boundary-source
    (str "\n"
         "(defun branch-rhs (flag)\n"
         " (let ((out (if flag (let* ((a (js-array -0.0)) (b (js-array a))) (get b 0))\n"
         "                         (let* ((a (js-array 7)) (b a)) b))))\n"
         "  (js-array (get out 0) (get out :length))))\n"
         "(defun short-rhs (flag)\n"
         " (let ((out (or (and flag (let* ((a (js-array -0.0)) (b a)) b))\n"
         "                 (let* ((a (js-array 9)) (b a)) b))))\n"
         "  (js-array (get out 0) (get out :length))))\n"
         "(defun recur-rhs (count)\n"
         " (let ((out (loop ((index count) (value (js-array -0.0)))\n"
         "              (if (= index 0) value\n"
         "                (let* ((next (js-array (+ (get value 0) 1))))\n"
         "                 (recur (1- index) next))))))\n"
         "  (js-array (get out 0) (get out :length))))\n"
         "(defun while-rhs (count)\n"
         " (let ((out (let ((index count) (value (js-array -0.0)))\n"
         "              (while (> index 0)\n"
         "               (let* ((next (js-array (+ (get value 0) 1))))\n"
         "                (setq value next index (1- index)))) value)))\n"
         "  (js-array (get out 0) (get out :length))))\n"
         "(defun caught-rhs (flag)\n"
         " (let* ((out (try\n"
         "              (let* ((inner (js-array (js-array 7) (if flag (throw false) -0.0)))\n"
         "                     (result (js-array inner))) result)\n"
         "              (catch error (js-array error))))\n"
         "        (stress (make-large)))\n"
         "  (js-array (get out :length) (get stress :length))))\n"
         "(defun global-rhs ()\n"
         " (let* ((out (setq saved (let* ((a (js-array -0.0)) (b a)) b)))\n"
         "        (stress (make-large))) out))\n"
         "(export branch-rhs short-rhs recur-rhs while-rhs caught-rhs global-rhs)\n"))

  (defvar directory nil)
  (defvar backend nil)
  (defvar private-helpers nil)
  (defvar lowered nil)
  (defvar bytes nil)
  (defvar reference nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-root-cleanup-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (let* ((production (await (readFile "bootstrap/backends/managed.eli" "utf8")))
             (names (js-array
                      "managed-fail" "word-node" "word-constant" "word-local" "word-set" "word-sequence"
                      "word-compare" "word-if" "append-managed" "runtime-call" "runtime-arguments" "capture-error"
                      "managed-guard" "checked-control" "managed-temporary-root-count" "managed-temporary-root-barrier-p"
                      "enter-managed-temporary-root-rhs" "clear-managed-temporary-roots"))
             (helpers (str "(module root.cleanup.helpers\n(import "
                           (JSON/stringify (get (pathToFileURL (resolve directory "backends/numeric.mjs")) :href))
                           " backend-fail find-function)\n"
                           (js-call (js-call names :map (lambda (name) (definition production (str name " ")))) :join "\n")
                           "\n(export managed-temporary-root-count managed-temporary-root-barrier-p enter-managed-temporary-root-rhs clear-managed-temporary-roots))")))
        (setq private-helpers
          (await (funcall dynamic-import
                   (str "data:text/javascript;base64,"
                        (js-call (Buffer/from (js-call (get backend :compiler) :compile_string helpers "root-cleanup-helpers.eli")) :toString "base64")))))
        (let* ((source (str temporaryRootSource boundary-source
                            (js-call
                              (js-call depths :map
                                (lambda (depth)
                                  (str "\n(defun cleanup-depth-" depth " () " (build-nested depth) ")\n(export cleanup-depth-" depth ")")))
                              :join "")))
               (program (js-call (get backend :compiler) :compile_ir_string source "root-cleanup.eli"))
               (saved (JSON/stringify program))
               (runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli")))
          (setq lowered (js-call (get backend :managed) :lower_managed_program program runtime))
          (js-call assert :equal (JSON/stringify program) saved)
          (let ((raw (js-call (get backend :wasm) :emit_typed_memory_wasm (get lowered :typed) (js-object :initialPages 1 :maximumPages 8))))
            (setq bytes (Uint8Array/from (js-call (get backend :wasm) :append_metadata_section raw "eliscript-managed-control" (JSON/stringify (get lowered :descriptor))))))
          (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
          (setq reference
            (await (funcall dynamic-import
                     (str "data:text/javascript;base64,"
                          (js-call (Buffer/from (js-call (get backend :compiler) :emit_ir_string program)) :toString "base64"))))))))
    120000)

  (afterAll
    (async ()
      (setq lowered undefined)
      (setq backend undefined)
      (setq private-helpers undefined)
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun walk-ir (root visit)
    (let ((seen (new globalThis.Set))
          (pending (js-array root)))
      (while (> (length pending) 0)
        (let ((node (js-call pending :pop)))
          (when (not (js-call seen :has node))
            (js-call seen :add node)
            (funcall visit node)
            (let ((idx (- (length (get node :children)) 1)))
              (while (>= idx 0)
                (js-call pending :push (aref (get node :children) idx))
                (setq idx (- idx 1)))))))
      (get seen :size)))

  (defun make-state (roots)
    (js-object
      :temporaryRoots (js-call roots :slice)
      :locals (js-array)
      :roots 99
      :heap (js-object :index 0)
      :error (js-object :index 1)
      :frame (js-object :index 2)
      :runtime (js-array
                 (js-object :name "frame-set" :index 101)
                 (js-object :name "frame-clear-range" :index 102)
                 (js-object :name "last-error" :index 103))))

  (test "private completed RHS consumption preserves prefix suffix frame indices and snapshot invalidation while barriers retain original cleanup coverage"
    (lambda ()
      (let* ((original (js-array 10 12 14 16))
             (ordinary (make-state original))
             (output (js-call private-helpers :clear_managed_temporary_roots ordinary 1 3))
             (cleared (js-array)))
        (js-call assert :deepEqual (get ordinary :temporaryRoots) (js-array 10 16) "a retained assignment result after end remains registered")
        (js-call assert :equal (get ordinary :roots) 99)
        (js-call assert :equal (get ordinary :snapshotRootEpoch) 1)
        (walk-ir output
          (lambda (node)
            (when (and (= (get node :kind) "call") (= (get node :value) 101))
              (js-call cleared :push (get (aref (get node :children) 2) :value)))))
        (js-call assert :deepEqual cleared (js-array 12 14))
        (js-call private-helpers :clear_managed_temporary_roots ordinary 1 2)
        (js-call assert :deepEqual (get ordinary :temporaryRoots) (js-array 10))
        (js-call assert :equal (get ordinary :snapshotRootEpoch) 2)
        (js-call private-helpers :clear_managed_temporary_roots ordinary 1 1)
        (js-call assert :equal (get ordinary :snapshotRootEpoch) 2)
        (let ((conservative (make-state original)))
          (put conservative :temporaryRootCleanupBarrier t)
          (js-call assert :deepEqual (js-call private-helpers :clear_managed_temporary_roots conservative 1 3) output)
          (js-call assert :deepEqual (get conservative :temporaryRoots) original)
          (js-call assert :equal (get conservative :snapshotRootEpoch) 1)))))

  (test "RHS barrier classification covers every current nonlocal IR family through branches and does not inspect metadata or nested function bodies"
    (lambda ()
      (let ((mk-node (lambda (kind &rest __host_default_arguments_1)
    (let* ((children (aref __host_default_arguments_1 0)))
                       (js-object :kind kind :children (if (undefined? children) (js-array) children)))))
            (st (js-object)))
        (js-call (js-array "try-expression" "throw-expression" "loop" "binding-loop" "recur" "await-expression") :forEach
          (lambda (kind)
            (let ((branch (funcall mk-node "conditional"
                            (js-array
                              (funcall mk-node "literal")
                              (funcall mk-node "short-circuit" (js-array (funcall mk-node "literal") (funcall mk-node kind)))
                              (funcall mk-node "literal")))))
              (js-call assert :equal (js-call private-helpers :managed_temporary_root_barrier_p st branch) t kind)
              (let ((previous (js-call private-helpers :enter_managed_temporary_root_rhs st branch)))
                (js-call assert :equal previous false)
                (js-call assert :equal (js-call private-helpers :enter_managed_temporary_root_rhs st (funcall mk-node "literal")) t
                  "the barrier reaches nested RHS boundaries")
                (put st :temporaryRootCleanupBarrier previous)))))
        (let ((ordinary (funcall mk-node "lexical-bindings"
                          (js-array
                            (funcall mk-node "conditional"
                              (js-array (funcall mk-node "literal") (funcall mk-node "literal") (funcall mk-node "literal")))))))
          (Object/defineProperty ordinary "source"
            (js-object :get (lambda () (throw (new globalThis.Error "opaque source metadata must not be read")))))
          (Object/defineProperty ordinary "properties"
            (js-object :get (lambda () (throw (new globalThis.Error "opaque properties must not be read")))))
          (js-call assert :equal (js-call private-helpers :managed_temporary_root_barrier_p (js-object) ordinary) false)
          (js-call assert :equal
            (js-call private-helpers :managed_temporary_root_barrier_p (js-object)
              (funcall mk-node "function-expression" (js-array (funcall mk-node "try-expression"))))
            false))
        (let ((shared (funcall mk-node "literal"))
              (depth 0))
          (while (< depth 28)
            (setq shared (funcall mk-node "conditional" (js-array shared shared)))
            (setq depth (+ depth 1)))
          (js-call assert :equal (js-call private-helpers :managed_temporary_root_barrier_p (js-object) shared) false
            "memoization handles shared source edges without expanding their paths"))
        (js-call assert :equal
          (js-call private-helpers :managed_temporary_root_barrier_p (js-object) (js-object :kind "literal" :children nil))
          t))))

  (defun exported-function (name)
    (let ((item (js-call (get (get lowered :descriptor) :functions) :find (lambda (rec) (= (get rec :name) name)))))
      (funcall assert (not (nullish? item)))
      (let* ((wire (let ((wn (get item :wireName))) (if (nullish? wn) name wn)))
             (alias (js-call (get (get lowered :typed) :aliases) :find (lambda (rec) (= (get rec :name) wire)))))
        (funcall assert (not (nullish? alias)))
        (let ((fn (js-call (get (get lowered :typed) :functions) :find (lambda (rec) (= (get rec :name) (get alias :function))))))
          (funcall assert (not (nullish? fn)))
          fn))))

  (test "actual nested let-star lowering emits each completed private root cleanup once and grows linearly with nesting depth"
    (lambda ()
      (let ((frame-set (get (js-call (get (get lowered :typed) :functions) :find (lambda (fn) (= (get fn :name) "frame-set"))) :index))
            (previous nil))
        (js-call depths :forEach
          (lambda (depth)
            (let* ((cleared (new globalThis.Map))
                   (nodes (walk-ir (get (exported-function (str "cleanup-depth-" depth)) :body)
                            (lambda (node)
                              (let ((c3 (if (and (= (get node :kind) "call") (= (get node :value) frame-set))
                                          (aref (get node :children) 3)
                                          nil)))
                                (when (and (not (nullish? c3)) (= (get c3 :kind) "literal") (= (get c3 :value) 0))
                                  (let* ((root (get (aref (get node :children) 2) :value))
                                         (prev (js-call cleared :get root)))
                                    (js-call cleared :set root (+ (if (nullish? prev) 0 prev) 1)))))))))
              (funcall assert (>= (get cleared :size) depth) "every initialized private array temporary is still cleared")
              (js-call (Array/from cleared) :forEach
                (lambda (entry)
                  (js-call assert :equal (aref entry 1) 1 (str "root " (aref entry 0) " must not be re-cleared by every enclosing RHS"))))
              (when (not (nil? previous))
                (funcall assert (<= nodes (+ (* previous 2) 128))
                  "doubling source nesting has linear IR growth, including local-storage resets"))
              (setq previous nodes)))))))

  (defun read-val (a value)
    (if (and (not (nullish? value)) (= (funcall js-typeof value) "object"))
      (let ((k (get value :kind)))
        (cond
          ((= k 4) (js-call a :readNumber value))
          ((= k 5) (js-call a :readString value))
          ((or (= k 14) (= k 7))
           (let ((output (js-array))
                 (len (js-call a :length value))
                 (idx 0))
             (while (< idx len)
               (let ((child (js-call a :get value idx)))
                 (try
                   (js-call output :push (read-val a child))
                   (finally (js-call a :release child))))
               (setq idx (+ idx 1)))
             output))
          (t value)))
      value))

  (test "original 64-slot pressure capacity recovery captures aliases named temporary bindings and source first errors remain intact"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes temporaryRootOptions)))
        (try
          (initializeTemporaryRootRuntime a)
          (exerciseTemporaryRootPressure a reference)
          (exerciseTemporaryRootValues a reference)
          (finally (closeTemporaryRootRuntime a)))))
    30000)

  (test "actual branches short circuits caught throws while loops and recur preserve caller roots under per-allocation GC and recover after errors"
    (lambda ()
      (let ((a (instantiateManagedRuntime bytes temporaryRootOptions)))
        (initializeTemporaryRootRuntime a)
        (let ((zero (js-call a :number -0.0))
              (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 zero)
          (try
            (js-call (js-array "branch-rhs" "short-rhs" "caught-rhs") :forEach
              (lambda (name)
                (js-call (js-array false t) :forEach
                  (lambda (flag)
                    (let ((value (js-call a :invoke name (js-array flag))))
                      (try
                        (js-call assert :deepEqual
                          (read-val a value)
                          (funcall (aref reference (js-call name :replaceAll "-" "_")) flag))
                        (finally (js-call a :release value))))
                    (js-call a :collect)
                    (funcall assert (Object/is (js-call a :readNumber zero) -0.0))
                    (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)))))
            (js-call (js-array "while-rhs" "recur-rhs") :forEach
              (lambda (name)
                (js-call (js-array 0 8) :forEach
                  (lambda (cnt)
                    (let ((input (js-call a :number cnt))
                          (value undefined))
                      (try
                        (setq value (js-call a :invoke name (js-array input)))
                        (js-call assert :deepEqual
                          (read-val a value)
                          (funcall (aref reference (js-call name :replaceAll "-" "_")) cnt))
                        (finally
                          (js-call a :release value)
                          (js-call a :release input))))
                    (js-call a :collect)
                    (funcall assert (Object/is (js-call a :readNumber zero) -0.0))
                    (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)))))
            (let ((stored (js-call a :invoke "global-rhs"))
                  (again undefined))
              (try
                (js-call a :collect)
                (setq again (js-call a :invoke "read-global"))
                (funcall assert (js-call a :keyEqual stored again))
                (js-call assert :deepEqual (read-val a again) (js-array -0.0))
                (finally
                  (js-call a :release again)
                  (js-call a :release stored))))
            (js-call (js-array "initializer-first-error" "assignment-first-error") :forEach
              (lambda (name)
                (let ((value (js-call a :invoke name)))
                  (try
                    (js-call assert :deepEqual
                      (read-val a value)
                      (funcall (aref reference (js-call name :replaceAll "-" "_"))))
                    (finally (js-call a :release value))))))
            (let ((recovered (js-call a :invoke "initializer-release")))
              (try
                (js-call assert :equal (js-call a :readNumber recovered) 8192)
                (finally (js-call a :release recovered))))
            (funcall assert (Object/is (js-call a :readNumber zero) -0.0))
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (finally
              (js-call a :leaveFrame frame)
              (js-call a :release zero)
              (closeTemporaryRootRuntime a))))))
    30000))
