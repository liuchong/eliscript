(module tests.record.test
  (import "bun:test" expect test)
  (import "../runtime/core/collection.mjs" :as Collection)
  (import "../runtime/core/identifier.mjs" keyword)
  (import "../runtime/core/map.mjs" isPersistentHashMap persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/protocol.mjs" defineProtocol extendProtocolType protocolMethod)
  (import "../runtime/core/record.mjs" defineRecordType isRecord isRecordType recordFieldNames recordType recordTypeName)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (defconst NAME (keyword "name")) (defconst AGE (keyword "age")) (defconst ROLE (keyword "role"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun yes (actual) (js-call (expect actual) :toBeTrue))
  (defun no (actual) (js-call (expect actual) :toBeFalse))
  (defun rejects (operation &rest __host_default_arguments_1)
    (let* ((expected (aref __host_default_arguments_1 0))) (if (= expected undefined) (js-call (expect operation) :toThrow) (js-call (expect operation) :toThrow expected))))
  (test "record types provide immutable positional and map construction" (lambda ()
    (let* ((Person (defineRecordType "Person" (js-array "name" "age"))) (ada (js-call Person :create "Ada" 36)))
      (yes (isRecordType Person)) (yes (isRecord ada)) (be (recordType ada) Person) (be (recordTypeName Person) "Person") (be (recordTypeName ada) "Person")
      (same (recordFieldNames ada) (js-array "name" "age")) (yes (Object/isFrozen (recordFieldNames ada))) (yes (Object/isFrozen ada))
      (be (get ada :name) "Ada") (be (get ada :age) 36)
      (rejects (lambda () (js-call Person :create "Ada")) "->Person expects 2 values, received 1")
      (rejects (lambda () (new Person)) "Person values must be created with its record constructors")
      (let* ((source (persistentHashMap (js-array NAME "Grace") (js-array ROLE "engineer"))) (grace (js-call Person :fromMap source)))
        (be (get grace :name) "Grace") (js-call (expect (get grace :age)) :toBeNull)
        (be (js-call Collection :get grace ROLE) "engineer") (no (js-call source :has AGE))))))
  (test "records participate in persistent map operations" (lambda ()
    (let* ((Person (defineRecordType "Person" (js-array "name" "age"))) (ada (js-call Person :create "Ada" 36))
           (older (js-call Collection :assoc ada AGE 37)) (enriched (js-call Collection :conj older (js-array ROLE "mathematician"))))
      (be (js-call Collection :count ada) 2) (be (js-call Collection :get ada NAME) "Ada") (be (js-call Collection :get ada ROLE "missing") "missing")
      (yes (js-call Collection :contains enriched ROLE)) (js-call (get (expect older) :not) :toBe ada)
      (be (get older :age) 37) (be (get ada :age) 36) (yes (isRecord enriched)) (be (js-call Collection :count enriched) 3)
      (js-call (get (expect (js-call Collection :seq enriched)) :not) :toBeNull)
      (be (js-call Collection :reduceKV enriched (lambda (total) (1+ total)) 0) 3) (yes (js-call Collection :isMap enriched))
      (let ((withoutExtra (js-call Collection :dissoc enriched ROLE)))
        (yes (isRecord withoutExtra)) (be (get withoutExtra :name) "Ada") (be (get withoutExtra :age) 37))
      (let ((withoutDeclaredField (js-call Collection :dissoc enriched NAME)))
        (no (isRecord withoutDeclaredField)) (yes (isPersistentHashMap withoutDeclaredField)) (no (js-call Collection :contains withoutDeclaredField NAME))
        (be (js-call Collection :get withoutDeclaredField ROLE) "mathematician"))
      (yes (isPersistentHashMap (js-call Collection :empty enriched))) (be (js-call Collection :count (js-call Collection :empty enriched)) 0))))
  (test "records have type-sensitive value semantics and metadata" (lambda ()
    (let* ((Person (defineRecordType "Person" (js-array "name" "age"))) (OtherPerson (defineRecordType "Person" (js-array "name" "age")))
           (left (js-call Person :create "Ada" 36)) (right (js-call Person :create "Ada" 36)) (other (js-call OtherPerson :create "Ada" 36))
           (metadata (persistentHashMap (js-array (keyword "source") "test"))) (located (withMeta left metadata)))
      (yes (equalValues left right)) (be (hashValue left) (hashValue right)) (no (equalValues left other)) (no (equalValues left (js-call left :toPersistentMap)))
      (js-call (expect (meta left)) :toBeNull) (be (meta located) metadata) (yes (equalValues left located))
      (be (meta (js-call Collection :dissoc (js-call Collection :assoc located ROLE "engineer") ROLE)) metadata)
      (be (meta (js-call Collection :dissoc located NAME)) metadata))))
  (test "record constructors are exact protocol extension targets" (lambda ()
    (let* ((Person (defineRecordType "Person" (js-array "name"))) (IDescribe (defineProtocol "IDescribeRecord" (js-array "describe")))
           (describe (protocolMethod IDescribe "describe")))
      (extendProtocolType IDescribe Person (js-object :describe (lambda (person) (str "person:" (get person :name)))))
      (be (funcall describe (js-call Person :create "Ada")) "person:Ada") (rejects (lambda () (funcall describe (js-object :name "Ada")))))))
  (test "record definitions reject ambiguous layouts" (lambda ()
    (rejects (lambda () (defineRecordType "" (js-array))) "record type name must be a non-empty string")
    (rejects (lambda () (defineRecordType "Bad" (js-array "x" "x"))) "record declares duplicate field x")
    (rejects (lambda () (defineRecordType "Bad" (js-array "get"))) "record field get conflicts with a record member")
    (rejects (lambda () (recordType (js-object))) "expected an Eliscript record")))
)
