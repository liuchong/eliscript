(module tests.compiler-portable-reader.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" readFile readdir mkdtemp mkdir writeFile rm)
  (import "node:path" resolve relative)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "./helpers/reader-host-oracle.mjs" whitespace delimiter skip token observeTrace)
  (import "./helpers/reader-runtime-contract.mjs" box decode state readState start finish)
  (defconst names (js-array "native-whitespace-code-p" "native-delimiter-code-p" "native-skip-space-and-comments" "native-read-token"))
  (defconst oracles (js-array whitespace delimiter skip token))
  (defvar directory undefined) (defvar b undefined) (defvar runtime undefined) (defvar program undefined) (defvar reference undefined) (defvar javascript undefined)
  (defconst supportSource "(defun reader-whitespace () native-whitespace-code-p) (defun reader-delimiter () native-delimiter-code-p)\n (defun reader-skip (state) (native-skip-space-and-comments state native-whitespace-code-p))\n (defun reader-token (state start) (native-read-token state start native-delimiter-code-p))\n (defun reader-answer (value) (lambda (code) (if (eq code undefined) t value)))\n (defun reader-changing (state trace answer) (lambda (code) (put trace :called (+ (aref trace \"called\") 1)) (put state :offset 100) (put state :column 200) (if (eq code undefined) t answer)))\n (defun reader-effect (trace) (lambda (code) (put trace :called t) false))\n (defun reader-exhaust (trace) (lambda (code) (put trace :called t) (js-call \"x\" :padEnd 16384)))\n (defun reader-extra-skip (state trace) (native-skip-space-and-comments state native-whitespace-code-p (put state :index 1) (put trace :called t)))\n (defun reader-extra-token (state start trace) (native-read-token state start native-delimiter-code-p (put state :index 1) (put trace :called t)))\n (defun reader-extra-predicate (trace) (native-whitespace-code-p (progn (js-call trace :push 0) 32) (js-call trace :push 1)))\n (export reader-whitespace reader-delimiter reader-skip reader-token reader-answer reader-changing reader-effect reader-exhaust reader-extra-skip reader-extra-token reader-extra-predicate)")
  (defconst hostImport (js* "(specifier) => import(specifier)"))
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun each (values action) (js-call values :forEach action))
  (defun throws (action kind &rest __host_forwarded_arguments_3)
    (let* ((message (aref __host_forwarded_arguments_3 0))) (js-call assert :throws action kind message)))
  (defun diagnostic (code) (lambda (error) (and (not (nullish? error)) (not (nullish? (get error :eliscriptDiagnostic))) (= (get (get error :eliscriptDiagnostic) :code) code))))
  (defun release (a values) (each values (lambda (v) (js-call a :release v))))
  (defun collect (a) (js-call a :collect))
  (defun adapterName (name) (str "reader-invoke-" name))
  (defun flatten (nodes)
    (js-call nodes :flatMap (lambda (node) (if (= (get node :kind) "module-declaration") (flatten (get node :children)) (js-array node)))))
  (defun placeholders () (js-call (js-call names :map (lambda (name) (str "(defun " name " (&rest ignored) nil)"))) :join " "))
  (defun compilerIR (source filename) (js-call (get b :compiler) :compile_ir_string source filename))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-portable-reader-"))) b (await (buildBackends (js-object :outputRoot directory)))
      runtime (compilerIR (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (let* ((source (compilerIR (await (readFile "bootstrap/compiler/reader.eli" "utf8")) "reader.eli")) (nodes (flatten (get source :body)))
           (adaptersSource (js-call (js-call names :map (lambda (name) (str "(defun " (adapterName name) " (&rest args) (apply " name " args))"))) :join " "))
           (adapters (js-call (flatten (get (compilerIR (str (placeholders) adaptersSource) "reader-adapters.eli") :body)) :filter
             (lambda (node) (and (= (get node :kind) "function-declaration") (not (js-call names :includes (get node :value))))))))
      (setq program (Object/assign (js-object) source (js-object :body (js-call names :map (lambda (name)
        (let ((node (js-call nodes :find (lambda (node) (and (= (get node :value) name) (js-call (js-array "function-declaration" "variable-declaration") :includes (get node :kind)))))))
          (assert node name) (globalThis.structuredClone node)))))))
      (put program :body (js-call (get program :body) :concat adapters (js-array (js-object :kind "export-declaration" :span nil :value nil
        :children (js-call (js-call names :concat (js-call names :map adapterName)) :map (lambda (value) (js-object :kind "reference" :span nil :value value :children (js-array))))))))
      (setq javascript (js-call (get b :compiler) :emit_ir_string program)
        reference (await (funcall hostImport (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun artifact (&rest __host_default_arguments_1)
    (let* ((p (aref __host_default_arguments_1 0)) (rt (aref __host_default_arguments_1 1)))
    (when (= p undefined) (setq p program)) (when (= rt undefined) (setq rt runtime))
    (let* ((saved (JSON/stringify p)) (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm p rt))))
      (eqv (JSON/stringify p) saved) (same (WebAssembly.Module/imports (new (get globalThis.WebAssembly :Module) bytes)) (js-array)) bytes)))
  (defun instance (&rest __host_forwarded_arguments_4)
    (let* ((p (aref __host_forwarded_arguments_4 0)) (rt (aref __host_forwarded_arguments_4 1)) (options (aref __host_forwarded_arguments_4 2)))
    (let* ((bytes (artifact p rt)) (a (instantiateManagedRuntime bytes options))) (js-call a :auto 1) (js-object :a a :bytes bytes))))
  (defun withSupport ()
    (let* ((extra (flatten (get (compilerIR (str (placeholders) supportSource) "reader-support.eli") :body)))
           (decls (js-call extra :filter (lambda (node) (and (not (= (get node :kind) "export-declaration")) (not (js-call names :includes (get node :value)))))))
           (exports (js-call extra :find (lambda (node) (= (get node :kind) "export-declaration")))))
      (Object/assign (js-object) program (js-object :body
        (js-call (js-call (get program :body) :filter (lambda (node) (not (= (get node :kind) "export-declaration")))) :concat decls
          (js-array (Object/assign (js-object) exports (js-object :children
            (js-call (get (js-call (get program :body) :at -1) :children) :concat (get exports :children))))))))))
  (defun expectedState (source &rest __host_default_arguments_2)
    (let* ((index (aref __host_default_arguments_2 0)))
    (when (= index undefined) (setq index 0)) (js-object :source source :index index :offset 11 :line 3 :column 7)))
  (defun readerFn (mode) (get reference (if (= mode "skip") "native_skip_space_and_comments" "native_read_token")))
  (test "Given the original const-arrow helpers, when used as callable values, then required arity and nonconstructibility remain unchanged" (lambda ()
    (each (js-array (js-array (aref names 0) 1) (js-array (aref names 1) 1) (js-array (aref names 2) 2) (js-array (aref names 3) 3))
      (lambda (pair) (let* ((name (aref pair 0)) (fn (get reference (js-call name :replaceAll "-" "_"))))
        (eqv (get fn :length) (aref pair 1)) (eqv (Object/hasOwn fn "prototype") false name)
        (throws (lambda () (Reflect/construct globalThis.String (js-array) fn)) globalThis.TypeError name))))))
  (test "Given a replaced global Boolean, when the whitespace callback succeeds, then native JS truth remains independent of that mutable binding" (lambda ()
    (let ((original globalThis.Boolean) (calls 0))
      (try
        (put (js* "globalThis") :Boolean (lambda () (setq calls (1+ calls)) false))
        (let* ((actual (js-object :source " x" :index 0 :offset 0 :line 1 :column 1)) (expected (Object/assign (js-object) actual)))
          (skip expected whitespace) (js-call reference :native_skip_space_and_comments actual whitespace) (same actual expected) (eqv calls 0))
        (finally (put (js* "globalThis") :Boolean original))))))
  (test "Given private boolean loop flags, when reader helpers emit JS, then loop guards compare false directly while callbacks retain native JS truth" (lambda ()
    (assert (not (js-call javascript :includes "__eliscript_truthy(done)")) javascript)
    (eqv (get (or (js-call javascript :match (new globalThis.RegExp "done === false" "g")) (js-array)) :length) 2)
    (eqv (get (or (js-call javascript :match (new globalThis.RegExp "!!answer" "g")) (js-array)) :length) 2)
    (assert (not (js-call javascript :includes "globalThis.Boolean")))))
  (test "Given original four reader helpers, when independently lowered, then raw host algorithms are unnecessary" (lambda ()
    (each names (lambda (name i) (eqv (get (get reference (js-call name :replaceAll "-" "_")) :length) (get (aref oracles i) :length) (str "original helper arity: " name))))
    (let ((a (get (instance) :a))) (finish a (js-array) (js-call (get program :body) :some (lambda (node) (= (get node :kind) "variable-declaration")))))))
  (test "Given the entire scalar range and strict primitive boundaries, when migrated predicates run as JS, then the original raw decisions remain exact" (lambda ()
    (each (js-array undefined nil false t -1 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) (js* "-0") "32" "" (js-object) (js-array) (lambda () 1) (funcall globalThis.Symbol "x") (js* "1n"))
      (lambda (code) (eqv (js-call reference :native_whitespace_code_p code) (whitespace code)) (eqv (js-call reference :native_delimiter_code_p code) (delimiter code))))
    (let ((code 0)) (while (<= code 1114111)
      (eqv (js-call reference :native_whitespace_code_p code) (whitespace code)) (eqv (js-call reference :native_delimiter_code_p code) (delimiter code)) (setq code (1+ code))))))
  (test "Given missing arguments and ignored extras, when the family is invoked in JS and WASM, then undefined remains distinct from null and effects run once" (lambda ()
    (let* ((p (withSupport)) (a (get (instance p) :a)))
      (each (js-array (js-array (aref names 0) whitespace) (js-array (aref names 1) delimiter)) (lambda (pair)
        (let ((name (aref pair 0)) (oracle (aref pair 1)))
          (each (js-array (js-array) (js-array undefined) (js-array nil) (js-array 32 t false) (js-array undefined nil)) (lambda (args)
            (let ((input (js-call args :map (lambda (value) (box a value)))))
              (eqv (js-call a :invoke (adapterName name) input) (Reflect/apply oracle undefined args))
              (eqv (Reflect/apply (get reference (js-call name :replaceAll "-" "_")) undefined args) (Reflect/apply oracle undefined args)) (release a input)))))))
      (each (js-array (js-array (aref names 2) skip (js-array)) (js-array (aref names 2) skip (js-array nil))
        (js-array (aref names 3) token (js-array)) (js-array (aref names 3) token (js-array nil nil nil))) (lambda (row)
          (let ((name (aref row 0)) (oracle (aref row 1)) (args (aref row 2)))
            (throws (lambda () (Reflect/apply oracle undefined args)) globalThis.TypeError)
            (throws (lambda () (Reflect/apply (get reference (js-call name :replaceAll "-" "_")) undefined args)) globalThis.TypeError)
            (throws (lambda () (js-call a :invoke (adapterName name) args)) (lambda (error) (and (not (nullish? error)) (not (nullish? (get error :eliscriptDiagnostic))))))
            (eqv (get (js-call a :stats) :frameDepth) 0))))
      (finish a (js-array)))))
  (test "Given random UTF16 including comments astral pairs and lone surrogates, when source helpers scan, then JS and collecting WASM preserve exact state and token boundaries" (lambda ()
    (let* ((p (withSupport)) (a (get (instance p) :a)) (seed 2175214739)
           (inputs (js-array "" "abc" "\ud83d\ude00token\nnext" "a\ud83d\ude00\u03bb;end" "\t \r\nfoo" ";\ud83d\ude00\u03bb\rcomment\n\nbar" ";trailing \ud83d\ude00" "\f\n;comment\n  :key/value" "foo\ud800bar" "\udfff;\ud800" " \u2028x")))
      (letfn ((next () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223))) seed))
        (let ((k 0)) (while (< k 256)
          (let ((s "") (j 0) (n (mod (next) 32)))
            (while (< j n) (setq s (str s (String/fromCharCode (mod (next) 65536))) j (1+ j)))
            (js-call inputs :push (str (if (= (mod k 3) 0) "" " \t;😀") s "\nend")))
          (setq k (1+ k)))))
      (each inputs (lambda (source)
        (each (js-array 0 (Math/min 1 (get source :length)) (Math/min 2 (get source :length))) (lambda (index)
          (let* ((expected (expectedState source index)) (actual (globalThis.structuredClone expected)) (input (state a source index)))
            (eqv (js-call reference :native_skip_space_and_comments actual whitespace) (skip expected whitespace)) (same actual expected)
            (eqv (js-call a :invoke "reader-skip" (js-array input)) nil) (same (readState a input) expected)
            (let* ((begin (js-object :index (get expected :index))) (wasmStart (start a (get begin :index))) (text (token expected begin delimiter))
                   (jsText (js-call reference :native_read_token actual begin delimiter)) (out (js-call a :invoke "reader-token" (js-array input wasmStart))))
              (eqv jsText text) (eqv (js-call a :readString out) text) (same actual expected) (same (readState a input) expected)
              (release a (js-array input wasmStart out)) (collect a) (eqv (get (js-call a :stats) :frameDepth) 0)))))))
      (finish a (js-array)))))
  (test "Given falsy JS callback results, when scanners branch, then zero NaN and empty strings do not use Lisp truth" (lambda ()
    (let* ((p (withSupport)) (a (get (instance p) :a)))
      (each (js-array undefined nil false t 0 (js* "-0") globalThis.NaN "" "x" 1 -1) (lambda (answer)
        (let* ((boxed (box a answer)) (callback (js-call a :invoke "reader-answer" (js-array boxed))) (input (state a "ab")) (begin (start a 0)) (expected (expectedState "ab")))
          (skip expected (lambda () answer)) (js-call a :invoke (aref names 2) (js-array input callback)) (same (readState a input) expected)
          (let* ((inputToken (state a "ab")) (tokenExpected (expectedState "ab")) (text (token tokenExpected (js-object :index 0) (lambda (code) (if (eq code undefined) t answer))))
                 (out (js-call a :invoke (aref names 3) (js-array inputToken begin callback))))
            (eqv (js-call a :readString out) text) (same (readState a inputToken) tokenExpected)
            (release a (js-array boxed callback input begin inputToken out)) (collect a)))))
      (finish a (js-array)))))
  (test "Given callbacks mutate live state, when scanning commits results, then skip uses snapshots while token adds to the live offset and column" (lambda ()
    (let* ((p (withSupport)) (a (get (instance p) :a)))
      (each (js-array "skip" "token") (lambda (mode)
        (let* ((input (state a "ab")) (trace (js-call a :sourceObject (js-object :called false))) (answer (box a false))
               (cb (js-call a :invoke "reader-changing" (js-array input trace answer))) (begin (start a 0)) (expected (expectedState "ab")) (count 0)
               (callback (lambda (code) (setq count (1+ count)) (put expected :offset 100) (put expected :column 200) (if (eq code undefined) t false))) (out undefined))
          (if (= mode "skip") (progn (skip expected callback) (setq out (js-call a :invoke (aref names 2) (js-array input cb))) (eqv out nil))
            (let ((text (token expected (js-object :index 0) callback))) (setq out (js-call a :invoke (aref names 3) (js-array input begin cb))) (eqv (js-call a :readString out) text)))
          (same (readState a input) expected)
          (let* ((key (js-call a :string "called")) (called (js-call a :objectGet trace key)))
            (eqv (js-call a :readNumber called) count) (release a (js-array input trace answer cb begin out key called)) (collect a)))))
      (finish a (js-array)))))
  (test "Given getter setter method and callback effects, when JS helpers scan, then source caching state snapshots and late start reads retain the exact original order" (lambda ()
    (each (js-array "skip" "token") (lambda (mode)
      (let ((oracle (if (= mode "skip") skip token)) (fn (readerFn mode)))
        (each (js-array (js-object) (js-object :changes t) (js-object :text "😀x " :changes t) (js-object :text "😀x " :answer t)
          (js-object :text " \tx" :answer 0) (js-object :text " \tx" :answer "") (js-object :text " \tx" :answer globalThis.NaN) (js-object :text " ;x\nx" :answer undefined))
          (lambda (options) (same (observeTrace fn mode options) (observeTrace oracle mode options) (str mode ":" (JSON/stringify options))))))))))
  (test "Given throwing fields or callbacks, when the original algorithm aborts, then no later reads writes or slicing happen" (lambda ()
    (each (js-array "skip" "token") (lambda (mode)
      (let ((oracle (if (= mode "skip") skip token)) (fn (readerFn mode)))
        (each (js-array "get.source" "get.index" "get.offset" "get.line" "get.column" "source.length" "source.codePointAt" "source.charCodeAt" "callback"
          "set.index" "set.offset" "set.line" "set.column" "source.slice" "start.index") (lambda (failure)
            (let ((options (js-object :failure failure :text (if (= mode "skip") ";x\n y" "abc "))))
              (same (observeTrace fn mode options) (observeTrace oracle mode options) (str mode ":" failure))))))))))
  (test "Given unusual numeric and string cursor fields, when portable JS scans, then compound assignment and UTF16 indexing preserve original coercion" (lambda ()
    (each (js-array "skip" "token") (lambda (mode)
      (each (js-array 0 1 0.5 -1 (js* "-0") globalThis.Infinity globalThis.NaN "0" "1" t false nil) (lambda (index)
        (each (js-array 0 undefined nil false "10") (lambda (offset)
          (let* ((source (if (= mode "skip") " \t;😀\nx" "a ")) (a (js-object :source source :index index :offset offset :line "2" :column "7"))
                 (r (Object/assign (js-object) a)) (begin (js-object :index 0)) (fn (readerFn mode)) (cb (if (= mode "skip") whitespace delimiter))
                 (x undefined) (y undefined) (xe undefined) (ye undefined) (leftCalls 0) (rightCalls 0)
                 (left (lambda (c) (setq leftCalls (1+ leftCalls)) (or (> leftCalls 4) (cb c))))
                 (right (lambda (c) (setq rightCalls (1+ rightCalls)) (or (> rightCalls 4) (cb c)))))
            (try (setq x (if (= mode "skip") (funcall fn a cb) (funcall fn a begin left))) (catch e (setq xe (get (get e :constructor) :name))))
            (try (setq y (if (= mode "skip") (skip r cb) (token r begin right))) (catch e (setq ye (get (get e :constructor) :name))))
            (eqv xe ye) (assert (Object/is x y)) (same a r))))))))))
  (test "Given live caller roots and allocation pressure, when callbacks exhaust capacity, then state writeback stops and later scans recover" (lambda ()
    (let* ((p (withSupport)) (a (get (instance p runtime (js-object :maxSlots 256 :initialBytes 8192 :maxBytes 16384)) :a))
           (input (state a "abc ")) (trace (js-call a :sourceObject (js-object :called false))) (callback (js-call a :invoke "reader-exhaust" (js-array trace)))
           (saved (js-call a :number (js* "-0"))) (frame (js-call a :frame 1)))
      (js-call a :frameSet frame 0 saved)
      (let ((before (readState a input))) (throws (lambda () (js-call a :invoke (aref names 2) (js-array input callback))) (diagnostic "ELI-RT0002"))
        (eqv (get (js-call a :stats) :frameDepth) 1) (assert (Object/is (js-call a :readNumber saved) (js* "-0"))) (same (readState a input) before))
      (let ((key (js-call a :string "called"))) (eqv (js-call a :objectGet trace key) t) (js-call a :leaveFrame frame)
        (eqv (js-call a :invoke "reader-skip" (js-array input)) nil) (finish a (js-array input trace callback saved key))))))
  (test "Given an actual WASM trap after callback effects, when primitive truth conversion traps, then source frames unwind without committing scanner state" (async ()
    (let* ((p (withSupport)) (text (await (readFile "bootstrap/runtime/memory.eli" "utf8"))) (first (js-call text :indexOf "  (defun value-js-truth "))
           (last (js-call text :indexOf "  (defun value-array-callback-get " first)))
      (assert (and (>= first 0) (> last first)))
      (let* ((injected (compilerIR (str (js-call text :slice 0 first) "  (defun value-js-truth (heap value) (load-u32 4294967295))\n" (js-call text :slice last)) "reader-trap.eli"))
             (a (get (instance p injected) :a)) (input (state a "abc ")) (trace (js-call a :sourceObject (js-object :called false))) (callback (js-call a :invoke "reader-effect" (js-array trace)))
             (saved (js-call a :number (js* "-0"))) (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 saved)
        (let ((before (readState a input))) (throws (lambda () (js-call a :invoke (aref names 2) (js-array input callback))) (get globalThis.WebAssembly :RuntimeError))
          (eqv (get (js-call a :stats) :frameDepth) 1) (assert (Object/is (js-call a :readNumber saved) (js* "-0"))) (same (readState a input) before))
        (let ((key (js-call a :string "called"))) (eqv (js-call a :objectGet trace key) t) (js-call a :leaveFrame frame) (finish a (js-array input trace callback saved key)))))))
  (test "Given represented custom source methods, when scanners run independently, then the original oracle order effects and cursor fields agree and noncallable methods still fail" (lambda ()
    (let* ((p (withSupport))
           (helper (js-call (flatten (get (compilerIR "(defun mock-source-method (trace label) (lambda (index) (put trace :events (+ (aref trace \"events\") label \":\" index \";\")) false)) (export mock-source-method)" "reader-mock-source.eli") :body)) :find
             (lambda (node) (= (get node :kind) "function-declaration")))))
      (js-call (get p :body) :splice (1- (get (get p :body) :length)) 0 helper)
      (js-call (get (js-call (get p :body) :at -1) :children) :push (js-object :kind "reference" :value "mock-source-method" :span nil :children (js-array)))
      (let* ((a (get (instance p) :a)) (empty (js-call a :string "")) (trace (js-call a :sourceObject (js-object :events empty))) (methods (js-array)))
        (each (js-array "point" "unit" "slice") (lambda (label)
          (let ((text (js-call a :string label))) (js-call methods :push (js-call a :invoke "mock-source-method" (js-array trace text))) (js-call a :release text))))
        (let* ((one (js-call a :number 1)) (zero (js-call a :number 0)) (source (js-call a :sourceObject (js-object :length one :codePointAt (aref methods 0) :charCodeAt (aref methods 1) :slice (aref methods 2))))
               (input (js-call a :sourceObject (js-object :source source :index zero :offset zero :line one :column one))) (cb (js-call a :invoke "reader-whitespace"))
               (events (js-array)) (referenceSource (Object/fromEntries (js-call (js-array "point" "unit" "slice") :map (lambda (label i)
                 (js-array (aref (js-array "codePointAt" "charCodeAt" "slice") i) (lambda (index) (js-call events :push (str label ":" index ";")) false))))))
               (expected (js-object :source referenceSource :index 0 :offset 0 :line 1 :column 1)))
          (put referenceSource :length 1)
          (eqv (js-call a :invoke (aref names 2) (js-array input cb)) (skip expected whitespace))
          (let* ((eventsKey (js-call a :string "events")) (actualEvents (js-call a :objectGet trace eventsKey))
                 (actual (readState a input)) (sourceKey (js-call a :string "source")) (retained (js-call a :objectGet input sourceKey))
                 (methodKey (js-call a :string "codePointAt")))
            (eqv (js-call a :readString actualEvents) (js-call events :join "")) (same events (js-array "point:0;"))
            (each (js-array "index" "offset" "line" "column") (lambda (key) (eqv (get actual key) (get expected key))))
            (assert (js-call a :keyEqual retained source)) (js-call a :release retained)
            (js-call a :objectSet source methodKey false) (js-call a :objectSet trace eventsKey empty) (put referenceSource :codePointAt false)
            (throws (lambda () (skip expected whitespace)) globalThis.TypeError)
            (throws (lambda () (js-call a :invoke (aref names 2) (js-array input cb))) (diagnostic "ELI-RT0003"))
            (let ((unchanged (js-call a :objectGet trace eventsKey)))
              (eqv (js-call a :readString unchanged) "")
              (each (js-array "index" "offset" "line" "column") (lambda (key) (eqv (get (readState a input) key) (get expected key))))
              (eqv (get (js-call a :stats) :frameDepth) 0)
              (finish a (js-call (js-array empty trace) :concat methods (js-array one zero source input cb eventsKey actualEvents sourceKey methodKey unchanged))))))))))
  (test "Given source callbacks mutate state and the token start is the same object, when results commit, then start.index is read after index writeback" (lambda ()
    (let* ((p (withSupport)) (a (get (instance p) :a)) (input (state a "abc ")) (trace (js-call a :sourceObject (js-object :called false)))
           (answer (js-call a :number 0)) (cb (js-call a :invoke "reader-changing" (js-array input trace answer))) (out (js-call a :invoke (aref names 3) (js-array input input cb)))
           (expected (expectedState "abc ")) (calls 0)
           (text (token expected expected (lambda (c) (setq calls (1+ calls)) (put expected :offset 100) (put expected :column 200) (if (eq c undefined) t 0)))))
      (eqv (js-call a :readString out) text) (eqv text "") (same (readState a input) expected) (finish a (js-array input trace answer cb out)))))
  (test "Given an independent Node engine, when identical bytes execute reader scans, then original raw algorithms and UTF16 states agree without host imports" (async ()
    (let* ((built (instance (withSupport))) (a (get built :a)) (bytes (get built :bytes)) (file (resolve directory "reader.wasm"))
           (driver (fileURLToPath (new globalThis.URL "./fixtures/reader-portable-host.mjs" (js* "import.meta.url")))))
      (finish a (js-array)) (await (writeFile file bytes))
      (let ((node (spawnSync "node" (js-array driver file) (js-object :encoding "utf8" :timeout 30000)))) (eqv (get node :status) 0 (get node :stderr))))))
  (test "Given all thirteen compiler sources, when public Seed and three complete JS generations compile, then source artifacts reach a fixed point" (async ()
    (let* ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (filename) (js-call filename :endsWith ".eli"))) :sort))
           (compiler (get b :compiler)) (previous (new globalThis.Map)) (i 0))
      (eqv (get files :length) 13)
      (while (< i (get files :length))
        (let ((file (aref files i))) (js-call previous :set file (await (readFile (resolve directory "bootstrap" (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs")) "utf8")))) (setq i (1+ i)))
      (let* ((seedDir (resolve directory "reader-public-seed")) (seedFile (resolve seedDir "reader.mjs")))
        (await (mkdir seedDir))
        (let ((seed (spawnSync (resolve "bin/eliscript-seed") (js-array "--source-map" "--output" seedFile (resolve "bootstrap/compiler/reader.eli")) (js-object :encoding "utf8" :timeout 30000))))
          (eqv (get seed :status) 0 (get seed :stderr)) (eqv (await (readFile seedFile "utf8")) (js-call previous :get "reader.eli"))))
      (let ((generation 2)) (while (<= generation 3)
        (let ((output (resolve directory (str "reader-g" generation))) (j 0))
          (await (mkdir output))
          (while (< j (get files :length))
            (let* ((file (aref files j)) (path (resolve (str "bootstrap/compiler/" file))) (source (await (readFile path "utf8"))) (p (js-call compiler :compile_ir_string source path))
                   (saved (JSON/stringify p)) (generated (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                   (emitted (js-call compiler :emit_ir_string_with_source_map p source generated (relative output path)))
                   (javascript (str (get emitted :javascript) "//# sourceMappingURL=" generated ".map\n")))
              (eqv (JSON/stringify p) saved) (eqv javascript (js-call previous :get file) (str "generation " generation ": " file))
              (await (writeFile (resolve output generated) javascript)) (await (writeFile (resolve output (str generated ".map")) (get emitted :sourceMap))))
            (setq j (1+ j)))
          (setq compiler (await (funcall hostImport (get (pathToFileURL (resolve output "compiler.mjs")) :href)))))
        (setq generation (1+ generation)))))) 30000)
  (test "Given represented string cursor fields, when independent WASM scans, then raw JavaScript += preserves concatenation instead of numeric stepping" (lambda ()
    (let ((a (get (instance (withSupport)) :a)))
      (each (js-array (js-array " \tx" 0 "10" "2" "7") (js-array "\n x" 0 "10" "2" "7") (js-array " \tx" "0" "10" "2" "7")) (lambda (row)
        (let* ((source (aref row 0)) (index (aref row 1)) (offset (aref row 2)) (line (aref row 3)) (column (aref row 4))
               (expected (js-object :source source :index index :offset offset :line line :column column)) (input (state a source index offset line column)))
          (skip expected whitespace) (eqv (js-call a :invoke "reader-skip" (js-array input)) nil) (same (readState a input) expected) (js-call a :release input) (collect a))))
      (finish a (js-array)))))
  (test "Given extra effectful arguments, when each original helper ignores them, then caller effects finish once before state snapshots" (lambda ()
    (let* ((a (get (instance (withSupport)) :a)) (log (js-call a :sourceArray (js-array))))
      (eqv (js-call a :invoke "reader-extra-predicate" (js-array log)) t) (eqv (js-call a :length log) 2)
      (let ((i 0)) (while (< i 2) (let ((value (js-call a :get log i))) (eqv (js-call a :readNumber value) i) (js-call a :release value)) (setq i (1+ i))))
      (each (js-array "skip" "token") (lambda (mode)
        (let* ((input (state a "ab ")) (trace (js-call a :sourceObject (js-object :called false))) (begin (start a 0)) (expected (expectedState "ab "))
               (effects (js-object :called false)) (count 0)
               (extra (lambda () (setq count (1+ count)) (put expected :index 1) 1))
               (mark (lambda () (setq count (1+ count)) (put effects :called t) t)) (output undefined))
          (if (= mode "skip")
            (progn (eqv (Reflect/apply skip undefined (js-array expected whitespace (extra) (mark))) nil)
              (setq output (js-call a :invoke "reader-extra-skip" (js-array input trace))) (eqv output nil))
            (let ((text (Reflect/apply token undefined (js-array expected (js-object :index 0) delimiter (extra) (mark)))))
              (setq output (js-call a :invoke "reader-extra-token" (js-array input begin trace))) (eqv (js-call a :readString output) text)))
          (eqv count 2) (eqv (get effects :called) t) (same (readState a input) expected)
          (let ((key (js-call a :string "called"))) (eqv (js-call a :objectGet trace key) t) (release a (js-array input trace begin output key))))))
      (finish a (js-array log)))))
)
