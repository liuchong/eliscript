(module tests.bootstrap-analyzer
  (import "node:fs" readFileSync)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/diagnostics/check.mjs" diagnosticCorpusSuite)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory caseSource buildBootstrap seedResults loadModule)
  (defconst fixturePath (resolve projectDirectory "tests/fixtures/bootstrap-analyzer.json"))
  (defconst diagnosticCases (get (diagnosticCorpusSuite (JSON/parse (readFileSync (resolve projectDirectory "contracts/diagnostic-corpus.json") "utf8")) "analyzer") :cases))
  (defun generatedResult (readString analyzeModule testCase source)
    (try (funcall analyzeModule (funcall readString source (get testCase :filename)) (get testCase :filename))
      (js-object :name (get testCase :name) :status "ok")
      (catch error (js-object :name (get testCase :name) :status "error" :message (get error :message) :diagnostic (get error :eliscriptDiagnostic)))))
  (test "bootstrapped analyzer matches seed acceptance and diagnostics" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-analyzer-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((reader (await (loadModule directory "reader" "test"))) (analyzer (await (loadModule directory "analyzer" "test")))
               (fixture (JSON/parse (await (readFile fixturePath "utf8"))))
               (cases (js-call (get fixture :valid) :concat (get fixture :invalid))) (generated (js-array)) (index 0))
          (while (< index (js-length cases))
            (let ((testCase (aref cases index)))
              (js-call generated :push (generatedResult (get reader :read_string) (get analyzer :analyze_module) testCase (await (caseSource testCase)))))
            (setq index (1+ index)))
          (js-call (expect generated) :toEqual (await (seedResults "analyzer" fixturePath)))
          (js-call (expect (js-call generated :slice (get (get fixture :valid) :length))) :toEqual
            (js-call diagnosticCases :map (lambda (entry) (js-object :name (get entry :name) :status "error" :message (get entry :human) :diagnostic (get entry :diagnostic)))))
          (js-call (expect (await (readFile (resolve directory "analyzer.mjs.map") "utf8"))) :toContain "bootstrap/compiler/analyzer.eli")
          (let* ((validSources (js-array "(defconst shared 7) (defun f (value) (let ((local value)) (let ((nested local)) (+ shared shared local nested))))" "(defconst shared 7) (defun f () (let* ((before shared) (shared 1) (after shared)) (setq shared (+ shared 1)) [before shared after]))" "(defun f (value) (let ((x-y value)) (let ((x_y x-y)) (+ x-y x_y))))" "(defasync f (promise) (let ((value (await promise))) (let ((next value)) (await next))))" "(defasync f (promise) (let ((value promise)) (async () (let ((next value)) (await next)))))" "(defun f (value) (let* ((a (+ value value)) (b (+ a a))) (if value (recur b) value)))" "(defun f (value) (let ((a value) (b value)) (lambda () (+ a b value))))" "(defun f () [console/log console/log globalThis/Math globalThis/Math])" "(defun f (value) (loop ((step value)) (if step (recur false) step)))" "(defun f () (let () (lambda () (let* () 1))))" "(defconst data '(defportable fake () missing)) (defun f () data)" "(module outer (defconst base 2) (module inner (defportable f (value) (+ value base))))" "(defun helper (value) value) (defun f (value) (helper (helper value)))")) (invalidSources (js-array "(defconst shared 7) (defun f () (let ((local shared)) shared shared (setq shared local)))" "(defun f (x-y x_y) [x-y x_y])" "(defasync f (promise) (lambda () (let ((next promise)) (await next))))" "(defun f (value) (+ (recur value) value))" "(defun f (value) (try (recur value) (finally nil)))" "(defun f () (let ((first missing) (second 1 2)) first))" "(defun f () [console/log console/log __eliscript_private/value])" "(defun f () (let ((value 1)) value missing missing))" "(defun f () (let () missing))" "(defun f () (defun nested () 1))" "(module outer (defportable f (value) (print value)))" "(defun helper (value) value) (defportable f (value) (helper value))"))
                 (extra (js-object
                   :valid (js-call validSources :map (lambda (source index) (js-object :name (str "environment-valid-" index) :filename (str "environment😀-" index ".eli") :source source)))
                   :invalid (js-call invalidSources :map (lambda (source index) (js-object :name (str "environment-invalid-" index) :filename (str "environment错误-" index ".eli") :source source)))))
                 (extraPath (resolve directory "environment-cases.json")))
            (await (writeFile extraPath (JSON/stringify extra)))
            (let ((expectedEnvironment (await (seedResults "analyzer" extraPath))))
              (js-call (expect (js-call expectedEnvironment :map (lambda (item) (get item :status)))) :toEqual
                (js-call (js-call (get extra :valid) :map (lambda () "ok")) :concat (js-call (get extra :invalid) :map (lambda () "error"))))
              (let ((iteration 0))
                (while (< iteration 2)
                  (let ((actual (js-call (js-call (get extra :valid) :concat (get extra :invalid)) :map (lambda (item)
                    (let* ((forms (js-call reader :read_string (get item :source) (get item :filename))) (saved (globalThis/structuredClone forms)) (result undefined))
                      (try
                        (js-call (expect (js-call analyzer :analyze_module forms (get item :filename))) :toBe forms)
                        (setq result (js-object :name (get item :name) :status "ok"))
                        (catch error (setq result (js-object :name (get item :name) :status "error" :message (get error :message) :diagnostic (get error :eliscriptDiagnostic)))))
                      (js-call (expect forms) :toEqual saved) result)))))
                    (js-call (expect actual) :toEqual expectedEnvironment))
                  (setq iteration (1+ iteration)))))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
