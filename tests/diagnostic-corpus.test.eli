(module tests.diagnostic-corpus.test
  (import "bun:test" expect test)
  (import "node:fs/promises" readFile)
  (import "node:path" :default path)
  (import "node:url" fileURLToPath)
  (import "../tools/diagnostics/check.mjs" checkDiagnosticCorpus DiagnosticCorpusError validateDiagnosticCorpus)
  (defconst ROOT (js-call path :resolve (js-call path :dirname (fileURLToPath (js* "import.meta.url"))) ".."))
  (defasync contract () (JSON/parse (await (readFile (js-call path :join ROOT "contracts/diagnostic-corpus.json") "utf8"))))
  (defasync validationErrors (value)
    (let ((failed false) (errors undefined))
      (try (await (validateDiagnosticCorpus value (js-object :root ROOT)))
        (catch error (js-call (expect error) :toBeInstanceOf DiagnosticCorpusError) (setq failed t errors (get error :errors))))
      (if failed errors (throw (new globalThis.Error "expected diagnostic corpus validation to fail")))))
  (test "complete negative diagnostic corpus is frozen and source-derived" (async ()
    (let ((checked (await (checkDiagnosticCorpus (js-object :root ROOT)))))
      (js-call (expect (js-call (get checked :suites) :map (lambda (suite) (js-array (get suite :id) (get suite :validCaseCount) (get suite :negativeCaseCount)))))
        :toEqual (js-array (js-array "reader" 23 17) (js-array "expander" 40 36) (js-array "analyzer" 30 57)))
      (js-call (expect (js-call (get checked :suites) :flatMap (lambda (suite) (get suite :cases)))) :toHaveLength 110)
      (js-call (expect (get checked :identity)) :toMatch (new globalThis.RegExp "^[0-9a-f]{64}$" "u")))))
  (test "diagnostic corpus rejects missing cases and fixture drift" (async ()
    (let ((value (await (contract))))
      (js-call (get (aref (get value :suites) 0) :cases) :pop)
      (let ((errors (await (validationErrors value))))
        (js-call (expect errors) :toContain "suite reader must contain exactly 17 negative cases")
        (js-call (expect errors) :toContain "suite reader cases must exactly match the ordered invalid fixture cases")))))
  (test "diagnostic corpus rejects structured and human diagnostic drift" (async ()
    (let ((value (await (contract))))
      (put (get (get (get (aref (get (aref (get value :suites) 0) :cases) 0) :diagnostic) :location) :start) :column 2)
      (let ((errors (await (validationErrors value))))
        (js-call (expect errors) :toContain "suite reader case 0 human text must render from its structured diagnostic")
        (js-call (expect errors) :toContain "identity must be the SHA-256 digest of the complete ordered suite payload")))))
)
