(module tests.wasm-managed-module-bindings.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" readFile mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:child_process" spawnSync)
  (import "node:url" pathToFileURL)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dyn-import (js* "(specifier) => import(specifier)"))
  (defconst root (resolve (get (js* "import.meta") :dir) ".."))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar sequence 0)
  (defvar fixture nil)
  (defvar fixtureBytes nil)
  (defvar fixtureReference nil)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-globals-red-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime
        (js-call (get b :compiler) :compile_ir_string
                 (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8"))
                 "runtime.eli"))
      (setq fixture
        (js-call (get b :compiler) :compile_ir_string
                 (await (readFile (resolve root "tests/fixtures/wasm-managed-module-bindings.eli") "utf8"))
                 "module-bindings.eli"))
      (setq fixtureReference
        (await (funcall dyn-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string fixture))
                                      :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (defasync make-pair (source)
    (setq sequence (+ sequence 1))
    (let* ((ir (js-call (get b :compiler) :compile_ir_string source "globals.eli"))
           (javascript (str "// reference " sequence "\n" (js-call (get b :compiler) :emit_ir_string ir)))
           (ref (await (funcall dyn-import
                                (str "data:text/javascript;base64,"
                                     (js-call (Buffer/from javascript) :toString "base64")))))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir runtime))))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      (js-object :ref ref :bytes bytes :a (instantiateManagedRuntime bytes))))

  (defun invoke-number (a name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (let ((x (js-call a :invoke name (if (undefined? args) (js-array) args))))
      (try
        (js-call a :readNumber x)
        (finally (js-call a :release x))))))

  (defun make-instance (&rest __host_default_arguments_2)
    (let* ((options (aref __host_default_arguments_2 0)))
    (when (nullish? fixtureBytes)
      (setq fixtureBytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm fixture runtime))))
    (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module fixtureBytes)) (js-array))
    (let ((a (instantiateManagedRuntime fixtureBytes (if (undefined? options) (js-object) options))))
      (js-call a :auto 1)
      a)))

  (defun read-array (a array)
    (let ((out (js-array))
          (len (js-call a :length array))
          (i 0))
      (while (< i len)
        (let ((x (js-call a :get array i)))
          (try
            (js-call out :push
              (cond
                ((or (= x nil) (= (funcall js-typeof x) "boolean") (undefined? x)) x)
                ((= (get x :kind) 4) (js-call a :readNumber x))
                ((= (get x :kind) 14) (read-array a x))
                (t (js-call a :readString x))))
            (finally (js-call a :release x))))
        (setq i (+ i 1)))
      out))

  (defun finish-heap (a &rest __host_default_arguments_3)
    (let* ((values (aref __host_default_arguments_3 0)))
    (when (not (undefined? values))
      (js-call values :forEach (lambda (value) (js-call a :release value))))
    (js-call a :closeModule)
    (js-call a :collect)
    (js-call assert :equal (js-call a :live) 0)
    (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))

  (test "top-level bindings preserve exact primitive values and mutable module state"
    (async ()
      (let* ((ctx (await (make-pair "(defconst zero -0.0) (defvar count 0) (defun get-zero () zero) (defun tick () (setq count (1+ count))) (export get-zero tick)")))
             (ref (get ctx :ref))
             (a (get ctx :a))
             (i 0))
        (funcall assert (Object/is (invoke-number a "get-zero") (js-call ref :get_zero)))
        (while (< i 8)
          (js-call assert :equal (invoke-number a "tick") (js-call ref :tick))
          (setq i (+ i 1)))
        (finish-heap a))))

  (test "module initializers run once in source order and may call later function declarations"
    (async ()
      (let* ((ctx (await (make-pair "(defvar sequence 0) (defconst first (mark 1)) (defconst second (mark 2)) (mark 3) (defun mark (x) (setq sequence (+ (* sequence 10) x))) (defun result () (+ sequence first second)) (export result)")))
             (ref (get ctx :ref))
             (a (get ctx :a))
             (i 0))
        (while (< i 4)
          (js-call assert :equal (invoke-number a "result") (js-call ref :result))
          (setq i (+ i 1)))
        (finish-heap a))))

  (test "lexical and captured locals shadow module bindings without changing the global cell"
    (async ()
      (let* ((ctx (await (make-pair "(defvar value 7) (defun global-value () value) (defun local-value () (let ((value 8)) ((lambda () (setq value (1+ value)) value)))) (export global-value local-value)")))
             (ref (get ctx :ref))
             (a (get ctx :a)))
        (js-call assert :equal (invoke-number a "local-value") (js-call ref :local_value))
        (js-call assert :equal (invoke-number a "global-value") (js-call ref :global_value))
        (finish-heap a))))

  (test "the same module bytes create isolated owned globals in independent heaps"
    (async ()
      (let* ((ctx (await (make-pair "(defvar count 0) (defun tick () (setq count (1+ count))) (export tick)")))
             (bytes (get ctx :bytes))
             (a (get ctx :a))
             (other (instantiateManagedRuntime bytes)))
        (js-call assert :equal (invoke-number a "tick") 1)
        (js-call assert :equal (invoke-number a "tick") 2)
        (js-call assert :equal (invoke-number other "tick") 1)
        (finish-heap a)
        (finish-heap other))))

  (test "global object identity survives caller release and automatic collection"
    (async ()
      (let* ((ctx (await (make-pair "(defconst state (js-array 7)) (defun get-state () state) (defun allocate () (js-array 1 2 3)) (export get-state allocate)")))
             (a (get ctx :a))
             (i 0))
        (js-call a :auto 1)
        (let ((saved (js-call a :invoke "get-state")))
          (while (< i 96)
            (let ((x (js-call a :invoke "allocate")))
              (js-call a :release x)
              (js-call a :collect))
            (setq i (+ i 1)))
          (let* ((again (js-call a :invoke "get-state"))
                 (first-el (js-call a :get again 0)))
            (funcall assert (js-call a :keyEqual saved again))
            (js-call assert :equal (js-call a :readNumber first-el) 7)
            (finish-heap a (js-array saved again first-el)))))))

  (test "uninitialized top-level reads reject module evaluation rather than inventing a value"
    (async ()
      (let* ((source "(defconst first (read-later)) (defconst later 7) (defun read-later () later) (export read-later)")
             (ir (js-call (get b :compiler) :compile_ir_string source "tdz.eli"))
             (javascript (js-call (get b :compiler) :emit_ir_string ir))
             (tdz-file (resolve directory "tdz-control.mjs")))
        (await (writeFile tdz-file javascript))
        (let ((control (spawnSync "node" (js-array tdz-file) (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get control :status) 1)
          (js-call assert :match (get control :stderr) (new globalThis.RegExp "ReferenceError")))
        (let ((bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir runtime))))
          (js-call assert :throws
            (lambda () (instantiateManagedRuntime bytes))
            (lambda (e) (diag-code? e "ELI-RT0008")))))))

  (test "module value exports are live bindings and function getters retain source identity"
    (lambda ()
      (let* ((a (make-instance))
             (zero (js-call a :getExport "negative-zero"))
             (state (js-call a :getExport "state"))
             (alias (js-call a :invoke "read-state"))
             (key (js-call a :string "self"))
             (self (js-call a :objectGet state key))
             (fn-export (js-call a :getExport "identity"))
             (fn-value (js-call a :invoke "identity-value")))
        (funcall assert (Object/is (js-call a :readNumber zero) -0.0))
        (funcall assert (js-call a :keyEqual state alias))
        (funcall assert (js-call a :keyEqual state self))
        (funcall assert (js-call a :keyEqual fn-export fn-value))
        (let* ((n (js-call a :number 9))
               (written (js-call a :invoke "write-counter" (js-array n))))
          (js-call a :release written)
          (let ((counter (js-call a :getExport "counter")))
            (js-call assert :equal (js-call a :readNumber counter) 9)
            (js-call assert :equal (js-call a :getExport "unset") nil)
            (js-call assert :equal (js-call a :getExport "missing") nil)
            (js-call assert :throws
              (lambda () (js-call a :getExport "not-exported"))
              (lambda (e) (diag-code? e "ELI-RT0003")))
            (js-call assert :throws
              (lambda () (js-call a :invoke "counter"))
              (lambda (e) (diag-code? e "ELI-RT0003")))
            (finish-heap a (js-array zero state alias key self fn-export fn-value n counter)))))))

  (test "dynamic function exports follow reassignment and preserve optional rest and exact values"
    (lambda ()
      (let* ((a (make-instance))
             (zero (js-call a :number -0.0))
             (nan (js-call a :number globalThis.NaN))
             (old (js-call a :getExport "current"))
             (out (js-call a :invoke "current" (js-array zero nan t))))
        (js-call assert :deepEqual (read-array a out) (js-array -0.0 (js-array globalThis.NaN t) 0))
        (js-call a :release out)
        (let* ((identity (js-call a :getExport "identity"))
               (changed (js-call a :invoke "set-current" (js-array identity))))
          (js-call a :release changed)
          (setq out (js-call a :invoke "current" (js-array zero)))
          (funcall assert (Object/is (js-call a :readNumber out) -0.0))
          (js-call a :release out)
          (let ((actual (js-call a :getExport "current")))
            (funcall assert (js-call a :keyEqual actual identity))
            (funcall assert (not (js-call a :keyEqual actual old)))
            (js-call assert :throws
              (lambda () (js-call a :invoke "identity" (js-array)))
              (lambda (e) (diag-code? e "ELI-RT0003")))
            (finish-heap a (js-array zero nan old identity actual)))))))

  (test "eager and deferred initialization execute exactly once and preserve existing caller roots"
    (lambda ()
      (let* ((a (make-instance (js-object :initializeModule false)))
             (keep (js-call a :number 7))
             (frame (js-call a :frame 1))
             (i 0))
        (js-call a :frameSet frame 0 keep)
        (js-call assert :throws
          (lambda () (js-call a :invoke "read-counter"))
          (lambda (e) (diag-code? e "ELI-RT0008")))
        (js-call assert :throws
          (lambda () (js-call a :getExport "counter"))
          (lambda (e) (diag-code? e "ELI-RT0008")))
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (js-call a :initializeModule)
        (while (< i 4)
          (js-call a :initializeModule)
          (setq i (+ i 1)))
        (let ((log (js-call a :getExport "initialization-log")))
          (js-call assert :deepEqual (read-array a log) (js-array 1 2 3))
          (js-call assert :equal (invoke-number a "tick") 1)
          (js-call a :initializeModule)
          (js-call assert :equal (invoke-number a "read-counter") 1)
          (let ((saved (js-call a :frameGet frame 0)))
            (js-call assert :equal (js-call a :readNumber saved) 7)
            (js-call a :leaveFrame frame)
            (finish-heap a (js-array keep saved log)))))))

  (test "closing module state releases unreachable graphs while caller-owned values retain their lifetime"
    (lambda ()
      (let* ((a (make-instance))
             (state (js-call a :getExport "state"))
             (log (js-call a :getExport "initialization-log"))
             (frame (js-call a :frame 1)))
        (js-call a :frameSet frame 0 state)
        (js-call a :release state)
        (js-call a :closeModule)
        (js-call a :collect)
        (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
        (let ((held (js-call a :frameGet frame 0)))
          (js-call assert :equal (get held :kind) 13)
          (js-call assert :deepEqual (read-array a log) (js-array 1 2 3))
          (js-call (js-array (lambda () (js-call a :invoke "read-state"))
                             (lambda () (js-call a :getExport "state"))
                             (lambda () (js-call a :initializeModule))) :forEach
            (lambda (op)
              (js-call assert :throws op (lambda (e) (diag-code? e "ELI-RT0003")))))
          (js-call a :release held)
          (js-call a :release log)
          (js-call a :leaveFrame frame)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
          (js-call a :closeModule)
          (js-call a :collect)
          (js-call assert :equal (js-call a :live) 0)))))

  (test "module initialization failures are cached and discard partial globals without disturbing caller frames"
    (lambda ()
      (let* ((ir (js-call (get b :compiler) :compile_ir_string "(defconst saved (js-array 1 2 3)) (defconst bad (false)) (export saved)" "failed-module.eli"))
             (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir runtime)))
             (a (instantiateManagedRuntime bytes (js-object :initializeModule false)))
             (keep nil)
             (frame nil)
             (i 0))
        (js-call a :auto 1)
        (setq keep (js-call a :number 7))
        (setq frame (js-call a :frame 1))
        (js-call a :frameSet frame 0 keep)
        (while (< i 3)
          (js-call assert :throws
            (lambda () (js-call a :initializeModule))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call a :collect)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :equal (js-call a :live) 2)
          (let ((saved (js-call a :frameGet frame 0)))
            (js-call assert :equal (js-call a :readNumber saved) 7)
            (js-call a :release saved))
          (setq i (+ i 1)))
        (js-call assert :throws
          (lambda () (js-call a :getExport "saved"))
          (lambda (e) (diag-code? e "ELI-RT0003")))
        (js-call a :leaveFrame frame)
        (js-call a :release keep)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "actual initializer traps unwind entered frames and retain the original trap and caller value"
    (async ()
      (let* ((source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
             (start (js-call source :indexOf "  (defun value-module-init (heap index value)"))
             (end (js-call source :indexOf "  (defun " (+ start 10))))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((faulty (str (js-call source :slice 0 start)
                            "  (defun value-module-init (heap index value) (load-u32 4294967295))\n"
                            (js-call source :slice end)))
               (rt (js-call (get b :compiler) :compile_ir_string faulty "module-trap.eli"))
               (a (instantiateManagedRuntime
                    (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm fixture rt))
                    (js-object :initializeModule false))))
          (js-call a :auto 1)
          (let* ((keep (js-call a :number -0.0))
                 (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 keep)
            (js-call assert :throws
              (lambda () (js-call a :initializeModule))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (js-call a :collect)
            (let ((saved (js-call a :frameGet frame 0)))
              (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
              (js-call assert :equal (js-call a :live) 2)
              (js-call a :release saved))
            (js-call a :leaveFrame frame)
            (js-call a :release keep)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))))

  (test "actual capacity failure during declaration does not publish an initialized module or leak cells"
    (lambda ()
      (let* ((a (make-instance (js-object :maxSlots 8 :initialBytes 4096 :maxBytes 8192 :initializeModule false)))
             (keep (js-call a :number 7))
             (frame (js-call a :frame 1))
             (i 0))
        (js-call a :frameSet frame 0 keep)
        (while (< i 2)
          (js-call assert :throws
            (lambda () (js-call a :initializeModule))
            (lambda (e) (diag-code? e "ELI-RT0002")))
          (js-call a :collect)
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :equal (js-call a :live) 2)
          (setq i (+ i 1)))
        (js-call a :leaveFrame frame)
        (js-call a :release keep)
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "dynamic export calls snapshot their callee before argument getters mutate its binding"
    (lambda ()
      (let* ((a (make-instance))
             (value (js-call a :number 7))
             (identity (js-call a :getExport "identity"))
             (args (js-array value false)))
        (Object/defineProperty args 1
          (js-object :get (lambda ()
                            (let ((changed (js-call a :invoke "set-current" (js-array identity))))
                              (js-call a :release changed)
                              (js-call a :release value)
                              (js-call a :collect)
                              false))))
        (let ((out (js-call a :invoke "current" args)))
          (js-call assert :deepEqual (read-array a out) (js-array 7 (js-array false) 0))
          (js-call a :release out)
          (finish-heap a (js-array identity))))))

  (test "export TDZ precedes argument getters and noncallable values remain captured after getters"
    (lambda ()
      (let* ((a (make-instance (js-object :initializeModule false)))
             (evaluated false)
             (args (js-array)))
        (Object/defineProperty args 0
          (js-object :get (lambda ()
                            (setq evaluated t)
                            t)))
        (js-call assert :throws
          (lambda () (js-call a :invoke "current" args))
          (lambda (e) (diag-code? e "ELI-RT0008")))
        (js-call assert :equal evaluated false)
        (js-call a :initializeModule)
        (let ((identity (js-call a :getExport "identity"))
              (counter-args (js-array)))
          (Object/defineProperty counter-args 0
            (js-object :get (lambda ()
                              (setq evaluated t)
                              (let ((changed (js-call a :invoke "write-counter" (js-array identity))))
                                (js-call a :release changed)
                                (js-call a :collect)
                                t))))
          (js-call assert :throws
            (lambda () (js-call a :invoke "counter" counter-args))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call assert :equal evaluated t)
          (js-call assert :equal (js-call a :invoke "counter" (js-array false)) false)
          (finish-heap a (js-array identity))))))

  (test "the requested module ABI supports function-only sources and refuses implicit profile changes"
    (lambda ()
      (let* ((ir (js-call (get b :compiler) :compile_ir_string "(defun identity (x) x) (export identity)" "forced-module.eli"))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir runtime (js-object :abi "managed-module-v1"))))))
        (js-call a :initializeModule)
        (let ((f (js-call a :getExport "identity")))
          (js-call assert :equal (get f :kind) 18)
          (finish-heap a (js-array f)))
        (js-call assert :throws
          (lambda () (js-call (get b :managed) :emit_managed_wasm fixture runtime (js-object :abi "managed-control-v1")))
          (lambda (e) (diag-code? e "ELI-B0001")))
        (js-call assert :throws
          (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime (js-object :abi "unknown")))
          (lambda (e) (diag-code? e "ELI-B0001"))))))

  (test "the explicit module CLI emits executable state and refuses incompatible ABI and output targets"
    (async ()
      (let* ((output (resolve directory "module-cli.wasm"))
             (command (resolve root "tools/backends/compile.mjs"))
             (input (resolve root "tests/fixtures/wasm-managed-module-bindings.eli"))
             (res (spawnSync "bun"
                             (js-array command "--abi" "managed-module-v1" "--target" "wasm" "-o" output input)
                             (js-object :cwd root :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get res :status) 0 (get res :stderr))
        (let ((a (instantiateManagedRuntime (await (readFile output)))))
          (js-call assert :equal (invoke-number a "tick") 1)
          (finish-heap a))
        (let ((cases (js-array (js-array "managed-control-v1" "wasm")
                               (js-array "managed-module-v1" "js")
                               (js-array "managed-module-v1" "native")))
              (idx 0))
          (while (< idx (get cases :length))
            (let* ((pair (aref cases idx))
                   (abi (aref pair 0))
                   (target (aref pair 1))
                   (rejected (resolve directory (str abi "-" target ".out")))
                   (child (spawnSync "bun"
                                     (js-array command "--abi" abi "--target" target "-o" rejected input)
                                     (js-object :cwd root :encoding "utf8" :timeout 30000))))
              (js-call assert :notEqual (get child :status) 0)
              (js-call assert :equal (await (js-call (js-call globalThis.Bun :file rejected) :exists)) false))
            (setq idx (+ idx 1))))))
    60000)

  (test "module globals cannot silently enable a shadowed builtin constructor even in dead code"
    (lambda ()
      (js-call (js-array (js-array "(defvar globalThis nil) (defun f () (if false (new globalThis.Map) nil)) (export f)" "shadow-globalThis.eli")
                         (js-array "(defconst Map nil) (defun f () (new (js* \"Map\"))) (export f)" "shadow-Map.eli")
                         (js-array "(defvar Set nil) (defun f () (new (js* \"Set\"))) (export f)" "shadow-Set.eli")) :forEach
        (lambda (pair)
          (let* ((src (aref pair 0))
                 (filename (aref pair 1))
                 (ir (js-call (get b :compiler) :compile_ir_string src filename))
                 (saved (JSON/stringify ir)))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime))
              (lambda (e)
                (and (diag-code? e "ELI-B0001")
                     (= (get (get (get e :eliscriptDiagnostic) :location) :file) filename))))
            (js-call assert :equal (JSON/stringify ir) saved))))))

  (defun raw-module ()
    (let ((ir (globalThis.structuredClone runtime)))
      (js-call (get ir :body) :push
               (js-object
                 :kind "export-declaration"
                 :value nil
                 :children (js-call (js-array "value-module-status" "value-module-begin" "value-module-declare"
                                              "value-module-get" "value-module-init" "value-module-set"
                                              "value-module-complete" "value-module-close" "value-module-check"
                                              "value-module-abort")
                             :map (lambda (v) (js-object :kind "reference" :value v :children (js-array))))))
      (let ((bytes (Uint8Array/from (js-call (get b :wasm) :emit_memory_wasm ir))))
        (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
        (let* ((e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
               (heap (funcall (aref e "heap-new") 64 4096 32768))
               (call-fn (lambda (name &rest args)
                          (let ((res (unsigned-bit-shift-right (apply (aref e name) (js-call (js-array heap) :concat args)) 0)))
                            (js-call assert :equal (funcall (aref e "last-error")) 0 name)
                            res))))
          (funcall call-fn "heap-auto" 1)
          (js-object :e e :heap heap :call call-fn)))))

  (test "a module cannot publish ready state while declared bindings remain uninitialized"
    (lambda ()
      (let* ((ctx (raw-module))
             (e (get ctx :e))
             (heap (get ctx :heap))
             (call-fn (get ctx :call)))
        (funcall call-fn "value-module-begin" 1)
        (funcall call-fn "value-module-declare" 0 1)
        (funcall (aref e "value-module-complete") heap)
        (js-call assert :equal (funcall (aref e "last-error")) 8)
        (js-call assert :equal (funcall call-fn "value-module-status") 1)
        (funcall call-fn "value-module-init" 0 3)
        (funcall call-fn "value-module-complete")
        (js-call assert :equal (funcall call-fn "value-module-status") 2)
        (js-call assert :equal (funcall call-fn "value-module-get" 0) 3)
        (funcall call-fn "value-module-close")
        (funcall call-fn "heap-collect")
        (js-call assert :equal (funcall call-fn "heap-live") 0))))

  (test "raw module cells retain exact words reject invalid writes and keep reentrant ownership intact"
    (lambda ()
      (let* ((ctx (raw-module))
             (e (get ctx :e))
             (heap (get ctx :heap))
             (call-fn (get ctx :call))
             (keep (funcall call-fn "value-number" 0 2147483648)))
        (funcall call-fn "heap-pin" keep)
        (let ((frame (funcall call-fn "frame-new" 1)))
          (funcall call-fn "frame-set" frame 0 keep)
          (funcall call-fn "heap-release" keep)
          (funcall call-fn "value-module-begin" 2)
          (funcall call-fn "value-module-declare" 0 0)
          (funcall call-fn "value-module-declare" 1 1)
          (funcall (aref e "value-module-get") heap 0)
          (js-call assert :equal (funcall (aref e "last-error")) 8)
          (funcall (aref e "value-module-begin") heap 2)
          (js-call assert :equal (funcall (aref e "last-error")) 3)
          (js-call assert :equal (funcall call-fn "value-module-status") 1)
          (js-call assert :equal (funcall call-fn "frame-depth") 1)
          (funcall (aref e "value-module-init") heap 0 4)
          (js-call assert :equal (funcall (aref e "last-error")) 1)
          (funcall (aref e "value-module-get") heap 0)
          (js-call assert :equal (funcall (aref e "last-error")) 8)
          (funcall call-fn "value-module-init" 0 keep)
          (funcall call-fn "value-module-init" 1 3)
          (funcall (aref e "value-module-init") heap 0 2)
          (js-call assert :equal (funcall (aref e "last-error")) 3)
          (funcall (aref e "value-module-set") heap 0 2)
          (js-call assert :equal (funcall (aref e "last-error")) 3)
          (js-call assert :equal (funcall call-fn "value-module-get" 0) keep)
          (funcall call-fn "value-module-complete")
          (let ((nxt (funcall call-fn "value-number" 1 0)))
            (funcall call-fn "value-module-set" 1 nxt)
            (funcall call-fn "heap-collect")
            (js-call assert :equal (funcall call-fn "value-module-get" 1) nxt)
            (funcall call-fn "value-module-close")
            (funcall call-fn "heap-collect")
            (js-call assert :equal (funcall call-fn "frame-get" frame 0) keep)
            (funcall call-fn "frame-pop" frame)
            (funcall call-fn "heap-collect")
            (js-call assert :equal (funcall call-fn "heap-live") 0))))))

  (test "module metadata refuses missing helpers malformed indexes mismatched exports and changed signatures"
    (lambda ()
      (let* ((lowered (js-call (get b :managed) :lower_managed_program fixture runtime))
             (raw (js-call (get b :wasm) :emit_typed_memory_wasm (get lowered :typed)))
             (saved (Array/from raw))
             (positive (Uint8Array/from
                         (js-call (get b :wasm) :append_metadata_section
                                  (Array/from raw)
                                  "eliscript-managed-control"
                                  (JSON/stringify (get lowered :descriptor))))))
        (js-call assert :equal
          (get (WebAssembly.Module/customSections (new globalThis.WebAssembly.Module positive) "eliscript-managed-control") :length)
          1)
        (finish-heap (instantiateManagedRuntime positive))
        (js-call (js-array
                   (lambda (d) (Reflect/deleteProperty d "module"))
                   (lambda (d) (put (get d :module) "initialize" "heap-collect"))
                   (lambda (d) (put (get d :module) "bindingCount" -1))
                   (lambda (d) (put (get d :module) "functionCount" 0))
                   (lambda (d) (put (aref (get (get d :module) :exports) 0) "kind" 9))
                   (lambda (d) (put (js-call (get (get d :module) :exports) :find (lambda (e) (= (get e :kind) 0))) "index" (get (get d :module) :bindingCount)))
                   (lambda (d) (put (js-call (get (get d :module) :exports) :find (lambda (e) (= (get e :kind) 1))) "index" (get (get d :module) :functionCount)))
                   (lambda (d) (js-call (get (get d :module) :exports) :pop))
                   (lambda (d) (js-call (get (get d :module) :exports) :push (aref (get (get d :module) :exports) 0)))
                   (lambda (d)
                     (let ((f (js-call (get d :functions) :find (lambda (fn) (= (get fn :callingConvention) "module-binding")))))
                       (put f "bindingIndex" (+ (get f :bindingIndex) 1))))
                   (lambda (d) (put (aref (get d :functions) 0) "callingConvention" "unknown"))
                   (lambda (d) (put (aref (get d :functions) 0) "arity" 2))
                   (lambda (d) (put (aref (get d :functions) 0) "parameterKinds" (js-array)))
                   (lambda (d) (put (js-call (get d :functions) :find (lambda (fn) (= (get fn :name) "read-state"))) "arity" 1))) :forEach
          (lambda (mutate)
            (let ((descriptor (globalThis.structuredClone (get lowered :descriptor))))
              (funcall mutate descriptor)
              (let ((bytes (Uint8Array/from
                             (js-call (get b :wasm) :append_metadata_section
                                      (Array/from raw)
                                      "eliscript-managed-control"
                                      (JSON/stringify descriptor)))))
                (js-call assert :equal
                  (get (WebAssembly.Module/customSections (new globalThis.WebAssembly.Module bytes) "eliscript-managed-control") :length)
                  1
                  "each malformed descriptor must be checked in isolation")
                (js-call assert :throws
                  (lambda () (instantiateManagedRuntime bytes))
                  (lambda (e) (diag-code? e "ELI-RT0003")))))))
        (js-call assert :deepEqual raw saved))))

  (test "module selection refuses non-string ABI requests rather than changing profiles implicitly"
    (lambda ()
      (let ((ir (js-call (get b :compiler) :compile_ir_string "(defun f () 1) (export f)" "abi-options.eli")))
        (js-call (js-array false t 0 (js-object) (js-array)) :forEach
          (lambda (abi)
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime (js-object :abi abi)))
              (lambda (e) (diag-code? e "ELI-B0001"))))))))

  (test "initializer-created sibling closures retain shared local cells after its root frame is gone"
    (async ()
      (let* ((ctx (await (make-pair "(defconst pair (let ((value 0)) (js-array (lambda () (setq value (1+ value))) (lambda () value)))) (defvar current nil) (defun set-current (f) (setq current f)) (export pair current set-current)")))
             (ref (get ctx :ref))
             (a (get ctx :a))
             (i 0))
        (js-call a :auto 1)
        (let* ((siblings (js-call a :getExport "pair"))
               (inc-fn (js-call a :get siblings 0))
               (read-fn (js-call a :get siblings 1))
               (ref-pair (get ref :pair)))
          (while (< i 32)
            (let ((selected (js-call a :invoke "set-current" (js-array inc-fn))))
              (js-call a :release selected)
              (js-call assert :equal (invoke-number a "current") (funcall (aref ref-pair 0)))
              (setq selected (js-call a :invoke "set-current" (js-array read-fn)))
              (js-call a :release selected)
              (js-call a :collect)
              (js-call assert :equal (invoke-number a "current") (funcall (aref ref-pair 1))))
            (setq i (+ i 1)))
          (finish-heap a (js-array siblings inc-fn read-fn))))))

  (test "module lowering refuses malformed declarations duplicate bindings immutable writes and hidden initialization IR"
    (lambda ()
      (js-call (js-array
                 (lambda (p) (put (get (aref (get p :body) 0) :properties) "mutable" "true"))
                 (lambda (p) (js-call (get (aref (get p :body) 0) :children) :push (js-object :kind "literal" :value 9 :children (js-array))))
                 (lambda (p) (put (aref (get p :body) 0) "value" ""))
                 (lambda (p) (put (aref (get p :body) 0) "value" "read"))
                 (lambda (p) (put (get (aref (get p :body) 1) :children) 0 (js-object :kind "managed-global-init" :globalEntry (js-object :name "x" :index 0) :children (js-array))))) :forEach
        (lambda (change)
          (let ((ir (js-call (get b :compiler) :compile_ir_string "(defvar x 1) (defun read () x) (export read)" "bad-module.eli")))
            (funcall change ir)
            (let ((saved (JSON/stringify ir)))
              (js-call assert :throws
                (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime))
                (lambda (e) (diag-code? e "ELI-B0001")))
              (js-call assert :equal (JSON/stringify ir) saved)))))
      (let ((ir (js-call (get b :compiler) :compile_ir_string "(defvar x 1) (defun write (v) (setq x v)) (export write)" "readonly-module.eli")))
        (put (get (aref (get ir :body) 0) :properties) "mutable" false)
        (let ((saved (JSON/stringify ir)))
          (js-call assert :throws
            (lambda () (js-call (get b :managed) :emit_managed_wasm ir runtime))
            (lambda (e) (diag-code? e "ELI-B0001")))
          (js-call assert :equal (JSON/stringify ir) saved)))))

  (test "a module artifact cannot masquerade as the original control ABI by stripping its descriptor"
    (lambda ()
      (let* ((ir (js-call (get b :compiler) :compile_ir_string "(defun f () 1) (export f)" "stripped-module.eli"))
             (lowered (js-call (get b :managed) :lower_managed_program ir runtime t))
             (descriptor (globalThis.structuredClone (get lowered :descriptor))))
        (put descriptor "abi" "managed-control-v1")
        (Reflect/deleteProperty descriptor "module")
        (let ((bytes (Uint8Array/from
                       (js-call (get b :wasm) :append_metadata_section
                                (js-call (get b :wasm) :emit_typed_memory_wasm (get lowered :typed))
                                "eliscript-managed-control"
                                (JSON/stringify descriptor)))))
          (js-call assert :throws
            (lambda () (instantiateManagedRuntime bytes))
            (lambda (e) (diag-code? e "ELI-RT0003")))))))

  (test "generated global assignments preserve independent exact-value models through repeated collection"
    (lambda ()
      (let* ((a (make-instance))
             (random 42940993)
             (next-u32 (lambda ()
                         (setq random (unsigned-bit-shift-right (+ (Math/imul random 1664525) 1013904223) 0))
                         random))
             (scalar-fn (lambda (x)
                          (cond
                            ((or (= x nil) (= (funcall js-typeof x) "boolean") (undefined? x)) x)
                            ((= (get x :kind) 4) (js-call a :readNumber x))
                            (t (js-call a :readString x)))))
             (i 0))
        (while (< i 128)
          (let ((tag (% (funcall next-u32) 7))
                (expected undefined))
            (cond
              ((= tag 0) (setq expected undefined))
              ((= tag 1) (setq expected nil))
              ((= tag 2) (setq expected false))
              ((= tag 3) (setq expected t))
              ((= tag 4) (setq expected (str "中😀" (funcall next-u32))))
              (t
               (let ((bits (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
                 (js-call bits :setUint32 0 (funcall next-u32) t)
                 (js-call bits :setUint32 4 (funcall next-u32) t)
                 (setq expected (js-call bits :getFloat64 0 t)))))
            (let* ((ty (funcall js-typeof expected))
                   (value (cond
                            ((= ty "number") (js-call a :number expected))
                            ((= ty "string") (js-call a :string expected))
                            (t expected)))
                   (returned (js-call a :invoke "write-counter" (js-array value))))
              (funcall assert (Object/is (funcall scalar-fn returned) expected))
              (js-call a :release returned)
              (js-call a :release value)
              (js-call a :collect)
              (let ((rd (js-call a :getExport "counter")))
                (funcall assert (Object/is (funcall scalar-fn rd) expected))
                (js-call a :release rd))))
          (setq i (+ i 1)))
        (finish-heap a))))

  (test "raw module roots preserve NaN payloads and full binary64 words without arithmetic conversion"
    (lambda ()
      (let* ((ctx (raw-module))
             (e (get ctx :e))
             (call-fn (get ctx :call)))
        (funcall call-fn "value-module-begin" 1)
        (funcall call-fn "value-module-declare" 0 1)
        (funcall call-fn "value-module-init" 0 0)
        (funcall call-fn "value-module-complete")
        (js-call (js-array (js-array 0 0)
                           (js-array 0 2147483648)
                           (js-array 1 0)
                           (js-array 2882400001 2146959360)
                           (js-array 1 2146435072)
                           (js-array 305419896 4294443008)
                           (js-array 0 2146435072)
                           (js-array 0 4293918720)
                           (js-array 4294967295 2146435071)) :forEach
          (lambda (words)
            (let* ((low (aref words 0))
                   (high (aref words 1))
                   (value (funcall call-fn "value-number" low high)))
              (funcall call-fn "value-module-set" 0 value)
              (funcall call-fn "heap-collect")
              (let* ((actual (funcall call-fn "value-module-get" 0))
                     (offset (funcall call-fn "value-data" actual 4))
                     (view (new globalThis.DataView (get (get e :memory) :buffer))))
                (js-call assert :deepEqual
                  (js-array (js-call view :getUint32 offset t)
                            (js-call view :getUint32 (+ offset 4) t))
                  (js-array low high))))))
        (funcall call-fn "value-module-close")
        (funcall call-fn "heap-collect")
        (js-call assert :equal (funcall call-fn "heap-live") 0))))

  (test "independent Node executes the same module bytes and generated JavaScript with exact exports and cleanup"
    (async ()
      (let ((artifact (resolve directory "standalone-module.wasm"))
            (javascript (resolve directory "standalone-module.mjs"))
            (runner (resolve "tests/helpers/wasm-managed-module-bindings-node.mjs")))
        (await (writeFile artifact (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm fixture runtime))))
        (await (writeFile javascript (js-call (get b :compiler) :emit_ir_string fixture)))
        (let ((res (spawnSync "node"
                              (js-array runner artifact (get (pathToFileURL javascript) :href))
                              (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get res :status) 0 (get res :stderr))
          (js-call assert :match (get res :stdout) (new globalThis.RegExp "independent Node module execution passed"))))))

  (test "an ordinary exported function failure keeps earlier global writes and does not poison the module"
    (async ()
      (let* ((ctx (await (make-pair "(defvar value 0) (defun fail-after-write () (setq value 7) (false) (setq value 99)) (defun read () value) (export value fail-after-write read)")))
             (a (get ctx :a)))
        (js-call a :auto 1)
        (let* ((keep (js-call a :number -0.0))
               (frame (js-call a :frame 1)))
          (js-call a :frameSet frame 0 keep)
          (js-call assert :throws
            (lambda () (js-call a :invoke "fail-after-write"))
            (lambda (e) (diag-code? e "ELI-RT0003")))
          (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
          (js-call assert :equal (invoke-number a "read") 7)
          (js-call a :initializeModule)
          (js-call assert :equal (invoke-number a "read") 7)
          (js-call a :leaveFrame frame)
          (finish-heap a (js-array keep))))))

  (test "logical module export names preserve full UTF16 while physical WASM names remain stable"
    (async ()
      (let* ((variable (str "值" (String/fromCharCode 55296)))
             (fn-name (str "取😀" (String/fromCharCode 57343)))
             (source (str "(defconst " variable " -0.0) (defun " fn-name " () " variable ") (export " variable " " fn-name ")"))
             (ir (js-call (get b :compiler) :compile_ir_string source "unicode-module.eli"))
             (ref (await (funcall dyn-import
                                  (str "data:text/javascript;base64,"
                                       (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string ir))
                                                :toString "base64"))))))
        (funcall assert (Object/is (funcall (js-call (Object/values ref) :find (lambda (x) (= (funcall js-typeof x) "function")))) -0.0))
        (let ((lowered (js-call (get b :managed) :lower_managed_program ir runtime)))
          (js-call (js-array (js-array variable 0) (js-array fn-name 1)) :forEach
            (lambda (pair)
              (let ((name (aref pair 0))
                    (idx (aref pair 1)))
                (js-call assert :deepEqual
                  (get (js-call (get (get lowered :descriptor) :functions) :find (lambda (x) (= (get x :name) name))) :wireName)
                  (str "__eliscript_export_" idx))))))
        (let* ((a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm ir runtime))))
               (val (js-call a :getExport variable))
               (actual (js-call a :invoke fn-name)))
          (funcall assert (Object/is (js-call a :readNumber val) -0.0))
          (funcall assert (Object/is (js-call a :readNumber actual) -0.0))
          (finish-heap a (js-array val actual)))))))
