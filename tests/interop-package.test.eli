(module tests.interop-package
  (import "node:fs" readFileSync)
  (import "bun:test" expect test)
  (import "node:fs/promises" copyFile cp mkdir mkdtemp readFile rm symlink writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst root projectDirectory)
  (defconst packageFixtures (resolve root "tests/fixtures/packages"))
  (defconst repositoryPackage (JSON/parse (readFileSync (resolve root "package.json") "utf8")))
  (defconst dependencies (js-array "bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value"))
  (defasync runSuccessful (command options)
    (let* ((options (if (= options undefined) (js-object) options)) (cwd (get options :cwd)))
      (await (run command (js-object :cwd (if (nullish? cwd) root cwd) :env
        (copyHostRecord (get globalThis.process :env) (js-object :EMACS (get (get globalThis.process :env) :EMACS "emacs")) (get options :env)))))))
  (defasync compilePackage (command packageRoot environment)
    (let ((outputDirectory (resolve packageRoot "stdlib")))
      (await (Promise/all (js-array (mkdir (resolve outputDirectory "interop") (js-object :recursive t))
        (cp (resolve root "runtime") (resolve packageRoot "runtime") (js-object :recursive t))
        (writeFile (resolve packageRoot "package.json") (str (JSON/stringify (js-object :name (get repositoryPackage :name) :private t :exports (get repositoryPackage :exports)) nil 2) "\n")))))
      (await (runSuccessful (js-array command "--root" "stdlib" "--out-dir" outputDirectory "stdlib/interop/js.eli") (js-object :env environment)))))
  (defasync prepareConsumer (directory eliscriptPackage)
    (let ((scope (resolve directory "node_modules/@eliscript-fixtures")))
      (await (Promise/all (js-array (mkdir scope (js-object :recursive t))
        (copyFile (resolve packageFixtures "interop-consumer/package.json") (resolve directory "package.json"))
        (copyFile (resolve packageFixtures "interop-consumer/index.mjs") (resolve directory "index.mjs")))))
      (await (Promise/all (js-array
        (symlink eliscriptPackage (resolve directory "node_modules/eliscript") "dir")
        (cp (resolve packageFixtures "native-container-consumer") (resolve scope "native-container-consumer") (js-object :recursive t)))))))
  (defasync executeConsumer (runtime directory)
    (JSON/parse (js-call (await (runSuccessful (js-array runtime "index.mjs") (js-object :cwd directory))) :trim)))
  (test "maintained JavaScript package consumes native values across compilers and hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-interop-package-")))) (bootstrap (resolve directory "bootstrap"))
           (seedPackage (resolve directory "seed-package")) (selfHostedPackage (resolve directory "self-hosted-package")))
      (try
        (let* ((manifests (await (Promise/all (js-array
                 (readFile (resolve packageFixtures "interop-consumer/package.json") "utf8")
                 (readFile (resolve packageFixtures "native-container-consumer/package.json") "utf8")
                 (readFile (resolve packageFixtures "native-container-consumer/index.eli") "utf8")))))
               (consumerManifest (JSON/parse (aref manifests 0))) (nativeManifest (JSON/parse (aref manifests 1))) (nativeSource (aref manifests 2)))
          (js-call (expect (get consumerManifest :dependencies)) :toEqual (js-object "@eliscript-fixtures/native-container-consumer" "*" :eliscript "*"))
          (js-call (expect nativeManifest) :toMatchObject (js-object :name "@eliscript-fixtures/native-container-consumer" :private t :type "module"))
          (js-call (get (expect nativeSource) :not) :toContain "eliscript/")
          (js-call (get (expect nativeSource) :not) :toContain "(import"))
        (await (Promise/all (js-array (mkdir seedPackage (js-object :recursive t)) (mkdir selfHostedPackage (js-object :recursive t)))))
        (await (compilePackage (resolve root "bin/eliscript-seed-build") seedPackage (js-object)))
        (await (seedCompilerFixture bootstrap))
        (await (compilePackage (resolve root "bin/eliscript-build") selfHostedPackage (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
        (let ((files (js-call (js-call dependencies :flatMap (lambda (name) (js-array (str "stdlib/" name ".mjs") (str "stdlib/" name ".mjs.map")))) :concat (js-array "stdlib/interop/js.mjs" "stdlib/interop/js.mjs.map"))) (index 0))
          (while (< index (js-length files))
            (let ((relative (aref files index)))
              (js-call (expect (await (readFile (resolve selfHostedPackage relative) "utf8"))) :toBe (await (readFile (resolve seedPackage relative) "utf8"))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (generations (js-array (js-array "seed" seedPackage) (js-array "self-hosted" selfHostedPackage))) (index 0))
          (while (< index 2)
            (let* ((generation (aref generations index)) (consumer (resolve directory (str (aref generation 0) "-consumer"))))
              (await (mkdir consumer (js-object :recursive t))) (await (prepareConsumer consumer (aref generation 1)))
              (js-call reports :push (await (executeConsumer (get globalThis.process :execPath) consumer)))
              (js-call reports :push (await (executeConsumer (get (get globalThis.process :env) :NODE "node") consumer))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (js-call (expect report) :toEqual (aref reports 0))))
          (js-call (expect (aref reports 0)) :toEqual (js-object "consumer" (js-object "packageName" "@eliscript-fixtures/native-container-consumer" "nativeCategories" (js-object "options" t "children" t "settings" t "tags" t) "beforeMutation" (js-object "title" "Eliscript" "children" (js-array "left" "right") "ready" t "tags" (js-array "host" "stable")) "afterMutation" (js-object "children" (js-array "left" "right" "package-added") "settingAdded" t "tags" (js-array "host" "package-added" "stable"))) "sourceUnchanged" (js-object "children" (js-array "left" "right") "childCount" 2 "settingAdded" false "tagAdded" false))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 120000)
)
