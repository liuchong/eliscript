(module tests.bootstrap-ir-serialization
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run caseSource buildBootstrap loadModule)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst fixturePath (resolve projectDirectory "tests/fixtures/bootstrap-ir.json"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun expectSchemaFailure (callback message)
    (try
      (funcall callback) (throw (new globalThis.Error "expected IR schema failure"))
      (catch error
        (when (= (get error :message) "expected IR schema failure") (throw error))
        (js-call (expect (get error :message)) :toContain message)
        (js-call (expect (get error :eliscriptDiagnostic)) :toEqual (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-I0001" :severity "error" :phase "ir-schema" :message (get error :message))))))
  (test "canonical IR v1 is lossless, strict, and host reproducible" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-ir-schema-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((modules (await (Promise/all (js-call (js-array "reader" "expander" "analyzer" "ir" "lower" "compiler") :map (lambda (name) (loadModule directory name "serialization"))))))
               (reader (aref modules 0)) (expander (aref modules 1)) (analyzer (aref modules 2)) (ir (aref modules 3)) (lower (aref modules 4)) (compiler (aref modules 5))
               (fixture (JSON/parse (await (readFile fixturePath "utf8")))) (programs (js-array)))
          (be (get ir :ir_format) "eliscript-ir") (be (get ir :ir_version) 1)
          (be (get compiler :ir_format) (get ir :ir_format)) (be (get compiler :ir_version) (get ir :ir_version))
          (let ((index 0) (cases (get fixture :valid)))
            (while (< index (js-length cases))
              (let* ((testCase (aref cases index)) (source (await (caseSource testCase)))
                     (forms (js-call expander :expand_module (js-call reader :read_string source (get testCase :filename)) (get testCase :filename))))
                (js-call analyzer :analyze_module forms (get testCase :filename))
                (let* ((program (js-call lower :lower_module forms (get testCase :filename))) (serialized (js-call compiler :serialize_ir_program program)))
                  (js-call (expect (js-call serialized :startsWith "{\"format\":\"eliscript-ir\",\"program\":{\"body\":")) :toBeTrue)
                  (js-call (expect (js-call serialized :endsWith "},\"version\":1}")) :toBeTrue)
                  (js-call (expect (js-call compiler :deserialize_ir_program serialized)) :toEqual program)
                  (be (js-call compiler :serialize_ir_program (js-call compiler :deserialize_ir_program serialized)) serialized)
                  (js-call programs :push (js-object :program program :serialized serialized))))
              (setq index (1+ index))))
          (let ((kinds (new globalThis.Set)))
            (letfn ((visit (node) (js-call kinds :add (get node :kind)) (js-call (get node :children) :forEach visit)))
              (js-call programs :forEach (lambda (item) (js-call (get (get item :program) :body) :forEach visit))))
            (js-call (expect (js-call (Array/from kinds) :sort)) :toEqual (js-call (Array/from (get ir :node_kinds)) :sort)))
          (let ((portablePath (resolve directory "portable-ir.json")))
            (await (writeFile portablePath (get (js-call programs :at -1) :serialized) "utf8"))
            (be (await (run (js-array (get (get globalThis.process :env) :NODE "node") (resolve projectDirectory "tests/fixtures/bootstrap-ir-host.mjs") (get (pathToFileURL (resolve directory "compiler.mjs")) :href) portablePath))) (get (js-call programs :at -1) :serialized)))
          (let* ((sample (aref programs 0)) (serialized (get sample :serialized)) (document (JSON/parse serialized)))
            (expectSchemaFailure (lambda () (js-call compiler :deserialize_ir_program (str " " serialized))) "not canonical")
            (expectSchemaFailure (lambda () (js-call compiler :deserialize_ir_program "{\"format\":\"eliscript-ir\",\"format\":\"eliscript-ir\",\"program\":{\"body\":[],\"filename\":\"x.eli\"},\"version\":1}")) "not canonical")
            (expectSchemaFailure (lambda () (js-call compiler :deserialize_ir_program "{")) "invalid canonical IR JSON")
            (expectSchemaFailure (lambda () (js-call compiler :deserialize_ir_program 42)) "must be a string")
            (expectSchemaFailure (lambda () (js-call compiler :deserialize_ir_program (JSON/stringify (copyHostRecord document (js-object :extra t))))) "unknown or missing fields")
            (expectSchemaFailure (lambda () (js-call compiler :deserialize_ir_program (js-call serialized :replace "\"version\":1}" "\"version\":2}"))) "unsupported IR version")
            (let ((unknownKind (globalThis/structuredClone document)))
              (put (aref (get (get unknownKind :program) :body) 0) :kind "future-node")
              (expectSchemaFailure (lambda () (js-call compiler :serialize_ir_program (get unknownKind :program))) "unknown Eliscript IR node kind"))
            (let ((badSpan (globalThis/structuredClone (get document :program))))
              (put (get (aref (get badSpan :body) 0) :span) :start -1)
              (expectSchemaFailure (lambda () (js-call compiler :serialize_ir_program badSpan)) "must be a non-negative integer"))
            (let ((nonFinite (globalThis/structuredClone (get document :program))))
              (put (aref (get nonFinite :body) 0) :value globalThis.Number.NaN)
              (expectSchemaFailure (lambda () (js-call compiler :serialize_ir_program nonFinite)) "finite numbers"))
            (let ((negativeZero (globalThis/structuredClone (get document :program))))
              (put (aref (get negativeZero :body) 0) :value (js* "-0"))
              (let ((encoded (js-call compiler :serialize_ir_program negativeZero)))
                (js-call (expect encoded) :toContain "\"value\":-0")
                (js-call (expect (Object/is (get (aref (get (js-call compiler :deserialize_ir_program encoded) :body) 0) :value) (js* "-0"))) :toBeTrue)))
            (let ((sparse (globalThis/structuredClone (get document :program))))
              (put sparse :body (new globalThis.Array 1))
              (expectSchemaFailure (lambda () (js-call compiler :serialize_ir_program sparse)) "dense plain array"))
            (let ((nullChild (globalThis/structuredClone (get document :program))))
              (js-call (get (aref (get nullChild :body) 0) :children) :push nil)
              (expectSchemaFailure (lambda () (js-call compiler :serialize_ir_program nullChild)) "plain data object"))
            (let ((accessor (globalThis/structuredClone (get document :program))))
              (Object/defineProperty (aref (get accessor :body) 0) "properties" (js-object :enumerable t :get (lambda () (js-object))))
              (expectSchemaFailure (lambda () (js-call compiler :serialize_ir_program accessor)) "plain data object"))
            (let ((cyclic (globalThis/structuredClone (get document :program))))
              (js-call (get (aref (get cyclic :body) 0) :children) :push (aref (get cyclic :body) 0))
              (expectSchemaFailure (lambda () (js-call compiler :serialize_ir_program cyclic)) "must not contain a cycle"))))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
