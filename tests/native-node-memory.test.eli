(module tests.native-node-memory.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:process" :default process)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL fileURLToPath)
  (import "node:child_process" spawn spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (defconst target (if (= (get process :arch) "arm64")
    (if (= (get process :platform) "darwin") "arm64-macos" (if (= (get process :platform) "linux") "arm64-linux" undefined)) undefined))
  (defconst nativeTest (js-call test :skipIf (not target)))
  (defvar directory undefined) (defvar library undefined) (defvar nativeDebug undefined)
  (defconst signatures (js-object :read32 1 :write32 2 :grow 1 :notify 2 :spin 2))
  (defconst capabilities (js-array (js-object :name "source-operation" :module "eliscript.host" :arity 2 :abi "managed-host-call-v1")))
  (defconst runner (fileURLToPath (new globalThis.URL "../tools/backends/native-node-runner.mjs" (js* "import.meta.url"))))
  (defconst host (fileURLToPath (new globalThis.URL "./fixtures/native-node-memory-host.mjs" (js* "import.meta.url"))))
  (defconst ownerHost (fileURLToPath (new globalThis.URL "./fixtures/native-node-owner-host.mjs" (js* "import.meta.url"))))
  (defun node () (if (nullish? (get (get process :env) :NODE)) "node" (get (get process :env) :NODE)))
  (defun env () (Object/assign (js-object) (get process :env) (js-object :NODE_OPTIONS "" :BUN_OPTIONS "")))
  (defun eqv (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (beforeAll (async ()
    (when target
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-native-node-"))))
      (let* ((backend (await (buildBackends (js-object :outputRoot directory))))
             (memory (await (funcall (js* "(specifier) => import(specifier)") (get (pathToFileURL (resolve (get backend :directory) "memory.mjs")) :href))))
             (typed (js-call memory :lower_memory_program (js-call (get backend :compiler) :compile_ir_string "\n    (import \"eliscript:memory32\" load-u32 store-u32 memory-grow)\n    (defun read32 (p) (load-u32 p))\n    (defun write32 (p v) (store-u32 p v))\n    (defun grow (n) (memory-grow n))\n    (defun notify (heap argv) 0)\n    (defun spin (heap argv) (while t (store-u32 64 1)))\n    (export read32 write32 grow notify spin)" "native-node-memory.eli")))
             (notify (js-call (get typed :functions) :find (lambda (fn) (= (get fn :name) "notify"))))
             (spin (js-call (get typed :functions) :find (lambda (fn) (= (get fn :name) "spin")))))
        (assert notify)
        (put notify :body (js-object :kind "host-call" :type "u32" :value "source-operation" :children
          (js-array (js-object :kind "local" :type "u32" :value 0 :children (js-array)) (js-object :kind "local" :type "u32" :value 1 :children (js-array)))))
        (assert spin) (put spin :body (js-object :kind "sequence" :type "u32" :value nil :children (js-array (globalThis.structuredClone (get notify :body)) (get spin :body))))
        (put typed :hostCapabilities capabilities)
        (setq library (resolve directory (if (= target "arm64-macos") "memory.dylib" "memory.so")))
        (let ((emission (js-call (get backend :native) :emit_typed_native_memory_artifact typed target (js-object :format "library"))))
          (setq nativeDebug (get emission :debug)) (await (writeFile library (Uint8Array/from (get emission :bytes)))))))) 120000)
  (afterAll (async () (when directory (await (rm directory (js-object :recursive t :force t))))))
  (defun configuration () (js-object :initialPages 1 :maximumPages 8 :nativeTarget target :bunExecutable (get process :execPath) :hostCapabilities capabilities))
  (defasync runNode (mode &rest __host_forwarded_arguments_3)
    (let* ((extras (aref __host_forwarded_arguments_3 0)))
    (let ((parameters (resolve directory (str mode ".json"))))
      (await (writeFile parameters (JSON/stringify (Object/assign
        (js-object :mode mode :library library :signatures signatures :configuration (configuration)) extras))))
      (let ((result (spawnSync (node) (js-array host parameters) (js-object :cwd directory :encoding "utf8" :timeout 30000 :env (env)))))
        (eqv (get result :error) undefined (get result :stderr)) (eqv (get result :status) 0 (str (get result :stderr) (get result :stdout)))
        (eqv (get result :stdout) "native-node-verified\n")))))
  (defun runPackets (input timeout) (spawnSync (get process :execPath) (js-array runner) (js-object :cwd directory :input input :encoding "utf8" :timeout timeout :env (env))))
  (defun alive (pid)
    (try (js-call process :kill pid 0) t (catch error (if (= (get error :code) "ESRCH") false (throw error)))))
  (defasync terminatingOwner ()
    (let ((parameters (resolve directory "terminated-owner.json")))
      (await (writeFile parameters (JSON/stringify (js-object :library library :signatures signatures :target target :capabilities capabilities :runner runner :bunExecutable (get process :execPath)))))
      (let ((owner (spawn (node) (js-array ownerHost parameters) (js-object :cwd directory :stdio (js-array "ignore" "pipe" "pipe") :env (env))))
            (loaderPID undefined) (stderr "") (exited false))
        (js-call owner :once "exit" (lambda () (setq exited t)))
        (js-call (get owner :stderr) :on "data" (lambda (bytes) (setq stderr (str stderr (js-call bytes :toString)))))
        (try
          (setq loaderPID (await (new globalThis.Promise (lambda (accept reject)
            (let ((output "") (timeout undefined))
              (letfn ((finish (failure &optional pid)
                (globalThis.clearTimeout timeout) (js-call (get owner :stdout) :off "data" data) (js-call owner :off "error" error) (js-call owner :off "exit" exit)
                (if failure (reject failure) (accept pid)))
                (data (bytes)
                  (setq output (str output (js-call bytes :toString)))
                  (let ((end (js-call output :indexOf "\n")))
                    (when (>= end 0)
                      (try (let ((value (JSON/parse (js-call output :slice 0 end)))) (assert (Number/isSafeInteger (get value :pid))) (finish undefined (get value :pid)))
                        (catch failure (finish failure))))))
                (error (failure) (finish failure))
                (exit (code) (finish (new globalThis.Error (str "native owner exited before its callback: " code "\n" stderr)))))
                (setq timeout (globalThis.setTimeout (lambda () (finish (new globalThis.Error (str "native frame did not enter its callback: " stderr)))) 10000))
                (js-call (get owner :stdout) :on "data" data) (js-call owner :once "error" error) (js-call owner :once "exit" exit)))))))
          (assert (alive loaderPID))
          (let ((ownerExit (new globalThis.Promise (lambda (accept) (js-call owner :once "exit" accept)))))
            (js-call owner :kill "SIGKILL") (await ownerExit))
          (let ((deadline (+ (Date/now) 5000)))
            (while (and (alive loaderPID) (< (Date/now) deadline)) (await (new globalThis.Promise (lambda (accept) (globalThis.setTimeout accept 25))))))
          (eqv (alive loaderPID) false "native loader outlived its terminated owner")
          (finally (unless exited (js-call owner :kill "SIGKILL")) (when (and loaderPID (alive loaderPID)) (js-call process :kill loaderPID "SIGKILL")))))))
  (nativeTest "Node native memory owns real library bytes, grows and resizes bulk transfers without changing hosts" (async () (await (runNode "bulk"))) 30000)
  (nativeTest "Node bulk transfers bound every real base64 packet while preserving complete snapshots ranges and empty operations" (async () (await (runNode "bounded-bulk"))) 30000)
  (nativeTest "chunked real Node native transfers remain isolated during nested callbacks original throws and callback close" (async () (await (runNode "chunked-callbacks"))) 30000)
  (nativeTest "Node native memory validates the original ABI and restores native trap classes before recovery" (async () (await (runNode "boundaries"))) 30000)
  (nativeTest "large Unicode debug records cross real native request and error packets without changing code or source positions" (async ()
    (let* ((debug (globalThis.structuredClone nativeDebug)) (filename (str "virtual/" (js-call "汉😀e\u0301" :repeat 32768) ".eli")))
      (letfn ((replaceSpan (item) (when (get item :span) (put item :span (Object/assign (js-object) (get item :span) (js-object :filename filename))))))
        (js-call (get debug :functions) :forEach replaceSpan) (js-call (get debug :ranges) :forEach replaceSpan))
      (put debug :sources (js-array (js-object :id filename :filename filename :macroOrigins (js-array))))
      (await (runNode "unicode-packets" (js-object :debug debug :filename filename))))) 30000)
  (nativeTest "Node native callbacks reenter their original memory and preserve each exact thrown host value" (async () (await (runNode "callbacks"))) 30000)
  (nativeTest "the real native loader consumes multiple packets and closes only after complete requests" (lambda ()
    (let* ((first (js-object :id 1 :method "open" :args (js-array library signatures (js-object :initialPages 1 :maximumPages 8 :nativeTarget target :hostCapabilities capabilities))))
           (input (js-call (js-call (js-array first (js-object :id 2 :method "invoke" :args (js-array "write32" 3 4275878552))
             (js-object :id 3 :method "invoke" :args (js-array "read32" 3)) (js-object :id 4 :method "read" :args (js-array 3 4))
             (js-object :id 5 :method "close" :args (js-array))) :map (lambda (value) (str (JSON/stringify value) "\n"))) :join ""))
           (result (runPackets input 30000)))
      (eqv (get result :error) undefined (get result :stderr)) (eqv (get result :status) 0 (get result :stderr))
      (same (js-call (js-call (js-call (get result :stdout) :trim) :split "\n") :map (lambda (line) (JSON/parse line)))
        (js-array (js-object :ready t) (js-object :id 1 :result t) (js-object :id 2 :result nil) (js-object :id 3 :result 4275878552)
          (js-object :id 4 :result (js-call (Buffer/from (js-array 152 186 220 254)) :toString "base64")) (js-object :id 5 :result nil))))) 30000)
  (nativeTest "the real native loader rejects truncated frames, invalid UTF8 and a forbidden transport BOM before opening a library" (lambda ()
    (let* ((open (str (JSON/stringify (js-object :id 1 :method "open" :args (js-array library signatures
             (js-object :initialPages 1 :maximumPages 8 :nativeTarget target :hostCapabilities capabilities)))) "\n"))
           (cases (js-array (js-object :label "truncated" :input (Buffer/from "{\"id\":1") :error (new globalThis.RegExp "incomplete native transport request"))
             (js-object :label "invalid-utf8" :input (Buffer/from (js-array 123 34 255 34 125 10)) :error (new globalThis.RegExp "UTF.?8|encoded data|encoding" "i"))
             (js-object :label "bom" :input (Buffer/concat (js-array (Buffer/from (js-array 239 187 191)) (Buffer/from open))) :error (new globalThis.RegExp "SyntaxError|JSON" "i")))))
      (js-call cases :forEach (lambda (item)
        (let ((result (runPackets (get item :input) 10000)))
          (eqv (get result :error) undefined (str (get item :label) ": " (get result :stderr)))
          (js-call assert :notEqual (get result :status) 0 (get item :label)) (eqv (get result :stdout) "{\"ready\":true}\n" (get item :label))
          (js-call assert :match (get result :stderr) (get item :error) (get item :label))))))) 30000)
  (nativeTest "terminating an owner also terminates its loader while real native code is running" (async () (await (terminatingOwner))) 30000)
)
