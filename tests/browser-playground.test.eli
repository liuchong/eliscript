(module tests.browser-playground
  (import "bun:test" afterAll beforeAll expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:path" resolve dirname)
  (import "node:module" createRequire)
  (import "../runtime/core/data-text.mjs" printValue)
  (import "../tools/backends/build.mjs" root)
  (defconst compiler (resolve root "bin/eliscript"))
  (defconst builder (resolve root "bin/eliscript-build"))
  (defconst playground (resolve root "examples/browser-playground/src/playground.eli"))
  (defconst highlighter (resolve root "examples/browser-playground/src/highlight.eli"))
  (defconst page (resolve root "examples/browser-playground/index.html"))
  (defconst site-page (resolve root "docs/pages/playground.html"))
  (defvar staging undefined)
  (defasync run (command)
    (let* ((child (Bun/spawn command (js-object :cwd root :stdout "pipe" :stderr "pipe")))
           (result (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2))))
  (defun require-success (result)
    (unless (= (get result :exitCode) 0)
      (let ((error (js-call (get result :stderr) :trim)))
        (throw (new globalThis.Error (if (> (js-length error) 0) error (js-call (get result :stdout) :trim)))))))
  (defasync compile (source output)
    (let ((input (resolve (dirname output) "input.eli")))
      (await (writeFile input source))
      (require-success (await (run (js-array compiler "--output" output input))))
      (await (readFile output "utf8"))))
  (defasync compile-and-run (name source)
    (let* ((output (resolve staging (str name ".mjs")))
           (javascript (await (compile source output))) (lines (js-array))
           (original (get globalThis.console :log)))
      (put globalThis.console :log (lambda (&rest values)
        (js-call lines :push (js-call (js-call values :map (lambda (value)
          (if (and (not (eq value nil)) (= (value-type value) "object"))
            (printValue value) (funcall globalThis.String value)))) :join " "))))
      (try (funcall (createRequire output) output)
        (finally (put globalThis.console :log original)))
      (js-object :javascript javascript :lines lines)))
  (beforeAll (async () (setq staging (await (mkdtemp (resolve root ".eliscript-browser-playground-"))))))
  (afterAll (async () (when staging (await (rm staging (js-object :recursive t :force t))))))
  (defasync build-playground ()
    (let ((out (resolve staging "playground-build")))
      (require-success (await (run (js-array builder "--no-cache" "--root" "examples/browser-playground/src"
        "--out-dir" out playground)))) out))
  (defun specifiers (javascript)
    (Array/from (js-call javascript :matchAll (new globalThis.RegExp "from \"([^\"]+)\"" "gu"))
      (lambda (match) (aref match 1))))
  (test "the playground builds both sources into ESM" (async ()
    (let* ((out (await (build-playground))) (javascript (await (readFile (resolve out "playground.mjs") "utf8"))))
      (js-call (get (expect javascript) :not) :toContain "eliscript/compiler")
      (js-call (expect javascript) :toContain "browser/worker.mjs")
      (js-call (expect javascript) :toContain "from \"eliscript/platform/browser.mjs\"")
      (js-call (expect javascript) :toContain "from \"eliscript/runtime/core/data-text.mjs\"")
      (js-call (expect javascript) :toContain "from \"./highlight.mjs\"")
      (js-call (specifiers javascript) :forEach (lambda (path) (js-call (expect (js-call path :endsWith ".eli")) :toBe false)))
      (js-call (expect (js-length (await (readFile (resolve out "highlight.mjs") "utf8")))) :toBeGreaterThan 1000))))
  (test "the highlighter marks the syntax the editor shows" (async ()
    (let ((output (resolve staging "highlight.mjs")))
      (js-call (expect (get (await (run (js-array compiler "--output" output highlighter))) :exitCode)) :toBe 0)
      (let* ((module (funcall (createRequire output) output))
             (lisp (js-call module :highlight_eliscript "; note\n(defconst n 42)\n(print \"hi <b>\" :tag)"))
             (javascript (js-call module :highlight_javascript "const x = 1; // note\n/* block */\nfoo(\"a\");")))
        (js-call (js-array "<span class=\"tok-comment\">; note</span>" "<span class=\"tok-keyword\">defconst</span>"
          "<span class=\"tok-number\">42</span>" "<span class=\"tok-literal\">:tag</span>" "&lt;b&gt;")
          :forEach (lambda (text) (js-call (expect lisp) :toContain text)))
        (js-call (get (expect lisp) :not) :toContain "<b>")
        (js-call (js-array "<span class=\"tok-comment\">// note</span>" "<span class=\"tok-comment\">/* block */</span>"
          "<span class=\"tok-keyword\">const</span>" "<span class=\"tok-string\">&quot;a&quot;</span>")
          :forEach (lambda (text) (js-call (expect javascript) :toContain text)))))))
  (test "runtime imports resolve through the package prefix without unused binding helpers" (async ()
    (let* ((result (await (compile-and-run "probe" (str "(module probe"
             " (import \"eliscript/runtime/core/sequence.mjs\" map filter)"
             " (import \"eliscript/runtime/core/order.mjs\" sort) (defconst values [4 1 3 2])"
             " (print \"sorted\" (sort values))"
             " (print \"squares\" (map (lambda (value) (* value value)) values))"
             " (print \"even\" (filter (lambda (value) (= (% value 2) 0)) values)))\n"))))
           (imports (specifiers (get result :javascript))))
      (js-call (expect (js-length imports)) :toBeGreaterThan 0)
      (js-call imports :forEach (lambda (path) (js-call (expect (js-call path :startsWith "eliscript/")) :toBe t))))))
  (test "compiled output executes against the public runtime" (async ()
    (let ((result (await (compile-and-run "execute" (str "(module execute"
      " (import \"eliscript/runtime/core/order.mjs\" sort) (import \"eliscript/runtime/core/collection.mjs\" conj)"
      " (defconst values (conj (conj [] 3) 1)) (print \"sorted\" (sort values)) (print \"length\" (length values)))\n")))))
      (js-call (expect (get result :lines)) :toEqual (js-array "sorted [1 3]" "length 2")))))
  (test "every emitted specifier resolves to a served file" (async ()
    (let* ((result (await (compile-and-run "exports" (str "(module exports"
             " (import \"eliscript/runtime/core/sequence.mjs\" map) (print \"mapped\" (map (lambda (value) value) [1 2])))\n"))))
           (imports (specifiers (get result :javascript))) (seen (new globalThis.Set)) (index 0))
      (while (< index (js-length imports))
        (let ((path (aref imports index)))
          (js-call (expect (js-call path :startsWith "eliscript/")) :toBe t)
          (js-call (expect (await (js-call (Bun/file (resolve root (js-call path :slice (js-length "eliscript/")))) :exists))) :toBe t)
          (js-call seen :add path))
        (setq index (1+ index)))
      (js-call (expect (get seen :size)) :toBeGreaterThanOrEqual 2))))
  (test "both pages declare the relative import map and the editor surface" (async ()
    (let ((files (js-array page site-page)) (index 0))
      (while (< index (js-length files))
        (let ((text (await (readFile (aref files index) "utf8"))))
          (js-call (expect text) :toContain "type=\"importmap\"")
          (js-call (expect text) :toContain "\"eliscript/\": \"../../\"")
          (js-call (get (expect text) :not) :toContain "eliscript/compiler\":")
          (js-call (js-array "highlight" "source" "stdout" "diagnostics" "js" "run") :forEach
            (lambda (id) (js-call (expect text) :toContain (str "id=\"" id "\"")))))
        (setq index (1+ index)))
      (js-call (expect (await (readFile page "utf8"))) :toContain "src=\"./playground.mjs\"")
      (js-call (expect (await (readFile site-page "utf8"))) :toContain "import(\"../../dist/browser-playground/playground.mjs\")"))))
  (test "both pages style the highlight tokens" (async ()
    (js-call (expect (await (readFile (resolve root "examples/browser-playground/site.css") "utf8"))) :toContain ".highlight .tok-keyword")
    (js-call (expect (await (readFile site-page "utf8"))) :toContain ".pg-highlight .tok-keyword")
    (js-call (expect (await (readFile page "utf8"))) :toContain "id=\"highlight\"")
    (js-call (expect (await (readFile site-page "utf8"))) :toContain "id=\"highlight\"")))
  (test "a compile failure carries a structured diagnostic" (async ()
    (let ((output (resolve staging "broken.mjs")) (input (resolve staging "broken.eli")))
      (await (writeFile input "(module broken\n  (defun f (x) (not-a-binding x)))\n"))
      (let* ((result (await (run (js-array compiler "--diagnostic-format" "json" "--output" output input))))
             (diagnostic (JSON/parse (js-call (js-call (js-call (get result :stderr) :trim) :split "\n") :at -1))))
        (js-call (expect (get result :exitCode)) :toBe 1)
        (js-call (expect (get diagnostic :format)) :toBe "eliscript-diagnostic")
        (js-call (expect (get diagnostic :code)) :toMatch (new globalThis.RegExp "^ELI-" "u"))
        (js-call (expect (get diagnostic :phase)) :toBe "analysis")
        (js-call (expect (get (get (get diagnostic :location) :start) :line)) :toBe 2)))))
)
