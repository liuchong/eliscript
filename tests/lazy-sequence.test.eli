(module tests.lazy-sequence.test
  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (import "./helpers/generator-step.mjs" generator fromValues)
  (import "./helpers/portable-stdlib.mjs" runSuccessful)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" dirname resolve)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/collection.mjs" boundedCount isCollection isSequence isSequential reduce seq sequenceView unboundedSequenceView)
  (import "../runtime/core/lazy-sequence.mjs"
    isLazySequence isLazySequenceRealized lazyCons lazyDedupe lazyDistinct lazyDrop lazyDropWhile lazyFilter lazyInterpose
    lazyKeep lazyKeepIndexed lazyMap lazyMapcat lazyMapIndexed lazyPartitionAll lazyPartitionBy lazyRemove lazySequence
    lazyTake lazyTakeNth lazyTakeWhile realizeLazySequence realizedLazySequenceCount)
  (import "../runtime/core/sequence.mjs" :as Sequence)
  (import "../runtime/core/transducer.mjs" composeTransducers filtering interposing mapping partitioningAll sequence taking)
  (defconst root (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst seedCompiler (resolve root "bin/eliscript-seed"))
  (defconst portableCompiler (resolve root "bin/eliscript-portable"))
  (defconst hostFixture (resolve root "tests/fixtures/lazy-sequence-host.mjs"))
  (defconst bunPreload (resolve root "tests/fixtures/compiled-eli-bun-preload.mjs"))
  (defconst nodeLoader (resolve root "tests/fixtures/compiled-eli-node-loader.mjs"))
  (defconst compilationUnits (js-array (js-array "stdlib/core/lazy-sequence.eli" "stdlib/core/lazy-sequence.eli")
    (js-array "stdlib/core/transducer.eli" "stdlib/core/transducer.eli") (js-array "tests/fixtures/lazy-sequence.eli" "tests/fixtures/lazy-sequence.mjs")))

  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (defun rejects (operation message) (js-call (expect operation) :toThrow message))
  (defun iterator (source) (Reflect/apply (get source (get globalThis.Symbol :iterator)) source (js-array)))


  (defun naturalsView (onPull)
    (unboundedSequenceView (lambda ()
      (let ((value 1)) (generator (lambda () (let ((out value)) (funcall onPull) (setq value (1+ value)) (js-object :value out :done false))))))))
  (defasync compile (command source output &rest __host_default_arguments_1)
    (let* ((environment (aref __host_default_arguments_1 0)))
    (await (mkdir (dirname output) (js-object :recursive t)))
    (await (runSuccessful (js-array command "--source-map" "--output" output source) (if (= environment undefined) (js-object) environment)))))
  (defasync compileFamily (command outputRoot &rest __host_forwarded_arguments_1)
    (let* ((environment (aref __host_forwarded_arguments_1 0)))
    (await (mkdir outputRoot (js-object :recursive t)))
    (await (symlink (resolve root "runtime") (resolve outputRoot "runtime") "dir"))
    (let ((index 0))
      (while (< index (get compilationUnits :length))
        (let ((unit (aref compilationUnits index))) (await (compile command (resolve root (aref unit 0)) (resolve outputRoot (aref unit 1)) environment)))
        (setq index (1+ index))))))
  (defun captureFailure (operation)
    (try (funcall operation) (js-object :caught false :value nil) (catch error (js-object :caught t :value error))))
  (test "lazy sequences start on demand and share one realized prefix" (lambda ()
    (let* ((starts 0) (pulls 0)
           (source (lazySequence (lambda () (setq starts (1+ starts))
             (sequenceView (lambda () (fromValues (js-array 10 20 30) (lambda (value) (setq pulls (1+ pulls))))) 3)))))
      (be (isLazySequence source) t) (be (isLazySequenceRealized source) false)
      (be (realizedLazySequenceCount source) 0) (be (isCollection source) t) (be (isSequential source) t) (be (isSequence source) t)
      (let ((left (iterator source)) (right (iterator source)))
        (same (js-call left :next) (js-object :value 10 :done false))
        (same (js-array starts pulls (realizedLazySequenceCount source)) (js-array 1 1 1))
        (same (js-call right :next) (js-object :value 10 :done false)) (same (js-array starts pulls) (js-array 1 1))
        (same (js-call left :next) (js-object :value 20 :done false)) (same (js-call right :next) (js-object :value 20 :done false))
        (be pulls 2) (be (js-call Sequence :first source) 10)
        (same (Array/from (js-call Sequence :rest source)) (js-array 20 30))
        (same (Array/from (js-call Sequence :next source)) (js-array 20 30)))
      (be (realizeLazySequence source) source) (same (Array/from source) (js-array 10 20 30))
      (same (js-array starts pulls (realizedLazySequenceCount source)) (js-array 1 3 3))
      (be (reduce source (lambda (sum value) (+ sum value)) 0) 60))))
  (test "lazy sequence failures are cached at one stable realization position" (lambda ()
    (let* ((failure (new globalThis.Error "lazy failure")) (starts 0)
           (source (lazySequence (lambda () (setq starts (1+ starts))
             (sequenceView (lambda () (let ((step 0)) (generator (lambda ()
               (if (= step 0) (progn (setq step 1) (js-object :value "ready" :done false)) (throw failure))))))))))
           (first (iterator source)) (second (iterator source)))
      (be (get (js-call first :next) :value) "ready") (rejects (lambda () (js-call first :next)) failure)
      (be (get (js-call second :next) :value) "ready") (rejects (lambda () (js-call second :next)) failure) (be starts 1)
      (let* ((producerStarts 0) (producerFailure (new globalThis.Error "producer failure"))
             (failedProducer (lazySequence (lambda () (setq producerStarts (1+ producerStarts)) (throw producerFailure)))))
        (rejects (lambda () (seq failedProducer)) producerFailure) (rejects (lambda () (seq failedProducer)) producerFailure) (be producerStarts 1))
      (let* ((nullStarts 0) (nullFailure (lazySequence (lambda () (setq nullStarts (1+ nullStarts)) (throw nil)))))
        (same (captureFailure (lambda () (seq nullFailure))) (js-object :caught t :value nil))
        (same (captureFailure (lambda () (seq nullFailure))) (js-object :caught t :value nil)) (be nullStarts 1))
      (let* ((undefinedFailure (lazySequence (lambda () (sequenceView (lambda ()
          (let ((step 0) (source (js-object)))
            (put source :next (lambda () (if (= step 0) (progn (setq step 1) (js-object :value "ready" :done false)) (throw undefined))))
            (put source (get globalThis.Symbol :iterator) (lambda () source)) source)) 2))))
             (undefinedFirst (iterator undefinedFailure)) (undefinedSecond (iterator undefinedFailure)))
        (be (get (js-call undefinedFirst :next) :value) "ready")
        (same (captureFailure (lambda () (js-call undefinedFirst :next))) (js-object :caught t :value undefined))
        (be (get (js-call undefinedSecond :next) :value) "ready")
        (same (captureFailure (lambda () (js-call undefinedSecond :next))) (js-object :caught t :value undefined))))))
  (test "lazy cons defers tails and remains stack safe for recursive streams" (lambda ()
    (let ((tails 0))
      (letfn ((naturals (value) (lazyCons value (lambda () (setq tails (1+ tails)) (naturals (1+ value))))))
        (let* ((source (naturals 0)) (iter (iterator source)))
          (be tails 0) (be (get (js-call iter :next) :value) 0) (be tails 0)
          (be (get (js-call iter :next) :value) 1) (be tails 1)
          (be (boundedCount 100000 source) 100000) (be (realizedLazySequenceCount source) 100000) (be tails 99999))))))
  (test "transducer sequence pulls only enough input and memoizes output" (lambda ()
    (let* ((starts 0) (pulls 0)
           (input (lazySequence (lambda () (setq starts (1+ starts)) (naturalsView (lambda () (setq pulls (1+ pulls)))))))
           (output (sequence (composeTransducers (mapping (lambda (value) (* value 2))) (filtering (lambda (value) (= (% value 4) 0))) (taking 3)) input)))
      (same (js-array starts pulls) (js-array 0 0))
      (let ((first (iterator output)) (second (iterator output)))
        (be (get (js-call first :next) :value) 4) (same (js-array starts pulls) (js-array 1 2))
        (be (get (js-call second :next) :value) 4) (be pulls 2)
        (same (Array/from output) (js-array 4 8 12)) (be pulls 6) (be (realizedLazySequenceCount input) 6)))))
  (test "transducer sequence honors zero input and completion output" (lambda ()
    (let* ((starts 0) (input (lazySequence (lambda () (setq starts (1+ starts)) (js-array 1 2 3))))
           (empty (sequence (taking 0) input)) (groups (sequence (partitioningAll 3) (js-array 1 2 3 4 5))))
      (js-call (expect (seq empty)) :toBeNull) (be starts 0)
      (same (js-call (Array/from groups) :map (lambda (group) (Array/from group))) (js-array (js-array 1 2 3) (js-array 4 5)))
      (same (js-call (Array/from groups) :map (lambda (group) (Array/from group))) (js-array (js-array 1 2 3) (js-array 4 5)))
      (same (Array/from (sequence (interposing "|") (js-array 1 2 3))) (js-array 1 "|" 2 "|" 3)))))
  (test "transducer sequence closes its input when transformation fails" (lambda ()
    (let* ((failure (new globalThis.Error "transform failure")) (closed 0)
           (input (sequenceView (lambda () (fromValues (js-array 1 2) (lambda (value) undefined) (lambda () (setq closed (1+ closed))))) 2))
           (output (sequence (mapping (lambda (value) (when (= value 2) (throw failure)) value)) input))
           (first (iterator output)))
      (be (get (js-call first :next) :value) 1) (rejects (lambda () (js-call first :next)) failure) (be closed 1)
      (let ((second (iterator output))) (be (get (js-call second :next) :value) 1) (rejects (lambda () (js-call second :next)) failure) (be closed 1)))))
  (test "lazy combinators compose infinite inputs without eager realization" (lambda ()
    (let* ((starts 0) (pulls 0)
           (source (lazySequence (lambda () (setq starts (1+ starts)) (naturalsView (lambda () (setq pulls (1+ pulls)))))))
           (output (lazyTake 3 (lazyFilter (lambda (value) (= (% value 2) 0)) (lazyMap (lambda (value) (* value 3)) source)))))
      (be (isLazySequence output) t) (same (js-array starts pulls) (js-array 0 0))
      (let ((first (iterator output)) (second (iterator output)))
        (same (js-call first :next) (js-object :value 6 :done false)) (same (js-array starts pulls) (js-array 1 2))
        (same (js-call second :next) (js-object :value 6 :done false)) (be pulls 2)
        (same (Array/from output) (js-array 6 12 18)) (be pulls 6)))))
  (test "lazy combinator family preserves transducer semantics" (lambda ()
    (same (Array/from (lazyMapIndexed (lambda (index value) (+ index value)) (js-array 10 20 30))) (js-array 10 21 32))
    (same (Array/from (lazyKeep (lambda (value) (if (= (% value 2) 0) (* value 10) nil)) (js-array 1 2 3 4))) (js-array 20 40))
    (same (Array/from (lazyKeepIndexed (lambda (index value) (if (= (% index 2) 0) value nil)) (js-array 10 20 30 40))) (js-array 10 30))
    (same (Array/from (lazyRemove (lambda (value) (= (% value 2) 0)) (js-array 1 2 3 4))) (js-array 1 3))
    (same (Array/from (lazyDrop 2 (js-array 1 2 3 4))) (js-array 3 4))
    (same (Array/from (lazyTakeWhile (lambda (value) (< value 4)) (js-array 1 2 3 4 1))) (js-array 1 2 3))
    (same (Array/from (lazyDropWhile (lambda (value) (< value 3)) (js-array 1 2 3 1))) (js-array 3 1))
    (same (Array/from (lazyTakeNth 2 (js-array 1 2 3 4 5))) (js-array 1 3 5))
    (same (Array/from (lazyInterpose "|" (js-array 1 2 3))) (js-array 1 "|" 2 "|" 3))
    (same (Array/from (lazyDedupe (js-array 1 1 2 1 1))) (js-array 1 2 1))
    (same (Array/from (lazyDistinct (js-array 1 2 1 3 2))) (js-array 1 2 3))
    (same (Array/from (lazyMapcat (lambda (value) (js-array value (* value 10))) (js-array 1 2))) (js-array 1 10 2 20))
    (same (js-call (Array/from (lazyPartitionAll 2 (js-array 1 2 3))) :map (lambda (group) (Array/from group))) (js-array (js-array 1 2) (js-array 3)))
    (same (js-call (Array/from (lazyPartitionBy (lambda (value) (% value 2)) (js-array 1 3 2 4 5))) :map (lambda (group) (Array/from group))) (js-array (js-array 1 3) (js-array 2 4) (js-array 5)))))
  (test "lazy combinators validate before consuming their inputs" (lambda ()
    (let* ((starts 0) (source (lazySequence (lambda () (setq starts (1+ starts)) (js-array 1 2 3)))))
      (js-call (expect (seq (lazyTake 0 source))) :toBeNull) (be starts 0)
      (rejects (lambda () (lazyMap (lambda (value) value))) "lazyMap requires exactly 2 arguments")
      (rejects (lambda () (lazyDedupe (js-array) (js-array))) "lazyDedupe requires exactly 1 argument")
      (rejects (lambda () (lazyFilter 42 source)) "must be a function")
      (rejects (lambda () (lazyTake -1 source)) "must be a non-negative safe integer")
      (rejects (lambda () (lazyPartitionAll 0 source)) "must be a positive safe integer") (be starts 0))))
  (test "lazy sequence APIs reject malformed producers and calls" (lambda ()
    (rejects (lambda () (lazySequence)) "requires exactly one thunk")
    (rejects (lambda () (lazySequence 42)) "must be a function")
    (rejects (lambda () (lazyCons 1)) "requires a value and tail thunk")
    (rejects (lambda () (lazyCons 1 2)) "must be a function")
    (rejects (lambda () (sequence (mapping (lambda (value) value)))) "requires a transducer and collection")
    (rejects (lambda () (sequence 42 (js-array))) "must be a function")))
  (test "Eliscript lazy sequences agree across compilers and local hosts" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-lazy-sequence-"))))
           (bootstrapDirectory (resolve directory "bootstrap")) (seedDirectory (resolve directory "seed")) (selfHostedDirectory (resolve directory "self-hosted")))
      (try
        (await (compileFamily seedCompiler seedDirectory))
        (await (seedCompilerFixture bootstrapDirectory))
        (await (compileFamily portableCompiler selfHostedDirectory (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrapDirectory)))
        (let ((index 0))
          (while (< index (get compilationUnits :length))
            (let ((output (aref (aref compilationUnits index) 1)))
              (be (await (js-call (Bun/file (resolve selfHostedDirectory output)) :text)) (await (js-call (Bun/file (resolve seedDirectory output)) :text)))
              (be (await (js-call (Bun/file (resolve selfHostedDirectory (str output ".map"))) :text)) (await (js-call (Bun/file (resolve seedDirectory (str output ".map"))) :text))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (roots (js-array seedDirectory selfHostedDirectory)) (index 0))
          (while (< index 2)
            (let ((modulePath (resolve (aref roots index) "tests/fixtures/lazy-sequence.mjs"))
                  (node (get (get globalThis.process :env) :NODE)))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array "bun" "--preload" bunPreload hostFixture modulePath) (js-object)))))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array (if (nullish? node) "node" node) "--experimental-loader" nodeLoader hostFixture modulePath) (js-object))))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (aref reports 0) (js-object "before" (js-array false 0) "values" (js-array 6 12 18 24) "after" (js-array t 4) "groups" (js-array (js-array 1 2 3) (js-array 4 5)) "indexed" (js-array 10 21 32) "kept" (js-array 20 40) "kept-indexed" (js-array 10 30) "removed" (js-array 1 3) "dropped" (js-array 3 4) "taken-while" (js-array 1 2 3) "dropped-while" (js-array 3 1) "sampled" (js-array 1 3 5) "interposed" (js-array 1 "|" 2 "|" 3) "deduped" (js-array 1 2 1) "distinct" (js-array 1 2 3) "mapped-cat" (js-array 1 10 2 20) "partitioned" (js-array (js-array 1 2) (js-array 3)) "partitioned-by" (js-array (js-array 1 3) (js-array 2 4) (js-array 5)) "predicate" t)))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
