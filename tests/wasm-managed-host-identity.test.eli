(module tests.wasm-managed-host-identity.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:buffer" Buffer)
  (import "node:fs/promises" readFile mkdtemp rm writeFile mkdir)
  (import "node:path" resolve dirname)
  (import "node:os" tmpdir)
  (import "node:process" :default process)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime instantiateManagedRuntimeWithHostModules)
  (import "../tools/backends/native-managed-runtime.mjs" instantiateNativeManagedRuntime)
  (import "../tools/backends/managed-module-graph.mjs" createManagedProjectFacades)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dyn-import (js* "(specifier) => import(specifier)"))

  (defvar projectCases nil)
  (defvar b nil)
  (defvar rt nil)
  (defvar program nil)
  (defvar bytes nil)
  (defvar lowered nil)
  (defvar directory nil)
  (defvar reference nil)
  (defvar projectFixture nil)

  (defconst options (js-object :maxSlots 2048 :initialBytes 65536 :maxBytes 16777216))
  (defconst boundarySource "(defun left (x) (host-identity-token x)) (defun right (x) (host-identity-token x)) (export left right)")

  (beforeAll
    (async ()
      (setq projectCases
        (JSON/parse (await (readFile (new globalThis.URL "./fixtures/managed-host-identity-projects.json" (js* "import.meta.url")) "utf8"))))
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-host-token-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq rt
        (js-call (get b :compiler) :compile_ir_string
                 (await (readFile "bootstrap/runtime/memory.eli" "utf8"))
                 "runtime.eli"))
      (setq program
        (js-call (get b :compiler) :compile_ir_string
                 (await (readFile "tests/fixtures/wasm-managed-host-identity.eli" "utf8"))
                 "host-identity.eli"))
      (setq reference
        (await (funcall dyn-import
                        (str "data:text/javascript;base64,"
                             (js-call (Buffer/from (js-call (get b :compiler) :emit_ir_string program))
                                      :toString "base64"))))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defun helper-runner ()
    (resolve "tests/helpers/wasm-managed-host-identity-node.mjs"))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (defun artifact ()
    (when (nullish? bytes)
      (let ((saved (JSON/stringify program)))
        (setq lowered (js-call (get b :managed) :lower_managed_program program rt))
        (setq bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm program rt)))
        (js-call assert :equal (JSON/stringify program) saved)
        (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))))
    bytes)

  (defun read-val (a v)
    (if (and (not (nullish? v)) (= (funcall js-typeof v) "object"))
      (let ((k (get v :kind)))
        (cond
          ((= k 4) (js-call a :readNumber v))
          ((= k 5) (js-call a :readString v))
          ((= k 14)
           (let ((out (js-array))
                 (len (js-call a :length v))
                 (i 0))
             (while (< i len)
               (let ((child (js-call a :get v i)))
                 (try
                   (js-call out :push (read-val a child))
                   (finally (js-call a :release child))))
               (setq i (+ i 1)))
             out))
          (t v)))
      v))

  (defun invoke-val (a name &rest __host_default_arguments_1)
    (let* ((args (aref __host_default_arguments_1 0)))
    (let ((out (js-call a :invoke name (if (undefined? args) (js-array) args))))
      (try
        (read-val a out)
        (finally (js-call a :release out))))))

  (defun finish-heap (a &rest __host_default_arguments_2)
    (let* ((values (aref __host_default_arguments_2 0)))
    (try
      (when (not (undefined? values))
        (js-call values :forEach (lambda (v) (js-call a :release v))))
      (js-call a :closeModule)
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
      (finally
        (when (not (nullish? (get a :close)))
          (js-call a :close))))))

  (defun check-identities (a)
    (js-call a :auto 1)
    (let ((x (js-call a :sourceObject (js-object)))
          (y (js-call a :sourceObject (js-object))))
      (try
        (let ((first-tok (invoke-val a "token" (js-array x)))
              (i 0))
          (js-call assert :equal first-tok 1)
          (js-call assert :equal (invoke-val a "alias" (js-array x)) first-tok)
          (js-call assert :equal (invoke-val a "nested" (js-array x)) first-tok)
          (js-call assert :equal (invoke-val a "token" (js-array y)) 2)
          (while (< i 8)
            (js-call a :collect)
            (js-call assert :equal (invoke-val a "token" (js-array x)) first-tok)
            (setq i (+ i 1)))
          (js-call assert :deepEqual (invoke-val a "effects") (js-array t (js-array 1 2)))
          (js-call assert :deepEqual (invoke-val a "abrupt") (js-array t (js-array 1)))
          (js-call assert :deepEqual (invoke-val a "no-conversion") (js-array))
          (let ((symbols (invoke-val a "symbol-case"))
                (functions (invoke-val a "function-case")))
            (js-call assert :equal (aref symbols 0) (aref symbols 2))
            (js-call assert :notEqual (aref symbols 0) (aref symbols 1))
            (js-call assert :equal (aref functions 0) (aref functions 2))
            (js-call assert :notEqual (aref functions 0) (aref functions 1))))
        (finally
          (finish-heap a (js-array x y))))))

  (test "Given the existing intrinsic when a module is lowered then its private identity table executes in zero-import WASM"
    (lambda ()
      (check-identities (instantiateManagedRuntime (artifact) options))))

  (test "Given scalar inputs when host identity is requested then original TypeError messages and later calls recover"
    (lambda ()
      (let* ((a (instantiateManagedRuntime (artifact) options))
             (values (js-array nil undefined false t (js-call a :number -0.0) (js-call a :number globalThis.NaN) (js-call a :string ""))))
        (js-call a :auto 1)
        (try
          (js-call values :forEach
            (lambda (x)
              (let ((raw (if (and (not (nullish? x)) (= (funcall js-typeof x) "object"))
                           (let ((k (get x :kind)))
                             (cond
                               ((= k 4) (js-call a :readNumber x))
                               ((= k 5) (js-call a :readString x))
                               (t x)))
                           x)))
                (js-call assert :equal (invoke-val a "safe" (js-array x)) (js-call reference :safe raw)))))
          (let ((obj (js-call a :sourceObject (js-object))))
            (try
              (js-call assert :equal (invoke-val a "token" (js-array obj)) 1)
              (finally (js-call a :release obj))))
          (finally
            (finish-heap a values))))))

  (test "Given wrong source and IR arity when lowering then no operand is dropped or accepted"
    (lambda ()
      (js-call (js-array "(host-identity-token)" "(host-identity-token 1 2)") :forEach
        (lambda (src)
          (js-call assert :throws (lambda () (js-call (get b :compiler) :compile_string src "arity.eli")))))
      (js-call (js-array 0 2) :forEach
        (lambda (cnt)
          (let* ((p (js-call (get b :compiler) :compile_ir_string "(defun token (x) (host-identity-token x))" "arity.eli"))
                 (node (js-call (get (aref (get p :body) 0) :children) :at -1)))
            (put node "children"
                 (if (= cnt 0)
                   (js-array)
                   (js-array (aref (get node :children) 0) (aref (get node :children) 0))))
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :lower_managed_program p rt))
              (lambda (e) (diag-code? e "ELI-B0001"))))))))

  (test "Given no intrinsic when an ordinary function is lowered then no hidden state or module ABI is allocated"
    (lambda ()
      (let* ((p (js-call (get b :compiler) :compile_ir_string "(defun identity (x) x) (export identity)" "plain.eli"))
             (out (js-call (get b :managed) :lower_managed_program p rt)))
        (js-call assert :equal (get (get out :descriptor) :abi) "managed-control-v1")
        (js-call assert :equal (get (get out :descriptor) :module) undefined))))

  (defasync get-project ()
    (if (not (nullish? projectFixture))
      projectFixture
      (let* ((project-sources (get projectCases :project))
             (base (resolve directory "project"))
             (entries (Object/entries project-sources))
             (modules (js-array))
             (i 0))
        (await (mkdir base))
        (while (< i (get entries :length))
          (let* ((entry (aref entries i))
                 (id (aref entry 0))
                 (src (aref entry 1))
                 (p (js-call (get b :compiler) :compile_ir_string src (js-call id :replace (new globalThis.RegExp "\\.mjs$") ".eli"))))
            (js-call modules :push (js-object :id id :program p))
            (await (writeFile (resolve base id) (js-call (get b :compiler) :emit_ir_string p))))
          (setq i (+ i 1)))
        (let* ((saved (JSON/stringify modules))
               (proj-lowered (js-call (get b :managed) :lower_managed_project modules "main.mjs" rt))
               (proj-bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "main.mjs" rt)))
               (rev-modules (js-call (Array/from modules) :reverse)))
          (js-call assert :equal (JSON/stringify modules) saved)
          (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module proj-bytes)) (js-array))
          (js-call assert :deepEqual (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm rev-modules "main.mjs" rt)) proj-bytes)
          (let ((child (spawnSync "node"
                                  (js-array (helper-runner) "project" (get (pathToFileURL (resolve base "main.mjs")) :href))
                                  (js-object :encoding "utf8" :timeout 10000))))
            (js-call assert :equal (get child :status) 0 (get child :stderr))
            (setq projectFixture
              (js-object :bytes proj-bytes
                         :lowered proj-lowered
                         :expected (JSON/parse (get child :stdout))))
            projectFixture)))))

  (defun check-encounters (a p)
    (js-call a :auto 1)
    (let ((x (js-call a :sourceObject (js-object)))
          (y (js-call a :sourceObject (js-object)))
          (left (js-call a :getExport "left"))
          (copy (js-call a :getExport "left_copy"))
          (exp (get p :expected)))
      (try
        (js-call assert :equal (js-call a :keyEqual left copy) (get exp :same))
        (js-call assert :deepEqual (invoke-val a "encounters" (js-array x y)) (get exp :values))
        (js-call assert :deepEqual (get exp :values) (js-array 1 2 1 2 1 1 2))
        (js-call assert :equal (invoke-val a "left" (js-array x)) 1)
        (js-call assert :equal (invoke-val a "right" (js-array x)) 2)
        (js-call assert :equal (invoke-val a "closure" (js-array x)) 1)
        (js-call assert :equal (invoke-val a "own" (js-array x)) 2)
        (finally
          (finish-heap a (js-array x y left copy))))))

  (test "Given linked modules with opposite encounter orders when imported aliases and closures are called then defining-module identity tables remain separate"
    (async ()
      (let ((p (await (get-project))))
        (check-encounters (instantiateManagedRuntime (get p :bytes) options) p)))
    30000)

  (defun check-heap-isolation (first-inst second-inst)
    (let ((x (js-call first-inst :sourceObject (js-object)))
          (y (js-call second-inst :sourceObject (js-object))))
      (try
        (js-call assert :equal (invoke-val first-inst "token" (js-array x)) 1)
        (js-call assert :equal (invoke-val second-inst "token" (js-array y)) 1)
        (js-call assert :equal (invoke-val first-inst "token" (js-array x)) 1)
        (js-call assert :equal (invoke-val second-inst "token" (js-array y)) 1)
        (js-call assert :throws
          (lambda () (js-call first-inst :invoke "token" (js-array y)))
          (lambda (e) (diag-code? e "ELI-RT0001")))
        (finally
          (try
            (finish-heap first-inst (js-array x))
            (finally
              (finish-heap second-inst (js-array y))))))))

  (test "Given two heaps executing identical module bytes when encounter order differs then tokens remain heap-local"
    (lambda ()
      (check-heap-isolation (instantiateManagedRuntime (artifact) options)
                            (instantiateManagedRuntime (artifact) options))))

  (test "Given an operand that collects or throws when identity is evaluated then exactly one evaluation and the original thrown identity survive"
    (lambda ()
      (let ((a (instantiateManagedRuntime (artifact) options)))
        (js-call a :auto 1)
        (try
          (js-call assert :deepEqual (invoke-val a "effects") (js-array t (js-array 1 2)))
          (js-call assert :deepEqual (invoke-val a "abrupt") (js-array t (js-array 1)))
          (finally
            (finish-heap a))))))

  (funcall (js-call test :skipIf (or (/= (get process :platform) "darwin") (/= (get process :arch) "arm64")))
    "Given a true native module and linked project when the same identities are encountered then the WASM and original JS contracts agree"
    (async ()
      (artifact)
      (let ((one (resolve directory "host-token.dylib")))
        (await (writeFile one (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos"))))
        (check-identities (await (instantiateNativeManagedRuntime one lowered options)))
        (check-heap-isolation (await (instantiateNativeManagedRuntime one lowered options))
                              (await (instantiateNativeManagedRuntime one lowered options))))
      (let* ((p (await (get-project)))
             (many (resolve directory "host-token-project.dylib")))
        (await (writeFile many (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get (get p :lowered) :typed) "arm64-macos"))))
        (check-encounters (await (instantiateNativeManagedRuntime many (get p :lowered) options)) p)))
    120000)

  (test "Given cyclic modules before the defining module evaluates when an exported function uses its helper then the original TDZ is preserved"
    (async ()
      (let* ((sources (get projectCases :cycle))
             (base (resolve directory "cycle"))
             (entries (Object/entries sources))
             (modules (js-array))
             (i 0))
        (await (mkdir base))
        (while (< i (get entries :length))
          (let* ((entry (aref entries i))
                 (id (aref entry 0))
                 (src (aref entry 1))
                 (p (js-call (get b :compiler) :compile_ir_string src (js-call id :replace (new globalThis.RegExp "\\.mjs$") ".eli"))))
            (js-call modules :push (js-object :id id :program p))
            (await (writeFile (resolve base id) (js-call (get b :compiler) :emit_ir_string p))))
          (setq i (+ i 1)))
        (let ((child (spawnSync "node"
                                (js-array (helper-runner) "early-str" (get (pathToFileURL (resolve base "main.mjs")) :href))
                                (js-object :encoding "utf8" :timeout 10000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))
          (js-call assert :equal (js-call (get child :stdout) :trim) "ReferenceError")
          (let ((a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "main.mjs" rt)) options)))
            (try
              (let ((early (js-call a :getExport "early")))
                (try
                  (js-call assert :equal (js-call a :readString early) (js-call (get child :stdout) :trim))
                  (finally (js-call a :release early))))
              (finally (finish-heap a)))))))
    30000)

  (test "Given identical zero-import bytes when Node calls imported aliases then module identity behavior remains the same"
    (async ()
      (let* ((p (await (get-project)))
             (wasm-path (resolve directory "host-token-project.wasm")))
        (await (writeFile wasm-path (get p :bytes)))
        (let ((child (spawnSync "node"
                                (js-array (helper-runner) "wasm-encounters" wasm-path (JSON/stringify (get p :expected)))
                                (js-object :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr)))))
    40000)

  (test "Given a cyclic early helper call when its operand has effects and throws then callee TDZ precedes every operand effect"
    (async ()
      (let* ((sources (js-object
                        "trace.mjs" "(defconst trace (js-array)) (export trace)"
                        "main.mjs" "(import \"./trace.mjs\" trace) (import \"./early.mjs\" early) (defun token () (host-identity-token (progn (js-call trace :push \"arg\") (throw \"operand\")))) (export early token)"
                        "early.mjs" "(import \"./main.mjs\" token) (import \"./trace.mjs\" trace) (defconst early (try (token) (catch error (js-array (get error :name) (= error \"operand\") trace)))) (export early)"))
             (base (resolve directory "cycle-operands"))
             (entries (Object/entries sources))
             (modules (js-array))
             (i 0))
        (await (mkdir base))
        (while (< i (get entries :length))
          (let* ((entry (aref entries i))
                 (id (aref entry 0))
                 (src (aref entry 1))
                 (p (js-call (get b :compiler) :compile_ir_string src (js-call id :replace (new globalThis.RegExp "\\.mjs$") ".eli"))))
            (js-call modules :push (js-object :id id :program p))
            (await (writeFile (resolve base id) (js-call (get b :compiler) :emit_ir_string p))))
          (setq i (+ i 1)))
        (let ((child (spawnSync "node"
                                (js-array (helper-runner) "early-json" (get (pathToFileURL (resolve base "main.mjs")) :href))
                                (js-object :encoding "utf8" :timeout 10000))))
          (js-call assert :equal (get child :status) 0 (get child :stderr))
          (let ((expected (JSON/parse (get child :stdout))))
            (js-call assert :deepEqual expected (js-array "ReferenceError" false (js-array)))
            (let ((a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm modules "main.mjs" rt)) options)))
              (js-call a :auto 1)
              (try
                (let ((early (js-call a :getExport "early")))
                  (try
                    (js-call assert :deepEqual (read-val a early) expected)
                    (finally (js-call a :release early))))
                (finally (finish-heap a))))))))
    30000)

  ;; This helper serializes a real lowerer's product. It supplies no executable
  ;; implementation: private identity tables and initialization run in the bytes.
  (defun grouped-identity-product (input groups)
    (let* ((low (js-call (get b :managed) :lower_managed_program input rt false undefined undefined groups))
           (binary (js-call (get b :wasm) :emit_typed_memory_wasm (get low :typed)))
           (prod-bytes (Uint8Array/from
                         (js-call (get b :wasm) :append_metadata_section
                                  binary "eliscript-managed-control" (JSON/stringify (get low :descriptor))))))
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module prod-bytes)) (js-array))
      (js-object :bytes prod-bytes :lowered low)))

  (defun collect-identity-nodes (input)
    (let ((found (js-array))
          (pending (js-call (Array/from (get input :body)) :reverse)))
      (while (> (get pending :length) 0)
        (let ((node (js-call pending :pop)))
          (when (and (= (get node :kind) "intrinsic") (= (get node :value) "host-identity-token"))
            (js-call found :push node))
          (js-call (js-call (Array/from (get node :children)) :reverse) :forEach
            (lambda (child) (js-call pending :push child)))))
      found))

  (defun check-identity-boundary (a)
    (js-call a :auto 1)
    (let ((x (js-call a :sourceObject (js-object)))
          (y (js-call a :sourceObject (js-object))))
      (try
        (js-call assert :equal (invoke-val a "left" (js-array x)) 1)
        (js-call assert :equal (invoke-val a "right" (js-array y)) 2)
        (js-call assert :equal (invoke-val a "left" (js-array y)) 2)
        (js-call assert :equal (invoke-val a "right" (js-array x)) 1)
        (js-call a :collect)
        (js-call assert :equal (invoke-val a "left" (js-array x)) 1)
        (finally (finish-heap a (js-array x y))))))

  (test "Given only functions and no source globals when the default nil boundary is lowered then one private table initializes before the first call"
    (lambda ()
      (let* ((input (js-call (get b :compiler) :compile_ir_string boundarySource "function-only-identity.eli"))
             (saved (JSON/stringify input))
             (product (grouped-identity-product input undefined)))
        (js-call assert :equal (JSON/stringify input) saved)
        (js-call assert :equal (get (get (get (get product :lowered) :descriptor) :module) :bindingCount) 1)
        (check-identity-boundary (instantiateManagedRuntime (get product :bytes) options))
        (js-call (js-array nil undefined) :forEach
          (lambda (before)
            (let ((explicit (grouped-identity-product input (js-array (js-object :nodes (collect-identity-nodes input) :before before)))))
              (js-call assert :deepEqual (get explicit :bytes) (get product :bytes))
              (check-identity-boundary (instantiateManagedRuntime (get explicit :bytes) options))))))))

  (test "Given a first source initializer that invokes identity when module state is created then the private helper precedes source effects without changing global indices"
    (lambda ()
      (let* ((src (str "(defconst trace (js-array)) "
                       "(defun encounter () (let ((item (js-object))) (js-call trace :push (host-identity-token item)))) "
                       "(defconst first (encounter)) (defconst second (encounter)) "
                       "(defun run () (js-array first second trace)) (export run)"))
             (input (js-call (get b :compiler) :compile_ir_string src "identity-first-initializer.eli"))
             (product (grouped-identity-product input undefined))
             (a (instantiateManagedRuntime (get product :bytes) options)))
        (js-call assert :equal (get (get (get (get product :lowered) :descriptor) :module) :bindingCount) 4)
        (try
          (js-call assert :deepEqual (invoke-val a "run") (js-array 1 2 (js-array 1 2)))
          (js-call a :collect)
          (js-call assert :deepEqual (invoke-val a "run") (js-array 1 2 (js-array 1 2)))
          (finally (finish-heap a))))))

  (test "Given multiple explicit groups at one empty-global boundary when functions execute then group-index insertion retains separate monotonic identity tables"
    (lambda ()
      (let* ((input (js-call (get b :compiler) :compile_ir_string boundarySource "identity-shared-boundary.eli"))
             (nodes (collect-identity-nodes input))
             (product (grouped-identity-product input
                        (js-array (js-object :nodes (js-array (aref nodes 0)) :before (aref (get input :body) 0))
                                  (js-object :nodes (js-array (aref nodes 1)) :before (aref (get input :body) 1)))))
             (a (instantiateManagedRuntime (get product :bytes) options))
             (x (js-call a :sourceObject (js-object)))
             (y (js-call a :sourceObject (js-object))))
        (js-call assert :equal (get (get (get (get product :lowered) :descriptor) :module) :bindingCount) 2)
        (js-call a :auto 1)
        (try
          (js-call assert :equal (invoke-val a "left" (js-array x)) 1)
          (js-call assert :equal (invoke-val a "left" (js-array y)) 2)
          (js-call assert :equal (invoke-val a "right" (js-array y)) 1)
          (js-call assert :equal (invoke-val a "right" (js-array x)) 2)
          (js-call a :collect)
          (js-call assert :equal (invoke-val a "left" (js-array x)) 1)
          (js-call assert :equal (invoke-val a "right" (js-array y)) 1)
          (finally (finish-heap a (js-array x y)))))))

  (test "Given malformed group records or a foreign before node when lowering then structured ownership rejection precedes any metadata dereference"
    (lambda ()
      (let* ((input (js-call (get b :compiler) :compile_ir_string boundarySource "identity-invalid-boundary.eli"))
             (nodes (collect-identity-nodes input))
             (invalid (js-array nil false "group" (js-array) (js-object)
                                (js-object :nodes (js-array))
                                (js-object :nodes (js-array) :before nil)
                                (js-object :nodes nodes :before false)
                                (js-object :nodes nodes :before 0)
                                (js-object :nodes nodes :before "not-a-node")
                                (js-object :nodes nodes :before (js-object))
                                (js-object :nodes nodes :before (globalThis.structuredClone (aref (get input :body) 0))))))
        (js-call invalid :forEach
          (lambda (record)
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :lower_managed_program input rt false undefined undefined (js-array record)))
              (lambda (err)
                (and (diag-code? err "ELI-B0001")
                     (= (get err :message) "invalid managed host identity group"))))))
        (js-call (js-array (js-array)
                           (js-array (js-object :nodes (js-array (aref nodes 0)) :before nil))
                           (js-array (js-object :nodes nodes :before nil) (js-object :nodes (js-array (aref nodes 0)) :before nil))
                           (js-array (js-object :nodes (js-array (globalThis.structuredClone (aref nodes 0))) :before nil))) :forEach
          (lambda (groups)
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :lower_managed_program input rt false undefined undefined groups))
              (lambda (err) (diag-code? err "ELI-B0001")))))
        (check-identity-boundary (instantiateManagedRuntime (get (grouped-identity-product input undefined) :bytes) options)))))

  (test "Given malformed identity IR when the independent source prepass rejects it then direct lowering retains the original Error message and exact structured node span"
    (lambda ()
      (let ((src ";; 中😀\n(defun token (x)\n (host-identity-token x)) (export token)"))
        (js-call (js-array 0 2) :forEach
          (lambda (cnt)
            (let* ((input (js-call (get b :compiler) :compile_ir_string src "identity-arity-中.eli"))
                   (node (aref (collect-identity-nodes input) 0))
                   (operand (aref (get node :children) 0)))
              (put node "children"
                   (if (= cnt 0)
                     (js-array)
                     (js-array operand (globalThis.structuredClone operand))))
              (js-call assert :throws
                (lambda () (js-call (get b :managed) :lower_managed_program input rt))
                (lambda (err)
                  (let ((diagnostic (get err :eliscriptDiagnostic)))
                    (js-call assert :equal (get err :name) "Error")
                    (js-call assert :equal (if (nullish? diagnostic) undefined (get diagnostic :code)) "ELI-B0001")
                    (js-call assert :equal (get diagnostic :phase) "managed-backend")
                    (js-call assert :equal (get diagnostic :message) (get err :message))
                    (js-call assert :equal (get err :message) (str "host-identity-token expects 1 argument, got " cnt))
                    (js-call assert :equal (get err :eliscriptIRSpan) (get node :span))
                    (js-call assert :deepEqual (get diagnostic :location)
                      (js-object
                        :file "identity-arity-中.eli"
                        :start (js-object :offset (get (get node :span) :start)
                                          :line (get (get node :span) :line)
                                          :column (get (get node :span) :column))
                        :end (js-object :offset (get (get node :span) :end)
                                        :line (get (get node :span) :endLine)
                                        :column (get (get node :span) :endColumn))))
                    t)))))))))

  (funcall (js-call test :skipIf (or (/= (get process :arch) "arm64")
                                     (not (js-call (js-array "darwin" "linux") :includes (get process :platform)))))
    "Given a true native function-only module when its absent project boundary initializes then native preserves the same one-table token order"
    (async ()
      (let* ((product (grouped-identity-product (js-call (get b :compiler) :compile_ir_string boundarySource "identity-native-boundary.eli") undefined))
             (target (if (= (get process :platform) "linux") "arm64-linux" "arm64-macos"))
             (lib-path (resolve directory (str "identity-native-boundary" (if (= (get process :platform) "linux") ".so" ".dylib")))))
        (await (writeFile lib-path (Uint8Array/from (js-call (get b :native) :emit_typed_native_memory_library (get (get product :lowered) :typed) target))))
        (check-identity-boundary (await (instantiateNativeManagedRuntime lib-path (get product :lowered) options)))))
    120000)

  (test "Given phased projects when each defining module reaches its evaluation boundary then private helpers stay out of preparation and cyclic TDZ still precedes operand effects"
    (async ()
      (let ((names (js-array "project" "cycle" "cycleOperands"))
            (idx 0))
        (while (< idx (get names :length))
          (let* ((name (aref names idx))
                 (modules (js-call (Object/entries (aref projectCases name))
                            :map (lambda (entry)
                                   (let ((id (aref entry 0))
                                         (src (aref entry 1)))
                                     (js-object :id id
                                                :program (js-call (get b :compiler) :compile_ir_string src (js-call id :replace (new globalThis.RegExp "\\.mjs$") ".eli")))))))
                 (saved (JSON/stringify modules))
                 (low (js-call (get b :managed) :lower_managed_project modules "main.mjs" rt (js-object :phased t))))
            (js-call assert :equal (JSON/stringify modules) saved)
            (funcall assert (get (get low :descriptor) :project))
            (when (= name "project")
              (js-call (js-array "a.mjs" "b.mjs") :forEach
                (lambda (id)
                  (let ((m (js-call (get (get (get low :descriptor) :project) :modules) :find (lambda (mod) (= (get mod :id) id)))))
                    (funcall assert m)
                    (js-call assert :equal (get (get m :steps) :length) 1 "function-only module retains its own helper evaluation step")))))
            (let* ((phased-bytes (Uint8Array/from
                                   (js-call (get b :wasm) :append_metadata_section
                                            (js-call (get b :wasm) :emit_typed_memory_wasm (get low :typed))
                                            "eliscript-managed-control"
                                            (JSON/stringify (get low :descriptor)))))
                   (deployment (resolve directory (str "phased-" name)))
                   (files (get (createManagedProjectFacades (get low :descriptor) (js-object :entry "main.mjs")) :files))
                   (fi 0))
              (while (< fi (get files :length))
                (let* ((file (aref files fi))
                       (filename (resolve deployment (get file :id))))
                  (await (mkdir (dirname filename) (js-object :recursive t)))
                  (await (writeFile filename (get file :source))))
                (setq fi (+ fi 1)))
              (let ((a (await (instantiateManagedRuntimeWithHostModules phased-bytes
                                (Object/assign (js-object) options
                                  (js-object :projectModuleBaseURL (get (pathToFileURL (str deployment "/")) :href)))))))
                (js-call a :auto 1)
                (if (= name "project")
                  (let ((p (await (get-project))))
                    (check-encounters a p))
                  (try
                    (let ((early (js-call a :getExport "early")))
                      (try
                        (js-call assert :deepEqual (read-val a early)
                          (if (= name "cycle") "ReferenceError" (js-array "ReferenceError" false (js-array))))
                        (finally (js-call a :release early))))
                    (finally (finish-heap a)))))))
          (setq idx (+ idx 1)))))
    120000)

  (test "Given finite JSON identity domains when linking without serialization then escaped keys values and normalized binding spellings choose the original exact salt"
    (async ()
      (let* ((sym-mod (await (funcall dyn-import (get (pathToFileURL (resolve directory "bootstrap/symbol.mjs")) :href))))
             (binding-name-fn (get sym-mod :binding_name))
             (binding-kinds (new globalThis.Set
                              (js-array "function-declaration" "variable-declaration" "parameter-binding" "lexical-binding"
                                        "binding-name" "catch-binding" "import-named" "import-default" "import-namespace")))
             (original-prefix (lambda (modules)
                                (let ((identity (JSON/stringify modules))
                                      (pending (js-call modules :flatMap (lambda (m) (get (get m :program) :body))))
                                      (salt 0))
                                  (while (> (get pending :length) 0)
                                    (let ((node (js-call pending :pop)))
                                      (when (js-call binding-kinds :has (get node :kind))
                                        (let ((key (get node :value)))
                                          (try
                                            (setq key (funcall binding-name-fn key))
                                            (catch _ignored nil))
                                          (setq identity (str identity " " key))))
                                      (js-call (get node :children) :forEach
                                        (lambda (c) (js-call pending :push c)))))
                                  (while (js-call identity :includes (str "$eliscript_link_" salt "_"))
                                    (setq salt (+ salt 1)))
                                  (str "$eliscript_link_" salt "_"))))
             (special-obj (js-object))
             (nested-obj (js-object))
             (payloads nil))
        (put special-obj "quoted\"\\\n$eliscript_link_1_" "$eliscript_link_0_")
        (put nested-obj "$eliscript_link_24_" (str (String/fromCharCode 0) "😀" (String/fromCharCode 55296) "$eliscript_link_25_"))
        (setq payloads
          (js-array (js-object)
                    (js-object :text "$eliscript_link_0_")
                    special-obj
                    (js-object :text "$eliscript_link_00_ $eliscript_link_000_ $eliscript_link_999999999999999999999999999999999999999999999999_")
                    (js-object :text (js-call (Array/from (js-object :length 24) (lambda (_ index) (str "$eliscript_link_" index "_"))) :join " ")
                               :nested (js-array nested-obj))))
        (js-call (js-array "token" "$eliscript-link-0-") :forEach
          (lambda (name)
            (js-call payloads :forEach
              (lambda (payload)
                (let ((p (js-call (get b :compiler) :compile_ir_string (str "(defun " name " () 1) (export " name ")") "prefix-中.eli")))
                  (Object/assign (get (aref (get p :body) 0) :properties) (globalThis.structuredClone payload))
                  (let* ((modules (js-array (js-object :id "main.mjs" :program p)))
                         (saved (JSON/stringify modules))
                         (prefix (funcall original-prefix modules))
                         (linked (js-call (get b :managed) :link_managed_project modules "main.mjs")))
                    (js-call assert :equal (get (get linked :exports) :length) 1)
                    (js-call assert :equal (get (aref (get linked :exports) 0) :internalName) (str prefix "0"))
                    (js-call assert :equal (JSON/stringify modules) saved)))))))
        (let ((p (js-call (get b :compiler) :compile_ir_string "(defun token () 1) (export token)" "invalid-prefix.eli")))
          (put (get (aref (get p :body) 0) :properties) "$eliscript_link_0_" undefined)
          (js-call assert :throws
            (lambda () (js-call (get b :managed) :link_managed_project (js-array (js-object :id "main.mjs" :program p)) "main.mjs"))
            (lambda (err)
              (and (diag-code? err "ELI-I0001")
                   (js-call (new globalThis.RegExp "unsupported JSON type undefined") :test (get err :message)))))
          (let ((first-mod (js-call (get b :compiler) :compile_ir_string "(defun first () 1)" "first-invalid.eli")))
            (put (get (aref (get first-mod :body) 0) :properties) "bad" globalThis.NaN)
            (js-call assert :throws
              (lambda ()
                (js-call (get b :managed) :link_managed_project
                         (js-array (js-object :id "first.mjs" :program first-mod)
                                   (js-object :id "later.mjs" :program p))
                         "first.mjs"))
              (lambda (err)
                (and (diag-code? err "ELI-I0001")
                     (js-call (new globalThis.RegExp "finite numbers") :test (get err :message))))))))))

  (test "Given exported reachable namespaces and unused imported namespaces when linking then only actual module order owns namespace bindings independent of input order"
    (lambda ()
      (let* ((sources (js-object
                        "main.mjs" "(import \"./a.mjs\" :as a) (export a)"
                        "a.mjs" "(defun token (x) (host-identity-token x)) (export token)"
                        "unused.mjs" "(import \"./hidden.mjs\" :as hidden) (export hidden)"
                        "hidden.mjs" "(defconst value \"$eliscript_link_0_\") (export value)"))
             (modules (js-call (Object/entries sources)
                        :map (lambda (entry)
                               (let ((id (aref entry 0))
                                     (src (aref entry 1)))
                                 (js-object :id id :program (js-call (get b :compiler) :compile_ir_string src (str id ".eli")))))))
             (saved (JSON/stringify modules))
             (linked (js-call (get b :managed) :link_managed_project modules "main.mjs")))
        (js-call assert :deepEqual (get linked :modules) (js-array "a.mjs" "main.mjs"))
        (js-call assert :equal (get (get linked :namespaces) :length) 1)
        (js-call assert :deepEqual
          (js-call (get (aref (get linked :namespaces) 0) :entries) :map (lambda (entry) (get entry :name)))
          (js-array "token"))
        (js-call assert :deepEqual
          (js-call (get linked :exports) :map (lambda (entry) (get entry :name)))
          (js-array "a"))
        (funcall assert
          (js-call (get (get linked :program) :body) :some
            (lambda (node)
              (and (= (get node :kind) "variable-declaration")
                   (= (get node :value) (get (aref (get linked :exports) 0) :internalName))
                   (not (nullish? (aref (get node :children) 0)))
                   (= (get (aref (get node :children) 0) :kind) "managed-module-namespace")))))
        (let ((reversed (js-call (get b :managed) :link_managed_project (js-call (Array/from modules) :reverse) "main.mjs")))
          (js-call assert :deepEqual reversed linked)
          (js-call assert :equal (JSON/stringify modules) saved))))))
