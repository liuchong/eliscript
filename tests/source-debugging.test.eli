(module tests.source-debugging
  (import "bun:test" beforeAll expect test)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../bootstrap/host/bun.mjs" loadCompiler)
  (import "../bootstrap/host/evaluation.mjs" EvaluationSession)
  (import "../runtime/source-mapping.mjs" SourceMappingError mapSourceFrames parseJavaScriptStack sourceMapDescriptor)
  (import "../tools/debugging/check.mjs" checkSourceDebuggingCorpus SourceDebuggingCorpusError validateSourceDebuggingCorpus)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst ROOT (fileURLToPath (new globalThis.URL ".." (js* "import.meta.url"))))
  (defconst HOST_FIXTURE (resolve ROOT "tests/fixtures/source-debugging-host.mjs"))
  (defconst RUNTIME_FIXTURE (resolve ROOT "tests/fixtures/evaluation-session/main.eli"))
  (defvar compiler undefined)
  (beforeAll (async () (setq compiler (await (loadCompiler)))))
  (defasync contract () (JSON/parse (await (readFile (resolve ROOT "contracts/source-debugging-corpus.json") "utf8"))))
  (defun acceptanceCase (value id)
    (let ((entry (js-call (get value :cases) :find (lambda (candidate) (= (get candidate :id) id)))))
      (when (nullish? entry) (throw (new globalThis.Error (str "missing source debugging case " id)))) entry))
  (defasync run (command options)
    (let* ((child (Bun/spawn command (copyHostRecord (js-object :cwd ROOT :stdout "pipe" :stderr "pipe") (if (= options undefined) (js-object) options))))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2))))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))
  (test "source mapping decodes V8 and browser stack dialects without a host API" (lambda ()
    (let* ((descriptor (sourceMapDescriptor (js-object :generatedFile "https://example.test/program.mjs" :sources (js-array "https://example.test/program.eli") :mappings "AAAA")))
           (frames (parseJavaScriptStack (js-call (js-array "Error: broken" "    at run (https://example.test/program.mjs?rev=1:1:1)" "event@https://example.test/program.mjs#loaded:1:1") :join "\n"))))
      (same (mapSourceFrames frames (js-array descriptor)) (js-array (js-object "function" "run" "file" "https://example.test/program.eli" "line" 1 "column" 1 "generated" (js-object "file" "https://example.test/program.mjs?rev=1" "line" 1 "column" 1)) (js-object "function" "event" "file" "https://example.test/program.eli" "line" 1 "column" 1 "generated" (js-object "file" "https://example.test/program.mjs#loaded" "line" 1 "column" 1))))
      (js-call (expect (lambda () (sourceMapDescriptor (js-object :generatedFile "broken.mjs" :sources (js-array "broken.eli") :mappings "!")))) :toThrow SourceMappingError))))
  (test "compiler failure preserves its complete Eliscript source span" (async ()
    (let* ((value (await (contract))) (entry (acceptanceCase value "compiler")) (result (await (run (js-array "./bin/eliscript" "--diagnostic-format" "json" (get entry :source))))))
      (be (get result :exitCode) 1) (be (get result :stdout) "")
      (let ((diagnostic (JSON/parse (get result :stderr))))
        (be (get (get diagnostic :location) :file) (resolve ROOT (get entry :source)))
        (same (get (get diagnostic :location) :start) (get (get entry :location) :start))
        (same (get (get diagnostic :location) :end) (get (get entry :location) :end))))))
  (test "runtime failure maps through persistent evaluation" (async ()
    (let* ((value (await (contract))) (entry (acceptanceCase value "runtime")) (session (await (js-call EvaluationSession :create (js-object :compiler compiler)))))
      (try
        (let ((source (await (readFile RUNTIME_FIXTURE "utf8"))))
          (be (get (await (js-call session :execute (js-object :id 1 :operation "load" :source source :filename RUNTIME_FIXTURE :root ROOT))) :status) "ok"))
        (let ((failure (await (js-call session :execute (js-object :id 2 :operation "evaluate" :source "(explode)" :filename RUNTIME_FIXTURE)))))
          (be (get failure :status) "error")
          (same (get (get failure :diagnostic) :location) (copyHostRecord (js-object :file (resolve ROOT (get entry :source))) (get entry :location)))
          (js-call (expect (js-call (get (get (get failure :diagnostic) :location) :file) :endsWith ".mjs")) :toBeFalse))
        (finally (js-call session :close))))))
  (test "browser event and async rejection map under Bun and Node" (async ()
    (let ((value (await (contract))) (directory (await (mkdtemp (resolve (tmpdir) "eliscript-source-debugging-")))))
      (try
        (let* ((moduleFile (resolve directory "source-debugging.mjs"))
               (built (await (run (js-array "./bin/eliscript" "--source-map" "--output" moduleFile (resolve ROOT "tests/fixtures/source-debugging.eli"))))))
          (be (get built :exitCode) 0) (be (get built :stderr) "")
          (let* ((environment (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_DEBUG_MODULE moduleFile :ELISCRIPT_DEBUG_SOURCE_MAP (str moduleFile ".map"))))
                 (results (await (Promise/all (js-array (run (js-array (get globalThis.process :execPath) HOST_FIXTURE) (js-object :env environment)) (run (js-array "node" HOST_FIXTURE) (js-object :env environment)))))))
            (js-call results :forEach (lambda (result) (be (get result :exitCode) 0) (be (get result :stderr) "")))
            (js-call (js-call results :map (lambda (result) (JSON/parse (get result :stdout)))) :forEach (lambda (failures)
              (same (js-call failures :map (lambda (entry) (get entry :kind))) (js-array "browser-event" "async-rejection"))
              (js-call failures :forEach (lambda (record)
                (let* ((kind (get record :kind)) (failure (get record :failure)) (entry (acceptanceCase value kind)) (location (get failure :location)))
                  (js-call (expect location) :toMatchObject (copyHostRecord (js-object :file (resolve ROOT (get entry :source))) (get entry :location)))
                  (js-call (expect (get (get location :generated) :file)) :toContain ".mjs")
                  (js-call (expect (js-call (get location :file) :endsWith ".eli")) :toBeTrue))))))))
        (finally (await (rm directory (js-object :recursive t :force t))))))))
  (test "source debugging corpus is complete and rejects evidence drift" (async ()
    (let ((checked (await (checkSourceDebuggingCorpus (js-object :root ROOT)))))
      (same (js-call (get checked :cases) :map (lambda (entry) (get entry :id))) (js-array "compiler" "runtime" "browser-event" "async-rejection" "worker")))
    (let ((changed (await (contract))))
      (js-call (get changed :cases) :pop)
      (await (js-call (get (expect (validateSourceDebuggingCorpus changed (js-object :root ROOT))) :rejects) :toBeInstanceOf SourceDebuggingCorpusError)))))
)
