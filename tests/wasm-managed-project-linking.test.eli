(module tests.wasm-managed-project-linking.test
  (import "bun:test" afterAll beforeAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdir mkdtemp readFile rm writeFile)
  (import "node:path" dirname resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends root)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)

  (defconst js-typeof (js* "(v) => typeof v"))
  (defconst dynamic-import (js* "(specifier) => import(specifier)"))

  (defvar directory nil)
  (defvar b nil)
  (defvar runtime nil)
  (defvar sequence 0)

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-project-links-"))))
      (setq b (await (buildBackends (js-object :outputRoot directory))))
      (setq runtime (js-call (get b :compiler) :compile_ir_string
                      (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8"))
                      "runtime.eli")))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (defasync make-project (sources &rest __host_default_arguments_1)
    (let* ((entry (aref __host_default_arguments_1 0)))
    (let* ((ent (if (undefined? entry) "main.mjs" entry))
           (seq sequence)
           (base (resolve directory (str "project-" seq)))
           (modules (js-array))
           (pairs (Object/entries sources))
           (i 0))
      (setq sequence (+ sequence 1))
      (await (mkdir base))
      (while (< i (length pairs))
        (let* ((pair (aref pairs i))
               (id (aref pair 0))
               (source (aref pair 1))
               (program (js-call (get b :compiler) :compile_ir_string source (js-call id :replace (js* "/\\.mjs$/") ".eli")))
               (file (resolve base id)))
          (js-call modules :push (js-object :id id :program program))
          (await (mkdir (dirname file) (js-object :recursive t)))
          (await (writeFile file (js-call (get b :compiler) :emit_ir_string program))))
        (setq i (+ i 1)))
      (js-object
        :modules modules
        :entry ent
        :base base
        :reference (lambda () (funcall dynamic-import (get (pathToFileURL (resolve base ent)) :href)))))))

  (defun serialize-modules (modules)
    (js-call modules :map
      (lambda (m)
        (js-array (get m :id) (js-call (get b :compiler) :serialize_ir_program (get m :program))))))

  (defun emit-project (p)
    (let* ((saved (serialize-modules (get p :modules)))
           (bytes (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm (get p :modules) (get p :entry) runtime))))
      (js-call assert :deepEqual (serialize-modules (get p :modules)) saved)
      (js-call assert :deepEqual (WebAssembly.Module/imports (new globalThis.WebAssembly.Module bytes)) (js-array))
      bytes))

  (defun call-number (a name &rest __host_default_arguments_2)
    (let* ((args (aref __host_default_arguments_2 0)))
    (let ((out (js-call a :invoke name (if (undefined? args) (js-array) args))))
      (try
        (js-call a :readNumber out)
        (finally (js-call a :release out))))))

  (defun finish (a &rest __host_default_arguments_3)
    (let* ((values (aref __host_default_arguments_3 0)) (close-mod (aref __host_default_arguments_3 1)))
    (let ((owned (if (undefined? values) (js-array) values))
          (should-close (if (undefined? close-mod) t close-mod)))
      (js-call owned :forEach (lambda (x) (js-call a :release x)))
      (when should-close
        (js-call a :closeModule))
      (js-call a :collect)
      (js-call assert :equal (js-call a :live) 0)
      (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))))

  (defun diag-code? (e code)
    (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object"))
                  (get e :eliscriptDiagnostic)
                  nil)))
      (and (not (nullish? diag)) (= (get diag :code) code))))

  (defun deep-freeze (x)
    (when (and (not (nullish? x)) (= (funcall js-typeof x) "object"))
      (Object/freeze x)
      (js-call (Object/values x) :forEach (lambda (v) (deep-freeze v)))))

  (defconst live-sources
    (js-object
      "lib.mjs" "(defvar counter 0) (defun tick () (setq counter (1+ counter))) (defun current () counter) (export counter tick current)"
      "main.mjs" "(import \"./lib.mjs\" counter tick current) (defun read () counter) (defun advance () (tick) (current)) (export counter tick read advance)"))

  (test "named imports and reexports share the original live binding and execute entirely in WASM"
    (async ()
      (let* ((p (await (make-project live-sources)))
             (ref (await (js-call p :reference))))
        (js-call assert :equal (js-call ref :advance) 1)
        (let ((a (instantiateManagedRuntime (emit-project p))))
          (js-call a :auto 1)
          (js-call assert :equal (call-number a "advance") 1)
          (let ((value (js-call a :getExport "counter")))
            (js-call assert :equal (js-call a :readNumber value) (get ref :counter))
            (js-call a :release value))
          (let ((i 0))
            (while (< i 24)
              (js-call assert :equal (call-number a "advance") (js-call ref :advance))
              (js-call a :collect)
              (js-call assert :equal (call-number a "read") (js-call ref :read))
              (setq i (+ i 1))))
          (finish a)))))

  (test "module evaluation follows import source order through diamonds and executes each body once"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "state.mjs" "(defconst log (js-array)) (defun mark (x) (js-call log :push x)) (export log mark)"
                           "left.mjs" "(import \"./state.mjs\" mark) (mark 1) (defconst left 11) (export left)"
                           "right.mjs" "(import \"./state.mjs\" mark) (mark 2) (defconst right 22) (export right)"
                           "main.mjs" "(import \"./left.mjs\" left) (import \"./right.mjs\" right) (import \"./state.mjs\" log mark) (mark 3) (defun sum () (+ left right)) (export log sum)"))))
             (ref (await (js-call p :reference))))
        (js-call assert :deepEqual (get ref :log) (js-array 1 2 3))
        (let* ((bytes (emit-project p))
               (a (instantiateManagedRuntime bytes)))
          (js-call a :initializeModule)
          (js-call a :initializeModule)
          (js-call assert :equal (call-number a "sum") (js-call ref :sum))
          (let ((log (js-call a :getExport "log"))
                (i 0))
            (js-call assert :equal (js-call a :length log) 3)
            (while (< i 3)
              (let ((v (js-call a :get log i)))
                (js-call assert :equal (js-call a :readNumber v) (aref (get ref :log) i))
                (js-call a :release v))
              (setq i (+ i 1)))
            (finish a (js-array log)))
          (let ((reversed (js-call (Array/from (get p :modules)) :reverse)))
            (js-call assert :deepEqual (emit-project (Object/assign (js-object) p (js-object :modules reversed))) bytes))))))

  (test "distinct module globals and functions preserve lexical and closure shadowing"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "other.mjs" "(defvar value 9) (defun read-other () value) (export read-other)"
                           "main.mjs" "(import \"./other.mjs\" read-other) (defvar value 3) (defun read () value) (defun local (value) (let ((value (+ value 1))) ((lambda () (+ value (read-other)))))) (defun parallel () (let ((value 7) (copy value)) copy)) (defun sequential () (let* ((value 7) (copy value)) copy)) (export read read-other local parallel sequential)"))))
             (ref (await (js-call p :reference)))
             (a (instantiateManagedRuntime (emit-project p))))
        (js-call a :auto 1)
        (let ((x (js-call a :number 2)))
          (js-call
            (js-array
              (js-array "read" (js-array) (js-call ref :read))
              (js-array "read_other" (js-array) (js-call ref :read_other))
              (js-array "local" (js-array x) (js-call ref :local 2))
              (js-array "parallel" (js-array) (js-call ref :parallel))
              (js-array "sequential" (js-array) (js-call ref :sequential)))
            :forEach
            (lambda (item)
              (js-call assert :equal (call-number a (aref item 0) (aref item 1)) (aref item 2))))
          (finish a (js-array x))))))

  (test "cyclic modules instantiate hoisted functions before source-ordered evaluation"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "main.mjs" "(import \"./other.mjs\" read-other) (defconst value (+ (read-other) 1)) (defun read () value) (export read value)"
                           "other.mjs" "(import \"./main.mjs\" read) (defconst value 7) (defun read-other () value) (export read-other)"))))
             (ref (await (js-call p :reference)))
             (a (instantiateManagedRuntime (emit-project p))))
        (js-call assert :equal (call-number a "read") (js-call ref :read))
        (finish a))))

  (test "cyclic early reads preserve TDZ with independent Node control and cached cleanup"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "main.mjs" "(import \"./other.mjs\" other) (defconst value other) (defun read () value) (export value read)"
                           "other.mjs" "(import \"./main.mjs\" read) (defconst other (read)) (export other)"))))
             (control (spawnSync "node" (js-array (resolve (get p :base) (get p :entry))) (js-object :encoding "utf8" :timeout 30000))))
        (js-call assert :equal (get control :status) 1)
        (js-call assert :match (get control :stderr) (js* "/ReferenceError/"))
        (let ((a (instantiateManagedRuntime (emit-project p) (js-object :initializeModule false))))
          (js-call a :auto 1)
          (let ((keep (js-call a :number -0.0))
                (frame (js-call a :frame 1))
                (i 0))
            (js-call a :frameSet frame 0 keep)
            (while (< i 2)
              (js-call assert :throws
                (lambda () (js-call a :initializeModule))
                (lambda (e) (diag-code? e "ELI-RT0008")))
              (js-call a :collect)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (js-call assert :equal (js-call a :live) 2)
              (setq i (+ i 1)))
            (js-call a :leaveFrame frame)
            (finish a (js-array keep)))))))

  (test "default imports preserve export-default snapshot evaluation and original function identity"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defvar value -0.0) (defun change (x) (setq value x)) (export-default value) (export value change)"
                           "main.mjs" "(import \"./lib.mjs\" :default initial value change) (defun before () initial) (defun current () value) (export before current change)"))))
             (ref (await (js-call p :reference)))
             (a (instantiateManagedRuntime (emit-project p))))
        (funcall assert (Object/is (call-number a "before") (js-call ref :before)))
        (let* ((n (js-call a :number 7))
               (out (js-call a :invoke "change" (js-array n))))
          (js-call ref :change 7)
          (js-call assert :equal (call-number a "current") (js-call ref :current))
          (funcall assert (Object/is (call-number a "before") (js-call ref :before)))
          (finish a (js-array n out))))))

  (test "two reexport names may retain the same original binding and object identity"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "leaf.mjs" "(defconst value (js-array -0.0)) (export-default value)"
                           "left.mjs" "(import \"./leaf.mjs\" :default left) (export left)"
                           "right.mjs" "(import \"./leaf.mjs\" :default right) (export right)"
                           "main.mjs" "(import \"./left.mjs\" left) (import \"./right.mjs\" right) (export left right)"))))
             (ref (await (js-call p :reference))))
        (js-call assert :equal (get ref :left) (get ref :right))
        (let* ((a (instantiateManagedRuntime (emit-project p)))
               (left (js-call a :getExport "left"))
               (right (js-call a :getExport "right")))
          (funcall assert (js-call a :keyEqual left right))
          (finish a (js-array left right))))))

  (test "hygienic project names cannot capture source locals or enable shadowed constructors"
    (async ()
      (let* ((p (await (make-project (js-object "main.mjs" "(defvar value 3) (defun f ($eliscript_link_0_0) (+ value $eliscript_link_0_0)) (export f)"))))
             (ref (await (js-call p :reference)))
             (a (instantiateManagedRuntime (emit-project p)))
             (x (js-call a :number 4)))
        (js-call assert :equal (call-number a "f" (js-array x)) (js-call ref :f 4))
        (finish a (js-array x)))
      (let ((shadow (await (make-project (js-object "main.mjs" "(defvar globalThis nil) (defun f () (if false (new globalThis.Map) nil)) (export f)")))))
        (js-call assert :throws
          (lambda () (emit-project shadow))
          (lambda (e)
            (and (diag-code? e "ELI-B0001")
                 (= (get (get e :eliscriptDiagnostic) :phase) "managed-link")
                 (= (get (get (get e :eliscriptDiagnostic) :location) :file) "main.eli")))))))

  (test "link validation preserves input IR and reports missing modules exports and forged import assignments"
    (async ()
      (let ((bad-sources (js-array
                           (js-object "main.mjs" "(import \"./absent.mjs\" value) (export value)")
                           (js-object "other.mjs" "(defconst other 7) (export other)" "main.mjs" "(import \"./other.mjs\" value) (export value)")
                           (js-object "main.mjs" "(import \"../escape.mjs\" value) (export value)")))
            (i 0))
        (while (< i (length bad-sources))
          (let ((p (await (make-project (aref bad-sources i)))))
            (js-call assert :throws
              (lambda () (emit-project p))
              (lambda (e)
                (and (diag-code? e "ELI-B0001")
                     (= (get (get e :eliscriptDiagnostic) :phase) "managed-link")
                     (= (get (get (get e :eliscriptDiagnostic) :location) :file) "main.eli")))))
          (setq i (+ i 1))))
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defvar value 1) (export value)"
                           "main.mjs" "(import \"./lib.mjs\" value) (defvar local 0) (defun write () (setq local 7)) (export write)"))))
             (main-mod (js-call (get p :modules) :find (lambda (x) (= (get x :id) "main.mjs"))))
             (program (get main-mod :program))
             (fn-decl (js-call (get program :body) :find (lambda (x) (= (get x :kind) "function-declaration")))))
        (put (aref (get (aref (get fn-decl :children) 0) :children) 0) :value "value")
        (js-call assert :throws
          (lambda () (emit-project p))
          (lambda (e)
            (and (diag-code? e "ELI-B0001")
                 (js-call (js* "/assign.*import/") :test (get (get e :eliscriptDiagnostic) :message))))))))

  (test "cyclic and malformed program records retain structured schema diagnostics"
    (async ()
      (let* ((p (await (make-project (js-object "main.mjs" "(defun f () 7) (export f)"))))
             (cyclic (globalThis.structuredClone (get p :modules))))
        (js-call (get (aref (get (get (aref cyclic 0) :program) :body) 0) :children) :push
          (aref (get (get (aref cyclic 0) :program) :body) 0))
        (js-call assert :throws
          (lambda () (js-call (get b :managed) :emit_managed_project_wasm cyclic (get p :entry) runtime))
          (lambda (e)
            (let ((diag (if (and (not (nullish? e)) (= (funcall js-typeof e) "object")) (get e :eliscriptDiagnostic) nil)))
              (and (not (nullish? diag)) (= (funcall js-typeof (get diag :code)) "string")))))
        (js-call
          (js-array
            (js-array)
            (js-array nil)
            (js-array (aref (get p :modules) 0) (aref (get p :modules) 0))
            (js-array (js-object :id "./main.mjs" :program (get (aref (get p :modules) 0) :program))))
          :forEach
          (lambda (modules)
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :emit_managed_project_wasm modules (get p :entry) runtime))
              (lambda (e) (diag-code? e "ELI-B0001"))))))))

  (test "namespace imports share identity live properties readonly writes and snapshot copies"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defvar counter 0) (defun tick () (setq counter (1+ counter))) (defun read-value () counter) (export counter tick read-value) (export-default (js-array -0.0))"
                           "main.mjs" "(import \"./lib.mjs\" :as ns) (import \"./lib.mjs\" :as again) (defun read () (get ns :counter)) (defun advance () (funcall (get ns :tick))) (defun keys () (object-keys ns)) (defun copy () (object-assoc ns :extra 7)) (defun write () (put ns :counter 9)) (export ns again read advance keys copy write)"))))
             (ref (await (js-call p :reference))))
        (js-call assert :equal (get ref :ns) (get ref :again))
        (js-call assert :throws (lambda () (js-call ref :write)) globalThis.TypeError)
        (let ((a (instantiateManagedRuntime (emit-project p))))
          (js-call a :auto 1)
          (let* ((ns (js-call a :getExport "ns"))
                 (again (js-call a :getExport "again")))
            (funcall assert (js-call a :keyEqual ns again))
            (js-call assert :equal (call-number a "advance") (js-call ref :advance))
            (js-call assert :equal (call-number a "read") (js-call ref :read))
            (let ((keys (js-call a :invoke "keys"))
                  (names (js-array))
                  (i 0))
              (while (< i (js-call a :length keys))
                (let ((key (js-call a :get keys i)))
                  (js-call names :push (js-call a :readString key))
                  (js-call a :release key))
                (setq i (+ i 1)))
              (js-call assert :deepEqual names (js-call ref :keys))
              (let* ((copy (js-call a :invoke "copy"))
                     (ref-copy (js-call ref :copy))
                     (counter (js-call a :string "counter"))
                     (original (js-call a :objectGet copy counter)))
                (js-call assert :equal (js-call a :readNumber original) (get ref-copy :counter))
                (js-call assert :equal (call-number a "advance") (js-call ref :advance))
                (let ((live (js-call a :objectGet ns counter))
                      (snapshot (js-call a :objectGet copy counter)))
                  (js-call assert :equal (js-call a :readNumber live) (get (get ref :ns) :counter))
                  (js-call assert :equal (js-call a :readNumber snapshot) (get ref-copy :counter))
                  (js-call assert :throws
                    (lambda () (js-call a :invoke "write"))
                    (lambda (e) (diag-code? e "ELI-RT0003")))
                  (finish a (js-array ns again keys copy counter original live snapshot))))))))))

  (test "namespace qualified references and calls use existing symbol munging and respect local shadowing"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defvar value 3) (defun read-value () value) (export value read-value)"
                           "main.mjs" "(import \"./lib.mjs\" :as ns) (defun qualified () (ns/read-value)) (defun method () (js-call ns :read_value)) (defun shadow () (let ((ns (js-object :value 9))) ns/value)) (export qualified method shadow)"))))
             (ref (await (js-call p :reference)))
             (a (instantiateManagedRuntime (emit-project p))))
        (js-call (js-array "qualified" "method" "shadow") :forEach
          (lambda (name)
            (js-call assert :equal (call-number a name) (funcall (aref ref name)))))
        (finish a))))

  (test "namespace own checks and enumeration retain early-binding TDZ with independent Node control"
    (async ()
      (let ((ops (js-array "(object-has? ns :value)" "(object-keys ns)" "(object-assoc ns :extra 7)"))
            (i 0))
        (while (< i (length ops))
          (let* ((op (aref ops i))
                 (p (await (make-project
                             (js-object
                               "main.mjs" "(import \"./other.mjs\" result) (defconst value 7) (export value)"
                               "other.mjs" (str "(import \"./main.mjs\" :as ns) (defconst result " op ") (export result)")))))
                 (control (spawnSync "node" (js-array (resolve (get p :base) (get p :entry))) (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get control :status) 1)
            (js-call assert :match (get control :stderr) (js* "/ReferenceError/"))
            (js-call assert :throws
              (lambda () (instantiateManagedRuntime (emit-project p)))
              (lambda (e) (diag-code? e "ELI-RT0008"))))
          (setq i (+ i 1))))))

  (test "self-referential and reexported namespaces preserve cycles and survive caller-owned lifetimes"
    (async ()
      (let* ((p (await (make-project
                         (js-object "main.mjs" "(import \"./main.mjs\" :as ns) (defvar counter -0.0) (defun same () (eq ns (get ns :ns))) (defun read () ns/counter) (export ns counter same read)"))))
             (ref (await (js-call p :reference))))
        (js-call assert :equal (get (get ref :ns) :ns) (get ref :ns))
        (let ((a (instantiateManagedRuntime (emit-project p))))
          (js-call a :auto 1)
          (js-call assert :equal (js-call a :invoke "same") (js-call ref :same))
          (funcall assert (Object/is (call-number a "read") (js-call ref :read)))
          (let* ((ns (js-call a :getExport "ns"))
                 (key (js-call a :string "ns"))
                 (again (js-call a :objectGet ns key)))
            (funcall assert (js-call a :keyEqual ns again))
            (js-call a :closeModule)
            (js-call a :collect)
            (let* ((counter (js-call a :string "counter"))
                   (value (js-call a :objectGet ns counter)))
              (funcall assert (Object/is (js-call a :readNumber value) -0.0))
              (js-call (js-array ns key again counter value) :forEach (lambda (x) (js-call a :release x)))
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))))

  (test "namespace initialization capacity failures and actual traps discard module graphs but retain caller frames"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defconst value (js-array 1 2 3)) (export value)"
                           "main.mjs" "(import \"./lib.mjs\" :as ns) (export ns)"))))
             (bytes (emit-project p))
             (small (instantiateManagedRuntime bytes (js-object :maxSlots 8 :initialBytes 4096 :maxBytes 8192 :initializeModule false))))
        (js-call small :auto 1)
        (let ((keep (js-call small :number 7))
              (frame (js-call small :frame 1)))
          (js-call small :frameSet frame 0 keep)
          (js-call assert :throws
            (lambda () (js-call small :initializeModule))
            (lambda (e) (diag-code? e "ELI-RT0002")))
          (js-call small :collect)
          (js-call assert :equal (get (js-call small :stats) :frameDepth) 1)
          (js-call assert :equal (js-call small :live) 2)
          (js-call small :leaveFrame frame)
          (finish small (js-array keep)))
        (let* ((source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
               (start (js-call source :indexOf "  (defun value-module-namespace-bind (heap object key kind index)"))
               (end (js-call source :indexOf "  (defun " (+ start 10))))
          (funcall assert (and (>= start 0) (> end start)))
          (let* ((faulty (str (js-call source :slice 0 start)
                              "  (defun value-module-namespace-bind (heap object key kind index) (load-u32 4294967295))\n"
                              (js-call source :slice end)))
                 (rt (js-call (get b :compiler) :compile_ir_string faulty "namespace-trap.eli"))
                 (a (instantiateManagedRuntime
                      (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm (get p :modules) (get p :entry) rt))
                      (js-object :initializeModule false))))
            (js-call a :auto 1)
            (let ((saved (js-call a :number -0.0))
                  (caller (js-call a :frame 1)))
              (js-call a :frameSet caller 0 saved)
              (js-call assert :throws
                (lambda () (js-call a :initializeModule))
                globalThis.WebAssembly.RuntimeError)
              (js-call a :collect)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (js-call assert :equal (js-call a :live) 2)
              (let ((out (js-call a :frameGet caller 0)))
                (funcall assert (Object/is (js-call a :readNumber out) -0.0))
                (js-call a :leaveFrame caller)
                (finish a (js-array saved out)))))))))

  (test "ordinary IR cannot forge a project namespace initializer or malformed alias options"
    (async ()
      (let* ((p (await (make-project (js-object "main.mjs" "(defconst value 7) (export value)"))))
             (program (get (aref (get p :modules) 0) :program)))
        (put (get (aref (get program :body) 0) :children) 0
          (js-object
            :kind "managed-module-namespace"
            :value nil
            :children (js-array)
            :span (get (aref (get program :body) 0) :span)
            :properties nil
            :entries (js-array)))
        (js-call assert :throws
          (lambda () (js-call (get b :managed) :emit_managed_wasm program runtime))
          (lambda (e) (diag-code? e "ELI-B0001"))))
      (let ((ordinary (js-call (get b :compiler) :compile_ir_string "(defun f () 7) (export f)" "aliases.eli")))
        (js-call (js-array (js-object) false (js-array "f" "f") (js-array nil)) :forEach
          (lambda (aliases)
            (js-call assert :throws
              (lambda () (js-call (get b :managed) :lower_managed_program ordinary runtime t aliases))
              (lambda (e) (diag-code? e "ELI-B0001"))))))))

  (test "default exports remain distinct from a named binding whose source name is default"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defconst default 7) (export default) (export-default 9)"
                           "main.mjs" "(import \"./lib.mjs\" :default initial default) (defun values () (js-array initial default)) (export default) (export-default initial) (export values)"))))
             (ref (await (js-call p :reference))))
        (js-call assert :equal (get ref :default) 9)
        (js-call assert :equal (get ref :default$) 7)
        (let* ((a (instantiateManagedRuntime (emit-project p)))
               (plain (js-call a :getExport "default"))
               (named (js-call a :getExport "default$")))
          (js-call assert :equal (js-call a :readNumber plain) (get ref :default))
          (js-call assert :equal (js-call a :readNumber named) (get ref :default$))
          (finish a (js-array plain named))))))

  (test "a reexported namespace retains method calls and aliases instead of becoming a snapshot"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defvar value 3) (defun read-value () value) (export value read-value)"
                           "facade.mjs" "(import \"./lib.mjs\" :as ns) (export ns)"
                           "main.mjs" "(import \"./facade.mjs\" ns) (defun read () (js-call ns :read_value)) (export ns read)"))))
             (ref (await (js-call p :reference)))
             (a (instantiateManagedRuntime (emit-project p))))
        (js-call assert :equal (call-number a "read") (js-call ref :read))
        (let ((ns (js-call a :getExport "ns")))
          (finish a (js-array ns))))))

  (test "the explicit project CLI consumes the existing virtual-project request shape without executing JS modules"
    (async ()
      (let ((request (resolve directory "virtual-project.json"))
            (output (resolve directory "virtual-project.wasm"))
            (command (resolve root "tools/backends/compile.mjs")))
        (await (writeFile request (JSON/stringify (js-object :mode "project" :entry "main.mjs" :files live-sources))))
        (let ((result (spawnSync "bun"
                        (js-array command "--abi" "managed-module-v1" "--target" "wasm" "--project" "-o" output request)
                        (js-object :cwd root :encoding "utf8" :timeout 30000))))
          (js-call assert :equal (get result :status) 0 (get result :stderr)))
        (let ((a (instantiateManagedRuntime (await (readFile output)))))
          (js-call assert :equal (call-number a "advance") 1)
          (finish a))
        (let ((pairs (js-array
                       (js-array "managed-control-v1" "wasm")
                       (js-array "numeric-f64" "wasm")
                       (js-array "managed-module-v1" "js")))
              (i 0))
          (while (< i (length pairs))
            (let* ((pair (aref pairs i))
                   (abi (aref pair 0))
                   (target (aref pair 1))
                   (rejected (resolve directory (str "rejected-project-" abi "-" target)))
                   (child (spawnSync "bun"
                            (js-array command "--abi" abi "--target" target "--project" "-o" rejected request)
                            (js-object :cwd root :encoding "utf8" :timeout 30000))))
              (js-call assert :notEqual (get child :status) 0)
              (js-call assert :equal (await (js-call (js-call globalThis.Bun :file rejected) :exists)) false))
            (setq i (+ i 1))))))
    60000)

  (test "fixed random module graphs agree with independent binding models and fresh JS projects"
    (async ()
      (let* ((random 1369668648)
             (next (lambda ()
                     (setq random (unsigned-bit-shift-right (+ (Math/imul random 1664525) 1013904223) 0))
                     random))
             (trial 0))
        (while (< trial 32)
          (let ((sources (js-object))
                (expected (js-array))
                (i 0))
            (while (< i 5)
              (let* ((dependency (if (= i 0) -1 (% (funcall next) i)))
                     (base (- (% (funcall next) 17) 8))
                     (val (+ base (if (< dependency 0) 0 (aref expected dependency)))))
                (put expected i val)
                (put sources (str "m" i ".mjs")
                  (str (if (< dependency 0) "" (str "(import \"./m" dependency ".mjs\" :as previous) "))
                       "(defvar value " (if (< dependency 0) (globalThis.String base) (str "(+ previous/value " base ")"))
                       ") (defun write (x) (setq value x)) (export value write)")))
              (setq i (+ i 1)))
            (put sources "main.mjs"
              (str (js-call (Array/from (js-object :length 5)
                              (lambda (_ idx)
                                (str "(import \"./m" idx ".mjs\" :as n" idx ") (defun read" idx " () n" idx "/value) (defun write" idx " (x) (funcall (get n" idx " :write) x))")))
                     :join " ")
                   " (export "
                   (js-call (Array/from (js-object :length 5) (lambda (_ idx) (str "read" idx " write" idx))) :join " ")
                   ")"))
            (let* ((p (await (make-project sources)))
                   (reference (await (js-call p :reference)))
                   (bytes (emit-project p))
                   (reversed (js-call (Array/from (get p :modules)) :reverse)))
              (js-call assert :deepEqual (emit-project (Object/assign (js-object) p (js-object :modules reversed))) bytes)
              (let ((a (instantiateManagedRuntime bytes)))
                (js-call a :auto 1)
                (let ((k 0))
                  (while (< k 5)
                    (funcall assert (Object/is (call-number a (str "read" k)) (aref expected k)))
                    (funcall assert (Object/is (call-number a (str "read" k)) (funcall (aref reference (str "read" k)))))
                    (setq k (+ k 1))))
                (let ((edges (js-array -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity) globalThis.Number.MIN_VALUE 0))
                      (change 0))
                  (while (< change 12)
                    (let* ((idx (% (funcall next) 5))
                           (value (if (< change (length edges))
                                    (aref edges change)
                                    (- (% (funcall next) 100) 50)))
                           (x (js-call a :number value))
                           (out (js-call a :invoke (str "write" idx) (js-array x))))
                      (funcall assert (Object/is (js-call a :readNumber out) (funcall (aref reference (str "write" idx)) value)))
                      (js-call a :release x)
                      (js-call a :release out)
                      (put expected idx value)
                      (js-call a :collect)
                      (let ((j 0))
                        (while (< j 5)
                          (funcall assert (Object/is (call-number a (str "read" j)) (aref expected j)))
                          (setq j (+ j 1)))))
                    (setq change (+ change 1))))
                (finish a))))
          (setq trial (+ trial 1)))))
    30000)

  (test "nested Unicode module identities and frozen source IR retain exact source values and diagnostics"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "项目/数值.mjs" "(defconst value \"中😀\") (export value)"
                           "main.mjs" "(import \"./项目/数值.mjs\" value) (export value)"))))
             (reference (await (js-call p :reference))))
        (deep-freeze (get p :modules))
        (let* ((a (instantiateManagedRuntime (emit-project p)))
               (value (js-call a :getExport "value")))
          (js-call assert :equal (js-call a :readString value) (get reference :value))
          (finish a (js-array value)))
        (js-call
          (js-array "main\u0000.mjs" "main\\bad.mjs" "main.mjs?query" "main.mjs#hash" ":scheme" "../main.mjs")
          :forEach
          (lambda (id)
            (js-call assert :throws
              (lambda ()
                (js-call (get b :managed) :emit_managed_project_wasm
                  (js-array (js-object :id id :program (get (aref (get p :modules) 0) :program)))
                  id runtime))
              (lambda (e) (diag-code? e "ELI-B0001"))))))))

  (test "an actual namespace copy trap releases its temporary object and every manually protected value"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defconst value (js-array 1 2 3)) (export value)"
                           "main.mjs" "(import \"./lib.mjs\" :as ns) (defun copy () (object-assoc ns :extra 7)) (export copy)"))))
             (source (await (readFile (resolve root "bootstrap/runtime/memory.eli") "utf8")))
             (start (js-call source :indexOf "  (defun heap-module-cell-read (heap cell)"))
             (end (js-call source :indexOf "  (defun " (+ start 10))))
        (funcall assert (and (>= start 0) (> end start)))
        (let* ((faulty (str (js-call source :slice 0 start)
                            "  (defun heap-module-cell-read (heap cell) (load-u32 4294967295))\n"
                            (js-call source :slice end)))
               (rt (js-call (get b :compiler) :compile_ir_string faulty "namespace-copy-trap.eli"))
               (a (instantiateManagedRuntime (Uint8Array/from (js-call (get b :managed) :emit_managed_project_wasm (get p :modules) (get p :entry) rt)))))
          (js-call a :auto 1)
          (let ((keep (js-call a :number -0.0))
                (frame (js-call a :frame 1)))
            (js-call a :frameSet frame 0 keep)
            (js-call assert :throws
              (lambda () (js-call a :invoke "copy"))
              globalThis.WebAssembly.RuntimeError)
            (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
            (let ((saved (js-call a :frameGet frame 0)))
              (funcall assert (Object/is (js-call a :readNumber saved) -0.0))
              (js-call a :leaveFrame frame)
              (finish a (js-array keep saved))))))))

  (test "namespace prototypes keep ordinary own writes but reject inherited writes after RHS effects"
    (async ()
      (let* ((p (await (make-project
                         (js-object
                           "lib.mjs" "(defconst value 7) (export value)"
                           "main.mjs" "(import \"./lib.mjs\" :as ns) (defconst child (js-object :__proto__ ns :own 5)) (defvar effect 0) (defun read () child/value) (defun own () (object-has? child :value)) (defun write-own () (put child :own 9)) (defun write-known () (put child :value 9)) (defun write-new () (put child :extra (setq effect (1+ effect)))) (defun effects () effect) (export child read own write-own write-known write-new effects)"))))
             (ref (await (js-call p :reference))))
        (js-call assert :equal (js-call ref :read) 7)
        (js-call assert :equal (js-call ref :own) false)
        (js-call assert :equal (js-call ref :write_own) 9)
        (js-call assert :throws (lambda () (js-call ref :write_known)) globalThis.TypeError)
        (js-call assert :throws (lambda () (js-call ref :write_new)) globalThis.TypeError)
        (js-call assert :equal (js-call ref :effects) 1)
        (let ((a (instantiateManagedRuntime (emit-project p))))
          (js-call assert :equal (call-number a "read") 7)
          (js-call assert :equal (js-call a :invoke "own") false)
          (js-call assert :equal (call-number a "write_own") 9)
          (js-call (js-array "write_known" "write_new") :forEach
            (lambda (name)
              (js-call assert :throws
                (lambda () (js-call a :invoke name))
                (lambda (e) (diag-code? e "ELI-RT0003")))))
          (js-call assert :equal (call-number a "effects") 1)
          (finish a)))))

  (test "standalone and linked bindings preserve the existing JS emitted-name shadowing across scopes"
    (async ()
      (let ((cases (js-array
                     "(defvar value-name 3) (defun f (value_name) value-name) (export f)"
                     "(defvar value-name 3) (defun f (value_name) ((lambda () value-name))) (export f)"
                     "(defvar value-name 3) (defun f (value_name) (setq value-name 7) (+ (* value-name 10) value_name)) (defun global () value-name) (export f global)"
                     "(defun f (value-name) (let ((value_name (+ value-name 1))) ((lambda () value-name)))) (export f)"
                     "(defun f (value-name) (let ((value_name (+ value-name 1))) (let ((value-name (+ value_name 1))) ((lambda () value_name))))) (export f)"
                     "(defvar default 3) (defun f (default$) default) (export f)"
                     "(defvar 值 3) (defun f (_U503C_) 值) (export f)"
                     "(defvar value 3) (defun f ($eliscript-link-0-0) value) (export f)"))
            (runner (resolve "tests/helpers/wasm-managed-project-linking-node.mjs"))
            (i 0))
        (while (< i (length cases))
          (let* ((source (aref cases i))
                 (p (await (make-project (js-object "main.mjs" source))))
                 (reference (await (js-call p :reference)))
                 (expected (js-call reference :f 5))
                 (control (spawnSync "node"
                            (js-array runner (get (pathToFileURL (resolve (get p :base) (get p :entry))) :href) (globalThis.String expected))
                            (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get control :status) 0 (get control :stderr))
            (js-call
              (js-array
                (Uint8Array/from (js-call (get b :managed) :emit_managed_wasm (get (aref (get p :modules) 0) :program) runtime))
                (emit-project p))
              :forEach
              (lambda (bytes)
                (let ((a (instantiateManagedRuntime bytes)))
                  (js-call a :auto 1)
                  (let ((input (js-call a :number 5))
                        (has-init (js-call (WebAssembly.Module/exports (new globalThis.WebAssembly.Module bytes))
                                    :some (lambda (e) (= (get e :name) "__eliscript_module_init")))))
                    (funcall assert (Object/is (call-number a "f" (js-array input)) expected) source)
                    (when (= (funcall js-typeof (get reference :global)) "function")
                      (js-call assert :equal (call-number a "global") (js-call reference :global)))
                    (finish a (js-array input) has-init))))))
          (setq i (+ i 1))))))

  (test "an emitted-name alias may shadow a namespace in qualified reads and builtin method calls"
    (async ()
      (let ((cases (js-array
                     (js-array "(import \"./lib.mjs\" :as value-name) (defun f (value_name) value-name/x) (export f)" "object")
                     (js-array "(import \"./lib.mjs\" :as array-name) (defun f (array_name) (js-call array-name :push 7)) (export f)" "array")))
            (i 0))
        (while (< i (length cases))
          (let* ((pair (aref cases i))
                 (source (aref pair 0))
                 (input-kind (aref pair 1))
                 (p (await (make-project (js-object "lib.mjs" "(defconst x 3) (export x)" "main.mjs" source))))
                 (reference (await (js-call p :reference)))
                 (expected (js-call reference :f (if (= input-kind "object") (js-object :x 7) (js-array))))
                 (a (instantiateManagedRuntime (emit-project p))))
            (js-call a :auto 1)
            (let* ((seven (js-call a :number 7))
                   (value (if (= input-kind "object")
                            (js-call a :sourceObject (js-object :x seven))
                            (js-call a :sourceArray (js-array)))))
              (js-call assert :equal (call-number a "f" (js-array value)) expected)
              (finish a (js-array seven value))))
          (setq i (+ i 1)))))))
