                      (await (writeFile path javascript))
                      (let ((node (spawnSync "node" (js-array "tests/fixtures/compiler-producer-numeric-host.mjs" (get (pathToFileURL path) :href)) (js-object :encoding "utf8" :timeout 10000))))
                        (js-call assert :equal (get node :status) 0 (get node :stderr))))
                    (when (and (= (get globalThis.process :platform) "darwin") (= (get globalThis.process :arch) "arm64"))
                      (let* ((library (Uint8Array/from (JSON/parse (js-call fixture :call "produce_native_library" (js-array source filename)))))
                             (path (resolve (get fixture :directory) "numeric.dylib")) (ffi (await (funcall load-module "bun:ffi"))))
                        (js-call assert :deepEqual library (Uint8Array/from (js-call (get backend :native) :emit_native_numeric_library program "arm64-macos")))
                        (await (writeFile path library))
                        (let ((native (js-call ffi :dlopen path (js-object :add (js-object :args (js-array "f64" "f64") :returns "f64")))))
                          (try
                            (js-call inputs :forEach (lambda (values) (funcall assert (Object/is
                              (Reflect/apply (get (get native :symbols) :add) (get native :symbols) values) (Reflect/apply (get actualJS :add) actualJS values)))))
                            (finally (js-call native :close))))
                        (funcall mark "native-product-executed" (js-object :productTarget "arm64-macos-library" :bytes (get library :length)))))
                    (funcall mark "numeric-products-executed" (js-object :productTarget "numeric-wasm-and-arm64-macos-object" :wasmBytes (get wasm :length) :objectBytes (get object :length)))))
                ((and (not (= mode "runtime-ir")) (not (= mode "runtime-stages")))
                  (let* ((inputs (js-array source filename (get fixture :runtimeJSON)))
                         (wire (if (= profile "full-runtime") (js-call fixture :callFromRuntimeIR mode inputs)
                           (js-call fixture :call (if (= mode "managed-wasm") "produce_managed_wasm" "produce_managed_native") inputs)))
                         (emitted (JSON/parse wire)) (product undefined))
                    (if (= mode "managed-wasm")
                      (let ((bytes (Uint8Array/from emitted)))
                        (js-call assert :deepEqual bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm program (get fixture :runtime))))
                        (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
                        (setq product (instantiateManagedRuntime bytes))
                        (funcall mark "managed-product-instantiated" (js-object :productTarget mode :bytes (get bytes :length))))
                      (progn
                        (js-call assert :equal (get globalThis.process :platform) "darwin") (js-call assert :equal (get globalThis.process :arch) "arm64")
                        (let* ((lowered (js-call (get backend :managed) :lower_managed_program program (get fixture :runtime)))
                               (bytes (Uint8Array/from (get emitted :bytes))) (path (resolve (get fixture :directory) "managed.dylib")))
                          (js-call assert :deepEqual (get emitted :descriptor) (get lowered :descriptor))
                          (js-call assert :deepEqual (get emitted :typed) (get lowered :typed))
                          (js-call assert :deepEqual bytes (Uint8Array/from (js-call (get backend :native) :emit_typed_native_memory_library (get lowered :typed) "arm64-macos")))
                          (await (writeFile path bytes))
                          (setq product (await (instantiateNativeManagedRuntime path (js-object :typed (get emitted :typed) :descriptor (get emitted :descriptor)))))
                          (funcall mark "managed-product-instantiated" (js-object :productTarget mode :bytes (get bytes :length))))))
                    (checkManagedProduct product)
                    (funcall mark "managed-product-executed" (js-object :productTarget mode)))))
              (js-call assert :equal (JSON/stringify program) saved)
              (js-call a :collect) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
              (funcall mark "candidate-complete" (js-object :mode mode :productTarget mode))))
          (catch error
            (setq failed t)
            (let ((detail (failureDetail a error)))
              (funcall mark "candidate-failed" (js-object :mode mode :productTarget mode :error detail :directory (get fixture :directory) :input (resolve (get fixture :directory) "candidate-input.json"))))
            (throw error))
          (finally
            (try (await (js-call fixture :close (js-object :preserve failed)))
              (catch error
                (funcall onStage (js-object :stage "candidate-cleanup-failed" :producerHost producerHost :profile profile :productTarget mode :mode mode :message (optionalGet error "message")))
                (unless failed (throw error))))))))))
  (defasync main ()
    (let ((entry (aref (get globalThis.process :argv) 1)))
    (when (and (funcall host-truth entry) (= (resolve entry) (fileURLToPath (js* "import.meta.url"))))
      (let ((mode (let ((value (aref (get globalThis.process :argv) 2))) (if (nullish? value) "numeric" value)))
            (producerHost (let ((value (aref (get globalThis.process :argv) 3))) (if (nullish? value) "wasm" value)))
            (profile (let ((value (aref (get globalThis.process :argv) 4))) (if (nullish? value) "small" value))))
        (try
          (await (runProducerCandidate mode (js-object :producerHost producerHost :profile profile
            :onStage (lambda (value) (js-call (get globalThis.process :stdout) :write (str (JSON/stringify value) "\n"))))))
          (catch error
            (let ((stack (optionalGet error "stack")))
              (js-call (get globalThis.process :stderr) :write (str (if (nullish? stack) (funcall globalThis.String error) stack) "\n")))
            (put globalThis.process :exitCode 1)))))))
  (main)
  (export producerProfiles compilerInputWire stringifyCompilerInput producerSource managedProducerSource buildCompilerProducer runProducerCandidate)
)
