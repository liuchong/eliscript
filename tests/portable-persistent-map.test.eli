(module tests.portable-persistent-map
  (import "bun:test" expect test)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries assertSourceMap sourceMap generatedModuleLoader be same)
  (import "./helpers/portable-structure.mjs" nextRandom integerHash countItems sharedItems lookupPathLength)
  (defconst importGeneratedModule (generatedModuleLoader "persistent-map"))
  (defun objectHash (value) (integerHash (get value :id)))
  (defconst sameObjectKey (lambda (left right) (= (get left :id) (get right :id))))
  (defconst sameValue (lambda (left right) (Object/is left right)))
  (test "Eliscript-authored HAMT Map compiles and agrees across hosts"
    (async () (await (withPortableLibraries
      (js-object :module "persistent-map" :sources (js-array "persistent-map") :fixture "tests/fixtures/portable-map-host.mjs" :loader false)
      (async (context)
        (same (get context :report) (js-object :persistent t :count 100000 :rootKind "array" :probes (js-array 0 93 96 3072 98304 299997)
          :original 162963 :updated "updated" :removed false :sum 14999850000 :noopAssoc t :noopDissoc t
          :collision (js-object :count 99 :kind "collision" :removed false :retained 99) :sample (js-array (js-array 1 "a") (js-array 2 "b") (js-array 3 "c"))))
        (await (assertSourceMap (get context :seedDirectory) "persistent-map" (js-array "(defportable persistent-map-assoc-item")))
        (js-call (expect (js-length (get (await (sourceMap (get context :seedDirectory) "persistent-map")) :mappings))) :toBeGreaterThan 0))))) 60000)
  (test "Eliscript-authored HAMT Map preserves generated value-key histories"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "history"))) (emptyPersistentMap (get module :empty_persistent_map))
             (persistentMapCount (get module :persistent_map_count)) (persistentMapGet (get module :persistent_map_get))
             (persistentMapAssoc (get module :persistent_map_assoc)) (persistentMapDissoc (get module :persistent_map_dissoc))
             (persistentMapReduce (get module :persistent_map_reduce)) (persistentMapToEntries (get module :persistent_map_to_entries))
             (random (js-object :value 1296126001)) (map (emptyPersistentMap objectHash sameObjectKey sameValue)) (model (new globalThis.Map)) (step 0))
        (while (< step 20000)
          (let* ((previousMap map) (previousModel model) (id (% (nextRandom random) 5000)) (choice (% (nextRandom random) 10)))
            (cond ((< choice 6) (let* ((value (nextRandom random)) (existing (js-call model :get id)))
                                 (setq map (persistentMapAssoc map (js-object :id id) value))
                                 (when (= existing value) (be map previousMap)) (setq model (new globalThis.Map model)) (js-call model :set id value)))
                  ((< choice 8) (let ((existed (js-call model :has id)))
                                 (setq map (persistentMapDissoc map (js-object :id id)))
                                 (unless existed (be map previousMap)) (setq model (new globalThis.Map model)) (js-call model :delete id)))
                  (t (be (persistentMapGet map (js-object :id id) "missing") (if (js-call model :has id) (js-call model :get id) "missing"))))
            (be (persistentMapCount map) (get model :size)) (be (persistentMapCount previousMap) (get previousModel :size))
            (when (> (get previousModel :size) 0)
              (let ((previousId (get (js-call (js-call previousModel :keys) :next) :value)))
                (be (persistentMapGet previousMap (js-object :id previousId) "missing") (js-call previousModel :get previousId))))
            (when (= (% step 500) 0) (be (persistentMapReduce (lambda (count) (+ count 1)) 0 map) (get model :size))))
          (setq step (1+ step)))
        (let ((entries (js-call (js-call (persistentMapToEntries map) :map (lambda (entry) (js-array (get (aref entry 0) :id) (aref entry 1)))) :sort (lambda (left right) (- (aref left 0) (aref right 0))))))
          (same entries (js-call (Array/from (js-call model :entries)) :sort (lambda (left right) (- (aref left 0) (aref right 0)))))))) 60000)
  (test "Eliscript-authored HAMT Map promotes and demotes measured layouts"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "layouts"))) (equal (lambda (left right) (= left right)))
             (map (funcall (get module :empty_persistent_map) (lambda (value) value) equal equal)) (key 0))
        (while (< key 31) (setq map (funcall (get module :persistent_map_assoc) map key key) key (1+ key)))
        (js-call (expect (get map :root)) :toMatchObject (js-object :kind "bitmap")) (js-call (expect (get (get map :root) :items)) :toHaveLength 31)
        (setq map (funcall (get module :persistent_map_assoc) map 31 31))
        (js-call (expect (get map :root)) :toMatchObject (js-object :kind "array" :count 32)) (js-call (expect (get (get map :root) :children)) :toHaveLength 32)
        (setq key 0) (while (< key 7) (setq map (funcall (get module :persistent_map_dissoc) map key) key (1+ key)))
        (js-call (expect (get map :root)) :toMatchObject (js-object :kind "array" :count 25)) (setq map (funcall (get module :persistent_map_dissoc) map 7))
        (js-call (expect (get map :root)) :toMatchObject (js-object :kind "bitmap")) (js-call (expect (get (get map :root) :items)) :toHaveLength 24)
        (be (funcall (get module :persistent_map_get) map 31 "missing") 31))) 30000)
  (test "Eliscript-authored HAMT Map shares the million-key update path"
    (async ()
      (let* ((module (await (funcall importGeneratedModule "million"))) (equal (lambda (left right) (= left right)))
             (map (funcall (get module :empty_persistent_map) (lambda (value) value) equal equal)) (key 0))
        (while (< key 1000000) (setq map (funcall (get module :persistent_map_assoc) map key key) key (1+ key)))
        (let* ((updated (funcall (get module :persistent_map_assoc) map 500000 -1)) (hash (uint32 500000))
               (itemCount (countItems (get map :root))) (changedPath (lookupPathLength (get map :root) hash)))
          (be (funcall (get module :persistent_map_count) map) 1000000) (be (funcall (get module :persistent_map_get) map 500000 "missing") 500000)
          (be (funcall (get module :persistent_map_get) updated 500000 "missing") -1) (be (sharedItems (get map :root) (get updated :root)) (- itemCount changedPath))
          (let ((removed (funcall (get module :persistent_map_dissoc) updated 750000)))
            (be (funcall (get module :persistent_map_count) removed) 999999) (be (funcall (get module :persistent_map_get) removed 750000 "missing") "missing")
            (be (funcall (get module :persistent_map_get) map 750000 "missing") 750000))))) 60000))
