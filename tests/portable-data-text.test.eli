(module tests.portable-data-text
  (import "bun:test" test)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve)
  (import "./helpers/portable-stdlib.mjs" withPortableLibraries pruneLibrary assertSourceMap be same contains excludes)
  (import "../runtime/core/identifier.mjs" keyword)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/set.mjs" persistentHashSet)
  (import "../runtime/core/metadata.mjs" withMeta)
  (import "../runtime/core/vector.mjs" persistentVector)
  (import "../runtime/core/data-text.mjs" printValue)
  (test "portable canonical data text is byte-identical and host-independent"
    (async () (await (withPortableLibraries
      (js-object :module "data-text" :sources (js-array "bit" "identifier" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value" "metadata" "data-text") :fixture "tests/fixtures/portable-data-text-host.mjs" :loader t :parallelHosts false)
      (async (context)
        (let ((report (get context :report)))
      (same report (js-object "canonical" (js-object "root" (str "({:a ^{:line 7 :source \"portable\"} " (str "[nil undefined true ##NaN ##Inf 42N \"Unicode \u503c\\n\" " (str ":article/title article/title " "#eliscript/symbol [nil \"space name\"]] :z #{1 2 3}} [1 2 3])"))) "map" (str "{:a ^{:line 7 :source \"portable\"} " (str "[nil undefined true ##NaN ##Inf 42N \"Unicode \u503c\\n\" " (str ":article/title article/title " "#eliscript/symbol [nil \"space name\"]] :z #{1 2 3}}"))) "insertionIndependent" t "unsafeIdentifier" "#eliscript/symbol [nil \"space name\"]" "common" "^{:source \"parity\"} [:a {:a 1 :b 2} #{1 2 3}]") "roundTrip" (js-object "rootEqual" t "fixedPoint" t "metadataSource" nil "nestedMetadataSource" "portable" "generatedEqual" t "generatedFixedPoint" t) "values" (js-object "ok" t "count" 3 "first" 1 "keyword" "two" "listCount" 2 "undefinedPreserved" t) "errors" (js-object "duplicateMap" "duplicate map key at 1:7" "duplicateSet" "duplicate set value at 1:5" "located" (js-object "offset" 6 "line" 3 "column" 1 "sourceLength" 7) "limited" "data text exceeds maxValues 2") "edges" (js-object "decodedString" "Unicode \u503c\n\t\\\"" "taggedSymbol" "article/title" "ignored" (js-array 1 2 3) "depthLimited" "data text exceeds maxDepth 2 at 1:4" "lengthLimited" "data text exceeds maxLength 4 at 1:1" "valueLimited" "data text exceeds maxValues 2 at 1:4" "invalidOptions" "invalid data text options at 1:1" "invalidEscape" "invalid string escape at 1:2" "oddMap" "map requires a value for every key at 1:7" "unknownDispatch" "unknown dispatch #unknown at 1:1" "trailing" "trailing data after value at 1:5" "emptyValues" 0 "negativeZero" "0") "shape" (js-object "mapCount" 2 "setCount" 3 "generatedCount" 2000)))
      (let* ((runtimeMetadata (persistentHashMap (js-array (keyword "source") "parity")))
             (runtimeCommon (withMeta (persistentVector (keyword "a")
               (persistentHashMap (js-array (keyword "b") 2) (js-array (keyword "a") 1))
               (persistentHashSet 3 1 2)) runtimeMetadata)))
        (be (get (get report :canonical) :common) (printValue runtimeCommon)))
        ))))) 120000)
)
