(module tests.wire-compiler
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm symlink)
  (import "node:os" tmpdir)
  (import "node:path" resolve dirname)
  (import "node:url" fileURLToPath)

  (defconst root (resolve (dirname (fileURLToPath (js* "import.meta.url"))) ".."))

  (defasync run (command &rest __host_forwarded_arguments_1)
    (let* ((env (aref __host_forwarded_arguments_1 0)))
    (let* ((merged-env (Object/assign (js-object) (get globalThis.process :env) (or env (js-object))))
           (child (js-call globalThis.Bun :spawn command
                    (js-object :cwd root :env merged-env :stdout "pipe" :stderr "pipe")))
           (parts (await (Promise/all
                           (js-array (get child :exited)
                             (js-call (new globalThis.Response (get child :stdout)) :text)
                             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (code (aref parts 0))
           (out (aref parts 1))
           (err (aref parts 2)))
      (unless (= code 0)
        (throw (new globalThis.Error (str (js-call command :join " ") "\n" (if (> (js-length err) 0) err out)))))
      (js-call out :trim))))

  (test "wire modules compile identically with both compilers and execute real HTTP under Bun and Node"
    (async ()
      (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-wire-")))))
        (try
          (let ((bootstrap (resolve directory "compiler"))
                (sources (js-array "stdlib/mdp.eli" "stdlib/mds.eli" "stdlib/gepo.eli" "tests/fixtures/wire.eli"))
                (outputs (js-array))
                (compilers (js-array (js-array "eliscript-seed" "seed")
                                     (js-array "eliscript-portable" "portable")))
                (hosts (js-array (js-array "bun" "--preload" "compiled-eli-bun-preload.mjs")
                                 (js-array (or (get (get globalThis.process :env) :NODE) "node")
                                           "--experimental-loader" "compiled-eli-node-loader.mjs"))))
            (await (run (js-array (resolve root "bin/eliscript-bootstrap"))
                        (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR bootstrap)))
            (let ((ci 0))
              (while (< ci (js-length compilers))
                (let* ((entry (aref compilers ci))
                       (compiler (aref entry 0))
                       (family (aref entry 1))
                       (out (resolve directory family)))
                  (js-call outputs :push out)
                  (await (mkdir out))
                  (await (symlink (resolve root "runtime") (resolve out "runtime") "dir"))
                  (let ((si 0))
                    (while (< si (js-length sources))
                      (let* ((source (aref sources si))
                             (target (resolve out (if (= source (aref sources (- (js-length sources) 1)))
                                                    "tests/fixtures/wire.mjs"
                                                    source))))
                        (await (mkdir (dirname target) (js-object :recursive t)))
                        (await (run (js-array (resolve root "bin" compiler)
                                      "--source-map" "--output" target (resolve root source))
                                    (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap))))
                      (setq si (1+ si))))
                  (let ((hi 0))
                    (while (< hi (js-length hosts))
                      (let* ((hentry (aref hosts hi))
                             (host (aref hentry 0))
                             (flag (aref hentry 1))
                             (loader (aref hentry 2))
                             (report (JSON/parse
                                       (await (run (js-array host flag
                                                     (resolve root "tests/fixtures" loader)
                                                     (resolve root "tests/fixtures/wire-host.mjs")
                                                     (resolve out "tests/fixtures/wire.mjs")))))))
                        (js-call (expect report) :toEqual
                          (js-object :codec t :discovery t :usageSafe t :post t)))
                      (setq hi (1+ hi)))))
                (setq ci (1+ ci))))
            (let ((si 0))
              (while (< si (js-length sources))
                (let* ((source (aref sources si))
                       (file (if (= source (aref sources (- (js-length sources) 1)))
                               "tests/fixtures/wire.mjs"
                               source))
                       (extensions (js-array "" ".map"))
                       (ei 0))
                  (while (< ei (js-length extensions))
                    (let ((ext (aref extensions ei)))
                      (js-call (expect (await (readFile (resolve (aref outputs 0) (str file ext)) "utf8")))
                        :toBe (await (readFile (resolve (aref outputs 1) (str file ext)) "utf8"))))
                    (setq ei (1+ ei))))
                (setq si (1+ si)))))
          (finally
            (await (rm directory (js-object :recursive t :force t)))))))
    120000))
