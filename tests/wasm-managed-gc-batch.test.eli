(module tests.wasm-managed-gc-batch.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile mkdtemp rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "../tools/backends/build.mjs" buildBackends)

  (defvar directory undefined)
  (defvar bytes undefined)

  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-gc-batch-"))))
    (let* ((b (await (buildBackends (js-object :outputRoot directory))))
           (source (str (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "\n(export heap-base heap-control)")))
      (setq bytes
        (Uint8Array/from
          (js-call (get b :wasm) :emit_memory_wasm
            (js-call (get b :compiler) :compile_ir_string source "gc-batch.eli")
            (js-object :maximumPages 128))))
      (js-call assert :deepEqual (js-call globalThis.WebAssembly.Module :imports (new globalThis.WebAssembly.Module bytes)) (js-array))))
    120000)

  (afterAll (async ()
    (when directory
      (await (rm directory (js-object :recursive t :force t))))))

  (defun runtime (&rest __host_default_arguments_1)
    (let* ((slots-arg (aref __host_default_arguments_1 0)) (capacity-arg (aref __host_default_arguments_1 1)))
    (let* ((slots (if (undefined? slots-arg) 128 slots-arg))
           (capacity (if (undefined? capacity-arg) 16384 capacity-arg))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module bytes)) :exports))
           (r (Object/fromEntries
                (js-call (Object/entries e) :map
                  (lambda (entry)
                    (let ((k (aref entry 0))
                          (v (aref entry 1)))
                      (js-array (js-call k :replaceAll "-" "_")
                                (if (= (value-type v) "function")
                                  (lambda (&rest a) (uint32 (Reflect/apply v e a)))
                                  v)))))))
           (heap (js-call r :heap_new slots capacity capacity)))
      (assert heap)
      (js-object :r r :h heap))))

  (defun layout (r h)
    (let* ((view (new globalThis.DataView (get (get r :memory) :buffer)))
           (base (js-call r :heap_base h))
           (out (js-array))
           (off (js-call r :heap_control h 6))
           (last 0))
      (while (> off 0)
        (assert (> off last))
        (let ((size (js-call view :getUint32 (+ base off) t)))
          (assert (>= size 32))
          (when (> last 0)
            (let ((prev (js-call out :at -1)))
              (assert (< (+ (aref prev 0) (aref prev 1)) off))))
          (js-call out :push (js-array off size))
          (setq last off)
          (setq off (js-call view :getUint32 (+ base off 4) t))
          (assert (< (js-length out) 1000))))
      out))

  (defun merge (intervals)
    (let ((out (js-array)))
      (js-call (js-call intervals :sort (lambda (a b) (- (aref a 0) (aref b 0)))) :forEach
        (lambda (pair)
          (let ((start (aref pair 0))
                (size (aref pair 1)))
            (if (and (> (js-length out) 0)
                     (= (+ (aref (js-call out :at -1) 0) (aref (js-call out :at -1) 1)) start))
              (let ((prev (js-call out :at -1)))
                (put prev 1 (+ (aref prev 1) size)))
              (js-call out :push (js-array start size))))))
      out))

  (test "fragmented sweep preserves exact free intervals, survivor locations and full tail reclamation" (lambda ()
    (let* ((rt (runtime))
           (r (get rt :r))
           (h (get rt :h))
           (blocks (js-array))
           (i 0))
      (while (< i 80)
        (let* ((length (+ 8 (* (% i 9) 8)))
               (x (js-call r :value_bytes h length)))
          (assert x)
          (js-call blocks :push
            (js-object :x x
                       :start (- (js-call r :value_data h x 6) 32 (js-call r :heap_base h))
                       :size (bit-and (+ length 39) (bit-not 7))))
          (when (= (% i 3) 0)
            (js-call r :heap_pin h x)))
        (setq i (1+ i)))
      (let* ((used (js-call r :heap_used h))
             (holes (merge (js-call (js-call blocks :filter (lambda (_ idx) (/= (% idx 3) 0)))
                             :map (lambda (b) (js-array (get b :start) (get b :size)))))))
        (when (and (> (js-length holes) 0)
                   (= (+ (aref (js-call holes :at -1) 0) (aref (js-call holes :at -1) 1)) used))
          (setq used (aref (js-call holes :pop) 0)))
        (js-call assert :equal (js-call r :heap_collect h) 53)
        (js-call assert :equal (js-call r :heap_used h) used)
        (js-call assert :deepEqual (layout r h) holes)
        (setq i 0)
        (while (< i 80)
          (when (= (% i 3) 0)
            (js-call assert :equal
              (- (js-call r :value_data h (get (aref blocks i) :x) 6) 32 (js-call r :heap_base h))
              (get (aref blocks i) :start))
            (js-call r :heap_release h (get (aref blocks i) :x)))
          (setq i (1+ i)))
        (js-call assert :equal (js-call r :heap_collect h) 27)
        (js-call assert :equal (js-call r :heap_used h) (* (+ 128 1) 24))
        (js-call assert :deepEqual (layout r h) (js-array))))))

  (test "random fragmented collections match an independent interval union and exact address-first-fit model" (lambda ()
    (let* ((rt (runtime))
           (r (get rt :r))
           (h (get rt :h))
           (cursor (* (+ 128 1) 24))
           (free (js-array))
           (live (js-array))
           (seed 2056503597)
           (next (lambda () (setq seed (uint32 (+ (Math/imul seed 1664525) 1013904223)))))
           (round 0))
      (while (< round 48)
        (let ((i 0))
          (while (< i 12)
            (let* ((length (% (funcall next) 160))
                   (size (bit-and (+ length 39) (bit-not 7)))
                   (expected cursor)
                   (actual size)
                   (index (js-call free :findIndex (lambda (pair) (>= (aref pair 1) size)))))
              (if (>= index 0)
                (let* ((pair (aref free index))
                       (start (aref pair 0))
                       (n (aref pair 1)))
                  (setq expected start)
                  (if (>= (- n size) 32)
                    (js-call free :splice index 1 (js-array (+ start size) (- n size)))
                    (progn
                      (setq actual n)
                      (js-call free :splice index 1))))
                (setq cursor (+ cursor size)))
              (let ((x (js-call r :value_bytes h length)))
                (assert x "bounded model allocation")
                (js-call assert :equal (- (js-call r :value_data h x 6) 32 (js-call r :heap_base h)) expected)
                (js-call r :heap_pin h x)
                (when (> length 0)
                  (js-call r :value_byte_set h x (- length 1) round))
                (js-call live :push (js-object :x x :start expected :size actual :length length :mark round))))
            (setq i (1+ i))))
        (let ((dead (js-array))
              (kept (js-array)))
          (js-call live :forEach
            (lambda (item)
              (if (/= (% (funcall next) 4) 0)
                (progn
                  (js-call r :heap_release h (get item :x))
                  (js-call dead :push item))
                (js-call kept :push item))))
          (setq free
            (merge (js-call free :concat (js-call dead :map (lambda (x) (js-array (get x :start) (get x :size)))))))
          (when (and (> (js-length free) 0)
                     (= (+ (aref (js-call free :at -1) 0) (aref (js-call free :at -1) 1)) cursor))
            (setq cursor (aref (js-call free :pop) 0)))
          (js-call assert :equal (js-call r :heap_collect h) (js-length dead))
          (js-call assert :equal (js-call r :heap_used h) cursor)
          (js-call assert :deepEqual (layout r h) free)
          (js-call dead :forEach
            (lambda (item)
              (js-call assert :equal (js-call r :value_kind h (get item :x)) 0)
              (js-call assert :equal (js-call r :last_error) 1)))
          (js-call kept :forEach
            (lambda (item)
              (js-call assert :equal (- (js-call r :value_data h (get item :x) 6) 32 (js-call r :heap_base h)) (get item :start))
              (when (> (get item :length) 0)
                (js-call assert :equal (js-call r :value_byte_get h (get item :x) (- (get item :length) 1)) (get item :mark)))))
          (setq live kept))
        (setq round (1+ round)))
      (js-call live :forEach (lambda (x) (js-call r :heap_release h (get x :x))))
      (js-call assert :equal (js-call r :heap_collect h) (js-length live))
      (js-call assert :equal (js-call r :heap_live h) 0)
      (js-call assert :equal (js-call r :heap_used h) (* (+ 128 1) 24)))))

  (test "existing and newly dead holes coalesce through the tail and restore capacity without relocating a survivor" (lambda ()
    (let* ((rt (runtime 8 512))
           (r (get rt :r))
           (h (get rt :h))
           (a (js-call r :value_bytes h 64))
           (b (js-call r :value_bytes h 64))
           (c (js-call r :value_bytes h 64)))
      (assert (and a b c))
      (js-call r :heap_pin h a)
      (js-call r :heap_pin h a)
      (js-call r :heap_pin h c)
      (js-call r :value_byte_set h a 63 197)
      (let ((address (js-call r :value_data h a 6)))
        (js-call r :heap_release h a)
        (js-call assert :equal (js-call r :value_bytes h 100) 0)
        (js-call assert :equal (js-call r :last_error) 2)
        (js-call assert :equal (js-call r :heap_collect h) 1)
        (js-call assert :deepEqual (layout r h) (js-array (js-array (+ 216 96) 96)))
        (js-call assert :equal (js-call r :value_bytes h 80) 0)
        (js-call assert :equal (js-call r :last_error) 2)
        (js-call r :heap_release h c)
        (js-call assert :equal (js-call r :heap_collect h) 1)
        (js-call assert :equal (js-call r :heap_used h) (+ 216 96))
        (js-call assert :deepEqual (layout r h) (js-array))
        (let ((replacement (js-call r :value_bytes h 100)))
          (assert replacement)
          (js-call assert :notEqual replacement b)
          (js-call assert :notEqual replacement c)
          (js-call assert :equal (js-call r :value_data h a 6) address)
          (js-call assert :equal (js-call r :value_byte_get h a 63) 197)
          (js-call (js-array b c) :forEach
            (lambda (stale)
              (js-call assert :equal (js-call r :value_kind h stale) 0)
              (js-call assert :equal (js-call r :last_error) 1)))
          (js-call r :heap_release h a)
          (js-call assert :equal (js-call r :heap_collect h) 2)
          (js-call assert :equal (js-call r :heap_live h) 0)
          (js-call assert :equal (js-call r :heap_used h) 216))))))

  (test "automatic full collections preserve frame roots, cycles, signed-number bits and a peer heap" (lambda ()
    (let* ((rt (runtime))
           (r (get rt :r))
           (h (get rt :h))
           (peer (js-call r :heap_new 64 4096 4096)))
      (assert peer)
      (let ((foreign (js-call r :value_bytes peer 16)))
        (js-call r :heap_pin peer foreign)
        (js-call r :value_byte_set peer foreign 15 93)
        (let* ((frame (js-call r :frame_new h 2))
               (root (js-call r :value_refs h 7 2))
               (n (js-call r :value_number h 0 2147483648)))
          (js-call r :frame_set h frame 0 root)
          (js-call r :value_set h root 0 root)
          (js-call r :value_set h root 1 n)
          (let ((address (js-call r :value_data h root 7))
                (i 0))
            (js-call r :heap_auto h 1)
            (while (< i 80)
              (let ((garbage (js-call r :value_bytes h (+ 8 (* (% i 9) 8)))))
                (assert garbage)
                (js-call assert :equal (js-call r :value_get h root 0) root)
                (js-call assert :equal (js-call r :value_data h root 7) address)
                (let* ((number (js-call r :value_get h root 1))
                       (data (js-call r :value_data h number 4)))
                  (assert (Object/is (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getFloat64 data t) -0.0)))
                (js-call assert :equal (js-call r :frame_depth h) 1)
                (js-call assert :equal (js-call r :value_byte_get peer foreign 15) 93))
              (setq i (1+ i)))
            (assert (>= (js-call r :heap_collections h) 80))
            (js-call r :heap_auto h 0)
            (js-call assert :equal (js-call r :heap_collect h) 1)
            (js-call r :frame_pop h frame)
            (js-call assert :equal (js-call r :heap_collect h) 3)
            (js-call assert :equal (js-call r :heap_live h) 0)
            (js-call assert :equal (js-call r :heap_used h) (* (+ 128 1) 24))
            (js-call assert :equal (js-call r :heap_live peer) 1)
            (js-call r :heap_release peer foreign)
            (js-call assert :equal (js-call r :heap_collect peer) 1)))))))

  (test "ordinary resize preserves its free intervals and GC subsequently merges those holes" (lambda ()
    (let* ((rt (runtime))
           (r (get rt :r))
           (h (get rt :h))
           (a (js-call r :value_bytes h 16))
           (barrier (js-call r :value_bytes h 16)))
      (js-call r :heap_pin h a)
      (js-call r :heap_pin h barrier)
      (let ((first (- (js-call r :value_data h a 6) 32 (js-call r :heap_base h))))
        (js-call assert :equal (js-call r :value_bytes_resize h a 128) 1)
        (js-call assert :deepEqual (layout r h) (js-array (js-array first 48)))
        (js-call r :heap_release h barrier)
        (js-call assert :equal (js-call r :heap_collect h) 1)
        (js-call assert :deepEqual (layout r h) (js-array (js-array first 96)))
        (js-call r :heap_release h a)
        (js-call assert :equal (js-call r :heap_collect h) 1)
        (js-call assert :deepEqual (layout r h) (js-array))
        (js-call assert :equal (js-call r :heap_used h) (* (+ 128 1) 24)))))))
