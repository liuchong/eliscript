  (test "managed bridge frames transfer root ownership, reject foreign tokens and unwind cleanup"
    (async ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (let ((parent (js-call a :frame 1))
              (n (js-call a :number -0.0)))
          (js-call a :frameSet parent 0 n)
          (js-call a :release n)
          (let* ((child (js-call a :frame 1))
                 (loaded (js-call a :frameGet parent 0)))
            (ok (Object/is (js-call a :readNumber loaded) -0.0))
            (js-call a :frameSet child 0 loaded)
            (let ((escaped (js-call a :frameReturn child loaded)))
              (js-call a :release loaded)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 1)
              (ok (Object/is (js-call a :readNumber escaped) -0.0))
              (js-call assert :throws (lambda () (js-call a :frameGet child 0))
                (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
              (js-call assert :throws (lambda () (js-call b :frameGet parent 0))
                (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
              (js-call a :unwindFrames)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 1)
              (js-call a :release escaped)
              (js-call assert :equal (js-call a :collect) 1))
            (js-call assert :throws (lambda () (js-call a :frameSet parent 0 t))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
            (js-call assert :throws (lambda () (js-call a :auto -0.0))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003"))))))))

  (test "automatic bridge construction protects borrowed operands and releases temporary roots on failure"
    (async ()
      (js-call (js-array "array" "record") :forEach
        (lambda (kind)
          (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 16 :initialBytes 2048 :maxBytes 2048)))
                 (_auto (js-call a :auto 1))
                 (n (js-call a :number -0.0))
                 (input (js-array n n nil)))
            (js-call a :release n)
            (Object/defineProperty input 1
              (js-object :get (lambda ()
                                (let ((temporary (js-call a :number 42)))
                                  (js-call a :release temporary)
                                  n))))
            (let* ((result (funcall (get a kind) input))
                   (child (js-call a :get result 0)))
              (ok (Object/is (js-call a :readNumber child) -0.0))
              (js-call a :release child)
              (let ((second (js-call a :get result 1)))
                (ok (Object/is (js-call a :readNumber second) -0.0))
                (js-call a :release second))
              (js-call a :release result)
              (js-call a :collect)
              (js-call assert :equal (js-call a :live) 0)
              (js-call assert :equal (get (js-call a :stats) :frameDepth) 0)))))
      (let* ((a (instantiateManagedRuntime bytes (js-object :maxSlots 1 :initialBytes 256 :maxBytes 256)))
             (n (js-call a :number 7)))
        (js-call a :release n)
        (js-call a :auto 1)
        (js-call assert :throws (lambda () (js-call a :array (js-array n)))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0002")))
        (js-call assert :equal (js-call a :readNumber n) 7)
        (js-call assert :equal (js-call a :collect) 1)
        (js-call assert :equal (js-call a :live) 0))))

  (defasync root-program ()
    (let* ((source (await (readFile (resolve "bootstrap/runtime/memory.eli") "utf8")))
           (program (+ source
                       "\n (defun root-loop (heap rounds)"
                       "\n   (let* ((frame (frame-new heap 1)) (i 0) (initial (value-number heap 0 1072693248)))"
                       "\n     (frame-set heap frame 0 initial)"
                       "\n     (while (< i rounds)"
                       "\n       (let* ((inner (frame-new heap 2)) (two (value-number heap 0 1073741824)))"
                       "\n         (frame-set heap inner 0 two)"
                       "\n         (let ((sum (value-number-binary heap (frame-get heap frame 0) two 0)))"
                       "\n           (frame-set heap inner 1 sum)"
                       "\n           (let ((output (frame-return heap inner sum)))"
                       "\n             (frame-set heap frame 0 output) (heap-release heap output))))"
                       "\n       (setq i (1+ i)))"
                       "\n     (frame-return heap frame (frame-get heap frame 0))))"
                       "\n (defun root-trap (heap)"
                       "\n   (let* ((frame (frame-new heap 1)) (value (value-number heap 0 1072693248)))"
                       "\n     (frame-set heap frame 0 value) (load-u32 4294967295) 0))"
                       "\n (defun root-recursive (heap depth)"
                       "\n   (let* ((frame (frame-new heap 2)) (one (value-number heap 0 1072693248)))"
                       "\n     (frame-set heap frame 0 one)"
                       "\n     (if (= depth 0) (frame-return heap frame one)"
                       "\n       (let ((child (root-recursive heap (1- depth))))"
                       "\n         (frame-set heap frame 1 child) (heap-release heap child)"
                       "\n         (let ((sum (value-number-binary heap one child 0)))"
                       "\n           (frame-set heap frame 0 sum) (frame-return heap frame sum))))))"
                       "\n (export root-loop root-trap root-recursive)"))
           (artifact (globalThis.Uint8Array.from
                       (js-call (get backend :wasm) :emit_memory_wasm
                         (js-call (get backend :compiler) :compile_ir_string program "root-workload.eli")
                         (js-object :maximumPages 4)))))
      (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module artifact)) (js-array))
      artifact))

  (test "WASM internal root loops collect under pressure and trap cleanup removes every frame"
    (async ()
      (let* ((artifact (await (root-program)))
             (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module artifact)) :exports))
             (r (wrap-wasm-exports e))
             (h (js-call r :heap_new 12 768 768)))
        (js-call r :heap_auto h 1)
        (let ((output (js-call r :root_loop h 1000)))
          (ok (> output 0))
          (js-call assert :equal (unbox r h output) 2001)
          (js-call assert :equal (js-call r :frame_depth h) 0)
          (ok (> (js-call r :heap_collections h) 3000))
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 1)
          (js-call r :heap_release h output)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0))
        (js-call assert :throws (lambda () (js-call r :root_trap h)) globalThis.WebAssembly.RuntimeError)
        (js-call assert :equal (js-call r :frame_depth h) 1)
        (js-call assert :equal (js-call r :frame_unwind h 0) 1)
        (js-call assert :equal (js-call r :heap_collect h) 2)
        (js-call assert :equal (js-call r :heap_live h) 0)
        (js-call assert :equal (js-call r :heap_capacity h) 768)
        (let ((recursive-heap (js-call r :heap_new 192 8192 32768)))
          (js-call r :heap_auto recursive-heap 1)
          (let ((recursive (js-call r :root_recursive recursive-heap 64)))
            (ok (> recursive 0))
            (js-call assert :equal (unbox r recursive-heap recursive) 65)
            (js-call assert :equal (js-call r :frame_depth recursive-heap) 0)
            (js-call r :heap_collect recursive-heap)
            (js-call assert :equal (js-call r :heap_live recursive-heap) 1)
            (js-call r :heap_release recursive-heap recursive)
            (js-call assert :equal (js-call r :heap_collect recursive-heap) 1)
            (js-call assert :equal (js-call r :heap_used recursive-heap) (* 193 24)))))))

