        (js-call r :heap_pin h root)
        (js-call assert :equal (js-call r :value_set h root 0 a) 1)
        (js-call assert :equal (js-call r :value_set h root 2 b) 1)
        (js-call r :heap_auto h 1)
        (let* ((before (js-call r :heap_collections h))
               (first (number r h 44)))
          (ok (> first 0))
          (js-call assert :equal (js-call r :heap_collections h) (1+ before))
          (js-call assert :equal (js-call r :value_kind h garbage) 0)
          (js-call assert :equal (js-call r :last_error) 1)
          (js-call assert :equal (js-call r :value_get h root 1) 3)
          (js-call assert :equal (unbox r h a) 11)
          (js-call assert :equal (unbox r h b) 22)
          (js-call assert :equal (js-call r :value_set h root 0 3) 1)
          (let ((second (number r h 55)))
            (ok (> second 0))
            (js-call assert :equal (js-call r :heap_collections h) (+ before 2))
            (js-call assert :equal (js-call r :value_kind h a) 0)
            (js-call assert :equal (js-call r :last_error) 1)
            (js-call assert :equal (js-call r :value_kind h first) 0)
            (js-call assert :equal (js-call r :last_error) 1)
            (js-call assert :equal (unbox r h b) 22)
            (js-call r :heap_release h root)
            (js-call assert :equal (js-call r :heap_collect h) 3)
            (js-call assert :equal (js-call r :heap_live h) 0))))))

  (test "temporarily borrowed unpinned operands survive allocation safepoints and become collectible after return"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (right-text (+ (String/fromCharCode 55296) "right"))
             (expected (+ "left" right-text))
             (left (managed-string r h "left"))
             (right (managed-string r h right-text)))
