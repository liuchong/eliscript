                 :forEach
                 (lambda (needle)
                   (let ((b (managed-string r h needle))
                         (before (js-call r :heap_used h))
                         (live (js-call r :heap_live h)))
                     (js-call (js-array 0 1 100000 (js-length text)) :forEach
                       (lambda (start)
                         (let ((expected (js-call text :indexOf needle start)))
                           (js-call assert :equal (js-call r :value_string_find h a b start)
                             (if (= expected -1) 4294967295 expected)))))
                     (js-call assert :equal (js-call r :heap_used h) before)
                     (js-call assert :equal (js-call r :heap_live h) live)
                     (js-call r :heap_pin h a)
                     (js-call r :heap_collect h)
                     (js-call r :heap_release h a)))))))

  (test "managed UTF8 random differentials survive per-allocation collection and reject before allocation"
    (lambda ()
      (let* ((ctx (runtime 16 4096 32768)) (r (get ctx :r)) (h (get ctx :h))
             (_auto (js-call r :heap_auto h 1))
             (state 138805683)
             (next-u32 (lambda ()
                         (setq state (bit-xor state (bit-shift-left state 13)))
                         (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                         (setq state (bit-xor state (bit-shift-left state 5)))
                         (uint32 state)))
             (surrogate-re (new globalThis.RegExp "\\p{Surrogate}" "u"))
             (round 0))
        (while (< round 2048)
          (let* ((text (js-call (Array/from (js-object :length (% (funcall next-u32) 64))
                                  (lambda () (String/fromCharCode (bit-and (funcall next-u32) 65535))))
                                :join ""))
                 (source (managed-string r h text)))
