          (js-call assert :equal (js-call r :value_number_compare h n n 6) 0)
          (js-call assert :equal (js-call r :last_error) 3)
          (js-call assert :equal (js-call r :value_truth h 4) 0)
          (js-call assert :equal (js-call r :last_error) 1))
        (let ((string (js-call r :value_string h 1)))
