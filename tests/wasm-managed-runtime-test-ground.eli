(module tests.wasm-managed-runtime-test-ground
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:child_process" spawnSync)
  (import "node:fs/promises" mkdtemp rm readFile writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../runtime/core/value.mjs" hashValue equalValues)

  (defconst runtime-node-path
    (fileURLToPath (new globalThis.URL "./helpers/wasm-managed-runtime-node.mjs" (get (js* "import.meta") :url))))

  (defvar directory nil)
  (defvar backend nil)
  (defvar bytes nil)
  (defvar memory-program nil)
  (defvar memory-source nil)

  (defun ok (cond &rest msgs)
    (Reflect/apply (get assert :ok) assert (js-call (js-array cond) :concat msgs)))

  (defun string-less-p (a b)
    (let ((limit (Math/min (js-length a) (js-length b)))
          (i 0)
          (decided false)
          (result false))
      (while (and (< i limit) (not decided))
        (let ((ca (string-code-unit-at a i))
              (cb (string-code-unit-at b i)))
          (when (/= ca cb)
            (setq decided t result (< ca cb))))
        (setq i (1+ i)))
      (if decided result (< (js-length a) (js-length b)))))

  (defun wrap-wasm-exports (exports)
    (let ((r (js-object)))
      (js-call (Object/entries exports) :forEach
        (lambda (entry)
          (let ((k (aref entry 0))
                (v (aref entry 1)))
            (put r (js-call k :replaceAll "-" "_")
              (if (= (value-type v) "function")
                  (lambda (&rest args) (uint32 (Reflect/apply v undefined args)))
                v)))))
      r))

  (defun runtime (&rest __host_default_arguments_1)
    (let* ((slots (aref __host_default_arguments_1 0)) (initial (aref __host_default_arguments_1 1)) (max (aref __host_default_arguments_1 2)) (artifact (aref __host_default_arguments_1 3)))
    (let* ((slots-v (if (undefined? slots) 64 slots))
           (initial-v (if (undefined? initial) 4096 initial))
           (max-v (if (undefined? max) 1048576 max))
           (artifact-v (if (undefined? artifact) bytes artifact))
           (e (get (new globalThis.WebAssembly.Instance (new globalThis.WebAssembly.Module artifact-v)) :exports))
           (r (wrap-wasm-exports e))
           (h (js-call r :heap_new slots-v initial-v max-v)))
      (ok (> h 0))
      (js-object :r r :h h))))

  (defun number (r h x)
    (let ((v (new globalThis.DataView (new globalThis.ArrayBuffer 8))))
      (js-call v :setFloat64 0 x t)
      (js-call r :value_number h (js-call v :getUint32 0 t) (js-call v :getUint32 4 t))))

  (defun unbox (r h x)
    (let ((p (js-call r :value_data h x 4)))
      (ok (> p 0))
      (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getFloat64 p t)))

  (defun managed-string (r h text)
    (let ((value (js-call r :value_string h (js-length text)))
          (i 0))
      (ok (> value 0))
      (while (< i (js-length text))
        (js-call assert :equal (js-call r :value_unit_set h value i (string-code-unit-at text i)) 1)
        (setq i (1+ i)))
      (js-call assert :equal (js-call r :value_seal h value) value)
      value))

  (defun read-managed-string (r h value)
    (let* ((length (js-call r :value_length h value))
           (p (js-call r :value_data h value 5))
           (view (new globalThis.DataView (get (get r :memory) :buffer)))
           (parts (js-array))
           (i 0))
      (ok (> p 0))
      (while (< i length)
        (let ((units (js-array))
              (end (Math/min (+ i 8192) length))
              (j i))
          (while (< j end)
            (js-call units :push (js-call view :getUint16 (+ p (* 2 j)) t))
            (setq j (1+ j)))
          (js-call parts :push (Reflect/apply String/fromCharCode globalThis.String units)))
        (setq i (+ i 8192)))
      (js-call parts :join "")))

  (defun managed-bytes (r h input)
    (let ((value (js-call r :value_bytes h (js-length input)))
          (i 0))
      (ok (> value 0))
      (while (< i (js-length input))
        (js-call assert :equal (js-call r :value_byte_set h value i (aref input i)) 1)
        (setq i (1+ i)))
      value))

  (defun read-managed-bytes (r h value)
    (let ((length (js-call r :value_length h value))
          (p (js-call r :value_data h value 6)))
      (ok (> p 0))
      (js-call (new globalThis.Uint8Array (get (get r :memory) :buffer) p length) :slice)))

  (defun managed-pool-layout (r h)
    (let* ((view (new globalThis.DataView (get (get r :memory) :buffer)))
           (control (js-call view :getUint32 (+ h 16) t))
           (pool (js-call view :getUint32 (+ control 4) t)))
      (js-object :view view :control control
                 :base (js-call view :getUint32 (+ pool 16) t)
                 :maximum (js-call view :getUint32 (+ control 8) t)
                 :highwater (js-call view :getUint32 (+ control 12) t))))

  (defun named-cache-address (r h code)
    (let* ((layout (managed-pool-layout r h))
           (base (get layout :base))
           (maximum (get layout :maximum))
           (highwater (get layout :highwater)))
      (ok (>= maximum 512))
      (ok (< highwater (- maximum 255)) "test only accesses an unallocated cache window")
      (+ base (* (+ (- maximum 255) (bit-and code 255)) 24) 16)))

  (beforeAll
    (async ()
      (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-managed-"))))
      (setq backend (await (buildBackends (js-object :outputRoot directory))))
      (setq memory-source (await (readFile (resolve "bootstrap/runtime/memory.eli") "utf8")))
      (let ((source (+ memory-source
                       "\n(defun gc-named (heap code) (value-function-named heap code))"
                       "\n(defun gc-unnamed (heap code) (value-function-new heap code 0))"
                       "\n(defun gc-defragment (heap) (heap-defragment heap)) (export gc-named gc-unnamed gc-defragment)")))
        (setq memory-program (js-call (get backend :compiler) :compile_ir_string source "managed-runtime.eli"))
        (setq bytes (globalThis.Uint8Array.from
                      (js-call (get backend :wasm) :emit_memory_wasm memory-program (js-object :maximumPages 256))))
        (ok (globalThis.WebAssembly.validate bytes))
        (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports (new globalThis.WebAssembly.Module bytes)) (js-array))))
    120000)

  (afterAll
    (async ()
      (when directory
        (await (rm directory (js-object :recursive t :force t))))))

  (test "Given the complete runtime module when every helper is compiled then all source helper declarations stay direct module bindings and preserve forward visibility"
    (lambda ()
      (let ((modules (js-call (get memory-program :body) :filter (lambda (node) (= (get node :kind) "module-declaration")))))
        (js-call assert :equal (js-length modules) 1)
        (let* ((mod (aref modules 0))
               (declarations (js-call (get mod :children) :filter (lambda (node) (= (get node :kind) "function-declaration"))))
               (pattern (new globalThis.RegExp "^  \\(defun ([^()\\s]+)" "gm"))
               (expected (js-call (Array/from (js-call memory-source :matchAll pattern)) :map (lambda (m) (aref m 1)))))
          (js-call assert :deepEqual (js-call declarations :map (lambda (node) (get node :value))) expected)
          (js-call assert :deepEqual
            (js-call (js-call (get memory-program :body) :filter (lambda (node) (= (get node :kind) "function-declaration")))
                     :map (lambda (node) (get node :value)))
            (js-array "gc-named" "gc-unnamed" "gc-defragment"))
          (js-call declarations :forEach
            (lambda (declaration)
              (let ((pending (js-call (get declaration :children) :slice)))
                (while (> (js-length pending) 0)
                  (let ((node (js-call pending :pop)))
                    (js-call assert :notEqual (get node :kind) "function-declaration"
                      (+ "runtime helper nested under " (get declaration :value)))
                    (Reflect/apply (get pending :push) pending (get node :children)))))))
          (js-call (js-array "heap-object-data-flags" "heap-error-prototype" "value-math-sum-precise"
                             "heap-source-wrapper-kind" "heap-source-own-bag" "value-function-class"
                             "value-function-class-invoke")
                   :forEach
                   (lambda (name)
                     (js-call assert :equal
                       (js-length (js-call declarations :filter (lambda (node) (= (get node :value) name))))
                       1 (+ name " has exactly one module binding"))))))))

  (test "Given wrapper class and constructor helpers when their frames finish then cleanup is a statement and the lexical result is the numeric return value"
    (lambda ()
      (let ((mod (js-call (get memory-program :body) :find (lambda (node) (= (get node :kind) "module-declaration")))))
        (js-call (js-array "value-function-class" "value-function-class-invoke" "value-function-wrapper" "heap-function-invoke-constructor")
                 :forEach
                 (lambda (name)
                   (let ((declaration (js-call (get mod :children) :find
                                        (lambda (node) (and (= (get node :kind) "function-declaration") (= (get node :value) name))))))
                     (ok declaration (+ name " is a module declaration"))
                     (let ((pending (js-call (get declaration :children) :slice))
                           (frames (js-array)))
                       (while (> (js-length pending) 0)
                         (let ((node (js-call pending :pop)))
                           (when (= (get node :kind) "lexical-bindings")
                             (let ((bindings (js-call (js-call (get node :children) :slice 0 (get (get node :properties) :bindingCount))
                                                      :map (lambda (b) (get b :value)))))
                               (when (and (js-call bindings :includes "frame") (js-call bindings :includes "result"))
                                 (js-call frames :push node))))
                           (Reflect/apply (get pending :push) pending (get node :children))))
                       (js-call assert :equal (js-length frames) 1 (+ name " owns one result frame"))
                       (let* ((frame (aref frames 0))
                              (result (js-call (get frame :children) :at -1))
                              (guard (js-call (get frame :children) :at -2)))
                         (js-call assert :equal (get result :kind) "reference" (+ name " returns an actual value after the frame guard"))
                         (js-call assert :equal (get result :value) "result")
                         (js-call assert :equal (get guard :kind) "conditional-sugar")
                         (js-call assert :equal (get guard :value) "when")
                         (let ((cleanup (js-call (get guard :children) :at -1)))
                           (js-call assert :equal (get cleanup :kind) "assignment" (+ name " always closes the entered frame"))
                           (js-call assert :equal (js-length (get cleanup :children)) 1)
                           (js-call assert :equal (get (aref (get cleanup :children) 0) :value) "result")
                           (let ((call (aref (get (aref (get cleanup :children) 0) :children) 0)))
                             (js-call assert :equal (get call :kind) "call")
                             (js-call assert :equal (get (aref (get call :children) 0) :kind) "reference")
                             (js-call assert :equal (get (aref (get call :children) 0) :value) "heap-frame-result")))))))))))

  (test "raw construction distinguishes valid nonconstructors from invalid handles after validating arguments and preserves caller roots"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (owned (js-array))
             (own (lambda (value)
                    (ok (> value 3))
                    (js-call assert :equal (js-call r :heap_pin h value) 1)
                    (js-call owned :push value)
                    value))
             (held (funcall own (number r h -0.0)))
             (args (funcall own (js-call r :value_refs h 7 1))))
        (js-call assert :equal (js-call r :value_set h args 0 held) 1)
        (let* ((text (funcall own (managed-string r h "not a constructor")))
               (object (funcall own (js-call r :value_object_new h 3)))
               (array (funcall own (js-call r :value_array_new h 0)))
               (name (funcall own (managed-string r h "nonconstructor")))
               (callable (funcall own (js-call r :gc_named h 77))))
          (js-call assert :equal (js-call r :value_function_describe h callable name 0 0 0 78) callable)
          (js-call assert :equal (js-call r :value_function_callable h callable) 1)
          (js-call assert :equal (js-call r :value_function_constructible h callable) 0)
          (js-call assert :equal (js-call r :last_error) 0)
          (let ((frame (js-call r :frame_new h 1)))
            (ok (> frame 3))
            (js-call assert :equal (js-call r :frame_set h frame 0 held) 1)
            (js-call r :heap_auto h 1)
            (let ((rejected (lambda (target arguments-list count code source-class)
                              (js-call assert :equal (js-call r :value_exception_class_set h 0) 1)
                              (js-call assert :equal (js-call r :value_source_construct h target arguments-list count) 0)
                              (js-call assert :equal (js-call r :last_error) code)
                              (js-call assert :equal (js-call r :value_exception_class h) source-class)
                              (js-call assert :equal (js-call r :value_exception_class_set h 0) 1)
                              (js-call assert :equal (js-call r :frame_depth h) 1)
                              (js-call assert :equal (js-call r :frame_get h frame 0) held)
                              (ok (Object/is (unbox r h held) -0.0))
                              (js-call r :heap_collect h)
                              (js-call assert :equal (js-call r :frame_depth h) 1)
                              (js-call assert :equal (js-call r :value_get h args 0) held)
                              (ok (Object/is (unbox r h held) -0.0)))))
              (try
                (progn
                  (js-call (js-array 0 1 2 3 held text object array callable) :forEach
                    (lambda (target) (funcall rejected target args 1 3 2)))
                  (funcall rejected 1 0 0 1 0)
                  (funcall rejected 1 object 0 1 0)
                  (funcall rejected 1 args 0 3 0)
                  (funcall rejected 4294967295 args 0 3 0)
                  (let ((stale (js-call r :value_object_new h 3)))
                    (ok (> stale 3))
                    (js-call r :heap_collect h)
                    (js-call assert :equal (js-call r :value_kind h stale) 0)
                    (js-call assert :equal (js-call r :last_error) 1)
                    (funcall rejected stale args 1 1 0)
                    (funcall rejected 4294967295 args 1 1 0))
                  (let ((stale-function (js-call r :gc_named h 79)))
                    (ok (> stale-function 3))
                    (js-call r :heap_collect h)
                    (js-call assert :equal (js-call r :value_kind h stale-function) 0)
                    (js-call assert :equal (js-call r :last_error) 1)
                    (funcall rejected stale-function args 1 1 0))
                  (let ((recovered (funcall own (js-call r :value_object_new h 3))))
                    (js-call assert :equal (js-call r :value_kind h recovered) 13)
                    (js-call assert :equal (js-call r :value_set h args 0 held) 1)
                    (funcall rejected 1 args 1 3 2)))
                (finally
                  (js-call assert :equal (js-call r :frame_pop h frame) 1)
                  (js-call assert :equal (js-call r :frame_depth h) 0)
                  (js-call owned :forEach (lambda (value) (js-call assert :equal (js-call r :heap_release h value) 1)))
                  (js-call r :heap_collect h)
                  (js-call assert :equal (js-call r :heap_live h) 0)
                  (js-call assert :equal (js-call r :frame_depth h) 0)))))))))

  (test "weak named cache validates collisions and candidate identity without retaining values through collection or pool movement"
    (lambda ()
      (let* ((ctx (runtime 512 16384 262144)) (r (get ctx :r)) (h (get ctx :h))
             (owned (new globalThis.Set))
             (own (lambda (value)
                    (ok (> value 3))
                    (js-call assert :equal (js-call r :heap_pin h value) 1)
                    (js-call owned :add value)
                    value))
             (held (funcall own (number r h -0.0)))
             (first (funcall own (js-call r :gc_named h 0)))
             (collision (funcall own (js-call r :gc_named h 256)))
             (frame (js-call r :frame_new h 1))
             (cell (lambda () (named-cache-address r h 0)))
             (cached (lambda () (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 (funcall cell) t)))
             (counts (lambda () (js-array (js-call r :heap_live h) (js-call r :heap_used h) (js-call r :frame_depth h)))))
        (ok (> frame 3))
        (js-call r :frame_set h frame 0 held)
        (try
          (progn
            (js-call assert :equal (funcall cached) collision "colliding code replaces only the weak cache entry")
            (let ((before (funcall counts))
                  (repeat 0))
              (while (< repeat 16)
                (js-call assert :equal (js-call r :gc_named h 0) first)
                (js-call assert :equal (funcall cached) first)
                (js-call assert :equal (js-call r :gc_named h 256) collision)
                (js-call assert :equal (funcall cached) collision)
                (setq repeat (1+ repeat)))
              (js-call assert :deepEqual (funcall counts) before "cache hits and collision misses do not allocate"))
            (js-call (js-array 4294967295 held collision) :forEach
              (lambda (candidate)
                (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :setUint32 (funcall cell) candidate t)
                (js-call assert :equal (js-call r :gc_named h 0) first)
                (js-call assert :equal (js-call r :last_error) 0)
                (js-call assert :equal (funcall cached) first)))
            (let ((dead (js-call r :gc_named h 321)))
              (ok (> dead 3))
              (js-call assert :equal
                (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 (named-cache-address r h 321) t)
                dead)
              (js-call assert :equal (js-call r :heap_collect h) 1 "a cached function with no caller roots is collectible")
              (js-call assert :equal (js-call r :value_kind h dead) 0)
              (js-call assert :equal (js-call r :last_error) 1)
              (let ((unnamed (funcall own (js-call r :gc_unnamed h 321))))
                (js-call assert :equal (bit-and unnamed 1048575) (bit-and dead 1048575))
                (js-call assert :notEqual (unsigned-bit-shift-right unnamed 20) (unsigned-bit-shift-right dead 20))
                (let ((replacement (funcall own (js-call r :gc_named h 321))))
                  (js-call assert :notEqual replacement dead)
                  (js-call assert :notEqual replacement unnamed)
                  (js-call assert :equal (js-call r :value_kind h unnamed) 18)
                  (let ((same-code-counts (funcall counts)))
                    (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :setUint32 (named-cache-address r h 321) unnamed t)
                    (js-call assert :equal (js-call r :gc_named h 321) replacement "an unnamed callable with the same code is not a named identity")
                    (js-call assert :deepEqual (funcall counts) same-code-counts))
                  (let* ((high (funcall own (js-call r :gc_named h 4294967295)))
                         (previous-base (get (managed-pool-layout r h) :base))
                         (gap (funcall own (js-call r :value_bytes h 31)))
                         (blob (funcall own (js-call r :value_bytes h 30000))))
                    (js-call assert :equal (js-call r :gc_named h 4294967295) high)
                    (js-call assert :notEqual (get (managed-pool-layout r h) :base) previous-base "the real pool has moved on growth")
                    (js-call assert :equal (js-call r :value_byte_set h blob 0 17) 1)
                    (js-call assert :equal (js-call r :value_byte_set h blob 29999 239) 1)
                    (js-call assert :equal (js-call r :heap_release h gap) 1)
                    (js-call owned :delete gap)
                    (js-call r :heap_collect h)
                    (js-call assert :equal (js-call r :gc_defragment h) 1)
                    (js-call (js-array (js-array 0 first) (js-array 256 collision) (js-array 321 replacement) (js-array 4294967295 high))
                             :forEach
                             (lambda (pair) (js-call assert :equal (js-call r :gc_named h (aref pair 0)) (aref pair 1))))
                    (js-call assert :equal (js-call r :value_byte_get h blob 0) 17)
                    (js-call assert :equal (js-call r :value_byte_get h blob 29999) 239)))))
            (js-call assert :equal (js-call r :frame_get h frame 0) held)
            (ok (Object/is (unbox r h held) -0.0))
            (js-call assert :equal (js-call r :frame_depth h) 1)
            (js-call assert :equal (js-call r :gc_named 0 0) 0)
            (js-call assert :equal (js-call r :last_error) 1)
            (js-call assert :equal (js-call r :gc_named h 0) first "invalid heap failure does not change another heap cache"))
          (finally
            (js-call assert :equal (js-call r :frame_pop h frame) 1)
            (js-call owned :forEach (lambda (value) (js-call assert :equal (js-call r :heap_release h value) 1)))
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0)
            (js-call assert :equal (js-call r :frame_depth h) 0))))))

  (test "weak named caches are per heap and small heaps keep their original uncached slot-table contract"
    (lambda ()
      (let* ((ctx (runtime 512 16384 65536)) (r (get ctx :r)) (h (get ctx :h))
             (peer (js-call r :heap_new 512 16384 65536)))
        (ok (> peer 0))
        (let ((first (js-call r :gc_named h 73))
              (prefix (number r peer -0.0)))
          (js-call r :heap_pin h first)
          (js-call r :heap_pin peer prefix)
          (let ((second (js-call r :gc_named peer 73)))
            (js-call r :heap_pin peer second)
            (try
              (progn
                (js-call assert :notEqual first second "different live slots make the two heap identities independently observable")
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 (named-cache-address r h 73) t)
                  first)
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 (named-cache-address r peer 73) t)
                  second)
                (js-call r :heap_collect h)
                (js-call r :heap_collect peer)
                (js-call assert :equal (js-call r :gc_named h 73) first)
                (js-call assert :equal (js-call r :gc_named peer 73) second)
                (ok (Object/is (unbox r peer prefix) -0.0)))
              (finally
                (js-call r :heap_release h first)
                (js-call r :heap_release peer prefix)
                (js-call r :heap_release peer second)
                (js-call r :heap_collect h)
                (js-call r :heap_collect peer)
                (js-call assert :equal (js-call r :heap_live h) 0)
                (js-call assert :equal (js-call r :heap_live peer) 0)))))
        (let* ((small (js-call r :heap_new 511 16384 65536))
               (_s (ok (> small 0)))
               (layout (managed-pool-layout r small))
               (untouched (+ (get layout :base) (* 511 24) 16)))
          (js-call (get layout :view) :setUint32 untouched 1985229328 t)
          (let ((value (js-call r :gc_named small 255)))
            (ok (> value 3))
            (js-call r :heap_pin small value)
            (js-call assert :equal (js-call r :gc_named small 255) value)
            (js-call assert :equal
              (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 untouched t)
              1985229328)
            (js-call r :heap_release small value)
            (js-call r :heap_collect small)
            (js-call assert :equal (js-call r :heap_live small) 0)))
        (js-call assert :equal (js-call r :retire) 1)
        (js-call assert :equal (js-call r :gc_named h 73) 0)
        (js-call assert :equal (js-call r :last_error) 1)
        (let ((fresh (js-call r :heap_new 512 16384 65536)))
          (ok (> fresh 0))
          (ok (> (js-call r :gc_named fresh 73) 3))
          (js-call r :heap_collect fresh)
          (js-call assert :equal (js-call r :heap_live fresh) 0)))))

  (test "allocating the first cache-tail entry disables lookup and writes before all slots remain usable"
    (lambda ()
      (let* ((ctx (runtime 512 65536 65536)) (r (get ctx :r)) (h (get ctx :h))
             (owned (js-array))
             (own (lambda (value)
                    (ok (> value 3))
                    (js-call assert :equal (js-call r :heap_pin h value) 1)
                    (js-call owned :push value)
                    value))
             (first (funcall own (js-call r :gc_named h 0)))
             (held (funcall own (number r h -0.0)))
             (frame (js-call r :frame_new h 1)))
        (ok (> frame 3))
        (js-call r :frame_set h frame 0 held)
        (try
          (progn
            (while (< (get (managed-pool-layout r h) :highwater) 256)
              (funcall own (number r h 7)))
            (let ((old-cell (named-cache-address r h 0)))
              (js-call assert :equal
                (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t)
                first)
              (let ((boundary (js-call r :gc_named h 256)))
                (ok (> boundary 3))
                (js-call assert :equal (bit-and boundary 1048575) 257)
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t)
                  0 "fresh allocation clears the cache hint and the post-allocation cache write must stay disabled")
                (funcall own boundary)
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t)
                  1)
                (js-call assert :equal (js-call r :gc_named h 0) first)
                (js-call assert :equal (js-call r :gc_named h 256) boundary)
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t)
                  1 "fallback does not write into an active root counter")
                (while (< (js-call r :heap_live h) 512)
                  (funcall own (number r h 7)))
                (let ((before (js-array (js-call r :heap_live h) (js-call r :heap_used h) (js-call r :frame_depth h))))
                  (js-call assert :equal (js-call r :gc_named h 512) 0)
                  (js-call assert :equal (js-call r :last_error) 2)
                  (js-call assert :deepEqual (js-array (js-call r :heap_live h) (js-call r :heap_used h) (js-call r :frame_depth h)) before))
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 old-cell t)
                  1)
                (js-call assert :equal (js-call r :gc_named h 0) first)
                (js-call assert :equal (js-call r :gc_named h 256) boundary)
                (js-call r :heap_collect h)
                (js-call assert :equal (js-call r :heap_live h) 512)
                (js-call assert :equal (js-call r :frame_depth h) 1)
                (ok (Object/is (unbox r h held) -0.0)))))
          (finally
            (js-call r :frame_pop h frame)
            (js-call owned :forEach (lambda (value) (js-call r :heap_release h value)))
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0)
            (js-call assert :equal (js-call r :frame_depth h) 0)))
        (let ((rebuilt (js-call r :gc_named h 0)))
          (ok (> rebuilt 3))
          (js-call assert :notEqual rebuilt first)
          (js-call assert :equal (js-call r :gc_named h 0) rebuilt)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)))))

  (test "a failed cache miss preserves the old hint and caller state and retries after the original byte budget is freed"
    (lambda ()
      (let* ((ctx (runtime 512 16384 16384)) (r (get ctx :r)) (h (get ctx :h))
             (owned (new globalThis.Set))
             (own (lambda (value)
                    (ok (> value 3))
                    (js-call assert :equal (js-call r :heap_pin h value) 1)
                    (js-call owned :add value)
                    value))
             (first (funcall own (js-call r :gc_named h 0)))
             (held (funcall own (number r h -0.0)))
             (frame (js-call r :frame_new h 1)))
        (ok (> frame 3))
        (js-call r :frame_set h frame 0 held)
        (try
          (let ((remaining (- (js-call r :heap_capacity h) (js-call r :heap_used h))))
            (ok (>= remaining 32))
            (let ((filler (funcall own (js-call r :value_bytes h (- remaining 32)))))
              (js-call assert :equal (js-call r :heap_used h) 16384)
              (let* ((address (named-cache-address r h 0))
                     (hint (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 address t))
                     (before (js-array (js-call r :heap_live h) (js-call r :heap_used h) (js-call r :frame_depth h))))
                (js-call assert :equal (js-call r :gc_named h 256) 0)
                (js-call assert :equal (js-call r :last_error) 2)
                (js-call assert :deepEqual (js-array (js-call r :heap_live h) (js-call r :heap_used h) (js-call r :frame_depth h)) before)
                (js-call assert :equal
                  (js-call (new globalThis.DataView (get (get r :memory) :buffer)) :getUint32 (named-cache-address r h 0) t)
                  hint)
                (js-call assert :equal (js-call r :gc_named h 0) first)
                (ok (Object/is (unbox r h held) -0.0))
                (js-call r :heap_release h filler)
                (js-call owned :delete filler)
                (js-call r :heap_collect h)
                (let ((recovered (funcall own (js-call r :gc_named h 256))))
                  (js-call assert :notEqual recovered first)
                  (js-call assert :equal (js-call r :last_error) 0)
                  (js-call assert :equal (js-call r :gc_named h 0) first)
                  (js-call assert :equal (js-call r :frame_get h frame 0) held)
                  (js-call assert :equal (js-call r :frame_depth h) 1)))))
          (finally
            (js-call r :frame_pop h frame)
            (js-call owned :forEach (lambda (value) (js-call r :heap_release h value)))
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0)
            (js-call assert :equal (js-call r :frame_depth h) 0))))))

  (test "Number word operations reject invalid arguments and keep original inputs and capacity transactional"
    (lambda ()
      (let* ((ctx (runtime 2 384 384)) (r (get ctx :r)) (h (get ctx :h))
             (x (number r h -0.0)) (y (number r h 3)))
        (js-call r :heap_pin h x)
        (js-call r :heap_pin h y)
        (js-call r :heap_auto h 1)
        (let ((used (js-call r :heap_used h)))
          (js-call (js-array (lambda () (js-call r :value_number_word h x 0))
                             (lambda () (js-call r :value_number_bitwise h x y 6))
                             (lambda () (js-call r :value_number_remainder h x y)))
                   :forEach
                   (lambda (run)
                     (js-call assert :equal (funcall run) 0)
                     (js-call assert :equal (js-call r :last_error) 2)
                     (js-call assert :equal (js-call r :heap_live h) 2)
                     (js-call assert :equal (js-call r :heap_used h) used)
                     (ok (Object/is (unbox r h x) -0.0))
                     (js-call assert :equal (unbox r h y) 3)))
          (js-call (js-array (js-array (lambda () (js-call r :value_number_word h x 3)) 3)
                             (js-array (lambda () (js-call r :value_number_bitwise h x y 7)) 3)
                             (js-array (lambda () (js-call r :value_number_remainder h x 0)) 1)
                             (js-array (lambda () (js-call r :value_number_word h 4294967295 0)) 1))
                   :forEach
                   (lambda (pair)
                     (js-call assert :equal (funcall (aref pair 0)) 0)
                     (js-call assert :equal (js-call r :last_error) (aref pair 1))
                     (js-call assert :equal (js-call r :heap_live h) 2)))
          (js-call r :heap_release h x)
          (js-call r :heap_release h y)
          (js-call assert :equal (js-call r :heap_collect h) 2)
          (js-call assert :equal (js-call r :value_number_word h x 0) 0)
          (js-call assert :equal (js-call r :last_error) 1)))
      (let* ((grown (runtime 16 512 65536)) (gr (get grown :r)) (gh (get grown :h))
             (a (number gr gh Number/MAX_VALUE)) (b (number gr gh 3)))
        (js-call gr :heap_pin gh a)
        (js-call gr :heap_pin gh b)
        (let ((block (js-call gr :value_bytes gh 30000)))
          (ok (> block 0))
          (let ((result (js-call gr :value_number_remainder gh a b)))
            (ok (Object/is (unbox gr gh result) (% Number/MAX_VALUE 3)))
            (ok (Object/is (unbox gr gh a) Number/MAX_VALUE)))))))

  (test "ordinary comparison rejects private frames, unfinished strings and stale values and keeps NaN non-reflexive"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (nan (number r h globalThis.NaN))
             (zero (number r h -0.0))
             (positive (number r h 0))
             (sample (+ "中" (String/fromCharCode 55296)))
             (text (managed-string r h sample))
             (same (managed-string r h sample))
             (object (js-call r :value_refs h 7 0))
             (other (js-call r :value_refs h 7 0))
             (frame (js-call r :frame_new h 0))
             (builder (js-call r :value_string h 0))
             (before (js-call r :heap_live h))
             (used (js-call r :heap_used h)))
        (js-call assert :equal (js-call r :value_compare h nan nan 0) 0)
        (js-call assert :equal (js-call r :last_error) 0)
        (js-call assert :equal (js-call r :value_compare h nan nan 1) 1)
        (js-call assert :equal (js-call r :value_compare h zero positive 0) 1)
        (js-call assert :equal (js-call r :value_compare h text same 0) 1)
        (js-call assert :equal (js-call r :value_compare h object object 0) 1)
        (js-call assert :equal (js-call r :value_compare h object other 0) 0)
        (js-call assert :equal (js-call r :value_compare h 0 0 0) 1)
        (js-call assert :equal (js-call r :value_compare h 0 3 0) 0)
        (js-call assert :equal (js-call r :value_compare h zero 0 0) 0)
        (js-call (js-array (js-array frame frame 0 3)
                           (js-array builder builder 0 6)
                           (js-array zero positive 6 3)
                           (js-array text zero 2 3)
                           (js-array 2 positive 2 3))
                 :forEach
                 (lambda (row)
                   (js-call assert :equal (js-call r :value_compare h (aref row 0) (aref row 1) (aref row 2)) 0)
                   (js-call assert :equal (js-call r :last_error) (aref row 3))))
        (js-call assert :equal (js-call r :heap_live h) before)
        (js-call assert :equal (js-call r :heap_used h) used)
        (js-call assert :equal (js-call r :heap_collections h) 0)
        (js-call r :frame_pop h frame)
        (js-call r :heap_collect h)
        (js-call assert :equal (js-call r :value_compare h object object 0) 0)
        (js-call assert :equal (js-call r :last_error) 1))))

  (test "managed heap reclaims cycles, preserves roots and rejects recycled generations"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (a (js-call r :value_refs h 7 2))
             (b (js-call r :value_refs h 8 1))
             (n (number r h -0.0)))
        (js-call assert :equal (js-call r :value_set h a 0 b) 1)
        (js-call assert :equal (js-call r :value_set h b 0 a) 1)
        (js-call assert :equal (js-call r :value_set h a 1 n) 1)
        (js-call assert :equal (js-call r :heap_pin h a) 1)
        (js-call assert :equal (js-call r :heap_collect h) 0)
        (ok (Object/is (unbox r h n) -0.0))
        (js-call assert :equal (js-call r :heap_live h) 3)
        (js-call assert :equal (js-call r :heap_release h a) 1)
        (js-call assert :equal (js-call r :heap_collect h) 3)
        (js-call assert :equal (js-call r :heap_live h) 0)
        (js-call assert :equal (js-call r :value_get h a 0) 0)
        (js-call assert :equal (js-call r :last_error) 1)
        (let ((c (js-call r :value_refs h 7 2)))
          (js-call assert :notEqual c a)
          (js-call assert :notEqual c b)
          (js-call assert :equal (js-call r :value_set h c 0 a) 0)
          (js-call assert :equal (js-call r :last_error) 1)
          (js-call assert :equal (js-call r :value_get h c 0) 0)))))

  (test "repeated full collections retain weak named identity and changed roots independently across growing heaps"
    (lambda ()
      (let* ((ctx (runtime 64 4096 131072)) (r (get ctx :r)) (h (get ctx :h))
             (other (js-call r :heap_new 64 4096 131072)))
        (ok (> other 0))
        (let ((root (js-call r :value_refs h 7 2))
              (n (number r h -0.0))
              (named (js-call r :gc_named h 77))
              (peer (js-call r :value_refs other 8 1))
              (peer-value (number r other 42))
              (buffer (js-call r :value_bytes h 30000)))
          (js-call r :value_set h root 0 root)
          (js-call r :value_set h root 1 n)
          (js-call r :heap_pin h root)
          (js-call r :heap_pin h named)
          (js-call r :value_set other peer 0 peer-value)
          (js-call r :heap_pin other peer)
          (ok (> buffer 0))
          (js-call r :heap_pin h buffer)
          (js-call r :value_byte_set h buffer 29999 197)
          (ok (> (js-call r :heap_capacity h) 4096))
          (let ((base-count (js-call r :heap_collections h))
                (peer-count (js-call r :heap_collections other))
                (cycle 0))
            (while (< cycle 64)
              (let ((garbage (number r h cycle)))
                (ok (> garbage 0))
                (js-call assert :equal (js-call r :heap_collect h) 1)
                (js-call assert :equal (js-call r :last_error) 0)
                (js-call assert :equal (js-call r :value_kind h garbage) 0)
                (js-call assert :equal (js-call r :last_error) 1)
                (js-call assert :equal (js-call r :gc_named h 77) named)
                (js-call assert :equal (js-call r :value_get h root 0) root)
                (ok (Object/is (unbox r h n) -0.0))
                (js-call assert :equal (js-call r :value_byte_get h buffer 29999) 197)
                (js-call assert :equal (js-call r :heap_collect h) 0)
                (js-call assert :equal (js-call r :gc_named h 77) named)
                (when (= (% cycle 3) 0)
                  (js-call assert :equal (js-call r :heap_collect other) 0)
                  (js-call assert :equal (js-call r :value_get other peer 0) peer-value)
                  (js-call assert :equal (unbox r other peer-value) 42)))
              (setq cycle (1+ cycle)))
            (js-call assert :equal (- (js-call r :heap_collections h) base-count) 128)
            (js-call assert :equal (- (js-call r :heap_collections other) peer-count) 22)
            (js-call assert :equal (js-call r :value_set h root 1 0) 1)
            (js-call assert :equal (js-call r :heap_collect h) 1)
            (js-call assert :equal (js-call r :value_kind h n) 0)
            (js-call assert :equal (js-call r :last_error) 1)
            (js-call assert :equal (js-call r :gc_named h 77) named)
            (js-call r :heap_release h root)
            (js-call r :heap_release h named)
            (js-call r :heap_release h buffer)
            (js-call assert :equal (js-call r :heap_collect h) 3)
            (js-call assert :equal (js-call r :heap_live h) 0)
            (let ((replacement (js-call r :gc_named h 77)))
              (ok (> replacement 0))
              (js-call assert :notEqual replacement named)
              (js-call assert :equal (js-call r :heap_collect h) 1))
            (js-call assert :equal (js-call r :value_get other peer 0) peer-value)
            (js-call r :heap_release other peer)
            (js-call assert :equal (js-call r :heap_collect other) 2)
            (js-call assert :equal (js-call r :heap_live other) 0))))))

  (test "managed slots never wrap a generation and reclaimed bytes stay bounded"
    (lambda ()
      (let* ((ctx (runtime 1 256 256)) (r (get ctx :r)) (h (get ctx :h))
             (old 0)
             (i 1))
        (while (<= i 4095)
          (let ((n (number r h i)))
            (ok (> n 0))
            (js-call assert :notEqual n old)
            (when (/= old 0)
              (js-call assert :equal (js-call r :value_kind h old) 0)
              (js-call assert :equal (js-call r :last_error) 1))
            (js-call assert :equal (js-call r :heap_collect h) 1)
            (js-call assert :equal (js-call r :heap_used h) 48)
            (setq old n))
          (setq i (1+ i)))
        (js-call assert :equal (number r h 1) 0)
        (js-call assert :equal (js-call r :last_error) 2)
        (js-call assert :equal (js-call r :heap_live h) 0)
        (js-call assert :equal (js-call r :heap_capacity h) 256))))

  (test "managed Number arithmetic and truth match IEEE including negative zero and NaN"
    (lambda ()
      (let* ((ctx (runtime 128)) (r (get ctx :r)) (h (get ctx :h))
             (values (js-array 0 -0.0 1 -1 Number/MIN_VALUE (- Number/MIN_VALUE) Number/MAX_VALUE
                               globalThis.Infinity (- globalThis.Infinity) globalThis.NaN)))
        (js-call values :forEach
          (lambda (a)
            (js-call values :forEach
              (lambda (b)
                (let ((left (number r h a))
                      (right (number r h b)))
                  (ok (and (> left 0) (> right 0)))
                  (js-call (js-array (js-array 0 (+ a b))
                                     (js-array 1 (- a b))
                                     (js-array 2 (* a b))
                                     (js-array 3 (/ a b)))
                           :forEach
                           (lambda (pair)
                             (let ((op (aref pair 0))
                                   (expected (aref pair 1))
                                   (output (js-call r :value_number_binary h left right (aref pair 0))))
                               (ok (> output 0))
                               (ok (Object/is (unbox r h output) expected)
                                   (+ (globalThis.String a) "," (globalThis.String b) "," (globalThis.String op))))))
                  (js-call assert :equal (js-call r :value_truth h left) 1)
                  (js-call assert :equal (js-call r :heap_collect h) 6))))))
        (js-call (js-array 0 1 3) :forEach (lambda (v) (js-call assert :equal (js-call r :value_truth h v) 0)))
        (js-call assert :equal (js-call r :value_truth h 2) 1)
        (let ((n (number r h 1)))
          (js-call assert :equal (js-call r :value_number_binary h n 2 0) 0)
          (js-call assert :equal (js-call r :last_error) 1)))))

  (test "managed pool growth distinguishes the linear memory limit and preserves rooted bytes after a failed reserve"
    (lambda ()
      (let ((larger (globalThis.Uint8Array.from
                      (js-call (get backend :wasm) :emit_memory_wasm memory-program (js-object :maximumPages 512)))))
        (js-call (js-array (js-array bytes false) (js-array larger t)) :forEach
          (lambda (pair)
            (let* ((artifact (aref pair 0))
                   (can-grow (aref pair 1))
                   (ctx (runtime 131072 8388608 16777216 artifact))
                   (r (get ctx :r)) (h (get ctx :h))
                   (first (js-call r :value_bytes h 4194304)))
              (ok (> first 0))
              (js-call assert :equal (js-call r :heap_pin h first) 1)
              (js-call assert :equal (js-call r :value_byte_set h first 0 17) 1)
              (js-call assert :equal (js-call r :value_byte_set h first 4194303 239) 1)
              (let* ((used (js-call r :heap_used h))
                     (second (js-call r :value_bytes h 2097152))
                     (error (js-call r :last_error)))
                (if can-grow
                    (progn
                      (ok (> second 0))
                      (js-call assert :equal error 0)
                      (js-call assert :equal (js-call r :heap_pin h second) 1)
                      (js-call assert :equal (js-call r :heap_capacity h) 16777216))
                  (progn
                    (js-call assert :equal second 0)
                    (js-call assert :equal error 2)
                    (js-call assert :equal (js-call r :heap_capacity h) 8388608)
                    (js-call assert :equal (js-call r :heap_used h) used)
                    (js-call assert :equal (js-call r :heap_live h) 1)))
                (js-call assert :equal (js-call r :value_byte_get h first 0) 17)
                (js-call assert :equal (js-call r :value_byte_get h first 4194303) 239)
                (js-call assert :equal (js-call r :heap_release h first) 1)
                (when can-grow
                  (js-call assert :equal (js-call r :heap_release h second) 1))
                (js-call assert :equal (js-call r :heap_collect h) (if can-grow 2 1))
                (js-call assert :equal (js-call r :heap_live h) 0))))))))

  (test "managed growth retains relative references and resize failures preserve data"
    (lambda ()
      (let* ((ctx (runtime 64 2048 262144)) (r (get ctx :r)) (h (get ctx :h))
             (a (js-call r :value_refs h 7 1))
             (s (js-call r :value_string h 35000))
             (i 0))
        (ok (and (> a 0) (> s 0)))
        (js-call assert :equal (js-call r :value_set h a 0 s) 1)
        (js-call assert :equal (js-call r :heap_pin h a) 1)
        (while (< i 35000)
          (js-call assert :equal (js-call r :value_unit_set h s i (bit-and i 65535)) 1)
          (setq i (1+ i)))
        (js-call assert :equal (js-call r :value_seal h s) s)
        (js-call assert :equal (js-call r :value_unit_set h s 0 42) 0)
        (js-call assert :equal (js-call r :last_error) 6)
        (js-call assert :equal (js-call r :value_refs_resize h a 64) 1)
        (js-call assert :equal (js-call r :value_get h a 0) s)
        (js-call assert :equal (js-call r :value_get h a 63) 0)
        (js-call assert :equal (js-call r :value_unit_get h s 34999) 34999)
        (js-call assert :equal (js-call r :heap_collect h) 0)
        (let ((before (js-call r :heap_used h)))
          (js-call assert :equal (js-call r :value_refs_resize h a 4294967295) 0)
          (js-call assert :equal (js-call r :last_error) 2)
          (js-call assert :equal (js-call r :value_length h a) 64)
          (js-call assert :equal (js-call r :value_get h a 0) s)
          (js-call assert :equal (js-call r :heap_used h) before)
          (js-call assert :equal (js-call r :heap_release h a) 1)
          (js-call assert :equal (js-call r :heap_collect h) 2)))))

  (test "managed free blocks coalesce and reuse without overwriting surviving objects"
    (lambda ()
      (let* ((ctx (runtime 8 1024 1024)) (r (get ctx :r)) (h (get ctx :h))
             (a (js-call r :value_bytes h 96))
             (b (js-call r :value_bytes h 96))
