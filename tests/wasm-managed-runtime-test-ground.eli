  (test "managed heap checks capacity, retirement, payload bits and invalid arguments"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h)))
        (js-call (js-array (js-array 0 4096 4096)
                           (js-array 1048576 4096 4096)
