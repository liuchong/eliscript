          (js-call assert :equal (read-managed-string r h joined) expected)
          (js-call assert :equal (read-managed-string r h left) "left")
          (js-call assert :equal (read-managed-string r h right) right-text)
          (js-call r :heap_pin h joined)
          (js-call assert :equal (js-call r :heap_collect h) 2)
          (js-call assert :equal (read-managed-string r h joined) expected)
          (js-call r :heap_release h joined)
          (js-call assert :equal (js-call r :heap_collect h) 1)
          (js-call assert :equal (js-call r :heap_live h) 0)))))

  (test "managed Number unary and comparisons preserve IEEE order and signed zero"
    (lambda ()
      (let* ((ctx (runtime 64)) (r (get ctx :r)) (h (get ctx :h)))
        (js-call (js-array 0 -0.0 1 -1 globalThis.Infinity (- globalThis.Infinity) globalThis.NaN Number/MIN_VALUE)
                 :forEach
                 (lambda (a)
                   (let* ((x (number r h a))
                          (neg (js-call r :value_number_negate h x)))
                     (ok (> neg 0))
                     (ok (Object/is (unbox r h neg) (- a)))
                     (js-call (js-array 0 -0.0 1 globalThis.Infinity globalThis.NaN) :forEach
                       (lambda (b)
                         (let ((y (number r h b)))
                           (js-call (js-array (js-array 0 (eq a b))
                                              (js-array 1 (not (eq a b)))
                                              (js-array 2 (< a b))
                                              (js-array 3 (<= a b))
                                              (js-array 4 (> a b))
                                              (js-array 5 (>= a b)))
                                    :forEach
                                    (lambda (pair)
                                      (js-call assert :equal
                                        (js-call r :value_number_compare h x y (aref pair 0))
                                        (if (aref pair 1) 1 0)))))))
                     (js-call r :heap_collect h)))))))

  (test "managed byte resize reuses reclaimed blocks and preserves contents transactionally"
    (lambda ()
      (let* ((ctx (runtime 16 1024 4096)) (r (get ctx :r)) (h (get ctx :h))
             (b (js-call r :value_bytes h 8))
