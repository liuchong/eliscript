        (setq i 0)
        (while (< i 8)
          (js-call assert :equal (js-call r :value_byte_get h b i) (1+ i))
          (setq i (1+ i)))
        (js-call assert :equal (js-call r :value_byte_get h b 1799) 0)
        (let ((used (js-call r :heap_used h)))
          (js-call assert :equal (js-call r :value_bytes_resize h b 8000) 0)
          (js-call assert :equal (js-call r :last_error) 2)
          (js-call assert :equal (js-call r :heap_used h) used))
        (js-call assert :equal (js-call r :value_bytes_resize h b 4) 1)
        (js-call assert :equal (js-call r :value_bytes_resize h b 8) 1)
        (setq i 4)
        (while (< i 8)
          (js-call assert :equal (js-call r :value_byte_get h b i) 0)
          (setq i (1+ i)))
        (js-call assert :equal (js-call r :heap_collect h) 0))))

  (test "managed bridge brands values, keeps explicit roots and bulk transfers values"
    (async ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes))
             (sample (+ "中文😀" (String/fromCharCode 55296)))
             (n (js-call a :number -0.0))
             (s (js-call a :string sample))
             (v (js-call a :array (js-array n s nil false t undefined))))
        (ok (Object/is (js-call a :readNumber n) -0.0))
        (js-call assert :equal (js-call a :readString s) sample)
        (js-call assert :equal (js-call a :truth n) t)
        (let ((r (js-call a :record (js-array v))))
          (js-call a :set v 0 r)
          (js-call a :release v)
          (js-call a :release n)
          (js-call a :release s)
          (js-call assert :equal (js-call a :collect) 1)
          (js-call assert :equal (js-call a :live) 3)
          (let ((child (js-call a :get r 0)))
            (js-call assert :equal (js-call a :length child) 6)
            (js-call assert :equal (js-call a :get child 2) nil)
            (js-call assert :throws (lambda () (js-call b :length child))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
            (js-call assert :throws (lambda () (js-call a :set child 0 0))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003")))
            (js-call assert :throws (lambda () (js-call a :array (js-object :length 2)))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003")))
            (js-call a :release child)
            (js-call a :release r)
            (js-call assert :equal (js-call a :collect) 3)
            (js-call assert :throws (lambda () (js-call a :length child))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
            (js-call assert :throws (lambda () (js-call a :release child))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003")))))
        (let ((p (js-call a :bytes (js-array 0 255))))
          (js-call a :resize p 70000)
          (js-call assert :deepEqual (js-call (js-call a :readBytes p) :slice 0 2) (new globalThis.Uint8Array (js-array 0 255))))
        (let* ((x (js-call a :number 1))
               (y (js-call a :number 0))
               (z (js-call a :binary x y 3)))
          (js-call assert :equal (js-call a :readNumber z) globalThis.Infinity)
          (js-call assert :equal (js-call a :compare x y 4) t)
          (ok (Object/is (js-call a :readNumber (js-call a :negate y)) -0.0))))))

  (test "managed graph collector matches independent reachability across randomized traces"
    (lambda ()
      (let* ((ctx (runtime 128 4096 65536)) (r (get ctx :r)) (h (get ctx :h))
             (state 7572222)
             (next-u32 (lambda ()
                         (setq state (bit-xor state (bit-shift-left state 13)))
                         (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                         (setq state (bit-xor state (bit-shift-left state 5)))
                         (uint32 state)))
             (nodes (js-array))
             (dead (js-array))
             (round 0))
        (while (< round 512)
          (let ((i 0))
            (while (< i 12)
              (let ((p (js-call r :value_refs h 7 (1+ (% (funcall next-u32) 5)))))
                (ok (> p 0))
                (let* ((edges (js-call (globalThis.Array (js-call r :value_length h p)) :fill nil))
                       (is-root (= (% (funcall next-u32) 4) 0))
                       (n (js-object :p p :edges edges :root is-root)))
                  (js-call nodes :push n)
                  (when is-root
                    (js-call assert :equal (js-call r :heap_pin h p) 1))))
              (setq i (1+ i))))
          (js-call nodes :forEach
            (lambda (n)
              (let ((edges (get n :edges))
                    (i 0))
                (while (< i (js-length edges))
                  (when (= (% (funcall next-u32) 3) 0)
                    (let ((edge (if (= (% (funcall next-u32) 4) 0)
                                    nil
                                  (aref nodes (% (funcall next-u32) (js-length nodes))))))
                      (put edges i edge)
                      (js-call assert :equal
                        (js-call r :value_set h (get n :p) i (if edge (get edge :p) (% (funcall next-u32) 4)))
                        1)))
                  (setq i (1+ i)))
                (when (and (get n :root) (= (% (funcall next-u32) 3) 0))
                  (js-call assert :equal (js-call r :heap_release h (get n :p)) 1)
                  (put n :root false)))))
          (let ((marked (new globalThis.Set))
                (queue (js-call nodes :filter (lambda (n) (get n :root)))))
            (while (> (js-length queue) 0)
              (let ((n (js-call queue :pop)))
                (unless (js-call marked :has n)
                  (js-call marked :add n)
                  (Reflect/apply (get queue :push) queue
                    (js-call (get n :edges) :filter (lambda (x) (not (nil? x))))))))
            (js-call assert :equal (js-call r :heap_collect h) (- (js-length nodes) (get marked :size)))
            (js-call assert :equal (js-call r :heap_live h) (get marked :size))
            (js-call nodes :forEach
              (lambda (n)
                (if (js-call marked :has n)
                    (let ((edges (get n :edges))
                          (i 0))
                      (js-call assert :equal (js-call r :value_kind h (get n :p)) 7)
                      (while (< i (js-length edges))
                        (when (aref edges i)
                          (js-call assert :equal (js-call r :value_get h (get n :p) i) (get (aref edges i) :p)))
                        (setq i (1+ i))))
                  (progn
                    (js-call assert :equal (js-call r :value_kind h (get n :p)) 0)
                    (js-call assert :equal (js-call r :last_error) 1)
                    (js-call dead :push (get n :p))))))
            (setq nodes (js-call nodes :filter (lambda (n) (js-call marked :has n))))
            (when (> (js-length nodes) 80)
              (js-call nodes :forEach (lambda (n) (when (get n :root) (js-call r :heap_release h (get n :p)))))
              (js-call assert :equal (js-call r :heap_collect h) (js-length nodes))
              (setq nodes (js-array)))
            (when (> (js-length dead) 0)
              (js-call assert :equal (js-call r :value_kind h (aref dead (% (funcall next-u32) (js-length dead)))) 0)
              (js-call assert :equal (js-call r :last_error) 1)))
          (setq round (1+ round))))))

  (test "managed deep cyclic graphs collect iteratively without consuming the WASM call stack"
    (lambda ()
      (let* ((ctx (runtime 12000 400000 2000000)) (r (get ctx :r)) (h (get ctx :h))
             (head 0) (last 0) (i 0))
        (while (< i 10000)
          (let ((n (js-call r :value_refs h 8 1)))
            (ok (> n 0))
            (js-call r :value_set h n 0 head)
            (setq head n)
            (when (= last 0) (setq last n)))
          (setq i (1+ i)))
        (js-call r :value_set h last 0 head)
        (js-call r :heap_pin h head)
        (js-call assert :equal (js-call r :heap_collect h) 0)
        (js-call r :heap_release h head)
        (js-call assert :equal (js-call r :heap_collect h) 10000)
        (js-call assert :equal (js-call r :heap_used h) (* 12001 24)))))

  (test "mixed word and f64 capability lowering refuses implicit conversions and retains traps"
    (lambda ()
      (let ((compile (lambda (source)
                       (globalThis.Uint8Array.from
                         (js-call (get backend :wasm) :emit_memory_wasm
                           (js-call (get backend :compiler) :compile_ir_string source "mixed-test.eli")))))
            (prefix "(import \"eliscript:memory32\" load-f64 store-f64 load-u32 store-u32 memory-grow) "))
        (js-call (js-array "(defun bad (p) (load-f64 p))"
                           "(defun bad (p) (store-f64 p 1))"
                           "(defun bad (p) (store-u32 p (load-f64 p)))"
                           "(defun bad (p) (store-f64 p (+ (load-f64 p) 1)))"
                           "(defun bad (p) (load-f64 (load-f64 p)) 0)")
                 :forEach
                 (lambda (fn)
                   (js-call assert :throws
                     (lambda () (funcall compile (+ prefix fn)))
                     (lambda (e) (and (= (get (get e :eliscriptDiagnostic) :code) "ELI-B0001")
                                      (= (get (get e :eliscriptDiagnostic) :phase) "memory-backend"))))))
        (let ((e (get (new globalThis.WebAssembly.Instance
                        (new globalThis.WebAssembly.Module
                          (funcall compile
                            (+ prefix
                               "\n (defun trap (p) (load-f64 p) 1)"
                               "\n (defun truth (p) (if (load-f64 p) 7 8))"
                               "\n (defun sequence (p) (store-f64 (progn (store-u32 p 0) p) (- (load-f64 p))) (load-u32 p))"
                               "\n (export trap truth sequence)"))))
                      :exports)))
          (js-call assert :throws (lambda () (js-call e :trap 65532)) globalThis.WebAssembly.RuntimeError)
          (js-call (js-array 0 -0.0 globalThis.NaN globalThis.Infinity Number/MIN_VALUE) :forEach
            (lambda (x)
              (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setFloat64 256 x t)
              (js-call assert :equal (js-call e :truth 256) 7)))
          (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :setFloat64 256 1.25 t)
          (js-call assert :equal (js-call e :sequence 256) 0)
          (js-call assert :equal (js-call (new globalThis.DataView (get (get e :memory) :buffer)) :getFloat64 256 t) -1.25)))))

  (test "Node independently executes managed arithmetic, cycles and repeated reclamation"
