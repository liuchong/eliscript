                (js-call (new globalThis.TextEncoder) :encode text)))
            (let ((before (js-call r :heap_live h))
                  (collections (js-call r :heap_collections h))
                  (strict (js-call r :value_utf8_encode h source 1)))
              (if (js-call surrogate-re :test text)
                  (progn
                    (js-call assert :equal strict 0)
                    (js-call assert :equal (js-call r :last_error) 5)
                    (js-call assert :equal (js-call r :heap_live h) before)
                    (js-call assert :equal (js-call r :heap_collections h) collections))
                (progn
                  (ok (> strict 0))
                  (js-call assert :deepEqual (read-managed-bytes r h strict)
                    (js-call (new globalThis.TextEncoder) :encode text)))))
            (js-call r :heap_release h source)
            (js-call r :heap_collect h))
          (let* ((input (globalThis.Uint8Array.from (js-object :length (% (funcall next-u32) 64))
                          (lambda () (bit-and (funcall next-u32) 255))))
                 (value (managed-bytes r h input)))
            (js-call r :heap_pin h value)
            (js-call (js-array 0 1) :forEach
              (lambda (preserve)
                (let ((decoded (js-call r :value_utf8_decode h value 0 preserve)))
                  (ok (> decoded 0))
                  (js-call assert :equal (read-managed-string r h decoded)
                    (js-call (new globalThis.TextDecoder "utf-8" (js-object :ignoreBOM (/= preserve 0)))
                             :decode input)))
                (let ((expected undefined))
                  (try
                    (setq expected (js-call (new globalThis.TextDecoder "utf-8" (js-object :ignoreBOM (/= preserve 0) :fatal t))
                                            :decode input))
                    (catch _e nil))
                  (let ((live (js-call r :heap_live h))
                        (collections (js-call r :heap_collections h))
                        (strict (js-call r :value_utf8_decode h value 1 preserve)))
                    (if (undefined? expected)
                        (progn
                          (js-call assert :equal strict 0)
                          (js-call assert :equal (js-call r :last_error) 4)
                          (js-call assert :equal (js-call r :heap_live h) live)
                          (js-call assert :equal (js-call r :heap_collections h) collections))
                      (progn
                        (ok (> strict 0))
                        (js-call assert :equal (read-managed-string r h strict) expected)))))))
            (js-call r :heap_release h value)
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0))
          (setq round (1+ round))))))

  (test "managed text bridge executes operations in WASM, preserves brands and transfers owned codec results"
    (async ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes))
             (_auto (js-call a :auto 1))
             (left-str (+ "a" (String/fromCharCode 0) "😀" (String/fromCharCode 55296)))
             (tail-str (+ (String/fromCharCode 56320) "z"))
             (text (js-call a :string left-str))
             (tail (js-call a :string tail-str))
             (joined (js-call a :concatStrings text tail)))
        (js-call a :release text)
        (js-call a :release tail)
        (js-call assert :equal (js-call a :readString joined) (+ left-str tail-str))
        (js-call assert :equal (js-call a :codePoint joined 2) 128512)
        (let ((sliced (js-call a :sliceString joined 3 6)))
          (js-call assert :equal (js-call a :readString sliced) (String/fromCharCode 56832 55296 56320))
          (js-call a :release sliced))
        (let ((needle (js-call a :string (String/fromCharCode 55296 56320))))
          (js-call assert :equal (js-call a :findString joined needle) 4)
          (js-call assert :equal (js-call a :findString joined needle 5) -1)
          (js-call assert :equal (js-call a :compareStrings joined needle) -1)
          (js-call a :release needle))
        (let ((encoded (js-call a :encodeUtf8 joined (js-object :strict t))))
          (js-call assert :deepEqual (js-call a :readBytes encoded)
            (js-call (new globalThis.TextEncoder) :encode (js-call a :readString joined)))
          (let ((decoded (js-call a :decodeUtf8 encoded (js-object :strict t :preserveBOM t))))
            (js-call assert :equal (js-call a :readString decoded) (js-call a :readString joined))
            (let ((invalid (js-call a :bytes (js-array 192 175))))
              (js-call assert :throws (lambda () (js-call a :decodeUtf8 invalid (js-object :strict t)))
                (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0004")))
              (js-call a :release invalid))
            (js-call assert :throws (lambda () (js-call b :sliceString joined 0 1))
              (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
            (js-call (js-array (lambda () (js-call a :sliceString joined -0.0))
                               (lambda () (js-call a :encodeUtf8 joined (js-object :strict 1)))
                               (lambda () (js-call a :decodeUtf8 encoded (js-object :preserveBOM "true"))))
                     :forEach
                     (lambda (operation)
                       (js-call assert :throws operation
                         (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003")))))
            (js-call a :release decoded)
            (js-call a :release encoded)
            (js-call a :release joined)
            (js-call a :collect)
            (js-call assert :equal (js-call a :live) 0))))))

  (test "managed text OOM and invalid encoding leave input data and temporary roots transactional"
    (lambda ()
      (js-call (js-array "slice" "encode" "decode") :forEach
        (lambda (operation)
          (let* ((ctx (runtime 2 512 512)) (r (get ctx :r)) (h (get ctx :h))
                 (text (js-call "中" :repeat 100))
                 (source (if (= operation "decode")
                             (managed-bytes r h (js-call (globalThis.Array 150) :fill 65))
                           (managed-string r h text))))
            (js-call r :heap_auto h 1)
            (let ((result (cond
                            ((= operation "slice") (js-call r :value_string_slice h source 0 100))
                            ((= operation "encode") (js-call r :value_utf8_encode h source 1))
                            (t (js-call r :value_utf8_decode h source 1 0)))))
              (js-call assert :equal result 0 operation)
              (js-call assert :equal (js-call r :last_error) 2)
              (if (= operation "decode")
                  (js-call assert :deepEqual (read-managed-bytes r h source)
                    (js-call (new globalThis.Uint8Array 150) :fill 65))
                (js-call assert :equal (read-managed-string r h source) text))
              (js-call assert :equal (js-call r :heap_live h) 1)
              (js-call assert :equal (js-call r :heap_collect h) 1)
              (js-call assert :equal (js-call r :heap_live h) 0)))))
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (bad (managed-bytes r h (js-array 255)))
             (lone (managed-string r h (String/fromCharCode 55296)))
             (used (js-call r :heap_used h))
             (live (js-call r :heap_live h)))
        (js-call assert :equal (js-call r :value_utf8_decode h bad 1 0) 0)
        (js-call assert :equal (js-call r :last_error) 4)
        (js-call assert :equal (js-call r :value_utf8_encode h lone 1) 0)
        (js-call assert :equal (js-call r :last_error) 5)
        (js-call assert :equal (js-call r :heap_used h) used)
        (js-call assert :equal (js-call r :heap_live h) live)
        (js-call assert :equal (js-call r :heap_collect h) 2))))

  (test "Node and Bun execute a whole managed text pipeline inside zero-import WASM under GC pressure"
    (async ()
      (let* ((source (+ (await (readFile (resolve "bootstrap/runtime/memory.eli") "utf8"))
                        (await (readFile (resolve "tests/fixtures/wasm-managed-text.eli") "utf8"))))
             (artifact (globalThis.Uint8Array.from
                         (js-call (get backend :wasm) :emit_memory_wasm
                           (js-call (get backend :compiler) :compile_ir_string source "text-pipeline.eli")
                           (js-object :maximumPages 8))))
             (wasm-mod (new globalThis.WebAssembly.Module artifact)))
        (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports wasm-mod) (js-array))
        (let* ((e (get (new globalThis.WebAssembly.Instance wasm-mod) :exports))
               (r (wrap-wasm-exports e))
               (h (js-call r :heap_new 24 2048 2048))
               (input-str (+ (String/fromCharCode 65279) "中😀" (String/fromCharCode 0 55296) "a"))
               (expected-str (+ (String/fromCharCode 65279) "中😀" (String/fromCharCode 0 65533) "a"))
               (input (managed-string r h input-str)))
          (js-call r :heap_auto h 1)
          (let ((output (js-call r :text_pipeline h input 1000)))
            (ok (> output 0))
            (js-call assert :equal (read-managed-string r h output) expected-str)
            (js-call assert :equal (js-call r :frame_depth h) 0)
            (ok (> (js-call r :heap_collections h) 5000))
            (js-call r :heap_release h output)
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0)))
        (let ((path (resolve directory "text-pipeline.wasm")))
          (await (writeFile path artifact))
          (let ((result (spawnSync "node" (js-array runtime-node-path "--text-pipeline" path)
                          (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get result :status) 0 (get result :stderr)))))))

  (test "managed keys use SameValueZero, exact scalar hashes and distinct immediate categories without allocation"
    (lambda ()
      (let* ((ctx (runtime 128)) (r (get ctx :r)) (h (get ctx :h))
             (sample (+ "a" (String/fromCharCode 0) "😀" (String/fromCharCode 55296)))
             (immediates (js-array nil false t undefined))
             (values (js-array nil false t undefined 0 -0.0 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                               Number/MIN_VALUE (- Number/MIN_VALUE) 1 -1 "" sample (String/fromCharCode 56320)))
             (handles (js-call values :map
                        (lambda (value)
                          (cond
                            ((= (value-type value) "number") (number r h value))
                            ((= (value-type value) "string") (managed-string r h value))
                            (t (js-call immediates :indexOf value))))))
             (used (js-call r :heap_used h))
             (live (js-call r :heap_live h))
             (collections (js-call r :heap_collections h))
             (i 0))
        (while (< i (js-length values))
          (js-call assert :equal (js-call r :value_key_hash h (aref handles i)) (hashValue (aref values i)))
          (js-call assert :equal (js-call r :last_error) 0)
          (let ((j 0))
            (while (< j (js-length values))
              (js-call assert :equal
                (js-call r :value_key_equal h (aref handles i) (aref handles j))
                (if (equalValues (aref values i) (aref values j)) 1 0))
              (setq j (1+ j))))
          (setq i (1+ i)))
        (let ((duplicate (managed-string r h sample)))
          (js-call assert :equal (js-call r :value_key_equal h (aref handles 14) duplicate) 1)
          (js-call assert :equal (js-call r :value_key_hash h (aref handles 14)) (js-call r :value_key_hash h duplicate))
          (js-call assert :equal (js-call r :heap_live h) (1+ live))
          (js-call assert :equal (js-call r :heap_collections h) collections)
          (ok (> (js-call r :heap_used h) used))
          (let ((before (js-call r :heap_used h))
                (k 0))
            (while (< k 1000)
              (js-call assert :equal (js-call r :value_key_hash h duplicate) (hashValue (aref values 14)))
              (setq k (1+ k)))
            (js-call assert :equal (js-call r :heap_used h) before))))))

  (test "managed key hashing canonicalizes every NaN payload and signed zero while arithmetic equality stays IEEE"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (zero (number r h 0))
             (minus-zero (number r h -0.0)))
        (js-call assert :equal (js-call r :value_key_hash h zero) (js-call r :value_key_hash h minus-zero))
        (js-call (js-array (js-array 1 2146435072)
                           (js-array 0 2146959360)
                           (js-array 305419896 2146509637)
                           (js-array 0 4294443008)
                           (js-array 1 4293918720))
                 :forEach
                 (lambda (words)
                   (let* ((low (aref words 0))
                          (high (aref words 1))
                          (x (js-call r :value_number h low high))
                          (y (number r h globalThis.NaN)))
                     (ok (and (> x 0) (> y 0)))
                     (js-call assert :equal (js-call r :value_key_equal h x y) 1)
                     (js-call assert :equal (js-call r :value_number_compare h x y 0) 0)
                     (js-call assert :equal (js-call r :value_key_hash h x) (hashValue globalThis.NaN))
                     (js-call assert :equal (js-call r :value_key_hash h y) (hashValue globalThis.NaN))
                     (let ((p (js-call r :value_data h x 4))
                           (view (new globalThis.DataView (get (get r :memory) :buffer))))
                       (js-call assert :equal (js-call view :getUint32 p t) low)
                       (js-call assert :equal (js-call view :getUint32 (+ p 4) t) high)))))
        (js-call assert :equal (js-call r :value_key_equal h zero minus-zero) 1)
        (js-call assert :equal (js-call r :value_number_compare h zero minus-zero 0) 1))))

  (test "managed key hashes and equality match independent JS for randomized Number bits and Unicode units"
    (lambda ()
      (let* ((ctx (runtime 16 4096 32768)) (r (get ctx :r)) (h (get ctx :h))
             (state 76763041)
             (next-u32 (lambda ()
                         (setq state (bit-xor state (bit-shift-left state 13)))
                         (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                         (setq state (bit-xor state (bit-shift-left state 5)))
                         (uint32 state)))
             (bits (new globalThis.DataView (new globalThis.ArrayBuffer 8)))
             (i 0))
        (while (< i 4096)
          (let ((low (funcall next-u32))
                (high (funcall next-u32)))
            (js-call bits :setUint32 0 low t)
            (js-call bits :setUint32 4 high t)
            (let* ((value (js-call bits :getFloat64 0 t))
                   (a (js-call r :value_number h low high))
                   (b (number r h value)))
              (ok (and (> a 0) (> b 0)))
              (js-call assert :equal (js-call r :value_key_equal h a b) 1)
              (js-call assert :equal (js-call r :value_key_hash h a) (hashValue value))
              (let ((other (number r h i)))
                (js-call assert :equal (js-call r :value_key_equal h a other) (if (equalValues value i) 1 0)))
              (let* ((text (js-call (Array/from (js-object :length (% (funcall next-u32) 64))
                                      (lambda () (String/fromCharCode (bit-and (funcall next-u32) 65535))))
                                    :join ""))
                     (x (managed-string r h text))
                     (y (managed-string r h text)))
                (js-call assert :equal (js-call r :value_key_equal h x y) 1)
                (js-call assert :equal (js-call r :value_key_hash h x) (hashValue text))
                (js-call assert :equal (js-call r :value_key_hash h y) (hashValue text))
                (js-call assert :equal (js-call r :heap_collect h) 5))))
          (setq i (1+ i))))))

  (test "managed opaque keys retain identity through mutation, growth and collection and reject invalid lifetime"
    (lambda ()
      (let* ((ctx (runtime 32 2048 1048576)) (r (get ctx :r)) (h (get ctx :h)))
        (js-call r :heap_auto h 1)
        (js-call (js-array 6 7 8) :forEach
          (lambda (kind)
            (let ((a (if (= kind 6) (js-call r :value_bytes h 8) (js-call r :value_refs h kind 1))))
              (ok (> a 0))
              (js-call r :heap_pin h a)
              (let ((b (if (= kind 6) (js-call r :value_bytes h 8) (js-call r :value_refs h kind 1))))
                (ok (> b 0))
                (js-call r :heap_pin h b)
                (let ((hash (js-call r :value_key_hash h a)))
                  (js-call assert :equal (js-call r :value_key_equal h a a) 1)
                  (js-call assert :equal (js-call r :value_key_equal h a b) 0)
                  (if (= kind 6)
                      (js-call assert :equal (js-call r :value_bytes_resize h a 70000) 1)
                    (progn
                      (js-call assert :equal (js-call r :value_set h a 0 b) 1)
                      (when (= kind 7)
                        (js-call assert :equal (js-call r :value_refs_resize h a 10000) 1))))
                  (js-call assert :equal (js-call r :value_key_hash h a) hash)
                  (js-call assert :equal (js-call r :value_key_equal h a b) 0)
                  (js-call assert :equal (js-call r :heap_collect h) 0)
                  (js-call r :heap_release h a)
                  (js-call r :heap_release h b)
                  (js-call assert :equal (js-call r :heap_collect h) 2)
                  (js-call assert :equal (js-call r :value_key_hash h a) 0)
                  (js-call assert :equal (js-call r :last_error) 1)
                  (js-call assert :equal (js-call r :value_key_equal h a a) 0)
                  (js-call assert :equal (js-call r :last_error) 1))))))
        (let ((builder (js-call r :value_string h 1)))
          (js-call r :heap_pin h builder)
          (js-call assert :equal (js-call r :value_key_hash h builder) 0)
          (js-call assert :equal (js-call r :last_error) 6)
          (js-call assert :equal (js-call r :value_key_equal h builder builder) 0)
          (js-call assert :equal (js-call r :last_error) 6)
          (let ((frame (js-call r :frame_new h 0)))
            (ok (> frame 0))
            (js-call assert :equal (js-call r :value_key_hash h frame) 0)
            (js-call assert :equal (js-call r :last_error) 3)
            (js-call assert :equal (js-call r :value_key_equal h frame frame) 0)
            (js-call assert :equal (js-call r :last_error) 3)
            (js-call r :frame_pop h frame)
            (js-call r :heap_release h builder)
            (js-call r :heap_collect h))))))

  (test "managed key bridge preserves brands and SameValueZero and performs no allocation"
    (async ()
      (let* ((a (instantiateManagedRuntime bytes))
             (b (instantiateManagedRuntime bytes))
             (_auto (js-call a :auto 1))
             (sample (+ "中😀" (String/fromCharCode 55296)))
             (x (js-call a :number -0.0))
             (y (js-call a :number 0))
             (n (js-call a :number globalThis.NaN))
             (m (js-call a :number globalThis.NaN))
             (text (js-call a :string sample))
             (copy (js-call a :string sample))
             (array (js-call a :array))
             (other (js-call a :array))
             (before (js-call a :stats)))
        (ok (js-call a :keyEqual x y))
        (ok (js-call a :keyEqual n m))
        (ok (js-call a :keyEqual text copy))
        (ok (not (js-call a :keyEqual array other)))
        (ok (js-call a :keyEqual array array))
        (js-call (js-array (js-array x -0.0)
                           (js-array y 0)
                           (js-array n globalThis.NaN)
                           (js-array text sample)
                           (js-array nil nil)
                           (js-array false false)
                           (js-array t t)
                           (js-array undefined undefined))
                 :forEach
                 (lambda (pair)
                   (js-call assert :equal (js-call a :keyHash (aref pair 0)) (hashValue (aref pair 1)))))
        (js-call assert :equal (js-call a :keyHash array) (js-call a :keyHash array))
        (js-call assert :deepEqual (js-call a :stats) before)
        (let* ((owner (js-call a :array (js-array array)))
               (alias (js-call a :get owner 0)))
          (js-call assert :notEqual array alias)
          (ok (js-call a :keyEqual array alias))
          (js-call assert :equal (js-call a :keyHash array) (js-call a :keyHash alias))
          (js-call a :release alias)
          (js-call a :release owner))
        (js-call assert :throws (lambda () (js-call b :keyHash text))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0001")))
        (js-call assert :throws (lambda () (js-call a :keyEqual 0 x))
          (lambda (e) (= (get (get e :eliscriptDiagnostic) :code) "ELI-RT0003")))
        (js-call (js-array x y n m text copy array other) :forEach (lambda (handle) (js-call a :release handle)))
        (js-call a :collect)
        (js-call assert :equal (js-call a :live) 0))))

  (test "Node and Bun execute the same whole key pipeline through repeated WASM allocation safepoints"
    (async ()
      (let* ((source (+ (await (readFile (resolve "bootstrap/runtime/memory.eli") "utf8"))
                        (await (readFile (resolve "tests/fixtures/wasm-managed-text.eli") "utf8"))))
             (artifact (globalThis.Uint8Array.from
                         (js-call (get backend :wasm) :emit_memory_wasm
                           (js-call (get backend :compiler) :compile_ir_string source "key-pipeline.eli")
                           (js-object :maximumPages 8))))
             (wasm-mod (new globalThis.WebAssembly.Module artifact)))
        (js-call assert :deepEqual (globalThis.WebAssembly.Module.imports wasm-mod) (js-array))
        (let* ((e (get (new globalThis.WebAssembly.Instance wasm-mod) :exports))
               (h (funcall (get e "heap-new") 12 768 768)))
          (funcall (get e "heap-auto") h 1)
          (let ((value (uint32 (funcall (get e "key-pressure") h 1000))))
            (ok (> value 0))
            (js-call assert :equal (uint32 (funcall (get e "value-key-hash") h value)) (hashValue globalThis.NaN))
            (js-call assert :equal (funcall (get e "frame-depth") h) 0)
            (ok (>= (funcall (get e "heap-collections") h) 2000))
            (funcall (get e "heap-release") h value)
            (funcall (get e "heap-collect") h)
            (js-call assert :equal (funcall (get e "heap-live") h) 0)))
        (let ((path (resolve directory "key-pipeline.wasm")))
          (await (writeFile path artifact))
          (let ((result (spawnSync "node" (js-array runtime-node-path "--key-pipeline" path)
                          (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get result :status) 0 (get result :stderr)))))))

  (test "Given an unfinished owned string when a static literal borrows its full payload then length kind sealing and physical bounds are checked without allocating or changing caller frames"
    (lambda ()
      (let* ((ctx (runtime 32 2048 65536)) (r (get ctx :r)) (h (get ctx :h))
             (held (number r h -0.0))
             (frame (js-call r :frame_new h 1)))
        (js-call r :frame_set h frame 0 held)
        (js-call r :heap_auto h 1)
        (let ((string (js-call r :value_string h 5)))
          (ok (> string 0))
          (js-call r :heap_pin h string)
          (let* ((before-live (js-call r :heap_live h))
                 (before-used (js-call r :heap_used h))
                 (before-collections (js-call r :heap_collections h))
                 (expected (js-call r :value_data h string 5))
                 (pointer (js-call r :value_string_initial_data h string 5)))
            (js-call assert :equal pointer expected)
            (js-call assert :equal (js-call r :last_error) 0)
            (js-call assert :equal (js-call r :heap_live h) before-live)
            (js-call assert :equal (js-call r :heap_used h) before-used)
            (js-call assert :equal (js-call r :heap_collections h) before-collections)
            (js-call assert :equal (js-call r :frame_depth h) 1)
            (let ((units (js-array 0 65279 55296 56320 57343))
                  (view (new globalThis.DataView (get (get r :memory) :buffer))))
              (js-call units :forEach
                (lambda (unit index) (js-call view :setUint16 (+ pointer (* index 2)) unit t)))
              (let ((snapshot (js-call (new globalThis.Uint8Array (get (get r :memory) :buffer) pointer 10) :slice)))
                (js-call (js-array 0 4 6 2147483648 4294967295) :forEach
                  (lambda (count)
                    (js-call assert :equal (js-call r :value_string_initial_data h string count) 0)
                    (js-call assert :equal (js-call r :last_error) 3)
                    (js-call assert :deepEqual (new globalThis.Uint8Array (get (get r :memory) :buffer) pointer 10) snapshot)))
                (let* ((header (- pointer 32))
                       (length (js-call view :getUint32 (+ header 4) t))
                       (capacity (js-call view :getUint32 (+ header 8) t)))
                  (try
                    (progn
                      (js-call view :setUint32 (+ header 4) (1+ capacity) t)
                      (js-call assert :equal (js-call r :value_string_initial_data h string (1+ capacity)) 0)
                      (js-call assert :equal (js-call r :last_error) 3)
                      (js-call view :setUint32 (+ header 4) 64 t)
                      (js-call view :setUint32 (+ header 8) 64 t)
                      (js-call assert :equal (js-call r :value_string_initial_data h string 64) 0)
                      (js-call assert :equal (js-call r :last_error) 3))
                    (finally
                      (js-call view :setUint32 (+ header 4) length t)
                      (js-call view :setUint32 (+ header 8) capacity t)))))
              (js-call assert :equal (js-call r :value_seal h string) string)
              (js-call assert :equal (read-managed-string r h string) (Reflect/apply String/fromCharCode globalThis.String units))
              (js-call assert :equal (js-call r :value_string_initial_data h string 5) 0)
              (js-call assert :equal (js-call r :last_error) 6)))
          (let ((empty (js-call r :value_string h 0)))
            (js-call r :heap_pin h empty)
            (js-call assert :equal (js-call r :value_string_initial_data h empty 0) (js-call r :value_data h empty 5))
            (js-call assert :equal (js-call r :value_seal h empty) empty)
            (js-call assert :equal (read-managed-string r h empty) "")
            (js-call (js-array 0 1 2 3 held 4294967295) :forEach
              (lambda (invalid)
                (js-call assert :equal (js-call r :value_string_initial_data h invalid 0) 0)
                (js-call assert :equal (js-call r :last_error) 1)))
            (let ((peer (js-call r :heap_new 32 2048 65536)))
              (ok (> peer 0))
              (js-call assert :equal (js-call r :value_string_initial_data peer string 5) 0)
              (js-call assert :equal (js-call r :last_error) 1))
            (js-call r :heap_release h string)
            (js-call r :heap_release h empty)
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :value_string_initial_data h string 5) 0)
            (js-call assert :equal (js-call r :last_error) 1)
            (ok (Object/is (unbox r h held) -0.0))
            (js-call assert :equal (js-call r :frame_depth h) 1)
            (js-call r :frame_pop h frame)
            (js-call r :heap_collect h)
            (js-call assert :equal (js-call r :heap_live h) 0))))))

  (test "Given exhausted literal allocation when its payload cannot be created then capacity failure retains existing roots and never exposes a writable pointer"
    (lambda ()
      (let* ((ctx (runtime 4 256 256)) (r (get ctx :r)) (h (get ctx :h))
             (held (number r h -0.0))
             (frame (js-call r :frame_new h 1)))
        (ok (> frame 0))
        (js-call r :frame_set h frame 0 held)
        (js-call r :heap_auto h 1)
        (js-call assert :equal (js-call r :value_string h 8192) 0)
        (js-call assert :equal (js-call r :last_error) 2)
        (ok (Object/is (unbox r h held) -0.0))
        (js-call assert :equal (js-call r :frame_depth h) 1)
        (js-call assert :equal (js-call r :value_string_initial_data h 0 8192) 0)
        (js-call assert :equal (js-call r :last_error) 1)
        (js-call r :frame_pop h frame)
        (js-call r :heap_collect h)
        (js-call assert :equal (js-call r :heap_live h) 0)))))
