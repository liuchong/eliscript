  (test "automatic framed Number operations preserve every IEEE edge case during collection"
    (lambda ()
      (let* ((ctx (runtime 8 512 512)) (r (get ctx :r)) (h (get ctx :h))
             (values (js-array 0 -0.0 1 -1 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
                               Number/MIN_VALUE (- Number/MIN_VALUE) Number/MAX_VALUE)))
        (js-call r :heap_auto h 1)
        (js-call values :forEach
          (lambda (x)
            (js-call values :forEach
              (lambda (y)
                (js-call (js-array (js-array 0 (+ x y))
                                   (js-array 1 (- x y))
                                   (js-array 2 (* x y))
                                   (js-array 3 (/ x y)))
                         :forEach
                         (lambda (pair)
                           (let* ((op (aref pair 0))
                                  (expected (aref pair 1))
                                  (frame (js-call r :frame_new h 3))
                                  (a (number r h x)))
                             (js-call r :frame_set h frame 0 a)
                             (let ((b (number r h y)))
                               (js-call r :frame_set h frame 1 b)
                               (let ((c (js-call r :value_number_binary h a b op)))
                                 (ok (> c 0))
                                 (js-call r :frame_set h frame 2 c)
                                 (ok (Object/is (unbox r h c) expected))
                                 (ok (Object/is (unbox r h a) x))
                                 (ok (Object/is (unbox r h b) y))
                                 (js-call r :frame_pop h frame)
                                 (js-call r :heap_collect h)))))))))))))

  (test "automatic frames match an independent random graph and nested-stack reference"
    (lambda ()
      (let* ((ctx (runtime 128 4096 32768)) (r (get ctx :r)) (h (get ctx :h))
             (_auto (js-call r :heap_auto h 1))
             (state 85652113)
             (next-u32 (lambda ()
                         (setq state (bit-xor state (bit-shift-left state 13)))
                         (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                         (setq state (bit-xor state (bit-shift-left state 5)))
                         (uint32 state)))
             (frames (js-array (js-object :p (js-call r :frame_new h 3) :slots (js-array nil nil nil))))
             (nodes (js-array))
             (inactive 0)
             (prune (lambda ()
                      (let ((marked (new globalThis.Set))
                            (queue (js-call frames :flatMap
                                     (lambda (f) (js-call (get f :slots) :filter (lambda (x) (not (nil? x))))))))
                        (while (> (js-length queue) 0)
                          (let ((n (js-call queue :pop)))
                            (unless (js-call marked :has n)
                              (js-call marked :add n)
                              (Reflect/apply (get queue :push) queue
                                (js-call (get n :edges) :filter (lambda (x) (not (nil? x))))))))
                        (let ((dead (js-call nodes :filter (lambda (n) (not (js-call marked :has n))))))
                          (setq nodes (js-call nodes :filter (lambda (n) (js-call marked :has n))))
                          dead))))
             (check-dead (lambda (dead)
                           (js-call dead :forEach
                             (lambda (n)
                               (js-call assert :equal (js-call r :value_kind h (get n :p)) 0)
                               (js-call assert :equal (js-call r :last_error) 1)))))
             (round 0))
        (while (< round 512)
          (let ((action (% (funcall next-u32) 6)))
            (cond
              ((or (= action 0) (= (js-length nodes) 0))
               (when (> (js-length nodes) 80)
                 (js-call frames :forEach
                   (lambda (f)
                     (let ((i 0))
                       (while (< i 3)
                         (js-call r :frame_set h (get f :p) i 0)
                         (put (get f :slots) i nil)
                         (setq i (1+ i)))))))
               (let* ((dead (funcall prune))
                      (count (1+ (% (funcall next-u32) 3)))
                      (p (js-call r :value_refs h 7 count)))
                 (ok (> p 0))
                 (setq inactive 0)
                 (funcall check-dead dead)
                 (js-call nodes :push (js-object :p p :edges (js-call (globalThis.Array count) :fill nil)))
                 (js-call assert :equal (js-call r :heap_live h) (+ (js-length nodes) (js-length frames)))))
              ((and (= action 1) (< (js-length frames) 8))
               (let ((dead (funcall prune))
                     (p (js-call r :frame_new h 3)))
                 (ok (> p 0))
                 (js-call frames :push (js-object :p p :slots (js-array nil nil nil)))
                 (setq inactive 0)
                 (funcall check-dead dead)
                 (js-call assert :equal (js-call r :heap_live h) (+ (js-length nodes) (js-length frames)))))
              ((and (= action 2) (> (js-length frames) 1))
               (let ((f (js-call frames :pop)))
                 (js-call assert :equal (js-call r :frame_pop h (get f :p)) 1)
                 (setq inactive (1+ inactive))
                 (js-call assert :equal (js-call r :frame_get h (get f :p) 0) 0)
                 (js-call assert :equal (js-call r :last_error) 1)))
              ((= action 3)
               (let* ((f (aref frames (% (funcall next-u32) (js-length frames))))
                      (index (% (funcall next-u32) 3))
                      (n (if (= (% (funcall next-u32) 4) 0) nil (aref nodes (% (funcall next-u32) (js-length nodes))))))
                 (js-call assert :equal (js-call r :frame_set h (get f :p) index (if n (get n :p) 0)) 1)
                 (put (get f :slots) index n)))
              ((= action 4)
               (let* ((n (aref nodes (% (funcall next-u32) (js-length nodes))))
                      (index (% (funcall next-u32) (js-length (get n :edges))))
                      (child (if (= (% (funcall next-u32) 4) 0) nil (aref nodes (% (funcall next-u32) (js-length nodes))))))
                 (js-call assert :equal (js-call r :value_set h (get n :p) index (if child (get child :p) 0)) 1)
                 (put (get n :edges) index child)))
              (t
               (let ((dead (funcall prune)))
                 (js-call assert :equal (js-call r :heap_collect h) (+ (js-length dead) inactive))
                 (setq inactive 0)
                 (funcall check-dead dead)
                 (js-call assert :equal (js-call r :heap_live h) (+ (js-length nodes) (js-length frames))))))
            (js-call assert :equal (js-call r :frame_depth h) (js-length frames))
            (js-call frames :forEach
              (lambda (f)
                (let ((i 0))
                  (while (< i 3)
                    (let ((slot (aref (get f :slots) i)))
                      (js-call assert :equal (js-call r :frame_get h (get f :p) i) (if slot (get slot :p) 0)))
                    (setq i (1+ i)))))))
          (setq round (1+ round)))
        (let ((dead-count (+ (js-length nodes) (js-length frames) inactive)))
          (js-call assert :equal (js-call r :frame_unwind h 0) 1)
          (js-call assert :equal (js-call r :heap_collect h) dead-count)
          (js-call assert :equal (js-call r :heap_live h) 0)
          (js-call assert :equal (js-call r :heap_used h) (* 129 24))))))

  (test "managed text primitives preserve UTF16 code units, lexicographic order and checked intervals"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (left-str (+ "a" (String/fromCharCode 0) "😀" (String/fromCharCode 55296)))
             (right-str (+ (String/fromCharCode 56320) "z"))
             (left (managed-string r h left-str))
             (right (managed-string r h right-str))
             (joined (js-call r :value_string_concat h left right)))
        (ok (> joined 0))
        (js-call assert :equal (read-managed-string r h joined) (+ left-str right-str))
        (let ((slice (js-call r :value_string_slice h joined 3 6)))
          (ok (> slice 0))
          (js-call assert :equal (read-managed-string r h slice) (String/fromCharCode 56832 55296 56320)))
        (js-call assert :equal (js-call r :value_string_code_point h joined 2) 128512)
        (js-call assert :equal (js-call r :value_string_code_point h left 4) 55296)
        (js-call assert :equal (js-call r :value_string_compare h left left) 0)
        (js-call assert :equal (js-call r :value_string_compare h left right) 1)
        (js-call assert :equal (js-call r :value_string_compare h right left) 2)
        (let ((empty (managed-string r h ""))
              (needle (managed-string r h (String/fromCharCode 55296 56320))))
          (js-call assert :equal (js-call r :value_string_find h joined needle 0) 4)
          (js-call assert :equal (js-call r :value_string_find h joined needle 5) 4294967295)
          (js-call assert :equal (js-call r :value_string_find h joined empty 7) 7)
          (js-call assert :equal (js-call r :value_string_find h empty needle 0) 4294967295)
          (let ((before (js-call r :heap_live h)))
            (js-call assert :equal (js-call r :value_string_slice h left 4 2) 0)
            (js-call assert :equal (js-call r :last_error) 3)
            (js-call assert :equal (js-call r :value_string_slice h left 0 6) 0)
            (js-call assert :equal (js-call r :last_error) 3)
            (js-call assert :equal (js-call r :value_string_code_point h left 5) 0)
            (js-call assert :equal (js-call r :last_error) 3)
            (js-call assert :equal (js-call r :value_string_find h left empty 6) 0)
            (js-call assert :equal (js-call r :last_error) 3)
            (js-call assert :equal (js-call r :heap_live h) before)))
        (let ((builder (js-call r :value_string h 1)))
          (js-call assert :equal (js-call r :value_string_concat h left builder) 0)
          (js-call assert :equal (js-call r :last_error) 6))
        (js-call assert :equal (js-call r :value_string_compare h left 0) 0)
        (js-call assert :equal (js-call r :last_error) 1))))

  (test "managed UTF8 codecs match replacement, strict errors, maximal subparts and BOM"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (surrogate-re (new globalThis.RegExp "\\p{Surrogate}" "u")))
        (js-call (js-array ""
                           (+ "ASCII" (String/fromCharCode 0))
                           "中文😀"
                           (+ (String/fromCharCode 65279) "x")
                           (+ (String/fromCharCode 55296) "x" (String/fromCharCode 56320))
                           (String/fromCharCode 56319 57343)
                           (String/fromCharCode 55296 55296 56320))
                 :forEach
                 (lambda (text)
                   (let* ((source (managed-string r h text))
                          (encoded (js-call r :value_utf8_encode h source 0)))
                     (ok (> encoded 0))
                     (js-call assert :deepEqual (read-managed-bytes r h encoded)
                       (js-call (new globalThis.TextEncoder) :encode text))
                     (let ((live (js-call r :heap_live h))
                           (strict (js-call r :value_utf8_encode h source 1)))
                       (if (js-call surrogate-re :test text)
                           (progn
                             (js-call assert :equal strict 0)
                             (js-call assert :equal (js-call r :last_error) 5)
                             (js-call assert :equal (js-call r :heap_live h) live))
                         (progn
                           (ok (> strict 0))
                           (js-call assert :deepEqual (read-managed-bytes r h strict)
                             (js-call (new globalThis.TextEncoder) :encode text)))))
                     (js-call r :heap_collect h))))
        (js-call (js-array (js-array)
                           (js-array 0)
                           (js-array 255)
                           (js-array 192 175)
                           (js-array 224 128 128)
                           (js-array 237 160 128)
                           (js-array 244 144 128 128)
                           (js-array 240 159)
                           (js-array 226 130 34)
                           (js-array 226 40 161)
                           (js-array 239 187 191 65)
                           (js-array 239 187 191 239 187 191)
                           (js-array 244 143 191 191))
                 :forEach
                 (lambda (input)
                   (let ((source (managed-bytes r h input)))
                     (js-call (js-array 0 1) :forEach
                       (lambda (preserve)
                         (let ((output (js-call r :value_utf8_decode h source 0 preserve)))
                           (ok (> output 0))
                           (js-call assert :equal (read-managed-string r h output)
                             (js-call (new globalThis.TextDecoder "utf-8" (js-object :ignoreBOM (/= preserve 0)))
                                      :decode (globalThis.Uint8Array.from input))))))
                     (let ((expected undefined))
                       (try
                         (setq expected (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t))
                                                 :decode (globalThis.Uint8Array.from input)))
                         (catch _e nil))
                       (let ((live (js-call r :heap_live h))
                             (strict (js-call r :value_utf8_decode h source 1 0)))
                         (if (undefined? expected)
                             (progn
                               (js-call assert :equal strict 0)
                               (js-call assert :equal (js-call r :last_error) 4)
                               (js-call assert :equal (js-call r :heap_live h) live))
                           (progn
                             (ok (> strict 0))
                             (js-call assert :equal (read-managed-string r h strict) expected)))))
                     (js-call r :heap_collect h))))
        (let ((builder (js-call r :value_string h 0)))
          (js-call assert :equal (js-call r :value_utf8_encode h builder 0) 0)
          (js-call assert :equal (js-call r :last_error) 6))
        (let ((source (managed-bytes r h (js-array 65))))
          (js-call assert :equal (js-call r :value_utf8_decode h source 2 0) 0)
          (js-call assert :equal (js-call r :last_error) 3)
          (js-call assert :equal (js-call r :value_utf8_decode h source 0 2) 0)
          (js-call assert :equal (js-call r :last_error) 3)
          (js-call assert :equal (js-call r :value_utf8_encode h source 0) 0)
          (js-call assert :equal (js-call r :last_error) 1)))))

  (test "managed text allocation protects unrooted operands during moving GC and capacity failure"
    (lambda ()
      (let* ((ctx (runtime 32 2048 1048576)) (r (get ctx :r)) (h (get ctx :h))
             (left-str (js-call "x" :repeat 20000))
             (right-str (js-call "😀" :repeat 10000))
             (left (managed-string r h left-str))
             (right (managed-string r h right-str)))
        (js-call r :heap_auto h 1)
        (let ((joined (js-call r :value_string_concat h left right)))
          (ok (> joined 0))
          (js-call assert :equal (read-managed-string r h joined) (+ left-str right-str))
          (js-call assert :equal (read-managed-string r h left) left-str)
          (js-call assert :equal (read-managed-string r h right) right-str)
          (js-call r :heap_pin h joined)
          (let ((encoded (js-call r :value_utf8_encode h joined 1)))
            (ok (> encoded 0))
            (js-call assert :deepEqual (read-managed-bytes r h encoded)
              (js-call (new globalThis.TextEncoder) :encode (read-managed-string r h joined)))
            (let ((decoded (js-call r :value_utf8_decode h encoded 1 1)))
              (ok (> decoded 0))
              (js-call assert :equal (read-managed-string r h decoded) (read-managed-string r h joined))))
          (js-call r :heap_release h joined)
          (js-call r :heap_collect h)
          (js-call assert :equal (js-call r :heap_live h) 0)))
      (let* ((tiny (runtime 2 512 512)) (tr (get tiny :r)) (th (get tiny :h))
             (sample (js-call "a" :repeat 100))
             (source (managed-string tr th sample)))
        (js-call tr :heap_auto th 1)
        (js-call assert :equal (js-call tr :value_string_concat th source source) 0)
        (js-call assert :equal (js-call tr :last_error) 2)
        (js-call assert :equal (read-managed-string tr th source) sample)
        (js-call assert :equal (js-call tr :heap_collect th) 1)
        (js-call assert :equal (js-call tr :heap_live th) 0))))

  (test "managed text search agrees exhaustively with an independent small-alphabet oracle without allocation"
    (lambda ()
      (let* ((ctx (runtime 256 32768 1048576)) (r (get ctx :r)) (h (get ctx :h))
             (texts (js-array ""))
             (len 1))
        (while (<= len 6)
          (let ((bits 0)
                (limit (Math/pow 2 len)))
            (while (< bits limit)
              (js-call texts :push
                (js-call (Array/from (js-object :length len)
                           (lambda (_v i) (if (/= (bit-and (bit-shift-right bits i) 1) 0) "b" "a")))
                         :join ""))
              (setq bits (1+ bits))))
          (setq len (1+ len)))
        (let* ((values (js-call texts :map (lambda (text) (managed-string r h text))))
               (before (js-call r :heap_used h))
               (live (js-call r :heap_live h))
               (i 0))
          (while (< i (js-length texts))
            (let ((j 0))
              (while (< j (js-length texts))
                (let ((start 0)
                      (ti (aref texts i))
                      (tj (aref texts j))
                      (vi (aref values i))
                      (vj (aref values j)))
                  (while (<= start (js-length ti))
                    (let ((result (js-call r :value_string_find h vi vj start))
                          (expected (js-call ti :indexOf tj start)))
                      (js-call assert :equal result (if (= expected -1) 4294967295 expected)
                        (+ (JSON/stringify ti) "," (JSON/stringify tj) "," (globalThis.String start)))
                      (js-call assert :equal (js-call r :last_error) 0))
                    (setq start (1+ start))))
                (setq j (1+ j))))
            (setq i (1+ i)))
          (js-call assert :equal (js-call r :heap_used h) before)
          (js-call assert :equal (js-call r :heap_live h) live)))))

  (test "managed text random Unicode slices, search, ordering and code points preserve every code unit"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (state 110362305)
             (next-u32 (lambda ()
                         (setq state (bit-xor state (bit-shift-left state 13)))
                         (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                         (setq state (bit-xor state (bit-shift-left state 5)))
                         (uint32 state)))
             (random-text (lambda ()
                            (js-call (Array/from (js-object :length (% (funcall next-u32) 64))
                                       (lambda ()
                                         (String/fromCharCode
                                           (if (/= (% (funcall next-u32) 4) 0)
                                               (bit-and (funcall next-u32) 65535)
                                             (+ 55296 (% (funcall next-u32) 2048))))))
                                     :join "")))
             (round 0))
        (while (< round 1024)
          (let* ((text (funcall random-text))
                 (needle (if (/= (% round 2) 0)
                             (funcall random-text)
                           (js-call text :slice (% (funcall next-u32) (1+ (js-length text))))))
                 (a (managed-string r h text))
                 (b (managed-string r h needle))
                 (start (% (funcall next-u32) (1+ (js-length text))))
                 (end (+ start (% (funcall next-u32) (1+ (- (js-length text) start)))))
                 (sliced (js-call r :value_string_slice h a start end)))
            (ok (> sliced 0))
            (js-call assert :equal (read-managed-string r h sliced) (js-call text :slice start end))
            (let ((joined (js-call r :value_string_concat h a b)))
              (ok (> joined 0))
              (js-call assert :equal (read-managed-string r h joined) (+ text needle)))
            (let ((found (js-call text :indexOf needle start)))
              (js-call assert :equal (js-call r :value_string_find h a b start) (if (= found -1) 4294967295 found)))
            (js-call assert :equal (js-call r :value_string_compare h a b)
              (if (= text needle) 0 (if (string-less-p text needle) 1 2)))
            (let ((index 0))
              (while (< index (js-length text))
                (js-call assert :equal (js-call r :value_string_code_point h a index) (js-call text :codePointAt index))
                (setq index (1+ index))))
            (js-call assert :equal (js-call r :heap_collect h) 4))
          (setq round (1+ round))))))

  (test "managed text search handles long periodic and nonperiodic prefixes in bounded space"
    (lambda ()
      (let* ((ctx (runtime 16 4096 1048576)) (r (get ctx :r)) (h (get ctx :h))
             (text (+ (js-call "a" :repeat 250000) "b"))
             (a (managed-string r h text)))
        (js-call (js-array (+ (js-call "a" :repeat 8192) "c")
                           (+ (js-call "a" :repeat 8192) "b")
                           (js-call "abab" :repeat 2000)
