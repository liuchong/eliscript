            (setq i (1+ i)))
          (js-call assert :equal (js-call r :value_refs h 6 1) 0)
          (js-call assert :equal (js-call r :last_error) 3)
          (js-call assert :equal (js-call r :value_byte_set h c 96 1) 0)
          (js-call assert :equal (js-call r :last_error) 3)
          (js-call assert :equal (js-call r :value_byte_set h c 0 256) 0)
          (js-call assert :equal (js-call r :last_error) 3)))))

  (test "managed root counts, reference validation and failed construction are transactional"
    (lambda ()
      (let* ((ctx (runtime 4 512 512)) (r (get ctx :r)) (h (get ctx :h))
             (a (js-call r :value_refs h 8 2)))
        (ok (> a 0))
        (js-call assert :equal (js-call r :heap_pin h a) 1)
        (js-call assert :equal (js-call r :heap_pin h a) 1)
        (js-call assert :equal (js-call r :heap_release h a) 1)
        (js-call assert :equal (js-call r :heap_collect h) 0)
        (js-call assert :equal (js-call r :heap_release h a) 1)
        (js-call assert :equal (js-call r :heap_release h a) 0)
        (js-call assert :equal (js-call r :last_error) 3)
        (js-call assert :equal (js-call r :value_set h a 2 2) 0)
        (js-call assert :equal (js-call r :last_error) 3)
        (js-call assert :equal (js-call r :value_set h a 0 4294967295) 0)
        (js-call assert :equal (js-call r :last_error) 1)
        (let ((used (js-call r :heap_used h)))
          (js-call assert :equal (js-call r :value_string h 4294967295) 0)
          (js-call assert :equal (js-call r :last_error) 2)
          (js-call assert :equal (js-call r :heap_used h) used)
          (js-call assert :equal (js-call r :heap_collect h) 1)
          (js-call assert :equal (js-call r :heap_used h) 120)))))

  (test "released then repinned roots retain cycles, duplicate pins and weak named identity across every full collection"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (root (js-call r :value_refs h 7 2))
             (leaf (number r h -0.0))
             (named (js-call r :gc_named h 312))
             (i 0))
        (js-call r :value_set h root 0 root)
        (js-call r :value_set h root 1 leaf)
        (js-call (js-array root named) :forEach
          (lambda (x)
            (js-call r :heap_pin h x)
            (js-call r :heap_release h x)
            (js-call r :heap_pin h x)
            (js-call r :heap_pin h x)
            (js-call r :heap_release h x)))
        (while (< i 32)
          (js-call assert :equal (js-call r :heap_collect h) 0)
          (js-call assert :equal (js-call r :gc_named h 312) named)
          (js-call assert :equal (js-call r :value_get h root 0) root)
          (ok (Object/is (unbox r h leaf) -0.0))
          (js-call r :heap_release h root)
          (js-call r :heap_pin h root)
          (js-call r :heap_release h named)
          (js-call r :heap_pin h named)
          (js-call r :heap_pin h leaf)
          (js-call r :heap_release h leaf)
          (js-call assert :equal (js-call r :heap_collect h) 0)
          (js-call r :heap_pin h leaf)
          (js-call r :heap_release h leaf)
          (setq i (1+ i)))
        (js-call r :heap_release h root)
        (js-call r :heap_release h named)
        (js-call assert :equal (js-call r :heap_collect h) 3)
        (js-call assert :equal (js-call r :heap_live h) 0))))

  (test "each automatic allocation performs a complete collection including newly detached children and sparse holes"
    (lambda ()
      (let* ((ctx (runtime)) (r (get ctx :r)) (h (get ctx :h))
             (root (js-call r :value_array_new h 4))
             (a (number r h 11))
             (b (number r h 22))
