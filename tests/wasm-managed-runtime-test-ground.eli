  (test "managed byte resize randomized differential keeps adjacent payloads intact"
    (lambda ()
      (let* ((ctx (runtime 64 2048 131072)) (r (get ctx :r)) (h (get ctx :h))
             (sentinel (number r h 42))
             (state 7415953)
             (next-u32 (lambda ()
                         (setq state (bit-xor state (bit-shift-left state 13)))
                         (setq state (bit-xor state (unsigned-bit-shift-right state 17)))
                         (setq state (bit-xor state (bit-shift-left state 5)))
                         (uint32 state)))
             (buffers (Array/from (js-object :length 16)
                        (lambda ()
                          (let ((p (js-call r :value_bytes h 0)))
                            (js-call r :heap_pin h p)
                            (js-object :p p :bytes (js-array))))))
             (i 0))
        (js-call r :heap_pin h sentinel)
        (while (< i 2048)
          (let* ((b (aref buffers (% (funcall next-u32) (js-length buffers))))
                 (length (% (funcall next-u32) 513))
                 (arr (get b :bytes)))
            (js-call assert :equal (js-call r :value_bytes_resize h (get b :p) length) 1)
            (put arr :length (Math/min (js-length arr) length))
            (while (< (js-length arr) length)
              (js-call arr :push 0))
            (when (> length 0)
              (let ((index (% (funcall next-u32) length))
                    (value (% (funcall next-u32) 256)))
                (js-call assert :equal (js-call r :value_byte_set h (get b :p) index value) 1)
                (put arr index value)))
            (js-call assert :equal (js-call r :value_length h (get b :p)) length)
            (let ((j 0))
              (while (< j length)
                (js-call assert :equal (js-call r :value_byte_get h (get b :p) j) (aref arr j))
                (setq j (1+ j))))
            (js-call assert :equal (js-call r :value_kind h sentinel) 4)
            (js-call assert :equal (unbox r h sentinel) 42)
            (when (= (% i 64) 0)
              (js-call assert :equal (js-call r :heap_collect h) 0)
              (js-call r :heap_release h (get b :p))
              (js-call assert :equal (js-call r :heap_collect h) 1)
              (let ((fresh (js-call r :value_bytes h 0)))
                (ok (> fresh 0))
                (js-call r :heap_pin h fresh)
                (put b :p fresh)
                (put b :bytes (js-array)))))
          (setq i (1+ i))))))

  (test "managed Number captures operands before moving growth and leaves inputs intact on OOM"
    (lambda ()
      (js-call (js-array 200 400) :forEach
        (lambda (maximum)
          (let* ((ctx (runtime 4 200 maximum)) (r (get ctx :r)) (h (get ctx :h))
                 (x (number r h 1.25))
                 (y (number r h 2.5)))
            (ok (and (> x 0) (> y 0)))
            (let ((z (js-call r :value_number_binary h x y 0)))
              (if (= maximum 200)
                  (progn
                    (js-call assert :equal z 0)
                    (js-call assert :equal (js-call r :last_error) 2)
                    (js-call assert :equal (js-call r :heap_used h) 200)
                    (js-call assert :equal (js-call r :heap_live h) 2))
                (progn
                  (ok (> z 0))
                  (js-call assert :equal (unbox r h z) 3.75)
                  (js-call assert :equal (js-call r :heap_capacity h) 400)))
              (js-call assert :equal (unbox r h x) 1.25)
              (js-call assert :equal (unbox r h y) 2.5)))))))

