(module tests.compiler-portable-predicates.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" readFile readdir mkdtemp rm mkdir writeFile)
  (import "node:path" resolve relative win32)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/build.mjs" buildBackends)
  (import "../tools/backends/managed-runtime.mjs" instantiateManagedRuntime)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defconst host-truth (js* "(value) => !!value"))
  (defconst ordinary-function (js* "function two(a, b) {}"))
  (defun object-oracle (value) (and (not (= value nil)) (= (funcall host-typeof value) "object") (not (Array/isArray value))))
  (defconst cases (js-array
    (js-array "compiler" "evaluation-object-p" (lambda (value) (object-oracle value)))
    (js-array "compiler" "evaluation-id-p" (lambda (value) (or (= value nil) (and (= (funcall host-typeof value) "string") (> (get value :length) 0)) (and (Number/isSafeInteger value) (>= value 0)))))
    (js-array "compiler" "evaluation-positive-integer-p" (lambda (value) (and (Number/isSafeInteger value) (>= value 1))))
    (js-array "ir" "non-negative-integer-p" (lambda (value) (and (Number/isSafeInteger value) (>= value 0))))
    (js-array "ir" "positive-integer-p" (lambda (value) (and (Number/isSafeInteger value) (>= value 1))))
    (js-array "project" "object-p" (lambda (value) (object-oracle value)))
    (js-array "project" "nonnegative-number-p" (lambda (value) (and (= (funcall host-typeof value) "number") (Number/isFinite value) (>= value 0))))
    (js-array "project" "boolean-p" (lambda (value) (= (funcall host-typeof value) "boolean")))
    (js-array "project" "safe-relative-path-p" (lambda (value) (and
      (= (funcall host-typeof value) "string") (> (get value :length) 0)
      (not (js-call (new globalThis.RegExp "^(?:[\\\\/]|[A-Za-z]:[\\\\/])") :test value))
      (not (js-call (js-call value :split (new globalThis.RegExp "[\\\\/]+" "u")) :includes "..")))))
    (js-array "transient-analysis" "canonical-transient-family" (lambda (value)
      (if (or (not (= (funcall host-typeof value) "string"))
        (not (js-call (new globalThis.RegExp "(^|/)(stdlib|runtime)/core/transient\\.(mjs|eli)$") :test value))) nil
        (if (js-call (new globalThis.RegExp "(^|/)runtime/core/") :test value) "runtime" "stdlib"))))
    (js-array "transient-analysis" "trusted-core-source-p" (lambda (value)
      (and (= (funcall host-typeof value) "string")
        (js-call (js-array "stdlib/core/data.eli" "stdlib/core/seq.eli" "stdlib/core/set.eli" "stdlib/core/transient.eli") :some
          (lambda (suffix) (or (= value suffix) (js-call value :endsWith (str "/" suffix))))))))))
  (defvar directory undefined) (defvar backend undefined) (defvar runtime undefined)
  (defconst units (new globalThis.Map))
  (defun flatten (nodes) (js-call nodes :flatMap (lambda (node) (if (= (get node :kind) "module-declaration") (flatten (get node :children)) (js-array node)))))
  (defun exports-node (names)
    (js-object :kind "export-declaration" :span nil :value nil :children
      (js-call names :map (lambda (value) (js-object :kind "reference" :span nil :value value :children (js-array))))))
  (defun decode-out (a out) (if (and (funcall host-truth out) (= (funcall host-typeof out) "object")) (js-call a :readString out) out))
  (defun finish (a) (js-call a :closeModule) (js-call a :collect) (js-call assert :equal (js-call a :live) 0) (js-call assert :equal (get (js-call a :stats) :frameDepth) 0))
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-portable-predicates-"))))
    (setq backend (await (buildBackends (js-object :outputRoot directory))))
    (setq runtime (js-call (get backend :compiler) :compile_ir_string (await (readFile "bootstrap/runtime/memory.eli" "utf8")) "runtime.eli"))
    (let ((index 0))
      (while (< index (get cases :length))
        (let* ((file (aref (aref cases index) 0)) (name (aref (aref cases index) 1))
               (program (js-call (get backend :compiler) :compile_ir_string (await (readFile (str "bootstrap/compiler/" file ".eli") "utf8")) (str file ".eli")))
               (declarations (flatten (get program :body)))
               (node (js-call declarations :find (lambda (node) (and (= (get node :value) name) (js-call (js-array "function-declaration" "variable-declaration") :includes (get node :kind))))))
               (dependency-names (cond
                 ((= name "safe-relative-path-p") (js-array "absolute-path-pattern" "path-separator-pattern"))
                 ((= name "canonical-transient-family") (js-array "transient-module-pattern" "runtime-core-pattern"))
                 (t (js-array))))
               (dependencies (js-call dependency-names :map (lambda (dependency)
                 (let ((declaration (js-call declarations :find (lambda (item)
                   (and (= (get item :kind) "variable-declaration") (= (get item :value) dependency))))))
                   (funcall assert declaration dependency) (globalThis/structuredClone declaration)))))
               (effectSource (str "(defun " name " (&rest ignored) nil) (defun invoke-helper (&rest args) (apply " name " args)) (defun predicate-effects (trace) (js-array (funcall "
                 name " (progn (js-call trace :push 0) undefined) (progn (js-call trace :push 1) false)) trace)) (export predicate-effects)"))
               (support (flatten (get (js-call (get backend :compiler) :compile_ir_string effectSource "predicate-effects.eli") :body)))
               (effect (js-call support :find (lambda (n) (and (= (get n :kind) "function-declaration") (= (get n :value) "predicate-effects")))))
               (adapter (js-call support :find (lambda (n) (and (= (get n :kind) "function-declaration") (= (get n :value) "invoke-helper"))))))
          (funcall assert node name)
          (let* ((unit (copyHostRecord program (js-object :body (js-call dependencies :concat (js-array (globalThis/structuredClone node) adapter effect (exports-node (js-array name "invoke-helper" "predicate-effects")))))))
                 (javascript (js-call (get backend :compiler) :emit_ir_string unit))
                 (reference (await (funcall load-module (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
            (js-call units :set name (js-object :program unit :javascript javascript :fn (get reference (js-call name :replaceAll "-" "_")) :effects (get reference :predicate_effects) :source program))))
        (setq index (1+ index))))) 120000)
  (afterAll (async () (when (funcall host-truth directory) (await (rm directory (js-object :recursive t :force t))))))
  (js-call cases :forEach (lambda (row)
    (let ((file (aref row 0)) (name (aref row 1)) (oracle (aref row 2)))
      (test (str "Given original " file " helper " name ", when compiled as an independent predicate unit, then managed WASM needs no raw JavaScript function")
        (lambda ()
          (let* ((unit (js-call units :get name)) (before (JSON/stringify (get unit :program)))
                 (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm (get unit :program) runtime)))
                 (a (instantiateManagedRuntime bytes)))
            (js-call assert :equal (JSON/stringify (get unit :program)) before)
            (js-call assert :deepEqual (js-call (get globalThis.WebAssembly :Module) :imports (new globalThis.WebAssembly.Module bytes)) (js-array))
            (js-call a :auto 1)
            (js-call (js-array undefined nil false t (js* "-0") 0 1 -1 0.5 globalThis.NaN globalThis.Infinity (- globalThis.Infinity)
              globalThis.Number.MIN_VALUE globalThis.Number.MAX_SAFE_INTEGER (+ globalThis.Number.MAX_SAFE_INTEGER 1) "" "a" "中😀" "../x" "a/../b" "a\\..\\b"
              (resolve "predicate-input") (js-call win32 :resolve "C:" "predicate-input") "stdlib/core/transient.eli" "runtime/core/transient.mjs" "x/stdlib/core/data.eli")
              :forEach (lambda (value)
                (let* ((input (cond ((= (funcall host-typeof value) "number") (js-call a :number value))
                             ((= (funcall host-typeof value) "string") (js-call a :string value)) (t value)))
                       (out (js-call a :invoke name (js-array input))))
                  (try
                    (js-call assert :deepEqual (decode-out a out) (funcall oracle value) (str name ": " (funcall globalThis.String value)))
                    (js-call assert :deepEqual (js-call unit :fn value) (funcall oracle value))
                    (finally (js-call a :release out) (js-call a :release input))))))
            (finish a)))))))
  (test "Given host objects functions prototypes brands and proxies, when compiler predicates run as JS, then the original expressions remain the independent oracle" (lambda ()
    (let* ((hooks 0) (hostile (js-object :valueOf (lambda () (setq hooks (1+ hooks)) (throw (new globalThis.Error "unexpected conversion")))
                    :toString (lambda () (setq hooks (1+ hooks)) (throw (new globalThis.Error "unexpected conversion")))))
           (revoked (Proxy/revocable (js-array) (js-object))))
      (Object/defineProperty hostile "kind" (js-object :get (lambda () (setq hooks (1+ hooks)) (throw (new globalThis.Error "unexpected brand read")))))
      (js-call revoked :revoke)
      (let ((values (js-array (js-object) (Object/create nil) (Object/create (js-object :inherited t)) (js-array)
        (new globalThis.Array 3) (Object/setPrototypeOf (js-array) nil) (js-object :kind "eliscript/keyword") hostile
        (new globalThis.Map) (new globalThis.Set) (new globalThis.Date 0) (new globalThis.RegExp "x" "u")
        (new globalThis.Number 1) (new globalThis.String "x") (new globalThis.Boolean false) (lambda () 1) ordinary-function
        (funcall globalThis.Symbol "x") (js* "1n") (new globalThis.Proxy (js-object) (js-object)) (get revoked :proxy))))
        (js-call cases :forEach (lambda (row)
          (let ((name (aref row 1)) (oracle (aref row 2)))
            (js-call values :forEach (lambda (value)
              (let ((expected undefined) (failed undefined))
                (try (setq expected (funcall oracle value)) (catch error (setq failed (get error :constructor))))
                (if (funcall host-truth failed) (js-call assert :throws (lambda () (js-call (js-call units :get name) :fn value)) failed name)
                  (js-call assert :deepEqual (js-call (js-call units :get name) :fn value) expected name)))))))))
      (js-call assert :equal hooks 0))))
  (test "Given missing explicit undefined and extra arguments, when migrated predicates are invoked, then raw-arrow argument semantics and each effect are preserved" (lambda ()
    (js-call cases :forEach (lambda (row)
      (let* ((name (aref row 1)) (oracle (aref row 2)) (unit (js-call units :get name))
             (bytes (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm (get unit :program) runtime)))
             (a (instantiateManagedRuntime bytes)))
        (js-call a :auto 1)
        (js-call assert :equal (get (get unit :fn) :length) (get oracle :length) (str "original helper arity: " name))
        (js-call assert :equal (Object/hasOwn (get unit :fn) "prototype") false (str "original arrow has no own prototype: " name))
        (js-call assert :throws (lambda () (Reflect/construct (js* "function () {}") (js-array) (get unit :fn))) globalThis.TypeError (str "original arrow is not a newTarget: " name))
        (js-call (js-array (js-array) (js-array undefined) (js-array nil) (js-array t false nil undefined) (js-array undefined t)) :forEach (lambda (args)
          (let ((out (js-call a :invoke "invoke-helper" args)))
            (try
              (js-call assert :deepEqual (decode-out a out) (apply oracle args) name)
              (js-call assert :deepEqual (Reflect/apply (get unit :fn) unit args) (apply oracle args) name)
              (finally (js-call a :release out))))))
        (let* ((count 0) (args (js-array (lambda () (setq count (1+ count)) undefined) (lambda () (setq count (1+ count)) t) (lambda () (setq count (1+ count)) false))))
          (js-call assert :deepEqual (Reflect/apply (get unit :fn) unit (js-call args :map (lambda (fn) (funcall fn)))) (funcall oracle undefined))
          (js-call assert :equal count 3))
        (finish a))))))
  (test "Given represented arrays objects inherited prototypes and functions, when zero-import predicates run under GC, then brands do not replace raw typeof" (lambda ()
    (js-call cases :forEach (lambda (row)
      (let* ((name (aref row 1)) (oracle (aref row 2)) (unit (js-call units :get name))
             (support (flatten (get (js-call (get backend :compiler) :compile_ir_string
               "(defun predicate-function () (lambda (&rest ignored) nil)) (defun predicate-object (prototype) (let ((item (js-object))) (put item :__proto__ prototype) item)) (export predicate-function predicate-object)" "predicate-support.eli") :body)))
             (input (copyHostRecord (get unit :program) (js-object :body
               (js-call (js-call (get (get unit :program) :body) :filter (lambda (n) (not (= (get n :kind) "export-declaration")))) :concat
                 (js-call support :filter (lambda (n) (not (= (get n :kind) "export-declaration"))))
                 (js-array (exports-node (js-array name "predicate-function" "predicate-object")))))))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm input runtime)))))
        (js-call a :auto 1)
        (let* ((brand (js-call a :string "eliscript/keyword")) (plain (js-call a :sourceObject (js-object))) (branded (js-call a :sourceObject (js-object :kind brand)))
               (array (js-call a :sourceArray (js-array undefined))) (fn (js-call a :invoke "predicate-function"))
               (inherited (js-call a :invoke "predicate-object" (js-array plain))) (nullPrototype (js-call a :invoke "predicate-object" (js-array nil))))
          (js-call (js-array (js-array plain (js-object)) (js-array branded (js-object :kind "eliscript/keyword")) (js-array array (js-array undefined))
            (js-array fn (lambda () nil)) (js-array inherited (Object/create (js-object))) (js-array nullPrototype (Object/create nil)))
            :forEach (lambda (pair)
              (let ((out (js-call a :invoke name (js-array (aref pair 0)))))
                (try (js-call assert :deepEqual (decode-out a out) (funcall oracle (aref pair 1)) name) (finally (js-call a :release out))))))
          (js-call (js-array brand plain branded array fn inherited nullPrototype) :forEach (lambda (value) (js-call a :release value))))
        (finish a))))))
  (test "Given effectful source arguments, when a predicate consumes its first value and ignores extras, then each argument executes exactly once in order" (lambda ()
    (js-call cases :forEach (lambda (row)
      (let* ((name (aref row 1)) (oracle (aref row 2)) (unit (js-call units :get name))
             (a (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm (get unit :program) runtime)))))
        (js-call a :auto 1)
        (let* ((trace (js-call a :sourceArray (js-array))) (out (js-call a :invoke "predicate-effects" (js-array trace)))
               (answer (js-call a :get out 0)) (log (js-call a :get out 1)))
          (js-call assert :deepEqual (decode-out a answer) (funcall oracle undefined))
          (funcall assert (js-call a :keyEqual trace log)) (js-call assert :equal (js-call a :length log) 2)
          (let ((index 0)) (while (< index 2) (let ((value (js-call a :get log index))) (js-call assert :equal (js-call a :readNumber value) index) (js-call a :release value)) (setq index (1+ index))))
          (js-call assert :deepEqual (js-call unit :effects (js-array)) (js-array (funcall oracle undefined) (js-array 0 1)))
          (js-call (js-array trace out answer log) :forEach (lambda (value) (js-call a :release value))))
        (finish a))))))
  (test "Given exact path boundaries and fixed random UTF16 names, when path and trust predicates execute, then JS and WASM preserve every original string decision" (lambda ()
    (let ((state 1094562426)
          (values (js-array "." ".." "..." "a.." "..a" "a//..//b" "a\\\\..\\b" (js-call win32 :resolve (get win32 :sep) "server" "file")
            "C:relative" (js-call win32 :resolve "c:" "absolute") (js-call win32 :resolve "Z:" "absolute") ":relative"
            "x/stdlib/core/transient.eli" "x/runtime/core/transient.mjs" "x/runtime/core/transient.elix"
            "x/stdlib/core/data.eli\n" "stdlib/core/transient.eli\r\n" "stdlib/core/transient.eli\u2028" "\ud800/stdlib/core/transient.eli" "😀/runtime/core/transient.mjs")))
      (letfn ((next () (setq state (uint32 (+ (Math/imul state 1664525) 1013904223))) state))
        (let ((index 0))
          (while (< index 256)
            (let ((text "") (j 0))
              ;; The original condition consumes a fresh PRNG value each check.
              (while (< j (% (next) 40)) (setq text (str text (String/fromCharCode (% (next) 65536))) j (1+ j)))
              (js-call values :push text (str text "/" (aref (js-array "stdlib/core/data.eli" "runtime/core/transient.mjs" ".." "stdlib/core/transient.eli") (% (next) 4)))))
            (setq index (1+ index)))))
      (js-call (js-array "safe-relative-path-p" "canonical-transient-family" "trusted-core-source-p") :forEach (lambda (name)
        (let* ((unit (js-call units :get name)) (oracle (aref (js-call cases :find (lambda (row) (= (aref row 1) name))) 2))
               (a (instantiateManagedRuntime (Uint8Array/from (js-call (get backend :managed) :emit_managed_wasm (get unit :program) runtime)))))
          (js-call a :auto 1)
          (js-call values :forEach (lambda (value)
            (let* ((input (js-call a :string value)) (out (js-call a :invoke name (js-array input))))
              (try (js-call assert :deepEqual (decode-out a out) (funcall oracle value) (str name ": " (JSON/stringify value)))
                (js-call assert :deepEqual (js-call unit :fn value) (funcall oracle value))
                (finally (js-call a :release input) (js-call a :release out))))))
          (finish a)))))))
  (test "Given all thirteen compiler sources, when public Seed and three full JS generations compile them, then the complete source artifacts reach a fixed point" (async ()
    (let* ((files (js-call (js-call (await (readdir "bootstrap/compiler")) :filter (lambda (file) (js-call file :endsWith ".eli"))) :sort))
           (compiler (get backend :compiler)) (previous (new globalThis.Map)) (seedOutput (resolve directory "public-seed")) (index 0))
      (js-call assert :equal (get files :length) 13) (await (mkdir seedOutput))
      (while (< index (get files :length))
        (let ((file (aref files index)))
          (js-call previous :set file (await (readFile (resolve directory "bootstrap" (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs")) "utf8"))))
        (setq index (1+ index)))
      (let ((index 0) (names (js-array "compiler" "ir" "project" "transient-analysis")))
        (while (< index 4)
          (let* ((name (aref names index)) (output (resolve seedOutput (str name ".mjs")))
                 (result (spawnSync (resolve "bin/eliscript-seed") (js-array "--source-map" "--output" output (resolve (str "bootstrap/compiler/" name ".eli"))) (js-object :encoding "utf8" :timeout 30000))))
            (js-call assert :equal (get result :status) 0 (get result :stderr))
            (js-call assert :equal (await (readFile output "utf8")) (js-call previous :get (str name ".eli"))))
          (setq index (1+ index))))
      (let ((generation 2))
        (while (<= generation 3)
          (let ((output (resolve directory (str "g" generation))) (index 0))
            (await (mkdir output))
            (while (< index (get files :length))
              (let* ((file (aref files index)) (path (resolve (str "bootstrap/compiler/" file))) (source (await (readFile path "utf8")))
                     (program (js-call compiler :compile_ir_string source path)) (frozen (JSON/stringify program))
                     (generated (js-call file :replace (new globalThis.RegExp "\\.eli$") ".mjs"))
                     (emitted (js-call compiler :emit_ir_string_with_source_map program source generated (relative output path)))
                     (javascript (str (get emitted :javascript) "//# sourceMappingURL=" generated ".map\n")))
                (js-call assert :equal (JSON/stringify program) frozen)
                (js-call assert :equal javascript (js-call previous :get file) (str "full generation " generation ": " file))
                (await (writeFile (resolve output generated) javascript))
                (await (writeFile (resolve output (str generated ".map")) (get emitted :sourceMap))))
              (setq index (1+ index)))
            (setq compiler (await (funcall load-module (get (pathToFileURL (resolve output "compiler.mjs")) :href)))))
          (setq generation (1+ generation)))))) 30000)
)
