(module tests.persistent-list
  (import "bun:test" expect test)
  (import "node:url" fileURLToPath)
  (import "../runtime/core/collection.mjs" :as collection)
  (import "../runtime/core/identifier.mjs" keyword)
  (import "../runtime/core/list.mjs" :as listRuntime)
  (import "../runtime/core/list.mjs" EMPTY_LIST PersistentList first isPersistentList persistentList rest)
  (import "../runtime/core/map.mjs" persistentHashMap)
  (import "../runtime/core/metadata.mjs" meta withMeta)
  (import "../runtime/core/value.mjs" equalValues hashValue)
  (import "../runtime/core/vector.mjs" PersistentVector persistentVector)
  (import "../runtime/core/sequence.mjs" :as sequence)
  (import "../runtime/testing/list.mjs" inspectPersistentList persistentListMetrics resetPersistentListMetrics sharedPersistentListNodes)
  (defconst HOST_FIXTURE (fileURLToPath (new globalThis.URL "./fixtures/persistent-list-host.mjs" (js* "import.meta.url"))))
  (defun host-type (value) (js* "typeof value"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same-values (actual expected) (js-call (expect actual) :toEqual expected))
  (defun raises (thunk expected) (js-call (expect thunk) :toThrow expected))
  (defasync runHost (command)
    (let* ((child (js-call globalThis.Bun :spawn (js-array command HOST_FIXTURE) (js-object :stdout "pipe" :stderr "pipe")))
           (parts (await (Promise/all (js-array (get child :exited)
             (js-call (new globalThis.Response (get child :stdout)) :text)
             (js-call (new globalThis.Response (get child :stderr)) :text)))))
           (exitCode (aref parts 0)) (stdout (aref parts 1)) (stderr (aref parts 2)))
      (unless (= exitCode 0)
        (let ((message (js-call stderr :trim)))
          (throw (new globalThis.Error (if (> (js-length message) 0) message (str command " exited with " exitCode))))))
      (JSON/parse stdout)))

  (defun check-sequence-brands ()
    (let* ((key (get globalThis.Symbol :hasInstance))
           (list-original (Object/getOwnPropertyDescriptor PersistentList key))
           (vector-original (Object/getOwnPropertyDescriptor PersistentVector key))
           (trace (js-array))
           (list-value (js-object :first (lambda (fallback) (js-call trace :push "first") fallback)))
           (vector-value (js-object
             :nth (lambda (index) (js-call trace :push "nth") index)
             :peek (lambda (fallback) (js-call trace :push "peek") fallback)
             :sliceVector (lambda (start end) (js-call trace :push "slice") (js-array start end)))))
      (Object/defineProperty list-value "isEmpty" (js-object
        :get (lambda () (js-call trace :push "empty") false)))
      (Object/defineProperty vector-value "count" (js-object
        :get (lambda () (js-call trace :push "count") 3)))
      (try
        (Object/defineProperty PersistentList key (js-object :configurable t
          :value (lambda (value) (js-call trace :push "list") (if (eq value list-value) (js-object) 0))))
        (Object/defineProperty PersistentVector key (js-object :configurable t
          :value (lambda (value) (js-call trace :push "vector") (eq value vector-value))))
        (be (isPersistentList list-value) t) (same-values trace (js-array "list")) (put trace :length 0)
        (be (isPersistentList vector-value) false) (same-values trace (js-array "list")) (put trace :length 0)
        (be (js-call sequence :first list-value "fallback") "fallback")
        (same-values trace (js-array "list" "empty" "first")) (put trace :length 0)
        (be (js-call sequence :first vector-value) 0)
        (same-values trace (js-array "list" "vector" "count" "nth")) (put trace :length 0)
        (be (js-call sequence :last vector-value "last") "last")
        (same-values trace (js-array "vector" "peek")) (put trace :length 0)
        (same-values (js-call sequence :takeLast 2 vector-value) (js-array 1 3))
        (same-values trace (js-array "vector" "count" "slice")) (put trace :length 0)
        (same-values (Array/from (js-call sequence :takeLast 0 vector-value)) (js-array))
        (same-values trace (js-array))
        (raises (lambda () (js-call sequence :takeLast -1 vector-value)) globalThis.TypeError)
        (same-values trace (js-array))
        (finally
          (if (undefined? list-original) (Reflect/deleteProperty PersistentList key)
            (Object/defineProperty PersistentList key list-original))
          (if (undefined? vector-original) (Reflect/deleteProperty PersistentVector key)
            (Object/defineProperty PersistentVector key vector-original))))))
  (test "persistent list preserves order and constant-time front operations" (lambda ()
    (check-sequence-brands)
    (be (js-call PersistentList :empty) EMPTY_LIST)
    (be (get EMPTY_LIST :count) 0) (be (get EMPTY_LIST :size) 0) (be (get EMPTY_LIST :isEmpty) t)
    (js-call (expect (js-call EMPTY_LIST :first)) :toBeNull)
    (be (js-call EMPTY_LIST :first "missing") "missing") (be (js-call EMPTY_LIST :rest) EMPTY_LIST)
    (be (js-call EMPTY_LIST :nth 0 "missing") "missing")
    (raises (lambda () (js-call EMPTY_LIST :nth 0)) globalThis.RangeError)
    (raises (lambda () (js-call EMPTY_LIST :pop)) globalThis.RangeError)
    (raises (lambda () (new PersistentList)) globalThis.TypeError)
    (let* ((values (persistentList "a" "b" "c")) (extended (js-call values :conj "front")) (consed (js-call values :cons "first")))
      (be (isPersistentList values) t) (be (Array/isArray values) false) (be (Object/isFrozen values) t)
      (be (get values :isEmpty) false) (same-values (js-call values :toArray) (js-array "a" "b" "c"))
      (be (js-call values :first) "a") (be (js-call values :peek) "a") (be (js-call values :nth 2) "c")
      (be (js-call values :nth 3 "missing") "missing")
      (same-values (js-call extended :toArray) (js-array "front" "a" "b" "c"))
      (be (js-call extended :rest) values) (be (js-call extended :pop) values) (be (js-call consed :rest) values)
      (be (js-call values :reduce (lambda (left right) (+ left right))) "abc")
      (be (js-call EMPTY_LIST :reduce (lambda (value) value) "initial") "initial")
      (raises (lambda () (js-call EMPTY_LIST :reduce (lambda (left right) (+ left right)))) globalThis.TypeError))))

  (test "language List operations accept only persistent Lists and nil" (lambda ()
    (let ((values (persistentList 1 2 3)))
      (be (first values) 1) (js-call (expect (first nil)) :toBeNull) (be (first nil "missing") "missing")
      (same-values (js-call (rest values) :toArray) (js-array 2 3)) (be (rest nil) EMPTY_LIST)
      (same-values (js-call (js-call listRuntime :cons 0 values) :toArray) (js-array 0 1 2 3))
      (same-values (js-call (js-call listRuntime :cons 0 nil) :toArray) (js-array 0))
      (js-call (js-array (js-array) (js-object) "text") :forEach (lambda (hostValue)
        (raises (lambda () (first hostValue)) globalThis.TypeError)
        (raises (lambda () (rest hostValue)) globalThis.TypeError)
        (raises (lambda () (js-call listRuntime :cons 0 hostValue)) globalThis.TypeError))))))

  (test "persistent list implements collection, value, and metadata protocols" (lambda ()
    (let* ((values (persistentList 1 (persistentList 2 3) (keyword "ready")))
           (equal (persistentList 1 (persistentList 2 3) (keyword "ready")))
           (metadata (persistentHashMap (js-array (keyword "line") 7))) (annotated (withMeta values metadata)) (sequence (js-call collection :seq values)))
      (be (js-call collection :count values) 3) (js-call (get (expect sequence) :not) :toBe values)
      (same-values (Array/from sequence) (js-call values :toArray))
      (be (js-call collection :reduce values (lambda (total value) (+ total (if (= (host-type value) "number") value 0))) 0) 1)
      (be (js-call (js-call collection :conj values 0) :rest) values) (be (js-call collection :empty values) EMPTY_LIST)
      (raises (lambda () (js-call collection :nth values 0)) (new globalThis.RegExp "IIndexed"))
      (be (equalValues values equal) t) (be (hashValue values) (hashValue equal))
      (be (equalValues values (Reflect/apply persistentVector undefined (Array/from values))) false)
      (be (meta annotated) metadata) (be (hashValue annotated) (hashValue values)) (be (equalValues annotated values) t)
      (be (js-call annotated :rest) (js-call values :rest)) (be (meta (js-call collection :empty annotated)) metadata)
      (be (js-call (persistentHashMap (js-array values "found")) :get equal) "found"))))

  (test "persistent list allocates one front node and shares its complete suffix" (lambda ()
    (let ((values (Reflect/apply persistentList undefined (Array/from (js-object :length 1000) (lambda (ignored index) index)))))
      (same-values (inspectPersistentList values) (js-object :count 1000 :empty false :nodeCount 1000))
      (resetPersistentListMetrics)
      (let ((extended (js-call values :conj -1)))
        (same-values (persistentListMetrics) (js-object :nodeAllocations 1))
        (be (sharedPersistentListNodes values extended) 1000) (be (js-call extended :rest) values))
      (resetPersistentListMetrics)
      (let ((annotated (withMeta values (persistentHashMap (js-array (keyword "tag") t)))))
        (same-values (persistentListMetrics) (js-object :nodeAllocations 1))
        (be (sharedPersistentListNodes values annotated) 999) (be (js-call annotated :rest) (js-call values :rest))
        (be (get (inspectPersistentList EMPTY_LIST) :nodeCount) 0)))))

  (test "persistent list traverses one million nodes without stack growth" (lambda ()
    (let ((size 1000000) (values EMPTY_LIST))
      (let ((value (1- size)))
        (while (>= value 0) (setq values (js-call values :conj value) value (1- value))))
      (be (get values :count) size) (be (js-call values :first) 0) (be (js-call values :nth (1- size)) (1- size))
      (be (js-call values :reduce (lambda (sum value) (+ sum value)) 0) 499999500000)
      (be (js-call (js-call values :conj -1) :rest) values))))

  (test "persistent list behavior and data text agree under Bun and Node" (async ()
    (let ((bunReport (await (runHost (get globalThis.process :execPath))))
          (nodeReport (await (runHost (get (get globalThis.process :env) :NODE_BINARY "node")))))
      (same-values nodeReport bunReport)
      (same-values bunReport (js-object :empty 0 :values (js-array "1" ":two" (js-array 3 4))
        :hash 2922258686 :equal t :text "^{:source \"host\"} (1 :two (3 4))" :source "host" :keyed "found")))))
)
