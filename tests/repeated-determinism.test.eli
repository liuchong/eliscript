(module tests.repeated-determinism.test
  (import "node:crypto" createHash)
  (import "node:fs" existsSync)
  (import "node:fs/promises" readFile)
  (import "node:path" resolve join)
  (import "bun:test" describe expect test)
  (import "../tools/acceptance/repeat.mjs" humanRepeatedDeterminismReport REQUIRED_ITERATIONS validateRepeatedDeterminismReport)
  (defconst ROOT (resolve (js* "import.meta.dir") ".."))
  (defconst HEX_A (js-call "a" :repeat 64))
  (defconst HEX_B (js-call "b" :repeat 64))
  (defun combinedDigest (compilerSha256 acceptanceSha256)
    (js-call (js-call (createHash "sha256") :update (JSON/stringify (js-object :acceptanceSha256 acceptanceSha256 :compilerSha256 compilerSha256))) :digest "hex"))
  (defun reportFixture (&rest __host_default_arguments_1)
    (let* ((iterations (aref __host_default_arguments_1 0)))
    (when (= iterations undefined) (setq iterations REQUIRED_ITERATIONS))
    (let* ((identitySha256 (combinedDigest HEX_A HEX_B))
           (source (js-object :commit (js-call "1" :repeat 40) :tree (js-call "2" :repeat 40)))
           (runs (Array/from (js-object :length iterations) (lambda (_ index)
             (js-object :iteration (1+ index) :source (Object/assign (js-object) source (js-object :cleanBefore t :cleanAfter t))
               :compiler (js-object :artifactCount 26 :sha256 HEX_A)
               :acceptance (js-object :criterionCount 35 :artifactCount 7 :corpusComplete t :operationalSuccess t :acceptancePass false :sha256 HEX_B)
               :identitySha256 identitySha256
               :observations (js-object :generatedAt (str "2026-09-08T00:00:" (js-call (funcall globalThis.String index) :padStart 2 "0") ".000Z") :commands (js-array)))))))
      (js-object :schemaVersion 1 :format "eliscript-repeated-determinism-run" :version 1 :generatedAt "2026-09-08T00:01:00.000Z" :source source
        :parameters (js-object :iterations iterations :requiredIterations REQUIRED_ITERATIONS)
        :identityProjection (js-object "format" "eliscript-repeated-determinism-identity" "version" 1 "excludedObservations" (js-array "acceptance.generatedAt" "acceptance.commands[].durationMs" "acceptance.commands[].outputSha256" "acceptance.commands[].summary" "compiler.temporaryDirectory"))
        :identity (js-object :sha256 identitySha256 :compilerSha256 HEX_A :acceptanceSha256 HEX_B :compilerArtifactCount 26 :acceptanceArtifactCount 7 :criterionCount 35)
        :runs runs :summary (js-object :allIdentical t :allOperational t :acceptanceQualified (= iterations REQUIRED_ITERATIONS))))))
  (describe "repeated core determinism evidence" (lambda ()
    (test "twenty identical clean runs satisfy the versioned local contract" (lambda ()
      (let ((report (reportFixture)))
        (js-call (expect (validateRepeatedDeterminismReport report)) :toEqual report)
        (js-call (expect (humanRepeatedDeterminismReport report)) :toContain "Acceptance qualified: yes"))))
    (test "short diagnostic runs cannot claim AC-07 qualification" (lambda ()
      (let ((report (reportFixture 2)))
        (js-call (expect (validateRepeatedDeterminismReport report)) :toEqual report)
        (js-call (expect (get (get report :summary) :acceptanceQualified)) :toBe false))))
    (test "identity, cleanliness, and projection drift are rejected" (lambda ()
      (let ((changedIdentity (funcall globalThis.structuredClone (reportFixture))))
        (put (aref (get changedIdentity :runs) 7) :identitySha256 (js-call "c" :repeat 64))
        (js-call (expect (lambda () (validateRepeatedDeterminismReport changedIdentity))) :toThrow "run 8 does not match the declared identity"))
      (let ((dirty (funcall globalThis.structuredClone (reportFixture))))
        (put (get (aref (get dirty :runs) 3) :source) :cleanAfter false)
        (js-call (expect (lambda () (validateRepeatedDeterminismReport dirty))) :toThrow "run 4 has invalid source identity or cleanliness"))
      (let ((changedProjection (funcall globalThis.structuredClone (reportFixture))))
        (js-call (get (get changedProjection :identityProjection) :excludedObservations) :pop)
        (js-call (expect (lambda () (validateRepeatedDeterminismReport changedProjection))) :toThrow "identity projection does not declare the exact observations"))))
    (test "retained repeated-determinism evidence verifies when present" (async ()
      (let ((reportPath (join ROOT "acceptance/runs/m13-04.json")))
        (when (existsSync reportPath)
          (let ((report (JSON/parse (await (readFile reportPath "utf8")))))
            (js-call (expect (get (get (validateRepeatedDeterminismReport report) :summary) :acceptanceQualified)) :toBe t))))))))
)
