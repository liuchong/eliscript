(module tests.compiler-matrix-original-gates-test-ground
  (import "bun:test" test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp mkdir writeFile readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../tools/backends/compiler-matrix.mjs" runOriginalCompilerGates)
  (import "../tools/backends/compiler-build.mjs" loadCompilerSources)
  (import "../tools/backends/build.mjs" loadLiteralSources)
  (import "../tools/backends/compiler-bootstrap.mjs" compilerSourceIdentity compilerDigest assertCompilerArtifactSources)
  (import "../tools/backends/compiler-corpus-managed-adapters.mjs" addOriginalManagedLibraryAdapters)
  (import "../tools/backends/compiler-corpus-managed-fixtures.mjs" addOriginalManagedFixtureAdapters)
  (import "../tools/backends/compiler-corpus-tools-artifact-adapters.mjs" addOriginalToolsArtifactPrograms)
  (import "../tools/backends/compiler-corpus-managed-cases.mjs" originalManagedSuites originalManagedCaseLocators)
  (defun assert-eq (a b &rest __host_forwarded_arguments_1)
    (let* ((label (aref __host_forwarded_arguments_1 0))) (js-call assert :equal a b label)))
  (defun same (a b &rest __host_forwarded_arguments_2)
    (let* ((label (aref __host_forwarded_arguments_2 0))) (js-call assert :deepEqual a b label)))
  (defun different (a b &rest __host_forwarded_arguments_3)
    (let* ((label (aref __host_forwarded_arguments_3 0))) (js-call assert :notEqual a b label)))
  (defun each (values action) (js-call values :forEach action))
  (defun contains (text token &rest __host_forwarded_arguments_4)
    (let* ((label (aref __host_forwarded_arguments_4 0))) (assert (js-call text :includes token) label)))
  (defasync fixture (recipe run)
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-original-gates-")))))
      (try
        (let ((paths (js-array "bootstrap/compiler" "bootstrap/backends" "bootstrap/host" "bootstrap/runtime" "evidence")) (i 0))
          (while (< i (get paths :length)) (await (mkdir (resolve directory (aref paths i)) (js-object :recursive t))) (setq i (1+ i))))
        (let ((literals (await (loadLiteralSources))) (i 0))
          (while (< i (get literals :length))
            (let* ((record (aref literals i)) (output (resolve directory (get record :filename))))
              (await (mkdir (resolve output "..") (js-object :recursive t))) (await (writeFile output (get record :source)))) (setq i (1+ i))))
        (await (writeFile (resolve directory "bootstrap/host/compiler-session.eli") "(export)"))
        (await (writeFile (resolve directory "bootstrap/runtime/memory.eli") "; unit fixture runtime\n"))
        (await (writeFile (resolve directory "Makefile") (str "test-core:\n" (js-call (js-call recipe :map (lambda (line) (str "\t@" line "\n"))) :join ""))))
        (let* ((file "original-corpus.json") (bytes (Buffer/from "{\"original\":\"unit fixture\"}\n"))
               (corpus (js-object :document (js-object :originalGateEvidence (js-object :required t :execution (js-object :provider "local" :command "make test-core" :applicationEvidence false)
                 :coverageIds (js-array "original-unit-locator"))) :originals (js-object :manifests (js-array (js-object :file file :sha256 (compilerDigest bytes)))))))
          (await (writeFile (resolve directory file) bytes))
          (await (run (js-object :sourceRoot directory :corpus corpus :sourceIdentity (compilerSourceIdentity (await (loadCompilerSources (js-object :sourceRoot directory)))) :directory (resolve directory "evidence")))))
        (finally (await (rm directory (js-object :recursive t :force t)))))))
  (defun originalFiles ()
    (let* ((sourceRoot (resolve (js* "import.meta.dir") "..")) (evidence (new globalThis.Map))
           (file (async (filename)
             (unless (js-call evidence :has filename)
               (let ((bytes (await (readFile (resolve sourceRoot filename)))))
                 (js-call evidence :set filename (js-object :file filename :sha256 (compilerDigest bytes) :bytes (get bytes :length) :content (js-call bytes :toString "base64")))))
             (js-call evidence :get filename)))
           (text (async (filename) (js-call (new globalThis.TextDecoder "utf-8" (js-object :fatal t :ignoreBOM t)) :decode (Buffer/from (get (await (file filename)) :content) "base64")))))
      (js-object :sourceRoot sourceRoot :file file :text text)))
  (defun stableFiles () (new globalThis.Set (js-call (js-array "core-modules" "transient-state" "sorted" "sequence-data" "wire") :map (lambda (name) (str "tests/fixtures/wasm-managed-" name ".eli")))))
  (defun service (readers records locators &rest __host_default_arguments_1)
    (let* ((files (aref __host_default_arguments_1 0)))
    (Object/assign (js-object :add (lambda (record) (js-call records :push record)) :locators locators :stableFiles (if (= files undefined) (stableFiles) files)) readers)))
  (defun sequenceModules (sequence)
    (each (js-array "runtime/core/transducer.mjs" "runtime/core/sequence.mjs" "runtime/core/data.mjs" "runtime/core/value-internals.mjs" "runtime/testing/value.mjs")
      (lambda (name) (assert (js-call (get sequence :modules) :some (lambda (module) (= (get module :id) (str "public/" name)))) (str name " requires its actual target export cell")))))
  (test "matrix original gate records the actual core command exit status and exact log bytes" (async ()
    (await (fixture (js-array "echo original-command-ran" "echo original-stderr >&2") (async (options)
      (let ((result (await (runOriginalCompilerGates options))))
        (assert-eq (get result :status) "passed") (assert-eq (get result :exitCode) 0) (assert-eq (get result :signal) nil)
        (same (get result :command) (js-array "make" "test-core")) (same (get result :coverageIds) (js-array "original-unit-locator"))
        (let ((files (get result :files)) (i 0))
          (while (< i (get files :length))
            (let* ((record (aref files i)) (data (await (readFile (resolve (get options :directory) (get record :path))))))
              (assert-eq (compilerDigest data) (get record :sha256)) (assert-eq (get data :length) (get record :bytes))) (setq i (1+ i))))
        (assert-eq (await (readFile (resolve (get options :directory) "original-gates.stdout.log") "utf8")) "original-command-ran\n")
        (assert-eq (await (readFile (resolve (get options :directory) "original-gates.stderr.log") "utf8")) "original-stderr\n")))))))
  (test "matrix original gate preserves command failure instead of producing acceptance" (async ()
    (await (fixture (js-array "echo failed-original-assertion >&2" "exit 7") (async (options)
      (let ((result (await (runOriginalCompilerGates options))))
        (assert-eq (get result :status) "failed") (different (get result :exitCode) 0)
        (js-call assert :match (await (readFile (resolve (get options :directory) "original-gates.stderr.log") "utf8")) (new globalThis.RegExp "failed-original-assertion"))))))))
  (test "matrix original gate rejects changed compiler sources or original manifest bytes" (async ()
    (let ((paths (js-array "bootstrap/runtime/memory.eli" "original-corpus.json")) (i 0))
      (while (< i (get paths :length))
        (let ((path (aref paths i))) (await (fixture (js-array (str "echo changed >> " path)) (async (options)
          (let ((result (await (runOriginalCompilerGates options)))) (assert-eq (get result :status) "failed")
            (assert-eq (get result (if (js-call path :endsWith ".eli") "sourceUnchanged" "manifestsUnchanged")) false))))))
        (setq i (1+ i))))))
  (test "matrix original gate refuses a different command before executing it" (async ()
    (await (fixture (js-array "echo should-not-run") (async (options)
      (put (get (get (get options :corpus) :document) :originalGateEvidence) :execution (js-object :provider "local" :command "make test-applications" :applicationEvidence false))
      (await (js-call assert :rejects (runOriginalCompilerGates options) (new globalThis.RegExp "stable core contract"))))))))
  (test "compiler producers bind complete sources including negative zero Unicode runtime and private literal modules" (lambda ()
    (let* ((sources (js-object "entry" "host/compiler-session.mjs" "modules" (js-array (js-object "id" "host/compiler-session.mjs" "filename" "bootstrap/host/compiler-session.eli" "source" "(defconst source \"\ud83d\ude00\\ud800\")\n") (js-object "id" "bootstrap/compiler.mjs" "filename" "bootstrap/compiler/compiler.eli" "source" "(defun zero () -0.0)\n")) "runtime" (js-object "filename" "bootstrap/runtime/memory.eli" "source" "(module runtime)\n") "literalSources" (js-array (js-object "id" "stdlib/private.mjs" "filename" "stdlib/private.eli" "source" "(defconst literal [1 2])\n")) "hostSources" (js-array (js-object "id" "host/provider.mjs" "filename" "host/provider.mjs" "source" "export const value=1;\n"))))
           (record (lambda (value) (js-object :id (get value :id) :filename (get value :filename) :sha256 (compilerDigest (Buffer/from (get value :source) "utf16le")))))
           (artifact (js-object :entry (get sources :entry) :sourceIdentity
             (js-object :algorithm "sha256" :encoding "utf16le" :modules (js-call (get sources :modules) :map record)
               :runtime (js-object :filename (get (get sources :runtime) :filename) :sha256 (compilerDigest (Buffer/from (get (get sources :runtime) :source) "utf16le")))
               :literalSources (js-call (get sources :literalSources) :map record) :hostSources (js-call (get sources :hostSources) :map record)))))
      (assert-eq (assertCompilerArtifactSources artifact sources) artifact)
      (each (js-array
        (lambda (value) (js-call (get (get value :sourceIdentity) :modules) :pop))
        (lambda (value) (js-call (get (get value :sourceIdentity) :modules) :push (Object/assign (js-object) (aref (get (get value :sourceIdentity) :modules) 0))))
        (lambda (value) (put (get (get value :sourceIdentity) :runtime) :sha256 (js-call "0" :repeat 64)))
        (lambda (value) (put (get value :sourceIdentity) :literalSources (js-array)))
        (lambda (value) (put (aref (get (get value :sourceIdentity) :hostSources) 0) :filename "other.mjs"))
        (lambda (value) (put (get value :sourceIdentity) :encoding "utf8"))
        (lambda (value) (put value :entry "bootstrap/compiler.mjs"))) (lambda (mutate)
          (let ((changed (globalThis.structuredClone artifact))) (mutate changed) (js-call assert :throws (lambda () (assertCompilerArtifactSources changed sources))))))
      (let ((reordered (globalThis.structuredClone artifact))) (js-call (get (get reordered :sourceIdentity) :modules) :reverse) (assert-eq (assertCompilerArtifactSources reordered sources) reordered))
      (let ((missing (globalThis.structuredClone sources))) (Reflect/deleteProperty missing "literalSources")
        (js-call assert :throws (lambda () (assertCompilerArtifactSources artifact missing)) (new globalThis.RegExp "undeclared literalSources"))))))
  (test "new managed library corpus transports complete original fixtures and original budgets into every selected target" (async ()
    (let* ((readers (originalFiles)) (sourceRoot (get readers :sourceRoot)) (file (get readers :file)) (records (js-array))
           (suites (js-array "core-modules" "transient-state" "sorted-core" "sequence-data" "wire"))
           (patterns (js-array "Given original standard module imports" "Given the complete transient state dependency graph" "Given complete original sorted and ordering source modules"
              "internal infinite, cache, close, metadata, paths, metrics and IEEE observations" "Given the identical complete wire graph"))
           (locators (js-call suites :map (lambda (name index) (js-object :id (str "original-library-" index) :file (str "tests/wasm-managed-" name ".test.mjs") :contains (aref patterns index)))))
           (files (stableFiles)))
      (js-call locators :push (js-object :id "original-public-tools" :file "tests/compiler-session-tools.test.mjs" :contains "Unicode scalar queries preserve exact source spans"))
      (await (addOriginalManagedLibraryAdapters (service readers records locators files)))
      (let ((fixtures (Array/from files)) (i 0))
        (while (< i (get fixtures :length))
          (let* ((fixture (aref fixtures i)) (cases (js-call records :filter (lambda (record) (js-call (get record :coverage) :includes (str "stable-compatibility:" fixture))))) (j 0))
            (assert (> (get cases :length) 0) (str fixture " requires actual selected-artifact execution records"))
            (same (js-call (Array/from (new globalThis.Set (js-call cases :map (lambda (record) (get (get record :execution) :hostRuntime))))) :sort) (js-array "bun" "node"))
            (while (< j (get cases :length))
              (let* ((record (aref cases j)) (execution (get record :execution)))
                (assert-eq (get execution :kind) "original-program") (assert-eq (get execution :referenceArtifact) t) (assert-eq (get execution :childProcesses) "inherit-selected-artifact")
                (assert-eq (get execution :zeroImports) (not (js-call fixture :endsWith "wire.eli")))
                (assert-eq (get (get record :expected) :oracleRequired) t) (assert (js-call (get record :modules) :some (lambda (module) (= (get module :filename) fixture))))
                (assert-eq (get (get record :original) :sourceSha256) (get (await (file (get (get record :original) :suite))) :sha256))
                (if (js-call fixture :endsWith "sequence-data.eli")
                  (progn (same (get execution :runtimeOptions) (js-object :maxSlots 1024 :initialBytes 65536 :maxBytes 16777216))
                    (same (get record :memory) (js-object :initialPages 128 :maximumPages 4096)) (assert-eq (get record :auto) 65536) (assert-eq (get execution :timeoutMs) 60000))
                  (progn (same (get execution :runtimeOptions) (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
                    (same (get record :memory) (js-object :initialPages 4 :maximumPages 1024)) (assert (js-call (js-array 1 65536) :includes (get record :auto))))))
              (setq j (1+ j))))
          (setq i (1+ i))))
      (let* ((transientRecord (js-call records :find (lambda (record) (= (get record :id) "original-managed:transient-state:node:auto-1"))))
             (wire (js-call records :find (lambda (record) (= (get record :id) "original-managed:wire:node:auto-1"))))
             (sequence (js-call records :find (lambda (record) (= (get record :id) "original-managed:sequence-data:node:auto-65536")))))
        (contains (get (get transientRecord :execution) :hostSource) "[0, 1, 31, 32, 33, 63, 64, 1023, 1024, 1055, 1056, 1057]")
        (each (js-array "index<128" "await checkNetwork(runtime)" "await checkJavaScriptNetwork()" "assert.equal(item.module,'eliscript.host')") (lambda (token) (contains (get (get wire :execution) :hostSource) token)))
        (sequenceModules sequence))
      (each (js-array "sequence" "text" "object") (lambda (family) (assert (js-call records :some (lambda (record) (= (get record :id) (str "original-managed:sequence-data-portable-" family ":node:auto-65536")))))))
      (assert (js-call records :some (lambda (record) (= (get record :id) "original-managed:sequence-data-relational-set:node:auto-65536"))))
      (let* ((tools (js-call records :filter (lambda (record) (= (get (get record :execution) :kind) "compiler-session-program"))))
             (sources (await (loadCompilerSources (js-object :sourceRoot sourceRoot)))))
        (same (js-call (js-call tools :map (lambda (record) (get (get record :execution) :hostRuntime))) :sort) (js-array "bun" "node"))
        (each tools (lambda (record)
          (assert-eq (get (get record :request) :phased) false) (assert-eq (get (get record :execution) :runtimeProfile) "compiler")
          (same (get record :modules) (get sources :modules)) (assert-eq (get record :entry) (get sources :entry))
          (assert-eq (get (js-call (get record :modules) :filter (lambda (module) (js-call (get module :filename) :startsWith "bootstrap/compiler/"))) :length) 13)
          (contains (get (get record :execution) :hostSource) "host:configuration.target") (contains (get (get record :execution) :hostSource) "const session = await open();")))))))
  (test "original managed case identities bind complete declarations original dynamic titles exact input variants and original deadlines" (lambda ()
    (let* ((file "tests/compiler-session-tools.test.mjs") (source "const fake=\"test('not a registration',()=>{})\";\nconst filenames=['first.eli','second.eli'];\nfor(const filename of filenames)test('original '+filename,()=>{const pattern=/[(){}]/;if(!pattern.test('('))throw Error('original assertion');},3_000);\ntest.skipIf(process.arch!=='arm64')('actual native original',async()=>{await Promise.resolve();},120000);\n") (locators (originalManagedCaseLocators file source)))
      (same (js-call locators :map (lambda (item) (get item :contains))) (js-array "original first.eli" "original second.eli" "actual native original"))
      (same (js-call locators :map (lambda (item) (get (get item :originalCase) :timeoutMs))) (js-array 3000 3000 120000))
      (same (js-call (js-call locators :slice 0 2) :map (lambda (item) (get (get item :originalCase) :parameters))) (js-array (js-object :filename "first.eli") (js-object :filename "second.eli")))
      (assert-eq (get (get (aref locators 0) :originalCase) :titleExpression) "'original '+filename")
      (assert-eq (get (get (get (aref locators 0) :originalCase) :span) :start) (get (get (get (aref locators 1) :originalCase) :span) :start))
      (different (get (aref locators 0) :id) (get (aref locators 1) :id))
      (each locators (lambda (locator)
        (let* ((bound (get locator :originalCase)) (span (get bound :span)) (body (js-call source :slice (get span :start) (get span :end))))
          (assert-eq (get bound :sourceSha256) (compilerDigest (Buffer/from source))) (assert-eq (get bound :sha256) (compilerDigest (Buffer/from body)))
          (assert-eq (get bound :byteStart) (Buffer/byteLength (js-call source :slice 0 (get span :start)))) (assert-eq (get bound :byteEnd) (Buffer/byteLength (js-call source :slice 0 (get span :end)))))))
      (let ((changed (originalManagedCaseLocators file (js-call source :replace "original assertion" "changed assertion"))))
        (different (get (get (aref changed 0) :originalCase) :sha256) (get (get (aref locators 0) :originalCase) :sha256)))
      (js-call assert :throws (lambda () (originalManagedCaseLocators "tests/unregistered.test.mjs" source)) (new globalThis.RegExp "unregistered"))
      (js-call assert :throws (lambda () (originalManagedCaseLocators file "test('original',()=>{},timeoutFromEnvironment);")) (new globalThis.RegExp "deadline")))))
  (test "all six registered original suites enter selected-session records by individual case identity without whole-suite exemptions" (async ()
    (let* ((readers (originalFiles)) (sourceRoot (get readers :sourceRoot)) (text (get readers :text)) (records (js-array)) (locators (js-array)) (i 0))
      (while (< i (get originalManagedSuites :length))
        (let ((suite (aref originalManagedSuites i))) (setq locators (js-call locators :concat (originalManagedCaseLocators suite (await (text suite)))))) (setq i (1+ i)))
      (let ((services (service readers records locators)))
        (same (await (addOriginalManagedLibraryAdapters services)) (js-array) "per-case mapping does not declare its original suite exhausted")
        (await (addOriginalToolsArtifactPrograms services)))
      (each locators (lambda (locator)
        (let ((plans (js-call records :filter (lambda (record) (js-call (get record :coverage) :includes (get locator :id))))))
          (assert (> (get plans :length) 0) (str "actual original case requires selected execution: " (get locator :contains)))
          (each plans (lambda (record)
            (let ((parameters (get (get locator :originalCase) :parameters)))
              (different (get record :kind) "original-suite") (assert-eq (get (get record :expected) :oracleRequired) (if (= (get record :kind) "sequence") undefined t))
              (assert-eq (get (get record :original) :sourceSha256) (get (get locator :originalCase) :sourceSha256))
              (when (get parameters :engine) (assert-eq (get (get record :execution) :hostRuntime) (get parameters :engine)))
              (unless (= (get parameters :auto) undefined) (assert-eq (get record :auto) (get parameters :auto)))
              (unless (= (get (get locator :originalCase) :auto) undefined) (assert-eq (get record :auto) (get (get locator :originalCase) :auto)))
              (when (get parameters :name) (contains (get record :id) (str "sequence-data-host-" (get parameters :name) ":")))
              (when (get parameters :family) (contains (get record :id) (str "sequence-data-portable-" (get parameters :family) ":")))))))))
      (each (js-call locators :filter (lambda (item) (= (get item :file) "tests/compiler-session-tools.test.mjs"))) (lambda (locator)
        (each (js-array "node" "bun") (lambda (host) (assert (js-call records :some (lambda (record) (and (js-call (get record :coverage) :includes (get locator :id)) (= (get (get record :execution) :hostRuntime) host))))
          (str (get locator :contains) " requires its actual " host " host"))))))
      (let ((wire (js-call records :filter (lambda (record) (js-call (get record :id) :startsWith "original-managed:wire-original-host:")))))
        (assert (> (get wire :length) 0)) (each wire (lambda (record) (contains (get (get record :execution) :hostSource) "wire.codec_report().validation.valid")))))))
  (test "original managed fixture recipes execute selected products and retain complete raw suites through the actual original Bun runner" (async ()
    (let* ((readers (originalFiles)) (sourceRoot (get readers :sourceRoot)) (file (get readers :file)) (records (js-array))
           (contract (JSON/parse (await (readFile (resolve sourceRoot "contracts/stable-compatibility-corpus.json") "utf8"))))
           (locators (js-array (js-object "id" "original-math-deadline" "file" "tests/wasm-managed-math.test.mjs" "contains" "Given precise finite cancellation and observable iterators") (js-object "id" "original-arithmetic-raw" "file" "tests/wasm-managed-arithmetic.test.mjs" "contains" "increment and decrement retain mixed primitive conversion") (js-object "id" "original-function-reflection" "file" "tests/wasm-managed-function-properties.test.mjs" "contains" "reflection-snapshot") (js-object "id" "original-runtime-function-reflection" "file" "tests/wasm-managed-function-properties-runtime.test.mjs" "contains" "function"))))
      (same (await (addOriginalManagedFixtureAdapters (service readers records locators (new globalThis.Set (get contract :fixtureFiles))))) (js-array))
      (let ((families (js-array "arithmetic" "word" "array-callbacks" "arrays" "array-construction" "array-search" "array-text" "builtins" "callables" "catch-destructuring" "control" "empty-bindings" "exceptions" "function-properties" "json" "math" "module-bindings" "number-conversion" "object-properties" "objects" "primitive-operators" "regexp" "replacement" "source-collections" "strings" "symbols" "typeof" "variadic-calls" "js-cons")) (i 0))
        (while (< i (get families :length))
          (let* ((family (aref families i)) (fixture (str "tests/fixtures/wasm-managed-" family ".eli")) (hosts (js-array "node" "bun")) (j 0))
            (when (js-call (get contract :fixtureFiles) :includes fixture)
              (while (< j (get hosts :length))
                (let* ((host (aref hosts j)) (record (js-call records :find (lambda (item) (= (get item :id) (str "original-managed-fixture:" family ":" host))))) (execution (get record :execution)))
                  (assert record (str fixture " has a real " host " selected-product observer"))
                  (assert-eq (get execution :hostRuntime) host) (assert (js-call (get record :coverage) :includes (str "stable-compatibility:" fixture)))
                  (assert-eq (get execution :kind) "original-program") (assert-eq (get execution :referenceArtifact) t)
                  (each (js-array "const expected=observe(oracle),actual=observe(m)" "runtime.stats().frameDepth" "runtime.live(),0") (lambda (token) (contains (get execution :hostSource) token)))
                  (assert (js-call (get record :modules) :some (lambda (module) (= (get module :filename) fixture))))
                  (assert-eq (get (get record :original) :sourceSha256) (get (await (file (get (get record :original) :suite))) :sha256)))
                (setq j (1+ j)))))
          (setq i (1+ i))))
      (let* ((sources (await (loadCompilerSources (js-object :sourceRoot sourceRoot))))
             (record (js-call records :find (lambda (item) (= (get item :id) "original-managed-suite:complete-fixture-suites"))))
             (transport (get (get record :execution) :hostSource)) (i 0))
        (while (< i (get locators :length))
          (let ((locator (aref locators i)))
            (assert record) (assert (js-call (get record :coverage) :includes (get locator :id)))
            (same (get record :modules) (get sources :modules)) (same (get (get record :request) :literalSources) (get sources :literalSources))
            (same (get (get record :request) :entries) (js-call (get sources :modules) :map (lambda (module) (get module :id))))
            (assert-eq (get (get record :request) :phased) t) (assert-eq (get record :entry) (get sources :entry))
            (assert-eq (get (get record :execution) :hostRuntime) "bun") (assert-eq (get (get record :original) :testSource) "unmodified")
            (assert-eq (get (js-call (get (get record :original) :suites) :find (lambda (item) (= (get item :file) (get locator :file)))) :sourceSha256) (get (await (file (get locator :file))) :sha256))
            (each (js-array (js-array "args\\s*[.]\\s*push\\s*\\(\\s*['\"]--preload['\"]\\s*,\\s*plugin\\s*,\\s*['\"]test['\"]\\s*,\\s*suite\\s*,?\\s*\\)" "the actual Bun runner must receive its selected namespace preload and the original suite") (js-array "spawn\\s*\\(\\s*process[.]env[.]BUN\\s*\\?\\?\\s*['\"]bun['\"]\\s*,\\s*args\\s*," "the original suite must execute in a real isolated Bun process") (js-array "suite\\s*=\\s*resolve\\s*\\(\\s*sourceRoot\\s*,\\s*relativeSuite\\s*,?\\s*\\)" "the runner must load the original suite path") (js-array "assert[.]equal\\s*\\(\\s*result[.]code\\s*,\\s*0\\s*,\\s*['\"]the complete original suite must pass with the actual selected compiler product['\"]\\s*,?\\s*\\)" "a failed original suite must fail its matrix record") (js-array "originalSelectedFrontendBuild\\s*\\(\\s*\\{\\s*[.]{3}options\\s*,\\s*frontend\\s*:\\s*options[.]frontend\\s*\\?\\?\\s*actual[.]compiler\\s*,?\\s*\\}\\s*\\)" "explicit frontend and Seed rebuilds must retain the actual selected frontend") (js-array "assert[.]deepEqual\\s*\\(\\s*interception[.]modules\\s*,\\s*moduleIds\\s*," "the child must verify every selected compiler module identity") (js-array "process[.]removeListener\\s*\\(\\s*['\"]SIGTERM['\"]\\s*,\\s*terminate\\s*,?\\s*\\)" "the completed child must remove its cancellation listener")) (lambda (row) (js-call assert :match transport (new globalThis.RegExp (aref row 0)) (aref row 1)))))
          (setq i (1+ i)))
        (let ((names (js-array "wasm-managed-builtins" "wasm-managed-typeof" "wasm-managed-project-linking" "direct-wasm-backend" "wasm-managed-function-properties-runtime")) (j 0))
          (while (< j (get names :length))
            (let* ((filename (str "tests/" (aref names j) ".test.mjs")) (suite (js-call (get (get record :original) :suites) :find (lambda (item) (= (get item :file) filename)))))
              (assert suite (str filename " must enter unchanged original-suite replay")) (assert-eq (get suite :sourceSha256) (get (await (file filename)) :sha256)))
            (setq j (1+ j)))))
      (let ((project (js-call records :find (lambda (item) (= (get item :id) "original-managed-fixture:project-entry:node")))))
        (each (js-array "entry" "state") (lambda (name)
          (let ((filename (str "tests/fixtures/wasm-managed-project-" name ".eli")))
            (assert (js-call (get project :modules) :some (lambda (module) (= (get module :filename) filename))))
            (assert (js-call (get project :coverage) :includes (str "stable-compatibility:" filename)))))))
      (let ((vector (js-call records :find (lambda (item) (= (get item :id) "original-managed-fixture:persistent-vector-auto-65536:node")))))
        (assert (js-call (get vector :modules) :some (lambda (module) (= (get module :filename) "stdlib/persistent-vector.eli"))))
        (same (get (get vector :execution) :runtimeOptions) (js-object :maxSlots 8192 :initialBytes 262144 :maxBytes 16777216))
        (same (get vector :memory) (js-object :initialPages 4 :maximumPages 1024))
        (contains (get (get vector :execution) :hostSource) "[0,1,31,32,33,63,64,65,1023,1024,1025,1056,1057]")))))
)
