(module tests.org-vite-plugin.test
  (import "bun:test" expect test)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath)
  (import "../tools/org/vite-plugin.mjs" compileOrgDirectory eliscriptOrg orgModuleId)
  (defconst projectDirectory (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst contentDirectory (resolve projectDirectory "examples/org-site/content"))
  (test "Org Vite adapter emits deterministic published content" (async ()
    (let ((first (await (compileOrgDirectory contentDirectory))) (second (await (compileOrgDirectory contentDirectory))))
      (js-call (expect first) :toBe second)
      (js-call (expect first) :toContain "Emacs is the compiler host")
      (js-call (expect first) :toContain "emacs-compiler-host-section-1")
      (js-call (expect first) :toContain "A Lisp-shaped publishing pipeline")
      (js-call (get (expect first) :not) :toContain "An unpublished note"))))
  (test "Org Vite adapter resolves, watches, and reloads its virtual module" (async ()
    (let* ((plugin (eliscriptOrg (js-object :contentDirectory contentDirectory))) (watchedFiles (js-array))
           (observer (js-object :addWatchFile (lambda (file) (js-call watchedFiles :push file)))))
      (await (Reflect/apply (get plugin :buildStart) observer (js-array)))
      (let* ((resolvedId (js-call plugin :resolveId orgModuleId))
             (code (await (Reflect/apply (get plugin :load) observer (js-array resolvedId))))
             (virtualModule (js-object :id resolvedId)) (invalidatedModule undefined)
             (hotModules (js-call plugin :handleHotUpdate (js-object :file (resolve contentDirectory "compiler-host.org")
               :server (js-object :moduleGraph (js-object :getModuleById (lambda (id) (if (= id resolvedId) virtualModule undefined))
                 :invalidateModule (lambda (module) (setq invalidatedModule module))))))))
        (js-call (expect resolvedId) :toBe (str "\0" orgModuleId))
        (js-call (expect code) :toContain "export default articles")
        (js-call (expect watchedFiles) :toContain contentDirectory)
        (js-call (expect watchedFiles) :toContain (resolve contentDirectory "compiler-host.org"))
        (js-call (expect invalidatedModule) :toBe virtualModule)
        (js-call (expect hotModules) :toEqual (js-array virtualModule))
        (js-call (expect (js-call plugin :handleHotUpdate (js-object :file (resolve projectDirectory "README.md") :server (js-object)))) :toBeUndefined)))))
  (test "Org Vite adapter requires a content directory" (lambda () (js-call (expect (lambda () (eliscriptOrg))) :toThrow "requires contentDirectory")))
)
