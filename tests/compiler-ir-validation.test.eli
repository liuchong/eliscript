(module tests.compiler-ir-validation.test
  (import "bun:test" beforeAll afterAll test)
  (import "node:assert/strict" :default assert)
  (import "node:fs/promises" mkdtemp readFile rm)
  (import "node:path" resolve)
  (import "node:os" tmpdir)
  (import "node:url" pathToFileURL)
  (import "node:child_process" spawnSync)
  (import "../tools/backends/compiler-host-record.mjs" copyHostRecord)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst host-typeof (js* "(value) => typeof value"))
  (defvar directory undefined) (defvar ir undefined) (defvar compiler undefined)
  (beforeAll (async ()
    (setq directory (await (mkdtemp (resolve (tmpdir) "eliscript-ir-validation-"))))
    (let ((child (spawnSync (resolve "bin/eliscript-bootstrap") (js-array) (js-object :encoding "utf8" :timeout 30000
      :env (copyHostRecord (get globalThis.process :env) (js-object :ELISCRIPT_BOOTSTRAP_OUT_DIR directory))))))
      (js-call assert :equal (get child :error) undefined) (js-call assert :equal (get child :signal) nil)
      (js-call assert :equal (get child :status) 0 (get child :stderr)))
    (setq ir (await (funcall load-module (get (pathToFileURL (resolve directory "ir.mjs")) :href))))
    (setq compiler (await (funcall load-module (get (pathToFileURL (resolve directory "compiler.mjs")) :href))))) 30000)
  (afterAll (async () (when (not (= directory undefined)) (await (rm directory (js-object :recursive t :force t))))))
  (defun span () (js-object :filename "validation.eli" :start 0 :end 1 :line 1 :column 1 :endLine 1 :endColumn 2))
  (defun node () (js-object :kind "literal" :span (span) :value 0 :children (js-array) :properties (js-object)))
  (defun program () (js-object :filename "validation.eli" :body (js-array (node))))
  (defun firstNode (p) (aref (get p :body) 0))
  (defun withValue (value) (let ((p (program))) (put (firstNode p) :value value) p))
  (defun withProperties (properties) (let ((p (program))) (put (firstNode p) :properties properties) p))
  (defun nested (count) (let ((value 0)) (while (> count 0) (setq value (js-array value) count (1- count))) value))
  (defun failure (action)
    (try (funcall action) (js-call assert :fail "expected malformed IR rejection")
      (catch error
        (let ((diagnostic (get error :eliscriptDiagnostic)))
          (js-call assert :equal (if (nullish? diagnostic) undefined (get diagnostic :code)) "ELI-I0001")
          (js-call assert :equal (get diagnostic :message) (get error :message))
          (js-object :name (get error :name) :message (get error :message) :diagnostic diagnostic)))))
  (defun sameFailure (factory &rest __host_default_arguments_1)
    (let* ((expected (aref __host_default_arguments_1 0)))
    (let ((serialized (failure (lambda () (js-call ir :serialize_program (funcall factory)))))
          (validated (failure (lambda () (js-call ir :validate_serializable_program (funcall factory))))))
      (js-call assert :deepEqual validated serialized)
      (when (not (= expected undefined)) (js-call assert :equal (get validated :message) expected)))))
  ;; Independent original canonical formatter, invoked only after validation.
  (defun originalCanonical (value)
    (cond ((= value nil) "null")
      ((= (funcall host-typeof value) "number") (if (Object/is value (js* "-0")) "-0" (JSON/stringify value)))
      ((not (= (funcall host-typeof value) "object")) (JSON/stringify value))
      ((Array/isArray value) (str "[" (js-call (js-call value :map originalCanonical) :join ",") "]"))
      (t (str "{" (js-call (js-call (js-call (Object/keys value) :sort) :map
        (lambda (key) (str (JSON/stringify key) ":" (originalCanonical (get value key))))) :join ",") "}"))))
  (defun envelope (p) (js-object :format "eliscript-ir" :program p :version 1))
  (test "validation-only IR keeps the complete original fixture corpus and canonical formatter bytes" (async ()
    (let ((fixture (JSON/parse (await (readFile "tests/fixtures/bootstrap-ir.json" "utf8")))) (index 0))
      (while (< index (get (get fixture :valid) :length))
        (let* ((item (aref (get fixture :valid) index))
               (source (if (Object/hasOwn item "source") (get item :source) (await (readFile (get item :file) "utf8"))))
               (p (js-call compiler :compile_ir_string source (get item :filename)))
               (saved (globalThis/structuredClone p)) (expected (originalCanonical (envelope p))))
          (js-call assert :equal (js-call ir :serialize_program p) expected)
          (js-call assert :equal (js-call ir :validate_serializable_program p) p)
          (js-call assert :deepEqual p saved)
          (js-call assert :equal (js-call ir :serialize_program p) expected)
          (js-call assert :deepEqual (js-call ir :deserialize_program expected) p))
        (setq index (1+ index))))))
  (test "both validation passes preserve finite values signed zero UTF16 and shared JSON data without producing output" (lambda ()
    (let* ((shared (js-object :text "\0\ufeff中😀\ud800\udfff" :values (js-array false t nil (js* "-0") globalThis.Number.MIN_VALUE globalThis.Number.MAX_VALUE)))
           (value (Object/assign (Object/create nil) (js-object :z shared :a shared)))
           (p (withValue value)) (saved (Object/getOwnPropertyDescriptors value))
           (serialized (js-call ir :serialize_program p)) (stringify (get globalThis.JSON :stringify)))
      (put globalThis.JSON :stringify (lambda () (throw (new globalThis.Error "validation must not format JSON"))))
      (try (js-call assert :equal (js-call ir :validate_serializable_program p) p) (finally (put globalThis.JSON :stringify stringify)))
      (js-call assert :equal (get (firstNode p) :value) value)
      (js-call assert :deepEqual (Object/getOwnPropertyDescriptors value) saved)
      (funcall assert (Object/is (aref (get (get value :a) :values) 3) (js* "-0")))
      (js-call assert :equal (get value :a) (get value :z))
      (js-call assert :equal serialized (originalCanonical (envelope p)))
      (js-call assert :equal (js-call ir :serialize_program p) serialized)
      (let ((absent (program)))
        (Reflect/deleteProperty (firstNode absent) "properties")
        (js-call assert :equal (js-call ir :validate_serializable_program absent) absent)
        (js-call assert :equal (js-call ir :serialize_program absent) (originalCanonical (envelope absent)))))))
  (test "schema rejections precede arbitrary JSON payload checks with the original exact diagnostics" (lambda ()
    (let ((cases (js-array
      (lambda () nil) (lambda () (js-array)) (lambda () (js-object :filename "x"))
      (lambda () (copyHostRecord (program) (js-object :extra t)))
      (lambda () (copyHostRecord (program) (js-object :filename 1)))
      (lambda () (copyHostRecord (program) (js-object :body (new globalThis.Array 1))))
      (lambda () (copyHostRecord (program) (js-object :body (js-array nil))))
      (lambda () (let ((p (program))) (put (firstNode p) :kind "unknown") p))
      (lambda () (let ((p (program))) (Reflect/deleteProperty (firstNode p) "value") p))
      (lambda () (let ((p (program))) (put (firstNode p) :extra t) p))
      (lambda () (let ((p (program))) (put (get (firstNode p) :span) :start -1) p))
      (lambda () (let ((p (program))) (put (get (firstNode p) :span) :end -1) p))
      (lambda () (let ((p (program))) (put (get (firstNode p) :span) :line 0) p))
      (lambda () (let ((p (program))) (put (get (firstNode p) :span) :endColumn 0.5) p))
      (lambda () (let ((p (program))) (put (get (firstNode p) :span) :filename undefined) p))
      (lambda () (let ((p (program))) (put (get (firstNode p) :span) :start 2) p))
      (lambda () (let ((p (program))) (put (firstNode p) :children (js-array undefined)) p))
      (lambda () (let ((p (program))) (js-call (get (firstNode p) :children) :push (firstNode p)) p)))))
      (js-call (js-array nil undefined false 0 "x" (js* "1n") (funcall globalThis.Symbol "x") (lambda () 1) (js-array) (new globalThis.Date 0))
        :forEach (lambda (value) (js-call cases :push (lambda () (withProperties value)))))
      (js-call cases :push (lambda () (let ((p (withValue globalThis.NaN)) (bad (node))) (put bad :kind "later-unknown") (js-call (get p :body) :push bad) p)))
      (js-call cases :forEach (lambda (factory) (sameFailure factory)))
      (sameFailure (js-call cases :at -1) "unknown Eliscript IR node kind: later-unknown")
      (sameFailure (lambda ()
        (let* ((p (program)) (current (firstNode p)) (index 0))
          (while (< index 513)
            (let ((child (node))) (put current :children (js-array child)) (setq current child))
            (setq index (1+ index)))
          p)) "IR node exceeds nesting depth 512"))))
  (test "JSON data rejections preserve original sorted paths unsupported types dense arrays plain records and cycle detection" (lambda ()
    (js-call (js-array globalThis.NaN globalThis.Infinity (- globalThis.Infinity)) :forEach (lambda (value)
      (sameFailure (lambda () (withValue value)) "$.program.body[0].value must contain only finite numbers")))
    (js-call (js-array (js-array undefined "undefined") (js-array (js* "1n") "bigint") (js-array (funcall globalThis.Symbol "x") "symbol") (js-array (lambda () 1) "function"))
      :forEach (lambda (pair) (sameFailure (lambda () (withValue (aref pair 0))) (str "$.program.body[0].value contains unsupported JSON type " (aref pair 1)))))
    (js-call (js-array (new globalThis.Date 0) (new globalThis.Map) (new globalThis.Set) (new globalThis.Number 1) (new globalThis.Uint8Array 2) (Object/create (js-object :x 1)))
      :forEach (lambda (value) (sameFailure (lambda () (withValue value)) "$.program.body[0].value must be a plain data object")))
    (let ((arrays (js-array
      (lambda () (new globalThis.Array 1))
      (lambda () (let ((a (js-array))) (put a :extra 1) a))
      (lambda () (let ((a (js-array 1))) (Object/defineProperty a "0" (js-object :enumerable false)) a))
      (lambda () (let ((a (js-array))) (put a (funcall globalThis.Symbol "x") 1) a))
      (lambda () (let ((a (js-array))) (Object/setPrototypeOf a nil) a)))))
      (js-call arrays :forEach (lambda (make) (sameFailure (lambda () (withValue (funcall make))) "$.program.body[0].value must be a dense plain array"))))
    (sameFailure (lambda () (let ((a (js-array))) (js-call a :push a) (withValue a))) "$.program.body[0].value[0] contains a cyclic JSON value")
    (sameFailure (lambda () (let ((a (js-object))) (put a :self a) (withValue a))) "$.program.body[0].value.self contains a cyclic JSON value")
    (sameFailure (lambda () (withProperties (js-object :z globalThis.Infinity :a (js-object :z undefined :a (js* "1n"))))) "$.program.body[0].properties.a.a contains unsupported JSON type bigint")
    (sameFailure (lambda () (withValue (nested 509))) (str "$.program.body[0].value" (js-call "[0]" :repeat 509) " exceeds IR nesting depth 512"))
    (let ((boundary (withValue (nested 508))))
      (js-call assert :equal (js-call ir :validate_serializable_program boundary) boundary)
      (js-call assert :equal (js-call ir :serialize_program boundary) (originalCanonical (envelope boundary))))))
  (test "original accessor and descriptor rejection does not invoke getters or conversion hooks in either pass" (lambda ()
    (let* ((calls 0) (getter (lambda () (setq calls (1+ calls)) (throw (new globalThis.Error "must not evaluate getter"))))
           (factories (js-array
             (lambda () (let ((p (program))) (Object/defineProperty (firstNode p) "properties" (js-object :enumerable t :get getter)) p))
             (lambda () (let ((a (js-array 1))) (Object/defineProperty a "0" (js-object :enumerable t :get getter)) (withValue a)))
             (lambda () (withValue (Object/defineProperty (js-object) "x" (js-object :enumerable t :get getter))))
             (lambda () (withValue (Object/defineProperty (js-object) "hidden" (js-object :value 1))))
             (lambda () (let ((value (js-object))) (put value (funcall globalThis.Symbol "x") 1) (withValue value)))
             (lambda () (withValue (js-object :toJSON (lambda () (setq calls (1+ calls)) 1)))))))
      (js-call factories :forEach (lambda (factory) (sameFailure factory))) (js-call assert :equal calls 0))))
  (test "shared canonical token output preserves exact wide and deep long UTF16 payloads without changing input data" (lambda ()
    (let* ((shared (js-object :z (js* "-0") :a "\0\ufeff中😀\ud800\udfff"))
           (wide (withValue (Array/from (js-object :length 4096) (lambda (unused index)
             (let ((value (js-object)))
               (put value (str "键\"\\\n" index) index) (put value :shared shared)
               (put value :text (js-call "Unicode 😀\ud800 boundary " :repeat 8)) value)))))
           (deepValue (js-call "\0\ufeff中😀\ud800\udfff\"\\\n" :repeat 16384)) (depth 0))
      (while (< depth 360)
        (setq deepValue (if (not (= (% depth 2) 0)) (js-array deepValue)
          (let ((value (js-object))) (put value (str "层\"\\" depth) deepValue) value)))
        (setq depth (1+ depth)))
      (js-call (js-array wide (withValue deepValue)) :forEach (lambda (p)
        (let ((snapshot (globalThis/structuredClone p)) (expected (originalCanonical (envelope p))))
          (funcall assert (> (get expected :length) 65536) "the original output crosses the shared token flush boundary")
          (js-call assert :equal (js-call ir :serialize_program p) expected)
          (js-call assert :equal (js-call ir :validate_serializable_program p) p)
          (js-call assert :equal (js-call ir :serialize_program p) expected)
          (js-call assert :deepEqual (js-call ir :deserialize_program expected) p)
          (js-call assert :deepEqual p snapshot))))
      (js-call assert :equal (get (aref (get (firstNode wide) :value) 0) :shared) (get (js-call (get (firstNode wide) :value) :at -1) :shared))
      (funcall assert (Object/is (get shared :z) (js* "-0"))))))
  (test "canonical token flushing preserves primitive formatting order original first errors and recovery after partial output" (lambda ()
    (let* ((p (withValue (js-object :z (js-array 1 (js* "-0") false "\ud800😀") :a (js-object :z t :a "first"))))
           (stringify (get globalThis.JSON :stringify)) (expectedCalls (js-array)) (actualCalls (js-array))
           (recording (lambda (calls) (lambda (value)
             (when (or (= (funcall host-typeof value) "string") (= (funcall host-typeof value) "number")) (js-call calls :push value))
             (funcall stringify value))))
           (expected undefined) (actual undefined))
      (try
        (put globalThis.JSON :stringify (funcall recording expectedCalls))
        (setq expected (originalCanonical (envelope p)))
        (put globalThis.JSON :stringify (funcall recording actualCalls))
        (setq actual (js-call ir :serialize_program p))
        (finally (put globalThis.JSON :stringify stringify)))
      (js-call assert :equal actual expected)
      (js-call assert :deepEqual actualCalls expectedCalls "keys and primitive values retain their original sorted left-to-right order")
      (let* ((prefix (Array/from (js-object :length 2048) (lambda (unused index) (str (js-call "payload " :repeat 8) index))))
             (marker (new globalThis.Error "original formatter exception after complete chunks"))
             (partial (withValue (js-call prefix :concat (js-array "throw after flushing")))))
        (sameFailure (lambda () (withValue (js-call prefix :concat (js-array (js-object :z undefined :a (js* "1n")))))) "$.program.body[0].value[2048].a contains unsupported JSON type bigint")
        (put globalThis.JSON :stringify (lambda (value) (when (= value "throw after flushing") (throw marker)) (funcall stringify value)))
        (try (js-call assert :throws (lambda () (js-call ir :serialize_program partial)) (lambda (error) (= error marker)))
          (finally (put globalThis.JSON :stringify stringify)))
        (js-call assert :equal (js-call ir :serialize_program p) expected "a failed formatter leaves no shared token state for the next call")
        (put globalThis.JSON :stringify (lambda () (throw (new globalThis.Error "validation-only must never format a token"))))
        (try (js-call assert :equal (js-call ir :validate_serializable_program partial) partial)
          (finally (put globalThis.JSON :stringify stringify)))))))
)
