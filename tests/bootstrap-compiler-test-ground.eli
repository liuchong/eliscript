(module tests.bootstrap-compiler-test-ground
  (import "bun:test" expect test)
  (import "node:process" :default process)
  (import "node:fs/promises" mkdtemp rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "../bootstrap/host/bun.mjs" compileFile loadCompiler parseArguments)
  (defconst projectDirectory (resolve (js* "import.meta.dir") ".."))
  (defconst buildPath (resolve projectDirectory "bin/eliscript-bootstrap"))
  (defconst publicCliPath (resolve projectDirectory "bin/eliscript"))
  (defconst seedCliPath (resolve projectDirectory "bin/eliscript-seed"))
  (defconst portableCliPath (resolve projectDirectory "bin/eliscript-portable"))
  (defconst emacs (if (nullish? (get (get process :env) :EMACS)) "emacs" (get (get process :env) :EMACS)))
  (defconst moduleNames (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (a b) (js-call (expect a) :toBe b))
  (defun same (a b) (js-call (expect a) :toEqual b))
  (defun contains (a b) (js-call (expect a) :toContain b))
  (defun env (&rest __host_forwarded_arguments_1)
    (let* ((extras (aref __host_forwarded_arguments_1 0))) (Object/assign (js-object) (get process :env) extras)))
  (defun options (&rest __host_forwarded_arguments_2)
    (let* ((extras (aref __host_forwarded_arguments_2 0))) (js-object :env (env extras))))
  (defun seedOptions () (options (js-object :EMACS emacs)))
  (defun selfOptions (generation &rest __host_forwarded_arguments_3)
    (let* ((extras (aref __host_forwarded_arguments_3 0))) (options (Object/assign (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR generation) extras))))
  (defasync run (command &rest __host_forwarded_arguments_4)
    (let* ((options (aref __host_forwarded_arguments_4 0)))
    (let* ((child (Bun/spawn command (Object/assign (js-object :cwd projectDirectory :stdout "pipe" :stderr "pipe") options)))
           (result (await (Promise/all (js-array (get child :exited) (js-call (new globalThis.Response (get child :stdout)) :text) (js-call (new globalThis.Response (get child :stderr)) :text))))))
      (js-object :exitCode (aref result 0) :stdout (aref result 1) :stderr (aref result 2)))))
  (defun successful (result command)
    (unless (= (get result :exitCode) 0)
      (let ((err (js-call (get result :stderr) :trim)) (out (js-call (get result :stdout) :trim)))
        (throw (new globalThis.Error (if (not (= err "")) err (if (not (= out "")) out (str (aref command 0) " exited with " (get result :exitCode))))))))
    (get result :stdout))
  (defasync runSuccessful (command &rest __host_forwarded_arguments_5)
    (let* ((options (aref __host_forwarded_arguments_5 0))) (successful (await (run command options)) command)))
  (defasync buildWithPortableCompiler (compilerDirectory outputDirectory)
    (let ((compiler (await (loadCompiler compilerDirectory))) (i 0))
      (while (< i (get moduleNames :length))
        (let ((name (aref moduleNames i)))
          (await (compileFile (js-object :compiler compiler :input (resolve projectDirectory (str "bootstrap/compiler/" name ".eli")) :output (resolve outputDirectory (str name ".mjs")) :sourceMap t))))
        (setq i (1+ i)))))
  (defasync fileText (filename) (js-call (Bun/file filename) :text))
  (defasync expectFileEqual (left right) (be (await (fileText right)) (await (fileText left))))
  (defasync expectArtifactDirectoriesEqual (left right)
    (let ((i 0))
      (while (< i (get moduleNames :length))
        (let ((name (aref moduleNames i)) (suffixes (js-array ".mjs" ".mjs.map")) (j 0))
          (while (< j (get suffixes :length))
            (let ((filename (str name (aref suffixes j)))) (await (expectFileEqual (resolve left filename) (resolve right filename)))) (setq j (1+ j))))
        (setq i (1+ i)))))
  (defasync assertLifecycle (generationOne generationTwo)
    (let ((filename "虚拟😀/frontend-lifecycle.eli") (source "(defmacro identity-code (x) x)\n(defun work (x)\n  (let ((result (identity-code (+ x 2))))\n    (if (> result 0) result -0.0)))\n(export work)") (generations (js-array generationOne generationTwo)) (i 0)
          (lifecycleIR undefined) (lifecycleJS undefined) (lifecycleOrigins undefined))
      (while (< i (get generations :length))
        (let* ((compiler (await (loadCompiler (aref generations i)))) (ordinary (js-call compiler :compile_ir_string source filename))
               (traced (js-call compiler :compile_ir_string_with_origins source filename)) (canonical (js-call compiler :serialize_ir_program ordinary)) (javascript (js-call compiler :emit_ir_string ordinary)))
          (be (js-call compiler :serialize_ir_program (get traced :program)) canonical) (be (js-call compiler :emit_ir_string (get traced :program)) javascript)
          (be (get (get traced :macroOrigins) :length) 1) (be (get (aref (get traced :macroOrigins) 0) :macroName) "identity-code")
          (be (get (aref (get traced :macroOrigins) 0) :status) "expanded") (be (get (get (aref (get traced :macroOrigins) 0) :callSpan) :filename) filename)
          (unless (= lifecycleIR undefined) (be canonical lifecycleIR) (be javascript lifecycleJS) (same (get traced :macroOrigins) lifecycleOrigins))
          (setq lifecycleIR canonical lifecycleJS javascript lifecycleOrigins (get traced :macroOrigins))
          (let ((module (await (funcall (js* "(specifier) => import(specifier)") (str "data:text/javascript;base64," (js-call (Buffer/from javascript) :toString "base64"))))))
            (be (js-call module :work 3) 5) (js-call (expect (Object/is (js-call module :work -3) (js* "-0"))) :toBeTrue))
          (js-call (js-array (js-array "(defun broken (" "reader") (js-array "(defmacro identity-code (x) x) (identity-code)" "expansion") (js-array "(defun broken () missing)" "analysis")) :forEach
            (lambda (pair)
              (let ((failures (js-array)))
                (js-call (js-array (get compiler :compile_ir_string) (get compiler :compile_ir_string_with_origins)) :forEach
                  (lambda (compile) (try (compile (aref pair 0) filename) (catch error (js-call failures :push error)))))
                (be (get failures :length) 2) (be (get (aref failures 1) :message) (get (aref failures 0) :message))
                (same (get (aref failures 1) :eliscriptDiagnostic) (get (aref failures 0) :eliscriptDiagnostic))
                (be (get (get (aref failures 0) :eliscriptDiagnostic) :phase) (aref pair 1))))))
        (setq i (1+ i)))))
  (defasync compareLibrary (libraryCase generation)
    (let* ((source (resolve projectDirectory (aref libraryCase 0)))
           (seed (await (runSuccessful (js-array seedCliPath source) (seedOptions))))
           (self (await (runSuccessful (js-array portableCliPath source) (selfOptions generation)))))
      (be self seed) (js-call (aref libraryCase 1) :forEach (lambda (expected) (contains seed expected)))))
  (test "portable compiler driver reaches a reproducible fixed point" (async ()
    (same (parseArguments (js-array "--" "-o" "out.mjs" "input.eli")) (js-object :input "input.eli" :output "out.mjs" :sourceMap false :portableEntries (js-array) :diagnosticFormat "human"))
    (same (parseArguments (js-array "--portable" "work" "--portable" "index" "input.eli")) (js-object :input "input.eli" :output undefined :sourceMap false :portableEntries (js-array "work" "index") :diagnosticFormat "human"))
    (same (parseArguments (js-array "--diagnostic-format" "json" "input.eli")) (js-object :input "input.eli" :output undefined :sourceMap false :portableEntries (js-array) :diagnosticFormat "json"))
    (same (parseArguments (js-array "--help")) (js-object :help t))
    (js-call (expect (lambda () (parseArguments (js-array "--source-map" "input.eli")))) :toThrow "--source-map requires --output")
    (js-call (expect (lambda () (parseArguments (js-array "one.eli" "two.eli")))) :toThrow "multiple input files are not supported yet")
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-compiler-")))) (automaticRun undefined))
      (try
        (let* ((generationOne (resolve directory "generation-one")) (generationTwo (resolve directory "generation-two")) (generationThree (resolve directory "generation-three"))
               (coreSource (resolve projectDirectory "tests/fixtures/core.eli")) (automaticCompiler (resolve directory "automatic-compiler")))
          (await (runSuccessful (js-array buildPath) (options (js-object :EMACS emacs :ELISCRIPT_BOOTSTRAP_OUT_DIR generationOne))))
          (setq automaticRun (run (js-array publicCliPath coreSource) (options (js-object :EMACS emacs :ELISCRIPT_BOOTSTRAP_MODULE_DIR automaticCompiler :ELISCRIPT_JS_RUNTIME "node"))))
          (await (buildWithPortableCompiler generationOne generationTwo)) (await (buildWithPortableCompiler generationTwo generationThree))
          (await (expectArtifactDirectoriesEqual generationOne generationTwo)) (await (expectArtifactDirectoriesEqual generationTwo generationThree))
          (await (assertLifecycle generationOne generationTwo))
          (let ((seedOutput (await (runSuccessful (js-array seedCliPath coreSource) (seedOptions)))))
            (be (await (runSuccessful (js-array portableCliPath coreSource) (selfOptions generationTwo))) seedOutput)
            (be (await (runSuccessful (js-array publicCliPath coreSource) (selfOptions generationTwo))) seedOutput)
            (be (await (runSuccessful (js-array publicCliPath coreSource) (selfOptions generationTwo (js-object :ELISCRIPT_JS_RUNTIME "node")))) seedOutput)
            (be (successful (await automaticRun) (js-array publicCliPath)) seedOutput)
            (js-call (expect (await (js-call (Bun/file (resolve automaticCompiler "compiler.mjs")) :exists))) :toBeTrue))
          (let ((diagnosticSource (resolve directory "diagnostic.eli")))
            (await (writeFile diagnosticSource "(defun broken ()\n  missing)\n"))
            (let* ((diagnosticFailure (await (run (js-array portableCliPath "--diagnostic-format" "json" diagnosticSource) (selfOptions generationTwo))))
                   (publicNodeDiagnostic (await (run (js-array publicCliPath "--diagnostic-format" "json" diagnosticSource) (selfOptions generationTwo (js-object :ELISCRIPT_JS_RUNTIME "node"))))))
              (be (get diagnosticFailure :exitCode) 1) (be (get diagnosticFailure :stdout) "")
              (same (JSON/parse (get diagnosticFailure :stderr)) (js-object :format "eliscript-diagnostic" :version 1 :code "ELI-A0001" :severity "error" :phase "analysis" :message "unbound symbol: missing"
                :location (js-object :file diagnosticSource :start (js-object :offset 19 :line 2 :column 3) :end (js-object :offset 26 :line 2 :column 10))))
              (be (get publicNodeDiagnostic :exitCode) 1) (be (get publicNodeDiagnostic :stdout) "") (same (JSON/parse (get publicNodeDiagnostic :stderr)) (JSON/parse (get diagnosticFailure :stderr)))))
          (let ((libraryCases (js-array (js-array "stdlib/sequence.eli" (js-array "function map(function$, values)" "function range_by(start, end, step)")) (js-array "stdlib/text.eli" (js-array "function slice(start, end, text)" "function trim(text)")) (js-array "stdlib/object.eli" (js-array "function assoc(object, key, value)" "function omit(object, omitted_keys)")) (js-array "stdlib/data.eli" (js-array "import {assoc} from \"./object.eli\";" "import {has_QMARK_} from \"./object.eli\";" "function group_by(key_function, values)")) (js-array "stdlib/function.eli" (js-array "import {empty_persistent_vector, persistent_vector_conj} from \"./persistent-vector.eli\";" "function identity(value)" "function comp(...functions)" "function partial(function$, ...bound_arguments)" "function juxt(...functions)" "function fnil(function$, ...defaults)" "function every_pred(...predicates)" "function some_fn(...predicates)" "function trampoline(function$, ...arguments$)")) (js-array "stdlib/deferred.eli" (js-array "function delay(producer)" "function delay_QMARK_(value)" "function force(value)" "function memoize(function$)" "function realized_QMARK_(value)")) (js-array "stdlib/core/protocol.eli" (js-array "function define_protocol(name, operations)" "function extend_protocol_type(protocol, constructor, implementations)")) (js-array "stdlib/core/identifier.eli" (js-array "function keyword(...arguments$)" "function symbol(...arguments$)" "function qualified_name(value)")) (js-array "stdlib/core/data-text.eli" (js-array "function print_value(value, options = null)" "function read_value(source, options = null)" "function read_values(source, options = null)")) (js-array "stdlib/core/metadata.eli" (js-array "function meta(value)" "function with_meta(value, metadata)" "function vary_meta(value, transform, ...arguments$)")) (js-array "stdlib/core/collection.eli" (js-array "function assoc(collection, key, value, ...key_values)" "function associative_QMARK_(collection)" "function collection_count(collection)" "function bounded_count(limit, collection)" "function collection_QMARK_(value)" "function counted_QMARK_(collection)" "function distinct_QMARK_(...values)" "function disj(collection, ...values)" "function dissoc(collection, ...keys)" "function empty_QMARK_(collection)" "function indexed_QMARK_(collection)" "function list_QMARK_(value)" "function map_QMARK_(value)" "function not_empty(collection)" "function peek(collection)" "function pop(collection)" "function queue_QMARK_(value)" "function reducible_QMARK_(collection)" "function rseq(collection)" "function reversible_QMARK_(collection)" "function sequence_QMARK_(value)" "function sequential_QMARK_(value)" "function seqable_QMARK_(collection)" "function set_QMARK_(value)" "function subvec(vector, start, end = null)" "function reduce(collection, reducer, ...initial)" "function reduce_kv(collection, reducer, initial)" "function reduction_view(reduce_function)" "function reduction_view_QMARK_(value)" "function unbounded_sequence_view(factory)" "function vector_QMARK_(value)")) (js-array "stdlib/core/transient.eli" (js-array "function assoc_BANG_(collection, key, value, ...key_values)" "function persistent_BANG_(collection)")) (js-array "stdlib/core/transducer.eli" (js-array "function catting()" "function compose_transducers(...transducers)" "function deduping()" "function distincting()" "function eduction(...arguments$)" "function interposing(separator)" "function keeping_indexed(transform)" "function mapping_indexed(transform)" "function mapcatting(transform)" "function partitioning_all(size)" "function partitioning_by(classifier)" "function run_BANG_(procedure, collection)" "function taking_nth(interval)" "function taking_while(predicate)" "function transduce(transducer, reducer, initial, collection)")) (js-array "stdlib/core/seq.eli" (js-array "function range(...bounds)" "function repeat(...arguments$)" "function repeatedly(...arguments$)" "function iterate(transform, seed)" "function cycle(collection)" "function generate(limit, producer)" "function first(collection, not_found_value = null)" "function nth_rest(limit, collection)" "function nth_next(limit, collection)" "function rest(collection)" "function next(collection)" "function prepend(value, collection)" "function second(collection, not_found_value = null)" "function ffirst(collection)" "function nfirst(collection)" "function fnext(collection)" "function nnext(collection)" "function sequence_nth(index, collection, not_found_value = null)" "function last(collection, not_found_value = null)" "function take_last(limit, collection)" "function drop_last(limit, collection)" "function butlast(collection)" "function split_at(limit, collection)" "function split_with(predicate, collection)" "function reverse(collection)" "implementsProtocolOperation(IReversible, \"rseq\", collection)" "function map(transform, collection)" "function map_indexed(transform, collection)" "function distinct(collection)" "function mapcat(transform, collection)" "function partition(size, ...arguments$)" "function partition_all(size, ...arguments$)" "function interleave(...collections)" "function interleave_all(...collections)" "function not_any_QMARK_(predicate, collection)" "function not_every_QMARK_(predicate, collection)" "function reductions(step, initial, collection)" "function tree_seq(branch_predicate, children_function, root)" "function flatten(root)" "function concat(...collections)")) (js-array "stdlib/core/data.eli" (js-array "function collect_buckets(key_function, collection, create_bucket, update_bucket)" "function index_by(key_function, collection)" "function get_in(collection, path, not_found = null)" "function assoc_in(collection, path, value)" "function update(collection, key, transform, ...arguments$)" "function update_in(collection, path, transform, ...arguments$)" "function select_keys(collection, keys)" "function merge(...collections)" "function merge_with(combine, ...collections)" "function zipmap(keys, values)")) (js-array "stdlib/core/set.eli" (js-array "function set(...arguments$)" "function union(...collections)" "function intersection(...collections)" "function difference(...collections)" "function subset_QMARK_(...arguments$)" "function superset_QMARK_(...arguments$)" "function disjoint_QMARK_(...arguments$)" "function select(...arguments$)" "function project(...arguments$)" "function rename_keys(...arguments$)" "function rename(...arguments$)" "function index(...arguments$)" "function map_invert(...arguments$)" "function join(...arguments$)")) (js-array "stdlib/core/order.eli" (js-array "function compare_values(left, right)" "function comparator(comparison)" "function reverse_comparator(...arguments$)" "function sort(...arguments$)" "function sort_by(key_function, ...arguments$)" "function min_key(key_function, ...values)" "function max_key(key_function, ...values)")) (js-array "examples/emacs-index/index.eli" (js-array "import {count_by} from \"../../stdlib/data.eli\";" "function score_document(id, terms, query_terms)")))) (index 0))
            (while (< index (get libraryCases :length))
              (await (Promise/all (js-call (js-call libraryCases :slice index (+ index 2)) :map (lambda (item) (compareLibrary item generationTwo)))))
              (setq index (+ index 2))))
          (let ((portableSource (resolve directory "portable.eli")))
            (await (writeFile portableSource "(defconst step 2)\n(defportable helper (value) (* value step))\n(defportable work (value) (helper value))\n(defportable unused () 99)\n(defun ordinary () 1)\n"))
            (let ((seedPortableOutput (await (runSuccessful (js-array seedCliPath "--portable" "work" portableSource) (seedOptions)))))
              (be (await (runSuccessful (js-array portableCliPath "--portable" "work" portableSource) (selfOptions generationTwo))) seedPortableOutput)
              (contains seedPortableOutput "function helper(value)") (contains seedPortableOutput "function work(value)")
              (js-call (get (expect seedPortableOutput) :not) :toContain "function unused") (js-call (get (expect seedPortableOutput) :not) :toContain "function ordinary"))
            (let ((importedPortableSource (resolve directory "portable-import.eli")))
              (await (writeFile importedPortableSource "(import-portable \"./helper.eli\" helper)\n(defportable imported-work (value) (helper value))\n"))
              (let ((seedImportFailure (await (run (js-array seedCliPath "--portable" "imported-work" importedPortableSource) (seedOptions))))
                    (portableImportFailure (await (run (js-array portableCliPath "--portable" "imported-work" importedPortableSource) (selfOptions generationTwo)))))
                (be (get seedImportFailure :exitCode) 1) (be (get portableImportFailure :exitCode) 1)
                (contains (get seedImportFailure :stderr) "portable import helper requires a project build")
                (contains (get portableImportFailure :stderr) "portable import helper requires a project build")))
            (let ((seedPortableMapped (resolve directory "seed-cli/portable.mjs")) (selfHostedPortableMapped (resolve directory "portable-cli/portable.mjs")))
              (await (runSuccessful (js-array seedCliPath "--source-map" "--portable" "work" "--output" seedPortableMapped portableSource) (seedOptions)))
              (await (runSuccessful (js-array portableCliPath "--source-map" "--portable" "work" "--output" selfHostedPortableMapped portableSource) (selfOptions generationTwo)))
              (await (expectFileEqual seedPortableMapped selfHostedPortableMapped)) (await (expectFileEqual (str seedPortableMapped ".map") (str selfHostedPortableMapped ".map")))))
          (let ((seedMapped (resolve directory "seed-cli/core.mjs")) (portableMapped (resolve directory "portable-cli/core.mjs")) (publicNodeMapped (resolve directory "public-node/core.mjs")))
            (await (runSuccessful (js-array seedCliPath "--source-map" "--output" seedMapped coreSource) (seedOptions)))
            (await (runSuccessful (js-array portableCliPath "--source-map" "--output" portableMapped coreSource) (selfOptions generationTwo)))
            (await (runSuccessful (js-array publicCliPath "--source-map" "--output" publicNodeMapped coreSource) (selfOptions generationTwo (js-object :ELISCRIPT_JS_RUNTIME "node"))))
            (await (expectFileEqual seedMapped portableMapped)) (await (expectFileEqual (str seedMapped ".map") (str portableMapped ".map")))
            (await (expectFileEqual seedMapped publicNodeMapped)) (await (expectFileEqual (str seedMapped ".map") (str publicNodeMapped ".map"))))
          (let ((brokenSource (resolve directory "broken.eli")))
            (await (writeFile brokenSource "(defun broken () missing)\n"))
            (let ((seedFailure (await (run (js-array seedCliPath brokenSource) (seedOptions))))
                  (portableFailure (await (run (js-array portableCliPath brokenSource) (selfOptions generationTwo))))
                  (diagnostic (str brokenSource ":1:18: unbound symbol: missing")))
              (be (get seedFailure :exitCode) 1) (be (get portableFailure :exitCode) 1)
              (be (get portableFailure :stdout) (get seedFailure :stdout)) (contains (get seedFailure :stderr) diagnostic) (contains (get portableFailure :stderr) diagnostic))))
        (finally (when automaticRun (await automaticRun)) (await (rm directory (js-object :recursive t :force t))))))) 30000)
)
