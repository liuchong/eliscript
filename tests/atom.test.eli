(module tests.atom
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdir mkdtemp readFile rm)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" fileURLToPath pathToFileURL)
  (import "./helpers/portable-stdlib.mjs" runSuccessful be same contains)
  (defconst load-module (js* "(specifier) => import(specifier)"))
  (defconst ROOT (resolve (fileURLToPath (new globalThis.URL "." (js* "import.meta.url"))) ".."))
  (defconst BUILD (resolve ROOT "bin/eliscript-build"))
  (defconst COMPILER (resolve ROOT "bin/eliscript"))
  (defasync compile (source output)
    (await (runSuccessful (js-array COMPILER "--source-map" "--output" output source) (js-object))))
  (defasync checkMap (module fragments)
    (let ((map (JSON/parse (await (readFile (str module ".map") "utf8")))))
      (js-call (expect (get map :sourcesContent)) :toHaveLength 1)
      (js-call fragments :forEach (lambda (text) (contains (aref (get map :sourcesContent) 0) text)))
      (js-call (expect (get (get map :mappings) :length)) :toBeGreaterThan 0)))

  (import "./helpers/seed-compiler.mjs" seedCompilerFixture)
  (defconst dependencies (js-array "bit" "persistent-list" "persistent-vector" "persistent-map" "persistent-set" "value"))
  (defasync compileFamily (command output environment)
    (await (mkdir (resolve output "state") (js-object :recursive t)))
    (let ((index 0))
      (while (< index (js-length dependencies))
        (let ((name (aref dependencies index)))
          (await (runSuccessful (js-array command "--source-map" "--output" (resolve output (str name ".eli")) (resolve ROOT "stdlib" (str name ".eli"))) environment)))
        (setq index (1+ index))))
    (await (runSuccessful (js-array command "--source-map" "--output" (resolve output "state/atom.mjs") (resolve ROOT "stdlib/state/atom.eli")) environment)))
  (test "Eliscript Atom preserves ordered single-transition state semantics" (async ()
    (let* ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-atom-"))))
           (bootstrap (resolve directory "bootstrap")) (seed (resolve directory "seed")) (self (resolve directory "self-hosted")))
      (try
        (await (compileFamily COMPILER seed (js-object))) (await (seedCompilerFixture bootstrap))
        (await (compileFamily (resolve ROOT "bin/eliscript-portable") self (js-object :ELISCRIPT_BOOTSTRAP_MODULE_DIR bootstrap)))
        (let ((files (js-call (js-call dependencies :map (lambda (name) (str name ".eli"))) :concat (js-array "state/atom.mjs"))) (index 0))
          (while (< index (js-length files))
            (let* ((relative (aref files index)) (seedPath (resolve seed relative)) (selfPath (resolve self relative)))
              (be (await (readFile selfPath "utf8")) (await (readFile seedPath "utf8")))
              (be (await (readFile (str selfPath ".map") "utf8")) (await (readFile (str seedPath ".map") "utf8"))))
            (setq index (1+ index))))
        (let ((reports (js-array)) (directories (js-array seed self)) (index 0) (fixture (resolve ROOT "tests/fixtures/atom-host.mjs")))
          (while (< index 2)
            (let ((modulePath (resolve (aref directories index) "state/atom.mjs")))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array "bun" "--preload" (resolve ROOT "tests/fixtures/compiled-eli-bun-preload.mjs") fixture modulePath) (js-object)))))
              (js-call reports :push (JSON/parse (await (runSuccessful (js-array (get (get globalThis.process :env) :NODE "node") "--experimental-loader" (resolve ROOT "tests/fixtures/compiled-eli-node-loader.mjs") fixture modulePath) (js-object))))))
            (setq index (1+ index)))
          (js-call reports :forEach (lambda (report) (same report (aref reports 0))))
          (same (aref reports 0) (js-object "basic" (js-object "atom" t "hostObject" false "forgedAtom" false "hostileAtom" false "resetResult" 2 "swapResult" 9 "resetValues" (js-array 9 10) "swapValues" (js-array 10 15) "compareMismatch" false "compareSuccess" t "value" 20 "valueEqualCompare" t "valueEqualState" (js-array 3 4) "opaqueMismatch" false "opaqueSuccess" t "opaqueState" (js-object "value" 3) "invalidReference" "ELI-ATOM-INVALID-REFERENCE" "invalidTransform" "ELI-ATOM-INVALID-TRANSFORM") "validation" (js-object "calls" (js-array 2 5 (- 1)) "compareRejected" false "compareMismatchWatchCalls" 0 "guardedWatchCalls" 2 "acceptedValue" 5 "rejectedCode" "ELI-ATOM-VALIDATION" "rejectedState" 5 "rejectedReplacement" "ELI-ATOM-VALIDATION" "validatorUnchanged" t "clearedValidator" nil "unguardedValue" (- 1) "initialRejection" "ELI-ATOM-VALIDATION" "invalidValidator" "ELI-ATOM-INVALID-VALIDATOR" "invalidOptions" "ELI-ATOM-INVALID-OPTIONS" "inheritedValidatorCalls" 0 "inheritedValue" 1 "validatorMarkerPreserved" t "stateAfterThrownValidator" 1 "stateAfterRecovery" 3) "reentrancy" (js-object "swap" "ELI-ATOM-REENTRANT" "swapState" 1 "validator" "ELI-ATOM-REENTRANT" "validatorState" 1 "validatorInstalled" false "compare" "ELI-ATOM-REENTRANT" "compareState" 1) "watches" (js-object "outerResetResult" 1 "finalValue" 2 "outerEvents" (js-array "control" "observer") "nestedEvents" (js-array "late") "ordered" t "replacementEvents" (js-array "new") "watchMarkerPreserved" t "committedAfterFailure" 2 "healthyWatchCalls" 2 "watchRecoveryValue" 2) "model" (js-object "agreement" t "transitions" 17687 "value" 2764) "scale" (js-object "value" 100000))))
        (let ((sourceMap (JSON/parse (await (readFile (resolve seed "state/atom.mjs.map") "utf8")))))
          (js-call (expect (get sourceMap :sourcesContent)) :toHaveLength 1)
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun atom (initial")
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun swap!")
          (contains (aref (get sourceMap :sourcesContent) 0) "(defun compare-and-set!"))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 120000)
)
