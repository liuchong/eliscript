(module tests.compiler-ir-kind
  (import "./helpers/performance-acceptance.mjs" currentPerformanceTest)
  (import "bun:test" expect test)
  (import "node:fs/promises" mkdtemp readFile rm writeFile)
  (import "node:os" tmpdir)
  (import "node:path" resolve)
  (import "node:url" pathToFileURL)
  (import "./helpers/bootstrap-fixture.mjs" projectDirectory run buildBootstrap loadModule)
  (defconst compilerSources (js-array "symbol" "syntax" "reader" "formatter" "expander" "transient-analysis" "analyzer" "ir" "lower" "source-map" "emitter" "project" "compiler"))
  (defun be (actual expected) (js-call (expect actual) :toBe expected))
  (defun same (actual expected) (js-call (expect actual) :toEqual expected))

  (import "../tools/compiler/ir-kind-benchmark.mjs" compilerIrKindSourceDigest validateCompilerIrKindReport)
  (defconst reportPath (resolve projectDirectory "benchmarks/compiler-ir-kind-macos-arm64.json"))
  (defasync readReport () (JSON/parse (await (readFile reportPath "utf8"))))
  (defun collectProgramNodes (program)
    (let ((nodes (js-array)) (stack (Array/from (get program :body))))
      (while (> (js-length stack) 0)
        (let* ((node (js-call stack :pop)) (children (get node :children)))
          (js-call nodes :push node)
          (Reflect/apply (get stack :push) stack (if (nullish? children) (js-array) (Array/from children)))))
      nodes))
  (test "optimized IR node-kind decisions match the linear reference" (async ()
    (let ((directory (await (mkdtemp (resolve (tmpdir) "eliscript-ir-kind-")))))
      (try
        (await (buildBootstrap directory))
        (let* ((modules (await (Promise/all (js-array (loadModule directory "compiler" "ir-kind") (loadModule directory "ir" "ir-kind")))))
               (compiler (aref modules 0)) (ir (aref modules 1)) (nodeCount 0))
          (be (Object/isFrozen (get ir :node_kinds)) t)
          (js-call (get ir :node_kinds) :forEach (lambda (kind)
            (be (js-call ir :node_kind_p kind) t) (be (js-call ir :reference_node_kind_p kind) t)))
          (let ((index 0))
            (while (< index (js-length compilerSources))
              (let* ((relative (str "bootstrap/compiler/" (aref compilerSources index) ".eli")) (source (await (readFile (resolve projectDirectory relative) "utf8")))
                     (program (js-call compiler :compile_ir_string source relative)))
                (js-call (collectProgramNodes program) :forEach (lambda (node)
                  (be (js-call ir :node_p node) t) (be (js-call ir :node_p node) (js-call ir :reference_node_p node)) (setq nodeCount (1+ nodeCount)))))
              (setq index (1+ index))))
          (js-call (expect nodeCount) :toBeGreaterThan 20000)
          (js-call (js-array nil undefined false t 0 "literal" (funcall globalThis.Symbol "literal") (lambda () "literal") (js-array) (js-object)
            (js-object :kind "unknown") (js-object :kind nil) (js-object :kind (funcall globalThis.Symbol "literal"))
            (Object/create (js-object :kind "literal")) (Object/freeze (js-object :kind "literal"))) :forEach
            (lambda (value) (be (js-call ir :node_p value) (js-call ir :reference_node_p value))))
          (be (js-call ir :node_p (Object/create (js-object :kind "literal"))) t)
          (be (js-call ir :node_p (js-object :kind "unknown")) false)
          (js-call (expect (lambda () (js-call ir :make_node "unknown" nil nil (js-array) nil))) :toThrow "unknown Eliscript IR node kind: unknown"))
        (finally (await (rm directory (js-object :recursive t :force t))))))) 30000)
  (test "committed compiler IR kind report preserves historical measurements and decisions" (async ()
    (let ((report (validateCompilerIrKindReport (await (readReport)))))
      (js-call (expect (get (get report :corpus) :files)) :toHaveLength (js-length compilerSources))
      (js-call (expect (get (get report :corpus) :sourceBytes)) :toBeGreaterThan 200000)
      (js-call (expect (get (get report :corpus) :irNodes)) :toBeGreaterThan 20000)
      (be (get (get report :validation) :values) (+ (get (get report :corpus) :irNodes) (get (get report :corpus) :boundaryValues)))
      (js-call (expect (get (get report :measurements) :speedup)) :toBeGreaterThanOrEqual (get (get report :decision) :minimumSpeedup)))))
  (test "failed ir-kind gates retain complete measurement evidence" (async ()
    (let ((report (await (readReport))) (failure undefined))
      (put (get report :decision) :passed false)
      (try (validateCompilerIrKindReport report) (catch error (setq failure error)))
      (js-call (expect failure) :toBeInstanceOf globalThis.TypeError) (be (get failure :report) report))))
  (funcall (currentPerformanceTest test) "committed compiler IR kind report matches measured sources" (async ()
    (same (get (await (readReport)) :sourceDigest) (await (compilerIrKindSourceDigest)))))
)
